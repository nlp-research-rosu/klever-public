    12	  syntax Expr ::= "Name" "(" String ")"
    13	                | "Int" "(" Int ")"
    14	                | "Call" "(" Expr "," Exprs ")"
    15	                | "Subscript" "(" Expr "," Expr ")"
    16	                | "Slice" "(" Bound "," Bound "," Bound ")"
    17	                | "TupleExpr" "(" Exprs ")"
    18	                | "BinOp" "(" String "," Expr "," Expr ")"
    19	
    20	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
    21	                | "Assign" "(" Expr "," Expr ")"
    22	                | "For" "(" Expr "," Expr "," Stmts ")"
    23	                | "AugAssign" "(" Expr "," String "," Expr ")"
    24	                | "Return" "(" Expr ")"
    25	
    26	  syntax Ops ::= ".Ops" | "Op" "(" String "," Ops ")"
    27	  syntax Ints ::= ".Ints" | "Num" "(" Int "," Ints ")"
    28	  syntax OpList ::= "ops" "(" Ops ")"
    29	  syntax NumList ::= "ints" "(" Ints ")"
    30	endmodule
    31	
    32	module SEMANTIC
    33	  imports MPY-SYNTAX
    34	  imports INT
    35	  imports STRING
    36	  imports BOOL
    37	
    38	  syntax KItem ::= "invoke"
    39	                 | "exec" "(" Stmts ")"
    40	                 | "answer" "(" Int ")"
    41	
    42	  syntax Text ::= "noText"
    43	                | "builder" "(" Ops "," Ints "," Ops "," Ints ")"
    44	
    45	  configuration
    46	    <mpy>
    47	      <k> $PGM:Pgm ~> invoke </k>
    48	      <operators> $OPS:OpList </operators>
    49	      <operands> $OPERANDS:NumList </operands>
    50	      <expression> noText </expression>
    51	    </mpy>
    52	
    53	  rule <k> Module(FuncDef("do_algebra", Params("operator", "operand"), BODY))
    54	            ~> invoke => exec(BODY) ... </k>
    55	
    56	  rule <k> exec(Assign(
    57	                    Name("expression"),
    58	                    Call(Name("str"), Subscript(Name("operand"), Int(0))))
    59	                  REST) => exec(REST) ... </k>
    60	       <operators> ops(OS) </operators>
    61	       <operands> ints(Num(I, IS)) </operands>
    62	       <expression> _ => builder(OS, Num(I, IS), OS, IS) </expression>
    63	
    64	  rule <k> exec(For(
    65	                    TupleExpr(Name("oprt"), Name("oprn")),
    66	                    Call(Name("zip"),
    67	                         Name("operator"),
    68	                         Subscript(Name("operand"),
    69	                                   Slice(Int(1), NoBound, NoBound))),
    70	                    AugAssign(
    71	                      Name("expression"),
    72	                      "+",
    73	                      BinOp("+", Name("oprt"),
    74	                            Call(Name("str"), Name("oprn")))))
    75	                  REST) => exec(REST) ... </k>
    76	       <expression>
    77	         builder(ALLOPS, ALLINTS, OS, IS)
    78	         => builder(ALLOPS, ALLINTS, .Ops, .Ints)
    79	       </expression>
    80	    requires aligned(OS, IS)
    81	
    82	  rule <k> exec(Return(Call(Name("eval"), Name("expression"))) _REST)
    83	            => answer(pyEval(ALLOPS, ALLINTS)) ... </k>
    84	       <expression> builder(ALLOPS, ALLINTS, .Ops, .Ints) </expression>
    85	
    86	  // The zip loop consumes exactly one operand for each operator.
    87	  syntax Bool ::= aligned ( Ops , Ints ) [function, total]
    88	  rule aligned(.Ops, .Ints) => true
    89	  rule aligned(Op(_, OS), Num(_, IS)) => aligned(OS, IS)
    90	  rule aligned(.Ops, Num(_, _)) => false
    91	  rule aligned(Op(_, _), .Ints) => false
    92	
    93	  // A small expression evaluator with Python's precedence and associativity.
    94	  // parsePow consumes one right-associative exponentiation group.
    95	  syntax ParseResult ::= "parsed" "(" Int "," Ops "," Ints ")"
    96	  syntax ParseResult ::= parsePow ( Ops , Ints ) [function]
    97	                       | powCombine ( Int , ParseResult ) [function]
    98	
    99	  rule parsePow(.Ops, Num(I, .Ints)) => parsed(I, .Ops, .Ints)
   100	  rule parsePow(Op("**", OS), Num(I, IS))
   101	    => powCombine(I, parsePow(OS, IS))
   102	  rule parsePow(Op("+", OS), Num(I, IS))
   103	    => parsed(I, Op("+", OS), IS)
   104	  rule parsePow(Op("-", OS), Num(I, IS))
   105	    => parsed(I, Op("-", OS), IS)
   106	  rule parsePow(Op("*", OS), Num(I, IS))
   107	    => parsed(I, Op("*", OS), IS)
   108	  rule parsePow(Op("//", OS), Num(I, IS))
   109	    => parsed(I, Op("//", OS), IS)
   110	  rule powCombine(I, parsed(J, OS, IS))
   111	    => parsed(powNat(I, J), OS, IS)
   112	
   113	  syntax Tokens ::= "tokens" "(" Ops "," Ints ")"
   114	  syntax Tokens ::= powerPass ( Ops , Ints ) [function]
   115	                  | powerNext ( ParseResult ) [function]
   116	                  | powerCons ( Int , String , Tokens ) [function]
   117	
   118	  rule powerPass(OS, IS) => powerNext(parsePow(OS, IS))
   119	  rule powerNext(parsed(I, .Ops, .Ints))
   120	    => tokens(.Ops, Num(I, .Ints))
   121	  rule powerNext(parsed(I, Op(O, OS), IS))
   122	    => powerCons(I, O, powerPass(OS, IS))
   123	  rule powerCons(I, O, tokens(OS, IS))
   124	    => tokens(Op(O, OS), Num(I, IS))
   125	
   126	  // parseMul consumes one left-associative multiplication/division group.
   127	  syntax ParseResult ::= parseMul ( Ops , Ints ) [function]
   128	  rule parseMul(.Ops, Num(I, .Ints)) => parsed(I, .Ops, .Ints)
   129	  rule parseMul(Op("*", OS), Num(I, Num(J, IS)))
   130	    => parseMul(OS, Num(I *Int J, IS))
   131	  rule parseMul(Op("//", OS), Num(I, Num(J, IS)))
   132	    => parseMul(OS, Num(I /Int J, IS))
   133	    requires J =/=Int 0
   134	  rule parseMul(Op("+", OS), Num(I, IS))
   135	    => parsed(I, Op("+", OS), IS)
   136	  rule parseMul(Op("-", OS), Num(I, IS))
   137	    => parsed(I, Op("-", OS), IS)
   138	
   139	  syntax Tokens ::= mulPass ( Ops , Ints ) [function]
   140	                  | mulNext ( ParseResult ) [function]
   141	                  | mulCons ( Int , String , Tokens ) [function]
   142	  rule mulPass(OS, IS) => mulNext(parseMul(OS, IS))
   143	  rule mulNext(parsed(I, .Ops, .Ints))
   144	    => tokens(.Ops, Num(I, .Ints))
   145	  rule mulNext(parsed(I, Op(O, OS), IS))
   146	    => mulCons(I, O, mulPass(OS, IS))
   147	  rule mulCons(I, O, tokens(OS, IS))
   148	    => tokens(Op(O, OS), Num(I, IS))
   149	
   150	  // Only addition/subtraction remain, so a left fold completes evaluation.
   151	  syntax Int ::= addPass ( Ops , Ints ) [function]
   152	  rule addPass(.Ops, Num(I, .Ints)) => I
   153	  rule addPass(Op("+", OS), Num(I, Num(J, IS)))
   154	    => addPass(OS, Num(I +Int J, IS))
   155	  rule addPass(Op("-", OS), Num(I, Num(J, IS)))
   156	    => addPass(OS, Num(I -Int J, IS))
   157	
   158	  syntax Int ::= pyEval ( Ops , Ints ) [function]
   159	               | afterPower ( Tokens ) [function]
   160	               | afterMul ( Tokens ) [function]
   161	  rule pyEval(OS, IS) => afterPower(powerPass(OS, IS))
   162	  rule afterPower(tokens(OS, IS)) => afterMul(mulPass(OS, IS))
   163	  rule afterMul(tokens(OS, IS)) => addPass(OS, IS)
   164	
   165	  syntax Int ::= powNat ( Int , Int ) [function]
   166	  rule powNat(_, 0) => 1
   167	  rule powNat(A, E) => A *Int powNat(A, E -Int 1)
   168	    requires E >Int 0
   169	endmodule
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // A reusable spelling of the exact solution.mpy term, used only by the
     7	  // negative proof probe.  The positive universal theorem spells it out.
     8	  syntax Pgm ::= "solutionProgram" [function]
     9	  rule solutionProgram =>
    10	    Module(
    11	      FuncDef("do_algebra", Params("operator", "operand"),
    12	        Assign(
    13	          Name("expression"),
    14	          Call(Name("str"), Subscript(Name("operand"), Int(0))))
    15	        For(TupleExpr(Name("oprt"), Name("oprn")), Call(
    16	          Name("zip"),
    17	          Name("operator"),
    18	          Subscript(Name("operand"), Slice(Int(1), NoBound, NoBound))),
    19	          AugAssign(
    20	            Name("expression"),
    21	            "+",
    22	            BinOp("+", Name("oprt"),
    23	                  Call(Name("str"), Name("oprn")))))
    24	        Return(Call(Name("eval"), Name("expression")))))
    25	
    26	  // The postcondition names the independently visible mathematical result.
    27	  // pyEval is the precedence evaluator defined by the semantics; expected is
    28	  // deliberately kept in the verification layer so specifications never
    29	  // mention an implementation cell or continuation.
    30	  syntax Int ::= expected ( Ops , Ints ) [function]
    31	  rule expected(OS, IS) => pyEval(OS, IS)
    32	
    33	  // A one-step proof harness keeps concrete evaluator claims as reachability
    34	  // claims (rather than backend-unsupported bare functional claims).
    35	  syntax KItem ::= "check" "(" Int ")" | "checked" "(" Int ")"
    36	  rule check(I) => checked(I)
    37	
    38	  syntax Bool ::= validOps ( Ops ) [function, total]
    39	  rule validOps(.Ops) => true
    40	  rule validOps(Op(O, OS)) => validOperator(O) andBool validOps(OS)
    41	
    42	  syntax Bool ::= validOperator ( String ) [function, total]
    43	  rule validOperator("+") => true
    44	  rule validOperator("-") => true
    45	  rule validOperator("*") => true
    46	  rule validOperator("//") => true
    47	  rule validOperator("**") => true
    48	  rule validOperator(O) => false
    49	    requires O =/=String "+"
    50	     andBool O =/=String "-"
    51	     andBool O =/=String "*"
    52	     andBool O =/=String "//"
    53	     andBool O =/=String "**"
    54	
    55	  syntax Bool ::= nonNegative ( Ints ) [function, total]
    56	  rule nonNegative(.Ints) => true
    57	  rule nonNegative(Num(I, IS))
    58	    => (I >=Int 0) andBool nonNegative(IS)
    59	endmodule
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Universal source-level theorem.  Under the prompt's shape and value
     7	  // preconditions, executing the exact translated function reaches the
     8	  // precedence-defined mathematical result.
     9	  claim
    10	    <k>
    11	      Module(
    12	        FuncDef("do_algebra", Params("operator", "operand"),
    13	          Assign(
    14	            Name("expression"),
    15	            Call(Name("str"), Subscript(Name("operand"), Int(0))))
    16	          For(TupleExpr(Name("oprt"), Name("oprn")), Call(
    17	            Name("zip"),
    18	            Name("operator"),
    19	            Subscript(Name("operand"), Slice(Int(1), NoBound, NoBound))),
    20	            AugAssign(
    21	              Name("expression"),
    22	              "+",
    23	              BinOp("+", Name("oprt"),
    24	                    Call(Name("str"), Name("oprn")))))
    25	          Return(Call(Name("eval"), Name("expression")))))
    26	      ~> invoke
    27	      => answer(expected(OS, Num(FIRST, REST))) ...
    28	    </k>
    29	    <operators> ops(OS) </operators>
    30	    <operands> ints(Num(FIRST, REST)) </operands>
    31	    <expression>
    32	      noText => builder(OS, Num(FIRST, REST), .Ops, .Ints)
    33	    </expression>
    34	    requires aligned(OS, REST)
    35	     andBool validOps(OS)
    36	     andBool nonNegative(Num(FIRST, REST))
    37	
    38	  // Prompt example: multiplication binds tighter than addition/subtraction.
    39	  claim <k> check(expected(
    40	                 Op("+", Op("*", Op("-", .Ops))),
    41	                 Num(2, Num(3, Num(4, Num(5, .Ints))))))
    42	             => checked(9) ... </k>
    43	
    44	  // Exponentiation is right associative: 2 ** (3 ** 2), not (2 ** 3) ** 2.
    45	  claim <k> check(expected(
    46	                 Op("**", Op("**", .Ops)),
    47	                 Num(2, Num(3, Num(2, .Ints)))))
    48	             => checked(512) ... </k>
    49	
    50	  // Floor division is in the multiplicative precedence group.
    51	  claim <k> check(expected(
    52	                 Op("//", Op("+", .Ops)),
    53	                 Num(7, Num(3, Num(2, .Ints)))))
    54	             => checked(4) ... </k>
    55	
    56	  // Addition is performed after the following multiplication: 2 + 3 * 4.
    57	  claim <k> check(expected(
    58	                 Op("+", Op("*", .Ops)),
    59	                 Num(2, Num(3, Num(4, .Ints)))))
    60	             => checked(14) ... </k>
    61	
    62	  // Subtraction is left associative: (10 - 3) - 2.
    63	  claim <k> check(expected(
    64	                 Op("-", Op("-", .Ops)),
    65	                 Num(10, Num(3, Num(2, .Ints)))))
    66	             => checked(5) ... </k>
    67	endmodule

diff --git a/evidence/capture.sh b/evidence/capture.sh
new file mode 100644
index 0000000000000000000000000000000000000000..e7a30e1c9a7bf2f3b2bc2455d4fa4ccb8ff38409
--- /dev/null
+++ b/evidence/capture.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: capture.sh LOG COMMAND [ARG ...]" >&2
+  exit 2
+fi
+
+audit_log=$1
+shift
+
+{
+  printf '[cwd] %q\n' "$PWD"
+  printf '[command]'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  audit_status=$?
+  printf '\n[exit_status] %d\n' "$audit_status"
+  exit "$audit_status"
+} 2>&1 | tee "$audit_log"
+
+exit "${PIPESTATUS[0]}"
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..b8141b42a50dc38d466bb9ec58fb9c6398fee700
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,183 @@
+#!/usr/bin/env python3
+"""Independent differential check for HumanEval 160 do_algebra."""
+
+from __future__ import annotations
+
+import importlib.util
+import itertools
+import json
+import random
+import sys
+from pathlib import Path
+
+
+REFERENCE_PATH = Path("/reference/canonical.py")
+CANDIDATE_PATH = Path("/tmp/audit-work/reconstruction/solution.py")
+INPUTS_PATH = Path("/audit-output/evidence/differential-inputs.json")
+
+
+def load_entry(module_name: str, source_path: Path):
+    spec = importlib.util.spec_from_file_location(module_name, source_path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {source_path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.do_algebra
+
+
+def outcome(function, operators, operands):
+    try:
+        result = function(list(operators), list(operands))
+        return {
+            "kind": "return",
+            "type": type(result).__name__,
+            "value": result,
+        }
+    except Exception as error:  # Differentially compare intended boundary errors.
+        return {
+            "kind": "raise",
+            "type": type(error).__name__,
+            "message": str(error),
+        }
+
+
+def add_case(cases, seen, group, label, operators, operands):
+    key = (tuple(operators), tuple(operands))
+    if key in seen:
+        return
+    seen.add(key)
+    cases.append(
+        {
+            "group": group,
+            "label": label,
+            "operators": list(operators),
+            "operands": list(operands),
+        }
+    )
+
+
+def build_cases():
+    cases = []
+    seen = set()
+    curated = [
+        ("documented", "prompt-example", ["+", "*", "-"], [2, 3, 4, 5]),
+        ("boundary", "minimum-add", ["+"], [0, 0]),
+        ("boundary", "minimum-subtract", ["-"], [0, 1]),
+        ("boundary", "minimum-multiply", ["*"], [0, 7]),
+        ("boundary", "minimum-floor", ["//"], [7, 3]),
+        ("boundary", "floor-by-zero", ["//"], [7, 0]),
+        ("boundary", "minimum-power", ["**"], [0, 0]),
+        ("boundary", "power-zero", ["**"], [9, 0]),
+        ("precedence", "right-associative-power", ["**", "**"], [2, 3, 2]),
+        ("precedence", "left-associative-floor", ["//", "//"], [20, 3, 2]),
+        ("precedence", "left-associative-subtract", ["-", "-"], [10, 3, 2]),
+        ("precedence", "multiply-before-add", ["+", "*"], [2, 3, 4]),
+        ("precedence", "floor-before-add", ["//", "+"], [7, 3, 2]),
+        (
+            "precedence",
+            "all-levels",
+            ["+", "**", "*", "-", "//"],
+            [2, 3, 2, 4, 5, 2],
+        ),
+        ("boundary", "powered-zero-divisor", ["//", "**"], [7, 0, 1]),
+        ("boundary", "zero-to-zero-divisor-is-one", ["//", "**"], [7, 0, 0]),
+        ("out-of-domain", "no-operator-one-operand", [], [7]),
+        ("out-of-domain", "empty-operands", [], []),
+    ]
+    for group, label, operators, operands in curated:
+        add_case(cases, seen, group, label, operators, operands)
+
+    operators = ["+", "-", "*", "//", "**"]
+    for operator in operators:
+        for operands in itertools.product(range(5), repeat=2):
+            add_case(
+                cases,
+                seen,
+                "exhaustive-one-operator",
+                "all-ops-values-0-through-4",
+                [operator],
+                operands,
+            )
+    for operator_pair in itertools.product(operators, repeat=2):
+        for operands in itertools.product(range(4), repeat=3):
+            add_case(
+                cases,
+                seen,
+                "exhaustive-two-operators",
+                "all-op-pairs-values-0-through-3",
+                operator_pair,
+                operands,
+            )
+
+    generator = random.Random(160)
+    for index in range(500):
+        count = generator.randint(3, 4)
+        generated_operators = [generator.choice(operators) for _ in range(count)]
+        generated_operands = [generator.randint(0, 2) for _ in range(count + 1)]
+        add_case(
+            cases,
+            seen,
+            "deterministic-generated",
+            f"seed-160-index-{index}",
+            generated_operators,
+            generated_operands,
+        )
+    return cases
+
+
+def main() -> int:
+    reference = load_entry("trusted_canonical", REFERENCE_PATH)
+    candidate = load_entry("generated_solution", CANDIDATE_PATH)
+    cases = build_cases()
+    INPUTS_PATH.write_text(json.dumps(cases, indent=2) + "\n", encoding="utf-8")
+
+    mismatches = []
+    outcome_counts = {}
+    curated_results = []
+    for case in cases:
+        reference_outcome = outcome(
+            reference, case["operators"], case["operands"]
+        )
+        candidate_outcome = outcome(
+            candidate, case["operators"], case["operands"]
+        )
+        count_key = (
+            reference_outcome["kind"],
+            reference_outcome["type"],
+        )
+        outcome_counts[count_key] = outcome_counts.get(count_key, 0) + 1
+        if case["group"] in {"documented", "boundary", "precedence", "out-of-domain"}:
+            curated_results.append(
+                {
+                    "label": case["label"],
+                    "operators": case["operators"],
+                    "operands": case["operands"],
+                    "outcome": reference_outcome,
+                }
+            )
+        if reference_outcome != candidate_outcome:
+            mismatches.append(
+                {
+                    "case": case,
+                    "reference": reference_outcome,
+                    "candidate": candidate_outcome,
+                }
+            )
+
+    print(f"reference={REFERENCE_PATH}")
+    print(f"candidate={CANDIDATE_PATH}")
+    print(f"inputs_file={INPUTS_PATH}")
+    print(f"case_count={len(cases)}")
+    print(f"outcome_counts={outcome_counts}")
+    print("curated_results=")
+    print(json.dumps(curated_results, indent=2))
+    print(f"mismatch_count={len(mismatches)}")
+    if mismatches:
+        print(json.dumps(mismatches[:20], indent=2))
+        return 1
+    print("RESULT: all reference and candidate outcomes match")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/evidence/spec-labeled.k b/evidence/spec-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..b82f02f8b217707219896fe56872646a08d88a3f
--- /dev/null
+++ b/evidence/spec-labeled.k
@@ -0,0 +1,64 @@
+requires "verification.k"
+
+module SPEC-LABELED
+  imports VERIFICATION
+
+  claim [entry]:
+    <k>
+      Module(
+        FuncDef("do_algebra", Params("operator", "operand"),
+          Assign(
+            Name("expression"),
+            Call(Name("str"), Subscript(Name("operand"), Int(0))))
+          For(TupleExpr(Name("oprt"), Name("oprn")), Call(
+            Name("zip"),
+            Name("operator"),
+            Subscript(Name("operand"), Slice(Int(1), NoBound, NoBound))),
+            AugAssign(
+              Name("expression"),
+              "+",
+              BinOp("+", Name("oprt"),
+                    Call(Name("str"), Name("oprn")))))
+          Return(Call(Name("eval"), Name("expression")))))
+      ~> invoke
+      => answer(expected(OS, Num(FIRST, REST))) ...
+    </k>
+    <operators> ops(OS) </operators>
+    <operands> ints(Num(FIRST, REST)) </operands>
+    <expression>
+      noText => builder(OS, Num(FIRST, REST), .Ops, .Ints)
+    </expression>
+    requires aligned(OS, REST)
+     andBool validOps(OS)
+     andBool nonNegative(Num(FIRST, REST))
+
+  claim [prompt-example]:
+    <k> check(expected(
+                 Op("+", Op("*", Op("-", .Ops))),
+                 Num(2, Num(3, Num(4, Num(5, .Ints))))))
+             => checked(9) ... </k>
+
+  claim [right-power]:
+    <k> check(expected(
+                 Op("**", Op("**", .Ops)),
+                 Num(2, Num(3, Num(2, .Ints)))))
+             => checked(512) ... </k>
+
+  claim [floor-precedence]:
+    <k> check(expected(
+                 Op("//", Op("+", .Ops)),
+                 Num(7, Num(3, Num(2, .Ints)))))
+             => checked(4) ... </k>
+
+  claim [multiply-precedence]:
+    <k> check(expected(
+                 Op("+", Op("*", .Ops)),
+                 Num(2, Num(3, Num(4, .Ints)))))
+             => checked(14) ... </k>
+
+  claim [left-subtraction]:
+    <k> check(expected(
+                 Op("-", Op("-", .Ops)),
+                 Num(10, Num(3, Num(2, .Ints)))))
+             => checked(5) ... </k>
+endmodule
