+    <operators>
+      ops(Op("+", .Ops))
+    </operators>
+    <operands>
+      ints(Num(1, Num(2, .Ints)))
+    </operands>
+    <expression>
+      noText
+      => builder(
+           Op("+", .Ops),
+           Num(1, Num(2, .Ints)),
+           .Ops,
+           .Ints)
+    </expression>
+endmodule
