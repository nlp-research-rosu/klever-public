from pathlib import Path
import hashlib,itertools,os,stat

def ents(root,dirs):
 r=Path(root); out=[]
 for p in sorted(r.rglob('*')):
  if p.is_dir() and dirs: out.append((p.relative_to(r).as_posix(),'directory',b''))
  elif p.is_file(): out.append((p.relative_to(r).as_posix(),'file',p.read_bytes()))
 return out
for dirs in (False,True):
 for sep in (b'',b'\\0',b'\\n',b':',b' '):
  for path_term in ('path','dotpath'):
   for content_kind in ('raw','hex','binary'):
    for include_kind in (False,True):
     for end_sep in (False,True):
      vals=[]
      for root in ('/candidate','/generation-evidence/codex-trace'):
       h=hashlib.sha256()
       for path,kind,data in ents(root,dirs):
        pp=path if path_term=='path' else './'+path
        h.update(pp.encode()); h.update(sep)
        if include_kind: h.update(kind.encode()); h.update(sep)
        if kind=='file':
         fh=hashlib.sha256(data).digest()
         h.update(data if content_kind=='raw' else (fh.hex().encode() if content_kind=='hex' else fh))
