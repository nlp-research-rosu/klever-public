     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Regenerate the constructor term from the submitted Python source.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# verification.k imports semantic.k, so this one definition supports both
     8	# concrete execution and reachability proofs.
     9	kompile verification.k \
    10	  --backend haskell \
    11	  --main-module VERIFICATION \
    12	  --syntax-module MPY-SYNTAX \
    13	  --output-definition .verification-kompiled
    14	
    15	# Prompt example: 2 + 3 * 4 - 5 = 9.
    16	krun solution.mpy --definition .verification-kompiled \
    17	  -cOPS='ops(Op("+", Op("*", Op("-", .Ops))))' \
    18	  -cOPERANDS='ints(Num(2, Num(3, Num(4, Num(5, .Ints)))))' \
    19	  | tee /dev/stderr | rg -Fq 'answer ( 9 )'
    20	
    21	# Right-associative exponentiation: 2 ** (3 ** 2) = 512.
    22	krun solution.mpy --definition .verification-kompiled \
    23	  -cOPS='ops(Op("**", Op("**", .Ops)))' \
    24	  -cOPERANDS='ints(Num(2, Num(3, Num(2, .Ints))))' \
    25	  | tee /dev/stderr | rg -Fq 'answer ( 512 )'
    26	
    27	# Floor division before addition: 7 // 3 + 2 = 4.
    28	krun solution.mpy --definition .verification-kompiled \
    29	  -cOPS='ops(Op("//", Op("+", .Ops)))' \
    30	  -cOPERANDS='ints(Num(7, Num(3, Num(2, .Ints))))' \
    31	  | tee /dev/stderr | rg -Fq 'answer ( 4 )'
    32	
    33	# A mixed case exercising every precedence level.
    34	krun solution.mpy --definition .verification-kompiled \
    35	  -cOPS='ops(Op("+", Op("**", Op("*", Op("-", Op("//", .Ops))))))' \
    36	  -cOPERANDS='ints(Num(2, Num(3, Num(2, Num(4, Num(5, Num(2, .Ints)))))))' \
    37	  | tee /dev/stderr | rg -Fq 'answer ( 36 )'
    38	
    39	# Left associativity within one level: (20 // 3) // 2 = 3.
    40	krun solution.mpy --definition .verification-kompiled \
    41	  -cOPS='ops(Op("//", Op("//", .Ops)))' \
    42	  -cOPERANDS='ints(Num(20, Num(3, Num(2, .Ints))))' \
    43	  | tee /dev/stderr | rg -Fq 'answer ( 3 )'
    44	
    45	# Required positive target proof: every claim in spec.k must close.
    46	kprove spec.k --definition .verification-kompiled
    47	
    48	# Discrimination probe: the deliberately false result claim must not close.
    49	if kprove mutation-spec.k --definition .verification-kompiled; then
    50	  echo 'ERROR: the deliberately false mutation proof unexpectedly closed' >&2
    51	  exit 1
    52	else
    53	  echo 'Mutation proof failed as expected.'
    54	fi

