        out=payload.get('output',''); outs.append((n,len(str(out)),str(out)[:500].replace('\\n','\\\\n')))
    if payload.get('type')=='message':
        messages.append((n,payload.get('role'),len(str(payload.get('content')))))
print('records',sum(counts.values()))
print('top_types',counts)
print('payload_types',payload_types)
print('messages',messages)
print('calls')
for x in calls: print(x)
print('outputs')
for x in outs: print(x)
