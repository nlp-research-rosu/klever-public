+  rule parsePow(Op("-", OS), Num(I, IS))
+    => parsed(I, Op("-", OS), IS)
+  rule parsePow(Op("*", OS), Num(I, IS))
+    => parsed(I, Op("*", OS), IS)
+  rule parsePow(Op("//", OS), Num(I, IS))
