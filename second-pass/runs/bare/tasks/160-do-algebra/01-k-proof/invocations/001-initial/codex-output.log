+  syntax KItem ::= "invoke"
+                 | "exec" "(" Stmts ")"
+                 | "answer" "(" Int ")"
+
+  syntax Text ::= "noText"
+                | "builder" "(" Ops "," Ints "," Ops "," Ints ")"
