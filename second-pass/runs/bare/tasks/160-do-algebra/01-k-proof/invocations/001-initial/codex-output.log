new file mode 100644
index 0000000000000000000000000000000000000000..2cfa1f2b80d920e6b032da7e2e865cba8e628fdc
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,54 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Regenerate the constructor term from the submitted Python source.
+python3 py2mpy.py solution.py > solution.mpy
+
+# verification.k imports semantic.k, so this one definition supports both
+# concrete execution and reachability proofs.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition .verification-kompiled
+
+# Prompt example: 2 + 3 * 4 - 5 = 9.
+krun solution.mpy --definition .verification-kompiled \
+  -cOPS='ops(Op("+", Op("*", Op("-", .Ops))))' \
+  -cOPERANDS='ints(Num(2, Num(3, Num(4, Num(5, .Ints)))))' \
+  | tee /dev/stderr | rg -Fq 'answer ( 9 )'
+
+# Right-associative exponentiation: 2 ** (3 ** 2) = 512.
+krun solution.mpy --definition .verification-kompiled \
+  -cOPS='ops(Op("**", Op("**", .Ops)))' \
+  -cOPERANDS='ints(Num(2, Num(3, Num(2, .Ints))))' \
+  | tee /dev/stderr | rg -Fq 'answer ( 512 )'
+
+# Floor division before addition: 7 // 3 + 2 = 4.
+krun solution.mpy --definition .verification-kompiled \
+  -cOPS='ops(Op("//", Op("+", .Ops)))' \
+  -cOPERANDS='ints(Num(7, Num(3, Num(2, .Ints))))' \
+  | tee /dev/stderr | rg -Fq 'answer ( 4 )'
+
+# A mixed case exercising every precedence level.
+krun solution.mpy --definition .verification-kompiled \
+  -cOPS='ops(Op("+", Op("**", Op("*", Op("-", Op("//", .Ops))))))' \
+  -cOPERANDS='ints(Num(2, Num(3, Num(2, Num(4, Num(5, Num(2, .Ints)))))))' \
+  | tee /dev/stderr | rg -Fq 'answer ( 36 )'
+
+# Left associativity within one level: (20 // 3) // 2 = 3.
+krun solution.mpy --definition .verification-kompiled \
+  -cOPS='ops(Op("//", Op("//", .Ops)))' \
+  -cOPERANDS='ints(Num(20, Num(3, Num(2, .Ints))))' \
+  | tee /dev/stderr | rg -Fq 'answer ( 3 )'
+
+# Required positive target proof: every claim in spec.k must close.
+kprove spec.k --definition .verification-kompiled
+
+# Discrimination probe: the deliberately false result claim must not close.
+if kprove mutation-spec.k --definition .verification-kompiled; then
+  echo 'ERROR: the deliberately false mutation proof unexpectedly closed' >&2
+  exit 1
+else
+  echo 'Mutation proof failed as expected.'
+fi
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..af8cc30ca843a4f2c07fea91a17165d4642a3e31
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,169 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Strings ::= List{String, ","}
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Exprs ::= List{Expr, ","}
+
+  syntax Bound ::= Expr | "NoBound"
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "Slice" "(" Bound "," Bound "," Bound ")"
+                | "TupleExpr" "(" Exprs ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "AugAssign" "(" Expr "," String "," Expr ")"
+                | "Return" "(" Expr ")"
+
+  syntax Ops ::= ".Ops" | "Op" "(" String "," Ops ")"
+  syntax Ints ::= ".Ints" | "Num" "(" Int "," Ints ")"
+  syntax OpList ::= "ops" "(" Ops ")"
+  syntax NumList ::= "ints" "(" Ints ")"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports STRING
+  imports BOOL
+
+  syntax KItem ::= "invoke"
+                 | "exec" "(" Stmts ")"
+                 | "answer" "(" Int ")"
+
+  syntax Text ::= "noText"
+                | "builder" "(" Ops "," Ints "," Ops "," Ints ")"
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm ~> invoke </k>
+      <operators> $OPS:OpList </operators>
+      <operands> $OPERANDS:NumList </operands>
+      <expression> noText </expression>
+    </mpy>
+
+  rule <k> Module(FuncDef("do_algebra", Params("operator", "operand"), BODY))
+            ~> invoke => exec(BODY) ... </k>
+
+  rule <k> exec(Assign(
+                    Name("expression"),
+                    Call(Name("str"), Subscript(Name("operand"), Int(0))))
+                  REST) => exec(REST) ... </k>
+       <operators> ops(OS) </operators>
+       <operands> ints(Num(I, IS)) </operands>
+       <expression> _ => builder(OS, Num(I, IS), OS, IS) </expression>
+
+  rule <k> exec(For(
+                    TupleExpr(Name("oprt"), Name("oprn")),
+                    Call(Name("zip"),
+                         Name("operator"),
+                         Subscript(Name("operand"),
+                                   Slice(Int(1), NoBound, NoBound))),
+                    AugAssign(
+                      Name("expression"),
+                      "+",
+                      BinOp("+", Name("oprt"),
+                            Call(Name("str"), Name("oprn")))))
+                  REST) => exec(REST) ... </k>
+       <expression>
+         builder(ALLOPS, ALLINTS, OS, IS)
+         => builder(ALLOPS, ALLINTS, .Ops, .Ints)
+       </expression>
+    requires aligned(OS, IS)
+
+  rule <k> exec(Return(Call(Name("eval"), Name("expression"))) _REST)
+            => answer(pyEval(ALLOPS, ALLINTS)) ... </k>
+       <expression> builder(ALLOPS, ALLINTS, .Ops, .Ints) </expression>
+
+  // The zip loop consumes exactly one operand for each operator.
+  syntax Bool ::= aligned ( Ops , Ints ) [function, total]
+  rule aligned(.Ops, .Ints) => true
+  rule aligned(Op(_, OS), Num(_, IS)) => aligned(OS, IS)
+  rule aligned(.Ops, Num(_, _)) => false
+  rule aligned(Op(_, _), .Ints) => false
+
+  // A small expression evaluator with Python's precedence and associativity.
+  // parsePow consumes one right-associative exponentiation group.
+  syntax ParseResult ::= "parsed" "(" Int "," Ops "," Ints ")"
+  syntax ParseResult ::= parsePow ( Ops , Ints ) [function]
+                       | powCombine ( Int , ParseResult ) [function]
+
+  rule parsePow(.Ops, Num(I, .Ints)) => parsed(I, .Ops, .Ints)
+  rule parsePow(Op("**", OS), Num(I, IS))
+    => powCombine(I, parsePow(OS, IS))
+  rule parsePow(Op("+", OS), Num(I, IS))
+    => parsed(I, Op("+", OS), IS)
+  rule parsePow(Op("-", OS), Num(I, IS))
+    => parsed(I, Op("-", OS), IS)
+  rule parsePow(Op("*", OS), Num(I, IS))
+    => parsed(I, Op("*", OS), IS)
+  rule parsePow(Op("//", OS), Num(I, IS))
+    => parsed(I, Op("//", OS), IS)
+  rule powCombine(I, parsed(J, OS, IS))
+    => parsed(powNat(I, J), OS, IS)
+
+  syntax Tokens ::= "tokens" "(" Ops "," Ints ")"
+  syntax Tokens ::= powerPass ( Ops , Ints ) [function]
+                  | powerNext ( ParseResult ) [function]
+                  | powerCons ( Int , String , Tokens ) [function]
+
+  rule powerPass(OS, IS) => powerNext(parsePow(OS, IS))
+  rule powerNext(parsed(I, .Ops, .Ints))
+    => tokens(.Ops, Num(I, .Ints))
+  rule powerNext(parsed(I, Op(O, OS), IS))
+    => powerCons(I, O, powerPass(OS, IS))
+  rule powerCons(I, O, tokens(OS, IS))
+    => tokens(Op(O, OS), Num(I, IS))
+
+  // parseMul consumes one left-associative multiplication/division group.
+  syntax ParseResult ::= parseMul ( Ops , Ints ) [function]
+  rule parseMul(.Ops, Num(I, .Ints)) => parsed(I, .Ops, .Ints)
+  rule parseMul(Op("*", OS), Num(I, Num(J, IS)))
+    => parseMul(OS, Num(I *Int J, IS))
+  rule parseMul(Op("//", OS), Num(I, Num(J, IS)))
+    => parseMul(OS, Num(I /Int J, IS))
+    requires J =/=Int 0
+  rule parseMul(Op("+", OS), Num(I, IS))
+    => parsed(I, Op("+", OS), IS)
+  rule parseMul(Op("-", OS), Num(I, IS))
+    => parsed(I, Op("-", OS), IS)
+
+  syntax Tokens ::= mulPass ( Ops , Ints ) [function]
+                  | mulNext ( ParseResult ) [function]
+                  | mulCons ( Int , String , Tokens ) [function]
+  rule mulPass(OS, IS) => mulNext(parseMul(OS, IS))
+  rule mulNext(parsed(I, .Ops, .Ints))
+    => tokens(.Ops, Num(I, .Ints))
+  rule mulNext(parsed(I, Op(O, OS), IS))
+    => mulCons(I, O, mulPass(OS, IS))
+  rule mulCons(I, O, tokens(OS, IS))
+    => tokens(Op(O, OS), Num(I, IS))
+
+  // Only addition/subtraction remain, so a left fold completes evaluation.
+  syntax Int ::= addPass ( Ops , Ints ) [function]
+  rule addPass(.Ops, Num(I, .Ints)) => I
+  rule addPass(Op("+", OS), Num(I, Num(J, IS)))
+    => addPass(OS, Num(I +Int J, IS))
+  rule addPass(Op("-", OS), Num(I, Num(J, IS)))
+    => addPass(OS, Num(I -Int J, IS))
+
+  syntax Int ::= pyEval ( Ops , Ints ) [function]
+               | afterPower ( Tokens ) [function]
+               | afterMul ( Tokens ) [function]
+  rule pyEval(OS, IS) => afterPower(powerPass(OS, IS))
+  rule afterPower(tokens(OS, IS)) => afterMul(mulPass(OS, IS))
+  rule afterMul(tokens(OS, IS)) => addPass(OS, IS)
+
+  syntax Int ::= powNat ( Int , Int ) [function]
+  rule powNat(_, 0) => 1
+  rule powNat(A, E) => A *Int powNat(A, E -Int 1)
+    requires E >Int 0
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..b8f280128404240521771a919e10b2fa6aaf47bb
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,5 @@
+def do_algebra(operator, operand):
+    expression = str(operand[0])
+    for oprt, oprn in zip(operator, operand[1:]):
+        expression += oprt + str(oprn)
+    return eval(expression)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0cb1db7a4c5fe49e6b654ae99d5fcbb6fa5ad24f
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,67 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal source-level theorem.  Under the prompt's shape and value
+  // preconditions, executing the exact translated function reaches the
+  // precedence-defined mathematical result.
+  claim
+    <k>
+      Module(
+        FuncDef("do_algebra", Params("operator", "operand"),
+          Assign(
+            Name("expression"),
+            Call(Name("str"), Subscript(Name("operand"), Int(0))))
+          For(TupleExpr(Name("oprt"), Name("oprn")), Call(
+            Name("zip"),
+            Name("operator"),
+            Subscript(Name("operand"), Slice(Int(1), NoBound, NoBound))),
+            AugAssign(
+              Name("expression"),
+              "+",
+              BinOp("+", Name("oprt"),
+                    Call(Name("str"), Name("oprn")))))
+          Return(Call(Name("eval"), Name("expression")))))
+      ~> invoke
+      => answer(expected(OS, Num(FIRST, REST))) ...
+    </k>
+    <operators> ops(OS) </operators>
+    <operands> ints(Num(FIRST, REST)) </operands>
+    <expression>
+      noText => builder(OS, Num(FIRST, REST), .Ops, .Ints)
+    </expression>
+    requires aligned(OS, REST)
+     andBool validOps(OS)
+     andBool nonNegative(Num(FIRST, REST))
+
+  // Prompt example: multiplication binds tighter than addition/subtraction.
+  claim <k> check(expected(
+                 Op("+", Op("*", Op("-", .Ops))),
+                 Num(2, Num(3, Num(4, Num(5, .Ints))))))
+             => checked(9) ... </k>
+
+  // Exponentiation is right associative: 2 ** (3 ** 2), not (2 ** 3) ** 2.
+  claim <k> check(expected(
+                 Op("**", Op("**", .Ops)),
+                 Num(2, Num(3, Num(2, .Ints)))))
+             => checked(512) ... </k>
+
+  // Floor division is in the multiplicative precedence group.
+  claim <k> check(expected(
+                 Op("//", Op("+", .Ops)),
+                 Num(7, Num(3, Num(2, .Ints)))))
+             => checked(4) ... </k>
+
+  // Addition is performed after the following multiplication: 2 + 3 * 4.
+  claim <k> check(expected(
+                 Op("+", Op("*", .Ops)),
+                 Num(2, Num(3, Num(4, .Ints)))))
+             => checked(14) ... </k>
+
+  // Subtraction is left associative: (10 - 3) - 2.
+  claim <k> check(expected(
+                 Op("-", Op("-", .Ops)),
+                 Num(10, Num(3, Num(2, .Ints)))))
+             => checked(5) ... </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a4e98c464978917b8bafca54377ee7db59df6906
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,59 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A reusable spelling of the exact solution.mpy term, used only by the
+  // negative proof probe.  The positive universal theorem spells it out.
+  syntax Pgm ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      FuncDef("do_algebra", Params("operator", "operand"),
+        Assign(
+          Name("expression"),
+          Call(Name("str"), Subscript(Name("operand"), Int(0))))
+        For(TupleExpr(Name("oprt"), Name("oprn")), Call(
+          Name("zip"),
+          Name("operator"),
+          Subscript(Name("operand"), Slice(Int(1), NoBound, NoBound))),
+          AugAssign(
+            Name("expression"),
+            "+",
+            BinOp("+", Name("oprt"),
+                  Call(Name("str"), Name("oprn")))))
+        Return(Call(Name("eval"), Name("expression")))))
+
+  // The postcondition names the independently visible mathematical result.
+  // pyEval is the precedence evaluator defined by the semantics; expected is
+  // deliberately kept in the verification layer so specifications never
+  // mention an implementation cell or continuation.
+  syntax Int ::= expected ( Ops , Ints ) [function]
+  rule expected(OS, IS) => pyEval(OS, IS)
+
+  // A one-step proof harness keeps concrete evaluator claims as reachability
+  // claims (rather than backend-unsupported bare functional claims).
+  syntax KItem ::= "check" "(" Int ")" | "checked" "(" Int ")"
+  rule check(I) => checked(I)
+
+  syntax Bool ::= validOps ( Ops ) [function, total]
+  rule validOps(.Ops) => true
+  rule validOps(Op(O, OS)) => validOperator(O) andBool validOps(OS)
+
+  syntax Bool ::= validOperator ( String ) [function, total]
+  rule validOperator("+") => true
+  rule validOperator("-") => true
+  rule validOperator("*") => true
+  rule validOperator("//") => true
+  rule validOperator("**") => true
+  rule validOperator(O) => false
+    requires O =/=String "+"
+     andBool O =/=String "-"
+     andBool O =/=String "*"
+     andBool O =/=String "//"
+     andBool O =/=String "**"
+
+  syntax Bool ::= nonNegative ( Ints ) [function, total]
+  rule nonNegative(.Ints) => true
+  rule nonNegative(Num(I, IS))
+    => (I >=Int 0) andBool nonNegative(IS)
+endmodule

