+    </operators>
+    <operands>
+      ints(Num(2, Num(3, Num(4, Num(5, .Ints)))))
+    </operands>
+    <expression>
+      noText
+      => builder(
+           Op("+", Op("*", Op("-", .Ops))),
+           Num(2, Num(3, Num(4, Num(5, .Ints)))),
+           .Ops,
+           .Ints)
