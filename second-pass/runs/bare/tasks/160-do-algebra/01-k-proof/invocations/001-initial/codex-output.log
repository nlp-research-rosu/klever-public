+  syntax NumList ::= "ints" "(" Ints ")"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports STRING
+  imports BOOL
+
+  syntax KItem ::= "invoke"
+                 | "exec" "(" Stmts ")"
+                 | "answer" "(" Int ")"
+
+  syntax Text ::= "noText"
+                | "builder" "(" Ops "," Ints "," Ops "," Ints ")"
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm ~> invoke </k>
+      <operators> $OPS:OpList </operators>
+      <operands> $OPERANDS:NumList </operands>
+      <expression> noText </expression>
+    </mpy>
