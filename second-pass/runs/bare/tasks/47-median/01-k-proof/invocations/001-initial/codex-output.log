+requires "semantic.k"
+
+module SPEC
+  imports MEDIAN-VERIFICATION
+
+  // Main correctness theorem: execution of the translated solution refines
+  // the independently stated promptMedian reference for every integer list
+  // in the implementation's safe domain (at least three elements).
+  claim
+    <median>
+      <k>
+        Module(
+          FuncDef("median", Params("l"),
+            Assign(Name("ordered"), Call(Name("sorted"), Name("l")))
+            Assign(
+              Name("middle"),
+              BinOp("//", Call(Name("len"), Name("ordered")), Int(2)))
+            If(BinOp("%", Call(Name("len"), Name("ordered")), Int(2)),
+              Return(Subscript(Name("ordered"), Name("middle"))),
+              Return(
+                BinOp(
+                  "/",
+                  BinOp(
+                    "+",
+                    Subscript(Name("ordered"), Name("middle")),
+                    Subscript(
+                      Name("ordered"),
+                      BinOp("+", Name("middle"), Int(1)))),
+                  Int(2))))))
+        => .K
+      </k>
+      <input> IS:Ints </input>
+      <result> noResult => promptMedian(IS) </result>
+    </median>
+    requires lenInts(IS) >=Int 3
+
+  // The two examples in prompt.py are retained as direct end-to-end claims.
+  claim
+    <median>
+      <k>
+        Module(
+          FuncDef("median", Params("l"),
+            Assign(Name("ordered"), Call(Name("sorted"), Name("l")))
+            Assign(
+              Name("middle"),
+              BinOp("//", Call(Name("len"), Name("ordered")), Int(2)))
+            If(BinOp("%", Call(Name("len"), Name("ordered")), Int(2)),
+              Return(Subscript(Name("ordered"), Name("middle"))),
+              Return(
+                BinOp(
+                  "/",
+                  BinOp(
+                    "+",
+                    Subscript(Name("ordered"), Name("middle")),
+                    Subscript(
+                      Name("ordered"),
+                      BinOp("+", Name("middle"), Int(1)))),
+                  Int(2))))))
+        => .K
+      </k>
+      <input>
+        cons(3, cons(1, cons(2, cons(4, cons(5, nil)))))
+      </input>
+      <result> noResult => intVal(3) </result>
+    </median>
+
+  claim
+    <median>
+      <k>
+        Module(
+          FuncDef("median", Params("l"),
+            Assign(Name("ordered"), Call(Name("sorted"), Name("l")))
+            Assign(
+              Name("middle"),
+              BinOp("//", Call(Name("len"), Name("ordered")), Int(2)))
+            If(BinOp("%", Call(Name("len"), Name("ordered")), Int(2)),
+              Return(Subscript(Name("ordered"), Name("middle"))),
+              Return(
+                BinOp(
+                  "/",
+                  BinOp(
+                    "+",
+                    Subscript(Name("ordered"), Name("middle")),
+                    Subscript(
+                      Name("ordered"),
+                      BinOp("+", Name("middle"), Int(1)))),
+                  Int(2))))))
+        => .K
+      </k>
+      <input>
+        cons(-10, cons(4, cons(6, cons(1000, cons(10, cons(20, nil))))))
+      </input>
+      <result> noResult => floatVal(30, 2) </result>
+    </median>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a362fd2cf0cf6de767e64435e192ee2aeede8173
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,19 @@
+module MEDIAN-VERIFICATION
+  imports MEDIAN-SEMANTICS
+
+  // Independent reference function extracted from the supplied examples.
+  // For odd sizes it selects n//2.  For even sizes it averages n//2 and
+  // n//2+1, which is the only interpretation that yields the prompt's 15.0.
+  syntax Val ::= promptMedian(Ints) [function]
+               | promptMedianSorted(Ints) [function]
+
+  rule promptMedian(IS) => promptMedianSorted(sortInts(IS))
+  rule promptMedianSorted(ORDERED)
+    => ifVal(
+         intVal(lenInts(ORDERED) %Int 2),
+         intVal(nthInt(ORDERED, lenInts(ORDERED) /Int 2)),
+         floatVal(
+           nthInt(ORDERED, lenInts(ORDERED) /Int 2)
+             +Int nthInt(ORDERED, (lenInts(ORDERED) /Int 2) +Int 1),
+           2))
+endmodule

