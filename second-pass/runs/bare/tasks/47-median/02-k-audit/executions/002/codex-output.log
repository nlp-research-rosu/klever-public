diff --git a//tmp/audit-work/candidate-src/spec-oob-totality-witness.k b//tmp/audit-work/candidate-src/spec-oob-totality-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..c870c9f06421f6c40090ff31f734747cd801f2e5
--- /dev/null
+++ b//tmp/audit-work/candidate-src/spec-oob-totality-witness.k
@@ -0,0 +1,35 @@
+requires "semantic.k"
+
+module SPEC-OOB-TOTALITY-WITNESS
+  imports MEDIAN-VERIFICATION
+
+  claim [length-two-normal-return]:
+    <median>
+      <k>
+        Module(
+          FuncDef("median", Params("l"),
+            Assign(Name("ordered"), Call(Name("sorted"), Name("l")))
+            Assign(
+              Name("middle"),
+              BinOp("//", Call(Name("len"), Name("ordered")), Int(2)))
+            If(BinOp("%", Call(Name("len"), Name("ordered")), Int(2)),
+              Return(Subscript(Name("ordered"), Name("middle"))),
+              Return(
+                BinOp(
+                  "/",
+                  BinOp(
+                    "+",
+                    Subscript(Name("ordered"), Name("middle")),
+                    Subscript(
+                      Name("ordered"),
+                      BinOp("+", Name("middle"), Int(1)))),
+                  Int(2))))))
+        => .K
+      </k>
+      <input> cons(2, cons(10, nil)) </input>
+      <result>
+        noResult
+        => floatVal(10 +Int nthInt(nil, 0), 2)
+      </result>
+    </median>
+endmodule
