     1	module MEDIAN-VERIFICATION
     2	  imports MEDIAN-SEMANTICS
     3	
     4	  // Independent reference function extracted from the supplied examples.
     5	  // For odd sizes it selects n//2.  For even sizes it averages n//2 and
     6	  // n//2+1, which is the only interpretation that yields the prompt's 15.0.
     7	  syntax Val ::= promptMedian(Ints) [function]
     8	               | promptMedianSorted(Ints) [function]
     9	
    10	  rule promptMedian(IS) => promptMedianSorted(sortInts(IS))
    11	  rule promptMedianSorted(ORDERED)
    12	    => ifVal(
    13	         intVal(lenInts(ORDERED) %Int 2),
    14	         intVal(nthInt(ORDERED, lenInts(ORDERED) /Int 2)),
    15	         floatVal(
    16	           nthInt(ORDERED, lenInts(ORDERED) /Int 2)
    17	             +Int nthInt(ORDERED, (lenInts(ORDERED) /Int 2) +Int 1),
    18	           2))
    19	endmodule
