module MPY-SYNTAX
  imports INT
  imports FLOAT
  imports BOOL
  imports STRING
  imports MAP

  // The constructor grammar used by the portion of py2mpy.py exercised by
  // solution.py.  The constructors retain the structure of the CPython AST.
  syntax Program ::= "Module" "(" Stmts ")"
  syntax Stmts  ::= Stmt
  syntax Stmt   ::= "FuncDef" "(" String "," Params "," Stmts ")"
                  | "Return" "(" Expr ")"
  syntax Params ::= "Params" "(" String "," String "," String ")"

  syntax Expr ::= "Name" "(" String ")"
                | "Int" "(" Int ")"
                | "Bool" "(" Bool ")"
                | "BinOp" "(" String "," Expr "," Expr ")"
                | "Call" "(" Expr "," Expr ")"
                | "Compare" "(" Expr "," CmpOp ")"
                | "BoolOp" "(" String "," Expr "," Expr "," Expr ")"
                | "BoolOp" "(" String "," Expr "," Expr "," Expr "," Expr ")"
  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"

  // Runtime values distinguish Python integers from every modeled
  // non-integer number.  Bool is deliberately non-integer here because the
  // solution uses exact type(x) == int, not isinstance(x, int).
  syntax IntVal    ::= "intVal" "(" Int ")"
  syntax NonIntVal ::= "floatVal" "(" Float ")"
                     | "boolVal" "(" Bool ")"
                     | "otherNumberVal" "(" String ")"
  syntax Val ::= IntVal | NonIntVal
               | "typeVal" "(" String ")"

  syntax KItem ::= "Invoke" "(" Program "," Val "," Val "," Val ")"
endmodule

module MPY-SEMANTICS
  imports MPY-SYNTAX

  configuration
    <mpy>
      <k> $PGM:K </k>
      <env> .Map </env>
    </mpy>

  syntax KItem ::= "exec" "(" Stmts ")"
                 | "eval" "(" Expr ")"
                 | "finishCall"
                 | "typeOf"
                 | "binLeft" "(" String "," Expr ")"
                 | "binRight" "(" String "," Val ")"
                 | "compareLeft" "(" String "," Expr ")"
                 | "compareRight" "(" String "," Val ")"
                 | "andThen" "(" Expr ")"
                 | "orThen" "(" Expr ")"

  // Module/function entry and return.  The local environment is cleared when
  // the call finishes, making each invocation independent.
  rule <k> Invoke(Module(FuncDef(_F, Params(X, Y, Z), BODY)), V1, V2, V3)
           => exec(BODY) ~> finishCall ... </k>
       <env> .Map => X |-> V1 Y |-> V2 Z |-> V3 </env>
  rule <k> exec(Return(E)) => eval(E) ... </k>
  rule <k> V:Val ~> finishCall => V ... </k>
       <env> _ => .Map </env>

  // Literals, local names, and the built-in int type object.
  rule <k> eval(Int(I)) => intVal(I) ... </k>
  rule <k> eval(Bool(B)) => boolVal(B) ... </k>
  rule <k> eval(Name("int")) => typeVal("int") ... </k>
  rule <k> eval(Name(X)) => V ... </k>
       <env>... X |-> V ...</env>

  // The only built-in call emitted by solution.py: exact Python type.
  rule <k> eval(Call(Name("type"), E)) => eval(E) ~> typeOf ... </k>
  rule <k> _I:IntVal ~> typeOf => typeVal("int") ... </k>
  rule <k> _N:NonIntVal ~> typeOf => typeVal("non-int") ... </k>

  // Left-to-right integer addition.
  rule <k> eval(BinOp(OP, E1, E2)) => eval(E1) ~> binLeft(OP, E2) ... </k>
  rule <k> V1:Val ~> binLeft(OP, E2) => eval(E2) ~> binRight(OP, V1) ... </k>
  rule <k> intVal(I2) ~> binRight("+", intVal(I1))
           => intVal(I1 +Int I2) ... </k>

  // The target uses one-element comparison chains.  Both integer equality
  // and equality of type objects return a Python boolean value.
  rule <k> eval(Compare(E1, CmpOp(OP, E2)))
           => eval(E1) ~> compareLeft(OP, E2) ... </k>
  rule <k> V1:Val ~> compareLeft(OP, E2)
           => eval(E2) ~> compareRight(OP, V1) ... </k>
  rule <k> intVal(I2) ~> compareRight("==", intVal(I1))
           => boolVal(I1 ==Int I2) ... </k>
  rule <k> typeVal(T2) ~> compareRight("==", typeVal(T1))
           => boolVal(T1 ==String T2) ... </k>

  // Python's and/or are evaluated left-to-right and short circuit.  The
  // continuation rules skip, rather than evaluate, remaining operands once
  // their result is determined.
  rule <k> eval(BoolOp("and", E1, E2, E3))
           => eval(E1) ~> andThen(E2) ~> andThen(E3) ... </k>
  rule <k> eval(BoolOp("and", E1, E2, E3, E4))
           => eval(E1) ~> andThen(E2) ~> andThen(E3) ~> andThen(E4) ... </k>
  rule <k> boolVal(true) ~> andThen(E) => eval(E) ... </k>
  rule <k> boolVal(false) ~> andThen(_E) => boolVal(false) ... </k>

  rule <k> eval(BoolOp("or", E1, E2, E3))
           => eval(E1) ~> orThen(E2) ~> orThen(E3) ... </k>
  rule <k> boolVal(false) ~> orThen(E) => eval(E) ... </k>
  rule <k> boolVal(true) ~> orThen(_E) => boolVal(true) ... </k>
endmodule
requires "semantic.k"

module ANY-INT-VERIFICATION
  imports MPY-SEMANTICS

  // This macro is the exact constructor tree in solution.mpy.  Keeping the
  // program separate from the semantics prevents the operational rules from
  // baking in the answer to the task.
  syntax Program ::= "solutionProgram" [macro]
  rule solutionProgram =>
    Module(
      FuncDef("any_int", Params("x", "y", "z"),
        Return(
          BoolOp(
            "and",
            Compare(Call(Name("type"), Name("x")), CmpOp("==", Name("int"))),
            Compare(Call(Name("type"), Name("y")), CmpOp("==", Name("int"))),
            Compare(Call(Name("type"), Name("z")), CmpOp("==", Name("int"))),
            BoolOp(
              "or",
              Compare(BinOp("+", Name("x"), Name("y")), CmpOp("==", Name("z"))),
              Compare(BinOp("+", Name("x"), Name("z")), CmpOp("==", Name("y"))),
              Compare(BinOp("+", Name("y"), Name("z")), CmpOp("==", Name("x"))))))))

  syntax KItem ::= "RunAnyInt" "(" Val "," Val "," Val ")" [macro]
  rule RunAnyInt(X, Y, Z) => Invoke(solutionProgram, X, Y, Z)
endmodule
requires "verification.k"

module ANY-INT-SPEC
  imports ANY-INT-VERIFICATION

  // Together these four claims partition all integer triples according to
  // the first true sum equality.  Thus they prove the complete positive and
  // negative behavior on Python integers, not just concrete examples.
  claim <k> RunAnyInt(intVal(X), intVal(Y), intVal(Z))
             => boolVal(true) </k>
        <env> .Map </env>
    requires X +Int Y ==Int Z

  claim <k> RunAnyInt(intVal(X), intVal(Y), intVal(Z))
             => boolVal(true) </k>
        <env> .Map </env>
    requires notBool (X +Int Y ==Int Z)
     andBool X +Int Z ==Int Y

  claim <k> RunAnyInt(intVal(X), intVal(Y), intVal(Z))
             => boolVal(true) </k>
        <env> .Map </env>
    requires notBool (X +Int Y ==Int Z)
     andBool notBool (X +Int Z ==Int Y)
     andBool Y +Int Z ==Int X

  claim <k> RunAnyInt(intVal(X), intVal(Y), intVal(Z))
             => boolVal(false) </k>
        <env> .Map </env>
    requires notBool (X +Int Y ==Int Z)
     andBool notBool (X +Int Z ==Int Y)
     andBool notBool (Y +Int Z ==Int X)

  // These claims partition every call containing a non-integer according to
  // the position of its first non-integer argument.  Later arguments remain
  // fully symbolic because short-circuiting prevents their arithmetic use.
  claim <k> RunAnyInt(_N:NonIntVal, _Y:Val, _Z:Val)
             => boolVal(false) </k>
        <env> .Map </env>

  claim <k> RunAnyInt(_X:IntVal, _N:NonIntVal, _Z:Val)
             => boolVal(false) </k>
        <env> .Map </env>

  claim <k> RunAnyInt(_X:IntVal, _Y:IntVal, _N:NonIntVal)
             => boolVal(false) </k>
        <env> .Map </env>
endmodule
#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

# Recreate the submitted constructor program with the fixed translator.
python3 py2mpy.py solution.py > solution.mpy

# Compile the semantics and its exact solution-program wrapper for both krun
# and kprove.  The Haskell backend is the symbolic proof backend.
kompile verification.k \
  --backend haskell \
  --main-module ANY-INT-VERIFICATION \
  --syntax-module ANY-INT-VERIFICATION \
  -o verification-kompiled

# Prove that the constructor tree generated above is byte-for-byte equal after
# parsing/macro expansion to the tree used by all verification claims.
actual_program="$({
  kast -d verification-kompiled \
    -m ANY-INT-VERIFICATION -s Program \
    --expand-macros -o kore solution.mpy
})"
verified_program="$({
  kast -d verification-kompiled \
    -m ANY-INT-VERIFICATION -s Program \
    --expand-macros -o kore -e solutionProgram
})"
test "$actual_program" = "$verified_program"

run_case() {
  local term="$1"
  local expected="$2"
  local output
  output="$(krun -d verification-kompiled -cPGM="$term")"
  printf '%s\n' "$output"
  grep -Fq "boolVal ( $expected )" <<<"$output"
}

# Exercise every example in prompt.py through the K semantics.
run_case 'RunAnyInt(intVal(5), intVal(2), intVal(7))' true
run_case 'RunAnyInt(intVal(3), intVal(2), intVal(2))' false
run_case 'RunAnyInt(intVal(3), intVal(-2), intVal(1))' true
run_case 'RunAnyInt(floatVal(3.6), floatVal(-2.2), intVal(2))' false

# Prove all seven exhaustive symbolic claims in spec.k.  Success prints #Top.
kprove spec.k \
  -d verification-kompiled \
  --spec-module ANY-INT-SPEC

