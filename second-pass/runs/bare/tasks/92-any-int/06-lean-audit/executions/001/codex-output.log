+  -cPGM='RunAnyInt(intVal(5), intVal(2), intVal(7))'
+krun --definition verification-kompiled \
+  -cPGM='RunAnyInt(intVal(3), intVal(2), intVal(2))'
+krun --definition verification-kompiled \
