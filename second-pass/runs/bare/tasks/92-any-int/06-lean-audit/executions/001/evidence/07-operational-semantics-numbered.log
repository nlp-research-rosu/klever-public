     8	  // The constructor grammar used by the portion of py2mpy.py exercised by
     9	  // solution.py.  The constructors retain the structure of the CPython AST.
    10	  syntax Program ::= "Module" "(" Stmts ")"
    11	  syntax Stmts  ::= Stmt
    12	  syntax Stmt   ::= "FuncDef" "(" String "," Params "," Stmts ")"
    13	                  | "Return" "(" Expr ")"
    14	  syntax Params ::= "Params" "(" String "," String "," String ")"
    15	
    16	  syntax Expr ::= "Name" "(" String ")"
    17	                | "Int" "(" Int ")"
    18	                | "Bool" "(" Bool ")"
    19	                | "BinOp" "(" String "," Expr "," Expr ")"
    20	                | "Call" "(" Expr "," Expr ")"
    21	                | "Compare" "(" Expr "," CmpOp ")"
    22	                | "BoolOp" "(" String "," Expr "," Expr "," Expr ")"
    23	                | "BoolOp" "(" String "," Expr "," Expr "," Expr "," Expr ")"
    24	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    25	
    26	  // Runtime values distinguish Python integers from every modeled
    27	  // non-integer number.  Bool is deliberately non-integer here because the
    28	  // solution uses exact type(x) == int, not isinstance(x, int).
    29	  syntax IntVal    ::= "intVal" "(" Int ")"
    30	  syntax NonIntVal ::= "floatVal" "(" Float ")"
    31	                     | "boolVal" "(" Bool ")"
    32	                     | "otherNumberVal" "(" String ")"
    33	  syntax Val ::= IntVal | NonIntVal
    34	               | "typeVal" "(" String ")"
    35	
    36	  syntax KItem ::= "Invoke" "(" Program "," Val "," Val "," Val ")"
    37	endmodule
