    80	  // Left-to-right integer addition.
    81	  rule <k> eval(BinOp(OP, E1, E2)) => eval(E1) ~> binLeft(OP, E2) ... </k>
    82	  rule <k> V1:Val ~> binLeft(OP, E2) => eval(E2) ~> binRight(OP, V1) ... </k>
    83	  rule <k> intVal(I2) ~> binRight("+", intVal(I1))
    84	           => intVal(I1 +Int I2) ... </k>
    85	
    86	  // The target uses one-element comparison chains.  Both integer equality
    87	  // and equality of type objects return a Python boolean value.
    88	  rule <k> eval(Compare(E1, CmpOp(OP, E2)))
    89	           => eval(E1) ~> compareLeft(OP, E2) ... </k>
    90	  rule <k> V1:Val ~> compareLeft(OP, E2)
    91	           => eval(E2) ~> compareRight(OP, V1) ... </k>
    92	  rule <k> intVal(I2) ~> compareRight("==", intVal(I1))
    93	           => boolVal(I1 ==Int I2) ... </k>
    94	  rule <k> typeVal(T2) ~> compareRight("==", typeVal(T1))
    95	           => boolVal(T1 ==String T2) ... </k>
    96	
    97	  // Python's and/or are evaluated left-to-right and short circuit.  The
    98	  // continuation rules skip, rather than evaluate, remaining operands once
    99	  // their result is determined.
   100	  rule <k> eval(BoolOp("and", E1, E2, E3))
   101	           => eval(E1) ~> andThen(E2) ~> andThen(E3) ... </k>
   102	  rule <k> eval(BoolOp("and", E1, E2, E3, E4))
   103	           => eval(E1) ~> andThen(E2) ~> andThen(E3) ~> andThen(E4) ... </k>
   104	  rule <k> boolVal(true) ~> andThen(E) => eval(E) ... </k>
   105	  rule <k> boolVal(false) ~> andThen(_E) => boolVal(false) ... </k>
   106	
   107	  rule <k> eval(BoolOp("or", E1, E2, E3))
   108	           => eval(E1) ~> orThen(E2) ~> orThen(E3) ... </k>
   109	  rule <k> boolVal(false) ~> orThen(E) => eval(E) ... </k>
   110	  rule <k> boolVal(true) ~> orThen(_E) => boolVal(true) ... </k>
