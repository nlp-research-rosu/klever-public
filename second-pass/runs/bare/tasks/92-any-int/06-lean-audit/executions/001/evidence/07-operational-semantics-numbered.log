    39	module MPY-SEMANTICS
    40	  imports MPY-SYNTAX
    41	
    42	  configuration
    43	    <mpy>
    44	      <k> $PGM:K </k>
    45	      <env> .Map </env>
    46	    </mpy>
    47	
    48	  syntax KItem ::= "exec" "(" Stmts ")"
    49	                 | "eval" "(" Expr ")"
    50	                 | "finishCall"
    51	                 | "typeOf"
    52	                 | "binLeft" "(" String "," Expr ")"
    53	                 | "binRight" "(" String "," Val ")"
    54	                 | "compareLeft" "(" String "," Expr ")"
    55	                 | "compareRight" "(" String "," Val ")"
    56	                 | "andThen" "(" Expr ")"
    57	                 | "orThen" "(" Expr ")"
