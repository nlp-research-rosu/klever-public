COMMAND: nl -ba /tmp/audit-work/92-any-int/src/verification.k
     1	requires "semantic.k"
     2	
     3	module ANY-INT-VERIFICATION
     4	  imports MPY-SEMANTICS
     5	
     6	  // This macro is the exact constructor tree in solution.mpy.  Keeping the
     7	  // program separate from the semantics prevents the operational rules from
     8	  // baking in the answer to the task.
     9	  syntax Program ::= "solutionProgram" [macro]
    10	  rule solutionProgram =>
    11	    Module(
    12	      FuncDef("any_int", Params("x", "y", "z"),
    13	        Return(
    14	          BoolOp(
    15	            "and",
    16	            Compare(Call(Name("type"), Name("x")), CmpOp("==", Name("int"))),
    17	            Compare(Call(Name("type"), Name("y")), CmpOp("==", Name("int"))),
    18	            Compare(Call(Name("type"), Name("z")), CmpOp("==", Name("int"))),
    19	            BoolOp(
    20	              "or",
    21	              Compare(BinOp("+", Name("x"), Name("y")), CmpOp("==", Name("z"))),
    22	              Compare(BinOp("+", Name("x"), Name("z")), CmpOp("==", Name("y"))),
    23	              Compare(BinOp("+", Name("y"), Name("z")), CmpOp("==", Name("x"))))))))
    24	
    25	  syntax KItem ::= "RunAnyInt" "(" Val "," Val "," Val ")" [macro]
    26	  rule RunAnyInt(X, Y, Z) => Invoke(solutionProgram, X, Y, Z)
    27	endmodule
EXIT_STATUS: 0

COMMAND: nl -ba /tmp/audit-work/92-any-int/src/spec.k
     1	requires "verification.k"
     2	
     3	module ANY-INT-SPEC
     4	  imports ANY-INT-VERIFICATION
     5	
     6	  // Together these four claims partition all integer triples according to
     7	  // the first true sum equality.  Thus they prove the complete positive and
     8	  // negative behavior on Python integers, not just concrete examples.
     9	  claim <k> RunAnyInt(intVal(X), intVal(Y), intVal(Z))
    10	             => boolVal(true) </k>
    11	        <env> .Map </env>
    12	    requires X +Int Y ==Int Z
    13	
    14	  claim <k> RunAnyInt(intVal(X), intVal(Y), intVal(Z))
    15	             => boolVal(true) </k>
    16	        <env> .Map </env>
    17	    requires notBool (X +Int Y ==Int Z)
    18	     andBool X +Int Z ==Int Y
    19	
    20	  claim <k> RunAnyInt(intVal(X), intVal(Y), intVal(Z))
    21	             => boolVal(true) </k>
    22	        <env> .Map </env>
    23	    requires notBool (X +Int Y ==Int Z)
    24	     andBool notBool (X +Int Z ==Int Y)
    25	     andBool Y +Int Z ==Int X
    26	
    27	  claim <k> RunAnyInt(intVal(X), intVal(Y), intVal(Z))
    28	             => boolVal(false) </k>
    29	        <env> .Map </env>
    30	    requires notBool (X +Int Y ==Int Z)
    31	     andBool notBool (X +Int Z ==Int Y)
    32	     andBool notBool (Y +Int Z ==Int X)
    33	
    34	  // These claims partition every call containing a non-integer according to
    35	  // the position of its first non-integer argument.  Later arguments remain
    36	  // fully symbolic because short-circuiting prevents their arithmetic use.
    37	  claim <k> RunAnyInt(_N:NonIntVal, _Y:Val, _Z:Val)
    38	             => boolVal(false) </k>
    39	        <env> .Map </env>
    40	
    41	  claim <k> RunAnyInt(_X:IntVal, _N:NonIntVal, _Z:Val)
    42	             => boolVal(false) </k>
    43	        <env> .Map </env>
    44	
    45	  claim <k> RunAnyInt(_X:IntVal, _Y:IntVal, _N:NonIntVal)
    46	             => boolVal(false) </k>
    47	        <env> .Map </env>
    48	endmodule
EXIT_STATUS: 0

