+run bash -c 'if rg -n "\\[(function|total|functional|simplification|concrete|priority|anywhere|owise)" "$1" "$2" "$3"; then exit 1; else echo "NO_LOCAL_FUNCTION_TOTAL_FUNCTIONAL_SIMPLIFICATION_PRIORITY_OR_OPAQUE_ATTRIBUTES"; fi' _ "$src/semantic.k" "$src/verification.k" "$src/spec.k"

