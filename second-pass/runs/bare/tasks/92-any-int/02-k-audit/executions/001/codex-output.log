-2.2), intVal(2))' false\n\n# Prove all seven exhaustive symbolic claims in spec.k.  Success prints #Top.\nkprove spec.k \\\n  -d verification-kompiled \\\n  --spec-module ANY-INT-SPEC\n"},"/work/spec.k":{"type":"update","unified_diff":"@@ -36,3 +36,3 @@\n   // fully symbolic because short-circuiting prevents their arithmetic use.\n-  claim <k> RunAnyInt(N:NonIntVal, Y:Val, Z:Val)\n+  claim <k> RunAnyInt(_N:NonIntVal, _Y:Val, _Z:Val)\n              => boolVal(false) </k>\n@@ -40,3 +40,3 @@\n \n-  claim <k> RunAnyInt(X:IntVal, N:NonIntVal, Z:Val)\n+  claim <k> RunAnyInt(_X:IntVal, _N:NonIntVal, _Z:Val)\n              => boolVal(false) </k>\n@@ -44,3 +44,3 @@\n \n-  claim <k> RunAnyInt(X:IntVal, Y:IntVal, N:NonIntVal)\n+  claim <k> RunAnyInt(_X:IntVal, _Y:IntVal, _N:NonIntVal)\n              => boolVal(false) </k>\n","move_path":null}},"status":"completed"}}
