from pathlib import Path
import hashlib,itertools,os
roots=[Path('/candidate'),Path('/generation-evidence/codex-trace')]
expected=['44cc347615aae218e96044f77f0b5385261fc24d2db670ee1f44e2f99bf2d562','fb566d8d928891a87f4ce77e0dc4f3b14c3ea48e304a0c30cdb9b7bbdfbd555e']
