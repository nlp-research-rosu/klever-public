 entrysets.append(es)
seps=[b'',b'\\0',b'\\n',b':',b' ']
paths=['rel','dotrel','base_rel','abs']
markers=['none','short','long']
payloads=['content','rawhash','hexhash','size_content','size_rawhash','size_hexhash','none']
include_dirs=[False,True]
