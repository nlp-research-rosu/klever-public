diff --git a/evidence/k/audit-spec-7.k b/evidence/k/audit-spec-7.k
new file mode 100644
index 0000000000000000000000000000000000000000..ac21f4b4a8bce45618ce5035193e9ae3ceda577c
--- /dev/null
+++ b/evidence/k/audit-spec-7.k
@@ -0,0 +1,9 @@
