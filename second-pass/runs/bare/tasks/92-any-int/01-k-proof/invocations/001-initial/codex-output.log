+             => boolVal(false) </k>
+        <env> .Map </env>
+
+  claim <k> RunAnyInt(X:IntVal, Y:IntVal, N:NonIntVal)
+             => boolVal(false) </k>
+        <env> .Map </env>
+endmodule
