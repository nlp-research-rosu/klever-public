+  imports SEMANTIC
+
+  claim [parity-idiom-connection]:
+    <exchange>
+      <k>
+        exec(
+          If(Compare(BinOp("%", Name(X), Int(2)), CmpOp("==", Int(0))),
+             Assign(Name(Y), BinOp("+", Name(Y), Int(1))),
+             .Stmts)
+          REST)
+        ~> CONT
+      =>
+        exec(REST) ~> CONT
+      </k>
+      <env>
+        X |-> I
+        Y |-> N
+        RHO
+      =>
+        (X |-> I
+         Y |-> N
+         RHO) [ Y <- N +Int evenBit(I) ]
+      </env>
+      <result> RES </result>
+    </exchange>
+endmodule
