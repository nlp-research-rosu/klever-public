+            )
+
+    print("PROVENANCE_CHECK_COMPLETE")
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        raise SystemExit(main())
+    except Exception as error:
+        print(f"PROVENANCE_CHECK_FAILED {type(error).__name__}: {error}", file=sys.stderr)
