     6	def exchange(lst1, lst2):
     7	    """In this problem, you will implement a function that takes two lists of numbers,
     8	    and determines whether it is possible to perform an exchange of elements
     9	    between them to make lst1 a list of only even numbers.
    10	    There is no limit on the number of exchanged elements between lst1 and lst2.
    11	    If it is possible to exchange elements between the lst1 and lst2 to make
    12	    all the elements of lst1 to be even, return "YES".
    13	    Otherwise, return "NO".
    14	    For example:
    15	    exchange([1, 2, 3, 4], [1, 2, 3, 4]) => "YES"
    16	    exchange([1, 2, 3, 4], [1, 5, 3, 4]) => "NO"
    17	    It is assumed that the input lists will be non-empty.
    18	    """
    19	    odd = 0
    20	    even = 0
    21	    for i in lst1:
    22	        if i%2 == 1:
    23	            odd += 1
    24	    for i in lst2:
    25	        if i%2 == 0:
    26	            even += 1
    27	    if even >= odd:
    28	        return "YES"
    29	    return "NO"
