diff --git a//tmp/audit-work/110-exchange/bridge-free/bridge-connection.k b//tmp/audit-work/110-exchange/bridge-free/bridge-connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..edab1396c3ff9f1bb61f287f19796b3be22a838f
--- /dev/null
+++ b//tmp/audit-work/110-exchange/bridge-free/bridge-connection.k
@@ -0,0 +1,29 @@
+requires "semantic.k"
+
+module BRIDGE-CONNECTION
+  imports SEMANTIC
+
+  claim [parity-idiom-connection]:
+    <exchange>
+      <k>
+        exec(
+          If(Compare(BinOp("%", Name(X), Int(2)), CmpOp("==", Int(0))),
+             Assign(Name(Y), BinOp("+", Name(Y), Int(1))),
+             .Stmts)
+          REST)
+        ~> CONT
+      =>
+        exec(REST) ~> CONT
+      </k>
+      <env>
+        X |-> I
+        Y |-> N
+        RHO
+      =>
+        (X |-> I
+         Y |-> N
+         RHO) [ Y <- N +Int evenBit(I) ]
+      </env>
+      <result> RES </result>
+    </exchange>
+endmodule
