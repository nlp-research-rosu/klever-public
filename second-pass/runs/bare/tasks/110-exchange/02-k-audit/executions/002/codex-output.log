diff --git a//tmp/audit-work/110-exchange/bridge-free/bridge-connection.k b//tmp/audit-work/110-exchange/bridge-free/bridge-connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..96a5b4104e833b6367042db7d313e4bee6d93388
--- /dev/null
+++ b//tmp/audit-work/110-exchange/bridge-free/bridge-connection.k
@@ -0,0 +1,31 @@
+requires "semantic.k"
+
+module BRIDGE-CONNECTION
+  imports SEMANTIC
+
+  claim [parity-idiom-connection]:
+    <exchange>
+      <k>
+        exec(
+          If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
+             Assign(Name("even"), BinOp("+", Name("even"), Int(1))),
+             .Stmts)
+          REST)
+        ~> CONT
+      =>
+        exec(REST) ~> CONT
+      </k>
+      <env>
+        "lst1" |-> L1
+        "lst2" |-> L2
+        "even" |-> N
+        "value" |-> I
+      =>
+        "lst1" |-> L1
+        "lst2" |-> L2
+        "even" |-> (N +Int evenBit(I))
+        "value" |-> I
+      </env>
+      <result> RES </result>
+    </exchange>
+endmodule
