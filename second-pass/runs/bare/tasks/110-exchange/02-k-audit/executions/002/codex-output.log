@@ -0,0 +1,29 @@
+requires "semantic.k"
+
+module BRIDGE-CONNECTION
+  imports SEMANTIC
+
+  claim [parity-idiom-connection]:
+    <exchange>
+      <k>
+        exec(
+          If(Compare(BinOp("%", Name(X), Int(2)), CmpOp("==", Int(0))),
+             Assign(Name(Y), BinOp("+", Name(Y), Int(1))),
+             .Stmts)
+          REST)
+        ~> CONT
+      =>
+        exec(REST) ~> CONT
+      </k>
+      <env>
+        X |-> I
+        Y |-> N
+        RHO
+      =>
+        X |-> I
+        Y |-> (N +Int evenBit(I))
+        RHO
+      </env>
+      <result> RES </result>
+    </exchange>
+endmodule
