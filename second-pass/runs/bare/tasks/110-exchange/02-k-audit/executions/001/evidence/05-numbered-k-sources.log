===== verification.k =====
     1	module VERIFICATION
     2	  imports MPY-SYNTAX
     3	  imports INT
     4	  imports BOOL
     5	
     6	  syntax Stmts ::= "countBody" [macro]
     7	  rule countBody =>
     8	    If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
     9	       Assign(Name("even"), BinOp("+", Name("even"), Int(1))),
    10	       .Stmts)
    11	
    12	  syntax Stmt ::= "solutionProgram" [macro]
    13	  rule solutionProgram =>
    14	    Module(
    15	      FuncDef("exchange", Params("lst1", "lst2"),
    16	        Assign(Name("even"), Int(0))
    17	        For(Name("value"), Name("lst1"), countBody)
    18	        For(Name("value"), Name("lst2"), countBody)
    19	        If(Compare(Name("even"), CmpOp(">=", Call(Name("len"), Name("lst1")))),
    20	           Return(Str("YES")),
    21	           .Stmts)
    22	        Return(Str("NO"))))
    23	
    24	  syntax Int ::= evenBit(Int) [function, total]
    25	  rule evenBit(I) => 1 requires I %Int 2 ==Int 0
    26	  rule evenBit(I) => 0 requires notBool (I %Int 2 ==Int 0)
    27	
    28	  syntax Int ::= countEven(PyList) [function, total]
    29	  rule countEven(Nil) => 0
    30	  rule countEven(Cons(I, REST)) => evenBit(I) +Int countEven(REST)
    31	
    32	  syntax Int ::= lastValue(PyList, Int) [function, total]
    33	  rule lastValue(Nil, DEFAULT) => DEFAULT
    34	  rule lastValue(Cons(I, REST), _) => lastValue(REST, I)
    35	endmodule
===== spec.k =====
     1	requires "semantic.k"
     2	
     3	module SPEC
     4	  imports SEMANTIC
     5	
     6	  claim [loop-counts-even]:
     7	    <exchange>
     8	      <k> loop("value", L, countBody) ~> CONT => CONT </k>
     9	      <env>
    10	        "lst1" |-> L1
    11	        "lst2" |-> L2
    12	        "even" |-> N
    13	        "value" |-> OLD
    14	      =>
    15	        "lst1" |-> L1
    16	        "lst2" |-> L2
    17	        "even" |-> (N +Int countEven(L))
    18	        "value" |-> lastValue(L, OLD)
    19	      </env>
    20	      <result> noResult </result>
    21	    </exchange>
    22	
    23	  claim [exchange-yes]:
    24	    <exchange>
    25	      <k> init(solutionProgram, L1, L2) => .K </k>
    26	      <env> .Map
    27	      =>
    28	        "lst1" |-> L1
    29	        "lst2" |-> L2
    30	        "even" |-> (countEven(L1) +Int countEven(L2))
    31	        "value" |-> lastValue(L2, lastValue(L1, 0))
    32	      </env>
    33	      <result> noResult => "YES" </result>
    34	    </exchange>
    35	    requires countEven(L1) +Int countEven(L2) >=Int length(L1)
    36	
    37	  claim [exchange-no]:
    38	    <exchange>
    39	      <k> init(solutionProgram, L1, L2) => .K </k>
    40	      <env> .Map
    41	      =>
    42	        "lst1" |-> L1
    43	        "lst2" |-> L2
    44	        "even" |-> (countEven(L1) +Int countEven(L2))
    45	        "value" |-> lastValue(L2, lastValue(L1, 0))
    46	      </env>
    47	      <result> noResult => "NO" </result>
    48	    </exchange>
    49	    requires countEven(L1) +Int countEven(L2) <Int length(L1)
    50	endmodule

