+The configuration contains only `<k>`, `<env>`, and `<result>`, exactly the
+control, local state, and observable return result needed by this program.
+There is no heap, allocation, I/O, exception state, or external call other than
+the exact modeled `len`.
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..1b664fb15a9dfa12bb17f4e9484ee58bd6c427f2
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+mkdir -p "$(dirname "$log_path")"
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf '%s\n' '--- OUTPUT ---'
+} >"$log_path"
+
+set +e
+"$@" >>"$log_path" 2>&1
+command_status=$?
+set -e
+
+{
+  printf '%s\n' '--- END OUTPUT ---'
+  printf 'EXIT_STATUS: %d\n' "$command_status"
+} >>"$log_path"
+
+cat "$log_path"
+exit "$command_status"

