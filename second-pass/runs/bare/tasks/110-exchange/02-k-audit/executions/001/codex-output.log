diff --git a//tmp/audit-work/110-exchange/solution-body-mutated.py b//tmp/audit-work/110-exchange/solution-body-mutated.py
new file mode 100644
index 0000000000000000000000000000000000000000..f562ccc033b45e7ceefa1607ce063ca48b5e9cc7
--- /dev/null
+++ b//tmp/audit-work/110-exchange/solution-body-mutated.py
@@ -0,0 +1,11 @@
+def exchange(lst1, lst2):
+    even = 0
+    for value in lst1:
+        if value % 2 == 0:
+            even = even + 1
+    for value in lst2:
+        if value % 2 == 0:
+            even = even + 2
+    if even >= len(lst1):
+        return "YES"
+    return "NO"
