+        ~> CONT
+        =>
+        exec(REST) ~> CONT
+      </k>
+      <env>
+        "lst1" |-> L1
+        "lst2" |-> L2
+        "even" |-> (N:Int => N +Int 1)
+        "value" |-> I:Int
+      </env>
