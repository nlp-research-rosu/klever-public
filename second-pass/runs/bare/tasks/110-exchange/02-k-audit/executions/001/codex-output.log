--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+mkdir -p "$(dirname "$log_path")"
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf '%s\n' '--- OUTPUT ---'
+} >"$log_path"
+
+set +e
+"$@" >>"$log_path" 2>&1
+command_status=$?
+set -e
+
+{
+  printf '%s\n' '--- END OUTPUT ---'
+  printf 'EXIT_STATUS: %d\n' "$command_status"
+} >>"$log_path"
+
+cat "$log_path"
+exit "$command_status"

The exhaustive declaration/rule inventory is complete. No false semantic or proof equation was found. The only operational bridge was checked by removing it, reproving the suite, and proving its two exhaustive branches in the exact reachable context. The fresh wrong-result mutation parses/builds and fails at the expected residual `result = "YES"` versus required `"NO"`.
