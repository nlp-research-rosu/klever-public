+             .Stmts)
+          REST)
+        ~> CONT
+        =>
+        exec(REST) ~> CONT
+      </k>
+      <env>
+        "lst1" |-> L1
+        "lst2" |-> L2
+        "even" |-> N:Int
+        "value" |-> I:Int
+      </env>
+      <result> noResult </result>
