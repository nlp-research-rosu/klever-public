{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 10,
      "module": "VERIFICATION",
      "normalized_sha256": "3b0524b72be44f90dc539594c9435311735b97ca12e5744522207847efdf958f",
      "rationale": "This macro equation expands the named countBody proof term into the translated parity-counting statement body.",
      "source_rule_id": "rule-3b0524b72be44f90dc539594c9435311735b97ca12e5744522207847efdf958f",
      "start_line": 7,
      "text": "  rule countBody =>\n    If(Compare(BinOp(\"%\", Name(\"value\"), Int(2)), CmpOp(\"==\", Int(0))),\n       Assign(Name(\"even\"), BinOp(\"+\", Name(\"even\"), Int(1))),\n       .Stmts)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 22,
      "module": "VERIFICATION",
      "normalized_sha256": "79fb603017208f0260ce768393ce9fb05571d41100b73e0f56c39f20617e2d39",
      "rationale": "This macro equation defines solutionProgram as the concrete translated AST used by the proof and AST-equivalence check.",
      "source_rule_id": "rule-79fb603017208f0260ce768393ce9fb05571d41100b73e0f56c39f20617e2d39",
      "start_line": 13,
      "text": "  rule solutionProgram =>\n    Module(\n      FuncDef(\"exchange\", Params(\"lst1\", \"lst2\"),\n        Assign(Name(\"even\"), Int(0))\n        For(Name(\"value\"), Name(\"lst1\"), countBody)\n        For(Name(\"value\"), Name(\"lst2\"), countBody)\n        If(Compare(Name(\"even\"), CmpOp(\">=\", Call(Name(\"len\"), Name(\"lst1\")))),\n           Return(Str(\"YES\")),\n           .Stmts)\n        Return(Str(\"NO\"))))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "VERIFICATION",
      "normalized_sha256": "88be6889f69f1872079523b2d7e52712728c0ade8da99f5cc8f1e208b15839ec",
      "rationale": "This is the even case of the conditional definition of the mathematical parity indicator evenBit.",
      "source_rule_id": "rule-88be6889f69f1872079523b2d7e52712728c0ade8da99f5cc8f1e208b15839ec",
      "start_line": 25,
      "text": "  rule evenBit(I) => 1 requires I %Int 2 ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 26,
      "module": "VERIFICATION",
      "normalized_sha256": "f261b5e7098649f4ee737cabca0e23ef363204ae35e929ff0aaeb927267eca1c",
      "rationale": "This is the complementary non-even case of the conditional definition of the mathematical parity indicator evenBit.",
      "source_rule_id": "rule-f261b5e7098649f4ee737cabca0e23ef363204ae35e929ff0aaeb927267eca1c",
      "start_line": 26,
      "text": "  rule evenBit(I) => 0 requires notBool (I %Int 2 ==Int 0)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 29,
      "module": "VERIFICATION",
      "normalized_sha256": "0abfea958f5b272978425c2d6ebeb66d7f853b51b1cc98320b4d4f836eda2528",
      "rationale": "This equation defines the base case of the recursive countEven list summary.",
      "source_rule_id": "rule-0abfea958f5b272978425c2d6ebeb66d7f853b51b1cc98320b4d4f836eda2528",
      "start_line": 29,
      "text": "  rule countEven(Nil) => 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 30,
      "module": "VERIFICATION",
      "normalized_sha256": "e9f96e50aa51213c566f0e36b583257fd92bc4fb5a6a9ed4b83888d78d6b159f",
      "rationale": "This equation defines the recursive case of countEven by adding the head's parity indicator to the tail summary.",
      "source_rule_id": "rule-e9f96e50aa51213c566f0e36b583257fd92bc4fb5a6a9ed4b83888d78d6b159f",
      "start_line": 30,
      "text": "  rule countEven(Cons(I, REST)) => evenBit(I) +Int countEven(REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 33,
      "module": "VERIFICATION",
      "normalized_sha256": "9b6c79e06a9018ca7b7a00e5e7de15c49eaa68710bdd4a950b891b2ee4e61050",
      "rationale": "This equation defines the empty-list base case of the structural lastValue helper used to summarize the loop variable.",
      "source_rule_id": "rule-9b6c79e06a9018ca7b7a00e5e7de15c49eaa68710bdd4a950b891b2ee4e61050",
      "start_line": 33,
      "text": "  rule lastValue(Nil, DEFAULT) => DEFAULT"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 34,
      "module": "VERIFICATION",
      "normalized_sha256": "00c9d163d151e306625b62553c8a82464be399ff77abca913944795d51bc75af",
      "rationale": "This equation defines the recursive lastValue helper by carrying the current head as the next default.",
      "source_rule_id": "rule-00c9d163d151e306625b62553c8a82464be399ff77abca913944795d51bc75af",
      "start_line": 34,
      "text": "  rule lastValue(Cons(I, REST), _) => lastValue(REST, I)"
    }
  ],
