assert len({r['source_rule_id'] for r in out['rules']}) == len(inv['rules'])
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
for entry in out['rules']:
    assert list(entry) == ['source_rule_id', 'classification', 'rationale']
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
for source, entry in zip(inv['rules'], out['rules']):
    if 'simplification' in source['attributes']:
        assert entry['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
print(f\"validated {len(out['rules'])} rules; inventory hash {out['inventory_sha256']}\")
print('classification counts:')
from collections import Counter
for key, value in sorted(Counter(r['classification'] for r in out['rules']).items()):
    print(f'  {key}: {value}')
