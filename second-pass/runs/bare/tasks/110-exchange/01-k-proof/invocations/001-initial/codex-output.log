+  --output pretty --smt-timeout 5000
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..66804ee2a15ca19a770e20d6ff41416d05a49f11
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,140 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+  imports BOOL-SYNTAX
+
+  syntax Ids ::= List{String, ","}
+  syntax Params ::= "Params" "(" Ids ")" [symbol(Params)]
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol(CmpOp)]
+  syntax CmpOps ::= List{CmpOp, ","}
+
+  syntax Expr ::= "Int" "(" Int ")" [symbol(IntExpr)]
+                | "Str" "(" String ")" [symbol(StrExpr)]
+                | "Name" "(" String ")" [symbol(Name)]
+                | "BinOp" "(" String "," Expr "," Expr ")" [symbol(BinOp)]
+                | "Compare" "(" Expr "," CmpOps ")" [symbol(Compare)]
+                | "Call" "(" Expr "," Exprs ")" [symbol(Call)]
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "Module" "(" Stmts ")" [symbol(Module)]
+                | "FuncDef" "(" String "," Params "," Stmts ")" [symbol(FuncDef)]
+                | "Assign" "(" Expr "," Expr ")" [symbol(Assign)]
+                | "If" "(" Expr "," Stmts "," Stmts ")" [symbol(If)]
+                | "For" "(" Expr "," Expr "," Stmts ")" [symbol(For)]
+                | "Return" "(" Expr ")" [symbol(Return)]
+
+  syntax PyList ::= "Nil" [symbol(Nil)]
+                  | "Cons" "(" Int "," PyList ")" [symbol(Cons)]
+  syntax Val ::= Int | String | Bool | PyList
+  syntax Result ::= "noResult" [symbol(noResult)] | Val
+endmodule
+
+module SEMANTIC
+  imports VERIFICATION
+  imports INT
+  imports STRING
+  imports BOOL
+  imports MAP
+
+  syntax KItem ::= "init" "(" Stmt "," PyList "," PyList ")" [symbol(init)]
+                 | "exec" "(" Stmts ")" [symbol(exec)]
+                 | "eval" "(" Expr ")" [symbol(eval)]
+                 | "write" "(" String ")" [symbol(write)]
+                 | "binRight" "(" String "," Expr ")" [symbol(binRight)]
+                 | "applyBin" "(" String "," Val ")" [symbol(applyBin)]
+                 | "cmpRight" "(" String "," Expr ")" [symbol(cmpRight)]
+                 | "applyCmp" "(" String "," Val ")" [symbol(applyCmp)]
+                 | "doLen" [symbol(doLen)]
+                 | "branch" "(" Stmts "," Stmts ")" [symbol(branch)]
+                 | "startFor" "(" String "," Stmts ")" [symbol(startFor)]
+                 | "loop" "(" String "," PyList "," Stmts ")" [symbol(loop)]
+                 | "finish" [symbol(finish)]
+
+  syntax Int ::= length(PyList) [function, total]
+  rule length(Nil) => 0
+  rule length(Cons(_, REST)) => 1 +Int length(REST)
+
+  configuration
+    <exchange>
+      <k> init($PGM:Stmt, $LST1:PyList, $LST2:PyList) </k>
+      <env> .Map </env>
+      <result> noResult </result>
+    </exchange>
+
+  rule <k> init(Module(FuncDef("exchange", Params("lst1", "lst2"), BODY)), L1, L2)
+        => exec(BODY) ... </k>
+       <env> .Map
+        => "lst1" |-> L1
+           "lst2" |-> L2
+           "even" |-> 0
+           "value" |-> 0
+       </env>
+
+  rule <k> exec(.Stmts) => .K ... </k>
+  rule <k> exec(Assign(Name(X), E) REST)
+        => eval(E) ~> write(X) ~> exec(REST) ... </k>
+  rule <k> V:Val ~> write(X) => .K ... </k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule <k> exec(If(E, THEN, ELSE) REST)
+        => eval(E) ~> branch(THEN, ELSE) ~> exec(REST) ... </k>
+  rule <k> true  ~> branch(THEN, _) => exec(THEN) ... </k>
+  rule <k> false ~> branch(_, ELSE) => exec(ELSE) ... </k>
+
+  // A pure-statement rule for the translated parity-counting idiom.  It is
+  // equivalent to the general If/evaluation rules below, while keeping the
+  // symbolic loop invariant independent of a solver case split.
+  rule <k> exec(
+          If(Compare(BinOp("%", Name(X), Int(2)), CmpOp("==", Int(0))),
+             Assign(Name(Y), BinOp("+", Name(Y), Int(1))),
+             .Stmts)
+          REST)
+        => exec(REST) ... </k>
+       <env> ... X |-> I:Int
+                 Y |-> (N:Int => N +Int evenBit(I)) ... </env>
+       [priority(40)]
+
+  rule <k> exec(For(Name(X), E, BODY) REST)
+        => eval(E) ~> startFor(X, BODY) ~> exec(REST) ... </k>
+  rule <k> L:PyList ~> startFor(X, BODY)
+        => loop(X, L, BODY) ... </k>
+  rule <k> loop(_, Nil, _) => .K ... </k>
+  rule <k> loop(X, Cons(I, REST), BODY)
+        => I ~> write(X) ~> exec(BODY) ~> loop(X, REST, BODY) ... </k>
+
+  rule <k> exec(Return(E) _REST)
+        => eval(E) ~> finish ... </k>
+  rule <k> V:Val ~> finish ~> _REST:K => .K </k>
+       <result> noResult => V </result>
+
+  rule <k> eval(Int(I)) => I ... </k>
+  rule <k> eval(Str(S)) => S ... </k>
+  rule <k> eval(Name(X)) => V ... </k>
+       <env> ... X |-> V ... </env>
+
+  rule <k> eval(BinOp(OP, LEFT, RIGHT))
+        => eval(LEFT) ~> binRight(OP, RIGHT) ... </k>
+  rule <k> LEFT:Val ~> binRight(OP, RIGHT)
+        => eval(RIGHT) ~> applyBin(OP, LEFT) ... </k>
+  rule <k> RIGHT:Int ~> applyBin("+", LEFT:Int)
+        => LEFT +Int RIGHT ... </k>
+  rule <k> RIGHT:Int ~> applyBin("%", LEFT:Int)
+        => LEFT %Int RIGHT ... </k>
+
+  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT)))
+        => eval(LEFT) ~> cmpRight(OP, RIGHT) ... </k>
+  rule <k> LEFT:Val ~> cmpRight(OP, RIGHT)
+        => eval(RIGHT) ~> applyCmp(OP, LEFT) ... </k>
+  rule <k> RIGHT:Int ~> applyCmp("==", LEFT:Int)
+        => LEFT ==Int RIGHT ... </k>
+  rule <k> RIGHT:Int ~> applyCmp(">=", LEFT:Int)
+        => LEFT >=Int RIGHT ... </k>
+
+  rule <k> eval(Call(Name("len"), ARG))
+        => eval(ARG) ~> doLen ... </k>
+  rule <k> L:PyList ~> doLen => length(L) ... </k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..d97c9640fbfad2e6e1e662404211965d76ec46bd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def exchange(lst1, lst2):
+    even = 0
+    for value in lst1:
+        if value % 2 == 0:
+            even = even + 1
+    for value in lst2:
+        if value % 2 == 0:
+            even = even + 1
+    if even >= len(lst1):
+        return "YES"
+    return "NO"
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..4258749114099302a7ca8afae662ea1c920197a5
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,50 @@
+requires "semantic.k"
+
+module SPEC
+  imports SEMANTIC
+
+  claim [loop-counts-even]:
+    <exchange>
+      <k> loop("value", L, countBody) ~> CONT => CONT </k>
+      <env>
+        "lst1" |-> L1
+        "lst2" |-> L2
+        "even" |-> N
+        "value" |-> OLD
+      =>
+        "lst1" |-> L1
+        "lst2" |-> L2
+        "even" |-> (N +Int countEven(L))
+        "value" |-> lastValue(L, OLD)
+      </env>
+      <result> noResult </result>
+    </exchange>
+
+  claim [exchange-yes]:
+    <exchange>
+      <k> init(solutionProgram, L1, L2) => .K </k>
+      <env> .Map
+      =>
+        "lst1" |-> L1
+        "lst2" |-> L2
+        "even" |-> (countEven(L1) +Int countEven(L2))
+        "value" |-> lastValue(L2, lastValue(L1, 0))
+      </env>
+      <result> noResult => "YES" </result>
+    </exchange>
+    requires countEven(L1) +Int countEven(L2) >=Int length(L1)
+
+  claim [exchange-no]:
+    <exchange>
+      <k> init(solutionProgram, L1, L2) => .K </k>
+      <env> .Map
+      =>
+        "lst1" |-> L1
+        "lst2" |-> L2
+        "even" |-> (countEven(L1) +Int countEven(L2))
+        "value" |-> lastValue(L2, lastValue(L1, 0))
+      </env>
+      <result> noResult => "NO" </result>
+    </exchange>
+    requires countEven(L1) +Int countEven(L2) <Int length(L1)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..22969799ed00b201114b622302af8017e14be1ad
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,35 @@
+module VERIFICATION
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+
+  syntax Stmts ::= "countBody" [macro]
+  rule countBody =>
+    If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
+       Assign(Name("even"), BinOp("+", Name("even"), Int(1))),
+       .Stmts)
+
+  syntax Stmt ::= "solutionProgram" [macro]
+  rule solutionProgram =>
+    Module(
+      FuncDef("exchange", Params("lst1", "lst2"),
+        Assign(Name("even"), Int(0))
+        For(Name("value"), Name("lst1"), countBody)
+        For(Name("value"), Name("lst2"), countBody)
+        If(Compare(Name("even"), CmpOp(">=", Call(Name("len"), Name("lst1")))),
+           Return(Str("YES")),
+           .Stmts)
+        Return(Str("NO"))))
+
+  syntax Int ::= evenBit(Int) [function, total]
+  rule evenBit(I) => 1 requires I %Int 2 ==Int 0
+  rule evenBit(I) => 0 requires notBool (I %Int 2 ==Int 0)
+
+  syntax Int ::= countEven(PyList) [function, total]
+  rule countEven(Nil) => 0
+  rule countEven(Cons(I, REST)) => evenBit(I) +Int countEven(REST)
+
+  syntax Int ::= lastValue(PyList, Int) [function, total]
+  rule lastValue(Nil, DEFAULT) => DEFAULT
+  rule lastValue(Cons(I, REST), _) => lastValue(REST, I)
+endmodule

exec
/bin/bash -lc 'chmod +x prove.sh && ./prove.sh' in /work
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..f848cfeccbddf21233113fe1bc9d3056c871350f
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd -- "$(dirname -- "$0")"
+
+# Regenerate the submitted constructor term and compile the semantics.
+python3 py2mpy.py solution.py > solution.mpy
+kompile semantic.k --backend haskell \
+  --main-module SEMANTIC --syntax-module MPY-SYNTAX
+
+# Check that the concrete AST named in the proof is exactly solution.mpy.
+cmp \
+  <(kast solution.mpy -d semantic-kompiled -m MPY-SYNTAX \
+      --output kore --expand-macros) \
+  <(kast -d semantic-kompiled -m VERIFICATION -e 'solutionProgram' \
+      --output kore --expand-macros)
+
+# Exercise both examples from prompt.py through the K interpreter.
+krun solution.mpy -d semantic-kompiled \
+  -cLST1='Cons(1, Cons(2, Cons(3, Cons(4, Nil))))' \
+  -cLST2='Cons(1, Cons(2, Cons(3, Cons(4, Nil))))' \
+  --pattern '<result> "YES" </result>'
+krun solution.mpy -d semantic-kompiled \
+  -cLST1='Cons(1, Cons(2, Cons(3, Cons(4, Nil))))' \
+  -cLST2='Cons(1, Cons(5, Cons(3, Cons(4, Nil))))' \
+  --pattern '<result> "NO" </result>'
+
+# Prove the loop invariant and both exhaustive result claims.
+kprove spec.k -d semantic-kompiled --spec-module SPEC \
+  --output pretty --smt-timeout 5000
