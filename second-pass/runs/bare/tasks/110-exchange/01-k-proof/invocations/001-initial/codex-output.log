+def exchange(lst1, lst2):
+    even = 0
+    for value in lst1:
+        if value % 2 == 0:
+            even = even + 1
+    for value in lst2:
+        if value % 2 == 0:
+            even = even + 1
+    if even >= len(lst1):
+        return "YES"
+    return "NO"
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..dceade2cc25eebce3473c5f7e0b8f2a4cff44b8a
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-counts-even]:
+    <exchange>
+      <k> loop("value", L, countBody) ~> CONT => CONT </k>
+      <env>
+        "lst1" |-> L1
+        "lst2" |-> L2
+        "even" |-> N
+        "value" |-> OLD
+      =>
+        "lst1" |-> L1
+        "lst2" |-> L2
+        "even" |-> (N +Int countEven(L))
+        "value" |-> _FINAL
+      </env>
+      <result> noResult </result>
+    </exchange>
+
+  claim [exchange-yes]:
+    <exchange>
+      <k> init(solutionProgram, L1, L2) => .K </k>
+      <env> .Map
+      =>
+        "lst1" |-> L1
+        "lst2" |-> L2
+        "even" |-> (countEven(L1) +Int countEven(L2))
+        "value" |-> _FINAL
+      </env>
+      <result> noResult => "YES" </result>
+    </exchange>
+    requires countEven(L1) +Int countEven(L2) >=Int length(L1)
+
+  claim [exchange-no]:
+    <exchange>
+      <k> init(solutionProgram, L1, L2) => .K </k>
+      <env> .Map
+      =>
+        "lst1" |-> L1
+        "lst2" |-> L2
+        "even" |-> (countEven(L1) +Int countEven(L2))
+        "value" |-> _FINAL
+      </env>
+      <result> noResult => "NO" </result>
+    </exchange>
+    requires countEven(L1) +Int countEven(L2) <Int length(L1)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..253362cb5c5adc5d4363df488df634ccf010712a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,32 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  syntax Stmts ::= "countBody" [macro]
+  rule countBody =>
+    If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
+       Assign(Name("even"), BinOp("+", Name("even"), Int(1))),
+       .Stmts)
+    [macro]
+
+  syntax Stmt ::= "solutionProgram" [macro]
+  rule solutionProgram =>
+    Module(
+      FuncDef("exchange", Params("lst1", "lst2"),
+        Assign(Name("even"), Int(0))
+        For(Name("value"), Name("lst1"), countBody)
+        For(Name("value"), Name("lst2"), countBody)
+        If(Compare(Name("even"), CmpOp(">=", Call(Name("len"), Name("lst1")))),
+           Return(Str("YES")),
+           .Stmts)
+        Return(Str("NO"))))
+    [macro]
+
+  syntax Int ::= countEven(PyList) [function, total]
+  rule countEven(Nil) => 0
+  rule countEven(Cons(I, REST)) => 1 +Int countEven(REST)
+    requires I %Int 2 ==Int 0
+  rule countEven(Cons(I, REST)) => countEven(REST)
+    requires notBool (I %Int 2 ==Int 0)
+endmodule

exec
/bin/bash -lc 'kprove spec.k -d semantic-kompiled --spec-module SPEC --claims loop-counts-even --output pretty --smt-timeout 2000' in /work
