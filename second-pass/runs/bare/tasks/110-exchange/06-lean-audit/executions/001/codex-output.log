def recorded_run(command, *, cwd, timeout):
    print(\"RUN\", json.dumps(command), \"CWD\", str(cwd), \"TIMEOUT\", timeout, flush=True)
    try:
        p=subprocess.run(command, cwd=cwd, timeout=timeout, text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        print(\"EXIT\", p.returncode, flush=True)
        print(\"OUTPUT_BEGIN\", flush=True)
        print(p.stdout, end=\"\" if p.stdout.endswith(\"\\n\") or not p.stdout else \"\\n\", flush=True)
        print(\"OUTPUT_END\", flush=True)
        return p.returncode,p.stdout
    except subprocess.TimeoutExpired as e:
        out=e.stdout or \"\"
        if isinstance(out, bytes): out=out.decode(errors=\"replace\")
        print(\"EXIT 124\", flush=True)
        print(\"OUTPUT_BEGIN\", flush=True)
        print(out, end=\"\" if out.endswith(\"\\n\") or not out else \"\\n\", flush=True)
        print(f\"TIMEOUT after {timeout}s\", flush=True)
        print(\"OUTPUT_END\", flush=True)
        return 124, out+f\"TIMEOUT after {timeout}s\"

