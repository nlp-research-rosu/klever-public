def _rule_documents(
    text: str, modules: tuple[_Module, ...]
) -> list[dict[str, Any]]:
    spans = [span for module in modules for span in _rule_spans(text, module)]
    spans.sort(key=lambda span: span.start_offset)
    return [dataclasses.asdict(span.rule) for span in spans]


def _attribute_token_spans(
    text: str,
    masked_text: str,
) -> list[tuple[int, int, str]]:
    spans: list[tuple[int, int, str]] = []
    start = 0
    depth = 0
    for index, character in enumerate(masked_text):
        if character in "([{":
            depth += 1
        elif character in ")]}":
            depth = max(depth - 1, 0)
        elif character == "," and depth == 0:
            spans.append(
                (
                    start,
                    index,
                    _without_comments(text[start:index]).strip(),
                )
            )
            start = index + 1
    spans.append(
        (
            start,
            len(text),
            _without_comments(text[start:]).strip(),
        )
    )
    return spans


def _blank_non_newlines(text: str) -> str:
    return "".join(
        character if character in "\r\n" else " "
        for character in text
    )


def desimplify_rule_ids(
    text: str,
    source_rule_ids: list[str],
) -> str:
    """Remove simplification from exactly the selected canonical rule IDs."""

    if len(source_rule_ids) != len(set(source_rule_ids)):
        raise KRuleInventoryError(
            "exact rule transformation contains a duplicate source rule ID"
        )
    selected = set(source_rule_ids)
    modules = _modules(_mask_non_code(text))
    spans = [
        span
        for local_module in modules
        for span in _rule_spans(text, local_module)
    ]
    by_id = {span.rule.source_rule_id: span for span in spans}
    unknown = sorted(selected - set(by_id))
    if unknown:
        raise KRuleInventoryError(
            "exact rule transformation names an unknown source rule ID: "
            + ", ".join(unknown)
        )

    edits: list[tuple[int, int]] = []
    for source_rule_id in source_rule_ids:
        span = by_id[source_rule_id]
        if span.attribute_start is None or span.attribute_end is None:
            raise KRuleInventoryError(
                "selected source rule has no simplification attribute: "
                f"{source_rule_id}"
            )
        attribute_text = text[
            span.attribute_start + 1 : span.attribute_end - 1
        ]
        masked_attributes = _mask_non_code(attribute_text)
        tokens = _attribute_token_spans(
            attribute_text,
            masked_attributes,
        )
        matches = [
            index
            for index, (_start, _end, token) in enumerate(tokens)
            if token == "simplification"
        ]
        if len(matches) != 1:
            raise KRuleInventoryError(
                "selected source rule has ambiguous simplification "
                f"attributes: {source_rule_id}"
            )
        token_index = matches[0]
        if len(tokens) == 1:
            edit_start = span.attribute_start
            edit_end = span.attribute_end
        elif token_index < len(tokens) - 1:
            edit_start = (
                span.attribute_start + 1 + tokens[token_index][0]
            )
            edit_end = (
                span.attribute_start + 1 + tokens[token_index + 1][0]
            )
        else:
            edit_start = (
                span.attribute_start + 1 + tokens[token_index - 1][1]
            )
            edit_end = (
                span.attribute_start + 1 + tokens[token_index][1]
            )
        edits.append((edit_start, edit_end))

    transformed = text
    for start, end in sorted(edits, reverse=True):
        transformed = (
            transformed[:start]
            + _blank_non_newlines(transformed[start:end])
            + transformed[end:]
        )
    return transformed


def inventory_verification(workspace: Path) -> dict[str, Any]:
    workspace = Path(workspace)
    try:
        workspace_mode = workspace.stat(follow_symlinks=False).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        ) from error
    if not stat.S_ISDIR(workspace_mode):
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        )
    verification = workspace / "verification.k"
    try:
        verification_mode = verification.stat(
            follow_symlinks=False
        ).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        ) from error
    if not stat.S_ISREG(verification_mode):
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        )
    try:
        verification_bytes = verification.read_bytes()
        text = verification_bytes.decode()
    except (OSError, UnicodeError) as error:
        raise KRuleInventoryError(
            f"cannot read verification.k: {verification}"
        ) from error
    masked_text = _mask_non_code(text)
    modules = _modules(masked_text)
    module = _verification_module(
        modules, _last_verification_main_module(workspace)
    )
    closure = _verification_closure(modules, module)
    rule_documents = _rule_documents(text, closure)
    return {
        "schema_version": 2,
        "verification_file": "verification.k",
        "verification_sha256": hashlib.sha256(verification_bytes).hexdigest(),
        "verification_module": module.name,
        "verification_modules": [module.name for module in closure],
        "rules": rule_documents,
        "inventory_sha256": canonical_json_sha256(rule_documents),
    }
module VERIFICATION
  imports MPY-SYNTAX
  imports INT
  imports BOOL

  syntax Stmts ::= "countBody" [macro]
  rule countBody =>
    If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
       Assign(Name("even"), BinOp("+", Name("even"), Int(1))),
       .Stmts)

  syntax Stmt ::= "solutionProgram" [macro]
  rule solutionProgram =>
    Module(
      FuncDef("exchange", Params("lst1", "lst2"),
        Assign(Name("even"), Int(0))
        For(Name("value"), Name("lst1"), countBody)
        For(Name("value"), Name("lst2"), countBody)
        If(Compare(Name("even"), CmpOp(">=", Call(Name("len"), Name("lst1")))),
           Return(Str("YES")),
           .Stmts)
        Return(Str("NO"))))

  syntax Int ::= evenBit(Int) [function, total]
  rule evenBit(I) => 1 requires I %Int 2 ==Int 0
  rule evenBit(I) => 0 requires notBool (I %Int 2 ==Int 0)

  syntax Int ::= countEven(PyList) [function, total]
  rule countEven(Nil) => 0
  rule countEven(Cons(I, REST)) => evenBit(I) +Int countEven(REST)

  syntax Int ::= lastValue(PyList, Int) [function, total]
  rule lastValue(Nil, DEFAULT) => DEFAULT
  rule lastValue(Cons(I, REST), _) => lastValue(REST, I)
endmodule
requires "semantic.k"

module SPEC
  imports SEMANTIC

  claim [loop-counts-even]:
    <exchange>
      <k> loop("value", L, countBody) ~> CONT => CONT </k>
      <env>
        "lst1" |-> L1
        "lst2" |-> L2
        "even" |-> N
        "value" |-> OLD
      =>
        "lst1" |-> L1
        "lst2" |-> L2
        "even" |-> (N +Int countEven(L))
        "value" |-> lastValue(L, OLD)
      </env>
      <result> noResult </result>
    </exchange>

  claim [exchange-yes]:
    <exchange>
      <k> init(solutionProgram, L1, L2) => .K </k>
      <env> .Map
      =>
        "lst1" |-> L1
        "lst2" |-> L2
        "even" |-> (countEven(L1) +Int countEven(L2))
        "value" |-> lastValue(L2, lastValue(L1, 0))
      </env>
      <result> noResult => "YES" </result>
    </exchange>
    requires countEven(L1) +Int countEven(L2) >=Int length(L1)

  claim [exchange-no]:
    <exchange>
      <k> init(solutionProgram, L1, L2) => .K </k>
      <env> .Map
      =>
        "lst1" |-> L1
        "lst2" |-> L2
        "even" |-> (countEven(L1) +Int countEven(L2))
        "value" |-> lastValue(L2, lastValue(L1, 0))
      </env>
      <result> noResult => "NO" </result>
    </exchange>
    requires countEven(L1) +Int countEven(L2) <Int length(L1)
endmodule
requires "verification.k"

module MPY-SYNTAX
  imports INT-SYNTAX
  imports STRING-SYNTAX
  imports BOOL-SYNTAX

  syntax Ids ::= List{String, ","}
  syntax Params ::= "Params" "(" Ids ")" [symbol(Params)]

  syntax Exprs ::= List{Expr, ","}
  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol(CmpOp)]
  syntax CmpOps ::= List{CmpOp, ","}

  syntax Expr ::= "Int" "(" Int ")" [symbol(IntExpr)]
                | "Str" "(" String ")" [symbol(StrExpr)]
                | "Name" "(" String ")" [symbol(Name)]
                | "BinOp" "(" String "," Expr "," Expr ")" [symbol(BinOp)]
                | "Compare" "(" Expr "," CmpOps ")" [symbol(Compare)]
                | "Call" "(" Expr "," Exprs ")" [symbol(Call)]

  syntax Stmts ::= List{Stmt, ""}
  syntax Stmt ::= "Module" "(" Stmts ")" [symbol(Module)]
                | "FuncDef" "(" String "," Params "," Stmts ")" [symbol(FuncDef)]
                | "Assign" "(" Expr "," Expr ")" [symbol(Assign)]
                | "If" "(" Expr "," Stmts "," Stmts ")" [symbol(If)]
                | "For" "(" Expr "," Expr "," Stmts ")" [symbol(For)]
                | "Return" "(" Expr ")" [symbol(Return)]

  syntax PyList ::= "Nil" [symbol(Nil)]
                  | "Cons" "(" Int "," PyList ")" [symbol(Cons)]
  syntax Val ::= Int | String | Bool | PyList
  syntax Result ::= "noResult" [symbol(noResult)] | Val
endmodule

module SEMANTIC
  imports VERIFICATION
  imports INT
  imports STRING
  imports BOOL
  imports MAP

  syntax KItem ::= "init" "(" Stmt "," PyList "," PyList ")" [symbol(init)]
                 | "exec" "(" Stmts ")" [symbol(exec)]
                 | "eval" "(" Expr ")" [symbol(eval)]
                 | "write" "(" String ")" [symbol(write)]
                 | "binRight" "(" String "," Expr ")" [symbol(binRight)]
                 | "applyBin" "(" String "," Val ")" [symbol(applyBin)]
                 | "cmpRight" "(" String "," Expr ")" [symbol(cmpRight)]
                 | "applyCmp" "(" String "," Val ")" [symbol(applyCmp)]
                 | "doLen" [symbol(doLen)]
                 | "branch" "(" Stmts "," Stmts ")" [symbol(branch)]
                 | "startFor" "(" String "," Stmts ")" [symbol(startFor)]
                 | "loop" "(" String "," PyList "," Stmts ")" [symbol(loop)]
                 | "finish" [symbol(finish)]

  syntax Int ::= length(PyList) [function, total]
  rule length(Nil) => 0
  rule length(Cons(_, REST)) => 1 +Int length(REST)

  configuration
    <exchange>
      <k> init($PGM:Stmt, $LST1:PyList, $LST2:PyList) </k>
      <env> .Map </env>
      <result> noResult </result>
    </exchange>

  rule <k> init(Module(FuncDef("exchange", Params("lst1", "lst2"), BODY)), L1, L2)
        => exec(BODY) ... </k>
       <env> .Map
        => "lst1" |-> L1
           "lst2" |-> L2
           "even" |-> 0
           "value" |-> 0
       </env>

  rule <k> exec(.Stmts) => .K ... </k>
  rule <k> exec(Assign(Name(X), E) REST)
        => eval(E) ~> write(X) ~> exec(REST) ... </k>
  rule <k> V:Val ~> write(X) => .K ... </k>
       <env> RHO => RHO [ X <- V ] </env>

  rule <k> exec(If(E, THEN, ELSE) REST)
        => eval(E) ~> branch(THEN, ELSE) ~> exec(REST) ... </k>
  rule <k> true  ~> branch(THEN, _) => exec(THEN) ... </k>
  rule <k> false ~> branch(_, ELSE) => exec(ELSE) ... </k>

  // A pure-statement rule for the translated parity-counting idiom.  It is
  // equivalent to the general If/evaluation rules below, while keeping the
  // symbolic loop invariant independent of a solver case split.
  rule <k> exec(
          If(Compare(BinOp("%", Name(X), Int(2)), CmpOp("==", Int(0))),
             Assign(Name(Y), BinOp("+", Name(Y), Int(1))),
             .Stmts)
          REST)
        => exec(REST) ... </k>
       <env> ... X |-> I:Int
                 Y |-> (N:Int => N +Int evenBit(I)) ... </env>
       [priority(40)]

  rule <k> exec(For(Name(X), E, BODY) REST)
        => eval(E) ~> startFor(X, BODY) ~> exec(REST) ... </k>
  rule <k> L:PyList ~> startFor(X, BODY)
        => loop(X, L, BODY) ... </k>
  rule <k> loop(_, Nil, _) => .K ... </k>
  rule <k> loop(X, Cons(I, REST), BODY)
        => I ~> write(X) ~> exec(BODY) ~> loop(X, REST, BODY) ... </k>

  rule <k> exec(Return(E) _REST)
        => eval(E) ~> finish ... </k>
  rule <k> V:Val ~> finish ~> _REST:K => .K </k>
       <result> noResult => V </result>

  rule <k> eval(Int(I)) => I ... </k>
  rule <k> eval(Str(S)) => S ... </k>
  rule <k> eval(Name(X)) => V ... </k>
       <env> ... X |-> V ... </env>

  rule <k> eval(BinOp(OP, LEFT, RIGHT))
        => eval(LEFT) ~> binRight(OP, RIGHT) ... </k>
  rule <k> LEFT:Val ~> binRight(OP, RIGHT)
        => eval(RIGHT) ~> applyBin(OP, LEFT) ... </k>
  rule <k> RIGHT:Int ~> applyBin("+", LEFT:Int)
        => LEFT +Int RIGHT ... </k>
  rule <k> RIGHT:Int ~> applyBin("%", LEFT:Int)
        => LEFT %Int RIGHT ... </k>

  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT)))
        => eval(LEFT) ~> cmpRight(OP, RIGHT) ... </k>
  rule <k> LEFT:Val ~> cmpRight(OP, RIGHT)
        => eval(RIGHT) ~> applyCmp(OP, LEFT) ... </k>
  rule <k> RIGHT:Int ~> applyCmp("==", LEFT:Int)
        => LEFT ==Int RIGHT ... </k>
  rule <k> RIGHT:Int ~> applyCmp(">=", LEFT:Int)
        => LEFT >=Int RIGHT ... </k>

  rule <k> eval(Call(Name("len"), ARG))
        => eval(ARG) ~> doLen ... </k>
  rule <k> L:PyList ~> doLen => length(L) ... </k>
endmodule
