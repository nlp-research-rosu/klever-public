+                 | eval(Expr)
+                 | assignTo(String)
+                 | binLeft(String, Expr)
+                 | binRight(String, Int)
+                 | cmpLeft(String, Expr)
+                 | cmpRight(String, Int)
+                 | ifDecision(Stmts, Stmts)
+                 | whileLoop(Expr, Stmts)
+                 | whileDecision(Expr, Stmts)
+                 | "returnValue"
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm </k>
+      <env> .Map </env>
+      <n> $N:Int </n>
+      <result> noResult </result>
+    </mpy>
