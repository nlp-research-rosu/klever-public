+#!/usr/bin/env bash
+set -euo pipefail
+
+# Regenerate the constructor program using the supplied, unmodified translator.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Check the Python implementation independently on the prompt examples and
+# several later sequence elements.
+python3 - <<'PY'
+from solution import prime_fib
+
+expected = [2, 3, 5, 13, 89, 233, 1597, 28657, 514229, 433494437]
+actual = [prime_fib(n) for n in range(1, len(expected) + 1)]
+assert actual == expected, (actual, expected)
+PY
+
+# Compile and exercise the ordinary small-step semantics.
+kompile --main-module MPY --syntax-module MPY-SYNTAX \
+  --backend llvm -o semantic-kompiled semantic.k
+for n in 1 2 3 4 5; do
+  krun solution.mpy -d semantic-kompiled -cN="$n" --output pretty
+done
+
+# Prove full concrete interpreter executions without verification summaries.
+kompile --main-module PRIME-FIB-PROGRAM \
+  --syntax-module PRIME-FIB-PROGRAM \
+  --backend haskell -o concrete-kompiled verification.k
+kprove concrete-spec.k -d concrete-kompiled \
+  --spec-module CONCRETE-SPEC --color off
+
+# Prove the general positive-input claim and every example claim in spec.k.
+kompile --main-module VERIFICATION --syntax-module MPY-SYNTAX \
+  --backend haskell -o verification-kompiled verification.k
+kprove spec.k -d verification-kompiled --spec-module SPEC --color off
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..2330469b2d42d2256c5669b9637024770f692591
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,102 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  syntax Value ::= Int | Bool
+  syntax Result ::= "noResult" | Value
+
+  syntax KItem ::= exec(Stmts)
+                 | eval(Expr)
+                 | assignTo(String)
+                 | binLeft(String, Expr)
+                 | binRight(String, Int)
+                 | cmpLeft(String, Expr)
+                 | cmpRight(String, Int)
+                 | ifDecision(Stmts, Stmts)
+                 | whileLoop(Expr, Stmts)
+                 | whileDecision(Expr, Stmts)
+                 | "returnValue"
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm </k>
+      <env> .Map </env>
+      <n> $N:Int </n>
+      <result> noResult </result>
+    </mpy>
+
+  // A translated module in this task contains one top-level, one-argument
+  // function.  The configuration supplies that argument and starts its body.
+  rule <k> Module(FuncDef(_F, Params(P:String), BODY)) => exec(BODY) </k>
+       <env> .Map => P |-> N </env>
+       <n> N </n>
+
+  rule exec(.Stmts) => .K
+  rule exec(S:Stmt SS:Stmts) => S ~> exec(SS)
+
+  rule Assign(Name(X), E) => eval(E) ~> assignTo(X)
+  rule <k> V:Value ~> assignTo(X) => .K ...</k>
+       <env> ENV => ENV [ X <- V ] </env>
+
+  rule If(COND, THEN, ELSE) => eval(COND) ~> ifDecision(THEN, ELSE)
+  rule true  ~> ifDecision(THEN, _ELSE) => exec(THEN)
+  rule false ~> ifDecision(_THEN, ELSE) => exec(ELSE)
+
+  rule While(COND, BODY) => whileLoop(COND, BODY)
+  rule whileLoop(COND, BODY) => eval(COND) ~> whileDecision(COND, BODY)
+  rule true  ~> whileDecision(COND, BODY) => exec(BODY) ~> whileLoop(COND, BODY)
+  rule false ~> whileDecision(_COND, _BODY) => .K
+
+  rule Return(E) => eval(E) ~> returnValue
+  rule <k> V:Value ~> returnValue ~> _REST => .K </k>
+       <result> _ => V </result>
+
+  rule eval(Int(I)) => I
+  rule eval(Bool(B)) => B
+  rule <k> eval(Name(X)) => V ...</k>
+       <env> ... X |-> V:Value ...</env>
+
+  rule eval(BinOp(OP, LEFT, RIGHT)) => eval(LEFT) ~> binLeft(OP, RIGHT)
+  rule I:Int ~> binLeft(OP, RIGHT) => eval(RIGHT) ~> binRight(OP, I)
+  rule J:Int ~> binRight("+", I) => I +Int J
+  rule J:Int ~> binRight("*", I) => I *Int J
+  rule J:Int ~> binRight("%", I) => I %Int J
+
+  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)))
+    => eval(LEFT) ~> cmpLeft(OP, RIGHT)
+  rule I:Int ~> cmpLeft(OP, RIGHT) => eval(RIGHT) ~> cmpRight(OP, I)
+  rule J:Int ~> cmpRight("<",  I) => I <Int  J
+  rule J:Int ~> cmpRight("<=", I) => I <=Int J
+  rule J:Int ~> cmpRight("==", I) => I ==Int J
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..fd9b07abf36691c6268a6f56c7b49c6176693aa1
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,19 @@
+def prime_fib(n: int):
+    a = 0
+    b = 1
+    count = 0
+    while count < n:
+        c = a + b
+        a = b
+        b = c
+        divisor = 2
+        prime = True
+        if b < 2:
+            prime = False
+        while divisor * divisor <= b:
+            if b % divisor == 0:
+                prime = False
+            divisor = divisor + 1
+        if prime:
+            count = count + 1
+    return b
