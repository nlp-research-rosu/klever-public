+
+  syntax Value ::= Int | Bool
+  syntax Result ::= "noResult" | Value
+
+  syntax KItem ::= exec(Stmts)
+                 | eval(Expr)
+                 | assignTo(String)
+                 | binLeft(String, Expr)
+                 | binRight(String, Int)
+                 | cmpLeft(String, Expr)
+                 | cmpRight(String, Int)
+                 | ifDecision(Stmts, Stmts)
