+                 | eval(Expr)
+                 | assignTo(String)
+                 | binLeft(String, Expr)
+                 | binRight(String, Int)
+                 | cmpLeft(String, Expr)
+                 | cmpRight(String, Int)
+                 | ifDecision(Stmts, Stmts)
+                 | whileLoop(Expr, Stmts)
