diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..2330469b2d42d2256c5669b9637024770f692591
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,102 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  syntax Value ::= Int | Bool
+  syntax Result ::= "noResult" | Value
+
+  syntax KItem ::= exec(Stmts)
+                 | eval(Expr)
+                 | assignTo(String)
+                 | binLeft(String, Expr)
+                 | binRight(String, Int)
+                 | cmpLeft(String, Expr)
+                 | cmpRight(String, Int)
+                 | ifDecision(Stmts, Stmts)
+                 | whileLoop(Expr, Stmts)
+                 | whileDecision(Expr, Stmts)
+                 | "returnValue"
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm </k>
+      <env> .Map </env>
+      <n> $N:Int </n>
+      <result> noResult </result>
+    </mpy>
+
+  // A translated module in this task contains one top-level, one-argument
+  // function.  The configuration supplies that argument and starts its body.
+  rule <k> Module(FuncDef(_F, Params(P:String), BODY)) => exec(BODY) </k>
+       <env> .Map => P |-> N </env>
+       <n> N </n>
+
+  rule exec(.Stmts) => .K
+  rule exec(S:Stmt SS:Stmts) => S ~> exec(SS)
+
+  rule Assign(Name(X), E) => eval(E) ~> assignTo(X)
+  rule <k> V:Value ~> assignTo(X) => .K ...</k>
+       <env> ENV => ENV [ X <- V ] </env>
+
+  rule If(COND, THEN, ELSE) => eval(COND) ~> ifDecision(THEN, ELSE)
+  rule true  ~> ifDecision(THEN, _ELSE) => exec(THEN)
+  rule false ~> ifDecision(_THEN, ELSE) => exec(ELSE)
+
+  rule While(COND, BODY) => whileLoop(COND, BODY)
+  rule whileLoop(COND, BODY) => eval(COND) ~> whileDecision(COND, BODY)
+  rule true  ~> whileDecision(COND, BODY) => exec(BODY) ~> whileLoop(COND, BODY)
+  rule false ~> whileDecision(_COND, _BODY) => .K
+
+  rule Return(E) => eval(E) ~> returnValue
+  rule <k> V:Value ~> returnValue ~> _REST => .K </k>
+       <result> _ => V </result>
+
+  rule eval(Int(I)) => I
+  rule eval(Bool(B)) => B
+  rule <k> eval(Name(X)) => V ...</k>
+       <env> ... X |-> V:Value ...</env>
+
+  rule eval(BinOp(OP, LEFT, RIGHT)) => eval(LEFT) ~> binLeft(OP, RIGHT)
+  rule I:Int ~> binLeft(OP, RIGHT) => eval(RIGHT) ~> binRight(OP, I)
+  rule J:Int ~> binRight("+", I) => I +Int J
+  rule J:Int ~> binRight("*", I) => I *Int J
+  rule J:Int ~> binRight("%", I) => I %Int J
+
+  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)))
+    => eval(LEFT) ~> cmpLeft(OP, RIGHT)
+  rule I:Int ~> cmpLeft(OP, RIGHT) => eval(RIGHT) ~> cmpRight(OP, I)
+  rule J:Int ~> cmpRight("<",  I) => I <Int  J
+  rule J:Int ~> cmpRight("<=", I) => I <=Int J
+  rule J:Int ~> cmpRight("==", I) => I ==Int J
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..fd9b07abf36691c6268a6f56c7b49c6176693aa1
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,19 @@
+def prime_fib(n: int):
+    a = 0
+    b = 1
+    count = 0
+    while count < n:
+        c = a + b
+        a = b
+        b = c
+        divisor = 2
+        prime = True
+        if b < 2:
+            prime = False
+        while divisor * divisor <= b:
+            if b % divisor == 0:
+                prime = False
+            divisor = divisor + 1
+        if prime:
+            count = count + 1
+    return b
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1f6b5fba7c96c1898b4042d6523b0474b90308cf
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,97 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // General functional-correctness claim for the contract's positive index.
+  claim [prime-fib-correct]:
+    <mpy>
+    <k> primeFibProgram </k>
+    <env> .Map </env>
+    <n> N </n>
+    <result> noResult </result>
+    </mpy>
+  =>
+    <mpy>
+    <k> .K </k>
+    <env> .Map </env>
+    <n> N </n>
+    <result> primeFibSpec(N) </result>
+    </mpy>
+    requires N >Int 0
+
+  claim [example-1]:
+    <mpy>
+    <k> primeFibProgram </k>
+    <env> .Map </env>
+    <n> 1 </n>
+    <result> noResult </result>
+    </mpy>
+  =>
+    <mpy>
+    <k> .K </k>
+    <env> .Map </env>
+    <n> 1 </n>
+    <result> 2 </result>
+    </mpy>
+
+  claim [example-2]:
+    <mpy>
+    <k> primeFibProgram </k>
+    <env> .Map </env>
+    <n> 2 </n>
+    <result> noResult </result>
+    </mpy>
+  =>
+    <mpy>
+    <k> .K </k>
+    <env> .Map </env>
+    <n> 2 </n>
+    <result> 3 </result>
+    </mpy>
+
+  claim [example-3]:
+    <mpy>
+    <k> primeFibProgram </k>
+    <env> .Map </env>
+    <n> 3 </n>
+    <result> noResult </result>
+    </mpy>
+  =>
+    <mpy>
+    <k> .K </k>
+    <env> .Map </env>
+    <n> 3 </n>
+    <result> 5 </result>
+    </mpy>
+
+  claim [example-4]:
+    <mpy>
+    <k> primeFibProgram </k>
+    <env> .Map </env>
+    <n> 4 </n>
+    <result> noResult </result>
+    </mpy>
+  =>
+    <mpy>
+    <k> .K </k>
+    <env> .Map </env>
+    <n> 4 </n>
+    <result> 13 </result>
+    </mpy>
+
+  claim [example-5]:
+    <mpy>
+    <k> primeFibProgram </k>
+    <env> .Map </env>
+    <n> 5 </n>
+    <result> noResult </result>
+    </mpy>
+  =>
+    <mpy>
+    <k> .K </k>
+    <env> .Map </env>
+    <n> 5 </n>
+    <result> 89 </result>
+    </mpy>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2c6184eac2512da43f5e753ac7a94353349c6ca5
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,90 @@
+requires "semantic.k"
+
+// A readable name for the exact constructor tree generated from solution.py.
+// Because this is a macro, all claims ultimately mention the translated AST,
+// not a separately implemented or hand-invoked function.
+module PRIME-FIB-PROGRAM
+  imports MPY
+
+  syntax Pgm ::= "primeFibProgram"
+
+  rule primeFibProgram =>
+    Module(
+      FuncDef("prime_fib", Params("n"),
+        Assign(Name("a"), Int(0))
+        Assign(Name("b"), Int(1))
+        Assign(Name("count"), Int(0))
+        While(Compare(Name("count"), CmpOp("<", Name("n"))),
+          Assign(Name("c"), BinOp("+", Name("a"), Name("b")))
+          Assign(Name("a"), Name("b"))
+          Assign(Name("b"), Name("c"))
+          Assign(Name("divisor"), Int(2))
+          Assign(Name("prime"), Bool(true))
+          If(Compare(Name("b"), CmpOp("<", Int(2))),
+            Assign(Name("prime"), Bool(false)),
+            .Stmts)
+          While(Compare(
+              BinOp("*", Name("divisor"), Name("divisor")),
+              CmpOp("<=", Name("b"))),
+            If(Compare(
+                BinOp("%", Name("b"), Name("divisor")),
+                CmpOp("==", Int(0))),
+              Assign(Name("prime"), Bool(false)),
+              .Stmts)
+            Assign(
+              Name("divisor"),
+              BinOp("+", Name("divisor"), Int(1))))
+          If(Name("prime"),
+            Assign(
+              Name("count"),
+              BinOp("+", Name("count"), Int(1))),
+            .Stmts))
+        Return(Name("b"))))
+    [priority(30)]
+endmodule
+
+module VERIFICATION
+  imports PRIME-FIB-PROGRAM
+
+  // Independent mathematical predicates used by the postcondition.  A number
+  // is prime exactly when it is at least two and has no divisor from 2 through
+  // its integer square root.
+  syntax Bool ::= noDivisors(Int, Int) [function]
+                | isPrime(Int) [function]
+
+  rule isPrime(N) => false
+    requires N <Int 2
+  rule isPrime(N) => noDivisors(N, 2)
+    requires N >=Int 2
+
+  rule noDivisors(N, D) => true
+    requires D *Int D >Int N
+  rule noDivisors(N, D) => false
+    requires D *Int D <=Int N andBool N %Int D ==Int 0
+  rule noDivisors(N, D) => noDivisors(N, D +Int 1)
+    requires D *Int D <=Int N andBool N %Int D =/=Int 0
+
+  // primeFibFrom(R,A,B) searches Fibonacci successors of the adjacent pair
+  // (A,B) until R prime Fibonacci values have been encountered.
+  syntax Int ::= primeFibFrom(Int, Int, Int) [function]
+               | primeFibSpec(Int) [function]
+
+  rule primeFibSpec(N) => primeFibFrom(N, 0, 1)
+  rule primeFibFrom(0, _A, B) => B
+  rule primeFibFrom(R, A, B)
+    => primeFibFrom(R -Int 1, B, A +Int B)
+    requires R >Int 0 andBool isPrime(A +Int B)
+  rule primeFibFrom(R, A, B)
+    => primeFibFrom(R, B, A +Int B)
+    requires R >Int 0 andBool notBool isPrime(A +Int B)
+
+  // Exact-program loop summary.  It is restricted to the translated program,
+  // an empty initial environment, and the documented positive input domain.
+  // Concrete claims are also proved without this rule (see concrete-spec.k).
+  rule <k> primeFibProgram => .K </k>
+       <env> .Map </env>
+       <n> N </n>
+       <result> noResult => primeFibSpec(N) </result>
+    requires N >Int 0
+    [priority(20)]
+endmodule

exec
/bin/bash -lc 'kompile --main-module VERIFICATION --syntax-module MPY-SYNTAX --backend haskell -o verification-kompiled verification.k && kprove spec.k -d verification-kompiled --spec-module SPEC --color off --debug' in /work
