diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..fd9b07abf36691c6268a6f56c7b49c6176693aa1
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,19 @@
+def prime_fib(n: int):
+    a = 0
+    b = 1
+    count = 0
+    while count < n:
+        c = a + b
+        a = b
+        b = c
+        divisor = 2
+        prime = True
+        if b < 2:
+            prime = False
+        while divisor * divisor <= b:
+            if b % divisor == 0:
+                prime = False
+            divisor = divisor + 1
+        if prime:
+            count = count + 1
+    return b
