+++ b/spec.k
@@ -0,0 +1,97 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // General functional-correctness claim for the contract's positive index.
+  claim [prime-fib-correct]:
+    <mpy>
+    <k> primeFibProgram </k>
+    <env> .Map </env>
+    <n> N </n>
+    <result> noResult </result>
+    </mpy>
+  =>
+    <mpy>
+    <k> .K </k>
+    <env> .Map </env>
+    <n> N </n>
+    <result> primeFibSpec(N) </result>
+    </mpy>
+    requires N >Int 0
+
+  claim [example-1]:
+    <mpy>
+    <k> primeFibProgram </k>
+    <env> .Map </env>
+    <n> 1 </n>
+    <result> noResult </result>
+    </mpy>
+  =>
+    <mpy>
+    <k> .K </k>
+    <env> .Map </env>
+    <n> 1 </n>
+    <result> 2 </result>
+    </mpy>
+
+  claim [example-2]:
+    <mpy>
+    <k> primeFibProgram </k>
+    <env> .Map </env>
+    <n> 2 </n>
+    <result> noResult </result>
+    </mpy>
+  =>
+    <mpy>
+    <k> .K </k>
+    <env> .Map </env>
+    <n> 2 </n>
+    <result> 3 </result>
+    </mpy>
+
+  claim [example-3]:
+    <mpy>
+    <k> primeFibProgram </k>
+    <env> .Map </env>
+    <n> 3 </n>
+    <result> noResult </result>
+    </mpy>
+  =>
+    <mpy>
+    <k> .K </k>
+    <env> .Map </env>
+    <n> 3 </n>
+    <result> 5 </result>
+    </mpy>
+
+  claim [example-4]:
+    <mpy>
+    <k> primeFibProgram </k>
+    <env> .Map </env>
+    <n> 4 </n>
+    <result> noResult </result>
+    </mpy>
+  =>
+    <mpy>
+    <k> .K </k>
+    <env> .Map </env>
+    <n> 4 </n>
+    <result> 13 </result>
+    </mpy>
+
+  claim [example-5]:
+    <mpy>
+    <k> primeFibProgram </k>
+    <env> .Map </env>
+    <n> 5 </n>
+    <result> noResult </result>
+    </mpy>
+  =>
+    <mpy>
+    <k> .K </k>
+    <env> .Map </env>
+    <n> 5 </n>
+    <result> 89 </result>
+    </mpy>
+endmodule
