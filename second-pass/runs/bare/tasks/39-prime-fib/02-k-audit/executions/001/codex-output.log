+#!/usr/bin/env bash
+set -u
+set -o pipefail
+
+work=/tmp/audit-work
+evidence=/audit-output/evidence
+failures=0
+
+run_logged() {
+  local logfile=$1
+  shift
+  printf 'COMMAND:' | tee "$logfile"
+  printf ' %q' "$@" | tee -a "$logfile"
+  printf '\n' | tee -a "$logfile"
+  "$@" 2>&1 | tee -a "$logfile"
+  local status=${PIPESTATUS[0]}
+  printf 'EXIT_STATUS=%s\n' "$status" | tee -a "$logfile"
