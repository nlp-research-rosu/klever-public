### solution.py
     1	def prime_fib(n: int):
     2	    a = 0
     3	    b = 1
     4	    count = 0
     5	    while count < n:
     6	        c = a + b
     7	        a = b
     8	        b = c
     9	        divisor = 2
    10	        prime = True
    11	        if b < 2:
    12	            prime = False
    13	        while divisor * divisor <= b:
    14	            if b % divisor == 0:
    15	                prime = False
    16	            divisor = divisor + 1
    17	        if prime:
    18	            count = count + 1
    19	    return b

