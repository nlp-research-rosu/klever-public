+  printf '\n'
+  "${command[@]}"
+  status=$?
+  printf 'CLAIM_EXIT %s: %s\n' "$label" "$status"
+  if [[ "$status" -ne 0 ]]; then
+    overall=1
+  fi
+done
+
+exit "$overall"
