+  printf '\n'
+  "${command[@]}"
+  status=$?
+  printf 'CLAIM_EXIT %s: %s\n' "$label" "$status"
+  if [[ "$status" -ne 0 ]]; then
+    overall=1
+  fi
+done
+
+for label in prime-fib-correct example-1 example-2 example-3 example-4 example-5; do
+  command=(
+    kprove spec.k
+    --definition audit-verification-kompiled
+    --spec-module SPEC
+    --claims "SPEC.${label}"
+    --color off
+  )
+  printf 'CLAIM_COMMAND:'
+  printf ' %q' "${command[@]}"
+  printf '\n'
+  "${command[@]}"
+  status=$?
+  printf 'CLAIM_EXIT %s: %s\n' "$label" "$status"
+  if [[ "$status" -ne 0 ]]; then
+    overall=1
+  fi
+done
+
+exit "$overall"
