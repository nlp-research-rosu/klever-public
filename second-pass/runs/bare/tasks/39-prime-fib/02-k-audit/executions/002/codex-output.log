diff --git a//tmp/audit-work/39-prime-fib/src/audit-body-mut-extended-spec.k b//tmp/audit-work/39-prime-fib/src/audit-body-mut-extended-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..95fe9d6e6981f42b637aa97f8e539a4065d2bade
