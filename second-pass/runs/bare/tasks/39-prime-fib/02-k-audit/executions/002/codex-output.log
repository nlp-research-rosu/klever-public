from pathlib import Path
import hashlib,itertools,struct
cases=[('/candidate','04beec35d62a052ae61d63eb2ab705c09f490353259f3d26fad1faf689260a32'),('/generation-evidence/codex-trace','85ad989bf13ff28b45405a4c2e6be37864866c8f92672c0eb58ee8a35349c52a')]

def entries(root, incdirs):
 r=Path(root)
 return [(p.relative_to(r).as_posix(), 'directory' if p.is_dir() else 'file', p) for p in sorted(r.rglob('*')) if p.is_file() or (incdirs and p.is_dir())]

def calc(root, incdirs, sep, kind_style, content_style, path_suffix, entry_suffix, root_entry):
 es=entries(root,incdirs)
 if root_entry: es=[('.', 'directory', Path(root))]+es
 h=hashlib.sha256()
 for rel,kind,p in es:
  h.update(rel.encode()); h.update(path_suffix)
  if kind_style=='word': h.update(kind.encode())
  elif kind_style=='letter': h.update(b'd' if kind=='directory' else b'f')
  elif kind_style=='upper': h.update(b'D' if kind=='directory' else b'F')
  if kind_style"'!='"'none': h.update(sep)
  if kind=='file':
   data=p.read_bytes()
   if content_style=='raw': h.update(data)
   elif content_style=='hexdigest': h.update(hashlib.sha256(data).hexdigest().encode())
   elif content_style=='digest': h.update(hashlib.sha256(data).digest())
   elif content_style=='size_raw': h.update(str(len(data)).encode()+sep+data)
   elif content_style=='size8_raw': h.update(len(data).to_bytes(8,'big')+data)
  h.update(entry_suffix)
 return h.hexdigest()

opts=[]
for incdirs,sep,ks,cs,ps,es,re in itertools.product([False,True],[b'',b'\\0',b'\\n',b':',b' '],['none','word','letter','upper'],['raw','hexdigest','digest','size_raw','size8_raw'],[b'',b'\\0',b'\\n'],[b'',b'\\0',b'\\n'],[False,True]):
 vals=[calc(root,incdirs,sep,ks,cs,ps,es,re) for root,_ in cases]
 if all(v==target for v,(_,target) in zip(vals,cases)):
  print('MATCH',incdirs,sep,ks,cs,ps,es,re)
  break
else: print('no match')
