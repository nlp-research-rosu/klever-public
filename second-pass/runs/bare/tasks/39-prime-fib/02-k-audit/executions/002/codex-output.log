cases=[('/candidate','04beec35d62a052ae61d63eb2ab705c09f490353259f3d26fad1faf689260a32'),('/generation-evidence/codex-trace','85ad989bf13ff28b45405a4c2e6be37864866c8f92672c0eb58ee8a35349c52a')]

def calc(root, dirs, rootent, sep, pathterm, kind, modefmt, sizefmt, cont, entterm):
 r=Path(root); ps=sorted([p for p in r.rglob('*') if p.is_file() or (dirs and p.is_dir())], key=lambda p:p.relative_to(r).as_posix())
 if rootent: ps=[r]+ps
 h=hashlib.sha256()
 for p in ps:
  rel='.' if p==r else p.relative_to(r).as_posix()
  isd=p.is_dir(); data=b'' if isd else p.read_bytes()
  h.update(rel.encode()+pathterm)
  if kind=='word': h.update((b'directory' if isd else b'file')+sep)
  elif kind=='letter': h.update((b'd' if isd else b'f')+sep)
  elif kind=='upper': h.update((b'D' if isd else b'F')+sep)
  if modefmt=='oct': h.update(oct(p.stat().st_mode & 0o7777).encode()+sep)
  elif modefmt=='digits': h.update(f'{p.stat().st_mode & 0o7777:o}'.encode()+sep)
  elif modefmt=='full': h.update(str(p.stat().st_mode).encode()+sep)
  elif modefmt=='4be': h.update((p.stat().st_mode & 0xffffffff).to_bytes(4,'big')+sep)
  if not isd:
   if sizefmt=='dec': h.update(str(len(data)).encode()+sep)
   elif sizefmt=='8be': h.update(len(data).to_bytes(8,'big')+sep)
   elif sizefmt=='4be': h.update(len(data).to_bytes(4,'big')+sep)
   if cont=='raw': h.update(data)
   elif cont=='hex': h.update(hashlib.sha256(data).hexdigest().encode())
   elif cont=='dig': h.update(hashlib.sha256(data).digest())
  h.update(entterm)
 return h.hexdigest()

space=itertools.product([False,True],[False,True],[b'',b'\\0',b'\\n',b':',b' '],[b'',b'\\0',b'\\n'],['none','word','letter','upper'],['none','oct','digits','full','4be'],['none','dec','8be','4be'],['raw','hex','dig'],[b'',b'\\0',b'\\n'])
for j,args in enumerate(space):
