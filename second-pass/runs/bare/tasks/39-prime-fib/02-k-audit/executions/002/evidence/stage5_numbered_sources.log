     1	requires "semantic.k"
     2	
     3	// A readable name for the exact constructor tree generated from solution.py.
     4	// Because this is a macro, all claims ultimately mention the translated AST,
     5	// not a separately implemented or hand-invoked function.
     6	module PRIME-FIB-PROGRAM
     7	  imports MPY
     8	
     9	  syntax Pgm ::= "primeFibProgram"
    10	
    11	  rule primeFibProgram =>
    12	    Module(
    13	      FuncDef("prime_fib", Params("n"),
    14	        Assign(Name("a"), Int(0))
    15	        Assign(Name("b"), Int(1))
    16	        Assign(Name("count"), Int(0))
    17	        While(Compare(Name("count"), CmpOp("<", Name("n"))),
    18	          Assign(Name("c"), BinOp("+", Name("a"), Name("b")))
    19	          Assign(Name("a"), Name("b"))
    20	          Assign(Name("b"), Name("c"))
    21	          Assign(Name("divisor"), Int(2))
    22	          Assign(Name("prime"), Bool(true))
    23	          If(Compare(Name("b"), CmpOp("<", Int(2))),
    24	            Assign(Name("prime"), Bool(false)),
    25	            .Stmts)
    26	          While(Compare(
    27	              BinOp("*", Name("divisor"), Name("divisor")),
    28	              CmpOp("<=", Name("b"))),
    29	            If(Compare(
    30	                BinOp("%", Name("b"), Name("divisor")),
    31	                CmpOp("==", Int(0))),
    32	              Assign(Name("prime"), Bool(false)),
    33	              .Stmts)
    34	            Assign(
    35	              Name("divisor"),
    36	              BinOp("+", Name("divisor"), Int(1))))
    37	          If(Name("prime"),
    38	            Assign(
    39	              Name("count"),
    40	              BinOp("+", Name("count"), Int(1))),
    41	            .Stmts))
    42	        Return(Name("b"))))
    43	    [priority(30)]
    44	endmodule
    45	
    46	module VERIFICATION
    47	  imports PRIME-FIB-PROGRAM
    48	
    49	  // Independent mathematical predicates used by the postcondition.  A number
    50	  // is prime exactly when it is at least two and has no divisor from 2 through
    51	  // its integer square root.
    52	  syntax Bool ::= noDivisors(Int, Int) [function]
    53	                | isPrime(Int) [function]
    54	
    55	  rule isPrime(N) => false
    56	    requires N <Int 2
    57	  rule isPrime(N) => noDivisors(N, 2)
    58	    requires N >=Int 2
    59	
    60	  rule noDivisors(N, D) => true
    61	    requires D *Int D >Int N
    62	  rule noDivisors(N, D) => false
    63	    requires D *Int D <=Int N andBool N %Int D ==Int 0
    64	  rule noDivisors(N, D) => noDivisors(N, D +Int 1)
    65	    requires D *Int D <=Int N andBool N %Int D =/=Int 0
    66	
    67	  // primeFibFrom(R,A,B) searches Fibonacci successors of the adjacent pair
    68	  // (A,B) until R prime Fibonacci values have been encountered.
    69	  syntax Int ::= primeFibFrom(Int, Int, Int) [function]
    70	               | primeFibSpec(Int) [function]
    71	
    72	  rule primeFibSpec(N) => primeFibFrom(N, 0, 1)
    73	  rule primeFibFrom(0, _A, B) => B
    74	  rule primeFibFrom(R, A, B)
    75	    => primeFibFrom(R -Int 1, B, A +Int B)
    76	    requires R >Int 0 andBool isPrime(A +Int B)
    77	  rule primeFibFrom(R, A, B)
    78	    => primeFibFrom(R, B, A +Int B)
    79	    requires R >Int 0 andBool notBool isPrime(A +Int B)
    80	
    81	  // Exact-program loop summary.  It is restricted to the translated program,
    82	  // an empty initial environment, and the documented positive input domain.
    83	  // Concrete claims are also proved without this rule (see concrete-spec.k).
    84	  rule <k> primeFibProgram => .K </k>
    85	       <env> .Map </env>
    86	       <n> N </n>
    87	       <result> noResult => primeFibSpec(N) </result>
    88	    requires N >Int 0
    89	    [priority(20)]
    90	endmodule
