+module MPY-SYNTAX
+  imports RAT-SYNTAX
+  imports MAP
+  imports STRING
+
+  syntax Program ::= "Module" "(" Stmts ")" [symbol]
+
+  syntax Stmts ::= List{Stmt, ""}
