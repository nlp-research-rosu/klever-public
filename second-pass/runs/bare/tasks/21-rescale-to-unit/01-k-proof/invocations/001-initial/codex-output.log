new file mode 100644
index 0000000000000000000000000000000000000000..fae79292c881d42ff5ab461db7e35f129afc1a92
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+from typing import List
+
+
+def rescale_to_unit(numbers: List[float]) -> List[float]:
+    minimum = min(numbers)
+    maximum = max(numbers)
+    return [
+        (number - minimum) / (maximum - minimum)
+        for number in numbers
+    ]
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f2bdc4c7e6a207fa9a718b309f6cea2267284145
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,77 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The example from the HumanEval prompt.
+  claim
+    <python>
+      <k> verify(solutionProgram, vlist(1, 2, 3, 4, 5, .Rats))
+           => done(vlist(0, 1 /Rat 4, 1 /Rat 2, 3 /Rat 4, 1, .Rats))
+      </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult </result>
+    </python>
+
+  // Negative values, a non-integral result, and a repeated maximum.
+  claim
+    <python>
+      <k> verify(solutionProgram, vlist(-5, 0, 5, 5, .Rats))
+           => done(vlist(0, 1 /Rat 2, 1, 1, .Rats))
+      </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult </result>
+    </python>
+
+  // For every increasing two-point input, the endpoints become exactly 0, 1.
+  claim
+    <python>
+      <k> verify(solutionProgram, vlist(A, B, .Rats))
+           => done(vlist(0, 1, .Rats))
+      </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult </result>
+    </python>
+    requires A <Rat B
+
+  // A symbolic three-point proof: endpoints are 0 and 1 and the middle value
+  // is precisely the contract's affine transform.
+  claim
+    <python>
+      <k> verify(solutionProgram, vlist(A, B, C, .Rats))
+           => done(vlist(0, (B -Rat A) /Rat (C -Rat A), 1, .Rats))
+      </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult </result>
+    </python>
+    requires A <=Rat B andBool B <=Rat C andBool A <Rat C
+
+  // Ordering is not assumed by the implementation: the same symbolic values
+  // in descending order are transformed pointwise and retain their positions.
+  claim
+    <python>
+      <k> verify(solutionProgram, vlist(C, B, A, .Rats))
+           => done(vlist(1, (B -Rat A) /Rat (C -Rat A), 0, .Rats))
+      </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult </result>
+    </python>
+    requires A <=Rat B andBool B <=Rat C andBool A <Rat C
+
+  // Repeated extrema remain repeated extrema after rescaling.
+  claim
+    <python>
+      <k> verify(solutionProgram, vlist(A, A, B, B, .Rats))
+           => done(vlist(0, 0, 1, 1, .Rats))
+      </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult </result>
+    </python>
+    requires A <Rat B
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..efdc2511f35e15ea020b86af79f65475280cd05b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,53 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // This is the exact constructor tree generated in solution.mpy.  Keeping it
+  // as a function makes the claims readable; prove.sh regenerates and runs the
+  // actual solution.mpy before invoking these proofs.
+  syntax Program ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      ImportFrom("typing", "List", .Strings)
+      FuncDef("rescale_to_unit", Params("numbers", .Strings),
+        CellVars("maximum", "minimum", .Strings), FreeVars(.Strings),
+        Assign(Name("minimum"), Call(Name("min"), Name("numbers")))
+        Assign(Name("maximum"), Call(Name("max"), Name("numbers")))
+        Return(
+          ListComp(
+            BinOp("/",
+              BinOp("-", Name("number"), Name("minimum")),
+              BinOp("-", Name("maximum"), Name("minimum"))),
+            CompFor(Name("number"), Name("numbers"), Bool(true))))
+        .Stmts)
+      .Stmts)
+
+  // Proof-only wrapper: execute the ordinary operational semantics, collect
+  // the returned value, and restore the auxiliary cells to their initial
+  // values.  This lets a claim focus on the observable function result.
+  syntax KItem ::= verify(Program, Value) | "collect" | done(Value)
+
+  rule <k> verify(Module(SS), ARG)
+         => exec(SS) ~> invoke("rescale_to_unit", ARG) ~> collect
+       </k>
+
+  rule <k> collect => done(V) </k>
+       <functions> _ => .Map </functions>
+       <env> _ => .Map </env>
+       <result> V => noResult </result>
+
+  // An independent, mathematical statement of the contract.  It uses only
+  // minimum, maximum, and pointwise affine scaling over exact rationals.
+  syntax Value ::= rescaleSpec(Value) [function]
+  syntax Rats ::= scaleRats(Rats, Rat, Rat) [function]
+
+  rule rescaleSpec(vlist(H, T))
+    => vlist(scaleRats(H, T, minRats(H, T), maxRats(H, T)))
+    requires minRats(H, T) =/=Rat maxRats(H, T)
+
+  rule scaleRats(.Rats, _, _) => .Rats
+  rule scaleRats(X, XS, LO, HI)
+    => ((X -Rat LO) /Rat (HI -Rat LO)), scaleRats(XS, LO, HI)
+    requires HI =/=Rat LO
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..416511cd6a190fd25136900c52b5d562221d799a
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,132 @@
+requires "rat.md"
+
+// A deliberately small semantics for the pure-Python fragment used by
+// solution.mpy.  Python numeric values are interpreted as exact rationals.
+// This removes irrelevant IEEE-754 rounding from the functional proof while
+// retaining the meaning of +, -, ordering, min, max, and division.
+module MPY-SYNTAX
+  imports RAT-SYNTAX
+  imports BOOL
+  imports MAP
+  imports STRING
+
+  syntax Program ::= "Module" "(" Stmts ")" [symbol]
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Strings ::= List{String, ","}
+
+  syntax Params ::= "Params" "(" Strings ")" [symbol]
+  syntax CellVars ::= "CellVars" "(" Strings ")" [symbol]
+  syntax FreeVars ::= "FreeVars" "(" Strings ")" [symbol]
+
+  syntax Stmt ::= "ImportFrom" "(" String "," Strings ")" [symbol]
+                | "FuncDef" "(" String "," Params "," CellVars "," FreeVars "," Stmts ")" [symbol]
+                | "Assign" "(" Expr "," Expr ")" [symbol]
+                | "Return" "(" Expr ")" [symbol]
+
+  syntax Expr ::= "Name" "(" String ")" [symbol]
+                | "Call" "(" Expr "," Expr ")" [symbol]
+                | "BinOp" "(" String "," Expr "," Expr ")" [symbol]
+                | "ListComp" "(" Expr "," CompFor ")" [symbol]
+                | "Bool" "(" Bool ")" [symbol]
+
+  syntax CompFor ::= "CompFor" "(" Expr "," Expr "," Expr ")" [symbol]
+
+  // Runtime input/output values.  vlist is a list of exact real (rational)
+  // numbers.  For example, vlist(1, 2, 3) models Python [1.0, 2.0, 3.0].
+  syntax Rats ::= List{Rat, ","}
+  syntax Value ::= Rat
+                 | "vlist" "(" Rats ")" [symbol]
+                 | "noResult" [symbol]
+
+  syntax Definition ::= "function" "(" Params "," Stmts ")" [symbol]
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports RAT
+
+  configuration
+    <python>
+      <k> boot($PGM:Program, $ARGS:Value) </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <result> noResult </result>
+    </python>
+
+  syntax KItem ::= boot(Program, Value)
+                 | exec(Stmts)
+                 | invoke(String, Value)
+
+  // Loading a module registers its definitions before invoking the requested
+  // HumanEval entry point.  ImportFrom has no runtime effect because type
+  // annotations have already been erased by the supplied AST translator.
+  rule <k> boot(Module(SS), ARG) => exec(SS) ~> invoke("rescale_to_unit", ARG) </k>
+
+  rule <k> exec(.Stmts) => .K ... </k>
+  rule <k> exec(ImportFrom(_, _) SS) => exec(SS) ... </k>
+
+  rule <k> exec(FuncDef(NAME, PARAMS, _, _, BODY) SS) => exec(SS) ... </k>
+       <functions> FS => FS [ NAME <- function(PARAMS, BODY) ] </functions>
+
+  rule <k> invoke(NAME, ARG) => exec(BODY) ... </k>
+       <functions> ... NAME |-> function(Params(PARAM, .Strings), BODY) ... </functions>
+       <env> _ => PARAM |-> ARG </env>
+
+  rule <k> exec(Assign(Name(NAME), E) SS) => exec(SS) ... </k>
+       <env> ENV => ENV [ NAME <- eval(E, ENV) ] </env>
+
+  rule <k> exec(Return(E) _) => .K ... </k>
+       <env> ENV </env>
+       <result> _ => eval(E, ENV) </result>
+
+  // Expression evaluation is functional: comprehensions use a temporary map
+  // binding and therefore cannot mutate the surrounding function environment.
+  syntax Value ::= eval(Expr, Map) [function]
+                 | evalComp(Expr, String, Value, Map) [function]
+                 | prepend(Rat, Value) [function]
+
+  syntax Rat ::= evalNumber(Expr, Map) [function]
+               | minValue(Value) [function]
+               | maxValue(Value) [function]
+               | minRats(Rat, Rats) [function]
+               | maxRats(Rat, Rats) [function]
+
+  rule eval(Name(NAME), (NAME |-> V:Value) REST) => V
+
+  rule eval(Call(Name("min"), E), ENV) => minValue(eval(E, ENV))
+  rule eval(Call(Name("max"), E), ENV) => maxValue(eval(E, ENV))
+
+  rule eval(BinOp(OP, L, R), ENV) => evalNumber(BinOp(OP, L, R), ENV)
+
+  rule eval(ListComp(E, CompFor(Name(VAR), ITER, _)), ENV)
+    => evalComp(E, VAR, eval(ITER, ENV), ENV)
+
+  rule evalNumber(Name(NAME), (NAME |-> R:Rat) REST) => R
+  rule evalNumber(BinOp("-", L, R), ENV)
+    => evalNumber(L, ENV) -Rat evalNumber(R, ENV)
+  rule evalNumber(BinOp("/", L, R), ENV)
+    => evalNumber(L, ENV) /Rat evalNumber(R, ENV)
+
+  rule evalComp(_, _, vlist(.Rats), _) => vlist(.Rats)
+  rule evalComp(E, VAR, vlist(R, RS), ENV)
+    => prepend(evalNumber(E, ENV [ VAR <- R ]),
+               evalComp(E, VAR, vlist(RS), ENV))
+
+  rule prepend(R, vlist(RS)) => vlist(R, RS)
+
+  rule minValue(vlist(R, RS)) => minRats(R, RS)
+  rule maxValue(vlist(R, RS)) => maxRats(R, RS)
+
+  rule minRats(M, .Rats) => M
+  rule minRats(M, R, RS) => minRats(M, RS)
+    requires M <=Rat R
+  rule minRats(M, R, RS) => minRats(R, RS)
+    requires R <Rat M
+
+  rule maxRats(M, .Rats) => M
+  rule maxRats(M, R, RS) => maxRats(M, RS)
+    requires M >=Rat R
+  rule maxRats(M, R, RS) => maxRats(R, RS)
+    requires R >Rat M
+endmodule
