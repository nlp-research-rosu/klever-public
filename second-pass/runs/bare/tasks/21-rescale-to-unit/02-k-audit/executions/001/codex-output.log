\t      </k>\\n    73\\t      <functions> .Map </functions>\\n    74\\t      <env> .Map </env>\\n    75\\t      <result> noResult </result>\\n    76\\t    </python>\\n    77\\t    requires A <Rat B andBool B <Rat C andBool A <Rat C\\n    78\\t\\n    79\\t  // Repeated extrema remain repeated extrema after rescaling.\\n    80\\t  claim\\n    81\\t    <python>\\n    82\\t      <k> verify(solutionProgram, vlist(A, A, B, B, .Rats))\\n    83\\t           => done(vlist(0, 0, 1, 1, .Rats))\\n    84\\t      </k>\\n    85\\t      <functions> .Map </functions>\\n    86\\t      <env> .Map </env>\\n    87\\t      <result> noResult </result>\\n    88\\t    </python>\\n    89\\t    requires A <Rat B\\n    90\\tendmodule\\n#Top\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f891e-92e1-7f61-8924-5d6a327bd75b"}}}
