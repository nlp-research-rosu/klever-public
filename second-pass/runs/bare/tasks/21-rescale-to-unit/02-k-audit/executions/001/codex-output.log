+  -cARGS='vlist(1)' \
+  --output pretty
+run krun "$src/solution.mpy" \
+  --definition "$build/semantic-kompiled" \
+  -cARGS='vlist(2, 2)' \
+  --output pretty
+run krun "$src/solution.mpy" \
+  --definition "$build/semantic-kompiled" \
+  -cARGS='vlist()' \
+  --output pretty
+run python3 /audit-output/evidence/python_k_cases.py
+
+for claim in c1 c2 c3 c4 c5 c6 c7; do
