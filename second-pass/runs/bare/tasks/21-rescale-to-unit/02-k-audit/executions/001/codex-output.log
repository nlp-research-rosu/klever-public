nction result.\\n    29\\t  syntax KItem ::= verify(Program, Value) | \\\"collect\\\" | done(Value)\\n    30\\t\\n    31\\t  rule <k> verify(Module(SS), ARG)\\n    32\\t         => exec(SS) ~> invoke(\\\"rescale_to_unit\\\", ARG) ~> collect\\n    33\\t       </k>\\n    34\\t\\n    35\\t  rule <k> collect => done(V) </k>\\n    36\\t       <functions> _ => .Map </functions>\\n    37\\t       <env> _ => .Map </env>\\n    38\\t       <result> V => noResult </result>\\n    39\\t\\n    40\\t  // An independent, mathematical statement of the contract.  It uses only\\n    41\\t  // minimum, maximum, and pointwise affine scaling over exact rationals.\\n    42\\t  syntax Value ::= rescaleSpec(Value) [function]\\n    43\\t  syntax Rats ::= scaleRats(Rats, Rat, Rat) [function]\\n    44\\t\\n    45\\t  rule rescaleSpec(vlist(H, T))\\n    46\\t    => vlist(scaleRats(H, T, minRats(H, T), maxRats(H, T)))\\n    47\\t    requires minRats(H, T) =/=Rat maxRats(H, T)\\n    48\\t\\n    49\\t  rule scaleRats(.Rats, _, _) => .Rats\\n    50\\t  rule scaleRats(X, XS, LO, HI)\\n    51\\t    => ((X -Rat LO) /Rat (HI -Rat LO)), scaleRats(XS, LO, HI)\\n    52\\t    requires HI =/=Rat LO\\n    53\\tendmodule\\n[Warning] Compiler: Zero-argument `symbol` attribute used without a\\ncorresponding `klabel(_)`. Either remove `symbol`, or supply an argument.\\n\\tSource(/work/semantic.k)\\n\\tLocation(13,22,13,53)\\n\\t13 |\\t  syntax Program ::= \\\"Module\\\" \\\"(\\\" Stmts \\\")\\\" [symbol]\\n\\t   .\\t                     ^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\\n[Warning] Compiler: Zero-argument `symbol` attribute used without a\\ncorresponding `klabel(_)`. Either remove `symbol`, or supply an argument.\\n\\tSource(/work/semantic.k)\\n\\tLocation(18,21,18,54)\\n\\t18 |\\t  syntax Params ::= \\\"Params\\\" \\\"(\\\" Strings \\\")\\\" [symbol]\\n\\t   .\\t                    ^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\\n[Warning] Compiler: Zero-argument `symbol` attribute used without a\\ncorresponding `klabel(_)`. Either remove `symbol`, or supply an argument.\\n\\tSource(/work/semantic.k)\\n\\tLocation(19,23,19,58)\\n\\t19 |\\t  syntax CellVars ::= \\\"CellVars\\\" \\\"(\\\" Strings \\\")\\\" [symbol]\\n\\t   .\\t                      ^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\\n[Warning] Compiler: Zero-argument `symbol` attribute used without a\\ncorresponding `klabel(_)`. Either remove `symbol`, or supply an argument.\\n\\tSource(/work/semantic.k)\\n\\tLocation(20,23,20,58)\\n\\t20 |\\t  syntax FreeVars ::= \\\"FreeVars\\\" \\\"(\\\" Strings \\\")\\\" [symbol]\\n\\t   .\\t                      ^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\\n[Warning] Compiler: Zero-argument `symbol` attribute used without a\\ncorresponding `klabel(_)`. Either remove `symbol`, or supply an argument.\\n\\tSource(/work/semantic.k)\\n\\tLocation(22,19,22,67)\\n\\t22 |\\t  syntax Stmt ::= \\\"ImportFrom\\\" \\\"(\\\" String \\\",\\\" Strings \\\")\\\" [symbol]\\n\\t   .\\t                  ^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\\n[Warning] Compiler: Zero-argument `symbol` attribute used without a\\ncorresponding `klabel(_)`. Either remove `symbol`, or supply an argument.\\n\\tSource(/work/semantic.k)\\n\\tLocation(23,19,23,99)\\n\\t23 |\\t                | \\\"FuncDef\\\" \\\"(\\\" String \\\",\\\" Params \\\",\\\" CellVars \\\",\\\"\\nFreeVars \\\",\\\" Stmts \\\")\\\" [symbol]\\n\\t   .\\t                 \\n^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\\n[Warning] Compiler: Zero-argument `symbol` attribute used without a\\ncorresponding `klabel(_)`. Either remove `symbol`, or supply an argument.\\n\\tSource(/work/semantic.k)\\n\\tLocation(24,19,24,58)\\n\\t24 |\\t                | \\\"Assign\\\" \\\"(\\\" Expr \\\",\\\" Expr \\\")\\\" [symbol]\\n\\t   .\\t                  ^~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~\\n[Warning] Compiler: Zero-argument `symbol` attribute used without a\\ncorresponding `klabel(_)`. Either remove `symbol`, or supply an argument.\\n\\tSou