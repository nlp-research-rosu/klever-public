+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return 0
+}
+
+trace=/candidate/codex-trace/2026/07/22/rollout-2026-07-22T04-18-30-019f891e-92d4-7492-943c-e81f33ab55ec.jsonl
