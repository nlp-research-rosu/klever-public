+records = {}
+for name, values in cases.items():
+    try:
+        records[name] = {"kind": "return", "value": module.rescale_to_unit(values)}
+    except Exception as error:
+        records[name] = {
+            "kind": "exception",
+            "type": type(error).__name__,
+            "message": str(error),
+        }
+print(json.dumps(records, indent=2, sort_keys=True))
