+run test ! -e /reference/reference-semantics
+run find /reference -maxdepth 2 -printf '%y %p -> %l\n'
+run find /candidate -maxdepth 1 -printf '%y %f -> %l\n'
+run stat -c '%F %a %s %n' \
+  /candidate/run-input.json \
