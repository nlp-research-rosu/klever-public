+#!/usr/bin/env bash
+set +e
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return 0
+}
+
+definition=/tmp/audit-work/build/verification-kompiled
+
+run kast /tmp/audit-work/source/solution.mpy \
+  --definition "$definition" \
+  --module MPY-SYNTAX \
