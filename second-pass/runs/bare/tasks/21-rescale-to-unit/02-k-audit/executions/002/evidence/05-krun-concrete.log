COMMAND: krun solution.mpy --definition semantic-kompiled -cARGS=vlist(1, 2) --output pretty
<python>
  <k>
    .K
  </k>
  <functions>
    "rescale_to_unit" |-> function ( Params ( "numbers" , .Strings ) , Assign ( Name ( "minimum" ) , Call ( Name ( "min" ) , Name ( "numbers" ) ) )  Assign ( Name ( "maximum" ) , Call ( Name ( "max" ) , Name ( "numbers" ) ) )  Return ( ListComp ( BinOp ( "/" , BinOp ( "-" , Name ( "number" ) , Name ( "minimum" ) ) , BinOp ( "-" , Name ( "maximum" ) , Name ( "minimum" ) ) ) , CompFor ( Name ( "number" ) , Name ( "numbers" ) , Bool ( true ) ) ) )  .Stmts )
  </functions>
  <env>
    "maximum" |-> 2
    "minimum" |-> 1
    "numbers" |-> vlist ( 1 , 2 , .Rats )
  </env>
  <result>
    vlist ( 0 , 1 , .Rats )
  </result>
</python>
