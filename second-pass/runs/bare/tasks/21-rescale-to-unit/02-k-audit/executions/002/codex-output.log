+            "claim": 3,
+            "precondition": "A < B",
+            "binding": {"A": -2.0, "B": 6.0},
+            "input": [-2.0, 6.0],
+            "claimed": [0.0, 1.0],
+        },
+        {
+            "claim": 4,
+            "precondition": "A < B and B < C and A < C",
+            "binding": {"A": -2.0, "B": 2.0, "C": 6.0},
+            "input": [-2.0, 2.0, 6.0],
+            "claimed": [0.0, 0.5, 1.0],
+        },
+        {
+            "claim": 5,
+            "precondition": "A < B and B < C and A < C and A != C",
+            "binding": {"A": -2.0, "B": 2.0, "C": 6.0},
+            "input": [-2.0, 2.0, 6.0],
+            "claimed": [0.0, 0.5, 1.0],
