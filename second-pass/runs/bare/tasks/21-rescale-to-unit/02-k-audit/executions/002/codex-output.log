+        trace_pipeline_hash
+        == json.loads(Path("/generation-evidence/usage.json").read_text())[
+            "source_trace_sha256"
+        ]
+    )
+    print("PROVENANCE_CHECK: PASS")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
