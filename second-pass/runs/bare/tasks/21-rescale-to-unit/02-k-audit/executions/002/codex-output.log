     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // Algebraic simplifications needed by the symbolic backend for Rat terms.
     7	  // They are consequences of the RAT domain and are applied only to defined
     8	  // divisions.
     9	  rule R +Rat (-1 *Rat R) => 0 [simplification]
    10	  rule R /Rat R => 1 requires R =/=Rat 0 [simplification]
    11	  rule 0 /Rat R => 0 requires R =/=Rat 0 [simplification]
    12	
    13	  // This is the exact constructor tree generated in solution.mpy.  Keeping it
    14	  // as a function makes the claims readable; prove.sh regenerates and runs the
    15	  // actual solution.mpy before invoking these proofs.
    16	  syntax Program ::= "solutionProgram" [function]
    17	  rule solutionProgram =>
    18	    Module(
    19	      ImportFrom("typing", "List", .Strings)
    20	      FuncDef("rescale_to_unit", Params("numbers", .Strings),
    21	        CellVars("maximum", "minimum", .Strings), FreeVars(.Strings),
    22	        Assign(Name("minimum"), Call(Name("min"), Name("numbers")))
    23	        Assign(Name("maximum"), Call(Name("max"), Name("numbers")))
    24	        Return(
    25	          ListComp(
    26	            BinOp("/",
    27	              BinOp("-", Name("number"), Name("minimum")),
    28	              BinOp("-", Name("maximum"), Name("minimum"))),
    29	            CompFor(Name("number"), Name("numbers"), Bool(true))))
    30	        .Stmts)
    31	      .Stmts)
    32	
    33	  // Proof-only wrapper: execute the ordinary operational semantics, collect
    34	  // the returned value, and restore the auxiliary cells to their initial
    35	  // values.  This lets a claim focus on the observable function result.
    36	  syntax KItem ::= verify(Program, Value) | "collect" | done(Value)
    37	
    38	  rule <k> verify(Module(SS), ARG)
    39	         => exec(SS) ~> invoke("rescale_to_unit", ARG) ~> collect
    40	       </k>
    41	
    42	  rule <k> collect => done(V) </k>
    43	       <functions> _ => .Map </functions>
    44	       <env> _ => .Map </env>
    45	       <result> V => noResult </result>
    46	
    47	  // An independent, mathematical statement of the contract.  It uses only
    48	  // minimum, maximum, and pointwise affine scaling over exact rationals.
    49	  syntax Value ::= rescaleSpec(Value) [function]
    50	  syntax Rats ::= scaleRats(Rats, Rat, Rat) [function]
    51	
    52	  rule rescaleSpec(vlist(H, T))
    53	    => vlist(scaleRats(H, T, minRats(H, T), maxRats(H, T)))
    54	
    55	  rule scaleRats(.Rats, _, _) => .Rats
    56	  rule scaleRats(X, XS, LO, HI)
    57	    => ((X -Rat LO) /Rat (HI -Rat LO)), scaleRats(XS, LO, HI)
    58	    requires HI =/=Rat LO
    59	endmodule
