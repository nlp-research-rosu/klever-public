+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.rescale_to_unit
+
+
+def main() -> int:
+    submitted = load(Path("/candidate/solution.py"))
+    canonical = load(Path("/reference/canonical.py"))
+    witnesses = [
