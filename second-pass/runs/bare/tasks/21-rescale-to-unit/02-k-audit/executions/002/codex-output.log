     1	requires "rat.md"
     2	
     3	// A deliberately small semantics for the pure-Python fragment used by
     4	// solution.mpy.  Python numeric values are interpreted as exact rationals.
     5	// This removes irrelevant IEEE-754 rounding from the functional proof while
     6	// retaining the meaning of +, -, ordering, min, max, and division.
     7	module MPY-SYNTAX
     8	  imports RAT-SYNTAX
     9	  imports BOOL
    10	  imports MAP
    11	  imports STRING
    12	
    13	  syntax Program ::= "Module" "(" Stmts ")"
    14	
    15	  syntax Stmts ::= List{Stmt, ""}
    16	  syntax Strings ::= List{String, ","}
    17	
    18	  syntax Params ::= "Params" "(" Strings ")"
    19	  syntax CellVars ::= "CellVars" "(" Strings ")"
    20	  syntax FreeVars ::= "FreeVars" "(" Strings ")"
    21	
    22	  syntax Stmt ::= "ImportFrom" "(" String "," Strings ")"
    23	                | "FuncDef" "(" String "," Params "," CellVars "," FreeVars "," Stmts ")"
    24	                | "Assign" "(" Expr "," Expr ")"
    25	                | "Return" "(" Expr ")"
    26	
    27	  syntax Expr ::= "Name" "(" String ")"
    28	                | "Call" "(" Expr "," Expr ")"
    29	                | "BinOp" "(" String "," Expr "," Expr ")"
    30	                | "ListComp" "(" Expr "," CompFor ")"
    31	                | "Bool" "(" Bool ")"
    32	
    33	  syntax CompFor ::= "CompFor" "(" Expr "," Expr "," Expr ")"
    34	
    35	  // Runtime input/output values.  vlist is a list of exact real (rational)
    36	  // numbers.  For example, vlist(1, 2, 3) models Python [1.0, 2.0, 3.0].
    37	  syntax Rats ::= List{Rat, ","}
    38	  syntax Value ::= Rat
    39	                 | "vlist" "(" Rats ")"
    40	                 | "noResult"
    41	
    42	  syntax Definition ::= "function" "(" Params "," Stmts ")"
    43	endmodule
    44	
    45	module SEMANTIC
    46	  imports MPY-SYNTAX
    47	  imports RAT
    48	
    49	  configuration
    50	    <python>
    51	      <k> boot($PGM:Program, $ARGS:Value) </k>
    52	      <functions> .Map </functions>
    53	      <env> .Map </env>
    54	      <result> noResult </result>
    55	    </python>
    56	
    57	  syntax KItem ::= boot(Program, Value)
    58	                 | exec(Stmts)
    59	                 | invoke(String, Value)
    60	
    61	  // Loading a module registers its definitions before invoking the requested
    62	  // HumanEval entry point.  ImportFrom has no runtime effect because type
    63	  // annotations have already been erased by the supplied AST translator.
    64	  rule <k> boot(Module(SS), ARG) => exec(SS) ~> invoke("rescale_to_unit", ARG) </k>
    65	
    66	  rule <k> exec(.Stmts) => .K ... </k>
    67	  rule <k> exec(ImportFrom(_, _) SS) => exec(SS) ... </k>
    68	
    69	  rule <k> exec(FuncDef(NAME, PARAMS, _, _, BODY) SS) => exec(SS) ... </k>
    70	       <functions> FS => FS [ NAME <- function(PARAMS, BODY) ] </functions>
    71	
    72	  rule <k> invoke(NAME, ARG) => exec(BODY) ... </k>
    73	       <functions> ... NAME |-> function(Params(PARAM, .Strings), BODY) ... </functions>
    74	       <env> _ => PARAM |-> ARG </env>
    75	
    76	  rule <k> exec(Assign(Name(NAME), E) SS) => exec(SS) ... </k>
    77	       <env> ENV => ENV [ NAME <- eval(E, ENV) ] </env>
    78	
    79	  rule <k> exec(Return(E) _) => .K ... </k>
    80	       <env> ENV </env>
    81	       <result> _ => eval(E, ENV) </result>
    82	
    83	  // Expression evaluation is functional: comprehensions use a temporary map
    84	  // binding and therefore cannot mutate the surrounding function environment.
    85	  syntax Value ::= eval(Expr, Map) [function]
    86	                 | evalComp(Expr, String, Value, Map) [function]
    87	                 | prepend(Rat, Value) [function]
    88	
    89	  syntax Rat ::= evalNumber(Expr, Map) [function]
    90	               | minValue(Value) [function]
    91	               | maxValue(Value) [function]
    92	               | minRats(Rat, Rats) [function]
    93	               | maxRats(Rat, Rats) [function]
    94	
    95	  rule eval(Name(NAME), (NAME |-> V:Value) _REST) => V
    96	
    97	  rule eval(Call(Name("min"), E), ENV) => minValue(eval(E, ENV))
    98	  rule eval(Call(Name("max"), E), ENV) => maxValue(eval(E, ENV))
    99	
   100	  rule eval(BinOp(OP, L, R), ENV) => evalNumber(BinOp(OP, L, R), ENV)
   101	
   102	  rule eval(ListComp(E, CompFor(Name(VAR), ITER, _)), ENV)
   103	    => evalComp(E, VAR, eval(ITER, ENV), ENV)
   104	
   105	  rule evalNumber(Name(NAME), (NAME |-> R:Rat) _REST) => R
   106	  rule evalNumber(BinOp("-", L, R), ENV)
   107	    => evalNumber(L, ENV) -Rat evalNumber(R, ENV)
   108	  rule evalNumber(BinOp("/", L, R), ENV)
   109	    => evalNumber(L, ENV) /Rat evalNumber(R, ENV)
   110	
   111	  rule evalComp(_, _, vlist(.Rats), _) => vlist(.Rats)
   112	  rule evalComp(E, VAR, vlist(R, RS), ENV)
   113	    => prepend(evalNumber(E, ENV [ VAR <- R ]),
   114	               evalComp(E, VAR, vlist(RS), ENV))
   115	
   116	  rule prepend(R, vlist(RS)) => vlist(R, RS)
   117	
   118	  rule minValue(vlist(R, RS)) => minRats(R, RS)
   119	  rule maxValue(vlist(R, RS)) => maxRats(R, RS)
   120	
   121	  rule minRats(M, .Rats) => M
   122	  rule minRats(M, R, RS) => minRats(M, RS)
   123	    requires M <Rat R
   124	  rule minRats(M, R, RS) => minRats(M, RS)
   125	    requires M ==Rat R
   126	  rule minRats(M, R, RS) => minRats(R, RS)
   127	    requires M >Rat R
   128	
   129	  rule maxRats(M, .Rats) => M
   130	  rule maxRats(M, R, RS) => maxRats(M, RS)
   131	    requires M >Rat R
   132	  rule maxRats(M, R, RS) => maxRats(M, RS)
   133	    requires M ==Rat R
   134	  rule maxRats(M, R, RS) => maxRats(R, RS)
   135	    requires M <Rat R
   136	endmodule
