     4	def rescale_to_unit(numbers: List[float]) -> List[float]:
     5	    minimum = min(numbers)
     6	    maximum = max(numbers)
     7	    return [
     8	        (number - minimum) / (maximum - minimum)
     9	        for number in numbers
