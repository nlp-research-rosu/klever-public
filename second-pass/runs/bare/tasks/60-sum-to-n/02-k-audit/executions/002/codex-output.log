def calc(root,include_dirs,sortmode,pathprefix,path_suffix,kindmode,between,valuemode,entrysep,trail,include_size,include_mode):
 es=[]
 for p in root.rglob('*'):
  if p.is_file() or (include_dirs and p.is_dir()): es.append(p)
 if sortmode=='rel': es.sort(key=lambda p:p.relative_to(root).as_posix())
 elif sortmode=='dirsfirst': es.sort(key=lambda p:(not p.is_dir(),p.relative_to(root).as_posix()))
 elif sortmode=='filesfirst': es.sort(key=lambda p:(p.is_dir(),p.relative_to(root).as_posix()))
