     1	requires "domains.md"
     2	
     3	module MPY-SYNTAX
     4	  imports INT-SYNTAX
     5	  imports STRING-SYNTAX
     6	
     7	  // Concrete syntax emitted by py2mpy.py for the program subset used here.
     8	  syntax Program ::= "Module" "(" Function ")" [symbol(Module)]
     9	  syntax Function ::= "FuncDef" "(" String "," "Params" "(" String ")" "," Statement ")" [symbol(FuncDef)]
    10	  syntax Statement ::= "Return" "(" Expr ")" [symbol(Return)]
    11	
    12	  syntax Expr ::= "Int" "(" Int ")" [symbol(IntLiteral)]
    13	                | "Name" "(" String ")" [symbol(Name)]
    14	                | "BinOp" "(" String "," Expr "," Expr ")" [symbol(BinOp)]
    15	endmodule
    16	
    17	module MPY
    18	  imports MPY-SYNTAX
    19	  imports INT
    20	  imports STRING
    21	
    22	  syntax KItem ::= "invoke" "(" String "," Int ")" [symbol(invoke)]
    23	                 | "noResult" [symbol(noResult)]
    24	
    25	  syntax Int ::= "evalExpr" "(" Expr "," String "," Int ")" [function]
    26	
    27	  // Expression semantics.  The last two arguments model the single local
    28	  // parameter binding needed by this translated function.
    29	  rule evalExpr(Int(I), _P, _V) => I
    30	  rule evalExpr(Name(P), P, V) => V
    31	  rule evalExpr(BinOp("+", L, R), P, V)
    32	    => evalExpr(L, P, V) +Int evalExpr(R, P, V)
    33	  rule evalExpr(BinOp("*", L, R), P, V)
    34	    => evalExpr(L, P, V) *Int evalExpr(R, P, V)
    35	  rule evalExpr(BinOp("//", L, R), P, V)
    36	    => evalExpr(L, P, V) /Int evalExpr(R, P, V)
    37	
    38	  configuration
    39	    <mpy>
    40	      <k> $PGM:Program ~> invoke($FUNCTION:String, $ARG:Int) </k>
    41	      <result> noResult </result>
    42	    </mpy>
    43	
    44	  rule <k> Module(FuncDef(F, Params(P), Return(E))) ~> invoke(F, V) => .K </k>
    45	       <result> noResult => evalExpr(E, P, V) </result>
    46	endmodule
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Mathematical postcondition used by the proof.  Restricting N to the
     7	  // natural-number domain in spec.k matches "numbers from 1 to n".
     8	  syntax Int ::= "sumSpec" "(" Int ")" [function]
     9	  rule sumSpec(N) => (N *Int (N +Int 1)) /Int 2
    10	endmodule
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  claim
     7	    <k>
     8	      Module(
     9	        FuncDef("sum_to_n", Params("n"),
    10	          Return(
    11	            BinOp("//",
    12	              BinOp("*", Name("n"), BinOp("+", Name("n"), Int(1))),
    13	              Int(2)))))
    14	      ~> invoke("sum_to_n", N)
    15	      => .K
    16	    </k>
    17	    <result> noResult => sumSpec(N) </result>
    18	    requires N >=Int 0
    19	endmodule
COMMAND: nl -ba semantic.k verification.k spec.k
EXIT_STATUS: 0
