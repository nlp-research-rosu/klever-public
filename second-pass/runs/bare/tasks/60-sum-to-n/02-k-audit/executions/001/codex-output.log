diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..af16bf6613f4af7f7196afb32831b43b420e959b
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd -- "$(dirname -- "$0")"
+
+# Recreate the translated artifact from the submitted implementation.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Keep the program term in the symbolic claim tied to the generated artifact.
+python3 - <<'PY'
+import re
+from pathlib import Path
+
+translated = re.sub(r"\s+", "", Path("solution.mpy").read_text())
+specification = Path("spec.k").read_text()
+match = re.search(r"<k>\s*(Module\(.*\))\s*~>\s*invoke\(", specification, re.S)
+assert match is not None, "could not find the claimed program term in spec.k"
+claimed = re.sub(r"\s+", "", match.group(1))
+assert claimed == translated, "spec.k program term differs from solution.mpy"
+PY
+
+# Compile the semantics together with the mathematical specification helper.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX
+
+# Execute all examples from prompt.py using the translated program itself.
+krun solution.mpy --definition verification-kompiled -cFUNCTION='"sum_to_n"' -cARG=30
+krun solution.mpy --definition verification-kompiled -cFUNCTION='"sum_to_n"' -cARG=100
+krun solution.mpy --definition verification-kompiled -cFUNCTION='"sum_to_n"' -cARG=5
+krun solution.mpy --definition verification-kompiled -cFUNCTION='"sum_to_n"' -cARG=10
+krun solution.mpy --definition verification-kompiled -cFUNCTION='"sum_to_n"' -cARG=1
+
+# Prove the symbolic claim for every natural-number input N.
+kprove spec.k --definition verification-kompiled --spec-module SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..bc7d07d7d9d81be143198a88096275c3f183b095
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,46 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  // Concrete syntax emitted by py2mpy.py for the program subset used here.
+  syntax Program ::= "Module" "(" Function ")" [symbol(Module)]
+  syntax Function ::= "FuncDef" "(" String "," "Params" "(" String ")" "," Statement ")" [symbol(FuncDef)]
+  syntax Statement ::= "Return" "(" Expr ")" [symbol(Return)]
+
+  syntax Expr ::= "Int" "(" Int ")" [symbol(IntLiteral)]
+                | "Name" "(" String ")" [symbol(Name)]
+                | "BinOp" "(" String "," Expr "," Expr ")" [symbol(BinOp)]
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports STRING
+
+  syntax KItem ::= "invoke" "(" String "," Int ")" [symbol(invoke)]
+                 | "noResult" [symbol(noResult)]
+
+  syntax Int ::= "evalExpr" "(" Expr "," String "," Int ")" [function]
+
+  // Expression semantics.  The last two arguments model the single local
+  // parameter binding needed by this translated function.
+  rule evalExpr(Int(I), _P, _V) => I
+  rule evalExpr(Name(P), P, V) => V
+  rule evalExpr(BinOp("+", L, R), P, V)
+    => evalExpr(L, P, V) +Int evalExpr(R, P, V)
+  rule evalExpr(BinOp("*", L, R), P, V)
+    => evalExpr(L, P, V) *Int evalExpr(R, P, V)
+  rule evalExpr(BinOp("//", L, R), P, V)
+    => evalExpr(L, P, V) /Int evalExpr(R, P, V)
+
+  configuration
+    <mpy>
+      <k> $PGM:Program ~> invoke($FUNCTION:String, $ARG:Int) </k>
+      <result> noResult </result>
+    </mpy>
+
+  rule <k> Module(FuncDef(F, Params(P), Return(E))) ~> invoke(F, V) => .K </k>
+       <result> noResult => evalExpr(E, P, V) </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..9ca13985ca9ac8b5485b266edf2c0be79587b5f2
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,2 @@
+def sum_to_n(n: int):
+    return n * (n + 1) // 2
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..79f3faea745c7f26843285fa50689ad7995ed8f3
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,19 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim
+    <k>
+      Module(
+        FuncDef("sum_to_n", Params("n"),
+          Return(
+            BinOp("//",
+              BinOp("*", Name("n"), BinOp("+", Name("n"), Int(1))),
+              Int(2)))))
+      ~> invoke("sum_to_n", N)
+      => .K
+    </k>
+    <result> noResult => sumSpec(N) </result>
+    requires N >=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0b383b1a9a77e5599d002f64b3f76a63691d7390
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,10 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical postcondition used by the proof.  Restricting N to the
+  // natural-number domain in spec.k matches "numbers from 1 to n".
+  syntax Int ::= "sumSpec" "(" Int ")" [function]
+  rule sumSpec(N) => (N *Int (N +Int 1)) /Int 2
+endmodule

exec
/bin/bash -lc 'bash -n prove.sh
./prove.sh' in /work
