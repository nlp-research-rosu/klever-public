+requires "verification.k"
+
+module SPEC-FLOOR-UNSOUND
+  imports VERIFICATION
+
+  // False for Python: def probe(n): return -3 // 2 returns -2, not -1.
+  // Input 0 is within the target claim's N >= 0 input domain.
+  claim
+    <k>
+      Module(
+        FuncDef("probe", Params("n"),
+          Return(BinOp("//", Int(-3), Int(2)))))
+      ~> invoke("probe", 0)
+      => .K
+    </k>
+    <result> noResult => -1 </result>
+endmodule
diff --git a/evidence/spec-vacuity-audit.k b/evidence/spec-vacuity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..68b04fae517d9b9df72adddc88abd57d95e6728d
--- /dev/null
+++ b/evidence/spec-vacuity-audit.k
@@ -0,0 +1,21 @@
+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // Deliberately false: at the satisfying witness N = 0, the program returns
+  // sumSpec(0) = 0, not sumSpec(0) + 1 = 1.
+  claim
+    <k>
+      Module(
+        FuncDef("sum_to_n", Params("n"),
+          Return(
+            BinOp("//",
+              BinOp("*", Name("n"), BinOp("+", Name("n"), Int(1))),
+              Int(2)))))
+      ~> invoke("sum_to_n", N)
+      => .K
+    </k>
+    <result> noResult => sumSpec(N) +Int 1 </result>
+    requires N >=Int 0
+endmodule
