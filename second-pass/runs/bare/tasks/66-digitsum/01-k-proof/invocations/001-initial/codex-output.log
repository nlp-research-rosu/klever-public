@@ -0,0 +1,6 @@
+def digitSum(s):
+    total = 0
+    for char in s:
+        if "A" <= char <= "Z":
+            total = total + ord(char)
+    return total
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..7bcb94ad2f1aaabb65b4285e78232b4e5b3388c4
