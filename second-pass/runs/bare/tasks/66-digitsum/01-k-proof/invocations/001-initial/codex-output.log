@@ -0,0 +1,123 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")" [symbol]
+
+  // The translator prints statement sequences by juxtaposition.
+  syntax Stmts ::= List{Stmt, ""}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol]
+                | "Assign" "(" Expr "," Expr ")"                 [symbol]
+                | "For" "(" Expr "," Expr "," Stmts ")"       [symbol]
+                | "If" "(" Expr "," Stmts "," Stmts ")"       [symbol]
+                | "Return" "(" Expr ")"                          [symbol]
+
+  syntax Params ::= "Params" "(" String ")" [symbol]
+
+  syntax Expr ::= "Name" "(" String ")"                          [symbol]
+                | "Int" "(" Int ")"                              [symbol]
+                | "Str" "(" String ")"                           [symbol]
+                | "BinOp" "(" String "," Expr "," Expr ")"     [symbol]
+                | "Call" "(" Expr "," Expr ")"                  [symbol]
+                | "Compare" "(" Expr "," CmpOps ")"             [symbol]
+
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol]
+endmodule
+
+module DIGIT-SUM-SEMANTICS
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports K-EQUAL
+
+  syntax Value ::= "intVal" "(" Int ")"
+                 | "strVal" "(" String ")"
+                 | "boolVal" "(" Bool ")"
+  syntax Result ::= "noResult" | Value
+
+  syntax KItem ::= "execute" "(" Stmts ")"
+                 | "execStmt" "(" Stmt ")"
+                 | "loopString" "(" String "," String "," Stmts ")"
+
+  syntax Value ::= "eval" "(" Expr "," Map ")" [function]
+  syntax Value ::= "addValues" "(" Value "," Value ")" [function]
+                 | "ordValue" "(" Value ")" [function]
+                 | "compareLE3" "(" Value "," Value "," Value ")" [function]
+  syntax String ::= "stringOf" "(" Value ")" [function]
+  syntax Bool ::= "truthOf" "(" Value ")" [function]
+
+  rule eval(Int(I), _) => intVal(I)
+  rule eval(Str(S), _) => strVal(S)
+  rule eval(Name(X), ENV) => {ENV[X]}:>Value
+    requires X in_keys(ENV)
+  rule eval(BinOp("+", LEFT, RIGHT), ENV)
+    => addValues(eval(LEFT, ENV), eval(RIGHT, ENV))
+  rule eval(Call(Name("ord"), ARG), ENV)
+    => ordValue(eval(ARG, ENV))
+  rule eval(Compare(LEFT,
+          CmpOp("<=", MIDDLE) CmpOp("<=", RIGHT)), ENV)
+    => compareLE3(eval(LEFT, ENV), eval(MIDDLE, ENV), eval(RIGHT, ENV))
+
+  rule addValues(intVal(I), intVal(J)) => intVal(I +Int J)
+  rule ordValue(strVal(S)) => intVal(ordChar(S))
+  rule compareLE3(strVal(A), strVal(B), strVal(C))
+    => boolVal((A <=String B) andBool (B <=String C))
+  rule stringOf(strVal(S)) => S
+  rule truthOf(boolVal(B)) => B
+
+  configuration
+    <digit-sum>
+      <k> $PGM:Program </k>
+      <input> $INPUT:String </input>
+      <env> .Map </env>
+      <result> noResult </result>
+    </digit-sum>
+
+  // Loading the one-argument definition binds the supplied input as Python
+  // would, then executes the function body.
+  rule <k> Module(FuncDef("digitSum", Params("s"), BODY))
+            => execute(BODY) ... </k>
+       <input> S </input>
+       <env> .Map => "s" |-> strVal(S) </env>
+
+  rule <k> execute(.Stmts) => . ... </k>
+  rule <k> execute(S SS) => execStmt(S) ~> execute(SS) ... </k>
+
+  rule <k> execStmt(Assign(Name(X), E)) => . ... </k>
+       <env> ENV => ENV[X <- eval(E, ENV)] </env>
+
+  rule <k> execStmt(If(E, THEN, _ELSE)) => execute(THEN) ... </k>
+       <env> ENV </env>
+    requires truthOf(eval(E, ENV))
+  rule <k> execStmt(If(E, _THEN, ELSE)) => execute(ELSE) ... </k>
+       <env> ENV </env>
+    requires notBool truthOf(eval(E, ENV))
+
+  rule <k> execStmt(For(Name(X), ITER, BODY))
+            => loopString(X, stringOf(eval(ITER, ENV)), BODY) ... </k>
+       <env> ENV </env>
+
+  rule <k> loopString(_X, "", _BODY) => . ... </k>
+  rule <k> loopString(X, S, BODY)
+            => execute(BODY)
+            ~> loopString(X,
+                 substrString(S, 1, lengthString(S)), BODY) ... </k>
+       <env> ENV
+              => ENV[X <- strVal(substrString(S, 0, 1))]
+       </env>
+    requires lengthString(S) >Int 0
+
+  rule <k> execStmt(Return(E)) ~> _REST => .K </k>
+       <env> ENV </env>
+       <result> noResult => eval(E, ENV) </result>
+endmodule
+
+module SEMANTIC
+  imports DIGIT-SUM-SEMANTICS
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..a68f7cad57dd497bbfa4e4d6eab48b73f3b8d783
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def digitSum(s):
+    total = 0
+    for char in s:
+        if "A" <= char <= "Z":
+            total = total + ord(char)
+    return total
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0aa5a8fa906fad503c7e5a95de9bd0ed63cc8451
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,21 @@
+module DIGIT-SUM-VERIFICATION
+  imports INT
+  imports BOOL
+  imports STRING
+
+  // Independent mathematical contract: recursively sum exactly the code
+  // points in the inclusive ASCII uppercase interval [65, 90].
+  syntax Int ::= "upperAsciiSum" "(" String ")" [function]
+               | "upperAsciiContribution" "(" String ")" [function]
+
+  rule upperAsciiSum("") => 0
+  rule upperAsciiSum(S)
+    => upperAsciiContribution(substrString(S, 0, 1))
+       +Int upperAsciiSum(substrString(S, 1, lengthString(S)))
+    requires lengthString(S) >Int 0
+
+  rule upperAsciiContribution(C) => ordChar(C)
+    requires ordChar(C) >=Int 65 andBool ordChar(C) <=Int 90
+  rule upperAsciiContribution(C) => 0
+    requires ordChar(C) <Int 65 orBool ordChar(C) >Int 90
+endmodule

apply patch
