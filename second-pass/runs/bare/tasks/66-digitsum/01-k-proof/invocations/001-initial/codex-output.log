+        <result> noResult => intVal(upperAsciiSum(S)) </result>
+
+  // Loop invariant: with accumulator A and unprocessed suffix S, execution
+  // returns A plus the contract value of S. FRAME holds unrelated locals.
+  claim <k>
+          loopString("char", S:String,
+            If(Compare(Str("A"),
+                 CmpOp("<=", Name("char")), CmpOp("<=", Str("Z"))),
+               Assign(Name("total"),
+                 BinOp("+", Name("total"),
+                   Call(Name("ord"), Name("char")))),
+               .Stmts)
+            .Stmts)
+          ~> execute(Return(Name("total")) .Stmts)
+          ~> .K
+          => .K
+        </k>
+        <input> INPUT:String => INPUT:String </input>
+        <env>
+          ("total" |-> intVal(A:Int)) FRAME:Map
+          => .Map
+        </env>
+        <result>
+          noResult => intVal(A +Int upperAsciiSum(S))
+        </result>
+    requires notBool ("total" in_keys(FRAME))
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..fe17b9e8587732061a2bde1065c143b088d5e768
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,23 @@
+module DIGIT-SUM-VERIFICATION
+  imports INT
+  imports BOOL
+  imports STRING
+  imports K-EQUAL
+
+  // Independent mathematical contract: recursively sum exactly the code
+  // points in the inclusive ASCII uppercase interval [65, 90].
+  syntax Int ::= "upperAsciiSum" "(" String ")" [function]
+               | "upperAsciiContribution" "(" String ")" [function]
+
+  rule upperAsciiSum("") => 0
+  rule upperAsciiSum(S)
+    => upperAsciiContribution(substrString(S, 0, 1))
+       +Int upperAsciiSum(substrString(S, 1, lengthString(S)))
+    requires S =/=String ""
+
+  rule upperAsciiContribution(C)
+    => #if ordChar(C) >=Int 65 andBool ordChar(C) <=Int 90
+       #then ordChar(C)
+       #else 0
+       #fi
+endmodule

