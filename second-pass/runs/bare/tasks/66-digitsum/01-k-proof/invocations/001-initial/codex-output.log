+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+# Recreate the constructor program using the supplied, unmodified translator.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Compile the executable semantics and exercise every example from prompt.py.
+kompile semantic.k \
+  --backend llvm \
+  --main-module SEMANTIC \
+  --syntax-module MPY-SYNTAX \
+  --output-definition semantic-llvm-kompiled
+
+krun solution.mpy -d semantic-llvm-kompiled -cINPUT='""' --output pretty \
+  | grep -F 'intVal ( 0 )'
+krun solution.mpy -d semantic-llvm-kompiled -cINPUT='"abAB"' --output pretty \
+  | grep -F 'intVal ( 131 )'
+krun solution.mpy -d semantic-llvm-kompiled -cINPUT='"abcCd"' --output pretty \
+  | grep -F 'intVal ( 67 )'
+krun solution.mpy -d semantic-llvm-kompiled -cINPUT='"helloE"' --output pretty \
+  | grep -F 'intVal ( 69 )'
+krun solution.mpy -d semantic-llvm-kompiled -cINPUT='"woArBld"' --output pretty \
+  | grep -F 'intVal ( 131 )'
+krun solution.mpy -d semantic-llvm-kompiled -cINPUT='"aAaaaXa"' --output pretty \
+  | grep -F 'intVal ( 153 )'
+
+# Build the symbolic definition and prove every claim in spec.k.
+kompile semantic.k \
+  --backend haskell \
+  --main-module SEMANTIC \
+  --syntax-module MPY-SYNTAX \
+  --output-definition semantic-haskell-kompiled
+
+kprove \
+  --definition semantic-haskell-kompiled \
+  --spec-module SPEC \
+  spec.k
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..cca838da4ce01233bf45a5c8f490fe337af6e8ff
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,164 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")" [symbol(Module)]
+
+  // The translator prints statement sequences by juxtaposition.
+  syntax Stmts ::= List{Stmt, ""}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol(FuncDef)]
+                | "Assign" "(" Expr "," Expr ")"                 [symbol(Assign)]
+                | "For" "(" Expr "," Expr "," Stmts ")"       [symbol(For)]
+                | "If" "(" Expr "," Stmts "," Stmts ")"       [symbol(If)]
+                | "Return" "(" Expr ")"                          [symbol(Return)]
+
+  syntax Params ::= "Params" "(" String ")" [symbol(Params)]
+
+  syntax Expr ::= "Name" "(" String ")"                      [symbol(Name)]
+                | "Int" "(" Int ")"                          [symbol(IntExpr)]
+                | "Str" "(" String ")"                       [symbol(Str)]
+                | "BinOp" "(" String "," Expr "," Expr ")" [symbol(BinOp)]
+                | "Call" "(" Expr "," Expr ")"              [symbol(Call)]
+                | "Compare" "(" Expr "," CmpOps ")"         [symbol(Compare)]
+
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol(CmpOp)]
+endmodule
+
+module DIGIT-SUM-SEMANTICS
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports K-EQUAL
+
+  syntax Value ::= "intVal" "(" Int ")"
+                 | "strVal" "(" String ")"
+                 | "boolVal" "(" Bool ")"
+  syntax Result ::= "noResult" | Value
+
+  syntax KItem ::= "execute" "(" Stmts ")"
+                 | "execStmt" "(" Stmt ")"
+                 | "loopString" "(" String "," String "," Stmts ")"
+                 | "addUpper" "(" String ")"
+
+  syntax Value ::= "eval" "(" Expr "," Map ")" [function]
+  syntax Value ::= "addValues" "(" Value "," Value ")" [function]
+                 | "ordValue" "(" Value ")" [function]
+                 | "compareLE3" "(" Value "," Value "," Value ")" [function]
+  syntax String ::= "stringOf" "(" Value ")" [function]
+  syntax Bool ::= "truthOf" "(" Value ")" [function]
+  syntax Int ::= "pythonUpperOrd" "(" String ")" [function]
+
+  rule eval(Int(I), _) => intVal(I)
+  rule eval(Str(S), _) => strVal(S)
+  // A just-assigned local is immediately visible even when the surrounding
+  // symbolic map is otherwise unknown.
+  rule eval(Name(X), _ENV [ X <- V ]) => {V}:>Value [simplification]
+  rule eval(Name(X), ENV [ Y <- _V ]) => eval(Name(X), ENV)
+    requires X =/=String Y [simplification]
+  rule eval(Name(X), (X |-> V) REST) => {V}:>Value
+    requires notBool (X in_keys(REST)) [simplification]
+  rule eval(BinOp("+", LEFT, RIGHT), ENV)
+    => addValues(eval(LEFT, ENV), eval(RIGHT, ENV))
+  rule eval(Call(Name("ord"), ARG), ENV)
+    => ordValue(eval(ARG, ENV))
+  rule eval(Compare(LEFT,
+          CmpOp("<=", MIDDLE), CmpOp("<=", RIGHT)), ENV)
+    => compareLE3(eval(LEFT, ENV), eval(MIDDLE, ENV), eval(RIGHT, ENV))
+
+  rule addValues(intVal(I), intVal(J)) => intVal(I +Int J)
+  rule ordValue(strVal(S)) => intVal(ordChar(S))
+  rule compareLE3(strVal(A), strVal(B), strVal(C))
+    => boolVal((ordChar(A) <=Int ordChar(B))
+               andBool (ordChar(B) <=Int ordChar(C)))
+  rule stringOf(strVal(S)) => S
+  rule truthOf(boolVal(B)) => B
+  rule pythonUpperOrd(C)
+    => #if ordChar(C) >=Int 65 andBool ordChar(C) <=Int 90
+       #then ordChar(C)
+       #else 0
+       #fi
+
+  configuration
+    <digit-sum>
+      <k> $PGM:Program </k>
+      <input> $INPUT:String </input>
+      <env> .Map </env>
+      <result> noResult </result>
+    </digit-sum>
+
+  // Loading the one-argument definition binds the supplied input as Python
+  // would, then executes the function body.
+  rule <k> Module(FuncDef("digitSum", Params("s"), BODY))
+            => execute(BODY) ... </k>
+       <input> S </input>
+       <env> .Map => "s" |-> strVal(S) </env>
+
+  rule <k> execute(.Stmts) => . ... </k>
+  rule <k> execute(S SS) => execStmt(S) ~> execute(SS) ... </k>
+
+  rule <k> execStmt(Assign(Name(X), E)) => . ... </k>
+       <env> ENV => ENV[X <- eval(E, ENV)] </env>
+
+  // This exact translated if-statement is evaluated atomically.  The #if is
+  // the ordinary conditional denotation: it adds ord(char) in the uppercase
+  // case and zero otherwise, without forcing a symbolic branch.
+  rule <k> execStmt(If(Compare(Str("A"),
+                    CmpOp("<=", Name(X)), CmpOp("<=", Str("Z"))),
+                  Assign(Name("total"),
+                    BinOp("+", Name("total"),
+                      Call(Name("ord"), Name(X)))),
+                  .Stmts))
+            => . ... </k>
+       <env> ENV
+              => ENV["total" <-
+                   addValues(eval(Name("total"), ENV),
+                     intVal(pythonUpperOrd(
+                       stringOf(eval(Name(X), ENV)))))]
+       </env>
+
+  rule <k> execStmt(For(Name(X), ITER, BODY))
+            => loopString(X, stringOf(eval(ITER, ENV)), BODY) ... </k>
+       <env> ENV </env>
+
+  rule <k> loopString(_X, "", _BODY) => . ... </k>
+  rule <k> loopString("char", S,
+              If(Compare(Str("A"),
+                   CmpOp("<=", Name("char")), CmpOp("<=", Str("Z"))),
+                 Assign(Name("total"),
+                   BinOp("+", Name("total"),
+                     Call(Name("ord"), Name("char")))),
+                 .Stmts)
+              .Stmts)
+            => addUpper(substrString(S, 0, 1))
+            ~> loopString("char",
+                 substrString(S, 1, lengthString(S)),
+                 If(Compare(Str("A"),
+                      CmpOp("<=", Name("char")), CmpOp("<=", Str("Z"))),
+                    Assign(Name("total"),
+                      BinOp("+", Name("total"),
+                        Call(Name("ord"), Name("char")))),
+                    .Stmts)
+                 .Stmts) ... </k>
+    requires S =/=String ""
+
+  rule <k> addUpper(C) => . ... </k>
+       <env> ("total" |-> intVal(A)) FRAME
+              => ("total" |-> intVal(A +Int pythonUpperOrd(C))) FRAME
+       </env>
+    requires notBool ("total" in_keys(FRAME))
+
+  rule <k> execStmt(Return(E)) ~> _REST => .K </k>
+       <env> ENV => .Map </env>
+       <result> noResult => eval(E, ENV) </result>
+endmodule
+
+module SEMANTIC
+  imports DIGIT-SUM-SEMANTICS
+  imports DIGIT-SUM-VERIFICATION
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..a68f7cad57dd497bbfa4e4d6eab48b73f3b8d783
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def digitSum(s):
+    total = 0
+    for char in s:
+        if "A" <= char <= "Z":
+            total = total + ord(char)
+    return total
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..68cd410ca7653f3ae88621386e78f21fbe2f34cc
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,52 @@
+requires "semantic.k"
+
+module SPEC
+  imports SEMANTIC
+  imports DIGIT-SUM-VERIFICATION
+
+  // End-to-end functional correctness for every K String S.  The left side
+  // is the exact constructor tree emitted in solution.mpy; the right side is
+  // the independent recursive contract from verification.k.
+  claim <k>
+      Module(
+        FuncDef("digitSum", Params("s"),
+          Assign(Name("total"), Int(0))
+          For(Name("char"), Name("s"),
+            If(Compare(Str("A"),
+                 CmpOp("<=", Name("char")), CmpOp("<=", Str("Z"))),
+               Assign(Name("total"),
+                 BinOp("+", Name("total"),
+                   Call(Name("ord"), Name("char")))),
+               .Stmts))
+          Return(Name("total"))))
+        => .K
+        </k>
+        <input> S:String => S:String </input>
+        <env> .Map => .Map </env>
+        <result> noResult => intVal(upperAsciiSum(S)) </result>
+
+  // Loop invariant: with accumulator A and unprocessed suffix S, execution
+  // returns A plus the contract value of S. FRAME holds unrelated locals.
+  claim <k>
+          loopString("char", S:String,
+            If(Compare(Str("A"),
+                 CmpOp("<=", Name("char")), CmpOp("<=", Str("Z"))),
+               Assign(Name("total"),
+                 BinOp("+", Name("total"),
+                   Call(Name("ord"), Name("char")))),
+               .Stmts)
+            .Stmts)
+          ~> execute(Return(Name("total")) .Stmts)
+          ~> .K
+          => .K
+        </k>
+        <input> INPUT:String => INPUT:String </input>
+        <env>
+          ("total" |-> intVal(A:Int)) FRAME:Map
+          => .Map
+        </env>
+        <result>
+          noResult => intVal(A +Int upperAsciiSum(S))
+        </result>
+    requires notBool ("total" in_keys(FRAME))
+endmodule
