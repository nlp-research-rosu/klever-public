diff --git a//tmp/audit-work/66-digitsum-audit/claim-program.mpy b//tmp/audit-work/66-digitsum-audit/claim-program.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..fd7cccea1b0325a51ebec496612e8a52e25d1ceb
--- /dev/null
+++ b//tmp/audit-work/66-digitsum-audit/claim-program.mpy
@@ -0,0 +1,11 @@
+Module(
+  FuncDef("digitSum", Params("s"),
+    Assign(Name("total"), Int(0))
+    For(Name("char"), Name("s"),
+      If(Compare(Str("A"),
+           CmpOp("<=", Name("char")), CmpOp("<=", Str("Z"))),
+         Assign(Name("total"),
+           BinOp("+", Name("total"),
+             Call(Name("ord"), Name("char")))),
+         .Stmts))
+    Return(Name("total"))))
