diff --git a//tmp/audit-work/66-digitsum-audit/spec-body-mutation.k b//tmp/audit-work/66-digitsum-audit/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..64701de7e2c09d115233f4f9525e67cec054c785
--- /dev/null
+++ b//tmp/audit-work/66-digitsum-audit/spec-body-mutation.k
@@ -0,0 +1,48 @@
+requires "semantic.k"
+
+module SPEC-BODY-MUTATION
+  imports SEMANTIC
+  imports DIGIT-SUM-VERIFICATION
+
+  // Material mutation of the actual constructor term: initialize total to 1.
+  claim <k>
+      Module(
+        FuncDef("digitSum", Params("s"),
+          Assign(Name("total"), Int(1))
+          For(Name("char"), Name("s"),
+            If(Compare(Str("A"),
+                 CmpOp("<=", Name("char")), CmpOp("<=", Str("Z"))),
+               Assign(Name("total"),
+                 BinOp("+", Name("total"),
+                   Call(Name("ord"), Name("char")))),
+               .Stmts))
+          Return(Name("total"))))
+        => .K
+        </k>
+        <input> S:String => S:String </input>
+        <env> .Map => .Map </env>
+        <result> noResult => intVal(upperAsciiSum(S)) </result>
+
+  claim <k>
+          loopString("char", S:String,
+            If(Compare(Str("A"),
+                 CmpOp("<=", Name("char")), CmpOp("<=", Str("Z"))),
+               Assign(Name("total"),
+                 BinOp("+", Name("total"),
+                   Call(Name("ord"), Name("char")))),
+               .Stmts)
+            .Stmts)
+          ~> execute(Return(Name("total")) .Stmts)
+          ~> .K
+          => .K
+        </k>
+        <input> INPUT:String => INPUT:String </input>
+        <env>
+          ("total" |-> intVal(A:Int)) FRAME:Map
+          => .Map
+        </env>
+        <result>
+          noResult => intVal(A +Int upperAsciiSum(S))
+        </result>
+    requires notBool ("total" in_keys(FRAME))
+endmodule
