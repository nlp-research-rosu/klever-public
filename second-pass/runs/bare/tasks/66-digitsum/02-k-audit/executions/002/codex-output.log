diff --git a//tmp/audit-work/66-digitsum-audit/spec-labeled.k b//tmp/audit-work/66-digitsum-audit/spec-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..6e3b6efb465ca2256f613b6de478bb8926d50eb1
--- /dev/null
+++ b//tmp/audit-work/66-digitsum-audit/spec-labeled.k
@@ -0,0 +1,49 @@
+requires "semantic.k"
+
+module SPEC-LABELED
+  imports SEMANTIC
+  imports DIGIT-SUM-VERIFICATION
+
+  claim <k>
+      Module(
+        FuncDef("digitSum", Params("s"),
+          Assign(Name("total"), Int(0))
+          For(Name("char"), Name("s"),
+            If(Compare(Str("A"),
+                 CmpOp("<=", Name("char")), CmpOp("<=", Str("Z"))),
+               Assign(Name("total"),
+                 BinOp("+", Name("total"),
+                   Call(Name("ord"), Name("char")))),
+               .Stmts))
+          Return(Name("total"))))
+        => .K
+        </k>
+        <input> S:String => S:String </input>
+        <env> .Map => .Map </env>
+        <result> noResult => intVal(upperAsciiSum(S)) </result>
+    [label(entry)]
+
+  claim <k>
+          loopString("char", S:String,
+            If(Compare(Str("A"),
+                 CmpOp("<=", Name("char")), CmpOp("<=", Str("Z"))),
+               Assign(Name("total"),
+                 BinOp("+", Name("total"),
+                   Call(Name("ord"), Name("char")))),
+               .Stmts)
+            .Stmts)
+          ~> execute(Return(Name("total")) .Stmts)
+          ~> .K
+          => .K
+        </k>
+        <input> INPUT:String => INPUT:String </input>
+        <env>
+          ("total" |-> intVal(A:Int)) FRAME:Map
+          => .Map
+        </env>
+        <result>
+          noResult => intVal(A +Int upperAsciiSum(S))
+        </result>
+    requires notBool ("total" in_keys(FRAME))
+    [label(loop)]
+endmodule
diff --git a//tmp/audit-work/66-digitsum-audit/spec-loop-only.k b//tmp/audit-work/66-digitsum-audit/spec-loop-only.k
new file mode 100644
index 0000000000000000000000000000000000000000..2ac58712a5c738209a464e54bfe2c6427461f085
--- /dev/null
+++ b//tmp/audit-work/66-digitsum-audit/spec-loop-only.k
@@ -0,0 +1,29 @@
+requires "semantic.k"
+
+module SPEC-LOOP-ONLY
+  imports SEMANTIC
+  imports DIGIT-SUM-VERIFICATION
+
+  claim <k>
+          loopString("char", S:String,
+            If(Compare(Str("A"),
+                 CmpOp("<=", Name("char")), CmpOp("<=", Str("Z"))),
+               Assign(Name("total"),
+                 BinOp("+", Name("total"),
+                   Call(Name("ord"), Name("char")))),
+               .Stmts)
+            .Stmts)
+          ~> execute(Return(Name("total")) .Stmts)
+          ~> .K
+          => .K
+        </k>
+        <input> INPUT:String => INPUT:String </input>
+        <env>
+          ("total" |-> intVal(A:Int)) FRAME:Map
+          => .Map
+        </env>
+        <result>
+          noResult => intVal(A +Int upperAsciiSum(S))
+        </result>
+    requires notBool ("total" in_keys(FRAME))
+endmodule
