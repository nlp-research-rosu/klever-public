# explicit & auditable.  entry point: digitSum


def digitSum(s):
    """Task
    Write a function that takes a string as input and returns the sum of the upper characters only'
    ASCII codes.

    Examples:
        digitSum("") => 0
        digitSum("abAB") => 131
        digitSum("abcCd") => 67
        digitSum("helloE") => 69
        digitSum("woArBld") => 131
        digitSum("aAaaaXa") => 153
    """
    if s == "": return 0
    return sum(ord(char) if char.isupper() else 0 for char in s)

===== candidate solution.py =====
def digitSum(s):
    total = 0
    for char in s:
        if "A" <= char <= "Z":
            total = total + ord(char)
    return total

===== candidate solution.mpy =====
Module(
  FuncDef("digitSum", Params("s"),
    Assign(Name("total"), Int(0))
    For(Name("char"), Name("s"),
      If(Compare(
        Str("A"),
        CmpOp("<=", Name("char")),
        CmpOp("<=", Str("Z"))),
        Assign(
          Name("total"),
          BinOp("+", Name("total"), Call(Name("ord"), Name("char")))),
        ))
    Return(Name("total"))))

