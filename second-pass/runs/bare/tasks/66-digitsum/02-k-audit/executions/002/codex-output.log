audit_entry_status="'${PIPESTATUS[0]}
printf '"'EXIT_STATUS=%s\\n' \""'$audit_entry_status" | tee -a /audit-output/evidence/stage3-kprove-entry.log
exit "$audit_entry_status"' in /tmp/audit-work/66-digitsum-audit
