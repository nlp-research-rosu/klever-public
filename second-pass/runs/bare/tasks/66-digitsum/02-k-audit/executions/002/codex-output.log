/bin/bash -lc "mv /audit-output/evidence/stage5-if-short-circuit-witness.log /audit-output/evidence/stage5-if-short-circuit-witness-attempt2-status-assumption.log
set -o pipefail
{
  printf 'COMMAND: python3 trusted-py2mpy.py if_short_circuit_witness.py > if_short_circuit_witness.mpy\\n'
  python3 trusted-py2mpy.py if_short_circuit_witness.py > if_short_circuit_witness.mpy
  audit_translate_status="'$?
  printf '"'TRANSLATE_EXIT_STATUS=%s\\n' \""'$audit_translate_status"
  printf '"'COMMAND: python3 -c <import witness; print(digitSum(\"\"))>\\n'
  python3 -c 'import if_short_circuit_witness; print(if_short_circuit_witness.digitSum(\"\"))'
  audit_python_status="'$?
  printf '"'PYTHON_EXIT_STATUS=%s\\n' \""'$audit_python_status"
  printf '"'COMMAND: timeout 20 krun if_short_circuit_witness.mpy --definition audit-semantic-haskell-kompiled -cINPUT='\"'\"'\"\"'\"'\"' --output pretty\\n'
  audit_k_output="'$(timeout 20 krun if_short_circuit_witness.mpy --definition audit-semantic-haskell-kompiled -cINPUT='"'\"\"' --output pretty 2>&1)
  audit_k_status="'$?
