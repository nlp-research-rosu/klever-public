@@ -0,0 +1,19 @@
+<digit-sum>
+  <k>
+    loopString("char", "AB",
+      If(Compare(Str("A"),
+           CmpOp("<=", Name("char")), CmpOp("<=", Str("Z"))),
+         Assign(Name("total"),
+           BinOp("+", Name("total"),
+             Call(Name("ord"), Name("char")))),
+         ))
+    ~> execute(Return(Name("total")))
+    ~> .K
+  </k>
+  <input> "witness-input" </input>
+  <env>
+    ("total" |-> intVal(7))
+    ("other" |-> intVal(99))
+  </env>
+  <result> noResult </result>
+</digit-sum>
