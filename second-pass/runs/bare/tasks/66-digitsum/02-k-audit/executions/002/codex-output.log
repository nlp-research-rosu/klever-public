/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import hashlib,itertools,stat
roots=[(Path('/candidate'),'c37be4acdd2e7a172aeb4f7142e2d19b54d81cb7ec323ed98ef4d8eaf5cc2c75'),(Path('/generation-evidence/codex-trace'),'3e676e570c6d5b6f543ed1d089894b0ac265cdf2b6a36db9ff7159ff5a1dcd73')]
# Try the same simple per-file recipe against both roots.
def entries(root, dirs):
 ps=sorted(root.rglob('*')) if dirs else sorted(p for p in root.rglob('*') if p.is_file())
 return ps
for dirs in [False,True]:
 for relstyle in ['rel','dotrel','abs']:
  for fieldset in [('path','data'),('path','bindigest'),('path','hexdigest'),('path','size','data'),('path','size','bindigest'),('kind','path','data'),('kind','path','size','data'),('mode','path','size','data')]:
   for sep in [b'',b'\\0',b'\\n',b' ']:
    vals=[]
    for root,expected in roots:
     h=hashlib.sha256()
     for p in entries(root,dirs):
      isf=p.is_file()
      rel=p.relative_to(root).as_posix()
      path={'rel':rel,'dotrel':'./'+rel,'abs':str(p)}[relstyle].encode()
      fields=[]
      for f in fieldset:
       if f=='path': fields.append(path)
       elif f=='kind': fields.append((b'file' if isf else b'directory'))
       elif f=='mode': fields.append(oct(p.stat().st_mode & 0o777).encode())
       elif f=='size': fields.append(str(p.stat().st_size).encode() if isf else b'0')
       elif f=='data': fields.append(p.read_bytes() if isf else b'')
       elif f=='bindigest': fields.append(hashlib.sha256(p.read_bytes()).digest() if isf else b'')
       elif f=='hexdigest': fields.append(hashlib.sha256(p.read_bytes()).hexdigest().encode() if isf else b'')
      h.update(sep.join(fields)+sep)
     vals.append(h.hexdigest()==expected)
    if all(vals): print('MATCH',dirs,relstyle,fieldset,sep)
PY" in /audit-output
