+requires "semantic.k"
+
+module SPEC-ENTRY
+  imports SEMANTIC
+  imports DIGIT-SUM-VERIFICATION
+
+  claim [entry]:
+        <k>
+        Module(
+          FuncDef("digitSum", Params("s"),
