+  --dry-run
+
+# Expected semantic failure: a stuck final result obligation, not a parser,
+# import, compilation, timeout, or unrelated crash.
+run timeout 180s kprove spec-vacuity.k \
+  --definition audit-proof-haskell-kompiled \
