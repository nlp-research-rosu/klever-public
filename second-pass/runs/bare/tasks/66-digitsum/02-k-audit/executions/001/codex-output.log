index 0000000000000000000000000000000000000000..8a807cea3de0ffd329e008ad3d6eeafbf325010d
--- /dev/null
+++ b/evidence/loop_binding_witness.py
@@ -0,0 +1,7 @@
+def digitSum(s):
+    total = 0
+    char = "B"
+    for char in s:
+        if "A" <= char <= "Z":
+            total = total + ord(char)
+    return ord(char)
