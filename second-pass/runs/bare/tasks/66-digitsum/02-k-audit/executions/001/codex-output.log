+
+def main() -> int:
+    config = json.loads(INPUTS_PATH.read_text(encoding="utf-8"))
+    canonical = load_module("trusted_humaneval_66", CANONICAL_PATH)
+    candidate = load_module("submitted_solution", CANDIDATE_PATH)
