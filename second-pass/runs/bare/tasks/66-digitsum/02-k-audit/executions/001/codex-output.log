+| Y22 | `semantic.k:44` | `KItem ::= execute(Stmts)` | yes |
+| Y23 | `semantic.k:45` | `KItem ::= execStmt(Stmt)` | yes |
+| Y24 | `semantic.k:46` | `KItem ::= loopString(String,String,Stmts)` | yes |
