+run_case "Z" 90
+run_case "[" 0
+run_case '`' 0
+run_case "a" 0
+run_case "A@Z[" 155
+run_case "É" 0
+run_case "Ω" 0
+run_case "𐐀" 0
+run_case "aÉZΩ" 90
