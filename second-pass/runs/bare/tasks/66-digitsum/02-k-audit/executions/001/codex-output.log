diff --git a/evidence/spec-labeled.k b/evidence/spec-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..0baf93ff4ab5dcb6e52890060192666fedb980be
--- /dev/null
+++ b/evidence/spec-labeled.k
@@ -0,0 +1,49 @@
+requires "semantic.k"
+
+module SPEC-LABELED
+  imports SEMANTIC
+  imports DIGIT-SUM-VERIFICATION
+
+  claim [entry]:
+        <k>
+        Module(
+          FuncDef("digitSum", Params("s"),
+            Assign(Name("total"), Int(0))
+            For(Name("char"), Name("s"),
+              If(Compare(Str("A"),
+                   CmpOp("<=", Name("char")), CmpOp("<=", Str("Z"))),
+                 Assign(Name("total"),
+                   BinOp("+", Name("total"),
+                     Call(Name("ord"), Name("char")))),
+                 .Stmts))
+            Return(Name("total"))))
+          => .K
+          </k>
+          <input> S:String => S:String </input>
+          <env> .Map => .Map </env>
+          <result> noResult => intVal(upperAsciiSum(S)) </result>
+
+  claim [loop]:
+        <k>
+            loopString("char", S:String,
+              If(Compare(Str("A"),
+                   CmpOp("<=", Name("char")), CmpOp("<=", Str("Z"))),
+                 Assign(Name("total"),
+                   BinOp("+", Name("total"),
+                     Call(Name("ord"), Name("char")))),
+                 .Stmts)
+              .Stmts)
+            ~> execute(Return(Name("total")) .Stmts)
+            ~> .K
+            => .K
+          </k>
+          <input> INPUT:String => INPUT:String </input>
+          <env>
+            ("total" |-> intVal(A:Int)) FRAME:Map
+            => .Map
