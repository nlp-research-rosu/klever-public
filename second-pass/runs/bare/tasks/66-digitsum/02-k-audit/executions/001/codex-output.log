+    print(f"mismatch_count={len(mismatches)}")
+    for value, expected, actual in mismatches[:50]:
+        print(
+            "MISMATCH "
+            + json.dumps(
+                {
+                    "input": value,
+                    "codepoints": [ord(ch) for ch in value],
+                    "canonical": expected,
+                    "candidate": actual,
+                },
+                ensure_ascii=True,
+                sort_keys=True,
+            )
+        )
+    if len(mismatches) > 50:
+        print(f"mismatches_omitted={len(mismatches) - 50}")
