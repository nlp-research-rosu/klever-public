--- /dev/null
+++ b/evidence/claimed-program.mpy
@@ -0,0 +1,13 @@
+Module(
+  FuncDef("digitSum", Params("s"),
+    Assign(Name("total"), Int(0))
+    For(Name("char"), Name("s"),
+      If(Compare(
+        Str("A"),
+        CmpOp("<=", Name("char")),
+        CmpOp("<=", Str("Z"))),
+        Assign(
+          Name("total"),
+          BinOp("+", Name("total"), Call(Name("ord"), Name("char")))),
+        ))
+    Return(Name("total"))))
