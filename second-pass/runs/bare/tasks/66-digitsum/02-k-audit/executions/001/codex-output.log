--- /dev/null
+++ b/evidence/loop_binding_witness.py
@@ -0,0 +1,7 @@
+def digitSum(s):
+    total = 0
+    char = "B"
+    for char in s:
+        if "A" <= char <= "Z":
+            total = total + ord(char)
+    return ord(char)
