LINE 84 custom_tool_call: exec const patch = "*** Begin Patch\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module VERIFICATION\n+  imports MPY\n+\n+  // This macro is deliberately the exact constructor tree emitted in\n+  // solution.mpy. Keeping it here makes the proof talk about the translated\n+  // program rather than a hand-written mathematical stand-in.\n+  syntax Pgm ::= \"solutionProgram\"\n+  syntax Stmts ::= \"solutionFunctions\"\n+  syntax Map ::= \"solutionFuns\"\n+\n+  rule solutionProgram => Module(solutionFunctions) [macro]\n+  rule solutionFuns => #collect(solutionFunctions) [macro]\n+  rule solutionFunctions =>\n+    FuncDef(\"derivative\", Params(\"xs\"),\n+      Return(\n+        Call(\n+          Name(\"derivative_helper\"),\n+          Subscript(Name(\"xs\"), Slice(Int(1), NoBound, NoBound)),\n+          Int(1))))\n+    FuncDef(\"derivative_helper\", Params(\"xs\", \"degree\"),\n+      If(Compare(Name(\"xs\"), CmpOp(\"==\", ListExpr())),\n+        Return(ListExpr()),\n+        Return(\n+          BinOp(\"+\",\n+            ListExpr(\n+              BinOp(\"*\", Name(\"degree\"),\n+                Subscript(Name(\"xs\"), Int(0)))),\n+            Call(\n+              Name(\"derivative_helper\"),\n+              Subscript(Name(\"xs\"), Slice(Int(1), NoBound, NoBound)),\n+              BinOp(\"+\", Name(\"degree\"), Int(1))))))) [macro]\n+\n+  // Mathematical model: IntVals is a finite coefficient sequence. Encoding\n+  // embeds it into runtime values; differentiate multiplies each remaining\n+  // coefficient by its degree.\n+  syntax IntVals ::= List{Int, \",\"}\n+  syntax Values ::= \"#encode\" \"(\" IntVals \")\" [function]\n+                  | \"#differentiate\" \"(\" Int \",\" IntVals \")\" [function]\n+\n+  rule #encode(.IntVals) => .Values\n+  rule #encode((C, CS)) => (IntV(C), #encode(CS))\n+\n+  rule #differentiate(N, .IntVals) => .Values\n+  rule #differentiate(N, (C, CS))\n+    => (IntV(N *Int C), #differentiate(N +Int 1, CS))\n+endmodule\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module SPEC\n+  imports VERIFICATION\n+\n+  // Structural induction theorem for the recursive helper. After one\n+  // nonempty-list step, the remaining obligation is the same claim at the\n+  // tail and successor degree, so kprove closes it by circularity.\n+  claim\n+    <mpy>\n+      <k>\n+        #call(\"derivative_helper\",\n+          (ListV(#encode(CS:IntVals)), IntV(N:Int)),\n+          solutionFuns)\n+        => ListV(#differentiate(N, CS))\n+      </k>\n+    </mpy>\n+    [label(helper-correct)]\n+\n+  // [] and C0 :: CS exhaust all finite coefficient lists. The first\n+  // coefficient is discarded and the helper begins at degree one.\n+  claim\n+    <mpy>\n+      <k>\n+        #run(solutionProgram, ListV(.Values))\n+        => ListV(.Values)\n+      </k>\n+    </mpy>\n+    [label(derivative-empty), depends(helper-correct)]\n+\n+  claim\n+    <mpy>\n+      <k>\n+        #run(solutionProgram,\n+          ListV((IntV(C0:Int), #encode(CS:IntVals))))\n+        => ListV(#differentiate(1, CS))\n+      </k>\n+    </mpy>\n+    [label(derivative-nonempty), depends(helper-correct)]\n+endmodule\n*** End Patch";
