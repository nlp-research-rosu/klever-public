--- /dev/null
+++ b/evidence/run-and-log.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log=$1
+shift
+
+exec > >(tee "$log") 2>&1
+
+printf 'COMMAND:'
+printf ' %q' "$@"
+printf '\n'
+"$@"
+status=$?
+printf 'EXIT_STATUS: %d\n' "$status"
+exit "$status"

exec
/bin/bash -lc 'chmod +x /audit-output/evidence/05_static_inventory.sh /audit-output/evidence/06_non_vacuity.sh
/audit-output/evidence/run-and-log.sh /audit-output/evidence/05_static_inventory.log bash /audit-output/evidence/05_static_inventory.sh
/audit-output/evidence/run-and-log.sh /audit-output/evidence/06_non_vacuity.log bash /audit-output/evidence/06_non_vacuity.sh' in /audit-output
