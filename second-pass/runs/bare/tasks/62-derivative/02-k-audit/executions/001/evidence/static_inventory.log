    43	  // Runtime values. Values is a proper, finite sequence, so ListV is a
    44	  // direct model of a Python list for the fragment used by solution.py.
    45	  syntax Value ::= "IntV" "(" Int ")"
    46	                 | "BoolV" "(" Bool ")"
    47	                 | "StrV" "(" String ")"
    48	                 | "ListV" "(" Values ")"
    49	                 | "NoneV"
    50	  syntax Values ::= List{Value, ","}
    51	
    52	  syntax Closure ::= "closure" "(" Params "," Stmts ")"
    53	  syntax KItem ::= "#prepend" "(" Value ")"
    54	
    55	  // A program is loaded as a map of function closures, then derivative is
    56	  // invoked with the single list supplied in the ARGS configuration cell.
    57	  syntax Value ::= "#run" "(" Pgm "," Value ")" [function]
    58	                 | "#call" "(" String "," Values "," Map ")"
    59	                 | "#exec" "(" Stmts "," Map "," Map ")"
    60	                 | "#choose" "(" Value "," Stmts "," Stmts "," Map "," Map ")" [function]
    61	                 | "#eval" "(" Expr "," Map "," Map ")" [function]
    62	                 | "#bin" "(" String "," Value "," Value ")" [function]
    63	                 | "#equal" "(" Value "," Value ")" [function]
    64	                 | "#head" "(" Value ")" [function]
    65	                 | "#tail" "(" Value ")" [function]
    66	
    67	  syntax Values ::= "#evalArgs" "(" Exprs "," Map "," Map ")" [function]
    68	                  | "#concat" "(" Values ";" Values ")" [function]
    69	  syntax Map ::= "#collect" "(" Stmts ")" [function]
    70	               | "#bind" "(" Params "," Values ")" [function]
    71	
    72	  configuration
    73	    <mpy>
    74	      <k> #run($PGM:Pgm, $ARGS:Value) </k>
