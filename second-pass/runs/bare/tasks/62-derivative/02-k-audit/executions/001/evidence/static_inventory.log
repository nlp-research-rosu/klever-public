    77	  // Module loading and calls.
    78	  rule #run(Module(SS), ARG) => #call("derivative", ARG, #collect(SS))
    79	
    80	  rule #collect(.Stmts) => .Map
    81	  rule #collect(FuncDef(F, PS, BODY) REST)
    82	    => (F |-> closure(PS, BODY)) #collect(REST)
    83	
    84	  rule #bind(Params(.Strs), .Values) => .Map
    85	  rule #bind(Params(X, XS), (V, VS))
