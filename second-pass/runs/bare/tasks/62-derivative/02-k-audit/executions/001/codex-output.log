+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 2
+fi
+
+audit_log=$1
+shift
+
+{
+  printf 'WORKDIR: %q\n' "$PWD"
