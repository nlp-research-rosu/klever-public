+
+  // Deliberately false: the submitted program returns [] on the satisfying
+  // input [], not [1].
+  claim
+    <mpy>
+      <k>
+        #run(solutionProgram, ListV(.Values))
+        => ListV((IntV(1), .Values))
+      </k>
+    </mpy>
