+  printf 'EXIT_STATUS: %d\n' "$audit_status"
+  printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  exit "$audit_status"
+} > >(tee "$audit_log") 2>&1
diff --git a/evidence/solution-program-mutation.mpy b/evidence/solution-program-mutation.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..52728c60af63b6403fb3f23e503fc56f7b0a8045
--- /dev/null
+++ b/evidence/solution-program-mutation.mpy
@@ -0,0 +1,19 @@
+Module(
+  FuncDef("derivative", Params("xs"),
+    Return(
+      Call(
+        Name("derivative_helper"),
+        Subscript(Name("xs"), Slice(Int(1), NoBound, NoBound)),
+        Int(2))))
+  FuncDef("derivative_helper", Params("xs", "degree"),
+    If(Compare(Name("xs"), CmpOp("==", ListExpr())),
+      Return(ListExpr()),
+      Return(
+        BinOp(
+          "+",
+          ListExpr(
+            BinOp("*", Name("degree"), Subscript(Name("xs"), Int(0)))),
+          Call(
+            Name("derivative_helper"),
+            Subscript(Name("xs"), Slice(Int(1), NoBound, NoBound)),
+            BinOp("+", Name("degree"), Int(1))))))))
