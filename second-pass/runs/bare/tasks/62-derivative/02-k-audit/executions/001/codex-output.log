     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // This macro is deliberately the exact constructor tree emitted in
     7	  // solution.mpy. Keeping it here makes the proof talk about the translated
     8	  // program rather than a hand-written mathematical stand-in.
     9	  syntax Pgm ::= "solutionProgram" [macro]
    10	  syntax Stmts ::= "solutionFunctions" [macro]
    11	  syntax Map ::= "solutionFuns" [macro]
    12	
    13	  rule solutionProgram => Module(solutionFunctions)
    14	  rule solutionFuns => #collect(solutionFunctions)
    15	  rule solutionFunctions =>
    16	    FuncDef("derivative", Params("xs"),
    17	      Return(
    18	        Call(
    19	          Name("derivative_helper"),
    20	          Subscript(Name("xs"), Slice(Int(1), NoBound, NoBound)),
    21	          Int(1))))
    22	    FuncDef("derivative_helper", Params("xs", "degree"),
    23	      If(Compare(Name("xs"), CmpOp("==", ListExpr(.Exprs))),
    24	        Return(ListExpr(.Exprs)),
    25	        Return(
    26	          BinOp("+",
    27	            ListExpr(
    28	              BinOp("*", Name("degree"),
    29	                Subscript(Name("xs"), Int(0)))),
    30	            Call(
    31	              Name("derivative_helper"),
    32	              Subscript(Name("xs"), Slice(Int(1), NoBound, NoBound)),
    33	              BinOp("+", Name("degree"), Int(1)))))))
    34	
    35	  // Mathematical model over runtime coefficient sequences. For integer
    36	  // coefficients, #bin("*", IntV(N), C) is exactly N *Int C by semantic.k.
    37	  // Leaving it in this factored form also describes Python's stuck/error
    38	  // behavior outside the supported numeric fragment without assuming a type.
    39	  syntax Values ::= "#differentiate" "(" Int "," Values ")" [function]
    40	
    41	  rule #differentiate(_N, .Values) => .Values
    42	  rule #differentiate(N, (C, CS))
    43	    => (#bin("*", IntV(N), C), #differentiate(N +Int 1, CS))
    44	endmodule

Numbered source: spec.k
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Structural induction theorem for the recursive helper. After one
     7	  // nonempty-list step, the remaining obligation is the same claim at the
     8	  // tail and successor degree, so kprove closes it by circularity.
     9	  claim
    10	    <mpy>
    11	      <k>
    12	        #call("derivative_helper",
    13	          (ListV(CS:Values), IntV(N:Int)),
    14	          solutionFuns)
    15	        ~> K:K
    16	        => ListV(#differentiate(N, CS)) ~> K
    17	      </k>
    18	    </mpy>
    19	    [label(helper-correct)]
    20	
    21	  // [] and C0 :: CS exhaust all finite coefficient lists. The first
    22	  // coefficient is discarded and the helper begins at degree one.
    23	  claim
    24	    <mpy>
    25	      <k>
    26	        #run(solutionProgram, ListV(.Values))
    27	        => ListV(.Values)
    28	      </k>
    29	    </mpy>
    30	    [label(derivative-empty), depends(helper-correct)]
    31	
    32	  claim
    33	    <mpy>
    34	      <k>
    35	        #run(solutionProgram,
    36	          ListV((_C0:Value, CS:Values)))
    37	        => ListV(#differentiate(1, CS))
    38	      </k>
    39	    </mpy>
    40	    [label(derivative-nonempty), depends(helper-correct)]
    41	endmodule

