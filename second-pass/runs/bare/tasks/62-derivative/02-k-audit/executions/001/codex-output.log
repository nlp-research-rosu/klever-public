+cmp "$candidate/py2mpy.py" "$reference/py2mpy.py"
+printf 'translator_cmp=%d\n' "$?"
+sha256sum \
+  "$candidate/prompt.py" "$reference/prompt.py" \
+  "$candidate/py2mpy.py" "$reference/py2mpy.py" \
+  "$candidate/solution.py" "$candidate/solution.mpy" \
