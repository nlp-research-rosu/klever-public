+        #call("derivative_helper",
+          (ListV(CS:Values), IntV(N:Int)),
+          solutionFuns)
+        => ListV(#differentiate(N, CS))
+      </k>
+    </mpy>
+    [label(helper-correct)]
+
+  // [] and C0 :: CS exhaust all finite coefficient lists. The first
+  // coefficient is discarded and the helper begins at degree one.
+  claim
+    <mpy>
+      <k>
+        #run(solutionProgram, ListV(.Values))
+        => ListV(.Values)
+      </k>
+    </mpy>
+    [label(derivative-empty), depends(helper-correct)]
+
+  claim
+    <mpy>
+      <k>
+        #run(solutionProgram,
+          ListV((C0:Value, CS:Values)))
+        => ListV(#differentiate(1, CS))
+      </k>
+    </mpy>
+    [label(derivative-nonempty), depends(helper-correct)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b6e8e361f1cb74c3b147b3d71d16bb3d14677e20
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,44 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // This macro is deliberately the exact constructor tree emitted in
+  // solution.mpy. Keeping it here makes the proof talk about the translated
+  // program rather than a hand-written mathematical stand-in.
+  syntax Pgm ::= "solutionProgram" [macro]
+  syntax Stmts ::= "solutionFunctions" [macro]
+  syntax Map ::= "solutionFuns" [macro]
+
+  rule solutionProgram => Module(solutionFunctions)
+  rule solutionFuns => #collect(solutionFunctions)
+  rule solutionFunctions =>
+    FuncDef("derivative", Params("xs"),
+      Return(
+        Call(
+          Name("derivative_helper"),
+          Subscript(Name("xs"), Slice(Int(1), NoBound, NoBound)),
+          Int(1))))
+    FuncDef("derivative_helper", Params("xs", "degree"),
+      If(Compare(Name("xs"), CmpOp("==", ListExpr(.Exprs))),
+        Return(ListExpr(.Exprs)),
+        Return(
+          BinOp("+",
+            ListExpr(
+              BinOp("*", Name("degree"),
+                Subscript(Name("xs"), Int(0)))),
+            Call(
+              Name("derivative_helper"),
+              Subscript(Name("xs"), Slice(Int(1), NoBound, NoBound)),
+              BinOp("+", Name("degree"), Int(1)))))))
+
+  // Mathematical model over runtime coefficient sequences. For integer
+  // coefficients, #bin("*", IntV(N), C) is exactly N *Int C by semantic.k.
+  // Leaving it in this factored form also describes Python's stuck/error
+  // behavior outside the supported numeric fragment without assuming a type.
+  syntax Values ::= "#differentiate" "(" Int "," Values ")" [function]
+
+  rule #differentiate(N, .Values) => .Values
+  rule #differentiate(N, (C, CS))
+    => (#bin("*", IntV(N), C), #differentiate(N +Int 1, CS))
+endmodule

codex
The first symbolic run exposed a real proof-engineering issue: the big-step list-concatenation equation hid the recursive call beneath a function symbol, so circularity could not see it. I’m making that evaluation order explicit with a K continuation; this keeps the semantics executable and puts the recursive call at the head of `<k>`, where the induction hypothesis can apply.
apply patch
patch: completed
/work/semantic.k
/work/spec.k
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..603ef8b4b0c0689ec9898e4b7d64adc18ca2ebd5
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,166 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  // Statement sequences are juxtaposed by py2mpy.py.
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" Strs ")"
+  syntax Strs ::= List{String, ","}
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Str" "(" String ")"
+                | "Name" "(" String ")"
+                | "ListExpr" "(" Exprs ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Subscript" "(" Expr "," Index ")"
+
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  syntax Index ::= Expr
+                 | "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr | "NoBound"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  // Runtime values. Values is a proper, finite sequence, so ListV is a
+  // direct model of a Python list for the fragment used by solution.py.
+  syntax Value ::= "IntV" "(" Int ")"
+                 | "BoolV" "(" Bool ")"
+                 | "StrV" "(" String ")"
+                 | "ListV" "(" Values ")"
+                 | "NoneV"
+  syntax Values ::= List{Value, ","}
+
+  syntax Closure ::= "closure" "(" Params "," Stmts ")"
+  syntax KItem ::= "#prepend" "(" Value ")"
+
+  // A program is loaded as a map of function closures, then derivative is
+  // invoked with the single list supplied in the ARGS configuration cell.
+  syntax Value ::= "#run" "(" Pgm "," Value ")" [function]
+                 | "#call" "(" String "," Values "," Map ")"
+                 | "#exec" "(" Stmts "," Map "," Map ")"
+                 | "#choose" "(" Value "," Stmts "," Stmts "," Map "," Map ")" [function]
+                 | "#eval" "(" Expr "," Map "," Map ")" [function]
+                 | "#bin" "(" String "," Value "," Value ")" [function]
+                 | "#equal" "(" Value "," Value ")" [function]
+                 | "#head" "(" Value ")" [function]
+                 | "#tail" "(" Value ")" [function]
+
+  syntax Values ::= "#evalArgs" "(" Exprs "," Map "," Map ")" [function]
+                  | "#concat" "(" Values ";" Values ")" [function]
+  syntax Map ::= "#collect" "(" Stmts ")" [function]
+               | "#bind" "(" Params "," Values ")" [function]
+
+  configuration
+    <mpy>
+      <k> #run($PGM:Pgm, $ARGS:Value) </k>
+    </mpy>
+
+  // Module loading and calls.
+  rule #run(Module(SS), ARG) => #call("derivative", ARG, #collect(SS))
+
+  rule #collect(.Stmts) => .Map
+  rule #collect(FuncDef(F, PS, BODY) REST)
+    => (F |-> closure(PS, BODY)) #collect(REST)
+
+  rule #bind(Params(.Strs), .Values) => .Map
+  rule #bind(Params(X, XS), (V, VS))
+    => (X |-> V) #bind(Params(XS), VS)
+
+  rule #call(F, VS, (F |-> closure(PS, BODY)) FUNS)
+    => #exec(BODY, #bind(PS, VS), (F |-> closure(PS, BODY)) FUNS)
+
+  // Return evaluation. The list-plus-recursive-call form uses an explicit
+  // continuation, preserving Python's evaluation order while keeping the
+  // recursive call visible at the head of <k> for symbolic reasoning.
+  rule #exec(Return(ListExpr(ES)) REST, ENV, FUNS)
+    => #eval(ListExpr(ES), ENV, FUNS)
+  rule #exec(Return(Call(Name(F), ES)) REST, ENV, FUNS)
+    => #call(F, #evalArgs(ES, ENV, FUNS), FUNS)
+  rule <k>
+         #exec(
+           Return(BinOp("+", ListExpr(LEFT), Call(Name(F), RIGHT))) REST,
+           ENV,
+           FUNS)
+       => #call(F, #evalArgs(RIGHT, ENV, FUNS), FUNS)
+          ~> #prepend(ListV(#evalArgs(LEFT, ENV, FUNS)))
+       ... </k>
+  rule <k> ListV(YS) ~> #prepend(ListV(XS)) => ListV(#concat(XS ; YS)) ... </k>
+  // Constructor-directed versions of Python's list-empty test. These are
+  // ordinary semantic transitions (rather than equations), allowing kprove
+  // to split a symbolic finite list into its empty/nonempty cases.
+  rule #exec(
+          If(Compare(Name(X), CmpOp("==", ListExpr(.Exprs))), THEN, ELSE) REST,
+          (X |-> ListV(.Values)) ENV,
+          FUNS)
+    => #exec(THEN, (X |-> ListV(.Values)) ENV, FUNS)
+  rule #exec(
+          If(Compare(Name(X), CmpOp("==", ListExpr(.Exprs))), THEN, ELSE) REST,
+          (X |-> ListV((V, VS))) ENV,
+          FUNS)
+    => #exec(ELSE, (X |-> ListV((V, VS))) ENV, FUNS)
+  rule #exec(.Stmts, ENV, FUNS) => NoneV
+
+  rule #choose(BoolV(true),  THEN, ELSE, ENV, FUNS) => #exec(THEN, ENV, FUNS)
+  rule #choose(BoolV(false), THEN, ELSE, ENV, FUNS) => #exec(ELSE, ENV, FUNS)
+
+  // Expression evaluation for the constructors exercised by solution.mpy.
+  rule #eval(Int(I), ENV, FUNS) => IntV(I)
+  rule #eval(Bool(B), ENV, FUNS) => BoolV(B)
+  rule #eval(Str(S), ENV, FUNS) => StrV(S)
+  rule #eval(Name(X), (X |-> V:Value) ENV, FUNS) => V
+  rule #eval(ListExpr(ES), ENV, FUNS) => ListV(#evalArgs(ES, ENV, FUNS))
+  rule #eval(BinOp(OP, L, R), ENV, FUNS)
+    => #bin(OP, #eval(L, ENV, FUNS), #eval(R, ENV, FUNS))
+  rule #eval(Compare(L, CmpOp("==", R)), ENV, FUNS)
+    => #equal(#eval(L, ENV, FUNS), #eval(R, ENV, FUNS))
+  rule #eval(Call(Name(F), ES), ENV, FUNS)
+    => #call(F, #evalArgs(ES, ENV, FUNS), FUNS)
+  rule #eval(Subscript(E, Int(0)), ENV, FUNS)
+    => #head(#eval(E, ENV, FUNS))
+  rule #eval(Subscript(E, Slice(Int(1), NoBound, NoBound)), ENV, FUNS)
+    => #tail(#eval(E, ENV, FUNS))
+
+  rule #evalArgs(.Exprs, ENV, FUNS) => .Values
+  rule #evalArgs((E, ES), ENV, FUNS)
+    => (#eval(E, ENV, FUNS), #evalArgs(ES, ENV, FUNS))
+
+  // Python integer arithmetic and list concatenation.
+  rule #bin("+", IntV(I), IntV(J)) => IntV(I +Int J)
+  rule #bin("*", IntV(I), IntV(J)) => IntV(I *Int J)
+  rule #bin("+", ListV(XS), ListV(YS)) => ListV(#concat(XS ; YS))
+
+  rule #concat(.Values ; YS) => YS
+  rule #concat((V, VS) ; YS) => (V, #concat(VS ; YS))
+
+  // Equality is complete for integers, booleans, strings, and the only list
+  // comparison used by the program (against []).
+  rule #equal(IntV(I), IntV(J)) => BoolV(I ==Int J)
+  rule #equal(BoolV(B), BoolV(C)) => BoolV(B ==Bool C)
+  rule #equal(StrV(S), StrV(T)) => BoolV(S ==String T)
+  rule #equal(ListV(.Values), ListV(.Values)) => BoolV(true)
+  rule #equal(ListV((V, VS)), ListV(.Values)) => BoolV(false)
+  rule #equal(ListV(.Values), ListV((V, VS))) => BoolV(false)
+
+  rule #head(ListV((V, VS))) => V
+  rule #tail(ListV(.Values)) => ListV(.Values)
+  rule #tail(ListV((V, VS))) => ListV(VS)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..b7c8f8d89da4b22d6b14e47eba8d08e60e4b6522
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def derivative(xs: list):
+    return derivative_helper(xs[1:], 1)
+
+
+def derivative_helper(xs: list, degree: int):
+    if xs == []:
+        return []
+    else:
+        return [degree * xs[0]] + derivative_helper(xs[1:], degree + 1)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9913ea73bed6f3284867e1f5de64278c18fc4f18
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,41 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Structural induction theorem for the recursive helper. After one
+  // nonempty-list step, the remaining obligation is the same claim at the
+  // tail and successor degree, so kprove closes it by circularity.
+  claim
+    <mpy>
+      <k>
+        #call("derivative_helper",
+          (ListV(CS:Values), IntV(N:Int)),
+          solutionFuns)
+        ~> K:K
+        => ListV(#differentiate(N, CS)) ~> K
+      </k>
+    </mpy>
+    [label(helper-correct)]
+
+  // [] and C0 :: CS exhaust all finite coefficient lists. The first
+  // coefficient is discarded and the helper begins at degree one.
+  claim
+    <mpy>
+      <k>
+        #run(solutionProgram, ListV(.Values))
+        => ListV(.Values)
+      </k>
+    </mpy>
+    [label(derivative-empty), depends(helper-correct)]
+
+  claim
+    <mpy>
+      <k>
+        #run(solutionProgram,
+          ListV((C0:Value, CS:Values)))
+        => ListV(#differentiate(1, CS))
+      </k>
+    </mpy>
+    [label(derivative-nonempty), depends(helper-correct)]
+endmodule
