+  // coefficient is discarded and the helper begins at degree one.
+  claim
+    <mpy>
+      <k>
+        #run(solutionProgram, ListV(.Values))
+        => ListV(.Values)
+      </k>
+    </mpy>
+    [label(derivative-empty), depends(helper-correct)]
+
+  claim
+    <mpy>
+      <k>
+        #run(solutionProgram,
+          ListV((IntV(C0:Int), #encode(CS:IntVals))))
+        => ListV(#differentiate(1, CS))
+      </k>
+    </mpy>
+    [label(derivative-nonempty), depends(helper-correct)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..dbe054b045f67aadec7467fda3746f9a67436a62
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,48 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // This macro is deliberately the exact constructor tree emitted in
+  // solution.mpy. Keeping it here makes the proof talk about the translated
+  // program rather than a hand-written mathematical stand-in.
+  syntax Pgm ::= "solutionProgram"
+  syntax Stmts ::= "solutionFunctions"
+  syntax Map ::= "solutionFuns"
+
+  rule solutionProgram => Module(solutionFunctions) [macro]
+  rule solutionFuns => #collect(solutionFunctions) [macro]
+  rule solutionFunctions =>
+    FuncDef("derivative", Params("xs"),
+      Return(
+        Call(
+          Name("derivative_helper"),
+          Subscript(Name("xs"), Slice(Int(1), NoBound, NoBound)),
+          Int(1))))
+    FuncDef("derivative_helper", Params("xs", "degree"),
+      If(Compare(Name("xs"), CmpOp("==", ListExpr())),
+        Return(ListExpr()),
+        Return(
+          BinOp("+",
+            ListExpr(
+              BinOp("*", Name("degree"),
+                Subscript(Name("xs"), Int(0)))),
+            Call(
+              Name("derivative_helper"),
+              Subscript(Name("xs"), Slice(Int(1), NoBound, NoBound)),
+              BinOp("+", Name("degree"), Int(1))))))) [macro]
+
+  // Mathematical model: IntVals is a finite coefficient sequence. Encoding
+  // embeds it into runtime values; differentiate multiplies each remaining
+  // coefficient by its degree.
+  syntax IntVals ::= List{Int, ","}
+  syntax Values ::= "#encode" "(" IntVals ")" [function]
+                  | "#differentiate" "(" Int "," IntVals ")" [function]
+
+  rule #encode(.IntVals) => .Values
+  rule #encode((C, CS)) => (IntV(C), #encode(CS))
+
+  rule #differentiate(N, .IntVals) => .Values
+  rule #differentiate(N, (C, CS))
+    => (IntV(N *Int C), #differentiate(N +Int 1, CS))
+endmodule

