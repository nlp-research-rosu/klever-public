+    => #exec(THEN, (X |-> ListV(.Values)) ENV, FUNS)
+  rule #exec(
+          If(Compare(Name(X), CmpOp("==", ListExpr(.Exprs))), _THEN, ELSE) _REST,
+          (X |-> ListV((V, VS))) ENV,
+          FUNS)
+    => #exec(ELSE, (X |-> ListV((V, VS))) ENV, FUNS)
+  rule #exec(.Stmts, _ENV, _FUNS) => NoneV
