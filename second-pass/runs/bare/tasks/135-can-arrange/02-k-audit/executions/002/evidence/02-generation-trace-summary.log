t(E, Int(I))) => eval(E) ~> indexAt(I) ... </k>\n+  rule <k> value(arrayVal(A, O, N)) ~> indexAt(I)\n+        => value(intVal(get(A, O +Int I))) ... </k>\n+\n+  rule <k> eval(BinOp(OP, LEFT, RIGHT))\n+        => eval(LEFT) ~> binLeft(OP, RIGHT) ... </k>\n+  rule <k> value(V) ~> binLeft(OP, RIGHT)\n+        => eval(RIGHT) ~> binRight(OP, V) ... </k>\n+  rule <k> value(intVal(J)) ~> binRight(\"+\", intVal(I))\n+        => value(intVal(I +Int J)) ... </k>\n+\n+  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT)))\n+        => eval(LEFT) ~> cmpLeft(OP, RIGHT) ... </k>\n+  rule <k> value(V) ~> cmpLeft(OP, RIGHT)\n+        => eval(RIGHT) ~> cmpRight(OP, V) ... </k>\n+  rule <k> value(intVal(J)) ~> cmpRight(\"<=\", intVal(I))\n+        => value(boolVal(I <=Int J)) ... </k>\n+  rule <k> value(intVal(J)) ~> cmpRight(\"!=\", intVal(I))\n+        => value(boolVal(I =/=Int J)) ... </k>\n+  rule <k> value(intVal(J)) ~> cmpRight(\"<\", intVal(I))\n+        => value(boolVal(I <Int J)) ... </k>\n+\n+  // Total symbolic array selection, plus executable equations for concrete\n+  // seq(...) arrays. Proof claims only access indices known to be in bounds.\n+  syntax Int ::= \"get\" \"(\" Arr \",\" Int \")\" [function, total]\n+  rule get(seq(I, REST), 0) => I\n+  rule get(seq(I, REST), N) => get(seq(REST), N -Int 1)\n+       requires N >Int 0\n+\n+endmodule\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module VERIFICATION\n+  imports MPY\n+\n+  // The independent mathematical contract. For a suffix of length N,\n+  // answer returns the largest local drop index, or -1. A drop in the tail\n+  // outranks the head pair, hence the recursive result is shifted by one.\n+  syntax Int ::= \"answer\" \"(\" Arr \",\" Int \",\" Int \")\" [function, total]\n+               | \"answerStep\" \"(\" Int \",\" Int \",\" Int \")\" [function, total]\n+\n+  rule answer(A, O, N) => -1\n+       requires N <=Int 1\n+  rule answer(A, O, N)\n+       => answerStep(\n+            answer(A, O +Int 1, N -Int 1),\n+            get(A, O),\n+            get(A, O +Int 1))\n+       requires N >Int 1\n+\n+  rule answerStep(R, X, Y) => R +Int 1\n+       requires R =/=Int -1\n+  rule answerStep(R, X, Y) => 1\n+       requires R ==Int -1 andBool Y <Int X\n+  rule answerStep(R, X, Y) => -1\n+       requires R ==Int -1 andBool Y >=Int X\n+\n+  // This macro is exactly the constructor tree generated in solution.mpy.\n+  // It is data consumed by invoke/exec/eval; it is not an implementation or\n+  // a shortcut rule for can_arrange.\n+  syntax Function ::= \"canArrangeFunction\" [macro]\n+  rule canArrangeFunction =>\n+    function(Params(\"arr\"),\n+      If(Compare(Call(Name(\"len\"), Name(\"arr\")), CmpOp(\"<=\", Int(1))),\n+        Return(UnaryOp(\"-\", Int(1))),\n+        Assign(Name(\"result\"),\n+          Call(Name(\"can_arrange\"),\n+            Subscript(Name(\"arr\"), Slice(Int(1), NoBound, NoBound))))\n+        If(Compare(Name(\"result\"),\n+                   CmpOp(\"!=\", UnaryOp(\"-\", Int(1)))),\n+          Return(BinOp(\"+\", Name(\"result\"), Int(1))),\n+          If(Compare(Subscript(Name(\"arr\"), Int(1)),\n+                     CmpOp(\"<\", Subscript(Name(\"arr\"), Int(0)))),\n+            Return(Int(1)),\n+            Return(UnaryOp(\"-\", Int(1)))))))\n+    [macro]\n+\n+  syntax Pgm ::= \"solutionProgram\" [macro]\n+  rule solutionProgram =>\n+    Module(FuncDef(\"can_arrange\", Params(\"arr\"),\n+      If(Compare(Call(Name(\"len\"), Name(\"arr\")), CmpOp(\"<=\", Int(1))),\n+        Return(UnaryOp(\"-\", Int(1))),\n+        Assign(Name(\"result\"),\n+          Call(Name(\"can_arrange\"),\n+            Subscript(Name(\"arr\"), Slice(Int(1), NoBound, NoBound))))\n+        If(Compare(Name(\"result\"),\n+                   CmpOp(\"!=\", UnaryOp(\"-\", Int(1)))),\n+          Return(BinOp(\"+\", Name(\"result\"), Int(1))),\n+          If(Compare(Subscript(Name(\"arr\"), Int(1)),\n+                     CmpOp(\"<\", Subscript(Name(\"arr\"), Int(0)))),\n+            Return(Int(1)),\n+            Return(UnaryOp(\"-\", Int(1))))))))\n+    [macro]\n+\n+endmodule\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module SPEC\n+  imports VERIFICATION\n+\n+  // Inductive, all-length correctness claim. K is universally quantified,\n+  // so the theorem applies to calls in every expression continuation. ENV\n+  // and FRAMES are restored exactly across the call. The definition cell\n+  // fixes the interpreted function to the generated solution constructor.\n+  claim\n+    <k> invoke(\"can_arrange\", arrayVal(A, O, N)) ~> K\n+      => value(intVal(answer(A, O, N))) ~> K </k>\n+    <env> ENV </env>\n+    <defs> \"can_arrange\" |-> canArrangeFunction </defs>\n+    <stack> FRAMES </stack>\n+    requires N >=Int 0\n+\n+endmodule\n*** End Patch";
