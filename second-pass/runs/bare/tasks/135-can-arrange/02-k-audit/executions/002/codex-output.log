+  imports VERIFICATION
+
+  // Deliberately false: every claimed result is shifted by one.
+  // Satisfying witness: A=seq(1,2,4,3,5), O=0, N=5 has actual answer 3.
+  claim
+    <k> invoke("can_arrange", arrayVal(A, O, N)) ~> K
+      => value(intVal(answer(A, O, N) +Int 1)) ~> K </k>
+    <env> ENV </env>
+    <defs> "can_arrange" |-> canArrangeFunction </defs>
+    <stack> FRAMES </stack>
+    requires O >=Int 0
