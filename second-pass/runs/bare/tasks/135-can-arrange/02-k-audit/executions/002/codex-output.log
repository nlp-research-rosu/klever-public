   122	       <env> _ => CALLER </env>
   123	       <stack> ListItem(CALLER) FRAMES => FRAMES </stack>
   124	
   125	  // Expressions needed by the emitted solution AST.
   126	  rule <k> eval(Int(I)) => value(intVal(I)) ... </k>
   127	  rule <k> eval(Name(X)) => value(V) ... </k>
