diff --git a/evidence/pinning.k b/evidence/pinning.k
new file mode 100644
index 0000000000000000000000000000000000000000..1759f10788620eacf0da6d771baa36451bcfb0e0
--- /dev/null
+++ b/evidence/pinning.k
@@ -0,0 +1,11 @@
+requires "verification.k"
+
+module PINNING
+  imports VERIFICATION
+
+  // Reviewer-only constructor wrapper: no evaluation and no task logic.
+  syntax Pgm ::= "programOf" "(" Function ")" [macro]
+  rule programOf(function(PS, BODY))
+    => Module(FuncDef("can_arrange", PS, BODY))
+
+endmodule
