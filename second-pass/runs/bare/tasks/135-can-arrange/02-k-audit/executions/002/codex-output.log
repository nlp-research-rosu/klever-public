   142	  rule <k> value(arrayVal(A, O, N)) ~> sliceFromOne
   143	        => value(arrayVal(A, O +Int 1, N -Int 1)) ... </k>
   144	
   145	  rule <k> eval(Subscript(E, Int(I))) => eval(E) ~> indexAt(I) ... </k>
   146	  rule <k> value(arrayVal(A, O, N)) ~> indexAt(I)
   147	        => value(intVal(get(A, O +Int I))) ... </k>
   148	
   149	  rule <k> eval(BinOp(OP, LEFT, RIGHT))
   150	        => eval(LEFT) ~> binLeft(OP, RIGHT) ... </k>
   151	  rule <k> value(V) ~> binLeft(OP, RIGHT)
   152	        => eval(RIGHT) ~> binRight(OP, V) ... </k>
   153	  rule <k> value(intVal(J)) ~> binRight("+", intVal(I))
   154	        => value(intVal(I +Int J)) ... </k>
   155	
   156	  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT), .CmpOps))
   157	        => eval(LEFT) ~> cmpLeft(OP, RIGHT) ... </k>
   158	  rule <k> value(V) ~> cmpLeft(OP, RIGHT)
   159	        => eval(RIGHT) ~> cmpRight(OP, V) ... </k>
   160	  rule <k> value(intVal(J)) ~> cmpRight("<=", intVal(I))
   161	        => value(boolVal(I <=Int J)) ... </k>
   162	  rule <k> value(intVal(J)) ~> cmpRight("!=", intVal(I))
   163	        => value(boolVal(I =/=Int J)) ... </k>
   164	  rule <k> value(intVal(J)) ~> cmpRight("<", intVal(I))
   165	        => value(boolVal(I <Int J)) ... </k>
   166	
