STRING\n+  imports MAP\n+  imports LIST\n+\n+  syntax KItem ::= \"invokeEntry\" \"(\" Val \")\"\n+                 | \"load\" \"(\" Stmts \")\"\n+                 | \"install\" \"(\" String \",\" Params \",\" Stmts \")\"\n+                 | \"invoke\" \"(\" String \",\" Val \")\"\n+                 | \"exec\" \"(\" Stmts \")\"\n+                 | \"eval\" \"(\" Exp \")\"\n+                 | \"value\" \"(\" Val \")\"\n+                 | \"assignTo\" \"(\" String \")\"\n+                 | \"branch\" \"(\" Stmts \",\" Stmts \",\" Stmts \")\"\n+                 | \"callValue\" \"(\" String \")\"\n+                 | \"applyLen\"\n+                 | \"sliceFromOne\"\n+                 | \"indexAt\" \"(\" Int \")\"\n+                 | \"unaryMinus\"\n+                 | \"binLeft\" \"(\" String \",\" Exp \")\"\n+                 | \"binRight\" \"(\" String \",\" Val \")\"\n+                 | \"cmpLeft\" \"(\" String \",\" Exp \")\"\n+                 | \"cmpRight\" \"(\" String \",\" Val \")\"\n+                 | \"doReturn\"\n+                 | \"noReturn\"\n+\n+  configuration\n+    <mpy>\n+      <k> $PGM:Pgm ~> invokeEntry($ARGS:Val) </k>\n+      <env> .Map </env>\n+      <defs> .Map </defs>\n+      <stack> .List </stack>\n+    </mpy>\n+\n+  // Module loading. Function definitions are data in the definitions cell;\n+  // calls below interpret their parameter and statement constructors.\n+  rule <k> Module(SS) => load(SS) ... </k>\n+  rule <k> load(.Stmts) => .K ... </k>\n+  rule <k> load(FuncDef(F, PS, BODY) REST)\n+        => install(F, PS, BODY) ~> load(REST) ... </k>\n+  rule <k> install(F, PS, BODY) => .K ... </k>\n+       <defs> DEFS => DEFS [ F <- function(PS, BODY) ] </defs>\n+  rule <k> invokeEntry(V) => invoke(\"can_arrange\", V) ... </k>\n+\n+  // A call saves the caller environment.  The K continuation itself holds\n+  // the expression/statement continuation, so recursive calls remain visible\n+  // to reachability logic and can be discharged inductively.\n+  rule <k> invoke(F, V) => exec(BODY) ~> noReturn ... </k>\n+       <env> CALLER => P |-> V </env>\n+       <defs> ... F |-> function(Params(P), BODY) ... </defs>\n+       <stack> FRAMES => ListItem(CALLER) FRAMES </stack>\n+\n+  rule <k> exec(.Stmts) => .K ... </k>\n+  rule <k> exec(Assign(Name(X), E) REST)\n+        => eval(E) ~> assignTo(X) ~> exec(REST) ... </k>\n+  rule <k> value(V) ~> assignTo(X) => .K ... </k>\n+       <env> ENV => ENV [ X <- V ] </env>\n+\n+  rule <k> exec(If(COND, THEN, ELSE) REST)\n+        => eval(COND) ~> branch(THEN, ELSE, REST) ... </k>\n+  rule <k> value(boolVal(B)) ~> branch(THEN, ELSE, REST)\n+        => exec(THEN REST) ... </k>\n+       requires B\n+  rule <k> value(boolVal(B)) ~> branch(THEN, ELSE, REST)\n+        => exec(ELSE REST) ... </k>\n+       requires notBool B\n+\n+  rule <k> exec(Return(E) REST) => eval(E) ~> doReturn ... </k>\n+  rule <k> value(V) ~> doReturn ~> noReturn => value(V) ... </k>\n+       <env> _ => CALLER </env>\n+       <stack> ListItem(CALLER) FRAMES => FRAMES </stack>\n+\n+  // Expressions needed by the emitted solution AST.\n+  rule <k> eval(Int(I)) => value(intVal(I)) ... </k>\n+  rule <k> eval(Name(X)) => value(V) ... </k>\n+       <env> ... X |-> V ... </env>\n+\n+  rule <k> eval(UnaryOp(\"-\", E)) => eval(E) ~> unaryMinus ... </k>\n+  rule <k> value(intVal(I)) ~> unaryMinus => value(intVal(0 -Int I)) ... </k>\n+\n+  rule <k> eval(Call(Name(\"len\"), E)) => eval(E) ~> applyLen ... </k>\n+  rule <k> value(arrayVal(A, O, N)) ~> applyLen => value(intVal(N)) ... </k>\n+\n+  rule <k> eval(Call(Name(F), E)) => eval(E) ~> callValue(F) ... </k>\n+       requires F =/=String \"len\"\n+  rule <k> value(V) ~> callValue(F) => invoke(F, V) ... </k>\n+\n+  rule <k> eval(Subscript(E, Slice(Int(1), NoBound, NoBound)))\n+        => eval(E) ~> sliceFromOne ... </k>\n+  rule <k> value(arrayVal(A, O, N)) ~> sliceFromOne\n+        => value(arrayVal(A, O +Int 1, N -Int 1)) ... </k>\n+\n+  rule <k> eval(Subscript(E, Int(I))) => eval(E) ~> indexAt(I) ... </k>\n+  rule <k> value(arrayVal(A, O, N)) ~> indexAt(I)\n+        => value(intVal(get(A, O +Int I))) ... </k>\n+\n+  rule <k> eval(BinOp(OP, LEFT, RIGHT))\n+        => eval(LEFT) ~> binLeft(OP, RIGHT) ... </k>\n+  rule <k> value(V) ~> binLeft(OP, RIGHT)\n+        => eval(RIGHT) ~> binRight(OP, V) ... </k>\n+  rule <k> value(intVal(J)) ~> binRight(\"+\", intVal(I))\n+        => value(intVal(I +Int J)) ... </k>\n+\n+  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT)))\n+        => eval(LEFT) ~> cmpLeft(OP, RIGHT) ... </k>\n+  rule <k> value(V) ~> cmpLeft(OP, RIGHT)\n+        => eval(RIGHT) ~> cmpRight(OP, V) ... </k>\n+  rule <k> value(intVal(J)) ~> cmpRight(\"<=\", intVal(I))\n+        => value(boolVal(I <=Int J)) ... </k>\n+  rule <k> value(intVal(J)) ~> cmpRight(\"!=\", intVal(I))\n+        => value(boolVal(I =/=Int J)) ... </k>\n+  rule <k> value(intVal(J)) ~> cmpRight(\"<\", intVal(I))\n+        => value(boolVal(I <Int J)) ... </k>\n+\n+  // Total symbolic array selection, plus executable equations for concrete\n+  // seq(...) arrays. Proof claims only access indices known to be in bounds.\n+  syntax Int ::= \"get\" \"(\" Arr \",\" Int \")\" [function, total]\n+  rule get(seq(I, REST), 0) => I\n+  rule get(seq(I, REST), N) => get(seq(REST), N -Int 1)\n+       requires N >Int 0\n+\n+endmodule\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module VERIFICATION\n+  imports MPY\n+\n+  // The independent mathematical contract. For a suffix of length N,\n+  // answer returns the largest local drop index, or -1. A drop in the tail\n+  // outranks the head pair, hence the recursive result is shifted by one.\n+  syntax Int ::= \"answer\" \"(\" Arr \",\" Int \",\" Int \")\" [function, total]\n+               | \"answerStep\" \"(\" Int \",\" Int \",\" Int \")\" [function, total]\n+\n+  rule answer(A, O, N) => -1\n+       requires N <=Int 1\n+  rule answer(A, O, N)\n+       => answerStep(\n+            answer(A, O +Int 1, N -Int 1),\n+            get(A, O),\n+            get(A, O +Int 1))\n+       requires N >Int 1\n+\n+  rule answerStep(R, X, Y) => R +Int 1\n+       requires R =/=Int -1\n+  rule answerStep(R, X, Y) => 1\n+       requires R ==Int -1 andBool Y <Int X\n+  rule answerStep(R, X, Y) => -1\n+       requires R ==Int -1 andBool Y >=Int X\n+\n+  // This macro is exactly the constructor tree generated in solution.mpy.\n+  // It is data consumed by invoke/exec/eval; it is not an implementation or\n+  // a shortcut rule for can_arrange.\n+  syntax Function ::= \"canArrangeFunction\" [macro]\n+  rule canArrangeFunction =>\n+    function(Params(\"arr\"),\n+      If(Compare(Call(Name(\"len\"), Name(\"arr\")), CmpOp(\"<=\", Int(1))),\n+        Return(UnaryOp(\"-\", Int(1))),\n+        Assign(Name(\"result\"),\n+          Call(Name(\"can_arrange\"),\n+            Subscript(Name(\"arr\"), Slice(Int(1), NoBound, NoBound))))\n+        If(Compare(Name(\"result\"),\n+                   CmpOp(\"!=\", UnaryOp(\"-\", Int(1)))),\n+          Return(BinOp(\"+\", Name(\"result\"), Int(1))),\n+          If(Compare(Subscript(Name(\"arr\"), Int(1)),\n+                     CmpOp(\"<\", Subscript(Name(\"arr\"), Int(0)))),\n+            Return(Int(1)),\n+            Return(UnaryOp(\"-\", Int(1)))))))\n+    [macro]\n+\n+  syntax Pgm ::= \"solutionProgram\" [macro]\n+  rule solutionProgram =>\n+    Module(FuncDef(\"can_arrange\", Params(\"arr\"),\n+      If(Compare(Call(Name(\"len\"), Name(\"arr\")), CmpOp(\"<=\", Int(1))),\n+        Return(UnaryOp(\"-\", Int(1))),\n+        Assign(Name(\"result\"),\n+          Call(Name(\"can_arrange\"),\n+            Subscript(Name(\"arr\"), Slice(Int(1), NoBound, NoBound))))\n+        If(Compare(Name(\"result\"),\n+                   CmpOp(\"!=\", UnaryOp(\"-\", Int(1)))),\n+          Return(BinOp(\"+\", Name(\"result\"), Int(1))),\n+          If(Compare(Subscript(Name(\"arr\"), Int(1)),\n+                     CmpOp(\"<\", Subscript(Name(\"arr\"), Int(0)))),\n+            Return(Int(1)),\n+            Return(UnaryOp(\"-\", Int(1))))))))\n+    [macro]\n+\n+endmodule\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module SPEC\n+  imports VERIFICATION\n+\n+  // Inductive, all-length correctness claim. K is universally quantified,\n+  // so the theorem applies to calls in every expression continuation. ENV\n+  // and FRAMES are restored exactly across the call. The definition cell\n+  // fixes the interpreted function to the generated solution constructor.\n+  claim\n+    <k> invoke(\"can_arrange\", arrayVal(A, O, N)) ~> K\n+      => value(intVal(answer(A, O, N))) ~> K </k>\n+    <env> ENV </env>\n+    <defs> \"can_arrange\" |-> canArrangeFunction </defs>\n+    <stack> FRAMES </stack>\n+    requires N >=Int 0\n+\n+endmodule\n*** End Patch";
