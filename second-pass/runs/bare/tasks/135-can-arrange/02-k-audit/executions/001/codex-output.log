index 0000000000000000000000000000000000000000..3a627204d393410d1fb44b04d19854ffa57187de
--- /dev/null
+++ b/evidence/slice_rule_witness.sh
@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+set -u
+
+probe_py=/audit-output/evidence/slice_boundary_probe.py
+probe_mpy=/tmp/audit-work/135-can-arrange/build/slice_boundary_probe.mpy
