+requires "spec.k"
+
+module PIN-SPEC
+  imports SPEC
+
+  // Reviewer-authored bridge from the full submitted program term (represented
+  // by the candidate's macro) through module loading to the independently
+  // reconstructed and already-proved invocation claim.
+  claim [full-program-pin]:
+    <k> solutionProgram ~> invokeEntry(arrayVal(A, O, N))
+      => value(intVal(answer(A, O, N))) </k>
+    <env> .Map </env>
+    <defs> .Map => "can_arrange" |-> canArrangeFunction </defs>
+    <stack> .List </stack>
+    requires O >=Int 0
+     andBool N >=Int 0
+     andBool O +Int N <=Int arrSize(A)
+
+endmodule
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..f5dbc86c1a63c73f097cd57dff72a2242348e6c2
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log=$1
+shift
+
+{
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf '%s\n' '--- OUTPUT BEGIN ---'
+  "$@"
+  status=$?
+  printf '%s\n' '--- OUTPUT END ---'
+  printf 'EXIT STATUS: %d\n' "$status"
+  exit "$status"
+} 2>&1 | tee "$log"
+
+exit "${PIPESTATUS[0]}"
