+printf 'PYTHON EXIT: %d\n' "$python_status"
+
+printf 'TRANSLATE COMMAND: python3 /reference/py2mpy.py %s > %s\n' "$probe_py" "$probe_mpy"
+python3 /reference/py2mpy.py "$probe_py" > "$probe_mpy"
+translate_status=$?
