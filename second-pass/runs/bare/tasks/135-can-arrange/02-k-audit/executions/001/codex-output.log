+
+printf "K COMMAND: krun %s '-cARGS=arrayVal(seq(),0,0)' --definition %s\n" "$probe_mpy" "$definition"
+krun "$probe_mpy" "-cARGS=arrayVal(seq(),0,0)" --definition "$definition"
+k_status=$?
+printf 'K EXIT: %d\n' "$k_status"
