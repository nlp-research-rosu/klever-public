+                 | "applyLen"
+                 | "sliceFromOne"
+                 | "indexAt" "(" Int ")"
+                 | "unaryMinus"
+                 | "binLeft" "(" String "," Exp ")"
+                 | "binRight" "(" String "," Val ")"
