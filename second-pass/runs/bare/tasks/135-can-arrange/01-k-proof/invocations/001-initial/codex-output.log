+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Exp ")"
+                | "Assign" "(" Exp "," Exp ")"
+                | "If" "(" Exp "," Stmts "," Stmts ")"
+
+  syntax Exp ::= "Int" "(" Int ")"
+               | "Name" "(" String ")"
+               | "Call" "(" Exp "," Exps ")"
+               | "Compare" "(" Exp "," CmpOps ")"
+               | "Subscript" "(" Exp "," Exp ")"
+               | "Slice" "(" Bound "," Bound "," Bound ")"
+               | "BinOp" "(" String "," Exp "," Exp ")"
+               | "UnaryOp" "(" String "," Exp ")"
+
