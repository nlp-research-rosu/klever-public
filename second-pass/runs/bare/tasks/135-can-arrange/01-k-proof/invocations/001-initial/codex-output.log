+  imports LIST
+
+  syntax KItem ::= "invokeEntry" "(" Val ")"
+                 | "load" "(" Stmts ")"
+                 | "install" "(" String "," Params "," Stmts ")"
+                 | "invoke" "(" String "," Val ")"
+                 | "exec" "(" Stmts ")"
+                 | "eval" "(" Exp ")"
+                 | "value" "(" Val ")"
+                 | "assignTo" "(" String ")"
+                 | "branch" "(" Stmts "," Stmts "," Stmts ")"
