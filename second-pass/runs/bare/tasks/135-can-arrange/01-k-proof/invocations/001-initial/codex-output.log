+               | "Call" "(" Exp "," Exps ")"
+               | "Compare" "(" Exp "," CmpOps ")"
+               | "Subscript" "(" Exp "," Exp ")"
+               | "Slice" "(" Bound "," Bound "," Bound ")"
+               | "BinOp" "(" String "," Exp "," Exp ")"
+               | "UnaryOp" "(" String "," Exp ")"
