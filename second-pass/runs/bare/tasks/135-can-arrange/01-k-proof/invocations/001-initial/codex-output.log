+                 | "cmpRight" "(" String "," Val ")"
+                 | "doReturn"
+                 | "noReturn"
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm ~> invokeEntry($ARGS:Val) </k>
+      <env> .Map </env>
+      <defs> .Map </defs>
+      <stack> .List </stack>
