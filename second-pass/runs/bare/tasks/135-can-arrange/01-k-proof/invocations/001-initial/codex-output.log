+
+  syntax KItem ::= "invokeEntry" "(" Val ")"
+                 | "load" "(" Stmts ")"
+                 | "install" "(" String "," Params "," Stmts ")"
+                 | "invoke" "(" String "," Val ")"
+                 | "exec" "(" Stmts ")"
+                 | "eval" "(" Exp ")"
+                 | "value" "(" Val ")"
+                 | "assignTo" "(" String ")"
+                 | "branch" "(" Stmts "," Stmts "," Stmts ")"
+                 | "callValue" "(" String ")"
+                 | "applyLen"
+                 | "sliceFromOne"
+                 | "indexAt" "(" Int ")"
+                 | "unaryMinus"
+                 | "binLeft" "(" String "," Exp ")"
+                 | "binRight" "(" String "," Val ")"
+                 | "cmpLeft" "(" String "," Exp ")"
+                 | "cmpRight" "(" String "," Val ")"
+                 | "doReturn"
+                 | "noReturn"
+
+  syntax Stmts ::= "appendStmts" "(" Stmts "," Stmts ")" [function, total]
+  rule appendStmts(.Stmts, MORE) => MORE
+  rule appendStmts(S REST, MORE) => S appendStmts(REST, MORE)
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm ~> invokeEntry($ARGS:Val) </k>
+      <env> .Map </env>
+      <defs> .Map </defs>
+      <stack> .List </stack>
+    </mpy>
+
+  // Module loading. Function definitions are data in the definitions cell;
+  // calls below interpret their parameter and statement constructors.
+  rule <k> Module(SS) => load(SS) ... </k>
+  rule <k> load(.Stmts) => .K ... </k>
+  rule <k> load(FuncDef(F, PS, BODY) REST)
+        => install(F, PS, BODY) ~> load(REST) ... </k>
+  rule <k> install(F, PS, BODY) => .K ... </k>
+       <defs> DEFS => DEFS [ F <- function(PS, BODY) ] </defs>
+  rule <k> invokeEntry(V) => invoke("can_arrange", V) ... </k>
+
+  // A call saves the caller environment.  The K continuation itself holds
+  // the expression/statement continuation, so recursive calls remain visible
+  // to reachability logic and can be discharged inductively.
+  rule <k> invoke(F, V) => exec(BODY) ~> noReturn ... </k>
+       <env> CALLER => P |-> V </env>
+       <defs> ... F |-> function(Params(P, .Strings), BODY) ... </defs>
+       <stack> FRAMES => ListItem(CALLER) FRAMES </stack>
+
+  rule <k> exec(.Stmts) => .K ... </k>
+  rule <k> exec(Assign(Name(X), E) REST)
+        => eval(E) ~> assignTo(X) ~> exec(REST) ... </k>
+  rule <k> value(V) ~> assignTo(X) => .K ... </k>
+       <env> ENV => ENV [ X <- V ] </env>
+
+  rule <k> exec(If(COND, THEN, ELSE) REST)
+        => eval(COND) ~> branch(THEN, ELSE, REST) ... </k>
+  rule <k> value(boolVal(true)) ~> branch(THEN, _ELSE, REST)
+        => exec(appendStmts(THEN, REST)) ... </k>
+  rule <k> value(boolVal(false)) ~> branch(_THEN, ELSE, REST)
+        => exec(appendStmts(ELSE, REST)) ... </k>
+
+  rule <k> exec(Return(E) REST) => eval(E) ~> doReturn ... </k>
+  rule <k> value(V) ~> doReturn ~> noReturn => value(V) ... </k>
+       <env> _ => CALLER </env>
+       <stack> ListItem(CALLER) FRAMES => FRAMES </stack>
+
+  // Expressions needed by the emitted solution AST.
+  rule <k> eval(Int(I)) => value(intVal(I)) ... </k>
+  rule <k> eval(Name(X)) => value(V) ... </k>
+       <env> ... X |-> V ... </env>
+
+  rule <k> eval(UnaryOp("-", E)) => eval(E) ~> unaryMinus ... </k>
+  rule <k> value(intVal(I)) ~> unaryMinus => value(intVal(0 -Int I)) ... </k>
+
+  rule <k> eval(Call(Name("len"), E, .Exps)) => eval(E) ~> applyLen ... </k>
+  rule <k> value(arrayVal(A, O, N)) ~> applyLen => value(intVal(N)) ... </k>
+
+  rule <k> eval(Call(Name(F), E, .Exps)) => eval(E) ~> callValue(F) ... </k>
+       requires F =/=String "len"
+  rule <k> value(V) ~> callValue(F) => invoke(F, V) ... </k>
+
+  rule <k> eval(Subscript(E, Slice(Int(1), NoBound, NoBound)))
+        => eval(E) ~> sliceFromOne ... </k>
+  rule <k> value(arrayVal(A, O, N)) ~> sliceFromOne
+        => value(arrayVal(A, O +Int 1, N -Int 1)) ... </k>
+
+  rule <k> eval(Subscript(E, Int(I))) => eval(E) ~> indexAt(I) ... </k>
+  rule <k> value(arrayVal(A, O, N)) ~> indexAt(I)
+        => value(intVal(get(A, O +Int I))) ... </k>
+
+  rule <k> eval(BinOp(OP, LEFT, RIGHT))
+        => eval(LEFT) ~> binLeft(OP, RIGHT) ... </k>
+  rule <k> value(V) ~> binLeft(OP, RIGHT)
+        => eval(RIGHT) ~> binRight(OP, V) ... </k>
+  rule <k> value(intVal(J)) ~> binRight("+", intVal(I))
+        => value(intVal(I +Int J)) ... </k>
+
+  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT), .CmpOps))
+        => eval(LEFT) ~> cmpLeft(OP, RIGHT) ... </k>
+  rule <k> value(V) ~> cmpLeft(OP, RIGHT)
+        => eval(RIGHT) ~> cmpRight(OP, V) ... </k>
+  rule <k> value(intVal(J)) ~> cmpRight("<=", intVal(I))
+        => value(boolVal(I <=Int J)) ... </k>
+  rule <k> value(intVal(J)) ~> cmpRight("!=", intVal(I))
+        => value(boolVal(I =/=Int J)) ... </k>
+  rule <k> value(intVal(J)) ~> cmpRight("<", intVal(I))
+        => value(boolVal(I <Int J)) ... </k>
+
+  // Total symbolic array selection, plus executable equations for concrete
+  // seq(...) arrays. Proof claims only access indices known to be in bounds.
+  syntax Int ::= "get" "(" Arr "," Int ")" [function, total]
+               | "arrSize" "(" Arr ")" [function, total]
+               | "intsSize" "(" Ints ")" [function, total]
+  rule arrSize(seq(IS)) => intsSize(IS)
+  rule intsSize(.Ints) => 0
+  rule intsSize(I REST) => 1 +Int intsSize(REST)
+  rule get(seq(I, REST), 0) => I
+  rule get(seq(I, REST), N) => get(seq(REST), N -Int 1)
+       requires N >Int 0
+
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..d766f75f847f52f04a4d4d073eb823ee00136f34
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def can_arrange(arr):
+    if len(arr) <= 1:
+        return -1
+    else:
+        result = can_arrange(arr[1:])
+        if result != -1:
+            return result + 1
+        else:
+            if arr[1] < arr[0]:
+                return 1
+            else:
+                return -1
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c7661ce6403053a82dabf3cce4dbf329975a6b9a
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,20 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive, all-length correctness claim. K is universally quantified,
+  // so the theorem applies to calls in every expression continuation. ENV
+  // and FRAMES are restored exactly across the call. The definition cell
+  // fixes the interpreted function to the generated solution constructor.
+  claim
+    <k> invoke("can_arrange", arrayVal(A, O, N)) ~> K
+      => value(intVal(answer(A, O, N))) ~> K </k>
+    <env> ENV </env>
+    <defs> "can_arrange" |-> canArrangeFunction </defs>
+    <stack> FRAMES </stack>
+    requires O >=Int 0
+     andBool N >=Int 0
+     andBool O +Int N <=Int arrSize(A)
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e1367a4b3df7f6e8334caa90ea06b4a141286017
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,63 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The independent mathematical contract. For a suffix of length N,
+  // answer returns the largest local drop index, or -1. A drop in the tail
+  // outranks the head pair, hence the recursive result is shifted by one.
+  syntax Int ::= "answer" "(" Arr "," Int "," Int ")" [function, total]
+               | "answerStep" "(" Int "," Int "," Int ")" [function, total]
+
+  rule answer(A, O, N) => -1
+       requires N <=Int 1
+  rule answer(A, O, N)
+       => answerStep(
+            answer(A, O +Int 1, N -Int 1),
+            get(A, O),
+            get(A, O +Int 1))
+       requires N >Int 1
+
+  rule answerStep(R, X, Y) => R +Int 1
+       requires R =/=Int -1
+  rule answerStep(R, X, Y) => 1
+       requires R ==Int -1 andBool Y <Int X
+  rule answerStep(R, X, Y) => -1
+       requires R ==Int -1 andBool Y >=Int X
+
+  // This macro is exactly the constructor tree generated in solution.mpy.
+  // It is data consumed by invoke/exec/eval; it is not an implementation or
+  // a shortcut rule for can_arrange.
+  syntax Function ::= "canArrangeFunction" [macro]
+  rule canArrangeFunction =>
+    function(Params("arr"),
+      If(Compare(Call(Name("len"), Name("arr")), CmpOp("<=", Int(1))),
+        Return(UnaryOp("-", Int(1))),
+        Assign(Name("result"),
+          Call(Name("can_arrange"),
+            Subscript(Name("arr"), Slice(Int(1), NoBound, NoBound))))
+        If(Compare(Name("result"),
+                   CmpOp("!=", UnaryOp("-", Int(1)))),
+          Return(BinOp("+", Name("result"), Int(1))),
+          If(Compare(Subscript(Name("arr"), Int(1)),
+                     CmpOp("<", Subscript(Name("arr"), Int(0)))),
+            Return(Int(1)),
+            Return(UnaryOp("-", Int(1)))))))
+
+  syntax Pgm ::= "solutionProgram" [macro]
+  rule solutionProgram =>
+    Module(FuncDef("can_arrange", Params("arr"),
+      If(Compare(Call(Name("len"), Name("arr")), CmpOp("<=", Int(1))),
+        Return(UnaryOp("-", Int(1))),
+        Assign(Name("result"),
+          Call(Name("can_arrange"),
+            Subscript(Name("arr"), Slice(Int(1), NoBound, NoBound))))
+        If(Compare(Name("result"),
+                   CmpOp("!=", UnaryOp("-", Int(1)))),
+          Return(BinOp("+", Name("result"), Int(1))),
+          If(Compare(Subscript(Name("arr"), Int(1)),
+                     CmpOp("<", Subscript(Name("arr"), Int(0)))),
+            Return(Int(1)),
+            Return(UnaryOp("-", Int(1))))))))
+
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..fd72a5a34bd60c8201a4f72b550b0265458fd3dd
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,48 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Recreate the constructor program from the immutable translator input.
+python3 py2mpy.py solution.py > solution.mpy
+python3 -m py_compile solution.py
+
+# Build the executable semantics and exercise the actual generated .mpy term.
+kompile semantic.k \
+  --backend llvm \
+  --main-module MPY \
+  --syntax-module MPY-SYNTAX \
+  -o concrete-kompiled
+
+krun solution.mpy \
+  -cARGS='arrayVal(seq(1,2,4,3,5),0,5)' \
+  --definition concrete-kompiled \
+  | grep -F 'value ( intVal ( 3 ) )'
+
+krun solution.mpy \
+  -cARGS='arrayVal(seq(1,2,3),0,3)' \
+  --definition concrete-kompiled \
+  | grep -F 'value ( intVal ( -1 ) )'
+
+krun solution.mpy \
+  -cARGS='arrayVal(seq(5,4,3,2,1),0,5)' \
+  --definition concrete-kompiled \
+  | grep -F 'value ( intVal ( 4 ) )'
+
+krun solution.mpy \
+  -cARGS='arrayVal(seq(),0,0)' \
+  --definition concrete-kompiled \
+  | grep -F 'value ( intVal ( -1 ) )'
+
+# Include the contract functions and exact generated function tree in the
+# Haskell definition, then prove every claim in spec.k.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION \
+  -o proof-kompiled
+
+kprove spec.k \
+  --definition proof-kompiled \
+  --spec-module SPEC \
+  | tee kprove.log
+
+grep -qx '#Top' kprove.log
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..fc10782c87f66dfebc553647c429ef0a470733ca
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,179 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+  imports MAP
+  imports LIST
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+  syntax Exps ::= List{Exp, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Exp ")"
+                | "Assign" "(" Exp "," Exp ")"
+                | "If" "(" Exp "," Stmts "," Stmts ")"
+
+  syntax Exp ::= "Int" "(" Int ")"
+               | "Name" "(" String ")"
+               | "Call" "(" Exp "," Exps ")"
+               | "Compare" "(" Exp "," CmpOps ")"
+               | "Subscript" "(" Exp "," Exp ")"
+               | "Slice" "(" Bound "," Bound "," Bound ")"
+               | "BinOp" "(" String "," Exp "," Exp ")"
+               | "UnaryOp" "(" String "," Exp ")"
+
+  syntax Bound ::= Exp | "NoBound"
+  syntax CmpOp ::= "CmpOp" "(" String "," Exp ")"
+
+  // Concrete arrays use seq(...).  An array value is a view into an Arr:
+  // offset O and length N.  Keeping slicing as a view makes recursive calls
+  // symbolic without copying or assuming a fixed input length.
+  syntax Ints ::= List{Int, ","}
+  syntax Arr ::= "seq" "(" Ints ")"
+  syntax Val ::= "intVal" "(" Int ")"
+               | "boolVal" "(" Bool ")"
+               | "arrayVal" "(" Arr "," Int "," Int ")"
+
+  syntax Function ::= "function" "(" Params "," Stmts ")"
+
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  syntax KItem ::= "invokeEntry" "(" Val ")"
+                 | "load" "(" Stmts ")"
+                 | "install" "(" String "," Params "," Stmts ")"
+                 | "invoke" "(" String "," Val ")"
+                 | "exec" "(" Stmts ")"
+                 | "eval" "(" Exp ")"
+                 | "value" "(" Val ")"
+                 | "assignTo" "(" String ")"
+                 | "branch" "(" Stmts "," Stmts "," Stmts ")"
+                 | "callValue" "(" String ")"
+                 | "applyLen"
+                 | "sliceFromOne"
+                 | "indexAt" "(" Int ")"
+                 | "unaryMinus"
+                 | "binLeft" "(" String "," Exp ")"
+                 | "binRight" "(" String "," Val ")"
+                 | "cmpLeft" "(" String "," Exp ")"
+                 | "cmpRight" "(" String "," Val ")"
+                 | "doReturn"
+                 | "noReturn"
+
+  syntax Stmts ::= "appendStmts" "(" Stmts "," Stmts ")" [function, total]
+  rule appendStmts(.Stmts, MORE) => MORE
+  rule appendStmts(S REST, MORE) => S appendStmts(REST, MORE)
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm ~> invokeEntry($ARGS:Val) </k>
+      <env> .Map </env>
+      <defs> .Map </defs>
+      <stack> .List </stack>
+    </mpy>
+
+  // Module loading. Function definitions are data in the definitions cell;
+  // calls below interpret their parameter and statement constructors.
+  rule <k> Module(SS) => load(SS) ... </k>
+  rule <k> load(.Stmts) => .K ... </k>
+  rule <k> load(FuncDef(F, PS, BODY) REST)
+        => install(F, PS, BODY) ~> load(REST) ... </k>
+  rule <k> install(F, PS, BODY) => .K ... </k>
+       <defs> DEFS => DEFS [ F <- function(PS, BODY) ] </defs>
+  rule <k> invokeEntry(V) => invoke("can_arrange", V) ... </k>
+
+  // A call saves the caller environment.  The K continuation itself holds
+  // the expression/statement continuation, so recursive calls remain visible
+  // to reachability logic and can be discharged inductively.
+  rule <k> invoke(F, V) => exec(BODY) ~> noReturn ... </k>
+       <env> CALLER => P |-> V </env>
+       <defs> ... F |-> function(Params(P, .Strings), BODY) ... </defs>
+       <stack> FRAMES => ListItem(CALLER) FRAMES </stack>
+
+  rule <k> exec(.Stmts) => .K ... </k>
+  rule <k> exec(Assign(Name(X), E) REST)
+        => eval(E) ~> assignTo(X) ~> exec(REST) ... </k>
+  rule <k> value(V) ~> assignTo(X) => .K ... </k>
+       <env> ENV => ENV [ X <- V ] </env>
+
+  rule <k> exec(If(COND, THEN, ELSE) REST)
+        => eval(COND) ~> branch(THEN, ELSE, REST) ... </k>
+  rule <k> value(boolVal(true)) ~> branch(THEN, _ELSE, REST)
+        => exec(appendStmts(THEN, REST)) ... </k>
+  rule <k> value(boolVal(false)) ~> branch(_THEN, ELSE, REST)
+        => exec(appendStmts(ELSE, REST)) ... </k>
+
+  rule <k> exec(Return(E) REST) => eval(E) ~> doReturn ... </k>
+  rule <k> value(V) ~> doReturn ~> noReturn => value(V) ... </k>
+       <env> _ => CALLER </env>
+       <stack> ListItem(CALLER) FRAMES => FRAMES </stack>
+
+  // Expressions needed by the emitted solution AST.
+  rule <k> eval(Int(I)) => value(intVal(I)) ... </k>
+  rule <k> eval(Name(X)) => value(V) ... </k>
+       <env> ... X |-> V ... </env>
+
+  rule <k> eval(UnaryOp("-", E)) => eval(E) ~> unaryMinus ... </k>
+  rule <k> value(intVal(I)) ~> unaryMinus => value(intVal(0 -Int I)) ... </k>
+
+  rule <k> eval(Call(Name("len"), E, .Exps)) => eval(E) ~> applyLen ... </k>
+  rule <k> value(arrayVal(A, O, N)) ~> applyLen => value(intVal(N)) ... </k>
+
+  rule <k> eval(Call(Name(F), E, .Exps)) => eval(E) ~> callValue(F) ... </k>
+       requires F =/=String "len"
+  rule <k> value(V) ~> callValue(F) => invoke(F, V) ... </k>
+
+  rule <k> eval(Subscript(E, Slice(Int(1), NoBound, NoBound)))
+        => eval(E) ~> sliceFromOne ... </k>
+  rule <k> value(arrayVal(A, O, N)) ~> sliceFromOne
+        => value(arrayVal(A, O +Int 1, N -Int 1)) ... </k>
+
+  rule <k> eval(Subscript(E, Int(I))) => eval(E) ~> indexAt(I) ... </k>
+  rule <k> value(arrayVal(A, O, N)) ~> indexAt(I)
+        => value(intVal(get(A, O +Int I))) ... </k>
+
+  rule <k> eval(BinOp(OP, LEFT, RIGHT))
+        => eval(LEFT) ~> binLeft(OP, RIGHT) ... </k>
+  rule <k> value(V) ~> binLeft(OP, RIGHT)
+        => eval(RIGHT) ~> binRight(OP, V) ... </k>
+  rule <k> value(intVal(J)) ~> binRight("+", intVal(I))
+        => value(intVal(I +Int J)) ... </k>
+
+  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT), .CmpOps))
+        => eval(LEFT) ~> cmpLeft(OP, RIGHT) ... </k>
+  rule <k> value(V) ~> cmpLeft(OP, RIGHT)
+        => eval(RIGHT) ~> cmpRight(OP, V) ... </k>
+  rule <k> value(intVal(J)) ~> cmpRight("<=", intVal(I))
+        => value(boolVal(I <=Int J)) ... </k>
+  rule <k> value(intVal(J)) ~> cmpRight("!=", intVal(I))
+        => value(boolVal(I =/=Int J)) ... </k>
+  rule <k> value(intVal(J)) ~> cmpRight("<", intVal(I))
+        => value(boolVal(I <Int J)) ... </k>
+
+  // Total symbolic array selection, plus executable equations for concrete
+  // seq(...) arrays. Proof claims only access indices known to be in bounds.
+  syntax Int ::= "get" "(" Arr "," Int ")" [function, total]
+               | "arrSize" "(" Arr ")" [function, total]
+               | "intsSize" "(" Ints ")" [function, total]
+  rule arrSize(seq(IS)) => intsSize(IS)
+  rule intsSize(.Ints) => 0
+  rule intsSize(I REST) => 1 +Int intsSize(REST)
+  rule get(seq(I, REST), 0) => I
+  rule get(seq(I, REST), N) => get(seq(REST), N -Int 1)
+       requires N >Int 0
+
+endmodule
