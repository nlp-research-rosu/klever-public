+        => <k> pyBool(#allTriples(S)) </k>
+
+  // Required entry point: the result is the prompt predicate for every
+  // finite input string, including the required length-at-least-three test.
+  claim <k> #call(#solution, "is_happy", pyStr(S)) </k>
+        => <k> pyBool(#happy(S)) </k>
+
+  // The six examples from prompt.py are also executable proof claims.
+  claim <k> #call(#solution, "is_happy", pyStr(ch(97, eps))) </k>
+        => <k> pyBool(false) </k>
+  claim <k> #call(#solution, "is_happy", pyStr(ch(97, ch(97, eps)))) </k>
+        => <k> pyBool(false) </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(97, ch(98, ch(99, ch(100, eps)))))) </k>
+        => <k> pyBool(true) </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(97, ch(97, ch(98, ch(98, eps)))))) </k>
+        => <k> pyBool(false) </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(97, ch(100, ch(98, eps))))) </k>
+        => <k> pyBool(true) </k>
