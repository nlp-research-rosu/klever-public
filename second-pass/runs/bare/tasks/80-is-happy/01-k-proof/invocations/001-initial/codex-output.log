+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Recursive helper correctness.  The four constructor shapes below are
+  // exhaustive; the final case is the inductive/circular proof step.
+  claim <k> #call(#solution, "check_happy_triples", pyStr(eps))
+          => pyBool(#allTriples(eps))
+        </k>
+  claim <k> #call(#solution, "check_happy_triples", pyStr(ch(A, eps)))
+          => pyBool(#allTriples(ch(A, eps)))
+        </k>
+  claim <k> #call(#solution, "check_happy_triples", pyStr(ch(A, ch(B, eps))))
+          => pyBool(#allTriples(ch(A, ch(B, eps))))
+        </k>
+  claim <k> #call(#solution, "check_happy_triples",
+                  pyStr(ch(A, ch(B, ch(C, REST)))))
+          => pyBool(#allTriples(ch(A, ch(B, ch(C, REST)))))
+        </k>
+    requires #len(REST) >=Int 0
+
+  // Required entry point.  These exhaustive shapes prove the prompt
+  // predicate for every finite string, including the minimum length test.
+  claim <k> #call(#solution, "is_happy", pyStr(eps))
+          => pyBool(#happy(eps))
+        </k>
+  claim <k> #call(#solution, "is_happy", pyStr(ch(A, eps)))
+          => pyBool(#happy(ch(A, eps)))
+        </k>
+  claim <k> #call(#solution, "is_happy", pyStr(ch(A, ch(B, eps))))
+          => pyBool(#happy(ch(A, ch(B, eps))))
+        </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(A, ch(B, ch(C, REST)))))
+          => pyBool(#happy(ch(A, ch(B, ch(C, REST)))))
+        </k>
+    requires #len(REST) >=Int 0
+
+  // The six examples from prompt.py are also executable proof claims.
+  claim <k> #call(#solution, "is_happy", pyStr(ch(97, eps)))
+          => pyBool(false)
+        </k>
+  claim <k> #call(#solution, "is_happy", pyStr(ch(97, ch(97, eps))))
+          => pyBool(false)
+        </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(97, ch(98, ch(99, ch(100, eps))))))
+          => pyBool(true)
+        </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(97, ch(97, ch(98, ch(98, eps))))))
+          => pyBool(false)
+        </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(97, ch(100, ch(98, eps)))))
+          => pyBool(true)
+        </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(120, ch(121, ch(121, eps)))))
+          => pyBool(false)
+        </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4b06839ffa0db366e5aa8ab8740c308902bf0985
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,58 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY-SEMANTIC
+
+  // Independent mathematical reading of the prompt.  #allTriples is true
+  // exactly when every length-three window has pairwise-distinct code points.
+  syntax Bool ::= #distinct3 ( Int , Int , Int ) [function, total]
+  rule #distinct3(A, B, C)
+    => notBool (A ==Int B)
+       andBool notBool (A ==Int C)
+       andBool notBool (B ==Int C)
+
+  syntax Bool ::= #allTriples ( PString ) [function, total]
+  rule #allTriples(eps) => true
+  rule #allTriples(ch(A, eps)) => true
+  rule #allTriples(ch(A, ch(B, eps))) => true
+  rule #allTriples(ch(A, ch(B, ch(C, REST))))
+    => #distinct3(A, B, C)
+       andBool #allTriples(ch(B, ch(C, REST)))
+
+  syntax Bool ::= #happy ( PString ) [function, total]
+  rule #happy(eps) => false
+  rule #happy(ch(A, eps)) => false
+  rule #happy(ch(A, ch(B, eps))) => false
+  rule #happy(S:PString) => #allTriples(S) requires #len(S) >=Int 3
+
+  // The exact constructor tree emitted in solution.mpy.  Giving it a name
+  // keeps proof claims readable while still forcing the semantics to execute
+  // precisely the translated implementation.
+  syntax Program ::= "#solution" [function]
+  rule #solution =>
+    Module(
+      FuncDef("is_happy", Params("s"),
+        If(Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
+          Return(Bool(false)),
+          .Stmts)
+        Return(Call(Name("check_happy_triples"), Name("s"))))
+      FuncDef("check_happy_triples", Params("s"),
+        If(Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
+          Return(Bool(true)),
+          .Stmts)
+        If(Compare(Subscript(Name("s"), Int(0)),
+                   CmpOp("==", Subscript(Name("s"), Int(1)))),
+          Return(Bool(false)),
+          .Stmts)
+        If(Compare(Subscript(Name("s"), Int(0)),
+                   CmpOp("==", Subscript(Name("s"), Int(2)))),
+          Return(Bool(false)),
+          .Stmts)
+        If(Compare(Subscript(Name("s"), Int(1)),
+                   CmpOp("==", Subscript(Name("s"), Int(2)))),
+          Return(Bool(false)),
+          .Stmts)
+        Return(Call(Name("check_happy_triples"),
+                    Subscript(Name("s"),
+                              Slice(Int(1), NoBound, NoBound))))))
+endmodule

