+  rule #asBool(pyBool(B)) => B
+  rule #asStr(pyStr(S)) => S
+
+  syntax Bool ::= #valueEq ( PValue , PValue ) [function]
+  rule #valueEq(pyInt(I), pyInt(J)) => I ==Int J
+
