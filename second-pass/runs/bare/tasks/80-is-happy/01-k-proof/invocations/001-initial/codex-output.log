+  syntax Bool ::= #valueEq ( PValue , PValue ) [function]
+  rule #valueEq(pyInt(I), pyInt(J)) => I ==Int J
+
+  // Function lookup retains the whole module so recursive calls use the same
+  // definitions.  This semantics deliberately implements only the AST nodes
+  // exercised by solution.mpy; unsupported constructs cannot silently run.
+  syntax PValue ::= #call ( Program , String , PValue ) [function]
+  syntax PValue ::= #findCall ( Stmts , Program , String , PValue ) [function]
+  rule #call(Module(DEFS), F, V) => #findCall(DEFS, Module(DEFS), F, V)
+  rule #findCall(FuncDef(F, Params(P), BODY) _REST, PGM, F, V)
+    => #exec(BODY, P, V, PGM)
+  rule #findCall(FuncDef(G, Params(_), _) REST, PGM, F, V)
+    => #findCall(REST, PGM, F, V)
+    requires F =/=String G
+
+  syntax PValue ::= #exec ( Stmts , String , PValue , Program ) [function]
+  syntax PValue ::= #choose ( Test , Stmts , Stmts , Stmts , String , PValue , Program )
+  syntax PValue ::= #branch ( Stmts , Stmts , String , PValue , Program ) [function]
+
+  rule #exec(Return(E) _, P, V, PGM) => #eval(E, P, V, PGM)
+  rule #exec(If(COND, YES, NO) REST, P, V, PGM)
+    => #choose(#asTest(#eval(COND, P, V, PGM)), YES, NO, REST, P, V, PGM)
+
+  rule #choose(yes, YES, _, REST, P, V, PGM)
+    => #branch(YES, REST, P, V, PGM)
+  rule #choose(no, _, NO, REST, P, V, PGM)
+    => #branch(NO, REST, P, V, PGM)
+
+  // Direct contextual rules expose constructor/equality case splits to the
+  // symbolic backend without relying on an evaluation-order extension.
+  rule #choose(#short3(eps), YES, _, REST, P, V, PGM)
+    => #branch(YES, REST, P, V, PGM)
+  rule #choose(#short3(ch(_, eps)), YES, _, REST, P, V, PGM)
+    => #branch(YES, REST, P, V, PGM)
+  rule #choose(#short3(ch(_, ch(_, eps))), YES, _, REST, P, V, PGM)
+    => #branch(YES, REST, P, V, PGM)
+  rule #choose(#short3(ch(_, ch(_, ch(_, _)))), _, NO, REST, P, V, PGM)
+    => #branch(NO, REST, P, V, PGM)
+  rule #choose(#same(I, I), YES, _, REST, P, V, PGM)
+    => #branch(YES, REST, P, V, PGM)
+  rule #choose(#same(I, J), _, NO, REST, P, V, PGM)
+    => #branch(NO, REST, P, V, PGM)
+    requires I =/=Int J
+
+  rule #branch(.Stmts, REST, P, V, PGM) => #exec(REST, P, V, PGM)
+  rule #branch(Return(E) _, _, P, V, PGM) => #eval(E, P, V, PGM)
+  rule #branch(If(COND, YES, NO) MORE, REST, P, V, PGM)
+    => #choose(#asTest(#eval(COND, P, V, PGM)), YES, NO,
+               #append(MORE, REST), P, V, PGM)
+
+  syntax Stmts ::= #append ( Stmts , Stmts ) [function, total]
+  rule #append(.Stmts, REST) => REST
+  rule #append(S MORE, REST) => S #append(MORE, REST)
+
+  syntax PValue ::= #eval ( Expr , String , PValue , Program ) [function]
+  rule #eval(Bool(B), _, _, _) => pyBool(B)
+  rule #eval(Int(I), _, _, _) => pyInt(I)
+  rule #eval(Name(P), P, V, _) => V
+
+  rule #eval(Call(Name("len"), E), P, V, PGM)
+    => pyInt(#len(#asStr(#eval(E, P, V, PGM))))
+  rule #eval(Call(Name(F), E), P, V, PGM)
+    => #call(PGM, F, #eval(E, P, V, PGM))
+    requires F =/=String "len"
+
+  rule #eval(Compare(Call(Name("len"), E), CmpOp("<", Int(3))), P, V, PGM)
+    => pyTest(#short3(#asStr(#eval(E, P, V, PGM))))
+  rule #eval(Compare(L, CmpOp("==", R)), P, V, PGM)
+    => pyTest(#same(#asInt(#eval(L, P, V, PGM)),
+                    #asInt(#eval(R, P, V, PGM))))
+
+  rule #eval(Subscript(E, Int(I)), P, V, PGM)
+    => pyInt(#at(#asStr(#eval(E, P, V, PGM)), I))
+  rule #eval(Subscript(E, Slice(Int(I), NoBound, NoBound)), P, V, PGM)
+    => pyStr(#drop(#asStr(#eval(E, P, V, PGM)), I))
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..5d9423813856074bef152b26e603af16df3de819
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,16 @@
+def is_happy(s):
+    if len(s) < 3:
+        return False
+    return check_happy_triples(s)
+
+
+def check_happy_triples(s):
+    if len(s) < 3:
+        return True
+    if s[0] == s[1]:
+        return False
+    if s[0] == s[2]:
+        return False
+    if s[1] == s[2]:
+        return False
+    return check_happy_triples(s[1:])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..7c886b6c76e8b85cf6279a2da591f90902e13fff
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,41 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Recursive helper correctness.  #short3 in the semantics supplies the
+  // exhaustive constructor split; the recursive branch uses this claim as a
+  // circularity only after consuming one character.
+  claim <k> #call(#solution, "check_happy_triples", pyStr(S))
+          => pyBool(#allTriples(S))
+        </k>
+
+  // Required entry point for every finite input string.
+  claim <k> #call(#solution, "is_happy", pyStr(S))
+          => pyBool(#happy(S))
+        </k>
+
+  // The six examples from prompt.py are also executable proof claims.
+  claim <k> #call(#solution, "is_happy", pyStr(ch(97, eps)))
+          => pyBool(false)
+        </k>
+  claim <k> #call(#solution, "is_happy", pyStr(ch(97, ch(97, eps))))
+          => pyBool(false)
+        </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(97, ch(98, ch(99, ch(100, eps))))))
+          => pyBool(true)
+        </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(97, ch(97, ch(98, ch(98, eps))))))
+          => pyBool(false)
+        </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(97, ch(100, ch(98, eps)))))
+          => pyBool(true)
+        </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(120, ch(121, ch(121, eps)))))
+          => pyBool(false)
+        </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d503ca5dcdbb1e1ebc2c30d3ef9f9534437fae90
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,59 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY-SEMANTIC
+
+  // Independent mathematical reading of the prompt.  #allTriples is true
+  // exactly when every length-three window has pairwise-distinct code points.
+  syntax Bool ::= #distinct3 ( Int , Int , Int ) [function, total]
+  rule #distinct3(A, B, C)
+    => notBool (A ==Int B)
+       andBool notBool (A ==Int C)
+       andBool notBool (B ==Int C)
+
+  syntax Bool ::= #allTriples ( PString ) [function, total]
+  rule #allTriples(eps) => true
+  rule #allTriples(ch(_A, eps)) => true
+  rule #allTriples(ch(_A, ch(_B, eps))) => true
+  rule #allTriples(ch(A, ch(B, ch(C, REST))))
+    => #distinct3(A, B, C)
+       andBool #allTriples(ch(B, ch(C, REST)))
+
+  syntax Bool ::= #happy ( PString ) [function, total]
+  rule #happy(eps) => false
+  rule #happy(ch(_A, eps)) => false
+  rule #happy(ch(_A, ch(_B, eps))) => false
+  rule #happy(ch(A, ch(B, ch(C, REST))))
+    => #allTriples(ch(A, ch(B, ch(C, REST))))
+
+  // The exact constructor tree emitted in solution.mpy.  Giving it a name
+  // keeps proof claims readable while still forcing the semantics to execute
+  // precisely the translated implementation.
+  syntax Program ::= "#solution" [function]
+  rule #solution =>
+    Module(
+      FuncDef("is_happy", Params("s"),
+        If(Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
+          Return(Bool(false)),
+          .Stmts)
+        Return(Call(Name("check_happy_triples"), Name("s"))))
+      FuncDef("check_happy_triples", Params("s"),
+        If(Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
+          Return(Bool(true)),
+          .Stmts)
+        If(Compare(Subscript(Name("s"), Int(0)),
+                   CmpOp("==", Subscript(Name("s"), Int(1)))),
+          Return(Bool(false)),
+          .Stmts)
+        If(Compare(Subscript(Name("s"), Int(0)),
+                   CmpOp("==", Subscript(Name("s"), Int(2)))),
+          Return(Bool(false)),
+          .Stmts)
+        If(Compare(Subscript(Name("s"), Int(1)),
+                   CmpOp("==", Subscript(Name("s"), Int(2)))),
+          Return(Bool(false)),
+          .Stmts)
+        Return(Call(Name("check_happy_triples"),
+                    Subscript(Name("s"),
+                              Slice(Int(1), NoBound, NoBound))))))
+endmodule

apply patch
patch: completed
/work/prove.sh
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..66fd770b102c5cdde277280fada1e1624972ef23
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,48 @@
+#!/usr/bin/env bash
+set -euo pipefail
+cd "$(dirname "$0")"
+
+python3 py2mpy.py solution.py > solution.mpy
+
+# verification.k names this exact constructor tree #solution.  Pinning the
+# regenerated tree prevents the proof from drifting away from solution.py.
+printf '%s  %s\n' \
+  'fd871e9b9fe673932b6f77f16595ee6a0fea1ae8d74e89c8fca2e0b11a1e604c' \
+  'solution.mpy' | sha256sum --check -
+
+python3 - <<'PY'
+from itertools import product
+from solution import is_happy
+
+def oracle(s):
+    return len(s) >= 3 and all(
+        len(set(s[i:i + 3])) == 3 for i in range(len(s) - 2)
+    )
+
+for size in range(8):
+    for letters in product("abc", repeat=size):
+        text = "".join(letters)
+        assert is_happy(text) == oracle(text)
+PY
+
+kompile semantic.k \
+  --main-module MPY-SEMANTIC \
+  --syntax-module MPY-SYNTAX \
+  --backend llvm \
+  --output-definition semantic-kompiled
+
+krun solution.mpy -cINPUT='eps' --definition semantic-kompiled
+krun solution.mpy -cINPUT='ch(97, eps)' --definition semantic-kompiled
+krun solution.mpy -cINPUT='ch(97, ch(97, eps))' --definition semantic-kompiled
+krun solution.mpy -cINPUT='ch(97, ch(98, ch(99, ch(100, eps))))' --definition semantic-kompiled
+krun solution.mpy -cINPUT='ch(97, ch(97, ch(98, ch(98, eps))))' --definition semantic-kompiled
+krun solution.mpy -cINPUT='ch(97, ch(100, ch(98, eps)))' --definition semantic-kompiled
+krun solution.mpy -cINPUT='ch(120, ch(121, ch(121, eps)))' --definition semantic-kompiled
+
+kompile verification.k \
+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION \
+  --backend haskell \
+  --output-definition verification-kompiled
+
+kprove spec.k --definition verification-kompiled
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..83106a96464c69cd099bd7d13ef54f664a45c738
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,160 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  // A finite Python string represented as a list of Unicode code points.
+  syntax PString ::= "eps"
+                   | "ch" "(" Int "," PString ")"
+
+  syntax PValue ::= "pyInt" "(" Int ")"
+                  | "pyBool" "(" Bool ")"
+                  | "pyStr" "(" PString ")"
+                  | "pyTest" "(" Test ")"
+
+  syntax Test ::= "yes" | "no"
+                | "#short3" "(" PString ")"
+                | "#same" "(" Int "," Int ")"
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax Expr ::= "Bool" "(" Bool ")"
+                | "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "Call" "(" Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "Slice" "(" Bound "," Bound "," Bound ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Bound ::= "NoBound" | Expr
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+
+  configuration
+    <k> #call($PGM:Program, "is_happy", pyStr($INPUT:PString)) </k>
+
+  // Mathematical operations on the concrete inductive representation of
+  // Python strings.  Code points are compared as Python characters are.
+  syntax Int ::= #len ( PString ) [function, total]
+  rule #len(eps) => 0
+  rule #len(ch(_, S)) => 1 +Int #len(S)
+
+  syntax Int ::= #at ( PString , Int ) [function]
+  rule #at(ch(C, _), 0) => C
+  rule #at(ch(_, S), I) => #at(S, I -Int 1) requires I >Int 0
+
+  syntax PString ::= #drop ( PString , Int ) [function]
+  rule #drop(S, 0) => S
+  rule #drop(ch(_, S), I) => #drop(S, I -Int 1) requires I >Int 0
+
+  // This non-functional predicate gives symbolic execution an explicit,
+  // exhaustive constructor split for the only length test in solution.mpy.
+  rule #short3(eps) => yes
+  rule #short3(ch(_, eps)) => yes
+  rule #short3(ch(_, ch(_, eps))) => yes
+  rule #short3(ch(_, ch(_, ch(_, _)))) => no
+
+  rule #same(I, I) => yes
+  rule #same(I, J) => no requires I =/=Int J
+
+  syntax Int ::= #asInt ( PValue ) [function]
+  syntax Bool ::= #asBool ( PValue ) [function]
+  syntax PString ::= #asStr ( PValue ) [function]
+  syntax Test ::= #asTest ( PValue ) [function]
+  rule #asInt(pyInt(I)) => I
+  rule #asBool(pyBool(B)) => B
+  rule #asStr(pyStr(S)) => S
+  rule #asTest(pyTest(T)) => T
+
+  syntax Bool ::= #valueEq ( PValue , PValue ) [function]
+  rule #valueEq(pyInt(I), pyInt(J)) => I ==Int J
+
+  // Function lookup retains the whole module so recursive calls use the same
+  // definitions.  This semantics deliberately implements only the AST nodes
+  // exercised by solution.mpy; unsupported constructs cannot silently run.
+  syntax PValue ::= #call ( Program , String , PValue ) [function]
+  syntax PValue ::= #findCall ( Stmts , Program , String , PValue ) [function]
+  rule #call(Module(DEFS), F, V) => #findCall(DEFS, Module(DEFS), F, V)
+  rule #findCall(FuncDef(F, Params(P), BODY) _REST, PGM, F, V)
+    => #exec(BODY, P, V, PGM)
+  rule #findCall(FuncDef(G, Params(_), _) REST, PGM, F, V)
+    => #findCall(REST, PGM, F, V)
+    requires F =/=String G
+
+  syntax PValue ::= #exec ( Stmts , String , PValue , Program ) [function]
+  syntax PValue ::= #choose ( Test , Stmts , Stmts , Stmts , String , PValue , Program )
+  syntax PValue ::= #branch ( Stmts , Stmts , String , PValue , Program ) [function]
+
+  rule #exec(Return(E) _, P, V, PGM) => #eval(E, P, V, PGM)
+  rule #exec(If(COND, YES, NO) REST, P, V, PGM)
+    => #choose(#asTest(#eval(COND, P, V, PGM)), YES, NO, REST, P, V, PGM)
+
+  rule #choose(yes, YES, _, REST, P, V, PGM)
+    => #branch(YES, REST, P, V, PGM)
+  rule #choose(no, _, NO, REST, P, V, PGM)
+    => #branch(NO, REST, P, V, PGM)
+
+  // Direct contextual rules expose constructor/equality case splits to the
+  // symbolic backend without relying on an evaluation-order extension.
+  rule #choose(#short3(eps), YES, _, REST, P, V, PGM)
+    => #branch(YES, REST, P, V, PGM)
+  rule #choose(#short3(ch(_, eps)), YES, _, REST, P, V, PGM)
+    => #branch(YES, REST, P, V, PGM)
+  rule #choose(#short3(ch(_, ch(_, eps))), YES, _, REST, P, V, PGM)
+    => #branch(YES, REST, P, V, PGM)
+  rule #choose(#short3(ch(_, ch(_, ch(_, _)))), _, NO, REST, P, V, PGM)
+    => #branch(NO, REST, P, V, PGM)
+  rule #choose(#same(I, I), YES, _, REST, P, V, PGM)
+    => #branch(YES, REST, P, V, PGM)
+  rule #choose(#same(I, J), _, NO, REST, P, V, PGM)
+    => #branch(NO, REST, P, V, PGM)
+    requires I =/=Int J
+
+  rule #branch(.Stmts, REST, P, V, PGM) => #exec(REST, P, V, PGM)
+  rule #branch(Return(E) _, _, P, V, PGM) => #eval(E, P, V, PGM)
+  rule #branch(If(COND, YES, NO) MORE, REST, P, V, PGM)
+    => #choose(#asTest(#eval(COND, P, V, PGM)), YES, NO,
+               #append(MORE, REST), P, V, PGM)
+
+  syntax Stmts ::= #append ( Stmts , Stmts ) [function, total]
+  rule #append(.Stmts, REST) => REST
+  rule #append(S MORE, REST) => S #append(MORE, REST)
+
+  syntax PValue ::= #eval ( Expr , String , PValue , Program ) [function]
+  rule #eval(Bool(B), _, _, _) => pyBool(B)
+  rule #eval(Int(I), _, _, _) => pyInt(I)
+  rule #eval(Name(P), P, V, _) => V
+
+  rule #eval(Call(Name("len"), E), P, V, PGM)
+    => pyInt(#len(#asStr(#eval(E, P, V, PGM))))
+  rule #eval(Call(Name(F), E), P, V, PGM)
+    => #call(PGM, F, #eval(E, P, V, PGM))
+    requires F =/=String "len"
+
+  rule #eval(Compare(Call(Name("len"), E), CmpOp("<", Int(3))), P, V, PGM)
+    => pyTest(#short3(#asStr(#eval(E, P, V, PGM))))
+  rule #eval(Compare(L, CmpOp("==", R)), P, V, PGM)
+    => pyTest(#same(#asInt(#eval(L, P, V, PGM)),
+                    #asInt(#eval(R, P, V, PGM))))
+
+  rule #eval(Subscript(E, Int(I)), P, V, PGM)
+    => pyInt(#at(#asStr(#eval(E, P, V, PGM)), I))
+  rule #eval(Subscript(E, Slice(Int(I), NoBound, NoBound)), P, V, PGM)
+    => pyStr(#drop(#asStr(#eval(E, P, V, PGM)), I))
+endmodule
