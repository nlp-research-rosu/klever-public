+    => #call(PGM, F, #eval(E, P, V, PGM))
+    requires F =/=String "len"
+
+  rule #eval(Compare(Call(Name("len"), E), CmpOp("<", Int(3))), P, V, PGM)
+    => pyTest(#short3(#asStr(#eval(E, P, V, PGM))))
+  rule #eval(Compare(L, CmpOp("==", R)), P, V, PGM)
