+  rule #call(Module(DEFS), F, V) => #findCall(DEFS, Module(DEFS), F, V)
+  rule #findCall(FuncDef(F, Params(P), BODY) REST, PGM, F, V)
+    => #exec(BODY, P, V, PGM)
+  rule #findCall(FuncDef(G, Params(_), _) REST, PGM, F, V)
+    => #findCall(REST, PGM, F, V)
