@@ -0,0 +1,128 @@
+requires "domains.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  // A finite Python string represented as a list of Unicode code points.
+  syntax PString ::= "eps"
+                   | "ch" "(" Int "," PString ")"
+
+  syntax PValue ::= "pyInt" "(" Int ")"
+                  | "pyBool" "(" Bool ")"
+                  | "pyStr" "(" PString ")"
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax Expr ::= "Bool" "(" Bool ")"
+                | "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "Call" "(" Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "Slice" "(" Bound "," Bound "," Bound ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Bound ::= "NoBound" | Expr
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+
+  configuration
+    <k> #call($PGM:Program, "is_happy", pyStr($INPUT:PString)) </k>
+
+  // Mathematical operations on the concrete inductive representation of
+  // Python strings.  Code points are compared as Python characters are.
+  syntax Int ::= #len ( PString ) [function, total]
+  rule #len(eps) => 0
+  rule #len(ch(_, S)) => 1 +Int #len(S)
+
+  syntax Int ::= #at ( PString , Int ) [function]
+  rule #at(ch(C, _), 0) => C
+  rule #at(ch(_, S), I) => #at(S, I -Int 1) requires I >Int 0
+
+  syntax PString ::= #drop ( PString , Int ) [function]
+  rule #drop(S, 0) => S
+  rule #drop(ch(_, S), I) => #drop(S, I -Int 1) requires I >Int 0
+
+  syntax Int ::= #asInt ( PValue ) [function]
+  syntax Bool ::= #asBool ( PValue ) [function]
+  syntax PString ::= #asStr ( PValue ) [function]
+  rule #asInt(pyInt(I)) => I
+  rule #asBool(pyBool(B)) => B
+  rule #asStr(pyStr(S)) => S
+
+  syntax Bool ::= #valueEq ( PValue , PValue ) [function]
+  rule #valueEq(pyInt(I), pyInt(J)) => I ==Int J
+
+  // Function lookup retains the whole module so recursive calls use the same
+  // definitions.  This semantics deliberately implements only the AST nodes
+  // exercised by solution.mpy; unsupported constructs cannot silently run.
+  syntax PValue ::= #call ( Program , String , PValue ) [function]
+  syntax PValue ::= #findCall ( Stmts , Program , String , PValue ) [function]
+  rule #call(Module(DEFS), F, V) => #findCall(DEFS, Module(DEFS), F, V)
+  rule #findCall(FuncDef(F, Params(P), BODY) REST, PGM, F, V)
+    => #exec(BODY, P, V, PGM)
+  rule #findCall(FuncDef(G, Params(_), _) REST, PGM, F, V)
+    => #findCall(REST, PGM, F, V)
+    requires F =/=String G
+
+  syntax PValue ::= #exec ( Stmts , String , PValue , Program ) [function]
+  syntax PValue ::= #choose ( Bool , Stmts , Stmts , Stmts , String , PValue , Program ) [function]
+  syntax PValue ::= #branch ( Stmts , Stmts , String , PValue , Program ) [function]
+
+  rule #exec(Return(E) _, P, V, PGM) => #eval(E, P, V, PGM)
+  rule #exec(If(COND, YES, NO) REST, P, V, PGM)
+    => #choose(#asBool(#eval(COND, P, V, PGM)), YES, NO, REST, P, V, PGM)
+
+  rule #choose(B, YES, _, REST, P, V, PGM)
+    => #branch(YES, REST, P, V, PGM)
+    requires B
+  rule #choose(B, _, NO, REST, P, V, PGM)
+    => #branch(NO, REST, P, V, PGM)
+    requires notBool B
+
+  rule #branch(.Stmts, REST, P, V, PGM) => #exec(REST, P, V, PGM)
+  rule #branch(Return(E) _, _, P, V, PGM) => #eval(E, P, V, PGM)
+  rule #branch(If(COND, YES, NO) MORE, REST, P, V, PGM)
+    => #choose(#asBool(#eval(COND, P, V, PGM)), YES, NO,
+               #append(MORE, REST), P, V, PGM)
+
+  syntax Stmts ::= #append ( Stmts , Stmts ) [function, total]
+  rule #append(.Stmts, REST) => REST
+  rule #append(S MORE, REST) => S #append(MORE, REST)
+
+  syntax PValue ::= #eval ( Expr , String , PValue , Program ) [function]
+  rule #eval(Bool(B), _, _, _) => pyBool(B)
+  rule #eval(Int(I), _, _, _) => pyInt(I)
+  rule #eval(Name(P), P, V, _) => V
+
+  rule #eval(Call(Name("len"), E), P, V, PGM)
+    => pyInt(#len(#asStr(#eval(E, P, V, PGM))))
+  rule #eval(Call(Name(F), E), P, V, PGM)
+    => #call(PGM, F, #eval(E, P, V, PGM))
+    requires F =/=String "len"
+
+  rule #eval(Compare(L, CmpOp("<", R)), P, V, PGM)
+    => pyBool(#asInt(#eval(L, P, V, PGM)) <Int #asInt(#eval(R, P, V, PGM)))
+  rule #eval(Compare(L, CmpOp("==", R)), P, V, PGM)
+    => pyBool(#valueEq(#eval(L, P, V, PGM), #eval(R, P, V, PGM)))
+
+  rule #eval(Subscript(E, Int(I)), P, V, PGM)
+    => pyInt(#at(#asStr(#eval(E, P, V, PGM)), I))
+  rule #eval(Subscript(E, Slice(Int(I), NoBound, NoBound)), P, V, PGM)
+    => pyStr(#drop(#asStr(#eval(E, P, V, PGM)), I))
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..5d9423813856074bef152b26e603af16df3de819
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,16 @@
+def is_happy(s):
+    if len(s) < 3:
+        return False
+    return check_happy_triples(s)
+
+
+def check_happy_triples(s):
+    if len(s) < 3:
+        return True
+    if s[0] == s[1]:
+        return False
+    if s[0] == s[2]:
+        return False
+    if s[1] == s[2]:
+        return False
+    return check_happy_triples(s[1:])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..12558dbdd7832611ee5ec64ada95713ac269b434
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,61 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Recursive helper correctness.  The four constructor shapes below are
+  // exhaustive; the final case is the inductive/circular proof step.
+  claim <k> #call(#solution, "check_happy_triples", pyStr(eps))
+          => pyBool(#allTriples(eps))
+        </k>
+  claim <k> #call(#solution, "check_happy_triples", pyStr(ch(A, eps)))
+          => pyBool(#allTriples(ch(A, eps)))
+        </k>
+  claim <k> #call(#solution, "check_happy_triples", pyStr(ch(A, ch(B, eps))))
+          => pyBool(#allTriples(ch(A, ch(B, eps)))
+        </k>
+  claim <k> #call(#solution, "check_happy_triples",
+                  pyStr(ch(A, ch(B, ch(C, REST)))))
+          => pyBool(#allTriples(ch(A, ch(B, ch(C, REST))))
+        </k>
+
+  // Required entry point.  These exhaustive shapes prove the prompt
+  // predicate for every finite string, including the minimum length test.
+  claim <k> #call(#solution, "is_happy", pyStr(eps))
+          => pyBool(#happy(eps))
+        </k>
+  claim <k> #call(#solution, "is_happy", pyStr(ch(A, eps)))
+          => pyBool(#happy(ch(A, eps)))
+        </k>
+  claim <k> #call(#solution, "is_happy", pyStr(ch(A, ch(B, eps))))
+          => pyBool(#happy(ch(A, ch(B, eps))))
+        </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(A, ch(B, ch(C, REST)))))
+          => pyBool(#happy(ch(A, ch(B, ch(C, REST))))
+        </k>
+
+  // The six examples from prompt.py are also executable proof claims.
+  claim <k> #call(#solution, "is_happy", pyStr(ch(97, eps)))
+          => pyBool(false)
+        </k>
+  claim <k> #call(#solution, "is_happy", pyStr(ch(97, ch(97, eps))))
+          => pyBool(false)
+        </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(97, ch(98, ch(99, ch(100, eps))))))
+          => pyBool(true)
+        </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(97, ch(97, ch(98, ch(98, eps))))))
+          => pyBool(false)
+        </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(97, ch(100, ch(98, eps)))))
+          => pyBool(true)
+        </k>
+  claim <k> #call(#solution, "is_happy",
+                  pyStr(ch(120, ch(121, ch(121, eps)))))
+          => pyBool(false)
+        </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4b06839ffa0db366e5aa8ab8740c308902bf0985
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,58 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY-SEMANTIC
+
+  // Independent mathematical reading of the prompt.  #allTriples is true
+  // exactly when every length-three window has pairwise-distinct code points.
+  syntax Bool ::= #distinct3 ( Int , Int , Int ) [function, total]
+  rule #distinct3(A, B, C)
+    => notBool (A ==Int B)
+       andBool notBool (A ==Int C)
+       andBool notBool (B ==Int C)
+
+  syntax Bool ::= #allTriples ( PString ) [function, total]
+  rule #allTriples(eps) => true
+  rule #allTriples(ch(A, eps)) => true
+  rule #allTriples(ch(A, ch(B, eps))) => true
+  rule #allTriples(ch(A, ch(B, ch(C, REST))))
+    => #distinct3(A, B, C)
+       andBool #allTriples(ch(B, ch(C, REST)))
+
+  syntax Bool ::= #happy ( PString ) [function, total]
+  rule #happy(eps) => false
+  rule #happy(ch(A, eps)) => false
+  rule #happy(ch(A, ch(B, eps))) => false
+  rule #happy(S:PString) => #allTriples(S) requires #len(S) >=Int 3
+
+  // The exact constructor tree emitted in solution.mpy.  Giving it a name
+  // keeps proof claims readable while still forcing the semantics to execute
+  // precisely the translated implementation.
+  syntax Program ::= "#solution" [function]
+  rule #solution =>
+    Module(
+      FuncDef("is_happy", Params("s"),
+        If(Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
+          Return(Bool(false)),
+          .Stmts)
+        Return(Call(Name("check_happy_triples"), Name("s"))))
+      FuncDef("check_happy_triples", Params("s"),
+        If(Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
+          Return(Bool(true)),
+          .Stmts)
+        If(Compare(Subscript(Name("s"), Int(0)),
+                   CmpOp("==", Subscript(Name("s"), Int(1)))),
+          Return(Bool(false)),
+          .Stmts)
+        If(Compare(Subscript(Name("s"), Int(0)),
+                   CmpOp("==", Subscript(Name("s"), Int(2)))),
+          Return(Bool(false)),
+          .Stmts)
+        If(Compare(Subscript(Name("s"), Int(1)),
+                   CmpOp("==", Subscript(Name("s"), Int(2)))),
+          Return(Bool(false)),
+          .Stmts)
+        Return(Call(Name("check_happy_triples"),
+                    Subscript(Name("s"),
+                              Slice(Int(1), NoBound, NoBound))))))
+endmodule

exec
/bin/bash -lc 'kompile verification.k --main-module VERIFICATION --backend haskell --output-definition verification-kompiled && kprove spec.k --definition verification-kompiled' in /work
