Module(
  FuncDef("is_happy", Params("s"),
    If(Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
      Return(Bool(false)),
      )
    Return(Call(Name("check_happy_triples"), Name("s"))))
  FuncDef("check_happy_triples", Params("s"),
    If(Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
      Return(Bool(true)),
      )
    If(Compare(
      Subscript(Name("s"), Int(0)),
      CmpOp("==", Subscript(Name("s"), Int(1)))),
      Return(Bool(false)),
      )
    If(Compare(
      Subscript(Name("s"), Int(0)),
      CmpOp("==", Subscript(Name("s"), Int(2)))),
      Return(Bool(false)),
      )
    If(Compare(
      Subscript(Name("s"), Int(1)),
      CmpOp("==", Subscript(Name("s"), Int(2)))),
      Return(Bool(false)),
      )
    Return(
      Call(
        Name("check_happy_triples"),
        Subscript(Name("s"), Slice(Int(1), NoBound, NoBound))))))
