FILE=solution.py
     1	def is_happy(s):
     2	    if len(s) < 3:
     3	        return False
     4	    return check_happy_triples(s)
     5	
     6	
     7	def check_happy_triples(s):
     8	    if len(s) < 3:
     9	        return True
    10	    if s[0] == s[1]:
    11	        return False
    12	    if s[0] == s[2]:
    13	        return False
    14	    if s[1] == s[2]:
    15	        return False
    16	    return check_happy_triples(s[1:])
