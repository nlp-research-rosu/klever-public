    52	  // Mathematical operations on the concrete inductive representation of
    53	  // Python strings.  Code points are compared as Python characters are.
    54	  syntax Int ::= #len ( PString ) [function, total]
    55	  rule #len(eps) => 0
    56	  rule #len(ch(_, S)) => 1 +Int #len(S)
