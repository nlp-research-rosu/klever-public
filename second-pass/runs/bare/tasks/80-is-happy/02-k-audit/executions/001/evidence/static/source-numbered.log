FILE=verification.k
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY-SEMANTIC
     5	
     6	  // Independent mathematical reading of the prompt.  #allTriples is true
     7	  // exactly when every length-three window has pairwise-distinct code points.
     8	  syntax Bool ::= #distinct3 ( Int , Int , Int ) [function, total]
     9	  rule #distinct3(A, B, C)
    10	    => notBool (A ==Int B)
    11	       andBool notBool (A ==Int C)
    12	       andBool notBool (B ==Int C)
    13	
    14	  syntax Bool ::= #allTriples ( PString ) [function, total]
    15	  rule #allTriples(eps) => true
    16	  rule #allTriples(ch(_A, eps)) => true
    17	  rule #allTriples(ch(_A, ch(_B, eps))) => true
    18	  rule #allTriples(ch(A, ch(B, ch(C, REST))))
    19	    => #distinct3(A, B, C)
    20	       andBool #allTriples(ch(B, ch(C, REST)))
    21	
    22	  syntax Bool ::= #happy ( PString ) [function, total]
    23	  rule #happy(eps) => false
    24	  rule #happy(ch(_A, eps)) => false
    25	  rule #happy(ch(_A, ch(_B, eps))) => false
    26	  rule #happy(ch(A, ch(B, ch(C, REST))))
    27	    => #allTriples(ch(A, ch(B, ch(C, REST))))
    28	
    29	  // The exact constructor tree emitted in solution.mpy.  Giving it a name
    30	  // keeps proof claims readable while still forcing the semantics to execute
    31	  // precisely the translated implementation.
    32	  syntax Program ::= "#solution" [function]
    33	  rule #solution =>
    34	    Module(
    35	      FuncDef("is_happy", Params("s"),
    36	        If(Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
    37	          Return(Bool(false)),
    38	          .Stmts)
    39	        Return(Call(Name("check_happy_triples"), Name("s"))))
    40	      FuncDef("check_happy_triples", Params("s"),
    41	        If(Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
    42	          Return(Bool(true)),
    43	          .Stmts)
    44	        If(Compare(Subscript(Name("s"), Int(0)),
    45	                   CmpOp("==", Subscript(Name("s"), Int(1)))),
    46	          Return(Bool(false)),
    47	          .Stmts)
    48	        If(Compare(Subscript(Name("s"), Int(0)),
    49	                   CmpOp("==", Subscript(Name("s"), Int(2)))),
    50	          Return(Bool(false)),
    51	          .Stmts)
    52	        If(Compare(Subscript(Name("s"), Int(1)),
    53	                   CmpOp("==", Subscript(Name("s"), Int(2)))),
    54	          Return(Bool(false)),
    55	          .Stmts)
    56	        Return(Call(Name("check_happy_triples"),
    57	                    Subscript(Name("s"),
    58	                              Slice(Int(1), NoBound, NoBound))))))
    59	endmodule
