    Your task is to check if the string is happy or not.
    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct
    For example:
    is_happy(a) => False
    is_happy(aa) => False
    is_happy(abcd) => True
    is_happy(aabb) => False
    is_happy(adb) => True
    is_happy(xyy) => False
    """
# canonical.py — the UNMODIFIED HumanEval/80 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: is_happy


def is_happy(s):
    """You are given a string s.
    Your task is to check if the string is happy or not.
    A string is happy if its length is at least 3 and every 3 consecutive letters are distinct
    For example:
    is_happy(a) => False
    is_happy(aa) => False
    is_happy(abcd) => True
    is_happy(aabb) => False
    is_happy(adb) => True
    is_happy(xyy) => False
    """
    if len(s) < 3:
      return False

    for i in range(len(s) - 2):
      
      if s[i] == s[i+1] or s[i+1] == s[i+2] or s[i] == s[i+2]:
        return False
    return True
def is_happy(s):
    if len(s) < 3:
        return False
    return check_happy_triples(s)


def check_happy_triples(s):
    if len(s) < 3:
        return True
    if s[0] == s[1]:
        return False
    if s[0] == s[2]:
        return False
    if s[1] == s[2]:
        return False
    return check_happy_triples(s[1:])
Module(
  FuncDef("is_happy", Params("s"),
    If(Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
