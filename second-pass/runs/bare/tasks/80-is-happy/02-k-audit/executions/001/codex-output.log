      messages.append((n,'PARSE_ERROR',str(e))); continue
    t=x.get('type','?'); counts[t]=counts.get(t,0)+1
    payload=x.get('payload',{})
    pt=payload.get('type') if isinstance(payload,dict) else None
    if pt in ('message','function_call','function_call_output') or t in ('response_item','event_msg'):
      s=json.dumps(x,ensure_ascii=False)
      if any(k.lower() in s.lower() for k in ('#top','kprove','kompile','proof.md','error','timeout','final_answer')):
        messages.append((n,t,s[:2000]))
print('TRACE',p)
print('COUNTS',json.dumps(counts,sort_keys=True))
print('SELECTED',len(messages))
