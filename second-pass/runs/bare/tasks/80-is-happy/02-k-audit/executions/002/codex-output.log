+  62-64  #drop [function]: drop 0; positive-count recursion
+  68-71  #short3 ordinary rules: lengths 0,1,2 -> yes; >=3 -> no
+  73-74  #same ordinary rules: equal -> yes; unequal -> no
+  76-83  #asInt/#asBool/#asStr/#asTest [function], one typed projection each
+  85-86  #valueEq [function], pyInt equality only (unused)
+  91-98  #call/#findCall [function]: module lookup, matching definition,
+         unequal-name scan
+  100-106 #exec [function]: Return and If
+  101,108-127 #choose ordinary syntax/rules: yes/no branch; four PString
+         evaluation-context cases; two guarded Int-equality context cases
+  102,129-133 #branch [function]: empty branch resumes REST; Return exits;
+         nested If appends continuation
+  135-137 #append [function,total]: empty and cons cases
+  139-159 #eval [function]: Bool, Int, bound Name, builtin len call,
+         non-len function call, len<3 comparison, Int equality comparison,
+         integer subscript, [I:] slice
