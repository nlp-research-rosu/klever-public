from pathlib import Path
from hashlib import sha256
from itertools import product
roots=[(Path('/candidate'),'eba34e6886199e7771227eb29acb75daf448f3f70514954b8e1273d3c3f14c59'),(Path('/generation-evidence/codex-trace'),'7bd7babaf37a42d41b4ee0c515fd6adf52ce0bbb43b3d20b976aa4a04dd055ef')]
seps=[b'',b'\\0',b'\\n',b' ',b':']
kinds=[(b'',b''),(b'file',b'directory'),(b'F',b'D'),(b'f',b'd')]
for include_dirs,sep1,sep2,(fk,dk),payload in product([False,True],seps,seps,kinds,['bytes','hashraw','hashhex','sizebytes']):
 ok=[]
 for root,target in roots:
  h=sha256()
  for p in sorted(root.rglob('*')):
   if p.is_dir() and not include_dirs: continue
   rel=p.relative_to(root).as_posix().encode(); kind=dk if p.is_dir() else fk
   if p.is_dir(): data=b''
   else:
    b=p.read_bytes()
    data={'bytes':b,'hashraw':sha256(b).digest(),'hashhex':sha256(b).hexdigest().encode(),'sizebytes':str(len(b)).encode()+b}[payload]
   h.update(rel+sep1+kind+sep2+data)
  ok.append(h.hexdigest()==target)
 if all(ok): print('MATCH',include_dirs,sep1,sep2,fk,dk,payload)
