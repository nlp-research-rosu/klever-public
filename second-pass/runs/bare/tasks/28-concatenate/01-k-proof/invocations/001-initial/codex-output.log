+  rule <k> loop(_, .StrList, _) => .K ... </k>
+  rule <k> loop(X, S :: REST, BODY)
+        => bindLoop(X, sVal(S)) ~> BODY ~> loop(X, REST, BODY) ... </k>
+  rule <k> bindLoop("string", V) => .K ... </k>
+       <iterationItem> _ => V </iterationItem>
