+requires "verification.k"
+
+module MPY-SYNTAX
+  imports STRING
+
+  syntax Pgm ::= PyProgram
+
+  syntax PyProgram ::= "Module" "(" PyStmts ")"
+  syntax PyStmts ::= List{PyStmt, ""}
+
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax PyStmt ::= "ImportFrom" "(" String "," String ")"
+                  | "FuncDef" "(" String "," Params "," PyStmts ")"
+                  | "Assign" "(" PyExpr "," PyExpr ")"
+                  | "For" "(" PyExpr "," PyExpr "," PyStmts ")"
+                  | "Return" "(" PyExpr ")"
+
+  syntax PyExpr ::= "Name" "(" String ")"
+                  | "Str" "(" String ")"
+                  | "BinOp" "(" String "," PyExpr "," PyExpr ")"
+
+  syntax StrList ::= ".StrList"
+                   | String "::" StrList
+  syntax PyVal ::= "sVal" "(" String ")"
+                 | "lVal" "(" StrList ")"
+
+  syntax Function ::= "noFunction"
+                    | "function" "(" String "," String "," PyStmts ")"
+  syntax Result ::= "noResult" | PyVal
+
+  syntax KItem ::= "load" "(" PyProgram ")"
+                 | "moduleLoaded"
+                 | "invoke" "(" String "," PyVal ")"
+                 | "assignTo" "(" String ")"
+                 | "addLeft" "(" PyExpr ")"
+                 | "addRight" "(" PyVal ")"
+                 | "startFor" "(" String "," PyStmts ")"
+                 | "loop" "(" String "," StrList "," PyStmts ")"
+                 | "bindLoop" "(" String "," PyVal ")"
+                 | "finishReturn"
+                 | "cleanup"
+endmodule
+
+module MPY-SEMANTICS
+  imports MPY-SYNTAX
+  imports VERIFICATION
+
+  configuration
+    <py>
+      <k> load($PGM:PyProgram) ~> invoke("concatenate", $ARG:PyVal) </k>
+      <function> noFunction </function>
+      <argument> lVal(.StrList) </argument>
+      <accumulator> sVal("") </accumulator>
+      <iterationItem> sVal("") </iterationItem>
+      <result> noResult </result>
+    </py>
+
+  // Module loading.
+  rule <k> load(Module(STMTS)) => STMTS ~> moduleLoaded ... </k>
+  rule <k> .PyStmts => .K ... </k>
+  rule <k> (S:PyStmt REST:PyStmts) => S ~> REST ... </k>
+  rule <k> ImportFrom(_, _) => .K ... </k>
+  rule <k> FuncDef(F, Params(P), BODY) => .K ... </k>
+       <function> _ => function(F, P, BODY) </function>
+  rule <k> moduleLoaded => .K ... </k>
+
+  // The sole call frame needed by this first-order task.
+  rule <k> invoke(F, ARG) => BODY ~> cleanup ... </k>
+       <function> function(F, "strings", BODY) </function>
+       <argument> _ => ARG </argument>
+
+  // Expressions and assignment.
+  rule <k> Str(S) => sVal(S) ... </k>
+  rule <k> Name("strings") => V ... </k>
+       <argument> V </argument>
+  rule <k> Name("result") => V ... </k>
+       <accumulator> V </accumulator>
+  rule <k> Name("string") => V ... </k>
+       <iterationItem> V </iterationItem>
+  rule <k> Assign(Name(X), E) => E ~> assignTo(X) ... </k>
+  rule <k> V:PyVal ~> assignTo("result") => .K ... </k>
+       <accumulator> _ => V </accumulator>
+  rule <k> BinOp("+", LEFT, RIGHT) => LEFT ~> addLeft(RIGHT) ... </k>
+  rule <k> V:PyVal ~> addLeft(RIGHT) => RIGHT ~> addRight(V) ... </k>
+  rule <k> sVal(S2) ~> addRight(sVal(S1)) => sVal(S1 +String S2) ... </k>
+
+  // For loops consume the list from left to right and execute their body once
+  // for each element.
+  rule <k> For(Name(X), ITER, BODY) => ITER ~> startFor(X, BODY) ... </k>
+  rule <k> lVal(ITEMS) ~> startFor(X, BODY) => loop(X, ITEMS, BODY) ... </k>
+  rule <k> loop(_, .StrList, _) => .K ... </k>
+  rule <k> loop(X, S :: REST, BODY)
+        => bindLoop(X, sVal(S)) ~> BODY ~> loop(X, REST, BODY) ... </k>
+  rule <k> bindLoop("string", V) => .K ... </k>
+       <iterationItem> _ => V </iterationItem>
+
+  // Return publishes a value; cleanup restores the call-local cells so that
+  // claims can state a closed final configuration.
+  rule <k> Return(E) => E ~> finishReturn ... </k>
+  rule <k> V:PyVal ~> finishReturn => .K ... </k>
+       <result> _ => V </result>
+  rule <k> cleanup => .K ... </k>
+       <function> _ => noFunction </function>
+       <argument> _ => lVal(.StrList) </argument>
+       <accumulator> _ => sVal("") </accumulator>
+       <iterationItem> _ => sVal("") </iterationItem>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..66a1bc0463f544f1772336138be32c8f874c3360
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,8 @@
+from typing import List
+
+
+def concatenate(strings: List[str]) -> str:
+    result = ""
+    for string in strings:
+        result = result + string
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..ba790fc53d115d65535d3df4e3f2c9b043afdeeb
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,48 @@
+requires "semantic.k"
+
+module SPEC
+  imports MPY-SEMANTICS
+
+  // Loop invariant: starting with accumulator ACC and unconsumed ITEMS,
+  // execution returns ACC followed by every remaining string.  FRAME carries
+  // values in the argument and iteration-variable cells are irrelevant to the
+  // accumulator except when the loop body explicitly reads the current item.
+  claim [concatenate-loop]:
+    <py>
+      <k>
+        loop("string", ITEMS:StrList,
+          Assign(Name("result"),
+            BinOp("+", Name("result"), Name("string"))))
+        ~> Return(Name("result")) ~> cleanup
+        => .K
+      </k>
+      <function> _FUN:Function => noFunction </function>
+      <argument> lVal(_ALL:StrList) => lVal(.StrList) </argument>
+      <accumulator> sVal(ACC:String) => sVal("") </accumulator>
+      <iterationItem> sVal(_CURRENT:String) => sVal("") </iterationItem>
+      <result> noResult => sVal(concatAcc(ACC, ITEMS)) </result>
+    </py>
+
+  // End-to-end correctness of the exact constructor tree emitted in
+  // solution.mpy, for an arbitrary finite list of strings.
+  claim [concatenate-correct]:
+    <py>
+      <k>
+        load(Module(
+          ImportFrom("typing", "List")
+          FuncDef("concatenate", Params("strings"),
+            Assign(Name("result"), Str(""))
+            For(Name("string"), Name("strings"),
+              Assign(Name("result"),
+                BinOp("+", Name("result"), Name("string"))))
+            Return(Name("result")))))
+        ~> invoke("concatenate", lVal(INPUT:StrList))
+        => .K
+      </k>
+      <function> noFunction </function>
+      <argument> lVal(.StrList) </argument>
+      <accumulator> sVal("") </accumulator>
+      <iterationItem> sVal("") </iterationItem>
+      <result> noResult => sVal(concatAcc("", INPUT)) </result>
+    </py>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..875abd8e513138208e379fd4f4c63a18e0e12fbb
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,8 @@
+module VERIFICATION
+  imports MPY-SYNTAX
+
+  // Mathematical left fold used by the reachability claims.
+  syntax String ::= concatAcc(String, StrList) [function]
+  rule concatAcc(ACC, .StrList) => ACC
+  rule concatAcc(ACC, S :: REST) => concatAcc(ACC +String S, REST)
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition semantic-kompiled --claims concatenate-loop --depth 30' in /work
