     3	module SPEC
     4	  imports MPY-SEMANTICS
     5	
     6	  // Loop invariant: starting with accumulator ACC and unconsumed ITEMS,
     7	  // execution returns ACC followed by every remaining string.  The saved
     8	  // values in the argument and iteration-variable cells are irrelevant to the
     9	  // accumulator except when the loop body explicitly reads the current item.
    10	  claim [concatenate-loop]:
    11	    <py>
    12	      <k>
    13	        loop("string", ITEMS:StrList,
    14	          Assign(Name("result"),
    15	            BinOp("+", Name("result"), Name("string"))))
    16	        ~> (Return(Name("result")) .PyStmts) ~> cleanup
    17	        => .K
    18	      </k>
    19	      <function> _FUN:Function => noFunction </function>
    20	      <argument> lVal(_ALL:StrList) => lVal(.StrList) </argument>
    21	      <accumulator> sVal(ACC:String) => sVal("") </accumulator>
    22	      <iterationItem> sVal(_CURRENT:String) => sVal("") </iterationItem>
    23	      <result> noResult => sVal(concatAcc(ACC, ITEMS)) </result>
    24	    </py>
    25	
    26	  // End-to-end correctness of the exact constructor tree emitted in
    27	  // solution.mpy, for an arbitrary finite list of strings.
    28	  claim [concatenate-correct]:
    29	    <py>
    30	      <k>
    31	        load(Module(
    32	          ImportFrom("typing", "List")
    33	          FuncDef("concatenate", Params("strings"),
    34	            Assign(Name("result"), Str(""))
    35	            For(Name("string"), Name("strings"),
    36	              Assign(Name("result"),
    37	                BinOp("+", Name("result"), Name("string"))))
    38	            Return(Name("result")))))
    39	        ~> invoke("concatenate", lVal(INPUT:StrList))
    40	        => .K
    41	      </k>
    42	      <function> noFunction </function>
    43	      <argument> lVal(.StrList) </argument>
    44	      <accumulator> sVal("") </accumulator>
    45	      <iterationItem> sVal("") </iterationItem>
    46	      <result> noResult => sVal(concatAcc("", INPUT)) </result>
    47	    </py>
    48	endmodule
