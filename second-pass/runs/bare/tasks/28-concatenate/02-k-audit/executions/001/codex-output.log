+sed -n '1,50p' /candidate/codex-output.log
+tail -50 /candidate/codex-output.log
+rg -n '#Top|WarnStuck|kprove|kompile|krun|RESULT:' /candidate/codex-output.log | tail -180
+python3 /audit-output/evidence/trace_summary.py \
