+  --output-definition /tmp/audit-work/fresh/concrete-kompiled
+
+kompile /tmp/audit-work/fresh/semantic.k \
+  --backend haskell \
+  --main-module MPY-SEMANTICS \
+  --syntax-module MPY-SYNTAX \
+  --output-definition /tmp/audit-work/fresh/proof-kompiled
