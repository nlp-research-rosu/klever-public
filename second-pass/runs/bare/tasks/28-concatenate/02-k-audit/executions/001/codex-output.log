+#!/usr/bin/env bash
+set -euxo pipefail
+
+test "$(tail -n 2 /audit-output/REVIEW.md)" = $'VERDICT: CONCERNS\nLEGITIMACY: LEGIT'
+test "$(rg -c '^VERDICT:' /audit-output/REVIEW.md)" -eq 1
+test "$(rg -c '^LEGITIMACY:' /audit-output/REVIEW.md)" -eq 1
