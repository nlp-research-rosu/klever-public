index 0000000000000000000000000000000000000000..aed5354600527955b5f6e740044df3ded96cd9d1
--- /dev/null
+++ b/evidence/stage3_build.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+set -euxo pipefail
+
+kompile --version
+kprove --version
+krun --version
+
+test ! -e /tmp/audit-work/fresh/concrete-kompiled
+test ! -e /tmp/audit-work/fresh/proof-kompiled
+
