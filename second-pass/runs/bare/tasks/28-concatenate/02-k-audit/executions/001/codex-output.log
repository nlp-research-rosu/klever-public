diff --git a/evidence/stage6_mutation_build.sh b/evidence/stage6_mutation_build.sh
new file mode 100644
index 0000000000000000000000000000000000000000..68c745fe5fe016834e5514e84e05d721105f55c7
--- /dev/null
+++ b/evidence/stage6_mutation_build.sh
