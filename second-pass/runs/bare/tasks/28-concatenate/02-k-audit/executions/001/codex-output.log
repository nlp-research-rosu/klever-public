+  /candidate/codex-trace/2026/07/22/rollout-2026-07-22T04-27-52-019f8927-2991-7be0-81f8-c4c24065748a.jsonl
+sed -n '1,50p' /candidate/codex-output.log
+tail -50 /candidate/codex-output.log
