from pathlib import Path
import hashlib,stat,itertools
pairs=[(Path('/candidate'),'8735f04daf09a46c70d2ba66413e807c1622a9a726d78370e744a818a554cee7'),(Path('/generation-evidence/codex-trace'),'bf13989eafecb16e6e14570019004be0cb0082d5f21930f1ed7898d249c41841')]

def entries(root,dirs):
 for p in sorted(root.rglob('*')):
  if p.is_dir() and not dirs: continue
  yield p,p.relative_to(root).as_posix(),b'directory' if p.is_dir() else b'file'
parts=['rel','rel0','kind','kind0','size4','size8','content','rawhash','hexhash','mode','newline']
# sensible recipes prefix fields then content/hash
prefix_sets=[]
for rel in ['rel','rel0']:
 for kind in [None,'kind','kind0']:
  for size in [None,'size4','size8']:
   for mode in [None,'mode']:
    prefix_sets.append(tuple(x for x in [rel,kind,mode,size] if x))
for dirs in [False,True]:
 for prefix in prefix_sets:
  for payload in ['content','rawhash','hexhash']:
   for suffix in [(),('newline',)]:
    recipe=prefix+(payload,)+suffix
    vals=[]
    for root,target in pairs:
     d=hashlib.sha256()
     for p,rel,kind in entries(root,dirs):
      raw=p.read_bytes() if p.is_file() else b''
      m={
       'rel':rel.encode(),'rel0':rel.encode()+b'\\0','kind':kind,'kind0':kind+b'\\0',
       'size4':len(raw).to_bytes(4,'big'),'size8':len(raw).to_bytes(8,'big'),
       'content':raw,'rawhash':hashlib.sha256(raw).digest(),
       'hexhash':hashlib.sha256(raw).hexdigest().encode(),
       'mode':stat.S_IMODE(p.stat().st_mode).to_bytes(4,'big'),'newline':b'\\n'}
      for part in recipe:d.update(m[part])
     vals.append(d.hexdigest())
    if all(vals[i]==pairs[i][1] for i in range(2)):
     print('MATCH',dirs,recipe)
print('done')
PY" in /audit-output
