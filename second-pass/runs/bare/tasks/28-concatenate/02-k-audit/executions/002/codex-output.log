+
+
+trace = next(Path("/generation-evidence/codex-trace").rglob("*.jsonl"))
+interesting_words = (
+    "kompile",
+    "kprove",
+    "krun",
+    "solution",
+    "semantic.k",
+    "verification.k",
+    "spec.k",
+    "apply_patch",
