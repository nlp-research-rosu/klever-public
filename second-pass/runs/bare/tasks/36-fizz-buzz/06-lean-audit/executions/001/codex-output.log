  999999 ~> .K
</k>
+ krun cancel.in --definition int-add-kompiled
<k>
  0 ~> .K
</k>
+ krun large.in --definition int-add-kompiled
<k>
  10000000000000000000000000000000000000001 ~> .K
</k>

