codex
The root cause is now concrete: the audit sandbox creates a PID namespace without a matching `/proc` mount, so Lean’s runtime receives a namespace PID (for example `9`) but looks for that number in the host `/proc` and cannot locate its own executable. I’ll use a narrowly scoped local compatibility shim that makes `getpid()` report the host `Tgid` read from `/proc/thread-self/status`; this restores Lean’s executable discovery without modifying the toolchain or any audited artifact.
apply patch
patch: completed
/tmp/audit-work/lean_pid_compat.c
diff --git a//tmp/audit-work/lean_pid_compat.c b//tmp/audit-work/lean_pid_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..49e0a68930a3d8f67bd8aa729707320912591b1a
--- /dev/null
+++ b//tmp/audit-work/lean_pid_compat.c
@@ -0,0 +1,43 @@
+#define _GNU_SOURCE
+
+#include <fcntl.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The audit sandbox has a PID namespace but a host /proc mount. Lean locates
+ * its executable via /proc/<getpid()>/exe, so return the host-visible Tgid.
+ * Use raw syscalls to avoid recursion through this interposed getpid().
+ */
+pid_t getpid(void) {
+    char buffer[4096];
+    const char marker[] = "Tgid:\t";
+    long fd = syscall(
+        SYS_openat,
+        AT_FDCWD,
+        "/proc/thread-self/status",
+        O_RDONLY | O_CLOEXEC,
+        0
+    );
+    if (fd < 0) {
+        return (pid_t)syscall(SYS_getpid);
+    }
+
+    long count = syscall(SYS_read, (int)fd, buffer, sizeof(buffer) - 1);
+    syscall(SYS_close, (int)fd);
+    if (count <= 0) {
+        return (pid_t)syscall(SYS_getpid);
+    }
+    buffer[count] = '\0';
+
+    char *position = strstr(buffer, marker);
+    if (position == NULL) {
+        return (pid_t)syscall(SYS_getpid);
+    }
+    position += sizeof(marker) - 1;
+    return (pid_t)strtol(position, NULL, 10);
+}

