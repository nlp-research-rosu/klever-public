--- /dev/null
+++ b//tmp/audit-work/36-fizz-buzz-proof-audit/BridgeAudit.lean
@@ -0,0 +1,42 @@
+import Proof
+
+open Klean36FizzBuzz.Lemmas
+
+-- The candidate bridge is definitionally Lean's mathematical Int addition.
+example :
+    ∀ (x0 x1 : SortInt), Proof.«_+Int_» x0 x1 = x0 + x1 := by
+  intro x0 x1
+  rfl
+
+-- Ground witnesses cover signs, zero, cancellation, and arbitrary precision.
+#eval Proof.«_+Int_» (-7) 3
+#eval Proof.«_+Int_» 0 999999
+#eval Proof.«_+Int_» 7 (-7)
+#eval Proof.«_+Int_»
+  10000000000000000000000000000000000000000
+  1
+
+-- The equation alone admits operationally dishonest implementations.
+def constantZero (_x0 _x1 : SortInt) : SortInt := 0
+example : targetStatement constantZero := by
+  intro A B C
+  rfl
+
+def takeLeft (x0 _x1 : SortInt) : SortInt := x0
+example : targetStatement takeLeft := by
+  intro A B C
+  rfl
+
+def takeRight (_x0 x1 : SortInt) : SortInt := x1
+example : targetStatement takeRight := by
+  intro A B C
+  rfl
+
+-- A mutation of K addition to subtraction is detected by associativity.
+def subtraction (x0 x1 : SortInt) : SortInt := x0 - x1
+#eval subtraction (subtraction 10 3) 2
+#eval subtraction 10 (subtraction 3 2)
+#eval decide (
+  subtraction (subtraction 10 3) 2 =
+    subtraction 10 (subtraction 3 2)
+)
