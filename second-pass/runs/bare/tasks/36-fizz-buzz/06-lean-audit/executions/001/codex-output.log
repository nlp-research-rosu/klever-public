--- /dev/null
+++ b//tmp/audit-work/36-fizz-buzz-proof-audit/BridgeAudit.lean
@@ -0,0 +1,42 @@
+import Proof
+
+open Klean36FizzBuzz.Lemmas
+
+-- The candidate bridge is definitionally Lean's mathematical Int addition.
+example :
+    ∀ (x0 x1 : SortInt), Proof.«_+Int_» x0 x1 = x0 + x1 := by
+  intro x0 x1
+  rfl
+
+-- Ground witnesses cover signs, zero, cancellation, and arbitrary precision.
+#eval Proof.«_+Int_» (-7) 3
+#eval Proof.«_+Int_» 0 999999
+#eval Proof.«_+Int_» 7 (-7)
+#eval Proof.«_+Int_»
+  10000000000000000000000000000000000000000
+  1
+
+-- The equation alone admits operationally dishonest implementations.
+def constantZero (_x0 _x1 : SortInt) : SortInt := 0
+example : targetStatement constantZero := by
+  intro A B C
+  rfl
+
+def takeLeft (x0 _x1 : SortInt) : SortInt := x0
+example : targetStatement takeLeft := by
+  intro A B C
+  rfl
+
+def takeRight (_x0 x1 : SortInt) : SortInt := x1
+example : targetStatement takeRight := by
+  intro A B C
+  rfl
+
+-- A mutation of K addition to subtraction is detected by associativity.
+def subtraction (x0 x1 : SortInt) : SortInt := x0 - x1
+#eval subtraction (subtraction 10 3) 2
+#eval subtraction 10 (subtraction 3 2)
+#eval decide (
+  subtraction (subtraction 10 3) 2 =
+    subtraction 10 (subtraction 3 2)
+)
diff --git a//tmp/audit-work/lean_pid_compat.c b//tmp/audit-work/lean_pid_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..49e0a68930a3d8f67bd8aa729707320912591b1a
--- /dev/null
+++ b//tmp/audit-work/lean_pid_compat.c
@@ -0,0 +1,43 @@
+#define _GNU_SOURCE
+
+#include <fcntl.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The audit sandbox has a PID namespace but a host /proc mount. Lean locates
+ * its executable via /proc/<getpid()>/exe, so return the host-visible Tgid.
+ * Use raw syscalls to avoid recursion through this interposed getpid().
+ */
+pid_t getpid(void) {
+    char buffer[4096];
+    const char marker[] = "Tgid:\t";
+    long fd = syscall(
+        SYS_openat,
+        AT_FDCWD,
+        "/proc/thread-self/status",
+        O_RDONLY | O_CLOEXEC,
+        0
+    );
+    if (fd < 0) {
+        return (pid_t)syscall(SYS_getpid);
+    }
+
+    long count = syscall(SYS_read, (int)fd, buffer, sizeof(buffer) - 1);
+    syscall(SYS_close, (int)fd);
+    if (count <= 0) {
+        return (pid_t)syscall(SYS_getpid);
+    }
+    buffer[count] = '\0';
+
+    char *position = strstr(buffer, marker);
+    if (position == NULL) {
+        return (pid_t)syscall(SYS_getpid);
+    }
+    position += sizeof(marker) - 1;
+    return (pid_t)strtol(position, NULL, 10);
+}

