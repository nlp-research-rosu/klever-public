+import Proof
+
+open Klean36FizzBuzz.Lemmas
+
+/- Adversarial ground cases for the candidate's operational bridge. -/
+example : Proof.«_+Int_» (-8) 3 = -5 := by decide
+example : Proof.«_+Int_» 8 (-13) = -5 := by decide
+example : Proof.«_+Int_» (-8) (-13) = -21 := by decide
+example : Proof.«_+Int_» 0 47 = 47 := by decide
+example : Proof.«_+Int_» (-47) 0 = -47 := by decide
+example :
+    Proof.«_+Int_»
+      1_000_000_000_000_000_000
+      (-999_999_999_999_999_999) = 1 := by decide
+
+#eval Proof.«_+Int_» (-8) 3
+#eval Proof.«_+Int_» 8 (-13)
+#eval Proof.«_+Int_» (-8) (-13)
+#eval Proof.«_+Int_» 0 47
+#eval Proof.«_+Int_» (-47) 0
+#eval Proof.«_+Int_»
+  1_000_000_000_000_000_000
+  (-999_999_999_999_999_999)
+
+/- Convenient but operationally false definitions can satisfy associativity. -/
+def constantZero (_ _ : SortInt) : SortInt := 0
+def leftProjection (x _ : SortInt) : SortInt := x
+def rightProjection (_ y : SortInt) : SortInt := y
+
+theorem constantZero_satisfies_target : targetStatement constantZero := by
+  intro _ _ _
+  rfl
+
+theorem leftProjection_satisfies_target : targetStatement leftProjection := by
+  intro _ _ _
+  rfl
+
+theorem rightProjection_satisfies_target : targetStatement rightProjection := by
+  intro _ _ _
+  rfl
+
+example : constantZero 2 3 ≠ 5 := by decide
+example : leftProjection 2 3 ≠ 5 := by decide
+example : rightProjection 2 3 ≠ 5 := by decide
+
+/- A non-associative body mutation is rejected by the fixed target. -/
+def subtract (x y : SortInt) : SortInt := x - y
+
+theorem subtract_does_not_satisfy_target : ¬ targetStatement subtract := by
+  intro h
+  have counterexample :
+      subtract (subtract 10 3) 2 ≠ subtract 10 (subtract 3 2) := by
+    decide
+  exact counterexample (h 10 3 2)
