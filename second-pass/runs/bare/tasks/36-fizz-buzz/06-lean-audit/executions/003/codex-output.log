     4	  imports SEMANTIC
     5	
     6	  // Mathematical functions used only in specifications.  Their equations are
     7	  // deliberately aligned with the two loops' decreasing/advancing measures.
     8	  syntax Int ::= digitSevens(Int) [function, total]
     9	               | fizzContribution(Int) [function, total]
    10	               | fizzFrom(Int, Int) [function, total]
    11	               | fizzEnd(Int) [function, total]
    12	
    13	  rule fizzEnd(N) => 0
    14	    requires N <Int 0
    15	  rule fizzEnd(N) => N
    16	    requires N >=Int 0
    17	
    18	  rule digitSevens(X) => 0
    19	    requires X <=Int 0
    20	  rule digitSevens(X) => 1 +Int digitSevens(X /Int 10)
    21	    requires X >Int 0 andBool X %Int 10 ==Int 7
    22	  rule digitSevens(X) => digitSevens(X /Int 10)
    23	    requires X >Int 0 andBool X %Int 10 =/=Int 7
    24	
    25	  rule fizzContribution(I) => digitSevens(I)
