    31	
    32	  rule fizzFrom(I, N) => 0
    33	    requires I >=Int N
    34	  rule fizzFrom(I, N) => fizzContribution(I) +Int fizzFrom(I +Int 1, N)
    35	    requires I <Int N
    36	
    37	  // Keep symbolic sums in the right-associated shape used by the invariants.
    38	  rule (A +Int B) +Int C => A +Int (B +Int C) [simplification]
