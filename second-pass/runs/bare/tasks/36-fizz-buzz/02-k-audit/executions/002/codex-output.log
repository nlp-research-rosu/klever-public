+            => .K
+          </k>
+          <input> N </input>
+          <env> .Map =>
+            "count" |-> fizzFrom(0, N)
+            "i" |-> fizzEnd(N)
+            "n" |-> N
+            "x" |-> 0
+          </env>
+          <result> 0 => fizzFrom(0, N) </result>
+        </fizz>
+endmodule
