index 0000000000000000000000000000000000000000..6345cf2968850c0d0fbee3b16d8091f16b1753c6
--- /dev/null
+++ b//tmp/audit-work/36-fizz-buzz-audit-002/candidate/spec-body-mutation.k
@@ -0,0 +1,43 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Ground body-sensitivity check. The executed constructor term increments
+  // count by 2 for each digit 7, so at N=78 it returns 4, not the claimed 2.
+  claim <fizz>
+          <k>
+            Module(
+              FuncDef("fizz_buzz", Params("n"),
+                Assign(Name("count"), Int(0))
+                Assign(Name("i"), Int(0))
+                While(Compare(Name("i"), CmpOp("<", Name("n"))),
+                  If(BoolOp("or",
+                      Compare(BinOp("%", Name("i"), Int(11)),
+                              CmpOp("==", Int(0))),
+                      Compare(BinOp("%", Name("i"), Int(13)),
+                              CmpOp("==", Int(0)))),
+                    Assign(Name("x"), Name("i"))
+                    While(Compare(Name("x"), CmpOp(">", Int(0))),
+                      If(Compare(BinOp("%", Name("x"), Int(10)),
+                                 CmpOp("==", Int(7))),
+                        Assign(Name("count"),
+                          BinOp("+", Name("count"), Int(2))),
+                        .Stmts)
+                      Assign(Name("x"),
+                        BinOp("//", Name("x"), Int(10)))),
+                    .Stmts)
+                  Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+                Return(Name("count"))))
+            => .K
+          </k>
+          <input> 78 </input>
+          <env> .Map =>
+            "count" |-> 4
+            "i" |-> 78
+            "n" |-> 78
+            "x" |-> 0
+          </env>
+          <result> 0 => 2 </result>
+        </fizz>
+endmodule
diff --git a//tmp/audit-work/36-fizz-buzz-audit-002/candidate/spec-labeled.k b//tmp/audit-work/36-fizz-buzz-audit-002/candidate/spec-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..31c594d3438820394df18ec2881954f9e9bdee9c
--- /dev/null
+++ b//tmp/audit-work/36-fizz-buzz-audit-002/candidate/spec-labeled.k
@@ -0,0 +1,46 @@
+requires "verification.k"
+
+module SPEC-LABELED
+  imports VERIFICATION
+
+  claim [inner-loop]:
+        <k> INNER-LOOP ~> REST => REST </k>
+        <env>
+          "count" |-> (C => C +Int digitSevens(X))
+          "i" |-> _I
+          "n" |-> _N
+          "x" |-> (X => 0)
+        </env>
+    requires X >=Int 0
+
+  claim [outer-loop]:
+        <k> OUTER-LOOP ~> REST => REST </k>
+        <env>
+          "count" |-> (C => C +Int fizzFrom(I, N))
+          "i" |-> (I => N)
+          "n" |-> N
+          "x" |-> 0
+        </env>
+    requires I >=Int 0 andBool I <=Int N
+
+  claim [entry]:
+        <fizz>
+          <k>
+            Module(
+              FuncDef("fizz_buzz", Params("n"),
+                Assign(Name("count"), Int(0))
+                Assign(Name("i"), Int(0))
+                OUTER-LOOP
+                Return(Name("count"))))
+            => .K
+          </k>
+          <input> N </input>
+          <env> .Map =>
+            "count" |-> fizzFrom(0, N)
+            "i" |-> fizzEnd(N)
+            "n" |-> N
+            "x" |-> 0
+          </env>
+          <result> 0 => fizzFrom(0, N) </result>
+        </fizz>
+endmodule
diff --git a//tmp/audit-work/36-fizz-buzz-audit-002/candidate/spec-vacuity-audit.k b//tmp/audit-work/36-fizz-buzz-audit-002/candidate/spec-vacuity-audit.k
