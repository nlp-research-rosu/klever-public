+| SYN-07 | semantic.k:15 | `Stmt ::= Return(Expr)` | none | yes |
+| SYN-08 | semantic.k:17 | `Expr ::= Name(String)` | none | yes |
+| SYN-09 | semantic.k:18 | `Expr ::= Int(Int)` | none | yes |
