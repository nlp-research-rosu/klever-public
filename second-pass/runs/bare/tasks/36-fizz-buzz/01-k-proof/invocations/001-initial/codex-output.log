index 0000000000000000000000000000000000000000..1635b65012ea78add816d8eae0ae1719b488be67
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,49 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inner-loop invariant: starting with x = X adds exactly the number of
+  // decimal sevens in X and terminates with x = 0.
+  claim <k> INNER-LOOP ~> REST => REST </k>
+        <env>
+          "count" |-> (C => C +Int digitSevens(X))
+          "i" |-> I
+          "n" |-> N
+          "x" |-> (X => 0)
+        </env>
+    requires X >=Int 0
+
+  // Outer-loop invariant: [I,N) contributes fizzFrom(I,N); x is zero at each
+  // outer-loop boundary because the inner loop exhausts it.
+  claim <k> OUTER-LOOP ~> REST => REST </k>
+        <env>
+          "count" |-> (C => C +Int fizzFrom(I, N))
+          "i" |-> (I => N)
+          "n" |-> N
+          "x" |-> 0
+        </env>
+    requires I >=Int 0 andBool I <=Int N
+
+  // End-to-end theorem for every nonnegative input accepted by the contract.
+  claim <fizz>
+          <k>
+            Module(
+              FuncDef("fizz_buzz", Params("n"),
+                Assign(Name("count"), Int(0))
+                Assign(Name("i"), Int(0))
+                OUTER-LOOP
+                Return(Name("count"))))
+            => .K
+          </k>
+          <input> N </input>
+          <env> .Map =>
+            "count" |-> fizzFrom(0, N)
+            "i" |-> N
+            "n" |-> N
+            "x" |-> 0
+          </env>
+          <result> 0 => fizzFrom(0, N) </result>
+        </fizz>
+    requires N >=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b122310c6edae4e04a79579ab3edffca3e19ef32
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,51 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // Mathematical functions used only in specifications.  Their equations are
+  // deliberately aligned with the two loops' decreasing/advancing measures.
+  syntax Int ::= digitSevens(Int) [function, total]
+               | fizzContribution(Int) [function, total]
+               | fizzFrom(Int, Int) [function, total]
+
+  rule digitSevens(X) => 0
+    requires X <=Int 0
+  rule digitSevens(X) => 1 +Int digitSevens(X /Int 10)
+    requires X >Int 0 andBool X %Int 10 ==Int 7
+  rule digitSevens(X) => digitSevens(X /Int 10)
+    requires X >Int 0 andBool X %Int 10 =/=Int 7
+
+  rule fizzContribution(I) => digitSevens(I)
+    requires I %Int 11 ==Int 0
+  rule fizzContribution(I) => digitSevens(I)
+    requires I %Int 11 =/=Int 0 andBool I %Int 13 ==Int 0
+  rule fizzContribution(I) => 0
+    requires I %Int 11 =/=Int 0 andBool I %Int 13 =/=Int 0
+
+  rule fizzFrom(I, N) => 0
+    requires I >=Int N
+  rule fizzFrom(I, N) => fizzContribution(I) +Int fizzFrom(I +Int 1, N)
+    requires I <Int N
+
+  // Readable aliases for the exact translated loops.  These are macros only:
+  // claims still execute the constructors emitted into solution.mpy.
+  syntax Stmt ::= "INNER-LOOP" [macro]
+  rule INNER-LOOP =>
+    While(Compare(Name("x"), CmpOp(">", Int(0))),
+      If(Compare(BinOp("%", Name("x"), Int(10)), CmpOp("==", Int(7))),
+        Assign(Name("count"), BinOp("+", Name("count"), Int(1))),
+        .Stmts)
+      Assign(Name("x"), BinOp("//", Name("x"), Int(10))))
+
+  syntax Stmt ::= "OUTER-LOOP" [macro]
+  rule OUTER-LOOP =>
+    While(Compare(Name("i"), CmpOp("<", Name("n"))),
+      If(BoolOp("or",
+          Compare(BinOp("%", Name("i"), Int(11)), CmpOp("==", Int(0))),
+          Compare(BinOp("%", Name("i"), Int(13)), CmpOp("==", Int(0)))),
+        Assign(Name("x"), Name("i"))
+        INNER-LOOP,
+        .Stmts)
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition semantic-kompiled --dry-run' in /work
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..b641d124c5b710e6164d66ec66ab66bb1deb3e5e
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,97 @@
+requires "domains.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," "Params" "(" String ")" "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "BoolOp" "(" String "," Expr "," Expr ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  configuration
+    <fizz>
+      <k> $PGM:Program </k>
+      <input> $N:Int </input>
+      <env> .Map </env>
+      <result> 0 </result>
+    </fizz>
+
+  syntax KItem ::= assignTo(String)
+                 | binLeft(String, Expr)
+                 | binRight(String, Int)
+                 | compareLeft(String, Expr)
+                 | compareRight(String, Int)
+                 | orElse(Expr)
+                 | ifThenElse(Stmts, Stmts)
+                 | whileBody(Expr, Stmts)
+                 | "returnValue"
+
+  // Loading the translated module invokes its required entry point with the
+  // integer supplied in <input>.  Function-body execution below is ordinary
+  // small-step execution over the translated AST.
+  rule <k> Module(FuncDef("fizz_buzz", Params("n"), BODY)) => BODY </k>
+       <input> N </input>
+       <env> .Map => "n" |-> N "count" |-> 0 "i" |-> 0 "x" |-> 0 </env>
+
+  rule <k> (S:Stmt SS:Stmts) => S ~> SS ... </k>
+  rule <k> .Stmts => .K ... </k>
+
+  rule <k> Name(X) => Int(I) ... </k>
+       <env> ... X |-> I ... </env>
+
+  rule <k> Assign(Name(X), E) => E ~> assignTo(X) ... </k>
+  rule <k> Int(I) ~> assignTo(X) => .K ... </k>
+       <env> ... X |-> (_ => I) ... </env>
+
+  rule <k> BinOp(OP, L, R) => L ~> binLeft(OP, R) ... </k>
+  rule <k> Int(A) ~> binLeft(OP, R) => R ~> binRight(OP, A) ... </k>
+  rule <k> Int(B) ~> binRight("+", A) => Int(A +Int B) ... </k>
+  rule <k> Int(B) ~> binRight("%", A) => Int(A %Int B) ... </k>
+    requires B =/=Int 0
+  rule <k> Int(B) ~> binRight("//", A) => Int(A /Int B) ... </k>
+    requires B =/=Int 0
+
+  rule <k> Compare(L, CmpOp(OP, R)) => L ~> compareLeft(OP, R) ... </k>
+  rule <k> Int(A) ~> compareLeft(OP, R) => R ~> compareRight(OP, A) ... </k>
+  rule <k> Int(B) ~> compareRight("<", A) => Bool(A <Int B) ... </k>
+  rule <k> Int(B) ~> compareRight(">", A) => Bool(A >Int B) ... </k>
+  rule <k> Int(B) ~> compareRight("==", A) => Bool(A ==Int B) ... </k>
+
+  rule <k> BoolOp("or", L, R) => L ~> orElse(R) ... </k>
+  rule <k> Bool(true) ~> orElse(_) => Bool(true) ... </k>
+  rule <k> Bool(false) ~> orElse(R) => R ... </k>
+
+  rule <k> If(E, THEN, ELSE) => E ~> ifThenElse(THEN, ELSE) ... </k>
+  rule <k> Bool(true) ~> ifThenElse(THEN, _) => THEN ... </k>
+  rule <k> Bool(false) ~> ifThenElse(_, ELSE) => ELSE ... </k>
+
+  rule <k> While(E, BODY) => E ~> whileBody(E, BODY) ... </k>
+  rule <k> Bool(true) ~> whileBody(E, BODY) => BODY ~> While(E, BODY) ... </k>
+  rule <k> Bool(false) ~> whileBody(_, _) => .K ... </k>
+
+  rule <k> Return(E) => E ~> returnValue ... </k>
+  rule <k> Int(I) ~> returnValue ~> _REST:K => .K </k>
+       <result> _ => I </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..dfd37cd5104e2d1fb92460b1d5fcb397ed8148cd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def fizz_buzz(n: int):
+    count = 0
+    i = 0
+    while i < n:
+        if i % 11 == 0 or i % 13 == 0:
+            x = i
+            while x > 0:
+                if x % 10 == 7:
+                    count = count + 1
+                x = x // 10
+        i = i + 1
+    return count
