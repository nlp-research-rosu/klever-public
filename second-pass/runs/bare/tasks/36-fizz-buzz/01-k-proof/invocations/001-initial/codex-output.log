new file mode 100644
index 0000000000000000000000000000000000000000..dfd37cd5104e2d1fb92460b1d5fcb397ed8148cd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def fizz_buzz(n: int):
+    count = 0
+    i = 0
+    while i < n:
+        if i % 11 == 0 or i % 13 == 0:
+            x = i
+            while x > 0:
+                if x % 10 == 7:
+                    count = count + 1
+                x = x // 10
+        i = i + 1
+    return count
