+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t bufsiz) {
+  static readlink_fn original_readlink = NULL;
+  if (original_readlink == NULL) {
+    original_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  if (strncmp(path, "/proc/", 6) == 0) {
+    const char *suffix = strrchr(path, '/');
+    if (suffix != NULL && strcmp(suffix, "/exe") == 0) {
+      return original_readlink("/proc/self/exe", buf, bufsiz);
+    }
+  }
+  return original_readlink(path, buf, bufsiz);
+}
