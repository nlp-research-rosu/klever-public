/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
from pathlib import Path

inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
output = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}

assert list(output) == ['schema_version', 'inventory_sha256', 'rules']
assert output['schema_version'] == 2
assert output['inventory_sha256'] == inventory['inventory_sha256']
assert len(output['rules']) == len(inventory['rules'])
expected_ids = [r['source_rule_id'] for r in inventory['rules']]
actual_ids = [r['source_rule_id'] for r in output['rules']]
assert actual_ids == expected_ids
assert len(set(actual_ids)) == len(actual_ids)
by_id = {r['source_rule_id']: r for r in output['rules']}
for rule in output['rules']:
    assert list(rule) == ['source_rule_id', 'classification', 'rationale']
    assert rule['classification'] in allowed
    assert isinstance(rule['rationale'], str) and rule['rationale'].strip()
for source in inventory['rules']:
    if 'simplification' in source['attributes']:
        assert by_id[source['source_rule_id']]['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
counts = Counter(r['classification'] for r in output['rules'])
print('trust-boundary validation: passed')
print('rules:', len(output['rules']))
for classification in sorted(allowed):
    print(f'{classification}: {counts[classification]}')
PY
