new file mode 100644
index 0000000000000000000000000000000000000000..aa485e830ef3b6ebc4870f80b2791552f280b270
--- /dev/null
+++ b/evidence/capture-command.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG-FILE COMMAND [ARG ...]" >&2
+  exit 2
+fi
+
+log_file=$1
+shift
+
+{
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} | tee "$log_file"
+
+set +e
+"$@" 2>&1 | tee -a "$log_file"
+command_status=${PIPESTATUS[0]}
+set -e
+
+printf 'EXIT_STATUS: %d\n' "$command_status" | tee -a "$log_file"
+exit "$command_status"
