167:# --- Operator spellings (string tokens carried inside constructors) ----------
168:# These are transliterations of the operator *symbol*, not its meaning.
169:_BINOP = {
170:    ast.Add: "+", ast.Sub: "-", ast.Mult: "*", ast.Div: "/",
171:    ast.FloorDiv: "//", ast.Mod: "%", ast.Pow: "**",
172:    ast.BitOr: "|", ast.BitAnd: "&", ast.BitXor: "^",
173:    ast.LShift: "<<", ast.RShift: ">>", ast.MatMult: "@",
174:}
175:_UNARY = {ast.USub: "-", ast.UAdd: "+", ast.Not: "not", ast.Invert: "~"}
176:_BOOLOP = {ast.And: "and", ast.Or: "or"}
177:_CMPOP = {
178:    ast.Eq: "==", ast.NotEq: "!=", ast.Lt: "<", ast.LtE: "<=",
179:    ast.Gt: ">", ast.GtE: ">=", ast.Is: "is", ast.IsNot: "is not",
180:    ast.In: "in", ast.NotIn: "not in",
181:}
