from pathlib import Path
import hashlib,itertools
root=Path('/generation-evidence/codex-trace'); f=next(root.rglob('*.jsonl')); rel=f.relative_to(root).as_posix(); data=f.read_bytes(); target='f062bdcb5b795d3bc92262dbd0449c7736a58f1c25a447161e22fd7ecfac6286'
parts={'rel':rel.encode(),'dotrel':('./'+rel).encode(),'name':f.name.encode(),'data':data,'fh':hashlib.sha256(data).hexdigest().encode(),'fhb':hashlib.sha256(data).digest(),'size':str(len(data)).encode(),'size8':len(data).to_bytes(8,'big'),'file':b'file','file0':b'file\\0','zero':b'\\0','nl':b'\\n','space':b' ','twospace':b'  '}
for n in range(1,6):
 for keys in itertools.product(parts, repeat=n):
  if 'data' not in keys and 'fh' not in keys and 'fhb' not in keys: continue
  h=hashlib.sha256(b''.join(parts[k] for k in keys)).hexdigest()
  if h==target: print('MATCH',keys); raise SystemExit
print('no simple match')
PY" in /audit-output
