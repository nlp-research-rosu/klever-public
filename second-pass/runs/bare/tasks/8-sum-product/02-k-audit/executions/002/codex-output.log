@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module SUM-PRODUCT-SPEC-IMPORT-BINDING-WITNESS
+  imports VERIFICATION
+
+  // This differs from the submitted program: typing does not export prod.
+  // A Python implementation fails during import, but the candidate K semantics
+  // erases the import and resolves textual Name("prod") as math.prod anyway.
+  claim
+    <k>
+      Module(
+        ImportFrom("typing", "List", "Tuple")
+        ImportFrom("typing", "prod")
+        FuncDef("sum_product", Params("numbers"),
+          Return(
+            TupleExpr(
+              Call(Name("sum"), Name("numbers")),
+              Call(Name("prod"), Name("numbers"))))))
+      => .K
+    </k>
+    <input> PyList(IS) </input>
+    <functions>
+      .Map
+      => "sum_product" |-> Closure(
+           "numbers",
+           TupleExpr(
+             Call(Name("sum"), Name("numbers")),
+             Call(Name("prod"), Name("numbers"))))
+    </functions>
+    <result> .K => expectedSumProduct(IS) </result>
+endmodule
diff --git a/evidence/spec-vacuity-audit.k b/evidence/spec-vacuity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..5a10a3b892c46ee4e6bbc38bcb08abac7b265784
--- /dev/null
+++ b/evidence/spec-vacuity-audit.k
@@ -0,0 +1,36 @@
+requires "verification.k"
+
+module SUM-PRODUCT-SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // Reviewer-authored false postcondition: sum is required to be one larger.
+  // The empty-list witness satisfies the precondition, executes to (0, 1),
+  // and contradicts this destination (1, 1).
+  claim
+    <k>
+      Module(
+        ImportFrom("typing", "List", "Tuple")
+        ImportFrom("math", "prod")
+        FuncDef("sum_product", Params("numbers"),
+          Return(
+            TupleExpr(
+              Call(Name("sum"), Name("numbers")),
+              Call(Name("prod"), Name("numbers"))))))
+      => .K
+    </k>
+    <input> PyList(IS) </input>
+    <functions>
+      .Map
+      => "sum_product" |-> Closure(
+           "numbers",
+           TupleExpr(
+             Call(Name("sum"), Name("numbers")),
+             Call(Name("prod"), Name("numbers"))))
+    </functions>
+    <result>
+      .K
+      => PyTuple(
+           PyInt(sumInts(IS) +Int 1),
+           PyInt(productInts(IS)))
+    </result>
+endmodule
