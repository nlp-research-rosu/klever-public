184:# ---------------------------------------------------------------------------
185:# Closure scopes (Python's own symtable, faithfully exposed)
186:# ---------------------------------------------------------------------------
187:# (name, lineno) -> (cellvars, freevars, nested). A def/lambda gets the
188:# ANNOTATED node form iff it is nested inside a function or has cells/frees;
189:# module-level capture-free defs keep the old shape (zero churn).
190:SCOPES: dict = {}
191:
192:
193:def _frees(table):
194:    return set(table.get_frees()) if isinstance(table, symtable.Function) else set()
195:
196:
197:def _deep_frees(table):
198:    out = _frees(table)
199:    for g in table.get_children():
200:        out |= _deep_frees(g) - set(table.get_locals())
201:    return out
202:
203:
204:def _walk_symtable(table, depth=0):
205:    for child in table.get_children():
206:        if child.get_type() in ("function", "lambda"):
207:            frees = sorted(_frees(child))
208:            cells = sorted(
209:                s for s in child.get_locals()
210:                if any(s in _deep_frees(g) for g in child.get_children())
211:            )
212:            SCOPES[(child.get_name(), child.get_lineno())] = (
213:                cells, frees, depth > 0 or table.get_type() != "module")
214:        _walk_symtable(child, depth + (1 if child.get_type() in ("function", "lambda") else 0))
215:
