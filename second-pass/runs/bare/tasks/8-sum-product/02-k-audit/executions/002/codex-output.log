229:        if isinstance(v, bool):                 # MUST precede int (bool ⊂ int)
230:            return Ctor("Bool", "true" if v else "false")
231:        if isinstance(v, int):
232:            return Ctor("Int", str(v))
233:        if isinstance(v, float):
