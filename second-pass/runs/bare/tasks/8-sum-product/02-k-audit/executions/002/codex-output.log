326:    if isinstance(node, ast.GeneratorExp):
327:        return Ctor("GenExp", emit_expr(node.elt), _gens(node.generators))
328:    if isinstance(node, ast.DictComp):
329:        return Ctor("DictComp", emit_expr(node.key), emit_expr(node.value),
330:                    _gens(node.generators))
331:
332:    raise Unsupported(f"Expr {type(node).__name__}")
