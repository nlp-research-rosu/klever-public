139:
140:# ---------------------------------------------------------------------------
141:# Term model: a .mpy term is a tree of these three node kinds.
142:#   Ctor(name, *args)  -> `name(arg, arg, ...)`  (comma-separated args)
143:#   Seq([item, ...])   -> a statement list: juxtaposed, no parens, no commas
144:#   str                -> a leaf token already in K surface form
145:#                         (a quoted string `"op"`, a number `0`, `true`, `Break`)
146:# ---------------------------------------------------------------------------
147:class Ctor:
148:    __slots__ = ("name", "args")
149:
150:    def __init__(self, name: str, *args):
151:        self.name = name
152:        self.args = list(args)
153:
154:
155:class Seq:
156:    __slots__ = ("items",)
157:
158:    def __init__(self, items):
159:        self.items = list(items)
