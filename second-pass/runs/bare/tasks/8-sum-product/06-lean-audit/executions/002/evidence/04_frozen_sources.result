verification.k
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // The mathematical postcondition from the HumanEval prompt.
     7	  syntax PyVal ::= expectedSumProduct(Ints) [function, total]
     8	
     9	  rule expectedSumProduct(IS)
    10	       => PyTuple(PyInt(sumInts(IS)), PyInt(productInts(IS)))
    11	endmodule

semantic.k
     1	requires "domains.md"
     2	
     3	module MPY-SYNTAX
     4	  imports INT-SYNTAX
     5	  imports STRING-SYNTAX
     6	
     7	  syntax Module
     8	  syntax Stmt
     9	  syntax Stmts
    10	  syntax Expr
    11	  syntax Params
    12	  syntax Strings
    13	
    14	  syntax Module ::= "Module" "(" Stmts ")" [symbol(Module)]
    15	  syntax Stmts ::= List{Stmt, ""} [symbol(Stmts)]
    16	  syntax Strings ::= List{String, ","} [symbol(Strings)]
    17	
    18	  syntax Stmt ::= "ImportFrom" "(" String "," Strings ")"
    19	                [symbol(ImportFrom)]
    20	                | "FuncDef" "(" String "," Params "," Stmts ")"
    21	                [symbol(FuncDef)]
    22	                | "Return" "(" Expr ")"
    23	                [symbol(Return)]
    24	
    25	  syntax Params ::= "Params" "(" String ")" [symbol(Params)]
    26	
    27	  syntax Expr ::= "Name" "(" String ")" [symbol(Name)]
    28	                | "TupleExpr" "(" Expr "," Expr ")"
    29	                [symbol(TupleExpr)]
    30	                | "Call" "(" Expr "," Expr ")"
    31	                [symbol(Call)]
    32	endmodule
    33	
    34	module MPY
    35	  imports MPY-SYNTAX
    36	  imports INT
    37	  imports MAP
    38	
    39	  syntax Ints
    40	  syntax Ints ::= ".Ints" [symbol(noInts)]
    41	                | Int "," Ints [symbol(consInts)]
    42	
    43	  syntax PyVal
    44	  syntax PyVal ::= "PyInt" "(" Int ")" [symbol(PyInt)]
    45	                 | "PyList" "(" Ints ")" [symbol(PyList)]
    46	                 | "PyTuple" "(" PyVal "," PyVal ")" [symbol(PyTuple)]
    47	
    48	  syntax Closure
    49	  syntax Closure ::= "Closure" "(" String "," Expr ")"
    50	                     [symbol(Closure)]
    51	
    52	  syntax KItem ::= "#exec" "(" Stmts ")" [symbol(execStmts)]
    53	                 | "#invoke" "(" String "," PyVal ")"
    54	                   [symbol(invoke)]
    55	
    56	  syntax Int ::= sumInts(Ints) [function, total]
    57	               | productInts(Ints) [function, total]
    58	  syntax PyVal ::= eval(Expr, Map) [function]
    59	                 | sumValue(PyVal) [function]
    60	                 | productValue(PyVal) [function]
    61	                 | lookupValue(Map, String) [function]
    62	
    63	  configuration
    64	    <python>
    65	      <k> $PGM:Module </k>
    66	      <input> $INPUT:PyVal </input>
    67	      <functions> .Map </functions>
    68	      <result> .K </result>
    69	    </python>
    70	
    71	  rule <k> Module(SS) => #exec(SS) ~> #invoke("sum_product", V) ... </k>
    72	       <input> V </input>
    73	
    74	  rule #exec(.Stmts) => .K
    75	  rule #exec(S SS) => S ~> #exec(SS)
    76	
    77	  rule ImportFrom(_, _) => .K
    78	
    79	  rule <k> FuncDef(F, Params(P), Return(E)) => .K ... </k>
    80	       <functions> FS => FS [ F <- Closure(P, E) ] </functions>
    81	
    82	  rule <k> #invoke(F, V) => .K ... </k>
    83	       <functions> ... F |-> Closure(P, E) ... </functions>
    84	       <result> .K => eval(E, P |-> V) </result>
    85	
    86	  rule eval(Name(X), ENV) => lookupValue(ENV, X)
    87	  rule lookupValue((X |-> V:PyVal) _REST, X) => V
    88	  rule eval(TupleExpr(A, B), ENV)
    89	       => PyTuple(eval(A, ENV), eval(B, ENV))
    90	  rule eval(Call(Name("sum"), A), ENV)
    91	       => sumValue(eval(A, ENV))
    92	  rule eval(Call(Name("prod"), A), ENV)
    93	       => productValue(eval(A, ENV))
    94	
    95	  rule sumValue(PyList(IS)) => PyInt(sumInts(IS))
    96	  rule productValue(PyList(IS)) => PyInt(productInts(IS))
    97	
    98	  rule sumInts(.Ints) => 0
    99	  rule sumInts(I , IS) => I +Int sumInts(IS)
   100	  rule productInts(.Ints) => 1
   101	  rule productInts(I , IS) => I *Int productInts(IS)
   102	endmodule

spec.k
     1	requires "verification.k"
     2	
     3	module SUM-PRODUCT-SPEC
     4	  imports VERIFICATION
     5	
     6	  claim
     7	    <k>
     8	      Module(
     9	        ImportFrom("typing", "List", "Tuple")
    10	        ImportFrom("math", "prod")
    11	        FuncDef("sum_product", Params("numbers"),
    12	          Return(
    13	            TupleExpr(
    14	              Call(Name("sum"), Name("numbers")),
    15	              Call(Name("prod"), Name("numbers"))))))
    16	      => .K
    17	    </k>
    18	    <input> PyList(IS) </input>
    19	    <functions>
    20	      .Map
    21	      => "sum_product" |-> Closure(
    22	           "numbers",
    23	           TupleExpr(
    24	             Call(Name("sum"), Name("numbers")),
    25	             Call(Name("prod"), Name("numbers"))))
    26	    </functions>
    27	    <result> .K => expectedSumProduct(IS) </result>
    28	endmodule

solution.mpy
     1	Module(
     2	  ImportFrom("typing", "List", "Tuple")
     3	  ImportFrom("math", "prod")
     4	  FuncDef("sum_product", Params("numbers"),
     5	    Return(
     6	      TupleExpr(
     7	        Call(Name("sum"), Name("numbers")),
     8	        Call(Name("prod"), Name("numbers"))))))

solution.py
     1	from typing import List, Tuple
     2	from math import prod
     3	
     4	
     5	def sum_product(numbers: List[int]) -> Tuple[int, int]:
     6	    return (sum(numbers), prod(numbers))

prompt.py
     1	from typing import List, Tuple
     2	
     3	
     4	def sum_product(numbers: List[int]) -> Tuple[int, int]:
     5	    """ For a given list of integers, return a tuple consisting of a sum and a product of all the integers in a list.
     6	    Empty sum should be equal to 0 and empty product should be equal to 1.
     7	    >>> sum_product([])
     8	    (0, 1)
     9	    >>> sum_product([1, 2, 3, 4])
    10	    (10, 24)
    11	    """

prove.sh (read only; not executed)
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd "$(dirname "$0")"
     5	
     6	# Recreate the constructor term from the submitted Python implementation.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	
     9	# Check the Python implementation against the prompt examples and an edge case.
    10	python3 - <<'PY'
    11	from solution import sum_product
    12	
    13	assert sum_product([]) == (0, 1)
    14	assert sum_product([1, 2, 3, 4]) == (10, 24)
    15	assert sum_product([-2, 0, 5]) == (3, 0)
    16	print("Python checks passed")
    17	PY
    18	
    19	# Compile the executable semantics and exercise the translated program.
    20	kompile semantic.k --backend llvm --main-module MPY --syntax-module MPY-SYNTAX
    21	
    22	krun solution.mpy -cINPUT='PyList(.Ints)' \
    23	  --definition semantic-kompiled \
    24	  | grep -F 'PyTuple ( PyInt ( 0 ) , PyInt ( 1 ) )'
    25	
    26	krun solution.mpy -cINPUT='PyList(1, 2, 3, 4, .Ints)' \
    27	  --definition semantic-kompiled \
    28	  | grep -F 'PyTuple ( PyInt ( 10 ) , PyInt ( 24 ) )'
    29	
    30	krun solution.mpy -cINPUT='PyList(-2, 0, 5, .Ints)' \
    31	  --definition semantic-kompiled \
    32	  | grep -F 'PyTuple ( PyInt ( 3 ) , PyInt ( 0 ) )'
    33	
    34	# Compile the proof semantics and prove the universal symbolic-list claim.
    35	kompile verification.k --backend haskell \
    36	  --main-module VERIFICATION --syntax-module MPY-SYNTAX
    37	
    38	kprove spec.k --definition verification-kompiled \
    39	  --spec-module SUM-PRODUCT-SPEC | grep -x '#Top'
