+                "mechanical_checker_lock_sha256"
+            ],
+            "generator_historical_code_identities": {
+                "exporter_sha256": generator_manifest["exporter_sha256"],
+                "klean_py_sha256": generator_manifest["klean_py_sha256"],
+            },
+            "checks": checks,
+        },
+        indent=2,
+        sort_keys=True,
+    )
+)
