codex
The root cause is now concrete: processes see namespace PIDs, while `/proc` exposes host PIDs, so Lean’s hard-coded `/proc/<getpid()>/exe` lookup returns `ENOENT`. I’m applying a narrowly scoped runtime shim that retries only that failed executable-symlink lookup as `/proc/self/exe`—the equivalent kernel identity path—then I’ll rerun the unchanged trusted preflight and document the shim.
apply patch
patch: completed
/tmp/audit-work/proc_exe_shim.c
diff --git a//tmp/audit-work/proc_exe_shim.c b//tmp/audit-work/proc_exe_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..bc316e92446d7d016ed2385594cabb5b534a0662
--- /dev/null
+++ b//tmp/audit-work/proc_exe_shim.c
@@ -0,0 +1,32 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static int is_proc_pid_exe(const char *path) {
+    if (path == NULL || strncmp(path, "/proc/", 6) != 0) {
+        return 0;
+    }
+    const char *cursor = path + 6;
+    if (*cursor < '0' || *cursor > '9') {
+        return 0;
+    }
+    while (*cursor >= '0' && *cursor <= '9') {
+        ++cursor;
+    }
+    return strcmp(cursor, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    ssize_t result =
+        syscall(SYS_readlinkat, AT_FDCWD, path, buffer, size);
+    if (result < 0 && errno == ENOENT && is_proc_pid_exe(path)) {
+        result = syscall(
+            SYS_readlinkat, AT_FDCWD, "/proc/self/exe", buffer, size
+        );
+    }
+    return result;
+}
