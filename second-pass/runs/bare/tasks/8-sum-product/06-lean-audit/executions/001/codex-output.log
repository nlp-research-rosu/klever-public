+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+int main(void) {
+    char link_path[128];
+    char target[PATH_MAX + 1];
+    snprintf(link_path, sizeof(link_path), "/proc/%d/exe", (int)getpid());
+    ssize_t count = readlink(link_path, target, PATH_MAX);
+    if (count < 0) {
+        fprintf(stderr, "readlink(%s): %s\n", link_path, strerror(errno));
+        return 1;
+    }
+    target[count] = '\0';
+    printf("pid=%d path=%s\n", (int)getpid(), target);
+    return 0;
+}
