new file mode 100644
index 0000000000000000000000000000000000000000..bc316e92446d7d016ed2385594cabb5b534a0662
--- /dev/null
+++ b//tmp/audit-work/proc_exe_shim.c
@@ -0,0 +1,32 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+static int is_proc_pid_exe(const char *path) {
+    if (path == NULL || strncmp(path, "/proc/", 6) != 0) {
+        return 0;
+    }
+    const char *cursor = path + 6;
+    if (*cursor < '0' || *cursor > '9') {
+        return 0;
+    }
+    while (*cursor >= '0' && *cursor <= '9') {
+        ++cursor;
+    }
+    return strcmp(cursor, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    ssize_t result =
+        syscall(SYS_readlinkat, AT_FDCWD, path, buffer, size);
+    if (result < 0 && errno == ENOENT && is_proc_pid_exe(path)) {
+        result = syscall(
+            SYS_readlinkat, AT_FDCWD, "/proc/self/exe", buffer, size
+        );
+    }
+    return result;
+}
diff --git a//tmp/audit-work/proc_probe.c b//tmp/audit-work/proc_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..7102f859a9fae7cd858efac12458c533956f1771
--- /dev/null
+++ b//tmp/audit-work/proc_probe.c
@@ -0,0 +1,20 @@
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+int main(void) {
+    char link_path[128];
+    char target[PATH_MAX + 1];
+    snprintf(link_path, sizeof(link_path), "/proc/%d/exe", (int)getpid());
+    ssize_t count = readlink(link_path, target, PATH_MAX);
+    if (count < 0) {
+        fprintf(stderr, "readlink(%s): %s\n", link_path, strerror(errno));
+        return 1;
+    }
+    target[count] = '\0';
+    printf("pid=%d path=%s\n", (int)getpid(), target);
+    return 0;
+}
