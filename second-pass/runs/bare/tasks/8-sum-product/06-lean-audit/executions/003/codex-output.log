                **obligation,
                "source_span": {
                    "start_line": rule["start_line"],
                    "end_line": rule["end_line"],
                },
                "normalized_sha256": rule["normalized_sha256"],
                "inventory_sha256": rule["inventory_sha256"],
                "discovery_manifest_sha256": rule[
                    "discovery_manifest_sha256"
                ],
            }
        )
    document = {
