COMMAND: bash -lc $'\nset -euo pipefail\nkompile string-probe.k --main-module STRING-PROBE --syntax-module STRING-PROBE-SYNTAX --backend llvm --output-definition string-probe-kompiled\nfor program in probe-len.mpy probe-substr-0-1.mpy probe-substr-2-4.mpy probe-substr-4-5.mpy; do\n  echo "PROBE=$program"\n  krun "$program" --definition string-probe-kompiled\n done\npython3 - <<\'PY\'\ns = "😀A😀E"\nprint(f"PYTHON repr={s!r} len={len(s)}")\nfor start, end in ((0, 1), (2, 4), (4, 5)):\n    print(f"PYTHON_SLICE[{start}:{end}]={s[start:end]!r}")\nPY\n'
EXIT_STATUS: 0
OUTPUT_LINES: 20
OUTPUT_BYTES: 297
--- OUTPUT ---
PROBE=probe-len.mpy
<k>
  10 ~> .K
</k>
PROBE=probe-substr-0-1.mpy
<k>
  "\xf0" ~> .K
</k>
PROBE=probe-substr-2-4.mpy
<k>
  "\x98\x80" ~> .K
</k>
PROBE=probe-substr-4-5.mpy
<k>
  "A" ~> .K
</k>
PYTHON repr='😀A😀E' len=4
PYTHON_SLICE[0:1]='😀'
PYTHON_SLICE[2:4]='😀E'
PYTHON_SLICE[4:5]=''
