COMMAND: bash -lc $'\nset -euo pipefail\nfor file in semantic.k verification.k spec.k; do\n  echo "FILE=$file"\n  rg -n "^[[:space:]]*(requires|module|endmodule|configuration|syntax|rule|claim)" "$file"\n  echo "ATTRIBUTES=$file"\n  rg -n "\\[(function|total|owise|simplification|concrete|priority|anywhere|macro|alias|hook)" "$file" || true\n  echo "COUNTS=$file rules=$(rg -c "^[[:space:]]*rule" "$file" || true) claims=$(rg -c "^[[:space:]]*claim" "$file" || true) syntax=$(rg -c "^[[:space:]]*syntax" "$file" || true)"\ndone\n'
