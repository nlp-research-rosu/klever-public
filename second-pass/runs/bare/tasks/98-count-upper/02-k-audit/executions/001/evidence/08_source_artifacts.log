FILE: /candidate/solution.py
     1	def count_upper(s):
     2	    if len(s) == 0:
     3	        return 0
     4	    if s[0] in "AEIOU":
     5	        return 1 + count_upper(s[2:])
     6	    return count_upper(s[2:])
