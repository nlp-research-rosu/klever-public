     3	module COUNT-UPPER-VERIFICATION
     4	  imports MPY-SEMANTIC
     5	
     6	  syntax Program ::= "countUpperProgram" [function]
     7	
     8	  rule countUpperProgram
     9	    => Module(
    10	         FuncDef("count_upper", Params("s"),
    11	           If(
    12	             Compare(
    13	               Call(Name("len"), Name("s")),
    14	               CmpOp("==", Int(0))
    15	             ),
    16	             Return(Int(0)),
    17	             .Stmts
    18	           )
    19	           If(
    20	             Compare(
    21	               Subscript(Name("s"), Int(0)),
    22	               CmpOp("in", Str("AEIOU"))
    23	             ),
    24	             Return(
    25	               BinOp(
    26	                 "+",
    27	                 Int(1),
    28	                 Call(
    29	                   Name("count_upper"),
    30	                   Subscript(
    31	                     Name("s"),
    32	                     Slice(Int(2), NoBound, NoBound)
    33	                   )
    34	                 )
    35	               )
    36	             ),
    37	             .Stmts
    38	           )
    39	           Return(
    40	             Call(
    41	               Name("count_upper"),
    42	               Subscript(
    43	                 Name("s"),
    44	                 Slice(Int(2), NoBound, NoBound)
    45	               )
    46	             )
    47	           )
    48	         )
    49	       )
    50	
    51	  // Mathematical reference function: inspect the first character, then drop
    52	  // two characters.  Thus each recursive position is exactly an even index of
    53	  // the original string.
    54	  syntax Int ::= countUpperSpec(String) [function, total]
    55	  syntax String ::= dropTwo(String) [function]
    56	
    57	  rule countUpperSpec(S) => 0
    58	    requires lengthString(S) ==Int 0
    59	  rule countUpperSpec(S)
    60	    => 1 +Int countUpperSpec(dropTwo(S))
    61	    requires lengthString(S) =/=Int 0
    62	     andBool substrString(S, 0, 1) ==String "A"
    63	  rule countUpperSpec(S)
    64	    => 1 +Int countUpperSpec(dropTwo(S))
    65	    requires lengthString(S) =/=Int 0
    66	     andBool substrString(S, 0, 1) ==String "E"
    67	  rule countUpperSpec(S)
    68	    => 1 +Int countUpperSpec(dropTwo(S))
    69	    requires lengthString(S) =/=Int 0
    70	     andBool substrString(S, 0, 1) ==String "I"
    71	  rule countUpperSpec(S)
    72	    => 1 +Int countUpperSpec(dropTwo(S))
    73	    requires lengthString(S) =/=Int 0
    74	     andBool substrString(S, 0, 1) ==String "O"
    75	  rule countUpperSpec(S)
    76	    => 1 +Int countUpperSpec(dropTwo(S))
    77	    requires lengthString(S) =/=Int 0
    78	     andBool substrString(S, 0, 1) ==String "U"
    79	  // If neither the empty case nor a vowel case applies, the first character
    80	  // contributes zero. `owise` is the logical complement of the cases above.
    81	  rule countUpperSpec(S) => countUpperSpec(dropTwo(S)) [owise]
    82	
    83	  rule dropTwo(S)
    84	    => substrString(S, minInt(2, lengthString(S)), lengthString(S))
    85	
    86	endmodule
