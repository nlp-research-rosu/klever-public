import hashlib, os, stat

def entries(root, dirs=True):
 r=Path(root)
 out=[]
 for p in r.rglob('*'):
  kind='directory' if p.is_dir() else 'file' if p.is_file() else 'other'
  if kind=='file' or dirs: out.append((p.relative_to(r).as_posix(),kind,p))
 return sorted(out)

def variants(root):
 es=entries(root,True); fs=[x for x in es if x[1]=='file']
 funcs={}
 for name, seq, f in [
  ('rel-null-bytes',fs,lambda rel,k,p: rel.encode()+b'\\0'+p.read_bytes()),
  ('rel-newline-bytes',fs,lambda rel,k,p: rel.encode()+b'\\n'+p.read_bytes()),
  ('rel-null-hexdigest-newline',fs,lambda rel,k,p: rel.encode()+b'\\0'+hashlib.sha256(p.read_bytes()).hexdigest().encode()+b'\\n'),
  ('sha256sum-lines',fs,lambda rel,k,p: hashlib.sha256(p.read_bytes()).hexdigest().encode()+b'  '+rel.encode()+b'\\n'),
  ('rel-null-digest',fs,lambda rel,k,p: rel.encode()+b'\\0'+hashlib.sha256(p.read_bytes()).digest()),
  ('kind-rel-null-bytes',es,lambda rel,k,p: k.encode()+b'\\0'+rel.encode()+b'\\0'+(p.read_bytes() if k=='file' else b'')),
  ('rel-null-kind-null-bytes',es,lambda rel,k,p: rel.encode()+b'\\0'+k.encode()+b'\\0'+(p.read_bytes() if k=='file' else b'')),
  ('rel-kind-bytes',es,lambda rel,k,p: rel.encode()+k.encode()+(p.read_bytes() if k=='file' else b'')),
 ]:
  h=hashlib.sha256()
  for x in seq:h.update(f(*x))
  funcs[name]=h.hexdigest()
 return funcs
for r in ['/candidate','/generation-evidence/codex-trace']:
 print(r)
 for k,v in variants(r).items():print(k,v)
PY" in /audit-output
