/bin/bash -lc 'kompile verification.k --main-module COUNT-UPPER-VERIFICATION --syntax-module MPY-SYNTAX --backend haskell -o .kprove/verification-kompiled && kprove spec.k --spec-module COUNT-UPPER-SPEC --definition .kprove/verification-kompiled' in /workspace
