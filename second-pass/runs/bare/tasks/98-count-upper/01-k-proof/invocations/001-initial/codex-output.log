new file mode 100644
index 0000000000000000000000000000000000000000..edda1467070c75a41b5406e95af8a10909ac9987
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,140 @@
+requires "domains.k"
+
+module MPY-SYNTAX
+  imports DOMAINS
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Str" "(" String ")"
+                | "Call" "(" Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "Subscript" "(" Expr "," Index ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Index ::= Expr
+                 | "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr | "NoBound"
+
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+
+  syntax Value ::= intVal(Int)
+                 | strVal(String)
+                 | boolVal(Bool)
+
+  syntax Outcome ::= normal
+                   | returned(Value)
+
+  syntax KItem ::= "run" "(" Program "," String ")"
+
+  configuration
+    <mpy>
+      <k> run($PGM:Program, $INPUT:String) </k>
+    </mpy>
+
+  // A small, explicit evaluator for exactly the source-language forms used by
+  // solution.mpy.  The translator remains purely syntactic; all meaning below
+  // is supplied by this definition.
+  syntax Value ::= evalProgram(Program, String) [function]
+  syntax Outcome ::= evalStmts(Stmts, String, Program) [function]
+                   | evalBranch(Value, Stmts, Stmts, Stmts, String, Program) [function]
+                   | continueWith(Outcome, Stmts, String, Program) [function]
+  syntax Value ::= evalExpr(Expr, String, Program) [function]
+                 | valueOf(Outcome) [function]
+  syntax String ::= stringOf(Value) [function]
+                  | sliceFrom(String, Int) [function]
+  syntax Int ::= intOf(Value) [function]
+  syntax Bool ::= equalValues(Value, Value) [function]
+                | memberString(Value, Value) [function]
+
+  rule <k> run(P, S) => evalProgram(P, S) ... </k>
+
+  rule evalProgram(
+         Module(FuncDef("count_upper", Params("s"), BODY)),
+         S
+       )
+    => valueOf(
+         evalStmts(
+           BODY,
+           S,
+           Module(FuncDef("count_upper", Params("s"), BODY))
+         )
+       )
+
+  rule evalStmts(.Stmts, _, _) => normal
+  rule evalStmts(Return(E) REST, S, P)
+    => returned(evalExpr(E, S, P))
+  rule evalStmts(If(COND, THEN, ELSE) REST, S, P)
+    => evalBranch(evalExpr(COND, S, P), THEN, ELSE, REST, S, P)
+
+  rule evalBranch(boolVal(true), THEN, _, REST, S, P)
+    => continueWith(evalStmts(THEN, S, P), REST, S, P)
+  rule evalBranch(boolVal(false), _, ELSE, REST, S, P)
+    => continueWith(evalStmts(ELSE, S, P), REST, S, P)
+
+  rule continueWith(returned(V), _, _, _) => returned(V)
+  rule continueWith(normal, REST, S, P) => evalStmts(REST, S, P)
+
+  rule valueOf(returned(V)) => V
+
+  rule evalExpr(Name("s"), S, _) => strVal(S)
+  rule evalExpr(Int(I), _, _) => intVal(I)
+  rule evalExpr(Str(S), _, _) => strVal(S)
+
+  rule evalExpr(Call(Name("len"), ARG), S, P)
+    => intVal(lengthString(stringOf(evalExpr(ARG, S, P))))
+  rule evalExpr(Call(Name("count_upper"), ARG), S, P)
+    => evalProgram(P, stringOf(evalExpr(ARG, S, P)))
+
+  rule evalExpr(Compare(LEFT, CmpOp("==", RIGHT)), S, P)
+    => boolVal(equalValues(evalExpr(LEFT, S, P), evalExpr(RIGHT, S, P)))
+  rule evalExpr(Compare(LEFT, CmpOp("in", RIGHT)), S, P)
+    => boolVal(memberString(evalExpr(LEFT, S, P), evalExpr(RIGHT, S, P)))
+
+  rule evalExpr(Subscript(BASE, Int(I)), S, P)
+    => strVal(
+         substrString(
+           stringOf(evalExpr(BASE, S, P)),
+           I,
+           I +Int 1
+         )
+       )
+  rule evalExpr(
+         Subscript(BASE, Slice(Int(I), NoBound, NoBound)),
+         S,
+         P
+       )
+    => strVal(sliceFrom(stringOf(evalExpr(BASE, S, P)), I))
+
+  rule evalExpr(BinOp("+", LEFT, RIGHT), S, P)
+    => intVal(
+         intOf(evalExpr(LEFT, S, P))
+         +Int intOf(evalExpr(RIGHT, S, P))
+       )
+
+  rule stringOf(strVal(S)) => S
+  rule intOf(intVal(I)) => I
+
+  rule equalValues(intVal(I), intVal(J)) => I ==Int J
+  rule equalValues(strVal(S), strVal(T)) => S ==String T
+
+  rule memberString(strVal(NEEDLE), strVal(HAYSTACK))
+    => findString(HAYSTACK, NEEDLE, 0) >=Int 0
+
+  // Python clamps a positive lower slice bound to the string length.
+  rule sliceFrom(S, I)
+    => substrString(S, minInt(maxInt(I, 0), lengthString(S)), lengthString(S))
+
+endmodule
