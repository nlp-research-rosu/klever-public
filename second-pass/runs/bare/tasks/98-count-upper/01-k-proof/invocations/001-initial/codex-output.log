+module COUNT-UPPER-SPEC
+  imports COUNT-UPPER-VERIFICATION
+
+  // Total functional correctness for every K String.
+  claim <k> run(countUpperProgram, S:String)
+          => intVal(countUpperSpec(S)) ... </k>
+
+  // The examples from prompt.py.
+  claim <k> run(countUpperProgram, "aBCdEf") => intVal(1) ... </k>
+  claim <k> run(countUpperProgram, "abcdefg") => intVal(0) ... </k>
+  claim <k> run(countUpperProgram, "dBBE") => intVal(0) ... </k>
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..02d88a36892a66b6750fa8d1f7f54190b60ce8f8
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,86 @@
+requires "semantic.k"
+
+module COUNT-UPPER-VERIFICATION
+  imports MPY-SEMANTIC
+
+  syntax Program ::= "countUpperProgram" [function]
+
+  rule countUpperProgram
+    => Module(
+         FuncDef("count_upper", Params("s"),
+           If(
+             Compare(
+               Call(Name("len"), Name("s")),
+               CmpOp("==", Int(0))
+             ),
+             Return(Int(0)),
+             .Stmts
+           )
+           If(
+             Compare(
+               Subscript(Name("s"), Int(0)),
+               CmpOp("in", Str("AEIOU"))
+             ),
+             Return(
+               BinOp(
+                 "+",
+                 Int(1),
+                 Call(
+                   Name("count_upper"),
+                   Subscript(
+                     Name("s"),
+                     Slice(Int(2), NoBound, NoBound)
+                   )
+                 )
+               )
+             ),
+             .Stmts
+           )
+           Return(
+             Call(
+               Name("count_upper"),
+               Subscript(
+                 Name("s"),
+                 Slice(Int(2), NoBound, NoBound)
+               )
+             )
+           )
+         )
+       )
+
+  // Mathematical reference function: inspect the first character, then drop
+  // two characters.  Thus each recursive position is exactly an even index of
+  // the original string.
+  syntax Int ::= countUpperSpec(String) [function, total]
+  syntax String ::= dropTwo(String) [function]
+
+  rule countUpperSpec(S) => 0
+    requires lengthString(S) ==Int 0
+  rule countUpperSpec(S)
+    => 1 +Int countUpperSpec(dropTwo(S))
+    requires lengthString(S) =/=Int 0
+     andBool substrString(S, 0, 1) ==String "A"
+  rule countUpperSpec(S)
+    => 1 +Int countUpperSpec(dropTwo(S))
+    requires lengthString(S) =/=Int 0
+     andBool substrString(S, 0, 1) ==String "E"
+  rule countUpperSpec(S)
+    => 1 +Int countUpperSpec(dropTwo(S))
+    requires lengthString(S) =/=Int 0
+     andBool substrString(S, 0, 1) ==String "I"
+  rule countUpperSpec(S)
+    => 1 +Int countUpperSpec(dropTwo(S))
+    requires lengthString(S) =/=Int 0
+     andBool substrString(S, 0, 1) ==String "O"
+  rule countUpperSpec(S)
+    => 1 +Int countUpperSpec(dropTwo(S))
+    requires lengthString(S) =/=Int 0
+     andBool substrString(S, 0, 1) ==String "U"
+  // If neither the empty case nor a vowel case applies, the first character
+  // contributes zero. `owise` is the logical complement of the cases above.
+  rule countUpperSpec(S) => countUpperSpec(dropTwo(S)) [owise]
+
+  rule dropTwo(S)
+    => substrString(S, minInt(2, lengthString(S)), lengthString(S))
+
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..b8fcf8acaf19ed31f237dc6dd660bf286a690e64
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,50 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+# Recheck that the committed constructor term is exactly the translator output.
+cmp solution.mpy <(python3 py2mpy.py solution.py)
+
+# Check the Python implementation independently on examples and edge cases.
+python3 - <<'PY'
+from solution import count_upper
+
+tests = {
+    "aBCdEf": 1,
+    "abcdefg": 0,
+    "dBBE": 0,
+    "": 0,
+    "AEIOU": 3,
+    "xA": 0,
+}
+for text, expected in tests.items():
+    assert count_upper(text) == expected, (text, count_upper(text), expected)
+PY
+
+mkdir -p .build
+
+# Compile the executable semantics and exercise the translated program.
+kompile semantic.k \
+  --main-module MPY-SEMANTIC \
+  --syntax-module MPY-SYNTAX \
+  --backend llvm \
+  -o .build/semantic-kompiled
+
+krun solution.mpy -cINPUT='"aBCdEf"' \
+  --definition .build/semantic-kompiled | grep -F 'intVal ( 1 )'
+krun solution.mpy -cINPUT='"abcdefg"' \
+  --definition .build/semantic-kompiled | grep -F 'intVal ( 0 )'
+krun solution.mpy -cINPUT='"dBBE"' \
+  --definition .build/semantic-kompiled | grep -F 'intVal ( 0 )'
+
+# Compile the verification extension and prove every claim in spec.k.
+kompile verification.k \
+  --main-module COUNT-UPPER-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --backend haskell \
+  -o .build/verification-kompiled
+
+kprove spec.k \
+  --spec-module COUNT-UPPER-SPEC \
+  --definition .build/verification-kompiled
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..be25ffbcfa8a62b1198f4f06e2e63ff877c2b63b
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,168 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports DOMAINS
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Str" "(" String ")"
+                | "Call" "(" Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "Subscript" "(" Expr "," Index ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Index ::= Expr
+                 | "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr | "NoBound"
+
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+
+  syntax Value ::= intVal(Int)
+                 | strVal(String)
+                 | boolVal(Bool)
+                 | vowelVal(String)
+
+  syntax Outcome ::= "normal"
+                   | returned(Value)
+
+  syntax KItem ::= "run" "(" Program "," String ")"
+
+  configuration
+    <mpy>
+      <k> run($PGM:Program, $INPUT:String) </k>
+    </mpy>
+
+  // A small-step evaluator for exactly the source-language forms used by
+  // solution.mpy. The translator remains purely syntactic; all meaning below
+  // is supplied here. Explicit continuation items preserve Python's
+  // left-to-right evaluation order and expose symbolic branches to kprove.
+  syntax KItem ::= exec(Stmts, String, Program)
+                 | eval(Expr, String, Program)
+                 | "programResult"
+                 | "makeReturned"
+                 | branch(Stmts, Stmts, Stmts, String, Program)
+                 | continueWith(Stmts, String, Program)
+                 | "lenResult"
+                 | callResult(Program)
+                 | compareLeft(String, Expr, String, Program)
+                 | compareRight(String, Value)
+                 | indexResult(Int)
+                 | sliceResult(Int)
+                 | binLeft(String, Expr, String, Program)
+                 | binRight(String, Value)
+
+  rule <k> run(
+               Module(FuncDef("count_upper", Params("s"), BODY)) #as P,
+               S
+             )
+          => exec(BODY, S, P) ~> programResult ... </k>
+
+  rule <k> exec(.Stmts, _, _) => normal ... </k>
+  rule <k> exec(Return(E) _REST, S, P)
+          => eval(E, S, P) ~> makeReturned ... </k>
+  rule <k> exec(If(COND, THEN, ELSE) REST, S, P)
+          => eval(COND, S, P)
+             ~> branch(THEN, ELSE, REST, S, P) ... </k>
+
+  rule <k> boolVal(B)
+             ~> branch(THEN, _, REST, S, P)
+          => exec(THEN, S, P)
+             ~> continueWith(REST, S, P) ... </k>
+    requires B
+  rule <k> boolVal(B)
+             ~> branch(_, ELSE, REST, S, P)
+          => exec(ELSE, S, P)
+             ~> continueWith(REST, S, P) ... </k>
+    requires notBool B
+  rule <k> vowelVal("A") ~> branch(THEN, _, REST, S, P)
+          => exec(THEN, S, P) ~> continueWith(REST, S, P) ... </k>
+  rule <k> vowelVal("E") ~> branch(THEN, _, REST, S, P)
+          => exec(THEN, S, P) ~> continueWith(REST, S, P) ... </k>
+  rule <k> vowelVal("I") ~> branch(THEN, _, REST, S, P)
+          => exec(THEN, S, P) ~> continueWith(REST, S, P) ... </k>
+  rule <k> vowelVal("O") ~> branch(THEN, _, REST, S, P)
+          => exec(THEN, S, P) ~> continueWith(REST, S, P) ... </k>
+  rule <k> vowelVal("U") ~> branch(THEN, _, REST, S, P)
+          => exec(THEN, S, P) ~> continueWith(REST, S, P) ... </k>
+  rule <k> vowelVal(C) ~> branch(_, ELSE, REST, S, P)
+          => exec(ELSE, S, P) ~> continueWith(REST, S, P) ... </k>
+    requires C =/=String "A"
+     andBool C =/=String "E"
+     andBool C =/=String "I"
+     andBool C =/=String "O"
+     andBool C =/=String "U"
+
+  rule <k> returned(V) ~> continueWith(_, _, _) => returned(V) ... </k>
+  rule <k> normal ~> continueWith(REST, S, P)
+          => exec(REST, S, P) ... </k>
+  rule <k> V:Value ~> makeReturned => returned(V) ... </k>
+  rule <k> returned(V) ~> programResult => V ... </k>
+
+  rule <k> eval(Name("s"), S, _) => strVal(S) ... </k>
+  rule <k> eval(Int(I), _, _) => intVal(I) ... </k>
+  rule <k> eval(Str(S), _, _) => strVal(S) ... </k>
+
+  rule <k> eval(Call(Name("len"), ARG), S, P)
+          => eval(ARG, S, P) ~> lenResult ... </k>
+  rule <k> strVal(S) ~> lenResult
+          => intVal(lengthString(S)) ... </k>
+
+  rule <k> eval(Call(Name("count_upper"), ARG), S, P)
+          => eval(ARG, S, P) ~> callResult(P) ... </k>
+  rule <k> strVal(S) ~> callResult(P)
+          => run(P, S) ... </k>
+
+  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT)), S, P)
+          => eval(LEFT, S, P)
+             ~> compareLeft(OP, RIGHT, S, P) ... </k>
+  rule <k> LEFT:Value ~> compareLeft(OP, RIGHT, S, P)
+          => eval(RIGHT, S, P)
+             ~> compareRight(OP, LEFT) ... </k>
+  rule <k> intVal(J) ~> compareRight("==", intVal(I))
+          => boolVal(I ==Int J) ... </k>
+  rule <k> strVal("AEIOU") ~> compareRight("in", strVal(NEEDLE))
+          => vowelVal(NEEDLE) ... </k>
+
+  rule <k> eval(Subscript(BASE, Int(I)), S, P)
+          => eval(BASE, S, P) ~> indexResult(I) ... </k>
+  rule <k> strVal(S) ~> indexResult(I)
+          => strVal(substrString(S, I, I +Int 1)) ... </k>
+
+  rule <k> eval(
+               Subscript(BASE, Slice(Int(I), NoBound, NoBound)),
+               S,
+               P
+             )
+          => eval(BASE, S, P) ~> sliceResult(I) ... </k>
+  // Python clamps a positive lower slice bound to the string length.
+  rule <k> strVal(S) ~> sliceResult(I)
+          => strVal(
+               substrString(
+                 S,
+                 minInt(maxInt(I, 0), lengthString(S)),
+                 lengthString(S)
+               )
+             ) ... </k>
+
+  rule <k> eval(BinOp(OP, LEFT, RIGHT), S, P)
+          => eval(LEFT, S, P)
+             ~> binLeft(OP, RIGHT, S, P) ... </k>
+  rule <k> LEFT:Value ~> binLeft(OP, RIGHT, S, P)
+          => eval(RIGHT, S, P) ~> binRight(OP, LEFT) ... </k>
+  rule <k> intVal(J) ~> binRight("+", intVal(I))
+          => intVal(I +Int J) ... </k>
+
+endmodule
