index 0000000000000000000000000000000000000000..a613b6ba950bd1f85f00795bc9968dc71d4e7a95
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,150 @@
+requires "domains.k"
+
+module MPY-SYNTAX
+  imports DOMAINS
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Str" "(" String ")"
+                | "Call" "(" Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "Subscript" "(" Expr "," Index ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Index ::= Expr
+                 | "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr | "NoBound"
+
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+
+  syntax Value ::= intVal(Int)
+                 | strVal(String)
+                 | boolVal(Bool)
+
+  syntax Outcome ::= "normal"
+                   | returned(Value)
+
+  syntax KItem ::= "run" "(" Program "," String ")"
+
+  configuration
+    <mpy>
+      <k> run($PGM:Program, $INPUT:String) </k>
+    </mpy>
+
+  // A small-step evaluator for exactly the source-language forms used by
+  // solution.mpy. The translator remains purely syntactic; all meaning below
+  // is supplied here. Explicit continuation items preserve Python's
+  // left-to-right evaluation order and expose symbolic branches to kprove.
+  syntax KItem ::= exec(Stmts, String, Program)
+                 | eval(Expr, String, Program)
+                 | "programResult"
+                 | "makeReturned"
+                 | branch(Stmts, Stmts, Stmts, String, Program)
+                 | continueWith(Stmts, String, Program)
+                 | "lenResult"
+                 | callResult(Program)
+                 | compareLeft(String, Expr, String, Program)
+                 | compareRight(String, Value)
+                 | indexResult(Int)
+                 | sliceResult(Int)
+                 | binLeft(String, Expr, String, Program)
+                 | binRight(String, Value)
+
+  rule <k> run(
+               Module(FuncDef("count_upper", Params("s"), BODY)) #as P,
+               S
+             )
+          => exec(BODY, S, P) ~> programResult ... </k>
+
+  rule <k> exec(.Stmts, _, _) => normal ... </k>
+  rule <k> exec(Return(E) _REST, S, P)
+          => eval(E, S, P) ~> makeReturned ... </k>
+  rule <k> exec(If(COND, THEN, ELSE) REST, S, P)
+          => eval(COND, S, P)
+             ~> branch(THEN, ELSE, REST, S, P) ... </k>
+
+  rule <k> boolVal(B)
+             ~> branch(THEN, _, REST, S, P)
+          => exec(THEN, S, P)
+             ~> continueWith(REST, S, P) ... </k>
+    requires B
+  rule <k> boolVal(B)
+             ~> branch(_, ELSE, REST, S, P)
+          => exec(ELSE, S, P)
+             ~> continueWith(REST, S, P) ... </k>
+    requires notBool B
+
+  rule <k> returned(V) ~> continueWith(_, _, _) => returned(V) ... </k>
+  rule <k> normal ~> continueWith(REST, S, P)
+          => exec(REST, S, P) ... </k>
+  rule <k> V:Value ~> makeReturned => returned(V) ... </k>
+  rule <k> returned(V) ~> programResult => V ... </k>
+
+  rule <k> eval(Name("s"), S, _) => strVal(S) ... </k>
+  rule <k> eval(Int(I), _, _) => intVal(I) ... </k>
+  rule <k> eval(Str(S), _, _) => strVal(S) ... </k>
+
+  rule <k> eval(Call(Name("len"), ARG), S, P)
+          => eval(ARG, S, P) ~> lenResult ... </k>
+  rule <k> strVal(S) ~> lenResult
+          => intVal(lengthString(S)) ... </k>
+
+  rule <k> eval(Call(Name("count_upper"), ARG), S, P)
+          => eval(ARG, S, P) ~> callResult(P) ... </k>
+  rule <k> strVal(S) ~> callResult(P)
+          => run(P, S) ... </k>
+
+  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT)), S, P)
+          => eval(LEFT, S, P)
+             ~> compareLeft(OP, RIGHT, S, P) ... </k>
+  rule <k> LEFT:Value ~> compareLeft(OP, RIGHT, S, P)
+          => eval(RIGHT, S, P)
+             ~> compareRight(OP, LEFT) ... </k>
+  rule <k> intVal(J) ~> compareRight("==", intVal(I))
+          => boolVal(I ==Int J) ... </k>
+  rule <k> strVal(HAYSTACK) ~> compareRight("in", strVal(NEEDLE))
+          => boolVal(findString(HAYSTACK, NEEDLE, 0) >=Int 0) ... </k>
+
+  rule <k> eval(Subscript(BASE, Int(I)), S, P)
+          => eval(BASE, S, P) ~> indexResult(I) ... </k>
+  rule <k> strVal(S) ~> indexResult(I)
+          => strVal(substrString(S, I, I +Int 1)) ... </k>
+
+  rule <k> eval(
+               Subscript(BASE, Slice(Int(I), NoBound, NoBound)),
+               S,
+               P
+             )
+          => eval(BASE, S, P) ~> sliceResult(I) ... </k>
+  // Python clamps a positive lower slice bound to the string length.
+  rule <k> strVal(S) ~> sliceResult(I)
+          => strVal(
+               substrString(
+                 S,
+                 minInt(maxInt(I, 0), lengthString(S)),
+                 lengthString(S)
+               )
+             ) ... </k>
+
+  rule <k> eval(BinOp(OP, LEFT, RIGHT), S, P)
+          => eval(LEFT, S, P)
+             ~> binLeft(OP, RIGHT, S, P) ... </k>
+  rule <k> LEFT:Value ~> binLeft(OP, RIGHT, S, P)
+          => eval(RIGHT, S, P) ~> binRight(OP, LEFT) ... </k>
+  rule <k> intVal(J) ~> binRight("+", intVal(I))
+          => intVal(I +Int J) ... </k>
+
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..7de90df98ee6c9b3d30b43b9e163fb091af8573c
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def count_upper(s):
+    if len(s) == 0:
+        return 0
+    if s[0] in "AEIOU":
+        return 1 + count_upper(s[2:])
+    return count_upper(s[2:])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2f3dac87ae47a1b3dc6d52483a8ab60e7dea1610
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,15 @@
+requires "verification.k"
+
+module COUNT-UPPER-SPEC
+  imports COUNT-UPPER-VERIFICATION
+
+  // Total functional correctness for every K String.
+  claim <k> run(countUpperProgram, S:String)
+          => intVal(countUpperSpec(S)) ... </k>
+
+  // The examples from prompt.py.
+  claim <k> run(countUpperProgram, "aBCdEf") => intVal(1) ... </k>
+  claim <k> run(countUpperProgram, "abcdefg") => intVal(0) ... </k>
+  claim <k> run(countUpperProgram, "dBBE") => intVal(0) ... </k>
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a58d8cb4f021dbc0f3831109afd65f7e57c6cf8b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,75 @@
+requires "semantic.k"
+
+module COUNT-UPPER-VERIFICATION
+  imports MPY-SEMANTIC
+
+  syntax Program ::= "countUpperProgram" [function]
+
+  rule countUpperProgram
+    => Module(
+         FuncDef("count_upper", Params("s"),
+           If(
+             Compare(
+               Call(Name("len"), Name("s")),
+               CmpOp("==", Int(0))
+             ),
+             Return(Int(0)),
+             .Stmts
+           )
+           If(
+             Compare(
+               Subscript(Name("s"), Int(0)),
+               CmpOp("in", Str("AEIOU"))
+             ),
+             Return(
+               BinOp(
+                 "+",
+                 Int(1),
+                 Call(
+                   Name("count_upper"),
+                   Subscript(
+                     Name("s"),
+                     Slice(Int(2), NoBound, NoBound)
+                   )
+                 )
+               )
+             ),
+             .Stmts
+           )
+           Return(
+             Call(
+               Name("count_upper"),
+               Subscript(
+                 Name("s"),
+                 Slice(Int(2), NoBound, NoBound)
+               )
+             )
+           )
+         )
+       )
+
+  // Mathematical reference function: inspect the first character, then drop
+  // two characters.  Thus each recursive position is exactly an even index of
+  // the original string.
+  syntax Int ::= countUpperSpec(String) [function]
+               | upperVowelScore(String) [function]
+  syntax String ::= firstChar(String) [function]
+                  | dropTwo(String) [function]
+
+  rule countUpperSpec(S) => 0
+    requires lengthString(S) ==Int 0
+  rule countUpperSpec(S)
+    => upperVowelScore(firstChar(S)) +Int countUpperSpec(dropTwo(S))
+    requires lengthString(S) >Int 0
+
+  rule firstChar(S) => substrString(S, 0, 1)
+    requires lengthString(S) >Int 0
+  rule dropTwo(S)
+    => substrString(S, minInt(2, lengthString(S)), lengthString(S))
+
+  rule upperVowelScore(C) => 1
+    requires findString("AEIOU", C, 0) >=Int 0
+  rule upperVowelScore(C) => 0
+    requires findString("AEIOU", C, 0) <Int 0
+
+endmodule

