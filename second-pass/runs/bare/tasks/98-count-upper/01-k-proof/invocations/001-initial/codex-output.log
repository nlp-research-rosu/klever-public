@@ -0,0 +1,15 @@
+requires "verification.k"
+
+module COUNT-UPPER-SPEC
+  imports COUNT-UPPER-VERIFICATION
+
+  // Total functional correctness for every K String.
+  claim <k> run(countUpperProgram, S:String)
+          => intVal(countUpperSpec(S)) ... </k>
+
+  // The examples from prompt.py.
+  claim <k> run(countUpperProgram, "aBCdEf") => intVal(1) ... </k>
+  claim <k> run(countUpperProgram, "abcdefg") => intVal(0) ... </k>
+  claim <k> run(countUpperProgram, "dBBE") => intVal(0) ... </k>
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a58d8cb4f021dbc0f3831109afd65f7e57c6cf8b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,75 @@
+requires "semantic.k"
+
+module COUNT-UPPER-VERIFICATION
+  imports MPY-SEMANTIC
+
+  syntax Program ::= "countUpperProgram" [function]
+
+  rule countUpperProgram
+    => Module(
+         FuncDef("count_upper", Params("s"),
+           If(
+             Compare(
+               Call(Name("len"), Name("s")),
+               CmpOp("==", Int(0))
+             ),
+             Return(Int(0)),
+             .Stmts
+           )
+           If(
+             Compare(
+               Subscript(Name("s"), Int(0)),
+               CmpOp("in", Str("AEIOU"))
+             ),
+             Return(
+               BinOp(
+                 "+",
+                 Int(1),
+                 Call(
+                   Name("count_upper"),
+                   Subscript(
+                     Name("s"),
+                     Slice(Int(2), NoBound, NoBound)
+                   )
+                 )
+               )
+             ),
+             .Stmts
+           )
+           Return(
+             Call(
+               Name("count_upper"),
+               Subscript(
+                 Name("s"),
+                 Slice(Int(2), NoBound, NoBound)
+               )
+             )
+           )
+         )
+       )
+
+  // Mathematical reference function: inspect the first character, then drop
+  // two characters.  Thus each recursive position is exactly an even index of
+  // the original string.
+  syntax Int ::= countUpperSpec(String) [function]
+               | upperVowelScore(String) [function]
+  syntax String ::= firstChar(String) [function]
+                  | dropTwo(String) [function]
+
+  rule countUpperSpec(S) => 0
+    requires lengthString(S) ==Int 0
+  rule countUpperSpec(S)
+    => upperVowelScore(firstChar(S)) +Int countUpperSpec(dropTwo(S))
+    requires lengthString(S) >Int 0
+
+  rule firstChar(S) => substrString(S, 0, 1)
+    requires lengthString(S) >Int 0
+  rule dropTwo(S)
+    => substrString(S, minInt(2, lengthString(S)), lengthString(S))
+
+  rule upperVowelScore(C) => 1
+    requires findString("AEIOU", C, 0) >=Int 0
+  rule upperVowelScore(C) => 0
+    requires findString("AEIOU", C, 0) <Int 0
+
+endmodule

