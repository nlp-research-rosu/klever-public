+          => exec(THEN, S, P)
+             ~> continueWith(REST, S, P) ... </k>
+    requires B
+  rule <k> boolVal(B)
+             ~> branch(_, ELSE, REST, S, P)
+          => exec(ELSE, S, P)
+             ~> continueWith(REST, S, P) ... </k>
+    requires notBool B
+  rule <k> vowelVal("A") ~> branch(THEN, _, REST, S, P)
+          => exec(THEN, S, P) ~> continueWith(REST, S, P) ... </k>
+  rule <k> vowelVal("E") ~> branch(THEN, _, REST, S, P)
+          => exec(THEN, S, P) ~> continueWith(REST, S, P) ... </k>
