Module(
  FuncDef("count_upper", Params("s"),
    If(Compare(Call(Name("len"), Name("s")), CmpOp("==", Int(0))),
      Return(Int(0)),
      )
    If(Compare(Subscript(Name("s"), Int(0)), CmpOp("in", Str("AEIOU"))),
      Return(
        BinOp(
          "+",
          Int(1),
          Call(
            Name("count_upper"),
            Subscript(Name("s"), Slice(Int(2), NoBound, NoBound))))),
      )
    Return(
      Call(
        Name("count_upper"),
        Subscript(Name("s"), Slice(Int(2), NoBound, NoBound))))))
