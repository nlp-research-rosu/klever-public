     9	def is_prime(n):
    10	    if n < 2:
    11	        return False
    12	    return is_prime_from(n, 2)
    13	
    14	
    15	def choose_prime(n, best):
    16	    if is_prime(n) and n > best:
    17	        return n
    18	    return best
    19	
    20	
    21	def largest_prime(lst):
    22	    if len(lst) == 0:
    23	        return 0
    24	    return choose_prime(lst[0], largest_prime(lst[1:]))
    25	
    26	
    27	def digit_sum(n):
    28	    if n < 10:
    29	        return n
    30	    return n % 10 + digit_sum(n // 10)
    31	
    32	
    33	def skjkasdkd(lst):
    34	    return digit_sum(largest_prime(lst))
