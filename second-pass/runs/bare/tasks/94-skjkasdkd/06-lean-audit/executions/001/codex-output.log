            raise KleanPreflightError(
                "source rules and generated obligations are not bijective"
            )
        for key in (
            "normalized_sha256",
            "inventory_sha256",
            "discovery_manifest_sha256",
        ):
            if obligation.get(key) != source_rule[key]:
