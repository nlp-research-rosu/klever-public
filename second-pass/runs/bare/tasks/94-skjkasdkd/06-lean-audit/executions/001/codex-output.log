+PATH=/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin:/opt/runtimeverification-k/pyk/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
+LD_PRELOAD=/tmp/audit-work/proc-self-readlink.so \
