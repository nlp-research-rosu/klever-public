  observed=[{'attributes': [], 'classification': 'DEFINITION', 'end_line': 44, 'module': 'VERIFICATION', 'normalized_sha256': '97839358939c442d48a98dbf7d2a64dbb8968371b2638318453bc452529b49aa', 'rationale': 'Macro expansion defining the named solutionProgram proof term as the translated Python AST.', 'source_rule_id': 'rule-97839358939c442d48a98dbf7d2a64dbb8968371b2638318453bc452529b49aa', 'start_line': 9, 'text': '  rule solutionProgram =>\n    Module(\n      FuncDef("is_prime_from", Params("n", "divisor"),\n        If(Compare(BinOp("*", Name("divisor"), Name("divisor")),\n                   CmpOp(">", Name("n"))),\n          Return(Bool(true)), .Stmts)\n        If(Compare(BinOp("%", Name("n"), Name("divisor")),\n                   CmpOp("==", Int(0))),\n          Return(Bool(false)), .Stmts)\n        Return(Call(Name("is_prime_from"), Name("n"),\n                    BinOp("+", Name("divisor"), Int(1)))))\n      FuncDef("is_prime", Params("n"),\n        If(Compare(Name("n"), CmpOp("<", Int(2))),\n          Return(Bool(false)), .Stmts)\n        Return(Call(Name("is_prime_from"), Name("n"), Int(2))))\n      FuncDef("choose_prime", Params("n", "best"),\n        If(BoolOp("and",\n             Call(Name("is_prime"), Name("n")),\n             Compare(Name("n"), CmpOp(">", Name("best")))),\n          Return(Name("n")), .Stmts)\n        Return(Name("best")))\n      FuncDef("largest_prime", Params("lst"),\n        If(Compare(Call(Name("len"), Name("lst")), CmpOp("==", Int(0))),\n          Return(Int(0)), .Stmts)\n        Return(Call(Name("choose_prime"),\n          Subscript(Name("lst"), Int(0)),\n          Call(Name("largest_prime"),\n            Subscript(Name("lst"), Slice(Int(1), NoBound, NoBound))))))\n      FuncDef("digit_sum", Params("n"),\n        If(Compare(Name("n"), CmpOp("<", Int(10))),\n          Return(Name("n")), .Stmts)\n        Return(BinOp("+", BinOp("%", Name("n"), Int(10)),\n          Call(Name("digit_sum"), BinOp("//", Name("n"), Int(10))))))\n      FuncDef("skjkasdkd", Params("lst"),\n        Return(Call(Name("digit_sum"),\n                    Call(Name("largest_prime"), Name("lst"))))))'}, {'attributes': [], 'classification': 'DEFINITION', 'end_line': 48, 'module': 'VERIFICATION', 'normalized_sha256': '704cd178acd1d0daf598ad83654fbee69c44452e692b568b882dfe2a10c53989', 'rationale': 'Structural helper defining how programDefs extracts the function-definition map from a Module term.', 'source_rule_id': 'rule-704cd178acd1d0daf598ad83654fbee69c44452e692b568b882dfe2a10c53989', 'start_line': 48, 'text': '  rule programDefs(Module(SS)) => collectDefs(SS)'}, {'attributes': [], 'classification': 'DEFINITION', 'end_line': 49, 'module': 'VERIFICATION', 'normalized_sha256': '9a543f2f9c2e87713097e1b67709c4d8e5fc1756c4b334ac22c01a263ac91bb0', 'rationale': 'Macro expansion defining the named solutionDefs proof term from solutionProgram.', 'source_rule_id': 'rule-9a543f2f9c2e87713097e1b67709c4d8e5fc1756c4b334ac22c01a263ac91bb0', 'start_line': 49, 'text': '  rule solutionDefs => programDefs(solutionProgram)'}, {'attributes': [], 'classification': 'DEFINITION', 'end_line': 55, 'module': 'VERIFICATION', 'normalized_sha256': '394121d7cc3a18641aae8c3c2b178633128c3ee6019701c2e7a07932a811afb1', 'rationale': 'Base equation defining refPrimeFrom to succeed once the candidate divisor squared exceeds the number.', 'source_rule_id': 'rule-394121d7cc3a18641aae8c3c2b178633128c3ee6019701c2e7a07932a811afb1', 'start_line': 54, 'text': '  rule refPrimeFrom(N, D) => true\n    requires D *Int D >Int N'}, {'attributes': [], 'classification': 'DEFINITION', 'end_line': 57, 'module': 'VERIFICATION', 'normalized_sha256': 'e01d0e256aaa8dfb3da3d98d391f0c25af27bc17a67437f49d0303660cd0d59c', 'rationale': 'Divisibility case defining refPrimeFrom to fail when the current candidate divides the number.', 'source_rule_id': 'rule-e01d0e256aaa8dfb3da3d98d391f0c25af27bc17a67437f49d0303660cd0d59c', 'start_line': 56, 'text': '  rule refPrimeFrom(N, D) => false\n    requires D *Int D <=Int N andBool N %Int D ==Int 0'}, {'attributes': [], 'classification': 'DEFINITION', 'end_line': 59, 'module': 'VERIFICATION', 'normalized_sha256': 'd288ef34bdb9f0de1657e5d386a68d77e699274deddb393621cc587e2900b384', 'rationale': 'Recursive equation defining refPrimeFrom by advancing to the next candidate divisor.', 'source_rule_id': 'rule-d288ef34bdb9f0de1657e5d386a68d77e699274deddb393621cc587e2900b384', 'start_line': 58, 'text': '  rule refPrimeFrom(N, D) => refPrimeFrom(N, D +Int 1)\n    requires D *Int D <=Int N andBool N %Int D =/=Int 0'}, {'attributes': [], 'classification': 'DEFINITION', 'end_line': 60, 'module': 'VERIFICATION', 'normalized_sha256': 'a51bde87448e8823370051215662eb8573abe7d460b96b1afe8412c4775dbbde', 'rationale': 'Base case defining refPrime as false for integers below two.', 'source_rule_id': 'rule-a51bde87448e8823370051215662eb8573abe7d460b96b1afe8412c4775dbbde', 'start_line': 60, 'text': '  rule refPrime(N) => false requires N <Int 2'}, {'attributes': [], 'classification': 'DEFINITION', 'end_line': 61, 'module': 'VERIFICATION', 'normalized_sha256': 'f1e74ed430dbdf89b860ca2041473cb06f32bb48e7844a391e8175d060195f97', 'rationale': 'Recursive-entry equation defining refPrime for integers at least two via refPrimeFrom.', 'source_rule_id': 'rule-f1e74ed430dbdf89b860ca2041473cb06f32bb48e7844a391e8175d060195f97', 'start_line': 61, 'text': '  rule refPrime(N) => refPrimeFrom(N, 2) requires N >=Int 2'}, {'attributes': [], 'classification': 'DEFINITION', 'end_line': 68, 'module': 'VERIFICATION', 'normalized_sha256': '8a3942d93ffe3f6e6ae64e458c8023039123bed8d78c007b36a907d1e58d565e', 'rationale': 'Selection equation defining refChoose to return a new prime candidate when it exceeds the prior best.', 'source_rule_id': 'rule-8a3942d93ffe3f6e6ae64e458c8023039123bed8d78c007b36a907d1e58d565e', 'start_line': 67, 'text': '  rule refChoose(N, BEST) => N\n    requires refPrime(N) andBool N >Int BEST'}, {'attributes': [], 'classification': 'DEF