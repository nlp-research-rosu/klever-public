+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "BoolOp" "(" String "," Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Subscript" "(" Expr "," Index ")"
+
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  syntax Index ::= Expr
+                 | "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr | "NoBound"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  syntax Val ::= "intVal" "(" Int ")"
+               | "boolVal" "(" Bool ")"
+               | "listVal" "(" Vals ")"
+  syntax Vals ::= List{Val, ","}
+
+  syntax Def ::= "def" "(" Params "," Stmts ")"
+
+  syntax Map ::= collectDefs(Stmts) [function]
+  rule collectDefs(.Stmts) => .Map
+  rule collectDefs(FuncDef(F, P, B) REST)
+    => (F |-> def(P, B)) collectDefs(REST)
+
+  syntax Def ::= getDef(Map, String) [function]
+  rule getDef((F |-> D:Def) REST, F) => D
+
+  syntax Val ::= lookupEnv(Map, String) [function]
+  rule lookupEnv((X |-> V:Val) REST, X) => V
+
+  syntax Map ::= bind(Params, Vals) [function]
+  rule bind(Params(.Strings), .Vals) => .Map
+  rule bind(Params(X, XS), V, VS)
+    => (X |-> V) bind(Params(XS), VS)
+
+  syntax Int ::= valLength(Vals) [function]
+  rule valLength(.Vals) => 0
+  rule valLength(V, VS) => 1 +Int valLength(VS)
+
+  syntax Vals ::= evalExprs(Exprs, Map, Map) [function]
+  rule evalExprs(.Exprs, ENV, DEFS) => .Vals
+  rule evalExprs(E, ES, ENV, DEFS)
+    => evalExpr(E, ENV, DEFS), evalExprs(ES, ENV, DEFS)
+
+  syntax Val ::= evalExpr(Expr, Map, Map) [function]
+               | evalBin(String, Val, Val) [function]
+               | evalCompare(String, Val, Val) [function]
+               | andVal(Val, Val) [function]
+               | lenVal(Val) [function]
+               | firstVal(Val) [function]
+               | tailVal(Val) [function]
+
+  rule evalExpr(Int(I), ENV, DEFS) => intVal(I)
+  rule evalExpr(Bool(B), ENV, DEFS) => boolVal(B)
+  rule evalExpr(Name(X), ENV, DEFS) => lookupEnv(ENV, X)
+  rule evalExpr(BinOp(OP, E1, E2), ENV, DEFS)
+    => evalBin(OP, evalExpr(E1, ENV, DEFS), evalExpr(E2, ENV, DEFS))
+  rule evalExpr(Compare(E, CmpOp(OP, E2)), ENV, DEFS)
+    => evalCompare(OP, evalExpr(E, ENV, DEFS), evalExpr(E2, ENV, DEFS))
+  rule evalExpr(BoolOp("and", E1, E2), ENV, DEFS)
+    => andVal(evalExpr(E1, ENV, DEFS), evalExpr(E2, ENV, DEFS))
+  rule evalExpr(Call(Name("len"), E), ENV, DEFS)
+    => lenVal(evalExpr(E, ENV, DEFS))
+  rule evalExpr(Call(Name(F), ES), ENV, DEFS)
+    => apply(getDef(DEFS, F), evalExprs(ES, ENV, DEFS), DEFS)
+    requires F =/=String "len"
