codex
Symbolic execution exposed an important issue: the initial big-step evaluator was excellent for `krun`, but its function equations could not branch or expose recursive calls to reachability circularities. I’m converting evaluation to a small-step continuation machine. This keeps the same language meaning while making recursive calls visible to `kprove` under an arbitrary continuation—the standard shape needed for induction.
apply patch
patch: completed
/work/semantic.k
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..4b54af5bb8e8450cf05d0ff2f9139c18da1aaf00
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,199 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "BoolOp" "(" String "," Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Subscript" "(" Expr "," Index ")"
+
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  syntax Index ::= Expr
+                 | "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr | "NoBound"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  syntax Val ::= "intVal" "(" Int ")"
+               | "boolVal" "(" Bool ")"
+               | "listVal" "(" Vals ")"
+  syntax Vals ::= List{Val, ","}
+
+  syntax Def ::= "def" "(" Params "," Stmts ")"
+
+  syntax Map ::= collectDefs(Stmts) [function]
+  rule collectDefs(.Stmts) => .Map
+  rule collectDefs(FuncDef(F, P, B) REST)
+    => (F |-> def(P, B)) collectDefs(REST)
+
+  syntax Def ::= getDef(Map, String) [function]
+  rule getDef((F |-> D:Def) REST, F) => D
+
+  syntax Val ::= lookupEnv(Map, String) [function]
+  rule lookupEnv((X |-> V:Val) REST, X) => V
+
+  syntax Map ::= bind(Params, Vals) [function]
+  rule bind(Params(.Strings), .Vals) => .Map
+  rule bind(Params(X, XS), V, VS)
+    => (X |-> V) bind(Params(XS), VS)
+
+  syntax Int ::= valLength(Vals) [function]
+  rule valLength(.Vals) => 0
+  rule valLength(V, VS) => 1 +Int valLength(VS)
+
+  syntax Stmts ::= appendStmts(Stmts, Stmts) [function]
+  rule appendStmts(.Stmts, SS) => SS
+  rule appendStmts(S:Stmt REST, SS) => S appendStmts(REST, SS)
+
+  syntax Result ::= "noResult" | "result" "(" Val ")"
+  syntax KItem ::= "init" "(" Pgm "," Val ")"
+                 | "invokeProgram" "(" Pgm "," Val ")"
+                 | "invoke" "(" String "," Vals "," Map ")"
+                 | "invokeDef" "(" Def "," Vals "," Map ")"
+                 | "execStmts" "(" Stmts "," Map "," Map ")"
+                 | "eval" "(" Expr "," Map "," Map ")"
+                 | "evalArgs" "(" Exprs "," Map "," Map ")"
+                 | "argsDone" "(" Vals ")"
+                 | "returnIf" "(" Stmts "," Stmts "," Stmts "," Map "," Map ")"
+                 | "binLeft" "(" String "," Expr "," Map "," Map ")"
+                 | "binRight" "(" String "," Val ")"
+                 | "compareLeft" "(" String "," Expr "," Map "," Map ")"
+                 | "compareRight" "(" String "," Val ")"
+                 | "andLeft" "(" Expr "," Map "," Map ")"
+                 | "andRight" "(" Bool ")"
+                 | "argsRest" "(" Exprs "," Map "," Map ")"
+                 | "prependArg" "(" Val ")"
+                 | "callWith" "(" String "," Map ")"
+                 | "subscriptWith" "(" Index ")"
+                 | "finish"
+
+  configuration
+    <mpy>
+      <k> init($PGM:Pgm, $ARGS:Val) </k>
+      <result> noResult </result>
+    </mpy>
+
+  rule <k> init(P, A) => invokeProgram(P, A) ~> finish </k>
+  rule <k> invokeProgram(Module(SS), L:Val)
+          => invoke("skjkasdkd", L, collectDefs(SS))
+       </k>
+
+  rule <k> invoke(F, ARGS, DEFS)
+          => invokeDef(getDef(DEFS, F), ARGS, DEFS)
+       </k>
+  rule <k> invokeDef(def(PARAMS, BODY), ARGS, DEFS)
+          => execStmts(BODY, bind(PARAMS, ARGS), DEFS)
+       </k>
+
+  rule <k> execStmts(Return(E) REST, ENV, DEFS)
+          => eval(E, ENV, DEFS)
+       </k>
+  rule <k> execStmts(If(COND, THEN, ELSE) REST, ENV, DEFS)
+          => eval(COND, ENV, DEFS)
+             ~> returnIf(THEN, ELSE, REST, ENV, DEFS)
+       </k>
+  rule <k> boolVal(B) ~> returnIf(THEN, ELSE, REST, ENV, DEFS)
+          => execStmts(appendStmts(THEN, REST), ENV, DEFS)
+       </k>
+    requires B
+  rule <k> boolVal(B) ~> returnIf(THEN, ELSE, REST, ENV, DEFS)
+          => execStmts(appendStmts(ELSE, REST), ENV, DEFS)
+       </k>
+    requires notBool B
+
+  rule <k> eval(Int(I), ENV, DEFS) => intVal(I) </k>
+  rule <k> eval(Bool(B), ENV, DEFS) => boolVal(B) </k>
+  rule <k> eval(Name(X), ENV, DEFS) => lookupEnv(ENV, X) </k>
+
+  rule <k> eval(BinOp(OP, E1, E2), ENV, DEFS)
+          => eval(E1, ENV, DEFS) ~> binLeft(OP, E2, ENV, DEFS)
+       </k>
+  rule <k> V:Val ~> binLeft(OP, E2, ENV, DEFS)
+          => eval(E2, ENV, DEFS) ~> binRight(OP, V)
+       </k>
+  rule <k> intVal(J) ~> binRight("+", intVal(I)) => intVal(I +Int J) </k>
+  rule <k> intVal(J) ~> binRight("*", intVal(I)) => intVal(I *Int J) </k>
+  rule <k> intVal(J) ~> binRight("%", intVal(I)) => intVal(I %Int J) </k>
+    requires J =/=Int 0
+  rule <k> intVal(J) ~> binRight("//", intVal(I)) => intVal(I /Int J) </k>
+    requires J =/=Int 0
+
+  rule <k> eval(Compare(E1, CmpOp(OP, E2)), ENV, DEFS)
+          => eval(E1, ENV, DEFS) ~> compareLeft(OP, E2, ENV, DEFS)
+       </k>
+  rule <k> V:Val ~> compareLeft(OP, E2, ENV, DEFS)
+          => eval(E2, ENV, DEFS) ~> compareRight(OP, V)
+       </k>
+  rule <k> intVal(J) ~> compareRight("<", intVal(I))
+          => boolVal(I <Int J)
+       </k>
+  rule <k> intVal(J) ~> compareRight(">", intVal(I))
+          => boolVal(I >Int J)
+       </k>
+  rule <k> intVal(J) ~> compareRight("==", intVal(I))
+          => boolVal(I ==Int J)
+       </k>
+
+  rule <k> eval(BoolOp("and", E1, E2), ENV, DEFS)
+          => eval(E1, ENV, DEFS) ~> andLeft(E2, ENV, DEFS)
+       </k>
+  rule <k> boolVal(B1) ~> andLeft(E2, ENV, DEFS)
+          => eval(E2, ENV, DEFS) ~> andRight(B1)
+       </k>
+  rule <k> boolVal(B2) ~> andRight(B1) => boolVal(B1 andBool B2) </k>
+
+  rule <k> eval(Call(Name(F), ES), ENV, DEFS)
+          => evalArgs(ES, ENV, DEFS) ~> callWith(F, DEFS)
+       </k>
+  rule <k> evalArgs(.Exprs, ENV, DEFS) => argsDone(.Vals) </k>
+  rule <k> evalArgs(E, ES, ENV, DEFS)
+          => eval(E, ENV, DEFS) ~> argsRest(ES, ENV, DEFS)
+       </k>
+  rule <k> V:Val ~> argsRest(ES, ENV, DEFS)
+          => evalArgs(ES, ENV, DEFS) ~> prependArg(V)
+       </k>
+  rule <k> argsDone(VS) ~> prependArg(V) => argsDone(V, VS) </k>
+  rule <k> argsDone(listVal(VS)) ~> callWith("len", DEFS)
+          => intVal(valLength(VS))
+       </k>
+  rule <k> argsDone(VS) ~> callWith(F, DEFS) => invoke(F, VS, DEFS) </k>
+    requires F =/=String "len"
+
+  rule <k> eval(Subscript(E, INDEX), ENV, DEFS)
+          => eval(E, ENV, DEFS) ~> subscriptWith(INDEX)
+       </k>
+  rule <k> listVal(V, VS) ~> subscriptWith(Int(0)) => V </k>
+  rule <k> listVal(V, VS)
+            ~> subscriptWith(Slice(Int(1), NoBound, NoBound))
+          => listVal(VS)
+       </k>
+
+  rule <k> V:Val ~> finish => .K </k>
+       <result> noResult => result(V) </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..ed2615eb653f16068968721e5b8dbcf1160fd38f
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,34 @@
+def is_prime_from(n, divisor):
+    if divisor * divisor > n:
+        return True
+    if n % divisor == 0:
+        return False
+    return is_prime_from(n, divisor + 1)
+
+
+def is_prime(n):
+    if n < 2:
+        return False
+    return is_prime_from(n, 2)
+
+
+def choose_prime(n, best):
+    if is_prime(n) and n > best:
+        return n
+    return best
+
+
+def largest_prime(lst):
+    if len(lst) == 0:
+        return 0
+    return choose_prime(lst[0], largest_prime(lst[1:]))
+
+
+def digit_sum(n):
+    if n < 10:
+        return n
+    return n % 10 + digit_sum(n // 10)
+
+
+def skjkasdkd(lst):
+    return digit_sum(largest_prime(lst))
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..99af78682e390b401f61d2caf2b333e745dceff7
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,19 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim <mpy>
+          <k> apply(getDef(solutionDefs, "is_prime_from"),
+                    intVal(N), intVal(D), solutionDefs)
+            => boolVal(refPrimeFrom(N, D))
+          </k>
+          <result> R:Result </result>
+        </mpy>
+    requires N >=Int 2 andBool D >=Int 2
+
+  claim <mpy>
+          <k> init(solutionProgram, listVal(.Vals)) => .K </k>
+          <result> noResult => result(intVal(0)) </result>
+        </mpy>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d5b8661988ebd06bd5506a22509df83546a3d15b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,108 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // This macro is the exact AST emitted in solution.mpy.  Keeping it as a K
+  // term lets specifications reason about the translated program itself.
+  syntax Pgm ::= "solutionProgram" [macro]
+  rule solutionProgram =>
+    Module(
+      FuncDef("is_prime_from", Params("n", "divisor"),
+        If(Compare(BinOp("*", Name("divisor"), Name("divisor")),
+                   CmpOp(">", Name("n"))),
+          Return(Bool(true)), .Stmts)
+        If(Compare(BinOp("%", Name("n"), Name("divisor")),
+                   CmpOp("==", Int(0))),
+          Return(Bool(false)), .Stmts)
+        Return(Call(Name("is_prime_from"), Name("n"),
+                    BinOp("+", Name("divisor"), Int(1)))))
+      FuncDef("is_prime", Params("n"),
+        If(Compare(Name("n"), CmpOp("<", Int(2))),
+          Return(Bool(false)), .Stmts)
+        Return(Call(Name("is_prime_from"), Name("n"), Int(2))))
+      FuncDef("choose_prime", Params("n", "best"),
+        If(BoolOp("and",
+             Call(Name("is_prime"), Name("n")),
+             Compare(Name("n"), CmpOp(">", Name("best")))),
+          Return(Name("n")), .Stmts)
+        Return(Name("best")))
+      FuncDef("largest_prime", Params("lst"),
+        If(Compare(Call(Name("len"), Name("lst")), CmpOp("==", Int(0))),
+          Return(Int(0)), .Stmts)
+        Return(Call(Name("choose_prime"),
+          Subscript(Name("lst"), Int(0)),
+          Call(Name("largest_prime"),
+            Subscript(Name("lst"), Slice(Int(1), NoBound, NoBound))))))
+      FuncDef("digit_sum", Params("n"),
+        If(Compare(Name("n"), CmpOp("<", Int(10))),
+          Return(Name("n")), .Stmts)
+        Return(BinOp("+", BinOp("%", Name("n"), Int(10)),
+          Call(Name("digit_sum"), BinOp("//", Name("n"), Int(10))))))
+      FuncDef("skjkasdkd", Params("lst"),
+        Return(Call(Name("digit_sum"),
+                    Call(Name("largest_prime"), Name("lst"))))))
+
+  syntax Map ::= "solutionDefs" [macro]
+  rule solutionDefs => collectDefs(
+      FuncDef("is_prime_from", Params("n", "divisor"),
+        If(Compare(BinOp("*", Name("divisor"), Name("divisor")),
+                   CmpOp(">", Name("n"))),
+          Return(Bool(true)), .Stmts)
+        If(Compare(BinOp("%", Name("n"), Name("divisor")),
+                   CmpOp("==", Int(0))),
+          Return(Bool(false)), .Stmts)
+        Return(Call(Name("is_prime_from"), Name("n"),
+                    BinOp("+", Name("divisor"), Int(1)))))
+      FuncDef("is_prime", Params("n"),
+        If(Compare(Name("n"), CmpOp("<", Int(2))),
+          Return(Bool(false)), .Stmts)
+        Return(Call(Name("is_prime_from"), Name("n"), Int(2))))
+      FuncDef("choose_prime", Params("n", "best"),
+        If(BoolOp("and", Call(Name("is_prime"), Name("n")),
+             Compare(Name("n"), CmpOp(">", Name("best")))),
+          Return(Name("n")), .Stmts)
+        Return(Name("best")))
+      FuncDef("largest_prime", Params("lst"),
+        If(Compare(Call(Name("len"), Name("lst")), CmpOp("==", Int(0))),
+          Return(Int(0)), .Stmts)
+        Return(Call(Name("choose_prime"),
+          Subscript(Name("lst"), Int(0)),
+          Call(Name("largest_prime"),
+            Subscript(Name("lst"), Slice(Int(1), NoBound, NoBound))))))
+      FuncDef("digit_sum", Params("n"),
+        If(Compare(Name("n"), CmpOp("<", Int(10))),
+          Return(Name("n")), .Stmts)
+        Return(BinOp("+", BinOp("%", Name("n"), Int(10)),
+          Call(Name("digit_sum"), BinOp("//", Name("n"), Int(10))))))
+      FuncDef("skjkasdkd", Params("lst"),
+        Return(Call(Name("digit_sum"),
+                    Call(Name("largest_prime"), Name("lst"))))))
+
+  // Independent mathematical reference functions.
+  syntax Bool ::= refPrimeFrom(Int, Int) [function]
+                | refPrime(Int) [function]
+  rule refPrimeFrom(N, D) => true
+    requires D *Int D >Int N
+  rule refPrimeFrom(N, D) => false
+    requires D *Int D <=Int N andBool N %Int D ==Int 0
+  rule refPrimeFrom(N, D) => refPrimeFrom(N, D +Int 1)
+    requires D *Int D <=Int N andBool N %Int D =/=Int 0
+  rule refPrime(N) => false requires N <Int 2
+  rule refPrime(N) => refPrimeFrom(N, 2) requires N >=Int 2
+
+  syntax Int ::= refChoose(Int, Int) [function]
+               | refLargest(Vals) [function]
+               | refDigitSum(Int) [function]
+               | refAnswer(Vals) [function]
+  rule refChoose(N, BEST) => N
+    requires refPrime(N) andBool N >Int BEST
+  rule refChoose(N, BEST) => BEST
+    requires notBool (refPrime(N) andBool N >Int BEST)
+  rule refLargest(.Vals) => 0
+  rule refLargest(intVal(N), REST) => refChoose(N, refLargest(REST))
+  rule refDigitSum(N) => N requires 0 <=Int N andBool N <Int 10
+  rule refDigitSum(N) => N %Int 10 +Int refDigitSum(N /Int 10)
+    requires N >=Int 10
+  rule refAnswer(VS) => refDigitSum(refLargest(VS))
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..4b54af5bb8e8450cf05d0ff2f9139c18da1aaf00
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,199 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "BoolOp" "(" String "," Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Subscript" "(" Expr "," Index ")"
+
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  syntax Index ::= Expr
+                 | "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr | "NoBound"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  syntax Val ::= "intVal" "(" Int ")"
+               | "boolVal" "(" Bool ")"
+               | "listVal" "(" Vals ")"
+  syntax Vals ::= List{Val, ","}
+
+  syntax Def ::= "def" "(" Params "," Stmts ")"
+
+  syntax Map ::= collectDefs(Stmts) [function]
+  rule collectDefs(.Stmts) => .Map
+  rule collectDefs(FuncDef(F, P, B) REST)
+    => (F |-> def(P, B)) collectDefs(REST)
+
+  syntax Def ::= getDef(Map, String) [function]
+  rule getDef((F |-> D:Def) REST, F) => D
+
+  syntax Val ::= lookupEnv(Map, String) [function]
+  rule lookupEnv((X |-> V:Val) REST, X) => V
+
+  syntax Map ::= bind(Params, Vals) [function]
+  rule bind(Params(.Strings), .Vals) => .Map
+  rule bind(Params(X, XS), V, VS)
+    => (X |-> V) bind(Params(XS), VS)
+
+  syntax Int ::= valLength(Vals) [function]
+  rule valLength(.Vals) => 0
+  rule valLength(V, VS) => 1 +Int valLength(VS)
+
+  syntax Stmts ::= appendStmts(Stmts, Stmts) [function]
+  rule appendStmts(.Stmts, SS) => SS
+  rule appendStmts(S:Stmt REST, SS) => S appendStmts(REST, SS)
+
+  syntax Result ::= "noResult" | "result" "(" Val ")"
+  syntax KItem ::= "init" "(" Pgm "," Val ")"
+                 | "invokeProgram" "(" Pgm "," Val ")"
+                 | "invoke" "(" String "," Vals "," Map ")"
+                 | "invokeDef" "(" Def "," Vals "," Map ")"
+                 | "execStmts" "(" Stmts "," Map "," Map ")"
+                 | "eval" "(" Expr "," Map "," Map ")"
+                 | "evalArgs" "(" Exprs "," Map "," Map ")"
+                 | "argsDone" "(" Vals ")"
+                 | "returnIf" "(" Stmts "," Stmts "," Stmts "," Map "," Map ")"
+                 | "binLeft" "(" String "," Expr "," Map "," Map ")"
+                 | "binRight" "(" String "," Val ")"
+                 | "compareLeft" "(" String "," Expr "," Map "," Map ")"
+                 | "compareRight" "(" String "," Val ")"
+                 | "andLeft" "(" Expr "," Map "," Map ")"
+                 | "andRight" "(" Bool ")"
+                 | "argsRest" "(" Exprs "," Map "," Map ")"
+                 | "prependArg" "(" Val ")"
+                 | "callWith" "(" String "," Map ")"
+                 | "subscriptWith" "(" Index ")"
+                 | "finish"
+
+  configuration
+    <mpy>
+      <k> init($PGM:Pgm, $ARGS:Val) </k>
+      <result> noResult </result>
+    </mpy>
+
+  rule <k> init(P, A) => invokeProgram(P, A) ~> finish </k>
+  rule <k> invokeProgram(Module(SS), L:Val)
+          => invoke("skjkasdkd", L, collectDefs(SS))
+       </k>
+
+  rule <k> invoke(F, ARGS, DEFS)
+          => invokeDef(getDef(DEFS, F), ARGS, DEFS)
+       </k>
+  rule <k> invokeDef(def(PARAMS, BODY), ARGS, DEFS)
+          => execStmts(BODY, bind(PARAMS, ARGS), DEFS)
+       </k>
+
+  rule <k> execStmts(Return(E) REST, ENV, DEFS)
+          => eval(E, ENV, DEFS)
+       </k>
+  rule <k> execStmts(If(COND, THEN, ELSE) REST, ENV, DEFS)
+          => eval(COND, ENV, DEFS)
+             ~> returnIf(THEN, ELSE, REST, ENV, DEFS)
+       </k>
+  rule <k> boolVal(B) ~> returnIf(THEN, ELSE, REST, ENV, DEFS)
+          => execStmts(appendStmts(THEN, REST), ENV, DEFS)
+       </k>
+    requires B
+  rule <k> boolVal(B) ~> returnIf(THEN, ELSE, REST, ENV, DEFS)
+          => execStmts(appendStmts(ELSE, REST), ENV, DEFS)
+       </k>
+    requires notBool B
+
+  rule <k> eval(Int(I), ENV, DEFS) => intVal(I) </k>
+  rule <k> eval(Bool(B), ENV, DEFS) => boolVal(B) </k>
+  rule <k> eval(Name(X), ENV, DEFS) => lookupEnv(ENV, X) </k>
+
+  rule <k> eval(BinOp(OP, E1, E2), ENV, DEFS)
+          => eval(E1, ENV, DEFS) ~> binLeft(OP, E2, ENV, DEFS)
+       </k>
+  rule <k> V:Val ~> binLeft(OP, E2, ENV, DEFS)
+          => eval(E2, ENV, DEFS) ~> binRight(OP, V)
+       </k>
+  rule <k> intVal(J) ~> binRight("+", intVal(I)) => intVal(I +Int J) </k>
+  rule <k> intVal(J) ~> binRight("*", intVal(I)) => intVal(I *Int J) </k>
+  rule <k> intVal(J) ~> binRight("%", intVal(I)) => intVal(I %Int J) </k>
+    requires J =/=Int 0
+  rule <k> intVal(J) ~> binRight("//", intVal(I)) => intVal(I /Int J) </k>
+    requires J =/=Int 0
+
+  rule <k> eval(Compare(E1, CmpOp(OP, E2)), ENV, DEFS)
+          => eval(E1, ENV, DEFS) ~> compareLeft(OP, E2, ENV, DEFS)
+       </k>
+  rule <k> V:Val ~> compareLeft(OP, E2, ENV, DEFS)
+          => eval(E2, ENV, DEFS) ~> compareRight(OP, V)
+       </k>
+  rule <k> intVal(J) ~> compareRight("<", intVal(I))
+          => boolVal(I <Int J)
+       </k>
+  rule <k> intVal(J) ~> compareRight(">", intVal(I))
+          => boolVal(I >Int J)
+       </k>
+  rule <k> intVal(J) ~> compareRight("==", intVal(I))
+          => boolVal(I ==Int J)
+       </k>
+
+  rule <k> eval(BoolOp("and", E1, E2), ENV, DEFS)
+          => eval(E1, ENV, DEFS) ~> andLeft(E2, ENV, DEFS)
+       </k>
+  rule <k> boolVal(B1) ~> andLeft(E2, ENV, DEFS)
+          => eval(E2, ENV, DEFS) ~> andRight(B1)
+       </k>
+  rule <k> boolVal(B2) ~> andRight(B1) => boolVal(B1 andBool B2) </k>
+
+  rule <k> eval(Call(Name(F), ES), ENV, DEFS)
+          => evalArgs(ES, ENV, DEFS) ~> callWith(F, DEFS)
+       </k>
+  rule <k> evalArgs(.Exprs, ENV, DEFS) => argsDone(.Vals) </k>
+  rule <k> evalArgs(E, ES, ENV, DEFS)
+          => eval(E, ENV, DEFS) ~> argsRest(ES, ENV, DEFS)
+       </k>
+  rule <k> V:Val ~> argsRest(ES, ENV, DEFS)
+          => evalArgs(ES, ENV, DEFS) ~> prependArg(V)
+       </k>
+  rule <k> argsDone(VS) ~> prependArg(V) => argsDone(V, VS) </k>
+  rule <k> argsDone(listVal(VS)) ~> callWith("len", DEFS)
+          => intVal(valLength(VS))
+       </k>
+  rule <k> argsDone(VS) ~> callWith(F, DEFS) => invoke(F, VS, DEFS) </k>
+    requires F =/=String "len"
+
+  rule <k> eval(Subscript(E, INDEX), ENV, DEFS)
+          => eval(E, ENV, DEFS) ~> subscriptWith(INDEX)
+       </k>
+  rule <k> listVal(V, VS) ~> subscriptWith(Int(0)) => V </k>
+  rule <k> listVal(V, VS)
+            ~> subscriptWith(Slice(Int(1), NoBound, NoBound))
+          => listVal(VS)
+       </k>
+
+  rule <k> V:Val ~> finish => .K </k>
+       <result> noResult => result(V) </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..ed2615eb653f16068968721e5b8dbcf1160fd38f
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,34 @@
+def is_prime_from(n, divisor):
+    if divisor * divisor > n:
+        return True
+    if n % divisor == 0:
+        return False
+    return is_prime_from(n, divisor + 1)
+
+
+def is_prime(n):
+    if n < 2:
+        return False
+    return is_prime_from(n, 2)
+
+
+def choose_prime(n, best):
+    if is_prime(n) and n > best:
+        return n
+    return best
+
+
+def largest_prime(lst):
+    if len(lst) == 0:
+        return 0
+    return choose_prime(lst[0], largest_prime(lst[1:]))
+
+
+def digit_sum(n):
+    if n < 10:
+        return n
+    return n % 10 + digit_sum(n // 10)
+
+
+def skjkasdkd(lst):
+    return digit_sum(largest_prime(lst))
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..99af78682e390b401f61d2caf2b333e745dceff7
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,19 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim <mpy>
+          <k> apply(getDef(solutionDefs, "is_prime_from"),
+                    intVal(N), intVal(D), solutionDefs)
+            => boolVal(refPrimeFrom(N, D))
+          </k>
+          <result> R:Result </result>
+        </mpy>
+    requires N >=Int 2 andBool D >=Int 2
+
+  claim <mpy>
+          <k> init(solutionProgram, listVal(.Vals)) => .K </k>
+          <result> noResult => result(intVal(0)) </result>
+        </mpy>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d5b8661988ebd06bd5506a22509df83546a3d15b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,108 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // This macro is the exact AST emitted in solution.mpy.  Keeping it as a K
+  // term lets specifications reason about the translated program itself.
+  syntax Pgm ::= "solutionProgram" [macro]
+  rule solutionProgram =>
+    Module(
+      FuncDef("is_prime_from", Params("n", "divisor"),
+        If(Compare(BinOp("*", Name("divisor"), Name("divisor")),
+                   CmpOp(">", Name("n"))),
+          Return(Bool(true)), .Stmts)
+        If(Compare(BinOp("%", Name("n"), Name("divisor")),
+                   CmpOp("==", Int(0))),
+          Return(Bool(false)), .Stmts)
+        Return(Call(Name("is_prime_from"), Name("n"),
+                    BinOp("+", Name("divisor"), Int(1)))))
+      FuncDef("is_prime", Params("n"),
+        If(Compare(Name("n"), CmpOp("<", Int(2))),
+          Return(Bool(false)), .Stmts)
+        Return(Call(Name("is_prime_from"), Name("n"), Int(2))))
+      FuncDef("choose_prime", Params("n", "best"),
+        If(BoolOp("and",
+             Call(Name("is_prime"), Name("n")),
+             Compare(Name("n"), CmpOp(">", Name("best")))),
+          Return(Name("n")), .Stmts)
+        Return(Name("best")))
+      FuncDef("largest_prime", Params("lst"),
+        If(Compare(Call(Name("len"), Name("lst")), CmpOp("==", Int(0))),
+          Return(Int(0)), .Stmts)
+        Return(Call(Name("choose_prime"),
+          Subscript(Name("lst"), Int(0)),
+          Call(Name("largest_prime"),
+            Subscript(Name("lst"), Slice(Int(1), NoBound, NoBound))))))
+      FuncDef("digit_sum", Params("n"),
+        If(Compare(Name("n"), CmpOp("<", Int(10))),
+          Return(Name("n")), .Stmts)
+        Return(BinOp("+", BinOp("%", Name("n"), Int(10)),
+          Call(Name("digit_sum"), BinOp("//", Name("n"), Int(10))))))
+      FuncDef("skjkasdkd", Params("lst"),
+        Return(Call(Name("digit_sum"),
+                    Call(Name("largest_prime"), Name("lst"))))))
+
+  syntax Map ::= "solutionDefs" [macro]
+  rule solutionDefs => collectDefs(
+      FuncDef("is_prime_from", Params("n", "divisor"),
+        If(Compare(BinOp("*", Name("divisor"), Name("divisor")),
+                   CmpOp(">", Name("n"))),
+          Return(Bool(true)), .Stmts)
+        If(Compare(BinOp("%", Name("n"), Name("divisor")),
+                   CmpOp("==", Int(0))),
+          Return(Bool(false)), .Stmts)
+        Return(Call(Name("is_prime_from"), Name("n"),
+                    BinOp("+", Name("divisor"), Int(1)))))
+      FuncDef("is_prime", Params("n"),
+        If(Compare(Name("n"), CmpOp("<", Int(2))),
+          Return(Bool(false)), .Stmts)
+        Return(Call(Name("is_prime_from"), Name("n"), Int(2))))
+      FuncDef("choose_prime", Params("n", "best"),
+        If(BoolOp("and", Call(Name("is_prime"), Name("n")),
+             Compare(Name("n"), CmpOp(">", Name("best")))),
+          Return(Name("n")), .Stmts)
+        Return(Name("best")))
+      FuncDef("largest_prime", Params("lst"),
+        If(Compare(Call(Name("len"), Name("lst")), CmpOp("==", Int(0))),
+          Return(Int(0)), .Stmts)
+        Return(Call(Name("choose_prime"),
+          Subscript(Name("lst"), Int(0)),
+          Call(Name("largest_prime"),
+            Subscript(Name("lst"), Slice(Int(1), NoBound, NoBound))))))
+      FuncDef("digit_sum", Params("n"),
+        If(Compare(Name("n"), CmpOp("<", Int(10))),
+          Return(Name("n")), .Stmts)
+        Return(BinOp("+", BinOp("%", Name("n"), Int(10)),
+          Call(Name("digit_sum"), BinOp("//", Name("n"), Int(10))))))
+      FuncDef("skjkasdkd", Params("lst"),
+        Return(Call(Name("digit_sum"),
+                    Call(Name("largest_prime"), Name("lst"))))))
+
+  // Independent mathematical reference functions.
+  syntax Bool ::= refPrimeFrom(Int, Int) [function]
+                | refPrime(Int) [function]
+  rule refPrimeFrom(N, D) => true
+    requires D *Int D >Int N
+  rule refPrimeFrom(N, D) => false
+    requires D *Int D <=Int N andBool N %Int D ==Int 0
+  rule refPrimeFrom(N, D) => refPrimeFrom(N, D +Int 1)
+    requires D *Int D <=Int N andBool N %Int D =/=Int 0
+  rule refPrime(N) => false requires N <Int 2
+  rule refPrime(N) => refPrimeFrom(N, 2) requires N >=Int 2
+
+  syntax Int ::= refChoose(Int, Int) [function]
+               | refLargest(Vals) [function]
+               | refDigitSum(Int) [function]
+               | refAnswer(Vals) [function]
+  rule refChoose(N, BEST) => N
+    requires refPrime(N) andBool N >Int BEST
+  rule refChoose(N, BEST) => BEST
+    requires notBool (refPrime(N) andBool N >Int BEST)
+  rule refLargest(.Vals) => 0
+  rule refLargest(intVal(N), REST) => refChoose(N, refLargest(REST))
+  rule refDigitSum(N) => N requires 0 <=Int N andBool N <Int 10
+  rule refDigitSum(N) => N %Int 10 +Int refDigitSum(N /Int 10)
+    requires N >=Int 10
+  rule refAnswer(VS) => refDigitSum(refLargest(VS))
+endmodule

exec
/bin/bash -lc 'kompile semantic.k --backend haskell --syntax-module MPY-SYNTAX --main-module SEMANTIC' in /work
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..4b54af5bb8e8450cf05d0ff2f9139c18da1aaf00
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,199 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "BoolOp" "(" String "," Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Subscript" "(" Expr "," Index ")"
+
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  syntax Index ::= Expr
+                 | "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr | "NoBound"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  syntax Val ::= "intVal" "(" Int ")"
+               | "boolVal" "(" Bool ")"
+               | "listVal" "(" Vals ")"
+  syntax Vals ::= List{Val, ","}
+
+  syntax Def ::= "def" "(" Params "," Stmts ")"
+
+  syntax Map ::= collectDefs(Stmts) [function]
+  rule collectDefs(.Stmts) => .Map
+  rule collectDefs(FuncDef(F, P, B) REST)
+    => (F |-> def(P, B)) collectDefs(REST)
+
+  syntax Def ::= getDef(Map, String) [function]
+  rule getDef((F |-> D:Def) REST, F) => D
+
+  syntax Val ::= lookupEnv(Map, String) [function]
+  rule lookupEnv((X |-> V:Val) REST, X) => V
+
+  syntax Map ::= bind(Params, Vals) [function]
+  rule bind(Params(.Strings), .Vals) => .Map
+  rule bind(Params(X, XS), V, VS)
+    => (X |-> V) bind(Params(XS), VS)
+
+  syntax Int ::= valLength(Vals) [function]
+  rule valLength(.Vals) => 0
+  rule valLength(V, VS) => 1 +Int valLength(VS)
+
+  syntax Stmts ::= appendStmts(Stmts, Stmts) [function]
+  rule appendStmts(.Stmts, SS) => SS
+  rule appendStmts(S:Stmt REST, SS) => S appendStmts(REST, SS)
+
+  syntax Result ::= "noResult" | "result" "(" Val ")"
+  syntax KItem ::= "init" "(" Pgm "," Val ")"
+                 | "invokeProgram" "(" Pgm "," Val ")"
+                 | "invoke" "(" String "," Vals "," Map ")"
+                 | "invokeDef" "(" Def "," Vals "," Map ")"
+                 | "execStmts" "(" Stmts "," Map "," Map ")"
+                 | "eval" "(" Expr "," Map "," Map ")"
+                 | "evalArgs" "(" Exprs "," Map "," Map ")"
+                 | "argsDone" "(" Vals ")"
+                 | "returnIf" "(" Stmts "," Stmts "," Stmts "," Map "," Map ")"
+                 | "binLeft" "(" String "," Expr "," Map "," Map ")"
+                 | "binRight" "(" String "," Val ")"
+                 | "compareLeft" "(" String "," Expr "," Map "," Map ")"
+                 | "compareRight" "(" String "," Val ")"
+                 | "andLeft" "(" Expr "," Map "," Map ")"
+                 | "andRight" "(" Bool ")"
+                 | "argsRest" "(" Exprs "," Map "," Map ")"
+                 | "prependArg" "(" Val ")"
+                 | "callWith" "(" String "," Map ")"
+                 | "subscriptWith" "(" Index ")"
+                 | "finish"
+
+  configuration
+    <mpy>
+      <k> init($PGM:Pgm, $ARGS:Val) </k>
+      <result> noResult </result>
+    </mpy>
+
+  rule <k> init(P, A) => invokeProgram(P, A) ~> finish </k>
+  rule <k> invokeProgram(Module(SS), L:Val)
+          => invoke("skjkasdkd", L, collectDefs(SS))
+       </k>
+
+  rule <k> invoke(F, ARGS, DEFS)
+          => invokeDef(getDef(DEFS, F), ARGS, DEFS)
+       </k>
+  rule <k> invokeDef(def(PARAMS, BODY), ARGS, DEFS)
+          => execStmts(BODY, bind(PARAMS, ARGS), DEFS)
+       </k>
+
+  rule <k> execStmts(Return(E) REST, ENV, DEFS)
+          => eval(E, ENV, DEFS)
+       </k>
+  rule <k> execStmts(If(COND, THEN, ELSE) REST, ENV, DEFS)
+          => eval(COND, ENV, DEFS)
+             ~> returnIf(THEN, ELSE, REST, ENV, DEFS)
+       </k>
+  rule <k> boolVal(B) ~> returnIf(THEN, ELSE, REST, ENV, DEFS)
+          => execStmts(appendStmts(THEN, REST), ENV, DEFS)
+       </k>
+    requires B
+  rule <k> boolVal(B) ~> returnIf(THEN, ELSE, REST, ENV, DEFS)
+          => execStmts(appendStmts(ELSE, REST), ENV, DEFS)
+       </k>
+    requires notBool B
+
+  rule <k> eval(Int(I), ENV, DEFS) => intVal(I) </k>
+  rule <k> eval(Bool(B), ENV, DEFS) => boolVal(B) </k>
+  rule <k> eval(Name(X), ENV, DEFS) => lookupEnv(ENV, X) </k>
+
+  rule <k> eval(BinOp(OP, E1, E2), ENV, DEFS)
+          => eval(E1, ENV, DEFS) ~> binLeft(OP, E2, ENV, DEFS)
+       </k>
+  rule <k> V:Val ~> binLeft(OP, E2, ENV, DEFS)
+          => eval(E2, ENV, DEFS) ~> binRight(OP, V)
+       </k>
+  rule <k> intVal(J) ~> binRight("+", intVal(I)) => intVal(I +Int J) </k>
+  rule <k> intVal(J) ~> binRight("*", intVal(I)) => intVal(I *Int J) </k>
+  rule <k> intVal(J) ~> binRight("%", intVal(I)) => intVal(I %Int J) </k>
+    requires J =/=Int 0
+  rule <k> intVal(J) ~> binRight("//", intVal(I)) => intVal(I /Int J) </k>
+    requires J =/=Int 0
+
+  rule <k> eval(Compare(E1, CmpOp(OP, E2)), ENV, DEFS)
+          => eval(E1, ENV, DEFS) ~> compareLeft(OP, E2, ENV, DEFS)
+       </k>
+  rule <k> V:Val ~> compareLeft(OP, E2, ENV, DEFS)
+          => eval(E2, ENV, DEFS) ~> compareRight(OP, V)
+       </k>
+  rule <k> intVal(J) ~> compareRight("<", intVal(I))
+          => boolVal(I <Int J)
+       </k>
+  rule <k> intVal(J) ~> compareRight(">", intVal(I))
+          => boolVal(I >Int J)
+       </k>
+  rule <k> intVal(J) ~> compareRight("==", intVal(I))
+          => boolVal(I ==Int J)
+       </k>
+
+  rule <k> eval(BoolOp("and", E1, E2), ENV, DEFS)
+          => eval(E1, ENV, DEFS) ~> andLeft(E2, ENV, DEFS)
+       </k>
+  rule <k> boolVal(B1) ~> andLeft(E2, ENV, DEFS)
+          => eval(E2, ENV, DEFS) ~> andRight(B1)
+       </k>
+  rule <k> boolVal(B2) ~> andRight(B1) => boolVal(B1 andBool B2) </k>
+
+  rule <k> eval(Call(Name(F), ES), ENV, DEFS)
+          => evalArgs(ES, ENV, DEFS) ~> callWith(F, DEFS)
+       </k>
+  rule <k> evalArgs(.Exprs, ENV, DEFS) => argsDone(.Vals) </k>
+  rule <k> evalArgs(E, ES, ENV, DEFS)
+          => eval(E, ENV, DEFS) ~> argsRest(ES, ENV, DEFS)
+       </k>
+  rule <k> V:Val ~> argsRest(ES, ENV, DEFS)
+          => evalArgs(ES, ENV, DEFS) ~> prependArg(V)
+       </k>
+  rule <k> argsDone(VS) ~> prependArg(V) => argsDone(V, VS) </k>
+  rule <k> argsDone(listVal(VS)) ~> callWith("len", DEFS)
+          => intVal(valLength(VS))
+       </k>
+  rule <k> argsDone(VS) ~> callWith(F, DEFS) => invoke(F, VS, DEFS) </k>
+    requires F =/=String "len"
+
+  rule <k> eval(Subscript(E, INDEX), ENV, DEFS)
+          => eval(E, ENV, DEFS) ~> subscriptWith(INDEX)
+       </k>
+  rule <k> listVal(V, VS) ~> subscriptWith(Int(0)) => V </k>
+  rule <k> listVal(V, VS)
+            ~> subscriptWith(Slice(Int(1), NoBound, NoBound))
+          => listVal(VS)
+       </k>
+
+  rule <k> V:Val ~> finish => .K </k>
+       <result> noResult => result(V) </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..ed2615eb653f16068968721e5b8dbcf1160fd38f
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,34 @@
+def is_prime_from(n, divisor):
+    if divisor * divisor > n:
+        return True
+    if n % divisor == 0:
+        return False
+    return is_prime_from(n, divisor + 1)
+
+
+def is_prime(n):
+    if n < 2:
+        return False
+    return is_prime_from(n, 2)
+
+
+def choose_prime(n, best):
+    if is_prime(n) and n > best:
+        return n
+    return best
+
+
+def largest_prime(lst):
+    if len(lst) == 0:
+        return 0
+    return choose_prime(lst[0], largest_prime(lst[1:]))
+
+
+def digit_sum(n):
+    if n < 10:
+        return n
+    return n % 10 + digit_sum(n // 10)
+
+
+def skjkasdkd(lst):
+    return digit_sum(largest_prime(lst))
