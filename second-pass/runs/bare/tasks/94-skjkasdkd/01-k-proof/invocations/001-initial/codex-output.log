diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..3e0e9fe1e1eab330aab76f9042a9bcc1f165deff
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,153 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "BoolOp" "(" String "," Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Subscript" "(" Expr "," Index ")"
+
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  syntax Index ::= Expr
+                 | "Slice" "(" Bound "," Bound "," Bound ")"
+  syntax Bound ::= Expr | "NoBound"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  syntax Val ::= "intVal" "(" Int ")"
+               | "boolVal" "(" Bool ")"
+               | "listVal" "(" Vals ")"
+  syntax Vals ::= List{Val, ","}
+
+  syntax Def ::= "def" "(" Params "," Stmts ")"
+
+  syntax Map ::= collectDefs(Stmts) [function]
+  rule collectDefs(.Stmts) => .Map
+  rule collectDefs(FuncDef(F, P, B) REST)
+    => (F |-> def(P, B)) collectDefs(REST)
+
+  syntax Def ::= getDef(Map, String) [function]
+  rule getDef((F |-> D:Def) REST, F) => D
+
+  syntax Val ::= lookupEnv(Map, String) [function]
+  rule lookupEnv((X |-> V:Val) REST, X) => V
+
+  syntax Map ::= bind(Params, Vals) [function]
+  rule bind(Params(.Strings), .Vals) => .Map
+  rule bind(Params(X, XS), V, VS)
+    => (X |-> V) bind(Params(XS), VS)
+
+  syntax Int ::= valLength(Vals) [function]
+  rule valLength(.Vals) => 0
+  rule valLength(V, VS) => 1 +Int valLength(VS)
+
+  syntax Vals ::= evalExprs(Exprs, Map, Map) [function]
+  rule evalExprs(.Exprs, ENV, DEFS) => .Vals
+  rule evalExprs(E, ES, ENV, DEFS)
+    => evalExpr(E, ENV, DEFS), evalExprs(ES, ENV, DEFS)
+
+  syntax Val ::= evalExpr(Expr, Map, Map) [function]
+               | evalBin(String, Val, Val) [function]
+               | evalCompare(String, Val, Val) [function]
+               | andVal(Val, Val) [function]
+               | lenVal(Val) [function]
+               | firstVal(Val) [function]
+               | tailVal(Val) [function]
+
+  rule evalExpr(Int(I), ENV, DEFS) => intVal(I)
+  rule evalExpr(Bool(B), ENV, DEFS) => boolVal(B)
+  rule evalExpr(Name(X), ENV, DEFS) => lookupEnv(ENV, X)
+  rule evalExpr(BinOp(OP, E1, E2), ENV, DEFS)
+    => evalBin(OP, evalExpr(E1, ENV, DEFS), evalExpr(E2, ENV, DEFS))
+  rule evalExpr(Compare(E, CmpOp(OP, E2)), ENV, DEFS)
+    => evalCompare(OP, evalExpr(E, ENV, DEFS), evalExpr(E2, ENV, DEFS))
+  rule evalExpr(BoolOp("and", E1, E2), ENV, DEFS)
+    => andVal(evalExpr(E1, ENV, DEFS), evalExpr(E2, ENV, DEFS))
+  rule evalExpr(Call(Name("len"), E), ENV, DEFS)
+    => lenVal(evalExpr(E, ENV, DEFS))
+  rule evalExpr(Call(Name(F), ES), ENV, DEFS)
+    => apply(getDef(DEFS, F), evalExprs(ES, ENV, DEFS), DEFS)
+    requires F =/=String "len"
+  rule evalExpr(Subscript(E, Int(0)), ENV, DEFS)
+    => firstVal(evalExpr(E, ENV, DEFS))
+  rule evalExpr(Subscript(E, Slice(Int(1), NoBound, NoBound)), ENV, DEFS)
+    => tailVal(evalExpr(E, ENV, DEFS))
+
+  rule evalBin("+", intVal(I), intVal(J)) => intVal(I +Int J)
+  rule evalBin("*", intVal(I), intVal(J)) => intVal(I *Int J)
+  rule evalBin("%", intVal(I), intVal(J)) => intVal(I %Int J)
+    requires J =/=Int 0
+  rule evalBin("//", intVal(I), intVal(J)) => intVal(I /Int J)
+    requires J =/=Int 0
+
+  rule evalCompare("<", intVal(I), intVal(J)) => boolVal(I <Int J)
+  rule evalCompare(">", intVal(I), intVal(J)) => boolVal(I >Int J)
+  rule evalCompare("==", intVal(I), intVal(J)) => boolVal(I ==Int J)
+
+  rule andVal(boolVal(B1), boolVal(B2)) => boolVal(B1 andBool B2)
+  rule lenVal(listVal(VS)) => intVal(valLength(VS))
+  rule firstVal(listVal(V, VS)) => V
+  rule tailVal(listVal(V, VS)) => listVal(VS)
+
+  syntax Stmts ::= appendStmts(Stmts, Stmts) [function]
+  rule appendStmts(.Stmts, SS) => SS
+  rule appendStmts(S:Stmt REST, SS) => S appendStmts(REST, SS)
+
+  syntax Val ::= evalStmts(Stmts, Map, Map) [function]
+               | evalIf(Val, Stmts, Stmts, Stmts, Map, Map) [function]
+               | apply(Def, Vals, Map) [function]
+
+  rule evalStmts(Return(E) REST, ENV, DEFS) => evalExpr(E, ENV, DEFS)
+  rule evalStmts(If(COND, THEN, ELSE) REST, ENV, DEFS)
+    => evalIf(evalExpr(COND, ENV, DEFS), THEN, ELSE, REST, ENV, DEFS)
+  rule evalIf(boolVal(true), THEN, ELSE, REST, ENV, DEFS)
+    => evalStmts(appendStmts(THEN, REST), ENV, DEFS)
+  rule evalIf(boolVal(false), THEN, ELSE, REST, ENV, DEFS)
+    => evalStmts(appendStmts(ELSE, REST), ENV, DEFS)
+  rule apply(def(PARAMS, BODY), ARGS, DEFS)
+    => evalStmts(BODY, bind(PARAMS, ARGS), DEFS)
+
+  syntax Val ::= execute(Pgm, Val) [function]
+               | executeWith(Map, Val) [function]
+  rule execute(Module(SS), L:Val) => executeWith(collectDefs(SS), L)
+  rule executeWith(DEFS, L:Val)
+    => apply(getDef(DEFS, "skjkasdkd"), L, DEFS)
+
+  syntax Result ::= "noResult" | "result" "(" Val ")"
+  syntax KItem ::= "init" "(" Pgm "," Val ")"
+
+  configuration
+    <mpy>
+      <k> init($PGM:Pgm, $ARGS:Val) </k>
+      <result> noResult </result>
+    </mpy>
+
+  rule <k> init(P, A) => .K </k>
+       <result> noResult => result(execute(P, A)) </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..ed2615eb653f16068968721e5b8dbcf1160fd38f
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,34 @@
+def is_prime_from(n, divisor):
+    if divisor * divisor > n:
+        return True
+    if n % divisor == 0:
+        return False
+    return is_prime_from(n, divisor + 1)
+
+
+def is_prime(n):
+    if n < 2:
+        return False
+    return is_prime_from(n, 2)
+
+
+def choose_prime(n, best):
+    if is_prime(n) and n > best:
+        return n
+    return best
+
+
+def largest_prime(lst):
+    if len(lst) == 0:
+        return 0
+    return choose_prime(lst[0], largest_prime(lst[1:]))
+
+
+def digit_sum(n):
+    if n < 10:
+        return n
+    return n % 10 + digit_sum(n // 10)
+
+
+def skjkasdkd(lst):
+    return digit_sum(largest_prime(lst))
