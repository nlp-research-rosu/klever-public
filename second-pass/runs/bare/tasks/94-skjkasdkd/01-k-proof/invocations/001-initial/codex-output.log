      "is_prime_from" |-> def ( Params ( "n" , "divisor" , .Strings ) , If ( Compare ( BinOp ( "*" , Name ( "divisor" ) , Name ( "divisor" ) ) , CmpOp ( ">" , Name ( "n" ) ) , .CmpOps ) , Return ( Bool ( true ) )  .Stmts , .Stmts )  If ( Compare ( BinOp ( "%" , Name ( "n" ) , Name ( "divisor" ) ) , CmpOp ( "==" , Int ( 0 ) ) , .CmpOps ) , Return ( Bool ( false ) )  .Stmts , .Stmts )  Return ( Call ( Name ( "is_prime_from" ) , Name ( "n" ) , BinOp ( "+" , Name ( "divisor" ) , Int ( 1 ) ) , .Exprs ) )  .Stmts )
      "largest_prime" |-> def ( Params ( "lst" , .Strings ) , If ( Compare ( Call ( Name ( "len" ) , Name ( "lst" ) , .Exprs ) , CmpOp ( "==" , Int ( 0 ) ) , .CmpOps ) , Return ( Int ( 0 ) )  .Stmts , .Stmts )  Return ( Call ( Name ( "choose_prime" ) , Subscript ( Name ( "lst" ) , Int ( 0 ) ) , Call ( Name ( "largest_prime" ) , Subscript ( Name ( "lst" ) , Slice ( Int ( 1 ) , NoBound , NoBound ) ) , .Exprs ) , .Exprs ) )  .Stmts )
      "skjkasdkd" |-> def ( Params ( "lst" , .Strings ) , Return ( Call ( Name ( "digit_sum" ) , Call ( Name ( "largest_prime" ) , Name ( "lst" ) , .Exprs ) , .Exprs ) )  .Stmts ) ) ~> .K
    </k>
    <result>
      R
    </result>
  </mpy>
#And
  {
    true
  #Equals
    D >=Int 2
  }
#And
  {
    true
  #Equals
    N >=Int 2
  }
