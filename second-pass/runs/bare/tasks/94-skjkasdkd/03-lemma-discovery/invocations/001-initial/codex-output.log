+      "classification": "DEFINITION",
+      "rationale": "Macro expansion defining the named solutionProgram proof term as the translated Python AST."
+    },
+    {
+      "source_rule_id": "rule-704cd178acd1d0daf598ad83654fbee69c44452e692b568b882dfe2a10c53989",
+      "classification": "DEFINITION",
+      "rationale": "Structural helper defining how programDefs extracts the function-definition map from a Module term."
+    },
+    {
+      "source_rule_id": "rule-9a543f2f9c2e87713097e1b67709c4d8e5fc1756c4b334ac22c01a263ac91bb0",
+      "classification": "DEFINITION",
+      "rationale": "Macro expansion defining the named solutionDefs proof term from solutionProgram."
+    },
+    {
+      "source_rule_id": "rule-394121d7cc3a18641aae8c3c2b178633128c3ee6019701c2e7a07932a811afb1",
+      "classification": "DEFINITION",
+      "rationale": "Base equation defining refPrimeFrom to succeed once the candidate divisor squared exceeds the number."
+    },
+    {
+      "source_rule_id": "rule-e01d0e256aaa8dfb3da3d98d391f0c25af27bc17a67437f49d0303660cd0d59c",
+      "classification": "DEFINITION",
+      "rationale": "Divisibility case defining refPrimeFrom to fail when the current candidate divides the number."
+    },
+    {
+      "source_rule_id": "rule-d288ef34bdb9f0de1657e5d386a68d77e699274deddb393621cc587e2900b384",
+      "classification": "DEFINITION",
+      "rationale": "Recursive equation defining refPrimeFrom by advancing to the next candidate divisor."
+    },
+    {
+      "source_rule_id": "rule-a51bde87448e8823370051215662eb8573abe7d460b96b1afe8412c4775dbbde",
+      "classification": "DEFINITION",
+      "rationale": "Base case defining refPrime as false for integers below two."
+    },
+    {
+      "source_rule_id": "rule-f1e74ed430dbdf89b860ca2041473cb06f32bb48e7844a391e8175d060195f97",
+      "classification": "DEFINITION",
+      "rationale": "Recursive-entry equation defining refPrime for integers at least two via refPrimeFrom."
+    },
+    {
+      "source_rule_id": "rule-8a3942d93ffe3f6e6ae64e458c8023039123bed8d78c007b36a907d1e58d565e",
+      "classification": "DEFINITION",
+      "rationale": "Selection equation defining refChoose to return a new prime candidate when it exceeds the prior best."
+    },
+    {
+      "source_rule_id": "rule-51a73d2d8110af583d2989b251007ffdbad511c057f4e812e54454d82f8429e1",
+      "classification": "DEFINITION",
+      "rationale": "Complementary selection equation defining refChoose to retain the prior best."
+    },
+    {
+      "source_rule_id": "rule-28f8219a7987ad2a92a1d0d476c319c8fc11bd797029e4afb7d1297baecfd018",
+      "classification": "DEFINITION",
+      "rationale": "Empty-list case defining refLargest to return zero."
+    },
+    {
+      "source_rule_id": "rule-36b7e111ab7333a035ed365f6c2a53d6d8752c41102377f447ba5d09a226c4c4",
+      "classification": "DEFINITION",
+      "rationale": "Recursive equation defining refLargest from the integer head, recursively summarized tail, and refChoose."
+    },
+    {
+      "source_rule_id": "rule-779830a1bfd2053dc0ff372a35e84cade7948d1cc520a03106a0d486c77332a7",
+      "classification": "DEFINITION",
+      "rationale": "Single-digit base case defining refDigitSum."
+    },
+    {
+      "source_rule_id": "rule-96796d5d1e4aab5093cb056357a6e6cf9e557a6232dc0bb0cea26bb32c43825e",
+      "classification": "DEFINITION",
+      "rationale": "Recursive decimal recurrence defining refDigitSum from the last digit and remaining prefix."
+    },
+    {
+      "source_rule_id": "rule-dc021017f587aacb2ee617e1f00f0d765debc901f4ce1669255035763be2f11b",
+      "classification": "DEFINITION",
+      "rationale": "Top-level equation defining refAnswer as the digit sum of refLargest."
+    }
+  ]
+}

