COMMAND: bash -lc for\ p\ in\ /candidate/semantic.k\ /candidate/verification.k\ /candidate/spec.k\;\ do\ printf\ \"FILE\ %s\\n\"\ \"\$p\"\;\ rg\ -n\ \"\^\[\[:space:\]\]\*\(module\|imports\|syntax\|configuration\|rule\|claim\)\(\[\[:space:\]\]\|\$\)\"\ \"\$p\"\;\ done
FILE /candidate/semantic.k
3:module MPY-SYNTAX
4:  imports INT-SYNTAX
5:  imports BOOL-SYNTAX
6:  imports STRING-SYNTAX
8:  syntax Pgm ::= "Module" "(" Stmts ")"
10:  syntax Stmts ::= List{Stmt, ""}
11:  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
15:  syntax Params ::= "Params" "(" Strings ")"
16:  syntax Strings ::= List{String, ","}
18:  syntax Exprs ::= List{Expr, ","}
19:  syntax Expr ::= "Int" "(" Int ")"
28:  syntax CmpOps ::= List{CmpOp, ","}
29:  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
31:  syntax Index ::= Expr
33:  syntax Bound ::= Expr | "NoBound"
36:module SEMANTIC
37:  imports MPY-SYNTAX
38:  imports INT
39:  imports BOOL
40:  imports STRING
41:  imports MAP
43:  syntax Val ::= "intVal" "(" Int ")"
46:  syntax Vals ::= List{Val, ","}
48:  syntax Def ::= "def" "(" Params "," Stmts ")"
50:  syntax Map ::= collectDefs(Stmts) [function]
51:  rule collectDefs(.Stmts) => .Map
52:  rule collectDefs(FuncDef(F, P, B) REST)
55:  syntax Def ::= getDef(Map, String) [function]
56:  rule getDef((F |-> D:Def) _REST, F) => D
58:  syntax Val ::= lookupEnv(Map, String) [function]
59:  rule lookupEnv((X |-> V:Val) _REST, X) => V
61:  syntax Map ::= bind(Params, Vals) [function]
62:  rule bind(Params(.Strings), .Vals) => .Map
63:  rule bind(Params(X, XS), V, VS)
66:  syntax Int ::= valLength(Vals) [function]
68:  syntax Vals ::= intTail(Vals) [function]
69:  rule valLength(.Vals) => 0
70:  rule valLength(_V, VS) => 1 +Int valLength(VS)
71:  rule intHead(intVal(N), _VS) => N
72:  rule intTail(intVal(_N), VS) => VS
74:  syntax Stmts ::= appendStmts(Stmts, Stmts) [function]
75:  rule appendStmts(.Stmts, SS) => SS
76:  rule appendStmts(S:Stmt REST, SS) => S appendStmts(REST, SS)
78:  syntax Result ::= "noResult" | "result" "(" Val ")"
79:  syntax KItem ::= "init" "(" Pgm "," Val ")"
100:  configuration
106:  rule <k> init(P, A) => invokeProgram(P, A) ~> finish ... </k>
107:  rule <k> invokeProgram(Module(SS), L:Val)
111:  rule <k> invoke(F, ARGS, DEFS)
114:  rule <k> invokeDef(def(PARAMS, BODY), ARGS, DEFS)
118:  rule <k> execStmts(Return(E) _REST, ENV, DEFS)
121:  rule <k> execStmts(If(COND, THEN, ELSE) REST, ENV, DEFS)
125:  rule <k> boolVal(B) ~> returnIf(THEN, _ELSE, REST, ENV, DEFS)
129:  rule <k> boolVal(B) ~> returnIf(_THEN, ELSE, REST, ENV, DEFS)
134:  rule <k> eval(Int(I), _ENV, _DEFS) => intVal(I) ... </k>
135:  rule <k> eval(Bool(B), _ENV, _DEFS) => boolVal(B) ... </k>
136:  rule <k> eval(Name(X), ENV, _DEFS) => lookupEnv(ENV, X) ... </k>
138:  rule <k> eval(BinOp(OP, E1, E2), ENV, DEFS)
141:  rule <k> V:Val ~> binLeft(OP, E2, ENV, DEFS)
144:  rule <k> intVal(J) ~> binRight("+", intVal(I)) => intVal(I +Int J) ... </k>
145:  rule <k> intVal(J) ~> binRight("*", intVal(I)) => intVal(I *Int J) ... </k>
146:  rule <k> intVal(J) ~> binRight("%", intVal(I)) => intVal(I %Int J) ... </k>
148:  rule <k> intVal(J) ~> binRight("//", intVal(I)) => intVal(I /Int J) ... </k>
151:  rule <k> eval(Compare(E1, CmpOp(OP, E2)), ENV, DEFS)
154:  rule <k> V:Val ~> compareLeft(OP, E2, ENV, DEFS)
157:  rule <k> intVal(J) ~> compareRight("<", intVal(I))
160:  rule <k> intVal(J) ~> compareRight(">", intVal(I))
163:  rule <k> intVal(J) ~> compareRight("==", intVal(I))
167:  rule <k> eval(BoolOp("and", E1, E2), ENV, DEFS)
170:  rule <k> boolVal(B1) ~> andLeft(E2, ENV, DEFS)
173:  rule <k> boolVal(B2) ~> andRight(B1) => boolVal(B1 andBool B2) ... </k>
175:  rule <k> eval(Call(Name(F), ES), ENV, DEFS)
178:  rule <k> evalArgs(.Exprs, _ENV, _DEFS) => argsDone(.Vals) ... </k>
179:  rule <k> evalArgs(E, ES, ENV, DEFS)
182:  rule <k> V:Val ~> argsRest(ES, ENV, DEFS)
185:  rule <k> argsDone(VS) ~> prependArg(V) => argsDone(V, VS) ... </k>
186:  rule <k> argsDone(listVal(VS)) ~> callWith("len", _DEFS)
189:  rule <k> argsDone(VS) ~> callWith(F, DEFS) => invoke(F, VS, DEFS) ... </k>
192:  rule <k> eval(Subscript(E, INDEX), ENV, DEFS)
195:  rule <k> listVal(VS) ~> subscriptWith(Int(0))
199:  rule <k> listVal(VS)
205:  rule <k> V:Val ~> finish => .K ... </k>
FILE /candidate/verification.k
3:module VERIFICATION
4:  imports SEMANTIC
8:  syntax Pgm ::= "solutionProgram" [macro]
9:  rule solutionProgram =>
46:  syntax Map ::= programDefs(Pgm) [function]
48:  rule programDefs(Module(SS)) => collectDefs(SS)
49:  rule solutionDefs => programDefs(solutionProgram)
52:  syntax Bool ::= refPrimeFrom(Int, Int) [function, total]
54:  rule refPrimeFrom(N, D) => true
56:  rule refPrimeFrom(N, D) => false
58:  rule refPrimeFrom(N, D) => refPrimeFrom(N, D +Int 1)
60:  rule refPrime(N) => false requires N <Int 2
61:  rule refPrime(N) => refPrimeFrom(N, 2) requires N >=Int 2
63:  syntax Int ::= refChoose(Int, Int) [function]
67:  rule refChoose(N, BEST) => N
69:  rule refChoose(N, BEST) => BEST
71:  rule refLargest(VS) => 0
73:  rule refLargest(VS) => refChoose(intHead(VS), refLargest(intTail(VS)))
75:  rule refDigitSum(N) => N requires N <Int 10
76:  rule refDigitSum(N) => N %Int 10 +Int refDigitSum(N /Int 10)
78:  rule refAnswer(VS) => refDigitSum(refLargest(VS))
