+    "campaign_lock_recorded_match="
+    + str(
+        sha256(lock_path)
+        == audit_input["hashes"]["audit_campaign_lock_sha256"]
+    )
+)
+print(
+    "campaign_block_exact_match="
+    + str(campaign_lock == audit_input["audit_campaign"])
+)
+
+declared_paths = {
