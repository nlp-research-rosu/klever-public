+print(f"campaign_lock_sha256={sha256(lock_path)}")
+print(
+    "campaign_lock_recorded_match="
+    + str(
+        sha256(lock_path)
+        == audit_input["hashes"]["audit_campaign_lock_sha256"]
+    )
