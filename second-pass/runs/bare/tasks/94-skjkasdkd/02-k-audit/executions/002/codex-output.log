+  'listVal(intVal(0), intVal(8), intVal(1), intVal(2), intVal(1), intVal(7))' || exit $?
+run_case multi_digit_prime '[181, 32, 109]' \
+  'listVal(intVal(181), intVal(32), intVal(109))' || exit $?
+run_case larger_prime '[104729]' \
