+    symlink = path.is_symlink()
+    mode = stat.filemode(path.lstat().st_mode) if present else "MISSING"
+    ok = present and readable and not symlink
+    required_ok &= ok
+    print(
+        f"required path={path} present={present} readable={readable} "
