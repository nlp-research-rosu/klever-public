     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // This macro is the exact AST emitted in solution.mpy.  Keeping it as a K
     7	  // term lets specifications reason about the translated program itself.
     8	  syntax Pgm ::= "solutionProgram" [macro]
     9	  rule solutionProgram =>
    10	    Module(
    11	      FuncDef("is_prime_from", Params("n", "divisor"),
    12	        If(Compare(BinOp("*", Name("divisor"), Name("divisor")),
    13	                   CmpOp(">", Name("n"))),
    14	          Return(Bool(true)), .Stmts)
    15	        If(Compare(BinOp("%", Name("n"), Name("divisor")),
    16	                   CmpOp("==", Int(0))),
    17	          Return(Bool(false)), .Stmts)
    18	        Return(Call(Name("is_prime_from"), Name("n"),
    19	                    BinOp("+", Name("divisor"), Int(1)))))
    20	      FuncDef("is_prime", Params("n"),
    21	        If(Compare(Name("n"), CmpOp("<", Int(2))),
    22	          Return(Bool(false)), .Stmts)
    23	        Return(Call(Name("is_prime_from"), Name("n"), Int(2))))
    24	      FuncDef("choose_prime", Params("n", "best"),
    25	        If(BoolOp("and",
    26	             Call(Name("is_prime"), Name("n")),
    27	             Compare(Name("n"), CmpOp(">", Name("best")))),
    28	          Return(Name("n")), .Stmts)
    29	        Return(Name("best")))
    30	      FuncDef("largest_prime", Params("lst"),
    31	        If(Compare(Call(Name("len"), Name("lst")), CmpOp("==", Int(0))),
    32	          Return(Int(0)), .Stmts)
    33	        Return(Call(Name("choose_prime"),
    34	          Subscript(Name("lst"), Int(0)),
    35	          Call(Name("largest_prime"),
    36	            Subscript(Name("lst"), Slice(Int(1), NoBound, NoBound))))))
    37	      FuncDef("digit_sum", Params("n"),
    38	        If(Compare(Name("n"), CmpOp("<", Int(10))),
    39	          Return(Name("n")), .Stmts)
    40	        Return(BinOp("+", BinOp("%", Name("n"), Int(10)),
    41	          Call(Name("digit_sum"), BinOp("//", Name("n"), Int(10))))))
    42	      FuncDef("skjkasdkd", Params("lst"),
    43	        Return(Call(Name("digit_sum"),
    44	                    Call(Name("largest_prime"), Name("lst"))))))
    45	
    46	  syntax Map ::= programDefs(Pgm) [function]
    47	               | "solutionDefs" [macro]
    48	  rule programDefs(Module(SS)) => collectDefs(SS)
    49	  rule solutionDefs => programDefs(solutionProgram)
    50	
    51	  // Independent mathematical reference functions.
    52	  syntax Bool ::= refPrimeFrom(Int, Int) [function, total]
    53	                | refPrime(Int) [function, total]
    54	  rule refPrimeFrom(N, D) => true
    55	    requires D *Int D >Int N
    56	  rule refPrimeFrom(N, D) => false
    57	    requires D *Int D <=Int N andBool N %Int D ==Int 0
    58	  rule refPrimeFrom(N, D) => refPrimeFrom(N, D +Int 1)
    59	    requires D *Int D <=Int N andBool N %Int D =/=Int 0
    60	  rule refPrime(N) => false requires N <Int 2
    61	  rule refPrime(N) => refPrimeFrom(N, 2) requires N >=Int 2
    62	
    63	  syntax Int ::= refChoose(Int, Int) [function]
    64	               | refLargest(Vals) [function]
    65	               | refDigitSum(Int) [function]
    66	               | refAnswer(Vals) [function]
    67	  rule refChoose(N, BEST) => N
    68	    requires refPrime(N) andBool N >Int BEST
    69	  rule refChoose(N, BEST) => BEST
    70	    requires notBool (refPrime(N) andBool N >Int BEST)
    71	  rule refLargest(VS) => 0
    72	    requires valLength(VS) ==Int 0
    73	  rule refLargest(VS) => refChoose(intHead(VS), refLargest(intTail(VS)))
    74	    requires valLength(VS) =/=Int 0
    75	  rule refDigitSum(N) => N requires N <Int 10
