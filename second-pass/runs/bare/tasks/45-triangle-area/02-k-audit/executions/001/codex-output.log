diff --git a//tmp/audit-work/45-triangle-area/spec-example.k b//tmp/audit-work/45-triangle-area/spec-example.k
new file mode 100644
index 0000000000000000000000000000000000000000..d427d5dfa3f003cfaa42085b24083af8c67e82ea
--- /dev/null
