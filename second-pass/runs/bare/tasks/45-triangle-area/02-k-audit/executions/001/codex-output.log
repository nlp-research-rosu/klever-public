  39: exec const patch = "*** Begin Patch\n*** Add File: /work/solution.py\n+def triangle_area(a, h):\n+    return a * h / 2\n*** Add File: /work/semantic.k\n+// A small, executable semantics for the exact Python subset used by solution.py.\n+// Numeric values are mathematical rationals.  This gives an exact model of the\n+// arithmetic in this task (and avoids making the proof depend on a particular\n+// host floating-point printer).\n+\n+module TINY-PYTHON-SYNTAX\n+  imports RAT-SYNTAX\n+  imports STRING-SYNTAX\n+\n+  syntax PyVal ::= \"PyNum\" \"(\" Rat \")\"\n+  syntax PyVal < KResult\n+\n+  syntax Exp ::= PyVal\n+               | \"Int\" \"(\" Int \")\"\n+               | \"Float\" \"(\" Float \")\"\n+               | \"Name\" \"(\" String \")\"\n+               | \"BinOp\" \"(\" String \",\" Exp \",\" Exp \")\" [strict(2, 3)]\n+\n+  syntax Params ::= \"Params\" \"(\" String \",\" String \")\"\n+  syntax Stmt ::= \"Return\" \"(\" Exp \")\" [strict]\n+                | \"FuncDef\" \"(\" String \",\" Params \",\" Stmt \")\"\n+                | \"Module\" \"(\" Stmt \")\"\n+\n+  syntax Args ::= \"Args\" \"(\" Rat \",\" Rat \")\"\n+  syntax Result ::= \"noResult\" | PyVal\n+endmodule\n+\n+module TINY-PYTHON\n+  imports TINY-PYTHON-SYNTAX\n+  imports RAT\n+  imports MAP\n+\n+  configuration\n+    <triangle>\n+      <k> $PGM:Stmt </k>\n+      <args> $ARGS:Args </args>\n+      <env> .Map </env>\n+      <result> noResult </result>\n+    </triangle>\n+\n+  // Loading this one-function module also invokes its entry point with the\n+  // two values supplied in <args>.  The body itself is interpreted normally.\n+  rule <k> Module(FuncDef(_F, Params(X, Y), BODY)) => BODY </k>\n+       <args> Args(A, H) </args>\n+       <env> .Map => (X |-> PyNum(A)) (Y |-> PyNum(H)) </env>\n+\n+  rule <k> Int(I) => PyNum(I) ... </k>\n+  rule <k> Name(X) => V ... </k>\n+       <env> ... X |-> V ... </env>\n+\n+  rule <k> BinOp(\"*\", PyNum(A), PyNum(B)) => PyNum(A *Rat B) ... </k>\n+  rule <