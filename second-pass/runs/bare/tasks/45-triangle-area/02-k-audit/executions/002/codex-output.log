/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import hashlib,itertools
cases=[(Path('/candidate'),'29047933dcadad8f2426e8466e382dce8fd7af63a77cc413c977cd771155fbeb'),(Path('/generation-evidence/codex-trace'),'9e0eddf10d0f3aea2fea91e419d9852ba938dfaac9e8b8d59ea5bb55ca2702d4')]
seps=[b'',b'\\0',b'\\n',b':',b' ',b'  ']
for filemode,dirmode,entrymode,s1,s2,s3,rootname in itertools.product(range(3),range(3),range(5),seps,seps,seps,[False,True]):
 def hd(p,root=False):
  if p.is_file():
   c=p.read_bytes(); d=hashlib.sha256(c)
   return [c,d.digest(),d.hexdigest().encode()][filemode]
  parts=[]
  for q in sorted(p.iterdir(),key=lambda x:x.name):
   child=hd(q)
   kind=b'directory' if q.is_dir() else b'file'
   token=[q.name.encode()+s1+child,
