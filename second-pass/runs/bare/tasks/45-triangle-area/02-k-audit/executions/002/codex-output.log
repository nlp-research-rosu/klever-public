+
+run krun solution.mpy --definition concrete-kompiled '-cARGS=Args(5, 3)'
+run krun solution.mpy --definition concrete-kompiled '-cARGS=Args(0, 0)'
+run krun solution.mpy --definition concrete-kompiled '-cARGS=Args(-4, 3)'
