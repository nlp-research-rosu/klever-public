+
+run kompile --version
+run kprove --version
+run krun --version
+
+run kompile semantic.k \
+  --backend llvm \
+  --main-module TINY-PYTHON \
+  --syntax-module TINY-PYTHON-SYNTAX \
+  --output-definition concrete-kompiled
+
+run kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
