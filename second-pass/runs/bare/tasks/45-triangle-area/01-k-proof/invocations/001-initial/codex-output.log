+def triangle_area(a, h):
+    return a * h / 2
diff --git a/spec-min.k b/spec-min.k
new file mode 100644
index 0000000000000000000000000000000000000000..87b27c8e7f631ece6e5ebfdc1fd172a177767f47
--- /dev/null
+++ b/spec-min.k
@@ -0,0 +1,14 @@
+requires "verification.k"
+module SPEC-MIN
+  imports VERIFICATION
+  claim
+      <k> Module(FuncDef("triangle_area", Params("a", "h"), Return(BinOp("/", BinOp("*", Name("a"), Name("h")), Int(2))))) </k>
+      <args> Args(5, 3) </args>
+      <env> .Map </env>
+      <result> noResult </result>
+  =>
+      <k> .K </k>
+      <args> Args(5, 3) </args>
+      <env> ("a" |-> PyNum(5, 1)) ("h" |-> PyNum(3, 1)) </env>
+      <result> PyNum(15, 2) </result>
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..bbf2fbc758cf4525a32448b30d2a57932e989c03
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,41 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The main theorem: for arbitrary integer side and height, interpreting the
+  // translated program returns their product divided by two.
+  claim
+      <k> triangleProgram </k>
+      <args> Args(A:Int, H:Int) </args>
+      <env> .Map </env>
+      <result> noResult </result>
+  =>
+      <k> .K </k>
+      <args> Args(A, H) </args>
+      <env> ("a" |-> PyNum(A, 1)) ("h" |-> PyNum(H, 1)) </env>
+      <result> PyNum(A *Int H, 2) </result>
+
+  // Prompt example: triangle_area(5, 3) == 7.5 == 15/2.
+  claim
+      <k> triangleProgram </k>
+      <args> Args(5, 3) </args>
+      <env> .Map </env>
+      <result> noResult </result>
+  =>
+      <k> .K </k>
+      <args> Args(5, 3) </args>
+      <env> ("a" |-> PyNum(5, 1)) ("h" |-> PyNum(3, 1)) </env>
+      <result> PyNum(15, 2) </result>
+
+  claim
+      <k> triangleProgram </k>
+      <args> Args(0, 99) </args>
+      <env> .Map </env>
+      <result> noResult </result>
+  =>
+      <k> .K </k>
+      <args> Args(0, 99) </args>
+      <env> ("a" |-> PyNum(0, 1)) ("h" |-> PyNum(99, 1)) </env>
+      <result> PyNum(0, 2) </result>
+endmodule
