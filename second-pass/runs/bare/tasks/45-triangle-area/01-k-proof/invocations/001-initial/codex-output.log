+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+
+# The Haskell backend supports both concrete execution and reachability proof.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module TINY-PYTHON-SYNTAX
+
+# Execute the actual generated constructor program on the documented example.
+krun solution.mpy \
+  --definition verification-kompiled \
+  --parser cat \
+  -cARGS='Args(5, 3)'
+
+# Prove every reachability claim in spec.k.
+kprove spec.k --definition verification-kompiled
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..c8b6274ae4118b593b265cfac4015eb4eb715024
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,57 @@
+// A small, executable semantics for the exact Python subset used by solution.py.
+// Numeric values are mathematical rationals.  This gives an exact model of the
+// arithmetic in this task (and avoids making the proof depend on a particular
+// host floating-point printer).
+
+module TINY-PYTHON-SYNTAX
+  imports RAT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax PyVal ::= "PyNum" "(" Rat ")"
+  syntax PyVal < KResult
+
+  syntax Exp ::= PyVal
+               | "Int" "(" Int ")"
+               | "Float" "(" Float ")"
+               | "Name" "(" String ")"
+               | "BinOp" "(" String "," Exp "," Exp ")" [strict(2, 3)]
+
+  syntax Params ::= "Params" "(" String "," String ")"
+  syntax Stmt ::= "Return" "(" Exp ")" [strict]
+                | "FuncDef" "(" String "," Params "," Stmt ")"
+                | "Module" "(" Stmt ")"
+
+  syntax Args ::= "Args" "(" Rat "," Rat ")"
+  syntax Result ::= "noResult" | PyVal
+endmodule
+
+module TINY-PYTHON
+  imports TINY-PYTHON-SYNTAX
+  imports RAT
+  imports MAP
+
+  configuration
+    <triangle>
+      <k> $PGM:Stmt </k>
+      <args> $ARGS:Args </args>
+      <env> .Map </env>
+      <result> noResult </result>
+    </triangle>
+
+  // Loading this one-function module also invokes its entry point with the
+  // two values supplied in <args>.  The body itself is interpreted normally.
+  rule <k> Module(FuncDef(_F, Params(X, Y), BODY)) => BODY </k>
+       <args> Args(A, H) </args>
+       <env> .Map => (X |-> PyNum(A)) (Y |-> PyNum(H)) </env>
+
+  rule <k> Int(I) => PyNum(I) ... </k>
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V ... </env>
+
+  rule <k> BinOp("*", PyNum(A), PyNum(B)) => PyNum(A *Rat B) ... </k>
+  rule <k> BinOp("/", PyNum(A), PyNum(B)) => PyNum(A /Rat B) ... </k>
+       requires B =/=Rat 0
+
+  rule <k> Return(V:PyVal) => .K </k>
+       <result> noResult => V </result>
+endmodule
