+  claim
+      <k> triangleProgram </k>
+      <args> Args(5, 3) </args>
+      <env> .Map </env>
+      <result> noResult </result>
+  =>
+      <k> .K </k>
+      <args> Args(5, 3) </args>
+      <env> ("a" |-> PyNum(5, 1)) ("h" |-> PyNum(3, 1)) </env>
+      <result> PyNum(15, 2) </result>
+
+  claim
+      <k> triangleProgram </k>
+      <args> Args(0, 99) </args>
+      <env> .Map </env>
+      <result> noResult </result>
+  =>
+      <k> .K </k>
+      <args> Args(0, 99) </args>
+      <env> ("a" |-> PyNum(0, 1)) ("h" |-> PyNum(99, 1)) </env>
+      <result> PyNum(0, 2) </result>
+endmodule
