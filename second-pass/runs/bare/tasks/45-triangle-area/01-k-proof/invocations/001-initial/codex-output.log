+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The main theorem: for arbitrary integer side and height, interpreting the
+  // translated program returns their product divided by two.
+  claim
+    <triangle>
+      <k> triangleProgram </k>
+      <args> Args(A:Int, H:Int) </args>
+      <env> .Map </env>
+      <result> noResult </result>
+    </triangle>
+  =>
+    <triangle>
+      <k> .K </k>
+      <args> Args(A, H) </args>
+      <env> ("a" |-> PyNum(A)) ("h" |-> PyNum(H)) </env>
+      <result> PyNum((A *Rat H) /Rat 2) </result>
+    </triangle>
+
+  // Prompt example: triangle_area(5, 3) == 7.5 == 15/2.
+  claim
+    <triangle>
+      <k> triangleProgram </k>
+      <args> Args(5, 3) </args>
+      <env> .Map </env>
+      <result> noResult </result>
+    </triangle>
+  =>
+    <triangle>
+      <k> .K </k>
+      <args> Args(5, 3) </args>
+      <env> ("a" |-> PyNum(5)) ("h" |-> PyNum(3)) </env>
+      <result> PyNum(15 /Rat 2) </result>
+    </triangle>
+
+  claim
+    <triangle>
+      <k> triangleProgram </k>
+      <args> Args(0, 99) </args>
+      <env> .Map </env>
+      <result> noResult </result>
+    </triangle>
+  =>
+    <triangle>
+      <k> .K </k>
+      <args> Args(0, 99) </args>
+      <env> ("a" |-> PyNum(0)) ("h" |-> PyNum(99)) </env>
+      <result> PyNum(0) </result>
+    </triangle>
+endmodule
