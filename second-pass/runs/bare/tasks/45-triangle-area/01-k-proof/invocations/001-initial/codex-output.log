--- /dev/null
+++ b/toy-spec.k
@@ -0,0 +1,5 @@
+requires "toy.k"
+module TOY-SPEC
+  imports TOY
+  claim <k> 1 + 2 => 3 </k>
+endmodule
diff --git a/toy.k b/toy.k
new file mode 100644
index 0000000000000000000000000000000000000000..e6cc02e014c1ed11293752137d99ba64fccb740f
--- /dev/null
+++ b/toy.k
@@ -0,0 +1,6 @@
+module TOY
+  imports INT
+  syntax Exp ::= Int | Exp "+" Exp [left, strict]
+  rule I1:Int + I2:Int => I1 +Int I2
+  configuration <k> $PGM:Exp </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..6c80122b97601489ec46d50080c391a9ca14daf6
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,12 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports TINY-PYTHON
+
+  // This is exactly the constructor tree generated in solution.mpy.  Naming
+  // it keeps the reachability claims legible without bypassing interpretation.
+  syntax Stmt ::= "triangleProgram"
+  rule triangleProgram =>
+    Module(FuncDef("triangle_area", Params("a", "h"),
+      Return(BinOp("/", BinOp("*", Name("a"), Name("h")), Int(2)))))
+endmodule

exec
/bin/bash -lc 'kompile toy.k --backend haskell && kprove toy-spec.k --definition toy-kompiled --spec-module TOY-SPEC --debug' in /work
