diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..79c9395ce8e399e6eb809b1ec378d6188e4a5a49
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,53 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The main theorem: for arbitrary integer side and height, interpreting the
+  // translated program returns their product divided by two.
+  claim
+    <triangle>
+      <k> triangleProgram </k>
+      <args> Args(A:Int, H:Int) </args>
+      <env> .Map </env>
+      <result> noResult </result>
+    </triangle>
+  =>
+    <triangle>
+      <k> .K </k>
+      <args> Args(A, H) </args>
+      <env> ("a" |-> PyNum(A)) ("h" |-> PyNum(H)) </env>
+      <result> PyNum((A *Rat H) /Rat 2) </result>
+    </triangle>
+
+  // Prompt example: triangle_area(5, 3) == 7.5 == 15/2.
+  claim
+    <triangle>
+      <k> triangleProgram </k>
+      <args> Args(5, 3) </args>
+      <env> .Map </env>
+      <result> noResult </result>
+    </triangle>
+  =>
+    <triangle>
+      <k> .K </k>
+      <args> Args(5, 3) </args>
+      <env> ("a" |-> PyNum(5)) ("h" |-> PyNum(3)) </env>
+      <result> PyNum(15 /Rat 2) </result>
+    </triangle>
+
+  claim
+    <triangle>
+      <k> triangleProgram </k>
+      <args> Args(0, 99) </args>
+      <env> .Map </env>
+      <result> noResult </result>
+    </triangle>
+  =>
+    <triangle>
+      <k> .K </k>
+      <args> Args(0, 99) </args>
+      <env> ("a" |-> PyNum(0)) ("h" |-> PyNum(99)) </env>
+      <result> PyNum(0) </result>
+    </triangle>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..6c80122b97601489ec46d50080c391a9ca14daf6
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,12 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports TINY-PYTHON
+
+  // This is exactly the constructor tree generated in solution.mpy.  Naming
+  // it keeps the reachability claims legible without bypassing interpretation.
+  syntax Stmt ::= "triangleProgram"
+  rule triangleProgram =>
+    Module(FuncDef("triangle_area", Params("a", "h"),
+      Return(BinOp("/", BinOp("*", Name("a"), Name("h")), Int(2)))))
+endmodule

apply patch
