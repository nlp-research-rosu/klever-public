+    for path in sorted(WORKSPACE.rglob("*"))
+    if path.is_file() and not path.is_symlink()
+}
+require(
+    stage1_source_hashes == resolution["stage1_source_hashes"],
+    "Stage 1 per-file hashes differ from audit-input.json",
+)
