/tmp/audit-work/fix_lean_app_path.c
diff --git a//tmp/audit-work/fix_lean_app_path.c b//tmp/audit-work/fix_lean_app_path.c
new file mode 100644
index 0000000000000000000000000000000000000000..83fe822a25ea680370976c8efd2e0914890e7553
--- /dev/null
+++ b//tmp/audit-work/fix_lean_app_path.c
@@ -0,0 +1,25 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+static int is_proc_pid_exe(const char *path) {
+  const char *cursor = path;
+  if (strncmp(cursor, "/proc/", 6) != 0) return 0;
+  cursor += 6;
+  if (*cursor < '0' || *cursor > '9') return 0;
+  while (*cursor >= '0' && *cursor <= '9') cursor++;
+  return strcmp(cursor, "/exe") == 0;
+}
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t) = NULL;
+  if (!real_readlink) real_readlink = dlsym(RTLD_NEXT, "readlink");
+  ssize_t result = real_readlink(path, buf, size);
+  if (result < 0 && errno == ENOENT && is_proc_pid_exe(path)) {
+    result = real_readlink("/proc/self/exe", buf, size);
+  }
+  return result;
+}
