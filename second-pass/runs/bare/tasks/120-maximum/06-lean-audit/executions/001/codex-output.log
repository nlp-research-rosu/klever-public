+)
+pipeline_stage1_tree_sha256 = pipeline_contract.sha256_tree(WORKSPACE)
+export_stage1_tree_sha256 = klean_export.tree_digest(WORKSPACE)
+require(
+    pipeline_stage1_tree_sha256 == resolution["hashes"]["k_workspace_sha256"],
