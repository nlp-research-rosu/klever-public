            for chunk in iter(lambda: stream.read(_HASH_CHUNK_SIZE), b""):
                digest.update(chunk)
    except OSError as error:
        raise PipelineContractError(f"cannot hash file {path}: {error}") from error
    return digest.hexdigest()


