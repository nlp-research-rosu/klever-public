     6	  // Mathematical contract: sorting the full input and dropping all but its
     7	  // final K values yields exactly the sorted multiset of the K largest values.
     8	  syntax List ::= "maximumSpec" "(" List "," Int ")" [function]
     9	  rule maximumSpec(L:List, K:Int)
    10	    => dropInts(size(L) -Int K, sortInts(L))
