 r = await tools.exec_command({cmd:\"kprove spec.k --definition semantic-kompiled --module MAXIMUM-SPEC\",workdir:\"/work\",yield_time_ms:30000,max_output_tokens:30000});\ntext(a);\ntext(r.output);\nif (r.session_id) text(JSON.stringify({session_id:r.session_id}));","internal_chat_message_metadata_passthrough":{"turn_id":"019f89ac-cd88-7c72-b006-c8ec63e2f90f"}}}
