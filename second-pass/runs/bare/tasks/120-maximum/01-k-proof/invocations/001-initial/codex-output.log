diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..8dbb9d52157cff7aa55ca08c8b8bae8d095b3d6a
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,32 @@
+requires "verification.k"
+
+module MAXIMUM-SPEC
+  imports MAXIMUM-VERIFICATION
+
+  claim
+    <maximum>
+      <k>
+        Module(
+          FuncDef("maximum", Params("arr", "k"),
+            Return(
+              Subscript(
+                Call(Name("sorted"), Name("arr")),
+                Slice(
+                  BinOp("-", Call(Name("len"), Name("arr")), Name("k")),
+                  NoBound,
+                  NoBound)))))
+        ~> boot
+      </k>
+      <args> ListItem(listVal(L:List)) ListItem(intVal(K:Int)) </args>
+      <env> .Map </env>
+      <out> noResult </out>
+    </maximum>
+  =>
+    <maximum>
+      <k> .K </k>
+      <args> ListItem(listVal(L)) ListItem(intVal(K)) </args>
+      <env> ("arr" |-> listVal(L)) ("k" |-> intVal(K)) </env>
+      <out> listVal(maximumSpec(L, K)) </out>
+    </maximum>
+  requires 0 <=Int K andBool K <=Int size(L)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f6ab6b409326ab37fbcf47789984f65740ee7052
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,11 @@
+requires "semantic.k"
+
+module MAXIMUM-VERIFICATION
+  imports MAXIMUM
+
+  // Mathematical contract: sorting the full input and dropping all but its
+  // final K values yields exactly the sorted multiset of the K largest values.
+  syntax List ::= "maximumSpec" "(" List "," Int ")" [function]
+  rule maximumSpec(L:List, K:Int)
+    => dropInts(size(L) -Int K, sortInts(L))
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition semantic-kompiled --module MAXIMUM-SPEC' in /work
