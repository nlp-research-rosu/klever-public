+                | "Assign" "(" Expr "," Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "Expr" "(" Expr ")"
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Name" "(" String ")"
+                | "Str" "(" String ")"
+                | "Float" "(" Float ")"
+                | "ListExpr" "(" Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "Call" "(" Expr "," Exprs ")"
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
