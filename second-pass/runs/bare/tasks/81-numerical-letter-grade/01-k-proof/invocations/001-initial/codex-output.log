+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A mathematical restatement of the prompt's table over exact rationals.
+  // The first two equations preserve the program's deliberate special case:
+  // exactly 4.0 is A+, while any other value above 3.7 is A.
+  syntax Value ::= expectedGrade(Int, Int) [function, total]
+  rule expectedGrade(P, Q) => str("A+")
+    requires P ==Int (4 *Int Q)
+  rule expectedGrade(P, Q) => str("A")
+    requires (P =/=Int (4 *Int Q)) andBool ((10 *Int P) >Int (37 *Int Q))
+  rule expectedGrade(P, Q) => str("A-")
+    requires ((10 *Int P) <=Int (37 *Int Q)) andBool ((10 *Int P) >Int (33 *Int Q))
+  rule expectedGrade(P, Q) => str("B+")
+    requires ((10 *Int P) <=Int (33 *Int Q)) andBool ((10 *Int P) >Int (30 *Int Q))
+  rule expectedGrade(P, Q) => str("B")
+    requires ((10 *Int P) <=Int (30 *Int Q)) andBool ((10 *Int P) >Int (27 *Int Q))
+  rule expectedGrade(P, Q) => str("B-")
+    requires ((10 *Int P) <=Int (27 *Int Q)) andBool ((10 *Int P) >Int (23 *Int Q))
+  rule expectedGrade(P, Q) => str("C+")
+    requires ((10 *Int P) <=Int (23 *Int Q)) andBool ((10 *Int P) >Int (20 *Int Q))
+  rule expectedGrade(P, Q) => str("C")
+    requires ((10 *Int P) <=Int (20 *Int Q)) andBool ((10 *Int P) >Int (17 *Int Q))
+  rule expectedGrade(P, Q) => str("C-")
+    requires ((10 *Int P) <=Int (17 *Int Q)) andBool ((10 *Int P) >Int (13 *Int Q))
+  rule expectedGrade(P, Q) => str("D+")
+    requires ((10 *Int P) <=Int (13 *Int Q)) andBool ((10 *Int P) >Int (10 *Int Q))
+  rule expectedGrade(P, Q) => str("D")
+    requires ((10 *Int P) <=Int (10 *Int Q)) andBool ((10 *Int P) >Int (7 *Int Q))
+  rule expectedGrade(P, Q) => str("D-")
+    requires ((10 *Int P) <=Int (7 *Int Q)) andBool (P >Int 0)
+  rule expectedGrade(P, Q) => str("E")
+    requires P <=Int 0
+
+  syntax Vals ::= expectedGrades(Vals) [function, total]
+  rule expectedGrades(.Vals) => .Vals
+  rule expectedGrades(num(P, Q) :: REST)
+    => expectedGrade(P, Q) :: expectedGrades(REST)
+
+  // The exact loop body is named so the proof can state and verify its
+  // per-iteration invariant independently of list length.
+  syntax Stmts ::= "gradingBody" [function, total]
+  rule gradingBody =>
+    If(Compare(Name("grade"), CmpOp("==", Float(4.0))),
+      Expr(Call(Attribute(Name("result"), "append"), Str("A+"))),
+      If(Compare(Name("grade"), CmpOp(">", Float(3.7))),
+        Expr(Call(Attribute(Name("result"), "append"), Str("A"))),
+        If(Compare(Name("grade"), CmpOp(">", Float(3.3))),
+          Expr(Call(Attribute(Name("result"), "append"), Str("A-"))),
+          If(Compare(Name("grade"), CmpOp(">", Float(3.0))),
+            Expr(Call(Attribute(Name("result"), "append"), Str("B+"))),
+            If(Compare(Name("grade"), CmpOp(">", Float(2.7))),
+              Expr(Call(Attribute(Name("result"), "append"), Str("B"))),
+              If(Compare(Name("grade"), CmpOp(">", Float(2.3))),
+                Expr(Call(Attribute(Name("result"), "append"), Str("B-"))),
+                If(Compare(Name("grade"), CmpOp(">", Float(2.0))),
+                  Expr(Call(Attribute(Name("result"), "append"), Str("C+"))),
+                  If(Compare(Name("grade"), CmpOp(">", Float(1.7))),
+                    Expr(Call(Attribute(Name("result"), "append"), Str("C"))),
+                    If(Compare(Name("grade"), CmpOp(">", Float(1.3))),
+                      Expr(Call(Attribute(Name("result"), "append"), Str("C-"))),
+                      If(Compare(Name("grade"), CmpOp(">", Float(1.0))),
+                        Expr(Call(Attribute(Name("result"), "append"), Str("D+"))),
+                        If(Compare(Name("grade"), CmpOp(">", Float(0.7))),
+                          Expr(Call(Attribute(Name("result"), "append"), Str("D"))),
+                          If(Compare(Name("grade"), CmpOp(">", Float(0.0))),
+                            Expr(Call(Attribute(Name("result"), "append"), Str("D-"))),
+                            Expr(Call(Attribute(Name("result"), "append"), Str("E")))))))))))))))
+
+  // This term is an exact K copy of solution.mpy. Keeping it here makes each
+  // reachability claim explicitly start from the submitted translated program.
+  syntax Module ::= "solutionProgram" [function, total]
+  rule solutionProgram =>
+    Module(
+      FuncDef("numerical_letter_grade", Params("grades"),
+        Expr(
+          Str("Convert each numerical GPA in grades to its letter grade."))
+        Assign(Name("result"), ListExpr(.Exprs))
+        For(Name("grade"), Name("grades"), gradingBody)
+        Return(Name("result"))))
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..ecada8a22060965affe916a44b7705f4886c087e
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,148 @@
+module MPY-SYNTAX
+  imports BOOL-SYNTAX
+  imports FLOAT-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  // The CPython-AST constructors emitted by py2mpy.py that solution.mpy uses.
+  syntax Module ::= "Module" "(" Stmts ")"
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Strings ::= List{String, ","}
+  syntax Params ::= "Params" "(" Strings ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "Expr" "(" Expr ")"
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Name" "(" String ")"
+                | "Str" "(" String ")"
+                | "Float" "(" Float ")"
+                | "ListExpr" "(" Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "Call" "(" Expr "," Exprs ")"
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  // Runtime values. num(P,Q) denotes the exact rational P/Q; callers must
+  // supply positive denominators. Vals is deliberately an ordinary free
+  // datatype, making list order and every append step visible in proofs.
+  syntax Value ::= "num" "(" Int "," Int ")"
+                 | "str" "(" String ")"
+                 | "bool" "(" Bool ")"
+                 | "list" "(" Vals ")"
+                 | "none"
+  syntax Vals ::= ".Vals"
+                | Value "::" Vals
+
+  syntax Result ::= "noResult" | Value
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports BOOL
+  imports FLOAT
+  imports INT
+  imports MAP
+
+  configuration
+    <mpy>
+      <k> $PGM:Module </k>
+      <input> $INPUT:Vals </input>
+      <env> .Map </env>
+      <result> noResult </result>
+    </mpy>
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "eval" "(" Expr ")"
+                 | "store" "(" String ")"
+                 | "discard"
+                 | "ifReady" "(" Stmts "," Stmts ")"
+                 | "forReady" "(" Expr "," Stmts ")"
+                 | "loop" "(" String "," Stmts "," Vals ")"
+                 | "put" "(" String "," Value ")"
+                 | "cmpRight" "(" String "," Expr ")"
+                 | "applyCmp" "(" String "," Value ")"
+                 | "appendTo" "(" String ")"
+                 | "returnValue"
+
+  syntax Vals ::= append(Vals, Value) [function, total]
+  rule append(.Vals, V) => V :: .Vals
+  rule append(V :: VS, W) => V :: append(VS, W)
+
+  // Calling the required module-level function with the values in <input>.
+  rule <k> Module(FuncDef("numerical_letter_grade", Params("grades"), BODY))
+        => exec(BODY) ...</k>
+       <input> INPUT </input>
+       <env> .Map => "grades" |-> list(INPUT) </env>
+
+  // Statement sequencing.
+  rule <k> exec(.Stmts) => .K ...</k>
+  rule <k> exec(S SS) => S ~> exec(SS) ...</k>
+
+  rule <k> Expr(E) => eval(E) ~> discard ...</k>
+  rule <k> V:Value ~> discard => .K ...</k>
+
+  rule <k> Assign(Name(X), E) => eval(E) ~> store(X) ...</k>
+  rule <k> V:Value ~> store(X) => put(X, V) ...</k>
+
+  rule <k> put(X, V) => .K ...</k>
+       <env>... X |-> (_ => V) ...</env>
+  rule <k> put(X, V) => .K ...</k>
+       <env> ENV => ENV (X |-> V) </env>
+    requires notBool (X in_keys(ENV))
+
+  rule <k> If(TEST, THEN, ELSE) => eval(TEST) ~> ifReady(THEN, ELSE) ...</k>
+  rule <k> bool(true)  ~> ifReady(THEN, _) => exec(THEN) ...</k>
+  rule <k> bool(false) ~> ifReady(_, ELSE) => exec(ELSE) ...</k>
+
+  rule <k> For(Name(X), ITER, BODY) => eval(ITER) ~> forReady(Name(X), BODY) ...</k>
+  rule <k> list(VS) ~> forReady(Name(X), BODY) => loop(X, BODY, VS) ...</k>
+  rule <k> loop(_, _, .Vals) => .K ...</k>
+  rule <k> loop(X, BODY, V :: VS)
+        => put(X, V) ~> exec(BODY) ~> loop(X, BODY, VS) ...</k>
+
+  rule <k> Return(E) => eval(E) ~> returnValue ...</k>
+  rule <k> V:Value ~> returnValue => .K ...</k>
+       <result> _ => V </result>
+
+  // Expressions.
+  rule <k> eval(Name(X)) => V ...</k>
+       <env>... X |-> V ...</env>
+  rule <k> eval(Str(S)) => str(S) ...</k>
+  rule <k> eval(ListExpr(.Exprs)) => list(.Vals) ...</k>
+
+  // Exact decimal meanings of all float literals in solution.py.
+  rule <k> eval(Float(4.0)) => num(4, 1) ...</k>
+  rule <k> eval(Float(3.7)) => num(37, 10) ...</k>
+  rule <k> eval(Float(3.3)) => num(33, 10) ...</k>
+  rule <k> eval(Float(3.0)) => num(3, 1) ...</k>
+  rule <k> eval(Float(2.7)) => num(27, 10) ...</k>
+  rule <k> eval(Float(2.3)) => num(23, 10) ...</k>
+  rule <k> eval(Float(2.0)) => num(2, 1) ...</k>
+  rule <k> eval(Float(1.7)) => num(17, 10) ...</k>
+  rule <k> eval(Float(1.3)) => num(13, 10) ...</k>
+  rule <k> eval(Float(1.0)) => num(1, 1) ...</k>
+  rule <k> eval(Float(0.7)) => num(7, 10) ...</k>
+  rule <k> eval(Float(0.0)) => num(0, 1) ...</k>
+
+  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT)))
+        => eval(LEFT) ~> cmpRight(OP, RIGHT) ...</k>
+  rule <k> V:Value ~> cmpRight(OP, RIGHT)
+        => eval(RIGHT) ~> applyCmp(OP, V) ...</k>
+  rule <k> num(A, B) ~> applyCmp("==", num(P, Q))
+        => bool((A *Int Q) ==Int (P *Int B)) ...</k>
+  rule <k> num(A, B) ~> applyCmp(">", num(P, Q))
+        => bool((P *Int B) >Int (A *Int Q)) ...</k>
+
+  // The only method used by this task: list.append. It mutates the named
+  // list and evaluates to Python's None value.
+  rule <k> eval(Call(Attribute(Name(X), "append"), ARG))
+        => eval(ARG) ~> appendTo(X) ...</k>
+  rule <k> V:Value ~> appendTo(X) => none ...</k>
+       <env>... X |-> (list(VS) => list(append(VS, V))) ...</env>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4c59a72621d6fc33f26e3af9cc6e4b71ca429317
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,31 @@
+def numerical_letter_grade(grades):
+    """Convert each numerical GPA in grades to its letter grade."""
+    result = []
+    for grade in grades:
+        if grade == 4.0:
+            result.append("A+")
+        elif grade > 3.7:
+            result.append("A")
+        elif grade > 3.3:
+            result.append("A-")
+        elif grade > 3.0:
+            result.append("B+")
+        elif grade > 2.7:
+            result.append("B")
+        elif grade > 2.3:
+            result.append("B-")
+        elif grade > 2.0:
+            result.append("C+")
+        elif grade > 1.7:
+            result.append("C")
+        elif grade > 1.3:
+            result.append("C-")
+        elif grade > 1.0:
+            result.append("D+")
+        elif grade > 0.7:
+            result.append("D")
+        elif grade > 0.0:
+            result.append("D-")
+        else:
+            result.append("E")
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9637ac101211f4312943d38386d61f6ef1f673a2
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,91 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The loop handles the empty list and returns a fresh empty result.
+  claim [empty-input]:
+    <k> solutionProgram => .K </k>
+    <input> .Vals </input>
+    <env>
+      .Map
+      => ("grades" |-> list(.Vals)) ("result" |-> list(.Vals))
+    </env>
+    <result> noResult => list(.Vals) </result>
+
+  // For every exact rational GPA (positive denominator), the translated
+  // Python decision tree agrees with the independently stated grading table.
+  // Symbolic execution splits this claim across every table interval.
+  claim [all-single-grades]:
+    <k> solutionProgram => .K </k>
+    <input> num(P, Q) :: .Vals </input>
+    <env>
+      .Map
+      =>
+        "grade" |-> num(P, Q)
+        "grades" |-> list(num(P, Q) :: .Vals)
+        "result" |-> list(expectedGrade(P, Q) :: .Vals)
+    </env>
+    <result> noResult => list(expectedGrade(P, Q) :: .Vals) </result>
+    requires Q >Int 0
+
+  // Inductive loop invariant, first iteration: for any accumulated output
+  // and any unprocessed tail, one iteration appends exactly the reference
+  // grade and leaves the tail as the next loop state.
+  claim [loop-step-new-variable]:
+    <k>
+      loop("grade", gradingBody, num(P, Q) :: REST)
+      => loop("grade", gradingBody, REST)
+    </k>
+    <env>
+      ("grades" |-> list(ALL)) ("result" |-> list(OUT))
+      =>
+      ("grade" |-> num(P, Q))
+      ("grades" |-> list(ALL))
+      ("result" |-> list(append(OUT, expectedGrade(P, Q))))
+    </env>
+    requires Q >Int 0
+
+  // The same invariant for all later iterations, where the loop variable is
+  // updated rather than inserted. Together with the empty-loop equation this
+  // is the structural induction step for lists of arbitrary finite length.
+  claim [loop-step-existing-variable]:
+    <k>
+      loop("grade", gradingBody, num(P, Q) :: REST)
+      => loop("grade", gradingBody, REST)
+    </k>
+    <env>
+      ("grade" |-> OLD)
+      ("grades" |-> list(ALL))
+      ("result" |-> list(OUT))
+      =>
+      ("grade" |-> num(P, Q))
+      ("grades" |-> list(ALL))
+      ("result" |-> list(append(OUT, expectedGrade(P, Q))))
+    </env>
+    requires Q >Int 0
+
+  claim [loop-empty]:
+    <k> loop("grade", gradingBody, .Vals) => .K </k>
+
+  // The prompt's full example additionally checks traversal, mutation order,
+  // strict-boundary behavior, and preservation of output list order.
+  claim [prompt-example]:
+    <k> solutionProgram => .K </k>
+    <input>
+      num(4, 1) :: num(3, 1) :: num(17, 10) :: num(2, 1) :: num(35, 10) :: .Vals
+    </input>
+    <env>
+      .Map
+      =>
+        "grade" |-> num(35, 10)
+        "grades" |-> list(
+          num(4, 1) :: num(3, 1) :: num(17, 10) :: num(2, 1) :: num(35, 10) :: .Vals)
+        "result" |-> list(
+          str("A+") :: str("B") :: str("C-") :: str("C") :: str("A-") :: .Vals)
+    </env>
+    <result>
+      noResult
+      => list(str("A+") :: str("B") :: str("C-") :: str("C") :: str("A-") :: .Vals)
+    </result>
+endmodule
