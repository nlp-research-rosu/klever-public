+                 | "str" "(" String ")"
+                 | "bool" "(" Bool ")"
+                 | "list" "(" Vals ")"
+                 | "none"
+  syntax Vals ::= ".Vals"
+                | Value "::" Vals
+
+  syntax Result ::= "noResult" | Value
+endmodule
