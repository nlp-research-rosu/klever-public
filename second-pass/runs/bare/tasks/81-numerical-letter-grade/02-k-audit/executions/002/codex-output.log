    14	  rule expectedGrade(P, Q) => str("A-")
    15	    requires ((10 *Int P) <=Int (37 *Int Q)) andBool ((10 *Int P) >Int (33 *Int Q))
    16	  rule expectedGrade(P, Q) => str("B+")
