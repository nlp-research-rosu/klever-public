(144, 'exec', 'const patch = "*** Begin Patch\\n*** Add File: /work/test-spec.k\\n+requires \\"verification.k\\"\\n+module TEST-SPEC\\n+  imports VERIFICATION\\n+  claim\\n+    <k> solutionProgram => .K </k>\\n+    <input> .Vals </input>\\n+    <env> .Map => (\\"grades\\" |-> list(.Vals)) (\\"result\\" |-> list(.Vals)) </env>\\n+    <result> noResult => list(.Vals) </result>\\n+endmodule\\n*** End Patch";\nconst a = await tools.apply_patch(patch);\nconst r = await tools.exec_command({cmd:"kprove test-spec.k --definition verification-kompiled --dry-run --debug",workdir:"/work",yield_time_ms:1000,max_output_tokens:20000});\ntext(a);\ntext(r);\n')
