diff --git a//tmp/audit-work/reconstruction/spec-vacuity.k b//tmp/audit-work/reconstruction/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..bb44d6d411ce5742dfc97157e91c12137cd399e0
--- /dev/null
+++ b//tmp/audit-work/reconstruction/spec-vacuity.k
@@ -0,0 +1,19 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Fresh reviewer mutation. Input [4.0] is satisfiable and the real program
+  // returns ["A+"], so requiring ["WRONG"] in the result cell is false.
+  claim [false-single-result]:
+    <k> solutionProgram => .K </k>
+    <input> num(4, 1) :: .Vals </input>
+    <env>
+      .Map
+      =>
+        "grade" |-> num(4, 1)
+        "grades" |-> list(num(4, 1) :: .Vals)
+        "result" |-> list(str("A+") :: .Vals)
+    </env>
+    <result> noResult => list(str("WRONG") :: .Vals) </result>
+endmodule
