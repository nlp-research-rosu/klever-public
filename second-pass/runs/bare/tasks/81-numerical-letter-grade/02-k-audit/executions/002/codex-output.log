(152, 'exec', 'const patch = "*** Begin Patch\\n*** Update File: /work/spec.k\\n@@\\n   // The loop handles the empty list and returns a fresh empty result.\\n   claim [empty-input]:\\n-    <mpy>\\n-      <k> solutionProgram </k>\\n-      <input> .Vals </input>\\n-      <env> .Map </env>\\n-      <result> noResult </result>\\n-    </mpy>\\n-  =>\\n-    <mpy>\\n-      <k> .K </k>\\n-      <input> .Vals </input>\\n-      <env>\\n-        \\"grades\\" |-> list(.Vals)\\n-        \\"result\\" |-> list(.Vals)\\n-      </env>\\n-      <result> list(.Vals) </result>\\n-    </mpy>\\n+    <k> solutionProgram => .K </k>\\n+    <input> .Vals </input>\\n+    <env>\\n+      .Map\\n+      => (\\"grades\\" |-> list(.Vals)) (\\"result\\" |-> list(.Vals))\\n+    </env>\\n+    <result> noResult => list(.Vals) </result>\\n@@\\n   // Symbolic execution splits this claim across every table interval.\\n   claim [all-single-grades]:\\n-    <mpy>\\n-      <k> solutionProgram </k>\\n-      <input> num(P, Q) :: .Vals </input>\\n-      <env> .Map </env>\\n-      <result> noResult </result>\\n-    </mpy>\\n-  =>\\n-    <mpy>\\n-      <k> .K </k>\\n-      <input> num(P, Q) :: .Vals </input>\\n-      <env>\\n+    <k> solutionProgram => .K </k>\\n+    <input> num(P, Q) :: .Vals </input>\\n+    <env>\\n+      .Map\\n+      =>\\n         \\"grade\\" |-> num(P, Q)\\n         \\"grades\\" |-> list(num(P, Q) :: .Vals)\\n         \\"result\\" |-> list(expectedGrade(P, Q) :: .Vals)\\n-      </env>\\n-      <result> list(expectedGrade(P, Q) :: .Vals) </result>\\n-    </mpy>\\n+    </env>\\n+    <result> noResult => list(expectedGrade(P, Q) :: .Vals) </result>\\n     requires Q >Int 0\\n@@\\n   // strict-boundary behavior, and preservation of output list order.\\n   claim [prompt-example]:\\n-    <mpy>\\n-      <k> solutionProgram </k>\\n-      <input>\\n-        num(4, 1) :: num(3, 1) :: num(17, 10) :: num(2, 1) :: num(35, 10) :: .Vals\\n-      </input>\\n-      <env> .Map </env>\\n-      <result> noResult </result>\\n-    </mpy>\\n-  =>\\n-    <mpy>\\n-      <k> .K </k>\\n-      <input>\\n-        num(4, 1) :: num(3, 1) :: num(17, 10) :: num(2, 1) :: num(35, 10) :: .Vals\\n-      </input>\\n-      <env>\\n+    <k> solutionProgram => .K </k>\\n+    <input>\\n+      num(4, 1) :: num(3, 1) :: num(17, 10) :: num(2, 1) :: num(35, 10) :: .Vals\\n+    </input>\\n+    <env>\\n+      .Map\\n+      =>\\n         \\"grade\\" |-> num(35, 10)\\n         \\"grades\\" |-> list(\\n           num(4, 1) :: num(3, 1) :: num(17, 10) :: num(2, 1) :: num(35, 10) :: .Vals)\\n         \\"result\\" |-> list(\\n           str(\\"A+\\") :: str(\\"B\\") :: str(\\"C-\\") :: str(\\"C\\") :: str(\\"A-\\") :: .Vals)\\n-      </env>\\n-      <result>\\n-        list(str(\\"A+\\") :: str(\\"B\\") :: str(\\"C-\\") :: str(\\"C\\") :: str(\\"A-\\") :: .Vals)\\n-      </result>\\n-    </mpy>\\n+    </env>\\n+    <result>\\n+      noResult\\n+      => list(str(\\"A+\\") :: str(\\"B\\") :: str(\\"C-\\") :: str(\\"C\\") :: str(\\"A-\\") :: .Vals)\\n+    </result>\\n endmodule\\n*** Delete File: /work/test-spec.k\\n*** End Patch";\nconst a = await tools.apply_patch(patch);\nconst r = await tools.exec_command({cmd:"kprove spec.k --definition verification-kompiled --dry-run",workdir:"/work",yield_time_ms:1000,max_output_tokens:20000});\ntext(a);\ntext(r);\n')
