+                "generated_value_range": [0.0, 4.0],
+                "cases": cases,
+            },
+            indent=2,
+            sort_keys=True,
+        )
+        + "\n",
+        encoding="utf-8",
+    )
+
+    mismatches = []
+    checked_values = 0
+    for case in cases:
+        grades = case["grades"]
+        assert isinstance(grades, list)
+        expected = canonical(grades)
+        actual = generated(grades)
