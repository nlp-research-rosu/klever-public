COMMAND: bash -lc $'\nset +e\nprintf "REFERENCE TREE\\n"\nfind /reference -maxdepth 3 -printf "%y %p -> %l\\\\n" | sort\nprintf "CANDIDATE REQUIRED ARTIFACTS\\n"\nfor f in run-input.json metrics.json codex-last.txt codex-output.log prompt.py py2mpy.py semantic.k solution.py solution.mpy spec.k verification.k prove.sh; do\n  if [[ -L /candidate/$f ]]; then printf "SYMLINK %s -> %s\\n" "$f" "$(readlink -- /candidate/$f)"; elif [[ -f /candidate/$f ]]; then printf "REGULAR %s\\n" "$f"; elif [[ -e /candidate/$f ]]; then printf "MISTYPED %s\\n" "$f"; else printf "MISSING %s\\n" "$f"; fi\ndone\nprintf "STRUCTURED TRACES\\n"\nfind /candidate/codex-trace -type f -printf "%y %p -> %l\\\\n" | sort\nprintf "REFERENCE-SEMANTICS BOUNDARY\\n"\nif [[ -e /reference/reference-semantics || -L /reference/reference-semantics ]]; then printf "BREACH present\\n"; else printf "OK absent\\n"; fi\nprintf "PROMPT COMPARISON\\n"\ncmp -- /candidate/prompt.py /reference/prompt.py\nprintf "prompt cmp status=%d\\n" "$?"\nprintf "TRANSLATOR COMPARISON\\n"\ncmp -- /candidate/py2mpy.py /reference/py2mpy.py\nprintf "translator cmp status=%d\\n" "$?"\nprintf "SOURCE HASHES\\n"\nsha256sum /reference/canonical.py /reference/prompt.py /reference/py2mpy.py /candidate/prompt.py /candidate/py2mpy.py /candidate/semantic.k /candidate/solution.py /candidate/solution.mpy /candidate/spec.k /candidate/verification.k /candidate/prove.sh\nprintf "SCRATCH SOURCE HASHES\\n"\nsha256sum /tmp/audit-work/reference/* /tmp/audit-work/candidate-src/*\nexit 0\n'
