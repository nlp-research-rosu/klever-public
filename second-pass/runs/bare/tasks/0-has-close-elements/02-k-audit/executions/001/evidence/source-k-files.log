     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // The two examples from prompt.py, represented as exact decimal rationals.
     7	  claim <k> verify(
     8	                  VList(VRat(10, 10), VRat(20, 10), VRat(30, 10)),
     9	                  VRat(5, 10)) => VBool(false) </k>
    10	
    11	  claim <k> verify(
    12	                  VList(VRat(10, 10), VRat(28, 10), VRat(30, 10),
    13	                        VRat(40, 10), VRat(50, 10), VRat(20, 10)),
    14	                  VRat(3, 10)) => VBool(true) </k>
    15	
    16	  // Boundary behavior: no pair in lists of size zero or one.
    17	  claim <k> verify(VList(.PValues), VInt(_T)) => VBool(false) </k>
    18	
    19	  claim <k> verify(VList(VInt(_X)), VInt(_T)) => VBool(false) </k>
    20	
    21	  // A symbolic pair establishes strictness: equality with the threshold is
    22	  // false, and the result for arbitrary integers is exactly |x-y| < t.
    23	  claim <k> verify(VList(VInt(X), VInt(Y)), VInt(T))
    24	             => VBool(absInt(X -Int Y) <Int T) </k>
    25	
    26	  // For arbitrary values, the interpreter agrees with the independently
    27	  // recursive existential-pair specification.  Length four exercises all six
    28	  // pair positions as well as both source-level recursive functions.
    29	  claim <k> verify(VList(VInt(X), VInt(Y), VInt(Z)), VInt(T))
    30	             => VBool(hasCloseRef(
    31	                  VList(VInt(X), VInt(Y), VInt(Z)), VInt(T)))
    32	        </k>
    33	
    34	  claim <k> verify(VList(VInt(W), VInt(X), VInt(Y), VInt(Z)), VInt(T))
    35	             => VBool(hasCloseRef(
    36	                  VList(VInt(W), VInt(X), VInt(Y), VInt(Z)), VInt(T)))
    37	        </k>
    38	
    39	  // Concrete strict-boundary checks.
    40	  claim <k> verify(VList(VRat(10, 10), VRat(15, 10)),
    41	                  VRat(5, 10)) => VBool(false) </k>
    42	
    43	  claim <k> verify(VList(VRat(10, 10), VRat(15, 10)),
    44	                  VRat(5000001, 10000000)) => VBool(true) </k>
    45	endmodule
