     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // A closed K term for the exact AST emitted in solution.mpy.  Keeping this
     7	  // in the verification layer lets claims quantify only over input values.
     8	  syntax Pgm ::= "solutionProgram" [function]
     9	  rule solutionProgram =>
    10	    Module(
    11	      ImportFrom("typing", "List")
    12	      FuncDef("close_to_first", Params("first", "rest", "threshold"),
    13	        If(Compare(Call(Name("len"), Name("rest")), CmpOp("==", Int(0))),
    14	          Return(Bool(false)),
    15	          .Stmts)
    16	        If(Compare(
    17	          Call(
    18	            Name("abs"),
    19	            BinOp("-", Name("first"), Subscript(Name("rest"), Int(0)))),
    20	          CmpOp("<", Name("threshold"))),
    21	          Return(Bool(true)),
    22	          .Stmts)
    23	        Return(
    24	          Call(
    25	            Name("close_to_first"),
    26	            Name("first"),
    27	            Subscript(Name("rest"), Slice(Int(1), NoBound, NoBound)),
    28	            Name("threshold"))))
    29	      FuncDef("has_close_elements", Params("numbers", "threshold"),
    30	        If(Compare(Call(Name("len"), Name("numbers")), CmpOp("<", Int(2))),
    31	          Return(Bool(false)),
    32	          .Stmts)
    33	        If(Call(
    34	          Name("close_to_first"),
    35	          Subscript(Name("numbers"), Int(0)),
    36	          Subscript(Name("numbers"), Slice(Int(1), NoBound, NoBound)),
    37	          Name("threshold")),
    38	          Return(Bool(true)),
    39	          .Stmts)
    40	        Return(
    41	          Call(
    42	            Name("has_close_elements"),
    43	            Subscript(Name("numbers"), Slice(Int(1), NoBound, NoBound)),
    44	            Name("threshold")))))
    45	
    46	  syntax Map ::= "solutionFunctions" [function]
    47	               | functionsOf(Pgm) [function]
    48	  rule solutionFunctions => functionsOf(solutionProgram)
    49	  rule functionsOf(Module(SS)) => collect(SS)
    50	  rule <k> verify(ARGS) => call("has_close_elements", ARGS, solutionFunctions) ... </k>
    51	
    52	  // Independent mathematical specification: a pair exists if the head is
    53	  // close to some tail element, or a pair exists wholly within the tail.
    54	  syntax Bool ::= closePair(PVal, PVal, PVal) [function]
    55	                | closeFirstRef(PVal, PVal, PVal) [function]
    56	                | hasCloseRef(PVal, PVal) [function]
    57	                | boolOf(PVal) [function]
    58	
    59	  rule boolOf(VBool(B)) => B
    60	  rule closePair(X, Y, T)
    61	    => boolOf(compareValue("<", absValue(subValue(X, Y)), T))
    62	
    63	  rule closeFirstRef(_, VList(.PValues), _) => false
    64	  rule closeFirstRef(X, VList(Y, REST), T)
    65	    => closePair(X, Y, T) orBool closeFirstRef(X, VList(REST), T)
    66	
    67	  rule hasCloseRef(VList(.PValues), _) => false
    68	  rule hasCloseRef(VList(_X), _) => false
    69	  rule hasCloseRef(VList(X, Y, REST), T)
    70	    => closeFirstRef(X, VList(Y, REST), T)
    71	       orBool hasCloseRef(VList(Y, REST), T)
    72	endmodule
