+done
+
+echo
+echo "IMPORTS AND REQUIRED FILES"
+rg -n '^[[:space:]]*(requires|imports)' "${files[@]}"
+
+echo
+echo "LOCAL K SOURCE INVENTORY"
+find /tmp/audit-work/source -maxdepth 1 -type f \
+  \( -name '*.k' -o -name '*.mpy' -o -name '*.py' \) \
+  -printf '%f\n' | sort

exec
/bin/bash -lc 'cp /audit-output/evidence/spec-vacuity.k /tmp/audit-work/source/spec-vacuity.k && /audit-output/evidence/run_logged.sh /audit-output/evidence/stage6-vacuity-dry-run.log kprove spec-vacuity.k --definition /tmp/audit-work/build/verification-kompiled --spec-module SPEC-VACUITY-AUDIT --dry-run' in /tmp/audit-work/source
