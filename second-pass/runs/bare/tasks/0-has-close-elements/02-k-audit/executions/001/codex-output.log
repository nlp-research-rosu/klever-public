+rg -n '^[[:space:]]*(requires|imports)' "${files[@]}"
+
+echo
+echo "LOCAL K SOURCE INVENTORY"
+find /tmp/audit-work/source -maxdepth 1 -type f \
+  \( -name '*.k' -o -name '*.mpy' -o -name '*.py' \) \
+  -printf '%f\n' | sort

exec
