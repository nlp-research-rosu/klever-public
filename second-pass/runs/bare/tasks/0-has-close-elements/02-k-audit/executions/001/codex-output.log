+echo
+echo "LOCAL K SOURCE INVENTORY"
+find /tmp/audit-work/source -maxdepth 1 -type f \
+  \( -name '*.k' -o -name '*.mpy' -o -name '*.py' \) \
+  -printf '%f\n' | sort

exec
/bin/bash -lc '/audit-output/evidence/run_logged.sh /audit-output/evidence/stage3-concrete-python-oracle.log python3 /audit-output/evidence/concrete_oracle.py && /audit-output/evidence/run_concrete_cases.sh' in /tmp/audit-work/source
