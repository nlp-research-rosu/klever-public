+  /tmp/audit-work/source/verification.k
+  /tmp/audit-work/source/spec.k
+)
+
+echo "DECLARATIONS, CONFIGURATION, RULES, AND CLAIMS"
+rg -n '^[[:space:]]*(syntax|configuration|rule|claim)' "${files[@]}"
+
