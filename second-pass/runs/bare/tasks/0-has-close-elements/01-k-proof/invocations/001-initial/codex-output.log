+                | "Float" "(" Float ")"
+                | "Bool" "(" Bool ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Subscript" "(" Expr "," Index ")"
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports BOOL
+  imports INT
+  imports K-EQUAL
+  imports MAP
+  imports STRING
