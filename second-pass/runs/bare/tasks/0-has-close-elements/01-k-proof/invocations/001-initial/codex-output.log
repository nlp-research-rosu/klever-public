new file mode 100644
index 0000000000000000000000000000000000000000..4391d231f9f2f79b0ad246c76df1bbe566d339f8
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,38 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The two examples from prompt.py, represented as exact decimal rationals.
+  claim <k> init(solutionProgram,
+                  VList(VRat(10, 10), VRat(20, 10), VRat(30, 10)),
+                  VRat(5, 10)) </k>
+     => <k> VBool(false) </k>
+
+  claim <k> init(solutionProgram,
+                  VList(VRat(10, 10), VRat(28, 10), VRat(30, 10),
+                        VRat(40, 10), VRat(50, 10), VRat(20, 10)),
+                  VRat(3, 10)) </k>
+     => <k> VBool(true) </k>
+
+  // Boundary behavior: no pair in lists of size zero or one.
+  claim <k> init(solutionProgram, VList(.PValues), VInt(T)) </k>
+     => <k> VBool(false) </k>
+
+  claim <k> init(solutionProgram, VList(VInt(X)), VInt(T)) </k>
+     => <k> VBool(false) </k>
+
+  // A symbolic pair establishes strictness: equality with the threshold is
+  // false, and the result for arbitrary integers is exactly |x-y| < t.
+  claim <k> init(solutionProgram, VList(VInt(X), VInt(Y)), VInt(T)) </k>
+     => <k> VBool(absInt(X -Int Y) <Int T) </k>
+
+  // Concrete strict-boundary checks.
+  claim <k> init(solutionProgram, VList(VRat(10, 10), VRat(15, 10)),
+                  VRat(5, 10)) </k>
+     => <k> VBool(false) </k>
+
+  claim <k> init(solutionProgram, VList(VRat(10, 10), VRat(15, 10)),
+                  VRat(5000001, 10000000)) </k>
+     => <k> VBool(true) </k>
+endmodule
