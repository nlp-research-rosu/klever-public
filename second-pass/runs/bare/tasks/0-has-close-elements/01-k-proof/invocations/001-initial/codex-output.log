+  rule compareValue("<", VRat(A, B), VInt(I))
+    => VBool(A <Int I *Int B)
+    requires B >Int 0
+  rule compareValue("<", VInt(I), VRat(A, B))
+    => VBool(I *Int B <Int A)
+    requires B >Int 0
+endmodule
