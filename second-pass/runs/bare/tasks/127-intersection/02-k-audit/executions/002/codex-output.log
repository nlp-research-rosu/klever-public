+   || [ "${loop_build_status}" -ne 0 ] \
+   || [ "${loop_proof_status}" -ne 0 ] \
+   || [ "${loop_top_count}" != "1" ] \
+   || [ "${whole_build_status}" -ne 0 ] \
+   || [ "${whole_proof_status}" -ne 0 ] \
+   || [ "${whole_top_count}" != "1" ]; then
+  exit 1
+fi

