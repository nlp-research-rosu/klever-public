+  --syntax-module MPY-SYNTAX \
+  --backend haskell \
+  --output-definition "${loop_definition}" \
+  > "${evidence_dir}/kompile-loop.log" 2>&1
+loop_build_status=$?
+echo "EXIT: ${loop_build_status}"
+sed -n '1,180p' "${evidence_dir}/kompile-loop.log"
