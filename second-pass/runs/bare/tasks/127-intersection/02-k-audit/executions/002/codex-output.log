+#!/usr/bin/env bash
+set -u
+
+source_dir=/tmp/audit-work/candidate-src
+concrete_definition=/tmp/audit-work/build-concrete/semantic-kompiled
+loop_definition=/tmp/audit-work/build-proof/loop-kompiled
