+  --spec-module LOOP-CORRECTNESS-SPEC \
+  --output pretty \
+  > "${evidence_dir}/kprove-loop.log" 2>&1
+loop_proof_status=$?
+loop_top_count=$(rg -c '^#Top$' "${evidence_dir}/kprove-loop.log" || true)
