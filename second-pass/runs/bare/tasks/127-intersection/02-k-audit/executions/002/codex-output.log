+   || [ "${bridge_top_count}" != "1" ] \
+   || [ "${body_definition_generation_status}" -ne 0 ] \
+   || [ "${body_spec_generation_status}" -ne 0 ] \
+   || [ "${body_build_status}" -ne 0 ] \
