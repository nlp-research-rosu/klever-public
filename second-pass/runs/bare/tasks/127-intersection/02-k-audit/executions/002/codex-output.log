+
+cd /tmp/audit-work/candidate-src || exit 90
+
+echo 'COMMAND: python3 /tmp/audit-work/reference/py2mpy.py solution.py > regenerated.mpy'
+python3 /tmp/audit-work/reference/py2mpy.py solution.py > regenerated.mpy
+regen_status=$?
