/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import os,stat,hashlib,itertools
TARGET='753cb58c1c707a5890fc610413d95d9e06ad2d4009cb869977253006bfa196fc'
root=Path('/candidate')
ents=[]
for p in sorted(root.rglob('*')):
    typ='d' if p.is_dir() else 'f'
    ents.append((p.relative_to(root).as_posix(),typ,p))
path_encs={
 'raw':lambda r:r.encode(), 'nul':lambda r:r.encode()+b'\\0','nl':lambda r:r.encode()+b'\\n',
 'len4raw':lambda r:len(r.encode()).to_bytes(4,'big')+r.encode(),
 'dotraw':lambda r:('./'+r).encode(), 'dotnul':lambda r:('./'+r).encode()+b'\\0'}
kind_encs={'none':lambda k:b'', 'shortnul':lambda k:k.encode()+b'\\0', 'longnul':lambda k:('file' if k=='f' else 'directory').encode()+b'\\0', 'short':lambda k:k.encode(), 'long':lambda k:('file' if k=='f' else 'directory').encode(), 'mode':lambda k:(b'100644\\0' if k=='f' else b'040755\\0')}
content_encs={
 'raw':lambda p:p.read_bytes(),
 'shahex':lambda p:hashlib.sha256(p.read_bytes()).hexdigest().encode(),
 'shahexnl':lambda p:hashlib.sha256(p.read_bytes()).hexdigest().encode()+b'\\n',
 'shabin':lambda p:hashlib.sha256(p.read_bytes()).digest(),
 'size8raw':lambda p:p.stat().st_size.to_bytes(8,'big')+p.read_bytes(),
 'sizedecraw':lambda p:str(p.stat().st_size).encode()+p.read_bytes(),
 'nulraw':lambda p:b'\\0'+p.read_bytes(),
}
for incdirs,pe,ke,ce,order,entrysep in itertools.product([False,True],path_encs,kind_encs,content_encs,['pk','kp'],[b'',b'\\0',b'\\n']):
 h=hashlib.sha256()
 for r,k,p in ents:
  if k=='d' and not incdirs: continue
  a=path_encs[pe](r); b=kind_encs[ke](k)
  h.update(a+b if order=='pk' else b+a)
  if k=='f':h.update(content_encs[ce](p))
  h.update(entrysep)
 if h.hexdigest()==TARGET:
  print('FOUND',incdirs,pe,ke,ce,order,repr(entrysep));break
else: print('not found')
PY" in /audit-output
