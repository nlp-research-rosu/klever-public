+whole_proof_status=$?
+whole_top_count=$(rg -c '^#Top$' "${evidence_dir}/kprove-whole.log" || true)
+echo "EXIT: ${whole_proof_status}"
+echo "TOP_COUNT: ${whole_top_count}"
+sed -n '1,220p' "${evidence_dir}/kprove-whole.log"
