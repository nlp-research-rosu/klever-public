+cmp_status=$?
+echo "EXIT: ${cmp_status}"
+
+echo 'COMMAND: sha256sum regenerated.mpy solution.mpy'
+sha256sum regenerated.mpy solution.mpy
+hash_status=$?
+echo "EXIT: ${hash_status}"
