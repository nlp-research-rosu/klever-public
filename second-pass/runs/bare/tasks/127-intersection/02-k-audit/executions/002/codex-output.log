+if [ "${concrete_build_status}" -ne 0 ] \
+   || [ "${semantics_status}" -ne 0 ] \
+   || [ "${loop_build_status}" -ne 0 ] \
+   || [ "${loop_proof_status}" -ne 0 ] \
