+              CmpOp("==", Int(0))),
+              Return(Str("NO")),
+              .Stmts)
+            Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
+          ~> (Return(Str("YES")) .Stmts)
+          => strVal("YES")
+        </k>
+        <env>
+          "length" |-> intVal(5)
+          "divisor" |-> intVal(2)
+        </env>
+endmodule
