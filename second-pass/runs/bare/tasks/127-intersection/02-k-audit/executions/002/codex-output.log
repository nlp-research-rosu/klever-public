     7	    Your task is to determine whether the length of intersection of these two
     8	    intervals is a prime number.
     9	    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)
    10	    which its length is 1, which not a prime number.
    11	    If the length of the intersection is a prime number, return "YES",
    12	    otherwise, return "NO".
    13	    If the two intervals don't intersect, return "NO".
    14	
    15	
    16	    [input/output] samples:
    17	    intersection((1, 2), (2, 3)) ==> "NO"
    18	    intersection((-1, 1), (0, 4)) ==> "NO"
    19	    intersection((-3, 9), (-1, 4)) ==> "YES"
    20	    """
    21	    def is_prime(num):
    22	        if num == 1 or num == 0:
    23	            return False
    24	        if num == 2:
    25	            return True
    26	        for i in range(2, num):
    27	            if num%i == 0:
    28	                return False
    29	        return True
    30	
    31	    l = max(interval1[0], interval2[0])
    32	    r = min(interval1[1], interval2[1])
    33	    length = r - l
    34	    if length > 0 and is_prime(length):
    35	        return "YES"
    36	    return "NO"
--- candidate solution.py ---
     1	def intersection(interval1, interval2):
     2	    left = interval1[0]
     3	    if interval2[0] > left:
     4	        left = interval2[0]
     5	
     6	    right = interval1[1]
     7	    if interval2[1] < right:
     8	        right = interval2[1]
     9	
    10	    length = right - left
    11	    if length < 2:
    12	        return "NO"
    13	
    14	    divisor = 2
    15	    while divisor * divisor <= length:
    16	        if length % divisor == 0:
    17	            return "NO"
    18	        divisor = divisor + 1
    19	
    20	    return "YES"
--- candidate solution.mpy ---
     1	Module(
     2	  FuncDef("intersection", Params("interval1", "interval2"),
     3	    Assign(Name("left"), Subscript(Name("interval1"), Int(0)))
     4	    If(Compare(
     5	      Subscript(Name("interval2"), Int(0)),
     6	      CmpOp(">", Name("left"))),
     7	      Assign(Name("left"), Subscript(Name("interval2"), Int(0))),
     8	      )
     9	    Assign(Name("right"), Subscript(Name("interval1"), Int(1)))
    10	    If(Compare(
    11	      Subscript(Name("interval2"), Int(1)),
    12	      CmpOp("<", Name("right"))),
    13	      Assign(Name("right"), Subscript(Name("interval2"), Int(1))),
    14	      )
    15	    Assign(Name("length"), BinOp("-", Name("right"), Name("left")))
    16	    If(Compare(Name("length"), CmpOp("<", Int(2))),
    17	      Return(Str("NO")),
    18	      )
    19	    Assign(Name("divisor"), Int(2))
    20	    While(Compare(
    21	      BinOp("*", Name("divisor"), Name("divisor")),
    22	      CmpOp("<=", Name("length"))),
    23	      If(Compare(
    24	        BinOp("%", Name("length"), Name("divisor")),
    25	        CmpOp("==", Int(0))),
    26	        Return(Str("NO")),
    27	        )
    28	      Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
    29	    Return(Str("YES"))))
