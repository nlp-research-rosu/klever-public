+  claim <k>
+          While(Compare(
+            BinOp("*", Name("divisor"), Name("divisor")),
+            CmpOp("<=", Name("length"))),
+            If(Compare(
+              BinOp("%", Name("length"), Name("divisor")),
+              CmpOp("==", Int(0))),
+              Return(Str("NO")),
+              .Stmts)
