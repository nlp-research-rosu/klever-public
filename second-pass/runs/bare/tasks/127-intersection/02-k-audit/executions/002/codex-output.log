+  --syntax-module MPY-SYNTAX \
+  --backend llvm \
+  --output-definition "${concrete_definition}" \
+  > "${evidence_dir}/kompile-concrete.log" 2>&1
+concrete_build_status=$?
+echo "EXIT: ${concrete_build_status}"
