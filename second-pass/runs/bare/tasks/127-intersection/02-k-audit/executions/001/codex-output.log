/bin/bash -lc 'cp -p /audit-output/evidence/bridge-state-witness.k /audit-output/evidence/spec-no-bridge.k /tmp/audit-work/127-intersection/run/ && /audit-output/evidence/run_logged.sh /audit-output/evidence/stage5-bridge-fixed-correct.log kprove bridge-state-witness.k --definition loop-fresh-kompiled --spec-module BRIDGE-STATE-FIXED-CORRECT --output pretty' in /tmp/audit-work/127-intersection/run
