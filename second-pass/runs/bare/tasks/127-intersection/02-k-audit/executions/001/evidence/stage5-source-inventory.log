     3	// Mathematical reference layer used by the proof.  primeResult(N,D) is the
     4	// trial-division definition of primality from candidate divisor D onward.
     5	// For D = 2 and N >= 2 it is "YES" exactly when N is prime: if D*D > N no
     6	// factor can remain; otherwise D is tested and the search advances.
     7	module VERIFICATION
     8	  imports MPY
     9	
    10	  syntax Value ::= "primeResult" "(" Int "," Int ")" [function]
    11	  rule primeResult(N, D) => strVal("YES")
    12	       requires D *Int D >Int N
    13	  rule primeResult(N, D) => strVal("NO")
    14	       requires D *Int D <=Int N andBool N %Int D ==Int 0
    15	  rule primeResult(N, D) => primeResult(N, D +Int 1)
    16	       requires D *Int D <=Int N andBool N %Int D =/=Int 0
    17	
    18	  syntax Value ::= "intersectionResult" "(" Int "," Int "," Int "," Int ")"
    19	                   [function]
    20	  rule intersectionResult(A, B, C, D) => strVal("NO")
    21	       requires minInt(B, D) -Int maxInt(A, C) <Int 2
    22	  rule intersectionResult(A, B, C, D)
    23	       => primeResult(minInt(B, D) -Int maxInt(A, C), 2)
    24	       requires minInt(B, D) -Int maxInt(A, C) >=Int 2
    25	
    26	  syntax Value ::= "lengthResult" "(" Int ")" [function]
    27	  rule lengthResult(N) => strVal("NO") requires N <Int 2
    28	  rule lengthResult(N) => primeResult(N, 2) requires N >=Int 2
    29	
    30	  // This is the exact constructor tree generated in solution.mpy.  Keeping it
    31	  // as one named function makes the claims readable while still making their
    32	  // subject syntactically precise.
    33	  syntax Program ::= "solutionProgram" [function]
    34	  rule solutionProgram =>
    35	    Module(
    36	      FuncDef("intersection", Params("interval1", "interval2"),
    37	        Assign(Name("left"), Subscript(Name("interval1"), Int(0)))
    38	        If(Compare(
    39	          Subscript(Name("interval2"), Int(0)),
    40	          CmpOp(">", Name("left"))),
    41	          Assign(Name("left"), Subscript(Name("interval2"), Int(0))),
    42	          .Stmts)
    43	        Assign(Name("right"), Subscript(Name("interval1"), Int(1)))
    44	        If(Compare(
    45	          Subscript(Name("interval2"), Int(1)),
    46	          CmpOp("<", Name("right"))),
    47	          Assign(Name("right"), Subscript(Name("interval2"), Int(1))),
    48	          .Stmts)
    49	        Assign(Name("length"), BinOp("-", Name("right"), Name("left")))
    50	        If(Compare(Name("length"), CmpOp("<", Int(2))),
    51	          Return(Str("NO")),
    52	          .Stmts)
    53	        Assign(Name("divisor"), Int(2))
    54	        While(Compare(
    55	          BinOp("*", Name("divisor"), Name("divisor")),
    56	          CmpOp("<=", Name("length"))),
    57	          If(Compare(
    58	            BinOp("%", Name("length"), Name("divisor")),
    59	            CmpOp("==", Int(0))),
    60	            Return(Str("NO")),
    61	            .Stmts)
    62	          Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
    63	        Return(Str("YES"))))
    64	endmodule
    65	
    66	// After LOOP-CORRECTNESS-SPEC proves this same reachability fact from the
    67	// small-step rules, the whole-program proof imports it here as a proof lemma.
    68	module VERIFICATION-WITH-LOOP-LEMMA
    69	  imports VERIFICATION
    70	
    71	  rule <k>
    72	         While(Compare(
    73	           BinOp("*", Name("divisor"), Name("divisor")),
    74	           CmpOp("<=", Name("length"))),
    75	           If(Compare(
    76	             BinOp("%", Name("length"), Name("divisor")),
    77	             CmpOp("==", Int(0))),
    78	             Return(Str("NO")),
    79	             .Stmts)
    80	           Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
    81	         ~> (Return(Str("YES")) .Stmts)
    82	         => primeResult(N, D)
    83	       </k>
    84	       <env>...
    85	         "length" |-> intVal(N)
    86	         "divisor" |-> intVal(D)
    87	       ...</env>
    88	       requires N >=Int 2 andBool D >=Int 2
    89	       [priority(40)]
    90	endmodule
