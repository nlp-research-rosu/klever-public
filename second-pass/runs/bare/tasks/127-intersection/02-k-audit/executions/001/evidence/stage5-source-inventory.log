     3	module MPY-SYNTAX
     4	  imports INT-SYNTAX
     5	  imports BOOL-SYNTAX
     6	  imports STRING-SYNTAX
     7	
     8	  syntax Program ::= "Module" "(" Stmts ")" [symbol(module)]
     9	
    10	  syntax Stmts ::= List{Stmt, ""}
    11	  syntax Params ::= "Params" "(" String "," String ")" [symbol(params)]
    12	
    13	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol(funcDef)]
    14	                | "Assign" "(" Expr "," Expr ")"                 [symbol(assign)]
    15	                | "If" "(" Expr "," Stmts "," Stmts ")"       [symbol(ifStmt)]
    16	                | "While" "(" Expr "," Stmts ")"               [symbol(whileStmt)]
    17	                | "Return" "(" Expr ")"                         [symbol(returnStmt)]
    18	
    19	  syntax Cmp ::= "CmpOp" "(" String "," Expr ")" [symbol(cmpOp)]
    20	
    21	  syntax Expr ::= "Int" "(" Int ")"                         [symbol(intExpr)]
    22	                | "Str" "(" String ")"                      [symbol(strExpr)]
    23	                | "Name" "(" String ")"                     [symbol(nameExpr)]
    24	                | "TupleExpr" "(" Expr "," Expr ")"        [symbol(tupleExpr)]
    25	                | "Subscript" "(" Expr "," Expr ")"        [symbol(subscript)]
    26	                | "BinOp" "(" String "," Expr "," Expr ")" [symbol(binOp)]
    27	                | "Compare" "(" Expr "," Cmp ")"            [symbol(compare)]
    28	endmodule
