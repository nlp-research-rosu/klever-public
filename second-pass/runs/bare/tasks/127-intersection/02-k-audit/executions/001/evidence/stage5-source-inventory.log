     3	// Inductive proof of the proof lemma used by the whole-program claim.  The
     4	// recursive primeResult reference takes exactly the same three branches as
     5	// one concrete execution of the While: exhausted search, found factor, or
     6	// advance divisor.  The third branch closes by circularity after progress.
     7	module LOOP-CORRECTNESS-SPEC
     8	  imports VERIFICATION
     9	
    10	  claim <k>
    11	          While(Compare(
    12	            BinOp("*", Name("divisor"), Name("divisor")),
    13	            CmpOp("<=", Name("length"))),
    14	            If(Compare(
    15	              BinOp("%", Name("length"), Name("divisor")),
    16	              CmpOp("==", Int(0))),
    17	              Return(Str("NO")),
    18	              .Stmts)
    19	            Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
    20	          ~> (Return(Str("YES")) .Stmts)
    21	          => primeResult(N, D)
    22	        </k>
    23	        <env> _RHO:Map
    24	          "length" |-> intVal(N)
    25	          "divisor" |-> (intVal(D) => ?_VD:Value)
    26	        </env>
    27	        requires N >=Int 2 andBool D >=Int 2
    28	endmodule
    29	
    30	// Universal correctness for all integer endpoints satisfying the prompt's
    31	// interval precondition.  These four claims are the exhaustive choices for
    32	// max(start1,start2) and min(end1,end2); together their right sides are exactly
    33	// lengthResult(min(B,D)-max(A,C)).
    34	module SPEC
    35	  imports VERIFICATION-WITH-LOOP-LEMMA
    36	
    37	  claim <mpy>
    38	          <k>
    39	            solutionProgram
    40	            ~> runWith(
    41	                 TupleExpr(Int(A), Int(B)),
    42	                 TupleExpr(Int(C), Int(D)))
    43	            => lengthResult(B -Int A)
    44	          </k>
    45	          <functions> .Map => ?_FUNCTIONS:Map </functions>
    46	          <env> .Map => ?_ENV:Map </env>
    47	        </mpy>
    48	        requires A <=Int B andBool C <=Int D
    49	          andBool C <=Int A andBool D >=Int B
    50	
    51	  claim <mpy>
    52	          <k>
    53	            solutionProgram
    54	            ~> runWith(
    55	                 TupleExpr(Int(A), Int(B)),
    56	                 TupleExpr(Int(C), Int(D)))
    57	            => lengthResult(D -Int A)
    58	          </k>
    59	          <functions> .Map => ?_FUNCTIONS:Map </functions>
    60	          <env> .Map => ?_ENV:Map </env>
    61	        </mpy>
    62	        requires A <=Int B andBool C <=Int D
    63	          andBool C <=Int A andBool D <Int B
    64	
    65	  claim <mpy>
    66	          <k>
    67	            solutionProgram
    68	            ~> runWith(
    69	                 TupleExpr(Int(A), Int(B)),
    70	                 TupleExpr(Int(C), Int(D)))
    71	            => lengthResult(B -Int C)
    72	          </k>
    73	          <functions> .Map => ?_FUNCTIONS:Map </functions>
    74	          <env> .Map => ?_ENV:Map </env>
    75	        </mpy>
    76	        requires A <=Int B andBool C <=Int D
    77	          andBool C >Int A andBool D >=Int B
    78	
    79	  claim <mpy>
    80	          <k>
    81	            solutionProgram
    82	            ~> runWith(
    83	                 TupleExpr(Int(A), Int(B)),
    84	                 TupleExpr(Int(C), Int(D)))
    85	            => lengthResult(D -Int C)
    86	          </k>
    87	          <functions> .Map => ?_FUNCTIONS:Map </functions>
    88	          <env> .Map => ?_ENV:Map </env>
    89	        </mpy>
    90	        requires A <=Int B andBool C <=Int D
    91	          andBool C >Int A andBool D <Int B
    92	endmodule
