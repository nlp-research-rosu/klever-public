    30	module MPY
    31	  imports MPY-SYNTAX
    32	  imports INT
    33	  imports BOOL
    34	  imports STRING
    35	  imports MAP
    36	
    37	  syntax Value ::= "intVal" "(" Int ")"
    38	                 | "strVal" "(" String ")"
    39	                 | "boolVal" "(" Bool ")"
    40	                 | "tupleVal" "(" Value "," Value ")"
    41	                 | "unbound"
    42	  syntax Expr ::= Value
    43	  syntax KResult ::= Value
    44	
    45	  syntax Function ::= "function" "(" String "," String "," Stmts ")"
    46	
    47	  syntax KItem ::= Program | Stmt | Stmts | Expr
    48	                 | "runWith" "(" Expr "," Expr ")"
    49	                 | "saveFirstArg" "(" Expr ")"
    50	                 | "saveSecondArg" "(" Value ")"
    51	                 | "invoke" "(" String "," Value "," Value ")"
    52	                 | "assignTo" "(" String ")"
    53	                 | "choose" "(" Stmts "," Stmts ")"
    54	                 | "loopGuard" "(" Expr "," Stmts ")"
    55	                 | "functionReturn"
    56	
    57	  configuration
    58	    <mpy>
    59	      <k> $PGM:Program ~> runWith($INTERVAL1:Expr, $INTERVAL2:Expr) </k>
    60	      <functions> .Map </functions>
    61	      <env> .Map </env>
    62	    </mpy>
    63	
    64	  // Module loading and entry-point invocation.
    65	  rule <k> Module(S) => S ...</k>
    66	  rule <k> .Stmts => .K ...</k>
    67	  rule <k> (S:Stmt SS:Stmts) => S ~> SS ...</k>
    68	
    69	  rule <k> FuncDef(F, Params(P1, P2), BODY) => .K ...</k>
    70	       <functions> .Map => F |-> function(P1, P2, BODY) </functions>
    71	
    72	  rule <k> runWith(A, B) => A ~> saveFirstArg(B) ...</k>
    73	  rule <k> V:Value ~> saveFirstArg(B) => B ~> saveSecondArg(V) ...</k>
    74	  rule <k> V2:Value ~> saveSecondArg(V1) => invoke("intersection", V1, V2) ...</k>
    75	
    76	  rule <k> invoke(F, V1, V2) => BODY ...</k>
    77	       <functions> F |-> function(P1, P2, BODY) </functions>
    78	       <env> _ =>
    79	         P1 |-> V1
    80	         P2 |-> V2
    81	         "left"    |-> unbound
    82	         "right"   |-> unbound
    83	         "length"  |-> unbound
    84	         "divisor" |-> unbound
    85	       </env>
    86	
    87	  // Statement execution.
    88	  rule <k> Assign(Name(X), E) => E ~> assignTo(X) ...</k>
    89	  rule <k> V:Value ~> assignTo(X) => .K ...</k>
    90	       <env>... X |-> (_ => V) ...</env>
    91	
    92	  rule <k> If(COND, THEN, ELSE) => COND ~> choose(THEN, ELSE) ...</k>
    93	  rule <k> boolVal(true)  ~> choose(THEN, _) => THEN ...</k>
    94	  rule <k> boolVal(false) ~> choose(_, ELSE) => ELSE ...</k>
    95	
    96	  rule <k> While(COND, BODY) => COND ~> loopGuard(COND, BODY) ...</k>
    97	  rule <k> boolVal(true)  ~> loopGuard(COND, BODY) => BODY ~> While(COND, BODY) ...</k>
    98	  rule <k> boolVal(false) ~> loopGuard(_, _) => .K ...</k>
    99	
   100	  // A return abandons the rest of the current function body, including a
   101	  // surrounding loop continuation, and leaves the returned Value in <k>.
   102	  rule <k> Return(E) ~> _REST => E ~> functionReturn </k>
   103	  rule <k> V:Value ~> functionReturn => V ...</k>
   104	
   105	  // Expression execution.  Contexts make operands evaluate left-to-right.
   106	  rule <k> Int(I) => intVal(I) ...</k>
   107	  rule <k> Str(S) => strVal(S) ...</k>
   108	  rule <k> Name(X) => V ...</k>
   109	       <env>... X |-> V ...</env>
   110	
   111	  context TupleExpr(HOLE, _)
   112	  context TupleExpr(_V:Value, HOLE)
   113	  rule <k> TupleExpr(V1:Value, V2:Value) => tupleVal(V1, V2) ...</k>
   114	
   115	  context Subscript(HOLE, _)
   116	  context Subscript(_V:Value, HOLE)
   117	  rule <k> Subscript(tupleVal(V0, _), intVal(0)) => V0 ...</k>
   118	  rule <k> Subscript(tupleVal(_, V1), intVal(1)) => V1 ...</k>
   119	
   120	  context BinOp(_, HOLE, _)
   121	  context BinOp(_, _V:Value, HOLE)
   122	  rule <k> BinOp("+", intVal(A), intVal(B)) => intVal(A +Int B) ...</k>
   123	  rule <k> BinOp("-", intVal(A), intVal(B)) => intVal(A -Int B) ...</k>
   124	  rule <k> BinOp("*", intVal(A), intVal(B)) => intVal(A *Int B) ...</k>
   125	  rule <k> BinOp("%", intVal(A), intVal(B)) => intVal(A %Int B) ...</k>
   126	       requires B =/=Int 0
   127	
   128	  rule <k> Compare(A, CmpOp(OP, B)) => compareValues(OP, A, B) ...</k>
   129	  syntax Expr ::= "compareValues" "(" String "," Expr "," Expr ")"
   130	  context compareValues(_, HOLE, _)
   131	  context compareValues(_, _V:Value, HOLE)
   132	  rule <k> compareValues("<",  intVal(A), intVal(B)) => boolVal(A <Int B) ...</k>
   133	  rule <k> compareValues("<=", intVal(A), intVal(B)) => boolVal(A <=Int B) ...</k>
   134	  rule <k> compareValues(">",  intVal(A), intVal(B)) => boolVal(A >Int B) ...</k>
   135	  rule <k> compareValues("==", intVal(A), intVal(B)) => boolVal(A ==Int B) ...</k>
   136	endmodule
