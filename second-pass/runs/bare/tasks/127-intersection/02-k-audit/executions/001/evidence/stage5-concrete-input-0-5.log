  <functions>
    "intersection" |-> function ( "interval1" , "interval2" , Assign ( Name ( "left" ) , Subscript ( Name ( "interval1" ) , Int ( 0 ) ) )  If ( Compare ( Subscript ( Name ( "interval2" ) , Int ( 0 ) ) , CmpOp ( ">" , Name ( "left" ) ) ) , Assign ( Name ( "left" ) , Subscript ( Name ( "interval2" ) , Int ( 0 ) ) )  .Stmts , .Stmts )  Assign ( Name ( "right" ) , Subscript ( Name ( "interval1" ) , Int ( 1 ) ) )  If ( Compare ( Subscript ( Name ( "interval2" ) , Int ( 1 ) ) , CmpOp ( "<" , Name ( "right" ) ) ) , Assign ( Name ( "right" ) , Subscript ( Name ( "interval2" ) , Int ( 1 ) ) )  .Stmts , .Stmts )  Assign ( Name ( "length" ) , BinOp ( "-" , Name ( "right" ) , Name ( "left" ) ) )  If ( Compare ( Name ( "length" ) , CmpOp ( "<" , Int ( 2 ) ) ) , Return ( Str ( "NO" ) )  .Stmts , .Stmts )  Assign ( Name ( "divisor" ) , Int ( 2 ) )  While ( Compare ( BinOp ( "*" , Name ( "divisor" ) , Name ( "divisor" ) ) , CmpOp ( "<=" , Name ( "length" ) ) ) , If ( Compare ( BinOp ( "%" , Name ( "length" ) , Name ( "divisor" ) ) , CmpOp ( "==" , Int ( 0 ) ) ) , Return ( Str ( "NO" ) )  .Stmts , .Stmts )  Assign ( Name ( "divisor" ) , BinOp ( "+" , Name ( "divisor" ) , Int ( 1 ) ) )  .Stmts )  Return ( Str ( "YES" ) )  .Stmts )
