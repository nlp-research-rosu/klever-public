+                | "Assign" "(" Expr "," Expr ")"                 [symbol(assign)]
+                | "If" "(" Expr "," Stmts "," Stmts ")"       [symbol(ifStmt)]
+                | "While" "(" Expr "," Stmts ")"               [symbol(whileStmt)]
