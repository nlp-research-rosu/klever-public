+                | "Str" "(" String ")"                      [symbol(strExpr)]
+                | "Name" "(" String ")"                     [symbol(nameExpr)]
+                | "TupleExpr" "(" Expr "," Expr ")"        [symbol(tupleExpr)]
+                | "Subscript" "(" Expr "," Expr ")"        [symbol(subscript)]
+                | "BinOp" "(" String "," Expr "," Expr ")" [symbol(binOp)]
+                | "Compare" "(" Expr "," Cmp ")"            [symbol(compare)]
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  syntax Value ::= "intVal" "(" Int ")"
+                 | "strVal" "(" String ")"
+                 | "boolVal" "(" Bool ")"
+                 | "tupleVal" "(" Value "," Value ")"
+                 | "unbound"
+  syntax Expr ::= Value
+  syntax KResult ::= Value
+
+  syntax Function ::= "function" "(" String "," String "," Stmts ")"
+
+  syntax KItem ::= Program | Stmt | Stmts | Expr
+                 | "runWith" "(" Expr "," Expr ")"
+                 | "saveFirstArg" "(" Expr ")"
+                 | "saveSecondArg" "(" Value ")"
+                 | "invoke" "(" String "," Value "," Value ")"
+                 | "assignTo" "(" String ")"
+                 | "choose" "(" Stmts "," Stmts ")"
+                 | "loopGuard" "(" Expr "," Stmts ")"
+                 | "functionReturn"
+
+  configuration
+    <mpy>
+      <k> $PGM:Program ~> runWith($INTERVAL1:Expr, $INTERVAL2:Expr) </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+    </mpy>
+
+  // Module loading and entry-point invocation.
+  rule <k> Module(S) => S ...</k>
+  rule <k> .Stmts => .K ...</k>
+  rule <k> (S:Stmt SS:Stmts) => S ~> SS ...</k>
+
+  rule <k> FuncDef(F, Params(P1, P2), BODY) => .K ...</k>
+       <functions> .Map => F |-> function(P1, P2, BODY) </functions>
+
+  rule <k> runWith(A, B) => A ~> saveFirstArg(B) ...</k>
+  rule <k> V:Value ~> saveFirstArg(B) => B ~> saveSecondArg(V) ...</k>
+  rule <k> V2:Value ~> saveSecondArg(V1) => invoke("intersection", V1, V2) ...</k>
+
+  rule <k> invoke(F, V1, V2) => BODY ...</k>
+       <functions> F |-> function(P1, P2, BODY) </functions>
+       <env> _ =>
+         P1 |-> V1
+         P2 |-> V2
+         "left"    |-> unbound
+         "right"   |-> unbound
+         "length"  |-> unbound
+         "divisor" |-> unbound
+       </env>
+
+  // Statement execution.
+  rule <k> Assign(Name(X), E) => E ~> assignTo(X) ...</k>
+  rule <k> V:Value ~> assignTo(X) => .K ...</k>
+       <env>... X |-> (_ => V) ...</env>
+
+  rule <k> If(COND, THEN, ELSE) => COND ~> choose(THEN, ELSE) ...</k>
+  rule <k> boolVal(true)  ~> choose(THEN, _) => THEN ...</k>
+  rule <k> boolVal(false) ~> choose(_, ELSE) => ELSE ...</k>
+
+  rule <k> While(COND, BODY) => COND ~> loopGuard(COND, BODY) ...</k>
+  rule <k> boolVal(true)  ~> loopGuard(COND, BODY) => BODY ~> While(COND, BODY) ...</k>
+  rule <k> boolVal(false) ~> loopGuard(_, _) => .K ...</k>
+
+  // A return abandons the rest of the current function body, including a
+  // surrounding loop continuation, and leaves the returned Value in <k>.
+  rule <k> Return(E) ~> _REST => E ~> functionReturn </k>
+  rule <k> V:Value ~> functionReturn => V ...</k>
+
+  // Expression execution.  Contexts make operands evaluate left-to-right.
+  rule <k> Int(I) => intVal(I) ...</k>
+  rule <k> Str(S) => strVal(S) ...</k>
+  rule <k> Name(X) => V ...</k>
+       <env>... X |-> V ...</env>
+
+  context TupleExpr(HOLE, _)
+  context TupleExpr(_V:Value, HOLE)
+  rule <k> TupleExpr(V1:Value, V2:Value) => tupleVal(V1, V2) ...</k>
+
+  context Subscript(HOLE, _)
+  context Subscript(_V:Value, HOLE)
+  rule <k> Subscript(tupleVal(V0, _), intVal(0)) => V0 ...</k>
+  rule <k> Subscript(tupleVal(_, V1), intVal(1)) => V1 ...</k>
+
+  context BinOp(_, HOLE, _)
+  context BinOp(_, _V:Value, HOLE)
+  rule <k> BinOp("+", intVal(A), intVal(B)) => intVal(A +Int B) ...</k>
+  rule <k> BinOp("-", intVal(A), intVal(B)) => intVal(A -Int B) ...</k>
+  rule <k> BinOp("*", intVal(A), intVal(B)) => intVal(A *Int B) ...</k>
+  rule <k> BinOp("%", intVal(A), intVal(B)) => intVal(A %Int B) ...</k>
+       requires B =/=Int 0
+
+  rule <k> Compare(A, CmpOp(OP, B)) => compareValues(OP, A, B) ...</k>
+  syntax Expr ::= "compareValues" "(" String "," Expr "," Expr ")"
+  context compareValues(_, HOLE, _)
+  context compareValues(_, _V:Value, HOLE)
+  rule <k> compareValues("<",  intVal(A), intVal(B)) => boolVal(A <Int B) ...</k>
+  rule <k> compareValues("<=", intVal(A), intVal(B)) => boolVal(A <=Int B) ...</k>
+  rule <k> compareValues(">",  intVal(A), intVal(B)) => boolVal(A >Int B) ...</k>
+  rule <k> compareValues("==", intVal(A), intVal(B)) => boolVal(A ==Int B) ...</k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..5235131efe3a2a181c342a835f3023af295ccaac
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,20 @@
+def intersection(interval1, interval2):
+    left = interval1[0]
+    if interval2[0] > left:
+        left = interval2[0]
+
+    right = interval1[1]
+    if interval2[1] < right:
+        right = interval2[1]
+
+    length = right - left
+    if length < 2:
+        return "NO"
+
+    divisor = 2
+    while divisor * divisor <= length:
+        if length % divisor == 0:
+            return "NO"
+        divisor = divisor + 1
+
+    return "YES"
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9831bece0cd08433fffc48ea2dc5d3cc7d1e8863
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,92 @@
+requires "verification.k"
+
+// Inductive proof of the proof lemma used by the whole-program claim.  The
+// recursive primeResult reference takes exactly the same three branches as
+// one concrete execution of the While: exhausted search, found factor, or
+// advance divisor.  The third branch closes by circularity after progress.
+module LOOP-CORRECTNESS-SPEC
+  imports VERIFICATION
+
+  claim <k>
+          While(Compare(
+            BinOp("*", Name("divisor"), Name("divisor")),
+            CmpOp("<=", Name("length"))),
+            If(Compare(
+              BinOp("%", Name("length"), Name("divisor")),
+              CmpOp("==", Int(0))),
+              Return(Str("NO")),
+              .Stmts)
+            Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
+          ~> (Return(Str("YES")) .Stmts)
+          => primeResult(N, D)
+        </k>
+        <env> _RHO:Map
+          "length" |-> intVal(N)
+          "divisor" |-> (intVal(D) => ?_VD:Value)
+        </env>
+        requires N >=Int 2 andBool D >=Int 2
+endmodule
+
+// Universal correctness for all integer endpoints satisfying the prompt's
+// interval precondition.  These four claims are the exhaustive choices for
+// max(start1,start2) and min(end1,end2); together their right sides are exactly
+// lengthResult(min(B,D)-max(A,C)).
+module SPEC
+  imports VERIFICATION-WITH-LOOP-LEMMA
+
+  claim <mpy>
+          <k>
+            solutionProgram
+            ~> runWith(
+                 TupleExpr(Int(A), Int(B)),
+                 TupleExpr(Int(C), Int(D)))
+            => lengthResult(B -Int A)
+          </k>
+          <functions> .Map => ?_FUNCTIONS:Map </functions>
+          <env> .Map => ?_ENV:Map </env>
+        </mpy>
+        requires A <=Int B andBool C <=Int D
+          andBool C <=Int A andBool D >=Int B
+
+  claim <mpy>
+          <k>
+            solutionProgram
+            ~> runWith(
+                 TupleExpr(Int(A), Int(B)),
+                 TupleExpr(Int(C), Int(D)))
+            => lengthResult(D -Int A)
+          </k>
+          <functions> .Map => ?_FUNCTIONS:Map </functions>
+          <env> .Map => ?_ENV:Map </env>
+        </mpy>
+        requires A <=Int B andBool C <=Int D
+          andBool C <=Int A andBool D <Int B
+
+  claim <mpy>
+          <k>
+            solutionProgram
+            ~> runWith(
+                 TupleExpr(Int(A), Int(B)),
+                 TupleExpr(Int(C), Int(D)))
+            => lengthResult(B -Int C)
+          </k>
+          <functions> .Map => ?_FUNCTIONS:Map </functions>
+          <env> .Map => ?_ENV:Map </env>
+        </mpy>
+        requires A <=Int B andBool C <=Int D
+          andBool C >Int A andBool D >=Int B
+
+  claim <mpy>
+          <k>
+            solutionProgram
+            ~> runWith(
+                 TupleExpr(Int(A), Int(B)),
+                 TupleExpr(Int(C), Int(D)))
+            => lengthResult(D -Int C)
+          </k>
+          <functions> .Map => ?_FUNCTIONS:Map </functions>
+          <env> .Map => ?_ENV:Map </env>
+        </mpy>
+        requires A <=Int B andBool C <=Int D
+          andBool C >Int A andBool D <Int B
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b2c8dfbd9ce14dbcc1113e185d6963564c4aa585
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,90 @@
+requires "semantic.k"
+
+// Mathematical reference layer used by the proof.  primeResult(N,D) is the
+// trial-division definition of primality from candidate divisor D onward.
+// For D = 2 and N >= 2 it is "YES" exactly when N is prime: if D*D > N no
+// factor can remain; otherwise D is tested and the search advances.
+module VERIFICATION
+  imports MPY
+
+  syntax Value ::= "primeResult" "(" Int "," Int ")" [function]
+  rule primeResult(N, D) => strVal("YES")
+       requires D *Int D >Int N
+  rule primeResult(N, D) => strVal("NO")
+       requires D *Int D <=Int N andBool N %Int D ==Int 0
+  rule primeResult(N, D) => primeResult(N, D +Int 1)
+       requires D *Int D <=Int N andBool N %Int D =/=Int 0
+
+  syntax Value ::= "intersectionResult" "(" Int "," Int "," Int "," Int ")"
+                   [function]
+  rule intersectionResult(A, B, C, D) => strVal("NO")
+       requires minInt(B, D) -Int maxInt(A, C) <Int 2
+  rule intersectionResult(A, B, C, D)
+       => primeResult(minInt(B, D) -Int maxInt(A, C), 2)
+       requires minInt(B, D) -Int maxInt(A, C) >=Int 2
+
+  syntax Value ::= "lengthResult" "(" Int ")" [function]
+  rule lengthResult(N) => strVal("NO") requires N <Int 2
+  rule lengthResult(N) => primeResult(N, 2) requires N >=Int 2
+
+  // This is the exact constructor tree generated in solution.mpy.  Keeping it
+  // as one named function makes the claims readable while still making their
+  // subject syntactically precise.
+  syntax Program ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      FuncDef("intersection", Params("interval1", "interval2"),
+        Assign(Name("left"), Subscript(Name("interval1"), Int(0)))
+        If(Compare(
+          Subscript(Name("interval2"), Int(0)),
+          CmpOp(">", Name("left"))),
+          Assign(Name("left"), Subscript(Name("interval2"), Int(0))),
+          .Stmts)
+        Assign(Name("right"), Subscript(Name("interval1"), Int(1)))
+        If(Compare(
+          Subscript(Name("interval2"), Int(1)),
+          CmpOp("<", Name("right"))),
+          Assign(Name("right"), Subscript(Name("interval2"), Int(1))),
+          .Stmts)
+        Assign(Name("length"), BinOp("-", Name("right"), Name("left")))
+        If(Compare(Name("length"), CmpOp("<", Int(2))),
+          Return(Str("NO")),
+          .Stmts)
+        Assign(Name("divisor"), Int(2))
+        While(Compare(
+          BinOp("*", Name("divisor"), Name("divisor")),
+          CmpOp("<=", Name("length"))),
+          If(Compare(
+            BinOp("%", Name("length"), Name("divisor")),
+            CmpOp("==", Int(0))),
+            Return(Str("NO")),
+            .Stmts)
+          Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
+        Return(Str("YES"))))
+endmodule
+
+// After LOOP-CORRECTNESS-SPEC proves this same reachability fact from the
+// small-step rules, the whole-program proof imports it here as a proof lemma.
+module VERIFICATION-WITH-LOOP-LEMMA
+  imports VERIFICATION
+
+  rule <k>
+         While(Compare(
+           BinOp("*", Name("divisor"), Name("divisor")),
+           CmpOp("<=", Name("length"))),
+           If(Compare(
+             BinOp("%", Name("length"), Name("divisor")),
+             CmpOp("==", Int(0))),
+             Return(Str("NO")),
+             .Stmts)
+           Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
+         ~> (Return(Str("YES")) .Stmts)
+         => primeResult(N, D)
+       </k>
+       <env>...
+         "length" |-> intVal(N)
+         "divisor" |-> intVal(D)
+       ...</env>
+       requires N >=Int 2 andBool D >=Int 2
+       [priority(40)]
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..aab8a380e3281c7734e85ced8c0633dbe4a91468
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,56 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Regenerate the constructor term with the fixed front-end.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Build the executable semantics and exercise all examples from prompt.py.
+kompile semantic.k \
+  --main-module MPY \
+  --syntax-module MPY-SYNTAX \
+  --backend llvm \
+  --output-definition semantic-kompiled
+
+run_and_expect() {
+  local interval1="$1"
+  local interval2="$2"
+  local expected="$3"
+  local output
+
+  output="$(krun solution.mpy \
+    --definition semantic-kompiled \
+    -cINTERVAL1="$interval1" \
+    -cINTERVAL2="$interval2" \
+    --output pretty)"
+  printf '%s\n' "$output"
+  grep -Fq "strVal ( \"$expected\" )" <<<"$output"
+}
+
+run_and_expect 'TupleExpr(Int(1),Int(2))' \
+               'TupleExpr(Int(2),Int(3))' 'NO'
+run_and_expect 'TupleExpr(Int(-1),Int(1))' \
+               'TupleExpr(Int(0),Int(4))' 'NO'
+run_and_expect 'TupleExpr(Int(-3),Int(-1))' \
+               'TupleExpr(Int(-5),Int(5))' 'YES'
+
+# First prove the inductive trial-division loop lemma without assuming it.
+kompile verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --backend haskell \
+  --output-definition loop-kompiled
+kprove spec.k \
+  --definition loop-kompiled \
+  --spec-module LOOP-CORRECTNESS-SPEC \
+  --output pretty
+
+# Then use that proved lemma to prove the four exhaustive interval-order cases.
+kompile verification.k \
+  --main-module VERIFICATION-WITH-LOOP-LEMMA \
+  --syntax-module MPY-SYNTAX \
+  --backend haskell \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --output pretty
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..d9231afcafda991a3ab8fa1bb5f274a885657333
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,136 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")" [symbol(module)]
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Params ::= "Params" "(" String "," String ")" [symbol(params)]
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol(funcDef)]
+                | "Assign" "(" Expr "," Expr ")"                 [symbol(assign)]
+                | "If" "(" Expr "," Stmts "," Stmts ")"       [symbol(ifStmt)]
+                | "While" "(" Expr "," Stmts ")"               [symbol(whileStmt)]
+                | "Return" "(" Expr ")"                         [symbol(returnStmt)]
+
+  syntax Cmp ::= "CmpOp" "(" String "," Expr ")" [symbol(cmpOp)]
+
+  syntax Expr ::= "Int" "(" Int ")"                         [symbol(intExpr)]
+                | "Str" "(" String ")"                      [symbol(strExpr)]
+                | "Name" "(" String ")"                     [symbol(nameExpr)]
+                | "TupleExpr" "(" Expr "," Expr ")"        [symbol(tupleExpr)]
+                | "Subscript" "(" Expr "," Expr ")"        [symbol(subscript)]
+                | "BinOp" "(" String "," Expr "," Expr ")" [symbol(binOp)]
+                | "Compare" "(" Expr "," Cmp ")"            [symbol(compare)]
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  syntax Value ::= "intVal" "(" Int ")"
+                 | "strVal" "(" String ")"
+                 | "boolVal" "(" Bool ")"
+                 | "tupleVal" "(" Value "," Value ")"
+                 | "unbound"
+  syntax Expr ::= Value
+  syntax KResult ::= Value
+
+  syntax Function ::= "function" "(" String "," String "," Stmts ")"
+
+  syntax KItem ::= Program | Stmt | Stmts | Expr
+                 | "runWith" "(" Expr "," Expr ")"
+                 | "saveFirstArg" "(" Expr ")"
+                 | "saveSecondArg" "(" Value ")"
+                 | "invoke" "(" String "," Value "," Value ")"
+                 | "assignTo" "(" String ")"
+                 | "choose" "(" Stmts "," Stmts ")"
+                 | "loopGuard" "(" Expr "," Stmts ")"
+                 | "functionReturn"
+
+  configuration
+    <mpy>
+      <k> $PGM:Program ~> runWith($INTERVAL1:Expr, $INTERVAL2:Expr) </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+    </mpy>
+
+  // Module loading and entry-point invocation.
+  rule <k> Module(S) => S ...</k>
+  rule <k> .Stmts => .K ...</k>
+  rule <k> (S:Stmt SS:Stmts) => S ~> SS ...</k>
+
+  rule <k> FuncDef(F, Params(P1, P2), BODY) => .K ...</k>
+       <functions> .Map => F |-> function(P1, P2, BODY) </functions>
+
+  rule <k> runWith(A, B) => A ~> saveFirstArg(B) ...</k>
+  rule <k> V:Value ~> saveFirstArg(B) => B ~> saveSecondArg(V) ...</k>
+  rule <k> V2:Value ~> saveSecondArg(V1) => invoke("intersection", V1, V2) ...</k>
+
+  rule <k> invoke(F, V1, V2) => BODY ...</k>
+       <functions> F |-> function(P1, P2, BODY) </functions>
+       <env> _ =>
+         P1 |-> V1
+         P2 |-> V2
+         "left"    |-> unbound
+         "right"   |-> unbound
+         "length"  |-> unbound
+         "divisor" |-> unbound
+       </env>
+
+  // Statement execution.
+  rule <k> Assign(Name(X), E) => E ~> assignTo(X) ...</k>
+  rule <k> V:Value ~> assignTo(X) => .K ...</k>
+       <env>... X |-> (_ => V) ...</env>
+
+  rule <k> If(COND, THEN, ELSE) => COND ~> choose(THEN, ELSE) ...</k>
+  rule <k> boolVal(true)  ~> choose(THEN, _) => THEN ...</k>
+  rule <k> boolVal(false) ~> choose(_, ELSE) => ELSE ...</k>
+
+  rule <k> While(COND, BODY) => COND ~> loopGuard(COND, BODY) ...</k>
+  rule <k> boolVal(true)  ~> loopGuard(COND, BODY) => BODY ~> While(COND, BODY) ...</k>
+  rule <k> boolVal(false) ~> loopGuard(_, _) => .K ...</k>
+
+  // A return abandons the rest of the current function body, including a
+  // surrounding loop continuation, and leaves the returned Value in <k>.
+  rule <k> Return(E) ~> _REST => E ~> functionReturn </k>
+  rule <k> V:Value ~> functionReturn => V ...</k>
+
+  // Expression execution.  Contexts make operands evaluate left-to-right.
+  rule <k> Int(I) => intVal(I) ...</k>
+  rule <k> Str(S) => strVal(S) ...</k>
+  rule <k> Name(X) => V ...</k>
+       <env>... X |-> V ...</env>
+
+  context TupleExpr(HOLE, _)
+  context TupleExpr(_V:Value, HOLE)
+  rule <k> TupleExpr(V1:Value, V2:Value) => tupleVal(V1, V2) ...</k>
+
+  context Subscript(HOLE, _)
+  context Subscript(_V:Value, HOLE)
+  rule <k> Subscript(tupleVal(V0, _), intVal(0)) => V0 ...</k>
+  rule <k> Subscript(tupleVal(_, V1), intVal(1)) => V1 ...</k>
+
+  context BinOp(_, HOLE, _)
+  context BinOp(_, _V:Value, HOLE)
+  rule <k> BinOp("+", intVal(A), intVal(B)) => intVal(A +Int B) ...</k>
+  rule <k> BinOp("-", intVal(A), intVal(B)) => intVal(A -Int B) ...</k>
+  rule <k> BinOp("*", intVal(A), intVal(B)) => intVal(A *Int B) ...</k>
+  rule <k> BinOp("%", intVal(A), intVal(B)) => intVal(A %Int B) ...</k>
+       requires B =/=Int 0
+
+  rule <k> Compare(A, CmpOp(OP, B)) => compareValues(OP, A, B) ...</k>
+  syntax Expr ::= "compareValues" "(" String "," Expr "," Expr ")"
+  context compareValues(_, HOLE, _)
+  context compareValues(_, _V:Value, HOLE)
+  rule <k> compareValues("<",  intVal(A), intVal(B)) => boolVal(A <Int B) ...</k>
+  rule <k> compareValues("<=", intVal(A), intVal(B)) => boolVal(A <=Int B) ...</k>
+  rule <k> compareValues(">",  intVal(A), intVal(B)) => boolVal(A >Int B) ...</k>
+  rule <k> compareValues("==", intVal(A), intVal(B)) => boolVal(A ==Int B) ...</k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..5235131efe3a2a181c342a835f3023af295ccaac
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,20 @@
+def intersection(interval1, interval2):
+    left = interval1[0]
+    if interval2[0] > left:
+        left = interval2[0]
+
+    right = interval1[1]
+    if interval2[1] < right:
+        right = interval2[1]
+
+    length = right - left
+    if length < 2:
+        return "NO"
+
+    divisor = 2
+    while divisor * divisor <= length:
+        if length % divisor == 0:
+            return "NO"
+        divisor = divisor + 1
+
+    return "YES"
