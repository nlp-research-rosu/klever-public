+    <args> Args(str(segment(0, seed(I))), str(segment(0, seed(J)))) </args>
+
+  claim
+    <k> solutionProgram => returned(str(xorText(1, seed(I), seed(J)))) ... </k>
+    <args> Args(str(segment(1, seed(I))), str(segment(1, seed(J)))) </args>
+    requires 0 <=Int I andBool I <Int 2
+     andBool 0 <=Int J andBool J <Int 2
+
+endmodule
