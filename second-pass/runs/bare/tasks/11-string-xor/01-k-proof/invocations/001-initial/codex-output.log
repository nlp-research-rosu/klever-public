--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def string_xor(a: str, b: str) -> str:
+    if a == "":
+        return ""
+    if a[0] == b[0]:
+        return "0" + string_xor(a[1:], b[1:])
+    return "1" + string_xor(a[1:], b[1:])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..3d7ad7ae48bb7ce76d8b2d333523483b4c05aef2
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,21 @@
+requires "verification.k"
+
+module XOR-SPEC
+  imports XOR-VERIFICATION
+
+  // Induction lemma at function entry.  The K-sequence ellipsis preserves
+  // the caller continuation, so recursive calls can reuse this claim.
+  claim
+    <k> exec(solutionBody,
+             env(str(segment(N, S1)), str(segment(N, S2))),
+             solutionBody)
+      => returned(str(xorText(N, S1, S2))) ... </k>
+    <args> ARGS </args>
+    requires N >=Int 0
+
+  // End-to-end theorem from the translated module's initial configuration.
+  claim
+    <k> solutionProgram => returned(str(xorText(N, S1, S2))) ... </k>
+    <args> Args(str(segment(N, S1)), str(segment(N, S2))) </args>
+    requires N >=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ea7a8ae1a8e92bf55ce5e06e1c2766c9f680e8f7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,47 @@
+requires "semantic.k"
+
+module XOR-VERIFICATION
+  imports XOR-SEMANTICS
+
+  // A named copy of the exact term emitted in solution.mpy.  This keeps the
+  // claims readable; prove.sh checks that solution.mpy parses and runs too.
+  syntax Module ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(FuncDef("string_xor", Params("a", "b"), solutionBody))
+
+  syntax Stmts ::= "solutionBody" [function]
+  rule solutionBody =>
+    If(Compare(Name("a"), CmpOp("==", Str(""))),
+      Return(Str("")),
+      .Stmts)
+    If(Compare(
+      Subscript(Name("a"), Int(0)),
+      CmpOp("==", Subscript(Name("b"), Int(0)))),
+      Return(
+        BinOp(
+          "+",
+          Str("0"),
+          Call(
+            Name("string_xor"),
+            Subscript(Name("a"), Slice(Int(1), NoBound, NoBound)),
+            Subscript(Name("b"), Slice(Int(1), NoBound, NoBound))))),
+      .Stmts)
+    Return(
+      BinOp(
+        "+",
+        Str("1"),
+        Call(
+          Name("string_xor"),
+          Subscript(Name("a"), Slice(Int(1), NoBound, NoBound)),
+          Subscript(Name("b"), Slice(Int(1), NoBound, NoBound)))))
+
+  // Mathematical reference function, deliberately separate from the AST
+  // evaluator above.  xorText consumes exactly N bits from each stream.
+  syntax Text ::= "xorText" "(" Int "," Stream "," Stream ")" [function]
+  rule xorText(N, _, _) => empty
+    requires N ==Int 0
+  rule xorText(N, S1, S2) =>
+    cons(head(S1) xorBool head(S2),
+         xorText(N -Int 1, next(S1), next(S2)))
+    requires N >Int 0
+endmodule

