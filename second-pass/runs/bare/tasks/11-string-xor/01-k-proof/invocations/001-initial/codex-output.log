+
+  rule exec(solutionBody,
+            env(str(segment(N, S1)), str(segment(N, S2))),
+            solutionBody)
+    => prependResult(
+         head(S1) xorBool head(S2),
+         exec(solutionBody,
+              env(str(segment(N -Int 1, next(S1))),
+                  str(segment(N -Int 1, next(S2)))),
