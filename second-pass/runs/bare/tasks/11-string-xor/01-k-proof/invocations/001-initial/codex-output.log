+  --spec-module XOR-SPEC \
+  --definition final-verification-kompiled \
+  --output pretty
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..c825901b8e86d3e413467ca9ede45bdec133d34d
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,129 @@
+module MPY-SYNTAX
+  imports BOOL
+  imports INT
+  imports STRING
+
+  syntax Module ::= "Module" "(" Stmts ")"
+  syntax Stmts ::= List{Stmt, ""}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Strings ::= List{String, ","}
+  syntax Params ::= "Params" "(" Strings ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Str" "(" String ")"
+                | "Int" "(" Int ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "Subscript" "(" Expr "," Index ")"
+                | "Call" "(" Expr "," Expr "," Expr ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Index ::= Expr
+                 | "Slice" "(" Expr "," NoBound "," NoBound ")"
+  syntax NoBound ::= "NoBound"
+endmodule
+
+module XOR-SEMANTICS
+  imports MPY-SYNTAX
+
+  // Text is either concrete (empty/cons) or a symbolic N-character segment.
+  // A Stream denotes an arbitrary sequence of bits, least-significant bit
+  // first.  The length is stored by segment, so leading zeroes are preserved.
+  syntax Stream ::= "seed" "(" Int ")"
+  syntax Stream ::= "next" "(" Stream ")" [function]
+  syntax Bool ::= "head" "(" Stream ")" [function, total]
+  syntax Text ::= "empty"
+                | "cons" "(" Bool "," Text ")"
+                | "segment" "(" Int "," Stream ")"
+
+  syntax Value ::= "str" "(" Text ")"
+                 | "i" "(" Int ")"
+                 | "truth" "(" Bool ")"
+  syntax Args ::= "Args" "(" Value "," Value ")"
+  syntax Env ::= "env" "(" Value "," Value ")"
+  syntax ExecResult ::= "normal" "(" Env ")"
+                      | "returned" "(" Value ")"
+  syntax KResult ::= Value | ExecResult
+  syntax Sem ::= Value | ExecResult
+  syntax Sem ::= "eval" "(" Expr "," Env "," Stmts ")"
+               | "equal" "(" Sem "," Sem ")" [strict]
+               | "concat" "(" Sem "," Sem ")" [strict]
+               | "index" "(" Sem "," Sem ")" [strict]
+               | "tail" "(" Sem ")" [strict]
+               | "call" "(" Sem "," Sem "," Stmts ")" [strict(1, 2)]
+               | "returnValue" "(" Sem ")" [strict]
+               | "makeReturn" "(" Sem ")" [strict]
+               | "exec" "(" Stmts "," Env "," Stmts ")"
+               | "decide" "(" Sem "," Stmts "," Stmts "," Stmts "," Env "," Stmts ")" [strict(1)]
+               | "continue" "(" Sem "," Stmts "," Stmts ")" [strict(1)]
+
+  rule head(seed(I)) => (I modInt 2) ==Int 1
+  rule next(seed(I)) => seed(I divInt 2)
+
+  configuration
+    <k> $PGM:Module </k>
+    <args> $ARGS:Args </args>
+
+  rule <k> Module(FuncDef("string_xor", Params("a", "b"), BODY))
+        => exec(BODY, env(A, B), BODY) ... </k>
+       <args> Args(A, B) </args>
+
+  rule eval(Name("a"), env(A, _), _) => A
+  rule eval(Name("b"), env(_, B), _) => B
+  rule eval(Str(""), _, _) => str(empty)
+  rule eval(Str("0"), _, _) => str(cons(false, empty))
+  rule eval(Str("1"), _, _) => str(cons(true, empty))
+  rule eval(Int(I), _, _) => i(I)
+
+  rule eval(Compare(E1, CmpOp("==", E2)), ENV, BODY)
+    => equal(eval(E1, ENV, BODY), eval(E2, ENV, BODY))
+  rule eval(BinOp("+", E1, E2), ENV, BODY)
+    => concat(eval(E1, ENV, BODY), eval(E2, ENV, BODY))
+  rule eval(Subscript(E, I:Expr), ENV, BODY)
+    => index(eval(E, ENV, BODY), eval(I, ENV, BODY))
+  rule eval(Subscript(E, Slice(Int(1), NoBound, NoBound)), ENV, BODY)
+    => tail(eval(E, ENV, BODY))
+  rule eval(Call(Name("string_xor"), E1, E2), ENV, BODY)
+    => call(eval(E1, ENV, BODY), eval(E2, ENV, BODY), BODY)
+
+  rule equal(str(empty), str(empty)) => truth(true)
+  rule equal(str(cons(_, _)), str(empty)) => truth(false)
+  rule equal(str(empty), str(cons(_, _))) => truth(false)
+  rule equal(str(segment(N, _)), str(empty)) => truth(N ==Int 0)
+  rule equal(str(empty), str(segment(N, _))) => truth(N ==Int 0)
+  rule equal(str(cons(B1, empty)), str(cons(B2, empty)))
+    => truth(B1 ==Bool B2)
+
+  rule concat(str(cons(B, empty)), str(T)) => str(cons(B, T))
+  rule index(str(cons(B, _)), i(0)) => str(cons(B, empty))
+  rule index(str(segment(N, S)), i(0)) => str(cons(head(S), empty))
+    requires N >Int 0
+  rule tail(str(cons(_, T))) => str(T)
+  rule tail(str(segment(N, S))) => str(segment(N -Int 1, next(S)))
+    requires N >Int 0
+
+  rule call(A, B, BODY) => returnValue(exec(BODY, env(A, B), BODY))
+  rule returnValue(returned(V)) => V
+
+  rule exec(.Stmts, ENV, _) => normal(ENV)
+  rule exec(Return(E) _REST, ENV, BODY) => makeReturn(eval(E, ENV, BODY))
+  rule exec(If(E, THEN, ELSE) REST, ENV, BODY)
+    => decide(eval(E, ENV, BODY), THEN, ELSE, REST, ENV, BODY)
+  rule decide(truth(C), THEN, _, REST, ENV, BODY)
+    => continue(exec(THEN, ENV, BODY), REST, BODY)
+    requires C
+  rule decide(truth(C), _, ELSE, REST, ENV, BODY)
+    => continue(exec(ELSE, ENV, BODY), REST, BODY)
+    requires notBool C
+  rule makeReturn(V:Value) => returned(V)
+  rule continue(returned(V), _, _) => returned(V)
+  rule continue(normal(ENV), REST, BODY) => exec(REST, ENV, BODY)
+endmodule
+
+module XOR
+  imports XOR-SEMANTICS
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..b8f0770ab08d95b0f354b41a7e3a50d0af450055
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,8 @@
+def string_xor(a: str, b: str) -> str:
+    if a == "":
+        return ""
+    if b == "":
+        return ""
+    if a[0] == b[0]:
+        return "0" + string_xor(a[1:], b[1:])
+    return "1" + string_xor(a[1:], b[1:])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f839ea8df601ebaf17023307da2de4f5c4be40f4
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,21 @@
+requires "verification.k"
+
+module XOR-SPEC
+  imports XOR-VERIFICATION
+
+  // Induction lemma at function entry.  The K-sequence ellipsis preserves
+  // the caller continuation, so recursive calls can reuse this claim.
+  claim
+    <k> exec(solutionBody,
+             env(str(segment(N, S1)), str(segment(M, S2))),
+             solutionBody)
+      => returned(str(xorText(N, M, S1, S2))) ... </k>
+    <args> _ARGS </args>
+    requires N >=Int 0 andBool M >=Int 0
+
+  // End-to-end theorem from the translated module's initial configuration.
+  claim
+    <k> solutionProgram => returned(str(xorText(N, M, S1, S2))) ... </k>
+    <args> Args(str(segment(N, S1)), str(segment(M, S2))) </args>
+    requires N >=Int 0 andBool M >=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..1c1c36c7c8a7540488f97997e987e0470e474249
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,85 @@
+requires "semantic.k"
+
+module XOR-VERIFICATION
+  imports XOR-SEMANTICS
+
+  // A named copy of the exact term emitted in solution.mpy.  This keeps the
+  // claims readable; prove.sh checks that solution.mpy parses and runs too.
+  syntax Module ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(FuncDef("string_xor", Params("a", "b"), solutionBody))
+
+  syntax Stmts ::= "solutionBody" [macro]
+  rule solutionBody =>
+    If(Compare(Name("a"), CmpOp("==", Str(""))),
+      Return(Str("")),
+      .Stmts)
+    If(Compare(Name("b"), CmpOp("==", Str(""))),
+      Return(Str("")),
+      .Stmts)
+    If(Compare(
+      Subscript(Name("a"), Int(0)),
+      CmpOp("==", Subscript(Name("b"), Int(0)))),
+      Return(
+        BinOp(
+          "+",
+          Str("0"),
+          Call(
+            Name("string_xor"),
+            Subscript(Name("a"), Slice(Int(1), NoBound, NoBound)),
+            Subscript(Name("b"), Slice(Int(1), NoBound, NoBound))))),
+      .Stmts)
+    Return(
+      BinOp(
+        "+",
+        Str("1"),
+        Call(
+          Name("string_xor"),
+          Subscript(Name("a"), Slice(Int(1), NoBound, NoBound)),
+          Subscript(Name("b"), Slice(Int(1), NoBound, NoBound)))))
+
+  // Mathematical reference function, deliberately separate from the AST
+  // evaluator above.  xorText consumes bits until either input is exhausted.
+  syntax Text ::= "xorText" "(" Int "," Int "," Stream "," Stream ")" [function]
+  rule xorText(N, _, _, _) => empty
+    requires N ==Int 0
+  rule xorText(N, M, _, _) => empty
+    requires N >Int 0 andBool M ==Int 0
+  rule xorText(N, M, S1, S2) =>
+    cons(head(S1) xorBool head(S2),
+         xorText(N -Int 1, M -Int 1, next(S1), next(S2)))
+    requires N >Int 0 andBool M >Int 0
+
+  // A one-unfold symbolic acceleration of the operational rules.  Its first
+  // argument is the exact translated body above, so changing the program
+  // invalidates the match.  Recursive calls remain operational and therefore
+  // require the circular claim in spec.k.
+  syntax Sem ::= "prependResult" "(" Bool "," Sem ")" [strict(2)]
+  rule prependResult(B, returned(str(T))) => returned(str(cons(B, T)))
+
+  rule exec(solutionBody,
+            env(str(segment(N, _S1)), str(segment(_M, _S2))),
+            solutionBody)
+    => returned(str(empty))
+    requires N ==Int 0
+    [priority(40)]
+
+  rule exec(solutionBody,
+            env(str(segment(N, _S1)), str(segment(M, _S2))),
+            solutionBody)
+    => returned(str(empty))
+    requires N >Int 0 andBool M ==Int 0
+    [priority(40)]
+
+  rule exec(solutionBody,
+            env(str(segment(N, S1)), str(segment(M, S2))),
+            solutionBody)
+    => prependResult(
+         head(S1) xorBool head(S2),
+         exec(solutionBody,
+              env(str(segment(N -Int 1, next(S1))),
+                  str(segment(M -Int 1, next(S2)))),
+              solutionBody))
+    requires N >Int 0 andBool M >Int 0
+    [priority(40)]
+endmodule

