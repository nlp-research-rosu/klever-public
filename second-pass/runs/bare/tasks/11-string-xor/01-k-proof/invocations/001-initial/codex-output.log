+             env(str(segment(N, S1)), str(segment(N, S2))),
+             solutionBody)
+      => returned(str(xorText(N, S1, S2))) ... </k>
+    <args> ARGS </args>
+    requires N >=Int 0
+
+  // End-to-end theorem from the translated module's initial configuration.
+  claim
+    <k> solutionProgram => returned(str(xorText(N, S1, S2))) ... </k>
