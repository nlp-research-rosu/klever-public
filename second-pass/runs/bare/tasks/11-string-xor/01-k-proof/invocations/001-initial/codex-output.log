+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Strings ::= List{String, ","}
+  syntax Params ::= "Params" "(" Strings ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Str" "(" String ")"
+                | "Int" "(" Int ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "Subscript" "(" Expr "," Index ")"
+                | "Call" "(" Expr "," Expr "," Expr ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Index ::= Expr
+                 | "Slice" "(" Expr "," NoBound "," NoBound ")"
+  syntax NoBound ::= "NoBound"
+endmodule
+
+module XOR-SEMANTICS
+  imports MPY-SYNTAX
+
+  syntax Bit ::= "b0" | "b1"
+  syntax Bits ::= List{Bit, ""}
+
+  syntax Value ::= "s" "(" Bits ")"
+                 | "i" "(" Int ")"
+                 | "truth" "(" Bool ")"
+  syntax Args ::= "Args" "(" Value "," Value ")"
+  syntax Sem ::= Value
+               | "normal" "(" Env ")"
+               | "returned" "(" Sem ")"
+  syntax Env ::= "env" "(" Sem "," Sem ")"
+  syntax Sem ::= "eval" "(" Expr "," Env "," Stmts ")" [function]
+               | "equal" "(" Sem "," Sem ")" [function]
+               | "concat" "(" Sem "," Sem ")" [function]
+               | "index" "(" Sem "," Sem ")" [function]
+               | "tail" "(" Sem ")" [function]
+               | "call" "(" Sem "," Sem "," Stmts ")" [function]
+               | "returnValue" "(" Sem ")" [function]
+               | "exec" "(" Stmts "," Env "," Stmts ")" [function]
+               | "decide" "(" Sem "," Stmts "," Stmts "," Stmts "," Env "," Stmts ")" [function]
+               | "continue" "(" Sem "," Stmts "," Stmts ")" [function]
+
+  configuration
+    <k> $PGM:Module </k>
+    <args> $ARGS:Args </args>
+
+  rule <k> Module(FuncDef("string_xor", Params("a", "b"), BODY))
+        => exec(BODY, env(A, B), BODY) ... </k>
+       <args> Args(A, B) </args>
+
