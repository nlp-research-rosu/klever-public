+kompile --version
+kprove --version
+
+mkdir -p "$build_dir"
+
+echo 'COMMAND: kompile semantic.k --main-module XOR --syntax-module MPY-SYNTAX --backend llvm --output-definition /tmp/audit-work/11-string-xor/build/semantic-kompiled'
