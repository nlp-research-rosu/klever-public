+test "$(tail -n 1 /audit-output/REVIEW.md)" = 'LEGITIMACY: NOT_LEGIT'
+test "$(rg -c '^VERDICT:' /audit-output/REVIEW.md)" -eq 1
+test "$(rg -c '^LEGITIMACY:' /audit-output/REVIEW.md)" -eq 1
