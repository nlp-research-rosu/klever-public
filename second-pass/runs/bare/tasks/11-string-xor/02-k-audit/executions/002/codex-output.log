+#!/usr/bin/env bash
+set -euo pipefail
+trap 'rc=$?; echo "EXIT_STATUS=$rc"' EXIT
+
+source_dir=/tmp/audit-work/11-string-xor/source
+build_dir=/tmp/audit-work/11-string-xor/build
+
+echo 'COMMAND: bash /audit-output/evidence/03_rebuild.sh'
+echo 'TOOLCHAIN:'
+kompile --version
+kprove --version
+
