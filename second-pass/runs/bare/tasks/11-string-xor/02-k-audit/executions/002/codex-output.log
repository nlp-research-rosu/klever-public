+#!/usr/bin/env bash
+set -euo pipefail
+trap 'rc=$?; echo "EXIT_STATUS=$rc"' EXIT
+
+source_dir=/tmp/audit-work/11-string-xor/source
+definition=/tmp/audit-work/11-string-xor/build/bridge-free-kompiled
