+echo 'COMMAND: kprove spec-audit-labeled.k --spec-module XOR-SPEC-AUDIT --claims XOR-SPEC-AUDIT.audit-recursive --definition /tmp/audit-work/11-string-xor/build/verification-kompiled --output pretty'
