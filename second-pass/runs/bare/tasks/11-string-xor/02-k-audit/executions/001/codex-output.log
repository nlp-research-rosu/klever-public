diff --git a/evidence/spec-entry-only.k b/evidence/spec-entry-only.k
new file mode 100644
index 0000000000000000000000000000000000000000..c4a1efcaaad9e40ae60728b7be6f47c964045c21
--- /dev/null
+++ b/evidence/spec-entry-only.k
@@ -0,0 +1,13 @@
+requires "verification.k"
+
+module XOR-SPEC-ENTRY-ONLY
+  imports XOR-VERIFICATION
+
+  claim
+    <k> exec(solutionBody,
+             env(str(segment(N, S1)), str(segment(M, S2))),
+             solutionBody)
+      => returned(str(xorText(N, M, S1, S2))) ... </k>
+    <args> _ARGS </args>
+    requires N >=Int 0 andBool M >=Int 0
+endmodule
