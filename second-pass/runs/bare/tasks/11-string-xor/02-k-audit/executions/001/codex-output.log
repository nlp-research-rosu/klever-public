+#!/usr/bin/env python3
+"""Emit an exhaustive, line-numbered inventory of local K declarations/rules."""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+
+SOURCE = Path("/tmp/audit-work/11-string-xor-audit/source")
+for filename in ("semantic.k", "verification.k", "spec.k"):
+    path = SOURCE / filename
+    lines = path.read_text(encoding="utf-8").splitlines()
+    print(f"FILE {filename}")
+    for line_number, line in enumerate(lines, 1):
+        stripped = line.strip()
+        if (
+            stripped.startswith("module ")
+            or stripped == "endmodule"
+            or stripped.startswith("imports ")
+            or stripped.startswith("requires ")
+            or stripped.startswith("configuration")
+            or stripped.startswith("syntax ")
+            or stripped.startswith("rule ")
+            or stripped.startswith("claim")
+            or "[priority(" in stripped
+            or re.search(
+                r"\[(?:[^\]]*\\b(?:function|functional|total|opaque|"
+                r"simplification|macro|strict|seqstrict)\\b[^\]]*)\]",
+                stripped,
+            )
+        ):
+            print(f"{line_number:4d}: {stripped}")
+    print()
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..4b02756a0d65ce3350ef3af2e00a33a9509a37d5
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 3 )); then
+  echo "usage: run_logged.sh LOG WORKDIR COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log=$1
+workdir=$2
+shift 2
+
+{
+  printf 'WORKDIR: %s\n' "$workdir"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} > "$log"
+
+set +e
+(
+  cd "$workdir" || exit 125
+  "$@"
+) > >(tee -a "$log") 2> >(tee -a "$log" >&2)
+status=$?
+set -e
+
+{
+  printf 'EXIT_STATUS: %d\n' "$status"
+  printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} >> "$log"
+
+exit "$status"
