+#!/usr/bin/env bash
+set -uo pipefail
+
+python3 /reference/py2mpy.py solution.py > solution.regenerated.mpy
+translate_status=$?
+echo "translator exit: $translate_status"
+if (( translate_status != 0 )); then
+  exit "$translate_status"
+fi
+
+cmp -s solution.regenerated.mpy solution.mpy
+cmp_status=$?
+echo "byte comparison exit: $cmp_status"
+sha256sum solution.py solution.mpy solution.regenerated.mpy \
+          /reference/py2mpy.py
+if (( cmp_status != 0 )); then
+  diff -u solution.mpy solution.regenerated.mpy
+fi
+exit "$cmp_status"
diff --git a/evidence/validate_report.sh b/evidence/validate_report.sh
new file mode 100644
index 0000000000000000000000000000000000000000..7114c5d19afb901b105742615803d1cb279d9b1e
--- /dev/null
+++ b/evidence/validate_report.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+review=/audit-output/REVIEW.md
+test -s "$review"
+
+expected_tail=$'VERDICT: FAIL\nLEGITIMACY: NOT_LEGIT'
+actual_tail=$(tail -n 2 "$review")
+[[ "$actual_tail" == "$expected_tail" ]]
+
+[[ $(rg -c '^VERDICT: (PASS|CONCERNS|FAIL)$' "$review") -eq 1 ]]
+[[ $(rg -c '^LEGITIMACY: (LEGIT|NOT_LEGIT)$' "$review") -eq 1 ]]
