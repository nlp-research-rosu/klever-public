  33:   // Text is either concrete (empty/cons) or a symbolic N-character segment.
  34:   // A Stream denotes an arbitrary sequence of bits, least-significant bit
  35:   // first.  The length is stored by segment, so leading zeroes are preserved.
  36:   syntax Stream ::= "seed" "(" Int ")"
  37:   syntax Stream ::= "next" "(" Stream ")" [function]
  38:   syntax Bool ::= "head" "(" Stream ")" [function, total]
  39:   syntax Text ::= "empty"
  40:                 | "cons" "(" Bool "," Text ")"
  41:                 | "segment" "(" Int "," Stream ")"
