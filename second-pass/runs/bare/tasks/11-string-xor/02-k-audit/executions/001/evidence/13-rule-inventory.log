  70:   // Mathematical reference function, deliberately separate from the AST
  71:   // evaluator above.  xorText consumes bits until either input is exhausted.
  72:   syntax Text ::= "xorText" "(" Int "," Int "," Stream "," Stream ")" [function]
  73:   rule xorText(N, _, _, _) => empty
  74:     requires N ==Int 0
  75:   rule xorText(N, M, _, _) => empty
