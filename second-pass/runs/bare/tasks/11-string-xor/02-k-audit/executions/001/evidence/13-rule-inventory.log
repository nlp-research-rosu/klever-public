  77:   rule eval(Str(""), _, _) => str(empty)
  78:   rule eval(Str("0"), _, _) => str(cons(false, empty))
  79:   rule eval(Str("1"), _, _) => str(cons(true, empty))
  80:   rule eval(Int(I), _, _) => i(I)
  81: 
  82:   rule eval(Compare(E1, CmpOp("==", E2)), ENV, BODY)
