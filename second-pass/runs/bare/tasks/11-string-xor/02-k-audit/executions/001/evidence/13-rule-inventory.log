 116:   rule decide(truth(C), THEN, _, REST, ENV, BODY)
 117:     => continue(exec(THEN, ENV, BODY), REST, BODY)
 118:     requires C
 119:   rule decide(truth(C), _, ELSE, REST, ENV, BODY)
 120:     => continue(exec(ELSE, ENV, BODY), REST, BODY)
 121:     requires notBool C
 122:   rule makeReturn(V:Value) => returned(V)
 123:   rule continue(returned(V), _, _) => returned(V)
 124:   rule continue(normal(ENV), REST, BODY) => exec(REST, ENV, BODY)
 125: endmodule
