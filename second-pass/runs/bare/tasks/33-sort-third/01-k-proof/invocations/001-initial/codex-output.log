--- /dev/null
+++ b/spec.k
@@ -0,0 +1,55 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The translated implementation refines the contract for every finite list
+  // of mathematical integers (IS is universally quantified by the claim).
+  claim
+    <k>
+      Module(
+        FuncDef("sort_third", Params("l"),
+          Assign(Name("result"),
+            Subscript(Name("l"), Slice(NoBound, NoBound, NoBound)))
+          Assign(
+            Subscript(Name("result"), Slice(NoBound, NoBound, Int(3))),
+            Call(Name("sorted"),
+              Subscript(Name("result"), Slice(NoBound, NoBound, Int(3)))))
+          Return(Name("result"))))
+      => .K
+    </k>
+    <input> VList(IS:Ints) </input>
+    <result> .K => contractResult(IS) </result>
+
+  claim
+    <k>
+      Module(
+        FuncDef("sort_third", Params("l"),
+          Assign(Name("result"),
+            Subscript(Name("l"), Slice(NoBound, NoBound, NoBound)))
+          Assign(
+            Subscript(Name("result"), Slice(NoBound, NoBound, Int(3))),
+            Call(Name("sorted"),
+              Subscript(Name("result"), Slice(NoBound, NoBound, Int(3)))))
+          Return(Name("result"))))
+      => .K
+    </k>
+    <input> VList(5, 6, 3, 4, 8, 9, 2) </input>
+    <result> .K => VList(2, 6, 3, 4, 8, 9, 5) </result>
+
+  claim
+    <k>
+      Module(
+        FuncDef("sort_third", Params("l"),
+          Assign(Name("result"),
+            Subscript(Name("l"), Slice(NoBound, NoBound, NoBound)))
+          Assign(
+            Subscript(Name("result"), Slice(NoBound, NoBound, Int(3))),
+            Call(Name("sorted"),
+              Subscript(Name("result"), Slice(NoBound, NoBound, Int(3)))))
+          Return(Name("result"))))
+      => .K
+    </k>
+    <input> VList(.Ints) </input>
+    <result> .K => VList(.Ints) </result>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d954e2cd0e4a834952e2ea7138df99bc6f748637
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,12 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A direct executable statement of the contract: take the values at
+  // positions 0,3,6,..., sort them, and weave them back into those positions.
+  syntax Value ::= "contractResult" "(" Ints ")"
+                     [function, symbol(contractResult)]
+  rule contractResult(IS)
+    => VList(replaceThirdInts(0 ; IS ; sortInts(thirds(IS))))
+endmodule

