from pathlib import Path
import hashlib,itertools,json,stat
roots=[(Path('/candidate'),'d7236691722a1c33de926e54417b4b12e7185d17a1d95dd3322174554aaf56f4'),(Path('/generation-evidence/codex-trace'),'94c89c376bdea68645cf6e9b49977c9cf1fcb27f1ddfc2ad2aecefb8445413e6')]
# Try stream records over files or all entries with common fields/separators.
for entries_kind in ['files','all']:
  for pathfmt in ['rel','dotrel','slashrel','rootname']:
    for contentfmt in ['bytes','hex','digest','none']:
      for types in ['none','letter','word']:
        for mode in ['none','oct']:
          for sep in [b'',b'\\0',b'\\n',b'  ']:
            outs=[]
            for root,expected in roots:
              h=hashlib.sha256()
              es=sorted(root.rglob('*'),key=lambda p:p.relative_to(root).as_posix())
              if entries_kind=='files': es=[p for p in es if p.is_file()]
              for p in es:
                rel=p.relative_to(root).as_posix()
                ps={'rel':rel,'dotrel':'./'+rel,'slashrel':'/'+rel,'rootname':root.name+'/'+rel}[pathfmt]
                fields=[ps.encode()]
                if types"'!='"'none': fields.append((('f' if p.is_file() else 'd') if types=='letter' else ('file' if p.is_file() else 'directory')).encode())
                if mode=='oct': fields.append(oct(p.stat().st_mode & 0o777).encode())
                if p.is_file() and contentfmt"'!='"'none':
                  b=p.read_bytes(); fields.append({'bytes':b,'hex':hashlib.sha256(b).hexdigest().encode(),'digest':hashlib.sha256(b).digest()}[contentfmt])
                h.update(sep.join(fields)+sep)
              outs.append(h.hexdigest())
            if all(o==e for o,(_,e) in zip(outs,roots)):
              print('MATCH',entries_kind,pathfmt,contentfmt,types,mode,sep)
              raise SystemExit
print('no simple stream match')
