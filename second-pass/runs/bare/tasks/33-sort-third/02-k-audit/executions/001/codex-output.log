printf '"'COMMAND: kprove spec-body-sensitivity.k --definition verification-kompiled-audit --spec-module SPEC-BODY-SENSITIVITY\\nEXIT_STATUS: %s\\nEXPECTED: nonzero stuck proof because mutated return is observably wrong\\n' \""'$body_status" | tee -a /audit-output/evidence/stage5-body-sensitivity.log
if [[ $extract_status -ne 0 || $body_status -eq 0 ]]; then exit 1; fi
exit 0' in /tmp/audit-work/33-sort-third
