+    if any(
+        needle in command
+        for needle in (
+            "kompile",
+            "kprove",
+            "krun",
+            "semantic.k",
+            "verification.k",
+            "spec.k",
+            "solution.py",
+            "solution.mpy",
+            "prove.sh",
+        )
+    ):
+        print(command[:4000])
+print("UNTRUSTED_AGENT_MESSAGES:")
+for message in messages:
+    print(message[:4000])
