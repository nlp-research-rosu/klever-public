     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Generalized loop invariant.  K uses this claim circularly after one
     7	  // concrete loop iteration, which is induction on the shrinking quotient.
     8	  claim
     9	    <mpy>
    10	      <k> loop(digitsCond, digitsLoopBody) ~> CONT
    11	        => CONT </k>
    12	      <n> N => 0 </n>
    13	      <acc> A => oddProductFrom(N, A) </acc>
    14	      <digit> D => finalScratchDigit(N, D) </digit>
    15	      <answer> _ANSWER </answer>
    16	    </mpy>
    17	    requires N >=Int 0
    18	
    19	  // End-to-end contract for every positive integer accepted by the prompt.
    20	  claim
    21	    <mpy>
    22	      <k> Invoke(SolutionProgram, "digits", N) => .K </k>
    23	      <n> 0 </n>
    24	      <acc> 0 => oddProduct(N) </acc>
    25	      <digit> 0 => finalScratchDigit(N, 0) </digit>
    26	      <answer> .K => oddProduct(N) </answer>
    27	    </mpy>
    28	    requires N >Int 0
    29	endmodule
