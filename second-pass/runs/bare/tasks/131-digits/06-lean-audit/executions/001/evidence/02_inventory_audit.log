     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd "$(dirname "$0")"
     5	
     6	# Regenerate the submitted constructor tree with the fixed translator.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	
     9	# Compile the executable semantics and exercise the generated program itself.
    10	kompile semantic.k \
    11	  --main-module SEMANTIC \
    12	  --syntax-module MPY-SYNTAX \
    13	  --backend llvm
    14	
    15	run_case() {
    16	  local input=$1
    17	  local expected=$2
    18	  local output compact
    19	
    20	  output=$(krun \
    21	    <(sed "1s/^/Invoke(/; \$s/\$/, \"digits\", ${input})/" solution.mpy) \
    22	    --definition semantic-kompiled \
    23	    --output pretty)
    24	  printf '%s\n' "$output"
    25	  compact=$(printf '%s' "$output" | tr -d '[:space:]')
    26	  if [[ "$compact" != *"<answer>${expected}~>.K</answer>"* ]]; then
    27	    printf 'unexpected answer for digits(%s): expected %s\n' \
    28	      "$input" "$expected" >&2
    29	    return 1
    30	  fi
    31	}
