+ nl -ba /reference/k-proof/solution.py
     1	def digits(n):
     2	    result = 0
     3	    while n > 0:
     4	        digit = n % 10
     5	        if digit % 2 == 1:
     6	            if result == 0:
     7	                result = digit
     8	            else:
     9	                result = result * digit
    10	        n = n // 10
    11	    return result
