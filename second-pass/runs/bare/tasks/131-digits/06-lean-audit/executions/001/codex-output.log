diff --git a/evidence/lean_app_path_shim.c b/evidence/lean_app_path_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..17ce234cdc9d4700f94325653076bffcba468259
--- /dev/null
+++ b/evidence/lean_app_path_shim.c
@@ -0,0 +1,25 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_function)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_function real_readlink = NULL;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_function)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (
+        path != NULL
+        && strncmp(path, "/proc/", 6) == 0
+        && strlen(path) > 10
+        && strcmp(path + strlen(path) - 4, "/exe") == 0
+    ) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}

  ✓ Capture audit mode, immutable inputs, manifests, and producer-source identity
  ✓ Reconstruct the frozen K rule inventory with trusted tooling and compare bijectively
  ✓ Independently classify every rule and judge the true domain-lemma set
  ✓ Rerun Stage 4 preflight and audit obligations, target identity, and hashes
  ✓ If proof mode, clean-build a fresh Lean project and audit proof, axioms, and bridges
  ✓ Write complete evidence and self-contained REVIEW.md with the required verdict pair
