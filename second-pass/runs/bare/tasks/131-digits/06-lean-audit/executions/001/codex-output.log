/bin/bash -lc 'bash /audit-output/evidence/05_mechanical_gate.sh > /audit-output/evidence/05_mechanical_gate.log 2>&1; gate_status=$?; tail -220 /audit-output/evidence/05_mechanical_gate.log; exit "$gate_status"' in /audit-output
