+    "klean_generation_sha256": sha256_tree(GENERATION),
+    "generation_producer_sources_sha256": sha256_tree(PRODUCERS),
+    "generated_tree_sha256": klean_export.tree_digest(GENERATED),
+    "lean_workspace_sha256": None,
