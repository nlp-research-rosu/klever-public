+  $'VERDICT: PASS\nLEGITIMACY: LEGIT'
+test "$(rg -c '^VERDICT:' /audit-output/REVIEW.md)" = 1
+test "$(rg -c '^LEGITIMACY:' /audit-output/REVIEW.md)" = 1
