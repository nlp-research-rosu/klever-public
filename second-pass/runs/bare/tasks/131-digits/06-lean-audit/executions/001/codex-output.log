diff --git a/evidence/05_mechanical_gate.sh b/evidence/05_mechanical_gate.sh
new file mode 100644
index 0000000000000000000000000000000000000000..3fc69f0e830ce005ea2c65221c579a511872efd1
--- /dev/null
+++ b/evidence/05_mechanical_gate.sh
