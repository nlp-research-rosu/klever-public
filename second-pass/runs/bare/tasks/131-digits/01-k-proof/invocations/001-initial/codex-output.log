+  imports MPY-SEMANTICS
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..9bad1cac0ad6dd99ae51cdc3345708cda6dac483
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def digits(n):
+    result = 0
+    while n > 0:
+        digit = n % 10
+        if digit % 2 == 1:
+            if result == 0:
+                result = digit
+            else:
+                result = result * digit
+        n = n // 10
+    return result
