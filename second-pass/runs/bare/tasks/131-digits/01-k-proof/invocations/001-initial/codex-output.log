+    requires I =/=Int 0
+  rule I:Int ~> loopCont(_COND, _BODY) => .K
+    requires I ==Int 0
+
+  rule <k> I:Int ~> doReturn ~> _REST => .K </k>
+       <answer> _ => I </answer>
+endmodule
+
+module SEMANTIC
+  imports MPY-SEMANTICS
+endmodule
