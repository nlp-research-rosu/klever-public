+  rule oddProduct(N) => oddProductFrom(N, 0)
+
+  // The digit cell is operational scratch state, but tracking its exact final
+  // value makes the loop invariant cover the entire configuration.
+  syntax Int ::= finalScratchDigit(Int, Int) [function, total]
+  rule finalScratchDigit(N, D) => D
+    requires N <=Int 0
+  rule finalScratchDigit(N, _D)
+    => finalScratchDigit(N /Int 10, N %Int 10)
+    requires N >Int 0
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..f6d8219b759a6f125ba9f96b7a68f8e1dbc0d3d1
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,63 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+# Regenerate the submitted constructor tree with the fixed translator.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Compile the executable semantics and exercise the generated program itself.
+kompile semantic.k \
+  --main-module SEMANTIC \
+  --syntax-module MPY-SYNTAX \
+  --backend llvm
+
+run_case() {
+  local input=$1
+  local expected=$2
+  local output compact
+
+  output=$(krun \
+    <(sed "1s/^/Invoke(/; \$s/\$/, \"digits\", ${input})/" solution.mpy) \
+    --definition semantic-kompiled \
+    --output pretty)
+  printf '%s\n' "$output"
+  compact=$(printf '%s' "$output" | tr -d '[:space:]')
+  if [[ "$compact" != *"<answer>${expected}~>.K</answer>"* ]]; then
+    printf 'unexpected answer for digits(%s): expected %s\n' \
+      "$input" "$expected" >&2
+    return 1
+  fi
+}
+
+run_case 1 1
+run_case 4 0
+run_case 235 15
+run_case 2468 0
+run_case 13579 945
+run_case 10203 3
+
+# Compile the proof definition, including the mathematical fold functions.
+kompile verification.k \
+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION \
+  --backend haskell
+
+# Check that SolutionProgram in verification.k is structurally identical to
+# the newly generated solution.mpy term before using it in the proof.
+program_check=$(krun \
+  <(sed '1s/^/CheckProgram(SolutionProgram, /; $s/$/)/' solution.mpy) \
+  --definition verification-kompiled \
+  --output pretty)
+printf '%s\n' "$program_check"
+compact_check=$(printf '%s' "$program_check" | tr -d '[:space:]')
+if [[ "$compact_check" != *'<k>ProgramsMatch~>.K</k>'* ]]; then
+  printf 'solution.mpy differs from SolutionProgram in verification.k\n' >&2
+  exit 1
+fi
+
+# This single positive target proves both claims in spec.k: the generalized
+# loop invariant and the end-to-end result for every positive integer.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..e1e43e551424ef4705323ef601f97b8a40d23aba
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,115 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program
+  syntax Params
+  syntax Stmt
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Expr
+  syntax CmpOp
+
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  syntax KItem ::= "Invoke" "(" Program "," String "," Int ")"
+endmodule
+
+module MPY-SEMANTICS
+  imports MPY-SYNTAX
+  imports INT
+
+  configuration
+    <mpy>
+      <k> $PGM:K </k>
+      <n> 0 </n>
+      <acc> 0 </acc>
+      <digit> 0 </digit>
+      <answer> .K </answer>
+    </mpy>
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "execStmt" "(" Stmt ")"
+                 | "eval" "(" Expr ")"
+                 | "binLeft" "(" String "," Expr ")"
+                 | "binRight" "(" String "," Int ")"
+                 | "compareLeft" "(" String "," Expr ")"
+                 | "compareRight" "(" String "," Int ")"
+                 | "write" "(" String ")"
+                 | "ifCont" "(" Stmts "," Stmts ")"
+                 | "loop" "(" Expr "," Stmts ")"
+                 | "loopCont" "(" Expr "," Stmts ")"
+                 | "doReturn"
+
+  rule <k> Invoke(Module(FuncDef(F, Params("n"), BODY)), F, N)
+            => exec(BODY) ... </k>
+       <n> _ => N </n>
+       <acc> _ => 0 </acc>
+       <digit> _ => 0 </digit>
+       <answer> _ => .K </answer>
+
+  rule exec(.Stmts) => .K
+  rule exec(S SS) => execStmt(S) ~> exec(SS)
+
+  rule execStmt(Assign(Name(X), E)) => eval(E) ~> write(X)
+  rule execStmt(If(COND, THEN, ELSE))
+    => eval(COND) ~> ifCont(THEN, ELSE)
+  rule execStmt(While(COND, BODY)) => loop(COND, BODY)
+  rule execStmt(Return(E)) => eval(E) ~> doReturn
+
+  rule eval(Int(I)) => I
+  rule <k> eval(Name("n")) => I ... </k> <n> I </n>
+  rule <k> eval(Name("result")) => I ... </k> <acc> I </acc>
+  rule <k> eval(Name("digit")) => I ... </k> <digit> I </digit>
+  rule eval(BinOp(OP, LEFT, RIGHT)) => eval(LEFT) ~> binLeft(OP, RIGHT)
+  rule I:Int ~> binLeft(OP, RIGHT) => eval(RIGHT) ~> binRight(OP, I)
+  rule J:Int ~> binRight("%", I) => I %Int J
+  rule J:Int ~> binRight("//", I) => I /Int J
+  rule J:Int ~> binRight("*", I) => I *Int J
+
+  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)))
+    => eval(LEFT) ~> compareLeft(OP, RIGHT)
+  rule I:Int ~> compareLeft(OP, RIGHT)
+    => eval(RIGHT) ~> compareRight(OP, I)
+  rule J:Int ~> compareRight(">", I) => 1 requires I >Int J
+  rule J:Int ~> compareRight(">", I) => 0 requires I <=Int J
+  rule J:Int ~> compareRight("==", I) => 1 requires I ==Int J
+  rule J:Int ~> compareRight("==", I) => 0 requires I =/=Int J
+
+  rule <k> I:Int ~> write("n") => .K ... </k> <n> _ => I </n>
+  rule <k> I:Int ~> write("result") => .K ... </k> <acc> _ => I </acc>
+  rule <k> I:Int ~> write("digit") => .K ... </k> <digit> _ => I </digit>
+
+  rule I:Int ~> ifCont(THEN, _ELSE) => exec(THEN)
+    requires I =/=Int 0
+  rule I:Int ~> ifCont(_THEN, ELSE) => exec(ELSE)
+    requires I ==Int 0
+
+  rule loop(COND, BODY) => eval(COND) ~> loopCont(COND, BODY)
+  rule I:Int ~> loopCont(COND, BODY)
+    => exec(BODY) ~> loop(COND, BODY)
+    requires I =/=Int 0
+  rule I:Int ~> loopCont(_COND, _BODY) => .K
+    requires I ==Int 0
+
+  rule <k> I:Int ~> doReturn ~> _REST => .K </k>
+       <answer> _ => I </answer>
+endmodule
+
+module SEMANTIC
+  imports MPY-SEMANTICS
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..9bad1cac0ad6dd99ae51cdc3345708cda6dac483
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def digits(n):
+    result = 0
+    while n > 0:
+        digit = n % 10
+        if digit % 2 == 1:
+            if result == 0:
+                result = digit
+            else:
+                result = result * digit
+        n = n // 10
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2c61f117b59eb5911621734237fa4252f43a9757
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Generalized loop invariant.  K uses this claim circularly after one
+  // concrete loop iteration, which is induction on the shrinking quotient.
+  claim
+    <mpy>
+      <k> loop(digitsCond, digitsLoopBody) ~> CONT
+        => CONT </k>
+      <n> N => 0 </n>
+      <acc> A => oddProductFrom(N, A) </acc>
+      <digit> D => finalScratchDigit(N, D) </digit>
+      <answer> _ANSWER </answer>
+    </mpy>
+    requires N >=Int 0
+
+  // End-to-end contract for every positive integer accepted by the prompt.
+  claim
+    <mpy>
+      <k> Invoke(SolutionProgram, "digits", N) => .K </k>
+      <n> 0 </n>
+      <acc> 0 => oddProduct(N) </acc>
+      <digit> 0 => finalScratchDigit(N, 0) </digit>
+      <answer> .K => oddProduct(N) </answer>
+    </mpy>
+    requires N >Int 0
+endmodule
