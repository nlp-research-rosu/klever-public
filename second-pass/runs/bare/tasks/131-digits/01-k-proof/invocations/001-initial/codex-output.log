+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program
+  syntax Params
+  syntax Stmt
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Expr
+  syntax CmpOp
+
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  syntax KItem ::= "Invoke" "(" Program "," String "," Int ")"
+endmodule
+
+module MPY-SEMANTICS
+  imports MPY-SYNTAX
+  imports INT
+
+  configuration
+    <mpy>
+      <k> $PGM:K </k>
+      <n> 0 </n>
+      <acc> 0 </acc>
+      <digit> 0 </digit>
+      <answer> .K </answer>
+    </mpy>
