+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  syntax KItem ::= "Invoke" "(" Program "," String "," Int ")"
+                 | "CheckProgram" "(" Program "," Program ")"
+                 | "ProgramsMatch"
