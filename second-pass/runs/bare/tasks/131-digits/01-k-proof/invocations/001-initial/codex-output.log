+requires "domains.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program
+  syntax Params
+  syntax Stmt
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Expr
+  syntax CmpOp
+
+  syntax Program ::= "Module" "(" Stmts ")" [symbol]
+  syntax Params ::= "Params" "(" String ")" [symbol]
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol]
+                | "Assign" "(" Expr "," Expr ")" [symbol]
+                | "While" "(" Expr "," Stmts ")" [symbol]
+                | "If" "(" Expr "," Stmts "," Stmts ")" [symbol]
+                | "Return" "(" Expr ")" [symbol]
+
+  syntax Expr ::= "Int" "(" Int ")" [symbol]
+                | "Name" "(" String ")" [symbol]
+                | "BinOp" "(" String "," Expr "," Expr ")" [symbol]
+                | "Compare" "(" Expr "," CmpOp ")" [symbol]
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol]
+
+  syntax KItem ::= "Invoke" "(" Program "," String "," Int ")" [symbol]
+endmodule
+
+module MPY-SEMANTICS
+  imports MPY-SYNTAX
+  imports INT
+
+  configuration
+    <mpy>
+      <k> $PGM:K </k>
+      <n> 0 </n>
+      <acc> 0 </acc>
+      <digit> 0 </digit>
+      <answer> .K </answer>
+    </mpy>
+
+  syntax KItem ::= "exec" "(" Stmts ")" [symbol]
+                 | "execStmt" "(" Stmt ")" [symbol]
+                 | "eval" "(" Expr ")" [symbol]
+                 | "binLeft" "(" String "," Expr ")" [symbol]
+                 | "binRight" "(" String "," Int ")" [symbol]
+                 | "compareLeft" "(" String "," Expr ")" [symbol]
+                 | "compareRight" "(" String "," Int ")" [symbol]
+                 | "write" "(" String ")" [symbol]
+                 | "ifCont" "(" Stmts "," Stmts ")" [symbol]
+                 | "loop" "(" Expr "," Stmts ")" [symbol]
+                 | "loopCont" "(" Expr "," Stmts ")" [symbol]
+                 | "doReturn" [symbol]
+
+  rule <k> Invoke(Module(FuncDef(F, Params("n"), BODY)), F, N)
+            => exec(BODY) ... </k>
+       <n> _ => N </n>
+       <acc> _ => 0 </acc>
+       <digit> _ => 0 </digit>
+       <answer> _ => .K </answer>
+
+  rule exec(.Stmts) => .K
+  rule exec(S SS) => execStmt(S) ~> exec(SS)
+
+  rule execStmt(Assign(Name(X), E)) => eval(E) ~> write(X)
+  rule execStmt(If(COND, THEN, ELSE))
+    => eval(COND) ~> ifCont(THEN, ELSE)
+  rule execStmt(While(COND, BODY)) => loop(COND, BODY)
+  rule execStmt(Return(E)) => eval(E) ~> doReturn
+
+  rule eval(Int(I)) => I
+  rule <k> eval(Name("n")) => I ... </k> <n> I </n>
+  rule <k> eval(Name("result")) => I ... </k> <acc> I </acc>
+  rule <k> eval(Name("digit")) => I ... </k> <digit> I </digit>
+  rule eval(BinOp(OP, LEFT, RIGHT)) => eval(LEFT) ~> binLeft(OP, RIGHT)
+  rule I:Int ~> binLeft(OP, RIGHT) => eval(RIGHT) ~> binRight(OP, I)
+  rule J:Int ~> binRight("%", I) => I %Int J
+  rule J:Int ~> binRight("//", I) => I /Int J
+  rule J:Int ~> binRight("*", I) => I *Int J
+
+  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)))
+    => eval(LEFT) ~> compareLeft(OP, RIGHT)
+  rule I:Int ~> compareLeft(OP, RIGHT)
+    => eval(RIGHT) ~> compareRight(OP, I)
+  rule J:Int ~> compareRight(">", I) => 1 requires I >Int J
+  rule J:Int ~> compareRight(">", I) => 0 requires I <=Int J
+  rule J:Int ~> compareRight("==", I) => 1 requires I ==Int J
+  rule J:Int ~> compareRight("==", I) => 0 requires I =/=Int J
+
+  rule <k> I:Int ~> write("n") => .K ... </k> <n> _ => I </n>
+  rule <k> I:Int ~> write("result") => .K ... </k> <acc> _ => I </acc>
+  rule <k> I:Int ~> write("digit") => .K ... </k> <digit> _ => I </digit>
+
+  rule I:Int ~> ifCont(THEN, _ELSE) => exec(THEN)
+    requires I =/=Int 0
+  rule I:Int ~> ifCont(_THEN, ELSE) => exec(ELSE)
+    requires I ==Int 0
+
+  rule loop(COND, BODY) => eval(COND) ~> loopCont(COND, BODY)
+  rule I:Int ~> loopCont(COND, BODY)
+    => exec(BODY) ~> loop(COND, BODY)
+    requires I =/=Int 0
+  rule I:Int ~> loopCont(_COND, _BODY) => .K
+    requires I ==Int 0
+
+  rule <k> I:Int ~> doReturn ~> _REST => .K </k>
+       <answer> _ => I </answer>
+endmodule
+
+module SEMANTIC
+  imports MPY-SEMANTICS
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..9bad1cac0ad6dd99ae51cdc3345708cda6dac483
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def digits(n):
+    result = 0
+    while n > 0:
+        digit = n % 10
+        if digit % 2 == 1:
+            if result == 0:
+                result = digit
+            else:
+                result = result * digit
+        n = n // 10
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d734541473ace99c2d3b70a60e0da274f34e2dff
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Generalized loop invariant.  K uses this claim circularly after one
+  // concrete loop iteration, which is induction on the shrinking quotient.
+  claim
+    <mpy>
+      <k> loop(digitsCond, digitsLoopBody) ~> CONT
+        => CONT </k>
+      <n> N => 0 </n>
+      <acc> A => oddProductFrom(N, A) </acc>
+      <digit> D => finalScratchDigit(N, D) </digit>
+      <answer> ANSWER </answer>
+    </mpy>
+    requires N >=Int 0
+
+  // End-to-end contract for every positive integer accepted by the prompt.
+  claim
+    <mpy>
+      <k> Invoke(solutionProgram, "digits", N) => .K </k>
+      <n> 0 </n>
+      <acc> 0 => oddProduct(N) </acc>
+      <digit> 0 => finalScratchDigit(N, 0) </digit>
+      <answer> .K => oddProduct(N) </answer>
+    </mpy>
+    requires N >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..934601a64b80384ab852f8a5fbb77df561930783
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,63 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY-SEMANTICS
+  imports BOOL
+
+  // The exact condition and body of the loop emitted in solution.mpy.
+  syntax Expr ::= "digitsCond" [function, total]
+  rule digitsCond
+    => Compare(Name("n"), CmpOp(">", Int(0)))
+
+  syntax Stmts ::= "digitsLoopBody" [function, total]
+  rule digitsLoopBody
+    => Assign(Name("digit"), BinOp("%", Name("n"), Int(10)))
+       If(Compare(BinOp("%", Name("digit"), Int(2)),
+                  CmpOp("==", Int(1))),
+          If(Compare(Name("result"), CmpOp("==", Int(0))),
+             Assign(Name("result"), Name("digit")),
+             Assign(Name("result"),
+                    BinOp("*", Name("result"), Name("digit")))),
+          .Stmts)
+       Assign(Name("n"), BinOp("//", Name("n"), Int(10)))
+
+  // This is a constructor-for-constructor copy of solution.mpy.  Keeping it
+  // here makes the program a closed term that can occur in reachability claims.
+  syntax Program ::= "solutionProgram" [function, total]
+  rule solutionProgram
+    => Module(
+         FuncDef("digits", Params("n"),
+           Assign(Name("result"), Int(0))
+           While(digitsCond, digitsLoopBody)
+           Return(Name("result"))))
+
+  // Extend accumulator A with decimal digit D.  Zero is the sentinel for
+  // "no odd digit seen"; decimal odd digits themselves are never zero.
+  syntax Int ::= addOddDigit(Int, Int) [function, total]
+  rule addOddDigit(A, D) => A
+    requires D %Int 2 ==Int 0
+  rule addOddDigit(A, D) => D
+    requires (D %Int 2 =/=Int 0) andBool (A ==Int 0)
+  rule addOddDigit(A, D) => A *Int D
+    requires (D %Int 2 =/=Int 0) andBool (A =/=Int 0)
+
+  // Fold the remaining base-10 digits of N into A, least-significant first.
+  syntax Int ::= oddProductFrom(Int, Int) [function, total]
+  rule oddProductFrom(N, A) => A
+    requires N <=Int 0
+  rule oddProductFrom(N, A)
+    => oddProductFrom(N /Int 10, addOddDigit(A, N %Int 10))
+    requires N >Int 0
+
+  syntax Int ::= oddProduct(Int) [function, total]
+  rule oddProduct(N) => oddProductFrom(N, 0)
+
+  // The digit cell is operational scratch state, but tracking its exact final
+  // value makes the loop invariant cover the entire configuration.
+  syntax Int ::= finalScratchDigit(Int, Int) [function, total]
+  rule finalScratchDigit(N, D) => D
+    requires N <=Int 0
+  rule finalScratchDigit(N, _D)
+    => finalScratchDigit(N /Int 10, N %Int 10)
+    requires N >Int 0
+endmodule

