import hashlib,json,itertools
from pathlib import Path
pairs=[('/candidate','4fde0d65eeee3b699a08ba9e8effddee197a61f2374005c2f735e0cb72a7eb4e'),('/generation-evidence/codex-trace','8d5d1a564ef0c7a18202efec28a39cac9359bc6a8ab9af541da5343d45b38239')]
def ents(root):
 r=Path(root); out=[]
 for p in sorted(r.rglob('*')):
  rel=p.relative_to(r).as_posix()
  if p.is_file(): out.append((rel,'file',len(p.read_bytes()),hashlib.sha256(p.read_bytes()).hexdigest()))
  elif p.is_dir(): out.append((rel,'directory',0,None))
 return out
serializers=[]
for include_dirs in (False,True):
 for rep in ('dict_hash','dict_obj','list_pair','list_obj','list_string','manifest_lines'):
  for compact in (False,True):
   def make(es,include_dirs=include_dirs,rep=rep,compact=compact):
    es=[e for e in es if include_dirs or e[1]=='file']
    if rep=='dict_hash': o={r:(h if k=='file' else None) for r,k,s,h in es}
    elif rep=='dict_obj': o={r:{'type':k,'size':s,'sha256':h} for r,k,s,h in es}
    elif rep=='list_pair': o=[[r,h if k=='file' else None] for r,k,s,h in es]
    elif rep=='list_obj': o=[{'path':r,'type':k,'size':s,'sha256':h} for r,k,s,h in es]
    elif rep=='list_string': o=[f'{h}  {r}' if k=='file' else f'DIR  {r}' for r,k,s,h in es]
    else:
     return ''.join((f'{h}  {r}\\n' if k=='file' else f'DIR  {r}\\n') for r,k,s,h in es).encode()
    kw={'sort_keys':True}
    if compact: kw['separators']=(',',':')
    return json.dumps(o,**kw).encode()
   serializers.append((include_dirs,rep,compact,make))
for root,target in pairs:
 es=ents(root); print(root)
 for inc,rep,comp,make in serializers:
  d=make(es)
  for suffix in (b'',b'\\n'):
   if hashlib.sha256(d+suffix).hexdigest()==target: print('MATCH',inc,rep,comp,'nl',bool(suffix))
