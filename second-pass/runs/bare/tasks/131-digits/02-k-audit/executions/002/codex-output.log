+    printf '%s\n' "$output" |
+      awk '/<answer>/{getline; gsub(/[[:space:]]/,""); sub(/~>.K/,""); print}'
+  )
+  python_values=$(
+    python3 - "$n" <<'PY'
+import importlib.util
+import sys
+from pathlib import Path
+
