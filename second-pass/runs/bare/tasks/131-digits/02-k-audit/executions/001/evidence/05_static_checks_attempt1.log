$ nl -ba /tmp/audit-work/131-digits/verification.k
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY-SEMANTICS
     5	  imports BOOL
     6	
     7	  syntax KItem ::= "CheckProgram" "(" Program "," Program ")"
     8	                 | "ProgramsMatch"
     9	
    10	  // The exact condition and body of the loop emitted in solution.mpy.
    11	  syntax Expr ::= "digitsCond" [function, total]
    12	  rule digitsCond
    13	    => Compare(Name("n"), CmpOp(">", Int(0)))
    14	
    15	  syntax Stmts ::= "digitsLoopBody" [function, total]
    16	  rule digitsLoopBody
    17	    => Assign(Name("digit"), BinOp("%", Name("n"), Int(10)))
    18	       If(Compare(BinOp("%", Name("digit"), Int(2)),
    19	                  CmpOp("==", Int(1))),
    20	          If(Compare(Name("result"), CmpOp("==", Int(0))),
    21	             Assign(Name("result"), Name("digit")),
    22	             Assign(Name("result"),
    23	                    BinOp("*", Name("result"), Name("digit")))),
    24	          .Stmts)
    25	       Assign(Name("n"), BinOp("//", Name("n"), Int(10)))
    26	
    27	  // This is a constructor-for-constructor copy of solution.mpy.  Keeping it
    28	  // here makes the program a closed term that can occur in reachability claims.
    29	  syntax Program ::= "SolutionProgram" [function, total]
    30	  rule SolutionProgram
    31	    => Module(
    32	         FuncDef("digits", Params("n"),
    33	           Assign(Name("result"), Int(0))
    34	           While(digitsCond, digitsLoopBody)
    35	           Return(Name("result"))))
    36	
    37	  // Used by prove.sh to compare the generated .mpy tree structurally with
    38	  // the closed program term above, after SolutionProgram expands.
    39	  rule CheckProgram(P, P) => ProgramsMatch
    40	
    41	  // Extend accumulator A with decimal digit D.  Zero is the sentinel for
    42	  // "no odd digit seen"; decimal odd digits themselves are never zero.
    43	  syntax Int ::= addOddDigit(Int, Int) [function, total]
    44	  rule addOddDigit(A, D) => A
    45	    requires D %Int 2 ==Int 0
    46	  rule addOddDigit(A, D) => D
    47	    requires (D %Int 2 =/=Int 0) andBool (A ==Int 0)
    48	  rule addOddDigit(A, D) => A *Int D
    49	    requires (D %Int 2 =/=Int 0) andBool (A =/=Int 0)
    50	
    51	  // Fold the remaining base-10 digits of N into A, least-significant first.
    52	  syntax Int ::= oddProductFrom(Int, Int) [function, total]
    53	  rule oddProductFrom(N, A) => A
    54	    requires N <=Int 0
    55	  rule oddProductFrom(N, A)
    56	    => oddProductFrom(N /Int 10, addOddDigit(A, N %Int 10))
    57	    requires N >Int 0
    58	
    59	  syntax Int ::= oddProduct(Int) [function, total]
    60	  rule oddProduct(N) => oddProductFrom(N, 0)
    61	
    62	  // The digit cell is operational scratch state, but tracking its exact final
    63	  // value makes the loop invariant cover the entire configuration.
    64	  syntax Int ::= finalScratchDigit(Int, Int) [function, total]
    65	  rule finalScratchDigit(N, D) => D
    66	    requires N <=Int 0
    67	  rule finalScratchDigit(N, _D)
    68	    => finalScratchDigit(N /Int 10, N %Int 10)
    69	    requires N >Int 0
    70	endmodule
[exit 0]

