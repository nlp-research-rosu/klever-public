+printf '\n$ python3 /reference/py2mpy.py %q > %q\n' \
+  "$scratch/solution.py" "$scratch/solution.regenerated.mpy"
+python3 /reference/py2mpy.py "$scratch/solution.py" \
+  > "$scratch/solution.regenerated.mpy"
+status=$?
