+#!/usr/bin/env bash
+set -u
+
+scratch=/tmp/audit-work/131-digits
+failures=0
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
