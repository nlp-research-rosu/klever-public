new file mode 100644
index 0000000000000000000000000000000000000000..6f6d5b40be659b9a874389a6902633047b435079
--- /dev/null
+++ b/evidence/03_spec_labeled.k
@@ -0,0 +1,26 @@
+requires "verification.k"
+
+module SPEC-LABELED
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <mpy>
+      <k> loop(digitsCond, digitsLoopBody) ~> CONT
+        => CONT </k>
+      <n> N => 0 </n>
+      <acc> A => oddProductFrom(N, A) </acc>
+      <digit> D => finalScratchDigit(N, D) </digit>
+      <answer> _ANSWER </answer>
+    </mpy>
+    requires N >=Int 0
+
+  claim [entry-contract]:
+    <mpy>
+      <k> Invoke(SolutionProgram, "digits", N) => .K </k>
+      <n> 0 </n>
+      <acc> 0 => oddProduct(N) </acc>
+      <digit> 0 => finalScratchDigit(N, 0) </digit>
+      <answer> .K => oddProduct(N) </answer>
+    </mpy>
+    requires N >Int 0
+endmodule

codex
The loop invariant closes independently. The first attempt to select only the entry label is deliberately exposing its dependency: filtering out the loop claim removes the circularity needed by the entry proof, so this is not a valid way to isolate the dependent theorem. I’m stopping that diagnostic and will record the entry proof as the combined run plus the separately established loop lemma, rather than misclassifying the expected dependency as a candidate failure.
