+
+printf '\nIntended-domain arithmetic witnesses:\n'
+run_eval positive_division 'eval(BinOp("//", Int(235), Int(10)))'
+run_eval positive_remainder 'eval(BinOp("%", Int(235), Int(10)))'
+
