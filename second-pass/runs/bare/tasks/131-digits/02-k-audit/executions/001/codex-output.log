--- /dev/null
+++ b/evidence/04_ground_witnesses.k
@@ -0,0 +1,26 @@
+requires "verification.k"
+
+module GROUND-WITNESSES
+  imports VERIFICATION
+
+  // Satisfies the loop claim's N >= 0 precondition with
+  // N=235, A=0, D=0, CONT=.K, ANSWER=.K.
+  claim [loop-235]:
+    <mpy>
+      <k> loop(digitsCond, digitsLoopBody) => .K </k>
+      <n> 235 => 0 </n>
+      <acc> 0 => 15 </acc>
+      <digit> 0 => 2 </digit>
+      <answer> .K </answer>
+    </mpy>
+
+  // Satisfies the entry claim's N > 0 precondition with N=235.
+  claim [entry-235]:
+    <mpy>
+      <k> Invoke(SolutionProgram, "digits", 235) => .K </k>
+      <n> 0 </n>
+      <acc> 0 => 15 </acc>
+      <digit> 0 => 2 </digit>
+      <answer> .K => 15 </answer>
+    </mpy>
+endmodule

exec
/bin/bash -lc 'chmod +x evidence/04_adequacy_and_pinning.sh
./evidence/04_adequacy_and_pinning.sh > evidence/04_adequacy_and_pinning.log 2>&1
status=$?
printf '"'stage4_status=%d\\n' \""'$status"
cat evidence/04_adequacy_and_pinning.log' in /audit-output
