{
  "inventory_sha256": "213abec6453da6d80e355466d7711c50d96f53815539caa490ba371a6491b303",
  "rules": [
    {
      "attributes": [],
      "end_line": 13,
      "module": "VERIFICATION",
      "normalized_sha256": "bb601208edb1e96080955b1328dafddf878fccfb2dce6832f739299c2b3238de",
      "source_rule_id": "rule-bb601208edb1e96080955b1328dafddf878fccfb2dce6832f739299c2b3238de",
      "start_line": 12,
      "text": "  rule digitsCond\n    => Compare(Name(\"n\"), CmpOp(\">\", Int(0)))"
    },
    {
      "attributes": [],
      "end_line": 25,
      "module": "VERIFICATION",
      "normalized_sha256": "211588c9e5b79676333afd044a4f025ce5a926e434e042c16ba8ff965176dff5",
      "source_rule_id": "rule-211588c9e5b79676333afd044a4f025ce5a926e434e042c16ba8ff965176dff5",
      "start_line": 16,
      "text": "  rule digitsLoopBody\n    => Assign(Name(\"digit\"), BinOp(\"%\", Name(\"n\"), Int(10)))\n       If(Compare(BinOp(\"%\", Name(\"digit\"), Int(2)),\n                  CmpOp(\"==\", Int(1))),\n          If(Compare(Name(\"result\"), CmpOp(\"==\", Int(0))),\n             Assign(Name(\"result\"), Name(\"digit\")),\n             Assign(Name(\"result\"),\n                    BinOp(\"*\", Name(\"result\"), Name(\"digit\")))),\n          .Stmts)\n       Assign(Name(\"n\"), BinOp(\"//\", Name(\"n\"), Int(10)))"
    },
    {
      "attributes": [],
      "end_line": 35,
      "module": "VERIFICATION",
      "normalized_sha256": "72490e5f66a388ba81e28c7d33d85162be231d30fbfc42ada45ce48e94f1b47a",
      "source_rule_id": "rule-72490e5f66a388ba81e28c7d33d85162be231d30fbfc42ada45ce48e94f1b47a",
      "start_line": 30,
      "text": "  rule SolutionProgram\n    => Module(\n         FuncDef(\"digits\", Params(\"n\"),\n           Assign(Name(\"result\"), Int(0))\n           While(digitsCond, digitsLoopBody)\n           Return(Name(\"result\"))))"
    },
    {
      "attributes": [],
      "end_line": 39,
      "module": "VERIFICATION",
      "normalized_sha256": "1b6dfc30f83e14335a83a1746f3105c6dee0842578ac512515f9f976bcf8c44d",
      "source_rule_id": "rule-1b6dfc30f83e14335a83a1746f3105c6dee0842578ac512515f9f976bcf8c44d",
      "start_line": 39,
      "text": "  rule CheckProgram(P, P) => ProgramsMatch"
    },
    {
      "attributes": [],
      "end_line": 45,
      "module": "VERIFICATION",
      "normalized_sha256": "5d78af83c186109d1745d13d0f1814d6752c84c8c9c47e209a5c7dcadafd402f",
      "source_rule_id": "rule-5d78af83c186109d1745d13d0f1814d6752c84c8c9c47e209a5c7dcadafd402f",
      "start_line": 44,
      "text": "  rule addOddDigit(A, D) => A\n    requires D %Int 2 ==Int 0"
    },
    {
      "attributes": [],
      "end_line": 47,
      "module": "VERIFICATION",
      "normalized_sha256": "437c4b2500798a57406f8d142559444c31e2437b03b5fe055671c6b689e3540e",
      "source_rule_id": "rule-437c4b2500798a57406f8d142559444c31e2437b03b5fe055671c6b689e3540e",
      "start_line": 46,
      "text": "  rule addOddDigit(A, D) => D\n    requires (D %Int 2 =/=Int 0) andBool (A ==Int 0)"
    },
    {
      "attributes": [],
      "end_line": 49,
      "module": "VERIFICATION",
      "normalized_sha256": "89daad84beeed92afb1ee55504d822d521105908ea9806147e9d9e3147290ec9",
      "source_rule_id": "rule-89daad84beeed92afb1ee55504d822d521105908ea9806147e9d9e3147290ec9",
      "start_line": 48,
      "text": "  rule addOddDigit(A, D) => A *Int D\n    requires (D %Int 2 =/=Int 0) andBool (A =/=Int 0)"
    },
    {
      "attributes": [],
      "end_line": 54,
      "module": "VERIFICATION",
      "normalized_sha256": "e11ad215fdd840b01bcd1242471ce6eec8653123658ff8b63379ca602d63489b",
      "source_rule_id": "rule-e11ad215fdd840b01bcd1242471ce6eec8653123658ff8b63379ca602d63489b",
      "start_line": 53,
      "text": "  rule oddProductFrom(N, A) => A\n    requires N <=Int 0"
    },
    {
      "attributes": [],
      "end_line": 57,
      "module": "VERIFICATION",
      "normalized_sha256": "6f05f0cf15dc24aba0468572926489fbee6552fbb026dbafa4cc55d063dd2200",
      "source_rule_id": "rule-6f05f0cf15dc24aba0468572926489fbee6552fbb026dbafa4cc55d063dd2200",
      "start_line": 55,
      "text": "  rule oddProductFrom(N, A)\n    => oddProductFrom(N /Int 10, addOddDigit(A, N %Int 10))\n    requires N >Int 0"
    },
    {
      "attributes": [],
      "end_line": 60,
      "module": "VERIFICATION",
      "normalized_sha256": "ac1c567b0b62d1c41908cf0eddc4e86fd1188c897da6982587d3b155b82122df",
      "source_rule_id": "rule-ac1c567b0b62d1c41908cf0eddc4e86fd1188c897da6982587d3b155b82122df",
      "start_line": 60,
      "text": "  rule oddProduct(N) => oddProductFrom(N, 0)"
    },
    {
      "attributes": [],
      "end_line": 66,
      "module": "VERIFICATION",
      "normalized_sha256": "c69abfdd9a91259eebdc62439ad213ee855f4b5c17687e0e4e0d421e2057e987",
      "source_rule_id": "rule-c69abfdd9a91259eebdc62439ad213ee855f4b5c17687e0e4e0d421e2057e987",
      "start_line": 65,
      "text": "  rule finalScratchDigit(N, D) => D\n    requires N <=Int 0"
    },
    {
      "attributes": [],
      "end_line": 69,
      "module": "VERIFICATION",
      "normalized_sha256": "bd4d10518278875bfc2e732411dd8f7adf6cfa7803bd88a85b0e94d0afaeab06",
      "source_rule_id": "rule-bd4d10518278875bfc2e732411dd8f7adf6cfa7803bd88a85b0e94d0afaeab06",
      "start_line": 67,
      "text": "  rule finalScratchDigit(N, _D)\n    => finalScratchDigit(N /Int 10, N %Int 10)\n    requires N >Int 0"
    }
