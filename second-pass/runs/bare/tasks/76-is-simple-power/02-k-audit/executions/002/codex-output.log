new file mode 100644
index 0000000000000000000000000000000000000000..259e2d87b5d872282da0dc914f21aa928b385f94
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def is_simple_power(x, n):
+    if x == 1:
+        return True
+    if x < 1:
+        return False
+    if n < 2:
+        return False
+    power = n
+    while power < x:
+        power = power * n
+    return power == x
