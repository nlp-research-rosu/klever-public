+++ b/evidence/toolchain_and_isolation.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+printf 'kompile_path=%s\n' "$(command -v kompile)"
+printf 'kprove_path=%s\n' "$(command -v kprove)"
