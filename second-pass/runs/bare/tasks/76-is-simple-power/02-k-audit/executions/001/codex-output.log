diff --git a/evidence/trace_summary.py b/evidence/trace_summary.py
new file mode 100644
index 0000000000000000000000000000000000000000..f63dc6d56e60be835d00e9e549311b058ed0df59
--- /dev/null
+++ b/evidence/trace_summary.py
@@ -0,0 +1,46 @@
+#!/usr/bin/env python3
+"""Bounded structural summary of the untrusted generation JSONL trace."""
+
+import json
+from collections import Counter, deque
+from pathlib import Path
+
+
+trace_paths = sorted(Path("/candidate/codex-trace").rglob("*"))
+trace_paths = [path for path in trace_paths if path.is_file()]
+print(f"trace_file_count={len(trace_paths)}")
+
+for path in trace_paths:
+    counts: Counter[str] = Counter()
+    event_counts: Counter[str] = Counter()
+    invalid = []
+    first = []
+    last = deque(maxlen=8)
+    line_count = 0
+    for line_count, line in enumerate(path.open(encoding="utf-8"), start=1):
+        try:
+            item = json.loads(line)
+        except json.JSONDecodeError as error:
+            invalid.append((line_count, str(error)))
+            continue
+        kind = item.get("type", "<missing>")
+        counts[kind] += 1
+        record = {
+            "line": line_count,
+            "timestamp": item.get("timestamp"),
+            "type": kind,
+        }
+        if kind == "event_msg":
+            payload_kind = item.get("payload", {}).get("type", "<missing>")
+            event_counts[payload_kind] += 1
+            record["payload_type"] = payload_kind
+        if len(first) < 8:
+            first.append(record)
+        last.append(record)
+    print(f"path={path}")
+    print(f"line_count={line_count}")
+    print(f"top_level_counts={dict(sorted(counts.items()))}")
+    print(f"event_counts={dict(sorted(event_counts.items()))}")
+    print(f"invalid_json={invalid}")
+    print(f"first={first}")
+    print(f"last={list(last)}")

diff --git a/evidence/artifacts/spec-body-sensitivity.k b/evidence/artifacts/spec-body-sensitivity.k
new file mode 100644
index 0000000000000000000000000000000000000000..d1fb87c41a299626af8b20563c0abff546045f19
--- /dev/null
+++ b/evidence/artifacts/spec-body-sensitivity.k
@@ -0,0 +1,35 @@
+requires "verification.k"
+
+module SPEC-BODY-SENSITIVITY
+  imports VERIFICATION
+
+  // Deliberately mutate the real loop multiplier from n to the integer 3.
+  // This keeps every mutated construct inside the modeled language.
+  // The original active-path target must no longer be reachable.
+  claim [mutated-body-does-not-reach-original-loop]:
+    <k>
+      Module(
+        FuncDef("is_simple_power", Params("x", "n"),
+          If(Compare(Name("x"), CmpOp("==", Int(1))),
+            Return(Bool(true)),
+            .Stmts)
+          If(Compare(Name("x"), CmpOp("<", Int(1))),
+            Return(Bool(false)),
+            .Stmts)
+          If(Compare(Name("n"), CmpOp("<", Int(2))),
+            Return(Bool(false)),
+            .Stmts)
+          Assign(Name("power"), Name("n"))
+          While(Compare(Name("power"), CmpOp("<", Name("x"))),
+            Assign(Name("power"), BinOp("*", Name("power"), Int(3))))
+          Return(Compare(Name("power"), CmpOp("==", Name("x"))))))
+      => While(Compare(Name("power"), CmpOp("<", Name("x"))),
+           Assign(Name("power"), BinOp("*", Name("power"), Name("n"))))
+         ~> exec(Return(Compare(Name("power"), CmpOp("==", Name("x")))))
+    </k>
+    <env> .Map => ("x" |-> 8) ("n" |-> 2) ("power" |-> 2) </env>
+    <result> noResult </result>
+    <x> 8 </x>
+    <n> 2 </n>
+
+endmodule
