# canonical.py — the UNMODIFIED HumanEval/76 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: is_simple_power


def is_simple_power(x, n):
    """Your task is to write a function that returns true if a number x is a simple
    power of n and false in other cases.
    x is a simple power of n if n**int=x
    For example:
    is_simple_power(1, 4) => true
    is_simple_power(2, 2) => true
    is_simple_power(8, 2) => true
    is_simple_power(3, 2) => false
    is_simple_power(3, 1) => false
    is_simple_power(5, 3) => false
    """
    if (n == 1): 
        return (x == 1) 
    power = 1
    while (power < x): 
        power = power * n 
    return (power == x) 
def is_simple_power(x, n):
    if x == 1:
        return True
    if x < 1:
        return False
    if n < 2:
        return False
    power = n
    while power < x:
        power = power * n
    return power == x
Module(
  FuncDef("is_simple_power", Params("x", "n"),
    If(Compare(Name("x"), CmpOp("==", Int(1))),
      Return(Bool(true)),
      )
    If(Compare(Name("x"), CmpOp("<", Int(1))),
      Return(Bool(false)),
      )
    If(Compare(Name("n"), CmpOp("<", Int(2))),
      Return(Bool(false)),
      )
    Assign(Name("power"), Name("n"))
    While(Compare(Name("power"), CmpOp("<", Name("x"))),
      Assign(Name("power"), BinOp("*", Name("power"), Name("n"))))
    Return(Compare(Name("power"), CmpOp("==", Name("x"))))))
module MPY-SYNTAX
  imports INT-SYNTAX
  imports BOOL-SYNTAX
  imports STRING-SYNTAX

  syntax Program ::= "Module" "(" Stmts ")"

  syntax Stmts ::= List{Stmt, ""}
  syntax Ids   ::= List{String, ","}

  syntax Stmt ::= "FuncDef" "(" String "," "Params" "(" Ids ")" "," Stmts ")"
                | "If" "(" Exp "," Stmts "," Stmts ")"
                | "While" "(" Exp "," Stmts ")"
                | "Assign" "(" Exp "," Exp ")"
                | "Return" "(" Exp ")"

  syntax Exp ::= "Int" "(" Int ")"
               | "Bool" "(" Bool ")"
               | "Name" "(" String ")"
               | "BinOp" "(" String "," Exp "," Exp ")"
               | "Compare" "(" Exp "," CmpOp ")"

  syntax CmpOp ::= "CmpOp" "(" String "," Exp ")"
endmodule

module SEMANTIC
  imports MPY-SYNTAX
  imports INT
  imports BOOL
  imports MAP

  syntax Value ::= Int | Bool
  syntax Result ::= "noResult" | Value

  configuration
    <mpy>
      <k> $PGM:Program </k>
      <env> .Map </env>
      <result> noResult </result>
      <x> $X:Int </x>
      <n> $N:Int </n>
    </mpy>

  syntax KItem ::= "exec" "(" Stmts ")"
                 | "eval" "(" Exp ")"
                 | "choose" "(" Stmts "," Stmts ")"
                 | "loop" "(" Exp "," Stmts ")"
                 | "assignTo" "(" String ")"
                 | "returnValue"
                 | "binRight" "(" String "," Exp ")"
                 | "binApply" "(" String "," Value ")"
                 | "cmpRight" "(" String "," Exp ")"
                 | "cmpApply" "(" String "," Value ")"

  rule <k> Module(FuncDef("is_simple_power", Params("x", "n"), BODY))
        => exec(BODY) </k>
       <env> .Map => ("x" |-> X) ("n" |-> N) </env>
       <x> X </x>
       <n> N </n>

  rule <k> exec(.Stmts) => .K ... </k>
  rule <k> exec(S SS) => S ~> exec(SS) ... </k>

  rule <k> If(E, THEN, ELSE) => eval(E) ~> choose(THEN, ELSE) ... </k>
  rule <k> true  ~> choose(THEN, _) => exec(THEN) ... </k>
  rule <k> false ~> choose(_, ELSE) => exec(ELSE) ... </k>

  rule <k> While(E, BODY) => eval(E) ~> loop(E, BODY) ... </k>
  rule <k> true  ~> loop(E, BODY) => exec(BODY) ~> While(E, BODY) ... </k>
  rule <k> false ~> loop(_, _) => .K ... </k>

  rule <k> Assign(Name(NAME), E) => eval(E) ~> assignTo(NAME) ... </k>
  rule <k> V:Value ~> assignTo(NAME) => .K ... </k>
       <env> RHO => RHO [ NAME <- V ] </env>

  rule <k> Return(E) => eval(E) ~> returnValue ... </k>
  rule <k> V:Value ~> returnValue ~> _REST:K => .K </k>
       <result> noResult => V </result>

  rule <k> eval(Int(I)) => I ... </k>
  rule <k> eval(Bool(B)) => B ... </k>
  rule <k> eval(Name(NAME)) => V ... </k>
       <env> ... NAME |-> V:Value ... </env>

  rule <k> eval(BinOp(OP, LEFT, RIGHT))
        => eval(LEFT) ~> binRight(OP, RIGHT) ... </k>
  rule <k> LEFT:Value ~> binRight(OP, RIGHT)
        => eval(RIGHT) ~> binApply(OP, LEFT) ... </k>
  rule <k> RIGHT:Int ~> binApply("*", LEFT:Int)
        => LEFT *Int RIGHT ... </k>

  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT)))
        => eval(LEFT) ~> cmpRight(OP, RIGHT) ... </k>
  rule <k> LEFT:Value ~> cmpRight(OP, RIGHT)
        => eval(RIGHT) ~> cmpApply(OP, LEFT) ... </k>
  rule <k> RIGHT:Int ~> cmpApply("==", LEFT:Int)
        => LEFT ==Int RIGHT ... </k>
  rule <k> RIGHT:Int ~> cmpApply("<", LEFT:Int)
        => LEFT <Int RIGHT ... </k>
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  // This is the literal tree in solution.mpy; the claim checks that the
  // shared proof abbreviation expands to exactly that emitted program.
  claim [emitted-tree-is-shared-tree]:
    <k>
      Module(
        FuncDef("is_simple_power", Params("x", "n"),
          If(Compare(Name("x"), CmpOp("==", Int(1))),
            Return(Bool(true)),
            .Stmts)
          If(Compare(Name("x"), CmpOp("<", Int(1))),
            Return(Bool(false)),
            .Stmts)
          If(Compare(Name("n"), CmpOp("<", Int(2))),
            Return(Bool(false)),
            .Stmts)
          Assign(Name("power"), Name("n"))
          While(Compare(Name("power"), CmpOp("<", Name("x"))),
            Assign(Name("power"), BinOp("*", Name("power"), Name("n"))))
          Return(Compare(Name("power"), CmpOp("==", Name("x"))))))
      => solutionProgram
    </k>
    <env> .Map </env>
    <result> noResult </result>
    <x> _X </x>
    <n> _N </n>

  // These four path claims partition all integer inputs.  The final active
  // path reaches the source configuration of loop-correct with P = N.
  claim [returns-on-one]:
    <k> solutionProgram => .K </k>
    <env> .Map => ("x" |-> 1) ("n" |-> N) </env>
    <result> noResult => simplePowerSpec(1, N) </result>
    <x> 1 </x>
    <n> N </n>

  claim [rejects-below-one]:
    <k> solutionProgram => .K </k>
    <env> .Map => ("x" |-> X) ("n" |-> N) </env>
    <result> noResult => simplePowerSpec(X, N) </result>
    <x> X </x>
    <n> N </n>
    requires X <Int 1

  claim [rejects-small-base]:
    <k> solutionProgram => .K </k>
    <env> .Map => ("x" |-> X) ("n" |-> N) </env>
    <result> noResult => simplePowerSpec(X, N) </result>
    <x> X </x>
    <n> N </n>
    requires 1 <Int X andBool N <Int 2

  claim [active-path-enters-loop]:
    <k>
      solutionProgram
      => While(Compare(Name("power"), CmpOp("<", Name("x"))),
           Assign(Name("power"), BinOp("*", Name("power"), Name("n"))))
         ~> exec(Return(Compare(Name("power"), CmpOp("==", Name("x")))))
    </k>
    <env>
      .Map => ("x" |-> X) ("n" |-> N) ("power" |-> N)
    </env>
    <result> noResult </result>
    <x> X </x>
    <n> N </n>
    requires 1 <Int X andBool 2 <=Int N

  claim [loop-correct]:
    <k>
      While(Compare(Name("power"), CmpOp("<", Name("x"))),
        Assign(Name("power"), BinOp("*", Name("power"), Name("n"))))
      ~> exec(Return(Compare(Name("power"), CmpOp("==", Name("x")))))
      => .K
    </k>
    <env>
      ("x" |-> X) ("n" |-> N) ("power" |-> P)
      => ("x" |-> X) ("n" |-> N)
         ("power" |-> powerCeiling(P, X, N))
    </env>
    <result> noResult => powerCeiling(P, X, N) ==Int X </result>
    <x> X </x>
    <n> N </n>
    requires 1 <Int X andBool 2 <=Int N andBool 0 <Int P

endmodule
requires "semantic.k"

module VERIFICATION
  imports SEMANTIC

  // A named copy of the exact constructor tree emitted in solution.mpy.
  // Keeping it here lets the path-partition claims share one source term.
  syntax Program ::= "solutionProgram" [function, total]
  rule solutionProgram
    => Module(
         FuncDef("is_simple_power", Params("x", "n"),
           If(Compare(Name("x"), CmpOp("==", Int(1))),
             Return(Bool(true)),
             .Stmts)
           If(Compare(Name("x"), CmpOp("<", Int(1))),
             Return(Bool(false)),
             .Stmts)
           If(Compare(Name("n"), CmpOp("<", Int(2))),
             Return(Bool(false)),
             .Stmts)
           Assign(Name("power"), Name("n"))
           While(Compare(Name("power"), CmpOp("<", Name("x"))),
             Assign(Name("power"), BinOp("*", Name("power"), Name("n"))))
           Return(Compare(Name("power"), CmpOp("==", Name("x"))))))

  // For P > 0 and N >= 2, this is the first member of
  // P, P*N, P*N*N, ... that is greater than or equal to X.
  syntax Int ::= powerCeiling(Int, Int, Int) [function, total]
  rule powerCeiling(P, X, N) => powerCeiling(P *Int N, X, N)
    requires P <Int X
  rule powerCeiling(P, X, _N) => P
    requires X <=Int P

  // The contract over integers.  The exponent may be zero, so 1 is a
  // simple power of every base.  Nontrivial powers use bases at least 2.
  syntax Bool ::= simplePowerSpec(Int, Int) [function, total]
  rule simplePowerSpec(X, N)
    => (X ==Int 1)
       orBool (1 <Int X
               andBool 2 <=Int N
               andBool powerCeiling(N, X, N) ==Int X)

endmodule
