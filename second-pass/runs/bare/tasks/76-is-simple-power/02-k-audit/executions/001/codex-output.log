+done
+echo "positive_proof_logs=PASS"
+
+grep -Fq 'WarnStuckClaimState' \
+  /audit-output/evidence/logs/16-vacuity-proof-expected-failure.log
+grep -Fxq 'EXIT_STATUS: 1' \
+  /audit-output/evidence/logs/16-vacuity-proof-expected-failure.log
+grep -Fq '<result>' \
+  /audit-output/evidence/logs/16-vacuity-proof-expected-failure.log
+grep -Fq 'true' \
+  /audit-output/evidence/logs/16-vacuity-proof-expected-failure.log
+echo "non_vacuity_log=PASS"
+
+python3 -m py_compile \
