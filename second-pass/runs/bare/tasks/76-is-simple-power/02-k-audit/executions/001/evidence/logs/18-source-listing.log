     1	module MPY-SYNTAX
     2	  imports INT-SYNTAX
     3	  imports BOOL-SYNTAX
     4	  imports STRING-SYNTAX
     5	
     6	  syntax Program ::= "Module" "(" Stmts ")"
     7	
     8	  syntax Stmts ::= List{Stmt, ""}
     9	  syntax Ids   ::= List{String, ","}
    10	
    11	  syntax Stmt ::= "FuncDef" "(" String "," "Params" "(" Ids ")" "," Stmts ")"
    12	                | "If" "(" Exp "," Stmts "," Stmts ")"
    13	                | "While" "(" Exp "," Stmts ")"
    14	                | "Assign" "(" Exp "," Exp ")"
    15	                | "Return" "(" Exp ")"
    16	
    17	  syntax Exp ::= "Int" "(" Int ")"
    18	               | "Bool" "(" Bool ")"
    19	               | "Name" "(" String ")"
    20	               | "BinOp" "(" String "," Exp "," Exp ")"
    21	               | "Compare" "(" Exp "," CmpOp ")"
    22	
    23	  syntax CmpOp ::= "CmpOp" "(" String "," Exp ")"
    24	endmodule
    25	
    26	module SEMANTIC
    27	  imports MPY-SYNTAX
    28	  imports INT
    29	  imports BOOL
    30	  imports MAP
    31	
    32	  syntax Value ::= Int | Bool
    33	  syntax Result ::= "noResult" | Value
    34	
    35	  configuration
    36	    <mpy>
    37	      <k> $PGM:Program </k>
    38	      <env> .Map </env>
    39	      <result> noResult </result>
    40	      <x> $X:Int </x>
    41	      <n> $N:Int </n>
    42	    </mpy>
    43	
    44	  syntax KItem ::= "exec" "(" Stmts ")"
    45	                 | "eval" "(" Exp ")"
    46	                 | "choose" "(" Stmts "," Stmts ")"
    47	                 | "loop" "(" Exp "," Stmts ")"
    48	                 | "assignTo" "(" String ")"
    49	                 | "returnValue"
    50	                 | "binRight" "(" String "," Exp ")"
    51	                 | "binApply" "(" String "," Value ")"
    52	                 | "cmpRight" "(" String "," Exp ")"
    53	                 | "cmpApply" "(" String "," Value ")"
    54	
    55	  rule <k> Module(FuncDef("is_simple_power", Params("x", "n"), BODY))
    56	        => exec(BODY) </k>
    57	       <env> .Map => ("x" |-> X) ("n" |-> N) </env>
    58	       <x> X </x>
    59	       <n> N </n>
    60	
    61	  rule <k> exec(.Stmts) => .K ... </k>
    62	  rule <k> exec(S SS) => S ~> exec(SS) ... </k>
    63	
    64	  rule <k> If(E, THEN, ELSE) => eval(E) ~> choose(THEN, ELSE) ... </k>
    65	  rule <k> true  ~> choose(THEN, _) => exec(THEN) ... </k>
    66	  rule <k> false ~> choose(_, ELSE) => exec(ELSE) ... </k>
    67	
    68	  rule <k> While(E, BODY) => eval(E) ~> loop(E, BODY) ... </k>
    69	  rule <k> true  ~> loop(E, BODY) => exec(BODY) ~> While(E, BODY) ... </k>
    70	  rule <k> false ~> loop(_, _) => .K ... </k>
    71	
    72	  rule <k> Assign(Name(NAME), E) => eval(E) ~> assignTo(NAME) ... </k>
    73	  rule <k> V:Value ~> assignTo(NAME) => .K ... </k>
    74	       <env> RHO => RHO [ NAME <- V ] </env>
    75	
    76	  rule <k> Return(E) => eval(E) ~> returnValue ... </k>
    77	  rule <k> V:Value ~> returnValue ~> _REST:K => .K </k>
    78	       <result> noResult => V </result>
    79	
    80	  rule <k> eval(Int(I)) => I ... </k>
    81	  rule <k> eval(Bool(B)) => B ... </k>
    82	  rule <k> eval(Name(NAME)) => V ... </k>
    83	       <env> ... NAME |-> V:Value ... </env>
    84	
    85	  rule <k> eval(BinOp(OP, LEFT, RIGHT))
    86	        => eval(LEFT) ~> binRight(OP, RIGHT) ... </k>
    87	  rule <k> LEFT:Value ~> binRight(OP, RIGHT)
    88	        => eval(RIGHT) ~> binApply(OP, LEFT) ... </k>
    89	  rule <k> RIGHT:Int ~> binApply("*", LEFT:Int)
    90	        => LEFT *Int RIGHT ... </k>
    91	
    92	  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT)))
    93	        => eval(LEFT) ~> cmpRight(OP, RIGHT) ... </k>
    94	  rule <k> LEFT:Value ~> cmpRight(OP, RIGHT)
    95	        => eval(RIGHT) ~> cmpApply(OP, LEFT) ... </k>
    96	  rule <k> RIGHT:Int ~> cmpApply("==", LEFT:Int)
    97	        => LEFT ==Int RIGHT ... </k>
    98	  rule <k> RIGHT:Int ~> cmpApply("<", LEFT:Int)
    99	        => LEFT <Int RIGHT ... </k>
   100	endmodule
