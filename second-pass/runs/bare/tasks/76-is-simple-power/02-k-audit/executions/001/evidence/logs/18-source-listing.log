    21	          Assign(Name("power"), Name("n"))
    22	          While(Compare(Name("power"), CmpOp("<", Name("x"))),
    23	            Assign(Name("power"), BinOp("*", Name("power"), Name("n"))))
    24	          Return(Compare(Name("power"), CmpOp("==", Name("x"))))))
    25	      => solutionProgram
    26	    </k>
