     1	def is_simple_power(x, n):
     2	    if x == 1:
     3	        return True
     4	    if x < 1:
     5	        return False
     6	    if n < 2:
     7	        return False
     8	    power = n
     9	    while power < x:
    10	        power = power * n
    11	    return power == x
