     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // A named copy of the exact constructor tree emitted in solution.mpy.
     7	  // Keeping it here lets the path-partition claims share one source term.
     8	  syntax Program ::= "solutionProgram" [function, total]
     9	  rule solutionProgram
    10	    => Module(
    11	         FuncDef("is_simple_power", Params("x", "n"),
    12	           If(Compare(Name("x"), CmpOp("==", Int(1))),
    13	             Return(Bool(true)),
    14	             .Stmts)
    15	           If(Compare(Name("x"), CmpOp("<", Int(1))),
    16	             Return(Bool(false)),
    17	             .Stmts)
    18	           If(Compare(Name("n"), CmpOp("<", Int(2))),
    19	             Return(Bool(false)),
    20	             .Stmts)
    21	           Assign(Name("power"), Name("n"))
    22	           While(Compare(Name("power"), CmpOp("<", Name("x"))),
    23	             Assign(Name("power"), BinOp("*", Name("power"), Name("n"))))
    24	           Return(Compare(Name("power"), CmpOp("==", Name("x"))))))
    25	
    26	  // For P > 0 and N >= 2, this is the first member of
    27	  // P, P*N, P*N*N, ... that is greater than or equal to X.
    28	  syntax Int ::= powerCeiling(Int, Int, Int) [function, total]
    29	  rule powerCeiling(P, X, N) => powerCeiling(P *Int N, X, N)
    30	    requires P <Int X
    31	  rule powerCeiling(P, X, _N) => P
    32	    requires X <=Int P
    33	
    34	  // The contract over integers.  The exponent may be zero, so 1 is a
    35	  // simple power of every base.  Nontrivial powers use bases at least 2.
    36	  syntax Bool ::= simplePowerSpec(Int, Int) [function, total]
    37	  rule simplePowerSpec(X, N)
    38	    => (X ==Int 1)
    39	       orBool (1 <Int X
    40	               andBool 2 <=Int N
    41	               andBool powerCeiling(N, X, N) ==Int X)
    42	
    43	endmodule
