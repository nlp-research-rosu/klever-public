diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..82eb6f39c129115337574faf59601482023b468f
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,100 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Ids   ::= List{String, ","}
+
+  syntax Stmt ::= "FuncDef" "(" String "," "Params" "(" Ids ")" "," Stmts ")"
+                | "If" "(" Exp "," Stmts "," Stmts ")"
+                | "While" "(" Exp "," Stmts ")"
+                | "Assign" "(" Exp "," Exp ")"
+                | "Return" "(" Exp ")"
+
+  syntax Exp ::= "Int" "(" Int ")"
+               | "Bool" "(" Bool ")"
+               | "Name" "(" String ")"
+               | "BinOp" "(" String "," Exp "," Exp ")"
+               | "Compare" "(" Exp "," CmpOp ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Exp ")"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports MAP
+
+  syntax Value ::= Int | Bool
+  syntax Result ::= "noResult" | Value
+
+  configuration
+    <mpy>
+      <k> $PGM:Program </k>
+      <env> .Map </env>
+      <result> noResult </result>
+      <x> $X:Int </x>
+      <n> $N:Int </n>
+    </mpy>
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "eval" "(" Exp ")"
+                 | "choose" "(" Stmts "," Stmts ")"
+                 | "loop" "(" Exp "," Stmts ")"
+                 | "assignTo" "(" String ")"
+                 | "returnValue"
+                 | "binRight" "(" String "," Exp ")"
+                 | "binApply" "(" String "," Value ")"
+                 | "cmpRight" "(" String "," Exp ")"
+                 | "cmpApply" "(" String "," Value ")"
+
+  rule <k> Module(FuncDef("is_simple_power", Params("x", "n"), BODY))
+        => exec(BODY) </k>
+       <env> .Map => ("x" |-> X) ("n" |-> N) </env>
+       <x> X </x>
+       <n> N </n>
+
+  rule <k> exec(.Stmts) => .K ... </k>
+  rule <k> exec(S SS) => S ~> exec(SS) ... </k>
+
+  rule <k> If(E, THEN, ELSE) => eval(E) ~> choose(THEN, ELSE) ... </k>
+  rule <k> true  ~> choose(THEN, _) => exec(THEN) ... </k>
+  rule <k> false ~> choose(_, ELSE) => exec(ELSE) ... </k>
+
+  rule <k> While(E, BODY) => eval(E) ~> loop(E, BODY) ... </k>
+  rule <k> true  ~> loop(E, BODY) => exec(BODY) ~> While(E, BODY) ... </k>
+  rule <k> false ~> loop(_, _) => .K ... </k>
+
+  rule <k> Assign(Name(NAME), E) => eval(E) ~> assignTo(NAME) ... </k>
+  rule <k> V:Value ~> assignTo(NAME) => .K ... </k>
+       <env> RHO => RHO [ NAME <- V ] </env>
+
+  rule <k> Return(E) => eval(E) ~> returnValue ... </k>
+  rule <k> V:Value ~> returnValue ~> _REST:K => .K </k>
+       <result> noResult => V </result>
+
+  rule <k> eval(Int(I)) => I ... </k>
+  rule <k> eval(Bool(B)) => B ... </k>
+  rule <k> eval(Name(NAME)) => V ... </k>
+       <env> ... NAME |-> V:Value ... </env>
+
+  rule <k> eval(BinOp(OP, LEFT, RIGHT))
+        => eval(LEFT) ~> binRight(OP, RIGHT) ... </k>
+  rule <k> LEFT:Value ~> binRight(OP, RIGHT)
+        => eval(RIGHT) ~> binApply(OP, LEFT) ... </k>
+  rule <k> RIGHT:Int ~> binApply("*", LEFT:Int)
+        => LEFT *Int RIGHT ... </k>
+
+  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT)))
+        => eval(LEFT) ~> cmpRight(OP, RIGHT) ... </k>
+  rule <k> LEFT:Value ~> cmpRight(OP, RIGHT)
+        => eval(RIGHT) ~> cmpApply(OP, LEFT) ... </k>
+  rule <k> RIGHT:Int ~> cmpApply("==", LEFT:Int)
+        => LEFT ==Int RIGHT ... </k>
+  rule <k> RIGHT:Int ~> cmpApply("<", LEFT:Int)
+        => LEFT <Int RIGHT ... </k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..259e2d87b5d872282da0dc914f21aa928b385f94
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def is_simple_power(x, n):
+    if x == 1:
+        return True
+    if x < 1:
+        return False
+    if n < 2:
+        return False
+    power = n
+    while power < x:
+        power = power * n
+    return power == x
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..67c0afafc2532046d6595eb1ac5c260e9a61fb62
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,46 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-correct]:
+    <k>
+      While(Compare(Name("power"), CmpOp("<", Name("x"))),
+        Assign(Name("power"), BinOp("*", Name("power"), Name("n"))))
+      ~> exec(Return(Compare(Name("power"), CmpOp("==", Name("x")))))
+      => .K
+    </k>
+    <env>
+      ("x" |-> X) ("n" |-> N) ("power" |-> P)
+      => ("x" |-> X) ("n" |-> N)
+         ("power" |-> powerCeiling(P, X, N))
+    </env>
+    <result> noResult => powerCeiling(P, X, N) ==Int X </result>
+    <x> X </x>
+    <n> N </n>
+    requires 1 <Int X andBool 2 <=Int N andBool 0 <Int P
+
+  claim [program-correct]:
+    <k>
+      Module(
+        FuncDef("is_simple_power", Params("x", "n"),
+          If(Compare(Name("x"), CmpOp("==", Int(1))),
+            Return(Bool(true)),
+            .Stmts)
+          If(Compare(Name("x"), CmpOp("<", Int(1))),
+            Return(Bool(false)),
+            .Stmts)
+          If(Compare(Name("n"), CmpOp("<", Int(2))),
+            Return(Bool(false)),
+            .Stmts)
+          Assign(Name("power"), Name("n"))
+          While(Compare(Name("power"), CmpOp("<", Name("x"))),
+            Assign(Name("power"), BinOp("*", Name("power"), Name("n"))))
+          Return(Compare(Name("power"), CmpOp("==", Name("x"))))))
+      => .K
+    </k>
+    <env> .Map => finalEnv(X, N) </env>
+    <result> noResult => simplePowerSpec(X, N) </result>
+    <x> X </x>
+    <n> N </n>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2b906ed46b42d9e21f87b8022b6a7945ea5b1407
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,32 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // For P > 0 and N >= 2, this is the first member of
+  // P, P*N, P*N*N, ... that is greater than or equal to X.
+  syntax Int ::= powerCeiling(Int, Int, Int) [function, total]
+  rule powerCeiling(P, X, N) => powerCeiling(P *Int N, X, N)
+    requires P <Int X
+  rule powerCeiling(P, X, _N) => P
+    requires X <=Int P
+
+  // The contract over integers.  The exponent may be zero, so 1 is a
+  // simple power of every base.  Nontrivial powers use bases at least 2.
+  syntax Bool ::= simplePowerSpec(Int, Int) [function, total]
+  rule simplePowerSpec(X, N)
+    => (X ==Int 1)
+       orBool (1 <Int X
+               andBool 2 <=Int N
+               andBool powerCeiling(N, X, N) ==Int X)
+
+  syntax Map ::= finalEnv(Int, Int) [function, total]
+  rule finalEnv(X, N) => ("x" |-> X) ("n" |-> N)
+    requires X <=Int 1
+  rule finalEnv(X, N) => ("x" |-> X) ("n" |-> N)
+    requires 1 <Int X andBool N <Int 2
+  rule finalEnv(X, N)
+    => ("x" |-> X) ("n" |-> N)
+       ("power" |-> powerCeiling(N, X, N))
+    requires 1 <Int X andBool 2 <=Int N
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-v2-kompiled --claims SPEC.program-correct,SPEC.loop-correct --trusted SPEC.loop-correct' in /work
