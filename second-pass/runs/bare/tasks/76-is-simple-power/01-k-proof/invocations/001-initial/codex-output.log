+
+  run_output="$(
+    krun solution.mpy \
+      -cX="$case_x" \
+      -cN="$case_n" \
+      --definition build/semantic-kompiled
+  )"
+  printf '%s\n' "$run_output"
+  printf '%s\n' "$run_output" \
+    | rg -q -U "<result>[[:space:]]*${expected}[[:space:]]*</result>"
+}
+
+check_case 1 4 true
+check_case 2 2 true
+check_case 8 2 true
+check_case 3 2 false
+check_case 3 1 false
+check_case 5 3 false
+
+kompile verification.k \
