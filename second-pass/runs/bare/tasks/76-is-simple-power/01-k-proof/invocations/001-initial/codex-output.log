+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // These four path claims partition all integer inputs.  The final active
+  // path reaches the source configuration of loop-correct with P = N.
+  claim [returns-on-one]:
+    <k> solutionProgram => .K </k>
+    <env> .Map => ("x" |-> 1) ("n" |-> N) </env>
+    <result> noResult => true </result>
+    <x> 1 </x>
+    <n> N </n>
+
+  claim [rejects-below-one]:
+    <k> solutionProgram => .K </k>
+    <env> .Map => ("x" |-> X) ("n" |-> N) </env>
+    <result> noResult => false </result>
+    <x> X </x>
+    <n> N </n>
+    requires X <Int 1
+
+  claim [rejects-small-base]:
+    <k> solutionProgram => .K </k>
+    <env> .Map => ("x" |-> X) ("n" |-> N) </env>
+    <result> noResult => false </result>
+    <x> X </x>
+    <n> N </n>
+    requires 1 <Int X andBool N <Int 2
+
+  claim [active-path-enters-loop]:
+    <k>
+      solutionProgram
+      => While(Compare(Name("power"), CmpOp("<", Name("x"))),
+           Assign(Name("power"), BinOp("*", Name("power"), Name("n"))))
+         ~> exec(Return(Compare(Name("power"), CmpOp("==", Name("x")))))
+    </k>
+    <env>
+      .Map => ("x" |-> X) ("n" |-> N) ("power" |-> N)
+    </env>
+    <result> noResult </result>
+    <x> X </x>
+    <n> N </n>
+    requires 1 <Int X andBool 2 <=Int N
+
+  claim [loop-correct]:
+    <k>
+      While(Compare(Name("power"), CmpOp("<", Name("x"))),
+        Assign(Name("power"), BinOp("*", Name("power"), Name("n"))))
+      ~> exec(Return(Compare(Name("power"), CmpOp("==", Name("x")))))
+      => .K
+    </k>
+    <env>
+      ("x" |-> X) ("n" |-> N) ("power" |-> P)
+      => ("x" |-> X) ("n" |-> N)
+         ("power" |-> powerCeiling(P, X, N))
+    </env>
+    <result> noResult => powerCeiling(P, X, N) ==Int X </result>
+    <x> X </x>
+    <n> N </n>
+    requires 1 <Int X andBool 2 <=Int N andBool 0 <Int P
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a9c41facd61ebc267180ef6f96c364174204efe2
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,43 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A named copy of the exact constructor tree emitted in solution.mpy.
+  // Keeping it here lets the path-partition claims share one source term.
+  syntax Program ::= "solutionProgram" [function, total]
+  rule solutionProgram
+    => Module(
+         FuncDef("is_simple_power", Params("x", "n"),
+           If(Compare(Name("x"), CmpOp("==", Int(1))),
+             Return(Bool(true)),
+             .Stmts)
+           If(Compare(Name("x"), CmpOp("<", Int(1))),
+             Return(Bool(false)),
+             .Stmts)
+           If(Compare(Name("n"), CmpOp("<", Int(2))),
+             Return(Bool(false)),
+             .Stmts)
+           Assign(Name("power"), Name("n"))
+           While(Compare(Name("power"), CmpOp("<", Name("x"))),
+             Assign(Name("power"), BinOp("*", Name("power"), Name("n"))))
+           Return(Compare(Name("power"), CmpOp("==", Name("x"))))))
+
+  // For P > 0 and N >= 2, this is the first member of
+  // P, P*N, P*N*N, ... that is greater than or equal to X.
+  syntax Int ::= powerCeiling(Int, Int, Int) [function, total]
+  rule powerCeiling(P, X, N) => powerCeiling(P *Int N, X, N)
+    requires P <Int X
+  rule powerCeiling(P, X, _N) => P
+    requires X <=Int P
+
+  // The contract over integers.  The exponent may be zero, so 1 is a
+  // simple power of every base.  Nontrivial powers use bases at least 2.
+  syntax Bool ::= simplePowerSpec(Int, Int) [function, total]
+  rule simplePowerSpec(X, N)
+    => (X ==Int 1)
+       orBool (1 <Int X
+               andBool 2 <=Int N
+               andBool powerCeiling(N, X, N) ==Int X)
+
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX -o verification-v3-kompiled && kprove spec.k --definition verification-v3-kompiled' in /work
