+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-correct]:
+    <k>
+      While(Compare(Name("power"), CmpOp("<", Name("x"))),
+        Assign(Name("power"), BinOp("*", Name("power"), Name("n"))))
+      ~> exec(Return(Compare(Name("power"), CmpOp("==", Name("x")))))
+      => .K
+    </k>
+    <env>
+      ("x" |-> X) ("n" |-> N) ("power" |-> P)
+      => ("x" |-> X) ("n" |-> N)
+         ("power" |-> powerCeiling(P, X, N))
+    </env>
+    <result> noResult => powerCeiling(P, X, N) ==Int X </result>
+    <x> X </x>
+    <n> N </n>
+    requires 1 <Int X andBool 2 <=Int N andBool 0 <Int P
+
+  claim [program-correct]:
+    <k>
+      Module(
+        FuncDef("is_simple_power", Params("x", "n"),
+          If(Compare(Name("x"), CmpOp("==", Int(1))),
+            Return(Bool(true)),
+            .Stmts)
+          If(Compare(Name("x"), CmpOp("<", Int(1))),
+            Return(Bool(false)),
+            .Stmts)
+          If(Compare(Name("n"), CmpOp("<", Int(2))),
+            Return(Bool(false)),
+            .Stmts)
+          Assign(Name("power"), Name("n"))
+          While(Compare(Name("power"), CmpOp("<", Name("x"))),
+            Assign(Name("power"), BinOp("*", Name("power"), Name("n"))))
+          Return(Compare(Name("power"), CmpOp("==", Name("x"))))))
+      => .K
+    </k>
+    <env> .Map => finalEnv(X, N) </env>
+    <result> noResult => simplePowerSpec(X, N) </result>
+    <x> X </x>
+    <n> N </n>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2b906ed46b42d9e21f87b8022b6a7945ea5b1407
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,32 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // For P > 0 and N >= 2, this is the first member of
+  // P, P*N, P*N*N, ... that is greater than or equal to X.
+  syntax Int ::= powerCeiling(Int, Int, Int) [function, total]
+  rule powerCeiling(P, X, N) => powerCeiling(P *Int N, X, N)
+    requires P <Int X
+  rule powerCeiling(P, X, _N) => P
+    requires X <=Int P
+
+  // The contract over integers.  The exponent may be zero, so 1 is a
+  // simple power of every base.  Nontrivial powers use bases at least 2.
+  syntax Bool ::= simplePowerSpec(Int, Int) [function, total]
+  rule simplePowerSpec(X, N)
+    => (X ==Int 1)
+       orBool (1 <Int X
+               andBool 2 <=Int N
+               andBool powerCeiling(N, X, N) ==Int X)
+
+  syntax Map ::= finalEnv(Int, Int) [function, total]
+  rule finalEnv(X, N) => ("x" |-> X) ("n" |-> N)
+    requires X <=Int 1
+  rule finalEnv(X, N) => ("x" |-> X) ("n" |-> N)
+    requires 1 <Int X andBool N <Int 2
+  rule finalEnv(X, N)
+    => ("x" |-> X) ("n" |-> N)
+       ("power" |-> powerCeiling(N, X, N))
+    requires 1 <Int X andBool 2 <=Int N
+endmodule

