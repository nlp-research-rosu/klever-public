Module(
  FuncDef("digit_sum", Params("num"),
    If(Compare(Name("num"), CmpOp("<", UnaryOp("-", Int(9)))),
      Return(
        BinOp(
          "+",
          BinOp("%", UnaryOp("-", Name("num")), Int(10)),
          Call(
            Name("digit_sum"),
            UnaryOp(
              "-",
              BinOp("//", UnaryOp("-", Name("num")), Int(10)))))),
      If(Compare(Name("num"), CmpOp(">", Int(9))),
        Return(
          BinOp(
            "+",
            BinOp("%", Name("num"), Int(10)),
            Call(Name("digit_sum"), BinOp("//", Name("num"), Int(10))))),
        Return(Name("num")))))
  FuncDef("count_nums", Params("arr"),
    If(Compare(Name("arr"), CmpOp("==", ListExpr())),
      Return(Int(0)),
      If(Compare(
        Call(Name("digit_sum"), Subscript(Name("arr"), Int(0))),
        CmpOp(">", Int(0))),
        Return(
          BinOp(
            "+",
            Int(1),
            Call(
              Name("count_nums"),
              Subscript(Name("arr"), Slice(Int(1), NoBound, NoBound))))),
        Return(
          Call(
            Name("count_nums"),
            Subscript(Name("arr"), Slice(Int(1), NoBound, NoBound))))))))
