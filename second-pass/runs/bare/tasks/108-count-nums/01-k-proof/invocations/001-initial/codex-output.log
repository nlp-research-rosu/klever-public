+def digit_sum(num):
+    if num < -9:
+        return (-num) % 10 + digit_sum(-((-num) // 10))
+    else:
+        if num > 9:
+            return num % 10 + digit_sum(num // 10)
+        else:
+            return num
+
+
+def count_nums(arr):
