+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Lemma 1: the translated recursive helper implements the mathematical
+  // signed decimal digit sum for every mathematical integer.
+  claim
+    <k> IntV(N) ~> callK("digit_sum") ~> CONT
+      => IntV(signedDigitSum(N)) ~> CONT </k>
+    <funs> solutionFuns </funs>
+    <env> _ENV </env>
+    <stack> _STACK </stack>
+
+  // Lemma 2, empty constructor case.
+  claim
+    <k> ListV(VNil) ~> callK("count_nums") ~> CONT
+      => IntV(0) ~> CONT </k>
+    <funs> solutionFuns </funs>
+    <env> _ENV </env>
+    <stack> _STACK </stack>
+
+  // Lemma 2, nonempty constructor with a positive signed digit sum.
+  claim
+    <k> ListV(VCons(I, REST)) ~> callK("count_nums") ~> CONT
+      => IntV(countPositive(VCons(I, REST))) ~> CONT </k>
+    <funs> solutionFuns </funs>
+    <env> _ENV </env>
+    <stack> _STACK </stack>
+    requires signedDigitSum(I) >Int 0
+
+  // Lemma 2, complementary nonpositive-head case.  The three Lemma 2 claims
+  // are exhaustive and form structural induction over every finite VList.
+  claim
+    <k> ListV(VCons(I, REST)) ~> callK("count_nums") ~> CONT
+      => IntV(countPositive(VCons(I, REST))) ~> CONT </k>
+    <funs> solutionFuns </funs>
+    <env> _ENV </env>
+    <stack> _STACK </stack>
+    requires signedDigitSum(I) <=Int 0
+
+  // End-to-end theorem cases: load the exact program tree and invoke its
+  // required entry point from a clean initial machine state.
+  claim
+    <k> solutionProgram ~> invoke("count_nums", ListV(VNil))
+      => IntV(0) </k>
+    <funs> .Map => solutionFuns </funs>
+    <env> .Map </env>
+    <stack> .List </stack>
+
+  claim
+    <k> solutionProgram ~> invoke("count_nums", ListV(VCons(I, REST)))
+      => IntV(countPositive(VCons(I, REST))) </k>
+    <funs> .Map => solutionFuns </funs>
+    <env> .Map </env>
+    <stack> .List </stack>
+    requires signedDigitSum(I) >Int 0
+
+  claim
+    <k> solutionProgram ~> invoke("count_nums", ListV(VCons(I, REST)))
+      => IntV(countPositive(VCons(I, REST))) </k>
+    <funs> .Map => solutionFuns </funs>
+    <env> .Map </env>
+    <stack> .List </stack>
+    requires signedDigitSum(I) <=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..aeed106d50cc0a989d0a56169744fbbcbbc5471a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,83 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY-SEMANTIC
+
+  // These two macros are the exact bodies emitted in solution.mpy.  Keeping
+  // them named makes the proof claims readable while preserving the link to
+  // the translated program's constructor tree.
+  syntax Stmts ::= "digitBody" [macro]
+                 | "countBody" [macro]
+
+  rule digitBody =>
+    If(Compare(Name("num"), CmpOp("<", UnaryOp("-", Int(9)))),
+      Return(
+        BinOp("+",
+          BinOp("%", UnaryOp("-", Name("num")), Int(10)),
+          Call(Name("digit_sum"),
+            UnaryOp("-",
+              BinOp("//", UnaryOp("-", Name("num")), Int(10)))))),
+      If(Compare(Name("num"), CmpOp(">", Int(9))),
+        Return(
+          BinOp("+",
+            BinOp("%", Name("num"), Int(10)),
+            Call(Name("digit_sum"),
+              BinOp("//", Name("num"), Int(10))))),
+        Return(Name("num"))))
+
+  rule countBody =>
+    If(Compare(Name("arr"), CmpOp("==", ListExpr())),
+      Return(Int(0)),
+      If(Compare(
+          Call(Name("digit_sum"), Subscript(Name("arr"), Int(0))),
+          CmpOp(">", Int(0))),
+        Return(
+          BinOp("+", Int(1),
+            Call(Name("count_nums"),
+              Subscript(Name("arr"),
+                Slice(Int(1), NoBound, NoBound))))),
+        Return(
+          Call(Name("count_nums"),
+            Subscript(Name("arr"),
+              Slice(Int(1), NoBound, NoBound))))))
+
+  syntax Program ::= "solutionProgram" [macro]
+  rule solutionProgram =>
+    Module(
+      FuncDef("digit_sum", Params("num"), digitBody)
+      FuncDef("count_nums", Params("arr"), countBody))
+
+  syntax Map ::= "solutionFuns" [macro]
+  rule solutionFuns =>
+       ("digit_sum" |-> function("num", digitBody))
+       ("count_nums" |-> function("arr", countBody))
+
+  // Mathematical reference: decimal digits are peeled from the right.  A
+  // one-digit negative number is the signed leading digit, exactly as stated
+  // in prompt.py.
+  syntax Int ::= "signedDigitSum" "(" Int ")"
+                 [function, total, symbol(signedDigitSum)]
+
+  rule signedDigitSum(N)
+    => ((0 -Int N) %Int 10)
+       +Int signedDigitSum(0 -Int ((0 -Int N) /Int 10))
+    requires N <Int (0 -Int 9)
+
+  rule signedDigitSum(N)
+    => (N %Int 10) +Int signedDigitSum(N /Int 10)
+    requires N >Int 9
+
+  rule signedDigitSum(N) => N
+    requires N >=Int (0 -Int 9) andBool N <=Int 9
+
+  syntax Int ::= "countPositive" "(" VList ")"
+                 [function, total, symbol(countPositive)]
+  syntax Int ::= "boolToInt" "(" Bool ")"
+                 [function, total, symbol(boolToInt), smt-hook((ite #1 1 0))]
+
+  rule boolToInt(true) => 1
+  rule boolToInt(false) => 0
+  rule countPositive(VNil) => 0
+  rule countPositive(VCons(N, REST))
+    => boolToInt(signedDigitSum(N) >Int 0) +Int countPositive(REST)
+endmodule

