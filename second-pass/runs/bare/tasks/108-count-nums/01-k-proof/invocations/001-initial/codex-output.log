+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Lemma 1: the translated recursive helper implements the mathematical
+  // signed decimal digit sum for every mathematical integer.
+  claim
+    <k> IntV(N) ~> callK("digit_sum") ~> CONT
+      => IntV(signedDigitSum(N)) ~> CONT </k>
+    <funs> solutionFuns </funs>
+    <env> ENV </env>
+    <stack> STACK </stack>
+
+  // Lemma 2: for every finite list of integers, the translated target
+  // function counts exactly those elements whose signed digit sum is > 0.
+  claim
+    <k> ListV(INPUT) ~> callK("count_nums") ~> CONT
+      => IntV(countPositive(INPUT)) ~> CONT </k>
+    <funs> solutionFuns </funs>
+    <env> ENV </env>
+    <stack> STACK </stack>
+
+  // End-to-end theorem: load the exact program tree and invoke its required
+  // entry point from a clean initial machine state.
+  claim
+    <k> solutionProgram ~> invoke("count_nums", ListV(INPUT))
+      => IntV(countPositive(INPUT)) </k>
+    <funs> .Map => solutionFuns </funs>
+    <env> .Map </env>
+    <stack> .List </stack>
+endmodule
