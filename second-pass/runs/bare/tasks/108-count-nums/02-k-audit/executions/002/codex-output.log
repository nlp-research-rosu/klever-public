+#!/usr/bin/env bash
+set -u
+set -o pipefail
+trap 'status=$?; printf "SCRIPT_EXIT_STATUS=%s\n" "$status"' EXIT
+set -x
+
+SCRATCH=/tmp/audit-work/108-count-nums
+cd "$SCRATCH"
+cp /audit-output/evidence/spec-vacuity-audit.k "$SCRATCH/spec-vacuity-audit.k"
+
+kprove spec-vacuity-audit.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY-AUDIT \
+  --dry-run
+dry_run_status=$?
+printf "DRY_RUN_EXIT_STATUS=%s\n" "$dry_run_status"
+
+set +e
+timeout --signal=TERM --kill-after=10 120 \
+  kprove spec-vacuity-audit.k \
+    --definition verification-kompiled \
+    --spec-module SPEC-VACUITY-AUDIT \
+  2>&1 | tee /audit-output/evidence/06_false_mutation_kprove.raw.log
+proof_status=${PIPESTATUS[0]}
+set -e
+
+printf "EXPECTED_PROOF_FAILURE_STATUS=%s\n" "$proof_status"
+test "$dry_run_status" -eq 0
+test "$proof_status" -ne 0
+test "$proof_status" -ne 124
+test "$proof_status" -ne 137
+grep -F 'WarnStuckClaimState' /audit-output/evidence/06_false_mutation_kprove.raw.log
+grep -F 'IntV ( 0 )' /audit-output/evidence/06_false_mutation_kprove.raw.log
+grep -F '=> IntV(1)' /audit-output/evidence/spec-vacuity-audit.k
diff --git a/evidence/spec-labeled.k b/evidence/spec-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..a1f9368cd677f45332743d77b021ff813531d93e
--- /dev/null
+++ b/evidence/spec-labeled.k
@@ -0,0 +1,58 @@
+requires "verification.k"
+
+module SPEC-LABELED
+  imports VERIFICATION
+
+  claim [digit-helper]:
+    <k> IntV(N) ~> callK("digit_sum") ~> CONT
+      => IntV(signedDigitSum(N)) ~> CONT </k>
+    <funs> solutionFuns </funs>
+    <env> _ENV </env>
+    <stack> _STACK </stack>
+
+  claim [count-empty]:
+    <k> ListV(VNil) ~> callK("count_nums") ~> CONT
+      => IntV(0) ~> CONT </k>
+    <funs> solutionFuns </funs>
+    <env> _ENV </env>
+    <stack> _STACK </stack>
+
+  claim [count-positive-head]:
+    <k> ListV(VCons(I, REST)) ~> callK("count_nums") ~> CONT
+      => IntV(countPositive(VCons(I, REST))) ~> CONT </k>
+    <funs> solutionFuns </funs>
+    <env> _ENV </env>
+    <stack> _STACK </stack>
+    requires signedDigitSum(I) >Int 0
+
+  claim [count-nonpositive-head]:
+    <k> ListV(VCons(I, REST)) ~> callK("count_nums") ~> CONT
+      => IntV(countPositive(VCons(I, REST))) ~> CONT </k>
+    <funs> solutionFuns </funs>
+    <env> _ENV </env>
+    <stack> _STACK </stack>
+    requires signedDigitSum(I) <=Int 0
+
+  claim [entry-empty]:
+    <k> solutionProgram ~> invoke("count_nums", ListV(VNil))
+      => IntV(0) </k>
+    <funs> .Map => solutionFuns </funs>
+    <env> .Map </env>
+    <stack> .List </stack>
+
+  claim [entry-positive-head]:
+    <k> solutionProgram ~> invoke("count_nums", ListV(VCons(I, REST)))
+      => IntV(countPositive(VCons(I, REST))) </k>
+    <funs> .Map => solutionFuns </funs>
+    <env> .Map </env>
+    <stack> .List </stack>
+    requires signedDigitSum(I) >Int 0
+
+  claim [entry-nonpositive-head]:
+    <k> solutionProgram ~> invoke("count_nums", ListV(VCons(I, REST)))
+      => IntV(countPositive(VCons(I, REST))) </k>
+    <funs> .Map => solutionFuns </funs>
+    <env> .Map </env>
+    <stack> .List </stack>
+    requires signedDigitSum(I) <=Int 0
+endmodule
