     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Lemma 1: the translated recursive helper implements the mathematical
     7	  // signed decimal digit sum for every mathematical integer.
     8	  claim
     9	    <k> IntV(N) ~> callK("digit_sum") ~> CONT
    10	      => IntV(signedDigitSum(N)) ~> CONT </k>
    11	    <funs> solutionFuns </funs>
    12	    <env> _ENV </env>
    13	    <stack> _STACK </stack>
    14	
    15	  // Lemma 2, empty constructor case.
    16	  claim
    17	    <k> ListV(VNil) ~> callK("count_nums") ~> CONT
    18	      => IntV(0) ~> CONT </k>
    19	    <funs> solutionFuns </funs>
    20	    <env> _ENV </env>
    21	    <stack> _STACK </stack>
    22	
    23	  // Lemma 2, nonempty constructor with a positive signed digit sum.
    24	  claim
    25	    <k> ListV(VCons(I, REST)) ~> callK("count_nums") ~> CONT
    26	      => IntV(countPositive(VCons(I, REST))) ~> CONT </k>
    27	    <funs> solutionFuns </funs>
    28	    <env> _ENV </env>
    29	    <stack> _STACK </stack>
    30	    requires signedDigitSum(I) >Int 0
    31	
    32	  // Lemma 2, complementary nonpositive-head case.  The three Lemma 2 claims
    33	  // are exhaustive and form structural induction over every finite VList.
    34	  claim
    35	    <k> ListV(VCons(I, REST)) ~> callK("count_nums") ~> CONT
    36	      => IntV(countPositive(VCons(I, REST))) ~> CONT </k>
    37	    <funs> solutionFuns </funs>
    38	    <env> _ENV </env>
    39	    <stack> _STACK </stack>
    40	    requires signedDigitSum(I) <=Int 0
    41	
    42	  // End-to-end theorem cases: load the exact program tree and invoke its
    43	  // required entry point from a clean initial machine state.
    44	  claim
    45	    <k> solutionProgram ~> invoke("count_nums", ListV(VNil))
    46	      => IntV(0) </k>
    47	    <funs> .Map => solutionFuns </funs>
    48	    <env> .Map </env>
    49	    <stack> .List </stack>
    50	
    51	  claim
    52	    <k> solutionProgram ~> invoke("count_nums", ListV(VCons(I, REST)))
    53	      => IntV(countPositive(VCons(I, REST))) </k>
    54	    <funs> .Map => solutionFuns </funs>
    55	    <env> .Map </env>
    56	    <stack> .List </stack>
    57	    requires signedDigitSum(I) >Int 0
    58	
    59	  claim
    60	    <k> solutionProgram ~> invoke("count_nums", ListV(VCons(I, REST)))
    61	      => IntV(countPositive(VCons(I, REST))) </k>
    62	    <funs> .Map => solutionFuns </funs>
    63	    <env> .Map </env>
    64	    <stack> .List </stack>
    65	    requires signedDigitSum(I) <=Int 0
