 'input': 'const patch = "*** Begin Patch\\n*** Add File: '
          '/work/verification.k\\n+requires \\"semantic.k\\"\\n+\\n+module '
          'VERIFICATION\\n+  imports MPY-SEMANTIC\\n+\\n+  // These two macros '
          'are the exact bodies emitted in solution.mpy.  Keeping\\n+  // them '
          'named makes the proof claims readable while preserving the link '
          "to\\n+  // the translated program's constructor tree.\\n+  syntax "
          'Stmts ::= \\"digitBody\\" [macro]\\n+                 | '
          '\\"countBody\\" [macro]\\n+\\n+  rule digitBody =>\\n+    '
          'If(Compare(Name(\\"num\\"), CmpOp(\\"<\\", UnaryOp(\\"-\\", '
          'Int(9)))),\\n+      Return(\\n+        BinOp(\\"+\\",\\n+          '
          'BinOp(\\"%\\", UnaryOp(\\"-\\", Name(\\"num\\")), '
          'Int(10)),\\n+          Call(Name(\\"digit_sum\\"),\\n+            '
          'UnaryOp(\\"-\\",\\n+              BinOp(\\"//\\", UnaryOp(\\"-\\", '
          'Name(\\"num\\")), Int(10)))))),\\n+      '
          'If(Compare(Name(\\"num\\"), CmpOp(\\">\\", Int(9))),\\n+        '
          'Return(\\n+          BinOp(\\"+\\",\\n+            BinOp(\\"%\\", '
          'Name(\\"num\\"), Int(10)),\\n+            '
          'Call(Name(\\"digit_sum\\"),\\n+              BinOp(\\"//\\", '
          'Name(\\"num\\"), Int(10))))),\\n+        '
          'Return(Name(\\"num\\"))))\\n+\\n+  rule countBody =>\\n+    '
          'If(Compare(Name(\\"arr\\"), CmpOp(\\"==\\", ListExpr())),\\n+      '
          'Return(Int(0)),\\n+      If(Compare(\\n+          '
          'Call(Name(\\"digit_sum\\"), Subscript(Name(\\"arr\\"), '
          'Int(0))),\\n+          CmpOp(\\">\\", Int(0))),\\n+        '
          'Return(\\n+          BinOp(\\"+\\", Int(1),\\n+            '
          'Call(Name(\\"count_nums\\"),\\n+              '
          'Subscript(Name(\\"arr\\"),\\n+                Slice(Int(1), '
          'NoBound, NoBound))))),\\n+        Return(\\n+          '
          'Call(Name(\\"count_nums\\"),\\n+            '
          'Subscript(Name(\\"arr\\"),\\n+              Slice(Int(1), NoBound, '
          'NoBound))))))\\n+\\n+  syntax Program ::= \\"solutionProgram\\" '
          '[macro]\\n+  rule solutionProgram =>\\n+    Module(\\n+      '
          'FuncDef(\\"digit_sum\\", Params(\\"num\\"), digitBody)\\n+      '
          'FuncDef(\\"count_nums\\", Params(\\"arr\\"), countBody))\\n+\\n+  '
          'syntax Map ::= \\"solutionFuns\\" [macro]\\n+  rule solutionFuns '
          '=>\\n+       (\\"digit_sum\\" |-> function(\\"num\\", '
          'digitBody))\\n+       (\\"count_nums\\" |-> function(\\"arr\\", '
          'countBody))\\n+\\n+  // Mathematical reference: decimal digits are '
          'peeled from the right.  A\\n+  // one-digit negative number is the '
          'signed leading digit, exactly as stated\\n+  // in prompt.py.\\n+  '
          'syntax Int ::= \\"signedDigitSum\\" \\"(\\" Int \\")\\" [function, '
          'symbol(signedDigitSum)]\\n+\\n+  rule signedDigitSum(N)\\n+    => '
          '((0 -Int N) %Int 10)\\n+       +Int signedDigitSum(0 -Int ((0 -Int '
          'N) /Int 10))\\n+    requires N <Int (0 -Int 9)\\n+\\n+  rule '
          'signedDigitSum(N)\\n+    => (N %Int 10) +Int signedDigitSum(N /Int '
          '10)\\n+    requires N >Int 9\\n+\\n+  rule signedDigitSum(N) => '
          'N\\n+    requires N >=Int (0 -Int 9) andBool N <=Int 9\\n+\\n+  '
          'syntax Int ::= \\"countPositive\\" \\"(\\" VList \\")\\" [function, '
          'symbol(countPositive)]\\n+\\n+  rule countPositive(VNil) => 0\\n+  '
          'rule countPositive(VCons(N, REST)) => 1 +Int '
          'countPositive(REST)\\n+    requires signedDigitSum(N) >Int 0\\n+  '
          'rule countPositive(VCons(N, REST)) => countPositive(REST)\\n+    '
          'requires signedDigitSum(N) <=Int 0\\n+endmodule\\n*** Add File: '
          '/work/spec.k\\n+requires \\"verification.k\\"\\n+\\n+module '
          'SPEC\\n+  imports VERIFICATION\\n+\\n+  // Lemma 1: the translated '
          'recursive helper implements the mathematical\\n+  // signed decimal '
