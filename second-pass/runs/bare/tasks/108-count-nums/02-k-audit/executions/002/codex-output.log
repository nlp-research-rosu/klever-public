     3	module VERIFICATION
     4	  imports MPY-SEMANTIC
     5	
     6	  // These two macros are the exact bodies emitted in solution.mpy.  Keeping
     7	  // them named makes the proof claims readable while preserving the link to
     8	  // the translated program's constructor tree.
     9	  syntax Stmts ::= "digitBody" [macro]
    10	                 | "countBody" [macro]
    11	
    12	  rule digitBody =>
    13	    If(Compare(Name("num"), CmpOp("<", UnaryOp("-", Int(9)))),
    14	      Return(
    15	        BinOp("+",
    16	          BinOp("%", UnaryOp("-", Name("num")), Int(10)),
    17	          Call(Name("digit_sum"),
    18	            UnaryOp("-",
    19	              BinOp("//", UnaryOp("-", Name("num")), Int(10)))))),
    20	      If(Compare(Name("num"), CmpOp(">", Int(9))),
    21	        Return(
    22	          BinOp("+",
    23	            BinOp("%", Name("num"), Int(10)),
    24	            Call(Name("digit_sum"),
    25	              BinOp("//", Name("num"), Int(10))))),
    26	        Return(Name("num"))))
    27	
    28	  rule countBody =>
    29	    If(Compare(Name("arr"), CmpOp("==", ListExpr())),
    30	      Return(Int(0)),
    31	      If(Compare(
    32	          Call(Name("digit_sum"), Subscript(Name("arr"), Int(0))),
    33	          CmpOp(">", Int(0))),
    34	        Return(
    35	          BinOp("+", Int(1),
    36	            Call(Name("count_nums"),
    37	              Subscript(Name("arr"),
    38	                Slice(Int(1), NoBound, NoBound))))),
    39	        Return(
    40	          Call(Name("count_nums"),
    41	            Subscript(Name("arr"),
    42	              Slice(Int(1), NoBound, NoBound))))))
    43	
    44	  syntax Program ::= "solutionProgram" [macro]
    45	  rule solutionProgram =>
    46	    Module(
    47	      FuncDef("digit_sum", Params("num"), digitBody)
    48	      FuncDef("count_nums", Params("arr"), countBody))
    49	
    50	  syntax Map ::= "solutionFuns" [macro]
    51	  rule solutionFuns =>
    52	       ("digit_sum" |-> function("num", digitBody))
    53	       ("count_nums" |-> function("arr", countBody))
    54	
    55	  // Mathematical reference: decimal digits are peeled from the right.  A
    56	  // one-digit negative number is the signed leading digit, exactly as stated
    57	  // in prompt.py.
    58	  syntax Int ::= "signedDigitSum" "(" Int ")"
    59	                 [function, total, symbol(signedDigitSum)]
    60	
    61	  rule signedDigitSum(N)
    62	    => ((0 -Int N) %Int 10)
    63	       +Int signedDigitSum(0 -Int ((0 -Int N) /Int 10))
    64	    requires N <Int (0 -Int 9)
    65	
    66	  rule signedDigitSum(N)
    67	    => (N %Int 10) +Int signedDigitSum(N /Int 10)
    68	    requires N >Int 9
    69	
    70	  rule signedDigitSum(N) => N
    71	    requires N >=Int (0 -Int 9) andBool N <=Int 9
