+#!/usr/bin/env bash
+set -eu
+set -o pipefail
+trap 'status=$?; printf "SCRIPT_EXIT_STATUS=%s\n" "$status"' EXIT
+set -x
+
+REBUILD=/tmp/audit-work/108-count-nums-clean-rebuild
