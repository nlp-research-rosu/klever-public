+cp /candidate/solution.py "$REBUILD/solution.py"
+cp /candidate/solution.mpy "$REBUILD/solution.submitted.mpy"
+cp /candidate/semantic.k "$REBUILD/semantic.k"
+cp /candidate/verification.k "$REBUILD/verification.k"
