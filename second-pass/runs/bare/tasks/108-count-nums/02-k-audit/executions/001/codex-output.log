+++ b//tmp/audit-work/candidate-src/audit-spec-split.k
@@ -0,0 +1,75 @@
+requires "verification.k"
+
+module AUDIT-SPEC-1
+  imports VERIFICATION
+  claim
+    <k> IntV(N) ~> callK("digit_sum") ~> CONT
+      => IntV(signedDigitSum(N)) ~> CONT </k>
+    <funs> solutionFuns </funs>
+    <env> _ENV </env>
+    <stack> _STACK </stack>
+endmodule
+
+module AUDIT-SPEC-2
+  imports VERIFICATION
+  claim
+    <k> ListV(VNil) ~> callK("count_nums") ~> CONT
+      => IntV(0) ~> CONT </k>
+    <funs> solutionFuns </funs>
+    <env> _ENV </env>
+    <stack> _STACK </stack>
+endmodule
+
+module AUDIT-SPEC-3
+  imports VERIFICATION
+  claim
+    <k> ListV(VCons(I, REST)) ~> callK("count_nums") ~> CONT
+      => IntV(countPositive(VCons(I, REST))) ~> CONT </k>
+    <funs> solutionFuns </funs>
+    <env> _ENV </env>
+    <stack> _STACK </stack>
+    requires signedDigitSum(I) >Int 0
+endmodule
+
+module AUDIT-SPEC-4
+  imports VERIFICATION
+  claim
