+    <env> _ENV </env>
+    <stack> _STACK </stack>
+endmodule
+
+module AUDIT-SPEC-2
+  imports VERIFICATION
+  claim
+    <k> ListV(VNil) ~> callK("count_nums") ~> CONT
+      => IntV(0) ~> CONT </k>
+    <funs> solutionFuns </funs>
+    <env> _ENV </env>
+    <stack> _STACK </stack>
+endmodule
+
+module AUDIT-SPEC-3
