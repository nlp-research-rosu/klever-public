  rule eval(Name(X), bind(Y, _, ENV)) => eval(Name(X), ENV)
    requires X =/=String Y

  rule eval(Call(Attribute(E, "count"), A), ENV)
    => intValue(count(asInt(eval(A, ENV)), asInts(eval(E, ENV))))

  rule eval(Compare(L, CmpOp("==", R)), ENV)
    => boolValue(asInt(eval(L, ENV)) ==Int asInt(eval(R, ENV)))

  rule eval(ListComp(E, CompFor(Name(X), ITER, PRED)), ENV)
    => collect(asInts(eval(ITER, ENV)), X, E, PRED, ENV)

  syntax Int ::= "asInt" "(" PyVal ")" [function]
  syntax Ints ::= "asInts" "(" PyVal ")" [function]
  syntax Bool ::= "asBool" "(" PyVal ")" [function]
  rule asInt(intValue(I)) => I
  rule asInts(listValue(IS)) => IS
  rule asBool(boolValue(B)) => B

  // Python list.count for integer lists.
  syntax Int ::= "count" "(" Int "," Ints ")" [function]
  // Concrete execution unfolds count normally.  During symbolic proof the
  // call remains an abstract, shared mathematical observation of ORIGINAL;
  // this avoids needlessly enumerating every possible shape of ORIGINAL.
  rule count(_, .Ints) => 0 [concrete]
  rule count(I, (I, IS)) => 1 +Int count(I, IS) [concrete]
  rule count(I, (J, IS)) => count(I, IS)
    requires I =/=Int J [concrete]

  // A one-generator list comprehension.  The generator variable is pushed in
  // front of the captured environment, matching Python lexical shadowing.
  syntax PyVal ::= "collect" "(" Ints "," String "," Expr "," Expr "," Env ")" [function]
  rule collect(.Ints, _, _, _, _) => listValue(.Ints)
  rule collect((I, IS), X, E, PRED, ENV)
    => prependIf(
         asBool(eval(PRED, bind(X, intValue(I), ENV))),
         asInt(eval(E, bind(X, intValue(I), ENV))),
         collect(IS, X, E, PRED, ENV))

  syntax PyVal ::= "prependIf" "(" Bool "," Int "," PyVal ")" [function]
  rule prependIf(true, I, listValue(IS)) => listValue(I, IS)
  rule prependIf(false, _, listValue(IS)) => listValue(IS)
endmodule
requires "semantic.k"

module VERIFICATION
  imports MPY

  // Executable mathematical contract: traverse the input from left to right
  // and retain an element exactly when its occurrence count in the *original*
  // list is one.  Thus the survivors keep their original order.
  syntax Ints ::= "removeRepeated" "(" Ints "," Ints ")" [function]
                | "removeRepeatedOnto" "(" Ints "," Ints "," Ints ")" [function]
  rule removeRepeated(INPUT, ORIGINAL)
    => removeRepeatedOnto(INPUT, ORIGINAL, .Ints)
  rule removeRepeatedOnto(.Ints, _, SUFFIX) => SUFFIX
  rule removeRepeatedOnto((I, IS), ORIGINAL, SUFFIX)
    => ifCons(count(I, ORIGINAL) ==Int 1,
              I,
              removeRepeatedOnto(IS, ORIGINAL, SUFFIX))
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  // Inductive bridge between the transition-level comprehension iterator and
  // the separately stated stable-filter contract.
  claim
    <k>
      walkComp(INPUT,
               "number",
               Name("number"),
               Compare(
                 Call(Attribute(Name("numbers"), "count"), Name("number")),
                 CmpOp("==", Int(1))),
               bind("numbers", listValue(ORIGINAL), emptyEnv))
      ~> KREST
      => KREST
    </k>
    <output>
      listValue(SUFFIX)
      => listValue(removeRepeatedOnto(INPUT, ORIGINAL, SUFFIX))
    </output>
    [label(walk-correct)]

  // End-to-end theorem for the exact AST in solution.mpy and an arbitrary
  // integer list INPUT.  This begins in the generated initial configuration.
  claim
    <k>
      Module(
        ImportFrom("typing", "List")
        FuncDef("remove_duplicates",
          Params("numbers"),
          CellVars("numbers"),
          FreeVars(.Strings),
          Return(
            ListComp(Name("number"),
              CompFor(
                Name("number"),
                Name("numbers"),
                Compare(
                  Call(Attribute(Name("numbers"), "count"), Name("number")),
                  CmpOp("==", Int(1))))))))
      => .K
    </k>
    <input> listValue(INPUT) </input>
    <function> noFunction =>
      closure("numbers",
        Return(
          ListComp(Name("number"),
            CompFor(
              Name("number"),
              Name("numbers"),
              Compare(
                Call(Attribute(Name("numbers"), "count"), Name("number")),
                CmpOp("==", Int(1)))))))
    </function>
    <env> emptyEnv => bind("numbers", listValue(INPUT), emptyEnv) </env>
    <output> listValue(.Ints) => listValue(removeRepeated(INPUT, INPUT)) </output>
    [label(program-correct)]
endmodule
#!/usr/bin/env bash
set -euo pipefail

# Regenerate the transliteration from the submitted Python source.
python3 py2mpy.py solution.py > solution.mpy

# Cross-check the Python implementation itself, including the prompt example.
python3 - <<'PY'
from solution import remove_duplicates

assert remove_duplicates([1, 2, 3, 2, 4]) == [1, 3, 4]
assert remove_duplicates([]) == []
assert remove_duplicates([1, 1, 1]) == []
assert remove_duplicates([-1, 0, -1, 2]) == [0, 2]
PY

# Compile and exercise the semantics on concrete translated programs.
kompile semantic.k \
  --backend haskell \
  --main-module MPY \
  --syntax-module MPY-SYNTAX \
  --output-definition semantic-kompiled
krun solution.mpy --definition semantic-kompiled \
  -cINPUT='listValue(1, 2, 3, 2, 4)'
krun solution.mpy --definition semantic-kompiled \
  -cINPUT='listValue()'
krun solution.mpy --definition semantic-kompiled \
  -cINPUT='listValue(-1, 0, -1, 2)'

# Compile the independent contract together with the semantics.
kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

# First prove the generalized inductive iterator lemma.  Then use that already
# proved lemma compositionally while proving the exact translated program.
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --claims walk-correct
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --trusted walk-correct

