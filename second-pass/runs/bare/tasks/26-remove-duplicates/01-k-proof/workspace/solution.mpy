Module(
  ImportFrom("typing", "List")
  FuncDef("remove_duplicates", Params("numbers"), CellVars("numbers"), FreeVars(),
    Return(
      ListComp(Name("number"),
        CompFor(
          Name("number"),
          Name("numbers"),
          Compare(
            Call(Attribute(Name("numbers"), "count"), Name("number")),
            CmpOp("==", Int(1))))))))
