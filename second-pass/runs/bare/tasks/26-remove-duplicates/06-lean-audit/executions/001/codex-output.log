+#include <stdio.h>
+#include <stddef.h>
+
+int uv_exepath(char *buffer, size_t *size);
+const char *uv_err_name(int error);
+
+int main(void) {
+    char buffer[4096];
+    size_t size = sizeof(buffer);
+    int code = uv_exepath(buffer, &size);
+    printf("code=%d name=%s size=%zu path=%.*s\n",
+           code, uv_err_name(code), size, (int)size, buffer);
+    return code == 0 ? 0 : 1;
+}
