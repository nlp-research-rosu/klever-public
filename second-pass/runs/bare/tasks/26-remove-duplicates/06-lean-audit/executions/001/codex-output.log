+INDEPENDENT_CLASSIFICATIONS = {
+    "rule-eead64180cce1cdc54b47266673a3b5fdf72418beb97f8d7bc07df03affe9237":
+        "DEFINITION",
+    "rule-4b2e81eee048157b7718fb38321ccd6a0df2d72177e63dbc46d4d028c48dffff":
