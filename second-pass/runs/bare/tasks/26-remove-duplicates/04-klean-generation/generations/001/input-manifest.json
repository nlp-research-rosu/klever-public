{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 12,
      "module": "VERIFICATION",
      "normalized_sha256": "eead64180cce1cdc54b47266673a3b5fdf72418beb97f8d7bc07df03affe9237",
      "rationale": "This rule expands the public removeRepeated summary into its accumulator-style removeRepeatedOnto form with an empty output suffix.",
      "source_rule_id": "rule-eead64180cce1cdc54b47266673a3b5fdf72418beb97f8d7bc07df03affe9237",
      "start_line": 11,
      "text": "  rule removeRepeated(INPUT, ORIGINAL)\n    => removeRepeatedOnto(INPUT, ORIGINAL, .Ints)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 13,
      "module": "VERIFICATION",
      "normalized_sha256": "4b2e81eee048157b7718fb38321ccd6a0df2d72177e63dbc46d4d028c48dffff",
      "rationale": "This is the empty-input base case of the removeRepeatedOnto recurrence, defining the result to be the supplied suffix.",
      "source_rule_id": "rule-4b2e81eee048157b7718fb38321ccd6a0df2d72177e63dbc46d4d028c48dffff",
      "start_line": 13,
      "text": "  rule removeRepeatedOnto(.Ints, _, SUFFIX) => SUFFIX"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 17,
      "module": "VERIFICATION",
      "normalized_sha256": "21d0f4e4939c7bf24a8212763a583e9e9f1d7cc35fcef917a31103579967b976",
      "rationale": "This is the recursive cons case defining the stable filter: it conditionally retains the head when its original-list count is one and recurs on the tail.",
      "source_rule_id": "rule-21d0f4e4939c7bf24a8212763a583e9e9f1d7cc35fcef917a31103579967b976",
      "start_line": 14,
      "text": "  rule removeRepeatedOnto((I, IS), ORIGINAL, SUFFIX)\n    => ifCons(count(I, ORIGINAL) ==Int 1,\n              I,\n              removeRepeatedOnto(IS, ORIGINAL, SUFFIX))"
    }
  ],
