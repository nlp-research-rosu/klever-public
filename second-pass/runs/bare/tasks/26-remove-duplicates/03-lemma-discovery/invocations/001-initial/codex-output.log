import json
from pathlib import Path

inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())

assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inventory['inventory_sha256']
expected_ids = [rule['source_rule_id'] for rule in inventory['rules']]
actual_ids = [rule['source_rule_id'] for rule in out['rules']]
assert actual_ids == expected_ids
assert len(actual_ids) == len(set(actual_ids))
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
by_id = {rule['source_rule_id']: rule for rule in inventory['rules']}
for rule in out['rules']:
    assert list(rule) == ['source_rule_id', 'classification', 'rationale']
    assert rule['classification'] in allowed
    assert isinstance(rule['rationale'], str) and rule['rationale'].strip()
    attrs = by_id[rule['source_rule_id']]['attributes']
    if 'simplification' in attrs:
        assert rule['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}

discovery = Path('/workspace/DISCOVERY.md').read_text()
assert 'The domain-lemma set is empty.' in discovery
assert 'walk-correct' in discovery
assert '--claims walk-correct' in discovery
assert '--trusted walk-correct' in discovery
print(f\"validated {len(actual_ids)} canonical rules in inventory order\")
print(json.dumps(out, indent=2))
