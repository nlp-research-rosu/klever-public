+    if path.is_symlink() or not path.is_file():
+        raise RuntimeError(f"not a real regular file: {path}")
+    value = json.loads(path.read_text())
+    if not isinstance(value, dict):
+        raise RuntimeError(f"not a JSON object: {path}")
+    return value
+
