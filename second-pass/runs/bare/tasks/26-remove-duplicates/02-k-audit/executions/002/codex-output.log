diff --git a//tmp/audit-work/rebuild/spec-body-mutation.k b//tmp/audit-work/rebuild/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..f895e34fd32f0932360aa567d374e393b7c69563
--- /dev/null
+++ b//tmp/audit-work/rebuild/spec-body-mutation.k
@@ -0,0 +1,40 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // The executed program body now keeps values with count == 2, while the
+  // expected result remains the original count == 1 result for input [7].
+  claim
+    <k>
+      Module(
+        ImportFrom("typing", "List")
+        FuncDef("remove_duplicates",
+          Params("numbers"),
+          CellVars("numbers"),
+          FreeVars(.Strings),
+          Return(
+            ListComp(Name("number"),
+              CompFor(
+                Name("number"),
+                Name("numbers"),
+                Compare(
+                  Call(Attribute(Name("numbers"), "count"), Name("number")),
+                  CmpOp("==", Int(2))))))))
+      => .K
+    </k>
+    <input> listValue(7) </input>
+    <function> noFunction =>
+      closure("numbers",
+        Return(
+          ListComp(Name("number"),
+            CompFor(
+              Name("number"),
+              Name("numbers"),
+              Compare(
+                Call(Attribute(Name("numbers"), "count"), Name("number")),
+                CmpOp("==", Int(2)))))))
+    </function>
+    <env> emptyEnv => bind("numbers", listValue(7), emptyEnv) </env>
+    <output> listValue(.Ints) => listValue(7) </output>
+endmodule
diff --git a//tmp/audit-work/rebuild/spec-concrete-witness.k b//tmp/audit-work/rebuild/spec-concrete-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..7ed352cb8ca499bf0ae7857ce656d845e8b0a0f7
--- /dev/null
+++ b//tmp/audit-work/rebuild/spec-concrete-witness.k
@@ -0,0 +1,40 @@
+requires "verification.k"
+
+module SPEC-CONCRETE-WITNESS
+  imports VERIFICATION
+
+  claim
+    <k>
+      Module(
+        ImportFrom("typing", "List")
+        FuncDef("remove_duplicates",
+          Params("numbers"),
+          CellVars("numbers"),
+          FreeVars(.Strings),
+          Return(
+            ListComp(Name("number"),
+              CompFor(
+                Name("number"),
+                Name("numbers"),
+                Compare(
+                  Call(Attribute(Name("numbers"), "count"), Name("number")),
+                  CmpOp("==", Int(1))))))))
+      => .K
+    </k>
+    <input> listValue(1, 2, 3, 2, 4) </input>
+    <function> noFunction =>
+      closure("numbers",
+        Return(
+          ListComp(Name("number"),
+            CompFor(
+              Name("number"),
+              Name("numbers"),
+              Compare(
+                Call(Attribute(Name("numbers"), "count"), Name("number")),
+                CmpOp("==", Int(1)))))))
+    </function>
+    <env> emptyEnv =>
+      bind("numbers", listValue(1, 2, 3, 2, 4), emptyEnv)
+    </env>
+    <output> listValue(.Ints) => listValue(1, 3, 4) </output>
+endmodule
diff --git a//tmp/audit-work/rebuild/spec-context-witness.k b//tmp/audit-work/rebuild/spec-context-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..ae77e68442310586bebb5387914cd261c00bf7d4
--- /dev/null
+++ b//tmp/audit-work/rebuild/spec-context-witness.k
@@ -0,0 +1,40 @@
+requires "verification.k"
+
+module SPEC-CONTEXT-WITNESS
+  imports VERIFICATION
+
+  claim
+    <k>
+      walkComp(INPUT,
+               "number",
+               Name("number"),
+               Compare(
+                 Call(Attribute(Name("numbers"), "count"), Name("number")),
+                 CmpOp("==", Int(1))),
+               bind("numbers", listValue(ORIGINAL), emptyEnv))
+      ~> KREST
+      => KREST
+    </k>
+    <output>
+      listValue(SUFFIX)
+      => listValue(removeRepeatedOnto(INPUT, ORIGINAL, SUFFIX))
+    </output>
+    [label(walk-correct)]
+
+  // Satisfiable boundary/context witness: the immediate continuation performs
+  // another observable output update after the summarized iterator.
+  claim
+    <k>
+      walkComp((1, .Ints),
+               "number",
+               Name("number"),
+               Compare(
+                 Call(Attribute(Name("numbers"), "count"), Name("number")),
+                 CmpOp("==", Int(1))),
+               bind("numbers", listValue(1), emptyEnv))
+      ~> emitComputed(true, 9)
+      => .K
+    </k>
+    <output> listValue(8) => listValue(9, 1, 8) </output>
+    [label(context-witness)]
+endmodule
diff --git a//tmp/audit-work/rebuild/spec-vacuity.k b//tmp/audit-work/rebuild/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..33fa40c5be1abcfc077e258c976130a9942cbc36
--- /dev/null
+++ b//tmp/audit-work/rebuild/spec-vacuity.k
@@ -0,0 +1,61 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  claim
+    <k>
+      walkComp(INPUT,
+               "number",
+               Name("number"),
+               Compare(
+                 Call(Attribute(Name("numbers"), "count"), Name("number")),
+                 CmpOp("==", Int(1))),
+               bind("numbers", listValue(ORIGINAL), emptyEnv))
+      ~> KREST
+      => KREST
+    </k>
+    <output>
+      listValue(SUFFIX)
+      => listValue(removeRepeatedOnto(INPUT, ORIGINAL, SUFFIX))
+    </output>
+    [label(walk-correct)]
+
+  // Deliberately false result mutation. For the satisfying input INPUT=.Ints,
+  // actual output is empty while this postcondition demands a leading zero.
+  claim
+    <k>
+      Module(
+        ImportFrom("typing", "List")
+        FuncDef("remove_duplicates",
+          Params("numbers"),
+          CellVars("numbers"),
+          FreeVars(.Strings),
+          Return(
+            ListComp(Name("number"),
+              CompFor(
+                Name("number"),
+                Name("numbers"),
+                Compare(
+                  Call(Attribute(Name("numbers"), "count"), Name("number")),
+                  CmpOp("==", Int(1))))))))
+      => .K
+    </k>
+    <input> listValue(INPUT) </input>
+    <function> noFunction =>
+      closure("numbers",
+        Return(
+          ListComp(Name("number"),
+            CompFor(
+              Name("number"),
+              Name("numbers"),
+              Compare(
+                Call(Attribute(Name("numbers"), "count"), Name("number")),
+                CmpOp("==", Int(1)))))))
+    </function>
+    <env> emptyEnv => bind("numbers", listValue(INPUT), emptyEnv) </env>
+    <output>
+      listValue(.Ints) => listValue(0, removeRepeated(INPUT, INPUT))
+    </output>
+    [label(program-false-result)]
+endmodule
