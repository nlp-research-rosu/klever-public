     1	module MPY-SYNTAX
     2	  imports INT
     3	  imports BOOL
     4	  imports STRING
     5	
     6	  // Concrete syntax emitted by the fixed py2mpy.py transliterator.  This is
     7	  // intentionally a small Python subset, but the nodes keep their AST shape.
     8	  syntax Pgm ::= "Module" "(" Stmts ")"
     9	
    10	  syntax Stmts ::= List{Stmt, ""}
    11	  syntax Stmt ::= "ImportFrom" "(" String "," Strings ")"
    12	                | "FuncDef" "(" String "," Params "," Stmts ")"
    13	                | "FuncDef" "(" String "," Params "," CellVars "," FreeVars "," Stmts ")"
    14	                | "Return" "(" Expr ")"
    15	
    16	  syntax Strings  ::= List{String, ","}
    17	  syntax Params   ::= "Params" "(" Strings ")"
    18	  syntax CellVars ::= "CellVars" "(" Strings ")"
    19	  syntax FreeVars ::= "FreeVars" "(" Strings ")"
    20	
    21	  syntax Exprs ::= List{Expr, ","}
    22	  syntax Expr ::= "Name" "(" String ")"
    23	                | "Int" "(" Int ")"
    24	                | "Attribute" "(" Expr "," String ")"
    25	                | "Call" "(" Expr "," Exprs ")"
    26	                | "Compare" "(" Expr "," CmpOps ")"
    27	                | "ListComp" "(" Expr "," CompFors ")"
    28	  syntax CmpOps ::= List{CmpOp, ","}
    29	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    30	  syntax CompFors ::= List{CompFor, ""}
    31	  syntax CompFor ::= "CompFor" "(" Expr "," Expr "," Exprs ")"
    32	endmodule
    33	
    34	module MPY
    35	  imports MPY-SYNTAX
    36	
    37	  // Runtime values.  Ints is the semantic representation of a Python list of
    38	  // integers; unlike the source-level AST, it can also be symbolic in claims.
    39	  syntax Ints ::= List{Int, ","}
    40	  syntax PyVal ::= "intValue" "(" Int ")"
    41	                 | "boolValue" "(" Bool ")"
    42	                 | "listValue" "(" Ints ")"
    43	
    44	  syntax Env ::= "emptyEnv"
    45	               | "bind" "(" String "," PyVal "," Env ")"
    46	
    47	  syntax Function ::= "noFunction"
    48	                    | "closure" "(" String "," Stmts ")"
    49	
    50	  configuration
    51	    <py>
    52	      <k> $PGM:Pgm </k>
    53	      <input> $INPUT:PyVal </input>
    54	      <function> noFunction </function>
    55	      <env> emptyEnv </env>
    56	      <output> listValue(.Ints) </output>
    57	    </py>
    58	
    59	  // Module loading registers the entry point.  Imports have no dynamic effect
    60	  // in this subset because annotations are erased by the supplied translator.
    61	  syntax KItem ::= "execModule" "(" Stmts ")" | "startEntry"
    62	  rule <k> Module(SS) => execModule(SS) </k>
    63	  rule <k> execModule(.Stmts) => startEntry </k>
    64	  rule <k> execModule(S SS) => S ~> execModule(SS) </k>
    65	  rule <k> ImportFrom(_, _) => .K ...</k>
    66	
    67	  rule <k> FuncDef("remove_duplicates", Params(P), BODY) => .K ...</k>
    68	       <function> noFunction => closure(P, BODY) </function>
    69	  rule <k> FuncDef("remove_duplicates", Params(P), _, _, BODY) => .K ...</k>
    70	       <function> noFunction => closure(P, BODY) </function>
    71	
    72	  syntax KItem ::= "execFunction" "(" Stmts ")"
    73	  rule <k> startEntry => execFunction(BODY) </k>
    74	       <input> ARG </input>
    75	       <function> closure(P, BODY) </function>
    76	       <env> _ => bind(P, ARG, emptyEnv) </env>
    77	
    78	  // Returning a comprehension starts an explicit transition system.  Keeping
    79	  // iteration in <k> (rather than hiding it in a meta-level evaluator) lets
    80	  // kprove symbolically split an arbitrary list into empty/cons cases.
    81	  syntax KItem ::= "walkComp" "(" Ints "," String "," Expr "," Expr "," Env ")"
    82	                 | "emitComputed" "(" Bool "," Int ")"
    83	  rule <k> execFunction(Return(ListComp(E, CompFor(Name(X), ITER, PRED))) _REST)
    84	         => walkComp(asInts(eval(ITER, ENV)), X, E, PRED, ENV) </k>
    85	       <env> ENV </env>
    86	
    87	  rule <k> walkComp(.Ints, _, _, _, _) => .K ...</k>
    88	  rule <k> walkComp((I, IS), X, E, PRED, ENV)
    89	         => (walkComp(IS, X, E, PRED, ENV)
    90	             ~> emitComputed(asBool(eval(PRED, bind(X, intValue(I), ENV))),
    91	                             asInt(eval(E, bind(X, intValue(I), ENV))))) ...</k>
    92	  rule <k> emitComputed(B, I) => .K ...</k>
    93	       <output> listValue(IS) => listValue(ifCons(B, I, IS)) </output>
    94	
    95	  syntax Ints ::= "ifCons" "(" Bool "," Int "," Ints ")" [function]
    96	  rule ifCons(true, I, IS) => I, IS
    97	  rule ifCons(false, _, IS) => IS
    98	
    99	  // Pure expression evaluator for the constructs used by solution.mpy.
   100	  syntax PyVal ::= "eval" "(" Expr "," Env ")" [function]
   101	  rule eval(Int(I), _) => intValue(I)
   102	  rule eval(Name(X), bind(X, V, _)) => V
   103	  rule eval(Name(X), bind(Y, _, ENV)) => eval(Name(X), ENV)
   104	    requires X =/=String Y
   105	
   106	  rule eval(Call(Attribute(E, "count"), A), ENV)
   107	    => intValue(count(asInt(eval(A, ENV)), asInts(eval(E, ENV))))
   108	
   109	  rule eval(Compare(L, CmpOp("==", R)), ENV)
   110	    => boolValue(asInt(eval(L, ENV)) ==Int asInt(eval(R, ENV)))
   111	
   112	  rule eval(ListComp(E, CompFor(Name(X), ITER, PRED)), ENV)
   113	    => collect(asInts(eval(ITER, ENV)), X, E, PRED, ENV)
   114	
   115	  syntax Int ::= "asInt" "(" PyVal ")" [function]
   116	  syntax Ints ::= "asInts" "(" PyVal ")" [function]
   117	  syntax Bool ::= "asBool" "(" PyVal ")" [function]
   118	  rule asInt(intValue(I)) => I
   119	  rule asInts(listValue(IS)) => IS
   120	  rule asBool(boolValue(B)) => B
   121	
   122	  // Python list.count for integer lists.
   123	  syntax Int ::= "count" "(" Int "," Ints ")" [function]
   124	  // Concrete execution unfolds count normally.  During symbolic proof the
   125	  // call remains an abstract, shared mathematical observation of ORIGINAL;
   126	  // this avoids needlessly enumerating every possible shape of ORIGINAL.
   127	  rule count(_, .Ints) => 0 [concrete]
   128	  rule count(I, (I, IS)) => 1 +Int count(I, IS) [concrete]
   129	  rule count(I, (J, IS)) => count(I, IS)
   130	    requires I =/=Int J [concrete]
   131	
   132	  // A one-generator list comprehension.  The generator variable is pushed in
   133	  // front of the captured environment, matching Python lexical shadowing.
   134	  syntax PyVal ::= "collect" "(" Ints "," String "," Expr "," Expr "," Env ")" [function]
   135	  rule collect(.Ints, _, _, _, _) => listValue(.Ints)
   136	  rule collect((I, IS), X, E, PRED, ENV)
   137	    => prependIf(
   138	         asBool(eval(PRED, bind(X, intValue(I), ENV))),
   139	         asInt(eval(E, bind(X, intValue(I), ENV))),
   140	         collect(IS, X, E, PRED, ENV))
   141	
   142	  syntax PyVal ::= "prependIf" "(" Bool "," Int "," PyVal ")" [function]
   143	  rule prependIf(true, I, listValue(IS)) => listValue(I, IS)
   144	  rule prependIf(false, _, listValue(IS)) => listValue(IS)
   145	endmodule
     1	requires "semantic.k"
