     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Executable mathematical contract: traverse the input from left to right
     7	  // and retain an element exactly when its occurrence count in the *original*
     8	  // list is one.  Thus the survivors keep their original order.
     9	  syntax Ints ::= "removeRepeated" "(" Ints "," Ints ")" [function]
    10	                | "removeRepeatedOnto" "(" Ints "," Ints "," Ints ")" [function]
    11	  rule removeRepeated(INPUT, ORIGINAL)
    12	    => removeRepeatedOnto(INPUT, ORIGINAL, .Ints)
    13	  rule removeRepeatedOnto(.Ints, _, SUFFIX) => SUFFIX
    14	  rule removeRepeatedOnto((I, IS), ORIGINAL, SUFFIX)
    15	    => ifCons(count(I, ORIGINAL) ==Int 1,
    16	              I,
    17	              removeRepeatedOnto(IS, ORIGINAL, SUFFIX))
    18	endmodule
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Inductive bridge between the transition-level comprehension iterator and
     7	  // the separately stated stable-filter contract.
     8	  claim
     9	    <k>
    10	      walkComp(INPUT,
    11	               "number",
    12	               Name("number"),
    13	               Compare(
    14	                 Call(Attribute(Name("numbers"), "count"), Name("number")),
    15	                 CmpOp("==", Int(1))),
    16	               bind("numbers", listValue(ORIGINAL), emptyEnv))
    17	      ~> KREST
    18	      => KREST
    19	    </k>
    20	    <output>
    21	      listValue(SUFFIX)
    22	      => listValue(removeRepeatedOnto(INPUT, ORIGINAL, SUFFIX))
    23	    </output>
    24	    [label(walk-correct)]
    25	
    26	  // End-to-end theorem for the exact AST in solution.mpy and an arbitrary
    27	  // integer list INPUT.  This begins in the generated initial configuration.
    28	  claim
    29	    <k>
    30	      Module(
    31	        ImportFrom("typing", "List")
    32	        FuncDef("remove_duplicates",
    33	          Params("numbers"),
    34	          CellVars("numbers"),
    35	          FreeVars(.Strings),
    36	          Return(
    37	            ListComp(Name("number"),
    38	              CompFor(
    39	                Name("number"),
    40	                Name("numbers"),
    41	                Compare(
    42	                  Call(Attribute(Name("numbers"), "count"), Name("number")),
    43	                  CmpOp("==", Int(1))))))))
    44	      => .K
    45	    </k>
    46	    <input> listValue(INPUT) </input>
    47	    <function> noFunction =>
    48	      closure("numbers",
    49	        Return(
    50	          ListComp(Name("number"),
    51	            CompFor(
    52	              Name("number"),
    53	              Name("numbers"),
    54	              Compare(
    55	                Call(Attribute(Name("numbers"), "count"), Name("number")),
    56	                CmpOp("==", Int(1)))))))
    57	    </function>
    58	    <env> emptyEnv => bind("numbers", listValue(INPUT), emptyEnv) </env>
    59	    <output> listValue(.Ints) => listValue(removeRepeated(INPUT, INPUT)) </output>
    60	    [label(program-correct)]
    61	endmodule
