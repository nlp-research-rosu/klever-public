+        ImportFrom("typing", "List")
+        FuncDef("remove_duplicates",
+          Params("numbers"),
+          CellVars("numbers"),
+          FreeVars(.Strings),
+          Return(
+            ListComp(Name("number"),
+              CompFor(
+                Name("number"),
+                Name("numbers"),
+                Compare(
+                  Call(Attribute(Name("numbers"), "count"), Name("number")),
+                  CmpOp("==", Int(1))))))))
+      => .K
+    </k>
+    <input> listValue(INPUT) </input>
+    <function> noFunction =>
+      closure("numbers",
+        Return(
+          ListComp(Name("number"),
+            CompFor(
+              Name("number"),
+              Name("numbers"),
+              Compare(
+                Call(Attribute(Name("numbers"), "count"), Name("number")),
