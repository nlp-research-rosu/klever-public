+if [[ -e /reference/reference-semantics || -L /reference/reference-semantics ]]; then
+  printf 'MODE-BREACH reference semantics unexpectedly exists\n'
+  failure=1
+else
+  printf 'OK /reference/reference-semantics is absent\n'
