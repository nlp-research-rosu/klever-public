index 0000000000000000000000000000000000000000..bfb1001d2e19bb6854caf77df26b5133e0cd42a0
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: $0 LABEL COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+label=$1
+shift
+
+if [[ ! "$label" =~ ^[A-Za-z0-9._-]+$ ]]; then
+  echo "invalid evidence label: $label" >&2
+  exit 64
+fi
+
+evidence_dir=$(cd -- "$(dirname -- "$0")" && pwd)
+log_path="$evidence_dir/$label.log"
+
+{
+  printf 'working-directory: %q\n' "$PWD"
+  printf 'command:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  command_status=$?
+  printf '\nexit-status: %d\n' "$command_status"
+  exit "$command_status"
+} 2>&1 | tee "$log_path"
+
+exit "${PIPESTATUS[0]}"
diff --git a/evidence/spec-context.k b/evidence/spec-context.k
new file mode 100644
index 0000000000000000000000000000000000000000..c0be7331767df40ff97d584ac6078973cddb5b62
--- /dev/null
+++ b/evidence/spec-context.k
@@ -0,0 +1,43 @@
+requires "verification.k"
+
+module SPEC-CONTEXT
+  imports VERIFICATION
+
+  claim
+    <k>
+      walkComp(INPUT,
+               "number",
+               Name("number"),
+               Compare(
+                 Call(Attribute(Name("numbers"), "count"), Name("number")),
+                 CmpOp("==", Int(1))),
+               bind("numbers", listValue(ORIGINAL), emptyEnv))
+      ~> KREST
+      => KREST
+    </k>
+    <output>
+      listValue(SUFFIX)
+      => listValue(removeRepeatedOnto(INPUT, ORIGINAL, SUFFIX))
+    </output>
+    [label(context-walk-correct)]
+
+  // The immediate continuation prepends 99 after walkComp has emitted 1.
+  // A bridge that discards or unwinds KREST would produce a different output.
+  claim
+    <k>
+      walkComp((1, .Ints),
+               "number",
+               Name("number"),
+               Compare(
+                 Call(Attribute(Name("numbers"), "count"), Name("number")),
+                 CmpOp("==", Int(1))),
+               bind("numbers", listValue(1, .Ints), emptyEnv))
+      ~> emitComputed(true, 99)
+      => .K
+    </k>
+    <output>
+      listValue(.Ints)
+      => listValue(99, 1, .Ints)
+    </output>
+    [label(context-continuation)]
+endmodule
diff --git a/evidence/spec-count-opposite.k b/evidence/spec-count-opposite.k
new file mode 100644
index 0000000000000000000000000000000000000000..a84e34b0ae1b20b60396288dfe6b46f4419f6417
--- /dev/null
+++ b/evidence/spec-count-opposite.k
@@ -0,0 +1,38 @@
+requires "verification.k"
+
+module SPEC-COUNT-OPPOSITE
+  imports VERIFICATION
+
+  // False opposite interpretation: count(7, [7]) is not treated as one.
+  claim
+    <k>
+      walkComp((7, .Ints),
+               "number",
+               Name("number"),
+               Compare(
+                 Call(Attribute(Name("numbers"), "count"), Name("number")),
+                 CmpOp("==", Int(1))),
+               bind("numbers", listValue(7, .Ints), emptyEnv))
+      => .K
+    </k>
+    <output> listValue(.Ints) => listValue(.Ints) </output>
+    [label(singleton-wrongly-dropped)]
+
+  // False opposite interpretation: count(7, [7, 7]) is treated as one.
+  claim
+    <k>
+      walkComp((7, 7, .Ints),
+               "number",
+               Name("number"),
+               Compare(
+                 Call(Attribute(Name("numbers"), "count"), Name("number")),
+                 CmpOp("==", Int(1))),
+               bind("numbers", listValue(7, 7, .Ints), emptyEnv))
+      => .K
+    </k>
+    <output>
+      listValue(.Ints)
+      => listValue(7, 7, .Ints)
+    </output>
+    [label(duplicate-wrongly-kept)]
+endmodule
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..ccf5814b716dc359d37a899b36c8946b1623dac5
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,63 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Same independently proved iterator lemma, renamed for this isolated spec.
+  claim
+    <k>
+      walkComp(INPUT,
+               "number",
+               Name("number"),
+               Compare(
+                 Call(Attribute(Name("numbers"), "count"), Name("number")),
+                 CmpOp("==", Int(1))),
+               bind("numbers", listValue(ORIGINAL), emptyEnv))
+      ~> KREST
+      => KREST
+    </k>
+    <output>
+      listValue(SUFFIX)
+      => listValue(removeRepeatedOnto(INPUT, ORIGINAL, SUFFIX))
+    </output>
+    [label(vacuity-walk-correct)]
+
+  // Deliberately false: it requires an additional leading 0 in every result.
+  // INPUT = .Ints is a satisfying witness; the real/K result is .Ints, not 0.
+  claim
+    <k>
+      Module(
+        ImportFrom("typing", "List")
+        FuncDef("remove_duplicates",
+          Params("numbers"),
+          CellVars("numbers"),
+          FreeVars(.Strings),
+          Return(
+            ListComp(Name("number"),
+              CompFor(
+                Name("number"),
+                Name("numbers"),
+                Compare(
+                  Call(Attribute(Name("numbers"), "count"), Name("number")),
+                  CmpOp("==", Int(1))))))))
+      => .K
+    </k>
+    <input> listValue(INPUT) </input>
+    <function> noFunction =>
+      closure("numbers",
+        Return(
+          ListComp(Name("number"),
+            CompFor(
+              Name("number"),
+              Name("numbers"),
+              Compare(
+                Call(Attribute(Name("numbers"), "count"), Name("number")),
+                CmpOp("==", Int(1)))))))
+    </function>
+    <env> emptyEnv => bind("numbers", listValue(INPUT), emptyEnv) </env>
+    <output>
+      listValue(.Ints)
+      => listValue(0, removeRepeated(INPUT, INPUT))
+    </output>
+    [label(program-false-extra-zero)]
+endmodule
diff --git a/evidence/stage1_integrity.sh b/evidence/stage1_integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..cb815b91a1825d1cde86ff505582b8e9f0320617
--- /dev/null
+++ b/evidence/stage1_integrity.sh
@@ -0,0 +1,86 @@
+#!/usr/bin/env bash
+set -u
+
+failure=0
+
+check_regular_nonsymlink() {
+  local path=$1
+  if [[ ! -e "$path" ]]; then
+    printf 'MISSING %s\n' "$path"
+    failure=1
+  elif [[ -L "$path" ]]; then
+    printf 'SYMLINK %s -> %s\n' "$path" "$(readlink "$path")"
+    failure=1
+  elif [[ ! -f "$path" ]]; then
+    printf 'WRONG-TYPE %s\n' "$path"
+    failure=1
+  else
+    printf 'OK regular %s\n' "$path"
+  fi
+}
+
+printf 'Rendered mode: GENERATED_SEMANTICS\n'
+if [[ -e /reference/reference-semantics || -L /reference/reference-semantics ]]; then
+  printf 'MODE-BREACH reference semantics unexpectedly exists\n'
+  failure=1
+else
+  printf 'OK /reference/reference-semantics is absent\n'
+fi
+
+for path in \
+  /reference/canonical.py \
+  /reference/prompt.py \
+  /reference/py2mpy.py \
+  /candidate/run-input.json \
+  /candidate/metrics.json \
+  /candidate/codex-last.txt \
+  /candidate/codex-output.log \
+  /candidate/prompt.py \
+  /candidate/py2mpy.py \
+  /candidate/solution.py \
+  /candidate/solution.mpy \
+  /candidate/semantic.k \
+  /candidate/verification.k \
+  /candidate/spec.k \
+  /candidate/prove.sh
+do
+  check_regular_nonsymlink "$path"
+done
+
+if cmp -s /candidate/prompt.py /reference/prompt.py; then
+  printf 'IDENTICAL candidate prompt.py and trusted prompt.py\n'
+else
+  printf 'CHANGED candidate prompt.py\n'
+  failure=1
+fi
+
+if cmp -s /candidate/py2mpy.py /reference/py2mpy.py; then
+  printf 'IDENTICAL candidate py2mpy.py and trusted py2mpy.py\n'
+else
+  printf 'CHANGED candidate py2mpy.py\n'
+  failure=1
+fi
+
+printf 'Candidate root inventory:\n'
+find /candidate -maxdepth 1 -mindepth 1 -printf '%y %f -> %l\n' | sort
+
+printf 'Candidate symlinks at any depth:\n'
+find /candidate -type l -printf '%p -> %l\n' | sort
+
+printf 'Structured trace files:\n'
+find /candidate/codex-trace -type f -printf '%y %s %p\n' 2>/dev/null | sort
+
+printf 'Source hashes:\n'
+sha256sum \
+  /reference/canonical.py \
+  /reference/prompt.py \
+  /reference/py2mpy.py \
+  /candidate/prompt.py \
+  /candidate/py2mpy.py \
+  /candidate/solution.py \
+  /candidate/solution.mpy \
+  /candidate/semantic.k \
+  /candidate/verification.k \
+  /candidate/spec.k
+
+exit "$failure"

exec
/bin/bash -lc '/audit-output/evidence/run_logged.sh stage5_count_singleton_opposite kprove spec-count-opposite.k --definition /tmp/audit-work/build/verification-kompiled --spec-module SPEC-COUNT-OPPOSITE --claims singleton-wrongly-dropped' in /tmp/audit-work/candidate-src
