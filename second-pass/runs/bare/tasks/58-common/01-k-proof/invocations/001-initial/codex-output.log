+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Functional correctness for arbitrary finite integer lists.  The left
+  // side is exactly the constructor tree emitted in solution.mpy; the right
+  // side is the independently named contract operation from verification.k.
+  claim
+    <py>
+      <k>
+        Module(
+          FuncDef("common", Params("l1", "l2"),
+            Return(
+              Call(
+                Name("sorted"),
+                BinOp(
+                  "&",
+                  Call(Name("set"), Name("l1")),
+                  Call(Name("set"), Name("l2")))))))
+        => list(commonSpec(IS1 ; IS2))
+      </k>
+      <l1> list(IS1) </l1>
+      <l2> list(IS2) </l2>
+    </py>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9d0420a4af34ab7d93282ff8a7745d49c20dbaee
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,11 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // Mathematical contract: convert each input to a finite integer set,
+  // intersect the sets, then put the elements in ascending order.
+  syntax Ints ::= "commonSpec" "(" Ints ";" Ints ")" [function]
+  rule commonSpec(IS ; JS)
+    => sortInts(intersectInts(uniqueInts(IS) ; uniqueInts(JS)))
+endmodule

