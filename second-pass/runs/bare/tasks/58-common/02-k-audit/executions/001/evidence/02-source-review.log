     1	module SEMANTIC-SYNTAX
     2	  imports INT
     3	  imports STRING
     4	
     5	  // The concrete syntax emitted by py2mpy.py for solution.py.
     6	  syntax PyModule ::= "Module" "(" PyStmt ")"
     7	  syntax PyStmt   ::= "FuncDef" "(" String "," Params "," PyStmt ")"
     8	                    | "Return" "(" PyExpr ")"
     9	  syntax Params   ::= "Params" "(" String "," String ")"
    10	  syntax PyExpr   ::= "Name" "(" String ")"
    11	                    | "Call" "(" PyExpr "," PyExpr ")"
    12	                    | "BinOp" "(" String "," PyExpr "," PyExpr ")"
    13	
    14	  // Values are deliberately restricted to the integer-list fragment needed
    15	  // by this HumanEval problem.
    16	  syntax Ints ::= List{Int, ","}
    17	  syntax PyValue ::= "list" "(" Ints ")"
    18	                   | "set" "(" Ints ")"
    19	endmodule
