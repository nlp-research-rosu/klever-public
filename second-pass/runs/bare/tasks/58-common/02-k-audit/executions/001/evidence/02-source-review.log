    21	module SEMANTIC
    22	  imports SEMANTIC-SYNTAX
    23	  imports BOOL
    24	
    25	  configuration
    26	    <py>
    27	      <k> $PGM:PyModule </k>
    28	      <l1> $L1:PyValue </l1>
    29	      <l2> $L2:PyValue </l2>
    30	    </py>
    31	
    32	  // Integer-list operations used to model Python set conversion,
    33	  // intersection, and sorted.  A set is represented by a duplicate-free
    34	  // Ints sequence; its incidental order is unobservable after sorted.
    35	  syntax Bool ::= "containsInt" "(" Int ";" Ints ")" [function]
    36	  rule containsInt(_ ; .Ints) => false
    37	  rule containsInt(I ; J, IS) => (I ==Int J) orBool containsInt(I ; IS)
    38	
    39	  syntax Ints ::= "uniqueInts" "(" Ints ")" [function]
    40	  rule uniqueInts(.Ints) => .Ints
    41	  rule uniqueInts(I, IS) => uniqueInts(IS)
    42	    requires containsInt(I ; IS)
    43	  rule uniqueInts(I, IS) => I, uniqueInts(IS)
    44	    requires notBool containsInt(I ; IS)
    45	
    46	  syntax Ints ::= "intersectInts" "(" Ints ";" Ints ")" [function]
    47	  rule intersectInts(.Ints ; _) => .Ints
    48	  rule intersectInts(I, IS ; JS) => I, intersectInts(IS ; JS)
    49	    requires containsInt(I ; JS)
    50	  rule intersectInts(I, IS ; JS) => intersectInts(IS ; JS)
    51	    requires notBool containsInt(I ; JS)
    52	
    53	  syntax Ints ::= "insertInt" "(" Int ";" Ints ")" [function]
    54	  rule insertInt(I ; .Ints) => I, .Ints
    55	  rule insertInt(I ; J, IS) => I, J, IS
    56	    requires I <=Int J
    57	  rule insertInt(I ; J, IS) => J, insertInt(I ; IS)
    58	    requires I >Int J
    59	
    60	  syntax Ints ::= "sortInts" "(" Ints ")" [function]
    61	  rule sortInts(.Ints) => .Ints
    62	  rule sortInts(I, IS) => insertInt(I ; sortInts(IS))
    63	
    64	  syntax PyValue ::= "makeSet" "(" PyValue ")" [function]
    65	                   | "setAnd" "(" PyValue ";" PyValue ")" [function]
    66	                   | "sortedValue" "(" PyValue ")" [function]
    67	  rule makeSet(list(IS)) => set(uniqueInts(IS))
    68	  rule setAnd(set(IS) ; set(JS)) => set(intersectInts(IS ; JS))
    69	  rule sortedValue(set(IS)) => list(sortInts(IS))
    70	  rule sortedValue(list(IS)) => list(sortInts(IS))
    71	
    72	  // Compositional expression evaluation.  Parameter names are carried by
    73	  // the evaluator, so Name has ordinary lexical lookup for this two-argument
    74	  // function fragment.
    75	  syntax PyValue ::= "eval" "(" PyExpr ";" String ";" PyValue ";"
    76	                              String ";" PyValue ")" [function]
    77	  rule eval(Name(X) ; X ; V1 ; _ ; _) => V1
    78	  rule eval(Name(Y) ; X ; _ ; Y ; V2) => V2
    79	    requires X =/=String Y
    80	  rule eval(Call(Name("set"), E) ; X ; V1 ; Y ; V2)
    81	    => makeSet(eval(E ; X ; V1 ; Y ; V2))
    82	  rule eval(Call(Name("sorted"), E) ; X ; V1 ; Y ; V2)
    83	    => sortedValue(eval(E ; X ; V1 ; Y ; V2))
    84	  rule eval(BinOp("&", E1, E2) ; X ; V1 ; Y ; V2)
    85	    => setAnd(eval(E1 ; X ; V1 ; Y ; V2) ;
    86	              eval(E2 ; X ; V1 ; Y ; V2))
    87	
    88	  syntax KItem ::= "execute" "(" PyStmt ";" String ";" PyValue ";"
    89	                               String ";" PyValue ")"
    90	
    91	  // Loading the translated module binds its two parameters to the two input
    92	  // cells and executes its body.  Return replaces the control term by the
    93	  // expression's value.
    94	  rule <k> Module(FuncDef("common", Params(X, Y), BODY))
    95	        => execute(BODY ; X ; V1 ; Y ; V2) ... </k>
    96	       <l1> V1 </l1>
    97	       <l2> V2 </l2>
    98	  rule <k> execute(Return(E) ; X ; V1 ; Y ; V2)
    99	        => eval(E ; X ; V1 ; Y ; V2) ... </k>
   100	endmodule
FILE /candidate/verification.k
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // Mathematical contract: convert each input to a finite integer set,
     7	  // intersect the sets, then put the elements in ascending order.
     8	  syntax Ints ::= "commonSpec" "(" Ints ";" Ints ")" [function]
     9	  rule commonSpec(IS ; JS)
    10	    => sortInts(intersectInts(uniqueInts(IS) ; uniqueInts(JS)))
    11	endmodule
FILE /candidate/spec.k
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Functional correctness for arbitrary finite integer lists.  The left
     7	  // side is exactly the constructor tree emitted in solution.mpy; the right
     8	  // side is the independently named contract operation from verification.k.
     9	  claim
    10	    <py>
    11	      <k>
    12	        Module(
    13	          FuncDef("common", Params("l1", "l2"),
    14	            Return(
    15	              Call(
    16	                Name("sorted"),
    17	                BinOp(
    18	                  "&",
    19	                  Call(Name("set"), Name("l1")),
    20	                  Call(Name("set"), Name("l2")))))))
    21	        => list(commonSpec(IS1 ; IS2))
    22	      </k>
    23	      <l1> list(IS1) </l1>
    24	      <l2> list(IS2) </l2>
    25	    </py>
    26	endmodule
FILE /candidate/mutation-spec.k
     1	requires "verification.k"
     2	
     3	module MUTATION-SPEC
     4	  imports VERIFICATION
     5	
     6	  // Negative validation probe: this mutant uses l1 for both set operands.
     7	  // Its alleged correctness claim must not prove for arbitrary IS1 and IS2.
     8	  claim
     9	    <py>
    10	      <k>
    11	        Module(
    12	          FuncDef("common", Params("l1", "l2"),
    13	            Return(
    14	              Call(
    15	                Name("sorted"),
    16	                BinOp(
    17	                  "&",
    18	                  Call(Name("set"), Name("l1")),
    19	                  Call(Name("set"), Name("l1")))))))
    20	        => list(commonSpec(IS1 ; IS2))
    21	      </k>
    22	      <l1> list(IS1) </l1>
    23	      <l2> list(IS2) </l2>
    24	    </py>
    25	endmodule
FILE /candidate/prove.sh
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd -- "$(dirname -- "$0")"
     5	
     6	# Recreate the checked constructor program from the submitted Python source.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	
     9	# The verification definition imports the executable semantics and adds only
    10	# the mathematical commonSpec operation.
    11	kompile verification.k \
    12	  --main-module VERIFICATION \
    13	  --syntax-module SEMANTIC-SYNTAX \
    14	  --backend haskell
    15	
    16	# Exercise both prompt examples plus duplicate/negative and empty-list cases.
    17	krun solution.mpy --definition verification-kompiled \
    18	  -cL1='list(1,4,3,34,653,2,5)' \
    19	  -cL2='list(5,7,1,5,9,653,121)'
    20	krun solution.mpy --definition verification-kompiled \
    21	  -cL1='list(5,3,2,8)' \
    22	  -cL2='list(3,2)'
    23	krun solution.mpy --definition verification-kompiled \
    24	  -cL1='list(3,3,-1,2)' \
    25	  -cL2='list(3,-1,-1)'
    26	krun solution.mpy --definition verification-kompiled \
    27	  -cL1='list()' \
    28	  -cL2='list(1,1)'
    29	
    30	# Positive target proof: this must print #Top and exit zero.
    31	kprove spec.k --definition verification-kompiled --spec-module SPEC
    32	
    33	# Expected-failure mutation probe.  If this proves, the validation is unsound.
    34	if kprove mutation-spec.k \
    35	    --definition verification-kompiled \
    36	    --spec-module MUTATION-SPEC; then
    37	  echo 'ERROR: the deliberately incorrect mutation unexpectedly proved' >&2
    38	  exit 1
    39	else
    40	  echo 'Expected failure: the l1/l1 intersection mutation was rejected.'
    41	fi
EXIT_STATUS: 0
