+overall=0
+
+run_expected_failure() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  if [[ "$status" -eq 0 ]]; then
+    printf 'UNEXPECTED_SUCCESS\n'
