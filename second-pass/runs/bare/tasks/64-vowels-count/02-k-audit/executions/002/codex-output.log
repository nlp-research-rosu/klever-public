     1	def vowels_count(s):
     2	    if s == "":
     3	        return 0
     4	    if s[0] in "aeiouAEIOU":
     5	        return 1 + vowels_count(s[1:])
     6	    if len(s) == 1 and s[0] in "yY":
     7	        return 1
     8	    return vowels_count(s[1:])
