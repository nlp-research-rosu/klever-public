+translator_exit=$?
+kast \
+  /tmp/audit-work/solution-body-mutated.mpy \
+  --definition /tmp/audit-work/verification-fresh-kompiled \
+  --module MPY-SYNTAX \
+  --sort Program \
+  --expand-macros \
+  --output kore \
+  --output-file /tmp/audit-work/mutated-expanded.kore
+kast_exit=$?
