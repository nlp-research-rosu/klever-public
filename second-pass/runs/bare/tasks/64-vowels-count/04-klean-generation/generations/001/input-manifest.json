      "normalized_sha256": "446e7a734fabed5a2e572668cda7855a61d25da12a442b82a62f647c84f77bd3",
      "rationale": "This is the base equation defining the #vowels mathematical summary on the empty string.",
      "source_rule_id": "rule-446e7a734fabed5a2e572668cda7855a61d25da12a442b82a62f647c84f77bd3",
      "start_line": 11,
      "text": "  rule #vowels(\"\") => 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 16,
      "module": "VERIFICATION",
      "normalized_sha256": "978c7862f1563f18c6de2c29b31592e2015d58e41236161ec41227b34122fc54",
      "rationale": "This recurrence defines #vowels for a nonempty string whose first character is an ordinary vowel, adding one and summarizing the tail.",
      "source_rule_id": "rule-978c7862f1563f18c6de2c29b31592e2015d58e41236161ec41227b34122fc54",
      "start_line": 13,
      "text": "  rule #vowels(S) =>\n       1 +Int #vowels(substrString(S, 1, lengthString(S)))\n    requires S =/=String \"\"\n     andBool #isVowelChar(substrString(S, 0, 1))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 22,
      "module": "VERIFICATION",
      "normalized_sha256": "fff7ec9596c3f8bfea2b8032980d90cb281da9e279b32474488f5f03c5c489f7",
      "rationale": "This equation defines the terminal y/Y branch of #vowels, returning one when the sole remaining non-ordinary-vowel character is y or Y.",
      "source_rule_id": "rule-fff7ec9596c3f8bfea2b8032980d90cb281da9e279b32474488f5f03c5c489f7",
      "start_line": 18,
      "text": "  rule #vowels(S) => 1\n    requires S =/=String \"\"\n     andBool notBool #isVowelChar(substrString(S, 0, 1))\n     andBool lengthString(S) ==Int 1\n     andBool #isYChar(substrString(S, 0, 1))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 29,
      "module": "VERIFICATION",
      "normalized_sha256": "b63a26b5a4b87f3f77a92f06b896b36655a9114c01cfdee89d791439a893db9e",
      "rationale": "This fallback recurrence defines #vowels by summarizing the tail when the first character contributes no vowel count.",
      "source_rule_id": "rule-b63a26b5a4b87f3f77a92f06b896b36655a9114c01cfdee89d791439a893db9e",
      "start_line": 24,
      "text": "  rule #vowels(S) =>\n       #vowels(substrString(S, 1, lengthString(S)))\n    requires S =/=String \"\"\n     andBool notBool #isVowelChar(substrString(S, 0, 1))\n     andBool (lengthString(S) =/=Int 1\n              orBool notBool #isYChar(substrString(S, 0, 1)))"
    }
  ],
