+        == observed["stage1_export_sha256"]
+        and input_manifest["frozen_input_sha256"]
+        == observed["stage1_export_sha256"]
+    ),
+    "generator_provenance_stage1_hash_matches": (
+        generator_manifest["provenance"]["stage1_workspace_sha256"]
+        == observed["stage1_export_sha256"]
