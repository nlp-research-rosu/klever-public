+    ),
+    "klean.py": file_sha256(Path("/reference/generation-tools/klean.py")),
+}
+image_id = generator_manifest["provenance"]["generator_image_id"]
+image_key = image_id.removeprefix("sha256:")
+recorded_bundle_key = Path(
