+  rule <k> #return(V) ~> _SS:Stmts => #return(V) ... </k>
+  rule <k> #return(V) ~> #endCall => V ... </k>
+       <env> _ => ENV </env>
+       <stack> ListItem(ENV) REST => REST </stack>
+
+  // Comparisons below split symbolic paths into concrete Boolean values, so
+  // control flow itself has the usual deterministic true/false rules.
+  rule <k> (If(boolVal(true), THEN, _ELSE):Stmt) => THEN ... </k>
+  rule <k> (If(boolVal(false), _THEN, ELSE):Stmt) => ELSE ... </k>
+  rule BoolOp("and", boolVal(true), RHS) => RHS
+  rule BoolOp("and", boolVal(false), _RHS) => boolVal(false)
