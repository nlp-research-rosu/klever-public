Module(
  FuncDef("vowels_count", Params("s"),
    If(Compare(Name("s"), CmpOp("==", Str(""))),
      Return(Int(0)),
      )
    If(Compare(
      Subscript(Name("s"), Int(0)),
      CmpOp("in", Str("aeiouAEIOU"))),
      Return(
        BinOp(
          "+",
          Int(1),
          Call(
            Name("vowels_count"),
            Subscript(Name("s"), Slice(Int(1), NoBound, NoBound))))),
      )
    If(BoolOp(
      "and",
      Compare(Call(Name("len"), Name("s")), CmpOp("==", Int(1))),
      Compare(Subscript(Name("s"), Int(0)), CmpOp("in", Str("yY")))),
      Return(Int(1)),
      )
    Return(
      Call(
        Name("vowels_count"),
        Subscript(Name("s"), Slice(Int(1), NoBound, NoBound))))))
