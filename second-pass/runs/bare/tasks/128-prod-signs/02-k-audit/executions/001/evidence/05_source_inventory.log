semantic.k:1:module MPY-SYNTAX
semantic.k:2:  imports INT-SYNTAX
semantic.k:3:  imports BOOL-SYNTAX
semantic.k:4:  imports STRING-SYNTAX
semantic.k:6:  syntax Pgm ::= "Module" "(" Stmts ")"
semantic.k:8:  syntax Stmts ::= List{Stmt, ""}
semantic.k:9:  syntax Exprs ::= List{Expr, ","}
semantic.k:10:  syntax CmpOps ::= List{CmpOp, ","}
semantic.k:11:  syntax Strings ::= List{String, ","}
semantic.k:12:  syntax Ints ::= List{Int, ","}
semantic.k:14:  syntax Params ::= "Params" "(" Strings ")"
semantic.k:16:  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
semantic.k:22:  syntax Expr ::= "Name" "(" String ")"
semantic.k:30:  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
semantic.k:33:  syntax Value ::= Int | Bool | "none" | "listVal" "(" Ints ")"
semantic.k:34:  syntax Input ::= "input" "(" Ints ")"
semantic.k:35:endmodule
semantic.k:37:module SEMANTIC
semantic.k:38:  imports MPY-SYNTAX
semantic.k:39:  imports INT
semantic.k:40:  imports BOOL
semantic.k:41:  imports STRING
semantic.k:42:  imports MAP
semantic.k:44:  syntax Function ::= ".Function" | "function" "(" String "," Stmts ")"
semantic.k:45:  syntax Result ::= "noResult" | "result" "(" Value ")"
semantic.k:47:  configuration
semantic.k:56:  syntax KItem ::= "boot" "(" Pgm ")"
semantic.k:71:  rule boot(Module(SS)) => exec(SS) ~> start
semantic.k:73:  rule exec(.Stmts) => .K
semantic.k:74:  rule exec(S:Stmt SS:Stmts) => S ~> exec(SS)
semantic.k:76:  rule <k> FuncDef("prod_signs", Params(P), BODY) => .K ...</k>
semantic.k:79:  rule <k> start => exec(BODY) ...</k>
semantic.k:84:  rule Assign(Name(X), E) => eval(E) ~> store(X)
semantic.k:85:  rule <k> V:Value ~> store(X) => .K ...</k>
semantic.k:87:  rule <k> V:Value ~> store(X) => .K ...</k>
semantic.k:89:    requires notBool (X in_keys(RHO))
semantic.k:91:  rule <k> bind(X, V) => .K ...</k>
semantic.k:93:  rule <k> bind(X, V) => .K ...</k>
semantic.k:95:    requires notBool (X in_keys(RHO))
semantic.k:97:  rule If(E, THEN, ELSE) => eval(E) ~> branch(THEN, ELSE)
semantic.k:98:  rule true  ~> branch(THEN, _) => exec(THEN)
semantic.k:99:  rule false ~> branch(_, ELSE) => exec(ELSE)
semantic.k:101:  rule For(Name(X), E, BODY) => eval(E) ~> forStart(X, BODY)
semantic.k:102:  rule listVal(IS) ~> forStart(X, BODY) => loop(X, IS, BODY)
semantic.k:103:  rule loop(_, .Ints, _) => .K
semantic.k:104:  rule loop(X, I, IS, BODY) => bind(X, I) ~> exec(BODY) ~> loop(X, IS, BODY)
semantic.k:106:  rule Return(E) => eval(E) ~> returnK
semantic.k:107:  rule <k> V:Value ~> returnK ~> _REST => .K </k>
semantic.k:110:  rule eval(Int(I)) => I
semantic.k:111:  rule eval(NoneVal) => none
semantic.k:112:  rule eval(ListExpr(.Exprs)) => listVal(.Ints)
semantic.k:113:  rule <k> eval(Name(X)) => V ...</k>
semantic.k:116:  rule eval(UnaryOp(OP, E)) => eval(E) ~> binRight(OP, 0)
semantic.k:117:  rule eval(BinOp(OP, E1, E2)) => eval(E1) ~> binLeft(OP, E2)
semantic.k:118:  rule V:Value ~> binLeft(OP, E2) => eval(E2) ~> binRight(OP, V)
semantic.k:120:  rule I2:Int ~> binRight("+", I1:Int) => I1 +Int I2
semantic.k:121:  rule I2:Int ~> binRight("-", I1:Int) => I1 -Int I2
semantic.k:122:  rule I2:Int ~> binRight("*", I1:Int) => I1 *Int I2
semantic.k:123:  rule I:Int  ~> binRight("-", 0)      => 0 -Int I
semantic.k:125:  rule eval(Compare(E, OPS)) => eval(E) ~> cmpLeft(OPS)
semantic.k:126:  rule V:Value ~> cmpLeft(CmpOp(OP, E), .CmpOps)
semantic.k:129:  rule I2:Int ~> cmpRight("<",  I1:Int) => I1 <Int I2
semantic.k:130:  rule I2:Int ~> cmpRight("==", I1:Int) => I1 ==Int I2
semantic.k:131:  rule listVal(.Ints) ~> cmpRight("==", listVal(.Ints)) => true
semantic.k:132:  rule listVal(.Ints) ~> cmpRight("==", listVal(_I, _IS)) => false
semantic.k:133:endmodule
verification.k:1:requires "semantic.k"
verification.k:3:module VERIFICATION
verification.k:4:  imports SEMANTIC
verification.k:7:  syntax Int ::= "magnitude" "(" Int ")" [function, total]
verification.k:11:  syntax Value ::= "contract" "(" Ints ")" [function, total]
verification.k:13:  rule magnitude(I) => 0 -Int I requires I <Int 0
verification.k:14:  rule magnitude(I) => I        requires I >=Int 0
verification.k:16:  rule integerSign(I) => -1 requires I <Int 0
verification.k:17:  rule integerSign(0) => 0
verification.k:18:  rule integerSign(I) => 1  requires I >Int 0
verification.k:20:  rule sumMagnitudes(.Ints) => 0
verification.k:21:  rule sumMagnitudes(I, IS) => magnitude(I) +Int sumMagnitudes(IS)
verification.k:23:  rule productSigns(.Ints) => 1
verification.k:24:  rule productSigns(I, IS) => integerSign(I) *Int productSigns(IS)
verification.k:26:  rule contract(.Ints) => none
verification.k:27:  rule contract(I, IS)
