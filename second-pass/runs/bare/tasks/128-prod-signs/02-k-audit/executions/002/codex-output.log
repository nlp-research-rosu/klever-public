     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // Mathematical contract, independent of the program's control flow.
     7	  syntax Int ::= "magnitude" "(" Int ")" [function, total]
     8	               | "integerSign" "(" Int ")" [function, total]
     9	               | "sumMagnitudes" "(" Ints ")" [function, total]
    10	               | "productSigns" "(" Ints ")" [function, total]
    11	  syntax Value ::= "contract" "(" Ints ")" [function, total]
    12	
    13	  rule magnitude(I) => 0 -Int I requires I <Int 0
    14	  rule magnitude(I) => I        requires I >=Int 0
    15	
    16	  rule integerSign(I) => -1 requires I <Int 0
    17	  rule integerSign(0) => 0
    18	  rule integerSign(I) => 1  requires I >Int 0
    19	
    20	  rule sumMagnitudes(.Ints) => 0
    21	  rule sumMagnitudes(I, IS) => magnitude(I) +Int sumMagnitudes(IS)
    22	
    23	  rule productSigns(.Ints) => 1
    24	  rule productSigns(I, IS) => integerSign(I) *Int productSigns(IS)
    25	
    26	  rule contract(.Ints) => none
    27	  rule contract(I, IS)
    28	    => sumMagnitudes(I, IS) *Int productSigns(I, IS)
    29	
    30	  // These constants are a readable embedding of solution.mpy.  The loop body
    31	  // is also named so the inductive loop-step claims in spec.k stay compact.
    32	  syntax Stmts ::= "solutionLoopBody" [function]
    33	  rule solutionLoopBody =>
    34	    If(Compare(Name("x"), CmpOp("<", Int(0))),
    35	      Assign(Name("total"), BinOp("-", Name("total"), Name("x")))
    36	      Assign(Name("sign"), UnaryOp("-", Name("sign"))),
    37	      Assign(Name("total"), BinOp("+", Name("total"), Name("x")))
    38	      If(Compare(Name("x"), CmpOp("==", Int(0))),
    39	        Assign(Name("sign"), Int(0)),
    40	        .Stmts))
    41	
    42	  syntax Stmts ::= "solutionBody" [function]
    43	  rule solutionBody =>
    44	    If(Compare(Name("arr"), CmpOp("==", ListExpr(.Exprs))),
    45	      Return(NoneVal),
    46	      .Stmts)
    47	    Assign(Name("total"), Int(0))
    48	    Assign(Name("sign"), Int(1))
    49	    Assign(Name("x"), Int(0))
    50	    For(Name("x"), Name("arr"), solutionLoopBody)
    51	    Return(BinOp("*", Name("total"), Name("sign")))
    52	
    53	  syntax Pgm ::= "solutionProgram" [function]
    54	  rule solutionProgram =>
    55	    Module(
    56	      FuncDef("prod_signs", Params("arr"), solutionBody))
    57	endmodule
