+    <env> .Map =>
+      "arr" |-> listVal(1, 2, 2, -4)
+      "total" |-> 9
+      "sign" |-> -1
+      "x" |-> -4
+    </env>
+    <result> noResult => result(contract(1, 2, 2, -4)) </result>
+
+  claim [example-zero]:
