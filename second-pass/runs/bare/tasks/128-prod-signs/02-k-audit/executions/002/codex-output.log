from pathlib import Path
import hashlib,os,stat,itertools
T='de7a38e713e0e2c6636f66aa4e9e6a4d779d776f6e2833e6bb2ec910e920bea1'
root=Path('/candidate');ents=[];pending=[root]
while pending:
 d=pending.pop()
 for c in os.scandir(d):
  p=Path(c.path);st=c.stat(follow_symlinks=False);r=p.relative_to(root).as_posix()
  if stat.S_ISDIR(st.st_mode):k='directory';pending.append(p)
  elif stat.S_ISREG(st.st_mode):k='file'
  else:continue
  ents.append((r,k,p,st))
ents.sort()
def opts(r,k,p,st):
 rb=r.encode(); kb=k.encode(); mode=stat.S_IMODE(st.st_mode);size=st.st_size;data=p.read_bytes() if k=='file' else b''
 return (
  [rb,rb+b'\\0',len(rb).to_bytes(4,'big')+rb,b'./'+rb,b'./'+rb+b'\\0'],
  [b'',kb,kb+b'\\0',k[:1].encode(),k[:1].encode()+b'\\0'],
  [b'',oct(mode).encode(),f'{mode:o}'.encode(),mode.to_bytes(4,'big'),str(mode).encode()],
  [b'',size.to_bytes(8,'big'),str(size).encode(),str(size).encode()+b'\\0'],
  [data,hashlib.sha256(data).digest(),hashlib.sha256(data).hexdigest().encode()] if k=='file' else [b''],
 )
# use same option index styles, but content lens differ
for pi,ki,mi,si,ci,sep in itertools.product(range(5),range(5),range(5),range(4),range(3),(b'',b'\\0',b'\\n',b'  ')):
 h=hashlib.sha256();ok=True
 for r,k,p,st in ents:
  os_=opts(r,k,p,st)
  if ci>=len(os_[4]):ok=False;break
  h.update(os_[0][pi]+os_[1][ki]+os_[2][mi]+os_[3][si]+os_[4][ci]+sep)
 if ok and h.hexdigest()==T:
  print('MATCH',pi,ki,mi,si,ci,sep);break
else: print('none',len(ents))
