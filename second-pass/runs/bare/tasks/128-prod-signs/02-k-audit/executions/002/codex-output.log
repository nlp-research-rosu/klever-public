  e=r.encode();h.update(len(e).to_bytes(4,'big'));h.update(e);h.update(k.encode()+b'\\0')
  if k=='file':
   h.update(p.stat(follow_symlinks=False).st_size.to_bytes(8,'big'));h.update(p.read_bytes())
 return h.hexdigest()
for p in ['/candidate','/generation-evidence/codex-trace']:
 print(p,tree(p))
