import hashlib,os,stat

def tree(root):
 root=Path(root);h=hashlib.sha256();pending=[root]; entries=[]
 while pending:
  d=pending.pop()
  for c in os.scandir(d):
   p=Path(c.path);m=c.stat(follow_symlinks=False).st_mode;r=p.relative_to(root).as_posix()
   if stat.S_ISDIR(m):entries.append((r,'directory',p));pending.append(p)
   elif stat.S_ISREG(m):entries.append((r,'file',p))
