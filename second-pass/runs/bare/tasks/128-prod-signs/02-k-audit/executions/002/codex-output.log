+    </env>
+    <result> noResult </result>
+
+  claim [negative-step]:
+    <k> loop("x", X, IS, solutionLoopBody) => loop("x", IS, solutionLoopBody) ...</k>
+    <env>
+      RHO:Map
+      "x" |-> _OLD:Int
+      "total" |-> T:Int
+      "sign" |-> S:Int
+      => RHO
+         "x" |-> X
+         "total" |-> T +Int magnitude(X)
+         "sign" |-> S *Int integerSign(X)
+    </env>
+    requires X <Int 0
+
+  claim [positive-step]:
+    <k> loop("x", X, IS, solutionLoopBody) => loop("x", IS, solutionLoopBody) ...</k>
+    <env>
+      RHO:Map
+      "x" |-> _OLD:Int
+      "total" |-> T:Int
+      "sign" |-> S:Int
+      => RHO
+         "x" |-> X
+         "total" |-> T +Int magnitude(X)
+         "sign" |-> S *Int integerSign(X)
+    </env>
+    requires X >Int 0
+
+  claim [zero-step]:
+    <k> loop("x", X, IS, solutionLoopBody) => loop("x", IS, solutionLoopBody) ...</k>
+    <env>
+      RHO:Map
+      "x" |-> _OLD:Int
+      "total" |-> T:Int
+      "sign" |-> S:Int
+      => RHO
+         "x" |-> 0
+         "total" |-> T +Int magnitude(X)
+         "sign" |-> S *Int integerSign(X)
