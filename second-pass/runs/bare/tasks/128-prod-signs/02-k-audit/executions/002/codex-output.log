from pathlib import Path
import hashlib, json, os, stat

def test(root, target):
 p=Path(root)
 files=sorted(x for x in p.rglob('*') if x.is_file())
 rels=[x.relative_to(p).as_posix() for x in files]
 vals=[]
 for include_dirs in (False,True):
  ents=sorted(p.rglob('*')) if include_dirs else files
  for content_form in ('raw','hex','digest'):
   for sep in (b'',b'\\0',b'\\n',b'  '):
    for trail in (False,True):
     h=hashlib.sha256()
     for x in ents:
      rel=x.relative_to(p).as_posix().encode()
      if x.is_dir(): v=b'DIR'
      else:
       d=x.read_bytes()
       v={'raw':d,'hex':hashlib.sha256(d).hexdigest().encode(),'digest':hashlib.sha256(d).digest()}[content_form]
      h.update(rel);h.update(sep);h.update(v)
      if trail:h.update(b'\\n')
     if h.hexdigest()==target: print('MATCH',include_dirs,content_form,sep,trail)
 for obj in (
   {r:hashlib.sha256(x.read_bytes()).hexdigest() for r,x in zip(rels,files)},
   [{'path':r,'sha256':hashlib.sha256(x.read_bytes()).hexdigest()} for r,x in zip(rels,files)],
 ):
  for sort in (False,True):
   for compact in (False,True):
    b=json.dumps(obj,sort_keys=sort,separators=(',',':') if compact else None).encode()
    if hashlib.sha256(b).hexdigest()==target: print('JSON MATCH',type(obj),sort,compact)
 print(root,len(files),'target',target)

