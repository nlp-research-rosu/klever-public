+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Empty-input clause of the contract, through the translated program.
+  claim
+    <k> boot(solutionProgram) => .K </k>
+    <input> input(.Ints) </input>
+    <function> .Function => function("arr",
+      If(Compare(Name("arr"), CmpOp("==", ListExpr(.Exprs))),
+        Return(NoneVal), .Stmts)
+      Assign(Name("total"), Int(0))
+      Assign(Name("sign"), Int(1))
+      Assign(Name("x"), Int(0))
+      For(Name("x"), Name("arr"), solutionLoopBody)
+      Return(BinOp("*", Name("total"), Name("sign")))) </function>
+    <env> .Map => "arr" |-> listVal(.Ints) </env>
+    <result> noResult => result(contract(.Ints)) </result>
+
+  // A symbolic nonempty input reaches the loop with the invariant initialized:
+  // total = 0 and sign = 1.  X and IS stand for every nonempty integer list.
+  claim
+    <k> boot(solutionProgram)
+      => loop("x", X, IS, solutionLoopBody)
+      ~> exec(Return(BinOp("*", Name("total"), Name("sign"))) .Stmts)
+    </k>
+    <input> input(X, IS) </input>
+    <function> .Function => function("arr",
+      If(Compare(Name("arr"), CmpOp("==", ListExpr(.Exprs))),
+        Return(NoneVal), .Stmts)
+      Assign(Name("total"), Int(0))
+      Assign(Name("sign"), Int(1))
+      Assign(Name("x"), Int(0))
+      For(Name("x"), Name("arr"), solutionLoopBody)
+      Return(BinOp("*", Name("total"), Name("sign")))) </function>
+    <env> .Map =>
+      "arr" |-> listVal(X, IS)
+      "total" |-> 0
+      "sign" |-> 1
+      "x" |-> 0
+    </env>
+    <result> noResult </result>
+
+  // Inductive loop step, negative head: add |X| and multiply sign by -1.
+  claim
+    <k> loop("x", X, IS, solutionLoopBody) => loop("x", IS, solutionLoopBody) ...</k>
+    <env>
+      RHO:Map
+      "x" |-> OLD:Int
+      "total" |-> T:Int
+      "sign" |-> S:Int
+      => RHO
+         "x" |-> X
+         "total" |-> T -Int X
+         "sign" |-> 0 -Int S
+    </env>
+    requires X <Int 0
+
+  // Inductive loop step, positive head: add X and retain the sign product.
+  claim
+    <k> loop("x", X, IS, solutionLoopBody) => loop("x", IS, solutionLoopBody) ...</k>
+    <env>
+      RHO:Map
+      "x" |-> OLD:Int
+      "total" |-> T:Int
+      "sign" |-> S:Int
+      => RHO
+         "x" |-> X
+         "total" |-> T +Int X
+         "sign" |-> S
+    </env>
+    requires X >Int 0
+
+  // Inductive loop step, zero head: magnitude is unchanged and sign absorbs 0.
+  claim
+    <k> loop("x", X, IS, solutionLoopBody) => loop("x", IS, solutionLoopBody) ...</k>
+    <env>
+      RHO:Map
+      "x" |-> OLD:Int
+      "total" |-> T:Int
+      "sign" |-> S:Int
+      => RHO
+         "x" |-> 0
+         "total" |-> T
+         "sign" |-> 0
+    </env>
+    requires X ==Int 0
+
+  // Loop exit returns exactly the product of the two invariant components.
+  claim
+    <k> loop("x", .Ints, solutionLoopBody)
+      ~> exec(Return(BinOp("*", Name("total"), Name("sign"))) .Stmts)
+      => .K
+    </k>
+    <env> RHO:Map "total" |-> T:Int "sign" |-> S:Int </env>
+    <result> noResult => result(T *Int S) </result>
+
+  // End-to-end prompt examples and a parity check with three negative values.
+  claim
+    <k> boot(solutionProgram) => .K </k>
+    <input> input(1, 2, 2, -4) </input>
+    <result> noResult => result(contract(1, 2, 2, -4)) </result>
+
+  claim
+    <k> boot(solutionProgram) => .K </k>
+    <input> input(0, 1) </input>
+    <result> noResult => result(contract(0, 1)) </result>
+
+  claim
+    <k> boot(solutionProgram) => .K </k>
+    <input> input(-1, -2, -3) </input>
+    <result> noResult => result(contract(-1, -2, -3)) </result>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..717598badc65d2cb0b9f277f67f42db0c553617e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,54 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // Mathematical contract, independent of the program's control flow.
+  syntax Int ::= "magnitude" "(" Int ")" [function, total]
+               | "integerSign" "(" Int ")" [function, total]
+               | "sumMagnitudes" "(" Ints ")" [function, total]
+               | "productSigns" "(" Ints ")" [function, total]
+  syntax Value ::= "contract" "(" Ints ")" [function, total]
+
+  rule magnitude(I) => 0 -Int I requires I <Int 0
+  rule magnitude(I) => I        requires I >=Int 0
+
+  rule integerSign(I) => -1 requires I <Int 0
+  rule integerSign(0) => 0
+  rule integerSign(I) => 1  requires I >Int 0
+
+  rule sumMagnitudes(.Ints) => 0
+  rule sumMagnitudes(I, IS) => magnitude(I) +Int sumMagnitudes(IS)
+
+  rule productSigns(.Ints) => 1
+  rule productSigns(I, IS) => integerSign(I) *Int productSigns(IS)
+
+  rule contract(.Ints) => none
+  rule contract(I, IS)
+    => sumMagnitudes(I, IS) *Int productSigns(I, IS)
+
+  // These constants are a readable embedding of solution.mpy.  The loop body
+  // is also named so the inductive loop-step claims in spec.k stay compact.
+  syntax Stmts ::= "solutionLoopBody" [function]
+  rule solutionLoopBody =>
+    If(Compare(Name("x"), CmpOp("<", Int(0))),
+      Assign(Name("total"), BinOp("-", Name("total"), Name("x")))
+      Assign(Name("sign"), UnaryOp("-", Name("sign"))),
+      Assign(Name("total"), BinOp("+", Name("total"), Name("x")))
+      If(Compare(Name("x"), CmpOp("==", Int(0))),
+        Assign(Name("sign"), Int(0)),
+        .Stmts))
+
+  syntax Pgm ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      FuncDef("prod_signs", Params("arr"),
+        If(Compare(Name("arr"), CmpOp("==", ListExpr(.Exprs))),
+          Return(NoneVal),
+          .Stmts)
+        Assign(Name("total"), Int(0))
+        Assign(Name("sign"), Int(1))
+        Assign(Name("x"), Int(0))
+        For(Name("x"), Name("arr"), solutionLoopBody)
+        Return(BinOp("*", Name("total"), Name("sign")))))
+endmodule

