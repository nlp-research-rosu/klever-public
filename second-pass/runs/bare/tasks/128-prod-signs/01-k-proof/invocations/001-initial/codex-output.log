+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "ListExpr" "(" Exprs ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "UnaryOp" "(" String "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "NoneVal"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
