+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+# Regenerate the constructor term from the submitted Python implementation.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Concrete execution uses the LLVM definition built from our semantics.
+kompile semantic.k \
+  --main-module SEMANTIC \
+  --syntax-module MPY-SYNTAX \
+  --backend llvm
+krun solution.mpy -cARGS='input(1,2,2,-4)'
+krun solution.mpy -cARGS='input(0,1)'
+krun solution.mpy -cARGS='input()'
+krun solution.mpy -cARGS='input(-1,-2,-3)'
+
+# Symbolic proof uses the Haskell backend and must print #Top.
+kompile verification.k \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --backend haskell
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..d8d2cc19a5579626e5c06ca2defe8658f48bd3e9
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,133 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax Strings ::= List{String, ","}
+  syntax Ints ::= List{Int, ","}
+
+  syntax Params ::= "Params" "(" Strings ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "ListExpr" "(" Exprs ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "UnaryOp" "(" String "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "NoneVal"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  // Values deliberately use a different list constructor from the source AST.
+  syntax Value ::= Int | Bool | "none" | "listVal" "(" Ints ")"
+  syntax Input ::= "input" "(" Ints ")"
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  syntax Function ::= ".Function" | "function" "(" String "," Stmts ")"
+  syntax Result ::= "noResult" | "result" "(" Value ")"
+
+  configuration
+    <mpy>
+      <k> boot($PGM:Pgm) </k>
+      <input> $ARGS:Input </input>
+      <function> .Function </function>
+      <env> .Map </env>
+      <result> noResult </result>
+    </mpy>
+
+  syntax KItem ::= "boot" "(" Pgm ")"
+                 | "exec" "(" Stmts ")"
+                 | "start"
+                 | "eval" "(" Expr ")"
+                 | "store" "(" String ")"
+                 | "bind" "(" String "," Value ")"
+                 | "branch" "(" Stmts "," Stmts ")"
+                 | "binLeft" "(" String "," Expr ")"
+                 | "binRight" "(" String "," Value ")"
+                 | "cmpLeft" "(" CmpOps ")"
+                 | "cmpRight" "(" String "," Value ")"
+                 | "forStart" "(" String "," Stmts ")"
+                 | "loop" "(" String "," Ints "," Stmts ")"
+                 | "returnK"
+
+  rule boot(Module(SS)) => exec(SS) ~> start
+
+  rule exec(.Stmts) => .K
+  rule exec(S:Stmt SS:Stmts) => S ~> exec(SS)
+
+  rule <k> FuncDef("prod_signs", Params(P), BODY) => .K ...</k>
+       <function> .Function => function(P, BODY) </function>
+
+  rule <k> start => exec(BODY) ...</k>
+       <input> input(IS) </input>
+       <function> function(P, BODY) </function>
+       <env> _ => P |-> listVal(IS) </env>
+
+  rule Assign(Name(X), E) => eval(E) ~> store(X)
+  rule <k> V:Value ~> store(X) => .K ...</k>
+       <env>... X |-> (_ => V) ...</env>
+  rule <k> V:Value ~> store(X) => .K ...</k>
+       <env> RHO => RHO X |-> V </env>
+    requires notBool (X in_keys(RHO))
+
+  rule <k> bind(X, V) => .K ...</k>
+       <env>... X |-> (_ => V) ...</env>
+  rule <k> bind(X, V) => .K ...</k>
+       <env> RHO => RHO X |-> V </env>
+    requires notBool (X in_keys(RHO))
+
+  rule If(E, THEN, ELSE) => eval(E) ~> branch(THEN, ELSE)
+  rule true  ~> branch(THEN, _) => exec(THEN)
+  rule false ~> branch(_, ELSE) => exec(ELSE)
+
+  rule For(Name(X), E, BODY) => eval(E) ~> forStart(X, BODY)
+  rule listVal(IS) ~> forStart(X, BODY) => loop(X, IS, BODY)
+  rule loop(_, .Ints, _) => .K
+  rule loop(X, I, IS, BODY) => bind(X, I) ~> exec(BODY) ~> loop(X, IS, BODY)
+
+  rule Return(E) => eval(E) ~> returnK
+  rule <k> V:Value ~> returnK ~> _REST => .K </k>
+       <result> noResult => result(V) </result>
+
+  rule eval(Int(I)) => I
+  rule eval(NoneVal) => none
+  rule eval(ListExpr(.Exprs)) => listVal(.Ints)
+  rule <k> eval(Name(X)) => V ...</k>
+       <env> ... X |-> V ...</env>
+
+  rule eval(UnaryOp(OP, E)) => eval(E) ~> binRight(OP, 0)
+  rule eval(BinOp(OP, E1, E2)) => eval(E1) ~> binLeft(OP, E2)
+  rule V:Value ~> binLeft(OP, E2) => eval(E2) ~> binRight(OP, V)
+
+  rule I2:Int ~> binRight("+", I1:Int) => I1 +Int I2
+  rule I2:Int ~> binRight("-", I1:Int) => I1 -Int I2
+  rule I2:Int ~> binRight("*", I1:Int) => I1 *Int I2
+  rule I:Int  ~> binRight("-", 0)      => 0 -Int I
+
+  rule eval(Compare(E, OPS)) => eval(E) ~> cmpLeft(OPS)
+  rule V:Value ~> cmpLeft(CmpOp(OP, E), .CmpOps)
+    => eval(E) ~> cmpRight(OP, V)
+
+  rule I2:Int ~> cmpRight("<",  I1:Int) => I1 <Int I2
+  rule I2:Int ~> cmpRight("==", I1:Int) => I1 ==Int I2
+  rule listVal(.Ints) ~> cmpRight("==", listVal(.Ints)) => true
+  rule listVal(.Ints) ~> cmpRight("==", listVal(_I, _IS)) => false
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..9b5a21861ce296fedfeedc080ac1495d09914b17
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,17 @@
+def prod_signs(arr):
+    if arr == []:
+        return None
+
+    total = 0
+    sign = 1
+    x = 0
+    for x in arr:
+        if x < 0:
+            total = total - x
+            sign = -sign
+        else:
+            total = total + x
+            if x == 0:
+                sign = 0
+
+    return total * sign
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..a36f4ab9b90ff8c2acee64e47fe8a3e29dba8c82
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,121 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Empty-input clause of the contract, through the translated program.
+  claim
+    <k> boot(solutionProgram) => .K </k>
+    <input> input(.Ints) </input>
+    <function> .Function => function("arr", solutionBody) </function>
+    <env> .Map => "arr" |-> listVal(.Ints) </env>
+    <result> noResult => result(contract(.Ints)) </result>
+
+  // A symbolic nonempty input reaches the loop with the invariant initialized:
+  // total = 0 and sign = 1.  X and IS stand for every nonempty integer list.
+  claim
+    <k> boot(solutionProgram)
+      => loop("x", X, IS, solutionLoopBody)
+      ~> exec(Return(BinOp("*", Name("total"), Name("sign"))) .Stmts)
+    </k>
+    <input> input(X, IS) </input>
+    <function> .Function => function("arr", solutionBody) </function>
+    <env> .Map =>
+      "arr" |-> listVal(X, IS)
+      "total" |-> 0
+      "sign" |-> 1
+      "x" |-> 0
+    </env>
+    <result> noResult </result>
+
+  // Inductive loop step, negative head: add |X| and multiply sign by -1.
+  claim
+    <k> loop("x", X, IS, solutionLoopBody) => loop("x", IS, solutionLoopBody) ...</k>
+    <env>
+      RHO:Map
+      "x" |-> _OLD:Int
+      "total" |-> T:Int
+      "sign" |-> S:Int
+      => RHO
+         "x" |-> X
+         "total" |-> T +Int magnitude(X)
+         "sign" |-> S *Int integerSign(X)
+    </env>
+    requires X <Int 0
+
+  // Inductive loop step, positive head: add X and retain the sign product.
+  claim
+    <k> loop("x", X, IS, solutionLoopBody) => loop("x", IS, solutionLoopBody) ...</k>
+    <env>
+      RHO:Map
+      "x" |-> _OLD:Int
+      "total" |-> T:Int
+      "sign" |-> S:Int
+      => RHO
+         "x" |-> X
+         "total" |-> T +Int magnitude(X)
+         "sign" |-> S *Int integerSign(X)
+    </env>
+    requires X >Int 0
+
+  // Inductive loop step, zero head: magnitude is unchanged and sign absorbs 0.
+  claim
+    <k> loop("x", X, IS, solutionLoopBody) => loop("x", IS, solutionLoopBody) ...</k>
+    <env>
+      RHO:Map
+      "x" |-> _OLD:Int
+      "total" |-> T:Int
+      "sign" |-> _S:Int
+      => RHO
+         "x" |-> 0
+         "total" |-> T +Int magnitude(X)
+         "sign" |-> _S *Int integerSign(X)
+    </env>
+    requires X ==Int 0
+
+  // Loop exit returns exactly the product of the two invariant components.
+  claim
+    <k> loop("x", .Ints, solutionLoopBody)
+      ~> exec(Return(BinOp("*", Name("total"), Name("sign"))) .Stmts)
+      => .K
+    </k>
+    <env> _RHO:Map "total" |-> T:Int "sign" |-> S:Int </env>
+    <result> noResult => result(T *Int S) </result>
+
+  // End-to-end prompt examples and a parity check with three negative values.
+  claim
+    <k> boot(solutionProgram) => .K </k>
+    <input> input(1, 2, 2, -4) </input>
+    <function> .Function => function("arr", solutionBody) </function>
+    <env> .Map =>
+      "arr" |-> listVal(1, 2, 2, -4)
+      "total" |-> 9
+      "sign" |-> -1
+      "x" |-> -4
+    </env>
+    <result> noResult => result(contract(1, 2, 2, -4)) </result>
+
+  claim
+    <k> boot(solutionProgram) => .K </k>
+    <input> input(0, 1) </input>
+    <function> .Function => function("arr", solutionBody) </function>
+    <env> .Map =>
+      "arr" |-> listVal(0, 1)
+      "total" |-> 1
+      "sign" |-> 0
+      "x" |-> 1
+    </env>
+    <result> noResult => result(contract(0, 1)) </result>
+
+  claim
+    <k> boot(solutionProgram) => .K </k>
+    <input> input(-1, -2, -3) </input>
+    <function> .Function => function("arr", solutionBody) </function>
+    <env> .Map =>
+      "arr" |-> listVal(-1, -2, -3)
+      "total" |-> 6
+      "sign" |-> -1
+      "x" |-> -3
+    </env>
+    <result> noResult => result(contract(-1, -2, -3)) </result>
+endmodule
