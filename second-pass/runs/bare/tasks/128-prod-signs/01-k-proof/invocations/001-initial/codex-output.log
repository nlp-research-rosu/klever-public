+
+  rule I2:Int ~> cmpRight("<",  I1:Int) => I1 <Int I2
+  rule I2:Int ~> cmpRight("==", I1:Int) => I1 ==Int I2
+  rule listVal(.Ints) ~> cmpRight("==", listVal(.Ints)) => true
+  rule listVal(I IS)  ~> cmpRight("==", listVal(.Ints)) => false
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..e6460814631abee8dd603e48c2c24fcac60d95db
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,16 @@
+def prod_signs(arr):
+    if arr == []:
+        return None
+
+    total = 0
+    sign = 1
+    for x in arr:
+        if x < 0:
+            total = total - x
+            sign = -sign
+        else:
+            total = total + x
+            if x == 0:
+                sign = 0
+
+    return total * sign

exec
/bin/bash -lc 'kompile semantic.k --main-module SEMANTIC --syntax-module MPY-SYNTAX --backend llvm' in /work
