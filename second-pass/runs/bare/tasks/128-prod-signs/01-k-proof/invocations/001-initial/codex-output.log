+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule <k> bind(X, V) => .K ...</k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule If(E, THEN, ELSE) => eval(E) ~> branch(THEN, ELSE)
