+  rule <k> V:Value ~> store(X) => .K ...</k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule <k> bind(X, V) => .K ...</k>
+       <env> RHO => RHO [ X <- V ] </env>
+
