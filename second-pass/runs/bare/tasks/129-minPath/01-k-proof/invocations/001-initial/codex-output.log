+  rule <k> Assign(Name(X), E) => E ~> assignName(X) ... </k>
+  rule <k> V:Val ~> assignName(X) => . ... </k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule <k> Expr(E) => E ~> discard ... </k>
+  rule <k> _V:Val ~> discard => . ... </k>
+
+  rule <k> Return(E) => E ~> setResult ... </k>
+  rule <k> V:Val ~> setResult => . ... </k>
+       <result> none => some(V) </result>
+
+  rule <k> If(E, THEN, ELSE) => E ~> ifResult(THEN, ELSE) ... </k>
+  rule <k> vBool(true) ~> ifResult(THEN, _ELSE) => exec(THEN) ... </k>
+  rule <k> vBool(false) ~> ifResult(_THEN, ELSE) => exec(ELSE) ... </k>
+
+  rule <k> While(E, BODY) => E ~> whileResult(E, BODY) ... </k>
+  rule <k> vBool(true) ~> whileResult(E, BODY)
+         => exec(BODY) ~> While(E, BODY) ... </k>
+  rule <k> vBool(false) ~> whileResult(_E, _BODY) => . ... </k>
+
+  rule <k> Int(I) => vInt(I) ... </k>
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V ... </env>
+  rule <k> ListExpr(.Exprs) => vList(.List) ... </k>
+
+  rule <k> BinOp(OP, E1, E2) => E1 ~> binLeft(OP, E2) ... </k>
+  rule <k> V1:Val ~> binLeft(OP, E2) => E2 ~> binRight(OP, V1) ... </k>
+  rule <k> vInt(I2) ~> binRight("+", vInt(I1)) => vInt(I1 +Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("-", vInt(I1)) => vInt(I1 -Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("*", vInt(I1)) => vInt(I1 *Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("%", vInt(I1)) => vInt(I1 %Int I2) ... </k>
+
+  rule <k> Compare(E1, CmpOp(OP, E2)) => E1 ~> compareLeft(OP, E2) ... </k>
+  rule <k> V1:Val ~> compareLeft(OP, E2) => E2 ~> compareRight(OP, V1) ... </k>
+  rule <k> vInt(I2) ~> compareRight("<",  vInt(I1)) => vBool(I1 <Int  I2) ... </k>
+  rule <k> vInt(I2) ~> compareRight(">",  vInt(I1)) => vBool(I1 >Int  I2) ... </k>
+  rule <k> vInt(I2) ~> compareRight("==", vInt(I1)) => vBool(I1 ==Int I2) ... </k>
+
+  rule <k> Subscript(E1, E2) => E1 ~> subscriptLeft(E2) ... </k>
+  rule <k> V1:Val ~> subscriptLeft(E2) => E2 ~> subscriptRight(V1) ... </k>
+  rule <k> vInt(I) ~> subscriptRight(vList(L)) => getVal(L, I) ... </k>
+
+  rule <k> Call(Name("len"), E, .Exprs) => E ~> lengthOf ... </k>
+  rule <k> vList(L) ~> lengthOf => vInt(listLength(L)) ... </k>
+
+  rule <k> Call(Attribute(Name(X), "append"), E, .Exprs) => E ~> appendTo(X) ... </k>
+  rule <k> V:Val ~> appendTo(X) => vNone ... </k>
+       <env> ... X |-> vList(L => L ListItem(V)) ... </env>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4c0d5c3bb718c4691af6154b3d923f3c9aa55cad
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,37 @@
+def minPath(grid, k):
+    n = len(grid)
+    x = 0
+    y = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                x = i
+                y = j
+            j = j + 1
+        i = i + 1
+
+    best = n * n + 1
+    if x > 0:
+        if grid[x - 1][y] < best:
+            best = grid[x - 1][y]
+    if x + 1 < n:
+        if grid[x + 1][y] < best:
+            best = grid[x + 1][y]
+    if y > 0:
+        if grid[x][y - 1] < best:
+            best = grid[x][y - 1]
+    if y + 1 < n:
+        if grid[x][y + 1] < best:
+            best = grid[x][y + 1]
+
+    answer = []
+    i = 0
+    while i < k:
+        if i % 2 == 0:
+            answer.append(1)
+        else:
+            answer.append(best)
+        i = i + 1
+    return answer
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..bcece63d4dd3a5153b4ccf53ed51302e8e0484be
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,87 @@
+requires "semantic.k"
+
+module MINPATH-VERIFICATION
+  imports MPY
+
+  // This macro is the exact constructor term emitted in solution.mpy.  Keeping
+  // it as a Program term lets specifications share the program without adding
+  // any proof-only execution rule.
+  syntax Program ::= "solutionProgram"
+  rule solutionProgram =>
+    Module(
+      FuncDef("minPath", Params("grid", "k"),
+        Assign(Name("n"), Call(Name("len"), Name("grid")))
+        Assign(Name("x"), Int(0))
+        Assign(Name("y"), Int(0))
+        Assign(Name("i"), Int(0))
+        While(Compare(Name("i"), CmpOp("<", Name("n"))),
+          Assign(Name("j"), Int(0))
+          While(Compare(Name("j"), CmpOp("<", Name("n"))),
+            If(Compare(
+              Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+              CmpOp("==", Int(1))),
+              Assign(Name("x"), Name("i"))
+              Assign(Name("y"), Name("j")),
+              )
+            Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Assign(Name("best"),
+          BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+        If(Compare(Name("x"), CmpOp(">", Int(0))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), BinOp("-", Name("x"), Int(1))),
+              Name("y")),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), BinOp("-", Name("x"), Int(1))),
+                Name("y"))),
+            ),
+          )
+        If(Compare(BinOp("+", Name("x"), Int(1)), CmpOp("<", Name("n"))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), BinOp("+", Name("x"), Int(1))),
+              Name("y")),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), BinOp("+", Name("x"), Int(1))),
+                Name("y"))),
+            ),
+          )
+        If(Compare(Name("y"), CmpOp(">", Int(0))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), Name("x")),
+              BinOp("-", Name("y"), Int(1))),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), Name("x")),
+                BinOp("-", Name("y"), Int(1)))),
+            ),
+          )
+        If(Compare(BinOp("+", Name("y"), Int(1)), CmpOp("<", Name("n"))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), Name("x")),
+              BinOp("+", Name("y"), Int(1))),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), Name("x")),
+                BinOp("+", Name("y"), Int(1)))),
+            ),
+          )
+        Assign(Name("answer"), ListExpr())
+        Assign(Name("i"), Int(0))
+        While(Compare(Name("i"), CmpOp("<", Name("k"))),
+          If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+            Expr(Call(Attribute(Name("answer"), "append"), Int(1))),
+            Expr(Call(Attribute(Name("answer"), "append"), Name("best"))))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Return(Name("answer"))))
+    [macro]
+endmodule

apply patch
patch: completed
/work/verification.k
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..08f9057afa25fcd3ddb7e73315091013753480e6
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,140 @@
+requires "domains.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Stmts  ::= List{Stmt, ""}
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+  syntax Exprs  ::= List{Expr, ","}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Expr" "(" Expr ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," Cmp ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "ListExpr" "(" Exprs ")"
+  syntax Cmp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  syntax Val ::= "vInt" "(" Int ")"
+               | "vBool" "(" Bool ")"
+               | "vList" "(" List ")"
+               | "vNone"
+  syntax Expr ::= Val
+  syntax Fn ::= "fn" "(" Params "," Stmts ")"
+  syntax Result ::= "none" | "some" "(" Val ")"
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "start" "(" Val "," Int ")"
+                 | "assignName" "(" String ")"
+                 | "discard"
+                 | "binLeft" "(" String "," Expr ")"
+                 | "binRight" "(" String "," Val ")"
+                 | "compareLeft" "(" String "," Expr ")"
+                 | "compareRight" "(" String "," Val ")"
+                 | "subscriptLeft" "(" Expr ")"
+                 | "subscriptRight" "(" Val ")"
+                 | "lengthOf"
+                 | "appendTo" "(" String ")"
+                 | "ifResult" "(" Stmts "," Stmts ")"
+                 | "whileResult" "(" Expr "," Stmts ")"
+                 | "setResult"
+
+  syntax Int ::= listLength(List) [function]
+  rule listLength(.List) => 0
+  rule listLength(ListItem(_) REST) => 1 +Int listLength(REST)
+
+  syntax Val ::= getVal(List, Int) [function]
+  rule getVal(ListItem(V:Val) _REST, 0) => V
+  rule getVal(ListItem(_V:Val) REST, I) => getVal(REST, I -Int 1)
+    requires I >Int 0
+
+  configuration
+    <py>
+      <k> $PGM:Program ~> start($GRID:Val, $KLEN:Int) </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> none </result>
+    </py>
+
+  rule <k> Module(SS) => exec(SS) ... </k>
+  rule <k> exec(.Stmts) => . ... </k>
+  rule <k> exec(S SS) => S ~> exec(SS) ... </k>
+
+  rule <k> FuncDef(F, PS, BODY) => . ... </k>
+       <functions> FS => FS [ F <- fn(PS, BODY) ] </functions>
+
+  rule <k> start(GRID, KLEN) => exec(BODY) ... </k>
+       <functions> ... "minPath" |-> fn(Params("grid", "k"), BODY) ... </functions>
+       <env> _ => "grid" |-> GRID "k" |-> vInt(KLEN) </env>
+
+  rule <k> Assign(Name(X), E) => E ~> assignName(X) ... </k>
+  rule <k> V:Val ~> assignName(X) => . ... </k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule <k> Expr(E) => E ~> discard ... </k>
+  rule <k> _V:Val ~> discard => . ... </k>
+
+  rule <k> Return(E) => E ~> setResult ... </k>
+  rule <k> V:Val ~> setResult => . ... </k>
+       <result> none => some(V) </result>
+
+  rule <k> If(E, THEN, ELSE) => E ~> ifResult(THEN, ELSE) ... </k>
+  rule <k> vBool(true) ~> ifResult(THEN, _ELSE) => exec(THEN) ... </k>
+  rule <k> vBool(false) ~> ifResult(_THEN, ELSE) => exec(ELSE) ... </k>
+
+  rule <k> While(E, BODY) => E ~> whileResult(E, BODY) ... </k>
+  rule <k> vBool(true) ~> whileResult(E, BODY)
+         => exec(BODY) ~> While(E, BODY) ... </k>
+  rule <k> vBool(false) ~> whileResult(_E, _BODY) => . ... </k>
+
+  rule <k> Int(I) => vInt(I) ... </k>
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V ... </env>
+  rule <k> ListExpr(.Exprs) => vList(.List) ... </k>
+
+  rule <k> BinOp(OP, E1, E2) => E1 ~> binLeft(OP, E2) ... </k>
+  rule <k> V1:Val ~> binLeft(OP, E2) => E2 ~> binRight(OP, V1) ... </k>
+  rule <k> vInt(I2) ~> binRight("+", vInt(I1)) => vInt(I1 +Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("-", vInt(I1)) => vInt(I1 -Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("*", vInt(I1)) => vInt(I1 *Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("%", vInt(I1)) => vInt(I1 %Int I2) ... </k>
+
+  rule <k> Compare(E1, CmpOp(OP, E2)) => E1 ~> compareLeft(OP, E2) ... </k>
+  rule <k> V1:Val ~> compareLeft(OP, E2) => E2 ~> compareRight(OP, V1) ... </k>
+  rule <k> vInt(I2) ~> compareRight("<",  vInt(I1)) => vBool(I1 <Int  I2) ... </k>
+  rule <k> vInt(I2) ~> compareRight(">",  vInt(I1)) => vBool(I1 >Int  I2) ... </k>
+  rule <k> vInt(I2) ~> compareRight("==", vInt(I1)) => vBool(I1 ==Int I2) ... </k>
+
+  rule <k> Subscript(E1, E2) => E1 ~> subscriptLeft(E2) ... </k>
+  rule <k> V1:Val ~> subscriptLeft(E2) => E2 ~> subscriptRight(V1) ... </k>
+  rule <k> vInt(I) ~> subscriptRight(vList(L)) => getVal(L, I) ... </k>
+
+  rule <k> Call(Name("len"), E, .Exprs) => E ~> lengthOf ... </k>
+  rule <k> vList(L) ~> lengthOf => vInt(listLength(L)) ... </k>
+
+  rule <k> Call(Attribute(Name(X), "append"), E, .Exprs) => E ~> appendTo(X) ... </k>
+  rule <k> V:Val ~> appendTo(X) => vNone ... </k>
+       <env> ... X |-> vList(L => L ListItem(V)) ... </env>
+endmodule
