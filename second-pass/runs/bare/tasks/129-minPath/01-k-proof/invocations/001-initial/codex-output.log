diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ba1b91a10c05c98a84e55c4b453f68cb8c3da901
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,83 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+proof_tmpdir="$(mktemp -d /work/minpath-proof.XXXXXXXX)"
+trap 'rm -rf "$proof_tmpdir"' EXIT
+
+# Recreate the submitted constructor program with the fixed translator.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Independent executable check against exhaustive path enumeration: every 2x2
+# permutation for k=1..7, followed by deterministic 3x3 samples.
+python3 - <<'PY'
+from itertools import permutations
+from random import Random
+from solution import minPath
+
+
+def brute(grid, k):
+    n = len(grid)
+    states = [([grid[r][c]], r, c) for r in range(n) for c in range(n)]
+    for _ in range(k - 1):
+        following = []
+        for values, r, c in states:
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < n and 0 <= nc < n:
+                    following.append((values + [grid[nr][nc]], nr, nc))
+        states = following
+    return min(values for values, _, _ in states)
+
+
+for cells in permutations(range(1, 5)):
+    grid = [list(cells[:2]), list(cells[2:])]
+    for k in range(1, 8):
+        assert minPath(grid, k) == brute(grid, k)
+
+rng = Random(129)
+for _ in range(120):
+    cells = list(range(1, 10))
+    rng.shuffle(cells)
+    grid = [cells[0:3], cells[3:6], cells[6:9]]
+    k = rng.randrange(1, 7)
+    assert minPath(grid, k) == brute(grid, k)
+PY
+
+# Build the executable semantics and exercise both examples from prompt.py.
+kompile semantic.k --main-module MPY --syntax-module MPY-SYNTAX --backend llvm
+
+grid_example_1='vList(ListItem(vList(ListItem(vInt(1)) ListItem(vInt(2)) ListItem(vInt(3)))) ListItem(vList(ListItem(vInt(4)) ListItem(vInt(5)) ListItem(vInt(6)))) ListItem(vList(ListItem(vInt(7)) ListItem(vInt(8)) ListItem(vInt(9)))))'
+grid_example_2='vList(ListItem(vList(ListItem(vInt(5)) ListItem(vInt(9)) ListItem(vInt(3)))) ListItem(vList(ListItem(vInt(4)) ListItem(vInt(1)) ListItem(vInt(6)))) ListItem(vList(ListItem(vInt(7)) ListItem(vInt(8)) ListItem(vInt(2)))))'
+
+krun solution.mpy --definition semantic-kompiled \
+  -cGRID="$grid_example_1" -cKLEN=3 --output pretty \
+  > "$proof_tmpdir/krun-example-1.out"
+krun solution.mpy --definition semantic-kompiled \
+  -cGRID="$grid_example_2" -cKLEN=1 --output pretty \
+  > "$proof_tmpdir/krun-example-2.out"
+rg -q 'some' "$proof_tmpdir/krun-example-1.out"
+rg -q 'some' "$proof_tmpdir/krun-example-2.out"
+
+# The Haskell backend symbolically proves every reachability claim in spec.k.
+kompile verification.k \
+  --main-module MINPATH-VERIFICATION \
+  --syntax-module MINPATH-VERIFICATION \
+  --backend haskell
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module MINPATH-SPEC \
+  | tee "$proof_tmpdir/kprove.out"
+rg -qx '#Top' "$proof_tmpdir/kprove.out"
+
+# Non-vacuity probe: changing the first expected path must make proof fail.
+sed '0,/path3(2)/s//path3(3)/' spec.k > "$proof_tmpdir/spec-mutated.k"
+if kprove "$proof_tmpdir/spec-mutated.k" \
+     -I /work \
+     --definition verification-kompiled \
+     --spec-module MINPATH-SPEC \
+     > "$proof_tmpdir/mutation.out" 2>&1; then
+  echo 'ERROR: mutated specification unexpectedly proved' >&2
+  exit 1
+fi
+echo 'mutation probe failed as expected'
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..12bff6c214073943d697c8b17d689ade492d3dda
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,140 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Stmts  ::= List{Stmt, ""}
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+  syntax Exprs  ::= List{Expr, ","}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Expr" "(" Expr ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," Cmp ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "ListExpr" "(" Exprs ")"
+  syntax Cmp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  syntax Val ::= "vInt" "(" Int ")"
+               | "vBool" "(" Bool ")"
+               | "vList" "(" List ")"
+               | "vNone"
+  syntax Expr ::= Val
+  syntax Fn ::= "fn" "(" Params "," Stmts ")"
+  syntax Result ::= "none" | "some" "(" Val ")"
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "start" "(" Val "," Int ")"
+                 | "assignName" "(" String ")"
+                 | "discard"
+                 | "binLeft" "(" String "," Expr ")"
+                 | "binRight" "(" String "," Val ")"
+                 | "compareLeft" "(" String "," Expr ")"
+                 | "compareRight" "(" String "," Val ")"
+                 | "subscriptLeft" "(" Expr ")"
+                 | "subscriptRight" "(" Val ")"
+                 | "lengthOf"
+                 | "appendTo" "(" String ")"
+                 | "ifResult" "(" Stmts "," Stmts ")"
+                 | "whileResult" "(" Expr "," Stmts ")"
+                 | "setResult"
+
+  syntax Int ::= listLength(List) [function]
+  rule listLength(.List) => 0
+  rule listLength(ListItem(_) REST) => 1 +Int listLength(REST)
+
+  syntax Val ::= getVal(List, Int) [function]
+  rule getVal(ListItem(V:Val) _REST, 0) => V
+  rule getVal(ListItem(_V:Val) REST, I) => getVal(REST, I -Int 1)
+    requires I >Int 0
+
+  configuration
+    <py>
+      <k> $PGM:Program ~> start($GRID:Val, $KLEN:Int) </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> none </result>
+    </py>
+
+  rule <k> Module(SS) => exec(SS) ... </k>
+  rule <k> exec(.Stmts) => . ... </k>
+  rule <k> exec(S SS) => S ~> exec(SS) ... </k>
+
+  rule <k> FuncDef(F, PS, BODY) => . ... </k>
+       <functions> FS => FS [ F <- fn(PS, BODY) ] </functions>
+
+  rule <k> start(GRID, KLEN) => exec(BODY) ... </k>
+       <functions> ... "minPath" |-> fn(Params("grid", "k"), BODY) ... </functions>
+       <env> _ => "grid" |-> GRID "k" |-> vInt(KLEN) </env>
+
+  rule <k> Assign(Name(X), E) => E ~> assignName(X) ... </k>
+  rule <k> V:Val ~> assignName(X) => . ... </k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule <k> Expr(E) => E ~> discard ... </k>
+  rule <k> _V:Val ~> discard => . ... </k>
+
+  rule <k> Return(E) => E ~> setResult ... </k>
+  rule <k> V:Val ~> setResult => . ... </k>
+       <result> none => some(V) </result>
+
+  rule <k> If(E, THEN, ELSE) => E ~> ifResult(THEN, ELSE) ... </k>
+  rule <k> vBool(true) ~> ifResult(THEN, _ELSE) => exec(THEN) ... </k>
+  rule <k> vBool(false) ~> ifResult(_THEN, ELSE) => exec(ELSE) ... </k>
+
+  rule <k> While(E, BODY) => E ~> whileResult(E, BODY) ... </k>
+  rule <k> vBool(true) ~> whileResult(E, BODY)
+         => exec(BODY) ~> While(E, BODY) ... </k>
+  rule <k> vBool(false) ~> whileResult(_E, _BODY) => . ... </k>
+
+  rule <k> Int(I) => vInt(I) ... </k>
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V ... </env>
+  rule <k> ListExpr(.Exprs) => vList(.List) ... </k>
+
+  rule <k> BinOp(OP, E1, E2) => E1 ~> binLeft(OP, E2) ... </k>
+  rule <k> V1:Val ~> binLeft(OP, E2) => E2 ~> binRight(OP, V1) ... </k>
+  rule <k> vInt(I2) ~> binRight("+", vInt(I1)) => vInt(I1 +Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("-", vInt(I1)) => vInt(I1 -Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("*", vInt(I1)) => vInt(I1 *Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("%", vInt(I1)) => vInt(I1 %Int I2) ... </k>
+
+  rule <k> Compare(E1, CmpOp(OP, E2)) => E1 ~> compareLeft(OP, E2) ... </k>
+  rule <k> V1:Val ~> compareLeft(OP, E2) => E2 ~> compareRight(OP, V1) ... </k>
+  rule <k> vInt(I2) ~> compareRight("<",  vInt(I1)) => vBool(I1 <Int  I2) ... </k>
+  rule <k> vInt(I2) ~> compareRight(">",  vInt(I1)) => vBool(I1 >Int  I2) ... </k>
+  rule <k> vInt(I2) ~> compareRight("==", vInt(I1)) => vBool(I1 ==Int I2) ... </k>
+
+  rule <k> Subscript(E1, E2) => E1 ~> subscriptLeft(E2) ... </k>
+  rule <k> V1:Val ~> subscriptLeft(E2) => E2 ~> subscriptRight(V1) ... </k>
+  rule <k> vInt(I) ~> subscriptRight(vList(L)) => getVal(L, I) ... </k>
+
+  rule <k> Call(Name("len"), E, .Exprs) => E ~> lengthOf ... </k>
+  rule <k> vList(L) ~> lengthOf => vInt(listLength(L)) ... </k>
+
+  rule <k> Call(Attribute(Name(X), "append"), E, .Exprs) => E ~> appendTo(X) ... </k>
+  rule <k> V:Val ~> appendTo(X) => vNone ... </k>
+       <env> ... X |-> vList(L => L ListItem(V)) ... </env>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4c0d5c3bb718c4691af6154b3d923f3c9aa55cad
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,37 @@
+def minPath(grid, k):
+    n = len(grid)
+    x = 0
+    y = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                x = i
+                y = j
+            j = j + 1
+        i = i + 1
+
+    best = n * n + 1
+    if x > 0:
+        if grid[x - 1][y] < best:
+            best = grid[x - 1][y]
+    if x + 1 < n:
+        if grid[x + 1][y] < best:
+            best = grid[x + 1][y]
+    if y > 0:
+        if grid[x][y - 1] < best:
+            best = grid[x][y - 1]
+    if y + 1 < n:
+        if grid[x][y + 1] < best:
+            best = grid[x][y + 1]
+
+    answer = []
+    i = 0
+    while i < k:
+        if i % 2 == 0:
+            answer.append(1)
+        else:
+            answer.append(best)
+        i = i + 1
+    return answer
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1d27d1931be0d47065acd1107f4e7d8a38e80fed
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,79 @@
+requires "verification.k"
+
+module MINPATH-SPEC
+  imports MINPATH-VERIFICATION
+
+  // The two examples from prompt.py.
+  claim
+    <k> solutionProgram ~> start(grid3(1, 2, 3, 4, 5, 6, 7, 8, 9), 3)
+      => .K </k>
+    <result> none => some(path3(2)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+
+  claim
+    <k> solutionProgram ~> start(grid3(5, 9, 3, 4, 1, 6, 7, 8, 2), 1)
+      => .K </k>
+    <result> none => some(path1(1)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+
+  // Symbolic 2x2 coverage.  The range, disequality, and ordering constraints
+  // make A/B/C a permutation of 2,3,4.  For every location of 1, the two
+  // claims cover both possible orders of its two neighbors.
+  claim
+    <k> solutionProgram ~> start(grid2(1, A, B, C), 5) => .K </k>
+    <result> none => some(path5(A)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool A <Int B
+
+  claim
+    <k> solutionProgram ~> start(grid2(1, A, B, C), 5) => .K </k>
+    <result> none => some(path5(B)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool B <Int A
+
+  claim
+    <k> solutionProgram ~> start(grid2(A, 1, C, B), 5) => .K </k>
+    <result> none => some(path5(A)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool A <Int B
+
+  claim
+    <k> solutionProgram ~> start(grid2(A, 1, C, B), 5) => .K </k>
+    <result> none => some(path5(B)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool B <Int A
+
+  claim
+    <k> solutionProgram ~> start(grid2(A, C, 1, B), 5) => .K </k>
+    <result> none => some(path5(A)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool A <Int B
+
+  claim
+    <k> solutionProgram ~> start(grid2(A, C, 1, B), 5) => .K </k>
+    <result> none => some(path5(B)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool B <Int A
+
+  claim
+    <k> solutionProgram ~> start(grid2(C, A, B, 1), 5) => .K </k>
+    <result> none => some(path5(A)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool A <Int B
+
+  claim
+    <k> solutionProgram ~> start(grid2(C, A, B, 1), 5) => .K </k>
+    <result> none => some(path5(B)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool B <Int A
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8ce7c1462f013d47d54a7926fe2401f9f194a5de
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,119 @@
+requires "semantic.k"
+
+module MINPATH-VERIFICATION
+  imports MPY
+
+  // Compact value constructors used only to state readable claims.  They
+  // expand to the same vList/ListItem representation consumed by MPY.
+  syntax Val ::= "grid2" "(" Int "," Int "," Int "," Int ")" [function]
+               | "grid3" "(" Int "," Int "," Int "," Int "," Int ","
+                            Int "," Int "," Int "," Int ")" [function]
+               | "path1" "(" Int ")" [function]
+               | "path3" "(" Int ")" [function]
+               | "path5" "(" Int ")" [function]
+
+  rule grid2(A, B, C, D) =>
+    vList(ListItem(vList(ListItem(vInt(A)) ListItem(vInt(B))))
+          ListItem(vList(ListItem(vInt(C)) ListItem(vInt(D)))))
+
+  rule grid3(A, B, C, D, E, F, G, H, I) =>
+    vList(ListItem(vList(ListItem(vInt(A)) ListItem(vInt(B)) ListItem(vInt(C))))
+          ListItem(vList(ListItem(vInt(D)) ListItem(vInt(E)) ListItem(vInt(F))))
+          ListItem(vList(ListItem(vInt(G)) ListItem(vInt(H)) ListItem(vInt(I)))))
+
+  rule path1(_M) => vList(ListItem(vInt(1)))
+  rule path3(M) =>
+    vList(ListItem(vInt(1)) ListItem(vInt(M)) ListItem(vInt(1)))
+  rule path5(M) =>
+    vList(ListItem(vInt(1)) ListItem(vInt(M)) ListItem(vInt(1))
+          ListItem(vInt(M)) ListItem(vInt(1)))
+
+  syntax Bool ::= "validTail" "(" Int "," Int "," Int ")" [function]
+  rule validTail(A, B, C) =>
+    A >=Int 2 andBool A <=Int 4 andBool
+    B >=Int 2 andBool B <=Int 4 andBool
+    C >=Int 2 andBool C <=Int 4 andBool
+    A =/=Int B andBool A =/=Int C andBool B =/=Int C
+
+  // This constant expands to the exact constructor term emitted in
+  // solution.mpy. Keeping
+  // it as a Program term lets specifications share the program without adding
+  // any proof-only execution rule.
+  syntax Program ::= "solutionProgram"
+  rule solutionProgram =>
+    Module(
+      FuncDef("minPath", Params("grid", "k"),
+        Assign(Name("n"), Call(Name("len"), Name("grid")))
+        Assign(Name("x"), Int(0))
+        Assign(Name("y"), Int(0))
+        Assign(Name("i"), Int(0))
+        While(Compare(Name("i"), CmpOp("<", Name("n"))),
+          Assign(Name("j"), Int(0))
+          While(Compare(Name("j"), CmpOp("<", Name("n"))),
+            If(Compare(
+              Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+              CmpOp("==", Int(1))),
+              Assign(Name("x"), Name("i"))
+              Assign(Name("y"), Name("j")),
+              .Stmts)
+            Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Assign(Name("best"),
+          BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+        If(Compare(Name("x"), CmpOp(">", Int(0))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), BinOp("-", Name("x"), Int(1))),
+              Name("y")),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), BinOp("-", Name("x"), Int(1))),
+                Name("y"))),
+            .Stmts),
+          .Stmts)
+        If(Compare(BinOp("+", Name("x"), Int(1)), CmpOp("<", Name("n"))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), BinOp("+", Name("x"), Int(1))),
+              Name("y")),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), BinOp("+", Name("x"), Int(1))),
+                Name("y"))),
+            .Stmts),
+          .Stmts)
+        If(Compare(Name("y"), CmpOp(">", Int(0))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), Name("x")),
+              BinOp("-", Name("y"), Int(1))),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), Name("x")),
+                BinOp("-", Name("y"), Int(1)))),
+            .Stmts),
+          .Stmts)
+        If(Compare(BinOp("+", Name("y"), Int(1)), CmpOp("<", Name("n"))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), Name("x")),
+              BinOp("+", Name("y"), Int(1))),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), Name("x")),
+                BinOp("+", Name("y"), Int(1)))),
+            .Stmts),
+          .Stmts)
+        Assign(Name("answer"), ListExpr(.Exprs))
+        Assign(Name("i"), Int(0))
+        While(Compare(Name("i"), CmpOp("<", Name("k"))),
+          If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+            Expr(Call(Attribute(Name("answer"), "append"), Int(1))),
+            Expr(Call(Attribute(Name("answer"), "append"), Name("best"))))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Return(Name("answer"))))
+endmodule

exec
/bin/bash -lc ./prove.sh in /work
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ba1b91a10c05c98a84e55c4b453f68cb8c3da901
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,83 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+proof_tmpdir="$(mktemp -d /work/minpath-proof.XXXXXXXX)"
+trap 'rm -rf "$proof_tmpdir"' EXIT
+
+# Recreate the submitted constructor program with the fixed translator.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Independent executable check against exhaustive path enumeration: every 2x2
+# permutation for k=1..7, followed by deterministic 3x3 samples.
+python3 - <<'PY'
+from itertools import permutations
+from random import Random
+from solution import minPath
+
+
+def brute(grid, k):
+    n = len(grid)
+    states = [([grid[r][c]], r, c) for r in range(n) for c in range(n)]
+    for _ in range(k - 1):
+        following = []
+        for values, r, c in states:
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < n and 0 <= nc < n:
+                    following.append((values + [grid[nr][nc]], nr, nc))
+        states = following
+    return min(values for values, _, _ in states)
+
+
+for cells in permutations(range(1, 5)):
+    grid = [list(cells[:2]), list(cells[2:])]
+    for k in range(1, 8):
+        assert minPath(grid, k) == brute(grid, k)
+
+rng = Random(129)
+for _ in range(120):
+    cells = list(range(1, 10))
+    rng.shuffle(cells)
+    grid = [cells[0:3], cells[3:6], cells[6:9]]
+    k = rng.randrange(1, 7)
+    assert minPath(grid, k) == brute(grid, k)
+PY
+
+# Build the executable semantics and exercise both examples from prompt.py.
+kompile semantic.k --main-module MPY --syntax-module MPY-SYNTAX --backend llvm
+
+grid_example_1='vList(ListItem(vList(ListItem(vInt(1)) ListItem(vInt(2)) ListItem(vInt(3)))) ListItem(vList(ListItem(vInt(4)) ListItem(vInt(5)) ListItem(vInt(6)))) ListItem(vList(ListItem(vInt(7)) ListItem(vInt(8)) ListItem(vInt(9)))))'
+grid_example_2='vList(ListItem(vList(ListItem(vInt(5)) ListItem(vInt(9)) ListItem(vInt(3)))) ListItem(vList(ListItem(vInt(4)) ListItem(vInt(1)) ListItem(vInt(6)))) ListItem(vList(ListItem(vInt(7)) ListItem(vInt(8)) ListItem(vInt(2)))))'
+
+krun solution.mpy --definition semantic-kompiled \
+  -cGRID="$grid_example_1" -cKLEN=3 --output pretty \
+  > "$proof_tmpdir/krun-example-1.out"
+krun solution.mpy --definition semantic-kompiled \
+  -cGRID="$grid_example_2" -cKLEN=1 --output pretty \
+  > "$proof_tmpdir/krun-example-2.out"
+rg -q 'some' "$proof_tmpdir/krun-example-1.out"
+rg -q 'some' "$proof_tmpdir/krun-example-2.out"
+
+# The Haskell backend symbolically proves every reachability claim in spec.k.
+kompile verification.k \
+  --main-module MINPATH-VERIFICATION \
+  --syntax-module MINPATH-VERIFICATION \
+  --backend haskell
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module MINPATH-SPEC \
+  | tee "$proof_tmpdir/kprove.out"
+rg -qx '#Top' "$proof_tmpdir/kprove.out"
+
+# Non-vacuity probe: changing the first expected path must make proof fail.
+sed '0,/path3(2)/s//path3(3)/' spec.k > "$proof_tmpdir/spec-mutated.k"
+if kprove "$proof_tmpdir/spec-mutated.k" \
+     -I /work \
+     --definition verification-kompiled \
+     --spec-module MINPATH-SPEC \
+     > "$proof_tmpdir/mutation.out" 2>&1; then
+  echo 'ERROR: mutated specification unexpectedly proved' >&2
+  exit 1
+fi
+echo 'mutation probe failed as expected'
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..12bff6c214073943d697c8b17d689ade492d3dda
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,140 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Stmts  ::= List{Stmt, ""}
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+  syntax Exprs  ::= List{Expr, ","}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Expr" "(" Expr ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," Cmp ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "ListExpr" "(" Exprs ")"
+  syntax Cmp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  syntax Val ::= "vInt" "(" Int ")"
+               | "vBool" "(" Bool ")"
+               | "vList" "(" List ")"
+               | "vNone"
+  syntax Expr ::= Val
+  syntax Fn ::= "fn" "(" Params "," Stmts ")"
+  syntax Result ::= "none" | "some" "(" Val ")"
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "start" "(" Val "," Int ")"
+                 | "assignName" "(" String ")"
+                 | "discard"
+                 | "binLeft" "(" String "," Expr ")"
+                 | "binRight" "(" String "," Val ")"
+                 | "compareLeft" "(" String "," Expr ")"
+                 | "compareRight" "(" String "," Val ")"
+                 | "subscriptLeft" "(" Expr ")"
+                 | "subscriptRight" "(" Val ")"
+                 | "lengthOf"
+                 | "appendTo" "(" String ")"
+                 | "ifResult" "(" Stmts "," Stmts ")"
+                 | "whileResult" "(" Expr "," Stmts ")"
+                 | "setResult"
+
+  syntax Int ::= listLength(List) [function]
+  rule listLength(.List) => 0
+  rule listLength(ListItem(_) REST) => 1 +Int listLength(REST)
+
+  syntax Val ::= getVal(List, Int) [function]
+  rule getVal(ListItem(V:Val) _REST, 0) => V
+  rule getVal(ListItem(_V:Val) REST, I) => getVal(REST, I -Int 1)
+    requires I >Int 0
+
+  configuration
+    <py>
+      <k> $PGM:Program ~> start($GRID:Val, $KLEN:Int) </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> none </result>
+    </py>
+
+  rule <k> Module(SS) => exec(SS) ... </k>
+  rule <k> exec(.Stmts) => . ... </k>
+  rule <k> exec(S SS) => S ~> exec(SS) ... </k>
+
+  rule <k> FuncDef(F, PS, BODY) => . ... </k>
+       <functions> FS => FS [ F <- fn(PS, BODY) ] </functions>
+
+  rule <k> start(GRID, KLEN) => exec(BODY) ... </k>
+       <functions> ... "minPath" |-> fn(Params("grid", "k"), BODY) ... </functions>
+       <env> _ => "grid" |-> GRID "k" |-> vInt(KLEN) </env>
+
+  rule <k> Assign(Name(X), E) => E ~> assignName(X) ... </k>
+  rule <k> V:Val ~> assignName(X) => . ... </k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule <k> Expr(E) => E ~> discard ... </k>
+  rule <k> _V:Val ~> discard => . ... </k>
+
+  rule <k> Return(E) => E ~> setResult ... </k>
+  rule <k> V:Val ~> setResult => . ... </k>
+       <result> none => some(V) </result>
+
+  rule <k> If(E, THEN, ELSE) => E ~> ifResult(THEN, ELSE) ... </k>
+  rule <k> vBool(true) ~> ifResult(THEN, _ELSE) => exec(THEN) ... </k>
+  rule <k> vBool(false) ~> ifResult(_THEN, ELSE) => exec(ELSE) ... </k>
+
+  rule <k> While(E, BODY) => E ~> whileResult(E, BODY) ... </k>
+  rule <k> vBool(true) ~> whileResult(E, BODY)
+         => exec(BODY) ~> While(E, BODY) ... </k>
+  rule <k> vBool(false) ~> whileResult(_E, _BODY) => . ... </k>
+
+  rule <k> Int(I) => vInt(I) ... </k>
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V ... </env>
+  rule <k> ListExpr(.Exprs) => vList(.List) ... </k>
+
+  rule <k> BinOp(OP, E1, E2) => E1 ~> binLeft(OP, E2) ... </k>
+  rule <k> V1:Val ~> binLeft(OP, E2) => E2 ~> binRight(OP, V1) ... </k>
+  rule <k> vInt(I2) ~> binRight("+", vInt(I1)) => vInt(I1 +Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("-", vInt(I1)) => vInt(I1 -Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("*", vInt(I1)) => vInt(I1 *Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("%", vInt(I1)) => vInt(I1 %Int I2) ... </k>
+
+  rule <k> Compare(E1, CmpOp(OP, E2)) => E1 ~> compareLeft(OP, E2) ... </k>
+  rule <k> V1:Val ~> compareLeft(OP, E2) => E2 ~> compareRight(OP, V1) ... </k>
+  rule <k> vInt(I2) ~> compareRight("<",  vInt(I1)) => vBool(I1 <Int  I2) ... </k>
+  rule <k> vInt(I2) ~> compareRight(">",  vInt(I1)) => vBool(I1 >Int  I2) ... </k>
+  rule <k> vInt(I2) ~> compareRight("==", vInt(I1)) => vBool(I1 ==Int I2) ... </k>
+
+  rule <k> Subscript(E1, E2) => E1 ~> subscriptLeft(E2) ... </k>
+  rule <k> V1:Val ~> subscriptLeft(E2) => E2 ~> subscriptRight(V1) ... </k>
+  rule <k> vInt(I) ~> subscriptRight(vList(L)) => getVal(L, I) ... </k>
+
+  rule <k> Call(Name("len"), E, .Exprs) => E ~> lengthOf ... </k>
+  rule <k> vList(L) ~> lengthOf => vInt(listLength(L)) ... </k>
+
+  rule <k> Call(Attribute(Name(X), "append"), E, .Exprs) => E ~> appendTo(X) ... </k>
+  rule <k> V:Val ~> appendTo(X) => vNone ... </k>
+       <env> ... X |-> vList(L => L ListItem(V)) ... </env>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4c0d5c3bb718c4691af6154b3d923f3c9aa55cad
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,37 @@
+def minPath(grid, k):
+    n = len(grid)
+    x = 0
+    y = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                x = i
+                y = j
+            j = j + 1
+        i = i + 1
+
+    best = n * n + 1
+    if x > 0:
+        if grid[x - 1][y] < best:
+            best = grid[x - 1][y]
+    if x + 1 < n:
+        if grid[x + 1][y] < best:
+            best = grid[x + 1][y]
+    if y > 0:
+        if grid[x][y - 1] < best:
+            best = grid[x][y - 1]
+    if y + 1 < n:
+        if grid[x][y + 1] < best:
+            best = grid[x][y + 1]
+
+    answer = []
+    i = 0
+    while i < k:
+        if i % 2 == 0:
+            answer.append(1)
+        else:
+            answer.append(best)
+        i = i + 1
+    return answer
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1d27d1931be0d47065acd1107f4e7d8a38e80fed
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,79 @@
+requires "verification.k"
+
+module MINPATH-SPEC
+  imports MINPATH-VERIFICATION
+
+  // The two examples from prompt.py.
+  claim
+    <k> solutionProgram ~> start(grid3(1, 2, 3, 4, 5, 6, 7, 8, 9), 3)
+      => .K </k>
+    <result> none => some(path3(2)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+
+  claim
+    <k> solutionProgram ~> start(grid3(5, 9, 3, 4, 1, 6, 7, 8, 2), 1)
+      => .K </k>
+    <result> none => some(path1(1)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+
+  // Symbolic 2x2 coverage.  The range, disequality, and ordering constraints
+  // make A/B/C a permutation of 2,3,4.  For every location of 1, the two
+  // claims cover both possible orders of its two neighbors.
+  claim
+    <k> solutionProgram ~> start(grid2(1, A, B, C), 5) => .K </k>
+    <result> none => some(path5(A)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool A <Int B
+
+  claim
+    <k> solutionProgram ~> start(grid2(1, A, B, C), 5) => .K </k>
+    <result> none => some(path5(B)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool B <Int A
+
+  claim
+    <k> solutionProgram ~> start(grid2(A, 1, C, B), 5) => .K </k>
+    <result> none => some(path5(A)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool A <Int B
+
+  claim
+    <k> solutionProgram ~> start(grid2(A, 1, C, B), 5) => .K </k>
+    <result> none => some(path5(B)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool B <Int A
+
+  claim
+    <k> solutionProgram ~> start(grid2(A, C, 1, B), 5) => .K </k>
+    <result> none => some(path5(A)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool A <Int B
+
+  claim
+    <k> solutionProgram ~> start(grid2(A, C, 1, B), 5) => .K </k>
+    <result> none => some(path5(B)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool B <Int A
+
+  claim
+    <k> solutionProgram ~> start(grid2(C, A, B, 1), 5) => .K </k>
+    <result> none => some(path5(A)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool A <Int B
+
+  claim
+    <k> solutionProgram ~> start(grid2(C, A, B, 1), 5) => .K </k>
+    <result> none => some(path5(B)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool B <Int A
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8ce7c1462f013d47d54a7926fe2401f9f194a5de
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,119 @@
+requires "semantic.k"
+
+module MINPATH-VERIFICATION
+  imports MPY
+
+  // Compact value constructors used only to state readable claims.  They
+  // expand to the same vList/ListItem representation consumed by MPY.
+  syntax Val ::= "grid2" "(" Int "," Int "," Int "," Int ")" [function]
+               | "grid3" "(" Int "," Int "," Int "," Int "," Int ","
+                            Int "," Int "," Int "," Int ")" [function]
+               | "path1" "(" Int ")" [function]
+               | "path3" "(" Int ")" [function]
+               | "path5" "(" Int ")" [function]
+
+  rule grid2(A, B, C, D) =>
+    vList(ListItem(vList(ListItem(vInt(A)) ListItem(vInt(B))))
+          ListItem(vList(ListItem(vInt(C)) ListItem(vInt(D)))))
+
+  rule grid3(A, B, C, D, E, F, G, H, I) =>
+    vList(ListItem(vList(ListItem(vInt(A)) ListItem(vInt(B)) ListItem(vInt(C))))
+          ListItem(vList(ListItem(vInt(D)) ListItem(vInt(E)) ListItem(vInt(F))))
+          ListItem(vList(ListItem(vInt(G)) ListItem(vInt(H)) ListItem(vInt(I)))))
+
+  rule path1(_M) => vList(ListItem(vInt(1)))
+  rule path3(M) =>
+    vList(ListItem(vInt(1)) ListItem(vInt(M)) ListItem(vInt(1)))
+  rule path5(M) =>
+    vList(ListItem(vInt(1)) ListItem(vInt(M)) ListItem(vInt(1))
+          ListItem(vInt(M)) ListItem(vInt(1)))
+
+  syntax Bool ::= "validTail" "(" Int "," Int "," Int ")" [function]
+  rule validTail(A, B, C) =>
+    A >=Int 2 andBool A <=Int 4 andBool
+    B >=Int 2 andBool B <=Int 4 andBool
+    C >=Int 2 andBool C <=Int 4 andBool
+    A =/=Int B andBool A =/=Int C andBool B =/=Int C
+
+  // This constant expands to the exact constructor term emitted in
+  // solution.mpy. Keeping
+  // it as a Program term lets specifications share the program without adding
+  // any proof-only execution rule.
+  syntax Program ::= "solutionProgram"
+  rule solutionProgram =>
+    Module(
+      FuncDef("minPath", Params("grid", "k"),
+        Assign(Name("n"), Call(Name("len"), Name("grid")))
+        Assign(Name("x"), Int(0))
+        Assign(Name("y"), Int(0))
+        Assign(Name("i"), Int(0))
+        While(Compare(Name("i"), CmpOp("<", Name("n"))),
+          Assign(Name("j"), Int(0))
+          While(Compare(Name("j"), CmpOp("<", Name("n"))),
+            If(Compare(
+              Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+              CmpOp("==", Int(1))),
+              Assign(Name("x"), Name("i"))
+              Assign(Name("y"), Name("j")),
+              .Stmts)
+            Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Assign(Name("best"),
+          BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+        If(Compare(Name("x"), CmpOp(">", Int(0))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), BinOp("-", Name("x"), Int(1))),
+              Name("y")),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), BinOp("-", Name("x"), Int(1))),
+                Name("y"))),
+            .Stmts),
+          .Stmts)
+        If(Compare(BinOp("+", Name("x"), Int(1)), CmpOp("<", Name("n"))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), BinOp("+", Name("x"), Int(1))),
+              Name("y")),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), BinOp("+", Name("x"), Int(1))),
+                Name("y"))),
+            .Stmts),
+          .Stmts)
+        If(Compare(Name("y"), CmpOp(">", Int(0))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), Name("x")),
+              BinOp("-", Name("y"), Int(1))),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), Name("x")),
+                BinOp("-", Name("y"), Int(1)))),
+            .Stmts),
+          .Stmts)
+        If(Compare(BinOp("+", Name("y"), Int(1)), CmpOp("<", Name("n"))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), Name("x")),
+              BinOp("+", Name("y"), Int(1))),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), Name("x")),
+                BinOp("+", Name("y"), Int(1)))),
+            .Stmts),
+          .Stmts)
+        Assign(Name("answer"), ListExpr(.Exprs))
+        Assign(Name("i"), Int(0))
+        While(Compare(Name("i"), CmpOp("<", Name("k"))),
+          If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+            Expr(Call(Attribute(Name("answer"), "append"), Int(1))),
+            Expr(Call(Attribute(Name("answer"), "append"), Name("best"))))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Return(Name("answer"))))
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ba1b91a10c05c98a84e55c4b453f68cb8c3da901
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,83 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+proof_tmpdir="$(mktemp -d /work/minpath-proof.XXXXXXXX)"
+trap 'rm -rf "$proof_tmpdir"' EXIT
+
+# Recreate the submitted constructor program with the fixed translator.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Independent executable check against exhaustive path enumeration: every 2x2
+# permutation for k=1..7, followed by deterministic 3x3 samples.
+python3 - <<'PY'
+from itertools import permutations
+from random import Random
+from solution import minPath
+
+
+def brute(grid, k):
+    n = len(grid)
+    states = [([grid[r][c]], r, c) for r in range(n) for c in range(n)]
+    for _ in range(k - 1):
+        following = []
+        for values, r, c in states:
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < n and 0 <= nc < n:
+                    following.append((values + [grid[nr][nc]], nr, nc))
+        states = following
+    return min(values for values, _, _ in states)
+
+
+for cells in permutations(range(1, 5)):
+    grid = [list(cells[:2]), list(cells[2:])]
+    for k in range(1, 8):
+        assert minPath(grid, k) == brute(grid, k)
+
+rng = Random(129)
+for _ in range(120):
+    cells = list(range(1, 10))
+    rng.shuffle(cells)
+    grid = [cells[0:3], cells[3:6], cells[6:9]]
+    k = rng.randrange(1, 7)
+    assert minPath(grid, k) == brute(grid, k)
+PY
+
+# Build the executable semantics and exercise both examples from prompt.py.
+kompile semantic.k --main-module MPY --syntax-module MPY-SYNTAX --backend llvm
+
+grid_example_1='vList(ListItem(vList(ListItem(vInt(1)) ListItem(vInt(2)) ListItem(vInt(3)))) ListItem(vList(ListItem(vInt(4)) ListItem(vInt(5)) ListItem(vInt(6)))) ListItem(vList(ListItem(vInt(7)) ListItem(vInt(8)) ListItem(vInt(9)))))'
+grid_example_2='vList(ListItem(vList(ListItem(vInt(5)) ListItem(vInt(9)) ListItem(vInt(3)))) ListItem(vList(ListItem(vInt(4)) ListItem(vInt(1)) ListItem(vInt(6)))) ListItem(vList(ListItem(vInt(7)) ListItem(vInt(8)) ListItem(vInt(2)))))'
+
+krun solution.mpy --definition semantic-kompiled \
+  -cGRID="$grid_example_1" -cKLEN=3 --output pretty \
+  > "$proof_tmpdir/krun-example-1.out"
+krun solution.mpy --definition semantic-kompiled \
+  -cGRID="$grid_example_2" -cKLEN=1 --output pretty \
+  > "$proof_tmpdir/krun-example-2.out"
+rg -q 'some' "$proof_tmpdir/krun-example-1.out"
+rg -q 'some' "$proof_tmpdir/krun-example-2.out"
+
+# The Haskell backend symbolically proves every reachability claim in spec.k.
+kompile verification.k \
+  --main-module MINPATH-VERIFICATION \
+  --syntax-module MINPATH-VERIFICATION \
+  --backend haskell
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module MINPATH-SPEC \
+  | tee "$proof_tmpdir/kprove.out"
+rg -qx '#Top' "$proof_tmpdir/kprove.out"
+
+# Non-vacuity probe: changing the first expected path must make proof fail.
+sed '0,/path3(2)/s//path3(3)/' spec.k > "$proof_tmpdir/spec-mutated.k"
+if kprove "$proof_tmpdir/spec-mutated.k" \
+     -I /work \
+     --definition verification-kompiled \
+     --spec-module MINPATH-SPEC \
+     > "$proof_tmpdir/mutation.out" 2>&1; then
+  echo 'ERROR: mutated specification unexpectedly proved' >&2
+  exit 1
+fi
+echo 'mutation probe failed as expected'
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..12bff6c214073943d697c8b17d689ade492d3dda
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,140 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Stmts  ::= List{Stmt, ""}
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+  syntax Exprs  ::= List{Expr, ","}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Expr" "(" Expr ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," Cmp ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "ListExpr" "(" Exprs ")"
+  syntax Cmp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  syntax Val ::= "vInt" "(" Int ")"
+               | "vBool" "(" Bool ")"
+               | "vList" "(" List ")"
+               | "vNone"
+  syntax Expr ::= Val
+  syntax Fn ::= "fn" "(" Params "," Stmts ")"
+  syntax Result ::= "none" | "some" "(" Val ")"
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "start" "(" Val "," Int ")"
+                 | "assignName" "(" String ")"
+                 | "discard"
+                 | "binLeft" "(" String "," Expr ")"
+                 | "binRight" "(" String "," Val ")"
+                 | "compareLeft" "(" String "," Expr ")"
+                 | "compareRight" "(" String "," Val ")"
+                 | "subscriptLeft" "(" Expr ")"
+                 | "subscriptRight" "(" Val ")"
+                 | "lengthOf"
+                 | "appendTo" "(" String ")"
+                 | "ifResult" "(" Stmts "," Stmts ")"
+                 | "whileResult" "(" Expr "," Stmts ")"
+                 | "setResult"
+
+  syntax Int ::= listLength(List) [function]
+  rule listLength(.List) => 0
+  rule listLength(ListItem(_) REST) => 1 +Int listLength(REST)
+
+  syntax Val ::= getVal(List, Int) [function]
+  rule getVal(ListItem(V:Val) _REST, 0) => V
+  rule getVal(ListItem(_V:Val) REST, I) => getVal(REST, I -Int 1)
+    requires I >Int 0
+
+  configuration
+    <py>
+      <k> $PGM:Program ~> start($GRID:Val, $KLEN:Int) </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> none </result>
+    </py>
+
+  rule <k> Module(SS) => exec(SS) ... </k>
+  rule <k> exec(.Stmts) => . ... </k>
+  rule <k> exec(S SS) => S ~> exec(SS) ... </k>
+
+  rule <k> FuncDef(F, PS, BODY) => . ... </k>
+       <functions> FS => FS [ F <- fn(PS, BODY) ] </functions>
+
+  rule <k> start(GRID, KLEN) => exec(BODY) ... </k>
+       <functions> ... "minPath" |-> fn(Params("grid", "k"), BODY) ... </functions>
+       <env> _ => "grid" |-> GRID "k" |-> vInt(KLEN) </env>
+
+  rule <k> Assign(Name(X), E) => E ~> assignName(X) ... </k>
+  rule <k> V:Val ~> assignName(X) => . ... </k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule <k> Expr(E) => E ~> discard ... </k>
+  rule <k> _V:Val ~> discard => . ... </k>
+
+  rule <k> Return(E) => E ~> setResult ... </k>
+  rule <k> V:Val ~> setResult => . ... </k>
+       <result> none => some(V) </result>
+
+  rule <k> If(E, THEN, ELSE) => E ~> ifResult(THEN, ELSE) ... </k>
+  rule <k> vBool(true) ~> ifResult(THEN, _ELSE) => exec(THEN) ... </k>
+  rule <k> vBool(false) ~> ifResult(_THEN, ELSE) => exec(ELSE) ... </k>
+
+  rule <k> While(E, BODY) => E ~> whileResult(E, BODY) ... </k>
+  rule <k> vBool(true) ~> whileResult(E, BODY)
+         => exec(BODY) ~> While(E, BODY) ... </k>
+  rule <k> vBool(false) ~> whileResult(_E, _BODY) => . ... </k>
+
+  rule <k> Int(I) => vInt(I) ... </k>
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V ... </env>
+  rule <k> ListExpr(.Exprs) => vList(.List) ... </k>
+
+  rule <k> BinOp(OP, E1, E2) => E1 ~> binLeft(OP, E2) ... </k>
+  rule <k> V1:Val ~> binLeft(OP, E2) => E2 ~> binRight(OP, V1) ... </k>
+  rule <k> vInt(I2) ~> binRight("+", vInt(I1)) => vInt(I1 +Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("-", vInt(I1)) => vInt(I1 -Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("*", vInt(I1)) => vInt(I1 *Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("%", vInt(I1)) => vInt(I1 %Int I2) ... </k>
+
+  rule <k> Compare(E1, CmpOp(OP, E2)) => E1 ~> compareLeft(OP, E2) ... </k>
+  rule <k> V1:Val ~> compareLeft(OP, E2) => E2 ~> compareRight(OP, V1) ... </k>
+  rule <k> vInt(I2) ~> compareRight("<",  vInt(I1)) => vBool(I1 <Int  I2) ... </k>
+  rule <k> vInt(I2) ~> compareRight(">",  vInt(I1)) => vBool(I1 >Int  I2) ... </k>
+  rule <k> vInt(I2) ~> compareRight("==", vInt(I1)) => vBool(I1 ==Int I2) ... </k>
+
+  rule <k> Subscript(E1, E2) => E1 ~> subscriptLeft(E2) ... </k>
+  rule <k> V1:Val ~> subscriptLeft(E2) => E2 ~> subscriptRight(V1) ... </k>
+  rule <k> vInt(I) ~> subscriptRight(vList(L)) => getVal(L, I) ... </k>
+
+  rule <k> Call(Name("len"), E, .Exprs) => E ~> lengthOf ... </k>
+  rule <k> vList(L) ~> lengthOf => vInt(listLength(L)) ... </k>
+
+  rule <k> Call(Attribute(Name(X), "append"), E, .Exprs) => E ~> appendTo(X) ... </k>
+  rule <k> V:Val ~> appendTo(X) => vNone ... </k>
+       <env> ... X |-> vList(L => L ListItem(V)) ... </env>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4c0d5c3bb718c4691af6154b3d923f3c9aa55cad
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,37 @@
+def minPath(grid, k):
+    n = len(grid)
+    x = 0
+    y = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                x = i
+                y = j
+            j = j + 1
+        i = i + 1
+
+    best = n * n + 1
+    if x > 0:
+        if grid[x - 1][y] < best:
+            best = grid[x - 1][y]
+    if x + 1 < n:
+        if grid[x + 1][y] < best:
+            best = grid[x + 1][y]
+    if y > 0:
+        if grid[x][y - 1] < best:
+            best = grid[x][y - 1]
+    if y + 1 < n:
+        if grid[x][y + 1] < best:
+            best = grid[x][y + 1]
+
+    answer = []
+    i = 0
+    while i < k:
+        if i % 2 == 0:
+            answer.append(1)
+        else:
+            answer.append(best)
+        i = i + 1
+    return answer
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1d27d1931be0d47065acd1107f4e7d8a38e80fed
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,79 @@
+requires "verification.k"
+
+module MINPATH-SPEC
+  imports MINPATH-VERIFICATION
+
+  // The two examples from prompt.py.
+  claim
+    <k> solutionProgram ~> start(grid3(1, 2, 3, 4, 5, 6, 7, 8, 9), 3)
+      => .K </k>
+    <result> none => some(path3(2)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+
+  claim
+    <k> solutionProgram ~> start(grid3(5, 9, 3, 4, 1, 6, 7, 8, 2), 1)
+      => .K </k>
+    <result> none => some(path1(1)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+
+  // Symbolic 2x2 coverage.  The range, disequality, and ordering constraints
+  // make A/B/C a permutation of 2,3,4.  For every location of 1, the two
+  // claims cover both possible orders of its two neighbors.
+  claim
+    <k> solutionProgram ~> start(grid2(1, A, B, C), 5) => .K </k>
+    <result> none => some(path5(A)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool A <Int B
+
+  claim
+    <k> solutionProgram ~> start(grid2(1, A, B, C), 5) => .K </k>
+    <result> none => some(path5(B)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool B <Int A
+
+  claim
+    <k> solutionProgram ~> start(grid2(A, 1, C, B), 5) => .K </k>
+    <result> none => some(path5(A)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool A <Int B
+
+  claim
+    <k> solutionProgram ~> start(grid2(A, 1, C, B), 5) => .K </k>
+    <result> none => some(path5(B)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool B <Int A
+
+  claim
+    <k> solutionProgram ~> start(grid2(A, C, 1, B), 5) => .K </k>
+    <result> none => some(path5(A)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool A <Int B
+
+  claim
+    <k> solutionProgram ~> start(grid2(A, C, 1, B), 5) => .K </k>
+    <result> none => some(path5(B)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool B <Int A
+
+  claim
+    <k> solutionProgram ~> start(grid2(C, A, B, 1), 5) => .K </k>
+    <result> none => some(path5(A)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool A <Int B
+
+  claim
+    <k> solutionProgram ~> start(grid2(C, A, B, 1), 5) => .K </k>
+    <result> none => some(path5(B)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool B <Int A
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8ce7c1462f013d47d54a7926fe2401f9f194a5de
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,119 @@
+requires "semantic.k"
+
+module MINPATH-VERIFICATION
+  imports MPY
+
+  // Compact value constructors used only to state readable claims.  They
+  // expand to the same vList/ListItem representation consumed by MPY.
+  syntax Val ::= "grid2" "(" Int "," Int "," Int "," Int ")" [function]
+               | "grid3" "(" Int "," Int "," Int "," Int "," Int ","
+                            Int "," Int "," Int "," Int ")" [function]
+               | "path1" "(" Int ")" [function]
+               | "path3" "(" Int ")" [function]
+               | "path5" "(" Int ")" [function]
+
+  rule grid2(A, B, C, D) =>
+    vList(ListItem(vList(ListItem(vInt(A)) ListItem(vInt(B))))
+          ListItem(vList(ListItem(vInt(C)) ListItem(vInt(D)))))
+
+  rule grid3(A, B, C, D, E, F, G, H, I) =>
+    vList(ListItem(vList(ListItem(vInt(A)) ListItem(vInt(B)) ListItem(vInt(C))))
+          ListItem(vList(ListItem(vInt(D)) ListItem(vInt(E)) ListItem(vInt(F))))
+          ListItem(vList(ListItem(vInt(G)) ListItem(vInt(H)) ListItem(vInt(I)))))
+
+  rule path1(_M) => vList(ListItem(vInt(1)))
+  rule path3(M) =>
+    vList(ListItem(vInt(1)) ListItem(vInt(M)) ListItem(vInt(1)))
+  rule path5(M) =>
+    vList(ListItem(vInt(1)) ListItem(vInt(M)) ListItem(vInt(1))
+          ListItem(vInt(M)) ListItem(vInt(1)))
+
+  syntax Bool ::= "validTail" "(" Int "," Int "," Int ")" [function]
+  rule validTail(A, B, C) =>
+    A >=Int 2 andBool A <=Int 4 andBool
+    B >=Int 2 andBool B <=Int 4 andBool
+    C >=Int 2 andBool C <=Int 4 andBool
+    A =/=Int B andBool A =/=Int C andBool B =/=Int C
+
+  // This constant expands to the exact constructor term emitted in
+  // solution.mpy. Keeping
+  // it as a Program term lets specifications share the program without adding
+  // any proof-only execution rule.
+  syntax Program ::= "solutionProgram"
+  rule solutionProgram =>
+    Module(
+      FuncDef("minPath", Params("grid", "k"),
+        Assign(Name("n"), Call(Name("len"), Name("grid")))
+        Assign(Name("x"), Int(0))
+        Assign(Name("y"), Int(0))
+        Assign(Name("i"), Int(0))
+        While(Compare(Name("i"), CmpOp("<", Name("n"))),
+          Assign(Name("j"), Int(0))
+          While(Compare(Name("j"), CmpOp("<", Name("n"))),
+            If(Compare(
+              Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+              CmpOp("==", Int(1))),
+              Assign(Name("x"), Name("i"))
+              Assign(Name("y"), Name("j")),
+              .Stmts)
+            Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Assign(Name("best"),
+          BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+        If(Compare(Name("x"), CmpOp(">", Int(0))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), BinOp("-", Name("x"), Int(1))),
+              Name("y")),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), BinOp("-", Name("x"), Int(1))),
+                Name("y"))),
+            .Stmts),
+          .Stmts)
+        If(Compare(BinOp("+", Name("x"), Int(1)), CmpOp("<", Name("n"))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), BinOp("+", Name("x"), Int(1))),
+              Name("y")),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), BinOp("+", Name("x"), Int(1))),
+                Name("y"))),
+            .Stmts),
+          .Stmts)
+        If(Compare(Name("y"), CmpOp(">", Int(0))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), Name("x")),
+              BinOp("-", Name("y"), Int(1))),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), Name("x")),
+                BinOp("-", Name("y"), Int(1)))),
+            .Stmts),
+          .Stmts)
+        If(Compare(BinOp("+", Name("y"), Int(1)), CmpOp("<", Name("n"))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), Name("x")),
+              BinOp("+", Name("y"), Int(1))),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), Name("x")),
+                BinOp("+", Name("y"), Int(1)))),
+            .Stmts),
+          .Stmts)
+        Assign(Name("answer"), ListExpr(.Exprs))
+        Assign(Name("i"), Int(0))
+        While(Compare(Name("i"), CmpOp("<", Name("k"))),
+          If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+            Expr(Call(Attribute(Name("answer"), "append"), Int(1))),
+            Expr(Call(Attribute(Name("answer"), "append"), Name("best"))))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Return(Name("answer"))))
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ba1b91a10c05c98a84e55c4b453f68cb8c3da901
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,83 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+proof_tmpdir="$(mktemp -d /work/minpath-proof.XXXXXXXX)"
+trap 'rm -rf "$proof_tmpdir"' EXIT
+
+# Recreate the submitted constructor program with the fixed translator.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Independent executable check against exhaustive path enumeration: every 2x2
+# permutation for k=1..7, followed by deterministic 3x3 samples.
+python3 - <<'PY'
+from itertools import permutations
+from random import Random
+from solution import minPath
+
+
+def brute(grid, k):
+    n = len(grid)
+    states = [([grid[r][c]], r, c) for r in range(n) for c in range(n)]
+    for _ in range(k - 1):
+        following = []
+        for values, r, c in states:
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < n and 0 <= nc < n:
+                    following.append((values + [grid[nr][nc]], nr, nc))
+        states = following
+    return min(values for values, _, _ in states)
+
+
+for cells in permutations(range(1, 5)):
+    grid = [list(cells[:2]), list(cells[2:])]
+    for k in range(1, 8):
+        assert minPath(grid, k) == brute(grid, k)
+
+rng = Random(129)
+for _ in range(120):
+    cells = list(range(1, 10))
+    rng.shuffle(cells)
+    grid = [cells[0:3], cells[3:6], cells[6:9]]
+    k = rng.randrange(1, 7)
+    assert minPath(grid, k) == brute(grid, k)
+PY
+
+# Build the executable semantics and exercise both examples from prompt.py.
+kompile semantic.k --main-module MPY --syntax-module MPY-SYNTAX --backend llvm
+
+grid_example_1='vList(ListItem(vList(ListItem(vInt(1)) ListItem(vInt(2)) ListItem(vInt(3)))) ListItem(vList(ListItem(vInt(4)) ListItem(vInt(5)) ListItem(vInt(6)))) ListItem(vList(ListItem(vInt(7)) ListItem(vInt(8)) ListItem(vInt(9)))))'
+grid_example_2='vList(ListItem(vList(ListItem(vInt(5)) ListItem(vInt(9)) ListItem(vInt(3)))) ListItem(vList(ListItem(vInt(4)) ListItem(vInt(1)) ListItem(vInt(6)))) ListItem(vList(ListItem(vInt(7)) ListItem(vInt(8)) ListItem(vInt(2)))))'
+
+krun solution.mpy --definition semantic-kompiled \
+  -cGRID="$grid_example_1" -cKLEN=3 --output pretty \
+  > "$proof_tmpdir/krun-example-1.out"
+krun solution.mpy --definition semantic-kompiled \
+  -cGRID="$grid_example_2" -cKLEN=1 --output pretty \
+  > "$proof_tmpdir/krun-example-2.out"
+rg -q 'some' "$proof_tmpdir/krun-example-1.out"
+rg -q 'some' "$proof_tmpdir/krun-example-2.out"
+
+# The Haskell backend symbolically proves every reachability claim in spec.k.
+kompile verification.k \
+  --main-module MINPATH-VERIFICATION \
+  --syntax-module MINPATH-VERIFICATION \
+  --backend haskell
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module MINPATH-SPEC \
+  | tee "$proof_tmpdir/kprove.out"
+rg -qx '#Top' "$proof_tmpdir/kprove.out"
+
+# Non-vacuity probe: changing the first expected path must make proof fail.
+sed '0,/path3(2)/s//path3(3)/' spec.k > "$proof_tmpdir/spec-mutated.k"
+if kprove "$proof_tmpdir/spec-mutated.k" \
+     -I /work \
+     --definition verification-kompiled \
+     --spec-module MINPATH-SPEC \
+     > "$proof_tmpdir/mutation.out" 2>&1; then
+  echo 'ERROR: mutated specification unexpectedly proved' >&2
+  exit 1
+fi
+echo 'mutation probe failed as expected'
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..12bff6c214073943d697c8b17d689ade492d3dda
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,140 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Stmts  ::= List{Stmt, ""}
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+  syntax Exprs  ::= List{Expr, ","}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Expr" "(" Expr ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," Cmp ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "ListExpr" "(" Exprs ")"
+  syntax Cmp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  syntax Val ::= "vInt" "(" Int ")"
+               | "vBool" "(" Bool ")"
+               | "vList" "(" List ")"
+               | "vNone"
+  syntax Expr ::= Val
+  syntax Fn ::= "fn" "(" Params "," Stmts ")"
+  syntax Result ::= "none" | "some" "(" Val ")"
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "start" "(" Val "," Int ")"
+                 | "assignName" "(" String ")"
+                 | "discard"
+                 | "binLeft" "(" String "," Expr ")"
+                 | "binRight" "(" String "," Val ")"
+                 | "compareLeft" "(" String "," Expr ")"
+                 | "compareRight" "(" String "," Val ")"
+                 | "subscriptLeft" "(" Expr ")"
+                 | "subscriptRight" "(" Val ")"
+                 | "lengthOf"
+                 | "appendTo" "(" String ")"
+                 | "ifResult" "(" Stmts "," Stmts ")"
+                 | "whileResult" "(" Expr "," Stmts ")"
+                 | "setResult"
+
+  syntax Int ::= listLength(List) [function]
+  rule listLength(.List) => 0
+  rule listLength(ListItem(_) REST) => 1 +Int listLength(REST)
+
+  syntax Val ::= getVal(List, Int) [function]
+  rule getVal(ListItem(V:Val) _REST, 0) => V
+  rule getVal(ListItem(_V:Val) REST, I) => getVal(REST, I -Int 1)
+    requires I >Int 0
+
+  configuration
+    <py>
+      <k> $PGM:Program ~> start($GRID:Val, $KLEN:Int) </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> none </result>
+    </py>
+
+  rule <k> Module(SS) => exec(SS) ... </k>
+  rule <k> exec(.Stmts) => . ... </k>
+  rule <k> exec(S SS) => S ~> exec(SS) ... </k>
+
+  rule <k> FuncDef(F, PS, BODY) => . ... </k>
+       <functions> FS => FS [ F <- fn(PS, BODY) ] </functions>
+
+  rule <k> start(GRID, KLEN) => exec(BODY) ... </k>
+       <functions> ... "minPath" |-> fn(Params("grid", "k"), BODY) ... </functions>
+       <env> _ => "grid" |-> GRID "k" |-> vInt(KLEN) </env>
+
+  rule <k> Assign(Name(X), E) => E ~> assignName(X) ... </k>
+  rule <k> V:Val ~> assignName(X) => . ... </k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule <k> Expr(E) => E ~> discard ... </k>
+  rule <k> _V:Val ~> discard => . ... </k>
+
+  rule <k> Return(E) => E ~> setResult ... </k>
+  rule <k> V:Val ~> setResult => . ... </k>
+       <result> none => some(V) </result>
+
+  rule <k> If(E, THEN, ELSE) => E ~> ifResult(THEN, ELSE) ... </k>
+  rule <k> vBool(true) ~> ifResult(THEN, _ELSE) => exec(THEN) ... </k>
+  rule <k> vBool(false) ~> ifResult(_THEN, ELSE) => exec(ELSE) ... </k>
+
+  rule <k> While(E, BODY) => E ~> whileResult(E, BODY) ... </k>
+  rule <k> vBool(true) ~> whileResult(E, BODY)
+         => exec(BODY) ~> While(E, BODY) ... </k>
+  rule <k> vBool(false) ~> whileResult(_E, _BODY) => . ... </k>
+
+  rule <k> Int(I) => vInt(I) ... </k>
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V ... </env>
+  rule <k> ListExpr(.Exprs) => vList(.List) ... </k>
+
+  rule <k> BinOp(OP, E1, E2) => E1 ~> binLeft(OP, E2) ... </k>
+  rule <k> V1:Val ~> binLeft(OP, E2) => E2 ~> binRight(OP, V1) ... </k>
+  rule <k> vInt(I2) ~> binRight("+", vInt(I1)) => vInt(I1 +Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("-", vInt(I1)) => vInt(I1 -Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("*", vInt(I1)) => vInt(I1 *Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("%", vInt(I1)) => vInt(I1 %Int I2) ... </k>
+
+  rule <k> Compare(E1, CmpOp(OP, E2)) => E1 ~> compareLeft(OP, E2) ... </k>
+  rule <k> V1:Val ~> compareLeft(OP, E2) => E2 ~> compareRight(OP, V1) ... </k>
+  rule <k> vInt(I2) ~> compareRight("<",  vInt(I1)) => vBool(I1 <Int  I2) ... </k>
+  rule <k> vInt(I2) ~> compareRight(">",  vInt(I1)) => vBool(I1 >Int  I2) ... </k>
+  rule <k> vInt(I2) ~> compareRight("==", vInt(I1)) => vBool(I1 ==Int I2) ... </k>
+
+  rule <k> Subscript(E1, E2) => E1 ~> subscriptLeft(E2) ... </k>
+  rule <k> V1:Val ~> subscriptLeft(E2) => E2 ~> subscriptRight(V1) ... </k>
+  rule <k> vInt(I) ~> subscriptRight(vList(L)) => getVal(L, I) ... </k>
+
+  rule <k> Call(Name("len"), E, .Exprs) => E ~> lengthOf ... </k>
+  rule <k> vList(L) ~> lengthOf => vInt(listLength(L)) ... </k>
+
+  rule <k> Call(Attribute(Name(X), "append"), E, .Exprs) => E ~> appendTo(X) ... </k>
+  rule <k> V:Val ~> appendTo(X) => vNone ... </k>
+       <env> ... X |-> vList(L => L ListItem(V)) ... </env>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4c0d5c3bb718c4691af6154b3d923f3c9aa55cad
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,37 @@
+def minPath(grid, k):
+    n = len(grid)
+    x = 0
+    y = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                x = i
+                y = j
+            j = j + 1
+        i = i + 1
+
+    best = n * n + 1
+    if x > 0:
+        if grid[x - 1][y] < best:
+            best = grid[x - 1][y]
+    if x + 1 < n:
+        if grid[x + 1][y] < best:
+            best = grid[x + 1][y]
+    if y > 0:
+        if grid[x][y - 1] < best:
+            best = grid[x][y - 1]
+    if y + 1 < n:
+        if grid[x][y + 1] < best:
+            best = grid[x][y + 1]
+
+    answer = []
+    i = 0
+    while i < k:
+        if i % 2 == 0:
+            answer.append(1)
+        else:
+            answer.append(best)
+        i = i + 1
+    return answer
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1d27d1931be0d47065acd1107f4e7d8a38e80fed
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,79 @@
+requires "verification.k"
+
+module MINPATH-SPEC
+  imports MINPATH-VERIFICATION
+
+  // The two examples from prompt.py.
+  claim
+    <k> solutionProgram ~> start(grid3(1, 2, 3, 4, 5, 6, 7, 8, 9), 3)
+      => .K </k>
+    <result> none => some(path3(2)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+
+  claim
+    <k> solutionProgram ~> start(grid3(5, 9, 3, 4, 1, 6, 7, 8, 2), 1)
+      => .K </k>
+    <result> none => some(path1(1)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+
+  // Symbolic 2x2 coverage.  The range, disequality, and ordering constraints
+  // make A/B/C a permutation of 2,3,4.  For every location of 1, the two
+  // claims cover both possible orders of its two neighbors.
+  claim
+    <k> solutionProgram ~> start(grid2(1, A, B, C), 5) => .K </k>
+    <result> none => some(path5(A)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool A <Int B
+
+  claim
+    <k> solutionProgram ~> start(grid2(1, A, B, C), 5) => .K </k>
+    <result> none => some(path5(B)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool B <Int A
+
+  claim
+    <k> solutionProgram ~> start(grid2(A, 1, C, B), 5) => .K </k>
+    <result> none => some(path5(A)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool A <Int B
+
+  claim
+    <k> solutionProgram ~> start(grid2(A, 1, C, B), 5) => .K </k>
+    <result> none => some(path5(B)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool B <Int A
+
+  claim
+    <k> solutionProgram ~> start(grid2(A, C, 1, B), 5) => .K </k>
+    <result> none => some(path5(A)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool A <Int B
+
+  claim
+    <k> solutionProgram ~> start(grid2(A, C, 1, B), 5) => .K </k>
+    <result> none => some(path5(B)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool B <Int A
+
+  claim
+    <k> solutionProgram ~> start(grid2(C, A, B, 1), 5) => .K </k>
+    <result> none => some(path5(A)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool A <Int B
+
+  claim
+    <k> solutionProgram ~> start(grid2(C, A, B, 1), 5) => .K </k>
+    <result> none => some(path5(B)) </result>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    requires validTail(A, B, C) andBool B <Int A
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8ce7c1462f013d47d54a7926fe2401f9f194a5de
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,119 @@
+requires "semantic.k"
+
+module MINPATH-VERIFICATION
+  imports MPY
+
+  // Compact value constructors used only to state readable claims.  They
+  // expand to the same vList/ListItem representation consumed by MPY.
+  syntax Val ::= "grid2" "(" Int "," Int "," Int "," Int ")" [function]
+               | "grid3" "(" Int "," Int "," Int "," Int "," Int ","
+                            Int "," Int "," Int "," Int ")" [function]
+               | "path1" "(" Int ")" [function]
+               | "path3" "(" Int ")" [function]
+               | "path5" "(" Int ")" [function]
+
+  rule grid2(A, B, C, D) =>
+    vList(ListItem(vList(ListItem(vInt(A)) ListItem(vInt(B))))
+          ListItem(vList(ListItem(vInt(C)) ListItem(vInt(D)))))
+
+  rule grid3(A, B, C, D, E, F, G, H, I) =>
+    vList(ListItem(vList(ListItem(vInt(A)) ListItem(vInt(B)) ListItem(vInt(C))))
+          ListItem(vList(ListItem(vInt(D)) ListItem(vInt(E)) ListItem(vInt(F))))
+          ListItem(vList(ListItem(vInt(G)) ListItem(vInt(H)) ListItem(vInt(I)))))
+
+  rule path1(_M) => vList(ListItem(vInt(1)))
+  rule path3(M) =>
+    vList(ListItem(vInt(1)) ListItem(vInt(M)) ListItem(vInt(1)))
+  rule path5(M) =>
+    vList(ListItem(vInt(1)) ListItem(vInt(M)) ListItem(vInt(1))
+          ListItem(vInt(M)) ListItem(vInt(1)))
+
+  syntax Bool ::= "validTail" "(" Int "," Int "," Int ")" [function]
+  rule validTail(A, B, C) =>
+    A >=Int 2 andBool A <=Int 4 andBool
+    B >=Int 2 andBool B <=Int 4 andBool
+    C >=Int 2 andBool C <=Int 4 andBool
+    A =/=Int B andBool A =/=Int C andBool B =/=Int C
+
+  // This constant expands to the exact constructor term emitted in
+  // solution.mpy. Keeping
+  // it as a Program term lets specifications share the program without adding
+  // any proof-only execution rule.
+  syntax Program ::= "solutionProgram"
+  rule solutionProgram =>
+    Module(
+      FuncDef("minPath", Params("grid", "k"),
+        Assign(Name("n"), Call(Name("len"), Name("grid")))
+        Assign(Name("x"), Int(0))
+        Assign(Name("y"), Int(0))
+        Assign(Name("i"), Int(0))
+        While(Compare(Name("i"), CmpOp("<", Name("n"))),
+          Assign(Name("j"), Int(0))
+          While(Compare(Name("j"), CmpOp("<", Name("n"))),
+            If(Compare(
+              Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+              CmpOp("==", Int(1))),
+              Assign(Name("x"), Name("i"))
+              Assign(Name("y"), Name("j")),
+              .Stmts)
+            Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Assign(Name("best"),
+          BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+        If(Compare(Name("x"), CmpOp(">", Int(0))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), BinOp("-", Name("x"), Int(1))),
+              Name("y")),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), BinOp("-", Name("x"), Int(1))),
+                Name("y"))),
+            .Stmts),
+          .Stmts)
+        If(Compare(BinOp("+", Name("x"), Int(1)), CmpOp("<", Name("n"))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), BinOp("+", Name("x"), Int(1))),
+              Name("y")),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), BinOp("+", Name("x"), Int(1))),
+                Name("y"))),
+            .Stmts),
+          .Stmts)
+        If(Compare(Name("y"), CmpOp(">", Int(0))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), Name("x")),
+              BinOp("-", Name("y"), Int(1))),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), Name("x")),
+                BinOp("-", Name("y"), Int(1)))),
+            .Stmts),
+          .Stmts)
+        If(Compare(BinOp("+", Name("y"), Int(1)), CmpOp("<", Name("n"))),
+          If(Compare(
+            Subscript(
+              Subscript(Name("grid"), Name("x")),
+              BinOp("+", Name("y"), Int(1))),
+            CmpOp("<", Name("best"))),
+            Assign(Name("best"),
+              Subscript(
+                Subscript(Name("grid"), Name("x")),
+                BinOp("+", Name("y"), Int(1)))),
+            .Stmts),
+          .Stmts)
+        Assign(Name("answer"), ListExpr(.Exprs))
+        Assign(Name("i"), Int(0))
+        While(Compare(Name("i"), CmpOp("<", Name("k"))),
+          If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+            Expr(Call(Attribute(Name("answer"), "append"), Int(1))),
+            Expr(Call(Attribute(Name("answer"), "append"), Name("best"))))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Return(Name("answer"))))
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ba1b91a10c05c98a84e55c4b453f68cb8c3da901
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,83 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+proof_tmpdir="$(mktemp -d /work/minpath-proof.XXXXXXXX)"
+trap 'rm -rf "$proof_tmpdir"' EXIT
+
+# Recreate the submitted constructor program with the fixed translator.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Independent executable check against exhaustive path enumeration: every 2x2
+# permutation for k=1..7, followed by deterministic 3x3 samples.
+python3 - <<'PY'
+from itertools import permutations
+from random import Random
+from solution import minPath
+
+
+def brute(grid, k):
+    n = len(grid)
+    states = [([grid[r][c]], r, c) for r in range(n) for c in range(n)]
+    for _ in range(k - 1):
+        following = []
+        for values, r, c in states:
+            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
+                nr, nc = r + dr, c + dc
+                if 0 <= nr < n and 0 <= nc < n:
+                    following.append((values + [grid[nr][nc]], nr, nc))
+        states = following
+    return min(values for values, _, _ in states)
+
+
+for cells in permutations(range(1, 5)):
+    grid = [list(cells[:2]), list(cells[2:])]
+    for k in range(1, 8):
+        assert minPath(grid, k) == brute(grid, k)
+
+rng = Random(129)
+for _ in range(120):
+    cells = list(range(1, 10))
+    rng.shuffle(cells)
+    grid = [cells[0:3], cells[3:6], cells[6:9]]
+    k = rng.randrange(1, 7)
+    assert minPath(grid, k) == brute(grid, k)
+PY
+
+# Build the executable semantics and exercise both examples from prompt.py.
+kompile semantic.k --main-module MPY --syntax-module MPY-SYNTAX --backend llvm
+
+grid_example_1='vList(ListItem(vList(ListItem(vInt(1)) ListItem(vInt(2)) ListItem(vInt(3)))) ListItem(vList(ListItem(vInt(4)) ListItem(vInt(5)) ListItem(vInt(6)))) ListItem(vList(ListItem(vInt(7)) ListItem(vInt(8)) ListItem(vInt(9)))))'
+grid_example_2='vList(ListItem(vList(ListItem(vInt(5)) ListItem(vInt(9)) ListItem(vInt(3)))) ListItem(vList(ListItem(vInt(4)) ListItem(vInt(1)) ListItem(vInt(6)))) ListItem(vList(ListItem(vInt(7)) ListItem(vInt(8)) ListItem(vInt(2)))))'
+
+krun solution.mpy --definition semantic-kompiled \
+  -cGRID="$grid_example_1" -cKLEN=3 --output pretty \
+  > "$proof_tmpdir/krun-example-1.out"
+krun solution.mpy --definition semantic-kompiled \
+  -cGRID="$grid_example_2" -cKLEN=1 --output pretty \
+  > "$proof_tmpdir/krun-example-2.out"
+rg -q 'some' "$proof_tmpdir/krun-example-1.out"
+rg -q 'some' "$proof_tmpdir/krun-example-2.out"
+
+# The Haskell backend symbolically proves every reachability claim in spec.k.
+kompile verification.k \
+  --main-module MINPATH-VERIFICATION \
+  --syntax-module MINPATH-VERIFICATION \
+  --backend haskell
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module MINPATH-SPEC \
+  | tee "$proof_tmpdir/kprove.out"
+rg -qx '#Top' "$proof_tmpdir/kprove.out"
+
+# Non-vacuity probe: changing the first expected path must make proof fail.
+sed '0,/path3(2)/s//path3(3)/' spec.k > "$proof_tmpdir/spec-mutated.k"
+if kprove "$proof_tmpdir/spec-mutated.k" \
+     -I /work \
+     --definition verification-kompiled \
+     --spec-module MINPATH-SPEC \
+     > "$proof_tmpdir/mutation.out" 2>&1; then
+  echo 'ERROR: mutated specification unexpectedly proved' >&2
+  exit 1
+fi
+echo 'mutation probe failed as expected'
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..12bff6c214073943d697c8b17d689ade492d3dda
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,140 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Stmts  ::= List{Stmt, ""}
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+  syntax Exprs  ::= List{Expr, ","}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Expr" "(" Expr ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," Cmp ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "ListExpr" "(" Exprs ")"
+  syntax Cmp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  syntax Val ::= "vInt" "(" Int ")"
+               | "vBool" "(" Bool ")"
+               | "vList" "(" List ")"
+               | "vNone"
+  syntax Expr ::= Val
+  syntax Fn ::= "fn" "(" Params "," Stmts ")"
+  syntax Result ::= "none" | "some" "(" Val ")"
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "start" "(" Val "," Int ")"
+                 | "assignName" "(" String ")"
+                 | "discard"
+                 | "binLeft" "(" String "," Expr ")"
+                 | "binRight" "(" String "," Val ")"
+                 | "compareLeft" "(" String "," Expr ")"
+                 | "compareRight" "(" String "," Val ")"
+                 | "subscriptLeft" "(" Expr ")"
+                 | "subscriptRight" "(" Val ")"
+                 | "lengthOf"
+                 | "appendTo" "(" String ")"
+                 | "ifResult" "(" Stmts "," Stmts ")"
+                 | "whileResult" "(" Expr "," Stmts ")"
+                 | "setResult"
+
+  syntax Int ::= listLength(List) [function]
+  rule listLength(.List) => 0
+  rule listLength(ListItem(_) REST) => 1 +Int listLength(REST)
+
+  syntax Val ::= getVal(List, Int) [function]
+  rule getVal(ListItem(V:Val) _REST, 0) => V
+  rule getVal(ListItem(_V:Val) REST, I) => getVal(REST, I -Int 1)
+    requires I >Int 0
+
+  configuration
+    <py>
+      <k> $PGM:Program ~> start($GRID:Val, $KLEN:Int) </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> none </result>
+    </py>
+
+  rule <k> Module(SS) => exec(SS) ... </k>
+  rule <k> exec(.Stmts) => . ... </k>
+  rule <k> exec(S SS) => S ~> exec(SS) ... </k>
+
+  rule <k> FuncDef(F, PS, BODY) => . ... </k>
+       <functions> FS => FS [ F <- fn(PS, BODY) ] </functions>
+
+  rule <k> start(GRID, KLEN) => exec(BODY) ... </k>
+       <functions> ... "minPath" |-> fn(Params("grid", "k"), BODY) ... </functions>
+       <env> _ => "grid" |-> GRID "k" |-> vInt(KLEN) </env>
+
+  rule <k> Assign(Name(X), E) => E ~> assignName(X) ... </k>
+  rule <k> V:Val ~> assignName(X) => . ... </k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule <k> Expr(E) => E ~> discard ... </k>
+  rule <k> _V:Val ~> discard => . ... </k>
+
+  rule <k> Return(E) => E ~> setResult ... </k>
+  rule <k> V:Val ~> setResult => . ... </k>
+       <result> none => some(V) </result>
+
+  rule <k> If(E, THEN, ELSE) => E ~> ifResult(THEN, ELSE) ... </k>
+  rule <k> vBool(true) ~> ifResult(THEN, _ELSE) => exec(THEN) ... </k>
+  rule <k> vBool(false) ~> ifResult(_THEN, ELSE) => exec(ELSE) ... </k>
+
+  rule <k> While(E, BODY) => E ~> whileResult(E, BODY) ... </k>
+  rule <k> vBool(true) ~> whileResult(E, BODY)
+         => exec(BODY) ~> While(E, BODY) ... </k>
+  rule <k> vBool(false) ~> whileResult(_E, _BODY) => . ... </k>
+
+  rule <k> Int(I) => vInt(I) ... </k>
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V ... </env>
+  rule <k> ListExpr(.Exprs) => vList(.List) ... </k>
+
+  rule <k> BinOp(OP, E1, E2) => E1 ~> binLeft(OP, E2) ... </k>
+  rule <k> V1:Val ~> binLeft(OP, E2) => E2 ~> binRight(OP, V1) ... </k>
+  rule <k> vInt(I2) ~> binRight("+", vInt(I1)) => vInt(I1 +Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("-", vInt(I1)) => vInt(I1 -Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("*", vInt(I1)) => vInt(I1 *Int I2) ... </k>
+  rule <k> vInt(I2) ~> binRight("%", vInt(I1)) => vInt(I1 %Int I2) ... </k>
+
+  rule <k> Compare(E1, CmpOp(OP, E2)) => E1 ~> compareLeft(OP, E2) ... </k>
+  rule <k> V1:Val ~> compareLeft(OP, E2) => E2 ~> compareRight(OP, V1) ... </k>
+  rule <k> vInt(I2) ~> compareRight("<",  vInt(I1)) => vBool(I1 <Int  I2) ... </k>
+  rule <k> vInt(I2) ~> compareRight(">",  vInt(I1)) => vBool(I1 >Int  I2) ... </k>
+  rule <k> vInt(I2) ~> compareRight("==", vInt(I1)) => vBool(I1 ==Int I2) ... </k>
+
+  rule <k> Subscript(E1, E2) => E1 ~> subscriptLeft(E2) ... </k>
+  rule <k> V1:Val ~> subscriptLeft(E2) => E2 ~> subscriptRight(V1) ... </k>
+  rule <k> vInt(I) ~> subscriptRight(vList(L)) => getVal(L, I) ... </k>
+
+  rule <k> Call(Name("len"), E, .Exprs) => E ~> lengthOf ... </k>
+  rule <k> vList(L) ~> lengthOf => vInt(listLength(L)) ... </k>
+
+  rule <k> Call(Attribute(Name(X), "append"), E, .Exprs) => E ~> appendTo(X) ... </k>
+  rule <k> V:Val ~> appendTo(X) => vNone ... </k>
+       <env> ... X |-> vList(L => L ListItem(V)) ... </env>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4c0d5c3bb718c4691af6154b3d923f3c9aa55cad
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,37 @@
+def minPath(grid, k):
+    n = len(grid)
+    x = 0
+    y = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                x = i
+                y = j
+            j = j + 1
+        i = i + 1
+
+    best = n * n + 1
+    if x > 0:
+        if grid[x - 1][y] < best:
+            best = grid[x - 1][y]
+    if x + 1 < n:
+        if grid[x + 1][y] < best:
+            best = grid[x + 1][y]
+    if y > 0:
+        if grid[x][y - 1] < best:
+            best = grid[x][y - 1]
+    if y + 1 < n:
+        if grid[x][y + 1] < best:
+            best = grid[x][y + 1]
+
+    answer = []
+    i = 0
+    while i < k:
+        if i % 2 == 0:
+            answer.append(1)
+        else:
+            answer.append(best)
+        i = i + 1
+    return answer
