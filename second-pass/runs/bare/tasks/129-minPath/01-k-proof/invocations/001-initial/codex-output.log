+  rule <k> V:Val ~> appendTo(X) => vNone ... </k>
+       <env> ... X |-> vList(L => L ListItem(V)) ... </env>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4c0d5c3bb718c4691af6154b3d923f3c9aa55cad
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,37 @@
+def minPath(grid, k):
+    n = len(grid)
+    x = 0
+    y = 0
+    i = 0
+    while i < n:
+        j = 0
+        while j < n:
+            if grid[i][j] == 1:
+                x = i
+                y = j
+            j = j + 1
+        i = i + 1
+
+    best = n * n + 1
+    if x > 0:
+        if grid[x - 1][y] < best:
+            best = grid[x - 1][y]
+    if x + 1 < n:
+        if grid[x + 1][y] < best:
+            best = grid[x + 1][y]
+    if y > 0:
+        if grid[x][y - 1] < best:
+            best = grid[x][y - 1]
+    if y + 1 < n:
+        if grid[x][y + 1] < best:
+            best = grid[x][y + 1]
+
+    answer = []
+    i = 0
+    while i < k:
+        if i % 2 == 0:
+            answer.append(1)
+        else:
+            answer.append(best)
+        i = i + 1
+    return answer

exec
/bin/bash -lc 'kompile semantic.k --main-module MPY --syntax-module MPY-SYNTAX --backend llvm' in /work
