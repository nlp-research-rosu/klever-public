+                | "ListExpr" "(" Exprs ")"
+  syntax Cmp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  syntax Val ::= "vInt" "(" Int ")"
+               | "vBool" "(" Bool ")"
+               | "vList" "(" List ")"
+               | "vNone"
+  syntax Expr ::= Val
+  syntax Fn ::= "fn" "(" Params "," Stmts ")"
+  syntax Result ::= "none" | "some" "(" Val ")"
+
+  syntax KItem ::= "exec" "(" Stmts ")"
+                 | "start" "(" Val "," Int ")"
+                 | "assignName" "(" String ")"
+                 | "discard"
+                 | "binLeft" "(" String "," Expr ")"
+                 | "binRight" "(" String "," Val ")"
+                 | "compareLeft" "(" String "," Expr ")"
+                 | "compareRight" "(" String "," Val ")"
+                 | "subscriptLeft" "(" Expr ")"
+                 | "subscriptRight" "(" Val ")"
+                 | "lengthOf"
