+  /tmp/audit-work/candidate-src/solution.mpy \
+  /tmp/audit-work/candidate-src/solution.regenerated.mpy
+compare_status=$?
+printf 'BYTE_COMPARE_EXIT=%s\n' "$compare_status"
+
+if [ "$translator_status" -eq 0 ] && [ "$compare_status" -eq 0 ]; then
+  exit 0
+fi
+diff -u \
+  /tmp/audit-work/candidate-src/solution.mpy \
+  /tmp/audit-work/candidate-src/solution.regenerated.mpy
+exit 1
