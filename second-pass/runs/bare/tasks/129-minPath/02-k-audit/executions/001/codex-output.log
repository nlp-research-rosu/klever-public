    80	
    81	  rule <k> Module(SS) => exec(SS) ... </k>
    82	  rule <k> exec(.Stmts) => . ... </k>
    83	  rule <k> exec(S SS) => S ~> exec(SS) ... </k>
    84	
    85	  rule <k> FuncDef(F, PS, BODY) => . ... </k>
    86	       <functions> FS => FS [ F <- fn(PS, BODY) ] </functions>
    87	
    88	  rule <k> start(GRID, KLEN) => exec(BODY) ... </k>
