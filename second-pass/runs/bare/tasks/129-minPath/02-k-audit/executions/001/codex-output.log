    51	                 | "discard"
    52	                 | "binLeft" "(" String "," Expr ")"
    53	                 | "binRight" "(" String "," Val ")"
    54	                 | "compareLeft" "(" String "," Expr ")"
    55	                 | "compareRight" "(" String "," Val ")"
    56	                 | "subscriptLeft" "(" Expr ")"
    57	                 | "subscriptRight" "(" Val ")"
    58	                 | "lengthOf"
    59	                 | "appendTo" "(" String ")"
    60	                 | "ifResult" "(" Stmts "," Stmts ")"
    61	                 | "whileResult" "(" Expr "," Stmts ")"
    62	                 | "setResult"
    63	
    64	  syntax Int ::= listLength(List) [function]
    65	  rule listLength(.List) => 0
    66	  rule listLength(ListItem(_) REST) => 1 +Int listLength(REST)
    67	
    68	  syntax Val ::= getVal(List, Int) [function]
    69	  rule getVal(ListItem(V:Val) _REST, 0) => V
    70	  rule getVal(ListItem(_V:Val) REST, I) => getVal(REST, I -Int 1)
