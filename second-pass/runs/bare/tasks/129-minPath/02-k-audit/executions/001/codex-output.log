+
+printf '%s\n' \
+  "ALIAS_COMMAND: krun solutionProgram.mpy --definition verification-kompiled-fresh -cGRID=$grid -cKLEN=5 --depth 2 --output pretty"
+krun "$work/solutionProgram.mpy" \
+  --definition "$work/verification-kompiled-fresh" \
+  -cGRID="$grid" \
