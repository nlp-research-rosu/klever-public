FILE /candidate/prove.sh
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd "$(dirname "$0")"
     5	proof_tmpdir="$(mktemp -d /work/minpath-proof.XXXXXXXX)"
     6	trap 'rm -rf "$proof_tmpdir"' EXIT
     7	
     8	# Recreate the submitted constructor program with the fixed translator.
     9	python3 py2mpy.py solution.py > solution.mpy
    10	
    11	# Independent executable check against exhaustive path enumeration: every 2x2
    12	# permutation for k=1..7, followed by deterministic 3x3 samples.
    13	python3 - <<'PY'
    14	from itertools import permutations
    15	from random import Random
    16	from solution import minPath
    17	
    18	
    19	def brute(grid, k):
    20	    n = len(grid)
    21	    states = [([grid[r][c]], r, c) for r in range(n) for c in range(n)]
    22	    for _ in range(k - 1):
    23	        following = []
    24	        for values, r, c in states:
    25	            for dr, dc in ((-1, 0), (1, 0), (0, -1), (0, 1)):
    26	                nr, nc = r + dr, c + dc
    27	                if 0 <= nr < n and 0 <= nc < n:
    28	                    following.append((values + [grid[nr][nc]], nr, nc))
    29	        states = following
    30	    return min(values for values, _, _ in states)
    31	
    32	
    33	for cells in permutations(range(1, 5)):
    34	    grid = [list(cells[:2]), list(cells[2:])]
    35	    for k in range(1, 8):
    36	        assert minPath(grid, k) == brute(grid, k)
    37	
    38	rng = Random(129)
    39	for _ in range(120):
    40	    cells = list(range(1, 10))
    41	    rng.shuffle(cells)
    42	    grid = [cells[0:3], cells[3:6], cells[6:9]]
    43	    k = rng.randrange(1, 7)
    44	    assert minPath(grid, k) == brute(grid, k)
    45	PY
    46	
    47	# Build the executable semantics and exercise both examples from prompt.py.
    48	kompile semantic.k --main-module MPY --syntax-module MPY-SYNTAX --backend llvm
    49	
    50	grid_example_1='vList(ListItem(vList(ListItem(vInt(1)) ListItem(vInt(2)) ListItem(vInt(3)))) ListItem(vList(ListItem(vInt(4)) ListItem(vInt(5)) ListItem(vInt(6)))) ListItem(vList(ListItem(vInt(7)) ListItem(vInt(8)) ListItem(vInt(9)))))'
    51	grid_example_2='vList(ListItem(vList(ListItem(vInt(5)) ListItem(vInt(9)) ListItem(vInt(3)))) ListItem(vList(ListItem(vInt(4)) ListItem(vInt(1)) ListItem(vInt(6)))) ListItem(vList(ListItem(vInt(7)) ListItem(vInt(8)) ListItem(vInt(2)))))'
    52	
    53	krun solution.mpy --definition semantic-kompiled \
    54	  -cGRID="$grid_example_1" -cKLEN=3 --output pretty \
    55	  > "$proof_tmpdir/krun-example-1.out"
    56	krun solution.mpy --definition semantic-kompiled \
    57	  -cGRID="$grid_example_2" -cKLEN=1 --output pretty \
    58	  > "$proof_tmpdir/krun-example-2.out"
    59	rg -q 'some' "$proof_tmpdir/krun-example-1.out"
    60	rg -q 'some' "$proof_tmpdir/krun-example-2.out"
    61	
    62	# The Haskell backend symbolically proves every reachability claim in spec.k.
    63	kompile verification.k \
    64	  --main-module MINPATH-VERIFICATION \
    65	  --syntax-module MINPATH-VERIFICATION \
    66	  --backend haskell
    67	kprove spec.k \
    68	  --definition verification-kompiled \
    69	  --spec-module MINPATH-SPEC \
    70	  | tee "$proof_tmpdir/kprove.out"
    71	rg -qx '#Top' "$proof_tmpdir/kprove.out"
    72	
