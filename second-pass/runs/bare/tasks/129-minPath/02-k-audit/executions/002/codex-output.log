     1	requires "semantic.k"
     2	
     3	module MINPATH-VERIFICATION
     4	  imports MPY
     5	
     6	  // Compact value constructors used only to state readable claims.  They
     7	  // expand to the same vList/ListItem representation consumed by MPY.
     8	  syntax Val ::= "grid2" "(" Int "," Int "," Int "," Int ")" [function]
     9	               | "grid3" "(" Int "," Int "," Int "," Int "," Int ","
    10	                            Int "," Int "," Int "," Int ")" [function]
    11	               | "path1" "(" Int ")" [function]
    12	               | "path3" "(" Int ")" [function]
    13	               | "path5" "(" Int ")" [function]
    14	               | "path6" "(" Int ")" [function]
    15	
    16	  rule grid2(A, B, C, D) =>
    17	    vList(ListItem(vList(ListItem(vInt(A)) ListItem(vInt(B))))
    18	          ListItem(vList(ListItem(vInt(C)) ListItem(vInt(D)))))
    19	
    20	  rule grid3(A, B, C, D, E, F, G, H, I) =>
    21	    vList(ListItem(vList(ListItem(vInt(A)) ListItem(vInt(B)) ListItem(vInt(C))))
    22	          ListItem(vList(ListItem(vInt(D)) ListItem(vInt(E)) ListItem(vInt(F))))
    23	          ListItem(vList(ListItem(vInt(G)) ListItem(vInt(H)) ListItem(vInt(I)))))
    24	
    25	  rule path1(_M) => vList(ListItem(vInt(1)))
    26	  rule path3(M) =>
    27	    vList(ListItem(vInt(1)) ListItem(vInt(M)) ListItem(vInt(1)))
    28	  rule path5(M) =>
    29	    vList(ListItem(vInt(1)) ListItem(vInt(M)) ListItem(vInt(1))
    30	          ListItem(vInt(M)) ListItem(vInt(1)))
    31	  rule path6(M) =>
    32	    vList(ListItem(vInt(1)) ListItem(vInt(M)) ListItem(vInt(1))
    33	          ListItem(vInt(M)) ListItem(vInt(1)) ListItem(vInt(M)))
    34	
    35	  syntax Bool ::= "validTail" "(" Int "," Int "," Int ")" [function]
    36	  rule validTail(A, B, C) =>
    37	    A >=Int 2 andBool A <=Int 4 andBool
    38	    B >=Int 2 andBool B <=Int 4 andBool
    39	    C >=Int 2 andBool C <=Int 4 andBool
    40	    A =/=Int B andBool A =/=Int C andBool B =/=Int C
    41	
    42	  // This constant expands to the exact constructor term emitted in
    43	  // solution.mpy. Keeping
    44	  // it as a Program term lets specifications share the program without adding
    45	  // any proof-only execution rule.
    46	  syntax Program ::= "solutionProgram"
    47	  rule solutionProgram =>
    48	    Module(
    49	      FuncDef("minPath", Params("grid", "k"),
    50	        Assign(Name("n"), Call(Name("len"), Name("grid")))
    51	        Assign(Name("x"), Int(0))
    52	        Assign(Name("y"), Int(0))
    53	        Assign(Name("i"), Int(0))
    54	        While(Compare(Name("i"), CmpOp("<", Name("n"))),
    55	          Assign(Name("j"), Int(0))
    56	          While(Compare(Name("j"), CmpOp("<", Name("n"))),
    57	            If(Compare(
    58	              Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
    59	              CmpOp("==", Int(1))),
    60	              Assign(Name("x"), Name("i"))
    61	              Assign(Name("y"), Name("j")),
    62	              .Stmts)
    63	            Assign(Name("j"), BinOp("+", Name("j"), Int(1))))
    64	          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    65	        Assign(Name("best"),
    66	          BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
    67	        If(Compare(Name("x"), CmpOp(">", Int(0))),
    68	          If(Compare(
    69	            Subscript(
    70	              Subscript(Name("grid"), BinOp("-", Name("x"), Int(1))),
    71	              Name("y")),
    72	            CmpOp("<", Name("best"))),
    73	            Assign(Name("best"),
    74	              Subscript(
    75	                Subscript(Name("grid"), BinOp("-", Name("x"), Int(1))),
    76	                Name("y"))),
    77	            .Stmts),
    78	          .Stmts)
    79	        If(Compare(BinOp("+", Name("x"), Int(1)), CmpOp("<", Name("n"))),
    80	          If(Compare(
    81	            Subscript(
    82	              Subscript(Name("grid"), BinOp("+", Name("x"), Int(1))),
    83	              Name("y")),
    84	            CmpOp("<", Name("best"))),
    85	            Assign(Name("best"),
    86	              Subscript(
    87	                Subscript(Name("grid"), BinOp("+", Name("x"), Int(1))),
    88	                Name("y"))),
    89	            .Stmts),
    90	          .Stmts)
    91	        If(Compare(Name("y"), CmpOp(">", Int(0))),
    92	          If(Compare(
    93	            Subscript(
    94	              Subscript(Name("grid"), Name("x")),
    95	              BinOp("-", Name("y"), Int(1))),
    96	            CmpOp("<", Name("best"))),
    97	            Assign(Name("best"),
    98	              Subscript(
    99	                Subscript(Name("grid"), Name("x")),
   100	                BinOp("-", Name("y"), Int(1)))),
   101	            .Stmts),
   102	          .Stmts)
   103	        If(Compare(BinOp("+", Name("y"), Int(1)), CmpOp("<", Name("n"))),
   104	          If(Compare(
   105	            Subscript(
   106	              Subscript(Name("grid"), Name("x")),
   107	              BinOp("+", Name("y"), Int(1))),
   108	            CmpOp("<", Name("best"))),
   109	            Assign(Name("best"),
   110	              Subscript(
   111	                Subscript(Name("grid"), Name("x")),
   112	                BinOp("+", Name("y"), Int(1)))),
   113	            .Stmts),
   114	          .Stmts)
   115	        Assign(Name("answer"), ListExpr(.Exprs))
   116	        Assign(Name("i"), Int(0))
   117	        While(Compare(Name("i"), CmpOp("<", Name("k"))),
   118	          If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
   119	            Expr(Call(Attribute(Name("answer"), "append"), Int(1))),
   120	            Expr(Call(Attribute(Name("answer"), "append"), Name("best"))))
   121	          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
   122	        Return(Name("answer"))))
   123	endmodule
