     1	requires "domains.md"
     2	
     3	module MPY-SYNTAX
     4	  imports INT-SYNTAX
     5	  imports BOOL-SYNTAX
     6	  imports STRING-SYNTAX
     7	
     8	  syntax Program ::= "Module" "(" Stmts ")"
     9	  syntax Stmts  ::= List{Stmt, ""}
    10	  syntax Params ::= "Params" "(" Strings ")"
    11	  syntax Strings ::= List{String, ","}
    12	  syntax Exprs  ::= List{Expr, ","}
    13	
    14	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
    15	                | "Assign" "(" Expr "," Expr ")"
    16	                | "While" "(" Expr "," Stmts ")"
    17	                | "If" "(" Expr "," Stmts "," Stmts ")"
    18	                | "Expr" "(" Expr ")"
    19	                | "Return" "(" Expr ")"
    20	
    21	  syntax Expr ::= "Int" "(" Int ")"
    22	                | "Name" "(" String ")"
    23	                | "BinOp" "(" String "," Expr "," Expr ")"
    24	                | "Compare" "(" Expr "," Cmp ")"
    25	                | "Subscript" "(" Expr "," Expr ")"
    26	                | "Call" "(" Expr "," Exprs ")"
    27	                | "Attribute" "(" Expr "," String ")"
    28	                | "ListExpr" "(" Exprs ")"
    29	  syntax Cmp ::= "CmpOp" "(" String "," Expr ")"
    30	endmodule
    31	
    32	module MPY
    33	  imports MPY-SYNTAX
    34	  imports INT
    35	  imports BOOL
    36	  imports STRING
    37	  imports MAP
    38	  imports LIST
    39	
    40	  syntax Val ::= "vInt" "(" Int ")"
    41	               | "vBool" "(" Bool ")"
    42	               | "vList" "(" List ")"
    43	               | "vNone"
    44	  syntax Expr ::= Val
    45	  syntax Fn ::= "fn" "(" Params "," Stmts ")"
    46	  syntax Result ::= "none" | "some" "(" Val ")"
    47	
    48	  syntax KItem ::= "exec" "(" Stmts ")"
    49	                 | "start" "(" Val "," Int ")"
    50	                 | "assignName" "(" String ")"
    51	                 | "discard"
    52	                 | "binLeft" "(" String "," Expr ")"
    53	                 | "binRight" "(" String "," Val ")"
    54	                 | "compareLeft" "(" String "," Expr ")"
    55	                 | "compareRight" "(" String "," Val ")"
    56	                 | "subscriptLeft" "(" Expr ")"
    57	                 | "subscriptRight" "(" Val ")"
    58	                 | "lengthOf"
    59	                 | "appendTo" "(" String ")"
    60	                 | "ifResult" "(" Stmts "," Stmts ")"
    61	                 | "whileResult" "(" Expr "," Stmts ")"
    62	                 | "setResult"
    63	
    64	  syntax Int ::= listLength(List) [function]
    65	  rule listLength(.List) => 0
    66	  rule listLength(ListItem(_) REST) => 1 +Int listLength(REST)
    67	
    68	  syntax Val ::= getVal(List, Int) [function]
    69	  rule getVal(ListItem(V:Val) _REST, 0) => V
    70	  rule getVal(ListItem(_V:Val) REST, I) => getVal(REST, I -Int 1)
    71	    requires I >Int 0
    72	
    73	  configuration
    74	    <py>
    75	      <k> $PGM:Program ~> start($GRID:Val, $KLEN:Int) </k>
    76	      <env> .Map </env>
    77	      <functions> .Map </functions>
    78	      <result> none </result>
    79	    </py>
    80	
    81	  rule <k> Module(SS) => exec(SS) ... </k>
    82	  rule <k> exec(.Stmts) => . ... </k>
    83	  rule <k> exec(S SS) => S ~> exec(SS) ... </k>
    84	
    85	  rule <k> FuncDef(F, PS, BODY) => . ... </k>
    86	       <functions> FS => FS [ F <- fn(PS, BODY) ] </functions>
    87	
    88	  rule <k> start(GRID, KLEN) => exec(BODY) ... </k>
    89	       <functions> ... "minPath" |-> fn(Params("grid", "k"), BODY) ... </functions>
    90	       <env> _ => "grid" |-> GRID "k" |-> vInt(KLEN) </env>
    91	
    92	  rule <k> Assign(Name(X), E) => E ~> assignName(X) ... </k>
    93	  rule <k> V:Val ~> assignName(X) => . ... </k>
    94	       <env> RHO => RHO [ X <- V ] </env>
    95	
    96	  rule <k> Expr(E) => E ~> discard ... </k>
    97	  rule <k> _V:Val ~> discard => . ... </k>
    98	
    99	  rule <k> Return(E) => E ~> setResult ... </k>
   100	  rule <k> V:Val ~> setResult => . ... </k>
   101	       <result> none => some(V) </result>
   102	
   103	  rule <k> If(E, THEN, ELSE) => E ~> ifResult(THEN, ELSE) ... </k>
   104	  rule <k> vBool(true) ~> ifResult(THEN, _ELSE) => exec(THEN) ... </k>
   105	  rule <k> vBool(false) ~> ifResult(_THEN, ELSE) => exec(ELSE) ... </k>
   106	
   107	  rule <k> While(E, BODY) => E ~> whileResult(E, BODY) ... </k>
   108	  rule <k> vBool(true) ~> whileResult(E, BODY)
   109	         => exec(BODY) ~> While(E, BODY) ... </k>
   110	  rule <k> vBool(false) ~> whileResult(_E, _BODY) => . ... </k>
   111	
   112	  rule <k> Int(I) => vInt(I) ... </k>
   113	  rule <k> Name(X) => V ... </k>
   114	       <env> ... X |-> V ... </env>
   115	  rule <k> ListExpr(.Exprs) => vList(.List) ... </k>
   116	
   117	  rule <k> BinOp(OP, E1, E2) => E1 ~> binLeft(OP, E2) ... </k>
   118	  rule <k> V1:Val ~> binLeft(OP, E2) => E2 ~> binRight(OP, V1) ... </k>
   119	  rule <k> vInt(I2) ~> binRight("+", vInt(I1)) => vInt(I1 +Int I2) ... </k>
   120	  rule <k> vInt(I2) ~> binRight("-", vInt(I1)) => vInt(I1 -Int I2) ... </k>
   121	  rule <k> vInt(I2) ~> binRight("*", vInt(I1)) => vInt(I1 *Int I2) ... </k>
   122	  rule <k> vInt(I2) ~> binRight("%", vInt(I1)) => vInt(I1 %Int I2) ... </k>
   123	
   124	  rule <k> Compare(E1, CmpOp(OP, E2)) => E1 ~> compareLeft(OP, E2) ... </k>
   125	  rule <k> V1:Val ~> compareLeft(OP, E2) => E2 ~> compareRight(OP, V1) ... </k>
   126	  rule <k> vInt(I2) ~> compareRight("<",  vInt(I1)) => vBool(I1 <Int  I2) ... </k>
   127	  rule <k> vInt(I2) ~> compareRight(">",  vInt(I1)) => vBool(I1 >Int  I2) ... </k>
   128	  rule <k> vInt(I2) ~> compareRight("==", vInt(I1)) => vBool(I1 ==Int I2) ... </k>
   129	
   130	  rule <k> Subscript(E1, E2) => E1 ~> subscriptLeft(E2) ... </k>
   131	  rule <k> V1:Val ~> subscriptLeft(E2) => E2 ~> subscriptRight(V1) ... </k>
   132	  rule <k> vInt(I) ~> subscriptRight(vList(L)) => getVal(L, I) ... </k>
   133	
   134	  rule <k> Call(Name("len"), E, .Exprs) => E ~> lengthOf ... </k>
   135	  rule <k> vList(L) ~> lengthOf => vInt(listLength(L)) ... </k>
   136	
   137	  rule <k> Call(Attribute(Name(X), "append"), E, .Exprs) => E ~> appendTo(X) ... </k>
   138	  rule <k> V:Val ~> appendTo(X) => vNone ... </k>
   139	       <env> ... X |-> vList(L => L ListItem(V)) ... </env>
   140	endmodule
