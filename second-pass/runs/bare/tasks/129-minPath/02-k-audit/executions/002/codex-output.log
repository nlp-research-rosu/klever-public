    62	        Subscript(
    63	          Subscript(Name("grid"), Name("x")),
    64	          BinOp("+", Name("y"), Int(1))),
    65	        CmpOp("<", Name("best"))),
    66	        Assign(
    67	          Name("best"),
    68	          Subscript(
    69	            Subscript(Name("grid"), Name("x")),
    70	            BinOp("+", Name("y"), Int(1)))),
    71	        ),
    72	      )
    73	    Assign(Name("answer"), ListExpr())
    74	    Assign(Name("i"), Int(0))
    75	    While(Compare(Name("i"), CmpOp("<", Name("k"))),
    76	      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
    77	        Expr(Call(Attribute(Name("answer"), "append"), Int(1))),
    78	        Expr(Call(Attribute(Name("answer"), "append"), Name("best"))))
    79	      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    80	    Return(Name("answer"))))
