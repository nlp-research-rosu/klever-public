    18	    <env> .Map => ?_ </env>
    19	    <functions> .Map => ?_ </functions>
    20	
    21	  // The same interior placement with a longer path observes the selected
    22	  // minimum (4) and the complete alternating construction.
    23	  claim
    24	    <k> solutionProgram ~> start(grid3(5, 9, 3, 4, 1, 6, 7, 8, 2), 6)
    25	      => .K </k>
    26	    <result> none => some(path6(4)) </result>
    27	    <env> .Map => ?_ </env>
    28	    <functions> .Map => ?_ </functions>
    29	
    30	  // Symbolic 2x2 coverage.  The range, disequality, and ordering constraints
    31	  // make A/B/C a permutation of 2,3,4.  For every location of 1, the two
    32	  // claims cover both possible orders of its two neighbors.
    33	  claim
    34	    <k> solutionProgram ~> start(grid2(1, A, B, C), 5) => .K </k>
    35	    <result> none => some(path5(A)) </result>
    36	    <env> .Map => ?_ </env>
    37	    <functions> .Map => ?_ </functions>
