#!/usr/bin/env bash
set -euo pipefail

# Recreate the constructor program from the unmodified translator.
python3 py2mpy.py solution.py > solution.mpy

# Concrete execution definition and representative runs (including the prompt example).
kompile semantic.k \
  --main-module MPY \
  --syntax-module MPY-SYNTAX \
  --backend llvm \
  --output-definition runtime-kompiled
krun solution.mpy --definition runtime-kompiled -cN=1
krun solution.mpy --definition runtime-kompiled -cN=5
krun solution.mpy --definition runtime-kompiled -cN=10

# The proof definition includes the independently named mathematical contract.
kompile verification.k \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --backend haskell \
  --output-definition verification-kompiled

# This is the sole positive target-proof command; it proves every claim in spec.k.
kprove spec.k --definition verification-kompiled
// A deliberately small semantics for the exact Python subset used by solution.py.
// The surface constructors are those emitted, without desugaring, by py2mpy.py.
module MPY-SYNTAX
  imports INT-SYNTAX
  imports STRING-SYNTAX

  syntax Pgm
  syntax Params
  syntax Stmt
  syntax Expr
  syntax Value

  syntax Pgm ::= "Module" "(" Stmt ")"
  syntax Params ::= "Params" "(" String ")"
  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmt ")"
                | "Return" "(" Expr ")" [strict]
  syntax Value ::= "Int" "(" Int ")"
  syntax Expr ::= Value
                | "Name" "(" String ")"
                | "BinOp" "(" String "," Expr "," Expr ")" [seqstrict(2,3)]
endmodule

module MPY
  imports MPY-SYNTAX
  imports INT
  imports STRING
  imports MAP

  syntax KResult ::= Value

  syntax Result ::= "noResult" | "result" "(" Int ")"

  configuration
    <mpy>
      <k> $PGM:Pgm </k>
      <input> $N:Int </input>
      <env> .Map </env>
      <result> noResult </result>
    </mpy>

  // Loading the sole top-level definition also invokes it on the configured
  // integer input. This is the entry-point convention of this semantics.
  rule <k> Module(FuncDef(_FN, Params(X), BODY)) => BODY </k>
       <input> N </input>
       <env> .Map => X |-> N </env>

  rule <k> Name(X) => Int(I) ...</k>
       <env>... X |-> I ...</env>

  rule BinOp("+",  Int(I), Int(J)) => Int(I +Int J)
  rule BinOp("-",  Int(I), Int(J)) => Int(I -Int J)
  rule BinOp("*",  Int(I), Int(J)) => Int(I *Int J)
  rule BinOp("//", Int(I), Int(J)) => Int(I divInt J)
    requires J =/=Int 0

  rule <k> Return(Int(I)) => .K </k>
       <result> noResult => result(I) </result>
endmodule
requires "semantic.k"

// Mathematical contract used to verify get_max_triples.
module VERIFICATION
  imports MPY

  // Number of unordered ways to choose three indices from a class of size X.
  syntax Int ::= choose3(Int) [function, total]
  rule choose3(X) => (X *Int (X -Int 1) *Int (X -Int 2)) divInt 6

  // For i >= 1, i*i-i+1 is 0 modulo 3 precisely when i is 2 modulo 3;
  // otherwise it is 1 modulo 3.  Hence a divisible sum contains either three
  // zero-residue entries or three one-residue entries.  Among 1..N the class
  // sizes are (N+1)//3 and N-(N+1)//3, respectively.
  syntax Int ::= validTripleCount(Int) [function, total]
  rule validTripleCount(N) =>
    choose3((N +Int 1) divInt 3)
    +Int choose3(N -Int ((N +Int 1) divInt 3))
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  claim
      <k>
        Module(FuncDef("get_max_triples", Params("n"),
          Return(
            BinOp("+",
              BinOp("//",
                BinOp("*",
                  BinOp("*",
                    BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
                    BinOp("-",
                      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
                      Int(1))),
                  BinOp("-",
                    BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
                    Int(2))),
                Int(6)),
              BinOp("//",
                BinOp("*",
                  BinOp("*",
                    BinOp("-", Name("n"),
                      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
                    BinOp("-",
                      BinOp("-", Name("n"),
                        BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
                      Int(1))),
                  BinOp("-",
                    BinOp("-", Name("n"),
                      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
                    Int(2))),
                Int(6))))))
        => .K
      </k>
      <input> N </input>
      <env> .Map => "n" |-> N </env>
      <result> noResult => result(validTripleCount(N)) </result>
    requires N >=Int 1
endmodule

