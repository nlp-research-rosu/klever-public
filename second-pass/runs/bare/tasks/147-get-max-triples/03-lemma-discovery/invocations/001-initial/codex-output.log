        assert entry['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}

assert Path('/workspace/DISCOVERY.md').is_file()
print(f'validated {len(actual_ids)} rules: exact order, exact coverage, unique IDs')
print('schema, inventory hash, entry keys, classifications, and rationales: PASS')
