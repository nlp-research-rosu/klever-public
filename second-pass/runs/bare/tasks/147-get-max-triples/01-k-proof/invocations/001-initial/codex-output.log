+def get_max_triples(n):
+    return (((n + 1) // 3) * (((n + 1) // 3) - 1) * (((n + 1) // 3) - 2) // 6
+            + (n - ((n + 1) // 3)) * (n - ((n + 1) // 3) - 1)
+            * (n - ((n + 1) // 3) - 2) // 6)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0818df034e54f6bb3805a0de3ebd6c4b4b3a0179
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim
+    <mpy>
+      <k>
+        Module(FuncDef("get_max_triples", Params("n"),
+          Return(
+            BinOp("+",
+              BinOp("//",
+                BinOp("*",
+                  BinOp("*",
+                    BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
+                    BinOp("-",
+                      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
+                      Int(1))),
+                  BinOp("-",
+                    BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
+                    Int(2))),
+                Int(6)),
+              BinOp("//",
+                BinOp("*",
+                  BinOp("*",
+                    BinOp("-", Name("n"),
+                      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
+                    BinOp("-",
+                      BinOp("-", Name("n"),
+                        BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
+                      Int(1))),
+                  BinOp("-",
+                    BinOp("-", Name("n"),
+                      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
+                    Int(2))),
+                Int(6)))))
+      </k>
+      <input> N </input>
+      <env> .Map </env>
+      <result> noResult </result>
+    </mpy>
+  =>
+    <mpy>
+      <k> .K </k>
+      <input> N </input>
+      <env> "n" |-> N </env>
+      <result> result(validTripleCount(N)) </result>
+    </mpy>
+    requires N >=Int 1
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..62fe00fb3d7985468530199a57758cab598a041e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,19 @@
+requires "semantic.k"
+
+// Mathematical contract used to verify get_max_triples.
+module VERIFICATION
+  imports MPY
+
+  // Number of unordered ways to choose three indices from a class of size X.
+  syntax Int ::= choose3(Int) [function, total]
+  rule choose3(X) => (X *Int (X -Int 1) *Int (X -Int 2)) divInt 6
+
+  // For i >= 1, i*i-i+1 is 0 modulo 3 precisely when i is 2 modulo 3;
+  // otherwise it is 1 modulo 3.  Hence a divisible sum contains either three
+  // zero-residue entries or three one-residue entries.  Among 1..N the class
+  // sizes are (N+1)//3 and N-(N+1)//3, respectively.
+  syntax Int ::= validTripleCount(Int) [function, total]
+  rule validTripleCount(N) =>
+    choose3((N +Int 1) divInt 3)
+    +Int choose3(N -Int ((N +Int 1) divInt 3))
+endmodule

