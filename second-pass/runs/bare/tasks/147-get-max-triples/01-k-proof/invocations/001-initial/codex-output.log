diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..88f8395afa8802bc18ccdfe04087b4f97ee20502
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,11 @@
+requires "semantic.k"
+
+// Mathematical contract used to verify get_max_triples.
+module VERIFICATION
+  imports MPY
+
+  // For i >= 1, i*i-i+1 is 0 modulo 3 precisely when i is 2 modulo 3;
+  // otherwise it is 1 modulo 3.  Hence a divisible sum contains either three
+  // zero-residue entries or three one-residue entries.  Among 1..N the class
+  // sizes are (N+1)//3 and N-(N+1)//3, respectively.
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..cc6ae1b895651bf32f1d00b8358b49a55e2ee939
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,102 @@
+// A deliberately small semantics for the exact Python subset used by solution.py.
+// The surface constructors are those emitted, without desugaring, by py2mpy.py.
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm
+  syntax Params
+  syntax Stmt
+  syntax Expr
+  syntax Value
+
+  syntax Pgm ::= "Module" "(" Stmt ")"
+  syntax Params ::= "Params" "(" String ")"
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmt ")"
+                | "Return" "(" Expr ")" [strict]
+  syntax Value ::= "Int" "(" Int ")"
+  syntax Expr ::= Value
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")" [strict(2,3)]
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports STRING
+  imports MAP
+
+  syntax KResult ::= Value
+
+  syntax Result ::= "noResult" | "result" "(" Int ")"
+
+  // A named, exact AST constant keeps proof claims readable. Its expansion is
+  // byte-for-byte the constructor term emitted in solution.mpy (ignoring
+  // whitespace), and solution.mpy itself is used by every concrete krun.
+  syntax Pgm ::= "getMaxTriplesProgram" [function, total]
+  rule getMaxTriplesProgram =>
+    Module(FuncDef("get_max_triples", Params("n"),
+      Return(
+        BinOp("+",
+          BinOp("//",
+            BinOp("*",
+              BinOp("*",
+                BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
+                BinOp("-",
+                  BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
+                  Int(1))),
+              BinOp("-",
+                BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
+                Int(2))),
+            Int(6)),
+          BinOp("//",
+            BinOp("*",
+              BinOp("*",
+                BinOp("-", Name("n"),
+                  BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
+                BinOp("-",
+                  BinOp("-", Name("n"),
+                    BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
+                  Int(1))),
+              BinOp("-",
+                BinOp("-", Name("n"),
+                  BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
+                Int(2))),
+            Int(6))))))
+
+  // Verification-side mathematical functions live in the compiled definition
+  // so that symbolic execution can normalize them on a claim's target side.
+  syntax Int ::= choose3(Int) [function, total]
+  rule choose3(X) => (X *Int (X -Int 1) *Int (X -Int 2)) divInt 6
+
+  syntax Int ::= validTripleCount(Int) [function, total]
+  rule validTripleCount(N) =>
+    choose3((N +Int 1) divInt 3)
+    +Int choose3(N -Int ((N +Int 1) divInt 3))
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm </k>
+      <input> $N:Int </input>
+      <env> .Map </env>
+      <result> noResult </result>
+    </mpy>
+
+  // Loading the sole top-level definition also invokes it on the configured
+  // integer input. This is the entry-point convention of this semantics.
+  rule <k> Module(FuncDef(_FN, Params(X), BODY)) => BODY </k>
+       <input> N </input>
+       <env> .Map => X |-> N </env>
+
+  rule <k> Name(X) => Int(I) ...</k>
+       <env>... X |-> I ...</env>
+
+  rule BinOp("+",  Int(I), Int(J)) => Int(I +Int J)
+  rule BinOp("-",  Int(I), Int(J)) => Int(I -Int J)
+  rule BinOp("*",  Int(I), Int(J)) => Int(I *Int J)
+  rule BinOp("//", Int(I), Int(J)) => Int(I divInt J)
+    requires J =/=Int 0
+
+  rule <k> Return(Int(I)) => .K </k>
+       <result> noResult => result(I) </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..1cd69592e9790d89a06c3bfcdc38d33f4ea2d587
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,4 @@
+def get_max_triples(n):
+    return (((n + 1) // 3) * (((n + 1) // 3) - 1) * (((n + 1) // 3) - 2) // 6
+            + (n - ((n + 1) // 3)) * (n - ((n + 1) // 3) - 1)
+            * (n - ((n + 1) // 3) - 2) // 6)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..fc63f31212294093ee70bf8bedaf71711ca7ca63
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,17 @@
+requires "semantic.k"
+
+module SPEC
+  imports MPY
+
+  claim
+      <k> getMaxTriplesProgram </k>
+      <input> N </input>
+      <env> .Map </env>
+      <result> noResult </result>
+  =>
+      <k> .K </k>
+      <input> N </input>
+      <env> "n" |-> N </env>
+      <result> result(validTripleCount(N)) </result>
+    requires N >=Int 1
+endmodule
