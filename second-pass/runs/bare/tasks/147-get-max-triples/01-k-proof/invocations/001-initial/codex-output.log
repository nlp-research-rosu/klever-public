+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm
+  syntax Params
+  syntax Stmt
+  syntax Expr
+  syntax Value
+
+  syntax Pgm ::= "Module" "(" Stmt ")"
+  syntax Params ::= "Params" "(" String ")"
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmt ")"
+                | "Return" "(" Expr ")" [strict]
+  syntax Value ::= "Int" "(" Int ")"
+  syntax Expr ::= Value
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")" [strict(2,3)]
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports STRING
+  imports MAP
+
+  syntax KResult ::= Value
+
+  syntax Result ::= "noResult" | "result" "(" Int ")"
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm </k>
+      <input> $N:Int </input>
+      <env> .Map </env>
+      <result> noResult </result>
+    </mpy>
