--- /dev/null
+++ b/verification.k
@@ -0,0 +1,11 @@
+requires "semantic.k"
+
+// Mathematical contract used to verify get_max_triples.
+module VERIFICATION
+  imports MPY
+
+  // For i >= 1, i*i-i+1 is 0 modulo 3 precisely when i is 2 modulo 3;
+  // otherwise it is 1 modulo 3.  Hence a divisible sum contains either three
+  // zero-residue entries or three one-residue entries.  Among 1..N the class
+  // sizes are (N+1)//3 and N-(N+1)//3, respectively.
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..c97daf1047d862ac2773d820a38e3f332135dae9
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,68 @@
+// A deliberately small semantics for the exact Python subset used by solution.py.
+// The surface constructors are those emitted, without desugaring, by py2mpy.py.
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm
+  syntax Params
+  syntax Stmt
+  syntax Expr
+  syntax Value
+
+  syntax Pgm ::= "Module" "(" Stmt ")"
+  syntax Params ::= "Params" "(" String ")"
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmt ")"
+                | "Return" "(" Expr ")" [strict]
+  syntax Value ::= "Int" "(" Int ")"
+  syntax Expr ::= Value
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")" [strict(2,3)]
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports STRING
+  imports MAP
+
+  syntax KResult ::= Value
+
+  syntax Result ::= "noResult" | "result" "(" Int ")"
+
+  // Verification-side mathematical functions live in the compiled definition
+  // so that symbolic execution can normalize them on a claim's target side.
+  syntax Int ::= choose3(Int) [function, total]
+  rule choose3(X) => (X *Int (X -Int 1) *Int (X -Int 2)) divInt 6
+
+  syntax Int ::= validTripleCount(Int) [function, total]
+  rule validTripleCount(N) =>
+    choose3((N +Int 1) divInt 3)
+    +Int choose3(N -Int ((N +Int 1) divInt 3))
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm </k>
+      <input> $N:Int </input>
+      <env> .Map </env>
+      <result> noResult </result>
+    </mpy>
+
+  // Loading the sole top-level definition also invokes it on the configured
+  // integer input. This is the entry-point convention of this semantics.
+  rule <k> Module(FuncDef(_FN, Params(X), BODY)) => BODY </k>
+       <input> N </input>
+       <env> .Map => X |-> N </env>
+
+  rule <k> Name(X) => Int(I) ...</k>
+       <env>... X |-> I ...</env>
+
+  rule BinOp("+",  Int(I), Int(J)) => Int(I +Int J)
+  rule BinOp("-",  Int(I), Int(J)) => Int(I -Int J)
+  rule BinOp("*",  Int(I), Int(J)) => Int(I *Int J)
+  rule BinOp("//", Int(I), Int(J)) => Int(I divInt J)
+    requires J =/=Int 0
+
+  rule <k> Return(Int(I)) => .K </k>
+       <result> noResult => result(I) </result>
+endmodule
