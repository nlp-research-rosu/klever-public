+      <k>
+        Module(FuncDef("get_max_triples", Params("n"),
+          Return(
+            BinOp("+",
+              BinOp("//",
+                BinOp("*",
+                  BinOp("*",
+                    BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
+                    BinOp("-",
+                      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
+                      Int(1))),
+                  BinOp("-",
+                    BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
+                    Int(2))),
+                Int(6)),
+              BinOp("//",
+                BinOp("*",
+                  BinOp("*",
+                    BinOp("-", Name("n"),
+                      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
+                    BinOp("-",
+                      BinOp("-", Name("n"),
+                        BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
+                      Int(1))),
+                  BinOp("-",
+                    BinOp("-", Name("n"),
+                      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
+                    Int(2))),
+                Int(6))))))
+      </k>
+      <input> N </input>
+      <env> .Map </env>
+      <result> noResult </result>
+  =>
+      <k> .K </k>
+      <input> N </input>
+      <env> "n" |-> N </env>
+      <result> result(validTripleCount(N)) </result>
+    requires N >=Int 1
+endmodule
