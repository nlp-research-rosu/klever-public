index 0000000000000000000000000000000000000000..1cd69592e9790d89a06c3bfcdc38d33f4ea2d587
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,4 @@
+def get_max_triples(n):
+    return (((n + 1) // 3) * (((n + 1) // 3) - 1) * (((n + 1) // 3) - 2) // 6
+            + (n - ((n + 1) // 3)) * (n - ((n + 1) // 3) - 1)
+            * (n - ((n + 1) // 3) - 2) // 6)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..8a6fca55e13820fa61e785c3affd3601826c167b
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,46 @@
+requires "semantic.k"
+
+module SPEC
+  imports MPY
+
+  claim
+      <k>
+        Module(FuncDef("get_max_triples", Params("n"),
+          Return(
+            BinOp("+",
+              BinOp("//",
+                BinOp("*",
+                  BinOp("*",
+                    BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
+                    BinOp("-",
+                      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
+                      Int(1))),
+                  BinOp("-",
+                    BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
+                    Int(2))),
+                Int(6)),
+              BinOp("//",
+                BinOp("*",
+                  BinOp("*",
+                    BinOp("-", Name("n"),
+                      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
+                    BinOp("-",
+                      BinOp("-", Name("n"),
+                        BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
+                      Int(1))),
+                  BinOp("-",
+                    BinOp("-", Name("n"),
+                      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
+                    Int(2))),
+                Int(6))))))
+      </k>
+      <input> N </input>
+      <env> .Map </env>
+      <result> noResult </result>
+  =>
+      <k> .K </k>
+      <input> N </input>
+      <env> "n" |-> N </env>
+      <result> result(validTripleCount(N)) </result>
+    requires N >=Int 1
+endmodule
