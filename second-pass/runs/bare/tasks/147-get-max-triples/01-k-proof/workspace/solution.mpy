                "-",
                BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
                Int(1))),
            BinOp(
              "-",
              BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
              Int(2))),
          Int(6)),
        BinOp(
          "//",
          BinOp(
            "*",
            BinOp(
              "*",
              BinOp(
                "-",
                Name("n"),
                BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
              BinOp(
                "-",
                BinOp(
