+        elif stat.S_ISREG(mode):
+            kind, content = b"file", path.read_bytes()
+        else:
+            raise AssertionError(f"linked or unsupported tree entry: {path}")
+        relative = path.relative_to(root).as_posix().encode()
+        for value in (relative, kind, content):
