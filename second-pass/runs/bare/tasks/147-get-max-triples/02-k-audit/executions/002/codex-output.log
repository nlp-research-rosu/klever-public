+def residue_oracle(n: int) -> int:
+    zeros = (n + 1) // 3
+    ones = n - zeros
+    return zeros * (zeros - 1) * (zeros - 2) // 6 + (
+        ones * (ones - 1) * (ones - 2) // 6
+    )
+
+
+large_inputs = [181, 999, 10**6, 10**18, 10**30]
+large_mismatches = [
+    (n, candidate(n), residue_oracle(n))
+    for n in large_inputs
+    if candidate(n) != residue_oracle(n)
+]
