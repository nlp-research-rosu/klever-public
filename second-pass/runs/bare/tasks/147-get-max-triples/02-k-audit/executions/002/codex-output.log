ires N >=Int 1\nendmodule\n"},"/work/verification.k":{"type":"add","content":"// Mathematical contract used to verify get_max_triples.\nmodule VERIFICATION\n  imports MPY\n\n  // Number of unordered ways to choose three indices from a class of size X.\n  syntax Int ::= choose3(Int) [function, total]\n  rule choose3(X) => (X *Int (X -Int 1) *Int (X -Int 2)) divInt 6\n\n  // For i >= 1, i*i-i+1 is 0 modulo 3 precisely when i is 2 modulo 3;\n  // otherwise it is 1 modulo 3.  Hence a divisible sum contains either three\n  // zero-residue entries or three one-residue entries.  Among 1..N the class\n  // sizes are (N+1)//3 and N-(N+1)//3, respectively.\n  syntax Int ::= validTripleCount(Int) [function, total]\n  rule validTripleCount(N) =>\n    choose3((N +Int 1) divInt 3)\n    +Int choose3(N -Int ((N +Int 1) divInt 3))\nendmodule\n"},"/work/semantic.k":{"type":"add","content":"// A deliberately small semantics for the exact Python subset used by solution.py.\n// The surface constructors are those emitted, without desugaring, by py2mpy.py.\nmodule MPY-SYNTAX\n  imports INT-SYNTAX\n  imports STRING-SYNTAX\n\n  syntax Pgm\n  syntax Params\n  syntax Stmt\n  syntax Expr\n\n  syntax Pgm ::= \"Module\" \"(\" Stmt \")\"\n  syntax Params ::= \"Params\" \"(\" String \")\"\n  syntax Stmt ::= \"FuncDef\" \"(\" String \",\" Params \",\" Stmt \")\"\n                | \"Return\" \"(\" Expr \")\"\n  syntax Expr ::= \"Int\" \"(\" Int \")\"\n                | \"Name\" \"(\" String \")\"\n                | \"BinOp\" \"(\" String \",\" Expr \",\" Expr \")\"\nendmodule\n\nmodule MPY\n  imports MPY-SYNTAX\n  imports INT\n  imports STRING\n  imports MAP\n\n  syntax Result ::= \"noResult\" | \"result\" \"(\" Int \")\"\n\n  configuration\n    <mpy>\n      <k> $PGM:Pgm </k>\n      <input> $N:Int </input>\n      <env> .Map </env>\n      <result> noResult </result>\n    </mpy>\n\n  // Loading the sole top-level definition also invokes it on the configured\n  // integer input. This is the entry-point convention of this semantics.\n  rule <k> Module(FuncDef(_FN, Params(X), BODY)) => BODY </k>\n       <input> N </input>\n       <env> .Map => X |-> N </env>\n\n  rule <k> Name(X) => Int(I) ...</k>\n       <env>... X |-> I ...</env>\n\n  syntax Expr ::= BinOp(String, Expr, Expr) [strict(2,3)]\n\n  rule BinOp(\"+\",  Int(I), Int(J)) => Int(I +Int J)\n  rule BinOp(\"-\",  Int(I), Int(J)) => Int(I -Int J)\n  rule BinOp(\"*\",  Int(I), Int(J)) => Int(I *Int J)\n  rule BinOp(\"//\", Int(I), Int(J)) => Int(I divInt J)\n    requires J =/=Int 0\n\n  syntax Stmt ::= Return(Expr) [strict]\n\n  rule <k> Return(Int(I)) => .K </k>\n       <result> noResult => result(I) </result>\nendmodule\n"}},"status":"completed"}}
