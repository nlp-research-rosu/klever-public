+    )
+    assert actual == expected
+
+candidate_pipeline = pipeline_tree_hash(Path("/candidate"))
+trace_pipeline = pipeline_tree_hash(Path("/generation-evidence/codex-trace"))
+candidate_launcher = launcher_tree_hash(Path("/candidate"))
