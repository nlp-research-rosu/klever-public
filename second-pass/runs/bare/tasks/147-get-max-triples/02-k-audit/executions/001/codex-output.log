+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,46 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Fresh reviewer mutation: the real program result is falsely required to
+  // be one greater than the original result-constraining postcondition.
+  claim
+      <k>
+        Module(FuncDef("get_max_triples", Params("n"),
+          Return(
+            BinOp("+",
+              BinOp("//",
+                BinOp("*",
+                  BinOp("*",
+                    BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
+                    BinOp("-",
+                      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
+                      Int(1))),
+                  BinOp("-",
+                    BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)),
+                    Int(2))),
+                Int(6)),
+              BinOp("//",
+                BinOp("*",
+                  BinOp("*",
+                    BinOp("-", Name("n"),
+                      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
+                    BinOp("-",
+                      BinOp("-", Name("n"),
+                        BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
+                      Int(1))),
+                  BinOp("-",
+                    BinOp("-", Name("n"),
+                      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3))),
+                    Int(2))),
+                Int(6))))))
+        => .K
+      </k>
+      <input> N </input>
+      <env> .Map => "n" |-> N </env>
+      <result>
+        noResult => result(validTripleCount(N) +Int 1)
+      </result>
+    requires N >=Int 1
+endmodule

exec
/bin/bash -lc 'set -o pipefail
bash /audit-output/evidence/run_stage4_adequacy.sh 2>&1 | tee /audit-output/evidence/stage4-adequacy.log
status=${PIPESTATUS[0]}
echo "script_exit_status=$status" | tee -a /audit-output/evidence/stage4-adequacy.log
exit "$status"' in /audit-output
