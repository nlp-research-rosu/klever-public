$ nl -ba /tmp/audit-work/audit147/verification.k
     1	requires "semantic.k"
     2	
     3	// Mathematical contract used to verify get_max_triples.
     4	module VERIFICATION
     5	  imports MPY
     6	
     7	  // Number of unordered ways to choose three indices from a class of size X.
     8	  syntax Int ::= choose3(Int) [function, total]
     9	  rule choose3(X) => (X *Int (X -Int 1) *Int (X -Int 2)) divInt 6
    10	
    11	  // For i >= 1, i*i-i+1 is 0 modulo 3 precisely when i is 2 modulo 3;
    12	  // otherwise it is 1 modulo 3.  Hence a divisible sum contains either three
    13	  // zero-residue entries or three one-residue entries.  Among 1..N the class
    14	  // sizes are (N+1)//3 and N-(N+1)//3, respectively.
    15	  syntax Int ::= validTripleCount(Int) [function, total]
    16	  rule validTripleCount(N) =>
    17	    choose3((N +Int 1) divInt 3)
    18	    +Int choose3(N -Int ((N +Int 1) divInt 3))
    19	endmodule
