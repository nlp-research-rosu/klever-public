     1	// A deliberately small semantics for the exact Python subset used by solution.py.
     2	// The surface constructors are those emitted, without desugaring, by py2mpy.py.
     3	module MPY-SYNTAX
     4	  imports INT-SYNTAX
     5	  imports STRING-SYNTAX
     6	
     7	  syntax Pgm
     8	  syntax Params
     9	  syntax Stmt
    10	  syntax Expr
    11	  syntax Value
    12	
    13	  syntax Pgm ::= "Module" "(" Stmt ")"
    14	  syntax Params ::= "Params" "(" String ")"
    15	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmt ")"
    16	                | "Return" "(" Expr ")" [strict]
    17	  syntax Value ::= "Int" "(" Int ")"
    18	  syntax Expr ::= Value
    19	                | "Name" "(" String ")"
    20	                | "BinOp" "(" String "," Expr "," Expr ")" [seqstrict(2,3)]
    21	endmodule
    22	
    23	module MPY
    24	  imports MPY-SYNTAX
    25	  imports INT
    26	  imports STRING
    27	  imports MAP
    28	
    29	  syntax KResult ::= Value
    30	
    31	  syntax Result ::= "noResult" | "result" "(" Int ")"
    32	
    33	  configuration
    34	    <mpy>
    35	      <k> $PGM:Pgm </k>
    36	      <input> $N:Int </input>
    37	      <env> .Map </env>
    38	      <result> noResult </result>
    39	    </mpy>
    40	
    41	  // Loading the sole top-level definition also invokes it on the configured
    42	  // integer input. This is the entry-point convention of this semantics.
    43	  rule <k> Module(FuncDef(_FN, Params(X), BODY)) => BODY </k>
    44	       <input> N </input>
    45	       <env> .Map => X |-> N </env>
    46	
    47	  rule <k> Name(X) => Int(I) ...</k>
    48	       <env>... X |-> I ...</env>
    49	
    50	  rule BinOp("+",  Int(I), Int(J)) => Int(I +Int J)
    51	  rule BinOp("-",  Int(I), Int(J)) => Int(I -Int J)
    52	  rule BinOp("*",  Int(I), Int(J)) => Int(I *Int J)
    53	  rule BinOp("//", Int(I), Int(J)) => Int(I divInt J)
    54	    requires J =/=Int 0
    55	
    56	  rule <k> Return(Int(I)) => .K </k>
    57	       <result> noResult => result(I) </result>
    58	endmodule
