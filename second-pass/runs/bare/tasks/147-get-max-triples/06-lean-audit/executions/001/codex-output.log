+        == observed["discovery_manifest_sha256"]
+        and export_result["generated_tree_sha256"]
+        == observed["generated_tree_sha256"]
+    ),
+    "recorded_preflight_hash_bindings_match": (
+        recorded_preflight["frozen_input_sha256"]
