+        and resolution["stage4_preflight"]["target"] is None
+        and klean_export.target_statement(GENERATED) is None
+    ),
+}
+
+document = {
+    "observed": observed,
+    "inventory": inventory,
+    "validated_stage3": validated,
+    "manifest_rule_ids": manifest_rule_ids,
+    "inventory_rule_ids": inventory_rule_ids,
