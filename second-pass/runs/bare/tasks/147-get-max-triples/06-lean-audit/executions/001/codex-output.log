+    "input_manifest_source_rules": input_manifest["source_rules"],
+    "obligation_map": obligation_map,
+    "checks": checks,
+    "all_checks_pass": all(checks.values()),
+}
+print(json.dumps(document, indent=2, sort_keys=True))
