+  AUDIT_MODE=CLASSIFICATION_ONLY PYTHONPATH=/reference LAKE_HOME=/opt/elan/toolchains/leanprover--lean4---v4.22.0/src/lean/lake LEAN_SYSROOT=/opt/elan/toolchains/leanprover--lean4---v4.22.0 LAKE_OVERRIDE_LEAN=true LD_PRELOAD=/tmp/audit-work/proc_exe_compat.so python3 /audit-output/evidence/run_preflight_compare.py
