from __future__ import annotations

import hashlib
import json
import re
from typing import Any


SCHEMA_VERSION = 4
RESOLUTION_KEYS = frozenset(
    {
        "schema_version",
        "run_id",
        "problem_id",
        "condition",
        "mode",
        "semantics_mode",
        "k_workspace",
        "k_audit",
        "discovery_manifest",
        "klean_generation",
        "generation_producer_sources",
        "lean_workspace",
        "lean_invocation",
        "target",
        "stage1_source_hashes",
        "trust_inventory",
        "hashes",
        "selections",
        "stage4_preflight",
        "stage5_result",
    }
