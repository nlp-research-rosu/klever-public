+def is_equal_to_sum_even(n):
+    return n >= 8 and n % 2 == 0
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c0a35b5ab9e73412e73d8be421163cf583c562f0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,107 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The implementation computes the contract characterization for every Int.
+  claim
+    <k> Module(
+          FuncDef("is_equal_to_sum_even", Params("n"),
+            Return(
+              BoolOp("and",
+                Compare(Name("n"), CmpOp(">=", Int(8))),
+                Compare(BinOp("%", Name("n"), Int(2)),
+                        CmpOp("==", Int(0)))))))
+      </k>
+    <input> N:Int </input>
+    <result> noResult </result>
+  =>
+    <k> .K </k>
+    <input> N </input>
+    <result> BoolValue(sumFourPositiveEvens(N)) </result>
+
+  // Necessity: any sum of four positive evens is accepted.
+  claim
+    <k> Module(
+          FuncDef("is_equal_to_sum_even", Params("n"),
+            Return(
+              BoolOp("and",
+                Compare(Name("n"), CmpOp(">=", Int(8))),
+                Compare(BinOp("%", Name("n"), Int(2)),
+                        CmpOp("==", Int(0)))))))
+      </k>
+    <input> A:Int +Int B:Int +Int C:Int +Int D:Int </input>
+    <result> noResult </result>
+  =>
+    <k> .K </k>
+    <input> A +Int B +Int C +Int D </input>
+    <result> BoolValue(true) </result>
+  requires A >Int 0 andBool A %Int 2 ==Int 0
+       andBool B >Int 0 andBool B %Int 2 ==Int 0
+       andBool C >Int 0 andBool C %Int 2 ==Int 0
+       andBool D >Int 0 andBool D %Int 2 ==Int 0
+
+  // Sufficiency: these explicit witnesses establish the "exactly 4" part.
+  claim
+    <k> .K </k>
+    <input> N:Int </input>
+    <result> BoolValue(true) </result>
+  =>
+    <k> .K </k>
+    <input> N </input>
+    <result> BoolValue(true) </result>
+  requires sumFourPositiveEvens(N)
+  ensures N -Int 6 >Int 0
+      andBool (N -Int 6) %Int 2 ==Int 0
+      andBool 2 >Int 0 andBool 2 %Int 2 ==Int 0
+      andBool (N -Int 6) +Int 2 +Int 2 +Int 2 ==Int N
+
+  // Prompt examples, retained as independently executable proof targets.
+  claim
+    <k> Module(
+          FuncDef("is_equal_to_sum_even", Params("n"),
+            Return(
+              BoolOp("and",
+                Compare(Name("n"), CmpOp(">=", Int(8))),
+                Compare(BinOp("%", Name("n"), Int(2)),
+                        CmpOp("==", Int(0)))))))
+      </k>
+    <input> 4 </input>
+    <result> noResult </result>
+  =>
+    <k> .K </k>
+    <input> 4 </input>
+    <result> BoolValue(false) </result>
+
+  claim
+    <k> Module(
+          FuncDef("is_equal_to_sum_even", Params("n"),
+            Return(
+              BoolOp("and",
+                Compare(Name("n"), CmpOp(">=", Int(8))),
+                Compare(BinOp("%", Name("n"), Int(2)),
+                        CmpOp("==", Int(0)))))))
+      </k>
+    <input> 6 </input>
+    <result> noResult </result>
+  =>
+    <k> .K </k>
+    <input> 6 </input>
+    <result> BoolValue(false) </result>
+
+  claim
+    <k> Module(
+          FuncDef("is_equal_to_sum_even", Params("n"),
+            Return(
+              BoolOp("and",
+                Compare(Name("n"), CmpOp(">=", Int(8))),
+                Compare(BinOp("%", Name("n"), Int(2)),
+                        CmpOp("==", Int(0)))))))
+      </k>
+    <input> 8 </input>
+    <result> noResult </result>
+  =>
+    <k> .K </k>
+    <input> 8 </input>
+    <result> BoolValue(true) </result>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..50ae44f790f682010de877aa31508954c02add4d
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,12 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Arithmetic characterization of being a sum of four positive even
+  // integers.  The reverse direction has the constructive witnesses
+  // N - 6, 2, 2, 2; SPEC proves that these really meet the original wording.
+  syntax Bool ::= sumFourPositiveEvens(Int) [function, total]
+  rule sumFourPositiveEvens(N)
+    => N >=Int 8 andBool N %Int 2 ==Int 0
+endmodule

exec
