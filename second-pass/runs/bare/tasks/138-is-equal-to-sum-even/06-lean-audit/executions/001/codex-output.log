+    tree_checks["generated_tree_sha256"],
+)
+require_equal(
+    "export-result trust-inventory hash",
+    export_result["trust_inventory_sha256"],
+    file_sha256(GENERATION / "trust-inventory.json"),
+)
+require_equal(
+    "generator toolchain lock",
