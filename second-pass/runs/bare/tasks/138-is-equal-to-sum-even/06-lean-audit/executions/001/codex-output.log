--- /dev/null
+++ b//tmp/audit-work/readlink-self.c
@@ -0,0 +1,14 @@
+#include <stdio.h>
+#include <unistd.h>
+
+int main(void) {
+    char buf[4096];
+    ssize_t n = readlink("/proc/self/exe", buf, sizeof(buf) - 1);
+    if (n < 0) {
+        perror("readlink");
+        return 1;
+    }
+    buf[n] = '\0';
+    puts(buf);
+    return 0;
+}
