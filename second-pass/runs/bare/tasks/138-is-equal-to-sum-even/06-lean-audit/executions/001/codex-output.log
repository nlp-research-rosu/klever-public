+    "klean_export.py": file_sha256(PRODUCERS / "klean_export.py"),
+}
+require_equal("producer hashes vs source manifest", producer_hashes, source_manifest["files"])
+require_equal(
+    "klean.py hash vs generator manifest",
+    producer_hashes["klean.py"],
