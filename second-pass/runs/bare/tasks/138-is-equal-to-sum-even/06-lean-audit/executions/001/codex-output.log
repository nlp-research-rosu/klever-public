+)
+print(f"OK signed audit-input envelope: {resolved_digest}")
+require_equal(
+    "launcher audit-input copy",
+    file_sha256(Path("/audit-output/audit-input.json")),
+    file_sha256(AUDIT_INPUT),
+)
