index 0000000000000000000000000000000000000000..96fa1729fa0b172c08fc7e8707fbd560a53a5d8e
--- /dev/null
+++ b//tmp/audit-work/lean-launcher.c
@@ -0,0 +1,12 @@
+/*
+ * The mounted Lean 4.22 `bin/lean` jumps directly to lean_main without
+ * registering argv first, so IO.appPath fails.  This local launcher supplies
+ * the missing runtime setup and then delegates to the pinned compiler.
+ */
+extern void lean_setup_args(int argc, char **argv);
+extern int lean_main(int argc, char **argv);
+
+int main(int argc, char **argv) {
+    lean_setup_args(argc, argv);
+    return lean_main(argc, argv);
+}
