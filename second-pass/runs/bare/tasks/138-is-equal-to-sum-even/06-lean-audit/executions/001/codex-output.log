+
+
+def logged_run(
+    command: list[str],
+    *,
+    cwd: Path,
+    timeout: int,
+) -> tuple[int, str]:
+    print(f"RUN cwd={cwd} timeout={timeout}: {' '.join(command)}", flush=True)
+    try:
+        result = subprocess.run(
