const patch = "*** Begin Patch\n*** Add File: /work/solution.py\n+def is_equal_to_sum_even(n):\n+    return n >= 8 and n % 2 == 0\n*** Add File: /work/semantic.k\n+requires \"domains.k\"\n+\n+module MPY-SYNTAX\n+  imports INT-SYNTAX\n+  imports BOOL-SYNTAX\n+  imports STRING-SYNTAX\n+\n+  syntax Program ::= \"Module\" \"(\" Stmt \")\" [symbol(module)]\n+\n+  syntax Stmt ::= \"FuncDef\" \"(\" String \",\" Params \",\" Stmt \")\"\n+                  [symbol(funcDef)]\n+                | \"Return\" \"(\" Expr \")\" [symbol(returnStmt)]\n+\n+  syntax Params ::= \"Params\" \"(\" String \")\" [symbol(params)]\n+\n+  syntax Expr ::= \"Name\" \"(\" String \")\" [symbol(name)]\n+                | \"Int\" \"(\" Int \")\" [symbol(intExpr)]\n+                | \"BinOp\" \"(\" String \",\" Expr \",\" Expr \")\"\n+                  [symbol(binOp)]\n+                | \"BoolOp\" \"(\" String \",\" Expr \",\" Expr \")\"\n+                  [symbol(boolOp)]\n+                | \"Compare\" \"(\" Expr \",\" CmpOp \")\"\n+                  [symbol(compare)]\n+\n+  syntax CmpOp ::= \"CmpOp\" \"(\" String \",\" Expr \")\" [symbol(cmpOp)]\n+\n+  syntax Value ::= IntValue(Int) | BoolValue(Bool)\n+  syntax Result ::= \"noResult\" | Value\n+endmodule\n+\n+module MPY\n+  imports MPY-SYNTAX\n+  imports INT\n+  imports BOOL\n+\n+  configuration\n+    <mpy>\n+      <k> $PGM:Program </k>\n+      <input> $N:Int </input>\n+      <result> noResult </result>\n+    </mpy>\n+\n+  // The submitted module contains the requested entry point.  Loading the\n+  // module invokes that entry point with the integer in <input>.\n+  rule <k> Module(FuncDef(\"is_equal_to_sum_even\", Params(X), Return(E)))\n+         => .K\n+       </k>\n+       <input> N </input>\n+       <result> noResult => eval(E, X, N) </result>\n+\n+  syntax Value ::= eval(Expr, String, Int) [function]\n+                 | evalBin(String, Value, Value) [function]\n+                 | evalCompare(Value, String, Value) [function]\n+                 | evalBool(String, Value, Value) [function]\n+\n+  rule eval(Name(X), X, N) => IntValue(N)\n+  rule eval(Int(I), _, _) => IntValue(I)\n+\n+  rule eval(BinOp(OP, L, R), X, N)\n+    => evalBin(OP, eval(L, X, N), eval(R, X, N))\n+  rule evalBin(\"%\", IntValue(I), IntValue(J)) => IntValue(I %Int J)\n+    requires J =/=Int 0\n+\n+  rule eval(Compare(L, CmpOp(OP, R)), X, N)\n+    => evalCompare(eval(L, X, N), OP, eval(R, X, N))\n+  rule evalCompare(\">=\", IntValue(I), IntValue(J))\n+    => BoolValue(I >=Int J)\n+  rule evalCompare(\"==\", IntValue(I), IntValue(J))\n+    => BoolValue(I ==Int J)\n+\n+  rule eval(BoolOp(OP, L, R), X, N)\n+    => evalBool(OP, eval(L, X, N), eval(R, X, N))\n+  rule evalBool(\"and\", BoolValue(B1), BoolValue(B2))\n+    => BoolValue(B1 andBool B2)\n+endmodule\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module VERIFICATION\n+  imports MPY\n+\n+  // Arithmetic characterization of being a sum of four positive even\n+  // integers.  The reverse direction has the constructive witnesses\n+  // N - 6, 2, 2, 2; SPEC proves that these really meet the original wording.\n+  syntax Bool ::= sumFourPositiveEvens(Int) [function, total]\n+  rule sumFourPositiveEvens(N)\n+    => N >=Int 8 andBool N %Int 2 ==Int 0\n+endmodule\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module SPEC\n+  imports VERIFICATION\n+\n+  // The implementation computes the contract characterization for every Int.\n+  claim\n+    <k> Module(\n+          FuncDef(\"is_equal_to_sum_even\", Params(\"n\"),\n+            Return(\n+              BoolOp(\"and\",\n+                Compare(Name(\"n\"), CmpOp(\">=\", Int(8))),\n+                Compare(BinOp(\"%\", Name(\"n\"), Int(2)),\n+                        CmpOp(\"==\", Int(0)))))))\n+      </k>\n+    <input> N:Int </input>\n+    <result> noResult </result>\n+  =>\n+    <k> .K </k>\n+    <input> N </input>\n+    <result> BoolValue(sumFourPositiveEvens(N)) </result>\n+\n+  // Necessity: any sum of four positive evens is accepted.\n+  claim\n+    <k> Module(\n+          FuncDef(\"is_equal_to_sum_even\", Params(\"n\"),\n+            Return(\n+              BoolOp(\"and\",\n+                Compare(Name(\"n\"), CmpOp(\">=\", Int(8))),\n+                Compare(BinOp(\"%\", Name(\"n\"), Int(2)),\n+                        CmpOp(\"==\", Int(0)))))))\n+      </k>\n+    <input> A:Int +Int B:Int +Int C:Int +Int D:Int </input>\n+    <result> noResult </result>\n+  =>\n+    <k> .K </k>\n+    <input> A +Int B +Int C +Int D </input>\n+    <result> BoolValue(true) </result>\n+  requires A >Int 0 andBool A %Int 2 ==Int 0\n+       andBool B >Int 0 andBool B %Int 2 ==Int 0\n+       andBool C >Int 0 andBool C %Int 2 ==Int 0\n+       andBool D >Int 0 andBool D %Int 2 ==Int 0\n+\n+  // Sufficiency: these explicit witnesses establish the \"exactly 4\" part.\n+  claim\n+    <k> .K </k>\n+    <input> N:Int </input>\n+    <result> BoolValue(true) </result>\n+  =>\n+    <k> .K </k>\n+    <input> N </input>\n+    <result> BoolValue(true) </result>\n+  requires sumFourPositiveEvens(N)\n+  ensures N -Int 6 >Int 0\n+      andBool (N -Int 6) %Int 2 ==Int 0\n+      andBool 2 >Int 0 andBool 2 %Int 2 ==Int 0\n+      andBool (N -Int 6) +Int 2 +Int 2 +Int 2 ==Int N\n+\n+  // Prompt examples, retained as independently executable proof targets.\n+  claim\n+    <k> Module(\n+          FuncDef(\"is_equal_to_sum_even\", Params(\"n\"),\n+            Return(\n+              BoolOp(\"and\",\n+                Compare(Name(\"n\"), CmpOp(\">=\", Int(8))),\n+                Compare(BinOp(\"%\", Name(\"n\"), Int(2)),\n+                        CmpOp(\"==\", Int(0)))))))\n+      </k>\n+    <input> 4 </input>\n+    <result> noResult </result>\n+  =>\n+    <k> .K </k>\n+    <input> 4 </input>\n+    <result> BoolValue(false) </result>\n+\n+  claim\n+    <k> Module(\n+          FuncDef(\"is_equal_to_sum_even\", Params(\"n\"),\n+            Return(\n+              BoolOp(\"and\",\n+                Compare(Name(\"n\"), CmpOp(\">=\", Int(8))),\n+                Compare(BinOp(\"%\", Name(\"n\"), Int(2)),\n+                        CmpOp(\"==\", Int(0)))))))\n+      </k>\n+    <input> 6 </input>\n+    <result> noResult </result>\n+  =>\n+    <k> .K </k>\n+    <input> 6 </input>\n+    <result> BoolValue(false) </result>\n+\n+  claim\n+    <k> Module(\n+          FuncDef(\"is_equal_to_sum_even\", Params(\"n\"),\n+            Return(\n+              BoolOp(\"and\",\n+                Compare(Name(\"n\"), CmpOp(\">=\", Int(8))),\n+                Compare(BinOp(\"%\", Name(\"n\"), Int(2)),\n+                        CmpOp(\"==\", Int(0)))))))\n+      </k>\n+    <input> 8 </input>\n+    <result> noResult </result>\n+  =>\n+    <k> .K </k>\n+    <input> 8 </input>\n+    <result> BoolValue(true) </result>\n+endmodule\n*** End Patch";
