for include_dirs, content_mode, path_end, kind_mode, file_end in itertools.product([False,True],['raw','hex','binary'],[b'',b'\\0',b'\\n'],['none','word0','letter0','mode'],[b'',b'\\0',b'\\n']):
    ok=[]
    for root,want in cases:
        h=hashlib.sha256(); entries=sorted(root.rglob('*'),key=lambda p:p.relative_to(root).as_posix())
        for p in entries:
            if p.is_dir() and not include_dirs: continue
            rel=p.relative_to(root).as_posix().encode(); h.update(rel); h.update(path_end)
            if kind_mode=='word0': h.update((b'directory' if p.is_dir() else b'file')+b'\\0')
            elif kind_mode=='letter0': h.update((b'd' if p.is_dir() else b'f')+b'\\0')
            elif kind_mode=='mode': h.update(str(p.lstat().st_mode).encode()+b'\\0')
            if p.is_file():
                data=p.read_bytes()
                if content_mode=='raw': h.update(data)
                elif content_mode=='hex': h.update(hashlib.sha256(data).hexdigest().encode())
                else: h.update(hashlib.sha256(data).digest())
                h.update(file_end)
        ok.append(h.hexdigest()==want)
    if all(ok): print('MATCH BOTH',include_dirs,content_mode,path_end,kind_mode,file_end)
    elif any(ok): print('MATCH ONE',ok,include_dirs,content_mode,path_end,kind_mode,file_end)
