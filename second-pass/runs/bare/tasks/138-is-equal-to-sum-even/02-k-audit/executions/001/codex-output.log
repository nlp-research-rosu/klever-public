    32	  imports MPY-SYNTAX
    33	  imports INT
    34	  imports BOOL
    35	
    36	  configuration
    37	    <mpy>
    38	      <k> $PGM:Program </k>
    39	      <input> $N:Int </input>
    40	      <result> noResult </result>
    41	    </mpy>
    42	
    43	  // The submitted module contains the requested entry point.  Loading the
    44	  // module invokes that entry point with the integer in <input>.
    45	  rule <k> Module(FuncDef("is_equal_to_sum_even", Params(X), Return(E)))
    46	         => .K
    47	       </k>
    48	       <input> N </input>
    49	       <result> noResult => eval(E, X, N) </result>
    50	
    51	  syntax Value ::= eval(Expr, String, Int) [function]
    52	                 | evalBin(String, Value, Value) [function]
    53	                 | evalCompare(Value, String, Value) [function]
    54	                 | evalBool(String, Value, Value) [function]
    55	
    56	  rule eval(Name(X), X, N) => IntValue(N)
    57	  rule eval(Int(I), _, _) => IntValue(I)
    58	
    59	  rule eval(BinOp(OP, L, R), X, N)
    60	    => evalBin(OP, eval(L, X, N), eval(R, X, N))
    61	  rule evalBin("%", IntValue(I), IntValue(J)) => IntValue(I %Int J)
    62	    requires J =/=Int 0
    63	
    64	  rule eval(Compare(L, CmpOp(OP, R)), X, N)
    65	    => evalCompare(eval(L, X, N), OP, eval(R, X, N))
    66	  rule evalCompare(IntValue(I), ">=", IntValue(J))
    67	    => BoolValue(I >=Int J)
    68	  rule evalCompare(IntValue(I), "==", IntValue(J))
    69	    => BoolValue(I ==Int J)
    70	
    71	  rule eval(BoolOp(OP, L, R), X, N)
    72	    => evalBool(OP, eval(L, X, N), eval(R, X, N))
    73	  rule evalBool("and", BoolValue(B1), BoolValue(B2))
    74	    => BoolValue(B1 andBool B2)
    75	endmodule
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Arithmetic characterization of being a sum of four positive even
     7	  // integers.  The reverse direction has the constructive witnesses
     8	  // N - 6, 2, 2, 2; SPEC proves that these really meet the original wording.
     9	  syntax Bool ::= sumFourPositiveEvens(Int) [function, total]
    10	  rule sumFourPositiveEvens(N)
    11	    => N >=Int 8 andBool N %Int 2 ==Int 0
    12	
    13	  syntax Bool ::= canonicalWitnessesAreValid(Int) [function, total]
    14	  rule canonicalWitnessesAreValid(N)
    15	    => N -Int 6 >Int 0
    16	       andBool (N -Int 6) %Int 2 ==Int 0
    17	       andBool 2 >Int 0 andBool 2 %Int 2 ==Int 0
    18	       andBool (N -Int 6) +Int 2 +Int 2 +Int 2 ==Int N
    19	
    20	  syntax KItem ::= checkCanonicalWitnesses(Int)
    21	  rule <k> checkCanonicalWitnesses(N) => .K </k>
    22	       <result> noResult => BoolValue(canonicalWitnessesAreValid(N)) </result>
    23	endmodule
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // The implementation computes the contract characterization for every Int.
     7	  claim
     8	    <k> Module(
     9	          FuncDef("is_equal_to_sum_even", Params("n"),
    10	            Return(
    11	              BoolOp("and",
    12	                Compare(Name("n"), CmpOp(">=", Int(8))),
    13	                Compare(BinOp("%", Name("n"), Int(2)),
    14	                        CmpOp("==", Int(0))))))) => .K
    15	      </k>
    16	    <input> N:Int </input>
    17	    <result> noResult => BoolValue(sumFourPositiveEvens(N)) </result>
    18	
    19	  // Necessity: any sum of four positive evens is accepted.
    20	  claim
    21	    <k> Module(
    22	          FuncDef("is_equal_to_sum_even", Params("n"),
    23	            Return(
    24	              BoolOp("and",
    25	                Compare(Name("n"), CmpOp(">=", Int(8))),
    26	                Compare(BinOp("%", Name("n"), Int(2)),
    27	                        CmpOp("==", Int(0))))))) => .K
    28	      </k>
    29	    <input> A:Int +Int B:Int +Int C:Int +Int D:Int </input>
    30	    <result> noResult => BoolValue(true) </result>
    31	  requires A >Int 0 andBool A %Int 2 ==Int 0
    32	       andBool B >Int 0 andBool B %Int 2 ==Int 0
    33	       andBool C >Int 0 andBool C %Int 2 ==Int 0
    34	       andBool D >Int 0 andBool D %Int 2 ==Int 0
    35	
    36	  // Sufficiency: these explicit witnesses establish the "exactly 4" part.
    37	  claim
    38	    <k> checkCanonicalWitnesses(N) => .K </k>
    39	    <input> N:Int </input>
    40	    <result> noResult => BoolValue(true) </result>
    41	  requires sumFourPositiveEvens(N)
    42	
    43	  // Prompt examples, retained as independently executable proof targets.
    44	  claim
    45	    <k> Module(
    46	          FuncDef("is_equal_to_sum_even", Params("n"),
    47	            Return(
    48	              BoolOp("and",
    49	                Compare(Name("n"), CmpOp(">=", Int(8))),
    50	                Compare(BinOp("%", Name("n"), Int(2)),
    51	                        CmpOp("==", Int(0))))))) => .K
    52	      </k>
    53	    <input> 4 </input>
    54	    <result> noResult => BoolValue(false) </result>
    55	
    56	  claim
    57	    <k> Module(
    58	          FuncDef("is_equal_to_sum_even", Params("n"),
    59	            Return(
    60	              BoolOp("and",
    61	                Compare(Name("n"), CmpOp(">=", Int(8))),
    62	                Compare(BinOp("%", Name("n"), Int(2)),
    63	                        CmpOp("==", Int(0))))))) => .K
    64	      </k>
    65	    <input> 6 </input>
    66	    <result> noResult => BoolValue(false) </result>
    67	
    68	  claim
    69	    <k> Module(
    70	          FuncDef("is_equal_to_sum_even", Params("n"),
    71	            Return(
    72	              BoolOp("and",
    73	                Compare(Name("n"), CmpOp(">=", Int(8))),
    74	                Compare(BinOp("%", Name("n"), Int(2)),
    75	                        CmpOp("==", Int(0))))))) => .K
    76	      </k>
    77	    <input> 8 </input>
    78	    <result> noResult => BoolValue(true) </result>
    79	endmodule
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd "$(dirname "$0")"
     5	
     6	python3 py2mpy.py solution.py > solution.mpy
     7	
     8	kompile semantic.k \
     9	  --backend haskell \
    10	  --main-module MPY \
    11	  --syntax-module MPY-SYNTAX
    12	
    13	# Exercise all examples from prompt.py through the semantics.
    14	krun solution.mpy --definition semantic-kompiled -cN=4
    15	krun solution.mpy --definition semantic-kompiled -cN=6
    16	krun solution.mpy --definition semantic-kompiled -cN=8
    17	
