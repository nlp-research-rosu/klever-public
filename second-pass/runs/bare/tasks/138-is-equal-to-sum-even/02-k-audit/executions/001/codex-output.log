diff --git a//tmp/audit-work/review-138/candidate-src/spec-labeled.k b//tmp/audit-work/review-138/candidate-src/spec-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..31b9ccb93d9126327b42777700cb184f31cb6144
--- /dev/null
+++ b//tmp/audit-work/review-138/candidate-src/spec-labeled.k
@@ -0,0 +1,75 @@
+requires "verification.k"
+
+module SPEC-LABELED
+  imports VERIFICATION
+
+  claim [entry-general]:
+    <k> Module(
+          FuncDef("is_equal_to_sum_even", Params("n"),
+            Return(
+              BoolOp("and",
+                Compare(Name("n"), CmpOp(">=", Int(8))),
+                Compare(BinOp("%", Name("n"), Int(2)),
+                        CmpOp("==", Int(0))))))) => .K
+      </k>
+    <input> N:Int </input>
+    <result> noResult => BoolValue(sumFourPositiveEvens(N)) </result>
+
+  claim [necessity-four-summands]:
+    <k> Module(
+          FuncDef("is_equal_to_sum_even", Params("n"),
+            Return(
+              BoolOp("and",
+                Compare(Name("n"), CmpOp(">=", Int(8))),
+                Compare(BinOp("%", Name("n"), Int(2)),
+                        CmpOp("==", Int(0))))))) => .K
+      </k>
+    <input> A:Int +Int B:Int +Int C:Int +Int D:Int </input>
+    <result> noResult => BoolValue(true) </result>
+  requires A >Int 0 andBool A %Int 2 ==Int 0
+       andBool B >Int 0 andBool B %Int 2 ==Int 0
+       andBool C >Int 0 andBool C %Int 2 ==Int 0
+       andBool D >Int 0 andBool D %Int 2 ==Int 0
+
+  claim [sufficiency-witnesses]:
+    <k> checkCanonicalWitnesses(N) => .K </k>
+    <input> N:Int </input>
+    <result> noResult => BoolValue(true) </result>
+  requires sumFourPositiveEvens(N)
+
