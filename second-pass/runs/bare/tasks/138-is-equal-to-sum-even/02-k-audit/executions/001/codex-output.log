+  printf '\n'
+  set +e
+  "$@"
+  status=$?
+  set -e
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+run_allow_nonzero() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  set +e
+  "$@"
+  status=$?
+  set -e
+  printf '[exit %d; nonzero allowed for absence check]\n' "$status"
+}
+
+set -e
