+
+  syntax Value ::= IntValue(Int) | BoolValue(Bool)
+  syntax Result ::= "noResult" | Value
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+
+  configuration
+    <mpy>
+      <k> $PGM:Program </k>
+      <input> $N:Int </input>
+      <result> noResult </result>
+    </mpy>
