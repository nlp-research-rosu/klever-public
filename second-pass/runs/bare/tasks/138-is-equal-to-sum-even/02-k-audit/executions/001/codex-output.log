+#!/usr/bin/env bash
+set -u
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  set +e
+  "$@"
+  status=$?
+  set -e
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+set -e
+
+run python3 /tmp/audit-work/review-138/reference-src/py2mpy.py \
+  /tmp/audit-work/review-138/candidate-src/solution.py
+
