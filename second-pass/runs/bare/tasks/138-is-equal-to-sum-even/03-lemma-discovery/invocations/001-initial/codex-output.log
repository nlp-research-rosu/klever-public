#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

python3 py2mpy.py solution.py > solution.mpy

kompile semantic.k \
  --backend haskell \
  --main-module MPY \
  --syntax-module MPY-SYNTAX

# Exercise all examples from prompt.py through the semantics.
krun solution.mpy --definition semantic-kompiled -cN=4
krun solution.mpy --definition semantic-kompiled -cN=6
krun solution.mpy --definition semantic-kompiled -cN=8

# Compile the verification abstraction into the proof definition, then prove
# every claim in spec.k.  Success prints #Top and exits zero.
kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC
requires "domains.md"

module MPY-SYNTAX
  imports INT-SYNTAX
  imports BOOL-SYNTAX
  imports STRING-SYNTAX

  syntax Program ::= "Module" "(" Stmt ")" [symbol(module)]

  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmt ")"
                  [symbol(funcDef)]
                | "Return" "(" Expr ")" [symbol(returnStmt)]

  syntax Params ::= "Params" "(" String ")" [symbol(params)]

  syntax Expr ::= "Name" "(" String ")" [symbol(name)]
                | "Int" "(" Int ")" [symbol(intExpr)]
                | "BinOp" "(" String "," Expr "," Expr ")"
                  [symbol(binOp)]
                | "BoolOp" "(" String "," Expr "," Expr ")"
                  [symbol(boolOp)]
                | "Compare" "(" Expr "," CmpOp ")"
                  [symbol(compare)]

  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol(cmpOp)]

  syntax Value ::= IntValue(Int) | BoolValue(Bool)
  syntax Result ::= "noResult" | Value
endmodule

module MPY
  imports MPY-SYNTAX
  imports INT
  imports BOOL

  configuration
    <mpy>
      <k> $PGM:Program </k>
      <input> $N:Int </input>
      <result> noResult </result>
    </mpy>

  // The submitted module contains the requested entry point.  Loading the
  // module invokes that entry point with the integer in <input>.
  rule <k> Module(FuncDef("is_equal_to_sum_even", Params(X), Return(E)))
         => .K
       </k>
       <input> N </input>
       <result> noResult => eval(E, X, N) </result>

  syntax Value ::= eval(Expr, String, Int) [function]
                 | evalBin(String, Value, Value) [function]
                 | evalCompare(Value, String, Value) [function]
                 | evalBool(String, Value, Value) [function]

  rule eval(Name(X), X, N) => IntValue(N)
  rule eval(Int(I), _, _) => IntValue(I)

  rule eval(BinOp(OP, L, R), X, N)
    => evalBin(OP, eval(L, X, N), eval(R, X, N))
  rule evalBin("%", IntValue(I), IntValue(J)) => IntValue(I %Int J)
    requires J =/=Int 0

  rule eval(Compare(L, CmpOp(OP, R)), X, N)
    => evalCompare(eval(L, X, N), OP, eval(R, X, N))
  rule evalCompare(IntValue(I), ">=", IntValue(J))
    => BoolValue(I >=Int J)
  rule evalCompare(IntValue(I), "==", IntValue(J))
    => BoolValue(I ==Int J)

  rule eval(BoolOp(OP, L, R), X, N)
    => evalBool(OP, eval(L, X, N), eval(R, X, N))
  rule evalBool("and", BoolValue(B1), BoolValue(B2))
    => BoolValue(B1 andBool B2)
endmodule
requires "semantic.k"

module VERIFICATION
  imports MPY

  // Arithmetic characterization of being a sum of four positive even
  // integers.  The reverse direction has the constructive witnesses
  // N - 6, 2, 2, 2; SPEC proves that these really meet the original wording.
  syntax Bool ::= sumFourPositiveEvens(Int) [function, total]
  rule sumFourPositiveEvens(N)
    => N >=Int 8 andBool N %Int 2 ==Int 0

  syntax Bool ::= canonicalWitnessesAreValid(Int) [function, total]
  rule canonicalWitnessesAreValid(N)
    => N -Int 6 >Int 0
       andBool (N -Int 6) %Int 2 ==Int 0
       andBool 2 >Int 0 andBool 2 %Int 2 ==Int 0
       andBool (N -Int 6) +Int 2 +Int 2 +Int 2 ==Int N

  syntax KItem ::= checkCanonicalWitnesses(Int)
  rule <k> checkCanonicalWitnesses(N) => .K </k>
       <result> noResult => BoolValue(canonicalWitnessesAreValid(N)) </result>
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  // The implementation computes the contract characterization for every Int.
  claim
    <k> Module(
          FuncDef("is_equal_to_sum_even", Params("n"),
            Return(
              BoolOp("and",
                Compare(Name("n"), CmpOp(">=", Int(8))),
                Compare(BinOp("%", Name("n"), Int(2)),
                        CmpOp("==", Int(0))))))) => .K
      </k>
    <input> N:Int </input>
    <result> noResult => BoolValue(sumFourPositiveEvens(N)) </result>

  // Necessity: any sum of four positive evens is accepted.
  claim
    <k> Module(
          FuncDef("is_equal_to_sum_even", Params("n"),
            Return(
              BoolOp("and",
                Compare(Name("n"), CmpOp(">=", Int(8))),
                Compare(BinOp("%", Name("n"), Int(2)),
                        CmpOp("==", Int(0))))))) => .K
      </k>
    <input> A:Int +Int B:Int +Int C:Int +Int D:Int </input>
    <result> noResult => BoolValue(true) </result>
  requires A >Int 0 andBool A %Int 2 ==Int 0
       andBool B >Int 0 andBool B %Int 2 ==Int 0
       andBool C >Int 0 andBool C %Int 2 ==Int 0
       andBool D >Int 0 andBool D %Int 2 ==Int 0

  // Sufficiency: these explicit witnesses establish the "exactly 4" part.
  claim
    <k> checkCanonicalWitnesses(N) => .K </k>
    <input> N:Int </input>
    <result> noResult => BoolValue(true) </result>
  requires sumFourPositiveEvens(N)

  // Prompt examples, retained as independently executable proof targets.
  claim
    <k> Module(
          FuncDef("is_equal_to_sum_even", Params("n"),
            Return(
              BoolOp("and",
                Compare(Name("n"), CmpOp(">=", Int(8))),
                Compare(BinOp("%", Name("n"), Int(2)),
                        CmpOp("==", Int(0))))))) => .K
      </k>
    <input> 4 </input>
    <result> noResult => BoolValue(false) </result>

  claim
    <k> Module(
          FuncDef("is_equal_to_sum_even", Params("n"),
            Return(
              BoolOp("and",
                Compare(Name("n"), CmpOp(">=", Int(8))),
                Compare(BinOp("%", Name("n"), Int(2)),
                        CmpOp("==", Int(0))))))) => .K
      </k>
    <input> 6 </input>
    <result> noResult => BoolValue(false) </result>

  claim
    <k> Module(
          FuncDef("is_equal_to_sum_even", Params("n"),
            Return(
              BoolOp("and",
                Compare(Name("n"), CmpOp(">=", Int(8))),
                Compare(BinOp("%", Name("n"), Int(2)),
                        CmpOp("==", Int(0))))))) => .K
      </k>
    <input> 8 </input>
    <result> noResult => BoolValue(true) </result>
endmodule

