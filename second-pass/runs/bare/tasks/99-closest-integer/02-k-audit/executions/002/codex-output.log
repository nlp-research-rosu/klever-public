tion, hook(STRING.string2float)]\n/usr/include/kframework/builtin/domains.md:1820:You can convert between a `String` and an `Int`. The String will be represented\n/usr/include/kframework/builtin/domains.md:1822:optionally prefixed by a sign). When converting from an `Int` to a `String`,\n/usr/include/kframework/builtin/domains.md:1825:You can also convert between a `String` and an `Int` in a particular radix.\n/usr/include/kframework/builtin/domains.md:1834:  syntax Int    ::= String2Int   ( String )             [function, hook(STRING.string2int)]\n/usr/include/kframework/builtin/domains.md:1835:  syntax String ::= Int2String   ( Int )                [function, total, hook(STRING.int2string)]\n/usr/include/kframework/builtin/domains.md:1836:  syntax String ::= Base2String  ( Int , base: Int )          [function, hook(STRING.base2string)]\n/usr/include/kframework/builtin/domains.md:1837:  syntax Int    ::= String2Base  ( String , base: Int )       [function, hook(STRING.string2base)]\n/usr/include/kframework/builtin/domains.md:1853:  syntax String ::= \"replace\" \"(\" haystack: String \",\" needle: String \",\" replacement: String \",\" times: Int \")\" [function, hook(STRING.replace)]\n/usr/include/kframework/builtin/domains.md:1855:  syntax Int ::= \"countAllOccurrences\" \"(\" haystack: String \",\" needle: String \")\"            [function, total, hook(STRING.countAllOccurrences)]\n/usr/include/kframework/builtin/domains.md:1891:  rule findChar(S1:String, S2:String, I:Int) => #if findString(S1, substrString(S2, 0, 1), I) ==Int -1 #then findChar(S1, substrString(S2, 1, lengthString(S2)), I) #else #if findChar(S1, substrString(S2, 1, lengthString(S2)), I) ==Int -1 #then findString(S1, substrString(S2, 0, 1), I) #else minInt(findString(S1, substrString(S2, 0, 1), I), findChar(S1, substrString(S2, 1, lengthString(S2)), I)) #fi #fi requires S2 =/=String \"\"\n/usr/include/kframework/builtin/domains.md:1893:  rule rfindChar(S1:String, S2:String, I:Int) => maxInt(rfind