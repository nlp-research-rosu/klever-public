/bin/bash -lc "cp /audit-output/evidence/spec-vacuity-audit.k /tmp/audit-work/candidate/spec-vacuity-audit.k; script -q -e -c 'kprove spec-vacuity-audit.k --definition verification-audit-kompiled --spec-module SPEC-VACUITY-AUDIT --dry-run' /audit-output/evidence/06-vacuity-build.log; echo \"vacuity-build-exit="'$?"; script -q -e -c '"'kprove spec-vacuity-audit.k --definition verification-audit-kompiled --spec-module SPEC-VACUITY-AUDIT' /audit-output/evidence/06-vacuity-proof.log; echo \"vacuity-proof-exit="'$?"' in /tmp/audit-work/candidate
