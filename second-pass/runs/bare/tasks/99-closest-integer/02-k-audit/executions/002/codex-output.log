     6	    If(Compare(Name("number"), CmpOp(">=", Int(0))),
     7	      Return(
     8	        Call(Name("int"), BinOp("+", Name("number"), Name("half")))),
     9	      )
    10	    Return(Call(Name("int"), BinOp("-", Name("number"), Name("half"))))))
