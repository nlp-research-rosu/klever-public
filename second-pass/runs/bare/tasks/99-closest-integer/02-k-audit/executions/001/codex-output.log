+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local status=$?
+  printf 'EXIT_STATUS: %d\n\n' "$status"
+  return 0
+}
+
+run test ! -e /reference/reference-semantics
+run stat -c '%F %N' \
+  /candidate/run-input.json \
+  /candidate/metrics.json \
+  /candidate/codex-last.txt \
+  /candidate/codex-output.log \
+  /candidate/prompt.py \
+  /candidate/py2mpy.py \
+  /candidate/solution.py \
