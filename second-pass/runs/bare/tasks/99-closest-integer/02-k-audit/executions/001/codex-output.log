new file mode 100644
index 0000000000000000000000000000000000000000..63785e238433d89724e136165fb48e4e60979b55
--- /dev/null
+++ b/evidence/spec-audit.k
@@ -0,0 +1,122 @@
+requires "verification.k"
+
+module SPEC-AUDIT
+  imports VERIFICATION
+
+  claim [audit-01]:
+    <k> solutionProgram => .K </k>
+    <arg> rationalString(N, D) </arg>
+    <env> .Map =>
+      ("value" |-> rationalString(N, D)
+       "number" |-> exactNum(N, D)
+       "half" |-> exactNum(5, 10))
+    </env>
+    <result> noResult => pyInt(roundNearestAway(N, D)) </result>
+    requires D >Int 0
+
+  claim [audit-02]:
+    <k> solutionProgram => .K </k>
+    <arg> rationalString((2 *Int I) +Int 1, 2) </arg>
+    <env> .Map =>
+      ("value" |-> rationalString((2 *Int I) +Int 1, 2)
+       "number" |-> exactNum((2 *Int I) +Int 1, 2)
