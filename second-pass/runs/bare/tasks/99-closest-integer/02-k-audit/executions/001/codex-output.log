+  claim [audit-08]:
+    <k> solutionProgram => .K </k>
+    <arg> pyStr("10") </arg>
+    <env> .Map =>
+      ("value" |-> pyStr("10")
+       "number" |-> exactNum(10, 1)
+       "half" |-> exactNum(5, 10))
+    </env>
