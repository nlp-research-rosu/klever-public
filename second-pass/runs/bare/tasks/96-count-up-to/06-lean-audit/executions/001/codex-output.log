@@ -0,0 +1,12 @@
+#include <stdio.h>
+#include <stddef.h>
+
+extern int uv_exepath(char *buffer, size_t *size);
+
+int main(void) {
+  char buffer[4096];
+  size_t size = sizeof buffer;
+  int result = uv_exepath(buffer, &size);
+  printf("result=%d size=%zu path=%.*s\n", result, size, (int)size, buffer);
+  return result != 0;
+}
