tmts \\\")\\\"\\n+                 | \\\"eval\\\" \\\"(\\\" Expr \\\")\\\"\\n+                 | \\\"assignTo\\\" \\\"(\\\" String \\\")\\\"\\n+                 | \\\"ifCont\\\" \\\"(\\\" Stmts \\\",\\\" Stmts \\\")\\\"\\n+                 | \\\"whileCont\\\" \\\"(\\\" Expr \\\",\\\" Stmts \\\")\\\"\\n+                 | \\\"binRight\\\" \\\"(\\\" String \\\",\\\" Expr \\\")\\\"\\n+                 | \\\"binApply\\\" \\\"(\\\" String \\\",\\\" Value \\\")\\\"\\n+                 | \\\"cmpRight\\\" \\\"(\\\" String \\\",\\\" Expr \\\")\\\"\\n+                 | \\\"cmpApply\\\" \\\"(\\\" String \\\",\\\" Value \\\")\\\"\\n+                 | \\\"singleton\\\"\\n+                 | \\\"returnValue\\\"\\n+\\n+  rule <k> Module(FuncDef(\\\"count_up_to\\\", Params(\\\"n\\\"), BODY))\\n+        => exec(BODY) ... </k>\\n+\\n+  rule <k> exec(.Stmts) => . ... </k>\\n+  rule <k> exec(S SS) => exec(S) ~> exec(SS) ... </k>\\n+\\n+  rule <k> exec(Assign(Name(X), E)) => eval(E) ~> assignTo(X) ... </k>\\n+  rule <k> exec(If(COND, THEN, ELSE))\\n+        => eval(COND) ~> ifCont(THEN, ELSE) ... </k>\\n+  rule <k> true ~> ifCont(THEN, _) => exec(THEN) ... </k>\\n+  rule <k> false ~> ifCont(_, ELSE) => exec(ELSE) ... </k>\\n+  rule <k> exec(While(COND, BODY))\\n+        => eval(COND) ~> whileCont(COND, BODY) ... </k>\\n+  rule <k> true ~> whileCont(COND, BODY)\\n+        => exec(BODY) ~> exec(While(COND, BODY)) ... </k>\\n+  rule <k> false ~> whileCont(_, _) => . ... </k>\\n+  rule <k> exec(Return(E)) => eval(E) ~> returnValue ... </k>\\n+  rule <k> V:Value ~> returnValue => . ... </k>\\n+       <result> .K => V </result>\\n+\\n+  rule <k> eval(Int(I)) => I ... </k>\\n+  rule <k> eval(Bool(B)) => B ... </k>\\n+  rule <k> eval(Name(\\\"n\\\")) => N ... </k> <n> N </n>\\n+  rule <k> eval(Name(\\\"primes\\\")) => V ... </k> <primes> V </primes>\\n+  rule <k> eval(Name(\\\"candidate\\\")) => I ... </k> <candidate> I </candidate>\\n+  rule <k> eval(Name(\\\"is_prime\\\")) => B ... </k> <isPrime> B </isPrime>\\n+  rule <k> eval(Name(\\\"divisor\\\")) => I ... </k> <divisor> I </divisor>\\n+\\n+  rule <k> eval(ListExpr(.Exprs)) => list(.Ints) ... </k>\\n+  rule <k> eval(ListExpr(E)) => eval(E) ~> singleton ... </k>\\n+  rule <k> I:Int ~> singleton => list(I) ... </k>\\n+\\n+  rule <k> eval(BinOp(OP, LEFT, RIGHT))\\n+        => eval(LEFT) ~> binRight(OP, RIGHT) ... </k>\\n+  rule <k> LEFT:Value ~> binRight(OP, RIGHT)\\n+        => eval(RIGHT) ~> binApply(OP, LEFT) ... </k>\\n+  rule <k> RIGHT:Int ~> binApply(\\\"+\\\", LEFT:Int) => LEFT +Int RIGHT ... </k>\\n+  rule <k> RIGHT:Int ~> binApply(\\\"*\\\", LEFT:Int) => LEFT *Int RIGHT ... </k>\\n+  rule <k> RIGHT:Int ~> binApply(\\\"%\\\", LEFT:Int) => LEFT %Int RIGHT ... </k>\\n+       requires RIGHT =/=Int 0\\n+  rule <k> list(RIGHT) ~> binApply(\\\"+\\\", list(LEFT))\\n+        => list(LEFT, RIGHT) ... </k>\\n+\\n+  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT)))\\n+        => eval(LEFT) ~> cmpRight(OP, RIGHT) ... </k>\\n+  rule <k> LEFT:Value ~> cmpRight(OP, RIGHT)\\n+        => eval(RIGHT) ~> cmpApply(OP, LEFT) ... </k>\\n+  rule <k> RIGHT:Int ~> cmpApply(\\\"<\\\", LEFT:Int) => LEFT <Int RIGHT ... </k>\\n+  rule <k> RIGHT:Int ~> cmpApply(\\\"<=\\\", LEFT:Int) => LEFT <=Int RIGHT ... </k>\\n+  rule <k> RIGHT:Int ~> cmpApply(\\\"==\\\", LEFT:Int) => LEFT ==Int RIGHT ... </k>\\n+\\n+  rule <k> V:Value ~> assignTo(\\\"primes\\\") => . ... </k>\\n+       <primes> _ => V </primes>\\n+  rule <k> I:Int ~> assignTo(\\\"candidate\\\") => . ... </k>\\n+       <candidate> _ => I </candidate>\\n+  rule <k> B:Bool ~> assignTo(\\\"is_prime\\\") => . ... </k>\\n+       <isPrime> _ => B </isPrime>\\n+  rule <k> I:Int ~> assignTo(\\\"divisor\\\") => . ... </k>\\n+       <divisor> _ => I </divisor>\\n+endmodule\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\nconst r = await tools.exec_command({cmd:\"kompile semantic.k --backend haskell --main-module MPY --syntax-module MPY-SYNTAX\",\"workdir\":\"/work\",\"yiel