from pathlib import Path
import hashlib,json,stat,itertools
cases=[(Path('/candidate'),'0d763366eadd5c94faa5c0c645f1f296c682dc88c770c7e63167dfc468097496'),(Path('/generation-evidence/codex-trace'),'f909d696a4c5282f37335def460946d32a121519eadefda48c04a617dc25d9bb')]

