        }
        for rule in validated["domain_lemmas"]
    ]


def _klean_source_rules(
    domain_rules: list[dict[str, Any]],
    line_offset: int,
) -> list[dict[str, Any]]:
    return [
        {
            "source_rule_id": rule["source_rule_id"],
            "start_line": rule["start_line"] + line_offset,
            "end_line": rule["end_line"] + line_offset,
