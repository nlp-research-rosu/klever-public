#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy
kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX
krun solution.mpy --definition verification-kompiled -cARG1=2 -cARG2=3
krun solution.mpy --definition verification-kompiled -cARG1=5 -cARG2=7
krun solution.mpy --definition verification-kompiled -cARG1=-8 -cARG2=3
kprove spec.k --definition verification-kompiled --spec-module SPEC
requires "semantic.k"

module VERIFICATION
  imports SEMANTIC
endmodule
module MPY-SYNTAX
  imports INT-SYNTAX
  imports STRING-SYNTAX

  syntax Pgm ::= "Module" "(" Stmt ")"

  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmt ")"
                | "Return" "(" Expr ")"

  syntax Params ::= "Params" "(" String "," String ")"

  syntax Expr ::= "Int" "(" Int ")"
                | "Name" "(" String ")"
                | "BinOp" "(" String "," Expr "," Expr ")"
endmodule

module SEMANTIC
  imports MPY-SYNTAX
  imports INT
  imports MAP

  syntax PyVal ::= "pyInt" "(" Int ")"
  syntax Function ::= "function" "(" String "," String "," Stmt ")"

  syntax KItem ::= "load" "(" Pgm ")"
                 | "invoke" "(" String "," PyVal "," PyVal ")"
                 | "bind" "(" String "," PyVal ")"
                 | "eval" "(" Expr ")"
                 | "plusLeft" "(" Expr ")"
                 | "plusRight" "(" PyVal ")"
                 | "finishReturn"

  configuration
    <mpy>
      <k> load($PGM:Pgm) ~> invoke("add", pyInt($ARG1:Int), pyInt($ARG2:Int)) </k>
      <env> .Map </env>
      <functions> .Map </functions>
      <result> 0 </result>
    </mpy>

  rule <k> load(Module(S)) => S ... </k>

  rule <k> FuncDef(F, Params(X, Y), BODY) => .K ... </k>
       <functions> .Map => F |-> function(X, Y, BODY) </functions>

  rule <k> invoke(F, VX, VY)
         => bind(X, VX) ~> bind(Y, VY) ~> BODY ... </k>
       <functions> F |-> function(X, Y, BODY) </functions>

  rule <k> bind(X, V) => .K ... </k>
       <env> RHO => RHO [ X <- V ] </env>

  rule <k> Return(E) => eval(E) ~> finishReturn ... </k>

  rule <k> eval(Int(I)) => pyInt(I) ... </k>

  rule <k> eval(Name(X)) => V ... </k>
       <env> ... X |-> V ... </env>

  rule <k> eval(BinOp("+", LEFT, RIGHT))
         => eval(LEFT) ~> plusLeft(RIGHT) ... </k>

  rule <k> pyInt(I) ~> plusLeft(RIGHT)
         => eval(RIGHT) ~> plusRight(pyInt(I)) ... </k>

  rule <k> pyInt(J) ~> plusRight(pyInt(I))
         => pyInt(I +Int J) ... </k>

  rule <k> pyInt(I) ~> finishReturn => .K ... </k>
       <result> _ => I </result>
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  claim
    <k>
      load(Module(FuncDef("add", Params("x", "y"),
        Return(BinOp("+", Name("x"), Name("y"))))))
      ~> invoke("add", pyInt(X), pyInt(Y))
      => .K
    </k>
    <env> .Map => "x" |-> pyInt(X) "y" |-> pyInt(Y) </env>
    <functions>
      .Map
      => "add" |-> function("x", "y",
        Return(BinOp("+", Name("x"), Name("y"))))
    </functions>
    <result> 0 => X +Int Y </result>
endmodule

