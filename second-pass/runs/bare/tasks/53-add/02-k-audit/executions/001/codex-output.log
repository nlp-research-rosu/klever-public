diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..8ea677c20d2c8959798b1c325eaefd092a48fbf8
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 3 )) || [[ $2 != "--" ]]; then
+  echo "usage: run_logged.sh LOG -- COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log=$1
+shift 2
+
+{
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'BEGIN_OUTPUT\n'
+} > "$log"
+
+"$@" 2>&1 | tee -a "$log"
+status=${PIPESTATUS[0]}
+
+{
+  printf 'END_OUTPUT\n'
+  printf 'EXIT_STATUS: %d\n' "$status"
+} >> "$log"
+
+exit "$status"
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..e5ca181f8dbdadc0d4dd9f1a44eea6f9bf35f78c
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,23 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Fresh reviewer mutation: the real execution returns X +Int Y, but this
+  // destination deliberately demands one more. Witness X=2, Y=3 demands 6
+  // although both Python implementations and concrete K execution return 5.
+  claim
+    <k>
+      load(Module(FuncDef("add", Params("x", "y"),
+        Return(BinOp("+", Name("x"), Name("y"))))))
+      ~> invoke("add", pyInt(X), pyInt(Y))
+      => .K
+    </k>
+    <env> .Map => "x" |-> pyInt(X) "y" |-> pyInt(Y) </env>
+    <functions>
+      .Map
+      => "add" |-> function("x", "y",
+        Return(BinOp("+", Name("x"), Name("y"))))
+    </functions>
+    <result> 0 => (X +Int Y) +Int 1 </result>
+endmodule
