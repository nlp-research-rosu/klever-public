+#!/usr/bin/env python3
+import hashlib
+import json
+import os
+from pathlib import Path
+
+CANDIDATE = Path("/candidate")
+REFERENCE = Path("/reference")
+
+required = [
+    "run-input.json",
+    "metrics.json",
+    "codex-last.txt",
+    "codex-output.log",
+    "prompt.py",
+    "py2mpy.py",
+    "solution.py",
+    "solution.mpy",
+    "semantic.k",
+    "verification.k",
+    "spec.k",
+    "prove.sh",
+]
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(65536), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+failures = []
+print("MODE: GENERATED_SEMANTICS")
+reference_semantics = REFERENCE / "reference-semantics"
+print(f"REFERENCE_SEMANTICS_EXISTS: {reference_semantics.exists()}")
+if reference_semantics.exists() or reference_semantics.is_symlink():
+    failures.append("forbidden trusted reference-semantics exists")
+
+for name in required:
+    path = CANDIDATE / name
+    kind = "missing"
+    if path.is_symlink():
+        kind = "symlink"
+        failures.append(f"{name}: symlink")
+    elif path.is_file():
+        kind = "regular-file"
