const patch = "*** Begin Patch\n*** Add File: /work/solution.py\n+def add(x: int, y: int):\n+    return x + y\n*** Add File: /work/semantic.k\n+module MPY-SYNTAX\n+  imports INT-SYNTAX\n+  imports STRING-SYNTAX\n+\n+  syntax Pgm ::= \"Module\" \"(\" Stmt \")\"\n+\n+  syntax Stmt ::= \"FuncDef\" \"(\" String \",\" Params \",\" Stmt \")\"\n+                | \"Return\" \"(\" Expr \")\"\n+\n+  syntax Params ::= \"Params\" \"(\" String \",\" String \")\"\n+\n+  syntax Expr ::= \"Int\" \"(\" Int \")\"\n+                | \"Name\" \"(\" String \")\"\n+                | \"BinOp\" \"(\" String \",\" Expr \",\" Expr \")\"\n+endmodule\n+\n+module SEMANTIC\n+  imports MPY-SYNTAX\n+  imports INT\n+  imports MAP\n+\n+  syntax PyVal ::= \"pyInt\" \"(\" Int \")\" [function]\n+  syntax Function ::= \"function\" \"(\" String \",\" String \",\" Stmt \")\" [function]\n+\n+  syntax KItem ::= \"load\" \"(\" Pgm \")\"\n+                 | \"invoke\" \"(\" String \",\" PyVal \",\" PyVal \")\"\n+                 | \"bind\" \"(\" String \",\" PyVal \")\"\n+                 | \"eval\" \"(\" Expr \")\"\n+                 | \"plusLeft\" \"(\" Expr \")\"\n+                 | \"plusRight\" \"(\" PyVal \")\"\n+                 | \"finishReturn\"\n+\n+  configuration\n+    <mpy>\n+      <k> load($PGM:Pgm) ~> invoke(\"add\", pyInt($ARG1:Int), pyInt($ARG2:Int)) </k>\n+      <env> .Map </env>\n+      <functions> .Map </functions>\n+      <result> 0 </result>\n+    </mpy>\n+\n+  rule <k> load(Module(S)) => S ... </k>\n+\n+  rule <k> FuncDef(F, Params(X, Y), BODY) => .K ... </k>\n+       <functions> .Map => F |-> function(X, Y, BODY) </functions>\n+\n+  rule <k> invoke(F, VX, VY)\n+         => bind(X, VX) ~> bind(Y, VY) ~> BODY ... </k>\n+       <functions> F |-> function(X, Y, BODY) </functions>\n+\n+  rule <k> bind(X, V) => .K ... </k>\n+       <env> RHO => RHO [ X <- V ] </env>\n+\n+  rule <k> Return(E) => eval(E) ~> finishReturn ... </k>\n+\n+  rule <k> eval(Int(I)) => pyInt(I) ... </k>\n+\n+  rule <k> eval(Name(X)) => V ... </k>\n+       <env> ... X |-> V ... </env>\n+\n+  rule <k> eval(BinOp(\"+\", LEFT, RIGHT))\n+         => eval(LEFT) ~> plusLeft(RIGHT) ... </k>\n+\n+  rule <k> pyInt(I) ~> plusLeft(RIGHT)\n+         => eval(RIGHT) ~> plusRight(pyInt(I)) ... </k>\n+\n+  rule <k> pyInt(J) ~> plusRight(pyInt(I))\n+         => pyInt(I +Int J) ... </k>\n+\n+  rule <k> pyInt(I) ~> finishReturn => .K ... </k>\n+       <result> _ => I </result>\n+endmodule\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module VERIFICATION\n+  imports SEMANTIC\n+endmodule\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module SPEC\n+  imports VERIFICATION\n+\n+  claim\n+    <mpy>\n+      <k>\n+        load(Module(FuncDef(\"add\", Params(\"x\", \"y\"),\n+          Return(BinOp(\"+\", Name(\"x\"), Name(\"y\"))))))\n+        ~> invoke(\"add\", pyInt(X), pyInt(Y))\n+      </k>\n+      <env> .Map </env>\n+      <functions> .Map </functions>\n+      <result> 0 </result>\n+    </mpy>\n+  =>\n+    <mpy>\n+      <k> .K </k>\n+      <env> \"x\" |-> pyInt(X) \"y\" |-> pyInt(Y) </env>\n+      <functions>\n+        \"add\" |-> function(\"x\", \"y\",\n+          Return(BinOp(\"+\", Name(\"x\"), Name(\"y\"))))\n+      </functions>\n+      <result> X +Int Y </result>\n+    </mpy>\n+endmodule\n*** End Patch";
