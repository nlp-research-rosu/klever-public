                | "Return" "(" Expr ")"

  syntax Params ::= "Params" "(" String "," String ")"

  syntax Expr ::= "Int" "(" Int ")"
                | "Name" "(" String ")"
                | "BinOp" "(" String "," Expr "," Expr ")"
endmodule

module SEMANTIC
  imports MPY-SYNTAX
  imports INT
  imports MAP

  syntax PyVal ::= "pyInt" "(" Int ")"
  syntax Function ::= "function" "(" String "," String "," Stmt ")"

  syntax KItem ::= "load" "(" Pgm ")"
