+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: run_and_log.sh LABEL COMMAND [ARG ...]" >&2
+  exit 2
+fi
+
+label=$1
+shift
