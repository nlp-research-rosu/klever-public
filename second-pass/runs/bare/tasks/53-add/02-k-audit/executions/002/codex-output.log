+    assert candidate_hash == invocation["retained_workspace_sha256"]
+    assert trace_hash == usage["source_trace_sha256"]
+
+    candidate_files = sorted(
+        p.relative_to("/candidate").as_posix()
+        for p in Path("/candidate").rglob("*")
+        if p.is_file()
