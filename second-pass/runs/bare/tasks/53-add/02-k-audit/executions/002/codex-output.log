diff --git a//tmp/audit-work/53-add-audit-002/spec-body-mutation.k b//tmp/audit-work/53-add-audit-002/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..e0a992adb0c618cb91757e0a704c6054764d512d
--- /dev/null
+++ b//tmp/audit-work/53-add-audit-002/spec-body-mutation.k
@@ -0,0 +1,21 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Ground body-sensitivity witness: the executed body returns x, while the
+  // original addition postcondition still requires 5 at x=2, y=3.
+  claim
+    <k>
+      load(Module(FuncDef("add", Params("x", "y"),
+        Return(Name("x")))))
+      ~> invoke("add", pyInt(2), pyInt(3))
+      => .K
+    </k>
+    <env> .Map => "x" |-> pyInt(2) "y" |-> pyInt(3) </env>
+    <functions>
+      .Map
+      => "add" |-> function("x", "y", Return(Name("x")))
+    </functions>
+    <result> 0 => 5 </result>
+endmodule
diff --git a//tmp/audit-work/53-add-audit-002/spec-vacuity-audit.k b//tmp/audit-work/53-add-audit-002/spec-vacuity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..ead2c1decdb6cdd622884c81a6cddd5d723ab226
--- /dev/null
+++ b//tmp/audit-work/53-add-audit-002/spec-vacuity-audit.k
@@ -0,0 +1,22 @@
+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // Fresh false postcondition: at X=2, Y=3 this requires 6 although execution
+  // and both independent Python implementations return 5.
+  claim
+    <k>
+      load(Module(FuncDef("add", Params("x", "y"),
+        Return(BinOp("+", Name("x"), Name("y"))))))
+      ~> invoke("add", pyInt(X), pyInt(Y))
+      => .K
+    </k>
+    <env> .Map => "x" |-> pyInt(X) "y" |-> pyInt(Y) </env>
+    <functions>
+      .Map
+      => "add" |-> function("x", "y",
+        Return(BinOp("+", Name("x"), Name("y"))))
+    </functions>
+    <result> 0 => X +Int Y +Int 1 </result>
+endmodule
