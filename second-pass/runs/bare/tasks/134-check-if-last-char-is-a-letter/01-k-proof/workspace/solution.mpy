Module(
  FuncDef("check_if_last_char_is_a_letter", Params("txt"),
    Return(
      BoolOp(
        "or",
        BoolOp(
          "and",
          Compare(Call(Name("len"), Name("txt")), CmpOp("==", Int(1))),
          Call(Attribute(Name("txt"), "isalpha"), )),
        BoolOp(
          "and",
          Compare(Call(Name("len"), Name("txt")), CmpOp(">", Int(1))),
          Call(
            Attribute(
              Subscript(Name("txt"), UnaryOp("-", Int(1))),
              "isalpha"),
            ),
          Compare(
            Subscript(Name("txt"), UnaryOp("-", Int(2))),
            CmpOp("==", Str(" "))))))))
