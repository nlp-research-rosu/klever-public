+    "simplification",
+    "priority",
+    "owise",
+    "macro",
+    "alias",
+    "symbol",
+    "opaque",
+]:
+    pattern = re.compile(r"\b" + attribute + r"\b")
+    print(f"ATTRIBUTE_COUNT {attribute}={len(pattern.findall(all_text))}")

