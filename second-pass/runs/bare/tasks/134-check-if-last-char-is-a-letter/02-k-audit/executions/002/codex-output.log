  python3 /audit-output/evidence/05_rule_inventory.py
  echo \"INVENTORY_EXIT_STATUS="'$?"
  for probe in probe-len-unicode.mpy probe-isalpha-unicode.mpy probe-subscript-empty.mpy probe-eager-and.mpy; do
    echo "$ krun $probe --definition semantic-audit-kompiled -cTXT='"'\\\"ignored\\\"'\"
    krun \""'$probe" --definition semantic-audit-kompiled -cTXT='"'\"ignored\"'
    echo \"KRUN_EXIT_STATUS="'$?"
  done
  echo '"'"'$ python3 - <<PY (trusted CPython primitive probes)'"'
