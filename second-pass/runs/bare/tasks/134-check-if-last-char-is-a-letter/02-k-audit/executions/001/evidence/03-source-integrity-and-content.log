     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // A direct formalization of the English contract.  A final letter is not
     7	  // part of a word exactly when it is the whole string, or when a space is
     8	  // immediately before it.
     9	  syntax Bool ::= standaloneLastLetter(String) [function]
    10	
    11	  rule standaloneLastLetter(S)
    12	    => (lengthString(S) ==Int 1 andBool isAlphaString(S))
    13	       orBool
    14	       (lengthString(S) >Int 1
    15	        andBool isAlphaString(atString(S, 0 -Int 1))
    16	        andBool atString(S, 0 -Int 2) ==String " ")
    17	endmodule
