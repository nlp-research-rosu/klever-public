diff --git a/evidence/run_capture.sh b/evidence/run_capture.sh
new file mode 100644
index 0000000000000000000000000000000000000000..a65bdfd3ea4843ecf65446070b4d145d73969b6d
--- /dev/null
+++ b/evidence/run_capture.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG_PATH COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$log_path"
+
+set +e
+"$@" > >(tee -a "$log_path") 2> >(tee -a "$log_path" >&2)
+status=$?
+set -e
+
+printf 'EXIT_STATUS: %d\n' "$status" | tee -a "$log_path"
+exit "$status"
