+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG_PATH COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$log_path"
+
