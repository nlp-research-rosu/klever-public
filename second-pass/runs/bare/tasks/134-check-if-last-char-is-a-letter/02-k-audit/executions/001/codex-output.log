/audit-output/evidence/run_capture.sh /audit-output/evidence/21-mutation-dry-run.log kprove spec-vacuity-audit.k --definition /tmp/audit-work/build/proof-kompiled --spec-module SPEC-VACUITY-AUDIT --dry-run
