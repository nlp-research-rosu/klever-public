  --syntax-module MPY-SYNTAX

run_case() {
  local input="$1"
  local expected="$2"
  local actual

  actual="$(krun solution.mpy \
    --definition verification-kompiled \
    -cTXT="\"${input}\"")"
  printf '%s\n' "$actual"

  case "$actual" in
    *"pyBool ( ${expected} )"*) ;;
    *)
      printf 'unexpected result for %q: expected %s\n' "$input" "$expected" >&2
      return 1
      ;;
  esac
}

