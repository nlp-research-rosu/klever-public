+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // This equation is the exact constructor tree emitted in solution.mpy.
+  syntax Pgm ::= "solutionProgram" [function, total, symbol(solutionProgram)]
+  rule solutionProgram =>
+    Module(
+      FuncDef("compare", Params("game", "guess"),
+        If(Compare(Name("game"), CmpOp("==", ListExpr(.Exprs))),
+          Return(ListExpr(.Exprs)),
+          .Stmts)
+        Assign(
+          Name("difference"),
+          BinOp("-",
+            Subscript(Name("game"), Int(0)),
+            Subscript(Name("guess"), Int(0))))
+        If(Compare(Name("difference"), CmpOp("<", Int(0))),
+          Assign(Name("difference"), UnaryOp("-", Name("difference"))),
+          .Stmts)
+        Return(
+          BinOp("+",
+            ListExpr(Name("difference")),
+            Call(Name("compare"),
+              Subscript(Name("game"), Slice(Int(1), NoBound, NoBound)),
+              Subscript(Name("guess"), Slice(Int(1), NoBound, NoBound)))))))
+
+  // PairSeq represents two arbitrary equal-length integer lists.  Keeping the
+  // shared spine explicit makes the input precondition structural.
+  syntax PairSeq ::= "PNil" [symbol(PNil)]
+                   | "PCons" "(" Int "," Int "," PairSeq ")" [symbol(PCons)]
+  syntax Values ::= games(PairSeq) [function, total, symbol(games)]
+                  | guesses(PairSeq) [function, total, symbol(guesses)]
+                  | expectedPairs(PairSeq) [function, total, symbol(expectedPairs)]
+  syntax PairSeq ::= restPairs(PairSeq) [function, symbol(restPairs)]
+  syntax Int ::= firstGame(PairSeq) [function, symbol(firstGame)]
+               | firstGuess(PairSeq) [function, symbol(firstGuess)]
+  syntax Bool ::= isEmptyPairs(PairSeq) [function, total, symbol(isEmptyPairs)]
+
+  rule games(PNil) => VNil
+  rule games(PCons(G, _, PS)) => VCons(VInt(G), games(PS))
+  rule guesses(PNil) => VNil
+  rule guesses(PCons(_, U, PS)) => VCons(VInt(U), guesses(PS))
+  rule isEmptyPairs(PNil) => true
+  rule isEmptyPairs(PCons(_, _, _)) => false
+  rule firstGame(PCons(G, _, _)) => G
+  rule firstGuess(PCons(_, U, _)) => U
+  rule restPairs(PCons(_, _, PS)) => PS
+
+  // Symbolic projection equations for a PairSeq whose constructor is not yet
+  // known.  They are the point-free counterparts of the constructor rules.
+  rule isEmptyValues(games(PS)) => isEmptyPairs(PS) [simplification]
+  rule lookupAt(games(PS), 0) => VInt(firstGame(PS))
+    requires notBool isEmptyPairs(PS) [simplification]
+  rule lookupAt(guesses(PS), 0) => VInt(firstGuess(PS))
+    requires notBool isEmptyPairs(PS) [simplification]
+  rule dropValues(games(PS), 1) => games(restPairs(PS))
+    requires notBool isEmptyPairs(PS) [simplification]
+  rule dropValues(guesses(PS), 1) => guesses(restPairs(PS))
+    requires notBool isEmptyPairs(PS) [simplification]
+
+  // Independent mathematical contract for pairwise absolute difference.
+  rule expectedPairs(PS) => VNil
+    requires isEmptyPairs(PS)
+  rule expectedPairs(PS)
+    => VCons(
+         VInt(absInt(firstGame(PS) -Int firstGuess(PS))),
+         expectedPairs(restPairs(PS)))
+    requires notBool isEmptyPairs(PS)
+endmodule

