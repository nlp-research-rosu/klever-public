+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // This equation is the exact constructor tree emitted in solution.mpy.
+  syntax Pgm ::= "solutionProgram" [function, total, symbol(solutionProgram)]
+  rule solutionProgram =>
+    Module(
+      FuncDef("compare", Params("game", "guess"),
+        If(Compare(Name("game"), CmpOp("==", ListExpr(.Exprs))),
+          Return(ListExpr(.Exprs)),
+          .Stmts)
+        Assign(
+          Name("difference"),
+          BinOp("-",
+            Subscript(Name("game"), Int(0)),
+            Subscript(Name("guess"), Int(0))))
+        If(Compare(Name("difference"), CmpOp("<", Int(0))),
+          Assign(Name("difference"), UnaryOp("-", Name("difference"))),
+          .Stmts)
+        Return(
+          BinOp("+",
+            ListExpr(Name("difference")),
+            Call(Name("compare"),
+              Subscript(Name("game"), Slice(Int(1), NoBound, NoBound)),
+              Subscript(Name("guess"), Slice(Int(1), NoBound, NoBound)))))))
+
+  // Mathematical contract: consume equal-length integer lists pairwise.
+  syntax Values ::= expected(Values, Values) [function, total, symbol(expected)]
+  rule expected(VNil, VNil) => VNil
+  rule expected(VCons(VInt(G), GS), VCons(VInt(U), US))
+    => VCons(VInt(absInt(G -Int U)), expected(GS, US))
+
+  syntax Bool ::= validPair(Values, Values) [function, total, symbol(validPair)]
+  rule validPair(VNil, VNil) => true
+  rule validPair(VCons(VInt(_), GS), VCons(VInt(_), US))
+    => validPair(GS, US)
+  rule validPair(VNil, VCons(_, _)) => false
+  rule validPair(VCons(_, _), VNil) => false
+  rule validPair(VCons(VBool(_), _), VCons(_, _)) => false
+  rule validPair(VCons(VList(_), _), VCons(_, _)) => false
+  rule validPair(VCons(VInt(_), _), VCons(VBool(_), _)) => false
+  rule validPair(VCons(VInt(_), _), VCons(VList(_), _)) => false
+endmodule

