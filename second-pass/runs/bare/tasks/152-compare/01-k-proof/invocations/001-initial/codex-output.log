+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")" [symbol(Module)]
+
+  syntax Stmts ::= List{Stmt, ""} [symbol(stmts)]
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol(FuncDef)]
+                | "Return" "(" Expr ")"                         [symbol(Return)]
+                | "Assign" "(" Expr "," Expr ")"               [symbol(Assign)]
+                | "If" "(" Expr "," Stmts "," Stmts ")"        [symbol(If)]
+
+  syntax Params ::= "Params" "(" Strings ")" [symbol(Params)]
+  syntax Strings ::= List{String, ","} [symbol(strings)]
+
+  syntax Expr ::= "Name" "(" String ")"                         [symbol(Name)]
+                | "Int" "(" Int ")"                             [symbol(IntExpr)]
+                | "ListExpr" "(" Exprs ")"                      [symbol(ListExpr)]
+                | "BinOp" "(" String "," Expr "," Expr ")"     [symbol(BinOp)]
+                | "UnaryOp" "(" String "," Expr ")"             [symbol(UnaryOp)]
+                | "Compare" "(" Expr "," CmpOps ")"             [symbol(Compare)]
+                | "Subscript" "(" Expr "," Index ")"            [symbol(Subscript)]
+                | "Call" "(" Expr "," Exprs ")"                 [symbol(Call)]
+
+  syntax Exprs ::= List{Expr, ","} [symbol(exprs)]
+  syntax CmpOps ::= List{CmpOp, ","} [symbol(cmpOps)]
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol(CmpOp)]
+  syntax Index ::= Expr
+                 | "Slice" "(" Bound "," Bound "," Bound ")" [symbol(Slice)]
+  syntax Bound ::= Expr | "NoBound" [symbol(NoBound)]
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+
+  syntax Value ::= "VInt" "(" Int ")"     [symbol(VInt)]
+                 | "VBool" "(" Bool ")"   [symbol(VBool)]
+                 | "VList" "(" Values ")" [symbol(VList)]
+  syntax Values ::= "VNil"                         [symbol(VNil)]
+                  | "VCons" "(" Value "," Values ")" [symbol(VCons)]
+
+  syntax Env ::= "EmptyEnv"                        [symbol(EmptyEnv)]
+               | "Bind" "(" String "," Value "," Env ")" [symbol(Bind)]
+
+  syntax Outcome ::= "Ongoing" "(" Env ")"    [symbol(Ongoing)]
+                   | "Returned" "(" Value ")" [symbol(Returned)]
+
+  syntax Value ::= execute(Pgm, Value, Value) [function, total, symbol(execute)]
+                 | evalExpr(Expr, Env, Pgm)   [function, total, symbol(evalExpr)]
+                 | invoke(Pgm, Value, Value)  [function, total, symbol(invoke)]
+                 | returnedValue(Outcome)     [function, total, symbol(returnedValue)]
+                 | lookupAt(Values, Int)      [function, total, symbol(lookupAt)]
+                 | lookupEnv(String, Env)     [function, total, symbol(lookupEnv)]
+                 | subValue(Value, Value)     [function, total, symbol(subValue)]
+                 | addValue(Value, Value)     [function, total, symbol(addValue)]
+                 | negValue(Value)            [function, total, symbol(negValue)]
+                 | eqValue(Value, Value)      [function, total, symbol(eqValue)]
+                 | ltValue(Value, Value)      [function, total, symbol(ltValue)]
+                 | indexValue(Value, Int)     [function, total, symbol(indexValue)]
+                 | sliceValue(Value, Int)     [function, total, symbol(sliceValue)]
+  syntax Values ::= evalExprs(Exprs, Env, Pgm) [function, total, symbol(evalExprs)]
+                  | dropValues(Values, Int)    [function, total, symbol(dropValues)]
+                  | concatValues(Values, Values) [function, total, symbol(concatValues)]
+  syntax Outcome ::= evalStmts(Stmts, Env, Pgm) [function, total, symbol(evalStmts)]
+                   | continueWith(Outcome, Stmts, Pgm) [function, total, symbol(continueWith)]
+                   | branch(Value, Stmts, Stmts, Stmts, Env, Pgm) [function, total, symbol(branch)]
+
+  configuration <k> execute($PGM:Pgm, $GAME:Value, $GUESS:Value) </k>
+
+  rule execute(P, GAME, GUESS) => invoke(P, GAME, GUESS)
+
+  rule invoke(
+         Module(FuncDef("compare", Params("game", "guess"), BODY)),
+         GAME, GUESS)
+    => returnedValue(evalStmts(
+         BODY,
+         Bind("game", GAME, Bind("guess", GUESS, EmptyEnv)),
+         Module(FuncDef("compare", Params("game", "guess"), BODY))))
+
+  rule returnedValue(Returned(V)) => V
+
+  rule evalStmts(.Stmts, ENV, _) => Ongoing(ENV)
+  rule evalStmts(Return(E) REST, ENV, P)
+    => Returned(evalExpr(E, ENV, P))
+  rule evalStmts(Assign(Name(X), E) REST, ENV, P)
+    => evalStmts(REST, Bind(X, evalExpr(E, ENV, P), ENV), P)
+  rule evalStmts(If(COND, THEN, ELSE) REST, ENV, P)
+    => branch(evalExpr(COND, ENV, P), THEN, ELSE, REST, ENV, P)
+
+  rule branch(VBool(true), THEN, _, REST, ENV, P)
+    => continueWith(evalStmts(THEN, ENV, P), REST, P)
+  rule branch(VBool(false), _, ELSE, REST, ENV, P)
+    => continueWith(evalStmts(ELSE, ENV, P), REST, P)
+
+  rule continueWith(Ongoing(ENV), REST, P) => evalStmts(REST, ENV, P)
+  rule continueWith(Returned(V), _, _) => Returned(V)
+
+  rule evalExpr(Name(X), ENV, _) => lookupEnv(X, ENV)
+  rule evalExpr(Int(I), _, _) => VInt(I)
+  rule evalExpr(ListExpr(ES), ENV, P) => VList(evalExprs(ES, ENV, P))
+
+  rule lookupEnv(X, Bind(X, V, _)) => V
+  rule lookupEnv(X, Bind(Y, _, ENV)) => lookupEnv(X, ENV)
+    requires X =/=String Y
+
+  rule evalExprs(.Exprs, _, _) => VNil
+  rule evalExprs(E, ES, ENV, P)
+    => VCons(evalExpr(E, ENV, P), evalExprs(ES, ENV, P))
+
+  rule evalExpr(BinOp("-", L, R), ENV, P)
+    => subValue(evalExpr(L, ENV, P), evalExpr(R, ENV, P))
+  rule evalExpr(BinOp("+", L, R), ENV, P)
+    => addValue(evalExpr(L, ENV, P), evalExpr(R, ENV, P))
+  rule evalExpr(UnaryOp("-", E), ENV, P)
+    => negValue(evalExpr(E, ENV, P))
+
+  rule subValue(VInt(I), VInt(J)) => VInt(I -Int J)
+  rule addValue(VList(LS), VList(RS)) => VList(concatValues(LS, RS))
+  rule negValue(VInt(I)) => VInt(0 -Int I)
+
+  rule evalExpr(Compare(L, CmpOp("==", R)), ENV, P)
+    => eqValue(evalExpr(L, ENV, P), evalExpr(R, ENV, P))
+  rule evalExpr(Compare(L, CmpOp("<", R)), ENV, P)
+    => ltValue(evalExpr(L, ENV, P), evalExpr(R, ENV, P))
+
+  rule eqValue(VList(VNil), VList(VNil)) => VBool(true)
+  rule eqValue(VList(VNil), VList(VCons(_, _))) => VBool(false)
+  rule eqValue(VList(VCons(_, _)), VList(VNil)) => VBool(false)
+  rule ltValue(VInt(I), VInt(J)) => VBool(I <Int J)
+
+  rule evalExpr(Subscript(E, Int(N)), ENV, P)
+    => indexValue(evalExpr(E, ENV, P), N)
+  rule evalExpr(Subscript(E, Slice(Int(N), NoBound, NoBound)), ENV, P)
+    => sliceValue(evalExpr(E, ENV, P), N)
+
+  rule indexValue(VList(VS), N) => lookupAt(VS, N)
+    requires 0 <=Int N
+  rule sliceValue(VList(VS), N) => VList(dropValues(VS, N))
+    requires 0 <=Int N
+
+  rule evalExpr(Call(Name("compare"), GAME, GUESS), ENV, P)
+    => execute(P, evalExpr(GAME, ENV, P), evalExpr(GUESS, ENV, P))
+
+  rule lookupAt(VCons(V, _), 0) => V
+  rule lookupAt(VCons(_, VS), N) => lookupAt(VS, N -Int 1)
+    requires N >Int 0
+
+  rule dropValues(VS, 0) => VS
+  rule dropValues(VNil, N) => VNil
+    requires N >Int 0
+  rule dropValues(VCons(_, VS), N) => dropValues(VS, N -Int 1)
+    requires N >Int 0
+
+  rule concatValues(VNil, VS) => VS
+  rule concatValues(VCons(V, VS), WS) => VCons(V, concatValues(VS, WS))
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..9938b06be47fc1ed0fed1c2757e3ce3bf34211d2
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,7 @@
+def compare(game, guess):
+    if game == []:
+        return []
+    difference = game[0] - guess[0]
+    if difference < 0:
+        difference = -difference
+    return [difference] + compare(game[1:], guess[1:])
