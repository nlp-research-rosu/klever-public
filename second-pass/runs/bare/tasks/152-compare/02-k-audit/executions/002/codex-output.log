@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd /tmp/audit-work/152-compare
+
+printf 'SOURCE semantic.k\n'
+nl -ba semantic.k
+printf 'SOURCE verification.k\n'
