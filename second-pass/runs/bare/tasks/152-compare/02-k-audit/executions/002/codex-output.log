+printf 'DECLARATION_AND_RULE_INDEX\n'
+rg -n \
+  '^\s*rule\b|^\s*syntax\b|^\s*configuration\b|^\s*claim\b|\[(?:[^]]*\b(?:function|functional|total|simplification|priority|owise)\b[^]]*)\]' \
