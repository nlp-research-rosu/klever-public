+
+def digest(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open("rb") as inp:
+        for block in iter(lambda: inp.read(1024 * 1024), b""):
+            h.update(block)
+    return h.hexdigest()
+
+
+def regular_nonsymlink(path: Path) -> bool:
+    return path.is_file() and not path.is_symlink()
+
