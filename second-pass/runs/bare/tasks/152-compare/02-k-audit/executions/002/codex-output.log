+count="$(rg -c '\[(?:[^]]*\b(?:simplification|priority|owise)\b[^]]*)\]' semantic.k verification.k spec.k || true)"
+if [[ -z "$count" ]]; then
+  count=0
+fi
+printf '%s\n' "$count"

