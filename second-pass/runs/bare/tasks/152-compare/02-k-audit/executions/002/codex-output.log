+    elif path.is_dir():
+        print(f"  DIR {rel}")
+    elif path.is_file():
+        print(f"  FILE {rel} size={path.stat().st_size} sha256={digest(path)}")
+    else:
+        print(f"  OTHER {rel}")
+
