     2	  FuncDef("compare", Params("game", "guess"),
     3	    If(Compare(Name("game"), CmpOp("==", ListExpr())),
     4	      Return(ListExpr()),
     5	      )
     6	    Assign(
     7	      Name("difference"),
     8	      BinOp(
     9	        "-",
    10	        Subscript(Name("game"), Int(0)),
    11	        Subscript(Name("guess"), Int(0))))
    12	    If(Compare(Name("difference"), CmpOp("<", Int(0))),
    13	      Assign(Name("difference"), UnaryOp("-", Name("difference"))),
