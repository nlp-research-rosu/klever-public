      "start_line": 9,
      "text": "  rule solutionProgram =>\n    Module(\n      FuncDef(\"compare\", Params(\"game\", \"guess\"),\n        If(Compare(Name(\"game\"), CmpOp(\"==\", ListExpr(.Exprs))),\n          Return(ListExpr(.Exprs)),\n          .Stmts)\n        Assign(\n          Name(\"difference\"),\n          BinOp(\"-\",\n            Subscript(Name(\"game\"), Int(0)),\n            Subscript(Name(\"guess\"), Int(0))))\n        If(Compare(Name(\"difference\"), CmpOp(\"<\", Int(0))),\n          Assign(Name(\"difference\"), UnaryOp(\"-\", Name(\"difference\"))),\n          .Stmts)\n        Return(\n          BinOp(\"+\",\n            ListExpr(Name(\"difference\")),\n            Call(Name(\"compare\"),\n              Subscript(Name(\"game\"), Slice(Int(1), NoBound, NoBound)),\n              Subscript(Name(\"guess\"), Slice(Int(1), NoBound, NoBound)))))))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION",
      "normalized_sha256": "ae62c27ad3424040225a1c94838f791abd610e6519a372c5656fbe1ebabf000e",
      "rationale": "Defines the base case of the recursive expected-output summary when the game list is empty.",
      "source_rule_id": "rule-ae62c27ad3424040225a1c94838f791abd610e6519a372c5656fbe1ebabf000e",
      "start_line": 34,
      "text": "  rule expected(GS, _) => VNil\n    requires isEmptyValues(GS)"
    },
    {
      "attributes": [],
