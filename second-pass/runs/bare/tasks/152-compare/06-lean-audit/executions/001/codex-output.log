+            "source_rule_id": source_rule_id,
+            "source_span_exact": True,
+        }
+    )
+
+record("per-rule independent span/hash/identity reconstruction", reconstructed)
+print(
+    json.dumps(
+        {"all_passed": True, "facts": facts},
+        indent=2,
+        sort_keys=True,
+    )
