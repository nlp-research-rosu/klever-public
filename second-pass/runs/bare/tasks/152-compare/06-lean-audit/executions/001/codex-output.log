+
+audit_input = read_json(Path("/audit-input.json"))
+resolution, resolved_digest = stage6_resolution_contract.verify_audit_input(
+    audit_input
+)
+checks.append(
+    {
+        "name": "Stage 6 envelope and canonical resolution digest",
+        "pass": True,
