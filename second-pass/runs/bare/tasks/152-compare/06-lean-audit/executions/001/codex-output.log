codex
I found the concrete environment defect: processes report an inner PID (for example `2`), while `/proc` exposes outer PIDs, and Lean 4.22 resolves its executable through `/proc/<getpid()>/exe`. That makes both `lean` and Lake installation detection fail even though the pinned binaries are present. I’m applying a narrow audit-only preload shim that rewrites only self-executable `readlink` requests to `/proc/self/exe`; this does not alter the generated sources or proof logic.
apply patch
patch: completed
/tmp/audit-work/lean_proc_self_shim.c
diff --git a//tmp/audit-work/lean_proc_self_shim.c b//tmp/audit-work/lean_proc_self_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..4bb22852335b5f36d0ea32d092b54ffdb242a03d
--- /dev/null
+++ b//tmp/audit-work/lean_proc_self_shim.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    char expected[64];
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    snprintf(expected, sizeof(expected), "/proc/%ld/exe", (long)getpid());
+    if (strcmp(path, expected) == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}

