+    passed = observed == expected
+    checks.append(
+        {
+            "name": name,
+            "pass": passed,
+            "observed": observed,
+            "expected": expected,
+        }
+    )
+    if not passed:
+        raise AssertionError(
+            f"{name}: observed {observed!r}, expected {expected!r}"
+        )
