+final_status=0
+if [[
+  "$dry_status" != 0 ||
+  "$proof_status" == 0 ||
+  "$residual_status" != 0
+]]; then
+  final_status=1
+fi
+printf 'SCRIPT_EXIT=%s\n' "$final_status"
+exit "$final_status"
