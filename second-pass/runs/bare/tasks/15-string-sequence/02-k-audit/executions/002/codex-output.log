--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def string_sequence(n: int) -> str:
+    if n < 0:
+        return ""
+    result = "0"
+    i = 1
+    while i <= n:
+        result = result + " " + str(i)
+        i = i + 1
+    return result
