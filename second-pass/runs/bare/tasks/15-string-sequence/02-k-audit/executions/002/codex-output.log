+  residual_status=0
+fi
+printf 'meaningful_stuck_residual=%s\n' "$((1 - residual_status))"
+
+final_status=0
+if [[
+  "$build_status" != 0 ||
+  "$proof_status" == 0 ||
+  "$residual_status" != 0
+]]; then
+  final_status=1
+fi
+printf 'SCRIPT_EXIT=%s\n' "$final_status"
