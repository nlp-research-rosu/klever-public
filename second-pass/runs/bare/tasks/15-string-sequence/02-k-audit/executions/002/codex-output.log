from pathlib import Path
import sys

prompt = Path(sys.argv[1]).read_bytes()
replacements = (
    (b"__PROBLEM_ID__", sys.argv[2].encode()),
    (b"__CONDITION__", sys.argv[3].encode()),
    (b"__SEMANTICS_MODE__", sys.argv[4].encode()),
)
for placeholder, value in replacements:
