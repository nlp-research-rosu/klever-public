MODEL_PGID=$!
wait "$MODEL_PGID"
MODEL_EXIT_CODE=$?
terminate_model_group "$MODEL_PGID"
MODEL_PGID=""
END_EPOCH="$(date +%s)" || mark_harness_error "cannot record audit end time"

publish_regular_file \
