+#!/usr/bin/env python3
+"""Compare fresh generated-semantics execution to both Python implementations."""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import re
+import shlex
+import subprocess
+from pathlib import Path
+
+
+def load_entry(path: Path, module_name: str):
