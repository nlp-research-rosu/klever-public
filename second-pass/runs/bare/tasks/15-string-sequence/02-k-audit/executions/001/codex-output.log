+requires "verification.k"
+
+module AUDIT-LOOP-CLAIM
+  imports VERIFICATION
+
+  claim
+    <mpy>
+      <k> exec(While(loopCondition(), loopBody())) ~> KREST
+         => KREST </k>
+      <env>
+        ( "i"      |-> IVal(I)
+          "n"      |-> IVal(N)
+          "result" |-> SVal(S)
+          REST
+        =>
+          "i"      |-> IVal(indexAfter(I, N))
+          "n"      |-> IVal(N)
+          "result" |-> SVal(sequenceFrom(I, N, S))
+          REST )
+      </env>
+      <functions> _FUNCTIONS </functions>
+      <stack> _STACK </stack>
+    </mpy>
+    requires I >=Int 1 andBool N >=Int 0
+endmodule
+
+module AUDIT-UNIVERSAL-ENTRY
+  imports AUDIT-LOOP-CLAIM
+
+  claim
+    <mpy>
+      <k> init(targetProgram(), N) => SVal(sequence(N)) </k>
+      <env> .Map </env>
+      <functions>
+        .Map => "string_sequence" |-> targetFunction()
+      </functions>
+      <stack> .List </stack>
+    </mpy>
+endmodule
+
+module AUDIT-EXAMPLE-ZERO
+  imports AUDIT-LOOP-CLAIM
+
+  claim
+    <mpy>
+      <k> init(targetProgram(), 0) => SVal("0") </k>
+      <env> .Map </env>
+      <functions>
+        .Map => "string_sequence" |-> targetFunction()
+      </functions>
+      <stack> .List </stack>
+    </mpy>
+endmodule
+
+module AUDIT-EXAMPLE-FIVE
+  imports AUDIT-LOOP-CLAIM
+
+  claim
+    <mpy>
+      <k> init(targetProgram(), 5) => SVal("0 1 2 3 4 5") </k>
+      <env> .Map </env>
+      <functions>
+        .Map => "string_sequence" |-> targetFunction()
+      </functions>
+      <stack> .List </stack>
+    </mpy>
+endmodule
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..47cc79551aeda1a9bc0f2863dd6918380f14948d
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOGFILE COMMAND [ARG ...]" >&2
+  exit 2
+fi
+
+logfile=$1
+shift
+capture_file=$(mktemp /tmp/audit-log-capture.XXXXXX)
+trap 'rm -f "$capture_file"' EXIT
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+} > "$logfile"
+
+"$@" >"$capture_file" 2>&1
+status=$?
+tee -a "$logfile" <"$capture_file"
+printf 'EXIT_STATUS: %d\n' "$status" | tee -a "$logfile"
+exit "$status"
