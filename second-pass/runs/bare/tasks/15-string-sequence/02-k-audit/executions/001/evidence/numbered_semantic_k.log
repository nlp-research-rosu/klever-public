COMMAND: nl -ba semantic.k
WORKDIR: /tmp/audit-work/rebuild
     1	requires "domains.md"
     2	
     3	module MPY-SYNTAX
     4	  imports INT-SYNTAX
     5	  imports STRING-SYNTAX
     6	  imports BOOL-SYNTAX
     7	
     8	  syntax Module ::= "Module" "(" Stmts ")"
     9	
    10	  syntax Stmts ::= List{Stmt, ""}
    11	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
    12	                | "Assign" "(" Expr "," Expr ")"
    13	                | "If" "(" Expr "," Stmts "," Stmts ")"
    14	                | "While" "(" Expr "," Stmts ")"
    15	                | "Return" "(" Expr ")"
    16	
    17	  syntax Params ::= "Params" "(" String ")"
    18	
    19	  syntax Expr ::= "Int" "(" Int ")"
    20	                | "Str" "(" String ")"
    21	                | "Name" "(" String ")"
    22	                | "BinOp" "(" String "," Expr "," Expr ")"
    23	                | "Compare" "(" Expr "," CmpOp ")"
    24	                | "Call" "(" Expr "," Expr ")"
    25	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    26	endmodule
    27	
    28	module MPY
    29	  imports MPY-SYNTAX
    30	  imports INT
    31	  imports STRING
    32	  imports BOOL
    33	  imports MAP
    34	  imports LIST
    35	
    36	  syntax Val ::= IVal(Int) | SVal(String) | BVal(Bool)
    37	  syntax Function ::= function(String, Stmts)
    38	  syntax Frame ::= frame(Map, K)
    39	
    40	  syntax KItem ::= init(Module, Int)
    41	                 | run(Stmts)
    42	                 | exec(Stmt)
    43	                 | eval(Expr)
    44	                 | store(String)
    45	                 | binLeft(String, Expr)
    46	                 | binRight(String, Val)
    47	                 | cmpLeft(String, Expr)
    48	                 | cmpRight(String, Val)
    49	                 | ifGuard(Stmts, Stmts)
    50	                 | whileGuard(Expr, Stmts)
    51	                 | call(String)
    52	                 | toStr()
    53	                 | returning()
    54	                 | functionEnd()
    55	
    56	  configuration
    57	    <mpy>
    58	      <k> init($PGM:Module, $ARG:Int) </k>
    59	      <env> .Map </env>
    60	      <functions> .Map </functions>
    61	      <stack> .List </stack>
    62	    </mpy>
    63	
    64	  rule <k> init(Module(SS), N)
    65	         => run(SS)
    66	         ~> eval(Call(Name("string_sequence"), Int(N))) ... </k>
    67	
    68	  rule run(.Stmts) => .K
    69	  rule run(S SS) => exec(S) ~> run(SS)
    70	
    71	  rule <k> exec(FuncDef(F, Params(P), BODY)) => .K ... </k>
    72	       <functions> FS => FS [ F <- function(P, BODY) ] </functions>
    73	
    74	  rule <k> exec(Assign(Name(X), E)) => eval(E) ~> store(X) ... </k>
    75	  rule <k> V:Val ~> store(X) => .K ... </k>
    76	       <env> ... X |-> (_ => V) ... </env>
    77	  rule <k> V:Val ~> store(X) => .K ... </k>
    78	       <env> ENV => X |-> V ENV </env>
    79	       requires notBool (X in_keys(ENV))
    80	
    81	  rule <k> exec(While(COND, BODY))
    82	         => eval(COND) ~> whileGuard(COND, BODY) ... </k>
    83	  rule BVal(true) ~> whileGuard(COND, BODY)
    84	       => run(BODY) ~> exec(While(COND, BODY))
    85	  rule BVal(false) ~> whileGuard(_, _) => .K
    86	
    87	  rule <k> exec(If(COND, THEN, ELSE))
    88	         => eval(COND) ~> ifGuard(THEN, ELSE) ... </k>
    89	  rule BVal(true) ~> ifGuard(THEN, _) => run(THEN)
    90	  rule BVal(false) ~> ifGuard(_, ELSE) => run(ELSE)
    91	
    92	  rule <k> exec(Return(E)) => eval(E) ~> returning() ... </k>
    93	  rule <k> V:Val ~> returning() ~> _REST:K => V ~> KREST </k>
    94	       <env> _ => CALLER </env>
    95	       <stack> ListItem(frame(CALLER, KREST)) STACK => STACK </stack>
    96	
    97	  rule eval(Int(I)) => IVal(I)
    98	  rule eval(Str(S)) => SVal(S)
    99	  rule <k> eval(Name(X)) => V ... </k>
   100	       <env> ... X |-> V ... </env>
   101	
   102	  rule eval(BinOp(OP, E1, E2)) => eval(E1) ~> binLeft(OP, E2)
   103	  rule V:Val ~> binLeft(OP, E2) => eval(E2) ~> binRight(OP, V)
   104	  rule IVal(I2) ~> binRight("+", IVal(I1)) => IVal(I1 +Int I2)
   105	  rule SVal(S2) ~> binRight("+", SVal(S1)) => SVal(S1 +String S2)
   106	
   107	  rule eval(Compare(E1, CmpOp(OP, E2)))
   108	       => eval(E1) ~> cmpLeft(OP, E2)
   109	  rule V:Val ~> cmpLeft("<=", E2) => eval(E2) ~> cmpRight("<=", V)
   110	  rule IVal(I2) ~> cmpRight("<=", IVal(I1)) => BVal(I1 <=Int I2)
   111	  rule V:Val ~> cmpLeft("<", E2) => eval(E2) ~> cmpRight("<", V)
   112	  rule IVal(I2) ~> cmpRight("<", IVal(I1)) => BVal(I1 <Int I2)
   113	
   114	  rule eval(Call(Name("str"), E)) => eval(E) ~> toStr()
   115	  rule IVal(I) ~> toStr() => SVal(Int2String(I))
   116	
   117	  rule <k> eval(Call(Name(F), E)) => eval(E) ~> call(F) ... </k>
   118	       <functions> ... F |-> function(_, _) ... </functions>
   119	       requires F =/=String "str"
   120	  rule <k> V:Val ~> call(F) ~> KREST
   121	         => run(BODY) ~> functionEnd() </k>
   122	       <env> CALLER => P |-> V </env>
   123	       <functions> ... F |-> function(P, BODY) ... </functions>
   124	       <stack> STACK => ListItem(frame(CALLER, KREST)) STACK </stack>
   125	endmodule
EXIT_STATUS: 0
