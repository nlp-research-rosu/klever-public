COMMAND: nl -ba verification.k
WORKDIR: /tmp/audit-work/rebuild
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  syntax String ::= sequenceFrom(Int, Int, String) [function]
     7	                  | sequence(Int) [function]
     8	  syntax Int ::= indexAfter(Int, Int) [function]
     9	  syntax Expr ::= loopCondition() [function]
    10	  syntax Stmts ::= loopBody() [function]
    11	                   | targetBody() [function]
    12	  syntax Function ::= targetFunction() [function]
    13	  syntax Module ::= targetProgram() [function]
    14	
    15	  rule sequenceFrom(I, N, S)
    16	       => sequenceFrom(I +Int 1, N, S +String " " +String Int2String(I))
    17	       requires I <=Int N
    18	  rule sequenceFrom(I, N, S) => S
    19	       requires I >Int N
    20	
    21	  rule sequence(N) => "" requires N <Int 0
    22	  rule sequence(N) => sequenceFrom(1, N, "0") requires N >=Int 0
    23	
    24	  rule indexAfter(I, N) => indexAfter(I +Int 1, N)
    25	       requires I <=Int N
    26	  rule indexAfter(I, N) => I
    27	       requires I >Int N
    28	
    29	  rule loopCondition()
    30	       => Compare(Name("i"), CmpOp("<=", Name("n")))
    31	
    32	  rule loopBody()
    33	       => Assign(
    34	            Name("result"),
    35	            BinOp(
    36	              "+",
    37	              BinOp("+", Name("result"), Str(" ")),
    38	              Call(Name("str"), Name("i"))))
    39	          Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
    40	
    41	  rule targetBody()
    42	       => If(
    43	            Compare(Name("n"), CmpOp("<", Int(0))),
    44	            Return(Str("")),
    45	            .Stmts)
    46	          Assign(Name("result"), Str("0"))
    47	          Assign(Name("i"), Int(1))
    48	          While(loopCondition(), loopBody())
    49	          Return(Name("result"))
    50	
    51	  rule targetFunction() => function("n", targetBody())
    52	  rule targetProgram()
    53	       => Module(FuncDef("string_sequence", Params("n"), targetBody()))
    54	endmodule
EXIT_STATUS: 0
