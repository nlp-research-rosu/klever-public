COMMAND: rg -n \^\\s\*\(syntax\|configuration\|rule\|claim\|requires\|module\|endmodule\) semantic.k verification.k spec.k
WORKDIR: /tmp/audit-work/rebuild
spec.k:1:requires "verification.k"
spec.k:3:module SPEC
spec.k:6:  claim
spec.k:24:    requires I >=Int 1 andBool N >=Int 0
spec.k:26:  claim
spec.k:35:  claim
spec.k:45:  claim
spec.k:54:endmodule
verification.k:1:requires "semantic.k"
verification.k:3:module VERIFICATION
verification.k:6:  syntax String ::= sequenceFrom(Int, Int, String) [function]
verification.k:8:  syntax Int ::= indexAfter(Int, Int) [function]
verification.k:9:  syntax Expr ::= loopCondition() [function]
verification.k:10:  syntax Stmts ::= loopBody() [function]
verification.k:12:  syntax Function ::= targetFunction() [function]
verification.k:13:  syntax Module ::= targetProgram() [function]
verification.k:15:  rule sequenceFrom(I, N, S)
verification.k:17:       requires I <=Int N
verification.k:18:  rule sequenceFrom(I, N, S) => S
verification.k:19:       requires I >Int N
verification.k:21:  rule sequence(N) => "" requires N <Int 0
verification.k:22:  rule sequence(N) => sequenceFrom(1, N, "0") requires N >=Int 0
verification.k:24:  rule indexAfter(I, N) => indexAfter(I +Int 1, N)
verification.k:25:       requires I <=Int N
verification.k:26:  rule indexAfter(I, N) => I
verification.k:27:       requires I >Int N
verification.k:29:  rule loopCondition()
verification.k:32:  rule loopBody()
verification.k:41:  rule targetBody()
verification.k:51:  rule targetFunction() => function("n", targetBody())
verification.k:52:  rule targetProgram()
verification.k:54:endmodule
semantic.k:1:requires "domains.md"
semantic.k:3:module MPY-SYNTAX
semantic.k:8:  syntax Module ::= "Module" "(" Stmts ")"
semantic.k:10:  syntax Stmts ::= List{Stmt, ""}
semantic.k:11:  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
semantic.k:17:  syntax Params ::= "Params" "(" String ")"
semantic.k:19:  syntax Expr ::= "Int" "(" Int ")"
semantic.k:25:  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
semantic.k:26:endmodule
semantic.k:28:module MPY
semantic.k:36:  syntax Val ::= IVal(Int) | SVal(String) | BVal(Bool)
semantic.k:37:  syntax Function ::= function(String, Stmts)
semantic.k:38:  syntax Frame ::= frame(Map, K)
semantic.k:40:  syntax KItem ::= init(Module, Int)
semantic.k:56:  configuration
semantic.k:64:  rule <k> init(Module(SS), N)
semantic.k:68:  rule run(.Stmts) => .K
semantic.k:69:  rule run(S SS) => exec(S) ~> run(SS)
semantic.k:71:  rule <k> exec(FuncDef(F, Params(P), BODY)) => .K ... </k>
semantic.k:74:  rule <k> exec(Assign(Name(X), E)) => eval(E) ~> store(X) ... </k>
semantic.k:75:  rule <k> V:Val ~> store(X) => .K ... </k>
semantic.k:77:  rule <k> V:Val ~> store(X) => .K ... </k>
semantic.k:79:       requires notBool (X in_keys(ENV))
semantic.k:81:  rule <k> exec(While(COND, BODY))
semantic.k:83:  rule BVal(true) ~> whileGuard(COND, BODY)
semantic.k:85:  rule BVal(false) ~> whileGuard(_, _) => .K
semantic.k:87:  rule <k> exec(If(COND, THEN, ELSE))
semantic.k:89:  rule BVal(true) ~> ifGuard(THEN, _) => run(THEN)
semantic.k:90:  rule BVal(false) ~> ifGuard(_, ELSE) => run(ELSE)
semantic.k:92:  rule <k> exec(Return(E)) => eval(E) ~> returning() ... </k>
semantic.k:93:  rule <k> V:Val ~> returning() ~> _REST:K => V ~> KREST </k>
semantic.k:97:  rule eval(Int(I)) => IVal(I)
semantic.k:98:  rule eval(Str(S)) => SVal(S)
semantic.k:99:  rule <k> eval(Name(X)) => V ... </k>
semantic.k:102:  rule eval(BinOp(OP, E1, E2)) => eval(E1) ~> binLeft(OP, E2)
semantic.k:103:  rule V:Val ~> binLeft(OP, E2) => eval(E2) ~> binRight(OP, V)
semantic.k:104:  rule IVal(I2) ~> binRight("+", IVal(I1)) => IVal(I1 +Int I2)
semantic.k:105:  rule SVal(S2) ~> binRight("+", SVal(S1)) => SVal(S1 +String S2)
semantic.k:107:  rule eval(Compare(E1, CmpOp(OP, E2)))
semantic.k:109:  rule V:Val ~> cmpLeft("<=", E2) => eval(E2) ~> cmpRight("<=", V)
semantic.k:110:  rule IVal(I2) ~> cmpRight("<=", IVal(I1)) => BVal(I1 <=Int I2)
semantic.k:111:  rule V:Val ~> cmpLeft("<", E2) => eval(E2) ~> cmpRight("<", V)
semantic.k:112:  rule IVal(I2) ~> cmpRight("<", IVal(I1)) => BVal(I1 <Int I2)
semantic.k:114:  rule eval(Call(Name("str"), E)) => eval(E) ~> toStr()
semantic.k:115:  rule IVal(I) ~> toStr() => SVal(Int2String(I))
semantic.k:117:  rule <k> eval(Call(Name(F), E)) => eval(E) ~> call(F) ... </k>
semantic.k:119:       requires F =/=String "str"
semantic.k:120:  rule <k> V:Val ~> call(F) ~> KREST
semantic.k:125:endmodule
EXIT_STATUS: 0
