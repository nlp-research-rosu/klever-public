+require "domains.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+  imports BOOL-SYNTAX
+
+  syntax Module ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Str" "(" String ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "Call" "(" Expr "," Expr ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports STRING
+  imports BOOL
+  imports MAP
+  imports LIST
+
+  syntax Val ::= IVal(Int) | SVal(String) | BVal(Bool)
+  syntax Function ::= function(String, Stmts)
+  syntax Frame ::= frame(Map)
+
+  syntax KItem ::= init(Module, Int)
+                 | run(Stmts)
+                 | exec(Stmt)
+                 | eval(Expr)
+                 | store(String)
+                 | binLeft(String, Expr)
+                 | binRight(String, Val)
+                 | cmpRight(String, Val)
+                 | whileGuard(Expr, Stmts)
+                 | call(String)
+                 | toStr
+                 | returning
+                 | functionEnd
+
+  configuration
+    <mpy>
+      <k> init($PGM:Module, $ARG:Int) </k>
