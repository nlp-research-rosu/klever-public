new file mode 100644
index 0000000000000000000000000000000000000000..6e612bd6c137c711f03f14c968b6d32db3ccd2f0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,54 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim
+    <mpy>
+      <k> exec(While(loopCondition(), loopBody())) ~> KREST
+         => KREST </k>
+      <env>
+        ( "i"      |-> IVal(I)
+          "n"      |-> IVal(N)
+          "result" |-> SVal(S)
+          REST
+        =>
+          "i"      |-> IVal(indexAfter(I, N))
+          "n"      |-> IVal(N)
+          "result" |-> SVal(sequenceFrom(I, N, S))
+          REST )
+      </env>
+      <functions> _FUNCTIONS </functions>
+      <stack> _STACK </stack>
+    </mpy>
+    requires I >=Int 1 andBool N >=Int 0
+
+  claim
+    <mpy>
+      <k> init(targetProgram(), N) => SVal(sequence(N)) </k>
+      <env> .Map </env>
+      <functions>
+        .Map => "string_sequence" |-> targetFunction()
+      </functions>
+      <stack> .List </stack>
+    </mpy>
+  claim
+    <mpy>
+      <k> init(targetProgram(), 0) => SVal("0") </k>
+      <env> .Map </env>
+      <functions>
+        .Map => "string_sequence" |-> targetFunction()
+      </functions>
+      <stack> .List </stack>
+    </mpy>
+
+  claim
+    <mpy>
+      <k> init(targetProgram(), 5) => SVal("0 1 2 3 4 5") </k>
+      <env> .Map </env>
+      <functions>
+        .Map => "string_sequence" |-> targetFunction()
+      </functions>
+      <stack> .List </stack>
+    </mpy>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..801be4968c62a889a1452aa9e70e4a457d88ea20
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,54 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  syntax String ::= sequenceFrom(Int, Int, String) [function]
+                  | sequence(Int) [function]
+  syntax Int ::= indexAfter(Int, Int) [function]
+  syntax Expr ::= loopCondition() [function]
+  syntax Stmts ::= loopBody() [function]
+                   | targetBody() [function]
+  syntax Function ::= targetFunction() [function]
+  syntax Module ::= targetProgram() [function]
+
+  rule sequenceFrom(I, N, S)
+       => sequenceFrom(I +Int 1, N, S +String " " +String Int2String(I))
+       requires I <=Int N
+  rule sequenceFrom(I, N, S) => S
+       requires I >Int N
+
+  rule sequence(N) => "" requires N <Int 0
+  rule sequence(N) => sequenceFrom(1, N, "0") requires N >=Int 0
+
+  rule indexAfter(I, N) => indexAfter(I +Int 1, N)
+       requires I <=Int N
+  rule indexAfter(I, N) => I
+       requires I >Int N
+
+  rule loopCondition()
+       => Compare(Name("i"), CmpOp("<=", Name("n")))
+
+  rule loopBody()
+       => Assign(
+            Name("result"),
+            BinOp(
+              "+",
+              BinOp("+", Name("result"), Str(" ")),
+              Call(Name("str"), Name("i"))))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+
+  rule targetBody()
+       => If(
+            Compare(Name("n"), CmpOp("<", Int(0))),
+            Return(Str("")),
+            .Stmts)
+          Assign(Name("result"), Str("0"))
+          Assign(Name("i"), Int(1))
+          While(loopCondition(), loopBody())
+          Return(Name("result"))
+
+  rule targetFunction() => function("n", targetBody())
+  rule targetProgram()
+       => Module(FuncDef("string_sequence", Params("n"), targetBody()))
+endmodule

