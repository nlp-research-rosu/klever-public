+      <env> .Map </env>
+      <functions>
+        .Map => "string_sequence" |-> targetFunction()
+      </functions>
+      <stack> .List </stack>
+    </mpy>
+
+  claim
+    <mpy>
+      <k> init(targetProgram(), 5) => SVal("0 1 2 3 4 5") </k>
+      <env> .Map </env>
+      <functions>
