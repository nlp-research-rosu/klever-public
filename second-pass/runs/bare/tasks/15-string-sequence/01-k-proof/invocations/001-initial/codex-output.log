index 0000000000000000000000000000000000000000..ee19d3e53aab9bc17f4f5e278a5fd4395656301c
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,7 @@
+def string_sequence(n: int) -> str:
+    result = "0"
+    i = 1
+    while i <= n:
+        result = result + " " + str(i)
+        i = i + 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d5549e1749b643ff8a8c4d78c60b1400b6b86163
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,57 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim
+    <mpy>
+      <k> exec(While(loopCondition(), loopBody())) ~> KREST
+         => KREST </k>
+      <env>
+        ( "i"      |-> IVal(I)
+          "n"      |-> IVal(N)
+          "result" |-> SVal(S)
+          REST
+        =>
+          "i"      |-> IVal(indexAfter(I, N))
+          "n"      |-> IVal(N)
+          "result" |-> SVal(sequenceFrom(I, N, S))
+          REST )
+      </env>
+      <functions> FUNCTIONS </functions>
+      <stack> STACK </stack>
+    </mpy>
+    requires I >=Int 1 andBool N >=Int 0
+
+  claim
+    <mpy>
+      <k> init(targetProgram(), N)
+         => SVal(sequenceFrom(1, N, "0")) </k>
+      <env> .Map </env>
+      <functions>
+        .Map => "string_sequence" |-> targetFunction()
+      </functions>
+      <stack> .List </stack>
+    </mpy>
+    requires N >=Int 0
+
+  claim
+    <mpy>
+      <k> init(targetProgram(), 0) => SVal("0") </k>
+      <env> .Map </env>
+      <functions>
+        .Map => "string_sequence" |-> targetFunction()
+      </functions>
+      <stack> .List </stack>
+    </mpy>
+
+  claim
+    <mpy>
+      <k> init(targetProgram(), 5) => SVal("0 1 2 3 4 5") </k>
+      <env> .Map </env>
+      <functions>
+        .Map => "string_sequence" |-> targetFunction()
+      </functions>
+      <stack> .List </stack>
+    </mpy>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..aa3fcb5af73560fc1d08bb115fc72f9291f8dff9
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,46 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  syntax String ::= sequenceFrom(Int, Int, String) [function]
+  syntax Int ::= indexAfter(Int, Int) [function]
+  syntax Expr ::= loopCondition() [function]
+  syntax Stmts ::= loopBody() [function]
+                   | targetBody() [function]
+  syntax Function ::= targetFunction() [function]
+  syntax Module ::= targetProgram() [function]
+
+  rule sequenceFrom(I, N, S)
+       => sequenceFrom(I +Int 1, N, S +String " " +String Int2String(I))
+       requires I <=Int N
+  rule sequenceFrom(I, N, S) => S
+       requires I >Int N
+
+  rule indexAfter(I, N) => indexAfter(I +Int 1, N)
+       requires I <=Int N
+  rule indexAfter(I, N) => I
+       requires I >Int N
+
+  rule loopCondition()
+       => Compare(Name("i"), CmpOp("<=", Name("n")))
+
+  rule loopBody()
+       => Assign(
+            Name("result"),
+            BinOp(
+              "+",
+              BinOp("+", Name("result"), Str(" ")),
+              Call(Name("str"), Name("i"))))
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1)))
+
+  rule targetBody()
+       => Assign(Name("result"), Str("0"))
+          Assign(Name("i"), Int(1))
+          While(loopCondition(), loopBody())
+          Return(Name("result"))
+
+  rule targetFunction() => function("n", targetBody())
+  rule targetProgram()
+       => Module(FuncDef("string_sequence", Params("n"), targetBody()))
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX >/tmp/kompile-verification.out && kprove spec.k --definition verification-kompiled --spec-module SPEC' in /work
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..220d165412695f9bcb66fc15ba9c97399d78a62a
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,116 @@
+requires "domains.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+  imports BOOL-SYNTAX
+
+  syntax Module ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Str" "(" String ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "Call" "(" Expr "," Expr ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports STRING
+  imports BOOL
+  imports MAP
+  imports LIST
+
+  syntax Val ::= IVal(Int) | SVal(String) | BVal(Bool)
+  syntax Function ::= function(String, Stmts)
+  syntax Frame ::= frame(Map, K)
+
+  syntax KItem ::= init(Module, Int)
+                 | run(Stmts)
+                 | exec(Stmt)
+                 | eval(Expr)
+                 | store(String)
+                 | binLeft(String, Expr)
+                 | binRight(String, Val)
+                 | cmpLeft(String, Expr)
+                 | cmpRight(String, Val)
+                 | whileGuard(Expr, Stmts)
+                 | call(String)
+                 | toStr()
+                 | returning()
+                 | functionEnd()
+
+  configuration
+    <mpy>
+      <k> init($PGM:Module, $ARG:Int) </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <stack> .List </stack>
+    </mpy>
+
+  rule <k> init(Module(SS), N)
+         => run(SS)
+         ~> eval(Call(Name("string_sequence"), Int(N))) ... </k>
+
+  rule run(.Stmts) => .K
+  rule run(S SS) => exec(S) ~> run(SS)
+
+  rule <k> exec(FuncDef(F, Params(P), BODY)) => .K ... </k>
+       <functions> FS => FS [ F <- function(P, BODY) ] </functions>
+
+  rule <k> exec(Assign(Name(X), E)) => eval(E) ~> store(X) ... </k>
+  rule <k> V:Val ~> store(X) => .K ... </k>
+       <env> ... X |-> (_ => V) ... </env>
+  rule <k> V:Val ~> store(X) => .K ... </k>
+       <env> ENV => X |-> V ENV </env>
+       requires notBool (X in_keys(ENV))
+
+  rule <k> exec(While(COND, BODY))
+         => eval(COND) ~> whileGuard(COND, BODY) ... </k>
+  rule BVal(true) ~> whileGuard(COND, BODY)
+       => run(BODY) ~> exec(While(COND, BODY))
+  rule BVal(false) ~> whileGuard(_, _) => .K
+
+  rule <k> exec(Return(E)) => eval(E) ~> returning() ... </k>
+  rule <k> V:Val ~> returning() ~> _REST:K => V ~> KREST </k>
+       <env> _ => CALLER </env>
+       <stack> ListItem(frame(CALLER, KREST)) STACK => STACK </stack>
+
+  rule eval(Int(I)) => IVal(I)
+  rule eval(Str(S)) => SVal(S)
+  rule <k> eval(Name(X)) => V ... </k>
+       <env> ... X |-> V ... </env>
+
+  rule eval(BinOp(OP, E1, E2)) => eval(E1) ~> binLeft(OP, E2)
+  rule V:Val ~> binLeft(OP, E2) => eval(E2) ~> binRight(OP, V)
+  rule IVal(I2) ~> binRight("+", IVal(I1)) => IVal(I1 +Int I2)
+  rule SVal(S2) ~> binRight("+", SVal(S1)) => SVal(S1 +String S2)
+
+  rule eval(Compare(E1, CmpOp(OP, E2)))
+       => eval(E1) ~> cmpLeft(OP, E2)
+  rule V:Val ~> cmpLeft("<=", E2) => eval(E2) ~> cmpRight("<=", V)
+  rule IVal(I2) ~> cmpRight("<=", IVal(I1)) => BVal(I1 <=Int I2)
+
+  rule eval(Call(Name("str"), E)) => eval(E) ~> toStr()
+  rule IVal(I) ~> toStr() => SVal(Int2String(I))
+
+  rule <k> eval(Call(Name(F), E)) => eval(E) ~> call(F) ... </k>
+       <functions> ... F |-> function(_, _) ... </functions>
+       requires F =/=String "str"
+  rule <k> V:Val ~> call(F) ~> KREST
+         => run(BODY) ~> functionEnd() </k>
+       <env> CALLER => P |-> V </env>
+       <functions> ... F |-> function(P, BODY) ... </functions>
+       <stack> STACK => ListItem(frame(CALLER, KREST)) STACK </stack>
+endmodule
