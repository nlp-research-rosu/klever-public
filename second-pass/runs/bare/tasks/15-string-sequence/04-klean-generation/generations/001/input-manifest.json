{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 17,
      "module": "VERIFICATION",
      "normalized_sha256": "65e45ee166a36988401c233ab025a60dc5f7ca33b995557930a684acccdd79f1",
      "rationale": "This is the recursive case defining the sequenceFrom mathematical string summary when the current index has not passed the bound.",
      "source_rule_id": "rule-65e45ee166a36988401c233ab025a60dc5f7ca33b995557930a684acccdd79f1",
      "start_line": 15,
      "text": "  rule sequenceFrom(I, N, S)\n       => sequenceFrom(I +Int 1, N, S +String \" \" +String Int2String(I))\n       requires I <=Int N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "VERIFICATION",
      "normalized_sha256": "466c7c2be7c323e7fc25fae5fb18a9313e58b62baca45d7a17e64da30511bc69",
      "rationale": "This is the terminating case defining sequenceFrom to return its accumulated string after the index passes the bound.",
      "source_rule_id": "rule-466c7c2be7c323e7fc25fae5fb18a9313e58b62baca45d7a17e64da30511bc69",
      "start_line": 18,
      "text": "  rule sequenceFrom(I, N, S) => S\n       requires I >Int N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 21,
      "module": "VERIFICATION",
      "normalized_sha256": "bd2d5c2971252b0333e76ed865a392d7c7611daa95430d0e3b7113bbfa086403",
      "rationale": "This equation defines the negative-input case of the top-level sequence mathematical summary.",
      "source_rule_id": "rule-bd2d5c2971252b0333e76ed865a392d7c7611daa95430d0e3b7113bbfa086403",
      "start_line": 21,
      "text": "  rule sequence(N) => \"\" requires N <Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 22,
      "module": "VERIFICATION",
      "normalized_sha256": "955fb0e47bc2733ce751bd16d68fe9cd228472af7797f42840d90a3ac1bdde00",
      "rationale": "This equation defines the nonnegative-input case of sequence in terms of the sequenceFrom recurrence.",
      "source_rule_id": "rule-955fb0e47bc2733ce751bd16d68fe9cd228472af7797f42840d90a3ac1bdde00",
      "start_line": 22,
      "text": "  rule sequence(N) => sequenceFrom(1, N, \"0\") requires N >=Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "VERIFICATION",
      "normalized_sha256": "9a07e06ad4b37739dc081e70175fbe9fa0cc141044523aac86a6736a3d375aa9",
      "rationale": "This is the recursive case defining the indexAfter mathematical summary for the loop's final index.",
      "source_rule_id": "rule-9a07e06ad4b37739dc081e70175fbe9fa0cc141044523aac86a6736a3d375aa9",
      "start_line": 24,
      "text": "  rule indexAfter(I, N) => indexAfter(I +Int 1, N)\n       requires I <=Int N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 27,
      "module": "VERIFICATION",
      "normalized_sha256": "4b2d1db7ff9a010e4cc93841df519bedb924d9d7353da56bec38f801e3c18c86",
      "rationale": "This is the terminating case defining indexAfter once the current index exceeds the bound.",
      "source_rule_id": "rule-4b2d1db7ff9a010e4cc93841df519bedb924d9d7353da56bec38f801e3c18c86",
      "start_line": 26,
      "text": "  rule indexAfter(I, N) => I\n       requires I >Int N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 30,
      "module": "VERIFICATION",
      "normalized_sha256": "4be6d834df0a8ee3bb5d58a2a5bb59649a9cae271802ea3bd5625e3ac813ad59",
      "rationale": "This macro-like equation defines the named loopCondition proof term by its exact translated comparison expression.",
      "source_rule_id": "rule-4be6d834df0a8ee3bb5d58a2a5bb59649a9cae271802ea3bd5625e3ac813ad59",
      "start_line": 29,
      "text": "  rule loopCondition()\n       => Compare(Name(\"i\"), CmpOp(\"<=\", Name(\"n\")))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 39,
      "module": "VERIFICATION",
      "normalized_sha256": "349054d85fb69df15a640b595d022a79d84dbe678a7d13629b1d43873ffb9b01",
      "rationale": "This structural equation defines the named loopBody proof term as the two translated assignment statements.",
      "source_rule_id": "rule-349054d85fb69df15a640b595d022a79d84dbe678a7d13629b1d43873ffb9b01",
      "start_line": 32,
      "text": "  rule loopBody()\n       => Assign(\n            Name(\"result\"),\n            BinOp(\n              \"+\",\n              BinOp(\"+\", Name(\"result\"), Str(\" \")),\n              Call(Name(\"str\"), Name(\"i\"))))\n          Assign(Name(\"i\"), BinOp(\"+\", Name(\"i\"), Int(1)))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 49,
      "module": "VERIFICATION",
      "normalized_sha256": "fb6161a8b67f7d15461a9dae303daf34e9e07a0cb359e367e07282d505d6e0cb",
      "rationale": "This structural equation defines targetBody as the exact translated statement sequence used in the proof.",
      "source_rule_id": "rule-fb6161a8b67f7d15461a9dae303daf34e9e07a0cb359e367e07282d505d6e0cb",
      "start_line": 41,
      "text": "  rule targetBody()\n       => If(\n            Compare(Name(\"n\"), CmpOp(\"<\", Int(0))),\n            Return(Str(\"\")),\n            .Stmts)\n          Assign(Name(\"result\"), Str(\"0\"))\n          Assign(Name(\"i\"), Int(1))\n          While(loopCondition(), loopBody())\n          Return(Name(\"result\"))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 51,
      "module": "VERIFICATION",
      "normalized_sha256": "846ae1a1be4929fd20806aa97162cfc70d521aa036599a1adb0e3ea4011bc257",
      "rationale": "This equation defines the named targetFunction proof term from its parameter and targetBody.",
      "source_rule_id": "rule-846ae1a1be4929fd20806aa97162cfc70d521aa036599a1adb0e3ea4011bc257",
      "start_line": 51,
      "text": "  rule targetFunction() => function(\"n\", targetBody())"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 53,
      "module": "VERIFICATION",
      "normalized_sha256": "7750c9cf52bae245157c0466c48fb5cd0fc1f39fd67e1b1998b7fd35d7c71e14",
      "rationale": "This equation defines the named targetProgram proof term as the module containing the translated string_sequence function.",
      "source_rule_id": "rule-7750c9cf52bae245157c0466c48fb5cd0fc1f39fd67e1b1998b7fd35d7c71e14",
      "start_line": 52,
      "text": "  rule targetProgram()\n       => Module(FuncDef(\"string_sequence\", Params(\"n\"), targetBody()))"
    }
  ],
