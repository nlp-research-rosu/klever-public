import json
from collections import Counter
from pathlib import Path

inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
output = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}

assert list(output) == ['schema_version', 'inventory_sha256', 'rules']
assert output['schema_version'] == 2
assert output['inventory_sha256'] == inventory['inventory_sha256']
assert [e['source_rule_id'] for e in output['rules']] == [e['source_rule_id'] for e in inventory['rules']]
assert len(output['rules']) == len(inventory['rules'])
assert all(v == 1 for v in Counter(e['source_rule_id'] for e in output['rules']).values())
by_id = {e['source_rule_id']: e for e in output['rules']}
for source in inventory['rules']:
    entry = by_id[source['source_rule_id']]
    assert list(entry) == ['source_rule_id', 'classification', 'rationale']
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
    if 'simplification' in source['attributes']:
        assert entry['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
print('Schema/order/uniqueness/coverage validation: OK')
print('Rules classified:', len(output['rules']))
print('Classifications:', dict(Counter(e['classification'] for e in output['rules'])))
print('Simplification-attributed rules:', sum('simplification' in e['attributes'] for e in inventory['rules']))
