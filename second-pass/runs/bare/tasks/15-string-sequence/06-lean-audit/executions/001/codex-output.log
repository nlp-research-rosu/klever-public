+    print("RULE INVENTORY")
+    inventory = inventory_verification(K_WORKSPACE)
+    verification_lines = (K_WORKSPACE / "verification.k").read_text().splitlines()
+    recomputed_documents = []
+    for index, rule in enumerate(inventory["rules"]):
+        span_text = "\n".join(
