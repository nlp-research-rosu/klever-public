+        "stage1_export_sha256": klean_export.tree_digest(K_WORKSPACE),
+        "discovery_manifest_sha256": sha256_file(DISCOVERY_PATH),
+        "k_audit_sha256": sha256_tree(Path("/reference/k-audit")),
