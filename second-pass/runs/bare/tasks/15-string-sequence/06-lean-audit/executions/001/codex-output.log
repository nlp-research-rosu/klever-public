    12	          "+",
    13	          BinOp("+", Name("result"), Str(" ")),
    14	          Call(Name("str"), Name("i"))))
    15	      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    16	    Return(Name("result"))))
