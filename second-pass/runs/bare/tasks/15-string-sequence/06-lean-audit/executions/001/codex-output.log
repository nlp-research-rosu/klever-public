     1	def string_sequence(n: int) -> str:
     2	    if n < 0:
     3	        return ""
     4	    result = "0"
     5	    i = 1
     6	    while i <= n:
     7	        result = result + " " + str(i)
     8	        i = i + 1
     9	    return result
     1	Module(
