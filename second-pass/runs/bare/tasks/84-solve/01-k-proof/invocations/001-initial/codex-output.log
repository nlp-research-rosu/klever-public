+              BinOp("%", BinOp("//", Name("N"), Int(100)), Int(10))),
+            BinOp("%", BinOp("//", Name("N"), Int(1000)), Int(10))),
+          BinOp("%", BinOp("//", Name("N"), Int(10000)), Int(10)))))))
+
+  rule digitTotal(N) => (N %Int 10)
+                       +Int ((N /Int 10) %Int 10)
+                       +Int ((N /Int 100) %Int 10)
+                       +Int ((N /Int 1000) %Int 10)
+                       +Int ((N /Int 10000) %Int 10)
+
+  rule oracleDigitSum(N) => N
+    requires (0 <=Int N) andBool (N <Int 10)
+  rule oracleDigitSum(N) => (N %Int 10) +Int oracleDigitSum(N /Int 10)
+    requires N >=Int 10
+
+  rule oracleBinary(0) => VStr("0")
+  rule oracleBinary(N) => oracleBinaryPositive(N)
+    requires N >Int 0
+  rule oracleBinaryPositive(1) => VStr("1")
+  rule oracleBinaryPositive(N)
+    => appendOracleBit(oracleBinaryPositive(N /Int 2), N %Int 2)
+    requires N >Int 1
+  rule appendOracleBit(VStr(S), 0) => VStr(S +String "0")
+  rule appendOracleBit(VStr(S), 1) => VStr(S +String "1")
+
+  rule sameValue(VStr(S1), VStr(S2)) => S1 ==String S2
+  rule checkInput(N)
+    => sameValue(runProgram(solutionProgram, N), oracleBinary(oracleDigitSum(N)))
+  rule checkRange(LIMIT, LIMIT) => true
+  rule checkRange(N, LIMIT) => checkInput(N) andBool checkRange(N +Int 1, LIMIT)
+    requires N <Int LIMIT
+
+  rule <oracle>
+         digitSumLoop(N, A) => oracleValue(VInt(A +Int N))
+       </oracle>
+    requires (0 <=Int N) andBool (N <Int 10)
+  rule <oracle>
+         digitSumLoop(N, A)
+         => digitSumLoop(N /Int 10, A +Int (N %Int 10))
+       </oracle>
+    requires N >=Int 10
+
+  rule <oracle> binaryStart(0) => oracleValue(VStr("0")) </oracle>
+  rule <oracle> binaryStart(N) => binaryLoop(N, "") </oracle>
+    requires N >Int 0
+  rule <oracle> binaryLoop(0, S) => oracleValue(VStr(S)) </oracle>
+  rule <oracle>
+         binaryLoop(N, S) => binaryLoop(N /Int 2, "0" +String S)
+       </oracle>
+    requires (N >Int 0) andBool ((N %Int 2) ==Int 0)
+  rule <oracle>
+         binaryLoop(N, S) => binaryLoop(N /Int 2, "1" +String S)
+       </oracle>
+    requires (N >Int 0) andBool ((N %Int 2) ==Int 1)
+
+  // [START, LIMIT) is checked in order.  The transition to the next input is
+  // enabled only if the independently computed oracle and program result are
+  // the same Value.
+  rule <k> exhaustiveCheck(N, LIMIT) => checkingInput(N, LIMIT) </k>
+       <result> .K => runProgram(solutionProgram, N) </result>
+       <oracle> .K => binaryStart(digitTotal(N)) </oracle>
+    requires N <Int LIMIT
+
+  rule <k> checkingInput(N, LIMIT) => exhaustiveCheck(N +Int 1, LIMIT) </k>
+       <result> V => .K </result>
+       <oracle> oracleValue(V) => .K </oracle>
+
+  rule <k> exhaustiveCheck(LIMIT, LIMIT) => exhaustionDone </k>
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..721951d236fa7b8d0f950353d514996542d81db1
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,95 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" FuncDef ")"
+  syntax FuncDef ::= "FuncDef" "(" String "," Params "," Stmt ")"
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax Stmt ::= "Return" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Str" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "TupleExpr" "(" NeExprs ")"
+  syntax NeExprs ::= Expr
+                   | Expr "," NeExprs
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports STRING
+
+  syntax Value ::= VInt(Int)
+                 | VStr(String)
+                 | VTuple(VList)
+  syntax VList ::= "VNil"
+                 | VCons(Value, VList)
+
+  syntax Value ::= evalExpr(Expr, String, Int) [function]
+                 | nthValue(VList, Int) [function]
+                 | evalNthExpr(NeExprs, Int, String, Int) [function]
+  syntax VList ::= evalExprs(NeExprs, String, Int) [function]
+  syntax Int ::= getInt(Value) [function]
+
+  rule evalExpr(Name(X), X, N) => VInt(N)
+  rule evalExpr(Int(I), _, _) => VInt(I)
+  rule evalExpr(Str(S), _, _) => VStr(S)
+
+  rule evalExpr(BinOp("+", E1, E2), X, N)
+    => VInt(getInt(evalExpr(E1, X, N)) +Int getInt(evalExpr(E2, X, N)))
+  rule evalExpr(BinOp("//", E1, E2), X, N)
+    => VInt(getInt(evalExpr(E1, X, N)) /Int getInt(evalExpr(E2, X, N)))
+  rule evalExpr(BinOp("%", E1, E2), X, N)
+    => VInt(getInt(evalExpr(E1, X, N)) %Int getInt(evalExpr(E2, X, N)))
+
+  rule evalExpr(TupleExpr(ES), X, N) => VTuple(evalExprs(ES, X, N))
+  rule evalExpr(Subscript(TupleExpr(ES), E2), X, N)
+    => evalNthExpr(ES, getInt(evalExpr(E2, X, N)), X, N)
+
+  syntax VList ::= tupleItems(Value) [function]
+  rule tupleItems(VTuple(VS)) => VS
+  rule getInt(VInt(I)) => I
+
+  rule evalExprs(E:Expr, X, N) => VCons(evalExpr(E, X, N), VNil)
+  rule evalExprs((E:Expr, ES:NeExprs), X, N)
+    => VCons(evalExpr(E, X, N), evalExprs(ES, X, N))
+
+  rule evalNthExpr(E:Expr, 0, X, N) => evalExpr(E, X, N)
+  rule evalNthExpr((E:Expr, _), 0, X, N) => evalExpr(E, X, N)
+  rule evalNthExpr((_:Expr, ES:NeExprs), I, X, N)
+    => evalNthExpr(ES, I -Int 1, X, N)
+    requires I >Int 0
+
+  rule nthValue(VCons(V, _), 0) => V
+  rule nthValue(VCons(_, VS), I) => nthValue(VS, I -Int 1)
+    requires I >Int 0
+
+  syntax Value ::= runProgram(Pgm, Int) [function]
+  rule runProgram(
+         Module(FuncDef("solve", Params(X), Return(E))),
+         N)
+    => evalExpr(E, X, N)
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm </k>
+      <input> $N:Int </input>
+      <result> .K </result>
+      <oracle> .K </oracle>
+    </mpy>
+
+  rule <k> P:Pgm => .K </k>
+       <input> N </input>
+       <result> .K => runProgram(P, N) </result>
+endmodule
+
+module SEMANTIC
+  imports MPY-SEMANTIC
+  imports VERIFICATION
+endmodule
