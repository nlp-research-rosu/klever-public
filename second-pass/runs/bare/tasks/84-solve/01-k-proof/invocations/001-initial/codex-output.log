@@ -0,0 +1,12 @@
+requires "semantic.k"
+
+module SPEC
+  imports SEMANTIC
+
+  // The upper endpoint is exclusive.  The full prompt domain is therefore
+  // exactly 0, 1, ..., 10000.
+  claim [all-inputs]:
+    <k> exhaustiveCheck(0, 101) => exhaustionDone </k>
+    <result> .K </result>
+    <oracle> .K </oracle>
+endmodule
