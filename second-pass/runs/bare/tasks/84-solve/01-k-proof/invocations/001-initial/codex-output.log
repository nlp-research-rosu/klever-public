+  rule <oracle>
+         binaryLoop(N, S) => binaryLoop(N /Int 2, "1" +String S)
+       </oracle>
+    requires (N >Int 0) andBool ((N %Int 2) ==Int 1)
+
+  // [START, LIMIT) is checked in order.  The transition to the next input is
+  // enabled only if the independently computed oracle and program result are
+  // the same Value.
+  rule <k> exhaustiveCheck(N, LIMIT) => checkingInput(N, LIMIT) </k>
+       <result> .K => runProgram(solutionProgram, N) </result>
+       <oracle> .K => binaryStart(digitTotal(N)) </oracle>
+    requires N <Int LIMIT
+
+  rule <k> checkingInput(N, LIMIT) => exhaustiveCheck(N +Int 1, LIMIT) </k>
+       <result> V => .K </result>
+       <oracle> oracleValue(V) => .K </oracle>
+
+  rule <k> exhaustiveCheck(LIMIT, LIMIT) => exhaustionDone </k>
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..c1406b61c42afed281cc205513d3b383ee286059
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,88 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" FuncDef ")" [symbol]
+  syntax FuncDef ::= "FuncDef" "(" String "," Params "," Stmt ")" [symbol]
+  syntax Params ::= "Params" "(" String ")" [symbol]
+
+  syntax Stmt ::= "Return" "(" Expr ")" [symbol]
+
+  syntax Expr ::= "Name" "(" String ")" [symbol]
+                | "Int" "(" Int ")" [symbol]
+                | "Str" "(" String ")" [symbol]
+                | "BinOp" "(" String "," Expr "," Expr ")" [symbol]
+                | "Subscript" "(" Expr "," Expr ")" [symbol]
+                | "TupleExpr" "(" NeExprs ")" [symbol]
+  syntax NeExprs ::= Expr
+                   | Expr "," NeExprs [symbol]
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports STRING
+
+  syntax Value ::= VInt(Int) [symbol]
+                 | VStr(String) [symbol]
+                 | VTuple(VList) [symbol]
+  syntax VList ::= "VNil" [symbol]
+                 | VCons(Value, VList) [symbol]
+
+  syntax Value ::= evalExpr(Expr, String, Int) [function, symbol]
+                 | nthValue(VList, Int) [function, symbol]
+  syntax VList ::= evalExprs(NeExprs, String, Int) [function, symbol]
+  syntax Int ::= getInt(Value) [function, symbol]
+
+  rule evalExpr(Name(X), X, N) => VInt(N)
+  rule evalExpr(Int(I), _, _) => VInt(I)
+  rule evalExpr(Str(S), _, _) => VStr(S)
+
+  rule evalExpr(BinOp("+", E1, E2), X, N)
+    => VInt(getInt(evalExpr(E1, X, N)) +Int getInt(evalExpr(E2, X, N)))
+  rule evalExpr(BinOp("//", E1, E2), X, N)
+    => VInt(getInt(evalExpr(E1, X, N)) /Int getInt(evalExpr(E2, X, N)))
+  rule evalExpr(BinOp("%", E1, E2), X, N)
+    => VInt(getInt(evalExpr(E1, X, N)) %Int getInt(evalExpr(E2, X, N)))
+
+  rule evalExpr(TupleExpr(ES), X, N) => VTuple(evalExprs(ES, X, N))
+  rule evalExpr(Subscript(E1, E2), X, N)
+    => nthValue(tupleItems(evalExpr(E1, X, N)), getInt(evalExpr(E2, X, N)))
+
+  syntax VList ::= tupleItems(Value) [function, symbol]
+  rule tupleItems(VTuple(VS)) => VS
+  rule getInt(VInt(I)) => I
+
+  rule evalExprs(E:Expr, X, N) => VCons(evalExpr(E, X, N), VNil)
+  rule evalExprs((E:Expr, ES:NeExprs), X, N)
+    => VCons(evalExpr(E, X, N), evalExprs(ES, X, N))
+
+  rule nthValue(VCons(V, _), 0) => V
+  rule nthValue(VCons(_, VS), I) => nthValue(VS, I -Int 1)
+    requires I >Int 0
+
+  syntax Value ::= runProgram(Pgm, Int) [function, symbol]
+  rule runProgram(
+         Module(FuncDef("solve", Params(X), Return(E))),
+         N)
+    => evalExpr(E, X, N)
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm </k>
+      <input> $N:Int </input>
+      <result> .K </result>
+      <oracle> .K </oracle>
+    </mpy>
+
+  rule <k> P:Pgm => .K </k>
+       <input> N </input>
+       <result> .K => runProgram(P, N) </result>
+endmodule
+
+module SEMANTIC
+  imports MPY-SEMANTIC
+  imports VERIFICATION
+endmodule
