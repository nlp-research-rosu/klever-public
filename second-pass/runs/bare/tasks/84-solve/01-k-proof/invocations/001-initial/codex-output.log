+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm </k>
+      <input> $N:Int </input>
+      <result> .K </result>
+      <oracle> .K </oracle>
+    </mpy>
+
+  rule <k> P:Pgm => .K </k>
