+requires "verification.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" FuncDef ")" [symbol]
+  syntax FuncDef ::= "FuncDef" "(" String "," Params "," Stmt ")" [symbol]
+  syntax Params ::= "Params" "(" String ")" [symbol]
+
+  syntax Stmt ::= "Return" "(" Expr ")" [symbol]
+
+  syntax Expr ::= "Name" "(" String ")" [symbol]
+                | "Int" "(" Int ")" [symbol]
+                | "Str" "(" String ")" [symbol]
+                | "BinOp" "(" String "," Expr "," Expr ")" [symbol]
+                | "Subscript" "(" Expr "," Expr ")" [symbol]
+                | "TupleExpr" "(" NeExprs ")" [symbol]
+  syntax NeExprs ::= Expr
+                   | Expr "," NeExprs [symbol]
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports STRING
+
+  syntax Value ::= VInt(Int) [symbol]
+                 | VStr(String) [symbol]
+                 | VTuple(VList) [symbol]
+  syntax VList ::= "VNil" [symbol]
+                 | VCons(Value, VList) [symbol]
+
+  syntax Value ::= evalExpr(Expr, String, Int) [function, symbol]
+                 | nthValue(VList, Int) [function, symbol]
+  syntax VList ::= evalExprs(NeExprs, String, Int) [function, symbol]
+  syntax Int ::= getInt(Value) [function, symbol]
+
+  rule evalExpr(Name(X), X, N) => VInt(N)
+  rule evalExpr(Int(I), _, _) => VInt(I)
+  rule evalExpr(Str(S), _, _) => VStr(S)
+
+  rule evalExpr(BinOp("+", E1, E2), X, N)
+    => VInt(getInt(evalExpr(E1, X, N)) +Int getInt(evalExpr(E2, X, N)))
+  rule evalExpr(BinOp("//", E1, E2), X, N)
+    => VInt(getInt(evalExpr(E1, X, N)) /Int getInt(evalExpr(E2, X, N)))
+  rule evalExpr(BinOp("%", E1, E2), X, N)
+    => VInt(getInt(evalExpr(E1, X, N)) %Int getInt(evalExpr(E2, X, N)))
+
+  rule evalExpr(TupleExpr(ES), X, N) => VTuple(evalExprs(ES, X, N))
+  rule evalExpr(Subscript(E1, E2), X, N)
+    => nthValue(tupleItems(evalExpr(E1, X, N)), getInt(evalExpr(E2, X, N)))
+
