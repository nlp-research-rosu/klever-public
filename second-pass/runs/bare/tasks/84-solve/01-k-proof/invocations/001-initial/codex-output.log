+module VERIFICATION
+  imports MPY-SEMANTIC
+  imports INT
+  imports STRING
+  imports BOOL
+
+  syntax Int ::= digitTotal(Int) [function, symbol]
+               | decimalDigitSum(Int) [function, symbol]
+  syntax String ::= binaryString(Int) [function, symbol]
+                  | binaryPositive(Int) [function, symbol]
+                  | binaryBit(Int) [function, symbol]
+
+  // This constant is the exact constructor tree in solution.mpy.  Keeping the
+  // program as data makes every correctness claim execute the translated AST.
+  syntax Pgm ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(FuncDef("solve", Params("N"), Return(
+      Subscript(
+        TupleExpr(
+          Str("0"),
+          Str("1"),
+          Str("10"),
+          Str("11"),
+          Str("100"),
+          Str("101"),
+          Str("110"),
+          Str("111"),
+          Str("1000"),
+          Str("1001"),
+          Str("1010"),
+          Str("1011"),
+          Str("1100"),
+          Str("1101"),
+          Str("1110"),
+          Str("1111"),
+          Str("10000"),
+          Str("10001"),
+          Str("10010"),
+          Str("10011"),
+          Str("10100"),
+          Str("10101"),
+          Str("10110"),
+          Str("10111"),
+          Str("11000"),
+          Str("11001"),
+          Str("11010"),
+          Str("11011"),
+          Str("11100"),
+          Str("11101"),
+          Str("11110"),
+          Str("11111"),
+          Str("100000"),
+          Str("100001"),
+          Str("100010"),
+          Str("100011"),
+          Str("100100")),
+        BinOp("+",
+          BinOp("+",
+            BinOp("+",
+              BinOp("+",
+                BinOp("%", Name("N"), Int(10)),
+                BinOp("%", BinOp("//", Name("N"), Int(10)), Int(10))),
+              BinOp("%", BinOp("//", Name("N"), Int(100)), Int(10))),
+            BinOp("%", BinOp("//", Name("N"), Int(1000)), Int(10))),
+          BinOp("%", BinOp("//", Name("N"), Int(10000)), Int(10)))))))
+
+  rule digitTotal(N) => (N %Int 10)
+                       +Int ((N /Int 10) %Int 10)
+                       +Int ((N /Int 100) %Int 10)
+                       +Int ((N /Int 1000) %Int 10)
+                       +Int ((N /Int 10000) %Int 10)
+
+  rule decimalDigitSum(N) => N
+    requires (0 <=Int N) andBool (N <Int 10)
+  rule decimalDigitSum(N) => (N %Int 10) +Int decimalDigitSum(N /Int 10)
+    requires N >=Int 10
+
+  rule binaryString(0) => "0"
+  rule binaryString(N) => binaryPositive(N)
+    requires N >Int 0
+
+  rule binaryPositive(1) => "1"
+  rule binaryPositive(N)
+    => binaryPositive(N /Int 2) +String binaryBit(N %Int 2)
+    requires N >Int 1
+
+  rule binaryBit(0) => "0"
+  rule binaryBit(1) => "1"
+endmodule

