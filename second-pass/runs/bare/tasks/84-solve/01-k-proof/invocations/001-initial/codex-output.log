+                 | VCons(Value, VList) [symbol]
+
+  syntax Value ::= evalExpr(Expr, String, Int) [function, symbol]
+                 | nthValue(VList, Int) [symbol]
+  syntax VList ::= evalExprs(NeExprs, String, Int) [function, symbol]
+  syntax Int ::= getInt(Value) [function, symbol]
+
+  rule evalExpr(Name(X), X, N) => VInt(N)
+  rule evalExpr(Int(I), _, _) => VInt(I)
+  rule evalExpr(Str(S), _, _) => VStr(S)
+
+  rule evalExpr(BinOp("+", E1, E2), X, N)
+    => VInt(getInt(evalExpr(E1, X, N)) +Int getInt(evalExpr(E2, X, N)))
+  rule evalExpr(BinOp("//", E1, E2), X, N)
+    => VInt(getInt(evalExpr(E1, X, N)) /Int getInt(evalExpr(E2, X, N)))
+  rule evalExpr(BinOp("%", E1, E2), X, N)
+    => VInt(getInt(evalExpr(E1, X, N)) %Int getInt(evalExpr(E2, X, N)))
+
+  rule evalExpr(TupleExpr(ES), X, N) => VTuple(evalExprs(ES, X, N))
+  rule evalExpr(Subscript(E1, E2), X, N)
+    => nthValue(tupleItems(evalExpr(E1, X, N)), getInt(evalExpr(E2, X, N)))
+
+  syntax VList ::= tupleItems(Value) [function, symbol]
+  rule tupleItems(VTuple(VS)) => VS
+  rule getInt(VInt(I)) => I
+
+  rule evalExprs(E:Expr, X, N) => VCons(evalExpr(E, X, N), VNil)
+  rule evalExprs((E:Expr, ES:NeExprs), X, N)
+    => VCons(evalExpr(E, X, N), evalExprs(ES, X, N))
+
+  rule <result> nthValue(VCons(V, _), 0) => V </result>
+  rule <result> nthValue(VCons(_, VS), I) => nthValue(VS, I -Int 1) </result>
+    requires I >Int 0
+
+  syntax Value ::= runProgram(Pgm, Int) [function, symbol]
+  rule runProgram(
+         Module(FuncDef("solve", Params(X), Return(E))),
+         N)
+    => evalExpr(E, X, N)
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm </k>
+      <input> $N:Int </input>
+      <result> .K </result>
+      <oracle> .K </oracle>
+    </mpy>
+
+  rule <k> P:Pgm => .K </k>
+       <input> N </input>
+       <result> .K => runProgram(P, N) </result>
+endmodule
+
+module SEMANTIC
+  imports MPY-SEMANTIC
+  imports VERIFICATION
+endmodule
