+
+  syntax Expr ::= "Name" "(" String ")" [symbol]
+                | "Int" "(" Int ")" [symbol]
+                | "Str" "(" String ")" [symbol]
+                | "BinOp" "(" String "," Expr "," Expr ")" [symbol]
+                | "Subscript" "(" Expr "," Expr ")" [symbol]
+                | "TupleExpr" "(" NeExprs ")" [symbol]
+  syntax NeExprs ::= Expr
+                   | Expr "," NeExprs [symbol]
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports STRING
+
+  syntax Value ::= VInt(Int) [symbol]
