+  // recursive binary conversion, independent of the implementation's table.
+  claim [solve-correct]:
+    <result> runProgram(solutionProgram, N) => ?V </result>
+    <oracle> binaryStart(digitTotal(N)) => oracleValue(?V) </oracle>
+    requires (0 <=Int N)
+     andBool (N <=Int 10000)
+     andBool (0 <=Int digitTotal(N))
+     andBool (digitTotal(N) <=Int 36)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..19871578446704aad14b99ec6ff8f8d637a7f80b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,95 @@
+module VERIFICATION
+  imports MPY-SEMANTIC
+  imports INT
+  imports STRING
+  imports BOOL
+
+  syntax Int ::= digitTotal(Int) [function, symbol]
+  syntax OracleState ::= digitSumLoop(Int, Int) [symbol]
+                       | binaryStart(Int) [symbol]
+                       | binaryLoop(Int, String) [symbol]
+                       | oracleValue(Value) [symbol]
+
+  // This constant is the exact constructor tree in solution.mpy.  Keeping the
+  // program as data makes every correctness claim execute the translated AST.
+  syntax Pgm ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(FuncDef("solve", Params("N"), Return(
+      Subscript(
+        TupleExpr(
+          Str("0"),
+          Str("1"),
+          Str("10"),
+          Str("11"),
+          Str("100"),
+          Str("101"),
+          Str("110"),
+          Str("111"),
+          Str("1000"),
+          Str("1001"),
+          Str("1010"),
+          Str("1011"),
+          Str("1100"),
+          Str("1101"),
+          Str("1110"),
+          Str("1111"),
+          Str("10000"),
+          Str("10001"),
+          Str("10010"),
+          Str("10011"),
+          Str("10100"),
+          Str("10101"),
+          Str("10110"),
+          Str("10111"),
+          Str("11000"),
+          Str("11001"),
+          Str("11010"),
+          Str("11011"),
+          Str("11100"),
+          Str("11101"),
+          Str("11110"),
+          Str("11111"),
+          Str("100000"),
+          Str("100001"),
+          Str("100010"),
+          Str("100011"),
+          Str("100100")),
+        BinOp("+",
+          BinOp("+",
+            BinOp("+",
+              BinOp("+",
+                BinOp("%", Name("N"), Int(10)),
+                BinOp("%", BinOp("//", Name("N"), Int(10)), Int(10))),
+              BinOp("%", BinOp("//", Name("N"), Int(100)), Int(10))),
+            BinOp("%", BinOp("//", Name("N"), Int(1000)), Int(10))),
+          BinOp("%", BinOp("//", Name("N"), Int(10000)), Int(10)))))))
+
+  rule digitTotal(N) => (N %Int 10)
+                       +Int ((N /Int 10) %Int 10)
+                       +Int ((N /Int 100) %Int 10)
+                       +Int ((N /Int 1000) %Int 10)
+                       +Int ((N /Int 10000) %Int 10)
+
+  rule <oracle>
+         digitSumLoop(N, A) => oracleValue(VInt(A +Int N))
+       </oracle>
+    requires (0 <=Int N) andBool (N <Int 10)
+  rule <oracle>
+         digitSumLoop(N, A)
+         => digitSumLoop(N /Int 10, A +Int (N %Int 10))
+       </oracle>
+    requires N >=Int 10
+
+  rule <oracle> binaryStart(0) => oracleValue(VStr("0")) </oracle>
+  rule <oracle> binaryStart(N) => binaryLoop(N, "") </oracle>
+    requires N >Int 0
+  rule <oracle> binaryLoop(0, S) => oracleValue(VStr(S)) </oracle>
+  rule <oracle>
+         binaryLoop(N, S) => binaryLoop(N /Int 2, "0" +String S)
+       </oracle>
+    requires (N >Int 0) andBool ((N %Int 2) ==Int 0)
+  rule <oracle>
+         binaryLoop(N, S) => binaryLoop(N /Int 2, "1" +String S)
+       </oracle>
+    requires (N >Int 0) andBool ((N %Int 2) ==Int 1)
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..7ff8fb52df836bc6edbec5ec9b4a969b602be9ac
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,88 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" FuncDef ")" [symbol]
+  syntax FuncDef ::= "FuncDef" "(" String "," Params "," Stmt ")" [symbol]
+  syntax Params ::= "Params" "(" String ")" [symbol]
+
+  syntax Stmt ::= "Return" "(" Expr ")" [symbol]
+
+  syntax Expr ::= "Name" "(" String ")" [symbol]
+                | "Int" "(" Int ")" [symbol]
+                | "Str" "(" String ")" [symbol]
+                | "BinOp" "(" String "," Expr "," Expr ")" [symbol]
+                | "Subscript" "(" Expr "," Expr ")" [symbol]
+                | "TupleExpr" "(" NeExprs ")" [symbol]
+  syntax NeExprs ::= Expr
+                   | Expr "," NeExprs [symbol]
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports STRING
+
+  syntax Value ::= VInt(Int) [symbol]
+                 | VStr(String) [symbol]
+                 | VTuple(VList) [symbol]
+  syntax VList ::= "VNil" [symbol]
+                 | VCons(Value, VList) [symbol]
+
+  syntax Value ::= evalExpr(Expr, String, Int) [function, symbol]
+                 | nthValue(VList, Int) [symbol]
+  syntax VList ::= evalExprs(NeExprs, String, Int) [function, symbol]
+  syntax Int ::= getInt(Value) [function, symbol]
+
+  rule evalExpr(Name(X), X, N) => VInt(N)
+  rule evalExpr(Int(I), _, _) => VInt(I)
+  rule evalExpr(Str(S), _, _) => VStr(S)
+
+  rule evalExpr(BinOp("+", E1, E2), X, N)
+    => VInt(getInt(evalExpr(E1, X, N)) +Int getInt(evalExpr(E2, X, N)))
+  rule evalExpr(BinOp("//", E1, E2), X, N)
+    => VInt(getInt(evalExpr(E1, X, N)) /Int getInt(evalExpr(E2, X, N)))
+  rule evalExpr(BinOp("%", E1, E2), X, N)
+    => VInt(getInt(evalExpr(E1, X, N)) %Int getInt(evalExpr(E2, X, N)))
+
+  rule evalExpr(TupleExpr(ES), X, N) => VTuple(evalExprs(ES, X, N))
+  rule evalExpr(Subscript(E1, E2), X, N)
+    => nthValue(tupleItems(evalExpr(E1, X, N)), getInt(evalExpr(E2, X, N)))
+
+  syntax VList ::= tupleItems(Value) [function, symbol]
+  rule tupleItems(VTuple(VS)) => VS
+  rule getInt(VInt(I)) => I
+
+  rule evalExprs(E:Expr, X, N) => VCons(evalExpr(E, X, N), VNil)
+  rule evalExprs((E:Expr, ES:NeExprs), X, N)
+    => VCons(evalExpr(E, X, N), evalExprs(ES, X, N))
+
+  rule <result> nthValue(VCons(V, _), 0) => V </result>
+  rule <result> nthValue(VCons(_, VS), I) => nthValue(VS, I -Int 1) </result>
+    requires I >Int 0
+
+  syntax Value ::= runProgram(Pgm, Int) [function, symbol]
+  rule runProgram(
+         Module(FuncDef("solve", Params(X), Return(E))),
+         N)
+    => evalExpr(E, X, N)
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm </k>
+      <input> $N:Int </input>
+      <result> .K </result>
+      <oracle> .K </oracle>
+    </mpy>
+
+  rule <k> P:Pgm => .K </k>
+       <input> N </input>
+       <result> .K => runProgram(P, N) </result>
+endmodule
+
+module SEMANTIC
+  imports MPY-SEMANTIC
+  imports VERIFICATION
+endmodule
