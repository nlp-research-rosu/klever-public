+requires "semantic.k"
+
+module SPEC
+  imports SEMANTIC
+  imports BOOL
+
+  // The five-place formula is a valid decimal digit sum throughout the
+  // prompt's finite input domain, and its result always indexes the table.
+  claim [digit-total-bounds]:
+    <k>
+      ((0 <=Int digitTotal(N)) andBool (digitTotal(N) <=Int 36))
+      => true
+    </k>
+    requires (0 <=Int N) andBool (N <=Int 10000)
+
+  // An independent recursive definition connects the unrolled five-place
+  // formula used by the implementation to the mathematical decimal digit sum.
+  claim [digit-total-correct]:
+    <k> digitTotal(N) => decimalDigitSum(N) </k>
+    requires (0 <=Int N) andBool (N <=Int 10000)
+
+  // Execute the exact solution.mpy constructor tree.  binaryString is a
+  // recursive binary conversion, independent of the implementation's table.
+  claim [solve-correct]:
+    <k>
+      runProgram(solutionProgram, N)
+      => VStr(binaryString(digitTotal(N)))
+    </k>
+    requires (0 <=Int N)
+     andBool (N <=Int 10000)
+     andBool (0 <=Int digitTotal(N))
+     andBool (digitTotal(N) <=Int 36)
+endmodule
