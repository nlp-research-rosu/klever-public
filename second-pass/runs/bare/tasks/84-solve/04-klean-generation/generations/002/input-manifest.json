{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 67,
      "module": "VERIFICATION",
      "normalized_sha256": "53df571852c7260b5405e3f430a1e197cea8bc915573926401bb413440ff9dbd",
      "rationale": "This equation expands the named solutionProgram proof term to the exact translated program AST, so it is a macro-style structural definition.",
      "source_rule_id": "rule-53df571852c7260b5405e3f430a1e197cea8bc915573926401bb413440ff9dbd",
      "start_line": 18,
      "text": "  rule solutionProgram =>\n    Module(FuncDef(\"solve\", Params(\"N\"), Return(\n      Subscript(\n        TupleExpr(\n          Str(\"0\"),\n          Str(\"1\"),\n          Str(\"10\"),\n          Str(\"11\"),\n          Str(\"100\"),\n          Str(\"101\"),\n          Str(\"110\"),\n          Str(\"111\"),\n          Str(\"1000\"),\n          Str(\"1001\"),\n          Str(\"1010\"),\n          Str(\"1011\"),\n          Str(\"1100\"),\n          Str(\"1101\"),\n          Str(\"1110\"),\n          Str(\"1111\"),\n          Str(\"10000\"),\n          Str(\"10001\"),\n          Str(\"10010\"),\n          Str(\"10011\"),\n          Str(\"10100\"),\n          Str(\"10101\"),\n          Str(\"10110\"),\n          Str(\"10111\"),\n          Str(\"11000\"),\n          Str(\"11001\"),\n          Str(\"11010\"),\n          Str(\"11011\"),\n          Str(\"11100\"),\n          Str(\"11101\"),\n          Str(\"11110\"),\n          Str(\"11111\"),\n          Str(\"100000\"),\n          Str(\"100001\"),\n          Str(\"100010\"),\n          Str(\"100011\"),\n          Str(\"100100\")),\n        BinOp(\"+\",\n          BinOp(\"+\",\n            BinOp(\"+\",\n              BinOp(\"+\",\n                BinOp(\"%\", Name(\"N\"), Int(10)),\n                BinOp(\"%\", BinOp(\"//\", Name(\"N\"), Int(10)), Int(10))),\n              BinOp(\"%\", BinOp(\"//\", Name(\"N\"), Int(100)), Int(10))),\n            BinOp(\"%\", BinOp(\"//\", Name(\"N\"), Int(1000)), Int(10))),\n          BinOp(\"%\", BinOp(\"//\", Name(\"N\"), Int(10000)), Int(10)))))))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 70,
      "module": "VERIFICATION",
      "normalized_sha256": "611eff644e7463953f9e3303994ad536c6d7af8ffc37dbee9f4547f5b2ee3f78",
      "rationale": "This is the base equation of the recursive decimal digit-sum oracle for a one-digit nonnegative integer.",
      "source_rule_id": "rule-611eff644e7463953f9e3303994ad536c6d7af8ffc37dbee9f4547f5b2ee3f78",
      "start_line": 69,
      "text": "  rule oracleDigitSum(N) => N\n    requires (0 <=Int N) andBool (N <Int 10)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 72,
      "module": "VERIFICATION",
      "normalized_sha256": "6218849d083de77765852fa3fe298f64fdf2bfd9311e3d0062c42d730007fd1d",
      "rationale": "This is the recursive equation defining decimal digit sum by the last digit and the remaining quotient.",
      "source_rule_id": "rule-6218849d083de77765852fa3fe298f64fdf2bfd9311e3d0062c42d730007fd1d",
      "start_line": 71,
      "text": "  rule oracleDigitSum(N) => (N %Int 10) +Int oracleDigitSum(N /Int 10)\n    requires N >=Int 10"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 74,
      "module": "VERIFICATION",
      "normalized_sha256": "ebae8e4ed50af4d120453d2fe890f9016636d08ca01623aea8e7d1b4abc35258",
      "rationale": "This equation defines the binary-string oracle at the zero base case.",
      "source_rule_id": "rule-ebae8e4ed50af4d120453d2fe890f9016636d08ca01623aea8e7d1b4abc35258",
      "start_line": 74,
      "text": "  rule oracleBinary(0) => VStr(\"0\")"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 76,
      "module": "VERIFICATION",
      "normalized_sha256": "dc16181ae61d3a6d0e550918248fc54a1063df4d3cef4f78b5bc3441607af695",
      "rationale": "This equation defines positive binary conversion by dispatching to the positive-number recurrence.",
      "source_rule_id": "rule-dc16181ae61d3a6d0e550918248fc54a1063df4d3cef4f78b5bc3441607af695",
      "start_line": 75,
      "text": "  rule oracleBinary(N) => oracleBinaryPositive(N)\n    requires N >Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 77,
      "module": "VERIFICATION",
      "normalized_sha256": "210e1de7ac4c4d3ce648ab492751173244b1780ff5a6079d020c6f08a3caa079",
      "rationale": "This is the base equation for the positive binary conversion of one.",
      "source_rule_id": "rule-210e1de7ac4c4d3ce648ab492751173244b1780ff5a6079d020c6f08a3caa079",
      "start_line": 77,
      "text": "  rule oracleBinaryPositive(1) => VStr(\"1\")"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 80,
      "module": "VERIFICATION",
      "normalized_sha256": "8a06509279c320d36822dfc724d403f7420b3e96b713ab6bc415d5f382c868e8",
      "rationale": "This recurrence defines a positive binary string from the quotient by two and the remainder bit.",
      "source_rule_id": "rule-8a06509279c320d36822dfc724d403f7420b3e96b713ab6bc415d5f382c868e8",
      "start_line": 78,
      "text": "  rule oracleBinaryPositive(N)\n    => appendOracleBit(oracleBinaryPositive(N /Int 2), N %Int 2)\n    requires N >Int 1"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 81,
      "module": "VERIFICATION",
      "normalized_sha256": "fd6e492c3ce6cccc19a388a48110eada54f8ec3873eefcbee35ad3749408e406",
      "rationale": "This structural helper equation defines appending a zero bit to an oracle string value.",
      "source_rule_id": "rule-fd6e492c3ce6cccc19a388a48110eada54f8ec3873eefcbee35ad3749408e406",
      "start_line": 81,
      "text": "  rule appendOracleBit(VStr(S), 0) => VStr(S +String \"0\")"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 82,
      "module": "VERIFICATION",
      "normalized_sha256": "a96d6b217cafcd09542501da8bb099ff5354be745cece943378f2234c10481f0",
      "rationale": "This structural helper equation defines appending a one bit to an oracle string value.",
      "source_rule_id": "rule-a96d6b217cafcd09542501da8bb099ff5354be745cece943378f2234c10481f0",
      "start_line": 82,
      "text": "  rule appendOracleBit(VStr(S), 1) => VStr(S +String \"1\")"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 84,
      "module": "VERIFICATION",
      "normalized_sha256": "35401f91dcb79fd77f091e4a9ceebbbdd8a933c147da98e3d56a7ca84fb8bf65",
      "rationale": "This equation defines the proof helper that observes equality of two string Values.",
      "source_rule_id": "rule-35401f91dcb79fd77f091e4a9ceebbbdd8a933c147da98e3d56a7ca84fb8bf65",
      "start_line": 84,
      "text": "  rule sameValue(VStr(S1), VStr(S2)) => S1 ==String S2"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 86,
      "module": "VERIFICATION",
      "normalized_sha256": "4be79ef929afae60de4bcb6a9f2350cb51af72c71637cec8e25e20ce6220a110",
      "rationale": "This equation defines the named per-input proof check by composing program execution with the independent digit-sum and binary oracles.",
      "source_rule_id": "rule-4be79ef929afae60de4bcb6a9f2350cb51af72c71637cec8e25e20ce6220a110",
      "start_line": 85,
      "text": "  rule checkInput(N)\n    => sameValue(runProgram(solutionProgram, N), oracleBinary(oracleDigitSum(N)))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 87,
      "module": "VERIFICATION",
      "normalized_sha256": "14c68d306becb13e6832dc81bbef1f0d797be29f9de2a8958be6a76e6b91b25b",
      "rationale": "This is the base equation defining the empty half-open range check as true.",
      "source_rule_id": "rule-14c68d306becb13e6832dc81bbef1f0d797be29f9de2a8958be6a76e6b91b25b",
      "start_line": 87,
      "text": "  rule checkRange(LIMIT, LIMIT) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 89,
      "module": "VERIFICATION",
      "normalized_sha256": "8dbb48e717faaf83c06d57955b3cfbf6ad8a0559ad53f25651556f98ea091014",
      "rationale": "This recurrence defines a range proof term as the current input check conjoined with the remaining half-open range.",
      "source_rule_id": "rule-8dbb48e717faaf83c06d57955b3cfbf6ad8a0559ad53f25651556f98ea091014",
      "start_line": 88,
      "text": "  rule checkRange(N, LIMIT) => checkInput(N) andBool checkRange(N +Int 1, LIMIT)\n    requires N <Int LIMIT"
    }
  ],
