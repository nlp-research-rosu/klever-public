/bin/bash -lc "set -o pipefail
log=/audit-output/evidence/04_build_proof.log
printf '%s\\n' '"'$ cd /tmp/audit-work/src'"' | tee \""'$log"
printf '"'%s\\n' '"'$ /usr/bin/kompile --backend haskell --main-module SEMANTIC --syntax-module MPY-SYNTAX --output-definition /tmp/audit-work/proof-kompiled semantic.k'"' | tee -a \""'$log"
/usr/bin/kompile --backend haskell --main-module SEMANTIC --syntax-module MPY-SYNTAX --output-definition /tmp/audit-work/proof-kompiled semantic.k 2>&1 | tee -a "$log"
