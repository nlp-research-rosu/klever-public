    if mode=='rel-content': z=r+sep+c
    elif mode=='rel-hash': z=r+sep+f
    elif mode=='hash-rel': z=f+sep+r
    elif mode=='sha-line': z=f+b'  '+r+b'\\n'
    elif mode=='sum-line': z=f+b' '+r+b'\\n'
    elif mode=='type-raw': z=r+b'\\0'+typ+b'\\0'+c
    else: z=r+b'\\0'+typ+b'\\0'+f
    h.update(z)
   v=h.hexdigest(); variants[(label,sep,mode)]=v
   if v==target: print('MATCH',label,sep,mode)
print('target',target)
