def _verification_module(masked_text: str) -> _Module:
    modules: list[_Module] = []
    open_module: tuple[str, int, list[_Sentence]] | None = None
    open_rule_until = 0
    for line_start, line_end, keyword, rest in _line_heads(masked_text):
        if line_start < open_rule_until:
            continue
        open_rule_until = 0
        separated = bool(rest) and rest[0] in " \t"
        if keyword == "module":
            if not separated:
                raise KRuleInventoryError(
                    "verification.k has malformed module boundaries"
                )
            named = _MODULE_NAME_RE.fullmatch(rest)
            if named is None or open_module is not None:
                raise KRuleInventoryError(
                    "verification.k has malformed module boundaries"
                )
            open_module = (named.group("name"), line_end, [])
            continue
        if keyword == "endmodule":
            if rest.strip():
                raise KRuleInventoryError(
                    "verification.k has malformed module boundaries"
                )
            if open_module is None:
                raise KRuleInventoryError(
                    "verification.k has malformed module boundaries"
                )
            name, content_start, sentences = open_module
            modules.append(
                _Module(
                    name=name,
                    content_start=content_start,
                    content_end=line_start,
                    sentences=tuple(sentences),
                )
            )
            open_module = None
            continue
        if open_module is not None and keyword == "rule":
            open_module[2].append(
                _Sentence(keyword=keyword, start=line_start)
            )
            open_rule_until = _rule_bubble_end(masked_text, line_start)
            continue
        if (
            open_module is not None
            and keyword in _OUTER_SENTENCE_KEYWORDS
            and separated
        ):
            open_module[2].append(
                _Sentence(keyword=keyword, start=line_start)
            )
    if not modules or open_module is not None:
        raise KRuleInventoryError(
            "verification.k has malformed module boundaries"
        )
    candidates = [
        module
        for module in modules
        if module.name.endswith("VERIFICATION")
        and not module.name.endswith("-SYNTAX")
    ]
    if len(candidates) != 1:
        raise KRuleInventoryError(
            "verification.k must contain exactly one verification module"
        )
    return candidates[0]


def _without_comments(text: str) -> str:
    """Remove K comments while preserving strings and their exact contents."""

    output: list[str] = []
    index = 0
    block_depth = 0
    state = "code"
    while index < len(text):
        character = text[index]
        following = text[index + 1] if index + 1 < len(text) else ""
        if state == "line-comment":
            if character in "\r\n":
                output.append(character)
                state = "code"
            index += 1
            continue
        if state == "string":
            output.append(character)
            if character == "\\" and following:
                output.append(following)
                index += 2
                continue
            if character == '"':
                state = "code"
            index += 1
            continue
        if state == "block-comment":
            if character == "/" and following == "*":
                block_depth += 1
                index += 2
                continue
            if character == "*" and following == "/":
                block_depth -= 1
                index += 2
                if block_depth == 0:
                    state = "code"
                continue
            if character in "\r\n":
                output.append(character)
            index += 1
            continue
        if character == "/" and following == "/":
            output.append(" ")
            state = "line-comment"
            index += 2
            continue
        if character == "/" and following == "*":
            output.append(" ")
            state = "block-comment"
            block_depth = 1
            index += 2
            continue
        output.append(character)
        if character == '"':
            state = "string"
        index += 1
    return "".join(output)


def _attribute_tokens(text: str, masked_text: str) -> list[str]:
    tokens: list[str] = []
    start = 0
    depth = 0
    for index, character in enumerate(masked_text):
        if character in "([{":
            depth += 1
        elif character in ")]}":
            depth = max(depth - 1, 0)
        elif character == "," and depth == 0:
            token = _without_comments(text[start:index]).strip()
            if token:
                tokens.append(token)
            start = index + 1
    final = _without_comments(text[start:]).strip()
    if final:
        tokens.append(final)
    return tokens


def _rule_spans(text: str, module: _Module) -> list[_RuleSpan]:
    masked_text = _mask_non_code(text)
    sentences = module.sentences
    rules: list[_RuleSpan] = []
    seen_hashes: set[str] = set()
    for index, sentence in enumerate(sentences):
        if sentence.keyword != "rule":
            continue
        end_offset = (
            sentences[index + 1].start
            if index + 1 < len(sentences)
            else module.content_end
        )
        start_offset = sentence.start
        raw_segment = text[start_offset:end_offset]
        masked_segment = masked_text[start_offset:end_offset]
        logical_length = len(masked_segment.rstrip(" \t\r\n"))
        if logical_length == 0:
            continue
        rule_text = raw_segment[:logical_length].rstrip(" \t\r\n")
        masked_rule = _mask_non_code(rule_text)
        attribute_match = _TRAILING_ATTRIBUTES_RE.search(masked_rule)
        if attribute_match is None:
            continue
        attribute_start = attribute_match.start("attributes")
        attribute_end = attribute_match.end("attributes")
        attributes = _attribute_tokens(
            rule_text[attribute_start:attribute_end],
            masked_rule[attribute_start:attribute_end],
        )
        if "simplification" not in attributes:
            continue
        normalized = " ".join(rule_text.split())
        digest = hashlib.sha256(normalized.encode()).hexdigest()
        if digest in seen_hashes:
            raise KRuleInventoryError(
                f"duplicate normalized simplification rule hash: {digest}"
            )
        seen_hashes.add(digest)
        start_line = text.count("\n", 0, start_offset) + 1
        end_line = start_line + rule_text.count("\n")
        rule = KRule(
            source_rule_id=f"rule-{digest}",
            start_line=start_line,
            end_line=end_line,
            normalized_sha256=digest,
            attributes=attributes,
            text=rule_text,
        )
        rules.append(
            _RuleSpan(
                rule=rule,
                start_offset=start_offset,
                end_offset=start_offset + len(rule_text),
                attribute_start=start_offset + attribute_match.start(),
                attribute_end=start_offset + attribute_match.end(),
            )
        )
    return rules


def _rule_documents(text: str, module: _Module) -> list[dict[str, Any]]:
    return [
        dataclasses.asdict(span.rule)
        for span in _rule_spans(text, module)
    ]


def _attribute_token_spans(
    text: str,
    masked_text: str,
) -> list[tuple[int, int, str]]:
    spans: list[tuple[int, int, str]] = []
    start = 0
    depth = 0
    for index, character in enumerate(masked_text):
        if character in "([{":
            depth += 1
        elif character in ")]}":
            depth = max(depth - 1, 0)
        elif character == "," and depth == 0:
            spans.append(
                (
                    start,
                    index,
                    _without_comments(text[start:index]).strip(),
                )
            )
            start = index + 1
    spans.append(
        (
            start,
            len(text),
            _without_comments(text[start:]).strip(),
        )
    )
    return spans


def _blank_non_newlines(text: str) -> str:
    return "".join(
        character if character in "\r\n" else " "
        for character in text
    )


def desimplify_rule_ids(
    text: str,
    source_rule_ids: list[str],
) -> str:
    """Remove simplification from exactly the selected canonical rule IDs."""

    if len(source_rule_ids) != len(set(source_rule_ids)):
        raise KRuleInventoryError(
            "exact rule transformation contains a duplicate source rule ID"
        )
    selected = set(source_rule_ids)
    module = _verification_module(_mask_non_code(text))
    spans = _rule_spans(text, module)
    by_id = {span.rule.source_rule_id: span for span in spans}
    unknown = sorted(selected - set(by_id))
    if unknown:
        raise KRuleInventoryError(
            "exact rule transformation names an unknown source rule ID: "
            + ", ".join(unknown)
        )

    edits: list[tuple[int, int]] = []
    for source_rule_id in source_rule_ids:
        span = by_id[source_rule_id]
        attribute_text = text[
            span.attribute_start + 1 : span.attribute_end - 1
        ]
        masked_attributes = _mask_non_code(attribute_text)
        tokens = _attribute_token_spans(
            attribute_text,
            masked_attributes,
        )
        matches = [
            index
            for index, (_start, _end, token) in enumerate(tokens)
            if token == "simplification"
        ]
        if len(matches) != 1:
            raise KRuleInventoryError(
                "selected source rule has ambiguous simplification "
                f"attributes: {source_rule_id}"
            )
        token_index = matches[0]
        if len(tokens) == 1:
            edit_start = span.attribute_start
            edit_end = span.attribute_end
        elif token_index < len(tokens) - 1:
            edit_start = (
                span.attribute_start + 1 + tokens[token_index][0]
            )
            edit_end = (
                span.attribute_start + 1 + tokens[token_index + 1][0]
            )
        else:
            edit_start = (
                span.attribute_start + 1 + tokens[token_index - 1][1]
            )
            edit_end = (
                span.attribute_start + 1 + tokens[token_index][1]
            )
        edits.append((edit_start, edit_end))

    transformed = text
    for start, end in sorted(edits, reverse=True):
        transformed = (
            transformed[:start]
            + _blank_non_newlines(transformed[start:end])
            + transformed[end:]
        )
    return transformed


def inventory_verification(workspace: Path) -> dict[str, Any]:
    workspace = Path(workspace)
    try:
        workspace_mode = workspace.stat(follow_symlinks=False).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        ) from error
    if not stat.S_ISDIR(workspace_mode):
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        )
    verification = workspace / "verification.k"
    try:
        verification_mode = verification.stat(
            follow_symlinks=False
        ).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        ) from error
    if not stat.S_ISREG(verification_mode):
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        )
    try:
        verification_bytes = verification.read_bytes()
        text = verification_bytes.decode()
    except (OSError, UnicodeError) as error:
        raise KRuleInventoryError(
            f"cannot read verification.k: {verification}"
        ) from error
    masked_text = _mask_non_code(text)
    module = _verification_module(masked_text)
    rule_documents = _rule_documents(text, module)
    return {
        "schema_version": 1,
        "verification_file": "verification.k",
        "verification_sha256": hashlib.sha256(verification_bytes).hexdigest(),
        "verification_module": module.name,
        "rules": rule_documents,
        "inventory_sha256": canonical_json_sha256(rule_documents),
    }

diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..6ad2d233e45520ff7248787d342e51b744b8e78c
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,80 @@
+#!/usr/bin/env python3
+"""Independent program-fidelity test for HumanEval 84.
+
+The trusted canonical implementation is the oracle.  The candidate module is
+loaded from a different path and no candidate helper or proof equation is
+reused.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import random
+from pathlib import Path
+
+
+def load_module(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+canonical = load_module("trusted_humaneval_84", Path("/reference/canonical.py"))
+candidate = load_module("candidate_humaneval_84", Path("/candidate/solution.py"))
+
+documented = {1000: "1", 150: "110", 147: "1100"}
+for value, expected in documented.items():
+    assert canonical.solve(value) == expected
+    assert candidate.solve(value) == expected
+
+# There is no "empty" value in the declared integer domain.  Zero is the
+# lower boundary and is included explicitly.  Adjacent values exercise every
+# decimal-place boundary used by the candidate expression.
+branch_boundaries = [
+    0,
+    1,
+    8,
+    9,
+    10,
+    11,
+    98,
+    99,
+    100,
+    101,
+    998,
+    999,
+    1000,
+    1001,
+    9998,
+    9999,
+    10000,
+]
+
+rng = random.Random(840084)
+representative_generated = sorted({rng.randint(0, 10000) for _ in range(128)})
+
+checked = set(branch_boundaries)
+checked.update(documented)
+checked.update(representative_generated)
+checked.update(range(0, 10001))
+
+mismatches: list[tuple[int, str, str]] = []
+for value in sorted(checked):
+    oracle = canonical.solve(value)
+    observed = candidate.solve(value)
+    if observed != oracle:
+        mismatches.append((value, oracle, observed))
+
+print(f"documented_examples={sorted(documented.items())}")
+print(f"branch_boundaries={branch_boundaries}")
+print(f"representative_generated_seed=840084 count={len(representative_generated)}")
+print("intended_domain=all integers 0..10000 inclusive")
+print(f"unique_inputs_checked={len(checked)}")
+print(f"mismatch_count={len(mismatches)}")
+if mismatches:
+    for mismatch in mismatches[:20]:
+        print(f"MISMATCH {mismatch}")
+    raise SystemExit(1)
diff --git a/evidence/stage1_integrity.sh b/evidence/stage1_integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..6723c3d829beac5d969ea9da098a3cf2721f0cf2
--- /dev/null
+++ b/evidence/stage1_integrity.sh
@@ -0,0 +1,154 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+required=(
+  /audit-input.json
+  /audit-campaign-lock.json
+  /run.json
+  /task.json
+  /generation-result.json
+  /generation-evidence/invocation.json
+  /generation-evidence/metrics.json
+  /generation-evidence/usage.json
+  /generation-evidence/codex-last.txt
+  /generation-evidence/codex-output.log
+  /generation-evidence/prompt.txt
+  /reference/canonical.py
+  /reference/prompt.py
+  /reference/py2mpy.py
+  /candidate/prompt.py
+  /candidate/py2mpy.py
+)
+
+status=0
+for path in "${required[@]}"; do
+  if [[ -f "$path" && ! -L "$path" && -r "$path" ]]; then
+    printf 'REGULAR_READABLE %s\n' "$path"
+  else
+    printf 'BAD_REQUIRED_TYPE %s\n' "$path"
+    status=1
+  fi
+done
+
+trace_files=0
+while IFS= read -r -d '' path; do
+  trace_files=$((trace_files + 1))
+  if [[ ! -f "$path" || -L "$path" || ! -r "$path" ]]; then
+    printf 'BAD_TRACE_TYPE %s\n' "$path"
+    status=1
+  fi
+done < <(find /generation-evidence/codex-trace -type f -print0)
+printf 'TRACE_REGULAR_FILE_COUNT %d\n' "$trace_files"
+if [[ "$trace_files" -eq 0 ]]; then
+  status=1
+fi
+
+if find /candidate /generation-evidence /reference -type l -print -quit | grep -q .; then
+  printf 'SYMLINK_FOUND\n'
+  find /candidate /generation-evidence /reference -type l -print
+  status=1
+else
+  printf 'NO_SYMLINKS candidate generation-evidence reference\n'
+fi
+
+if [[ -e /reference/reference-semantics || -L /reference/reference-semantics ]]; then
+  printf 'BAD_GENERATED_MODE_REFERENCE_SEMANTICS_PRESENT\n'
+  status=1
+else
+  printf 'GENERATED_MODE_REFERENCE_SEMANTICS_ABSENT\n'
+fi
+
+cmp -s /candidate/prompt.py /reference/prompt.py
+prompt_cmp=$?
+cmp -s /candidate/py2mpy.py /reference/py2mpy.py
+translator_cmp=$?
+printf 'PROMPT_BYTE_CMP_EXIT %d\n' "$prompt_cmp"
+printf 'TRANSLATOR_BYTE_CMP_EXIT %d\n' "$translator_cmp"
+if [[ "$prompt_cmp" -ne 0 || "$translator_cmp" -ne 0 ]]; then
+  status=1
+fi
+
+printf 'SHA256_REGULAR_INPUTS\n'
+sha256sum \
+  /audit-campaign-lock.json \
+  /run.json \
+  /task.json \
+  /generation-result.json \
+  /generation-evidence/invocation.json \
+  /generation-evidence/metrics.json \
+  /generation-evidence/usage.json \
+  /generation-evidence/codex-last.txt \
+  /generation-evidence/codex-output.log \
+  /generation-evidence/prompt.txt \
+  /reference/canonical.py \
+  /reference/prompt.py \
+  /reference/py2mpy.py \
+  /candidate/prompt.py \
+  /candidate/py2mpy.py
+
+printf 'SHA256_TRACE_FILES\n'
+find /generation-evidence/codex-trace -type f -print0 |
+  sort -z |
+  xargs -0 sha256sum
+
+printf 'REVIEWER_CANDIDATE_FILESET_DIGEST\n'
+find /candidate -type f -print0 |
+  sort -z |
+  xargs -0 sha256sum |
+  sha256sum
+
+printf 'REVIEWER_TRACE_FILESET_DIGEST\n'
+find /generation-evidence/codex-trace -type f -print0 |
+  sort -z |
+  xargs -0 sha256sum |
+  sha256sum
+
+python3 - <<'PY'
+import hashlib
+import json
+from pathlib import Path
+
+audit = json.loads(Path("/audit-input.json").read_text())
+lock_bytes = Path("/audit-campaign-lock.json").read_bytes()
+lock = json.loads(lock_bytes)
+
+checks = {
+    "campaign_block_equal": lock == audit["audit_campaign"],
+    "campaign_lock_hash_equal": (
+        hashlib.sha256(lock_bytes).hexdigest()
+        == audit["hashes"]["audit_campaign_lock_sha256"]
+    ),
+    "record_layout_legacy_selected_stage1": (
+        audit["record_layout"] == "legacy-selected-stage1"
+    ),
+    "semantics_mode_generated": audit["semantics_mode"] == "GENERATED_SEMANTICS",
+    "problem_id_84_solve": audit["problem_id"] == "84-solve",
+    "condition_bare": audit["condition"] == "bare",
+}
+
+for name, passed in checks.items():
+    print(f"{name}={str(passed).lower()}")
+
+for path in (
+    "/audit-input.json",
+    "/audit-campaign-lock.json",
+    "/run.json",
+    "/task.json",
+    "/generation-result.json",
+    "/generation-evidence/invocation.json",
+    "/generation-evidence/metrics.json",
+    "/generation-evidence/usage.json",
+):
+    json.loads(Path(path).read_text())
+    print(f"JSON_VALID {path}")
+
+if not all(checks.values()):
+    raise SystemExit(1)
+PY
+python_status=$?
+if [[ "$python_status" -ne 0 ]]; then
+  status=1
+fi
+
+printf 'OVERALL_EXIT %d\n' "$status"
+exit "$status"
