files=sorted(p for p in root.rglob('*') if p.is_file())
dirs=sorted(p for p in root.rglob('*') if p.is_dir())
target='ce126d29a88a78ec749bccab91963cff182b141a1736574cac301a45cdddd646'
rel=lambda p:p.relative_to(root).as_posix().encode()
content=lambda p:p.read_bytes()
fh=lambda p:hashlib.sha256(content(p)).hexdigest().encode()
variants={}
