+    printf 'K_MISMATCH %s\n' "$value"
+    printf '%s\n' "$output"
+    status=1
+  fi
+done
+
+printf 'WITNESS_COUNT %d\n' "${#witnesses[@]}"
+printf 'OVERALL_EXIT %d\n' "$status"
+exit "$status"

exec
/bin/bash -lc 'set -o pipefail; bash /audit-output/evidence/stage4_pinning_and_witnesses.sh 2>&1 | tee /audit-output/evidence/stage4_pinning_and_witnesses.log; rc=${PIPESTATUS[0]}; printf '"'COMMAND_EXIT %d\\n' \""'$rc" | tee -a /audit-output/evidence/stage4_pinning_and_witnesses.log; exit "$rc"' in /tmp/audit-work/84-solve
