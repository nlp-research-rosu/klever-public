+    ],
+    "export_result": export_result[
+        "stage3_discovery_manifest_sha256"
+    ],
+}
+checks["discovery_hash"]["match"] = len(
+    set(checks["discovery_hash"].values())
+) == 1
+
+inventory_hash_values = {
