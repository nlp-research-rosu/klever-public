new file mode 100644
index 0000000000000000000000000000000000000000..d255877a22e56fab03c995f8b29893125b8d36b6
--- /dev/null
+++ b/evidence/reconstruct_inventory.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Independent Stage 3 inventory reconstruction and strict-order comparison."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from tools import k_rule_inventory, lemma_discovery_contract
+
+
+workspace = Path("/reference/k-proof")
