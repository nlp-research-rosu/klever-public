def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--frozen-k", required=True, type=Path)
    parser.add_argument(
        "--discovery-manifest", required=True, type=Path
    )
    parser.add_argument("--generation", required=True, type=Path)
    parser.add_argument("--candidate", type=Path)
    parser.add_argument("--toolchain-lock", required=True, type=Path)
    parser.add_argument("--audit-input", required=True, type=Path)
    parser.add_argument("--output", type=Path)
    arguments = parser.parse_args(argv)
    try:
        if arguments.output is None:
            result = evaluate_gate(
                arguments.frozen_k,
                arguments.discovery_manifest,
                arguments.generation,
                arguments.candidate,
                toolchain_lock=arguments.toolchain_lock,
                audit_input=arguments.audit_input,
            )
        else:
            result = run_gate(
                arguments.frozen_k,
                arguments.discovery_manifest,
                arguments.generation,
                arguments.candidate,
                toolchain_lock=arguments.toolchain_lock,
                audit_input=arguments.audit_input,
                output=arguments.output,
            )
    except KleanFinalGateError as error:
        print(f"Klean final gate failed: {error}", file=sys.stderr)
        return 2
    print(json.dumps(result, sort_keys=True))
    return 0 if result["status"] == "PASS" else 1


if __name__ == "__main__":
    raise SystemExit(main())

diff --git a//tmp/audit-work/proc-self-exe-shim.c b//tmp/audit-work/proc-self-exe-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..265c6cf78a3226f0d033d05dcb95c1a716067314
--- /dev/null
+++ b//tmp/audit-work/proc-self-exe-shim.c
@@ -0,0 +1,27 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The audit container's PID namespace exposes /proc/self/exe but not
+ * /proc/<getpid()>/exe. Lean 4.22 asks for the latter. Redirect only that
+ * exact Linux executable-link shape so Lean/Lake can locate their sysroot.
+ */
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static ssize_t (*real_readlink)(const char *, char *, size_t);
+    if (real_readlink == NULL) {
+        real_readlink = dlsym(RTLD_NEXT, "readlink");
+    }
+    if (
+        path != NULL
+        && strncmp(path, "/proc/", 6) == 0
+        && strcmp(path + strlen(path) - 4, "/exe") == 0
+    ) {
+        path = "/proc/self/exe";
+    }
+    return real_readlink(path, buffer, size);
+}
