+cmp "$audit_sem_dir/translated.json" "$audit_sem_dir/embedded.json"
+sha256sum "$audit_sem_dir/translated.json" "$audit_sem_dir/embedded.json"
+for audit_n in 0 9 10 36 99 147 9999 10000; do
