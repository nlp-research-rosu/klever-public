2325:                  K "==K" K           [function, total, comm, smt-hook(=), hook(KEQUAL.eq), symbol(_==K_), group(equalEqualK)]
2334:module K-EQUAL-KORE [symbolic]
2338:  rule K1:Bool ==K K2:Bool => K1 ==Bool K2 [simplification]
2339:  rule {K1 ==K K2 #Equals true} => {K1 #Equals K2} [simplification]
2340:  rule {true #Equals K1 ==K K2} => {K1 #Equals K2} [simplification]
2341:  rule {K1 ==K K2 #Equals false} => #Not({K1 #Equals K2}) [simplification]
2342:  rule {false #Equals K1 ==K K2} => #Not({K1 #Equals K2}) [simplification]
2350:module K-EQUAL
2355:  rule K1:K =/=K K2:K => notBool (K1 ==K K2)
2376:module K-REFLECTION
2417:module K-IO

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..13d96c0cdc72be2f542082e82f13bd39d011f765
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,102 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")" [symbol(Module)]
+               | "run" "(" Pgm "," Val "," Val ")" [symbol(runProgram)]
+               | "programLoaded" [symbol(programLoaded)]
+
+  syntax Stmts ::= Stmt [symbol(oneStmt)]
+                 | Stmt Stmts [symbol(moreStmts)]
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol(FuncDef)]
+                | "Return" "(" Expr ")" [symbol(Return)]
+
+  syntax Params ::= "Params" "(" String "," String ")" [symbol(Params)]
+
+  syntax Expr ::= "Name" "(" String ")" [symbol(Name)]
+                | "Int" "(" Int ")" [symbol(IntExpr)]
+                | "UnaryOp" "(" String "," Expr ")" [symbol(UnaryOp)]
+                | "BoolOp" "(" String "," Expr "," Expr ")" [symbol(BoolOp)]
+                | "Compare" "(" Expr "," CmpOp ")" [symbol(Compare)]
+                | "Call" "(" Expr "," Expr ")" [symbol(Call)]
+                | "Subscript" "(" Expr "," Slice ")" [symbol(Subscript)]
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol(CmpOp)]
+  syntax Slice ::= "Slice" "(" Bound "," Bound "," Expr ")" [symbol(Slice)]
+  syntax Bound ::= "NoBound" [symbol(NoBound)]
+
+  syntax IntList ::= "nil" [symbol(nilInts)]
+                   | "cons" "(" Int "," IntList ")" [symbol(consInts)]
+
+  syntax Val ::= "pyInt" "(" Int ")" [symbol(pyInt)]
+               | "pyBool" "(" Bool ")" [symbol(pyBool)]
+               | "pyList" "(" IntList ")" [symbol(pyList)]
+endmodule
+
+module HUMAN-EVAL-SEMANTICS
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+
+  configuration <k> $PGM:Pgm </k>
+
+  // The source module is a function value when merely loaded.  A `run`
+  // request invokes its sole top-level function with two concrete values.
+  rule <k> Module(FuncDef(_F, Params(_X, _Y), Return(_E)))
+        => programLoaded ... </k>
+
+  rule <k> run(
+              Module(FuncDef("will_it_fly", Params("q", "w"), Return(E))),
+              Q, W)
+        => eval(E, env(Q, W)) ... </k>
+
+  syntax Env ::= "env" "(" Val "," Val ")" [symbol(env)]
+
+  syntax Val ::= "eval" "(" Expr "," Env ")" [function, symbol(eval)]
+               | "negate" "(" Val ")" [function, symbol(negate)]
+               | "reverseVal" "(" Val ")" [function, symbol(reverseVal)]
+               | "sumVal" "(" Val ")" [function, symbol(sumVal)]
+               | "compare" "(" CmpOp "," Val "," Env ")" [function, symbol(compare)]
+               | "boolAnd" "(" Val "," Val ")" [function, symbol(boolAnd)]
+
+  rule eval(Name("q"), env(Q, _W)) => Q
+  rule eval(Name("w"), env(_Q, W)) => W
+  rule eval(Int(I), _RHO) => pyInt(I)
+  rule eval(UnaryOp("-", E), RHO) => negate(eval(E, RHO))
+  rule eval(Subscript(E, Slice(NoBound, NoBound, STEP)), RHO)
+    => reverseVal(eval(E, RHO))
+    requires eval(STEP, RHO) ==K pyInt(-1)
+  rule eval(Call(Name("sum"), E), RHO) => sumVal(eval(E, RHO))
+  rule eval(Compare(E, OP), RHO) => compare(OP, eval(E, RHO), RHO)
+  rule eval(BoolOp("and", A, B), RHO)
+    => boolAnd(eval(A, RHO), eval(B, RHO))
+
+  rule negate(pyInt(I)) => pyInt(0 -Int I)
+  rule reverseVal(pyList(IS)) => pyList(reverseInts(IS))
+  rule sumVal(pyList(IS)) => pyInt(sumInts(IS))
+  rule compare(CmpOp("==", E), V, RHO)
+    => pyBool(equalVals(V, eval(E, RHO)))
+  rule compare(CmpOp("<=", E), pyInt(I), RHO)
+    => pyBool(I <=Int getInt(eval(E, RHO)))
+  rule boolAnd(pyBool(A), pyBool(B)) => pyBool(A andBool B)
+
+  syntax Int ::= "getInt" "(" Val ")" [function, symbol(getInt)]
+               | "sumInts" "(" IntList ")" [function, symbol(sumInts)]
+  rule getInt(pyInt(I)) => I
+  rule sumInts(nil) => 0
+  rule sumInts(cons(I, IS)) => I +Int sumInts(IS)
+
+  syntax IntList ::= "reverseInts" "(" IntList ")" [function, symbol(reverseInts)]
+                   | "reverseAcc" "(" IntList "," IntList ")"
+                     [function, symbol(reverseAcc)]
+  rule reverseInts(IS) => reverseAcc(IS, nil)
+  rule reverseAcc(nil, ACC) => ACC
+  rule reverseAcc(cons(I, IS), ACC) => reverseAcc(IS, cons(I, ACC))
+
+  syntax Bool ::= "equalVals" "(" Val "," Val ")" [function, symbol(equalVals)]
+  rule equalVals(pyInt(I), pyInt(J)) => I ==Int J
+  rule equalVals(pyBool(A), pyBool(B)) => A ==Bool B
+  rule equalVals(pyList(IS), pyList(JS)) => IS ==K JS
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..416244127b10ce6dad3787e6659c29faaff3d23c
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,2 @@
+def will_it_fly(q, w):
+    return q == q[::-1] and sum(q) <= w
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..380154e501ef2e8baeaa9872a5ef9d2b724eb193
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,28 @@
+requires "verification.k"
+
+module WILL-IT-FLY-SPEC
+  imports HUMAN-EVAL-VERIFICATION
+
+  // The universal contract: for every integer list and every weight bound,
+  // execution is exactly palindrome(IS) AND sum(IS) <= W.
+  claim <k> run(solutionProgram, pyList(IS:IntList), pyInt(W:Int)) </k>
+      => <k> pyBool(canFly(IS, W)) </k>
+
+  // All four examples from prompt.py are retained as concrete regression
+  // claims, so failures are easy to diagnose independently of the theorem.
+  claim <k> run(solutionProgram,
+                  pyList(cons(1, cons(2, nil))), pyInt(5)) </k>
+      => <k> pyBool(false) </k>
+
+  claim <k> run(solutionProgram,
+                  pyList(cons(3, cons(2, cons(3, nil)))), pyInt(1)) </k>
+      => <k> pyBool(false) </k>
+
+  claim <k> run(solutionProgram,
+                  pyList(cons(3, cons(2, cons(3, nil)))), pyInt(9)) </k>
+      => <k> pyBool(true) </k>
+
+  claim <k> run(solutionProgram,
+                  pyList(cons(3, nil)), pyInt(5)) </k>
+      => <k> pyBool(true) </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..85f5ae0098b1ca5ee00965c213d6a7c27b217ada
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,35 @@
+requires "semantic.k"
+
+module HUMAN-EVAL-VERIFICATION
+  imports HUMAN-EVAL-SEMANTICS
+
+  // Mathematical vocabulary for the HumanEval contract.
+  syntax Bool ::= "balanced" "(" IntList ")" [function, symbol(balanced)]
+                | "withinWeight" "(" IntList "," Int ")"
+                  [function, symbol(withinWeight)]
+                | "canFly" "(" IntList "," Int ")" [function, symbol(canFly)]
+
+  rule balanced(IS) => IS ==K reverseInts(IS)
+  rule withinWeight(IS, W) => sumInts(IS) <=Int W
+  rule canFly(IS, W) => balanced(IS) andBool withinWeight(IS, W)
+
+  // A compact name for the exact constructor tree generated in solution.mpy.
+  syntax Pgm ::= "solutionProgram" [macro, symbol(solutionProgram)]
+  rule solutionProgram =>
+    Module(
+      FuncDef("will_it_fly", Params("q", "w"),
+        Return(
+          BoolOp(
+            "and",
+            Compare(
+              Name("q"),
+              CmpOp(
+                "==",
+                Subscript(
+                  Name("q"),
+                  Slice(NoBound, NoBound, UnaryOp("-", Int(1)))))),
+            Compare(
+              Call(Name("sum"), Name("q")),
+              CmpOp("<=", Name("w")))))))
+    [macro]
+endmodule

apply patch
patch: completed
/work/semantic.k
