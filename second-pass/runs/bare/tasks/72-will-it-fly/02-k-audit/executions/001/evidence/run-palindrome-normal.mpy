run(
  Module(
    FuncDef("will_it_fly", Params("q", "w"),
      Return(
        BoolOp(
          "and",
          Compare(
            Name("q"),
            CmpOp(
              "==",
              Subscript(
                Name("q"),
                Slice(NoBound, NoBound, UnaryOp("-", Int(1)))))),
          Compare(Call(Name("sum"), Name("q")), CmpOp("<=", Name("w"))))))),
  pyList(cons(3, cons(2, cons(3, nil)))),
  pyInt(9))
