     3	module HUMAN-EVAL-VERIFICATION
     4	  imports HUMAN-EVAL-SEMANTICS
     5	
     6	  // Mathematical vocabulary for the HumanEval contract.
     7	  syntax Bool ::= "balanced" "(" IntList ")" [function, symbol(balanced)]
     8	                | "withinWeight" "(" IntList "," Int ")"
     9	                  [function, symbol(withinWeight)]
    10	                | "canFly" "(" IntList "," Int ")" [function, symbol(canFly)]
    11	
    12	  rule balanced(IS) => equalIntLists(IS, reverseInts(IS))
    13	  rule withinWeight(IS, W) => sumInts(IS) <=Int W
    14	  rule canFly(IS, W) => balanced(IS) andBool withinWeight(IS, W)
    15	
    16	  // A compact name for the exact constructor tree generated in solution.mpy.
    17	  syntax Pgm ::= "solutionProgram" [macro, symbol(solutionProgram)]
    18	  rule solutionProgram =>
    19	    Module(
    20	      FuncDef("will_it_fly", Params("q", "w"),
    21	        Return(
    22	          BoolOp(
    23	            "and",
    24	            Compare(
    25	              Name("q"),
    26	              CmpOp(
    27	                "==",
    28	                Subscript(
    29	                  Name("q"),
    30	                  Slice(NoBound, NoBound, UnaryOp("-", Int(1)))))),
    31	            Compare(
    32	              Call(Name("sum"), Name("q")),
    33	              CmpOp("<=", Name("w")))))))
    34	endmodule
