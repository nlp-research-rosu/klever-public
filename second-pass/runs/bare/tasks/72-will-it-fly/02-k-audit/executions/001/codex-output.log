    12	    # it's balanced, but 3+2+3 is more than the maximum possible weight.
    13	
    14	    will_it_fly([3, 2, 3], 9) ➞ True
    15	    # 3+2+3 is less than the maximum possible weight, and it's balanced.
    16	
    17	    will_it_fly([3], 5) ➞ True
    18	    # 3 is less than the maximum possible weight, and it's balanced.
