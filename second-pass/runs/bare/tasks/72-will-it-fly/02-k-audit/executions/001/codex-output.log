+    raise RuntimeError("cannot load generated solution")
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+cases = [
+    ("empty-equality", [], 0),
+    ("empty-overweight", [], -1),
+    ("nonpalindrome", [1, 2], 5),
