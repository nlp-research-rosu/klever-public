     1	requires "verification.k"
     2	
     3	module WILL-IT-FLY-SPEC
     4	  imports HUMAN-EVAL-VERIFICATION
     5	
     6	  // The universal contract: for every integer list and every weight bound,
     7	  // execution is exactly palindrome(IS) AND sum(IS) <= W.
     8	  claim [universal]:
     9	    <k> run(solutionProgram, pyList(IS:IntList), pyInt(W:Int))
    10	        => pyBool(canFly(IS, W)) </k>
    11	    <generatedCounter> 0 </generatedCounter>
    12	
    13	  // All four examples from prompt.py are retained as concrete regression
    14	  // claims, so failures are easy to diagnose independently of the theorem.
    15	  claim [example-unbalanced]:
    16	    <k> run(solutionProgram,
    17	            pyList(cons(1, cons(2, nil))), pyInt(5))
    18	        => pyBool(false) </k>
    19	    <generatedCounter> 0 </generatedCounter>
    20	
    21	  claim [example-overweight]:
    22	    <k> run(solutionProgram,
    23	            pyList(cons(3, cons(2, cons(3, nil)))), pyInt(1))
    24	        => pyBool(false) </k>
    25	    <generatedCounter> 0 </generatedCounter>
    26	
    27	  claim [example-balanced]:
    28	    <k> run(solutionProgram,
    29	            pyList(cons(3, cons(2, cons(3, nil)))), pyInt(9))
    30	        => pyBool(true) </k>
    31	    <generatedCounter> 0 </generatedCounter>
    32	
    33	  claim [example-singleton]:
    34	    <k> run(solutionProgram,
    35	            pyList(cons(3, nil)), pyInt(5))
    36	        => pyBool(true) </k>
    37	    <generatedCounter> 0 </generatedCounter>
    38	endmodule
prove.sh
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd -- "$(dirname -- "$0")"
     5	
     6	# Regenerate the submitted constructor tree with the fixed translator.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	
     9	# The verification module imports semantic.k and adds only contract vocabulary.
    10	kompile verification.k \
    11	  --backend haskell \
    12	  --main-module HUMAN-EVAL-VERIFICATION \
    13	  --syntax-module MPY-SYNTAX \
    14	  --output-definition verification-kompiled-haskell
    15	
    16	# Parse/load the generated source term, then execute negative and positive cases.
    17	krun solution.mpy --definition verification-kompiled-haskell
    18	krun run-unbalanced.mpy --definition verification-kompiled-haskell
    19	krun run-balanced.mpy --definition verification-kompiled-haskell
    20	
    21	# Prove the universal contract and every concrete example claim in spec.k.
    22	kprove \
    23	  --definition verification-kompiled-haskell \
    24	  --spec-module WILL-IT-FLY-SPEC \
    25	  spec.k
