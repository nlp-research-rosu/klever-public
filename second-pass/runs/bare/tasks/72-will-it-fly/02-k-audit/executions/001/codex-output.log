     6	def will_it_fly(q,w):
     7	    '''
     8	    Write a function that returns True if the object q will fly, and False otherwise.
     9	    The object q will fly if it's balanced (it is a palindromic list) and the sum of its elements is less than or equal the maximum possible weight w.
    10	
    11	    Example:
    12	    will_it_fly([1, 2], 5) ➞ False 
    13	    # 1+2 is less than the maximum possible weight, but it's unbalanced.
    14	
    15	    will_it_fly([3, 2, 3], 1) ➞ False
    16	    # it's balanced, but 3+2+3 is more than the maximum possible weight.
    17	
    18	    will_it_fly([3, 2, 3], 9) ➞ True
    19	    # 3+2+3 is less than the maximum possible weight, and it's balanced.
    20	
    21	    will_it_fly([3], 5) ➞ True
    22	    # 3 is less than the maximum possible weight, and it's balanced.
    23	    '''
    24	    if sum(q) > w:
    25	        return False
    26	
    27	    i, j = 0, len(q)-1
    28	    while i<j:
    29	        if q[i] != q[j]:
    30	            return False
    31	        i+=1
    32	        j-=1
    33	    return True
