+print(f"documented_and_boundary_cases={len(DOCUMENTED_AND_BOUNDARY_CASES)}")
+print("exhaustive_lengths=0..6 values=-2..2 weights=-13..13")
+print("deterministic_generated_cases=20000 seed=720072 lengths=0..64")
