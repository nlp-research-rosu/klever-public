hen merely loaded.  A `run`\n+  // request invokes its sole top-level function with two concrete values.\n+  rule <k> Module(FuncDef(_F, Params(_X, _Y), Return(_E)))\n+        => programLoaded ... </k>\n+\n+  rule <k> run(\n+              Module(FuncDef(\"will_it_fly\", Params(\"q\", \"w\"), Return(E))),\n+              Q, W)\n+        => eval(E, env(Q, W)) ... </k>\n+\n+  syntax Env ::= \"env\" \"(\" Val \",\" Val \")\" [symbol(env)]\n+\n+  syntax Val ::= \"eval\" \"(\" Expr \",\" Env \")\" [function, symbol(eval)]\n+               | \"negate\" \"(\" Val \")\" [function, symbol(negate)]\n+               | \"reverseVal\" \"(\" Val \")\" [function, symbol(reverseVal)]\n+               | \"sumVal\" \"(\" Val \")\" [function, symbol(sumVal)]\n+               | \"compare\" \"(\" CmpOp \",\" Val \",\" Env \")\" [function, symbol(compare)]\n+               | \"boolAnd\" \"(\" Val \",\" Val \")\" [function, symbol(boolAnd)]\n+\n+  rule eval(Name(\"q\"), env(Q, _W)) => Q\n+  rule eval(Name(\"w\"), env(_Q, W)) => W\n+  rule eval(Int(I), _RHO) => pyInt(I)\n+  rule eval(UnaryOp(\"-\", E), RHO) => negate(eval(E, RHO))\n+  rule eval(Subscript(E, Slice(NoBound, NoBound, STEP)), RHO)\n+    => reverseVal(eval(E, RHO))\n+    requires eval(STEP, RHO) ==K pyInt(-1)\n+  rule eval(Call(Name(\"sum\"), E), RHO) => sumVal(eval(E, RHO))\n+  rule eval(Compare(E, OP), RHO) => compare(OP, eval(E, RHO), RHO)\n+  rule eval(BoolOp(\"and\", A, B), RHO)\n+    => boolAnd(eval(A, RHO), eval(B, RHO))\n+\n+  rule negate(pyInt(I)) => pyInt(0 -Int I)\n+  rule reverseVal(pyList(IS)) => pyList(reverseInts(IS))\n+  rule sumVal(pyList(IS)) => pyInt(sumInts(IS))\n+  rule compare(CmpOp(\"==\", E), V, RHO)\n+    => pyBool(equalVals(V, eval(E, RHO)))\n+  rule compare(CmpOp(\"<=\", E), pyInt(I), RHO)\n+    => pyBool(I <=Int getInt(eval(E, RHO)))\n+  rule boolAnd(pyBool(A), pyBool(B)) => pyBool(A andBool B)\n+\n+  syntax Int ::= \"getInt\" \"(\" Val \")\" [function, symbol(getInt)]\n+               | \"sumInts\" \"(\" IntList \")\" [function, symbol(sumInts)]\n+  rule getInt(pyInt(I)) => I\n+  rule sumInts(nil) => 0\n+  rule sumInts(cons(I, IS)) => I +Int sumInts(IS)\n+\n+  syntax IntList ::= \"reverseInts\" \"(\" IntList \")\" [function, symbol(reverseInts)]\n+                   | \"reverseAcc\" \"(\" IntList \",\" IntList \")\"\n+                     [function, symbol(reverseAcc)]\n+  rule reverseInts(IS) => reverseAcc(IS, nil)\n+  rule reverseAcc(nil, ACC) => ACC\n+  rule reverseAcc(cons(I, IS), ACC) => reverseAcc(IS, cons(I, ACC))\n+\n+  syntax Bool ::= \"equalVals\" \"(\" Val \",\" Val \")\" [function, symbol(equalVals)]\n+  rule equalVals(pyInt(I), pyInt(J)) => I ==Int J\n+  rule equalVals(pyBool(A), pyBool(B)) => A ==Bool B\n+  rule equalVals(pyList(IS), pyList(JS)) => IS ==K JS\n+endmodule\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module HUMAN-EVAL-VERIFICATION\n+  imports HUMAN-EVAL-SEMANTICS\n+\n+  // Mathematical vocabulary for the HumanEval contract.\n+  syntax Bool ::= \"balanced\" \"(\" IntList \")\" [function, symbol(balanced)]\n+                | \"withinWeight\" \"(\" IntList \",\" Int \")\"\n+                  [function, symbol(withinWeight)]\n+                | \"canFly\" \"(\" IntList \",\" Int \")\" [function, symbol(canFly)]\n+\n+  rule balanced(IS) => IS ==K reverseInts(IS)\n+  rule withinWeight(IS, W) => sumInts(IS) <=Int W\n+  rule canFly(IS, W) => balanced(IS) andBool withinWeight(IS, W)\n+\n+  // A compact name for the exact constructor tree generated in solution.mpy.\n+  syntax Pgm ::= \"solutionProgram\" [macro, symbol(solutionProgram)]\n+  rule solutionProgram =>\n+    Module(\n+      FuncDef(\"will_it_fly\", Params(\"q\", \"w\"),\n+        Return(\n+          BoolOp(\n+            \"and\",\n+            Compare(\n+              Name(\"q\"),\n+              CmpOp(\n+                \"==\",\n+                Subscript(\n+                  Name(\"q\"),\n+                  Slice(NoBound, NoBound, UnaryOp(\"-\", Int(1)))))),\n+            Compare(\n+              Call(Name(\"sum\"), Name(\"q\")),\n+              CmpOp(\"<=\", Name(\"w\")))))))\n+    [macro]\n+endmodule\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module WILL-IT-FLY-SPEC\n+  imports HUMAN-EVAL-VERIFICATION\n+\n+  // The universal contract: for every integer list and every weight bound,\n+  // execution is exactly palindrome(IS) AND sum(IS) <= W.\n+  claim <k> run(solutionProgram, pyList(IS:IntList), pyInt(W:Int)) </k>\n+      => <k> pyBool(canFly(IS, W)) </k>\n+\n+  // All four examples from prompt.py are retained as concrete regression\n+  // claims, so failures are easy to diagnose independently of the theorem.\n+  claim <k> run(solutionProgram,\n+                  pyList(cons(1, cons(2, nil))), pyInt(5)) </k>\n+      => <k> pyBool(false) </k>\n+\n+  claim <k> run(solutionProgram,\n+                  pyList(cons(3, cons(2, cons(3, nil)))), pyInt(1)) </k>\n+      => <k> pyBool(false) </k>\n+\n+  claim <k> run(solutionProgram,\n+                  pyList(cons(3, cons(2, cons(3, nil)))), pyInt(9)) </k>\n+      => <k> pyBool(true) </k>\n+\n+  claim <k> run(solutionProgram,\n+                  pyList(cons(3, nil)), pyInt(5)) </k>\n+      => <k> pyBool(true) </k>\n+endmodule\n*** End Patch";
