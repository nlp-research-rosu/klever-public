+
+
+def compare_hash(path: Path, expected: str) -> None:
+    actual = sha256_file(path)
+    assert actual == expected, f"hash mismatch {path}: {actual} != {expected}"
+    print(f"OK sha256 {path} {actual}")
+
+
+def main() -> int:
+    require_file(AUDIT)
+    require_file(LOCK)
