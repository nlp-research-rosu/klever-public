+    q = [rng.randrange(-(10**12), 10**12 + 1) for _ in range(length)]
+    if index % 4 == 0:
+        q = q[: (length + 1) // 2] + q[: length // 2][::-1]
+    choices = [sum(q) - 1, sum(q), sum(q) + 1, rng.randrange(-(10**15), 10**15)]
+    check(q, choices[index % len(choices)], f"generated-{index}")
