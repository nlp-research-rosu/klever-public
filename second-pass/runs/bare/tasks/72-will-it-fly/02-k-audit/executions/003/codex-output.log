+    ).read_bytes()
+    assert Path("/candidate/py2mpy.py").read_bytes() == Path(
+        "/reference/py2mpy.py"
+    ).read_bytes()
+    print("OK candidate prompt and translator are byte-identical to trusted mounts")
+    return 0
