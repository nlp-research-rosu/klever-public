+    assert generated_result is expected
+    target = WORK / f"audit-{name}.mpy"
+    target.write_text(
+        f"run(\n{MODULE},\n"
+        f"  pyList({int_list(q)}),\n"
+        f"  pyInt({w}))\n",
+        encoding="utf-8",
+    )
+    print(
+        f"{target.name} canonical={canonical_result} "
