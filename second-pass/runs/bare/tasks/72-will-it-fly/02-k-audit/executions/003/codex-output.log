new file mode 100644
index 0000000000000000000000000000000000000000..89a3aac77b7240c5aca1459e578fbcaf041242a5
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  "$@"
+  status=$?
+  printf 'EXIT_STATUS: %d\n' "$status"
+  printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  exit "$status"
+} 2>&1 | tee "$log"
+
+exit "${PIPESTATUS[0]}"

