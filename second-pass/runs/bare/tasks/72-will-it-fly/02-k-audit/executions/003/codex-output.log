+    "empty-overweight": ([], -1, False),
+    "singleton-at-bound": ([3], 3, True),
+    "unbalanced-underweight": ([1, 2], 5, False),
+    "palindrome-overweight": ([3, 2, 3], 1, False),
+    "palindrome-at-bound": ([3, 2, 3], 8, True),
