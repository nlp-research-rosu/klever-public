     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // Independent mathematical recurrence for overlapping occurrences.
     7	  syntax Int ::= overlapCount(String, String) [function]
     8	
     9	  rule overlapCount(S, T) => lengthString(S) +Int 1
    10	    requires T ==String ""
    11	
    12	  rule overlapCount(S, T) => 0
    13	    requires notBool (T ==String "")
    14	     andBool lengthString(S) <Int lengthString(T)
    15	
    16	  rule overlapCount(S, T)
    17	    => 1 +Int overlapCount(
    18	         substrString(S, 1, lengthString(S)), T)
    19	    requires notBool (T ==String "")
    20	     andBool notBool (lengthString(S) <Int lengthString(T))
    21	     andBool substrString(S, 0, lengthString(T)) ==String T
    22	
    23	  rule overlapCount(S, T)
    24	    => overlapCount(substrString(S, 1, lengthString(S)), T)
    25	    requires notBool (T ==String "")
    26	     andBool notBool (lengthString(S) <Int lengthString(T))
    27	     andBool notBool (substrString(S, 0, lengthString(T)) ==String T)
    28	endmodule
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Universal functional-correctness claim.  CONT makes the claim usable as
     7	  // the circularity at each recursive call, while ENV checks call restoration.
     8	  claim [how-many-times-correct]:
     9	    <k> invoke(strVal(S), strVal(T)) ~> CONT:K
    10	      => intVal(overlapCount(S, T)) ~> CONT </k>
    11	    <functions>
    12	      "how_many_times" |->
    13	        function(Params("string", "substring"),
    14	          If(Compare(Name("substring"), CmpOp("==", Str(""))),
    15	            Return(BinOp("+", Call(Name("len"), Name("string")), Int(1))),
    16	            .Stmts)
    17	          If(Compare(
    18	              Call(Name("len"), Name("string")),
    19	              CmpOp("<", Call(Name("len"), Name("substring")))),
    20	            Return(Int(0)),
    21	            .Stmts)
    22	          If(Compare(
    23	              Subscript(Name("string"),
    24	                Slice(NoBound,
    25	                  Call(Name("len"), Name("substring")), NoBound)),
    26	              CmpOp("==", Name("substring"))),
    27	            Return(BinOp("+", Int(1),
    28	              Call(Name("how_many_times"),
    29	                Subscript(Name("string"),
    30	                  Slice(Int(1), NoBound, NoBound)),
    31	                Name("substring")))),
    32	            .Stmts)
    33	          Return(Call(Name("how_many_times"),
    34	            Subscript(Name("string"), Slice(Int(1), NoBound, NoBound)),
    35	            Name("substring"))))
    36	    </functions>
    37	    <env> _ENV:Map </env>
    38	endmodule
