@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG_NAME COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_name=$1
+shift
+log_path="/audit-output/evidence/${log_name}"
+
+{
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} >"$log_path"
+
+set +e
+"$@" >>"$log_path" 2>&1
+status=$?
+set -e
+
+printf 'EXIT_STATUS: %d\n' "$status" >>"$log_path"
+cat "$log_path"
+exit "$status"

