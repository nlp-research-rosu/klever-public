   112	        => eval(E2) ~> callArgTwo(V1) ... </k>
   113	  rule <k> V2:Value ~> callArgTwo(V1) => invoke(V1, V2) ... </k>
   114	
   115	  // Calls use a fresh two-argument environment and restore their caller's map.
   116	  rule <k> invoke(V1, V2) => B ~> returnFrame(OLD) ... </k>
   117	       <functions>... "how_many_times" |->
   118	          function(Params("string", "substring"), B) ...</functions>
   119	       <env> OLD =>
   120	          ("string" |-> V1
