+
+log_name=$1
+shift
+log_path="/audit-output/evidence/${log_name}"
+
+{
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} >"$log_path"
+
+set +e
+"$@" >>"$log_path" 2>&1
+status=$?
+set -e
+
+printf 'EXIT_STATUS: %d\n' "$status" >>"$log_path"
+cat "$log_path"
+exit "$status"
