WROTE /tmp/audit-work/concrete-tests/long_recursion.py string_len=1000 substring='b'
<py>
  <k>
    intVal ( 0 ) ~> .K
  </k>
  <functions>
    "how_many_times" |-> function ( Params ( "string" , "substring" , .Strings ) , If ( Compare ( Name ( "substring" ) , CmpOp ( "==" , Str ( "" ) ) , .CmpOps ) , Return ( BinOp ( "+" , Call ( Name ( "len" ) , Name ( "string" ) , .Exprs ) , Int ( 1 ) ) )  .Stmts , .Stmts )  If ( Compare ( Call ( Name ( "len" ) , Name ( "string" ) , .Exprs ) , CmpOp ( "<" , Call ( Name ( "len" ) , Name ( "substring" ) , .Exprs ) ) , .CmpOps ) , Return ( Int ( 0 ) )  .Stmts , .Stmts )  If ( Compare ( Subscript ( Name ( "string" ) , Slice ( NoBound , Call ( Name ( "len" ) , Name ( "substring" ) , .Exprs ) , NoBound ) ) , CmpOp ( "==" , Name ( "substring" ) ) , .CmpOps ) , Return ( BinOp ( "+" , Int ( 1 ) , Call ( Name ( "how_many_times" ) , Subscript ( Name ( "string" ) , Slice ( Int ( 1 ) , NoBound , NoBound ) ) , Name ( "substring" ) , .Exprs ) ) )  .Stmts , .Stmts )  Return ( Call ( Name ( "how_many_times" ) , Subscript ( Name ( "string" ) , Slice ( Int ( 1 ) , NoBound , NoBound ) ) , Name ( "substring" ) , .Exprs ) )  .Stmts )
  </functions>
