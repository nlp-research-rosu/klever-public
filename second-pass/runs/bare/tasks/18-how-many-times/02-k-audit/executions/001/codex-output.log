    87	
    88	  // Branch rules split symbolic execution on the Boolean condition.
    89	  rule <k> If(C, T, E) => eval(C) ~> ifFrame(T, E) ... </k>
    90	  rule <k> boolVal(B) ~> ifFrame(T, _E) => T ... </k> requires B
    91	  rule <k> boolVal(B) ~> ifFrame(_T, E) => E ... </k> requires notBool B
    92	
