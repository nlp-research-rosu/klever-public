    26	
    27	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    28	  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")"
    29	  syntax Bound ::= Expr | "NoBound"
    30	endmodule
    31	
    32	module SEMANTIC
    33	  imports MPY-SYNTAX
    34	  imports MAP
    35	
    36	  syntax Value ::= intVal(Int) | strVal(String) | boolVal(Bool)
    37	  syntax Function ::= function(Params, Stmts)
    38	  syntax Returned ::= returned(Value)
    39	
    40	  syntax KItem ::= eval(Expr)
    41	                 | addLeft(Expr) | addRight(Value)
    42	                 | cmpLeft(String, Expr) | cmpRight(String, Value)
    43	                 | ifFrame(Stmts, Stmts)
    44	                 | lenFrame()
    45	                 | callArgOne(Expr) | callArgTwo(Value)
    46	                 | invoke(Value, Value)
    47	                 | prefixBase(Expr) | prefixEnd(Value)
    48	                 | tailFrame()
    49	                 | makeReturn() | returnFrame(Map)
    50	
    51	  configuration
    52	    <py>
    53	      <k> $PGM:Program </k>
    54	      <functions> .Map </functions>
    55	      <env> .Map </env>
    56	    </py>
    57	
    58	  // Statement-list execution and function installation.
    59	  rule <k> Module(SS) => SS ... </k>
    60	  rule <k> .Stmts => .K ... </k>
    61	  rule <k> (S:Stmt SS:Stmts) => S ~> SS ... </k>
    62	  rule <k> V:Value ~> .Stmts => V ... </k>
    63	
    64	  rule <k> FuncDef(N, P, B) => .K ... </k>
    65	       <functions> F => F [ N <- function(P, B) ] </functions>
    66	
    67	  rule <k> Expr(E) => eval(E) ... </k>
    68	
    69	  // Literals, variables, integer addition, and the comparisons used here.
    70	  rule <k> eval(Int(I)) => intVal(I) ... </k>
    71	  rule <k> eval(Str(S)) => strVal(S) ... </k>
    72	  rule <k> eval(Name(N)) => V ... </k>
    73	       <env>... N |-> V ...</env>
    74	
    75	  rule <k> eval(BinOp("+", L, R)) => eval(L) ~> addLeft(R) ... </k>
    76	  rule <k> V:Value ~> addLeft(R) => eval(R) ~> addRight(V) ... </k>
    77	  rule <k> intVal(J) ~> addRight(intVal(I)) => intVal(I +Int J) ... </k>
    78	
    79	  rule <k> eval(Compare(L, CmpOp(OP, R)))
