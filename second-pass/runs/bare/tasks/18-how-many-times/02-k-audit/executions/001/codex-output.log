+for index, label, string, substring, expected, actual in mismatches:
+    print(
+        "MISMATCH "
+        f"index={index} label={label} "
+        f"string={string!r} substring={substring!r} "
+        f"canonical={expected!r} candidate={actual!r}"
+    )
+
+sys.exit(1 if mismatches else 0)
