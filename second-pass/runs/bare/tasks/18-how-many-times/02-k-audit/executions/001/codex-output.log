   121	           "substring" |-> V2)
   122	       </env>
   123	
   124	  rule <k> Return(E) => eval(E) ~> makeReturn() ... </k>
   125	  rule <k> V:Value ~> makeReturn() => returned(V) ... </k>
   126	
   127	  // A return discards the remainder of its current statement block only.
   128	  rule <k> returned(V) ~> (_S:Stmt) => returned(V) ... </k>
   129	  rule <k> returned(V) ~> (_SS:Stmts) => returned(V) ... </k>
