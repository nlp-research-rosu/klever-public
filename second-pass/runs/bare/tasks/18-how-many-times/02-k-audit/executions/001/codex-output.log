    96	
    97	  rule <k> eval(Subscript(E, Slice(NoBound, Call(Name("len"), H), NoBound)))
    98	        => eval(E) ~> prefixBase(H) ... </k>
    99	  rule <k> strVal(S) ~> prefixBase(H)
   100	        => eval(Call(Name("len"), H)) ~> prefixEnd(strVal(S)) ... </k>
   101	  rule <k> intVal(I) ~> prefixEnd(strVal(S))
   102	        => strVal(substrString(S, 0, I)) ... </k>
   103	
   104	  rule <k> eval(Subscript(E, Slice(Int(1), NoBound, NoBound)))
   105	        => eval(E) ~> tailFrame() ... </k>
   106	  rule <k> strVal(S) ~> tailFrame()
   107	        => strVal(substrString(S, 1, lengthString(S))) ... </k>
   108	
   109	  rule <k> eval(Call(Name("how_many_times"), E1, E2))
