@@ -0,0 +1,38 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal functional-correctness claim.  CONT makes the claim usable as
+  // the circularity at each recursive call, while ENV checks call restoration.
+  claim [how-many-times-correct]:
+    <k> invoke(strVal(S), strVal(T)) ~> CONT:K
+      => intVal(overlapCount(S, T)) ~> CONT </k>
+    <functions>
+      "how_many_times" |->
+        function(Params("string", "substring"),
+          If(Compare(Name("substring"), CmpOp("==", Str(""))),
+            Return(BinOp("+", Call(Name("len"), Name("string")), Int(1))),
+            .Stmts)
+          If(Compare(
+              Call(Name("len"), Name("string")),
+              CmpOp("<", Call(Name("len"), Name("substring")))),
+            Return(Int(0)),
+            .Stmts)
+          If(Compare(
+              Subscript(Name("string"),
+                Slice(NoBound,
+                  Call(Name("len"), Name("substring")), NoBound)),
+              CmpOp("==", Name("substring"))),
+            Return(BinOp("+", Int(1),
+              Call(Name("how_many_times"),
+                Subscript(Name("string"),
+                  Slice(Int(1), NoBound, NoBound)),
+                Name("substring")))),
+            .Stmts)
+          Return(Call(Name("how_many_times"),
+            Subscript(Name("string"), Slice(Int(1), NoBound, NoBound)),
+            Name("substring"))))
+    </functions>
+    <env> _ENV:Map </env>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8f164e81d7e75839f23d34b7bd9df399fae0aca8
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,28 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // Independent mathematical recurrence for overlapping occurrences.
+  syntax Int ::= overlapCount(String, String) [function]
+
+  rule overlapCount(S, T) => lengthString(S) +Int 1
+    requires T ==String ""
+
+  rule overlapCount(S, T) => 0
+    requires notBool (T ==String "")
+     andBool lengthString(S) <Int lengthString(T)
+
+  rule overlapCount(S, T)
+    => 1 +Int overlapCount(
+         substrString(S, 1, lengthString(S)), T)
+    requires notBool (T ==String "")
+     andBool notBool (lengthString(S) <Int lengthString(T))
+     andBool substrString(S, 0, lengthString(T)) ==String T
+
+  rule overlapCount(S, T)
+    => overlapCount(substrString(S, 1, lengthString(S)), T)
+    requires notBool (T ==String "")
+     andBool notBool (lengthString(S) <Int lengthString(T))
+     andBool notBool (substrString(S, 0, lengthString(T)) ==String T)
+endmodule

exec
/bin/bash -lc ./prove.sh in /work
