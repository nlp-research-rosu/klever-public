+
+  rule #call(F, V, Module(DEFS))
+    => #apply(#lookup(F, DEFS), V, Module(DEFS))
+  rule #apply(function(X, BODY), V, P)
+    => #outcomeValue(#exec(BODY, env(X, V), P))
+
+  syntax Val ::= "#outcomeValue" "(" Outcome ")" [function]
+  rule #outcomeValue(returned(V)) => V
