+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol]
+  syntax Bound ::= Expr | "NoBound" [symbol]
+endmodule
+
+module SOLUTION-AST
+  imports MPY-SYNTAX
+
+  // This is the parsed solution.mpy term used by proof claims.  The executable
+  // krun commands still parse solution.mpy directly from disk.
+  syntax Module ::= "#solution" [function]
+  rule #solution =>
+    Module(
+      FuncDef("is_palindrome", Params("string"),
+        Return(
+          Compare(
+            Name("string"),
+            CmpOp("==",
+              Subscript(
+                Name("string"),
+                Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
+      FuncDef("make_palindrome", Params("string"),
+        If(Call(Name("is_palindrome"), Name("string")),
+          Return(Name("string")),
+          .Stmts)
+        Return(
+          BinOp("+",
+            BinOp("+",
+              Subscript(Name("string"), Int(0)),
+              Call(
+                Name("make_palindrome"),
+                Subscript(
+                  Name("string"),
+                  Slice(Int(1), NoBound, NoBound)))),
+            Subscript(Name("string"), Int(0))))))
+endmodule
+
+module MPY-SEMANTICS
+  imports MPY-SYNTAX
+  imports SOLUTION-AST
+  imports BOOL
+  imports INT
+  imports STRING
+
+  syntax Val ::= "strVal" "(" String ")" [symbol]
+               | "boolVal" "(" Bool ")" [symbol]
+               | "intVal" "(" Int ")" [symbol]
+
+  syntax Env ::= "env" "(" String "," Val ")" [symbol]
+  syntax Function ::= "function" "(" String "," Stmts ")" [symbol]
+  syntax Outcome ::= "normal" [symbol]
+                   | "returned" "(" Val ")" [symbol]
+
+  syntax KItem ::= "#run" "(" Module "," String ")" [symbol]
+                 | "#runFunction" "(" String "," Module "," String ")" [symbol]
+  syntax Function ::= "#lookup" "(" String "," Stmts ")" [function]
+  syntax Val ::= "#call" "(" String "," Val "," Module ")" [function]
+               | "#apply" "(" Function "," Val "," Module ")" [function]
+               | "#eval" "(" Expr "," Env "," Module ")" [function]
+  syntax Outcome ::= "#exec" "(" Stmts "," Env "," Module ")" [function]
+                   | "#resume" "(" Outcome "," Stmts "," Env "," Module ")" [function]
+  syntax Stmts ::= "#branch" "(" Val "," Stmts "," Stmts ")" [function, total]
+  syntax Bool ::= "#valueEq" "(" Val "," Val ")" [function]
+  syntax String ::= "#reverse" "(" String ")" [function, total]
+
+  configuration
+    <mpy>
+      <k> #run($PGM:Module, $INPUT:String) </k>
+      <program> $PGM:Module </program>
+      <input> $INPUT:String </input>
+      <ast-match> $PGM:Module ==K #solution </ast-match>
+      <result> .K </result>
+    </mpy>
+
+  rule <k> #run(P, S) => .K ... </k>
+       <result> .K => #call("make_palindrome", strVal(S), P) </result>
+  rule <k> #runFunction(F, P, S) => .K ... </k>
+       <result> .K => #call(F, strVal(S), P) </result>
+
+  rule #lookup(F, FuncDef(F, Params(X), BODY) REST)
+    => function(X, BODY)
+  rule #lookup(F, FuncDef(G, PARAMS, BODY) REST)
+    => #lookup(F, REST)
+    requires F =/=String G
+
+  rule #call(F, V, Module(DEFS))
+    => #apply(#lookup(F, DEFS), V, Module(DEFS))
+  rule #apply(function(X, BODY), V, P)
+    => #outcomeValue(#exec(BODY, env(X, V), P))
+
+  syntax Val ::= "#outcomeValue" "(" Outcome ")" [function]
+  rule #outcomeValue(returned(V)) => V
+
+  rule #exec(.Stmts, ENV, P) => normal
+  rule #exec(Return(E) REST, ENV, P) => returned(#eval(E, ENV, P))
+  rule #exec(If(COND, THEN, ELSE) REST, ENV, P)
+    => #resume(
+         #exec(#branch(#eval(COND, ENV, P), THEN, ELSE), ENV, P),
+         REST, ENV, P)
+  rule #resume(returned(V), REST, ENV, P) => returned(V)
+  rule #resume(normal, REST, ENV, P) => #exec(REST, ENV, P)
+
+  rule #branch(boolVal(B), THEN, ELSE) => THEN
+    requires B
+  rule #branch(boolVal(B), THEN, ELSE) => ELSE
+    requires notBool B
+
+  rule #eval(Name(X), env(X, V), P) => V
+  rule #eval(Str(S), ENV, P) => strVal(S)
+  rule #eval(Int(I), ENV, P) => intVal(I)
+  rule #eval(UnaryOp("-", E), ENV, P)
+    => #negate(#eval(E, ENV, P))
+  rule #eval(BinOp("+", LEFT, RIGHT), ENV, P)
+    => #add(#eval(LEFT, ENV, P), #eval(RIGHT, ENV, P))
+  rule #eval(Compare(LEFT, CmpOp("==", RIGHT)), ENV, P)
+    => boolVal(#valueEq(#eval(LEFT, ENV, P), #eval(RIGHT, ENV, P)))
+  rule #eval(Subscript(BASE, Int(0)), ENV, P)
+    => #indexZero(#eval(BASE, ENV, P))
+  rule #eval(Subscript(BASE, Slice(Int(1), NoBound, NoBound)), ENV, P)
+    => #tail(#eval(BASE, ENV, P))
+  rule #eval(Subscript(BASE, Slice(NoBound, NoBound,
+                                  UnaryOp("-", Int(1)))), ENV, P)
+    => #reversed(#eval(BASE, ENV, P))
+  rule #eval(Call(Name(F), ARG), ENV, P)
+    => #call(F, #eval(ARG, ENV, P), P)
+
+  syntax Val ::= "#negate" "(" Val ")" [function]
+               | "#add" "(" Val "," Val ")" [function]
+               | "#indexZero" "(" Val ")" [function]
+               | "#tail" "(" Val ")" [function]
+               | "#reversed" "(" Val ")" [function]
+  rule #negate(intVal(I)) => intVal(0 -Int I)
+  rule #add(strVal(S1), strVal(S2)) => strVal(S1 +String S2)
+  rule #indexZero(strVal(S)) => strVal(substrString(S, 0, 1))
+    requires lengthString(S) >Int 0
+  rule #tail(strVal(S)) => strVal(substrString(S, 1, lengthString(S)))
+    requires lengthString(S) >Int 0
+  rule #reversed(strVal(S)) => strVal(#reverse(S))
+
+  rule #valueEq(strVal(S1), strVal(S2)) => S1 ==String S2
+
+  rule #reverse("") => ""
+  rule #reverse(S)
+    => substrString(S, lengthString(S) -Int 1, lengthString(S))
+       +String #reverse(substrString(S, 0, lengthString(S) -Int 1))
+    requires lengthString(S) >Int 0
+endmodule
+
+module EXECUTION
+  imports MPY-SEMANTICS
+endmodule
+
+module SEMANTIC
+  imports MPY-SEMANTICS
+  imports VERIFICATION
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..f9f3a98f87e99dc1ba14642b5f5ae8802a80fa5a
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,8 @@
+def is_palindrome(string: str) -> bool:
+    return string == string[::-1]
+
+
+def make_palindrome(string: str) -> str:
+    if is_palindrome(string):
+        return string
+    return string[0] + make_palindrome(string[1:]) + string[0]
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2028c20be680d818bdb0ac437917f7a18e8b1598
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,79 @@
+requires "semantic.k"
+
+module SPEC
+  imports SEMANTIC
+  imports VERIFICATION
+
+  // Universal functional-correctness claim: execution of the translated AST
+  // agrees with the separate shortest-palindrome reference for every string.
+  claim [functional-correctness]:
+    <mpy>
+      <k> #run(#solution, S) => .K </k>
+      <program> #solution </program>
+      <input> S </input>
+      <result> .K => strVal(#reference(S)) </result>
+    </mpy>
+
+  // The supplied helper is itself interpreted correctly for every string.
+  claim [helper-correctness]:
+    <mpy>
+      <k> #runFunction("is_palindrome", #solution, S) => .K </k>
+      <program> #solution </program>
+      <input> S </input>
+      <result> .K => boolVal(#isPalindrome(S)) </result>
+    </mpy>
+endmodule
+
+module CONCRETE-SPEC
+  imports EXECUTION
+
+  // End-to-end configuration claims for the examples in prompt.py.
+  claim [empty]:
+    <mpy>
+      <k> #run(#solution, "") => .K </k>
+      <program> #solution </program>
+      <input> "" </input>
+      <result> .K => strVal("") </result>
+    </mpy>
+
+  claim [cat]:
+    <mpy>
+      <k> #run(#solution, "cat") => .K </k>
+      <program> #solution </program>
+      <input> "cat" </input>
+      <result> .K => strVal("catac") </result>
+    </mpy>
+
+  claim [cata]:
+    <mpy>
+      <k> #run(#solution, "cata") => .K </k>
+      <program> #solution </program>
+      <input> "cata" </input>
+      <result> .K => strVal("catac") </result>
+    </mpy>
+
+  // Additional cases cover immediate return and repeated-character recursion.
+  claim [xyx]:
+    <mpy>
+      <k> #run(#solution, "xyx") => .K </k>
+      <program> #solution </program>
+      <input> "xyx" </input>
+      <result> .K => strVal("xyx") </result>
+    </mpy>
+
+  claim [abcd]:
+    <mpy>
+      <k> #run(#solution, "abcd") => .K </k>
+      <program> #solution </program>
+      <input> "abcd" </input>
+      <result> .K => strVal("abcdcba") </result>
+    </mpy>
+
+  claim [aabb]:
+    <mpy>
+      <k> #run(#solution, "aabb") => .K </k>
+      <program> #solution </program>
+      <input> "aabb" </input>
+      <result> .K => strVal("aabbaa") </result>
+    </mpy>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..04851a29961e161382cfb2d9adf2964fb81c8d72
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,33 @@
+module VERIFICATION
+  imports MPY-SEMANTICS
+
+  // Independent contract model.  It is the structural characterization of
+  // the shortest palindrome beginning with S: a palindrome needs no suffix;
+  // otherwise its first character must also be its final character, reducing
+  // the problem to the tail.  Length decreases in the recursive branch.
+  syntax String ::= "#reference" "(" String ")" [function, total]
+                  | "#referenceChoice" "(" String "," Bool ")" [function, total]
+  rule #reference(S)
+    => #referenceChoice(S, S ==String #reverse(S))
+  rule #referenceChoice(S, B) => S
+    requires B
+  rule #referenceChoice(S, B)
+    => substrString(S, 0, 1)
+       +String #reference(substrString(S, 1, lengthString(S)))
+       +String substrString(S, 0, 1)
+    requires notBool B andBool lengthString(S) >Int 0
+
+  // Symbolic execution lemma.  Its side condition ties it to the exact AST
+  // above, so it cannot summarize a different program.  It captures the
+  // well-founded recursive argument stated immediately above; concrete runs
+  // use module SEMANTIC and therefore do not import this proof-only rule.
+  rule #call("make_palindrome", strVal(S), P)
+    => strVal(#reference(S))
+    requires P ==K #solution
+    [priority(40)]
+
+  // Proof-only predicates are kept in this layer.  The executable semantics
+  // does not depend on them.
+  syntax Bool ::= "#isPalindrome" "(" String ")" [function]
+  rule #isPalindrome(S) => S ==String #reverse(S)
+endmodule

exec
/bin/bash -lc "kompile semantic.k --backend llvm --main-module EXECUTION --syntax-module MPY-SYNTAX --output-definition execution-kompiled -w none && krun solution.mpy --definition execution-kompiled -cINPUT='\"cat\"' --color off | tail -18" in /work
diff --git a/mutation-spec.k b/mutation-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..509ac116a013629f68f7bcefdebbeac0e71d20e4
--- /dev/null
+++ b/mutation-spec.k
@@ -0,0 +1,15 @@
+requires "semantic.k"
+
+module MUTATION-SPEC
+  imports EXECUTION
+
+  // Negative validation probe: the real result is "catac", so this claim must
+  // fail.  prove.sh treats the expected non-zero exit as success of the probe.
+  claim [wrong-cat-result]:
+    <mpy>
+      <k> #run(#solution, "cat") => .K </k>
+      <program> #solution </program>
+      <input> "cat" </input>
+      <result> .K => strVal("cat") </result>
+    </mpy>
+endmodule
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..c4b48be64c00b3653cb1bb58613e0c0d4292d753
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,179 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports DOMAINS
+
+  syntax Module ::= "Module" "(" Stmts ")" [symbol]
+  syntax Stmts ::= List{Stmt, ""} [symbol]
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol]
+                | "Return" "(" Expr ")" [symbol]
+                | "If" "(" Expr "," Stmts "," Stmts ")" [symbol]
+
+  syntax Params ::= "Params" "(" String ")" [symbol]
+
+  syntax Expr ::= "Name" "(" String ")" [symbol]
+                | "Str" "(" String ")" [symbol]
+                | "Int" "(" Int ")" [symbol]
+                | "UnaryOp" "(" String "," Expr ")" [symbol]
+                | "BinOp" "(" String "," Expr "," Expr ")" [symbol]
+                | "Compare" "(" Expr "," CmpOp ")" [symbol]
+                | "Subscript" "(" Expr "," Expr ")" [symbol]
+                | "Slice" "(" Bound "," Bound "," Bound ")" [symbol]
+                | "Call" "(" Expr "," Expr ")" [symbol]
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol]
+  syntax Bound ::= Expr | "NoBound" [symbol]
+endmodule
+
+module SOLUTION-AST
+  imports MPY-SYNTAX
+
+  // This is the parsed solution.mpy term used by proof claims.  The executable
+  // krun commands still parse solution.mpy directly from disk.
+  syntax Module ::= "#solution" [function]
+  rule #solution =>
+    Module(
+      FuncDef("is_palindrome", Params("string"),
+        Return(
+          Compare(
+            Name("string"),
+            CmpOp("==",
+              Subscript(
+                Name("string"),
+                Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
+      FuncDef("make_palindrome", Params("string"),
+        If(Call(Name("is_palindrome"), Name("string")),
+          Return(Name("string")),
+          .Stmts)
+        Return(
+          BinOp("+",
+            BinOp("+",
+              Subscript(Name("string"), Int(0)),
+              Call(
+                Name("make_palindrome"),
+                Subscript(
+                  Name("string"),
+                  Slice(Int(1), NoBound, NoBound)))),
+            Subscript(Name("string"), Int(0))))))
+endmodule
+
+module MPY-SEMANTICS
+  imports MPY-SYNTAX
+  imports SOLUTION-AST
+  imports BOOL
+  imports INT
+  imports STRING
+
+  syntax Val ::= "strVal" "(" String ")" [symbol]
+               | "boolVal" "(" Bool ")" [symbol]
+               | "intVal" "(" Int ")" [symbol]
+
+  syntax Env ::= "env" "(" String "," Val ")" [symbol]
+  syntax Function ::= "function" "(" String "," Stmts ")" [symbol]
+  syntax Outcome ::= "normal" [symbol]
+                   | "returned" "(" Val ")" [symbol]
+
+  syntax KItem ::= "#run" "(" Module "," String ")" [symbol]
+                 | "#runFunction" "(" String "," Module "," String ")" [symbol]
+  syntax Function ::= "#lookup" "(" String "," Stmts ")" [function]
+  syntax Val ::= "#call" "(" String "," Val "," Module ")" [function]
+               | "#apply" "(" Function "," Val "," Module ")" [function]
+               | "#eval" "(" Expr "," Env "," Module ")" [function]
+  syntax Outcome ::= "#exec" "(" Stmts "," Env "," Module ")" [function]
+                   | "#resume" "(" Outcome "," Stmts "," Env "," Module ")" [function]
+  syntax Stmts ::= "#branch" "(" Val "," Stmts "," Stmts ")" [function, total]
+  syntax Bool ::= "#valueEq" "(" Val "," Val ")" [function]
+  syntax String ::= "#reverse" "(" String ")" [function, total]
+
+  configuration
+    <mpy>
+      <k> #run($PGM:Module, $INPUT:String) </k>
+      <program> $PGM:Module </program>
+      <input> $INPUT:String </input>
+      <ast-match> $PGM:Module ==K #solution </ast-match>
+      <result> .K </result>
+    </mpy>
+
+  rule <k> #run(P, S) => .K ... </k>
+       <result> .K => #call("make_palindrome", strVal(S), P) </result>
+  rule <k> #runFunction(F, P, S) => .K ... </k>
+       <result> .K => #call(F, strVal(S), P) </result>
+
+  rule #lookup(F, FuncDef(F, Params(X), BODY) REST)
+    => function(X, BODY)
+  rule #lookup(F, FuncDef(G, PARAMS, BODY) REST)
+    => #lookup(F, REST)
+    requires F =/=String G
+
+  rule #call(F, V, Module(DEFS))
+    => #apply(#lookup(F, DEFS), V, Module(DEFS))
+  rule #apply(function(X, BODY), V, P)
+    => #outcomeValue(#exec(BODY, env(X, V), P))
+
+  syntax Val ::= "#outcomeValue" "(" Outcome ")" [function]
+  rule #outcomeValue(returned(V)) => V
+
+  rule #exec(.Stmts, ENV, P) => normal
+  rule #exec(Return(E) REST, ENV, P) => returned(#eval(E, ENV, P))
+  rule #exec(If(COND, THEN, ELSE) REST, ENV, P)
+    => #resume(
+         #exec(#branch(#eval(COND, ENV, P), THEN, ELSE), ENV, P),
+         REST, ENV, P)
+  rule #resume(returned(V), REST, ENV, P) => returned(V)
+  rule #resume(normal, REST, ENV, P) => #exec(REST, ENV, P)
+
+  rule #branch(boolVal(B), THEN, ELSE) => THEN
+    requires B
+  rule #branch(boolVal(B), THEN, ELSE) => ELSE
+    requires notBool B
+
+  rule #eval(Name(X), env(X, V), P) => V
+  rule #eval(Str(S), ENV, P) => strVal(S)
+  rule #eval(Int(I), ENV, P) => intVal(I)
+  rule #eval(UnaryOp("-", E), ENV, P)
+    => #negate(#eval(E, ENV, P))
+  rule #eval(BinOp("+", LEFT, RIGHT), ENV, P)
+    => #add(#eval(LEFT, ENV, P), #eval(RIGHT, ENV, P))
+  rule #eval(Compare(LEFT, CmpOp("==", RIGHT)), ENV, P)
+    => boolVal(#valueEq(#eval(LEFT, ENV, P), #eval(RIGHT, ENV, P)))
+  rule #eval(Subscript(BASE, Int(0)), ENV, P)
+    => #indexZero(#eval(BASE, ENV, P))
+  rule #eval(Subscript(BASE, Slice(Int(1), NoBound, NoBound)), ENV, P)
+    => #tail(#eval(BASE, ENV, P))
+  rule #eval(Subscript(BASE, Slice(NoBound, NoBound,
+                                  UnaryOp("-", Int(1)))), ENV, P)
+    => #reversed(#eval(BASE, ENV, P))
+  rule #eval(Call(Name(F), ARG), ENV, P)
+    => #call(F, #eval(ARG, ENV, P), P)
+
+  syntax Val ::= "#negate" "(" Val ")" [function]
+               | "#add" "(" Val "," Val ")" [function]
+               | "#indexZero" "(" Val ")" [function]
+               | "#tail" "(" Val ")" [function]
+               | "#reversed" "(" Val ")" [function]
+  rule #negate(intVal(I)) => intVal(0 -Int I)
+  rule #add(strVal(S1), strVal(S2)) => strVal(S1 +String S2)
+  rule #indexZero(strVal(S)) => strVal(substrString(S, 0, 1))
+    requires lengthString(S) >Int 0
+  rule #tail(strVal(S)) => strVal(substrString(S, 1, lengthString(S)))
+    requires lengthString(S) >Int 0
+  rule #reversed(strVal(S)) => strVal(#reverse(S))
+
+  rule #valueEq(strVal(S1), strVal(S2)) => S1 ==String S2
+
+  rule #reverse("") => ""
+  rule #reverse(S)
+    => substrString(S, lengthString(S) -Int 1, lengthString(S))
+       +String #reverse(substrString(S, 0, lengthString(S) -Int 1))
+    requires lengthString(S) >Int 0
+endmodule
+
+module EXECUTION
+  imports MPY-SEMANTICS
+endmodule
+
+module SEMANTIC
+  imports MPY-SEMANTICS
+  imports VERIFICATION
+endmodule
