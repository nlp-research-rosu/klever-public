+module VERIFICATION
+  imports MPY-SEMANTICS
+
+  // Proof-only mathematical vocabulary is kept in this layer.  The executable
+  // semantics above does not depend on these predicates or equations.
+  syntax Bool ::= "#isPalindrome" "(" String ")" [function]
+  rule #isPalindrome(S) => S ==String #reverse(S)
+endmodule

