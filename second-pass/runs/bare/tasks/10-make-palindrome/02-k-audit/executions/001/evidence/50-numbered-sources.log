     3	module MPY-SYNTAX
     4	  imports DOMAINS
     5	
     6	  syntax Module ::= "Module" "(" Stmts ")" [symbol]
     7	  syntax Stmts ::= List{Stmt, ""} [symbol]
     8	
     9	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol]
    10	                | "Return" "(" Expr ")" [symbol]
    11	                | "If" "(" Expr "," Stmts "," Stmts ")" [symbol]
    12	
    13	  syntax Params ::= "Params" "(" String ")" [symbol]
    14	
    15	  syntax Expr ::= "Name" "(" String ")" [symbol]
    16	                | "Str" "(" String ")" [symbol]
    17	                | "Int" "(" Int ")" [symbol]
    18	                | "UnaryOp" "(" String "," Expr ")" [symbol]
    19	                | "BinOp" "(" String "," Expr "," Expr ")" [symbol]
    20	                | "Compare" "(" Expr "," CmpOp ")" [symbol]
    21	                | "Subscript" "(" Expr "," Expr ")" [symbol]
    22	                | "Slice" "(" Bound "," Bound "," Bound ")" [symbol]
    23	                | "Call" "(" Expr "," Expr ")" [symbol]
    24	
    25	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol]
    26	  syntax Bound ::= Expr | "NoBound" [symbol]
    27	endmodule
    28	
    29	module SOLUTION-AST
    30	  imports MPY-SYNTAX
    31	
    32	  // This is the parsed solution.mpy term used by proof claims.  The executable
    33	  // krun commands still parse solution.mpy directly from disk.
    34	  syntax Module ::= "#solution" [function]
    35	  rule #solution =>
    36	    Module(
    37	      FuncDef("is_palindrome", Params("string"),
    38	        Return(
    39	          Compare(
    40	            Name("string"),
    41	            CmpOp("==",
    42	              Subscript(
    43	                Name("string"),
    44	                Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
    45	      FuncDef("make_palindrome", Params("string"),
    46	        If(Call(Name("is_palindrome"), Name("string")),
    47	          Return(Name("string")),
    48	          .Stmts)
    49	        Return(
    50	          BinOp("+",
    51	            BinOp("+",
    52	              Subscript(Name("string"), Int(0)),
    53	              Call(
    54	                Name("make_palindrome"),
    55	                Subscript(
    56	                  Name("string"),
    57	                  Slice(Int(1), NoBound, NoBound)))),
    58	            Subscript(Name("string"), Int(0))))))
    59	endmodule
    60	
    61	module MPY-SEMANTICS
    62	  imports MPY-SYNTAX
    63	  imports SOLUTION-AST
    64	  imports BOOL
    65	  imports INT
    66	  imports STRING
    67	
    68	  syntax Val ::= "strVal" "(" String ")" [symbol]
    69	               | "boolVal" "(" Bool ")" [symbol]
    70	               | "intVal" "(" Int ")" [symbol]
    71	
    72	  syntax Env ::= "env" "(" String "," Val ")" [symbol]
    73	  syntax Function ::= "function" "(" String "," Stmts ")" [symbol]
    74	  syntax Outcome ::= "normal" [symbol]
    75	                   | "returned" "(" Val ")" [symbol]
    76	
    77	  syntax KItem ::= "#run" "(" Module "," String ")" [symbol]
    78	                 | "#runFunction" "(" String "," Module "," String ")" [symbol]
    79	  syntax Function ::= "#lookup" "(" String "," Stmts ")" [function]
    80	  syntax Val ::= "#call" "(" String "," Val "," Module ")" [function]
    81	               | "#apply" "(" Function "," Val "," Module ")" [function]
    82	               | "#eval" "(" Expr "," Env "," Module ")" [function]
    83	  syntax Outcome ::= "#exec" "(" Stmts "," Env "," Module ")" [function]
    84	                   | "#resume" "(" Outcome "," Stmts "," Env "," Module ")" [function]
    85	  syntax Stmts ::= "#branch" "(" Val "," Stmts "," Stmts ")" [function, total]
    86	  syntax Bool ::= "#valueEq" "(" Val "," Val ")" [function]
    87	  syntax String ::= "#reverse" "(" String ")" [function, total]
    88	
    89	  configuration
    90	    <mpy>
    91	      <k> #run($PGM:Module, $INPUT:String) </k>
    92	      <program> $PGM:Module </program>
    93	      <input> $INPUT:String </input>
    94	      <ast-match> $PGM:Module ==K #solution </ast-match>
    95	      <result> .K </result>
    96	    </mpy>
    97	
    98	  rule <k> #run(P, S) => .K ... </k>
    99	       <result> .K => #call("make_palindrome", strVal(S), P) </result>
   100	  rule <k> #runFunction(F, P, S) => .K ... </k>
   101	       <result> .K => #call(F, strVal(S), P) </result>
   102	
   103	  rule #lookup(F, FuncDef(F, Params(X), BODY) REST)
   104	    => function(X, BODY)
   105	  rule #lookup(F, FuncDef(G, PARAMS, BODY) REST)
   106	    => #lookup(F, REST)
   107	    requires F =/=String G
   108	
   109	  rule #call(F, V, Module(DEFS))
   110	    => #apply(#lookup(F, DEFS), V, Module(DEFS))
   111	  rule #apply(function(X, BODY), V, P)
   112	    => #outcomeValue(#exec(BODY, env(X, V), P))
   113	
   114	  syntax Val ::= "#outcomeValue" "(" Outcome ")" [function]
   115	  rule #outcomeValue(returned(V)) => V
   116	
   117	  rule #exec(.Stmts, ENV, P) => normal
   118	  rule #exec(Return(E) REST, ENV, P) => returned(#eval(E, ENV, P))
   119	  rule #exec(If(COND, THEN, ELSE) REST, ENV, P)
   120	    => #resume(
   121	         #exec(#branch(#eval(COND, ENV, P), THEN, ELSE), ENV, P),
   122	         REST, ENV, P)
   123	  rule #resume(returned(V), REST, ENV, P) => returned(V)
   124	  rule #resume(normal, REST, ENV, P) => #exec(REST, ENV, P)
   125	
   126	  rule #branch(boolVal(B), THEN, ELSE) => THEN
   127	    requires B
   128	  rule #branch(boolVal(B), THEN, ELSE) => ELSE
   129	    requires notBool B
   130	
   131	  rule #eval(Name(X), env(X, V), P) => V
   132	  rule #eval(Str(S), ENV, P) => strVal(S)
   133	  rule #eval(Int(I), ENV, P) => intVal(I)
   134	  rule #eval(UnaryOp("-", E), ENV, P)
   135	    => #negate(#eval(E, ENV, P))
   136	  rule #eval(BinOp("+", LEFT, RIGHT), ENV, P)
   137	    => #add(#eval(LEFT, ENV, P), #eval(RIGHT, ENV, P))
   138	  rule #eval(Compare(LEFT, CmpOp("==", RIGHT)), ENV, P)
   139	    => boolVal(#valueEq(#eval(LEFT, ENV, P), #eval(RIGHT, ENV, P)))
   140	  rule #eval(Subscript(BASE, Int(0)), ENV, P)
   141	    => #indexZero(#eval(BASE, ENV, P))
   142	  rule #eval(Subscript(BASE, Slice(Int(1), NoBound, NoBound)), ENV, P)
   143	    => #tail(#eval(BASE, ENV, P))
   144	  rule #eval(Subscript(BASE, Slice(NoBound, NoBound,
   145	                                  UnaryOp("-", Int(1)))), ENV, P)
   146	    => #reversed(#eval(BASE, ENV, P))
   147	  rule #eval(Call(Name(F), ARG), ENV, P)
   148	    => #call(F, #eval(ARG, ENV, P), P)
   149	
   150	  syntax Val ::= "#negate" "(" Val ")" [function]
   151	               | "#add" "(" Val "," Val ")" [function]
   152	               | "#indexZero" "(" Val ")" [function]
   153	               | "#tail" "(" Val ")" [function]
   154	               | "#reversed" "(" Val ")" [function]
   155	  rule #negate(intVal(I)) => intVal(0 -Int I)
   156	  rule #add(strVal(S1), strVal(S2)) => strVal(S1 +String S2)
   157	  rule #indexZero(strVal(S)) => strVal(substrString(S, 0, 1))
   158	    requires lengthString(S) >Int 0
   159	  rule #tail(strVal(S)) => strVal(substrString(S, 1, lengthString(S)))
   160	    requires lengthString(S) >Int 0
   161	  rule #reversed(strVal(S)) => strVal(#reverse(S))
   162	
   163	  rule #valueEq(strVal(S1), strVal(S2)) => S1 ==String S2
   164	
   165	  rule #reverse("") => ""
   166	  rule #reverse(S)
   167	    => substrString(S, lengthString(S) -Int 1, lengthString(S))
   168	       +String #reverse(substrString(S, 0, lengthString(S) -Int 1))
   169	    requires lengthString(S) >Int 0
   170	endmodule
