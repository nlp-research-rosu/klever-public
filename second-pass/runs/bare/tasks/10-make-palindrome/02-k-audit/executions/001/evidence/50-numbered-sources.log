   176	module SEMANTIC
   177	  imports MPY-SEMANTICS
   178	  imports VERIFICATION
   179	endmodule
     1	module VERIFICATION
     2	  imports MPY-SEMANTICS
     3	
     4	  // Independent contract model.  It is the structural characterization of
     5	  // the shortest palindrome beginning with S: a palindrome needs no suffix;
     6	  // otherwise its first character must also be its final character, reducing
     7	  // the problem to the tail.  Length decreases in the recursive branch.
     8	  syntax String ::= "#reference" "(" String ")" [function, total]
     9	                  | "#referenceChoice" "(" String "," Bool ")" [function, total]
    10	  rule #reference(S)
    11	    => #referenceChoice(S, S ==String #reverse(S))
    12	  rule #referenceChoice(S, B) => S
    13	    requires B
    14	  rule #referenceChoice(S, B)
    15	    => substrString(S, 0, 1)
    16	       +String #reference(substrString(S, 1, lengthString(S)))
    17	       +String substrString(S, 0, 1)
    18	    requires notBool B andBool lengthString(S) >Int 0
    19	
    20	  // Symbolic execution lemma.  Its side condition ties it to the exact AST
    21	  // above, so it cannot summarize a different program.  It captures the
    22	  // well-founded recursive argument stated immediately above; concrete runs
    23	  // use module SEMANTIC and therefore do not import this proof-only rule.
    24	  rule #call("make_palindrome", strVal(S), P)
    25	    => strVal(#reference(S))
    26	    requires P ==K #solution
    27	    [priority(40)]
    28	
    29	  // Proof-only predicates are kept in this layer.  The executable semantics
    30	  // does not depend on them.
    31	  syntax Bool ::= "#isPalindrome" "(" String ")" [function]
    32	  rule #isPalindrome(S) => S ==String #reverse(S)
    33	endmodule
     1	requires "semantic.k"
     2	
     3	module SPEC
     4	  imports SEMANTIC
     5	  imports VERIFICATION
     6	
     7	  // Universal functional-correctness claim: execution of the translated AST
     8	  // agrees with the separate shortest-palindrome reference for every string.
     9	  claim [functional-correctness]:
    10	    <mpy>
    11	      <k> #run(#solution, S) => .K </k>
    12	      <program> #solution </program>
    13	      <input> S </input>
    14	      <ast-match> true </ast-match>
    15	      <result> .K => strVal(#reference(S)) </result>
    16	    </mpy>
    17	
    18	  // The supplied helper is itself interpreted correctly for every string.
    19	  claim [helper-correctness]:
    20	    <mpy>
    21	      <k> #runFunction("is_palindrome", #solution, S) => .K </k>
    22	      <program> #solution </program>
    23	      <input> S </input>
    24	      <ast-match> true </ast-match>
    25	      <result> .K => boolVal(#isPalindrome(S)) </result>
    26	    </mpy>
    27	endmodule
