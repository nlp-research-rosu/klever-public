+        ("prompt-empty", ""),
+        ("prompt-cat", "cat"),
+        ("prompt-cata", "cata"),
+        ("one-char-palindrome", "a"),
+        ("two-char-palindrome", "aa"),
+        ("first-recursive-boundary", "ab"),
+        ("odd-palindrome", "xyx"),
+        ("repeated-recursion", "abcd"),
+        ("combining-unicode", "a\u0301b"),
+        ("astral-unicode", "a🙂b"),
+        ("embedded-nul", "a\x00b"),
+        ("recursion-limit-boundary", "a" * 1200 + "b"),
