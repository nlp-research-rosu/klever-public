+        return {
+            "kind": "return",
+            "type": type(result).__name__,
+            "length": len(result),
+            "sha256": hashlib.sha256(encoded).hexdigest(),
+            "value": result if len(result) <= 80 else None,
+        }
+    except BaseException as error:
+        return {
+            "kind": "raise",
+            "type": type(error).__name__,
