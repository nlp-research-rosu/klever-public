+                "k_candidate_mismatch_count": k_candidate_mismatches,
+            },
+            sort_keys=True,
+        )
+    )
+    return 1 if k_oracle_mismatches else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
