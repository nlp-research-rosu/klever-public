     6	
     7	def is_palindrome(string: str) -> bool:
     8	    """ Test if given string is a palindrome """
     9	    return string == string[::-1]
    10	
    11	
    12	def make_palindrome(string: str) -> str:
    13	    """ Find the shortest palindrome that begins with a supplied string.
    14	    Algorithm idea is simple:
    15	    - Find the longest postfix of supplied string that is a palindrome.
    16	    - Append to the end of the string reverse of a string prefix that comes before the palindromic suffix.
    17	    >>> make_palindrome('')
    18	    ''
    19	    >>> make_palindrome('cat')
    20	    'catac'
    21	    >>> make_palindrome('cata')
    22	    'catac'
    23	    """
    24	    if not string:
    25	        return ''
    26	
    27	    beginning_of_suffix = 0
    28	
    29	    while not is_palindrome(string[beginning_of_suffix:]):
    30	        beginning_of_suffix += 1
    31	
    32	    return string + string[:beginning_of_suffix][::-1]
===== /candidate/solution.py =====
     1	def is_palindrome(string: str) -> bool:
     2	    return string == string[::-1]
     3	
     4	
     5	def make_palindrome(string: str) -> str:
     6	    if is_palindrome(string):
     7	        return string
     8	    return string[0] + make_palindrome(string[1:]) + string[0]
