index 0000000000000000000000000000000000000000..0a86c1b1e223ef00673b5cf0c5143ecd7e3b3322
--- /dev/null
+++ b/evidence/run-positive-claims.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+work=/tmp/audit-work/candidate
+logger=/audit-output/evidence/run-logged.sh
+
+cd "$work"
+
+"$logger" /audit-output/evidence/stage3-kprove-SPEC-functional-correctness-repeat.log \
