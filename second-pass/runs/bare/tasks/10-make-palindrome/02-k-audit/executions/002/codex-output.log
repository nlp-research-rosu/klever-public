+
+"$logger" /audit-output/evidence/stage3-kprove-SPEC-functional-correctness-repeat.log \
+  kprove spec.k \
+  --definition "$work/fresh-semantic-proof-kompiled" \
+  --spec-module SPEC \
+  --claims SPEC.functional-correctness \
