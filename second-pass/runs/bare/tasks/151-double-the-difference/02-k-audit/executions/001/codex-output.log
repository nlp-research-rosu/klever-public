from pathlib import Path
import hashlib,os,stat

def h(root,prefix='',dirs=True,size=True,lenprefix=True,kindnul=True):
 es=[]
 for p in root.rglob('*'):
  rel=(prefix+'/'+p.relative_to(root).as_posix()).lstrip('/')
  if p.is_dir():
   if dirs: es.append((rel,'directory',p))
  elif p.is_file(): es.append((rel,'file',p))
 d=hashlib.sha256()
 for rel,k,p in sorted(es):
  b=rel.encode()
  if lenprefix:d.update(len(b).to_bytes(4,'big'))
  d.update(b)
  d.update(k.encode()+(b'\\0' if kindnul else b''))
  if k=='file':
   if size:d.update(p.stat().st_size.to_bytes(8,'big'))
   d.update(p.read_bytes())
 return d.hexdigest()
