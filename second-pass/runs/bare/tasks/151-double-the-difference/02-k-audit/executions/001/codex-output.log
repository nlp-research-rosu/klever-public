@@ -0,0 +1,36 @@
+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // Keep the genuine loop helper so the entry reaches its result obligation.
+  claim [loop-helper]:
+    <py>
+      <k>
+        loop("value", pyList(VS), loopBody)
+        ~> Return(Name("total")) .Stmts
+        => .K
+      </k>
+      <input> _INPUT:Val </input>
+      <lst> _L:Val => noValue </lst>
+      <total> pyInt(ACC) => pyInt(0) </total>
+      <value> _OLD:Val => pyInt(0) </value>
+      <function> _FUN:Function => noFunction </function>
+      <result> noResult => pyInt(oddSquareFold(VS, ACC)) </result>
+    </py>
+
+  // Fresh false mutation: require one more than the real returned result.
+  // The precondition is satisfiable, for example VS = nil, where 0 != 1.
+  claim [false-entry-result]:
+    <py>
+      <k> solutionProgram => .K </k>
+      <input> pyList(VS) </input>
+      <lst> noValue </lst>
+      <total> pyInt(0) </total>
+      <value> pyInt(0) </value>
+      <function> noFunction </function>
+      <result>
+        noResult => pyInt(oddSquareFold(VS, 0) +Int 1)
+      </result>
+    </py>
+endmodule
diff --git a/evidence/verification-body-mutation.k b/evidence/verification-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..ee35e7e36c5564c330923afd81f3366a98735049
--- /dev/null
+++ b/evidence/verification-body-mutation.k
@@ -0,0 +1,29 @@
+requires "semantic.k"
+
+module VERIFICATION-BODY-MUTATION
+  imports MPY
+
+  // Reviewer mutation: for each selected value, add value^2 + 1.
+  syntax Stmts ::= "mutatedLoopBody" [function]
+  rule mutatedLoopBody
+    => If(Call(Name("isinstance"), Name("value"), Name("int")),
+         If(Compare(Name("value"), CmpOp(">=", Int(0))),
+            If(Compare(BinOp("%", Name("value"), Int(2)),
+                       CmpOp("==", Int(1))),
+               Assign(Name("total"),
+                      BinOp("+",
+                        BinOp("+", Name("total"),
+                             BinOp("*", Name("value"), Name("value"))),
+                        Int(1))),
+               .Stmts),
+            .Stmts),
+         .Stmts)
+
+  syntax Module ::= "solutionProgramMutation" [function]
+  rule solutionProgramMutation
+    => Module(
+         FuncDef("double_the_difference", Params("lst"),
+           Assign(Name("total"), Int(0))
+           For(Name("value"), Name("lst"), mutatedLoopBody)
+           Return(Name("total"))))
+endmodule

