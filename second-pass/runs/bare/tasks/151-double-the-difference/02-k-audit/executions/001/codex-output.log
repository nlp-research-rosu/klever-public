+#!/usr/bin/env bash
+set -u
+
+record_status() {
+  local label="$1"
+  local status="$2"
+  printf '%s_EXIT_STATUS=%s\n' "$label" "$status"
+  if [[ "$status" -ne 0 ]]; then
+    exit "$status"
