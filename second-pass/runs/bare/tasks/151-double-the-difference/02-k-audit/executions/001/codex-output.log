index 0000000000000000000000000000000000000000..027b1e2de9d9bd8a1ad3f733b6f626738a5f764d
--- /dev/null
+++ b/evidence/program-body-mutation.mpy
@@ -0,0 +1,22 @@
+Module(
+  FuncDef("double_the_difference", Params("lst"),
+    Assign(Name("total"), Int(0))
+    For(Name("value"), Name("lst"),
+      If(Call(Name("isinstance"), Name("value"), Name("int")),
+        If(Compare(Name("value"), CmpOp(">=", Int(0))),
+          If(Compare(
+            BinOp("%", Name("value"), Int(2)),
+            CmpOp("==", Int(1))),
+            Assign(
+              Name("total"),
+              BinOp(
+                "+",
+                BinOp(
+                  "+",
+                  Name("total"),
+                  BinOp("*", Name("value"), Name("value"))),
+                Int(1))),
+            ),
+          ),
+        ))
+    Return(Name("total"))))
