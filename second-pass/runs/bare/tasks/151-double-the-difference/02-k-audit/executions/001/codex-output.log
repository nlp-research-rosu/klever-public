index 0000000000000000000000000000000000000000..13d9fc6a92733619fd011afa9352b987f9af15a8
--- /dev/null
+++ b/evidence/spec-labeled.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module SPEC-AUDIT
+  imports VERIFICATION
+
+  claim [loop-audit]:
+    <py>
+      <k>
