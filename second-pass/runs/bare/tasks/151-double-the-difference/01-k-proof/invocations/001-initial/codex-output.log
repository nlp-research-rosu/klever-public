+  rule eval(Name(X), (X |-> V) _REST) => V
+
+  rule eval(BinOp("+", E1, E2), ENV)
+    => addVal(eval(E1, ENV), eval(E2, ENV))
+  rule eval(BinOp("*", E1, E2), ENV)
+    => mulVal(eval(E1, ENV), eval(E2, ENV))
