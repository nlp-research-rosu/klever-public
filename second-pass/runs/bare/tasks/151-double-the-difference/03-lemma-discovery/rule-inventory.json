      "start_line": 10,
      "text": "  rule loopBody\n    => If(Call(Name(\"isinstance\"), Name(\"value\"), Name(\"int\")),\n         If(Compare(Name(\"value\"), CmpOp(\">=\", Int(0))),\n            If(Compare(BinOp(\"%\", Name(\"value\"), Int(2)),\n                       CmpOp(\"==\", Int(1))),\n               Assign(Name(\"total\"),\n                      BinOp(\"+\", Name(\"total\"),\n                           BinOp(\"*\", Name(\"value\"), Name(\"value\")))),\n               .Stmts),\n            .Stmts),\n         .Stmts)"
    },
    {
      "attributes": [],
      "end_line": 28,
      "module": "VERIFICATION",
      "normalized_sha256": "e0ae7f562a5a11b10584f0fb0c6d0b749dfc727a5985bfecd6b7a36f2f96f9ad",
      "source_rule_id": "rule-e0ae7f562a5a11b10584f0fb0c6d0b749dfc727a5985bfecd6b7a36f2f96f9ad",
      "start_line": 23,
      "text": "  rule solutionProgram\n    => Module(\n         FuncDef(\"double_the_difference\", Params(\"lst\"),\n           Assign(Name(\"total\"), Int(0))\n           For(Name(\"value\"), Name(\"lst\"), loopBody)\n           Return(Name(\"total\"))))"
    },
