+            "text": rule["text"],
+        }
+    )
+
+canonical_inventory_hash = k_rule_inventory.canonical_json_sha256(
+    inventory["rules"]
+)
+
+checks = {
+    "AUDIT_MODE_environment": os.environ.get("AUDIT_MODE"),
