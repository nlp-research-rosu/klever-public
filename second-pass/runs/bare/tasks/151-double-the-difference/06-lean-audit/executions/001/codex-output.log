+    "audit_producer_path_image_key": audit_image_key,
+    "generator_image_matches_source_manifest": image_id
+    == source_manifest["generator_image_id"],
+    "generator_image_matches_audit_path": image_id.removeprefix("sha256:")
+    == audit_image_key,
