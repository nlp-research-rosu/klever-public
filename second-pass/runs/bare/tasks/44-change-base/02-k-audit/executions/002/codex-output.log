diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ad648c90552444d1e946df1eb1596fba3dae0976
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -u
+
+if [ "$#" -lt 2 ]; then
+  echo "usage: $0 LOG_NAME COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_name=$1
+shift
+log_path="/audit-output/evidence/${log_name}.log"
+
+{
+  echo "UTC_START: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  echo "CWD: $(pwd)"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  echo
+} > "$log_path"
+
+"$@" >> "$log_path" 2>&1
+status=$?
+
+{
+  echo "EXIT_STATUS: $status"
+  echo "UTC_END: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} >> "$log_path"
+
+exit "$status"
diff --git a/evidence/stage1_integrity.py b/evidence/stage1_integrity.py
new file mode 100644
index 0000000000000000000000000000000000000000..0410bfe98252572200addd8eec320978c125143d
