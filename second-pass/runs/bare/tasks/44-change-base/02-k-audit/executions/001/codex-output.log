@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: $0 LOG_NAME COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_name=$1
+shift
+log_path="/audit-output/evidence/${log_name}"
+
+{
+  printf 'CWD: %q\n' "$PWD"
+  printf 'PATH_SETUP: export PATH=%q\n' "${HOME}/.nix-profile/bin:\$PATH"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$log_path"
+
+export PATH="${HOME}/.nix-profile/bin:${PATH}"
+set +e
+"$@" 2>&1 | tee -a "$log_path"
+command_status=${PIPESTATUS[0]}
+set -e
+printf 'EXIT_STATUS: %d\n' "$command_status" | tee -a "$log_path"
+exit "$command_status"
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..3bdfa0d8b5b56e3ef1563ba7060d30325a50d490
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Auditor mutation: append one extra zero to every required result.
+  // Satisfying witness X = 0, B = 2 executes to "0", not "00".
+  claim
+    <k>
+      call(
+        Module(
+          FuncDef("change_base", Params("x", "base"),
+            If(Compare(Name("x"), CmpOp("<", Name("base"))),
+              Return(Call(Name("str"), Name("x"))),
+              .Stmts)
+            Return(
+              BinOp(
+                "+",
+                Call(
+                  Name("change_base"),
+                  BinOp("//", Name("x"), Name("base")),
+                  Name("base")),
+                Call(Name("str"),
+                     BinOp("%", Name("x"), Name("base"))))))),
+        "change_base", intVal(X), intVal(B))
+      ~> CONT:K
+    =>
+      strVal(baseString(X, B) +String "0") ~> CONT
+    </k>
+    requires 0 <=Int X andBool 2 <=Int B andBool B <=Int 9
+endmodule
