+    print("OUTER_TYPE_COUNTS:")
+    for key, count in sorted(outer_counts.items()):
+        print(f"  {key}: {count}")
+    print("PAYLOAD_TYPE_COUNTS:")
+    for key, count in sorted(payload_counts.items()):
