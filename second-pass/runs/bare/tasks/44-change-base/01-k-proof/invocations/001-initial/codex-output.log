+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" String "," String ")"
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr  ::= "Name" "(" String ")"
+                 | "Int" "(" Int ")"
+                 | "BinOp" "(" String "," Expr "," Expr ")"
+                 | "Compare" "(" Expr "," CmpOp ")"
+                 | "Call" "(" Expr "," Exprs ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  syntax Value ::= intVal(Int)
+                 | strVal(String)
+                 | boolVal(Bool)
