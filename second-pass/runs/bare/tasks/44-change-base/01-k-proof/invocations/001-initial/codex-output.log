diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..906ff4d9cc9c46d34510661bfbfab1baa4c93a25
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,18 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX
+
+krun solution.mpy -cX=8 -cBASE=3 --definition verification-kompiled
+krun solution.mpy -cX=8 -cBASE=2 --definition verification-kompiled
+krun solution.mpy -cX=7 -cBASE=2 --definition verification-kompiled
+krun solution.mpy -cX=1234 -cBASE=7 --definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..e7640b0b514386ace81b68e749b4397c783dc35e
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,151 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Stmts  ::= List{Stmt, ""}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" String "," String ")"
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr  ::= "Name" "(" String ")"
+                 | "Int" "(" Int ")"
+                 | "BinOp" "(" String "," Expr "," Expr ")"
+                 | "Compare" "(" Expr "," CmpOp ")"
+                 | "Call" "(" Expr "," Exprs ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  syntax Value ::= intVal(Int)
+                 | strVal(String)
+                 | boolVal(Bool)
+
+  syntax Stmts ::= appendStmts(Stmts, Stmts) [function]
+  rule appendStmts(.Stmts, SS) => SS
+  rule appendStmts((S:Stmt SS:Stmts), TT) => S appendStmts(SS, TT)
+
+  // The internal control terms below are deliberately separate from the
+  // source AST.  They form a small-step semantics for exactly the Python
+  // constructs used by solution.py.
+  syntax KItem ::= call(Program, String, Value, Value)
+                 | exec(Stmts, Map, Program)
+                 | eval(Expr, Map, Program)
+                 | branch(Stmts, Stmts, Stmts, Map, Program)
+                 | cmpLeft(String, Expr, Map, Program)
+                 | cmpRight(String, Value)
+                 | binLeft(String, Expr, Map, Program)
+                 | binRight(String, Value)
+                 | toString()
+                 | callArgLeft(String, Expr, Map, Program)
+                 | callArgRight(String, Value, Program)
+
+  configuration
+    <k> call($PGM:Program, "change_base", intVal($X:Int), intVal($BASE:Int)) </k>
+
+  // Function lookup, parameter binding, and statement execution.
+  rule <k>
+         call(Module(FuncDef(F, Params(X, B), BODY)), F, VX, VB)
+      => exec(BODY,
+              ((X |-> VX) (B |-> VB)),
+              Module(FuncDef(F, Params(X, B), BODY)))
+       ...
+       </k>
+
+  rule <k> exec(.Stmts, _RHO, _PGM) => strVal("") ... </k>
+
+  // A return exits the whole current statement list.  This subset contains
+  // no fall-through expression statements, so no extra completion value is
+  // needed.
+  rule <k> exec(Return(E) _REST, RHO, PGM) => eval(E, RHO, PGM) ... </k>
+
+  rule <k>
+         exec(If(COND, THEN, ELSE) REST, RHO, PGM)
+      => eval(COND, RHO, PGM) ~> branch(THEN, ELSE, REST, RHO, PGM)
+       ...
+       </k>
+  rule <k>
+         boolVal(true) ~> branch(THEN:Stmts, _ELSE:Stmts, REST:Stmts, RHO, PGM)
+      => exec(appendStmts(THEN, REST), RHO, PGM)
+       ...
+       </k>
+  rule <k>
+         boolVal(false) ~> branch(_THEN:Stmts, ELSE:Stmts, REST:Stmts, RHO, PGM)
+      => exec(appendStmts(ELSE, REST), RHO, PGM)
+       ...
+       </k>
+
+  // Literals and variables.
+  rule <k> eval(Int(I), _RHO, _PGM) => intVal(I) ... </k>
+  rule <k> eval(Name(X), RHO, _PGM) => RHO [ X ] ... </k>
+
+  // Single comparisons (the only comparison shape used by the program).
+  rule <k>
+         eval(Compare(LEFT, CmpOp(OP, RIGHT)), RHO, PGM)
+      => eval(LEFT, RHO, PGM) ~> cmpLeft(OP, RIGHT, RHO, PGM)
+       ...
+       </k>
+  rule <k>
+         V:Value ~> cmpLeft(OP, RIGHT, RHO, PGM)
+      => eval(RIGHT, RHO, PGM) ~> cmpRight(OP, V)
+       ...
+       </k>
+  rule <k> intVal(J) ~> cmpRight("<", intVal(I))
+        => boolVal(I <Int J) ... </k>
+
+  // Binary expressions evaluate left-to-right, as Python does.
+  rule <k>
+         eval(BinOp(OP, LEFT, RIGHT), RHO, PGM)
+      => eval(LEFT, RHO, PGM) ~> binLeft(OP, RIGHT, RHO, PGM)
+       ...
+       </k>
+  rule <k>
+         V:Value ~> binLeft(OP, RIGHT, RHO, PGM)
+      => eval(RIGHT, RHO, PGM) ~> binRight(OP, V)
+       ...
+       </k>
+  rule <k> intVal(J) ~> binRight("//", intVal(I))
+        => intVal(I /Int J) ... </k>
+    requires J =/=Int 0
+  rule <k> intVal(J) ~> binRight("%", intVal(I))
+        => intVal(I %Int J) ... </k>
+    requires J =/=Int 0
+  rule <k> strVal(T) ~> binRight("+", strVal(S))
+        => strVal(S +String T) ... </k>
+
+  // Built-in str(int), plus ordinary two-argument function calls.
+  rule <k>
+         eval(Call(Name("str"), ARG), RHO, PGM)
+      => eval(ARG, RHO, PGM) ~> toString()
+       ...
+       </k>
+  rule <k> intVal(I) ~> toString() => strVal(Int2String(I)) ... </k>
+
+  rule <k>
+         eval(Call(Name(F), ARG1, ARG2), RHO, PGM)
+      => eval(ARG1, RHO, PGM) ~> callArgLeft(F, ARG2, RHO, PGM)
+       ...
+       </k>
+  rule <k>
+         V1:Value ~> callArgLeft(F, ARG2, RHO, PGM)
+      => eval(ARG2, RHO, PGM) ~> callArgRight(F, V1, PGM)
+       ...
+       </k>
+  rule <k>
+         V2:Value ~> callArgRight(F, V1, PGM)
+      => call(PGM, F, V1, V2)
+       ...
+       </k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..457b35165a7b6981a5669225abfcc1c6281fbf1d
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,4 @@
+def change_base(x: int, base: int):
+    if x < base:
+        return str(x)
+    return change_base(x // base, base) + str(x % base)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c25f91f736f492ec992413cecd6005d78f2f247b
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,32 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Total functional correctness over the HumanEval input domain.  CONT is
+  // universally quantified, so the circularity also applies to recursive
+  // calls while their string-concatenation continuation is still pending.
+  claim
+    <k>
+      call(
+        Module(
+          FuncDef("change_base", Params("x", "base"),
+            If(Compare(Name("x"), CmpOp("<", Name("base"))),
+              Return(Call(Name("str"), Name("x"))),
+              .Stmts)
+            Return(
+              BinOp(
+                "+",
+                Call(
+                  Name("change_base"),
+                  BinOp("//", Name("x"), Name("base")),
+                  Name("base")),
+                Call(Name("str"),
+                     BinOp("%", Name("x"), Name("base"))))))),
+        "change_base", intVal(X), intVal(B))
+      ~> CONT:K
+    =>
+      strVal(baseString(X, B)) ~> CONT
+    </k>
+    requires 0 <=Int X andBool 2 <=Int B andBool B <=Int 9
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d63227fd195580391cea45b40b179ac91b5e4a27
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,17 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical reference function for the contract.  Because base <= 9,
+  // every remainder is a single decimal digit, exactly as required by the
+  // prompt's string representation.
+  syntax String ::= baseString(Int, Int) [function]
+
+  rule baseString(X, B) => Int2String(X)
+    requires X <Int B
+
+  rule baseString(X, B)
+        => baseString(X /Int B, B) +String Int2String(X %Int B)
+    requires B <=Int X andBool 0 <Int B
+endmodule

exec
/bin/bash -lc 'chmod +x prove.sh && ./prove.sh' in /work
