gen_status=$?
cp /tmp/audit-work/reconstruction/pin-check.k /audit-output/evidence/pin-check.k
/audit-output/evidence/record_command.sh /audit-output/evidence/logs/10b-kprove-pin-check.log /tmp/audit-work/reconstruction kprove pin-check.k --definition verification-kompiled --spec-module PIN-CHECK
pin_status=$?
printf '"'GROUND_CHECK_EXIT=%s (nonzero means a submitted result differs)\\nPIN_GENERATE_EXIT=%s\\nPIN_PROOF_EXIT=%s\\n' \""'$ground_status" "$gen_status" "$pin_status"
exit $((gen_status != 0 || pin_status != 0))' in /audit-output
