from pathlib import Path
import hashlib, os, stat

def digest(root, skip_pycache=False):
    root=Path(root)
    entries=[]
    for p in root.rglob('*'):
      rel=p.relative_to(root).as_posix()
      if skip_pycache and ('__pycache__' in p.parts or p.suffix=='.pyc'): continue
      kind='directory' if p.is_dir() else 'file'
      entries.append((rel,kind,p))
    d=hashlib.sha256()
    for rel,kind,p in sorted(entries):
      e=rel.encode(); d.update(len(e).to_bytes(4,'big')); d.update(e); d.update(kind.encode()+b'\\0')
      if kind=='file':
        b=p.read_bytes(); d.update(len(b).to_bytes(8,'big')); d.update(b)
    return d.hexdigest()
print('no-pycache',digest('/candidate',True))
