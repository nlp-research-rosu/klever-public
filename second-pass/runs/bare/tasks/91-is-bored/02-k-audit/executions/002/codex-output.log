/audit-output/evidence/record_command.sh /audit-output/evidence/logs/12-semantics-differential.log /audit-output python3 /audit-output/evidence/semantics_differential.py
status=$?
printf '"'SEMANTICS_DIFFERENTIAL_EXIT=%s\\n' \""'$status"
exit "$status"' in /audit-output
