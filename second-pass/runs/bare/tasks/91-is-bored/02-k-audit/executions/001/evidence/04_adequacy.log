    33	
    34	  // Contract-level model: normalize sentence delimiters, split into
    35	  // sentences, trim Python whitespace, and count an initial word "I".
    36	  syntax Int ::= boredSpec(String) [function]
    37	               | countBored(Values) [function]
    38	               | boolInt(Bool) [function]
    39	  rule boredSpec(S) =>
    40	    countBored(splitDots(replaceAll(replaceAll(S, "!", "."), "?", ".")))
    41	  rule countBored(nil) => 0
    42	  rule countBored(cons(vStr(S), REST))
    43	    => boolInt(startsWith(strip(S), "I ")) +Int countBored(REST)
