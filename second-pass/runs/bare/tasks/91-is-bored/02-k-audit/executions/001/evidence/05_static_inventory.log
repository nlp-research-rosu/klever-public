     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // A named copy of the exact constructor tree emitted in solution.mpy.
     7	  // This lets each claim focus on inputs and outputs while still executing
     8	  // the translated Python program through the semantics.
     9	  syntax Module ::= "solutionModule" [function]
    10	  rule solutionModule =>
    11	    Module(
    12	      FuncDef("is_bored", Params("S"),
    13	        Assign(Name("count"), Int(0))
    14	        For(Name("sentence"),
    15	          Call(
    16	            Attribute(
    17	              Call(
    18	                Attribute(
    19	                  Call(Attribute(Name("S"), "replace"), Str("!"), Str(".")),
    20	                  "replace"),
    21	                Str("?"), Str(".")),
    22	              "split"),
    23	            Str(".")),
    24	          If(
    25	            Call(
    26	              Attribute(
    27	                Call(Attribute(Name("sentence"), "strip"), .Exprs),
    28	                "startswith"),
    29	              Str("I ")),
    30	            AugAssign(Name("count"), "+", Int(1)),
    31	            .Stmts))
    32	        Return(Name("count"))))
    33	
    34	  // Contract-level model: normalize sentence delimiters, split into
    35	  // sentences, trim Python whitespace, and count an initial word "I".
    36	  syntax Int ::= boredSpec(String) [function]
    37	               | countBored(Values) [function]
    38	               | boolInt(Bool) [function]
    39	  rule boredSpec(S) =>
    40	    countBored(splitDots(replaceAll(replaceAll(S, "!", "."), "?", ".")))
    41	  rule countBored(nil) => 0
    42	  rule countBored(cons(vStr(S), REST))
    43	    => boolInt(startsWith(strip(S), "I ")) +Int countBored(REST)
    44	  rule boolInt(true) => 1
    45	  rule boolInt(false) => 0
    46	endmodule
