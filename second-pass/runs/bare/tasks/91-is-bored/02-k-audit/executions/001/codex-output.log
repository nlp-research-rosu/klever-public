    98	  rule lookup("S", state(S, _, _)) => vStr(S)
    99	  rule lookup("count", state(_, N, _)) => vInt(N)
   100	  rule lookup("sentence", state(_, _, S)) => vStr(S)
   101	
   102	  syntax State ::= setCount(State, Int) [function]
   103	                 | setSentence(State, String) [function]
   104	  rule setCount(state(S, _, SENT), N) => state(S, N, SENT)
   105	  rule setSentence(state(S, N, _), SENT) => state(S, N, SENT)
   106	
   107	  syntax Int ::= getCount(State) [function]
   108	  rule getCount(state(_, N, _)) => N
   109	
   110	  // Expression and method-call semantics for the accepted program subset.
   111	  syntax Value ::= eval(Expr, State) [function]
   112	                 | replaceValue(Value, Value, Value) [function]
   113	                 | splitValue(Value, Value) [function]
   114	                 | stripValue(Value) [function]
   115	                 | startswithValue(Value, Value) [function]
   116	  rule eval(Name(X), ST) => lookup(X, ST)
   117	  rule eval(Int(N), _) => vInt(N)
   118	  rule eval(Str(S), _) => vStr(S)
   119	  rule eval(Call(Attribute(E, "replace"), A, B), ST)
   120	    => replaceValue(eval(E, ST), eval(A, ST), eval(B, ST))
   121	  rule eval(Call(Attribute(E, "split"), SEP), ST)
   122	    => splitValue(eval(E, ST), eval(SEP, ST))
   123	  rule eval(Call(Attribute(E, "strip"), .Exprs), ST)
   124	    => stripValue(eval(E, ST))
   125	  rule eval(Call(Attribute(E, "startswith"), PREFIX), ST)
   126	    => startswithValue(eval(E, ST), eval(PREFIX, ST))
   127	
   128	  rule replaceValue(vStr(S), vStr(OLD), vStr(NEW))
   129	    => vStr(replaceAll(S, OLD, NEW))
   130	  rule splitValue(vStr(S), vStr(".")) => vList(splitDots(S))
   131	  rule stripValue(vStr(S)) => vStr(strip(S))
   132	  rule startswithValue(vStr(S), vStr(PREFIX)) => vBool(startsWith(S, PREFIX))
   133	
   134	  syntax Int ::= asInt(Value) [function]
   135	  syntax Bool ::= asBool(Value) [function]
   136	  syntax Values ::= asValues(Value) [function]
   137	  rule asInt(vInt(N)) => N
   138	  rule asBool(vBool(B)) => B
   139	  rule asValues(vList(VS)) => VS
   140	
   141	  // Pure definitions of the three String methods used above.
   142	  syntax Values ::= splitDots(String) [function]
   143	                  | splitDotsAt(String, Int) [function]
   144	  rule splitDots(S) => splitDotsAt(S, findString(S, ".", 0))
   145	  rule splitDotsAt(S, -1) => cons(vStr(S), nil)
   146	  rule splitDotsAt(S, I)
   147	    => cons(vStr(substrString(S, 0, I)),
   148	            splitDots(substrString(S, I +Int 1, lengthString(S))))
   149	    requires I >=Int 0
   150	
   151	  syntax Bool ::= whiteSpace(String) [function]
   152	  rule whiteSpace(" ")  => true
   153	  rule whiteSpace("\t") => true
   154	  rule whiteSpace("\n") => true
   155	  rule whiteSpace("\r") => true
   156	  rule whiteSpace("\f") => true
   157	  rule whiteSpace("\u000b") => true
   158	  rule whiteSpace("\u001c") => true
   159	  rule whiteSpace("\u001d") => true
   160	  rule whiteSpace("\u001e") => true
   161	  rule whiteSpace("\u001f") => true
   162	  rule whiteSpace("\u0085") => true
   163	  rule whiteSpace("\u00a0") => true
   164	  rule whiteSpace("\u1680") => true
   165	  rule whiteSpace("\u2000") => true
   166	  rule whiteSpace("\u2001") => true
   167	  rule whiteSpace("\u2002") => true
   168	  rule whiteSpace("\u2003") => true
   169	  rule whiteSpace("\u2004") => true
   170	  rule whiteSpace("\u2005") => true
   171	  rule whiteSpace("\u2006") => true
   172	  rule whiteSpace("\u2007") => true
   173	  rule whiteSpace("\u2008") => true
   174	  rule whiteSpace("\u2009") => true
   175	  rule whiteSpace("\u200a") => true
   176	  rule whiteSpace("\u2028") => true
   177	  rule whiteSpace("\u2029") => true
   178	  rule whiteSpace("\u202f") => true
   179	  rule whiteSpace("\u205f") => true
   180	  rule whiteSpace("\u3000") => true
   181	  rule whiteSpace(_) => false [owise]
   182	
   183	  syntax String ::= strip(String) [function]
   184	                  | stripLeft(String) [function]
   185	                  | stripRight(String) [function]
   186	  rule strip(S) => stripRight(stripLeft(S))
   187	  rule stripLeft("") => ""
   188	  rule stripLeft(S) => stripLeft(substrString(S, 1, lengthString(S)))
   189	    requires whiteSpace(substrString(S, 0, 1))
   190	  rule stripLeft(S) => S
   191	    requires notBool whiteSpace(substrString(S, 0, 1))
   192	  rule stripRight("") => ""
   193	  rule stripRight(S) => stripRight(substrString(S, 0, lengthString(S) -Int 1))
   194	    requires whiteSpace(substrString(S, lengthString(S) -Int 1, lengthString(S)))
   195	  rule stripRight(S) => S
   196	    requires notBool whiteSpace(substrString(S, lengthString(S) -Int 1, lengthString(S)))
   197	
   198	  syntax Bool ::= startsWith(String, String) [function]
   199	  rule startsWith(S, PREFIX)
   200	    => (lengthString(S) >=Int lengthString(PREFIX))
   201	       andBool (substrString(S, 0, lengthString(PREFIX)) ==String PREFIX)
   202	endmodule
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // A named copy of the exact constructor tree emitted in solution.mpy.
     7	  // This lets each claim focus on inputs and outputs while still executing
     8	  // the translated Python program through the semantics.
     9	  syntax Module ::= "solutionModule" [function]
    10	  rule solutionModule =>
    11	    Module(
    12	      FuncDef("is_bored", Params("S"),
    13	        Assign(Name("count"), Int(0))
    14	        For(Name("sentence"),
    15	          Call(
    16	            Attribute(
    17	              Call(
    18	                Attribute(
    19	                  Call(Attribute(Name("S"), "replace"), Str("!"), Str(".")),
    20	                  "replace"),
    21	                Str("?"), Str(".")),
    22	              "split"),
    23	            Str(".")),
    24	          If(
    25	            Call(
    26	              Attribute(
    27	                Call(Attribute(Name("sentence"), "strip"), .Exprs),
    28	                "startswith"),
    29	              Str("I ")),
    30	            AugAssign(Name("count"), "+", Int(1)),
    31	            .Stmts))
    32	        Return(Name("count"))))
    33	
    34	  // Contract-level model: normalize sentence delimiters, split into
    35	  // sentences, trim Python whitespace, and count an initial word "I".
    36	  syntax Int ::= boredSpec(String) [function]
    37	               | countBored(Values) [function]
    38	               | boolInt(Bool) [function]
    39	  rule boredSpec(S) =>
    40	    countBored(splitDots(replaceAll(replaceAll(S, "!", "."), "?", ".")))
    41	  rule countBored(nil) => 0
    42	  rule countBored(cons(vStr(S), REST))
    43	    => boolInt(startsWith(strip(S), "I ")) +Int countBored(REST)
    44	  rule boolInt(true) => 1
    45	  rule boolInt(false) => 0
    46	endmodule
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // The two examples in prompt.py.
     7	  claim <k> start => done </k>
     8	        <program> solutionModule </program>
     9	        <input> "Hello world" </input>
    10	        <result> 0 </result>
    11	
    12	  claim <k> start => done </k>
    13	        <program> solutionModule </program>
    14	        <input> "The sky is blue. The sun is shining. I love this weather" </input>
    15	        <result> 0 => 1 </result>
    16	
    17	  // All three delimiters, repeated matches, and a trailing delimiter.
    18	  claim <k> start => done </k>
    19	        <program> solutionModule </program>
    20	        <input> "I am bored. I am still bored! Are you? I think so." </input>
    21	        <result> 0 => 3 </result>
    22	
    23	  // Leading whitespace is ignored independently for every sentence.
    24	  claim <k> start => done </k>
    25	        <program> solutionModule </program>
    26	        <input> " I am here?You are there!  I agree" </input>
    27	        <result> 0 => 2 </result>
    28	
    29	  // "I" must be a whole initial word, not merely an initial letter.
    30	  claim <k> start => done </k>
    31	        <program> solutionModule </program>
    32	        <input> "It is cold. Island life! In time? I agree" </input>
    33	        <result> 0 => 1 </result>
    34	
    35	  // Empty sentences and whitespace-only sentences contribute nothing.
    36	  claim <k> start => done </k>
    37	        <program> solutionModule </program>
    38	        <input> "... ! ?  . I count!" </input>
    39	        <result> 0 => 1 </result>
    40	
    41	  // strip() includes tabs and newlines, not only ordinary spaces.
    42	  claim <k> start => done </k>
    43	        <program> solutionModule </program>
    44	        <input> "\tI tabbed.\nI newline?\rNot me!" </input>
    45	        <result> 0 => 2 </result>
    46	
    47	  // Direct agreement with the separately stated contract model.
    48	  claim <k> start => done </k>
    49	        <program> solutionModule </program>
    50	        <input> "I first! No. I second?" </input>
    51	        <result> 0 => boredSpec("I first! No. I second?") </result>
    52	endmodule

