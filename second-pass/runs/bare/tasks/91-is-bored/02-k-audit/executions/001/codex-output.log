+  (( code == 0 )) || status=1
+done
+
+printf '%s\n' 'COMMAND: find /candidate/codex-trace -type f -name "*.jsonl" -printf "%p\n" | sort'
+find /candidate/codex-trace -type f -name '*.jsonl' -printf '%p\n' | sort
