diff --git a/evidence/06_nonvacuity.sh b/evidence/06_nonvacuity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..d8dabfc3db9e6d09ca73ad07450bcfa1a32bdd35
--- /dev/null
