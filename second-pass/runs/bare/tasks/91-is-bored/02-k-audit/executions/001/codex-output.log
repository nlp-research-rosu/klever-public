+    cd "$work" &&
+      timeout 120s kprove spec-labelled.k \
+        --definition verification-fresh-kompiled \
+        --spec-module SPEC \
+        --claims "SPEC.audit-$number"
+  )
+  code=$?
+  printf 'CLAIM audit-%s EXIT: %s\n' "$number" "$code"
+  (( code == 0 )) || status=1
+done
+
+exit "$status"
