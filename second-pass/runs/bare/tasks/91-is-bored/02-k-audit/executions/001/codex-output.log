+  "$work/semantic-fresh-kompiled" \
+  "$work/verification-fresh-kompiled" \
+  -maxdepth 1 -type f -printf '%p %s bytes\n' | sort
+code=$?
+printf 'EXIT: %s\n' "$code"
+(( code == 0 )) || status=1
+
+exit "$status"
