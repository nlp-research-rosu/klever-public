+code=$?
+printf 'EXIT: %s\n' "$code"
+(( code == 0 )) || status=1
+
+printf '%s\n' 'COMMAND: timeout 300s kompile verification.k --backend haskell --syntax-module MPY-SYNTAX --main-module VERIFICATION --output-definition verification-fresh-kompiled'
+(
+  cd "$work" &&
