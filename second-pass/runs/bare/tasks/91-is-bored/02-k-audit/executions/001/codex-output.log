+#!/usr/bin/env bash
+set -u
+
+status=0
+work=/tmp/audit-work/reconstruction
+
+printf '%s\n' 'COMMAND: nl -ba /reference/prompt.py'
+nl -ba /reference/prompt.py
+code=$?
+printf 'EXIT: %s\n' "$code"
+(( code == 0 )) || status=1
+
