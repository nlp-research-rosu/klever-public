+rg -n 'python differential cases:|#Top|RESULT: KPROVE|backend terminated' \
+  /candidate/codex-output.log | head -n 80
+code=${PIPESTATUS[0]}
+printf 'RG_EXIT: %s\n' "$code"
+
+printf '%s\n' 'COMMAND: python3 /audit-output/evidence/trace_summary.py'
