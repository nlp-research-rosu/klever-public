+(( code == 0 )) || status=1
+
+printf '%s\n' 'COMMAND: find /reference -maxdepth 2 -printf "%y %p -> %l\n" | sort'
+find /reference -maxdepth 2 -printf '%y %p -> %l\n' | sort
+code=$?
