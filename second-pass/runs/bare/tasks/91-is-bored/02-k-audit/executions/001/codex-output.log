+(( code == 0 )) || status=1
+
+printf '%s\n' 'COMMAND: find /candidate -maxdepth 2 -printf "%y %p -> %l\n" | sort'
+find /candidate -maxdepth 2 -printf '%y %p -> %l\n' | sort
