+code=$?
+printf 'EXIT: %s\n' "$code"
+(( code == 0 )) || status=1
+
+printf '%s\n' 'COMMAND: python3 -m json.tool /candidate/run-input.json'
+python3 -m json.tool /candidate/run-input.json
