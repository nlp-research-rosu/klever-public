+printf '%s\n' 'COMMAND: sed -n "1110,1148p;1718,1775p;1838,1870p" /usr/include/kframework/builtin/domains.md'
+sed -n '1110,1148p;1718,1775p;1838,1870p' \
+  /usr/include/kframework/builtin/domains.md
+code=$?
+printf 'EXIT: %s\n' "$code"
