+cmp "$work/regenerated.mpy" "$work/solution.mpy"
+code=$?
+printf 'EXIT: %s\n' "$code"
+(( code == 0 )) || status=1
+
+printf '%s\n' 'COMMAND: sha256sum regenerated.mpy solution.mpy'
+sha256sum "$work/regenerated.mpy" "$work/solution.mpy"
+code=$?
+printf 'EXIT: %s\n' "$code"
+(( code == 0 )) || status=1
+
