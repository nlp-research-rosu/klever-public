+  rule evalForRest(normal(ST), REST, BODY) => evalFor(REST, BODY, ST)
+
+  // State access is deliberately explicit: no hidden host-language store.
+  syntax Value ::= lookup(String, State) [function]
+  rule lookup("S", state(S, _, _)) => vStr(S)
