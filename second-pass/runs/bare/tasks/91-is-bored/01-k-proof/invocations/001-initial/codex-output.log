diff --git a/universal-spec.k b/universal-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..4e3d54d696f28c485138a8380cceb19606b1cbda
--- /dev/null
+++ b/universal-spec.k
@@ -0,0 +1,10 @@
+requires "verification.k"
+
