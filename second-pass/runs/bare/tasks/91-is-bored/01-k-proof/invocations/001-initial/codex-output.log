+                  | "vInt" "(" Int ")"
+                  | "vBool" "(" Bool ")"
+                  | "vList" "(" Values ")"
+  syntax Values ::= "nil"
+                  | "cons" "(" Value "," Values ")"
+  syntax State  ::= "state" "(" String "," Int "," String ")"
