Module(
  FuncDef("is_bored", Params("S"),
    Assign(Name("count"), Int(0))
    For(Name("sentence"), Call(
      Attribute(
        Call(
          Attribute(
            Call(Attribute(Name("S"), "replace"), Str("!"), Str(".")),
            "replace"),
          Str("?"),
          Str(".")),
        "split"),
      Str(".")),
      If(Call(
        Attribute(
          Call(Attribute(Name("sentence"), "strip"), ),
          "startswith"),
        Str("I ")),
        AugAssign(Name("count"), "+", Int(1)),
        ))
    Return(Name("count"))))
