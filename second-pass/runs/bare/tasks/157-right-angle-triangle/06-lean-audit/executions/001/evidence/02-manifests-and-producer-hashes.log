            "module": "VERIFICATION",
            "normalized_sha256": "4fee0a7dc4c0172c3b675bff411434ca46c778b577d492797129b2328534b07a",
            "rationale": "This nullary-function equation expands the named solutionProgram proof term to the exact translated Module AST, so it is a structural definition rather than an execution rule or mathematical lemma.",
            "source_rule_id": "rule-4fee0a7dc4c0172c3b675bff411434ca46c778b577d492797129b2328534b07a",
            "start_line": 19,
            "text": "  rule solutionProgram\n       => Module(\n            FuncDef(\"right_angle_triangle\", Params(\"a\", \"b\", \"c\"),\n              Return(\n                BoolOp(\n                  \"and\",\n                  Compare(Name(\"a\"), CmpOp(\">\", Int(0))),\n                  Compare(Name(\"b\"), CmpOp(\">\", Int(0))),\n                  Compare(Name(\"c\"), CmpOp(\">\", Int(0))),\n                  BoolOp(\n                    \"or\",\n                    Compare(\n                      BinOp(\n                        \"+\",\n                        BinOp(\"*\", Name(\"a\"), Name(\"a\")),\n                        BinOp(\"*\", Name(\"b\"), Name(\"b\"))),\n                      CmpOp(\"==\", BinOp(\"*\", Name(\"c\"), Name(\"c\")))),\n                    Compare(\n                      BinOp(\n                        \"+\",\n                        BinOp(\"*\", Name(\"a\"), Name(\"a\")),\n                        BinOp(\"*\", Name(\"c\"), Name(\"c\"))),\n                      CmpOp(\"==\", BinOp(\"*\", Name(\"b\"), Name(\"b\")))),\n                    Compare(\n                      BinOp(\n                        \"+\",\n                        BinOp(\"*\", Name(\"b\"), Name(\"b\")),\n                        BinOp(\"*\", Name(\"c\"), Name(\"c\"))),\n                      CmpOp(\"==\", BinOp(\"*\", Name(\"a\"), Name(\"a\")))))))))"
        }
