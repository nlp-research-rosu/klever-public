     1	def right_angle_triangle(a, b, c):
     2	    return a > 0 and b > 0 and c > 0 and (
     3	        a * a + b * b == c * c
     4	        or a * a + c * c == b * b
     5	        or b * b + c * c == a * a
     6	    )
