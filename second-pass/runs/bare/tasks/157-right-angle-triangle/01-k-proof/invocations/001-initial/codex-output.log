diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..58d801cd0e5555cd566fbb84de8a50f46e717ced
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,98 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  // The source constructors emitted by py2mpy.py for this program.
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "BoolOp" "(" String "," Exprs ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Exprs ::= List{Expr, ","}
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Ints ::= List{Int, ","}
+  syntax Arguments ::= "Args" "(" Ints ")"
+  syntax Input ::= Program
+                 | "run" "(" Program "," String "," Arguments ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports DOMAINS
+  imports MAP
+
+  syntax Value ::= "iVal" "(" Int ")" | "bVal" "(" Bool ")"
+  syntax Result ::= "noResult" | "result" "(" Bool ")"
+
+  syntax KItem ::= "bind" "(" Strings "," Ints ")"
+                 | "eval" "(" Expr ")"
+                 | "binRight" "(" String "," Expr ")"
+                 | "binApply" "(" String "," Int ")"
+                 | "cmpRight" "(" String "," Expr ")"
+                 | "cmpApply" "(" String "," Int ")"
+                 | "boolTail" "(" String "," Exprs ")"
+                 | "boolMerge" "(" String "," Bool "," Exprs ")"
+                 | "publish"
+
+  configuration
+    <mpy>
+      <k> $PGM:Input </k>
+      <env> .Map </env>
+      <result> noResult </result>
+    </mpy>
+
+  // A HumanEval file is a module containing one target definition. Reusing F
+  // in both positions enforces that the requested entry point is that target.
+  rule <k>
+         run(Module(FuncDef(F, Params(PS), Return(E))), F, Args(IS))
+         => bind(PS, IS) ~> eval(E) ~> publish
+       </k>
+
+  rule <k> bind(.Strings, .Ints) => .K ... </k>
+  rule <k> bind((P, PS), (I, IS)) => bind(PS, IS) ... </k>
+       <env> R => R [ P <- I ] </env>
+
+  rule <k> eval(Int(I)) => iVal(I) ... </k>
+  rule <k> eval(Name(X)) => iVal(I) ... </k>
+       <env> ... X |-> I:Int ... </env>
+
+  rule <k> eval(BinOp(OP, L, R)) => eval(L) ~> binRight(OP, R) ... </k>
+  rule <k> iVal(I) ~> binRight(OP, R) => eval(R) ~> binApply(OP, I) ... </k>
+  rule <k> iVal(J) ~> binApply("+", I) => iVal(I +Int J) ... </k>
+  rule <k> iVal(J) ~> binApply("*", I) => iVal(I *Int J) ... </k>
+
+  rule <k> eval(Compare(L, CmpOp(OP, R)))
+           => eval(L) ~> cmpRight(OP, R) ...
+       </k>
+  rule <k> iVal(I) ~> cmpRight(OP, R) => eval(R) ~> cmpApply(OP, I) ... </k>
+  rule <k> iVal(J) ~> cmpApply(">", I) => bVal(I >Int J) ... </k>
+  rule <k> iVal(J) ~> cmpApply("==", I) => bVal(I ==Int J) ... </k>
+
+  // All operands in the translated program are booleans. Evaluating the full
+  // list is observationally equivalent to Python short-circuiting here because
+  // the expression language is pure.
+  rule <k> eval(BoolOp(OP, E, ES)) => eval(E) ~> boolTail(OP, ES) ... </k>
+  rule <k> bVal(B) ~> boolTail(_OP, .Exprs) => bVal(B) ... </k>
+  rule <k> bVal(B) ~> boolTail(OP, E, ES)
+           => eval(E) ~> boolMerge(OP, B, ES) ...
+       </k>
+  rule <k> bVal(C) ~> boolMerge("and", B, ES)
+           => bVal(B andBool C) ~> boolTail("and", ES) ...
+       </k>
+  rule <k> bVal(C) ~> boolMerge("or", B, ES)
+           => bVal(B orBool C) ~> boolTail("or", ES) ...
+       </k>
+
+  rule <k> bVal(B) ~> publish => .K </k>
+       <env> _ => .Map </env>
+       <result> noResult => result(B) </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..8c5679c36fba717ebec28afae92ecc1ddae5853d
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def right_angle_triangle(a, b, c):
+    return a > 0 and b > 0 and c > 0 and (
+        a * a + b * b == c * c
+        or a * a + c * c == b * b
+        or b * b + c * c == a * a
+    )
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..8d901759b55f17e8e616c0f4dd075f416154166a
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,39 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Complete functional-correctness statement over the Int domain.
+  claim <k>
+          run(solutionProgram,
+              "right_angle_triangle", Args(A, B, C))
+          => .K
+        </k>
+        <env> .Map </env>
+        <result> noResult => result(rightTriangle(A, B, C)) </result>
+
+  // Executable witnesses for the prompt examples and side-order symmetry.
+  claim <k>
+          run(solutionProgram,
+              "right_angle_triangle", Args(3, 4, 5))
+          => .K
+        </k>
+        <env> .Map </env>
+        <result> noResult => result(true) </result>
+
+  claim <k>
+          run(solutionProgram,
+              "right_angle_triangle", Args(1, 2, 3))
+          => .K
+        </k>
+        <env> .Map </env>
+        <result> noResult => result(false) </result>
+
+  claim <k>
+          run(solutionProgram,
+              "right_angle_triangle", Args(5, 3, 4))
+          => .K
+        </k>
+        <env> .Map </env>
+        <result> noResult => result(true) </result>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..374d33e991f76710bc82dbf578b87f6b92d20dd2
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,48 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical contract: sides are positive and one side is the hypotenuse.
+  syntax Bool ::= "rightTriangle" "(" Int "," Int "," Int ")" [function, total]
+  rule rightTriangle(A, B, C)
+       => (A >Int 0)
+          andBool (B >Int 0)
+          andBool (C >Int 0)
+          andBool (((A *Int A) +Int (B *Int B)) ==Int (C *Int C)
+                   orBool ((A *Int A) +Int (C *Int C)) ==Int (B *Int B)
+                   orBool ((B *Int B) +Int (C *Int C)) ==Int (A *Int A))
+
+  // This is solution.mpy as a K term. Keeping it in the proof definition
+  // makes the universal claim execute the translated implementation itself.
+  syntax Program ::= "solutionProgram" [function]
+  rule solutionProgram
+       => Module(
+            FuncDef("right_angle_triangle", Params("a", "b", "c"),
+              Return(
+                BoolOp(
+                  "and",
+                  Compare(Name("a"), CmpOp(">", Int(0))),
+                  Compare(Name("b"), CmpOp(">", Int(0))),
+                  Compare(Name("c"), CmpOp(">", Int(0))),
+                  BoolOp(
+                    "or",
+                    Compare(
+                      BinOp(
+                        "+",
+                        BinOp("*", Name("a"), Name("a")),
+                        BinOp("*", Name("b"), Name("b"))),
+                      CmpOp("==", BinOp("*", Name("c"), Name("c")))),
+                    Compare(
+                      BinOp(
+                        "+",
+                        BinOp("*", Name("a"), Name("a")),
+                        BinOp("*", Name("c"), Name("c"))),
+                      CmpOp("==", BinOp("*", Name("b"), Name("b")))),
+                    Compare(
+                      BinOp(
+                        "+",
+                        BinOp("*", Name("b"), Name("b")),
+                        BinOp("*", Name("c"), Name("c"))),
+                      CmpOp("==", BinOp("*", Name("a"), Name("a")))))))))
+endmodule

