+                        BinOp("*", Name("a"), Name("a")),
+                        BinOp("*", Name("b"), Name("b"))),
+                      CmpOp("==", BinOp("*", Name("c"), Name("c")))),
+                    Compare(
+                      BinOp(
+                        "+",
+                        BinOp("*", Name("a"), Name("a")),
+                        BinOp("*", Name("c"), Name("c"))),
+                      CmpOp("==", BinOp("*", Name("b"), Name("b")))),
+                    Compare(
+                      BinOp(
+                        "+",
+                        BinOp("*", Name("b"), Name("b")),
+                        BinOp("*", Name("c"), Name("c"))),
+                      CmpOp("==", BinOp("*", Name("a"), Name("a")))))))))
+endmodule

