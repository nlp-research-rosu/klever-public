+#!/usr/bin/env bash
+set -u
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: $0 LOG_NAME COMMAND [ARG ...]" >&2
+  exit 2
+fi
+
+log_name=$1
+shift
+log_path="/audit-output/evidence/${log_name}.log"
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  command_status=$?
+  printf 'EXIT_STATUS: %d\n' "$command_status"
+  exit "$command_status"
+} >"$log_path" 2>&1

exec
/bin/bash -lc 'set +e
/audit-output/evidence/run_logged.sh 08c-make-concrete-inputs python3 /audit-output/evidence/make_concrete_runs.py
status=$?
for case_name in 3-4-5 1-2-3 5-3-4 3-5-4 0-0-0 0-3-3 3-0-3 3-3-0 neg3-4-5 3-neg4-5 3-4-neg5 large; do
  /audit-output/evidence/run_logged.sh "09c-krun-${case_name}" krun "run-${case_name}.mpy" --definition concrete-kompiled
  one=$?; if [[ $one -ne 0 ]]; then status=$one; fi
done
/audit-output/evidence/run_logged.sh 10c-concrete-python-comparison python3 /audit-output/evidence/compare_concrete_results.py
one=$?; if [[ $one -ne 0 ]]; then status=$one; fi
sed -n '"'1,260p' /audit-output/evidence/10c-concrete-python-comparison.log
exit \""'$status"' in /tmp/audit-work/reconstruction
