semantic.k:24:  syntax Input ::= Program
semantic.k:33:  syntax Value ::= "iVal" "(" Int ")" | "bVal" "(" Bool ")"
semantic.k:34:  syntax Result ::= "noResult" | "result" "(" Bool ")"
