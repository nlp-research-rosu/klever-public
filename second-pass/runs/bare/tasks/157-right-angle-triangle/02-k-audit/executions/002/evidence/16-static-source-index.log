COMMAND: bash -c rg\ -n\ \'\^\\s\*\(syntax\|configuration\|rule\|claim\)\|\\\[\(function\|total\|functional\|simplification\|priority\|owise\|anywhere\|macro\)\'\ semantic.k\ verification.k\ spec.k
