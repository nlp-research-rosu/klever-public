semantic.k:15:  syntax Params ::= "Params" "(" Strings ")"
semantic.k:16:  syntax Strings ::= List{String, ","}
semantic.k:17:  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
semantic.k:19:  syntax Stmts ::= List{Stmt, ""}
semantic.k:20:  syntax Program ::= "Module" "(" Stmts ")"
semantic.k:22:  syntax Ints ::= List{Int, ","}
