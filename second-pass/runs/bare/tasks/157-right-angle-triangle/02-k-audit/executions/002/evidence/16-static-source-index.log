semantic.k:46:  configuration
semantic.k:55:  rule <k>
semantic.k:60:  rule <k> bind(.Strings, .Ints) => .K ... </k>
semantic.k:61:  rule <k> bind((P, PS), (I, IS)) => bind(PS, IS) ... </k>
semantic.k:64:  rule <k> eval(Int(I)) => iVal(I) ... </k>
semantic.k:65:  rule <k> eval(Name(X)) => iVal(I) ... </k>
semantic.k:68:  rule <k> eval(BinOp(OP, L, R)) => eval(L) ~> binRight(OP, R) ... </k>
semantic.k:69:  rule <k> iVal(I) ~> binRight(OP, R) => eval(R) ~> binApply(OP, I) ... </k>
semantic.k:70:  rule <k> iVal(J) ~> binApply("+", I) => iVal(I +Int J) ... </k>
semantic.k:71:  rule <k> iVal(J) ~> binApply("*", I) => iVal(I *Int J) ... </k>
semantic.k:73:  rule <k> eval(Compare(L, CmpOp(OP, R)))
semantic.k:76:  rule <k> iVal(I) ~> cmpRight(OP, R) => eval(R) ~> cmpApply(OP, I) ... </k>
semantic.k:77:  rule <k> iVal(J) ~> cmpApply(">", I) => bVal(I >Int J) ... </k>
semantic.k:78:  rule <k> iVal(J) ~> cmpApply("==", I) => bVal(I ==Int J) ... </k>
semantic.k:83:  rule <k> eval(BoolOp(OP, E, ES)) => eval(E) ~> boolTail(OP, ES) ... </k>
semantic.k:84:  rule <k> bVal(B) ~> boolTail(_OP, .Exprs) => bVal(B) ... </k>
