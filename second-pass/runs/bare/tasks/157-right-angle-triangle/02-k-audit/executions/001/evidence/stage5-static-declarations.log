     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Mathematical contract: sides are positive and one side is the hypotenuse.
     7	  syntax Bool ::= "rightTriangle" "(" Int "," Int "," Int ")" [function, total]
     8	  rule rightTriangle(A, B, C)
     9	       => (A >Int 0)
    10	          andBool (B >Int 0)
    11	          andBool (C >Int 0)
    12	          andBool (((A *Int A) +Int (B *Int B)) ==Int (C *Int C)
    13	                   orBool ((A *Int A) +Int (C *Int C)) ==Int (B *Int B)
    14	                   orBool ((B *Int B) +Int (C *Int C)) ==Int (A *Int A))
    15	
    16	  // This is solution.mpy as a K term. Keeping it in the proof definition
    17	  // makes the universal claim execute the translated implementation itself.
    18	  syntax Program ::= "solutionProgram" [function]
    19	  rule solutionProgram
    20	       => Module(
    21	            FuncDef("right_angle_triangle", Params("a", "b", "c"),
    22	              Return(
    23	                BoolOp(
    24	                  "and",
    25	                  Compare(Name("a"), CmpOp(">", Int(0))),
    26	                  Compare(Name("b"), CmpOp(">", Int(0))),
    27	                  Compare(Name("c"), CmpOp(">", Int(0))),
    28	                  BoolOp(
    29	                    "or",
    30	                    Compare(
    31	                      BinOp(
    32	                        "+",
    33	                        BinOp("*", Name("a"), Name("a")),
    34	                        BinOp("*", Name("b"), Name("b"))),
    35	                      CmpOp("==", BinOp("*", Name("c"), Name("c")))),
    36	                    Compare(
    37	                      BinOp(
    38	                        "+",
    39	                        BinOp("*", Name("a"), Name("a")),
    40	                        BinOp("*", Name("c"), Name("c"))),
    41	                      CmpOp("==", BinOp("*", Name("b"), Name("b")))),
    42	                    Compare(
    43	                      BinOp(
    44	                        "+",
    45	                        BinOp("*", Name("b"), Name("b")),
    46	                        BinOp("*", Name("c"), Name("c"))),
    47	                      CmpOp("==", BinOp("*", Name("a"), Name("a")))))))))
    48	endmodule
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
