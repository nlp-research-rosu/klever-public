               Compare(\n                      BinOp(\n                        \"+\",\n                        BinOp(\"*\", Name(\"a\"), Name(\"a\")),\n                        BinOp(\"*\", Name(\"c\"), Name(\"c\"))),\n                      CmpOp(\"==\", BinOp(\"*\", Name(\"b\"), Name(\"b\")))),\n                    Compare(\n                      BinOp(\n                        \"+\",\n                        BinOp(\"*\", Name(\"b\"), Name(\"b\")),\n                        BinOp(\"*\", Name(\"c\"), Name(\"c\"))),\n                      CmpOp(\"==\", BinOp(\"*\", Name(\"a\"), Name(\"a\")))))))))\nendmodule\n"},"/work/spec.k":{"type":"add","content":"requires \"verification.k\"\n\nmodule SPEC\n  imports VERIFICATION\n\n  // Complete functional-correctness statement over the Int domain.\n  claim <k>\n          run(solutionProgram,\n              \"right_angle_triangle\", Args(A, B, C))\n          => .K\n        </k>\n        <env> .Map </env>\n        <result> noResult => result(rightTriangle(A, B, C)) </result>\n\n  // Executable witnesses for the prompt examples and side-order symmetry.\n  claim <k>\n          run(solutionProgram,\n              \"right_angle_triangle\", Args(3, 4, 5))\n          => .K\n        </k>\n        <env> .Map </env>\n        <result> noResult => result(true) </result>\n\n  claim <k>\n          run(solutionProgram,\n              \"right_angle_triangle\", Args(1, 2, 3))\n          => .K\n        </k>\n        <env> .Map </env>\n        <result> noResult => result(false) </result>\n\n  claim <k>\n          run(solutionProgram,\n              \"right_angle_triangle\", Args(5, 3, 4))\n          => .K\n        </k>\n        <env> .Map </env>\n        <result> noResult => result(true) </result>\nendmodule\n"}},"status":"completed"}}
