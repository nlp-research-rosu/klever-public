+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // This is exactly the constructor tree generated in solution.mpy.  The
+  // symbolic claim covers every positive exact rational, hence every positive
+  // finite Python float, and computes its fractional part without rounding.
+  claim
+    <k>
+      Module(FuncDef("truncate_number", Params("number"),
+        Return(BinOp("-", Name("number"),
+          Call(Name("int"), Name("number"))))))
+      ~> invoke("truncate_number", num(I, F, S))
+      => .K
+    </k>
+    <env> .Map => "number" |-> num(I, F, S) </env>
+    <result> noResult => num(0, F, S) </result>
+    requires validPositive(num(I, F, S))
+    ensures validFraction(num(0, F, S))
+
+  // Prompt example: 3.5 = 3 + 5/10 and the result is 0.5.
+  claim
+    <k>
+      Module(FuncDef("truncate_number", Params("number"),
+        Return(BinOp("-", Name("number"),
+          Call(Name("int"), Name("number"))))))
+      ~> invoke("truncate_number", num(3, 5, 10))
+      => .K
+    </k>
+    <env> .Map => "number" |-> num(3, 5, 10) </env>
+    <result> noResult => num(0, 5, 10) </result>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8a373c7b68fb12fe5d8a08f9fce9459d7cf1f031
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,22 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+  imports BOOL
+
+  // A canonical positive number has a nonnegative integer component and a
+  // proper nonnegative fractional numerator.
+  syntax Bool ::= "validPositive" "(" Value ")" [function, total]
+  rule validPositive(num(I, F, S))
+    => S >Int 0
+       andBool I >=Int 0
+       andBool F >=Int 0
+       andBool F <Int S
+       andBool (I >Int 0 orBool F >Int 0)
+  rule validPositive(intValue(_)) => false
+
+  syntax Bool ::= "validFraction" "(" Value ")" [function, total]
+  rule validFraction(num(I, F, S))
+    => I ==Int 0 andBool S >Int 0 andBool F >=Int 0 andBool F <Int S
+  rule validFraction(intValue(_)) => false
+endmodule

