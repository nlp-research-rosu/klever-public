+
+  // The concrete syntax is deliberately the constructor syntax emitted by
+  // py2mpy.py.  Statement and expression lists use the same separators as the
+  // transliterator (juxtaposition and comma, respectively).
+  syntax Program ::= "Module" "(" Stmts ")" [symbol(Module)]
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Exprs ::= List{Expr, ","}
+  syntax Strings ::= List{String, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol(FuncDef)]
+                | "If" "(" Expr "," Stmts "," Stmts ")"       [symbol(If)]
+                | "Return" "(" Expr ")"                         [symbol(Return)]
+
+  syntax Params ::= "Params" "(" Strings ")" [symbol(Params)]
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol(CmpOp)]
+
+  syntax Expr ::= "Int" "(" Int ")"                              [symbol(IntExpr)]
+                | "Name" "(" String ")"                          [symbol(Name)]
+                | "Call" "(" Expr "," Exprs ")"                 [symbol(Call)]
+                | "Compare" "(" Expr "," CmpOps ")"             [symbol(Compare)]
+                | "Subscript" "(" Expr "," Expr ")"             [symbol(Subscript)]
+                | "Slice" "(" Expr "," Expr "," Expr ")"       [symbol(Slice)]
+                | "UnaryOp" "(" String "," Expr ")"             [symbol(UnaryOp)]
+                | "BinOp" "(" String "," Expr "," Expr ")"     [symbol(BinOp)]
+                | "NoBound"                                       [symbol(NoBound)]
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports LIST
+  imports K-EQUAL
+
+  configuration
+    <mpy>
+      <k> $PGM:Program </k>
+      <input> $INPUT:List </input>
+      <result> .K </result>
+    </mpy>
+
+  // Runtime helpers.  A function body is passed as the third argument so a
+  // recursive call invokes the actual parsed body, not a built-in replacement.
+  // `run` is operational (rather than a function) so symbolic side conditions
+  // split proof paths. `addResult` is the return continuation for 1 + recurse.
+  syntax KItem ::= run(Stmts, List, Stmts)
+                 | finish(Int)
+                 | addResult(Int)
+                 | eval(Expr, List, Stmts)  [function]
+  syntax Bool ::= truth(Expr, List, Stmts)  [function]
+  syntax Stmts ::= concatStmts(Stmts, Stmts) [function]
+
+  rule concatStmts(.Stmts, S2) => S2
+  rule concatStmts((S:Stmt) S1, S2) => S concatStmts(S1, S2)
+
+  rule <k> Module(FuncDef("smallest_change", Params("arr"), BODY))
+             => run(BODY, L, BODY) </k>
+       <input> L </input>
+
+  // Statements.  Returning discards the remaining statements.  An if-body
+  // is prepended to the continuation exactly as Python executes it.
+  rule <k> run(If(Compare(Call(Name("len"), Name("arr")),
+                         CmpOp("<=", Int(1))), THEN, ELSE) REST, L, BODY)
+             => run(concatStmts(THEN, REST), L, BODY) ... </k>
+    requires size(L) <=Int 1
+  rule <k> run(If(Compare(Call(Name("len"), Name("arr")),
+                         CmpOp("<=", Int(1))), THEN, ELSE) REST, L, BODY)
+             => run(concatStmts(ELSE, REST), L, BODY) ... </k>
+    requires size(L) >Int 1
+  rule <k> run(If(Compare(Subscript(Name("arr"), Int(0)),
+                         CmpOp("==", Subscript(Name("arr"),
+                                               UnaryOp("-", Int(1))))),
+                    THEN, ELSE) REST, L, BODY)
+             => run(concatStmts(THEN, REST), L, BODY) ... </k>
+    requires L[0] ==K L[-1]
+  rule <k> run(If(Compare(Subscript(Name("arr"), Int(0)),
+                         CmpOp("==", Subscript(Name("arr"),
+                                               UnaryOp("-", Int(1))))),
+                    THEN, ELSE) REST, L, BODY)
+             => run(concatStmts(ELSE, REST), L, BODY) ... </k>
+    requires L[0] =/=K L[-1]
+
+  rule <k> run(Return(Int(I)) REST, L, BODY) => finish(I) ... </k>
+  rule <k> run(Return(Call(Name("smallest_change"), ARG)) REST, L, BODY)
+             => run(BODY, {eval(ARG, L, BODY)}:>List, BODY) ... </k>
+  rule <k> run(Return(BinOp("+", Int(I),
+                           Call(Name("smallest_change"), ARG))) REST, L, BODY)
+             => run(BODY, {eval(ARG, L, BODY)}:>List, BODY)
+                ~> addResult(I) ... </k>
+  rule <k> finish(I) ~> addResult(N) => finish(N +Int I) ... </k>
+  rule <k> finish(I) => .K </k>
+       <result> .K => I </result>
+
+  // Integer and list expressions used by solution.py.
+  rule eval(Int(I), L, BODY) => I
+  rule eval(UnaryOp("-", E), L, BODY)
+    => 0 -Int {eval(E, L, BODY)}:>Int
+  rule eval(BinOp("+", E1, E2), L, BODY)
+    => {eval(E1, L, BODY)}:>Int +Int {eval(E2, L, BODY)}:>Int
+  rule eval(Call(Name("len"), Name("arr")), L, BODY) => size(L)
+  rule eval(Subscript(Name("arr"), INDEX), L, BODY)
+    => L[{eval(INDEX, L, BODY)}:>Int]
+  rule eval(Subscript(Name("arr"), Slice(LOW, HIGH, NoBound)), L, BODY)
+    => range(L,
+             {eval(LOW, L, BODY)}:>Int,
+             0 -Int {eval(HIGH, L, BODY)}:>Int)
+  // Comparisons are intentionally interpreted here rather than translated by
+  // py2mpy.py.  List elements are constrained to Int by these projections.
+  rule truth(Compare(E1, CmpOp("<=", E2)), L, BODY)
+    => {eval(E1, L, BODY)}:>Int <=Int {eval(E2, L, BODY)}:>Int
+  rule truth(Compare(E1, CmpOp("==", E2)), L, BODY)
+    => eval(E1, L, BODY) ==K eval(E2, L, BODY)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..49c6b5757c43797c6e07afb7a6e006e03bc9f7c1
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def smallest_change(arr):
+    if len(arr) <= 1:
+        return 0
+    if arr[0] == arr[-1]:
+        return smallest_change(arr[1:-1])
+    return 1 + smallest_change(arr[1:-1])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5fd95566897ee566c8867c1291b3c8d0eacbeb54
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,56 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Exhaustive symbolic proof of the recurrence defining the minimum.  These
+  // claims cover every finite list: the length test is true or false, and in
+  // the latter case the two endpoints are equal or unequal.
+  claim <k>
+          run(#smallestChangeBody, L, #smallestChangeBody) ~> KONT
+          => finish(0) ~> KONT
+        </k>
+    requires size(L) <=Int 1
+
+  claim <k>
+          run(#smallestChangeBody, L, #smallestChangeBody) ~> KONT
+          => run(#smallestChangeBody, range(L, 1, 1),
+                 #smallestChangeBody) ~> KONT
+        </k>
+    requires size(L) >Int 1
+     andBool L[0] ==K L[-1]
+
+  claim <k>
+          run(#smallestChangeBody, L, #smallestChangeBody) ~> KONT
+          => run(#smallestChangeBody, range(L, 1, 1),
+                 #smallestChangeBody) ~> addResult(1) ~> KONT
+        </k>
+    requires size(L) >Int 1
+     andBool L[0] =/=K L[-1]
+
+  // The three examples from prompt.py additionally prove concrete executions
+  // of the evaluator.  Full Module/FuncDef linkage is exercised by krun.
+  claim <k>
+          run(#smallestChangeBody,
+               ListItem(1) ListItem(2) ListItem(3) ListItem(5)
+               ListItem(4) ListItem(7) ListItem(9) ListItem(6),
+               #smallestChangeBody)
+          => finish(4)
+        </k>
+
+  claim <k>
+          run(#smallestChangeBody,
+               ListItem(1) ListItem(2) ListItem(3) ListItem(4)
+               ListItem(3) ListItem(2) ListItem(2),
+               #smallestChangeBody)
+          => finish(1)
+        </k>
+
+  claim <k>
+          run(#smallestChangeBody,
+               ListItem(1) ListItem(2) ListItem(3)
+               ListItem(2) ListItem(1),
+               #smallestChangeBody)
+          => finish(0)
+        </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f40ee54bef8745d333e57a2c1781c1d17db67762
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,39 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // Mathematical specification.  Each outer pair is independent: an equal
+  // pair costs zero, while an unequal pair necessarily and sufficiently costs
+  // one edit.  Removing that pair therefore defines the minimum recursively.
+  syntax Int ::= minimumPalindromeChanges(List) [function, total]
+
+  rule minimumPalindromeChanges(L) => 0
+    requires size(L) <=Int 1 [simplification]
+  rule minimumPalindromeChanges(L)
+    => minimumPalindromeChanges(range(L, 1, 1))
+    requires size(L) >Int 1
+     andBool L[0] ==K L[-1] [simplification]
+  rule minimumPalindromeChanges(L)
+    => 1 +Int minimumPalindromeChanges(range(L, 1, 1))
+    requires size(L) >Int 1
+     andBool L[0] =/=K L[-1] [simplification]
+
+  // This macro is the exact Stmts tree in solution.mpy.  It makes the main
+  // claim readable while still proving the translated implementation itself.
+  syntax Stmts ::= "#smallestChangeBody" [function, symbol(smallestChangeBody)]
+  rule #smallestChangeBody =>
+    If(Compare(Call(Name("len"), Name("arr")), CmpOp("<=", Int(1))),
+      Return(Int(0)),
+      .Stmts)
+    If(Compare(Subscript(Name("arr"), Int(0)),
+               CmpOp("==", Subscript(Name("arr"), UnaryOp("-", Int(1))))),
+      Return(Call(Name("smallest_change"),
+                  Subscript(Name("arr"),
+                            Slice(Int(1), UnaryOp("-", Int(1)), NoBound)))),
+      .Stmts)
+    Return(BinOp("+", Int(1),
+                 Call(Name("smallest_change"),
+                      Subscript(Name("arr"),
+                                Slice(Int(1), UnaryOp("-", Int(1)), NoBound)))))
+endmodule

