+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports LIST
+  imports K-EQUAL
+
+  configuration
+    <mpy>
+      <k> $PGM:Program </k>
+      <input> $INPUT:List </input>
