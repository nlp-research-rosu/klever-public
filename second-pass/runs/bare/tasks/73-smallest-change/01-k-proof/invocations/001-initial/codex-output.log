+             => recur(BODY, {eval(ARG, L, BODY)}:>List, BODY)
+                ~> addResult(I) ... </k> [transition]
+  rule <k> recur(BODY, L, BODY) => run(BODY, L, BODY) ... </k>
+  rule <k> finish(I) ~> addResult(N) => finish(N +Int I) ... </k>
+  rule <k> finish(I) => .K </k>
