+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal partial-correctness theorem for every finite K List.  The
+  // circular proof follows the recursive call on range(L, 1, 1), whose size
+  // is two smaller.  This is the translated function body's return value.
+  /* claim <k> .K </k>
+          <input> L </input>
+          <result> exec(#smallestChangeBody, L, #smallestChangeBody) </result>
+    => <k> .K </k>
+       <input> L </input>
+       <result> minimumPalindromeChanges(L) </result> */
+
+  // Full-module linkage and the three examples from prompt.py.  These also
+  // ensure that Module/FuncDef parsing and configuration initialization are
+  // part of the proved path, rather than only the internal evaluator.
+  claim <k> Module(FuncDef("smallest_change", Params("arr"),
+                            #smallestChangeBody)) </k>
+          <input> ListItem(1) ListItem(2) ListItem(3) ListItem(5)
+                  ListItem(4) ListItem(7) ListItem(9) ListItem(6) </input>
+          <result> .K </result>
+    => <k> .K </k>
+         <input> ListItem(1) ListItem(2) ListItem(3) ListItem(5)
+                 ListItem(4) ListItem(7) ListItem(9) ListItem(6) </input>
+         <result> 4 </result>
+
+  claim <k> Module(FuncDef("smallest_change", Params("arr"),
+                            #smallestChangeBody)) </k>
+          <input> ListItem(1) ListItem(2) ListItem(3) ListItem(4)
+                  ListItem(3) ListItem(2) ListItem(2) </input>
+          <result> .K </result>
+    => <k> .K </k>
+         <input> ListItem(1) ListItem(2) ListItem(3) ListItem(4)
+                 ListItem(3) ListItem(2) ListItem(2) </input>
+         <result> 1 </result>
+
+  claim <k> Module(FuncDef("smallest_change", Params("arr"),
+                            #smallestChangeBody)) </k>
+          <input> ListItem(1) ListItem(2) ListItem(3)
+                  ListItem(2) ListItem(1) </input>
+          <result> .K </result>
+    => <k> .K </k>
+         <input> ListItem(1) ListItem(2) ListItem(3)
+                 ListItem(2) ListItem(1) </input>
+         <result> 0 </result>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e65ee6c03d0839963db50eadc0ce759ad4f16f25
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,39 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // Mathematical specification.  Each outer pair is independent: an equal
+  // pair costs zero, while an unequal pair necessarily and sufficiently costs
+  // one edit.  Removing that pair therefore defines the minimum recursively.
+  syntax Int ::= minimumPalindromeChanges(List) [function]
+
+  rule minimumPalindromeChanges(L) => 0
+    requires size(L) <=Int 1
+  rule minimumPalindromeChanges(L)
+    => minimumPalindromeChanges(range(L, 1, 1))
+    requires size(L) >Int 1
+     andBool L[0] ==K L[-1]
+  rule minimumPalindromeChanges(L)
+    => 1 +Int minimumPalindromeChanges(range(L, 1, 1))
+    requires size(L) >Int 1
+     andBool L[0] =/=K L[-1]
+
+  // This macro is the exact Stmts tree in solution.mpy.  It makes the main
+  // claim readable while still proving the translated implementation itself.
+  syntax Stmts ::= "#smallestChangeBody" [function, symbol(smallestChangeBody)]
+  rule #smallestChangeBody =>
+    If(Compare(Call(Name("len"), Name("arr")), CmpOp("<=", Int(1))),
+      Return(Int(0)),
+      .Stmts)
+    If(Compare(Subscript(Name("arr"), Int(0)),
+               CmpOp("==", Subscript(Name("arr"), UnaryOp("-", Int(1))))),
+      Return(Call(Name("smallest_change"),
+                  Subscript(Name("arr"),
+                            Slice(Int(1), UnaryOp("-", Int(1)), NoBound)))),
+      .Stmts)
+    Return(BinOp("+", Int(1),
+                 Call(Name("smallest_change"),
+                      Subscript(Name("arr"),
+                                Slice(Int(1), UnaryOp("-", Int(1)), NoBound)))))
+endmodule

