+    [-5, 0, 6],
+    [1, 2, 3, 5, 4, 7, 9, 6],
+    [1, 2, 3, 4, 3, 2, 2],
+    [1, 2, 3, 2, 1],
+    [10**30, -2, 8, 10**30],
+    [10**30, -2, 9, -(10**30)],
+]
+
+mismatches = []
+for index, values in enumerate(cases):
+    command = [
