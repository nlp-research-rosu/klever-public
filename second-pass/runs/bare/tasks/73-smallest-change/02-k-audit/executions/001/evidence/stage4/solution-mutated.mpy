Module(
  FuncDef("smallest_change", Params("arr"),
    If(Compare(Call(Name("len"), Name("arr")), CmpOp("<=", Int(1))),
      Return(Int(99)),
      )
    If(Compare(
      Subscript(Name("arr"), Int(0)),
      CmpOp("==", Subscript(Name("arr"), UnaryOp("-", Int(1))))),
      Return(
        Call(
          Name("smallest_change"),
          Subscript(
            Name("arr"),
            Slice(Int(1), UnaryOp("-", Int(1)), NoBound)))),
      )
    Return(
      BinOp(
        "+",
        Int(1),
        Call(
          Name("smallest_change"),
          Subscript(
            Name("arr"),
            Slice(Int(1), UnaryOp("-", Int(1)), NoBound)))))))
