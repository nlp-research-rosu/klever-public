+    passed = (
+        run.returncode == 0
+        and k_value == candidate_value
+        and candidate_value == canonical_value
+    )
+    print(f"CASE_MATCH: {passed}")
+    if not passed:
+        failures += 1
+
+print(f"TOTAL_CASES: {len(cases)}")
+print(f"MISMATCH_COUNT: {failures}")
+raise SystemExit(1 if failures else 0)

