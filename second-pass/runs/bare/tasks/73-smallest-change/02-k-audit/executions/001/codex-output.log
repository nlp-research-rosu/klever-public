+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  audit_status=$?
+  printf '\nEXIT_STATUS: %d\n' "$audit_status"
+  exit "$audit_status"
+} >"$audit_log" 2>&1
