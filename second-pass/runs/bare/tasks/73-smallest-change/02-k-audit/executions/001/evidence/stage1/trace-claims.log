exec: const patch = "*** Begin Patch\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module VERIFICATION\n+  imports SEMANTIC\n+\n+  // Mathematical specification.  Each outer pair is independent: an equal\n+  // pair costs zero, while an unequal pair necessarily and sufficiently costs\n+  // one edit.  Removing that pair therefore defines the minimum recursively.\n+  syntax Int ::= minimumPalindromeChanges(List) [function]\n+\n+  rule minimumPalindromeChanges(L) => 0\n+    requires size(L) <=Int 1\n+  rule minimumPalindromeChanges(L)\n+    => minimumPalindromeChanges(range(L, 1, 1))\n+    requires size(L) >Int 1\n+     andBool L[0] ==K L[-1]\n+  rule minimumPalindromeChanges(L)\n+    => 1 +Int minimumPalindromeChanges(range(L, 1, 1))\n+    requires size(L) >Int 1\n+     andBool L[0] =/=K L[-1]\n+\n+  // This macro is the exact Stmts tree in solution.mpy.  It makes the main\n+  // claim readable while still proving the translated implementation itself.\n+  syntax Stmts ::= \"#smallestChangeBody\" [macro]\n+  macro #smallestChangeBody =>\n+    If(Compare(Call(Name(\"len\"), Name(\"arr\")), CmpOp(\"<=\", Int(1))),\n+      Return(Int(0)),\n+      .Stmts)\n+    If(Compare(Subscript(Name(\"arr\"), Int(0)),\n+               CmpOp(\"==\", Subscript(Name(\"arr\"), UnaryOp(\"-\", Int(1))))),\n+      Return(Call(Name(\"smallest_change\"),\n+                  Subscript(Name(\"arr\"),\n+                            Slice(Int(1), UnaryOp(\"-\", Int(1)), NoBound)))),\n+      .Stmts)\n+    Return(BinOp(\"+\", Int(1),\n+                 Call(Name(\"smallest_change\"),\n+                      Subscript(Name(\"arr\"),\n+                                Slice(Int(1), UnaryOp(\"-\", Int(1)), NoBound)))))\n+endmodule\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module SPEC\n+  imports VERIFICATION\n+\n+  // Universal partial-correctness theorem for every finite K List.  The\n+  // circular proof follows the recursive call on range(L, 1, 1), whose size\n+  // is two smaller.  This is the translated function body's return value.\n+  claim exec(#smallestChangeBody, L, #smallestChangeBody)\n+    => minimumPalindromeChanges(L)\n+\n+  // Full-module linkage and the three examples from prompt.py.  These also\n+  // ensure that Module/FuncDef parsing and configuration initialization are\n+  // part of the proved path, rather than only the internal evaluator.\n+  claim <mpy>\n+          <k> Module(FuncDef(\"smallest_change\", Params(\"arr\"),\n+                            #smallestChangeBody)) </k>\n+          <input> ListItem(1) ListItem(2) ListItem(3) ListItem(5)\n+                  ListItem(4) ListItem(7) ListItem(9) ListItem(6) </input>\n+          <result> .K </result>\n+        </mpy>\n+    => <mpy>\n+         <k> .K </k>\n+         <input> ListItem(1) ListItem(2) ListItem(3) ListItem(5)\n+                 ListItem(4) ListItem(7) ListItem(9) ListItem(6) </input>\n+         <result> 4 </result>\n+       </mpy>\n+\n+  claim <mpy>\n+          <k> Module(FuncDef(\"smallest_change\", Params(\"arr\"),\n+                            #smallestChangeBody)) </k>\n+          <input> ListItem(1) ListItem(2) ListItem(3) ListItem(4)\n+                  ListItem(3) ListItem(2) ListItem(2) </input>\n+          <result> .K </result>\n+        </mpy>\n+    => <mpy>\n+         <k> .K </k>\n+         <input> ListItem(1) ListItem(2) ListItem(3) ListItem(4)\n+                 ListItem(3) ListItem(2) ListItem(2) </input>\n+         <result> 1 </result>\n+       </mpy>\n+\n+  claim <mpy>\n+          <k> Module(FuncDef(\"smallest_change\", Params(\"arr\"),\n+                            #smallestChangeBody)) </k>\n+          <input> ListItem(1) ListItem(2) ListItem(3)\n+                  ListItem(2) ListItem(1) </input>\n+          <result> .K </result>\n+        </mpy>\n+    => <mpy>\n+         <k> .K </k>\n+         <input> ListItem(1) ListItem(2) ListItem(3)\n+                 ListItem(2) ListItem(1) </input>\n+         <result> 0 </result>\n+  
