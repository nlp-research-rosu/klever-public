exec: const patch = "*** Begin Patch\n*** Update File: /work/semantic.k\n@@\n-  // Runtime helpers.  A function body is passed as the third argument so a\n-  // recursive call invokes the actual parsed body, not a built-in replacement.\n-  syntax KItem ::= exec(Stmts, List, Stmts)\n-                 | eval(Expr, List, Stmts)  [function]\n+  // Runtime helpers.  A function body is passed as the third argument so a\n+  // recursive call invokes the actual parsed body, not a built-in replacement.\n+  // `run` is operational (rather than a function) so symbolic side conditions\n+  // split proof paths. `addResult` is the return continuation for 1 + recurse.\n+  syntax KItem ::= run(Stmts, List, Stmts)\n+                 | finish(Int)\n+                 | addResult(Int)\n+                 | eval(Expr, List, Stmts)  [function]\n@@\n-  rule <k> Module(FuncDef(\"smallest_change\", Params(\"arr\"), BODY)) => .K </k>\n-       <input> L </input>\n-       <result> .K => exec(BODY, L, BODY) </result>\n+  rule <k> Module(FuncDef(\"smallest_change\", Params(\"arr\"), BODY))\n+             => run(BODY, L, BODY) </k>\n+       <input> L </input>\n@@\n-  rule exec(Return(E) REST, L, BODY) => eval(E, L, BODY)\n-  rule exec(If(COND, THEN, ELSE) REST, L, BODY)\n-    => exec(concatStmts(THEN, REST), L, BODY)\n+  rule <k> run(If(COND, THEN, ELSE) REST, L, BODY)\n+             => run(concatStmts(THEN, REST), L, BODY) ... </k>\n     requires truth(COND, L, BODY)\n-  rule exec(If(COND, THEN, ELSE) REST, L, BODY)\n-    => exec(concatStmts(ELSE, REST), L, BODY)\n+  rule <k> run(If(COND, THEN, ELSE) REST, L, BODY)\n+             => run(concatStmts(ELSE, REST), L, BODY) ... </k>\n     requires notBool truth(COND, L, BODY)\n+\n+  rule <k> run(Return(Int(I)) REST, L, BODY) => finish(I) ... </k>\n+  rule <k> run(Return(Call(Name(\"smallest_change\"), ARG)) REST, L, BODY)\n+             => run(BODY, {eval(ARG, L, BODY)}:>List, BODY) ... </k>\n+  rule <k> run(Return(BinOp(\"+\", Int(I),\n+            