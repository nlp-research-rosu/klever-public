     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // Mathematical specification.  Each outer pair is independent: an equal
     7	  // pair costs zero, while an unequal pair necessarily and sufficiently costs
     8	  // one edit.  Removing that pair therefore defines the minimum recursively.
     9	  syntax Int ::= minimumPalindromeChanges(List) [function, total]
    10	
    11	  rule minimumPalindromeChanges(L) => 0
    12	    requires size(L) <=Int 1 [simplification]
    13	  rule minimumPalindromeChanges(L)
    14	    => minimumPalindromeChanges(range(L, 1, 1))
    15	    requires size(L) >Int 1
    16	     andBool {L[0]}:>Int ==Int {L[-1]}:>Int [simplification]
    17	  rule minimumPalindromeChanges(L)
    18	    => 1 +Int minimumPalindromeChanges(range(L, 1, 1))
    19	    requires size(L) >Int 1
    20	     andBool notBool ({L[0]}:>Int ==Int {L[-1]}:>Int) [simplification]
    21	
    22	  // This function constant expands to the exact Stmts tree in solution.mpy.
    23	  // It keeps claims readable while still proving the translated body itself.
    24	  syntax Stmts ::= "#smallestChangeBody" [function, symbol(smallestChangeBody)]
    25	  rule #smallestChangeBody =>
    26	    If(Compare(Call(Name("len"), Name("arr")), CmpOp("<=", Int(1))),
    27	      Return(Int(0)),
    28	      .Stmts)
    29	    If(Compare(Subscript(Name("arr"), Int(0)),
    30	               CmpOp("==", Subscript(Name("arr"), UnaryOp("-", Int(1))))),
    31	      Return(Call(Name("smallest_change"),
    32	                  Subscript(Name("arr"),
    33	                            Slice(Int(1), UnaryOp("-", Int(1)), NoBound)))),
    34	      .Stmts)
    35	    Return(BinOp("+", Int(1),
    36	                 Call(Name("smallest_change"),
    37	                      Subscript(Name("arr"),
    38	                                Slice(Int(1), UnaryOp("-", Int(1)), NoBound)))))
    39	endmodule
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Exhaustive symbolic proof of the recurrence defining the minimum.  These
     7	  // claims cover every finite list: the length test is true or false, and in
     8	  // the latter case the two endpoints are equal or unequal.
     9	  claim <k>
    10	          run(#smallestChangeBody, L, #smallestChangeBody) ~> KONT
    11	          => finish(0) ~> KONT
    12	        </k>
    13	    requires size(L) <=Int 1
    14	
    15	  claim <k>
    16	          run(#smallestChangeBody, L, #smallestChangeBody) ~> KONT
    17	          => recur(#smallestChangeBody, range(L, 1, 1),
    18	                   #smallestChangeBody) ~> KONT
    19	        </k>
    20	    requires size(L) >Int 1
    21	     andBool {L[0]}:>Int ==Int {L[-1]}:>Int
    22	
    23	  claim <k>
    24	          run(#smallestChangeBody, L, #smallestChangeBody) ~> KONT
    25	          => recur(#smallestChangeBody, range(L, 1, 1),
    26	                   #smallestChangeBody) ~> addResult(1) ~> KONT
    27	        </k>
    28	    requires size(L) >Int 1
    29	     andBool notBool ({L[0]}:>Int ==Int {L[-1]}:>Int)
    30	
    31	  // The independent mathematical specification has the same exhaustive
    32	  // recurrence, establishing the correspondence used by the three program
    33	  // claims above.
    34	  claim <k> minimumPalindromeChanges(L) => 0 </k>
    35	    requires size(L) <=Int 1
    36	
    37	  claim <k>
    38	          minimumPalindromeChanges(L)
    39	          => minimumPalindromeChanges(range(L, 1, 1))
    40	        </k>
    41	    requires size(L) >Int 1
    42	     andBool {L[0]}:>Int ==Int {L[-1]}:>Int
    43	
    44	  claim <k>
    45	          minimumPalindromeChanges(L)
    46	          => 1 +Int minimumPalindromeChanges(range(L, 1, 1))
    47	        </k>
    48	    requires size(L) >Int 1
    49	     andBool notBool ({L[0]}:>Int ==Int {L[-1]}:>Int)
    50	
    51	  // The three examples from prompt.py additionally prove concrete executions
    52	  // of the evaluator.  Full Module/FuncDef linkage is exercised by krun.
    53	  claim <k>
    54	          run(#smallestChangeBody,
    55	               ListItem(1) ListItem(2) ListItem(3) ListItem(5)
    56	               ListItem(4) ListItem(7) ListItem(9) ListItem(6),
    57	               #smallestChangeBody)
    58	          => finish(4)
    59	        </k>
    60	
    61	  claim <k>
    62	          run(#smallestChangeBody,
    63	               ListItem(1) ListItem(2) ListItem(3) ListItem(4)
    64	               ListItem(3) ListItem(2) ListItem(2),
    65	               #smallestChangeBody)
    66	          => finish(1)
    67	        </k>
    68	
    69	  claim <k>
    70	          run(#smallestChangeBody,
    71	               ListItem(1) ListItem(2) ListItem(3)
    72	               ListItem(2) ListItem(1),
    73	               #smallestChangeBody)
    74	          => finish(0)
    75	        </k>
    76	endmodule

