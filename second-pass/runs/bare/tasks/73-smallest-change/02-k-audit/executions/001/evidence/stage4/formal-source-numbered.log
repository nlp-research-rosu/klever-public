     3	module MPY-SYNTAX
     4	  imports INT-SYNTAX
     5	  imports BOOL-SYNTAX
     6	  imports STRING-SYNTAX
     7	  imports LIST
     8	
     9	  // The concrete syntax is deliberately the constructor syntax emitted by
    10	  // py2mpy.py.  Statement and expression lists use the same separators as the
    11	  // transliterator (juxtaposition and comma, respectively).
    12	  syntax Program ::= "Module" "(" Stmts ")" [symbol(Module)]
    13	
    14	  syntax Stmts ::= List{Stmt, ""}
    15	  syntax Exprs ::= List{Expr, ","}
    16	  syntax Strings ::= List{String, ","}
    17	  syntax CmpOps ::= List{CmpOp, ","}
    18	
    19	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol(FuncDef)]
    20	                | "If" "(" Expr "," Stmts "," Stmts ")"       [symbol(If)]
    21	                | "Return" "(" Expr ")"                         [symbol(Return)]
    22	
    23	  syntax Params ::= "Params" "(" Strings ")" [symbol(Params)]
    24	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol(CmpOp)]
    25	
    26	  syntax Expr ::= "Int" "(" Int ")"                              [symbol(IntExpr)]
    27	                | "Name" "(" String ")"                          [symbol(Name)]
    28	                | "Call" "(" Expr "," Exprs ")"                 [symbol(Call)]
    29	                | "Compare" "(" Expr "," CmpOps ")"             [symbol(Compare)]
    30	                | "Subscript" "(" Expr "," Expr ")"             [symbol(Subscript)]
    31	                | "Slice" "(" Expr "," Expr "," Expr ")"       [symbol(Slice)]
    32	                | "UnaryOp" "(" String "," Expr ")"             [symbol(UnaryOp)]
    33	                | "BinOp" "(" String "," Expr "," Expr ")"     [symbol(BinOp)]
    34	                | "NoBound"                                       [symbol(NoBound)]
    35	endmodule
    36	
    37	module SEMANTIC
    38	  imports MPY-SYNTAX
    39	  imports INT
    40	  imports BOOL
    41	  imports LIST
    42	  imports K-EQUAL
    43	
    44	  configuration
    45	    <mpy>
    46	      <k> $PGM:Program </k>
    47	      <input> $INPUT:List </input>
    48	      <result> .K </result>
    49	    </mpy>
    50	
    51	  // Runtime helpers.  A function body is passed as the third argument so a
    52	  // recursive call invokes the actual parsed body, not a built-in replacement.
    53	  // `run` is operational (rather than a function) so symbolic side conditions
    54	  // split proof paths. `addResult` is the return continuation for 1 + recurse.
    55	  syntax KItem ::= run(Stmts, List, Stmts)
    56	                 | recur(Stmts, List, Stmts)
    57	                 | finish(Int)
    58	                 | addResult(Int)
    59	                 | eval(Expr, List, Stmts)  [function]
    60	  syntax Bool ::= truth(Expr, List, Stmts)  [function]
    61	  syntax Stmts ::= concatStmts(Stmts, Stmts) [function]
    62	
    63	  rule concatStmts(.Stmts, S2) => S2
    64	  rule concatStmts((S:Stmt) S1, S2) => S concatStmts(S1, S2)
    65	
    66	  rule <k> Module(FuncDef("smallest_change", Params("arr"), BODY))
    67	             => run(BODY, L, BODY) </k>
    68	       <input> L </input>
    69	
    70	  // Statements.  Returning discards the remaining statements.  An if-body
    71	  // is prepended to the continuation exactly as Python executes it.
    72	  rule <k> run(If(Compare(Call(Name("len"), Name("arr")),
    73	                         CmpOp("<=", Int(1))), THEN, _ELSE) REST, L, BODY)
    74	             => run(concatStmts(THEN, REST), L, BODY) ... </k>
    75	    requires size(L) <=Int 1
    76	  rule <k> run(If(Compare(Call(Name("len"), Name("arr")),
    77	                         CmpOp("<=", Int(1))), _THEN, ELSE) REST, L, BODY)
    78	             => run(concatStmts(ELSE, REST), L, BODY) ... </k>
    79	    requires size(L) >Int 1
    80	  rule <k> run(If(Compare(Subscript(Name("arr"), Int(0)),
    81	                         CmpOp("==", Subscript(Name("arr"),
    82	                                               UnaryOp("-", Int(1))))),
    83	                    THEN, _ELSE) REST, L, BODY)
    84	             => run(concatStmts(THEN, REST), L, BODY) ... </k>
    85	    requires {L[0]}:>Int ==Int {L[-1]}:>Int
    86	  rule <k> run(If(Compare(Subscript(Name("arr"), Int(0)),
    87	                         CmpOp("==", Subscript(Name("arr"),
    88	                                               UnaryOp("-", Int(1))))),
    89	                    _THEN, ELSE) REST, L, BODY)
    90	             => run(concatStmts(ELSE, REST), L, BODY) ... </k>
    91	    requires notBool ({L[0]}:>Int ==Int {L[-1]}:>Int)
    92	
    93	  rule <k> run(Return(Int(I)) _REST, _L, _BODY) => finish(I) ... </k>
    94	  rule <k> run(Return(Call(Name("smallest_change"), ARG)) _REST, L, BODY)
    95	             => recur(BODY, {eval(ARG, L, BODY)}:>List, BODY) ... </k>
    96	  rule <k> run(Return(BinOp("+", Int(I),
    97	                           Call(Name("smallest_change"), ARG))) _REST, L, BODY)
    98	             => recur(BODY, {eval(ARG, L, BODY)}:>List, BODY)
    99	                ~> addResult(I) ... </k>
   100	  // Ground execution continues immediately.  Symbolic proofs stop at recur,
   101	  // which is the induction cutpoint discharged by the recurrence claims.
   102	  rule <k> recur(BODY, L, BODY) => run(BODY, L, BODY) ... </k> [concrete]
   103	  rule <k> finish(I) ~> addResult(N) => finish(N +Int I) ... </k>
   104	  rule <k> finish(I) => .K </k>
   105	       <result> .K => I </result>
   106	
   107	  // Integer and list expressions used by solution.py.
   108	  rule eval(Int(I), _L, _BODY) => I
   109	  rule eval(UnaryOp("-", E), L, BODY)
   110	    => 0 -Int {eval(E, L, BODY)}:>Int
   111	  rule eval(BinOp("+", E1, E2), L, BODY)
   112	    => {eval(E1, L, BODY)}:>Int +Int {eval(E2, L, BODY)}:>Int
   113	  rule eval(Call(Name("len"), Name("arr")), L, _BODY) => size(L)
   114	  rule eval(Subscript(Name("arr"), INDEX), L, BODY)
   115	    => L[{eval(INDEX, L, BODY)}:>Int]
   116	  rule eval(Subscript(Name("arr"), Slice(LOW, HIGH, NoBound)), L, BODY)
   117	    => range(L,
   118	             {eval(LOW, L, BODY)}:>Int,
   119	             0 -Int {eval(HIGH, L, BODY)}:>Int)
   120	  // Comparisons are intentionally interpreted here rather than translated by
   121	  // py2mpy.py.  List elements are constrained to Int by these projections.
   122	  rule truth(Compare(E1, CmpOp("<=", E2)), L, BODY)
   123	    => {eval(E1, L, BODY)}:>Int <=Int {eval(E2, L, BODY)}:>Int
   124	  rule truth(Compare(E1, CmpOp("==", E2)), L, BODY)
   125	    => {eval(E1, L, BODY)}:>Int ==Int {eval(E2, L, BODY)}:>Int
   126	endmodule
