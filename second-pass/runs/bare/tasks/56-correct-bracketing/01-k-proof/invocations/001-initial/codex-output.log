+      .Stmts)
+  rule targetTail() =>
+    Return(Compare(Name("depth"), CmpOp("==", Int(0))))
+
+  // This is exactly the tree in solution.mpy, named so that proof claims stay
+  // readable.  krun still parses and executes solution.mpy itself.
+  rule correctProgram() =>
+    Module(
+      FuncDef("correct_bracketing", Params("brackets"),
+        Assign(Name("depth"), Int(0))
+        For(Name("bracket"), Name("brackets"),
+          targetLoopBody())
+        targetTail()))
+  rule <k> (S:Stmt REST:Stmts) => S ~> REST ... </k>
+  rule <k> .Stmts => .K ... </k>
+
+  rule <k> FuncDef(F, PS, BODY) => .K ... </k>
+       <functions> M => M [ F <- function(PS, BODY) ] </functions>
+
+  rule <k> invoke(F, V) => BODY ~> functionBoundary() ... </k>
+       <functions> ... F |-> function(Params(P, .Strings), BODY) ... </functions>
+       <env> _ => bind(P, V, emptyStore()) </env>
+
+  rule <k> Int(I) => IVal(I) ... </k>
+  rule <k> Bool(B) => BVal(B) ... </k>
+  rule <k> Str(S) => SVal(S) ... </k>
+  rule <k> Name(X) => lookup(X, STORE) ... </k>
+       <env> STORE </env>
+
+  rule <k> Assign(Name(X), E) => E ~> assignName(X) ... </k>
+  rule <k> V:Value ~> assignName(X) => .K ... </k>
+       <env> STORE => bind(X, V, STORE) </env>
+
+  rule <k> BinOp(OP, L, R) => L ~> binopLeft(OP, R) ... </k>
+  rule <k> V:Value ~> binopLeft(OP, R) => R ~> binopRight(OP, V) ... </k>
+  rule <k> IVal(J) ~> binopRight("+", IVal(I)) => IVal(I +Int J) ... </k>
+  rule <k> IVal(J) ~> binopRight("-", IVal(I)) => IVal(I -Int J) ... </k>
+
+  rule <k> Compare(L, C) => L ~> compareLeft(C) ... </k>
+  rule <k> V:Value ~> compareLeft(CmpOp(OP, R))
+        => R ~> compareRight(OP, V) ... </k>
+  rule <k> SVal(R) ~> compareRight("==", SVal(L))
+        => BVal(L ==String R) ... </k>
+  rule <k> IVal(R) ~> compareRight("==", IVal(L))
+        => BVal(L ==Int R) ... </k>
+  rule <k> IVal(R) ~> compareRight("<", IVal(L))
+        => BVal(L <Int R) ... </k>
+
+  rule <k> If(E, THEN, ELSE) => E ~> ifKont(THEN, ELSE) ... </k>
+  rule <k> BVal(true) ~> ifKont(THEN, _) => THEN ... </k>
+  rule <k> BVal(false) ~> ifKont(_, ELSE) => ELSE ... </k>
+
+  rule <k> For(TARGET, ITERABLE, BODY)
+        => ITERABLE ~> forStart(TARGET, BODY) ... </k>
+  rule <k> SVal(S) ~> forStart(Name(X), BODY)
+        => forString(S, X, BODY) ... </k>
+  rule <k> SeqVal(BS) ~> forStart(Name(X), BODY)
+        => forBracketSeq(BS, X, BODY) ... </k>
+  rule <k> forString(S, _, _) => .K ... </k>
+    requires S ==String ""
+  rule <k> forString(S, X, BODY)
+        => BODY ~> forString(substrString(S, 1, lengthString(S)), X, BODY) ... </k>
+       <env> STORE => bind(X, SVal(substrString(S, 0, 1)), STORE) </env>
+    requires S =/=String ""
+  rule <k> forBracketSeq(noBrackets(), _, _) => .K ... </k>
+  rule <k> forBracketSeq(openBracket(BS), X, BODY)
+        => BODY ~> forBracketSeq(BS, X, BODY) ... </k>
+       <env> STORE => bind(X, SVal("<"), STORE) </env>
+  rule <k> forBracketSeq(closeBracket(BS), X, BODY)
+        => BODY ~> forBracketSeq(BS, X, BODY) ... </k>
+       <env> STORE => bind(X, SVal(">"), STORE) </env>
+
+  rule <k> Return(E) => E ~> returnKont() ... </k>
+  rule <k> V:Value ~> returnKont() ~> _REST:K
+        => V ~> finish() </k>
+  rule <k> V:Value ~> finish() => .K </k>
+       <result> _ => result(V) </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..3929de5f31416f1bc26372e31cd545aaff753a61
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def correct_bracketing(brackets: str):
+    depth = 0
+    for bracket in brackets:
+        if bracket == "<":
+            depth = depth + 1
+        else:
+            depth = depth - 1
+        if depth < 0:
+            return False
+    return depth == 0
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b51d40f7d5feb0a15d0a7cca292f0f7121020062
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,72 @@
+requires "semantic.k"
+
+module SPEC
+  imports MPY
+
+  // Loop invariant over BracketSeq, the constructor model of exactly [<>]*.
+  // Splitting zero and positive balances makes nonnegativity structural in the
+  // circular proof instead of asking the SMT solver to synthesize induction.
+  claim [loop-zero]: <py>
+    <k>
+      forBracketSeq(BS, "bracket", targetLoopBody()) ~> targetTail() ~> functionBoundary()
+      => .K
+    </k>
+    <functions> _FM0:Map => ?_FM:Map </functions>
+    <env> bind("depth", IVal(0), _REST0:Store) => ?_FINALENV:Store </env>
+    <result> noResult() => result(BVal(bracketSeqSpec(BS, 0))) </result>
+  </py>
+
+  claim [loop-positive]: <py>
+    <k>
+      forBracketSeq(BS, "bracket", targetLoopBody()) ~> targetTail() ~> functionBoundary()
+      => .K
+    </k>
+    <functions> _FMP:Map => ?_FM:Map </functions>
+    <env> bind("depth", IVal(D), _RESTP:Store) => ?_FINALENV:Store </env>
+    <result>
+      noResult() => result(BVal(bracketSeqSpec(BS, D)))
+    </result>
+  </py>
+    requires D >Int 0
+
+  // The translated entry point establishes the invariant with D = 0.  Since
+  // BracketSeq has only open/close constructors, this quantifies over every
+  // input admitted by the prompt's precondition.
+  claim [universal-correctness]: <py>
+    <k>
+      correctProgram() ~> invoke("correct_bracketing", SeqVal(BS))
+      => .K
+    </k>
+    <functions> .Map => ?_UFM:Map </functions>
+    <env> emptyStore() => ?_UENV:Store </env>
+    <result> noResult() => result(BVal(bracketSeqSpec(BS, 0))) </result>
+  </py>
+
+  claim <py>
+    <k> correctProgram() ~> invoke("correct_bracketing", SVal("<")) => .K </k>
+    <functions> .Map => ?_FM1:Map </functions>
+    <env> emptyStore() => ?_ENV1:Store </env>
+    <result> noResult() => result(BVal(false)) </result>
+  </py>
+
+  claim <py>
+    <k> correctProgram() ~> invoke("correct_bracketing", SVal("<>")) => .K </k>
+    <functions> .Map => ?_FM2:Map </functions>
+    <env> emptyStore() => ?_ENV2:Store </env>
+    <result> noResult() => result(BVal(true)) </result>
+  </py>
+
+  claim <py>
+    <k> correctProgram() ~> invoke("correct_bracketing", SVal("<<><>>")) => .K </k>
+    <functions> .Map => ?_FM3:Map </functions>
+    <env> emptyStore() => ?_ENV3:Store </env>
+    <result> noResult() => result(BVal(true)) </result>
+  </py>
+
+  claim <py>
+    <k> correctProgram() ~> invoke("correct_bracketing", SVal("><<>")) => .K </k>
+    <functions> .Map => ?_FM4:Map </functions>
+    <env> emptyStore() => ?_ENV4:Store </env>
+    <result> noResult() => result(BVal(false)) </result>
+  </py>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..026fd1c0ebd2c560bf8242d163ebe976f2c1cecc
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,37 @@
+module VERIFICATION
+  imports INT
+  imports BOOL
+  imports STRING
+
+  // The mathematical reference checker carries the current unmatched-open
+  // count.  It returns false on the first negative prefix and otherwise tests
+  // for a zero count at end of input.
+  syntax Bool ::= bracketSpec(String, Int) [function, total]
+                | bracketEmpty(Bool, String, Int) [function, total]
+                | bracketOpen(Bool, String, Int) [function, total]
+                | bracketNegative(Bool, String, Int) [function, total]
+
+  rule bracketSpec(S, D) => bracketEmpty(S ==String "", S, D)
+  rule bracketEmpty(true, _, D) => D ==Int 0
+  rule bracketEmpty(false, S, D)
+    => bracketOpen(substrString(S, 0, 1) ==String "<", S, D)
+  rule bracketOpen(true, S, D)
+    => bracketSpec(substrString(S, 1, lengthString(S)), D +Int 1)
+  rule bracketOpen(false, S, D)
+    => bracketNegative(D -Int 1 <Int 0, S, D)
+  rule bracketNegative(true, _, _) => false
+  rule bracketNegative(false, S, D)
+    => bracketSpec(substrString(S, 1, lengthString(S)), D -Int 1)
+
+  // Constructor model of exactly the input language promised by the task.
+  // It has no constructor for any character other than '<' and '>'.
+  syntax BracketSeq ::= noBrackets() | openBracket(BracketSeq) | closeBracket(BracketSeq)
+  syntax Bool ::= bracketSeqSpec(BracketSeq, Int) [function, total]
+
+  rule bracketSeqSpec(noBrackets(), D) => D ==Int 0
+  rule bracketSeqSpec(openBracket(BS), D) => bracketSeqSpec(BS, D +Int 1)
+  rule bracketSeqSpec(closeBracket(_), D) => false
+    requires D -Int 1 <Int 0
+  rule bracketSeqSpec(closeBracket(BS), D) => bracketSeqSpec(BS, D -Int 1)
+    requires D -Int 1 >=Int 0
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..9eef5863c20b95b1b5ca6e0b4e61663de29dfe59
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,44 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+# Recheck that the committed constructor tree is exactly the translator output.
+generated_mpy="$(mktemp ./solution-regenerated.XXXXXX.mpy)"
+trap 'rm -f "$generated_mpy"' EXIT
+python3 py2mpy.py solution.py > "$generated_mpy"
+cmp solution.mpy "$generated_mpy"
+
+# Compile the executable definition and exercise normal completion, empty
+# input, nested input, and early rejection through the real solution.mpy term.
+kompile semantic.k \
+  --backend llvm \
+  --main-module MPY \
+  --syntax-module MPY-SYNTAX \
+  --output-definition llvm-kompiled
+
+run_case() {
+  local input="$1"
+  local expected="$2"
+  local output
+  output="$(krun solution.mpy --definition llvm-kompiled -cINPUT="$input")"
+  grep -Fq "result ( BVal ( $expected ) )" <<< "$output"
+}
+
+run_case '""' true
+run_case '"<"' false
+run_case '"<>"' true
+run_case '"<<><>>"' true
+run_case '"><<>"' false
+
+# Compile the symbolic definition and prove every claim in spec.k.  Success is
+# reported by kprove as #Top and a zero exit status.
+kompile semantic.k \
+  --backend haskell \
+  --main-module MPY \
+  --syntax-module MPY-SYNTAX \
+  --output-definition haskell-kompiled
+
+kprove spec.k \
+  --definition haskell-kompiled \
+  --spec-module SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..ff70572c0d81a8137c2b53f17bdc826dbe917bc2
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,159 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+               | correctProgram()
+
+  syntax Stmts ::= List{Stmt, ""}
+                   | targetLoopBody() [function, total]
+                   | targetTail() [function, total]
+  syntax Strings ::= List{String, ","}
+
+  syntax Params ::= "Params" "(" Strings ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Str" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports MAP
+  imports INT
+  imports BOOL
+  imports STRING
+  imports VERIFICATION
+
+  syntax Value ::= IVal(Int) | BVal(Bool) | SVal(String) | SeqVal(BracketSeq)
+  syntax Function ::= function(Params, Stmts)
+  syntax Store ::= emptyStore() | bind(String, Value, Store)
+  syntax Value ::= lookup(String, Store) [function]
+
+  rule lookup(X, bind(X, V, _)) => V
+  rule lookup(X, bind(Y, _, REST)) => lookup(X, REST)
+    requires X =/=String Y
+
+  syntax KItem ::= invoke(String, Value)
+                 | functionBoundary()
+                 | assignName(String)
+                 | binopLeft(String, Expr)
+                 | binopRight(String, Value)
+                 | compareLeft(CmpOp)
+                 | compareRight(String, Value)
+                 | ifKont(Stmts, Stmts)
+                 | forStart(Expr, Stmts)
+                 | forString(String, String, Stmts)
+                 | forBracketSeq(BracketSeq, String, Stmts)
+                 | returnKont()
+                 | finish()
+
+  configuration
+    <py>
+      <k> $PGM:Pgm ~> invoke("correct_bracketing", SVal($INPUT:String)) </k>
+      <functions> .Map </functions>
+      <env> emptyStore() </env>
+      <result> noResult() </result>
+    </py>
+
+  syntax Result ::= noResult() | result(Value)
+
+  rule <k> Module(SS) => SS ... </k>
+  rule targetLoopBody() =>
+    If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+      Assign(Name("depth"), BinOp("+", Name("depth"), Int(1))),
+      Assign(Name("depth"), BinOp("-", Name("depth"), Int(1))))
+    If(Compare(Name("depth"), CmpOp("<", Int(0))),
+      Return(Bool(false)),
+      .Stmts)
+  rule targetTail() =>
+    Return(Compare(Name("depth"), CmpOp("==", Int(0))))
+
+  // This is exactly the tree in solution.mpy, named so that proof claims stay
+  // readable.  krun still parses and executes solution.mpy itself.
+  rule correctProgram() =>
+    Module(
+      FuncDef("correct_bracketing", Params("brackets"),
+        Assign(Name("depth"), Int(0))
+        For(Name("bracket"), Name("brackets"),
+          targetLoopBody())
+        targetTail()))
+  rule <k> (S:Stmt REST:Stmts) => S ~> REST ... </k>
+  rule <k> .Stmts => .K ... </k>
+
+  rule <k> FuncDef(F, PS, BODY) => .K ... </k>
+       <functions> M => M [ F <- function(PS, BODY) ] </functions>
+
+  rule <k> invoke(F, V) => BODY ~> functionBoundary() ... </k>
+       <functions> ... F |-> function(Params(P, .Strings), BODY) ... </functions>
+       <env> _ => bind(P, V, emptyStore()) </env>
+
+  rule <k> Int(I) => IVal(I) ... </k>
+  rule <k> Bool(B) => BVal(B) ... </k>
+  rule <k> Str(S) => SVal(S) ... </k>
+  rule <k> Name(X) => lookup(X, STORE) ... </k>
+       <env> STORE </env>
+
+  rule <k> Assign(Name(X), E) => E ~> assignName(X) ... </k>
+  rule <k> V:Value ~> assignName(X) => .K ... </k>
+       <env> STORE => bind(X, V, STORE) </env>
+
+  rule <k> BinOp(OP, L, R) => L ~> binopLeft(OP, R) ... </k>
+  rule <k> V:Value ~> binopLeft(OP, R) => R ~> binopRight(OP, V) ... </k>
+  rule <k> IVal(J) ~> binopRight("+", IVal(I)) => IVal(I +Int J) ... </k>
+  rule <k> IVal(J) ~> binopRight("-", IVal(I)) => IVal(I -Int J) ... </k>
+
+  rule <k> Compare(L, C) => L ~> compareLeft(C) ... </k>
+  rule <k> V:Value ~> compareLeft(CmpOp(OP, R))
+        => R ~> compareRight(OP, V) ... </k>
+  rule <k> SVal(R) ~> compareRight("==", SVal(L))
+        => BVal(L ==String R) ... </k>
+  rule <k> IVal(R) ~> compareRight("==", IVal(L))
+        => BVal(L ==Int R) ... </k>
+  rule <k> IVal(R) ~> compareRight("<", IVal(L))
+        => BVal(L <Int R) ... </k>
+
+  rule <k> If(E, THEN, ELSE) => E ~> ifKont(THEN, ELSE) ... </k>
+  rule <k> BVal(true) ~> ifKont(THEN, _) => THEN ... </k>
+  rule <k> BVal(false) ~> ifKont(_, ELSE) => ELSE ... </k>
+
+  rule <k> For(TARGET, ITERABLE, BODY)
+        => ITERABLE ~> forStart(TARGET, BODY) ... </k>
+  rule <k> SVal(S) ~> forStart(Name(X), BODY)
+        => forString(S, X, BODY) ... </k>
+  rule <k> SeqVal(BS) ~> forStart(Name(X), BODY)
+        => forBracketSeq(BS, X, BODY) ... </k>
+  rule <k> forString(S, _, _) => .K ... </k>
+    requires S ==String ""
+  rule <k> forString(S, X, BODY)
+        => BODY ~> forString(substrString(S, 1, lengthString(S)), X, BODY) ... </k>
+       <env> STORE => bind(X, SVal(substrString(S, 0, 1)), STORE) </env>
+    requires S =/=String ""
+  rule <k> forBracketSeq(noBrackets(), _, _) => .K ... </k>
+  rule <k> forBracketSeq(openBracket(BS), X, BODY)
+        => BODY ~> forBracketSeq(BS, X, BODY) ... </k>
+       <env> STORE => bind(X, SVal("<"), STORE) </env>
+  rule <k> forBracketSeq(closeBracket(BS), X, BODY)
+        => BODY ~> forBracketSeq(BS, X, BODY) ... </k>
+       <env> STORE => bind(X, SVal(">"), STORE) </env>
+
+  rule <k> Return(E) => E ~> returnKont() ... </k>
+  rule <k> V:Value ~> returnKont() ~> _REST:K
+        => V ~> finish() </k>
+  rule <k> V:Value ~> finish() => .K </k>
+       <result> _ => result(V) </result>
+endmodule
