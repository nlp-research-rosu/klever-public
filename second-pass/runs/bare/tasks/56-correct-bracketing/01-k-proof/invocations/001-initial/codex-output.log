    Assign(Name("depth"), Int(0))
    For(Name("bracket"), Name("brackets"),
      If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
        Assign(Name("depth"), BinOp("+", Name("depth"), Int(1))),
        Assign(Name("depth"), BinOp("-", Name("depth"), Int(1))))
      If(Compare(Name("depth"), CmpOp("<", Int(0))),
        Return(Bool(false)),
        ))
    Return(Compare(Name("depth"), CmpOp("==", Int(0))))))
'<' False
'<>' True
'<<><>>' True
'><<>' False
'' True
'<<>>' True
'<><>' True
'<<>' False

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..3929de5f31416f1bc26372e31cd545aaff753a61
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def correct_bracketing(brackets: str):
+    depth = 0
+    for bracket in brackets:
+        if bracket == "<":
+            depth = depth + 1
+        else:
+            depth = depth - 1
+        if depth < 0:
+            return False
+    return depth == 0

