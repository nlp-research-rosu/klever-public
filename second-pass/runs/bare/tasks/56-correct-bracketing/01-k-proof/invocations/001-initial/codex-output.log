--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def correct_bracketing(brackets: str):
+    depth = 0
+    for bracket in brackets:
+        if bracket == "<":
+            depth = depth + 1
+        else:
+            depth = depth - 1
+        if depth < 0:
+            return False
+    return depth == 0
