+        => BVal(L ==String R) ... </k>
+  rule <k> IVal(R) ~> compareRight("==", IVal(L))
+        => BVal(L ==Int R) ... </k>
+  rule <k> IVal(R) ~> compareRight("<", IVal(L))
+        => BVal(L <Int R) ... </k>
