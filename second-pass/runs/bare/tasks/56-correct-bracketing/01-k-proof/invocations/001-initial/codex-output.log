@@ -0,0 +1,24 @@
+module VERIFICATION
+  imports INT
+  imports BOOL
+  imports STRING
+
+  // The mathematical reference checker carries the current unmatched-open
+  // count.  It returns false on the first negative prefix and otherwise tests
+  // for a zero count at end of input.
+  syntax Bool ::= bracketSpec(String, Int) [function, total]
+
+  rule bracketSpec(S, D) =>
+    #if S ==String ""
+    #then D ==Int 0
+    #else
+      #if substrString(S, 0, 1) ==String "<"
+      #then bracketSpec(substrString(S, 1, lengthString(S)), D +Int 1)
+      #else
+        #if D -Int 1 <Int 0
+        #then false
+        #else bracketSpec(substrString(S, 1, lengthString(S)), D -Int 1)
+        #fi
+      #fi
+    #fi
+endmodule

exec
