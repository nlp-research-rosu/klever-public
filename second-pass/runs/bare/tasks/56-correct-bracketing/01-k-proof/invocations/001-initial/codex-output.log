diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..33565e019a3c36c1f715dd3ad0266049349dd0d7
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,49 @@
+requires "semantic.k"
+
+module SPEC
+  imports MPY
+
+  claim
+    <k> correctProgram() ~> invoke("correct_bracketing", SVal("<")) </k>
+    <functions> .Map </functions>
+    <env> .Map </env>
+    <result> noResult() </result>
+  =>
+    <k> .K </k>
+    <functions> _ </functions>
+    <env> _ </env>
+    <result> result(BVal(false)) </result>
+
+  claim
+    <k> correctProgram() ~> invoke("correct_bracketing", SVal("<>")) </k>
+    <functions> .Map </functions>
+    <env> .Map </env>
+    <result> noResult() </result>
+  =>
+    <k> .K </k>
+    <functions> _ </functions>
+    <env> _ </env>
+    <result> result(BVal(true)) </result>
+
+  claim
+    <k> correctProgram() ~> invoke("correct_bracketing", SVal("<<><>>")) </k>
+    <functions> .Map </functions>
+    <env> .Map </env>
+    <result> noResult() </result>
+  =>
+    <k> .K </k>
+    <functions> _ </functions>
+    <env> _ </env>
+    <result> result(BVal(true)) </result>
+
+  claim
+    <k> correctProgram() ~> invoke("correct_bracketing", SVal("><<>")) </k>
+    <functions> .Map </functions>
+    <env> .Map </env>
+    <result> noResult() </result>
+  =>
+    <k> .K </k>
+    <functions> _ </functions>
+    <env> _ </env>
+    <result> result(BVal(false)) </result>
+endmodule
