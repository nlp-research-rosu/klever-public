diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..5b7aae2d0cc1c58235dbbd0f1a94445d2059fe8b
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,149 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+               | correctProgram()
+
+  syntax Stmts ::= List{Stmt, ""}
+                   | targetLoopBody() [function, total]
+                   | targetTail() [function, total]
+  syntax Strings ::= List{String, ","}
+
+  syntax Params ::= "Params" "(" Strings ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Str" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports MAP
+  imports INT
+  imports BOOL
+  imports STRING
+  imports VERIFICATION
+
+  syntax Value ::= IVal(Int) | BVal(Bool) | SVal(String)
+  syntax Function ::= function(Params, Stmts)
+  syntax Store ::= emptyStore() | bind(String, Value, Store)
+  syntax Value ::= lookup(String, Store) [function]
+
+  rule lookup(X, bind(X, V, _)) => V
+  rule lookup(X, bind(Y, _, REST)) => lookup(X, REST)
+    requires X =/=String Y
+
+  syntax KItem ::= invoke(String, Value)
+                 | functionBoundary()
+                 | assignName(String)
+                 | binopLeft(String, Expr)
+                 | binopRight(String, Value)
+                 | compareLeft(CmpOp)
+                 | compareRight(String, Value)
+                 | ifKont(Stmts, Stmts)
+                 | forStart(Expr, Stmts)
+                 | forString(String, String, Stmts)
+                 | returnKont()
+                 | finish()
+
+  configuration
+    <py>
+      <k> $PGM:Pgm ~> invoke("correct_bracketing", SVal($INPUT:String)) </k>
+      <functions> .Map </functions>
+      <env> emptyStore() </env>
+      <result> noResult() </result>
+    </py>
+
+  syntax Result ::= noResult() | result(Value)
+
+  rule <k> Module(SS) => SS ... </k>
+  rule targetLoopBody() =>
+    If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+      Assign(Name("depth"), BinOp("+", Name("depth"), Int(1))),
+      Assign(Name("depth"), BinOp("-", Name("depth"), Int(1))))
+    If(Compare(Name("depth"), CmpOp("<", Int(0))),
+      Return(Bool(false)),
+      .Stmts)
+  rule targetTail() =>
+    Return(Compare(Name("depth"), CmpOp("==", Int(0))))
+
+  // This is exactly the tree in solution.mpy, named so that proof claims stay
+  // readable.  krun still parses and executes solution.mpy itself.
+  rule correctProgram() =>
+    Module(
+      FuncDef("correct_bracketing", Params("brackets"),
+        Assign(Name("depth"), Int(0))
+        For(Name("bracket"), Name("brackets"),
+          targetLoopBody())
+        targetTail()))
+  rule <k> (S:Stmt REST:Stmts) => S ~> REST ... </k>
+  rule <k> .Stmts => . ... </k>
+
+  rule <k> FuncDef(F, PS, BODY) => . ... </k>
+       <functions> M => M [ F <- function(PS, BODY) ] </functions>
+
+  rule <k> invoke(F, V) => BODY ~> functionBoundary() ... </k>
+       <functions> ... F |-> function(Params(P, .Strings), BODY) ... </functions>
+       <env> _ => bind(P, V, emptyStore()) </env>
+
+  rule <k> Int(I) => IVal(I) ... </k>
+  rule <k> Bool(B) => BVal(B) ... </k>
+  rule <k> Str(S) => SVal(S) ... </k>
+  rule <k> Name(X) => lookup(X, STORE) ... </k>
+       <env> STORE </env>
+
+  rule <k> Assign(Name(X), E) => E ~> assignName(X) ... </k>
+  rule <k> V:Value ~> assignName(X) => . ... </k>
+       <env> STORE => bind(X, V, STORE) </env>
+
+  rule <k> BinOp(OP, L, R) => L ~> binopLeft(OP, R) ... </k>
+  rule <k> V:Value ~> binopLeft(OP, R) => R ~> binopRight(OP, V) ... </k>
+  rule <k> IVal(J) ~> binopRight("+", IVal(I)) => IVal(I +Int J) ... </k>
+  rule <k> IVal(J) ~> binopRight("-", IVal(I)) => IVal(I -Int J) ... </k>
+
+  rule <k> Compare(L, C) => L ~> compareLeft(C) ... </k>
+  rule <k> V:Value ~> compareLeft(CmpOp(OP, R))
+        => R ~> compareRight(OP, V) ... </k>
+  rule <k> SVal(R) ~> compareRight("==", SVal(L))
+        => BVal(L ==String R) ... </k>
+  rule <k> IVal(R) ~> compareRight("==", IVal(L))
+        => BVal(L ==Int R) ... </k>
+  rule <k> IVal(R) ~> compareRight("<", IVal(L))
+        => BVal(L <Int R) ... </k>
+
+  rule <k> If(E, THEN, ELSE) => E ~> ifKont(THEN, ELSE) ... </k>
+  rule <k> BVal(true) ~> ifKont(THEN, _) => THEN ... </k>
+  rule <k> BVal(false) ~> ifKont(_, ELSE) => ELSE ... </k>
+
+  rule <k> For(TARGET, ITERABLE, BODY)
+        => ITERABLE ~> forStart(TARGET, BODY) ... </k>
+  rule <k> SVal(S) ~> forStart(Name(X), BODY)
+        => forString(S, X, BODY) ... </k>
+  rule <k> forString(S, _, _) => . ... </k>
+    requires S ==String ""
+  rule <k> forString(S, X, BODY)
+        => BODY ~> forString(substrString(S, 1, lengthString(S)), X, BODY) ... </k>
+       <env> STORE => bind(X, SVal(substrString(S, 0, 1)), STORE) </env>
+    requires S =/=String ""
+
+  rule <k> Return(E) => E ~> returnKont() ... </k>
+  rule <k> V:Value ~> returnKont() ~> _REST:K
+        => V ~> finish() </k>
+  rule <k> V:Value ~> finish() => .K </k>
+       <result> _ => result(V) </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..3929de5f31416f1bc26372e31cd545aaff753a61
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def correct_bracketing(brackets: str):
+    depth = 0
+    for bracket in brackets:
+        if bracket == "<":
+            depth = depth + 1
+        else:
+            depth = depth - 1
+        if depth < 0:
+            return False
+    return depth == 0
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..cba376fc1584cb4fd973a675c2ecfe92772aed51
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,57 @@
+requires "semantic.k"
+
+module SPEC
+  imports MPY
+
+  // Loop invariant and functional-correctness lemma.  S is the unprocessed
+  // suffix and D is the unmatched-open count accumulated from its prefix.
+  claim [loop-correctness]: <py>
+    <k>
+      forString(S, "bracket", targetLoopBody()) ~> targetTail() ~> functionBoundary()
+      => .K
+    </k>
+    <functions> FM:Map => ?_FM:Map </functions>
+    <env> bind("depth", IVal(D), REST:Store) => ?_FINALENV:Store </env>
+    <result> noResult() => result(BVal(bracketSpec(S, D))) </result>
+  </py>
+    requires D >=Int 0
+
+  // The translated entry point establishes the invariant with D = 0.
+  claim [universal-correctness]: <py>
+    <k>
+      correctProgram() ~> invoke("correct_bracketing", SVal(S))
+      => .K
+    </k>
+    <functions> .Map => ?_UFM:Map </functions>
+    <env> emptyStore() => ?_UENV:Store </env>
+    <result> noResult() => result(BVal(bracketSpec(S, 0))) </result>
+  </py>
+
+  claim <py>
+    <k> correctProgram() ~> invoke("correct_bracketing", SVal("<")) => .K </k>
+    <functions> .Map => ?_FM1:Map </functions>
+    <env> emptyStore() => ?_ENV1:Store </env>
+    <result> noResult() => result(BVal(false)) </result>
+  </py>
+
+  claim <py>
+    <k> correctProgram() ~> invoke("correct_bracketing", SVal("<>")) => .K </k>
+    <functions> .Map => ?_FM2:Map </functions>
+    <env> emptyStore() => ?_ENV2:Store </env>
+    <result> noResult() => result(BVal(true)) </result>
+  </py>
+
+  claim <py>
+    <k> correctProgram() ~> invoke("correct_bracketing", SVal("<<><>>")) => .K </k>
+    <functions> .Map => ?_FM3:Map </functions>
+    <env> emptyStore() => ?_ENV3:Store </env>
+    <result> noResult() => result(BVal(true)) </result>
+  </py>
+
+  claim <py>
+    <k> correctProgram() ~> invoke("correct_bracketing", SVal("><<>")) => .K </k>
+    <functions> .Map => ?_FM4:Map </functions>
+    <env> emptyStore() => ?_ENV4:Store </env>
+    <result> noResult() => result(BVal(false)) </result>
+  </py>
+endmodule
