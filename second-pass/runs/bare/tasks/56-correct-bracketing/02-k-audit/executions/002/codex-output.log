     6	  // The mathematical reference checker carries the current unmatched-open
     7	  // count.  It returns false on the first negative prefix and otherwise tests
     8	  // for a zero count at end of input.
     9	  syntax Bool ::= bracketSpec(String, Int) [function, total]
