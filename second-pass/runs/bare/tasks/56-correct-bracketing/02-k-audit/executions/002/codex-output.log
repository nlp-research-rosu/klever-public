+if (( build_exit != 0 )); then
+  exit 1
+fi
+
+printf 'COMMAND: kprove spec.k --definition body-haskell-kompiled --spec-module SPEC\n'
+kprove spec.k \
+  --definition body-haskell-kompiled \
+  --spec-module SPEC
