+
+python3 /audit-output/evidence/differential_test.py
+differential_exit=$?
+printf 'differential test exit=%s\n' "$differential_exit"
+
+if (( translator_exit != 0 || cmp_exit != 0 || differential_exit != 0 )); then
+  exit 1
+fi
