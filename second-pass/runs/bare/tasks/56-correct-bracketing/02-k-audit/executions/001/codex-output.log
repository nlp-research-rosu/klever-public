diff --git a//tmp/audit-work/reconstruction/pinning-mutant.py b//tmp/audit-work/reconstruction/pinning-mutant.py
new file mode 100644
index 0000000000000000000000000000000000000000..788662a38f6a9ae2ec8dad34edac55150d1c0d1a
--- /dev/null
+++ b//tmp/audit-work/reconstruction/pinning-mutant.py
@@ -0,0 +1,10 @@
+def correct_bracketing(brackets: str):
+    depth = 0
+    for bracket in brackets:
+        if bracket == "<":
+            depth = depth + 1
+        else:
+            depth = depth - 1
+        if depth < 0:
+            return False
+    return depth == 1
