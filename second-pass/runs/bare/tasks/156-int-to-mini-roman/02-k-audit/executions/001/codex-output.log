diff --git a/evidence/spec-body-mutation.k b/evidence/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..381e968ed7a4cd15199b1a7ccba6e6694878ae2a
--- /dev/null
+++ b/evidence/spec-body-mutation.k
@@ -0,0 +1,11 @@
+module BODY-SENSITIVITY-SPEC
+  imports BODY-SENSITIVITY
+
+  // Input 9 satisfies the real entry precondition. The mutated executable term
+  // returns "wrong", while the unmutated result obligation remains "ix".
+  claim [body-sensitivity-nine]:
+    <k> bodyMutatedProgram => .K </k>
+    <input> 9 </input>
+    <env> .Map => ?_FINAL_ENV:Map </env>
+    <result> noResult => result(vStr(miniRoman(9))) </result>
+endmodule
diff --git a/evidence/spec-false-result.k b/evidence/spec-false-result.k
new file mode 100644
index 0000000000000000000000000000000000000000..5294c418232ebb034d5e22ef15b7aef931ec248a
--- /dev/null
+++ b/evidence/spec-false-result.k
@@ -0,0 +1,14 @@
+module ROMAN-SPEC-FALSE-RESULT
+  imports ROMAN-VERIFICATION
+
+  // Reviewer-authored false mutation: for every satisfying input the demanded
+  // value has one additional exclamation mark.
+  claim [false-result-mutation]:
+    <k> romanProgram => .K </k>
+    <input> N:Int </input>
+    <env> .Map => ?_FINAL_ENV:Map </env>
+    <result>
+      noResult => result(vStr(miniRoman(N) +String "!"))
+    </result>
+    requires (1 <=Int N) andBool (N <=Int 1000)
+endmodule
diff --git a/evidence/verification-body-mutation.k b/evidence/verification-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..b5d7eac1dba183182bacfa7aeb0a3a2ff3c7e6ef
--- /dev/null
+++ b/evidence/verification-body-mutation.k
@@ -0,0 +1,45 @@
+requires "verification.k"
+
+module BODY-SENSITIVITY
+  imports ROMAN-VERIFICATION
+
+  // This is the actual program constructor term with the number-nine entry in
+  // the ones table materially changed from "ix" to "wrong".
+  syntax Pgm ::= "bodyMutatedProgram" [macro]
+  rule bodyMutatedProgram =>
+    Module(
+      FuncDef("int_to_mini_roman", Params("number"),
+        Assign(Name("thousands"), TupleExpr(Str(""), Str("m")))
+        Assign(Name("hundreds"),
+          TupleExpr(
+            Str(""), Str("c"), Str("cc"), Str("ccc"), Str("cd"),
+            Str("d"), Str("dc"), Str("dcc"), Str("dccc"), Str("cm")))
+        Assign(Name("tens"),
+          TupleExpr(
+            Str(""), Str("x"), Str("xx"), Str("xxx"), Str("xl"),
+            Str("l"), Str("lx"), Str("lxx"), Str("lxxx"), Str("xc")))
+        Assign(Name("ones"),
+          TupleExpr(
+            Str(""), Str("i"), Str("ii"), Str("iii"), Str("iv"),
+            Str("v"), Str("vi"), Str("vii"), Str("viii"), Str("wrong")))
+        Return(
+          BinOp("+",
+            BinOp("+",
+              BinOp("+",
+                Subscript(
+                  Name("thousands"),
+                  BinOp("//", Name("number"), Int(1000))),
+                Subscript(
+                  Name("hundreds"),
+                  BinOp("//",
+                    BinOp("%", Name("number"), Int(1000)),
+                    Int(100)))),
+              Subscript(
+                Name("tens"),
+                BinOp("//",
+                  BinOp("%", Name("number"), Int(100)),
+                  Int(10)))),
+            Subscript(
+              Name("ones"),
+              BinOp("%", Name("number"), Int(10)))))))
+endmodule

