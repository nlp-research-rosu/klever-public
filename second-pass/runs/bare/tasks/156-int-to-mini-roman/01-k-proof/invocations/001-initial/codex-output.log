+        "l" , "lx" , "lxx" , "lxxx" , "xc" , .Strings,
+        (N modInt 100) /Int 10))
+     +String
+     tupleAt(
+       "" , "i" , "ii" , "iii" , "iv" ,
+       "v" , "vi" , "vii" , "viii" , "ix" , .Strings,
+       N modInt 10))
+endmodule

