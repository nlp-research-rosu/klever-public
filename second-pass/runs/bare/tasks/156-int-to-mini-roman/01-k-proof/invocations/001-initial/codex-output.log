+        "l" , "lx" , "lxx" , "lxxx" , "xc" , .Strings,
+        (N modInt 100) /Int 10))
+     +String
+     tupleAt(
+       "" , "i" , "ii" , "iii" , "iv" ,
+       "v" , "vi" , "vii" , "viii" , "ix" , .Strings,
+       N modInt 10))
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..e93eef74b5f5f4cfeefcba94880c590d2b3df8ef
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Regenerate the submitted constructor term with the required fixed translator.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Compile the semantics together with the verification-only oracle and program
+# macro.  The Haskell backend is used by both krun and kprove below.
+kompile verification.k \
+  --backend haskell \
+  --main-module ROMAN-VERIFICATION \
+  --syntax-module MINI-PYTHON-SYNTAX
+
+# Prove that the ground program macro in verification.k is exactly the AST
+# generated from solution.py (after macro expansion).
+diff -u \
+  <(kast solution.mpy \
+      --definition verification-kompiled \
+      --module ROMAN-VERIFICATION \
+      --sort Pgm \
+      --output kast) \
+  <(kast \
+      --expression romanProgram \
+      --definition verification-kompiled \
+      --module ROMAN-VERIFICATION \
+      --sort Pgm \
+      --expand-macros \
+      --output kast)
+
+# Exercise both contract boundaries and all three examples from prompt.py.
+krun solution.mpy --definition verification-kompiled -cINPUT=1 \
+  | grep -F 'result ( vStr ( "i" ) )'
+krun solution.mpy --definition verification-kompiled -cINPUT=19 \
+  | grep -F 'result ( vStr ( "xix" ) )'
+krun solution.mpy --definition verification-kompiled -cINPUT=152 \
+  | grep -F 'result ( vStr ( "clii" ) )'
+krun solution.mpy --definition verification-kompiled -cINPUT=426 \
+  | grep -F 'result ( vStr ( "cdxxvi" ) )'
+krun solution.mpy --definition verification-kompiled -cINPUT=1000 \
+  | grep -F 'result ( vStr ( "m" ) )'
+
+# Prove every claim in spec.k.  The sole claim is symbolic over 1 <= N <= 1000.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module ROMAN-SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..914ed043e23f95a0d0389769b0ccf0dab83c8327
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,114 @@
+module MINI-PYTHON-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Exprs ::= List{Expr, ","}
+  syntax Strings ::= List{String, ","}
+
+  syntax Params ::= "Params" "(" Strings ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Str" "(" String ")"
+                | "TupleExpr" "(" Exprs ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Subscript" "(" Expr "," Expr ")"
+endmodule
+
+module MINI-PYTHON
+  imports MINI-PYTHON-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports BASIC-K
+
+  syntax Value ::= vInt(Int)
+                 | vStr(String)
+                 | vTuple(Strings)
+  syntax KResult ::= Value
+
+  syntax Result ::= "noResult" | result(Value)
+
+  configuration
+    <mini-python>
+      <k> $PGM:Pgm </k>
+      <input> $INPUT:Int </input>
+      <env> .Map </env>
+      <result> noResult </result>
+    </mini-python>
+
+  syntax KItem ::= exec(Stmts)
+                 | stmt(Stmt)
+                 | eval(Expr)
+                 | assignTo(String)
+                 | binLeft(String, Expr)
+                 | binRight(String, Value)
+                 | subscriptIndex(Expr)
+                 | subscriptApply(Value)
+                 | "returning"
+
+  syntax Strings ::= tupleStrings(Exprs) [function]
+  rule tupleStrings(.Exprs) => .Strings
+  rule tupleStrings(Str(S) , ES) => S , tupleStrings(ES)
+
+  syntax String ::= tupleAt(Strings, Int) [function]
+  rule tupleAt(S:String , _REST:Strings, I) => S
+    requires I ==Int 0
+    [simplification, concrete(I)]
+  rule tupleAt(_S:String , REST:Strings, I) => tupleAt(REST, I -Int 1)
+    requires I >Int 0
+    [simplification, concrete(I)]
+
+  rule <k> Module(FuncDef(_F, Params(P:String), BODY)) => exec(BODY) </k>
+       <input> I </input>
+       <env> .Map => P |-> vInt(I) </env>
+
+  rule <k> exec(.Stmts) => .K ... </k>
+  rule <k> exec(S SS) => stmt(S) ~> exec(SS) ... </k>
+
+  rule <k> stmt(Assign(Name(X), E)) => eval(E) ~> assignTo(X) ... </k>
+  rule <k> V:Value ~> assignTo(X) => .K ... </k>
+       <env> ENV => ENV [ X <- V ] </env>
+
+  rule <k> stmt(Return(E)) ~> _REST => eval(E) ~> returning </k>
+  rule <k> V:Value ~> returning => .K </k>
+       <result> noResult => result(V) </result>
+
+  rule <k> eval(Int(I)) => vInt(I) ... </k>
+  rule <k> eval(Str(S)) => vStr(S) ... </k>
+  rule <k> eval(TupleExpr(ES)) => vTuple(tupleStrings(ES)) ... </k>
+  rule <k> eval(Name(X)) => ENV[X] ... </k>
+       <env> ENV </env>
+    requires X in_keys(ENV)
+
+  rule <k> eval(BinOp(OP, LEFT, RIGHT))
+        => eval(LEFT) ~> binLeft(OP, RIGHT) ... </k>
+  rule <k> LEFT:Value ~> binLeft(OP, RIGHT)
+        => eval(RIGHT) ~> binRight(OP, LEFT) ... </k>
+
+  rule <k> vInt(I2) ~> binRight("//", vInt(I1))
+        => vInt(I1 /Int I2) ... </k>
+    requires I2 =/=Int 0
+  rule <k> vInt(I2) ~> binRight("%", vInt(I1))
+        => vInt(I1 modInt I2) ... </k>
+    requires I2 =/=Int 0
+  rule <k> vInt(I2) ~> binRight("+", vInt(I1))
+        => vInt(I1 +Int I2) ... </k>
+  rule <k> vStr(S2) ~> binRight("+", vStr(S1))
+        => vStr(S1 +String S2) ... </k>
+
+  rule <k> eval(Subscript(BASE, INDEX))
+        => eval(BASE) ~> subscriptIndex(INDEX) ... </k>
+  rule <k> BASE:Value ~> subscriptIndex(INDEX)
+        => eval(INDEX) ~> subscriptApply(BASE) ... </k>
+  rule <k> vInt(I) ~> subscriptApply(vTuple(ITEMS))
+        => vStr(tupleAt(ITEMS, I)) ... </k>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..ab2d2aaa3eeff38543081cdfeb72a77a60db0478
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def int_to_mini_roman(number):
+    thousands = ("", "m")
+    hundreds = ("", "c", "cc", "ccc", "cd", "d", "dc", "dcc", "dccc", "cm")
+    tens = ("", "x", "xx", "xxx", "xl", "l", "lx", "lxx", "lxxx", "xc")
+    ones = ("", "i", "ii", "iii", "iv", "v", "vi", "vii", "viii", "ix")
+    return (
+        thousands[number // 1000]
+        + hundreds[(number % 1000) // 100]
+        + tens[(number % 100) // 10]
+        + ones[number % 10]
+    )
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d61dceab92cb1c62639ed3ef7c1d70fb6fe22110
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,10 @@
+module ROMAN-SPEC
+  imports ROMAN-VERIFICATION
+
+  claim [int-to-mini-roman-correct]:
+    <k> romanProgram => .K </k>
+    <input> N:Int </input>
+    <env> .Map => ?_FINAL_ENV:Map </env>
+    <result> noResult => result(vStr(miniRoman(N))) </result>
+    requires (1 <=Int N) andBool (N <=Int 1000)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..3a546a2ef1a037bbea565e676914d81622d23970
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,62 @@
+requires "semantic.k"
+
+module ROMAN-VERIFICATION
+  imports MINI-PYTHON
+
+  syntax Pgm ::= "romanProgram" [macro]
+  rule romanProgram =>
+    Module(
+      FuncDef("int_to_mini_roman", Params("number"),
+        Assign(Name("thousands"), TupleExpr(Str(""), Str("m")))
+        Assign(Name("hundreds"),
+          TupleExpr(
+            Str(""), Str("c"), Str("cc"), Str("ccc"), Str("cd"),
+            Str("d"), Str("dc"), Str("dcc"), Str("dccc"), Str("cm")))
+        Assign(Name("tens"),
+          TupleExpr(
+            Str(""), Str("x"), Str("xx"), Str("xxx"), Str("xl"),
+            Str("l"), Str("lx"), Str("lxx"), Str("lxxx"), Str("xc")))
+        Assign(Name("ones"),
+          TupleExpr(
+            Str(""), Str("i"), Str("ii"), Str("iii"), Str("iv"),
+            Str("v"), Str("vi"), Str("vii"), Str("viii"), Str("ix")))
+        Return(
+          BinOp("+",
+            BinOp("+",
+              BinOp("+",
+                Subscript(
+                  Name("thousands"),
+                  BinOp("//", Name("number"), Int(1000))),
+                Subscript(
+                  Name("hundreds"),
+                  BinOp("//",
+                    BinOp("%", Name("number"), Int(1000)),
+                    Int(100)))),
+              Subscript(
+                Name("tens"),
+                BinOp("//",
+                  BinOp("%", Name("number"), Int(100)),
+                  Int(10)))),
+            Subscript(
+              Name("ones"),
+              BinOp("%", Name("number"), Int(10)))))))
+
+  syntax String ::= miniRoman(Int) [function]
+  rule miniRoman(N) =>
+    (((tupleAt("" , "m" , .Strings, N /Int 1000)
+       +String
+       tupleAt(
+         "" , "c" , "cc" , "ccc" , "cd" ,
+         "d" , "dc" , "dcc" , "dccc" , "cm" , .Strings,
+         (N modInt 1000) /Int 100))
+      +String
+      tupleAt(
+        "" , "x" , "xx" , "xxx" , "xl" ,
+        "l" , "lx" , "lxx" , "lxxx" , "xc" , .Strings,
+        (N modInt 100) /Int 10))
+     +String
+     tupleAt(
+       "" , "i" , "ii" , "iii" , "iv" ,
+       "v" , "vi" , "vii" , "viii" , "ix" , .Strings,
+       N modInt 10))
+endmodule

exec
/bin/bash -lc 'chmod +x prove.sh
./prove.sh' in /workspace
