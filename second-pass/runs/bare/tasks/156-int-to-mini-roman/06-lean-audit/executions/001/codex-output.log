+evidence = Path("/audit-output/evidence")
+result = {
+    "review_sha256": hashlib.sha256(review.read_bytes()).hexdigest(),
+    "exact_final_pair": text.endswith(
+        "VERDICT: PASS\nLEGITIMACY: LEGIT\n"
