+            "match": (
+                audit_document["audit"]["mechanical_checker_lock_sha256"]
+                == file_sha256(MECHANICAL_LOCK)
+                and all(
+                    expected == file_sha256(Path("/reference") / relative)
+                    for relative, expected in mechanical_lock["files"].items()
