+                ).hexdigest()
+            ),
+            "recorded_build_output_hash_matches": (
+                preflight["diagnostics"][1]["output_sha256"]
+                == hashlib.sha256(
+                    preflight["diagnostics"][1]["output_tail"].encode()
+                ).hexdigest()
+            ),
+            "match": (
+                export_result["trust_inventory_sha256"]
+                == file_sha256(GENERATION / "trust-inventory.json")
