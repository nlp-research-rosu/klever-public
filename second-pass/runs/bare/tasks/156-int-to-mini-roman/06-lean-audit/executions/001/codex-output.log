+                and producer_hashes["klean_export.py"]
+                == generator_manifest["exporter_sha256"]
+                and producer_hashes["klean.py"]
+                == generator_manifest["klean_py_sha256"]
+                and source_manifest["generator_image_id"] == producer_image_id
