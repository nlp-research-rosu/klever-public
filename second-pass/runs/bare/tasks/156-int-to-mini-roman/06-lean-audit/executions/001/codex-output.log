diff --git a//tmp/audit-work/lean_proc_self_shim.c b//tmp/audit-work/lean_proc_self_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..49513bef131a2b6047a5d27a3bfcaf7f2bee78a7
--- /dev/null
+++ b//tmp/audit-work/lean_proc_self_shim.c
@@ -0,0 +1,19 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static readlink_fn next = NULL;
+  if (next == NULL) next = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  ssize_t result = next(path, buf, size);
+  if (result < 0 && errno == ENOENT &&
+      strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + strlen(path) - 4, "/exe") == 0) {
+    result = next("/proc/self/exe", buf, size);
+  }
+  return result;
+}
diff --git a//tmp/audit-work/trace_app_path.c b//tmp/audit-work/trace_app_path.c
new file mode 100644
index 0000000000000000000000000000000000000000..9f98c373598b7253b470f32448508218d86c3931
--- /dev/null
+++ b//tmp/audit-work/trace_app_path.c
@@ -0,0 +1,44 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+typedef ssize_t (*readlinkat_fn)(int, const char *, char *, size_t);
+typedef char *(*realpath_fn)(const char *, char *);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static readlink_fn next = NULL;
+  if (next == NULL) next = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  ssize_t result = next(path, buf, size);
+  int saved = errno;
+  dprintf(STDERR_FILENO, "TRACE readlink(%s) = %zd errno=%d value=%.*s\n",
+          path, result, saved, result > 0 ? (int)result : 0, buf);
+  errno = saved;
+  return result;
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t size) {
+  static readlinkat_fn next = NULL;
+  if (next == NULL) next = (readlinkat_fn)dlsym(RTLD_NEXT, "readlinkat");
+  ssize_t result = next(dirfd, path, buf, size);
+  int saved = errno;
+  dprintf(STDERR_FILENO, "TRACE readlinkat(%d,%s) = %zd errno=%d value=%.*s\n",
+          dirfd, path, result, saved, result > 0 ? (int)result : 0, buf);
+  errno = saved;
+  return result;
+}
+
+char *realpath(const char *path, char *resolved) {
+  static realpath_fn next = NULL;
+  if (next == NULL) next = (realpath_fn)dlsym(RTLD_NEXT, "realpath");
+  char *result = next(path, resolved);
+  int saved = errno;
+  dprintf(STDERR_FILENO, "TRACE realpath(%s) = %s errno=%d\n",
+          path, result == NULL ? "(null)" : result, saved);
+  errno = saved;
+  return result;
+}
