diff --git a/run_preflight_check.py b/run_preflight_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..75aa0f9a44f8df1b81f083bb8d32d5ac9b34a73a
--- /dev/null
+++ b/run_preflight_check.py
