def check_final(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    candidate: Path | None,
    *,
    toolchain_lock: Path,
    audit_input: Path,
    run_command: Callable[..., tuple[int, str]] = _run,
) -> dict[str, Any]:
    frozen_input = Path(frozen_input)
    discovery_manifest = Path(discovery_manifest)
    generation = Path(generation)
    candidate = Path(candidate) if candidate is not None else None
    audit_binding = _audit_input_binding(Path(audit_input))
    signed_resolution = audit_binding["resolution"]
    if (
        signed_resolution["mode"] == "CLASSIFICATION_AND_PROOF"
        and candidate is None
    ):
        raise KleanFinalGateError(
            "proof-bearing audit requires a Stage 5 Lean candidate"
        )
    if (
        signed_resolution["mode"] == "CLASSIFICATION_ONLY"
        and candidate is not None
    ):
        raise KleanFinalGateError(
            "classification-only audit must not use a Stage 5 Lean "
            "candidate"
        )
    expected_mode = signed_resolution["mode"]
    observed_mode = (
        "CLASSIFICATION_AND_PROOF"
        if candidate is not None
        else "CLASSIFICATION_ONLY"
    )
    if observed_mode != expected_mode:
        raise KleanFinalGateError(
            "Stage 6 mechanical mode differs from audit input"
        )
    before_hashes = _input_hashes(
        frozen_input,
        discovery_manifest,
        generation,
        candidate,
    )
    _require_bound_inputs(audit_binding, before_hashes)
    try:
        preflight = klean_preflight.check_generation(
            frozen_input,
            discovery_manifest,
            generation,
            toolchain_lock=toolchain_lock,
            run_command=run_command,
        )
    except klean_preflight.KleanPreflightError as error:
        raise KleanFinalGateError(
            f"deterministic Klean preflight failed: {error}"
        ) from error
    preflight_status = preflight.get("status")
    if preflight_status not in {"PASS", "KLEAN_NO_OBLIGATIONS"}:
        raise KleanFinalGateError(
            "Stage 4 Klean preflight is not mechanically auditable"
        )
    manifest = _regular_json(
        generation / "generator-manifest.json", "generator manifest"
    )
    target = manifest.get("target")
    if preflight_status == "KLEAN_NO_OBLIGATIONS":
        if candidate is not None:
            raise KleanFinalGateError(
                "classification-only audit must not use a Stage 5 Lean "
                "candidate"
            )
        if target is not None or preflight.get("obligation_count") != 0:
            raise KleanFinalGateError(
                "KLEAN_NO_OBLIGATIONS has a target or nonempty domain set"
            )
        after_hashes = _input_hashes(
            frozen_input,
            discovery_manifest,
            generation,
            candidate,
        )
        if after_hashes != before_hashes:
            raise KleanFinalGateError(
                "resolved inputs changed during mechanical audit"
            )
        _require_bound_inputs(audit_binding, after_hashes)
        return {
            "status": "PASS",
            "mode": "CLASSIFICATION_ONLY",
            "resolved_input_sha256": audit_binding[
                "resolved_input_sha256"
            ],
            "input_hashes": signed_resolution["hashes"],
            "semantic_classification": "NOT_EVALUATED",
            "target": None,
            "klean_preflight": preflight,
            "generation_sha256": klean_export.tree_digest(generation),
            "candidate_sha256": None,
            "used_axioms": [],
            "diagnostics": [],
        }
    if candidate is None:
        raise KleanFinalGateError(
            "proof-bearing audit requires a Stage 5 Lean candidate"
        )
    if not isinstance(target, dict):
        raise KleanFinalGateError("generator target is malformed")
    _candidate_gate(candidate, target)
    inventory = _regular_json(
        generation / "trust-inventory.json", "trust inventory"
    )

    diagnostics: list[dict[str, Any]] = []
    with tempfile.TemporaryDirectory(prefix="klean-final-gate-") as temporary:
        project = Path(temporary) / "project"
        shutil.copytree(candidate, project)
        if pipeline_contract.sha256_tree(project) != before_hashes[
            "lean_workspace_sha256"
        ]:
            raise KleanFinalGateError(
                "candidate changed while copying for mechanical audit"
            )
        shutil.rmtree(project / ".lake", ignore_errors=True)
        shutil.rmtree(project / "Base", ignore_errors=True)
        shutil.copytree(generation / "generated", project / "Base")
        audit_source = project / "AxiomAudit.lean"
        audit_source.write_text(
            "import Proof\n\n"
            "namespace Proof\n\n"
            f"#check (final : {target['statement']})\n"
            "#print axioms final\n\n"
            "end Proof\n"
        )
        outputs: dict[tuple[str, ...], str] = {}
        commands = (
            ["lake", "clean"],
            ["lake", "build"],

diff --git a//tmp/audit-work/lean_proc_self_shim.c b//tmp/audit-work/lean_proc_self_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..49513bef131a2b6047a5d27a3bfcaf7f2bee78a7
--- /dev/null
+++ b//tmp/audit-work/lean_proc_self_shim.c
@@ -0,0 +1,19 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static readlink_fn next = NULL;
+  if (next == NULL) next = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  ssize_t result = next(path, buf, size);
+  if (result < 0 && errno == ENOENT &&
+      strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + strlen(path) - 4, "/exe") == 0) {
+    result = next("/proc/self/exe", buf, size);
+  }
+  return result;
+}
diff --git a//tmp/audit-work/trace_app_path.c b//tmp/audit-work/trace_app_path.c
new file mode 100644
index 0000000000000000000000000000000000000000..9f98c373598b7253b470f32448508218d86c3931
--- /dev/null
+++ b//tmp/audit-work/trace_app_path.c
@@ -0,0 +1,44 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+typedef ssize_t (*readlinkat_fn)(int, const char *, char *, size_t);
+typedef char *(*realpath_fn)(const char *, char *);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static readlink_fn next = NULL;
+  if (next == NULL) next = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  ssize_t result = next(path, buf, size);
+  int saved = errno;
+  dprintf(STDERR_FILENO, "TRACE readlink(%s) = %zd errno=%d value=%.*s\n",
+          path, result, saved, result > 0 ? (int)result : 0, buf);
+  errno = saved;
+  return result;
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t size) {
+  static readlinkat_fn next = NULL;
+  if (next == NULL) next = (readlinkat_fn)dlsym(RTLD_NEXT, "readlinkat");
+  ssize_t result = next(dirfd, path, buf, size);
+  int saved = errno;
+  dprintf(STDERR_FILENO, "TRACE readlinkat(%d,%s) = %zd errno=%d value=%.*s\n",
+          dirfd, path, result, saved, result > 0 ? (int)result : 0, buf);
+  errno = saved;
+  return result;
+}
+
+char *realpath(const char *path, char *resolved) {
+  static realpath_fn next = NULL;
+  if (next == NULL) next = (realpath_fn)dlsym(RTLD_NEXT, "realpath");
+  char *result = next(path, resolved);
+  int saved = errno;
+  dprintf(STDERR_FILENO, "TRACE realpath(%s) = %s errno=%d\n",
+          path, result == NULL ? "(null)" : result, saved);
+  errno = saved;
+  return result;
+}
diff --git a/audit_inventory.py b/audit_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..dc1e6fe08ef04b15a1c86bd0c3c995cd271d6353
--- /dev/null
+++ b/audit_inventory.py
@@ -0,0 +1,97 @@
+#!/usr/bin/env python3
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from tools.k_rule_inventory import canonical_json_sha256, inventory_verification
+
+
+WORKSPACE = Path("/reference/k-proof")
+DISCOVERY = Path("/reference/lemma-discovery.json")
+
+
+def main() -> int:
+    inventory = inventory_verification(WORKSPACE)
+    discovery = json.loads(DISCOVERY.read_text())
+    source_lines = (WORKSPACE / "verification.k").read_text().splitlines()
+
+    checks: dict[str, object] = {}
+    rules = inventory["rules"]
+    discovered_rules = discovery["rules"]
+    inventory_ids = [rule["source_rule_id"] for rule in rules]
+    discovery_ids = [rule["source_rule_id"] for rule in discovered_rules]
+
+    per_rule = []
+    for rule in rules:
+        exact_span = "\n".join(
+            source_lines[rule["start_line"] - 1 : rule["end_line"]]
+        )
+        normalized_hash = hashlib.sha256(
+            " ".join(rule["text"].split()).encode()
+        ).hexdigest()
+        per_rule.append(
+            {
+                "source_rule_id": rule["source_rule_id"],
+                "span_matches_frozen_source": exact_span == rule["text"],
+                "recomputed_normalized_sha256": normalized_hash,
+                "normalized_sha256_matches": (
+                    normalized_hash == rule["normalized_sha256"]
+                ),
+                "source_rule_id_matches_hash": (
+                    rule["source_rule_id"] == f"rule-{normalized_hash}"
+                ),
+            }
+        )
+
+    checks["inventory_rule_count"] = len(rules)
+    checks["discovery_rule_count"] = len(discovered_rules)
+    checks["inventory_ids_unique"] = len(inventory_ids) == len(set(inventory_ids))
+    checks["discovery_ids_unique"] = len(discovery_ids) == len(set(discovery_ids))
+    checks["ordered_identities_equal"] = inventory_ids == discovery_ids
+    checks["omitted_from_discovery"] = sorted(set(inventory_ids) - set(discovery_ids))
+    checks["extra_in_discovery"] = sorted(set(discovery_ids) - set(inventory_ids))
+    checks["recomputed_inventory_sha256"] = canonical_json_sha256(rules)
+    checks["inventory_self_hash_matches"] = (
+        checks["recomputed_inventory_sha256"] == inventory["inventory_sha256"]
+    )
+    checks["discovery_inventory_hash_matches"] = (
+        discovery["inventory_sha256"] == inventory["inventory_sha256"]
+    )
+    checks["every_rule_accounted_once"] = (
+        len(rules) == len(discovered_rules)
+        and inventory_ids == discovery_ids
+        and checks["inventory_ids_unique"]
+        and checks["discovery_ids_unique"]
+    )
+    checks["per_rule_recomputation"] = per_rule
+
+    print(
+        json.dumps(
+            {
+                "reconstructed_inventory": inventory,
+                "protected_discovery": discovery,
+                "bijection_and_hash_checks": checks,
+            },
+            indent=2,
+            sort_keys=True,
+        )
+    )
+
+    passed = (
+        checks["every_rule_accounted_once"]
+        and checks["inventory_self_hash_matches"]
+        and checks["discovery_inventory_hash_matches"]
+        and all(
+            item["span_matches_frozen_source"]
+            and item["normalized_sha256_matches"]
+            and item["source_rule_id_matches_hash"]
+            for item in per_rule
+        )
+    )
+    return 0 if passed else 1
+
+
