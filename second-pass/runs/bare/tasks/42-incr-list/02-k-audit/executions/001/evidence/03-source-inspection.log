     3	    Assign(Name("result"), ListExpr())
     4	    For(Name("value"), Name("l"),
     5	      Assign(
     6	        Name("result"),
     7	        BinOp(
     8	          "+",
     9	          Name("result"),
    10	          ListExpr(BinOp("+", Name("value"), Int(1))))))
    11	    Return(Name("result"))))

