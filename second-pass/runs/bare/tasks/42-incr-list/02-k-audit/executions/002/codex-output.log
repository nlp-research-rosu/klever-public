index 0000000000000000000000000000000000000000..28eed4b39cd96e08592981e7d4964a9c51c13cac
--- /dev/null
+++ b//tmp/audit-work/source/spec-body-mutation.k
@@ -0,0 +1,62 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  claim [for-invariant]:
+    <k>
+      #for(
+        L,
+        I,
+        "value",
+        Assign(
+          Name("result"),
+          BinOp(
+            "+",
+            Name("result"),
+            ListExpr(BinOp("+", Name("value"), Int(1))))))
+      ~> #exec(Return(Name("result")))
+      => .K
+    </k>
+    <env>
+      "l" |-> pyList(L)
+      "result" |-> (#incPrefix(L, I) => #incPrefix(L, size(L)))
+    </env>
+    <iter>
+      _IT => ?_
+    </iter>
+    <result>
+      noResult => result(#incPrefix(L, size(L)))
+    </result>
+    requires (0 <=Int I) andBool (I <=Int size(L))
+
+  // Body-sensitivity mutation: the submitted entry body now adds 2, while
+  // both the auxiliary claim and requested summary still describe adding 1.
+  claim [incr-list-body-adds-two]:
+    <k>
+      #init(
+        Module(
+          FuncDef("incr_list", Params("l"),
+            Assign(Name("result"), ListExpr(.Exps))
+            For(Name("value"), Name("l"),
+              Assign(
+                Name("result"),
+                BinOp(
+                  "+",
+                  Name("result"),
+                  ListExpr(BinOp("+", Name("value"), Int(2))))))
+            Return(Name("result")))),
+        pyList(L))
+      => .K
+    </k>
+    <env>
+      .Map => ?_
+    </env>
+    <iter>
+      noIter => ?_
+    </iter>
+    <result>
+      noResult => result(#incPrefix(L, size(L)))
+    </result>
+    [depends(for-invariant)]
+endmodule
diff --git a//tmp/audit-work/source/spec-rule-witness-control.k b//tmp/audit-work/source/spec-rule-witness-control.k
new file mode 100644
index 0000000000000000000000000000000000000000..395685031dc4e8571b0cc0f7a7d9f971c5b901df
--- /dev/null
+++ b//tmp/audit-work/source/spec-rule-witness-control.k
@@ -0,0 +1,19 @@
+requires "verification.k"
+
+module SPEC-RULE-WITNESS-CONTROL
+  imports VERIFICATION
+
+  // Without the outer shortcut, the same symbolic out-of-bounds access has no
+  // result.
+  claim
+    <k>
+      #return(#at(L, size(L)))
+      => .K
+    </k>
+    <env> .Map </env>
+    <iter> noIter </iter>
+    <result>
+      noResult => result(pyInt(999))
+    </result>
+    requires size(L) >Int 0
+endmodule
diff --git a//tmp/audit-work/source/spec-rule-witness-positive.k b//tmp/audit-work/source/spec-rule-witness-positive.k
new file mode 100644
index 0000000000000000000000000000000000000000..c8b7353ff2f1444c1d8c3bcf9a4cc5f90c8b3427
--- /dev/null
+++ b//tmp/audit-work/source/spec-rule-witness-positive.k
@@ -0,0 +1,26 @@
+requires "verification.k"
+
+module SPEC-RULE-WITNESS-POSITIVE
+  imports VERIFICATION
+
+  // For every nonempty intended-domain list, size(L) is out of bounds. The
+  // special #add simplification bypasses that #at and fabricates a successor.
+  claim
+    <k>
+      #return(
+        #add(
+          #incPrefix(L, size(L)),
+          pyList(
+            ListItem(
+              #add(
+                #at(L, size(L)),
+                pyInt(1))))))
+      => .K
+    </k>
+    <env> .Map </env>
+    <iter> noIter </iter>
+    <result>
+      noResult => result(#incPrefix(L, size(L) +Int 1))
+    </result>
+    requires size(L) >Int 0
+endmodule
