+
+python3 /audit-output/evidence/concrete_oracle.py /reference/canonical.py
+
+krun "$program_path" --definition "$definition_path" \
+  -cARGS='pyList(.List)' \
+  --pattern '<result> result(pyList(.List)) </result>'
+
