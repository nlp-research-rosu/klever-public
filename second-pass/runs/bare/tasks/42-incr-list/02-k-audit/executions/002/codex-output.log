+        pyList(L))
+      => .K
+    </k>
+    <env>
+      .Map => ?_
+    </env>
+    <iter>
+      noIter => ?_
+    </iter>
+    <result>
+      noResult => result(#incPrefix(L, size(L)))
+    </result>
+    [depends(for-invariant)]
+endmodule
