+requires "verification.k"
+
+module SPEC-RULE-WITNESS-POSITIVE
+  imports VERIFICATION
+
+  // Intended-domain list [1], but index 1 is out of bounds. The special
+  // #add simplification bypasses the stuck #at and fabricates a successor.
+  claim
+    <k>
+      #return(
+        #add(
+          #incPrefix(ListItem(pyInt(1)), 1),
+          pyList(
+            ListItem(
+              #add(
+                #at(ListItem(pyInt(1)), 1),
+                pyInt(1))))))
+      => .K
+    </k>
+    <env> .Map </env>
+    <iter> noIter </iter>
+    <result>
+      noResult => result(#incPrefix(ListItem(pyInt(1)), 2))
+    </result>
+endmodule
