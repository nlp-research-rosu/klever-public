+requires "verification.k"
+
+module SPEC-RULE-WITNESS-GROUND
+  imports VERIFICATION
+
+  // Ground instance L = [1] of the symbolic claim in
+  // SPEC-RULE-WITNESS-POSITIVE. It exposes the competing inner #at reduction.
+  claim
+    <k>
+      #return(
+        #add(
+          #incPrefix(ListItem(pyInt(1)), 1),
+          pyList(
+            ListItem(
+              #add(
+                #at(ListItem(pyInt(1)), 1),
+                pyInt(1))))))
+      => .K
+    </k>
+    <env> .Map </env>
+    <iter> noIter </iter>
+    <result>
+      noResult => result(#incPrefix(ListItem(pyInt(1)), 2))
+    </result>
+endmodule
diff --git a//tmp/audit-work/source/spec-rule-witness-positive.k b//tmp/audit-work/source/spec-rule-witness-positive.k
new file mode 100644
index 0000000000000000000000000000000000000000..c8b7353ff2f1444c1d8c3bcf9a4cc5f90c8b3427
--- /dev/null
+++ b//tmp/audit-work/source/spec-rule-witness-positive.k
@@ -0,0 +1,26 @@
+requires "verification.k"
+
+module SPEC-RULE-WITNESS-POSITIVE
+  imports VERIFICATION
+
+  // For every nonempty intended-domain list, size(L) is out of bounds. The
+  // special #add simplification bypasses that #at and fabricates a successor.
+  claim
+    <k>
+      #return(
+        #add(
+          #incPrefix(L, size(L)),
+          pyList(
+            ListItem(
+              #add(
+                #at(L, size(L)),
+                pyInt(1))))))
+      => .K
+    </k>
+    <env> .Map </env>
+    <iter> noIter </iter>
+    <result>
+      noResult => result(#incPrefix(L, size(L) +Int 1))
+    </result>
+    requires size(L) >Int 0
+endmodule
diff --git a//tmp/audit-work/source/spec-vacuity.k b//tmp/audit-work/source/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..87f2cdd38a29f7c62135db4a7891b46107f25936
--- /dev/null
+++ b//tmp/audit-work/source/spec-vacuity.k
@@ -0,0 +1,62 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  claim [for-invariant]:
+    <k>
+      #for(
+        L,
+        I,
+        "value",
+        Assign(
+          Name("result"),
+          BinOp(
+            "+",
+            Name("result"),
+            ListExpr(BinOp("+", Name("value"), Int(1))))))
+      ~> #exec(Return(Name("result")))
+      => .K
+    </k>
+    <env>
+      "l" |-> pyList(L)
+      "result" |-> (#incPrefix(L, I) => #incPrefix(L, size(L)))
+    </env>
+    <iter>
+      _IT => ?_
+    </iter>
+    <result>
+      noResult => result(#incPrefix(L, size(L)))
+    </result>
+    requires (0 <=Int I) andBool (I <=Int size(L))
+
+  // False result mutation. The satisfying input L=[pyInt(0)] must return
+  // pyList([pyInt(1)]), not an empty list.
+  claim [incr-list-false-empty-result]:
+    <k>
+      #init(
+        Module(
+          FuncDef("incr_list", Params("l"),
+            Assign(Name("result"), ListExpr(.Exps))
+            For(Name("value"), Name("l"),
+              Assign(
+                Name("result"),
+                BinOp(
+                  "+",
+                  Name("result"),
+                  ListExpr(BinOp("+", Name("value"), Int(1))))))
+            Return(Name("result")))),
+        pyList(L))
+      => .K
+    </k>
+    <env>
+      .Map => ?_
+    </env>
+    <iter>
+      noIter => ?_
+    </iter>
+    <result>
+      noResult => result(pyList(.List))
+    </result>
+    [depends(for-invariant)]
+endmodule
