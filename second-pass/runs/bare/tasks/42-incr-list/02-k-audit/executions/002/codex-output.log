/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import hashlib,itertools,json
roots=[Path('/candidate'),Path('/generation-evidence/codex-trace')]
expected=['78e45af5dc4971ce6aeccf5452e8e979f9ab2606c471aae8304779916e2b14ab','79036e6590848ac54e954b567877699d22dd5505f8988d869d4f9a422f012c72']
def ents(root,dirs):
 out=[]
 for p in sorted(root.rglob('*'),key=lambda p:p.relative_to(root).as_posix()):
  if p.is_file() or (dirs and p.is_dir()):
   b=p.read_bytes() if p.is_file() else b''
   out.append(dict(rel=p.relative_to(root).as_posix(),dot='./'+p.relative_to(root).as_posix(),name=p.name,kind='file' if p.is_file() else 'directory',short='f' if p.is_file() else 'd',size=str(len(b)),mode=oct(p.stat().st_mode & 0o777)[2:],hex=hashlib.sha256(b).hexdigest(),raw=b))
 return out
matches=[]
# Sequential token algorithms.
for dirs in [False,True]:
 es=[ents(r,dirs) for r in roots]
 for pathkey in ['rel','dot','name']:
  for kindkey in [None,'kind','short']:
   for valuekey in ['hex','raw']:
    for use_size in [False,True]:
     for use_mode in [False,True]:
      fields=[x for x in [kindkey,pathkey,'mode' if use_mode else None,'size' if use_size else None,valuekey] if x]
      for order in [fields,list(reversed(fields))]:
       for sep in [b'',b'\\0',b' ',b'  ',b':',b'\\n']:
        for end in [b'',b'\\0',b'\\n']:
         got=[]
         for entries in es:
          h=hashlib.sha256()
          for e in entries:
           vals=[]
           for f in order:
            v=e[f]; vals.append(v if isinstance(v,bytes) else str(v).encode())
           h.update(sep.join(vals)+end)
          got.append(h.hexdigest())
         if got==expected: matches.append(('seq',dirs,pathkey,kindkey,valuekey,use_size,use_mode,order,sep,end))
# JSON common shapes (file hash values, no raw).
for dirs in [False,True]:
 es=[ents(r,dirs) for r in roots]
 for shape in ['listdict','dict','listtuple','linesdict']:
  for keys in [('rel','hex'),('rel','kind','hex'),('rel','size','hex'),('rel','kind','size','hex'),('rel','mode','size','hex')]:
   for separators in [None,(',',':'),(', ', ': ')]:
    for indent in [None,2,4]:
     got=[]
     for entries in es:
      if shape=='listdict': obj=[{k:e[k] for k in keys} for e in entries]
      elif shape=='dict': obj={e['rel']:{k:e[k] for k in keys if k"'!='"'rel'} for e in entries}
      elif shape=='listtuple': obj=[[e[k] for k in keys] for e in entries]
      else: obj='\\n'.join(json.dumps({k:e[k] for k in keys},sort_keys=True,separators=separators) for e in entries)+'\\n'
      text=json.dumps(obj,sort_keys=True,separators=separators,indent=indent) if shape"'!='"'linesdict' else obj
      got.append(hashlib.sha256(text.encode()).hexdigest())
     if got==expected: matches.append(('json',dirs,shape,keys,separators,indent))
print(matches[:20], 'count',len(matches))
PY" in /audit-output
