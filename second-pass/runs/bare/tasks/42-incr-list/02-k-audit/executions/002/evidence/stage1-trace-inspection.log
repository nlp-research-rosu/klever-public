const patch = "*** Begin Patch\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module VERIFICATION\n+  imports MPY\n+  imports MAP-SYMBOLIC\n+\n+  // Mathematical model of the requested result on the half-open interval\n+  // [FROM, TO). Each selected Python value is added to the Python integer 1.\n+  syntax List ::= #incrementRange(List, Int, Int) [function]\n+\n+  rule #incrementRange(_L, FROM, TO) => .List\n+    requires FROM >=Int TO\n+\n+  rule #incrementRange(L, FROM, TO)\n+    => ListItem(#add(#at(L, FROM), pyInt(1)))\n+       #incrementRange(L, FROM +Int 1, TO)\n+    requires FROM <Int TO\n+endmodule\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module SPEC\n+  imports VERIFICATION\n+\n+  // Loop invariant: if result initially contains A, executing the remaining\n+  // suffix [I, size(L)) appends exactly its element-wise increment.\n+  claim [for-invariant]:\n+    <k>\n+      #for(\n+        L,\n+        I,\n+        \"value\",\n+        Assign(\n+          Name(\"result\"),\n+          BinOp(\n+            \"+\",\n+            Name(\"result\"),\n+            ListExpr(BinOp(\"+\", Name(\"value\"), Int(1))))))\n+      => .K ...\n+    </k>\n+    <env>\n+      ... \"result\" |->\n+        (pyList(A) => pyList(A #incrementRange(L, I, size(L)))) ...\n+    </env>\n+    requires 0 <=Int I andBool I <=Int size(L)\n+\n+  // Whole-program functional correctness for an arbitrary symbolic list L.\n+  claim [incr-list-correct]:\n+    <k>\n+      #init(\n+        Module(\n+          FuncDef(\"incr_list\", Params(\"l\"),\n+            Assign(Name(\"result\"), ListExpr())\n+            For(Name(\"value\"), Name(\"l\"),\n+              Assign(\n+                Name(\"result\"),\n+                BinOp(\n+                  \"+\",\n+                  Name(\"result\"),\n+                  ListExpr(BinOp(\"+\", Name(\"value\"), Int(1))))))\n+            Return(Name(\"result\")))),\n+        pyList(L))\n+      => .K\n+    </k>\n+    <result>\n+      noResult => result(pyList(#incrementRange(L, 0, size(L))))\n+    </result>\n+    [depends(for-invariant)]\n+endmodule\n*** End Patch";
text(await tools.apply_patch(patch));
text(await tools.exec_command({cmd:"kprove spec.k --definition semantic-kompiled --dry-run",workdir:"/work",yield_time_ms:1000,max_output_tokens:30000}));

