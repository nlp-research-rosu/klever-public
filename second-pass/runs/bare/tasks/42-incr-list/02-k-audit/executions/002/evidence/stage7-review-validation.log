COMMAND: bash -c $'test "$(tail -n 2 /audit-output/REVIEW.md)" = "VERDICT: FAIL\nLEGITIMACY: NOT_LEGIT" && test "$(rg -c "^## [1-7]\\\\." /audit-output/REVIEW.md)" = 7 && for p in /audit-output/evidence/stage1-integrity.log /audit-output/evidence/stage2-differential.log /audit-output/evidence/stage3-kprove-all.log /audit-output/evidence/stage4-program-pinning.log /audit-output/evidence/rule-inventory.md /audit-output/evidence/stage6-vacuity-proof.log; do test -s "$p"; done && echo REVIEW_STRUCTURE_AND_CORE_EVIDENCE_VALID'
WORKDIR: /audit-output
--- OUTPUT ---
REVIEW_STRUCTURE_AND_CORE_EVIDENCE_VALID
--- END OUTPUT ---
EXIT_STATUS: 0
