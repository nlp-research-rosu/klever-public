n-            FuncDef(\\\"mean_absolute_deviation\\\", Params(\\\"numbers\\\"),\\n-                    CellVars(\\\"mean\\\"), FreeVars(.Strings),\\n-              Assign(\\n-                Name(\\\"mean\\\"),\\n-                BinOp(\\\"/\\\",\\n-                  Call(Name(\\\"sum\\\"), Name(\\\"numbers\\\")),\\n-                  Call(Name(\\\"len\\\"), Name(\\\"numbers\\\"))))\\n-              Return(\\n-                BinOp(\\\"/\\\",\\n-                  Call(Name(\\\"sum\\\"),\\n-                    ListComp(\\n-                      Call(Name(\\\"abs\\\"),\\n-                        BinOp(\\\"-\\\", Name(\\\"x\\\"), Name(\\\"mean\\\"))),\\n-                      CompFor(Name(\\\"x\\\"), Name(\\\"numbers\\\"), Bool(true)))),\\n-                  Call(Name(\\\"len\\\"), Name(\\\"numbers\\\")))))),\\n-          nums(H, T))\\n+        init(solutionProgram, nums(H, T))\\n@@\\n-        => result(divNum(\\n-             sumAbs(H, T,\\n-               divNum(sumNums(H, T), countNums(H, T))),\\n-             countNums(H, T)))\\n+        => result(mathMAD(H, T))\\n*** Update File: /work/prove.sh\\n@@\\n-kompile semantic.k \\\\\\n+kompile verification.k \\\\\\n   --backend haskell \\\\\\n-  --main-module SEMANTIC \\\\\\n+  --main-module VERIFICATION \\\\\\n   --syntax-module MPY-SYNTAX\\n@@\\n-  --definition semantic-kompiled \\\\\\n+  --definition verification-kompiled \\\\\\n@@\\n-  --definition semantic-kompiled \\\\\\n+  --definition verification-kompiled \\\\\\n@@\\n-kprove spec.k --definition semantic-kompiled\\n+kprove spec.k --definition verification-kompiled\\n*** End Patch\";\ntext(await tools.apply_patch(patch));\nconst r = await tools.exec_command({cmd:\"kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX && krun solution.mpy --definition verification-kompiled -cARGS='nums(rat(1,1),rat(2,1),rat(3,1),rat(4,1))' && kprove spec.k --definition verification-kompiled\",\"workdir\":\"/work\",\"yield_time_ms\":30000,\"m