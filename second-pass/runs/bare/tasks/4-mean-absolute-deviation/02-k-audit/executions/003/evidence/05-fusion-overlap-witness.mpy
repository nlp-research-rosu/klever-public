Module(
  FuncDef("mean_absolute_deviation", Params("numbers"),
    CellVars(), FreeVars(),
    Assign(Name("x"), Int(5))
    Return(
      Call(
        Name("sum"),
        ListComp(
          Call(Name("abs"), BinOp("-", Name("x"), Name("x"))),
          CompFor(Name("x"), Name("numbers"), Bool(true)))))))
