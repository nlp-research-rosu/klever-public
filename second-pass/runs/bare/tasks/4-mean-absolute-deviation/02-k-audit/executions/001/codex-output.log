+      </k>
+      <env>
+        emptyEnv
+        => bind("mean", rat(0,3),
+             bind("numbers",
+               nums(rat(-2,1),rat(0,1),rat(2,1)),
+               emptyEnv))
+      </env>
+      <result>
+        noResult => result(rat(108,81))
