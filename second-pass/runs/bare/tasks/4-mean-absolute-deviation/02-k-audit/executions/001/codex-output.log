   117	    => subValue(eval(A, ENV), eval(B, ENV))
   118	  rule eval(BinOp("/", A, B), ENV)
   119	    => divValue(eval(A, ENV), eval(B, ENV))
   120	  rule eval(Call(Name("sum"), E), ENV) => sumValue(eval(E, ENV))
   121	  rule eval(Call(Name("len"), E), ENV) => lenValue(eval(E, ENV))
   122	  rule eval(Call(Name("abs"), E), ENV) => absValue(eval(E, ENV))
   123	  rule eval(ListComp(E, CompFor(Name(X), ITER, Bool(true))), ENV)
   124	    => makeComp(E, X, eval(ITER, ENV), ENV)
   125	
   126	  rule makeComp(E, X, nums(NS), ENV) => comprehension(E, X, NS, ENV)
   127	  rule sumValue(nums(NS)) => sumNums(NS)
   128	  rule lenValue(nums(NS)) => countNums(NS)
   129	  rule absValue(N:Num) => absNum(N)
   130	  rule subValue(A:Num, B:Num) => subNum(A, B)
   131	  rule divValue(A:Num, B:Num) => divNum(A, B)
