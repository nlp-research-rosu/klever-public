+               nums(rat(1,1),rat(2,1),rat(3,1),rat(4,1)),
+               emptyEnv))
+      </env>
+      <result>
+        noResult => result(rat(0,1))
+      </result>
+    </mad>
+
+endmodule

 succeeded in 1760ms:
<mad>
  <k>
    .K
  </k>
  <env>
    bind ( "mean" , rat ( -4 , 2 ) , bind ( "numbers" , nums ( rat ( 3 , -1 ) , rat ( 1 , -1 ) , .Nums ) , emptyEnv ) )
  </env>
  <result>
    result ( rat ( -8 , 8 ) )
  </result>
</mad>
EXIT STATUS: 0

INTERPRETATION
The oracle result is +1. The K result above is rat(-8,8), i.e. -1.
Both input denominators are nonzero, so these are valid rational representations.
