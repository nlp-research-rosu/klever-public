printf 'INVOCATION: bash /audit-output/evidence/03_reconstruct.sh\\n' | tee /audit-output/evidence/03_reconstruct.log
bash /audit-output/evidence/03_reconstruct.sh 2>&1 | tee -a /audit-output/evidence/03_reconstruct.log
