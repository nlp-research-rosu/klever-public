   104	  rule <k> finish(V) => .K ... </k>
   105	       <result> noResult => result(V) </result>
   106	
   107	  // Lexical environments; the newest binding shadows older bindings.
   108	  rule lookup(X, bind(X, V, _)) => V
   109	  rule lookup(X, bind(Y, _, ENV)) => lookup(X, ENV)
   110	    requires X =/=String Y
   111	
   112	  // Denotational expression rules.  Comprehensions retain their lexical
