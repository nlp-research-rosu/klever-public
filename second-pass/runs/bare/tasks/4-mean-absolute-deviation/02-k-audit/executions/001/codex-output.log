+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: the documented satisfying input has MAD 1, not 0.
+  // This changes the result-bearing destination while preserving actual
+  // program execution and a realizable initial state.
+  claim [false-documented-result]:
+    <mad>
+      <k>
+        init(solutionProgram,
+          nums(rat(1,1),rat(2,1),rat(3,1),rat(4,1)))
+        => .K
+      </k>
+      <env>
+        emptyEnv
+        => bind("mean", rat(10,4),
+             bind("numbers",
+               nums(rat(1,1),rat(2,1),rat(3,1),rat(4,1)),
+               emptyEnv))
+      </env>
+      <result>
+        noResult => result(rat(0,1))
+      </result>
+    </mad>
+
+endmodule

exec
/bin/bash -lc "set -o pipefail
printf 'INVOCATION: bash /audit-output/evidence/04_adequacy_checks.sh\\n' | tee /audit-output/evidence/04_adequacy_checks.log
bash /audit-output/evidence/04_adequacy_checks.sh 2>&1 | tee -a /audit-output/evidence/04_adequacy_checks.log
stage_status="'${PIPESTATUS[0]}
printf '"'SCRIPT EXIT STATUS: %d\\n' \""'$stage_status" | tee -a /audit-output/evidence/04_adequacy_checks.log
exit "$stage_status"' in /audit-output
