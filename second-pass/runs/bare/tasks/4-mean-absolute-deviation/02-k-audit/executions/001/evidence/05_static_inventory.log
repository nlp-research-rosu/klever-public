   151	  rule absNum(rat(A, B)) => rat(A, B)
   152	    requires A >=Int 0
   153	
   154	  rule sumNums(.Nums) => rat(0, 1)
   155	  rule sumNums(N, NS) => addNum(N, sumNums(NS))
   156	  rule countNums(.Nums) => rat(0, 1)
   157	  rule countNums(_N, NS) => addNum(rat(1, 1), countNums(NS))
