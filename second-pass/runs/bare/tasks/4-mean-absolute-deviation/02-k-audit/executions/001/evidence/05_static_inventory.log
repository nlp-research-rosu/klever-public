COMMAND (numbered verification.k): nl -ba /tmp/audit-work/reconstruction/verification.k
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // Readable name for the exact constructor tree emitted in solution.mpy.
     7	  syntax ModuleAst ::= "solutionProgram" [function]
     8	  rule solutionProgram =>
     9	    Module(
    10	      ImportFrom("typing", "List")
    11	      FuncDef("mean_absolute_deviation", Params("numbers"),
    12	              CellVars("mean"), FreeVars(.Strings),
    13	        Assign(
    14	          Name("mean"),
    15	          BinOp("/",
    16	            Call(Name("sum"), Name("numbers")),
    17	            Call(Name("len"), Name("numbers"))))
    18	        Return(
    19	          BinOp("/",
    20	            Call(Name("sum"),
    21	              ListComp(
    22	                Call(Name("abs"), BinOp("-", Name("x"), Name("mean"))),
    23	                CompFor(Name("x"), Name("numbers"), Bool(true)))),
    24	            Call(Name("len"), Name("numbers"))))))
    25	
    26	  // Mathematical contract, separate from the operational evaluator:
    27	  // MAD(xs) = sum(|x - sum(xs)/|xs||)/|xs|.
    28	  syntax Num ::= "mathMAD" "(" Nums ")" [function]
    29	  rule mathMAD(NS) =>
    30	    divNum(sumAbs(NS, divNum(sumNums(NS), countNums(NS))), countNums(NS))
    31	endmodule
EXIT STATUS: 0

COMMAND (numbered spec.k): nl -ba /tmp/audit-work/reconstruction/spec.k
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Universal functional correctness for every nonempty finite rational
     7	  // input list.  H and T are arbitrary, so this is not bounded testing.
     8	  claim
     9	    <mad>
    10	      <k>
    11	        init(solutionProgram, nums(H, T))
    12	        => .K
    13	      </k>
    14	      <env>
    15	        emptyEnv
    16	        => bind("mean", divNum(sumNums(H, T), countNums(H, T)),
    17	             bind("numbers", nums(H, T), emptyEnv))
    18	      </env>
    19	      <result>
    20	        noResult
    21	        => result(mathMAD(H, T))
    22	      </result>
    23	    </mad>
    24	
    25	endmodule
EXIT STATUS: 0

