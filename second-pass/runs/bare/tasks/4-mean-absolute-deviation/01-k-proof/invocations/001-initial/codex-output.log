+from typing import List
+
+
+def mean_absolute_deviation(numbers: List[float]) -> float:
+    mean = sum(numbers) / len(numbers)
+    return sum([abs(x - mean) for x in numbers]) / len(numbers)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f2d17fb17adfc3871426598ab75de9fe3ed43a16
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,25 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal functional correctness for every nonempty finite rational
+  // input list.  H and T are arbitrary, so this is not bounded testing.
+  claim
+    <mad>
+      <k>
+        init(solutionProgram, nums(H, T))
+        => .K
+      </k>
+      <env>
+        emptyEnv
+        => bind("mean", divNum(sumNums(H, T), countNums(H, T)),
+             bind("numbers", nums(H, T), emptyEnv))
+      </env>
+      <result>
+        noResult
+        => result(mathMAD(H, T))
+      </result>
+    </mad>
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..6fa67157ffbb988e802f7c519d4999d5457c84ad
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,31 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // Readable name for the exact constructor tree emitted in solution.mpy.
+  syntax ModuleAst ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      ImportFrom("typing", "List")
+      FuncDef("mean_absolute_deviation", Params("numbers"),
+              CellVars("mean"), FreeVars(.Strings),
+        Assign(
+          Name("mean"),
+          BinOp("/",
+            Call(Name("sum"), Name("numbers")),
+            Call(Name("len"), Name("numbers"))))
+        Return(
+          BinOp("/",
+            Call(Name("sum"),
+              ListComp(
+                Call(Name("abs"), BinOp("-", Name("x"), Name("mean"))),
+                CompFor(Name("x"), Name("numbers"), Bool(true)))),
+            Call(Name("len"), Name("numbers"))))))
+
+  // Mathematical contract, separate from the operational evaluator:
+  // MAD(xs) = sum(|x - sum(xs)/|xs||)/|xs|.
+  syntax Num ::= "mathMAD" "(" Nums ")" [function]
+  rule mathMAD(NS) =>
+    divNum(sumAbs(NS, divNum(sumNums(NS), countNums(NS))), countNums(NS))
+endmodule

