diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..d9f95ba64c1e478b76747cab8c2e7880ed20b936
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+from typing import List
+
+
+def mean_absolute_deviation(numbers: List[float]) -> float:
+    mean = sum(numbers) / len(numbers)
+    return sum([abs(x - mean) for x in numbers]) / len(numbers)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f6ae75b90ecae216805a89f4a2ca398c4afbf510
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,49 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal functional correctness for every nonempty finite rational
+  // input list.  H and T are arbitrary, so this is not bounded testing.
+  claim
+    <mad>
+      <k>
+        init(
+          Module(
+            ImportFrom("typing", "List")
+            FuncDef("mean_absolute_deviation", Params("numbers"),
+                    CellVars("mean"), FreeVars(.Strings),
+              Assign(
+                Name("mean"),
+                BinOp("/",
+                  Call(Name("sum"), Name("numbers")),
+                  Call(Name("len"), Name("numbers"))))
+              Return(
+                BinOp("/",
+                  Call(Name("sum"),
+                    ListComp(
+                      Call(Name("abs"),
+                        BinOp("-", Name("x"), Name("mean"))),
+                      CompFor(Name("x"), Name("numbers"), Bool(true)))),
+                  Call(Name("len"), Name("numbers")))))),
+          nums(H, T))
+      </k>
+      <env> emptyEnv </env>
+      <result> noResult </result>
+    </mad>
+  =>
+    <mad>
+      <k> .K </k>
+      <env>
+        bind("mean", divNum(sumNums(H, T), countNums(H, T)),
+          bind("numbers", nums(H, T), emptyEnv))
+      </env>
+      <result>
+        result(divNum(
+          sumAbs(H, T,
+            divNum(sumNums(H, T), countNums(H, T))),
+          countNums(H, T)))
+      </result>
+    </mad>
+
+endmodule
