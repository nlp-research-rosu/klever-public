+    <mad>
+      <k> init(solutionProgram, nums(H, T)) </k>
+      <env> emptyEnv </env>
+      <result> noResult </result>
+    </mad>
+  =>
+    <mad>
+      <k> .K </k>
+      <env>
+        bind("mean", divNum(sumNums(H, T), countNums(H, T)),
+          bind("numbers", nums(H, T), emptyEnv))
+      </env>
+      <result> result(mathMAD(H, T)) </result>
+    </mad>
+
+  // Prompt example: [1, 2, 3, 4] has MAD 1.
+  claim numEq(
+          mathMAD(rat(1, 1), rat(2, 1), rat(3, 1), rat(4, 1)),
+          rat(1, 1))
+        => true
+
+  // A second shape checks negative inputs and an odd-length list.
+  claim numEq(
+          mathMAD(rat(-2, 1), rat(0, 1), rat(2, 1)),
+          rat(4, 3))
+        => true
+endmodule
