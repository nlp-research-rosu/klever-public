+                  Call(Name("sum"),
+                    ListComp(
+                      Call(Name("abs"),
+                        BinOp("-", Name("x"), Name("mean"))),
+                      CompFor(Name("x"), Name("numbers"), Bool(true)))),
+                  Call(Name("len"), Name("numbers")))))),
+          nums(H, T))
+      </k>
+      <env> emptyEnv </env>
+      <result> noResult </result>
+    </mad>
+  =>
