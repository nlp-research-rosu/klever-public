+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal functional correctness for every nonempty finite rational
+  // input list.  H and T are arbitrary, so this is not bounded testing.
+  claim
+    <mad>
+      <k>
+        init(
+          Module(
+            ImportFrom("typing", "List")
+            FuncDef("mean_absolute_deviation", Params("numbers"),
+                    CellVars("mean"), FreeVars(.Strings),
+              Assign(
+                Name("mean"),
+                BinOp("/",
+                  Call(Name("sum"), Name("numbers")),
+                  Call(Name("len"), Name("numbers"))))
+              Return(
+                BinOp("/",
+                  Call(Name("sum"),
+                    ListComp(
+                      Call(Name("abs"),
+                        BinOp("-", Name("x"), Name("mean"))),
+                      CompFor(Name("x"), Name("numbers"), Bool(true)))),
+                  Call(Name("len"), Name("numbers"))))),
+          nums(H, T))
+      </k>
+      <env> emptyEnv </env>
+      <result> noResult </result>
+    </mad>
+  =>
+    <mad>
+      <k> .K </k>
+      <env>
+        bind("mean", divNum(sumNums(H, T), countNums(H, T)),
+          bind("numbers", nums(H, T), emptyEnv))
+      </env>
+      <result>
+        result(divNum(
+          sumAbs(H, T,
+            divNum(sumNums(H, T), countNums(H, T))),
+          countNums(H, T)))
+      </result>
+    </mad>
+
+endmodule
