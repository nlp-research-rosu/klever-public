+  syntax ModuleAst ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      ImportFrom("typing", "List")
+      FuncDef("mean_absolute_deviation", Params("numbers"),
+              CellVars("mean"), FreeVars(),
+        Assign(
+          Name("mean"),
+          BinOp("/",
+            Call(Name("sum"), Name("numbers")),
+            Call(Name("len"), Name("numbers"))))
+        Return(
+          BinOp("/",
+            Call(Name("sum"),
+              ListComp(
+                Call(Name("abs"), BinOp("-", Name("x"), Name("mean"))),
+                CompFor(Name("x"), Name("numbers"), Bool(true)))),
+            Call(Name("len"), Name("numbers"))))))
+
+  // Contract oracle: mean(xs) = sum(xs)/|xs| and
+  // MAD(xs) = sum(|x - mean(xs)|)/|xs|.
+  syntax Num ::= "mathMAD" "(" Nums ")" [function]
+  rule mathMAD(NS) =>
+    divNum(sumAbs(NS, divNum(sumNums(NS), countNums(NS))), countNums(NS))
+
+  // Rational equality is extensional, so concrete examples can state their
+  // familiar reduced result without requiring operational normalization.
+  syntax Bool ::= "numEq" "(" Num "," Num ")" [function]
+  rule numEq(rat(A, B), rat(C, D)) => (A *Int D) ==Int (C *Int B)
+endmodule

