+                | "absNum"   "(" Num ")" [function]
+                | "sumNums"  "(" Nums ")" [function]
+                | "countNums" "(" Nums ")" [function]
+                | "sumAbs"   "(" Nums "," Num ")" [function]
+                | "asNum"    "(" Value ")" [function]
