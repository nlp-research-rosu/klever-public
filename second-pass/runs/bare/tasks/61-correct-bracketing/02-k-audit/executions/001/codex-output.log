@@ -0,0 +1,38 @@
+#!/usr/bin/env python3
+"""Mechanically compare solutionProgram's constructor term with solution.mpy."""
+
+from __future__ import annotations
+
+import hashlib
+import re
+from pathlib import Path
+
+scratch = Path("/tmp/audit-work/candidate-src")
+submitted = (scratch / "solution.mpy").read_text()
+verification = (scratch / "verification.k").read_text()
+
+match = re.search(
+    r"rule\s+solutionProgram\s*=>\s*(Module\(.*?\)\)\)\))\s*\n\s*\n",
+    verification,
+    flags=re.DOTALL,
+)
+if match is None:
+    raise SystemExit("could not extract solutionProgram equation")
+embedded = match.group(1)
+
+
+def compact(text: str) -> str:
+    # The compared constructor terms contain no whitespace inside string
+    # literals; stripping all whitespace therefore gives a stable token check.
+    return re.sub(r"\s+", "", text)
+
+
+submitted_compact = compact(submitted)
+embedded_compact = compact(embedded)
+same = submitted_compact == embedded_compact
+print(f"submitted_sha256={hashlib.sha256(submitted.encode()).hexdigest()}")
+print(f"submitted_compact_sha256={hashlib.sha256(submitted_compact.encode()).hexdigest()}")
+print(f"embedded_compact_sha256={hashlib.sha256(embedded_compact.encode()).hexdigest()}")
+print(f"constructor_terms_equal={str(same).lower()}")
+print(f"spec_main_uses_Run_solutionProgram={str('Run(solutionProgram, \"correct_bracketing\", S:String)' in (scratch / 'spec.k').read_text()).lower()}")
+raise SystemExit(0 if same else 1)
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..f6cc39ad125df8deb5ebc330a993892275bdfc7f
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,42 @@
+#!/usr/bin/env bash
+set -u
+
+if [ "$#" -lt 2 ]; then
+  echo "usage: run_logged.sh LABEL COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_label=$1
+shift
+audit_log="/audit-output/evidence/${audit_label}.log"
+audit_tmp="/tmp/audit-work/${audit_label}.full.log"
+
+{
+  printf 'WORKDIR: %q\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$audit_log"
+
+"$@" > "$audit_tmp" 2>&1
+audit_status=$?
+audit_lines=$(wc -l < "$audit_tmp")
+
+{
+  printf 'EXIT_STATUS: %d\n' "$audit_status"
+  printf 'OUTPUT_LINES: %d\n' "$audit_lines"
+  printf '%s\n' '--- OUTPUT ---'
+  if [ "$audit_lines" -le 400 ]; then
+    sed -n '1,400p' "$audit_tmp"
+  else
+    sed -n '1,200p' "$audit_tmp"
+    printf '%s\n' "--- OMITTED $((audit_lines - 400)) MIDDLE LINES ---"
+    tail -n 200 "$audit_tmp"
+  fi
+} >> "$audit_log"
+
+sed -n '1,80p' "$audit_log"
+if [ "$audit_lines" -gt 80 ]; then
+  printf 'Console output truncated; bounded record: %s\n' "$audit_log"
+fi
+exit "$audit_status"
diff --git a/evidence/spec-body-sensitivity.k b/evidence/spec-body-sensitivity.k
new file mode 100644
index 0000000000000000000000000000000000000000..5473769ab163d89057915996cd8faac323d17a05
--- /dev/null
+++ b/evidence/spec-body-sensitivity.k
@@ -0,0 +1,15 @@
+requires "verification-body-mutant.k"
+
+module SPEC-BODY-SENSITIVITY
+  imports MPY-VERIFICATION-BODY-MUTANT
+
+  // The original theorem says empty input returns true. The body mutant
+  // returns false, so this must build and then fail at the reachable result.
+  claim [empty-original-result]:
+        <mpy>
+          <k> Run(mutatedSolutionProgram, "correct_bracketing", "")
+            => boolVal(true) </k>
+          <functions> .Map => ?_FS:Map </functions>
+          <env> .Map => ?_ENV:Map </env>
+        </mpy>
+endmodule
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..03f7fe5d16290eaf2910c86873a954231ea79a94
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,15 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports MPY-VERIFICATION
+
+  // Fresh reviewer mutation: the real program returns true on the satisfying
+  // empty-string input, so requiring false must leave an unmet result.
+  claim [false-empty-result]:
+        <mpy>
+          <k> Run(solutionProgram, "correct_bracketing", "")
+            => boolVal(false) </k>
+          <functions> .Map => ?_FS:Map </functions>
+          <env> .Map => ?_ENV:Map </env>
+        </mpy>
+endmodule
diff --git a/evidence/verification-body-mutant.k b/evidence/verification-body-mutant.k
new file mode 100644
index 0000000000000000000000000000000000000000..3428203846f38d6aa0f7e844fa4780e4da6191ba
--- /dev/null
+++ b/evidence/verification-body-mutant.k
@@ -0,0 +1,22 @@
+requires "verification.k"
+
+module MPY-VERIFICATION-BODY-MUTANT
+  imports MPY-VERIFICATION
+
+  // Reviewer body-sensitivity mutation: initialize count to one.
+  syntax Pgm ::= "mutatedSolutionProgram" [function, total]
+  rule mutatedSolutionProgram =>
+    Module(
+      FuncDef("correct_bracketing", Params("brackets"),
+        Assign(Name("count"), Int(1))
+        For(Name("bracket"), Name("brackets"),
+          If(Compare(Name("bracket"), CmpOp("==", Str("("))),
+            Assign(Name("count"),
+              BinOp("+", Name("count"), Int(1))),
+            If(Compare(Name("count"), CmpOp("==", Int(0))),
+              Return(Bool(false)),
+              .Stmts)
+            Assign(Name("count"),
+              BinOp("-", Name("count"), Int(1)))))
+        Return(Compare(Name("count"), CmpOp("==", Int(0))))))
+endmodule

