    48	          <k> Run(solutionProgram, "correct_bracketing", "()")
    49	            => boolVal(true) </k>
    50	          <functions> .Map => ?_FS:Map </functions> <env> .Map => ?_ENV:Map </env>
    51	        </mpy>
    52	  claim [example-nested]: <mpy>
    53	          <k> Run(solutionProgram, "correct_bracketing", "(()())")
