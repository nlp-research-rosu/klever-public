     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports MPY-VERIFICATION
     5	
     6	  // Loop invariant: at any nonnegative current depth N, executing the
     7	  // remaining characters S and the function's final return computes exactly
     8	  // bracketSpec(N,S).  CURRENT is the loop variable's previous value.
     9	  claim [loop]:
    10	        <mpy>
    11	          <k>
    12	            forLoop("bracket", S:String,
    13	              If(Compare(Name("bracket"), CmpOp("==", Str("("))),
    14	                Assign(Name("count"),
    15	                  BinOp("+", Name("count"), Int(1))),
    16	                If(Compare(Name("count"), CmpOp("==", Int(0))),
    17	                  Return(Bool(false)),
    18	                  .Stmts)
    19	                Assign(Name("count"),
    20	                  BinOp("-", Name("count"), Int(1)))))
    21	            ~> Return(Compare(Name("count"), CmpOp("==", Int(0)))) .Stmts
    22	            => boolVal(bracketSpec(N, S))
    23	          </k>
    24	          <functions> _FS:Map </functions>
    25	          <env>
    26	            "bracket" |-> strVal(_CURRENT:String)
    27	            "brackets" |-> strVal(_ORIGINAL:String)
    28	            "count" |-> intVal(N:Int)
    29	            => ?_FINAL_ENV:Map
    30	          </env>
    31	        </mpy>
    32	        requires N >=Int 0
    33	
    34	  claim [main]:
    35	        <mpy>
    36	          <k> Run(solutionProgram, "correct_bracketing", S:String)
    37	            => boolVal(bracketSpec(0, S)) </k>
    38	          <functions> .Map => ?_FS:Map </functions>
    39	          <env> .Map => ?_ENV:Map </env>
    40	        </mpy>
