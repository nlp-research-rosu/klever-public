     1	// A small, executable semantics for the py2mpy constructors used by
     2	// solution.py.  The Python front end is purely syntactic; all evaluation
     3	// (including String iteration and early return) is defined here.
     4	
     5	module MPY-SYNTAX
     6	  imports INT-SYNTAX
     7	  imports BOOL-SYNTAX
     8	  imports STRING-SYNTAX
     9	
    10	  syntax Pgm ::= "Module" "(" Stmts ")"
    11	               | "Run" "(" Pgm "," String "," String ")"
    12	
    13	  syntax Stmts ::= List{Stmt, ""}
    14	  syntax Params ::= "Params" "(" String ")"
    15	
    16	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
    17	                | "Assign" "(" Expr "," Expr ")"
    18	                | "For" "(" Expr "," Expr "," Stmts ")"
    19	                | "If" "(" Expr "," Stmts "," Stmts ")"
    20	                | "Return" "(" Expr ")"
    21	
    22	  syntax Expr ::= "Name" "(" String ")"
    23	                | "Int" "(" Int ")"
    24	                | "Bool" "(" Bool ")"
    25	                | "Str" "(" String ")"
    26	                | "BinOp" "(" String "," Expr "," Expr ")"
    27	                | "Compare" "(" Expr "," CmpOp ")"
    28	
    29	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    30	endmodule
    31	
    32	module MPY-SEMANTIC
    33	  imports MPY-SYNTAX
    34	  imports INT
    35	  imports BOOL
    36	  imports STRING
    37	  imports MAP
    38	
    39	  syntax Value ::= "intVal" "(" Int ")"
    40	                 | "boolVal" "(" Bool ")"
    41	                 | "strVal" "(" String ")"
    42	  syntax Expr ::= Value
    43	
    44	  syntax Function ::= "function" "(" Params "," Stmts ")"
    45	
    46	  syntax KItem ::= "invoke" "(" String "," Value ")"
    47	                 | "assignTo" "(" String ")"
    48	                 | "ifBranch" "(" Stmts "," Stmts ")"
    49	                 | "binLeft" "(" String "," Expr ")"
    50	                 | "binRight" "(" String "," Value ")"
    51	                 | "compareLeft" "(" CmpOp ")"
    52	                 | "compareRight" "(" String "," Value ")"
    53	                 | "forStart" "(" String "," Stmts ")"
    54	                 | "forLoop" "(" String "," String "," Stmts ")"
    55	                 | "returnNow"
    56	
    57	  configuration
    58	    <mpy>
    59	      <k> $PGM:Pgm </k>
    60	      <functions> .Map </functions>
    61	      <env> .Map </env>
    62	    </mpy>
    63	
    64	  // Module loading and invocation of the one-argument HumanEval entry point.
    65	  rule Run(Module(SS), F, INPUT)
    66	    => Module(SS) ~> invoke(F, strVal(INPUT))
    67	  rule Module(SS) => SS
    68	  rule <k> .Stmts => .K ... </k>
    69	  rule <k> (S:Stmt SS:Stmts) => S ~> SS ... </k>
    70	
    71	  rule <k> FuncDef(F, PS, BODY) => .K ... </k>
    72	       <functions> FS => FS [ F <- function(PS, BODY) ] </functions>
    73	
    74	  rule <k> invoke(F, V) => BODY ... </k>
    75	       <functions> ... F |-> function(Params(P), BODY) ... </functions>
    76	       <env> _ => P |-> V </env>
    77	
    78	  // Literals, variables, arithmetic, and the two equality cases needed here.
    79	  rule Int(I) => intVal(I)
    80	  rule Bool(B) => boolVal(B)
    81	  rule Str(S) => strVal(S)
    82	  rule <k> Name(X) => V ... </k>
    83	       <env> ... X |-> V ... </env>
    84	
    85	  rule BinOp(OP, L, R) => L ~> binLeft(OP, R)
    86	  rule V:Value ~> binLeft(OP, R) => R ~> binRight(OP, V)
    87	  rule intVal(J) ~> binRight("+", intVal(I)) => intVal(I +Int J)
    88	  rule intVal(J) ~> binRight("-", intVal(I)) => intVal(I -Int J)
    89	
    90	  rule Compare(L, C) => L ~> compareLeft(C)
    91	  rule V:Value ~> compareLeft(CmpOp(OP, R))
    92	    => R ~> compareRight(OP, V)
    93	  rule intVal(J) ~> compareRight("==", intVal(I))
    94	    => boolVal(I ==Int J)
    95	  rule strVal(T) ~> compareRight("==", strVal(S))
    96	    => boolVal(S ==String T)
    97	
    98	  // Statements and early function return.
    99	  rule Assign(Name(X), E) => E ~> assignTo(X)
   100	  rule <k> V:Value ~> assignTo(X) => .K ... </k>
   101	       <env> ... X |-> _ => X |-> V ... </env>
   102	  rule <k> V:Value ~> assignTo(X) => .K ... </k>
   103	       <env> ENV => X |-> V ENV </env>
   104	    requires notBool (X in_keys(ENV))
   105	
   106	  rule If(E, THEN, ELSE) => E ~> ifBranch(THEN, ELSE)
   107	  rule boolVal(true)  ~> ifBranch(THEN, _) => THEN
   108	  rule boolVal(false) ~> ifBranch(_, ELSE) => ELSE
   109	
   110	  rule Return(E) => E ~> returnNow
   111	  rule <k> V:Value ~> returnNow ~> _REST => V </k>
   112	
   113	  // Python String iteration.  The loop variable receives one-character
   114	  // strings and the original iterable binding is left untouched.
   115	  rule For(Name(X), E, BODY) => E ~> forStart(X, BODY)
   116	  rule <k> strVal(S) ~> forStart(X, BODY) => forLoop(X, S, BODY) ... </k>
   117	       <env> ... X |-> _ => X |-> strVal("") ... </env>
   118	  rule <k> strVal(S) ~> forStart(X, BODY) => forLoop(X, S, BODY) ... </k>
   119	       <env> ENV => X |-> strVal("") ENV </env>
   120	    requires notBool (X in_keys(ENV))
   121	  rule forLoop(_, "", _) => .K
   122	  rule <k> forLoop(X, S, BODY)
   123	        => BODY
   124	        ~> forLoop(X, substrString(S, 1, lengthString(S)), BODY) ... </k>
   125	       <env> ... X |-> _
   126	        => X |-> strVal(substrString(S, 0, 1)) ... </env>
   127	    requires S =/=String ""
   128	  rule <k> forLoop(X, S, BODY)
   129	        => BODY
   130	        ~> forLoop(X, substrString(S, 1, lengthString(S)), BODY) ... </k>
   131	       <env> ENV
   132	        => X |-> strVal(substrString(S, 0, 1)) ENV </env>
   133	    requires S =/=String ""
   134	     andBool notBool (X in_keys(ENV))
   135	endmodule
   136	
   137	module MPY
   138	  imports MPY-SEMANTIC
   139	endmodule
NUMBERED_VERIFICATION_SOURCE
     1	requires "semantic.k"
     2	
     3	module MPY-VERIFICATION
     4	  imports MPY-SEMANTIC
     5	  imports K-EQUAL
     6	
     7	  // A named, immutable copy of the actual translated solution.  Keeping this
     8	  // in constructor form makes the proof exercise the same AST that krun does.
     9	  syntax Pgm ::= "solutionProgram" [function, total]
    10	  rule solutionProgram =>
    11	    Module(
    12	      FuncDef("correct_bracketing", Params("brackets"),
    13	        Assign(Name("count"), Int(0))
    14	        For(Name("bracket"), Name("brackets"),
    15	          If(Compare(Name("bracket"), CmpOp("==", Str("("))),
    16	            Assign(Name("count"),
    17	              BinOp("+", Name("count"), Int(1))),
    18	            If(Compare(Name("count"), CmpOp("==", Int(0))),
    19	              Return(Bool(false)),
    20	              .Stmts)
    21	            Assign(Name("count"),
    22	              BinOp("-", Name("count"), Int(1)))))
    23	        Return(Compare(Name("count"), CmpOp("==", Int(0))))))
    24	
    25	  // Declarative reference checker.  N is the number of unmatched opening
    26	  // brackets before S.  An empty suffix is accepted exactly at depth zero;
    27	  // '(' increases the depth; every other character is treated as ')' by the
    28	  // implementation.  On the prompt's stated domain { '(', ')' }, this is
    29	  // precisely the usual prefix-nonnegative/final-depth-zero specification.
    30	  syntax Bool ::= "bracketSpec" "(" Int "," String ")" [function, total]
    31	
    32	  rule bracketSpec(N, "") => N ==Int 0 [simplification]
    33	  rule bracketSpec(N, S)
    34	    => bracketSpec(N +Int 1, substrString(S, 1, lengthString(S)))
    35	    requires notBool (S ==String "")
    36	     andBool substrString(S, 0, 1) ==String "(" [simplification]
    37	  rule bracketSpec(0, S) => false
    38	    requires notBool (S ==String "")
    39	     andBool notBool (substrString(S, 0, 1) ==String "(") [simplification]
    40	  rule bracketSpec(N, S)
    41	    => bracketSpec(N -Int 1, substrString(S, 1, lengthString(S)))
    42	    requires notBool (S ==String "")
    43	     andBool notBool (substrString(S, 0, 1) ==String "(")
    44	     andBool N >Int 0 [simplification]
    45	endmodule
