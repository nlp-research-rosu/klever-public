+  "submitted_sha256": "6679593a8ad6af41affa3fe98fe9acd62e1d00f49f869df85c6d414ade518969",
+  "extraction_marker_count": 1,
+  "submitted_kast_module": "MPY-SYNTAX",
+  "submitted_kast_input": "program",
+  "claim_kast_module": "MPY-VERIFICATION",
