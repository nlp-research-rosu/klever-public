def ents(root,dirs):
 out=[]
 for p in root.rglob('*'):
  if p.is_file() or (dirs and p.is_dir()):
   out.append((p.relative_to(root).as_posix(), 'directory' if p.is_dir() else 'file', p))
 return sorted(out)

def piece(rel,kind,p,pathmode,kindmode,sizemode,datamode,sep):
 fields=[]
 if pathmode=='plain': fields.append(rel.encode())
 elif pathmode=='nul': fields.append(rel.encode()+b'\\0')
 elif pathmode=='len4': fields.append(len(rel.encode()).to_bytes(4,'big')+rel.encode())
 elif pathmode=='json': fields.append(json.dumps(rel,separators=(',',':')).encode())
 if kindmode=='plain': fields.append(kind.encode())
 elif kindmode=='nul': fields.append(kind.encode()+b'\\0')
 elif kindmode=='short': fields.append((b'd' if kind=='directory' else b'f'))
 if kind=='file':
  data=p.read_bytes()
  if sizemode=='ascii': fields.append(str(len(data)).encode())
  elif sizemode=='nul': fields.append(str(len(data)).encode()+b'\\0')
  elif sizemode=='u64be': fields.append(len(data).to_bytes(8,'big'))
  if datamode=='raw': fields.append(data)
  elif datamode=='hex': fields.append(hashlib.sha256(data).hexdigest().encode())
  elif datamode=='bin': fields.append(hashlib.sha256(data).digest())
 return sep.join(fields)
opts=itertools.product([False,True],['plain','nul','len4','json'],['none','plain','nul','short'],['none','ascii','nul','u64be'],['raw','hex','bin'],[b'',b'\\0',b'\\n'])
