     hashes.append(hashlib.sha256(json.dumps(es,sort_keys=sk,separators=(',',':') if co else None).encode()).hexdigest())
    if hashes==targets: print('JSON MATCH',dirs,shape,sk,co); raise SystemExit
print('no json match')
