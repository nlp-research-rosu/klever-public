+$ export PATH="$HOME/.nix-profile/bin:$PATH"; kprove /audit-output/evidence/04_body_sensitivity.k --definition proof-kompiled --spec-module BODY-SENSITIVITY -I .
+kore-exec: [279738] Warning (WarnStuckClaimState):
+    The configuration's term doesn't unify with the destination's term and the
+    configuration cannot be rewritten further.
+Context:
+    <mpy>
+      <k> boolVal ( false ) ~> .K </k>
+      <functions>
+        "correct_bracketing" |-> function (... Assign (Name("count"), Int(1)) ...)
+      </functions>
+      <env>
+        "bracket" |-> strVal ( "" )
+        "brackets" |-> strVal ( "" )
+        "count" |-> intVal ( 1 )
+      </env>
