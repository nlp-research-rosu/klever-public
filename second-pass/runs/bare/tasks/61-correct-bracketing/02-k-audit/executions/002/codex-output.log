    if shape==0: es.append([rel,hv])
    elif shape==1: es.append([rel,kind,hv])
    elif shape==2: es.append({'path':rel,'sha256':hv})
    elif shape==3: es.append({'path':rel,'type':kind,'sha256':hv})
    elif shape==4: es.append({'relative_path':rel,'kind':kind,'sha256':hv})
    else: es.append({'name':rel,'kind':kind,'size':p.stat().st_size if kind=='file' else 0,'sha256':hv})
   for sort_keys in [False,True]:
    for compact in [False,True]:
     s=json.dumps(es,sort_keys=sort_keys,separators=(',',':') if compact else None).encode()
     vals.append((hashlib.sha256(s).hexdigest(),sort_keys,compact))
  for i,(hv,sk,co) in enumerate(vals[:4]):
   pass
