      "end_line": 23,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "ff38bf4352a9d5177710fc8cdb52e149480f3430cbb3889ae520f039fdd1caaf",
      "source_rule_id": "rule-ff38bf4352a9d5177710fc8cdb52e149480f3430cbb3889ae520f039fdd1caaf",
      "start_line": 10,
      "text": "  rule solutionProgram =>\n    Module(\n      FuncDef(\"correct_bracketing\", Params(\"brackets\"),\n        Assign(Name(\"count\"), Int(0))\n        For(Name(\"bracket\"), Name(\"brackets\"),\n          If(Compare(Name(\"bracket\"), CmpOp(\"==\", Str(\"(\"))),\n            Assign(Name(\"count\"),\n              BinOp(\"+\", Name(\"count\"), Int(1))),\n            If(Compare(Name(\"count\"), CmpOp(\"==\", Int(0))),\n              Return(Bool(false)),\n              .Stmts)\n            Assign(Name(\"count\"),\n              BinOp(\"-\", Name(\"count\"), Int(1)))))\n        Return(Compare(Name(\"count\"), CmpOp(\"==\", Int(0))))))"
    },
    {
      "attributes": [
        "simplification"
      ],
      "end_line": 32,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "52c678867274bfbe50cfd8894cb300d08fb5f3a018c416a200e725d66ad1ffb7",
      "source_rule_id": "rule-52c678867274bfbe50cfd8894cb300d08fb5f3a018c416a200e725d66ad1ffb7",
      "start_line": 32,
      "text": "  rule bracketSpec(N, \"\") => N ==Int 0 [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "end_line": 36,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "0b80080b9a7dd4f80716f34190b5a512ffa576526b020733d3a661e68720cea9",
      "source_rule_id": "rule-0b80080b9a7dd4f80716f34190b5a512ffa576526b020733d3a661e68720cea9",
      "start_line": 33,
      "text": "  rule bracketSpec(N, S)\n    => bracketSpec(N +Int 1, substrString(S, 1, lengthString(S)))\n    requires notBool (S ==String \"\")\n     andBool substrString(S, 0, 1) ==String \"(\" [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "end_line": 39,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "dab3458a72db386dbad39915bdb52a22d7ee1cccd37c33aa1b8b984a02af13f4",
      "source_rule_id": "rule-dab3458a72db386dbad39915bdb52a22d7ee1cccd37c33aa1b8b984a02af13f4",
      "start_line": 37,
      "text": "  rule bracketSpec(0, S) => false\n    requires notBool (S ==String \"\")\n     andBool notBool (substrString(S, 0, 1) ==String \"(\") [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "end_line": 44,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "2877c405b261ca01cd0ba4ed8be5aa27101f1fbd6c09d33fb7d78416ef4c6968",
      "source_rule_id": "rule-2877c405b261ca01cd0ba4ed8be5aa27101f1fbd6c09d33fb7d78416ef4c6968",
      "start_line": 40,
      "text": "  rule bracketSpec(N, S)\n    => bracketSpec(N -Int 1, substrString(S, 1, lengthString(S)))\n    requires notBool (S ==String \"\")\n     andBool notBool (substrString(S, 0, 1) ==String \"(\")\n     andBool N >Int 0 [simplification]"
    }
