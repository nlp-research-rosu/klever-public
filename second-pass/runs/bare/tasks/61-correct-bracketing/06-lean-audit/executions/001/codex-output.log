+    allowlisted[name] = (entry["kind"], entry["type"])
+assert declared == allowlisted
+assert trust_inventory["designated_sorries"] == 0
+assert trust_inventory["other_sorries"] == 0
+print(f"generated_trust_declarations={len(declared)}")
