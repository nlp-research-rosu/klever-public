bash -c 'exec -a lean /opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean --version'
bash -c 'exec -a /opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean /opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean --version'
