+            Assign(Name("count"),
+              BinOp("+", Name("count"), Int(1))),
+            If(Compare(Name("count"), CmpOp("==", Int(0))),
+              Return(Bool(false)),
+              .Stmts)
+            Assign(Name("count"),
+              BinOp("-", Name("count"), Int(1)))))
