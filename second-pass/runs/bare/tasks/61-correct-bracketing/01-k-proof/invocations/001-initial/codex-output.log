+     andBool N >Int 0 [simplification]
+endmodule

exec
/bin/bash -lc 'kompile semantic.k --main-module MPY --syntax-module MPY-SYNTAX --backend haskell && kprove spec.k --definition semantic-kompiled --spec-module SPEC -I . --claims SPEC.loop' in /work
