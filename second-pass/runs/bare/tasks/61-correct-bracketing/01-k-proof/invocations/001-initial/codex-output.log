```

Equality and conditionals
-------------------------

Provided here are implementations of two important primitives in K:

* `==K` - the equality between two terms. Returns `true` if they are equal
  and `false` if they are not equal.
* `#if #then #else #fi` - polymorphic conditional function. If the first
  argument evaluates to `true`, the second argument is returned. Otherwise,
  the third argument is returned. Note that this does not short-circuit on
  symbolic backends.

```k
module K-EQUAL-SYNTAX
  imports private BOOL
  imports private BASIC-K

  syntax Bool ::= left:
                  K "==K" K           [function, total, comm, smt-hook(=), hook(KEQUAL.eq), symbol(_==K_), group(equalEqualK)]
                | K "=/=K" K          [function, total, comm, smt-hook(distinct), hook(KEQUAL.ne), symbol(_=/=K_), group(notEqualEqualK)]

  syntax priority equalEqualK notEqualEqualK > boolOperation mlOp

  syntax {Sort} Sort ::= "#if" Bool "#then" Sort "#else" Sort "#fi" [function, total, symbol(ite), smt-hook(ite), hook(KEQUAL.ite)]

endmodule

module K-EQUAL-KORE [symbolic]
  imports private BOOL
  imports K-EQUAL-SYNTAX

  rule K1:Bool ==K K2:Bool => K1 ==Bool K2 [simplification]
  rule {K1 ==K K2 #Equals true} => {K1 #Equals K2} [simplification]
  rule {true #Equals K1 ==K K2} => {K1 #Equals K2} [simplification]
  rule {K1 ==K K2 #Equals false} => #Not({K1 #Equals K2}) [simplification]
  rule {false #Equals K1 ==K K2} => #Not({K1 #Equals K2}) [simplification]
  rule {K1 =/=K K2 #Equals true} => #Not({K1 #Equals K2}) [simplification]
  rule {true #Equals K1 =/=K K2} => #Not({K1 #Equals K2}) [simplification]
  rule {K1 =/=K K2 #Equals false} => {K1 #Equals K2} [simplification]
  rule {false #Equals K1 =/=K K2} => {K1 #Equals K2} [simplification]

endmodule

module K-EQUAL
  imports private BOOL
  imports K-EQUAL-SYNTAX
  imports K-EQUAL-KORE

  rule K1:K =/=K K2:K => notBool (K1 ==K K2)

  rule #if C:Bool #then B1::K #else _ #fi => B1 requires C
  rule #if C:Bool #then _ #else B2::K #fi => B2 requires notBool C

endmodule
```

Meta operations
---------------

newline, and carriage return. K also supports the following escape sequences:

* \" - the " character
* \\ - the \ character
* \n - newline character
* \r - carriage return character
* \t - tab character
* \f - form feed character
* \xFF - \x followed by two hexadecimal characters indicates a code point
  between 0x00 and 0xff
* \uFFFF - \u followed by four hexadecimal characters indicates a code point
  between 0x0000 and 0xffff
* \UFFFFFFFF - \U followed by eight hexadecimal characters indicates a code
  point between 0x000000 and 0x10ffff

```k
module STRING-SYNTAX
  syntax String [hook(STRING.String)]
  syntax String ::= r"[\\\"](([^\\\"\\n\\r\\\\])|([\\\\][nrtf\\\"\\\\])|([\\\\][x][0-9a-fA-F]{2})|([\\\\][u][0-9a-fA-F]{4})|([\\\\][U][0-9a-fA-F]{8}))*[\\\"]"      [token]
endmodule

module STRING-COMMON
  imports STRING-SYNTAX
  imports private INT
  imports private FLOAT-SYNTAX
  imports private K-EQUAL
  imports private BOOL
```

### String concatenation

You can concatenate two strings in O(N) time. For successive concatenation
operations, it may be better to use the `STRING-BUFFER` module.

```k
  syntax String ::= String "+String" String    [function, total, left, hook(STRING.concat)]
```

### String length

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..38fd4880b7fbf314ef0dfdbb860786858e8fda26
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,127 @@
+// A small, executable semantics for the py2mpy constructors used by
+// solution.py.  The Python front end is purely syntactic; all evaluation
+// (including String iteration and early return) is defined here.
+
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+               | "Run" "(" Pgm "," String "," String ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Str" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  syntax Value ::= "intVal" "(" Int ")"
+                 | "boolVal" "(" Bool ")"
+                 | "strVal" "(" String ")"
+  syntax Expr ::= Value
+
+  syntax Function ::= "function" "(" Params "," Stmts ")"
+
+  syntax KItem ::= "invoke" "(" String "," Value ")"
+                 | "assignTo" "(" String ")"
+                 | "ifBranch" "(" Stmts "," Stmts ")"
+                 | "binLeft" "(" String "," Expr ")"
+                 | "binRight" "(" String "," Value ")"
+                 | "compareLeft" "(" CmpOp ")"
+                 | "compareRight" "(" String "," Value ")"
+                 | "forStart" "(" String "," Stmts ")"
+                 | "forLoop" "(" String "," String "," Stmts ")"
+                 | "returnNow"
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+    </mpy>
+
+  // Module loading and invocation of the one-argument HumanEval entry point.
+  rule Run(Module(SS), F, INPUT)
+    => Module(SS) ~> invoke(F, strVal(INPUT))
+  rule Module(SS) => SS
+  rule <k> .Stmts => .K ... </k>
+  rule <k> (S:Stmt SS:Stmts) => S ~> SS ... </k>
+
+  rule <k> FuncDef(F, PS, BODY) => .K ... </k>
+       <functions> FS => FS [ F <- function(PS, BODY) ] </functions>
+
+  rule <k> invoke(F, V) => BODY ... </k>
+       <functions> ... F |-> function(Params(P), BODY) ... </functions>
+       <env> _ => P |-> V </env>
+
+  // Literals, variables, arithmetic, and the two equality cases needed here.
+  rule Int(I) => intVal(I)
+  rule Bool(B) => boolVal(B)
+  rule Str(S) => strVal(S)
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V ... </env>
+
+  rule BinOp(OP, L, R) => L ~> binLeft(OP, R)
+  rule V:Value ~> binLeft(OP, R) => R ~> binRight(OP, V)
+  rule intVal(J) ~> binRight("+", intVal(I)) => intVal(I +Int J)
+  rule intVal(J) ~> binRight("-", intVal(I)) => intVal(I -Int J)
+
+  rule Compare(L, C) => L ~> compareLeft(C)
+  rule V:Value ~> compareLeft(CmpOp(OP, R))
+    => R ~> compareRight(OP, V)
+  rule intVal(J) ~> compareRight("==", intVal(I))
+    => boolVal(I ==Int J)
+  rule strVal(T) ~> compareRight("==", strVal(S))
+    => boolVal(S ==String T)
+
+  // Statements and early function return.
+  rule Assign(Name(X), E) => E ~> assignTo(X)
+  rule <k> V:Value ~> assignTo(X) => .K ... </k>
+       <env> ENV => ENV [ X <- V ] </env>
+
+  rule If(E, THEN, ELSE) => E ~> ifBranch(THEN, ELSE)
+  rule boolVal(true)  ~> ifBranch(THEN, _) => THEN
+  rule boolVal(false) ~> ifBranch(_, ELSE) => ELSE
+
+  rule Return(E) => E ~> returnNow
+  rule <k> V:Value ~> returnNow ~> _REST => V </k>
+
+  // Python String iteration.  The loop variable receives one-character
+  // strings and the original iterable binding is left untouched.
+  rule For(Name(X), E, BODY) => E ~> forStart(X, BODY)
+  rule strVal(S) ~> forStart(X, BODY) => forLoop(X, S, BODY)
+  rule forLoop(_, "", _) => .K
+  rule <k> forLoop(X, S, BODY)
+        => BODY
+        ~> forLoop(X, substrString(S, 1, lengthString(S)), BODY) ... </k>
+       <env> ENV
+        => ENV [ X <- strVal(substrString(S, 0, 1)) ] </env>
+    requires S =/=String ""
+endmodule
+
+module MPY
+  imports MPY-VERIFICATION
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..acc687f47a41609145fcc406fb9506ebc374ecbd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def correct_bracketing(brackets: str):
+    count = 0
+    for bracket in brackets:
+        if bracket == "(":
+            count = count + 1
+        else:
+            if count == 0:
+                return False
+            count = count - 1
+    return count == 0
