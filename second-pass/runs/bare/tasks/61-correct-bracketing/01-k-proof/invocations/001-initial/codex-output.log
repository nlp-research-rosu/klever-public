index 0000000000000000000000000000000000000000..03906a7b422d1f75dd7470d76805a6199406c9bd
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Regenerate the constructor AST and check the Python implementation.
+python3 py2mpy.py solution.py > solution.mpy
+python3 -m py_compile solution.py
+
+# Concrete execution uses the fast LLVM backend.  Each Run term embeds the
+# freshly regenerated solution.mpy, so these are executions of the delivered
+# translated program rather than a hand-written surrogate.
+kompile semantic.k --main-module MPY --syntax-module MPY-SYNTAX --backend llvm
+
+run_case() {
+  local input="$1"
+  local expected="$2"
+  local program
+  local output
+  program="Run($(tr '\n' ' ' < solution.mpy), \"correct_bracketing\", \"${input}\")"
+  output="$(krun --definition semantic-kompiled -cPGM="${program}" --output pretty)"
+  printf '%s\n' "${output}"
+  printf '%s\n' "${output}" | grep -q "boolVal ( ${expected} )"
+}
+
+run_case "(" false
+run_case "()" true
+run_case "(()())" true
+run_case ")(()" false
+
+# The Haskell backend proves the symbolic loop invariant first.  The second
+# command proves every claim, using that exact already-proved invariant as a
+# lemma; both required positive proof commands must print #Top and exit zero.
+kompile semantic.k --main-module MPY --syntax-module MPY-SYNTAX --backend haskell
+kprove spec.k --definition semantic-kompiled --spec-module SPEC -I . \
+  --claims SPEC.loop
+kprove spec.k --definition semantic-kompiled --spec-module SPEC -I . \
+  --trusted SPEC.loop
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..022197e95e1422a6899ea5c76c5b518d9442fb46
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,141 @@
+// A small, executable semantics for the py2mpy constructors used by
+// solution.py.  The Python front end is purely syntactic; all evaluation
+// (including String iteration and early return) is defined here.
+
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmts ")"
+               | "Run" "(" Pgm "," String "," String ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Str" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  syntax Value ::= "intVal" "(" Int ")"
+                 | "boolVal" "(" Bool ")"
+                 | "strVal" "(" String ")"
+  syntax Expr ::= Value
+
+  syntax Function ::= "function" "(" Params "," Stmts ")"
+
+  syntax KItem ::= "invoke" "(" String "," Value ")"
+                 | "assignTo" "(" String ")"
+                 | "ifBranch" "(" Stmts "," Stmts ")"
+                 | "binLeft" "(" String "," Expr ")"
+                 | "binRight" "(" String "," Value ")"
+                 | "compareLeft" "(" CmpOp ")"
+                 | "compareRight" "(" String "," Value ")"
+                 | "forStart" "(" String "," Stmts ")"
+                 | "forLoop" "(" String "," String "," Stmts ")"
+                 | "returnNow"
+
+  configuration
+    <mpy>
+      <k> $PGM:Pgm </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+    </mpy>
+
+  // Module loading and invocation of the one-argument HumanEval entry point.
+  rule Run(Module(SS), F, INPUT)
+    => Module(SS) ~> invoke(F, strVal(INPUT))
+  rule Module(SS) => SS
+  rule <k> .Stmts => .K ... </k>
+  rule <k> (S:Stmt SS:Stmts) => S ~> SS ... </k>
+
+  rule <k> FuncDef(F, PS, BODY) => .K ... </k>
+       <functions> FS => FS [ F <- function(PS, BODY) ] </functions>
+
+  rule <k> invoke(F, V) => BODY ... </k>
+       <functions> ... F |-> function(Params(P), BODY) ... </functions>
+       <env> _ => P |-> V </env>
+
+  // Literals, variables, arithmetic, and the two equality cases needed here.
+  rule Int(I) => intVal(I)
+  rule Bool(B) => boolVal(B)
+  rule Str(S) => strVal(S)
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V ... </env>
+
+  rule BinOp(OP, L, R) => L ~> binLeft(OP, R)
+  rule V:Value ~> binLeft(OP, R) => R ~> binRight(OP, V)
+  rule intVal(J) ~> binRight("+", intVal(I)) => intVal(I +Int J)
+  rule intVal(J) ~> binRight("-", intVal(I)) => intVal(I -Int J)
+
+  rule Compare(L, C) => L ~> compareLeft(C)
+  rule V:Value ~> compareLeft(CmpOp(OP, R))
+    => R ~> compareRight(OP, V)
+  rule intVal(J) ~> compareRight("==", intVal(I))
+    => boolVal(I ==Int J)
+  rule strVal(T) ~> compareRight("==", strVal(S))
+    => boolVal(S ==String T)
+
+  // Statements and early function return.
+  rule Assign(Name(X), E) => E ~> assignTo(X)
+  rule <k> V:Value ~> assignTo(X) => .K ... </k>
+       <env> ... X |-> _ => X |-> V ... </env>
+  rule <k> V:Value ~> assignTo(X) => .K ... </k>
+       <env> ENV => X |-> V ENV </env>
+    requires notBool (X in_keys(ENV))
+
+  rule If(E, THEN, ELSE) => E ~> ifBranch(THEN, ELSE)
+  rule boolVal(true)  ~> ifBranch(THEN, _) => THEN
+  rule boolVal(false) ~> ifBranch(_, ELSE) => ELSE
+
+  rule Return(E) => E ~> returnNow
+  rule <k> V:Value ~> returnNow ~> _REST => V </k>
+
+  // Python String iteration.  The loop variable receives one-character
+  // strings and the original iterable binding is left untouched.
+  rule For(Name(X), E, BODY) => E ~> forStart(X, BODY)
+  rule <k> strVal(S) ~> forStart(X, BODY) => forLoop(X, S, BODY) ... </k>
+       <env> ... X |-> _ => X |-> strVal("") ... </env>
+  rule <k> strVal(S) ~> forStart(X, BODY) => forLoop(X, S, BODY) ... </k>
+       <env> ENV => X |-> strVal("") ENV </env>
+    requires notBool (X in_keys(ENV))
+  rule forLoop(_, "", _) => .K
+  rule <k> forLoop(X, S, BODY)
+        => BODY
+        ~> forLoop(X, substrString(S, 1, lengthString(S)), BODY) ... </k>
+       <env> ... X |-> _
+        => X |-> strVal(substrString(S, 0, 1)) ... </env>
+    requires S =/=String ""
+  rule <k> forLoop(X, S, BODY)
+        => BODY
+        ~> forLoop(X, substrString(S, 1, lengthString(S)), BODY) ... </k>
+       <env> ENV
+        => X |-> strVal(substrString(S, 0, 1)) ENV </env>
+    requires S =/=String ""
+     andBool notBool (X in_keys(ENV))
+endmodule
+
+module MPY
+  imports MPY-VERIFICATION
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..acc687f47a41609145fcc406fb9506ebc374ecbd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def correct_bracketing(brackets: str):
+    count = 0
+    for bracket in brackets:
+        if bracket == "(":
+            count = count + 1
+        else:
+            if count == 0:
+                return False
+            count = count - 1
+    return count == 0
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..dcf2bfa2b5764664170b75f4b776643bbc5adc36
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,62 @@
+requires "verification.k"
+
+module SPEC
+  imports MPY-VERIFICATION
+
+  // Loop invariant: at any nonnegative current depth N, executing the
+  // remaining characters S and the function's final return computes exactly
+  // bracketSpec(N,S).  CURRENT is the loop variable's previous value.
+  claim [loop]:
+        <mpy>
+          <k>
+            forLoop("bracket", S:String,
+              If(Compare(Name("bracket"), CmpOp("==", Str("("))),
+                Assign(Name("count"),
+                  BinOp("+", Name("count"), Int(1))),
+                If(Compare(Name("count"), CmpOp("==", Int(0))),
+                  Return(Bool(false)),
+                  .Stmts)
+                Assign(Name("count"),
+                  BinOp("-", Name("count"), Int(1)))))
+            ~> Return(Compare(Name("count"), CmpOp("==", Int(0)))) .Stmts
+            => boolVal(bracketSpec(N, S))
+          </k>
+          <functions> _FS:Map </functions>
+          <env>
+            "bracket" |-> strVal(_CURRENT:String)
+            "brackets" |-> strVal(_ORIGINAL:String)
+            "count" |-> intVal(N:Int)
+            => ?_FINAL_ENV:Map
+          </env>
+        </mpy>
+        requires N >=Int 0
+
+  claim [main]:
+        <mpy>
+          <k> Run(solutionProgram, "correct_bracketing", S:String)
+            => boolVal(bracketSpec(0, S)) </k>
+          <functions> .Map => ?_FS:Map </functions>
+          <env> .Map => ?_ENV:Map </env>
+        </mpy>
+
+  claim [example-open]: <mpy>
+          <k> Run(solutionProgram, "correct_bracketing", "(")
+            => boolVal(false) </k>
+          <functions> .Map => ?_FS:Map </functions> <env> .Map => ?_ENV:Map </env>
+        </mpy>
+  claim [example-pair]: <mpy>
+          <k> Run(solutionProgram, "correct_bracketing", "()")
+            => boolVal(true) </k>
+          <functions> .Map => ?_FS:Map </functions> <env> .Map => ?_ENV:Map </env>
+        </mpy>
+  claim [example-nested]: <mpy>
+          <k> Run(solutionProgram, "correct_bracketing", "(()())")
+            => boolVal(true) </k>
+          <functions> .Map => ?_FS:Map </functions> <env> .Map => ?_ENV:Map </env>
+        </mpy>
+  claim [example-bad-prefix]: <mpy>
+          <k> Run(solutionProgram, "correct_bracketing", ")(()")
+            => boolVal(false) </k>
+          <functions> .Map => ?_FS:Map </functions> <env> .Map => ?_ENV:Map </env>
+        </mpy>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4e944cff16dea86e2ef5596e62d1830319d2a2c3
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,43 @@
+module MPY-VERIFICATION
+  imports MPY-SEMANTIC
+  imports K-EQUAL
+
+  // A named, immutable copy of the actual translated solution.  Keeping this
+  // in constructor form makes the proof exercise the same AST that krun does.
+  syntax Pgm ::= "solutionProgram" [function, total]
+  rule solutionProgram =>
+    Module(
+      FuncDef("correct_bracketing", Params("brackets"),
+        Assign(Name("count"), Int(0))
+        For(Name("bracket"), Name("brackets"),
+          If(Compare(Name("bracket"), CmpOp("==", Str("("))),
+            Assign(Name("count"),
+              BinOp("+", Name("count"), Int(1))),
+            If(Compare(Name("count"), CmpOp("==", Int(0))),
+              Return(Bool(false)),
+              .Stmts)
+            Assign(Name("count"),
+              BinOp("-", Name("count"), Int(1)))))
+        Return(Compare(Name("count"), CmpOp("==", Int(0))))))
+
+  // Declarative reference checker.  N is the number of unmatched opening
+  // brackets before S.  An empty suffix is accepted exactly at depth zero;
+  // '(' increases the depth; every other character is treated as ')' by the
+  // implementation.  On the prompt's stated domain { '(', ')' }, this is
+  // precisely the usual prefix-nonnegative/final-depth-zero specification.
+  syntax Bool ::= "bracketSpec" "(" Int "," String ")" [function, total]
+
+  rule bracketSpec(N, "") => N ==Int 0 [simplification]
+  rule bracketSpec(N, S)
+    => bracketSpec(N +Int 1, substrString(S, 1, lengthString(S)))
+    requires notBool (S ==String "")
+     andBool substrString(S, 0, 1) ==String "(" [simplification]
+  rule bracketSpec(0, S) => false
+    requires notBool (S ==String "")
+     andBool notBool (substrString(S, 0, 1) ==String "(") [simplification]
+  rule bracketSpec(N, S)
+    => bracketSpec(N -Int 1, substrString(S, 1, lengthString(S)))
+    requires notBool (S ==String "")
+     andBool notBool (substrString(S, 0, 1) ==String "(")
+     andBool N >Int 0 [simplification]
+endmodule

