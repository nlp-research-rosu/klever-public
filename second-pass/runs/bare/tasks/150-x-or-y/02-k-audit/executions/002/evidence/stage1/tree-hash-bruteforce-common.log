COMMAND: python3 -c $'import hashlib,itertools,os,stat; from pathlib import Path\nroot=Path("/generation-evidence/codex-trace"); target="228812a5b541894590ab233f2089782a162f3da8c8c597569c237f19668bb5ae"; ents=[]\nfor p in sorted(root.rglob("*")):\n k="d" if p.is_dir() else "f"; r=p.relative_to(root).as_posix(); b=p.read_bytes() if k=="f" else b""; ents.append((r,k,b,p.stat()))\nseps=[b"",b"\\\\0",b"\\\\n",b":",b" "]\npaths=[lambda r:""+r,lambda r:"./"+r,lambda r:"/"+r]\nkinds=[lambda k:b"",lambda k:k.encode(),lambda k:(b"file" if k=="f" else b"directory"),lambda k:(b"blob" if k=="f" else b"tree")]\ncontents=[lambda b:b,lambda b:hashlib.sha256(b).digest(),lambda b:hashlib.sha256(b).hexdigest().encode(),lambda b:str(len(b)).encode()+b,lambda b:len(b).to_bytes(8,"big")+b]\nfor incdirs,pf,kf,cf,s1,s2,s3 in itertools.product([False,True],paths,kinds,contents,seps,seps,seps):\n d=hashlib.sha256()\n for r,k,b,st in ents:\n  if k=="d" and not incdirs: continue\n  d.update(pf(r).encode()+s1+kf(k)+s2)\n  if k=="f": d.update(cf(b))\n  d.update(s3)\n if d.hexdigest()==target: print("MATCH",incdirs,paths.index(pf),kinds.index(kf),contents.index(cf),seps.index(s1),seps.index(s2),seps.index(s3)); raise SystemExit\nprint("NO_COMMON_MATCH")'
