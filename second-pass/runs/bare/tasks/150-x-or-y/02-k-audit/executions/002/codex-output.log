+  exit 64
+fi
+
+log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} >"$log"
+
+set +e
+"$@" > >(tee -a "$log") 2> >(tee -a "$log" >&2)
+status=$?
+set -e
+
+printf 'EXIT_STATUS: %d\n' "$status" | tee -a "$log"
+exit "$status"

