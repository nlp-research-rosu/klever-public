     1	# canonical.py — the UNMODIFIED HumanEval/150 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: x_or_y
     4	
     5	
     6	def x_or_y(n, x, y):
     7	    """A simple program which should return the value of x if n is 
     8	    a prime number and should return the value of y otherwise.
     9	
    10	    Examples:
    11	    for x_or_y(7, 34, 12) == 34
    12	    for x_or_y(15, 8, 5) == 5
    13	    
    14	    """
    15	    if n == 1:
    16	        return y
    17	    for i in range(2, n):
    18	        if n % i == 0:
    19	            return y
    20	            break
    21	    else:
    22	        return x
FILE /candidate/solution.py
     1	def x_or_y(n, x, y):
     2	    if n < 2:
     3	        return y
     4	    divisor = 2
     5	    while divisor * divisor <= n:
     6	        if n % divisor == 0:
     7	            return y
     8	        divisor = divisor + 1
     9	    return x
FILE /candidate/solution.mpy
     1	Module(
     2	  FuncDef("x_or_y", Params("n", "x", "y"),
     3	    If(Compare(Name("n"), CmpOp("<", Int(2))),
     4	      Return(Name("y")),
     5	      )
     6	    Assign(Name("divisor"), Int(2))
     7	    While(Compare(
     8	      BinOp("*", Name("divisor"), Name("divisor")),
     9	      CmpOp("<=", Name("n"))),
    10	      If(Compare(
    11	        BinOp("%", Name("n"), Name("divisor")),
    12	        CmpOp("==", Int(0))),
    13	        Return(Name("y")),
    14	        )
    15	      Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
    16	    Return(Name("x"))))
