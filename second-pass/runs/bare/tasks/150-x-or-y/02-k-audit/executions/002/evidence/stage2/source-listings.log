FILE /candidate/prove.sh
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd "$(dirname "$0")"
     5	
     6	# Regenerate the constructor term with the fixed translator.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	
     9	# Concrete execution uses the LLVM backend.
    10	kompile semantic.k \
    11	  --backend llvm \
    12	  --main-module MPY \
    13	  --syntax-module MPY-SYNTAX \
    14	  --output-definition llvm-kompiled
    15	
    16	krun solution.mpy --definition llvm-kompiled -cN=7 -cX=34 -cY=12
    17	krun solution.mpy --definition llvm-kompiled -cN=15 -cX=8 -cY=5
    18	krun solution.mpy --definition llvm-kompiled -cN=97 -cX=11 -cY=22
    19	krun solution.mpy --definition llvm-kompiled -cN=121 -cX=11 -cY=22
    20	
    21	# Symbolic execution and reachability proofs use the Haskell backend.
    22	kompile verification.k \
    23	  --backend haskell \
    24	  --main-module MPY-VERIFICATION \
    25	  --syntax-module MPY-SYNTAX \
    26	  --output-definition verification-kompiled
    27	
    28	# First prove the generalized loop invariant, then use that proved claim to
    29	# establish the universal entry-point theorem and both prompt examples.
    30	kprove spec.k \
    31	  --definition verification-kompiled \
    32	  --spec-module LOOP-SPEC
    33	
    34	kprove spec.k \
    35	  --definition verification-kompiled \
    36	  --spec-module SPEC
