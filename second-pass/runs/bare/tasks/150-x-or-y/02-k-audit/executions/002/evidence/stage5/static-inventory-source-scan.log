semantic.k:25:module MPY
semantic.k:26:  imports MPY-SYNTAX
semantic.k:28:  syntax Val ::= intVal(Int) | boolVal(Bool)
semantic.k:30:  syntax KItem ::= exec(Stmts)
semantic.k:41:  configuration
semantic.k:51:  rule <k> Module(FuncDef("x_or_y", Params("n", "x", "y"), BODY))
semantic.k:62:  rule exec(.Stmts) => .K
semantic.k:63:  rule exec(S:Stmt SS:Stmts) => S ~> exec(SS)
semantic.k:65:  rule If(COND, THEN, ELSE) => eval(COND) ~> branch(THEN, ELSE, .Stmts)
semantic.k:66:  rule While(COND, BODY) => eval(COND) ~> whileBranch(COND, BODY, .Stmts)
semantic.k:67:  rule Assign(Name(A), E) => eval(E) ~> store(A)
semantic.k:68:  rule Return(E) => eval(E) ~> doReturn
semantic.k:70:  rule boolVal(true) ~> branch(THEN, _ELSE, REST)
semantic.k:72:  rule boolVal(false) ~> branch(_THEN, ELSE, REST)
semantic.k:75:  rule boolVal(true) ~> whileBranch(COND, BODY, REST)
semantic.k:77:  rule boolVal(false) ~> whileBranch(_COND, _BODY, REST)
semantic.k:80:  rule <k> V:Val ~> store(A) => .K ...</k>
semantic.k:83:  rule <k> V:Val ~> doReturn ~> _REST => .K </k>
semantic.k:86:  rule eval(Int(I)) => intVal(I)
semantic.k:87:  rule <k> eval(Name(A)) => V ...</k>
semantic.k:90:  rule eval(BinOp(OP, LEFT, RIGHT))
semantic.k:92:  rule intVal(I) ~> binLeft(OP, RIGHT)
semantic.k:94:  rule intVal(J) ~> binApply("+", I) => intVal(I +Int J)
semantic.k:95:  rule intVal(J) ~> binApply("*", I) => intVal(I *Int J)
semantic.k:96:  rule intVal(J) ~> binApply("%", I) => intVal(I %Int J)
semantic.k:99:  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)))
semantic.k:101:  rule intVal(I) ~> cmpLeft(OP, RIGHT)
semantic.k:103:  rule intVal(J) ~> cmpApply("<", I) => boolVal(I <Int J)
semantic.k:104:  rule intVal(J) ~> cmpApply("<=", I) => boolVal(I <=Int J)
semantic.k:105:  rule intVal(J) ~> cmpApply("==", I) => boolVal(I ==Int J)
semantic.k:106:endmodule
