verification.k:8:  syntax Bool ::= primeFrom(Int, Int) [function]
verification.k:9:  rule primeFrom(N, D) => true
verification.k:11:  rule primeFrom(N, D) => false
verification.k:13:  rule primeFrom(N, D) => primeFrom(N, D +Int 1)
