semantic.k:1:module MPY-SYNTAX
semantic.k:2:  imports INT
semantic.k:3:  imports BOOL
semantic.k:4:  imports STRING
semantic.k:5:  imports MAP
semantic.k:7:  syntax Program ::= "Module" "(" Stmts ")"
semantic.k:9:  syntax Stmts ::= List{Stmt, ""}
semantic.k:10:  syntax Stmt ::= "FuncDef" "(" String "," "Params" "(" Ids ")" "," Stmts ")"
semantic.k:16:  syntax Ids ::= List{String, ","}
semantic.k:17:  syntax Expr ::= "Int" "(" Int ")"
semantic.k:21:  syntax CmpOps ::= List{CmpOp, ","}
