index 0000000000000000000000000000000000000000..49b3a96f00df8a3c94b720ba4fc98eedef5ba090
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 3 )); then
+  echo "usage: $0 LABEL WORKDIR COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+label=$1
+workdir=$2
+shift 2
+log_dir=$(cd "$(dirname "$0")" && pwd)
+raw=$(mktemp /tmp/audit-command.XXXXXX)
+
+{
+  printf 'LABEL: %s\n' "$label"
+  printf 'WORKDIR: %s\n' "$workdir"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$log_dir/$label.log"
+
+(
+  cd "$workdir" || exit 125
+  "$@"
+) >"$raw" 2>&1
+status=$?
+lines=$(wc -l < "$raw")
+bytes=$(wc -c < "$raw")
+
+{
+  printf 'EXIT_STATUS: %d\n' "$status"
+  printf 'OUTPUT_LINES: %d\n' "$lines"
+  printf 'OUTPUT_BYTES: %d\n' "$bytes"
+  printf '%s\n' '--- OUTPUT (bounded) ---'
+  if (( lines <= 480 )); then
+    sed -n '1,480p' "$raw"
+  else
+    sed -n '1,240p' "$raw"
+    printf '%s\n' "--- OMITTED $((lines - 480)) MIDDLE LINES ---"
+    tail -n 240 "$raw"
+  fi
+} >> "$log_dir/$label.log"
+
+rm -f "$raw"
+cat "$log_dir/$label.log"
+exit "$status"

exec
/bin/bash -lc "/audit-output/evidence/run_logged.sh 20-program-pinning /tmp/audit-work/build bash -lc 'kast solution.mpy --definition llvm-audit-kompiled --module MPY-SYNTAX --sort Program --output kore --output-file solution-parsed.kore && kast claimed-program.mpy --definition llvm-audit-kompiled --module MPY-SYNTAX --sort Program --output kore --output-file claimed-program-parsed.kore && cmp -s solution-parsed.kore claimed-program-parsed.kore && sha256sum solution-parsed.kore claimed-program-parsed.kore'" in /audit-output
