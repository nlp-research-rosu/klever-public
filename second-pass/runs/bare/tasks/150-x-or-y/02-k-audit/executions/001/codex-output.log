+
+  claim [loop-invariant-for-universal]:
+    <k>
+      eval(
+        Compare(
+          BinOp("*", Name("divisor"), Name("divisor")),
+          CmpOp("<=", Name("n"))))
+      ~> whileBranch(
+        Compare(
+          BinOp("*", Name("divisor"), Name("divisor")),
+          CmpOp("<=", Name("n"))),
+        If(
+          Compare(
+            BinOp("%", Name("n"), Name("divisor")),
+            CmpOp("==", Int(0))),
+          Return(Name("y")),
+          .Stmts)
+        Assign(
+          Name("divisor"),
+          BinOp("+", Name("divisor"), Int(1))),
+        .Stmts)
+      ~> exec(Return(Name("x")))
+      => .K
+    </k>
