+                CmpOp("==", Int(0))),
+              Return(Name("y")),
+              .Stmts)
+            Assign(
+              Name("divisor"),
+              BinOp("+", Name("divisor"), Int(1))))
+          Return(Name("x"))))
+      => .K
+    </k>
+    <env> .Map => ?_FINALENV:Map </env>
+    <n> 15 </n>
+    <x> 8 </x>
+    <y> 5 </y>
+    <result> .K => intVal(5) </result>
+endmodule
