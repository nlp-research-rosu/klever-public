{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 10,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "3568314463b5f0cda0f318ebb08026d85632ffd161cd8c2d5ff1e4900f260969",
      "rationale": "This is the terminating base equation for the recursively defined primeFrom mathematical summary: once D squared exceeds N, no remaining candidate divisor is in the represented search range.",
      "source_rule_id": "rule-3568314463b5f0cda0f318ebb08026d85632ffd161cd8c2d5ff1e4900f260969",
      "start_line": 9,
      "text": "  rule primeFrom(N, D) => true\n    requires N <Int D *Int D"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 12,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "3cf9b4eaf0fc37f16b9c02bb86612432cff3badfb2761f79b078441bc26ec601",
      "rationale": "This equation defines the false case of primeFrom when the current in-range candidate D divides N; it is a defining branch of the summary, not an independently asserted number-theory fact.",
      "source_rule_id": "rule-3cf9b4eaf0fc37f16b9c02bb86612432cff3badfb2761f79b078441bc26ec601",
      "start_line": 11,
      "text": "  rule primeFrom(N, D) => false\n    requires D *Int D <=Int N andBool N %Int D ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 14,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "580860a84af419565613f03a6f4376674abe6fff2d2b519766ba75fb4f40e451",
      "rationale": "This is the recursive equation for primeFrom, advancing the definition from a non-dividing in-range candidate D to D plus one.",
      "source_rule_id": "rule-580860a84af419565613f03a6f4376674abe6fff2d2b519766ba75fb4f40e451",
      "start_line": 13,
      "text": "  rule primeFrom(N, D) => primeFrom(N, D +Int 1)\n    requires D *Int D <=Int N andBool N %Int D =/=Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 18,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "f8fc3c53a0505978f01db74728a727cd7869eda32ada9bd4865028c91fd75d91",
      "rationale": "This equation defines isPrime to be false below 2, supplying one branch of the named primality summary used by the specification.",
      "source_rule_id": "rule-f8fc3c53a0505978f01db74728a727cd7869eda32ada9bd4865028c91fd75d91",
      "start_line": 17,
      "text": "  rule isPrime(N) => false\n    requires N <Int 2"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 20,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "9290ca5c6a6bfa55d5fce813d33d07aa7984f4656f33938a4e34fa11fa9d0655",
      "rationale": "This equation defines isPrime for inputs at least 2 by expanding it to the primeFrom recurrence beginning with candidate divisor 2.",
      "source_rule_id": "rule-9290ca5c6a6bfa55d5fce813d33d07aa7984f4656f33938a4e34fa11fa9d0655",
      "start_line": 19,
      "text": "  rule isPrime(N) => primeFrom(N, 2)\n    requires 2 <=Int N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 23,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "430e599ca96d42aacd636f22618c18839f186b29b46581a108c51be2a8b03ef5",
      "rationale": "This structural helper equation defines chooseVal on true by selecting and wrapping X; it merely expands a named proof-result term.",
      "source_rule_id": "rule-430e599ca96d42aacd636f22618c18839f186b29b46581a108c51be2a8b03ef5",
      "start_line": 23,
      "text": "  rule chooseVal(true, X, _Y) => intVal(X)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 24,
      "module": "MPY-VERIFICATION",
      "normalized_sha256": "0cf2886c9720ca8500888e844b48dbcef4157496738d556f4340310b1c85ce00",
      "rationale": "This structural helper equation defines chooseVal on false by selecting and wrapping Y; it merely expands a named proof-result term.",
      "source_rule_id": "rule-0cf2886c9720ca8500888e844b48dbcef4157496738d556f4340310b1c85ce00",
      "start_line": 24,
      "text": "  rule chooseVal(false, _X, Y) => intVal(Y)"
    }
  ],
