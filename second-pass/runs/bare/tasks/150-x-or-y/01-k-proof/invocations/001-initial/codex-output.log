+                BinOp("%", Name("n"), Name("divisor")),
+                CmpOp("==", Int(0))),
+              Return(Name("y")),
+              .Stmts)
+            Assign(
+              Name("divisor"),
+              BinOp("+", Name("divisor"), Int(1))))
+          Return(Name("x"))))
+      => .K
+    </k>
+    <env> .Map => ?FINALENV:Map </env>
+    <n> N </n>
+    <x> X </x>
+    <y> Y </y>
+    <result> .K => chooseVal(isPrime(N), X, Y) </result>
+
+  claim
