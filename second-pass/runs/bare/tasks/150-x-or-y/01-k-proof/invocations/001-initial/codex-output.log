+  rule <k> V:Val ~> doReturn ~> _REST => .K </k>
+       <result> .K => V </result>
+
+  rule eval(Int(I)) => intVal(I)
+  rule <k> eval(Name(A)) => V ...</k>
+       <env>... A |-> V ...</env>
+
+  rule eval(BinOp(OP, LEFT, RIGHT))
+    => eval(LEFT) ~> binLeft(OP, RIGHT)
+  rule intVal(I) ~> binLeft(OP, RIGHT)
+    => eval(RIGHT) ~> binApply(OP, I)
+  rule intVal(J) ~> binApply("+", I) => intVal(I +Int J)
+  rule intVal(J) ~> binApply("*", I) => intVal(I *Int J)
+  rule intVal(J) ~> binApply("%", I) => intVal(I %Int J)
+    requires J =/=Int 0
+
+  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)))
+    => eval(LEFT) ~> cmpLeft(OP, RIGHT)
+  rule intVal(I) ~> cmpLeft(OP, RIGHT)
+    => eval(RIGHT) ~> cmpApply(OP, I)
+  rule intVal(J) ~> cmpApply("<", I) => boolVal(I <Int J)
+  rule intVal(J) ~> cmpApply("<=", I) => boolVal(I <=Int J)
+  rule intVal(J) ~> cmpApply("==", I) => boolVal(I ==Int J)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..07b297d0edbc5f0cb16144a67ee008ceb324dc62
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def x_or_y(n, x, y):
+    if n < 2:
+        return y
+    divisor = 2
+    while divisor * divisor <= n:
+        if n % divisor == 0:
+            return y
+        divisor = divisor + 1
+    return x
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d2ce578d704ea61690c92119f0d0e85b42e2424d
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,141 @@
+requires "verification.k"
+
+module LOOP-SPEC
+  imports MPY-VERIFICATION
+
+  // Generalized loop invariant.  It deliberately starts at an arbitrary
+  // D >= 2 so that one non-dividing iteration re-enters the same claim at
+  // D + 1 and K's reachability prover can apply circularity.
+  claim
+    <k>
+      eval(
+        Compare(
+          BinOp("*", Name("divisor"), Name("divisor")),
+          CmpOp("<=", Name("n"))))
+      ~> whileBranch(
+        Compare(
+          BinOp("*", Name("divisor"), Name("divisor")),
+          CmpOp("<=", Name("n"))),
+        If(
+          Compare(
+            BinOp("%", Name("n"), Name("divisor")),
+            CmpOp("==", Int(0))),
+          Return(Name("y")),
+          .Stmts)
+        Assign(
+          Name("divisor"),
+          BinOp("+", Name("divisor"), Int(1))),
+        .Stmts)
+      ~> exec(Return(Name("x")))
+      => .K
+    </k>
+    <env>
+      ("divisor" |-> intVal(D))
+      ("n" |-> intVal(N))
+      ("x" |-> intVal(X))
+      ("y" |-> intVal(Y))
+      => ?_FINALENV:Map
+    </env>
+    <n> N </n>
+    <x> X </x>
+    <y> Y </y>
+    <result> .K => chooseVal(primeFrom(N, D), X, Y) </result>
+    requires 2 <=Int D
+endmodule
+
+module SPEC
+  imports LOOP-SPEC
+
+  claim
+    <k>
+      Module(
+        FuncDef("x_or_y", Params("n", "x", "y"),
+          If(
+            Compare(Name("n"), CmpOp("<", Int(2))),
+            Return(Name("y")),
+            .Stmts)
+          Assign(Name("divisor"), Int(2))
+          While(
+            Compare(
+              BinOp("*", Name("divisor"), Name("divisor")),
+              CmpOp("<=", Name("n"))),
+            If(
+              Compare(
+                BinOp("%", Name("n"), Name("divisor")),
+                CmpOp("==", Int(0))),
+              Return(Name("y")),
+              .Stmts)
+            Assign(
+              Name("divisor"),
+              BinOp("+", Name("divisor"), Int(1))))
+          Return(Name("x"))))
+      => .K
+    </k>
+    <env> .Map => ?_FINALENV:Map </env>
+    <n> N </n>
+    <x> X </x>
+    <y> Y </y>
+    <result> .K => chooseVal(isPrime(N), X, Y) </result>
+
+  claim
+    <k>
+      Module(
+        FuncDef("x_or_y", Params("n", "x", "y"),
+          If(
+            Compare(Name("n"), CmpOp("<", Int(2))),
+            Return(Name("y")),
+            .Stmts)
+          Assign(Name("divisor"), Int(2))
+          While(
+            Compare(
+              BinOp("*", Name("divisor"), Name("divisor")),
+              CmpOp("<=", Name("n"))),
+            If(
+              Compare(
+                BinOp("%", Name("n"), Name("divisor")),
+                CmpOp("==", Int(0))),
+              Return(Name("y")),
+              .Stmts)
+            Assign(
+              Name("divisor"),
+              BinOp("+", Name("divisor"), Int(1))))
+          Return(Name("x"))))
+      => .K
+    </k>
+    <env> .Map => ?_FINALENV:Map </env>
+    <n> 7 </n>
+    <x> 34 </x>
+    <y> 12 </y>
+    <result> .K => intVal(34) </result>
+
+  claim
+    <k>
+      Module(
+        FuncDef("x_or_y", Params("n", "x", "y"),
+          If(
+            Compare(Name("n"), CmpOp("<", Int(2))),
+            Return(Name("y")),
+            .Stmts)
+          Assign(Name("divisor"), Int(2))
+          While(
+            Compare(
+              BinOp("*", Name("divisor"), Name("divisor")),
+              CmpOp("<=", Name("n"))),
+            If(
+              Compare(
+                BinOp("%", Name("n"), Name("divisor")),
+                CmpOp("==", Int(0))),
+              Return(Name("y")),
+              .Stmts)
+            Assign(
+              Name("divisor"),
+              BinOp("+", Name("divisor"), Int(1))))
+          Return(Name("x"))))
+      => .K
+    </k>
+    <env> .Map => ?_FINALENV:Map </env>
+    <n> 15 </n>
+    <x> 8 </x>
+    <y> 5 </y>
+    <result> .K => intVal(5) </result>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2cdc61fb30cd86c08f72887275e826145f1a527b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,25 @@
+requires "semantic.k"
+
+module MPY-VERIFICATION
+  imports MPY
+
+  // primeFrom(N, D) means that N has no divisor in the inclusive range
+  // from D through floor(sqrt(N)).  Its recursive shape mirrors the loop.
+  syntax Bool ::= primeFrom(Int, Int) [function]
+  rule primeFrom(N, D) => true
+    requires N <Int D *Int D
+  rule primeFrom(N, D) => false
+    requires D *Int D <=Int N andBool N %Int D ==Int 0
+  rule primeFrom(N, D) => primeFrom(N, D +Int 1)
+    requires D *Int D <=Int N andBool N %Int D =/=Int 0
+
+  syntax Bool ::= isPrime(Int) [function]
+  rule isPrime(N) => false
+    requires N <Int 2
+  rule isPrime(N) => primeFrom(N, 2)
+    requires 2 <=Int N
+
+  syntax Val ::= chooseVal(Bool, Int, Int) [function]
+  rule chooseVal(true, X, _Y) => intVal(X)
+  rule chooseVal(false, _X, Y) => intVal(Y)
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..f73f28b27732c956aad1d9a01667bb7dd59773ec
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,36 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+# Regenerate the constructor term with the fixed translator.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Concrete execution uses the LLVM backend.
+kompile semantic.k \
+  --backend llvm \
+  --main-module MPY \
+  --syntax-module MPY-SYNTAX \
+  --output-definition llvm-kompiled
+
+krun solution.mpy --definition llvm-kompiled -cN=7 -cX=34 -cY=12
+krun solution.mpy --definition llvm-kompiled -cN=15 -cX=8 -cY=5
+krun solution.mpy --definition llvm-kompiled -cN=97 -cX=11 -cY=22
+krun solution.mpy --definition llvm-kompiled -cN=121 -cX=11 -cY=22
+
+# Symbolic execution and reachability proofs use the Haskell backend.
+kompile verification.k \
+  --backend haskell \
+  --main-module MPY-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+# First prove the generalized loop invariant, then use that proved claim to
+# establish the universal entry-point theorem and both prompt examples.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module LOOP-SPEC
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..213c52cf89f325c16199177d99bc8839507a95a6
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,106 @@
+module MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," "Params" "(" Ids ")" "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "Return" "(" Expr ")"
+
+  syntax Ids ::= List{String, ","}
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+
+  syntax Val ::= intVal(Int) | boolVal(Bool)
+
+  syntax KItem ::= exec(Stmts)
+                 | eval(Expr)
+                 | store(String)
+                 | binLeft(String, Expr)
+                 | binApply(String, Int)
+                 | cmpLeft(String, Expr)
+                 | cmpApply(String, Int)
+                 | branch(Stmts, Stmts, Stmts)
+                 | whileBranch(Expr, Stmts, Stmts)
+                 | "doReturn"
+
+  configuration
+    <mpy>
+      <k> $PGM:Program </k>
+      <env> .Map </env>
+      <n> $N:Int </n>
+      <x> $X:Int </x>
+      <y> $Y:Int </y>
+      <result> .K </result>
+    </mpy>
+
+  rule <k> Module(FuncDef("x_or_y", Params("n", "x", "y"), BODY))
+            => exec(BODY) ...</k>
+       <env> .Map =>
+         ("n" |-> intVal(N))
+         ("x" |-> intVal(X))
+         ("y" |-> intVal(Y))
+       </env>
+       <n> N </n>
+       <x> X </x>
+       <y> Y </y>
+
+  rule exec(.Stmts) => .K
+  rule exec(S:Stmt SS:Stmts) => S ~> exec(SS)
+
+  rule If(COND, THEN, ELSE) => eval(COND) ~> branch(THEN, ELSE, .Stmts)
+  rule While(COND, BODY) => eval(COND) ~> whileBranch(COND, BODY, .Stmts)
+  rule Assign(Name(A), E) => eval(E) ~> store(A)
+  rule Return(E) => eval(E) ~> doReturn
+
+  rule boolVal(true) ~> branch(THEN, _ELSE, REST)
+    => exec(THEN) ~> exec(REST)
+  rule boolVal(false) ~> branch(_THEN, ELSE, REST)
+    => exec(ELSE) ~> exec(REST)
+
+  rule boolVal(true) ~> whileBranch(COND, BODY, REST)
+    => exec(BODY) ~> eval(COND) ~> whileBranch(COND, BODY, REST)
+  rule boolVal(false) ~> whileBranch(_COND, _BODY, REST)
+    => exec(REST)
+
+  rule <k> V:Val ~> store(A) => .K ...</k>
+       <env> ENV => ENV [ A <- V ] </env>
+
+  rule <k> V:Val ~> doReturn ~> _REST => .K </k>
+       <result> .K => V </result>
+
+  rule eval(Int(I)) => intVal(I)
+  rule <k> eval(Name(A)) => V ...</k>
+       <env>... A |-> V ...</env>
+
+  rule eval(BinOp(OP, LEFT, RIGHT))
+    => eval(LEFT) ~> binLeft(OP, RIGHT)
+  rule intVal(I) ~> binLeft(OP, RIGHT)
+    => eval(RIGHT) ~> binApply(OP, I)
+  rule intVal(J) ~> binApply("+", I) => intVal(I +Int J)
+  rule intVal(J) ~> binApply("*", I) => intVal(I *Int J)
+  rule intVal(J) ~> binApply("%", I) => intVal(I %Int J)
+    requires J =/=Int 0
+
+  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)))
+    => eval(LEFT) ~> cmpLeft(OP, RIGHT)
+  rule intVal(I) ~> cmpLeft(OP, RIGHT)
+    => eval(RIGHT) ~> cmpApply(OP, I)
+  rule intVal(J) ~> cmpApply("<", I) => boolVal(I <Int J)
+  rule intVal(J) ~> cmpApply("<=", I) => boolVal(I <=Int J)
+  rule intVal(J) ~> cmpApply("==", I) => boolVal(I ==Int J)
+endmodule
