          Compare(
            BinOp("%", Name("n"), Name("divisor")),
            CmpOp("==", Int(0))),
          Return(Name("y")),
          .Stmts)
        Assign(
          Name("divisor"),
          BinOp("+", Name("divisor"), Int(1))),
        .Stmts)
      ~> exec(Return(Name("x")))
      => .K
    </k>
    <env>
      ("divisor" |-> intVal(D))
      ("n" |-> intVal(N))
      ("x" |-> intVal(X))
      ("y" |-> intVal(Y))
      => ?_FINALENV:Map
    </env>
    <n> N </n>
    <x> X </x>
    <y> Y </y>
    <result> .K => chooseVal(primeFrom(N, D), X, Y) </result>
    requires 2 <=Int D
endmodule

