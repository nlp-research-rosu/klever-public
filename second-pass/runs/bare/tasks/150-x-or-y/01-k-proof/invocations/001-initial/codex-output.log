+  // D + 1 and K's reachability prover can apply circularity.
+  claim
+    <k>
+      exec(
+        While(
+          Compare(
+            BinOp("*", Name("divisor"), Name("divisor")),
+            CmpOp("<=", Name("n"))),
+          If(
+            Compare(
+              BinOp("%", Name("n"), Name("divisor")),
+              CmpOp("==", Int(0))),
+            Return(Name("y")),
+            .Stmts)
+          Assign(
+            Name("divisor"),
+            BinOp("+", Name("divisor"), Int(1))))
+        Return(Name("x")))
+      => .K
+    </k>
+    <env>
+      ("divisor" |-> intVal(D))
+      ("n" |-> intVal(N))
+      ("x" |-> intVal(X))
+      ("y" |-> intVal(Y))
+      => ?FINALENV:Map
