+                 | eval(Expr)
+                 | store(String)
+                 | binLeft(String, Expr)
+                 | binApply(String, Int)
+                 | cmpLeft(String, Expr)
+                 | cmpApply(String, Int)
+                 | branch(Stmts, Stmts, Stmts)
+                 | whileBranch(Expr, Stmts, Stmts)
+                 | "doReturn"
+
+  configuration
+    <mpy>
+      <k> $PGM:Program </k>
+      <env> .Map </env>
+      <n> $N:Int </n>
+      <x> $X:Int </x>
+      <y> $Y:Int </y>
+      <result> .K </result>
+    </mpy>
+
+  rule <k> Module(FuncDef("x_or_y", Params("n", "x", "y"), BODY))
+            => exec(BODY) ...</k>
+       <env> .Map =>
+         ("n" |-> intVal(N))
+         ("x" |-> intVal(X))
+         ("y" |-> intVal(Y))
+       </env>
+       <n> N </n>
+       <x> X </x>
+       <y> Y </y>
+
+  rule exec(.Stmts) => .K
+  rule exec(S:Stmt SS:Stmts) => S ~> exec(SS)
