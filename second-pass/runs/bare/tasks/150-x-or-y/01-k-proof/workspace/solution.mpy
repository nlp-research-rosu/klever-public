Module(
  FuncDef("x_or_y", Params("n", "x", "y"),
    If(Compare(Name("n"), CmpOp("<", Int(2))),
      Return(Name("y")),
      )
    Assign(Name("divisor"), Int(2))
    While(Compare(
      BinOp("*", Name("divisor"), Name("divisor")),
      CmpOp("<=", Name("n"))),
      If(Compare(
        BinOp("%", Name("n"), Name("divisor")),
        CmpOp("==", Int(0))),
        Return(Name("y")),
        )
      Assign(Name("divisor"), BinOp("+", Name("divisor"), Int(1))))
    Return(Name("x"))))
