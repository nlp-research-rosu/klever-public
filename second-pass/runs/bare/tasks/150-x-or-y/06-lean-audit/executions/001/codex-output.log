codex
I found the root cause: the sandbox’s PID namespace and mounted `/proc` disagree, while Lean 4.22 resolves its executable through `/proc/<getpid()>/exe`. That makes the pinned Lean binary fail before reading any project source. I’m applying a narrow audit-only process shim that maps `getpid()` to `/proc/self`’s host PID, then retrying the unchanged trusted preflight against a fresh copied build.
apply patch
patch: completed
/tmp/audit-work/hostpid_shim.c
diff --git a//tmp/audit-work/hostpid_shim.c b//tmp/audit-work/hostpid_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..edac180f7c0ec582973ffbb4e1236037049287bf
--- /dev/null
+++ b//tmp/audit-work/hostpid_shim.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The command sandbox exposes /proc from the host PID namespace while
+ * getpid() reports the nested namespace PID. Lean 4.22 opens
+ * /proc/<getpid()>/exe, so return the PID named by /proc/self instead.
+ */
+pid_t getpid(void) {
+    char target[PATH_MAX];
+    ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+    if (length <= 0 || length >= (ssize_t)sizeof(target)) {
+        errno = ESRCH;
+        return (pid_t)-1;
+    }
+    target[length] = '\0';
+    char *end = NULL;
+    long value = strtol(target, &end, 10);
+    if (end == target || *end != '\0' || value <= 0) {
+        errno = ESRCH;
+        return (pid_t)-1;
+    }
+    return (pid_t)value;
+}

