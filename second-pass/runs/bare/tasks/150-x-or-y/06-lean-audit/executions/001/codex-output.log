print('status=', json.loads((generation / 'export-result.json').read_text())['status'], sep='')
print('candidate_exists=', Path('/candidate').exists(), sep='')

# Independent executable models written from the frozen operational meaning;
# no mounted Python source is imported or executed.
def summary_prime_from(n, d):
    while True:
        if n < d * d:
            return True
        if n % d == 0:
            return False
        d += 1

def summary_is_prime(n):
    return False if n < 2 else summary_prime_from(n, 2)

def operational_x_or_y(n, x, y):
    if n < 2:
        return y
    d = 2
    while d * d <= n:
        if n % d == 0:
            return y
        d += 1
    return x

