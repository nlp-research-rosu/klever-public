 ('rule-430e599ca96d42aacd636f22618c18839f186b29b46581a108c51be2a8b03ef5', 'DEFINITION', 'chooseVal true branch'),
 ('rule-0cf2886c9720ca8500888e844b48dbcef4157496738d556f4340310b1c85ce00', 'DEFINITION', 'chooseVal false branch'),
]
recorded = [(r['source_rule_id'], r['classification']) for r in discovery['rules']]
independent_pairs = [(r, c) for r, c, _ in independent_classification]
independent_domain_ids = [r for r, c, _ in independent_classification if c == 'DOMAIN_LEMMA']
print('INDEPENDENT CLASSIFICATION')
for rule_id, classification, reason in independent_classification:
    print(f'{rule_id} {classification}: {reason}')
print('recorded_classification_exact=', independent_pairs == recorded, sep='')
print('independent_domain_ids=', independent_domain_ids, sep='')
print('simplification_rule_ids=[]')

print('\\nEMPTY-SET BIJECTION')
sets = {
 'independent_domain_ids': independent_domain_ids,
 'input_manifest.source_rules': [r['source_rule_id'] for r in input_manifest['source_rules']],
 'obligation_map.source_rules': [r['source_rule_id'] for r in obligation_map['source_rules']],
 'obligation_map.obligations': [r['source_rule_id'] for r in obligation_map['obligations']],
 'obligation_map.trust_parameters': obligation_map['trust_parameters'],
}
for label, value in sets.items():
    print(f'{label}={value}')
print('all_empty=', all(not value for value in sets.values()), sep='')
print('source_obligation_ids_order_equal=', sets['independent_domain_ids'] == sets['obligation_map.obligations'], sep='')
