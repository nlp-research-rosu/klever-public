print('isPrime_below_two_true witness n=1 differs=', mutations['isPrime_below_two_true'](1) "'!= summary_is_prime(1), sep='"'')
print('primeFrom_divisible_true witness n=9 differs=', mutations['primeFrom_divisible_true'](9) "'!= summary_is_prime(9), sep='"'')
print('chooseVal_reverse witness n=7 differs=', mutations['chooseVal_reverse'](7, 34, 12) "'!= operational_x_or_y(7, 34, 12), sep='"'')
