 (-11, 4, 9), (0, 4, 9), (1, 4, 9), (2, 4, 9), (3, -5, 8),
 (4, 4, 9), (7, 34, 12), (9, 4, 9), (15, 8, 5), (25, 1, 2),
 (49, -3, -7), (97, 11, 22), (121, 11, 22), (9973, 6, 10),
]
print('\\nADVERSARIAL SEMANTIC PROBES')
mismatches = 0
for n, x, y in cases:
    operational = operational_x_or_y(n, x, y)
    summarized = x if summary_is_prime(n) else y
    mismatch = operational "'!= summarized
    mismatches += mismatch
    print(f'"'n={n} x={x} y={y} operational={operational} summary={summarized} mismatch={mismatch}')
print('mismatch_count=', mismatches, sep='')

# Counterfactual mutations: reverse either definition branch and require a witness.
mutations = {
 'isPrime_below_two_true': lambda n: True if n < 2 else summary_prime_from(n, 2),
 'primeFrom_divisible_true': lambda n: True if n >= 2 else False,
 'chooseVal_reverse': lambda n, x, y: y if summary_is_prime(n) else x,
}
