+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal functional-correctness claim over every finite integer list.
+  claim <k>
+          #run(solutionProgram, listVal(L: IntList))
+        => #monotonicSpec(L)
+        </k>
+
+  // Prompt examples, proved through the same translated-program semantics.
+  claim <k>
+          #run(
+            solutionProgram,
+            listVal(cons(1, cons(2, cons(4, cons(20, nil))))))
+        => boolVal(true)
+        </k>
+
+  claim <k>
+          #run(
+            solutionProgram,
+            listVal(cons(1, cons(20, cons(4, cons(10, nil))))))
+        => boolVal(false)
+        </k>
+
+  claim <k>
+          #run(
+            solutionProgram,
+            listVal(cons(4, cons(1, cons(0, cons(-10, nil))))))
+        => boolVal(true)
+        </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..fb2e09e82c896a31f54716be3776aed833c8552c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,37 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // This macro is the exact AST emitted in solution.mpy. Keeping the program
+  // as syntax makes the proof exercise the evaluator, rather than replacing
+  // the implementation with a task-specific execution rule.
+  syntax Pgm ::= "solutionProgram"
+  rule solutionProgram =>
+    Module(
+      FuncDef("monotonic", Params("l"),
+        Return(
+          BoolOp(
+            "or",
+            Compare(
+              Name("l"),
+              CmpOp("==", Call(Name("sorted"), Name("l")))),
+            Compare(
+              Name("l"),
+              CmpOp(
+                "==",
+                Call(
+                  Name("sorted"),
+                  Name("l"),
+                  KwArg("reverse", Bool(true)))))))))
+    [macro]
+
+  // Formal contract: equality with the ascending ordering or with its reverse.
+  // For finite integer lists this is precisely nondecreasing or nonincreasing.
+  syntax Val ::= #monotonicSpec(IntList) [function]
+  rule #monotonicSpec(L) =>
+    boolVal(
+      #eqIntLists(L, #sortInts(L))
+      orBool
+      #eqIntLists(L, #reverseInts(#sortInts(L))))
+endmodule

