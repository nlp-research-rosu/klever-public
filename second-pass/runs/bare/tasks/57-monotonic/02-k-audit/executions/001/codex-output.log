with open(p,encoding='utf-8') as f:
    for lineno,line in enumerate(f,1):
        obj=json.loads(line)
        counts[obj.get('type')] += 1
        payload=obj.get('payload',{})
        ptype=payload.get('type') if isinstance(payload,dict) else None
        if ptype:
            counts['payload:'+ptype] += 1
        if ptype in ('custom_tool_call','function_call'):
            commands.append((lineno,payload.get('name'),payload.get('input') or payload.get('arguments')))
        if ptype=='message':
            role=payload.get('role')
            content=payload.get('content',[])
            texts=[]
            for item in content:
                if isinstance(item,dict) and isinstance(item.get('text'),str): texts.append(item['text'])
            if role in ('assistant','user') and texts:
                messages.append((lineno,role,'\\n'.join(texts)))
print('TRACE_COUNTS')
for k,v in sorted(counts.items()): print(k,v)
print('TOOL_CALLS')
for x in commands: print(x)
print('USER_ASSISTANT_MESSAGES')
for lineno,role,msg in messages:
    print(f'LINE {lineno} ROLE {role}')
    print(msg)
