/audit-output/evidence/run_logged.sh /audit-output/evidence/stage3_build_concrete.log kompile semantic.k --backend llvm --main-module SEMANTIC --syntax-module SEMANTIC-SYNTAX --output-definition /tmp/audit-work/review-57/build/semantic-llvm-kompiled' in /tmp/audit-work/review-57/src
