/bin/bash -lc '/audit-output/evidence/run_logged.sh /audit-output/evidence/stage3_build_proof.log kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module SEMANTIC-SYNTAX --output-definition /tmp/audit-work/review-57/build/verification-haskell-kompiled' in /tmp/audit-work/review-57/src
