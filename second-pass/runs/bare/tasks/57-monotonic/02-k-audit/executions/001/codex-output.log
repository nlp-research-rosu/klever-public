(147, 'exec', 'const patch = "*** Begin Patch\\n*** Update File: /work/semantic.k\\n@@\\n-  rule #findFunction(F, FuncDef(F, P, BODY) REST)\\n+  rule #findFunction(F, FuncDef(F, P, BODY) _REST)\\n     => function(P, BODY)\\n-  rule #findFunction(F, FuncDef(G, P, BODY) REST)\\n-    => #findFunction(F, REST)\\n+  rule #findFunction(F, FuncDef(G, _P, _BODY) REST)\\n+    => #findFunction(F, REST)\\n@@\\n-  rule #exec(Return(E) REST, ENV, FUNS)\\n+  rule #exec(Return(E) _REST, ENV, FUNS)\\n     => #eval(E, ENV, FUNS)\\n \\n-  rule #eval(Name(N), env(N, V), FUNS) => V\\n-  rule #eval(Bool(B), ENV, FUNS) => boolVal(B)\\n+  rule #eval(Name(N), env(N, V), _FUNS) => V\\n+  rule #eval(Bool(B), _ENV, _FUNS) => boolVal(B)\\n@@\\n-  rule #eqIntLists(nil, cons(I, L)) => false\\n-  rule #eqIntLists(cons(I, L), nil) => false\\n+  rule #eqIntLists(nil, cons(_I, _L)) => false\\n+  rule #eqIntLists(cons(_I, _L), nil) => false\\n*** Update File: /work/verification.k\\n@@\\n-  // This macro is the exact AST emitted in solution.mpy. Keeping the program\\n+  // This constant is the exact AST emitted in solution.mpy. Keeping the program\\n*** Add File: /work/prove.sh\\n+#!/usr/bin/env bash\\n+set -euo pipefail\\n+\\n+python3 py2mpy.py solution.py > solution.mpy\\n+\\n+mkdir -p build\\n+kompile verification.k \\\\\\n+  --backend haskell \\\\\\n+  --main-module VERIFICATION \\\\\\n+  --syntax-module SEMANTIC-SYNTAX \\\\\\n+  --output-definition build/verification-kompiled\\n+\\n+krun solution.mpy \\\\\\n+  -cARG=\'listVal(cons(1, cons(2, cons(4, cons(20, nil)))))\' \\\\\\n+  --definition build/verification-kompiled\\n+krun solution.mpy \\\\\\n+  -cARG=\'listVal(cons(1, cons(20, cons(4, cons(10, nil)))))\' \\\\\\n+  --definition build/verification-kompiled\\n+krun solution.mpy \\\\\\n+  -cARG=\'listVal(cons(4, cons(1, cons(0, cons(-10, nil)))))\' \\\\\\n+  --definition build/verification-kompiled\\n+\\n+kprove spec.k \\\\\\n+  --definition build/verification-kompiled \\\\\\n+  --spec-module SPEC\\n*** End Patch";\ntext(await tools.apply_patch(patch));\nconst r = await tools.exec_command({cmd:"chmod +x prove.sh && bash -n prove.sh && python3 - <<\'PY\'\\nfrom itertools import product\\nfrom solution import monotonic\\n\\ndef oracle(xs):\\n    return all(a <= b for a, b in zip(xs, xs[1:])) or all(a >= b for a, b in zip(xs, xs[1:]))\\n\\nfor n in range(7):\\n    for xs in map(list, product(range(-2, 3), repeat=n)):\\n        assert monotonic(xs) == oracle(xs), xs\\nprint(\'Python exhaustive check passed: 19,531 lists\')\\nPY","workdir":"/work","yield_time_ms":10000,"max_output_tokens":10000});\ntext(r.output);')
