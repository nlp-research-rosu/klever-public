(48, 'exec', 'const patch = "*** Begin Patch\\n*** Add File: /work/semantic.k\\n+requires \\"verification.k\\"\\n+\\n+module SEMANTIC-SYNTAX\\n+  imports BOOL-SYNTAX\\n+  imports INT-SYNTAX\\n+  imports STRING-SYNTAX\\n+\\n+  syntax Pgm ::= \\"Module\\" \\"(\\" Stmts \\")\\"\\n+\\n+  syntax Stmts ::= List{Stmt, \\"\\"}\\n+  syntax Stmt ::= \\"FuncDef\\" \\"(\\" String \\",\\" Params \\",\\" Stmts \\")\\"\\n+                | \\"Return\\" \\"(\\" Expr \\")\\"\\n+\\n+  syntax Params ::= \\"Params\\" \\"(\\" List{String, \\",\\"} \\")\\"\\n+\\n+  syntax Expr ::= \\"Name\\" \\"(\\" String \\")\\"\\n+                | \\"Bool\\" \\"(\\" Bool \\")\\"\\n+                | \\"BoolOp\\" \\"(\\" String \\",\\" List{Expr, \\",\\"} \\")\\"\\n+                | \\"Compare\\" \\"(\\" Expr \\",\\" List{CmpOp, \\",\\"} \\")\\"\\n+                | \\"Call\\" \\"(\\" Expr \\",\\" List{Expr, \\",\\"} \\")\\"\\n+                | \\"KwArg\\" \\"(\\" String \\",\\" Expr \\")\\"\\n+\\n+  syntax CmpOp ::= \\"CmpOp\\" \\"(\\" String \\",\\" Expr \\")\\"\\n+\\n+  // Values used by this task: booleans and finite lists of mathematical ints.\\n+  syntax IntList ::= \\"nil\\"\\n+                   | \\"cons\\" \\"(\\" Int \\",\\" IntList \\")\\"\\n+  syntax Val ::= \\"boolVal\\" \\"(\\" Bool \\")\\"\\n+               | \\"listVal\\" \\"(\\" IntList \\")\\"\\n+endmodule\\n+\\n+module SEMANTIC\\n+  imports SEMANTIC-SYNTAX\\n+  imports BOOL\\n+  imports INT\\n+  imports MAP\\n+  imports STRING\\n+\\n+  configuration <k> #run($PGM:Pgm, $ARG:Val) </k>\\n+\\n+  // A small, compositional evaluator for the translated subset used in\\n+  // solution.mpy. Function definitions remain AST data until invoked.\\n+  syntax Fun ::= \\"function\\" \\"(\\" Params \\",\\" Stmts \\")\\"\\n+\\n+  syntax Fun ::= #findFunction(String, Stmts) [function]\\n+  rule #findFunction(F, FuncDef(F, P, BODY) REST)\\n+    => function(P, BODY)\\n+  rule #findFunction(F, FuncDef(G, P, BODY) REST)\\n+    => #findFunction(F, REST)\\n+    requires F =/=String G\\n+\\n+  syntax Val ::= #run(Pgm, Val) [function]\\n+               | #apply(String, Val, Stmts) [function]\\n+               | #applyFunction(Fun, Val, Stmts) [function]\\n+               | #exec(Stmts, Map, Stmts) [function]\\n+               | #eval(Expr, Map, Stmts) [function]\\n+               | #equals(Val, Val) [function]\\n+               | #boolOr(Val, Val) [function]\\n+\\n+  rule #run(Module(FUNS), ARG)\\n+    => #apply(\\"monotonic\\", ARG, FUNS)\\n+\\n+  rule #apply(F, ARG, FUNS)\\n+    => #applyFunction(#findFunction(F, FUNS), ARG, FUNS)\\n+  rule #applyFunction(function(Params(P), BODY), ARG, FUNS)\\n+    => #exec(BODY, P |-> ARG, FUNS)\\n+\\n+  rule #exec(Return(E) REST, ENV, FUNS)\\n+    => #eval(E, ENV, FUNS)\\n+\\n+  rule #eval(Name(N), ENV, FUNS) => ENV [ N ]\\n+  rule #eval(Bool(B), ENV, FUNS) => boolVal(B)\\n+\\n+  // Both operands in this task are pure and total. Evaluating them eagerly is\\n+  // observationally identical to Python\'s short-circuiting `or` here.\\n+  rule #eval(BoolOp(\\"or\\", E1, E2), ENV, FUNS)\\n+    => #boolOr(#eval(E1, ENV, FUNS), #eval(E2, ENV, FUNS))\\n+  rule #boolOr(boolVal(B1), boolVal(B2))\\n+    => boolVal(B1 orBool B2)\\n+\\n+  rule #eval(Compare(E1, CmpOp(\\"==\\", E2)), ENV, FUNS)\\n+    => #equals(#eval(E1, ENV, FUNS), #eval(E2, ENV, FUNS))\\n+  rule #equals(listVal(L1), listVal(L2))\\n+    => boolVal(#eqIntLists(L1, L2))\\n+\\n+  // The two sorted call shapes appearing in solution.mpy.\\n+  rule #eval(Call(Name(\\"sorted\\"), E), ENV, FUNS)\\n+    => listVal(#sortInts(#asIntList(#eval(E, ENV, FUNS))))\\n+  rule #eval(\\n+          Call(Name(\\"sorted\\"), E, KwArg(\\"reverse\\", Bool(true))),\\n+          ENV,\\n+          FUNS)\\n+    => listVal(#reverseInts(#sortInts(#asIntList(#eval(E, ENV, FUNS)))))\\n+\\n+  syntax IntList ::= #asIntList(Val) [function]\\n+  rule #asIntList(listVal(L)) => L\\n+\\n+  // Insertion sort gives `sorted` an executable, independently stated\\n+  // meaning rather than treating it as an oracle.\\n+  syntax IntList ::= #sortInts(IntList) [function]\\n+                   | #insertInt(Int, IntList) [function]\\n+  rule #sortInts(nil) => nil\\n+  rule #sortInts(cons(I, L)) => #insertInt(I, #sortInts(L))\\n+\\n+  rule #insertInt(I, nil) => cons(I, nil)\\n+  rule #insertInt(I, cons(J, L)) => cons(I, cons(J, L))\\n+    requires I <=Int J\\n+  rule #insertInt(I, cons(J, L)) => cons(J, #insertInt(I, L))\\n+    requires I >Int J\\n+\\n+  syntax IntList ::= #reverseInts(IntList) [function]\\n+                   | #appendInts(IntList, IntList) [function]\\n+  rule #reverseInts(nil) => nil\\n+  rule #reverseInts(cons(I, L))\\n+    => #appendInts(#reverseInts(L), cons(I, nil))\\n+  rule #appendInts(nil, L2) => L2\\n+  rule #appendInts(cons(I, L1), L2)\\n+    => cons(I, #appendInts(L1, L2))\\n+\\n+  syntax Bool ::= #eqIntLists(IntList, IntList) [function]\\n+  rule #eqIntLists(nil, nil) => true\\n+  rule #eqIntLists(nil, cons(I, L)) => false\\n+  rule #eqIntLists(cons(I, L), nil) => false\\n+  rule #eqIntLists(cons(I, L1), cons(J, L2))\\n+    => (I ==Int J) andBool #eqIntLists(L1, L2)\\n+endmodule\\n*** Add File: /work/verification.k\\n+requires \\"semantic.k\\"\\n+\\n+module VERIFICATION\\n+  imports SEMANTIC\\n+\\n+  // This macro is the exact AST emitted in solution.mpy. Keeping the program\\n+  // as syntax makes the proof exercise the evaluator, rather than replacing\\n+  // the implementation with a task-specific execution rule.\\n+  syntax Pgm ::= \\"solutionProgram\\"\\n+  rule solutionProgram =>\\n+    Module(\\n+      FuncDef(\\"monotonic\\", Params(\\"l\\"),\\n+        Return(\\n+          BoolOp(\\n+            \\"or\\",\\n+            Compare(\\n+              Name(\\"l\\"),\\n+              CmpOp(\\"==\\", Call(Name(\\"sorted\\"), Name(\\"l\\")))),\\n+            Compare(\\n+              Name(\\"l\\"),\\n+              CmpOp(\\n+                \\"==\\",\\n+                Call(\\n+                  Name(\\"sorted\\"),\\n+                  Name(\\"l\\"),\\n+                  KwArg(\\"reverse\\", Bool(true)))))))))\\n+    [macro]\\n+\\n+  // Formal contract: equality with the ascending ordering or with its reverse.\\n+  // For finite integer lists this is precisely nondecreasing or nonincreasing.\\n+  syntax Val ::= #monotonicSpec(IntList) [function]\\n+  rule #monotonicSpec(L) =>\\n+    boolVal(\\n+      #eqIntLists(L, #sortInts(L))\\n+      orBool\\n+      #eqIntLists(L, #reverseInts(#sortInts(L))))\\n+endmodule\\n*** Add File: /work/spec.k\\n+requires \\"verification.k\\"\\n+\\n+module SPEC\\n+  imports VERIFICATION\\n+\\n+  // Universal functional-correctness claim over every finite integer list.\\n+  claim <k>\\n+          #run(solutionProgram, listVal(L: IntList))\\n+        => #monotonicSpec(L)\\n+        </k>\\n+\\n+  // Prompt examples, proved through the same translated-program semantics.\\n+  claim <k>\\n+          #run(\\n+            solutionProgram,\\n+            listVal(cons(1, cons(2, cons(4, cons(20, nil))))))\\n+        => boolVal(true)\\n+        </k>\\n+\\n+  claim <k>\\n+          #run(\\n+            solutionProgram,\\n+            listVal(cons(1, cons(20, cons(4, cons(10, nil))))))\\n+        => boolVal(false)\\n+        </k>\\n+\\n+  claim <k>\\n+          #run(\\n+            solutionProgram,\\n+            listVal(cons(4, cons(1, cons(0, cons(-10, nil))))))\\n+        => boolVal(true)\\n+        </k>\\n+endmodule\\n*** End Patch";\ntext(await tools.apply_patch(patch));\n')
