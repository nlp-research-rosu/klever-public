+status=$?
+printf 'EXIT_STATUS: %d (expected 1: no matches)\n\n' "$status"
+(( status == 1 )) || exit 1
+
+printf 'COMMAND: nl -ba semantic.k verification.k spec.k\n'
+for file in semantic.k verification.k spec.k; do
