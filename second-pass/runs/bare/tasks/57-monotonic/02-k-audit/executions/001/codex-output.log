+printf 'COMMAND: list reviewer evidence sizes (bounded evidence check)\n'
+find /audit-output/evidence -maxdepth 1 -type f -printf '%s %f\n' | sort -n
+status=$?
+printf 'EXIT_STATUS: %d\n' "$status"
