     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // This constant is the exact AST emitted in solution.mpy. Keeping the program
     7	  // as syntax makes the proof exercise the evaluator, rather than replacing
     8	  // the implementation with a task-specific execution rule.
     9	  syntax Pgm ::= "solutionProgram" [function]
    10	  rule solutionProgram =>
    11	    Module(
    12	      FuncDef("monotonic", Params("l"),
    13	        Return(
    14	          BoolOp(
    15	            "or",
    16	            Compare(
    17	              Name("l"),
    18	              CmpOp("==", Call(Name("sorted"), Name("l")))),
    19	            Compare(
    20	              Name("l"),
    21	              CmpOp(
    22	                "==",
    23	                Call(
    24	                  Name("sorted"),
    25	                  Name("l"),
    26	                  KwArg("reverse", Bool(true)))))))))
    27	
    28	  // Formal contract: equality with the ascending ordering or with its reverse.
    29	  // For finite integer lists this is precisely nondecreasing or nonincreasing.
    30	  syntax Val ::= #monotonicSpec(IntList) [function]
    31	  rule #monotonicSpec(L) =>
    32	    boolVal(
    33	      #eqIntLists(L, #sortInts(L))
    34	      orBool
    35	      #eqIntLists(L, #reverseInts(#sortInts(L))))
    36	endmodule
