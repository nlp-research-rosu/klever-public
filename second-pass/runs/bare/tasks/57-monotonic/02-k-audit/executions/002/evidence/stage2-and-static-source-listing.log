     1	module SEMANTIC-SYNTAX
     2	  imports BOOL-SYNTAX
     3	  imports INT-SYNTAX
     4	  imports STRING-SYNTAX
     5	
     6	  syntax Pgm ::= "Module" "(" Stmts ")"
     7	
     8	  syntax Stmts ::= List{Stmt, ""}
     9	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
    10	                | "Return" "(" Expr ")"
    11	
    12	  syntax Strings ::= List{String, ","}
    13	  syntax Params ::= "Params" "(" Strings ")"
    14	
    15	  syntax Exprs ::= List{Expr, ","}
    16	  syntax CmpOps ::= List{CmpOp, ","}
    17	
    18	  syntax Expr ::= "Name" "(" String ")"
    19	                | "Bool" "(" Bool ")"
    20	                | "BoolOp" "(" String "," Exprs ")"
    21	                | "Compare" "(" Expr "," CmpOps ")"
    22	                | "Call" "(" Expr "," Exprs ")"
    23	                | "KwArg" "(" String "," Expr ")"
    24	
    25	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    26	
    27	  // Values used by this task: booleans and finite lists of mathematical ints.
    28	  syntax IntList ::= "nil"
    29	                   | "cons" "(" Int "," IntList ")"
    30	  syntax Val ::= "boolVal" "(" Bool ")"
    31	               | "listVal" "(" IntList ")"
    32	endmodule
    33	
    34	module SEMANTIC
    35	  imports SEMANTIC-SYNTAX
    36	  imports BOOL
    37	  imports INT
    38	  imports STRING
    39	
    40	  configuration <k> #run($PGM:Pgm, $ARG:Val) </k>
    41	
    42	  // A small, compositional evaluator for the translated subset used in
    43	  // solution.mpy. Function definitions remain AST data until invoked.
    44	  syntax Fun ::= "function" "(" Params "," Stmts ")"
    45	  syntax Env ::= "env" "(" String "," Val ")"
    46	
    47	  syntax Fun ::= #findFunction(String, Stmts) [function]
    48	  rule #findFunction(F, FuncDef(F, P, BODY) _REST)
    49	    => function(P, BODY)
    50	  rule #findFunction(F, FuncDef(G, _P, _BODY) REST)
    51	    => #findFunction(F, REST)
    52	    requires F =/=String G
    53	
    54	  syntax KItem ::= #run(Pgm, Val)
    55	
    56	  syntax Val ::= #apply(String, Val, Stmts) [function]
    57	               | #applyFunction(Fun, Val, Stmts) [function]
    58	               | #exec(Stmts, Env, Stmts) [function]
    59	               | #eval(Expr, Env, Stmts) [function]
    60	               | #equals(Val, Val) [function]
    61	               | #boolOr(Val, Val) [function]
    62	
    63	  rule #run(Module(FUNS), ARG)
    64	    => #apply("monotonic", ARG, FUNS)
    65	
    66	  rule #apply(F, ARG, FUNS)
    67	    => #applyFunction(#findFunction(F, FUNS), ARG, FUNS)
    68	  rule #applyFunction(function(Params(P), BODY), ARG, FUNS)
    69	    => #exec(BODY, env(P, ARG), FUNS)
    70	
    71	  rule #exec(Return(E) _REST, ENV, FUNS)
    72	    => #eval(E, ENV, FUNS)
    73	
    74	  rule #eval(Name(N), env(N, V), _FUNS) => V
    75	  rule #eval(Bool(B), _ENV, _FUNS) => boolVal(B)
    76	
    77	  // Both operands in this task are pure and total. Evaluating them eagerly is
    78	  // observationally identical to Python's short-circuiting `or` here.
    79	  rule #eval(BoolOp("or", E1, E2), ENV, FUNS)
    80	    => #boolOr(#eval(E1, ENV, FUNS), #eval(E2, ENV, FUNS))
    81	  rule #boolOr(boolVal(B1), boolVal(B2))
    82	    => boolVal(B1 orBool B2)
    83	
    84	  rule #eval(Compare(E1, CmpOp("==", E2)), ENV, FUNS)
    85	    => #equals(#eval(E1, ENV, FUNS), #eval(E2, ENV, FUNS))
    86	  rule #equals(listVal(L1), listVal(L2))
    87	    => boolVal(#eqIntLists(L1, L2))
    88	
    89	  // The two sorted call shapes appearing in solution.mpy.
    90	  rule #eval(Call(Name("sorted"), E), ENV, FUNS)
    91	    => listVal(#sortInts(#asIntList(#eval(E, ENV, FUNS))))
    92	  rule #eval(
    93	          Call(Name("sorted"), E, KwArg("reverse", Bool(true))),
    94	          ENV,
    95	          FUNS)
    96	    => listVal(#reverseInts(#sortInts(#asIntList(#eval(E, ENV, FUNS)))))
    97	
    98	  syntax IntList ::= #asIntList(Val) [function]
    99	  rule #asIntList(listVal(L)) => L
   100	
   101	  // Insertion sort gives `sorted` an executable, independently stated
   102	  // meaning rather than treating it as an oracle.
   103	  syntax IntList ::= #sortInts(IntList) [function]
   104	                   | #insertInt(Int, IntList) [function]
   105	  rule #sortInts(nil) => nil
   106	  rule #sortInts(cons(I, L)) => #insertInt(I, #sortInts(L))
   107	
   108	  rule #insertInt(I, nil) => cons(I, nil)
   109	  rule #insertInt(I, cons(J, L)) => cons(I, cons(J, L))
   110	    requires I <=Int J
   111	  rule #insertInt(I, cons(J, L)) => cons(J, #insertInt(I, L))
   112	    requires I >Int J
   113	
   114	  syntax IntList ::= #reverseInts(IntList) [function]
   115	                   | #appendInts(IntList, IntList) [function]
   116	  rule #reverseInts(nil) => nil
   117	  rule #reverseInts(cons(I, L))
   118	    => #appendInts(#reverseInts(L), cons(I, nil))
   119	  rule #appendInts(nil, L2) => L2
   120	  rule #appendInts(cons(I, L1), L2)
   121	    => cons(I, #appendInts(L1, L2))
   122	
   123	  syntax Bool ::= #eqIntLists(IntList, IntList) [function]
   124	  rule #eqIntLists(nil, nil) => true
   125	  rule #eqIntLists(nil, cons(_I, _L)) => false
   126	  rule #eqIntLists(cons(_I, _L), nil) => false
   127	  rule #eqIntLists(cons(I, L1), cons(J, L2))
   128	    => (I ==Int J) andBool #eqIntLists(L1, L2)
   129	endmodule
