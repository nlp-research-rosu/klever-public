diff --git a//tmp/audit-work/57-monotonic/spec-body-mutated.k b//tmp/audit-work/57-monotonic/spec-body-mutated.k
new file mode 100644
index 0000000000000000000000000000000000000000..349dca4b436e918f0ea998eb5278f450caa1925f
--- /dev/null
+++ b//tmp/audit-work/57-monotonic/spec-body-mutated.k
@@ -0,0 +1,12 @@
+requires "verification-body-mutated.k"
+
+module SPEC-BODY-MUTATED
+  imports VERIFICATION-BODY-MUTATED
+
+  // [2, 1] is decreasing, so the intended monotonic result is true. The
+  // body-mutated program returns false because both branches test ascending.
+  claim <k>
+          #run(bodyMutatedProgram, listVal(cons(2, cons(1, nil))))
+        => boolVal(true)
+        </k>
+endmodule
