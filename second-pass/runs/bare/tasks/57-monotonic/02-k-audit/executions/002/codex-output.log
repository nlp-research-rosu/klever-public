from pathlib import Path
import hashlib,itertools
pairs=[('/candidate','be4dade6ae59b16a1e5b0bbcf38fed45e3d5b5b86247150abdfa3faa3e1fc05c'),('/generation-evidence/codex-trace','97ab5b8b2b9ea5a0227281d75ab0b37046c80a82545691ee1975f56cb0011d3a')]
for file_repr in ['content','rawhash','hexhash']:
 for digest_repr in ['raw','hex']:
  for include_type in ['', 'char','word']:
   for name_mode in ['name','rel']:
    for before,between,after in itertools.product([b'',b'\\0',b'\\n',b' ',b':'],repeat=3):
     def calc(root):
      root=Path(root)
      def node(p):
       if p.is_file():
        c=p.read_bytes(); raw=hashlib.sha256(c).digest()
        body={'content':c,'rawhash':raw,'hexhash':raw.hex().encode()}[file_repr]
        pref={'':b'','char':b'f','word':b'file\\0'}[include_type]
        return hashlib.sha256(pref+body).digest()
       parts=[]
       for child in sorted(p.iterdir(),key=lambda q:q.name):
        nm=(child.name if name_mode=='name' else child.relative_to(root).as_posix()).encode()
        dg=node(child); dg=dg if digest_repr=='raw' else dg.hex().encode()
        typ={'':b'','char':(b'd' if child.is_dir() else b'f'),'word':(b'directory\\0' if child.is_dir() else b'file\\0')}[include_type]
        parts.append(before+typ+nm+between+dg+after)
       pref={'':b'','char':b'd','word':b'directory\\0'}[include_type]
       return hashlib.sha256(pref+b''.join(parts)).digest()
      return node(root).hex()
     vals=[calc(root) for root,_ in pairs]
     if any(v==target for v,(_,target) in zip(vals,pairs)):
      print('candidate',file_repr,digest_repr,include_type,name_mode,before,between,after,vals)
PY" in /audit-output
