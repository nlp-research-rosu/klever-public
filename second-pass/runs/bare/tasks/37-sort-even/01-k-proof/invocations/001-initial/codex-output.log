new file mode 100644
index 0000000000000000000000000000000000000000..2b45862c7aa2fbb9dc91ceef26702e18b54504d5
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,149 @@
+requires "domains.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+  imports LIST
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "ListExpr" "(" Exprs ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "Slice" "(" Bound "," Bound "," Bound ")"
+                | "Call" "(" Expr "," Exprs ")"
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Bound ::= Expr | "NoBound"
+
+  syntax PyVal ::= "pyInt" "(" Int ")"
+                 | "pyBool" "(" Bool ")"
+                 | "pyList" "(" List ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  configuration
+    <mpy>
+      <k> run($INPUT:PyVal) </k>
+      <program> $PGM:Program </program>
+    </mpy>
+
+  syntax KItem ::= "run" "(" PyVal ")"
+                 | "applyFunction" "(" String "," List ")"
+                 | "applyFound" "(" Function "," List ")"
+                 | "exec" "(" Stmts "," Map ")"
+                 | "eval" "(" Expr "," Map ")"
+                 | "ifResult" "(" Stmts "," Stmts "," Map ")"
+                 | "plusLeft" "(" Expr "," Map ")"
+                 | "plusRight" "(" PyVal ")"
+                 | "compareLeft" "(" String "," Expr "," Map ")"
+                 | "compareRight" "(" String "," PyVal ")"
+                 | "indexResult" "(" Int ")"
+                 | "sliceResult" "(" Int ")"
+                 | "evalCallArgs" "(" String "," Exprs "," Map "," List ")"
+                 | "callArgResult" "(" String "," Exprs "," Map "," List ")"
+                 | "evalListItems" "(" Exprs "," Map "," List ")"
+                 | "listItemResult" "(" Exprs "," Map "," List ")"
+  syntax Function ::= "findFunction" "(" String "," Stmts ")" [function]
+  syntax Map ::= "bind" "(" Params "," List ")" [function]
+  syntax List ::= "dropList" "(" List "," Int ")" [function, total]
+  syntax Int ::= "headInt" "(" List ")" [function, total, smtlib(headInt)]
+  syntax Function ::= "function" "(" Params "," Stmts ")"
+
+  rule dropList(L, 0) => L
+  rule dropList(L, I) => range(L, minInt(I, size(L)), 0)
+    requires I >Int 0
+  rule headInt(ListItem(I:Int) REST) => I
+
+  rule run(V) => applyFunction("sort_even", ListItem(V))
+
+  rule <k> applyFunction(F, VS) => applyFound(findFunction(F, S), VS) ... </k>
+       <program> Module(S) </program>
+  rule applyFound(function(PS, BODY), VS) => exec(BODY, bind(PS, VS))
+
+  rule findFunction(F, FuncDef(F, PS, BODY) REST)
+    => function(PS, BODY)
+  rule findFunction(F, FuncDef(G, PS, BODY) REST)
+    => findFunction(F, REST)
+    requires F =/=String G
+
+  rule bind(Params(.Strings), .List) => .Map
+  rule bind(Params(X, XS), ListItem(V) VS)
+    => (X |-> V) bind(Params(XS), VS)
+
+  rule exec(Return(E) REST, ENV) => eval(E, ENV)
+  rule exec(If(COND, THEN, ELSE) REST, ENV)
+    => eval(COND, ENV) ~> ifResult(THEN, ELSE, ENV)
+  rule pyBool(I ==Int J) ~> ifResult(THEN, ELSE, ENV) => exec(THEN, ENV)
+    requires I ==Int J
+  rule pyBool(I ==Int J) ~> ifResult(THEN, ELSE, ENV) => exec(ELSE, ENV)
+    requires I =/=Int J
+  rule pyBool(I <=Int J) ~> ifResult(THEN, ELSE, ENV) => exec(THEN, ENV)
+    requires I <=Int J
+  rule pyBool(I <=Int J) ~> ifResult(THEN, ELSE, ENV) => exec(ELSE, ENV)
+    requires I >Int J
+
+  rule eval(Int(I), ENV) => pyInt(I)
+  rule eval(Name(X), (X |-> V) REST) => V
+  rule eval(ListExpr(ES), ENV) => evalListItems(ES, ENV, .List)
+  rule eval(BinOp("+", E1, E2), ENV)
+    => eval(E1, ENV) ~> plusLeft(E2, ENV)
+  rule V1:PyVal ~> plusLeft(E2, ENV)
+    => eval(E2, ENV) ~> plusRight(V1)
+  rule pyList(L2) ~> plusRight(pyList(L1)) => pyList(L1 L2)
+
+  rule eval(Compare(E1, CmpOp("==", E2)), ENV)
+    => eval(E1, ENV) ~> compareLeft("==", E2, ENV)
+  rule eval(Compare(E1, CmpOp("<=", E2)), ENV)
+    => eval(E1, ENV) ~> compareLeft("<=", E2, ENV)
+  rule V1:PyVal ~> compareLeft(OP, E2, ENV)
+    => eval(E2, ENV) ~> compareRight(OP, V1)
+  rule pyList(.List) ~> compareRight("==", pyList(L))
+    => pyBool(size(L) ==Int 0)
+  rule pyInt(J) ~> compareRight("==", pyInt(I)) => pyBool(I ==Int J)
+  rule pyInt(J) ~> compareRight("<=", pyInt(I)) => pyBool(I <=Int J)
+
+  rule eval(Subscript(E, Int(I)), ENV)
+    => eval(E, ENV) ~> indexResult(I)
+  rule eval(Subscript(E, Slice(Int(I), NoBound, NoBound)), ENV)
+    => eval(E, ENV) ~> sliceResult(I)
+
+  rule pyList(L) ~> indexResult(I) => pyInt(headInt(dropList(L, I)))
+
+  rule pyList(L) ~> sliceResult(I) => pyList(dropList(L, I))
+
+  rule eval(Call(Name(F), ES), ENV)
+    => evalCallArgs(F, ES, ENV, .List)
+
+  rule evalCallArgs(F, .Exprs, ENV, VS) => applyFunction(F, VS)
+  rule evalCallArgs(F, E, ES, ENV, VS)
+    => eval(E, ENV) ~> callArgResult(F, ES, ENV, VS)
+  rule V:PyVal ~> callArgResult(F, ES, ENV, VS)
+    => evalCallArgs(F, ES, ENV, VS ListItem(V))
+
+  rule evalListItems(.Exprs, ENV, ITEMS) => pyList(ITEMS)
+  rule evalListItems(E, ES, ENV, ITEMS)
+    => eval(E, ENV) ~> listItemResult(ES, ENV, ITEMS)
+  rule pyInt(I) ~> listItemResult(ES, ENV, ITEMS)
+    => evalListItems(ES, ENV, ITEMS ListItem(I))
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..ac06f8a4305107f3bb37e8467d5a1a2e7af0af86
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,36 @@
+def insert_sorted(x, xs):
+    if xs == []:
+        return [x]
+    else:
+        if x <= xs[0]:
+            return [x] + xs
+        else:
+            return [xs[0]] + insert_sorted(x, xs[1:])
+
+
+def sort_values(xs):
+    if xs == []:
+        return []
+    else:
+        return insert_sorted(xs[0], sort_values(xs[1:]))
+
+
+def even_values(l):
+    if l == []:
+        return []
+    else:
+        return [l[0]] + even_values(l[2:])
+
+
+def rebuild(l, evens):
+    if l == []:
+        return []
+    else:
+        if l[1:] == []:
+            return [evens[0]]
+        else:
+            return [evens[0], l[1]] + rebuild(l[2:], evens[1:])
+
+
+def sort_even(l: list):
+    return rebuild(l, sort_values(even_values(l)))
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0ab688bcc2e2488ce444b99dda4341749a02bd45
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,71 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim <k>
+          run(pyList(.List))
+        => pyList(.List)
+        ...
+        </k>
+        <program> solutionProgram() </program>
+    [label(empty-example)]
+
+  claim <k>
+          run(
+            pyList(
+              ListItem(5) ListItem(6)
+              ListItem(3) ListItem(4)))
+        => pyList(
+             ListItem(3) ListItem(6)
+             ListItem(5) ListItem(4))
+        ...
+        </k>
+        <program> solutionProgram() </program>
+    [label(prompt-example)]
+
+  claim <k>
+          applyFunction(
+            "even_values", ListItem(pyList(L)))
+        => pyList(evenPositions(L))
+        ...
+        </k>
+        <program> solutionProgram() </program>
+    [label(even-correct)]
+
+  claim <k>
+          applyFunction(
+            "insert_sorted",
+            ListItem(pyInt(X)) ListItem(pyList(L)))
+        => pyList(insertReference(pyInt(X), L))
+        ...
+        </k>
+        <program> solutionProgram() </program>
+    [label(insert-correct)]
+
+  claim <k>
+          applyFunction(
+            "sort_values", ListItem(pyList(L)))
+        => pyList(sortReference(L))
+        ...
+        </k>
+        <program> solutionProgram() </program>
+    [label(sort-correct)]
+
+  claim <k>
+          applyFunction(
+            "rebuild", ListItem(pyList(L)) ListItem(pyList(EVENS)))
+        => pyList(rebuildReference(L, EVENS))
+        ...
+        </k>
+        <program> solutionProgram() </program>
+    [label(rebuild-correct)]
+
+  claim <k>
+          run(pyList(L))
+        => pyList(sortEvenReference(L))
+        ...
+        </k>
+        <program> solutionProgram() </program>
+    [label(top-correct)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..54f830d00cb99abb892eb2f082524b9a6f22892a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,113 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // This nullary function is the exact constructor term in solution.mpy.
+  syntax Program ::= "solutionProgram" "(" ")" [function]
+  rule solutionProgram() =>
+    Module(
+      FuncDef("insert_sorted", Params("x", "xs"),
+        If(Compare(Name("xs"), CmpOp("==", ListExpr(.Exprs))),
+          Return(ListExpr(Name("x"))),
+          If(Compare(Name("x"), CmpOp("<=", Subscript(Name("xs"), Int(0)))),
+            Return(BinOp("+", ListExpr(Name("x")), Name("xs"))),
+            Return(
+              BinOp(
+                "+",
+                ListExpr(Subscript(Name("xs"), Int(0))),
+                Call(
+                  Name("insert_sorted"),
+                  Name("x"),
+                  Subscript(Name("xs"), Slice(Int(1), NoBound, NoBound))))))))
+      FuncDef("sort_values", Params("xs"),
+        If(Compare(Name("xs"), CmpOp("==", ListExpr(.Exprs))),
+          Return(ListExpr(.Exprs)),
+          Return(
+            Call(
+              Name("insert_sorted"),
+              Subscript(Name("xs"), Int(0)),
+              Call(
+                Name("sort_values"),
+                Subscript(Name("xs"), Slice(Int(1), NoBound, NoBound)))))))
+      FuncDef("even_values", Params("l"),
+        If(Compare(Name("l"), CmpOp("==", ListExpr(.Exprs))),
+          Return(ListExpr(.Exprs)),
+          Return(
+            BinOp(
+              "+",
+              ListExpr(Subscript(Name("l"), Int(0))),
+              Call(
+                Name("even_values"),
+                Subscript(Name("l"), Slice(Int(2), NoBound, NoBound)))))))
+      FuncDef("rebuild", Params("l", "evens"),
+        If(Compare(Name("l"), CmpOp("==", ListExpr(.Exprs))),
+          Return(ListExpr(.Exprs)),
+          If(Compare(
+            Subscript(Name("l"), Slice(Int(1), NoBound, NoBound)),
+            CmpOp("==", ListExpr(.Exprs))),
+            Return(ListExpr(Subscript(Name("evens"), Int(0)))),
+            Return(
+              BinOp(
+                "+",
+                ListExpr(
+                  Subscript(Name("evens"), Int(0)),
+                  Subscript(Name("l"), Int(1))),
+                Call(
+                  Name("rebuild"),
+                  Subscript(Name("l"), Slice(Int(2), NoBound, NoBound)),
+                  Subscript(Name("evens"), Slice(Int(1), NoBound, NoBound))))))))
+      FuncDef("sort_even", Params("l"),
+        Return(
+          Call(
+            Name("rebuild"),
+            Name("l"),
+            Call(Name("sort_values"), Call(Name("even_values"), Name("l")))))))
+
+  // Mathematical reference functions over runtime lists.
+  syntax List ::= "evenPositions" "(" List ")" [function]
+                | "oddPositions" "(" List ")" [function]
+                | "insertReference" "(" PyVal "," List ")" [function]
+                | "sortReference" "(" List ")" [function]
+                | "rebuildReference" "(" List "," List ")" [function]
+                | "sortEvenReference" "(" List ")" [function]
+
+  rule evenPositions(L) => .List
+    requires size(L) ==Int 0
+  rule evenPositions(L)
+    => ListItem(headInt(L)) evenPositions(dropList(L, 2))
+    requires notBool size(L) ==Int 0
+
+  rule oddPositions(L) => evenPositions(dropList(L, 1))
+
+  rule insertReference(pyInt(X), L) => ListItem(X)
+    requires size(L) ==Int 0
+  rule insertReference(pyInt(X), L) => ListItem(X) L
+    requires notBool size(L) ==Int 0
+     andBool X <=Int headInt(L)
+  rule insertReference(pyInt(X), L)
+    => ListItem(headInt(L))
+       insertReference(pyInt(X), dropList(L, 1))
+    requires notBool size(L) ==Int 0
+     andBool notBool X <=Int headInt(L)
+
+  rule sortReference(L) => .List
+    requires size(L) ==Int 0
+  rule sortReference(L)
+    => insertReference(pyInt(headInt(L)), sortReference(dropList(L, 1)))
+    requires notBool size(L) ==Int 0
+
+  rule rebuildReference(L, EVENS) => .List
+    requires size(L) ==Int 0
+  rule rebuildReference(L, EVENS) => ListItem(headInt(EVENS))
+    requires notBool size(L) ==Int 0
+     andBool size(dropList(L, 1)) ==Int 0
+  rule rebuildReference(L, EVENS)
+    => ListItem(headInt(EVENS)) ListItem(headInt(dropList(L, 1)))
+       rebuildReference(dropList(L, 2), dropList(EVENS, 1))
+    requires notBool size(L) ==Int 0
+     andBool notBool size(dropList(L, 1)) ==Int 0
+
+  rule sortEvenReference(L)
+    => rebuildReference(L, sortReference(evenPositions(L)))
+endmodule

