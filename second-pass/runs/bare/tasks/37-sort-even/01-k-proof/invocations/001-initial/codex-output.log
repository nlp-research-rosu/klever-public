+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim <k>
+          run(solutionProgram(), pyList(.List))
+        => pyList(.List)
+        ...
+        </k>
+
+  claim <k>
+          run(
+            solutionProgram(),
+            pyList(
+              ListItem(5) ListItem(6)
+              ListItem(3) ListItem(4)))
+        => pyList(
+             ListItem(3) ListItem(6)
+             ListItem(5) ListItem(4))
+        ...
+        </k>
+
+  claim <k>
+          applyFunction(
+            "even_values", ListItem(pyList(L)), solutionProgram())
+        => pyList(evenPositions(L))
+        ...
+        </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..5ff20fae21a88acb623bf8d548fca6f23e438efe
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,117 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // This nullary function is the exact constructor term in solution.mpy.
+  syntax Program ::= "solutionProgram" "(" ")" [function]
+  rule solutionProgram() =>
+    Module(
+      FuncDef("insert_sorted", Params("x", "xs"),
+        If(Compare(Name("xs"), CmpOp("==", ListExpr(.Exprs))),
+          Return(ListExpr(Name("x"))),
+          If(Compare(Name("x"), CmpOp("<=", Subscript(Name("xs"), Int(0)))),
+            Return(BinOp("+", ListExpr(Name("x")), Name("xs"))),
+            Return(
+              BinOp(
+                "+",
+                ListExpr(Subscript(Name("xs"), Int(0))),
+                Call(
+                  Name("insert_sorted"),
+                  Name("x"),
+                  Subscript(Name("xs"), Slice(Int(1), NoBound, NoBound))))))))
+      FuncDef("sort_values", Params("xs"),
+        If(Compare(Name("xs"), CmpOp("==", ListExpr(.Exprs))),
+          Return(ListExpr(.Exprs)),
+          Return(
+            Call(
+              Name("insert_sorted"),
+              Subscript(Name("xs"), Int(0)),
+              Call(
+                Name("sort_values"),
+                Subscript(Name("xs"), Slice(Int(1), NoBound, NoBound)))))))
+      FuncDef("even_values", Params("l"),
+        If(Compare(Name("l"), CmpOp("==", ListExpr(.Exprs))),
+          Return(ListExpr(.Exprs)),
+          Return(
+            BinOp(
+              "+",
+              ListExpr(Subscript(Name("l"), Int(0))),
+              Call(
+                Name("even_values"),
+                Subscript(Name("l"), Slice(Int(2), NoBound, NoBound)))))))
+      FuncDef("rebuild", Params("l", "evens"),
+        If(Compare(Name("l"), CmpOp("==", ListExpr(.Exprs))),
+          Return(ListExpr(.Exprs)),
+          If(Compare(
+            Subscript(Name("l"), Slice(Int(1), NoBound, NoBound)),
+            CmpOp("==", ListExpr(.Exprs))),
+            Return(ListExpr(Subscript(Name("evens"), Int(0)))),
+            Return(
+              BinOp(
+                "+",
+                ListExpr(
+                  Subscript(Name("evens"), Int(0)),
+                  Subscript(Name("l"), Int(1))),
+                Call(
+                  Name("rebuild"),
+                  Subscript(Name("l"), Slice(Int(2), NoBound, NoBound)),
+                  Subscript(Name("evens"), Slice(Int(1), NoBound, NoBound))))))))
+      FuncDef("sort_even", Params("l"),
+        Return(
+          Call(
+            Name("rebuild"),
+            Name("l"),
+            Call(Name("sort_values"), Call(Name("even_values"), Name("l")))))))
+
+  // Mathematical reference functions over runtime lists.
+  syntax List ::= "evenPositions" "(" List ")" [function]
+                | "oddPositions" "(" List ")" [function]
+                | "insertReference" "(" PyVal "," List ")" [function]
+                | "sortReference" "(" List ")" [function]
+                | "rebuildReference" "(" List "," List ")" [function]
+                | "sortEvenReference" "(" List ")" [function]
+
+  rule evenPositions(L) => .List
+    requires size(L) ==Int 0
+  rule evenPositions(L) => ListItem({L[0]}:>Int)
+    requires size(L) ==Int 1
+  rule evenPositions(L)
+    => ListItem({L[0]}:>Int) evenPositions(range(L, 2, 0))
+    requires size(L) >=Int 2
+
+  rule oddPositions(L) => .List
+    requires size(L) <=Int 1
+  rule oddPositions(L)
+    => ListItem({L[1]}:>Int) oddPositions(range(L, 2, 0))
+    requires size(L) >=Int 2
+
+  rule insertReference(pyInt(X), L) => ListItem(X)
+    requires size(L) ==Int 0
+  rule insertReference(pyInt(X), L) => ListItem(X) L
+    requires size(L) >Int 0
+     andBool X <=Int {L[0]}:>Int
+  rule insertReference(pyInt(X), L)
+    => ListItem({L[0]}:>Int)
+       insertReference(pyInt(X), range(L, 1, 0))
+    requires size(L) >Int 0
+     andBool X >Int {L[0]}:>Int
+
+  rule sortReference(L) => .List
+    requires size(L) ==Int 0
+  rule sortReference(L)
+    => insertReference(pyInt({L[0]}:>Int), sortReference(range(L, 1, 0)))
+    requires size(L) >Int 0
+
+  rule rebuildReference(L, EVENS) => .List
+    requires size(L) ==Int 0
+  rule rebuildReference(L, EVENS) => ListItem({EVENS[0]}:>Int)
+    requires size(L) ==Int 1 andBool size(EVENS) >Int 0
+  rule rebuildReference(L, EVENS)
+    => ListItem({EVENS[0]}:>Int) ListItem({L[1]}:>Int)
+       rebuildReference(range(L, 2, 0), range(EVENS, 1, 0))
+    requires size(L) >=Int 2 andBool size(EVENS) >Int 0
+
+  rule sortEvenReference(L)
+    => rebuildReference(L, sortReference(evenPositions(L)))
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..247225692ba85cccb0ca0315332bdb027bf6a9d9
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,146 @@
+requires "domains.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+  imports LIST
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "ListExpr" "(" Exprs ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "Slice" "(" Bound "," Bound "," Bound ")"
+                | "Call" "(" Expr "," Exprs ")"
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Bound ::= Expr | "NoBound"
+
+  syntax PyVal ::= "pyInt" "(" Int ")"
+                 | "pyBool" "(" Bool ")"
+                 | "pyList" "(" List ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  configuration
+    <mpy>
+      <k> run($PGM:Program, $INPUT:PyVal) </k>
+    </mpy>
+
+  syntax KItem ::= "run" "(" Program "," PyVal ")"
+                 | "applyFunction" "(" String "," List "," Program ")"
+                 | "applyFound" "(" Function "," List "," Program ")"
+                 | "exec" "(" Stmts "," Map "," Program ")"
+                 | "eval" "(" Expr "," Map "," Program ")"
+                 | "ifResult" "(" Stmts "," Stmts "," Map "," Program ")"
+                 | "plusLeft" "(" Expr "," Map "," Program ")"
+                 | "plusRight" "(" PyVal ")"
+                 | "compareLeft" "(" String "," Expr "," Map "," Program ")"
+                 | "compareRight" "(" String "," PyVal ")"
+                 | "indexResult" "(" Int ")"
+                 | "sliceResult" "(" Int ")"
+                 | "evalCallArgs" "(" String "," Exprs "," Map "," Program "," List ")"
+                 | "callArgResult" "(" String "," Exprs "," Map "," Program "," List ")"
+                 | "evalListItems" "(" Exprs "," Map "," Program "," List ")"
+                 | "listItemResult" "(" Exprs "," Map "," Program "," List ")"
+  syntax Function ::= "findFunction" "(" String "," Stmts ")" [function]
+  syntax Map ::= "bind" "(" Params "," List ")" [function]
+  syntax Function ::= "function" "(" Params "," Stmts ")"
+
+  rule run(P, V) => applyFunction("sort_even", ListItem(V), P)
+
+  rule applyFunction(F, VS, Module(S))
+    => applyFound(findFunction(F, S), VS, Module(S))
+  rule applyFound(function(PS, BODY), VS, P) => exec(BODY, bind(PS, VS), P)
+
+  rule findFunction(F, FuncDef(F, PS, BODY) REST)
+    => function(PS, BODY)
+  rule findFunction(F, FuncDef(G, PS, BODY) REST)
+    => findFunction(F, REST)
+    requires F =/=String G
+
+  rule bind(Params(.Strings), .List) => .Map
+  rule bind(Params(X, XS), ListItem(V) VS)
+    => (X |-> V) bind(Params(XS), VS)
+  rule bind(Params(X), ListItem(V)) => X |-> V
+
+  rule exec(Return(E) REST, ENV, P) => eval(E, ENV, P)
+  rule exec(If(COND, THEN, ELSE) REST, ENV, P)
+    => eval(COND, ENV, P) ~> ifResult(THEN, ELSE, ENV, P)
+  rule pyBool(B) ~> ifResult(THEN, ELSE, ENV, P) => exec(THEN, ENV, P)
+    requires B
+  rule pyBool(B) ~> ifResult(THEN, ELSE, ENV, P) => exec(ELSE, ENV, P)
+    requires notBool B
+
+  rule eval(Int(I), ENV, P) => pyInt(I)
+  rule eval(Name(X), (X |-> V) REST, P) => V
+  rule eval(ListExpr(ES), ENV, P) => evalListItems(ES, ENV, P, .List)
+  rule eval(BinOp("+", E1, E2), ENV, P)
+    => eval(E1, ENV, P) ~> plusLeft(E2, ENV, P)
+  rule V1:PyVal ~> plusLeft(E2, ENV, P)
+    => eval(E2, ENV, P) ~> plusRight(V1)
+  rule pyList(L2) ~> plusRight(pyList(L1)) => pyList(L1 L2)
+
+  rule eval(Compare(E1, CmpOp("==", E2)), ENV, P)
+    => eval(E1, ENV, P) ~> compareLeft("==", E2, ENV, P)
+  rule eval(Compare(E1, CmpOp("<=", E2)), ENV, P)
+    => eval(E1, ENV, P) ~> compareLeft("<=", E2, ENV, P)
+  rule V1:PyVal ~> compareLeft(OP, E2, ENV, P)
+    => eval(E2, ENV, P) ~> compareRight(OP, V1)
+  rule pyList(.List) ~> compareRight("==", pyList(L))
+    => pyBool(size(L) ==Int 0)
+  rule pyInt(J) ~> compareRight("==", pyInt(I)) => pyBool(I ==Int J)
+  rule pyInt(J) ~> compareRight("<=", pyInt(I)) => pyBool(I <=Int J)
+
+  rule eval(Subscript(E, Int(I)), ENV, P)
+    => eval(E, ENV, P) ~> indexResult(I)
+  rule eval(Subscript(E, Slice(Int(I), NoBound, NoBound)), ENV, P)
+    => eval(E, ENV, P) ~> sliceResult(I)
+
+  rule pyList(L) ~> indexResult(I) => pyInt({L[I]}:>Int)
+    requires 0 <=Int I andBool I <Int size(L)
+
+  rule pyList(L) ~> sliceResult(I) => pyList(range(L, I, 0))
+    requires 0 <=Int I andBool I <=Int size(L)
+  rule pyList(L) ~> sliceResult(I) => pyList(.List)
+    requires I >Int size(L)
+
+  rule eval(Call(Name(F), ES), ENV, P)
+    => evalCallArgs(F, ES, ENV, P, .List)
+
+  rule evalCallArgs(F, .Exprs, ENV, P, VS) => applyFunction(F, VS, P)
+  rule evalCallArgs(F, E, ENV, P, VS)
+    => eval(E, ENV, P) ~> callArgResult(F, .Exprs, ENV, P, VS)
+  rule evalCallArgs(F, E, ES, ENV, P, VS)
+    => eval(E, ENV, P) ~> callArgResult(F, ES, ENV, P, VS)
+  rule V:PyVal ~> callArgResult(F, ES, ENV, P, VS)
+    => evalCallArgs(F, ES, ENV, P, VS ListItem(V))
+
+  rule evalListItems(.Exprs, ENV, P, ITEMS) => pyList(ITEMS)
+  rule evalListItems(E, ENV, P, ITEMS)
+    => eval(E, ENV, P) ~> listItemResult(.Exprs, ENV, P, ITEMS)
+  rule evalListItems(E, ES, ENV, P, ITEMS)
+    => eval(E, ENV, P) ~> listItemResult(ES, ENV, P, ITEMS)
+  rule pyInt(I) ~> listItemResult(ES, ENV, P, ITEMS)
+    => evalListItems(ES, ENV, P, ITEMS ListItem(I))
+endmodule
