diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..247225692ba85cccb0ca0315332bdb027bf6a9d9
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,146 @@
+requires "domains.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+  imports LIST
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "ListExpr" "(" Exprs ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "Slice" "(" Bound "," Bound "," Bound ")"
+                | "Call" "(" Expr "," Exprs ")"
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Bound ::= Expr | "NoBound"
+
+  syntax PyVal ::= "pyInt" "(" Int ")"
+                 | "pyBool" "(" Bool ")"
+                 | "pyList" "(" List ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  configuration
+    <mpy>
+      <k> run($PGM:Program, $INPUT:PyVal) </k>
+    </mpy>
+
+  syntax KItem ::= "run" "(" Program "," PyVal ")"
+                 | "applyFunction" "(" String "," List "," Program ")"
+                 | "applyFound" "(" Function "," List "," Program ")"
+                 | "exec" "(" Stmts "," Map "," Program ")"
+                 | "eval" "(" Expr "," Map "," Program ")"
+                 | "ifResult" "(" Stmts "," Stmts "," Map "," Program ")"
+                 | "plusLeft" "(" Expr "," Map "," Program ")"
+                 | "plusRight" "(" PyVal ")"
+                 | "compareLeft" "(" String "," Expr "," Map "," Program ")"
+                 | "compareRight" "(" String "," PyVal ")"
+                 | "indexResult" "(" Int ")"
+                 | "sliceResult" "(" Int ")"
+                 | "evalCallArgs" "(" String "," Exprs "," Map "," Program "," List ")"
+                 | "callArgResult" "(" String "," Exprs "," Map "," Program "," List ")"
+                 | "evalListItems" "(" Exprs "," Map "," Program "," List ")"
+                 | "listItemResult" "(" Exprs "," Map "," Program "," List ")"
+  syntax Function ::= "findFunction" "(" String "," Stmts ")" [function]
+  syntax Map ::= "bind" "(" Params "," List ")" [function]
+  syntax Function ::= "function" "(" Params "," Stmts ")"
+
+  rule run(P, V) => applyFunction("sort_even", ListItem(V), P)
+
+  rule applyFunction(F, VS, Module(S))
+    => applyFound(findFunction(F, S), VS, Module(S))
+  rule applyFound(function(PS, BODY), VS, P) => exec(BODY, bind(PS, VS), P)
+
+  rule findFunction(F, FuncDef(F, PS, BODY) REST)
+    => function(PS, BODY)
+  rule findFunction(F, FuncDef(G, PS, BODY) REST)
+    => findFunction(F, REST)
+    requires F =/=String G
+
+  rule bind(Params(.Strings), .List) => .Map
+  rule bind(Params(X, XS), ListItem(V) VS)
+    => (X |-> V) bind(Params(XS), VS)
+  rule bind(Params(X), ListItem(V)) => X |-> V
+
+  rule exec(Return(E) REST, ENV, P) => eval(E, ENV, P)
+  rule exec(If(COND, THEN, ELSE) REST, ENV, P)
+    => eval(COND, ENV, P) ~> ifResult(THEN, ELSE, ENV, P)
+  rule pyBool(B) ~> ifResult(THEN, ELSE, ENV, P) => exec(THEN, ENV, P)
+    requires B
+  rule pyBool(B) ~> ifResult(THEN, ELSE, ENV, P) => exec(ELSE, ENV, P)
+    requires notBool B
+
+  rule eval(Int(I), ENV, P) => pyInt(I)
+  rule eval(Name(X), (X |-> V) REST, P) => V
+  rule eval(ListExpr(ES), ENV, P) => evalListItems(ES, ENV, P, .List)
+  rule eval(BinOp("+", E1, E2), ENV, P)
+    => eval(E1, ENV, P) ~> plusLeft(E2, ENV, P)
+  rule V1:PyVal ~> plusLeft(E2, ENV, P)
+    => eval(E2, ENV, P) ~> plusRight(V1)
+  rule pyList(L2) ~> plusRight(pyList(L1)) => pyList(L1 L2)
+
+  rule eval(Compare(E1, CmpOp("==", E2)), ENV, P)
+    => eval(E1, ENV, P) ~> compareLeft("==", E2, ENV, P)
+  rule eval(Compare(E1, CmpOp("<=", E2)), ENV, P)
+    => eval(E1, ENV, P) ~> compareLeft("<=", E2, ENV, P)
+  rule V1:PyVal ~> compareLeft(OP, E2, ENV, P)
+    => eval(E2, ENV, P) ~> compareRight(OP, V1)
+  rule pyList(.List) ~> compareRight("==", pyList(L))
+    => pyBool(size(L) ==Int 0)
+  rule pyInt(J) ~> compareRight("==", pyInt(I)) => pyBool(I ==Int J)
+  rule pyInt(J) ~> compareRight("<=", pyInt(I)) => pyBool(I <=Int J)
+
+  rule eval(Subscript(E, Int(I)), ENV, P)
+    => eval(E, ENV, P) ~> indexResult(I)
+  rule eval(Subscript(E, Slice(Int(I), NoBound, NoBound)), ENV, P)
+    => eval(E, ENV, P) ~> sliceResult(I)
+
+  rule pyList(L) ~> indexResult(I) => pyInt({L[I]}:>Int)
+    requires 0 <=Int I andBool I <Int size(L)
+
+  rule pyList(L) ~> sliceResult(I) => pyList(range(L, I, 0))
+    requires 0 <=Int I andBool I <=Int size(L)
+  rule pyList(L) ~> sliceResult(I) => pyList(.List)
+    requires I >Int size(L)
+
+  rule eval(Call(Name(F), ES), ENV, P)
+    => evalCallArgs(F, ES, ENV, P, .List)
+
+  rule evalCallArgs(F, .Exprs, ENV, P, VS) => applyFunction(F, VS, P)
+  rule evalCallArgs(F, E, ENV, P, VS)
+    => eval(E, ENV, P) ~> callArgResult(F, .Exprs, ENV, P, VS)
+  rule evalCallArgs(F, E, ES, ENV, P, VS)
+    => eval(E, ENV, P) ~> callArgResult(F, ES, ENV, P, VS)
+  rule V:PyVal ~> callArgResult(F, ES, ENV, P, VS)
+    => evalCallArgs(F, ES, ENV, P, VS ListItem(V))
+
+  rule evalListItems(.Exprs, ENV, P, ITEMS) => pyList(ITEMS)
+  rule evalListItems(E, ENV, P, ITEMS)
+    => eval(E, ENV, P) ~> listItemResult(.Exprs, ENV, P, ITEMS)
+  rule evalListItems(E, ES, ENV, P, ITEMS)
+    => eval(E, ENV, P) ~> listItemResult(ES, ENV, P, ITEMS)
+  rule pyInt(I) ~> listItemResult(ES, ENV, P, ITEMS)
+    => evalListItems(ES, ENV, P, ITEMS ListItem(I))
+endmodule
