+requires "domains.k"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+  imports LIST
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "ListExpr" "(" Exprs ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Subscript" "(" Expr "," Expr ")"
+                | "Slice" "(" Bound "," Bound "," Bound ")"
+                | "Call" "(" Expr "," Exprs ")"
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax Bound ::= Expr | "NoBound"
+
+  syntax PyVal ::= "pyInt" "(" Int ")"
+                 | "pyBool" "(" Bool ")"
+                 | "pyList" "(" List ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  configuration
+    <mpy>
+      <k> run($PGM:Program, $INPUT:PyVal) </k>
+    </mpy>
+
+  syntax KItem ::= "run" "(" Program "," PyVal ")"
+  syntax PyVal ::= "applyFunction" "(" String "," List "," Program ")" [function]
+                 | "applyFound" "(" Function "," List "," Program ")" [function]
+                 | "eval" "(" Expr "," Map "," Program ")" [function]
+                 | "exec" "(" Stmts "," Map "," Program ")" [function]
+                 | "concat" "(" PyVal "," PyVal ")" [function]
+                 | "lessThanEq" "(" PyVal "," PyVal ")" [function]
+                 | "index" "(" PyVal "," Int ")" [function]
+                 | "sliceFrom" "(" PyVal "," Int ")" [function]
+                 | "choose" "(" PyVal "," Stmts "," Stmts "," Map "," Program ")"
+  syntax Function ::= "findFunction" "(" String "," Stmts ")" [function]
+  syntax List ::= "evalExprs" "(" Exprs "," Map "," Program ")" [function]
+                | "evalListItems" "(" Exprs "," Map "," Program ")" [function]
+  syntax Map ::= "bind" "(" Params "," List ")" [function]
+  syntax Bool ::= "valueEquals" "(" PyVal "," PyVal ")" [function]
+  syntax Int ::= "unboxInt" "(" PyVal ")" [function]
+  syntax Function ::= "function" "(" Params "," Stmts ")"
+
+  rule run(P, V) => applyFunction("sort_even", ListItem(V), P)
+
+  rule applyFunction(F, VS, Module(S))
+    => applyFound(findFunction(F, S), VS, Module(S))
+  rule applyFound(function(PS, BODY), VS, P) => exec(BODY, bind(PS, VS), P)
+
+  rule findFunction(F, FuncDef(F, PS, BODY) REST)
+    => function(PS, BODY)
+  rule findFunction(F, FuncDef(G, PS, BODY) REST)
+    => findFunction(F, REST)
+    requires F =/=String G
+
+  rule bind(Params(.Strings), .List) => .Map
+  rule bind(Params(X, XS), ListItem(V) VS)
+    => (X |-> V) bind(Params(XS), VS)
+  rule bind(Params(X), ListItem(V)) => X |-> V
+
+  rule exec(Return(E) REST, ENV, P) => eval(E, ENV, P)
+  rule exec(If(COND, THEN, ELSE) REST, ENV, P)
+    => choose(eval(COND, ENV, P), THEN, ELSE, ENV, P)
+  rule choose(pyBool(B), THEN, ELSE, ENV, P) => exec(THEN, ENV, P)
+    requires B
+  rule choose(pyBool(B), THEN, ELSE, ENV, P) => exec(ELSE, ENV, P)
+    requires notBool B
+
+  rule eval(Int(I), ENV, P) => pyInt(I)
+  rule eval(Name(X), (X |-> V) REST, P) => V
+  rule eval(ListExpr(ES), ENV, P) => pyList(evalListItems(ES, ENV, P))
+  rule eval(BinOp("+", E1, E2), ENV, P)
+    => concat(eval(E1, ENV, P), eval(E2, ENV, P))
+  rule concat(pyList(L1), pyList(L2)) => pyList(L1 L2)
+
+  rule eval(Compare(E1, CmpOp("==", E2)), ENV, P)
+    => pyBool(valueEquals(eval(E1, ENV, P), eval(E2, ENV, P)))
+  rule eval(Compare(E1, CmpOp("<=", E2)), ENV, P)
+    => lessThanEq(eval(E1, ENV, P), eval(E2, ENV, P))
+  rule lessThanEq(pyInt(I), pyInt(J)) => pyBool(I <=Int J)
+
+  rule valueEquals(pyList(L), pyList(.List)) => size(L) ==Int 0
+  rule valueEquals(pyInt(I), pyInt(J)) => I ==Int J
+
+  rule eval(Subscript(E, Int(I)), ENV, P) => index(eval(E, ENV, P), I)
+  rule eval(Subscript(E, Slice(Int(I), NoBound, NoBound)), ENV, P)
+    => sliceFrom(eval(E, ENV, P), I)
+
+  rule index(pyList(L), I) => pyInt({L[I]}:>Int)
+    requires 0 <=Int I andBool I <Int size(L)
+
+  rule sliceFrom(pyList(L), I) => pyList(range(L, I, 0))
+    requires 0 <=Int I andBool I <=Int size(L)
+  rule sliceFrom(pyList(L), I) => pyList(.List)
+    requires I >Int size(L)
+
+  rule eval(Call(Name(F), ES), ENV, P)
+    => applyFunction(F, evalExprs(ES, ENV, P), P)
+
+  rule evalExprs(.Exprs, ENV, P) => .List
+  rule evalExprs(E, ENV, P) => ListItem(eval(E, ENV, P))
+  rule evalExprs(E, ES, ENV, P)
+    => ListItem(eval(E, ENV, P)) evalExprs(ES, ENV, P)
+
+  rule unboxInt(pyInt(I)) => I
+  rule evalListItems(.Exprs, ENV, P) => .List
+  rule evalListItems(E, ENV, P) => ListItem(unboxInt(eval(E, ENV, P)))
+  rule evalListItems(E, ES, ENV, P)
+    => ListItem(unboxInt(eval(E, ENV, P))) evalListItems(ES, ENV, P)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..ac06f8a4305107f3bb37e8467d5a1a2e7af0af86
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,36 @@
+def insert_sorted(x, xs):
+    if xs == []:
+        return [x]
+    else:
+        if x <= xs[0]:
+            return [x] + xs
+        else:
+            return [xs[0]] + insert_sorted(x, xs[1:])
+
+
+def sort_values(xs):
+    if xs == []:
+        return []
+    else:
+        return insert_sorted(xs[0], sort_values(xs[1:]))
+
+
+def even_values(l):
+    if l == []:
+        return []
+    else:
+        return [l[0]] + even_values(l[2:])
+
+
+def rebuild(l, evens):
+    if l == []:
+        return []
+    else:
+        if l[1:] == []:
+            return [evens[0]]
+        else:
+            return [evens[0], l[1]] + rebuild(l[2:], evens[1:])
+
+
+def sort_even(l: list):
+    return rebuild(l, sort_values(even_values(l)))
