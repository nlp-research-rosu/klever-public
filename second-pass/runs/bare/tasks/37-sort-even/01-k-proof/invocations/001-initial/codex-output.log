+module SPEC
+  imports VERIFICATION
+
+  claim <k>
+          run(solutionProgram(), pyList(.List))
+        => pyList(.List)
+        ...
+        </k>
+
+  claim <k>
+          run(
+            solutionProgram(),
+            pyList(
+              ListItem(5) ListItem(6)
