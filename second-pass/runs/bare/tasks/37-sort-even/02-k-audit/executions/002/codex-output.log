   114	    => eval(E1, ENV) ~> plusLeft(E2, ENV)
   115	  rule V1:PyVal ~> plusLeft(E2, ENV)
   116	    => eval(E2, ENV) ~> plusRight(V1)
   117	  rule pyList(L2) ~> plusRight(pyList(L1)) => pyList(L1 L2)
   118	
   119	  rule eval(Compare(E1, CmpOp("==", E2)), ENV)
   120	    => eval(E1, ENV) ~> compareLeft("==", E2, ENV)
   121	  rule eval(Compare(E1, CmpOp("<=", E2)), ENV)
   122	    => eval(E1, ENV) ~> compareLeft("<=", E2, ENV)
   123	  rule V1:PyVal ~> compareLeft(OP, E2, ENV)
