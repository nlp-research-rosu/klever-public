+    ["b", "odd", "a"],
+    ["z", "x", "m", "y", "a"],
+    [2.5, 99.0, -1.25, 0.0],
+    [True, False, False],
+]
+for index, generic_case in enumerate(generic_cases, 1):
+    check(generic_case, f"generic-orderable-{index}")
+
+print(f"total_cases={checked} mismatches=0 contract_failures=0")
