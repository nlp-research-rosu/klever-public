/bin/bash -lc 'set -u
log=/audit-output/evidence/stage3-individual-kprove.log
: > "$log"
any_fail=0
for label in empty-example prompt-example first-prompt-example symbolic-four-ordered symbolic-four-reversed even-correct insert-correct sort-correct rebuild-correct top-correct; do
  echo "CLAIM=$label" | tee -a "$log"
  echo "COMMAND: kprove spec.k --definition verification-kompiled --spec-module SPEC --claims $label -w none" | tee -a "$log"
  set -o pipefail
  kprove spec.k --definition verification-kompiled --spec-module SPEC --claims "$label" -w none 2>&1 | tee -a "$log"
  status=${PIPESTATUS[0]}
  echo "EXIT_STATUS=$status" | tee -a "$log"
  if [ "$status" -ne 0 ]; then any_fail=1; fi
done
exit "$any_fail"' in /tmp/audit-work/37-sort-even
