+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // False for the satisfying input [5, 6, 3, 4]: the real result begins with
+  // 3, not 4.  This mutates a result-bearing obligation only.
+  claim <k>
+          run(
