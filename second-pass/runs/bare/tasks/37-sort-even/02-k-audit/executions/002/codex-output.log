trace_custom_call[11]=exec const patch = "*** Begin Patch\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module VERIFICATION\n+  imports MPY\n+\n+  // This nullary function is the exact constructor term in solution.mpy.\n+  syntax Program ::= \"solutionProgram\" \"(\" \")\" [function]\n+  rule solutionProgram() =>\n+    Module(\n+      FuncDef(\"insert_sorted\", Params(\"x\", \"xs\"),\n+        If(Compare(Name(\"xs\"), CmpOp(\"==\", ListExpr())),\n+          Return(ListExpr(Name(\"x\"))),\n+          If(Compare(Name(\"x\"), CmpOp(\"<=\", Subscript(Name(\"xs\"), Int(0)))),\n+            Return(BinOp(\"+\", ListExpr(Name(\"x\")), Name(\"xs\"))),\n+            Return(\n+              BinOp(\n+                \"+\",\n+                ListExpr(Subscript(Name(\"xs\"), Int(0))),\n+                Call(\n+                  Name(\"insert_sorted\"),\n+                  Name(\"x\"),\n+                  Subscript(Name(\"xs\"), Slice(Int(1), NoBound, NoBound))))))))\n+      FuncDef(\"sort_values\", Params(\"xs\"),\n+        If(Compare(Name(\"xs\"), CmpOp(\"==\", ListExpr())),\n+          Return(ListExpr()),\n+          Return(\n+            Call(\n+              Name(\"insert_sorted\"),\n+              Subscript(Name(\"xs\"), Int(0)),\n+              Call(\n+                Name(\"sort_values\"),\n+                Subscript(Name(\"xs\"), Slice(Int(1), NoBound, NoBound)))))))\n+      FuncDef(\"even_values\", Params(\"l\"),\n+        If(Compare(Name(\"l\"), CmpOp(\"==\", ListExpr())),\n+          Return(ListExpr()),\n+          Return(\n+            BinOp(\n+              \"+\",\n+              ListExpr(Subscript(Name(\"l\"), Int(0))),\n+              Call(\n+                Name(\"even_values\"),\n+                Subscript(Name(\"l\"), Slice(Int(2), NoBound, NoBound)))))))\n+      FuncDef(\"rebuild\", Params(\"l\", \"evens\"),\n+        If(Compare(Name(\"l\"), CmpOp(\"==\", ListExpr())),\n+          Return(ListExpr()),\n+          If(Compare(\n+            Subscript(Name(\"l\"), Slice(Int(1), NoBound, NoBound)),\n+            CmpOp(\"==\", ListExpr())),\n+            Return(ListExpr(Subscript(Name(\"evens\"), Int(0)))),\n+            Return(\n+              BinOp(\n+                \"+\",\n+                ListExpr(\n+                  Subscript(Name(\"evens\"), Int(0)),\n+                  Subscript(Name(\"l\"), Int(1))),\n+                Call(\n+                  Name(\"rebuild\"),\n+                  Subscript(Name(\"l\"), Slice(Int(2), NoBound, NoBound)),\n+                  Subscript(Name(\"evens\"), Slice(Int(1), NoBound, NoBound))))))))\n+      FuncDef(\"sort_even\", Params(\"l\"),\n+        Return(\n+          Call(\n+            Name(\"rebuild\"),\n+            Name(\"l\"),\n+            Call(Name(\"sort_values\"), Call(Name(\"even_values\"), Name(\"l\")))))))\n+\n+  // Mathematical reference functions over runtime lists.\n+  syntax List ::= \"evenPositions\" \"(\" List \")\" [function]\n+                | \"oddPositions\" \"(\" List \")\" [function]\n+                | \"insertReference\" \"(\" PyVal \",\" List \")\" [function]\n+                | \"sortReference\" \"(\" List \")\" [function]\n+                | \"rebuildReference\" \"(\" List \",\" List \")\" [function]\n+                | \"sortEvenReference\" \"(\" List \")\" [function]\n+\n+  rule evenPositions(.List) => .List\n+  rule evenPositions(ListItem(X)) => ListItem(X)\n+  rule evenPositions(ListItem(X) ListItem(Y) REST)\n+    => ListItem(X) evenPositions(REST)\n+\n+  rule oddPositions(.List) => .List\n+  rule oddPositions(ListItem(X)) => .List\n+  rule oddPositions(ListItem(X) ListItem(Y) REST)\n+    => ListItem(Y) oddPositions(REST)\n+\n+  rule insertReference(X, .List) => ListItem(X)\n+  rule insertReference(pyInt(X), ListItem(pyInt(Y)) REST)\n+    => ListItem(pyInt(X)) ListItem(pyInt(Y)) REST\n+    requires X <=Int Y\n+  rule insertReference(pyInt(X), ListItem(pyInt(Y)) REST)\n+    => ListItem(pyInt(Y)) insertReference(pyInt(X), REST)\n+    requires X >Int Y\n+\n+  rule sortReference(.List) => .List\n+  rule sortReference(ListItem(X) REST)\n+    => insertReference(X, sortReference(REST))\n+\n+  rule rebuildReference(.List, .List) => .List\n+  rule rebuildReference(ListItem(OLD), ListItem(NEW)) => ListItem(NEW)\n+  rule rebuildReference(\n+         ListItem(OLD) ListItem(ODD) REST,\n+         ListItem(NEW) EVENS)\n+    => ListItem(NEW) ListItem(ODD) rebuildReference(REST, EVENS)\n+\n+  rule sortEvenReference(L)\n+    => rebuildReference(L, sortReference(evenPositions(L)))\n+endmodule\n*** End Patch";\nconst a = await tools.apply_patch(patch);\nconst r = await tools.exec_command({cmd:"kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX","workdir":"/work","yield_time_ms":30000,"max_output_tokens":30000});\ntext(a);\ntext(r.output);\nif (r.session_id) text(`SESSION_ID=${r.session_id}`);
