  echo '"'COMMAND: cmp -s regenerated-solution.mpy solution.mpy'
  cmp -s /tmp/audit-work/37-sort-even/regenerated-solution.mpy /tmp/audit-work/37-sort-even/solution.mpy
  cmp_exit="'$?
  echo "byte_identity_cmp_exit=$cmp_exit"
  sha256sum /tmp/audit-work/37-sort-even/regenerated-solution.mpy /tmp/audit-work/37-sort-even/solution.mpy
  echo '"'COMMAND: python3 /audit-output/evidence/differential_test.py'
  python3 /audit-output/evidence/differential_test.py
  differential_exit="'$?
  echo "differential_exit=$differential_exit"
} 2>&1 | tee /audit-output/evidence/stage2-fidelity-and-differential.txt
printf '"'STAGE2_PIPESTATUS=%s\\n' \""'${PIPESTATUS[*]}"' in /audit-output
