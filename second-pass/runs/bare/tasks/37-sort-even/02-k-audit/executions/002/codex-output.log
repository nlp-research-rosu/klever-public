    98	  rule exec(Return(E) _REST, ENV) => eval(E, ENV)
    99	  rule exec(If(COND, THEN, ELSE) _REST, ENV)
   100	    => eval(COND, ENV) ~> ifResult(THEN, ELSE, ENV)
   101	  rule comparison("==", I, J) ~> ifResult(THEN, _ELSE, ENV) => exec(THEN, ENV)
   102	    requires I ==Int J
   103	  rule comparison("==", I, J) ~> ifResult(_THEN, ELSE, ENV) => exec(ELSE, ENV)
   104	    requires I =/=Int J
   105	  rule comparison("<=", I, J) ~> ifResult(THEN, _ELSE, ENV) => exec(THEN, ENV)
   106	    requires I <=Int J
   107	  rule comparison("<=", I, J) ~> ifResult(_THEN, ELSE, ENV) => exec(ELSE, ENV)
   108	    requires I >Int J
   109	
   110	  rule eval(Int(I), _ENV) => pyInt(I)
