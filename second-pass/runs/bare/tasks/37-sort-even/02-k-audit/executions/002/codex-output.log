trace_custom_call[4]=exec const patch = "*** Begin Patch\n*** Add File: /work/semantic.k\n+requires \"domains.k\"\n+\n+module MPY-SYNTAX\n+  imports INT-SYNTAX\n+  imports BOOL-SYNTAX\n+  imports STRING-SYNTAX\n+\n+  syntax Program ::= \"Module\" \"(\" Stmts \")\"\n+\n+  syntax Stmts ::= List{Stmt, \"\"}\n+  syntax Stmt ::= \"FuncDef\" \"(\" String \",\" Params \",\" Stmts \")\"\n+                | \"Return\" \"(\" Expr \")\"\n+                | \"If\" \"(\" Expr \",\" Stmts \",\" Stmts \")\"\n+\n+  syntax Params ::= \"Params\" \"(\" Strings \")\"\n+  syntax Strings ::= List{String, \",\"}\n+\n+  syntax Exprs ::= List{Expr, \",\"}\n+  syntax Expr ::= \"Int\" \"(\" Int \")\"\n+                | \"Name\" \"(\" String \")\"\n+                | \"ListExpr\" \"(\" Exprs \")\"\n+                | \"BinOp\" \"(\" String \",\" Expr \",\" Expr \")\"\n+                | \"Compare\" \"(\" Expr \",\" CmpOps \")\"\n+                | \"Subscript\" \"(\" Expr \",\" Expr \")\"\n+                | \"Slice\" \"(\" Bound \",\" Bound \",\" Bound \")\"\n+                | \"Call\" \"(\" Expr \",\" Exprs \")\"\n+  syntax CmpOps ::= List{CmpOp, \",\"}\n+  syntax CmpOp ::= \"CmpOp\" \"(\" String \",\" Expr \")\"\n+  syntax Bound ::= Expr | \"NoBound\"\n+\n+  syntax PyVal ::= \"pyInt\" \"(\" Int \")\"\n+                 | \"pyBool\" \"(\" Bool \")\"\n+                 | \"pyList\" \"(\" List \")\"\n+endmodule\n+\n+module MPY\n+  imports MPY-SYNTAX\n+  imports INT\n+  imports BOOL\n+  imports STRING\n+  imports MAP\n+  imports LIST\n+\n+  configuration\n+    <mpy>\n+      <k> run($PGM:Program, $INPUT:PyVal) </k>\n+    </mpy>\n+\n+  syntax KItem ::= \"run\" \"(\" Program \",\" PyVal \")\"\n+                 | \"applyFunction\" \"(\" String \",\" List \",\" Program \")\"\n+                 | \"eval\" \"(\" Expr \",\" Map \",\" Program \")\"\n+                 | \"exec\" \"(\" Stmts \",\" Map \",\" Program \")\"\n+                 | \"findFunction\" \"(\" String \",\" Stmts \")\"\n+                 | \"evalExprs\" \"(\" Exprs \",\" Map \",\" Program \")\"\n+                 | \"bind\" \"(\" Params \",\" List \")\"\n+                 | \"valueEquals\" \"(\" PyVal \",\" PyVal \")\"\n+                 | \"index\" \"(\" PyVal \",\" Int \")\"\n+                 | \"sliceFrom\" \"(\" PyVal \",\" Int \")\"\n+  syntax Function ::= \"function\" \"(\" Params \",\" Stmts \")\"\n+\n+  rule run(P, V) => applyFunction(\"sort_even\", ListItem(V), P)\n+\n+  rule applyFunction(F, VS, Module(S))\n+    => applyFound(findFunction(F, S), VS, Module(S))\n+  syntax KItem ::= \"applyFound\" \"(\" Function \",\" List \",\" Program \")\"\n+  rule applyFound(function(PS, BODY), VS, P) => exec(BODY, bind(PS, VS), P)\n+\n+  rule findFunction(F, FuncDef(F, PS, BODY) REST)\n+    => function(PS, BODY)\n+  rule findFunction(F, FuncDef(G, PS, BODY) REST)\n+    => findFunction(F, REST)\n+    requires F =/=String G\n+\n+  rule bind(Params(.Strings), .List) => .Map\n+  rule bind(Params(X, XS), ListItem(V) VS)\n+    => (X |-> V) bind(Params(XS), VS)\n+  rule bind(Params(X), ListItem(V)) => X |-> V\n+\n+  rule exec(Return(E) REST, ENV, P) => eval(E, ENV, P)\n+  rule exec(If(COND, THEN, ELSE) REST, ENV, P)\n+    => exec(THEN, ENV, P)\n+    requires eval(COND, ENV, P) ==K pyBool(true)\n+  rule exec(If(COND, THEN, ELSE) REST, ENV, P)\n+    => exec(ELSE, ENV, P)\n+    requires eval(COND, ENV, P) ==K pyBool(false)\n+\n+  rule eval(Int(I), ENV, P) => pyInt(I)\n+  rule eval(Name(X), (X |-> V) REST, P) => V\n+  rule eval(ListExpr(ES), ENV, P) => pyList(evalExprs(ES, ENV, P))\n+  rule eval(BinOp(\"+\", E1, E2), ENV, P)\n+    => concat(eval(E1, ENV, P), eval(E2, ENV, P))\n+  syntax KItem ::= \"concat\" \"(\" PyVal \",\" PyVal \")\"\n+  rule concat(pyList(L1), pyList(L2)) => pyList(L1 L2)\n+\n+  rule eval(Compare(E1, CmpOp(\"==\", E2)), ENV, P)\n+    => pyBool(valueEquals(eval(E1, ENV, P), eval(E2, ENV, P)))\n+  rule eval(Compare(E1, CmpOp(\"<=\", E2)), ENV, P)\n+    => lessThanEq(eval(E1, ENV, P), eval(E2, ENV, P))\n+  syntax KItem ::= \"lessThanEq\" \"(\" PyVal \",\" PyVal \")\"\n+  rule lessThanEq(pyInt(I), pyInt(J)) => pyBool(I <=Int J)\n+\n+  rule valueEquals(pyList(.List), pyList(.List)) => true\n+  rule valueEquals(pyList(ListItem(V) REST), pyList(.List)) => false\n+  rule valueEquals(pyList(.List), pyList(ListItem(V) REST)) => false\n+  rule valueEquals(pyInt(I), pyInt(J)) => I ==Int J\n+\n+  rule eval(Subscript(E, Int(I)), ENV, P) => index(eval(E, ENV, P), I)\n+  rule eval(Subscript(E, Slice(Int(I), NoBound, NoBound)), ENV, P)\n+    => sliceFrom(eval(E, ENV, P), I)\n+\n+  rule index(pyList(ListItem(V) REST), 0) => V\n+  rule index(pyList(ListItem(V0) ListItem(V1) REST), 1) => V1\n+\n+  rule sliceFrom(pyList(L), 0) => pyList(L)\n+  rule sliceFrom(pyList(.List), I) => pyList(.List) requires I >Int 0\n+  rule sliceFrom(pyList(ListItem(V) REST), I)\n+    => sliceFrom(pyList(REST), I -Int 1)\n+    requires I >Int 0\n+\n+  rule eval(Call(Name(F), ES), ENV, P)\n+    => applyFunction(F, evalExprs(ES, ENV, P), P)\n+\n+  rule evalExprs(.Exprs, ENV, P) => .List\n+  rule evalExprs(E, ENV, P) => ListItem(eval(E, ENV, P))\n+  rule evalExprs(E, ES, ENV, P)\n+    => ListItem(eval(E, ENV, P)) evalExprs(ES, ENV, P)\n+endmodule\n*** End Patch";\nconst a = await tools.apply_patch(patch);\nconst r = await tools.exec_command({cmd:"kompile semantic.k --backend haskell --main-module MPY --syntax-module MPY-SYNTAX","workdir":"/work","yield_time_ms":30000,"max_output_tokens":30000});\ntext(a);\ntext(r.output);\nif (r.session_id) text(`SESSION_ID=${r.session_id}`);
