     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // This nullary function is the exact constructor term in solution.mpy.
     7	  syntax Program ::= "solutionProgram" "(" ")" [function]
     8	  rule solutionProgram() =>
     9	    Module(
    10	      FuncDef("insert_sorted", Params("x", "xs"),
    11	        If(Compare(Name("xs"), CmpOp("==", ListExpr(.Exprs))),
    12	          Return(ListExpr(Name("x"))),
    13	          If(Compare(Name("x"), CmpOp("<=", Subscript(Name("xs"), Int(0)))),
    14	            Return(BinOp("+", ListExpr(Name("x")), Name("xs"))),
    15	            Return(
    16	              BinOp(
    17	                "+",
    18	                ListExpr(Subscript(Name("xs"), Int(0))),
    19	                Call(
    20	                  Name("insert_sorted"),
    21	                  Name("x"),
    22	                  Subscript(Name("xs"), Slice(Int(1), NoBound, NoBound))))))))
    23	      FuncDef("sort_values", Params("xs"),
    24	        If(Compare(Name("xs"), CmpOp("==", ListExpr(.Exprs))),
    25	          Return(ListExpr(.Exprs)),
    26	          Return(
    27	            Call(
    28	              Name("insert_sorted"),
    29	              Subscript(Name("xs"), Int(0)),
    30	              Call(
    31	                Name("sort_values"),
    32	                Subscript(Name("xs"), Slice(Int(1), NoBound, NoBound)))))))
    33	      FuncDef("even_values", Params("l"),
    34	        If(Compare(Name("l"), CmpOp("==", ListExpr(.Exprs))),
    35	          Return(ListExpr(.Exprs)),
    36	          Return(
    37	            BinOp(
    38	              "+",
    39	              ListExpr(Subscript(Name("l"), Int(0))),
    40	              Call(
    41	                Name("even_values"),
    42	                Subscript(Name("l"), Slice(Int(2), NoBound, NoBound)))))))
    43	      FuncDef("rebuild", Params("l", "evens"),
    44	        If(Compare(Name("l"), CmpOp("==", ListExpr(.Exprs))),
    45	          Return(ListExpr(.Exprs)),
    46	          If(Compare(
    47	            Subscript(Name("l"), Slice(Int(1), NoBound, NoBound)),
    48	            CmpOp("==", ListExpr(.Exprs))),
    49	            Return(ListExpr(Subscript(Name("evens"), Int(0)))),
    50	            Return(
    51	              BinOp(
    52	                "+",
    53	                ListExpr(
    54	                  Subscript(Name("evens"), Int(0)),
    55	                  Subscript(Name("l"), Int(1))),
    56	                Call(
    57	                  Name("rebuild"),
    58	                  Subscript(Name("l"), Slice(Int(2), NoBound, NoBound)),
    59	                  Subscript(Name("evens"), Slice(Int(1), NoBound, NoBound))))))))
    60	      FuncDef("sort_even", Params("l"),
    61	        Return(
    62	          Call(
    63	            Name("rebuild"),
    64	            Name("l"),
    65	            Call(Name("sort_values"), Call(Name("even_values"), Name("l")))))))
    66	
    67	  // Mathematical reference functions over runtime lists.
    68	  syntax List ::= "evenPositions" "(" List ")" [function]
    69	                | "oddPositions" "(" List ")" [function]
    70	                | "insertReference" "(" PyVal "," List ")" [function]
    71	                | "sortReference" "(" List ")" [function]
    72	                | "rebuildReference" "(" List "," List ")" [function]
    73	                | "sortEvenReference" "(" List ")" [function]
    74	
    75	  rule evenPositions(L) => .List
    76	    requires size(L) ==Int 0
    77	  rule evenPositions(L)
    78	    => ListItem(headInt(L)) evenPositions(dropList(L, 2))
    79	    requires notBool size(L) ==Int 0
    80	
    81	  rule oddPositions(L) => evenPositions(dropList(L, 1))
    82	
    83	  rule insertReference(pyInt(X), L) => ListItem(X)
    84	    requires size(L) ==Int 0
    85	  rule insertReference(pyInt(X), L) => ListItem(X) L
    86	    requires notBool size(L) ==Int 0
    87	     andBool X <=Int headInt(L)
    88	  rule insertReference(pyInt(X), L)
    89	    => ListItem(headInt(L))
    90	       insertReference(pyInt(X), dropList(L, 1))
    91	    requires notBool size(L) ==Int 0
    92	     andBool notBool X <=Int headInt(L)
    93	
    94	  rule sortReference(L) => .List
    95	    requires size(L) ==Int 0
    96	  rule sortReference(L)
    97	    => insertReference(pyInt(headInt(L)), sortReference(dropList(L, 1)))
    98	    requires notBool size(L) ==Int 0
    99	
   100	  rule rebuildReference(L, _EVENS) => .List
   101	    requires size(L) ==Int 0
   102	  rule rebuildReference(L, EVENS) => ListItem(headInt(EVENS))
   103	    requires notBool size(L) ==Int 0
   104	     andBool size(dropList(L, 1)) ==Int 0
   105	  rule rebuildReference(L, EVENS)
   106	    => ListItem(headInt(EVENS)) ListItem(headInt(dropList(L, 1)))
   107	       rebuildReference(dropList(L, 2), dropList(EVENS, 1))
   108	    requires notBool size(L) ==Int 0
   109	     andBool notBool size(dropList(L, 1)) ==Int 0
   110	
   111	  rule sortEvenReference(L)
   112	    => rebuildReference(L, sortReference(evenPositions(L)))
