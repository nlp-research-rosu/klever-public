index 0000000000000000000000000000000000000000..0e833fe6bec68ee43b51c86eaf2481ce9588cc6e
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+
+{
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+} | tee "$audit_log"
+
+"$@" 2>&1 | tee -a "$audit_log"
+audit_status=${PIPESTATUS[0]}
+printf 'EXIT_STATUS: %s\n' "$audit_status" | tee -a "$audit_log"
+exit "$audit_status"
