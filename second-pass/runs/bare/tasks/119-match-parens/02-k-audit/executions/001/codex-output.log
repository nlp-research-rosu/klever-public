+requires "semantic.k"
+
+module BRIDGE-WITNESS-SYNTAX
+  imports MPY-SEMANTICS
+
+  syntax KItem ::= "matchInvocation" | "helperInvocation"
+
+  rule matchInvocation =>
+    invoke(closure("match_parens", Params("lst"),
+      If(Call(
+        Name("is_balanced"),
+        BinOp(
+          "+",
+          Subscript(Name("lst"), Int(0)),
+          Subscript(Name("lst"), Int(1))),
+        Int(0)),
+        Return(Str("Yes")),
+        .Stmts)
+      If(Call(
+        Name("is_balanced"),
+        BinOp(
+          "+",
+          Subscript(Name("lst"), Int(1)),
+          Subscript(Name("lst"), Int(0))),
+        Int(0)),
+        Return(Str("Yes")),
+        .Stmts)
+      Return(Str("No"))),
+      listVal(
+        strVal(parens(rp .PString)),
+        strVal(parens(rp .PString)),
+        .Values))
+
+  rule helperInvocation =>
