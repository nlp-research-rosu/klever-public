+- `["(", ")"]` -> `strVal(yesString)` (first order);
+- `[")", "("]` -> `strVal(yesString)` (second order);
+- `["(", "("]` -> `strVal(noString)`;
+- `[ "))", "((" ]` -> `strVal(yesString)` (reverse order).
