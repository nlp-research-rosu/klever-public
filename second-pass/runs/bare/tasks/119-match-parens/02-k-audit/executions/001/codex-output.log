--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+
+{
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+} | tee "$audit_log"
+
+"$@" 2>&1 | tee -a "$audit_log"
+audit_status=${PIPESTATUS[0]}
+printf 'EXIT_STATUS: %s\n' "$audit_status" | tee -a "$audit_log"
+exit "$audit_status"
diff --git a/evidence/solution-program-expanded.mpy b/evidence/solution-program-expanded.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..e2290472c5205f5d7e9b8b6b5713af23c4bfcd53
--- /dev/null
+++ b/evidence/solution-program-expanded.mpy
@@ -0,0 +1,40 @@
+Module(
+  FuncDef("is_balanced", Params("s", "depth"),
+    If(Compare(Name("depth"), CmpOp("<", Int(0))),
+      Return(Bool(false)),
+      )
+    If(Compare(Name("s"), CmpOp("==", Str(""))),
+      Return(Compare(Name("depth"), CmpOp("==", Int(0)))),
+      )
+    If(Compare(Subscript(Name("s"), Int(0)), CmpOp("==", Str("("))),
+      Return(
+        Call(
+          Name("is_balanced"),
+          Subscript(Name("s"), Slice(Int(1), NoBound, NoBound)),
+          BinOp("+", Name("depth"), Int(1)))),
+      )
+    Return(
+      Call(
+        Name("is_balanced"),
+        Subscript(Name("s"), Slice(Int(1), NoBound, NoBound)),
+        BinOp("-", Name("depth"), Int(1)))))
+  FuncDef("match_parens", Params("lst"),
+    If(Call(
+      Name("is_balanced"),
+      BinOp(
+        "+",
+        Subscript(Name("lst"), Int(0)),
+        Subscript(Name("lst"), Int(1))),
+      Int(0)),
+      Return(Str("Yes")),
+      )
+    If(Call(
+      Name("is_balanced"),
+      BinOp(
+        "+",
+        Subscript(Name("lst"), Int(1)),
+        Subscript(Name("lst"), Int(0))),
+      Int(0)),
+      Return(Str("Yes")),
+      )
+    Return(Str("No"))))
diff --git a/evidence/spec-audit-labeled.k b/evidence/spec-audit-labeled.k
