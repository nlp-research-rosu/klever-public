+  FuncDef("match_parens", Params("lst"),
+    If(Call(
+      Name("is_balanced"),
+      BinOp(
+        "+",
+        Subscript(Name("lst"), Int(0)),
+        Subscript(Name("lst"), Int(1))),
+      Int(0)),
+      Return(Str("Yes")),
+      )
+    If(Call(
+      Name("is_balanced"),
+      BinOp(
+        "+",
+        Subscript(Name("lst"), Int(1)),
+        Subscript(Name("lst"), Int(0))),
+      Int(0)),
+      Return(Str("Yes")),
+      )
+    Return(Str("No"))))
