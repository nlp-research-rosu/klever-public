COMMAND: krun missing-binding-probe.mpy --definition bridge-fixed-kompiled -cINPUT=PStr\(.PString\)
<mpy>
  <k>
    eval ( Name ( "is_balanced" ) ) ~> callTwoFirst ( Subscript ( Name ( "s" ) , Slice ( Int ( 1 ) , NoBound , NoBound ) ) , BinOp ( "+" , Name ( "depth" ) , Int ( 1 ) ) ) ~> returnFrom ~> exec ( Return ( Call ( Name ( "is_balanced" ) , Subscript ( Name ( "s" ) , Slice ( Int ( 1 ) , NoBound , NoBound ) ) , BinOp ( "-" , Name ( "depth" ) , Int ( 1 ) ) , .Exprs ) )  .Stmts ) ~> finishCall ( .Map ) ~> .K
  </k>
  <input>
    PStr ( .PString )
  </input>
  <env>
    "depth" |-> intVal ( 0 )
    "s" |-> strVal ( parens ( lp rp .PString ) )
  </env>
  <functions>
    .Map
  </functions>
  <result>
    noResult
  </result>
</mpy>
EXIT_STATUS: 0
