   216	  rule pconcat(lp S, T) => lp pconcat(S, T)
   217	  rule pconcat(rp S, T) => rp pconcat(S, T)
   218	  rule stringPlus(parens(A), parens(B)) => parens(pconcat(A, B))
   219	
   220	  rule stringHead(parens(lp _S)) => parens(lp .PString)
