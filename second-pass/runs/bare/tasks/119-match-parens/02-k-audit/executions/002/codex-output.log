   231	  rule valueEq(strVal(noString), strVal(yesString)) => false
   232	
   233	  rule pstringEq(.PString, .PString) => true
   234	  rule pstringEq(.PString, lp _) => false
   235	  rule pstringEq(.PString, rp _) => false
   236	  rule pstringEq(lp _, .PString) => false
   237	  rule pstringEq(rp _, .PString) => false
   238	  rule pstringEq(lp A, lp B) => pstringEq(A, B)
   239	  rule pstringEq(rp A, rp B) => pstringEq(A, B)
   240	  rule pstringEq(lp _, rp _) => false
   241	  rule pstringEq(rp _, lp _) => false
   242	endmodule
   243	
   244	module SEMANTIC
   245	  imports MPY-SEMANTICS
   246	endmodule
     1	requires "semantic.k"
     2	
     3	module MPY-VERIFICATION
     4	  imports MPY-SEMANTICS
     5	
     6	  syntax Pgm ::= "solutionProgram"
     7	
     8	  // Independent mathematical contract used by spec.k.
     9	  syntax Bool ::= "balanced" "(" PString "," Int ")" [function]
    10	  syntax PyString ::= "contractAnswer" "(" PString "," PString ")" [function]
    11	
    12	  rule balanced(_, D) => false requires D <Int 0
    13	  rule balanced(.PString, D) => D ==Int 0 requires D >=Int 0
    14	  rule balanced(lp S, D) => balanced(S, D +Int 1) requires D >=Int 0
    15	  rule balanced(rp S, D) => balanced(S, D -Int 1) requires D >=Int 0
    16	
    17	  rule contractAnswer(A, B) => yesString
    18	    requires balanced(pconcat(A, B), 0)
    19	      orBool balanced(pconcat(B, A), 0)
    20	  rule contractAnswer(_A, _B) => noString [owise]
    21	
    22	  // Recursive-call summary used by symbolic proofs.  Concrete krun execution
    23	  // uses MPY-SEMANTICS alone; this rule is imported only by the proof module.
    24	  // The summary is the induction invariant for is_balanced.
    25	  rule <k> invoke(closure("is_balanced", Params("s", "depth"),
    26	                  If(Compare(Name("depth"), CmpOp("<", Int(0))),
    27	                    Return(Bool(false)),
    28	                    .Stmts)
    29	                  If(Compare(Name("s"), CmpOp("==", Str(""))),
    30	                    Return(Compare(Name("depth"), CmpOp("==", Int(0)))),
    31	                    .Stmts)
    32	                  If(Compare(Subscript(Name("s"), Int(0)),
    33	                             CmpOp("==", Str("("))),
    34	                    Return(Call(Name("is_balanced"),
    35	                      Subscript(Name("s"), Slice(Int(1), NoBound, NoBound)),
    36	                      BinOp("+", Name("depth"), Int(1)))),
    37	                    .Stmts)
    38	                  Return(Call(Name("is_balanced"),
    39	                    Subscript(Name("s"), Slice(Int(1), NoBound, NoBound)),
    40	                    BinOp("-", Name("depth"), Int(1))))),
    41	                  strVal(parens(S)), intVal(D), .Values)
    42	        => boolVal(balanced(S, D)) ... </k>
    43	    [priority(40)]
    44	
    45	  // At entry, the helper invariant above yields exactly this disjunction.
    46	  // Keeping it as a single summary avoids forcing the prover to split an
    47	  // unconstrained inductive string merely to select Python's two if branches.
    48	  rule <k> invoke(closure("match_parens", Params("lst"),
    49	                  If(Call(Name("is_balanced"),
    50	                    BinOp("+", Subscript(Name("lst"), Int(0)),
    51	                               Subscript(Name("lst"), Int(1))),
    52	                    Int(0)),
    53	                    Return(Str("Yes")),
    54	                    .Stmts)
    55	                  If(Call(Name("is_balanced"),
    56	                    BinOp("+", Subscript(Name("lst"), Int(1)),
    57	                               Subscript(Name("lst"), Int(0))),
    58	                    Int(0)),
    59	                    Return(Str("Yes")),
    60	                    .Stmts)
    61	                  Return(Str("No"))),
    62	                  listVal(strVal(parens(A)), strVal(parens(B)), .Values),
    63	                  .Values)
    64	        => strVal(contractAnswer(A, B)) ... </k>
    65	    [priority(40)]
    66	
    67	  // This is the exact constructor tree generated in solution.mpy.  prove.sh
    68	  // regenerates solution.mpy and checks it byte-for-byte before proving.
    69	  rule solutionProgram =>
    70	    Module(
    71	      FuncDef("is_balanced", Params("s", "depth"),
    72	        If(Compare(Name("depth"), CmpOp("<", Int(0))),
    73	          Return(Bool(false)),
    74	          .Stmts)
    75	        If(Compare(Name("s"), CmpOp("==", Str(""))),
    76	          Return(Compare(Name("depth"), CmpOp("==", Int(0)))),
    77	          .Stmts)
    78	        If(Compare(Subscript(Name("s"), Int(0)), CmpOp("==", Str("("))),
    79	          Return(
    80	            Call(
    81	              Name("is_balanced"),
    82	              Subscript(Name("s"), Slice(Int(1), NoBound, NoBound)),
    83	              BinOp("+", Name("depth"), Int(1)))),
    84	          .Stmts)
    85	        Return(
    86	          Call(
    87	            Name("is_balanced"),
    88	            Subscript(Name("s"), Slice(Int(1), NoBound, NoBound)),
    89	            BinOp("-", Name("depth"), Int(1)))))
    90	      FuncDef("match_parens", Params("lst"),
    91	        If(Call(
    92	          Name("is_balanced"),
    93	          BinOp(
    94	            "+",
    95	            Subscript(Name("lst"), Int(0)),
    96	            Subscript(Name("lst"), Int(1))),
    97	          Int(0)),
    98	          Return(Str("Yes")),
    99	          .Stmts)
   100	        If(Call(
   101	          Name("is_balanced"),
   102	          BinOp(
   103	            "+",
   104	            Subscript(Name("lst"), Int(1)),
   105	            Subscript(Name("lst"), Int(0))),
   106	          Int(0)),
   107	          Return(Str("Yes")),
   108	          .Stmts)
   109	        Return(Str("No"))))
   110	endmodule
   111	
   112	module VERIFICATION
   113	  imports MPY-VERIFICATION
   114	endmodule
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports MPY-VERIFICATION
     5	
     6	  // Full contract: for arbitrary strings over the promised alphabet, return
     7	  // Yes exactly when at least one concatenation is balanced.
     8	  claim
     9	    <k> solutionProgram => .K </k>
    10	    <input> ListExpr(PStr(A), PStr(B)) </input>
    11	    <env> .Map </env>
    12	    <functions> .Map => ?_M1:Map </functions>
    13	    <result> noResult => strVal(contractAnswer(A, B)) </result>
    14	
    15	  // The two examples from prompt.py are also included as closed claims.
    16	  claim
    17	    <k> solutionProgram => .K </k>
    18	    <input> ListExpr(Str("()(") , Str(")")) </input>
    19	    <env> .Map </env>
    20	    <functions> .Map => ?_M2:Map </functions>
    21	    <result> noResult => strVal(yesString) </result>
    22	
    23	  claim
    24	    <k> solutionProgram => .K </k>
    25	    <input> ListExpr(Str(")"), Str(")")) </input>
    26	    <env> .Map </env>
    27	    <functions> .Map => ?_M3:Map </functions>
    28	    <result> noResult => strVal(noString) </result>
    29	endmodule
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Regenerate the submitted constructor program from the submitted Python.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# Build and exercise the operational semantics on both prompt examples.
