   191	       <env> OLD => X |-> V1 Y |-> V2 </env>
   192	  rule <k> returned(V) ~> finishCall(OLD) => V ... </k>
   193	       <env> _ => OLD </env>
   194	
   195	  rule <k> launch => eval(IN) ~> invokeEntry ... </k> <input> IN </input>
   196	  rule <k> V:Value ~> invokeEntry => invoke(F, V) ... </k>
   197	       <functions> ... "match_parens" |-> F ... </functions>
   198	  rule <k> V:Value => .K </k> <result> noResult => V </result>
   199	
   200	  // Concrete literal conversion.  chars is defined only for the input
   201	  // alphabet promised by the HumanEval task.
   202	  rule literalString("Yes") => yesString
   203	  rule literalString("No") => noString
   204	  rule literalString(S) => parens(chars(S))
   205	    requires S =/=String "Yes" andBool S =/=String "No"
