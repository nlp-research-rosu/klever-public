+
+    if any("absent/unreadable" in item or "expected real" in item for item in failures):
+        print("INFRASTRUCTURE_TYPE_OR_PRESENCE_FAILURES:")
+        print("\n".join(failures))
+        return 1
+
+    lock = json.loads(paths["audit_campaign_lock"].read_text())
