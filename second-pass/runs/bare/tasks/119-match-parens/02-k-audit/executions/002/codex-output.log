index 0000000000000000000000000000000000000000..dec41059d6f58bc9f2ee13f202db0219fd90872b
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,15 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports MPY-VERIFICATION
+
+  // Deliberately false: two arbitrary parenthesis strings do not always
+  // admit a balanced concatenation.  Witness A = rp .PString,
+  // B = rp .PString must produce noString, not yesString.
+  claim
+    <k> solutionProgram => .K </k>
+    <input> ListExpr(PStr(A), PStr(B)) </input>
+    <env> .Map </env>
+    <functions> .Map => ?_M:Map </functions>
+    <result> noResult => strVal(yesString) </result>
+endmodule

 succeeded in 1786ms:
<mpy>
  <k>
    .K
  </k>
  <input>
    ListExpr ( PStr ( rp .PString ) , PStr ( rp .PString ) , .Exprs )
  </input>
  <env>
    .Map
  </env>
  <functions>
    "is_balanced" |-> closure ( "is_balanced" , Params ( "s" , "depth" , .Strings ) , If ( Compare ( Name ( "depth" ) , CmpOp ( "<" , Int ( 0 ) ) , .CmpOps ) , Return ( Bool ( false ) )  .Stmts , .Stmts )  If ( Compare ( Name ( "s" ) , CmpOp ( "==" , Str ( "" ) ) , .CmpOps ) , Return ( Compare ( Name ( "depth" ) , CmpOp ( "==" , Int ( 0 ) ) , .CmpOps ) )  .Stmts , .Stmts )  If ( Compare ( Subscript ( Name ( "s" ) , Int ( 0 ) ) , CmpOp ( "==" , Str ( "(" ) ) , .CmpOps ) , Return ( Call ( Name ( "is_balanced" ) , Subscript ( Name ( "s" ) , Slice ( Int ( 1 ) , NoBound , NoBound ) ) , BinOp ( "+" , Name ( "depth" ) , Int ( 1 ) ) , .Exprs ) )  .Stmts , .Stmts )  Return ( Call ( Name ( "is_balanced" ) , Subscript ( Name ( "s" ) , Slice ( Int ( 1 ) , NoBound , NoBound ) ) , BinOp ( "-" , Name ( "depth" ) , Int ( 1 ) ) , .Exprs ) )  .Stmts )
    "match_parens" |-> closure ( "match_parens" , Params ( "lst" , .Strings ) , If ( Call ( Name ( "is_balanced" ) , BinOp ( "+" , Subscript ( Name ( "lst" ) , Int ( 0 ) ) , Subscript ( Name ( "lst" ) , Int ( 1 ) ) ) , Int ( 0 ) , .Exprs ) , Return ( Str ( "Yes" ) )  .Stmts , .Stmts )  If ( Call ( Name ( "is_balanced" ) , BinOp ( "+" , Subscript ( Name ( "lst" ) , Int ( 1 ) ) , Subscript ( Name ( "lst" ) , Int ( 0 ) ) ) , Int ( 0 ) , .Exprs ) , Return ( Str ( "Yes" ) )  .Stmts , .Stmts )  Return ( Str ( "No" ) )  .Stmts )
