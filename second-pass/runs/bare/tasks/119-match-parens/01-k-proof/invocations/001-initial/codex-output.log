+                 | "eval" "(" Expr ")"
+                 | "binRight" "(" String "," Expr ")"
+                 | "binApply" "(" String "," Value ")"
+                 | "compareRight" "(" String "," Expr ")"
+                 | "compareApply" "(" String "," Value ")"
+                 | "indexAt" "(" Int ")"
+                 | "sliceTail"
+                 | "listMore" "(" Values "," Exprs ")"
+                 | "listAdd" "(" Values "," Exprs ")"
+                 | "callWith" "(" Exprs ")"
+                 | "callMore" "(" Value "," Values "," Exprs ")"
+                 | "callAdd" "(" Value "," Values "," Exprs ")"
+                 | "invoke" "(" Value "," Values ")"
+                 | "choose" "(" Stmts "," Stmts ")"
+                 | "returnFrom"
+                 | "returned" "(" Value ")"
+                 | "finishCall" "(" Map ")"
