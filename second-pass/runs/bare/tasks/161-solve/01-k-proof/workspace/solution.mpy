Module(
  FuncDef("solve", Params("s"),
    Return(
      IfExp(
        Call(
          Name("any"),
          GenExp(Call(Attribute(Name("c"), "isalpha"), ),
            CompFor(Name("c"), Name("s"), Bool(true)))),
        Call(Attribute(Name("s"), "swapcase"), ),
        Subscript(
          Name("s"),
          Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
