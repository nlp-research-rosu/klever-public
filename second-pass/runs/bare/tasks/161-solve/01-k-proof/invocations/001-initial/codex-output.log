+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9b5819a42c8e37d0ce57127bf6d3a3903db2bc27
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,10 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // Independent statement of the prompt's result, expressed with the string
+  // primitives defined by the semantics.
+  syntax PString ::= "expected" "(" PString ")" [function, total]
+  rule expected(S) => ifPString(hasAlpha(S), swapCase(S), reverse(S))
+endmodule

