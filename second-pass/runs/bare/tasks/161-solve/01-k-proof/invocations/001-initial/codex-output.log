+
+module SPEC
+  imports VERIFICATION
+
+  // For every input string, executing the translated solution reaches exactly
+  // the result required by the prompt.
+  claim
+    <humanEval>
+      <k>
+        Module(
+          FuncDef("solve", Params("s"),
+            Return(
+              IfExp(
+                Call(
+                  Name("any"),
+                  GenExp(Call(Attribute(Name("c"), "isalpha"), ),
+                    CompFor(Name("c"), Name("s"), Bool(true)))),
+                Call(Attribute(Name("s"), "swapcase"), ),
+                Subscript(
+                  Name("s"),
+                  Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
+      </k>
+      <input> S:PString </input>
+      <result> noResult </result>
+    </humanEval>
+  =>
+    <humanEval>
+      <k> .K </k>
+      <input> S </input>
+      <result> expected(S) </result>
+    </humanEval>
+endmodule
