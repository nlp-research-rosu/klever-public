module ML-SYNTAX [not-lr1]
  imports public SORT-K
  syntax {Sort} Sort  ::=
    "#Top" [group(mlUnary), symbol(#Top)]
  | "#Bottom" [group(mlUnary), symbol(#Bottom)]
