diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e08e3560743f99979aa82620bd264dd30aa44808
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // For every input string, executing the translated solution reaches exactly
+  // the result required by the prompt.
+  claim
+    <humanEval>
+      <k>
+        Module(
+          FuncDef("solve", Params("s"),
+            Return(
+              IfExp(
+                Call(
+                  Name("any"),
+                  GenExp(Call(Attribute(Name("c"), "isalpha"), ISALPHA_ARGS:Exprs),
+                    CompFor(Name("c"), Name("s"), Bool(true)))),
+                Call(Attribute(Name("s"), "swapcase"), SWAPCASE_ARGS:Exprs),
+                Subscript(
+                  Name("s"),
+                  Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
+      </k>
+      <input> S:PString </input>
+      <result> noResult </result>
+    </humanEval>
+  =>
+    <humanEval>
+      <k> .K </k>
+      <input> S </input>
+      <result> expected(S) </result>
+    </humanEval>
+endmodule
