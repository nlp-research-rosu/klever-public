+def solve(s):
+    return s.swapcase() if any(c.isalpha() for c in s) else s[::-1]
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5548108fa8bc6c8006deb859330f9df87217f3bc
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,34 @@
+requires "semantic.k"
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // For every input string, executing the translated solution reaches exactly
+  // the result required by the prompt.
+  claim
+    <humanEval>
+      <k>
+        Module(
+          FuncDef("solve", Params("s"),
+            Return(
+              IfExp(
+                Call(
+                  Name("any"),
+                  GenExp(Call(Attribute(Name("c"), "isalpha"), ),
+                    CompFor(Name("c"), Name("s"), Bool(true)))),
+                Call(Attribute(Name("s"), "swapcase"), ),
+                Subscript(
+                  Name("s"),
+                  Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
+      </k>
+      <input> S:PString </input>
+      <result> noResult </result>
+    </humanEval>
+  =>
+    <humanEval>
+      <k> .K </k>
+      <input> S </input>
+      <result> expected(S) </result>
+    </humanEval>
+endmodule
