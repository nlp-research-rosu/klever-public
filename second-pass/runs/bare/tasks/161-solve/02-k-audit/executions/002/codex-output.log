+    "/generation-evidence/prompt.txt",
+    str(trace_path),
+]
+missing = [path for path in required if not Path(path).is_file()]
+print("missing_required_records:", missing)
+all_ok &= not missing
+raise SystemExit(0 if all_ok else 1)
