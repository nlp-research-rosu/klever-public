+    ok = actual == expected
+    all_ok &= ok
+    print(f"{field}: ok={ok} expected={expected} actual={actual}")
+
+stage1 = json.loads(Path("/generation-result.json").read_text())
+trace_rel = next(
+    key for key in stage1["outputs"]["evidence"] if key.startswith("codex-trace/")
+)
