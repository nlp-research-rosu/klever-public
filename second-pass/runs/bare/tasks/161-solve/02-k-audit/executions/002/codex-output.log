from pathlib import Path
import hashlib,itertools
root=Path('/candidate'); exp='fb10d0ae7c19dd0011516567fadb7fcce655dc2b8a88ed4546e59abf6eef6db9'
all_entries=sorted(root.rglob('*'),key=lambda p:p.relative_to(root).as_posix())
for exclusion in ['none','pycache','hidden','pyc','input','proof']:
 def keep(p):
  r=p.relative_to(root).as_posix()
  if exclusion=='none':return True
  if exclusion=='pycache':return '__pycache__' not in r
  if exclusion=='hidden':return not any(x.startswith('.') for x in Path(r).parts)
  if exclusion=='pyc':return p.suffix"'!='"'.pyc'
  if exclusion=='input':return p.name not in ['prompt.py','py2mpy.py']
  if exclusion=='proof':return p.name in ['solution.py','solution.mpy','semantic.k','verification.k','spec.k','prove.sh']
 for dirs in [False,True]:
  es=[p for p in all_entries if keep(p) and (dirs or p.is_file())]
  for pathform in ['rel','dotrel','name','abs']:
   for pathsep,entrysep in itertools.product([b'',b'\\0',b'\\n',b'  '],repeat=2):
    for body in ['data','hexhash','rawhash']:
     for ordering in ['pathdata','hashpath']:
      h=hashlib.sha256()
      for p in es:
       rel=p.relative_to(root).as_posix(); path={'rel':rel,'dotrel':'./'+rel,'name':p.name,'abs':str(p)}[pathform].encode()
       if p.is_file():
        data=p.read_bytes(); val={'data':data,'hexhash':hashlib.sha256(data).hexdigest().encode(),'rawhash':hashlib.sha256(data).digest()}[body]
       else: val=b''
       parts=[path,pathsep,val] if ordering=='pathdata' else [val,pathsep,path]
       for x in parts:h.update(x)
       h.update(entrysep)
      if h.hexdigest()==exp:
       print('MATCH',exclusion,dirs,pathform,pathsep,entrysep,body,ordering)
print('done')
PY" in /audit-output
