+  printf '+'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+printf 'Declared record layout and semantics mode:\n'
+run sed -n '/"record_layout"/p; /"semantics_mode"/p; /"mount_reference_semantics"/p' /audit-input.json
+
