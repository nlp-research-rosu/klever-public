+}
+
+run_in_work() {
+  printf '+ (cd %q &&' "$WORK"
+  printf ' %q' "$@"
+  printf ')\n'
+  (
+    cd "$WORK" || exit 125
+    "$@"
+  )
+  local status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+printf 'Toolchain:\n'
+run kompile --version
+run kprove --version
+run krun --version
+
