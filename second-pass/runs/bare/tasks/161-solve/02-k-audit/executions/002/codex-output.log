+run find /candidate /reference /generation-evidence -maxdepth 6 \
+  -printf '%y %m %u:%g %p -> %l\n'
+run stat -c '%F %a %U:%G %n' \
+  /audit-input.json /audit-campaign-lock.json /run.json /task.json \
