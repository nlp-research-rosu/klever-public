Module(
  FuncDef("solution", Params("lst"),
    Return(
      Call(
        Name("sum"),
        ListComp(Int(0),
          CompFor(
            Name("x"),
            Subscript(Name("lst"), Slice(NoBound, NoBound, Int(2))),
            Compare(BinOp("%", Name("x"), Int(2)), CmpOp("!=", Int(0)))))))))
