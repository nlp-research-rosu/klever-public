+            )
+            if len(mismatches) >= 20:
+                break
+
+    documented = [
+        ([5, 8, 7, 1], 12),
+        ([3, 3, 3, 3, 3], 9),
+        ([30, 13, 24, 321], 0),
+    ]
+    documented_results = [
