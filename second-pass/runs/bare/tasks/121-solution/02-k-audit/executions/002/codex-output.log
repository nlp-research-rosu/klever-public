diff --git a/evidence/verification-body-mutation.k b/evidence/verification-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..159ef5ca8850ee3bfac7ce918d5fbb8c33722825
--- /dev/null
+++ b/evidence/verification-body-mutation.k
@@ -0,0 +1,31 @@
+requires "semantic.k"
+
+module VERIFICATION-BODY-MUTATION
+  imports MPY
+
+  // Reviewer mutation: the compared literal is 1 instead of the submitted 0.
+  syntax Pgm ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      FuncDef("solution", Params("lst"),
+        Return(
+          Call(
+            Name("sum"),
+            ListComp(Name("x"),
+              CompFor(
+                Name("x"),
+                Subscript(Name("lst"), Slice(NoBound, NoBound, Int(2))),
+                Compare(BinOp("%", Name("x"), Int(2)),
+                        CmpOp("!=", Int(1)))))))))
+
+  syntax Int ::= "expected" "(" Ints "," Int ")" [function]
+  rule expected(nil, ACC) => ACC
+  rule expected(cons(I, nil), ACC) => ACC +Int I
+    requires I modInt 2 =/=Int 0
+  rule expected(cons(I, nil), ACC) => ACC
+    requires I modInt 2 ==Int 0
+  rule expected(cons(I, cons(_, IS)), ACC) => expected(IS, ACC +Int I)
+    requires I modInt 2 =/=Int 0
+  rule expected(cons(I, cons(_, IS)), ACC) => expected(IS, ACC)
+    requires I modInt 2 ==Int 0
+endmodule

codex
The adversarial `%` witness is decisive for the rule inventory: the trusted translator accepts `1 % x`, and on the valid input `[-2]` Python returns `-2` for the witness program while the generated semantics returns `0`. The unguarded rule therefore admits a concrete false result over its declared match domain. Although the submitted body reaches only divisor `+2`, the Kit soundness contract forbids validating a globally false imported equation merely because its bad instance is off that body’s path. I’m completing the proven-versus-assumed ledger and verdict mapping now.
Fresh compilation and all four target proofs succeeded; the generated semantics matched both Python implementations on branch/boundary executions. Exact program pinning, an executed-body sensitivity mutation, and a false-postcondition mutation also behaved correctly. The exhaustive static inventory nevertheless found a globally false unguarded `%` rule with a concrete translated-program/valid-input false-result witness, which is decisive under the Kit soundness contract.
