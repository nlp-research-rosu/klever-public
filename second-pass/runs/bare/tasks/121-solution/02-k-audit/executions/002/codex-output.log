+exit "$status"

exec
/bin/bash -lc 'set -o pipefail
bash /audit-output/evidence/stage2_fidelity.sh 2>&1 | tee /audit-output/evidence/stage2_fidelity.log
rc=${PIPESTATUS[0]}
