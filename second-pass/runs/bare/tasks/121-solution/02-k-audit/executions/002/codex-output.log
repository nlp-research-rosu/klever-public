from pathlib import Path
from hashlib import sha256
from itertools import product
root=Path('/candidate')
target='f95b2afe9f2005a5199b65367359079da525cf22b2520554a52185ece5921fe4'
entries=sorted(root.rglob('*'),key=lambda p:p.relative_to(root).as_posix())
path_forms=[lambda p:p.relative_to(root).as_posix().encode(),lambda p:('./'+p.relative_to(root).as_posix()).encode()]
kinds=[lambda p:b'',lambda p:b'F' if p.is_file() else b'D',lambda p:b'file\\0' if p.is_file() else b'dir\\0',lambda p:(str(p.stat().st_mode & 0o7777)).encode()]
seps=[b'',b'\\0',b'\\n',b' ']
contents=[lambda p:p.read_bytes() if p.is_file() else b'',lambda p:sha256(p.read_bytes()).digest() if p.is_file() else b'',lambda p:sha256(p.read_bytes()).hexdigest().encode() if p.is_file() else b'']
for include_dirs,pf,kf,s1,cf,s2 in product([False,True],path_forms,kinds,seps,contents,seps):
 es=entries if include_dirs else [p for p in entries if p.is_file()]
 h=sha256()
 for p in es:
  h.update(kf(p));h.update(pf(p));h.update(s1);h.update(cf(p));h.update(s2)
 if h.hexdigest()==target:
  print('MATCH',include_dirs,path_forms.index(pf),kinds.index(kf),repr(s1),contents.index(cf),repr(s2));raise SystemExit
print('no simple match')
