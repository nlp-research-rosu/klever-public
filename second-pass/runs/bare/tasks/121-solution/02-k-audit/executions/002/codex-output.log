 for p in root.rglob('*'):
  rel=p.relative_to(root).as_posix()
  if exclude_cache and ('__pycache__' in p.parts):continue
  if p.is_dir():
   if include_dirs:es.append((rel,'directory',p))
  elif p.is_file():es.append((rel,'file',p))
 for rel,kind,p in sorted(es):
  h.update(rel.encode()+b'\\0'+kind.encode()+b'\\0')
  if kind=='file':h.update(p.read_bytes())
 return h.hexdigest()
for d in [True,False]:
 for c in [True,False]: print(d,c,td('/candidate',d,c))
