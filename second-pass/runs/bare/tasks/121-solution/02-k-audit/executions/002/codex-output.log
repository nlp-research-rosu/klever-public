diff --git a/evidence/stage1_verify.py b/evidence/stage1_verify.py
new file mode 100644
index 0000000000000000000000000000000000000000..562d627ff855ed6ea8e8042b3cbb14ed2d40c039
--- /dev/null
+++ b/evidence/stage1_verify.py
@@ -0,0 +1,245 @@
+#!/usr/bin/env python3
+"""Read-only integrity verifier for the launcher-owned audit inputs."""
+
+from __future__ import annotations
+
+import collections
+import hashlib
+import json
+import os
+from pathlib import Path
+import sys
+
+
+AUDIT_INPUT = Path("/audit-input.json")
+
+
+def digest(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def check_regular(path: Path, errors: list[str]) -> None:
+    if not path.exists():
+        errors.append(f"missing required path: {path}")
