diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..04302e5bc9f4354e5896bc4bd2efb3062c2f73a5
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,27 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [example-one]:
+    <k> run(solutionProgram,
+          cons(5, cons(8, cons(7, cons(1, nil)))),
+          cons(5, cons(8, cons(7, cons(1, nil)))), 0)
+      => result(12) ... </k>
+
+  claim [example-two]:
+    <k> run(solutionProgram,
+          cons(3, cons(3, cons(3, cons(3, cons(3, nil))))),
+          cons(3, cons(3, cons(3, cons(3, cons(3, nil))))), 0)
+      => result(9) ... </k>
+
+  claim [example-three]:
+    <k> run(solutionProgram,
+          cons(30, cons(13, cons(24, cons(321, nil)))),
+          cons(30, cons(13, cons(24, cons(321, nil)))), 0)
+      => result(0) ... </k>
+
+  claim [all-integer-lists]:
+    <k> run(solutionProgram, INPUT, _ORIGINAL, ACC)
+      => result(expected(INPUT, ACC)) ... </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9565eeb7097290da90cac56d333bf7e2bbc7aba6
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,33 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact AST emitted in solution.mpy, given a short name for specifications.
+  syntax Pgm ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      FuncDef("solution", Params("lst"),
+        Return(
+          Call(
+            Name("sum"),
+            ListComp(Name("x"),
+              CompFor(
+                Name("x"),
+                Subscript(Name("lst"), Slice(NoBound, NoBound, Int(2))),
+                Compare(BinOp("%", Name("x"), Int(2)),
+                        CmpOp("!=", Int(0)))))))))
+
+  // Independent mathematical contract: consume positions 0, 2, 4, ... and
+  // add the current integer exactly when Python's remainder modulo 2 is nonzero.
+  syntax Int ::= "expected" "(" Ints "," Int ")" [function]
+  rule expected(nil, ACC) => ACC
+  rule expected(cons(I, nil), ACC) => ACC +Int I
+    requires I modInt 2 =/=Int 0
+  rule expected(cons(I, nil), ACC) => ACC
+    requires I modInt 2 ==Int 0
+  rule expected(cons(I, cons(_, IS)), ACC) => expected(IS, ACC +Int I)
+    requires I modInt 2 =/=Int 0
+  rule expected(cons(I, cons(_, IS)), ACC) => expected(IS, ACC)
+    requires I modInt 2 ==Int 0
+endmodule

exec
/bin/bash -lc 'chmod +x prove.sh && ./prove.sh' in /work
