+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+
+  syntax Val ::= "intVal" "(" Int ")"
+               | "boolVal" "(" Bool ")"
+               | "listVal" "(" Ints ")"
