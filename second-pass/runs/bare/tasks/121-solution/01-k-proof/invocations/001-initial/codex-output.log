new file mode 100644
index 0000000000000000000000000000000000000000..9f6be09087d5b161a7fa5431f0f93e0ecef25e88
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,23 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [example-one]:
+    <k> execute(solutionProgram,
+          cons(5, cons(8, cons(7, cons(1, nil)))))
+      => result(12) ... </k>
+
+  claim [example-two]:
+    <k> execute(solutionProgram,
+          cons(3, cons(3, cons(3, cons(3, cons(3, nil))))))
+      => result(9) ... </k>
+
+  claim [example-three]:
+    <k> execute(solutionProgram,
+          cons(30, cons(13, cons(24, cons(321, nil)))))
+      => result(0) ... </k>
+
+  claim [all-integer-lists]:
+    <k> execute(solutionProgram, INPUT) => result(expected(INPUT)) ... </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2be6fb1faac61472ef0047836b9526eb2d3d4736
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,33 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact AST emitted in solution.mpy, given a short name for specifications.
+  syntax Pgm ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      FuncDef("solution", Params("lst"),
+        Return(
+          Call(
+            Name("sum"),
+            ListComp(Name("x"),
+              CompFor(
+                Name("x"),
+                Subscript(Name("lst"), Slice(NoBound, NoBound, Int(2))),
+                Compare(BinOp("%", Name("x"), Int(2)),
+                        CmpOp("!=", Int(0)))))))))
+
+  // Independent mathematical contract: consume positions 0, 2, 4, ... and
+  // add the current integer exactly when Python's remainder modulo 2 is nonzero.
+  syntax Int ::= "expected" "(" Ints ")" [function]
+  rule expected(nil) => 0
+  rule expected(cons(I, nil)) => oddAdd(I, 0)
+  rule expected(cons(I, cons(_, IS))) => oddAdd(I, expected(IS))
+
+  syntax Int ::= "oddAdd" "(" Int "," Int ")" [function]
+  rule oddAdd(I, REST) => I +Int REST
+    requires I modInt 2 =/=Int 0
+  rule oddAdd(I, REST) => REST
+    requires I modInt 2 ==Int 0
+endmodule

