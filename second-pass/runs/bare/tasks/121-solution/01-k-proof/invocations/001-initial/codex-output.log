diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..6cb93c8818eff3c12f46cf9bbbbb96b6e2c6d618
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,103 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Pgm ::= "Module" "(" Stmt ")" [symbol]
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmt ")" [symbol]
+                | "Return" "(" Expr ")"                       [symbol]
+
+  syntax Params ::= "Params" "(" String ")" [symbol]
+
+  syntax Expr ::= "Name" "(" String ")"                         [symbol]
+                | "Int" "(" Int ")"                             [symbol]
+                | "BinOp" "(" String "," Expr "," Expr ")"     [symbol]
+                | "Compare" "(" Expr "," CmpOp ")"              [symbol]
+                | "Subscript" "(" Expr "," Slice ")"            [symbol]
+                | "ListComp" "(" Expr "," CompFor ")"           [symbol]
+                | "Call" "(" Expr "," Expr ")"                  [symbol]
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol]
+  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")" [symbol]
+  syntax Bound ::= "NoBound" [symbol] | Expr
+  syntax CompFor ::= "CompFor" "(" Expr "," Expr "," Expr ")" [symbol]
+
+  syntax Ints ::= "nil" [symbol]
+                | "cons" "(" Int "," Ints ")" [symbol]
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+
+  syntax Val ::= "intVal" "(" Int ")"
+               | "boolVal" "(" Bool ")"
+               | "listVal" "(" Ints ")"
+  syntax Env ::= "emptyEnv"
+               | "bind" "(" String "," Val "," Env ")"
+
+  syntax KItem ::= "execute" "(" Pgm "," Ints ")"
+                 | "result" "(" Int ")"
+
+  configuration <k> execute($PGM:Pgm, $INPUT:Ints) </k>
+
+  rule <k> execute(Module(FuncDef(FNAME, Params(PARAM), Return(E))), INPUT)
+        => result(asInt(eval(E, bind(PARAM, listVal(INPUT), emptyEnv)))) ... </k>
+
+  syntax Val ::= "lookup" "(" String "," Env ")" [function]
+  rule lookup(X, bind(X, V, _)) => V
+  rule lookup(X, bind(Y, _, ENV)) => lookup(X, ENV)
+    requires X =/=String Y
+
+  syntax Val ::= "eval" "(" Expr "," Env ")" [function]
+  rule eval(Int(I), _) => intVal(I)
+  rule eval(Name(X), ENV) => lookup(X, ENV)
+
+  rule eval(BinOp("%", LEFT, RIGHT), ENV)
+    => intVal(asInt(eval(LEFT, ENV)) modInt asInt(eval(RIGHT, ENV)))
+
+  rule eval(Compare(LEFT, CmpOp("!=", RIGHT)), ENV)
+    => boolVal(asInt(eval(LEFT, ENV)) =/=Int asInt(eval(RIGHT, ENV)))
+
+  rule eval(Subscript(BASE, Slice(NoBound, NoBound, Int(2))), ENV)
+    => listVal(everyOther(asInts(eval(BASE, ENV))))
+
+  // This is a semantics-preserving fusion of list-comprehension construction
+  // with its sole consumer, sum. It avoids introducing heap/list allocation.
+  rule eval(Call(Name("sum"),
+                 ListComp(BODY,
+                   CompFor(Name(VAR),
+                     Subscript(BASE, Slice(NoBound, NoBound, Int(2))), COND))), ENV)
+    => intVal(sumCompEven(BODY, VAR, COND,
+                          asInts(eval(BASE, ENV)), ENV))
+
+  syntax Int ::= "asInt" "(" Val ")" [function]
+  syntax Bool ::= "asBool" "(" Val ")" [function]
+  syntax Ints ::= "asInts" "(" Val ")" [function]
+  rule asInt(intVal(I)) => I
+  rule asBool(boolVal(B)) => B
+  rule asInts(listVal(IS)) => IS
+
+  syntax Ints ::= "everyOther" "(" Ints ")" [function]
+  rule everyOther(nil) => nil
+  rule everyOther(cons(I, nil)) => cons(I, nil)
+  rule everyOther(cons(I, cons(_, IS))) => cons(I, everyOther(IS))
+
+  syntax Int ::= "sumCompEven" "(" Expr "," String "," Expr "," Ints "," Env ")" [function]
+  rule sumCompEven(_, _, _, nil, _) => 0
+  rule sumCompEven(BODY, VAR, COND, cons(I, nil), ENV)
+    => addWhen(asBool(eval(COND, bind(VAR, intVal(I), ENV))),
+               asInt(eval(BODY, bind(VAR, intVal(I), ENV))), 0)
+  rule sumCompEven(BODY, VAR, COND, cons(I, cons(_, IS)), ENV)
+    => addWhen(asBool(eval(COND, bind(VAR, intVal(I), ENV))),
+               asInt(eval(BODY, bind(VAR, intVal(I), ENV))),
+               sumCompEven(BODY, VAR, COND, IS, ENV))
+
+  syntax Int ::= "addWhen" "(" Bool "," Int "," Int ")" [function]
+  rule addWhen(true, I, REST) => I +Int REST
+  rule addWhen(false, _, REST) => REST
+endmodule
