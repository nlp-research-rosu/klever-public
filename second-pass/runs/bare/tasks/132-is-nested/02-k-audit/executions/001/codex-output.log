index 0000000000000000000000000000000000000000..27256a8083b30a1d9d93a74733e5d2ad376ad258
--- /dev/null
+++ b/evidence/untrusted_claims_summary.sh
@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+trace=$(find /candidate/codex-trace -type f -name '*.jsonl' | sort | head -n 1)
+
+printf 'RUN_INPUT\n'
+python3 -m json.tool --sort-keys /candidate/run-input.json
