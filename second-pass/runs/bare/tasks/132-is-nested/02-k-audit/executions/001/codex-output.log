+printf 'TRACE_VALIDATION_AND_TYPE_COUNTS\n'
+python3 /audit-output/evidence/summarize_trace.py "$trace"
+printf 'CODEX_OUTPUT_RELEVANT_FINAL_CLAIMS\n'
