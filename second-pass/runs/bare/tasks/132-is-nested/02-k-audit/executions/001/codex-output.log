new file mode 100644
index 0000000000000000000000000000000000000000..0bba6120233f2498e460615d2ec102360208c10a
--- /dev/null
+++ b/evidence/untrusted_claims_summary.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+trace=$(find /candidate/codex-trace -type f -name '*.jsonl' | sort | head -n 1)
+
+printf 'RUN_INPUT\n'
+jq -S . /candidate/run-input.json
+printf 'METRICS\n'
+jq -S . /candidate/metrics.json
+printf 'CODEX_LAST\n'
+sed -n '1,80p' /candidate/codex-last.txt
+printf 'TRACE_VALIDATION_AND_TYPE_COUNTS\n'
+jq -s 'group_by(.type) | map({type: .[0].type, count: length})' "$trace"
+printf 'TRACE_FINAL_MESSAGES\n'
+jq -r 'select(.type == "event_msg" and
+              (.payload.type == "agent_message" or .payload.type == "task_complete"))
+       | [.timestamp, .payload.type,
+          (.payload.message // .payload.last_agent_message // "")]
+       | @tsv' "$trace"
+printf 'CODEX_OUTPUT_RELEVANT_FINAL_CLAIMS\n'
+rg -n '#Top|exhaustive Python cross-check|RESULT: KPROVE_PASSED|full reproducibility script' \
+  /candidate/codex-output.log | tail -n 40

