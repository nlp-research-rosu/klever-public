+#!/usr/bin/env bash
+set -euo pipefail
+
+expected=$'VERDICT: CONCERNS\nLEGITIMACY: LEGIT'
+actual=$(tail -n 2 /audit-output/REVIEW.md)
+[[ "$actual" == "$expected" ]]
+
+for stage in 1 2 3 4 5 6 7; do
+  rg -q "^## ${stage}\\." /audit-output/REVIEW.md
+done
+
+missing=0
+while IFS= read -r relative; do
+  if [[ ! -f "/audit-output/$relative" ]]; then
+    printf 'MISSING_REFERENCE %s\n' "$relative"
+    missing=1
+  fi
+done < <(rg -o 'evidence/[A-Za-z0-9_.-]+' /audit-output/REVIEW.md | sort -u)
+[[ $missing -eq 0 ]]
+
+printf '%s\n' 'FINAL_MARKERS_OK'
+printf '%s\n' 'SEVEN_STAGE_HEADINGS_OK'
+printf '%s\n' 'EVIDENCE_REFERENCES_OK'
+sha256sum /audit-output/REVIEW.md
diff --git a/evidence/claim-subsets.k b/evidence/claim-subsets.k
new file mode 100644
index 0000000000000000000000000000000000000000..49a2d921ff10cff65ff79351c40409cc1e5b4c11
--- /dev/null
+++ b/evidence/claim-subsets.k
@@ -0,0 +1,151 @@
+requires "verification.k"
+
+// Reviewer-authored cumulative subsets. Each module adds the next real claim
+// dependency: loop state 3 is self-contained; state 2 uses state 3; state 1
+// uses states 2 and 3; state 0 uses states 1, 2, and 3.
+
+module AUDIT-SPEC-LOOP3
+  imports VERIFICATION
+
+  claim
+    <k> iterate("bracket", BS:BString, loopBody)
+         ~> (Return(Bool(false)) .Stmts) => .K </k>
+    <functions>
+      "is_nested" |-> function(Params("string"), solutionBody) => .Map
+    </functions>
+    <env>
+      ( "string"  |-> strVal(_ORIG:BString)
+        "state"   |-> intVal(3)
+        "bracket" |-> strVal(_CUR:BString) ) => .Map
+    </env>
+    <result> noResult => boolVal(scan(3, BS)) </result>
+endmodule
+
+module AUDIT-SPEC-LOOP2
+  imports VERIFICATION
+
+  claim
+    <k> iterate("bracket", BS:BString, loopBody)
+         ~> (Return(Bool(false)) .Stmts) => .K </k>
+    <functions>
+      "is_nested" |-> function(Params("string"), solutionBody) => .Map
+    </functions>
+    <env>
+      ( "string"  |-> strVal(_ORIG:BString)
+        "state"   |-> intVal(2)
+        "bracket" |-> strVal(_CUR:BString) ) => .Map
+    </env>
+    <result> noResult => boolVal(scan(2, BS)) </result>
+
+  claim
+    <k> iterate("bracket", BS:BString, loopBody)
+         ~> (Return(Bool(false)) .Stmts) => .K </k>
+    <functions>
+      "is_nested" |-> function(Params("string"), solutionBody) => .Map
+    </functions>
+    <env>
+      ( "string"  |-> strVal(_ORIG:BString)
+        "state"   |-> intVal(3)
+        "bracket" |-> strVal(_CUR:BString) ) => .Map
+    </env>
+    <result> noResult => boolVal(scan(3, BS)) </result>
+endmodule
+
+module AUDIT-SPEC-LOOP1
+  imports VERIFICATION
+
+  claim
+    <k> iterate("bracket", BS:BString, loopBody)
+         ~> (Return(Bool(false)) .Stmts) => .K </k>
+    <functions>
+      "is_nested" |-> function(Params("string"), solutionBody) => .Map
+    </functions>
+    <env>
+      ( "string"  |-> strVal(_ORIG:BString)
+        "state"   |-> intVal(1)
+        "bracket" |-> strVal(_CUR:BString) ) => .Map
+    </env>
+    <result> noResult => boolVal(scan(1, BS)) </result>
+
+  claim
+    <k> iterate("bracket", BS:BString, loopBody)
+         ~> (Return(Bool(false)) .Stmts) => .K </k>
+    <functions>
+      "is_nested" |-> function(Params("string"), solutionBody) => .Map
+    </functions>
+    <env>
