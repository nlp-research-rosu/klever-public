+
+    proof_artifacts = [
+        "prompt.py",
+        "py2mpy.py",
+        "solution.py",
+        "solution.mpy",
+        "semantic.k",
+        "verification.k",
+        "spec.k",
+        "prove.sh",
+    ]
+    for name in proof_artifacts:
