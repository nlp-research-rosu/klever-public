+    return module.is_nested
+
+
+canonical = load_function(Path("/reference/canonical.py"), "trusted_canonical_132")
+submitted = load_function(
+    Path("/tmp/audit-work/132-is-nested/solution.py"), "submitted_solution_132"
+)
