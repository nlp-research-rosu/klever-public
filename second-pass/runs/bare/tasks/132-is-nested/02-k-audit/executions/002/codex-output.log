+#!/usr/bin/env bash
+set -uo pipefail
+
+printf '%s\n' \
+  'SATISFYING_WITNESS: BS = lbr lbr rbr rbr .BString ("[[]]"), functions=.Map, env=.Map, result=noResult'
+printf '%s\n' \
+  'ORACLES: trusted canonical=True, submitted Python=True, fresh concrete K result=boolVal(true)'
+printf '%s\n' \
+  'MUTATED_OBLIGATION: result must be boolVal(false)'
+
+mutation_output=$(
+  kprove spec-vacuity-fresh.k \
+    --definition audit-verification-kompiled \
+    --spec-module SPEC-VACUITY-FRESH 2>&1
+)
+mutation_status=$?
+printf '%s\n' "$mutation_output"
+printf 'vacuity_inner_kprove_exit=%s\n' "$mutation_status"
+
+if [[ $mutation_status -eq 0 ]]; then
+  printf 'ERROR: false postcondition unexpectedly closed\n'
+  exit 1
+fi
+if [[ "$mutation_output" != *"WarnStuckClaimState"* ]]; then
+  printf 'ERROR: expected unmet-obligation stuck state was absent\n'
+  exit 1
+fi
+printf 'EXPECTED_FALSE_POSTCONDITION_FAILURE_CONFIRMED\n'
diff --git a/evidence/claim-subsets.k b/evidence/claim-subsets.k
new file mode 100644
index 0000000000000000000000000000000000000000..49a2d921ff10cff65ff79351c40409cc1e5b4c11
--- /dev/null
+++ b/evidence/claim-subsets.k
@@ -0,0 +1,151 @@
+requires "verification.k"
+
+// Reviewer-authored cumulative subsets. Each module adds the next real claim
+// dependency: loop state 3 is self-contained; state 2 uses state 3; state 1
+// uses states 2 and 3; state 0 uses states 1, 2, and 3.
+
+module AUDIT-SPEC-LOOP3
+  imports VERIFICATION
+
+  claim
+    <k> iterate("bracket", BS:BString, loopBody)
+         ~> (Return(Bool(false)) .Stmts) => .K </k>
+    <functions>
+      "is_nested" |-> function(Params("string"), solutionBody) => .Map
+    </functions>
+    <env>
+      ( "string"  |-> strVal(_ORIG:BString)
+        "state"   |-> intVal(3)
+        "bracket" |-> strVal(_CUR:BString) ) => .Map
+    </env>
+    <result> noResult => boolVal(scan(3, BS)) </result>
+endmodule
+
+module AUDIT-SPEC-LOOP2
+  imports VERIFICATION
+
+  claim
+    <k> iterate("bracket", BS:BString, loopBody)
+         ~> (Return(Bool(false)) .Stmts) => .K </k>
+    <functions>
+      "is_nested" |-> function(Params("string"), solutionBody) => .Map
+    </functions>
+    <env>
+      ( "string"  |-> strVal(_ORIG:BString)
+        "state"   |-> intVal(2)
+        "bracket" |-> strVal(_CUR:BString) ) => .Map
+    </env>
+    <result> noResult => boolVal(scan(2, BS)) </result>
+
+  claim
+    <k> iterate("bracket", BS:BString, loopBody)
+         ~> (Return(Bool(false)) .Stmts) => .K </k>
+    <functions>
+      "is_nested" |-> function(Params("string"), solutionBody) => .Map
+    </functions>
+    <env>
+      ( "string"  |-> strVal(_ORIG:BString)
+        "state"   |-> intVal(3)
+        "bracket" |-> strVal(_CUR:BString) ) => .Map
+    </env>
+    <result> noResult => boolVal(scan(3, BS)) </result>
+endmodule
+
+module AUDIT-SPEC-LOOP1
+  imports VERIFICATION
+
+  claim
+    <k> iterate("bracket", BS:BString, loopBody)
+         ~> (Return(Bool(false)) .Stmts) => .K </k>
+    <functions>
+      "is_nested" |-> function(Params("string"), solutionBody) => .Map
+    </functions>
+    <env>
+      ( "string"  |-> strVal(_ORIG:BString)
+        "state"   |-> intVal(1)
+        "bracket" |-> strVal(_CUR:BString) ) => .Map
+    </env>
+    <result> noResult => boolVal(scan(1, BS)) </result>
+
+  claim
+    <k> iterate("bracket", BS:BString, loopBody)
+         ~> (Return(Bool(false)) .Stmts) => .K </k>
+    <functions>
+      "is_nested" |-> function(Params("string"), solutionBody) => .Map
+    </functions>
+    <env>
+      ( "string"  |-> strVal(_ORIG:BString)
+        "state"   |-> intVal(2)
+        "bracket" |-> strVal(_CUR:BString) ) => .Map
+    </env>
+    <result> noResult => boolVal(scan(2, BS)) </result>
+
+  claim
+    <k> iterate("bracket", BS:BString, loopBody)
+         ~> (Return(Bool(false)) .Stmts) => .K </k>
+    <functions>
+      "is_nested" |-> function(Params("string"), solutionBody) => .Map
+    </functions>
+    <env>
+      ( "string"  |-> strVal(_ORIG:BString)
+        "state"   |-> intVal(3)
+        "bracket" |-> strVal(_CUR:BString) ) => .Map
+    </env>
+    <result> noResult => boolVal(scan(3, BS)) </result>
+endmodule
+
+module AUDIT-SPEC-LOOP0
+  imports VERIFICATION
+
+  claim
+    <k> iterate("bracket", BS:BString, loopBody)
