+#!/usr/bin/env bash
+set -uo pipefail
+
+kast solution.regenerated.mpy \
+  --definition audit-verification-kompiled \
+  --module MPY-SYNTAX \
+  --sort Module \
+  --output kore > regenerated.kore
+left_status=$?
+
+kast pinned-solution.mpy \
+  --definition audit-verification-kompiled \
+  --module MPY-SYNTAX \
+  --sort Module \
+  --output kore > pinned.kore
+right_status=$?
+
+cmp -s regenerated.kore pinned.kore
+cmp_status=$?
+
+printf 'regenerated_kast_exit=%s\n' "$left_status"
+printf 'pinned_kast_exit=%s\n' "$right_status"
+printf 'constructor_kore_cmp_exit=%s\n' "$cmp_status"
+sha256sum regenerated.kore pinned.kore
+
+if [[ $left_status -ne 0 || $right_status -ne 0 || $cmp_status -ne 0 ]]; then
+  exit 1
+fi
diff --git a/evidence/claim-subsets.k b/evidence/claim-subsets.k
new file mode 100644
index 0000000000000000000000000000000000000000..49a2d921ff10cff65ff79351c40409cc1e5b4c11
--- /dev/null
+++ b/evidence/claim-subsets.k
@@ -0,0 +1,151 @@
+requires "verification.k"
+
+// Reviewer-authored cumulative subsets. Each module adds the next real claim
+// dependency: loop state 3 is self-contained; state 2 uses state 3; state 1
+// uses states 2 and 3; state 0 uses states 1, 2, and 3.
+
+module AUDIT-SPEC-LOOP3
+  imports VERIFICATION
+
+  claim
+    <k> iterate("bracket", BS:BString, loopBody)
+         ~> (Return(Bool(false)) .Stmts) => .K </k>
+    <functions>
+      "is_nested" |-> function(Params("string"), solutionBody) => .Map
+    </functions>
+    <env>
+      ( "string"  |-> strVal(_ORIG:BString)
+        "state"   |-> intVal(3)
+        "bracket" |-> strVal(_CUR:BString) ) => .Map
+    </env>
+    <result> noResult => boolVal(scan(3, BS)) </result>
+endmodule
+
+module AUDIT-SPEC-LOOP2
+  imports VERIFICATION
+
+  claim
+    <k> iterate("bracket", BS:BString, loopBody)
+         ~> (Return(Bool(false)) .Stmts) => .K </k>
+    <functions>
+      "is_nested" |-> function(Params("string"), solutionBody) => .Map
+    </functions>
+    <env>
+      ( "string"  |-> strVal(_ORIG:BString)
+        "state"   |-> intVal(2)
+        "bracket" |-> strVal(_CUR:BString) ) => .Map
+    </env>
+    <result> noResult => boolVal(scan(2, BS)) </result>
+
+  claim
+    <k> iterate("bracket", BS:BString, loopBody)
+         ~> (Return(Bool(false)) .Stmts) => .K </k>
