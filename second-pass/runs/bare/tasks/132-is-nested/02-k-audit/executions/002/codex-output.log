+                f"sha256={sha256_file(path)}"
+            )
+
+    top_level = Counter()
+    payload_types = Counter()
+    line_count = 0
+    for path in sorted((GENERATION / "codex-trace").rglob("*.jsonl")):
+        with path.open() as stream:
