+    --definition audit-verification-kompiled \
+    --spec-module "$module"
+  status=$?
+  printf 'TARGET_EXIT=%s\n' "$status"
+  if [[ $status -ne 0 ]]; then
+    overall=$status
+  fi
+done
+exit "$overall"
