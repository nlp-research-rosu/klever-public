@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+audit_tmp="${audit_log}.tmp"
+
+"$@" >"$audit_tmp" 2>&1
+audit_status=$?
