lse: print('no klean subset')\\nPY\",\"workdir\":\"/audit-output\",\"yield_time_ms\":10000,\"max_output_tokens\":10000}","call_id":"call_yj0qAq3fJ0YRshlSVnugtEa3","internal_chat_message_metadata_passthrough":{"turn_id":"019f9f45-477f-7610-812a-344113e8014a"}}}
