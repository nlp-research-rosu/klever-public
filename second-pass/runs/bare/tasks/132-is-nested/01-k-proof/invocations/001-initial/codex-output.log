new file mode 100644
index 0000000000000000000000000000000000000000..157688b70703927fb692fb187e29ff6eabb55a01
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def is_nested(string):
+    state = 0
+    for bracket in string:
+        if bracket == "[":
+            if state < 2:
+                state = state + 1
+        else:
+            if state == 2:
+                state = 3
+            else:
+                if state == 3:
+                    return True
+    return False

