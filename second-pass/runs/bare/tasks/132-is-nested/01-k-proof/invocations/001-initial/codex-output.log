+
+  claim
+    <py>
+      <k> iterate("bracket", BS:BString, loopBody)
+           ~> (Return(Bool(false)) .Stmts) </k>
+      <functions>
+        "is_nested" |-> function(Params("string"), solutionBody)
+      </functions>
+      <env>
+        "string"  |-> strVal(ORIG:BString)
+        "state"   |-> intVal(3)
+        "bracket" |-> strVal(CUR:BString)
+      </env>
+      <result> noResult </result>
+    </py>
+  =>
