+  rule scan(2, lbr BS) => scan(2, BS)
+  rule scan(2, rbr BS) => scan(3, BS)
+
+  rule scan(3, lbr BS) => scan(3, BS)
+  rule scan(3, rbr _)  => true
+endmodule

