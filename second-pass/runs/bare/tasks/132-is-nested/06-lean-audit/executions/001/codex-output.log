def inventory_verification(workspace: Path) -> dict[str, Any]:
    workspace = Path(workspace)
    try:
        workspace_mode = workspace.stat(follow_symlinks=False).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        ) from error
    if not stat.S_ISDIR(workspace_mode):
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        )
    verification = workspace / "verification.k"
    try:
        verification_mode = verification.stat(
            follow_symlinks=False
        ).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        ) from error
    if not stat.S_ISREG(verification_mode):
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        )
    try:
        verification_bytes = verification.read_bytes()
        text = verification_bytes.decode()
    except (OSError, UnicodeError) as error:
        raise KRuleInventoryError(
            f"cannot read verification.k: {verification}"
        ) from error
    masked_text = _mask_non_code(text)
    modules = _modules(masked_text)
    module = _verification_module(
        modules, _last_verification_main_module(workspace)
    )
    closure = _verification_closure(modules, module)
    rule_documents = _rule_documents(text, closure)
    return {
        "schema_version": 2,
        "verification_file": "verification.k",
        "verification_sha256": hashlib.sha256(verification_bytes).hexdigest(),
        "verification_module": module.name,
        "verification_modules": [module.name for module in closure],
        "rules": rule_documents,
        "inventory_sha256": canonical_json_sha256(rule_documents),
    }
requires "semantic.k"

module VERIFICATION
  imports SEMANTIC

  // Named AST fragments keep the invariant claims readable.  Each equation
  // expands to the constructors emitted in solution.mpy.
  syntax Stmts ::= "loopBody" [function, total]
  rule loopBody =>
    If(Compare(Name("bracket"), CmpOp("==", Str("[")), .CmpOps),
      If(Compare(Name("state"), CmpOp("<", Int(2)), .CmpOps),
        Assign(Name("state"), BinOp("+", Name("state"), Int(1))),
        .Stmts),
      If(Compare(Name("state"), CmpOp("==", Int(2)), .CmpOps),
        Assign(Name("state"), Int(3)),
        If(Compare(Name("state"), CmpOp("==", Int(3)), .CmpOps),
          Return(Bool(true)),
          .Stmts)))

  syntax Stmts ::= "solutionBody" [function, total]
  rule solutionBody =>
    Assign(Name("state"), Int(0))
    For(Name("bracket"), Name("string"), loopBody)
    Return(Bool(false))

  syntax Module ::= "theSolution" [function, total]
  rule theSolution =>
    Module(FuncDef("is_nested", Params("string"), solutionBody))

  // Independent reference automaton for the regular-language property
  // "[[]] is a subsequence".  States 0..3 mean that 0..3 required symbols
  // have already been observed.  Seeing the final right bracket yields true.
  syntax Bool ::= scan(Int, BString) [function, total]

  rule scan(_, .BString) => false

  rule scan(0, lbr BS) => scan(1, BS)
  rule scan(0, rbr BS) => scan(0, BS)

  rule scan(1, lbr BS) => scan(2, BS)
  rule scan(1, rbr BS) => scan(1, BS)

  rule scan(2, lbr BS) => scan(2, BS)
  rule scan(2, rbr BS) => scan(3, BS)

  rule scan(3, lbr BS) => scan(3, BS)
  rule scan(3, rbr _)  => true
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  // Loop invariants, one for each reference-automaton state.  ORIG is retained
  // in the Python local environment; CUR is the previous loop character (or
  // the dummy empty value before the first iteration).  Both are irrelevant
  // to the suffix result, which is exactly scan(State, BS).
  claim
    <k> iterate("bracket", BS:BString, loopBody)
         ~> (Return(Bool(false)) .Stmts) => .K </k>
    <functions>
      "is_nested" |-> function(Params("string"), solutionBody) => .Map
    </functions>
    <env>
      ( "string"  |-> strVal(_ORIG:BString)
        "state"   |-> intVal(0)
        "bracket" |-> strVal(_CUR:BString) ) => .Map
    </env>
    <result> noResult => boolVal(scan(0, BS)) </result>

  claim
    <k> iterate("bracket", BS:BString, loopBody)
         ~> (Return(Bool(false)) .Stmts) => .K </k>
    <functions>
      "is_nested" |-> function(Params("string"), solutionBody) => .Map
    </functions>
    <env>
      ( "string"  |-> strVal(_ORIG:BString)
        "state"   |-> intVal(1)
        "bracket" |-> strVal(_CUR:BString) ) => .Map
    </env>
    <result> noResult => boolVal(scan(1, BS)) </result>

  claim
    <k> iterate("bracket", BS:BString, loopBody)
         ~> (Return(Bool(false)) .Stmts) => .K </k>
    <functions>
      "is_nested" |-> function(Params("string"), solutionBody) => .Map
    </functions>
    <env>
      ( "string"  |-> strVal(_ORIG:BString)
        "state"   |-> intVal(2)
        "bracket" |-> strVal(_CUR:BString) ) => .Map
    </env>
    <result> noResult => boolVal(scan(2, BS)) </result>

  claim
    <k> iterate("bracket", BS:BString, loopBody)
         ~> (Return(Bool(false)) .Stmts) => .K </k>
    <functions>
      "is_nested" |-> function(Params("string"), solutionBody) => .Map
    </functions>
    <env>
      ( "string"  |-> strVal(_ORIG:BString)
        "state"   |-> intVal(3)
        "bracket" |-> strVal(_CUR:BString) ) => .Map
    </env>
    <result> noResult => boolVal(scan(3, BS)) </result>

  // Universal end-to-end functional correctness for every string admitted by
  // the prompt (that is, every finite BString of left/right brackets).
  claim
    <k> theSolution ~> start(BS:BString) => .K </k>
    <functions> .Map => .Map </functions>
    <env> .Map => .Map </env>
    <result> noResult => boolVal(scan(0, BS)) </result>
endmodule
requires "domains.md"

module MPY-SYNTAX
  imports INT-SYNTAX
  imports BOOL-SYNTAX
  imports STRING-SYNTAX

  // The prompt restricts inputs to square brackets.  BString is therefore a
  // complete, inductive representation of every input in the task's domain.
  syntax Bracket ::= "lbr" | "rbr"
  syntax BString ::= ".BString" | Bracket BString

  syntax Module ::= "Module" "(" Stmts ")"
  syntax Strings ::= List{String, ","}
  syntax Params ::= "Params" "(" Strings ")"

  syntax CmpOps ::= List{CmpOp, ","}
  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"

  syntax Expr ::= "Name" "(" String ")"
                | "Int" "(" Int ")"
                | "Bool" "(" Bool ")"
                | "Str" "(" String ")"
                | "BinOp" "(" String "," Expr "," Expr ")"
                | "Compare" "(" Expr "," CmpOps ")"

  syntax Stmts ::= List{Stmt, ""}
  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
                | "Assign" "(" Expr "," Expr ")"
                | "For" "(" Expr "," Expr "," Stmts ")"
                | "If" "(" Expr "," Stmts "," Stmts ")"
                | "Return" "(" Expr ")"
endmodule

module SEMANTIC
  imports MPY-SYNTAX
  imports INT
  imports BOOL
  imports MAP

  syntax Val ::= "intVal" "(" Int ")"
               | "boolVal" "(" Bool ")"
               | "strVal" "(" BString ")"
  syntax Result ::= "noResult" | Val
  syntax Function ::= "function" "(" Params "," Stmts ")"

  syntax KItem ::= "start" "(" BString ")"
                 | "iterate" "(" String "," BString "," Stmts ")"

  configuration
    <py>
      <k> $PGM:Module ~> start($INPUT:BString) </k>
      <functions> .Map </functions>
      <env> .Map </env>
      <result> noResult </result>
    </py>

  // Module loading and the one-argument call used by this task.
  rule <k> Module(SS) => SS ... </k>
  rule <k> (S:Stmt SS:Stmts):Stmts => S ~> SS ... </k>
  rule <k> .Stmts => .K ... </k>

  rule <k> FuncDef(F, PS, BODY) => .K ... </k>
       <functions> FS => FS [ F <- function(PS, BODY) ] </functions>

  rule <k> start(BS) => BODY ... </k>
       <functions>
         ... "is_nested" |-> function(Params("string"), BODY) ...
       </functions>
       <env> _ => "string" |-> strVal(BS) </env>

  // Expressions in the implementation are pure, so a mathematical evaluator
  // keeps the operational statement rules small and proof-friendly.
  syntax Val ::= eval(Expr, Map) [function]
  syntax Val ::= add(Val, Val) [function]
  syntax Val ::= compare(String, Val, Val) [function]
  syntax Val ::= getVal(KItem) [function]

  rule eval(Name(X), ENV) => getVal(ENV [ X ])
  rule getVal(V:Val) => V
  rule eval(Int(I), _) => intVal(I)
  rule eval(Bool(B), _) => boolVal(B)
  rule eval(Str("["), _) => strVal(lbr .BString)
  rule eval(Str("]"), _) => strVal(rbr .BString)
  rule eval(BinOp("+", E1, E2), ENV) => add(eval(E1, ENV), eval(E2, ENV))
  rule eval(Compare(E1, CmpOp(OP, E2), .CmpOps), ENV)
    => compare(OP, eval(E1, ENV), eval(E2, ENV))

  rule add(intVal(I), intVal(J)) => intVal(I +Int J)

  rule compare("==", intVal(I), intVal(J)) => boolVal(I ==Int J)
  rule compare("<",  intVal(I), intVal(J)) => boolVal(I <Int J)
  rule compare("==", strVal(lbr .BString), strVal(lbr .BString))
    => boolVal(true)
  rule compare("==", strVal(lbr .BString), strVal(rbr .BString))
    => boolVal(false)
  rule compare("==", strVal(rbr .BString), strVal(lbr .BString))
    => boolVal(false)
  rule compare("==", strVal(rbr .BString), strVal(rbr .BString))
    => boolVal(true)

  syntax Stmts ::= choose(Val, Stmts, Stmts) [function]
  rule choose(boolVal(true),  THEN, _) => THEN
  rule choose(boolVal(false), _, ELSE) => ELSE

  // Assignment and branching.
  rule <k> Assign(Name(X), E) => .K ... </k>
       <env> ENV => ENV [ X <- eval(E, ENV) ] </env>

  rule <k> (If(E, THEN, ELSE)):KItem
        => (choose(eval(E, ENV), THEN, ELSE)):KItem ... </k>
       <env> ENV </env>

  // Python's iteration over a bracket string, one one-character string at a
  // time.  The continuation makes early Return discard the unvisited suffix.
  rule <k> For(Name(X), E, BODY)
        => iterate(X, getString(eval(E, ENV)), BODY) ... </k>
       <env> ENV => ENV [ X <- strVal(.BString) ] </env>

  syntax BString ::= getString(Val) [function]
  rule getString(strVal(BS)) => BS

  rule <k> iterate(_, .BString, _) => .K ... </k>
  rule <k> iterate(X, lbr BS:BString, BODY)
        => BODY ~> iterate(X, BS, BODY) ... </k>
       <env> ENV => ENV [ X <- strVal(lbr .BString) ] </env>
  rule <k> iterate(X, rbr BS:BString, BODY)
        => BODY ~> iterate(X, BS, BODY) ... </k>
       <env> ENV => ENV [ X <- strVal(rbr .BString) ] </env>

  // This task runs one function.  Clearing the K cell faithfully implements
  // the non-local control effect of a Python return from inside the loop.
  rule <k> Return(E) ~> _REST:K => .K </k>
       <functions> _ => .Map </functions>
       <env> ENV => .Map </env>
       <result> _ => eval(E, ENV) </result>
endmodule
def is_nested(string):
    state = 0
    for bracket in string:
        if bracket == "[":
            if state < 2:
                state = state + 1
        else:
            if state == 2:
                state = 3
            else:
                if state == 3:
                    return True
    return False
