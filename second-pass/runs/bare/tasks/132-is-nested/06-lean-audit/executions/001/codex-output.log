+    resolution["hashes"]["discovery_manifest_sha256"],
+)
+emit(
+    "selected k-audit artifact_sha256",
+    resolution["hashes"]["k_audit_sha256"],
+    resolution["selections"]["k_audit"]["artifact_sha256"],
+)
+emit(
+    "selected generation artifact_sha256",
