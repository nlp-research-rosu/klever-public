COMMAND: nl -ba /reference/k-proof/verification.k
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // Named AST fragments keep the invariant claims readable.  Each equation
     7	  // expands to the constructors emitted in solution.mpy.
     8	  syntax Stmts ::= "loopBody" [function, total]
     9	  rule loopBody =>
    10	    If(Compare(Name("bracket"), CmpOp("==", Str("[")), .CmpOps),
    11	      If(Compare(Name("state"), CmpOp("<", Int(2)), .CmpOps),
    12	        Assign(Name("state"), BinOp("+", Name("state"), Int(1))),
    13	        .Stmts),
    14	      If(Compare(Name("state"), CmpOp("==", Int(2)), .CmpOps),
    15	        Assign(Name("state"), Int(3)),
    16	        If(Compare(Name("state"), CmpOp("==", Int(3)), .CmpOps),
    17	          Return(Bool(true)),
    18	          .Stmts)))
    19	
    20	  syntax Stmts ::= "solutionBody" [function, total]
    21	  rule solutionBody =>
    22	    Assign(Name("state"), Int(0))
    23	    For(Name("bracket"), Name("string"), loopBody)
    24	    Return(Bool(false))
    25	
    26	  syntax Module ::= "theSolution" [function, total]
    27	  rule theSolution =>
    28	    Module(FuncDef("is_nested", Params("string"), solutionBody))
    29	
    30	  // Independent reference automaton for the regular-language property
    31	  // "[[]] is a subsequence".  States 0..3 mean that 0..3 required symbols
    32	  // have already been observed.  Seeing the final right bracket yields true.
    33	  syntax Bool ::= scan(Int, BString) [function, total]
    34	
    35	  rule scan(_, .BString) => false
    36	
    37	  rule scan(0, lbr BS) => scan(1, BS)
    38	  rule scan(0, rbr BS) => scan(0, BS)
    39	
    40	  rule scan(1, lbr BS) => scan(2, BS)
    41	  rule scan(1, rbr BS) => scan(1, BS)
    42	
    43	  rule scan(2, lbr BS) => scan(2, BS)
    44	  rule scan(2, rbr BS) => scan(3, BS)
    45	
    46	  rule scan(3, lbr BS) => scan(3, BS)
    47	  rule scan(3, rbr _)  => true
    48	endmodule
COMMAND: nl -ba /reference/k-proof/solution.py
     1	def is_nested(string):
     2	    state = 0
     3	    for bracket in string:
     4	        if bracket == "[":
     5	            if state < 2:
     6	                state = state + 1
     7	        else:
     8	            if state == 2:
     9	                state = 3
    10	            else:
    11	                if state == 3:
    12	                    return True
    13	    return False
COMMAND: nl -ba /reference/k-proof/solution.mpy
     1	Module(
     2	  FuncDef("is_nested", Params("string"),
     3	    Assign(Name("state"), Int(0))
     4	    For(Name("bracket"), Name("string"),
     5	      If(Compare(Name("bracket"), CmpOp("==", Str("["))),
     6	        If(Compare(Name("state"), CmpOp("<", Int(2))),
     7	          Assign(Name("state"), BinOp("+", Name("state"), Int(1))),
     8	          ),
     9	        If(Compare(Name("state"), CmpOp("==", Int(2))),
    10	          Assign(Name("state"), Int(3)),
    11	          If(Compare(Name("state"), CmpOp("==", Int(3))),
    12	            Return(Bool(true)),
    13	            ))))
    14	    Return(Bool(false))))
COMMAND: nl -ba /reference/k-proof/semantic.k
     1	requires "domains.md"
     2	
     3	module MPY-SYNTAX
     4	  imports INT-SYNTAX
     5	  imports BOOL-SYNTAX
     6	  imports STRING-SYNTAX
     7	
     8	  // The prompt restricts inputs to square brackets.  BString is therefore a
     9	  // complete, inductive representation of every input in the task's domain.
    10	  syntax Bracket ::= "lbr" | "rbr"
    11	  syntax BString ::= ".BString" | Bracket BString
    12	
    13	  syntax Module ::= "Module" "(" Stmts ")"
    14	  syntax Strings ::= List{String, ","}
    15	  syntax Params ::= "Params" "(" Strings ")"
    16	
    17	  syntax CmpOps ::= List{CmpOp, ","}
    18	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    19	
    20	  syntax Expr ::= "Name" "(" String ")"
    21	                | "Int" "(" Int ")"
    22	                | "Bool" "(" Bool ")"
    23	                | "Str" "(" String ")"
    24	                | "BinOp" "(" String "," Expr "," Expr ")"
    25	                | "Compare" "(" Expr "," CmpOps ")"
    26	
    27	  syntax Stmts ::= List{Stmt, ""}
    28	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
    29	                | "Assign" "(" Expr "," Expr ")"
    30	                | "For" "(" Expr "," Expr "," Stmts ")"
    31	                | "If" "(" Expr "," Stmts "," Stmts ")"
    32	                | "Return" "(" Expr ")"
    33	endmodule
    34	
    35	module SEMANTIC
    36	  imports MPY-SYNTAX
    37	  imports INT
    38	  imports BOOL
    39	  imports MAP
    40	
    41	  syntax Val ::= "intVal" "(" Int ")"
    42	               | "boolVal" "(" Bool ")"
    43	               | "strVal" "(" BString ")"
    44	  syntax Result ::= "noResult" | Val
    45	  syntax Function ::= "function" "(" Params "," Stmts ")"
    46	
    47	  syntax KItem ::= "start" "(" BString ")"
    48	                 | "iterate" "(" String "," BString "," Stmts ")"
    49	
    50	  configuration
    51	    <py>
    52	      <k> $PGM:Module ~> start($INPUT:BString) </k>
    53	      <functions> .Map </functions>
    54	      <env> .Map </env>
    55	      <result> noResult </result>
    56	    </py>
    57	
    58	  // Module loading and the one-argument call used by this task.
    59	  rule <k> Module(SS) => SS ... </k>
    60	  rule <k> (S:Stmt SS:Stmts):Stmts => S ~> SS ... </k>
    61	  rule <k> .Stmts => .K ... </k>
    62	
    63	  rule <k> FuncDef(F, PS, BODY) => .K ... </k>
    64	       <functions> FS => FS [ F <- function(PS, BODY) ] </functions>
    65	
    66	  rule <k> start(BS) => BODY ... </k>
    67	       <functions>
    68	         ... "is_nested" |-> function(Params("string"), BODY) ...
    69	       </functions>
    70	       <env> _ => "string" |-> strVal(BS) </env>
    71	
    72	  // Expressions in the implementation are pure, so a mathematical evaluator
    73	  // keeps the operational statement rules small and proof-friendly.
    74	  syntax Val ::= eval(Expr, Map) [function]
    75	  syntax Val ::= add(Val, Val) [function]
    76	  syntax Val ::= compare(String, Val, Val) [function]
    77	  syntax Val ::= getVal(KItem) [function]
    78	
    79	  rule eval(Name(X), ENV) => getVal(ENV [ X ])
    80	  rule getVal(V:Val) => V
    81	  rule eval(Int(I), _) => intVal(I)
    82	  rule eval(Bool(B), _) => boolVal(B)
    83	  rule eval(Str("["), _) => strVal(lbr .BString)
    84	  rule eval(Str("]"), _) => strVal(rbr .BString)
    85	  rule eval(BinOp("+", E1, E2), ENV) => add(eval(E1, ENV), eval(E2, ENV))
    86	  rule eval(Compare(E1, CmpOp(OP, E2), .CmpOps), ENV)
    87	    => compare(OP, eval(E1, ENV), eval(E2, ENV))
    88	
    89	  rule add(intVal(I), intVal(J)) => intVal(I +Int J)
    90	
    91	  rule compare("==", intVal(I), intVal(J)) => boolVal(I ==Int J)
    92	  rule compare("<",  intVal(I), intVal(J)) => boolVal(I <Int J)
    93	  rule compare("==", strVal(lbr .BString), strVal(lbr .BString))
    94	    => boolVal(true)
    95	  rule compare("==", strVal(lbr .BString), strVal(rbr .BString))
    96	    => boolVal(false)
    97	  rule compare("==", strVal(rbr .BString), strVal(lbr .BString))
    98	    => boolVal(false)
    99	  rule compare("==", strVal(rbr .BString), strVal(rbr .BString))
   100	    => boolVal(true)
   101	
   102	  syntax Stmts ::= choose(Val, Stmts, Stmts) [function]
   103	  rule choose(boolVal(true),  THEN, _) => THEN
   104	  rule choose(boolVal(false), _, ELSE) => ELSE
   105	
   106	  // Assignment and branching.
   107	  rule <k> Assign(Name(X), E) => .K ... </k>
   108	       <env> ENV => ENV [ X <- eval(E, ENV) ] </env>
   109	
   110	  rule <k> (If(E, THEN, ELSE)):KItem
   111	        => (choose(eval(E, ENV), THEN, ELSE)):KItem ... </k>
   112	       <env> ENV </env>
   113	
   114	  // Python's iteration over a bracket string, one one-character string at a
   115	  // time.  The continuation makes early Return discard the unvisited suffix.
   116	  rule <k> For(Name(X), E, BODY)
   117	        => iterate(X, getString(eval(E, ENV)), BODY) ... </k>
   118	       <env> ENV => ENV [ X <- strVal(.BString) ] </env>
   119	
   120	  syntax BString ::= getString(Val) [function]
   121	  rule getString(strVal(BS)) => BS
   122	
   123	  rule <k> iterate(_, .BString, _) => .K ... </k>
   124	  rule <k> iterate(X, lbr BS:BString, BODY)
   125	        => BODY ~> iterate(X, BS, BODY) ... </k>
   126	       <env> ENV => ENV [ X <- strVal(lbr .BString) ] </env>
   127	  rule <k> iterate(X, rbr BS:BString, BODY)
   128	        => BODY ~> iterate(X, BS, BODY) ... </k>
   129	       <env> ENV => ENV [ X <- strVal(rbr .BString) ] </env>
   130	
   131	  // This task runs one function.  Clearing the K cell faithfully implements
   132	  // the non-local control effect of a Python return from inside the loop.
   133	  rule <k> Return(E) ~> _REST:K => .K </k>
   134	       <functions> _ => .Map </functions>
   135	       <env> ENV => .Map </env>
   136	       <result> _ => eval(E, ENV) </result>
   137	endmodule
COMMAND: nl -ba /reference/k-proof/spec.k
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Loop invariants, one for each reference-automaton state.  ORIG is retained
     7	  // in the Python local environment; CUR is the previous loop character (or
     8	  // the dummy empty value before the first iteration).  Both are irrelevant
     9	  // to the suffix result, which is exactly scan(State, BS).
    10	  claim
    11	    <k> iterate("bracket", BS:BString, loopBody)
    12	         ~> (Return(Bool(false)) .Stmts) => .K </k>
    13	    <functions>
    14	      "is_nested" |-> function(Params("string"), solutionBody) => .Map
    15	    </functions>
    16	    <env>
    17	      ( "string"  |-> strVal(_ORIG:BString)
    18	        "state"   |-> intVal(0)
    19	        "bracket" |-> strVal(_CUR:BString) ) => .Map
    20	    </env>
    21	    <result> noResult => boolVal(scan(0, BS)) </result>
    22	
    23	  claim
    24	    <k> iterate("bracket", BS:BString, loopBody)
    25	         ~> (Return(Bool(false)) .Stmts) => .K </k>
    26	    <functions>
    27	      "is_nested" |-> function(Params("string"), solutionBody) => .Map
    28	    </functions>
    29	    <env>
    30	      ( "string"  |-> strVal(_ORIG:BString)
    31	        "state"   |-> intVal(1)
    32	        "bracket" |-> strVal(_CUR:BString) ) => .Map
    33	    </env>
    34	    <result> noResult => boolVal(scan(1, BS)) </result>
    35	
    36	  claim
    37	    <k> iterate("bracket", BS:BString, loopBody)
    38	         ~> (Return(Bool(false)) .Stmts) => .K </k>
    39	    <functions>
    40	      "is_nested" |-> function(Params("string"), solutionBody) => .Map
    41	    </functions>
    42	    <env>
    43	      ( "string"  |-> strVal(_ORIG:BString)
    44	        "state"   |-> intVal(2)
    45	        "bracket" |-> strVal(_CUR:BString) ) => .Map
    46	    </env>
    47	    <result> noResult => boolVal(scan(2, BS)) </result>
    48	
    49	  claim
    50	    <k> iterate("bracket", BS:BString, loopBody)
    51	         ~> (Return(Bool(false)) .Stmts) => .K </k>
    52	    <functions>
    53	      "is_nested" |-> function(Params("string"), solutionBody) => .Map
    54	    </functions>
    55	    <env>
    56	      ( "string"  |-> strVal(_ORIG:BString)
    57	        "state"   |-> intVal(3)
    58	        "bracket" |-> strVal(_CUR:BString) ) => .Map
    59	    </env>
    60	    <result> noResult => boolVal(scan(3, BS)) </result>
    61	
    62	  // Universal end-to-end functional correctness for every string admitted by
    63	  // the prompt (that is, every finite BString of left/right brackets).
    64	  claim
    65	    <k> theSolution ~> start(BS:BString) => .K </k>
    66	    <functions> .Map => .Map </functions>
    67	    <env> .Map => .Map </env>
    68	    <result> noResult => boolVal(scan(0, BS)) </result>
    69	endmodule
COMMAND: nl -ba /reference/k-proof/prove.sh
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Regenerate the constructor term with the supplied, unmodified translator.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# Concrete backend and all examples from prompt.py.
     8	kompile semantic.k --backend llvm --main-module SEMANTIC --syntax-module MPY-SYNTAX
     9	krun solution.mpy -cINPUT='lbr lbr rbr rbr .BString' --definition semantic-kompiled | grep -F 'boolVal ( true )'
    10	krun solution.mpy -cINPUT='lbr rbr rbr rbr rbr rbr rbr rbr lbr lbr lbr lbr lbr rbr .BString' --definition semantic-kompiled | grep -F 'boolVal ( false )'
    11	krun solution.mpy -cINPUT='lbr rbr lbr rbr .BString' --definition semantic-kompiled | grep -F 'boolVal ( false )'
    12	krun solution.mpy -cINPUT='lbr rbr .BString' --definition semantic-kompiled | grep -F 'boolVal ( false )'
    13	krun solution.mpy -cINPUT='lbr lbr rbr lbr rbr rbr .BString' --definition semantic-kompiled | grep -F 'boolVal ( true )'
    14	krun solution.mpy -cINPUT='lbr lbr rbr rbr lbr lbr .BString' --definition semantic-kompiled | grep -F 'boolVal ( true )'
    15	
    16	# Symbolic backend and all five claims (four loop invariants plus the universal
    17	# end-to-end theorem).  A successful run prints #Top and exits zero.
    18	kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX
    19	kprove spec.k --definition verification-kompiled --spec-module SPEC
