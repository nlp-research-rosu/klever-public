      "start_line": 9,
      "text": "  rule loopBody =>\n    If(Compare(Name(\"bracket\"), CmpOp(\"==\", Str(\"[\")), .CmpOps),\n      If(Compare(Name(\"state\"), CmpOp(\"<\", Int(2)), .CmpOps),\n        Assign(Name(\"state\"), BinOp(\"+\", Name(\"state\"), Int(1))),\n        .Stmts),\n      If(Compare(Name(\"state\"), CmpOp(\"==\", Int(2)), .CmpOps),\n        Assign(Name(\"state\"), Int(3)),\n        If(Compare(Name(\"state\"), CmpOp(\"==\", Int(3)), .CmpOps),\n          Return(Bool(true)),\n          .Stmts)))"
    },
    {
      "attributes": [],
      "end_line": 24,
      "module": "VERIFICATION",
      "normalized_sha256": "d6581cc03479c04895f5c7e9ccdb63d5ce850bed8ddd475654f91bd31b597037",
      "source_rule_id": "rule-d6581cc03479c04895f5c7e9ccdb63d5ce850bed8ddd475654f91bd31b597037",
      "start_line": 21,
      "text": "  rule solutionBody =>\n    Assign(Name(\"state\"), Int(0))\n    For(Name(\"bracket\"), Name(\"string\"), loopBody)\n    Return(Bool(false))"
    },
    {
      "attributes": [],
      "end_line": 28,
