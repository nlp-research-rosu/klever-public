requires "semantic.k"

module VERIFICATION
  imports SEMANTIC

  // Named AST fragments keep the invariant claims readable.  Each equation
  // expands to the constructors emitted in solution.mpy.
  syntax Stmts ::= "loopBody" [function, total]
  rule loopBody =>
    If(Compare(Name("bracket"), CmpOp("==", Str("[")), .CmpOps),
      If(Compare(Name("state"), CmpOp("<", Int(2)), .CmpOps),
        Assign(Name("state"), BinOp("+", Name("state"), Int(1))),
        .Stmts),
      If(Compare(Name("state"), CmpOp("==", Int(2)), .CmpOps),
        Assign(Name("state"), Int(3)),
        If(Compare(Name("state"), CmpOp("==", Int(3)), .CmpOps),
          Return(Bool(true)),
          .Stmts)))

  syntax Stmts ::= "solutionBody" [function, total]
  rule solutionBody =>
    Assign(Name("state"), Int(0))
    For(Name("bracket"), Name("string"), loopBody)
    Return(Bool(false))

  syntax Module ::= "theSolution" [function, total]
  rule theSolution =>
    Module(FuncDef("is_nested", Params("string"), solutionBody))

  // Independent reference automaton for the regular-language property
  // "[[]] is a subsequence".  States 0..3 mean that 0..3 required symbols
  // have already been observed.  Seeing the final right bracket yields true.
  syntax Bool ::= scan(Int, BString) [function, total]

  rule scan(_, .BString) => false

  rule scan(0, lbr BS) => scan(1, BS)
  rule scan(0, rbr BS) => scan(0, BS)

  rule scan(1, lbr BS) => scan(2, BS)
  rule scan(1, rbr BS) => scan(1, BS)

  rule scan(2, lbr BS) => scan(2, BS)
  rule scan(2, rbr BS) => scan(3, BS)

  rule scan(3, lbr BS) => scan(3, BS)
  rule scan(3, rbr _)  => true
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  // Loop invariants, one for each reference-automaton state.  ORIG is retained
  // in the Python local environment; CUR is the previous loop character (or
  // the dummy empty value before the first iteration).  Both are irrelevant
  // to the suffix result, which is exactly scan(State, BS).
  claim
    <k> iterate("bracket", BS:BString, loopBody)
         ~> (Return(Bool(false)) .Stmts) => .K </k>
    <functions>
      "is_nested" |-> function(Params("string"), solutionBody) => .Map
    </functions>
    <env>
      ( "string"  |-> strVal(_ORIG:BString)
        "state"   |-> intVal(0)
        "bracket" |-> strVal(_CUR:BString) ) => .Map
    </env>
    <result> noResult => boolVal(scan(0, BS)) </result>

  claim
    <k> iterate("bracket", BS:BString, loopBody)
         ~> (Return(Bool(false)) .Stmts) => .K </k>
    <functions>
      "is_nested" |-> function(Params("string"), solutionBody) => .Map
    </functions>
    <env>
      ( "string"  |-> strVal(_ORIG:BString)
        "state"   |-> intVal(1)
        "bracket" |-> strVal(_CUR:BString) ) => .Map
    </env>
    <result> noResult => boolVal(scan(1, BS)) </result>

  claim
    <k> iterate("bracket", BS:BString, loopBody)
         ~> (Return(Bool(false)) .Stmts) => .K </k>
    <functions>
      "is_nested" |-> function(Params("string"), solutionBody) => .Map
    </functions>
    <env>
      ( "string"  |-> strVal(_ORIG:BString)
        "state"   |-> intVal(2)
        "bracket" |-> strVal(_CUR:BString) ) => .Map
    </env>
    <result> noResult => boolVal(scan(2, BS)) </result>

  claim
    <k> iterate("bracket", BS:BString, loopBody)
         ~> (Return(Bool(false)) .Stmts) => .K </k>
    <functions>
      "is_nested" |-> function(Params("string"), solutionBody) => .Map
    </functions>
    <env>
      ( "string"  |-> strVal(_ORIG:BString)
        "state"   |-> intVal(3)
        "bracket" |-> strVal(_CUR:BString) ) => .Map
    </env>
    <result> noResult => boolVal(scan(3, BS)) </result>

  // Universal end-to-end functional correctness for every string admitted by
  // the prompt (that is, every finite BString of left/right brackets).
  claim
    <k> theSolution ~> start(BS:BString) => .K </k>
    <functions> .Map => .Map </functions>
    <env> .Map => .Map </env>
    <result> noResult => boolVal(scan(0, BS)) </result>
endmodule
