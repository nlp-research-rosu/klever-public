     1	def strange_sorted(ordered):
     2	    if len(ordered) == 0:
     3	        return []
     4	    if len(ordered) == 1:
     5	        return ordered
     6	    return [ordered[0], ordered[-1]] + strange_sorted(ordered[1:-1])
