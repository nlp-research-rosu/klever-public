index 0000000000000000000000000000000000000000..6e1ea565a35bcf1acb57aaa564b4c41f65ba1eec
--- /dev/null
+++ b/evidence/solution-body-mutated.mpy
@@ -0,0 +1,22 @@
+Module(
+  FuncDef("strange_sorted", Params("ordered"),
+    If(Compare(Call(Name("len"), Name("ordered")), CmpOp("==", Int(0))),
+      Return(ListExpr()),
+      )
+    If(Compare(Call(Name("len"), Name("ordered")), CmpOp("==", Int(1))),
+      Return(Name("ordered")),
+      )
+    Return(
+      BinOp(
+        "+",
+        ListExpr(
+          Subscript(Name("ordered"), Int(999)),
+          Subscript(Name("ordered"), UnaryOp("-", Int(1)))),
+        Call(
+          Name("strange_sorted"),
+          Subscript(
+            Name("ordered"),
+            Slice(Int(1), UnaryOp("-", Int(1)), NoBound))))))
+  FuncDef("strange_sort_list", Params("lst"),
+    Return(
+      Call(Name("strange_sorted"), Call(Name("sorted"), Name("lst"))))))
diff --git a/evidence/spec-vacuity-audit.k b/evidence/spec-vacuity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..f45575439f978c857250fe991209fe86175ecfc5
--- /dev/null
+++ b/evidence/spec-vacuity-audit.k
@@ -0,0 +1,17 @@
+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
