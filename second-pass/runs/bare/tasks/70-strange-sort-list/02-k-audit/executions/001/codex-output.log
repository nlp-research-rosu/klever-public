     3	module MPY-SYNTAX
     4	  imports INT-SYNTAX
     5	  imports STRING-SYNTAX
     6	
     7	  syntax Module ::= "Module" "(" Stmts ")"
     8	
     9	  syntax Stmts ::= List{Stmt, ""}
    10	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
    11	                | "Assign" "(" Expr "," Expr ")"
    12	                | "If" "(" Expr "," Stmts "," Stmts ")"
    13	                | "Return" "(" Expr ")"
    14	
    15	  syntax Params ::= "Params" "(" String ")"
    16	
    17	  syntax Expr ::= "Name" "(" String ")"
    18	                | "Int" "(" Int ")"
    19	                | "ListExpr" "(" ")"
    20	                | "ListExpr" "(" Expr "," Expr ")"
    21	                | "Call" "(" Expr "," Expr ")"
    22	                | "Compare" "(" Expr "," CmpOp ")"
    23	                | "BinOp" "(" String "," Expr "," Expr ")"
    24	                | "UnaryOp" "(" String "," Expr ")"
    25	                | "Subscript" "(" Expr "," Index ")"
    26	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    27	  syntax Index ::= Expr
    28	                 | "Slice" "(" Bound "," Bound "," Bound ")"
    29	  syntax Bound ::= Expr | "NoBound"
    30	endmodule
    31	
    32	module SEMANTIC
    33	  imports MPY-SYNTAX
    34	  imports BOOL
    35	  imports INT
    36	  imports MAP
    37	  imports STRING
    38	
    39	  // Python integer-list values.  A dedicated algebraic list keeps the
    40	  // semantics and its proofs independent of K's collection representation.
    41	  syntax PList ::= "nil"
    42	                 | "cons" "(" Int "," PList ")"
    43	
    44	  syntax PVal ::= "pInt" "(" Int ")"
    45	                | "pBool" "(" Bool ")"
    46	                | "pList" "(" PList ")"
    47	
    48	  syntax Outcome ::= "pending"
    49	                   | "normal" "(" Map ")"
    50	                   | "returned" "(" PVal ")"
    51	  syntax Outcome ::= PVal
    52	
    53	  configuration
    54	    <python>
    55	      <program> $PGM:Module </program>
    56	      <input> $INPUT:PList </input>
    57	      <entry> $ENTRY:String </entry>
    58	      <result> pending </result>
    59	    </python>
    60	
    61	  rule <program> PGM </program>
    62	       <input> INPUT </input>
    63	       <entry> ENTRY </entry>
    64	       <result> pending => invoke(ENTRY, pList(INPUT), PGM) </result>
    65	
    66	  // Function lookup and big-step statement execution.
    67	  syntax PVal ::= "invoke" "(" String "," PVal "," Module ")" [function]
    68	  rule invoke(F, V, Module(DEFS)) => invokeFind(F, V, DEFS, Module(DEFS))
    69	
    70	  syntax PVal ::= "invokeFind" "(" String "," PVal "," Stmts "," Module ")" [function]
    71	  rule invokeFind(F, V,
    72	      FuncDef(F, Params(P), BODY) _REST, ALL)
    73	    => returnedValue(exec(BODY, P |-> V, ALL))
    74	  rule invokeFind(F, V,
    75	      FuncDef(G, Params(_P), _BODY) REST, ALL)
    76	    => invokeFind(F, V, REST, ALL)
    77	    requires F =/=String G
    78	
    79	  syntax PVal ::= "returnedValue" "(" Outcome ")" [function]
    80	  rule returnedValue(returned(V)) => V
    81	
    82	  syntax Outcome ::= "exec" "(" Stmts "," Map "," Module ")" [function]
    83	  rule exec(.Stmts, ENV, _DEFS) => normal(ENV)
    84	  rule exec(S REST, ENV, DEFS) => continue(execStmt(S, ENV, DEFS), REST, DEFS)
    85	
    86	  syntax Outcome ::= "continue" "(" Outcome "," Stmts "," Module ")" [function]
    87	  rule continue(returned(V), _REST, _DEFS) => returned(V)
    88	  rule continue(normal(ENV), REST, DEFS) => exec(REST, ENV, DEFS)
    89	
    90	  syntax Outcome ::= "execStmt" "(" Stmt "," Map "," Module ")" [function]
    91	  rule execStmt(Assign(Name(X), E), ENV, DEFS)
    92	    => normal(ENV [ X <- eval(E, ENV, DEFS) ])
    93	  rule execStmt(Return(E), ENV, DEFS) => returned(eval(E, ENV, DEFS))
    94	  rule execStmt(If(COND, THEN, ELSE), ENV, DEFS)
    95	    => branch(eval(COND, ENV, DEFS), THEN, ELSE, ENV, DEFS)
    96	
    97	  syntax Outcome ::= "branch" "(" PVal "," Stmts "," Stmts "," Map "," Module ")" [function]
    98	  rule branch(pBool(true),  THEN, _ELSE, ENV, DEFS) => exec(THEN, ENV, DEFS)
    99	  rule branch(pBool(false), _THEN, ELSE, ENV, DEFS) => exec(ELSE, ENV, DEFS)
   100	
   101	  // Pure expression evaluation for the AST forms emitted by solution.py.
   102	  syntax PVal ::= "eval" "(" Expr "," Map "," Module ")" [function]
   103	  rule eval(Name(X), ENV, _DEFS) => {ENV[X]}:>PVal
   104	  rule eval(Int(I), _ENV, _DEFS) => pInt(I)
   105	  rule eval(ListExpr(), _ENV, _DEFS) => pList(nil)
   106	  rule eval(ListExpr(E1, E2), ENV, DEFS)
   107	    => makePair(eval(E1, ENV, DEFS), eval(E2, ENV, DEFS))
   108	  rule eval(Call(Name(F), ARG), ENV, DEFS)
   109	    => apply(F, eval(ARG, ENV, DEFS), DEFS)
   110	  rule eval(Compare(LEFT, CmpOp("==", RIGHT)), ENV, DEFS)
   111	    => equal(eval(LEFT, ENV, DEFS), eval(RIGHT, ENV, DEFS))
   112	  rule eval(BinOp("+", LEFT, RIGHT), ENV, DEFS)
   113	    => plus(eval(LEFT, ENV, DEFS), eval(RIGHT, ENV, DEFS))
   114	  rule eval(UnaryOp("-", E), ENV, DEFS) => negate(eval(E, ENV, DEFS))
   115	  rule eval(Subscript(BASE, IDX), ENV, DEFS)
   116	    => index(eval(BASE, ENV, DEFS), IDX, ENV, DEFS)
   117	
   118	  syntax PVal ::= "makePair" "(" PVal "," PVal ")" [function]
   119	  rule makePair(pInt(I), pInt(J)) => pList(cons(I, cons(J, nil)))
   120	
   121	  syntax PVal ::= "apply" "(" String "," PVal "," Module ")" [function]
   122	  rule apply("len", pList(L), _DEFS) => pInt(length(L))
   123	  rule apply("sorted", pList(L), _DEFS) => pList(sortInts(L))
   124	  rule apply(F, V, DEFS) => invoke(F, V, DEFS)
   125	    requires F =/=String "len" andBool F =/=String "sorted"
   126	
   127	  syntax PVal ::= "equal" "(" PVal "," PVal ")" [function]
   128	  rule equal(pInt(I), pInt(J)) => pBool(I ==Int J)
   129	
   130	  syntax PVal ::= "plus" "(" PVal "," PVal ")" [function]
   131	  rule plus(pList(L1), pList(L2)) => pList(append(L1, L2))
   132	
   133	  syntax PVal ::= "negate" "(" PVal ")" [function]
   134	  rule negate(pInt(I)) => pInt(0 -Int I)
   135	
   136	  syntax PVal ::= "index" "(" PVal "," Index "," Map "," Module ")" [function]
   137	  rule index(pList(L), Int(I), _ENV, _DEFS) => pInt(nth(L, I))
   138	  rule index(pList(L), UnaryOp("-", Int(I)), _ENV, _DEFS)
   139	    => pInt(nth(L, length(L) -Int I))
   140	  rule index(pList(L), Slice(Int(1), UnaryOp("-", Int(1)), NoBound), _ENV, _DEFS)
   141	    => pList(interior(L))
   142	
   143	  // Mathematical operations needed by the source-language builtins.
   144	  syntax Int ::= "length" "(" PList ")" [function]
   145	  rule length(nil) => 0
   146	  rule length(cons(_I, L)) => 1 +Int length(L)
   147	
   148	  syntax Int ::= "nth" "(" PList "," Int ")" [function]
   149	  rule nth(cons(I, _L), 0) => I
   150	  rule nth(cons(_I, L), N) => nth(L, N -Int 1) requires N >Int 0
   151	
   152	  syntax PList ::= "append" "(" PList "," PList ")" [function]
   153	  rule append(nil, L2) => L2
   154	  rule append(cons(I, L1), L2) => cons(I, append(L1, L2))
   155	
   156	  syntax PList ::= "dropLast" "(" PList ")" [function]
   157	  rule dropLast(nil) => nil
   158	  rule dropLast(cons(_I, nil)) => nil
   159	  rule dropLast(cons(I, cons(J, L))) => cons(I, dropLast(cons(J, L)))
   160	
   161	  syntax PList ::= "interior" "(" PList ")" [function]
   162	  rule interior(nil) => nil
   163	  rule interior(cons(_I, L)) => dropLast(L)
   164	
   165	  syntax PList ::= "sortInts" "(" PList ")" [function]
   166	  rule sortInts(nil) => nil
   167	  rule sortInts(cons(I, L)) => insertInt(I, sortInts(L))
   168	
   169	  syntax PList ::= "insertInt" "(" Int "," PList ")" [function]
   170	  rule insertInt(I, nil) => cons(I, nil)
   171	  rule insertInt(I, cons(J, L)) => cons(I, cons(J, L)) requires I <=Int J
   172	  rule insertInt(I, cons(J, L)) => cons(J, insertInt(I, L)) requires I >Int J
   173	endmodule
===== /candidate/verification.k
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  // This is the parsed constructor tree in solution.mpy, named here so every
     7	  // proof claim refers to the exact program rather than to a hand-written
     8	  // summary of its behavior.
     9	  syntax Module ::= "solutionProgram" [function]
    10	  rule solutionProgram =>
    11	    Module(
    12	      FuncDef("strange_sorted", Params("ordered"),
    13	        If(Compare(Call(Name("len"), Name("ordered")), CmpOp("==", Int(0))),
    14	          Return(ListExpr()),
    15	          .Stmts)
    16	        If(Compare(Call(Name("len"), Name("ordered")), CmpOp("==", Int(1))),
    17	          Return(Name("ordered")),
    18	          .Stmts)
    19	        Return(
    20	          BinOp("+",
    21	            ListExpr(
    22	              Subscript(Name("ordered"), Int(0)),
    23	              Subscript(Name("ordered"), UnaryOp("-", Int(1)))),
    24	            Call(Name("strange_sorted"),
    25	              Subscript(Name("ordered"),
    26	                Slice(Int(1), UnaryOp("-", Int(1)), NoBound))))))
    27	      FuncDef("strange_sort_list", Params("lst"),
    28	        Return(Call(Name("strange_sorted"),
    29	          Call(Name("sorted"), Name("lst"))))))
    30	
    31	  // Independent contract function: alternately select the least and greatest
    32	  // remaining elements after sorting the input.
    33	  syntax PList ::= "weaveEnds" "(" PList ")" [function]
    34	  rule weaveEnds(nil) => nil
    35	  rule weaveEnds(cons(I, nil)) => cons(I, nil)
    36	  rule weaveEnds(cons(I, cons(J, L)))
    37	    => cons(I, cons(nth(cons(J, L), length(cons(J, L)) -Int 1),
    38	         weaveEnds(interior(cons(I, cons(J, L))))))
    39	
    40	  syntax PList ::= "strangeSpec" "(" PList ")" [function]
    41	  rule strangeSpec(L) => weaveEnds(sortInts(L))
    42	endmodule
