     6	def strange_sort_list(lst):
     7	    '''
     8	    Given list of integers, return list in strange order.
     9	    Strange sorting, is when you start with the minimum value,
    10	    then maximum of the remaining integers, then minimum and so on.
    11	
    12	    Examples:
    13	    strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]
    14	    strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]
    15	    strange_sort_list([]) == []
    16	    '''
    17	    res, switch = [], True
    18	    while lst:
    19	        res.append(min(lst) if switch else max(lst))
    20	        lst.remove(res[-1])
    21	        switch = not switch
    22	    return res
