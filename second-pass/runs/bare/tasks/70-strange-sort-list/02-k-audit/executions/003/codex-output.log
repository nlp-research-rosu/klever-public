cp -p /tmp/audit-work/candidate-src/semantic.k /tmp/audit-work/candidate-src/spec.k /tmp/audit-work/body-mutation/
cp -p /tmp/audit-work/candidate-src/verification.k /tmp/audit-work/body-mutation/verification.k
