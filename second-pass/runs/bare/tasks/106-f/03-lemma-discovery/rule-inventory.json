      "start_line": 33,
      "text": "  rule expectedCompletion(I, N, F, T, L)\n    => expectedCompletion(\n         I +Int 1, N, F *Int I, T +Int I,\n         L ListItem(F *Int I))\n    requires I <=Int N andBool I %Int 2 ==Int 0"
    },
    {
      "attributes": [],
      "end_line": 42,
      "module": "VERIFICATION",
      "normalized_sha256": "51d5ac90598636dfe1b73b72ccb56d69c3a0829028e66cc398ded33dc29eacf8",
      "source_rule_id": "rule-51d5ac90598636dfe1b73b72ccb56d69c3a0829028e66cc398ded33dc29eacf8",
      "start_line": 38,
      "text": "  rule expectedCompletion(I, N, F, T, L)\n    => expectedCompletion(\n         I +Int 1, N, F *Int I, T +Int I,\n         L ListItem(T +Int I))\n    requires I <=Int N andBool I %Int 2 =/=Int 0"
    },
    {
      "attributes": [],
      "end_line": 60,
      "module": "VERIFICATION",
      "normalized_sha256": "3881924a92eb8019a4666e9158673a5639a0de87a4efb5709666701e7c192dff",
      "source_rule_id": "rule-3881924a92eb8019a4666e9158673a5639a0de87a4efb5709666701e7c192dff",
      "start_line": 47,
      "text": "  rule solutionLoop =>\n    While(Compare(Name(\"i\"), CmpOp(\"<=\", Name(\"n\"))),\n      Assign(\n        Name(\"factorial\"),\n        BinOp(\"*\", Name(\"factorial\"), Name(\"i\")))\n      Assign(Name(\"total\"), BinOp(\"+\", Name(\"total\"), Name(\"i\")))\n      If(Compare(BinOp(\"%\", Name(\"i\"), Int(2)), CmpOp(\"==\", Int(0))),\n        Assign(\n          Name(\"result\"),\n          BinOp(\"+\", Name(\"result\"), ListExpr(Name(\"factorial\")))),\n        Assign(\n          Name(\"result\"),\n          BinOp(\"+\", Name(\"result\"), ListExpr(Name(\"total\")))))\n      Assign(Name(\"i\"), BinOp(\"+\", Name(\"i\"), Int(1))))"
    },
    {
      "attributes": [],
      "end_line": 70,
      "module": "VERIFICATION",
      "normalized_sha256": "76b2f4322bb9dc303ee170b2c2dab5e8672c46e60d2456d89969331e5f2d5b68",
      "source_rule_id": "rule-76b2f4322bb9dc303ee170b2c2dab5e8672c46e60d2456d89969331e5f2d5b68",
      "start_line": 62,
      "text": "  rule solution =>\n    Module(\n      FuncDef(\"f\", Params(\"n\"),\n        Assign(Name(\"result\"), ListExpr(.Exprs))\n        Assign(Name(\"factorial\"), Int(1))\n        Assign(Name(\"total\"), Int(0))\n        Assign(Name(\"i\"), Int(1))\n        solutionLoop\n        Return(Name(\"result\"))))"
    }
  ],
