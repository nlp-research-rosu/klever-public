/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter

inventory_path = '/reference/rule-inventory.json'
output_path = '/workspace/trust-boundary.json'
with open(inventory_path, encoding='utf-8') as f:
    inventory = json.load(f)
with open(output_path, encoding='utf-8') as f:
    output = json.load(f)

assert list(output) == ['schema_version', 'inventory_sha256', 'rules']
assert output['schema_version'] == 2
assert output['inventory_sha256'] == inventory['inventory_sha256']
expected_ids = [r['source_rule_id'] for r in inventory['rules']]
actual_ids = [r['source_rule_id'] for r in output['rules']]
assert actual_ids == expected_ids
assert len(actual_ids) == len(set(actual_ids)) == len(expected_ids)
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
for source, result in zip(inventory['rules'], output['rules']):
    assert list(result) == ['source_rule_id', 'classification', 'rationale']
    assert result['classification'] in allowed
    assert isinstance(result['rationale'], str) and result['rationale'].strip()
    if 'simplification' in source['attributes']:
        assert result['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
counts = Counter(r['classification'] for r in output['rules'])
print(f\"validated_rules={len(actual_ids)}\")
print(f\"inventory_sha256={output['inventory_sha256']}\")
for name in sorted(allowed):
    print(f\"{name}={counts[name]}\")
PY
