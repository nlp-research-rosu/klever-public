module MPY-SYNTAX
  imports INT-SYNTAX
  imports BOOL-SYNTAX
  imports STRING-SYNTAX

  syntax Program ::= "Module" "(" Stmts ")"

  syntax Stmts ::= List{Stmt, ""}
  syntax Strings ::= List{String, ","}
  syntax Exprs ::= List{Expr, ","}

  syntax Params ::= "Params" "(" Strings ")"

  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
                | "Assign" "(" Expr "," Expr ")"
                | "While" "(" Expr "," Stmts ")"
                | "If" "(" Expr "," Stmts "," Stmts ")"
                | "Return" "(" Expr ")"

  syntax Expr ::= "Int" "(" Int ")"
                | "Name" "(" String ")"
                | "ListExpr" "(" Exprs ")"
                | "BinOp" "(" String "," Expr "," Expr ")"
                | "Compare" "(" Expr "," CmpOp ")"

  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
endmodule

module SEMANTIC
  imports MPY-SYNTAX
  imports INT
  imports BOOL
  imports STRING
  imports MAP
  imports LIST

  syntax Value ::= "intVal" "(" Int ")"
                 | "boolVal" "(" Bool ")"
                 | "listVal" "(" List ")"

  syntax Result ::= "noResult" | "done" "(" Value ")"

  configuration
    <py>
      <k> $PGM:Program </k>
      <input> $INPUT:Int </input>
      <env> .Map </env>
      <result> noResult </result>
    </py>

  syntax KItem ::= "exec" "(" Stmts ")"
                 | "eval" "(" Expr ")"
                 | "store" "(" String ")"
                 | "singleton"
                 | "binLeft" "(" String "," Expr ")"
                 | "binRight" "(" String "," Value ")"
                 | "cmpLeft" "(" String "," Expr ")"
                 | "cmpRight" "(" String "," Value ")"
                 | "ifBranch" "(" Stmts "," Stmts ")"
                 | "whileBranch" "(" Expr "," Stmts ")"
                 | "doReturn"

  rule <k> Module(FuncDef(_F, Params(P:String), BODY)) => exec(BODY) </k>
       <input> N </input>
       <env> .Map => P |-> intVal(N) </env>

  rule exec(.Stmts) => .K
  rule exec(S:Stmt REST:Stmts) => S ~> exec(REST)

  rule Assign(Name(X), E) => eval(E) ~> store(X)
  rule <k> V:Value ~> store(X) => .K ...</k>
       <env> ENV => ENV [ X <- V ] </env>

  rule If(COND, THEN, ELSE) => eval(COND) ~> ifBranch(THEN, ELSE)
  rule boolVal(true) ~> ifBranch(THEN, _ELSE) => exec(THEN)
  rule boolVal(false) ~> ifBranch(_THEN, ELSE) => exec(ELSE)

  rule While(COND, BODY) => eval(COND) ~> whileBranch(COND, BODY)
  rule boolVal(true) ~> whileBranch(COND, BODY)
    => exec(BODY) ~> While(COND, BODY)
  rule boolVal(false) ~> whileBranch(_COND, _BODY) => .K

  rule Return(E) => eval(E) ~> doReturn
  rule <k> V:Value ~> doReturn ~> _REST:K => .K </k>
       <result> noResult => done(V) </result>

  rule <k> eval(Int(I)) => intVal(I) ...</k>
  rule <k> eval(Name(X)) => V ...</k>
       <env>... X |-> V:Value ...</env>

  rule eval(ListExpr(.Exprs)) => listVal(.List)
  rule eval(ListExpr(E)) => eval(E) ~> singleton
  rule intVal(I) ~> singleton => listVal(ListItem(I))

  rule eval(BinOp(OP, LEFT, RIGHT)) => eval(LEFT) ~> binLeft(OP, RIGHT)
  rule V:Value ~> binLeft(OP, RIGHT) => eval(RIGHT) ~> binRight(OP, V)
  rule intVal(J) ~> binRight("+", intVal(I)) => intVal(I +Int J)
  rule intVal(J) ~> binRight("*", intVal(I)) => intVal(I *Int J)
  rule intVal(J) ~> binRight("%", intVal(I)) => intVal(I %Int J)
  rule listVal(L2) ~> binRight("+", listVal(L1)) => listVal(L1 L2)

  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)))
    => eval(LEFT) ~> cmpLeft(OP, RIGHT)
  rule V:Value ~> cmpLeft(OP, RIGHT) => eval(RIGHT) ~> cmpRight(OP, V)
  rule intVal(J) ~> cmpRight("<=", intVal(I)) => boolVal(I <=Int J)
  rule intVal(J) ~> cmpRight("==", intVal(I)) => boolVal(I ==Int J)
endmodule
requires "semantic.k"

module VERIFICATION
  imports SEMANTIC

  syntax Int ::= "mathFactorial" "(" Int ")" [function]
               | "mathTriangle" "(" Int ")" [function]
               | "expectedAt" "(" Int ")" [function]
  syntax List ::= "expected" "(" Int ")" [function]
                | "expectedCompletion" "(" Int "," Int "," Int "," Int "," List ")" [function]

  rule mathFactorial(0) => 1
  rule mathFactorial(N) => mathFactorial(N -Int 1) *Int N
    requires N >Int 0

  rule mathTriangle(0) => 0
  rule mathTriangle(N) => mathTriangle(N -Int 1) +Int N
    requires N >Int 0

  rule expectedAt(N) => mathFactorial(N)
    requires N >Int 0 andBool N %Int 2 ==Int 0
  rule expectedAt(N) => mathTriangle(N)
    requires N >Int 0 andBool N %Int 2 =/=Int 0

  // The next four equations are the contract.  F is the product of the
  // indices already visited and T is their sum.  Thus the value appended at
  // an even I is I!, while the value appended at an odd I is 1 + ... + I.
  rule expected(N) => expectedCompletion(1, N, 1, 0, .List)
    requires N >=Int 0

  rule expectedCompletion(I, N, _F, _T, L) => L
    requires I >Int N
  rule expectedCompletion(I, N, F, T, L)
    => expectedCompletion(
         I +Int 1, N, F *Int I, T +Int I,
         L ListItem(F *Int I))
    requires I <=Int N andBool I %Int 2 ==Int 0
  rule expectedCompletion(I, N, F, T, L)
    => expectedCompletion(
         I +Int 1, N, F *Int I, T +Int I,
         L ListItem(T +Int I))
    requires I <=Int N andBool I %Int 2 =/=Int 0

  syntax Program ::= "solution" [macro]
  syntax Stmt ::= "solutionLoop" [macro]

  rule solutionLoop =>
    While(Compare(Name("i"), CmpOp("<=", Name("n"))),
      Assign(
        Name("factorial"),
        BinOp("*", Name("factorial"), Name("i")))
      Assign(Name("total"), BinOp("+", Name("total"), Name("i")))
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
        Assign(
          Name("result"),
          BinOp("+", Name("result"), ListExpr(Name("factorial")))),
        Assign(
          Name("result"),
          BinOp("+", Name("result"), ListExpr(Name("total")))))
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))

  rule solution =>
    Module(
      FuncDef("f", Params("n"),
        Assign(Name("result"), ListExpr(.Exprs))
        Assign(Name("factorial"), Int(1))
        Assign(Name("total"), Int(0))
        Assign(Name("i"), Int(1))
        solutionLoop
        Return(Name("result"))))
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  claim [loop-invariant]:
    <k>
      solutionLoop ~> exec(Return(Name("result")) .Stmts)
      => .K
    </k>
    <input> N </input>
    <env>
      "factorial" |-> intVal(F:Int)
      "i"         |-> intVal(I)
      "n"         |-> intVal(N)
      "result"    |-> listVal(L:List)
      "total"     |-> intVal(T:Int)
      =>
      "factorial" |-> intVal(?_FOUT:Int)
      "i"         |-> intVal(?_IOUT:Int)
      "n"         |-> intVal(N)
      "result"    |-> listVal(expectedCompletion(I, N, F, T, L))
      "total"     |-> intVal(?_TOUT:Int)
    </env>
    <result> noResult => done(listVal(expectedCompletion(I, N, F, T, L))) </result>
    requires N >=Int 0 andBool I >=Int 1

  claim [main-correct]:
    <k> solution => .K </k>
    <input> N </input>
    <env>
      .Map
      =>
      "factorial" |-> intVal(?_FOUT:Int)
      "i"         |-> intVal(?_IOUT:Int)
      "n"         |-> intVal(N)
      "result"    |-> listVal(expected(N))
      "total"     |-> intVal(?_TOUT:Int)
    </env>
    <result> noResult => done(listVal(expected(N))) </result>
    requires N >=Int 0
endmodule
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy

kompile semantic.k \
  --main-module SEMANTIC \
  --syntax-module MPY-SYNTAX \
  --backend llvm

krun solution.mpy -cINPUT=0 --definition semantic-kompiled
krun solution.mpy -cINPUT=5 --definition semantic-kompiled
krun solution.mpy -cINPUT=8 --definition semantic-kompiled

kompile verification.k \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --backend haskell

# The proof shorthand expands to exactly the AST translated from solution.py.
diff \
  <(kast solution.mpy --definition verification-kompiled \
      --module VERIFICATION --sort Program --expand-macros --output kore) \
  <(kast --expression solution --definition verification-kompiled \
      --module VERIFICATION --sort Program --expand-macros --output kore)

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --output pretty

