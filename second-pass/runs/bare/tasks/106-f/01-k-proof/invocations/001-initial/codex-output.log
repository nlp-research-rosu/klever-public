diff \
  <(kast solution.mpy --definition verification-kompiled \
      --module VERIFICATION --sort Program --expand-macros --output kore) \
  <(kast --expression solution --definition verification-kompiled \
      --module VERIFICATION --sort Program --expand-macros --output kore)

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --output pretty

