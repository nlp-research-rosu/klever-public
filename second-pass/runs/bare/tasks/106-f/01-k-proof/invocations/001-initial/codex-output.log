+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "While" "(" Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Int" "(" Int ")"
+                | "Name" "(" String ")"
+                | "ListExpr" "(" Exprs ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
