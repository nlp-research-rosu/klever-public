diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..00fe04039edd8ff8f0a219939e9e303fbcd729a1
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def f(n):
+    result = []
+    factorial = 1
+    total = 0
+    i = 1
+    while i <= n:
+        factorial = factorial * i
+        total = total + i
+        if i % 2 == 0:
+            result = result + [factorial]
+        else:
+            result = result + [total]
+        i = i + 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1991af07be052454a627875b2309d418d38205f6
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,42 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      solutionLoop ~> exec(Return(Name("result")) .Stmts)
+      => .K
+    </k>
+    <input> N </input>
+    <env>
+      "factorial" |-> intVal(F:Int)
+      "i"         |-> intVal(I)
+      "n"         |-> intVal(N)
+      "result"    |-> listVal(L:List)
+      "total"     |-> intVal(T:Int)
+      =>
+      "factorial" |-> intVal(?_FOUT:Int)
+      "i"         |-> intVal(?_IOUT:Int)
+      "n"         |-> intVal(N)
+      "result"    |-> listVal(expectedCompletion(I, N, F, T, L))
+      "total"     |-> intVal(?_TOUT:Int)
+    </env>
+    <result> noResult => done(listVal(expectedCompletion(I, N, F, T, L))) </result>
+    requires N >=Int 0 andBool I >=Int 1
+
+  claim [main-correct]:
+    <k> solution => .K </k>
+    <input> N </input>
+    <env>
+      .Map
+      =>
+      "factorial" |-> intVal(?_FOUT:Int)
+      "i"         |-> intVal(?_IOUT:Int)
+      "n"         |-> intVal(N)
+      "result"    |-> listVal(expected(N))
+      "total"     |-> intVal(?_TOUT:Int)
+    </env>
+    <result> noResult => done(listVal(expected(N))) </result>
+    requires N >=Int 0
+endmodule
