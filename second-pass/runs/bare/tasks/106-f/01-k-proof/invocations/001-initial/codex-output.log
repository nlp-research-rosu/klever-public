+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      solutionLoop ~> exec(Return(Name("result")) .Stmts)
+      => .K
+    </k>
+    <input> N </input>
+    <env>
+      "factorial" |-> intVal(mathFactorial(I -Int 1))
+      "i"         |-> intVal(I)
+      "n"         |-> intVal(N)
+      "result"    |-> listVal(expectedPrefix(N, I -Int 1))
+      "total"     |-> intVal(mathTriangle(I -Int 1))
+      =>
+      "factorial" |-> intVal(FOUT:Int)
+      "i"         |-> intVal(IOUT:Int)
+      "n"         |-> intVal(N)
+      "result"    |-> listVal(expected(N))
+      "total"     |-> intVal(TOUT:Int)
+    </env>
+    <result> noResult => done(listVal(expected(N))) </result>
+    requires N >=Int 0 andBool I >=Int 1 andBool I <=Int N +Int 1
+
+  claim [main-correct]:
+    <k> solution => .K </k>
+    <input> N </input>
+    <env>
+      .Map
+      =>
+      "factorial" |-> intVal(FOUT:Int)
+      "i"         |-> intVal(IOUT:Int)
+      "n"         |-> intVal(N)
+      "result"    |-> listVal(expected(N))
+      "total"     |-> intVal(TOUT:Int)
+    </env>
+    <result> noResult => done(listVal(expected(N))) </result>
+    requires N >=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..733c433d07ad2734f54b097f47a29e410523287f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,64 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  syntax Int ::= "mathFactorial" "(" Int ")" [function]
+               | "mathTriangle" "(" Int ")" [function]
+               | "expectedAt" "(" Int ")" [function]
+  syntax List ::= "expected" "(" Int ")" [function]
+                | "expectedPrefix" "(" Int "," Int ")" [function]
+
+  rule mathFactorial(0) => 1
+  rule mathFactorial(N) => mathFactorial(N -Int 1) *Int N
+    requires N >Int 0
+
+  rule mathTriangle(0) => 0
+  rule mathTriangle(N) => mathTriangle(N -Int 1) +Int N
+    requires N >Int 0
+
+  rule expectedAt(N) => mathFactorial(N)
+    requires N >Int 0 andBool N %Int 2 ==Int 0
+  rule expectedAt(N) => mathTriangle(N)
+    requires N >Int 0 andBool N %Int 2 =/=Int 0
+
+  rule expected(0) => .List
+  rule expected(N) => expected(N -Int 1) ListItem(expectedAt(N))
+    requires N >Int 0
+
+  rule expectedPrefix(N, 0) => .List
+    requires N >=Int 0
+  rule expectedPrefix(N, K)
+    => expectedPrefix(N, K -Int 1) ListItem(expectedAt(K))
+    requires K >Int 0 andBool K <=Int N
+  rule expectedPrefix(N, K) => expected(N)
+    requires N >=Int 0 andBool K ==Int N
+
+  syntax Program ::= "solution" [macro]
+  syntax Stmt ::= "solutionLoop" [macro]
+
+  rule solutionLoop =>
+    While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+      Assign(
+        Name("factorial"),
+        BinOp("*", Name("factorial"), Name("i")))
+      Assign(Name("total"), BinOp("+", Name("total"), Name("i")))
+      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+        Assign(
+          Name("result"),
+          BinOp("+", Name("result"), ListExpr(Name("factorial")))),
+        Assign(
+          Name("result"),
+          BinOp("+", Name("result"), ListExpr(Name("total")))))
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  rule solution =>
+    Module(
+      FuncDef("f", Params("n"),
+        Assign(Name("result"), ListExpr(.Exprs))
+        Assign(Name("factorial"), Int(1))
+        Assign(Name("total"), Int(0))
+        Assign(Name("i"), Int(1))
+        solutionLoop
+        Return(Name("result"))))
+endmodule

exec
/bin/bash -lc 'kompile verification.k --main-module VERIFICATION --syntax-module MPY-SYNTAX --backend haskell && kprove spec.k --definition verification-kompiled --spec-module SPEC --output pretty' in /work
