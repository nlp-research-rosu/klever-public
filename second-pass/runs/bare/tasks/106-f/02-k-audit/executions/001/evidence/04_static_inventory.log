   101	
   102	  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)))
   103	    => eval(LEFT) ~> cmpLeft(OP, RIGHT)
   104	  rule V:Value ~> cmpLeft(OP, RIGHT) => eval(RIGHT) ~> cmpRight(OP, V)
