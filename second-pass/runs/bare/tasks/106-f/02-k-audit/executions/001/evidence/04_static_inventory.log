     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports SEMANTIC
     5	
     6	  syntax Int ::= "mathFactorial" "(" Int ")" [function]
     7	               | "mathTriangle" "(" Int ")" [function]
     8	               | "expectedAt" "(" Int ")" [function]
     9	  syntax List ::= "expected" "(" Int ")" [function]
    10	                | "expectedCompletion" "(" Int "," Int "," Int "," Int "," List ")" [function]
    11	
    12	  rule mathFactorial(0) => 1
    13	  rule mathFactorial(N) => mathFactorial(N -Int 1) *Int N
    14	    requires N >Int 0
    15	
    16	  rule mathTriangle(0) => 0
    17	  rule mathTriangle(N) => mathTriangle(N -Int 1) +Int N
    18	    requires N >Int 0
    19	
    20	  rule expectedAt(N) => mathFactorial(N)
    21	    requires N >Int 0 andBool N %Int 2 ==Int 0
    22	  rule expectedAt(N) => mathTriangle(N)
    23	    requires N >Int 0 andBool N %Int 2 =/=Int 0
    24	
    25	  // The next four equations are the contract.  F is the product of the
    26	  // indices already visited and T is their sum.  Thus the value appended at
    27	  // an even I is I!, while the value appended at an odd I is 1 + ... + I.
    28	  rule expected(N) => expectedCompletion(1, N, 1, 0, .List)
    29	    requires N >=Int 0
    30	
    31	  rule expectedCompletion(I, N, _F, _T, L) => L
    32	    requires I >Int N
    33	  rule expectedCompletion(I, N, F, T, L)
    34	    => expectedCompletion(
    35	         I +Int 1, N, F *Int I, T +Int I,
    36	         L ListItem(F *Int I))
    37	    requires I <=Int N andBool I %Int 2 ==Int 0
    38	  rule expectedCompletion(I, N, F, T, L)
    39	    => expectedCompletion(
    40	         I +Int 1, N, F *Int I, T +Int I,
    41	         L ListItem(T +Int I))
    42	    requires I <=Int N andBool I %Int 2 =/=Int 0
    43	
    44	  syntax Program ::= "solution" [macro]
    45	  syntax Stmt ::= "solutionLoop" [macro]
    46	
    47	  rule solutionLoop =>
    48	    While(Compare(Name("i"), CmpOp("<=", Name("n"))),
    49	      Assign(
    50	        Name("factorial"),
    51	        BinOp("*", Name("factorial"), Name("i")))
    52	      Assign(Name("total"), BinOp("+", Name("total"), Name("i")))
    53	      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
    54	        Assign(
    55	          Name("result"),
    56	          BinOp("+", Name("result"), ListExpr(Name("factorial")))),
    57	        Assign(
    58	          Name("result"),
    59	          BinOp("+", Name("result"), ListExpr(Name("total")))))
    60	      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    61	
    62	  rule solution =>
    63	    Module(
    64	      FuncDef("f", Params("n"),
    65	        Assign(Name("result"), ListExpr(.Exprs))
    66	        Assign(Name("factorial"), Int(1))
    67	        Assign(Name("total"), Int(0))
    68	        Assign(Name("i"), Int(1))
    69	        solutionLoop
    70	        Return(Name("result"))))
    71	endmodule
