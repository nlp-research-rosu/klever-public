    39	                 | "listVal" "(" List ")"
    40	
    41	  syntax Result ::= "noResult" | "done" "(" Value ")"
    42	
    43	  configuration
    44	    <py>
    45	      <k> $PGM:Program </k>
    46	      <input> $INPUT:Int </input>
    47	      <env> .Map </env>
    48	      <result> noResult </result>
    49	    </py>
    50	
    51	  syntax KItem ::= "exec" "(" Stmts ")"
    52	                 | "eval" "(" Expr ")"
    53	                 | "store" "(" String ")"
    54	                 | "singleton"
    55	                 | "binLeft" "(" String "," Expr ")"
    56	                 | "binRight" "(" String "," Value ")"
    57	                 | "cmpLeft" "(" String "," Expr ")"
    58	                 | "cmpRight" "(" String "," Value ")"
    59	                 | "ifBranch" "(" Stmts "," Stmts ")"
    60	                 | "whileBranch" "(" Expr "," Stmts ")"
    61	                 | "doReturn"
    62	
    63	  rule <k> Module(FuncDef(_F, Params(P:String), BODY)) => exec(BODY) </k>
    64	       <input> N </input>
    65	       <env> .Map => P |-> intVal(N) </env>
    66	
    67	  rule exec(.Stmts) => .K
    68	  rule exec(S:Stmt REST:Stmts) => S ~> exec(REST)
    69	
    70	  rule Assign(Name(X), E) => eval(E) ~> store(X)
    71	  rule <k> V:Value ~> store(X) => .K ...</k>
    72	       <env> ENV => ENV [ X <- V ] </env>
    73	
    74	  rule If(COND, THEN, ELSE) => eval(COND) ~> ifBranch(THEN, ELSE)
    75	  rule boolVal(true) ~> ifBranch(THEN, _ELSE) => exec(THEN)
    76	  rule boolVal(false) ~> ifBranch(_THEN, ELSE) => exec(ELSE)
    77	
    78	  rule While(COND, BODY) => eval(COND) ~> whileBranch(COND, BODY)
    79	  rule boolVal(true) ~> whileBranch(COND, BODY)
    80	    => exec(BODY) ~> While(COND, BODY)
    81	  rule boolVal(false) ~> whileBranch(_COND, _BODY) => .K
    82	
    83	  rule Return(E) => eval(E) ~> doReturn
    84	  rule <k> V:Value ~> doReturn ~> _REST:K => .K </k>
    85	       <result> noResult => done(V) </result>
    86	
    87	  rule <k> eval(Int(I)) => intVal(I) ...</k>
    88	  rule <k> eval(Name(X)) => V ...</k>
    89	       <env>... X |-> V:Value ...</env>
    90	
    91	  rule eval(ListExpr(.Exprs)) => listVal(.List)
    92	  rule eval(ListExpr(E)) => eval(E) ~> singleton
    93	  rule intVal(I) ~> singleton => listVal(ListItem(I))
    94	
    95	  rule eval(BinOp(OP, LEFT, RIGHT)) => eval(LEFT) ~> binLeft(OP, RIGHT)
    96	  rule V:Value ~> binLeft(OP, RIGHT) => eval(RIGHT) ~> binRight(OP, V)
    97	  rule intVal(J) ~> binRight("+", intVal(I)) => intVal(I +Int J)
    98	  rule intVal(J) ~> binRight("*", intVal(I)) => intVal(I *Int J)
    99	  rule intVal(J) ~> binRight("%", intVal(I)) => intVal(I %Int J)
