/bin/bash -lc "printf 'AUDITOR_DIAGNOSTIC_SCRIPT_EXIT_STATUS: 130 (manual interrupt after main-only claim selection removed its required loop circularity)\\n' >> /audit-output/evidence/02_clean_rebuild.log
