+requires "verification.k"
+
+module AUDIT-LOOP-WITNESS
+  imports VERIFICATION
+
+  syntax Program ::= "LoopStateWitness"
+
+  // A reachable loop-head state after iterations i=1 and i=2 for input n=5.
+  rule <k>
+         LoopStateWitness
+         =>
+         solutionLoop ~> exec(Return(Name("result")) .Stmts)
+       </k>
+       <env>
+         .Map
+         =>
+         "factorial" |-> intVal(2)
+         "i"         |-> intVal(3)
+         "n"         |-> intVal(5)
+         "result"    |-> listVal(ListItem(1) ListItem(2))
+         "total"     |-> intVal(3)
+       </env>
+endmodule
