+def original(n):
+    result, factorial, total, i = [], 1, 0, 1
+    while i <= n:
+        factorial *= i
+        total += i
+        result += [factorial if i % 2 == 0 else total]
+        i += 1
+    return result
+
+def mutated(n):
+    result, factorial, total, i = [], 1, 1, 1
+    while i <= n:
+        factorial *= i
+        total += i
+        result += [factorial if i % 2 == 0 else total]
+        i += 1
+    return result
+
+print(f"original(1)={original(1)!r}")
+print(f"mutated(1)={mutated(1)!r}")
