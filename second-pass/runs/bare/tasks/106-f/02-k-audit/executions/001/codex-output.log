+
+  syntax Program ::= "ExpectedGround0"
+                   | "ExpectedGround5"
+                   | "LoopCompletionGround"
+
+  rule <k> ExpectedGround0 => .K </k>
+       <result> noResult => done(listVal(expected(0))) </result>
+
+  rule <k> ExpectedGround5 => .K </k>
+       <result> noResult => done(listVal(expected(5))) </result>
+
+  rule <k> LoopCompletionGround => .K </k>
+       <result>
+         noResult
+         =>
+         done(listVal(expectedCompletion(
+           3, 5, 2, 3, ListItem(1) ListItem(2))))
+       </result>
+endmodule
