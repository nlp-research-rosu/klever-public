diff --git a//tmp/audit-work/106-f/source/audit-loop-witness.k b//tmp/audit-work/106-f/source/audit-loop-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..c9ee88da6fc8874b86ee9b2aad371aee113bed90
--- /dev/null
+++ b//tmp/audit-work/106-f/source/audit-loop-witness.k
@@ -0,0 +1,23 @@
+requires "verification.k"
+
+module AUDIT-LOOP-WITNESS
+  imports VERIFICATION
+
+  syntax Program ::= "LoopStateWitness"
+
+  // A reachable loop-head state after iterations i=1 and i=2 for input n=5.
+  rule <k>
+         LoopStateWitness
+         =>
+         solutionLoop ~> exec(Return(Name("result")) .Stmts)
+       </k>
+       <env>
+         .Map
+         =>
+         "factorial" |-> intVal(2)
+         "i"         |-> intVal(3)
+         "n"         |-> intVal(5)
