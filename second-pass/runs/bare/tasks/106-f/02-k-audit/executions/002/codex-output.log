  input=const patch = "*** Begin Patch\n*** Update File: /work/verification.k\n@@\n-  rule expected(N) => expectedCompletion(1, N, 1, 0, .List)\n+  // The next four equations are the contract.  F is the product of the\n+  // indices already visited and T is their sum.  Thus the value appended at\n+  // an even I is I!, while the value appended at an odd I is 1 + ... + I.\n+  rule expected(N) => expectedCompletion(1, N, 1, 0, .List)\n*** Update File: /work/spec.k\n@@\n-      \"factorial\" |-> intVal(?FOUT:Int)\n-      \"i\"         |-> intVal(?IOUT:Int)\n+      \"factorial\" |-> intVal(?_FOUT:Int)\n+      \"i\"         |-> intVal(?_IOUT:Int)\n@@\n-      \"total\"     |-> intVal(?TOUT:Int)\n+      \"total\"     |-> intVal(?_TOUT:Int)\n@@\n-      \"factorial\" |-> intVal(?FOUT:Int)\n-      \"i\"         |-> intVal(?IOUT:Int)\n+      \"factorial\" |-> intVal(?_FOUT:Int)\n+      \"i\"         |-> intVal(?_IOUT:Int)\n@@\n-      \"total\"     |-> intVal(?TOUT:Int)\n+      \"total\"     |-> intVal(?_TOUT:Int)\n*** Add File: /work/prove.sh\n+#!/usr/bin/env bash\n+set -euo pipefail\n+\n+python3 py2mpy.py solution.py > solution.mpy\n+\n+kompile semantic.k \\\n+  --main-module SEMANTIC \\\n+  --syntax-module MPY-SYNTAX \\\n+  --backend llvm\n+\n+krun solution.mpy -cINPUT=0 --definition semantic-kompiled\n+krun solution.mpy -cINPUT=5 --definition semantic-kompiled\n+krun solution.mpy -cINPUT=8 --definition semantic-kompiled\n+\n+kompile verification.k \\\n+  --main-module VERIFICATION \\\n+  --syntax-module MPY-SYNTAX \\\n+  --backend haskell\n+\n+kprove spec.k \\\n+  --definition verification-kompiled \\\n+  --spec-module SPEC \\\n+  --output pretty\n*** End Patch";\ntext(await tools.apply_patch(patch));\nconst r = await tools.exec_command({cmd:"chmod +x prove.sh\n./prove.sh",workdir:"/work",yield_time_ms:30000,max_output_tokens:30000}); text(r.output);\nif (r.session_id) text(`SESSION_ID=${r.session_id}`);\n
