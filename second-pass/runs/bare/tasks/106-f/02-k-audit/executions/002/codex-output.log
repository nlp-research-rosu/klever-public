  input=const patch = "*** Begin Patch\n*** Add File: /work/solution.py\n+def f(n):\n+    result = []\n+    factorial = 1\n+    total = 0\n+    i = 1\n+    while i <= n:\n+        factorial = factorial * i\n+        total = total + i\n+        if i % 2 == 0:\n+            result = result + [factorial]\n+        else:\n+            result = result + [total]\n+        i = i + 1\n+    return result\n*** End Patch";\ntext(await tools.apply_patch(patch));\nconst r = await tools.exec_command({cmd:"python3 py2mpy.py solution.py > solution.mpy\npython3 py2mpy.py solution.py --ast\nsed -n '1,240p' solution.mpy\npython3 - <<'PY'\nfrom solution import f\nfor n in range(9):\n    print(n, f(n))\nPY",workdir:"/work",yield_time_ms:10000,max_output_tokens:20000}); text(r.output);
