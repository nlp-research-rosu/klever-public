diff --git a//tmp/audit-work/reconstruction/verification-body-mutation.k b//tmp/audit-work/reconstruction/verification-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..841f143bff1217f19e84c2540dd8f94c3c3fcde5
--- /dev/null
+++ b//tmp/audit-work/reconstruction/verification-body-mutation.k
@@ -0,0 +1,69 @@
+requires "semantic.k"
+
+module VERIFICATION-BODY-MUTATION
+  imports SEMANTIC
+
+  syntax Int ::= "mathFactorial" "(" Int ")" [function]
+               | "mathTriangle" "(" Int ")" [function]
+               | "expectedAt" "(" Int ")" [function]
+  syntax List ::= "expected" "(" Int ")" [function]
+                | "expectedCompletion" "(" Int "," Int "," Int "," Int "," List ")" [function]
+
+  rule mathFactorial(0) => 1
+  rule mathFactorial(N) => mathFactorial(N -Int 1) *Int N
+    requires N >Int 0
+
+  rule mathTriangle(0) => 0
+  rule mathTriangle(N) => mathTriangle(N -Int 1) +Int N
+    requires N >Int 0
+
+  rule expectedAt(N) => mathFactorial(N)
+    requires N >Int 0 andBool N %Int 2 ==Int 0
+  rule expectedAt(N) => mathTriangle(N)
+    requires N >Int 0 andBool N %Int 2 =/=Int 0
+
+  rule expected(N) => expectedCompletion(1, N, 1, 0, .List)
+    requires N >=Int 0
+
+  rule expectedCompletion(I, N, _F, _T, L) => L
+    requires I >Int N
+  rule expectedCompletion(I, N, F, T, L)
+    => expectedCompletion(
+         I +Int 1, N, F *Int I, T +Int I,
+         L ListItem(F *Int I))
+    requires I <=Int N andBool I %Int 2 ==Int 0
+  rule expectedCompletion(I, N, F, T, L)
+    => expectedCompletion(
+         I +Int 1, N, F *Int I, T +Int I,
+         L ListItem(T +Int I))
+    requires I <=Int N andBool I %Int 2 =/=Int 0
+
+  syntax Program ::= "solution" [macro]
+  syntax Stmt ::= "solutionLoop" [macro]
+
+  // Deliberately false body mutation: + replaces * in factorial update.
+  rule solutionLoop =>
+    While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+      Assign(
+        Name("factorial"),
+        BinOp("+", Name("factorial"), Name("i")))
+      Assign(Name("total"), BinOp("+", Name("total"), Name("i")))
+      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+        Assign(
+          Name("result"),
+          BinOp("+", Name("result"), ListExpr(Name("factorial")))),
+        Assign(
+          Name("result"),
+          BinOp("+", Name("result"), ListExpr(Name("total")))))
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  rule solution =>
+    Module(
+      FuncDef("f", Params("n"),
+        Assign(Name("result"), ListExpr(.Exprs))
+        Assign(Name("factorial"), Int(1))
+        Assign(Name("total"), Int(0))
+        Assign(Name("i"), Int(1))
+        solutionLoop
+        Return(Name("result"))))
+endmodule
diff --git a/evidence/body_mutation_witness.py b/evidence/body_mutation_witness.py
new file mode 100644
index 0000000000000000000000000000000000000000..552ffa150fdc18c34ce7f329599111e5c252bcfc
--- /dev/null
+++ b/evidence/body_mutation_witness.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+"""Ground witness for the factorial-update body mutation."""
+
+from math import factorial
+
+
+def mutated(n: int) -> list[int]:
+    result: list[int] = []
+    factorial_accumulator = 1
+    total = 0
+    i = 1
+    while i <= n:
+        factorial_accumulator = factorial_accumulator + i
+        total = total + i
+        result.append(factorial_accumulator if i % 2 == 0 else total)
+        i += 1
+    return result
+
+
+n = 2
+contract = [
+    factorial(i) if i % 2 == 0 else i * (i + 1) // 2
+    for i in range(1, n + 1)
+]
+actual = mutated(n)
+print(f"satisfying input n={n}")
+print(f"mutated_body_result={actual}")
+print(f"contract_result={contract}")
+print(f"false_conclusion_witness={actual != contract}")
diff --git a/evidence/claim_witnesses.py b/evidence/claim_witnesses.py
new file mode 100644
index 0000000000000000000000000000000000000000..3a592183f101bf73b0d5dc435c89a8ef6e925777
--- /dev/null
+++ b/evidence/claim_witnesses.py
@@ -0,0 +1,88 @@
+#!/usr/bin/env python3
+"""Concrete satisfying states for both reachability-claim preconditions."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+import sys
+
+
+def load_entry(path: Path, module_name: str):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.f
+
+
+def expected_completion(
+    i: int, n: int, factorial: int, total: int, prefix: list[int]
+) -> list[int]:
+    output = list(prefix)
+    while i <= n:
+        factorial *= i
+        total += i
+        output.append(factorial if i % 2 == 0 else total)
+        i += 1
+    return output
+
+
+def main() -> int:
+    canonical = load_entry(Path("/reference/canonical.py"), "witness_canonical")
+    candidate = load_entry(
+        Path("/tmp/audit-work/reconstruction/solution.py"),
+        "witness_candidate",
+    )
+
+    main_n = 5
+    main_precondition = main_n >= 0
+    main_expected = expected_completion(1, main_n, 1, 0, [])
+    print(
+        "main witness: <input> 5 </input>, <env> .Map </env>, "
+        "<result> noResult </result>"
+    )
+    print(f"main precondition N >= 0: {main_precondition}")
+    print(
+        f"main substituted expected(5)={main_expected} "
+        f"canonical={canonical(main_n)} candidate={candidate(main_n)}"
+    )
+
+    loop_n = 5
+    loop_i = 3
+    loop_factorial = 2
+    loop_total = 3
+    loop_prefix = [1, 2]
+    loop_precondition = loop_n >= 0 and loop_i >= 1
+    loop_expected = expected_completion(
+        loop_i,
+        loop_n,
+        loop_factorial,
+        loop_total,
+        loop_prefix,
+    )
+    print(
+        "loop witness: N=5, I=3, F=2, T=3, L=[1,2], "
+        "the reachable state after iterations 1 and 2"
+    )
+    print(f"loop precondition N >= 0 and I >= 1: {loop_precondition}")
+    print(
+        "loop substituted expectedCompletion(3,5,2,3,[1,2])="
+        f"{loop_expected} canonical={canonical(loop_n)} "
+        f"candidate={candidate(loop_n)}"
+    )
+
+    conditions = [
+        main_precondition,
+        loop_precondition,
+        main_expected == canonical(main_n) == candidate(main_n),
+        loop_expected == canonical(loop_n) == candidate(loop_n),
+    ]
+    status = 0 if all(conditions) else 1
+    print(f"CLAIM_WITNESS_STATUS={status}")
+    return status
+
+
+if __name__ == "__main__":
+    sys.exit(main())
