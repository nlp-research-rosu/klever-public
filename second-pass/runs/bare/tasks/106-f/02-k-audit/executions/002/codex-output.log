diff --git a//tmp/audit-work/reconstruction/verification-body-mutation.k b//tmp/audit-work/reconstruction/verification-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..841f143bff1217f19e84c2540dd8f94c3c3fcde5
--- /dev/null
+++ b//tmp/audit-work/reconstruction/verification-body-mutation.k
@@ -0,0 +1,69 @@
+requires "semantic.k"
+
+module VERIFICATION-BODY-MUTATION
+  imports SEMANTIC
+
+  syntax Int ::= "mathFactorial" "(" Int ")" [function]
+               | "mathTriangle" "(" Int ")" [function]
+               | "expectedAt" "(" Int ")" [function]
+  syntax List ::= "expected" "(" Int ")" [function]
+                | "expectedCompletion" "(" Int "," Int "," Int "," Int "," List ")" [function]
+
+  rule mathFactorial(0) => 1
+  rule mathFactorial(N) => mathFactorial(N -Int 1) *Int N
+    requires N >Int 0
+
+  rule mathTriangle(0) => 0
+  rule mathTriangle(N) => mathTriangle(N -Int 1) +Int N
+    requires N >Int 0
+
+  rule expectedAt(N) => mathFactorial(N)
+    requires N >Int 0 andBool N %Int 2 ==Int 0
+  rule expectedAt(N) => mathTriangle(N)
+    requires N >Int 0 andBool N %Int 2 =/=Int 0
+
+  rule expected(N) => expectedCompletion(1, N, 1, 0, .List)
+    requires N >=Int 0
+
+  rule expectedCompletion(I, N, _F, _T, L) => L
+    requires I >Int N
+  rule expectedCompletion(I, N, F, T, L)
+    => expectedCompletion(
+         I +Int 1, N, F *Int I, T +Int I,
+         L ListItem(F *Int I))
+    requires I <=Int N andBool I %Int 2 ==Int 0
+  rule expectedCompletion(I, N, F, T, L)
+    => expectedCompletion(
+         I +Int 1, N, F *Int I, T +Int I,
+         L ListItem(T +Int I))
+    requires I <=Int N andBool I %Int 2 =/=Int 0
+
+  syntax Program ::= "solution" [macro]
+  syntax Stmt ::= "solutionLoop" [macro]
+
+  // Deliberately false body mutation: + replaces * in factorial update.
+  rule solutionLoop =>
+    While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+      Assign(
+        Name("factorial"),
+        BinOp("+", Name("factorial"), Name("i")))
+      Assign(Name("total"), BinOp("+", Name("total"), Name("i")))
+      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+        Assign(
+          Name("result"),
+          BinOp("+", Name("result"), ListExpr(Name("factorial")))),
+        Assign(
+          Name("result"),
+          BinOp("+", Name("result"), ListExpr(Name("total")))))
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+
+  rule solution =>
+    Module(
+      FuncDef("f", Params("n"),
+        Assign(Name("result"), ListExpr(.Exprs))
+        Assign(Name("factorial"), Int(1))
+        Assign(Name("total"), Int(0))
+        Assign(Name("i"), Int(1))
+        solutionLoop
+        Return(Name("result"))))
+endmodule
diff --git a/evidence/body_mutation_witness.py b/evidence/body_mutation_witness.py
new file mode 100644
index 0000000000000000000000000000000000000000..552ffa150fdc18c34ce7f329599111e5c252bcfc
--- /dev/null
+++ b/evidence/body_mutation_witness.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+"""Ground witness for the factorial-update body mutation."""
+
+from math import factorial
+
+
+def mutated(n: int) -> list[int]:
+    result: list[int] = []
+    factorial_accumulator = 1
+    total = 0
+    i = 1
+    while i <= n:
+        factorial_accumulator = factorial_accumulator + i
+        total = total + i
+        result.append(factorial_accumulator if i % 2 == 0 else total)
+        i += 1
+    return result
+
+
+n = 2
+contract = [
+    factorial(i) if i % 2 == 0 else i * (i + 1) // 2
+    for i in range(1, n + 1)
+]
+actual = mutated(n)
+print(f"satisfying input n={n}")
+print(f"mutated_body_result={actual}")
+print(f"contract_result={contract}")
+print(f"false_conclusion_witness={actual != contract}")
