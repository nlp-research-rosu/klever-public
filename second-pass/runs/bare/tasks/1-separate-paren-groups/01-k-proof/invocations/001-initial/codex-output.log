from solution import separate_paren_groups
assert separate_paren_groups('( ) (( )) (( )( ))') == ['()', '(())', '(()())']
PY
kompile verification.k --backend haskell --main-module MPY-VERIFICATION --syntax-module MPY-SYNTAX" in /work
