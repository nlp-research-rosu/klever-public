+++ b/verification.k
@@ -0,0 +1,20 @@
+requires "semantic.k"
+
+module MPY-VERIFICATION
+  imports MPY
+
+  // A direct, implementation-independent contract function.  It ignores
+  // spaces, tracks nesting, and emits a group exactly when depth returns to 0.
+  syntax Outputs ::= "separateSpec" "(" Chars ")" [function]
+  syntax Outputs ::= "scanSpec" "(" Chars "," Int "," Chars "," Outputs ")" [function]
+
+  rule separateSpec(CS) => scanSpec(CS, 0, .Chars, .Outputs)
+
+  rule scanSpec(.Chars, _D, _CURRENT, OUT) => OUT
+  rule scanSpec(SP CS, D, CURRENT, OUT) => scanSpec(CS, D, CURRENT, OUT)
+  rule scanSpec(LP CS, D, CURRENT, OUT) => scanSpec(CS, D +Int 1, CURRENT LP, OUT)
+  rule scanSpec(RP CS, 1, CURRENT, OUT) => scanSpec(CS, 0, .Chars, OUT out(CURRENT RP))
+  rule scanSpec(RP CS, D, CURRENT, OUT) => scanSpec(CS, D -Int 1, CURRENT RP, OUT)
+    requires D =/=Int 1
+
+endmodule

