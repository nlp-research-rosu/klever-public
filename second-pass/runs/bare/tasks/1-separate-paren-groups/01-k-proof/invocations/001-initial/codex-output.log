diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..fa788924dd3656848ae53134cb3a48cb74a3e07a
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Regenerate the constructor program from the submitted Python source.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Compile the semantics together with its mathematical verification functions.
+kompile verification.k \
+  --backend haskell \
+  --main-module MPY-VERIFICATION \
+  --syntax-module MPY-SYNTAX
+
+# Exercise the translated program on the prompt example and boundary cases.
+krun solution.mpy --definition verification-kompiled \
+  -cINPUT='Raw("( ) (( )) (( )( ))")' --output pretty \
+  | tee krun-prompt.out
+krun solution.mpy --definition verification-kompiled \
+  -cINPUT='Raw("")' --output pretty \
+  | tee krun-empty.out
+krun solution.mpy --definition verification-kompiled \
+  -cINPUT='Raw("(((())))")' --output pretty \
+  | tee krun-nested.out
+krun solution.mpy --definition verification-kompiled \
+  -cINPUT='Raw("()(())(()())")' --output pretty \
+  | tee krun-adjacent.out
+
+grep -Fq 'OutList ( .Outputs )' krun-empty.out
+grep -Fq 'OutList ( out ( LP  LP  LP  LP  RP  RP  RP  RP  .Chars )  .Outputs )' krun-nested.out
+expected_three='OutList ( out ( LP  RP  .Chars )  out ( LP  LP  RP  RP  .Chars )  out ( LP  LP  RP  LP  RP  RP  .Chars )  .Outputs )'
+grep -Fq "$expected_three" krun-prompt.out
+grep -Fq "$expected_three" krun-adjacent.out
+
+# Prove every claim in spec.k. The extra check makes #Top part of the script's
+# success condition as well as relying on kprove's zero exit status.
+kprove spec.k --definition verification-kompiled --output pretty \
+  | tee kprove.out
+grep -qx '#Top' kprove.out
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..627d5b3ff42e2d948f9e3611937e5938743ad1eb
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,201 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+  imports BOOL-SYNTAX
+
+  syntax Ids ::= List{String, ","}
+  syntax Params ::= "Params" "(" Ids ")"
+
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Stmts ::= List{Stmt, ""}
+
+  syntax Stmt ::= "ImportFrom" "(" String "," Ids ")"
+                | "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "AugAssign" "(" Expr "," String "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "Expr" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Str" "(" String ")"
+                | "Int" "(" Int ")"
+                | "ListExpr" "(" ")"
+                | "Compare" "(" Expr "," CmpOp ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "Call" "(" Expr "," Expr ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  // The task's source alphabet, represented independently of K's strings.
+  // This makes the executable string decoder a small boundary component and
+  // lets the proof quantify structurally over arbitrary inputs.
+  syntax Char ::= "LP" | "RP" | "SP"
+  syntax Chars ::= List{Char, ""}
+
+  syntax Output ::= "out" "(" Chars ")"
+  syntax Outputs ::= List{Output, ""}
+
+  syntax PInt ::= "zero" | "succ" "(" PInt ")"
+
+  syntax Value ::= PInt | Bool
+                 | "SVal" "(" Chars ")"
+                 | "OutList" "(" Outputs ")"
+                 | "none"
+
+  syntax Input ::= "Raw" "(" String ")"
+                 | "Encoded" "(" Chars ")"
+
+  syntax Function ::= "fun" "(" String "," Stmts ")"
+
+  syntax Chars ::= "#chars" "(" String ")" [function]
+  syntax Chars ::= "#concat" "(" Chars "," Chars ")" [function]
+  syntax Char ::= "#char" "(" String ")" [function]
+  syntax Outputs ::= "#snocOut" "(" Outputs "," Chars ")" [function]
+  syntax Value ::= "#inputValue" "(" Input ")" [function]
+  syntax Bool ::= "#eqChars" "(" Chars "," Chars ")" [function]
+  syntax Bool ::= "#eqChar" "(" Char "," Char ")" [function]
+
+  syntax KItem ::= "#boot" "(" Program ")"
+                 | "#load" "(" Stmts ")"
+                 | "#invoke" "(" String ")"
+                 | "#exec" "(" Stmts ")"
+                 | "#assign" "(" String ")"
+                 | "#augAssign" "(" String "," String ")"
+                 | "#cmpLeft" "(" String "," Expr ")"
+                 | "#cmpRight" "(" String "," Value ")"
+                 | "#if" "(" Stmts "," Stmts ")"
+                 | "#for" "(" String "," Stmts ")"
+                 | "#loop" "(" String "," Chars "," Stmts ")"
+                 | "#set" "(" String "," Value ")"
+                 | "#append" "(" String ")"
+                 | "#discard"
+                 | "#return"
+
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports STRING
+  imports BOOL
+  imports MAP
+
+  configuration
+    <mpy>
+      <k> #boot($PGM:Program) </k>
+      <input> $INPUT:Input </input>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> none </result>
+    </mpy>
+
+  rule #chars(S) => .Chars
+    requires lengthString(S) ==Int 0
+  rule #chars(S) => #char(substrString(S, 0, 1)) #chars(substrString(S, 1, lengthString(S)))
+    requires lengthString(S) >Int 0
+
+  rule #char("(") => LP
+  rule #char(")") => RP
+  rule #char(" ") => SP
+
+  rule #concat(.Chars, CS) => CS
+  rule #concat(C CS1, CS2) => C #concat(CS1, CS2)
+
+  rule #snocOut(.Outputs, CS) => out(CS)
+  rule #snocOut(out(OLD) OS, CS) => out(OLD) #snocOut(OS, CS)
+
+  rule #inputValue(Raw(S)) => SVal(#chars(S))
+  rule #inputValue(Encoded(CS)) => SVal(CS)
+
+  rule #eqChars(.Chars, .Chars) => true
+  rule #eqChars(.Chars, _C _CS) => false
+  rule #eqChars(_C _CS, .Chars) => false
+  rule #eqChars(C1 CS1, C2 CS2) => #eqChar(C1, C2) andBool #eqChars(CS1, CS2)
+
+  rule #eqChar(LP, LP) => true
+  rule #eqChar(RP, RP) => true
+  rule #eqChar(SP, SP) => true
+  rule #eqChar(LP, RP) => false
+  rule #eqChar(LP, SP) => false
+  rule #eqChar(RP, LP) => false
+  rule #eqChar(RP, SP) => false
+  rule #eqChar(SP, LP) => false
+  rule #eqChar(SP, RP) => false
+
+  rule <k> #boot(Module(SS)) => #load(SS) ... </k>
+
+  rule <k> #load(.Stmts) => #invoke("separate_paren_groups") ... </k>
+  rule <k> #load(ImportFrom(_, _) SS) => #load(SS) ... </k>
+  rule <k> #load(FuncDef(F, Params(P), BODY) SS) => #load(SS) ... </k>
+       <functions> FS => FS [ F <- fun(P, BODY) ] </functions>
+
+  rule <k> #invoke(F) => #exec(BODY) ... </k>
+       <input> IN </input>
+       <functions> ... F |-> fun(P, BODY) ... </functions>
+       <env> _ => P |-> #inputValue(IN) </env>
+
+  rule <k> #exec(.Stmts) => .K ... </k>
+  rule <k> #exec(S SS) => S ~> #exec(SS) ... </k>
+
+  rule <k> Assign(Name(X), E) => E ~> #assign(X) ... </k>
+  rule <k> V:Value ~> #assign(X) => .K ... </k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule <k> AugAssign(Name(X), OP, E) => E ~> #augAssign(X, OP) ... </k>
+  rule <k> SVal(CS2) ~> #augAssign(X, "+") => .K ... </k>
+       <env> ... X |-> (SVal(CS1) => SVal(#concat(CS1, CS2))) ... </env>
+  rule <k> succ(zero) ~> #augAssign(X, "+") => .K ... </k>
+       <env> ... X |-> (N:PInt => succ(N)) ... </env>
+  rule <k> succ(zero) ~> #augAssign(X, "-") => .K ... </k>
+       <env> ... X |-> (zero => zero) ... </env>
+  rule <k> succ(zero) ~> #augAssign(X, "-") => .K ... </k>
+       <env> ... X |-> (succ(N) => N) ... </env>
+
+  rule <k> If(E, THEN, ELSE) => E ~> #if(THEN, ELSE) ... </k>
+  rule <k> true ~> #if(THEN, _) => #exec(THEN) ... </k>
+  rule <k> false ~> #if(_, ELSE) => #exec(ELSE) ... </k>
+
+  rule <k> For(Name(X), E, BODY) => E ~> #for(X, BODY) ... </k>
+  rule <k> SVal(CS) ~> #for(X, BODY) => #loop(X, CS, BODY) ... </k>
+  rule <k> #loop(_, .Chars, _) => .K ... </k>
+  rule <k> #loop(X, C CS, BODY) => #set(X, SVal(C)) ~> #exec(BODY) ~> #loop(X, CS, BODY) ... </k>
+
+  rule <k> #set(X, V) => .K ... </k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule <k> Return(E) => E ~> #return ... </k>
+  rule <k> V:Value ~> #return ~> _ => .K </k>
+       <result> _ => V </result>
+
+  rule <k> Expr(E) => E ~> #discard ... </k>
+  rule <k> _V:Value ~> #discard => .K ... </k>
+
+  rule <k> Call(Attribute(Name(X), "append"), E) => E ~> #append(X) ... </k>
+  rule <k> SVal(CS) ~> #append(X) => none ... </k>
+       <env> ... X |-> (OutList(OS) => OutList(#snocOut(OS, CS))) ... </env>
+
+  rule <k> Compare(E1, CmpOp(OP, E2)) => E1 ~> #cmpLeft(OP, E2) ... </k>
+  rule <k> V:Value ~> #cmpLeft(OP, E2) => E2 ~> #cmpRight(OP, V) ... </k>
+  rule <k> zero ~> #cmpRight("==", zero) => true ... </k>
+  rule <k> zero ~> #cmpRight("==", succ(_)) => false ... </k>
+  // Character/literal comparisons used by this translated program.  Keeping
+  // these constructor-disjoint also lets symbolic execution split cleanly on
+  // the finite Char datatype.
+  rule <k> SVal(SP) ~> #cmpRight("!=", SVal(SP)) => false ... </k>
+  rule <k> SVal(SP) ~> #cmpRight("!=", SVal(LP)) => true ... </k>
+  rule <k> SVal(SP) ~> #cmpRight("!=", SVal(RP)) => true ... </k>
+  rule <k> SVal(LP) ~> #cmpRight("==", SVal(LP)) => true ... </k>
+  rule <k> SVal(LP) ~> #cmpRight("==", SVal(RP)) => false ... </k>
+  rule <k> SVal(LP) ~> #cmpRight("==", SVal(SP)) => false ... </k>
+
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V ... </env>
+  rule <k> Str(S) => SVal(#chars(S)) ... </k>
+  rule <k> Int(0) => zero ... </k>
+  rule <k> Int(1) => succ(zero) ... </k>
+  rule <k> ListExpr() => OutList(.Outputs) ... </k>
+
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..c900c38a5ccf127de05bfeee2e2574e91f54b460
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,19 @@
+from typing import List
+
+
+def separate_paren_groups(paren_string: str) -> List[str]:
+    result = []
+    current = ""
+    depth = 0
+    ch = ""
+    for ch in paren_string:
+        if ch != " ":
+            current += ch
+            if ch == "(":
+                depth += 1
+            else:
+                depth -= 1
+                if depth == 0:
+                    result.append(current)
+                    current = ""
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..4c6871700ebd4b08d82221a273cf286daa95661f
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,74 @@
+requires "verification.k"
+
+module SPEC
+  imports MPY-VERIFICATION
+
+  // Inductive loop invariant.  This claim is intentionally phrased over an
+  // arbitrary remaining character sequence CS, arbitrary scanner state, and
+  // the exact AST loop body emitted in solution.mpy.
+  claim [loop-invariant]:
+    <mpy>
+      <k>
+        #loop("ch", CS,
+          If(Compare(Name("ch"), CmpOp("!=", Str(" "))),
+            AugAssign(Name("current"), "+", Name("ch"))
+            If(Compare(Name("ch"), CmpOp("==", Str("("))),
+              AugAssign(Name("depth"), "+", Int(1)),
+              AugAssign(Name("depth"), "-", Int(1))
+              If(Compare(Name("depth"), CmpOp("==", Int(0))),
+                Expr(Call(Attribute(Name("result"), "append"), Name("current")))
+                Assign(Name("current"), Str("")),
+                .Stmts)),
+            .Stmts))
+        ~> #exec(Return(Name("result")) .Stmts)
+        => .K
+      </k>
+      <input> IN </input>
+      <env>
+        "ch" |-> SVal(LAST)
+        "current" |-> SVal(CURRENT)
+        "depth" |-> D
+        "paren_string" |-> SVal(ALL)
+        "result" |-> OutList(OUT)
+        => ?FINALENV:Map
+      </env>
+      <functions> FS </functions>
+      <result> _ => OutList(stateOutput(runSpec(CS, D, CURRENT, OUT, LAST))) </result>
+    </mpy>
+
+  // End-to-end correctness from the exact constructor tree in solution.mpy.
+  // Encoded(CS) ranges over every string made of parentheses and spaces, a
+  // strict superset of the prompt's balanced-input domain.
+  claim [program-correct]:
+    <mpy>
+      <k>
+        #boot(
+          Module(
+            ImportFrom("typing", "List")
+            FuncDef("separate_paren_groups", Params("paren_string"),
+              Assign(Name("result"), ListExpr())
+              Assign(Name("current"), Str(""))
+              Assign(Name("depth"), Int(0))
+              Assign(Name("ch"), Str(""))
+              For(Name("ch"), Name("paren_string"),
+                If(Compare(Name("ch"), CmpOp("!=", Str(" "))),
+                  AugAssign(Name("current"), "+", Name("ch"))
+                  If(Compare(Name("ch"), CmpOp("==", Str("("))),
+                    AugAssign(Name("depth"), "+", Int(1)),
+                    AugAssign(Name("depth"), "-", Int(1))
+                    If(Compare(Name("depth"), CmpOp("==", Int(0))),
+                      Expr(Call(Attribute(Name("result"), "append"), Name("current")))
+                      Assign(Name("current"), Str("")),
+                      .Stmts)),
+                  .Stmts))
+              Return(Name("result"))))
+        )
+        => .K
+      </k>
+      <input> Encoded(CS) </input>
+      <env> .Map => ?TOPENV:Map </env>
+      <functions> .Map => ?TOPFUNS:Map </functions>
+      <result> none => OutList(separateSpec(CS)) </result>
+    </mpy>
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..cf2a2e369a8078030cc2d935769de297e0515bef
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,30 @@
+requires "semantic.k"
+
+module MPY-VERIFICATION
+  imports MPY
+
+  // A direct contract model. It consumes input characters into a mathematical
+  // scanner state: depth, unfinished group, completed groups, and last loop
+  // character. Spaces change only the last-character component.
+  syntax ScanState ::= "scanState" "(" PInt "," Chars "," Outputs "," Chars ")"
+  syntax ScanState ::= "runSpec" "(" Chars "," PInt "," Chars "," Outputs "," Chars ")" [function]
+  syntax PInt ::= "stateDepth" "(" ScanState ")" [function]
+  syntax Chars ::= "stateCurrent" "(" ScanState ")" [function]
+                 | "stateLast" "(" ScanState ")" [function]
+  syntax Outputs ::= "stateOutput" "(" ScanState ")" [function]
+                   | "separateSpec" "(" Chars ")" [function]
+
+  rule runSpec(.Chars, D, CURRENT, OUT, LAST) => scanState(D, CURRENT, OUT, LAST)
+  rule runSpec(SP CS, D, CURRENT, OUT, _LAST) => runSpec(CS, D, CURRENT, OUT, SP)
+  rule runSpec(LP CS, D, CURRENT, OUT, _LAST) => runSpec(CS, succ(D), #concat(CURRENT, LP), OUT, LP)
+  rule runSpec(RP CS, zero, CURRENT, OUT, _LAST) => runSpec(CS, zero, .Chars, #snocOut(OUT, #concat(CURRENT, RP)), RP)
+  rule runSpec(RP CS, succ(zero), CURRENT, OUT, _LAST) => runSpec(CS, zero, .Chars, #snocOut(OUT, #concat(CURRENT, RP)), RP)
+  rule runSpec(RP CS, succ(succ(D)), CURRENT, OUT, _LAST) => runSpec(CS, succ(D), #concat(CURRENT, RP), OUT, RP)
+
+  rule stateDepth(scanState(D, _, _, _)) => D
+  rule stateCurrent(scanState(_, CURRENT, _, _)) => CURRENT
+  rule stateOutput(scanState(_, _, OUT, _)) => OUT
+  rule stateLast(scanState(_, _, _, LAST)) => LAST
+  rule separateSpec(CS) => stateOutput(runSpec(CS, zero, .Chars, .Outputs, .Chars))
+
