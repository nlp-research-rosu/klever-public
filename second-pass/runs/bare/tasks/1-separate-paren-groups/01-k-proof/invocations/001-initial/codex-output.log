+  rule scanSpec(SP CS, D, CURRENT, OUT) => scanSpec(CS, D, CURRENT, OUT)
+  rule scanSpec(LP CS, D, CURRENT, OUT) => scanSpec(CS, D +Int 1, #concat(CURRENT, LP), OUT)
