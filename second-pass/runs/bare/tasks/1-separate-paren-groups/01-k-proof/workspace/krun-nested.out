<mpy>
  <k>
    .K
  </k>
  <input>
    Raw ( "(((())))" )
  </input>
  <env>
    "ch" |-> SVal ( RP  .Chars )
    "current" |-> SVal ( .Chars )
    "depth" |-> zero
    "paren_string" |-> SVal ( LP  LP  LP  LP  RP  RP  RP  RP  .Chars )
    "result" |-> OutList ( out ( LP  LP  LP  LP  RP  RP  RP  RP  .Chars )  .Outputs )
  </env>
  <functions>
    "separate_paren_groups" |-> fun ( "paren_string" , Assign ( Name ( "result" ) , ListExpr ( ) )  Assign ( Name ( "current" ) , Str ( "" ) )  Assign ( Name ( "depth" ) , Int ( 0 ) )  Assign ( Name ( "ch" ) , Str ( "" ) )  For ( Name ( "ch" ) , Name ( "paren_string" ) , If ( Compare ( Name ( "ch" ) , CmpOp ( "!=" , Str ( " " ) ) ) , AugAssign ( Name ( "current" ) , "+" , Name ( "ch" ) )  If ( Compare ( Name ( "ch" ) , CmpOp ( "==" , Str ( "(" ) ) ) , AugAssign ( Name ( "depth" ) , "+" , Int ( 1 ) )  .Stmts , AugAssign ( Name ( "depth" ) , "-" , Int ( 1 ) )  If ( Compare ( Name ( "depth" ) , CmpOp ( "==" , Int ( 0 ) ) ) , Expr ( Call ( Attribute ( Name ( "result" ) , "append" ) , Name ( "current" ) ) )  Assign ( Name ( "current" ) , Str ( "" ) )  .Stmts , .Stmts )  .Stmts )  .Stmts , .Stmts )  .Stmts )  Return ( Name ( "result" ) )  .Stmts )
  </functions>
  <result>
    OutList ( out ( LP  LP  LP  LP  RP  RP  RP  RP  .Chars )  .Outputs )
  </result>
</mpy>
