+run kprove spec.k \
+  --definition verification-haskell-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.loop-invariant \
+  --output pretty
+
+run kprove spec.k \
+  --definition verification-haskell-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.program-correct \
+  --output pretty
+
+run kprove spec.k \
+  --definition verification-haskell-kompiled \
+  --spec-module SPEC \
+  --output pretty
