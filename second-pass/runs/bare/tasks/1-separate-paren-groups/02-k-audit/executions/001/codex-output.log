781:const patch = "*** Begin Patch\n*** Update File: /work/solution.py\n@@\n     result = []\n     current = \"\"\n     depth = 0\n+    ch = \"\"\n     for ch in paren_string:\n         if ch != \" \":\n             current += ch\n             if ch == \"(\":\n                 depth += 1\n             else:\n                 depth -= 1\n-            if depth == 0:\n-                result.append(current)\n-                current = \"\"\n+                if depth == 0:\n+                    result.append(current)\n+                    current = \"\"\n*** Update File: /work/verification.k\n@@\n module MPY-VERIFICATION\n   imports MPY\n \n-  // A direct, implementation-independent contract function.  It ignores\n-  // spaces, tracks nesting, and emits a group exactly when depth returns to 0.\n-  syntax Outputs ::= \"separateSpec\" \"(\" Chars \")\" [function]\n-  syntax Outputs ::= \"scanSpec\" \"(\" Chars \",\" Int \",\" Chars \",\" Outputs \")\" [function]\n-\n-  rule separateSpec(CS) => scanSpec(CS, 0, .Chars, .Outputs)\n-\n-  rule scanSpec(.Chars, _D, _CURRENT, OUT) => OUT\n-  rule scanSpec(SP CS, D, CURRENT, OUT) => scanSpec(CS, D, CURRENT, OUT)\n-  rule scanSpec(LP CS, D, CURRENT, OUT) => scanSpec(CS, D +Int 1, #concat(CURRENT, LP), OUT)\n-  rule scanSpec(RP CS, 1, CURRENT, OUT) => scanSpec(CS, 0, .Chars, #snocOut(OUT, #concat(CURRENT, RP)))\n-  rule scanSpec(RP CS, D, CURRENT, OUT) => scanSpec(CS, D -Int 1, #concat(CURRENT, RP), OUT)\n+  // A direct contract model. It consumes input characters into a mathematical\n+  // scanner state: depth, unfinished group, completed groups, and last loop\n+  // character. Spaces change only the last-character component.\n+  syntax ScanState ::= \"scanState\" \"(\" Int \",\" Chars \",\" Outputs \",\" Chars \")\"\n+  syntax ScanState ::= \"runSpec\" \"(\" Chars \",\" Int \",\" Chars \",\" Outputs \",\" Chars \")\" [function]\n+  syntax Int ::= \"stateDepth\" \"(\" ScanState \")\" [function]\n+  syntax Chars ::= \"stateCurrent\" \"(\" ScanState \")\" [function]\n+                 | \"stateLast\" \"(\" ScanState \")\" [function]\n+  syntax Outputs ::= \"stateOutput\" \"(\" ScanState \")\" [function]\n+                   | \"separateSpec\" \"(\" Chars \")\" [function]\n+\n+  rule runSpec(.Chars, D, CURRENT, OUT, LAST) => scanState(D, CURRENT, OUT, LAST)\n+  rule runSpec(SP CS, D, CURRENT, OUT, _LAST) => runSpec(CS, D, CURRENT, OUT, SP)\n+  rule runSpec(LP CS, D, CURRENT, OUT, _LAST) => runSpec(CS, D +Int 1, #concat(CURRENT, LP), OUT, LP)\n+  rule runSpec(RP CS, 1, CURRENT, OUT, _LAST) => runSpec(CS, 0, .Chars, #snocOut(OUT, #concat(CURRENT, RP)), RP)\n+  rule runSpec(RP CS, D, CURRENT, OUT, _LAST) => runSpec(CS, D -Int 1, #concat(CURRENT, RP), OUT, RP)\n     requires D =/=Int 1\n+\n+  rule stateDepth(scanState(D, _, _, _)) => D\n+  rule stateCurrent(scanState(_, CURRENT, _, _)) => CURRENT\n+  rule stateOutput(scanState(_, _, OUT, _)) => OUT\n+  rule stateLast(scanState(_, _, _, LAST)) => LAST\n+  rule separateSpec(CS) => stateOutput(runSpec(CS, 0, .Chars, .Outputs, .Chars))\n \n endmodule\n*** End Patch";
