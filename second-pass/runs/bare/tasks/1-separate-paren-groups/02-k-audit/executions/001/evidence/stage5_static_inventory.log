verification.k:1:requires "semantic.k"
verification.k:3:module MPY-VERIFICATION
verification.k:4:  imports MPY
verification.k:6:  // A direct contract model. It consumes input characters into a mathematical
verification.k:7:  // scanner state: depth, unfinished group, completed groups, and last loop
verification.k:8:  // character. Spaces change only the last-character component.
verification.k:9:  syntax ScanState ::= "scanState" "(" PInt "," Chars "," Outputs "," Chars ")"
verification.k:10:  syntax ScanState ::= "runSpec" "(" Chars "," PInt "," Chars "," Outputs "," Chars ")" [function]
verification.k:11:  syntax PInt ::= "stateDepth" "(" ScanState ")" [function]
verification.k:12:  syntax Chars ::= "stateCurrent" "(" ScanState ")" [function]
verification.k:13:                 | "stateLast" "(" ScanState ")" [function]
verification.k:14:  syntax Outputs ::= "stateOutput" "(" ScanState ")" [function]
verification.k:15:                   | "separateSpec" "(" Chars ")" [function]
verification.k:17:  rule runSpec(.Chars, D, CURRENT, OUT, LAST) => scanState(D, CURRENT, OUT, LAST)
verification.k:18:  rule runSpec(SP CS, D, CURRENT, OUT, _LAST) => runSpec(CS, D, CURRENT, OUT, SP)
verification.k:19:  rule runSpec(LP CS, D, CURRENT, OUT, _LAST) => runSpec(CS, succ(D), #concat(CURRENT, LP), OUT, LP)
verification.k:20:  rule runSpec(RP CS, zero, CURRENT, OUT, _LAST) => runSpec(CS, zero, .Chars, #snocOut(OUT, #concat(CURRENT, RP)), RP)
verification.k:21:  rule runSpec(RP CS, succ(zero), CURRENT, OUT, _LAST) => runSpec(CS, zero, .Chars, #snocOut(OUT, #concat(CURRENT, RP)), RP)
verification.k:22:  rule runSpec(RP CS, succ(succ(D)), CURRENT, OUT, _LAST) => runSpec(CS, succ(D), #concat(CURRENT, RP), OUT, RP)
verification.k:24:  rule stateDepth(scanState(D, _, _, _)) => D
verification.k:25:  rule stateCurrent(scanState(_, CURRENT, _, _)) => CURRENT
verification.k:26:  rule stateOutput(scanState(_, _, OUT, _)) => OUT
verification.k:27:  rule stateLast(scanState(_, _, _, LAST)) => LAST
verification.k:28:  rule separateSpec(CS) => stateOutput(runSpec(CS, zero, .Chars, .Outputs, .Chars))
verification.k:30:endmodule
semantic.k:1:requires "domains.md"
semantic.k:3:module MPY-SYNTAX
semantic.k:4:  imports INT-SYNTAX
semantic.k:5:  imports STRING-SYNTAX
semantic.k:6:  imports BOOL-SYNTAX
semantic.k:8:  syntax Ids ::= List{String, ","}
semantic.k:9:  syntax Params ::= "Params" "(" Ids ")"
semantic.k:11:  syntax Program ::= "Module" "(" Stmts ")"
semantic.k:12:  syntax Stmts ::= List{Stmt, ""}
semantic.k:14:  syntax Stmt ::= "ImportFrom" "(" String "," Ids ")"
semantic.k:15:                | "FuncDef" "(" String "," Params "," Stmts ")"
semantic.k:16:                | "Assign" "(" Expr "," Expr ")"
semantic.k:17:                | "AugAssign" "(" Expr "," String "," Expr ")"
semantic.k:18:                | "For" "(" Expr "," Expr "," Stmts ")"
semantic.k:19:                | "If" "(" Expr "," Stmts "," Stmts ")"
semantic.k:20:                | "Return" "(" Expr ")"
semantic.k:21:                | "Expr" "(" Expr ")"
semantic.k:23:  syntax Expr ::= "Name" "(" String ")"
semantic.k:24:                | "Str" "(" String ")"
semantic.k:25:                | "Int" "(" Int ")"
semantic.k:26:                | "ListExpr" "(" ")"
semantic.k:27:                | "Compare" "(" Expr "," CmpOp ")"
semantic.k:28:                | "Attribute" "(" Expr "," String ")"
semantic.k:29:                | "Call" "(" Expr "," Expr ")"
semantic.k:30:  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
semantic.k:32:  // The task's source alphabet, represented independently of K's strings.
semantic.k:33:  // This makes the executable string decoder a small boundary component and
semantic.k:34:  // lets the proof quantify structurally over arbitrary inputs.
semantic.k:35:  syntax Char ::= "LP" | "RP" | "SP"
semantic.k:36:  syntax Chars ::= List{Char, ""}
semantic.k:38:  syntax Output ::= "out" "(" Chars ")"
semantic.k:39:  syntax Outputs ::= List{Output, ""}
semantic.k:41:  syntax PInt ::= "zero" | "succ" "(" PInt ")"
semantic.k:43:  syntax Value ::= PInt | Bool
semantic.k:44:                 | "SVal" "(" Chars ")"
semantic.k:45:                 | "OutList" "(" Outputs ")"
semantic.k:46:                 | "none"
semantic.k:48:  syntax Input ::= "Raw" "(" String ")"
semantic.k:49:                 | "Encoded" "(" Chars ")"
semantic.k:51:  syntax Function ::= "fun" "(" String "," Stmts ")"
semantic.k:53:  syntax Chars ::= "#chars" "(" String ")" [function]
semantic.k:54:  syntax Chars ::= "#concat" "(" Chars "," Chars ")" [function]
semantic.k:55:  syntax Char ::= "#char" "(" String ")" [function]
semantic.k:56:  syntax Outputs ::= "#snocOut" "(" Outputs "," Chars ")" [function]
semantic.k:57:  syntax Value ::= "#inputValue" "(" Input ")" [function]
semantic.k:58:  syntax Bool ::= "#eqChars" "(" Chars "," Chars ")" [function]
semantic.k:59:  syntax Bool ::= "#eqChar" "(" Char "," Char ")" [function]
semantic.k:61:  syntax KItem ::= "#boot" "(" Program ")"
semantic.k:62:                 | "#load" "(" Stmts ")"
semantic.k:63:                 | "#invoke" "(" String ")"
semantic.k:64:                 | "#exec" "(" Stmts ")"
semantic.k:65:                 | "#assign" "(" String ")"
semantic.k:66:                 | "#augAssign" "(" String "," String ")"
semantic.k:67:                 | "#cmpLeft" "(" String "," Expr ")"
semantic.k:68:                 | "#cmpRight" "(" String "," Value ")"
semantic.k:69:                 | "#if" "(" Stmts "," Stmts ")"
semantic.k:70:                 | "#for" "(" String "," Stmts ")"
semantic.k:71:                 | "#loop" "(" String "," Chars "," Stmts ")"
semantic.k:72:                 | "#set" "(" String "," Value ")"
semantic.k:73:                 | "#append" "(" String ")"
semantic.k:74:                 | "#discard"
semantic.k:75:                 | "#return"
semantic.k:77:endmodule
semantic.k:79:module MPY
semantic.k:80:  imports MPY-SYNTAX
semantic.k:81:  imports INT
semantic.k:82:  imports STRING
semantic.k:83:  imports BOOL
semantic.k:84:  imports MAP
semantic.k:86:  configuration
semantic.k:87:    <mpy>
semantic.k:88:      <k> #boot($PGM:Program) </k>
semantic.k:89:      <input> $INPUT:Input </input>
semantic.k:90:      <env> .Map </env>
semantic.k:91:      <functions> .Map </functions>
semantic.k:92:      <result> none </result>
semantic.k:93:    </mpy>
semantic.k:95:  rule #chars(S) => .Chars
semantic.k:96:    requires lengthString(S) ==Int 0
semantic.k:97:  rule #chars(S) => #char(substrString(S, 0, 1)) #chars(substrString(S, 1, lengthString(S)))
semantic.k:98:    requires lengthString(S) >Int 0
semantic.k:100:  rule #char("(") => LP
semantic.k:101:  rule #char(")") => RP
semantic.k:102:  rule #char(" ") => SP
semantic.k:104:  rule #concat(.Chars, CS) => CS
semantic.k:105:  rule #concat(C CS1, CS2) => C #concat(CS1, CS2)
semantic.k:107:  rule #snocOut(.Outputs, CS) => out(CS)
semantic.k:108:  rule #snocOut(out(OLD) OS, CS) => out(OLD) #snocOut(OS, CS)
semantic.k:110:  rule #inputValue(Raw(S)) => SVal(#chars(S))
semantic.k:111:  rule #inputValue(Encoded(CS)) => SVal(CS)
semantic.k:113:  rule #eqChars(.Chars, .Chars) => true
semantic.k:114:  rule #eqChars(.Chars, _C _CS) => false
semantic.k:115:  rule #eqChars(_C _CS, .Chars) => false
semantic.k:116:  rule #eqChars(C1 CS1, C2 CS2) => #eqChar(C1, C2) andBool #eqChars(CS1, CS2)
semantic.k:118:  rule #eqChar(LP, LP) => true
semantic.k:119:  rule #eqChar(RP, RP) => true
semantic.k:120:  rule #eqChar(SP, SP) => true
semantic.k:121:  rule #eqChar(LP, RP) => false
semantic.k:122:  rule #eqChar(LP, SP) => false
semantic.k:123:  rule #eqChar(RP, LP) => false
semantic.k:124:  rule #eqChar(RP, SP) => false
semantic.k:125:  rule #eqChar(SP, LP) => false
semantic.k:126:  rule #eqChar(SP, RP) => false
semantic.k:128:  rule <k> #boot(Module(SS)) => #load(SS) ... </k>
semantic.k:130:  rule <k> #load(.Stmts) => #invoke("separate_paren_groups") ... </k>
semantic.k:131:  rule <k> #load(ImportFrom(_, _) SS) => #load(SS) ... </k>
semantic.k:132:  rule <k> #load(FuncDef(F, Params(P), BODY) SS) => #load(SS) ... </k>
semantic.k:133:       <functions> FS => FS [ F <- fun(P, BODY) ] </functions>
semantic.k:135:  rule <k> #invoke(F) => #exec(BODY) ... </k>
semantic.k:136:       <input> IN </input>
semantic.k:137:       <functions> ... F |-> fun(P, BODY) ... </functions>
semantic.k:138:       <env> _ => P |-> #inputValue(IN) </env>
semantic.k:140:  rule <k> #exec(.Stmts) => .K ... </k>
semantic.k:141:  rule <k> #exec(S SS) => S ~> #exec(SS) ... </k>
semantic.k:143:  rule <k> Assign(Name(X), E) => E ~> #assign(X) ... </k>
semantic.k:144:  rule <k> V:Value ~> #assign(X) => .K ... </k>
semantic.k:145:       <env> RHO => RHO [ X <- V ] </env>
semantic.k:147:  rule <k> AugAssign(Name(X), OP, E) => E ~> #augAssign(X, OP) ... </k>
semantic.k:148:  rule <k> SVal(CS2) ~> #augAssign(X, "+") => .K ... </k>
semantic.k:149:       <env> ... X |-> (SVal(CS1) => SVal(#concat(CS1, CS2))) ... </env>
semantic.k:150:  rule <k> succ(zero) ~> #augAssign(X, "+") => .K ... </k>
semantic.k:151:       <env> ... X |-> (N:PInt => succ(N)) ... </env>
semantic.k:152:  rule <k> succ(zero) ~> #augAssign(X, "-") => .K ... </k>
semantic.k:153:       <env> ... X |-> (zero => zero) ... </env>
semantic.k:154:  rule <k> succ(zero) ~> #augAssign(X, "-") => .K ... </k>
semantic.k:155:       <env> ... X |-> (succ(N) => N) ... </env>
semantic.k:157:  rule <k> If(E, THEN, ELSE) => E ~> #if(THEN, ELSE) ... </k>
semantic.k:158:  rule <k> true ~> #if(THEN, _) => #exec(THEN) ... </k>
semantic.k:159:  rule <k> false ~> #if(_, ELSE) => #exec(ELSE) ... </k>
semantic.k:161:  rule <k> For(Name(X), E, BODY) => E ~> #for(X, BODY) ... </k>
semantic.k:162:  rule <k> SVal(CS) ~> #for(X, BODY) => #loop(X, CS, BODY) ... </k>
semantic.k:163:  rule <k> #loop(_, .Chars, _) => .K ... </k>
semantic.k:164:  rule <k> #loop(X, C CS, BODY) => #set(X, SVal(C)) ~> #exec(BODY) ~> #loop(X, CS, BODY) ... </k>
semantic.k:166:  rule <k> #set(X, V) => .K ... </k>
semantic.k:167:       <env> RHO => RHO [ X <- V ] </env>
semantic.k:169:  rule <k> Return(E) => E ~> #return ... </k>
semantic.k:170:  rule <k> V:Value ~> #return ~> _ => .K </k>
semantic.k:171:       <result> _ => V </result>
semantic.k:173:  rule <k> Expr(E) => E ~> #discard ... </k>
semantic.k:174:  rule <k> _V:Value ~> #discard => .K ... </k>
semantic.k:176:  rule <k> Call(Attribute(Name(X), "append"), E) => E ~> #append(X) ... </k>
semantic.k:177:  rule <k> SVal(CS) ~> #append(X) => none ... </k>
semantic.k:178:       <env> ... X |-> (OutList(OS) => OutList(#snocOut(OS, CS))) ... </env>
semantic.k:180:  rule <k> Compare(E1, CmpOp(OP, E2)) => E1 ~> #cmpLeft(OP, E2) ... </k>
semantic.k:181:  rule <k> V:Value ~> #cmpLeft(OP, E2) => E2 ~> #cmpRight(OP, V) ... </k>
semantic.k:182:  rule <k> zero ~> #cmpRight("==", zero) => true ... </k>
semantic.k:183:  rule <k> zero ~> #cmpRight("==", succ(_)) => false ... </k>
semantic.k:184:  // Character/literal comparisons used by this translated program.  Keeping
semantic.k:185:  // these constructor-disjoint also lets symbolic execution split cleanly on
semantic.k:186:  // the finite Char datatype.
semantic.k:187:  rule <k> SVal(SP) ~> #cmpRight("!=", SVal(SP)) => false ... </k>
semantic.k:188:  rule <k> SVal(SP) ~> #cmpRight("!=", SVal(LP)) => true ... </k>
semantic.k:189:  rule <k> SVal(SP) ~> #cmpRight("!=", SVal(RP)) => true ... </k>
semantic.k:190:  rule <k> SVal(LP) ~> #cmpRight("==", SVal(LP)) => true ... </k>
semantic.k:191:  rule <k> SVal(LP) ~> #cmpRight("==", SVal(RP)) => false ... </k>
semantic.k:192:  rule <k> SVal(LP) ~> #cmpRight("==", SVal(SP)) => false ... </k>
semantic.k:194:  rule <k> Name(X) => V ... </k>
semantic.k:195:       <env> ... X |-> V ... </env>
semantic.k:196:  rule <k> Str(S) => SVal(#chars(S)) ... </k>
semantic.k:197:  rule <k> Int(0) => zero ... </k>
semantic.k:198:  rule <k> Int(1) => succ(zero) ... </k>
semantic.k:199:  rule <k> ListExpr() => OutList(.Outputs) ... </k>
semantic.k:201:endmodule
[exit 0]

