xec(ELSE) ... </k>\n+\n+  rule <k> For(Name(X), E, BODY) => E ~> #for(X, BODY) ... </k>\n+  rule <k> SVal(CS) ~> #for(X, BODY) => #loop(X, CS, BODY) ... </k>\n+  rule <k> #loop(_, .Chars, _) => .K ... </k>\n+  rule <k> #loop(X, C CS, BODY) => #set(X, SVal(C)) ~> #exec(BODY) ~> #loop(X, CS, BODY) ... </k>\n+\n+  rule <k> #set(X, V) => .K ... </k>\n+       <env> RHO => RHO [ X <- V ] </env>\n+\n+  rule <k> Return(E) => E ~> #return ... </k>\n+  rule <k> V:Value ~> #return ~> _ => .K </k>\n+       <result> _ => V </result>\n+\n+  rule <k> Expr(E) => E ~> #discard ... </k>\n+  rule <k> _V:Value ~> #discard => .K ... </k>\n+\n+  rule <k> Call(Attribute(Name(X), \"append\"), E) => E ~> #append(X) ... </k>\n+  rule <k> SVal(CS) ~> #append(X) => none ... </k>\n+       <env> ... X |-> (OutList(OS) => OutList(OS out(CS))) ... </env>\n+\n+  rule <k> Compare(E1, CmpOp(OP, E2)) => E1 ~> #cmpLeft(OP, E2) ... </k>\n+  rule <k> V:Value ~> #cmpLeft(OP, E2) => E2 ~> #cmpRight(OP, V) ... </k>\n+  rule <k> I2:Int ~> #cmpRight(\"==\", I1:Int) => I1 ==Int I2 ... </k>\n+  rule <k> SVal(CS2) ~> #cmpRight(\"==\", SVal(CS1)) => #eqChars(CS1, CS2) ... </k>\n+  rule <k> SVal(CS2) ~> #cmpRight(\"!=\", SVal(CS1)) => notBool #eqChars(CS1, CS2) ... </k>\n+\n+  rule <k> Name(X) => V ... </k>\n+       <env> ... X |-> V ... </env>\n+  rule <k> Str(S) => SVal(#chars(S)) ... </k>\n+  rule <k> Int(I) => I ... </k>\n+  rule <k> ListExpr() => OutList(.Outputs) ... </k>\n+\n+endmodule\n*** Add File: /work/verification.k\n+requires \"semantic.k\"\n+\n+module MPY-VERIFICATION\n+  imports MPY\n+\n+  // A direct, implementation-independent contract function.  It ignores\n+  // spaces, tracks nesting, and emits a group exactly when depth returns to 0.\n+  syntax Outputs ::= \"separateSpec\" \"(\" Chars \")\" [function]\n+  syntax Outputs ::= \"scanSpec\" \"(\" Chars \",\" Int \",\" Chars \",\" Outputs \")\" [function]\n+\n+  rule separateSpec(CS) => scanSpec(CS, 0, .Chars, .Outputs)\n+\n+  rule scanSpec(.Chars, _D, _CURRENT, OUT) => OUT\n+  rule scanSpec(SP CS, D, CURRENT, OUT) => scanSpec(CS, D, CURRENT, OUT)\n+  rule scanSpec(LP CS, D, CURRENT, OUT) => scanSpec(CS, D +Int 1, CURRENT LP, OUT)\n+  rule scanSpec(RP CS, 1, CURRENT, OUT) => scanSpec(CS, 0, .Chars, OUT out(CURRENT RP))\n+  rule scanSpec(RP CS, D, CURRENT, OUT) => scanSpec(CS, D -Int 1, CURRENT RP, OUT)\n+    requires D =/=Int 1\n+\n+endmodule\n*** End Patch";
