+        if opens < pairs:
+            choices.append("(")
+        if closes < opens:
+            choices.append(")")
+        char = rng.choice(choices)
+        chars.append(char)
+        if char == "(":
+            opens += 1
+        else:
+            closes += 1
+    return "".join(chars)
+
+
+def spaced(text: str, rng: random.Random) -> str:
+    pieces = [" " * rng.randrange(4)]
+    for char in text:
+        pieces.append(char)
+        pieces.append(" " * rng.randrange(4))
+    return "".join(pieces)
