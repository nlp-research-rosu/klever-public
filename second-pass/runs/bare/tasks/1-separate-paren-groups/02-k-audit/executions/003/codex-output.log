     4	def separate_paren_groups(paren_string: str) -> List[str]:
     5	    result = []
     6	    current = ""
     7	    depth = 0
     8	    ch = ""
     9	    for ch in paren_string:
    10	        if ch != " ":
    11	            current += ch
    12	            if ch == "(":
    13	                depth += 1
    14	            else:
    15	                depth -= 1
    16	                if depth == 0:
    17	                    result.append(current)
    18	                    current = ""
    19	    return result
