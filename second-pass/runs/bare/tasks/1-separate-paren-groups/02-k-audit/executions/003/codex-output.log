+    "(((())))": ["(((())))"],
+    " ( ( ) )  ( ) ": ["(())", "()"],
+    "(()())(())()": ["(()())", "(())", "()"],
+}
+
+for text, expected in documented.items():
+    check(text, expected)
+for text, expected in boundaries.items():
+    check(text, expected)
+
+alphabet = "() "
