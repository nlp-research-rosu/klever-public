index 0000000000000000000000000000000000000000..1bb2bec5a4c7ea0012fe7304618fec5e22c42112
--- /dev/null
+++ b/evidence/provenance_check.sh
@@ -0,0 +1,96 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+required_files=(
+  /audit-input.json
+  /audit-campaign-lock.json
+  /run.json
+  /task.json
+  /generation-result.json
+  /generation-evidence/invocation.json
