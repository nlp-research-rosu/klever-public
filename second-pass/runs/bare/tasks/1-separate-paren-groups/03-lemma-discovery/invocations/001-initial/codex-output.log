/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
from pathlib import Path

inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
result = json.loads(Path('/workspace/trust-boundary.json').read_text())

assert list(result.keys()) == ['schema_version', 'inventory_sha256', 'rules']
assert set(result.keys()) == {'schema_version', 'inventory_sha256', 'rules'}
assert result['schema_version'] == 2
assert result['inventory_sha256'] == inventory['inventory_sha256']

expected_ids = [rule['source_rule_id'] for rule in inventory['rules']]
actual_ids = [rule['source_rule_id'] for rule in result['rules']]
assert actual_ids == expected_ids
assert len(actual_ids) == len(set(actual_ids)) == len(expected_ids)

allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
by_id = {rule['source_rule_id']: rule for rule in result['rules']}
for entry in result['rules']:
    assert set(entry.keys()) == {'source_rule_id', 'classification', 'rationale'}
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
for source in inventory['rules']:
    if 'simplification' in source['attributes']:
        assert by_id[source['source_rule_id']]['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}

doc = Path('/workspace/DISCOVERY.md').read_text()
assert 'There are no "'`PROVED_DERIVED_LEMMA` entries'"' in doc
assert 'The "'`DOMAIN_LEMMA` set is explicitly empty'"' in doc

counts = Counter(rule['classification'] for rule in result['rules'])
print('VALIDATED')
print('inventory_sha256:', result['inventory_sha256'])
print('canonical/classified:', len(expected_ids), len(actual_ids))
for name in sorted(allowed):
    print(f'{name}:', counts[name])
PY
printf '\\n--- trust-boundary.json ---\\n'
