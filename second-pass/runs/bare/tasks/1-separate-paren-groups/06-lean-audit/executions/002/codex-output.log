+            "PROVED_DERIVED_LEMMA": len(validated["proved_derived_lemmas"]),
+            "DOMAIN_LEMMA": len(validated["domain_lemmas"]),
+        },
+        "manifest_entries": manifest_rules,
+    }
+    print(json.dumps(report, indent=2, sort_keys=True))
+
+
+if __name__ == "__main__":
+    main()

