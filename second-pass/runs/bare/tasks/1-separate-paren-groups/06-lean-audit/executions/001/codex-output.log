+{
+  "designated_sorry_count": 0,
+  "diagnostics": [
+    {
+      "command": [
+        "lake",
+        "clean"
+      ],
+      "exit_code": 0,
+      "output_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
+      "output_tail": ""
+    },
+    {
+      "command": [
+        "lake",
+        "build"
+      ],
