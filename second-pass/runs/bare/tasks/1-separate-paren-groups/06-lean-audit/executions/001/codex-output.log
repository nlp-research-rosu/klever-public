index 0000000000000000000000000000000000000000..8feca60ef329b39f7527607ce2b170779415ed63
--- /dev/null
+++ b/evidence/04_toolchain_probe.cmd
@@ -0,0 +1,6 @@
+command -v lake
+command -v lean
+command -v elan
+lake --version
