diff --git a//tmp/audit-work/hostpid_shim.c b//tmp/audit-work/hostpid_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..eda89948674b22aa63f6523804deaa82b24da480
--- /dev/null
+++ b//tmp/audit-work/hostpid_shim.c
@@ -0,0 +1,28 @@
+#define _GNU_SOURCE
+
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * Audit-container compatibility shim:
+ * getpid() returns the inner namespace PID, but /proc exposes host PIDs.
+ * Lean 4.22 constructs /proc/<getpid()>/exe rather than using /proc/self/exe.
+ */
+pid_t getpid(void) {
+    char target[64];
+    ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+    pid_t result = 0;
+    ssize_t index;
+
+    if (length <= 0) {
+        return (pid_t)1;
+    }
+    target[length] = '\0';
+    for (index = 0; index < length; ++index) {
+        if (target[index] < '0' || target[index] > '9') {
+            return (pid_t)1;
+        }
+        result = (pid_t)(result * 10 + (target[index] - '0'));
+    }
+    return result > 0 ? result : (pid_t)1;
+}
