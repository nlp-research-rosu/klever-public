+assert trust_inventory["other_sorries"] == 0
+assert len(trust_inventory["allowlist"]) == preflight["trust_declaration_count"]
+assert set(trust_inventory["axioms"]) == {
+    entry["name"] for entry in trust_inventory["allowlist"]
+}
