+assert obligation_map["source_rules"] == source_rules
+
+obligations = obligation_map["obligations"]
+parameters = obligation_map["trust_parameters"]
+assert obligations == []
+assert parameters == []
+assert len({entry.get("source_rule_id") for entry in obligations}) == len(
+    obligations
+)
+
