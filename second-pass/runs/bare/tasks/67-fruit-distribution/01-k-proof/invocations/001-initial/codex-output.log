diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..a0b8c2de449387bf402ffcb3f909128402cdbc8a
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,19 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Every valid fruit description is represented by VFruits(A, O).  The
+  // implementation must return the unallocated fruit count for arbitrary
+  // nonnegative counts whose sum does not exceed the basket total.
+  claim
+    <py>
+      <k>
+        solutionProgram ~> invokeFruit(A:Int, O:Int, N:Int)
+        => VInt(N -Int A -Int O)
+      </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+    </py>
+    requires (A >=Int 0) andBool (O >=Int 0) andBool (N >=Int A +Int O)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ec3cfd1670cdd7189281b16257cd12b2e1fdd48a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,21 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY-SEMANTIC
+
+  // This is the constructor term emitted in solution.mpy.  Keeping it here
+  // makes the proof claim independent of parser/configuration initializers.
+  syntax Program ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      FuncDef("fruit_distribution", Params("s", "n"),
+        Assign(Name("words"), Call(Attribute(Name("s"), "split"), ))
+        Return(
+          BinOp(
+            "-",
+            BinOp(
+              "-",
+              Name("n"),
+              Call(Name("int"), Subscript(Name("words"), Int(0)))),
+            Call(Name("int"), Subscript(Name("words"), Int(3)))))))
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC' in /work
