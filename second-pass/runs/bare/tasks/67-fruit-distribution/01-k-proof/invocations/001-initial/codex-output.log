+                | "Call" "(" Expr "," ")" [klabel(Call0), strict(1)]
+                | "Call" "(" Expr "," Expr ")" [klabel(Call1), seqstrict(1,2)]
+                | "Subscript" "(" Expr "," Expr ")" [klabel(Subscript), seqstrict(1,2)]
+                | "BinOp" "(" String "," Expr "," Expr ")" [klabel(BinOp), seqstrict(2,3)]
