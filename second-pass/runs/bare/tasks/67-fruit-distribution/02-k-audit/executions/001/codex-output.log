@@ -0,0 +1,11 @@
+requires "semantic.k"
+
+module AUDIT-DRIVER
+  imports MPY-SEMANTIC
+
+  // Reviewer-only concrete entry wrapper. It contributes no value equation:
+  // it loads the parsed submitted program and invokes its registered function.
+  syntax Program ::= "auditRun" "(" Program "," String "," Int ")" [symbol(auditRun)]
+
+  rule <k> auditRun(P:Program, S:String, N:Int) => P ~> invokeString(S, N) ... </k>
+endmodule
diff --git a//tmp/audit-work/fresh/spec-audit.k b//tmp/audit-work/fresh/spec-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..e36e49a075ea0f5891e9c315fa07d643b83384a2
--- /dev/null
+++ b//tmp/audit-work/fresh/spec-audit.k
@@ -0,0 +1,44 @@
+requires "verification.k"
+
+module SPEC-AUDIT
+  imports VERIFICATION
+
+  claim [general]:
+    <py>
+      <k>
+        solutionProgram ~> invokeFruit(A:Int, O:Int, N:Int)
+        => VInt(N -Int A -Int O)
+      </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+    </py>
+    requires (A >=Int 0) andBool (O >=Int 0) andBool (N >=Int A +Int O)
+
+  claim [example-1]:
+    <py>
+      <k> solutionProgram ~> invokeString("5 apples and 6 oranges", 19) => VInt(8) </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+    </py>
+
+  claim [example-2]:
+    <py>
+      <k> solutionProgram ~> invokeString("0 apples and 1 oranges", 3) => VInt(2) </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+    </py>
+
+  claim [example-3]:
+    <py>
+      <k> solutionProgram ~> invokeString("2 apples and 3 oranges", 100) => VInt(95) </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+    </py>
+
+  claim [example-4]:
+    <py>
+      <k> solutionProgram ~> invokeString("100 apples and 1 oranges", 120) => VInt(19) </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+    </py>
+endmodule
diff --git a//tmp/audit-work/fresh/spec-vacuity-audit.k b//tmp/audit-work/fresh/spec-vacuity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..397626e737e818962dc7ab1db78c93b57ccc1e84
--- /dev/null
+++ b//tmp/audit-work/fresh/spec-vacuity-audit.k
@@ -0,0 +1,18 @@
+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // Fresh reviewer mutation of the result obligation. This is false at the
+  // satisfying witness A=5, O=6, N=19: the program returns 8, not 9.
+  claim [general-off-by-one]:
+    <py>
+      <k>
+        solutionProgram ~> invokeFruit(A:Int, O:Int, N:Int)
+        => VInt(N -Int A -Int O +Int 1)
+      </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+    </py>
+    requires (A >=Int 0) andBool (O >=Int 0) andBool (N >=Int A +Int O)
+endmodule
