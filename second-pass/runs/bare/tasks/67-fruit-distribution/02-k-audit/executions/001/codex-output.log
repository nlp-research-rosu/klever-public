diff --git a//tmp/audit-work/fresh/semantic-driver.k b//tmp/audit-work/fresh/semantic-driver.k
new file mode 100644
index 0000000000000000000000000000000000000000..303172c3574a2c6f66b2c1cca694ab93d95520fe
--- /dev/null
+++ b//tmp/audit-work/fresh/semantic-driver.k
@@ -0,0 +1,11 @@
+requires "semantic.k"
+
+module AUDIT-DRIVER
+  imports MPY-SEMANTIC
+
+  // Reviewer-only concrete entry wrapper. It contributes no value equation:
+  // it loads the parsed submitted program and invokes its registered function.
+  syntax Program ::= "auditRun" "(" Program "," String "," Int ")" [symbol(auditRun)]
+
+  rule <k> auditRun(P:Program, S:String, N:Int) => P ~> invokeString(S, N) ... </k>
+endmodule
