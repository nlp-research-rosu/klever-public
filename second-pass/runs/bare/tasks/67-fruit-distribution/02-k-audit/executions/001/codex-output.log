+requires "semantic.k"
+
+module AUDIT-DRIVER
+  imports MPY-SEMANTIC
+
+  // Reviewer-only concrete entry wrapper. It contributes no value equation:
+  // it loads the parsed submitted program and invokes its registered function.
+  syntax Program ::= "auditRun" "(" Program "," String "," Int ")" [symbol(auditRun)]
+
+  rule <k> auditRun(P:Program, S:String, N:Int) => P ~> invokeString(S, N) ... </k>
+endmodule
