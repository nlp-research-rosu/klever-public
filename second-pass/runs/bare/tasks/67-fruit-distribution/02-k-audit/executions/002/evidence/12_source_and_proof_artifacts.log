     6	def fruit_distribution(s,n):
     7	    """
     8	    In this task, you will be given a string that represents a number of apples and oranges 
     9	    that are distributed in a basket of fruit this basket contains 
    10	    apples, oranges, and mango fruits. Given the string that represents the total number of 
    11	    the oranges and apples and an integer that represent the total number of the fruits 
    12	    in the basket return the number of the mango fruits in the basket.
    13	    for examble:
    14	    fruit_distribution("5 apples and 6 oranges", 19) ->19 - 5 - 6 = 8
    15	    fruit_distribution("0 apples and 1 oranges",3) -> 3 - 0 - 1 = 2
    16	    fruit_distribution("2 apples and 3 oranges", 100) -> 100 - 2 - 3 = 95
    17	    fruit_distribution("100 apples and 1 oranges",120) -> 120 - 100 - 1 = 19
    18	    """
    19	    lis = list()
    20	    for i in s.split(' '):
    21	        if i.isdigit():
    22	            lis.append(int(i))
    23	    return n - sum(lis)
