     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd -- "$(dirname -- "$0")"
     5	
     6	PROVE_TMP_DIR="$(mktemp -d)"
     7	trap 'rm -rf -- "$PROVE_TMP_DIR"' EXIT
     8	
     9	# Reproduce the required translation and reject a stale solution.mpy.
    10	python3 py2mpy.py solution.py > "$PROVE_TMP_DIR/solution.mpy"
    11	cmp solution.mpy "$PROVE_TMP_DIR/solution.mpy"
    12	
    13	# Check that the translated source is accepted and executable by the base
    14	# semantics, independently of the verification driver.
    15	kompile semantic.k \
    16	  --main-module MPY-SEMANTIC \
    17	  --syntax-module MPY-SYNTAX \
    18	  --backend haskell
    19	krun solution.mpy --definition semantic-kompiled --output pretty
    20	
    21	# Compile the proof driver.  Its solutionProgram macro is checked against the
    22	# parsed solution.mpy below, so the proof cannot silently use a different AST.
    23	kompile verification.k \
    24	  --main-module VERIFICATION \
    25	  --syntax-module VERIFICATION \
    26	  --backend haskell
    27	krun solution.mpy \
    28	  --definition verification-kompiled \
    29	  --depth 0 \
    30	  --output kast \
    31	  > "$PROVE_TMP_DIR/source.kast" 2> /dev/null
    32	krun solution-alias.mpy \
    33	  --definition verification-kompiled \
    34	  --depth 0 \
    35	  --output kast \
    36	  > "$PROVE_TMP_DIR/alias.kast" 2> /dev/null
    37	cmp "$PROVE_TMP_DIR/source.kast" "$PROVE_TMP_DIR/alias.kast"
    38	
    39	run_and_expect() {
    40	  local input_file="$1"
    41	  local expected="$2"
    42	  local output
    43	
    44	  output="$(krun "$input_file" --definition verification-kompiled --output pretty)"
    45	  printf '%s\n' "$output"
    46	  [[ "$output" == *"VInt ( $expected )"* ]]
    47	  [[ "$output" != *"#Bottom"* ]]
    48	}
