COMMAND: bash -lc $'set -e; printf "===== base semantics registers actual solution.mpy =====\\n"; timeout 30 krun solution.mpy --definition audit-semantic-haskell-kompiled --output pretty; printf "===== driver executions =====\\n"; for f in /audit-output/evidence/k-input-example.mpy /audit-output/evidence/k-input-zero.mpy /audit-output/evidence/k-input-left-boundary.mpy /audit-output/evidence/k-input-right-boundary.mpy /audit-output/evidence/k-input-large.mpy /audit-output/evidence/k-input-negative-result.mpy; do printf "INPUT_FILE=%s CONTENT=" "$f"; tr -d "\\n" < "$f"; printf "\\n"; timeout 30 krun "$f" --definition audit-verification-kompiled --output pretty; done; printf "===== independent Python values =====\\n"; python3 - <<"PY"\nimport importlib.util\n\ndef load(name, path):\n    spec = importlib.util.spec_from_file_location(name, path)\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module.fruit_distribution\ncandidate = load("candidate", "/tmp/audit-work/fruit-audit/solution.py")\ncanonical = load("canonical", "/reference/canonical.py")\nfor args in [("5 apples and 6 oranges",19),("0 apples and 0 oranges",0),("1 apples and 0 oranges",1),("0 apples and 1 oranges",1),("999999 apples and 888888 oranges",1888887),("2 apples and 3 oranges",4)]:\n    print(args, "candidate=", candidate(*args), "canonical=", canonical(*args))\nPY'
