+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION \
+  --backend haskell \
+  --output-definition audit-verification-haskell-kompiled || exit $?
+
+run kprove spec.k \
+  --definition audit-verification-haskell-kompiled \
+  --spec-module SPEC
