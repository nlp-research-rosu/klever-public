+  imports VERIFICATION
+
+  // Both trusted canonical.py and submitted solution.py return 8 here because
+  // their split operations tolerate repeated spaces in the relevant positions.
+  claim
+    <py>
+      <k>
+        solutionProgram ~> invokeString("5  apples and 6 oranges", 19)
+        => VInt(8)
+      </k>
+      <functions> .Map </functions>
+      <env> .Map </env>
+    </py>
+endmodule
