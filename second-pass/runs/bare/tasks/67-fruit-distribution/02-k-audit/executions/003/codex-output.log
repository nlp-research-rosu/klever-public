+#!/usr/bin/env python3
+"""Stream and structurally inspect every required legacy-selected-stage1 record."""
+
+from __future__ import annotations
+
+import collections
+import json
+from pathlib import Path
+
+
+json_records = [
+    Path("/run.json"),
