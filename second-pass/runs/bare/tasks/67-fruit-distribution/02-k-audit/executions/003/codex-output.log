+#!/usr/bin/env bash
+set -uo pipefail
+
+work=/tmp/audit-work/fruit67/candidate
+cd "$work" || exit 99
+
+run() {
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local status=$?
+  printf 'EXIT_STATUS=%s\n' "$status"
+  return "$status"
+}
+
