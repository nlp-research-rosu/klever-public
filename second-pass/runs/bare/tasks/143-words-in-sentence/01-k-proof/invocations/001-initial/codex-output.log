+kompile semantic.k \
+  --backend haskell \
+  --main-module MPY-SEMANTIC \
+  --syntax-module MPY-SYNTAX
+
+krun solution.mpy \
+  --definition semantic-kompiled \
+  -cSENTENCE='"This is a test"' \
+  | grep -F 'Str ( "is" )'
+
+krun solution.mpy \
+  --definition semantic-kompiled \
+  -cSENTENCE='"lets go for swimming"' \
+  | grep -F 'Str ( "go for" )'
