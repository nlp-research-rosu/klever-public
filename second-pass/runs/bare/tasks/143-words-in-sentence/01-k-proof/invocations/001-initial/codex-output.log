+       orBool N ==Int 59 orBool N ==Int 61 orBool N ==Int 67
+       orBool N ==Int 71 orBool N ==Int 73 orBool N ==Int 79
+       orBool N ==Int 83 orBool N ==Int 89 orBool N ==Int 97
