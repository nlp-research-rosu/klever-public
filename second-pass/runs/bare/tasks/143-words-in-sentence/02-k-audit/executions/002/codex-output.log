diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..8d0925a52efd7d275cb2d5181699a05e559763c6
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,17 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports MPY-VERIFICATION
+
