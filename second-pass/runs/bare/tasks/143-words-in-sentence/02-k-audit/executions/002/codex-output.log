+                Int(59),
+                Int(61),
+                Int(67),
+                Int(71),
+                Int(73),
+                Int(79),
+                Int(83),
+                Int(89),
+                Int(97)))),
+            If(Compare(Name("result"), CmpOp("==", Str(""))),
+              Assign(Name("result"), Name("word")),
+              Assign(
+                Name("result"),
+                BinOp(
+                  "+",
