                     'surface form\n'
                     '#                         (a quoted string `"op"`, a '
                     'number `0`, `true`, `Break`)\n'
                     '# '
                     '---------------------------------------------------------------------------\n'
                     'class Ctor:\n'
                     '    __slots__ = ("name", "args")\n'
                     '\n'
                     '    def __init__(self, name: str, *args):\n'
                     '        self.name = name\n'
                     '        self.args = list(args)\n'
