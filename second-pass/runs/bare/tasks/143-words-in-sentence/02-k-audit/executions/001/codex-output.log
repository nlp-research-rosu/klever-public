index 0000000000000000000000000000000000000000..45b2729579112dc38f265b496c84cf2a3bbaa19d
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,148 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+  imports BOOL-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Stmts  ::= List{Stmt, ""}
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" String ")"
+  syntax Exprs  ::= List{Expr, ","}
+  syntax CmpOps ::= List{CmpOp, ","}
+
+  syntax Value ::= "Str" "(" String ")"
+                 | "Int" "(" Int ")"
+                 | "Bool" "(" Bool ")"
+                 | "NoneVal"
+  syntax Expr ::= Value
+                | "Name" "(" String ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "ListExpr" "(" Exprs ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+endmodule
+
+module MPY-SEMANTIC
