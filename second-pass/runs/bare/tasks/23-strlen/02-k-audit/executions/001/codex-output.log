@@ -0,0 +1,16 @@
+requires "verification.k"
+
+module STAGE5-TOTALITY-PROBE
+  imports VERIFICATION
+
+  // The declared [total] domain is Value x Value, but no equation covers this.
+  claim <py>
+          <k>
+            strlenPost(Str("x"), Str("y"))
+            => strlenPost(Str("x"), Int(1))
+          </k>
+          <functions> .Map </functions>
+          <locals> .Map </locals>
+          <result> noResult </result>
+        </py>
+endmodule

exec
/bin/bash -lc 'cp /audit-output/evidence/stage5-totality-probe.k /tmp/audit-work/reconstruction/stage5-totality-probe.k
set +e
/audit-output/evidence/run_logged.sh /audit-output/evidence/stage5-totality-probe.log kprove stage5-totality-probe.k --definition verification-haskell-kompiled --spec-module STAGE5-TOTALITY-PROBE
status=$?
printf '"'probe_status=%s\\n' \""'$status"
sed -n '"'1,300p' /audit-output/evidence/stage5-totality-probe.log" in /tmp/audit-work/reconstruction
