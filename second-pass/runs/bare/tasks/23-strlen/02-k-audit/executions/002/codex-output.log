+    print(f"total_cases={len(cases)} mismatches={len(mismatches)}")
+    for index, value in enumerate(fixed):
+        print(
+            f"fixed[{index}]={value!r} "
+            f"canonical={canonical(value)} generated={generated(value)}"
+        )
