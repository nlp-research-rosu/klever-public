+from pathlib import Path
+
+
+TRUSTED = Path("/reference/canonical.py")
+GENERATED = Path("/tmp/audit-work/23-strlen.30KKVy/work/solution.py")
+SEED = 230023
+
+
+def load_entry(module_name: str, path: Path):
