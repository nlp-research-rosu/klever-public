+    generated = load_entry("generated_solution_strlen", GENERATED)
+    fixed = [
+        "",
+        "a",
+        "abc",
+        " ",
+        "\x00",
+        "\n",
+        "\"'\\",
+        "é",
+        "e\u0301",
+        "😀",
+        "a😀é",
+        "👩\u200d💻",
+        "\ud800",
+        "a" * 4096,
+    ]
+    alphabet = [
+        "a",
+        "Z",
+        "0",
+        " ",
+        "\x00",
+        "\n",
+        "é",
+        "\u0301",
+        "😀",
+        "\u200d",
+    ]
+    rng = random.Random(SEED)
+    generated_cases = [
+        "".join(rng.choice(alphabet) for _ in range(rng.randrange(0, 129)))
