+  claim <py>
+          <k>
+            Module(
+              FuncDef(
+                "strlen",
+                Params("string"),
+                Return(Call(Name("len"), Name("string")))
+              )
+            )
+            ~> invoke("strlen", Str(S))
+            => .K
