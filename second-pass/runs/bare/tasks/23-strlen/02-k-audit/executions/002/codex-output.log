+    for name in proof_artifacts:
+        require_regular(Path("/candidate") / name)
+        print(f"OK candidate proof artifact /candidate/{name}")
+
+    print("INTEGRITY CHECKS PASSED")
+
+
+if __name__ == "__main__":
+    main()
