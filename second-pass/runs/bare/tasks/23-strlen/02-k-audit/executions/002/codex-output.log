+#!/usr/bin/env python3
+"""Run the rebuilt generated semantics and compare each result with Python."""
+
+from __future__ import annotations
+
+import json
+import re
+import shlex
+import subprocess
+from pathlib import Path
+
+
+WORK = Path("/tmp/audit-work/23-strlen.30KKVy/work")
