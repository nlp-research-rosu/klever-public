diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..fc48ea33c4fec9284046855061cd136d0b227967
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX
+
+krun solution.mpy \
+  --definition verification-kompiled \
+  --config-var INPUT=''
+krun solution.mpy \
+  --definition verification-kompiled \
+  --config-var INPUT=abc
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..e6f03eb7125ab499c49e2a0fb200cdb94b444f22
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,59 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  // The concrete constructors emitted by py2mpy.py for this solution.
+  syntax Pgm ::= "Module" "(" Stmt ")"
+
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmt ")"
+                | "Return" "(" Expr ")"
+
+  syntax Params ::= "Params" "(" String ")"
+
+  syntax Expr ::= Value
+                | "Name" "(" String ")"
+                | "Call" "(" Expr "," Expr ")"
+
+  syntax Value ::= "Str" "(" String ")"
+                 | "Int" "(" Int ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports MAP
+
+  syntax KItem ::= "invoke" "(" String "," Value ")"
+                 | "callLen"
+                 | "finishReturn"
+  syntax Function ::= "function" "(" String "," Stmt ")"
+  syntax Result ::= "noResult" | Value
+
+  configuration
+    <py>
+      <k> $PGM:Pgm ~> invoke("strlen", Str($INPUT:String)) </k>
+      <functions> .Map </functions>
+      <locals> .Map </locals>
+      <result> noResult </result>
+    </py>
+
+  // Loading a module installs its top-level function definition.
+  rule <k> Module(S:Stmt) => S ... </k>
+  rule <k> FuncDef(F, Params(P), BODY) => .K ... </k>
+       <functions> FUNCTIONS => FUNCTIONS [ F <- function(P, BODY) ] </functions>
+
+  // Calling a user function binds its sole formal parameter.
+  rule <k> invoke(F, V) => BODY ... </k>
+       <functions> ... F |-> function(P, BODY) ... </functions>
+       <locals> _ => P |-> V </locals>
+
+  // Expressions needed by strlen.
+  rule <k> Name(X) => V ... </k>
+       <locals> ... X |-> V ... </locals>
+  rule <k> Call(Name("len"), E) => E ~> callLen ... </k>
+  rule <k> Str(S) ~> callLen => Int(lengthString(S)) ... </k>
+
+  // A return evaluates its expression, then exposes the value as the result.
+  rule <k> Return(E) => E ~> finishReturn ... </k>
+  rule <k> V:Value ~> finishReturn => .K ... </k>
+       <result> _ => V </result>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..32311f6d8da1eea3362cbb9f497d6cd88e910cca
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,2 @@
+def strlen(string: str) -> int:
+    return len(string)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..05a1aa20d17160599d9c06d440e733aaa055a616
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,32 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The translated program returns the mathematical length for every string.
+  claim <py>
+          <k>
+            Module(
+              FuncDef(
+                "strlen",
+                Params("string"),
+                Return(Call(Name("len"), Name("string")))
+              )
+            )
+            ~> invoke("strlen", Str(S))
+            => .K
+          </k>
+          <functions>
+            .Map
+            => "strlen" |-> function(
+                 "string",
+                 Return(Call(Name("len"), Name("string")))
+               )
+          </functions>
+          <locals> .Map => "string" |-> Str(S) </locals>
+          <result> noResult => Int(lengthString(S)) </result>
+        </py>
+
+  // State the same result through the explicit contract predicate.
+  claim strlenPost(Str(S), Int(lengthString(S))) => true
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9ea5b2dee090193768cd069d473841cb4d807d2a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,9 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Executable form of the HumanEval postcondition.
+  syntax Bool ::= "strlenPost" "(" Value "," Value ")" [function, total]
+  rule strlenPost(Str(S), Int(N)) => N ==Int lengthString(S)
+endmodule

exec
/bin/bash -lc "readlink -f /usr/bin/kompile && python3 - <<'PY'
import pyk, os
