new file mode 100644
index 0000000000000000000000000000000000000000..9ea5b2dee090193768cd069d473841cb4d807d2a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,9 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Executable form of the HumanEval postcondition.
+  syntax Bool ::= "strlenPost" "(" Value "," Value ")" [function, total]
+  rule strlenPost(Str(S), Int(N)) => N ==Int lengthString(S)
+endmodule

