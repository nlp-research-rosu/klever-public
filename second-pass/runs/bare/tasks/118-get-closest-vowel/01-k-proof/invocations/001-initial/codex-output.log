+  rule litChar("e") => v_e
+  rule litChar("i") => v_i
+  rule litChar("o") => v_o
+  rule litChar("u") => v_u
+  rule litChar("A") => v_A
+  rule litChar("E") => v_E
+  rule litChar("I") => v_I
+  rule litChar("O") => v_O
+  rule litChar("U") => v_U
