+            => answer(closestSpec(snoc(snoc(snoc(P, D), con(A)), V))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+endmodule
