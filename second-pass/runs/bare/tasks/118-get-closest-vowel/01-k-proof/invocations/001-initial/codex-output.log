        if word[i] in vowels and word[i - 1] not in vowels and word[i + 1] not in vowels:
            return word[i]
    return \"\"
for n in range(8):
    for chars in product(alphabet, repeat=n):
        word = \"\".join(chars)
        assert get_closest_vowel(word) == oracle(word), word
print(\"Python exhaustive category test: passed\")
PY
