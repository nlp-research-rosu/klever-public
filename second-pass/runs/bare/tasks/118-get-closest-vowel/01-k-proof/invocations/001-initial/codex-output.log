new file mode 100644
index 0000000000000000000000000000000000000000..a3094dbe41d873b23d54213ac9c60100a942604a
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,232 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports BOOL-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  // The constructor language emitted by py2mpy.py (restricted here to the
+  // nodes used by solution.mpy).
+  syntax Module ::= "Module" "(" Stmts ")"                 [symbol]
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol]
+                | "Assign" "(" Expr "," Expr ")"            [symbol]
+                | "If" "(" Expr "," Stmts "," Stmts ")"     [symbol]
+                | "Return" "(" Expr ")"                     [symbol]
+  syntax Params ::= "Params" "(" ParamNames ")"             [symbol]
+  syntax ParamNames ::= List{String, ","}
+
+  syntax Expr ::= "Name" "(" String ")"                     [symbol]
+                | "Str" "(" String ")"                      [symbol]
+                | "Int" "(" Int ")"                         [symbol]
+                | "Call" "(" Expr "," Exprs ")"            [symbol]
+                | "Compare" "(" Expr "," CmpOps ")"        [symbol]
+                | "CmpOp" "(" String "," Expr ")"          [symbol]
+                | "UnaryOp" "(" String "," Expr ")"        [symbol]
+                | "Subscript" "(" Expr "," Index ")"       [symbol]
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{Expr, ","}
+  syntax Index ::= Expr | Slice
+  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")" [symbol]
+  syntax Bound ::= Expr | "NoBound"                           [symbol]
+
+  // Runtime values.  Chars is a snoc-list, making Python's negative string
+  // indices and removal of the last character structural operations.
+  syntax Vowel ::= "v_a" | "v_e" | "v_i" | "v_o" | "v_u"
+                 | "v_A" | "v_E" | "v_I" | "v_O" | "v_U"
+  syntax Char ::= Vowel | "con" "(" String ")"
+  syntax Chars ::= ".Chars" | "snoc" "(" Chars "," Char ")" | "VOWELS"
+  syntax Nat ::= "z" | "s" "(" Nat ")"
+  syntax Val ::= "pyStr" "(" Chars ")"
+               | "pyNat" "(" Nat ")"
+               | "pyNeg" "(" Nat ")"
+               | "pyBool" "(" Bool ")"
+               | "word" "(" String ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports VERIFICATION
+  imports BOOL
+  imports INT
+  imports STRING
+  imports MAP
+  imports LIST
+
+  configuration
+    <T>
+      <k> start($ARG:Val) </k>
+      <program> $PGM:Module </program>
+      <env> .Map </env>
+      <stack> .List </stack>
+    </T>
+
+  syntax KItem ::= "start" "(" Val ")"
+                 | "invoke" "(" String "," Val ")"
+                 | "execMachine" "(" Stmts ")"
+                 | "doStmt" "(" Stmt ")"
+                 | "returning" "(" Expr ")"
+                 | "branch" "(" Bool "," Stmts "," Stmts ")"
+  syntax Frame ::= "frame" "(" K "," Map ")"
+  syntax KItem ::= Frame
+  syntax ExecResult ::= "normal" "(" Map ")" | "returned" "(" Val ")"
+
+  syntax Val ::= normalize(Val)                              [function]
+  rule normalize(word(S)) => pyStr(litChars(S))
+  rule normalize(V:Val) => V                                 [owise]
+
+  rule <k> start(V) => invoke("get_closest_vowel", normalize(V)) ... </k>
+
+  // Explicit call states expose recursive calls to kprove.  A frame records
+  // the caller continuation and environment; reaching a value restores both.
+  rule <k> invoke(F, V) ~> K => execMachine(functionBody(M, F)) </k>
+       <program> M </program>
+       <env> ENV => functionEnv(M, F, V) </env>
+       <stack> STACK => ListItem(frame(K, ENV)) STACK </stack>
+
+  rule <k> V:Val => V ~> K </k>
+       <env> _ENV => OLDENV </env>
+       <stack> ListItem(frame(K, OLDENV)) REST => REST </stack>
+
+  rule execMachine(.Stmts) => .K
+  rule execMachine(S:Stmt REST:Stmts) => doStmt(S) ~> execMachine(REST)
+  rule <k> doStmt(Assign(Name(X), E)) => .K ... </k>
+       <program> M </program>
+       <env> ENV => ENV [ X <- eval(E, ENV, M) ] </env>
+  rule <k> doStmt(If(COND, THEN, ELSE))
+            => branch(asBool(eval(COND, ENV, M)), THEN, ELSE) ... </k>
+       <program> M </program>
+       <env> ENV </env>
+  rule branch(true, THEN, ELSE) => execMachine(THEN)
+  rule branch(false, THEN, ELSE) => execMachine(ELSE)
+  rule <k> doStmt(Return(E)) ~> _REST => returning(E) </k>
+  rule <k> returning(Call(Name(F), A:Expr, .Exprs))
+            => invoke(F, eval(A, ENV, M)) ... </k>
+       <program> M </program>
+       <env> ENV </env>
+  rule <k> returning(E) => eval(E, ENV, M) ... </k>
+       <program> M </program>
+       <env> ENV </env> [owise]
+
+  // Big-step helpers give meaning to pure expressions and are also useful as
+  // an executable reference layer.  Program calls in Return are handled by
+  // the explicit machine rule above.
+  syntax Val ::= call(Module, String, Val)                    [function]
+  rule call(M:Module, F,
+            V) => returnValue(exec(functionBody(M, F),
+                                    functionEnv(M, F, V), M))
+
+  syntax Stmts ::= functionBody(Module, String)               [function]
+  rule functionBody(Module(FuncDef(F, Params(X:String, .ParamNames), BODY)), F)
+    => BODY
+
+  syntax Map ::= functionEnv(Module, String, Val)             [function]
+  rule functionEnv(Module(FuncDef(F, Params(X:String, .ParamNames), BODY)), F, V)
+    => X |-> V
+
+  syntax Val ::= returnValue(ExecResult)                      [function]
+  rule returnValue(returned(V)) => V
+
+  syntax ExecResult ::= exec(Stmts, Map, Module)              [function]
+                      | execRest(ExecResult, Stmts, Module)   [function]
+                      | execStmt(Stmt, Map, Module)           [function]
+                      | choose(Bool, Stmts, Stmts, Map, Module) [function]
+  rule exec(.Stmts, ENV, M) => normal(ENV)
+  rule exec(S:Stmt REST:Stmts, ENV, M)
+    => execRest(execStmt(S, ENV, M), REST, M)
+  rule execRest(normal(ENV), REST, M) => exec(REST, ENV, M)
+  rule execRest(returned(V), REST, M) => returned(V)
+
+  rule execStmt(Assign(Name(X), E), ENV, M)
+    => normal(ENV [ X <- eval(E, ENV, M) ])
+  rule execStmt(If(COND, THEN, ELSE), ENV, M)
+    => choose(asBool(eval(COND, ENV, M)), THEN, ELSE, ENV, M)
+  rule execStmt(Return(E), ENV, M) => returned(eval(E, ENV, M))
+  rule choose(true,  THEN, ELSE, ENV, M) => exec(THEN, ENV, M)
+  rule choose(false, THEN, ELSE, ENV, M) => exec(ELSE, ENV, M)
+
+  // Expressions needed by the submitted Python program.
+  syntax Val ::= eval(Expr, Map, Module)                       [function]
+               | evalCompare(String, Val, Val)                [function]
+               | evalUnary(String, Val)                       [function]
+               | evalIndex(Val, Val)                          [function]
+               | evalSliceLast(Val)                           [function]
+  syntax Bool ::= asBool(Val)                                 [function]
+
+  syntax Val ::= lookupVal(Map, String)                        [function]
+  rule lookupVal((X |-> V:Val) REST, X) => V
+  rule eval(Name(X), ENV, M) => lookupVal(ENV, X)
+  rule eval(Str(S), ENV, M) => pyStr(litChars(S))
+  rule eval(Int(I), ENV, M) => pyNat(intNat(I)) requires I >=Int 0
+  rule eval(Call(Name("len"), A:Expr, .Exprs), ENV, M)
+    => pyNat(lenChars(asChars(eval(A, ENV, M))))
+  rule eval(Call(Name(F), A:Expr, .Exprs), ENV, M)
+    => call(M, F, eval(A, ENV, M)) requires F =/=String "len"
+  rule eval(Compare(L, CmpOp(OP, R), .CmpOps), ENV, M)
+    => evalCompare(OP, eval(L, ENV, M), eval(R, ENV, M))
+  rule eval(UnaryOp(OP, E), ENV, M) => evalUnary(OP, eval(E, ENV, M))
+  rule eval(Subscript(S, I:Expr), ENV, M)
+    => evalIndex(eval(S, ENV, M), eval(I, ENV, M))
+  rule eval(Subscript(S, Slice(NoBound, UnaryOp("-", Int(1)), NoBound)), ENV, M)
+    => evalSliceLast(eval(S, ENV, M))
+
+  rule evalCompare("<", pyNat(A), pyNat(B)) => pyBool(natLt(A, B))
+  rule evalCompare("in", pyStr(snoc(.Chars, C)), pyStr(HAY))
+    => pyBool(charIn(C, HAY))
+  rule evalCompare("not in", pyStr(snoc(.Chars, C)), pyStr(HAY))
+    => pyBool(notBool charIn(C, HAY))
+  rule evalUnary("-", pyNat(N)) => pyNeg(N)
+  rule evalIndex(pyStr(CS), pyNeg(N)) => fromEnd(CS, N)
+  rule evalSliceLast(pyStr(snoc(CS, C))) => pyStr(CS)
+  rule asBool(pyBool(B)) => B
+
+  // Literal conversion is part of the semantics, not the Python-to-AST
+  // translator.  Inputs supplied as word("...") use this same conversion.
+  syntax Chars ::= litChars(String)                            [function]
+  syntax Char ::= litChar(String)                             [function]
+  rule litChars("") => .Chars
+  rule litChars("aeiouAEIOU") => VOWELS
+  rule litChars(S) => snoc(litChars(substrString(S, 0,
+                                  lengthString(S) -Int 1)),
+                            litChar(substrString(S, lengthString(S) -Int 1,
+                                                   lengthString(S))))
+    requires lengthString(S) >Int 0
+     andBool S =/=String "aeiouAEIOU"
+  rule litChar("a") => v_a
+  rule litChar("e") => v_e
+  rule litChar("i") => v_i
+  rule litChar("o") => v_o
+  rule litChar("u") => v_u
+  rule litChar("A") => v_A
+  rule litChar("E") => v_E
+  rule litChar("I") => v_I
+  rule litChar("O") => v_O
+  rule litChar("U") => v_U
+  rule litChar(S) => con(S)                                  [owise]
+
+  syntax Nat ::= intNat(Int)                                  [function]
+  syntax Nat ::= lenChars(Chars)                              [function]
+  rule intNat(0) => z
+  rule intNat(1) => s(z)
+  rule intNat(2) => s(s(z))
+  rule intNat(3) => s(s(s(z)))
+  rule intNat(I) => s(intNat(I -Int 1)) requires I >Int 0
+  rule lenChars(.Chars) => z
+  rule lenChars(snoc(CS, C)) => s(lenChars(CS))
+
+  syntax Chars ::= asChars(Val)                               [function]
+  rule asChars(pyStr(CS)) => CS
+
+  syntax Bool ::= natLt(Nat, Nat)                             [function]
+  rule natLt(A, z) => false
+  rule natLt(z, s(B)) => true
+  rule natLt(s(A), s(B)) => natLt(A, B)
+
+  syntax Val ::= fromEnd(Chars, Nat)                          [function]
+  rule fromEnd(snoc(CS, C), s(z)) => pyStr(snoc(.Chars, C))
+  rule fromEnd(snoc(CS, C), s(s(N))) => fromEnd(CS, s(N))
+
+  syntax Bool ::= charIn(Char, Chars)                         [function]
+  rule charIn(V:Vowel, VOWELS) => true
+  rule charIn(con(S), VOWELS) => false
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..f26429f000a131554241de99d83f46b03771df33
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def get_closest_vowel(word):
+    vowels = "aeiouAEIOU"
+    if len(word) < 3:
+        return ""
+    if word[-2] in vowels:
+        if word[-3] not in vowels:
+            if word[-1] not in vowels:
+                return word[-2]
+    return get_closest_vowel(word[:-1])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..13a24053aecd77ba83489ebf8a2e49115da2e205
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,127 @@
+requires "semantic.k"
+
+module SPEC
+  imports MPY
+
+  // Every claim describes a complete function call: it preserves the caller's
+  // continuation, environment, and stack.  The cases are exhaustive for the
+  // recursive Chars datatype (vowels and consonants partition Char).
+
+  claim <T>
+          <k> invoke("get_closest_vowel", pyStr(.Chars)) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel", pyStr(snoc(.Chars, A:Char))) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(.Chars, A:Char), B:Char))) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // The rightmost triple is consonant-vowel-consonant.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(P:Chars, con(A:String)), V:Vowel),
+                                con(C:String)))) ~> KREST:K
+            => pyStr(snoc(.Chars, V)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 1: its middle character is a consonant.  The base
+  // case and three predecessor-window shapes form structural induction cases.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, A:Char), con(B:String)),
+                                C:Char))) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Char), con(A:String)),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, D), con(A)), con(B))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Vowel), A:Vowel),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, D), A), con(B))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, con(D:String)), A:Vowel),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, con(D)), A), con(B))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 2: its left and middle characters are vowels.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, V1:Vowel), V2:Vowel),
+                                C:Char))) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Vowel), V1:Vowel),
+                                     V2:Vowel), C:Char))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, D), V1), V2)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, con(D:String)), V1:Vowel),
+                                     V2:Vowel), C:Char))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, con(D)), V1), V2)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 3: its left character is a consonant and both
+  // following characters are vowels.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, con(A:String)), V:Vowel),
+                                V2:Vowel))) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Char), con(A:String)),
+                                     V:Vowel), V2:Vowel))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, D), con(A)), V)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..91b81228932c65925bdab86a88e95cfcd4289882
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,46 @@
+module VERIFICATION
+  imports MPY-SYNTAX
+  imports BOOL
+
+  // A direct mathematical reading of the contract.  Looking from the right,
+  // a word shorter than three characters has no eligible position.  Otherwise
+  // inspect its last three characters: return the middle one exactly when it
+  // is a vowel bracketed by consonants, or continue with the final character
+  // removed.  This definition is independent of the evaluator below.
+  syntax Val ::= closestSpec(Chars)                           [function]
+  rule closestSpec(.Chars) => pyStr(.Chars)
+  rule closestSpec(snoc(.Chars, A)) => pyStr(.Chars)
+  rule closestSpec(snoc(snoc(.Chars, A), B)) => pyStr(.Chars)
+  rule closestSpec(snoc(snoc(snoc(P, con(A)), V:Vowel), con(C)))
+    => pyStr(snoc(.Chars, V))
+  rule closestSpec(snoc(snoc(snoc(P, A), con(B)), C))
+    => closestSpec(snoc(snoc(P, A), con(B)))
+  rule closestSpec(snoc(snoc(snoc(P, V1:Vowel), V2:Vowel), C))
+    => closestSpec(snoc(snoc(P, V1), V2))
+  rule closestSpec(snoc(snoc(snoc(P, con(A)), V:Vowel), V2:Vowel))
+    => closestSpec(snoc(snoc(P, con(A)), V))
+
+  // A closed constructor term for the submitted solution.  Proof claims use
+  // this exact AST, while krun separately parses solution.mpy itself.
+  syntax Module ::= "solutionProgram"                        [function]
+  rule solutionProgram =>
+    Module(
+      FuncDef("get_closest_vowel", Params("word"),
+        Assign(Name("vowels"), Str("aeiouAEIOU"))
+        If(Compare(Call(Name("len"), Name("word")), CmpOp("<", Int(3))),
+          Return(Str("")),
+          .Stmts)
+        If(Compare(Subscript(Name("word"), UnaryOp("-", Int(2))),
+                   CmpOp("in", Name("vowels"))),
+          If(Compare(Subscript(Name("word"), UnaryOp("-", Int(3))),
+                     CmpOp("not in", Name("vowels"))),
+            If(Compare(Subscript(Name("word"), UnaryOp("-", Int(1))),
+                       CmpOp("not in", Name("vowels"))),
+              Return(Subscript(Name("word"), UnaryOp("-", Int(2)))),
+              .Stmts),
+            .Stmts),
+          .Stmts)
+        Return(Call(Name("get_closest_vowel"),
+                    Subscript(Name("word"),
+                      Slice(NoBound, UnaryOp("-", Int(1)), NoBound))))))
+endmodule

apply patch
patch: completed
/work/semantic.k
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..7927b57319fd398df9d17fa5f3ec7d9103a59b47
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,238 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports BOOL-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  // The constructor language emitted by py2mpy.py (restricted here to the
+  // nodes used by solution.mpy).
+  syntax Module ::= "Module" "(" Stmts ")"                 [symbol]
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol]
+                | "Assign" "(" Expr "," Expr ")"            [symbol]
+                | "If" "(" Expr "," Stmts "," Stmts ")"     [symbol]
+                | "Return" "(" Expr ")"                     [symbol]
+  syntax Params ::= "Params" "(" ParamNames ")"             [symbol]
+  syntax ParamNames ::= List{String, ","}
+
+  syntax Expr ::= "Name" "(" String ")"                     [symbol]
+                | "Str" "(" String ")"                      [symbol]
+                | "Int" "(" Int ")"                         [symbol]
+                | "Call" "(" Expr "," Exprs ")"            [symbol]
+                | "Compare" "(" Expr "," CmpOps ")"        [symbol]
+                | "CmpOp" "(" String "," Expr ")"          [symbol]
+                | "UnaryOp" "(" String "," Expr ")"        [symbol]
+                | "Subscript" "(" Expr "," Index ")"       [symbol]
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{Expr, ","}
+  syntax Index ::= Expr | Slice
+  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")" [symbol]
+  syntax Bound ::= Expr | "NoBound"                           [symbol]
+
+  // Runtime values.  Chars is a snoc-list, making Python's negative string
+  // indices and removal of the last character structural operations.
+  syntax Vowel ::= "v_a" | "v_e" | "v_i" | "v_o" | "v_u"
+                 | "v_A" | "v_E" | "v_I" | "v_O" | "v_U"
+  syntax Char ::= Vowel | "con" "(" String ")"
+  syntax Chars ::= ".Chars" | "snoc" "(" Chars "," Char ")" | "VOWELS"
+  syntax Nat ::= "z" | "s" "(" Nat ")"
+  syntax Val ::= "pyStr" "(" Chars ")"
+               | "pyNat" "(" Nat ")"
+               | "pyNeg" "(" Nat ")"
+               | "pyBool" "(" Bool ")"
+               | "word" "(" String ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports VERIFICATION
+  imports BOOL
+  imports INT
+  imports STRING
+  imports MAP
+  imports LIST
+
+  configuration
+    <T>
+      <k> start($ARG:Val) </k>
+      <program> $PGM:Module </program>
+      <env> .Map </env>
+      <stack> .List </stack>
+    </T>
+
+  syntax KItem ::= "start" "(" Val ")"
+                 | "invoke" "(" String "," Val ")"
+                 | "execMachine" "(" Stmts ")"
+                 | "doStmt" "(" Stmt ")"
+                 | "returning" "(" Expr ")"
+                 | "branch" "(" Bool "," Stmts "," Stmts ")"
+                 | "answer" "(" Val ")"
+                 | "unwrap"
+  syntax Frame ::= "frame" "(" K "," Map ")"
+  syntax KItem ::= Frame
+  syntax ExecResult ::= "normal" "(" Map ")" | "returned" "(" Val ")"
+
+  syntax Val ::= normalize(Val)                              [function]
+  rule normalize(word(S)) => pyStr(litChars(S))
+  rule normalize(V:Val) => V                                 [owise]
+
+  rule <k> start(V) => invoke("get_closest_vowel", normalize(V)) ~> unwrap ... </k>
+
+  // Explicit call states expose recursive calls to kprove.  A frame records
+  // the caller continuation and environment; reaching a value restores both.
+  rule <k> invoke(F, V) ~> K => execMachine(functionBody(M, F)) </k>
+       <program> M </program>
+       <env> ENV => functionEnv(M, F, V) </env>
+       <stack> STACK => ListItem(frame(K, ENV)) STACK </stack>
+
+  rule <k> V:Val => answer(V) ~> K </k>
+       <env> _ENV => OLDENV </env>
+       <stack> ListItem(frame(K, OLDENV)) REST => REST </stack>
+  rule <k> answer(V) => answer(V) ~> K </k>
+       <env> _ENV => OLDENV </env>
+       <stack> ListItem(frame(K, OLDENV)) REST => REST </stack>
+  rule answer(V) ~> unwrap => V
+
+  rule execMachine(.Stmts) => .K
+  rule execMachine(S:Stmt REST:Stmts) => doStmt(S) ~> execMachine(REST)
+  rule <k> doStmt(Assign(Name(X), E)) => .K ... </k>
+       <program> M </program>
+       <env> ENV => ENV [ X <- eval(E, ENV, M) ] </env>
+  rule <k> doStmt(If(COND, THEN, ELSE))
+            => branch(asBool(eval(COND, ENV, M)), THEN, ELSE) ... </k>
+       <program> M </program>
+       <env> ENV </env>
+  rule branch(true, THEN, ELSE) => execMachine(THEN)
+  rule branch(false, THEN, ELSE) => execMachine(ELSE)
+  rule <k> doStmt(Return(E)) ~> _REST => returning(E) </k>
+  rule <k> returning(Call(Name(F), A:Expr, .Exprs))
+            => invoke(F, eval(A, ENV, M)) ... </k>
+       <program> M </program>
+       <env> ENV </env>
+  rule <k> returning(E) => eval(E, ENV, M) ... </k>
+       <program> M </program>
+       <env> ENV </env> [owise]
+
+  // Big-step helpers give meaning to pure expressions and are also useful as
+  // an executable reference layer.  Program calls in Return are handled by
+  // the explicit machine rule above.
+  syntax Val ::= call(Module, String, Val)                    [function]
+  rule call(M:Module, F,
+            V) => returnValue(exec(functionBody(M, F),
+                                    functionEnv(M, F, V), M))
+
+  syntax Stmts ::= functionBody(Module, String)               [function]
+  rule functionBody(Module(FuncDef(F, Params(X:String, .ParamNames), BODY)), F)
+    => BODY
+
+  syntax Map ::= functionEnv(Module, String, Val)             [function]
+  rule functionEnv(Module(FuncDef(F, Params(X:String, .ParamNames), BODY)), F, V)
+    => X |-> V
+
+  syntax Val ::= returnValue(ExecResult)                      [function]
+  rule returnValue(returned(V)) => V
+
+  syntax ExecResult ::= exec(Stmts, Map, Module)              [function]
+                      | execRest(ExecResult, Stmts, Module)   [function]
+                      | execStmt(Stmt, Map, Module)           [function]
+                      | choose(Bool, Stmts, Stmts, Map, Module) [function]
+  rule exec(.Stmts, ENV, M) => normal(ENV)
+  rule exec(S:Stmt REST:Stmts, ENV, M)
+    => execRest(execStmt(S, ENV, M), REST, M)
+  rule execRest(normal(ENV), REST, M) => exec(REST, ENV, M)
+  rule execRest(returned(V), REST, M) => returned(V)
+
+  rule execStmt(Assign(Name(X), E), ENV, M)
+    => normal(ENV [ X <- eval(E, ENV, M) ])
+  rule execStmt(If(COND, THEN, ELSE), ENV, M)
+    => choose(asBool(eval(COND, ENV, M)), THEN, ELSE, ENV, M)
+  rule execStmt(Return(E), ENV, M) => returned(eval(E, ENV, M))
+  rule choose(true,  THEN, ELSE, ENV, M) => exec(THEN, ENV, M)
+  rule choose(false, THEN, ELSE, ENV, M) => exec(ELSE, ENV, M)
+
+  // Expressions needed by the submitted Python program.
+  syntax Val ::= eval(Expr, Map, Module)                       [function]
+               | evalCompare(String, Val, Val)                [function]
+               | evalUnary(String, Val)                       [function]
+               | evalIndex(Val, Val)                          [function]
+               | evalSliceLast(Val)                           [function]
+  syntax Bool ::= asBool(Val)                                 [function]
+
+  syntax Val ::= lookupVal(Map, String)                        [function]
+  rule lookupVal((X |-> V:Val) REST, X) => V
+  rule eval(Name(X), ENV, M) => lookupVal(ENV, X)
+  rule eval(Str(S), ENV, M) => pyStr(litChars(S))
+  rule eval(Int(I), ENV, M) => pyNat(intNat(I)) requires I >=Int 0
+  rule eval(Call(Name("len"), A:Expr, .Exprs), ENV, M)
+    => pyNat(lenChars(asChars(eval(A, ENV, M))))
+  rule eval(Call(Name(F), A:Expr, .Exprs), ENV, M)
+    => call(M, F, eval(A, ENV, M)) requires F =/=String "len"
+  rule eval(Compare(L, CmpOp(OP, R), .CmpOps), ENV, M)
+    => evalCompare(OP, eval(L, ENV, M), eval(R, ENV, M))
+  rule eval(UnaryOp(OP, E), ENV, M) => evalUnary(OP, eval(E, ENV, M))
+  rule eval(Subscript(S, I:Expr), ENV, M)
+    => evalIndex(eval(S, ENV, M), eval(I, ENV, M))
+  rule eval(Subscript(S, Slice(NoBound, UnaryOp("-", Int(1)), NoBound)), ENV, M)
+    => evalSliceLast(eval(S, ENV, M))
+
+  rule evalCompare("<", pyNat(A), pyNat(B)) => pyBool(natLt(A, B))
+  rule evalCompare("in", pyStr(snoc(.Chars, C)), pyStr(HAY))
+    => pyBool(charIn(C, HAY))
+  rule evalCompare("not in", pyStr(snoc(.Chars, C)), pyStr(HAY))
+    => pyBool(notBool charIn(C, HAY))
+  rule evalUnary("-", pyNat(N)) => pyNeg(N)
+  rule evalIndex(pyStr(CS), pyNeg(N)) => fromEnd(CS, N)
+  rule evalSliceLast(pyStr(snoc(CS, C))) => pyStr(CS)
+  rule asBool(pyBool(B)) => B
+
+  // Literal conversion is part of the semantics, not the Python-to-AST
+  // translator.  Inputs supplied as word("...") use this same conversion.
+  syntax Chars ::= litChars(String)                            [function]
+  syntax Char ::= litChar(String)                             [function]
+  rule litChars("") => .Chars
+  rule litChars("aeiouAEIOU") => VOWELS
+  rule litChars(S) => snoc(litChars(substrString(S, 0,
+                                  lengthString(S) -Int 1)),
+                            litChar(substrString(S, lengthString(S) -Int 1,
+                                                   lengthString(S))))
+    requires lengthString(S) >Int 0
+     andBool S =/=String "aeiouAEIOU"
+  rule litChar("a") => v_a
+  rule litChar("e") => v_e
+  rule litChar("i") => v_i
+  rule litChar("o") => v_o
+  rule litChar("u") => v_u
+  rule litChar("A") => v_A
+  rule litChar("E") => v_E
+  rule litChar("I") => v_I
+  rule litChar("O") => v_O
+  rule litChar("U") => v_U
+  rule litChar(S) => con(S)                                  [owise]
+
+  syntax Nat ::= intNat(Int)                                  [function]
+  syntax Nat ::= lenChars(Chars)                              [function]
+  rule intNat(0) => z
+  rule intNat(1) => s(z)
+  rule intNat(2) => s(s(z))
+  rule intNat(3) => s(s(s(z)))
+  rule intNat(I) => s(intNat(I -Int 1)) requires I >Int 0
+  rule lenChars(.Chars) => z
+  rule lenChars(snoc(CS, C)) => s(lenChars(CS))
+
+  syntax Chars ::= asChars(Val)                               [function]
+  rule asChars(pyStr(CS)) => CS
+
+  syntax Bool ::= natLt(Nat, Nat)                             [function]
+  rule natLt(A, z) => false
+  rule natLt(z, s(B)) => true
+  rule natLt(s(A), s(B)) => natLt(A, B)
+
+  syntax Val ::= fromEnd(Chars, Nat)                          [function]
+  rule fromEnd(snoc(CS, C), s(z)) => pyStr(snoc(.Chars, C))
+  rule fromEnd(snoc(CS, C), s(s(N))) => fromEnd(CS, s(N))
+
+  syntax Bool ::= charIn(Char, Chars)                         [function]
+  rule charIn(V:Vowel, VOWELS) => true
+  rule charIn(con(S), VOWELS) => false
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..f26429f000a131554241de99d83f46b03771df33
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def get_closest_vowel(word):
+    vowels = "aeiouAEIOU"
+    if len(word) < 3:
+        return ""
+    if word[-2] in vowels:
+        if word[-3] not in vowels:
+            if word[-1] not in vowels:
+                return word[-2]
+    return get_closest_vowel(word[:-1])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..13a24053aecd77ba83489ebf8a2e49115da2e205
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,127 @@
+requires "semantic.k"
+
+module SPEC
+  imports MPY
+
+  // Every claim describes a complete function call: it preserves the caller's
+  // continuation, environment, and stack.  The cases are exhaustive for the
+  // recursive Chars datatype (vowels and consonants partition Char).
+
+  claim <T>
+          <k> invoke("get_closest_vowel", pyStr(.Chars)) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel", pyStr(snoc(.Chars, A:Char))) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(.Chars, A:Char), B:Char))) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // The rightmost triple is consonant-vowel-consonant.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(P:Chars, con(A:String)), V:Vowel),
+                                con(C:String)))) ~> KREST:K
+            => pyStr(snoc(.Chars, V)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 1: its middle character is a consonant.  The base
+  // case and three predecessor-window shapes form structural induction cases.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, A:Char), con(B:String)),
+                                C:Char))) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Char), con(A:String)),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, D), con(A)), con(B))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Vowel), A:Vowel),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, D), A), con(B))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, con(D:String)), A:Vowel),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, con(D)), A), con(B))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 2: its left and middle characters are vowels.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, V1:Vowel), V2:Vowel),
+                                C:Char))) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Vowel), V1:Vowel),
+                                     V2:Vowel), C:Char))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, D), V1), V2)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, con(D:String)), V1:Vowel),
+                                     V2:Vowel), C:Char))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, con(D)), V1), V2)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 3: its left character is a consonant and both
+  // following characters are vowels.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, con(A:String)), V:Vowel),
+                                V2:Vowel))) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Char), con(A:String)),
+                                     V:Vowel), V2:Vowel))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, D), con(A)), V)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..91b81228932c65925bdab86a88e95cfcd4289882
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,46 @@
+module VERIFICATION
+  imports MPY-SYNTAX
+  imports BOOL
+
+  // A direct mathematical reading of the contract.  Looking from the right,
+  // a word shorter than three characters has no eligible position.  Otherwise
+  // inspect its last three characters: return the middle one exactly when it
+  // is a vowel bracketed by consonants, or continue with the final character
+  // removed.  This definition is independent of the evaluator below.
+  syntax Val ::= closestSpec(Chars)                           [function]
+  rule closestSpec(.Chars) => pyStr(.Chars)
+  rule closestSpec(snoc(.Chars, A)) => pyStr(.Chars)
+  rule closestSpec(snoc(snoc(.Chars, A), B)) => pyStr(.Chars)
+  rule closestSpec(snoc(snoc(snoc(P, con(A)), V:Vowel), con(C)))
+    => pyStr(snoc(.Chars, V))
+  rule closestSpec(snoc(snoc(snoc(P, A), con(B)), C))
+    => closestSpec(snoc(snoc(P, A), con(B)))
+  rule closestSpec(snoc(snoc(snoc(P, V1:Vowel), V2:Vowel), C))
+    => closestSpec(snoc(snoc(P, V1), V2))
+  rule closestSpec(snoc(snoc(snoc(P, con(A)), V:Vowel), V2:Vowel))
+    => closestSpec(snoc(snoc(P, con(A)), V))
+
+  // A closed constructor term for the submitted solution.  Proof claims use
+  // this exact AST, while krun separately parses solution.mpy itself.
+  syntax Module ::= "solutionProgram"                        [function]
+  rule solutionProgram =>
+    Module(
+      FuncDef("get_closest_vowel", Params("word"),
+        Assign(Name("vowels"), Str("aeiouAEIOU"))
+        If(Compare(Call(Name("len"), Name("word")), CmpOp("<", Int(3))),
+          Return(Str("")),
+          .Stmts)
+        If(Compare(Subscript(Name("word"), UnaryOp("-", Int(2))),
+                   CmpOp("in", Name("vowels"))),
+          If(Compare(Subscript(Name("word"), UnaryOp("-", Int(3))),
+                     CmpOp("not in", Name("vowels"))),
+            If(Compare(Subscript(Name("word"), UnaryOp("-", Int(1))),
+                       CmpOp("not in", Name("vowels"))),
+              Return(Subscript(Name("word"), UnaryOp("-", Int(2)))),
+              .Stmts),
+            .Stmts),
+          .Stmts)
+        Return(Call(Name("get_closest_vowel"),
+                    Subscript(Name("word"),
+                      Slice(NoBound, UnaryOp("-", Int(1)), NoBound))))))
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..7927b57319fd398df9d17fa5f3ec7d9103a59b47
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,238 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports BOOL-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  // The constructor language emitted by py2mpy.py (restricted here to the
+  // nodes used by solution.mpy).
+  syntax Module ::= "Module" "(" Stmts ")"                 [symbol]
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol]
+                | "Assign" "(" Expr "," Expr ")"            [symbol]
+                | "If" "(" Expr "," Stmts "," Stmts ")"     [symbol]
+                | "Return" "(" Expr ")"                     [symbol]
+  syntax Params ::= "Params" "(" ParamNames ")"             [symbol]
+  syntax ParamNames ::= List{String, ","}
+
+  syntax Expr ::= "Name" "(" String ")"                     [symbol]
+                | "Str" "(" String ")"                      [symbol]
+                | "Int" "(" Int ")"                         [symbol]
+                | "Call" "(" Expr "," Exprs ")"            [symbol]
+                | "Compare" "(" Expr "," CmpOps ")"        [symbol]
+                | "CmpOp" "(" String "," Expr ")"          [symbol]
+                | "UnaryOp" "(" String "," Expr ")"        [symbol]
+                | "Subscript" "(" Expr "," Index ")"       [symbol]
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{Expr, ","}
+  syntax Index ::= Expr | Slice
+  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")" [symbol]
+  syntax Bound ::= Expr | "NoBound"                           [symbol]
+
+  // Runtime values.  Chars is a snoc-list, making Python's negative string
+  // indices and removal of the last character structural operations.
+  syntax Vowel ::= "v_a" | "v_e" | "v_i" | "v_o" | "v_u"
+                 | "v_A" | "v_E" | "v_I" | "v_O" | "v_U"
+  syntax Char ::= Vowel | "con" "(" String ")"
+  syntax Chars ::= ".Chars" | "snoc" "(" Chars "," Char ")" | "VOWELS"
+  syntax Nat ::= "z" | "s" "(" Nat ")"
+  syntax Val ::= "pyStr" "(" Chars ")"
+               | "pyNat" "(" Nat ")"
+               | "pyNeg" "(" Nat ")"
+               | "pyBool" "(" Bool ")"
+               | "word" "(" String ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports VERIFICATION
+  imports BOOL
+  imports INT
+  imports STRING
+  imports MAP
+  imports LIST
+
+  configuration
+    <T>
+      <k> start($ARG:Val) </k>
+      <program> $PGM:Module </program>
+      <env> .Map </env>
+      <stack> .List </stack>
+    </T>
+
+  syntax KItem ::= "start" "(" Val ")"
+                 | "invoke" "(" String "," Val ")"
+                 | "execMachine" "(" Stmts ")"
+                 | "doStmt" "(" Stmt ")"
+                 | "returning" "(" Expr ")"
+                 | "branch" "(" Bool "," Stmts "," Stmts ")"
+                 | "answer" "(" Val ")"
+                 | "unwrap"
+  syntax Frame ::= "frame" "(" K "," Map ")"
+  syntax KItem ::= Frame
+  syntax ExecResult ::= "normal" "(" Map ")" | "returned" "(" Val ")"
+
+  syntax Val ::= normalize(Val)                              [function]
+  rule normalize(word(S)) => pyStr(litChars(S))
+  rule normalize(V:Val) => V                                 [owise]
+
+  rule <k> start(V) => invoke("get_closest_vowel", normalize(V)) ~> unwrap ... </k>
+
+  // Explicit call states expose recursive calls to kprove.  A frame records
+  // the caller continuation and environment; reaching a value restores both.
+  rule <k> invoke(F, V) ~> K => execMachine(functionBody(M, F)) </k>
+       <program> M </program>
+       <env> ENV => functionEnv(M, F, V) </env>
+       <stack> STACK => ListItem(frame(K, ENV)) STACK </stack>
+
+  rule <k> V:Val => answer(V) ~> K </k>
+       <env> _ENV => OLDENV </env>
+       <stack> ListItem(frame(K, OLDENV)) REST => REST </stack>
+  rule <k> answer(V) => answer(V) ~> K </k>
+       <env> _ENV => OLDENV </env>
+       <stack> ListItem(frame(K, OLDENV)) REST => REST </stack>
+  rule answer(V) ~> unwrap => V
+
+  rule execMachine(.Stmts) => .K
+  rule execMachine(S:Stmt REST:Stmts) => doStmt(S) ~> execMachine(REST)
+  rule <k> doStmt(Assign(Name(X), E)) => .K ... </k>
+       <program> M </program>
+       <env> ENV => ENV [ X <- eval(E, ENV, M) ] </env>
+  rule <k> doStmt(If(COND, THEN, ELSE))
+            => branch(asBool(eval(COND, ENV, M)), THEN, ELSE) ... </k>
+       <program> M </program>
+       <env> ENV </env>
+  rule branch(true, THEN, ELSE) => execMachine(THEN)
+  rule branch(false, THEN, ELSE) => execMachine(ELSE)
+  rule <k> doStmt(Return(E)) ~> _REST => returning(E) </k>
+  rule <k> returning(Call(Name(F), A:Expr, .Exprs))
+            => invoke(F, eval(A, ENV, M)) ... </k>
+       <program> M </program>
+       <env> ENV </env>
+  rule <k> returning(E) => eval(E, ENV, M) ... </k>
+       <program> M </program>
+       <env> ENV </env> [owise]
+
+  // Big-step helpers give meaning to pure expressions and are also useful as
+  // an executable reference layer.  Program calls in Return are handled by
+  // the explicit machine rule above.
+  syntax Val ::= call(Module, String, Val)                    [function]
+  rule call(M:Module, F,
+            V) => returnValue(exec(functionBody(M, F),
+                                    functionEnv(M, F, V), M))
+
+  syntax Stmts ::= functionBody(Module, String)               [function]
+  rule functionBody(Module(FuncDef(F, Params(X:String, .ParamNames), BODY)), F)
+    => BODY
+
+  syntax Map ::= functionEnv(Module, String, Val)             [function]
+  rule functionEnv(Module(FuncDef(F, Params(X:String, .ParamNames), BODY)), F, V)
+    => X |-> V
+
+  syntax Val ::= returnValue(ExecResult)                      [function]
+  rule returnValue(returned(V)) => V
+
+  syntax ExecResult ::= exec(Stmts, Map, Module)              [function]
+                      | execRest(ExecResult, Stmts, Module)   [function]
+                      | execStmt(Stmt, Map, Module)           [function]
+                      | choose(Bool, Stmts, Stmts, Map, Module) [function]
+  rule exec(.Stmts, ENV, M) => normal(ENV)
+  rule exec(S:Stmt REST:Stmts, ENV, M)
+    => execRest(execStmt(S, ENV, M), REST, M)
+  rule execRest(normal(ENV), REST, M) => exec(REST, ENV, M)
+  rule execRest(returned(V), REST, M) => returned(V)
+
+  rule execStmt(Assign(Name(X), E), ENV, M)
+    => normal(ENV [ X <- eval(E, ENV, M) ])
+  rule execStmt(If(COND, THEN, ELSE), ENV, M)
+    => choose(asBool(eval(COND, ENV, M)), THEN, ELSE, ENV, M)
+  rule execStmt(Return(E), ENV, M) => returned(eval(E, ENV, M))
+  rule choose(true,  THEN, ELSE, ENV, M) => exec(THEN, ENV, M)
+  rule choose(false, THEN, ELSE, ENV, M) => exec(ELSE, ENV, M)
+
+  // Expressions needed by the submitted Python program.
+  syntax Val ::= eval(Expr, Map, Module)                       [function]
+               | evalCompare(String, Val, Val)                [function]
+               | evalUnary(String, Val)                       [function]
+               | evalIndex(Val, Val)                          [function]
+               | evalSliceLast(Val)                           [function]
+  syntax Bool ::= asBool(Val)                                 [function]
+
+  syntax Val ::= lookupVal(Map, String)                        [function]
+  rule lookupVal((X |-> V:Val) REST, X) => V
+  rule eval(Name(X), ENV, M) => lookupVal(ENV, X)
+  rule eval(Str(S), ENV, M) => pyStr(litChars(S))
+  rule eval(Int(I), ENV, M) => pyNat(intNat(I)) requires I >=Int 0
+  rule eval(Call(Name("len"), A:Expr, .Exprs), ENV, M)
+    => pyNat(lenChars(asChars(eval(A, ENV, M))))
+  rule eval(Call(Name(F), A:Expr, .Exprs), ENV, M)
+    => call(M, F, eval(A, ENV, M)) requires F =/=String "len"
+  rule eval(Compare(L, CmpOp(OP, R), .CmpOps), ENV, M)
+    => evalCompare(OP, eval(L, ENV, M), eval(R, ENV, M))
+  rule eval(UnaryOp(OP, E), ENV, M) => evalUnary(OP, eval(E, ENV, M))
+  rule eval(Subscript(S, I:Expr), ENV, M)
+    => evalIndex(eval(S, ENV, M), eval(I, ENV, M))
+  rule eval(Subscript(S, Slice(NoBound, UnaryOp("-", Int(1)), NoBound)), ENV, M)
+    => evalSliceLast(eval(S, ENV, M))
+
+  rule evalCompare("<", pyNat(A), pyNat(B)) => pyBool(natLt(A, B))
+  rule evalCompare("in", pyStr(snoc(.Chars, C)), pyStr(HAY))
+    => pyBool(charIn(C, HAY))
+  rule evalCompare("not in", pyStr(snoc(.Chars, C)), pyStr(HAY))
+    => pyBool(notBool charIn(C, HAY))
+  rule evalUnary("-", pyNat(N)) => pyNeg(N)
+  rule evalIndex(pyStr(CS), pyNeg(N)) => fromEnd(CS, N)
+  rule evalSliceLast(pyStr(snoc(CS, C))) => pyStr(CS)
+  rule asBool(pyBool(B)) => B
+
+  // Literal conversion is part of the semantics, not the Python-to-AST
+  // translator.  Inputs supplied as word("...") use this same conversion.
+  syntax Chars ::= litChars(String)                            [function]
+  syntax Char ::= litChar(String)                             [function]
+  rule litChars("") => .Chars
+  rule litChars("aeiouAEIOU") => VOWELS
+  rule litChars(S) => snoc(litChars(substrString(S, 0,
+                                  lengthString(S) -Int 1)),
+                            litChar(substrString(S, lengthString(S) -Int 1,
+                                                   lengthString(S))))
+    requires lengthString(S) >Int 0
+     andBool S =/=String "aeiouAEIOU"
+  rule litChar("a") => v_a
+  rule litChar("e") => v_e
+  rule litChar("i") => v_i
+  rule litChar("o") => v_o
+  rule litChar("u") => v_u
+  rule litChar("A") => v_A
+  rule litChar("E") => v_E
+  rule litChar("I") => v_I
+  rule litChar("O") => v_O
+  rule litChar("U") => v_U
+  rule litChar(S) => con(S)                                  [owise]
+
+  syntax Nat ::= intNat(Int)                                  [function]
+  syntax Nat ::= lenChars(Chars)                              [function]
+  rule intNat(0) => z
+  rule intNat(1) => s(z)
+  rule intNat(2) => s(s(z))
+  rule intNat(3) => s(s(s(z)))
+  rule intNat(I) => s(intNat(I -Int 1)) requires I >Int 0
+  rule lenChars(.Chars) => z
+  rule lenChars(snoc(CS, C)) => s(lenChars(CS))
+
+  syntax Chars ::= asChars(Val)                               [function]
+  rule asChars(pyStr(CS)) => CS
+
+  syntax Bool ::= natLt(Nat, Nat)                             [function]
+  rule natLt(A, z) => false
+  rule natLt(z, s(B)) => true
+  rule natLt(s(A), s(B)) => natLt(A, B)
+
+  syntax Val ::= fromEnd(Chars, Nat)                          [function]
+  rule fromEnd(snoc(CS, C), s(z)) => pyStr(snoc(.Chars, C))
+  rule fromEnd(snoc(CS, C), s(s(N))) => fromEnd(CS, s(N))
+
+  syntax Bool ::= charIn(Char, Chars)                         [function]
+  rule charIn(V:Vowel, VOWELS) => true
+  rule charIn(con(S), VOWELS) => false
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..f26429f000a131554241de99d83f46b03771df33
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def get_closest_vowel(word):
+    vowels = "aeiouAEIOU"
+    if len(word) < 3:
+        return ""
+    if word[-2] in vowels:
+        if word[-3] not in vowels:
+            if word[-1] not in vowels:
+                return word[-2]
+    return get_closest_vowel(word[:-1])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..13a24053aecd77ba83489ebf8a2e49115da2e205
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,127 @@
+requires "semantic.k"
+
+module SPEC
+  imports MPY
+
+  // Every claim describes a complete function call: it preserves the caller's
+  // continuation, environment, and stack.  The cases are exhaustive for the
+  // recursive Chars datatype (vowels and consonants partition Char).
+
+  claim <T>
+          <k> invoke("get_closest_vowel", pyStr(.Chars)) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel", pyStr(snoc(.Chars, A:Char))) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(.Chars, A:Char), B:Char))) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // The rightmost triple is consonant-vowel-consonant.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(P:Chars, con(A:String)), V:Vowel),
+                                con(C:String)))) ~> KREST:K
+            => pyStr(snoc(.Chars, V)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 1: its middle character is a consonant.  The base
+  // case and three predecessor-window shapes form structural induction cases.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, A:Char), con(B:String)),
+                                C:Char))) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Char), con(A:String)),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, D), con(A)), con(B))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Vowel), A:Vowel),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, D), A), con(B))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, con(D:String)), A:Vowel),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, con(D)), A), con(B))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 2: its left and middle characters are vowels.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, V1:Vowel), V2:Vowel),
+                                C:Char))) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Vowel), V1:Vowel),
+                                     V2:Vowel), C:Char))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, D), V1), V2)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, con(D:String)), V1:Vowel),
+                                     V2:Vowel), C:Char))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, con(D)), V1), V2)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 3: its left character is a consonant and both
+  // following characters are vowels.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, con(A:String)), V:Vowel),
+                                V2:Vowel))) ~> KREST:K
+            => pyStr(.Chars) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Char), con(A:String)),
+                                     V:Vowel), V2:Vowel))) ~> KREST:K
+            => closestSpec(snoc(snoc(snoc(P, D), con(A)), V)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..91b81228932c65925bdab86a88e95cfcd4289882
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,46 @@
+module VERIFICATION
+  imports MPY-SYNTAX
+  imports BOOL
+
+  // A direct mathematical reading of the contract.  Looking from the right,
+  // a word shorter than three characters has no eligible position.  Otherwise
+  // inspect its last three characters: return the middle one exactly when it
+  // is a vowel bracketed by consonants, or continue with the final character
+  // removed.  This definition is independent of the evaluator below.
+  syntax Val ::= closestSpec(Chars)                           [function]
+  rule closestSpec(.Chars) => pyStr(.Chars)
+  rule closestSpec(snoc(.Chars, A)) => pyStr(.Chars)
+  rule closestSpec(snoc(snoc(.Chars, A), B)) => pyStr(.Chars)
+  rule closestSpec(snoc(snoc(snoc(P, con(A)), V:Vowel), con(C)))
+    => pyStr(snoc(.Chars, V))
+  rule closestSpec(snoc(snoc(snoc(P, A), con(B)), C))
+    => closestSpec(snoc(snoc(P, A), con(B)))
+  rule closestSpec(snoc(snoc(snoc(P, V1:Vowel), V2:Vowel), C))
+    => closestSpec(snoc(snoc(P, V1), V2))
+  rule closestSpec(snoc(snoc(snoc(P, con(A)), V:Vowel), V2:Vowel))
+    => closestSpec(snoc(snoc(P, con(A)), V))
+
+  // A closed constructor term for the submitted solution.  Proof claims use
+  // this exact AST, while krun separately parses solution.mpy itself.
+  syntax Module ::= "solutionProgram"                        [function]
+  rule solutionProgram =>
+    Module(
+      FuncDef("get_closest_vowel", Params("word"),
+        Assign(Name("vowels"), Str("aeiouAEIOU"))
+        If(Compare(Call(Name("len"), Name("word")), CmpOp("<", Int(3))),
+          Return(Str("")),
+          .Stmts)
+        If(Compare(Subscript(Name("word"), UnaryOp("-", Int(2))),
+                   CmpOp("in", Name("vowels"))),
+          If(Compare(Subscript(Name("word"), UnaryOp("-", Int(3))),
+                     CmpOp("not in", Name("vowels"))),
+            If(Compare(Subscript(Name("word"), UnaryOp("-", Int(1))),
+                       CmpOp("not in", Name("vowels"))),
+              Return(Subscript(Name("word"), UnaryOp("-", Int(2)))),
+              .Stmts),
+            .Stmts),
+          .Stmts)
+        Return(Call(Name("get_closest_vowel"),
+                    Subscript(Name("word"),
+                      Slice(NoBound, UnaryOp("-", Int(1)), NoBound))))))
+endmodule

apply patch
patch: completed
/work/spec.k
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..7927b57319fd398df9d17fa5f3ec7d9103a59b47
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,238 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports BOOL-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  // The constructor language emitted by py2mpy.py (restricted here to the
+  // nodes used by solution.mpy).
+  syntax Module ::= "Module" "(" Stmts ")"                 [symbol]
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol]
+                | "Assign" "(" Expr "," Expr ")"            [symbol]
+                | "If" "(" Expr "," Stmts "," Stmts ")"     [symbol]
+                | "Return" "(" Expr ")"                     [symbol]
+  syntax Params ::= "Params" "(" ParamNames ")"             [symbol]
+  syntax ParamNames ::= List{String, ","}
+
+  syntax Expr ::= "Name" "(" String ")"                     [symbol]
+                | "Str" "(" String ")"                      [symbol]
+                | "Int" "(" Int ")"                         [symbol]
+                | "Call" "(" Expr "," Exprs ")"            [symbol]
+                | "Compare" "(" Expr "," CmpOps ")"        [symbol]
+                | "CmpOp" "(" String "," Expr ")"          [symbol]
+                | "UnaryOp" "(" String "," Expr ")"        [symbol]
+                | "Subscript" "(" Expr "," Index ")"       [symbol]
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{Expr, ","}
+  syntax Index ::= Expr | Slice
+  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")" [symbol]
+  syntax Bound ::= Expr | "NoBound"                           [symbol]
+
+  // Runtime values.  Chars is a snoc-list, making Python's negative string
+  // indices and removal of the last character structural operations.
+  syntax Vowel ::= "v_a" | "v_e" | "v_i" | "v_o" | "v_u"
+                 | "v_A" | "v_E" | "v_I" | "v_O" | "v_U"
+  syntax Char ::= Vowel | "con" "(" String ")"
+  syntax Chars ::= ".Chars" | "snoc" "(" Chars "," Char ")" | "VOWELS"
+  syntax Nat ::= "z" | "s" "(" Nat ")"
+  syntax Val ::= "pyStr" "(" Chars ")"
+               | "pyNat" "(" Nat ")"
+               | "pyNeg" "(" Nat ")"
+               | "pyBool" "(" Bool ")"
+               | "word" "(" String ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports VERIFICATION
+  imports BOOL
+  imports INT
+  imports STRING
+  imports MAP
+  imports LIST
+
+  configuration
+    <T>
+      <k> start($ARG:Val) </k>
+      <program> $PGM:Module </program>
+      <env> .Map </env>
+      <stack> .List </stack>
+    </T>
+
+  syntax KItem ::= "start" "(" Val ")"
+                 | "invoke" "(" String "," Val ")"
+                 | "execMachine" "(" Stmts ")"
+                 | "doStmt" "(" Stmt ")"
+                 | "returning" "(" Expr ")"
+                 | "branch" "(" Bool "," Stmts "," Stmts ")"
+                 | "answer" "(" Val ")"
+                 | "unwrap"
+  syntax Frame ::= "frame" "(" K "," Map ")"
+  syntax KItem ::= Frame
+  syntax ExecResult ::= "normal" "(" Map ")" | "returned" "(" Val ")"
+
+  syntax Val ::= normalize(Val)                              [function]
+  rule normalize(word(S)) => pyStr(litChars(S))
+  rule normalize(V:Val) => V                                 [owise]
+
+  rule <k> start(V) => invoke("get_closest_vowel", normalize(V)) ~> unwrap ... </k>
+
+  // Explicit call states expose recursive calls to kprove.  A frame records
+  // the caller continuation and environment; reaching a value restores both.
+  rule <k> invoke(F, V) ~> K => execMachine(functionBody(M, F)) </k>
+       <program> M </program>
+       <env> ENV => functionEnv(M, F, V) </env>
+       <stack> STACK => ListItem(frame(K, ENV)) STACK </stack>
+
+  rule <k> V:Val => answer(V) ~> K </k>
+       <env> _ENV => OLDENV </env>
+       <stack> ListItem(frame(K, OLDENV)) REST => REST </stack>
+  rule <k> answer(V) => answer(V) ~> K </k>
+       <env> _ENV => OLDENV </env>
+       <stack> ListItem(frame(K, OLDENV)) REST => REST </stack>
+  rule answer(V) ~> unwrap => V
+
+  rule execMachine(.Stmts) => .K
+  rule execMachine(S:Stmt REST:Stmts) => doStmt(S) ~> execMachine(REST)
+  rule <k> doStmt(Assign(Name(X), E)) => .K ... </k>
+       <program> M </program>
+       <env> ENV => ENV [ X <- eval(E, ENV, M) ] </env>
+  rule <k> doStmt(If(COND, THEN, ELSE))
+            => branch(asBool(eval(COND, ENV, M)), THEN, ELSE) ... </k>
+       <program> M </program>
+       <env> ENV </env>
+  rule branch(true, THEN, ELSE) => execMachine(THEN)
+  rule branch(false, THEN, ELSE) => execMachine(ELSE)
+  rule <k> doStmt(Return(E)) ~> _REST => returning(E) </k>
+  rule <k> returning(Call(Name(F), A:Expr, .Exprs))
+            => invoke(F, eval(A, ENV, M)) ... </k>
+       <program> M </program>
+       <env> ENV </env>
+  rule <k> returning(E) => eval(E, ENV, M) ... </k>
+       <program> M </program>
+       <env> ENV </env> [owise]
+
+  // Big-step helpers give meaning to pure expressions and are also useful as
+  // an executable reference layer.  Program calls in Return are handled by
+  // the explicit machine rule above.
+  syntax Val ::= call(Module, String, Val)                    [function]
+  rule call(M:Module, F,
+            V) => returnValue(exec(functionBody(M, F),
+                                    functionEnv(M, F, V), M))
+
+  syntax Stmts ::= functionBody(Module, String)               [function]
+  rule functionBody(Module(FuncDef(F, Params(X:String, .ParamNames), BODY)), F)
+    => BODY
+
+  syntax Map ::= functionEnv(Module, String, Val)             [function]
+  rule functionEnv(Module(FuncDef(F, Params(X:String, .ParamNames), BODY)), F, V)
+    => X |-> V
+
+  syntax Val ::= returnValue(ExecResult)                      [function]
+  rule returnValue(returned(V)) => V
+
+  syntax ExecResult ::= exec(Stmts, Map, Module)              [function]
+                      | execRest(ExecResult, Stmts, Module)   [function]
+                      | execStmt(Stmt, Map, Module)           [function]
+                      | choose(Bool, Stmts, Stmts, Map, Module) [function]
+  rule exec(.Stmts, ENV, M) => normal(ENV)
+  rule exec(S:Stmt REST:Stmts, ENV, M)
+    => execRest(execStmt(S, ENV, M), REST, M)
+  rule execRest(normal(ENV), REST, M) => exec(REST, ENV, M)
+  rule execRest(returned(V), REST, M) => returned(V)
+
+  rule execStmt(Assign(Name(X), E), ENV, M)
+    => normal(ENV [ X <- eval(E, ENV, M) ])
+  rule execStmt(If(COND, THEN, ELSE), ENV, M)
+    => choose(asBool(eval(COND, ENV, M)), THEN, ELSE, ENV, M)
+  rule execStmt(Return(E), ENV, M) => returned(eval(E, ENV, M))
+  rule choose(true,  THEN, ELSE, ENV, M) => exec(THEN, ENV, M)
+  rule choose(false, THEN, ELSE, ENV, M) => exec(ELSE, ENV, M)
+
+  // Expressions needed by the submitted Python program.
+  syntax Val ::= eval(Expr, Map, Module)                       [function]
+               | evalCompare(String, Val, Val)                [function]
+               | evalUnary(String, Val)                       [function]
+               | evalIndex(Val, Val)                          [function]
+               | evalSliceLast(Val)                           [function]
+  syntax Bool ::= asBool(Val)                                 [function]
+
+  syntax Val ::= lookupVal(Map, String)                        [function]
+  rule lookupVal((X |-> V:Val) REST, X) => V
+  rule eval(Name(X), ENV, M) => lookupVal(ENV, X)
+  rule eval(Str(S), ENV, M) => pyStr(litChars(S))
+  rule eval(Int(I), ENV, M) => pyNat(intNat(I)) requires I >=Int 0
+  rule eval(Call(Name("len"), A:Expr, .Exprs), ENV, M)
+    => pyNat(lenChars(asChars(eval(A, ENV, M))))
+  rule eval(Call(Name(F), A:Expr, .Exprs), ENV, M)
+    => call(M, F, eval(A, ENV, M)) requires F =/=String "len"
+  rule eval(Compare(L, CmpOp(OP, R), .CmpOps), ENV, M)
+    => evalCompare(OP, eval(L, ENV, M), eval(R, ENV, M))
+  rule eval(UnaryOp(OP, E), ENV, M) => evalUnary(OP, eval(E, ENV, M))
+  rule eval(Subscript(S, I:Expr), ENV, M)
+    => evalIndex(eval(S, ENV, M), eval(I, ENV, M))
+  rule eval(Subscript(S, Slice(NoBound, UnaryOp("-", Int(1)), NoBound)), ENV, M)
+    => evalSliceLast(eval(S, ENV, M))
+
+  rule evalCompare("<", pyNat(A), pyNat(B)) => pyBool(natLt(A, B))
+  rule evalCompare("in", pyStr(snoc(.Chars, C)), pyStr(HAY))
+    => pyBool(charIn(C, HAY))
+  rule evalCompare("not in", pyStr(snoc(.Chars, C)), pyStr(HAY))
+    => pyBool(notBool charIn(C, HAY))
+  rule evalUnary("-", pyNat(N)) => pyNeg(N)
+  rule evalIndex(pyStr(CS), pyNeg(N)) => fromEnd(CS, N)
+  rule evalSliceLast(pyStr(snoc(CS, C))) => pyStr(CS)
+  rule asBool(pyBool(B)) => B
+
+  // Literal conversion is part of the semantics, not the Python-to-AST
+  // translator.  Inputs supplied as word("...") use this same conversion.
+  syntax Chars ::= litChars(String)                            [function]
+  syntax Char ::= litChar(String)                             [function]
+  rule litChars("") => .Chars
+  rule litChars("aeiouAEIOU") => VOWELS
+  rule litChars(S) => snoc(litChars(substrString(S, 0,
+                                  lengthString(S) -Int 1)),
+                            litChar(substrString(S, lengthString(S) -Int 1,
+                                                   lengthString(S))))
+    requires lengthString(S) >Int 0
+     andBool S =/=String "aeiouAEIOU"
+  rule litChar("a") => v_a
+  rule litChar("e") => v_e
+  rule litChar("i") => v_i
+  rule litChar("o") => v_o
+  rule litChar("u") => v_u
+  rule litChar("A") => v_A
+  rule litChar("E") => v_E
+  rule litChar("I") => v_I
+  rule litChar("O") => v_O
+  rule litChar("U") => v_U
+  rule litChar(S) => con(S)                                  [owise]
+
+  syntax Nat ::= intNat(Int)                                  [function]
+  syntax Nat ::= lenChars(Chars)                              [function]
+  rule intNat(0) => z
+  rule intNat(1) => s(z)
+  rule intNat(2) => s(s(z))
+  rule intNat(3) => s(s(s(z)))
+  rule intNat(I) => s(intNat(I -Int 1)) requires I >Int 0
+  rule lenChars(.Chars) => z
+  rule lenChars(snoc(CS, C)) => s(lenChars(CS))
+
+  syntax Chars ::= asChars(Val)                               [function]
+  rule asChars(pyStr(CS)) => CS
+
+  syntax Bool ::= natLt(Nat, Nat)                             [function]
+  rule natLt(A, z) => false
+  rule natLt(z, s(B)) => true
+  rule natLt(s(A), s(B)) => natLt(A, B)
+
+  syntax Val ::= fromEnd(Chars, Nat)                          [function]
+  rule fromEnd(snoc(CS, C), s(z)) => pyStr(snoc(.Chars, C))
+  rule fromEnd(snoc(CS, C), s(s(N))) => fromEnd(CS, s(N))
+
+  syntax Bool ::= charIn(Char, Chars)                         [function]
+  rule charIn(V:Vowel, VOWELS) => true
+  rule charIn(con(S), VOWELS) => false
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..f26429f000a131554241de99d83f46b03771df33
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def get_closest_vowel(word):
+    vowels = "aeiouAEIOU"
+    if len(word) < 3:
+        return ""
+    if word[-2] in vowels:
+        if word[-3] not in vowels:
+            if word[-1] not in vowels:
+                return word[-2]
+    return get_closest_vowel(word[:-1])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d52fce99ab5ddf0470782ee13e354ba3e14b75bf
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,127 @@
+requires "semantic.k"
+
+module SPEC
+  imports MPY
+
+  // Every claim describes a complete function call: it preserves the caller's
+  // continuation, environment, and stack.  The cases are exhaustive for the
+  // recursive Chars datatype (vowels and consonants partition Char).
+
+  claim <T>
+          <k> invoke("get_closest_vowel", pyStr(.Chars)) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel", pyStr(snoc(.Chars, A:Char))) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(.Chars, A:Char), B:Char))) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // The rightmost triple is consonant-vowel-consonant.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(P:Chars, con(A:String)), V:Vowel),
+                                con(C:String)))) ~> KREST:K
+            => answer(pyStr(snoc(.Chars, V))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 1: its middle character is a consonant.  The base
+  // case and three predecessor-window shapes form structural induction cases.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, A:Char), con(B:String)),
+                                C:Char))) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Char), con(A:String)),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, D), con(A)), con(B)))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Vowel), A:Vowel),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, D), A), con(B)))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, con(D:String)), A:Vowel),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, con(D)), A), con(B)))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 2: its left and middle characters are vowels.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, V1:Vowel), V2:Vowel),
+                                C:Char))) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Vowel), V1:Vowel),
+                                     V2:Vowel), C:Char))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, D), V1), V2))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, con(D:String)), V1:Vowel),
+                                     V2:Vowel), C:Char))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, con(D)), V1), V2))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 3: its left character is a consonant and both
+  // following characters are vowels.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, con(A:String)), V:Vowel),
+                                V2:Vowel))) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Char), con(A:String)),
+                                     V:Vowel), V2:Vowel))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, D), con(A)), V))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..91b81228932c65925bdab86a88e95cfcd4289882
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,46 @@
+module VERIFICATION
+  imports MPY-SYNTAX
+  imports BOOL
+
+  // A direct mathematical reading of the contract.  Looking from the right,
+  // a word shorter than three characters has no eligible position.  Otherwise
+  // inspect its last three characters: return the middle one exactly when it
+  // is a vowel bracketed by consonants, or continue with the final character
+  // removed.  This definition is independent of the evaluator below.
+  syntax Val ::= closestSpec(Chars)                           [function]
+  rule closestSpec(.Chars) => pyStr(.Chars)
+  rule closestSpec(snoc(.Chars, A)) => pyStr(.Chars)
+  rule closestSpec(snoc(snoc(.Chars, A), B)) => pyStr(.Chars)
+  rule closestSpec(snoc(snoc(snoc(P, con(A)), V:Vowel), con(C)))
+    => pyStr(snoc(.Chars, V))
+  rule closestSpec(snoc(snoc(snoc(P, A), con(B)), C))
+    => closestSpec(snoc(snoc(P, A), con(B)))
+  rule closestSpec(snoc(snoc(snoc(P, V1:Vowel), V2:Vowel), C))
+    => closestSpec(snoc(snoc(P, V1), V2))
+  rule closestSpec(snoc(snoc(snoc(P, con(A)), V:Vowel), V2:Vowel))
+    => closestSpec(snoc(snoc(P, con(A)), V))
+
+  // A closed constructor term for the submitted solution.  Proof claims use
+  // this exact AST, while krun separately parses solution.mpy itself.
+  syntax Module ::= "solutionProgram"                        [function]
+  rule solutionProgram =>
+    Module(
+      FuncDef("get_closest_vowel", Params("word"),
+        Assign(Name("vowels"), Str("aeiouAEIOU"))
+        If(Compare(Call(Name("len"), Name("word")), CmpOp("<", Int(3))),
+          Return(Str("")),
+          .Stmts)
+        If(Compare(Subscript(Name("word"), UnaryOp("-", Int(2))),
+                   CmpOp("in", Name("vowels"))),
+          If(Compare(Subscript(Name("word"), UnaryOp("-", Int(3))),
+                     CmpOp("not in", Name("vowels"))),
+            If(Compare(Subscript(Name("word"), UnaryOp("-", Int(1))),
+                       CmpOp("not in", Name("vowels"))),
+              Return(Subscript(Name("word"), UnaryOp("-", Int(2)))),
+              .Stmts),
+            .Stmts),
+          .Stmts)
+        Return(Call(Name("get_closest_vowel"),
+                    Subscript(Name("word"),
+                      Slice(NoBound, UnaryOp("-", Int(1)), NoBound))))))
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..7927b57319fd398df9d17fa5f3ec7d9103a59b47
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,238 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports BOOL-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  // The constructor language emitted by py2mpy.py (restricted here to the
+  // nodes used by solution.mpy).
+  syntax Module ::= "Module" "(" Stmts ")"                 [symbol]
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol]
+                | "Assign" "(" Expr "," Expr ")"            [symbol]
+                | "If" "(" Expr "," Stmts "," Stmts ")"     [symbol]
+                | "Return" "(" Expr ")"                     [symbol]
+  syntax Params ::= "Params" "(" ParamNames ")"             [symbol]
+  syntax ParamNames ::= List{String, ","}
+
+  syntax Expr ::= "Name" "(" String ")"                     [symbol]
+                | "Str" "(" String ")"                      [symbol]
+                | "Int" "(" Int ")"                         [symbol]
+                | "Call" "(" Expr "," Exprs ")"            [symbol]
+                | "Compare" "(" Expr "," CmpOps ")"        [symbol]
+                | "CmpOp" "(" String "," Expr ")"          [symbol]
+                | "UnaryOp" "(" String "," Expr ")"        [symbol]
+                | "Subscript" "(" Expr "," Index ")"       [symbol]
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{Expr, ","}
+  syntax Index ::= Expr | Slice
+  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")" [symbol]
+  syntax Bound ::= Expr | "NoBound"                           [symbol]
+
+  // Runtime values.  Chars is a snoc-list, making Python's negative string
+  // indices and removal of the last character structural operations.
+  syntax Vowel ::= "v_a" | "v_e" | "v_i" | "v_o" | "v_u"
+                 | "v_A" | "v_E" | "v_I" | "v_O" | "v_U"
+  syntax Char ::= Vowel | "con" "(" String ")"
+  syntax Chars ::= ".Chars" | "snoc" "(" Chars "," Char ")" | "VOWELS"
+  syntax Nat ::= "z" | "s" "(" Nat ")"
+  syntax Val ::= "pyStr" "(" Chars ")"
+               | "pyNat" "(" Nat ")"
+               | "pyNeg" "(" Nat ")"
+               | "pyBool" "(" Bool ")"
+               | "word" "(" String ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports VERIFICATION
+  imports BOOL
+  imports INT
+  imports STRING
+  imports MAP
+  imports LIST
+
+  configuration
+    <T>
+      <k> start($ARG:Val) </k>
+      <program> $PGM:Module </program>
+      <env> .Map </env>
+      <stack> .List </stack>
+    </T>
+
+  syntax KItem ::= "start" "(" Val ")"
+                 | "invoke" "(" String "," Val ")"
+                 | "execMachine" "(" Stmts ")"
+                 | "doStmt" "(" Stmt ")"
+                 | "returning" "(" Expr ")"
+                 | "branch" "(" Bool "," Stmts "," Stmts ")"
+                 | "answer" "(" Val ")"
+                 | "unwrap"
+  syntax Frame ::= "frame" "(" K "," Map ")"
+  syntax KItem ::= Frame
+  syntax ExecResult ::= "normal" "(" Map ")" | "returned" "(" Val ")"
+
+  syntax Val ::= normalize(Val)                              [function]
+  rule normalize(word(S)) => pyStr(litChars(S))
+  rule normalize(V:Val) => V                                 [owise]
+
+  rule <k> start(V) => invoke("get_closest_vowel", normalize(V)) ~> unwrap ... </k>
+
+  // Explicit call states expose recursive calls to kprove.  A frame records
+  // the caller continuation and environment; reaching a value restores both.
+  rule <k> invoke(F, V) ~> K => execMachine(functionBody(M, F)) </k>
+       <program> M </program>
+       <env> ENV => functionEnv(M, F, V) </env>
+       <stack> STACK => ListItem(frame(K, ENV)) STACK </stack>
+
+  rule <k> V:Val => answer(V) ~> K </k>
+       <env> _ENV => OLDENV </env>
+       <stack> ListItem(frame(K, OLDENV)) REST => REST </stack>
+  rule <k> answer(V) => answer(V) ~> K </k>
+       <env> _ENV => OLDENV </env>
+       <stack> ListItem(frame(K, OLDENV)) REST => REST </stack>
+  rule answer(V) ~> unwrap => V
+
+  rule execMachine(.Stmts) => .K
+  rule execMachine(S:Stmt REST:Stmts) => doStmt(S) ~> execMachine(REST)
+  rule <k> doStmt(Assign(Name(X), E)) => .K ... </k>
+       <program> M </program>
+       <env> ENV => ENV [ X <- eval(E, ENV, M) ] </env>
+  rule <k> doStmt(If(COND, THEN, ELSE))
+            => branch(asBool(eval(COND, ENV, M)), THEN, ELSE) ... </k>
+       <program> M </program>
+       <env> ENV </env>
+  rule branch(true, THEN, ELSE) => execMachine(THEN)
+  rule branch(false, THEN, ELSE) => execMachine(ELSE)
+  rule <k> doStmt(Return(E)) ~> _REST => returning(E) </k>
+  rule <k> returning(Call(Name(F), A:Expr, .Exprs))
+            => invoke(F, eval(A, ENV, M)) ... </k>
+       <program> M </program>
+       <env> ENV </env>
+  rule <k> returning(E) => eval(E, ENV, M) ... </k>
+       <program> M </program>
+       <env> ENV </env> [owise]
+
+  // Big-step helpers give meaning to pure expressions and are also useful as
+  // an executable reference layer.  Program calls in Return are handled by
+  // the explicit machine rule above.
+  syntax Val ::= call(Module, String, Val)                    [function]
+  rule call(M:Module, F,
+            V) => returnValue(exec(functionBody(M, F),
+                                    functionEnv(M, F, V), M))
+
+  syntax Stmts ::= functionBody(Module, String)               [function]
+  rule functionBody(Module(FuncDef(F, Params(X:String, .ParamNames), BODY)), F)
+    => BODY
+
+  syntax Map ::= functionEnv(Module, String, Val)             [function]
+  rule functionEnv(Module(FuncDef(F, Params(X:String, .ParamNames), BODY)), F, V)
+    => X |-> V
+
+  syntax Val ::= returnValue(ExecResult)                      [function]
+  rule returnValue(returned(V)) => V
+
+  syntax ExecResult ::= exec(Stmts, Map, Module)              [function]
+                      | execRest(ExecResult, Stmts, Module)   [function]
+                      | execStmt(Stmt, Map, Module)           [function]
+                      | choose(Bool, Stmts, Stmts, Map, Module) [function]
+  rule exec(.Stmts, ENV, M) => normal(ENV)
+  rule exec(S:Stmt REST:Stmts, ENV, M)
+    => execRest(execStmt(S, ENV, M), REST, M)
+  rule execRest(normal(ENV), REST, M) => exec(REST, ENV, M)
+  rule execRest(returned(V), REST, M) => returned(V)
+
+  rule execStmt(Assign(Name(X), E), ENV, M)
+    => normal(ENV [ X <- eval(E, ENV, M) ])
+  rule execStmt(If(COND, THEN, ELSE), ENV, M)
+    => choose(asBool(eval(COND, ENV, M)), THEN, ELSE, ENV, M)
+  rule execStmt(Return(E), ENV, M) => returned(eval(E, ENV, M))
+  rule choose(true,  THEN, ELSE, ENV, M) => exec(THEN, ENV, M)
+  rule choose(false, THEN, ELSE, ENV, M) => exec(ELSE, ENV, M)
+
+  // Expressions needed by the submitted Python program.
+  syntax Val ::= eval(Expr, Map, Module)                       [function]
+               | evalCompare(String, Val, Val)                [function]
+               | evalUnary(String, Val)                       [function]
+               | evalIndex(Val, Val)                          [function]
+               | evalSliceLast(Val)                           [function]
+  syntax Bool ::= asBool(Val)                                 [function]
+
+  syntax Val ::= lookupVal(Map, String)                        [function]
+  rule lookupVal((X |-> V:Val) REST, X) => V
+  rule eval(Name(X), ENV, M) => lookupVal(ENV, X)
+  rule eval(Str(S), ENV, M) => pyStr(litChars(S))
+  rule eval(Int(I), ENV, M) => pyNat(intNat(I)) requires I >=Int 0
+  rule eval(Call(Name("len"), A:Expr, .Exprs), ENV, M)
+    => pyNat(lenChars(asChars(eval(A, ENV, M))))
+  rule eval(Call(Name(F), A:Expr, .Exprs), ENV, M)
+    => call(M, F, eval(A, ENV, M)) requires F =/=String "len"
+  rule eval(Compare(L, CmpOp(OP, R), .CmpOps), ENV, M)
+    => evalCompare(OP, eval(L, ENV, M), eval(R, ENV, M))
+  rule eval(UnaryOp(OP, E), ENV, M) => evalUnary(OP, eval(E, ENV, M))
+  rule eval(Subscript(S, I:Expr), ENV, M)
+    => evalIndex(eval(S, ENV, M), eval(I, ENV, M))
+  rule eval(Subscript(S, Slice(NoBound, UnaryOp("-", Int(1)), NoBound)), ENV, M)
+    => evalSliceLast(eval(S, ENV, M))
+
+  rule evalCompare("<", pyNat(A), pyNat(B)) => pyBool(natLt(A, B))
+  rule evalCompare("in", pyStr(snoc(.Chars, C)), pyStr(HAY))
+    => pyBool(charIn(C, HAY))
+  rule evalCompare("not in", pyStr(snoc(.Chars, C)), pyStr(HAY))
+    => pyBool(notBool charIn(C, HAY))
+  rule evalUnary("-", pyNat(N)) => pyNeg(N)
+  rule evalIndex(pyStr(CS), pyNeg(N)) => fromEnd(CS, N)
+  rule evalSliceLast(pyStr(snoc(CS, C))) => pyStr(CS)
+  rule asBool(pyBool(B)) => B
+
+  // Literal conversion is part of the semantics, not the Python-to-AST
+  // translator.  Inputs supplied as word("...") use this same conversion.
+  syntax Chars ::= litChars(String)                            [function]
+  syntax Char ::= litChar(String)                             [function]
+  rule litChars("") => .Chars
+  rule litChars("aeiouAEIOU") => VOWELS
+  rule litChars(S) => snoc(litChars(substrString(S, 0,
+                                  lengthString(S) -Int 1)),
+                            litChar(substrString(S, lengthString(S) -Int 1,
+                                                   lengthString(S))))
+    requires lengthString(S) >Int 0
+     andBool S =/=String "aeiouAEIOU"
+  rule litChar("a") => v_a
+  rule litChar("e") => v_e
+  rule litChar("i") => v_i
+  rule litChar("o") => v_o
+  rule litChar("u") => v_u
+  rule litChar("A") => v_A
+  rule litChar("E") => v_E
+  rule litChar("I") => v_I
+  rule litChar("O") => v_O
+  rule litChar("U") => v_U
+  rule litChar(S) => con(S)                                  [owise]
+
+  syntax Nat ::= intNat(Int)                                  [function]
+  syntax Nat ::= lenChars(Chars)                              [function]
+  rule intNat(0) => z
+  rule intNat(1) => s(z)
+  rule intNat(2) => s(s(z))
+  rule intNat(3) => s(s(s(z)))
+  rule intNat(I) => s(intNat(I -Int 1)) requires I >Int 0
+  rule lenChars(.Chars) => z
+  rule lenChars(snoc(CS, C)) => s(lenChars(CS))
+
+  syntax Chars ::= asChars(Val)                               [function]
+  rule asChars(pyStr(CS)) => CS
+
+  syntax Bool ::= natLt(Nat, Nat)                             [function]
+  rule natLt(A, z) => false
+  rule natLt(z, s(B)) => true
+  rule natLt(s(A), s(B)) => natLt(A, B)
+
+  syntax Val ::= fromEnd(Chars, Nat)                          [function]
+  rule fromEnd(snoc(CS, C), s(z)) => pyStr(snoc(.Chars, C))
+  rule fromEnd(snoc(CS, C), s(s(N))) => fromEnd(CS, s(N))
+
+  syntax Bool ::= charIn(Char, Chars)                         [function]
+  rule charIn(V:Vowel, VOWELS) => true
+  rule charIn(con(S), VOWELS) => false
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..f26429f000a131554241de99d83f46b03771df33
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def get_closest_vowel(word):
+    vowels = "aeiouAEIOU"
+    if len(word) < 3:
+        return ""
+    if word[-2] in vowels:
+        if word[-3] not in vowels:
+            if word[-1] not in vowels:
+                return word[-2]
+    return get_closest_vowel(word[:-1])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d52fce99ab5ddf0470782ee13e354ba3e14b75bf
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,127 @@
+requires "semantic.k"
+
+module SPEC
+  imports MPY
+
+  // Every claim describes a complete function call: it preserves the caller's
+  // continuation, environment, and stack.  The cases are exhaustive for the
+  // recursive Chars datatype (vowels and consonants partition Char).
+
+  claim <T>
+          <k> invoke("get_closest_vowel", pyStr(.Chars)) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel", pyStr(snoc(.Chars, A:Char))) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(.Chars, A:Char), B:Char))) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // The rightmost triple is consonant-vowel-consonant.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(P:Chars, con(A:String)), V:Vowel),
+                                con(C:String)))) ~> KREST:K
+            => answer(pyStr(snoc(.Chars, V))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 1: its middle character is a consonant.  The base
+  // case and three predecessor-window shapes form structural induction cases.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, A:Char), con(B:String)),
+                                C:Char))) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Char), con(A:String)),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, D), con(A)), con(B)))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Vowel), A:Vowel),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, D), A), con(B)))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, con(D:String)), A:Vowel),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, con(D)), A), con(B)))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 2: its left and middle characters are vowels.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, V1:Vowel), V2:Vowel),
+                                C:Char))) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Vowel), V1:Vowel),
+                                     V2:Vowel), C:Char))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, D), V1), V2))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, con(D:String)), V1:Vowel),
+                                     V2:Vowel), C:Char))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, con(D)), V1), V2))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 3: its left character is a consonant and both
+  // following characters are vowels.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, con(A:String)), V:Vowel),
+                                V2:Vowel))) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Char), con(A:String)),
+                                     V:Vowel), V2:Vowel))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, D), con(A)), V))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..91b81228932c65925bdab86a88e95cfcd4289882
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,46 @@
+module VERIFICATION
+  imports MPY-SYNTAX
+  imports BOOL
+
+  // A direct mathematical reading of the contract.  Looking from the right,
+  // a word shorter than three characters has no eligible position.  Otherwise
+  // inspect its last three characters: return the middle one exactly when it
+  // is a vowel bracketed by consonants, or continue with the final character
+  // removed.  This definition is independent of the evaluator below.
+  syntax Val ::= closestSpec(Chars)                           [function]
+  rule closestSpec(.Chars) => pyStr(.Chars)
+  rule closestSpec(snoc(.Chars, A)) => pyStr(.Chars)
+  rule closestSpec(snoc(snoc(.Chars, A), B)) => pyStr(.Chars)
+  rule closestSpec(snoc(snoc(snoc(P, con(A)), V:Vowel), con(C)))
+    => pyStr(snoc(.Chars, V))
+  rule closestSpec(snoc(snoc(snoc(P, A), con(B)), C))
+    => closestSpec(snoc(snoc(P, A), con(B)))
+  rule closestSpec(snoc(snoc(snoc(P, V1:Vowel), V2:Vowel), C))
+    => closestSpec(snoc(snoc(P, V1), V2))
+  rule closestSpec(snoc(snoc(snoc(P, con(A)), V:Vowel), V2:Vowel))
+    => closestSpec(snoc(snoc(P, con(A)), V))
+
+  // A closed constructor term for the submitted solution.  Proof claims use
+  // this exact AST, while krun separately parses solution.mpy itself.
+  syntax Module ::= "solutionProgram"                        [function]
+  rule solutionProgram =>
+    Module(
+      FuncDef("get_closest_vowel", Params("word"),
+        Assign(Name("vowels"), Str("aeiouAEIOU"))
+        If(Compare(Call(Name("len"), Name("word")), CmpOp("<", Int(3))),
+          Return(Str("")),
+          .Stmts)
+        If(Compare(Subscript(Name("word"), UnaryOp("-", Int(2))),
+                   CmpOp("in", Name("vowels"))),
+          If(Compare(Subscript(Name("word"), UnaryOp("-", Int(3))),
+                     CmpOp("not in", Name("vowels"))),
+            If(Compare(Subscript(Name("word"), UnaryOp("-", Int(1))),
+                       CmpOp("not in", Name("vowels"))),
+              Return(Subscript(Name("word"), UnaryOp("-", Int(2)))),
+              .Stmts),
+            .Stmts),
+          .Stmts)
+        Return(Call(Name("get_closest_vowel"),
+                    Subscript(Name("word"),
+                      Slice(NoBound, UnaryOp("-", Int(1)), NoBound))))))
+endmodule

exec
/bin/bash -lc "kompile semantic.k --backend haskell --main-module MPY --syntax-module MPY-SYNTAX >/tmp/kompile3.out 2>&1 && krun solution.mpy -cARG='word(\"yogurt\")' | sed -n '1,16p'" in /work
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..7927b57319fd398df9d17fa5f3ec7d9103a59b47
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,238 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports BOOL-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  // The constructor language emitted by py2mpy.py (restricted here to the
+  // nodes used by solution.mpy).
+  syntax Module ::= "Module" "(" Stmts ")"                 [symbol]
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol]
+                | "Assign" "(" Expr "," Expr ")"            [symbol]
+                | "If" "(" Expr "," Stmts "," Stmts ")"     [symbol]
+                | "Return" "(" Expr ")"                     [symbol]
+  syntax Params ::= "Params" "(" ParamNames ")"             [symbol]
+  syntax ParamNames ::= List{String, ","}
+
+  syntax Expr ::= "Name" "(" String ")"                     [symbol]
+                | "Str" "(" String ")"                      [symbol]
+                | "Int" "(" Int ")"                         [symbol]
+                | "Call" "(" Expr "," Exprs ")"            [symbol]
+                | "Compare" "(" Expr "," CmpOps ")"        [symbol]
+                | "CmpOp" "(" String "," Expr ")"          [symbol]
+                | "UnaryOp" "(" String "," Expr ")"        [symbol]
+                | "Subscript" "(" Expr "," Index ")"       [symbol]
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOps ::= List{Expr, ","}
+  syntax Index ::= Expr | Slice
+  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")" [symbol]
+  syntax Bound ::= Expr | "NoBound"                           [symbol]
+
+  // Runtime values.  Chars is a snoc-list, making Python's negative string
+  // indices and removal of the last character structural operations.
+  syntax Vowel ::= "v_a" | "v_e" | "v_i" | "v_o" | "v_u"
+                 | "v_A" | "v_E" | "v_I" | "v_O" | "v_U"
+  syntax Char ::= Vowel | "con" "(" String ")"
+  syntax Chars ::= ".Chars" | "snoc" "(" Chars "," Char ")" | "VOWELS"
+  syntax Nat ::= "z" | "s" "(" Nat ")"
+  syntax Val ::= "pyStr" "(" Chars ")"
+               | "pyNat" "(" Nat ")"
+               | "pyNeg" "(" Nat ")"
+               | "pyBool" "(" Bool ")"
+               | "word" "(" String ")"
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports VERIFICATION
+  imports BOOL
+  imports INT
+  imports STRING
+  imports MAP
+  imports LIST
+
+  configuration
+    <T>
+      <k> start($ARG:Val) </k>
+      <program> $PGM:Module </program>
+      <env> .Map </env>
+      <stack> .List </stack>
+    </T>
+
+  syntax KItem ::= "start" "(" Val ")"
+                 | "invoke" "(" String "," Val ")"
+                 | "execMachine" "(" Stmts ")"
+                 | "doStmt" "(" Stmt ")"
+                 | "returning" "(" Expr ")"
+                 | "branch" "(" Bool "," Stmts "," Stmts ")"
+                 | "answer" "(" Val ")"
+                 | "unwrap"
+  syntax Frame ::= "frame" "(" K "," Map ")"
+  syntax KItem ::= Frame
+  syntax ExecResult ::= "normal" "(" Map ")" | "returned" "(" Val ")"
+
+  syntax Val ::= normalize(Val)                              [function]
+  rule normalize(word(S)) => pyStr(litChars(S))
+  rule normalize(V:Val) => V                                 [owise]
+
+  rule <k> start(V) => invoke("get_closest_vowel", normalize(V)) ~> unwrap ... </k>
+
+  // Explicit call states expose recursive calls to kprove.  A frame records
+  // the caller continuation and environment; reaching a value restores both.
+  rule <k> invoke(F, V) ~> K => execMachine(functionBody(M, F)) </k>
+       <program> M </program>
+       <env> ENV => functionEnv(M, F, V) </env>
+       <stack> STACK => ListItem(frame(K, ENV)) STACK </stack>
+
+  rule <k> V:Val => answer(V) ~> K </k>
+       <env> _ENV => OLDENV </env>
+       <stack> ListItem(frame(K, OLDENV)) REST => REST </stack>
+  rule <k> answer(V) => answer(V) ~> K </k>
+       <env> _ENV => OLDENV </env>
+       <stack> ListItem(frame(K, OLDENV)) REST => REST </stack>
+  rule answer(V) ~> unwrap => V
+
+  rule execMachine(.Stmts) => .K
+  rule execMachine(S:Stmt REST:Stmts) => doStmt(S) ~> execMachine(REST)
+  rule <k> doStmt(Assign(Name(X), E)) => .K ... </k>
+       <program> M </program>
+       <env> ENV => ENV [ X <- eval(E, ENV, M) ] </env>
+  rule <k> doStmt(If(COND, THEN, ELSE))
+            => branch(asBool(eval(COND, ENV, M)), THEN, ELSE) ... </k>
+       <program> M </program>
+       <env> ENV </env>
+  rule branch(true, THEN, ELSE) => execMachine(THEN)
+  rule branch(false, THEN, ELSE) => execMachine(ELSE)
+  rule <k> doStmt(Return(E)) ~> _REST => returning(E) </k>
+  rule <k> returning(Call(Name(F), A:Expr, .Exprs))
+            => invoke(F, eval(A, ENV, M)) ... </k>
+       <program> M </program>
+       <env> ENV </env>
+  rule <k> returning(E) => eval(E, ENV, M) ... </k>
+       <program> M </program>
+       <env> ENV </env> [owise]
+
+  // Big-step helpers give meaning to pure expressions and are also useful as
+  // an executable reference layer.  Program calls in Return are handled by
+  // the explicit machine rule above.
+  syntax Val ::= call(Module, String, Val)                    [function]
+  rule call(M:Module, F,
+            V) => returnValue(exec(functionBody(M, F),
+                                    functionEnv(M, F, V), M))
+
+  syntax Stmts ::= functionBody(Module, String)               [function]
+  rule functionBody(Module(FuncDef(F, Params(X:String, .ParamNames), BODY)), F)
+    => BODY
+
+  syntax Map ::= functionEnv(Module, String, Val)             [function]
+  rule functionEnv(Module(FuncDef(F, Params(X:String, .ParamNames), BODY)), F, V)
+    => X |-> V
+
+  syntax Val ::= returnValue(ExecResult)                      [function]
+  rule returnValue(returned(V)) => V
+
+  syntax ExecResult ::= exec(Stmts, Map, Module)              [function]
+                      | execRest(ExecResult, Stmts, Module)   [function]
+                      | execStmt(Stmt, Map, Module)           [function]
+                      | choose(Bool, Stmts, Stmts, Map, Module) [function]
+  rule exec(.Stmts, ENV, M) => normal(ENV)
+  rule exec(S:Stmt REST:Stmts, ENV, M)
+    => execRest(execStmt(S, ENV, M), REST, M)
+  rule execRest(normal(ENV), REST, M) => exec(REST, ENV, M)
+  rule execRest(returned(V), REST, M) => returned(V)
+
+  rule execStmt(Assign(Name(X), E), ENV, M)
+    => normal(ENV [ X <- eval(E, ENV, M) ])
+  rule execStmt(If(COND, THEN, ELSE), ENV, M)
+    => choose(asBool(eval(COND, ENV, M)), THEN, ELSE, ENV, M)
+  rule execStmt(Return(E), ENV, M) => returned(eval(E, ENV, M))
+  rule choose(true,  THEN, ELSE, ENV, M) => exec(THEN, ENV, M)
+  rule choose(false, THEN, ELSE, ENV, M) => exec(ELSE, ENV, M)
+
+  // Expressions needed by the submitted Python program.
+  syntax Val ::= eval(Expr, Map, Module)                       [function]
+               | evalCompare(String, Val, Val)                [function]
+               | evalUnary(String, Val)                       [function]
+               | evalIndex(Val, Val)                          [function]
+               | evalSliceLast(Val)                           [function]
+  syntax Bool ::= asBool(Val)                                 [function]
+
+  syntax Val ::= lookupVal(Map, String)                        [function]
+  rule lookupVal((X |-> V:Val) REST, X) => V
+  rule eval(Name(X), ENV, M) => lookupVal(ENV, X)
+  rule eval(Str(S), ENV, M) => pyStr(litChars(S))
+  rule eval(Int(I), ENV, M) => pyNat(intNat(I)) requires I >=Int 0
+  rule eval(Call(Name("len"), A:Expr, .Exprs), ENV, M)
+    => pyNat(lenChars(asChars(eval(A, ENV, M))))
+  rule eval(Call(Name(F), A:Expr, .Exprs), ENV, M)
+    => call(M, F, eval(A, ENV, M)) requires F =/=String "len"
+  rule eval(Compare(L, CmpOp(OP, R), .CmpOps), ENV, M)
+    => evalCompare(OP, eval(L, ENV, M), eval(R, ENV, M))
+  rule eval(UnaryOp(OP, E), ENV, M) => evalUnary(OP, eval(E, ENV, M))
+  rule eval(Subscript(S, I:Expr), ENV, M)
+    => evalIndex(eval(S, ENV, M), eval(I, ENV, M))
+  rule eval(Subscript(S, Slice(NoBound, UnaryOp("-", Int(1)), NoBound)), ENV, M)
+    => evalSliceLast(eval(S, ENV, M))
+
+  rule evalCompare("<", pyNat(A), pyNat(B)) => pyBool(natLt(A, B))
+  rule evalCompare("in", pyStr(snoc(.Chars, C)), pyStr(HAY))
+    => pyBool(charIn(C, HAY))
+  rule evalCompare("not in", pyStr(snoc(.Chars, C)), pyStr(HAY))
+    => pyBool(notBool charIn(C, HAY))
+  rule evalUnary("-", pyNat(N)) => pyNeg(N)
+  rule evalIndex(pyStr(CS), pyNeg(N)) => fromEnd(CS, N)
+  rule evalSliceLast(pyStr(snoc(CS, C))) => pyStr(CS)
+  rule asBool(pyBool(B)) => B
+
+  // Literal conversion is part of the semantics, not the Python-to-AST
+  // translator.  Inputs supplied as word("...") use this same conversion.
+  syntax Chars ::= litChars(String)                            [function]
+  syntax Char ::= litChar(String)                             [function]
+  rule litChars("") => .Chars
+  rule litChars("aeiouAEIOU") => VOWELS
+  rule litChars(S) => snoc(litChars(substrString(S, 0,
+                                  lengthString(S) -Int 1)),
+                            litChar(substrString(S, lengthString(S) -Int 1,
+                                                   lengthString(S))))
+    requires lengthString(S) >Int 0
+     andBool S =/=String "aeiouAEIOU"
+  rule litChar("a") => v_a
+  rule litChar("e") => v_e
+  rule litChar("i") => v_i
+  rule litChar("o") => v_o
+  rule litChar("u") => v_u
+  rule litChar("A") => v_A
+  rule litChar("E") => v_E
+  rule litChar("I") => v_I
+  rule litChar("O") => v_O
+  rule litChar("U") => v_U
+  rule litChar(S) => con(S)                                  [owise]
+
+  syntax Nat ::= intNat(Int)                                  [function]
+  syntax Nat ::= lenChars(Chars)                              [function]
+  rule intNat(0) => z
+  rule intNat(1) => s(z)
+  rule intNat(2) => s(s(z))
+  rule intNat(3) => s(s(s(z)))
+  rule intNat(I) => s(intNat(I -Int 1)) requires I >Int 0
+  rule lenChars(.Chars) => z
+  rule lenChars(snoc(CS, C)) => s(lenChars(CS))
+
+  syntax Chars ::= asChars(Val)                               [function]
+  rule asChars(pyStr(CS)) => CS
+
+  syntax Bool ::= natLt(Nat, Nat)                             [function]
+  rule natLt(A, z) => false
+  rule natLt(z, s(B)) => true
+  rule natLt(s(A), s(B)) => natLt(A, B)
+
+  syntax Val ::= fromEnd(Chars, Nat)                          [function]
+  rule fromEnd(snoc(CS, C), s(z)) => pyStr(snoc(.Chars, C))
+  rule fromEnd(snoc(CS, C), s(s(N))) => fromEnd(CS, s(N))
+
+  syntax Bool ::= charIn(Char, Chars)                         [function]
+  rule charIn(V:Vowel, VOWELS) => true
+  rule charIn(con(S), VOWELS) => false
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..f26429f000a131554241de99d83f46b03771df33
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def get_closest_vowel(word):
+    vowels = "aeiouAEIOU"
+    if len(word) < 3:
+        return ""
+    if word[-2] in vowels:
+        if word[-3] not in vowels:
+            if word[-1] not in vowels:
+                return word[-2]
+    return get_closest_vowel(word[:-1])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d52fce99ab5ddf0470782ee13e354ba3e14b75bf
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,127 @@
+requires "semantic.k"
+
+module SPEC
+  imports MPY
+
+  // Every claim describes a complete function call: it preserves the caller's
+  // continuation, environment, and stack.  The cases are exhaustive for the
+  // recursive Chars datatype (vowels and consonants partition Char).
+
+  claim <T>
+          <k> invoke("get_closest_vowel", pyStr(.Chars)) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel", pyStr(snoc(.Chars, A:Char))) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(.Chars, A:Char), B:Char))) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // The rightmost triple is consonant-vowel-consonant.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(P:Chars, con(A:String)), V:Vowel),
+                                con(C:String)))) ~> KREST:K
+            => answer(pyStr(snoc(.Chars, V))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 1: its middle character is a consonant.  The base
+  // case and three predecessor-window shapes form structural induction cases.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, A:Char), con(B:String)),
+                                C:Char))) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Char), con(A:String)),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, D), con(A)), con(B)))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Vowel), A:Vowel),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, D), A), con(B)))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, con(D:String)), A:Vowel),
+                                     con(B:String)), C:Char))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, con(D)), A), con(B)))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 2: its left and middle characters are vowels.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, V1:Vowel), V2:Vowel),
+                                C:Char))) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Vowel), V1:Vowel),
+                                     V2:Vowel), C:Char))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, D), V1), V2))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, con(D:String)), V1:Vowel),
+                                     V2:Vowel), C:Char))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, con(D)), V1), V2))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  // Last-window failure 3: its left character is a consonant and both
+  // following characters are vowels.
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(.Chars, con(A:String)), V:Vowel),
+                                V2:Vowel))) ~> KREST:K
+            => answer(pyStr(.Chars)) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+
+  claim <T>
+          <k> invoke("get_closest_vowel",
+                     pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Char), con(A:String)),
+                                     V:Vowel), V2:Vowel))) ~> KREST:K
+            => answer(closestSpec(snoc(snoc(snoc(P, D), con(A)), V))) ~> KREST </k>
+          <program> solutionProgram </program>
+          <env> ENV:Map </env> <stack> STACK:List </stack>
+        </T>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..91b81228932c65925bdab86a88e95cfcd4289882
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,46 @@
+module VERIFICATION
+  imports MPY-SYNTAX
+  imports BOOL
+
+  // A direct mathematical reading of the contract.  Looking from the right,
+  // a word shorter than three characters has no eligible position.  Otherwise
+  // inspect its last three characters: return the middle one exactly when it
+  // is a vowel bracketed by consonants, or continue with the final character
+  // removed.  This definition is independent of the evaluator below.
+  syntax Val ::= closestSpec(Chars)                           [function]
+  rule closestSpec(.Chars) => pyStr(.Chars)
