+requires "semantic.k"
+
+module SPEC
+  imports MPY
+
+  // Base cases: beginning/end positions cannot qualify.
+  claim <k> call(solutionProgram, "get_closest_vowel",
+                  pyStr(.Chars))
+          => pyStr(.Chars) ... </k>
+
+  claim <k> call(solutionProgram, "get_closest_vowel",
+                  pyStr(snoc(.Chars, A:Char)))
+          => pyStr(.Chars) ... </k>
+
+  claim <k> call(solutionProgram, "get_closest_vowel",
+                  pyStr(snoc(snoc(.Chars, A:Char), B:Char)))
+          => pyStr(.Chars) ... </k>
+
+  // The final three characters form the desired consonant-vowel-consonant
+  // window, so the middle character is immediately the closest one.
+  claim <k> call(solutionProgram, "get_closest_vowel",
+                  pyStr(snoc(snoc(snoc(P:Chars, con(A:String)), V:Vowel),
+                             con(C:String))))
+          => pyStr(snoc(.Chars, V)) ... </k>
+
+  // Exhaustive failure cases for the last window.  In each case the
+  // specification (and the program) continues after dropping the last char.
+  // Middle character is a consonant.  The four claims split the recursive
+  // predecessor into its base case and the three possible predecessor
+  // windows, which supplies K's structural induction cases.
+  claim <k> call(solutionProgram, "get_closest_vowel",
+                  pyStr(snoc(snoc(snoc(.Chars, A:Char), con(B:String)),
+                             C:Char)))
+          => pyStr(.Chars) ... </k>
+
+  claim <k> call(solutionProgram, "get_closest_vowel",
+                  pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Char), con(A:String)),
+                                  con(B:String)), C:Char)))
+          => closestSpec(snoc(snoc(snoc(P, D), con(A)), con(B))) ... </k>
+
+  claim <k> call(solutionProgram, "get_closest_vowel",
+                  pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Vowel), A:Vowel),
+                                  con(B:String)), C:Char)))
+          => closestSpec(snoc(snoc(snoc(P, D), A), con(B))) ... </k>
+
+  claim <k> call(solutionProgram, "get_closest_vowel",
+                  pyStr(snoc(snoc(snoc(snoc(P:Chars, con(D:String)), A:Vowel),
+                                  con(B:String)), C:Char)))
+          => closestSpec(snoc(snoc(snoc(P, con(D)), A), con(B))) ... </k>
+
+  // Middle and left characters are vowels.
+  claim <k> call(solutionProgram, "get_closest_vowel",
+                  pyStr(snoc(snoc(snoc(.Chars, V1:Vowel), V2:Vowel),
+                             C:Char)))
+          => pyStr(.Chars) ... </k>
+
+  claim <k> call(solutionProgram, "get_closest_vowel",
+                  pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Vowel), V1:Vowel),
+                                  V2:Vowel), C:Char)))
+          => closestSpec(snoc(snoc(snoc(P, D), V1), V2)) ... </k>
+
+  claim <k> call(solutionProgram, "get_closest_vowel",
+                  pyStr(snoc(snoc(snoc(snoc(P:Chars, con(D:String)), V1:Vowel),
+                                  V2:Vowel), C:Char)))
+          => closestSpec(snoc(snoc(snoc(P, con(D)), V1), V2)) ... </k>
+
+  // Left consonant and middle/right vowels.
+  claim <k> call(solutionProgram, "get_closest_vowel",
+                  pyStr(snoc(snoc(snoc(.Chars, con(A:String)), V:Vowel),
+                             V2:Vowel)))
+          => pyStr(.Chars) ... </k>
+
+  claim <k> call(solutionProgram, "get_closest_vowel",
+                  pyStr(snoc(snoc(snoc(snoc(P:Chars, D:Char), con(A:String)),
+                                  V:Vowel), V2:Vowel)))
+          => closestSpec(snoc(snoc(snoc(P, D), con(A)), V)) ... </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..91b81228932c65925bdab86a88e95cfcd4289882
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,46 @@
+module VERIFICATION
+  imports MPY-SYNTAX
+  imports BOOL
+
+  // A direct mathematical reading of the contract.  Looking from the right,
+  // a word shorter than three characters has no eligible position.  Otherwise
+  // inspect its last three characters: return the middle one exactly when it
+  // is a vowel bracketed by consonants, or continue with the final character
+  // removed.  This definition is independent of the evaluator below.
+  syntax Val ::= closestSpec(Chars)                           [function]
+  rule closestSpec(.Chars) => pyStr(.Chars)
+  rule closestSpec(snoc(.Chars, A)) => pyStr(.Chars)
+  rule closestSpec(snoc(snoc(.Chars, A), B)) => pyStr(.Chars)
+  rule closestSpec(snoc(snoc(snoc(P, con(A)), V:Vowel), con(C)))
+    => pyStr(snoc(.Chars, V))
+  rule closestSpec(snoc(snoc(snoc(P, A), con(B)), C))
+    => closestSpec(snoc(snoc(P, A), con(B)))
+  rule closestSpec(snoc(snoc(snoc(P, V1:Vowel), V2:Vowel), C))
+    => closestSpec(snoc(snoc(P, V1), V2))
+  rule closestSpec(snoc(snoc(snoc(P, con(A)), V:Vowel), V2:Vowel))
+    => closestSpec(snoc(snoc(P, con(A)), V))
+
+  // A closed constructor term for the submitted solution.  Proof claims use
+  // this exact AST, while krun separately parses solution.mpy itself.
+  syntax Module ::= "solutionProgram"                        [function]
+  rule solutionProgram =>
+    Module(
+      FuncDef("get_closest_vowel", Params("word"),
+        Assign(Name("vowels"), Str("aeiouAEIOU"))
+        If(Compare(Call(Name("len"), Name("word")), CmpOp("<", Int(3))),
+          Return(Str("")),
+          .Stmts)
+        If(Compare(Subscript(Name("word"), UnaryOp("-", Int(2))),
+                   CmpOp("in", Name("vowels"))),
+          If(Compare(Subscript(Name("word"), UnaryOp("-", Int(3))),
+                     CmpOp("not in", Name("vowels"))),
+            If(Compare(Subscript(Name("word"), UnaryOp("-", Int(1))),
+                       CmpOp("not in", Name("vowels"))),
+              Return(Subscript(Name("word"), UnaryOp("-", Int(2)))),
+              .Stmts),
+            .Stmts),
+          .Stmts)
+        Return(Call(Name("get_closest_vowel"),
+                    Subscript(Name("word"),
+                      Slice(NoBound, UnaryOp("-", Int(1)), NoBound))))))
+endmodule

