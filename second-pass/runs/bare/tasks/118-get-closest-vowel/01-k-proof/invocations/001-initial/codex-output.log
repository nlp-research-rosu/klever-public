new file mode 100644
index 0000000000000000000000000000000000000000..f26429f000a131554241de99d83f46b03771df33
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def get_closest_vowel(word):
+    vowels = "aeiouAEIOU"
+    if len(word) < 3:
+        return ""
+    if word[-2] in vowels:
+        if word[-3] not in vowels:
+            if word[-1] not in vowels:
+                return word[-2]
+    return get_closest_vowel(word[:-1])
