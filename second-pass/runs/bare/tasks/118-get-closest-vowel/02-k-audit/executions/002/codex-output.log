index 0000000000000000000000000000000000000000..8c95de70772e280875c91c3b94b69d5d1eed1eaf
--- /dev/null
+++ b/evidence/static/run_body_sensitivity.sh
@@ -0,0 +1,85 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+original=/tmp/audit-work/118-get-closest-vowel/candidate-src
+mutated=/tmp/audit-work/118-get-closest-vowel/body-mutation
