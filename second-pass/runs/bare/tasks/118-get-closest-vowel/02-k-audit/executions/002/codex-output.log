+trace=/generation-evidence/codex-trace/2026/07/22/rollout-2026-07-22T06-47-27-019f89a6-f12e-78d1-90ea-0d9527fcca8d.jsonl
+sed -n '1,3p' "$trace"
+tail -n 3 "$trace"
+
+printf 'EXIT_STATUS=0\n'
