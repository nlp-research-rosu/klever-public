     1	#!/usr/bin/env python3
     2	"""Check that program.k embeds exactly the constructor term in solution.mpy."""
     3	
     4	from pathlib import Path
     5	import re
     6	import sys
     7	
     8	
     9	def expected_program_module(mpy_text):
    10	    # Empty statement lists have no surface text in a standalone .mpy file.
    11	    # K's inner rule parser requires their generated unit constructor.
    12	    inner_term = re.sub(r"(?m)^(\s*)\)(,?)$", r"\1.Stmts)\2", mpy_text.rstrip())
    13	    indented = "\n".join("    " + line for line in inner_term.splitlines())
    14	    return (
    15	        'module SOLUTION-PROGRAM\n'
    16	        '  imports MPY-SYNTAX\n'
    17	        '  syntax Module ::= "solutionProgram" [function]\n'
    18	        '  rule solutionProgram =>\n'
    19	        f'{indented}\n'
    20	        'endmodule\n'
    21	    )
    22	
    23	
    24	def main():
    25	    if len(sys.argv) != 3:
    26	        raise SystemExit("usage: check_program_module.py solution.mpy program.k")
    27	    mpy_path, module_path = map(Path, sys.argv[1:])
    28	    expected = expected_program_module(mpy_path.read_text(encoding="utf-8"))
    29	    actual = module_path.read_text(encoding="utf-8")
    30	    if actual != expected:
    31	        raise SystemExit(f"{module_path} is not generated from {mpy_path}")
    32	
    33	
    34	if __name__ == "__main__":
    35	    main()

