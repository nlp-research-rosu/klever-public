/bin/bash -lc 'kompile semantic.k --backend llvm --main-module MPY --syntax-module MPY-SYNTAX --output-definition /tmp/audit-work/118-get-closest-vowel/build/concrete-kompiled --warnings none 2>&1 | tee /audit-output/evidence/build/kompile-llvm.log
status=${PIPESTATUS[0]}
