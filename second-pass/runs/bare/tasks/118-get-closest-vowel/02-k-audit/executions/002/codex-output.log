+
+cd "$source_dir" || exit 99
+for number in $(seq -w 1 13); do
+  label="SPEC.claim-$number"
+  printf 'COMMAND=kprove spec-audit.k --definition %q --spec-module SPEC --claims %q --warnings none\n' \
