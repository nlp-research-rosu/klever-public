+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact constructor tree generated from solution.py, available as a macro
+  // to the proof claims.  Keeping it in the compiled verification definition
+  // lets spec.k contain claims only, as required by kprove.
+  syntax Program ::= solutionProgram() [macro]
+  syntax Stmt ::= solutionLoop() [macro]
+  rule solutionLoop() =>
+    While(
+      Compare(Name("i"), CmpOp("<", Call(Name("len"), Name("b")))),
+      If(
+        Compare(
+          BinOp("+",
+            Subscript(Name("b"), Slice(Name("i"), NoBound, NoBound)),
+            Subscript(Name("b"), Slice(NoBound, Name("i"), NoBound))),
+          CmpOp("in", Name("a"))),
+        Return(Bool(true)),
+        .Stmts)
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+  rule solutionProgram() =>
+    Module(
+      FuncDef("cycpattern_check", Params("a", "b"),
+        Assign(Name("i"), Int(0))
+        solutionLoop()
+        Return(Bool(false))))
+
+  // A mathematical reference function for the contract: inspect each cyclic
+  // rotation of B in order and ask whether it occurs in A.
+  syntax Bool ::= cyclicContains(String, String) [function, total]
+                | cyclicContainsFrom(String, String, Int) [function, total]
+
+  rule cyclicContains(A, B) => cyclicContainsFrom(A, B, 0)
+  rule cyclicContainsFrom(_A, B, I) => false
+    requires I >=Int lengthString(B)
+  rule cyclicContainsFrom(A, B, I)
+    => true
+    requires I <Int lengthString(B)
+     andBool indexOf(A,
+                     substrString(B, I, lengthString(B))
+                     +String substrString(B, 0, I),
+                     0) >=Int 0
+  rule cyclicContainsFrom(A, B, I)
+    => cyclicContainsFrom(A, B, I +Int 1)
+    requires I <Int lengthString(B)
+     andBool indexOf(A,
+                     substrString(B, I, lengthString(B))
+                     +String substrString(B, 0, I),
+                     0) <Int 0
+endmodule
+
+module VERIFICATION-SYNTAX
+  imports VERIFICATION
+endmodule

codex
The final arbitrary-input theorem also closes with `#Top`, using the proved loop invariant. I’m doing the release pass now: regenerate `solution.mpy`, brute-force the Python implementation on small strings, run shell syntax checks, and execute `prove.sh` exactly as delivered from start to finish.
exec
/bin/bash -lc "python3 - <<'PY'
from itertools import product
from solution import cycpattern_check

def reference(a, b):
    return any(b[i:] + b[:i] in a for i in range(len(b)))

examples = [
    (\"abcd\", \"abd\", False),
    (\"hello\", \"ell\", True),
    (\"whassup\", \"psus\", False),
    (\"abab\", \"baa\", True),
    (\"efef\", \"eeff\", False),
    (\"himenss\", \"simen\", True),
]
for a, b, expected in examples:
    assert cycpattern_check(a, b) is expected

words = [\"\".join(chars) for n in range(5) for chars in product(\"ab\", repeat=n)]
for a in words:
    for b in words:
        assert cycpattern_check(a, b) == reference(a, b), (a, b)
print(f\"Python examples and {len(words) ** 2} exhaustive pairs passed\")
PY
python3 py2mpy.py solution.py > solution.mpy
bash -n prove.sh
./prove.sh" in /work
