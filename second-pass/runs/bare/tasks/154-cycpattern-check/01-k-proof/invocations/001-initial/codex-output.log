+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  configuration
+    <mpy>
+      <k> $PGM:Program ~> start </k>
+      <args> $ARGS:Values </args>
+      <env> .Map </env>
