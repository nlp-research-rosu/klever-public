+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // All six examples from the original prompt.
+  claim <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("abcd") pyStr("abd") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("abcd", "abd"))) </out>
+        </mpy>
+
+  claim <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("hello") pyStr("ell") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("hello", "ell"))) </out>
+        </mpy>
+
+  claim <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("whassup") pyStr("psus") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("whassup", "psus"))) </out>
+        </mpy>
+
+  claim <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("abab") pyStr("baa") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("abab", "baa"))) </out>
+        </mpy>
+
+  claim <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("efef") pyStr("eeff") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("efef", "eeff"))) </out>
+        </mpy>
+
+  claim <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("himenss") pyStr("simen") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("himenss", "simen"))) </out>
+        </mpy>
+
+  // Boundary cases: the unrotated match, a one-character word, and the empty
+  // set of rotations.
+  claim <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("abc") pyStr("abc") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("abc", "abc"))) </out>
+        </mpy>
+
+  claim <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("x") pyStr("x") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("x", "x"))) </out>
+        </mpy>
+
+  claim <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("anything") pyStr("") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("anything", ""))) </out>
+        </mpy>
+
+  // Symbolic boundary theorem: for every first string, an empty second string
+  // has no rotations and the implementation agrees with the contract model.
+  claim <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr(A) pyStr("") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains(A, ""))) </out>
+        </mpy>
+
+  // Loop invariant for arbitrary strings: at index I, the remaining program
+  // computes exactly the remaining rotations in cyclicContainsFrom.
+  claim <mpy>
+          <k> solutionLoop() ~> exec(Return(Bool(false))) => .K </k>
+          <args> pyStr(A) pyStr(B) </args>
+          <env> ("a" |-> pyStr(A)) ("b" |-> pyStr(B)) ("i" |-> pyInt(I))
+                => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContainsFrom(A, B, I))) </out>
+        </mpy>
+    requires 0 <=Int I andBool I <=Int lengthString(B)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d45466b16065e6fe4a17e5bc9b5277a1c9b723b9
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,63 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact constructor tree generated from solution.py, available as a macro
+  // to the proof claims.  Keeping it in the compiled verification definition
+  // lets spec.k contain claims only, as required by kprove.
+  syntax Program ::= solutionProgram() [macro]
+  syntax Stmt ::= solutionLoop() [macro]
+  rule solutionLoop() =>
+    While(
+      Compare(Name("i"), CmpOp("<", Call(Name("len"), Name("b")))),
+      If(
+        Compare(
+          BinOp("+",
+            Subscript(Name("b"), Slice(Name("i"), NoBound, NoBound)),
+            Subscript(Name("b"), Slice(NoBound, Name("i"), NoBound))),
+          CmpOp("in", Name("a"))),
+        Return(Bool(true)),
+        .Stmts)
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+  rule solutionProgram() =>
+    Module(
+      FuncDef("cycpattern_check", Params("a", "b"),
+        Assign(Name("i"), Int(0))
+        solutionLoop()
+        Return(Bool(false))))
+
+  // A mathematical reference function for the contract: inspect each cyclic
+  // rotation of B in order and ask whether it occurs in A.
+  syntax Bool ::= cyclicContains(String, String) [function, total]
+                | cyclicContainsFrom(String, String, Int) [function, total]
+
+  // STRING.find is mathematically defined for every String/String/Int triple.
+  // The builtin hook is not annotated total, so expose that definedness fact
+  // to symbolic execution.
+  rule #Ceil(findString(A1:String, B1:String, I1:Int))
+    => #Ceil(A1) #And #Ceil(B1) #And #Ceil(I1)
+    [simplification]
+
+  rule cyclicContains(A, B) => cyclicContainsFrom(A, B, 0)
+  rule cyclicContainsFrom(A, B, I) => false
+    requires I >=Int lengthString(B)
+  rule cyclicContainsFrom(A, B, I)
+    => true
+    requires I <Int lengthString(B)
+     andBool findString(A,
+                        substrString(B, I, lengthString(B))
+                        +String substrString(B, 0, I),
+                        0) >=Int 0
+  rule cyclicContainsFrom(A, B, I)
+    => cyclicContainsFrom(A, B, I +Int 1)
+    requires I <Int lengthString(B)
+     andBool findString(A,
+                        substrString(B, I, lengthString(B))
+                        +String substrString(B, 0, I),
+                        0) <Int 0
+endmodule
+
+module VERIFICATION-SYNTAX
+  imports VERIFICATION
+endmodule

