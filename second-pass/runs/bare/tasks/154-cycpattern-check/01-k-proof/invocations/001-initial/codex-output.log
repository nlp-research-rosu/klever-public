diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..02415436aa165d592d932a5b5149aad7230354f3
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,53 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact constructor tree generated from solution.py, available as a macro
+  // to the proof claims.  Keeping it in the compiled verification definition
+  // lets spec.k contain claims only, as required by kprove.
+  syntax Program ::= solutionProgram() [macro]
+  rule solutionProgram() =>
+    Module(
+      FuncDef("cycpattern_check", Params("a", "b"),
+        Assign(Name("i"), Int(0))
+        While(
+          Compare(Name("i"), CmpOp("<", Call(Name("len"), Name("b")))),
+          If(
+            Compare(
+              BinOp("+",
+                Subscript(Name("b"), Slice(Name("i"), NoBound, NoBound)),
+                Subscript(Name("b"), Slice(NoBound, Name("i"), NoBound))),
+              CmpOp("in", Name("a"))),
+            Return(Bool(true)),
+            .Stmts)
+          Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+        Return(Bool(false))))
+
+  // A mathematical reference function for the contract: inspect each cyclic
+  // rotation of B in order and ask whether it occurs in A.
+  syntax Bool ::= cyclicContains(String, String) [function, total]
+                | cyclicContainsFrom(String, String, Int) [function, total]
+
+  rule cyclicContains(A, B) => cyclicContainsFrom(A, B, 0)
+  rule cyclicContainsFrom(A, B, I) => false
+    requires I >=Int lengthString(B)
+  rule cyclicContainsFrom(A, B, I)
+    => true
+    requires I <Int lengthString(B)
+     andBool findString(A,
+                        substrString(B, I, lengthString(B))
+                        +String substrString(B, 0, I),
+                        0) >=Int 0
+  rule cyclicContainsFrom(A, B, I)
+    => cyclicContainsFrom(A, B, I +Int 1)
+    requires I <Int lengthString(B)
+     andBool findString(A,
+                        substrString(B, I, lengthString(B))
+                        +String substrString(B, 0, I),
+                        0) <Int 0
+endmodule
+
+module VERIFICATION-SYNTAX
+  imports VERIFICATION
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC' in /work
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..97578f73df291da7c84e1b8e470c8757525fce3e
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,13 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+diff -u solution.mpy <(python3 py2mpy.py solution.py)
+
+kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module VERIFICATION-SYNTAX
+
+krun solution.mpy -cARGS='pyStr("abcd") pyStr("abd")'
+krun solution.mpy -cARGS='pyStr("hello") pyStr("ell")'
+krun solution.mpy -cARGS='pyStr("abab") pyStr("baa")'
+
+kprove spec.k --definition verification-kompiled --spec-module SPEC
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..f2e89a7be46cf562eb63842818e30b9d7be92d13
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,146 @@
+requires "domains.md"
+
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+  imports MAP
+
+  // The constructor syntax emitted by py2mpy.py for the subset used by
+  // solution.py.  Source expressions and run-time values are deliberately
+  // different sorts: evaluating an Expr produces a Value.
+  syntax Program ::= Module(Stmts)
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= FuncDef(String, Params, Stmts)
+                | Assign(Expr, Expr)
+                | While(Expr, Stmts)
+                | If(Expr, Stmts, Stmts)
+                | Return(Expr)
+
+  syntax Params ::= Params(Strings)
+  syntax Strings ::= List{String, ","}
+
+  syntax Expr ::= Name(String)
+                | Int(Int)
+                | Bool(Bool)
+                | Call(Expr, Exprs)
+                | BinOp(String, Expr, Expr)
+                | Compare(Expr, CmpOp)
+                | Subscript(Expr, Slice)
+  syntax Exprs ::= List{Expr, ","}
+  syntax CmpOp ::= CmpOp(String, Expr)
+  syntax Slice ::= Slice(Bound, Bound, Bound)
+  syntax Bound ::= Expr | "NoBound"
+
+  syntax Value ::= pyInt(Int) | pyBool(Bool) | pyStr(String)
+  syntax Values ::= List{Value, ""}
+  syntax Result ::= "NoResult" | Result(Value)
+
+  syntax KItem ::= exec(Stmts)
+                 | assignTo(String)
+                 | whileGuard(Expr, Stmts)
+                 | ifGuard(Stmts, Stmts)
+                 | "ReturnValue"
+                 | binLeft(String, Expr)
+                 | binRight(String, Value)
+                 | compareLeft(String, Expr)
+                 | compareRight(String, Value)
+                 | sliceBase(Bound, Bound, Bound)
+                 | sliceLower(String, Bound, Bound)
+                 | sliceUpper(String, Int, Bound)
+                 | sliceStep(String, Int, Int)
+                 | "LenCall"
+
+  syntax KResult ::= Value
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+
+  configuration
+    <mpy>
+      <k> $PGM:Program ~> start </k>
+      <args> $ARGS:Values </args>
+      <env> .Map </env>
+      <out> NoResult </out>
+    </mpy>
+
+  syntax KItem ::= "start"
+
+  // Loading the one top-level function also invokes the requested HumanEval
+  // entry point.  Function bodies themselves are still evaluated by the
+  // statement and expression rules below.
+  rule <k> Module(FuncDef("cycpattern_check", Params("a", "b"), BODY)) ~> start
+         => exec(BODY) ... </k>
+       <args> pyStr(A) pyStr(B) </args>
+       <env> .Map => ("a" |-> pyStr(A)) ("b" |-> pyStr(B)) </env>
+
+  // Statement sequencing.
+  rule <k> exec(.Stmts) => . ... </k>
+  rule <k> exec(S:Stmt SS:Stmts) => S ~> exec(SS) ... </k>
+
+  rule <k> Assign(Name(X), E) => E ~> assignTo(X) ... </k>
+  rule <k> V:Value ~> assignTo(X) => . ... </k>
+       <env> RHO => RHO [ X <- V ] </env>
+
+  rule <k> If(COND, THEN, ELSE) => COND ~> ifGuard(THEN, ELSE) ... </k>
+  rule <k> pyBool(true) ~> ifGuard(THEN, _) => exec(THEN) ... </k>
+  rule <k> pyBool(false) ~> ifGuard(_, ELSE) => exec(ELSE) ... </k>
+
+  rule <k> While(COND, BODY) => COND ~> whileGuard(COND, BODY) ... </k>
+  rule <k> pyBool(true) ~> whileGuard(COND, BODY)
+         => exec(BODY) ~> While(COND, BODY) ... </k>
+  rule <k> pyBool(false) ~> whileGuard(_, _) => . ... </k>
+
+  rule <k> Return(E) => E ~> ReturnValue ... </k>
+  rule <k> V:Value ~> ReturnValue ~> _REST => .K </k>
+       <out> _ => Result(V) </out>
+
+  // Literals and variables.
+  rule <k> Int(I) => pyInt(I) ... </k>
+  rule <k> Bool(B) => pyBool(B) ... </k>
+  rule <k> Name(X) => V ... </k>
+       <env> ... X |-> V ... </env>
+
+  // The only builtin needed by the submitted program.
+  rule <k> Call(Name("len"), E:Expr) => E ~> LenCall ... </k>
+  rule <k> pyStr(S) ~> LenCall => pyInt(lengthString(S)) ... </k>
+
+  // Left-to-right binary expression evaluation.
+  rule <k> BinOp(OP, L, R) => L ~> binLeft(OP, R) ... </k>
+  rule <k> L:Value ~> binLeft(OP, R) => R ~> binRight(OP, L) ... </k>
+  rule <k> pyInt(R) ~> binRight("+", pyInt(L)) => pyInt(L +Int R) ... </k>
+  rule <k> pyStr(R) ~> binRight("+", pyStr(L)) => pyStr(L +String R) ... </k>
+
+  // Single comparisons (the exact Compare shape used in solution.mpy).
+  rule <k> Compare(L, CmpOp(OP, R)) => L ~> compareLeft(OP, R) ... </k>
+  rule <k> L:Value ~> compareLeft(OP, R) => R ~> compareRight(OP, L) ... </k>
+  rule <k> pyInt(R) ~> compareRight("<", pyInt(L))
+         => pyBool(L <Int R) ... </k>
+  rule <k> pyStr(HAYSTACK) ~> compareRight("in", pyStr(NEEDLE))
+         => pyBool(findString(HAYSTACK, NEEDLE, 0) >=Int 0) ... </k>
+
+  // Python slices used by b[i:] and b[:i].  Bounds are evaluated in source
+  // order.  NoBound defaults to 0 / string length; step defaults to 1.
+  rule <k> Subscript(BASE, Slice(LO, HI, STEP))
+         => BASE ~> sliceBase(LO, HI, STEP) ... </k>
+  rule <k> pyStr(S) ~> sliceBase(NoBound, HI, STEP)
+         => sliceLower(S, HI, STEP) ... </k>
+  rule <k> pyStr(S) ~> sliceBase(LO:Expr, HI, STEP)
+         => LO ~> sliceLower(S, HI, STEP) ... </k>
+  rule <k> sliceLower(S, HI, _STEP)
+         => sliceUpper(S, 0, HI) ... </k>
+  rule <k> pyInt(LO) ~> sliceLower(S, HI, _STEP)
+         => sliceUpper(S, LO, HI) ... </k>
+  rule <k> sliceUpper(S, LO, NoBound)
+         => pyStr(substrString(S, LO, lengthString(S))) ... </k>
+  rule <k> sliceUpper(S, LO, HI:Expr)
+         => HI ~> sliceStep(S, LO, 1) ... </k>
+  rule <k> pyInt(HI) ~> sliceStep(S, LO, 1)
+         => pyStr(substrString(S, LO, HI)) ... </k>
+
+endmodule
