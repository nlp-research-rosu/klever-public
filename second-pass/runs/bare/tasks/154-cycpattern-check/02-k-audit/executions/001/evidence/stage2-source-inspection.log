   106	    requires BV
   107	  rule <k> pyBool(BV) ~> whileGuard(_, _) => .K ... </k>
   108	    requires notBool BV
   109	
   110	  rule <k> Return(E) => E ~> ReturnValue ... </k>
   111	  rule <k> V:Value ~> ReturnValue ~> _REST => .K </k>
   112	       <out> _ => Result(V) </out>
   113	
   114	  // Literals and variables.
   115	  rule <k> Int(I) => pyInt(I) ... </k>
