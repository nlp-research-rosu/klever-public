     4	module VERIFICATION
     5	  imports MPY
     6	  imports SOLUTION-PROGRAM
     7	
     8	  // The loop pattern used by the circular invariant.  solutionProgram() is
     9	  // generated mechanically from solution.mpy in solution-program.k.
    10	  syntax Stmt ::= solutionLoop() [macro]
    11	  rule solutionLoop() =>
    12	    While(
    13	      Compare(Name("i"), CmpOp("<", Call(Name("len"), Name("b")))),
    14	      If(
    15	        Compare(
    16	          BinOp("+",
    17	            Subscript(Name("b"), Slice(Name("i"), NoBound, NoBound)),
    18	            Subscript(Name("b"), Slice(NoBound, Name("i"), NoBound))),
    19	          CmpOp("in", Name("a"))),
    20	        Return(Bool(true)),
    21	        .Stmts)
    22	      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    23	  // A mathematical reference function for the contract: inspect each cyclic
    24	  // rotation of B in order and ask whether it occurs in A.
    25	  syntax Bool ::= cyclicContains(String, String) [function, total]
    26	                | cyclicContainsFrom(String, String, Int) [function, total]
    27	
    28	  rule cyclicContains(A, B) => cyclicContainsFrom(A, B, 0)
    29	  rule cyclicContainsFrom(_A, B, I) => false
    30	    requires I >=Int lengthString(B)
    31	  rule cyclicContainsFrom(A, B, I)
    32	    => true
    33	    requires I <Int lengthString(B)
    34	     andBool indexOf(A,
    35	                     substrString(B, I, lengthString(B))
    36	                     +String substrString(B, 0, I),
    37	                     0) >=Int 0
    38	  rule cyclicContainsFrom(A, B, I)
    39	    => cyclicContainsFrom(A, B, I +Int 1)
    40	    requires I <Int lengthString(B)
    41	     andBool indexOf(A,
    42	                     substrString(B, I, lengthString(B))
    43	                     +String substrString(B, 0, I),
    44	                     0) <Int 0
    45	endmodule
    46	
    47	module VERIFICATION-SYNTAX
    48	  imports VERIFICATION
    49	endmodule
