    84	  rule <k> Module(FuncDef("cycpattern_check", Params("a", "b"), BODY)) ~> start
    85	         => exec(BODY) ... </k>
    86	       <args> pyStr(A) pyStr(B) </args>
    87	       <env> .Map => ("a" |-> pyStr(A)) ("b" |-> pyStr(B)) </env>
    88	
    89	  // Statement sequencing.
    90	  rule <k> exec(.Stmts) => .K ... </k>
    91	  rule <k> exec(S:Stmt SS:Stmts) => S ~> exec(SS) ... </k>
    92	
    93	  rule <k> Assign(Name(X), E) => E ~> assignTo(X) ... </k>
    94	  rule <k> V:Value ~> assignTo(X) => .K ... </k>
    95	       <env> RHO => RHO [ X <- V ] </env>
    96	
    97	  rule <k> If(COND, THEN, ELSE) => COND ~> ifGuard(THEN, ELSE) ... </k>
    98	  rule <k> pyBool(BV) ~> ifGuard(THEN, _) => exec(THEN) ... </k>
    99	    requires BV
   100	  rule <k> pyBool(BV) ~> ifGuard(_, ELSE) => exec(ELSE) ... </k>
   101	    requires notBool BV
   102	
