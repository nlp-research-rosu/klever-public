     6	def cycpattern_check(a , b):
     7	    """You are given 2 words. You need to return True if the second word or any of its rotations is a substring in the first word
     8	    cycpattern_check("abcd","abd") => False
     9	    cycpattern_check("hello","ell") => True
    10	    cycpattern_check("whassup","psus") => False
    11	    cycpattern_check("abab","baa") => True
    12	    cycpattern_check("efef","eeff") => False
    13	    cycpattern_check("himenss","simen") => True
    14	
    15	    """
    16	    l = len(b)
    17	    pat = b + b
    18	    for i in range(len(a) - l + 1):
    19	        for j in range(l + 1):
    20	            if a[i:i+l] == pat[j:j+l]:
    21	                return True
    22	    return False
FILE candidate-src/solution.py
     1	def cycpattern_check(a, b):
     2	    i = 0
     3	    while i < len(b):
     4	        if b[i:] + b[:i] in a:
     5	            return True
     6	        i = i + 1
     7	    return False
