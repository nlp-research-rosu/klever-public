   124	  // Left-to-right binary expression evaluation.
   125	  rule <k> BinOp(OP, L, R) => L ~> binLeft(OP, R) ... </k>
   126	  rule <k> L:Value ~> binLeft(OP, R) => R ~> binRight(OP, L) ... </k>
   127	  rule <k> pyInt(R) ~> binRight("+", pyInt(L)) => pyInt(L +Int R) ... </k>
   128	  rule <k> pyStr(R) ~> binRight("+", pyStr(L)) => pyStr(L +String R) ... </k>
   129	
   130	  // Single comparisons (the exact Compare shape used in solution.mpy).
   131	  rule <k> Compare(L, CmpOp(OP, R)) => L ~> compareLeft(OP, R) ... </k>
   132	  rule <k> L:Value ~> compareLeft(OP, R) => R ~> compareRight(OP, L) ... </k>
   133	  rule <k> pyInt(R) ~> compareRight("<", pyInt(L))
   134	         => pyBool(true) ... </k>
   135	    requires L <Int R
   136	  rule <k> pyInt(R) ~> compareRight("<", pyInt(L))
   137	         => pyBool(false) ... </k>
   138	    requires L >=Int R
   139	  rule <k> pyStr(HAYSTACK) ~> compareRight("in", pyStr(NEEDLE))
   140	         => pyBool(true) ... </k>
   141	    requires indexOf(HAYSTACK, NEEDLE, 0) >=Int 0
   142	  rule <k> pyStr(HAYSTACK) ~> compareRight("in", pyStr(NEEDLE))
   143	         => pyBool(false) ... </k>
   144	    requires indexOf(HAYSTACK, NEEDLE, 0) <Int 0
   145	
   146	  // Python slices used by b[i:] and b[:i].  Bounds are evaluated in source
   147	  // order.  NoBound defaults to 0 / string length; step defaults to 1.
   148	  rule <k> Subscript(BASE, Slice(LO, HI, STEP))
   149	         => BASE ~> sliceBase(LO, HI, STEP) ... </k>
   150	  rule <k> pyStr(S) ~> sliceBase(NoBound, HI, STEP)
   151	         => sliceLower(S, HI, STEP) ... </k>
   152	  rule <k> pyStr(S) ~> sliceBase(LO:Expr, HI, STEP)
   153	         => LO ~> sliceLower(S, HI, STEP) ... </k>
   154	  rule <k> sliceLower(S, HI, _STEP)
   155	         => sliceUpper(S, 0, HI) ... </k>
   156	  rule <k> pyInt(LO) ~> sliceLower(S, HI, _STEP)
   157	         => sliceUpper(S, LO, HI) ... </k>
   158	  rule <k> sliceUpper(S, LO, NoBound)
   159	         => pyStr(substrString(S, LO, lengthString(S))) ... </k>
   160	  rule <k> sliceUpper(S, LO, HI:Expr)
