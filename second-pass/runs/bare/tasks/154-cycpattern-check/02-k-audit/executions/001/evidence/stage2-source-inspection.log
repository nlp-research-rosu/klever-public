     9	  // The constructor syntax emitted by py2mpy.py for the subset used by
    10	  // solution.py.  Source expressions and run-time values are deliberately
    11	  // different sorts: evaluating an Expr produces a Value.
    12	  syntax Program ::= Module(Stmts)
    13	  syntax Stmts ::= List{Stmt, ""}
    14	  syntax Stmt ::= FuncDef(String, Params, Stmts)
    15	                | Assign(Expr, Expr)
    16	                | While(Expr, Stmts)
    17	                | If(Expr, Stmts, Stmts)
    18	                | Return(Expr)
    19	
    20	  syntax Params ::= Params(Strings)
    21	  syntax Strings ::= List{String, ","}
    22	
    23	  syntax Expr ::= Name(String)
    24	                | Int(Int)
    25	                | Bool(Bool)
    26	                | Call(Expr, Exprs)
    27	                | BinOp(String, Expr, Expr)
    28	                | Compare(Expr, CmpOp)
    29	                | Subscript(Expr, Slice)
    30	  syntax Exprs ::= List{Expr, ","}
    31	  syntax CmpOp ::= CmpOp(String, Expr)
    32	  syntax Slice ::= Slice(Bound, Bound, Bound)
    33	  syntax Bound ::= Expr | "NoBound"
    34	
    35	  syntax Value ::= pyInt(Int) | pyBool(Bool) | pyStr(String)
    36	  syntax Values ::= List{Value, ""}
    37	  syntax Result ::= "NoResult" | Result(Value)
    38	
    39	  syntax KItem ::= exec(Stmts)
    40	                 | assignTo(String)
    41	                 | whileGuard(Expr, Stmts)
    42	                 | ifGuard(Stmts, Stmts)
    43	                 | "ReturnValue"
    44	                 | binLeft(String, Expr)
    45	                 | binRight(String, Value)
    46	                 | compareLeft(String, Expr)
    47	                 | compareRight(String, Value)
    48	                 | sliceBase(Bound, Bound, Bound)
    49	                 | sliceLower(String, Bound, Bound)
    50	                 | sliceUpper(String, Int, Bound)
    51	                 | sliceStep(String, Int, Int)
    52	                 | "LenCall"
    53	
    54	  syntax KResult ::= Value
    55	endmodule
