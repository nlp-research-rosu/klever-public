    77	  syntax Int ::= indexOf(String, String, Int) [function, total]
    78	  rule indexOf(HAYSTACK, NEEDLE, FROM)
    79	    => findString(HAYSTACK, NEEDLE, FROM) [concrete]
    80	
    81	  // Loading the one top-level function also invokes the requested HumanEval
    82	  // entry point.  Function bodies themselves are still evaluated by the
