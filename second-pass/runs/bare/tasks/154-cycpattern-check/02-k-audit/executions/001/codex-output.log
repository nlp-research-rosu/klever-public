    74	  claim <mpy>
    75	          <k> solutionProgram() ~> start => .K </k>
    76	          <args> pyStr(A) pyStr("") </args>
    77	          <env> .Map => ?RHO </env>
    78	          <out> NoResult => Result(pyBool(cyclicContains(A, ""))) </out>
    79	        </mpy>
    80	
    81	  // Loop invariant for arbitrary strings: at index I, the remaining program
    82	  // computes exactly the remaining rotations in cyclicContainsFrom.
    83	  claim <mpy>
    84	          <k> solutionLoop() ~> exec(Return(Bool(false))) => .K </k>
    85	          <args> pyStr(A) pyStr(B) </args>
    86	          <env> ("a" |-> pyStr(A)) ("b" |-> pyStr(B)) ("i" |-> pyInt(I))
    87	                => ?RHO </env>
    88	          <out> NoResult => Result(pyBool(cyclicContainsFrom(A, B, I))) </out>
    89	        </mpy>
    90	    requires 0 <=Int I andBool I <=Int lengthString(B)
    91	
    92	  // Whole-program correctness for arbitrary strings.
    93	  claim <mpy>
    94	          <k> solutionProgram() ~> start => .K </k>
    95	          <args> pyStr(A) pyStr(B) </args>
    96	          <env> .Map => ?RHO </env>
    97	          <out> NoResult => Result(pyBool(cyclicContains(A, B))) </out>
    98	        </mpy>
    99	endmodule
