new file mode 100644
index 0000000000000000000000000000000000000000..01269837b4eee86afa5576e71b6dc9fe9b332de4
--- /dev/null
+++ b/evidence/run_each_claim.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+scratch=/tmp/audit-work/154-cycpattern-check
+definition="$scratch/verification-haskell-kompiled"
+spec="$scratch/spec-labeled.k"
+evidence=/audit-output/evidence
+
+labels=(
+  example-abcd
+  example-hello
+  example-whassup
+  example-abab
+  example-efef
+  example-himenss
+  boundary-unrotated
+  boundary-single
+  boundary-empty-ground
+  boundary-empty-symbolic
+  loop-invariant
+)
+
+overall=0
+for label in "${labels[@]}"; do
+  selector="SPEC-LABELED.$label"
+  log="$evidence/kprove_claim_${label}.log"
+  printf 'COMMAND: kprove %q --definition %q --spec-module SPEC-LABELED --claims %q --warnings none\n' \
+    "$spec" "$definition" "$selector" | tee "$log"
+  kprove "$spec" \
+    --definition "$definition" \
+    --spec-module SPEC-LABELED \
+    --claims "$selector" \
+    --warnings none 2>&1 | tee -a "$log"
+  status=${PIPESTATUS[0]}
+  printf 'EXIT_STATUS=%s\n' "$status" | tee -a "$log"
+  if [[ "$status" -ne 0 ]]; then
+    overall=1
+  fi
+done
+
+# The whole-program claim is designed to use the loop claim as its circular
+# invariant, so retain that dependency while selecting this target.
+selector=SPEC-LABELED.loop-invariant,SPEC-LABELED.whole-program
+log="$evidence/kprove_claim_whole-program_with_invariant.log"
+printf 'COMMAND: kprove %q --definition %q --spec-module SPEC-LABELED --claims %q --warnings none\n' \
+  "$spec" "$definition" "$selector" | tee "$log"
+kprove "$spec" \
+  --definition "$definition" \
+  --spec-module SPEC-LABELED \
+  --claims "$selector" \
+  --warnings none 2>&1 | tee -a "$log"
+status=${PIPESTATUS[0]}
+printf 'EXIT_STATUS=%s\n' "$status" | tee -a "$log"
+if [[ "$status" -ne 0 ]]; then
+  overall=1
+fi
+
+printf 'OVERALL_EXIT_STATUS=%s\n' "$overall"
+exit "$overall"
diff --git a/evidence/spec-labeled.k b/evidence/spec-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..1c9b255e94a65aa053eaa4f670017df9c2ec5b8c
--- /dev/null
+++ b/evidence/spec-labeled.k
@@ -0,0 +1,103 @@
+requires "verification.k"
+
+module SPEC-LABELED
+  imports VERIFICATION
+
+  claim [example-abcd]:
+        <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("abcd") pyStr("abd") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("abcd", "abd"))) </out>
+        </mpy>
+
+  claim [example-hello]:
+        <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("hello") pyStr("ell") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("hello", "ell"))) </out>
+        </mpy>
+
+  claim [example-whassup]:
+        <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("whassup") pyStr("psus") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("whassup", "psus"))) </out>
+        </mpy>
+
+  claim [example-abab]:
+        <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("abab") pyStr("baa") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("abab", "baa"))) </out>
+        </mpy>
+
+  claim [example-efef]:
+        <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("efef") pyStr("eeff") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("efef", "eeff"))) </out>
+        </mpy>
+
+  claim [example-himenss]:
+        <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("himenss") pyStr("simen") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("himenss", "simen"))) </out>
+        </mpy>
+
+  claim [boundary-unrotated]:
+        <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("abc") pyStr("abc") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("abc", "abc"))) </out>
+        </mpy>
+
+  claim [boundary-single]:
+        <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("x") pyStr("x") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("x", "x"))) </out>
+        </mpy>
+
+  claim [boundary-empty-ground]:
+        <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("anything") pyStr("") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("anything", ""))) </out>
+        </mpy>
+
+  claim [boundary-empty-symbolic]:
+        <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr(A) pyStr("") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains(A, ""))) </out>
+        </mpy>
+
+  claim [loop-invariant]:
+        <mpy>
+          <k> solutionLoop() ~> exec(Return(Bool(false))) => .K </k>
+          <args> pyStr(A) pyStr(B) </args>
+          <env> ("a" |-> pyStr(A)) ("b" |-> pyStr(B)) ("i" |-> pyInt(I))
+                => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContainsFrom(A, B, I))) </out>
+        </mpy>
+    requires 0 <=Int I andBool I <=Int lengthString(B)
+
+  claim [whole-program]:
+        <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr(A) pyStr(B) </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains(A, B))) </out>
+        </mpy>
+endmodule

