ng(A,\n    39\t                        substrString(B, I, lengthString(B))\n    40\t                        +String substrString(B, 0, I),\n    41\t                        0) >=Int 0\n    42\t  rule cyclicContainsFrom(A, B, I)\n    43\t    => cyclicContainsFrom(A, B, I +Int 1)\n    44\t    requires I <Int lengthString(B)\n    45\t     andBool findString(A,\n    46\t                        substrString(B, I, lengthString(B))\n    47\t                        +String substrString(B, 0, I),\n    48\t                        0) <Int 0\n    49\tendmodule\n    50\t\n    51\tmodule VERIFICATION-SYNTAX\n    52\t  imports VERIFICATION\n    53\tendmodule\n     1\trequires "domains.md"\n     2\t\n     3\tmodule MPY-SYNTAX\n     4\t  imports INT-SYNTAX\n     5\t  imports BOOL-SYNTAX\n     6\t  imports STRING-SYNTAX\n     7\t  imports MAP\n     8\t\n     9\t  // The constructor syntax emitted by py2mpy.py for the subset used by\n    10\t  // solution.py.  Source expressions and run-time values are deliberately\n    11\t  // different sorts: evaluating an Expr produces a Value.\n    12\t  syntax Program ::= Module(Stmts)\n    13\t  syntax Stmts ::= List{Stmt, ""}\n    14\t  syntax Stmt ::= FuncDef(String, Params, Stmts)\n    15\t                | Assign(Expr, Expr)\n    16\t                | While(Expr, Stmts)\n    17\t                | If(Expr, Stmts, Stmts)\n    18\t                | Return(Expr)\n    19\t\n    20\t  syntax Params ::= Params(Strings)\n    21\t  syntax Strings ::= List{String, ","}\n    22\t\n    23\t  syntax Expr ::= Name(String)\n    24\t                | Int(Int)\n    25\t                | Bool(Bool)\n    26\t                | Call(Expr, Exprs)\n    27\t                | BinOp(String, Expr, Expr)\n    28\t                | Compare(Expr, CmpOp)\n    29\t                | Subscript(Expr, Slice)\n    30\t  syntax Exprs ::= List{Expr, ","}\n    31\t  syntax CmpOp ::= CmpOp(String, Expr)\n    32\t  syntax Slice ::= Slice(Bound, Bound, Bound)\n    33\t  syntax Bound ::= Expr | "NoBound"\n    34\t\n    35\t  syntax Value ::= pyInt(Int) | pyBool(Bool) | pyStr(String)\n    36\t  syntax Values ::= List{Value, ""}\n    37\t  syntax Result ::= "NoResult" | Result(Value)\n    38\t\n    39\t  syntax KItem ::= exec(Stmts)\n    40\t                 | assignTo(String)\n    41\t                 | whileGuard(Expr, Stmts)\n    42\t                 | ifGuard(Stmts, Stmts)\n    43\t                 | "ReturnValue"\n    44\t                 | binLeft(String, Expr)\n    45\t                 | binRight(String, Value)\n    46\t                 | compareLeft(String, Expr)\n    47\t                 | compareRight(String, Value)\n    48\t                 | sliceBase(Bound, Bound, Bound)\n    49\t                 | sliceLower(String, Bound, Bound)\n    50\t                 | sliceUpper(String, Int, Bound)\n    51\t                 | sliceStep(String, Int, Int)\n    52\t                 | "LenCall"\n    53\t\n    54\t  syntax KResult ::= Value\n    55\tendmodule\n    56\t\n    57\tmodule MPY\n    58\t  imports MPY-SYNTAX\n    59\t  imports INT\n    60\t  imports BOOL\n    61\t  imports STRING\n    62\t  imports MAP\n    63\t\n    64\t  configuration\n    65\t    <mpy>\n    66\t      <k> $PGM:Program ~> start </k>\n    67\t      <args> $ARGS:Values </args>\n    68\t      <env> .Map </env>\n    69\t      <out> NoResult </out>\n    70\t    </mpy>\n    71\t\n    72\t  syntax KItem ::= "start"\n    73\t\n    74\t  // Loading the one top-level function also invokes the requested HumanEval\n    75\t  // entry point.  Function bodies themselves are still evaluated by the\n    76\t  // statement and expression rules below.\n    77\t  rule <k> Module(FuncDef("cycpattern_check", Params("a", "b"), BODY)) ~> start\n    78\t         => exec(BODY) ... </k>\n    79\t       <args> pyStr(A) pyStr(B) </args>\n    80\t       <env> .Map => ("a" |-> pyStr(A)) ("b" |-> pyStr(B)) </env>\n    81\t\n    82\t  // Statement sequencing.\n    83\t  rule <k> exec(.Stmts) => . ... </k>\n    84\t  rule <k> exec(S:Stmt SS:Stmts) => S ~> exec(SS) ... </k>\n    85\t\n    86\t  rule <k> Assign(Name(X), E) => E ~> assignTo(X) ... </k>\n    87\t  rule <k> V:Value ~> assignTo(X) => . ... </k>\n    88\t       <env> RHO => RHO [ X <- V ] </env>\n    89\t\n    90\t  rule <k> If(COND, THEN, ELSE) => COND ~> ifGuard(THEN, ELSE) ... </k>\n    91\t  rule <k> pyBool(true) ~> ifGuard(THEN, _) => exec(THEN) ... </k>\n    92\t  rule <k> pyBool(false) ~> ifGuard(_, ELSE) => exec(ELSE) ... </k>\n    93\t\n    94\t  rule <k> While(COND, BODY) => COND ~> whileGuard(COND, BODY) ... </k>\n    95\t  rule <k> pyBool(true) ~> whileGuard(COND, BODY)\n    96\t         => exec(BODY) ~> While(COND, BODY) ... </k>\n    97\t  rule <k> pyBool(false) ~> whileGuard(_, _) => . ... </k>\n    98\t\n    99\t  rule <k> Return(E) => E ~> ReturnValue ... </k>\n   100\t  rule <k> V:Value ~> ReturnValue ~> _REST => .K </k>\n   101\t       <out> _ => Result(V) </out>\n   102\t\n   103\t  // Literals and variables.\n   104\t  rule <k> Int(I) => pyInt(I) ... </k>\n   105\t  rule <k> Bool(B) => pyBool(B) ... </k>\n   106\t  rule <k> Name(X) => V ... </k>\n   107\t       <env> ... X |-> V ... </env>\n   108\t\n   109\t  // The only builtin needed by the submitted program.\n   110\t  rule <k> Call(Name("len"), E:Expr) => E ~> LenCall ... </k>\n   111\t  rule <k> pyStr(S) ~> LenCall => pyInt(lengthString(S)) ... </k>\n   112\t\n   113\t  // Left-to-right binary expression evaluation.\n   114\t  rule <k> BinOp(OP, L, R) => L ~> binLeft(OP, R) ... </k>\n   115\t  rule <k> L:Value ~> binLeft(OP, R) => R ~> binRight(OP, L) ... </k>\n   116\t  rule <k> pyInt(R) ~> binRight("+", pyInt(L)) => pyInt(L +Int R) ... </k>\n   117\t  rule <k> pyStr(R) ~> binRight("+", pyStr(L)) => pyStr(L +String R) ... </k>\n   118\t\n   119\t  // Single comparisons (the exact Compare shape used in solution.mpy).\n   120\t  rule <k> Compare(L, CmpOp(OP, R)) => L ~> compareLeft(OP, R) ... </k>\n   121\t  rule <k> L:Value ~> compareLeft(OP, R) => R ~> compareRight(OP, L) ... </k>\n   122\t  rule <k> pyInt(R) ~> compareRight("<", pyInt(L))\n   123\t         => pyBool(L <Int R) ... </k>\n   124\t  rule <k> pyStr(HAYSTACK) ~> compareRight("in", pyStr(NEEDLE))\n   125\t         => pyBool(findString(HAYSTACK, NEEDLE, 0) >=Int 0) ... </k>\n   126\t\n   127\t  // Python slices used by b[i:] and b[:i].  Bounds are evaluated in source\n   128\t  // order.  NoBound defaults to 0 / string length; step defaults to 1.\n   129\t  rule <k> Subscript(BASE, Slice(LO, HI, STEP))\n   130\t         => BASE ~> sliceBase(LO, HI, STEP) ... </k>\n   131\t  rule <k> pyStr(S) ~> sliceBase(NoBound, HI, STEP)\n   132\t         => sliceLower(S, HI, STEP) ... </k>\n   133\t  rule <k> pyStr(S) ~> sliceBase(LO:Expr, HI, STEP)\n   134\t         => LO ~> sliceLower(S, HI, STEP) ... </k>\n   135\t  rule <k> sliceLower(S, HI, _STEP)\n   136\t         => sliceUpper(S, 0, HI) ... </k>\n   137\t  rule <k> pyInt(LO) ~> sliceLower(S, HI, _STEP)\n   138\t         => sliceUpper(S, LO, HI) ... </k>\n   139\t  rule <k> sliceUpper(S, LO, NoBound)\n   140\t         => pyStr(substrString(S, LO, lengthString(S))) ... </k>\n   141\t  rule <k> sliceUpper(S, LO, HI:Expr)\n   142\t         => HI ~> sliceStep(S, LO, 1) ... </k>\n   143\t  rule <k> pyInt(HI) ~> sliceStep(S, LO, 1)\n   144\t         => pyStr(substrString(S, LO, HI)) ... </k>\n   145\t\n   146\tendmodule\n     1\trequires "verification.k"\n     2\t\n     3\tmodule SPEC\n     4\t  imports VERIFICATION\n     5\t\n     6\t  // All six examples from the original prompt.\n     7\t  claim <mpy>\n     8\t          <k> solutionProgram() ~> start => .K </k>\n     9\t          <args> pyStr("abcd") pyStr("abd") </args>\n    10\t          <env> .Map => ?RHO </env>\n    11\t          <out> NoResult => Result(pyBool(cyclicContains("abcd", "abd"))) </out>\n    12\t        </mpy>\n    13\t\n    14\t  claim <mpy>\n    15\t          <k> solutionProgram() ~> start => .K </k>\n    16\t          <args> pyStr("hello") pyStr("ell") </args>\n    17\t          <env> .Map => ?RHO </env>\n    18\t          <out> NoResult => Result(pyBool(cyclicContains("hello", "ell"))) </out>\n    19\t        </mpy>\n    20\t\n    21\t  claim <mpy>\n    22\t          <k> solutionProgram() ~> start => .K </k>\n    23\t          <args> pyStr("whassup") pyStr("psus") </args>\n    24\t          <env> .Map => ?RHO </env>\n    25\t          <out> NoResult => Result(pyBool(cyclicContains("whassup", "psus"))) </out>\n    26\t        </mpy>\n    27\t\n    28\t  claim <mpy>\n    29\t          <k> solutionProgram() ~> start => .K </k>\n    30\t          <args> pyStr("abab") pyStr("baa") </args>\n    31\t          <env> .Map => ?RHO </env>\n    32\t          <out> NoResult => Result(pyBool(cyclicContains("abab", "baa"))) </out>\n    33\t        </mpy>\n    34\t\n    35\t  claim <mpy>\n    36\t          <k> solutionProgram() ~> start => .K </k>\n    37\t          <args> pyStr("efef") pyStr("eeff") </args>\n    38\t          <env> .Map => ?RHO </env>\n    39\t          <out> NoResult => Result(pyBool(cyclicContains("efef", "eeff"))) </out>\n    40\t        </mpy>\n    41\t\n    42\t  claim <mpy>\n    43\t          <k> solutionProgram() ~> start => .K </k>\n    44\t          <args> pyStr("himenss") pyStr("simen") </args>\n    45\t          <env> .Map => ?RHO </env>\n    46\t          <out> NoResult => Result(pyBool(cyclicContains("himenss", "simen"))) </out>\n    47\t        </mpy>\n    48\t\n    49\t  // Boundary cases: the unrotated match, a one-character word, and the empty\n    50\t  // set of rotations.\n    51\t  claim <mpy>\n    52\t          <k> solutionProgram() ~> start => .K </k>\n    53\t          <args> pyStr("abc") pyStr("abc") </args>\n    54\t          <env> .Map => ?RHO </env>\n    55\t          <out> NoResult => Result(pyBool(cyclicContains("abc", "abc"))) </out>\n    56\t        </mpy>\n    57\t\n    58\t  claim <mpy>\n    59\t          <k> solutionProgram() ~> start => .K </

