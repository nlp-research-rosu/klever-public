+"""Wrap the trusted translation of the body-mutated program in a K macro."""
+
+from pathlib import Path
+import re
+
+
+term = Path("solution-body-mutant.mpy").read_text(encoding="utf-8").rstrip()
+term = re.sub(r",\n([ \t]*)\)", r",\n\1.Stmts)", term)
+
