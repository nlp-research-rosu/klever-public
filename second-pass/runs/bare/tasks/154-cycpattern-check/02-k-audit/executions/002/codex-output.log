     7	
     8	term = Path("solution.mpy").read_text(encoding="utf-8").rstrip()
     9	# py2mpy renders an empty statement-list argument as blank space after a
    10	# comma.  A standalone .mpy parser accepts it, while a rule RHS requires the
    11	# explicit list unit.  Both parse to the same .Stmts constructor.
    12	term = re.sub(r",\n([ \t]*)\)", r",\n\1.Stmts)", term)
