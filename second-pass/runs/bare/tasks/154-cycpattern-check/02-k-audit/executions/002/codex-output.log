+requires "verification.k"
+
+module SPEC-LABELED
+  imports VERIFICATION
+
+  claim [example-abcd]:
+        <mpy>
+          <k> solutionProgram() ~> start => .K </k>
+          <args> pyStr("abcd") pyStr("abd") </args>
+          <env> .Map => ?RHO </env>
+          <out> NoResult => Result(pyBool(cyclicContains("abcd", "abd"))) </out>
+        </mpy>
+
+  claim [example-hello]:
