from itertools import product
from solution import cycpattern_check

def reference(a, b):
    return any(b[i:] + b[:i] in a for i in range(len(b)))

examples = [
    (\"abcd\", \"abd\", False),
    (\"hello\", \"ell\", True),
    (\"whassup\", \"psus\", False),
    (\"abab\", \"baa\", True),
    (\"efef\", \"eeff\", False),
    (\"himenss\", \"simen\", True),
]
for a, b, expected in examples:
    assert cycpattern_check(a, b) is expected

words = [\"\".join(chars) for n in range(5) for chars in product(\"ab\", repeat=n)]
for a in words:
    for b in words:
        assert cycpattern_check(a, b) == reference(a, b), (a, b)
print(f\"Python examples and {len(words) ** 2} exhaustive pairs passed\")
