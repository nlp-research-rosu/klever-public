            "module": "VERIFICATION",
            "normalized_sha256": "01b01b51ccb5f30e112b181d8839f4789ef0b9fcc3d5f02a98fb2f9bc4993603",
            "rationale": "This simplification rule is the matching-head recurrence of filterAcc, defining the summary by appending the matching head and recurring on the tail.",
            "source_rule_id": "rule-01b01b51ccb5f30e112b181d8839f4789ef0b9fcc3d5f02a98fb2f9bc4993603",
            "start_line": 11,
            "text": "  rule filterAcc(cons(S, REST), PREFIX, ACC) =>\n    filterAcc(REST, PREFIX, appendOne(ACC, S))\n    requires startsWith(S, PREFIX) ==Bool true [simplification]"
        },
        {
            "attributes": [
