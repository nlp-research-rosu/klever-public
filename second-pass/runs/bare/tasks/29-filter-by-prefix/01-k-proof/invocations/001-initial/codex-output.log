new file mode 100644
index 0000000000000000000000000000000000000000..1745e6f4c3c86ecc2e60f6dd5b5c7e020712fe7a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,36 @@
+module VERIFICATION
+  imports MPY
+
+  // A mathematical, accumulator-based definition of stable prefix filtering.
+  // It is independent of environments, statements, and all control machinery.
+  syntax StrList ::= filterAcc(StrList, String, StrList) [function]
+                   | filterByPrefix(StrList, String) [function]
+
+  rule filterByPrefix(INPUT, PREFIX) => filterAcc(INPUT, PREFIX, nil)
+  rule filterAcc(nil, _, ACC) => ACC
+  rule filterAcc(cons(S, REST), PREFIX, ACC) =>
+    filterAcc(REST, PREFIX, appendOne(ACC, S))
+    requires startsWith(S, PREFIX) ==Bool true [simplification]
+  rule filterAcc(cons(S, REST), PREFIX, ACC) =>
+    filterAcc(REST, PREFIX, ACC)
+    requires startsWith(S, PREFIX) ==Bool false [simplification]
+
+  // Canonical syntax trees used by the proof.  solutionProgram is exactly the
+  // term emitted in solution.mpy (SHA-256 7d10644743b0d635231400e73ff58c5755e17dd09b7a73f64b79fd8fa0a12269,
+  // checked by prove.sh); loopBody is its for-loop body.
+  syntax Stmts ::= loopBody() [function]
+  syntax Module ::= solutionProgram() [function]
+
+  rule loopBody() =>
+    If(Call(Attribute(Name("string"), "startswith"), Name("prefix")),
+       Expr(Call(Attribute(Name("result"), "append"), Name("string"))) .Stmts,
+       .Stmts) .Stmts
+
+  rule solutionProgram() =>
+    Module(
+      ImportFrom("typing", "List", .Strings)
+      FuncDef("filter_by_prefix", Params("strings", "prefix", .Strings),
+        Assign(Name("result"), ListExpr())
+        For(Name("string"), Name("strings"), loopBody())
+        Return(Name("result"))))
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..87d2a75530b3684e35dcfed2524a8866570fa363
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Recreate the exact constructor term from the submitted Python source.
+python3 py2mpy.py solution.py > solution.mpy
+sha256sum solution.mpy | rg -q '^7d10644743b0d635231400e73ff58c5755e17dd09b7a73f64b79fd8fa0a12269  solution\.mpy$'
+
+# Sanity-check the implementation under CPython.
+python3 -c 'from solution import filter_by_prefix as f; assert f([], "a") == []; assert f(["abc", "bcd", "cde", "array"], "a") == ["abc", "array"]; assert f(["", "a", "aa", "b"], "") == ["", "a", "aa", "b"]; assert f(["a"], "aa") == []'
+
+# Build the executable semantics together with its verification functions.
+kompile semantic.k --backend haskell --main-module SEMANTIC --syntax-module VERIFICATION
+
+# Exercise empty input, the prompt example, empty-prefix behavior, and a
+# prefix longer than the candidate string.
+krun solution.mpy --definition semantic-kompiled -cINPUT='nil' -cPREFIX='"a"'
+krun solution.mpy --definition semantic-kompiled -cINPUT='cons("abc", cons("bcd", cons("cde", cons("array", nil))))' -cPREFIX='"a"'
+krun solution.mpy --definition semantic-kompiled -cINPUT='cons("", cons("a", cons("aa", cons("b", nil))))' -cPREFIX='""'
+krun solution.mpy --definition semantic-kompiled -cINPUT='cons("a", nil)' -cPREFIX='"aa"'
+
+# Prove every claim in spec.k.  Success prints #Top and exits zero.
+kprove spec.k --definition semantic-kompiled
