diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..d0440ec0bebf680e8f9a5783550adad710de4a06
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,140 @@
+requires "verification.k"
+
+module MPY-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  // Concrete string lists used both for inputs and Python list values.
+  syntax StrList ::= "nil"
+                   | "cons" "(" String "," StrList ")"
+
+  syntax Module ::= "Module" "(" Stmts ")"
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Strings ::= List{String, ","}
+  syntax Params ::= "Params" "(" Strings ")"
+
+  syntax Stmt ::= "ImportFrom" "(" String "," Strings ")"
+                | "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Expr" "(" Expr ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= Val
+                | "Name" "(" String ")"
+                | "ListExpr" "(" ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "Call" "(" Expr "," Expr ")"
+
+  syntax Val ::= "strVal" "(" String ")"
+               | "listVal" "(" StrList ")"
+               | "boolVal" "(" Bool ")"
+               | "noneVal"
+               | "boundString" "(" String "," String ")"
+               | "boundRef" "(" String "," String ")"
+
+  syntax Function ::= "function" "(" Params "," Stmts ")"
+  syntax Output ::= "noOutput" | Val
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports BOOL
+  imports INT
+  imports STRING
+  imports MAP-SYMBOLIC
+
+  configuration
+    <t>
+      <k> $PGM:Module </k>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <input> $INPUT:StrList </input>
+      <prefix> $PREFIX:String </prefix>
+      <output> noOutput </output>
+    </t>
+
+  syntax KItem ::= "launch"
+                 | "assignTo" "(" String ")"
+                 | "startFor" "(" String "," Stmts ")"
+                 | "loop" "(" String "," Stmts "," StrList ")"
+                 | "choose" "(" Stmts "," Stmts ")"
+                 | "discard"
+                 | "bindStartsWith"
+                 | "callArg" "(" Expr ")"
+                 | "apply" "(" Val ")"
+                 | "doReturn"
+                 | "functionEnd"
+
+  syntax StrList ::= appendOne(StrList, String) [function]
+  rule appendOne(nil, S) => cons(S, nil)
+  rule appendOne(cons(H, T), S) => cons(H, appendOne(T, S))
+
+  syntax Bool ::= startsWith(String, String) [function, total]
+  rule startsWith(S, P) => false
+       requires lengthString(P) >Int lengthString(S)
+  rule startsWith(S, P) => substrString(S, 0, lengthString(P)) ==String P
+       requires lengthString(P) <=Int lengthString(S)
+
+  // Load a translated module, ignore the type-only import, and register defs.
+  rule <k> Module(SS) => SS ~> launch ...</k>
+  rule <k> (S:Stmt SS:Stmts) => S ~> SS ...</k>
+  rule <k> .Stmts => .K ...</k>
+  rule <k> ImportFrom(_, _) => .K ...</k>
+  rule <k> FuncDef(F, PS, BODY) => .K ...</k>
+       <functions> FUNS => FUNS [ F <- function(PS, BODY) ] </functions>
+
+  // The task entry point has two positional arguments: a string list and prefix.
+  rule <k> launch => BODY ~> functionEnd ...</k>
+       <functions> ... "filter_by_prefix" |-> function(Params(P1:String, P2:String, .Strings), BODY) ...</functions>
+       <input> IN </input>
+       <prefix> PRE </prefix>
+       <env> ENV => (ENV [ P1 <- listVal(IN) ]) [ P2 <- strVal(PRE) ] </env>
+
+  // Expressions and calls required by the translated implementation.
+  rule <k> Name(X) => ENV [ X ] ...</k>
+       <env> ENV </env>
+  rule <k> ListExpr() => listVal(nil) ...</k>
+  rule <k> Attribute(Name(X), "startswith") => ENV [ X ] ~> bindStartsWith ...</k>
+       <env> ENV </env>
+  rule <k> strVal(S) ~> bindStartsWith => boundString(S, "startswith") ...</k>
+  rule <k> Attribute(Name(X), "append") => boundRef(X, "append") ...</k>
+  rule <k> Call(F, A) => F ~> callArg(A) ...</k>
+  rule <k> V:Val ~> callArg(A) => A ~> apply(V) ...</k>
+  rule <k> strVal(P) ~> apply(boundString(S, "startswith"))
+        => boolVal(startsWith(S, P)) ...</k>
+  rule <k> strVal(S) ~> apply(boundRef(X, "append")) => noneVal ...</k>
+       <env> ... X |-> (listVal(L) => listVal(appendOne(L, S))) ...</env>
+
+  // Statements, sequencing, and loop control.
+  rule <k> Assign(Name(X), E) => E ~> assignTo(X) ...</k>
+  rule <k> V:Val ~> assignTo(X) => .K ...</k>
+       <env> ENV => ENV [ X <- V ] </env>
+
+  rule <k> For(Name(X), E, BODY) => E ~> startFor(X, BODY) ...</k>
+  rule <k> listVal(L) ~> startFor(X, BODY) => loop(X, BODY, L) ...</k>
+  rule <k> loop(_, _, nil) => .K ...</k>
+  rule <k> loop(X, BODY, cons(H, T)) => BODY ~> loop(X, BODY, T) ...</k>
+       <env> ENV => ENV [ X <- strVal(H) ] </env>
+
+  rule <k> If(E, THEN, ELSE) => E ~> choose(THEN, ELSE) ...</k>
+  rule <k> boolVal(B) ~> choose(THEN, _) => THEN ...</k>
+       requires B ==Bool true
+  rule <k> boolVal(B) ~> choose(_, ELSE) => ELSE ...</k>
+       requires B ==Bool false
+
+  rule <k> Expr(E) => E ~> discard ...</k>
+  rule <k> _:Val ~> discard => .K ...</k>
+
+  rule <k> Return(E) => E ~> doReturn ...</k>
+  rule <k> V:Val ~> doReturn ~> _REST => .K </k>
+       <output> _ => V </output>
+  rule <k> functionEnd => .K ...</k>
+       <output> noOutput => noneVal </output>
+endmodule
+
+module SEMANTIC
+  imports MPY
+  imports VERIFICATION
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..6442499b6794a07fb297285edd6cfe0303425b50
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+from typing import List
+
+
+def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:
+    result = []
+    for string in strings:
+        if string.startswith(prefix):
+            result.append(string)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b263447dfd7bc3e3f89b0fdb544e0140c5fe16b8
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,27 @@
+module SPEC
+  imports SEMANTIC
+
+  // Loop invariant: ACC is the stable result accumulated before INPUT.
+  claim
+    <k> (loop("string", loopBody(), INPUT)
+         ~> Return(Name("result")) ~> .Stmts ~> functionEnd ~> .K)
+      => .K </k>
+    <env> ("prefix" |-> strVal(PREFIX)
+           "result" |-> listVal(ACC)
+           _RESTENV) => ?_ </env>
+    <functions> FUNCTIONS </functions>
+    <input> ALLINPUT </input>
+    <prefix> PREFIX </prefix>
+    <output> noOutput => listVal(filterAcc(INPUT, PREFIX, ACC)) </output>
+    [label(loop-correct)]
+
+  // End-to-end correctness for the exact translated solution and all inputs.
+  claim
+    <k> solutionProgram() => .K </k>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    <input> INPUT </input>
+    <prefix> PREFIX </prefix>
+    <output> noOutput => listVal(filterAcc(INPUT, PREFIX, nil)) </output>
+    [label(program-correct)]
+endmodule
diff --git a/test-spec.k b/test-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2915debab6be7a52c856aef65a2e37381eaf18c7
--- /dev/null
+++ b/test-spec.k
@@ -0,0 +1,5 @@
+module TEST-SPEC
+  imports SEMANTIC
+  claim <k> .K => .K </k>
+        <env> .Map </env>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d43538410ef309843b03eb5a283f1b437077be3b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,35 @@
+module VERIFICATION
+  imports MPY
+
+  // A mathematical, accumulator-based definition of stable prefix filtering.
+  // It is independent of environments, statements, and all control machinery.
+  syntax StrList ::= filterAcc(StrList, String, StrList) [function]
+                   | filterByPrefix(StrList, String) [function]
+
+  rule filterByPrefix(INPUT, PREFIX) => filterAcc(INPUT, PREFIX, nil)
+  rule filterAcc(nil, _, ACC) => ACC
+  rule filterAcc(cons(S, REST), PREFIX, ACC) =>
+    filterAcc(REST, PREFIX, appendOne(ACC, S))
+    requires startsWith(S, PREFIX) ==Bool true [simplification]
+  rule filterAcc(cons(S, REST), PREFIX, ACC) =>
+    filterAcc(REST, PREFIX, ACC)
+    requires startsWith(S, PREFIX) ==Bool false [simplification]
+
+  // Canonical syntax trees used by the proof.  solutionProgram is exactly the
+  // term emitted in solution.mpy; loopBody is its for-loop body.
+  syntax Stmts ::= loopBody() [function]
+  syntax Module ::= solutionProgram() [function]
+
+  rule loopBody() =>
+    If(Call(Attribute(Name("string"), "startswith"), Name("prefix")),
+       Expr(Call(Attribute(Name("result"), "append"), Name("string"))) .Stmts,
+       .Stmts) .Stmts
+
+  rule solutionProgram() =>
+    Module(
+      ImportFrom("typing", "List", .Strings)
+      FuncDef("filter_by_prefix", Params("strings", "prefix", .Strings),
+        Assign(Name("result"), ListExpr())
+        For(Name("string"), Name("strings"), loopBody())
+        Return(Name("result"))))
+endmodule

exec
/bin/bash -lc 'kompile semantic.k --backend haskell --main-module SEMANTIC --syntax-module VERIFICATION && timeout 45 kprove spec.k --definition semantic-kompiled --claims loop-correct,program-correct --trusted loop-correct' in /work
