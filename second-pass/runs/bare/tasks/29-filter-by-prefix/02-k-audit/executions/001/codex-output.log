+| S10 | `Stmt ::= If(Expr, Stmts, Stmts)` | none | Prefix guard |
+| S11 | `Stmt ::= Expr(Expr)` | none | Append call statement |
+| S12 | `Stmt ::= Return(Expr)` | none | Return statement |
