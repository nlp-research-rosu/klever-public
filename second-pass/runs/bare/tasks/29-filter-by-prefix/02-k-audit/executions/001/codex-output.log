+  '^[[:space:]]*(requires|module|endmodule|imports|configuration|syntax|rule|claim)([[:space:]]|$)' \
+  /candidate/semantic.k /candidate/verification.k /candidate/spec.k
+printf 'EXIT: %s\n\n' "$?"
