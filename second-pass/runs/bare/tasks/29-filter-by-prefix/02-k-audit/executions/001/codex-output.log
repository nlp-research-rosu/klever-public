index 0000000000000000000000000000000000000000..4519cd751599413be71d5f75777484ac5e7ebbee
--- /dev/null
+++ b/evidence/04_ground_instances.k
@@ -0,0 +1,34 @@
+module GROUND-INSTANCES
+  imports SEMANTIC
+
+  // Ground instance of program-correct:
+  // INPUT = ["abc", "bcd", "cde", "array"], PREFIX = "a".
+  claim
+    <k> solutionProgram() => .K </k>
+    <env> .Map => ?_ </env>
+    <functions> .Map => ?_ </functions>
+    <input>
+      cons("abc", cons("bcd", cons("cde", cons("array", nil))))
+    </input>
+    <prefix> "a" </prefix>
+    <output> noOutput
+      => listVal(cons("abc", cons("array", nil)))
+    </output>
+    [label(ground-program)]
+
+  // Ground instance of loop-correct:
+  // ACC = ["prior"], remaining INPUT = ["abc", "b"], PREFIX = "a".
+  claim
+    <k> (loop("string", loopBody(), cons("abc", cons("b", nil)))
+         ~> (Return(Name("result")) .Stmts) ~> functionEnd ~> .K)
+      => .K </k>
+    <env> ("prefix" |-> strVal("a")
+           "result" |-> listVal(cons("prior", nil))) => ?_ </env>
+    <functions> .Map </functions>
+    <input> nil </input>
+    <prefix> "a" </prefix>
+    <output> noOutput
+      => listVal(cons("prior", cons("abc", nil)))
+    </output>
+    [label(ground-loop)]
+endmodule
diff --git a/evidence/04_ground_instances.sh b/evidence/04_ground_instances.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ff47c19528353e17571164cfb179613175ff957b
--- /dev/null
+++ b/evidence/04_ground_instances.sh
@@ -0,0 +1,57 @@
+#!/usr/bin/env bash
+set -u
+
+cd /tmp/audit-work/candidate || exit 90
+
+printf '%s\n' 'COMMAND: kprove ground-instances.k --definition /tmp/audit-work/proof-kompiled --spec-module GROUND-INSTANCES --dry-run'
+kprove ground-instances.k \
+  --definition /tmp/audit-work/proof-kompiled \
+  --spec-module GROUND-INSTANCES \
+  --dry-run
+status=$?
+printf 'EXIT: %s\n\n' "$status"
+if test "$status" -ne 0; then
+  exit "$status"
+fi
+
+printf '%s\n' 'COMMAND: kprove ground-instances.k --definition /tmp/audit-work/proof-kompiled --spec-module GROUND-INSTANCES'
+kprove ground-instances.k \
+  --definition /tmp/audit-work/proof-kompiled \
+  --spec-module GROUND-INSTANCES
+status=$?
+printf 'EXIT: %s\n\n' "$status"
+if test "$status" -ne 0; then
+  exit "$status"
+fi
+
+printf '%s\n' 'COMMAND: compare instantiated results with both Python implementations'
+python3 - <<'PY'
+import importlib.util
+from pathlib import Path
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, Path(path))
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.filter_by_prefix
+
+canonical = load("ground_canonical", "/tmp/audit-work/trusted/canonical.py")
+generated = load("ground_generated", "/tmp/audit-work/candidate/solution.py")
