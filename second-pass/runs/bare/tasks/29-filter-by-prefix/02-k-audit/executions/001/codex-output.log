+#!/usr/bin/env bash
+set -u
+
+cd /tmp/audit-work/candidate || exit 90
+overall=0
+
+printf '%s\n' 'COMMAND: kprove spec.k --definition /tmp/audit-work/proof-kompiled --spec-module SPEC --claims loop-correct'
+kprove spec.k \
+  --definition /tmp/audit-work/proof-kompiled \
