+#!/usr/bin/env bash
+set -u
+
+printf '%s\n' 'COMMAND: find candidate top-level K source files'
+find /candidate -maxdepth 1 -type f -name '*.k' -printf '%f %s bytes\n' | sort
+printf 'EXIT: %s\n\n' "$?"
