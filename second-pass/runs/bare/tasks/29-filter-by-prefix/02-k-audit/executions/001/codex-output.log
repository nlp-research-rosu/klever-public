+status=$?
+printf 'EXIT: %s\n\n' "$status"
+if test "$status" -ne 0; then
+  exit "$status"
+fi
+
+printf '%s\n' 'COMMAND: python3 /audit-output/evidence/02_differential.py'
+python3 /audit-output/evidence/02_differential.py
+status=$?
+printf 'EXIT: %s\n' "$status"
+exit "$status"
