#!/usr/bin/env python3
"""Canonical lexical inventory of simplification rules in verification.k."""

from __future__ import annotations

import dataclasses
import hashlib
import json
import re
import stat
from dataclasses import dataclass
from pathlib import Path
from typing import Any


_MODULE_NAME_RE = re.compile(
    r"^[ \t]+(?P<name>[A-Za-z][A-Za-z0-9_-]*)"
    r"(?:[ \t]+\[[^\]\r\n]*\])?[ \t]*$"
)
_TRAILING_ATTRIBUTES_RE = re.compile(
    r"\[(?P<attributes>[^\[\]]*)\][ \t\r\n]*\Z", re.S
)
_CELL_TAG_RE = re.compile(
    r"<(?P<close>/)?(?P<name>[A-Za-z][A-Za-z0-9_'-]*)"
    r"[ \t]*(?P<self_close>/)?>"
)
_OUTER_SENTENCE_KEYWORDS = {
    "imports",
    "syntax",
    "rule",
    "configuration",
    "context",
    "claim",
    "alias",
}


class KRuleInventoryError(RuntimeError):
    """Raised when verification.k cannot produce a canonical inventory."""


@dataclass(frozen=True)
class KRule:
    source_rule_id: str
    start_line: int
    end_line: int
    normalized_sha256: str
    attributes: list[str]
    text: str


@dataclass(frozen=True)
class _Sentence:
    keyword: str
    start: int


@dataclass(frozen=True)
class _Module:
    name: str
    content_start: int
    content_end: int
    sentences: tuple[_Sentence, ...]


@dataclass(frozen=True)
class _RuleSpan:
    rule: KRule
    start_offset: int
    end_offset: int
    attribute_start: int
    attribute_end: int


def canonical_json_sha256(document: Any) -> str:
    encoded = json.dumps(
        document,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
    ).encode()
    return hashlib.sha256(encoded).hexdigest()


def _mask_non_code(text: str) -> str:
    """Mask comments and string bodies without changing source offsets."""

    output = list(text)
    index = 0
    block_depth = 0
    state = "code"
    while index < len(text):
        character = text[index]
        following = text[index + 1] if index + 1 < len(text) else ""
        if state == "line-comment":
            if character in "\r\n":
                state = "code"
            else:
                output[index] = " "
            index += 1
            continue
        if state == "string":
            if character == "\\" and following:
                output[index] = " "
                output[index + 1] = " "
                index += 2
                continue
            if character == '"':
                state = "code"
            elif character not in "\r\n":
                output[index] = " "
            index += 1
            continue
        if state == "block-comment":
            if character == "/" and following == "*":
                output[index] = output[index + 1] = " "
                block_depth += 1
                index += 2
                continue
            if character == "*" and following == "/":
                output[index] = output[index + 1] = " "
                block_depth -= 1
                index += 2
                if block_depth == 0:
                    state = "code"
                continue
            if character not in "\r\n":
                output[index] = " "
            index += 1
            continue
        if character == "/" and following == "/":
            output[index] = output[index + 1] = " "
            state = "line-comment"
            index += 2
            continue
        if character == "/" and following == "*":
            output[index] = output[index + 1] = " "
            state = "block-comment"
            block_depth = 1
            index += 2
            continue
        if character == '"':
            state = "string"
        index += 1
    return "".join(output)


def _line_ranges(text: str, start: int = 0) -> list[tuple[int, int, int]]:
    ranges: list[tuple[int, int, int]] = []
    line_start = start
    while line_start < len(text):
        newline = text.find("\n", line_start)
        next_start = len(text) if newline < 0 else newline + 1
        line_end = len(text) if newline < 0 else newline
        content_end = (
            line_end - 1
            if line_end > line_start and text[line_end - 1] == "\r"
            else line_end
        )
        ranges.append((line_start, content_end, next_start))
        if newline < 0:
            break
        line_start = next_start
    return ranges


def _line_heads(text: str) -> list[tuple[int, int, str, str]]:
    """Return physical-line word heads without assigning K grammar meaning."""

    heads: list[tuple[int, int, str, str]] = []
    for line_start, content_end, _next_start in _line_ranges(text):
        index = line_start
        while index < content_end and text[index] in " \t":
            index += 1
        word_end = index
        while word_end < content_end and (
            text[word_end].isalnum() or text[word_end] in "_'"
        ):
            word_end += 1
        if word_end > index:
            heads.append(
                (
                    line_start,
                    content_end,
                    text[index:word_end],
                    text[word_end:content_end],
                )
            )
    return heads


def _line_word(line: str) -> tuple[str, str, int]:
    stripped = line.lstrip()
    indent = len(line) - len(stripped)
    word_end = 0
    while word_end < len(stripped) and (
        stripped[word_end].isalnum() or stripped[word_end] in "_'"
    ):
        word_end += 1
    return stripped[:word_end], stripped[word_end:], indent + word_end


def _rule_continuation(line: str) -> tuple[str, int] | None:
    stripped = line.lstrip()
    if stripped.startswith("["):
        return "attributes", len(line) - len(stripped)
    word, rest, word_end = _line_word(line)
    for keyword in ("requires", "ensures"):
        if word == keyword and (
            not rest
            or not (
                rest[0].isalnum()
                or rest[0] in "_'"
            )
        ):
            return keyword, word_end
    return None


def _starts_outer_transition(line: str) -> bool:
    keyword, rest, _word_end = _line_word(line)
    separated = bool(rest) and rest[0] in " \t"
    if keyword == "module":
        return separated and _MODULE_NAME_RE.fullmatch(rest) is not None
    if keyword == "endmodule":
        return not rest.strip()
    if keyword == "rule":
        return separated
    return keyword in _OUTER_SENTENCE_KEYWORDS and separated


def _terminal_attribute_line(line: str) -> bool:
    match = _TRAILING_ATTRIBUTES_RE.search(line)
    if match is None:
        return False
    start = match.start()
    return start == 0 or line[start - 1].isspace()


def _scan_rule_delimiters(
    line: str,
    delimiters: list[str],
) -> None:
    closing = {")": "(", "]": "[", "}": "{"}
    index = 0
    while index < len(line):
        if line[index] == "<":
            cell = _CELL_TAG_RE.match(line, index)
            if cell is not None:
                marker = f"<{cell.group('name')}>"
                if cell.group("close"):
                    if delimiters and delimiters[-1] == marker:
                        delimiters.pop()
                elif not cell.group("self_close"):
                    delimiters.append(marker)
                index = cell.end()
                continue
        character = line[index]
        if character in "([{":
            delimiters.append(character)
        elif character in closing:
            if delimiters and delimiters[-1] == closing[character]:
                delimiters.pop()
        index += 1


def _rule_bubble_end(masked_text: str, start: int) -> int:
    """Find when an outer rule bubble returns control to outer parsing."""

    seen_rewrite = False
    clause_has_content = False
    candidate_end: int | None = None
    delimiters: list[str] = []
    ranges = _line_ranges(masked_text, start)
    for line_start, line_end, next_start in ranges:
        line = masked_text[line_start:line_end]
        if not line.strip():
            continue

        continuation = (
            _rule_continuation(line)
            if seen_rewrite and candidate_end is not None
            else None
        )
        if candidate_end is not None:
            if continuation is None and _starts_outer_transition(line):
                return candidate_end
            candidate_end = None

        content_start = 0
        if continuation is not None:
            kind, content_start = continuation
            if kind in {"requires", "ensures"}:
                clause_has_content = False

        if not seen_rewrite:
            rewrite = line.find("=>")
            if rewrite >= 0:
                seen_rewrite = True
                content_start = rewrite + 2
            else:
                content_start = len(line)

        _scan_rule_delimiters(line, delimiters)
        if seen_rewrite and line[content_start:].strip():
            clause_has_content = True

        if (
            seen_rewrite
            and clause_has_content
            and not delimiters
            and _terminal_attribute_line(line)
        ):
            return next_start
        if seen_rewrite and clause_has_content and not delimiters:
            candidate_end = next_start
    if candidate_end is not None:
        return candidate_end
    return len(masked_text) + 1


def _verification_module(masked_text: str) -> _Module:
    modules: list[_Module] = []
    open_module: tuple[str, int, list[_Sentence]] | None = None
    open_rule_until = 0
    for line_start, line_end, keyword, rest in _line_heads(masked_text):
        if line_start < open_rule_until:
            continue
        open_rule_until = 0
        separated = bool(rest) and rest[0] in " \t"
        if keyword == "module":
            if not separated:
                raise KRuleInventoryError(
                    "verification.k has malformed module boundaries"
                )
            named = _MODULE_NAME_RE.fullmatch(rest)
            if named is None or open_module is not None:
                raise KRuleInventoryError(
                    "verification.k has malformed module boundaries"
                )
            open_module = (named.group("name"), line_end, [])
            continue
        if keyword == "endmodule":
            if rest.strip():
                raise KRuleInventoryError(
                    "verification.k has malformed module boundaries"
                )
            if open_module is None:
                raise KRuleInventoryError(
                    "verification.k has malformed module boundaries"
                )
            name, content_start, sentences = open_module
            modules.append(
                _Module(
                    name=name,
                    content_start=content_start,
                    content_end=line_start,
                    sentences=tuple(sentences),
                )
            )
            open_module = None
            continue
        if open_module is not None and keyword == "rule":
            open_module[2].append(
                _Sentence(keyword=keyword, start=line_start)
            )
            open_rule_until = _rule_bubble_end(masked_text, line_start)
            continue
        if (
            open_module is not None
            and keyword in _OUTER_SENTENCE_KEYWORDS
            and separated
        ):
            open_module[2].append(
                _Sentence(keyword=keyword, start=line_start)
            )
    if not modules or open_module is not None:
        raise KRuleInventoryError(
            "verification.k has malformed module boundaries"
        )
    candidates = [
        module
        for module in modules
        if module.name.endswith("VERIFICATION")
        and not module.name.endswith("-SYNTAX")
    ]
    if len(candidates) != 1:
        raise KRuleInventoryError(
            "verification.k must contain exactly one verification module"
        )
    return candidates[0]


def _without_comments(text: str) -> str:
    """Remove K comments while preserving strings and their exact contents."""

    output: list[str] = []
    index = 0
    block_depth = 0
    state = "code"
    while index < len(text):
        character = text[index]
        following = text[index + 1] if index + 1 < len(text) else ""
        if state == "line-comment":
            if character in "\r\n":
                output.append(character)
                state = "code"
            index += 1
            continue
        if state == "string":
            output.append(character)
            if character == "\\" and following:
                output.append(following)
                index += 2
                continue
            if character == '"':
                state = "code"
            index += 1
            continue
        if state == "block-comment":
            if character == "/" and following == "*":
                block_depth += 1
                index += 2
                continue
            if character == "*" and following == "/":
                block_depth -= 1
                index += 2
                if block_depth == 0:
                    state = "code"
                continue
            if character in "\r\n":
                output.append(character)
            index += 1
            continue
        if character == "/" and following == "/":
            output.append(" ")
            state = "line-comment"
            index += 2
            continue
        if character == "/" and following == "*":
            output.append(" ")
            state = "block-comment"
            block_depth = 1
            index += 2
            continue
        output.append(character)
        if character == '"':
            state = "string"
        index += 1
    return "".join(output)


def _attribute_tokens(text: str, masked_text: str) -> list[str]:
    tokens: list[str] = []
    start = 0
    depth = 0
    for index, character in enumerate(masked_text):
        if character in "([{":
            depth += 1
        elif character in ")]}":
            depth = max(depth - 1, 0)
        elif character == "," and depth == 0:
            token = _without_comments(text[start:index]).strip()
            if token:
                tokens.append(token)
            start = index + 1
    final = _without_comments(text[start:]).strip()
    if final:
        tokens.append(final)
    return tokens


def _rule_spans(text: str, module: _Module) -> list[_RuleSpan]:
    masked_text = _mask_non_code(text)
    sentences = module.sentences
    rules: list[_RuleSpan] = []
    seen_hashes: set[str] = set()
    for index, sentence in enumerate(sentences):
        if sentence.keyword != "rule":
            continue
        end_offset = (
            sentences[index + 1].start
            if index + 1 < len(sentences)
            else module.content_end
        )
        start_offset = sentence.start
        raw_segment = text[start_offset:end_offset]
        masked_segment = masked_text[start_offset:end_offset]
        logical_length = len(masked_segment.rstrip(" \t\r\n"))
        if logical_length == 0:
            continue
        rule_text = raw_segment[:logical_length].rstrip(" \t\r\n")
        masked_rule = _mask_non_code(rule_text)
        attribute_match = _TRAILING_ATTRIBUTES_RE.search(masked_rule)
        if attribute_match is None:
            continue
        attribute_start = attribute_match.start("attributes")
        attribute_end = attribute_match.end("attributes")
        attributes = _attribute_tokens(
            rule_text[attribute_start:attribute_end],
            masked_rule[attribute_start:attribute_end],
        )
        if "simplification" not in attributes:
            continue
        normalized = " ".join(rule_text.split())
        digest = hashlib.sha256(normalized.encode()).hexdigest()
        if digest in seen_hashes:
            raise KRuleInventoryError(
                f"duplicate normalized simplification rule hash: {digest}"
            )
        seen_hashes.add(digest)
        start_line = text.count("\n", 0, start_offset) + 1
        end_line = start_line + rule_text.count("\n")
        rule = KRule(
            source_rule_id=f"rule-{digest}",
            start_line=start_line,
            end_line=end_line,
            normalized_sha256=digest,
            attributes=attributes,
            text=rule_text,
        )
        rules.append(
            _RuleSpan(
                rule=rule,
                start_offset=start_offset,
                end_offset=start_offset + len(rule_text),
                attribute_start=start_offset + attribute_match.start(),
                attribute_end=start_offset + attribute_match.end(),
            )
        )
    return rules


def _rule_documents(text: str, module: _Module) -> list[dict[str, Any]]:
    return [
        dataclasses.asdict(span.rule)
        for span in _rule_spans(text, module)
    ]


def _attribute_token_spans(
    text: str,
    masked_text: str,
) -> list[tuple[int, int, str]]:
    spans: list[tuple[int, int, str]] = []
    start = 0
    depth = 0
    for index, character in enumerate(masked_text):
        if character in "([{":
            depth += 1
        elif character in ")]}":
            depth = max(depth - 1, 0)
        elif character == "," and depth == 0:
            spans.append(
                (
                    start,
                    index,
                    _without_comments(text[start:index]).strip(),
                )
            )
            start = index + 1
    spans.append(
        (
            start,
            len(text),
            _without_comments(text[start:]).strip(),
        )
    )
    return spans


def _blank_non_newlines(text: str) -> str:
    return "".join(
        character if character in "\r\n" else " "
        for character in text
    )


def desimplify_rule_ids(
    text: str,
    source_rule_ids: list[str],
) -> str:
    """Remove simplification from exactly the selected canonical rule IDs."""

    if len(source_rule_ids) != len(set(source_rule_ids)):
        raise KRuleInventoryError(
            "exact rule transformation contains a duplicate source rule ID"
        )
    selected = set(source_rule_ids)
    module = _verification_module(_mask_non_code(text))
    spans = _rule_spans(text, module)
    by_id = {span.rule.source_rule_id: span for span in spans}
    unknown = sorted(selected - set(by_id))
    if unknown:
        raise KRuleInventoryError(
            "exact rule transformation names an unknown source rule ID: "
            + ", ".join(unknown)
        )

    edits: list[tuple[int, int]] = []
    for source_rule_id in source_rule_ids:
        span = by_id[source_rule_id]
        attribute_text = text[
            span.attribute_start + 1 : span.attribute_end - 1
        ]
        masked_attributes = _mask_non_code(attribute_text)
        tokens = _attribute_token_spans(
            attribute_text,
            masked_attributes,
        )
        matches = [
            index
            for index, (_start, _end, token) in enumerate(tokens)
            if token == "simplification"
        ]
        if len(matches) != 1:
            raise KRuleInventoryError(
                "selected source rule has ambiguous simplification "
                f"attributes: {source_rule_id}"
            )
        token_index = matches[0]
        if len(tokens) == 1:
            edit_start = span.attribute_start
            edit_end = span.attribute_end
        elif token_index < len(tokens) - 1:
            edit_start = (
                span.attribute_start + 1 + tokens[token_index][0]
            )
            edit_end = (
                span.attribute_start + 1 + tokens[token_index + 1][0]
            )
        else:
            edit_start = (
                span.attribute_start + 1 + tokens[token_index - 1][1]
            )
            edit_end = (
                span.attribute_start + 1 + tokens[token_index][1]
            )
        edits.append((edit_start, edit_end))


diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..dbeaec53441b9e3c79065919d392df611ca20231
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Independent canonical-vs-candidate differential test for HumanEval/29."""
+
+from __future__ import annotations
+
+import importlib.util
+import itertools
+import random
+from pathlib import Path
+
+
+def load_function(path: Path, module_name: str):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.filter_by_prefix
+
+
+oracle = load_function(
+    Path("/tmp/audit-work/29-filter-by-prefix/trusted/canonical.py"),
+    "trusted_canonical_29",
+)
+candidate = load_function(
+    Path("/tmp/audit-work/29-filter-by-prefix/candidate-src/solution.py"),
+    "candidate_solution_29",
+)
+
+cases: list[tuple[list[str], str, str]] = [
+    ([], "a", "prompt-empty"),
+    (["abc", "bcd", "cde", "array"], "a", "prompt-example"),
+    ([], "", "empty-list-empty-prefix"),
+    ([""], "", "empty-string-empty-prefix"),
+    ([""], "a", "empty-string-nonempty-prefix"),
+    (["a"], "", "empty-prefix"),
+    (["a"], "a", "equal-boundary-match"),
+    (["a"], "aa", "prefix-longer-boundary"),
+    (["aa"], "a", "proper-prefix-match"),
+    (["ba"], "a", "same-or-greater-length-nonmatch"),
+    (["a", "a", "ab", "b", "a"], "a", "duplicates-and-order"),
+    (["éclair", "e\u0301clair", "🙂alpha", "🙂"], "é", "unicode-composition"),
+    (["éclair", "e\u0301clair", "🙂alpha", "🙂"], "🙂", "unicode-astral"),
+    (["a\u0000b", "\u0000a", "ab"], "a\u0000", "embedded-nul"),
+]
+
+alphabet = ("a", "b", "é", "🙂")
+string_pool = [""]
+for length in range(1, 4):
+    string_pool.extend("".join(chars) for chars in itertools.product(alphabet, repeat=length))
+
+for value in string_pool:
+    for prefix in string_pool:
+        cases.append(([value], prefix, "exhaustive-singleton"))
+
+rng = random.Random(290029)
+for _ in range(1000):
+    values = [rng.choice(string_pool) for _ in range(rng.randrange(0, 13))]
+    prefix = rng.choice(string_pool)
+    cases.append((values, prefix, "seeded-generated-list"))
+
+mismatches: list[str] = []
+for index, (values, prefix, label) in enumerate(cases):
+    oracle_input = list(values)
+    candidate_input = list(values)
+    expected = oracle(oracle_input, prefix)
+    actual = candidate(candidate_input, prefix)
+    if actual != expected:
+        mismatches.append(
+            f"case={index} label={label} values={values!r} prefix={prefix!r} "
+            f"expected={expected!r} actual={actual!r}"
+        )
+    if oracle_input != values or candidate_input != values:
+        mismatches.append(
+            f"case={index} label={label} input mutation: "
+            f"original={values!r} oracle_after={oracle_input!r} "
+            f"candidate_after={candidate_input!r}"
+        )
+
+print(f"documented_and_boundary_cases=14")
+print(f"exhaustive_singleton_cases={len(string_pool) ** 2}")
+print("seeded_generated_list_cases=1000 seed=290029 max_list_length=12")
+print(f"total_cases={len(cases)}")
+print(f"mismatch_count={len(mismatches)}")
+for mismatch in mismatches[:20]:
+    print(mismatch)
+raise SystemExit(1 if mismatches else 0)
diff --git a/evidence/provenance_check.py b/evidence/provenance_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..5c56a76be8fce0acc9400d7098b1ff0707253ee8
--- /dev/null
+++ b/evidence/provenance_check.py
@@ -0,0 +1,218 @@
+#!/usr/bin/env python3
+"""Independent mounted-input and legacy-selected-stage1 provenance checks."""
+
+from __future__ import annotations
+
+import collections
+import hashlib
+import json
+import os
+import stat
+from pathlib import Path
+
+
+def file_hash(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def pipeline_tree_hash(root: Path) -> str:
+    """Reproduce the length-delimited sha256_tree used by pipeline-v2 records."""
+    digest = hashlib.sha256()
+    pending = [root]
+    entries: list[tuple[str, str, Path]] = []
+    while pending:
+        directory = pending.pop()
+        for child in os.scandir(directory):
+            path = Path(child.path)
+            mode = child.stat(follow_symlinks=False).st_mode
+            relative = path.relative_to(root).as_posix()
+            if stat.S_ISDIR(mode):
+                entries.append((relative, "directory", path))
+                pending.append(path)
+            elif stat.S_ISREG(mode):
+                entries.append((relative, "file", path))
+            else:
+                raise AssertionError(f"linked or unsupported tree entry: {path}")
+    for relative, kind, path in sorted(entries):
+        encoded = relative.encode()
+        digest.update(len(encoded).to_bytes(4, "big"))
+        digest.update(encoded)
+        digest.update(kind.encode() + b"\0")
+        if kind == "file":
+            size = path.stat(follow_symlinks=False).st_size
+            digest.update(size.to_bytes(8, "big"))
+            with path.open("rb") as stream:
+                for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+                    digest.update(chunk)
+    return digest.hexdigest()
+
+
+def require_regular(path: Path) -> None:
+    mode = path.lstat().st_mode
+    assert stat.S_ISREG(mode), f"not a real regular file: {path}"
+
+
+def require_directory(path: Path) -> None:
+    mode = path.lstat().st_mode
+    assert stat.S_ISDIR(mode), f"not a real directory: {path}"
+
+
+def report_hash(path: Path, expected: str) -> None:
+    require_regular(path)
+    actual = file_hash(path)
+    print(f"FILE {path}: expected={expected} actual={actual} match={actual == expected}")
+    assert actual == expected
+
+
+audit_input_path = Path("/audit-input.json")
+campaign_lock_path = Path("/audit-campaign-lock.json")
+require_regular(audit_input_path)
+require_regular(campaign_lock_path)
+audit_input = json.loads(audit_input_path.read_text())
+campaign_lock = json.loads(campaign_lock_path.read_text())
+
+print(f"record_layout={audit_input['record_layout']}")
+print(f"semantics_mode={audit_input['semantics_mode']}")
+assert audit_input["record_layout"] == "legacy-selected-stage1"
+assert audit_input["semantics_mode"] == "GENERATED_SEMANTICS"
+assert campaign_lock == audit_input["audit_campaign"]
+print("campaign_lock_matches_audit_campaign=True")
+report_hash(
+    campaign_lock_path,
+    audit_input["hashes"]["audit_campaign_lock_sha256"],
+)
+
+paths = audit_input["container_paths"]
+required_regular_paths = [
+    Path(paths["candidate"]) / "prompt.py",
+    Path(paths["candidate"]) / "py2mpy.py",
+    Path(paths["canonical"]),
+    Path(paths["trusted_prompt"]),
+    Path(paths["translator"]),
+    Path(paths["run_manifest"]),
+    Path(paths["task_manifest"]),
+    Path(paths["stage1_result"]),
+    Path(paths["generation_manifest"]),
+    Path(paths["generation_metrics"]),
+    Path(paths["generation_last"]),
+    Path(paths["generation_output"]),
+    Path(paths["generation_root"]) / "prompt.txt",
+    Path(paths["generation_root"]) / "usage.json",
+]
+for path in required_regular_paths:
+    require_regular(path)
+
+require_directory(Path(paths["candidate"]))
+require_directory(Path(paths["generation_root"]))
+require_directory(Path(paths["generation_trace"]))
+
+hash_bindings = {
+    Path(paths["canonical"]): "canonical_sha256",
+    Path(paths["trusted_prompt"]): "trusted_prompt_sha256",
+    Path(paths["translator"]): "trusted_translator_sha256",
+    Path(paths["candidate"]) / "prompt.py": "candidate_prompt_sha256",
+    Path(paths["candidate"]) / "py2mpy.py": "candidate_translator_sha256",
+    Path(paths["run_manifest"]): "run_manifest_sha256",
+    Path(paths["task_manifest"]): "task_manifest_sha256",
+    Path(paths["stage1_result"]): "stage1_result_sha256",
+    Path(paths["generation_manifest"]): "stage1_invocation_sha256",
+    Path(paths["generation_metrics"]): "generation_metrics_sha256",
+    Path(paths["generation_last"]): "generation_codex_last_sha256",
+    Path(paths["generation_output"]): "generation_codex_output_sha256",
+    Path(paths["generation_root"]) / "prompt.txt": "generation_prompt_sha256",
+    Path(paths["generation_root"]) / "usage.json": "generation_usage_sha256",
+}
+for path, key in hash_bindings.items():
+    report_hash(path, audit_input["hashes"][key])
+
+task_hash = file_hash(Path(paths["task_manifest"]))
+assert task_hash == audit_input["hashes"]["manifest_sha256"]
+print("manifest_sha256_matches_task_manifest=True")
+
+candidate_root = Path(paths["candidate"])
+proof_artifacts = [
+    "solution.py",
+    "solution.mpy",
+    "semantic.k",
+    "verification.k",
+    "spec.k",
+    "prove.sh",
+]
+for name in proof_artifacts:
+    require_regular(candidate_root / name)
+print(f"candidate_required_artifacts={','.join(proof_artifacts)}")
+
+assert not (Path("/reference") / "reference-semantics").exists()
+assert not (candidate_root / "reference-semantics").exists()
+print("generated_semantics_boundary_reference_semantics_absent=True")
+
+assert (candidate_root / "prompt.py").read_bytes() == Path(paths["trusted_prompt"]).read_bytes()
+assert (candidate_root / "py2mpy.py").read_bytes() == Path(paths["translator"]).read_bytes()
+print("candidate_prompt_byte_matches_trusted=True")
+print("candidate_translator_byte_matches_trusted=True")
+
+candidate_pipeline_hash = pipeline_tree_hash(candidate_root)
+result = json.loads(Path(paths["stage1_result"]).read_text())
+invocation = json.loads(Path(paths["generation_manifest"]).read_text())
+print(f"candidate_pipeline_tree_sha256={candidate_pipeline_hash}")
+print(f"stage1_workspace_sha256={result['outputs']['workspace_sha256']}")
+assert candidate_pipeline_hash == result["outputs"]["workspace_sha256"]
+assert candidate_pipeline_hash == invocation["outputs"]["workspace_sha256"]
+
+usage = json.loads((Path(paths["generation_root"]) / "usage.json").read_text())
+trace_root = Path(paths["generation_trace"])
+trace_pipeline_hash = pipeline_tree_hash(trace_root)
+print(f"trace_pipeline_tree_sha256={trace_pipeline_hash}")
+print(f"usage_source_trace_sha256={usage['source_trace_sha256']}")
+assert trace_pipeline_hash == usage["source_trace_sha256"]
+
+for relative, expected in result["outputs"]["evidence"].items():
+    report_hash(Path(paths["generation_root"]) / relative, expected)
+
+trace_files = sorted(trace_root.rglob("*"))
+for path in trace_files:
+    mode = path.lstat().st_mode
+    assert stat.S_ISDIR(mode) or stat.S_ISREG(mode), f"trace has unsupported entry: {path}"
+
+trace_type_counts: collections.Counter[str] = collections.Counter()
+response_item_counts: collections.Counter[str] = collections.Counter()
+tool_counts: collections.Counter[str] = collections.Counter()
+trace_lines = 0
+final_messages: list[str] = []
+for trace_file in [path for path in trace_files if path.is_file()]:
+    with trace_file.open() as stream:
+        for line_number, line in enumerate(stream, 1):
+            record = json.loads(line)
+            trace_lines += 1
+            trace_type_counts[record["type"]] += 1
+            payload = record.get("payload", {})
+            if record["type"] == "response_item":
+                subtype = payload.get("type", "<missing>")
+                response_item_counts[subtype] += 1
+                if subtype in {"function_call", "custom_tool_call"}:
+                    tool_counts[payload.get("name", "<missing>")] += 1
+                if subtype == "message" and payload.get("role") == "assistant":
+                    text = "\n".join(
+                        item.get("text", "")
+                        for item in payload.get("content", [])
+                        if item.get("type") == "output_text"
+                    )
+                    if text:
+                        final_messages.append(text)
+print(f"trace_json_lines_valid={trace_lines}")
+print(f"trace_types={dict(sorted(trace_type_counts.items()))}")
+print(f"trace_response_item_types={dict(sorted(response_item_counts.items()))}")
+print(f"trace_tool_calls={dict(sorted(tool_counts.items()))}")
+print(f"trace_final_assistant_message={final_messages[-1]!r}")
+
+output_path = Path(paths["generation_output"])
+output_text = output_path.read_text(errors="replace")
+print(f"codex_output_chars_read={len(output_text)}")
+print(f"codex_output_lines_read={len(output_text.splitlines())}")
+print(f"codex_output_top_count={output_text.count('#Top')}")
+
+print("PROVENANCE_CHECK=PASS")
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..fb64cbe1e96406a2faff61c2b611d2ceeb73a46e
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log=$1
+shift
+
+{
+  printf 'WORKDIR: %q\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf 'EXIT_STATUS: %s\n' "$status"
+  exit "$status"
+} > >(tee "$log") 2>&1

