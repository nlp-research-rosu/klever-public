/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import hashlib, os, stat, itertools
roots=[Path('/candidate'),Path('/generation-evidence/codex-trace')]
targets=['178a9cf7ae8f938685c2babfab598c105ee4de1bcf9c13e9c73d6f425fe973d5','bda65c69c0ce8386c66fcf88c51050ef76e8bf3aeb574d8f242e16dff2bb579b']

def entries(root, incdirs):
 out=[]
 for p in sorted(root.rglob('*'),key=lambda p:p.relative_to(root).as_posix()):
  if p.is_symlink(): continue
  if p.is_dir() and incdirs: out.append((p,'directory'))
  elif p.is_file(): out.append((p,'file'))
 return out
pathm=['raw','nul','nl','len4','len8']
kindm=['none','wordnul','word','char','charnul']
modem=['none','octnul','oct','int4','int8']
sizem=['none','asciinul','ascii','int4','int8']
contentm=['raw','hashraw','hashhex','hashhexnl']
ends=['none','nul','nl']
count=0
for incdirs,pm,km,mm,sm,cm,end in itertools.product([False,True],pathm,kindm,modem,sizem,contentm,ends):
 vals=[]
 for root in roots:
  h=hashlib.sha256()
  for p,k in entries(root,incdirs):
   rel=p.relative_to(root).as_posix().encode()
   if pm=='raw': h.update(rel)
   elif pm=='nul': h.update(rel+b'\\0')
   elif pm=='nl': h.update(rel+b'\\n')
   elif pm=='len4': h.update(len(rel).to_bytes(4,'big')+rel)
   elif pm=='len8': h.update(len(rel).to_bytes(8,'big')+rel)
   if km"'!='"'none':
    if km=='wordnul': h.update(k.encode()+b'\\0')
    elif km=='word': h.update(k.encode())
    elif km=='char': h.update((b'f' if k=='file' else b'd'))
    else: h.update((b'f\\0' if k=='file' else b'd\\0'))
   mode=p.stat(follow_symlinks=False).st_mode
   if mm=='octnul': h.update(oct(stat.S_IMODE(mode)).encode()+b'\\0')
   elif mm=='oct': h.update(oct(stat.S_IMODE(mode)).encode())
   elif mm=='int4': h.update(stat.S_IMODE(mode).to_bytes(4,'big'))
   elif mm=='int8': h.update(stat.S_IMODE(mode).to_bytes(8,'big'))
   if k=='file':
    data=p.read_bytes(); size=len(data)
    if sm=='asciinul': h.update(str(size).encode()+b'\\0')
    elif sm=='ascii': h.update(str(size).encode())
    elif sm=='int4': h.update(size.to_bytes(4,'big'))
    elif sm=='int8': h.update(size.to_bytes(8,'big'))
    if cm=='raw': h.update(data)
    elif cm=='hashraw': h.update(hashlib.sha256(data).digest())
    elif cm=='hashhex': h.update(hashlib.sha256(data).hexdigest().encode())
    else: h.update(hashlib.sha256(data).hexdigest().encode()+b'\\n')
   if end=='nul': h.update(b'\\0')
   elif end=='nl': h.update(b'\\n')
  vals.append(h.hexdigest())
 if vals==targets:
  print('FOUND',incdirs,pm,km,mm,sm,cm,end); raise SystemExit
 count+=1
print('not found',count)
