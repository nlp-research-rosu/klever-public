+    Path(paths["generation_root"]) / "prompt.txt": "generation_prompt_sha256",
+    Path(paths["generation_root"]) / "usage.json": "generation_usage_sha256",
+}
+for path, key in hash_bindings.items():
+    report_hash(path, audit_input["hashes"][key])
+
