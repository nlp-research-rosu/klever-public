/bin/bash -lc "python3 - <<'PY'
from itertools import product

def summary(balance, operations):
    if not operations:
        return False
    head, *tail = operations
    updated = balance + head
    return True if updated < 0 else summary(updated, tail)

def operational(balance, operations):
    for operation in operations:
        balance += operation
        if balance < 0:
            return True
    return False

values = (-3, -1, 0, 1, 3)
checked = 0
mismatches = []
for balance in range(-3, 4):
    for length in range(7):
        for operations in product(values, repeat=length):
            checked += 1
            if summary(balance, list(operations)) "'!= operational(balance, operations):
                mismatches.append((balance, operations))
print(f'"'exhaustive_domain=balances[-3..3], lengths[0..6], elements={values}')
print(f'cases_checked={checked}')
print(f'mismatches={len(mismatches)}')
examples = [
    (0, [], False),
    (0, [1, 2, 3], False),
    (0, [1, 2, -4, 5], True),
    (0, [-1], True),
    (0, [5, -5], False),
    (2, [-1, -1], False),
    (2, [-1, -2], True),
]
for balance, operations, expected in examples:
    print(f'witness balance={balance} operations={operations} summary={summary(balance, operations)} operational={operational(balance, operations)} expected={expected}')
mutations = {
    'final-balance-only': lambda b, xs: b + sum(xs) < 0,
    'nonpositive-threshold': lambda b, xs: any(b + sum(xs[:i]) <= 0 for i in range(1, len(xs) + 1)),
    'check-before-add': lambda b, xs: any(b + sum(xs[:i]) < 0 for i in range(0, len(xs))),
}
mutation_witnesses = {
    'final-balance-only': (0, [1, -2, 2]),
    'nonpositive-threshold': (0, [0]),
    'check-before-add': (0, [-1]),
}
for name, mutant in mutations.items():
    balance, operations = mutation_witnesses[name]
    print(f'counterfactual={name} witness=({balance},{operations}) definition={summary(balance, operations)} mutant={mutant(balance, operations)} discriminates={summary(balance, operations) "'!= mutant(balance, operations)}'"')
