+  `e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855`;
+- `lake build` exit 0 with output hash
+  `882e1a85708a6f08f9f08dd7511cd843635b7a4db64989e72788d0226167b31a`;
