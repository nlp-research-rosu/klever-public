    13	          FuncDef("below_zero", Params("operations"),
    14	            Assign(Name("balance"), Int(0))
    15	            For(Name("operation"), Name("operations"),
    16	              AugAssign(Name("balance"), "+", Name("operation"))
    17	              If(Compare(Name("balance"), CmpOp("<", Int(0))),
    18	                Return(Bool(true)),
    19	                .Stmts))
    20	            Return(Bool(false))))
    21	        =>
