    36	
    37	  configuration
    38	    <mpy>
    39	      <k> $PGM:Program </k>
    40	      <input> $OPERATIONS:IntList </input>
    41	      <balance> 0 </balance>
    42	      <current> 0 </current>
    43	      <result> NoResult </result>
    44	    </mpy>
    45	
    46	  syntax KItem ::= "execStmts" "(" Stmts ")"
    47	                 | "setBalance"
    48	                 | "branch" "(" Stmts "," Stmts ")"
    49	                 | "loop" "(" Stmts ")"
    50	                 | "doReturn"
    51	
    52	  rule <k> Module(SS) => execStmts(SS) ... </k>
    53	
    54	  rule <k> execStmts(.Stmts) => .K ... </k>
    55	  rule <k> execStmts(S SS) => S ~> execStmts(SS) ... </k>
    56	
    57	  // Imports and annotations have no run-time effect in this subset.
    58	  rule <k> ImportFrom(_, _) => .K ... </k>
    59	
    60	  // The module is run as a call to the required entry point.  Its sole
    61	  // argument is supplied by the <input> cell.
    62	  rule <k> FuncDef("below_zero", Params("operations"), BODY)
    63	        => execStmts(BODY) ... </k>
    64	
    65	  rule <k> Assign(Name("balance"), E) => E ~> setBalance ... </k>
