     3	module VERIFICATION
     4	  imports SEMANTIC
     5	  imports K-EQUAL
     6	
     7	  // Independent mathematical contract: starting from balance B, report
     8	  // whether some running prefix makes the balance negative.
     9	  syntax Bool ::= belowZeroFrom(Int, IntList) [function, total]
    10	
    11	  rule belowZeroFrom(_, .IntList) => false
    12	  rule belowZeroFrom(B, cons(I, IS))
    13	    => #if B +Int I <Int 0
    14	       #then true
    15	       #else belowZeroFrom(B +Int I, IS)
    16	       #fi
    17	endmodule
     1	module MPY-SYNTAX
     2	  imports BOOL
     3	  imports INT
     4	  imports STRING
     5	
     6	  syntax Program ::= "Module" "(" Stmts ")"
     7	  syntax Stmts ::= List{Stmt, ""}
     8	  syntax Params ::= "Params" "(" Strings ")"
     9	  syntax Strings ::= List{String, ","}
    10	
    11	  syntax Stmt ::= "ImportFrom" "(" String "," Strings ")"
    12	                | "FuncDef" "(" String "," Params "," Stmts ")"
    13	                | "Assign" "(" Expr "," Expr ")"
    14	                | "AugAssign" "(" Expr "," String "," Expr ")"
    15	                | "For" "(" Expr "," Expr "," Stmts ")"
    16	                | "If" "(" Expr "," Stmts "," Stmts ")"
    17	                | "Return" "(" Expr ")"
    18	
    19	  syntax Expr ::= "Name" "(" String ")"
    20	                | "Int" "(" Int ")"
    21	                | "Bool" "(" Bool ")"
    22	                | "Compare" "(" Expr "," CmpOps ")"
    23	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    24	  syntax CmpOps ::= List{CmpOp, ","}
    25	
    26	  syntax IntList ::= ".IntList"
    27	                   | "cons" "(" Int "," IntList ")"
    28	  syntax PyVal ::= "IntV" "(" Int ")"
    29	                 | "BoolV" "(" Bool ")"
    30	                 | "ListV" "(" IntList ")"
    31	  syntax Result ::= "NoResult" | PyVal
    32	endmodule
    33	
    34	module SEMANTIC
