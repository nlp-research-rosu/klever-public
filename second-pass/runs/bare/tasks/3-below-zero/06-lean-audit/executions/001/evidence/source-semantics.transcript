     1	from typing import List
     2	
     3	
     4	def below_zero(operations: List[int]) -> bool:
     5	    balance = 0
     6	    for operation in operations:
     7	        balance += operation
     8	        if balance < 0:
     9	            return True
    10	    return False
     1	from typing import List
     2	
     3	
     4	def below_zero(operations: List[int]) -> bool:
     5	    """ You're given a list of deposit and withdrawal operations on a bank account that starts with
     6	    zero balance. Your task is to detect if at any point the balance of account fallls below zero, and
     7	    at that point function should return True. Otherwise it should return False.
     8	    >>> below_zero([1, 2, 3])
     9	    False
    10	    >>> below_zero([1, 2, -4, 5])
    11	    True
    12	    """

