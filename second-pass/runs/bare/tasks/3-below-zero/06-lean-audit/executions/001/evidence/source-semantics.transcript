    74	  rule <k> ListV(.IntList) ~> loop(_) => .K ... </k>
    75	  rule <k> ListV(cons(I, IS)) ~> loop(BODY)
    76	        => execStmts(BODY) ~> ListV(IS) ~> loop(BODY) ... </k>
    77	       <current> _ => I </current>
    78	
    79	  rule <k> If(E, THEN, ELSE) => E ~> branch(THEN, ELSE) ... </k>
    80	  rule <k> BoolV(true) ~> branch(THEN, _) => execStmts(THEN) ... </k>
    81	  rule <k> BoolV(false) ~> branch(_, ELSE) => execStmts(ELSE) ... </k>
    82	
    83	  rule <k> Return(E) => E ~> doReturn ... </k>
    84	  rule <k> V:PyVal ~> doReturn ~> _ => .K </k>
    85	       <balance> _ => 0 </balance>
    86	       <current> _ => 0 </current>
    87	       <result> NoResult => V </result>
    88	
