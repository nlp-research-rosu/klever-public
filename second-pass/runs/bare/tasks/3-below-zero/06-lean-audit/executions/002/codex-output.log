+        hashlib.sha256(diagnostic["output_tail"].encode()).hexdigest(),
+    )
+
+result = {
+    "command": (
+        "PYTHONPATH=/reference python3 "
+        "/audit-output/evidence/07_recorded_bindings_command.py"
