+sidecar_hashes = {
+    name: hashlib.sha256((generation / name).read_bytes()).hexdigest()
+    for name in sidecar_names
+}
+
+tool_lock_path = Path("/opt/humaneval/data/klean-audit-tools.lock.json")
+tool_lock = json.loads(tool_lock_path.read_text())
