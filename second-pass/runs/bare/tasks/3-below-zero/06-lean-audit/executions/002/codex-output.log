  sed -n '36,57p' /reference/k-proof/spec.k | nl -ba -v36
  printf '%s\\n' '"'$ nl -ba generated Func/Lemmas and obligation map'"'
  nl -ba /reference/klean-generation/generated/Klean3BelowZero/Func.lean
  nl -ba /reference/klean-generation/generated/Klean3BelowZero/Lemmas.lean
