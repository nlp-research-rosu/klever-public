+    },
+    "non_strict_boundary": {
+        "operations": [5, -5],
+        "expected": operational((5, -5)),
+        "mutated": True,
+    },
+    "ignore_head": {
+        "operations": [-1, 2],
+        "expected": operational((-1, 2)),
+        "mutated": operational((2,)),
+    },
+}
+
+print(
+    json.dumps(
+        {
+            "command": (
+                "python3 "
+                "/audit-output/evidence/05_semantic_crosscheck_command.py"
+            ),
+            "domain": {
+                "lengths": "0..5",
+                "element_values": "-3..3",
