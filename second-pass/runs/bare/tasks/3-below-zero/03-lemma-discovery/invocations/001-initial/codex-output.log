import json
from pathlib import Path

inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
output = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}

assert list(output) == ['schema_version', 'inventory_sha256', 'rules']
assert output['schema_version'] == 2
assert output['inventory_sha256'] == inventory['inventory_sha256']
assert len(output['rules']) == len(inventory['rules'])
expected_ids = [rule['source_rule_id'] for rule in inventory['rules']]
actual_ids = [rule['source_rule_id'] for rule in output['rules']]
assert actual_ids == expected_ids
assert len(set(actual_ids)) == len(actual_ids)

by_id = {rule['source_rule_id']: rule for rule in inventory['rules']}
for rule in output['rules']:
    assert list(rule) == ['source_rule_id', 'classification', 'rationale']
    assert rule['classification'] in allowed
    assert isinstance(rule['rationale'], str) and rule['rationale'].strip()
    if 'simplification' in by_id[rule['source_rule_id']]['attributes']:
        assert rule['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}

text = Path('/workspace/DISCOVERY.md').read_text()
assert 'There are no separately proved derived lemmas.' in text
assert 'domain-lemma set is empty' in text.lower()
print(f'validated schema v2: {len(actual_ids)} rules, exact order and coverage')
print('classifications:', [r['classification'] for r in output['rules']])
