+            .Stmts))
+          ~> execStmts(Return(Bool(false)))
+          ~> execStmts(.Stmts)
+      </k>
+      <input> OPS </input>
+      <balance> 0 </balance>
+      <current> 0 </current>
+      <result> NoResult </result>
+    </mpy>
