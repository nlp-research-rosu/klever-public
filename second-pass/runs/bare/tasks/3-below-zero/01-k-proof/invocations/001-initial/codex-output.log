+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // Independent mathematical contract: starting from balance B, report
+  // whether some running prefix makes the balance negative.
+  syntax Bool ::= belowZeroFrom(Int, IntList) [function]
+
+  rule belowZeroFrom(_, .IntList) => false
+  rule belowZeroFrom(B, cons(I, _)) => true
+    requires B +Int I <Int 0
+  rule belowZeroFrom(B, cons(I, IS)) => belowZeroFrom(B +Int I, IS)
+    requires notBool (B +Int I <Int 0)
+endmodule

