+  rule <k> ListV(.IntList) ~> loop(_) => . ... </k>
+  rule <k> ListV(cons(I, IS)) ~> loop(BODY)
+        => execStmts(BODY) ~> ListV(IS) ~> loop(BODY) ... </k>
+       <current> _ => I </current>
+
+  rule <k> If(E, THEN, ELSE) => E ~> branch(THEN, ELSE) ... </k>
+  rule <k> BoolV(true) ~> branch(THEN, _) => execStmts(THEN) ... </k>
