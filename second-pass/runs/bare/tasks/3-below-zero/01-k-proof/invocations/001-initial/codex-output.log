+#!/usr/bin/env bash
+set -euo pipefail
+
+# Recreate the constructor term from the unmodified fixed translator.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Sanity-check the Python implementation on the prompt examples and boundary
+# cases before exercising the translated term.
+python3 - <<'PY'
+from solution import below_zero
+
+cases = [
+    ([], False),
+    ([1, 2, 3], False),
+    ([1, 2, -4, 5], True),
+    ([-1], True),
+    ([5, -5], False),
+]
+for operations, expected in cases:
+    assert below_zero(operations) is expected
+PY
+
+# LLVM gives fast concrete execution of the generated solution.mpy.
+kompile semantic.k \
+  --backend llvm \
+  --main-module SEMANTIC \
+  --syntax-module MPY-SYNTAX \
+  --output-definition semantic-llvm
+
+krun solution.mpy -d semantic-llvm \
+  -cOPERATIONS='cons(1, cons(2, cons(3, .IntList)))'
+krun solution.mpy -d semantic-llvm \
+  -cOPERATIONS='cons(1, cons(2, cons(-4, cons(5, .IntList))))'
+
+# The Haskell backend proves the two compositional claims.  Together they say
+# that the exact translated module reaches the loop cut-point, and that the
+# loop returns the independent recursive prefix-sum specification for every
+# IntList.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-haskell
+
+kprove spec.k -d verification-haskell \
+  --spec-module SPEC \
+  --claims SPEC.entry-reaches-loop
+kprove spec.k -d verification-haskell \
+  --spec-module SPEC \
+  --claims SPEC.loop-correct
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..3b8dc0942a37802ea1fea731a759fccbd75109df
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,103 @@
+module MPY-SYNTAX
+  imports BOOL
+  imports INT
+  imports STRING
+
+  syntax Program ::= "Module" "(" Stmts ")"
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Params ::= "Params" "(" Strings ")"
+  syntax Strings ::= List{String, ","}
+
+  syntax Stmt ::= "ImportFrom" "(" String "," Strings ")"
+                | "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Assign" "(" Expr "," Expr ")"
+                | "AugAssign" "(" Expr "," String "," Expr ")"
+                | "For" "(" Expr "," Expr "," Stmts ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+                | "Return" "(" Expr ")"
+
+  syntax Expr ::= "Name" "(" String ")"
+                | "Int" "(" Int ")"
+                | "Bool" "(" Bool ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+  syntax CmpOps ::= List{CmpOp, ","}
+
+  syntax IntList ::= ".IntList"
+                   | "cons" "(" Int "," IntList ")"
+  syntax PyVal ::= "IntV" "(" Int ")"
+                 | "BoolV" "(" Bool ")"
+                 | "ListV" "(" IntList ")"
+  syntax Result ::= "NoResult" | PyVal
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+
+  configuration
+    <mpy>
+      <k> $PGM:Program </k>
+      <input> $OPERATIONS:IntList </input>
+      <balance> 0 </balance>
+      <current> 0 </current>
+      <result> NoResult </result>
+    </mpy>
+
+  syntax KItem ::= "execStmts" "(" Stmts ")"
+                 | "setBalance"
+                 | "branch" "(" Stmts "," Stmts ")"
+                 | "loop" "(" Stmts ")"
+                 | "doReturn"
+
+  rule <k> Module(SS) => execStmts(SS) ... </k>
+
+  rule <k> execStmts(.Stmts) => .K ... </k>
+  rule <k> execStmts(S SS) => S ~> execStmts(SS) ... </k>
+
+  // Imports and annotations have no run-time effect in this subset.
+  rule <k> ImportFrom(_, _) => .K ... </k>
+
+  // The module is run as a call to the required entry point.  Its sole
+  // argument is supplied by the <input> cell.
+  rule <k> FuncDef("below_zero", Params("operations"), BODY)
+        => execStmts(BODY) ... </k>
+
+  rule <k> Assign(Name("balance"), E) => E ~> setBalance ... </k>
+  rule <k> IntV(I) ~> setBalance => .K ... </k>
+       <balance> _ => I </balance>
+
+  rule <k> AugAssign(Name("balance"), "+", Name("operation")) => .K ... </k>
+       <balance> B => B +Int I </balance>
+       <current> I </current>
+
+  rule <k> For(Name("operation"), E, BODY) => E ~> loop(BODY) ... </k>
+  rule <k> ListV(.IntList) ~> loop(_) => .K ... </k>
+  rule <k> ListV(cons(I, IS)) ~> loop(BODY)
+        => execStmts(BODY) ~> ListV(IS) ~> loop(BODY) ... </k>
+       <current> _ => I </current>
+
+  rule <k> If(E, THEN, ELSE) => E ~> branch(THEN, ELSE) ... </k>
+  rule <k> BoolV(true) ~> branch(THEN, _) => execStmts(THEN) ... </k>
+  rule <k> BoolV(false) ~> branch(_, ELSE) => execStmts(ELSE) ... </k>
+
+  rule <k> Return(E) => E ~> doReturn ... </k>
+  rule <k> V:PyVal ~> doReturn ~> _ => .K </k>
+       <balance> _ => 0 </balance>
+       <current> _ => 0 </current>
+       <result> NoResult => V </result>
+
+  rule <k> Int(I) => IntV(I) ... </k>
+  rule <k> Bool(B) => BoolV(B) ... </k>
+  rule <k> Name("operations") => ListV(IS) ... </k>
+       <input> IS </input>
+  rule <k> Name("operation") => IntV(I) ... </k>
+       <current> I </current>
+  rule <k> Name("balance") => IntV(B) ... </k>
+       <balance> B </balance>
+
+  // Comparisons remain chains in the transliterated syntax.  This task uses
+  // the one-link integer case, whose meaning is Python integer comparison.
+  rule <k> Compare(Name("balance"), CmpOp("<", Int(0)))
+        => BoolV(B <Int 0) ... </k>
+       <balance> B </balance>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..8626e886aa98c5758694b3327efb1365348444d3
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+from typing import List
+
+
+def below_zero(operations: List[int]) -> bool:
+    balance = 0
+    for operation in operations:
+        balance += operation
+        if balance < 0:
+            return True
+    return False
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..30c962b22af767487f5d6dbce0e519a4499cb454
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,57 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The actual Module term generated in solution.mpy reaches the semantic
+  // state immediately before iteration, for an arbitrary input list.
+  claim [entry-reaches-loop]:
+    <mpy>
+      <k>
+        Module(
+          ImportFrom("typing", "List")
+          FuncDef("below_zero", Params("operations"),
+            Assign(Name("balance"), Int(0))
+            For(Name("operation"), Name("operations"),
+              AugAssign(Name("balance"), "+", Name("operation"))
+              If(Compare(Name("balance"), CmpOp("<", Int(0))),
+                Return(Bool(true)),
+                .Stmts))
+            Return(Bool(false))))
+        =>
+        ListV(OPS) ~> loop(
+          AugAssign(Name("balance"), "+", Name("operation"))
+          If(Compare(Name("balance"), CmpOp("<", Int(0))),
+            Return(Bool(true)),
+            .Stmts))
+          ~> execStmts(Return(Bool(false)))
+          ~> execStmts(.Stmts)
+      </k>
+      <input> OPS </input>
+      <balance> 0 </balance>
+      <current> 0 </current>
+      <result> NoResult </result>
+    </mpy>
+
+  // Induction over OPS.  The claim mentions the exact translated loop body
+  // and exact post-loop return, so it proves early return and the boundary
+  // condition (zero is not below zero), not merely a helper function.
+  claim [loop-correct]:
+    <mpy>
+      <k>
+        ListV(OPS) ~> loop(
+          AugAssign(Name("balance"), "+", Name("operation"))
+          If(Compare(Name("balance"), CmpOp("<", Int(0))),
+            Return(Bool(true)),
+            .Stmts))
+          ~> execStmts(Return(Bool(false)))
+          ~> execStmts(.Stmts)
+        => .K
+      </k>
+      <input> _ORIGINAL </input>
+      <balance> B => 0 </balance>
+      <current> _C => 0 </current>
+      <result> NoResult => BoolV(belowZeroFrom(B, OPS)) </result>
+    </mpy>
+    [circularity]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..932ff13c392f0fc3b9f23cba66a6b21c5e09b703
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,17 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+  imports K-EQUAL
+
+  // Independent mathematical contract: starting from balance B, report
+  // whether some running prefix makes the balance negative.
+  syntax Bool ::= belowZeroFrom(Int, IntList) [function, total]
+
+  rule belowZeroFrom(_, .IntList) => false
+  rule belowZeroFrom(B, cons(I, IS))
+    => #if B +Int I <Int 0
+       #then true
+       #else belowZeroFrom(B +Int I, IS)
+       #fi
+endmodule

exec
/bin/bash -lc 'chmod +x prove.sh
./prove.sh' in /work
