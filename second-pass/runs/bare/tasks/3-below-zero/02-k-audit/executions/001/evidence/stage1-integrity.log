COMMAND: bash -lc $'set +e\nprintf "REFERENCE_TREE\\n"\nfind /reference -maxdepth 3 -printf "%y %p -> %l\\n" | sort\nprintf "CANDIDATE_TOP_LEVEL\\n"\nfind /candidate -maxdepth 1 -printf "%y %f -> %l\\n" | sort\nprintf "SOURCE_TYPES\\n"\nfor f in run-input.json metrics.json codex-last.txt codex-output.log prompt.py py2mpy.py solution.py solution.mpy semantic.k spec.k verification.k prove.sh; do stat -c "%F %s %n" "/candidate/$f"; done\nprintf "SYMLINKS\\n"\nfind /candidate -type l -printf "%p -> %l\\n" | sort\nprintf "REFERENCE_SEMANTICS_BOUNDARY\\n"\nif test -e /reference/reference-semantics || test -L /reference/reference-semantics; then echo PRESENT; else echo ABSENT_EXPECTED; fi\nprintf "PROMPT_COMPARE\\n"\ncmp -s /candidate/prompt.py /reference/prompt.py; echo "prompt_cmp_status=$?"\nsha256sum /candidate/prompt.py /reference/prompt.py\nprintf "TRANSLATOR_COMPARE\\n"\ncmp -s /candidate/py2mpy.py /reference/py2mpy.py; echo "translator_cmp_status=$?"\nsha256sum /candidate/py2mpy.py /reference/py2mpy.py\nprintf "TRACE_FILES\\n"\nfind /candidate/codex-trace -type f -printf "%s %p\\n" | sort\nexit 0'
