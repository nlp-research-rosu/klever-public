+              AugAssign(Name("balance"), "+", Name("operation"))
+              If(Compare(Name("balance"), CmpOp("<", Int(0))),
+                Return(Bool(true)),
+                .Stmts))
+            Return(Bool(false))))
+        => .K
+      </k>
+      <input> cons(1, cons(-1, .IntList)) </input>
