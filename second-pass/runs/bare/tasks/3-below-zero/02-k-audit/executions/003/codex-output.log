+                Return(Bool(false)),
+                .Stmts))
+            Return(Bool(false))))
+        =>
+        ListV(OPS) ~> loop(
+          AugAssign(Name("balance"), "+", Name("operation"))
+          If(Compare(Name("balance"), CmpOp("<", Int(0))),
+            Return(Bool(true)),
+            .Stmts))
+          ~> execStmts(Return(Bool(false)))
+          ~> execStmts(.Stmts)
+      </k>
+      <input> OPS </input>
+      <balance> 0 </balance>
+      <current> 0 </current>
+      <result> NoResult </result>
