+
+    if (paths["candidate"] / "prompt.py").read_bytes() != paths[
+        "trusted_prompt"
+    ].read_bytes():
+        raise ValueError("candidate prompt differs from trusted prompt")
+    if (paths["candidate"] / "py2mpy.py").read_bytes() != paths[
+        "translator"
