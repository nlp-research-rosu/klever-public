diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..8492dc8ec84a7510f787d8ad804b99a0e10bbf6e
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,18 @@
+from typing import List
+
+
+def parse_nested_parens(paren_string: str) -> List[int]:
+    result = []
+    groups = paren_string.split(" ")
+    for group in groups:
+        depth = 0
+        maximum = 0
+        for character in group:
+            if character == "(":
+                depth += 1
+                if depth > maximum:
+                    maximum = depth
+            else:
+                depth -= 1
+        result.append(maximum)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..3b4b998f57a35099d8da59a5bcaab795567c14a0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,63 @@
+requires "verification.k"
+
+module SPEC
+  imports MPY-VERIFICATION
+
+  // The example in prompt.py.
+  claim
+    <mpy>
+      <k> solutionProgram </k>
+      <input> "(()()) ((())) () ((())()())" </input>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult </result>
+    </mpy>
+  =>
+    <mpy>
+      <k> .K </k>
+      <input> "(()()) ((())) () ((())()())" </input>
+      <env> _:Map </env>
+      <functions> _:Map </functions>
+      <result>
+        result(pyList(pyInt(2) :: pyInt(3) :: pyInt(1) :: pyInt(3) :: .PyVals))
+      </result>
+    </mpy>
+
+  // Increasing nesting depths across four groups.
+  claim
+    <mpy>
+      <k> solutionProgram </k>
+      <input> "() (()) ((())) (((())))" </input>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult </result>
+    </mpy>
+  =>
+    <mpy>
+      <k> .K </k>
+      <input> "() (()) ((())) (((())))" </input>
+      <env> _:Map </env>
+      <functions> _:Map </functions>
+      <result>
+        result(pyList(pyInt(1) :: pyInt(2) :: pyInt(3) :: pyInt(4) :: .PyVals))
+      </result>
+    </mpy>
+
+  // A single group whose deepest point is nested four levels.
+  claim
+    <mpy>
+      <k> solutionProgram </k>
+      <input> "(()(())((())))" </input>
+      <env> .Map </env>
+      <functions> .Map </functions>
+      <result> noResult </result>
+    </mpy>
+  =>
+    <mpy>
+      <k> .K </k>
+      <input> "(()(())((())))" </input>
+      <env> _:Map </env>
+      <functions> _:Map </functions>
+      <result> result(pyList(pyInt(4) :: .PyVals)) </result>
+    </mpy>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..453d0ade4bca9e057865eae26ee5a95e364dd9c5
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,30 @@
+requires "semantic.k"
+
+module MPY-VERIFICATION
+  imports MPY-SEMANTICS
+
+  // A proof-facing name for the exact constructor tree in solution.mpy.  This
+  // is a macro, not an implementation shortcut: after parsing, every claim
+  // contains the same Module term that krun reads from solution.mpy.
+  syntax Program ::= "solutionProgram" [function]
+  rule solutionProgram =>
+    Module(
+      ImportFrom("typing", "List")
+      FuncDef("parse_nested_parens", Params("paren_string"),
+        Assign(Name("result"), ListExpr(.Exprs))
+        Assign(
+          Name("groups"),
+          Call(Attribute(Name("paren_string"), "split"), Str(" ")))
+        For(Name("group"), Name("groups"),
+          Assign(Name("depth"), Int(0))
+          Assign(Name("maximum"), Int(0))
+          For(Name("character"), Name("group"),
+            If(Compare(Name("character"), CmpOp("==", Str("("))),
+              AugAssign(Name("depth"), "+", Int(1))
+              If(Compare(Name("depth"), CmpOp(">", Name("maximum"))),
+                Assign(Name("maximum"), Name("depth")),
+                .Stmts),
+              AugAssign(Name("depth"), "-", Int(1))))
+          Expr(Call(Attribute(Name("result"), "append"), Name("maximum"))))
+        Return(Name("result"))))
+endmodule

