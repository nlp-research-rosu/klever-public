+module MPY-VERIFICATION
+  imports MPY-SEMANTICS
+
+  // This module is deliberately small: spec.k imports it as the proof-facing
+  // module, while all operational rules remain in MPY-SEMANTICS.
+endmodule

exec
/bin/bash -lc "kompile semantic.k --main-module MPY-SEMANTICS --syntax-module MPY-SYNTAX --backend llvm >/tmp/kompile-semantic.log 2>&1 && krun solution.mpy --definition semantic-kompiled -cINPUT='\"(()()) ((())) () ((())()())\"'" in /work
