ompt.py.\n  claim\n    <mpy>\n      <k> solutionProgram </k>\n      <input> \"(()()) ((())) () ((())()())\" </input>\n      <env> .Map </env>\n      <functions> .Map </functions>\n      <result> noResult </result>\n    </mpy>\n  =>\n    <mpy>\n      <k> .K </k>\n      <input> \"(()()) ((())) () ((())()())\" </input>\n      <env> _:Map </env>\n      <functions> _:Map </functions>\n      <result>\n        result(pyList(pyInt(2) :: pyInt(3) :: pyInt(1) :: pyInt(3) :: .PyVals))\n      </result>\n    </mpy>\n\n  // Increasing nesting depths across four groups.\n  claim\n    <mpy>\n      <k> solutionProgram </k>\n      <input> \"() (()) ((())) (((())))\" </input>\n      <env> .Map </env>\n      <functions> .Map </functions>\n      <result> noResult </result>\n    </mpy>\n  =>\n    <mpy>\n      <k> .K </k>\n      <input> \"() (()) ((())) (((())))\" </input>\n      <env> _:Map </env>\n      <functions> _:Map </functions>\n      <result>\n        result(pyList(pyInt(1) :: pyInt(2) :: pyInt(3) :: pyInt(4) :: .PyVals))\n      </result>\n    </mpy>\n\n  // A single group whose deepest point is nested four levels.\n  claim\n    <mpy>\n      <k> solutionProgram </k>\n      <input> \"(()(())((())))\" </input>\n      <env> .Map </env>\n      <functions> .Map </functions>\n      <result> noResult </result>\n    </mpy>\n  =>\n    <mpy>\n      <k> .K </k>\n      <input> \"(()(())((())))\" </input>\n      <env> _:Map </env>\n      <functions> _:Map </functions>\n      <result> result(pyList(pyInt(4) :: .PyVals)) </result>\n    </mpy>\nendmodule\n"}},"status":"completed"}}
