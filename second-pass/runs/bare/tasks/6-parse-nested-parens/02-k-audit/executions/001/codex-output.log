new file mode 100644
index 0000000000000000000000000000000000000000..911cdad5fb0353581b2cf96c9ea2e9ef94051f6c
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -u
+
+if [ "$#" -lt 2 ]; then
+  echo "usage: $0 LOG_NAME COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_name=$1
+shift
+log_path="/audit-output/evidence/${log_name}"
+
+{
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$log_path"
+
+set +e
+"$@" > >(tee -a "$log_path") 2> >(tee -a "$log_path" >&2)
+command_status=$?
+set -e
+
+printf 'EXIT_STATUS: %d\n' "$command_status" | tee -a "$log_path"
+exit "$command_status"

