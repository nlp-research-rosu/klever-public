if [ -e /reference/reference-semantics ] || [ -L /reference/reference-semantics ]; then echo 'MODE_BOUNDARY=BREACH_PRESENT'; stat -c '%F %n -> %N' /reference/reference-semantics; else echo 'MODE_BOUNDARY=OK_ABSENT'; fi
