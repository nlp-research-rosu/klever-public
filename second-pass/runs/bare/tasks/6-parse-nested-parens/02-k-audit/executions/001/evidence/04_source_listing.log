     1	requires "semantic.k"
     2	
     3	module MPY-VERIFICATION
     4	  imports MPY-SEMANTICS
     5	
     6	  // A proof-facing name for the exact constructor tree in solution.mpy.  This
     7	  // is a macro, not an implementation shortcut: after parsing, every claim
     8	  // contains the same Module term that krun reads from solution.mpy.
     9	  syntax Program ::= "solutionProgram" [function]
    10	  rule solutionProgram =>
    11	    Module(
    12	      ImportFrom("typing", "List")
    13	      FuncDef("parse_nested_parens", Params("paren_string"),
    14	        Assign(Name("result"), ListExpr(.Exprs))
    15	        Assign(
    16	          Name("groups"),
    17	          Call(Attribute(Name("paren_string"), "split"), Str(" ")))
    18	        For(Name("group"), Name("groups"),
    19	          Assign(Name("depth"), Int(0))
    20	          Assign(Name("maximum"), Int(0))
    21	          For(Name("character"), Name("group"),
    22	            If(Compare(Name("character"), CmpOp("==", Str("("))),
    23	              AugAssign(Name("depth"), "+", Int(1))
    24	              If(Compare(Name("depth"), CmpOp(">", Name("maximum"))),
    25	                Assign(Name("maximum"), Name("depth")),
    26	                .Stmts),
    27	              AugAssign(Name("depth"), "-", Int(1))))
    28	          Expr(Call(Attribute(Name("result"), "append"), Name("maximum"))))
    29	        Return(Name("result"))))
    30	endmodule
FILE=/candidate/prove.sh
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd -- "$(dirname -- "$0")"
     5	
     6	# Translate the submitted Python source without modifying the fixed front end.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	
     9	# Build the executable semantics and exercise the actual translated program.
    10	kompile semantic.k \
    11	  --main-module MPY-SEMANTICS \
    12	  --syntax-module MPY-SYNTAX \
    13	  --backend llvm
    14	krun solution.mpy \
    15	  --definition semantic-kompiled \
    16	  -cINPUT='"(()()) ((())) () ((())()())"'
    17	
    18	# Build the proof definition and close every positive claim in spec.k.
    19	kompile verification.k \
    20	  --main-module MPY-VERIFICATION \
    21	  --syntax-module MPY-VERIFICATION \
    22	  --backend haskell
    23	kprove spec.k \
    24	  --definition verification-kompiled \
    25	  --spec-module SPEC
    26	
    27	# A wrong expected answer must not prove.
    28	if kprove mutation-spec.k \
    29	     --definition verification-kompiled \
    30	     --spec-module MUTATION-SPEC; then
    31	  echo "ERROR: the deliberately false mutation claim unexpectedly proved" >&2
    32	  exit 1
    33	else
    34	  echo "Expected failure: mutation claim was rejected"
    35	fi
