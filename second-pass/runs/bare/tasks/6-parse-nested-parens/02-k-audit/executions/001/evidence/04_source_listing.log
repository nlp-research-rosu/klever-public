     4	def parse_nested_parens(paren_string: str) -> List[int]:
     5	    """ Input to this function is a string represented multiple groups for nested parentheses separated by spaces.
     6	    For each of the group, output the deepest level of nesting of parentheses.
     7	    E.g. (()()) has maximum two levels of nesting while ((())) has three.
     8	
     9	    >>> parse_nested_parens('(()()) ((())) () ((())()())')
    10	    [2, 3, 1, 3]
    11	    """
FILE=/reference/canonical.py
     1	# canonical.py — the UNMODIFIED HumanEval/6 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: parse_nested_parens
     4	
     5	from typing import List
     6	
     7	
     8	def parse_nested_parens(paren_string: str) -> List[int]:
     9	    """ Input to this function is a string represented multiple groups for nested parentheses separated by spaces.
    10	    For each of the group, output the deepest level of nesting of parentheses.
    11	    E.g. (()()) has maximum two levels of nesting while ((())) has three.
    12	
    13	    >>> parse_nested_parens('(()()) ((())) () ((())()())')
    14	    [2, 3, 1, 3]
    15	    """
    16	    def parse_paren_group(s):
    17	        depth = 0
    18	        max_depth = 0
    19	        for c in s:
    20	            if c == '(':
    21	                depth += 1
    22	                max_depth = max(depth, max_depth)
    23	            else:
    24	                depth -= 1
    25	
    26	        return max_depth
    27	
    28	    return [parse_paren_group(x) for x in paren_string.split(' ') if x]
FILE=/candidate/solution.py
     1	from typing import List
     2	
     3	
     4	def parse_nested_parens(paren_string: str) -> List[int]:
     5	    result = []
     6	    groups = paren_string.split(" ")
     7	    for group in groups:
     8	        depth = 0
     9	        maximum = 0
    10	        for character in group:
    11	            if character == "(":
    12	                depth += 1
    13	                if depth > maximum:
    14	                    maximum = depth
    15	            else:
    16	                depth -= 1
    17	        result.append(maximum)
    18	    return result
FILE=/candidate/solution.mpy
     1	Module(
     2	  ImportFrom("typing", "List")
     3	  FuncDef("parse_nested_parens", Params("paren_string"),
     4	    Assign(Name("result"), ListExpr())
     5	    Assign(
     6	      Name("groups"),
     7	      Call(Attribute(Name("paren_string"), "split"), Str(" ")))
     8	    For(Name("group"), Name("groups"),
     9	      Assign(Name("depth"), Int(0))
    10	      Assign(Name("maximum"), Int(0))
    11	      For(Name("character"), Name("group"),
    12	        If(Compare(Name("character"), CmpOp("==", Str("("))),
    13	          AugAssign(Name("depth"), "+", Int(1))
    14	          If(Compare(Name("depth"), CmpOp(">", Name("maximum"))),
    15	            Assign(Name("maximum"), Name("depth")),
    16	            ),
    17	          AugAssign(Name("depth"), "-", Int(1))))
    18	      Expr(Call(Attribute(Name("result"), "append"), Name("maximum"))))
    19	    Return(Name("result"))))
