     1	module MPY-SYNTAX
     2	  imports INT-SYNTAX
     3	  imports STRING-SYNTAX
     4	  imports BOOL-SYNTAX
     5	
     6	  syntax Program ::= "Module" "(" Stmts ")"
     7	
     8	  syntax Stmts ::= List{Stmt, ""}
     9	  syntax Strs ::= List{String, ","}
    10	  syntax Exprs ::= List{Expr, ","}
    11	  syntax CmpOps ::= List{CmpOp, ","}
    12	
    13	  syntax Params ::= "Params" "(" Strs ")"
    14	
    15	  syntax Stmt ::= "ImportFrom" "(" String "," Strs ")"
    16	                | "FuncDef" "(" String "," Params "," Stmts ")"
    17	                | "Assign" "(" Expr "," Expr ")"
    18	                | "AugAssign" "(" Expr "," String "," Expr ")"
    19	                | "For" "(" Expr "," Expr "," Stmts ")"
    20	                | "If" "(" Expr "," Stmts "," Stmts ")"
    21	                | "Expr" "(" Expr ")"
    22	                | "Return" "(" Expr ")"
    23	
    24	  syntax Expr ::= "Name" "(" String ")"
    25	                | "Int" "(" Int ")"
    26	                | "Str" "(" String ")"
    27	                | "ListExpr" "(" Exprs ")"
    28	                | "Attribute" "(" Expr "," String ")"
    29	                | "Call" "(" Expr "," Exprs ")"
    30	                | "Compare" "(" Expr "," CmpOps ")"
    31	
    32	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    33	endmodule
    34	
    35	module MPY-SEMANTICS
    36	  imports MPY-SYNTAX
    37	  imports INT
    38	  imports STRING
    39	  imports BOOL
    40	  imports MAP
    41	
    42	  // Python values needed by this program.  Lists are immutable values in the
    43	  // environment; append is modeled by replacing the binding with a new list.
    44	  syntax PyVal ::= "pyInt" "(" Int ")"
    45	                 | "pyStr" "(" String ")"
    46	                 | "pyBool" "(" Bool ")"
    47	                 | "pyList" "(" PyVals ")"
    48	  syntax PyVals ::= ".PyVals" | PyVal "::" PyVals
    49	
    50	  syntax Result ::= "noResult" | "result" "(" PyVal ")"
    51	  syntax Function ::= "function" "(" Params "," Stmts ")"
    52	
    53	  syntax KItem ::= "start"
    54	                 | "invoke" "(" String "," PyVal ")"
    55	                 | "forValues" "(" String "," PyVals "," Stmts ")"
    56	                 | "choose" "(" PyVal "," Stmts "," Stmts ")"
    57	
    58	  configuration
    59	    <mpy>
    60	      <k> $PGM:Program </k>
    61	      <input> $INPUT:String </input>
    62	      <env> .Map </env>
    63	      <functions> .Map </functions>
    64	      <result> noResult </result>
    65	    </mpy>
    66	
    67	  // Module loading registers functions before the requested entry point runs.
    68	  rule <k> Module(SS) => SS ~> start ... </k>
    69	  rule <k> (S:Stmt SS:Stmts) => S ~> SS ... </k>
    70	  rule <k> .Stmts => .K ... </k>
    71	
    72	  rule <k> ImportFrom(_, _) => .K ... </k>
    73	  rule <k> FuncDef(F, PS, BODY) => .K ... </k>
    74	       <functions> FS => FS [ F <- function(PS, BODY) ] </functions>
    75	
    76	  rule <k> start => invoke("parse_nested_parens", pyStr(S)) ... </k>
    77	       <input> S </input>
    78	
    79	  rule <k> invoke(F, ARG) => BODY ... </k>
    80	       <functions> ... F |-> function(Params(P:String), BODY) ... </functions>
    81	       <env> _ => P |-> ARG </env>
    82	
    83	  // Statement execution.
    84	  rule <k> Assign(Name(X), E) => .K ... </k>
    85	       <env> ENV => ENV [ X <- eval(E, ENV) ] </env>
    86	
    87	  rule <k> AugAssign(Name(X), "+", E) => .K ... </k>
    88	       <env> ENV => ENV [ X <- addPy(lookupPy(X, ENV), eval(E, ENV)) ] </env>
    89	
    90	  rule <k> AugAssign(Name(X), "-", E) => .K ... </k>
    91	       <env> ENV => ENV [ X <- subPy(lookupPy(X, ENV), eval(E, ENV)) ] </env>
    92	
    93	  rule <k> If(E, THEN, ELSE) => choose(eval(E, ENV), THEN, ELSE) ... </k>
    94	       <env> ENV </env>
    95	  rule <k> choose(pyBool(true), THEN, _) => THEN ... </k>
    96	  rule <k> choose(pyBool(false), _, ELSE) => ELSE ... </k>
    97	
    98	  rule <k> For(Name(X), E, BODY) => forValues(X, iterable(eval(E, ENV)), BODY) ... </k>
    99	       <env> ENV </env>
   100	  rule <k> forValues(_, .PyVals, _) => .K ... </k>
   101	  rule <k> forValues(X, V :: VS, BODY) => BODY ~> forValues(X, VS, BODY) ... </k>
   102	       <env> ENV => ENV [ X <- V ] </env>
   103	
   104	  rule <k> Expr(Call(Attribute(Name(X), "append"), E)) => .K ... </k>
   105	       <env> ENV => ENV [ X <- appendPy(lookupPy(X, ENV), eval(E, ENV)) ] </env>
   106	
   107	  rule <k> Return(E) ~> _ => .K </k>
   108	       <env> ENV => .Map </env>
   109	       <functions> _ => .Map </functions>
   110	       <result> noResult => result(eval(E, ENV)) </result>
   111	
   112	  // Pure expression evaluator.
   113	  syntax PyVal ::= "eval" "(" Expr "," Map ")" [function]
   114	  syntax PyVal ::= "lookupPy" "(" String "," Map ")" [function]
   115	  rule lookupPy(X, (X |-> V:PyVal) _REST) => V
   116	
   117	  rule eval(Int(I), _) => pyInt(I)
   118	  rule eval(Str(S), _) => pyStr(S)
   119	  rule eval(Name(X), ENV) => lookupPy(X, ENV)
   120	  rule eval(ListExpr(.Exprs), _) => pyList(.PyVals)
   121	  rule eval(Call(Attribute(E, "split"), Str(" ")), ENV)
   122	    => pyList(splitSpaces(stringOf(eval(E, ENV))))
   123	  rule eval(Compare(E1, CmpOp("==", E2)), ENV)
   124	    => pyBool(eqPy(eval(E1, ENV), eval(E2, ENV)))
   125	  rule eval(Compare(E1, CmpOp(">", E2)), ENV)
   126	    => pyBool(gtPy(eval(E1, ENV), eval(E2, ENV)))
   127	
   128	  syntax String ::= "stringOf" "(" PyVal ")" [function]
   129	  rule stringOf(pyStr(S)) => S
   130	
   131	  syntax Bool ::= "truth" "(" PyVal ")" [function]
   132	  rule truth(pyBool(B)) => B
   133	
   134	  syntax Bool ::= "eqPy" "(" PyVal "," PyVal ")" [function]
   135	  rule eqPy(pyStr(A), pyStr(B)) => A ==String B
   136	  rule eqPy(pyInt(A), pyInt(B)) => A ==Int B
   137	
   138	  syntax Bool ::= "gtPy" "(" PyVal "," PyVal ")" [function]
   139	  rule gtPy(pyInt(A), pyInt(B)) => A >Int B
   140	
   141	  syntax PyVal ::= "addPy" "(" PyVal "," PyVal ")" [function]
   142	  rule addPy(pyInt(A), pyInt(B)) => pyInt(A +Int B)
   143	
   144	  syntax PyVal ::= "subPy" "(" PyVal "," PyVal ")" [function]
   145	  rule subPy(pyInt(A), pyInt(B)) => pyInt(A -Int B)
   146	
   147	  syntax PyVal ::= "appendPy" "(" PyVal "," PyVal ")" [function]
   148	  rule appendPy(pyList(VS), V) => pyList(appendVals(VS, V))
   149	
   150	  syntax PyVals ::= "appendVals" "(" PyVals "," PyVal ")" [function]
   151	  rule appendVals(.PyVals, V) => V :: .PyVals
   152	  rule appendVals(H :: T, V) => H :: appendVals(T, V)
   153	
   154	  syntax PyVals ::= "iterable" "(" PyVal ")" [function]
   155	  rule iterable(pyList(VS)) => VS
   156	  rule iterable(pyStr(S)) => chars(S)
   157	
   158	  syntax PyVals ::= "chars" "(" String ")" [function]
   159	  rule chars("") => .PyVals
   160	  rule chars(S) => pyStr(substrString(S, 0, 1))
   161	                   :: chars(substrString(S, 1, lengthString(S)))
   162	       requires lengthString(S) >Int 0
   163	
   164	  // Python's explicit-separator split retains empty fields.
   165	  syntax PyVals ::= "splitSpaces" "(" String ")" [function]
   166	  rule splitSpaces(S) => pyStr(S) :: .PyVals
   167	       requires findString(S, " ", 0) <Int 0
   168	  rule splitSpaces(S) => pyStr(substrString(S, 0, findString(S, " ", 0)))
   169	                         :: splitSpaces(substrString(S,
   170	                              findString(S, " ", 0) +Int 1,
   171	                              lengthString(S)))
   172	       requires findString(S, " ", 0) >=Int 0
   173	endmodule
