    10	      <k> solutionProgram => .K </k>
    11	      <input> "(()()) ((())) () ((())()())" </input>
    12	      <env> .Map => .Map </env>
    13	      <functions> .Map => .Map </functions>
    14	      <result>
    15	        noResult
    16	      => result(pyList(pyInt(2) :: pyInt(3) :: pyInt(1) :: pyInt(4) :: .PyVals))
    17	      </result>
