+#!/usr/bin/env bash
+set -uo pipefail
+
+scratch=/tmp/audit-work/candidate
+verification_definition=/tmp/audit-work/runs/verification-kompiled
+spec_file="$scratch/isolated-specs.k"
+overall_status=0
+
+run_claim() {
