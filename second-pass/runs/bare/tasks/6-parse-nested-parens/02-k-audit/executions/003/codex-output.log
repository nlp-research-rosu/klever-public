diff --git a/evidence/02_isolated-specs.k b/evidence/02_isolated-specs.k
new file mode 100644
index 0000000000000000000000000000000000000000..38248bb61ee838e88dfea142e4e3f0ce5ea82bb4
--- /dev/null
+++ b/evidence/02_isolated-specs.k
@@ -0,0 +1,37 @@
+requires "verification.k"
+
+module AUDIT-SPEC-EXAMPLE
+  imports MPY-VERIFICATION
+  claim
+      <k> solutionProgram => .K </k>
+      <input> "(()()) ((())) () ((())()())" </input>
+      <env> .Map => .Map </env>
+      <functions> .Map => .Map </functions>
+      <result>
+        noResult
+      => result(pyList(pyInt(2) :: pyInt(3) :: pyInt(1) :: pyInt(3) :: .PyVals))
+      </result>
+endmodule
+
+module AUDIT-SPEC-INCREASING
+  imports MPY-VERIFICATION
+  claim
+      <k> solutionProgram => .K </k>
+      <input> "() (()) ((())) (((())))" </input>
+      <env> .Map => .Map </env>
+      <functions> .Map => .Map </functions>
+      <result>
+        noResult
+      => result(pyList(pyInt(1) :: pyInt(2) :: pyInt(3) :: pyInt(4) :: .PyVals))
+      </result>
+endmodule
+
+module AUDIT-SPEC-SINGLE
+  imports MPY-VERIFICATION
+  claim
+      <k> solutionProgram => .K </k>
+      <input> "(()(())((())))" </input>
+      <env> .Map => .Map </env>
+      <functions> .Map => .Map </functions>
+      <result> noResult => result(pyList(pyInt(4) :: .PyVals)) </result>
+endmodule
