import hashlib,itertools,stat
root=Path('/generation-evidence/codex-trace'); target='a5d1deb68f60bc935e8121d664be7f30411a391cdad04afda7cab9207f0613db'
ents=sorted(root.rglob('*'),key=lambda p:p.relative_to(root).as_posix())
for include_dirs in (False,True):
 e=[p for p in ents if include_dirs or p.is_file()]
 for pathprefix in ('','./'):
  for sep in (b'',b'\\0',b'\\n',b'  '):
   for use_digest in (False,True):
    for kind in (0,1,2):
     h=hashlib.sha256()
     for p in e:
      rel=(pathprefix+p.relative_to(root).as_posix()).encode()
      if kind==1: h.update((b'd' if p.is_dir() else b'f'))
      elif kind==2: h.update((b'directory\\0' if p.is_dir() else b'file\\0'))
      h.update(rel); h.update(sep)
