     1	def histogram(test):
     2	    letters = test.split()
     3	    counts = {}
     4	    maximum = 0
     5	
     6	    for letter in letters:
     7	        if letter in counts:
     8	            counts[letter] = counts[letter] + 1
     9	        else:
    10	            counts[letter] = 1
    11	
    12	        if counts[letter] > maximum:
    13	            maximum = counts[letter]
    14	
    15	    result = {}
    16	    for letter in counts:
    17	        if counts[letter] == maximum:
    18	            result[letter] = counts[letter]
    19	
    20	    return result
