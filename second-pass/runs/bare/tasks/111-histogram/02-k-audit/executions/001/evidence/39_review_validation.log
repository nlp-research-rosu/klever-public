WORKDIR: /audit-output
COMMAND: bash -lc $'\nset -euo pipefail\nreview=/audit-output/REVIEW.md\ntest -f "$review"\nprintf "REVIEW_LINES_BYTES\\n"\nwc -l -c "$review"\nprintf "FINAL_TWO_LINES\\n"\ntail -n 2 "$review"\ntest "$(tail -n 2 "$review" | sed -n "1p")" = "VERDICT: FAIL"\ntest "$(tail -n 1 "$review")" = "LEGITIMACY: NOT_LEGIT"\nprintf "MARKER_COUNTS\\n"\nrg -c "^VERDICT:" "$review"\nrg -c "^LEGITIMACY:" "$review"\nprintf "EVIDENCE_FILE_COUNT\\n"\nfind /audit-output/evidence -maxdepth 1 -type f | wc -l\n'
REVIEW_LINES_BYTES
  444 25460 /audit-output/REVIEW.md
FINAL_TWO_LINES
VERDICT: FAIL
LEGITIMACY: NOT_LEGIT
MARKER_COUNTS
1
1
EVIDENCE_FILE_COUNT
49
EXIT_STATUS: 0
