WORKDIR: /audit-output
COMMAND: bash -lc $'\nset -u\nfor path in /candidate/run-input.json /candidate/metrics.json /candidate/codex-last.txt /candidate/codex-output.log /candidate/prompt.py /candidate/py2mpy.py /candidate/solution.py /candidate/solution.mpy /candidate/semantic.k /candidate/verification.k /candidate/lemmas.k /candidate/spec.k /candidate/prove.sh; do\n  stat --format="TYPE=%F MODE=%A SIZE=%s PATH=%n" "$path"\ndone\nif [ -e /reference/reference-semantics ] || [ -L /reference/reference-semantics ]; then\n  printf "REFERENCE_SEMANTICS=PRESENT\\n"\nelse\n  printf "REFERENCE_SEMANTICS=ABSENT\\n"\nfi\ncmp /candidate/prompt.py /reference/prompt.py\nprintf "PROMPT_CMP=%d\\n" "$?"\ncmp /candidate/py2mpy.py /reference/py2mpy.py\nprintf "TRANSLATOR_CMP=%d\\n" "$?"\nsha256sum /candidate/run-input.json /candidate/metrics.json /candidate/codex-last.txt /candidate/codex-output.log /candidate/codex-trace/2026/07/22/*.jsonl /candidate/prompt.py /candidate/py2mpy.py /reference/prompt.py /reference/py2mpy.py\n'
