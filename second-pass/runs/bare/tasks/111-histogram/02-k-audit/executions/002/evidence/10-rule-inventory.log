semantic.k:155:  syntax ExecResult ::= exec(Stmts, Map) [function, total]
semantic.k:156:                      | execNext(ExecResult, Stmts) [function, total]
semantic.k:157:                      | execStmt(Stmt, Map) [function, total]
semantic.k:158:                      | execIf(Bool, Stmts, Stmts, Map) [function, total]
semantic.k:159:                      | execFor(Expr, List, Stmts, Map) [function, total]
semantic.k:160:                      | execForNext(ExecResult, Expr, List, Stmts) [function, total]
