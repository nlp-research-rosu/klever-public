+#!/usr/bin/env bash
+set -euo pipefail
+
+cd /tmp/audit-work/fresh
+
+run_case() {
+  local audit_input="$1"
+  local audit_k_string="\"${audit_input}\""
+  printf 'INPUT=%q\n' "$audit_input"
+  python3 - "$audit_input" <<'PY'
+import importlib.util
+import sys
+from pathlib import Path
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.histogram
+
+value = sys.argv[1]
+canonical = load("canonical", Path("/reference/canonical.py"))
+generated = load("generated", Path("/tmp/audit-work/fresh/solution.py"))
+print(f"PY_CANONICAL={canonical(value)!r}")
+print(f"PY_GENERATED={generated(value)!r}")
+PY
+  printf 'COMMAND=krun solution.mpy --definition semantic-llvm-kompiled -cTEST=%q --output pretty\n' "$audit_k_string"
+  krun solution.mpy \
+    --definition semantic-llvm-kompiled \
+    -cTEST="$audit_k_string" \
+    --output pretty
+}
+
+run_case ""
+run_case "a"
+run_case "a a"
+run_case "a a b"
+run_case "a b b"
+run_case "a a b b c"
+run_case "a b c a b"
+run_case " a"
+run_case "a  b"

exec
/bin/bash -lc "cp /tmp/audit-work/body-mutation/verification.k /audit-output/evidence/body-mutation-verification.k
set -o pipefail
{
  printf '%s\\n' 'MUTATION=histogramProgram initializes maximum to pyInt(2) while histogramSpec initialEnv retains pyInt(0)'
  diff -u /tmp/audit-work/fresh/verification.k /tmp/audit-work/body-mutation/verification.k || true
  printf '%s\\n' 'COMMAND=kompile lemmas.k --backend haskell --main-module VERIFIED-LOOP-LEMMAS --syntax-module MPY-SYNTAX --output-definition body-mutation-kompiled -Wno unused-symbol -Wno unused-var'
  kompile lemmas.k --backend haskell --main-module VERIFIED-LOOP-LEMMAS --syntax-module MPY-SYNTAX --output-definition body-mutation-kompiled -Wno unused-symbol -Wno unused-var
  audit_build_status="'$?
  printf '"'BUILD_EXIT_STATUS=%d\\n' \""'$audit_build_status"
  printf '"'%s\\n' 'COMMAND=kprove spec.k --definition body-mutation-kompiled --spec-module MAIN-CORRECTNESS-SPEC --claims MAIN-CORRECTNESS-SPEC.all-space-separated-strings --output pretty -Wno unused-symbol -Wno unused-var'
  kprove spec.k --definition body-mutation-kompiled --spec-module MAIN-CORRECTNESS-SPEC --claims MAIN-CORRECTNESS-SPEC.all-space-separated-strings --output pretty -Wno unused-symbol -Wno unused-var
  audit_prove_status="'$?
  printf '"'PROVE_EXIT_STATUS=%d\\n' \""'$audit_prove_status"
  test "$audit_build_status" -eq 0 -a "$audit_prove_status" -ne 0
} 2>&1 | tee /audit-output/evidence/12-body-sensitivity.log
exit "${PIPESTATUS[0]}"' in /tmp/audit-work/body-mutation
