new file mode 100644
index 0000000000000000000000000000000000000000..4be85c55753ab81a0e6f37a448bcf9c5d4a769eb
--- /dev/null
+++ b/evidence/run_concrete.sh
@@ -0,0 +1,42 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd /tmp/audit-work/fresh
+
+run_case() {
+  local audit_input="$1"
+  local audit_k_string="\"${audit_input}\""
+  printf 'INPUT=%q\n' "$audit_input"
+  python3 - "$audit_input" <<'PY'
+import importlib.util
+import sys
+from pathlib import Path
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.histogram
+
+value = sys.argv[1]
+canonical = load("canonical", Path("/reference/canonical.py"))
+generated = load("generated", Path("/tmp/audit-work/fresh/solution.py"))
+print(f"PY_CANONICAL={canonical(value)!r}")
+print(f"PY_GENERATED={generated(value)!r}")
+PY
+  printf 'COMMAND=krun solution.mpy --definition semantic-llvm-kompiled -cTEST=%q --output pretty\n' "$audit_k_string"
+  krun solution.mpy \
+    --definition semantic-llvm-kompiled \
+    -cTEST="$audit_k_string" \
+    --output pretty
+}
+
+run_case ""
+run_case "a"
+run_case "a a"
+run_case "a a b"
+run_case "a b b"
+run_case "a a b b c"
+run_case "a b c a b"
+run_case " a"
+run_case "a  b"

exec
/bin/bash -lc "set -o pipefail
{
  printf '%s\\n' 'COMMAND=kast solution.mpy --definition verification-haskell-kompiled --sort Program --output json'
  kast solution.mpy --definition verification-haskell-kompiled --sort Program --output json > /tmp/audit-work/submitted-program.json
  audit_first_status="'$?
  printf '"'FIRST_EXIT_STATUS=%d\\n' \""'$audit_first_status"
  printf '"'%s\\n' 'COMMAND=kast /audit-output/evidence/histogram-program-explicit.mpy --definition verification-haskell-kompiled --sort Program --output json'
  kast /audit-output/evidence/histogram-program-explicit.mpy --definition verification-haskell-kompiled --sort Program --output json > /tmp/audit-work/explicit-program.json
  audit_second_status="'$?
  printf '"'SECOND_EXIT_STATUS=%d\\n' \""'$audit_second_status"
  cmp -s /tmp/audit-work/submitted-program.json /tmp/audit-work/explicit-program.json
  audit_cmp_status=$?
  printf '"'KAST_JSON_BYTE_IDENTITY=%s\\n' \""'$([[ $audit_cmp_status -eq 0 ]] && printf true || printf false)"
  printf '"'CMP_EXIT_STATUS=%d\\n' \""'$audit_cmp_status"
  exit "$audit_cmp_status"
} 2>&1 | tee /audit-output/evidence/09-kast-constructor-identity.log
exit "${PIPESTATUS[0]}"' in /tmp/audit-work/fresh
