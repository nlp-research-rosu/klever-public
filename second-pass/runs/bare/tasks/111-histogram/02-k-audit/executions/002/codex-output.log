     3	module VERIFIED-LOOP-LEMMAS
     4	  imports VERIFICATION
     5	
     6	  // These equations are the induction closures of the base/step obligations
     7	  // proved in COUNT-LOOP-SPEC and SELECT-LOOP-SPEC. They are kept in a
     8	  // separate compiled layer so those obligations cannot use the equations
     9	  // they are establishing.
    10	  rule execFor(Name("letter"), WORDS:List,
    11	        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
    12	          Assign(Subscript(Name("counts"), Name("letter")),
    13	                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
    14	          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
    15	        If(Compare(Subscript(Name("counts"), Name("letter")),
    16	                   CmpOp(">", Name("maximum"))),
    17	          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
    18	          .Stmts),
    19	        ENV:Map)
    20	    => normal(countLoop(WORDS, ENV))
    21	
    22	  rule execFor(Name("letter"), WORDS:List,
    23	        If(Compare(Subscript(Name("counts"), Name("letter")),
    24	                   CmpOp("==", Name("maximum"))),
    25	          Assign(Subscript(Name("result"), Name("letter")),
    26	                 Subscript(Name("counts"), Name("letter"))),
    27	          .Stmts),
    28	        ENV:Map)
    29	    => normal(selectLoop(WORDS, ENV))
    30	endmodule
