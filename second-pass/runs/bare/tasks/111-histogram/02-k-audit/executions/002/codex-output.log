     4	  imports SEMANTIC
     5	
     6	  // A closed constructor for the exact translated program. This avoids
     7	  // copying a large AST into every claim while still proving solution.mpy.
     8	  syntax Program ::= histogramProgram() [function, total]
     9	  rule histogramProgram() =>
    10	    Module(
    11	      FuncDef("histogram", Params("test"),
    12	        Assign(Name("letters"), Call(Attribute(Name("test"), "split"), .Exprs))
    13	        Assign(Name("counts"), DictExpr(.Entries))
    14	        Assign(Name("maximum"), Int(0))
    15	        For(Name("letter"), Name("letters"),
    16	          If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
    17	            Assign(Subscript(Name("counts"), Name("letter")),
    18	                   BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
    19	            Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
    20	          If(Compare(Subscript(Name("counts"), Name("letter")),
    21	                     CmpOp(">", Name("maximum"))),
    22	            Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
    23	            .Stmts))
    24	        Assign(Name("result"), DictExpr(.Entries))
    25	        For(Name("letter"), Name("counts"),
    26	          If(Compare(Subscript(Name("counts"), Name("letter")),
    27	                     CmpOp("==", Name("maximum"))),
    28	            Assign(Subscript(Name("result"), Name("letter")),
    29	                   Subscript(Name("counts"), Name("letter"))),
    30	            .Stmts))
    31	        Return(Name("result"))))
    32	
    33	  // Denotational count pass. It is deliberately independent of exec/execFor:
    34	  // each word increments its dictionary entry and raises the maximum if needed.
    35	  syntax PyVal ::= nextCount(PyVal, PyVal) [function, total]
    36	  rule nextCount(pyDict((WORD |-> VALUE:PyVal) REST, _), WORD)
    37	    => addValues(VALUE, pyInt(1))
    38	  rule nextCount(pyDict(DICT, _), WORD) => pyInt(1)
    39	    requires notBool (WORD in_keys(DICT))
    40	  rule nextCount(_, _) => pyInt(1) [owise]
    41	
    42	  syntax Map ::= putCount(PyVal, Map) [function, total]
    43	  rule putCount(WORD, ENV)
    44	    => (ENV["letter" <- WORD])
    45	       ["counts" <- dictSet(envGet(ENV, "counts"), WORD,
    46	                            nextCount(envGet(ENV, "counts"), WORD))]
    47	
    48	  syntax Map ::= raiseMaximum(PyVal, Map) [function, total]
    49	  rule raiseMaximum(WORD, ENV)
    50	    => ENV["maximum" <- dictGet(envGet(ENV, "counts"), WORD)]
    51	    requires compareValues(">", dictGet(envGet(ENV, "counts"), WORD),
    52	                                envGet(ENV, "maximum")) ==K pyBool(true)
    53	  rule raiseMaximum(WORD, ENV) => ENV
    54	    requires compareValues(">", dictGet(envGet(ENV, "counts"), WORD),
    55	                                envGet(ENV, "maximum")) ==K pyBool(false)
    56	
    57	  syntax Map ::= countIteration(PyVal, Map) [function, total]
    58	  rule countIteration(WORD, ENV) => raiseMaximum(WORD, putCount(WORD, ENV))
    59	
    60	  syntax Map ::= countLoop(List, Map) [function, total]
    61	  rule countLoop(.List, ENV) => ENV
    62	  rule countLoop(ListItem(WORD) (REST:List), ENV)
    63	    => countLoop(REST, countIteration(WORD, ENV))
    64	
    65	  // Denotational selection pass. The key list comes from the counted dict, and
    66	  // only entries equal to the previously established maximum are retained.
    67	  syntax Map ::= selectIteration(PyVal, Map) [function, total]
    68	  rule selectIteration(WORD, ENV)
    69	    => (ENV["letter" <- WORD])
    70	       ["result" <- dictSet(envGet(ENV, "result"), WORD,
    71	                            dictGet(envGet(ENV, "counts"), WORD))]
    72	    requires compareValues("==", dictGet(envGet(ENV, "counts"), WORD),
    73	                                 envGet(ENV, "maximum")) ==K pyBool(true)
    74	  rule selectIteration(WORD, ENV) => ENV["letter" <- WORD]
    75	    requires compareValues("==", dictGet(envGet(ENV, "counts"), WORD),
    76	                                 envGet(ENV, "maximum")) ==K pyBool(false)
    77	
    78	  syntax Map ::= selectLoop(List, Map) [function, total]
    79	  rule selectLoop(.List, ENV) => ENV
    80	  rule selectLoop(ListItem(WORD) (REST:List), ENV)
    81	    => selectLoop(REST, selectIteration(WORD, ENV))
    82	
    83	  syntax List ::= dictKeys(PyVal) [function, total]
    84	  rule dictKeys(pyDict(_, KEYS)) => KEYS
    85	  rule dictKeys(_) => .List [owise]
    86	
    87	  syntax Map ::= initialEnvWith(List, PyVal) [function, total]
    88	  rule initialEnvWith(WORDS, INPUT) =>
    89	    "test" |-> INPUT
    90	    "letters" |-> pyList(WORDS)
    91	    "counts" |-> pyDict(.Map, .List)
    92	    "maximum" |-> pyInt(0)
    93	
    94	  syntax Map ::= initialEnv(List) [function, total]
    95	  rule initialEnv(WORDS) => initialEnvWith(WORDS, pyWords(WORDS))
    96	
    97	  syntax Map ::= afterCountWith(List, PyVal) [function, total]
    98	  rule afterCountWith(WORDS, INPUT) => countLoop(WORDS, initialEnvWith(WORDS, INPUT))
    99	
   100	  syntax Map ::= afterCount(List) [function, total]
   101	  rule afterCount(WORDS) => afterCountWith(WORDS, pyWords(WORDS))
   102	
   103	  syntax Map ::= beforeSelectWith(List, PyVal) [function, total]
   104	  rule beforeSelectWith(WORDS, INPUT) =>
   105	    afterCountWith(WORDS, INPUT)["result" <- pyDict(.Map, .List)]
   106	
   107	  syntax Map ::= beforeSelect(List) [function, total]
   108	  rule beforeSelect(WORDS) => beforeSelectWith(WORDS, pyWords(WORDS))
   109	
   110	  syntax PyVal ::= histogramSpecWith(List, PyVal) [function, total]
   111	  rule histogramSpecWith(WORDS, INPUT) =>
   112	    envGet(selectLoop(iterable(envGet(afterCountWith(WORDS, INPUT), "counts")),
   113	                      beforeSelectWith(WORDS, INPUT)),
   114	           "result")
   115	
   116	  syntax PyVal ::= histogramSpec(List) [function, total]
   117	  rule histogramSpec(WORDS) => histogramSpecWith(WORDS, pyWords(WORDS))
   118	
   119	  syntax PyVal ::= histogramSpecString(String) [function, total]
   120	  rule histogramSpecString(INPUT) =>
   121	    histogramSpecWith(splitWords(INPUT), pyString(INPUT))
   122	endmodule
