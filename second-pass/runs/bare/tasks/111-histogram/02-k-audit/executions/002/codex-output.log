       elif form=='listlist': obj=[[e[k] for k in fields if e[k] is not None] for e in es]
       else: obj={e['path']:{k:e[k] for k in fields if k"'!='"'path' and e[k] is not None} for e in es}
       kwargs={'indent':indent,'sort_keys':sort}
