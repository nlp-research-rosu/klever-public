     6	def histogram(test):
     7	    """Given a string representing a space separated lowercase letters, return a dictionary
     8	    of the letter with the most repetition and containing the corresponding count.
     9	    If several letters have the same occurrence, return all of them.
    10	    
    11	    Example:
    12	    histogram('a b c') == {'a': 1, 'b': 1, 'c': 1}
    13	    histogram('a b b a') == {'a': 2, 'b': 2}
    14	    histogram('a b c a b') == {'a': 2, 'b': 2}
    15	    histogram('b b b b a') == {'b': 4}
    16	    histogram('') == {}
    17	
    18	    """
    19	    dict1={}
    20	    list1=test.split(" ")
    21	    t=0
    22	
    23	    for i in list1:
    24	        if(list1.count(i)>t) and i!='':
    25	            t=list1.count(i)
    26	    if t>0:
    27	        for i in list1:
    28	            if(list1.count(i)==t):
    29	                
    30	                dict1[i]=t
    31	    return dict1
     1	def histogram(test):
     2	    letters = test.split()
     3	    counts = {}
     4	    maximum = 0
     5	
     6	    for letter in letters:
     7	        if letter in counts:
     8	            counts[letter] = counts[letter] + 1
     9	        else:
    10	            counts[letter] = 1
    11	
    12	        if counts[letter] > maximum:
    13	            maximum = counts[letter]
    14	
    15	    result = {}
    16	    for letter in counts:
    17	        if counts[letter] == maximum:
    18	            result[letter] = counts[letter]
    19	
    20	    return result
