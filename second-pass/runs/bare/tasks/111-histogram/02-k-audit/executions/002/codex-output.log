  kprove /audit-output/evidence/spec-vacuity-audit.k --definition verification-haskell-kompiled --spec-module SPEC-VACUITY-AUDIT --claims SPEC-VACUITY-AUDIT.false-single-count --output pretty -I /tmp/audit-work/fresh -Wno unused-symbol -Wno unused-var
  audit_prove_status="'$?
  printf '"'PROVE_EXIT_STATUS=%d\\n' \""'$audit_prove_status"
  test "$audit_build_status" -eq 0 -a "$audit_prove_status" -ne 0
} 2>&1 | tee /audit-output/evidence/13-non-vacuity.log
exit "${PIPESTATUS[0]}"' in /tmp/audit-work/fresh
