import hashlib,json,os,stat,itertools
from pathlib import Path
roots=[('/candidate','a2353d4eab62fdd35f93925f9e1f7e8150462d1676f099c6c60c0e13947a2a1c'),('/generation-evidence/codex-trace','c324316415b5130ea7fabbff69b09e9731f07c2bbeab196f7dc172059b86d015')]
def ents(root,dirs=True):
 r=Path(root); out=[]
 for p in sorted(r.rglob('*')):
  if not dirs and p.is_dir():continue
  b=p.read_bytes() if p.is_file() else b''
  out.append({'path':p.relative_to(r).as_posix(),'type':'directory' if p.is_dir() else 'file','kind':'d' if p.is_dir() else 'f','sha256':hashlib.sha256(b).hexdigest() if p.is_file() else None,'size':len(b),'mode':p.stat().st_mode & 0o777})
 return out
for dirs in [False,True]:
 for fields in [('path','type','sha256'),('path','kind','sha256'),('path','sha256'),('path','type','size','sha256'),('path','type','mode','size','sha256')]:
