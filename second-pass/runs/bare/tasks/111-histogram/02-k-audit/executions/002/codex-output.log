audit_status=${PIPESTATUS[0]}
printf '"'EXIT_STATUS=%d\\n' \""'$audit_status" | tee -a /audit-output/evidence/07-kompile-lemmas.log
exit "$audit_status"' in /tmp/audit-work/fresh
