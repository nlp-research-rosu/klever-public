diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e3dd0fed1d36aafcd8dd69610dc76ecc25095e3c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,105 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A closed constructor for the exact translated program. This avoids
+  // copying a large AST into every claim while still proving solution.mpy.
+  syntax Program ::= histogramProgram() [function, total]
+  rule histogramProgram() =>
+    Module(
+      FuncDef("histogram", Params("test"),
+        Assign(Name("letters"), Call(Attribute(Name("test"), "split"), .Exprs))
+        Assign(Name("counts"), DictExpr(.Entries))
+        Assign(Name("maximum"), Int(0))
+        For(Name("letter"), Name("letters"),
+          If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+            Assign(Subscript(Name("counts"), Name("letter")),
+                   BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+            Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+          If(Compare(Subscript(Name("counts"), Name("letter")),
+                     CmpOp(">", Name("maximum"))),
+            Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+            .Stmts))
+        Assign(Name("result"), DictExpr(.Entries))
+        For(Name("letter"), Name("counts"),
+          If(Compare(Subscript(Name("counts"), Name("letter")),
+                     CmpOp("==", Name("maximum"))),
+            Assign(Subscript(Name("result"), Name("letter")),
+                   Subscript(Name("counts"), Name("letter"))),
+            .Stmts))
+        Return(Name("result"))))
+
+  // Denotational count pass. It is deliberately independent of exec/execFor:
+  // each word increments its dictionary entry and raises the maximum if needed.
+  syntax PyVal ::= nextCount(PyVal, PyVal) [function, total]
+  rule nextCount(pyDict((WORD |-> VALUE:PyVal) REST, _), WORD)
+    => addValues(VALUE, pyInt(1))
+  rule nextCount(pyDict(DICT, _), WORD) => pyInt(1)
+    requires notBool (WORD in_keys(DICT))
+  rule nextCount(_, _) => pyInt(1) [owise]
+
+  syntax Map ::= putCount(PyVal, Map) [function, total]
+  rule putCount(WORD, ENV)
+    => (ENV["letter" <- WORD])
+       ["counts" <- dictSet(envGet(ENV, "counts"), WORD,
+                            nextCount(envGet(ENV, "counts"), WORD))]
+
+  syntax Map ::= raiseMaximum(PyVal, Map) [function, total]
+  rule raiseMaximum(WORD, ENV)
+    => ENV["maximum" <- dictGet(envGet(ENV, "counts"), WORD)]
+    requires compareValues(">", dictGet(envGet(ENV, "counts"), WORD),
+                                envGet(ENV, "maximum")) ==K pyBool(true)
+  rule raiseMaximum(WORD, ENV) => ENV
+    requires compareValues(">", dictGet(envGet(ENV, "counts"), WORD),
+                                envGet(ENV, "maximum")) ==K pyBool(false)
+
+  syntax Map ::= countIteration(PyVal, Map) [function, total]
+  rule countIteration(WORD, ENV) => raiseMaximum(WORD, putCount(WORD, ENV))
+
+  syntax Map ::= countLoop(List, Map) [function, total]
+  rule countLoop(.List, ENV) => ENV
+  rule countLoop(ListItem(WORD) REST, ENV)
+    => countLoop(REST, countIteration(WORD, ENV))
+
+  // Denotational selection pass. The key list comes from the counted dict, and
+  // only entries equal to the previously established maximum are retained.
+  syntax Map ::= selectIteration(PyVal, Map) [function, total]
+  rule selectIteration(WORD, ENV)
+    => (ENV["letter" <- WORD])
+       ["result" <- dictSet(envGet(ENV, "result"), WORD,
+                            dictGet(envGet(ENV, "counts"), WORD))]
+    requires compareValues("==", dictGet(envGet(ENV, "counts"), WORD),
+                                 envGet(ENV, "maximum")) ==K pyBool(true)
+  rule selectIteration(WORD, ENV) => ENV["letter" <- WORD]
+    requires compareValues("==", dictGet(envGet(ENV, "counts"), WORD),
+                                 envGet(ENV, "maximum")) ==K pyBool(false)
+
+  syntax Map ::= selectLoop(List, Map) [function, total]
+  rule selectLoop(.List, ENV) => ENV
+  rule selectLoop(ListItem(WORD) REST, ENV)
+    => selectLoop(REST, selectIteration(WORD, ENV))
+
+  syntax List ::= dictKeys(PyVal) [function, total]
+  rule dictKeys(pyDict(_, KEYS)) => KEYS
+  rule dictKeys(_) => .List [owise]
+
+  syntax Map ::= initialEnv(List) [function, total]
+  rule initialEnv(WORDS) =>
+    "test" |-> pyWords(WORDS)
+    "letters" |-> pyList(WORDS)
+    "counts" |-> pyDict(.Map, .List)
+    "maximum" |-> pyInt(0)
+
+  syntax Map ::= afterCount(List) [function, total]
+  rule afterCount(WORDS) => countLoop(WORDS, initialEnv(WORDS))
+
+  syntax Map ::= beforeSelect(List) [function, total]
+  rule beforeSelect(WORDS) => afterCount(WORDS)["result" <- pyDict(.Map, .List)]
+
+  syntax PyVal ::= histogramSpec(List) [function, total]
+  rule histogramSpec(WORDS) =>
+    envGet(selectLoop(dictKeys(envGet(afterCount(WORDS), "counts")),
+                      beforeSelect(WORDS)),
+           "result")
+endmodule

diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..f77b05de71c908f0f17281fb1455e287d4cdf062
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,184 @@
+module MPY-SYNTAX
+  imports INT
+  imports STRING
+  imports BOOL
+  imports K-EQUAL
+  imports MAP
+  imports LIST
+
+  syntax Program ::= Module(Stmts) [symbol]
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= FuncDef(String, Params, Stmts) [symbol]
+                | Assign(Expr, Expr)             [symbol]
+                | For(Expr, Expr, Stmts)         [symbol]
+                | If(Expr, Stmts, Stmts)         [symbol]
+                | Return(Expr)                   [symbol]
+
+  syntax Params ::= Params(String) [symbol]
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Entries ::= List{Entry, ","}
+  syntax Entry ::= Entry(Expr, Expr) [symbol]
+  syntax CmpOp ::= CmpOp(String, Expr) [symbol]
+
+  syntax Expr ::= Name(String)               [symbol]
+                | Int(Int)                   [symbol]
+                | Str(String)                [symbol]
+                | DictExpr(Entries)          [symbol]
+                | Attribute(Expr, String)    [symbol]
+                | Call(Expr, Exprs)          [symbol]
+                | Subscript(Expr, Expr)      [symbol]
+                | BinOp(String, Expr, Expr)  [symbol]
+                | Compare(Expr, CmpOp)       [symbol]
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+
+  // Runtime values. Dictionaries retain an insertion-order key list because
+  // Python iteration over a dictionary visits keys in insertion order.
+  syntax PyVal ::= pyInt(Int)          [symbol]
+                 | pyString(String)    [symbol]
+                 | pyWords(List)       [symbol]
+                 | pyList(List)        [symbol]
+                 | pyDict(Map, List)   [symbol]
+                 | pyBool(Bool)        [symbol]
+
+  syntax ExecResult ::= normal(Map)           [symbol]
+                      | returning(Map, PyVal)  [symbol]
+
+  syntax KItem ::= execute(Program, String) [symbol]
+                 | executeWords(Program, List) [symbol]
+
+  configuration <k> execute($PGM:Program, $TEST:String) </k>
+
+  // Entry-point setup. executeWords is a verification harness for an
+  // arbitrary already-tokenized valid input; execute is the concrete runner.
+  rule execute(Module(FuncDef("histogram", Params("test"), BODY)), S)
+    => resultOf(exec(BODY, "test" |-> pyString(S)))
+
+  rule executeWords(Module(FuncDef("histogram", Params("test"), BODY)), WORDS)
+    => resultOf(exec(BODY, "test" |-> pyWords(WORDS)))
+
+  syntax PyVal ::= resultOf(ExecResult) [function, total]
+  rule resultOf(returning(_, VALUE)) => VALUE
+  rule resultOf(normal(_)) => pyBool(false)
+
+  // Python str.split() for the prompt's space-separated input language. Empty
+  // fields are skipped, matching Python for one or several ASCII spaces.
+  syntax List ::= splitWords(String) [function, total]
+  rule splitWords("") => .List
+  rule splitWords(S) => splitWords(substrString(S, 1, lengthString(S)))
+    requires S =/=String "" andBool substrString(S, 0, 1) ==String " "
+  rule splitWords(S) => ListItem(pyString(S))
+    requires S =/=String "" andBool findString(S, " ", 0) ==Int -1
+  rule splitWords(S) => ListItem(pyString(substrString(S, 0, findString(S, " ", 0))))
+                          splitWords(substrString(S, findString(S, " ", 0) +Int 1,
+                                                  lengthString(S)))
+    requires findString(S, " ", 0) >Int 0
+
+  syntax PyVal ::= splitValue(PyVal) [function, total]
+  rule splitValue(pyString(S)) => pyList(splitWords(S))
+  rule splitValue(pyWords(WORDS)) => pyList(WORDS)
+  rule splitValue(_) => pyList(.List) [owise]
+
+  // Expression evaluation for the constructors used by solution.mpy.
+  syntax PyVal ::= eval(Expr, Map) [function, total]
+  rule eval(Int(I), _) => pyInt(I)
+  rule eval(Str(S), _) => pyString(S)
+  rule eval(Name(X), ENV) => envGet(ENV, X)
+  rule eval(DictExpr(.Entries), _) => pyDict(.Map, .List)
+  rule eval(Call(Attribute(Name(X), "split"), .Exprs), ENV)
+    => splitValue(envGet(ENV, X))
+  rule eval(Subscript(DICT, KEY), ENV)
+    => dictGet(eval(DICT, ENV), eval(KEY, ENV))
+  rule eval(BinOp("+", LEFT, RIGHT), ENV)
+    => addValues(eval(LEFT, ENV), eval(RIGHT, ENV))
+  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)), ENV)
+    => compareValues(OP, eval(LEFT, ENV), eval(RIGHT, ENV))
+  rule eval(_, _) => pyBool(false) [owise]
+
+  syntax PyVal ::= envGet(Map, String) [function, total]
+  rule envGet(ENV[X <- VALUE:PyVal], X) => VALUE [simplification]
+  rule envGet(ENV[X <- _], Y) => envGet(ENV, Y)
+    requires X =/=String Y [simplification]
+  rule envGet((X |-> VALUE:PyVal) REST, X) => VALUE
+
+  syntax PyVal ::= dictGet(PyVal, PyVal) [function, total]
+  rule dictGet(pyDict((KEY |-> VALUE:PyVal) REST, _), KEY) => VALUE
+  rule dictGet(_, _) => pyBool(false) [owise]
+
+  syntax PyVal ::= addValues(PyVal, PyVal) [function, total]
+  rule addValues(pyInt(I), pyInt(J)) => pyInt(I +Int J)
+  rule addValues(_, _) => pyBool(false) [owise]
+
+  syntax PyVal ::= compareValues(String, PyVal, PyVal) [function, total]
+  rule compareValues("in", KEY, pyDict(DICT, _)) => pyBool(KEY in_keys(DICT))
+  rule compareValues(">", pyInt(I), pyInt(J)) => pyBool(I >Int J)
+  rule compareValues("==", LEFT, RIGHT) => pyBool(LEFT ==K RIGHT)
+  rule compareValues(_, _, _) => pyBool(false) [owise]
+
+  syntax Bool ::= truth(PyVal) [function, total]
+  rule truth(pyBool(B)) => B
+  rule truth(pyInt(I)) => I =/=Int 0
+  rule truth(_) => false [owise]
+
+  // Assignment supports local names and dictionary subscripts, the two target
+  // forms used by the implementation.
+  syntax Map ::= assign(Expr, PyVal, Map) [function, total]
+  rule assign(Name(X), VALUE, ENV) => ENV[X <- VALUE]
+  rule assign(Subscript(Name(X), KEY), VALUE, ENV)
+    => ENV[X <- dictSet(envGet(ENV, X), eval(KEY, ENV), VALUE)]
+  rule assign(_, _, ENV) => ENV [owise]
+
+  syntax PyVal ::= dictSet(PyVal, PyVal, PyVal) [function, total]
+  rule dictSet(pyDict(DICT, KEYS), KEY, VALUE)
+    => pyDict(DICT[KEY <- VALUE], KEYS)
+    requires KEY in_keys(DICT)
+  rule dictSet(pyDict(DICT, KEYS), KEY, VALUE)
+    => pyDict(DICT[KEY <- VALUE], KEYS ListItem(KEY))
+    requires notBool (KEY in_keys(DICT))
+  rule dictSet(VALUE, _, _) => VALUE [owise]
+
+  syntax List ::= iterable(PyVal) [function, total]
+  rule iterable(pyList(ITEMS)) => ITEMS
+  rule iterable(pyDict(_, KEYS)) => KEYS
+  rule iterable(_) => .List [owise]
+
+  // Deterministic big-step statement execution. execFor threads both normal
+  // state and an early return, so it is usable beyond this particular body.
+  syntax ExecResult ::= exec(Stmts, Map) [function, total]
+                      | execNext(ExecResult, Stmts) [function, total]
+                      | execStmt(Stmt, Map) [function, total]
+                      | execIf(Bool, Stmts, Stmts, Map) [function, total]
+                      | execFor(Expr, List, Stmts, Map) [function, total]
+                      | execForNext(ExecResult, Expr, List, Stmts) [function, total]
+
+  rule exec(.Stmts, ENV) => normal(ENV)
+  rule exec(STMT REST, ENV) => execNext(execStmt(STMT, ENV), REST)
+
+  rule execNext(normal(ENV), REST) => exec(REST, ENV)
+  rule execNext(returning(ENV, VALUE), _) => returning(ENV, VALUE)
+
+  rule execStmt(Assign(TARGET, VALUE), ENV)
+    => normal(assign(TARGET, eval(VALUE, ENV), ENV))
+  rule execStmt(If(TEST, YES, NO), ENV)
+    => execIf(truth(eval(TEST, ENV)), YES, NO, ENV)
+  rule execStmt(For(TARGET, SOURCE, BODY), ENV)
+    => execFor(TARGET, iterable(eval(SOURCE, ENV)), BODY, ENV)
+  rule execStmt(Return(VALUE), ENV) => returning(ENV, eval(VALUE, ENV))
+  rule execStmt(_, ENV) => normal(ENV) [owise]
+
+  rule execIf(true, YES, _, ENV) => exec(YES, ENV)
+  rule execIf(false, _, NO, ENV) => exec(NO, ENV)
+
+  rule execFor(_, .List, _, ENV) => normal(ENV)
+  rule execFor(TARGET, ListItem(ITEM) REST, BODY, ENV)
+    => execForNext(exec(BODY, assign(TARGET, ITEM, ENV)), TARGET, REST, BODY)
+
+  rule execForNext(normal(ENV), TARGET, REST, BODY)
+    => execFor(TARGET, REST, BODY, ENV)
+  rule execForNext(returning(ENV, VALUE), _, _, _)
+    => returning(ENV, VALUE)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..5ea417fafd7ca84f7bc51b13e5c73e2e9d01fadc
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,20 @@
+def histogram(test):
+    letters = test.split()
+    counts = {}
+    maximum = 0
+
+    for letter in letters:
+        if letter in counts:
+            counts[letter] = counts[letter] + 1
+        else:
+            counts[letter] = 1
+
+        if counts[letter] > maximum:
+            maximum = counts[letter]
+
+    result = {}
+    for letter in counts:
+        if counts[letter] == maximum:
+            result[letter] = counts[letter]
+
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f564a163737694924a969886c2b53eb712a2253b
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,44 @@
+requires "verification.k"
+
+module COUNT-LOOP-SPEC
+  imports VERIFICATION
+
+  claim [count-empty]:
+    <k>
+      execFor(Name("letter"), .List,
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ENV:Map)
+      => normal(ENV)
+    </k>
+
+  claim [count-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal) REST:List,
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ENV:Map)
+      => execFor(Name("letter"), REST,
+           If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+             Assign(Subscript(Name("counts"), Name("letter")),
+                    BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+             Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+           If(Compare(Subscript(Name("counts"), Name("letter")),
+                      CmpOp(">", Name("maximum"))),
+             Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+             .Stmts),
+           countIteration(WORD, ENV))
+    </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e3dd0fed1d36aafcd8dd69610dc76ecc25095e3c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,105 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A closed constructor for the exact translated program. This avoids
+  // copying a large AST into every claim while still proving solution.mpy.
+  syntax Program ::= histogramProgram() [function, total]
+  rule histogramProgram() =>
+    Module(
+      FuncDef("histogram", Params("test"),
+        Assign(Name("letters"), Call(Attribute(Name("test"), "split"), .Exprs))
+        Assign(Name("counts"), DictExpr(.Entries))
+        Assign(Name("maximum"), Int(0))
+        For(Name("letter"), Name("letters"),
+          If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+            Assign(Subscript(Name("counts"), Name("letter")),
+                   BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+            Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+          If(Compare(Subscript(Name("counts"), Name("letter")),
+                     CmpOp(">", Name("maximum"))),
+            Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+            .Stmts))
+        Assign(Name("result"), DictExpr(.Entries))
+        For(Name("letter"), Name("counts"),
+          If(Compare(Subscript(Name("counts"), Name("letter")),
+                     CmpOp("==", Name("maximum"))),
+            Assign(Subscript(Name("result"), Name("letter")),
+                   Subscript(Name("counts"), Name("letter"))),
+            .Stmts))
+        Return(Name("result"))))
+
+  // Denotational count pass. It is deliberately independent of exec/execFor:
+  // each word increments its dictionary entry and raises the maximum if needed.
+  syntax PyVal ::= nextCount(PyVal, PyVal) [function, total]
+  rule nextCount(pyDict((WORD |-> VALUE:PyVal) REST, _), WORD)
+    => addValues(VALUE, pyInt(1))
+  rule nextCount(pyDict(DICT, _), WORD) => pyInt(1)
+    requires notBool (WORD in_keys(DICT))
+  rule nextCount(_, _) => pyInt(1) [owise]
+
+  syntax Map ::= putCount(PyVal, Map) [function, total]
+  rule putCount(WORD, ENV)
+    => (ENV["letter" <- WORD])
+       ["counts" <- dictSet(envGet(ENV, "counts"), WORD,
+                            nextCount(envGet(ENV, "counts"), WORD))]
+
+  syntax Map ::= raiseMaximum(PyVal, Map) [function, total]
+  rule raiseMaximum(WORD, ENV)
+    => ENV["maximum" <- dictGet(envGet(ENV, "counts"), WORD)]
+    requires compareValues(">", dictGet(envGet(ENV, "counts"), WORD),
+                                envGet(ENV, "maximum")) ==K pyBool(true)
+  rule raiseMaximum(WORD, ENV) => ENV
+    requires compareValues(">", dictGet(envGet(ENV, "counts"), WORD),
+                                envGet(ENV, "maximum")) ==K pyBool(false)
+
+  syntax Map ::= countIteration(PyVal, Map) [function, total]
+  rule countIteration(WORD, ENV) => raiseMaximum(WORD, putCount(WORD, ENV))
+
+  syntax Map ::= countLoop(List, Map) [function, total]
+  rule countLoop(.List, ENV) => ENV
+  rule countLoop(ListItem(WORD) REST, ENV)
+    => countLoop(REST, countIteration(WORD, ENV))
+
+  // Denotational selection pass. The key list comes from the counted dict, and
+  // only entries equal to the previously established maximum are retained.
+  syntax Map ::= selectIteration(PyVal, Map) [function, total]
+  rule selectIteration(WORD, ENV)
+    => (ENV["letter" <- WORD])
+       ["result" <- dictSet(envGet(ENV, "result"), WORD,
+                            dictGet(envGet(ENV, "counts"), WORD))]
+    requires compareValues("==", dictGet(envGet(ENV, "counts"), WORD),
+                                 envGet(ENV, "maximum")) ==K pyBool(true)
+  rule selectIteration(WORD, ENV) => ENV["letter" <- WORD]
+    requires compareValues("==", dictGet(envGet(ENV, "counts"), WORD),
+                                 envGet(ENV, "maximum")) ==K pyBool(false)
+
+  syntax Map ::= selectLoop(List, Map) [function, total]
+  rule selectLoop(.List, ENV) => ENV
+  rule selectLoop(ListItem(WORD) REST, ENV)
+    => selectLoop(REST, selectIteration(WORD, ENV))
+
+  syntax List ::= dictKeys(PyVal) [function, total]
+  rule dictKeys(pyDict(_, KEYS)) => KEYS
+  rule dictKeys(_) => .List [owise]
+
+  syntax Map ::= initialEnv(List) [function, total]
+  rule initialEnv(WORDS) =>
+    "test" |-> pyWords(WORDS)
+    "letters" |-> pyList(WORDS)
+    "counts" |-> pyDict(.Map, .List)
+    "maximum" |-> pyInt(0)
+
+  syntax Map ::= afterCount(List) [function, total]
+  rule afterCount(WORDS) => countLoop(WORDS, initialEnv(WORDS))
+
+  syntax Map ::= beforeSelect(List) [function, total]
+  rule beforeSelect(WORDS) => afterCount(WORDS)["result" <- pyDict(.Map, .List)]
+
+  syntax PyVal ::= histogramSpec(List) [function, total]
+  rule histogramSpec(WORDS) =>
+    envGet(selectLoop(dictKeys(envGet(afterCount(WORDS), "counts")),
+                      beforeSelect(WORDS)),
+           "result")
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX -Wno unused-symbol -Wno unused-var >/tmp/kompile-verification.log 2>&1 && kprove spec.k --definition verification-kompiled --spec-module COUNT-LOOP-SPEC --output pretty -Wno unused-symbol -Wno unused-var' in /work
