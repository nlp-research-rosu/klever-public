diff --git a/lemmas.k b/lemmas.k
new file mode 100644
index 0000000000000000000000000000000000000000..de6c0945ba06684a51b5ea82bc7aba0a2cca91e2
--- /dev/null
+++ b/lemmas.k
@@ -0,0 +1,30 @@
+requires "verification.k"
+
+module VERIFIED-LOOP-LEMMAS
+  imports VERIFICATION
+
+  // These equations are the induction closures of the base/step obligations
+  // proved in COUNT-LOOP-SPEC and SELECT-LOOP-SPEC. They are kept in a
+  // separate compiled layer so those obligations cannot use the equations
+  // they are establishing.
+  rule execFor(Name("letter"), WORDS:List,
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ENV:Map)
+    => normal(countLoop(WORDS, ENV))
+
+  rule execFor(Name("letter"), WORDS:List,
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp("==", Name("maximum"))),
+          Assign(Subscript(Name("result"), Name("letter")),
+                 Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ENV:Map)
+    => normal(selectLoop(WORDS, ENV))
+endmodule
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..f2be95952f52507d96af47dbb60187cd34a672ae
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Recreate the constructor program from the submitted Python implementation.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Compile the semantics and exercise the translated program on every prompt
+# example. TEST is parsed at K sort String, hence the embedded double quotes.
+kompile semantic.k --backend haskell \
+  --main-module SEMANTIC --syntax-module MPY-SYNTAX \
+  -Wno unused-symbol -Wno unused-var
+krun solution.mpy --definition semantic-kompiled -cTEST='"a b c"' --output pretty
+krun solution.mpy --definition semantic-kompiled -cTEST='"a b b a"' --output pretty
+krun solution.mpy --definition semantic-kompiled -cTEST='"a b c a b"' --output pretty
+krun solution.mpy --definition semantic-kompiled -cTEST='"b b b b a"' --output pretty
+krun solution.mpy --definition semantic-kompiled -cTEST='""' --output pretty
+
+# Prove the base and exhaustive one-iteration obligations without importing
+# the induction-closure equations.
+kompile verification.k --backend haskell \
+  --main-module VERIFICATION --syntax-module MPY-SYNTAX \
+  -Wno unused-symbol -Wno unused-var
+kprove spec.k --definition verification-kompiled \
+  --spec-module COUNT-LOOP-SPEC --output pretty \
+  -Wno unused-symbol -Wno unused-var
+kprove spec.k --definition verification-kompiled \
+  --spec-module SELECT-LOOP-SPEC --output pretty \
+  -Wno unused-symbol -Wno unused-var
+kprove spec.k --definition verification-kompiled \
+  --spec-module EXAMPLES-SPEC --output pretty \
+  -Wno unused-symbol -Wno unused-var
+
+# Compile the now-verified loop equations as reusable induction lemmas and
+# prove the entry point equal to the denotational histogram for every token list.
+kompile lemmas.k --backend haskell \
+  --main-module VERIFIED-LOOP-LEMMAS --syntax-module MPY-SYNTAX \
+  -Wno unused-symbol -Wno unused-var
+kprove spec.k --definition lemmas-kompiled \
+  --spec-module MAIN-CORRECTNESS-SPEC --output pretty \
+  -Wno unused-symbol -Wno unused-var
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..fa53655897648028585890d65c381ca67f1a2297
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,190 @@
+module MPY-SYNTAX
+  imports INT
+  imports STRING
+  imports BOOL
+  imports K-EQUAL
+  imports MAP
+  imports LIST
+
+  syntax Program ::= Module(Stmts)
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= FuncDef(String, Params, Stmts)
+                | Assign(Expr, Expr)
+                | For(Expr, Expr, Stmts)
+                | If(Expr, Stmts, Stmts)
+                | Return(Expr)
+
+  syntax Params ::= Params(String)
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Entries ::= List{Entry, ","}
+  syntax Entry ::= Entry(Expr, Expr)
+  syntax CmpOp ::= CmpOp(String, Expr)
+
+  syntax Expr ::= Name(String)
+                | Int(Int)
+                | Str(String)
+                | DictExpr(Entries)
+                | Attribute(Expr, String)
+                | Call(Expr, Exprs)
+                | Subscript(Expr, Expr)
+                | BinOp(String, Expr, Expr)
+                | Compare(Expr, CmpOp)
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+
+  // Runtime values. Dictionaries retain an insertion-order key list because
+  // Python iteration over a dictionary visits keys in insertion order.
+  syntax PyVal ::= pyInt(Int)
+                 | pyString(String)
+                 | pyWords(List)
+                 | pyList(List)
+                 | pyDict(Map, List)
+                 | pyBool(Bool)
+
+  syntax ExecResult ::= normal(Map)
+                      | returning(Map, PyVal)
+
+  syntax KItem ::= execute(Program, String)
+                 | executeWords(Program, List)
+
+  configuration <k> execute($PGM:Program, $TEST:String) </k>
+
+  // Entry-point setup. executeWords is a verification harness for an
+  // arbitrary already-tokenized valid input; execute is the concrete runner.
+  rule execute(Module(FuncDef("histogram", Params("test"), BODY)), S)
+    => resultOf(exec(BODY, "test" |-> pyString(S)))
+
+  rule executeWords(Module(FuncDef("histogram", Params("test"), BODY)), WORDS)
+    => resultOf(exec(BODY, "test" |-> pyWords(WORDS)))
+
+  syntax PyVal ::= resultOf(ExecResult) [function, total]
+  rule resultOf(returning(_, VALUE)) => VALUE
+  rule resultOf(normal(_)) => pyBool(false)
+
+  // Python str.split() for the prompt's space-separated input language. Empty
+  // fields are skipped, matching Python for one or several ASCII spaces.
+  syntax List ::= splitWords(String) [function, total]
+  rule splitWords("") => .List
+  rule splitWords(S) => splitWords(substrString(S, 1, lengthString(S)))
+    requires S =/=String "" andBool substrString(S, 0, 1) ==String " "
+  rule splitWords(S) => ListItem(pyString(S))
+    requires S =/=String "" andBool findString(S, " ", 0) ==Int -1
+  rule splitWords(S) => ListItem(pyString(substrString(S, 0, findString(S, " ", 0))))
+                          splitWords(substrString(S, findString(S, " ", 0) +Int 1,
+                                                  lengthString(S)))
+    requires findString(S, " ", 0) >Int 0
+
+  syntax PyVal ::= splitValue(PyVal) [function, total]
+  rule splitValue(pyString(S)) => pyList(splitWords(S))
+  rule splitValue(pyWords(WORDS)) => pyList(WORDS)
+  rule splitValue(_) => pyList(.List) [owise]
+
+  // Expression evaluation for the constructors used by solution.mpy.
+  syntax PyVal ::= eval(Expr, Map) [function, total]
+  rule eval(Int(I), _) => pyInt(I)
+  rule eval(Str(S), _) => pyString(S)
+  rule eval(Name(X), ENV) => envGet(ENV, X)
+  rule eval(DictExpr(.Entries), _) => pyDict(.Map, .List)
+  rule eval(Call(Attribute(Name(X), "split"), .Exprs), ENV)
+    => splitValue(envGet(ENV, X))
+  rule eval(Subscript(DICT, KEY), ENV)
+    => dictGet(eval(DICT, ENV), eval(KEY, ENV))
+  rule eval(BinOp("+", LEFT, RIGHT), ENV)
+    => addValues(eval(LEFT, ENV), eval(RIGHT, ENV))
+  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)), ENV)
+    => compareValues(OP, eval(LEFT, ENV), eval(RIGHT, ENV))
+  rule eval(_, _) => pyBool(false) [owise]
+
+  syntax PyVal ::= envGet(Map, String) [function, total]
+  rule envGet(ENV[X <- VALUE:PyVal], X) => VALUE [simplification]
+  rule envGet(ENV[X <- _], Y) => envGet(ENV, Y)
+    requires X =/=String Y [simplification]
+  rule envGet((X |-> VALUE:PyVal) REST, X) => VALUE
+
+  syntax PyVal ::= dictGet(PyVal, PyVal) [function, total]
+  rule dictGet(pyDict(DICT[KEY <- VALUE:PyVal], _), KEY) => VALUE [simplification]
+  rule dictGet(pyDict(DICT[KEY1 <- _], KEYS), KEY2)
+    => dictGet(pyDict(DICT, KEYS), KEY2)
+    requires KEY1 =/=K KEY2 [simplification]
+  rule dictGet(pyDict((KEY |-> VALUE:PyVal) REST, _), KEY) => VALUE
+  rule dictGet(_, _) => pyBool(false) [owise]
+
+  syntax PyVal ::= addValues(PyVal, PyVal) [function, total]
+  rule addValues(pyInt(I), pyInt(J)) => pyInt(I +Int J)
+  rule addValues(_, _) => pyBool(false) [owise]
+
+  syntax PyVal ::= compareValues(String, PyVal, PyVal) [function, total]
+  rule compareValues("in", KEY, pyDict(DICT, _)) => pyBool(KEY in_keys(DICT))
+  rule compareValues(">", pyInt(I), pyInt(J)) => pyBool(I >Int J)
+  rule compareValues("==", LEFT, RIGHT) => pyBool(LEFT ==K RIGHT)
+  rule compareValues(_, _, _) => pyBool(false) [owise]
+
+  syntax Bool ::= truth(PyVal) [function, total]
+  rule truth(pyBool(B)) => B
+  rule truth(pyInt(I)) => I =/=Int 0
+  rule truth(_) => false [owise]
+
+  // Assignment supports local names and dictionary subscripts, the two target
+  // forms used by the implementation.
+  syntax Map ::= assign(Expr, PyVal, Map) [function, total]
+  rule assign(Name(X), VALUE, ENV) => ENV[X <- VALUE]
+  rule assign(Subscript(Name(X), KEY), VALUE, ENV)
+    => ENV[X <- dictSet(envGet(ENV, X), eval(KEY, ENV), VALUE)]
+  rule assign(_, _, ENV) => ENV [owise]
+
+  syntax PyVal ::= dictSet(PyVal, PyVal, PyVal) [function, total]
+  rule dictSet(pyDict(DICT, KEYS), KEY, VALUE)
+    => pyDict(DICT[KEY <- VALUE], KEYS)
+    requires KEY in_keys(DICT)
+  rule dictSet(pyDict(DICT, KEYS), KEY, VALUE)
+    => pyDict(DICT[KEY <- VALUE], KEYS ListItem(KEY))
+    requires notBool (KEY in_keys(DICT))
+  rule dictSet(VALUE, _, _) => VALUE [owise]
+
+  syntax List ::= iterable(PyVal) [function, total]
+  rule iterable(pyList(ITEMS)) => ITEMS
+  rule iterable(pyDict(_, KEYS)) => KEYS
+  rule iterable(_) => .List [owise]
+
+  // Deterministic big-step statement execution. execFor threads both normal
+  // state and an early return, so it is usable beyond this particular body.
+  syntax ExecResult ::= exec(Stmts, Map) [function, total]
+                      | execNext(ExecResult, Stmts) [function, total]
+                      | execStmt(Stmt, Map) [function, total]
+                      | execIf(Bool, Stmts, Stmts, Map) [function, total]
+                      | execFor(Expr, List, Stmts, Map) [function, total]
+                      | execForNext(ExecResult, Expr, List, Stmts) [function, total]
+
+  rule exec(.Stmts, ENV) => normal(ENV)
+  rule exec(STMT REST, ENV) => execNext(execStmt(STMT, ENV), REST)
+
+  rule execNext(normal(ENV), REST) => exec(REST, ENV)
+  rule execNext(returning(ENV, VALUE), _) => returning(ENV, VALUE)
+
+  rule execStmt(Assign(TARGET, VALUE), ENV)
+    => normal(assign(TARGET, eval(VALUE, ENV), ENV))
+  rule execStmt(If(TEST, YES, NO), ENV)
+    => execIf(truth(eval(TEST, ENV)), YES, NO, ENV)
+  rule execStmt(For(TARGET, SOURCE, BODY), ENV)
+    => execFor(TARGET, iterable(eval(SOURCE, ENV)), BODY, ENV)
+  rule execStmt(Return(VALUE), ENV) => returning(ENV, eval(VALUE, ENV))
+  rule execStmt(_, ENV) => normal(ENV) [owise]
+
+  rule execIf(CONDITION, YES, _, ENV) => exec(YES, ENV)
+    requires CONDITION
+  rule execIf(CONDITION, _, NO, ENV) => exec(NO, ENV)
+    requires notBool CONDITION
+
+  rule execFor(_, .List, _, ENV) => normal(ENV)
+  rule execFor(TARGET, ListItem(ITEM) (REST:List), BODY, ENV)
+    => execForNext(exec(BODY, assign(TARGET, ITEM, ENV)), TARGET, REST, BODY)
+
+  rule execForNext(normal(ENV), TARGET, REST, BODY)
+    => execFor(TARGET, REST, BODY, ENV)
+  rule execForNext(returning(ENV, VALUE), _, _, _)
+    => returning(ENV, VALUE)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..5ea417fafd7ca84f7bc51b13e5c73e2e9d01fadc
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,20 @@
+def histogram(test):
+    letters = test.split()
+    counts = {}
+    maximum = 0
+
+    for letter in letters:
+        if letter in counts:
+            counts[letter] = counts[letter] + 1
+        else:
+            counts[letter] = 1
+
+        if counts[letter] > maximum:
+            maximum = counts[letter]
+
+    result = {}
+    for letter in counts:
+        if counts[letter] == maximum:
+            result[letter] = counts[letter]
+
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..6385018cf6c5ea91b23fdcf5e681d9090c352a87
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,225 @@
+requires "verification.k"
+requires "lemmas.k"
+
+module COUNT-LOOP-SPEC
+  imports VERIFICATION
+
+  claim [count-empty]:
+    <k>
+      execFor(Name("letter"), .List,
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ENV:Map)
+      => normal(ENV)
+    </k>
+
+  claim [count-existing-raises-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal),
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ("counts" |-> pyDict((WORD |-> pyInt(N:Int)) DICTREST:Map, KEYS:List)
+         "maximum" |-> pyInt(M:Int)
+         ENVREST:Map))
+      => normal(countIteration(WORD,
+           ("counts" |-> pyDict((WORD |-> pyInt(N)) DICTREST, KEYS)
+            "maximum" |-> pyInt(M)
+            ENVREST)))
+    </k>
+    requires N +Int 1 >Int M
+
+  claim [count-fresh-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal),
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ("counts" |-> pyDict(DICT:Map, KEYS:List)
+         "maximum" |-> pyInt(M:Int)
+         ENVREST:Map))
+      => normal(countIteration(WORD,
+           ("counts" |-> pyDict(DICT, KEYS)
+            "maximum" |-> pyInt(M)
+            ENVREST)))
+    </k>
+    requires notBool (WORD in_keys(DICT)) andBool 1 >Int M
+
+  claim [count-existing-keeps-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal),
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ("counts" |-> pyDict((WORD |-> pyInt(N:Int)) DICTREST:Map, KEYS:List)
+         "maximum" |-> pyInt(M:Int)
+         ENVREST:Map))
+      => normal(countIteration(WORD,
+           ("counts" |-> pyDict((WORD |-> pyInt(N)) DICTREST, KEYS)
+            "maximum" |-> pyInt(M)
+            ENVREST)))
+    </k>
+    requires N +Int 1 <=Int M
+
+  claim [count-fresh-keeps-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal),
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ("counts" |-> pyDict(DICT:Map, KEYS:List)
+         "maximum" |-> pyInt(M:Int)
+         ENVREST:Map))
+      => normal(countIteration(WORD,
+           ("counts" |-> pyDict(DICT, KEYS)
+            "maximum" |-> pyInt(M)
+            ENVREST)))
+    </k>
+    requires notBool (WORD in_keys(DICT)) andBool 1 <=Int M
+endmodule
+
+module MAIN-CORRECTNESS-SPEC
+  imports VERIFIED-LOOP-LEMMAS
+
+  claim [all-token-lists]:
+    <k>
+      executeWords(histogramProgram(), WORDS:List)
+      => histogramSpec(WORDS)
+    </k>
+
+  claim [all-space-separated-strings]:
+    <k>
+      execute(histogramProgram(), INPUT:String)
+      => histogramSpecWith(splitWords(INPUT), pyString(INPUT))
+    </k>
+endmodule
+
+module SELECT-LOOP-SPEC
+  imports VERIFICATION
+
+  claim [select-empty]:
+    <k>
+      execFor(Name("letter"), .List,
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp("==", Name("maximum"))),
+          Assign(Subscript(Name("result"), Name("letter")),
+                 Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ENV:Map)
+      => normal(ENV)
+    </k>
+
+  claim [select-equal-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal),
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp("==", Name("maximum"))),
+          Assign(Subscript(Name("result"), Name("letter")),
+                 Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ("counts" |-> pyDict((WORD |-> VALUE:PyVal) DICTREST:Map, COUNTKEYS:List)
+         "maximum" |-> VALUE
+         "result" |-> pyDict(RESULTDICT:Map, RESULTKEYS:List)
+         ENVREST:Map))
+      => normal(selectIteration(WORD,
+           ("counts" |-> pyDict((WORD |-> VALUE) DICTREST, COUNTKEYS)
+            "maximum" |-> VALUE
+            "result" |-> pyDict(RESULTDICT, RESULTKEYS)
+            ENVREST)))
+    </k>
+
+  claim [select-unequal-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal),
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp("==", Name("maximum"))),
+          Assign(Subscript(Name("result"), Name("letter")),
+                 Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ("counts" |-> pyDict((WORD |-> VALUE:PyVal) DICTREST:Map, COUNTKEYS:List)
+         "maximum" |-> MAXIMUM:PyVal
+         "result" |-> pyDict(RESULTDICT:Map, RESULTKEYS:List)
+         ENVREST:Map))
+      => normal(selectIteration(WORD,
+           ("counts" |-> pyDict((WORD |-> VALUE) DICTREST, COUNTKEYS)
+            "maximum" |-> MAXIMUM
+            "result" |-> pyDict(RESULTDICT, RESULTKEYS)
+            ENVREST)))
+    </k>
+    requires VALUE =/=K MAXIMUM
+endmodule
+
+module EXAMPLES-SPEC
+  imports VERIFICATION
+
+  claim [example-all-once]:
+    <k>
+      execute(histogramProgram(), "a b c")
+      => pyDict(
+           pyString("a") |-> pyInt(1)
+           pyString("b") |-> pyInt(1)
+           pyString("c") |-> pyInt(1),
+           ListItem(pyString("a"))
+           ListItem(pyString("b"))
+           ListItem(pyString("c")))
+    </k>
+
+  claim [example-tied-two]:
+    <k>
+      execute(histogramProgram(), "a b b a")
+      => pyDict(
+           pyString("a") |-> pyInt(2)
+           pyString("b") |-> pyInt(2),
+           ListItem(pyString("a"))
+           ListItem(pyString("b")))
+    </k>
+
+  claim [example-filter-one]:
+    <k>
+      execute(histogramProgram(), "a b c a b")
+      => pyDict(
+           pyString("a") |-> pyInt(2)
+           pyString("b") |-> pyInt(2),
+           ListItem(pyString("a"))
+           ListItem(pyString("b")))
+    </k>
+
+  claim [example-single-winner]:
+    <k>
+      execute(histogramProgram(), "b b b b a")
+      => pyDict(pyString("b") |-> pyInt(4),
+                ListItem(pyString("b")))
+    </k>
+
+  claim [example-empty]:
+    <k>
+      execute(histogramProgram(), "")
+      => pyDict(.Map, .List)
+    </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4d71d2cfe64d33f3a33b99c199a20ce96cdab69e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,118 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A closed constructor for the exact translated program. This avoids
+  // copying a large AST into every claim while still proving solution.mpy.
+  syntax Program ::= histogramProgram() [function, total]
+  rule histogramProgram() =>
+    Module(
+      FuncDef("histogram", Params("test"),
+        Assign(Name("letters"), Call(Attribute(Name("test"), "split"), .Exprs))
+        Assign(Name("counts"), DictExpr(.Entries))
+        Assign(Name("maximum"), Int(0))
+        For(Name("letter"), Name("letters"),
+          If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+            Assign(Subscript(Name("counts"), Name("letter")),
+                   BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+            Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+          If(Compare(Subscript(Name("counts"), Name("letter")),
+                     CmpOp(">", Name("maximum"))),
+            Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+            .Stmts))
+        Assign(Name("result"), DictExpr(.Entries))
+        For(Name("letter"), Name("counts"),
+          If(Compare(Subscript(Name("counts"), Name("letter")),
+                     CmpOp("==", Name("maximum"))),
+            Assign(Subscript(Name("result"), Name("letter")),
+                   Subscript(Name("counts"), Name("letter"))),
+            .Stmts))
+        Return(Name("result"))))
+
+  // Denotational count pass. It is deliberately independent of exec/execFor:
+  // each word increments its dictionary entry and raises the maximum if needed.
+  syntax PyVal ::= nextCount(PyVal, PyVal) [function, total]
+  rule nextCount(pyDict((WORD |-> VALUE:PyVal) REST, _), WORD)
+    => addValues(VALUE, pyInt(1))
+  rule nextCount(pyDict(DICT, _), WORD) => pyInt(1)
+    requires notBool (WORD in_keys(DICT))
+  rule nextCount(_, _) => pyInt(1) [owise]
+
+  syntax Map ::= putCount(PyVal, Map) [function, total]
+  rule putCount(WORD, ENV)
+    => (ENV["letter" <- WORD])
+       ["counts" <- dictSet(envGet(ENV, "counts"), WORD,
+                            nextCount(envGet(ENV, "counts"), WORD))]
+
+  syntax Map ::= raiseMaximum(PyVal, Map) [function, total]
+  rule raiseMaximum(WORD, ENV)
+    => ENV["maximum" <- dictGet(envGet(ENV, "counts"), WORD)]
+    requires compareValues(">", dictGet(envGet(ENV, "counts"), WORD),
+                                envGet(ENV, "maximum")) ==K pyBool(true)
+  rule raiseMaximum(WORD, ENV) => ENV
+    requires compareValues(">", dictGet(envGet(ENV, "counts"), WORD),
+                                envGet(ENV, "maximum")) ==K pyBool(false)
+
+  syntax Map ::= countIteration(PyVal, Map) [function, total]
+  rule countIteration(WORD, ENV) => raiseMaximum(WORD, putCount(WORD, ENV))
+
+  syntax Map ::= countLoop(List, Map) [function, total]
+  rule countLoop(.List, ENV) => ENV
+  rule countLoop(ListItem(WORD) (REST:List), ENV)
+    => countLoop(REST, countIteration(WORD, ENV))
+
+  // Denotational selection pass. The key list comes from the counted dict, and
+  // only entries equal to the previously established maximum are retained.
+  syntax Map ::= selectIteration(PyVal, Map) [function, total]
+  rule selectIteration(WORD, ENV)
+    => (ENV["letter" <- WORD])
+       ["result" <- dictSet(envGet(ENV, "result"), WORD,
+                            dictGet(envGet(ENV, "counts"), WORD))]
+    requires compareValues("==", dictGet(envGet(ENV, "counts"), WORD),
+                                 envGet(ENV, "maximum")) ==K pyBool(true)
+  rule selectIteration(WORD, ENV) => ENV["letter" <- WORD]
+    requires compareValues("==", dictGet(envGet(ENV, "counts"), WORD),
+                                 envGet(ENV, "maximum")) ==K pyBool(false)
+
+  syntax Map ::= selectLoop(List, Map) [function, total]
+  rule selectLoop(.List, ENV) => ENV
+  rule selectLoop(ListItem(WORD) (REST:List), ENV)
+    => selectLoop(REST, selectIteration(WORD, ENV))
+
+  syntax List ::= dictKeys(PyVal) [function, total]
+  rule dictKeys(pyDict(_, KEYS)) => KEYS
+  rule dictKeys(_) => .List [owise]
+
+  syntax Map ::= initialEnvWith(List, PyVal) [function, total]
+  rule initialEnvWith(WORDS, INPUT) =>
+    "test" |-> INPUT
+    "letters" |-> pyList(WORDS)
+    "counts" |-> pyDict(.Map, .List)
+    "maximum" |-> pyInt(0)
+
+  syntax Map ::= initialEnv(List) [function, total]
+  rule initialEnv(WORDS) => initialEnvWith(WORDS, pyWords(WORDS))
+
+  syntax Map ::= afterCountWith(List, PyVal) [function, total]
+  rule afterCountWith(WORDS, INPUT) => countLoop(WORDS, initialEnvWith(WORDS, INPUT))
+
+  syntax Map ::= afterCount(List) [function, total]
+  rule afterCount(WORDS) => afterCountWith(WORDS, pyWords(WORDS))
+
+  syntax Map ::= beforeSelectWith(List, PyVal) [function, total]
+  rule beforeSelectWith(WORDS, INPUT) =>
+    afterCountWith(WORDS, INPUT)["result" <- pyDict(.Map, .List)]
+
+  syntax Map ::= beforeSelect(List) [function, total]
+  rule beforeSelect(WORDS) => beforeSelectWith(WORDS, pyWords(WORDS))
+
+  syntax PyVal ::= histogramSpecWith(List, PyVal) [function, total]
+  rule histogramSpecWith(WORDS, INPUT) =>
+    envGet(selectLoop(iterable(envGet(afterCountWith(WORDS, INPUT), "counts")),
+                      beforeSelectWith(WORDS, INPUT)),
+           "result")
+
+  syntax PyVal ::= histogramSpec(List) [function, total]
+  rule histogramSpec(WORDS) => histogramSpecWith(WORDS, pyWords(WORDS))
+endmodule

apply patch
patch: completed
/work/prove.sh
/work/spec.k
/work/verification.k
diff --git a/lemmas.k b/lemmas.k
new file mode 100644
index 0000000000000000000000000000000000000000..de6c0945ba06684a51b5ea82bc7aba0a2cca91e2
--- /dev/null
+++ b/lemmas.k
@@ -0,0 +1,30 @@
+requires "verification.k"
+
+module VERIFIED-LOOP-LEMMAS
+  imports VERIFICATION
+
+  // These equations are the induction closures of the base/step obligations
+  // proved in COUNT-LOOP-SPEC and SELECT-LOOP-SPEC. They are kept in a
+  // separate compiled layer so those obligations cannot use the equations
+  // they are establishing.
+  rule execFor(Name("letter"), WORDS:List,
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ENV:Map)
+    => normal(countLoop(WORDS, ENV))
+
+  rule execFor(Name("letter"), WORDS:List,
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp("==", Name("maximum"))),
+          Assign(Subscript(Name("result"), Name("letter")),
+                 Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ENV:Map)
+    => normal(selectLoop(WORDS, ENV))
+endmodule
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ff25bb5909cbdd23e7e0ab43defa1264c2918fe3
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Recreate the constructor program from the submitted Python implementation.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Compile the semantics and exercise the translated program on every prompt
+# example. TEST is parsed at K sort String, hence the embedded double quotes.
+kompile semantic.k --backend haskell \
+  --main-module SEMANTIC --syntax-module MPY-SYNTAX \
+  -Wno unused-symbol -Wno unused-var
+krun solution.mpy --definition semantic-kompiled -cTEST='"a b c"' --output pretty
+krun solution.mpy --definition semantic-kompiled -cTEST='"a b b a"' --output pretty
+krun solution.mpy --definition semantic-kompiled -cTEST='"a b c a b"' --output pretty
+krun solution.mpy --definition semantic-kompiled -cTEST='"b b b b a"' --output pretty
+krun solution.mpy --definition semantic-kompiled -cTEST='""' --output pretty
+
+# Prove the base and exhaustive one-iteration obligations without importing
+# the induction-closure equations.
+kompile verification.k --backend haskell \
+  --main-module VERIFICATION --syntax-module MPY-SYNTAX \
+  -Wno unused-symbol -Wno unused-var
+kprove spec.k --definition verification-kompiled \
+  --spec-module COUNT-LOOP-SPEC --output pretty \
+  -Wno unused-symbol -Wno unused-var
+kprove spec.k --definition verification-kompiled \
+  --spec-module SELECT-LOOP-SPEC --output pretty \
+  -Wno unused-symbol -Wno unused-var
+kprove spec.k --definition verification-kompiled \
+  --spec-module EXAMPLES-SPEC --output pretty \
+  -Wno unused-symbol -Wno unused-var
+
+# Compile the now-verified loop equations as reusable induction lemmas and
+# prove the entry point equal to the denotational histogram for every token list
+# and every space-separated input string.
+kompile lemmas.k --backend haskell \
+  --main-module VERIFIED-LOOP-LEMMAS --syntax-module MPY-SYNTAX \
+  -Wno unused-symbol -Wno unused-var
+kprove spec.k --definition lemmas-kompiled \
+  --spec-module MAIN-CORRECTNESS-SPEC --output pretty \
+  -Wno unused-symbol -Wno unused-var
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..fa53655897648028585890d65c381ca67f1a2297
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,190 @@
+module MPY-SYNTAX
+  imports INT
+  imports STRING
+  imports BOOL
+  imports K-EQUAL
+  imports MAP
+  imports LIST
+
+  syntax Program ::= Module(Stmts)
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= FuncDef(String, Params, Stmts)
+                | Assign(Expr, Expr)
+                | For(Expr, Expr, Stmts)
+                | If(Expr, Stmts, Stmts)
+                | Return(Expr)
+
+  syntax Params ::= Params(String)
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Entries ::= List{Entry, ","}
+  syntax Entry ::= Entry(Expr, Expr)
+  syntax CmpOp ::= CmpOp(String, Expr)
+
+  syntax Expr ::= Name(String)
+                | Int(Int)
+                | Str(String)
+                | DictExpr(Entries)
+                | Attribute(Expr, String)
+                | Call(Expr, Exprs)
+                | Subscript(Expr, Expr)
+                | BinOp(String, Expr, Expr)
+                | Compare(Expr, CmpOp)
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+
+  // Runtime values. Dictionaries retain an insertion-order key list because
+  // Python iteration over a dictionary visits keys in insertion order.
+  syntax PyVal ::= pyInt(Int)
+                 | pyString(String)
+                 | pyWords(List)
+                 | pyList(List)
+                 | pyDict(Map, List)
+                 | pyBool(Bool)
+
+  syntax ExecResult ::= normal(Map)
+                      | returning(Map, PyVal)
+
+  syntax KItem ::= execute(Program, String)
+                 | executeWords(Program, List)
+
+  configuration <k> execute($PGM:Program, $TEST:String) </k>
+
+  // Entry-point setup. executeWords is a verification harness for an
+  // arbitrary already-tokenized valid input; execute is the concrete runner.
+  rule execute(Module(FuncDef("histogram", Params("test"), BODY)), S)
+    => resultOf(exec(BODY, "test" |-> pyString(S)))
+
+  rule executeWords(Module(FuncDef("histogram", Params("test"), BODY)), WORDS)
+    => resultOf(exec(BODY, "test" |-> pyWords(WORDS)))
+
+  syntax PyVal ::= resultOf(ExecResult) [function, total]
+  rule resultOf(returning(_, VALUE)) => VALUE
+  rule resultOf(normal(_)) => pyBool(false)
+
+  // Python str.split() for the prompt's space-separated input language. Empty
+  // fields are skipped, matching Python for one or several ASCII spaces.
+  syntax List ::= splitWords(String) [function, total]
+  rule splitWords("") => .List
+  rule splitWords(S) => splitWords(substrString(S, 1, lengthString(S)))
+    requires S =/=String "" andBool substrString(S, 0, 1) ==String " "
+  rule splitWords(S) => ListItem(pyString(S))
+    requires S =/=String "" andBool findString(S, " ", 0) ==Int -1
+  rule splitWords(S) => ListItem(pyString(substrString(S, 0, findString(S, " ", 0))))
+                          splitWords(substrString(S, findString(S, " ", 0) +Int 1,
+                                                  lengthString(S)))
+    requires findString(S, " ", 0) >Int 0
+
+  syntax PyVal ::= splitValue(PyVal) [function, total]
+  rule splitValue(pyString(S)) => pyList(splitWords(S))
+  rule splitValue(pyWords(WORDS)) => pyList(WORDS)
+  rule splitValue(_) => pyList(.List) [owise]
+
+  // Expression evaluation for the constructors used by solution.mpy.
+  syntax PyVal ::= eval(Expr, Map) [function, total]
+  rule eval(Int(I), _) => pyInt(I)
+  rule eval(Str(S), _) => pyString(S)
+  rule eval(Name(X), ENV) => envGet(ENV, X)
+  rule eval(DictExpr(.Entries), _) => pyDict(.Map, .List)
+  rule eval(Call(Attribute(Name(X), "split"), .Exprs), ENV)
+    => splitValue(envGet(ENV, X))
+  rule eval(Subscript(DICT, KEY), ENV)
+    => dictGet(eval(DICT, ENV), eval(KEY, ENV))
+  rule eval(BinOp("+", LEFT, RIGHT), ENV)
+    => addValues(eval(LEFT, ENV), eval(RIGHT, ENV))
+  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)), ENV)
+    => compareValues(OP, eval(LEFT, ENV), eval(RIGHT, ENV))
+  rule eval(_, _) => pyBool(false) [owise]
+
+  syntax PyVal ::= envGet(Map, String) [function, total]
+  rule envGet(ENV[X <- VALUE:PyVal], X) => VALUE [simplification]
+  rule envGet(ENV[X <- _], Y) => envGet(ENV, Y)
+    requires X =/=String Y [simplification]
+  rule envGet((X |-> VALUE:PyVal) REST, X) => VALUE
+
+  syntax PyVal ::= dictGet(PyVal, PyVal) [function, total]
+  rule dictGet(pyDict(DICT[KEY <- VALUE:PyVal], _), KEY) => VALUE [simplification]
+  rule dictGet(pyDict(DICT[KEY1 <- _], KEYS), KEY2)
+    => dictGet(pyDict(DICT, KEYS), KEY2)
+    requires KEY1 =/=K KEY2 [simplification]
+  rule dictGet(pyDict((KEY |-> VALUE:PyVal) REST, _), KEY) => VALUE
+  rule dictGet(_, _) => pyBool(false) [owise]
+
+  syntax PyVal ::= addValues(PyVal, PyVal) [function, total]
+  rule addValues(pyInt(I), pyInt(J)) => pyInt(I +Int J)
+  rule addValues(_, _) => pyBool(false) [owise]
+
+  syntax PyVal ::= compareValues(String, PyVal, PyVal) [function, total]
+  rule compareValues("in", KEY, pyDict(DICT, _)) => pyBool(KEY in_keys(DICT))
+  rule compareValues(">", pyInt(I), pyInt(J)) => pyBool(I >Int J)
+  rule compareValues("==", LEFT, RIGHT) => pyBool(LEFT ==K RIGHT)
+  rule compareValues(_, _, _) => pyBool(false) [owise]
+
+  syntax Bool ::= truth(PyVal) [function, total]
+  rule truth(pyBool(B)) => B
+  rule truth(pyInt(I)) => I =/=Int 0
+  rule truth(_) => false [owise]
+
+  // Assignment supports local names and dictionary subscripts, the two target
+  // forms used by the implementation.
+  syntax Map ::= assign(Expr, PyVal, Map) [function, total]
+  rule assign(Name(X), VALUE, ENV) => ENV[X <- VALUE]
+  rule assign(Subscript(Name(X), KEY), VALUE, ENV)
+    => ENV[X <- dictSet(envGet(ENV, X), eval(KEY, ENV), VALUE)]
+  rule assign(_, _, ENV) => ENV [owise]
+
+  syntax PyVal ::= dictSet(PyVal, PyVal, PyVal) [function, total]
+  rule dictSet(pyDict(DICT, KEYS), KEY, VALUE)
+    => pyDict(DICT[KEY <- VALUE], KEYS)
+    requires KEY in_keys(DICT)
+  rule dictSet(pyDict(DICT, KEYS), KEY, VALUE)
+    => pyDict(DICT[KEY <- VALUE], KEYS ListItem(KEY))
+    requires notBool (KEY in_keys(DICT))
+  rule dictSet(VALUE, _, _) => VALUE [owise]
+
+  syntax List ::= iterable(PyVal) [function, total]
+  rule iterable(pyList(ITEMS)) => ITEMS
+  rule iterable(pyDict(_, KEYS)) => KEYS
+  rule iterable(_) => .List [owise]
+
+  // Deterministic big-step statement execution. execFor threads both normal
+  // state and an early return, so it is usable beyond this particular body.
+  syntax ExecResult ::= exec(Stmts, Map) [function, total]
+                      | execNext(ExecResult, Stmts) [function, total]
+                      | execStmt(Stmt, Map) [function, total]
+                      | execIf(Bool, Stmts, Stmts, Map) [function, total]
+                      | execFor(Expr, List, Stmts, Map) [function, total]
+                      | execForNext(ExecResult, Expr, List, Stmts) [function, total]
+
+  rule exec(.Stmts, ENV) => normal(ENV)
+  rule exec(STMT REST, ENV) => execNext(execStmt(STMT, ENV), REST)
+
+  rule execNext(normal(ENV), REST) => exec(REST, ENV)
+  rule execNext(returning(ENV, VALUE), _) => returning(ENV, VALUE)
+
+  rule execStmt(Assign(TARGET, VALUE), ENV)
+    => normal(assign(TARGET, eval(VALUE, ENV), ENV))
+  rule execStmt(If(TEST, YES, NO), ENV)
+    => execIf(truth(eval(TEST, ENV)), YES, NO, ENV)
+  rule execStmt(For(TARGET, SOURCE, BODY), ENV)
+    => execFor(TARGET, iterable(eval(SOURCE, ENV)), BODY, ENV)
+  rule execStmt(Return(VALUE), ENV) => returning(ENV, eval(VALUE, ENV))
+  rule execStmt(_, ENV) => normal(ENV) [owise]
+
+  rule execIf(CONDITION, YES, _, ENV) => exec(YES, ENV)
+    requires CONDITION
+  rule execIf(CONDITION, _, NO, ENV) => exec(NO, ENV)
+    requires notBool CONDITION
+
+  rule execFor(_, .List, _, ENV) => normal(ENV)
+  rule execFor(TARGET, ListItem(ITEM) (REST:List), BODY, ENV)
+    => execForNext(exec(BODY, assign(TARGET, ITEM, ENV)), TARGET, REST, BODY)
+
+  rule execForNext(normal(ENV), TARGET, REST, BODY)
+    => execFor(TARGET, REST, BODY, ENV)
+  rule execForNext(returning(ENV, VALUE), _, _, _)
+    => returning(ENV, VALUE)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..5ea417fafd7ca84f7bc51b13e5c73e2e9d01fadc
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,20 @@
+def histogram(test):
+    letters = test.split()
+    counts = {}
+    maximum = 0
+
+    for letter in letters:
+        if letter in counts:
+            counts[letter] = counts[letter] + 1
+        else:
+            counts[letter] = 1
+
+        if counts[letter] > maximum:
+            maximum = counts[letter]
+
+    result = {}
+    for letter in counts:
+        if counts[letter] == maximum:
+            result[letter] = counts[letter]
+
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..fd0fb2e6bb38ec284a0e343b105275fea69a38c0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,225 @@
+requires "verification.k"
+requires "lemmas.k"
+
+module COUNT-LOOP-SPEC
+  imports VERIFICATION
+
+  claim [count-empty]:
+    <k>
+      execFor(Name("letter"), .List,
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ENV:Map)
+      => normal(ENV)
+    </k>
+
+  claim [count-existing-raises-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal),
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ("counts" |-> pyDict((WORD |-> pyInt(N:Int)) DICTREST:Map, KEYS:List)
+         "maximum" |-> pyInt(M:Int)
+         ENVREST:Map))
+      => normal(countIteration(WORD,
+           ("counts" |-> pyDict((WORD |-> pyInt(N)) DICTREST, KEYS)
+            "maximum" |-> pyInt(M)
+            ENVREST)))
+    </k>
+    requires N +Int 1 >Int M
+
+  claim [count-fresh-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal),
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ("counts" |-> pyDict(DICT:Map, KEYS:List)
+         "maximum" |-> pyInt(M:Int)
+         ENVREST:Map))
+      => normal(countIteration(WORD,
+           ("counts" |-> pyDict(DICT, KEYS)
+            "maximum" |-> pyInt(M)
+            ENVREST)))
+    </k>
+    requires notBool (WORD in_keys(DICT)) andBool 1 >Int M
+
+  claim [count-existing-keeps-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal),
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ("counts" |-> pyDict((WORD |-> pyInt(N:Int)) DICTREST:Map, KEYS:List)
+         "maximum" |-> pyInt(M:Int)
+         ENVREST:Map))
+      => normal(countIteration(WORD,
+           ("counts" |-> pyDict((WORD |-> pyInt(N)) DICTREST, KEYS)
+            "maximum" |-> pyInt(M)
+            ENVREST)))
+    </k>
+    requires N +Int 1 <=Int M
+
+  claim [count-fresh-keeps-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal),
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ("counts" |-> pyDict(DICT:Map, KEYS:List)
+         "maximum" |-> pyInt(M:Int)
+         ENVREST:Map))
+      => normal(countIteration(WORD,
+           ("counts" |-> pyDict(DICT, KEYS)
+            "maximum" |-> pyInt(M)
+            ENVREST)))
+    </k>
+    requires notBool (WORD in_keys(DICT)) andBool 1 <=Int M
+endmodule
+
+module MAIN-CORRECTNESS-SPEC
+  imports VERIFIED-LOOP-LEMMAS
+
+  claim [all-token-lists]:
+    <k>
+      executeWords(histogramProgram(), WORDS:List)
+      => histogramSpec(WORDS)
+    </k>
+
+  claim [all-space-separated-strings]:
+    <k>
+      execute(histogramProgram(), INPUT:String)
+      => histogramSpecString(INPUT)
+    </k>
+endmodule
+
+module SELECT-LOOP-SPEC
+  imports VERIFICATION
+
+  claim [select-empty]:
+    <k>
+      execFor(Name("letter"), .List,
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp("==", Name("maximum"))),
+          Assign(Subscript(Name("result"), Name("letter")),
+                 Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ENV:Map)
+      => normal(ENV)
+    </k>
+
+  claim [select-equal-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal),
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp("==", Name("maximum"))),
+          Assign(Subscript(Name("result"), Name("letter")),
+                 Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ("counts" |-> pyDict((WORD |-> VALUE:PyVal) DICTREST:Map, COUNTKEYS:List)
+         "maximum" |-> VALUE
+         "result" |-> pyDict(RESULTDICT:Map, RESULTKEYS:List)
+         ENVREST:Map))
+      => normal(selectIteration(WORD,
+           ("counts" |-> pyDict((WORD |-> VALUE) DICTREST, COUNTKEYS)
+            "maximum" |-> VALUE
+            "result" |-> pyDict(RESULTDICT, RESULTKEYS)
+            ENVREST)))
+    </k>
+
+  claim [select-unequal-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal),
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp("==", Name("maximum"))),
+          Assign(Subscript(Name("result"), Name("letter")),
+                 Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ("counts" |-> pyDict((WORD |-> VALUE:PyVal) DICTREST:Map, COUNTKEYS:List)
+         "maximum" |-> MAXIMUM:PyVal
+         "result" |-> pyDict(RESULTDICT:Map, RESULTKEYS:List)
+         ENVREST:Map))
+      => normal(selectIteration(WORD,
+           ("counts" |-> pyDict((WORD |-> VALUE) DICTREST, COUNTKEYS)
+            "maximum" |-> MAXIMUM
+            "result" |-> pyDict(RESULTDICT, RESULTKEYS)
+            ENVREST)))
+    </k>
+    requires VALUE =/=K MAXIMUM
+endmodule
+
+module EXAMPLES-SPEC
+  imports VERIFICATION
+
+  claim [example-all-once]:
+    <k>
+      execute(histogramProgram(), "a b c")
+      => pyDict(
+           pyString("a") |-> pyInt(1)
+           pyString("b") |-> pyInt(1)
+           pyString("c") |-> pyInt(1),
+           ListItem(pyString("a"))
+           ListItem(pyString("b"))
+           ListItem(pyString("c")))
+    </k>
+
+  claim [example-tied-two]:
+    <k>
+      execute(histogramProgram(), "a b b a")
+      => pyDict(
+           pyString("a") |-> pyInt(2)
+           pyString("b") |-> pyInt(2),
+           ListItem(pyString("a"))
+           ListItem(pyString("b")))
+    </k>
+
+  claim [example-filter-one]:
+    <k>
+      execute(histogramProgram(), "a b c a b")
+      => pyDict(
+           pyString("a") |-> pyInt(2)
+           pyString("b") |-> pyInt(2),
+           ListItem(pyString("a"))
+           ListItem(pyString("b")))
+    </k>
+
+  claim [example-single-winner]:
+    <k>
+      execute(histogramProgram(), "b b b b a")
+      => pyDict(pyString("b") |-> pyInt(4),
+                ListItem(pyString("b")))
+    </k>
+
+  claim [example-empty]:
+    <k>
+      execute(histogramProgram(), "")
+      => pyDict(.Map, .List)
+    </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..33d6a9b0a8149d4e7f2d1fbfcd8921db606bccc9
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,122 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports SEMANTIC
+
+  // A closed constructor for the exact translated program. This avoids
+  // copying a large AST into every claim while still proving solution.mpy.
+  syntax Program ::= histogramProgram() [function, total]
+  rule histogramProgram() =>
+    Module(
+      FuncDef("histogram", Params("test"),
+        Assign(Name("letters"), Call(Attribute(Name("test"), "split"), .Exprs))
+        Assign(Name("counts"), DictExpr(.Entries))
+        Assign(Name("maximum"), Int(0))
+        For(Name("letter"), Name("letters"),
+          If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+            Assign(Subscript(Name("counts"), Name("letter")),
+                   BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+            Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+          If(Compare(Subscript(Name("counts"), Name("letter")),
+                     CmpOp(">", Name("maximum"))),
+            Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+            .Stmts))
+        Assign(Name("result"), DictExpr(.Entries))
+        For(Name("letter"), Name("counts"),
+          If(Compare(Subscript(Name("counts"), Name("letter")),
+                     CmpOp("==", Name("maximum"))),
+            Assign(Subscript(Name("result"), Name("letter")),
+                   Subscript(Name("counts"), Name("letter"))),
+            .Stmts))
+        Return(Name("result"))))
+
+  // Denotational count pass. It is deliberately independent of exec/execFor:
+  // each word increments its dictionary entry and raises the maximum if needed.
+  syntax PyVal ::= nextCount(PyVal, PyVal) [function, total]
+  rule nextCount(pyDict((WORD |-> VALUE:PyVal) REST, _), WORD)
+    => addValues(VALUE, pyInt(1))
+  rule nextCount(pyDict(DICT, _), WORD) => pyInt(1)
+    requires notBool (WORD in_keys(DICT))
+  rule nextCount(_, _) => pyInt(1) [owise]
+
+  syntax Map ::= putCount(PyVal, Map) [function, total]
+  rule putCount(WORD, ENV)
+    => (ENV["letter" <- WORD])
+       ["counts" <- dictSet(envGet(ENV, "counts"), WORD,
+                            nextCount(envGet(ENV, "counts"), WORD))]
+
+  syntax Map ::= raiseMaximum(PyVal, Map) [function, total]
+  rule raiseMaximum(WORD, ENV)
+    => ENV["maximum" <- dictGet(envGet(ENV, "counts"), WORD)]
+    requires compareValues(">", dictGet(envGet(ENV, "counts"), WORD),
+                                envGet(ENV, "maximum")) ==K pyBool(true)
+  rule raiseMaximum(WORD, ENV) => ENV
+    requires compareValues(">", dictGet(envGet(ENV, "counts"), WORD),
+                                envGet(ENV, "maximum")) ==K pyBool(false)
+
+  syntax Map ::= countIteration(PyVal, Map) [function, total]
+  rule countIteration(WORD, ENV) => raiseMaximum(WORD, putCount(WORD, ENV))
+
+  syntax Map ::= countLoop(List, Map) [function, total]
+  rule countLoop(.List, ENV) => ENV
+  rule countLoop(ListItem(WORD) (REST:List), ENV)
+    => countLoop(REST, countIteration(WORD, ENV))
+
+  // Denotational selection pass. The key list comes from the counted dict, and
+  // only entries equal to the previously established maximum are retained.
+  syntax Map ::= selectIteration(PyVal, Map) [function, total]
+  rule selectIteration(WORD, ENV)
+    => (ENV["letter" <- WORD])
+       ["result" <- dictSet(envGet(ENV, "result"), WORD,
+                            dictGet(envGet(ENV, "counts"), WORD))]
+    requires compareValues("==", dictGet(envGet(ENV, "counts"), WORD),
+                                 envGet(ENV, "maximum")) ==K pyBool(true)
+  rule selectIteration(WORD, ENV) => ENV["letter" <- WORD]
+    requires compareValues("==", dictGet(envGet(ENV, "counts"), WORD),
+                                 envGet(ENV, "maximum")) ==K pyBool(false)
+
+  syntax Map ::= selectLoop(List, Map) [function, total]
+  rule selectLoop(.List, ENV) => ENV
+  rule selectLoop(ListItem(WORD) (REST:List), ENV)
+    => selectLoop(REST, selectIteration(WORD, ENV))
+
+  syntax List ::= dictKeys(PyVal) [function, total]
+  rule dictKeys(pyDict(_, KEYS)) => KEYS
+  rule dictKeys(_) => .List [owise]
+
+  syntax Map ::= initialEnvWith(List, PyVal) [function, total]
+  rule initialEnvWith(WORDS, INPUT) =>
+    "test" |-> INPUT
+    "letters" |-> pyList(WORDS)
+    "counts" |-> pyDict(.Map, .List)
+    "maximum" |-> pyInt(0)
+
+  syntax Map ::= initialEnv(List) [function, total]
+  rule initialEnv(WORDS) => initialEnvWith(WORDS, pyWords(WORDS))
+
+  syntax Map ::= afterCountWith(List, PyVal) [function, total]
+  rule afterCountWith(WORDS, INPUT) => countLoop(WORDS, initialEnvWith(WORDS, INPUT))
+
+  syntax Map ::= afterCount(List) [function, total]
+  rule afterCount(WORDS) => afterCountWith(WORDS, pyWords(WORDS))
+
+  syntax Map ::= beforeSelectWith(List, PyVal) [function, total]
+  rule beforeSelectWith(WORDS, INPUT) =>
+    afterCountWith(WORDS, INPUT)["result" <- pyDict(.Map, .List)]
+
+  syntax Map ::= beforeSelect(List) [function, total]
+  rule beforeSelect(WORDS) => beforeSelectWith(WORDS, pyWords(WORDS))
+
+  syntax PyVal ::= histogramSpecWith(List, PyVal) [function, total]
+  rule histogramSpecWith(WORDS, INPUT) =>
+    envGet(selectLoop(iterable(envGet(afterCountWith(WORDS, INPUT), "counts")),
+                      beforeSelectWith(WORDS, INPUT)),
+           "result")
+
+  syntax PyVal ::= histogramSpec(List) [function, total]
+  rule histogramSpec(WORDS) => histogramSpecWith(WORDS, pyWords(WORDS))
+
+  syntax PyVal ::= histogramSpecString(String) [function, total]
+  rule histogramSpecString(INPUT) =>
+    histogramSpecWith(splitWords(INPUT), pyString(INPUT))
+endmodule

diff --git a/lemmas.k b/lemmas.k
new file mode 100644
index 0000000000000000000000000000000000000000..de6c0945ba06684a51b5ea82bc7aba0a2cca91e2
--- /dev/null
+++ b/lemmas.k
@@ -0,0 +1,30 @@
+requires "verification.k"
+
+module VERIFIED-LOOP-LEMMAS
+  imports VERIFICATION
+
+  // These equations are the induction closures of the base/step obligations
+  // proved in COUNT-LOOP-SPEC and SELECT-LOOP-SPEC. They are kept in a
+  // separate compiled layer so those obligations cannot use the equations
+  // they are establishing.
+  rule execFor(Name("letter"), WORDS:List,
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ENV:Map)
+    => normal(countLoop(WORDS, ENV))
+
+  rule execFor(Name("letter"), WORDS:List,
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp("==", Name("maximum"))),
+          Assign(Subscript(Name("result"), Name("letter")),
+                 Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ENV:Map)
+    => normal(selectLoop(WORDS, ENV))
+endmodule
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ff25bb5909cbdd23e7e0ab43defa1264c2918fe3
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Recreate the constructor program from the submitted Python implementation.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Compile the semantics and exercise the translated program on every prompt
+# example. TEST is parsed at K sort String, hence the embedded double quotes.
+kompile semantic.k --backend haskell \
+  --main-module SEMANTIC --syntax-module MPY-SYNTAX \
+  -Wno unused-symbol -Wno unused-var
+krun solution.mpy --definition semantic-kompiled -cTEST='"a b c"' --output pretty
+krun solution.mpy --definition semantic-kompiled -cTEST='"a b b a"' --output pretty
+krun solution.mpy --definition semantic-kompiled -cTEST='"a b c a b"' --output pretty
+krun solution.mpy --definition semantic-kompiled -cTEST='"b b b b a"' --output pretty
+krun solution.mpy --definition semantic-kompiled -cTEST='""' --output pretty
+
+# Prove the base and exhaustive one-iteration obligations without importing
+# the induction-closure equations.
+kompile verification.k --backend haskell \
+  --main-module VERIFICATION --syntax-module MPY-SYNTAX \
+  -Wno unused-symbol -Wno unused-var
+kprove spec.k --definition verification-kompiled \
+  --spec-module COUNT-LOOP-SPEC --output pretty \
+  -Wno unused-symbol -Wno unused-var
+kprove spec.k --definition verification-kompiled \
+  --spec-module SELECT-LOOP-SPEC --output pretty \
+  -Wno unused-symbol -Wno unused-var
+kprove spec.k --definition verification-kompiled \
+  --spec-module EXAMPLES-SPEC --output pretty \
+  -Wno unused-symbol -Wno unused-var
+
+# Compile the now-verified loop equations as reusable induction lemmas and
+# prove the entry point equal to the denotational histogram for every token list
+# and every space-separated input string.
+kompile lemmas.k --backend haskell \
+  --main-module VERIFIED-LOOP-LEMMAS --syntax-module MPY-SYNTAX \
+  -Wno unused-symbol -Wno unused-var
+kprove spec.k --definition lemmas-kompiled \
+  --spec-module MAIN-CORRECTNESS-SPEC --output pretty \
+  -Wno unused-symbol -Wno unused-var
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..fa53655897648028585890d65c381ca67f1a2297
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,190 @@
+module MPY-SYNTAX
+  imports INT
+  imports STRING
+  imports BOOL
+  imports K-EQUAL
+  imports MAP
+  imports LIST
+
+  syntax Program ::= Module(Stmts)
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= FuncDef(String, Params, Stmts)
+                | Assign(Expr, Expr)
+                | For(Expr, Expr, Stmts)
+                | If(Expr, Stmts, Stmts)
+                | Return(Expr)
+
+  syntax Params ::= Params(String)
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Entries ::= List{Entry, ","}
+  syntax Entry ::= Entry(Expr, Expr)
+  syntax CmpOp ::= CmpOp(String, Expr)
+
+  syntax Expr ::= Name(String)
+                | Int(Int)
+                | Str(String)
+                | DictExpr(Entries)
+                | Attribute(Expr, String)
+                | Call(Expr, Exprs)
+                | Subscript(Expr, Expr)
+                | BinOp(String, Expr, Expr)
+                | Compare(Expr, CmpOp)
+endmodule
+
+module SEMANTIC
+  imports MPY-SYNTAX
+
+  // Runtime values. Dictionaries retain an insertion-order key list because
+  // Python iteration over a dictionary visits keys in insertion order.
+  syntax PyVal ::= pyInt(Int)
+                 | pyString(String)
+                 | pyWords(List)
+                 | pyList(List)
+                 | pyDict(Map, List)
+                 | pyBool(Bool)
+
+  syntax ExecResult ::= normal(Map)
+                      | returning(Map, PyVal)
+
+  syntax KItem ::= execute(Program, String)
+                 | executeWords(Program, List)
+
+  configuration <k> execute($PGM:Program, $TEST:String) </k>
+
+  // Entry-point setup. executeWords is a verification harness for an
+  // arbitrary already-tokenized valid input; execute is the concrete runner.
+  rule execute(Module(FuncDef("histogram", Params("test"), BODY)), S)
+    => resultOf(exec(BODY, "test" |-> pyString(S)))
+
+  rule executeWords(Module(FuncDef("histogram", Params("test"), BODY)), WORDS)
+    => resultOf(exec(BODY, "test" |-> pyWords(WORDS)))
+
+  syntax PyVal ::= resultOf(ExecResult) [function, total]
+  rule resultOf(returning(_, VALUE)) => VALUE
+  rule resultOf(normal(_)) => pyBool(false)
+
+  // Python str.split() for the prompt's space-separated input language. Empty
+  // fields are skipped, matching Python for one or several ASCII spaces.
+  syntax List ::= splitWords(String) [function, total]
+  rule splitWords("") => .List
+  rule splitWords(S) => splitWords(substrString(S, 1, lengthString(S)))
+    requires S =/=String "" andBool substrString(S, 0, 1) ==String " "
+  rule splitWords(S) => ListItem(pyString(S))
+    requires S =/=String "" andBool findString(S, " ", 0) ==Int -1
+  rule splitWords(S) => ListItem(pyString(substrString(S, 0, findString(S, " ", 0))))
+                          splitWords(substrString(S, findString(S, " ", 0) +Int 1,
+                                                  lengthString(S)))
+    requires findString(S, " ", 0) >Int 0
+
+  syntax PyVal ::= splitValue(PyVal) [function, total]
+  rule splitValue(pyString(S)) => pyList(splitWords(S))
+  rule splitValue(pyWords(WORDS)) => pyList(WORDS)
+  rule splitValue(_) => pyList(.List) [owise]
+
+  // Expression evaluation for the constructors used by solution.mpy.
+  syntax PyVal ::= eval(Expr, Map) [function, total]
+  rule eval(Int(I), _) => pyInt(I)
+  rule eval(Str(S), _) => pyString(S)
+  rule eval(Name(X), ENV) => envGet(ENV, X)
+  rule eval(DictExpr(.Entries), _) => pyDict(.Map, .List)
+  rule eval(Call(Attribute(Name(X), "split"), .Exprs), ENV)
+    => splitValue(envGet(ENV, X))
+  rule eval(Subscript(DICT, KEY), ENV)
+    => dictGet(eval(DICT, ENV), eval(KEY, ENV))
+  rule eval(BinOp("+", LEFT, RIGHT), ENV)
+    => addValues(eval(LEFT, ENV), eval(RIGHT, ENV))
+  rule eval(Compare(LEFT, CmpOp(OP, RIGHT)), ENV)
+    => compareValues(OP, eval(LEFT, ENV), eval(RIGHT, ENV))
+  rule eval(_, _) => pyBool(false) [owise]
+
+  syntax PyVal ::= envGet(Map, String) [function, total]
+  rule envGet(ENV[X <- VALUE:PyVal], X) => VALUE [simplification]
+  rule envGet(ENV[X <- _], Y) => envGet(ENV, Y)
+    requires X =/=String Y [simplification]
+  rule envGet((X |-> VALUE:PyVal) REST, X) => VALUE
+
+  syntax PyVal ::= dictGet(PyVal, PyVal) [function, total]
+  rule dictGet(pyDict(DICT[KEY <- VALUE:PyVal], _), KEY) => VALUE [simplification]
+  rule dictGet(pyDict(DICT[KEY1 <- _], KEYS), KEY2)
+    => dictGet(pyDict(DICT, KEYS), KEY2)
+    requires KEY1 =/=K KEY2 [simplification]
+  rule dictGet(pyDict((KEY |-> VALUE:PyVal) REST, _), KEY) => VALUE
+  rule dictGet(_, _) => pyBool(false) [owise]
+
+  syntax PyVal ::= addValues(PyVal, PyVal) [function, total]
+  rule addValues(pyInt(I), pyInt(J)) => pyInt(I +Int J)
+  rule addValues(_, _) => pyBool(false) [owise]
+
+  syntax PyVal ::= compareValues(String, PyVal, PyVal) [function, total]
+  rule compareValues("in", KEY, pyDict(DICT, _)) => pyBool(KEY in_keys(DICT))
+  rule compareValues(">", pyInt(I), pyInt(J)) => pyBool(I >Int J)
+  rule compareValues("==", LEFT, RIGHT) => pyBool(LEFT ==K RIGHT)
+  rule compareValues(_, _, _) => pyBool(false) [owise]
+
+  syntax Bool ::= truth(PyVal) [function, total]
+  rule truth(pyBool(B)) => B
+  rule truth(pyInt(I)) => I =/=Int 0
+  rule truth(_) => false [owise]
+
+  // Assignment supports local names and dictionary subscripts, the two target
+  // forms used by the implementation.
+  syntax Map ::= assign(Expr, PyVal, Map) [function, total]
+  rule assign(Name(X), VALUE, ENV) => ENV[X <- VALUE]
+  rule assign(Subscript(Name(X), KEY), VALUE, ENV)
+    => ENV[X <- dictSet(envGet(ENV, X), eval(KEY, ENV), VALUE)]
+  rule assign(_, _, ENV) => ENV [owise]
+
+  syntax PyVal ::= dictSet(PyVal, PyVal, PyVal) [function, total]
+  rule dictSet(pyDict(DICT, KEYS), KEY, VALUE)
+    => pyDict(DICT[KEY <- VALUE], KEYS)
+    requires KEY in_keys(DICT)
+  rule dictSet(pyDict(DICT, KEYS), KEY, VALUE)
+    => pyDict(DICT[KEY <- VALUE], KEYS ListItem(KEY))
+    requires notBool (KEY in_keys(DICT))
+  rule dictSet(VALUE, _, _) => VALUE [owise]
+
+  syntax List ::= iterable(PyVal) [function, total]
+  rule iterable(pyList(ITEMS)) => ITEMS
+  rule iterable(pyDict(_, KEYS)) => KEYS
+  rule iterable(_) => .List [owise]
+
+  // Deterministic big-step statement execution. execFor threads both normal
+  // state and an early return, so it is usable beyond this particular body.
+  syntax ExecResult ::= exec(Stmts, Map) [function, total]
+                      | execNext(ExecResult, Stmts) [function, total]
+                      | execStmt(Stmt, Map) [function, total]
+                      | execIf(Bool, Stmts, Stmts, Map) [function, total]
+                      | execFor(Expr, List, Stmts, Map) [function, total]
+                      | execForNext(ExecResult, Expr, List, Stmts) [function, total]
+
+  rule exec(.Stmts, ENV) => normal(ENV)
+  rule exec(STMT REST, ENV) => execNext(execStmt(STMT, ENV), REST)
+
+  rule execNext(normal(ENV), REST) => exec(REST, ENV)
+  rule execNext(returning(ENV, VALUE), _) => returning(ENV, VALUE)
+
+  rule execStmt(Assign(TARGET, VALUE), ENV)
+    => normal(assign(TARGET, eval(VALUE, ENV), ENV))
+  rule execStmt(If(TEST, YES, NO), ENV)
+    => execIf(truth(eval(TEST, ENV)), YES, NO, ENV)
+  rule execStmt(For(TARGET, SOURCE, BODY), ENV)
+    => execFor(TARGET, iterable(eval(SOURCE, ENV)), BODY, ENV)
+  rule execStmt(Return(VALUE), ENV) => returning(ENV, eval(VALUE, ENV))
+  rule execStmt(_, ENV) => normal(ENV) [owise]
+
+  rule execIf(CONDITION, YES, _, ENV) => exec(YES, ENV)
+    requires CONDITION
+  rule execIf(CONDITION, _, NO, ENV) => exec(NO, ENV)
+    requires notBool CONDITION
+
+  rule execFor(_, .List, _, ENV) => normal(ENV)
+  rule execFor(TARGET, ListItem(ITEM) (REST:List), BODY, ENV)
+    => execForNext(exec(BODY, assign(TARGET, ITEM, ENV)), TARGET, REST, BODY)
+
+  rule execForNext(normal(ENV), TARGET, REST, BODY)
+    => execFor(TARGET, REST, BODY, ENV)
+  rule execForNext(returning(ENV, VALUE), _, _, _)
+    => returning(ENV, VALUE)
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..5ea417fafd7ca84f7bc51b13e5c73e2e9d01fadc
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,20 @@
+def histogram(test):
+    letters = test.split()
+    counts = {}
+    maximum = 0
+
+    for letter in letters:
+        if letter in counts:
+            counts[letter] = counts[letter] + 1
+        else:
+            counts[letter] = 1
+
+        if counts[letter] > maximum:
+            maximum = counts[letter]
+
+    result = {}
+    for letter in counts:
+        if counts[letter] == maximum:
+            result[letter] = counts[letter]
+
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..fd0fb2e6bb38ec284a0e343b105275fea69a38c0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,225 @@
+requires "verification.k"
+requires "lemmas.k"
+
+module COUNT-LOOP-SPEC
+  imports VERIFICATION
+
+  claim [count-empty]:
+    <k>
+      execFor(Name("letter"), .List,
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ENV:Map)
+      => normal(ENV)
+    </k>
+
+  claim [count-existing-raises-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal),
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ("counts" |-> pyDict((WORD |-> pyInt(N:Int)) DICTREST:Map, KEYS:List)
+         "maximum" |-> pyInt(M:Int)
+         ENVREST:Map))
+      => normal(countIteration(WORD,
+           ("counts" |-> pyDict((WORD |-> pyInt(N)) DICTREST, KEYS)
+            "maximum" |-> pyInt(M)
+            ENVREST)))
+    </k>
+    requires N +Int 1 >Int M
+
+  claim [count-fresh-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal),
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ("counts" |-> pyDict(DICT:Map, KEYS:List)
+         "maximum" |-> pyInt(M:Int)
+         ENVREST:Map))
+      => normal(countIteration(WORD,
+           ("counts" |-> pyDict(DICT, KEYS)
+            "maximum" |-> pyInt(M)
+            ENVREST)))
+    </k>
+    requires notBool (WORD in_keys(DICT)) andBool 1 >Int M
+
+  claim [count-existing-keeps-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal),
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ("counts" |-> pyDict((WORD |-> pyInt(N:Int)) DICTREST:Map, KEYS:List)
+         "maximum" |-> pyInt(M:Int)
+         ENVREST:Map))
+      => normal(countIteration(WORD,
+           ("counts" |-> pyDict((WORD |-> pyInt(N)) DICTREST, KEYS)
+            "maximum" |-> pyInt(M)
+            ENVREST)))
+    </k>
+    requires N +Int 1 <=Int M
+
+  claim [count-fresh-keeps-step]:
+    <k>
+      execFor(Name("letter"), ListItem(WORD:PyVal),
+        If(Compare(Name("letter"), CmpOp("in", Name("counts"))),
+          Assign(Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+          Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp(">", Name("maximum"))),
+          Assign(Name("maximum"), Subscript(Name("counts"), Name("letter"))),
+          .Stmts),
+        ("counts" |-> pyDict(DICT:Map, KEYS:List)
+         "maximum" |-> pyInt(M:Int)
+         ENVREST:Map))
+      => normal(countIteration(WORD,
+           ("counts" |-> pyDict(DICT, KEYS)
+            "maximum" |-> pyInt(M)
+            ENVREST)))
+    </k>
+    requires notBool (WORD in_keys(DICT)) andBool 1 <=Int M
+endmodule
+
+module MAIN-CORRECTNESS-SPEC
+  imports VERIFIED-LOOP-LEMMAS
+
+  claim [all-token-lists]:
+    <k>
+      executeWords(histogramProgram(), WORDS:List)
+      => histogramSpec(WORDS)
+    </k>
+
+  claim [all-space-separated-strings]:
+    <k>
+      execute(histogramProgram(), INPUT:String)
+      => histogramSpecString(INPUT)
+    </k>
+endmodule
+
+module SELECT-LOOP-SPEC
+  imports VERIFICATION
+
+  claim [select-empty]:
+    <k>
+      execFor(Name("letter"), .List,
+        If(Compare(Subscript(Name("counts"), Name("letter")),
+                   CmpOp("==", Name("maximum"))),
+          Assign(Subscript(Name("result"), Name("letter")),
