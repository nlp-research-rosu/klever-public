    10	  syntax Pgm ::= "Module" "(" Stmts ")"
    11	
    12	  syntax Stmts ::= List{Stmt, ""}
    13	  syntax Names ::= List{String, ","}
    14	  syntax Params ::= "Params" "(" Names ")"
    15	  syntax Exprs ::= List{Expr, ","}
    16	  syntax CmpOps ::= List{CmpOp, ","}
    17	
    18	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
    19	                | "Assign" "(" Expr "," Expr ")"
    20	                | "If" "(" Expr "," Stmts "," Stmts ")"
    21	                | "Return" "(" Expr ")"
    22	
    23	  syntax Expr ::= "Name" "(" String ")"
    24	                | "Int" "(" Int ")"
    25	                | "Float" "(" FloatLiteral ")"
    26	                | "Str" "(" String ")"
    27	                | "NoneVal"
    28	                | "Call" "(" Expr "," Exprs ")"
    29	                | "Attribute" "(" Expr "," String ")"
    30	                | "Compare" "(" Expr "," CmpOps ")"
    31	
    32	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
    33	
    34	  syntax PyVal ::= pyInt(Int)
    35	                 | pyFloat(Int, Int)
    36	                 | pyStr(String)
    37	                 | pyBool(Bool)
    38	                 | pyType(String)
    39	                 | "pyNone"
    40	endmodule
    41	
    42	module MPY-SEMANTIC
    43	  imports MPY-SYNTAX
    44	  imports BOOL
    45	  imports INT
    46	  imports STRING
    47	  imports MAP
    48	  imports K-EQUAL
    49	
    50	  configuration
    51	    <mpy>
    52	      <k> $PGM:Pgm ~> invoke($A:PyVal, $B:PyVal) </k>
    53	      <functions> .Map </functions>
    54	      <env> .Map </env>
    55	      <result> pyNone </result>
    56	    </mpy>
    57	
    58	  syntax Function ::= function(Params, Stmts)
    59	  syntax KItem ::= execute(Stmts)
    60	                 | invoke(PyVal, PyVal)
    61	
    62	  rule <k> Module(SS) => execute(SS) ... </k>
    63	  rule <k> execute(.Stmts) => .K ... </k>
    64	  rule <k> execute(S:Stmt REST:Stmts) => S ~> execute(REST) ... </k>
    65	
    66	  rule <k> FuncDef(NAME, PS, BODY) => .K ... </k>
    67	       <functions> FS => FS [ NAME <- function(PS, BODY) ] </functions>
    68	
    69	  rule <k> invoke(A, B) => execute(BODY) ... </k>
    70	       <functions> ... "compare_one" |-> function(Params(ANAME, BNAME, .Names), BODY) ... </functions>
    71	       <env> _ => (ANAME |-> A) (BNAME |-> B) </env>
    72	
    73	  rule <k> Assign(Name(X), E) => .K ... </k>
    74	       <env> ENV => ENV [ X <- eval(E, ENV) ] </env>
    75	
    76	  rule <k> If(E, THEN, _ELSE) => execute(THEN) ... </k>
    77	       <env> ENV </env>
    78	    requires eval(E, ENV) ==K pyBool(true)
    79	  rule <k> If(E, _THEN, ELSE) => execute(ELSE) ... </k>
    80	       <env> ENV </env>
    81	    requires eval(E, ENV) ==K pyBool(false)
    82	
    83	  rule <k> Return(E) ~> _ => .K </k>
    84	       <env> ENV </env>
    85	       <result> _ => eval(E, ENV) </result>
    86	
    87	  syntax PyVal ::= eval(Expr, Map) [function]
    88	  syntax PyVal ::= typeOf(PyVal) [function, total]
    89	  syntax PyVal ::= pyFloatOf(PyVal) [function]
    90	  syntax PyVal ::= pyReplace(PyVal, PyVal, PyVal) [function]
    91	  syntax PyVal ::= pyCompare(String, PyVal, PyVal) [function]
    92	
    93	  rule eval(Name(X), ENV) => {ENV[X]}:>PyVal requires X in_keys(ENV)
    94	  rule eval(Name("str"), _ENV) => pyType("str")
    95	  rule eval(Int(I), _ENV) => pyInt(I)
    96	  rule eval(Str(S), _ENV) => pyStr(S)
    97	  rule eval(NoneVal, _ENV) => pyNone
    98	
    99	  rule eval(Call(Name("type"), E), ENV) => typeOf(eval(E, ENV))
   100	  rule eval(Call(Name("float"), E), ENV) => pyFloatOf(eval(E, ENV))
   101	  rule eval(Call(Attribute(E, "replace"), OLD, NEW), ENV)
   102	    => pyReplace(eval(E, ENV), eval(OLD, ENV), eval(NEW, ENV))
   103	  rule eval(Compare(L, CmpOp(OP, R)), ENV)
   104	    => pyCompare(OP, eval(L, ENV), eval(R, ENV))
   105	
   106	  rule typeOf(pyInt(_)) => pyType("int")
   107	  rule typeOf(pyFloat(_, _)) => pyType("float")
   108	  rule typeOf(pyStr(_)) => pyType("str")
   109	  rule typeOf(pyBool(_)) => pyType("bool")
   110	  rule typeOf(pyNone) => pyType("NoneType")
   111	  rule typeOf(pyType(_)) => pyType("type")
   112	
   113	  rule pyFloatOf(pyInt(I)) => pyFloat(I, 1)
   114	  rule pyFloatOf(pyFloat(N, D)) => pyFloat(N, D)
   115	  rule pyFloatOf(pyStr(S)) => parseDecimal(S)
   116	
   117	  rule pyReplace(pyStr(S), pyStr(OLD), pyStr(NEW))
   118	    => pyStr(replaceAll(S, OLD, NEW))
   119	
   120	  rule pyCompare("==", pyType(T1), pyType(T2))
   121	    => pyBool(T1 ==String T2)
   122	  rule pyCompare("==", pyFloat(N1, D1), pyFloat(N2, D2))
   123	    => pyBool((N1 *Int D2) ==Int (N2 *Int D1))
   124	  rule pyCompare(">", pyFloat(N1, D1), pyFloat(N2, D2))
   125	    => pyBool((N1 *Int D2) >Int (N2 *Int D1))
   126	
   127	  syntax PyVal ::= parseDecimal(String) [function]
   128	  syntax PyVal ::= parseUnsignedDecimal(String, Int) [function]
   129	  syntax Int ::= decimalDigits(String) [function]
   130	
   131	  rule parseDecimal(S)
   132	    => parseUnsignedDecimal(substrString(S, 1, lengthString(S)), -1)
   133	    requires lengthString(S) >Int 0
   134	     andBool substrString(S, 0, 1) ==String "-"
   135	  rule parseDecimal(S) => parseUnsignedDecimal(S, 1)
   136	    requires lengthString(S) ==Int 0
   137	      orBool substrString(S, 0, 1) =/=String "-"
   138	
   139	  rule parseUnsignedDecimal(S, SIGN)
   140	    => pyFloat(SIGN *Int decimalDigits(S), 1)
   141	    requires findString(S, ".", 0) ==Int -1
   142	  rule parseUnsignedDecimal(S, SIGN)
   143	    => pyFloat(
   144	         SIGN *Int
   145	           (decimalDigits(substrString(S, 0, findString(S, ".", 0)))
   146	              *Int (10 ^Int lengthString(substrString(S, findString(S, ".", 0) +Int 1, lengthString(S))))
   147	            +Int decimalDigits(substrString(S, findString(S, ".", 0) +Int 1, lengthString(S)))),
   148	         10 ^Int lengthString(substrString(S, findString(S, ".", 0) +Int 1, lengthString(S))))
   149	    requires findString(S, ".", 0) >=Int 0
   150	
   151	  rule decimalDigits("") => 0
   152	  rule decimalDigits(S) => String2Int(S) requires S =/=String ""
   153	endmodule
   154	
   155	module MPY
   156	  imports MPY-SEMANTIC
   157	endmodule
FILE /candidate/verification.k
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY-SEMANTIC
     5	
     6	  // This macro is deliberately the same constructor tree as solution.mpy.
     7	  // prove.sh checks that solution.mpy parses and executes independently too.
     8	  syntax Pgm ::= "theSolution" [macro]
     9	  rule theSolution =>
    10	    Module(
    11	      FuncDef("compare_one", Params("a", "b"),
    12	        If(Compare(Call(Name("type"), Name("a")), CmpOp("==", Name("str"))),
    13	          Assign(
    14	            Name("a_value"),
    15	            Call(
    16	              Name("float"),
    17	              Call(Attribute(Name("a"), "replace"), Str(","), Str(".")))),
    18	          Assign(Name("a_value"), Call(Name("float"), Name("a"))))
    19	        If(Compare(Call(Name("type"), Name("b")), CmpOp("==", Name("str"))),
    20	          Assign(
    21	            Name("b_value"),
    22	            Call(
    23	              Name("float"),
    24	              Call(Attribute(Name("b"), "replace"), Str(","), Str(".")))),
    25	          Assign(Name("b_value"), Call(Name("float"), Name("b"))))
    26	        If(Compare(Name("a_value"), CmpOp("==", Name("b_value"))),
    27	          Return(NoneVal),
    28	          .Stmts)
    29	        If(Compare(Name("a_value"), CmpOp(">", Name("b_value"))),
    30	          Return(Name("a")),
    31	          .Stmts)
    32	        Return(Name("b"))))
    33	endmodule
FILE /candidate/spec.k
     1	module SPEC
     2	  imports VERIFICATION
     3	
     4	  // For arbitrary integers, equality returns None.
     5	  claim
     6	    <k> theSolution ~> invoke(pyInt(I), pyInt(J)) => .K </k>
     7	    <functions> .Map => ?_FINALFUNCTIONS </functions>
     8	    <env> .Map => ?_FINALENV </env>
     9	    <result> pyNone => pyNone </result>
    10	    requires I ==Int J
    11	
    12	  // For arbitrary integers, the larger original argument is returned.
    13	  claim
    14	    <k> theSolution ~> invoke(pyInt(I), pyInt(J)) => .K </k>
    15	    <functions> .Map => ?_FINALFUNCTIONS </functions>
    16	    <env> .Map => ?_FINALENV </env>
    17	    <result> pyNone => pyInt(I) </result>
    18	    requires I >Int J
    19	
    20	  claim
    21	    <k> theSolution ~> invoke(pyInt(I), pyInt(J)) => .K </k>
    22	    <functions> .Map => ?_FINALFUNCTIONS </functions>
    23	    <env> .Map => ?_FINALENV </env>
    24	    <result> pyNone => pyInt(J) </result>
    25	    requires I <Int J
    26	
    27	  // Floats are modeled exactly as N / D, with positive denominators.
    28	  claim
    29	    <k> theSolution ~> invoke(pyFloat(N1, D1), pyFloat(N2, D2)) => .K </k>
    30	    <functions> .Map => ?_FINALFUNCTIONS </functions>
    31	    <env> .Map => ?_FINALENV </env>
    32	    <result> pyNone => pyNone </result>
