+        "claimed_python_value": 2,
+    },
+    {
+        "claim": "int-lt",
+        "precondition": "I < J",
+        "bindings": {"I": 1, "J": 2},
+        "python_args": (1, 2),
+        "claimed_python_value": 2,
+    },
+    {
