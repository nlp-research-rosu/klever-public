+    (" ", "1"),
+    ("+0", -0.0),
+    ("-0", "0,0"),
+    (5e-324, "0"),
+    (-5e-324, "-0"),
+    (1.7976931348623157e308, "1e308"),
+    (-1.7976931348623157e308, "-1e308"),
+    (2**53 - 1, float(2**53)),
+    (2**53 + 1, float(2**53)),
+    ("0.10000000000000001", 0.1),
+    (".5", "0,500"),
+    ("1,25e2", 124.999),
+    ("-1.25e-2", "-0,0124"),
+    (10**400, 1),
+]
+
+atoms: list[Any] = []
+atoms.extend(range(-20, 21))
+atoms.extend([-(2**53 + 1), -(2**53), 2**53 - 1, 2**53, 2**53 + 1, 10**100])
+atoms.extend(
+    [
+        -1.7976931348623157e308,
+        -1e100,
+        -100.5,
+        -2.5,
+        -1.0,
+        -0.0,
+        0.0,
+        5e-324,
+        0.1,
+        0.5,
+        1.0,
+        1.5,
+        2.5,
+        100.5,
+        1e100,
+        1.7976931348623157e308,
+    ]
+)
+for integer in range(-12, 13):
+    atoms.extend(
+        [
+            str(integer),
+            f"{integer}.0",
+            f"{integer},0",
+            f"{integer + 0.25:.2f}",
+            f"{integer + 0.25:.2f}".replace(".", ","),
+        ]
+    )
+atoms.extend(
+    [
+        "+0",
+        "-0",
+        ".5",
+        "-.5",
+        "1e2",
+        "-1e-2",
+        "1.25e2",
+        "1,25e2",
+        " 2.5 ",
+        " 2,5 ",
+    ]
+)
