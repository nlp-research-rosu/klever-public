+printf '%s\n' 'COMMAND: timeout --signal=TERM --kill-after=2 8 krun solution.mpy --definition concrete-kompiled -cA=pyStr("1e2") -cB=pyInt(99) --output pretty'
+timeout --signal=TERM --kill-after=2 8 \
+  krun "$work/solution.mpy" \
