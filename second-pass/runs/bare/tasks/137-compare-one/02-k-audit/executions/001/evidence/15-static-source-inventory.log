--- verification.k numbered ---
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY-SEMANTIC
     5	
     6	  // This macro is deliberately the same constructor tree as solution.mpy.
     7	  // prove.sh checks that solution.mpy parses and executes independently too.
     8	  syntax Pgm ::= "theSolution" [macro]
     9	  rule theSolution =>
    10	    Module(
    11	      FuncDef("compare_one", Params("a", "b"),
    12	        If(Compare(Call(Name("type"), Name("a")), CmpOp("==", Name("str"))),
    13	          Assign(
    14	            Name("a_value"),
    15	            Call(
    16	              Name("float"),
    17	              Call(Attribute(Name("a"), "replace"), Str(","), Str(".")))),
    18	          Assign(Name("a_value"), Call(Name("float"), Name("a"))))
    19	        If(Compare(Call(Name("type"), Name("b")), CmpOp("==", Name("str"))),
    20	          Assign(
    21	            Name("b_value"),
    22	            Call(
    23	              Name("float"),
    24	              Call(Attribute(Name("b"), "replace"), Str(","), Str(".")))),
    25	          Assign(Name("b_value"), Call(Name("float"), Name("b"))))
    26	        If(Compare(Name("a_value"), CmpOp("==", Name("b_value"))),
    27	          Return(NoneVal),
    28	          .Stmts)
    29	        If(Compare(Name("a_value"), CmpOp(">", Name("b_value"))),
    30	          Return(Name("a")),
    31	          .Stmts)
    32	        Return(Name("b"))))
    33	endmodule
--- spec.k numbered ---
     1	module SPEC
     2	  imports VERIFICATION
     3	
     4	  // For arbitrary integers, equality returns None.
     5	  claim
     6	    <k> theSolution ~> invoke(pyInt(I), pyInt(J)) => .K </k>
     7	    <functions> .Map => ?_FINALFUNCTIONS </functions>
     8	    <env> .Map => ?_FINALENV </env>
     9	    <result> pyNone => pyNone </result>
    10	    requires I ==Int J
    11	
    12	  // For arbitrary integers, the larger original argument is returned.
    13	  claim
    14	    <k> theSolution ~> invoke(pyInt(I), pyInt(J)) => .K </k>
    15	    <functions> .Map => ?_FINALFUNCTIONS </functions>
    16	    <env> .Map => ?_FINALENV </env>
    17	    <result> pyNone => pyInt(I) </result>
    18	    requires I >Int J
    19	
    20	  claim
    21	    <k> theSolution ~> invoke(pyInt(I), pyInt(J)) => .K </k>
    22	    <functions> .Map => ?_FINALFUNCTIONS </functions>
    23	    <env> .Map => ?_FINALENV </env>
    24	    <result> pyNone => pyInt(J) </result>
    25	    requires I <Int J
    26	
    27	  // Floats are modeled exactly as N / D, with positive denominators.
