    29	    <k> theSolution ~> invoke(pyFloat(N1, D1), pyFloat(N2, D2)) => .K </k>
    30	    <functions> .Map => ?_FINALFUNCTIONS </functions>
    31	    <env> .Map => ?_FINALENV </env>
    32	    <result> pyNone => pyNone </result>
    33	    requires D1 >Int 0 andBool D2 >Int 0
    34	     andBool (N1 *Int D2) ==Int (N2 *Int D1)
    35	
    36	  claim
    37	    <k> theSolution ~> invoke(pyFloat(N1, D1), pyFloat(N2, D2)) => .K </k>
    38	    <functions> .Map => ?_FINALFUNCTIONS </functions>
    39	    <env> .Map => ?_FINALENV </env>
    40	    <result> pyNone => pyFloat(N1, D1) </result>
    41	    requires D1 >Int 0 andBool D2 >Int 0
    42	     andBool (N1 *Int D2) >Int (N2 *Int D1)
    43	
    44	  claim
    45	    <k> theSolution ~> invoke(pyFloat(N1, D1), pyFloat(N2, D2)) => .K </k>
    46	    <functions> .Map => ?_FINALFUNCTIONS </functions>
    47	    <env> .Map => ?_FINALENV </env>
    48	    <result> pyNone => pyFloat(N2, D2) </result>
    49	    requires D1 >Int 0 andBool D2 >Int 0
    50	     andBool (N1 *Int D2) <Int (N2 *Int D1)
