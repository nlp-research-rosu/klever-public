   142	  rule parseUnsignedDecimal(S, SIGN)
   143	    => pyFloat(
   144	         SIGN *Int
   145	           (decimalDigits(substrString(S, 0, findString(S, ".", 0)))
   146	              *Int (10 ^Int lengthString(substrString(S, findString(S, ".", 0) +Int 1, lengthString(S))))
   147	            +Int decimalDigits(substrString(S, findString(S, ".", 0) +Int 1, lengthString(S)))),
   148	         10 ^Int lengthString(substrString(S, findString(S, ".", 0) +Int 1, lengthString(S))))
   149	    requires findString(S, ".", 0) >=Int 0
