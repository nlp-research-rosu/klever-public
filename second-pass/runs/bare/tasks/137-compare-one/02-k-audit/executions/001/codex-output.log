requires "domains.md"

module MPY-SYNTAX
  imports INT-SYNTAX
  imports BOOL-SYNTAX
  imports STRING-SYNTAX

  syntax FloatLiteral ::= r"[\\+\\-]?[0-9]+\\.[0-9]+" [token]

  syntax Pgm ::= "Module" "(" Stmts ")"

  syntax Stmts ::= List{Stmt, ""}
  syntax Names ::= List{String, ","}
  syntax Params ::= "Params" "(" Names ")"
  syntax Exprs ::= List{Expr, ","}
  syntax CmpOps ::= List{CmpOp, ","}

  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
                | "Assign" "(" Expr "," Expr ")"
                | "If" "(" Expr "," Stmts "," Stmts ")"
                | "Return" "(" Expr ")"

  syntax Expr ::= "Name" "(" String ")"
                | "Int" "(" Int ")"
                | "Float" "(" FloatLiteral ")"
                | "Str" "(" String ")"
                | "NoneVal"
                | "Call" "(" Expr "," Exprs ")"
                | "Attribute" "(" Expr "," String ")"
                | "Compare" "(" Expr "," CmpOps ")"

  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"

  syntax PyVal ::= pyInt(Int)
                 | pyFloat(Int, Int)
                 | pyStr(String)
                 | pyBool(Bool)
                 | pyType(String)
                 | "pyNone"
endmodule

module MPY-SEMANTIC
  imports MPY-SYNTAX
  imports BOOL
  imports INT
  imports STRING
  imports MAP
  imports K-EQUAL

  configuration
