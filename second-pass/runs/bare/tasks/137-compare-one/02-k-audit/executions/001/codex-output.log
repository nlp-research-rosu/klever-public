   132	    => parseUnsignedDecimal(substrString(S, 1, lengthString(S)), -1)
   133	    requires lengthString(S) >Int 0
   134	     andBool substrString(S, 0, 1) ==String "-"
   135	  rule parseDecimal(S) => parseUnsignedDecimal(S, 1)
