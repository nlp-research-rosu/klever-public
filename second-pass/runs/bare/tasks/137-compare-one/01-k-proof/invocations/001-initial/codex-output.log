diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..d6ed02181f461da4b67f51752b14842ce0f72e37
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def compare_one(a, b):
+    if type(a) == str:
+        a_value = float(a.replace(",", "."))
+    else:
+        a_value = float(a)
+    if type(b) == str:
+        b_value = float(b.replace(",", "."))
+    else:
+        b_value = float(b)
+    if a_value == b_value:
+        return None
+    if a_value > b_value:
+        return a
+    return b
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..37bd7b3e6f3653bfb5790c762cf696c278a3192a
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,56 @@
+module SPEC
+  imports VERIFICATION
+
+  // For arbitrary integers, equality returns None.
+  claim
+    <k> theSolution ~> invoke(pyInt(I), pyInt(J)) => .K </k>
+    <result> pyNone => pyNone </result>
+    requires I ==Int J
+
+  // For arbitrary integers, the larger original argument is returned.
+  claim
+    <k> theSolution ~> invoke(pyInt(I), pyInt(J)) => .K </k>
+    <result> pyNone => pyInt(I) </result>
+    requires I >Int J
+
+  claim
+    <k> theSolution ~> invoke(pyInt(I), pyInt(J)) => .K </k>
+    <result> pyNone => pyInt(J) </result>
+    requires I <Int J
+
+  // Floats are modeled exactly as N / D, with positive denominators.
+  claim
+    <k> theSolution ~> invoke(pyFloat(N1, D1), pyFloat(N2, D2)) => .K </k>
+    <result> pyNone => pyNone </result>
+    requires D1 >Int 0 andBool D2 >Int 0
+     andBool (N1 *Int D2) ==Int (N2 *Int D1)
+
+  claim
+    <k> theSolution ~> invoke(pyFloat(N1, D1), pyFloat(N2, D2)) => .K </k>
+    <result> pyNone => pyFloat(N1, D1) </result>
+    requires D1 >Int 0 andBool D2 >Int 0
+     andBool (N1 *Int D2) >Int (N2 *Int D1)
+
+  claim
+    <k> theSolution ~> invoke(pyFloat(N1, D1), pyFloat(N2, D2)) => .K </k>
+    <result> pyNone => pyFloat(N2, D2) </result>
+    requires D1 >Int 0 andBool D2 >Int 0
+     andBool (N1 *Int D2) <Int (N2 *Int D1)
+
+  // Original prompt examples, including comma-decimal normalization.
+  claim
+    <k> theSolution ~> invoke(pyInt(1), pyFloat(25, 10)) => .K </k>
+    <result> pyNone => pyFloat(25, 10) </result>
+
+  claim
+    <k> theSolution ~> invoke(pyInt(1), pyStr("2,3")) => .K </k>
+    <result> pyNone => pyStr("2,3") </result>
+
+  claim
+    <k> theSolution ~> invoke(pyStr("5,1"), pyStr("6")) => .K </k>
+    <result> pyNone => pyStr("6") </result>
+
+  claim
+    <k> theSolution ~> invoke(pyStr("1"), pyInt(1)) => .K </k>
+    <result> pyNone => pyNone </result>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ef32a24e0a3be9e219fe39cd1e4bc934306dd85f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,34 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY-SEMANTIC
+
+  // This macro is deliberately the same constructor tree as solution.mpy.
+  // prove.sh checks that solution.mpy parses and executes independently too.
+  syntax Pgm ::= "theSolution"
+  rule theSolution =>
+    Module(
+      FuncDef("compare_one", Params("a", "b"),
+        If(Compare(Call(Name("type"), Name("a")), CmpOp("==", Name("str"))),
+          Assign(
+            Name("a_value"),
+            Call(
+              Name("float"),
+              Call(Attribute(Name("a"), "replace"), Str(","), Str(".")))),
+          Assign(Name("a_value"), Call(Name("float"), Name("a"))))
+        If(Compare(Call(Name("type"), Name("b")), CmpOp("==", Name("str"))),
+          Assign(
+            Name("b_value"),
+            Call(
+              Name("float"),
+              Call(Attribute(Name("b"), "replace"), Str(","), Str(".")))),
+          Assign(Name("b_value"), Call(Name("float"), Name("b"))))
+        If(Compare(Name("a_value"), CmpOp("==", Name("b_value"))),
+          Return(NoneVal),
+          .Stmts)
+        If(Compare(Name("a_value"), CmpOp(">", Name("b_value"))),
+          Return(Name("a")),
+          .Stmts)
+        Return(Name("b"))))
+    [macro]
+endmodule

exec
/bin/bash -lc 'kprove spec.k -d verification-kompiled -sm SPEC --output pretty' in /work
