+                | "Float" "(" FloatLiteral ")"
+                | "Str" "(" String ")"
+                | "NoneVal"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Attribute" "(" Expr "," String ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  syntax PyVal ::= pyInt(Int)
+                 | pyFloat(Int, Int)
+                 | pyStr(String)
+                 | pyBool(Bool)
+                 | pyType(String)
+                 | "pyNone"
+endmodule
+
