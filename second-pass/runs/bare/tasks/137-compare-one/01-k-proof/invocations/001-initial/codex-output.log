new file mode 100644
index 0000000000000000000000000000000000000000..d6ed02181f461da4b67f51752b14842ce0f72e37
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def compare_one(a, b):
+    if type(a) == str:
+        a_value = float(a.replace(",", "."))
+    else:
+        a_value = float(a)
+    if type(b) == str:
+        b_value = float(b.replace(",", "."))
+    else:
+        b_value = float(b)
+    if a_value == b_value:
+        return None
+    if a_value > b_value:
+        return a
+    return b

exec
/bin/bash -lc 'kompile semantic.k --backend haskell --main-module MPY --syntax-module MPY-SYNTAX' in /work
