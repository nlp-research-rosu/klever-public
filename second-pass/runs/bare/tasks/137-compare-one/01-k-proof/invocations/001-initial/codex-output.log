+  rule pyCompare("==", pyFloat(F1), pyFloat(F2))
+    => pyBool(F1 ==Float F2)
+  rule pyCompare(">", pyFloat(F1), pyFloat(F2))
+    => pyBool(F1 >Float F2)
+endmodule
+
+module MPY
+  imports MPY-SEMANTIC
+endmodule
