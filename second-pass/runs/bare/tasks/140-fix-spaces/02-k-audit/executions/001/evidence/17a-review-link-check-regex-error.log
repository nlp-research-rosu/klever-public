WORKDIR: /audit-output
COMMAND: bash -lc echo\ REVIEW_LINES\;\ wc\ -l\ REVIEW.md\;\ echo\ TERMINAL_MARKERS\;\ tail\ -n\ 2\ REVIEW.md\;\ test\ \"\$\(tail\ -n\ 2\ REVIEW.md\)\"\ =\ \"\$\(printf\ \'VERDICT:\ CONCERNS\\nLEGITIMACY:\ LEGIT\'\)\"\;\ marker_status=\$\?\;\ echo\ MARKER_CHECK_EXIT=\$marker_status\;\ echo\ ALL_MARKERS\;\ rg\ -n\ \'\^\(VERDICT\|LEGITIMACY\):\'\ REVIEW.md\;\ echo\ EVIDENCE_LINK_CHECK\;\ link_status=0\;\ while\ IFS=\ read\ -r\ path\;\ do\ if\ test\ \!\ -e\ \"\$path\"\;\ then\ echo\ MISSING=\$path\;\ link_status=1\;\ fi\;\ done\ \<\ \<\(rg\ -o\ \'/audit-output/evidence/\[\^\)\ \]+\'\ REVIEW.md\ \|\ sort\ -u\)\;\ echo\ EVIDENCE_LINK_CHECK_EXIT=\$link_status\;\ echo\ KEY_STATUS_CHECKS\;\ rg\ -n\ \'#Top\|EXIT_STATUS:\ 0\'\ evidence/08-kprove-positive.log\;\ rg\ -n\ \'WarnStuckClaimState\|EXIT_STATUS:\ 1\'\ evidence/14-ground-vacuity-proof-failure.log\;\ if\ test\ \"\$marker_status\"\ -ne\ 0\ \|\|\ test\ \"\$link_status\"\ -ne\ 0\;\ then\ exit\ 1\;\ fi
