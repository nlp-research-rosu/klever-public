WORKDIR: /audit-output
COMMAND: bash -lc $'set +e; for file in /audit-output/evidence/ground-fix.vfy /audit-output/evidence/ground-drop.vfy; do echo INPUT_FILE=$file; echo INPUT_TERM; sed -n \'1,20p\' "$file"; krun "$file" --definition /tmp/audit-work/src/audit-verification-kompiled; status=$?; echo KRUN_EXIT=$status; if test "$status" -ne 0; then exit "$status"; fi; done; python3 - <<\'PY\'\nimport importlib.util\np="/tmp/audit-work/src/solution.py"\nspec=importlib.util.spec_from_file_location("submitted_ground",p)\nm=importlib.util.module_from_spec(spec); spec.loader.exec_module(m)\nfor name,text in [("fix_spaces","a  "),("_drop_spaces","  a  ")]:\n print(name,repr(text),repr(getattr(m,name)(text)))\nPY'
--- OUTPUT ---
INPUT_FILE=/audit-output/evidence/ground-fix.vfy
INPUT_TERM
Verify(ch("a") sp sp .PString)
[Error] krun: Configuration variable missing: $INPUT. Use -cINPUT=<Value> in 
the command line to set.
KRUN_EXIT=1
--- END OUTPUT ---
EXIT_STATUS: 1
