diff --git a/evidence/spec-vacuity-audit.k b/evidence/spec-vacuity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..ab378ba9869ae91d04eba208952545e8c3e1a98c
--- /dev/null
+++ b/evidence/spec-vacuity-audit.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // Deliberately false: for S = .PString and K = .K, the real call returns
+  // pyStr(.PString), not pyStr(ch("!") .PString).
+  claim
+    <py>
+      <k> call("fix_spaces", pyStr(S:PString)) ~> K:K
+        => pyStr(ch("!") fixRef(S)) ~> K
+      </k>
+      <input> _INPUT:String </input>
+      <env> _ENV:Env </env>
+      <funs> solutionFuns </funs>
+      <result> _RESULT:K </result>
+    </py>
+
+  claim
+    <py>
+      <k> call("_drop_spaces", pyStr(S:PString)) ~> K:K
+        => pyStr(dropRef(S)) ~> K
+      </k>
+      <input> _INPUT:String </input>
+      <env> _ENV:Env </env>
+      <funs> solutionFuns </funs>
+      <result> _RESULT:K </result>
+    </py>
+endmodule
