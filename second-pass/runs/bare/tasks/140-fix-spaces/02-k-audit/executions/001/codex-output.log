+  printf '\n'
+  printf '%s\n' '--- OUTPUT ---'
+  "$@"
+  status=$?
+  printf '%s\n' '--- END OUTPUT ---'
+  printf 'EXIT_STATUS: %d\n' "$status"
+} >"$logfile" 2>&1
+
+exit "$status"

