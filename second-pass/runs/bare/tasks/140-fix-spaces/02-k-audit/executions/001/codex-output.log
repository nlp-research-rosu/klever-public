+requires "/tmp/audit-work/src/verification.k"
+
+module SPEC-GROUND-WITNESSES
+  imports VERIFICATION
+
+  claim
+    <py>
+      <k>
+        call("fix_spaces", pyStr(ch("a") sp sp .PString))
+          => pyStr(ch("a") ch("_") ch("_") .PString)
+      </k>
+      <input> "" </input>
