     6	def fix_spaces(text):
     7	    """
     8	    Given a string text, replace all spaces in it with underscores, 
     9	    and if a string has more than 2 consecutive spaces, 
    10	    then replace all consecutive spaces with - 
    11	    
    12	    fix_spaces("Example") == "Example"
    13	    fix_spaces("Example 1") == "Example_1"
    14	    fix_spaces(" Example 2") == "_Example_2"
    15	    fix_spaces(" Example   3") == "_Example-3"
    16	    """
    17	    new_text = ""
    18	    i = 0
    19	    start, end = 0, 0
    20	    while i < len(text):
    21	        if text[i] == " ":
    22	            end += 1
    23	        else:
    24	            if end - start > 2:
    25	                new_text += "-"+text[i]
    26	            elif end - start > 0:
    27	                new_text += "_"*(end - start)+text[i]
    28	            else:
    29	                new_text += text[i]
    30	            start, end = i+1, i+1
    31	        i+=1
    32	    if end - start > 2:
    33	        new_text += "-"
    34	    elif end - start > 0:
    35	        new_text += "_"
    36	    return new_text
