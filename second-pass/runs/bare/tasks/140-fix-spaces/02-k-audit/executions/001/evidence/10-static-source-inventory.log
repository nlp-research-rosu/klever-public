SOURCE_FILE=verification.k
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY-SEMANTIC
     5	
     6	  syntax Program ::= "Verify" "(" PString ")"
     7	                   | "VerifyDrop" "(" PString ")"
     8	
     9	  rule <k> Verify(S) => call("fix_spaces", pyStr(S)) </k>
    10	       <funs> .Funs => solutionFuns </funs>
    11	  rule <k> VerifyDrop(S) => call("_drop_spaces", pyStr(S)) </k>
    12	       <funs> .Funs => solutionFuns </funs>
    13	
    14	  // This is the exact constructor tree emitted in solution.mpy.  Keeping it
    15	  // here as data lets the claims call the ordinary interpreter on symbolic
    16	  // arguments; there is no special semantic rule for fix_spaces.
    17	  syntax Funs ::= "solutionFuns" [function]
    18	  rule solutionFuns => collect(
    19	    FuncDef("_drop_spaces", Params("text"),
    20	      If(Compare(Name("text"), CmpOp("==", Str(""))),
    21	        Return(Str("")),
    22	        .Stmts)
    23	      If(Compare(Subscript(Name("text"), Int(0)), CmpOp("==", Str(" "))),
    24	        Return(Call(Name("_drop_spaces"),
    25	          Subscript(Name("text"), Slice(Int(1), NoBound, NoBound)))),
    26	        .Stmts)
    27	      Return(Call(Name("fix_spaces"), Name("text"))))
    28	    FuncDef("fix_spaces", Params("text"),
    29	      If(Compare(Name("text"), CmpOp("==", Str(""))),
    30	        Return(Str("")),
    31	        .Stmts)
    32	      If(Compare(Subscript(Name("text"), Int(0)), CmpOp("==", Str(" "))),
    33	        If(Compare(Call(Name("len"), Name("text")), CmpOp(">", Int(2))),
    34	          If(Compare(
    35	              Subscript(Name("text"), Slice(Int(0), Int(3), NoBound)),
    36	              CmpOp("==", Str("   "))),
    37	            Return(BinOp("+", Str("-"),
    38	              Call(Name("_drop_spaces"),
    39	                Subscript(Name("text"), Slice(Int(3), NoBound, NoBound))))),
    40	            .Stmts),
    41	          .Stmts)
    42	        Return(BinOp("+", Str("_"),
    43	          Call(Name("fix_spaces"),
    44	            Subscript(Name("text"), Slice(Int(1), NoBound, NoBound))))),
    45	        .Stmts)
    46	      Return(BinOp("+", Subscript(Name("text"), Int(0)),
    47	        Call(Name("fix_spaces"),
    48	          Subscript(Name("text"), Slice(Int(1), NoBound, NoBound))))))
    49	  )
    50	
    51	  // Independent structural statement of the prompt's contract.  Runs of one
    52	  // or two spaces become underscores; a run beginning with at least three
    53	  // spaces emits one hyphen and dropRef consumes the remainder of that run.
    54	  syntax PString ::= fixRef(PString) [function]
    55	  rule fixRef(.PString) => .PString
    56	  rule fixRef(ch(C) REST) => ch(C) fixRef(REST)
    57	  rule fixRef(sp .PString) => ch("_") .PString
    58	  rule fixRef(sp ch(C) REST) => ch("_") ch(C) fixRef(REST)
    59	  rule fixRef(sp sp .PString) => ch("_") ch("_") .PString
    60	  rule fixRef(sp sp ch(C) REST) => ch("_") ch("_") ch(C) fixRef(REST)
    61	  rule fixRef(sp sp sp REST) => ch("-") dropRef(REST)
    62	
    63	  syntax PString ::= dropRef(PString) [function]
    64	  rule dropRef(.PString) => .PString
    65	  rule dropRef(sp REST) => dropRef(REST)
    66	  rule dropRef(ch(C) REST) => ch(C) fixRef(REST)
    67	endmodule
SOURCE_FILE=spec.k
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // The pair of mutually circular claims is structural induction over the
     7	  // finite PString argument.  Together they cover every string and establish
     8	  // that execution of both recursive Python functions equals the independent
     9	  // reference relation above.
    10	  claim
    11	    <py>
    12	      <k> call("fix_spaces", pyStr(S:PString)) ~> K:K
    13	        => pyStr(fixRef(S)) ~> K
    14	      </k>
    15	      <input> _INPUT:String </input>
    16	      <env> _ENV:Env </env>
    17	      <funs> solutionFuns </funs>
    18	      <result> _RESULT:K </result>
    19	    </py>
    20	
    21	  claim
    22	    <py>
    23	      <k> call("_drop_spaces", pyStr(S:PString)) ~> K:K
    24	        => pyStr(dropRef(S)) ~> K
    25	      </k>
    26	      <input> _INPUT:String </input>
    27	      <env> _ENV:Env </env>
    28	      <funs> solutionFuns </funs>
    29	      <result> _RESULT:K </result>
    30	    </py>
    31	endmodule
