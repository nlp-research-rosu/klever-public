META L1: requires "semantic.k"
META L3: module VERIFICATION
META L4: imports MPY-SEMANTIC
S01 L6-L7:
  006   syntax Program ::= "Verify" "(" PString ")"
  007                    | "VerifyDrop" "(" PString ")"
R01 L9-L10:
  009   rule <k> Verify(S) => call("fix_spaces", pyStr(S)) </k>
  010        <funs> .Funs => solutionFuns </funs>
R02 L11-L16:
  011   rule <k> VerifyDrop(S) => call("_drop_spaces", pyStr(S)) </k>
  012        <funs> .Funs => solutionFuns </funs>
  013 
  014   // This is the exact constructor tree emitted in solution.mpy.  Keeping it
  015   // here as data lets the claims call the ordinary interpreter on symbolic
  016   // arguments; there is no special semantic rule for fix_spaces.
S02 L17-L17:
  017   syntax Funs ::= "solutionFuns" [function]
R03 L18-L53:
  018   rule solutionFuns => collect(
  019     FuncDef("_drop_spaces", Params("text"),
  020       If(Compare(Name("text"), CmpOp("==", Str(""))),
  021         Return(Str("")),
  022         .Stmts)
  023       If(Compare(Subscript(Name("text"), Int(0)), CmpOp("==", Str(" "))),
  024         Return(Call(Name("_drop_spaces"),
  025           Subscript(Name("text"), Slice(Int(1), NoBound, NoBound)))),
  026         .Stmts)
  027       Return(Call(Name("fix_spaces"), Name("text"))))
  028     FuncDef("fix_spaces", Params("text"),
  029       If(Compare(Name("text"), CmpOp("==", Str(""))),
  030         Return(Str("")),
  031         .Stmts)
  032       If(Compare(Subscript(Name("text"), Int(0)), CmpOp("==", Str(" "))),
  033         If(Compare(Call(Name("len"), Name("text")), CmpOp(">", Int(2))),
  034           If(Compare(
  035               Subscript(Name("text"), Slice(Int(0), Int(3), NoBound)),
  036               CmpOp("==", Str("   "))),
  037             Return(BinOp("+", Str("-"),
  038               Call(Name("_drop_spaces"),
  039                 Subscript(Name("text"), Slice(Int(3), NoBound, NoBound))))),
  040             .Stmts),
  041           .Stmts)
  042         Return(BinOp("+", Str("_"),
  043           Call(Name("fix_spaces"),
  044             Subscript(Name("text"), Slice(Int(1), NoBound, NoBound))))),
  045         .Stmts)
  046       Return(BinOp("+", Subscript(Name("text"), Int(0)),
  047         Call(Name("fix_spaces"),
  048           Subscript(Name("text"), Slice(Int(1), NoBound, NoBound))))))
  049   )
  050 
  051   // Independent structural statement of the prompt's contract.  Runs of one
  052   // or two spaces become underscores; a run beginning with at least three
  053   // spaces emits one hyphen and dropRef consumes the remainder of that run.
S03 L54-L54:
  054   syntax PString ::= fixRef(PString) [function]
R04 L55-L55:
  055   rule fixRef(.PString) => .PString
R05 L56-L56:
  056   rule fixRef(ch(C) REST) => ch(C) fixRef(REST)
R06 L57-L57:
  057   rule fixRef(sp .PString) => ch("_") .PString
R07 L58-L58:
  058   rule fixRef(sp ch(C) REST) => ch("_") ch(C) fixRef(REST)
R08 L59-L59:
  059   rule fixRef(sp sp .PString) => ch("_") ch("_") .PString
R09 L60-L60:
  060   rule fixRef(sp sp ch(C) REST) => ch("_") ch("_") ch(C) fixRef(REST)
R10 L61-L61:
  061   rule fixRef(sp sp sp REST) => ch("-") dropRef(REST)
S04 L63-L63:
