+
+python3 /tmp/audit-work/reference/py2mpy.py \
+  /tmp/audit-work/candidate/solution.py \
+  > /tmp/audit-work/build/regenerated-solution.mpy
+translator_status=$?
+
+cmp -s \
+  /tmp/audit-work/build/regenerated-solution.mpy \
+  /tmp/audit-work/candidate/solution.mpy
+byte_identity_status=$?
+
+sha256sum \
+  /tmp/audit-work/build/regenerated-solution.mpy \
