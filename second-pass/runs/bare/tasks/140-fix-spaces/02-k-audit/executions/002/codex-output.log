+#!/usr/bin/env bash
+set -uo pipefail
+set -x
+
+kprove /tmp/audit-work/vacuity/spec-vacuity.k \
+  --definition /tmp/audit-work/build/verification-kompiled \
+  --spec-module SPEC-VACUITY \
+  --dry-run
+dry_run_status=$?
+
+kprove /tmp/audit-work/vacuity/spec-vacuity.k \
+  --definition /tmp/audit-work/build/verification-kompiled \
+  --spec-module SPEC-VACUITY \
+  2>&1 | tee /tmp/audit-work/vacuity/nonvacuity-proof-output.log
+proof_status=${PIPESTATUS[0]}
+
+rg -q 'WarnStuckClaimState|implication check.*failed' \
+  /tmp/audit-work/vacuity/nonvacuity-proof-output.log
+expected_residual_status=$?
+
+set +x
+printf '%s\n' \
+  'SATISFYING_WITNESS: S=.PString, K=.K, INPUT="", ENV=.Env, RESULT=.K'
+printf '%s\n' \
+  'FALSE_OBLIGATION_AT_WITNESS: execution returns pyStr(.PString), mutation demands pyStr(ch("X") .PString)'
+printf 'vacuity_dry_run_exit=%s\n' "$dry_run_status"
+printf 'vacuity_proof_exit=%s\n' "$proof_status"
+printf 'expected_stuck_residual_search_exit=%s\n' "$expected_residual_status"
+
+if (( dry_run_status != 0 ||
+      proof_status == 0 ||
+      expected_residual_status != 0 )); then
+  exit 1
+fi

exec
/bin/bash -lc "cp -a /tmp/audit-work/candidate/verification.k /tmp/audit-work/candidate/semantic.k /tmp/audit-work/vacuity/ && mv /audit-output/evidence/06_nonvacuity.log /audit-output/evidence/06_nonvacuity_attempt1.log && bash -c 'printf \"%s\\n\" \"COMMAND: bash /audit-output/evidence/06_nonvacuity.sh\" > /audit-output/evidence/06_nonvacuity.log; bash /audit-output/evidence/06_nonvacuity.sh >> /audit-output/evidence/06_nonvacuity.log 2>&1; rc="'$?; printf "EXIT_STATUS: %s'"\\n\" \""'$rc" >> /audit-output/evidence/06_nonvacuity.log; exit "$rc"'"'" in /audit-output
