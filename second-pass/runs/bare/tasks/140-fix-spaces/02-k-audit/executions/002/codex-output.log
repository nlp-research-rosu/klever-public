     9	def fix_spaces(text):
    10	    if text == "":
    11	        return ""
    12	    if text[0] == " ":
    13	        if len(text) > 2:
    14	            if text[0:3] == "   ":
    15	                return "-" + _drop_spaces(text[3:])
    16	        return "_" + fix_spaces(text[1:])
    17	    return text[0] + fix_spaces(text[1:])

