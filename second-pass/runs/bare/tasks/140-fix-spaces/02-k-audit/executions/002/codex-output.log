index 0000000000000000000000000000000000000000..bc1a08228e4974ed7e3833aae8c26f5afe9464a0
--- /dev/null
+++ b//tmp/audit-work/vacuity/spec-vacuity-ground.k
@@ -0,0 +1,18 @@
+requires "verification.k"
+
+module SPEC-VACUITY-GROUND
+  imports VERIFICATION
+
+  // False result mutation of the target claim at the satisfiable empty input.
+  // The real call returns pyStr(.PString), while this demands "X".
+  claim
+    <py>
+      <k> call("fix_spaces", pyStr(.PString))
+        => pyStr(ch("X") .PString)
+      </k>
+      <input> "" </input>
+      <env> .Env </env>
+      <funs> solutionFuns </funs>
+      <result> .K </result>
+    </py>
+endmodule
