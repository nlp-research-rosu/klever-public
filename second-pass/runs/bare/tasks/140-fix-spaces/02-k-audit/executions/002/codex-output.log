diff --git a//tmp/audit-work/body-mutation/spec.k b//tmp/audit-work/body-mutation/spec.k
index dee9aaad6e70b260ab8ecc158131ddcf12de95f5..3f647b9133c5bf4322ddc18f29feb5adcf71bf71
--- a//tmp/audit-work/body-mutation/spec.k
+++ b//tmp/audit-work/body-mutation/spec.k
@@ -1,7 +1,7 @@
-requires "verification.k"
+requires "verification-body-mutation.k"
 
-module SPEC
-  imports VERIFICATION
+module SPEC-BODY-MUTATION
+  imports VERIFICATION-BODY-MUTATION
 
