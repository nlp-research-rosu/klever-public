+                 | enter(Closure, Val)
+                 | finishCall(Env)
+                 | exec(Stmts)
+                 | choose(Stmts, Stmts, Stmts)
+                 | eval(Expr)
+                 | callArg(String)
+                 | "lenResult"
+                 | binRight(String, Expr)
+                 | binApply(String, Val)
+                 | cmpRight(String, Expr)
+                 | cmpApply(String, Val)
+                 | subApply(Index)
+                 | decideEq(PString, PString)
+                 | decideLonger(PString, Int)
