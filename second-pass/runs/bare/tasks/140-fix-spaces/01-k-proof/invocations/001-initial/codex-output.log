+requires "domains.k"
+
+module MPY-SYNTAX
+  imports BOOL-SYNTAX
+  imports INT-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Program ::= "Module" "(" Stmts ")"
+
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")"
+                | "Return" "(" Expr ")"
+                | "If" "(" Expr "," Stmts "," Stmts ")"
+
+  syntax Ids ::= List{String, ","}
+  syntax Params ::= "Params" "(" Ids ")"
+
+  syntax Exprs ::= List{Expr, ","}
+  syntax Expr ::= "Name" "(" String ")"
+                | "Str" "(" String ")"
+                | "Int" "(" Int ")"
+                | "BinOp" "(" String "," Expr "," Expr ")"
+                | "Compare" "(" Expr "," CmpOps ")"
+                | "Call" "(" Expr "," Exprs ")"
+                | "Subscript" "(" Expr "," Index ")"
+
+  syntax CmpOps ::= List{CmpOp, ","}
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")"
+
+  syntax Index ::= Expr | Slice
+  syntax Bound ::= Expr | "NoBound"
+  syntax Slice ::= "Slice" "(" Bound "," Bound "," Bound ")"
+endmodule
+
+module MPY-SEMANTIC
+  imports MPY-SYNTAX
+  imports BOOL
+  imports INT
+  imports STRING
+
+  // A Python string is represented as a sequence of semantic characters.
+  // Space has its own constructor; ch(S) represents a non-space character.
+  syntax PString ::= ".PString"
+                   | "sp" PString
+                   | "ch" "(" String ")" PString
+
+  syntax Val ::= pyStr(PString) | pyInt(Int) | pyBool(Bool)
+  syntax Env ::= ".Env" | bind(String, Val, Env)
+  syntax Funs ::= ".Funs" | fun(String, Params, Stmts, Funs)
+  syntax Closure ::= closure(Params, Stmts)
+  syntax ExecResult ::= normal(Env) | returned(Val)
+
+  configuration
+    <py>
+      <k> $PGM:Program </k>
+      <input> $INPUT:String </input>
+      <result> .K </result>
+    </py>
+
+  // Loading a translated module collects its definitions and invokes the
+  // required HumanEval entry point on the command-line INPUT string.
+  rule <k> Module(SS) => .K </k>
+       <input> INPUT </input>
+       <result> .K => invoke("fix_spaces", pyStr(decode(INPUT)), collect(SS)) </result>
+
+  // Decode/encode connect concrete K String tokens to the structural string
+  // model used by the semantics and by symbolic proofs.
+  syntax PString ::= decode(String) [function]
+  rule decode("") => .PString
+  rule decode(S) => pconcat(decodeChar(substrString(S, 0, 1)), decode(substrString(S, 1, lengthString(S))))
+    requires lengthString(S) >Int 0
+
+  syntax PString ::= decodeChar(String) [function]
+  rule decodeChar(" ") => sp .PString
+  rule decodeChar(C) => ch(C) .PString [owise]
+
+  syntax String ::= encode(PString) [function]
+  rule encode(.PString) => ""
+  rule encode(sp REST) => " " +String encode(REST)
+  rule encode(ch(C) REST) => C +String encode(REST)
+
+  // Definition collection and lexical lookup.
+  syntax Funs ::= collect(Stmts) [function]
+  rule collect(.Stmts) => .Funs
+  rule collect(FuncDef(F, P, BODY) REST) => fun(F, P, BODY, collect(REST))
+
+  syntax Closure ::= lookupFun(String, Funs) [function]
+  rule lookupFun(F, fun(F, P, BODY, REST)) => closure(P, BODY)
+  rule lookupFun(F, fun(G, P, BODY, REST)) => lookupFun(F, REST)
+    requires F =/=String G
+
+  syntax Val ::= lookup(String, Env) [function]
+  rule lookup(X, bind(X, V, REST)) => V
+  rule lookup(X, bind(Y, V, REST)) => lookup(X, REST)
+    requires X =/=String Y
+
+  // Function invocation.  The translated task uses one positional parameter
+  // throughout; unsupported arities are deliberately absent rather than
+  // silently assigned a meaning.
+  syntax Val ::= invoke(String, Val, Funs) [function]
+  rule invoke(F, V, FUNS) => apply(lookupFun(F, FUNS), V, FUNS)
+
+  syntax Val ::= apply(Closure, Val, Funs) [function]
+  rule apply(closure(Params(X), BODY), V, FUNS)
+    => returnedValue(exec(BODY, bind(X, V, .Env), FUNS))
+
+  syntax Val ::= returnedValue(ExecResult) [function]
+  rule returnedValue(returned(V)) => V
+
+  // Statement execution propagates Return through nested conditionals.
+  syntax ExecResult ::= exec(Stmts, Env, Funs) [function]
+  rule exec(.Stmts, ENV, FUNS) => normal(ENV)
+  rule exec(Return(E) REST, ENV, FUNS) => returned(eval(E, ENV, FUNS))
+  rule exec(If(COND, THEN, ELSE) REST, ENV, FUNS)
+    => resume(exec(branch(eval(COND, ENV, FUNS), THEN, ELSE), ENV, FUNS), REST, FUNS)
+
+  syntax Stmts ::= branch(Val, Stmts, Stmts) [function]
+  rule branch(pyBool(true), THEN, ELSE) => THEN
+  rule branch(pyBool(false), THEN, ELSE) => ELSE
+
+  syntax ExecResult ::= resume(ExecResult, Stmts, Funs) [function]
+  rule resume(returned(V), REST, FUNS) => returned(V)
+  rule resume(normal(ENV), REST, FUNS) => exec(REST, ENV, FUNS)
+
+  // Expressions needed by solution.mpy.
+  syntax Val ::= eval(Expr, Env, Funs) [function]
+  rule eval(Name(X), ENV, FUNS) => lookup(X, ENV)
+  rule eval(Str(S), ENV, FUNS) => pyStr(decode(S))
+  rule eval(Int(I), ENV, FUNS) => pyInt(I)
+  rule eval(BinOp("+", L, R), ENV, FUNS)
+    => add(eval(L, ENV, FUNS), eval(R, ENV, FUNS))
+  rule eval(Compare(L, CmpOp(OP, R)), ENV, FUNS)
+    => compare(OP, eval(L, ENV, FUNS), eval(R, ENV, FUNS))
+  rule eval(Call(Name("len"), ARG), ENV, FUNS)
+    => pyInt(plength(asString(eval(ARG, ENV, FUNS))))
+  rule eval(Call(Name(F), ARG), ENV, FUNS)
+    => invoke(F, eval(ARG, ENV, FUNS), FUNS)
+    requires F =/=String "len"
+  rule eval(Subscript(BASE, Int(I)), ENV, FUNS)
+    => pyStr(pindex(asString(eval(BASE, ENV, FUNS)), I))
+  rule eval(Subscript(BASE, Slice(Int(L), NoBound, NoBound)), ENV, FUNS)
+    => pyStr(pdrop(asString(eval(BASE, ENV, FUNS)), L))
+  rule eval(Subscript(BASE, Slice(Int(L), Int(U), NoBound)), ENV, FUNS)
+    => pyStr(ptake(pdrop(asString(eval(BASE, ENV, FUNS)), L), U -Int L))
+
+  syntax PString ::= asString(Val) [function]
+  rule asString(pyStr(S)) => S
+
+  syntax Val ::= add(Val, Val) [function]
+  rule add(pyStr(A), pyStr(B)) => pyStr(pconcat(A, B))
+
+  syntax Val ::= compare(String, Val, Val) [function]
+  rule compare("==", pyStr(A), pyStr(B)) => pyBool(peq(A, B))
+  rule compare(">", pyInt(A), pyInt(B)) => pyBool(A >Int B)
+
+  syntax Bool ::= peq(PString, PString) [function]
+  rule peq(.PString, .PString) => true
+  rule peq(.PString, sp B) => false
+  rule peq(.PString, ch(C) B) => false
+  rule peq(sp A, .PString) => false
+  rule peq(ch(C) A, .PString) => false
+  rule peq(sp A, sp B) => peq(A, B)
+  rule peq(sp A, ch(C) B) => false
+  rule peq(ch(C) A, sp B) => false
+  rule peq(ch(C) A, ch(D) B) => C ==String D andBool peq(A, B)
+
+  syntax Int ::= plength(PString) [function]
+  rule plength(.PString) => 0
+  rule plength(sp REST) => 1 +Int plength(REST)
+  rule plength(ch(C) REST) => 1 +Int plength(REST)
+
+  syntax PString ::= pconcat(PString, PString) [function]
+  rule pconcat(.PString, B) => B
+  rule pconcat(sp A, B) => sp pconcat(A, B)
+  rule pconcat(ch(C) A, B) => ch(C) pconcat(A, B)
+
+  syntax PString ::= pdrop(PString, Int) [function]
+  rule pdrop(S, 0) => S
+  rule pdrop(sp REST, N) => pdrop(REST, N -Int 1) requires N >Int 0
+  rule pdrop(ch(C) REST, N) => pdrop(REST, N -Int 1) requires N >Int 0
+
+  syntax PString ::= ptake(PString, Int) [function]
+  rule ptake(S, 0) => .PString
+  rule ptake(.PString, N) => .PString requires N >Int 0
+  rule ptake(sp REST, N) => sp ptake(REST, N -Int 1) requires N >Int 0
+  rule ptake(ch(C) REST, N) => ch(C) ptake(REST, N -Int 1) requires N >Int 0
+
+  syntax PString ::= pindex(PString, Int) [function]
+  rule pindex(sp REST, 0) => sp .PString
+  rule pindex(ch(C) REST, 0) => ch(C) .PString
+  rule pindex(sp REST, N) => pindex(REST, N -Int 1) requires N >Int 0
+  rule pindex(ch(C) REST, N) => pindex(REST, N -Int 1) requires N >Int 0
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..599407680dc55c9dfd6ff92eaf10e4164051fcbf
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,17 @@
+def _drop_spaces(text):
+    if text == "":
+        return ""
+    if text[0] == " ":
+        return _drop_spaces(text[1:])
+    return fix_spaces(text)
+
+
+def fix_spaces(text):
+    if text == "":
+        return ""
+    if text[0] == " ":
+        if len(text) > 2:
+            if text[0:3] == "   ":
+                return "-" + _drop_spaces(text[3:])
+        return "_" + fix_spaces(text[1:])
+    return text[0] + fix_spaces(text[1:])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..334cbf112e6ae7f85254e9e65ed64f57f1cba290
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,15 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The pair of mutually circular claims is structural induction over the
+  // finite PString argument.  Together they cover every string and establish
+  // that execution of both recursive Python functions equals the independent
+  // reference relation above.
+  claim invoke("fix_spaces", pyStr(S:PString), solutionFuns)
+     => pyStr(fixRef(S))
+
+  claim invoke("_drop_spaces", pyStr(S:PString), solutionFuns)
+     => pyStr(dropRef(S))
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f4fdf39f6109212773f85cb5cb745d3127f73df6
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,59 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY-SEMANTIC
+
+  // This is the exact constructor tree emitted in solution.mpy.  Keeping it
+  // here as data lets the claims call the ordinary interpreter on symbolic
+  // arguments; there is no special semantic rule for fix_spaces.
+  syntax Funs ::= "solutionFuns" [function]
+  rule solutionFuns => collect(
+    FuncDef("_drop_spaces", Params("text"),
+      If(Compare(Name("text"), CmpOp("==", Str(""))),
+        Return(Str("")),
+        .Stmts)
+      If(Compare(Subscript(Name("text"), Int(0)), CmpOp("==", Str(" "))),
+        Return(Call(Name("_drop_spaces"),
+          Subscript(Name("text"), Slice(Int(1), NoBound, NoBound)))),
+        .Stmts)
+      Return(Call(Name("fix_spaces"), Name("text"))))
+    FuncDef("fix_spaces", Params("text"),
+      If(Compare(Name("text"), CmpOp("==", Str(""))),
+        Return(Str("")),
+        .Stmts)
+      If(Compare(Subscript(Name("text"), Int(0)), CmpOp("==", Str(" "))),
+        If(Compare(Call(Name("len"), Name("text")), CmpOp(">", Int(2))),
+          If(Compare(
+              Subscript(Name("text"), Slice(Int(0), Int(3), NoBound)),
+              CmpOp("==", Str("   "))),
+            Return(BinOp("+", Str("-"),
+              Call(Name("_drop_spaces"),
+                Subscript(Name("text"), Slice(Int(3), NoBound, NoBound))))),
+            .Stmts),
+          .Stmts)
+        Return(BinOp("+", Str("_"),
+          Call(Name("fix_spaces"),
+            Subscript(Name("text"), Slice(Int(1), NoBound, NoBound))))),
+        .Stmts)
+      Return(BinOp("+", Subscript(Name("text"), Int(0)),
+        Call(Name("fix_spaces"),
+          Subscript(Name("text"), Slice(Int(1), NoBound, NoBound))))))
+  )
+
+  // Independent structural statement of the prompt's contract.  Runs of one
+  // or two spaces become underscores; a run beginning with at least three
+  // spaces emits one hyphen and dropRef consumes the remainder of that run.
+  syntax PString ::= fixRef(PString) [function]
+  rule fixRef(.PString) => .PString
+  rule fixRef(ch(C) REST) => ch(C) fixRef(REST)
+  rule fixRef(sp .PString) => ch("_") .PString
+  rule fixRef(sp ch(C) REST) => ch("_") ch(C) fixRef(REST)
+  rule fixRef(sp sp .PString) => ch("_") ch("_") .PString
+  rule fixRef(sp sp ch(C) REST) => ch("_") ch("_") ch(C) fixRef(REST)
+  rule fixRef(sp sp sp REST) => ch("-") dropRef(REST)
+
+  syntax PString ::= dropRef(PString) [function]
+  rule dropRef(.PString) => .PString
+  rule dropRef(sp REST) => dropRef(REST)
+  rule dropRef(ch(C) REST) => ch(C) fixRef(REST)
+endmodule

apply patch
