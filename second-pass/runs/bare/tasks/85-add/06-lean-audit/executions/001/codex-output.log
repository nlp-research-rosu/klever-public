+  /audit-output/evidence/lean-proc-exe-shim.c \
+  /tmp/audit-work/lean-proc-exe-shim.so
+export PATH="/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin:$PATH"
+export LD_PRELOAD=/tmp/audit-work/lean-proc-exe-shim.so
+lean --version
+lake --version
