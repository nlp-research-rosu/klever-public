    10	    <k> (pyList(VALUES) ~> userCall("add") => pyInt(oddIndexEvenSum(VALUES))) ... </k>
    11	    <input> INPUT </input>
    12	    <functions> "add" |-> function("lst",
    13	      IfExp(
    14	        Compare(Call(Name("len"), Name("lst")), CmpOp("<", Int(2))),
    15	        Int(0),
    16	        BinOp(
    17	          "+",
    18	          IfExp(
    19	            Compare(
    20	              BinOp("%", Subscript(Name("lst"), Int(1)), Int(2)),
    21	              CmpOp("==", Int(0))),
    22	            Subscript(Name("lst"), Int(1)),
    23	            Int(0)),
    24	          Call(
    25	            Name("add"),
    26	            Subscript(Name("lst"), Slice(Int(2), NoBound, NoBound)))))) </functions>
    27	    <env> CALLERENV </env>
    28	    <callStack> CALLERSTACK </callStack>
    29	
    30	  // End-to-end theorem for the exact translated constructor tree.
    31	  claim
    32	    <k> solutionProgram ~> start => pyInt(oddIndexEvenSum(VALUES)) </k>
    33	    <input> pyList(VALUES) </input>
    34	    <functions> .Map => "add" |-> function("lst",
    35	      IfExp(
    36	        Compare(Call(Name("len"), Name("lst")), CmpOp("<", Int(2))),
    37	        Int(0),
    38	        BinOp(
    39	          "+",
    40	          IfExp(
    41	            Compare(
    42	              BinOp("%", Subscript(Name("lst"), Int(1)), Int(2)),
    43	              CmpOp("==", Int(0))),
    44	            Subscript(Name("lst"), Int(1)),
    45	            Int(0)),
    46	          Call(
    47	            Name("add"),
    48	            Subscript(Name("lst"), Slice(Int(2), NoBound, NoBound)))))) </functions>
    49	    <env> .Map </env>
    50	    <callStack> .List </callStack>
    51	endmodule
     1	def add(lst):
     2	    return 0 if len(lst) < 2 else (lst[1] if lst[1] % 2 == 0 else 0) + add(lst[2:])
     1	Module(
     2	  FuncDef("add", Params("lst"),
     3	    Return(
     4	      IfExp(
     5	        Compare(Call(Name("len"), Name("lst")), CmpOp("<", Int(2))),
     6	        Int(0),
     7	        BinOp(
     8	          "+",
     9	          IfExp(
    10	            Compare(
    11	              BinOp("%", Subscript(Name("lst"), Int(1)), Int(2)),
    12	              CmpOp("==", Int(0))),
    13	            Subscript(Name("lst"), Int(1)),
    14	            Int(0)),
    15	          Call(
    16	            Name("add"),
    17	            Subscript(Name("lst"), Slice(Int(2), NoBound, NoBound))))))))
     1	module MPY-SYNTAX
     2	  imports INT-SYNTAX
     3	  imports BOOL-SYNTAX
     4	  imports STRING-SYNTAX
     5	
     6	  syntax Module ::= "Module" "(" Stmts ")" [symbol]
     7	  syntax Stmts ::= List{Stmt, ""}
     8	  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol]
     9	                | "Return" "(" Expr ")"                         [symbol]
    10	  syntax Params ::= "Params" "(" String ")" [symbol]
    11	
    12	  syntax Expr ::= "Int" "(" Int ")"                                  [symbol]
    13	                | "Name" "(" String ")"                              [symbol]
    14	                | "BinOp" "(" String "," Expr "," Expr ")"        [symbol]
    15	                | "Compare" "(" Expr "," CmpOp ")"                 [symbol]
    16	                | "Subscript" "(" Expr "," Index ")"               [symbol]
    17	                | "Call" "(" Expr "," Expr ")"                     [symbol]
    18	                | "IfExp" "(" Expr "," Expr "," Expr ")"         [symbol]
    19	  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol]
    20	  syntax Index ::= Expr
    21	                 | "Slice" "(" Bound "," Bound "," Bound ")" [symbol]
    22	  syntax Bound ::= Expr | "NoBound" [symbol]
    23	
    24	  // Runtime values use a deliberately small inductive integer sequence.  It
    25	  // is enough for this task, concrete execution, and structural proof.
    26	  syntax ISeq ::= "nil" [symbol]
    27	                | "cons" "(" Int "," ISeq ")" [symbol]
    28	  syntax PyVal ::= "pyInt" "(" Int ")"   [symbol]
    29	                 | "pyBool" "(" Bool ")" [symbol]
    30	                 | "pyList" "(" ISeq ")" [symbol]
    31	endmodule
    32	
    33	module MPY
    34	  imports MPY-SYNTAX
    35	  imports INT
    36	  imports BOOL
    37	  imports STRING
    38	  imports MAP
    39	  imports LIST
    40	
    41	  syntax FuncInfo ::= "function" "(" String "," Expr ")" [symbol]
    42	
    43	  syntax KItem ::= "start"
    44	                 | "done"
    45	                 | "eval" "(" Expr ")"
    46	                 | "select" "(" Expr "," Expr ")"
    47	                 | "binRight" "(" String "," Expr ")"
    48	                 | "binApply" "(" String "," PyVal ")"
    49	                 | "cmpRight" "(" String "," Expr ")"
    50	                 | "cmpApply" "(" String "," PyVal ")"
    51	                 | "isShortList"
    52	                 | "keepIfEven"
    53	                 | "indexAt" "(" Int ")"
    54	                 | "sliceFrom" "(" Int ")"
    55	                 | "builtInLen"
    56	                 | "userCall" "(" String ")"
    57	                 | "restoreCaller"
    58	
    59	  configuration
    60	    <mpy>
    61	      <k> $PGM:Module ~> start </k>
    62	      <input> $INPUT:PyVal </input>
    63	      <functions> .Map </functions>
    64	      <env> .Map </env>
    65	      <callStack> .List </callStack>
    66	    </mpy>
    67	
    68	  // A module is loaded before its designated entry point is invoked.  The
    69	  // accepted function body is a return expression, which is all solution.py
    70	  // uses; expression evaluation below is otherwise compositional.
    71	  rule <k> Module(FuncDef(F, Params(P), Return(E)) REST) => Module(REST) ... </k>
    72	       <functions> FS => (F |-> function(P, E)) FS </functions>
    73	
    74	  rule <k> Module(.Stmts) ~> start => INPUT ~> userCall("add") ~> done ... </k>
    75	       <input> INPUT </input>
    76	
    77	  rule <k> V:PyVal ~> done => V ... </k>
    78	
    79	  rule <k> eval(Int(I)) => pyInt(I) ... </k>
    80	  rule <k> eval(Name(X)) => V ... </k>
    81	       <env>... X |-> V ...</env>
    82	
    83	  // Two semantics-preserving specializations expose the structural facts the
    84	  // proof needs without changing Python behavior.  The first classifies
    85	  // len(xs) < 2 by list shape.  The second represents the pure inner ternary
    86	  // with the mathematical evenPart function used by the specification.
    87	  rule <k> eval(Compare(Call(Name("len"), ARG), CmpOp("<", Int(2))))
    88	        => eval(ARG) ~> isShortList ... </k>
    89	    [priority(40)]
    90	  rule <k> pyList(nil) ~> isShortList => pyBool(true) ... </k>
    91	  rule <k> pyList(cons(_, nil)) ~> isShortList => pyBool(true) ... </k>
    92	  rule <k> pyList(cons(_, cons(_, _))) ~> isShortList => pyBool(false) ... </k>
    93	
    94	  rule <k> eval(IfExp(
    95	          Compare(BinOp("%", ITEM, Int(2)), CmpOp("==", Int(0))),
    96	          ITEM, Int(0)))
    97	        => eval(ITEM) ~> keepIfEven ... </k>
    98	    [priority(40)]
    99	  rule <k> pyInt(I) ~> keepIfEven => pyInt(evenPart(I)) ... </k>
   100	
   101	  rule <k> eval(IfExp(COND, THEN, ELSE))
   102	        => eval(COND) ~> select(THEN, ELSE) ... </k>
   103	  rule <k> pyBool(true)  ~> select(THEN, _) => eval(THEN) ... </k>
   104	  rule <k> pyBool(false) ~> select(_, ELSE) => eval(ELSE) ... </k>
   105	
   106	  rule <k> eval(BinOp(OP, LEFT, RIGHT))
   107	        => eval(LEFT) ~> binRight(OP, RIGHT) ... </k>
   108	  rule <k> LEFT:PyVal ~> binRight(OP, RIGHT)
   109	        => eval(RIGHT) ~> binApply(OP, LEFT) ... </k>
   110	  rule <k> pyInt(R) ~> binApply("+", pyInt(L)) => pyInt(L +Int R) ... </k>
   111	  rule <k> pyInt(R) ~> binApply("%", pyInt(L)) => pyInt(L %Int R) ... </k>
   112	
   113	  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT)))
   114	        => eval(LEFT) ~> cmpRight(OP, RIGHT) ... </k>
   115	  rule <k> LEFT:PyVal ~> cmpRight(OP, RIGHT)
   116	        => eval(RIGHT) ~> cmpApply(OP, LEFT) ... </k>
   117	  rule <k> pyInt(R) ~> cmpApply("<",  pyInt(L)) => pyBool(L <Int R) ... </k>
   118	  rule <k> pyInt(R) ~> cmpApply("==", pyInt(L)) => pyBool(L ==Int R) ... </k>
   119	
   120	  rule <k> eval(Subscript(BASE, Int(I)))
   121	        => eval(BASE) ~> indexAt(I) ... </k>
   122	  rule <k> pyList(VALUES) ~> indexAt(I)
   123	        => pyInt(at(VALUES, I)) ... </k>
   124	  rule <k> eval(Subscript(BASE, Slice(Int(I), NoBound, NoBound)))
   125	        => eval(BASE) ~> sliceFrom(I) ... </k>
   126	  rule <k> pyList(VALUES) ~> sliceFrom(I)
   127	        => pyList(drop(VALUES, I)) ... </k>
   128	
   129	  rule <k> eval(Call(Name("len"), ARG))
   130	        => eval(ARG) ~> builtInLen ... </k>
   131	  rule <k> pyList(VALUES) ~> builtInLen
   132	        => pyInt(size(VALUES)) ... </k>
   133	
   134	  rule <k> eval(Call(Name(F), ARG))
   135	        => eval(ARG) ~> userCall(F) ... </k>
   136	    requires F =/=String "len"
   137	
   138	  // The remainder of the K sequence is itself the expression continuation;
   139	  // only the lexical environment therefore needs an explicit call stack.
   140	  rule <k> ARG:PyVal ~> userCall(F)
   141	        => eval(BODY) ~> restoreCaller ... </k>
   142	       <functions>... F |-> function(P, BODY) ...</functions>
   143	       <env> OLD => P |-> ARG </env>
   144	       <callStack> STACK => ListItem(OLD) STACK </callStack>
   145	
   146	  rule <k> RESULT:PyVal ~> restoreCaller => RESULT ... </k>
   147	       <env> _ => OLD </env>
   148	       <callStack> ListItem(OLD) STACK => STACK </callStack>
   149	
   150	  syntax Int ::= size(ISeq) [function, total]
   151	  rule size(nil) => 0
   152	  rule size(cons(_, REST)) => 1 +Int size(REST)
   153	
   154	  syntax Int ::= at(ISeq, Int) [function]
   155	  rule at(cons(HEAD, _), 0) => HEAD
   156	  rule at(cons(_, REST), I) => at(REST, I -Int 1)
   157	    requires I >Int 0
   158	
   159	  syntax ISeq ::= drop(ISeq, Int) [function]
   160	  rule drop(VALUES, 0) => VALUES
   161	  rule drop(cons(_, REST), I) => drop(REST, I -Int 1)
   162	    requires I >Int 0
   163	
   164	  syntax Int ::= evenPart(Int) [function]
   165	  rule evenPart(I) => I
   166	    requires I %Int 2 ==Int 0
   167	    [concrete]
   168	  rule evenPart(I) => 0
   169	    requires I %Int 2 =/=Int 0
   170	    [concrete]
   171	endmodule

diff --git a/evidence/00_context.command.sh b/evidence/00_context.command.sh
new file mode 100644
index 0000000000000000000000000000000000000000..9914b8112a00c339ac64c3cc088efe176a5f4dac
--- /dev/null
+++ b/evidence/00_context.command.sh
@@ -0,0 +1,12 @@
+#!/usr/bin/env bash
+set -euxo pipefail
+pwd
+printf 'AUDIT_MODE=%s\n' "${AUDIT_MODE-}"
+sha256sum /audit-input.json
+sed -n '1,260p' /audit-input.json
+find /reference -maxdepth 2 -type f -printf '%p\n' | sort
+if [[ -e /candidate ]]; then
+  find /candidate -maxdepth 3 -printf '%y %p\n' | sort
+else
+  printf '/candidate absent\n'
+fi
diff --git a/evidence/01_producer_integrity.command.sh b/evidence/01_producer_integrity.command.sh
new file mode 100644
index 0000000000000000000000000000000000000000..e6f9cd40f4075a17d8d74887a5091951900e05e5
--- /dev/null
+++ b/evidence/01_producer_integrity.command.sh
@@ -0,0 +1,72 @@
+#!/usr/bin/env bash
+set -euxo pipefail
+sha256sum \
+  /reference/generation-tools/klean_export.py \
+  /reference/generation-tools/klean.py \
+  /reference/generation-tools/source-manifest.json \
+  /reference/klean-generation/generator-manifest.json
+sed -n '1,220p' /reference/generation-tools/source-manifest.json
+sed -n '1,260p' /reference/klean-generation/generator-manifest.json
+PYTHONPATH=/reference python3 - <<'PY'
+import json
+from pathlib import Path
+from tools import pipeline_contract, stage6_resolution_contract
+
+audit_path = Path("/audit-input.json")
+audit = json.loads(audit_path.read_text())
+resolution, signed_digest = stage6_resolution_contract.verify_audit_input(audit)
+bundle = Path("/reference/generation-tools")
+generation = json.loads(
+    Path("/reference/klean-generation/generator-manifest.json").read_text()
+)
+source = json.loads((bundle / "source-manifest.json").read_text())
+
+actual = {
+    name: pipeline_contract.sha256_file(bundle / name)
+    for name in ("klean_export.py", "klean.py")
+}
+expected = {
+    "klean_export.py": generation["exporter_sha256"],
+    "klean.py": generation["klean_py_sha256"],
+}
+image_id = generation["provenance"]["generator_image_id"]
+audit_bundle_key = Path(resolution["generation_producer_sources"]).name
+observed_files = sorted(
+    path.relative_to(bundle).as_posix()
+    for path in pipeline_contract._walk_regular_files(
+        bundle, "mounted Stage 4 producer source bundle"
+    )
+)
+result = {
+    "audit_input_verified": True,
+    "resolved_input_sha256": signed_digest,
+    "producer_file_hashes_actual": actual,
+    "producer_file_hashes_generator_manifest": expected,
+    "producer_file_hashes_source_manifest": source["files"],
+    "producer_file_hashes_match": actual == expected == source["files"],
+    "generator_image_id_generator_manifest": image_id,
+    "generator_image_id_source_manifest": source["generator_image_id"],
+    "generator_image_id_audit_path_key": f"sha256:{audit_bundle_key}",
+    "generator_image_ids_match": (
+        image_id
+        == source["generator_image_id"]
+        == f"sha256:{audit_bundle_key}"
+    ),
+    "producer_bundle_files": observed_files,
+    "producer_bundle_exact_file_set": observed_files
+    == ["klean.py", "klean_export.py", "source-manifest.json"],
+    "producer_bundle_sha256_actual": pipeline_contract.sha256_tree(bundle),
+    "producer_bundle_sha256_audit_input": resolution["hashes"][
+        "generation_producer_sources_sha256"
+    ],
+}
+result["producer_bundle_sha256_match"] = (
+    result["producer_bundle_sha256_actual"]
+    == result["producer_bundle_sha256_audit_input"]
+)
+print(json.dumps(result, indent=2, sort_keys=True))
+assert result["producer_file_hashes_match"]
+assert result["generator_image_ids_match"]
+assert result["producer_bundle_exact_file_set"]
+assert result["producer_bundle_sha256_match"]
+PY

apply patch
patch: completed
