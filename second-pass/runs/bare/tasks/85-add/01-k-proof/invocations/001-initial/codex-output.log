+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The mathematical contract: inspect each odd-indexed element (the second
+  // member of each pair), add it exactly when it is even, and recurse.
+  syntax Int ::= oddIndexEvenSum(ISeq) [function]
+  rule oddIndexEvenSum(nil) => 0
+  rule oddIndexEvenSum(cons(_, nil)) => 0
+  rule oddIndexEvenSum(cons(_, cons(EVEN, REST)))
+    => EVEN +Int oddIndexEvenSum(REST)
+    requires EVEN %Int 2 ==Int 0
+  rule oddIndexEvenSum(cons(_, cons(ODD, REST)))
+    => oddIndexEvenSum(REST)
+    requires ODD %Int 2 =/=Int 0
+
+  // This macro is the exact constructor tree generated in solution.mpy.
+  syntax Module ::= "solutionProgram" [macro]
+  rule solutionProgram =>
+    Module(
+      FuncDef("add", Params("lst"),
+        Return(
+          IfExp(
+            Compare(Call(Name("len"), Name("lst")), CmpOp("<", Int(2))),
+            Int(0),
+            BinOp(
+              "+",
+              IfExp(
+                Compare(
+                  BinOp("%", Subscript(Name("lst"), Int(1)), Int(2)),
+                  CmpOp("==", Int(0))),
+                Subscript(Name("lst"), Int(1)),
+                Int(0)),
+              Call(
+                Name("add"),
+                Subscript(Name("lst"), Slice(Int(2), NoBound, NoBound))))))))
+endmodule

