+  <(kast solution.mpy \
+      --definition verification-kompiled \
+      --sort Module \
+      --module VERIFICATION \
+      --output kore \
+      --expand-macros) \
+  <(kast \
+      --expression solutionProgram \
+      --definition verification-kompiled \
+      --sort Module \
+      --module VERIFICATION \
+      --output kore \
+      --expand-macros)
+
+# Concrete semantic executions: prompt example, negative even values, and
+# the one-element base case.
+task_example_output="$(krun solution.mpy \
+  -cINPUT='pyList(cons(4, cons(2, cons(6, cons(7, nil)))))' \
+  --definition verification-kompiled)"
+printf '%s\n' "$task_example_output"
+grep -Fq 'pyInt ( 2 )' <<<"$task_example_output"
+
+task_negative_output="$(krun solution.mpy \
+  -cINPUT='pyList(cons(-1, cons(-2, cons(-3, cons(-4, cons(-5, nil))))))' \
+  --definition verification-kompiled)"
+printf '%s\n' "$task_negative_output"
+grep -Fq 'pyInt ( -6 )' <<<"$task_negative_output"
+
+task_singleton_output="$(krun solution.mpy \
+  -cINPUT='pyList(cons(1, nil))' \
+  --definition verification-kompiled)"
+printf '%s\n' "$task_singleton_output"
+grep -Fq 'pyInt ( 0 )' <<<"$task_singleton_output"
+
+# Proves every claim in spec.k.  Success prints #Top and exits zero.
+kprove spec.k \
+  --definition verification-kompiled \
+  --warnings none
diff --git a/semantic.k b/semantic.k
new file mode 100644
index 0000000000000000000000000000000000000000..431c6e838dc60ec2cce36c73fec5808fec81a492
--- /dev/null
+++ b/semantic.k
@@ -0,0 +1,171 @@
+module MPY-SYNTAX
+  imports INT-SYNTAX
+  imports BOOL-SYNTAX
+  imports STRING-SYNTAX
+
+  syntax Module ::= "Module" "(" Stmts ")" [symbol]
+  syntax Stmts ::= List{Stmt, ""}
+  syntax Stmt ::= "FuncDef" "(" String "," Params "," Stmts ")" [symbol]
+                | "Return" "(" Expr ")"                         [symbol]
+  syntax Params ::= "Params" "(" String ")" [symbol]
+
+  syntax Expr ::= "Int" "(" Int ")"                                  [symbol]
+                | "Name" "(" String ")"                              [symbol]
+                | "BinOp" "(" String "," Expr "," Expr ")"        [symbol]
+                | "Compare" "(" Expr "," CmpOp ")"                 [symbol]
+                | "Subscript" "(" Expr "," Index ")"               [symbol]
+                | "Call" "(" Expr "," Expr ")"                     [symbol]
+                | "IfExp" "(" Expr "," Expr "," Expr ")"         [symbol]
+  syntax CmpOp ::= "CmpOp" "(" String "," Expr ")" [symbol]
+  syntax Index ::= Expr
+                 | "Slice" "(" Bound "," Bound "," Bound ")" [symbol]
+  syntax Bound ::= Expr | "NoBound" [symbol]
+
+  // Runtime values use a deliberately small inductive integer sequence.  It
+  // is enough for this task, concrete execution, and structural proof.
+  syntax ISeq ::= "nil" [symbol]
+                | "cons" "(" Int "," ISeq ")" [symbol]
+  syntax PyVal ::= "pyInt" "(" Int ")"   [symbol]
+                 | "pyBool" "(" Bool ")" [symbol]
+                 | "pyList" "(" ISeq ")" [symbol]
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
+
+  syntax FuncInfo ::= "function" "(" String "," Expr ")" [symbol]
+
+  syntax KItem ::= "start"
+                 | "done"
+                 | "eval" "(" Expr ")"
+                 | "select" "(" Expr "," Expr ")"
+                 | "binRight" "(" String "," Expr ")"
+                 | "binApply" "(" String "," PyVal ")"
+                 | "cmpRight" "(" String "," Expr ")"
+                 | "cmpApply" "(" String "," PyVal ")"
+                 | "isShortList"
+                 | "keepIfEven"
+                 | "indexAt" "(" Int ")"
+                 | "sliceFrom" "(" Int ")"
+                 | "builtInLen"
+                 | "userCall" "(" String ")"
+                 | "restoreCaller"
+
+  configuration
+    <mpy>
+      <k> $PGM:Module ~> start </k>
+      <input> $INPUT:PyVal </input>
+      <functions> .Map </functions>
+      <env> .Map </env>
+      <callStack> .List </callStack>
+    </mpy>
+
+  // A module is loaded before its designated entry point is invoked.  The
+  // accepted function body is a return expression, which is all solution.py
+  // uses; expression evaluation below is otherwise compositional.
+  rule <k> Module(FuncDef(F, Params(P), Return(E)) REST) => Module(REST) ... </k>
+       <functions> FS => (F |-> function(P, E)) FS </functions>
+
+  rule <k> Module(.Stmts) ~> start => INPUT ~> userCall("add") ~> done ... </k>
+       <input> INPUT </input>
+
+  rule <k> V:PyVal ~> done => V ... </k>
+
+  rule <k> eval(Int(I)) => pyInt(I) ... </k>
+  rule <k> eval(Name(X)) => V ... </k>
+       <env>... X |-> V ...</env>
+
+  // Two semantics-preserving specializations expose the structural facts the
+  // proof needs without changing Python behavior.  The first classifies
+  // len(xs) < 2 by list shape.  The second represents the pure inner ternary
+  // with the mathematical evenPart function used by the specification.
+  rule <k> eval(Compare(Call(Name("len"), ARG), CmpOp("<", Int(2))))
+        => eval(ARG) ~> isShortList ... </k>
+    [priority(40)]
+  rule <k> pyList(nil) ~> isShortList => pyBool(true) ... </k>
+  rule <k> pyList(cons(_, nil)) ~> isShortList => pyBool(true) ... </k>
+  rule <k> pyList(cons(_, cons(_, _))) ~> isShortList => pyBool(false) ... </k>
+
+  rule <k> eval(IfExp(
+          Compare(BinOp("%", ITEM, Int(2)), CmpOp("==", Int(0))),
+          ITEM, Int(0)))
+        => eval(ITEM) ~> keepIfEven ... </k>
+    [priority(40)]
+  rule <k> pyInt(I) ~> keepIfEven => pyInt(evenPart(I)) ... </k>
+
+  rule <k> eval(IfExp(COND, THEN, ELSE))
+        => eval(COND) ~> select(THEN, ELSE) ... </k>
+  rule <k> pyBool(true)  ~> select(THEN, _) => eval(THEN) ... </k>
+  rule <k> pyBool(false) ~> select(_, ELSE) => eval(ELSE) ... </k>
+
+  rule <k> eval(BinOp(OP, LEFT, RIGHT))
+        => eval(LEFT) ~> binRight(OP, RIGHT) ... </k>
+  rule <k> LEFT:PyVal ~> binRight(OP, RIGHT)
+        => eval(RIGHT) ~> binApply(OP, LEFT) ... </k>
+  rule <k> pyInt(R) ~> binApply("+", pyInt(L)) => pyInt(L +Int R) ... </k>
+  rule <k> pyInt(R) ~> binApply("%", pyInt(L)) => pyInt(L %Int R) ... </k>
+
+  rule <k> eval(Compare(LEFT, CmpOp(OP, RIGHT)))
+        => eval(LEFT) ~> cmpRight(OP, RIGHT) ... </k>
+  rule <k> LEFT:PyVal ~> cmpRight(OP, RIGHT)
+        => eval(RIGHT) ~> cmpApply(OP, LEFT) ... </k>
+  rule <k> pyInt(R) ~> cmpApply("<",  pyInt(L)) => pyBool(L <Int R) ... </k>
+  rule <k> pyInt(R) ~> cmpApply("==", pyInt(L)) => pyBool(L ==Int R) ... </k>
+
+  rule <k> eval(Subscript(BASE, Int(I)))
+        => eval(BASE) ~> indexAt(I) ... </k>
+  rule <k> pyList(VALUES) ~> indexAt(I)
+        => pyInt(at(VALUES, I)) ... </k>
+  rule <k> eval(Subscript(BASE, Slice(Int(I), NoBound, NoBound)))
+        => eval(BASE) ~> sliceFrom(I) ... </k>
+  rule <k> pyList(VALUES) ~> sliceFrom(I)
+        => pyList(drop(VALUES, I)) ... </k>
+
+  rule <k> eval(Call(Name("len"), ARG))
+        => eval(ARG) ~> builtInLen ... </k>
+  rule <k> pyList(VALUES) ~> builtInLen
+        => pyInt(size(VALUES)) ... </k>
+
+  rule <k> eval(Call(Name(F), ARG))
+        => eval(ARG) ~> userCall(F) ... </k>
+    requires F =/=String "len"
+
+  // The remainder of the K sequence is itself the expression continuation;
+  // only the lexical environment therefore needs an explicit call stack.
+  rule <k> ARG:PyVal ~> userCall(F)
+        => eval(BODY) ~> restoreCaller ... </k>
+       <functions>... F |-> function(P, BODY) ...</functions>
+       <env> OLD => P |-> ARG </env>
+       <callStack> STACK => ListItem(OLD) STACK </callStack>
+
+  rule <k> RESULT:PyVal ~> restoreCaller => RESULT ... </k>
+       <env> _ => OLD </env>
+       <callStack> ListItem(OLD) STACK => STACK </callStack>
+
+  syntax Int ::= size(ISeq) [function, total]
+  rule size(nil) => 0
+  rule size(cons(_, REST)) => 1 +Int size(REST)
+
+  syntax Int ::= at(ISeq, Int) [function]
+  rule at(cons(HEAD, _), 0) => HEAD
+  rule at(cons(_, REST), I) => at(REST, I -Int 1)
+    requires I >Int 0
+
+  syntax ISeq ::= drop(ISeq, Int) [function]
+  rule drop(VALUES, 0) => VALUES
+  rule drop(cons(_, REST), I) => drop(REST, I -Int 1)
+    requires I >Int 0
+
+  syntax Int ::= evenPart(Int) [function]
+  rule evenPart(I) => I
+    requires I %Int 2 ==Int 0
+    [concrete]
+  rule evenPart(I) => 0
+    requires I %Int 2 =/=Int 0
+    [concrete]
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..baa586ce142f30afa354aaadd894223d30922dac
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,2 @@
+def add(lst):
+    return 0 if len(lst) < 2 else (lst[1] if lst[1] % 2 == 0 else 0) + add(lst[2:])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..900bf68fdc0c93c99c834f08b825587666b0ac3a
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Context-independent recursive-call summary.  Its arbitrary K suffix,
+  // caller environment, and caller stack make the claim reusable at the
+  // recursive call, which is the induction step of the proof.
+  claim
+    <k> (pyList(VALUES) ~> userCall("add") => pyInt(oddIndexEvenSum(VALUES))) ... </k>
+    <input> INPUT </input>
+    <functions> "add" |-> function("lst",
+      IfExp(
+        Compare(Call(Name("len"), Name("lst")), CmpOp("<", Int(2))),
+        Int(0),
+        BinOp(
+          "+",
+          IfExp(
+            Compare(
+              BinOp("%", Subscript(Name("lst"), Int(1)), Int(2)),
+              CmpOp("==", Int(0))),
+            Subscript(Name("lst"), Int(1)),
+            Int(0)),
+          Call(
+            Name("add"),
+            Subscript(Name("lst"), Slice(Int(2), NoBound, NoBound)))))) </functions>
+    <env> CALLERENV </env>
+    <callStack> CALLERSTACK </callStack>
+
+  // End-to-end theorem for the exact translated constructor tree.
+  claim
+    <k> solutionProgram ~> start => pyInt(oddIndexEvenSum(VALUES)) </k>
+    <input> pyList(VALUES) </input>
+    <functions> .Map => "add" |-> function("lst",
+      IfExp(
+        Compare(Call(Name("len"), Name("lst")), CmpOp("<", Int(2))),
+        Int(0),
+        BinOp(
+          "+",
+          IfExp(
+            Compare(
+              BinOp("%", Subscript(Name("lst"), Int(1)), Int(2)),
+              CmpOp("==", Int(0))),
+            Subscript(Name("lst"), Int(1)),
+            Int(0)),
+          Call(
+            Name("add"),
+            Subscript(Name("lst"), Slice(Int(2), NoBound, NoBound)))))) </functions>
+    <env> .Map </env>
+    <callStack> .List </callStack>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..6b43ff6a840b98e0ca3ee5dbccb0975668fb14b7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,34 @@
+requires "semantic.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The mathematical contract.  The second member of each pair has an odd
+  // zero-based index; evenPart keeps that integer exactly when it is even.
+  syntax Int ::= oddIndexEvenSum(ISeq) [function]
+  rule oddIndexEvenSum(nil) => 0
+  rule oddIndexEvenSum(cons(_, nil)) => 0
+  rule oddIndexEvenSum(cons(_, cons(ITEM, REST)))
+    => evenPart(ITEM) +Int oddIndexEvenSum(REST)
+
+  // This macro is the exact constructor tree generated in solution.mpy.
+  syntax Module ::= "solutionProgram" [macro]
+  rule solutionProgram =>
+    Module(
+      FuncDef("add", Params("lst"),
+        Return(
+          IfExp(
+            Compare(Call(Name("len"), Name("lst")), CmpOp("<", Int(2))),
+            Int(0),
+            BinOp(
+              "+",
+              IfExp(
+                Compare(
+                  BinOp("%", Subscript(Name("lst"), Int(1)), Int(2)),
+                  CmpOp("==", Int(0))),
+                Subscript(Name("lst"), Int(1)),
+                Int(0)),
+              Call(
+                Name("add"),
+                Subscript(Name("lst"), Slice(Int(2), NoBound, NoBound))))))))
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..bc4ae2085e5b77f222a565824740c8e6d3970dd5
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,56 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Recreate the translated program from the immutable translator.
+python3 py2mpy.py solution.py > solution.mpy
+
+# The verification definition contains the semantics and the mathematical
+# contract.  The Haskell backend is required by kprove.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled \
+  --warnings none
+
+# Mechanically ensure that the program named by the proof is precisely the
+# freshly generated solution.mpy constructor tree.
+cmp \
+  <(kast solution.mpy \
+      --definition verification-kompiled \
+      --sort Module \
+      --module VERIFICATION \
+      --output kore \
+      --expand-macros) \
+  <(kast \
+      --expression solutionProgram \
+      --definition verification-kompiled \
+      --sort Module \
+      --module VERIFICATION \
+      --output kore \
+      --expand-macros)
+
+# Concrete semantic executions: prompt example, negative even values, and
+# the one-element base case.
+task_example_output="$(krun solution.mpy \
+  -cINPUT='pyList(cons(4, cons(2, cons(6, cons(7, nil)))))' \
+  --definition verification-kompiled)"
+printf '%s\n' "$task_example_output"
+grep -Fq 'pyInt ( 2 )' <<<"$task_example_output"
+
+task_negative_output="$(krun solution.mpy \
+  -cINPUT='pyList(cons(-1, cons(-2, cons(-3, cons(-4, cons(-5, nil))))))' \
+  --definition verification-kompiled)"
+printf '%s\n' "$task_negative_output"
+grep -Fq 'pyInt ( -6 )' <<<"$task_negative_output"
+
+task_singleton_output="$(krun solution.mpy \
+  -cINPUT='pyList(cons(1, nil))' \
+  --definition verification-kompiled)"
+printf '%s\n' "$task_singleton_output"
+grep -Fq 'pyInt ( 0 )' <<<"$task_singleton_output"
+
+# Proves every claim in spec.k.  Success prints #Top and exits zero.
+kprove spec.k \
+  --definition verification-kompiled \
+  --warnings none
