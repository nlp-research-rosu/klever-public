+                 | "pyBool" "(" Bool ")" [symbol]
+                 | "pyList" "(" ISeq ")" [symbol]
+endmodule
+
+module MPY
+  imports MPY-SYNTAX
+  imports INT
+  imports BOOL
+  imports STRING
+  imports MAP
+  imports LIST
