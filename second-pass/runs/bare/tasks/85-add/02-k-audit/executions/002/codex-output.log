@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: $0 LOG_NAME COMMAND [ARG ...]" >&2
+  exit 2
+fi
+
+log_name="$1"
+shift
+log_path="/audit-output/evidence/${log_name}.log"
+
+{
+  printf 'WORKDIR: %q\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$log_path"
+
+"$@" >> "$log_path" 2>&1
+status=$?
+printf 'EXIT_STATUS: %d\n' "$status" >> "$log_path"
+
+cat "$log_path"
+exit "$status"
