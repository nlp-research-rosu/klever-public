    43	  syntax KItem ::= "start"
    44	                 | "done"
    45	                 | "eval" "(" Expr ")"
    46	                 | "select" "(" Expr "," Expr ")"
    47	                 | "binRight" "(" String "," Expr ")"
    48	                 | "binApply" "(" String "," PyVal ")"
    49	                 | "cmpRight" "(" String "," Expr ")"
    50	                 | "cmpApply" "(" String "," PyVal ")"
    51	                 | "isShortList"
    52	                 | "keepIfEven"
    53	                 | "indexAt" "(" Int ")"
    54	                 | "sliceFrom" "(" Int ")"
    55	                 | "builtInLen"
    56	                 | "userCall" "(" String ")"
    57	                 | "restoreCaller"
