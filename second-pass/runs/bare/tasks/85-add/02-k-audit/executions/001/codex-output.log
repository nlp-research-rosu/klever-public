+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // Keep the real recursive helper unchanged so only the entry result
+  // obligation is mutated.
+  claim [helper]:
+    <k> (pyList(VALUES) ~> userCall("add") => pyInt(oddIndexEvenSum(VALUES))) ... </k>
+    <input> INPUT </input>
+    <functions> "add" |-> function("lst",
+      IfExp(
+        Compare(Call(Name("len"), Name("lst")), CmpOp("<", Int(2))),
+        Int(0),
+        BinOp(
+          "+",
+          IfExp(
+            Compare(
+              BinOp("%", Subscript(Name("lst"), Int(1)), Int(2)),
+              CmpOp("==", Int(0))),
+            Subscript(Name("lst"), Int(1)),
+            Int(0)),
+          Call(
+            Name("add"),
+            Subscript(Name("lst"), Slice(Int(2), NoBound, NoBound)))))) </functions>
+    <env> CALLERENV </env>
+    <callStack> CALLERSTACK </callStack>
+
+  // Deliberately false: require the actual result to equal the intended
+  // mathematical sum plus one.
+  claim [false-entry]:
+    <k> solutionProgram ~> start
+      => pyInt(oddIndexEvenSum(VALUES) +Int 1) </k>
+    <input> pyList(VALUES) </input>
+    <functions> .Map => "add" |-> function("lst",
+      IfExp(
+        Compare(Call(Name("len"), Name("lst")), CmpOp("<", Int(2))),
+        Int(0),
+        BinOp(
+          "+",
+          IfExp(
+            Compare(
+              BinOp("%", Subscript(Name("lst"), Int(1)), Int(2)),
+              CmpOp("==", Int(0))),
+            Subscript(Name("lst"), Int(1)),
+            Int(0)),
+          Call(
+            Name("add"),
+            Subscript(Name("lst"), Slice(Int(2), NoBound, NoBound)))))) </functions>
