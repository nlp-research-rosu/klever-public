+        candidate_value = candidate(values.copy())
+        canonical_value = canonical(values.copy())
+        print(
+            "RESULTS: "
+            f"k={k_value!r} candidate_python={candidate_value!r} "
+            f"canonical_python={canonical_value!r} oracle={oracle_value!r}"
+        )
+        if (
