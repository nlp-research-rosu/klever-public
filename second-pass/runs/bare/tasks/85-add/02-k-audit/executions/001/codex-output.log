+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.add
+
+
+def oracle(values: list[int]) -> int:
+    total = 0
+    for index in range(1, len(values), 2):
+        value = values[index]
+        if value % 2 == 0:
