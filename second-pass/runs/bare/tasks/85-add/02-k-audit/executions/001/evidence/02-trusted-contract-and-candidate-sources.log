     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Recreate the translated program from the immutable translator.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# The verification definition contains the semantics and the mathematical
     8	# contract.  The Haskell backend is required by kprove.
     9	kompile verification.k \
    10	  --backend haskell \
    11	  --main-module VERIFICATION \
    12	  --syntax-module MPY-SYNTAX \
    13	  --output-definition verification-kompiled \
    14	  --warnings none
    15	
    16	# Mechanically ensure that the program named by the proof is precisely the
    17	# freshly generated solution.mpy constructor tree.
    18	cmp \
    19	  <(kast solution.mpy \
    20	      --definition verification-kompiled \
    21	      --sort Module \
    22	      --module VERIFICATION \
    23	      --output kore \
    24	      --expand-macros) \
    25	  <(kast \
    26	      --expression solutionProgram \
    27	      --definition verification-kompiled \
    28	      --sort Module \
    29	      --module VERIFICATION \
    30	      --output kore \
    31	      --expand-macros)
    32	
    33	# Concrete semantic executions: prompt example, negative even values, and
    34	# the one-element base case.
    35	task_example_output="$(krun solution.mpy \
    36	  -cINPUT='pyList(cons(4, cons(2, cons(6, cons(7, nil)))))' \
    37	  --definition verification-kompiled)"
    38	printf '%s\n' "$task_example_output"
    39	grep -Fq 'pyInt ( 2 )' <<<"$task_example_output"
    40	
    41	task_negative_output="$(krun solution.mpy \
    42	  -cINPUT='pyList(cons(-1, cons(-2, cons(-3, cons(-4, cons(-5, nil))))))' \
    43	  --definition verification-kompiled)"
    44	printf '%s\n' "$task_negative_output"
    45	grep -Fq 'pyInt ( -6 )' <<<"$task_negative_output"
    46	
    47	task_singleton_output="$(krun solution.mpy \
    48	  -cINPUT='pyList(cons(1, nil))' \
    49	  --definition verification-kompiled)"
    50	printf '%s\n' "$task_singleton_output"
    51	grep -Fq 'pyInt ( 0 )' <<<"$task_singleton_output"
    52	
    53	# Proves every claim in spec.k.  Success prints #Top and exits zero.
    54	kprove spec.k \
