===== /candidate/verification.k =====
     1	requires "semantic.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // The mathematical contract.  The second member of each pair has an odd
     7	  // zero-based index; evenPart keeps that integer exactly when it is even.
     8	  syntax Int ::= oddIndexEvenSum(ISeq) [function]
     9	  rule oddIndexEvenSum(nil) => 0
    10	  rule oddIndexEvenSum(cons(_, nil)) => 0
    11	  rule oddIndexEvenSum(cons(_, cons(ITEM, REST)))
    12	    => evenPart(ITEM) +Int oddIndexEvenSum(REST)
    13	
    14	  // This macro is the exact constructor tree generated in solution.mpy.
    15	  syntax Module ::= "solutionProgram" [macro]
    16	  rule solutionProgram =>
    17	    Module(
    18	      FuncDef("add", Params("lst"),
    19	        Return(
    20	          IfExp(
    21	            Compare(Call(Name("len"), Name("lst")), CmpOp("<", Int(2))),
    22	            Int(0),
    23	            BinOp(
    24	              "+",
    25	              IfExp(
    26	                Compare(
    27	                  BinOp("%", Subscript(Name("lst"), Int(1)), Int(2)),
    28	                  CmpOp("==", Int(0))),
    29	                Subscript(Name("lst"), Int(1)),
    30	                Int(0)),
    31	              Call(
    32	                Name("add"),
    33	                Subscript(Name("lst"), Slice(Int(2), NoBound, NoBound))))))))
    34	endmodule
