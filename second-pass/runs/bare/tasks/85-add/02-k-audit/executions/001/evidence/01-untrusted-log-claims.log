189:{"timestamp":"2026-07-22T11:11:27.336Z","type":"response_item","payload":{"type":"custom_tool_call_output","call_id":"call_OUqjtAJJJaOlelOzBwfy1EW9","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"Usage: kast [options] <file>\n  Options:\n    --color <mode>\n      Use colors in output. Default is on.\n      Possible Values: [OFF, ON, EXTENDED]\n    --debug\n      Print debugging output messages and error stack traces\n      Default: false\n    --debug-parse\n      Print extended diagnostic information and partial ASTs for parse errors.\n      Default: false\n    --debug-tokens\n      Print a Markdown table of tokens matched by the scanner. Useful for \n      debugging parsing errors.\n      Default: false\n    --debug-warnings\n      Print debugging output messages and error/warning stack traces\n      Default: false\n    --definition <path>, -d <path>\n      Exact path to the kompiled directory.\n    --expand-macros\n      Also expand macros in the parsed string.\n      Default: false\n    --expression <expression>, -e <expression>\n      An expression to parse passed on the command line. It is an error to \n      provide both this option and a file to parse.\n    --gen-glr-parser\n      Generate a Bison/Flex GLR parser for the specified module and sort.\n      Default: false\n    --gen-parser\n      Generate a Bison/Flex parser for the specified module and sort.\n      Default: false\n    --help, -h\n      Print this help message\n    --help-hidden, -hh\n      Print advanced options help message\n    --input <mode>, -i <mode>\n      How to read kast input in. <mode> is either \n      [program|kast|json|kore|rule]. \n      Default: PROGRAM\n      Possible Values: [PROGRAM, JSON, KAST, KORE, RULE]\n    --module <name>, -m <name>\n      Parse text in the specified module. Defaults to the syntax module of the \n      definition. \n    --no-alpha-renaming\n      Do not alpha rename anonymous variables in output.\n      Default: false\n    --no-sort-collections\n      Do not sort collections before printing (for speed).\n      Default: false\n    --no-substitution-filtering\n      Do not remove conjuncts of anonymous variables from substitution in \n      output. \n      Default: false\n    --output <mode>, -o <mode>\n      How to display krun results. <mode> is either \n      [pretty|program|kast|binary|json|kore|none]. \n      Default: KAST\n      Possible Values: [PRETTY, PROGRAM, KAST, JSON, KORE, NONE]\n    --output-file <file>\n      Store output in the file instead of displaying it.\n    --output-flatten <KLabels>\n      (Assoc) KLabels to flatten into one list.\n      Default: []\n    --output-omit <KLabels>\n      KLabels to omit from the output.\n      Default: []\n    --output-tokast <KLabels>\n      KLabels to output as KAST tokens.\n      Default: []\n    --output-tokenize <KLabels>\n      KLabels to tokenize underneath (reducing output size).\n      Default: []\n    --sort <sort>, -s <sort>\n      The start sort for the default parser. The default is the sort of $PGM \n      from the configuration. A sort may also be specified with the \n      'KRUN_SORT' environment variable, in which case it is used if the option \n      is not specified on the command line.\n    --steps <steps>\n      Apply specified kompilation steps to the parsed term. Only for --input \n      rule. Use --steps help for a detailed description of available steps.\n      Default: [anonVars]\n    --temp-dir <path>\n      Put temp files in this location. Default is /tmp/.<tool>-xxx\n    --verbose, -v\n      Print verbose output messages\n      Default: false\n    --version\n      Print version information\n      Default: false\n    --warnings <level>, -w <level>\n      Warning level. Values: [all|normal|none]\n      Default: NORMAL\n      Possible Values: [ALL, NORMAL, NONE]\n    --warnings-to-errors, -w2e\n      Convert warnings to errors.\n      Default: false\n    -W <warning>\n      Enable specific warning categories. Values: [non-exhaustive-match|undeleted-temp-dir|missing-hook-java|missing-syntax-module|invalid-exit-code|deprecated-backend|invalid-config-var|future-error|unused-var|proof-lint|useless-rule|unresolved-function-symbol|malformed-markdown|invalidated-cache|unused-symbol|removed-anywhere]\n      Default: []\n    -Wno <warning>\n      Disable specific warning categories.\n      Default: []\n\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f897a-a39a-73d2-bab3-7d4a720ca019"}}}
