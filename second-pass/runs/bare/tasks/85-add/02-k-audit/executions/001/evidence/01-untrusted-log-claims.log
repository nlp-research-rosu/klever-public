 \\\n  -cINPUT='pyList(cons(1, nil))' \\\n  --definition verification-kompiled)\"\nprintf '%s\\n' \"$task_singleton_output\"\ngrep -Fq 'pyInt ( 0 )' <<<\"$task_singleton_output\"\n\n# Proves every claim in spec.k.  Success prints #Top and exits zero.\nkprove spec.k \\\n  --definition verification-kompiled \\\n  --warnings none\n"}},"status":"completed"}}
