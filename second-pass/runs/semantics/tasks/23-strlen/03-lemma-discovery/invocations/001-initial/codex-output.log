/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
inv_path = '/reference/rule-inventory.json'
out_path = '/workspace/trust-boundary.json'
with open(inv_path, encoding='utf-8') as f:
    inv = json.load(f)
with open(out_path, encoding='utf-8') as f:
    out = json.load(f)
assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
inv_ids = [r['source_rule_id'] for r in inv['rules']]
out_ids = [r['source_rule_id'] for r in out['rules']]
assert out_ids == inv_ids
assert Counter(out_ids) == Counter(inv_ids)
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
for src, dst in zip(inv['rules'], out['rules']):
    assert list(dst) == ['source_rule_id', 'classification', 'rationale']
    assert dst['classification'] in allowed
    assert isinstance(dst['rationale'], str) and dst['rationale'].strip()
    if 'simplification' in src.get('attributes', []):
        assert dst['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
assert not any(r['classification'] == 'DOMAIN_LEMMA' for r in out['rules'])
assert not any(r['classification'] == 'PROVED_DERIVED_LEMMA' for r in out['rules'])
print(f\"validated {len(out_ids)} rules; inventory hash {out['inventory_sha256']}\")
PY
