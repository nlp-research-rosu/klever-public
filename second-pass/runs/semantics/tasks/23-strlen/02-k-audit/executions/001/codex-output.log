+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: for the satisfiable empty-string state this demands 0 = 1.
+  claim
+    <k> #invokeStrlen(str(S:IntSeq)) => isLen(S) +Int 1 </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    =>
+      (0 |-> scope(
+              .Map [
+                "strlen" <-
+                  closureVal(
+                    "string",
+                    Return(Call(Name("len"), Name("string"))) .Stmts,
+                    0
+                  )
+              ],
+              parent(-1)
+            )
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule

codex
The static path is exact and result-bearing: the proof-local macro is byte-for-byte the translated constructor tree, while `#invokeStrlen` is only a fresh harness expansion into `#loadAll(...) ~> Call(...)`; it does not replace `strlen`, `len`, lookup, binding, or return. The real closure body executes through the supplied rules and reduces `len(str(S))` to the recursive `isLen(S)`. Two ground instances (empty and `abc`) also close with results 0 and 3. I’m now applying the independent false-postcondition test, with a dry-run first to distinguish a valid mutation from parser/build failure.
