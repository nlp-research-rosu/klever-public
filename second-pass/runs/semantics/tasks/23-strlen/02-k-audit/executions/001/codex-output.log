/bin/bash -lc "/audit-output/evidence/run_logged.sh /audit-output/evidence/12-ground-adequacy.log bash -lc 'set -euo pipefail; export PATH=\""'$HOME/.nix-profile/bin:$PATH"; cp /audit-output/evidence/adequacy-ground.k ./adequacy-ground.k; kprove adequacy-ground.k --definition verification-kompiled --spec-module ADEQUACY-GROUND'"'" in /tmp/audit-work/23-strlen/candidate
