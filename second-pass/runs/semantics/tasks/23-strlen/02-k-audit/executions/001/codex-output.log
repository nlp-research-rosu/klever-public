diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..a1628fdbd406e1fac4a4c6e872b425e1c57b9033
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,34 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: for the satisfiable empty-string state this demands 0 = 1.
+  claim
+    <k> #invokeStrlen(str(S:IntSeq)) => isLen(S) +Int 1 </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    =>
+      (0 |-> scope(
+              .Map [
+                "strlen" <-
+                  closureVal(
+                    "string",
+                    Return(Call(Name("len"), Name("string"))) .Stmts,
+                    0
+                  )
+              ],
+              parent(-1)
+            )
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
