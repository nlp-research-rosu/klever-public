+            assessment = "compile-time name for the mechanically identical submitted Module term"
+        elif line == 8:
+            disposition = "CANDIDATE-VALID-DEFINITIONAL-MACRO"
+            assessment = "RHS is constructor-identical to regenerated solution.mpy"
+        elif line == 18:
