+  claim
+    <k> #invokeStrlen(str(S:IntSeq)) => isLen(S) +Int 1 </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    =>
+      (0 |-> scope(
+              .Map [
+                "strlen" <-
+                  closureVal(
+                    "string",
+                    Return(Call(Name("len"), Name("string"))) .Stmts,
