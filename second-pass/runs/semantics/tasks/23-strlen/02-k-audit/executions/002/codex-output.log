+}
+
+REASONS: dict[tuple[str, int], str] = {
+    ("reference-semantics/semantics/core.k", 49): "initial cells match the claim pre-state",
+    ("reference-semantics/semantics/core.k", 125): "loads the exact Module statement sequence",
