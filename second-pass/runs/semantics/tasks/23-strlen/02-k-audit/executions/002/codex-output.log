+actual_lock_hash = hashlib.sha256(lock_bytes).hexdigest()
+print(f"campaign_block_equal=true")
+print(f"audit_campaign_lock_sha256={actual_lock_hash}")
+assert actual_lock_hash == audit["hashes"]["audit_campaign_lock_sha256"]
+
