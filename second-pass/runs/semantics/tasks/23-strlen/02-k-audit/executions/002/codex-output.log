log_path=/audit-output/evidence/04_body_sensitivity.log
printf 'COMMAND: kompile /audit-output/evidence/04_verification_body_mut.k --backend haskell --main-module VERIFICATION-BODY-MUT --syntax-module MPY-SYNTAX --output-definition /tmp/audit-work/23-strlen-independent/rebuild/body-mut-kompiled\\n' | tee \""'$log_path"
kompile /audit-output/evidence/04_verification_body_mut.k --backend haskell --main-module VERIFICATION-BODY-MUT --syntax-module MPY-SYNTAX --output-definition /tmp/audit-work/23-strlen-independent/rebuild/body-mut-kompiled 2>&1 | tee -a "$log_path"
