+      CmpOp("==", Int(1))
+    )
+  )
+  Assert(
+    Compare(
+      Call(Name("strlen"), Str("abc")),
+      CmpOp("==", Int(3))
+    )
+  )
+  Assert(
+    Compare(
+      Call(Name("strlen"), Str("HumanEval")),
+      CmpOp("==", Int(9))
+    )
+  )
+)
