/reference/k-proof/reference-semantics/semantics/str.k-33-  rule strPrefix(.IntSeq, _:IntSeq)               => true
/reference/k-proof/reference-semantics/semantics/str.k-34-  rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false
/reference/k-proof/reference-semantics/semantics/str.k-35-  rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)
