/reference/k-proof/reference-semantics/semantics/str.k:29:  rule applyCmp("in",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)
/reference/k-proof/reference-semantics/semantics/str.k:30:  rule applyCmp("not in", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)
