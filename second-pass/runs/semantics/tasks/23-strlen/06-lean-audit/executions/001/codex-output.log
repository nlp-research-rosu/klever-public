/reference/k-proof/reference-semantics/semantics/str.k-53-  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B
/reference/k-proof/reference-semantics/semantics/str.k-54-  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B
