diff --git a/evidence/fixed-context-verification.k b/evidence/fixed-context-verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..cf4327e7eeaa6096b58b2c4c58010d8360222f7c
--- /dev/null
+++ b/evidence/fixed-context-verification.k
@@ -0,0 +1,21 @@
+requires "reference-semantics/semantics.k"
+
+module FIXED-CONTEXT-VERIFICATION
+  imports MPY
+
+  syntax Stmts ::= "#fixedInnerBody" [macro]
+  rule #fixedInnerBody
+    => If(Compare(Name("item"), CmpOp("==", Name("value"))),
+          AugAssign(Name("count"), "+", Int(1)) .Stmts,
+          .Stmts) .Stmts
+
+  syntax Stmts ::= "#fixedOuterBody" [macro]
+  rule #fixedOuterBody
+    => Assign(Name("count"), Int(0))
+       For(Name("item"), Name("lst"), #fixedInnerBody)
+       If(Compare(Name("count"), CmpOp(">=", Name("value"))),
+          If(Compare(Name("value"), CmpOp(">", Name("result"))),
+             Assign(Name("result"), Name("value")) .Stmts,
+             .Stmts) .Stmts,
+          .Stmts) .Stmts
+endmodule
diff --git a/evidence/fresh-vacuity-spec.k b/evidence/fresh-vacuity-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..41f0c344dc0d7175e4692cd51c23e874352be47c
--- /dev/null
+++ b/evidence/fresh-vacuity-spec.k
@@ -0,0 +1,32 @@
+requires "verification.k"
+
+module SEARCH-FRESH-VACUITY-SPEC
+  imports SEARCH-VERIFICATION
+
+  // Fresh false result mutation: for every satisfying input, the real result
+  // is greatestFreq(ALL), not greatestFreq(ALL) + 1.  Witness ALL=[1] gives
+  // 1 versus 2.
+  claim
+    <k> Call(Name("search"), list(ALL:IntValSeq), .Exprs)
+      => greatestFreq(ALL) +Int 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "search" |-> closureVal(
+               "lst" , .ParamNames,
+               #searchBody,
+               0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
