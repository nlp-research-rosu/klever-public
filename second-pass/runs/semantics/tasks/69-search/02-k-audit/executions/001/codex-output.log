diff --git a/evidence/fixed-context-verification.k b/evidence/fixed-context-verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..cf4327e7eeaa6096b58b2c4c58010d8360222f7c
--- /dev/null
+++ b/evidence/fixed-context-verification.k
@@ -0,0 +1,21 @@
+requires "reference-semantics/semantics.k"
+
+module FIXED-CONTEXT-VERIFICATION
+  imports MPY
+
+  syntax Stmts ::= "#fixedInnerBody" [macro]
+  rule #fixedInnerBody
+    => If(Compare(Name("item"), CmpOp("==", Name("value"))),
+          AugAssign(Name("count"), "+", Int(1)) .Stmts,
+          .Stmts) .Stmts
+
+  syntax Stmts ::= "#fixedOuterBody" [macro]
+  rule #fixedOuterBody
+    => Assign(Name("count"), Int(0))
+       For(Name("item"), Name("lst"), #fixedInnerBody)
+       If(Compare(Name("count"), CmpOp(">=", Name("value"))),
+          If(Compare(Name("value"), CmpOp(">", Name("result"))),
+             Assign(Name("result"), Name("value")) .Stmts,
+             .Stmts) .Stmts,
+          .Stmts) .Stmts
+endmodule
