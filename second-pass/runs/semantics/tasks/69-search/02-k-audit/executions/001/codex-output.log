+  overall=1
+fi
+if ! rg -q 'WarnStuckClaimState|implication check.*failed|cannot be rewritten further' \
+     /audit-output/evidence/stage6_mutation_failure.log; then
+  printf 'ERROR: meaningful unmet-obligation diagnostic absent\n'
+  overall=1
+fi
+
+exit "$overall"

