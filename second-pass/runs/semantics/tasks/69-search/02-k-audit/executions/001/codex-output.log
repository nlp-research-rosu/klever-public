+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "probe" |-> closureVal(
+               "lst" , .ParamNames,
+               Assign(Name("result"), UnaryOp("-", Int(1)))
+               Assign(Name("value"), Int(99))
+               For(Name("value"), Name("lst"), #fixedOuterBody)
+               Return(Name("value")) .Stmts,
+               0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
