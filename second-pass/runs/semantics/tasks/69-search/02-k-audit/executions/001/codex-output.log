+#!/usr/bin/env bash
+set -u
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+run_shell() {
+  printf '\n$ %s\n' "$1"
+  bash -o pipefail -c "$1"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
