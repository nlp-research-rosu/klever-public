+assert search([5, 5, 4, 4, 4]) == -1
+assert search([1]) == 1
+assert search([2]) == -1
+assert search([2, 2]) == 2
+assert search([3, 3]) == -1
+assert search([2, 2, 3, 3, 3]) == 3
