LOCAL_PRIORITY_AND_GUARDED_RULES:
     1	requires "reference-semantics/semantics.k"
     2	
     3	module SEARCH-VERIFICATION
     4	  imports MPY
     5	
     6	  // The exact statement blocks emitted from solution.py.  Naming them keeps
     7	  // the loop invariants in spec.k readable; these are syntax macros only.
     8	  syntax Stmts ::= "#innerBody" [macro]
     9	  rule #innerBody
    10	    => If(Compare(Name("item"), CmpOp("==", Name("value"))),
    11	          AugAssign(Name("count"), "+", Int(1)) .Stmts,
    12	          .Stmts) .Stmts
    13	
    14	  syntax Stmts ::= "#outerBody" [macro]
    15	  rule #outerBody
    16	    => Assign(Name("count"), Int(0))
    17	       For(Name("item"), Name("lst"), #innerBody)
    18	       If(Compare(Name("count"), CmpOp(">=", Name("value"))),
    19	          If(Compare(Name("value"), CmpOp(">", Name("result"))),
    20	             Assign(Name("result"), Name("value")) .Stmts,
    21	             .Stmts) .Stmts,
    22	          .Stmts) .Stmts
    23	
    24	  syntax Stmts ::= "#searchBody" [macro]
    25	  rule #searchBody
    26	    => Assign(Name("result"), UnaryOp("-", Int(1)))
    27	       For(Name("value"), Name("lst"), #outerBody)
    28	       Return(Name("result")) .Stmts
    29	
    30	  // A refinement sort using the *same* ValSeq constructors gives symbolic
    31	  // inputs an Int-only constructor induction principle without a conversion
    32	  // wrapper that would obscure list iteration.
    33	  syntax IntValSeq ::= ".ValSeq" | vCons(Int, IntValSeq)
    34	  syntax ValSeq ::= IntValSeq
    35	
    36	  syntax Bool ::= allPositive(IntValSeq) [function, total]
    37	  rule allPositive(.ValSeq) => true
    38	  rule allPositive(vCons(X:Int, XS:IntValSeq))
    39	    => X >Int 0 andBool allPositive(XS)
    40	
    41	  syntax Bool ::= nonEmpty(IntValSeq) [function, total]
    42	  rule nonEmpty(.ValSeq) => false
    43	  rule nonEmpty(vCons(_:Int, _:IntValSeq)) => true
    44	
    45	  // Mathematical frequency and contract result.  greatestFreq folds over the
    46	  // original list, retaining exactly the largest positive X whose occurrence
    47	  // count in the complete list is at least X.
    48	  syntax Int ::= frequency(Int, IntValSeq) [function, total]
    49	  rule frequency(_:Int, .ValSeq) => 0
    50	  rule frequency(X:Int, vCons(Y:Int, YS:IntValSeq))
    51	    => (#if X ==Int Y #then 1 #else 0 #fi) +Int frequency(X, YS)
    52	
    53	  syntax Int ::= chooseFreq(Int, IntValSeq, Int) [function, total]
    54	  rule chooseFreq(X:Int, ALL:IntValSeq, BEST:Int) => X
    55	    requires X >Int 0
    56	     andBool frequency(X, ALL) >=Int X
    57	     andBool X >Int BEST
    58	  rule chooseFreq(X:Int, ALL:IntValSeq, BEST:Int) => BEST
    59	    requires notBool (X >Int 0
    60	              andBool frequency(X, ALL) >=Int X
    61	              andBool X >Int BEST)
    62	
    63	  syntax Int ::= greatestFreq(IntValSeq) [function, total]
    64	               | greatestFreqFrom(IntValSeq, IntValSeq, Int) [function, total]
    65	  rule greatestFreq(ALL:IntValSeq)
    66	    => greatestFreqFrom(ALL, ALL, -1)
    67	  rule greatestFreqFrom(.ValSeq, _:IntValSeq, BEST:Int) => BEST
    68	  rule greatestFreqFrom(vCons(X:Int, XS:IntValSeq), ALL:IntValSeq, BEST:Int)
    69	    => greatestFreqFrom(XS, ALL, chooseFreq(X, ALL, BEST))
    70	
    71	  // Proof-only loop accelerator.  It matches the exact translated outer loop
    72	  // (including the complete nested counting body), the original lst binding,
    73	  // and the initial -1 accumulator.  The reference iterator cannot split an
    74	  // abstract ValSeq tail, so this rule supplies that structural induction in
    75	  // closed form.  Calls, lookup, assignment, return, and frame cleanup still
    76	  // execute with MPY's supplied rules.
    77	  rule <k> For(Name("value"), list(ALL:IntValSeq), #outerBody)
    78	        => Assign(Name("result"), Int(greatestFreq(ALL))) ... </k>
    79	       <env> L:Int </env>
    80	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    81	       requires "lst" in_keys(M)
    82	        andBool "result" in_keys(M)
    83	        andBool {M["lst"]}:>Val ==K list(ALL)
    84	        andBool {M["result"]}:>Val ==K -1
    85	        andBool allPositive(ALL)
    86	       [priority(40)]
    87	endmodule
