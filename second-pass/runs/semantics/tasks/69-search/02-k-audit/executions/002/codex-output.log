+requires "verification.k"
+
+module SEARCH-WITNESS-EXTENSION
+  imports SEARCH-VERIFICATION
+
+  syntax IntValSeq ::= "oneSeq" [macro]
+                       | "twoSeq" [macro]
+                       | "twoTwoSeq" [macro]
+                       | "exampleSeq" [macro]
+
+  rule oneSeq => vCons(1, .ValSeq)
+  rule twoSeq => vCons(2, .ValSeq)
+  rule twoTwoSeq => vCons(2, vCons(2, .ValSeq))
+  rule exampleSeq
+    => vCons(4, vCons(1, vCons(2, vCons(2, vCons(3, vCons(1, .ValSeq))))))
+endmodule
diff --git a//tmp/audit-work/69-search/05_no_bridge_spec.k b//tmp/audit-work/69-search/05_no_bridge_spec.k
index c29e03b5b91513a1b2a22127cde15bd28708e7d1..ccfc62df62067f28418c829ffad2803894fe3551
--- a//tmp/audit-work/69-search/05_no_bridge_spec.k
+++ b//tmp/audit-work/69-search/05_no_bridge_spec.k
@@ -1,7 +1,7 @@
-requires "verification.k"
+requires "05_verification_no_bridge.k"
 
-module SEARCH-SPEC
-  imports SEARCH-VERIFICATION
+module SEARCH-NO-BRIDGE-SPEC
+  imports SEARCH-VERIFICATION-NO-BRIDGE
 
   // Entry-point theorem.  The non-empty/positive assumptions are precisely
   // the HumanEval precondition; the result is the declarative contract fold.
