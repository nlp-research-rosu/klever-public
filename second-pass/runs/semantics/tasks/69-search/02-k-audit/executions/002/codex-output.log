+                count += 1
+        if count >= value:
+            if value > result:
+                result = value
+    return result
+
+
+assert search([4, 1, 2, 2, 3, 1]) == 2
+assert search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3
+assert search([5, 5, 4, 4, 4]) == -1
+assert search([1]) == 1
+assert search([2]) == -1
+assert search([2, 2]) == 2
+assert search([3, 3]) == -1
+assert search([3, 3, 3]) == 3
diff --git a//tmp/audit-work/69-search/04_body_sensitivity.k b//tmp/audit-work/69-search/04_body_sensitivity.k
new file mode 100644
index 0000000000000000000000000000000000000000..6ce8ef42e91469eab096bc79308a13aa2456e2e4
--- /dev/null
+++ b//tmp/audit-work/69-search/04_body_sensitivity.k
@@ -0,0 +1,43 @@
+requires "verification.k"
+
+module SEARCH-BODY-SENSITIVITY
+  imports SEARCH-VERIFICATION
+
+  // Material body mutation: each equality contributes 2 instead of 1.
+  // This changes the closure term actually executed by the claim.
+  claim
+    <k> Call(Name("search"), list(ALL:IntValSeq), .Exprs)
+      => greatestFreq(ALL)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "search" |-> closureVal(
+               "lst", .ParamNames,
+               Assign(Name("result"), UnaryOp("-", Int(1)))
+               For(Name("value"), Name("lst"),
+                 Assign(Name("count"), Int(0))
+                 For(Name("item"), Name("lst"),
+                   If(Compare(Name("item"), CmpOp("==", Name("value"))),
+                      AugAssign(Name("count"), "+", Int(2)) .Stmts,
+                      .Stmts) .Stmts)
+                 If(Compare(Name("count"), CmpOp(">=", Name("value"))),
+                    If(Compare(Name("value"), CmpOp(">", Name("result"))),
+                       Assign(Name("result"), Name("value")) .Stmts,
+                       .Stmts) .Stmts,
+                    .Stmts) .Stmts)
+               Return(Name("result")) .Stmts,
+               0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires nonEmpty(ALL)
+     andBool allPositive(ALL)
+endmodule
diff --git a//tmp/audit-work/69-search/04_bridge_context_witness.k b//tmp/audit-work/69-search/04_bridge_context_witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..c1a07b71f17765289e65fdbc5a8a4cd61be87507
--- /dev/null
+++ b//tmp/audit-work/69-search/04_bridge_context_witness.k
@@ -0,0 +1,32 @@
+requires "04_witness_extension.k"
+
+module SEARCH-BRIDGE-CONTEXT-WITNESS
+  imports SEARCH-WITNESS-EXTENSION
+
+  // The bridge accepts an arbitrary continuation and does not preserve the
+  // loop's writes to count/value/item. For conceptual input [1], this closure
+  // should return count=1 after the real loop, but the bridge skips the loop
+  // and leaves the pre-loop count=99.
+  claim
+    <k> Call(Name("observe"), list(oneSeq), .Exprs) => 99 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "observe" |-> closureVal(
+               "lst", .ParamNames,
+               Assign(Name("result"), UnaryOp("-", Int(1)))
+               Assign(Name("count"), Int(99))
+               For(Name("value"), Name("lst"), #outerBody)
+               Return(Name("count")) .Stmts,
+               0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/69-search/04_bridge_context_witness.py b//tmp/audit-work/69-search/04_bridge_context_witness.py
new file mode 100644
index 0000000000000000000000000000000000000000..000dbc604101ee230c6ebbb364332fa24603f2b2
--- /dev/null
+++ b//tmp/audit-work/69-search/04_bridge_context_witness.py
@@ -0,0 +1,15 @@
+def observe(lst):
+    result = -1
+    count = 99
+    for value in lst:
+        count = 0
+        for item in lst:
+            if item == value:
+                count += 1
+        if count >= value:
+            if value > result:
+                result = value
+    return count
+
+
+assert observe([1]) == 1
