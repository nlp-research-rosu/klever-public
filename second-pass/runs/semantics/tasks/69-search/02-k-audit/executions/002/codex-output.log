     1	def search(lst):
     2	    result = -1
     3	    for value in lst:
     4	        count = 0
     5	        for item in lst:
     6	            if item == value:
     7	                count += 1
     8	        if count >= value:
     9	            if value > result:
    10	                result = value
    11	    return result
END /candidate/solution.py
