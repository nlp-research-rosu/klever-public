     6	def search(lst):
     7	    '''
     8	    You are given a non-empty list of positive integers. Return the greatest integer that is greater than 
     9	    zero, and has a frequency greater than or equal to the value of the integer itself. 
    10	    The frequency of an integer is the number of times it appears in the list.
    11	    If no such a value exist, return -1.
    12	    Examples:
    13	        search([4, 1, 2, 2, 3, 1]) == 2
    14	        search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3
    15	        search([5, 5, 4, 4, 4]) == -1
    16	    '''
    17	    frq = [0] * (max(lst) + 1)
    18	    for i in lst:
    19	        frq[i] += 1;
    20	
    21	    ans = -1
    22	    for i in range(1, len(frq)):
    23	        if frq[i] >= i:
    24	            ans = i
    25	    
    26	    return ans
