index 0000000000000000000000000000000000000000..199018daf7c494635659aeb798d5e73366868e96
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def search(lst):
+    result = -1
+    for value in lst:
+        count = 0
+        for item in lst:
+            if item == value:
+                count += 1
+        if count >= value:
+            if value > result:
+                result = value
+    return result
