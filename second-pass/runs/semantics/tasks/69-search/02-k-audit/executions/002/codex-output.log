@@ -0,0 +1,15 @@
+def observe(lst):
+    result = -1
+    count = 99
+    for value in lst:
+        count = 0
+        for item in lst:
+            if item == value:
+                count += 1
+        if count >= value:
+            if value > result:
+                result = value
+    return count
+
+
+assert observe([1]) == 1
