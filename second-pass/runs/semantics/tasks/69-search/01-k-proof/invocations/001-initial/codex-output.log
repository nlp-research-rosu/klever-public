+             "search" |-> closureVal(
+               "lst" , .ParamNames,
+               Assign(Name("result"), UnaryOp("-", Int(1)))
+               For(Name("value"), Name("lst"),
+                 Assign(Name("count"), Int(0))
+                 For(Name("item"), Name("lst"),
+                   If(Compare(Name("item"),
+                              CmpOp("!=", Name("value"))),
+                      AugAssign(Name("count"), "+", Int(1)) .Stmts,
+                      .Stmts) .Stmts)
+                 If(Compare(Name("count"),
+                            CmpOp(">=", Name("value"))),
