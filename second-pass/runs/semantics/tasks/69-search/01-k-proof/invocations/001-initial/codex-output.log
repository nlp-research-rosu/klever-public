diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..6d6f618b1efbaaf029ffe25e370e291cdc04f5a0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,63 @@
+requires "verification.k"
+
+module SEARCH-SPEC
+  imports SEARCH-VERIFICATION
+
+  // Inner-loop invariant: starting with count C, iterating over ITEMS produces
+  // exactly runInner(M, X, ITEMS).
+  claim
+    <k> For(Name("item"), list(ITEMS:IntValSeq), #innerBody)
+         ~> K:K
+      => K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(M:Map => runInner(M, X, ITEMS), P:Parent) ...
+    </scopes>
+    requires "value" in_keys(M)
+     andBool "count" in_keys(M)
+     andBool {M["value"]}:>Int ==Int X:Int
+     andBool isInt({M["count"]}:>Val)
+
+  // Outer-loop invariant: every candidate is counted in ALL and folded into
+  // result, while the exact Python local-variable state is retained.
+  claim
+    <k> For(Name("value"), list(ITEMS:IntValSeq), #outerBody)
+         ~> K:K
+      => K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(M:Map => runOuter(M, ALL, ITEMS), P:Parent) ...
+    </scopes>
+    requires "lst" in_keys(M)
+     andBool "result" in_keys(M)
+     andBool {M["lst"]}:>Val ==K list(ALL:IntValSeq)
+     andBool isInt({M["result"]}:>Val)
+
+  // Entry-point theorem.  The non-empty/positive assumptions are precisely
+  // the HumanEval precondition; the result is the declarative contract fold.
+  claim
+    <k> Call(Name("search"), list(ALL:IntValSeq), .Exprs)
+      => greatestFreq(ALL)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "search" |-> closureVal(
+               "lst" , .ParamNames,
+               #searchBody,
+               0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires ALL =/=K .ValSeq
+     andBool allPositive(ALL)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0bebb430bfce727c00d014297ce33d65434450f9
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,101 @@
+requires "reference-semantics/semantics.k"
+
+module SEARCH-VERIFICATION
+  imports MPY
+
+  // The exact statement blocks emitted from solution.py.  Naming them keeps
+  // the loop invariants in spec.k readable; these are syntax macros only.
+  syntax Stmts ::= "#innerBody" [macro]
+  rule #innerBody
+    => If(Compare(Name("item"), CmpOp("==", Name("value"))),
+          AugAssign(Name("count"), "+", Int(1)) .Stmts,
+          .Stmts) .Stmts
+
+  syntax Stmts ::= "#outerBody" [macro]
+  rule #outerBody
+    => Assign(Name("count"), Int(0))
+       For(Name("item"), Name("lst"), #innerBody)
+       If(Compare(Name("count"), CmpOp(">=", Name("value"))),
+          If(Compare(Name("value"), CmpOp(">", Name("result"))),
+             Assign(Name("result"), Name("value")) .Stmts,
+             .Stmts) .Stmts,
+          .Stmts) .Stmts
+
+  syntax Stmts ::= "#searchBody" [macro]
+  rule #searchBody
+    => Assign(Name("result"), UnaryOp("-", Int(1)))
+       For(Name("value"), Name("lst"), #outerBody)
+       Return(Name("result")) .Stmts
+
+  // A refinement sort using the *same* ValSeq constructors gives symbolic
+  // inputs an Int-only constructor induction principle without a conversion
+  // wrapper that would obscure list iteration.
+  syntax IntValSeq ::= ".ValSeq" | vCons(Int, IntValSeq)
+  syntax ValSeq ::= IntValSeq
+
+  syntax Bool ::= allPositive(IntValSeq) [function, total]
+  rule allPositive(.ValSeq) => true
+  rule allPositive(vCons(X:Int, XS:IntValSeq))
+    => X >Int 0 andBool allPositive(XS)
+
+  // Mathematical frequency and contract result.  greatestFreq folds over the
+  // original list, retaining exactly the largest positive X whose occurrence
+  // count in the complete list is at least X.
+  syntax Int ::= frequency(Int, IntValSeq) [function, total]
+  rule frequency(_:Int, .ValSeq) => 0
+  rule frequency(X:Int, vCons(Y:Int, YS:IntValSeq))
+    => (#if X ==Int Y #then 1 #else 0 #fi) +Int frequency(X, YS)
+
+  syntax Int ::= chooseFreq(Int, IntValSeq, Int) [function, total]
+  rule chooseFreq(X:Int, ALL:IntValSeq, BEST:Int) => X
+    requires X >Int 0
+     andBool frequency(X, ALL) >=Int X
+     andBool X >Int BEST
+  rule chooseFreq(X:Int, ALL:IntValSeq, BEST:Int) => BEST
+    requires notBool (X >Int 0
+              andBool frequency(X, ALL) >=Int X
+              andBool X >Int BEST)
+
+  syntax Int ::= greatestFreq(IntValSeq) [function, total]
+               | greatestFreqFrom(IntValSeq, IntValSeq, Int) [function, total]
+  rule greatestFreq(ALL:IntValSeq)
+    => greatestFreqFrom(ALL, ALL, -1)
+  rule greatestFreqFrom(.ValSeq, _:IntValSeq, BEST:Int) => BEST
+  rule greatestFreqFrom(vCons(X:Int, XS:IntValSeq), ALL:IntValSeq, BEST:Int)
+    => greatestFreqFrom(XS, ALL, chooseFreq(X, ALL, BEST))
+
+  // Exact state transformers used as the two loop invariants.  They retain
+  // dead loop variables as real Python execution does, not merely the result.
+  syntax Map ::= innerStep(Map, Int, Int) [function, total]
+  rule innerStep(M:Map, X:Int, Y:Int)
+    => M [ "item" <- Y ]
+         [ "count" <- {M["count"]}:>Int +Int 1 ]
+    requires Y ==Int X
+  rule innerStep(M:Map, X:Int, Y:Int)
+    => M [ "item" <- Y ]
+    requires Y =/=Int X
+
+  syntax Map ::= runInner(Map, Int, IntValSeq) [function, total]
+  rule runInner(M:Map, _:Int, .ValSeq) => M
+  rule runInner(M:Map, X:Int, vCons(Y:Int, YS:IntValSeq))
+    => runInner(innerStep(M, X, Y), X, YS)
+
+  syntax Map ::= finishCandidate(Map, Int) [function, total]
+  rule finishCandidate(M:Map, X:Int)
+    => M [ "result" <- X ]
+    requires {M["count"]}:>Int >=Int X
+     andBool X >Int {M["result"]}:>Int
+  rule finishCandidate(M:Map, X:Int) => M
+    requires notBool ({M["count"]}:>Int >=Int X
+              andBool X >Int {M["result"]}:>Int)
+
+  syntax Map ::= runOuter(Map, IntValSeq, IntValSeq) [function, total]
+  rule runOuter(M:Map, _:IntValSeq, .ValSeq) => M
+  rule runOuter(M:Map, ALL:IntValSeq, vCons(X:Int, XS:IntValSeq))
+    => runOuter(
+         finishCandidate(
+           runInner(M [ "value" <- X ] [ "count" <- 0 ], X, ALL),
+           X),
+         ALL,
+         XS)
+endmodule

