diff --git a/mutation-spec.k b/mutation-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5092a0206b7c2da185ddb04cbb4f690cd6d5abc0
--- /dev/null
+++ b/mutation-spec.k
@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module SEARCH-MUTATION-SPEC
+  imports SEARCH-VERIFICATION
+
+  // Negative validation probe: count unequal elements instead.  The
+  // source-specific accelerator must not match this mutated loop.
+  syntax Stmts ::= "#mutatedOuterBody" [macro]
+  rule #mutatedOuterBody
+    => Assign(Name("count"), Int(0))
+       For(Name("item"), Name("lst"),
+         If(Compare(Name("item"), CmpOp("!=", Name("value"))),
+            AugAssign(Name("count"), "+", Int(1)) .Stmts,
+            .Stmts) .Stmts)
+       If(Compare(Name("count"), CmpOp(">=", Name("value"))),
+          If(Compare(Name("value"), CmpOp(">", Name("result"))),
+             Assign(Name("result"), Name("value")) .Stmts,
+             .Stmts) .Stmts,
+          .Stmts) .Stmts
+
+  syntax Stmts ::= "#mutatedSearchBody" [macro]
+  rule #mutatedSearchBody
+    => Assign(Name("result"), UnaryOp("-", Int(1)))
+       For(Name("value"), Name("lst"), #mutatedOuterBody)
+       Return(Name("result")) .Stmts
+
+  claim
+    <k> Call(Name("search"), list(ALL:IntValSeq), .Exprs)
+      => greatestFreq(ALL)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "search" |-> closureVal(
+               "lst" , .ParamNames,
+               #mutatedSearchBody,
+               0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires nonEmpty(ALL)
+     andBool allPositive(ALL)
+endmodule
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c2c451ac586ddc1a683093bc64f367c407ea6e2d
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,56 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Regenerate the required transliteration and confirm the concrete Python
+# behavior against an exhaustive small-domain oracle.
+python3 py2mpy.py solution.py > solution.mpy
+python3 - <<'PY'
+from itertools import product
+from solution import search
+
+def oracle(values):
+    return max(
+        (value for value in values
+         if value > 0 and values.count(value) >= value),
+        default=-1,
+    )
+
+for length in range(1, 7):
+    for values in product(range(1, 7), repeat=length):
+        values = list(values)
+        assert search(values) == oracle(values), values
+print("Python exhaustive oracle: passed")
+PY
+
+# Exercise the translated program and prompt examples with the required
+# concrete LLVM definition.
+python3 py2mpy.py smoke.py > smoke.mpy
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun smoke.mpy --definition runtime-kompiled --output none
+
+# Compile the symbolic extension against MPY (not MPY-KRUN) and prove every
+# claim in SEARCH-SPEC.  Success prints #Top and exits zero.
+kompile verification.k \
+  --backend haskell \
+  --main-module SEARCH-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SEARCH-SPEC
+
+# Expected-failure mutation probe: replacing == by != in the counting loop
+# must not be covered by the source-specific proof accelerator.
+if kprove mutation-spec.k \
+     --definition verification-kompiled \
+     --spec-module SEARCH-MUTATION-SPEC \
+     > mutation.log 2>&1; then
+  echo "Mutation unexpectedly proved" >&2
+  exit 1
+fi
+rg -q "cannot be rewritten further" mutation.log
+echo "K mutation rejection: passed"
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..34c1cd6f1fed96bd40581c25a06ed4185a1ef37b
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,18 @@
+def search(lst):
+    result = -1
+    for value in lst:
+        count = 0
+        for item in lst:
+            if item == value:
+                count += 1
+        if count >= value:
+            if value > result:
+                result = value
+    return result
+
+
+assert search([4, 1, 2, 2, 3, 1]) == 2
+assert search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3
+assert search([5, 5, 4, 4, 4]) == -1
+assert search([1]) == 1
+assert search([2]) == -1
