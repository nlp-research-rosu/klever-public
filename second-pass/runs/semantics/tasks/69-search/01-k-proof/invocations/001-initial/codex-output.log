+requires "verification.k"
+
+module SEARCH-SPEC
+  imports SEARCH-VERIFICATION
+
+  // Inner-loop invariant: starting with count C, iterating over ITEMS produces
+  // exactly runInner(M, X, ITEMS).
+  claim
+    <k> For(Name("item"), list(intVals(ITEMS:IntSeq)), #innerBody)
+         ~> K:K
+      => K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(M:Map => runInner(M, X, ITEMS), P:Parent) ...
+    </scopes>
+    requires "value" in_keys(M)
+     andBool "count" in_keys(M)
+     andBool {M["value"]}:>Int ==Int X:Int
+     andBool isInt({M["count"]}:>Val)
+
+  // Outer-loop invariant: every candidate is counted in ALL and folded into
+  // result, while the exact Python local-variable state is retained.
+  claim
+    <k> For(Name("value"), list(intVals(ITEMS:IntSeq)), #outerBody)
+         ~> K:K
+      => K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(M:Map => runOuter(M, ALL, ITEMS), P:Parent) ...
+    </scopes>
+    requires "lst" in_keys(M)
+     andBool "result" in_keys(M)
+     andBool {M["lst"]}:>Val ==K list(intVals(ALL:IntSeq))
+     andBool isInt({M["result"]}:>Val)
+
+  // Entry-point theorem.  The non-empty/positive assumptions are precisely
+  // the HumanEval precondition; the result is the declarative contract fold.
+  claim
+    <k> Call(Name("search"), list(intVals(ALL:IntSeq)), .Exprs)
+      => greatestFreq(ALL)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "search" |-> closureVal(
+               "lst" , .ParamNames,
+               #searchBody,
+               0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires ALL =/=K .IntSeq
+     andBool allPositive(ALL)
+endmodule
