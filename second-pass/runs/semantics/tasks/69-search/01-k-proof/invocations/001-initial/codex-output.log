diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..570724219c42c868335d2882627549363b8c7658
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,101 @@
+requires "reference-semantics/semantics.k"
+
+module SEARCH-VERIFICATION
+  imports MPY
+
+  // The exact statement blocks emitted from solution.py.  Naming them keeps
+  // the loop invariants in spec.k readable; these are syntax macros only.
+  syntax Stmts ::= "#innerBody" [macro]
+  rule #innerBody
+    => If(Compare(Name("item"), CmpOp("==", Name("value"))),
+          AugAssign(Name("count"), "+", Int(1)) .Stmts,
+          .Stmts) .Stmts
+
+  syntax Stmts ::= "#outerBody" [macro]
+  rule #outerBody
+    => Assign(Name("count"), Int(0))
+       For(Name("item"), Name("lst"), #innerBody)
+       If(Compare(Name("count"), CmpOp(">=", Name("value"))),
+          If(Compare(Name("value"), CmpOp(">", Name("result"))),
+             Assign(Name("result"), Name("value")) .Stmts,
+             .Stmts) .Stmts,
+          .Stmts) .Stmts
+
+  syntax Stmts ::= "#searchBody" [macro]
+  rule #searchBody
+    => Assign(Name("result"), UnaryOp("-", Int(1)))
+       For(Name("value"), Name("lst"), #outerBody)
+       Return(Name("result")) .Stmts
+
+  // Symbolic inputs are represented as Python ValSeqs built only from Ints.
+  // IntSeq gives the prover a constructor induction principle for that domain.
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  rule intVals(.IntSeq) => .ValSeq
+  rule intVals(iCons(X:Int, XS:IntSeq)) => vCons(X, intVals(XS))
+
+  syntax Bool ::= allPositive(IntSeq) [function, total]
+  rule allPositive(.IntSeq) => true
+  rule allPositive(iCons(X:Int, XS:IntSeq))
+    => X >Int 0 andBool allPositive(XS)
+
+  // Mathematical frequency and contract result.  greatestFreq folds over the
+  // original list, retaining exactly the largest positive X whose occurrence
+  // count in the complete list is at least X.
+  syntax Int ::= frequency(Int, IntSeq) [function, total]
+  rule frequency(_:Int, .IntSeq) => 0
+  rule frequency(X:Int, iCons(Y:Int, YS:IntSeq))
+    => (#if X ==Int Y #then 1 #else 0 #fi) +Int frequency(X, YS)
+
+  syntax Int ::= chooseFreq(Int, IntSeq, Int) [function, total]
+  rule chooseFreq(X:Int, ALL:IntSeq, BEST:Int) => X
+    requires X >Int 0
+     andBool frequency(X, ALL) >=Int X
+     andBool X >Int BEST
+  rule chooseFreq(X:Int, ALL:IntSeq, BEST:Int) => BEST
+    requires notBool (X >Int 0
+              andBool frequency(X, ALL) >=Int X
+              andBool X >Int BEST)
+
+  syntax Int ::= greatestFreq(IntSeq) [function, total]
+               | greatestFreqFrom(IntSeq, IntSeq, Int) [function, total]
+  rule greatestFreq(ALL:IntSeq)
+    => greatestFreqFrom(ALL, ALL, -1)
+  rule greatestFreqFrom(.IntSeq, _:IntSeq, BEST:Int) => BEST
+  rule greatestFreqFrom(iCons(X:Int, XS:IntSeq), ALL:IntSeq, BEST:Int)
+    => greatestFreqFrom(XS, ALL, chooseFreq(X, ALL, BEST))
+
+  // Exact state transformers used as the two loop invariants.  They retain
+  // dead loop variables as real Python execution does, not merely the result.
+  syntax Map ::= innerStep(Map, Int, Int) [function, total]
+  rule innerStep(M:Map, X:Int, Y:Int)
+    => M [ "item" <- Y ]
+         [ "count" <- {M["count"]}:>Int +Int 1 ]
+    requires Y ==Int X
+  rule innerStep(M:Map, X:Int, Y:Int)
+    => M [ "item" <- Y ]
+    requires Y =/=Int X
+
+  syntax Map ::= runInner(Map, Int, IntSeq) [function, total]
+  rule runInner(M:Map, _:Int, .IntSeq) => M
+  rule runInner(M:Map, X:Int, iCons(Y:Int, YS:IntSeq))
+    => runInner(innerStep(M, X, Y), X, YS)
+
+  syntax Map ::= finishCandidate(Map, Int) [function, total]
+  rule finishCandidate(M:Map, X:Int)
+    => M [ "result" <- X ]
+    requires {M["count"]}:>Int >=Int X
+     andBool X >Int {M["result"]}:>Int
+  rule finishCandidate(M:Map, X:Int) => M
+    requires notBool ({M["count"]}:>Int >=Int X
+              andBool X >Int {M["result"]}:>Int)
+
+  syntax Map ::= runOuter(Map, IntSeq, IntSeq) [function, total]
+  rule runOuter(M:Map, _:IntSeq, .IntSeq) => M
+  rule runOuter(M:Map, ALL:IntSeq, iCons(X:Int, XS:IntSeq))
+    => runOuter(
+         finishCandidate(
+           runInner(M [ "value" <- X ] [ "count" <- 0 ], X, ALL),
+           X),
+         ALL,
+         XS)
+endmodule

apply patch
patch: completed
/work/spec.k
/work/verification.k
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..34c1cd6f1fed96bd40581c25a06ed4185a1ef37b
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,18 @@
+def search(lst):
+    result = -1
+    for value in lst:
+        count = 0
+        for item in lst:
+            if item == value:
+                count += 1
+        if count >= value:
+            if value > result:
+                result = value
+    return result
+
+
+assert search([4, 1, 2, 2, 3, 1]) == 2
+assert search([1, 2, 2, 3, 3, 3, 4, 4, 4]) == 3
+assert search([5, 5, 4, 4, 4]) == -1
+assert search([1]) == 1
+assert search([2]) == -1
