Module(
  FuncDef("search", Params("lst"),
    Assign(Name("result"), UnaryOp("-", Int(1)))
    For(Name("value"), Name("lst"),
      Assign(Name("count"), Int(0))
      For(Name("item"), Name("lst"),
        If(Compare(Name("item"), CmpOp("==", Name("value"))),
          AugAssign(Name("count"), "+", Int(1)),
          ))
      If(Compare(Name("count"), CmpOp(">=", Name("value"))),
        If(Compare(Name("value"), CmpOp(">", Name("result"))),
          Assign(Name("result"), Name("value")),
          ),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("search"),
        ListExpr(Int(4), Int(1), Int(2), Int(2), Int(3), Int(1))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(
        Name("search"),
        ListExpr(
          Int(1),
          Int(2),
          Int(2),
          Int(3),
          Int(3),
          Int(3),
          Int(4),
          Int(4),
          Int(4))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("search"),
        ListExpr(Int(5), Int(5), Int(4), Int(4), Int(4))),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(Call(Name("search"), ListExpr(Int(1))), CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("search"), ListExpr(Int(2))),
      CmpOp("==", UnaryOp("-", Int(1))))))
