+]
+obligation_ids = [
+    obligation["source_rule_id"]
+    for obligation in obligation_map["obligations"]
+]
+
+raw_target_count = 0
+for path in GENERATED.rglob("*.lean"):
+    raw_target_count += len(
+        re.findall(r"(?m)^\s*def\s+targetStatement\b", path.read_text())
