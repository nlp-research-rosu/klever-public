+]
+mapped_source_ids = [
+    rule["source_rule_id"] for rule in obligation_map["source_rules"]
+]
+obligation_ids = [
+    obligation["source_rule_id"]
+    for obligation in obligation_map["obligations"]
+]
+
+raw_target_count = 0
+for path in GENERATED.rglob("*.lean"):
