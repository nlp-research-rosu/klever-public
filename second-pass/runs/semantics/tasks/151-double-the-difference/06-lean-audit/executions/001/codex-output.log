+obligation_map = load_json(GENERATED / "obligation-map.json")
+toolchain_lock = load_json(Path("/reference/klean-toolchain.lock.json"))
+
+discovery_hash = sha256_file(DISCOVERY)
+domain_rules = generation_time._domain_source_rules(
+    validated, discovery_hash
+)
+resolution = generation_time.resolve_definition_closure(K_WORKSPACE)
+_module, functions = generation_time.parse_verification(
+    (K_WORKSPACE / "verification.k").read_text()
+)
+summary_functions = [
+    {
+        "name": function.name,
+        "return_sort": function.ret,
+        "argument_sorts": function.args,
+    }
+    for function in functions
+]
+
+expected_relative_k_files = [
+    path.relative_to(K_WORKSPACE).as_posix()
+    for path in resolution.required_files
+]
+recorded_relative_k_files = [
+    Path(path).relative_to("/frozen-k").as_posix()
+    for path in input_manifest["required_k_files"]
+]
+
+expected_input = {
+    "schema_version": 3,
+    "problem": "151-double-the-difference",
+    "frozen_input_sha256": generation_time.tree_digest(K_WORKSPACE),
+    "stage1_workspace_sha256": generation_time.tree_digest(K_WORKSPACE),
+    "stage3_discovery_manifest_sha256": discovery_hash,
+    "verification_sha256": sha256_file(K_WORKSPACE / "verification.k"),
+    "verification_module": validated["verification_module"],
+    "syntax_module": resolution.syntax_module,
+    "required_k_files": input_manifest["required_k_files"],
+    "inventory_sha256": validated["inventory_sha256"],
+    "summary_functions": summary_functions,
+    "definitions": validated["definitions"],
+    "operational_rules": validated["operational_rules"],
+    "proved_derived_lemmas": validated["proved_derived_lemmas"],
+    "source_rules": domain_rules,
+}
+
+source_ids = [rule["source_rule_id"] for rule in domain_rules]
+input_ids = [
