+    "k_audit_sha256": sha256_tree(K_AUDIT),
+    "k_workspace_sha256": sha256_tree(K_WORKSPACE),
+    "klean_generation_sha256": sha256_tree(GENERATION),
+    "stage1_export_sha256": tree_digest(K_WORKSPACE),
+}
+comparisons = {
