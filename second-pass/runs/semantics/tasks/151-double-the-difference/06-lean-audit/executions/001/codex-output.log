+    "rule-e3614434272e9b2b42c9f7e8e025e452ff48db3166ba2b7bfe20ec595fc92069": {
+        "classification": "DEFINITION",
+        "judgment": (
+            "Defining equation for the named total summary oddSquare. Its "
