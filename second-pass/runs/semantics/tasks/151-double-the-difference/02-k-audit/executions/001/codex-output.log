+                    Name("int")),
+                  Compare(
+                    Name("number"),
+                    CmpOp(">", Int(0))),
+                  Compare(
+                    BinOp("%", Name("number"), Int(2)),
+                    CmpOp("==", Int(1)))),
+                AugAssign(
+                  Name("total"),
+                  "+",
+                  BinOp("**", Name("number"), Int(2))),
+                .Stmts))
+            Return(Name("total")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
