+                    BinOp("%", Name("number"), Int(2)),
+                    CmpOp("==", Int(1)))),
+                AugAssign(
+                  Name("total"),
+                  "+",
+                  BinOp("**", Name("number"), Int(2))),
+                .Stmts))
+            Return(Name("total")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
