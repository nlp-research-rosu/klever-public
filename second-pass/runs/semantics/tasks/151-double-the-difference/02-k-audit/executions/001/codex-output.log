@@ -0,0 +1,56 @@
+requires "verification.k"
+
+module AUDIT-BODY-SENSITIVITY
+  imports DOUBLE-THE-DIFFERENCE-VERIFICATION
+
+  // The executed closure is materially mutated: exponent 2 -> 3.
+  // For [1, 3], the real mutated result is 28, not the original result 10.
+  claim [cube-body-must-not-prove-square-result]:
+    <k>
+      Call(
+        Name("double_the_difference"),
+        list(numVals(iNum(1, iNum(3, .NumSeq)))))
+      => 10
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "double_the_difference" |->
+          closureVal(
+            "lst",
+            Assign(Name("total"), Int(0))
+            Assign(Name("number"), Int(0))
+            For(
+              Name("number"),
+              Name("lst"),
+              If(
+                BoolOp(
+                  "and",
+                  Call(
+                    Name("isinstance"),
+                    Name("number"),
+                    Name("int")),
+                  Compare(
+                    Name("number"),
+                    CmpOp(">", Int(0))),
+                  Compare(
+                    BinOp("%", Name("number"), Int(2)),
+                    CmpOp("==", Int(1)))),
+                AugAssign(
+                  Name("total"),
+                  "+",
+                  BinOp("**", Name("number"), Int(3))),
+                .Stmts))
+            Return(Name("total")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-standard-list-witness.k b//tmp/audit-work/reconstruction/audit-standard-list-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..0e2e1d70922bbc3511036cd8e184512652250629
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-standard-list-witness.k
@@ -0,0 +1,61 @@
+requires "verification.k"
+
+module AUDIT-STANDARD-LIST-WITNESS
+  imports DOUBLE-THE-DIFFERENCE-VERIFICATION
+
+  // Same mixed sequence as audit-witness.k, now represented with the fixed
+  // semantics' ordinary .ValSeq/vCons constructors rather than numVals.
+  claim [entry-standard-list-witness]:
+    <k>
+      Call(
+        Name("double_the_difference"),
+        list(
+          vCons(3.0,
+          vCons(3,
+          vCons(-5,
+          vCons(2.5,
+          vCons(7, .ValSeq)))))))
+      => 58
+    </k>
+    <env> 0 </env>
