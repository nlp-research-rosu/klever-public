diff --git a//tmp/audit-work/reconstruction/concrete-audit.py b//tmp/audit-work/reconstruction/concrete-audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..6f14e6f78d688daba74731aa12e3606c5780e054
--- /dev/null
+++ b//tmp/audit-work/reconstruction/concrete-audit.py
@@ -0,0 +1,18 @@
+def double_the_difference(lst):
+    total = 0
+    number = 0
+    for number in lst:
+        if isinstance(number, int) and number > 0 and number % 2 == 1:
+            total += number ** 2
+    return total
+
+
+assert double_the_difference([1, 3, 2, 0]) == 10
+assert double_the_difference([-1, -2, 0]) == 0
+assert double_the_difference([9, -2]) == 81
+assert double_the_difference([0]) == 0
+assert double_the_difference([]) == 0
+assert double_the_difference([-3, -2, -1, 0, 1, 2, 3]) == 10
+assert double_the_difference([-3.0, -2.0, -1.0, 0.0, 1.0, 2.0, 3.0]) == 0
+assert double_the_difference([3.0, 3, -5, 2.5, 7]) == 58
+assert double_the_difference([100000000000000000001]) == 10000000000000000000200000000000000000001
