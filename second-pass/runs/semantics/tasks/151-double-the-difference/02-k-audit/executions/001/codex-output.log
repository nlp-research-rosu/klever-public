+#!/usr/bin/env python3
+import collections
+import json
+from pathlib import Path
+
+
+TRACE = Path(
+    "/generation-evidence/codex-trace/2026/07/26/"
+    "rollout-2026-07-26T03-06-58-019f9d76-8573-7e33-a377-c0ff76387c31.jsonl"
+)
+RAW_LOG = Path("/generation-evidence/codex-output.log")
+
+
+def main() -> None:
