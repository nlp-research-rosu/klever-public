+#!/usr/bin/env bash
+set -o pipefail
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  command_status=$?
+  printf 'EXIT_STATUS: %s\n' "$command_status"
+  exit "$command_status"
+} 2>&1 | tee "$log_path"
+exit "${PIPESTATUS[0]}"

