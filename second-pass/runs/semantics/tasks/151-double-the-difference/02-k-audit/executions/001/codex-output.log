+        list(numVals(
+          fNum(3.0,
+          iNum(3,
+          iNum(-5,
+          fNum(2.5,
+          iNum(7, .NumSeq))))))))
+      => 58
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "double_the_difference" |->
+          closureVal(
+            "lst",
+            Assign(Name("total"), Int(0))
+            Assign(Name("number"), Int(0))
+            For(
+              Name("number"),
+              Name("lst"),
+              If(
+                BoolOp(
+                  "and",
+                  Call(
+                    Name("isinstance"),
