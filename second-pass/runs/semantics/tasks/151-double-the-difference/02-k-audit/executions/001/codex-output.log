+
+
+def tree_records(root: Path) -> list[tuple[str, str, int, str]]:
+    records = []
+    for path in sorted([root, *root.rglob("*")], key=lambda p: str(p.relative_to(root))):
+        rel = "." if path == root else str(path.relative_to(root))
