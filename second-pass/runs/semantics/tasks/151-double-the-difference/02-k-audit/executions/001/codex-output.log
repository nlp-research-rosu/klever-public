+    print(
+        f"RAW_LOG bytes={len(raw)} lines={raw.count(bytes([10]))} "
+        f"nul_bytes={raw.count(bytes([0]))} decoded_utf8={bool(raw.decode('utf-8'))}"
+    )
+
+
+if __name__ == "__main__":
+    main()
