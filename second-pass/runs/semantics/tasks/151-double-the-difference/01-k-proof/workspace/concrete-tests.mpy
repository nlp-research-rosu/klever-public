Module(
  FuncDef("double_the_difference", Params("lst"),
    Assign(Name("total"), Int(0))
    Assign(Name("number"), Int(0))
    For(Name("number"), Name("lst"),
      If(BoolOp(
        "and",
        Call(Name("isinstance"), Name("number"), Name("int")),
        Compare(Name("number"), CmpOp(">", Int(0))),
        Compare(BinOp("%", Name("number"), Int(2)), CmpOp("==", Int(1)))),
        AugAssign(
          Name("total"),
          "+",
          BinOp("**", Name("number"), Int(2))),
        ))
    Return(Name("total")))
  Assert(
    Compare(
      Call(
        Name("double_the_difference"),
        ListExpr(Int(1), Int(3), Int(2), Int(0))),
      CmpOp("==", Int(10))))
  Assert(
    Compare(
      Call(
        Name("double_the_difference"),
        ListExpr(UnaryOp("-", Int(1)), UnaryOp("-", Int(2)), Int(0))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("double_the_difference"),
        ListExpr(Int(9), UnaryOp("-", Int(2)))),
      CmpOp("==", Int(81))))
  Assert(
    Compare(
      Call(Name("double_the_difference"), ListExpr(Int(0))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("double_the_difference"), ListExpr()),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("double_the_difference"),
        ListExpr(
          Float(3.0),
          Int(3),
          UnaryOp("-", Int(5)),
          Float(2.5),
          Int(7))),
      CmpOp("==", Int(58)))))
