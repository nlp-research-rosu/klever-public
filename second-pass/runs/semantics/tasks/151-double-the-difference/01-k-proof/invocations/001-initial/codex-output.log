diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..75acc610408dfd5d6b093d227022d8345807403b
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,15 @@
+def double_the_difference(lst):
+    total = 0
+    number = 0
+    for number in lst:
+        if isinstance(number, int) and number > 0 and number % 2 == 1:
+            total += number ** 2
+    return total
+
+
+assert double_the_difference([1, 3, 2, 0]) == 10
+assert double_the_difference([-1, -2, 0]) == 0
+assert double_the_difference([9, -2]) == 81
+assert double_the_difference([0]) == 0
+assert double_the_difference([]) == 0
+assert double_the_difference([3.0, 3, -5, 2.5, 7]) == 58
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..812452e7906c0795e34c35a9707bc672d9db34dd
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Translate the submitted implementation with the fixed front end.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Build and run concrete assertions with the required LLVM main module.
+python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun concrete-tests.mpy --definition runtime-kompiled
+
+# Build the symbolic extension over MPY (not MPY-KRUN) and prove every claim.
+kompile verification.k \
+  --backend haskell \
+  --main-module DOUBLE-THE-DIFFERENCE-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module DOUBLE-THE-DIFFERENCE-SPEC
