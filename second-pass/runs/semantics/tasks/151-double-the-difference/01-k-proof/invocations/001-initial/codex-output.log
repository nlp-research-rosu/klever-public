diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..48354c8d3f53751a7e752a02ea2aeb19626e32a7
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,96 @@
+requires "verification.k"
+
+module DOUBLE-THE-DIFFERENCE-SPEC
+  imports DOUBLE-THE-DIFFERENCE-VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        list(numVals(NUMBERS)),
+        Name("number"),
+        If(
+          BoolOp(
+            "and",
+            Call(
+              Name("isinstance"),
+              Name("number"),
+              Name("int")),
+            Compare(
+              Name("number"),
+              CmpOp(">", Int(0))),
+            Compare(
+              BinOp("%", Name("number"), Int(2)),
+              CmpOp("==", Int(1)))),
+          AugAssign(
+            Name("total"),
+            "+",
+            BinOp("**", Name("number"), Int(2))),
+          .Stmts))
+      ~> CONT
+    =>
+      CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "lst" |-> _INPUT
+        "total" |->
+          (ACC => ACC +Int doubleDifferenceSpec(NUMBERS))
+        "number" |->
+          (OLDNUMBER => finalNumber(NUMBERS, OLDNUMBER)),
+        parent(0))
+      0 |-> scope(
+        "double_the_difference" |-> _FUNCTION,
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+
+  claim [double-the-difference-correct]:
+    <k>
+      Call(
+        Name("double_the_difference"),
+        list(numVals(NUMBERS)))
+      => doubleDifferenceSpec(NUMBERS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "double_the_difference" |->
+          closureVal(
+            "lst",
+            Assign(Name("total"), Int(0))
+            Assign(Name("number"), Int(0))
+            For(
+              Name("number"),
+              Name("lst"),
+              If(
+                BoolOp(
+                  "and",
+                  Call(
+                    Name("isinstance"),
+                    Name("number"),
+                    Name("int")),
+                  Compare(
+                    Name("number"),
+                    CmpOp(">", Int(0))),
+                  Compare(
+                    BinOp("%", Name("number"), Int(2)),
+                    CmpOp("==", Int(1)))),
+                AugAssign(
+                  Name("total"),
+                  "+",
+                  BinOp("**", Name("number"), Int(2))),
+                .Stmts))
+            Return(Name("total")),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e253eded4034402c6625f63de8cde385ff6104b8
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,41 @@
+requires "reference-semantics/semantics.k"
+
+module DOUBLE-THE-DIFFERENCE-VERIFICATION
+  imports MPY
+
+  // A symbolic sequence of exactly the numeric values admitted by the prompt.
+  // Keeping the Int/Float choice in the constructor lets kprove split the
+  // sequence structurally instead of treating an arbitrary Val as non-integer.
+  syntax NumSeq ::= ".NumSeq"
+                  | iNum(Int, NumSeq)
+                  | fNum(Float, NumSeq)
+
+  // numVals is a proof-domain representation of a list's ValSeq.  Its iterator
+  // rules expose the NumSeq constructor directly to symbolic narrowing.
+  syntax ValSeq ::= numVals(NumSeq)
+  rule <k> #iterNext(list(numVals(.NumSeq)))
+        => #iterDone ... </k>
+  rule <k> #iterNext(list(numVals(iNum(I, REST))))
+        => #iterYield(I, list(numVals(REST))) ... </k>
+  rule <k> #iterNext(list(numVals(fNum(F, REST))))
+        => #iterYield(F, list(numVals(REST))) ... </k>
+
+  syntax Int ::= oddSquare(Int) [function, total]
+  rule oddSquare(I)
+    => #if I >Int 0 andBool pyMod(I, 2) ==Int 1
+       #then I *Int I
+       #else 0
+       #fi
+
+  syntax Int ::= doubleDifferenceSpec(NumSeq) [function, total]
+  rule doubleDifferenceSpec(.NumSeq)       => 0
+  rule doubleDifferenceSpec(iNum(I, REST))
+    => oddSquare(I) +Int doubleDifferenceSpec(REST)
+  rule doubleDifferenceSpec(fNum(_F, REST))
+    => doubleDifferenceSpec(REST)
+
+  syntax Val ::= finalNumber(NumSeq, Val) [function, total]
+  rule finalNumber(.NumSeq, OLD)          => OLD
+  rule finalNumber(iNum(I, REST), _OLD)   => finalNumber(REST, I)
+  rule finalNumber(fNum(F, REST), _OLD)   => finalNumber(REST, F)
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..75acc610408dfd5d6b093d227022d8345807403b
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,15 @@
+def double_the_difference(lst):
+    total = 0
+    number = 0
+    for number in lst:
+        if isinstance(number, int) and number > 0 and number % 2 == 1:
+            total += number ** 2
+    return total
+
+
+assert double_the_difference([1, 3, 2, 0]) == 10
+assert double_the_difference([-1, -2, 0]) == 0
+assert double_the_difference([9, -2]) == 81
+assert double_the_difference([0]) == 0
+assert double_the_difference([]) == 0
+assert double_the_difference([3.0, 3, -5, 2.5, 7]) == 58
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..812452e7906c0795e34c35a9707bc672d9db34dd
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Translate the submitted implementation with the fixed front end.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Build and run concrete assertions with the required LLVM main module.
+python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun concrete-tests.mpy --definition runtime-kompiled
+
+# Build the symbolic extension over MPY (not MPY-KRUN) and prove every claim.
+kompile verification.k \
+  --backend haskell \
+  --main-module DOUBLE-THE-DIFFERENCE-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module DOUBLE-THE-DIFFERENCE-SPEC
