+      0  |-> scope(
+        .Map
+        => "is_equal_to_sum_even" |->
+             closureVal(
+               ("n", .ParamNames),
+               (Return(
+                  BoolOp(
+                    "and",
+                    ( Compare(Name("n"), CmpOp(">=", Int(8)))
+                    , Compare(
+                        BinOp("%", Name("n"), Int(2)),
+                        CmpOp("==", Int(0)))
+                    , .Exprs)))
+                .Stmts),
+               0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
