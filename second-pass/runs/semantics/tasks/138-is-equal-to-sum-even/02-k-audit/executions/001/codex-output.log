+#!/usr/bin/env bash
+set -uo pipefail
+
+work=/tmp/audit-work/review-138
+evidence=/audit-output/evidence
+cd "$work" || exit 99
+
+dry_log="$evidence/vacuity-dry-run.log"
+{
+  echo "WORKDIR: $PWD"
+  echo "COMMAND: kprove spec-vacuity-audit.k --definition verification-kompiled --spec-module SPEC-VACUITY-AUDIT --dry-run"
+  kprove spec-vacuity-audit.k \
+    --definition verification-kompiled \
+    --spec-module SPEC-VACUITY-AUDIT \
+    --dry-run > /dev/null
+  dry_status=$?
+  echo "OUTPUT: suppressed KORE serialization (dry-run parsing/build only)"
+  echo "EXIT_STATUS: $dry_status"
+  exit "$dry_status"
+} 2>&1 | tee "$dry_log"
+dry_status="${PIPESTATUS[0]}"
+
+prove_log="$evidence/vacuity-proof.log"
+{
+  echo "WORKDIR: $PWD"
+  echo "COMMAND: kprove spec-vacuity-audit.k --definition verification-kompiled --spec-module SPEC-VACUITY-AUDIT"
+  kprove spec-vacuity-audit.k \
+    --definition verification-kompiled \
+    --spec-module SPEC-VACUITY-AUDIT
+  prove_status=$?
+  echo "EXIT_STATUS: $prove_status"
+  exit "$prove_status"
+} 2>&1 | tee "$prove_log"
+prove_status="${PIPESTATUS[0]}"
+
+echo "DRY_RUN_STATUS: $dry_status"
+echo "PROOF_STATUS: $prove_status"
+
+if [[ "$dry_status" -ne 0 ]]; then
+  echo "AUDIT_CHECK: mutation did not build"
+  exit 1
+fi
+if [[ "$prove_status" -eq 0 ]]; then
+  echo "AUDIT_CHECK: false mutation unexpectedly proved"
+  exit 1
+fi
+if ! grep -q 'WarnStuckClaimState' "$prove_log"; then
+  echo "AUDIT_CHECK: failure was not the expected stuck claim"
+  exit 1
+fi
+
+echo "AUDIT_CHECK: expected unmet result obligation observed"
+exit 0
diff --git a/evidence/spec-body-sensitivity.k b/evidence/spec-body-sensitivity.k
new file mode 100644
index 0000000000000000000000000000000000000000..63a3981e84126079f77d42d625231239acceaf1e
--- /dev/null
+++ b/evidence/spec-body-sensitivity.k
@@ -0,0 +1,56 @@
+requires "reference-semantics/semantics.k"
+
+module SPEC-BODY-SENSITIVITY
+  imports MPY
+
+  // Deliberately mutate the threshold in the loaded function body from 8 to 9.
+  // At N=8 this mutated program returns false, so the original true obligation
+  // must no longer close.
+  claim
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "is_equal_to_sum_even",
+            Params("n"),
+            Return(
+              BoolOp(
+                "and",
+                ( Compare(Name("n"), CmpOp(">=", Int(9)))
+                , Compare(
+                    BinOp("%", Name("n"), Int(2)),
+                    CmpOp("==", Int(0)))
+                , .Exprs)))
+            .Stmts)
+          .Stmts))
+      ~> Call(Name("is_equal_to_sum_even"), (8, .Exprs))
+      => true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+        .Map
+        => "is_equal_to_sum_even" |->
+             closureVal(
+               ("n", .ParamNames),
+               (Return(
+                  BoolOp(
+                    "and",
+                    ( Compare(Name("n"), CmpOp(">=", Int(9)))
+                    , Compare(
+                        BinOp("%", Name("n"), Int(2)),
+                        CmpOp("==", Int(0)))
+                    , .Exprs)))
+                .Stmts),
+               0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/spec-fixed-real-program.k b/evidence/spec-fixed-real-program.k
new file mode 100644
index 0000000000000000000000000000000000000000..005448ab7a0526df88a0e547089ddb100bb557e4
--- /dev/null
+++ b/evidence/spec-fixed-real-program.k
@@ -0,0 +1,55 @@
+requires "reference-semantics/semantics.k"
+
+module SPEC-FIXED-REAL-PROGRAM
+  imports MPY
+
+  // Bridge-free fixed-semantics check: load the actual submitted Module/FuncDef,
+  // resolve its bound name, and call it for an arbitrary mathematical integer.
+  claim
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "is_equal_to_sum_even",
+            Params("n"),
+            Return(
+              BoolOp(
+                "and",
+                ( Compare(Name("n"), CmpOp(">=", Int(8)))
+                , Compare(
+                    BinOp("%", Name("n"), Int(2)),
+                    CmpOp("==", Int(0)))
+                , .Exprs)))
+            .Stmts)
+          .Stmts))
+      ~> Call(Name("is_equal_to_sum_even"), (N:Int, .Exprs))
+      => (N >=Int 8 andBool pyMod(N, 2) ==Int 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+        .Map
+        => "is_equal_to_sum_even" |->
+             closureVal(
+               ("n", .ParamNames),
+               (Return(
+                  BoolOp(
+                    "and",
+                    ( Compare(Name("n"), CmpOp(">=", Int(8)))
+                    , Compare(
+                        BinOp("%", Name("n"), Int(2)),
+                        CmpOp("==", Int(0)))
+                    , .Exprs)))
+                .Stmts),
+               0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/spec-vacuity-audit.k b/evidence/spec-vacuity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..9c55cb7e1038d0c42d296e420e8545c700d8b692
--- /dev/null
+++ b/evidence/spec-vacuity-audit.k
@@ -0,0 +1,22 @@
+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // Fresh false result mutation. The initial state is the ordinary entry state,
+  // N = 8 satisfies the intended domain, and the real function returns true.
+  claim
+    <k> #isEqualToSumEven(8) => false </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule

