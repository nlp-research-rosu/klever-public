+                    ( Compare(Name("n"), CmpOp(">=", Int(8)))
+                    , Compare(
+                        BinOp("%", Name("n"), Int(2)),
+                        CmpOp("==", Int(0)))
+                    , .Exprs)))
+                .Stmts),
+               0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
