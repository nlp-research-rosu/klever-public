+  kprove spec-body-sensitivity.k \
+    --definition fixed-semantics-kompiled \
+    --spec-module SPEC-BODY-SENSITIVITY \
+    --dry-run > /dev/null
+  status=$?
+  echo "OUTPUT: suppressed KORE serialization (dry-run parsing/build only)"
