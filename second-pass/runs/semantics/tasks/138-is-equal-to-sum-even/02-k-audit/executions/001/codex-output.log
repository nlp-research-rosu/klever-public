@@ -0,0 +1,9 @@
+def is_equal_to_sum_even(n):
+    return n >= 8 and n % 2 == 0
+
+
+assert is_equal_to_sum_even(-2) == False
+assert is_equal_to_sum_even(7) == False
+assert is_equal_to_sum_even(8) == True
+assert is_equal_to_sum_even(9) == False
+assert is_equal_to_sum_even(10) == True
diff --git a//tmp/audit-work/review-138/spec-fixed-real-program.k b//tmp/audit-work/review-138/spec-fixed-real-program.k
new file mode 100644
index 0000000000000000000000000000000000000000..005448ab7a0526df88a0e547089ddb100bb557e4
--- /dev/null
+++ b//tmp/audit-work/review-138/spec-fixed-real-program.k
@@ -0,0 +1,55 @@
+requires "reference-semantics/semantics.k"
+
+module SPEC-FIXED-REAL-PROGRAM
+  imports MPY
+
+  // Bridge-free fixed-semantics check: load the actual submitted Module/FuncDef,
+  // resolve its bound name, and call it for an arbitrary mathematical integer.
+  claim
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "is_equal_to_sum_even",
+            Params("n"),
+            Return(
+              BoolOp(
+                "and",
+                ( Compare(Name("n"), CmpOp(">=", Int(8)))
+                , Compare(
+                    BinOp("%", Name("n"), Int(2)),
+                    CmpOp("==", Int(0)))
+                , .Exprs)))
+            .Stmts)
+          .Stmts))
+      ~> Call(Name("is_equal_to_sum_even"), (N:Int, .Exprs))
+      => (N >=Int 8 andBool pyMod(N, 2) ==Int 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+        .Map
+        => "is_equal_to_sum_even" |->
+             closureVal(
+               ("n", .ParamNames),
+               (Return(
+                  BoolOp(
+                    "and",
+                    ( Compare(Name("n"), CmpOp(">=", Int(8)))
+                    , Compare(
+                        BinOp("%", Name("n"), Int(2)),
+                        CmpOp("==", Int(0)))
+                    , .Exprs)))
+                .Stmts),
+               0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
