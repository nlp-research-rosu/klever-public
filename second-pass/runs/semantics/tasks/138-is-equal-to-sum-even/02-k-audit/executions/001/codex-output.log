+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // Fresh false result mutation. The initial state is the ordinary entry state,
+  // N = 8 satisfies the intended domain, and the real function returns true.
+  claim
+    <k> #isEqualToSumEven(8) => false </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule

exec
/bin/bash -lc 'set +e; /audit-output/evidence/make_rule_inventory.sh > /audit-output/evidence/rule-inventory.txt; status=$?; printf '"'COMMAND: /audit-output/evidence/make_rule_inventory.sh > /audit-output/evidence/rule-inventory.txt\\nEXIT_STATUS: %s\\n' \""'$status" | tee /audit-output/evidence/rule-inventory-command.log; sed -n '"'1,80p' /audit-output/evidence/rule-inventory.txt; wc -l -c /audit-output/evidence/rule-inventory.txt; exit \""'$status"' in /audit-output
