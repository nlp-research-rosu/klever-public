+evidence=/audit-output/evidence
+cd "$work" || exit 99
+
+run_logged() {
+  local log="$1"
+  shift
+  {
+    printf 'WORKDIR: %s\n' "$PWD"
+    printf 'COMMAND:'
+    printf ' %q' "$@"
+    printf '\n'
+    "$@"
+    status=$?
+    printf 'EXIT_STATUS: %s\n' "$status"
+    exit "$status"
+  } 2>&1 | tee "$evidence/$log"
+  return "${PIPESTATUS[0]}"
+}
