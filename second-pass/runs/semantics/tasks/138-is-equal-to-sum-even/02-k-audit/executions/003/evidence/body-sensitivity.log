--- verification.k	2026-07-26 22:39:23.218393797 -0500
+++ verification-body-mutated.k	2026-07-26 22:48:14.591979124 -0500
@@ -1,14 +1,12 @@
 requires "reference-semantics/semantics.k"
 
-module VERIFICATION
+module VERIFICATION-BODY-MUTATED
   imports MPY
 
-  // Invoke the closure denoted by the sole FuncDef in solution.mpy.  Constructing
-  // the closure directly avoids leaving its module-level name binding behind in
-  // the final state; Call, argument binding, Return, and frame cleanup still run
-  // through the supplied Python semantics.
   syntax KItem ::= "#isEqualToSumEven" "(" Int ")"
 
+  // Auditor mutation: threshold 8 is materially changed to 10 in the body
+  // actually called by the claim. The original postcondition is unchanged.
   rule <k> #isEqualToSumEven(N:Int)
         => Call(
              closureVal(
@@ -16,7 +14,7 @@
                (Return(
                   BoolOp(
                     "and",
-                    ( Compare(Name("n"), CmpOp(">=", Int(8)))
+                    ( Compare(Name("n"), CmpOp(">=", Int(10)))
                     , Compare(
                         BinOp("%", Name("n"), Int(2)),
                         CmpOp("==", Int(0)))
