diff --git a/evidence/trace_summary.py b/evidence/trace_summary.py
new file mode 100644
index 0000000000000000000000000000000000000000..07222ef6a4e531f0c8009051719607a8f92ad886
--- /dev/null
+++ b/evidence/trace_summary.py
@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+"""Parse every structured generation trace record and emit a bounded summary."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import sys
