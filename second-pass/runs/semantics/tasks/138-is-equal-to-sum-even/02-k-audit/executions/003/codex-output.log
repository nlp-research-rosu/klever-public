+  'COMMAND: sha256sum regenerated-solution.mpy submitted-solution.mpy solution.py'
+sha256sum \
+  "$work/regenerated-solution.mpy" \
+  "$work/submitted-solution.mpy" \
+  "$work/solution.py"
+hash_status=$?
+printf 'EXIT_STATUS: %s\n' "$hash_status"
