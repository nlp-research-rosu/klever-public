from pathlib import Path
from hashlib import sha256
from itertools import product
root=Path('/generation-evidence/codex-trace'); target='8afe61c6815305732256b784fd01400120793bf79b47d0e56a4cd95b8ac201ee'
entries=sorted(root.rglob('*'))
seps=[b'',b'\\0',b'\\n',b' ',b':',b'\\t']
pathstyles=[lambda p:p.relative_to(root).as_posix().encode(),lambda p:('./'+p.relative_to(root).as_posix()).encode(),lambda p:(p.relative_to(root).as_posix()+'/').encode() if p.is_dir() else p.relative_to(root).as_posix().encode()]
kindstyles=[lambda p:b'',lambda p:b'directory' if p.is_dir() else b'file',lambda p:b'dir' if p.is_dir() else b'file',lambda p:b'd' if p.is_dir() else b'f',lambda p:b'D' if p.is_dir() else b'F']
data_styles=[
 lambda p:b'' if p.is_dir() else p.read_bytes(),
 lambda p:b'' if p.is_dir() else sha256(p.read_bytes()).hexdigest().encode(),
 lambda p:b'' if p.is_dir() else sha256(p.read_bytes()).digest(),
 lambda p:b'' if p.is_dir() else str(p.stat().st_size).encode()+p.read_bytes(),
 lambda p:b'' if p.is_dir() else p.stat().st_size.to_bytes(8,'big')+p.read_bytes(),
]
for pi,ki,di,csep,esep,prefix,suffix in product(range(len(pathstyles)),range(len(kindstyles)),range(len(data_styles)),seps,seps,[b'',b'root\\0'],[b'',b'\\n',b'\\0']):
 h=sha256();h.update(prefix)
 for p in entries:
  parts=[pathstyles[pi](p),kindstyles[ki](p),data_styles[di](p)]
  h.update(csep.join(parts));h.update(esep)
 h.update(suffix)
 if h.hexdigest()==target:
  print('MATCH',pi,ki,di,repr(csep),repr(esep),repr(prefix),repr(suffix));raise SystemExit
print('no match',len(entries))
PY" in /audit-output
