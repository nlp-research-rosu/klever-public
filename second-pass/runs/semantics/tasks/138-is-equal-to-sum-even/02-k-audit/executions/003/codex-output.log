diff --git a/evidence/spec-claim-3.k b/evidence/spec-claim-3.k
new file mode 100644
index 0000000000000000000000000000000000000000..42eeab85785f5b97f266d3f86538e9e95ac208ce
--- /dev/null
+++ b/evidence/spec-claim-3.k
@@ -0,0 +1,21 @@
