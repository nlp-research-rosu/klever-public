diff --git a/evidence/spec-claim-2.k b/evidence/spec-claim-2.k
new file mode 100644
index 0000000000000000000000000000000000000000..16ab0011ca48cd0bb8a918d6ac8441d5c6655138
--- /dev/null
+++ b/evidence/spec-claim-2.k
@@ -0,0 +1,21 @@
+requires "verification.k"
+
+module SPEC-CLAIM-2
+  imports VERIFICATION
+
+  claim
+    <k> #isEqualToSumEven(N:Int) => true </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
