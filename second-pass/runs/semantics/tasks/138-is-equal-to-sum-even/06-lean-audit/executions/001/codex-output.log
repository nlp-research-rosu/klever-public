+  printf '%s\n' '$ env PYTHONPATH=/reference PATH=/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin:$PATH python3 -c <check_generation invocation>'
+  env PYTHONPATH=/reference PATH="$lean_bin:$PATH" python3 -c '
+import json
+from pathlib import Path
+from tools.klean_preflight import check_generation
