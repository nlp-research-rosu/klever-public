requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // Invoke the closure denoted by the sole FuncDef in solution.mpy.  Constructing
  // the closure directly avoids leaving its module-level name binding behind in
  // the final state; Call, argument binding, Return, and frame cleanup still run
  // through the supplied Python semantics.
  syntax KItem ::= "#isEqualToSumEven" "(" Int ")"

  rule <k> #isEqualToSumEven(N:Int)
        => Call(
             closureVal(
               ("n", .ParamNames),
               (Return(
                  BoolOp(
                    "and",
                    ( Compare(Name("n"), CmpOp(">=", Int(8)))
                    , Compare(
                        BinOp("%", Name("n"), Int(2)),
                        CmpOp("==", Int(0)))
                    , .Exprs)))
                .Stmts),
               0),
             (N, .Exprs))
           ... </k>
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  // Universal functional-correctness theorem for every mathematical integer.
  claim
    <k>
      #isEqualToSumEven(N:Int)
      => (N >=Int 8 andBool pyMod(N, 2) ==Int 0)
    </k>
    <env> 0 </env>
    <scopes>
      0  |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>

  // These three corollaries make the exhaustive cases explicit:
  //   N < 8, or N >= 8 with remainder zero, or N >= 8 with nonzero remainder.
  claim
    <k> #isEqualToSumEven(N:Int) => true </k>
    <env> 0 </env>
    <scopes>
      0  |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N >=Int 8 andBool pyMod(N, 2) ==Int 0

  claim
    <k> #isEqualToSumEven(N:Int) => false </k>
    <env> 0 </env>
    <scopes>
      0  |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N <Int 8

  claim
    <k> #isEqualToSumEven(N:Int) => false </k>
    <env> 0 </env>
    <scopes>
      0  |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N >=Int 8 andBool pyMod(N, 2) =/=Int 0
endmodule
