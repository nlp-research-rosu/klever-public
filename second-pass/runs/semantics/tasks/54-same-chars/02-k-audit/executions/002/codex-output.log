diff --git a/evidence/spec-vacuity-audit.k b/evidence/spec-vacuity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..0bc545c3965d7e31ea6058df56780bd40bf79b87
--- /dev/null
+++ b/evidence/spec-vacuity-audit.k
@@ -0,0 +1,27 @@
+requires "verification.k"
+
+module SAME-CHARS-SPEC-VACUITY-AUDIT
+  imports SAME-CHARS-VERIFICATION
+
+  // Deliberately false result obligation: invert the required Boolean result.
+  // Satisfying witness S0 = S1 = .IntSeq makes the program return true while
+  // this postcondition requires false.
+  claim
+    <k>
+      #sameChars(S0:IntSeq, S1:IntSeq)
+      =>
+      notBool sameSet(dedupCodes(S0), dedupCodes(S1))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/verification-body-mutated.k b/evidence/verification-body-mutated.k
new file mode 100644
index 0000000000000000000000000000000000000000..b3664881c0fb33a889425c3eb4ffc55e6a64d0cc
--- /dev/null
+++ b/evidence/verification-body-mutated.k
@@ -0,0 +1,23 @@
+requires "reference-semantics/semantics.k"
+
+module SAME-CHARS-BODY-MUTATED
+  imports MPY
+
+  syntax KItem ::= "#sameCharsBodyMut" "(" IntSeq "," IntSeq ")"
+
+  // Deliberately false source-body mutation: compare set(s0) with itself.
+  rule <k> #sameCharsBodyMut(S0:IntSeq, S1:IntSeq)
+        => Call(
+             closureVal(
+               ("s0", "s1", .ParamNames),
+               (Return(
+                  Compare(
+                    Call(Name("set"), (Name("s0"), .Exprs)),
+                    CmpOp("==",
+                      Call(Name("set"), (Name("s0"), .Exprs)))))
+                .Stmts),
+               0),
+             (str(S0), str(S1), .Exprs))
+           ...
+       </k>
+endmodule

