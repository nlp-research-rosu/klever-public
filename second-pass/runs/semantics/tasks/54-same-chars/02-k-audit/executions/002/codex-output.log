diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..726464a3e385b2f58e8ca812aee8f0370b60e003
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,10 @@
+def same_chars(s0: str, s1: str):
+    return set(s0) == set(s1)
