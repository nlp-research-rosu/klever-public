+             closureVal(
+               ("s0", "s1", .ParamNames),
+               (Return(
+                  Compare(
+                    Call(Name("set"), (Name("s0"), .Exprs)),
+                    CmpOp("==",
+                      Call(Name("set"), (Name("s0"), .Exprs)))))
+                .Stmts),
+               0),
+             (str(S0), str(S1), .Exprs))
+           ...
+       </k>
+endmodule

