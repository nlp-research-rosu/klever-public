diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c93018ad3dd1586d20c09cc2eedcff6d820c28b0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,26 @@
+requires "verification.k"
+
+module SAME-CHARS-SPEC
+  imports SAME-CHARS-VERIFICATION
+
+  // For arbitrary strings, the result is equality of their distinct
+  // character-code sets.  sameSet is mutual membership, as defined by MPY-SET.
+  claim
+    <k>
+      #sameChars(S0:IntSeq, S1:IntSeq)
+      =>
+      sameSet(dedupCodes(S0), dedupCodes(S1))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b9ffa4b5ebcb4edd4ca8208d70faea5fec9cf041
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,24 @@
+requires "reference-semantics/semantics.k"
+
+module SAME-CHARS-VERIFICATION
+  imports MPY
+
+  // This closure is the constructor-level form of solution.mpy.  Calling it
+  // directly keeps the module scope unchanged across a proof claim.
+  syntax KItem ::= "#sameChars" "(" IntSeq "," IntSeq ")"
+
+  rule <k> #sameChars(S0:IntSeq, S1:IntSeq)
+        => Call(
+             closureVal(
+               ("s0", "s1", .ParamNames),
+               (Return(
+                  Compare(
+                    Call(Name("set"), (Name("s0"), .Exprs)),
+                    CmpOp("==",
+                      Call(Name("set"), (Name("s1"), .Exprs)))))
+                .Stmts),
+               0),
+             (str(S0), str(S1), .Exprs))
+           ...
+       </k>
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SAME-CHARS-SPEC' in /work
