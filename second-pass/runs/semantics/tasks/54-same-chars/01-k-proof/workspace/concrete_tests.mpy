Module(
  FuncDef("same_chars", Params("s0", "s1"),
    Return(
      Compare(
        Call(Name("set"), Name("s0")),
        CmpOp("==", Call(Name("set"), Name("s1"))))))
  Assert(
    Call(
      Name("same_chars"),
      Str("eabcdzzzz"),
      Str("dddzzzzzzzddeddabc")))
  Assert(Call(Name("same_chars"), Str("abcd"), Str("dddddddabc")))
  Assert(Call(Name("same_chars"), Str("dddddddabc"), Str("abcd")))
  Assert(
    UnaryOp(
      "not",
      Call(Name("same_chars"), Str("eabcd"), Str("dddddddabc"))))
  Assert(
    UnaryOp(
      "not",
      Call(Name("same_chars"), Str("abcd"), Str("dddddddabce"))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("same_chars"),
        Str("eabcdzzzz"),
        Str("dddzzzzzzzddddabc")))))
