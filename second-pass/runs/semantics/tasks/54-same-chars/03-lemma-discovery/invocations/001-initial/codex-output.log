requires "reference-semantics/semantics.k"

module SAME-CHARS-VERIFICATION
  imports MPY

  // This closure is the constructor-level form of solution.mpy.  Calling it
  // directly keeps the module scope unchanged across a proof claim.
  syntax KItem ::= "#sameChars" "(" IntSeq "," IntSeq ")"

  rule <k> #sameChars(S0:IntSeq, S1:IntSeq)
        => Call(
             closureVal(
               ("s0", "s1", .ParamNames),
               (Return(
                  Compare(
                    Call(Name("set"), (Name("s0"), .Exprs)),
                    CmpOp("==",
                      Call(Name("set"), (Name("s1"), .Exprs)))))
                .Stmts),
               0),
             (str(S0), str(S1), .Exprs))
           ...
       </k>
endmodule
requires "verification.k"

module SAME-CHARS-SPEC
  imports SAME-CHARS-VERIFICATION

  // For arbitrary strings, the result is equality of their distinct
  // character-code sets.  sameSet is mutual membership, as defined by MPY-SET.
  claim
    <k>
      #sameChars(S0:IntSeq, S1:IntSeq)
      =>
      sameSet(dedupCodes(S0), dedupCodes(S1))
    </k>
    <env> 0 </env>
    <scopes>
      0  |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py concrete_tests.py > concrete_tests.mpy

kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun concrete_tests.mpy \
