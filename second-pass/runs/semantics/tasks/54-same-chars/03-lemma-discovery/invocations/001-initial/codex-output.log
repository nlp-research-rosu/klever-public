kompile verification.k \
  --backend haskell \
  --main-module SAME-CHARS-VERIFICATION \
  --syntax-module SAME-CHARS-VERIFICATION \
  --output-definition verification-kompiled

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SAME-CHARS-SPEC
