diff --git a/evidence/proc_exe_compat.c b/evidence/proc_exe_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..c3519e066b5b010b41516b86b1e5ce9d9696dd20
--- /dev/null
+++ b/evidence/proc_exe_compat.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+/*
+ * The audit runner exposes /proc from a different PID namespace. Lean 4.22
+ * asks for /proc/<getpid()>/exe, which is absent, although /proc/self/exe is
+ * valid. Redirect only that executable-discovery lookup.
+ */
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static ssize_t (*real_readlink)(const char *, char *, size_t);
+  if (!real_readlink) real_readlink = dlsym(RTLD_NEXT, "readlink");
+  size_t length = strlen(path);
+  if (
+    length > 10
+    && strncmp(path, "/proc/", 6) == 0
+    && strcmp(path + length - 4, "/exe") == 0
+  ) {
+    return real_readlink("/proc/self/exe", buf, size);
+  }
+  return real_readlink(path, buf, size);
+}
