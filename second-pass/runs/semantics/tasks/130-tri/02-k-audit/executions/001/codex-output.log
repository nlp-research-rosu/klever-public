+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures prefixIndex(
+      vCons(1, vCons(3, vCons(2, vCons(8, .ValSeq)))))
+      ==Int 3
+endmodule
+
+module POST-WRONG-CONCRETE-SPEC
