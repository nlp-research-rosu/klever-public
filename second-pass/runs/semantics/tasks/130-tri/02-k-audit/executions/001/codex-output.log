+copy_rc=$?
+echo "exit=$copy_rc"
+
+echo '$ kprove spec-vacuity-audit.k --definition verification-kompiled --spec-module TRI-VACUITY-AUDIT-SPEC --dry-run'
+kprove spec-vacuity-audit.k \
