+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures prefixIndex(triPrefix(3)) ==Int 3
+endmodule
diff --git a/evidence/stage1_integrity.sh b/evidence/stage1_integrity.sh
new file mode 100644
