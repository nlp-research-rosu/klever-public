+    Assign(Name("a"), Int(1))
+    Assign(Name("b"), Int(3))
+    Assign(Name("value"), Int(3))
+    Assign(Name("i"), Int(2))
+    While(Compare(Name("i"), CmpOp("<=", Name("n"))),
