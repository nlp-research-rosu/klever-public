Module(
  FuncDef("tri", Params("n"),
    If(Compare(Name("n"), CmpOp("==", Int(0))),
      Return(ListExpr(Int(1))),
      )
    Assign(Name("result"), ListExpr(Int(1), Int(3)))
    Assign(Name("a"), Int(1))
    Assign(Name("b"), Int(3))
    Assign(Name("value"), Int(3))
    Assign(Name("i"), Int(2))
    While(Compare(Name("i"), CmpOp("<=", Name("n"))),
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
        Assign(
          Name("value"),
          BinOp("+", Int(1), BinOp("//", Name("i"), Int(2)))),
        Assign(
          Name("value"),
          BinOp(
            "+",
            BinOp("+", BinOp("+", Name("b"), Name("a")), Int(1)),
            BinOp("//", BinOp("+", Name("i"), Int(1)), Int(2)))))
      Expr(Call(Attribute(Name("result"), "append"), Name("value")))
      Assign(Name("a"), Name("b"))
      Assign(Name("b"), Name("value"))
      AugAssign(Name("i"), "+", Int(1)))
    Return(Name("result")))
  Assert(Compare(Call(Name("tri"), Int(0)),
    CmpOp("==", ListExpr(Int(1)))))
  Assert(Compare(Call(Name("tri"), Int(1)),
    CmpOp("==", ListExpr(Int(1), Int(3)))))
  Assert(Compare(Call(Name("tri"), Int(2)),
    CmpOp("==", ListExpr(Int(1), Int(3), Int(2)))))
  Assert(Compare(Call(Name("tri"), Int(3)),
    CmpOp("==", ListExpr(Int(1), Int(3), Int(2), Int(8)))))
  Assert(Compare(Call(Name("tri"), Int(4)),
    CmpOp("==", ListExpr(Int(1), Int(3), Int(2), Int(8), Int(3)))))
  Assert(Compare(Call(Name("tri"), Int(5)),
    CmpOp("==", ListExpr(Int(1), Int(3), Int(2), Int(8), Int(3), Int(15)))))
  Assert(Compare(Call(Name("tri"), Int(10)),
    CmpOp("==", ListExpr(Int(1), Int(3), Int(2), Int(8), Int(3), Int(15),
                         Int(4), Int(24), Int(5), Int(35), Int(6)))))
  Assert(Compare(Call(Name("tri"), Int(25)),
    CmpOp("==", ListExpr(Int(1), Int(3), Int(2), Int(8), Int(3), Int(15),
                         Int(4), Int(24), Int(5), Int(35), Int(6), Int(48),
                         Int(7), Int(63), Int(8), Int(80), Int(9), Int(99),
                         Int(10), Int(120), Int(11), Int(143), Int(12), Int(168),
                         Int(13), Int(195))))))
