+  Assert(Compare(Call(Name("tri"), Int(5)), CmpOp("=="),
+    ListExpr(Int(1), Int(3), Int(2), Int(8), Int(3), Int(15))))
+  Assert(Compare(Call(Name("tri"), Int(10)), CmpOp("=="),
+    ListExpr(Int(1), Int(3), Int(2), Int(8), Int(3), Int(15),
+             Int(4), Int(24), Int(5), Int(35), Int(6))))
+  Assert(Compare(Call(Name("tri"), Int(25)), CmpOp("=="),
+    ListExpr(Int(1), Int(3), Int(2), Int(8), Int(3), Int(15),
+             Int(4), Int(24), Int(5), Int(35), Int(6), Int(48),
+             Int(7), Int(63), Int(8), Int(80), Int(9), Int(99),
+             Int(10), Int(120), Int(11), Int(143), Int(12), Int(168),
