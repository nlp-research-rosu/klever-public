+requires "/tmp/audit-work/130-tri-audit/verification.k"
+
+module STAGE4-CONCRETE-SUBSTITUTION
+  imports TRI-VERIFICATION
+
+  claim
+    <k> Call(closureVal(("n", .ParamNames), TriFunctionBody, 0),
+             Int(0), .Exprs)
+      =>
+         ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(vCons(1, .ValSeq)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim
+    <k> Call(closureVal(("n", .ParamNames), TriFunctionBody, 0),
+             Int(3), .Exprs)
+      =>
+         ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, vCons(3, vCons(2, vCons(8, .ValSeq)))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
