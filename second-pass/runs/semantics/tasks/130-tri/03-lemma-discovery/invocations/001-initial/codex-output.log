/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
from pathlib import Path
inv = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert list(out.keys()) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
inv_ids = [r['source_rule_id'] for r in inv['rules']]
out_ids = [r['source_rule_id'] for r in out['rules']]
assert out_ids == inv_ids
assert len(out_ids) == len(set(out_ids))
for item in out['rules']:
    assert list(item.keys()) == ['source_rule_id', 'classification', 'rationale']
    assert item['classification'] in allowed
    assert isinstance(item['rationale'], str) and item['rationale'].strip()
by_id = {r['source_rule_id']: r for r in out['rules']}
for rule in inv['rules']:
    if 'simplification' in rule['attributes']:
        assert by_id[rule['source_rule_id']]['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
counts = Counter(r['classification'] for r in out['rules'])
print('inventory hash:', out['inventory_sha256'])
print('rules validated:', len(out_ids))
for name in ['DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA']:
    print(f'{name}: {counts[name]}')
print('schema/order/coverage/uniqueness/rationales/simplification constraint: passed')
PY
