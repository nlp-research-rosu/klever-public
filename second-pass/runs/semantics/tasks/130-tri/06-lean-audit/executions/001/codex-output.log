def source_tri(n, memo={0:1,1:3}):
    if n in memo: return memo[n]
    if n % 2 == 0:
        value=1+n//2
    else:
        value=source_tri(n-1)+source_tri(n-2)+1+(n+1)//2
    memo[n]=value
    return value

def candidate_tri(i):
