     1	def tri(n):
     2	    if n == 0:
     3	        return [1]
     4	
     5	    result = [1, 3]
     6	    a = 1
     7	    b = 3
     8	    value = 3
     9	    i = 2
    10	
    11	    while i <= n:
    12	        if i % 2 == 0:
    13	            value = 1 + i // 2
    14	        else:
    15	            value = b + a + 1 + (i + 1) // 2
    16	
    17	        result.append(value)
    18	        a = b
    19	        b = value
    20	        i += 1
    21	
    22	    return result
