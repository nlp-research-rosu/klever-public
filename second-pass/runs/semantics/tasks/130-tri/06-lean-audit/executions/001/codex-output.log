diff --git a//tmp/audit-work/lean-audit.EcpzYz/Project/BridgeAudit.lean b//tmp/audit-work/lean-audit.EcpzYz/Project/BridgeAudit.lean
new file mode 100644
index 0000000000000000000000000000000000000000..d20aa1cdc49286be3fd7d1680799df89e3d78d31
--- /dev/null
+++ b//tmp/audit-work/lean-audit.EcpzYz/Project/BridgeAudit.lean
@@ -0,0 +1,67 @@
+import Proof
+
+namespace BridgeAudit
+
+-- Ground cases chosen to distinguish truncating division/remainder from
+-- Euclidean division/remainder and to exercise both signs.
+#eval Proof.«_-Int_» (-7) 3
+#eval Proof.«_-Int_» 7 (-3)
+#eval [Proof._andBool_ false false, Proof._andBool_ false true,
+  Proof._andBool_ true false, Proof._andBool_ true true]
+#eval [Proof.«_>=Int_» (-2) (-3), Proof.«_>=Int_» (-3) (-2),
+  Proof.«_>=Int_» 4 4]
+#eval [Proof.«_==Int_» (-2) (-2), Proof.«_==Int_» (-2) 2]
+#eval [Proof.«_%Int_» 8 3, Proof.«_%Int_» 8 (-3),
+  Proof.«_%Int_» (-8) 3, Proof.«_%Int_» (-8) (-3)]
+#eval [Proof.«_/Int_» 8 3, Proof.«_/Int_» 8 (-3),
+  Proof.«_/Int_» (-8) 3, Proof.«_/Int_» (-8) (-3)]
+#eval [Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» (-3) 2,
+  Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» 3 (-2)]
+#eval (List.range 13).map (fun n => Proof.triAt (Int.ofNat n))
+
+example : Proof.«_+Int_» (-7) 3 = -4 := by decide
+example : Proof.«_-Int_» (-7) 3 = -10 := by decide
+example : Proof.«_%Int_» (-8) 3 = -2 := by decide
+example : Proof.«_/Int_» (-8) 3 = -2 := by decide
+example : Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» (-3) 2 = 1 := by decide
+
+-- Convenient counterfactual bridge: making andBool constantly false makes
+-- both generated implications vacuous. This compiles, demonstrating why the
+-- candidate's operational definitions must be audited independently.
+def falseAnd (_a _b : SortBool) : SortBool := false
+
+theorem target_is_vacuous_with_false_and :
+    Klean130Tri.Lemmas.targetStatement
+      Proof.«_-Int_» falseAnd Proof.«_>=Int_» Proof.«_==Int_»
+      Proof.«_%Int_» Proof.«_+Int_» Proof.«_/Int_»
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» Proof.triAt := by
+  unfold Klean130Tri.Lemmas.targetStatement
+  constructor <;> intro I h <;> simp [falseAnd] at h
+
+-- Constant and identity sequence summaries disagree at reachable witnesses,
+-- so they cannot replace the frozen triAt recurrence with honest operators.
+def zeroTri (_i : SortInt) : SortInt := 0
+def identityTri (i : SortInt) : SortInt := i
+
+theorem zeroTri_rejected
+    (hTarget :
+      Klean130Tri.Lemmas.targetStatement
+        Proof.«_-Int_» Proof._andBool_ Proof.«_>=Int_» Proof.«_==Int_»
+        Proof.«_%Int_» Proof.«_+Int_» Proof.«_/Int_»
+        Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» zeroTri) :
+    False := by
+  have h := hTarget.1 2 (by decide)
+  simp [Proof.«_+Int_», Proof.«_/Int_», zeroTri] at h
+
+theorem identityTri_rejected
+    (hTarget :
+      Klean130Tri.Lemmas.targetStatement
+        Proof.«_-Int_» Proof._andBool_ Proof.«_>=Int_» Proof.«_==Int_»
+        Proof.«_%Int_» Proof.«_+Int_» Proof.«_/Int_»
+        Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» identityTri) :
+    False := by
+  have h := hTarget.2 3 (by decide)
+  simp [Proof.«_-Int_», Proof.«_%Int_», Proof.«_+Int_», Proof.«_/Int_»,
+    identityTri] at h
+
+end BridgeAudit
diff --git a//tmp/audit-work/lean_proc_readlink_shim.c b//tmp/audit-work/lean_proc_readlink_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..fc63b23f9071ee1a5755049503e1e6245af128c6
--- /dev/null
+++ b//tmp/audit-work/lean_proc_readlink_shim.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_function)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_function original_readlink;
+  if (original_readlink == NULL) {
+    original_readlink = (readlink_function)dlsym(RTLD_NEXT, "readlink");
+  }
+
+  ssize_t result = original_readlink(path, buffer, size);
+  size_t length = strlen(path);
+  if (result < 0 && length >= 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0) {
+    return original_readlink("/proc/self/exe", buffer, size);
+  }
+  return result;
+}
