      "rationale": "Base equation defining the mathematical summary triAt at index 0.",
      "source_rule_id": "rule-3ff8203bb258bd95e81baadbf9bc4f9860533818a5ae9db40c721920095faaa0",
      "start_line": 12,
      "text": "  rule triAt(0) => 1 [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 13,
      "module": "TRI-VERIFICATION",
      "normalized_sha256": "97c11e3637318e96a3826aac39bfe3c75bfbc5ca7bbcb1a0e05a254152b246ab",
      "rationale": "Base equation defining the mathematical summary triAt at index 1.",
      "source_rule_id": "rule-97c11e3637318e96a3826aac39bfe3c75bfbc5ca7bbcb1a0e05a254152b246ab",
      "start_line": 13,
      "text": "  rule triAt(1) => 3 [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 18,
      "module": "TRI-VERIFICATION",
      "normalized_sha256": "8b82a4cbbd1d1f756ea6b52db7d3c9d7662ed73c64539757f8de941978b4c4a3",
      "rationale": "Even-index contract equation defining triAt in the pyMod-expanded floor-division form used by the model.",
      "source_rule_id": "rule-8b82a4cbbd1d1f756ea6b52db7d3c9d7662ed73c64539757f8de941978b4c4a3",
      "start_line": 15,
      "text": "  rule 1 +Int ((I:Int -Int pyMod(I, 2)) /Int 2)\n    => triAt(I)\n    requires I >=Int 2 andBool pyMod(I, 2) ==Int 0\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 31,
      "module": "TRI-VERIFICATION",
      "normalized_sha256": "d546c7a7288d5460ba7e97ed09bdddabbf36c86b1b952734f678454be1da87bb",
      "rationale": "Odd-index recurrence defining triAt from the preceding two values and the explicit following-even value.",
      "source_rule_id": "rule-d546c7a7288d5460ba7e97ed09bdddabbf36c86b1b952734f678454be1da87bb",
      "start_line": 27,
      "text": "  rule ((triAt(I -Int 1) +Int triAt(I -Int 2)) +Int 1)\n       +Int (((I +Int 1) -Int pyMod(I +Int 1, 2)) /Int 2)\n    => triAt(I)\n    requires I >=Int 3 andBool pyMod(I, 2) ==Int 1\n    [simplification]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 48,
      "module": "TRI-VERIFICATION",
      "normalized_sha256": "0c713d54745c0c3c04baeec92e1bf38f49065711e35fb55c0a30da33fb7da4f9",
      "rationale": "Base equation defining the one-element concrete value sequence as triPrefix(0).",
      "source_rule_id": "rule-0c713d54745c0c3c04baeec92e1bf38f49065711e35fb55c0a30da33fb7da4f9",
      "start_line": 48,
      "text": "  rule vCons(1, .ValSeq) => triPrefix(0)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 49,
      "module": "TRI-VERIFICATION",
      "normalized_sha256": "1946221f62cc5c61606053937b8e8b3da5aa4ae6fa49adc0fe22861909808d96",
      "rationale": "Base equation defining the two-element concrete value sequence as triPrefix(1).",
      "source_rule_id": "rule-1946221f62cc5c61606053937b8e8b3da5aa4ae6fa49adc0fe22861909808d96",
      "start_line": 49,
      "text": "  rule vCons(1, vCons(3, .ValSeq)) => triPrefix(1)"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 50,
      "module": "TRI-VERIFICATION",
      "normalized_sha256": "326cb0aef9ed617ee5db9965228dfa31dcfdfd976cd5551fa55639318630e44d",
      "rationale": "Base observation equation defining prefixIndex for the concrete prefix through index 0.",
      "source_rule_id": "rule-326cb0aef9ed617ee5db9965228dfa31dcfdfd976cd5551fa55639318630e44d",
      "start_line": 50,
      "text": "  rule prefixIndex(vCons(1, .ValSeq)) => 0 [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 51,
      "module": "TRI-VERIFICATION",
      "normalized_sha256": "e1a0c3eaaab3f6c35ba80d3fc5be55944a6e52cfb8d37081b13d4260373a91f1",
      "rationale": "Base observation equation defining prefixIndex for the concrete prefix through index 1.",
      "source_rule_id": "rule-e1a0c3eaaab3f6c35ba80d3fc5be55944a6e52cfb8d37081b13d4260373a91f1",
      "start_line": 51,
      "text": "  rule prefixIndex(vCons(1, vCons(3, .ValSeq))) => 1 [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 52,
      "module": "TRI-VERIFICATION",
      "normalized_sha256": "d186ccef81ee57423370b3ba95f2b782c3e5e60505c825a6feee90b6ccf6fe1b",
      "rationale": "Structural projection equation defining prefixIndex on the named triPrefix summary.",
      "source_rule_id": "rule-d186ccef81ee57423370b3ba95f2b782c3e5e60505c825a6feee90b6ccf6fe1b",
      "start_line": 52,
      "text": "  rule prefixIndex(triPrefix(J:Int)) => J [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 58,
      "module": "TRI-VERIFICATION",
      "normalized_sha256": "a1f608808b90b963cd37e5ed0b549a786ca45b4175b9b18a40425d7a95cb349e",
      "rationale": "Inductive observation equation defining how prefixIndex advances when the next triAt value is appended.",
      "source_rule_id": "rule-a1f608808b90b963cd37e5ed0b549a786ca45b4175b9b18a40425d7a95cb349e",
      "start_line": 53,
      "text": "  rule prefixIndex(\n         valSeqConcat(VS:ValSeq, vCons(triAt(I:Int), .ValSeq)))\n    => I\n    requires I >=Int 2\n     andBool prefixIndex(VS) ==Int I +Int -1\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 62,
      "module": "TRI-VERIFICATION",
      "normalized_sha256": "e6e11f7c743efb37d2a8918f66fff30480851e5675d2382e459e91f0ffe5c524",
      "rationale": "Inductive recurrence defining triPrefix by appending the next triAt value.",
      "source_rule_id": "rule-e6e11f7c743efb37d2a8918f66fff30480851e5675d2382e459e91f0ffe5c524",
      "start_line": 59,
      "text": "  rule valSeqConcat(triPrefix(I:Int +Int -1), vCons(triAt(I), .ValSeq))\n    => triPrefix(I)\n    requires I >=Int 2\n    [simplification]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 68,
      "module": "TRI-VERIFICATION",
      "normalized_sha256": "7d0853cf8b72bfac640b22b09d10e444482d0b5006d8035ee0d689f8dc90729e",
      "rationale": "Macro expansion defining the named TriLoopCond proof term as the exact translated loop condition.",
      "source_rule_id": "rule-7d0853cf8b72bfac640b22b09d10e444482d0b5006d8035ee0d689f8dc90729e",
      "start_line": 67,
      "text": "  rule TriLoopCond\n    => Compare(Name(\"i\"), CmpOp(\"<=\", Name(\"n\")))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 86,
      "module": "TRI-VERIFICATION",
      "normalized_sha256": "f93f8c3fd7997a05bdc0de26e8efe8be14f0c3b431694cb73de134b9503b0531",
      "rationale": "Macro expansion defining the named TriLoopBody proof term as the exact translated loop body.",
      "source_rule_id": "rule-f93f8c3fd7997a05bdc0de26e8efe8be14f0c3b431694cb73de134b9503b0531",
      "start_line": 71,
      "text": "  rule TriLoopBody\n    => If(Compare(BinOp(\"%\", Name(\"i\"), Int(2)), CmpOp(\"==\", Int(0))),\n         Assign(Name(\"value\"),\n           BinOp(\"+\", Int(1), BinOp(\"//\", Name(\"i\"), Int(2))))\n         .Stmts,\n         Assign(Name(\"value\"),\n           BinOp(\"+\",\n             BinOp(\"+\", BinOp(\"+\", Name(\"b\"), Name(\"a\")), Int(1)),\n             BinOp(\"//\", BinOp(\"+\", Name(\"i\"), Int(1)), Int(2))))\n         .Stmts)\n       Expr(Call(Attribute(Name(\"result\"), \"append\"),\n                 Name(\"value\"), .Exprs))\n       Assign(Name(\"a\"), Name(\"b\"))\n       Assign(Name(\"b\"), Name(\"value\"))\n       AugAssign(Name(\"i\"), \"+\", Int(1))\n       .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 100,
      "module": "TRI-VERIFICATION",
      "normalized_sha256": "2933f21aeba84a93ce349804abfb2e8ba26f17de599cc354c25018dcc4f56145",
      "rationale": "Macro expansion defining the named TriFunctionBody proof term as the exact translated function body.",
      "source_rule_id": "rule-2933f21aeba84a93ce349804abfb2e8ba26f17de599cc354c25018dcc4f56145",
      "start_line": 89,
      "text": "  rule TriFunctionBody\n    => If(Compare(Name(\"n\"), CmpOp(\"==\", Int(0))),\n         Return(ListExpr(Int(1), .Exprs)) .Stmts,\n         .Stmts)\n       Assign(Name(\"result\"), ListExpr(Int(1), Int(3), .Exprs))\n       Assign(Name(\"a\"), Int(1))\n       Assign(Name(\"b\"), Int(3))\n       Assign(Name(\"value\"), Int(3))\n       Assign(Name(\"i\"), Int(2))\n       While(TriLoopCond, TriLoopBody)\n       Return(Name(\"result\"))\n       .Stmts"
    }
  ],
