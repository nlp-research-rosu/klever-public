+import Klean130Tri.Lemmas
+
+example (I : Int) (h : 3 ≤ I) : 0 ≤ I := by
+  omega
+
+example (I : SortInt) (h : 3 ≤ I) : 0 ≤ I := by
+  change (3 : Int) ≤ I at h
+  change (0 : Int) ≤ I
+  omega
+
+example (I : SortInt) (h : I % (2 : Int) = 1) :
+    (I - (1 : Int)) % 2 = 0 := by
+  let J : Int := I
+  change J % 2 = 1 at h
+  change (J - 1) % 2 = 0
+  omega
+
+example (I : Int) (h : I % 2 = 1) : (I - 1) % 2 = 0 := by
+  omega
+
+example (I : Int) (h : I % 2 = 1) : (I - 2) % 2 = 1 := by
+  omega
+
+example (I : Int) (h : I % 2 = 1) : (I + 1) % 2 = 0 := by
+  omega
+
+example (J : Int) (hJm1 : 0 ≤ J - 1) (hJp1 : 0 ≤ J + 1)
+    (hmodJ : J % 2 = 1) :
+    Int.tdiv (J + 1) 2 = Int.tdiv (J - 1) 2 + 1 := by
+  rw [Int.tdiv_eq_ediv_of_nonneg hJp1,
+    Int.tdiv_eq_ediv_of_nonneg hJm1]
+  omega
+
+example (q : Int) :
+    (q + 1) + q * (q + 2) + 1 + (q + 1) =
+      (q + 1) * (q + 1 + 2) := by
+  grind

