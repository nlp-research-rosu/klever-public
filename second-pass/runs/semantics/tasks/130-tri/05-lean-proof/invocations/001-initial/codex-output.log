new file mode 100644
index 0000000000000000000000000000000000000000..a4e4c8413c567c7ea559678c4f809880e9cba2a1
--- /dev/null
+++ b/.diagnostics/pathtrace.c
@@ -0,0 +1,50 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+typedef char *(*realpath_fn)(const char *, char *);
+typedef char *(*getcwd_fn)(char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static readlink_fn next;
+  if (!next) next = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  ssize_t result = next(path, buf, size);
+  if (result < 0 && errno == ENOENT && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + strlen(path) - 4, "/exe") == 0) {
+    result = next("/proc/self/exe", buf, size);
+  }
+  int saved = errno;
+  fprintf(stderr, "TRACE readlink(%s) = %zd", path, result);
+  if (result >= 0) fprintf(stderr, " [%.*s]", (int)result, buf);
+  fprintf(stderr, " errno=%d\n", saved);
+  errno = saved;
+  return result;
