Module(
  FuncDef("tri", Params("n"),
    If(Compare(Name("n"), CmpOp("==", Int(0))),
      Return(ListExpr(Int(1))),
      )
    Assign(Name("result"), ListExpr(Int(1), Int(3)))
    Assign(Name("a"), Int(1))
    Assign(Name("b"), Int(3))
    Assign(Name("value"), Int(3))
    Assign(Name("i"), Int(2))
    While(Compare(Name("i"), CmpOp("<=", Name("n"))),
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
        Assign(
          Name("value"),
          BinOp("+", Int(1), BinOp("//", Name("i"), Int(2)))),
        Assign(
          Name("value"),
          BinOp(
            "+",
            BinOp("+", BinOp("+", Name("b"), Name("a")), Int(1)),
            BinOp("//", BinOp("+", Name("i"), Int(1)), Int(2)))))
      Expr(Call(Attribute(Name("result"), "append"), Name("value")))
      Assign(Name("a"), Name("b"))
      Assign(Name("b"), Name("value"))
      AugAssign(Name("i"), "+", Int(1)))
    Return(Name("result"))))
