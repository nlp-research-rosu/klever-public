+    ensures ?AIDX <=Int I +Int R -Int 2
+     andBool ?AIDX >=Int I +Int R -Int 2
+     andBool ?BIDX <=Int I +Int R -Int 1
+     andBool ?BIDX >=Int I +Int R -Int 1
+     andBool ?FINAL <=Int I +Int R
