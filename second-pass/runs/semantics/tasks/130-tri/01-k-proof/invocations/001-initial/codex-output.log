+          [ "result" <- ref(H) ]
+          [ "a"      <- triAt(N -Int 1) ]
+          [ "b"      <- triAt(N) ]
+          [ "value"  <- FINAL:Int ]
+          [ "i"      <- N +Int 1 ],
