+          [ "b"      <- triAt(?BIDX:Int) ]
+          [ "value"  <- triAt(?BIDX) ]
+          [ "i"      <- ?FINAL:Int ],
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      H |-> list(triPrefix(I -Int 1))
+      =>
