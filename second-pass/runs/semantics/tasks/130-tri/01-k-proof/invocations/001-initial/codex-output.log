+requires "verification.k"
+
+module TRI-LOOP-SPEC
+  imports TRI-VERIFICATION
+
+  // Loop invariant: before iteration I, result is the prefix through I-1,
+  // and a/b are precisely the preceding two contract values.
+  claim
+    <k> #while(TriLoopCond, TriLoopBody) ~> KREST:K </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        .Map
+          [ "n"      <- N:Int ]
+          [ "result" <- ref(H:Int) ]
+          [ "a"      <- triAt(I:Int -Int 2) ]
+          [ "b"      <- triAt(I -Int 1) ]
+          [ "value"  <- triAt(I -Int 1) ]
+          [ "i"      <- I ],
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> H |-> list(triPrefix(I -Int 1)) </heap>
+    <heapLoc> H +Int 1 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+  =>
+    <k> KREST </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        .Map
+          [ "n"      <- N ]
+          [ "result" <- ref(H) ]
+          [ "a"      <- triAt(N -Int 1) ]
+          [ "b"      <- triAt(N) ]
+          [ "value"  <- triAt(N) ]
+          [ "i"      <- N +Int 1 ],
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> H |-> list(triPrefix(N)) </heap>
+    <heapLoc> H +Int 1 </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 1
+     andBool I >=Int 2
+     andBool I <=Int N +Int 1
+endmodule
+
+module TRI-CORRECT-SPEC
+  imports TRI-VERIFICATION
+
+  // The exact translated body, called with an arbitrary contract input,
+  // returns a heap list containing the mathematical prefix through n.
+  claim
+    <k> Call(closureVal(("n", .ParamNames), TriFunctionBody, 0),
+             Int(N:Int), .Exprs) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+  =>
+    <k> ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> 0 |-> list(triPrefix(N)) </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
+
+module TRI-SPEC-SMOKE
+  imports TRI-VERIFICATION
+  claim <k> .K => .K </k>
+endmodule
+
+module TRI-SPEC-DIAG-AT
+  imports TRI-VERIFICATION
+  claim <k> triAt(N:Int) => triAt(N) </k>
+endmodule
+
+module TRI-SPEC-DIAG-WHILE
+  imports TRI-VERIFICATION
+  claim <k> #while(Compare(Name("i"), CmpOp("<=", Name("n"))),
+                    .Stmts) => #while(Compare(Name("i"),
+                    CmpOp("<=", Name("n"))), .Stmts) </k>
+endmodule
+
+module TRI-SPEC-DIAG-MACRO
+  imports TRI-VERIFICATION
+  claim <k> TriLoopCond => TriLoopCond </k>
+endmodule
+
+module TRI-SPEC-DIAG-HEAP
+  imports TRI-VERIFICATION
+  claim <k> .K </k>
+        <heap> .Map => 0 |-> list(triPrefix(N:Int)) </heap>
+endmodule
+
+module TRI-SPEC-DIAG-SCOPES
+  imports TRI-VERIFICATION
+  claim <k> .K </k>
+        <scopes>
+          0 |-> scope(.Map, parent(-1))
+          -1 |-> builtinsScope
+        =>
+          0 |-> scope(.Map, parent(-1))
+          -1 |-> builtinsScope
+        </scopes>
+endmodule
+
+module TRI-SPEC-DIAG-CALL
+  imports TRI-VERIFICATION
+  claim
+    <k> Call(closureVal(("n", .ParamNames), TriFunctionBody, 0),
+             Int(N:Int), .Exprs)
+      =>
+         ref(0)
+    </k>
+    requires N >=Int 0
+endmodule
+
+module TRI-SPEC-DIAG-LOOPK
+  imports TRI-VERIFICATION
+  claim
+    <k> #while(TriLoopCond, TriLoopBody) ~> KREST:K
+      =>
+         KREST
+    </k>
+    requires N:Int >=Int 1
+endmodule
+
+module TRI-SPEC-DIAG-CALL-HEAP
+  imports TRI-VERIFICATION
+  claim
+    <k> Int(N:Int) => ref(0) </k>
+    <heap> .Map => 0 |-> list(triPrefix(N)) </heap>
+    requires N >=Int 0
+endmodule
+
+module TRI-SPEC-DIAG-LOOP-STATE
+  imports TRI-VERIFICATION
+  claim
+    <k> #while(TriLoopCond, TriLoopBody) ~> KREST:K
+      =>
+         KREST
+    </k>
+    <env> 1 </env>
