+      1 |-> scope(
+        .Map
+          [ "n"      <- I +Int R -Int 1 ]
+          [ "result" <- ref(H) ]
+          [ "a"      <- ?AFINAL:Int ]
+          [ "b"      <- ?BFINAL:Int ]
+          [ "value"  <- ?VFINAL:Int ]
