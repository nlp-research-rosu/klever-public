+  claim
+    <k> .K </k>
+    <stack> STACK:List => STACK </stack>
+endmodule
+
+module TRI-SPEC-DIAG-FRAME
+  imports TRI-VERIFICATION
+  claim
+    <k> .K </k>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        .Map
+          [ "n"      <- N:Int ]
+          [ "result" <- ref(H:Int) ]
+          [ "a"      <- triAt(I:Int -Int 2) ]
+          [ "b"      <- triAt(I -Int 1) ]
+          [ "value"  <- triAt(I -Int 1) ]
+          [ "i"      <- I ],
