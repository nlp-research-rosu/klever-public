+  // and a/b are precisely the preceding two contract values.
+  claim
+    <k> #while(TriLoopCond, TriLoopBody) ~> KREST:K </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        .Map
+          [ "n"      <- N:Int ]
+          [ "result" <- ref(H:Int) ]
+          [ "a"      <- triAt(I:Int -Int 2) ]
+          [ "b"      <- triAt(I -Int 1) ]
+          [ "value"  <- triAt(I -Int 1) ]
+          [ "i"      <- I ],
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> H |-> list(triPrefix(I -Int 1)) </heap>
+    <heapLoc> H +Int 1 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+  =>
+    <k> KREST </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
