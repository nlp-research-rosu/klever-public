+      =>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        .Map
+          [ "n"      <- N ]
+          [ "result" <- ref(H) ]
+          [ "a"      <- triAt(N -Int 1) ]
+          [ "b"      <- triAt(N) ]
+          [ "value"  <- triAt(N) ]
+          [ "i"      <- N +Int 1 ],
+        parent(0))
+    </scopes>
+    requires N >=Int 1
+     andBool I >=Int 2
+     andBool I <=Int N +Int 1
+endmodule
