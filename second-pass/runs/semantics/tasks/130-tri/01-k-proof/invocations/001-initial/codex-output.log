+  claim <k> .K </k>
+        <scopes>
+          0 |-> scope(.Map, parent(-1))
+          -1 |-> builtinsScope
+        =>
+          0 |-> scope(.Map, parent(-1))
+          -1 |-> builtinsScope
+        </scopes>
+endmodule
