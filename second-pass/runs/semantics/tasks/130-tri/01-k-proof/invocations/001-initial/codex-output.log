+    </k>
+    requires I >=Int 2
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f6aa32ea0017d35e3cfe4717083f1bf91774967b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,101 @@
+requires "reference-semantics/semantics.k"
+
+module TRI-VERIFICATION
+  imports MPY
+
+  // Mathematical value at an index.  The two step rules are the contract:
+  // even indices have the stated closed value, while odd indices use the
+  // preceding two values and the (even) following value.
+  syntax Int ::= triAt(Int)
+    [function, total, symbol(triAt), no-evaluators]
+
+  rule triAt(0) => 1 [simplification]
+  rule triAt(1) => 3 [simplification]
+
+  rule 1 +Int ((I:Int -Int pyMod(I, 2)) /Int 2)
+    => triAt(I)
+    requires I >=Int 2 andBool pyMod(I, 2) ==Int 0
+    [simplification]
+
+  // The integer backend canonicalizes the preceding expression to this form
+  // once the even-path constraint discharges the remainder.
+  rule (I:Int /Int 2) +Int 1
+    => triAt(I)
+    requires I >=Int 2 andBool pyMod(I, 2) ==Int 0
+    [simplification]
+
+  rule ((triAt(I -Int 1) +Int triAt(I -Int 2)) +Int 1)
+       +Int (((I +Int 1) -Int pyMod(I +Int 1, 2)) /Int 2)
+    => triAt(I)
+    requires I >=Int 3 andBool pyMod(I, 2) ==Int 1
+    [simplification]
+
+  // Canonical Haskell-backend form of the odd recurrence after pyMod unfolds.
+  rule ((triAt(I:Int +Int -1) +Int triAt(I +Int -2)) +Int 1)
+       +Int (((I +Int 1)
+              -Int ((((I +Int 1) %Int 2) +Int 2) %Int 2)) /Int 2)
+    => triAt(I)
+    requires I >=Int 3
+     andBool (((I %Int 2) +Int 2) %Int 2) ==Int 1
+    [simplification]
+
+  // An abstract prefix is characterized inductively by the two concrete
+  // bases and by appending the next contract value.
+  syntax ValSeq ::= triPrefix(Int)
+  syntax Int ::= prefixIndex(ValSeq)
+    [function, total, symbol(prefixIndex), no-evaluators]
+
+  rule vCons(1, .ValSeq) => triPrefix(0)
+  rule vCons(1, vCons(3, .ValSeq)) => triPrefix(1)
+  rule prefixIndex(vCons(1, .ValSeq)) => 0 [simplification]
+  rule prefixIndex(vCons(1, vCons(3, .ValSeq))) => 1 [simplification]
+  rule prefixIndex(triPrefix(J:Int)) => J [simplification]
+  rule prefixIndex(
+         valSeqConcat(VS:ValSeq, vCons(triAt(I:Int), .ValSeq)))
+    => I
+    requires I >=Int 2
+     andBool prefixIndex(VS) ==Int I +Int -1
+    [simplification]
+  rule valSeqConcat(triPrefix(I:Int +Int -1), vCons(triAt(I), .ValSeq))
+    => triPrefix(I)
+    requires I >=Int 2
+    [simplification]
+
+  // Exact constructor fragments generated from solution.py.  Keeping them
+  // named makes the reachability claims readable without changing semantics.
+  syntax Expr ::= "TriLoopCond" [macro]
+  rule TriLoopCond
+    => Compare(Name("i"), CmpOp("<=", Name("n")))
+
+  syntax Stmts ::= "TriLoopBody" [macro]
+  rule TriLoopBody
+    => If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+         Assign(Name("value"),
+           BinOp("+", Int(1), BinOp("//", Name("i"), Int(2))))
+         .Stmts,
+         Assign(Name("value"),
+           BinOp("+",
+             BinOp("+", BinOp("+", Name("b"), Name("a")), Int(1)),
+             BinOp("//", BinOp("+", Name("i"), Int(1)), Int(2))))
+         .Stmts)
+       Expr(Call(Attribute(Name("result"), "append"),
+                 Name("value"), .Exprs))
+       Assign(Name("a"), Name("b"))
+       Assign(Name("b"), Name("value"))
+       AugAssign(Name("i"), "+", Int(1))
+       .Stmts
+
+  syntax Stmts ::= "TriFunctionBody" [macro]
+  rule TriFunctionBody
+    => If(Compare(Name("n"), CmpOp("==", Int(0))),
+         Return(ListExpr(Int(1), .Exprs)) .Stmts,
+         .Stmts)
+       Assign(Name("result"), ListExpr(Int(1), Int(3), .Exprs))
+       Assign(Name("a"), Int(1))
+       Assign(Name("b"), Int(3))
+       Assign(Name("value"), Int(3))
+       Assign(Name("i"), Int(2))
+       While(TriLoopCond, TriLoopBody)
+       Return(Name("result"))
+       .Stmts
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..e945362630a1dadbc62968867c8468132289a5ad
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,22 @@
+def tri(n):
+    if n == 0:
+        return [1]
+
+    result = [1, 3]
+    a = 1
+    b = 3
+    value = 3
+    i = 2
+
+    while i <= n:
+        if i % 2 == 0:
+            value = 1 + i // 2
+        else:
+            value = b + a + 1 + (i + 1) // 2
+
+        result.append(value)
+        a = b
+        b = value
+        i += 1
+
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..6cf0864ba082ffeec8b76ede96d81ca4843e4457
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,229 @@
+requires "verification.k"
+
+module TRI-LOOP-SPEC
+  imports TRI-VERIFICATION
+
+  // Loop invariant: before iteration I, result is the prefix through I-1,
+  // and a/b are precisely the preceding two contract values.
+  claim
+    <k> #while(TriLoopCond, TriLoopBody) ~> KREST:K => KREST </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        .Map
+          [ "n"      <- I:Int +Int R:Int -Int 1 ]
+          [ "result" <- ref(H:Int) ]
+          [ "a"      <- triAt(I:Int -Int 2) ]
+          [ "b"      <- triAt(I -Int 1) ]
+          [ "value"  <- triAt(I -Int 1) ]
+          [ "i"      <- I ],
+        parent(0))
+      =>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        .Map
+          [ "n"      <- I +Int R -Int 1 ]
+          [ "result" <- ref(H) ]
+          [ "a"      <- ?AFINAL:Int ]
+          [ "b"      <- ?BFINAL:Int ]
+          [ "value"  <- ?VFINAL:Int ]
+          [ "i"      <- ?FINAL:Int ],
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      H |-> list(VS:ValSeq)
+      =>
+      H |-> list(?OUT:ValSeq)
+    </heap>
+    <heapLoc> H +Int 1 </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 2
+     andBool R >=Int 0
+     andBool prefixIndex(VS) <=Int I -Int 1
+     andBool prefixIndex(VS) >=Int I -Int 1
+    ensures ?FINAL <=Int I +Int R
+     andBool ?FINAL >=Int I +Int R
+     andBool prefixIndex(?OUT) <=Int I +Int R -Int 1
+     andBool prefixIndex(?OUT) >=Int I +Int R -Int 1
+endmodule
+
+module TRI-CORRECT-SPEC
+  imports TRI-LOOP-SPEC
+
+  // The exact translated body, called with an arbitrary contract input,
+  // returns a heap list containing the mathematical prefix through n.
+  claim
+    <k> Call(closureVal(("n", .ParamNames), TriFunctionBody, 0),
+             Int(N:Int), .Exprs)
+      =>
+         ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(?RESULT:ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+    ensures prefixIndex(?RESULT) <=Int N
+     andBool prefixIndex(?RESULT) >=Int N
+endmodule
+
+module TRI-SPEC-SMOKE
+  imports TRI-VERIFICATION
+  claim <k> .K => .K </k>
+endmodule
+
+module TRI-SPEC-DIAG-AT
+  imports TRI-VERIFICATION
+  claim <k> triAt(N:Int) => triAt(N) </k>
+endmodule
+
+module TRI-SPEC-DIAG-WHILE
+  imports TRI-VERIFICATION
+  claim <k> #while(Compare(Name("i"), CmpOp("<=", Name("n"))),
+                    .Stmts) => #while(Compare(Name("i"),
+                    CmpOp("<=", Name("n"))), .Stmts) </k>
+endmodule
+
+module TRI-SPEC-DIAG-MACRO
+  imports TRI-VERIFICATION
+  claim <k> TriLoopCond => TriLoopCond </k>
+endmodule
+
+module TRI-SPEC-DIAG-HEAP
+  imports TRI-VERIFICATION
+  claim <k> .K </k>
+        <heap> .Map => 0 |-> list(triPrefix(N:Int)) </heap>
+endmodule
+
+module TRI-SPEC-DIAG-SCOPES
+  imports TRI-VERIFICATION
+  claim <k> .K </k>
+        <scopes>
+          0 |-> scope(.Map, parent(-1))
+          -1 |-> builtinsScope
+        =>
+          0 |-> scope(.Map, parent(-1))
+          -1 |-> builtinsScope
+        </scopes>
+endmodule
+
+module TRI-SPEC-DIAG-CALL
+  imports TRI-VERIFICATION
+  claim
+    <k> Call(closureVal(("n", .ParamNames), TriFunctionBody, 0),
+             Int(N:Int), .Exprs)
+      =>
+         ref(0)
+    </k>
+    requires N >=Int 0
+endmodule
+
+module TRI-SPEC-DIAG-LOOPK
+  imports TRI-VERIFICATION
+  claim
+    <k> #while(TriLoopCond, TriLoopBody) ~> KREST:K
+      =>
+         KREST
+    </k>
+    requires N:Int >=Int 1
+endmodule
+
+module TRI-SPEC-DIAG-CALL-HEAP
+  imports TRI-VERIFICATION
+  claim
+    <k> Int(N:Int) => ref(0) </k>
+    <heap> .Map => 0 |-> list(triPrefix(N)) </heap>
+    requires N >=Int 0
+endmodule
+
+module TRI-SPEC-DIAG-LOOP-STATE
+  imports TRI-VERIFICATION
+  claim
+    <k> #while(TriLoopCond, TriLoopBody) ~> KREST:K
+      =>
+         KREST
+    </k>
+    <env> 1 </env>
+    <heap>
+      H:Int |-> list(triPrefix(I:Int -Int 1))
+      =>
+      H |-> list(triPrefix(N:Int))
+    </heap>
+    requires N >=Int 1
+     andBool I >=Int 2
+     andBool I <=Int N +Int 1
+endmodule
+
+module TRI-SPEC-DIAG-ARITH-CELL
+  imports TRI-VERIFICATION
+  claim
+    <k> .K </k>
+    <heapLoc> H:Int +Int 1 => H +Int 1 </heapLoc>
+endmodule
+
+module TRI-SPEC-DIAG-STACK-CELL
+  imports TRI-VERIFICATION
+  claim
+    <k> .K </k>
+    <stack> STACK:List => STACK </stack>
+endmodule
+
+module TRI-SPEC-DIAG-FRAME
+  imports TRI-VERIFICATION
+  claim
+    <k> .K </k>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        .Map
+          [ "n"      <- N:Int ]
+          [ "result" <- ref(H:Int) ]
+          [ "a"      <- triAt(I:Int -Int 2) ]
+          [ "b"      <- triAt(I -Int 1) ]
+          [ "value"  <- triAt(I -Int 1) ]
+          [ "i"      <- I ],
+        parent(0))
+      =>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        .Map
+          [ "n"      <- N ]
+          [ "result" <- ref(H) ]
+          [ "a"      <- triAt(N -Int 1) ]
+          [ "b"      <- triAt(N) ]
+          [ "value"  <- triAt(N) ]
+          [ "i"      <- N +Int 1 ],
+        parent(0))
+    </scopes>
+    requires N >=Int 1
+     andBool I >=Int 2
+     andBool I <=Int N +Int 1
+endmodule
+
+module TRI-SPEC-DIAG-PREFIX
+  imports TRI-VERIFICATION
+  claim
+    <k> valSeqConcat(triPrefix(I:Int -Int 1),
+                     vCons(triAt(I), .ValSeq))
+      =>
+         triPrefix(I)
+    </k>
+    requires I >=Int 2
+endmodule
