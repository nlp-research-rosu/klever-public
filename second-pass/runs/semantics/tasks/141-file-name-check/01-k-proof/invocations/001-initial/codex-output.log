+  syntax Int ::= digitCount(IntSeq) [function, total]
+  rule digitCount(CS:IntSeq)
+    => charCount(CS, 48) +Int charCount(CS, 49)
+       +Int charCount(CS, 50) +Int charCount(CS, 51)
+       +Int charCount(CS, 52) +Int charCount(CS, 53)
+       +Int charCount(CS, 54) +Int charCount(CS, 55)
+       +Int charCount(CS, 56) +Int charCount(CS, 57)
+
+  // This is exactly solution.mpy, named as a function so it is auditable
+  // against the generated artifact.
+  syntax Module ::= "solutionModule" [function]
+  rule solutionModule =>
+    Module(
+      FuncDef("file_name_check", Params("file_name"),
+        Expr(
+          Str(
+            "Return \"Yes\" exactly when file_name satisfies the prompt's rules."))
+        If(Compare(
+          Call(Attribute(Name("file_name"), "count"), Str(".")),
+          CmpOp("!=", Int(1))),
+          Return(Str("No")),
+          .Stmts)
+        If(Compare(Call(Name("len"), Name("file_name")), CmpOp("<", Int(5))),
+          Return(Str("No")),
+          .Stmts)
+        Assign(
+          Name("first_code"),
+          Call(Name("ord"), Subscript(Name("file_name"), Int(0))))
+        If(UnaryOp(
+          "not",
+          BoolOp(
+            "or",
+            BoolOp(
+              "and",
+              Compare(Name("first_code"), CmpOp(">=", Int(65))),
+              Compare(Name("first_code"), CmpOp("<=", Int(90)))),
+            BoolOp(
+              "and",
+              Compare(Name("first_code"), CmpOp(">=", Int(97))),
+              Compare(Name("first_code"), CmpOp("<=", Int(122)))))),
+          Return(Str("No")),
+          .Stmts)
+        Assign(
+          Name("suffix"),
+          Subscript(
+            Name("file_name"),
+            Slice(UnaryOp("-", Int(4)), NoBound, NoBound)))
+        If(UnaryOp(
+          "not",
+          BoolOp(
+            "or",
+            Compare(Name("suffix"), CmpOp("==", Str(".txt"))),
+            Compare(Name("suffix"), CmpOp("==", Str(".exe"))),
+            Compare(Name("suffix"), CmpOp("==", Str(".dll"))))),
+          Return(Str("No")),
+          .Stmts)
+        Assign(
+          Name("digit_count"),
+          BinOp(
+            "+",
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                BinOp(
+                  "+",
+                  BinOp(
+                    "+",
+                    BinOp(
+                      "+",
+                      BinOp(
+                        "+",
+                        BinOp(
+                          "+",
+                          BinOp(
+                            "+",
+                            Call(
+                              Attribute(Name("file_name"), "count"),
+                              Str("0")),
+                            Call(
+                              Attribute(Name("file_name"), "count"),
+                              Str("1"))),
+                          Call(
+                            Attribute(Name("file_name"), "count"),
+                            Str("2"))),
+                        Call(
+                          Attribute(Name("file_name"), "count"),
+                          Str("3"))),
+                      Call(Attribute(Name("file_name"), "count"), Str("4"))),
+                    Call(Attribute(Name("file_name"), "count"), Str("5"))),
+                  Call(Attribute(Name("file_name"), "count"), Str("6"))),
+                Call(Attribute(Name("file_name"), "count"), Str("7"))),
+              Call(Attribute(Name("file_name"), "count"), Str("8"))),
+            Call(Attribute(Name("file_name"), "count"), Str("9"))))
+        If(Compare(Name("digit_count"), CmpOp(">", Int(3))),
+          Return(Str("No")),
+          .Stmts)
+        Return(Str("Yes"))))
+
+  syntax Stmts ::= moduleBody(Module) [function]
+  rule moduleBody(
+         Module(FuncDef(_F:String, Params(_PNS:ParamNames), BODY:Stmts)))
+    => BODY
+
+  syntax KItem ::= runFileNameCheck(IntSeq)
+  rule <k> runFileNameCheck(CS:IntSeq)
+        => #applyK(
+             toCall(closureVal(
+               ("file_name", .ParamNames), moduleBody(solutionModule), 0)),
+             (str(CS), .Vals)) ... </k>
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /work
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..dda541948a2dd36161f7ce383c1bf85ac27d6dac
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,48 @@
+def file_name_check(file_name):
+    """Return "Yes" exactly when file_name satisfies the prompt's rules."""
+    if file_name.count(".") != 1:
+        return "No"
+
+    if len(file_name) < 5:
+        return "No"
+
+    first_code = ord(file_name[0])
+    if not (
+        (first_code >= 65 and first_code <= 90)
+        or (first_code >= 97 and first_code <= 122)
+    ):
+        return "No"
+
+    suffix = file_name[-4:]
+    if not (suffix == ".txt" or suffix == ".exe" or suffix == ".dll"):
+        return "No"
+
+    digit_count = (
+        file_name.count("0")
+        + file_name.count("1")
+        + file_name.count("2")
+        + file_name.count("3")
+        + file_name.count("4")
+        + file_name.count("5")
+        + file_name.count("6")
+        + file_name.count("7")
+        + file_name.count("8")
+        + file_name.count("9")
+    )
+    if digit_count > 3:
+        return "No"
+
+    return "Yes"
+
+
+assert file_name_check("example.txt") == "Yes"
+assert file_name_check("1example.dll") == "No"
+assert file_name_check("a.exe") == "Yes"
+assert file_name_check("Z9.dll") == "Yes"
+assert file_name_check("a123.txt") == "Yes"
+assert file_name_check("a1234.txt") == "No"
+assert file_name_check(".txt") == "No"
+assert file_name_check("a..txt") == "No"
+assert file_name_check("a.pdf") == "No"
+assert file_name_check("a.txtx") == "No"
+assert file_name_check("_a.txt") == "No"
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..9d2c0d146506b04914135079691fd8cd3b6bc692
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,36 @@
+def file_name_check(file_name):
+    """Return "Yes" exactly when file_name satisfies the prompt's rules."""
+    if file_name.count(".") != 1:
+        return "No"
+
+    # A valid name has at least one character, one dot, and a 3-letter suffix.
+    if len(file_name) < 5:
+        return "No"
+
+    first_code = ord(file_name[0])
+    if not (
+        (first_code >= 65 and first_code <= 90)
+        or (first_code >= 97 and first_code <= 122)
+    ):
+        return "No"
+
+    suffix = file_name[-4:]
+    if not (suffix == ".txt" or suffix == ".exe" or suffix == ".dll"):
+        return "No"
+
+    digit_count = (
+        file_name.count("0")
+        + file_name.count("1")
+        + file_name.count("2")
+        + file_name.count("3")
+        + file_name.count("4")
+        + file_name.count("5")
+        + file_name.count("6")
+        + file_name.count("7")
+        + file_name.count("8")
+        + file_name.count("9")
+    )
+    if digit_count > 3:
+        return "No"
+
+    return "Yes"
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..6007ef5d239d12bd3bcf85ff49ff77dbc1352211
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,127 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Rejection 1: anything other than exactly one dot.
+  claim
+    <k> runFileNameCheck(CS:IntSeq)
+      => str(iCons(78, iCons(111, .IntSeq))) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires charCount(CS, 46) =/=Int 1
+
+  // Rejection 2: one dot, but not enough room for a nonempty base and suffix.
+  claim
+    <k> runFileNameCheck(CS:IntSeq)
+      => str(iCons(78, iCons(111, .IntSeq))) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires charCount(CS, 46) ==Int 1
+     andBool isLen(CS) <Int 5
+
+  // Rejection 3: the first character is not an ASCII Latin letter.
+  claim
+    <k> runFileNameCheck(CS:IntSeq)
+      => str(iCons(78, iCons(111, .IntSeq))) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires charCount(CS, 46) ==Int 1
+     andBool isLen(CS) >=Int 5
+     andBool notBool latinCode(headCode(CS))
+
+  // Rejection 4: all earlier checks pass, but the extension is unsupported.
+  claim
+    <k> runFileNameCheck(CS:IntSeq)
+      => str(iCons(78, iCons(111, .IntSeq))) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires charCount(CS, 46) ==Int 1
+     andBool isLen(CS) >=Int 5
+     andBool latinCode(headCode(CS))
+     andBool notBool allowedSuffix(CS)
+
+  // Rejection 5: all structural checks pass, but there are over three digits.
+  claim
+    <k> runFileNameCheck(CS:IntSeq)
+      => str(iCons(78, iCons(111, .IntSeq))) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires charCount(CS, 46) ==Int 1
+     andBool isLen(CS) >=Int 5
+     andBool latinCode(headCode(CS))
+     andBool allowedSuffix(CS)
+     andBool digitCount(CS) >Int 3
+
+  // Acceptance: every condition in the natural-language contract holds.
+  claim
+    <k> runFileNameCheck(CS:IntSeq)
+      => str(iCons(89, iCons(101, iCons(115, .IntSeq)))) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires charCount(CS, 46) ==Int 1
+     andBool isLen(CS) >=Int 5
+     andBool latinCode(headCode(CS))
+     andBool allowedSuffix(CS)
+     andBool digitCount(CS) <=Int 3
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..daf54b818a977493f4d358dcfe8c86bfb3f0990e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,180 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Opaque observations used only by symbolic execution.  Each observation is
+  // introduced at the same K redex as the corresponding reference-semantics
+  // operation, so repeated observations of the same input remain correlated.
+  syntax Int ::= charCount(IntSeq, Int)
+    [function, total, symbol(charCount), no-evaluators]
+  syntax Int ::= headCode(IntSeq)
+    [function, total, symbol(headCode), no-evaluators]
+  syntax IntSeq ::= suffix4(IntSeq) [symbol(suffix4)]
+  syntax Bool ::= suffixIs(IntSeq, Int)
+    [function, total, symbol(suffixIs), no-evaluators]
+
+  // The implementation only calls count with one-character strings.  This is
+  // a proof abstraction of methods.k's cntSub(CS, iCons(C, .IntSeq)).
+  rule <k> #applyK(
+              toCall(boundMethodV(str(CS:IntSeq), "count")),
+              (str(iCons(C:Int, .IntSeq)), .Vals))
+        => charCount(CS, C) ... </k>
+       [priority(40)]
+
+  // This rule is reached only after the program has established length >= 5.
+  // It abstracts subscript.k's concrete first-element projection.
+  rule <k> Subscript(str(CS:IntSeq), 0)
+        => str(iCons(headCode(CS), .IntSeq)) ... </k>
+       requires isLen(CS) >=Int 5
+       [priority(40)]
+
+  // This names the value computed by the fixed [-4:] slice.  Concrete runs do
+  // not import this module and therefore execute the full reference rule.
+  rule <k> Subscript(
+              str(CS:IntSeq),
+              Slice(UnaryOp("-", Int(4)), NoBound, NoBound))
+        => str(suffix4(CS)) ... </k>
+       [priority(40)]
+
+  // Correlate the three source-level equality tests without asking the
+  // backend to decompose an opaque IntSeq projection.
+  rule <k> Compare(
+              str(suffix4(CS:IntSeq)),
+              CmpOp("==",
+                str(iCons(46, iCons(116, iCons(120, iCons(116, .IntSeq)))))))
+        => suffixIs(CS, 0) ... </k>
+       [priority(40)]
+  rule <k> Compare(
+              str(suffix4(CS:IntSeq)),
+              CmpOp("==",
+                str(iCons(46, iCons(101, iCons(120, iCons(101, .IntSeq)))))))
+        => suffixIs(CS, 1) ... </k>
+       [priority(40)]
+  rule <k> Compare(
+              str(suffix4(CS:IntSeq)),
+              CmpOp("==",
+                str(iCons(46, iCons(100, iCons(108, iCons(108, .IntSeq)))))))
+        => suffixIs(CS, 2) ... </k>
+       [priority(40)]
+
+  syntax Bool ::= latinCode(Int) [function, total]
+  rule latinCode(C:Int)
+    => ((C >=Int 65 andBool C <=Int 90)
+        orBool (C >=Int 97 andBool C <=Int 122))
+
+  syntax Bool ::= allowedSuffix(IntSeq) [function, total]
+  rule allowedSuffix(CS:IntSeq)
+    => suffixIs(CS, 0) orBool suffixIs(CS, 1) orBool suffixIs(CS, 2)
+
+  syntax Int ::= digitCount(IntSeq) [function, total]
+  rule digitCount(CS:IntSeq)
+    => charCount(CS, 48) +Int charCount(CS, 49)
+       +Int charCount(CS, 50) +Int charCount(CS, 51)
+       +Int charCount(CS, 52) +Int charCount(CS, 53)
+       +Int charCount(CS, 54) +Int charCount(CS, 55)
+       +Int charCount(CS, 56) +Int charCount(CS, 57)
+
+  // This is exactly solution.mpy, named as a function so it is auditable
+  // against the generated artifact.
+  syntax Module ::= "solutionModule" [function]
+  rule solutionModule =>
+    Module(
+      FuncDef("file_name_check", Params("file_name"),
+        Expr(
+          Str(
+            "Return \"Yes\" exactly when file_name satisfies the prompt's rules."))
+        If(Compare(
+          Call(Attribute(Name("file_name"), "count"), Str(".")),
+          CmpOp("!=", Int(1))),
+          Return(Str("No")),
+          .Stmts)
+        If(Compare(Call(Name("len"), Name("file_name")), CmpOp("<", Int(5))),
+          Return(Str("No")),
+          .Stmts)
+        Assign(
+          Name("first_code"),
+          Call(Name("ord"), Subscript(Name("file_name"), Int(0))))
+        If(UnaryOp(
+          "not",
+          BoolOp(
+            "or",
+            BoolOp(
+              "and",
+              Compare(Name("first_code"), CmpOp(">=", Int(65))),
+              Compare(Name("first_code"), CmpOp("<=", Int(90)))),
+            BoolOp(
+              "and",
+              Compare(Name("first_code"), CmpOp(">=", Int(97))),
+              Compare(Name("first_code"), CmpOp("<=", Int(122)))))),
+          Return(Str("No")),
+          .Stmts)
+        Assign(
+          Name("suffix"),
+          Subscript(
+            Name("file_name"),
+            Slice(UnaryOp("-", Int(4)), NoBound, NoBound)))
+        If(UnaryOp(
+          "not",
+          BoolOp(
+            "or",
+            Compare(Name("suffix"), CmpOp("==", Str(".txt"))),
+            Compare(Name("suffix"), CmpOp("==", Str(".exe"))),
+            Compare(Name("suffix"), CmpOp("==", Str(".dll"))))),
+          Return(Str("No")),
+          .Stmts)
+        Assign(
+          Name("digit_count"),
+          BinOp(
+            "+",
+            BinOp(
+              "+",
+              BinOp(
+                "+",
+                BinOp(
+                  "+",
+                  BinOp(
+                    "+",
+                    BinOp(
+                      "+",
+                      BinOp(
+                        "+",
+                        BinOp(
+                          "+",
+                          BinOp(
+                            "+",
+                            Call(
+                              Attribute(Name("file_name"), "count"),
+                              Str("0")),
+                            Call(
+                              Attribute(Name("file_name"), "count"),
+                              Str("1"))),
+                          Call(
+                            Attribute(Name("file_name"), "count"),
+                            Str("2"))),
+                        Call(
+                          Attribute(Name("file_name"), "count"),
+                          Str("3"))),
+                      Call(Attribute(Name("file_name"), "count"), Str("4"))),
+                    Call(Attribute(Name("file_name"), "count"), Str("5"))),
+                  Call(Attribute(Name("file_name"), "count"), Str("6"))),
+                Call(Attribute(Name("file_name"), "count"), Str("7"))),
+              Call(Attribute(Name("file_name"), "count"), Str("8"))),
+            Call(Attribute(Name("file_name"), "count"), Str("9"))))
+        If(Compare(Name("digit_count"), CmpOp(">", Int(3))),
+          Return(Str("No")),
+          .Stmts)
+        Return(Str("Yes"))))
+
+  syntax Stmts ::= moduleBody(Module) [function]
+  rule moduleBody(
+         Module(FuncDef(_F:String, Params(_PNS:ParamNames), BODY:Stmts)))
+    => BODY
+
+  syntax KItem ::= runFileNameCheck(IntSeq)
+  rule <k> runFileNameCheck(CS:IntSeq)
+        => #applyK(
+             toCall(closureVal(
+               ("file_name", .ParamNames), moduleBody(solutionModule), 0)),
+             (str(CS), .Vals)) ... </k>
+endmodule

