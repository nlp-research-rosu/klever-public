+        + file_name.count("7")
+        + file_name.count("8")
+        + file_name.count("9")
+    )
+    if digit_count > 3:
+        return "No"
+
+    return "Yes"
+
+
+assert file_name_check("example.txt") == "Yes"
+assert file_name_check("1example.dll") == "No"
