requires "unsound-interpretation.k"

module UNSOUND-INTERPRETATION-SPEC
  imports UNSOUND-INTERPRETATION

  claim
    <k> runFileNameCheck(aTxt)
      => str(iCons(78, iCons(111, .IntSeq))) </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>

