  printf '"'KOMPILE_EXIT_STATUS=%s\\n' \""'$status"
  exit "$status"
) > /audit-output/evidence/13-unsound-witness-build-2.log 2>&1
status=$?
tail -n 180 /audit-output/evidence/13-unsound-witness-build-2.log
exit "$status"' in /tmp/audit-work/unsound-witness
