+assert file_name_check("a123.txt") == "Yes"
+assert file_name_check("a1234.txt") == "No"
+assert file_name_check("a0b1c2.dll") == "Yes"
+assert file_name_check("a0b1c2d3.dll") == "No"
+'''
+
+
+def main() -> None:
+    source = SOURCE.read_text(encoding="utf-8")
