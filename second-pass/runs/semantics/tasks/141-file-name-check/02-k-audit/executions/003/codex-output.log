+
+from pathlib import Path
+
+
+SOURCE = Path("/tmp/audit-work/reconstruction/solution.py")
+OUTPUT = Path("/tmp/audit-work/reconstruction/unsound_oracle_driver.py")
+
+ASSERTIONS = r'''
+
+assert file_name_check("a.txt") == "Yes"
