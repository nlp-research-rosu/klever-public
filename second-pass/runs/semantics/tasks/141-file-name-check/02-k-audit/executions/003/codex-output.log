+        "generation_root": "dir",
+        "generation_trace": "dir",
+        "run_manifest": "file",
+        "stage1_result": "file",
+        "task_manifest": "file",
+        "translator": "file",
+        "trusted_prompt": "file",
+        "audit_campaign_lock": "file",
+    }
+    for key, expected in required_mounts.items():
