  kompile unsound-interpretation.k --backend haskell --main-module UNSOUND-INTERPRETATION --syntax-module MPY-SYNTAX --output-definition unsound-kompiled-3
  status="'$?
  printf '"'KOMPILE_EXIT_STATUS=%s\\n' \""'$status"
  exit "$status"
) > /audit-output/evidence/13-unsound-witness-build-3.log 2>&1
