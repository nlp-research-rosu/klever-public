$ nl -ba verification.k
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Opaque observations used only by symbolic execution.  Each observation is
     7	  // introduced at the same K redex as the corresponding reference-semantics
     8	  // operation, so repeated observations of the same input remain correlated.
     9	  syntax Int ::= charCount(IntSeq, Int)
    10	    [function, total, symbol(charCount), no-evaluators]
    11	  syntax Int ::= headCode(IntSeq)
    12	    [function, total, symbol(headCode), no-evaluators]
    13	  syntax IntSeq ::= suffix4(IntSeq) [symbol(suffix4)]
    14	  syntax Bool ::= suffixIs(IntSeq, Int)
    15	    [function, total, symbol(suffixIs), no-evaluators]
    16	
    17	  // The implementation only calls count with one-character strings.  This is
    18	  // a proof abstraction of methods.k's cntSub(CS, iCons(C, .IntSeq)).
    19	  rule <k> #applyK(
    20	              toCall(boundMethodV(str(CS:IntSeq), "count")),
    21	              (str(iCons(C:Int, .IntSeq)), .Vals))
    22	        => charCount(CS, C) ... </k>
    23	       [priority(40)]
    24	
    25	  // This rule is reached only after the program has established length >= 5.
    26	  // It abstracts subscript.k's concrete first-element projection.
    27	  rule <k> Subscript(str(CS:IntSeq), 0)
    28	        => str(iCons(headCode(CS), .IntSeq)) ... </k>
    29	       requires isLen(CS) >=Int 5
    30	       [priority(40)]
    31	
    32	  // This names the value computed by the fixed [-4:] slice.  Concrete runs do
    33	  // not import this module and therefore execute the full reference rule.
    34	  rule <k> Subscript(
    35	              str(CS:IntSeq),
    36	              Slice(UnaryOp("-", Int(4)), NoBound, NoBound))
    37	        => str(suffix4(CS)) ... </k>
    38	       [priority(40)]
    39	
    40	  // Correlate the three source-level equality tests without asking the
    41	  // backend to decompose an opaque IntSeq projection.
    42	  rule <k> Compare(
    43	              str(suffix4(CS:IntSeq)),
    44	              CmpOp("==",
    45	                str(iCons(46, iCons(116, iCons(120, iCons(116, .IntSeq)))))))
    46	        => suffixIs(CS, 0) ... </k>
    47	       [priority(40)]
    48	  rule <k> Compare(
    49	              str(suffix4(CS:IntSeq)),
    50	              CmpOp("==",
    51	                str(iCons(46, iCons(101, iCons(120, iCons(101, .IntSeq)))))))
    52	        => suffixIs(CS, 1) ... </k>
    53	       [priority(40)]
    54	  rule <k> Compare(
    55	              str(suffix4(CS:IntSeq)),
    56	              CmpOp("==",
    57	                str(iCons(46, iCons(100, iCons(108, iCons(108, .IntSeq)))))))
    58	        => suffixIs(CS, 2) ... </k>
    59	       [priority(40)]
    60	
    61	  syntax Bool ::= latinCode(Int) [function, total]
    62	  rule latinCode(C:Int)
    63	    => ((C >=Int 65 andBool C <=Int 90)
    64	        orBool (C >=Int 97 andBool C <=Int 122))
    65	
    66	  syntax Bool ::= allowedSuffix(IntSeq) [function, total]
    67	  rule allowedSuffix(CS:IntSeq)
    68	    => suffixIs(CS, 0) orBool suffixIs(CS, 1) orBool suffixIs(CS, 2)
    69	
    70	  syntax Int ::= digitCount(IntSeq) [function, total]
    71	  rule digitCount(CS:IntSeq)
    72	    => charCount(CS, 48) +Int charCount(CS, 49)
    73	       +Int charCount(CS, 50) +Int charCount(CS, 51)
    74	       +Int charCount(CS, 52) +Int charCount(CS, 53)
    75	       +Int charCount(CS, 54) +Int charCount(CS, 55)
    76	       +Int charCount(CS, 56) +Int charCount(CS, 57)
    77	
    78	  // This is exactly solution.mpy, named as a function so it is auditable
    79	  // against the generated artifact.
    80	  syntax Module ::= "solutionModule" [function]
    81	  rule solutionModule =>
    82	    Module(
    83	      FuncDef("file_name_check", Params("file_name"),
    84	        Expr(
    85	          Str(
    86	            "Return \"Yes\" exactly when file_name satisfies the prompt's rules."))
    87	        If(Compare(
    88	          Call(Attribute(Name("file_name"), "count"), Str(".")),
    89	          CmpOp("!=", Int(1))),
    90	          Return(Str("No")),
    91	          .Stmts)
    92	        If(Compare(Call(Name("len"), Name("file_name")), CmpOp("<", Int(5))),
    93	          Return(Str("No")),
    94	          .Stmts)
    95	        Assign(
    96	          Name("first_code"),
    97	          Call(Name("ord"), Subscript(Name("file_name"), Int(0))))
    98	        If(UnaryOp(
    99	          "not",
   100	          BoolOp(
   101	            "or",
   102	            BoolOp(
   103	              "and",
   104	              Compare(Name("first_code"), CmpOp(">=", Int(65))),
   105	              Compare(Name("first_code"), CmpOp("<=", Int(90)))),
   106	            BoolOp(
   107	              "and",
   108	              Compare(Name("first_code"), CmpOp(">=", Int(97))),
   109	              Compare(Name("first_code"), CmpOp("<=", Int(122)))))),
   110	          Return(Str("No")),
   111	          .Stmts)
   112	        Assign(
   113	          Name("suffix"),
   114	          Subscript(
   115	            Name("file_name"),
   116	            Slice(UnaryOp("-", Int(4)), NoBound, NoBound)))
   117	        If(UnaryOp(
   118	          "not",
   119	          BoolOp(
   120	            "or",
   121	            Compare(Name("suffix"), CmpOp("==", Str(".txt"))),
   122	            Compare(Name("suffix"), CmpOp("==", Str(".exe"))),
   123	            Compare(Name("suffix"), CmpOp("==", Str(".dll"))))),
   124	          Return(Str("No")),
   125	          .Stmts)
   126	        Assign(
   127	          Name("digit_count"),
   128	          BinOp(
   129	            "+",
   130	            BinOp(
   131	              "+",
   132	              BinOp(
   133	                "+",
   134	                BinOp(
   135	                  "+",
   136	                  BinOp(
   137	                    "+",
   138	                    BinOp(
   139	                      "+",
   140	                      BinOp(
   141	                        "+",
   142	                        BinOp(
   143	                          "+",
   144	                          BinOp(
   145	                            "+",
   146	                            Call(
   147	                              Attribute(Name("file_name"), "count"),
   148	                              Str("0")),
   149	                            Call(
   150	                              Attribute(Name("file_name"), "count"),
   151	                              Str("1"))),
   152	                          Call(
   153	                            Attribute(Name("file_name"), "count"),
   154	                            Str("2"))),
   155	                        Call(
   156	                          Attribute(Name("file_name"), "count"),
   157	                          Str("3"))),
   158	                      Call(Attribute(Name("file_name"), "count"), Str("4"))),
   159	                    Call(Attribute(Name("file_name"), "count"), Str("5"))),
   160	                  Call(Attribute(Name("file_name"), "count"), Str("6"))),
   161	                Call(Attribute(Name("file_name"), "count"), Str("7"))),
   162	              Call(Attribute(Name("file_name"), "count"), Str("8"))),
   163	            Call(Attribute(Name("file_name"), "count"), Str("9"))))
   164	        If(Compare(Name("digit_count"), CmpOp(">", Int(3))),
   165	          Return(Str("No")),
   166	          .Stmts)
   167	        Return(Str("Yes"))))
   168	
   169	  syntax Stmts ::= moduleBody(Module) [function]
   170	  rule moduleBody(
   171	         Module(FuncDef(_F:String, Params(_PNS:ParamNames), BODY:Stmts)))
   172	    => BODY
   173	
   174	  syntax KItem ::= runFileNameCheck(IntSeq)
   175	  rule <k> runFileNameCheck(CS:IntSeq)
   176	        => #applyK(
   177	             toCall(closureVal(
   178	               ("file_name", .ParamNames), moduleBody(solutionModule), 0)),
   179	             (str(CS), .Vals)) ... </k>
   180	endmodule
[exit 0]
