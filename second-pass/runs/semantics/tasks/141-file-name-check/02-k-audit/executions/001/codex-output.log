+def file_name_check(file_name):
+    """Return "Yes" exactly when file_name satisfies the prompt's rules."""
+    if file_name.count(".") != 1:
+        return "No"
+    if len(file_name) < 5:
+        return "No"
+    first_code = ord(file_name[0])
+    if not (
+        (first_code >= 65 and first_code <= 90)
