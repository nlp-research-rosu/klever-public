new file mode 100644
index 0000000000000000000000000000000000000000..fccac8ea22083066e51e4c8ec52997b241fa069b
--- /dev/null
+++ b/evidence/label_positive_claims.py
@@ -0,0 +1,29 @@
+#!/usr/bin/env python3
+"""Add selection labels to the six otherwise unchanged candidate claims."""
+
+from pathlib import Path
+
+
+source_path = Path("/tmp/audit-work/141-file-name-check/spec.k")
+output_path = Path("/tmp/audit-work/141-file-name-check/spec-labeled.k")
+labels = [
+    "audit-reject-dot-count",
+    "audit-reject-short",
+    "audit-reject-first",
+    "audit-reject-suffix",
+    "audit-reject-digits",
+    "audit-accept",
+]
+
+text = source_path.read_text(encoding="utf-8")
+text = text.replace("module SPEC\n", "module SPEC-LABELED\n", 1)
+text = text.replace("endmodule\n", "endmodule\n", 1)
+
+needle = "  claim\n"
+assert text.count(needle) == len(labels), text.count(needle)
+for label in labels:
+    text = text.replace(needle, f"  claim [{label}]:\n", 1)
+
+output_path.write_text(text, encoding="utf-8")
+print(output_path)
+print("\n".join(labels))
diff --git a/evidence/oracle_false_witness.k b/evidence/oracle_false_witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..df0c9d8f915535fca5b014ed3b3a9f14b75cad94
--- /dev/null
+++ b/evidence/oracle_false_witness.k
@@ -0,0 +1,42 @@
+requires "verification.k"
+
+module ORACLE-FALSE-WITNESS
+  imports VERIFICATION
+
+  // The real candidate and canonical Python functions both return "No" for
+  // "a.pdf".  The proof extension can nonetheless interpret its unconstrained
+  // observations so that the acceptance path is taken.
+  claim [a-pdf-wrongly-accepted]:
+    <k>
+      runFileNameCheck(
+        iCons(97, iCons(46, iCons(112, iCons(100, iCons(102, .IntSeq))))))
+      => str(iCons(89, iCons(101, iCons(115, .IntSeq))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      charCount(
+        iCons(97, iCons(46, iCons(112, iCons(100, iCons(102, .IntSeq))))),
+        46) ==Int 1
+      andBool isLen(
+        iCons(97, iCons(46, iCons(112, iCons(100, iCons(102, .IntSeq))))))
+        >=Int 5
+      andBool latinCode(
+        headCode(
+          iCons(97, iCons(46, iCons(112, iCons(100, iCons(102, .IntSeq)))))))
+      andBool allowedSuffix(
+        iCons(97, iCons(46, iCons(112, iCons(100, iCons(102, .IntSeq))))))
+      andBool digitCount(
+        iCons(97, iCons(46, iCons(112, iCons(100, iCons(102, .IntSeq))))))
+        <=Int 3
+endmodule
diff --git a/evidence/oracle_precondition_sat.smt2 b/evidence/oracle_precondition_sat.smt2
