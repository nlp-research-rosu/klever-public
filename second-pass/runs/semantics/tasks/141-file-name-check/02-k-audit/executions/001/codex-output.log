+#!/usr/bin/env bash
+set -uo pipefail
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+scratch=/tmp/audit-work/141-file-name-check
+run mkdir -p "$scratch"
+run cp /candidate/solution.py "$scratch/solution.py"
+run cp /candidate/solution.mpy "$scratch/submitted-solution.mpy"
