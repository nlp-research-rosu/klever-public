printf '"'[exit %d]\\n' \""'$status" | tee -a "$log"
printf '"'"'$ kprove bridge_false_witnesses.k --definition verification-kompiled --spec-module BRIDGE-FALSE-WITNESSES --dry-run'"\\n' | tee -a \""'$log"
kprove bridge_false_witnesses.k --definition verification-kompiled --spec-module BRIDGE-FALSE-WITNESSES --dry-run 2>&1 | tee -a "$log"
status=${PIPESTATUS[0]}
printf '"'[exit %d]\\n' \""'$status" | tee -a "$log"
if [ "$status" -ne 0 ]; then exit "$status"; fi
printf '"'"'$ kprove bridge_false_witnesses.k --definition verification-kompiled --spec-module BRIDGE-FALSE-WITNESSES'"\\n' | tee -a \""'$log"
kprove bridge_false_witnesses.k --definition verification-kompiled --spec-module BRIDGE-FALSE-WITNESSES 2>&1 | tee -a "$log"
status=${PIPESTATUS[0]}
printf '"'[exit %d]\\n' \""'$status" | tee -a "$log"
exit "$status"' in /tmp/audit-work/141-file-name-check
