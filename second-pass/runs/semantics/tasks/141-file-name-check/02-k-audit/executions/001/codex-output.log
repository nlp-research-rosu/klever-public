+assert file_name_check("a..txt") == "No"
+assert file_name_check("a.pdf") == "No"
+assert file_name_check("_a.txt") == "No"
+assert file_name_check("é.txt") == "No"
+assert file_name_check("a١٢٣٤.txt") == "Yes"
