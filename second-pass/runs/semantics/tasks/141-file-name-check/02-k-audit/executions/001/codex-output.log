  exit_status=0
  grep -qx '"'#Top' \""'$file" || top_status=$?
  grep -qx '"'\\[exit 0\\]' \""'$file" || exit_status=$?
  if [ "$top_status" -ne 0 ] || [ "$exit_status" -ne 0 ]; then overall=1; fi
