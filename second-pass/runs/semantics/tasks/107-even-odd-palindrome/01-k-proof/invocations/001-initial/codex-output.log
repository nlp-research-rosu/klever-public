+        Assign(Name("even"),
+          BinOp("+", Int(8),
+            BinOp("*", Int(10),
+              BinOp("//",
+                BinOp("-", Name("hundreds"), Int(1)),
+                Int(2)))))
+        Assign(Name("odd"),
+          BinOp("+", Int(10),
+            BinOp("*", Int(10),
+              BinOp("//", Name("hundreds"), Int(2)))))
+        If(
