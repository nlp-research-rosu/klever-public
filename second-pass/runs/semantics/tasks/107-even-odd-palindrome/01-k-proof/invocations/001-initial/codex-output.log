+
+    if n == 1000:
+        return (48, 60)
+
+    hundreds = n // 100
+    current_block = (n % 100 - hundreds) // 10 + 1
+    even = 8 + 10 * ((hundreds - 1) // 2)
+    odd = 10 + 10 * (hundreds // 2)
+
+    if hundreds % 2 == 0:
+        even += current_block
+    else:
+        odd += current_block
+
+    return (even, odd)
