Module(
  FuncDef("even_odd_palindrome", Params("n"),
    If(Compare(Name("n"), CmpOp("<", Int(10))),
      Return(
        TupleExpr(
          BinOp("//", Name("n"), Int(2)),
          BinOp("//", BinOp("+", Name("n"), Int(1)), Int(2)))),
      )
    If(Compare(Name("n"), CmpOp("<", Int(100))),
      Assign(Name("two_digit"), BinOp("//", Name("n"), Int(11)))
      Return(
        TupleExpr(
          BinOp("+", Int(4), BinOp("//", Name("two_digit"), Int(2))),
          BinOp(
            "+",
            Int(5),
            BinOp("//", BinOp("+", Name("two_digit"), Int(1)), Int(2))))),
      )
    If(Compare(Name("n"), CmpOp("==", Int(1000))),
      Return(TupleExpr(Int(48), Int(60))),
      )
    Assign(Name("hundreds"), BinOp("//", Name("n"), Int(100)))
    Assign(
      Name("current_block"),
      BinOp(
        "+",
        BinOp(
          "//",
          BinOp("-", BinOp("%", Name("n"), Int(100)), Name("hundreds")),
          Int(10)),
        Int(1)))
    Assign(
      Name("even"),
      BinOp(
        "+",
        Int(8),
        BinOp(
          "*",
          Int(10),
          BinOp("//", BinOp("-", Name("hundreds"), Int(1)), Int(2)))))
    Assign(
      Name("odd"),
      BinOp(
        "+",
        Int(10),
        BinOp("*", Int(10), BinOp("//", Name("hundreds"), Int(2)))))
    If(Compare(BinOp("%", Name("hundreds"), Int(2)), CmpOp("==", Int(0))),
      AugAssign(Name("even"), "+", Name("current_block")),
      AugAssign(Name("odd"), "+", Name("current_block")))
    Return(TupleExpr(Name("even"), Name("odd"))))
  Assert(
    Compare(
      Call(Name("even_odd_palindrome"), Int(1)),
      CmpOp("==", TupleExpr(Int(0), Int(1)))))
  Assert(
    Compare(
      Call(Name("even_odd_palindrome"), Int(3)),
      CmpOp("==", TupleExpr(Int(1), Int(2)))))
  Assert(
    Compare(
      Call(Name("even_odd_palindrome"), Int(9)),
      CmpOp("==", TupleExpr(Int(4), Int(5)))))
  Assert(
    Compare(
      Call(Name("even_odd_palindrome"), Int(10)),
      CmpOp("==", TupleExpr(Int(4), Int(5)))))
  Assert(
    Compare(
      Call(Name("even_odd_palindrome"), Int(12)),
      CmpOp("==", TupleExpr(Int(4), Int(6)))))
  Assert(
    Compare(
      Call(Name("even_odd_palindrome"), Int(99)),
      CmpOp("==", TupleExpr(Int(8), Int(10)))))
  Assert(
    Compare(
      Call(Name("even_odd_palindrome"), Int(100)),
      CmpOp("==", TupleExpr(Int(8), Int(10)))))
  Assert(
    Compare(
      Call(Name("even_odd_palindrome"), Int(111)),
      CmpOp("==", TupleExpr(Int(8), Int(12)))))
  Assert(
    Compare(
      Call(Name("even_odd_palindrome"), Int(222)),
      CmpOp("==", TupleExpr(Int(11), Int(20)))))
  Assert(
    Compare(
      Call(Name("even_odd_palindrome"), Int(999)),
      CmpOp("==", TupleExpr(Int(48), Int(60)))))
  Assert(
    Compare(
      Call(Name("even_odd_palindrome"), Int(1000)),
      CmpOp("==", TupleExpr(Int(48), Int(60))))))
