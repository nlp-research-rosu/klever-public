===== reference-semantics/semantics/tuple.k
     1	// reference/src/semantics/tuple.k — MPY-TUPLE
     2	
     3	module MPY-TUPLE
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	  imports MPY-LIST
     7	  imports MPY-METHODS
     8	
     9	  // ==== iteration (the iterator protocol's tuple case) ======================
    10	  rule <k> #iterNext(tuple(.ValSeq))                => #iterDone ... </k>
    11	  rule <k> #iterNext(tuple(vCons(V:Val, R:ValSeq))) => #iterYield(V, tuple(R)) ... </k>
    12	
    13	  // ==== TupleExpr: tuple(ValSeq) literal + == != ===========================
    14	  syntax ApplyK ::= "toTuple"
    15	  rule <k> TupleExpr(ES:Exprs) => #evalArgs(ES, .Vals, toTuple) ... </k>
    16	  rule <k> #applyK(toTuple, ACC:Vals) => tuple(vals2valSeq(ACC)) ... </k>
    17	
    18	  rule applyCmp("==", tuple(A:ValSeq), tuple(B:ValSeq)) => A ==K B
    19	  // membership routes through the same k-cell fold as lists (list.k)
    20	  rule <k> Compare(LV:Val, CmpOp("in",     tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ... </k>
    21	  rule <k> Compare(LV:Val, CmpOp("not in", tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ~> #notB ... </k>
    22	  // t.index(v): first index of v (ValueError out of subset)
    23	  rule applyMethod(tuple(VS:ValSeq), "index", V:Val, .Vals) => idxOfVS(VS, V, 0)
    24	  syntax Int ::= idxOfVS(ValSeq, Val, Int) [function]
    25	  rule idxOfVS(vCons(A:Val, _:ValSeq), V:Val, I:Int) => I requires A ==K V
    26	  rule idxOfVS(vCons(A:Val, R:ValSeq), V:Val, I:Int) => idxOfVS(R, V, I +Int 1)
    27	       requires notBool (A ==K V)
    28	  rule applyCmp("!=", tuple(A:ValSeq), tuple(B:ValSeq)) => notBool (A ==K B)
    29	
    30	  // ==== target binding: bind a Name or a TupleExpr target to a value ========
    31	  syntax KItem ::= #bindTgt(Expr, Val)
    32	  rule <k> #bindTgt(Name(X:String), V:Val) => .K ... </k>
    33	       <env> L:Int </env>
    34	       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>
    35	  rule <k> #bindTgt(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>
    36	       <env> L:Int </env>
    37	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    38	       requires "$cells" in_keys(M)
    39	        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
    40	        andBool X in_keys(M) andBool isCellRef({M[X]}:>Val)
    41	       [priority(40)]
    42	  rule <k> #bindTgt(TupleExpr(TS:Exprs), tuple(VS:ValSeq)) => #unpackSeq(TS, VS) ... </k>
    43	  rule <k> #bindTgt(TupleExpr(TS:Exprs), list(VS:ValSeq))  => #unpackSeq(TS, VS) ... </k>
    44	  rule <k> #bindTgt(TupleExpr(TS:Exprs), ref(H:Int)) => #bindTgt(TupleExpr(TS), V) ... </k>
    45	       <heap> ... H |-> V:Val ... </heap>
    46	       [priority(40)]
    47	
    48	  // ==== unpacking: a, b = <tuple|list> (RHS evaluated by strictness) ========
    49	  syntax KItem ::= #unpackSeq(Exprs, ValSeq)
    50	  rule <k> Assign(TupleExpr(TS:Exprs), tuple(VS:ValSeq)) => #unpackSeq(TS, VS) ... </k>
    51	  rule <k> Assign(TupleExpr(TS:Exprs), list(VS:ValSeq))  => #unpackSeq(TS, VS) ... </k>
    52	  rule <k> Assign(TupleExpr(TS:Exprs), ref(H:Int)) => Assign(TupleExpr(TS), V) ... </k>
    53	       <heap> ... H |-> V:Val ... </heap>
    54	       [priority(40)]
    55	  rule <k> #unpackSeq((T:Expr, TS:Exprs), vCons(V:Val, VS:ValSeq))
    56	        => #bindTgt(T, V) ~> #unpackSeq(TS, VS) ... </k>
    57	  rule <k> #unpackSeq(.Exprs, .ValSeq) => .K ... </k>
    58	endmodule
===== verification.k
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // The translated solution, exposed as a closed module term for both the
     7	  // concrete harness and the reachability claims.
     8	  syntax Stmts ::= "solutionBody" [function]
     9	  rule solutionBody =>
    10	        If(Compare(Name("n"), CmpOp("<", Int(10))),
    11	          Return(
    12	            TupleExpr(
    13	              BinOp("//", Name("n"), Int(2)),
    14	              BinOp("//", BinOp("+", Name("n"), Int(1)), Int(2)))),
    15	          .Stmts)
    16	        If(Compare(Name("n"), CmpOp("<", Int(100))),
    17	          Assign(Name("two_digit"), BinOp("//", Name("n"), Int(11)))
    18	          Return(
    19	            TupleExpr(
    20	              BinOp("+", Int(4),
    21	                BinOp("//", Name("two_digit"), Int(2))),
    22	              BinOp("+", Int(5),
    23	                BinOp("//",
    24	                  BinOp("+", Name("two_digit"), Int(1)),
    25	                  Int(2))))),
    26	          .Stmts)
    27	        If(Compare(Name("n"), CmpOp("==", Int(1000))),
    28	          Return(TupleExpr(Int(48), Int(60))),
    29	          .Stmts)
    30	        Assign(Name("hundreds"),
    31	          BinOp("//", Name("n"), Int(100)))
    32	        Assign(Name("current_block"),
    33	          BinOp("+",
    34	            BinOp("//",
    35	              BinOp("-",
    36	                BinOp("%", Name("n"), Int(100)),
    37	                Name("hundreds")),
    38	              Int(10)),
    39	            Int(1)))
    40	        Assign(Name("even"),
    41	          BinOp("+", Int(8),
    42	            BinOp("*", Int(10),
    43	              BinOp("//",
    44	                BinOp("-", Name("hundreds"), Int(1)),
    45	                Int(2)))))
    46	        Assign(Name("odd"),
    47	          BinOp("+", Int(10),
    48	            BinOp("*", Int(10),
    49	              BinOp("//", Name("hundreds"), Int(2)))))
    50	        If(
    51	          Compare(
    52	            BinOp("%", Name("hundreds"), Int(2)),
    53	            CmpOp("==", Int(0))),
    54	          AugAssign(Name("even"), "+", Name("current_block")),
    55	          AugAssign(Name("odd"), "+", Name("current_block")))
    56	        Return(TupleExpr(Name("even"), Name("odd")))
    57	
    58	  syntax Module ::= "solutionModule" [function]
    59	  rule solutionModule =>
    60	    Module(
    61	      FuncDef(
    62	        "even_odd_palindrome",
    63	        Params("n"),
    64	        solutionBody))
    65	
    66	  // Start from the standard initial configuration, install the definition,
    67	  // and call the required entry point on N.
    68	  syntax KItem ::= "#runEvenOdd" "(" Int ")"
    69	  rule #runEvenOdd(N:Int) =>
    70	    #loadAll(solutionModule)
    71	    ~> Call(Name("even_odd_palindrome"), N)
    72	
    73	  // Mathematical specification.  For three-digit inputs H is the leading
    74	  // digit and C is the number of H?H palindromes not exceeding N.
    75	  syntax Int ::= leadingDigit(Int) [function, total]
    76	  rule leadingDigit(N:Int) => N /Int 100
    77	
    78	  syntax Int ::= currentBlock(Int) [function, total]
    79	  rule currentBlock(N:Int) =>
    80	    (N %Int 100 -Int leadingDigit(N) +Int 10) /Int 10
    81	
    82	  syntax Int ::= evenPalindromes(Int) [function]
    83	  rule evenPalindromes(N:Int) => N /Int 2
    84	    requires 1 <=Int N andBool N <Int 10
    85	  rule evenPalindromes(N:Int) => 4 +Int (N /Int 11) /Int 2
    86	    requires 10 <=Int N andBool N <Int 100
    87	  rule evenPalindromes(N:Int) =>
    88	      8
    89	      +Int 10 *Int ((leadingDigit(N) -Int 1) /Int 2)
    90	      +Int (#if leadingDigit(N) %Int 2 ==Int 0
    91	            #then currentBlock(N) #else 0 #fi)
    92	    requires 100 <=Int N andBool N <Int 1000
    93	  rule evenPalindromes(1000) => 48
    94	
    95	  syntax Int ::= oddPalindromes(Int) [function]
    96	  rule oddPalindromes(N:Int) => (N +Int 1) /Int 2
    97	    requires 1 <=Int N andBool N <Int 10
    98	  rule oddPalindromes(N:Int) =>
    99	      5 +Int ((N /Int 11) +Int 1) /Int 2
   100	    requires 10 <=Int N andBool N <Int 100
   101	  rule oddPalindromes(N:Int) =>
   102	      10
   103	      +Int 10 *Int (leadingDigit(N) /Int 2)
   104	      +Int (#if leadingDigit(N) %Int 2 ==Int 1
   105	            #then currentBlock(N) #else 0 #fi)
   106	    requires 100 <=Int N andBool N <Int 1000
   107	  rule oddPalindromes(1000) => 60
   108	
   109	endmodule
