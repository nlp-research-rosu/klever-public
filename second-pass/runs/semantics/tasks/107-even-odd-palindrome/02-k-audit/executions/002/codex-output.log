diff --git a//tmp/audit-work/107-even-odd-palindrome/spec-vacuity.k b//tmp/audit-work/107-even-odd-palindrome/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..381160f956ed95a56d8bf45091c3cbfb8719c89f
