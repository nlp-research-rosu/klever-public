+def kind(path: Path) -> str:
+    mode = path.lstat().st_mode
+    if path.is_symlink():
+        return "symlink"
+    if path.is_file():
+        return "file"
+    if path.is_dir():
+        return "dir"
+    return f"other({mode:o})"
+
+
