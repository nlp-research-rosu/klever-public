     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // The translated solution, exposed as a closed module term for both the
     7	  // concrete harness and the reachability claims.
     8	  syntax Stmts ::= "solutionBody" [function]
     9	  rule solutionBody =>
    10	        If(Compare(Name("n"), CmpOp("<", Int(10))),
    11	          Return(
    12	            TupleExpr(
    13	              BinOp("//", Name("n"), Int(2)),
    14	              BinOp("//", BinOp("+", Name("n"), Int(1)), Int(2)))),
    15	          .Stmts)
    16	        If(Compare(Name("n"), CmpOp("<", Int(100))),
    17	          Assign(Name("two_digit"), BinOp("//", Name("n"), Int(11)))
    18	          Return(
    19	            TupleExpr(
    20	              BinOp("+", Int(4),
    21	                BinOp("//", Name("two_digit"), Int(2))),
    22	              BinOp("+", Int(5),
    23	                BinOp("//",
    24	                  BinOp("+", Name("two_digit"), Int(1)),
    25	                  Int(2))))),
    26	          .Stmts)
    27	        If(Compare(Name("n"), CmpOp("==", Int(1000))),
    28	          Return(TupleExpr(Int(48), Int(60))),
    29	          .Stmts)
    30	        Assign(Name("hundreds"),
    31	          BinOp("//", Name("n"), Int(100)))
    32	        Assign(Name("current_block"),
    33	          BinOp("+",
    34	            BinOp("//",
    35	              BinOp("-",
    36	                BinOp("%", Name("n"), Int(100)),
    37	                Name("hundreds")),
    38	              Int(10)),
    39	            Int(1)))
    40	        Assign(Name("even"),
    41	          BinOp("+", Int(8),
    42	            BinOp("*", Int(10),
    43	              BinOp("//",
    44	                BinOp("-", Name("hundreds"), Int(1)),
    45	                Int(2)))))
    46	        Assign(Name("odd"),
    47	          BinOp("+", Int(10),
    48	            BinOp("*", Int(10),
    49	              BinOp("//", Name("hundreds"), Int(2)))))
    50	        If(
    51	          Compare(
    52	            BinOp("%", Name("hundreds"), Int(2)),
    53	            CmpOp("==", Int(0))),
    54	          AugAssign(Name("even"), "+", Name("current_block")),
    55	          AugAssign(Name("odd"), "+", Name("current_block")))
    56	        Return(TupleExpr(Name("even"), Name("odd")))
    57	
    58	  syntax Module ::= "solutionModule" [function]
    59	  rule solutionModule =>
    60	    Module(
    61	      FuncDef(
    62	        "even_odd_palindrome",
    63	        Params("n"),
    64	        solutionBody))
    65	
    66	  // Start from the standard initial configuration, install the definition,
    67	  // and call the required entry point on N.
    68	  syntax KItem ::= "#runEvenOdd" "(" Int ")"
    69	  rule #runEvenOdd(N:Int) =>
    70	    #loadAll(solutionModule)
    71	    ~> Call(Name("even_odd_palindrome"), N)
    72	
    73	  // Mathematical specification.  For three-digit inputs H is the leading
    74	  // digit and C is the number of H?H palindromes not exceeding N.
    75	  syntax Int ::= leadingDigit(Int) [function, total]
    76	  rule leadingDigit(N:Int) => N /Int 100
    77	
    78	  syntax Int ::= currentBlock(Int) [function, total]
    79	  rule currentBlock(N:Int) =>
    80	    (N %Int 100 -Int leadingDigit(N) +Int 10) /Int 10
    81	
    82	  syntax Int ::= evenPalindromes(Int) [function]
    83	  rule evenPalindromes(N:Int) => N /Int 2
    84	    requires 1 <=Int N andBool N <Int 10
    85	  rule evenPalindromes(N:Int) => 4 +Int (N /Int 11) /Int 2
    86	    requires 10 <=Int N andBool N <Int 100
    87	  rule evenPalindromes(N:Int) =>
    88	      8
    89	      +Int 10 *Int ((leadingDigit(N) -Int 1) /Int 2)
    90	      +Int (#if leadingDigit(N) %Int 2 ==Int 0
    91	            #then currentBlock(N) #else 0 #fi)
    92	    requires 100 <=Int N andBool N <Int 1000
    93	  rule evenPalindromes(1000) => 48
    94	
    95	  syntax Int ::= oddPalindromes(Int) [function]
    96	  rule oddPalindromes(N:Int) => (N +Int 1) /Int 2
    97	    requires 1 <=Int N andBool N <Int 10
    98	  rule oddPalindromes(N:Int) =>
    99	      5 +Int ((N /Int 11) +Int 1) /Int 2
   100	    requires 10 <=Int N andBool N <Int 100
   101	  rule oddPalindromes(N:Int) =>
   102	      10
   103	      +Int 10 *Int (leadingDigit(N) /Int 2)
   104	      +Int (#if leadingDigit(N) %Int 2 ==Int 1
   105	            #then currentBlock(N) #else 0 #fi)
   106	    requires 100 <=Int N andBool N <Int 1000
   107	  rule oddPalindromes(1000) => 60
