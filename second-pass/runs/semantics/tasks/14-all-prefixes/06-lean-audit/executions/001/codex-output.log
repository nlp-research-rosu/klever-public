+        len(set(manifest_ids)),
+        len(manifest_ids),
+    ),
+    check(
+        "validated classification inventory covers every rule",
+        sum(
+            len(validated[key])
+            for key in (
+                "definitions",
+                "operational_rules",
+                "proved_derived_lemmas",
+                "domain_lemmas",
+            )
+        ),
+        len(inventory["rules"]),
+    ),
+    check(
