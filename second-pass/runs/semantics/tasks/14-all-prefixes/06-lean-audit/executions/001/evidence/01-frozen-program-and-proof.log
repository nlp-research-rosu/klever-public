     4	def all_prefixes(string: str) -> List[str]:
     5	    """Return all nonempty prefixes of string, shortest first."""
     6	    prefixes = []
     7	    for end in range(1, len(string) + 1):
     8	        prefixes.append(string[:end])
     9	    return prefixes
     1	Module(
     2	  ImportFrom("typing", "List")
     3	  FuncDef("all_prefixes", Params("string"),
     4	    Expr(Str("Return all nonempty prefixes of string, shortest first."))
     5	    Assign(Name("prefixes"), ListExpr())
     6	    For(Name("end"), Call(
     7	      Name("range"),
     8	      Int(1),
     9	      BinOp("+", Call(Name("len"), Name("string")), Int(1))),
    10	      Expr(
    11	        Call(
    12	          Attribute(Name("prefixes"), "append"),
    13	          Subscript(
    14	            Name("string"),
    15	            Slice(NoBound, Name("end"), NoBound)))))
    16	    Return(Name("prefixes"))))
