     5	
     6	  // The mathematical result of finishing the source loop from END to STOP,
     7	  // starting with accumulator ACC.  doSlice is the reference semantics'
     8	  // definition of Python slicing, so this definition also covers empty and
     9	  // out-of-range slice bounds without an extra assumption.
    10	  syntax ValSeq ::= prefixesAcc(IntSeq, Int, Int, ValSeq) [function]
    11	  rule prefixesAcc(S:IntSeq, END:Int, STOP:Int, ACC:ValSeq)
    12	    => prefixesAcc(
    13	         S,
    14	         END +Int 1,
    15	         STOP,
    16	         valSeqConcat(
    17	           ACC,
    18	           vCons(doSlice(str(S), noB, someB(END), noB), .ValSeq)))
    19	    requires END <Int STOP
    20	  rule prefixesAcc(_:IntSeq, END:Int, STOP:Int, ACC:ValSeq) => ACC
    21	    requires END >=Int STOP
