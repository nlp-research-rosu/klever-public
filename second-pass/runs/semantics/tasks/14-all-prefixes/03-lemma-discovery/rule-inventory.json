{
  "inventory_sha256": "40e9769bf470a35269735642ec44dc37c797d993482694c8a07eac9ce74bc559",
  "rules": [
    {
      "attributes": [],
      "end_line": 19,
      "module": "VERIFICATION",
      "normalized_sha256": "304d2987c766d8fd47b4acd75d897a4990ad3f33be34064740db13cb12cd7973",
      "source_rule_id": "rule-304d2987c766d8fd47b4acd75d897a4990ad3f33be34064740db13cb12cd7973",
      "start_line": 11,
      "text": "  rule prefixesAcc(S:IntSeq, END:Int, STOP:Int, ACC:ValSeq)\n    => prefixesAcc(\n         S,\n         END +Int 1,\n         STOP,\n         valSeqConcat(\n           ACC,\n           vCons(doSlice(str(S), noB, someB(END), noB), .ValSeq)))\n    requires END <Int STOP"
    },
    {
      "attributes": [],
      "end_line": 21,
      "module": "VERIFICATION",
      "normalized_sha256": "a73447fc9c4a07cb4db21f913f63ec0a12d22016eaa29d60d69da2c2c09b3343",
      "source_rule_id": "rule-a73447fc9c4a07cb4db21f913f63ec0a12d22016eaa29d60d69da2c2c09b3343",
      "start_line": 20,
      "text": "  rule prefixesAcc(_:IntSeq, END:Int, STOP:Int, ACC:ValSeq) => ACC\n    requires END >=Int STOP"
    },
    {
      "attributes": [],
      "end_line": 25,
      "module": "VERIFICATION",
      "normalized_sha256": "b463ecc1fcafb4659695aa4718142d96b6f1fb9af4b47865ad8c2e1c23aa465d",
      "source_rule_id": "rule-b463ecc1fcafb4659695aa4718142d96b6f1fb9af4b47865ad8c2e1c23aa465d",
      "start_line": 24,
      "text": "  rule allPrefixes(S:IntSeq)\n    => prefixesAcc(S, 1, isLen(S) +Int 1, .ValSeq)"
    },
    {
      "attributes": [],
      "end_line": 36,
      "module": "VERIFICATION",
      "normalized_sha256": "4b8d3d3d4f7336421c9303880f0fb545ba0266b6523b5a08d9004f09ac25eb6c",
      "source_rule_id": "rule-4b8d3d3d4f7336421c9303880f0fb545ba0266b6523b5a08d9004f09ac25eb6c",
      "start_line": 30,
      "text": "  rule allPrefixesLoopBody()\n    => Expr(Call(\n         Attribute(Name(\"prefixes\"), \"append\"),\n         Subscript(\n           Name(\"string\"),\n           Slice(NoBound, Name(\"end\"), NoBound))))\n       .Stmts"
    },
    {
      "attributes": [],
      "end_line": 50,
      "module": "VERIFICATION",
      "normalized_sha256": "7c22c576e8210ec39056f4e4da36810495c640312df98f28d9c8d2bbd7ce68a6",
      "source_rule_id": "rule-7c22c576e8210ec39056f4e4da36810495c640312df98f28d9c8d2bbd7ce68a6",
      "start_line": 39,
      "text": "  rule allPrefixesBody()\n    => Expr(Str(\"Return all nonempty prefixes of string, shortest first.\"))\n       Assign(Name(\"prefixes\"), ListExpr(.Exprs))\n       For(\n         Name(\"end\"),\n         Call(\n           Name(\"range\"),\n           Int(1),\n           BinOp(\"+\", Call(Name(\"len\"), Name(\"string\")), Int(1))),\n         allPrefixesLoopBody())\n       Return(Name(\"prefixes\"))\n       .Stmts"
    },
    {
      "attributes": [],
      "end_line": 54,
      "module": "VERIFICATION",
      "normalized_sha256": "8e477bcfeff61e45ce366cc0bc9c0d31da737fcc36a3d3245a97fe3999a4b623",
      "source_rule_id": "rule-8e477bcfeff61e45ce366cc0bc9c0d31da737fcc36a3d3245a97fe3999a4b623",
      "start_line": 53,
      "text": "  rule allPrefixesDef()\n    => FuncDef(\"all_prefixes\", Params(\"string\"), allPrefixesBody())"
    },
    {
      "attributes": [],
      "end_line": 58,
      "module": "VERIFICATION",
      "normalized_sha256": "eca51dfe7c73830a4d8f1299f6714500181d4e7011cddec0c87182f65d948a14",
      "source_rule_id": "rule-eca51dfe7c73830a4d8f1299f6714500181d4e7011cddec0c87182f65d948a14",
      "start_line": 57,
      "text": "  rule solutionModule()\n    => Module(ImportFrom(\"typing\", \"List\") allPrefixesDef())"
    }
  ],
