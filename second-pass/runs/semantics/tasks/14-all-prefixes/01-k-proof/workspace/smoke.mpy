Module(
  FuncDef("all_prefixes", Params("string"),
    Assign(Name("prefixes"), ListExpr())
    For(Name("end"), Call(
      Name("range"),
      Int(1),
      BinOp("+", Call(Name("len"), Name("string")), Int(1))),
      Expr(
        Call(
          Attribute(Name("prefixes"), "append"),
          Subscript(
            Name("string"),
            Slice(NoBound, Name("end"), NoBound)))))
    Return(Name("prefixes")))
  Assert(
    Compare(
      Call(Name("all_prefixes"), Str("")),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("all_prefixes"), Str("a")),
      CmpOp("==", ListExpr(Str("a")))))
  Assert(
    Compare(
      Call(Name("all_prefixes"), Str("abc")),
      CmpOp("==", ListExpr(Str("a"), Str("ab"), Str("abc"))))))
