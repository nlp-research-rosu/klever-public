index 0000000000000000000000000000000000000000..dd28d0771ec065b28ad291211277d391b2c11328
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,39 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant.  At a recursive loop head, `end` is the preceding index;
+  // after the loop it is STOP - 1, and the heap list is the specified fold.
+  claim
+    <k>
+      #loop(
+        rangeObj(END:Int, STOP:Int, 1),
+        Name("end"),
+        allPrefixesLoopBody()) ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        "end" |-> END -Int 1
+        "prefixes" |-> ref(H:Int)
+        "string" |-> str(S:IntSeq)
+        REST:Map,
+        P:Parent)
+      => SC
+         L |-> scope(
+           "end" |-> STOP -Int 1
+           "prefixes" |-> ref(H)
+           "string" |-> str(S)
+           REST,
+           P)
+    </scopes>
+    <heap>
+      HP:Map H |-> list(ACC:ValSeq)
+      => HP H |-> list(prefixesAcc(S, END, STOP, ACC))
+    </heap>
+    requires END <=Int STOP
+     andBool notBool ("$cells" in_keys(REST))
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..bb0131f7f2a39030cc6a3d7ae7a2ec6203080ced
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,55 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The mathematical result of finishing the source loop from END to STOP,
+  // starting with accumulator ACC.  doSlice is the reference semantics'
+  // definition of Python slicing, so this definition also covers empty and
+  // out-of-range slice bounds without an extra assumption.
+  syntax ValSeq ::= prefixesAcc(IntSeq, Int, Int, ValSeq) [function]
+  rule prefixesAcc(S:IntSeq, END:Int, STOP:Int, ACC:ValSeq)
+    => prefixesAcc(
+         S,
+         END +Int 1,
+         STOP,
+         valSeqConcat(
+           ACC,
+           vCons(doSlice(str(S), noB, someB(END), noB), .ValSeq)))
+    requires END <Int STOP
+  rule prefixesAcc(_:IntSeq, END:Int, STOP:Int, ACC:ValSeq) => ACC
+    requires END >=Int STOP
+
+  syntax ValSeq ::= allPrefixes(IntSeq) [function]
+  rule allPrefixes(S:IntSeq)
+    => prefixesAcc(S, 1, isLen(S) +Int 1, .ValSeq)
+
+  // Constructor terms copied exactly from solution.mpy.  Keeping them named
+  // makes the claims readable while still executing the translated program.
+  syntax Stmts ::= allPrefixesLoopBody() [function, total]
+  rule allPrefixesLoopBody()
+    => Expr(Call(
+         Attribute(Name("prefixes"), "append"),
+         Subscript(
+           Name("string"),
+           Slice(NoBound, Name("end"), NoBound))))
+       .Stmts
+
+  syntax Stmts ::= allPrefixesBody() [function, total]
+  rule allPrefixesBody()
+    => Expr(Str("Return all nonempty prefixes of string, shortest first."))
+       Assign(Name("prefixes"), ListExpr(.Exprs))
+       For(
+         Name("end"),
+         Call(
+           Name("range"),
+           Int(1),
+           BinOp("+", Call(Name("len"), Name("string")), Int(1))),
+         allPrefixesLoopBody())
+       Return(Name("prefixes"))
+       .Stmts
+
+  syntax Stmt ::= allPrefixesDef() [function, total]
+  rule allPrefixesDef()
+    => FuncDef("all_prefixes", Params("string"), allPrefixesBody())
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC' in /work
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..9183f8e7604defdbfb983d199fb6b71eca10ca51
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,10 @@
+def all_prefixes(string):
+    prefixes = []
+    for end in range(1, len(string) + 1):
+        prefixes.append(string[:end])
+    return prefixes
+
+
+assert all_prefixes("") == []
+assert all_prefixes("a") == ["a"]
+assert all_prefixes("abc") == ["a", "ab", "abc"]
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..8002bcb6c54611a8c890088f3f4d974806f1f025
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+from typing import List
+
+
+def all_prefixes(string: str) -> List[str]:
+    """Return all nonempty prefixes of string, shortest first."""
+    prefixes = []
+    for end in range(1, len(string) + 1):
+        prefixes.append(string[:end])
+    return prefixes
