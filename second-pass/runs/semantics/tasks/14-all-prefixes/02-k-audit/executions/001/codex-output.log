diff --git a/evidence/program-pinning.k b/evidence/program-pinning.k
new file mode 100644
index 0000000000000000000000000000000000000000..968ce126232190782fb70e5d37603d82f8c7d8df
--- /dev/null
+++ b/evidence/program-pinning.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module PROGRAM-PINNING
+  imports VERIFICATION
+
+  // Reviewer-side direct comparison of the named term used by the entry claim
+  // with the trusted-translator output in submitted solution.mpy.
+  claim
+    solutionModule()
+    =>
+    Module(
+      ImportFrom("typing", "List")
+      FuncDef("all_prefixes", Params("string"),
+        Expr(Str("Return all nonempty prefixes of string, shortest first."))
+        Assign(Name("prefixes"), ListExpr())
+        For(Name("end"), Call(
+          Name("range"),
+          Int(1),
+          BinOp("+", Call(Name("len"), Name("string")), Int(1))),
+          Expr(
+            Call(
+              Attribute(Name("prefixes"), "append"),
+              Subscript(
+                Name("string"),
+                Slice(NoBound, Name("end"), NoBound)))))
+        Return(Name("prefixes"))))
+    [label(program-term-equality)]
+endmodule
+
diff --git a/evidence/spec-vacuity-audit.k b/evidence/spec-vacuity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..bbbea26330e2cacef81838c0df855ed508c7b6bf
--- /dev/null
+++ b/evidence/spec-vacuity-audit.k
@@ -0,0 +1,70 @@
+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // The original loop invariant was independently proved with #Top.  It is
+  // available here only as that established dependency.
+  claim
+    <k>
+      #loop(
+        rangeObj(END:Int, STOP:Int, 1),
+        Name("end"),
+        allPrefixesLoopBody()) ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
