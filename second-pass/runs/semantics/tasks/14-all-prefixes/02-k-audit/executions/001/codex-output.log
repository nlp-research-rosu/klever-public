+  --spec-module SPEC-LABELED \
+  --claims loop
+
+printf '\n## Entry target selected independently\n'
+run_status kprove spec-labeled.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-LABELED \
+  --claims entry
