+printf '$ python3 /reference/py2mpy.py concrete-tests.py > concrete-tests.mpy\n'
+python3 /reference/py2mpy.py concrete-tests.py > concrete-tests.mpy
+printf '[exit %d]\n' "$?"
+
+printf '\n## Fresh concrete definition\n'
