diff --git a/evidence/program-pinning.k b/evidence/program-pinning.k
new file mode 100644
index 0000000000000000000000000000000000000000..7a585c6cfdc37f972e7e66a529900bbad1078ce4
--- /dev/null
+++ b/evidence/program-pinning.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module PROGRAM-PINNING
+  imports VERIFICATION
+
+  // Reviewer-side execution check: loading the named term used by the entry
+  // claim must install exactly the function body in trusted-translator output.
+  claim
+    <k> #loadAll(solutionModule()) => .K </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "all_prefixes" |->
+          closureVal(
+            "string",
+            .ParamNames,
+            Expr(Str("Return all nonempty prefixes of string, shortest first."))
+            Assign(Name("prefixes"), ListExpr(.Exprs))
+            For(
+              Name("end"),
+              Call(
+                Name("range"),
+                Int(1),
+                BinOp(
+                  "+",
+                  Call(Name("len"), Name("string")),
+                  Int(1))),
+              Expr(
+                Call(
+                  Attribute(Name("prefixes"), "append"),
+                  Subscript(
+                    Name("string"),
+                    Slice(NoBound, Name("end"), NoBound)))))
+            Return(Name("prefixes"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(program-term-equality)]
+endmodule
diff --git a/evidence/spec-vacuity-audit.k b/evidence/spec-vacuity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..bbbea26330e2cacef81838c0df855ed508c7b6bf
--- /dev/null
+++ b/evidence/spec-vacuity-audit.k
@@ -0,0 +1,70 @@
+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // The original loop invariant was independently proved with #Top.  It is
+  // available here only as that established dependency.
+  claim
+    <k>
+      #loop(
+        rangeObj(END:Int, STOP:Int, 1),
+        Name("end"),
+        allPrefixesLoopBody()) ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        "end" |-> _PREV:Int
+        "prefixes" |-> ref(H:Int)
+        "string" |-> str(S:IntSeq),
+        P:Parent)
+      => SC
+         L |-> scope(
+           "end" |-> ?FINAL:Int
+           "prefixes" |-> ref(H)
+           "string" |-> str(S),
+           P)
+    </scopes>
+    <heap>
+      HP:Map H |-> list(ACC:ValSeq)
+      => HP H |-> list(prefixesAcc(S, END, STOP, ACC))
+    </heap>
+    requires END <=Int STOP
+    [trusted, label(loop)]
+
+  // Deliberately false mutation: prepend the empty string to the returned list.
+  // For the satisfying input S = .IntSeq (Python ""), the real result is []
+  // while this postcondition requires [""].
+  claim
+    <k>
+      #loadAll(solutionModule())
+      ~> Call(Name("all_prefixes"), (str(S:IntSeq), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      => 0 |-> scope(
+           "all_prefixes" |-> closureVal(
+             "string", .ParamNames, allPrefixesBody(), 0),
+           parent(-1))
+         -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+           vCons(str(.IntSeq), allPrefixes(S)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(false-entry)]
+endmodule
+

exec
/bin/bash -lc 'mv /audit-output/evidence/06-adequacy.log /audit-output/evidence/06-adequacy-attempt2.log
bash /audit-output/evidence/06-run-adequacy.sh > /audit-output/evidence/06-adequacy.log 2>&1
status=$?
rg -n '"'"'^'"\\"'$|''^#Top$|''^'"\\[exit|"'^'"\\[Error\\]|all_equal|requires_END' /audit-output/evidence/06-adequacy.log
printf 'script exit=%d\\n' \""'$status"' in /audit-output
diff --git a//tmp/audit-work/proof-audit.Dl0nBZ/candidate/concrete-tests-ascii.py b//tmp/audit-work/proof-audit.Dl0nBZ/candidate/concrete-tests-ascii.py
new file mode 100644
index 0000000000000000000000000000000000000000..be3683f8d864db33f3c806a2e9e68af533dac8d2
--- /dev/null
+++ b//tmp/audit-work/proof-audit.Dl0nBZ/candidate/concrete-tests-ascii.py
@@ -0,0 +1,16 @@
+from typing import List
+
+
+def all_prefixes(string: str) -> List[str]:
+    """Return all nonempty prefixes of string, shortest first."""
+    prefixes = []
+    for end in range(1, len(string) + 1):
+        prefixes.append(string[:end])
+    return prefixes
+
+
+assert all_prefixes("") == []
+assert all_prefixes("a") == ["a"]
+assert all_prefixes("abc") == ["a", "ab", "abc"]
+assert all_prefixes("a b") == ["a", "a ", "a b"]
+
diff --git a//tmp/audit-work/proof-audit.Dl0nBZ/candidate/concrete-tests.py b//tmp/audit-work/proof-audit.Dl0nBZ/candidate/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..126a215f2a99fe01c3e77adba1e539dc5bf0e3bc
--- /dev/null
+++ b//tmp/audit-work/proof-audit.Dl0nBZ/candidate/concrete-tests.py
@@ -0,0 +1,16 @@
+from typing import List
+
+
+def all_prefixes(string: str) -> List[str]:
+    """Return all nonempty prefixes of string, shortest first."""
+    prefixes = []
+    for end in range(1, len(string) + 1):
+        prefixes.append(string[:end])
+    return prefixes
+
+
+assert all_prefixes("") == []
+assert all_prefixes("a") == ["a"]
+assert all_prefixes("abc") == ["a", "ab", "abc"]
+assert all_prefixes("é🙂") == ["é", "é🙂"]
+
diff --git a//tmp/audit-work/proof-audit.Dl0nBZ/candidate/spec-entry-modular.k b//tmp/audit-work/proof-audit.Dl0nBZ/candidate/spec-entry-modular.k
new file mode 100644
index 0000000000000000000000000000000000000000..bb89a734db17775a417c08c2f9c02e88a5d0ea67
--- /dev/null
+++ b//tmp/audit-work/proof-audit.Dl0nBZ/candidate/spec-entry-modular.k
@@ -0,0 +1,65 @@
+requires "verification.k"
+
+module SPEC-ENTRY-MODULAR
+  imports VERIFICATION
+
+  // This is separately proved in the loop-only run.  It is marked trusted
+  // here solely to test the entry claim as a modular dependent proof.
+  claim
+    <k>
+      #loop(
+        rangeObj(END:Int, STOP:Int, 1),
+        Name("end"),
+        allPrefixesLoopBody()) ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        "end" |-> _PREV:Int
+        "prefixes" |-> ref(H:Int)
+        "string" |-> str(S:IntSeq),
+        P:Parent)
+      => SC
+         L |-> scope(
+           "end" |-> ?FINAL:Int
+           "prefixes" |-> ref(H)
+           "string" |-> str(S),
+           P)
+    </scopes>
+    <heap>
+      HP:Map H |-> list(ACC:ValSeq)
+      => HP H |-> list(prefixesAcc(S, END, STOP, ACC))
+    </heap>
+    requires END <=Int STOP
+    [trusted, label(loop)]
+
+  claim
+    <k>
+      #loadAll(solutionModule())
+      ~> Call(Name("all_prefixes"), (str(S:IntSeq), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      => 0 |-> scope(
+           "all_prefixes" |-> closureVal(
+             "string", .ParamNames, allPrefixesBody(), 0),
+           parent(-1))
+         -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(allPrefixes(S))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(entry)]
+endmodule
+
