diff --git a/evidence/program-pinning.k b/evidence/program-pinning.k
new file mode 100644
index 0000000000000000000000000000000000000000..7a585c6cfdc37f972e7e66a529900bbad1078ce4
--- /dev/null
+++ b/evidence/program-pinning.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module PROGRAM-PINNING
+  imports VERIFICATION
+
+  // Reviewer-side execution check: loading the named term used by the entry
+  // claim must install exactly the function body in trusted-translator output.
+  claim
+    <k> #loadAll(solutionModule()) => .K </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "all_prefixes" |->
+          closureVal(
+            "string",
+            .ParamNames,
+            Expr(Str("Return all nonempty prefixes of string, shortest first."))
+            Assign(Name("prefixes"), ListExpr(.Exprs))
+            For(
+              Name("end"),
+              Call(
+                Name("range"),
+                Int(1),
+                BinOp(
+                  "+",
+                  Call(Name("len"), Name("string")),
+                  Int(1))),
+              Expr(
+                Call(
+                  Attribute(Name("prefixes"), "append"),
+                  Subscript(
+                    Name("string"),
+                    Slice(NoBound, Name("end"), NoBound)))))
+            Return(Name("prefixes"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(program-term-equality)]
+endmodule
diff --git a/evidence/spec-vacuity-audit.k b/evidence/spec-vacuity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..bbbea26330e2cacef81838c0df855ed508c7b6bf
--- /dev/null
+++ b/evidence/spec-vacuity-audit.k
@@ -0,0 +1,70 @@
+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // The original loop invariant was independently proved with #Top.  It is
+  // available here only as that established dependency.
+  claim
+    <k>
+      #loop(
+        rangeObj(END:Int, STOP:Int, 1),
+        Name("end"),
+        allPrefixesLoopBody()) ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        "end" |-> _PREV:Int
+        "prefixes" |-> ref(H:Int)
+        "string" |-> str(S:IntSeq),
+        P:Parent)
+      => SC
+         L |-> scope(
+           "end" |-> ?FINAL:Int
+           "prefixes" |-> ref(H)
+           "string" |-> str(S),
+           P)
+    </scopes>
+    <heap>
+      HP:Map H |-> list(ACC:ValSeq)
+      => HP H |-> list(prefixesAcc(S, END, STOP, ACC))
+    </heap>
+    requires END <=Int STOP
+    [trusted, label(loop)]
+
+  // Deliberately false mutation: prepend the empty string to the returned list.
+  // For the satisfying input S = .IntSeq (Python ""), the real result is []
+  // while this postcondition requires [""].
+  claim
+    <k>
+      #loadAll(solutionModule())
+      ~> Call(Name("all_prefixes"), (str(S:IntSeq), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      => 0 |-> scope(
+           "all_prefixes" |-> closureVal(
+             "string", .ParamNames, allPrefixesBody(), 0),
+           parent(-1))
+         -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+           vCons(str(.IntSeq), allPrefixes(S)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(false-entry)]
+endmodule
+

apply patch
