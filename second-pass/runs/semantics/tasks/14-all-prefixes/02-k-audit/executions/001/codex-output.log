+                name: repr(value)
+                for name, value in module.all_prefixes.__annotations__.items()
+            },
+            "return_for_abc": module.all_prefixes("abc"),
+            "result_depends_on_List_binding": False,
+        },
+        sort_keys=True,
+    )
+)
+
