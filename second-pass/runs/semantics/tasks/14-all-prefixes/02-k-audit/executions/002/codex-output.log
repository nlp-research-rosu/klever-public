+            hashes["stage1_invocation_sha256"],
+        ),
+        ("generation_metrics", GENERATION / "metrics.json", hashes["generation_metrics_sha256"]),
+        ("generation_usage", GENERATION / "usage.json", hashes["generation_usage_sha256"]),
+        (
