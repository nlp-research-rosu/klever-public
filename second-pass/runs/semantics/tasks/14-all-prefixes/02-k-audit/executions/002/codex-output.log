+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Keep the valid loop circularity available to the entry proof.
+  claim
+    <k>
+      #loop(
+        rangeObj(END:Int, STOP:Int, 1),
+        Name("end"),
+        allPrefixesLoopBody()) ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        "end" |-> _PREV:Int
+        "prefixes" |-> ref(H:Int)
+        "string" |-> str(S:IntSeq),
+        P:Parent)
+      => SC
