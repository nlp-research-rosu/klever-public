+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+           vCons(
+             str(iCons(97, .IntSeq)),
+             vCons(
+               str(iCons(97, iCons(98, .IntSeq))),
+               vCons(
+                 str(iCons(97, iCons(98, iCons(99, .IntSeq)))),
+                 .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
