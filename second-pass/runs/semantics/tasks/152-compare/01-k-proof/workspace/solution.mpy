Module(
  FuncDef("compare", Params("game", "guess"),
    Expr(
      Str(
        "Return the absolute error for each corresponding score and guess."))
    Assign(Name("result"), ListExpr())
    For(TupleExpr(Name("score"), Name("prediction")), Call(Name("zip"), Name("game"), Name("guess")),
      Expr(
        Call(
          Attribute(Name("result"), "append"),
          Call(
            Name("abs"),
            BinOp("-", Name("score"), Name("prediction"))))))
    Return(Name("result"))))
