     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd "$(dirname "$0")"
     5	
     6	# Recreate both translated programs from their Python sources.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
     9	
    10	# Required concrete LLVM definition and end-to-end executions.
    11	kompile reference-semantics/semantics.k \
    12	  --backend llvm \
    13	  --main-module MPY-KRUN \
    14	  --syntax-module MPY-SYNTAX \
    15	  --output-definition runtime-kompiled
    16	krun concrete_tests.mpy --definition runtime-kompiled
    17	
    18	# Universal proof (the first claim in spec.k) plus the prompt-example claims.
    19	kompile verification.k \
    20	  --backend haskell \
    21	  --main-module COMPARE-VERIFICATION \
    22	  --syntax-module MPY-SYNTAX \
    23	  --output-definition verification-kompiled
    24	kprove spec.k \
    25	  --definition verification-kompiled \
    26	  --spec-module COMPARE-SPEC
    27	
    28	# Independent raw-semantics proofs: COMPARE-COMMON excludes the symbolic loop
    29	# summary, so all four finite cases traverse the actual iterator and loop.
    30	kompile verification.k \
    31	  --backend haskell \
    32	  --main-module COMPARE-COMMON \
    33	  --syntax-module MPY-SYNTAX \
    34	  --output-definition operational-kompiled
    35	kprove operational-spec.k \
    36	  --definition operational-kompiled \
    37	  --spec-module COMPARE-OPERATIONAL-SPEC
    38	
    39	# Negative validation: changing subtraction to addition must not prove.
    40	mutation_log="$(mktemp)"
    41	trap 'rm -f "$mutation_log"' EXIT
    42	if kprove mutation-spec.k \
    43	    --definition verification-kompiled \
    44	    --spec-module COMPARE-MUTATION-SPEC \
    45	    >"$mutation_log" 2>&1; then
    46	  cat "$mutation_log"
    47	  echo "ERROR: the deliberately incorrect addition mutant unexpectedly proved" >&2
    48	  exit 1
    49	fi
    50	cat "$mutation_log"
    51	echo "Expected result: the addition mutation was rejected."
