     1	requires "reference-semantics/semantics.k"
     2	
     3	module COMPARE-COMMON
     4	  imports MPY
     5	
     6	  // Integer-valued Python lists, represented with the semantics' algebraic
     7	  // IntSeq so the theorem quantifies over lists of arbitrary finite length.
     8	  syntax ValSeq ::= intVals(IntSeq) [function, total]
     9	  rule intVals(.IntSeq)                => .ValSeq
    10	  rule intVals(iCons(I:Int, R:IntSeq)) => vCons(I, intVals(R))
    11	
    12	  // Mathematical result of zip(game, guess), including zip's truncation
    13	  // behavior.  Equal-length inputs from the HumanEval contract are a subset.
    14	  syntax ValSeq ::= absDiffs(ValSeq, ValSeq) [function]
    15	  rule absDiffs(.ValSeq, _:ValSeq) => .ValSeq
    16	  rule absDiffs(vCons(_:Int, _:ValSeq), .ValSeq) => .ValSeq
    17	  rule absDiffs(vCons(A:Int, AS:ValSeq), vCons(B:Int, BS:ValSeq))
    18	    => vCons(absInt(A -Int B), absDiffs(AS, BS))
    19	
    20	  // These macros are the exact AST emitted in solution.mpy.
    21	  syntax Stmts ::= "appendBody" [macro]
    22	  rule appendBody
    23	    => Expr(
    24	         Call(
    25	           Attribute(Name("result"), "append"),
    26	           Call(Name("abs"), BinOp("-", Name("score"), Name("prediction")))))
    27	
    28	  syntax Stmts ::= "compareBody" [macro]
    29	  rule compareBody
    30	    => Expr(Str("Return the absolute error for each corresponding score and guess."))
    31	       Assign(Name("result"), ListExpr(.Exprs))
    32	       For(
    33	         TupleExpr(Name("score"), Name("prediction")),
    34	         Call(Name("zip"), Name("game"), Name("guess")),
    35	         appendBody)
    36	       Return(Name("result"))
    37	
    38	  syntax Stmt ::= "compareDef" [macro]
    39	  rule compareDef
    40	    => FuncDef("compare", Params("game", "guess"), compareBody)
    41	endmodule
    42	
    43	module COMPARE-VERIFICATION
    44	  imports COMPARE-COMMON
    45	
    46	  // Inductive loop summary used only by the symbolic definition.  Reaching
    47	  // this redex requires the real translated function to have evaluated zip,
    48	  // allocated result, and installed its exact append/abs/subtract loop body.
    49	  // The rule appends precisely the mathematical result of the residual zip.
    50	  rule <k>
    51	         #loop(
    52	           zipObj(GAME:ValSeq, GUESS:ValSeq),
    53	           TupleExpr(Name("score"), Name("prediction")),
    54	           appendBody)
    55	         => .K
    56	         ...
    57	       </k>
    58	       <env> L:Int </env>
    59	       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
    60	       <heap>
    61	         ... H:Int |-> list(
    62	              ACC:ValSeq
    63	              => valSeqConcat(ACC, absDiffs(GAME, GUESS))) ...
    64	       </heap>
    65	       requires "result" in_keys(M)
    66	        andBool {M["result"]}:>Val ==K ref(H)
    67	       [priority(40)]
    68	endmodule
