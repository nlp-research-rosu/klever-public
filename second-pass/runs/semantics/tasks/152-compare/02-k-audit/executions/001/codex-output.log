diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..82f5aa249d21e6210a58bba3a3bcbc4f0e9f05be
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: run_logged.sh LABEL COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+label=$1
+shift
+log="/audit-output/evidence/${label}.log"
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\nWORKDIR: %q\n' "$PWD"
+  printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  "$@"
+  status=$?
+  printf 'EXIT_STATUS: %d\n' "$status"
+  printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  exit "$status"
+} 2>&1 | tee "$log"
+
+exit "${PIPESTATUS[0]}"
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..17a03413d28b183b0cb7f59699db123ecfa50caf
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,39 @@
+requires "verification.k"
+
+module REVIEWER-SPEC-VACUITY
+  imports COMPARE-VERIFICATION
+
+  // Fresh false postcondition: compare([1], [2]) is [1], not [2].
+  claim
+    <k>
+      compareDef
+      ~> Call(
+           Name("compare"),
+           list(vCons(1, .ValSeq)),
+           list(vCons(2, .ValSeq)))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+               "compare" |-> closureVal(
+                 ("game", "guess"),
+                 compareBody,
+                 0),
+               parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(2, .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule

exec
/bin/bash -lc "cp /audit-output/evidence/spec-vacuity.k /tmp/audit-work/compare152/source/spec-vacuity.k && /audit-output/evidence/run_logged.sh 06_vacuity_dry_run bash -c 'kprove spec-vacuity.k --definition verification-kompiled --spec-module REVIEWER-SPEC-VACUITY --dry-run > /tmp/audit-work/compare152/vacuity-dry-run.out 2>&1; audit_status="'$?; wc -c /tmp/audit-work/compare152/vacuity-dry-run.out; sed -n "1,80p" /tmp/audit-work/compare152/vacuity-dry-run.out; exit $audit_status'"'" in /tmp/audit-work/compare152/source
