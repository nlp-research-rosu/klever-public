+requires "verification.k"
+
+module REVIEWER-SPEC-VACUITY
+  imports COMPARE-VERIFICATION
+
+  // Fresh false postcondition: compare([1], [2]) is [1], not [2].
+  claim
+    <k>
+      compareDef
+      ~> Call(
+           Name("compare"),
+           list(vCons(1, .ValSeq)),
+           list(vCons(2, .ValSeq)))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+               "compare" |-> closureVal(
+                 ("game", "guess"),
+                 compareBody,
+                 0),
+               parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(2, .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule

