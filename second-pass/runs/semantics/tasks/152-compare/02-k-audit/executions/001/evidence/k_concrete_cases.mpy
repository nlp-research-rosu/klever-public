Module(
  FuncDef("compare", Params("game", "guess"),
    Expr(
      Str(
        "Return the absolute error for each corresponding score and guess."))
    Assign(Name("result"), ListExpr())
    For(TupleExpr(Name("score"), Name("prediction")), Call(Name("zip"), Name("game"), Name("guess")),
      Expr(
        Call(
          Attribute(Name("result"), "append"),
          Call(
            Name("abs"),
            BinOp("-", Name("score"), Name("prediction"))))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("compare"),
        ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(1)),
        ListExpr(
          Int(1),
          Int(2),
          Int(3),
          Int(4),
          Int(2),
          UnaryOp("-", Int(2)))),
      CmpOp(
        "==",
        ListExpr(Int(0), Int(0), Int(0), Int(0), Int(3), Int(3)))))
  Assert(
    Compare(
      Call(
        Name("compare"),
        ListExpr(Int(0), Int(5), Int(0), Int(0), Int(0), Int(4)),
        ListExpr(
          Int(4),
          Int(1),
          Int(1),
          Int(0),
          Int(0),
          UnaryOp("-", Int(2)))),
      CmpOp(
        "==",
        ListExpr(Int(4), Int(4), Int(1), Int(0), Int(0), Int(6)))))
  Assert(
    Compare(
      Call(Name("compare"), ListExpr(), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("compare"), ListExpr(Int(0)), ListExpr(Int(0))),
      CmpOp("==", ListExpr(Int(0)))))
  Assert(
    Compare(
      Call(
        Name("compare"),
        ListExpr(Int(2)),
        ListExpr(UnaryOp("-", Int(1)))),
      CmpOp("==", ListExpr(Int(3)))))
  Assert(
    Compare(
      Call(
        Name("compare"),
        ListExpr(UnaryOp("-", Int(2))),
        ListExpr(Int(1))),
      CmpOp("==", ListExpr(Int(3)))))
  Assert(
    Compare(
      Call(
        Name("compare"),
        ListExpr(UnaryOp("-", Int(7)), Int(9)),
        ListExpr(Int(5), UnaryOp("-", Int(4)))),
      CmpOp("==", ListExpr(Int(12), Int(13)))))
  Assert(
    Compare(
      Call(Name("compare"), ListExpr(Int(1)), ListExpr(Int(4), Int(5))),
      CmpOp("==", ListExpr(Int(3)))))
  Assert(
    Compare(
      Call(Name("compare"), ListExpr(Int(1), Int(2)), ListExpr(Int(4))),
      CmpOp("==", ListExpr(Int(3))))))
