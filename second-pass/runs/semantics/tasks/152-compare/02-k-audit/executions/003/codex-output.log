pScopeX(\n               M,\n               intValsX(GAME),\n               intValsX(GUESS)),\n             P)\n      SC\n    </scopes>\n    <heap>\n      H:Int |-> list(ACC:ValSeq) REST:Map\n      =>\n      H |-> list(\n             valSeqConcat(\n               ACC,\n               absDiffsX(intValsX(GAME), intValsX(GUESS))))\n      REST\n    </heap>\nendmodule\n"}},"status":"completed"}}
