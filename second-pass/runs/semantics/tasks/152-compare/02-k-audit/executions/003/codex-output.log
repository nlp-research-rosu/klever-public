    22	  // ==== operand deref: heap objects combine/compare by STRUCTURE ============
    23	  // (Python: list == is structural; identity only via `is`.) priority(40)
    24	  // preempts the generic dispatch so applyUn/applyBin/applyCmp never see a ref.
    25	  rule <k> BinOp(OP:String, ref(H:Int), R:Expr) => BinOp(OP, V, R) ... </k>
    26	       <heap> ... H |-> V:Val ... </heap>
    27	       [priority(40)]
    28	  rule <k> BinOp(OP:String, L:Val, ref(H:Int)) => BinOp(OP, L, V) ... </k>
    29	       <heap> ... H |-> V:Val ... </heap>
    30	       requires notBool isRefV(L)
    31	       [priority(40)]
    32	
    33	  // the left operand of `in`/`not in` is an ELEMENT (compares by ==K) — never deref'd
    34	  rule <k> Compare(ref(H:Int), CmpOp(OP:String, R:Expr)) => Compare(V, CmpOp(OP, R)) ... </k>
    35	       <heap> ... H |-> V:Val ... </heap>
    36	       requires OP =/=String "in" andBool OP =/=String "not in"
    37	       [priority(40)]
    38	  rule <k> Compare(L:Val, CmpOp(OP:String, ref(H:Int))) => Compare(L, CmpOp(OP, V)) ... </k>
    39	       <heap> ... H |-> V:Val ... </heap>
    40	       requires notBool isRefV(L)
    41	        orBool OP ==String "in" orBool OP ==String "not in"
    42	       [priority(40)]
    43	
    44	  rule <k> UnaryOp(OP:String, ref(H:Int)) => UnaryOp(OP, V) ... </k>
    45	       <heap> ... H |-> V:Val ... </heap>
    46	       [priority(40)]
    47	endmodule
     1	// reference/src/semantics/bool.k — MPY-BOOL
     2	// Bool operator cases + the truthy boolean operations (not / and / or; and-or are
     3	// value-returning short-circuit over any Vals, per Python).
     4	
     5	module MPY-BOOL
     6	  imports MPY-CORE
     7	
     8	  rule applyUn("not", V:Val) => notBool truthy(V)
     9	
    10	  rule applyCmp("==", B1:Bool, B2:Bool) => B1 ==Bool B2
    11	  rule applyCmp("!=", B1:Bool, B2:Bool) => B1 =/=Bool B2
    12	
    13	  // ==== BoolOp: short-circuit, value-returning and / or =====================
    14	  // the node is its own accumulator: heat the HEAD element only, then either return it
    15	  // (short-circuit) or drop it and continue
    16	  context BoolOp(_, (HOLE:Expr, _:Exprs))
    17	  rule <k> BoolOp(_:String, (V:Val, .Exprs)) => V ... </k>
    18	  rule <k> BoolOp("and", (V:Val, A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
    19	       requires truthy(V)
    20	  rule <k> BoolOp("and", (V:Val, _:Expr, _:Exprs)) => V ... </k>
    21	       requires notBool truthy(V)
    22	  rule <k> BoolOp("or",  (V:Val, _:Expr, _:Exprs)) => V ... </k>
    23	       requires truthy(V)
    24	  rule <k> BoolOp("or",  (V:Val, A:Expr, REST:Exprs)) => BoolOp("or", (A, REST)) ... </k>
    25	       requires notBool truthy(V)
    26	
    27	  // ==== heap-object head: decide truthiness THROUGH the heap, never rewrite the
    28	  // operand — and/or return the OBJECT itself (Python identity), not its structure
    29	  rule <k> BoolOp(_:String, (ref(H:Int), .Exprs)) => ref(H) ... </k>
    30	       [priority(40)]
    31	  rule <k> BoolOp("and", (ref(H:Int), A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
    32	       <heap> ... H |-> V:Val ... </heap>
    33	       requires truthy(V)
    34	       [priority(40)]
    35	  rule <k> BoolOp("and", (ref(H:Int), _:Expr, _:Exprs)) => ref(H) ... </k>
    36	       <heap> ... H |-> V:Val ... </heap>
    37	       requires notBool truthy(V)
    38	       [priority(40)]
    39	  rule <k> BoolOp("or", (ref(H:Int), _:Expr, _:Exprs)) => ref(H) ... </k>
    40	       <heap> ... H |-> V:Val ... </heap>
    41	       requires truthy(V)
    42	       [priority(40)]
    43	  rule <k> BoolOp("or", (ref(H:Int), A:Expr, REST:Exprs)) => BoolOp("or", (A, REST)) ... </k>
    44	       <heap> ... H |-> V:Val ... </heap>
    45	       requires notBool truthy(V)
    46	       [priority(40)]
    47	endmodule
     1	// reference/src/semantics/builtins.k — MPY-BUILTINS
     2	
     3	module MPY-BUILTINS
     4	  imports MPY-CORE
     5	  imports MPY-STR
     6	  imports MPY-SET
     7	  imports MPY-ITER
     8	  imports MPY-RANGE
     9	  imports MPY-INT
    10	  imports MPY-METHODS
    11	
    12	  // the builtins REGISTRY is core.k's builtinsScope (the -1 frame); names resolve by lookup
    13	
    14	  // Call routing + argument evaluation live in call.k, which also routes the fold
    15	  // builtins (sum/all/any/max/min) to the #_Acc folds below and everything else to
    16	  // applyBuiltin. This module owns applyBuiltin + the fold implementations.
    17	  syntax Val ::= applyBuiltin(String, Vals) [function]
    18	
    19	  // ==== len(obj) — O(1) per kind ============================================
    20	  syntax Int ::= seqLen(Val) [function]
    21	  rule applyBuiltin("len", OBJ:Val, .Vals) => seqLen(OBJ)
    22	  rule seqLen(list(VS:ValSeq))                  => vsLen(VS)
    23	  rule seqLen(tuple(VS:ValSeq))                 => vsLen(VS)
    24	  rule seqLen(str(IS:IntSeq))                   => isLen(IS)
    25	  rule seqLen(setV(DS:IntSeq))                  => isLen(DS)
    26	  rule seqLen(rangeObj(LO:Int, HI:Int, ST:Int)) => rangeLen(LO, HI, ST)
    27	
    28	  // ==== list(seq) — materialize a list/tuple into a list (e.g. list(d.keys())) ==
    29	  // Minimal: the "copy a sequence" case (list of a list is itself; list of a tuple keeps order).
    30	  // list() of other iterables (str/range/set/zip) is added via the iterator fold when needed.
    31	  // (k-cell — list() constructs a NEW object)
    32	  rule <k> #applyK(toCall(builtinV("list")), (list(VS:ValSeq),  .Vals)) => #alloc(list(VS)) ... </k>
    33	  rule <k> #applyK(toCall(builtinV("list")), (tuple(VS:ValSeq), .Vals)) => #alloc(list(VS)) ... </k>
    34	  rule <k> #applyK(toCall(builtinV("list")), .Vals)                     => #alloc(list(.ValSeq)) ... </k>
    35	  rule <k> #applyK(toCall(builtinV("list")), (str(CS:IntSeq), .Vals))   => #alloc(list(charsOf(CS))) ... </k>
    36	  syntax ValSeq ::= charsOf(IntSeq) [function, total]
    37	  rule charsOf(.IntSeq)                => .ValSeq
    38	  rule charsOf(iCons(C:Int, R:IntSeq)) => vCons(str(iCons(C, .IntSeq)), charsOf(R))
    39	
    40	  // ==== set(str) — distinct character codes =================================
    41	  rule applyBuiltin("set", str(CS:IntSeq), .Vals) => setV(dedupCodes(CS))
    42	
    43	  // ==== abs(int) ============================================================
    44	  rule applyBuiltin("abs", I:Int, .Vals) => absInt(I)
    45	
    46	  // ==== sum(iterable) — one #iterNext fold; intOf = int value of an int/bool ==
    47	  syntax KItem ::= #sumAcc(Iterable, Int) | #sumCont(Int)
    48	  rule <k> #sumAcc(IT:Iterable, ACC:Int) => #iterNext(IT) ~> #sumCont(ACC) ... </k>
    49	  rule <k> #iterDone ~> #sumCont(ACC:Int) => ACC ... </k>
    50	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
    51	        => #sumAcc(R, ACC +Int intOf(V)) ... </k>
    52	       requires isInt(V) orBool isBool(V)
    53	
    54	  syntax Int ::= intOf(Val) [function]
    55	  rule intOf(I:Int)  => I
    56	  rule intOf(B:Bool) => #if B #then 1 #else 0 #fi
    57	
    58	  // ==== all / any (short-circuiting #iterNext folds) ========================
    59	  syntax KItem ::= #allAcc(Iterable) | "#allCont"
    60	  rule <k> #allAcc(IT:Iterable) => #iterNext(IT) ~> #allCont ... </k>
    61	  rule <k> #iterDone ~> #allCont => true ... </k>
    62	  rule <k> #iterYield(V:Val, R:Iterable) ~> #allCont => #allAcc(R) ... </k>
    63	       requires truthy(V)
    64	  rule <k> #iterYield(V:Val, _:Iterable) ~> #allCont => false ... </k>
    65	       requires notBool truthy(V)
    66	
    67	  syntax KItem ::= #anyAcc(Iterable) | "#anyCont"
    68	  rule <k> #anyAcc(IT:Iterable) => #iterNext(IT) ~> #anyCont ... </k>
    69	  rule <k> #iterDone ~> #anyCont => false ... </k>
    70	  rule <k> #iterYield(V:Val, _:Iterable) ~> #anyCont => true ... </k>
    71	       requires truthy(V)
    72	  rule <k> #iterYield(V:Val, R:Iterable) ~> #anyCont => #anyAcc(R) ... </k>
    73	       requires notBool truthy(V)
    74	
    75	  // ==== max / min over an iterable (#iterNext folds; first element seeds) ====
    76	  syntax KItem ::= #maxAcc0(Iterable) | "#maxCont0" | #maxAcc(Iterable, Int) | #maxCont(Int)
    77	  rule <k> #maxAcc0(IT:Iterable) => #iterNext(IT) ~> #maxCont0 ... </k>
    78	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAcc(R, {V}:>Int) ... </k>
    79	       requires isInt(V)
    80	  rule <k> #maxAcc(IT:Iterable, M:Int) => #iterNext(IT) ~> #maxCont(M) ... </k>
    81	  rule <k> #iterDone ~> #maxCont(M:Int) => M ... </k>
    82	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont(M:Int)
    83	        => #maxAcc(R, maxInt(M, {V}:>Int)) ... </k>
    84	       requires isInt(V)
    85	
    86	  syntax KItem ::= #minAcc0(Iterable) | "#minCont0" | #minAcc(Iterable, Int) | #minCont(Int)
    87	  rule <k> #minAcc0(IT:Iterable) => #iterNext(IT) ~> #minCont0 ... </k>
    88	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAcc(R, {V}:>Int) ... </k>
    89	       requires isInt(V)
    90	  rule <k> #minAcc(IT:Iterable, M:Int) => #iterNext(IT) ~> #minCont(M) ... </k>
    91	  rule <k> #iterDone ~> #minCont(M:Int) => M ... </k>
    92	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont(M:Int)
    93	        => #minAcc(R, minInt(M, {V}:>Int)) ... </k>
    94	       requires isInt(V)
    95	
    96	  // ==== variadic max / min (a Vals fold) ====================================
    97	  syntax Int ::= maxVals(Int, Vals) [function]
    98	  rule applyBuiltin("max", I:Int, REST:Vals) => maxVals(I, REST)
    99	  rule maxVals(M:Int, .Vals)           => M
   100	  rule maxVals(M:Int, (I:Int, R:Vals)) => maxVals(maxInt(M, I), R)
   101	
   102	  syntax Int ::= minVals(Int, Vals) [function]
   103	  rule applyBuiltin("min", I:Int, REST:Vals) => minVals(I, REST)
   104	  rule minVals(M:Int, .Vals)           => M
   105	  rule minVals(M:Int, (I:Int, R:Vals)) => minVals(minInt(M, I), R)
   106	
   107	  // ==== bin(n) — "0b" + binary digit codes (promoted from 103's defined fold) ==
   108	  rule applyBuiltin("bin", N:Int, .Vals) => str(iCons(48, iCons(98, binCodes(N))))
   109	       requires N >=Int 0
   110	  // negative operand: the '-' sign prefixes the magnitude's digits
   111	  rule applyBuiltin("bin", N:Int, .Vals)
   112	    => str(iCons(45, iCons(48, iCons(98, binCodes(0 -Int N)))))
   113	       requires N <Int 0
   114	  syntax IntSeq ::= binCodes(Int) [function, total]
   115	  rule binCodes(0) => iCons(48, .IntSeq)
   116	  rule binCodes(N:Int) => binAcc(N, .IntSeq) requires N >Int 0
   117	  syntax IntSeq ::= binAcc(Int, IntSeq) [function, total]
   118	  rule binAcc(0, ACC:IntSeq) => ACC
   119	  rule binAcc(N:Int, ACC:IntSeq)
   120	    => binAcc((N -Int pyMod(N, 2)) /Int 2, iCons(48 +Int pyMod(N, 2), ACC))
   121	       requires N >Int 0
   122	
   123	  // ==== enumerate(xs) — pairs (i, v); materialized eagerly over a list =========
   124	  rule <k> #applyK(toCall(builtinV("enumerate")), (list(VS:ValSeq), .Vals))
   125	        => #alloc(list(enumVS(VS, 0))) ... </k>
   126	  syntax ValSeq ::= enumVS(ValSeq, Int) [function, total]
   127	  rule enumVS(.ValSeq, _:Int) => .ValSeq
   128	  rule enumVS(vCons(V:Val, R:ValSeq), I:Int)
   129	    => vCons(tuple(vCons(I, vCons(V, .ValSeq))), enumVS(R, I +Int 1))
   130	
   131	  // ==== map(str, xs) — eager (only the str case is in the subset) =============
   132	  rule <k> #applyK(toCall(builtinV("map")), (typeV("str"), list(VS:ValSeq), .Vals))
   133	        => #alloc(list(mapStrVS(VS))) ... </k>
   134	  syntax ValSeq ::= mapStrVS(ValSeq) [function, total]
   135	  rule mapStrVS(.ValSeq) => .ValSeq
   136	  rule mapStrVS(vCons(I:Int, R:ValSeq)) => vCons(str(strToCodes(Int2String(I))), mapStrVS(R))
   137	  rule mapStrVS(vCons(str(CS:IntSeq), R:ValSeq)) => vCons(str(CS), mapStrVS(R))
   138	
   139	  // ==== int(x) identities (int(round(x)) composes through) ====================
   140	  rule applyBuiltin("int", I:Int, .Vals) => I
   141	
   142	  // ==== ord / chr ===========================================================
   143	  rule applyBuiltin("ord", str(iCons(C:Int, .IntSeq)), .Vals) => C
   144	  rule applyBuiltin("chr", I:Int, .Vals) => str(iCons(I, .IntSeq))
   145	       requires 0 <=Int I andBool I <Int 128
   146	
   147	  // ==== str(int) / str(str) =================================================
   148	  rule applyBuiltin("str", I:Int, .Vals)       => str(strToCodes(Int2String(I)))
   149	  rule applyBuiltin("str", str(CS:IntSeq), .Vals) => str(CS)
   150	
   151	  // ==== int(str) — a single digit char ('0'..'9', code 48..57) to its value =====
   152	  rule applyBuiltin("int", str(iCons(C:Int, .IntSeq)), .Vals) => C -Int 48
   153	       requires 48 <=Int C andBool C <=Int 57
   154	
   155	  // ==== int(str) — a multi-digit non-negative numeral (Horner fold; the single-char rule covers len 1)
   156	  rule applyBuiltin("int", str(CS:IntSeq), .Vals) => intDigAcc(CS, 0)
   157	       requires isLen(CS) >=Int 2
   158	  syntax Int ::= intDigAcc(IntSeq, Int) [function, total]
   159	  rule intDigAcc(.IntSeq, ACC:Int)             => ACC
   160	  rule intDigAcc(iCons(C:Int, R:IntSeq), ACC:Int) => intDigAcc(R, (ACC *Int 10) +Int (C -Int 48))
   161	
   162	  // ==== zip(a, b) — parallel iterable of pairs, truncating to the shorter =====
   163	  rule applyBuiltin("zip", list(A:ValSeq), list(B:ValSeq), .Vals) => zipObj(A, B)
   164	  rule applyBuiltin("zip", str(A:IntSeq), str(B:IntSeq), .Vals)   => zipObjS(A, B)
   165	
   166	  // zip's iterator-protocol cases (zip is created here, so its #iterNext lives here)
   167	  rule <k> #iterNext(zipObj(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq)))
   168	        => #iterYield(tuple(vCons(A, vCons(B, .ValSeq))), zipObj(As, Bs)) ... </k>
   169	  rule <k> #iterNext(zipObj(.ValSeq, _:ValSeq))               => #iterDone ... </k>
   170	  rule <k> #iterNext(zipObj(vCons(_:Val, _:ValSeq), .ValSeq)) => #iterDone ... </k>
   171	  rule <k> #iterNext(zipObjS(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)))
   172	        => #iterYield(tuple(vCons(str(iCons(A, .IntSeq)), vCons(str(iCons(B, .IntSeq)), .ValSeq))), zipObjS(As, Bs)) ... </k>
   173	  rule <k> #iterNext(zipObjS(.IntSeq, _:IntSeq))              => #iterDone ... </k>
   174	  rule <k> #iterNext(zipObjS(iCons(_:Int, _:IntSeq), .IntSeq)) => #iterDone ... </k>
   175	
   176	  // ==== range(stop) / range(start, stop) / range(start, stop, step) =========
   177	  rule applyBuiltin("range", I:Int, .Vals)               => rangeObj(0, I, 1)
   178	  rule applyBuiltin("range", A:Int, B:Int, .Vals)        => rangeObj(A, B, 1)
   179	  rule applyBuiltin("range", A:Int, B:Int, S:Int, .Vals) => rangeObj(A, B, S)
   180	       requires S =/=Int 0
   181	
   182	  // ==== eval(str) — arithmetic expressions (ints, + - * // **, spaces) ========
   183	  // Python precedence: ** right-assoc, then * //, then + -. Promoted from 160's
   184	  // trusted pass evaluator, now DEFINED in the reference and driven by a
   185	  // code-level tokenizer. Reduces on concrete strings (krun); a symbolic
   186	  // argument leaves the call unevaluated for problem-level folds.
   187	  rule applyBuiltin("eval", str(CS:IntSeq), .Vals) => evalArith(CS)
   188	  syntax Int ::= evalArith(IntSeq) [function]
   189	  rule evalArith(CS:IntSeq)
   190	    => firstNdE(passAddE(passMulE(passPowE(tokOps(CS), tokNds(CS)))))
   191	
   192	  syntax OpSeq ::= ".OpSeq" | oCons(String, OpSeq)
   193	
   194	  syntax Bool ::= evDigit(Int) [function, total]
   195	  rule evDigit(C:Int) => C >=Int 48 andBool C <=Int 57
   196	  syntax Bool ::= evHead42(IntSeq) [function, total]
   197	  rule evHead42(iCons(42, _:IntSeq)) => true
   198	  rule evHead42(_:IntSeq)            => false [owise]
   199	  syntax Bool ::= evHead47(IntSeq) [function, total]
   200	  rule evHead47(iCons(47, _:IntSeq)) => true
   201	  rule evHead47(_:IntSeq)            => false [owise]
   202	
   203	  syntax OpSeq ::= tokOps(IntSeq) [function, total]
   204	  rule tokOps(.IntSeq)                 => .OpSeq
   205	  rule tokOps(iCons(32, R:IntSeq))     => tokOps(R)
   206	  rule tokOps(iCons(C:Int, R:IntSeq))  => tokOps(R) requires evDigit(C)
   207	  rule tokOps(iCons(42, iCons(42, R:IntSeq))) => oCons("**", tokOps(R))
   208	  rule tokOps(iCons(42, R:IntSeq))     => oCons("*", tokOps(R)) requires notBool evHead42(R)
   209	  rule tokOps(iCons(47, iCons(47, R:IntSeq))) => oCons("//", tokOps(R))
   210	  rule tokOps(iCons(47, R:IntSeq))     => oCons("/", tokOps(R)) requires notBool evHead47(R)
   211	  rule tokOps(iCons(43, R:IntSeq))     => oCons("+", tokOps(R))
   212	  rule tokOps(iCons(45, R:IntSeq))     => oCons("-", tokOps(R))
   213	
   214	  syntax IntSeq ::= tokNds(IntSeq) [function, total]
   215	                  | tokNdAcc(Int, IntSeq) [function, total]
   216	  rule tokNds(.IntSeq)                => .IntSeq
   217	  rule tokNds(iCons(32, R:IntSeq))    => tokNds(R)
   218	  rule tokNds(iCons(C:Int, R:IntSeq)) => tokNdAcc(C -Int 48, R) requires evDigit(C)
   219	  rule tokNds(iCons(C:Int, R:IntSeq)) => tokNds(R)
   220	       requires notBool evDigit(C) andBool C =/=Int 32
   221	  rule tokNdAcc(A:Int, iCons(C:Int, R:IntSeq)) => tokNdAcc(A *Int 10 +Int (C -Int 48), R)
   222	       requires evDigit(C)
   223	  rule tokNdAcc(A:Int, S:IntSeq) => iCons(A, tokNds(S)) [owise]
   224	
   225	  syntax EvPair ::= evp(OpSeq, IntSeq)
   226	  syntax Int ::= firstNdE(EvPair) [function, total]
   227	  rule firstNdE(evp(_:OpSeq, iCons(N:Int, _:IntSeq))) => N
   228	  rule firstNdE(_:EvPair) => 0 [owise]
   229	
   230	  syntax Int ::= applyOpE(String, Int, Int) [function, total]
   231	  rule applyOpE("+",  A:Int, B:Int) => A +Int B
   232	  rule applyOpE("-",  A:Int, B:Int) => A -Int B
   233	  rule applyOpE("*",  A:Int, B:Int) => A *Int B
   234	  rule applyOpE("//", A:Int, B:Int) => A divInt B
   235	  rule applyOpE("**", A:Int, B:Int) => A ^Int B
   236	  rule applyOpE(_:String, A:Int, _:Int) => A [owise]
   237	
   238	  syntax EvPair ::= passPowE(OpSeq, IntSeq) [function, total]
   239	  rule passPowE(.OpSeq, NDS:IntSeq) => evp(.OpSeq, NDS)
   240	  rule passPowE(oCons("**", OPS:OpSeq), iCons(N:Int, NDS:IntSeq)) => powCombE(N, passPowE(OPS, NDS))
   241	  rule passPowE(oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq)) => powCarryE(O, N, passPowE(OPS, NDS))
   242	       requires O =/=String "**"
   243	  rule passPowE(_:OpSeq, .IntSeq) => evp(.OpSeq, .IntSeq) [owise]
   244	  syntax EvPair ::= powCombE(Int, EvPair) [function, total]
   245	  rule powCombE(N:Int, evp(OPS:OpSeq, iCons(M:Int, REST:IntSeq))) => evp(OPS, iCons(N ^Int M, REST))
   246	  rule powCombE(N:Int, evp(OPS:OpSeq, .IntSeq)) => evp(OPS, iCons(N, .IntSeq))
   247	  syntax EvPair ::= powCarryE(String, Int, EvPair) [function, total]
   248	  rule powCarryE(O:String, N:Int, evp(OPS:OpSeq, NDS:IntSeq)) => evp(oCons(O, OPS), iCons(N, NDS))
   249	
   250	  syntax EvPair ::= passMulE(EvPair) [function, total] | passAddE(EvPair) [function, total]
   251	  rule passMulE(evp(OPS:OpSeq, iCons(N0:Int, NDS:IntSeq))) => passLGoE("mul", N0, OPS, NDS, .OpSeq, .IntSeq)
   252	  rule passMulE(evp(OPS:OpSeq, .IntSeq)) => evp(OPS, .IntSeq)
   253	  rule passAddE(evp(OPS:OpSeq, iCons(N0:Int, NDS:IntSeq))) => passLGoE("add", N0, OPS, NDS, .OpSeq, .IntSeq)
   254	  rule passAddE(evp(OPS:OpSeq, .IntSeq)) => evp(OPS, .IntSeq)
   255	  syntax EvPair ::= passLGoE(String, Int, OpSeq, IntSeq, OpSeq, IntSeq) [function, total]
   256	  rule passLGoE(_:String, CUR:Int, .OpSeq, _:IntSeq, OO:OpSeq, ON:IntSeq) => evp(OO, appendIE(ON, CUR))
   257	  rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)
   258	    => passLGoE(L, applyOpE(O, CUR, N), OPS, NDS, OO, ON)
   259	       requires inLevelE(L, O)
   260	  rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)
   261	    => passLGoE(L, N, OPS, NDS, appendOpE(OO, O), appendIE(ON, CUR))
   262	       requires notBool inLevelE(L, O)
   263	  rule passLGoE(_:String, CUR:Int, oCons(_:String, _:OpSeq), .IntSeq, OO:OpSeq, ON:IntSeq)
   264	    => evp(OO, appendIE(ON, CUR)) [owise]
   265	  syntax Bool ::= inLevelE(String, String) [function, total]
   266	  rule inLevelE("mul", O:String) => O ==String "*" orBool O ==String "//" orBool O ==String "/"
   267	  rule inLevelE("add", O:String) => O ==String "+" orBool O ==String "-"
   268	  rule inLevelE(_:String, _:String) => false [owise]
   269	  syntax OpSeq ::= appendOpE(OpSeq, String) [function, total]
   270	  rule appendOpE(.OpSeq, O:String) => oCons(O, .OpSeq)
   271	  rule appendOpE(oCons(H:String, T:OpSeq), O:String) => oCons(H, appendOpE(T, O))
   272	  syntax IntSeq ::= appendIE(IntSeq, Int) [function, total]
   273	  rule appendIE(.IntSeq, N:Int) => iCons(N, .IntSeq)
   274	  rule appendIE(iCons(H:Int, T:IntSeq), N:Int) => iCons(H, appendIE(T, N))
   275	
   276	  // ==== hashlib.md5(S).hexdigest() — a trusted opaque digest ==================
   277	  // The md5 value itself is a named shared trust (sortVS-style, no concrete
   278	  // twin); proofs use the length/hex-charset lemmas (lemmas/builtins.k).
   279	  syntax KItem ::= "#md5"
   280	  rule <k> Call(Attribute(Name("hashlib"), "md5"), (E:Expr, .Exprs)) => E ~> #md5 ... </k>
   281	       [priority(40)]
   282	  rule <k> str(CS:IntSeq) ~> #md5 => md5Obj(CS) ... </k>
   283	  syntax Val ::= md5Obj(IntSeq)
   284	  rule applyMethod(md5Obj(CS:IntSeq), "hexdigest", .Vals) => str(md5hexCodes(CS))
   285	  syntax IntSeq ::= md5hexCodes(IntSeq) [function, total, symbol(md5hexCodes), no-evaluators]
   286	
   287	  // ==== isinstance(V, int|str) — an ordinary 2-arg builtin ===================
   288	  // The type argument (int/str) is an ordinary name that resolves via the builtins frame to
   289	  // typeV (see core.k's config); no Call-level special case. isIntV/isStrV mirror the old
   290	  // owise-on-Val test (concrete-sort args decide; a symbolic Val stays owise, as before).
   291	  rule applyBuiltin("isinstance", V:Val, typeV("int"), .Vals) => isIntV(V)
   292	  rule applyBuiltin("isinstance", V:Val, typeV("str"), .Vals) => isStrV(V)
   293	  syntax Bool ::= isIntV(Val) [function] | isStrV(Val) [function]
   294	  rule isIntV(_:Int)         => true
   295	  rule isIntV(_:Val)         => false [owise]
   296	  rule isStrV(str(_:IntSeq)) => true
   297	  rule isStrV(_:Val)         => false [owise]
   298	endmodule

diff --git a/evidence/01_integrity.py b/evidence/01_integrity.py
new file mode 100644
index 0000000000000000000000000000000000000000..811664770571a298a7784bcbffb289647f72a07f
--- /dev/null
+++ b/evidence/01_integrity.py
@@ -0,0 +1,271 @@
+#!/usr/bin/env python3
+"""Independent provenance and mounted-tree integrity checks for this audit."""
+
+from __future__ import annotations
+
+import collections
+import hashlib
+import json
+import os
+import stat
+from pathlib import Path
+
+
+AUDIT_INPUT = Path("/audit-input.json")
+LOCK = Path("/audit-campaign-lock.json")
+CANDIDATE = Path("/candidate")
+REFERENCE = Path("/reference")
+GENERATION = Path("/generation-evidence")
+
+
+def digest(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def entry_manifest(root: Path) -> list[tuple[str, str, int, str]]:
+    entries: list[tuple[str, str, int, str]] = []
+    for path in sorted(root.rglob("*"), key=lambda item: item.as_posix()):
+        relative = path.relative_to(root).as_posix()
+        mode = stat.S_IMODE(path.lstat().st_mode)
+        if path.is_symlink():
+            entries.append((relative, "symlink", mode, os.readlink(path)))
+        elif path.is_dir():
+            entries.append((relative, "directory", mode, "-"))
+        elif path.is_file():
+            entries.append((relative, "file", mode, digest(path)))
+        else:
+            entries.append((relative, "other", mode, "-"))
+    return entries
+
+
+def compare_trees(left: Path, right: Path) -> list[str]:
+    left_manifest = {
+        rel: (kind, file_hash)
+        for rel, kind, _mode, file_hash in entry_manifest(left)
+    }
+    right_manifest = {
+        rel: (kind, file_hash)
+        for rel, kind, _mode, file_hash in entry_manifest(right)
+    }
+    differences: list[str] = []
+    for relative in sorted(left_manifest.keys() | right_manifest.keys()):
+        if relative not in left_manifest:
+            differences.append(f"missing from candidate: {relative}")
+        elif relative not in right_manifest:
+            differences.append(f"additional candidate entry: {relative}")
+        elif left_manifest[relative] != right_manifest[relative]:
+            differences.append(
+                f"entry differs: {relative}: "
+                f"candidate={left_manifest[relative]} trusted={right_manifest[relative]}"
+            )
+    return differences
+
+
+def check_regular_readable(path: Path) -> tuple[bool, str]:
+    try:
+        info = path.lstat()
+    except OSError as err:
+        return False, f"lstat failed: {err}"
+    if stat.S_ISLNK(info.st_mode):
+        return False, "is a symlink"
+    if not stat.S_ISREG(info.st_mode):
+        return False, f"is not a regular file (mode={oct(info.st_mode)})"
+    try:
+        with path.open("rb") as stream:
+            stream.read(1)
+    except OSError as err:
+        return False, f"read failed: {err}"
+    return True, digest(path)
+
+
+audit_input = json.loads(AUDIT_INPUT.read_text(encoding="utf-8"))
+lock = json.loads(LOCK.read_text(encoding="utf-8"))
+
+print(f"record_layout={audit_input.get('record_layout')}")
+print(f"semantics_mode={audit_input.get('semantics_mode')}")
+print(f"problem_id={audit_input.get('problem_id')}")
+print(
+    "campaign_block_exact_match="
+    f"{audit_input.get('audit_campaign') == lock}"
+)
+actual_lock_hash = digest(LOCK)
+declared_lock_hash = audit_input["hashes"]["audit_campaign_lock_sha256"]
+print(f"audit_campaign_lock_actual_sha256={actual_lock_hash}")
+print(f"audit_campaign_lock_declared_sha256={declared_lock_hash}")
+print(f"audit_campaign_lock_hash_match={actual_lock_hash == declared_lock_hash}")
+
+required_regular_files = [
+    AUDIT_INPUT,
+    LOCK,
+    Path("/run.json"),
+    Path("/task.json"),
+    Path("/generation-result.json"),
+    GENERATION / "invocation.json",
+    GENERATION / "metrics.json",
+    GENERATION / "codex-last.txt",
+    GENERATION / "codex-output.log",
+    GENERATION / "prompt.txt",
+]
+usage = GENERATION / "usage.json"
+if usage.exists():
+    required_regular_files.append(usage)
+
+print("required_record_checks:")
+all_required_ok = True
+for path in required_regular_files:
+    ok, detail = check_regular_readable(path)
+    all_required_ok &= ok
+    print(f"  {path}: ok={ok} detail={detail}")
+
+container_paths = audit_input["container_paths"]
+print("launcher_declared_mount_checks:")
+for key, raw_path in sorted(container_paths.items()):
+    path = Path(raw_path)
+    exists = path.exists()
+    is_link = path.is_symlink()
+    readable = os.access(path, os.R_OK)
+    all_required_ok &= exists and not is_link and readable
+    print(
+        f"  {key}: path={path} exists={exists} "
+        f"symlink={is_link} readable={readable}"
+    )
+
+expected_hash_paths = {
+    "audit_campaign_lock_sha256": LOCK,
+    "canonical_sha256": REFERENCE / "canonical.py",
+    "trusted_prompt_sha256": REFERENCE / "prompt.py",
+    "candidate_prompt_sha256": CANDIDATE / "prompt.py",
+    "trusted_translator_sha256": REFERENCE / "py2mpy.py",
+    "candidate_translator_sha256": CANDIDATE / "py2mpy.py",
+    "run_manifest_sha256": Path("/run.json"),
+    "task_manifest_sha256": Path("/task.json"),
+    "manifest_sha256": Path("/task.json"),
+    "stage1_result_sha256": Path("/generation-result.json"),
+    "stage1_invocation_sha256": GENERATION / "invocation.json",
+    "generation_metrics_sha256": GENERATION / "metrics.json",
+    "generation_codex_last_sha256": GENERATION / "codex-last.txt",
+    "generation_codex_output_sha256": GENERATION / "codex-output.log",
+    "generation_prompt_sha256": GENERATION / "prompt.txt",
+}
+if usage.exists():
+    expected_hash_paths["generation_usage_sha256"] = usage
+
+print("declared_file_hash_checks:")
+all_hashes_ok = True
+for key, path in expected_hash_paths.items():
+    actual = digest(path)
+    expected = audit_input["hashes"][key]
+    matches = actual == expected
+    all_hashes_ok &= matches
+    print(
+        f"  {key}: path={path} match={matches} "
+        f"actual={actual} declared={expected}"
+    )
+
+prompt_match = (
+    (CANDIDATE / "prompt.py").read_bytes()
+    == (REFERENCE / "prompt.py").read_bytes()
+)
+translator_match = (
+    (CANDIDATE / "py2mpy.py").read_bytes()
+    == (REFERENCE / "py2mpy.py").read_bytes()
+)
+semantics_differences = compare_trees(
+    CANDIDATE / "reference-semantics",
+    REFERENCE / "reference-semantics",
+)
+candidate_semantics_links = [
+    relative
+    for relative, kind, _mode, _value
+    in entry_manifest(CANDIDATE / "reference-semantics")
+    if kind == "symlink"
+]
+trusted_semantics_links = [
+    relative
+    for relative, kind, _mode, _value
+    in entry_manifest(REFERENCE / "reference-semantics")
+    if kind == "symlink"
+]
+print(f"candidate_prompt_byte_match={prompt_match}")
+print(f"candidate_translator_byte_match={translator_match}")
+print(f"semantics_tree_difference_count={len(semantics_differences)}")
+for difference in semantics_differences:
+    print(f"  {difference}")
+print(f"candidate_semantics_symlinks={candidate_semantics_links}")
+print(f"trusted_semantics_symlinks={trusted_semantics_links}")
+print("candidate_tree_manifest:")
+candidate_tree_links: list[str] = []
+for relative, kind, mode, value in entry_manifest(CANDIDATE):
+    if kind == "symlink":
+        candidate_tree_links.append(relative)
+    print(
+        f"  path={relative} kind={kind} mode={oct(mode)} "
+        f"sha256_or_target={value}"
+    )
+print(f"candidate_tree_symlinks={candidate_tree_links}")
+
+trace_root = Path(container_paths["generation_trace"])
+trace_files = sorted(trace_root.rglob("*"))
+trace_regular = [
+    path for path in trace_files if path.is_file() and not path.is_symlink()
+]
+trace_other = [
+    path
+    for path in trace_files
+    if path.is_symlink() or (not path.is_file() and not path.is_dir())
+]
+print(f"trace_regular_file_count={len(trace_regular)}")
+print(f"trace_unexpected_entry_count={len(trace_other)}")
+trace_event_types: collections.Counter[str] = collections.Counter()
+trace_payload_types: collections.Counter[str] = collections.Counter()
+function_calls: list[tuple[int, str, str]] = []
+trace_line_count = 0
+for trace_path in trace_regular:
+    trace_hash = digest(trace_path)
+    print(f"trace_file={trace_path} sha256={trace_hash}")
+    relative_trace = trace_path.relative_to(GENERATION).as_posix()
+    declared_trace_hash = (
+        json.loads(Path("/generation-result.json").read_text(encoding="utf-8"))
+        .get("outputs", {})
+        .get("evidence", {})
+        .get(relative_trace)
+    )
+    print(
+        f"trace_file_declared_sha256={declared_trace_hash} "
+        f"match={trace_hash == declared_trace_hash}"
+    )
+    with trace_path.open("r", encoding="utf-8") as stream:
+        for line_number, line in enumerate(stream, 1):
+            trace_line_count += 1
+            record = json.loads(line)
+            record_type = str(record.get("type"))
+            trace_event_types[record_type] += 1
+            payload = record.get("payload")
+            if isinstance(payload, dict):
+                payload_type = str(payload.get("type"))
+                trace_payload_types[payload_type] += 1
+                if payload_type == "function_call":
+                    function_calls.append(
+                        (
+                            line_number,
+                            str(payload.get("name")),
+                            str(payload.get("arguments")),
+                        )
+                    )
+print(f"trace_json_line_count={trace_line_count}")
+print(f"trace_event_types={dict(sorted(trace_event_types.items()))}")
+print(f"trace_payload_types={dict(sorted(trace_payload_types.items()))}")
+print(f"trace_function_call_count={len(function_calls)}")
+for line_number, name, arguments in function_calls:
+    print(f"  trace_line={line_number} tool={name} arguments={arguments}")
+
+print(f"all_required_records_and_mounts_ok={all_required_ok}")
+print(f"all_direct_declared_hashes_ok={all_hashes_ok}")
+print(
+    "stage1_integrity_ok="
+    f"{all_required_ok and all_hashes_ok and prompt_match and translator_match and not semantics_differences and not candidate_semantics_links and not trusted_semantics_links and audit_input.get('audit_campaign') == lock and actual_lock_hash == declared_lock_hash}"
+)
diff --git a/evidence/02_differential.py b/evidence/02_differential.py
new file mode 100644
index 0000000000000000000000000000000000000000..797e0ebe914e6552e3ecdb234e43dd24928dbd80
--- /dev/null
+++ b/evidence/02_differential.py
@@ -0,0 +1,125 @@
+#!/usr/bin/env python3
+"""Independent differential test for HumanEval 152 compare."""
+
+from __future__ import annotations
+
+import importlib.util
+import itertools
+import random
+from pathlib import Path
+
+
+def load_entry(module_name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.compare
+
+
+canonical = load_entry(
+    "trusted_canonical_compare",
+    Path("/tmp/audit-work/152-compare/trusted/canonical.py"),
+)
+generated = load_entry(
+    "candidate_generated_compare",
+    Path("/tmp/audit-work/152-compare/candidate/solution.py"),
+)
+
+named_cases = [
+    (
+        "prompt-example-1",
+        [1, 2, 3, 4, 5, 1],
+        [1, 2, 3, 4, 2, -2],
+        [0, 0, 0, 0, 3, 3],
+    ),
+    (
+        "prompt-example-2",
+        [0, 5, 0, 0, 0, 4],
+        [4, 1, 1, 0, 0, -2],
+        [4, 4, 1, 0, 0, 6],
+    ),
+    ("empty", [], [], []),
+    ("zero-difference", [7], [7], [0]),
+    ("positive-difference", [9], [2], [7]),
+    ("negative-difference", [2], [9], [7]),
+    ("negative-operands", [-7, -9], [-2, -14], [5, 5]),
+    (
+        "arbitrary-precision",
+        [10**100, -(10**120)],
+        [-(10**100), 10**120],
+        [2 * 10**100, 2 * 10**120],
+    ),
+]
+
+checks = 0
+for name, game, guess, expected in named_cases:
+    canonical_result = canonical(game.copy(), guess.copy())
+    generated_result = generated(game.copy(), guess.copy())
+    assert canonical_result == expected, (
+        name,
+        "canonical",
+        canonical_result,
+        expected,
+    )
+    assert generated_result == expected, (
+        name,
+        "generated",
+        generated_result,
+        expected,
+    )
+    checks += 1
+
+values = (-5, -1, 0, 1, 5)
+exhaustive_equal_length_pairs = 0
+for length in range(5):
+    lists = list(itertools.product(values, repeat=length))
+    for game_tuple in lists:
+        for guess_tuple in lists:
+            game = list(game_tuple)
+            guess = list(guess_tuple)
+            expected = [abs(score - prediction) for score, prediction in zip(game, guess)]
+            canonical_result = canonical(game.copy(), guess.copy())
+            generated_result = generated(game.copy(), guess.copy())
+            assert canonical_result == expected
+            assert generated_result == expected
+            assert generated_result == canonical_result
+            exhaustive_equal_length_pairs += 1
+            checks += 1
+
+rng = random.Random(152)
+random_equal_length_pairs = 0
+for _ in range(2000):
+    length = rng.randrange(0, 41)
+    game = [rng.randrange(-(10**30), 10**30) for _ in range(length)]
+    guess = [rng.randrange(-(10**30), 10**30) for _ in range(length)]
+    expected = [abs(score - prediction) for score, prediction in zip(game, guess)]
+    canonical_result = canonical(game.copy(), guess.copy())
+    generated_result = generated(game.copy(), guess.copy())
+    assert canonical_result == expected
+    assert generated_result == expected
+    assert generated_result == canonical_result
+    random_equal_length_pairs += 1
+    checks += 1
+
+unequal_length_diagnostics = [
+    ([1, 2], [4]),
+    ([1], [4, 7]),
+    ([], [1]),
+    ([1], []),
+]
+for game, guess in unequal_length_diagnostics:
+    canonical_result = canonical(game.copy(), guess.copy())
+    generated_result = generated(game.copy(), guess.copy())
+    expected = [abs(score - prediction) for score, prediction in zip(game, guess)]
+    assert canonical_result == expected
+    assert generated_result == expected
+    checks += 1
+
+print(f"named_cases={len(named_cases)}")
+print(f"exhaustive_equal_length_pairs={exhaustive_equal_length_pairs}")
+print(f"random_equal_length_pairs={random_equal_length_pairs}")
+print(f"unequal_length_out_of_contract_diagnostics={len(unequal_length_diagnostics)}")
+print(f"total_case_checks={checks}")
+print("mismatches=0")
diff --git a/evidence/03_concrete_harness.py b/evidence/03_concrete_harness.py
new file mode 100644
index 0000000000000000000000000000000000000000..47a634413139dba6b101407614e3abcf7dd6eafd
--- /dev/null
+++ b/evidence/03_concrete_harness.py
@@ -0,0 +1,15 @@
+def compare(game, guess):
+    """Return the absolute error for each corresponding score and guess."""
+    result = []
+    for score, prediction in zip(game, guess):
+        result.append(abs(score - prediction))
+    return result
+
+
+assert compare([1, 2, 3, 4, 5, 1], [1, 2, 3, 4, 2, -2]) == [0, 0, 0, 0, 3, 3]
+assert compare([0, 5, 0, 0, 0, 4], [4, 1, 1, 0, 0, -2]) == [4, 4, 1, 0, 0, 6]
+assert compare([], []) == []
+assert compare([7], [7]) == [0]
+assert compare([9], [2]) == [7]
+assert compare([2], [9]) == [7]
+assert compare([-7, -9], [-2, -14]) == [5, 5]
diff --git a/evidence/04_constructor_pinning.py b/evidence/04_constructor_pinning.py
