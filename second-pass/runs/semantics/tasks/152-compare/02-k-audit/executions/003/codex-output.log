+
+
+def label(term: dict) -> str:
+    return term.get("label", {}).get("name", "")
+
+
+solution_document = json.loads(
+    Path("/tmp/audit-work/152-compare/candidate/solution.kast.json").read_text(
+        encoding="utf-8"
+    )
+)
+macro_document = json.loads(
