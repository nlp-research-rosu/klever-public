+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a/evidence/06_false_result_spec.k b/evidence/06_false_result_spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..08406bdbd05efb4f8744de5a109a7ffc64723c57
--- /dev/null
+++ b/evidence/06_false_result_spec.k
@@ -0,0 +1,40 @@
+requires "verification.k"
