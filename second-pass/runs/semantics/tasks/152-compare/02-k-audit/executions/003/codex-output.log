/candidate/solution.py
     1	def compare(game, guess):
     2	    """Return the absolute error for each corresponding score and guess."""
     3	    result = []
     4	    for score, prediction in zip(game, guess):
     5	        result.append(abs(score - prediction))
     6	    return result
