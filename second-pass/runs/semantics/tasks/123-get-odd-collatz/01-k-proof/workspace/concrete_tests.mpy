Module(
  FuncDef("get_odd_collatz", Params("n"),
    Assign(Name("odd_numbers"), ListExpr())
    While(Compare(Name("n"), CmpOp("!=", Int(1))),
      If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
        Expr(Call(Attribute(Name("odd_numbers"), "append"), Name("n")))
        Assign(
          Name("n"),
          BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
        Assign(Name("n"), BinOp("//", Name("n"), Int(2)))))
    Expr(Call(Attribute(Name("odd_numbers"), "append"), Int(1)))
    Return(Call(Name("sorted"), Name("odd_numbers"))))
  Assert(
    Compare(
      Call(Name("get_odd_collatz"), Int(1)),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(Name("get_odd_collatz"), Int(5)),
      CmpOp("==", ListExpr(Int(1), Int(5)))))
  Assert(
    Compare(
      Call(Name("get_odd_collatz"), Int(6)),
      CmpOp("==", ListExpr(Int(1), Int(3), Int(5)))))
  Assert(
    Compare(
      Call(Name("get_odd_collatz"), Int(7)),
      CmpOp(
        "==",
        ListExpr(Int(1), Int(5), Int(7), Int(11), Int(13), Int(17)))))
  Assert(
    Compare(
      Call(Name("get_odd_collatz"), Int(27)),
      CmpOp(
        "==",
        ListExpr(
          Int(1),
          Int(5),
          Int(23),
          Int(27),
          Int(31),
          Int(35),
          Int(41),
          Int(47),
          Int(53),
          Int(61),
          Int(71),
          Int(91),
          Int(103),
          Int(107),
          Int(121),
          Int(137),
          Int(155),
          Int(161),
          Int(167),
          Int(175),
          Int(233),
          Int(251),
          Int(263),
          Int(283),
          Int(319),
          Int(325),
          Int(377),
          Int(395),
          Int(425),
          Int(433),
          Int(445),
          Int(479),
          Int(577),
          Int(593),
          Int(719),
          Int(911),
          Int(1079),
          Int(1367),
          Int(1619),
          Int(2051),
          Int(2429),
          Int(3077))))))
