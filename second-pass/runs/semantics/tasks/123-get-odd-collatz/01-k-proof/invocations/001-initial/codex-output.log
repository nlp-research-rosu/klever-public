+  // Keeping F stable across the circularity avoids asking the prover to
+  // establish equality between two differently-unfolded recursive terms.
+  syntax Bool ::= collatzInvariant(Int, ValSeq, ValSeq) [function]
+
+  rule collatzInvariant(1, A:ValSeq, F:ValSeq)
+    => F ==K valSeqConcat(A, vCons(1, .ValSeq))
+
+  rule collatzInvariant(N:Int, A:ValSeq, F:ValSeq)
+    => collatzInvariant(
+         3 *Int N +Int 1,
+         valSeqConcat(A, vCons(N, .ValSeq)),
+         F)
+    requires N =/=Int 1 andBool pyMod(N, 2) ==Int 1
+
+  rule collatzInvariant(N:Int, A:ValSeq, F:ValSeq)
+    => collatzInvariant((N -Int pyMod(N, 2)) /Int 2, A, F)
+    requires N =/=Int 1 andBool notBool (pyMod(N, 2) ==Int 1)
+endmodule

