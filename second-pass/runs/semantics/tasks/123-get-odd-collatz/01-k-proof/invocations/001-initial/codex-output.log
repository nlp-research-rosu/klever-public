diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..a47c197b3d693dbf54e07341617ada0be6e84035
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,17 @@
+def get_odd_collatz(n):
+    odd_numbers = []
+    while n != 1:
+        if n % 2 == 1:
+            odd_numbers.append(n)
+            n = 3 * n + 1
+        else:
+            n = n // 2
+    odd_numbers.append(1)
+    return sorted(odd_numbers)
+
+
+assert get_odd_collatz(1) == [1]
+assert get_odd_collatz(5) == [1, 5]
+assert get_odd_collatz(6) == [1, 3, 5]
+assert get_odd_collatz(7) == [1, 5, 7, 11, 13, 17]
+assert get_odd_collatz(27) == [1, 5, 13, 17, 23, 27, 31, 35, 37, 41, 47, 53, 61, 71, 77, 91, 101, 103, 107, 121, 137, 155, 175, 205, 233, 263, 307, 319, 325, 395, 433, 445, 577, 593, 719, 911, 923, 1079, 1367, 1619, 1823, 2429, 3077, 3647, 4103, 4859]
