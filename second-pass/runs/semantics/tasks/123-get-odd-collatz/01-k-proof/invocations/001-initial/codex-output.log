@@ -0,0 +1,10 @@
+def get_odd_collatz(n):
+    odd_numbers = []
+    while n != 1:
+        if n % 2 == 1:
+            odd_numbers.append(n)
+            n = 3 * n + 1
+        else:
+            n = n // 2
+    odd_numbers.append(1)
+    return sorted(odd_numbers)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9b02053a30a47aa26fe98d1926c89557cf6a74e6
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,96 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant.  A is the sequence already accumulated in odd_numbers;
+  // collatzResult(N, A) is the complete sequence when the remaining run from
+  // N reaches 1.  This claim is circular exactly at the semantic #while head.
+  claim
+    <k>
+      #while(
+        Compare(Name("n"), CmpOp("!=", Int(1))),
+        If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
+          Expr(Call(Attribute(Name("odd_numbers"), "append"), Name("n")))
+          Assign(
+            Name("n"),
+            BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
+          Assign(Name("n"), BinOp("//", Name("n"), Int(2)))))
+      ~> Expr(Call(Attribute(Name("odd_numbers"), "append"), Int(1)))
+      ~> Return(Call(Name("sorted"), Name("odd_numbers")))
+      ~> #endcall
+      =>
+      ref(1)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      1 |-> scope(
+        .Map [ "n" <- N ] [ "odd_numbers" <- ref(0) ],
+        parent(0))
+      0 |-> scope(M:Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(M, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(A)
+      =>
+      0 |-> list(F)
+      1 |-> list(sortVS(F))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack>
+      ListItem(frame(#oddSpec(F), 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0
+      andBool notBool ("sorted" in_keys(M))
+      andBool collatzInvariant(N, A, F)
+
+  // Base-path proof: Collatz(1) is [1].
+  claim
+    <k> #getOddCollatz(1) => ref(1) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        .Map [
+          "get_odd_collatz" <-
+            closureVal(
+              "n", .ParamNames,
+              Assign(Name("odd_numbers"), ListExpr(.Exprs))
+              While(Compare(Name("n"), CmpOp("!=", Int(1))),
+                If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
+                  Expr(Call(Attribute(Name("odd_numbers"), "append"), Name("n")))
+                  Assign(
+                    Name("n"),
+                    BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
+                  Assign(Name("n"), BinOp("//", Name("n"), Int(2)))))
+              Expr(Call(Attribute(Name("odd_numbers"), "append"), Int(1)))
+              Return(Call(Name("sorted"), Name("odd_numbers"))),
+              0)
+        ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, .ValSeq))
+      1 |-> list(sortVS(vCons(1, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
