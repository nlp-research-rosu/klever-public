+         F)
+    requires N =/=Int 1 andBool pyMod(N, 2) ==Int 1
+
+  rule collatzInvariant(N:Int, A:ValSeq, F:ValSeq)
+    => collatzInvariant((N -Int pyMod(N, 2)) /Int 2, A, F)
+    requires N =/=Int 1 andBool notBool (pyMod(N, 2) ==Int 1)
+endmodule

