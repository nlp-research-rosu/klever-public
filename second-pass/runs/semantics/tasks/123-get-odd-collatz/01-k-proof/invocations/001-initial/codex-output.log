+                 Assign(Name("n"), BinOp("//", Name("n"), Int(2)))))
+             Expr(Call(Attribute(Name("odd_numbers"), "append"), Int(1)))
+             Return(Call(Name("sorted"), Name("odd_numbers"))))))
+       ~> Call(Name("get_odd_collatz"), Int(N), .Exprs)
+
+  // A proof-only, inert continuation which pins the relational result F across
+  // loop circularities.  It is installed only by claims and erased after the
+  // function has returned; solution execution itself is unchanged.
