diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..1d99b3aafd4c18506ebc286d30102bf480c49273
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,17 @@
+def get_odd_collatz(n):
+    odd_numbers = []
+    while n != 1:
+        if n % 2 == 1:
+            odd_numbers.append(n)
+            n = 3 * n + 1
+        else:
+            n = n // 2
+    odd_numbers.append(1)
+    return sorted(odd_numbers)
+
+
+assert get_odd_collatz(1) == [1]
+assert get_odd_collatz(5) == [1, 5]
+assert get_odd_collatz(6) == [1, 3, 5]
+assert get_odd_collatz(7) == [1, 5, 7, 11, 13, 17]
+assert get_odd_collatz(27) == [1, 5, 23, 27, 31, 35, 41, 47, 53, 61, 71, 91, 103, 107, 121, 137, 155, 161, 167, 175, 233, 251, 263, 283, 319, 325, 377, 395, 425, 433, 445, 479, 577, 593, 719, 911, 1079, 1367, 1619, 2051, 2429, 3077]
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..1bb9550a14640394a1a03296c0c9c330d2aba0ae
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def get_odd_collatz(n):
+    odd_numbers = []
+    while n != 1:
+        if n % 2 == 1:
+            odd_numbers.append(n)
+            n = 3 * n + 1
+        else:
+            n = n // 2
+    odd_numbers.append(1)
+    return sorted(odd_numbers)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b8af6d66e95faa343943a1b90b705573273a6ddc
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,263 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // One arbitrary odd loop step: append the current odd value and apply 3n+1.
+  claim
+    <k>
+      #while(
+        Compare(Name("n"), CmpOp("!=", Int(1))),
+        If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
+          Expr(Call(Attribute(Name("odd_numbers"), "append"), Name("n")))
+          Assign(
+            Name("n"),
+            BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
+          Assign(Name("n"), BinOp("//", Name("n"), Int(2)))))
+      =>
+      #loopLbl(#while(
+        Compare(Name("n"), CmpOp("!=", Int(1))),
+        If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
+          Expr(Call(Attribute(Name("odd_numbers"), "append"), Name("n")))
+          Assign(
+            Name("n"),
+            BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
+          Assign(Name("n"), BinOp("//", Name("n"), Int(2))))))
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        .Map [ "n" <- N ] [ "odd_numbers" <- ref(0) ],
+        parent(0))
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      1 |-> scope(
+        .Map [ "n" <- 3 *Int N +Int 1 ] [ "odd_numbers" <- ref(0) ],
+        parent(0))
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      0 |-> list(A)
+      =>
+      0 |-> list(valSeqConcat(A, vCons(N, .ValSeq)))
+    </heap>
+    <scopeLoc> 2 </scopeLoc>
+    <heapLoc> 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 1 andBool pyMod(N, 2) ==Int 1
+    [label(odd-step)]
+
+  // One arbitrary even loop step: do not append and apply Python floor division.
+  claim
+    <k>
+      #while(
+        Compare(Name("n"), CmpOp("!=", Int(1))),
+        If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
+          Expr(Call(Attribute(Name("odd_numbers"), "append"), Name("n")))
+          Assign(
+            Name("n"),
+            BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
+          Assign(Name("n"), BinOp("//", Name("n"), Int(2)))))
+      =>
+      #loopLbl(#while(
+        Compare(Name("n"), CmpOp("!=", Int(1))),
+        If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
+          Expr(Call(Attribute(Name("odd_numbers"), "append"), Name("n")))
+          Assign(
+            Name("n"),
+            BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
+          Assign(Name("n"), BinOp("//", Name("n"), Int(2))))))
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        .Map [ "n" <- N ] [ "odd_numbers" <- ref(0) ],
+        parent(0))
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      1 |-> scope(
+        .Map [
+          "n" <- (N -Int pyMod(N, 2)) /Int 2
+        ] [ "odd_numbers" <- ref(0) ],
+        parent(0))
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap> 0 |-> list(A) </heap>
+    <scopeLoc> 2 </scopeLoc>
+    <heapLoc> 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 1 andBool notBool (pyMod(N, 2) ==Int 1)
+    [label(even-step)]
+
+  // Symbolic exit: for any accumulated sequence, append 1 and return its
+  // trusted ascending sort.
+  claim
+    <k>
+      #while(
+        Compare(Name("n"), CmpOp("!=", Int(1))),
+        If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
+          Expr(Call(Attribute(Name("odd_numbers"), "append"), Name("n")))
+          Assign(
+            Name("n"),
+            BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
+          Assign(Name("n"), BinOp("//", Name("n"), Int(2)))))
+      ~> Expr(Call(Attribute(Name("odd_numbers"), "append"), Int(1)))
+      ~> Return(Call(Name("sorted"), Name("odd_numbers")))
+      ~> #endcall
+      =>
+      ref(1)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      1 |-> scope(
+        .Map [ "n" <- 1 ] [ "odd_numbers" <- ref(0) ],
+        parent(0))
+      0 |-> scope(M:Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(M, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(A)
+      =>
+      0 |-> list(valSeqConcat(A, vCons(1, .ValSeq)))
+      1 |-> list(sortVS(valSeqConcat(A, vCons(1, .ValSeq))))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool ("sorted" in_keys(M))
+    [label(exit-step)]
+
+  // End-to-end base case.
+  claim
+    <k> #getOddCollatz(1) => ref(1) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        .Map [ "get_odd_collatz" <- getOddCollatzClosure ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, .ValSeq))
+      1 |-> list(sortVS(vCons(1, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(case-1)]
+
+  // End-to-end examples covering both transition branches and nontrivial sort.
+  claim
+    <k> #getOddCollatz(5) => ref(1) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        .Map [ "get_odd_collatz" <- getOddCollatzClosure ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(5, vCons(1, .ValSeq)))
+      1 |-> list(sortVS(vCons(5, vCons(1, .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(case-5)]
+
+  claim
+    <k> #getOddCollatz(6) => ref(1) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        .Map [ "get_odd_collatz" <- getOddCollatzClosure ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(3, vCons(5, vCons(1, .ValSeq))))
+      1 |-> list(sortVS(vCons(3, vCons(5, vCons(1, .ValSeq)))))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(case-6)]
+
+  claim
+    <k> #getOddCollatz(7) => ref(1) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        .Map [ "get_odd_collatz" <- getOddCollatzClosure ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        vCons(7,
+          vCons(11,
+            vCons(17,
+              vCons(13,
+                vCons(5,
+                  vCons(1, .ValSeq)))))))
+      1 |-> list(sortVS(
+        vCons(7,
+          vCons(11,
+            vCons(17,
+              vCons(13,
+                vCons(5,
+                  vCons(1, .ValSeq))))))))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(case-7)]
+endmodule
