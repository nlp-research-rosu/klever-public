+def get_odd_collatz(n):
+    odd_numbers = []
+    while n != 1:
+        if n % 2 == 1:
+            odd_numbers.append(n)
+            n = 3 * n + 1
+        else:
+            n = n // 2
+    odd_numbers.append(1)
+    return sorted(odd_numbers)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..628192f8292f534b005b70dd8edaf73f41958329
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,95 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant.  A is the sequence already accumulated in odd_numbers;
+  // collatzResult(N, A) is the complete sequence when the remaining run from
+  // N reaches 1.  This claim is circular exactly at the semantic #while head.
+  claim
+    <k>
+      #while(
+        Compare(Name("n"), CmpOp("!=", Int(1))),
+        If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
+          Expr(Call(Attribute(Name("odd_numbers"), "append"), Name("n")))
+          Assign(
+            Name("n"),
+            BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
+          Assign(Name("n"), BinOp("//", Name("n"), Int(2)))))
+      ~> Expr(Call(Attribute(Name("odd_numbers"), "append"), Int(1)))
+      ~> Return(Call(Name("sorted"), Name("odd_numbers")))
+      ~> #endcall
+      =>
+      ref(1)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      1 |-> scope(
+        .Map [ "n" <- N ] [ "odd_numbers" <- ref(0) ],
+        parent(0))
+      0 |-> scope(M:Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(M, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(A)
+      =>
+      0 |-> list(collatzResult(N, A))
+      1 |-> list(sortVS(collatzResult(N, A)))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0
+      andBool notBool ("sorted" in_keys(M))
+
+  // Base-path proof: Collatz(1) is [1].
+  claim
+    <k> #getOddCollatz(1) => ref(1) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        .Map [
+          "get_odd_collatz" <-
+            closureVal(
+              "n", .ParamNames,
+              Assign(Name("odd_numbers"), ListExpr(.Exprs))
+              While(Compare(Name("n"), CmpOp("!=", Int(1))),
+                If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
+                  Expr(Call(Attribute(Name("odd_numbers"), "append"), Name("n")))
+                  Assign(
+                    Name("n"),
+                    BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
+                  Assign(Name("n"), BinOp("//", Name("n"), Int(2)))))
+              Expr(Call(Attribute(Name("odd_numbers"), "append"), Int(1)))
+              Return(Call(Name("sorted"), Name("odd_numbers"))),
+              0)
+        ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, .ValSeq))
+      1 |-> list(sortVS(vCons(1, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..faf768c9e9df0ec72d26bd850e38c36e823f0472
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,42 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The generated solution.mpy term, followed by a call of its public entry point.
+  syntax KItem ::= "#getOddCollatz" "(" Int ")"
+  rule #getOddCollatz(N:Int)
+    => #loadAll(
+         Module(
+           FuncDef("get_odd_collatz", Params("n"),
+             Assign(Name("odd_numbers"), ListExpr(.Exprs))
+             While(Compare(Name("n"), CmpOp("!=", Int(1))),
+               If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
+                 Expr(Call(Attribute(Name("odd_numbers"), "append"), Name("n")))
+                 Assign(
+                   Name("n"),
+                   BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
+                 Assign(Name("n"), BinOp("//", Name("n"), Int(2)))))
+             Expr(Call(Attribute(Name("odd_numbers"), "append"), Int(1)))
+             Return(Call(Name("sorted"), Name("odd_numbers"))))))
+       ~> Call(Name("get_odd_collatz"), Int(N), .Exprs)
+
+  // Functional specification of the unsorted odd Collatz values.  The
+  // accumulator form mirrors the loop invariant.  These equations deliberately
+  // express partial correctness: their unfolding follows the same Collatz
+  // transition as the program and therefore does not assume the conjecture.
+  syntax ValSeq ::= collatzResult(Int, ValSeq) [function]
+
+  rule collatzResult(1, A:ValSeq)
+    => valSeqConcat(A, vCons(1, .ValSeq))
+
+  rule collatzResult(N:Int, A:ValSeq)
+    => collatzResult(
+         3 *Int N +Int 1,
+         valSeqConcat(A, vCons(N, .ValSeq)))
+    requires N =/=Int 1 andBool pyMod(N, 2) ==Int 1
+
+  rule collatzResult(N:Int, A:ValSeq)
+    => collatzResult((N -Int pyMod(N, 2)) /Int 2, A)
+    requires N =/=Int 1 andBool notBool (pyMod(N, 2) ==Int 1)
+endmodule

