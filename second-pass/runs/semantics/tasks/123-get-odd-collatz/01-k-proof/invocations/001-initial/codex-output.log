+
+  rule collatzInvariant(1, A:ValSeq, F:ValSeq)
+    => F ==K valSeqConcat(A, vCons(1, .ValSeq))
+
+  rule collatzInvariant(N:Int, A:ValSeq, F:ValSeq)
+    => collatzInvariant(
