+        parent(0))
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap> 0 |-> list(A) </heap>
+    <scopeLoc> 2 </scopeLoc>
+    <heapLoc> 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 1 andBool notBool (pyMod(N, 2) ==Int 1)
+    [label(even-step)]
