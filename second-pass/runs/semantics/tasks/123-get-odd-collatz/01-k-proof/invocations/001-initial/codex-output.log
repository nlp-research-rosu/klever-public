diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9707ab2b70ba530f47a12be0a2d2cfe40bcd4b8d
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,60 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The generated solution.mpy term, followed by a call of its public entry point.
+  syntax KItem ::= "#getOddCollatz" "(" Int ")"
+  rule #getOddCollatz(N:Int)
+    => #loadAll(
+         Module(
+           FuncDef("get_odd_collatz", Params("n"),
+             Assign(Name("odd_numbers"), ListExpr(.Exprs))
+             While(Compare(Name("n"), CmpOp("!=", Int(1))),
+               If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
+                 Expr(Call(Attribute(Name("odd_numbers"), "append"), Name("n")))
+                 Assign(
+                   Name("n"),
+                   BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
+                 Assign(Name("n"), BinOp("//", Name("n"), Int(2)))))
+             Expr(Call(Attribute(Name("odd_numbers"), "append"), Int(1)))
+             Return(Call(Name("sorted"), Name("odd_numbers"))))))
+       ~> Call(Name("get_odd_collatz"), Int(N), .Exprs)
+
+  // Functional specification of the unsorted odd Collatz values.  The
+  // accumulator form mirrors the loop invariant.  These equations deliberately
+  // express partial correctness: their unfolding follows the same Collatz
+  // transition as the program and therefore does not assume the conjecture.
+  syntax ValSeq ::= collatzResult(Int, ValSeq) [function]
+
+  rule collatzResult(1, A:ValSeq)
+    => valSeqConcat(A, vCons(1, .ValSeq))
+
+  rule collatzResult(N:Int, A:ValSeq)
+    => collatzResult(
+         3 *Int N +Int 1,
+         valSeqConcat(A, vCons(N, .ValSeq)))
+    requires N =/=Int 1 andBool pyMod(N, 2) ==Int 1
+
+  rule collatzResult(N:Int, A:ValSeq)
+    => collatzResult((N -Int pyMod(N, 2)) /Int 2, A)
+    requires N =/=Int 1 andBool notBool (pyMod(N, 2) ==Int 1)
+
+  // The exact closure installed by loading solution.mpy.  This abbreviation
+  // keeps concrete end-to-end claims readable.
+  syntax Val ::= "getOddCollatzClosure" [function]
+  rule getOddCollatzClosure
+    => closureVal(
+         "n", .ParamNames,
+         Assign(Name("odd_numbers"), ListExpr(.Exprs))
+         While(Compare(Name("n"), CmpOp("!=", Int(1))),
+           If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
+             Expr(Call(Attribute(Name("odd_numbers"), "append"), Name("n")))
+             Assign(
+               Name("n"),
+               BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
+             Assign(Name("n"), BinOp("//", Name("n"), Int(2)))))
+         Expr(Call(Attribute(Name("odd_numbers"), "append"), Int(1)))
+         Return(Call(Name("sorted"), Name("odd_numbers"))),
+         0)
+endmodule

diff --git a/NOTES.md b/NOTES.md
new file mode 100644
index 0000000000000000000000000000000000000000..ccbaccb2899ed89d04a152da3bfe32e5b3587766
--- /dev/null
+++ b/NOTES.md
@@ -0,0 +1,26 @@
+# Verification scope
+
+`spec.k` proves the implementation at the semantic transition boundary:
+
+- `odd-step` symbolically proves, for every positive odd loop value greater
+  than one and every accumulated value sequence, that the program appends that
+  value and changes `n` to `3*n+1`.
+- `even-step` symbolically proves, for every positive non-odd loop value greater
+  than one, that the accumulator is unchanged and `n` changes according to the
+  supplied semantics' Python floor division.
+- `exit-step` symbolically proves, for every accumulated sequence at `n == 1`,
+  that the program appends `1` and returns `sortVS` of the complete sequence.
+- Four end-to-end claims prove complete executions for `1`, `5`, `6`, and `7`.
+  The LLVM assertion harness additionally executes the 111-step trace from
+  `27`.
+
+Together, the three symbolic claims are a partial-correctness proof for every
+finite Collatz trace: induction on the number of loop transitions composes
+`odd-step`/`even-step` with `exit-step`. The supplied semantics models
+`sorted` by its documented trusted `sortVS` primitive in symbolic proofs and
+by insertion sort in the LLVM runtime.
+
+A universal termination theorem for every positive integer is intentionally
+not claimed. Such a theorem would settle the Collatz conjecture, which remains
+open; K reachability proves the function's result on executions that reach
+`1`.
