+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant.  A is the sequence already accumulated in odd_numbers;
+  // collatzResult(N, A) is the complete sequence when the remaining run from
+  // N reaches 1.  This claim is circular exactly at the semantic #while head.
+  claim
+    <k>
+      #while(
+        Compare(Name("n"), CmpOp("!=", Int(1))),
+        If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
+          Expr(Call(Attribute(Name("odd_numbers"), "append"), Name("n")))
+          Assign(
+            Name("n"),
+            BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
+          Assign(Name("n"), BinOp("//", Name("n"), Int(2)))))
+      ~> Expr(Call(Attribute(Name("odd_numbers"), "append"), Int(1)))
+      ~> Return(Call(Name("sorted"), Name("odd_numbers")))
+      ~> #endcall
+      =>
+      ref(1)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      1 |-> scope(
+        .Map [ "n" <- N ] [ "odd_numbers" <- ref(0) ],
+        parent(0))
+      0 |-> scope(M:Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(M, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(A)
+      =>
+      0 |-> list(F)
+      1 |-> list(sortVS(F))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0
+      andBool notBool ("sorted" in_keys(M))
+      andBool collatzInvariant(N, A, F)
+
+  // Base-path proof: Collatz(1) is [1].
+  claim
+    <k> #getOddCollatz(1) => ref(1) </k>
+    <env> 0 </env>
+    <scopes>
