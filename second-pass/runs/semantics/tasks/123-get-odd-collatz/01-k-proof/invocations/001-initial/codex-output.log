diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..1bb9550a14640394a1a03296c0c9c330d2aba0ae
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def get_odd_collatz(n):
+    odd_numbers = []
+    while n != 1:
+        if n % 2 == 1:
+            odd_numbers.append(n)
+            n = 3 * n + 1
+        else:
+            n = n // 2
+    odd_numbers.append(1)
+    return sorted(odd_numbers)
