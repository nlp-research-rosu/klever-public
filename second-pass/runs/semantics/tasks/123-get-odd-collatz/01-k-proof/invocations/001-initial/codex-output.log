+    <scopes>
+      ...
+      L |-> scope(
+        "n" |-> (N => 3 *Int N +Int 1)
+        "odd_numbers" |-> ref(H)
+        REST:Map,
+        P:Parent)
+      ...
+    </scopes>
+    <heap>
+      ...
+      H |-> list(
+        A
+        =>
+        valSeqConcat(A, vCons(N, .ValSeq)))
+      ...
