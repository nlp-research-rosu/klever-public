+      0 |-> scope(M:Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(M, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(A)
+      =>
+      0 |-> list(collatzResult(N, A))
+      1 |-> list(sortVS(collatzResult(N, A)))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0
