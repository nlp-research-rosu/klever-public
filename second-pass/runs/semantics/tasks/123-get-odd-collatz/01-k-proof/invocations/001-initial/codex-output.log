+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(A)
+      =>
+      0 |-> list(valSeqConcat(A, vCons(1, .ValSeq)))
+      1 |-> list(sortVS(valSeqConcat(A, vCons(1, .ValSeq))))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool ("sorted" in_keys(M))
+    [label(exit-step)]
+
+  // End-to-end base case.
+  claim
+    <k> #getOddCollatz(1) => ref(1) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        .Map [ "get_odd_collatz" <- getOddCollatzClosure ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, .ValSeq))
+      1 |-> list(sortVS(vCons(1, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(case-1)]
+
+  // End-to-end examples covering both transition branches and nontrivial sort.
+  claim
+    <k> #getOddCollatz(5) => ref(1) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        .Map [ "get_odd_collatz" <- getOddCollatzClosure ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(5, vCons(1, .ValSeq)))
+      1 |-> list(sortVS(vCons(5, vCons(1, .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(case-5)]
+
+  claim
+    <k> #getOddCollatz(6) => ref(1) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        .Map [ "get_odd_collatz" <- getOddCollatzClosure ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
