+            vCons(17,
+              vCons(13,
+                vCons(5,
+                  vCons(1, .ValSeq)))))))
+      1 |-> list(sortVS(
+        vCons(7,
+          vCons(11,
+            vCons(17,
+              vCons(13,
+                vCons(5,
+                  vCons(1, .ValSeq))))))))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
