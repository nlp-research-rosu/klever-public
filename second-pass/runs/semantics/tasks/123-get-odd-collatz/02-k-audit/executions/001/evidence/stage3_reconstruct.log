    --exclude <labels>
      Exclude this comma separated list of claims
    --help, -h
      Print this help message
    --help-hidden, -hh
      Print advanced options help message
    --md-selector <expression>
      Preprocessor: for .md files, select only the md code blocks that match 
      the selector expression. Ex:'k&(!a|b)'.
      Default: k
    --no-alpha-renaming
      Do not alpha rename anonymous variables in output.
      Default: false
    --no-sort-collections
      Do not sort collections before printing (for speed).
      Default: false
    --no-substitution-filtering
      Do not remove conjuncts of anonymous variables from substitution in 
      output. 
      Default: false
    --output <mode>, -o <mode>
      How to display krun results. <mode> is either 
      [pretty|program|kast|binary|json|kore|none]. 
      Default: PRETTY
      Possible Values: [PRETTY, PROGRAM, KAST, JSON, KORE, NONE]
    --output-file <file>
      Store output in the file instead of displaying it.
    --output-flatten <KLabels>
      (Assoc) KLabels to flatten into one list.
      Default: []
    --output-omit <KLabels>
      KLabels to omit from the output.
      Default: []
    --output-tokast <KLabels>
      KLabels to output as KAST tokens.
      Default: []
    --output-tokenize <KLabels>
      KLabels to tokenize underneath (reducing output size).
      Default: []
    --spec-module <name>, -sm <name>
      Name of module containing specification to prove
    --temp-dir <path>
      Put temp files in this location. Default is /tmp/.<tool>-xxx
    --trusted <labels>
      Mark this comma separated list of claims as [trusted]
    --verbose, -v
      Print verbose output messages
