     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // The generated solution.mpy term, followed by a call of its public entry point.
     7	  syntax KItem ::= "#getOddCollatz" "(" Int ")"
     8	  rule #getOddCollatz(N:Int)
     9	    => #loadAll(
    10	         Module(
    11	           FuncDef("get_odd_collatz", Params("n"),
    12	             Assign(Name("odd_numbers"), ListExpr(.Exprs))
    13	             While(Compare(Name("n"), CmpOp("!=", Int(1))),
    14	               If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
    15	                 Expr(Call(Attribute(Name("odd_numbers"), "append"), Name("n")))
    16	                 Assign(
    17	                   Name("n"),
    18	                   BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
    19	                 Assign(Name("n"), BinOp("//", Name("n"), Int(2)))))
    20	             Expr(Call(Attribute(Name("odd_numbers"), "append"), Int(1)))
    21	             Return(Call(Name("sorted"), Name("odd_numbers"))))))
    22	       ~> Call(Name("get_odd_collatz"), Int(N), .Exprs)
    23	
    24	  // Functional specification of the unsorted odd Collatz values.  The
    25	  // accumulator form mirrors the loop invariant.  These equations deliberately
    26	  // express partial correctness: their unfolding follows the same Collatz
    27	  // transition as the program and therefore does not assume the conjecture.
    28	  syntax ValSeq ::= collatzResult(Int, ValSeq) [function]
    29	
    30	  rule collatzResult(1, A:ValSeq)
    31	    => valSeqConcat(A, vCons(1, .ValSeq))
    32	
    33	  rule collatzResult(N:Int, A:ValSeq)
    34	    => collatzResult(
    35	         3 *Int N +Int 1,
    36	         valSeqConcat(A, vCons(N, .ValSeq)))
    37	    requires N =/=Int 1 andBool pyMod(N, 2) ==Int 1
    38	
    39	  rule collatzResult(N:Int, A:ValSeq)
    40	    => collatzResult((N -Int pyMod(N, 2)) /Int 2, A)
    41	    requires N =/=Int 1 andBool notBool (pyMod(N, 2) ==Int 1)
    42	
    43	  // The exact closure installed by loading solution.mpy.  This abbreviation
    44	  // keeps concrete end-to-end claims readable.
    45	  syntax Val ::= "getOddCollatzClosure" [function]
    46	  rule getOddCollatzClosure
    47	    => closureVal(
    48	         "n", .ParamNames,
    49	         Assign(Name("odd_numbers"), ListExpr(.Exprs))
    50	         While(Compare(Name("n"), CmpOp("!=", Int(1))),
    51	           If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
    52	             Expr(Call(Attribute(Name("odd_numbers"), "append"), Name("n")))
    53	             Assign(
    54	               Name("n"),
    55	               BinOp("+", BinOp("*", Int(3), Name("n")), Int(1))),
    56	             Assign(Name("n"), BinOp("//", Name("n"), Int(2)))))
    57	         Expr(Call(Attribute(Name("odd_numbers"), "append"), Int(1)))
    58	         Return(Call(Name("sorted"), Name("odd_numbers"))),
    59	         0)
