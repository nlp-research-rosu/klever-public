+
+run_log() {
+  local log_file=$1
+  shift
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  {
+    printf '$'
+    printf ' %q' "$@"
+    printf '\n'
+    "$@"
+    local command_rc=$?
+    printf '[exit %d]\n' "$command_rc"
+    return "$command_rc"
+  } 2>&1 | tee "$log_file"
+  local pipeline_rc=${PIPESTATUS[0]}
+  printf '[recorded exit %d in %s]\n' "$pipeline_rc" "$log_file"
