+}
+
+work=/tmp/audit-work/123-get-odd-collatz/candidate-src
+
+printf 'Stage 2 program-fidelity checks\n'
+
+printf '\nTrusted translator regeneration\n'
+printf '$ cd %q && python3 %q %q > %q\n' \
