+  (
+    cd "$src" || exit 125
+    run_log "$evidence/stage3_kprove_${label}.log" \
+      kprove spec.k \
+        --definition verification-kompiled-audit \
+        --spec-module SPEC \
+        --claims "SPEC.$label" \
+        --depth 2000 \
+        --smt-timeout 5000
