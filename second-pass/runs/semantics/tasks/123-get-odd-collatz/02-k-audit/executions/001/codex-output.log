+evidence=/audit-output/evidence
+
+run_log() {
+  local log_file=$1
+  shift
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  {
+    printf '$'
+    printf ' %q' "$@"
+    printf '\n'
+    "$@"
+    local command_rc=$?
