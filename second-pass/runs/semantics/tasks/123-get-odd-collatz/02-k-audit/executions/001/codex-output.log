     1	// reference/src/semantics/subscript.k — MPY-SUBSCRIPT
     2	
     3	module MPY-SUBSCRIPT
     4	  imports MPY-CORE
     5	
     6	  // ==== positional access + negative-index normalization (used only here) ===
     7	  // valSeqAt is [total]: in-bounds vCons access reduces as usual; on an OPAQUE sequence (e.g.
     8	  // a trusted sort's sortVS(VS)) or OOB it stays an abstract total value — so indexing the
     9	  // opaque sorted list is DEFINED (no undischarged #Ceil), matching the old semantics' total
    10	  // atK. K trusts the [total] annotation; valid programs index in-bounds.
    11	  syntax Val ::= valSeqAt(ValSeq, Int) [function, total]
    12	  rule valSeqAt(vCons(V:Val, _:ValSeq), 0)     => V
    13	  rule valSeqAt(vCons(_:Val, S:ValSeq), I:Int) => valSeqAt(S, I -Int 1)
    14	       requires I >Int 0
    15	
    16	  syntax Int ::= intSeqAt(IntSeq, Int) [function]
    17	  rule intSeqAt(iCons(C:Int, _:IntSeq), 0)     => C
    18	  rule intSeqAt(iCons(_:Int, S:IntSeq), I:Int) => intSeqAt(S, I -Int 1)
    19	       requires I >Int 0
    20	
    21	  syntax Int ::= normIdx(Int, Int) [function, total]
    22	  rule normIdx(I:Int, LEN:Int) => I +Int LEN requires I  <Int 0
    23	  rule normIdx(I:Int, _:Int)   => I          requires I >=Int 0
    24	
    25	  // ==== Subscript: indexing obj[i] (list / tuple / str) =====================
    26	  // contexts (not strict attrs): the Index slot's Slice alternative must never heat
    27	  context Subscript(HOLE, _)
    28	  context Subscript(_:Val, HOLE:Expr)
    29	
    30	  // heap-object deref (covers both the index and slice forms via the Index slot)
    31	  rule <k> Subscript(ref(H:Int), IX:Index) => Subscript(V, IX) ... </k>
    32	       <heap> ... H |-> V:Val ... </heap>
    33	       [priority(40)]
    34	
    35	  rule <k> Subscript(OBJ:Val, I:Int) => applyIndex(OBJ, I) ... </k>
    36	
    37	  syntax Val ::= applyIndex(Val, Int) [function]
    38	  rule applyIndex(list(VS:ValSeq),  I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
    39	  rule applyIndex(tuple(VS:ValSeq), I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
    40	  rule applyIndex(str(IS:IntSeq),   I:Int)
    41	    => str(iCons(intSeqAt(IS, normIdx(I, isLen(IS))), .IntSeq))
    42	
    43	  // ==== Slice: obj[lo:hi:step] (list / str) — CPython slice.indices ==========
    44	  syntax KItem ::= #evalB(Bound) | "#toSome"
    45	                 | #slLo(Val, Bound, Bound)
    46	                 | #slHi(Val, OptInt, Bound)
    47	                 | #slStep(Val, OptInt, OptInt)
    48	
    49	  syntax OptInt ::= "noB" | someB(Int)
    50	  rule <k> #evalB(NoBound)  => noB ... </k>
    51	  rule <k> #evalB(E:Expr)   => E ~> #toSome ... </k>
    52	  rule <k> I:Int ~> #toSome => someB(I) ... </k>
    53	
    54	  rule <k> Subscript(OBJ:Val, Slice(LO:Bound, HI:Bound, ST:Bound)) => #evalB(LO) ~> #slLo(OBJ, HI, ST) ... </k>
    55	  rule <k> LO:OptInt ~> #slLo(OBJ:Val, HI:Bound, ST:Bound)   => #evalB(HI) ~> #slHi(OBJ, LO, ST) ... </k>
    56	  rule <k> HI:OptInt ~> #slHi(OBJ:Val, LO:OptInt, ST:Bound)  => #evalB(ST) ~> #slStep(OBJ, LO, HI) ... </k>
    57	  // a list slice constructs a NEW object; a str slice stays a value
    58	  rule <k> ST:OptInt ~> #slStep(list(VS:ValSeq), LO:OptInt, HI:OptInt)
    59	        => #alloc(doSlice(list(VS), LO, HI, ST)) ... </k>
    60	       [priority(45)]
    61	  rule <k> ST:OptInt ~> #slStep(OBJ:Val, LO:OptInt, HI:OptInt) => doSlice(OBJ, LO, HI, ST) ... </k>
    62	
    63	  syntax Val ::= doSlice(Val, OptInt, OptInt, OptInt) [function]
    64	  rule doSlice(list(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    65	    => list(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))
    66	  rule doSlice(tuple(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    67	    => tuple(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))
    68	  rule doSlice(str(IS:IntSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    69	    => str(buildIS(IS, slStart(LO, ST, isLen(IS)), slStop(HI, ST, isLen(IS)), slStep(ST)))
    70	
    71	  // ==== slice.indices: step / start / stop / clamp ==========================
    72	  syntax Int ::= slStep(OptInt) [function, total]
    73	  rule slStep(noB)          => 1
    74	  rule slStep(someB(S:Int)) => S
    75	
    76	  syntax Int ::= slStart(OptInt, OptInt, Int) [function]
    77	  rule slStart(noB,          ST:OptInt, _LEN:Int) => 0
    78	       requires slStep(ST) >Int 0
    79	  rule slStart(noB,          ST:OptInt, LEN:Int)  => LEN -Int 1
    80	       requires slStep(ST) <Int 0
    81	  rule slStart(someB(I:Int), ST:OptInt, LEN:Int)  => slAdjust(I, LEN, slStep(ST))
    82	
    83	  syntax Int ::= slStop(OptInt, OptInt, Int) [function]
    84	  rule slStop(noB,          ST:OptInt, LEN:Int)  => LEN
    85	       requires slStep(ST) >Int 0
    86	  rule slStop(noB,          ST:OptInt, _LEN:Int) => -1
    87	       requires slStep(ST) <Int 0
    88	  rule slStop(someB(I:Int), ST:OptInt, LEN:Int)  => slAdjust(I, LEN, slStep(ST))
    89	
    90	  syntax Int ::= slAdjust(Int, Int, Int) [function, total]
    91	  rule slAdjust(I:Int, LEN:Int, STEP:Int) => clampLo(I +Int LEN, STEP)
    92	       requires I  <Int 0
    93	  rule slAdjust(I:Int, LEN:Int, STEP:Int) => clampHi(I, LEN, STEP)
    94	       requires I >=Int 0
    95	
    96	  syntax Int ::= clampLo(Int, Int) [function, total]
    97	  rule clampLo(J:Int, _STEP:Int) => J
    98	       requires J >=Int 0
    99	  rule clampLo(J:Int, STEP:Int)  => #if STEP <Int 0 #then -1 #else 0 #fi
   100	       requires J <Int 0
   101	
   102	  syntax Int ::= clampHi(Int, Int, Int) [function, total]
   103	  rule clampHi(I:Int, LEN:Int, _STEP:Int) => I
   104	       requires I  <Int LEN
   105	  rule clampHi(I:Int, LEN:Int, STEP:Int)  => #if STEP <Int 0 #then LEN -Int 1 #else LEN #fi
   106	       requires I >=Int LEN
   107	
   108	  // ==== build the strided sub-sequence (indices in range by construction) ====
   109	  syntax ValSeq ::= buildVS(ValSeq, Int, Int, Int) [function]
   110	  rule buildVS(VS:ValSeq, I:Int, STOP:Int, STEP:Int)
   111	    => vCons(valSeqAt(VS, I), buildVS(VS, I +Int STEP, STOP, STEP))
   112	       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)
   113	  rule buildVS(_:ValSeq, I:Int, STOP:Int, STEP:Int) => .ValSeq
   114	       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))
   115	
   116	  syntax IntSeq ::= buildIS(IntSeq, Int, Int, Int) [function]
   117	  rule buildIS(IS:IntSeq, I:Int, STOP:Int, STEP:Int)
   118	    => iCons(intSeqAt(IS, I), buildIS(IS, I +Int STEP, STOP, STEP))
   119	       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)
   120	  rule buildIS(_:IntSeq, I:Int, STOP:Int, STEP:Int) => .IntSeq
   121	       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))
   122	endmodule

diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..4b073ea0ca0159dc9398ee125357f10fd0821441
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,164 @@
+#!/usr/bin/env python3
+"""Independent canonical-versus-generated differential test.
+
+The trusted canonical module and the scratch-copied generated module are loaded
+under distinct names.  The fixed seed and complete input list are emitted before
+the per-case outcomes.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import multiprocessing
+import random
+import sys
+from collections.abc import Callable
+from typing import Any
+
+
+CANONICAL_PATH = "/tmp/audit-work/123-get-odd-collatz/trusted/canonical.py"
+GENERATED_PATH = "/tmp/audit-work/123-get-odd-collatz/candidate-src/solution.py"
+
+
+def load(path: str, module_name: str):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def outcome(function: Callable[[Any], Any], value: Any) -> dict[str, Any]:
+    try:
+        return {"kind": "return", "value": function(value)}
+    except Exception as error:  # The exception type/message are evidence.
+        return {
+            "kind": "exception",
+            "type": type(error).__name__,
+            "message": str(error),
+        }
+
+
+def child_outcome(path: str, module_name: str, value: Any, queue) -> None:
+    module = load(path, module_name)
+    queue.put(outcome(module.get_odd_collatz, value))
+
+
+def timed_outcome(path: str, module_name: str, value: Any) -> dict[str, Any]:
+    queue = multiprocessing.Queue()
+    process = multiprocessing.Process(
+        target=child_outcome, args=(path, module_name, value, queue)
+    )
+    process.start()
+    process.join(0.25)
+    if process.is_alive():
+        process.terminate()
+        process.join()
+        return {"kind": "timeout", "seconds": 0.25}
+    if queue.empty():
+        return {"kind": "child-exit", "exitcode": process.exitcode}
+    return queue.get()
+
+
+def comparable(left: dict[str, Any], right: dict[str, Any]) -> bool:
+    if left["kind"] != right["kind"]:
+        return False
+    if left["kind"] == "return":
+        return left["value"] == right["value"]
+    if left["kind"] == "exception":
+        return left["type"] == right["type"]
+    return left == right
+
+
+def main() -> int:
+    canonical = load(CANONICAL_PATH, "trusted_canonical")
+    generated = load(GENERATED_PATH, "audited_generated")
+
+    rng = random.Random(123)
+    random_inputs = rng.sample(range(1, 5001), 64)
+    cases: list[tuple[str, Any]] = [
+        ("documented-example", 5),
+        ("empty-out-of-domain", []),
+        ("zero-out-of-domain-nontermination", 0),
+        ("positive-boundary", 1),
+        ("first-even-branch", 2),
+        ("first-odd-loop-branch", 3),
+        ("even-to-even-boundary", 4),
+        ("mixed-branch-example", 6),
+        ("longer-branch-example", 7),
+        ("power-of-two", 16),
+        ("long-trace", 27),
+    ]
+    cases.extend(("seed-123-generated", value) for value in random_inputs)
+    cases.extend(
+        [
+            ("float-exactness-control", 2**53),
+            ("float-rounding-boundary", 2 * (2**53 + 1)),
+            ("larger-float-rounding-boundary", 2**60 + 2),
+        ]
+    )
+
+    print(
+        json.dumps(
+            {
+                "oracle": CANONICAL_PATH,
+                "generated": GENERATED_PATH,
+                "random_seed": 123,
+                "random_inputs": random_inputs,
+                "cases": [{"category": category, "input": value} for category, value in cases],
+            },
+            sort_keys=True,
+        )
+    )
+
+    mismatches = 0
+    in_domain_mismatches = 0
+    for index, (category, value) in enumerate(cases):
+        if category == "zero-out-of-domain-nontermination":
+            canonical_result = timed_outcome(
+                CANONICAL_PATH, f"canonical_child_{index}", value
+            )
+            generated_result = timed_outcome(
+                GENERATED_PATH, f"generated_child_{index}", value
+            )
+        else:
+            canonical_result = outcome(canonical.get_odd_collatz, value)
+            generated_result = outcome(generated.get_odd_collatz, value)
+        same = comparable(canonical_result, generated_result)
+        if not same:
+            mismatches += 1
+            if category != "empty-out-of-domain" and not category.startswith("zero-"):
+                in_domain_mismatches += 1
+        print(
+            json.dumps(
+                {
+                    "index": index,
+                    "category": category,
+                    "input": value,
+                    "canonical": canonical_result,
+                    "generated": generated_result,
+                    "same": same,
+                },
+                sort_keys=True,
+            )
+        )
+
+    print(
+        json.dumps(
+            {
+                "summary": {
+                    "case_count": len(cases),
+                    "mismatches": mismatches,
+                    "in_domain_mismatches": in_domain_mismatches,
+                }
+            },
+            sort_keys=True,
+        )
+    )
+    return 1 if in_domain_mismatches else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/evidence/stage1_integrity.sh b/evidence/stage1_integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..02c8bcfbb193f9ceaa8ccbce1e1f07ae4376b98a
--- /dev/null
+++ b/evidence/stage1_integrity.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+set -u
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local rc=$?
+  printf '[exit %d]\n' "$rc"
+  return 0
+}
+
+printf 'Stage 1 provenance and supplied-semantics integrity checks\n'
+printf 'Audit date (UTC): '
+run date -u +%Y-%m-%dT%H:%M:%SZ
+
+printf '\nCandidate top-level manifest (including types and links)\n'
+run find /candidate -maxdepth 2 -printf '%P\t%y\t%m\t%s\t%l\n'
+
+printf '\nRequired and claim/evidence artifact presence\n'
+for artifact in \
+  run-input.json metrics.json codex-last.txt codex-output.log \
+  prompt.py py2mpy.py solution.py solution.mpy spec.k verification.k; do
+  if [[ -e "/candidate/$artifact" || -L "/candidate/$artifact" ]]; then
+    run stat -c '%n|type=%F|mode=%a|size=%s' "/candidate/$artifact"
+  else
+    printf 'MISSING /candidate/%s\n' "$artifact"
+  fi
+done
+
+printf '\nStructured-generation-trace filename search\n'
+run find /candidate -maxdepth 2 -type f \
+  \( -iname '*trace*' -o -iname '*.jsonl' -o -iname '*generation*.json' \) -print
+
+printf '\nCandidate symlink search (any symlink is relevant)\n'
+run find /candidate -type l -printf '%p -> %l\n'
+
+printf '\nTrusted/candidate prompt comparison\n'
+run sha256sum /reference/prompt.py /candidate/prompt.py
+run cmp -s /reference/prompt.py /candidate/prompt.py
+
+printf '\nTrusted/candidate translator comparison\n'
+run sha256sum /reference/py2mpy.py /candidate/py2mpy.py
+run cmp -s /reference/py2mpy.py /candidate/py2mpy.py
+
+printf '\nTrusted supplied-semantics manifest\n'
+run find /reference/reference-semantics -printf '%P\t%y\t%m\t%s\t%l\n'
+
+printf '\nCandidate supplied-semantics manifest\n'
+run find /candidate/reference-semantics -printf '%P\t%y\t%m\t%s\t%l\n'
+
+printf '\nSupplied-semantics recursive byte/type comparison\n'
+run diff --no-dereference -qr \
+  /reference/reference-semantics /candidate/reference-semantics
+
+printf '\nSupplied-semantics file hashes (trusted then candidate)\n'
+run bash -c 'find /reference/reference-semantics -type f -print0 | sort -z | xargs -0 sha256sum'
+run bash -c 'find /candidate/reference-semantics -type f -print0 | sort -z | xargs -0 sha256sum'
