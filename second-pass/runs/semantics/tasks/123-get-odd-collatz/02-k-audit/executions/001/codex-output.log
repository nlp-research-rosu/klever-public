+  "$src" /tmp/audit-work/123-get-odd-collatz/trusted/py2mpy.py \
+  concrete_tests.py concrete_tests.regenerated.mpy
+(
+  cd "$src" || exit 125
+  python3 /tmp/audit-work/123-get-odd-collatz/trusted/py2mpy.py \
+    concrete_tests.py > concrete_tests.regenerated.mpy
+)
+regen_rc=$?
