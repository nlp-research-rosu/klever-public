index 0000000000000000000000000000000000000000..3db84a6e30daeee17f232911a07ef5122b52b032
--- /dev/null
+++ b/evidence/concrete_audit.py
@@ -0,0 +1,62 @@
+def get_odd_collatz(n):
+    odd_numbers = []
+    while n != 1:
+        if n % 2 == 1:
+            odd_numbers.append(n)
+            n = 3 * n + 1
+        else:
+            n = n // 2
+    odd_numbers.append(1)
+    return sorted(odd_numbers)
+
+
+assert get_odd_collatz(1) == [1]
+assert get_odd_collatz(2) == [1]
+assert get_odd_collatz(3) == [1, 3, 5]
+assert get_odd_collatz(5) == [1, 5]
+assert get_odd_collatz(6) == [1, 3, 5]
+assert get_odd_collatz(7) == [1, 5, 7, 11, 13, 17]
+assert get_odd_collatz(27) == [
+    1,
+    5,
+    23,
+    27,
+    31,
+    35,
+    41,
+    47,
+    53,
+    61,
+    71,
+    91,
+    103,
+    107,
+    121,
