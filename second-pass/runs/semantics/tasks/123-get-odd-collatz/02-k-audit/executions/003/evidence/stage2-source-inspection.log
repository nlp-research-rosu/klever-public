     6	def get_odd_collatz(n):
     7	    """
     8	    Given a positive integer n, return a sorted list that has the odd numbers in collatz sequence.
     9	
    10	    The Collatz conjecture is a conjecture in mathematics that concerns a sequence defined
    11	    as follows: start with any positive integer n. Then each term is obtained from the 
    12	    previous term as follows: if the previous term is even, the next term is one half of 
    13	    the previous term. If the previous term is odd, the next term is 3 times the previous
    14	    term plus 1. The conjecture is that no matter what value of n, the sequence will always reach 1.
    15	
    16	    Note: 
    17	        1. Collatz(1) is [1].
    18	        2. returned list sorted in increasing order.
    19	
    20	    For example:
    21	    get_odd_collatz(5) returns [1, 5] # The collatz sequence for 5 is [5, 16, 8, 4, 2, 1], so the odd numbers are only 1, and 5.
    22	    """
    23	    if n%2==0:
    24	        odd_collatz = [] 
    25	    else:
    26	        odd_collatz = [n]
    27	    while n > 1:
    28	        if n % 2 == 0:
    29	            n = n/2
    30	        else:
    31	            n = n*3 + 1
    32	            
    33	        if n%2 == 1:
    34	            odd_collatz.append(int(n))
    35	
    36	    return sorted(odd_collatz)
===== /candidate/solution.py =====
     1	def get_odd_collatz(n):
     2	    odd_numbers = []
     3	    while n != 1:
     4	        if n % 2 == 1:
     5	            odd_numbers.append(n)
     6	            n = 3 * n + 1
     7	        else:
     8	            n = n // 2
     9	    odd_numbers.append(1)
    10	    return sorted(odd_numbers)
