Module(
  FuncDef("words_in_sentence", Params("sentence"),
    Assign(Name("words"), Call(Attribute(Name("sentence"), "split"), ))
    Assign(Name("result"), Str(""))
    Assign(Name("word"), Str(""))
    Assign(Name("n"), Int(0))
    Assign(Name("_plain"), Int(0))
    For(Name("word"), Name("words"),
      Assign(Name("n"), Call(Name("len"), Name("word")))
      If(BoolOp(
        "or",
        Compare(Name("n"), CmpOp("==", Int(2))),
        Compare(Name("n"), CmpOp("==", Int(3))),
        Compare(Name("n"), CmpOp("==", Int(5))),
        Compare(Name("n"), CmpOp("==", Int(7))),
        Compare(Name("n"), CmpOp("==", Int(11))),
        Compare(Name("n"), CmpOp("==", Int(13))),
        Compare(Name("n"), CmpOp("==", Int(17))),
        Compare(Name("n"), CmpOp("==", Int(19))),
        Compare(Name("n"), CmpOp("==", Int(23))),
        Compare(Name("n"), CmpOp("==", Int(29))),
        Compare(Name("n"), CmpOp("==", Int(31))),
        Compare(Name("n"), CmpOp("==", Int(37))),
        Compare(Name("n"), CmpOp("==", Int(41))),
        Compare(Name("n"), CmpOp("==", Int(43))),
        Compare(Name("n"), CmpOp("==", Int(47))),
        Compare(Name("n"), CmpOp("==", Int(53))),
        Compare(Name("n"), CmpOp("==", Int(59))),
        Compare(Name("n"), CmpOp("==", Int(61))),
        Compare(Name("n"), CmpOp("==", Int(67))),
        Compare(Name("n"), CmpOp("==", Int(71))),
        Compare(Name("n"), CmpOp("==", Int(73))),
        Compare(Name("n"), CmpOp("==", Int(79))),
        Compare(Name("n"), CmpOp("==", Int(83))),
        Compare(Name("n"), CmpOp("==", Int(89))),
        Compare(Name("n"), CmpOp("==", Int(97)))),
        If(Compare(Name("result"), CmpOp("==", Str(""))),
          Assign(Name("result"), Name("word")),
          Assign(
            Name("result"),
            BinOp(
              "+",
              BinOp("+", Name("result"), Str(" ")),
              Name("word")))),
        ))
    Return(Name("result"))))
