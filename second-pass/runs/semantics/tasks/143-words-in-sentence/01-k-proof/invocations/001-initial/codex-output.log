+           ("result" |-> _:Val)
+           ("word" |-> W:Val)
+           ("n" |-> N:Int)
+           M:Map
+           =>
+           ("_plain" |-> 0)
+           ("result" |-> V)
+           ("word" |-> W)
+           ("n" |-> N)
+           M,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k>
+         Call(Name("len"), Name("word"))
+         => isLen(C)
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("word" |-> str(C:IntSeq))
+           M:Map,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k> Name("n") => N ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("result" |-> R:Val)
+           ("word" |-> W:Val)
+           ("n" |-> N:Int)
+           M:Map,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k> Name("word") => W ... </k>
