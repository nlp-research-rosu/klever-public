+  // count of nonempty alphabetic words, single-space separated, total length
+  // from 1 through 100.
+  claim [words-in-sentence-correct]:
+    <k>
+      #loadAll(solutionProgram)
+      ~> Call(
+           Name("words_in_sentence"),
+           str(sentenceCodes(W:WordSeq)))
+      =>
+      str(filterWords(.IntSeq, W))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0  |-> scope(
+               "words_in_sentence"
+                 |-> closureVal(
+                       ("sentence", .ParamNames),
+                       solutionBody,
+                       0),
+               parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(wordsVals(W))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
