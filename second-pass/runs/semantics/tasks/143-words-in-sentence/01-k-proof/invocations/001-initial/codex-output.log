+    n = 0
+    for word in words:
+        n = len(word)
+        if (
+            n == 2
+            or n == 3
+            or n == 5
+            or n == 7
+            or n == 11
+            or n == 13
+            or n == 17
+            or n == 19
+            or n == 23
+            or n == 29
+            or n == 31
+            or n == 37
+            or n == 41
+            or n == 43
+            or n == 47
+            or n == 53
+            or n == 59
+            or n == 61
+            or n == 67
+            or n == 71
+            or n == 73
+            or n == 79
