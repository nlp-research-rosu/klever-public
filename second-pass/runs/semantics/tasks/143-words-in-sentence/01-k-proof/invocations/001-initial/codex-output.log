+  rule <k> #bindTgt(Name("word"), V:Val) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("result" |-> R:Val)
+           ("word" |-> _:Val)
+           ("n" |-> N:Int)
+           M:Map
+           =>
+           ("_plain" |-> 0)
+           ("result" |-> R)
+           ("word" |-> V)
+           ("n" |-> N)
+           M,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k> Assign(Name("n"), V:Int) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("result" |-> R:Val)
+           ("word" |-> W:Val)
+           ("n" |-> _:Int)
+           M:Map
+           =>
+           ("_plain" |-> 0)
+           ("result" |-> R)
+           ("word" |-> W)
+           ("n" |-> V)
+           M,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k> Assign(Name("result"), V:Val) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("result" |-> _:Val)
+           ("word" |-> W:Val)
+           ("n" |-> N:Int)
+           M:Map
+           =>
+           ("_plain" |-> 0)
+           ("result" |-> V)
+           ("word" |-> W)
+           ("n" |-> N)
+           M,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k>
+         Call(Name("len"), Name("word"))
+         => isLen(C)
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("word" |-> str(C:IntSeq))
+           M:Map,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k> Name("n") => N ... </k>
+       <env> L:Int </env>
+       <scopes>
