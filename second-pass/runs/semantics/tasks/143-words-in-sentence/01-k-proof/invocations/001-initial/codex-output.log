+def words_in_sentence(sentence):
+    words = sentence.split()
+    result = ""
+    word = ""
+    n = 0
+    _plain = 0
+    for word in words:
+        n = len(word)
+        if (
+            n == 2
+            or n == 3
+            or n == 5
+            or n == 7
+            or n == 11
+            or n == 13
+            or n == 17
+            or n == 19
+            or n == 23
+            or n == 29
+            or n == 31
+            or n == 37
+            or n == 41
+            or n == 43
+            or n == 47
+            or n == 53
+            or n == 59
+            or n == 61
+            or n == 67
+            or n == 71
+            or n == 73
+            or n == 79
+            or n == 83
+            or n == 89
+            or n == 97
+        ):
+            if result == "":
+                result = word
+            else:
+                result = result + " " + word
+    return result
+
+
+assert words_in_sentence("This is a test") == "is"
+assert words_in_sentence("lets go for swimming") == "go for"
+assert words_in_sentence("a bb ccc dddd eeeee ffffff ggggggg") == "bb ccc eeeee ggggggg"
+assert words_in_sentence("single") == ""
