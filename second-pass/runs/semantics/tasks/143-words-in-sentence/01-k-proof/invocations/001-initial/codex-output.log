+            or n == 37
+            or n == 41
+            or n == 43
+            or n == 47
+            or n == 53
+            or n == 59
+            or n == 61
+            or n == 67
+            or n == 71
+            or n == 73
+            or n == 79
+            or n == 83
+            or n == 89
+            or n == 97
+        ):
+            if result == "":
