+        list(wordsVals(W:WordSeq)),
+        Name("word"),
+        solutionLoopBody)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("result" |-> str(A:IntSeq))
+        ("word"   |-> OLDWORD:Val)
+        ("n"      |-> OLDN:Int)
+        ("_plain" |-> 0)
+        REST:Map,
+        P:Parent)
+      =>
