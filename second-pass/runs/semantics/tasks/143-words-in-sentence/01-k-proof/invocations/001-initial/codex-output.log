+
+  syntax IntSeq ::= filterWords(IntSeq, WordSeq) [function, total]
+  rule filterWords(A:IntSeq, .WordSeq) => A
+  rule filterWords(A:IntSeq, wCons(C:IntSeq, R:WordSeq))
+    => filterWords(selectWord(A, C), R)
+
+  // This is the exact expression emitted in solution.mpy.
+  syntax Expr ::= primeTest(Expr) [macro]
+  rule primeTest(E:Expr)
+    => BoolOp(
+         "or",
+         Compare(E, CmpOp("==", Int(2))),
+         Compare(E, CmpOp("==", Int(3))),
+         Compare(E, CmpOp("==", Int(5))),
+         Compare(E, CmpOp("==", Int(7))),
+         Compare(E, CmpOp("==", Int(11))),
+         Compare(E, CmpOp("==", Int(13))),
+         Compare(E, CmpOp("==", Int(17))),
+         Compare(E, CmpOp("==", Int(19))),
+         Compare(E, CmpOp("==", Int(23))),
+         Compare(E, CmpOp("==", Int(29))),
+         Compare(E, CmpOp("==", Int(31))),
+         Compare(E, CmpOp("==", Int(37))),
+         Compare(E, CmpOp("==", Int(41))),
+         Compare(E, CmpOp("==", Int(43))),
+         Compare(E, CmpOp("==", Int(47))),
+         Compare(E, CmpOp("==", Int(53))),
+         Compare(E, CmpOp("==", Int(59))),
+         Compare(E, CmpOp("==", Int(61))),
+         Compare(E, CmpOp("==", Int(67))),
+         Compare(E, CmpOp("==", Int(71))),
+         Compare(E, CmpOp("==", Int(73))),
+         Compare(E, CmpOp("==", Int(79))),
+         Compare(E, CmpOp("==", Int(83))),
+         Compare(E, CmpOp("==", Int(89))),
+         Compare(E, CmpOp("==", Int(97))))
+
+  syntax Stmts ::= "solutionLoopBody" [macro]
+  rule solutionLoopBody
+    => Assign(Name("n"), Call(Name("len"), Name("word")))
+       If(
+         primeTest(Name("n")),
+         If(
+           Compare(Name("result"), CmpOp("==", Str(""))),
+           Assign(Name("result"), Name("word")) .Stmts,
+           Assign(
+             Name("result"),
+             BinOp(
+               "+",
+               BinOp("+", Name("result"), Str(" ")),
+               Name("word"))) .Stmts) .Stmts,
+         .Stmts) .Stmts
+
+  syntax Stmts ::= "solutionBody" [macro]
+  rule solutionBody
+    => Assign(
+         Name("words"),
+         Call(Attribute(Name("sentence"), "split"), .Exprs))
+       Assign(Name("result"), Str(""))
+       Assign(Name("word"), Str(""))
+       Assign(Name("n"), Int(0))
+       Assign(Name("_plain"), Int(0))
+       For(Name("word"), Name("words"), solutionLoopBody)
+       Return(Name("result"))
+       .Stmts
+
+  syntax Module ::= "solutionProgram" [macro]
+  rule solutionProgram
+    => Module(
+         FuncDef(
+           "words_in_sentence",
+           Params("sentence"),
+           solutionBody)
+         .Stmts)
+
+  // The reference split implementation is concrete.  This extensional rule
+  // exposes its result for a symbolic, contract-valid sentence representation.
+  rule <k>
+         #applyK(
+           toCall(boundMethodV(str(sentenceCodes(W:WordSeq)), "split")),
+           .Vals)
+         => #alloc(list(wordsVals(W)))
+         ...
+       </k>
+    requires validWords(W)
+    [priority(30)]
+
+  // The frontend marks this capture-free function as a plain frame.  These
+  // priority rules make that known fact explicit to symbolic execution and
+  // suppress infeasible closure-cell branches over an abstract map remainder.
+  rule <k> #bindTgt(Name("word"), V:Val) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("result" |-> R:Val)
+           ("word" |-> _:Val)
+           ("n" |-> N:Int)
+           M:Map
+           =>
+           ("_plain" |-> 0)
+           ("result" |-> R)
+           ("word" |-> V)
+           ("n" |-> N)
+           M,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k> Assign(Name("n"), V:Int) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("result" |-> R:Val)
+           ("word" |-> W:Val)
+           ("n" |-> _:Int)
+           M:Map
+           =>
+           ("_plain" |-> 0)
+           ("result" |-> R)
+           ("word" |-> W)
+           ("n" |-> V)
+           M,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k> Assign(Name("result"), V:Val) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("result" |-> _:Val)
+           ("word" |-> W:Val)
+           ("n" |-> N:Int)
+           M:Map
+           =>
+           ("_plain" |-> 0)
+           ("result" |-> V)
+           ("word" |-> W)
+           ("n" |-> N)
+           M,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k>
+         Call(Name("len"), Name("word"))
+         => isLen(C)
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("word" |-> str(C:IntSeq))
+           M:Map,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k> Name("n") => N ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("result" |-> R:Val)
+           ("word" |-> W:Val)
+           ("n" |-> N:Int)
+           M:Map,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k> Name("word") => W ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("result" |-> R:Val)
+           ("word" |-> W:Val)
+           ("n" |-> N:Int)
+           M:Map,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k> Name("result") => R ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("result" |-> R:Val)
+           ("word" |-> W:Val)
+           ("n" |-> N:Int)
+           M:Map,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+endmodule

diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ef69e934aaa7b3f22d4b16dbb05a149a537939b5
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py smoke.py > smoke.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun smoke.mpy --definition runtime-kompiled
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+# Establish the inductive loop lemma without trusting any claim.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.loop-invariant \
+  --output pretty
+
+# Prove the end-to-end claim using the now-established loop lemma.
+# The trusted lemma must remain in --claims so kprove includes it as an axiom.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.loop-invariant,SPEC.words-in-sentence-correct \
+  --trusted SPEC.loop-invariant \
+  --output pretty
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..7aa29c428e6ff4002123662f60855417e862143c
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,46 @@
+def words_in_sentence(sentence):
+    words = sentence.split()
+    result = ""
+    word = ""
+    n = 0
+    _plain = 0
+    for word in words:
+        n = len(word)
+        if (
+            n == 2
+            or n == 3
+            or n == 5
+            or n == 7
+            or n == 11
+            or n == 13
+            or n == 17
+            or n == 19
+            or n == 23
+            or n == 29
+            or n == 31
+            or n == 37
+            or n == 41
+            or n == 43
+            or n == 47
+            or n == 53
+            or n == 59
+            or n == 61
+            or n == 67
+            or n == 71
+            or n == 73
+            or n == 79
+            or n == 83
+            or n == 89
+            or n == 97
+        ):
+            if result == "":
+                result = word
+            else:
+                result = result + " " + word
+    return result
+
+
+assert words_in_sentence("This is a test") == "is"
+assert words_in_sentence("lets go for swimming") == "go for"
+assert words_in_sentence("a bb ccc dddd eeeee ffffff ggggggg") == "bb ccc eeeee ggggggg"
+assert words_in_sentence("single") == ""
