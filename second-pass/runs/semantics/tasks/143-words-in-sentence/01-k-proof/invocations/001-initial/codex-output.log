+           ("result" |-> R:Val)
+           ("word" |-> W:Val)
+           ("n" |-> N:Int)
+           M:Map,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k> Name("result") => R ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("result" |-> R:Val)
+           ("word" |-> W:Val)
+           ("n" |-> N:Int)
+           M:Map,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+endmodule

