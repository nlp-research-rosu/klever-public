+           M:Map
+           =>
+           ("_plain" |-> 0)
+           ("result" |-> R)
+           ("word" |-> V)
+           ("n" |-> N)
+           M,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k> Assign(Name("n"), V:Int) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("result" |-> R:Val)
+           ("word" |-> W:Val)
+           ("n" |-> _:Int)
+           M:Map
+           =>
+           ("_plain" |-> 0)
+           ("result" |-> R)
+           ("word" |-> W)
+           ("n" |-> V)
+           M,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k> Assign(Name("result"), V:Val) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("result" |-> _:Val)
+           ("word" |-> W:Val)
+           ("n" |-> N:Int)
+           M:Map
+           =>
+           ("_plain" |-> 0)
+           ("result" |-> V)
+           ("word" |-> W)
+           ("n" |-> N)
+           M,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k>
+         Call(Name("len"), Name("word"))
+         => isLen(C)
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("word" |-> str(C:IntSeq))
+           M:Map,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k> Name("n") => N ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("result" |-> R:Val)
+           ("word" |-> W:Val)
+           ("n" |-> N:Int)
+           M:Map,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k> Name("word") => W ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("result" |-> R:Val)
+           ("word" |-> W:Val)
+           ("n" |-> N:Int)
+           M:Map,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+
+  rule <k> Name("result") => R ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ("_plain" |-> 0)
+           ("result" |-> R:Val)
+           ("word" |-> W:Val)
+           ("n" |-> N:Int)
+           M:Map,
+           P:Parent)
+         ...
+       </scopes>
+    [priority(30)]
+endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..7aa29c428e6ff4002123662f60855417e862143c
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,46 @@
+def words_in_sentence(sentence):
+    words = sentence.split()
+    result = ""
+    word = ""
+    n = 0
+    _plain = 0
+    for word in words:
+        n = len(word)
+        if (
+            n == 2
+            or n == 3
+            or n == 5
+            or n == 7
+            or n == 11
+            or n == 13
+            or n == 17
+            or n == 19
+            or n == 23
+            or n == 29
+            or n == 31
+            or n == 37
+            or n == 41
+            or n == 43
+            or n == 47
+            or n == 53
+            or n == 59
+            or n == 61
+            or n == 67
+            or n == 71
+            or n == 73
+            or n == 79
+            or n == 83
+            or n == 89
+            or n == 97
+        ):
+            if result == "":
+                result = word
+            else:
+                result = result + " " + word
+    return result
+
+
+assert words_in_sentence("This is a test") == "is"
+assert words_in_sentence("lets go for swimming") == "go for"
+assert words_in_sentence("a bb ccc dddd eeeee ffffff ggggggg") == "bb ccc eeeee ggggggg"
+assert words_in_sentence("single") == ""
