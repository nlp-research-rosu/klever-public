+             iCons(98, iCons(98, iCons(98, .IntSeq))))))
+
+  claim [witness-valid]:
+    validWords(witnessWords) => true
+
+  claim [witness-length]:
+    sentenceLen(witnessWords) => 11
+
+  claim [witness-result]:
+    filterWords(.IntSeq, witnessWords) => witnessOutput
+endmodule
