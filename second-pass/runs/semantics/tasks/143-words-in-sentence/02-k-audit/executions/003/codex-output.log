     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // A symbolic sequence of words.  Keeping this separate from ValSeq lets the
     7	  // prover perform structural induction while each element is known to be a
     8	  // string.
     9	  syntax WordSeq ::= ".WordSeq"
    10	                   | wCons(IntSeq, WordSeq)
    11	
    12	  // Opaque projection observed by the iterator rules below.  Using a
    13	  // constructor (rather than an eager function) gives the symbolic executor
    14	  // a clean two-case structural split on WordSeq.
    15	  syntax ValSeq ::= wordsVals(WordSeq)
    16	
    17	  rule <k> #iterNext(list(wordsVals(.WordSeq)))
    18	        => #iterDone ... </k>
    19	    [priority(30)]
    20	  rule <k> #iterNext(list(wordsVals(wCons(C:IntSeq, R:WordSeq))))
    21	        => #iterYield(str(C), list(wordsVals(R))) ... </k>
    22	    [priority(30)]
    23	
    24	  // Sentence represented by nonempty words separated by one ASCII space.
    25	  // Opaque symbolic projection of WordSeq to its concrete space-separated
    26	  // character sequence.  split's extensional rule below is its observer.
    27	  syntax IntSeq ::= sentenceCodes(WordSeq)
    28	
    29	  syntax Int ::= sentenceLen(WordSeq) [function, total]
    30	  rule sentenceLen(.WordSeq) => 0
    31	  rule sentenceLen(wCons(C:IntSeq, .WordSeq)) => isLen(C)
    32	  rule sentenceLen(wCons(C:IntSeq, wCons(D:IntSeq, R:WordSeq)))
    33	    => isLen(C) +Int 1 +Int sentenceLen(wCons(D, R))
    34	
    35	  syntax Bool ::= validWords(WordSeq) [function, total]
    36	  rule validWords(.WordSeq) => true
    37	  rule validWords(wCons(C:IntSeq, R:WordSeq))
    38	    => (isLen(C) >Int 0)
    39	       andBool allAlpha(C)
    40	       andBool validWords(R)
    41	
    42	  // Complete prime characteristic function on the task's length domain 1..100.
    43	  syntax Bool ::= primeLength(Int) [function, total]
    44	  rule primeLength(N:Int)
    45	    => N ==Int 2  orBool N ==Int 3  orBool N ==Int 5
    46	       orBool N ==Int 7  orBool N ==Int 11 orBool N ==Int 13
    47	       orBool N ==Int 17 orBool N ==Int 19 orBool N ==Int 23
    48	       orBool N ==Int 29 orBool N ==Int 31 orBool N ==Int 37
    49	       orBool N ==Int 41 orBool N ==Int 43 orBool N ==Int 47
    50	       orBool N ==Int 53 orBool N ==Int 59 orBool N ==Int 61
    51	       orBool N ==Int 67 orBool N ==Int 71 orBool N ==Int 73
    52	       orBool N ==Int 79 orBool N ==Int 83 orBool N ==Int 89
    53	       orBool N ==Int 97
    54	
    55	  // Mathematical specification: filter the words, inserting a separator only
    56	  // between retained words.
    57	  syntax IntSeq ::= selectWord(IntSeq, IntSeq) [function, total]
    58	  rule selectWord(A:IntSeq, C:IntSeq) => C
    59	    requires A ==K .IntSeq
    60	     andBool primeLength(isLen(C))
    61	  rule selectWord(A:IntSeq, C:IntSeq)
    62	    => seqConcat(seqConcat(A, iCons(32, .IntSeq)), C)
    63	    requires notBool (A ==K .IntSeq)
    64	     andBool primeLength(isLen(C))
    65	  rule selectWord(A:IntSeq, C:IntSeq) => A
    66	    requires notBool primeLength(isLen(C))
    67	
    68	  syntax IntSeq ::= filterWords(IntSeq, WordSeq) [function, total]
    69	  rule filterWords(A:IntSeq, .WordSeq) => A
    70	  rule filterWords(A:IntSeq, wCons(C:IntSeq, R:WordSeq))
    71	    => filterWords(selectWord(A, C), R)
    72	
    73	  // This is the exact expression emitted in solution.mpy.
    74	  syntax Expr ::= primeTest(Expr) [macro]
    75	  rule primeTest(E:Expr)
    76	    => BoolOp(
    77	         "or",
    78	         Compare(E, CmpOp("==", Int(2))),
    79	         Compare(E, CmpOp("==", Int(3))),
    80	         Compare(E, CmpOp("==", Int(5))),
    81	         Compare(E, CmpOp("==", Int(7))),
    82	         Compare(E, CmpOp("==", Int(11))),
    83	         Compare(E, CmpOp("==", Int(13))),
    84	         Compare(E, CmpOp("==", Int(17))),
    85	         Compare(E, CmpOp("==", Int(19))),
    86	         Compare(E, CmpOp("==", Int(23))),
    87	         Compare(E, CmpOp("==", Int(29))),
    88	         Compare(E, CmpOp("==", Int(31))),
    89	         Compare(E, CmpOp("==", Int(37))),
    90	         Compare(E, CmpOp("==", Int(41))),
    91	         Compare(E, CmpOp("==", Int(43))),
    92	         Compare(E, CmpOp("==", Int(47))),
    93	         Compare(E, CmpOp("==", Int(53))),
    94	         Compare(E, CmpOp("==", Int(59))),
    95	         Compare(E, CmpOp("==", Int(61))),
    96	         Compare(E, CmpOp("==", Int(67))),
    97	         Compare(E, CmpOp("==", Int(71))),
    98	         Compare(E, CmpOp("==", Int(73))),
    99	         Compare(E, CmpOp("==", Int(79))),
   100	         Compare(E, CmpOp("==", Int(83))),
   101	         Compare(E, CmpOp("==", Int(89))),
   102	         Compare(E, CmpOp("==", Int(97))))
