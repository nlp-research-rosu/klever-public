    69	      (-1 |-> builtinsScope)
    70	    </scopes>
    71	    <scopeLoc> 1 </scopeLoc>
    72	    <heap>
    73	      .Map
    74	      =>
    75	      0 |-> list(wordsVals(W))
    76	    </heap>
    77	    <heapLoc> 0 => 1 </heapLoc>
