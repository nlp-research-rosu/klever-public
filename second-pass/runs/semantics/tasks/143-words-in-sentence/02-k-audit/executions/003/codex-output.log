+# exact input sequence.
+cases = list(dict.fromkeys(cases))
+serialized = json.dumps(cases, ensure_ascii=True, separators=(",", ":"))
+mismatches = []
+for sentence in cases:
+    expected = canonical(sentence)
+    actual = generated(sentence)
