     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	python3 py2mpy.py solution.py > solution.mpy
     5	python3 py2mpy.py smoke.py > smoke.mpy
     6	
     7	kompile reference-semantics/semantics.k \
     8	  --backend llvm \
     9	  --main-module MPY-KRUN \
    10	  --syntax-module MPY-SYNTAX \
    11	  --output-definition runtime-kompiled
    12	krun smoke.mpy --definition runtime-kompiled
    13	
    14	kompile verification.k \
    15	  --backend haskell \
    16	  --main-module VERIFICATION \
    17	  --syntax-module MPY-SYNTAX \
    18	  --output-definition verification-kompiled
    19	
    20	# Establish the inductive loop lemma without trusting any claim.
    21	kprove spec.k \
    22	  --definition verification-kompiled \
    23	  --spec-module SPEC \
    24	  --claims SPEC.loop-invariant \
    25	  --output pretty
    26	
    27	# Prove the end-to-end claim using the now-established loop lemma.
    28	# The trusted lemma must remain in --claims so kprove includes it as an axiom.
    29	kprove spec.k \
    30	  --definition verification-kompiled \
    31	  --spec-module SPEC \
    32	  --claims SPEC.loop-invariant,SPEC.words-in-sentence-correct \
    33	  --trusted SPEC.loop-invariant \
    34	  --output pretty
