   104	  syntax Stmts ::= "solutionLoopBody" [macro]
   105	  rule solutionLoopBody
   106	    => Assign(Name("n"), Call(Name("len"), Name("word")))
   107	       If(
   108	         primeTest(Name("n")),
   109	         If(
   110	           Compare(Name("result"), CmpOp("==", Str(""))),
   111	           Assign(Name("result"), Name("word")) .Stmts,
   112	           Assign(
   113	             Name("result"),
   114	             BinOp(
   115	               "+",
   116	               BinOp("+", Name("result"), Str(" ")),
   117	               Name("word"))) .Stmts) .Stmts,
   118	         .Stmts) .Stmts
   119	
   120	  syntax Stmts ::= "solutionBody" [macro]
   121	  rule solutionBody
   122	    => Assign(
   123	         Name("words"),
   124	         Call(Attribute(Name("sentence"), "split"), .Exprs))
   125	       Assign(Name("result"), Str(""))
   126	       Assign(Name("word"), Str(""))
   127	       Assign(Name("n"), Int(0))
   128	       Assign(Name("_plain"), Int(0))
   129	       For(Name("word"), Name("words"), solutionLoopBody)
   130	       Return(Name("result"))
   131	       .Stmts
   132	
   133	  syntax Module ::= "solutionProgram" [macro]
   134	  rule solutionProgram
   135	    => Module(
   136	         FuncDef(
   137	           "words_in_sentence",
   138	           Params("sentence"),
   139	           solutionBody)
   140	         .Stmts)
   141	
   142	  // The reference split implementation is concrete.  This extensional rule
   143	  // exposes its result for a symbolic, contract-valid sentence representation.
