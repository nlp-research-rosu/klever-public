+      (-1 |-> builtinsScope)
+      =>
+      (0  |-> scope(
+               "words_in_sentence"
+                 |-> closureVal(
+                       ("sentence", .ParamNames),
+                       solutionBody,
+                       0),
+               parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(wordsVals(W))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires validWords(W)
+     andBool sentenceLen(W) >=Int 1
+     andBool sentenceLen(W) <=Int 100
+endmodule
