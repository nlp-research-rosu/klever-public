+    <env> 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0  |-> scope(
+               "words_in_sentence"
+                 |-> closureVal(
+                       ("sentence", .ParamNames),
+                       solutionBody,
+                       0),
+               parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
