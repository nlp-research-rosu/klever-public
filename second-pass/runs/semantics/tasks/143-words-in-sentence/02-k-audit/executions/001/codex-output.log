+def words_in_sentence(sentence):
+    words = sentence.split()
+    result = ""
+    word = ""
+    n = 0
+    _plain = 0
+    len = 4
+    for word in words:
+        n = len(word)
+        if n == 2:
+            if result == "":
+                result = word
+            else:
+                result = result + " " + word
+    return result
+
+
