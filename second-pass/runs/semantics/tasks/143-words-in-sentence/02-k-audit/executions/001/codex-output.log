    19	    [priority(30)]
    20	  rule <k> #iterNext(list(wordsVals(wCons(C:IntSeq, R:WordSeq))))
    21	        => #iterYield(str(C), list(wordsVals(R))) ... </k>
    22	    [priority(30)]
