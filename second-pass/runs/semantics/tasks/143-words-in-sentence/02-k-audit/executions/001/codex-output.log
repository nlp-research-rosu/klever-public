+               "words_in_sentence"
+                 |-> closureVal(
+                       ("sentence", .ParamNames),
+                       solutionBody,
+                       0),
+               parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
