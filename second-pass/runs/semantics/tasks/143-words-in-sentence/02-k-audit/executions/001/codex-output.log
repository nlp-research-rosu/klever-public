@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module GROUND-WITNESS
+  imports VERIFICATION
+
+  claim [valid-example]:
+    <k>
+      validWords(
+        wCons(
+          iCons(84, iCons(104, iCons(105, iCons(115, .IntSeq)))),
