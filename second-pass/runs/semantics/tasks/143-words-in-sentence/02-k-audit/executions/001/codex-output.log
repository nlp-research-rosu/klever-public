+requires "verification.k"
+
+module GROUND-WITNESS
+  imports VERIFICATION
+
+  syntax WordSeq ::= "documentedExampleWords" [macro]
+  rule documentedExampleWords
+    => wCons(
+         iCons(84, iCons(104, iCons(105, iCons(115, .IntSeq)))),
+         wCons(
+           iCons(105, iCons(115, .IntSeq)),
+           wCons(
+             iCons(97, .IntSeq),
+             wCons(
+               iCons(116, iCons(101, iCons(115, iCons(116, .IntSeq)))),
+               .WordSeq))))
+
+  claim [valid-example]:
+    validWords(documentedExampleWords) => true
+
+  claim [length-example]:
+    sentenceLen(documentedExampleWords) => 14
+
+  claim [result-example]:
+    filterWords(.IntSeq, documentedExampleWords)
+      => iCons(105, iCons(115, .IntSeq))
+endmodule
