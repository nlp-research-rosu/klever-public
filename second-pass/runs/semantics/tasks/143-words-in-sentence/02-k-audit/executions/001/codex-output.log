+        ("word"   |-> ?FINALWORD:Val)
+        ("n"      |-> ?FINALN:Int)
+        ("_plain" |-> 0)
+        REST,
+        P)
+      ...
+    </scopes>
+    requires notBool (
+      "$cells" in_keys(
