WORKDIR: /tmp/audit-work
COMMAND: python3 trusted/py2mpy.py /audit-output/evidence/len-shadow-witness.py
EXIT_STATUS: 0
OUTPUT_BYTES: 859
--- OUTPUT ---
Module(
  FuncDef("words_in_sentence", Params("sentence"),
    Assign(Name("words"), Call(Attribute(Name("sentence"), "split"), ))
    Assign(Name("result"), Str(""))
    Assign(Name("word"), Str(""))
    Assign(Name("n"), Int(0))
    Assign(Name("_plain"), Int(0))
    Assign(Name("len"), Int(4))
    For(Name("word"), Name("words"),
      Assign(Name("n"), Call(Name("len"), Name("word")))
      If(Compare(Name("n"), CmpOp("==", Int(2))),
        If(Compare(Name("result"), CmpOp("==", Str(""))),
          Assign(Name("result"), Name("word")),
          Assign(
            Name("result"),
            BinOp(
              "+",
              BinOp("+", Name("result"), Str(" ")),
              Name("word")))),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("words_in_sentence"), Str("aa")),
      CmpOp("==", Str("aa")))))
