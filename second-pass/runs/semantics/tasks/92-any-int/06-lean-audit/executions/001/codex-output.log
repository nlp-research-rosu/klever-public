diff --git a//tmp/audit-work/lean-proc-readlink-shim.c b//tmp/audit-work/lean-proc-readlink-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..6985e594987b98570d2f58a34f9fe27bee10b4b6
--- /dev/null
+++ b//tmp/audit-work/lean-proc-readlink-shim.c
@@ -0,0 +1,31 @@
+#define _GNU_SOURCE
+
+#include <stdio.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+/*
+ * This audit sandbox permits /proc/self/exe but hides /proc/<pid>/exe.
+ * Lean 4.22 asks for the latter using its own PID. Redirect only that exact
+ * lookup to the semantically identical self alias; pass every other readlink
+ * call through unchanged.
+ */
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    char own_pid_path[64];
+    int length = snprintf(
+        own_pid_path,
+        sizeof(own_pid_path),
+        "/proc/%ld/exe",
+        (long)getpid()
+    );
+    const char *effective_path = path;
+    if (
+        length > 0
+        && (size_t)length < sizeof(own_pid_path)
+        && strcmp(path, own_pid_path) == 0
+    ) {
+        effective_path = "/proc/self/exe";
+    }
+    return syscall(SYS_readlink, effective_path, buffer, size);
+}

