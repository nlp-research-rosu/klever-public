import hashlib,json,os,stat
from pathlib import Path

def h(p): return hashlib.sha256(p.read_bytes()).hexdigest()
def m(root):
 r=[]
 for base,ds,fs in os.walk(root):
  for n in sorted(ds+fs):
   p=Path(base)/n; rel=p.relative_to(root).as_posix(); st=p.lstat()
   if stat.S_ISDIR(st.st_mode): r.append((rel,'d',''))
   elif stat.S_ISREG(st.st_mode): r.append((rel,'f',h(p)))
   elif stat.S_ISLNK(st.st_mode): r.append((rel,'l',os.readlink(p)))
