Module(
  FuncDef("any_int", Params("x", "y", "z"),
    Return(
      BoolOp(
        "and",
        Call(Name("isinstance"), Name("x"), Name("int")),
        Call(Name("isinstance"), Name("y"), Name("int")),
        Call(Name("isinstance"), Name("z"), Name("int")),
        BoolOp(
          "or",
          Compare(
            BinOp("+", Name("x"), Name("y")),
            CmpOp("==", Name("z"))),
          Compare(
            BinOp("+", Name("x"), Name("z")),
            CmpOp("==", Name("y"))),
          Compare(
            BinOp("+", Name("y"), Name("z")),
            CmpOp("==", Name("x")))))))
  Assert(
    UnaryOp("not", Call(Name("any_int"), Bool(true), Int(1), Int(2)))))
