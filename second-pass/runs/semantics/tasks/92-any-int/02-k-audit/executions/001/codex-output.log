diff --git a//tmp/audit-work/reconstruction/spec-bool-model-false.k b//tmp/audit-work/reconstruction/spec-bool-model-false.k
new file mode 100644
index 0000000000000000000000000000000000000000..6b0198205b07757bcdffd6a3da1204c9de5d268d
--- /dev/null
+++ b//tmp/audit-work/reconstruction/spec-bool-model-false.k
@@ -0,0 +1,20 @@
+requires "verification.k"
+
+module SPEC-BOOL-MODEL-FALSE
+  imports ANY-INT-VERIFICATION
+
+  claim
+    <k> #anyInt(true, 1, 2) => false </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
