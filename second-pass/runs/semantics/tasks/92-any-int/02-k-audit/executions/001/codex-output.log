diff --git a//tmp/audit-work/reconstruction/spec-bool-real-result.k b//tmp/audit-work/reconstruction/spec-bool-real-result.k
new file mode 100644
index 0000000000000000000000000000000000000000..1ebfa13eefd936d3a14a48ea363dc5fe824f2ad9
--- /dev/null
+++ b//tmp/audit-work/reconstruction/spec-bool-real-result.k
@@ -0,0 +1,20 @@
+requires "verification.k"
+
+module SPEC-BOOL-REAL-RESULT
+  imports ANY-INT-VERIFICATION
+
+  claim
+    <k> #anyInt(true, 1, 2) => true </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
