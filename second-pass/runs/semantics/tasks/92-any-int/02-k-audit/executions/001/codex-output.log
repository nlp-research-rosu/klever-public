diff --git a//tmp/audit-work/reconstruction/spec-claim-x-nonint.k b//tmp/audit-work/reconstruction/spec-claim-x-nonint.k
new file mode 100644
index 0000000000000000000000000000000000000000..e7258a6de8ab90f1b443fe8f3ee7f7db556497eb
--- /dev/null
+++ b//tmp/audit-work/reconstruction/spec-claim-x-nonint.k
@@ -0,0 +1,21 @@
+requires "verification.k"
+
+module SPEC-CLAIM-X-NONINT
+  imports ANY-INT-VERIFICATION
+
+  claim
+    <k> #anyInt(X:Val, Y:Val, Z:Val) => false </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool isIntV(X)
+endmodule
