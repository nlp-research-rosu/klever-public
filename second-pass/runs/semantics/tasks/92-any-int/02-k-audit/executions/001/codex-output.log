@@ -0,0 +1,21 @@
+requires "verification.k"
+
+module SPEC-CLAIM-Y-NONINT
+  imports ANY-INT-VERIFICATION
+
+  claim
+    <k> #anyInt(X:Int, Y:Val, Z:Val) => false </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
