Module(
  FuncDef("any_int", Params("x", "y", "z"),
    Return(
      BoolOp(
        "and",
        Call(Name("isinstance"), Name("x"), Name("int")),
        Call(Name("isinstance"), Name("y"), Name("int")),
        Call(Name("isinstance"), Name("z"), Name("int")),
        BoolOp(
          "or",
          Compare(
            BinOp("+", Name("x"), Name("y")),
            CmpOp("==", Name("z"))),
          Compare(
            BinOp("+", Name("x"), Name("z")),
            CmpOp("==", Name("y"))),
          Compare(
            BinOp("+", Name("y"), Name("z")),
            CmpOp("==", Name("x")))))))
  Assert(Call(Name("any_int"), Int(5), Int(2), Int(7)))
  Assert(UnaryOp("not", Call(Name("any_int"), Int(3), Int(2), Int(2))))
  Assert(Call(Name("any_int"), Int(3), UnaryOp("-", Int(2)), Int(1)))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("any_int"),
        Float(3.6),
        UnaryOp("-", Float(2.2)),
        Int(2))))
  Assert(Call(Name("any_int"), Int(7), Int(5), Int(2)))
  Assert(
    Call(
      Name("any_int"),
      UnaryOp("-", Int(5)),
      Int(2),
      UnaryOp("-", Int(3))))
  Assert(UnaryOp("not", Call(Name("any_int"), Int(0), Int(0), Int(1)))))
