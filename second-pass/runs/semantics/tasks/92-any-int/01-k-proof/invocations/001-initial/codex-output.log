diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b809f1d65999067cc3ca1126eef4e5e450ea71ea
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,39 @@
+requires "reference-semantics/semantics.k"
+
+module ANY-INT-VERIFICATION
+  imports MPY
+
+  syntax Stmts ::= "anyIntBody" [function, total]
+  rule anyIntBody
+    => Return(
+         BoolOp(
+           "and",
+           Call(Name("isinstance"), Name("x"), Name("int")),
+           Call(Name("isinstance"), Name("y"), Name("int")),
+           Call(Name("isinstance"), Name("z"), Name("int")),
+           BoolOp(
+             "or",
+             Compare(
+               BinOp("+", Name("x"), Name("y")),
+               CmpOp("==", Name("z"))),
+             Compare(
+               BinOp("+", Name("x"), Name("z")),
+               CmpOp("==", Name("y"))),
+             Compare(
+               BinOp("+", Name("y"), Name("z")),
+               CmpOp("==", Name("x"))))))
+       .Stmts
+
+  syntax KItem ::= "#anyInt" "(" Val "," Val "," Val ")"
+  rule <k> #anyInt(X:Val, Y:Val, Z:Val)
+        => #applyK(
+             toCall(closureVal(("x", "y", "z"), anyIntBody, 0)),
+             (X, Y, Z, .Vals))
+         ... </k>
+
+  syntax Bool ::= sumCondition(Int, Int, Int) [function, total]
+  rule sumCondition(X:Int, Y:Int, Z:Int)
+    => ((X +Int Y) ==Int Z)
+       orBool ((X +Int Z) ==Int Y)
+       orBool ((Y +Int Z) ==Int X)
+endmodule

apply patch
patch: completed
/work/concrete_tests.py
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..61649c97c61e379ec0a5457749b06b7c01ba4139
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,16 @@
+def any_int(x, y, z):
+    return (
+        isinstance(x, int)
+        and isinstance(y, int)
+        and isinstance(z, int)
+        and (x + y == z or x + z == y or y + z == x)
+    )
+
+
+assert any_int(5, 2, 7)
+assert not any_int(3, 2, 2)
+assert any_int(3, -2, 1)
+assert not any_int(3.6, -2.2, 2)
+assert any_int(7, 5, 2)
+assert any_int(-5, 2, -3)
+assert not any_int(0, 0, 1)
