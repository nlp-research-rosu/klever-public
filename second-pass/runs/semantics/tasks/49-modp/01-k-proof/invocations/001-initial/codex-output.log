diff --git a/concrete-tests.mpy b/concrete-tests.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..c68a150cf9d0283a6781160b642063fca8e7f647
--- /dev/null
+++ b/concrete-tests.mpy
@@ -0,0 +1,18 @@
+Module(
+  FuncDef("modp", Params("n", "p"),
+    Expr(Str("Return 2^n modulo p."))
+    Return(BinOp("%", BinOp("**", Int(2), Name("n")), Name("p"))))
+  Assert(
+    Compare(Call(Name("modp"), Int(3), Int(5)), CmpOp("==", Int(3))))
+  Assert(
+    Compare(
+      Call(Name("modp"), Int(1101), Int(101)),
+      CmpOp("==", Int(2))))
+  Assert(
+    Compare(Call(Name("modp"), Int(0), Int(101)), CmpOp("==", Int(1))))
+  Assert(
+    Compare(Call(Name("modp"), Int(3), Int(11)), CmpOp("==", Int(8))))
+  Assert(
+    Compare(
+      Call(Name("modp"), Int(100), Int(101)),
+      CmpOp("==", Int(1)))))
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..d709c7b82fe2f42dbba40c3a416a065bfbcd2ef8
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Translate the submitted Python implementation.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Build the supplied concrete semantics exactly as required, then run all
+# examples from prompt.py as assertions.
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled \
+  -w none
+krun concrete-tests.mpy --definition runtime-kompiled
+
+# Build the symbolic extension (which imports MPY, not MPY-KRUN) and prove
+# every reachability claim in spec.k.
+kompile verification.k \
+  --backend haskell \
+  --main-module MODP-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled \
+  -w none
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module MODP-SPEC \
+  -w none
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..e3b7a228f8a07013b321219fa71dfd4615120600
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,3 @@
+def modp(n: int, p: int):
+    """Return 2^n modulo p."""
+    return (2 ** n) % p
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f998631df4aa35bd72f852dcbcce48ee1f169309
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module MODP-SPEC
+  imports MODP-VERIFICATION
+
+  claim
+    <k>
+      ( #loadAll(modpProgram)
+        ~> Call(Name("modp"), (Int(N), Int(P), .Exprs)) )
+      => (specModp(N, P) ~> .K)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0  |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
+      ( 0  |-> scope(
+                  "modp" |-> closureVal(
+                    ("n", "p", .ParamNames), modpBody, 0),
+                  parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0 andBool P >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..55366f285fac44bfcb6ffcd0d5bacf223fffb11b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,25 @@
+requires "reference-semantics/semantics.k"
+
+module MODP-VERIFICATION
+  imports MPY
+
+  // This is the exact Module term generated in solution.mpy.  Giving it a
+  // name keeps the reachability claim readable while still executing the
+  // translated program through the supplied Python semantics.
+  syntax Stmts ::= "modpBody" [function]
+  rule modpBody
+    => Expr(Str("Return 2^n modulo p."))
+       Return(BinOp("%", BinOp("**", Int(2), Name("n")), Name("p")))
+
+  syntax Module ::= "modpProgram" [function]
+  rule modpProgram
+    => Module(
+         FuncDef("modp", Params("n", "p"), modpBody))
+
+  // Mathematical contract for the supported input domain.  pyMod is the
+  // supplied semantics' Python (floored) remainder, and ^Int is unbounded
