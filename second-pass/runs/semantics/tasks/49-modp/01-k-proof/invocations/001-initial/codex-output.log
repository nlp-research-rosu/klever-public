+requires "verification.k"
+
+module MODP-SPEC
+  imports MODP-VERIFICATION
+
+  claim
+    <k>
+      ( #loadAll(modpProgram)
+        ~> Call(Name("modp"), (Int(N), Int(P), .Exprs)) )
+      => (((2 ^Int N) %Int P +Int P) %Int P ~> .K)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0 andBool P >Int 0
+endmodule
