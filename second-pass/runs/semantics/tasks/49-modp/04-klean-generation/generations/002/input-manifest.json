      "module": "MODP-VERIFICATION",
      "normalized_sha256": "71d349ffafcb30fd76f8fe497ddc3bd83e9c8f32d2e73927d650e4dc1e713860",
      "rationale": "This rule expands the named modpBody term into the exact translated statement sequence; it is a structural abbreviation and asserts no additional mathematical fact.",
      "source_rule_id": "rule-71d349ffafcb30fd76f8fe497ddc3bd83e9c8f32d2e73927d650e4dc1e713860",
      "start_line": 10,
      "text": "  rule modpBody\n    => Expr(Str(\"Return 2^n modulo p.\"))\n       Return(BinOp(\"%\", BinOp(\"**\", Int(2), Name(\"n\")), Name(\"p\")))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 17,
      "module": "MODP-VERIFICATION",
      "normalized_sha256": "642fa0e1d269068ee1ff23a4190cc20e8dd97d36c91e0e7fdd0f6fc2160ca730",
      "rationale": "This rule expands modpProgram into the Module and FuncDef syntax containing modpBody; it is a structural program-term definition.",
      "source_rule_id": "rule-642fa0e1d269068ee1ff23a4190cc20e8dd97d36c91e0e7fdd0f6fc2160ca730",
      "start_line": 15,
      "text": "  rule modpProgram\n    => Module(\n         FuncDef(\"modp\", Params(\"n\", \"p\"), modpBody))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 24,
      "module": "MODP-VERIFICATION",
      "normalized_sha256": "979f0d2fa1ec906f8e5bf589b74d8f25cd25fe0ce31c6c16227b18246e343ea5",
      "rationale": "This conditional equation defines the named contract summary specModp as the supplied Python-style remainder of unbounded integer exponentiation on the admitted input domain; it introduces a proof-term definition rather than an independent arithmetic lemma.",
      "source_rule_id": "rule-979f0d2fa1ec906f8e5bf589b74d8f25cd25fe0ce31c6c16227b18246e343ea5",
      "start_line": 23,
      "text": "  rule specModp(N:Int, P:Int) => pyMod(2 ^Int N, P)\n       requires N >=Int 0 andBool P >Int 0"
    }
  ],
