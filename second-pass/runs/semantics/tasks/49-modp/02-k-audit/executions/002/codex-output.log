/bin/bash -lc '/audit-output/evidence/run_logged.sh /audit-output/evidence/04-body-mutant-ground-kprove.log kprove spec-body-mutant-ground.k --definition body-mutant-kompiled --spec-module MODP-SPEC-BODY-MUTANT-GROUND -w none
status=$?
