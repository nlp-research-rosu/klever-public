+#!/usr/bin/env python3
+"""Ground instances of the formal postcondition versus both Python programs."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+
+WORK = Path("/tmp/audit-work/49-modp")
+
+
+def load(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def main() -> None:
+    canonical = load("witness_canonical", WORK / "canonical.py")
+    candidate = load("witness_candidate", WORK / "solution.py")
+    witnesses = [(0, 1), (0, 101), (1, 1), (3, 5), (1101, 101)]
+    print("FORMAL_PRECONDITION n >= 0 and p > 0")
+    for n, p in witnesses:
+        # Under p > 0, K's pyMod(2 ^Int n, p) is Python's pow(2,n,p).
+        formal = pow(2, n, p)
+        print(
+            f"WITNESS n={n} p={p} satisfies=True "
+            f"formal={formal} generated={candidate.modp(n, p)!r} "
+            f"canonical={canonical.modp(n, p)!r}"
+        )
+
+
+if __name__ == "__main__":
+    main()

exec
/bin/bash -lc '/audit-output/evidence/run_logged.sh /audit-output/evidence/04-pinning-token-compare.log python3 /audit-output/evidence/pinning_compare.py
pin_token_status=$?
/audit-output/evidence/run_logged.sh /audit-output/evidence/04-ground-witnesses.log python3 /audit-output/evidence/witness_compare.py
witness_status=$?
/audit-output/evidence/run_logged.sh /audit-output/evidence/04-concrete-witness-translate.log bash -lc '"'python3 py2mpy.py concrete-witnesses.py > concrete-witnesses.mpy'
translate_status="'$?
/audit-output/evidence/run_logged.sh /audit-output/evidence/04-concrete-witness-krun.log krun concrete-witnesses.mpy --definition runtime-kompiled
krun_status=$?
/audit-output/evidence/run_logged.sh /audit-output/evidence/04-pinning-kprove.log kprove pinning.k --definition verification-kompiled --spec-module MODP-PINNING -w none
pin_kprove_status=$?
printf '"'pin_token=%s witness=%s translate=%s krun=%s pin_kprove=%s\\n' \""'$pin_token_status" "$witness_status" "$translate_status" "$krun_status" "$pin_kprove_status"
cat /audit-output/evidence/04-pinning-token-compare.log
cat /audit-output/evidence/04-ground-witnesses.log
tail -n 20 /audit-output/evidence/04-pinning-kprove.log' in /tmp/audit-work/49-modp
