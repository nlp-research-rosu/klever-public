Module(
  FuncDef("modp", Params("n", "p"),
    Return(BinOp("%", BinOp("**", Int(2), Name("n")), Name("p"))))
  Assert(
    Compare(Call(Name("modp"), Int(0), Int(1)), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("modp"), Int(1), Int(1)), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("modp"), Int(0), Int(2)), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("modp"), Int(1), Int(2)), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("modp"), Int(2), Int(3)), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("modp"), Int(32), Int(7)), CmpOp("==", Int(4)))))
