+
+canonical = load(
+    Path("/tmp/audit-work/49-modp/trusted/canonical.py"), "witness_canonical"
+)
+solution = load(Path("/tmp/audit-work/49-modp/solution.py"), "witness_solution")
+
+witnesses = [(3, 5), (0, 1)]
+for n, p in witnesses:
+    assert n >= 0 and p > 0
+    record = {
+        "input": {"N": n, "P": p},
+        "precondition": n >= 0 and p > 0,
