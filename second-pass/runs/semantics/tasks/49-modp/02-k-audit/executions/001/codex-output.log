+  claim
+    <k>
+      ( #loadAll(modpProgram)
+        ~> Call(Name("modp"), (Int(3), Int(5), .Exprs)) )
+      => ((specModp(3, 5) +Int 1) ~> .K)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0  |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
