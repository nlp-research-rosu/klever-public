+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$log_path"
+
+set +e
+"$@" > >(tee -a "$log_path") 2> >(tee -a "$log_path" >&2)
+command_status=$?
+set -e
+
+printf 'EXIT_STATUS: %d\n' "$command_status" | tee -a "$log_path"
+exit "$command_status"

