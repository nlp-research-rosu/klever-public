diff --git a//tmp/audit-work/49-modp/concrete-boundaries.py b//tmp/audit-work/49-modp/concrete-boundaries.py
new file mode 100644
index 0000000000000000000000000000000000000000..41244e2a46923ac7f136a4cd6dc483aac9ac5d31
--- /dev/null
+++ b//tmp/audit-work/49-modp/concrete-boundaries.py
@@ -0,0 +1,10 @@
+def modp(n: int, p: int):
+    return (2 ** n) % p
+
+
+assert modp(0, 1) == 0
+assert modp(1, 1) == 0
+assert modp(0, 2) == 1
+assert modp(1, 2) == 0
+assert modp(2, 3) == 1
+assert modp(32, 7) == 4
