     6	
     7	def modp(n: int, p: int):
     8	    """Return 2^n modulo p (be aware of numerics).
     9	    >>> modp(3, 5)
    10	    3
    11	    >>> modp(1101, 101)
    12	    2
    13	    >>> modp(0, 101)
    14	    1
    15	    >>> modp(3, 11)
    16	    8
    17	    >>> modp(100, 101)
    18	    1
    19	    """
    20	    ret = 1
    21	    for i in range(n):
    22	        ret = (2 * ret) % p
    23	    return ret
