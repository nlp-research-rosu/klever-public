FILE: /candidate/verification.k
     1	requires "reference-semantics/semantics.k"
     2	
     3	module MODP-VERIFICATION
     4	  imports MPY
     5	
     6	  // This is the exact Module term generated in solution.mpy.  Giving it a
     7	  // name keeps the reachability claim readable while still executing the
     8	  // translated program through the supplied Python semantics.
     9	  syntax Stmts ::= "modpBody" [function]
    10	  rule modpBody
    11	    => Expr(Str("Return 2^n modulo p."))
    12	       Return(BinOp("%", BinOp("**", Int(2), Name("n")), Name("p")))
    13	
    14	  syntax Module ::= "modpProgram" [function]
    15	  rule modpProgram
    16	    => Module(
    17	         FuncDef("modp", Params("n", "p"), modpBody))
    18	
    19	  // Mathematical contract for the supported input domain.  pyMod is the
    20	  // supplied semantics' Python (floored) remainder, and ^Int is unbounded
    21	  // integer exponentiation.
    22	  syntax Int ::= specModp(Int, Int) [function]
    23	  rule specModp(N:Int, P:Int) => pyMod(2 ^Int N, P)
    24	       requires N >=Int 0 andBool P >Int 0
    25	endmodule
FILE: /candidate/prove.sh
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Translate the submitted Python implementation.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# Build the supplied concrete semantics exactly as required, then run all
     8	# examples from prompt.py as assertions.
     9	kompile reference-semantics/semantics.k \
    10	  --backend llvm \
    11	  --main-module MPY-KRUN \
    12	  --syntax-module MPY-SYNTAX \
    13	  --output-definition runtime-kompiled \
    14	  -w none
    15	krun concrete-tests.mpy --definition runtime-kompiled
    16	
    17	# Build the symbolic extension (which imports MPY, not MPY-KRUN) and prove
    18	# every reachability claim in spec.k.
    19	kompile verification.k \
    20	  --backend haskell \
    21	  --main-module MODP-VERIFICATION \
    22	  --syntax-module MPY-SYNTAX \
    23	  --output-definition verification-kompiled \
    24	  -w none
    25	kprove spec.k \
    26	  --definition verification-kompiled \
    27	  --spec-module MODP-SPEC \
    28	  -w none
