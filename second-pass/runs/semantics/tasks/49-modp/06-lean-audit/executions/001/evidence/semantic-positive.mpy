Module(
  FuncDef("modp", Params("n", "p"),
    Expr(Str("Return 2^n modulo p."))
    Return(BinOp("%", BinOp("**", Int(2), Name("n")), Name("p"))))
  Assert(Compare(Call(Name("modp"), Int(0), Int(1)), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("modp"), Int(1), Int(1)), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("modp"), Int(4), Int(3)), CmpOp("==", Int(1))))
  Assert(Compare(Call(Name("modp"), Int(5), Int(7)), CmpOp("==", Int(4))))
  Assert(Compare(Call(Name("modp"), Int(10), Int(17)), CmpOp("==", Int(4)))))
