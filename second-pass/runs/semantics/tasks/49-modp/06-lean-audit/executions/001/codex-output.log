@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module MODP-SPEC-VACUITY
+  imports MODP-VERIFICATION
+
+  claim
+    <k>
+      ( #loadAll(modpProgram)
+        ~> Call(Name("modp"), (Int(N), Int(P), .Exprs)) )
+      => ((specModp(N, P) +Int 1) ~> .K)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0  |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
+      ( 0  |-> scope(
+                  "modp" |-> closureVal(
