diff --git a//tmp/audit-work/app_path_probe.c b//tmp/audit-work/app_path_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..a102649e659c29f9ca2dd7c3acdc7c6e3244df9b
--- /dev/null
+++ b//tmp/audit-work/app_path_probe.c
@@ -0,0 +1,17 @@
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[PATH_MAX + 1];
+  ssize_t count = readlink("/proc/self/exe", path, PATH_MAX);
+  if (count < 0) {
+    fprintf(stderr, "readlink failed: errno=%d %s\n", errno, strerror(errno));
+    return 1;
+  }
+  path[count] = '\0';
+  printf("%s\n", path);
+  return 0;
+}
