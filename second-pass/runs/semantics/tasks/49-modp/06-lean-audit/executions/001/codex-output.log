+    | tail -n 1
+)"
+if [ -z "${audit_stage1_tmp}" ] \
+  || [ ! -d "${audit_stage1_tmp}/verification-kompiled" ]; then
+  printf '%s\n' 'ERROR: independent compiled Stage 1 definition is unavailable'
