+requires "verification.k"
+
+module MODP-SPEC-VACUITY
+  imports MODP-VERIFICATION
+
+  claim
+    <k>
+      ( #loadAll(modpProgram)
+        ~> Call(Name("modp"), (Int(N), Int(P), .Exprs)) )
+      => ((specModp(N, P) +Int 1) ~> .K)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0  |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
+      ( 0  |-> scope(
+                  "modp" |-> closureVal(
+                    ("n", "p", .ParamNames), modpBody, 0),
+                  parent(-1))
+        -1 |-> builtinsScope )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0 andBool P >Int 0
+endmodule

exec
/bin/bash -lc 'set -o pipefail
bash /audit-output/evidence/05_vacuity_commands.sh |& tee /audit-output/evidence/05_vacuity.log' in /audit-output
diff --git a//tmp/audit-work/app_path_probe.c b//tmp/audit-work/app_path_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..a102649e659c29f9ca2dd7c3acdc7c6e3244df9b
--- /dev/null
+++ b//tmp/audit-work/app_path_probe.c
@@ -0,0 +1,17 @@
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[PATH_MAX + 1];
+  ssize_t count = readlink("/proc/self/exe", path, PATH_MAX);
+  if (count < 0) {
+    fprintf(stderr, "readlink failed: errno=%d %s\n", errno, strerror(errno));
+    return 1;
+  }
+  path[count] = '\0';
+  printf("%s\n", path);
+  return 0;
+}
diff --git a/evidence/01_integrity_commands.sh b/evidence/01_integrity_commands.sh
