+nl -ba /reference/k-proof/reference-semantics/semantics/syntax.k \
+  | sed -n '9,62p'
+nl -ba /reference/k-proof/reference-semantics/semantics/core.k \
+  | sed -n '123,195p'
+nl -ba /reference/k-proof/reference-semantics/semantics/operators.k \
