+            "manifest_domain_ids": manifest_domain_ids,
+            "source_rule_ids": source_rule_ids,
+            "obligation_ids": obligation_ids,
+            "target_statement": target,
+            "checks": checks,
+        },
+        indent=2,
+        sort_keys=True,
+    )
+)
+if not all(checks.values()):
+    raise SystemExit(1)
+PY
