+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[PATH_MAX + 1];
+  ssize_t count = readlink("/proc/self/exe", path, PATH_MAX);
+  if (count < 0) {
+    fprintf(stderr, "readlink failed: errno=%d %s\n", errno, strerror(errno));
+    return 1;
+  }
+  path[count] = '\0';
+  printf("%s\n", path);
+  return 0;
+}
