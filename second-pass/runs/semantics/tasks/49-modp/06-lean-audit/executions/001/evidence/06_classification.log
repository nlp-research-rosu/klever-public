   855	def expected_target_definition(obligation_map: dict[str, Any]) -> str | None:
   856	    obligations = obligation_map.get("obligations")
   857	    parameters = obligation_map.get("trust_parameters")
   858	    if not isinstance(obligations, list) or not isinstance(parameters, list):
   859	        raise KleanExportError("generated obligation map is malformed")
   860	    if not obligations:
   861	        return None
   862	    lines = ["def targetStatement"]
   863	    for parameter in parameters:
   864	        if not isinstance(parameter, dict):
   865	            raise KleanExportError("target parameter is malformed")
   866	        name = parameter.get("name")
   867	        lean_type = parameter.get("type")
   868	        if not isinstance(name, str) or not isinstance(lean_type, str):
   869	            raise KleanExportError("target parameter is malformed")
   870	        lines.append(f"    ({name} : {lean_type})")
   871	    conjuncts: list[str] = []
   872	    for obligation in obligations:
   873	        if not isinstance(obligation, dict):
   874	            raise KleanExportError("generated obligation is malformed")
   875	        conjunct = obligation.get("lean_conjunct")
   876	        if not isinstance(conjunct, str) or not conjunct:
   877	            raise KleanExportError("generated Lean conjunct is malformed")
   878	        conjuncts.append(f"({conjunct})")
   879	    lines.extend(("    : Prop :=", "    " + "\n    ∧ ".join(conjuncts)))
   880	    return "\n".join(lines)
