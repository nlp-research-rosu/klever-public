   770	def target_statement(generated: Path) -> dict[str, Any] | None:
   771	    obligation_map = _regular_json(generated / "obligation-map.json")
   772	    obligations = obligation_map.get("obligations")
   773	    parameters = obligation_map.get("trust_parameters")
   774	    if not isinstance(obligations, list) or not isinstance(parameters, list):
   775	        raise KleanExportError("generated obligation map is malformed")
   776	    candidates: list[tuple[Path, str]] = []
   777	    raw_count = 0
   778	    for relative, kind, path in _tree_entries(generated):
   779	        if kind != "file" or path.suffix != ".lean":
   780	            continue
   781	        text = path.read_text()
   782	        raw_count += len(
   783	            re.findall(r"(?m)^\s*def\s+targetStatement\b", text)
   784	        )
   785	        for match in re.finditer(
   786	            r"(?ms)^\s*def\s+targetStatement\b.*?"
   787	            r"(?=^\s*end\s+\S+\s*$)",
   788	            text,
   789	        ):
   790	            candidates.append((path, match.group(0).strip()))
   791	    if not obligations:
   792	        if raw_count != 0:
   793	            raise KleanExportError(
   794	                "zero obligations must not generate a target proposition"
   795	            )
   796	        return None
   797	    if raw_count != 1 or len(candidates) != 1:
   798	        raise KleanExportError(
   799	            "generated project must contain exactly one target proposition; "
   800	            f"found {raw_count}"
   801	        )
   802	    path, definition = candidates[0]
   803	    names: list[str] = []
   804	    normalized_parameters: list[dict[str, Any]] = []
   805	    for parameter in parameters:
   806	        if not isinstance(parameter, dict):
   807	            raise KleanExportError("target parameter is malformed")
   808	        name = parameter.get("name")
   809	        lean_type = parameter.get("type")
   810	        kore_symbol = parameter.get("kore_symbol")
   811	        source_rule_ids = parameter.get("source_rule_ids")
   812	        binding_sha256 = parameter.get("binding_sha256")
   813	        if not isinstance(name, str) or not name:
   814	            raise KleanExportError("target parameter name is malformed")
   815	        if not isinstance(lean_type, str) or not lean_type:
   816	            raise KleanExportError("target parameter type is malformed")
   817	        if not isinstance(kore_symbol, str) or not kore_symbol:
   818	            raise KleanExportError("target KORE symbol binding is malformed")
   819	        if (
   820	            not isinstance(source_rule_ids, list)
   821	            or not source_rule_ids
   822	            or not all(
   823	                isinstance(source_rule_id, str) and source_rule_id
   824	                for source_rule_id in source_rule_ids
   825	            )
   826	        ):
   827	            raise KleanExportError("target source-rule binding is malformed")
   828	        binding = {
   829	            "kore_symbol": kore_symbol,
   830	            "name": name,
   831	            "type": lean_type,
   832	            "source_rule_ids": source_rule_ids,
   833	        }
   834	        expected_binding_sha256 = sha256_text(
   835	            json.dumps(binding, sort_keys=True, separators=(",", ":"))
   836	        )
   837	        if binding_sha256 != expected_binding_sha256:
   838	            raise KleanExportError("target parameter binding hash changed")
   839	        names.append(name)
   840	        normalized_parameters.append(
   841	            {**binding, "binding_sha256": binding_sha256}
   842	        )
   843	    declaration = f"{path.parent.name}.Lemmas.targetStatement"
   844	    statement = " ".join((declaration, *names))
   845	    return {
   846	        "declaration": declaration,
   847	        "file": path.relative_to(generated).as_posix(),
   848	        "statement": statement,
   849	        "statement_sha256": sha256_text(statement),
   850	        "definition_sha256": sha256_text(definition),
   851	        "parameters": normalized_parameters,
   852	    }
