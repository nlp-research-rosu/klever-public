diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..658414c613aae8231cac33c3f2f0c942f2d2c07d
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,47 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Empty input follows the contract's distinguished None branch.
+  claim
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("string_to_md5"), Str(""))
+      =>
+      noneV
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map => ("string_to_md5" |-> stringToMd5Closure), parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
+  // Every nonempty symbolic string is encoded unchanged and passed to the
+  // reference semantics' trusted MD5 oracle before hexdigest is returned.
+  claim
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("string_to_md5"), str(CS))
+      =>
+      str(md5hexCodes(CS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map => ("string_to_md5" |-> stringToMd5Closure), parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires notBool (CS ==K .IntSeq)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e44e2f24495c1a751548e9c27ebaa3a7fb1917c2
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,31 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // These macros are the exact constructor translation in solution.mpy,
+  // factored so the specifications can also name the installed closure.
+  syntax Stmts ::= "stringToMd5Body" [macro]
+  rule stringToMd5Body
+    => If(UnaryOp("not", Name("text")),
+         Return(NoneVal),
+         .Stmts)
+       Return(
+         Call(
+           Attribute(
+             Call(
+               Attribute(Name("hashlib"), "md5"),
+               Call(Attribute(Name("text"), "encode"), Str("utf-8"))),
+             "hexdigest"),
+           .Exprs))
+
+  syntax Module ::= "solutionModule" [macro]
+  rule solutionModule
+    => Module(
+         Import("hashlib")
+         FuncDef("string_to_md5", Params("text"), stringToMd5Body))
+
+  syntax Val ::= "stringToMd5Closure" [macro]
+  rule stringToMd5Closure
+    => closureVal("text", stringToMd5Body, 0)
+endmodule

