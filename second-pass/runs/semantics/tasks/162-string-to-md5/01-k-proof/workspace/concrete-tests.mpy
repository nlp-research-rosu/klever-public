Module(
  Import("hashlib")
  FuncDef("string_to_md5", Params("text"),
    If(UnaryOp("not", Name("text")),
      Return(NoneVal),
      )
    Return(
      Call(
        Attribute(
          Call(
            Attribute(Name("hashlib"), "md5"),
            Call(Attribute(Name("text"), "encode"), Str("utf-8"))),
          "hexdigest"),
        )))
  Assign(Name("empty_result"), Call(Name("string_to_md5"), Str("")))
  Assign(
    Name("example_result"),
    Call(Name("string_to_md5"), Str("Hello world")))
  Assign(Name("abc_result"), Call(Name("string_to_md5"), Str("abc"))))
