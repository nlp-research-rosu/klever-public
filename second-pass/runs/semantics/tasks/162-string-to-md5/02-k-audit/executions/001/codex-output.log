+
+run kprove spec-nonempty.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-NONEMPTY
+
+run kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+printf '$ python3 py2mpy.py audit-empty.py > audit-empty.mpy\n'
