+        iCons(108,
+        iCons(108,
+        iCons(111,
+        iCons(32,
+        iCons(119,
+        iCons(111,
+        iCons(114,
+        iCons(108,
+        iCons(100, .IntSeq)))))))))))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map => ("string_to_md5" |-> stringToMd5Closure), parent(-1))
+      -1 |-> builtinsScope
