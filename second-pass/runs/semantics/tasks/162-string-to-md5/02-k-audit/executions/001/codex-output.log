diff --git a//tmp/audit-work/proof-162/verification-body-mutant.k b//tmp/audit-work/proof-162/verification-body-mutant.k
new file mode 100644
index 0000000000000000000000000000000000000000..e1427c09cd72b1a10ba47d4229111930de0eac3c
--- /dev/null
+++ b//tmp/audit-work/proof-162/verification-body-mutant.k
@@ -0,0 +1,22 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BODY-MUTANT
+  imports MPY
+
+  syntax Stmts ::= "stringToMd5BodyMutant" [macro]
+  rule stringToMd5BodyMutant
+    => If(UnaryOp("not", Name("text")),
+         Return(NoneVal),
+         .Stmts)
+       Return(NoneVal)
+
+  syntax Module ::= "solutionModuleMutant" [macro]
+  rule solutionModuleMutant
+    => Module(
+         Import("hashlib")
+         FuncDef("string_to_md5", Params("text"), stringToMd5BodyMutant))
+
+  syntax Val ::= "stringToMd5ClosureMutant" [macro]
+  rule stringToMd5ClosureMutant
+    => closureVal("text", stringToMd5BodyMutant, 0)
+endmodule
