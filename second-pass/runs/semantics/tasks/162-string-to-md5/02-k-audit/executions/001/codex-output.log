--- /dev/null
+++ b//tmp/audit-work/proof-162/spec-empty.k
@@ -0,0 +1,24 @@
+requires "verification.k"
+
+module SPEC-EMPTY
+  imports VERIFICATION
+
+  claim [audit-empty]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("string_to_md5"), Str(""))
+      =>
+      noneV
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map => ("string_to_md5" |-> stringToMd5Closure), parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
