      "normalized_sha256": "124492e1edcf40a69e84f00bd5d3958b537e8531fa1d682cd6d327c1eceee41b",
      "attributes": [],
      "text": "  rule willItFlyModule\n    => Module(\n         FuncDef(\n           \"will_it_fly\",\n           Params(\"q\", \"w\"),\n           Return(willItFlyResult)))"
    },
    {
      "source_rule_id": "rule-e9e6a90f2fb93ce00eb4643ca482c47f4a472b52cb3b28f078a2d97923c4e7df",
