      ],
      "text": "  rule <k> #sumAcc(list(VS:ValSeq), 0) => sumIntVS(VS) ... </k>\n    requires allInts(VS)\n    [priority(40)]"
    },
    {
      "source_rule_id": "rule-9b2c1d264a632bcb734a63c5c5afe47ce7c30f39f5fc22d0d5a730429dbd4197",
