    print('exact_parameter_def_count', name, count)
theorem=re.findall(r'(?ms)"'^'"\\s*theorem\\s+final\\s*:\\s*(.*?)\\s*:=\\s*by\\b', proof)
print('final_theorem_count', len(theorem))
print('final_statement_exact', len(theorem)==1 and ' '.join(theorem[0].split()) == ' '.join(gen['target']['statement'].split()))
assert pipeline_contract.sha256_tree(candidate) == audit['hashes']['lean_workspace_sha256']
assert klean_export.tree_digest(fresh/'Base') == gen['generated_tree_sha256']
assert parsed == gen['target'] == audit['target']
assert not forbidden and not all_decls
assert len(theorem)==1 and ' '.join(theorem[0].split()) == ' '.join(gen['target']['statement'].split())
print('CANDIDATE_TARGET_IDENTITY_OK')
