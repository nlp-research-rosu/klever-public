+
+def values : SortValSeq :=
+  cons (intVal 3) (cons (intVal (-2)) (cons (intVal 7) empty))
+
+def reversedValues : SortValSeq :=
+  cons (intVal 7) (cons (intVal (-2)) (cons (intVal 3) empty))
+
+def includesNonInt : SortValSeq :=
