diff --git a//tmp/audit-work/lean_getpid_shim.c b//tmp/audit-work/lean_getpid_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..c4e4036fc5bab5ae8d5d5027996de282624d163f
--- /dev/null
+++ b//tmp/audit-work/lean_getpid_shim.c
@@ -0,0 +1,30 @@
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The audit sandbox unshares PIDs but exposes the outer /proc mount.
+ * Lean locates its executable through /proc/<getpid()>/exe, so return the
+ * PID represented by /proc/self for Lean/Lake invocations in this sandbox.
+ */
+pid_t getpid(void) {
+    char target[64];
+    ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+    if (length <= 0 || length >= (ssize_t)sizeof(target)) {
+        errno = ESRCH;
+        return (pid_t)-1;
+    }
+    target[length] = '\0';
+
+    char *end = NULL;
+    long value = strtol(target, &end, 10);
+    if (end == target || *end != '\0' || value <= 0 || value > INT_MAX) {
+        errno = ESRCH;
+        return (pid_t)-1;
+    }
+    return (pid_t)value;
+}
