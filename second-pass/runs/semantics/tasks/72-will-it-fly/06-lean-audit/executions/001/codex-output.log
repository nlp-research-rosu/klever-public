+  constructor
+  · intro input
+    rfl
+  · intro _ _ _ _ _ _ _ _ _ _ _ input h
+    simp [badAllInts] at h
+
+example : badReverse values = values := by
+  rfl
+
+end BridgeProbes

diff --git a//tmp/audit-work/lean_getpid_shim.c b//tmp/audit-work/lean_getpid_shim.c
