+  | _, _, _, _ => SortVal.«noneV_MPY-CORE_Val»
+
+def badSum (_ : SortValSeq) : SortInt := 0
+
+theorem counterfactualTargetStillCloses :
+    Klean72WillItFly.Lemmas.targetStatement
+      badAllInts badDoSlice badReverse badSum := by
