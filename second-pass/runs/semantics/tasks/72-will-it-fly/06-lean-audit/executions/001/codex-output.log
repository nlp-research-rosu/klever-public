+        (SortVal.inj_SortIterable
+          (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» values))
+        SortOptInt.«noB_MPY-SUBSCRIPT_OptInt»
+        SortOptInt.«noB_MPY-SUBSCRIPT_OptInt»
