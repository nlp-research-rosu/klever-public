+        (SortOptInt.«someB(_)_MPY-SUBSCRIPT_OptInt_Int» (-1)) =
+      SortVal.inj_SortIterable
+        (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq» reversedValues) := by
+  rfl
+
+example :
