Module(
  FuncDef("will_it_fly", Params("q", "w"),
    Return(
      BoolOp(
        "and",
        Compare(
          Name("q"),
          CmpOp(
            "==",
            Subscript(
              Name("q"),
              Slice(NoBound, NoBound, UnaryOp("-", Int(1)))))),
        Compare(Call(Name("sum"), Name("q")), CmpOp("<=", Name("w"))))))
  Assert(
    Compare(
      Call(Name("will_it_fly"), ListExpr(Int(1), Int(2)), Int(5)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("will_it_fly"),
        ListExpr(Int(3), Int(2), Int(3)),
        Int(1)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("will_it_fly"),
        ListExpr(Int(3), Int(2), Int(3)),
        Int(9)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("will_it_fly"), ListExpr(Int(3)), Int(5)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("will_it_fly"), ListExpr(), Int(0)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("will_it_fly"),
        ListExpr(Int(4), UnaryOp("-", Int(10)), Int(4)),
        UnaryOp("-", Int(1))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("will_it_fly"),
        ListExpr(Int(1), Int(2), Int(2), Int(1)),
        Int(6)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("will_it_fly"),
        ListExpr(Int(1), Int(2), Int(2), Int(1)),
        Int(5)),
      CmpOp("==", Bool(false)))))
