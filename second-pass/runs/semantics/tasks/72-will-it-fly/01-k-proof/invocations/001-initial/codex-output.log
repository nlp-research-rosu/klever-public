+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Balanced and within the weight limit.
+  claim
+    <k> willItFlyResult => true </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(("q" |-> list(VS:ValSeq))
+                 ("w" |-> W:Int), parent(0))
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map => 0 |-> list(reverseVS(VS)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+     andBool VS ==K reverseVS(VS)
+     andBool sumIntVS(VS) <=Int W
+
+  // Unbalanced objects never fly, irrespective of the weight bound.
+  claim
+    <k> willItFlyResult => false </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(("q" |-> list(VS:ValSeq))
+                 ("w" |-> W:Int), parent(0))
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map => 0 |-> list(reverseVS(VS)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+     andBool notBool (VS ==K reverseVS(VS))
+
+  // Balanced but overweight objects do not fly.
+  claim
+    <k> willItFlyResult => false </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(("q" |-> list(VS:ValSeq))
+                 ("w" |-> W:Int), parent(0))
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map => 0 |-> list(reverseVS(VS)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+     andBool VS ==K reverseVS(VS)
+     andBool sumIntVS(VS) >Int W
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
