+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Balanced and within the weight limit.
+  claim
+    <k> willItFlyResult => true </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(("q" |-> list(VS:ValSeq))
+                 ("w" |-> W:Int), parent(0))
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map => 0 |-> list(reverseVS(VS)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+     andBool VS ==K reverseVS(VS)
+     andBool sumIntVS(VS) <=Int W
+
+  // Unbalanced objects never fly, irrespective of the weight bound.
+  claim
+    <k> willItFlyResult => false </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(("q" |-> list(VS:ValSeq))
+                 ("w" |-> W:Int), parent(0))
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map => 0 |-> list(reverseVS(VS)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+     andBool notBool (VS ==K reverseVS(VS))
+
+  // Balanced but overweight objects do not fly.
+  claim
+    <k> willItFlyResult => false </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(("q" |-> list(VS:ValSeq))
+                 ("w" |-> W:Int), parent(0))
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map => 0 |-> list(reverseVS(VS)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+     andBool VS ==K reverseVS(VS)
+     andBool sumIntVS(VS) >Int W
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..878e0076e0fc61ba1ad75d7ff626d208c7f4da31
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,50 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical model used by the contract.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(_:Int, REST:ValSeq)) => allInts(REST)
+  rule allInts(vCons(V:Val, _:ValSeq)) => false
+    requires notBool isInt(V)
+
+  syntax Int ::= sumIntVS(ValSeq) [function]
+  rule sumIntVS(.ValSeq) => 0
+  rule sumIntVS(vCons(I:Int, REST:ValSeq)) => I +Int sumIntVS(REST)
+
+  syntax ValSeq ::= snocVS(ValSeq, Val) [function, total]
+  rule snocVS(.ValSeq, V:Val) => vCons(V, .ValSeq)
+  rule snocVS(vCons(H:Val, T:ValSeq), V:Val)
+    => vCons(H, snocVS(T, V))
+
+  syntax ValSeq ::= reverseVS(ValSeq) [function, total]
+  rule reverseVS(.ValSeq) => .ValSeq
+  rule reverseVS(vCons(H:Val, T:ValSeq))
+    => snocVS(reverseVS(T), H)
+
+  // Symbolic summaries of two terminating folds in the supplied semantics.
+  // They agree with subscript.k's q[::-1] and builtins.k's sum(q), while
+  // allowing a proof over an arbitrary (rather than fixed-length) ValSeq.
+  rule doSlice(list(VS:ValSeq), noB, noB, someB(-1))
+    => list(reverseVS(VS))
+    [priority(40)]
+
+  rule <k> #sumAcc(list(VS:ValSeq), 0) => sumIntVS(VS) ... </k>
+    requires allInts(VS)
+    [priority(40)]
+
+  syntax Expr ::= "willItFlyResult"
+  rule willItFlyResult
+    => BoolOp(
+         "and",
+         Compare(
+           Name("q"),
+           CmpOp(
+             "==",
+             Subscript(
+               Name("q"),
+               Slice(NoBound, NoBound, UnaryOp("-", Int(1)))))),
+         Compare(Call(Name("sum"), Name("q")), CmpOp("<=", Name("w"))))
+endmodule

