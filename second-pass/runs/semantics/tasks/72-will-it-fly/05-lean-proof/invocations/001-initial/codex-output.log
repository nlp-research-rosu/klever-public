codex
Root cause confirmed: this container’s PID namespace reports a namespace PID from `getpid()`, while `/proc` exposes host PIDs. Lean 4.22 constructs `/proc/<getpid>/exe`, so its application-path lookup fails even though `/proc/self/exe` works. I’m applying a temporary, process-local `readlink` shim for the build only; it redirects that one lookup to `/proc/self/exe` and does not alter the project, target, or toolchain files.
apply patch
patch: completed
/tmp/lean-app-path-shim.c
diff --git a//tmp/lean-app-path-shim.c b//tmp/lean-app-path-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..8080fe227c2aace4b957d4095ea38fc6fa6ae905
--- /dev/null
+++ b//tmp/lean-app-path-shim.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink = NULL;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+
+  size_t length = strlen(path);
+  if (length > 10
+      && strncmp(path, "/proc/", 6) == 0
+      && strcmp(path + length - 4, "/exe") == 0) {
+    return real_readlink("/proc/self/exe", buffer, size);
+  }
+  return real_readlink(path, buffer, size);
+}
