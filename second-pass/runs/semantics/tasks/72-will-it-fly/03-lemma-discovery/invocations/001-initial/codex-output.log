#!/usr/bin/env bash
set -euo pipefail

# Translate the submitted implementation.
python3 py2mpy.py solution.py > solution.mpy

# Ensure the concrete test harness embeds the submitted entry point verbatim.
python3 - <<'PY'
import ast

with open("solution.py", encoding="utf-8") as stream:
    solution = ast.parse(stream.read())
with open("concrete-tests.py", encoding="utf-8") as stream:
    tests = ast.parse(stream.read())

assert ast.dump(solution.body[0], include_attributes=False) == ast.dump(
    tests.body[0], include_attributes=False
)
PY

# Compile and exercise the supplied concrete semantics.
python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled
krun concrete-tests.mpy --definition runtime-kompiled

# Compile the symbolic definition and prove all contract claims.
kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC
requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // Mathematical model used by the contract.
  syntax Bool ::= allInts(ValSeq) [function, total]
  rule allInts(.ValSeq) => true
  rule allInts(vCons(_:Int, REST:ValSeq)) => allInts(REST)
  rule allInts(vCons(V:Val, _:ValSeq)) => false
    requires notBool isInt(V)

  syntax Int ::= sumIntVS(ValSeq) [function, total]
  rule sumIntVS(.ValSeq) => 0
  rule sumIntVS(vCons(I:Int, REST:ValSeq)) => I +Int sumIntVS(REST)

  syntax ValSeq ::= snocVS(ValSeq, Val) [function, total]
  rule snocVS(.ValSeq, V:Val) => vCons(V, .ValSeq)
  rule snocVS(vCons(H:Val, T:ValSeq), V:Val)
    => vCons(H, snocVS(T, V))

  syntax ValSeq ::= reverseVS(ValSeq) [function, total]
  rule reverseVS(.ValSeq) => .ValSeq
  rule reverseVS(vCons(H:Val, T:ValSeq))
    => snocVS(reverseVS(T), H)

  // Symbolic summaries of two terminating folds in the supplied semantics.
  // They agree with subscript.k's q[::-1] and builtins.k's sum(q), while
  // allowing a proof over an arbitrary (rather than fixed-length) ValSeq.
  rule doSlice(list(VS:ValSeq), noB, noB, someB(-1))
    => list(reverseVS(VS))
    [priority(40)]

  rule <k> #sumAcc(list(VS:ValSeq), 0) => sumIntVS(VS) ... </k>
    requires allInts(VS)
    [priority(40)]

  syntax Expr ::= "willItFlyResult"
  rule willItFlyResult
    => BoolOp(
         "and",
         Compare(
           Name("q"),
           CmpOp(
             "==",
             Subscript(
               Name("q"),
               Slice(NoBound, NoBound, UnaryOp("-", Int(1)))))),
         Compare(Call(Name("sum"), Name("q")), CmpOp("<=", Name("w"))))

  // The translated entry point, factored into named terms so the claims can
  // execute definition, lookup, argument binding, return, and frame cleanup.
  syntax Module ::= "willItFlyModule" [function]
  rule willItFlyModule
    => Module(
         FuncDef(
           "will_it_fly",
           Params("q", "w"),
           Return(willItFlyResult)))

  syntax Val ::= "willItFlyClosure" [function]
  rule willItFlyClosure
    => closureVal(("q", "w"), Return(willItFlyResult), 0)
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  // Balanced and within the weight limit.
  claim
    <k>
      #loadAll(willItFlyModule)
      ~> Call(Name("will_it_fly"), list(VS:ValSeq), W:Int)
      => true
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(.Map => "will_it_fly" |-> willItFlyClosure,
                  parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map => 0 |-> list(reverseVS(VS)) </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires allInts(VS)
     andBool VS ==K reverseVS(VS)
     andBool sumIntVS(VS) <=Int W

  // Unbalanced objects never fly, irrespective of the weight bound.
  claim
    <k>
      #loadAll(willItFlyModule)
      ~> Call(Name("will_it_fly"), list(VS:ValSeq), W:Int)
      => false
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(.Map => "will_it_fly" |-> willItFlyClosure,
                  parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map => 0 |-> list(reverseVS(VS)) </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires allInts(VS)
     andBool notBool (VS ==K reverseVS(VS))

  // Balanced but overweight objects do not fly.
  claim
    <k>
      #loadAll(willItFlyModule)
      ~> Call(Name("will_it_fly"), list(VS:ValSeq), W:Int)
      => false
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(.Map => "will_it_fly" |-> willItFlyClosure,
                  parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map => 0 |-> list(reverseVS(VS)) </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires allInts(VS)
     andBool VS ==K reverseVS(VS)
     andBool sumIntVS(VS) >Int W
endmodule
