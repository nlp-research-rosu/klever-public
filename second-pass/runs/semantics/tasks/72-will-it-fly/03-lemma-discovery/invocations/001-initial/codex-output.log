/bin/bash -lc "python3 - <<'PY'
import json
from pathlib import Path
inv_path=Path('/reference/rule-inventory.json')
out_path=Path('/workspace/trust-boundary.json')
inv=json.loads(inv_path.read_text(encoding='utf-8'))
out=json.loads(out_path.read_text(encoding='utf-8'))
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert list(out.keys()) == ['schema_version','inventory_sha256','rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
expected=[r['source_rule_id'] for r in inv['rules']]
actual=[r['source_rule_id'] for r in out['rules']]
assert actual == expected
assert len(actual) == len(set(actual))
for source, entry in zip(inv['rules'], out['rules']):
    assert set(entry) == {'source_rule_id','classification','rationale'}
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
    if any(a == 'simplification' or a.startswith('simplification(') for a in source['attributes']):
        assert entry['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
print(f\"validated {len(actual)} rules\")
from collections import Counter
print(dict(Counter(r['classification'] for r in out['rules'])))
print(out['inventory_sha256'])
PY
