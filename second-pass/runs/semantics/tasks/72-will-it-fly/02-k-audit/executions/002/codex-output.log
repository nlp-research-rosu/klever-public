+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+     andBool VS ==K reverseVS(VS)
+     andBool sumIntVS(VS) <=Int W
