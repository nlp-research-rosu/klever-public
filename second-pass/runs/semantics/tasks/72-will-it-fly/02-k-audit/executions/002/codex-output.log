+WORKDIR: /tmp/audit-work/reconstruction
+EXIT: 1
+RELEVANT OUTPUT:
+Warning (WarnStuckClaimState):
+  #Ceil ( buildVS ( VS , vsLen ( VS ) +Int -1 , -1 , -1 ) )
+  #And
