/bin/bash -lc "python3 - <<'PY'
import hashlib, json, os
from pathlib import Path

def variants(root):
 root=Path(root)
 files=sorted(p for p in root.rglob('*') if p.is_file())
 dirs=sorted(p for p in root.rglob('*') if p.is_dir())
 entries=[*files]
 data={}
 data['contents']=b''.join(p.read_bytes() for p in files)
 data['path_nul_content']=b''.join(p.relative_to(root).as_posix().encode()+b'\\0'+p.read_bytes() for p in files)
 data['path_lf_content']=b''.join(p.relative_to(root).as_posix().encode()+b'\\n'+p.read_bytes() for p in files)
 data['sha_lines']=b''.join(hashlib.sha256(p.read_bytes()).hexdigest().encode()+b'  '+p.relative_to(root).as_posix().encode()+b'\\n' for p in files)
 data['path_sha_lines']=b''.join(p.relative_to(root).as_posix().encode()+b'\\0'+hashlib.sha256(p.read_bytes()).hexdigest().encode()+b'\\n' for p in files)
 manifest=[{'path':p.relative_to(root).as_posix(),'sha256':hashlib.sha256(p.read_bytes()).hexdigest()} for p in files]
 data['json_manifest_compact']=json.dumps(manifest,sort_keys=True,separators=(',',':')).encode()
 data['json_manifest_indent']=json.dumps(manifest,sort_keys=True,indent=2).encode()+b'\\n'
 for n,b in data.items(): print(root,n,hashlib.sha256(b).hexdigest())
variants('/reference/reference-semantics')
variants('/candidate')
