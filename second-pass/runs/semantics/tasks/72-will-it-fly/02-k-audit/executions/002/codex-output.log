+    <heap> HP:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> RT:RetState </ret>
+    <exc> EX:Exc </exc>
+    <exit-code> EC:Int </exit-code>
+    requires auditAllInts(VS)
+endmodule
