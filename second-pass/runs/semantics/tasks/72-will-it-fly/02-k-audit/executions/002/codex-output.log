ERIFICATION\n+\n+  // Balanced and within the weight limit.\n+  claim\n+    <k> willItFlyResult => true </k>\n+    <env> 1 </env>\n+    <scopes>\n+      1 |-> scope((\"q\" |-> list(VS:ValSeq))\n+                 (\"w\" |-> W:Int), parent(0))\n+      0 |-> scope(.Map, parent(-1))\n+      -1 |-> builtinsScope\n+    </scopes>\n+    <scopeLoc> 2 </scopeLoc>\n+    <heap> .Map => 0 |-> list(reverseVS(VS)) </heap>\n+    <heapLoc> 0 => 1 </heapLoc>\n+    <stack> .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+    requires allInts(VS)\n+     andBool VS ==K reverseVS(VS)\n+     andBool sumIntVS(VS) <=Int W\n+\n+  // Unbalanced objects never fly, irrespective of the weight bound.\n+  claim\n+    <k> willItFlyResult => false </k>\n+    <env> 1 </env>\n+    <scopes>\n+      1 |-> scope((\"q\" |-> list(VS:ValSeq))\n+                 (\"w\" |-> W:Int), parent(0))\n+      0 |-> scope(.Map, parent(-1))\n+      -1 |-> builtinsScope\n+    </scopes>\n+    <scopeLoc> 2 </scopeLoc>\n+    <heap> .Map => 0 |-> list(reverseVS(VS)) </heap>\n+    <heapLoc> 0 => 1 </heapLoc>\n+    <stack> .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+    requires allInts(VS)\n+     andBool notBool (VS ==K reverseVS(VS))\n+\n+  // Balanced but overweight objects do not fly.\n+  claim\n+    <k> willItFlyResult => false </k>\n+    <env> 1 </env>\n+    <scopes>\n+      1 |-> scope((\"q\" |-> list(VS:ValSeq))\n+                 (\"w\" |-> W:Int), parent(0))\n+      0 |-> scope(.Map, parent(-1))\n+      -1 |-> builtinsScope\n+    </scopes>\n+    <scopeLoc> 2 </scopeLoc>\n+    <heap> .Map => 0 |-> list(reverseVS(VS)) </heap>\n+    <heapLoc> 0 => 1 </heapLoc>\n+    <stack> .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+    requires allInts(VS)\n+     andBool VS ==K reverseVS(VS)\n+     andBool sumIntVS(VS) >Int W\n+endmodule\n*** End Patch\n"
