+requires "bridge-base.k"
+
+module BRIDGE-GROUND-FALSE-SPEC
+  imports BRIDGE-BASE
+
+  // Deliberately wrong opposite interpretation: [1,2] reversed is not [1,2].
+  claim
+    <k>
+      doSlice(
+        list(vCons(1, vCons(2, .ValSeq))),
+        noB, noB, someB(-1))
+      => list(vCons(1, vCons(2, .ValSeq)))
+    </k>
+endmodule
diff --git a//tmp/audit-work/reconstruction/bridge-ground-spec.k b//tmp/audit-work/reconstruction/bridge-ground-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e54bb166c5013a3c09c3b14ea57ad9da227f6c76
--- /dev/null
+++ b//tmp/audit-work/reconstruction/bridge-ground-spec.k
@@ -0,0 +1,44 @@
+requires "bridge-base.k"
+
+module BRIDGE-GROUND-SPEC
+  imports BRIDGE-BASE
+
+  // Bridge-free fixed-semantics witnesses for reverse slicing.
+  claim
+    <k>
+      doSlice(list(.ValSeq), noB, noB, someB(-1))
+      => list(.ValSeq)
+    </k>
+
+  claim
+    <k>
+      doSlice(list(vCons(7, .ValSeq)), noB, noB, someB(-1))
+      => list(vCons(7, .ValSeq))
+    </k>
+
+  claim
+    <k>
+      doSlice(
+        list(vCons(1, vCons(2, vCons(3, .ValSeq)))),
+        noB, noB, someB(-1))
+      => list(vCons(3, vCons(2, vCons(1, .ValSeq))))
+    </k>
+
+  claim
+    <k>
+      doSlice(
+        list(vCons(true, vCons(noneV, .ValSeq))),
+        noB, noB, someB(-1))
+      => list(vCons(noneV, vCons(true, .ValSeq)))
+    </k>
+
+  // Bridge-free fixed-semantics witnesses for integer sum.
+  claim
+    <k> #sumAcc(list(.ValSeq), 0) => 0 </k>
+
+  claim
+    <k>
+      #sumAcc(list(vCons(1, vCons(-2, vCons(3, .ValSeq)))), 0)
+      => 2
+    </k>
+endmodule
