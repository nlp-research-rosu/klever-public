+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(reverseVS(VS)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+     andBool VS ==K reverseVS(VS)
+     andBool sumIntVS(VS) <=Int W
+endmodule
