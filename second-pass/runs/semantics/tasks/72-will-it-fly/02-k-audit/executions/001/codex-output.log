diff --git a/evidence/spec-false-balanced.k b/evidence/spec-false-balanced.k
new file mode 100644
index 0000000000000000000000000000000000000000..26ddc1844e9ee7b9cf7a556acf82bea9e4429a18
--- /dev/null
+++ b/evidence/spec-false-balanced.k
@@ -0,0 +1,30 @@
+requires "verification.k"
+
+module SPEC-FALSE-BALANCED
+  imports VERIFICATION
+
+  // Deliberately false: [3,2,3] with w=9 satisfies this precondition, but the
+  // real and generated Python functions both return true, not false.
+  claim
+    <k>
+      #loadAll(willItFlyModule)
+      ~> Call(Name("will_it_fly"), list(VS:ValSeq), W:Int)
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map => "will_it_fly" |-> willItFlyClosure,
+                  parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(reverseVS(VS)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+     andBool VS ==K reverseVS(VS)
+     andBool sumIntVS(VS) <=Int W
+endmodule
