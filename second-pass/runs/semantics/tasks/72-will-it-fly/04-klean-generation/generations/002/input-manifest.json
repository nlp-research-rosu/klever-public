{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 8,
      "module": "VERIFICATION",
      "normalized_sha256": "8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "rationale": "Base equation defining the allInts predicate on the empty value sequence.",
      "source_rule_id": "rule-8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "start_line": 8,
      "text": "  rule allInts(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 9,
      "module": "VERIFICATION",
      "normalized_sha256": "eb01b6f961218a9e5b8ece457a30b8c7cb8b55db7fb423d286186ba232f0aee3",
      "rationale": "Recursive equation defining allInts for a sequence whose head has sort Int.",
      "source_rule_id": "rule-eb01b6f961218a9e5b8ece457a30b8c7cb8b55db7fb423d286186ba232f0aee3",
      "start_line": 9,
      "text": "  rule allInts(vCons(_:Int, REST:ValSeq)) => allInts(REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 11,
      "module": "VERIFICATION",
      "normalized_sha256": "571c5f5e487d813d7b511f60c911baa33380f2fcf106096134e0fb29fc85d948",
      "rationale": "Defining negative case of allInts for a value-sequence head constrained not to be an Int.",
      "source_rule_id": "rule-571c5f5e487d813d7b511f60c911baa33380f2fcf106096134e0fb29fc85d948",
      "start_line": 10,
      "text": "  rule allInts(vCons(V:Val, _:ValSeq)) => false\n    requires notBool isInt(V)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 14,
      "module": "VERIFICATION",
      "normalized_sha256": "54f4fd6c0759f5812a98a0df3c492a4d51892178432203d348728bb8e63486e0",
      "rationale": "Base equation defining the integer sum summary of an empty value sequence.",
      "source_rule_id": "rule-54f4fd6c0759f5812a98a0df3c492a4d51892178432203d348728bb8e63486e0",
      "start_line": 14,
      "text": "  rule sumIntVS(.ValSeq) => 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 15,
      "module": "VERIFICATION",
      "normalized_sha256": "01e541a4f9625d93fed0c3da05caebc4267a821c55a48bd0f7d61899668ac08e",
      "rationale": "Recursive equation defining sumIntVS by adding an integer head to the summarized tail.",
      "source_rule_id": "rule-01e541a4f9625d93fed0c3da05caebc4267a821c55a48bd0f7d61899668ac08e",
      "start_line": 15,
      "text": "  rule sumIntVS(vCons(I:Int, REST:ValSeq)) => I +Int sumIntVS(REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 18,
      "module": "VERIFICATION",
      "normalized_sha256": "becebddf142d7576a24cbe9dcc443d2914a5940ec4d344d1d179d0b17c2a8678",
      "rationale": "Base equation defining snocVS when appending a value to the empty sequence.",
      "source_rule_id": "rule-becebddf142d7576a24cbe9dcc443d2914a5940ec4d344d1d179d0b17c2a8678",
      "start_line": 18,
      "text": "  rule snocVS(.ValSeq, V:Val) => vCons(V, .ValSeq)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 20,
      "module": "VERIFICATION",
      "normalized_sha256": "a074558c6e6502d0ec637dab6d4ea3994203ef7eb07051486fef343a035c7b87",
      "rationale": "Recursive structural equation defining snocVS on a nonempty sequence.",
      "source_rule_id": "rule-a074558c6e6502d0ec637dab6d4ea3994203ef7eb07051486fef343a035c7b87",
      "start_line": 19,
      "text": "  rule snocVS(vCons(H:Val, T:ValSeq), V:Val)\n    => vCons(H, snocVS(T, V))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 23,
      "module": "VERIFICATION",
      "normalized_sha256": "76a248ec07038f0b4c6f37cc00b5e46a9544ae63d67acabfff3b08b42a437b4b",
      "rationale": "Base equation defining reverseVS on the empty sequence.",
      "source_rule_id": "rule-76a248ec07038f0b4c6f37cc00b5e46a9544ae63d67acabfff3b08b42a437b4b",
      "start_line": 23,
      "text": "  rule reverseVS(.ValSeq) => .ValSeq"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "VERIFICATION",
      "normalized_sha256": "9a75b2367381745f16c1f23a52089299f9499ad0db56963f0de65e1b64ebaa84",
      "rationale": "Recursive equation defining reverseVS using the separately defined snocVS helper.",
      "source_rule_id": "rule-9a75b2367381745f16c1f23a52089299f9499ad0db56963f0de65e1b64ebaa84",
      "start_line": 24,
      "text": "  rule reverseVS(vCons(H:Val, T:ValSeq))\n    => snocVS(reverseVS(T), H)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 49,
      "module": "VERIFICATION",
      "normalized_sha256": "9b2c1d264a632bcb734a63c5c5afe47ce7c30f39f5fc22d0d5a730429dbd4197",
      "rationale": "Named proof-term expansion defining willItFlyResult as the translated return expression.",
      "source_rule_id": "rule-9b2c1d264a632bcb734a63c5c5afe47ce7c30f39f5fc22d0d5a730429dbd4197",
      "start_line": 39,
      "text": "  rule willItFlyResult\n    => BoolOp(\n         \"and\",\n         Compare(\n           Name(\"q\"),\n           CmpOp(\n             \"==\",\n             Subscript(\n               Name(\"q\"),\n               Slice(NoBound, NoBound, UnaryOp(\"-\", Int(1)))))),\n         Compare(Call(Name(\"sum\"), Name(\"q\")), CmpOp(\"<=\", Name(\"w\"))))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 59,
      "module": "VERIFICATION",
      "normalized_sha256": "124492e1edcf40a69e84f00bd5d3958b537e8531fa1d682cd6d327c1eceee41b",
      "rationale": "Named proof-term expansion defining willItFlyModule as the translated function module.",
      "source_rule_id": "rule-124492e1edcf40a69e84f00bd5d3958b537e8531fa1d682cd6d327c1eceee41b",
      "start_line": 54,
      "text": "  rule willItFlyModule\n    => Module(\n         FuncDef(\n           \"will_it_fly\",\n           Params(\"q\", \"w\"),\n           Return(willItFlyResult)))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 63,
      "module": "VERIFICATION",
      "normalized_sha256": "e9e6a90f2fb93ce00eb4643ca482c47f4a472b52cb3b28f078a2d97923c4e7df",
      "rationale": "Named proof-term expansion defining the closure value expected after loading willItFlyModule.",
      "source_rule_id": "rule-e9e6a90f2fb93ce00eb4643ca482c47f4a472b52cb3b28f078a2d97923c4e7df",
      "start_line": 62,
      "text": "  rule willItFlyClosure\n    => closureVal((\"q\", \"w\"), Return(willItFlyResult), 0)"
    }
  ],
