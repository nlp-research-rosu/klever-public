diff --git a/evidence/stage3/spec-abc-only.k b/evidence/stage3/spec-abc-only.k
new file mode 100644
index 0000000000000000000000000000000000000000..fbca727a5142dd70dc89f17892fc9a117560ff50
--- /dev/null
+++ b/evidence/stage3/spec-abc-only.k
@@ -0,0 +1,30 @@
+requires "/tmp/audit-work/28-concatenate/verification.k"
+
+module AUDIT-CONCATENATE-SPEC-ABC
+  imports CONCATENATE-VERIFICATION
+
+  claim [audit-abc]:
+    <k>
+      #loadAll(concatenateModule)
+      ~> Call(
+           Name("concatenate"),
+           ListExpr(Str("a"), Str("b"), Str("c"))
+         )
+      =>
+      str(iCons(97, iCons(98, iCons(99, .IntSeq))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      ?FINAL_SCOPES:Map
