+    ),
+    ("verification.k", 26): (
+        "ACCEPTED_DECLARATION",
+        "Structural accumulator fold; used only with all-string ValSeq.",
+    ),
+    ("verification.k", 27): ("SOUND", "Empty fold returns the accumulator."),
+    ("verification.k", 28): (
