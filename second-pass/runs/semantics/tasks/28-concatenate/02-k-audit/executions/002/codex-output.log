/bin/bash -lc 'cp /audit-output/evidence/04-adequacy/pinning.k /tmp/audit-work/28-concatenate-audit/pinning.k && /audit-output/evidence/run_capture.sh /audit-output/evidence/04-adequacy/kprove-pinning.log kprove pinning.k --definition verification-kompiled --spec-module CONCATENATE-PINNING && /audit-output/evidence/run_capture.sh /audit-output/evidence/04-adequacy/ground-witnesses.log python3 /audit-output/evidence/04-adequacy/ground_witnesses.py' in /tmp/audit-work/28-concatenate-audit
