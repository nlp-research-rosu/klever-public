@@ -0,0 +1,32 @@
+requires "verification.k"
+
+module CONCATENATE-SPEC-VACUITY
+  imports CONCATENATE-VERIFICATION
+
+  // Deliberately false: the actual result for ["a", "b", "c"] ends in code
+  // point 99 ("c"), while this postcondition demands 100 ("d").
+  claim [abc-wrong-last-code]:
+    <k>
+      #loadAll(concatenateModule)
+      ~> Call(
+           Name("concatenate"),
+           ListExpr(Str("a"), Str("b"), Str("c"))
+         )
+      =>
+      str(iCons(97, iCons(98, iCons(100, .IntSeq))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => ?FINAL_SCOPE_LOC:Int </scopeLoc>
+    <heap> .Map => ?FINAL_HEAP:Map </heap>
+    <heapLoc> 0 => ?FINAL_HEAP_LOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/run_capture.sh b/evidence/run_capture.sh
new file mode 100644
index 0000000000000000000000000000000000000000..0211c376a0d63ea881a8b6d083a5c74cda31b1d7
--- /dev/null
+++ b/evidence/run_capture.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: run_capture.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  command_status=$?
+  printf '\nEXIT_STATUS: %d\n' "$command_status"
+  exit "$command_status"
+} 2>&1 | tee "$log_path"
+
+exit "${PIPESTATUS[0]}"

