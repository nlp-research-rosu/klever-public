index 0000000000000000000000000000000000000000..0bc5420e7b655c074d2c2afd2f4495f883c804e1
--- /dev/null
+++ b/evidence/03-reconstruction/concrete_boundary.py
@@ -0,0 +1,18 @@
+from typing import List
+
+
+def concatenate(strings: List[str]) -> str:
+    result = ""
+    string = ""
+    for string in strings:
+        result += string
+    return result
+
+
+assert concatenate([]) == ""
+assert concatenate([""]) == ""
+assert concatenate(["x"]) == "x"
+assert concatenate(["", "a", "", "b", ""]) == "ab"
+assert concatenate(["hello", " ", "world"]) == "hello world"
+assert concatenate(["lambda=", "λ"]) == "lambda=λ"
+assert concatenate(["line1\n", "line2"]) == "line1\nline2"
