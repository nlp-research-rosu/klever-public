new file mode 100644
index 0000000000000000000000000000000000000000..d2a2f97bda20f091293d92ecb60bc3f93d368d4f
--- /dev/null
+++ b/evidence/03-reconstruction/concrete_boundary_ascii.py
@@ -0,0 +1,17 @@
+from typing import List
+
+
+def concatenate(strings: List[str]) -> str:
+    result = ""
+    string = ""
+    for string in strings:
+        result += string
+    return result
+
+
+assert concatenate([]) == ""
+assert concatenate([""]) == ""
+assert concatenate(["x"]) == "x"
+assert concatenate(["", "a", "", "b", ""]) == "ab"
+assert concatenate(["hello", " ", "world"]) == "hello world"
+assert concatenate(["line1\n", "line2"]) == "line1\nline2"
