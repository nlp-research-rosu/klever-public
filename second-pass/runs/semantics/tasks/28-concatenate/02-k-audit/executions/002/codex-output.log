diff --git a/evidence/03-reconstruction/spec-labeled.k b/evidence/03-reconstruction/spec-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..350f679936d4725e63b364610b956cf47434f965
--- /dev/null
+++ b/evidence/03-reconstruction/spec-labeled.k
@@ -0,0 +1,79 @@
+requires "verification.k"
+
+module CONCATENATE-SPEC-LABELED
+  imports CONCATENATE-VERIFICATION
+
+  claim [loop]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("string"),
+        concatenateLoopBody
+      )
+      ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        ("result" |-> str(A:IntSeq)
+         "string" |-> OLD_STRING:Val
+         "strings" |-> ARGUMENT:Val)
+        =>
+        ("result" |-> str(concatenateValues(A, VS))
+         "string" |-> finalLoopValue(OLD_STRING, VS)
+         "strings" |-> ARGUMENT),
+        parent(0)
+      )
+    </scopes>
+    requires allStringValues(VS)
+
+  claim [empty]:
+    <k>
+      #loadAll(concatenateModule)
+      ~> Call(Name("concatenate"), ListExpr(.Exprs))
+      =>
+      str(.IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => ?FINAL_SCOPE_LOC:Int </scopeLoc>
+    <heap> .Map => ?FINAL_HEAP:Map </heap>
+    <heapLoc> 0 => ?FINAL_HEAP_LOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [abc]:
+    <k>
+      #loadAll(concatenateModule)
+      ~> Call(
+           Name("concatenate"),
+           ListExpr(Str("a"), Str("b"), Str("c"))
+         )
+      =>
+      str(iCons(97, iCons(98, iCons(99, .IntSeq))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => ?FINAL_SCOPE_LOC:Int </scopeLoc>
+    <heap> .Map => ?FINAL_HEAP:Map </heap>
+    <heapLoc> 0 => ?FINAL_HEAP_LOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/run_capture.sh b/evidence/run_capture.sh
new file mode 100644
index 0000000000000000000000000000000000000000..0211c376a0d63ea881a8b6d083a5c74cda31b1d7
--- /dev/null
+++ b/evidence/run_capture.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: run_capture.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  command_status=$?
+  printf '\nEXIT_STATUS: %d\n' "$command_status"
+  exit "$command_status"
+} 2>&1 | tee "$log_path"
+
+exit "${PIPESTATUS[0]}"

apply patch
