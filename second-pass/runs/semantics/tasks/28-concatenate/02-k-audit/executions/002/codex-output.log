+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        ("result" |-> str(A:IntSeq)
+         "string" |-> OLD_STRING:Val
+         "strings" |-> ARGUMENT:Val)
+        =>
+        ("result" |-> str(concatenateValues(A, VS))
+         "string" |-> finalLoopValue(OLD_STRING, VS)
+         "strings" |-> ARGUMENT),
+        parent(0)
+      )
+    </scopes>
+    requires allStringValues(VS)
+
+  // This full-domain entry theorem is deliberately absent from candidate
+  // spec.k. It is an audit experiment, not part of the immutable candidate.
+  claim [universal-entry]:
+    <k>
+      #loadAll(concatenateModule)
+      ~> Call(Name("concatenate"), (list(VS:ValSeq), .Exprs))
+      =>
+      str(concatenateValues(.IntSeq, VS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => ?FINAL_SCOPE_LOC:Int </scopeLoc>
+    <heap> .Map => ?FINAL_HEAP:Map </heap>
+    <heapLoc> 0 => ?FINAL_HEAP_LOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allStringValues(VS)
+endmodule
diff --git a/evidence/04-adequacy/pinning-config.k b/evidence/04-adequacy/pinning-config.k
new file mode 100644
index 0000000000000000000000000000000000000000..3e1ce5ab548af6b535e53d783c2f91ad88fb20e7
--- /dev/null
+++ b/evidence/04-adequacy/pinning-config.k
@@ -0,0 +1,23 @@
+requires "verification.k"
+
+module CONCATENATE-PINNING-CONFIG
+  imports CONCATENATE-VERIFICATION
+
+  // A configuration reachability form avoids the Haskell backend's
+  // unsupported bare functional-claim path while checking the same
+  // constructor normalization.
+  claim [module-term-config]:
+    <k>
+      concatenateModule
+      =>
+      Module(
+        ImportFrom("typing", "List")
+        FuncDef("concatenate", Params("strings"),
+          Assign(Name("result"), Str(""))
+          Assign(Name("string"), Str(""))
+          For(Name("string"), Name("strings"),
+            AugAssign(Name("result"), "+", Name("string")))
+          Return(Name("result")))
+      )
+    </k>
+endmodule
