diff --git a/evidence/03-reconstruction/spec-labeled.k b/evidence/03-reconstruction/spec-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..350f679936d4725e63b364610b956cf47434f965
--- /dev/null
+++ b/evidence/03-reconstruction/spec-labeled.k
@@ -0,0 +1,79 @@
+requires "verification.k"
+
+module CONCATENATE-SPEC-LABELED
+  imports CONCATENATE-VERIFICATION
+
+  claim [loop]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("string"),
+        concatenateLoopBody
+      )
+      ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        ("result" |-> str(A:IntSeq)
