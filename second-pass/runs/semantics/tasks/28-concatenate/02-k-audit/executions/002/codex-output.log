+assert concatenate([""]) == ""
+assert concatenate(["x"]) == "x"
+assert concatenate(["", "a", "", "b", ""]) == "ab"
+assert concatenate(["hello", " ", "world"]) == "hello world"
+assert concatenate(["lambda=", "λ"]) == "lambda=λ"
+assert concatenate(["line1\n", "line2"]) == "line1\nline2"
