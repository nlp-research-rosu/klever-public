Module(
  ImportFrom("typing", "List")
  FuncDef("concatenate", Params("strings"),
    Assign(Name("result"), Str(""))
    Assign(Name("string"), Str(""))
    For(Name("string"), Name("strings"),
      AugAssign(Name("result"), "+", Name("string")))
    Return(Name("result")))
  Assert(
    Compare(Call(Name("concatenate"), ListExpr()), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("concatenate"), ListExpr(Str("a"), Str("b"), Str("c"))),
      CmpOp("==", Str("abc"))))
  Assert(
    Compare(
      Call(
        Name("concatenate"),
        ListExpr(Str("hello"), Str(""), Str(" world"))),
      CmpOp("==", Str("hello world")))))
