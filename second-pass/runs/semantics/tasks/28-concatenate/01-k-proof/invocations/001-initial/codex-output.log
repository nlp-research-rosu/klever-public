diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..ad88a88557060281a92929c70e0c45ebdc3001b6
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,56 @@
+requires "verification.k"
+
+module CONCATENATE-SPEC
+  imports CONCATENATE-VERIFICATION
+
+  // Loop invariant and total-correctness argument for every finite List[str].
+  // The function frame is popped on the right, so loop-local bindings do not
+  // leak into the post-state.
+  claim
+    <k>
+      #loop(
+        list(stringValues(SS:StringList)),
+        Name("string"),
+        concatenateLoopBody
+      )
+      ~> Return(Name("result"))
+      ~> #endcall
+      =>
+      str(concatenateFrom(A:IntSeq, SS))
+      ~> CONT:K
+    </k>
+    <env> L:Int => CALLER:Int </env>
+    <scopes>
+      (SC:Map
+       L |-> scope(("result" |-> str(A)) M:Map, P:Parent))
+      =>
+      SC
+    </scopes>
+    <scopeLoc> _ => L </scopeLoc>
+    <stack>
+      (ListItem(frame(CONT, CALLER, L)) => .List)
+      STACK:List
+    </stack>
+    <ret> noRet </ret>
+
+  // End-to-end checks ensure the translated module, definition/call plumbing,
+  // empty identity, iteration order, and string addition are all connected.
+  claim
+    <k>
+      #loadAll(concatenateModule)
+      ~> Call(Name("concatenate"), ListExpr(.Exprs))
+      =>
+      str(.IntSeq)
+    </k>
+
+  claim
+    <k>
+      #loadAll(concatenateModule)
+      ~> Call(
+           Name("concatenate"),
+           ListExpr(Str("a"), Str("b"), Str("c"))
+         )
+      =>
+      str(iCons(97, iCons(98, iCons(99, .IntSeq))))
+    </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..257fe2a999e7a80cc24bb4c733c0c9aae5cd9aac
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,40 @@
+requires "reference-semantics/semantics.k"
+
+module CONCATENATE-VERIFICATION
+  imports MPY
+
+  // A typed symbolic input: every element is a modeled Python string.
+  syntax StringList ::= emptyStrings
+                      | moreStrings(IntSeq, StringList)
+
+  syntax ValSeq ::= stringValues(StringList) [function, total]
+  rule stringValues(emptyStrings) => .ValSeq
+  rule stringValues(moreStrings(S:IntSeq, SS:StringList))
+    => vCons(str(S), stringValues(SS))
+
+  // The left fold computed by the implementation's accumulator.
+  syntax IntSeq ::= concatenateFrom(IntSeq, StringList) [function, total]
+  rule concatenateFrom(A:IntSeq, emptyStrings) => A
+  rule concatenateFrom(A:IntSeq, moreStrings(S:IntSeq, SS:StringList))
+    => concatenateFrom(seqConcat(A, S), SS)
+
+  // These definitions are the literal terms emitted in solution.mpy. Naming
+  // them keeps the claims readable without introducing any semantic shortcut.
+  syntax Stmts ::= concatenateLoopBody [function, total]
+  rule concatenateLoopBody
+    => AugAssign(Name("result"), "+", Name("string")) .Stmts
+
+  syntax Stmts ::= concatenateBody [function, total]
+  rule concatenateBody
+    => Assign(Name("result"), Str(""))
+       For(Name("string"), Name("strings"), concatenateLoopBody)
+       Return(Name("result"))
+       .Stmts
+
+  syntax Module ::= concatenateModule [function, total]
+  rule concatenateModule
+    => Module(
+         ImportFrom("typing", "List")
+         FuncDef("concatenate", Params("strings"), concatenateBody)
+       )
+endmodule

