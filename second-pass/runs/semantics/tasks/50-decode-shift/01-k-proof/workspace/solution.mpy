Module(
  FuncDef("encode_shift", Params("s"),
    Expr(
      Str(
        "\n    returns encoded string by shifting every character by 5 in the alphabet.\n    "))
    Return(
      Call(
        Attribute(Str(""), "join"),
        ListComp(Call(
          Name("chr"),
          BinOp(
            "+",
            BinOp(
              "%",
              BinOp(
                "-",
                BinOp("+", Call(Name("ord"), Name("ch")), Int(5)),
                Call(Name("ord"), Str("a"))),
              Int(26)),
            Call(Name("ord"), Str("a")))),
          CompFor(Name("ch"), Name("s"), Bool(true))))))
  FuncDef("decode_shift", Params("s"),
    Expr(
      Str(
        "\n    takes as input string encoded with encode_shift function. Returns decoded string.\n    "))
    Assign(Name("result"), Str(""))
    Assign(Name("ch"), Str(""))
    For(Name("ch"), Name("s"),
      AugAssign(
        Name("result"),
        "+",
        Call(
          Name("chr"),
          BinOp(
            "+",
            BinOp(
              "%",
              BinOp(
                "-",
                BinOp("-", Call(Name("ord"), Name("ch")), Int(5)),
                Call(Name("ord"), Str("a"))),
              Int(26)),
            Call(Name("ord"), Str("a"))))))
    Return(Name("result"))))
