Module(
  FuncDef("encode_shift", Params("s"),
    Return(
      Call(
        Attribute(Str(""), "join"),
        ListComp(Call(
          Name("chr"),
          BinOp(
            "+",
            BinOp(
              "%",
              BinOp(
                "-",
                BinOp("+", Call(Name("ord"), Name("ch")), Int(5)),
                Call(Name("ord"), Str("a"))),
              Int(26)),
            Call(Name("ord"), Str("a")))),
          CompFor(Name("ch"), Name("s"), Bool(true))))))
  FuncDef("decode_shift", Params("s"),
    Assign(Name("result"), Str(""))
    Assign(Name("ch"), Str(""))
    For(Name("ch"), Name("s"),
      AugAssign(
        Name("result"),
        "+",
        Call(
          Name("chr"),
          BinOp(
            "+",
            BinOp(
              "%",
              BinOp(
                "-",
                BinOp("-", Call(Name("ord"), Name("ch")), Int(5)),
                Call(Name("ord"), Str("a"))),
              Int(26)),
            Call(Name("ord"), Str("a"))))))
    Return(Name("result")))
  Assert(
    Compare(Call(Name("decode_shift"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("decode_shift"), Str("mjqqt")),
      CmpOp("==", Str("hello"))))
  Assert(
    Compare(Call(Name("decode_shift"), Str("c")), CmpOp("==", Str("x"))))
  Assert(
    Compare(
      Call(Name("decode_shift"), Str("fghijklmnopqrstuvwxyzabcde")),
      CmpOp("==", Str("abcdefghijklmnopqrstuvwxyz")))))
