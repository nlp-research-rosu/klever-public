+      ~> KONT:K
+    =>
+      KONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "s" |-> str(ORIGINAL:IntSeq)
+        "result" |-> str(ACC:IntSeq)
+        "ch" |-> CH:Val,
+        parent(0))
+      0 |-> scope("decode_shift" |-> decodeClosure, parent(-1))
+      -1 |-> BUILTINS:Scope
+    =>
+      1 |-> scope(
+        "s" |-> str(ORIGINAL)
+        "result" |-> str(decodeAcc(ACC, CS))
+        "ch" |-> loopLast(CH, CS),
+        parent(0))
+      0 |-> scope("decode_shift" |-> decodeClosure, parent(-1))
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
