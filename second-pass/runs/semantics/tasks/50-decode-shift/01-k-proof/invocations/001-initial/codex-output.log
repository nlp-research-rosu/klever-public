+#!/usr/bin/env bash
+set -eu
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete_tests.mpy \
+  --definition runtime-kompiled \
+  --output pretty
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-base-kompiled
+
+kprove spec.k \
+  --definition verification-base-kompiled \
+  --claims SPEC.decode-loop \
+  --output pretty
+
+kprove spec.k \
+  --definition verification-base-kompiled \
+  --claims SPEC.char-inverse \
+  --output pretty
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION-WITH-LOOP \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --claims SPEC.decode-shift \
+  --output pretty
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..69c608c2a0f415d8da7dc5a993bb8545fa8d3326
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,16 @@
+def encode_shift(s: str):
+    """
+    returns encoded string by shifting every character by 5 in the alphabet.
+    """
+    return "".join([chr(((ord(ch) + 5 - ord("a")) % 26) + ord("a")) for ch in s])
+
+
+def decode_shift(s: str):
+    """
+    takes as input string encoded with encode_shift function. Returns decoded string.
+    """
+    result = ""
+    ch = ""
+    for ch in s:
+        result += chr(((ord(ch) - 5 - ord("a")) % 26) + ord("a"))
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..4df39f867e0ae0ad917b7cae7659ff0598aff99d
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,76 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant: the remaining loop updates result with precisely the
+  // mathematical decode, while ch has Python's usual final loop-variable value.
+  claim [decode-loop]:
+    <k>
+      #loop(str(CS:IntSeq), Name("ch"), decodeStep)
+      ~> KONT:K
+    =>
+      KONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "s" |-> str(ORIGINAL:IntSeq)
+        "result" |-> str(ACC:IntSeq)
+        "ch" |-> CH:Val,
+        parent(0))
+      0 |-> scope("decode_shift" |-> decodeClosure, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      1 |-> scope(
+        "s" |-> str(ORIGINAL)
+        "result" |-> str(decodeAcc(ACC, CS))
+        "ch" |-> loopLast(CH, CS),
+        parent(0))
+      0 |-> scope("decode_shift" |-> decodeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires lowerCodes(CS)
+
+  // The actual translated closure computes decodeCodes for every lowercase
+  // encoded string, from the ordinary module/builtins environment.
+  claim [decode-shift]:
+    <k> Call(Name("decode_shift"), str(CS:IntSeq)) => str(decodeCodes(CS)) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("decode_shift" |-> decodeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires lowerCodes(CS)
+
+  // Per-character inverse law for the prompt's supplied encoder.
+  claim [char-inverse]:
+    <k> decodeChar(encodeChar(C:Int)) => C </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 97 <=Int C andBool C <=Int 122
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..edd5742a24ea88f37bc071fb67d2b8143fc3685d
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,103 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The mathematical character transform implemented by decode_shift.
+  syntax Int ::= decodeChar(Int) [function, total]
+  rule decodeChar(C:Int) => pyMod(C -Int 5 -Int 97, 26) +Int 97
+
+  // Tail-recursive specification matching the program's left-to-right loop.
+  syntax IntSeq ::= decodeAcc(IntSeq, IntSeq) [function, total]
+                  | decodeCodes(IntSeq) [function, total]
+  rule decodeAcc(ACC:IntSeq, .IntSeq) => ACC
+  rule decodeAcc(ACC:IntSeq, iCons(C:Int, CS:IntSeq))
+    => decodeAcc(seqConcat(ACC, iCons(decodeChar(C), .IntSeq)), CS)
+  rule decodeCodes(CS:IntSeq) => decodeAcc(.IntSeq, CS)
+
+  syntax Val ::= loopLast(Val, IntSeq) [function, total]
+  rule loopLast(V:Val, .IntSeq) => V
+  rule loopLast(_:Val, iCons(C:Int, CS:IntSeq))
+    => loopLast(str(iCons(C, .IntSeq)), CS)
+
+  syntax Int ::= encodeChar(Int) [function, total]
+  rule encodeChar(C:Int) => pyMod(C +Int 5 -Int 97, 26) +Int 97
+
+  syntax Bool ::= lowerCodes(IntSeq) [function, total]
+  rule lowerCodes(.IntSeq) => true
+  rule lowerCodes(iCons(C:Int, CS:IntSeq))
+    => (97 <=Int C andBool C <=Int 122) andBool lowerCodes(CS)
+
+  // Macros reproduce the translated decode_shift body from solution.mpy.
+  syntax Stmt ::= "decodeStep" [macro]
+  rule decodeStep
+    => AugAssign(
+         Name("result"),
+         "+",
+         Call(
+           Name("chr"),
+           BinOp(
+             "+",
+             BinOp(
+               "%",
+               BinOp(
+                 "-",
+                 BinOp("-", Call(Name("ord"), Name("ch")), Int(5)),
+                 Call(Name("ord"), Str("a"))),
+               Int(26)),
+             Call(Name("ord"), Str("a")))))
+
+  syntax Stmts ::= "decodeBody" [macro]
+  rule decodeBody
+    => Expr(Str(
+         "\n    takes as input string encoded with encode_shift function. Returns decoded string.\n    "))
+       Assign(Name("result"), Str(""))
+       Assign(Name("ch"), Str(""))
+       For(Name("ch"), Name("s"), decodeStep)
+       Return(Name("result"))
+
+  syntax Val ::= "decodeClosure" [macro]
+  rule decodeClosure
+    => closureVal(("s", .ParamNames), decodeBody, 0)
+endmodule
+
+// This module promotes the independently proved decode-loop claim to a
+// high-priority lemma for the top-level function proof.
+module VERIFICATION-WITH-LOOP
+  imports VERIFICATION
+
+  rule [decode-loop-lemma]:
+    <k>
+      #loop(str(CS:IntSeq), Name("ch"), decodeStep)
+      ~> KONT:K
+    =>
+      KONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "s" |-> str(ORIGINAL:IntSeq)
+        "result" |-> str(ACC:IntSeq)
+        "ch" |-> CH:Val,
+        parent(0))
+      0 |-> scope("decode_shift" |-> decodeClosure, parent(-1))
+      -1 |-> BUILTINS:Scope
+    =>
+      1 |-> scope(
+        "s" |-> str(ORIGINAL)
+        "result" |-> str(decodeAcc(ACC, CS))
+        "ch" |-> loopLast(CH, CS),
+        parent(0))
+      0 |-> scope("decode_shift" |-> decodeClosure, parent(-1))
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires lowerCodes(CS)
+    [priority(40)]
+endmodule

exec
/bin/bash -lc "ls -la && wc -l solution.py solution.mpy verification.k spec.k prove.sh && test -x prove.sh && python3 py2mpy.py solution.py > /tmp/solution.check.mpy && cmp -s solution.mpy /tmp/solution.check.mpy && rg -n '"'^#Top$'"' <(./prove.sh 2>/tmp/prove-final.stderr) | wc -l" in /work
