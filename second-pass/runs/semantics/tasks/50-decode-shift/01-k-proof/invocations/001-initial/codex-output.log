+      -1 |-> builtinsScope
+    =>
+      1 |-> scope(
+        "s" |-> str(ORIGINAL)
+        "result" |-> str(decodeAcc(ACC, CS))
+        "ch" |-> loopLast(CH, CS),
+        parent(0))
+      0 |-> scope("decode_shift" |-> decodeClosure, parent(-1))
+      -1 |-> builtinsScope
