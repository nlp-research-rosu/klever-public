+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant: running the remaining loop and returning from the current
+  // function frame yields the mathematical decode of the accumulator and the
+  // remaining input. The callee frame is removed exactly as MPY-FUNCTIONS does.
+  claim [decode-loop]:
+    <k>
+      #loop(str(CS:IntSeq), Name("ch"), decodeStep)
+      ~> Return(Name("result"))
+      ~> #endcall
+    =>
+      str(decodeAcc(ACC, CS)) ~> CONT
+    </k>
+    <env> L:Int => CALLER:Int </env>
+    <scopes>
+      (L |-> scope(("result" |-> str(ACC:IntSeq)) M:Map, P:Parent)) REST:Map
+    =>
+      REST
+    </scopes>
+    <scopeLoc> LOC:Int => SAVED:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT:K, CALLER, SAVED)) STACK:List
+    =>
+      STACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires lowerCodes(CS)
+     andBool notBool (L in_keys(REST))
+     andBool notBool ("result" in_keys(M))
+
+  // The actual translated closure computes decodeCodes for every lowercase
+  // encoded string, from the ordinary module/builtins environment.
+  claim [decode-shift]:
+    <k> Call(Name("decode_shift"), str(CS:IntSeq)) => str(decodeCodes(CS)) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("decode_shift" |-> decodeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires lowerCodes(CS)
+
+  // Per-character inverse law for the prompt's supplied encoder.
+  claim [char-inverse]:
+    decodeChar(encodeChar(C:Int)) => C
+    requires 97 <=Int C andBool C <=Int 122
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0eabe15ff5007753c2cfa2a9577d5d21c7f92aa1
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,56 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The mathematical character transform implemented by decode_shift.
+  syntax Int ::= decodeChar(Int) [function, total]
+  rule decodeChar(C:Int) => pyMod(C -Int 5 -Int 97, 26) +Int 97
+
+  // Tail-recursive specification matching the program's left-to-right loop.
+  syntax IntSeq ::= decodeAcc(IntSeq, IntSeq) [function, total]
+                  | decodeCodes(IntSeq) [function, total]
+  rule decodeAcc(ACC:IntSeq, .IntSeq) => ACC
+  rule decodeAcc(ACC:IntSeq, iCons(C:Int, CS:IntSeq))
+    => decodeAcc(seqConcat(ACC, iCons(decodeChar(C), .IntSeq)), CS)
+  rule decodeCodes(CS:IntSeq) => decodeAcc(.IntSeq, CS)
+
+  syntax Int ::= encodeChar(Int) [function, total]
+  rule encodeChar(C:Int) => pyMod(C +Int 5 -Int 97, 26) +Int 97
+
+  syntax Bool ::= lowerCodes(IntSeq) [function, total]
+  rule lowerCodes(.IntSeq) => true
+  rule lowerCodes(iCons(C:Int, CS:IntSeq))
+    => (97 <=Int C andBool C <=Int 122) andBool lowerCodes(CS)
+
+  // Macros reproduce the translated decode_shift body from solution.mpy.
+  syntax Stmt ::= "decodeStep" [macro]
+  rule decodeStep
+    => AugAssign(
+         Name("result"),
+         "+",
+         Call(
+           Name("chr"),
+           BinOp(
+             "+",
+             BinOp(
+               "%",
+               BinOp(
+                 "-",
+                 BinOp("-", Call(Name("ord"), Name("ch")), Int(5)),
+                 Call(Name("ord"), Str("a"))),
+               Int(26)),
+             Call(Name("ord"), Str("a")))))
+
+  syntax Stmts ::= "decodeBody" [macro]
+  rule decodeBody
+    => Expr(Str(
+         "\n    takes as input string encoded with encode_shift function. Returns decoded string.\n    "))
+       Assign(Name("result"), Str(""))
+       For(Name("ch"), Name("s"), decodeStep)
+       Return(Name("result"))
+
+  syntax Val ::= "decodeClosure" [macro]
+  rule decodeClosure
+    => closureVal(("s", .ParamNames), decodeBody, 0)
+endmodule

