+            assert isinstance(item, dict), (path, number)
+            event_counts[str(item.get("type"))] += 1
+            payload = item.get("payload")
+            if isinstance(payload, dict):
+                payload_counts[str(payload.get("type"))] += 1
+            trace_lines += 1
+
