index 0000000000000000000000000000000000000000..e06fdb8ab1c89c694671e8b2beb1166229f260b8
--- /dev/null
+++ b/evidence/stage2_translation.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
