           raise Unsupported(f\"AugAssign {type(node.op).__name__}\")\n        return Ctor(\"AugAssign\", emit_expr(node.target), q(op), emit_expr(node.value))\n\n    if isinstance(node, ast.If):\n        return Ctor(\"If\", emit_expr(node.test),\n                    emit_stmts(node.body), emit_stmts(node.orelse))\n\n    if isinstance(node, ast.For):\n        if node.orelse:\n            raise Unsupported(\"for-else\")\n        return Ctor(\"For\", emit_expr(node.target), emit_expr(node.iter),\n                    emit_stmts(node.body))\n\n    if isinstance(node, ast.While):\n        if node.orelse:\n            raise Unsupported(\"while-else\")\n        return Ctor(\"While\", emit_expr(node.test), emit_stmts(node.body))\n\n    if isinstance(node, ast.Break):\n        return \"Break\"\n    if isinstance(node, ast.Continue):\n        return \"Continue\"\n    if isinstance(node, ast.Pass):\n        return \"Pass\"\n\n    if isinstance(node, ast.Assert):\n        if node.msg is not None:\n            return Ctor(\"Assert\", emit_expr(node.test), emit_expr(node.msg))\n        return Ctor(\"Assert\", emit_expr(node.test))\n\n    if isinstance(node, ast.Expr):\n        return Ctor(\"Expr\", emit_expr(node.value))\n\n    if isinstance(node, ast.Import):\n        return Ctor(\"Import\", *(q(n.name) for n in node.names))\n    if isinstance(node, ast.ImportFrom):\n        mod = node.module if node.module is not None else \"\"\n        return Ctor(\"ImportFrom\", q(mod), *(q(n.name) for n in node.names))\n\n    raise Unsupported(f\"Stmt {type(node).__name__}\")\n\n\ndef emit_stmts(stmts) -> Seq:\n    return Seq([emit_stmt(s) for s in stmts])\n\n\ndef emit_module(tree: ast.Module) -> Ctor:\n    return Ctor(\"Module\", emit_stmts(tree.body))\n\n\n# ---------------------------------------------------------------------------\n# Lisp-style pretty printer\n# ---------------------------------------------------------------------------\nWIDTH = 72  # an expression constructor wider than this breaks onto its own lines\n\n\ndef render(node, ind: int = 0) -> str:\n    if isinstance(node, str):\n        return node\n\n    if isinstance(node, Seq):\n        if not node.items:\n            return \"\"\n        pad = \"  \" * ind\n        return (\"\\n\" + pad).join(render(it, ind) for it in node.items)\n\n    # Ctor\n    cind = ind + 1\n    cpad = \"  \" * cind\n    has_block = any(isinstance(a, Seq) for a in node.args)\n\n    if not has_block:\n        inline = node.name + \"(\" + \", \".join(render(a, ind) for a in node.args) + \")\"\n        if \"\\n\" not in inline and len(\"  \" * ind) + len(inline) <= WIDTH:\n            return inline\n        parts = [render(a, cind) for a in node.args]\n        return node.name + \"(\\n\" + cpad + (\",\\n\" + cpad).join(parts) + \")\"\n\n    # Has a statement block: inline the args before the first block, then put\n    # each remaining arg (blocks included) on its own indented line.\n    first = next(i for i, a in enumerate(node.args) if isinstance(a, Seq))\n    head = node.args[:first]\n    rest = node.args[first:]\n    open_line = node.name + \"(\" + \", \".join(render(a, ind) for a in head) + (\",\" if head else \"\")\n    lines = []\n    for k, a in enumerate(rest):\n        comma = \",\" if k < len(rest) - 1 else \"\"\n        lines.append(cpad + render(a, cind) + comma)\n    return open_line + \"\\n\" + \"\\n\".join(lines) + \")\"\n\n\n# ---------------------------------------------------------------------------\n# CLI\n# ---------------------------------------------------------------------------\ndef main(argv=None) -> int:\n    ap = argparse.ArgumentParser(\n        prog=\"py2mpy\",\n        description=\"Pure CPython-AST -> K-constructor transliterator.\",\n    )\n    ap.add_argument(\"file\", help=\"Python source file\")\n    ap.add_argument(\"--ast\", action=\"store_true\",\n                    help=\"print the Python AST (ast.dump) instead of the .mpy term\")\n    args = ap.parse_args(argv)\n\n    with open(args.file, \"r\", encoding=\"utf-8\") as fh:\n        src = fh.read()\n    tree = ast.parse(src, filename=args.file)\n    _walk_symtable(symtable.symtable(src, args.file, \"exec\"))\n\n    if args.ast:\n        print(ast.dump(tree, indent=2))\n    else:\n        print(render(emit_module(tree)))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n// reference/src/semantics.k — the supplied `.mpy` semantics, ASSEMBLED.\n//\n//   kompile reference-semantics/semantics.k --backend llvm \\\n//     --main-module MPY-KRUN --syntax-module MPY-SYNTAX \\\n//     --output-definition runtime-kompiled\n//\n// Concrete-only legs are included through MPY-KRUN. Proof definitions import\n// MPY and any explicit proof extensions supplied by the task author.\n//\n// Files (dependency order — everything imports MPY-CORE):\n//   semantics/syntax.k         MPY-SYNTAX       AST productions\n//   semantics/core.k           MPY-CORE         values, config, load, lookup, shared helpers   [required]\n//   semantics/iter.k           MPY-ITER         the iterator protocol (#iterNext/#iterYield/#iterDone) decl\n//   semantics/range.k          MPY-RANGE        rangeObj: inRange / rangeLen / its #iterNext\n//   semantics/operators.k      MPY-OPERATORS    operator DISPATCH (UnaryOp/BinOp/Compare/BoolOp) — domain files own the cases\n//   semantics/int.k            MPY-INT          Int operator cases; floored // and % (pyMod)\n//   semantics/bool.k           MPY-BOOL         Bool operator cases + truthy not/and/or (BoolOp)\n//   semantics/float.k          MPY-FLOAT        Float Val: literal + opaque float ops ([concrete] for krun)\n//   semantics/str.k            MPY-STR          str(IntSeq): literal, +, ==, in\n//   semantics/set.k            MPY-SET          set(str): distinct char codes (len / membership)\n//   semantics/list.k           MPY-LIST         ListExpr, list(ValSeq): +, ==, in\n//   semantics/tuple.k          MPY-TUPLE        TupleExpr, tuple ==, target-binding + unpacking\n//   semantics/subscript.k      MPY-SUBSCRIPT    Subscript indexing + Slice\n//   semantics/comprehension.k  MPY-COMPREHENSION  list comprehensions [ELT for T in ITER if COND]\n//   semantics/methods.k        MPY-METHODS      pure str methods: is*/lower/upper/swapcase/startswith\n//   semantics/controls.k       MPY-CONTROLS     Assign/AugAssign, If, IfExp, For, While, break/continue\n//   semantics/functions.k      MPY-FUNCTIONS    def / call / return (frame stack)\n//   semantics/builtins.k       MPY-BUILTINS     builtins as calls: len/sum/abs/min/max/ord/chr/str\n//   semantics/call.k           MPY-CALL         ALL Call routing + argument evaluation\n//   semantics/sort.k           MPY-SORT         trusted sorted(): opaque sortVS + concrete insertion sort\n//   semantics/assert.k         MPY-ASSERT       Assert oracle (smoke programs only)\n//   semantics/dict.k           MPY-DICT         order-preserving dictV(KS,VS) + .keys() + list()\n\nrequires \"semantics/syntax.k\"\nrequires \"semantics/core.k\"\nrequires \"semantics/iter.k\"\nrequires \"semantics/range.k\"\nrequires \"semantics/operators.k\"\nrequires \"semantics/int.k\"\nrequires \"semantics/bool.k\"\nrequires \"semantics/float.k\"\nrequires \"semantics/str.k\"\nrequires \"semantics/set.k\"\nrequires \"semantics/list.k\"\nrequires \"semantics/tuple.k\"\nrequires \"semantics/subscript.k\"\nrequires \"semantics/comprehension.k\"\nrequires \"semantics/methods.k\"\nrequires \"semantics/controls.k\"\nrequires \"semantics/functions.k\"\nrequires \"semantics/builtins.k\"\nrequires \"semantics/call.k\"\nrequires \"semantics/sort.k\"\nrequires \"semantics/assert.k\"\nrequires \"semantics/dict.k\"\nrequires \"semantics/concrete.k\"\n\nmodule MPY\n  imports MPY-CORE\n  imports MPY-ITER\n  imports MPY-RANGE\n  imports MPY-OPERATORS\n  imports MPY-INT\n  imports MPY-BOOL\n  imports MPY-FLOAT\n  imports MPY-STR\n  imports MPY-SET\n  imports MPY-LIST\n  imports MPY-TUPLE\n  imports MPY-SUBSCRIPT\n  import