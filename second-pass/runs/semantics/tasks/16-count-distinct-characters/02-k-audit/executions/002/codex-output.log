diff --git a//tmp/audit-work/count-distinct-audit/reconstruction/spec-vacuity.k b//tmp/audit-work/count-distinct-audit/reconstruction/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..a6863c703219bb3ffd8f480158ce2d1c884abc3c
--- /dev/null
+++ b//tmp/audit-work/count-distinct-audit/reconstruction/spec-vacuity.k
@@ -0,0 +1,25 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: for CS = .IntSeq the implementation returns 0, not 1.
+  claim
+    <k>
+      #callCountDistinct(CS:IntSeq)
+      =>
+      isLen(dedupCodes(mapLower(CS))) +Int 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
