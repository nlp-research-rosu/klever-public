diff --git a//tmp/audit-work/count-distinct-audit/reconstruction/spec-call-only.k b//tmp/audit-work/count-distinct-audit/reconstruction/spec-call-only.k
new file mode 100644
index 0000000000000000000000000000000000000000..03b3ebb283ceac9e41072ec6a04646966622a260
--- /dev/null
+++ b//tmp/audit-work/count-distinct-audit/reconstruction/spec-call-only.k
@@ -0,0 +1,24 @@
+requires "verification.k"
