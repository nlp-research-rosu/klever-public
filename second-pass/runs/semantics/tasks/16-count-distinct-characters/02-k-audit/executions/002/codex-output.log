/bin/bash -lc "python3 - <<'PY'
from hashlib import sha256
from pathlib import Path
for root in [Path('/reference/reference-semantics'), Path('/candidate'), Path('/generation-evidence/codex-trace')]:
    files=sorted(p for p in root.rglob('*') if p.is_file())
    print(root)
    variants={
      'content': sha256(),
      'rel+content': sha256(),
      'rel0content0': sha256(),
      'hashlines': sha256(),
      'relhash': sha256(),
    }
    for p in files:
      rel=p.relative_to(root).as_posix().encode()
      data=p.read_bytes()
      h=sha256(data).hexdigest().encode()
      variants['content'].update(data)
      variants['rel+content'].update(rel+data)
      variants['rel0content0'].update(rel+b'\\0'+data+b'\\0')
      variants['hashlines'].update(h+b'  '+rel+b'\\n')
      variants['relhash'].update(rel+b'\\0'+h+b'\\n')
    for k,v in variants.items(): print(k,v.hexdigest())
