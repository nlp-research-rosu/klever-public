+requires "verification.k"
+
+module SPEC-CALL-ONLY
+  imports VERIFICATION
+
+  claim
+    <k>
+      #callCountDistinct(CS:IntSeq)
+      =>
+      isLen(dedupCodes(mapLower(CS)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
