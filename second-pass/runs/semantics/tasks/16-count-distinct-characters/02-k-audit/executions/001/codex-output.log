def count_distinct_characters(string: str) -> int:
    return len(set(string.lower()))


assert count_distinct_characters("") == 0
assert count_distinct_characters("xyzXYZ") == 3
assert count_distinct_characters("Jerry") == 4
assert count_distinct_characters("AaBbCcAa") == 3
assert count_distinct_characters("123!123!") == 4
Module(
  FuncDef("count_distinct_characters", Params("string"),
    Return(
      Call(
        Name("len"),
        Call(Name("set"), Call(Attribute(Name("string"), "lower"), )))))
  Assert(
    Compare(
      Call(Name("count_distinct_characters"), Str("")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("count_distinct_characters"), Str("xyzXYZ")),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("count_distinct_characters"), Str("Jerry")),
      CmpOp("==", Int(4))))
  Assert(
    Compare(
      Call(Name("count_distinct_characters"), Str("AaBbCcAa")),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("count_distinct_characters"), Str("123!123!")),
      CmpOp("==", Int(4)))))
