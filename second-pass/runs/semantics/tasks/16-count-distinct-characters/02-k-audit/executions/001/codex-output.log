+requires "fixed-only.k"
+
+module SPEC-END-TO-END-AUDIT
+  imports FIXED-ONLY
+
+  // Audit-only connection theorem: exact submitted Module/FuncDef, followed
+  // by ordinary Name lookup and Call under only the fixed supplied semantics.
+  claim
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "count_distinct_characters",
+            Params("string"),
+            Return(
+              Call(
+                Name("len"),
+                Call(
+                  Name("set"),
+                  Call(Attribute(Name("string"), "lower"), .Exprs)))))))
+      ~> Call(Name("count_distinct_characters"), (str(CS:IntSeq), .Exprs))
+      =>
+      isLen(dedupCodes(mapLower(CS)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+        ("count_distinct_characters"
+          |-> closureVal(
+            ("string", .ParamNames),
+            Return(
+              Call(
+                Name("len"),
+                Call(
+                  Name("set"),
+                  Call(Attribute(Name("string"), "lower"), .Exprs))))
+            .Stmts,
+            0)),
+        parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/candidate-src/spec-ground-witnesses.k b//tmp/audit-work/candidate-src/spec-ground-witnesses.k
new file mode 100644
index 0000000000000000000000000000000000000000..aff9953b96dbac0b7663da69651e0a44c5fff8a7
--- /dev/null
+++ b//tmp/audit-work/candidate-src/spec-ground-witnesses.k
@@ -0,0 +1,55 @@
+requires "verification.k"
+
+module SPEC-GROUND-WITNESSES
+  imports VERIFICATION
+
+  claim
+    <k> #callCountDistinct(.IntSeq) => 0 </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim
+    <k>
