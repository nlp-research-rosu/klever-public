diff --git a//tmp/audit-work/candidate-src/spec-end-to-end-audit.k b//tmp/audit-work/candidate-src/spec-end-to-end-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..22aaa2179116fc0e869d07046c30c5f811970e6b
--- /dev/null
+++ b//tmp/audit-work/candidate-src/spec-end-to-end-audit.k
@@ -0,0 +1,52 @@
+requires "fixed-only.k"
+
+module SPEC-END-TO-END-AUDIT
+  imports FIXED-ONLY
+
+  // Audit-only connection theorem: exact submitted Module/FuncDef, followed
+  // by ordinary Name lookup and Call under only the fixed supplied semantics.
+  claim
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "count_distinct_characters",
+            Params("string"),
+            Return(
+              Call(
+                Name("len"),
+                Call(
+                  Name("set"),
+                  Call(Attribute(Name("string"), "lower"), .Exprs)))))))
+      ~> Call(Name("count_distinct_characters"), (str(CS:IntSeq), .Exprs))
+      =>
+      isLen(dedupCodes(mapLower(CS)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+        ("count_distinct_characters"
+          |-> closureVal(
+            ("string", .ParamNames),
+            Return(
+              Call(
+                Name("len"),
+                Call(
+                  Name("set"),
+                  Call(Attribute(Name("string"), "lower"), .Exprs))))
+            .Stmts,
+            0)),
+        parent(-1)))
