     1	requires "reference-semantics/semantics.k"
     2	
     3	module CHOOSE-NUM-VERIFICATION
     4	  imports MPY
     5	
     6	  // This is the exact function body emitted in solution.mpy, packaged as a
     7	  // callable closure so that claims can supply symbolic integer arguments.
     8	  syntax KItem ::= "#chooseNum" "(" Int "," Int ")"
     9	
    10	  // Mathematical contract: remove the parity remainder from Y to obtain the
    11	  // greatest even integer at or below it, then test interval membership.
    12	  syntax Int ::= largestEvenInRange(Int, Int) [function, total]
    13	  rule largestEvenInRange(X:Int, Y:Int)
    14	    => #if X <=Int Y -Int pyMod(Y, 2)
    15	       #then Y -Int pyMod(Y, 2)
    16	       #else -1
    17	       #fi
    18	
    19	  rule <k> #chooseNum(X:Int, Y:Int)
    20	        => Call(
    21	             closureVal(
    22	               ("x", "y"),
    23	               If(
    24	                 Compare(BinOp("%", Name("y"), Int(2)), CmpOp("==", Int(0))),
    25	                 If(
    26	                   Compare(Name("y"), CmpOp(">=", Name("x"))),
    27	                   Return(Name("y")),
    28	                   .Stmts)
    29	                 Return(UnaryOp("-", Int(1))),
    30	                 .Stmts)
    31	               If(
    32	                 Compare(
    33	                   BinOp("-", Name("y"), Int(1)),
    34	                   CmpOp(">=", Name("x"))),
    35	                 Return(BinOp("-", Name("y"), Int(1))),
    36	                 .Stmts)
    37	               Return(UnaryOp("-", Int(1))),
    38	               0),
    39	             X, Y)
    40	        ... </k>
    41	endmodule
+ nl -ba /reference/k-proof/solution.py
     1	def choose_num(x, y):
     2	    if y % 2 == 0:
     3	        if y >= x:
     4	            return y
     5	        return -1
     6	    if y - 1 >= x:
     7	        return y - 1
     8	    return -1
