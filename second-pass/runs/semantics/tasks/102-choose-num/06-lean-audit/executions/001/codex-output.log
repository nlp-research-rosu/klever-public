+
+    failures = [name for name, item in checks.items() if not item["match"]]
+    print(
+        json.dumps(
+            {
+                "schema_version": 1,
+                "checks": checks,
+                "failure_count": len(failures),
+                "failures": failures,
+            },
+            indent=2,
+            sort_keys=True,
+        )
+    )
+    return 1 if failures else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
