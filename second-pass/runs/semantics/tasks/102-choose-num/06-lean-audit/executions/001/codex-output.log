+#!/usr/bin/env python3
+"""Boundary and counterfactual checks supporting the semantic classification."""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+
+
+solution_path = Path("/reference/k-proof/solution.py")
+spec = importlib.util.spec_from_file_location("frozen_solution", solution_path)
+assert spec is not None and spec.loader is not None
+module = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(module)
+
+
+def summary(x: int, y: int) -> int:
+    upper = y - (y % 2)
+    return upper if x <= upper else -1
+
+
+def parity_flipped_mutant(x: int, y: int) -> int:
+    if y % 2 == 1:
+        if y >= x:
+            return y
+        return -1
+    if y - 1 >= x:
+        return y - 1
+    return -1
+
+
+cases = [
+    (12, 15),
+    (13, 12),
+    (2, 2),
+    (3, 3),
+    (4, 5),
+    (5, 5),
+    (6, 5),
+    (1, 1),
+    (1, 2),
+    (1, 3),
+    (99, 100),
+    (101, 100),
+]
+results = [
+    {
+        "x": x,
+        "y": y,
+        "source": module.choose_num(x, y),
+        "summary": summary(x, y),
+        "match": module.choose_num(x, y) == summary(x, y),
+        "parity_flipped_mutant": parity_flipped_mutant(x, y),
+        "mutant_differs": (
+            parity_flipped_mutant(x, y) != module.choose_num(x, y)
+        ),
+    }
+    for x, y in cases
+]
+failures = [item for item in results if not item["match"]]
+mutant_witnesses = [item for item in results if item["mutant_differs"]]
+print(
+    json.dumps(
+        {
+            "cases": results,
+            "all_source_summary_matches": not failures,
+            "counterfactual_mutant_witness_count": len(mutant_witnesses),
+            "counterfactual_mutant_witnesses": mutant_witnesses,
+        },
+        indent=2,
+        sort_keys=True,
+    )
+)
+raise SystemExit(1 if failures or not mutant_witnesses else 0)
