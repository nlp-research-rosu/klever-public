+    check("generator.toolchain", generator["toolchain"], lock)
+    check(
+        "generator.generated_tree_sha256",
+        generator["generated_tree_sha256"],
+        generated_hash,
+    )
+    check(
+        "generator.stage1_workspace_sha256",
