+    )
+    check(
+        "input_manifest.verification_sha256",
+        input_manifest["verification_sha256"],
+        sha256_file(K_WORKSPACE / "verification.k"),
+    )
+    check(
+        "export_result.frozen_input_sha256",
+        export_result["frozen_input_sha256"],
