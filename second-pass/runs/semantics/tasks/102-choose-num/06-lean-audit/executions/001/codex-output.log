+        stage6_resolution_contract.canonical_json_sha256(resolution),
+        resolved_digest,
+    )
+    check("AUDIT_MODE", os.environ.get("AUDIT_MODE"), resolution["mode"])
+    check("problem_id", resolution["problem_id"], "102-choose-num")
