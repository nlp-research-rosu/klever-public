+        sha256_file(GENERATION / "trust-inventory.json"),
+    )
+    check(
+        "generator.obligation_map_sha256",
+        generator["obligation_map_sha256"],
+        sha256_file(GENERATED / "obligation-map.json"),
+    )
+
+    check(
+        "audit_input.stage4_preflight",
