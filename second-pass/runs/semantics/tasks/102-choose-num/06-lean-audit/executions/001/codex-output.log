diff --git a/evidence/proc_pid_shim.c b/evidence/proc_pid_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..a6711fd4acb097c47cb8d1899e28d2b6cacbc934
--- /dev/null
+++ b/evidence/proc_pid_shim.c
@@ -0,0 +1,37 @@
+/*
+ * Audit-container compatibility shim.
+ *
+ * The sandbox reports a namespace PID from getpid(), while its /proc mount
+ * exposes only host PIDs. Lean 4.22 resolves its executable by reading
+ * /proc/<getpid()>/exe, so it fails before elaboration. /proc/self remains
+ * correct; return that visible numeric PID to make Lean's readlink coherent.
+ */
+#define _GNU_SOURCE
+
+#include <errno.h>
+#include <limits.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+    char target[64];
+    ssize_t length = readlink("/proc/self", target, sizeof(target) - 1);
+    if (length <= 0 || length >= (ssize_t)sizeof(target)) {
+        return (pid_t)-1;
+    }
+    target[length] = '\0';
+    errno = 0;
+    char *end = NULL;
+    long value = strtol(target, &end, 10);
+    if (
+        errno != 0
+        || end == target
+        || *end != '\0'
+        || value <= 0
+        || value > INT_MAX
+    ) {
+        return (pid_t)-1;
+    }
+    return (pid_t)value;
+}
