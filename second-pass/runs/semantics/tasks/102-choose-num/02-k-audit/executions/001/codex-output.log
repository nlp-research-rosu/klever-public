+#!/usr/bin/env bash
+set +e
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+}
+
+printf 'Stage 1 provenance and supplied-semantics integrity\n'
+run ls -la /candidate
+
