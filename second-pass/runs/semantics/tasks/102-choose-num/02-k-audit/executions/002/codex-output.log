#!/usr/bin/env python3
"""Canonical lexical inventory of simplification rules in verification.k."""

from __future__ import annotations

import dataclasses
import hashlib
import json
import re
import stat
from dataclasses import dataclass
from pathlib import Path
from typing import Any


_MODULE_NAME_RE = re.compile(
    r"^[ \t]+(?P<name>[A-Za-z][A-Za-z0-9_-]*)"
    r"(?:[ \t]+\[[^\]\r\n]*\])?[ \t]*$"
)
_TRAILING_ATTRIBUTES_RE = re.compile(
    r"\[(?P<attributes>[^\[\]]*)\][ \t\r\n]*\Z", re.S
)
_CELL_TAG_RE = re.compile(
    r"<(?P<close>/)?(?P<name>[A-Za-z][A-Za-z0-9_'-]*)"
    r"[ \t]*(?P<self_close>/)?>"
)
_OUTER_SENTENCE_KEYWORDS = {
    "imports",
    "syntax",
    "rule",
    "configuration",
    "context",
    "claim",
    "alias",
}


class KRuleInventoryError(RuntimeError):
    """Raised when verification.k cannot produce a canonical inventory."""


@dataclass(frozen=True)
class KRule:
    source_rule_id: str
    start_line: int
    end_line: int
    normalized_sha256: str
    attributes: list[str]
    text: str


@dataclass(frozen=True)
class _Sentence:
    keyword: str
    start: int


@dataclass(frozen=True)
class _Module:
    name: str
    content_start: int
    content_end: int
    sentences: tuple[_Sentence, ...]


@dataclass(frozen=True)
class _RuleSpan:
    rule: KRule
    start_offset: int
    end_offset: int
    attribute_start: int
    attribute_end: int


def canonical_json_sha256(document: Any) -> str:
    encoded = json.dumps(
        document,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
    ).encode()
    return hashlib.sha256(encoded).hexdigest()


def _mask_non_code(text: str) -> str:
    """Mask comments and string bodies without changing source offsets."""

    output = list(text)
    index = 0
    block_depth = 0
    state = "code"
    while index < len(text):
        character = text[index]
        following = text[index + 1] if index + 1 < len(text) else ""
        if state == "line-comment":
            if character in "\r\n":
                state = "code"
            else:
                output[index] = " "
            index += 1
            continue
        if state == "string":
            if character == "\\" and following:
                output[index] = " "
                output[index + 1] = " "
                index += 2
                continue
            if character == '"':
                state = "code"
            elif character not in "\r\n":
                output[index] = " "
            index += 1
            continue
        if state == "block-comment":
            if character == "/" and following == "*":
                output[index] = output[index + 1] = " "
                block_depth += 1
                index += 2
                continue
            if character == "*" and following == "/":
                output[index] = output[index + 1] = " "
                block_depth -= 1
                index += 2
                if block_depth == 0:
                    state = "code"
                continue
            if character not in "\r\n":
                output[index] = " "
            index += 1
            continue
        if character == "/" and following == "/":
            output[index] = output[index + 1] = " "
            state = "line-comment"
            index += 2
            continue
        if character == "/" and following == "*":
            output[index] = output[index + 1] = " "
            state = "block-comment"
            block_depth = 1
            index += 2
            continue
        if character == '"':
            state = "string"
        index += 1
    return "".join(output)


def _line_ranges(text: str, start: int = 0) -> list[tuple[int, int, int]]:
    ranges: list[tuple[int, int, int]] = []
    line_start = start
    while line_start < len(text):
        newline = text.find("\n", line_start)
        next_start = len(text) if newline < 0 else newline + 1
        line_end = len(text) if newline < 0 else newline
        content_end = (
            line_end - 1
            if line_end > line_start and text[line_end - 1] == "\r"
            else line_end
        )
        ranges.append((line_start, content_end, next_start))
        if newline < 0:
            break
        line_start = next_start
    return ranges


def _line_heads(text: str) -> list[tuple[int, int, str, str]]:
    """Return physical-line word heads without assigning K grammar meaning."""

    heads: list[tuple[int, int, str, str]] = []
    for line_start, content_end, _next_start in _line_ranges(text):
        index = line_start
        while index < content_end and text[index] in " \t":
            index += 1
        word_end = index
        while word_end < content_end and (
            text[word_end].isalnum() or text[word_end] in "_'"
        ):
            word_end += 1
        if word_end > index:
            heads.append(
                (
                    line_start,
                    content_end,
                    text[index:word_end],
                    text[word_end:content_end],
                )
            )
    return heads


def _line_word(line: str) -> tuple[str, str, int]:
    stripped = line.lstrip()
    indent = len(line) - len(stripped)
    word_end = 0
    while word_end < len(stripped) and (
        stripped[word_end].isalnum() or stripped[word_end] in "_'"
    ):
        word_end += 1
    return stripped[:word_end], stripped[word_end:], indent + word_end


def _rule_continuation(line: str) -> tuple[str, int] | None:
    stripped = line.lstrip()
    if stripped.startswith("["):
        return "attributes", len(line) - len(stripped)
    word, rest, word_end = _line_word(line)
    for keyword in ("requires", "ensures"):
        if word == keyword and (
            not rest
            or not (
                rest[0].isalnum()
                or rest[0] in "_'"
            )
        ):
            return keyword, word_end
    return None


def _starts_outer_transition(line: str) -> bool:
    keyword, rest, _word_end = _line_word(line)
    separated = bool(rest) and rest[0] in " \t"
    if keyword == "module":
        return separated and _MODULE_NAME_RE.fullmatch(rest) is not None
    if keyword == "endmodule":
        return not rest.strip()
    if keyword == "rule":
        return separated
    return keyword in _OUTER_SENTENCE_KEYWORDS and separated


def _terminal_attribute_line(line: str) -> bool:
    match = _TRAILING_ATTRIBUTES_RE.search(line)
    if match is None:
        return False
    start = match.start()
    return start == 0 or line[start - 1].isspace()


def _scan_rule_delimiters(
    line: str,
    delimiters: list[str],
) -> None:
    closing = {")": "(", "]": "[", "}": "{"}
    index = 0
    while index < len(line):
        if line[index] == "<":
            cell = _CELL_TAG_RE.match(line, index)
            if cell is not None:
                marker = f"<{cell.group('name')}>"
                if cell.group("close"):
                    if delimiters and delimiters[-1] == marker:
                        delimiters.pop()
                elif not cell.group("self_close"):
                    delimiters.append(marker)
                index = cell.end()
                continue
        character = line[index]
        if character in "([{":
            delimiters.append(character)
        elif character in closing:
            if delimiters and delimiters[-1] == closing[character]:
                delimiters.pop()
        index += 1


def _rule_bubble_end(masked_text: str, start: int) -> int:
    """Find when an outer rule bubble returns control to outer parsing."""

    seen_rewrite = False
    clause_has_content = False
    candidate_end: int | None = None
    delimiters: list[str] = []
    ranges = _line_ranges(masked_text, start)
    for line_start, line_end, next_start in ranges:
        line = masked_text[line_start:line_end]
        if not line.strip():
            continue

        continuation = (
            _rule_continuation(line)
            if seen_rewrite and candidate_end is not None
            else None
        )
        if candidate_end is not None:
            if continuation is None and _starts_outer_transition(line):
                return candidate_end
            candidate_end = None

        content_start = 0
        if continuation is not None:
            kind, content_start = continuation
            if kind in {"requires", "ensures"}:
                clause_has_content = False

        if not seen_rewrite:
            rewrite = line.find("=>")
            if rewrite >= 0:
                seen_rewrite = True
                content_start = rewrite + 2
            else:
                content_start = len(line)

        _scan_rule_delimiters(line, delimiters)
        if seen_rewrite and line[content_start:].strip():
            clause_has_content = True

        if (
            seen_rewrite
            and clause_has_content
            and not delimiters
            and _terminal_attribute_line(line)
        ):
            return next_start
        if seen_rewrite and clause_has_content and not delimiters:
            candidate_end = next_start
    if candidate_end is not None:
        return candidate_end
    return len(masked_text) + 1


def _verification_module(masked_text: str) -> _Module:
    modules: list[_Module] = []
    open_module: tuple[str, int, list[_Sentence]] | None = None
    open_rule_until = 0
    for line_start, line_end, keyword, rest in _line_heads(masked_text):
        if line_start < open_rule_until:
            continue
        open_rule_until = 0
        separated = bool(rest) and rest[0] in " \t"
        if keyword == "module":
            if not separated:
                raise KRuleInventoryError(
                    "verification.k has malformed module boundaries"
                )
            named = _MODULE_NAME_RE.fullmatch(rest)
            if named is None or open_module is not None:
                raise KRuleInventoryError(
                    "verification.k has malformed module boundaries"
                )
            open_module = (named.group("name"), line_end, [])
            continue
        if keyword == "endmodule":
            if rest.strip():
                raise KRuleInventoryError(
                    "verification.k has malformed module boundaries"
                )
            if open_module is None:
                raise KRuleInventoryError(
                    "verification.k has malformed module boundaries"
                )
            name, content_start, sentences = open_module
            modules.append(
                _Module(
                    name=name,
                    content_start=content_start,
                    content_end=line_start,
                    sentences=tuple(sentences),
                )
            )

diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..3e17e72eaf373ecf0fd44f1d57e82eda98598a47
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""Independent differential test for HumanEval/102 over positive integers."""
+
+import importlib.util
+import random
+from pathlib import Path
+
+
+def load_entry(path: str, module_name: str):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.choose_num
+
+
+canonical = load_entry("/reference/canonical.py", "trusted_canonical_102")
+generated = load_entry("/tmp/audit-work/solution.py", "generated_solution_102")
+
+# Prompt examples, smallest positive endpoint, singleton intervals, reversed
+# intervals, and every implementation branch boundary.
+documented_and_boundaries = [
+    (12, 15),
+    (13, 12),
+    (1, 1),
+    (1, 2),
+    (2, 1),
+    (2, 2),
+    (3, 3),
+    (2, 3),
+    (3, 4),
+    (4, 3),
+    (4, 4),
+    (5, 6),
+    (6, 5),
+    (999_999, 1_000_000),
+    (1_000_000, 999_999),
+]
+
+inputs = list(documented_and_boundaries)
+inputs.extend((x, y) for x in range(1, 201) for y in range(1, 201))
+rng = random.Random(102)
+inputs.extend(
+    (rng.randint(1, 10**12), rng.randint(1, 10**12))
+    for _ in range(5_000)
+)
+
+mismatches = []
+branch_counts = {
+    "even_y_in_range": 0,
+    "even_y_before_range": 0,
+    "odd_predecessor_in_range": 0,
+    "odd_no_even_in_range": 0,
+}
+for x, y in inputs:
+    expected = canonical(x, y)
+    actual = generated(x, y)
+    if y % 2 == 0 and y >= x:
+        branch_counts["even_y_in_range"] += 1
+    elif y % 2 == 0:
+        branch_counts["even_y_before_range"] += 1
+    elif y - 1 >= x:
+        branch_counts["odd_predecessor_in_range"] += 1
+    else:
+        branch_counts["odd_no_even_in_range"] += 1
+    if actual != expected:
+        mismatches.append((x, y, expected, actual))
+
+print("documented_and_boundary_inputs", documented_and_boundaries)
+print("total_inputs", len(inputs))
+print("branch_counts", branch_counts)
+print("mismatch_count", len(mismatches))
+if mismatches:
+    print("first_mismatches", mismatches[:20])
+    raise SystemExit(1)
diff --git a/evidence/k_concrete_cases.py b/evidence/k_concrete_cases.py
new file mode 100644
index 0000000000000000000000000000000000000000..26a674f266cdce44234f299a7164c5732279f0ee
--- /dev/null
+++ b/evidence/k_concrete_cases.py
@@ -0,0 +1,29 @@
+"""Reviewer-authored concrete K execution witnesses for all proof partitions."""
+
+
+def choose_num(x, y):
+    if y % 2 == 0:
+        if y >= x:
+            return y
+        return -1
+    if y - 1 >= x:
+        return y - 1
+    return -1
+
+
+# Prompt examples.
+assert choose_num(12, 15) == 14
+assert choose_num(13, 12) == -1
+
+# Satisfying witnesses for, respectively:
+# even-upper-in-range, even-upper-before-range,
+# odd-upper-predecessor-in-range, odd-upper-no-even-in-range.
+assert choose_num(1, 2) == 2
+assert choose_num(3, 2) == -1
+assert choose_num(1, 3) == 2
+assert choose_num(3, 3) == -1
+
+# Smallest positive input and representative large boundaries.
+assert choose_num(1, 1) == -1
+assert choose_num(999_999, 1_000_000) == 1_000_000
+assert choose_num(1_000_000, 999_999) == -1
diff --git a/evidence/stage1_integrity.sh b/evidence/stage1_integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..2fbae156f31ed3a4e7c490f54697bfc7599d6829
--- /dev/null
+++ b/evidence/stage1_integrity.sh
@@ -0,0 +1,125 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+status=0
+
+printf '%s\n' '$ sha256sum launcher-owned files and mounted provenance inputs'
+sha256sum \
+  /audit-campaign-lock.json \
+  /reference/canonical.py \
+  /reference/prompt.py \
+  /reference/py2mpy.py \
+  /candidate/prompt.py \
+  /candidate/py2mpy.py \
+  /generation-evidence/invocation.json \
+  /generation-evidence/metrics.json \
+  /generation-evidence/usage.json \
+  /generation-evidence/codex-last.txt \
+  /generation-evidence/codex-output.log \
+  /generation-evidence/prompt.txt \
+  /run.json \
+  /task.json \
+  /generation-result.json \
+  /generation-evidence/codex-trace/2026/07/23/*.jsonl || status=1
+
+printf '%s\n' '$ compare campaign block with audit-campaign-lock.json'
+python3 - <<'PY' || status=1
+import hashlib
+import json
+
+with open("/audit-input.json", "rb") as stream:
+    audit_bytes = stream.read()
+with open("/audit-campaign-lock.json", "rb") as stream:
+    lock_bytes = stream.read()
+audit = json.loads(audit_bytes)
+lock = json.loads(lock_bytes)
+actual_hash = hashlib.sha256(lock_bytes).hexdigest()
+print("record_layout", audit["record_layout"])
+print("semantics_mode", audit["semantics_mode"])
+print("campaign_block_equal", audit["audit_campaign"] == lock)
+print("lock_hash_recorded", audit["hashes"]["audit_campaign_lock_sha256"])
+print("lock_hash_actual", actual_hash)
+assert audit["audit_campaign"] == lock
+assert audit["hashes"]["audit_campaign_lock_sha256"] == actual_hash
+PY
+
+printf '%s\n' '$ require all legacy-selected-stage1 records and provenance mounts'
+python3 - <<'PY' || status=1
+import json
+import os
+import stat
+
+with open("/audit-input.json") as stream:
+    audit = json.load(stream)
+required = [
+    "/audit-input.json",
+    "/audit-campaign-lock.json",
+    "/run.json",
+    "/task.json",
+    "/generation-result.json",
+    "/generation-evidence/invocation.json",
+    "/generation-evidence/metrics.json",
+    "/generation-evidence/usage.json",
+    "/generation-evidence/codex-last.txt",
+    "/generation-evidence/codex-output.log",
+    "/generation-evidence/prompt.txt",
+    "/generation-evidence/codex-trace",
+    "/candidate",
+    "/reference/canonical.py",
+    "/reference/prompt.py",
+    "/reference/py2mpy.py",
+    "/reference/reference-semantics",
+]
+required.extend(audit["container_paths"].values())
+for path in sorted(set(required)):
+    st = os.lstat(path)
+    assert not stat.S_ISLNK(st.st_mode), path
+    assert os.access(path, os.R_OK), path
+    print(stat.filemode(st.st_mode), st.st_size, path)
+PY
+
+printf '%s\n' '$ cmp candidate prompt and translator against trusted mounts'
+cmp /candidate/prompt.py /reference/prompt.py || status=1
+printf 'candidate_prompt_cmp_exit=%s\n' "$?"
+cmp /candidate/py2mpy.py /reference/py2mpy.py || status=1
+printf 'candidate_translator_cmp_exit=%s\n' "$?"
+
+printf '%s\n' '$ recursively compare supplied candidate semantics with trusted semantics'
+diff -r --no-dereference \
+  /reference/reference-semantics \
+  /candidate/reference-semantics || status=1
+printf 'reference_semantics_diff_exit=%s\n' "$?"
+
+printf '%s\n' '$ reject symlinks anywhere in candidate supplied-semantics tree'
+symlinks="$(find /candidate/reference-semantics -type l -print)"
+if [[ -n "$symlinks" ]]; then
+  printf '%s\n' "$symlinks"
+  status=1
+else
+  printf '%s\n' 'candidate_reference_semantics_symlinks=0'
+fi
+
+printf '%s\n' '$ validate all structured trace lines as JSON'
+python3 - <<'PY' || status=1
+import json
+from collections import Counter
+from pathlib import Path
+
+paths = sorted(Path("/generation-evidence/codex-trace").rglob("*"))
+files = [path for path in paths if path.is_file()]
+assert files
+total = 0
+counts = Counter()
+for path in files:
+    with path.open() as stream:
+        for line_number, line in enumerate(stream, 1):
+            event = json.loads(line)
+            total += 1
+            counts[event.get("type", "<missing>")] += 1
+    print("trace_file", path, "lines", line_number)
+print("trace_total_valid_json_lines", total)
+print("trace_top_level_type_counts", dict(sorted(counts.items())))
+PY
+
+printf 'stage1_integrity_exit=%s\n' "$status"
+exit "$status"

