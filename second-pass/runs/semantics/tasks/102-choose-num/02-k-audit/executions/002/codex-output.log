[Warning] Compiler: Variable 'Bs' defined but not used. Prefix variable name
with underscore if this is intentional.
	Source(/tmp/audit-work/reference-semantics/semantics/str.k)
	Location(53,52,53,54)
	53 |	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false  
      requires A  >Int B
	   .	                                                   ^~
exit=0

exec
/bin/bash -lc 'set -uo pipefail
log=/audit-output/evidence/stage3_positive_claims_qualified.log
: > "$log"
overall=0
for claim in all-positive-inputs even-upper-in-range even-upper-before-range odd-upper-predecessor-in-range odd-upper-no-even-in-range; do
  qualified="CHOOSE-NUM-SPEC.$claim"
  printf '"'"'$ kprove spec.k --definition audit-verification-kompiled --spec-module CHOOSE-NUM-SPEC --claims %s'"\\n' \""'$qualified" | tee -a "$log"
  output="$(kprove spec.k --definition audit-verification-kompiled --spec-module CHOOSE-NUM-SPEC --claims "$qualified" 2>&1)"
  status=$?
  printf '"'%s\\n' \""'$output" | tee -a "$log"
  top_count="$(printf '"'%s\\n' \""'$output" | grep -c '"'"'^#Top$'"' || true)\"
  printf 'claim=%s exit=%s exact_top_lines=%s\\n' \""'$qualified" "$status" "$top_count" | tee -a "$log"
  if [[ "$status" -ne 0 || "$top_count" -ne 1 ]]; then overall=1; fi
done
printf '"'stage3_positive_claims_exit=%s\\n' \""'$overall" | tee -a "$log"
exit "$overall"' in /tmp/audit-work
