  kompile audit-verification-body-mutant.k --backend haskell --main-module AUDIT-BODY-MUTANT --syntax-module MPY-SYNTAX --output-definition audit-body-mutant-kompiled
  status="'$?
  printf '"'body_mutant_kompile_exit=%s\\n' \""'$status"
  exit "$status"
} 2>&1 | tee /audit-output/evidence/stage4_body_mutant_build.log' in /tmp/audit-work
