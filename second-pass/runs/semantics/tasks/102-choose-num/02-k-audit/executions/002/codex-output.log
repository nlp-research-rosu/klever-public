import json,pprint
p='/generation-evidence/codex-trace/2026/07/23/rollout-2026-07-23T04-02-09-019f8e35-f8dd-7321-bf05-393dd74487e6.jsonl'
for i,line in enumerate(open(p),1):
 if i<9 or i>60: continue
 x=json.loads(line); pl=x.get('payload',{})
 if x['type']=='response_item' and pl.get('type')=='reasoning':
  print(f'===== LINE {i} reasoning summary'); pprint.pp(pl.get('summary'))
 elif x['type']=='event_msg' and pl.get('type')=='token_count':
  print(f'===== LINE {i} token_count'); pprint.pp(pl.get('info'))
