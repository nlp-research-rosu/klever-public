Module(
  Expr(
    Str(
      "Reviewer-authored concrete K execution witnesses for all proof partitions."))
  FuncDef("choose_num", Params("x", "y"),
    If(Compare(BinOp("%", Name("y"), Int(2)), CmpOp("==", Int(0))),
      If(Compare(Name("y"), CmpOp(">=", Name("x"))),
        Return(Name("y")),
        )
      Return(UnaryOp("-", Int(1))),
      )
    If(Compare(BinOp("-", Name("y"), Int(1)), CmpOp(">=", Name("x"))),
      Return(BinOp("-", Name("y"), Int(1))),
      )
    Return(UnaryOp("-", Int(1))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(12), Int(15)),
      CmpOp("==", Int(14))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(13), Int(12)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(1), Int(2)),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(3), Int(2)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(1), Int(3)),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(3), Int(3)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(1), Int(1)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(999999), Int(1000000)),
      CmpOp("==", Int(1000000))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(1000000), Int(999999)),
      CmpOp("==", UnaryOp("-", Int(1))))))
