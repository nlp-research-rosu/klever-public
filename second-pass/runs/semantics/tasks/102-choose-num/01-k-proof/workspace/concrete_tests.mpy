Module(
  FuncDef("choose_num", Params("x", "y"),
    If(Compare(BinOp("%", Name("y"), Int(2)), CmpOp("==", Int(0))),
      If(Compare(Name("y"), CmpOp(">=", Name("x"))),
        Return(Name("y")),
        )
      Return(UnaryOp("-", Int(1))),
      )
    If(Compare(BinOp("-", Name("y"), Int(1)), CmpOp(">=", Name("x"))),
      Return(BinOp("-", Name("y"), Int(1))),
      )
    Return(UnaryOp("-", Int(1))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(12), Int(15)),
      CmpOp("==", Int(14))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(13), Int(12)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(13), Int(13)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(14), Int(14)),
      CmpOp("==", Int(14))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(1), Int(1)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(1), Int(2)),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(2), Int(1)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(7), Int(10)),
      CmpOp("==", Int(10)))))
