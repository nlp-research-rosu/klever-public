Module(
  FuncDef("choose_num", Params("x", "y"),
    If(Compare(BinOp("%", Name("y"), Int(2)), CmpOp("==", Int(0))),
      If(Compare(Name("y"), CmpOp(">=", Name("x"))),
        Return(Name("y")),
        )
      Return(UnaryOp("-", Int(1))),
      )
    If(Compare(BinOp("-", Name("y"), Int(1)), CmpOp(">=", Name("x"))),
      Return(BinOp("-", Name("y"), Int(1))),
      )
    Return(UnaryOp("-", Int(1)))))
