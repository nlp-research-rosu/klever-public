diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..54a74a4234518427c8ef7c1baa08ae6d9313e9f2
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,41 @@
+requires "reference-semantics/semantics.k"
+
+module CHOOSE-NUM-VERIFICATION
+  imports MPY
+
+  // This is the exact function body emitted in solution.mpy, packaged as a
+  // callable closure so that claims can supply symbolic integer arguments.
+  syntax KItem ::= "#chooseNum" "(" Int "," Int ")"
+
+  // Mathematical contract: remove the parity remainder from Y to obtain the
+  // greatest even integer at or below it, then test interval membership.
+  syntax Int ::= largestEvenInRange(Int, Int) [function, total]
+  rule largestEvenInRange(X:Int, Y:Int)
+    => #if X <=Int Y -Int pyMod(Y, 2)
+       #then Y -Int pyMod(Y, 2)
+       #else -1
+       #fi
+
+  rule <k> #chooseNum(X:Int, Y:Int)
+        => Call(
+             closureVal(
+               ("x", "y"),
+               If(
+                 Compare(BinOp("%", Name("y"), Int(2)), CmpOp("==", Int(0))),
+                 If(
+                   Compare(Name("y"), CmpOp(">=", Name("x"))),
+                   Return(Name("y")),
+                   .Stmts)
+                 Return(UnaryOp("-", Int(1))),
+                 .Stmts)
+               If(
+                 Compare(
+                   BinOp("-", Name("y"), Int(1)),
+                   CmpOp(">=", Name("x"))),
+                 Return(BinOp("-", Name("y"), Int(1))),
+                 .Stmts)
+               Return(UnaryOp("-", Int(1))),
+               0),
+             X, Y)
+        ... </k>
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module CHOOSE-NUM-VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /work
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..6c83797ad9df059ed1cc1a996fc36ff05ecffbd1
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,18 @@
+def choose_num(x, y):
+    if y % 2 == 0:
+        if y >= x:
+            return y
+        return -1
+    if y - 1 >= x:
+        return y - 1
+    return -1
+
+
+assert choose_num(12, 15) == 14
+assert choose_num(13, 12) == -1
+assert choose_num(13, 13) == -1
+assert choose_num(14, 14) == 14
+assert choose_num(1, 1) == -1
+assert choose_num(1, 2) == 2
+assert choose_num(2, 1) == -1
+assert choose_num(7, 10) == 10
