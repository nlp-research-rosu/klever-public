--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,18 @@
+def choose_num(x, y):
+    if y % 2 == 0:
+        if y >= x:
+            return y
+        return -1
+    if y - 1 >= x:
+        return y - 1
+    return -1
+
+
+assert choose_num(12, 15) == 14
+assert choose_num(13, 12) == -1
+assert choose_num(13, 13) == -1
