+requires "verification.k"
+
+module CHOOSE-NUM-SPEC
+  imports CHOOSE-NUM-VERIFICATION
+
+  // For positive integers, pyMod(Y, 2) is either 0 or 1.  These four claims
+  // are therefore exhaustive.  They also state why the result is maximal:
+  // an even upper endpoint is itself the answer; an odd upper endpoint has
+  // Y - 1 as its greatest even predecessor.
+
+  claim [even-upper-in-range]:
+    <k> #chooseNum(X:Int, Y:Int) => Y </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+    requires X >Int 0 andBool Y >Int 0
+     andBool pyMod(Y, 2) ==Int 0
+     andBool X <=Int Y
+
+  claim [even-upper-before-range]:
+    <k> #chooseNum(X:Int, Y:Int) => -1 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+    requires X >Int 0 andBool Y >Int 0
+     andBool pyMod(Y, 2) ==Int 0
+     andBool X >Int Y
+
+  claim [odd-upper-predecessor-in-range]:
+    <k> #chooseNum(X:Int, Y:Int) => Y -Int 1 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+    requires X >Int 0 andBool Y >Int 0
+     andBool pyMod(Y, 2) ==Int 1
+     andBool X <Int Y
+
+  claim [odd-upper-no-even-in-range]:
+    <k> #chooseNum(X:Int, Y:Int) => -1 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+    requires X >Int 0 andBool Y >Int 0
+     andBool pyMod(Y, 2) ==Int 1
+     andBool X >=Int Y
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..bade701c0270aa64fe26747649fa1201ec71132b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,32 @@
+requires "reference-semantics/semantics.k"
+
+module CHOOSE-NUM-VERIFICATION
+  imports MPY
+
+  // This is the exact function body emitted in solution.mpy, packaged as a
+  // callable closure so that claims can supply symbolic integer arguments.
+  syntax KItem ::= "#chooseNum" "(" Int "," Int ")"
+
+  rule <k> #chooseNum(X:Int, Y:Int)
+        => Call(
+             closureVal(
+               ("x", "y"),
+               If(
+                 Compare(BinOp("%", Name("y"), Int(2)), CmpOp("==", Int(0))),
+                 If(
+                   Compare(Name("y"), CmpOp(">=", Name("x"))),
+                   Return(Name("y")),
+                   .Stmts)
+                 Return(UnaryOp("-", Int(1))),
+                 .Stmts)
+               If(
+                 Compare(
+                   BinOp("-", Name("y"), Int(1)),
+                   CmpOp(">=", Name("x"))),
+                 Return(BinOp("-", Name("y"), Int(1))),
+                 .Stmts)
+               Return(UnaryOp("-", Int(1))),
+               0),
+             X, Y)
+        ... </k>
+endmodule

