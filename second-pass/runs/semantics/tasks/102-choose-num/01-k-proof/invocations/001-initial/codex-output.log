+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires X >Int 0 andBool Y >Int 0
+     andBool pyMod(Y, 2) ==Int 1
+     andBool X >=Int Y
+endmodule
