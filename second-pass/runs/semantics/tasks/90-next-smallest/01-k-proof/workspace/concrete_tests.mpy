Module(
  FuncDef("next_smallest", Params("lst"),
    Assign(Name("smallest"), Int(0))
    Assign(Name("second"), Int(0))
    Assign(Name("count"), Int(0))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("lst"),
      If(Compare(Name("count"), CmpOp("==", Int(0))),
        Assign(Name("smallest"), Name("value"))
        Assign(Name("count"), Int(1)),
        If(Compare(Name("value"), CmpOp("<", Name("smallest"))),
          Assign(Name("second"), Name("smallest"))
          Assign(Name("count"), Int(2))
          Assign(Name("smallest"), Name("value")),
          If(Compare(Name("value"), CmpOp("!=", Name("smallest"))),
            If(BoolOp(
              "or",
              Compare(Name("count"), CmpOp("==", Int(1))),
              Compare(Name("value"), CmpOp("<", Name("second")))),
              Assign(Name("second"), Name("value"))
              Assign(Name("count"), Int(2)),
              ),
            ))))
    If(Compare(Name("count"), CmpOp("==", Int(2))),
      Return(Name("second")),
      )
    Return(NoneVal))
  Assert(
    Compare(
      Call(
        Name("next_smallest"),
        ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(
        Name("next_smallest"),
        ListExpr(Int(5), Int(1), Int(4), Int(3), Int(2))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("next_smallest"), ListExpr()),
      CmpOp("is", NoneVal)))
  Assert(
    Compare(
      Call(Name("next_smallest"), ListExpr(Int(1), Int(1))),
      CmpOp("is", NoneVal)))
  Assert(
    Compare(
      Call(Name("next_smallest"), ListExpr(Int(7))),
      CmpOp("is", NoneVal)))
  Assert(
    Compare(
      Call(Name("next_smallest"), ListExpr(Int(2), Int(1))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("next_smallest"), ListExpr(Int(1), Int(2), Int(1))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(
        Name("next_smallest"),
        ListExpr(Int(0), UnaryOp("-", Int(1)), Int(0))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("next_smallest"),
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(3)))),
      CmpOp("==", UnaryOp("-", Int(2)))))
  Assert(
    Compare(
      Call(
        Name("next_smallest"),
        ListExpr(Int(3), Int(3), Int(2), Int(2), Int(1), Int(1))),
      CmpOp("==", Int(2)))))
