/bin/bash -lc "python3 py2mpy.py solution.py > solution.mpy && sed -n '1,260p' solution.mpy && python3 - <<'PY'
from solution import next_smallest
cases = [([1,2,3,4,5],2),([5,1,4,3,2],2),([],None),([1,1],None),([2,1],2),([0,-1,0],0),([-1,-3,-2,-3],-2),([7],None),([3,3,2,2,1,1],2)]
for xs,want in cases:
    got=next_smallest(xs)
    assert got==want,(xs,got,want)
    print(xs,'=>',got)
PY" in /work
