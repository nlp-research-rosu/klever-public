diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..062f0e5bb18ab8fcf95e6550cba65907bf336a0d
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,67 @@
+requires "reference-semantics/semantics.k"
+
+module NEXT-SMALLEST-VERIFICATION
+  imports MPY
+
+  // This is the constructor term generated from solution.py, factored into
+  // named pieces so that the proof claims remain readable.
+  syntax Stmts ::= "nextSmallestLoopBody" [macro]
+  rule nextSmallestLoopBody =>
+    If(Compare(Name("smallest"), CmpOp("is", NoneVal)),
+       Assign(Name("smallest"), Name("value")) .Stmts,
+       If(Compare(Name("value"), CmpOp("<", Name("smallest"))),
+          Assign(Name("second"), Name("smallest"))
+          Assign(Name("smallest"), Name("value")),
+          If(Compare(Name("value"), CmpOp("!=", Name("smallest"))),
+             If(BoolOp("or",
+                       (Compare(Name("second"), CmpOp("is", NoneVal)),
+                        Compare(Name("value"), CmpOp("<", Name("second"))),
+                        .Exprs)),
+                Assign(Name("second"), Name("value")) .Stmts,
+                .Stmts) .Stmts,
+             .Stmts) .Stmts))
+
+  syntax Stmts ::= "nextSmallestBody" [macro]
+  rule nextSmallestBody =>
+    Assign(Name("smallest"), NoneVal)
+    Assign(Name("second"), NoneVal)
+    For(Name("value"), Name("lst"), nextSmallestLoopBody)
+    Return(Name("second"))
+
+  syntax Module ::= "solutionModule" [macro]
+  rule solutionModule =>
+    Module(FuncDef("next_smallest", Params("lst"), nextSmallestBody))
+
+  // Symbolic integer sequences keep the quantified input within the HumanEval
+  // contract while still allowing the prover to induct on its shape.
+  syntax Ints ::= "nilInts" | consInts(Int, Ints)
+
+  syntax ValSeq ::= intVals(Ints) [function, total]
+  rule intVals(nilInts) => .ValSeq
+  rule intVals(consInts(X:Int, XS:Ints)) => vCons(X, intVals(XS))
+
+  // Independent executable specification: fold the input into the least and
+  // second-least distinct values.  noneV denotes an absent candidate.
+  syntax NSState ::= nsState(Val, Val)
+  syntax NSState ::= nsStep(Int, Val, Val) [function, total]
+
+  rule nsStep(X:Int, noneV, N:Val) => nsState(X, N)
+  rule nsStep(X:Int, S:Int, N:Val) => nsState(X, S)
+    requires X <Int S
+  rule nsStep(X:Int, S:Int, N:Val) => nsState(S, N)
+    requires X ==Int S
+  rule nsStep(X:Int, S:Int, noneV) => nsState(S, X)
+    requires X >Int S
+  rule nsStep(X:Int, S:Int, N:Int) => nsState(S, X)
+    requires X >Int S andBool X <Int N
+  rule nsStep(X:Int, S:Int, N:Int) => nsState(S, N)
+    requires X >Int S andBool X >=Int N
+
+  syntax Val ::= nsScan(Ints, Val, Val) [function, total]
+               | nsScanState(Ints, NSState) [function, total]
+  rule nsScan(nilInts, _:Val, N:Val) => N
+  rule nsScan(consInts(X:Int, XS:Ints), S:Val, N:Val)
+    => nsScanState(XS, nsStep(X, S, N))
+  rule nsScanState(XS:Ints, nsState(S:Val, N:Val))
+    => nsScan(XS, S, N)
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module NEXT-SMALLEST-VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /work
