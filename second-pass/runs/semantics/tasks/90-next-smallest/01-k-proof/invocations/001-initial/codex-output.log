+    => nsScan(XS, S, N, true, HN)
+    requires X ==Int S
+  rule nsScan(consInts(X:Int, XS:Ints), S:Int, _:Int, true, false)
+    => nsScan(XS, S, X, true, true)
+    requires X >Int S
+  rule nsScan(consInts(X:Int, XS:Ints), S:Int, N:Int, true, true)
