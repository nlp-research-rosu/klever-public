new file mode 100644
index 0000000000000000000000000000000000000000..4494d262c7ce07910f5474a1fb1d20daf23c992e
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,21 @@
+def next_smallest(lst):
+    smallest = 0
+    second = 0
+    count = 0
+
+    for value in lst:
+        if count == 0:
+            smallest = value
+            count = 1
+        elif value < smallest:
+            second = smallest
+            count = 2
+            smallest = value
+        elif value != smallest:
+            if count == 1 or value < second:
+                second = value
+                count = 2
+
+    if count == 2:
+        return second
+    return None
