+       1 |-> scope((FRAME:Map
+                    "smallest" |-> SMALLEST
+                    "second" |-> SECOND
+                    "has_smallest" |-> HAS_SMALLEST
+                    "has_second" |-> HAS_SECOND),
+                   parent(0)))
+    =>
+      SC
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map => HEAP </heap>
+    <heapLoc> HLOC:Int => HLOC </heapLoc>
+    <stack>
