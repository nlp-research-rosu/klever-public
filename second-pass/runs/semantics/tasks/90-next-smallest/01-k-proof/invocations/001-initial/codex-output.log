+      (SC:Map
+       1 |-> scope(("value" |-> OLD_VALUE:Int
+                    "lst" |-> LST:Val
+                    "smallest" |-> SMALLEST
+                    "second" |-> SECOND
+                    "count" |-> COUNT),
+                   parent(0)))
+    =>
+      ((SC
+        1 |-> scope(("value" |-> OLD_VALUE
+                     "lst" |-> LST
+                     "smallest" |-> SMALLEST
+                     "second" |-> SECOND
+                     "count" |-> COUNT),
+                    parent(0))) [1 <- undef])
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1)) REST:List
+    =>
+      REST
+    </stack>
+    <ret> noRet </ret>
+    <exc> EXC:Exc </exc>
+    <exit-code> CODE:Int </exit-code>
+    requires notBool (1 in_keys(SC))
+    [priority(40)]
