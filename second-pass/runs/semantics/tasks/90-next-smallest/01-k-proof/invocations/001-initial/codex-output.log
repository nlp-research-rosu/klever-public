@@ -0,0 +1,15 @@
+def next_smallest(lst):
+    smallest = None
+    second = None
+
+    for value in lst:
+        if smallest is None:
+            smallest = value
+        elif value < smallest:
+            second = smallest
+            smallest = value
+        elif value != smallest:
+            if second is None or value < second:
+                second = value
+
+    return second
