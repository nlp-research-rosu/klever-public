+requires "verification.k"
+
+module NEXT-SMALLEST-SPEC
+  imports NEXT-SMALLEST-VERIFICATION
+
+  // Loop invariant / functional-correctness theorem.  INPUT is arbitrary and
+  // the four accumulator values describe an arbitrary already-scanned prefix;
+  // the claim is therefore closed by circularity on every remaining element.
+  claim
+    <k>
+      #loop(list(intVals(INPUT:Ints)),
+            Name("value"),
+            nextSmallestLoopBody)
+      ~> nextSmallestReturn
+      ~> #endcall
+    =>
+      nsScan(INPUT, SMALLEST:Int, SECOND:Int,
+             HAS_SMALLEST:Bool, HAS_SECOND:Bool)
+      ~> CONT:K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (SC:Map
+       1 |-> scope(("value" |-> OLD_VALUE:Int
+                    "smallest" |-> SMALLEST
+                    "second" |-> SECOND
+                    "has_smallest" |-> HAS_SMALLEST
+                    "has_second" |-> HAS_SECOND),
+                   parent(0)))
+    =>
+      ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map => HEAP </heap>
+    <heapLoc> HLOC:Int => HLOC </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1)) REST:List
+    =>
+      REST
+    </stack>
+    <ret> noRet => noRet </ret>
+    <exc> EXC:Exc => EXC </exc>
+    <exit-code> CODE:Int => CODE </exit-code>
+    requires notBool (1 in_keys(SC))
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..03854ce37d39c236896dc3b850e6913a53b3c8b5
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,77 @@
+requires "reference-semantics/semantics.k"
+
+module NEXT-SMALLEST-VERIFICATION
+  imports MPY
+
+  // This is the constructor term generated from solution.py, factored into
+  // named pieces so that the proof claims remain readable.
+  syntax Stmts ::= "nextSmallestLoopBody" [macro]
+  rule nextSmallestLoopBody =>
+    If(UnaryOp("not", Name("has_smallest")),
+       Assign(Name("smallest"), Name("value"))
+       Assign(Name("has_smallest"), Bool(true)),
+       If(Compare(Name("value"), CmpOp("<", Name("smallest"))),
+          Assign(Name("second"), Name("smallest"))
+          Assign(Name("has_second"), Bool(true))
+          Assign(Name("smallest"), Name("value")),
+          If(Compare(Name("value"), CmpOp("!=", Name("smallest"))),
+             If(BoolOp("or",
+                       (UnaryOp("not", Name("has_second")),
+                        Compare(Name("value"), CmpOp("<", Name("second"))),
+                        .Exprs)),
+                Assign(Name("second"), Name("value"))
+                Assign(Name("has_second"), Bool(true)),
+                .Stmts) .Stmts,
+             .Stmts) .Stmts))
+
+  syntax Stmts ::= "nextSmallestReturn" [macro]
+  rule nextSmallestReturn =>
+    If(Name("has_second"),
+       Return(Name("second")) .Stmts,
+       .Stmts)
+    Return(NoneVal)
+
+  syntax Stmts ::= "nextSmallestBody" [macro]
+  rule nextSmallestBody =>
+    Assign(Name("smallest"), Int(0))
+    Assign(Name("second"), Int(0))
+    Assign(Name("has_smallest"), Bool(false))
+    Assign(Name("has_second"), Bool(false))
+    For(Name("value"), Name("lst"), nextSmallestLoopBody)
+    nextSmallestReturn
+
+  syntax Module ::= "solutionModule" [macro]
+  rule solutionModule =>
+    Module(FuncDef("next_smallest", Params("lst"), nextSmallestBody))
+
+  // An inductive carrier keeps every symbolic head in the Int sort.  It is a
+  // ValSeq inhabitant whose iterator rules are isomorphic to .ValSeq/vCons.
+  syntax Ints ::= "nilInts" | consInts(Int, Ints)
+  syntax ValSeq ::= intVals(Ints)
+  rule <k> #iterNext(list(intVals(nilInts))) => #iterDone ... </k>
+  rule <k> #iterNext(list(intVals(consInts(X:Int, XS:Ints))))
+        => #iterYield(X, list(intVals(XS))) ... </k>
+
+  // Independent executable specification: the same mathematical fold, with
+  // explicit presence bits so every symbolic accumulator remains well-sorted.
+  syntax Val ::= nsScan(Ints, Int, Int, Bool, Bool) [function, total]
+  rule nsScan(nilInts, _:Int, _:Int, _:Bool, false) => noneV
+  rule nsScan(nilInts, _:Int, N:Int, _:Bool, true) => N
+  rule nsScan(consInts(X:Int, XS:Ints), S:Int, N:Int, false, HN:Bool)
+    => nsScan(XS, X, N, true, HN)
+  rule nsScan(consInts(X:Int, XS:Ints), S:Int, _:Int, true, _:Bool)
+    => nsScan(XS, X, S, true, true)
+    requires X <Int S
+  rule nsScan(consInts(X:Int, XS:Ints), S:Int, N:Int, true, HN:Bool)
+    => nsScan(XS, S, N, true, HN)
+    requires X ==Int S
+  rule nsScan(consInts(X:Int, XS:Ints), S:Int, _:Int, true, false)
+    => nsScan(XS, S, X, true, true)
+    requires X >Int S
+  rule nsScan(consInts(X:Int, XS:Ints), S:Int, N:Int, true, true)
+    => nsScan(XS, S, X, true, true)
+    requires X >Int S andBool X <Int N
+  rule nsScan(consInts(X:Int, XS:Ints), S:Int, N:Int, true, true)
+    => nsScan(XS, S, N, true, true)
+    requires X >Int S andBool X >=Int N
+endmodule

