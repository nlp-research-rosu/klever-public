+       Assign(Name("smallest"), Name("value")) .Stmts,
+       If(Compare(Name("value"), CmpOp("<", Name("smallest"))),
+          Assign(Name("second"), Name("smallest"))
+          Assign(Name("smallest"), Name("value")),
+          If(Compare(Name("value"), CmpOp("!=", Name("smallest"))),
+             If(BoolOp("or",
+                       (Compare(Name("second"), CmpOp("is", NoneVal)),
+                        Compare(Name("value"), CmpOp("<", Name("second"))),
+                        .Exprs)),
+                Assign(Name("second"), Name("value")) .Stmts,
+                .Stmts) .Stmts,
+             .Stmts) .Stmts))
+
+  syntax Stmts ::= "nextSmallestBody" [macro]
+  rule nextSmallestBody =>
+    Assign(Name("smallest"), NoneVal)
+    Assign(Name("second"), NoneVal)
+    For(Name("value"), Name("lst"), nextSmallestLoopBody)
+    Return(Name("second"))
+
+  syntax Module ::= "solutionModule" [macro]
+  rule solutionModule =>
+    Module(FuncDef("next_smallest", Params("lst"), nextSmallestBody))
+
+  // An inductive carrier keeps every symbolic head in the Int sort.  It is a
+  // ValSeq inhabitant whose iterator rules are isomorphic to .ValSeq/vCons.
+  syntax Ints ::= "nilInts" | consInts(Int, Ints)
+  syntax ValSeq ::= intVals(Ints)
+  rule <k> #iterNext(list(intVals(nilInts))) => #iterDone ... </k>
+  rule <k> #iterNext(list(intVals(consInts(X:Int, XS:Ints))))
+        => #iterYield(X, list(intVals(XS))) ... </k>
+
+  // Independent executable specification: fold the input into the least and
+  // second-least distinct values.  noneV denotes an absent candidate.
+  syntax NSState ::= nsState(Val, Val)
+  syntax NSState ::= nsStep(Int, Val, Val) [function, total]
+
+  rule nsStep(X:Int, noneV, N:Val) => nsState(X, N)
+  rule nsStep(X:Int, S:Int, N:Val) => nsState(X, S)
+    requires X <Int S
+  rule nsStep(X:Int, S:Int, N:Val) => nsState(S, N)
+    requires X ==Int S
+  rule nsStep(X:Int, S:Int, noneV) => nsState(S, X)
+    requires X >Int S
+  rule nsStep(X:Int, S:Int, N:Int) => nsState(S, X)
+    requires X >Int S andBool X <Int N
+  rule nsStep(X:Int, S:Int, N:Int) => nsState(S, N)
+    requires X >Int S andBool X >=Int N
