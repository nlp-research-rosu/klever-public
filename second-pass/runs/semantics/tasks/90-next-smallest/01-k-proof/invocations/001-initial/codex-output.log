+            smallest = value
+        elif value != smallest:
+            if count == 1 or value < second:
+                second = value
+                count = 2
+
+    if count == 2:
+        return second
+    return None
+
+
+assert next_smallest([1, 2, 3, 4, 5]) == 2
+assert next_smallest([5, 1, 4, 3, 2]) == 2
+assert next_smallest([]) is None
+assert next_smallest([1, 1]) is None
+assert next_smallest([7]) is None
