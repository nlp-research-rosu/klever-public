diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..3ab80472950cd6962fdd8d8e6115f5d828e71791
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,22 @@
+def next_smallest(lst):
+    smallest = 0
+    second = 0
+    has_smallest = False
+    has_second = False
+
+    for value in lst:
+        if not has_smallest:
+            smallest = value
+            has_smallest = True
+        elif value < smallest:
+            second = smallest
+            has_second = True
+            smallest = value
+        elif value != smallest:
+            if not has_second or value < second:
+                second = value
+                has_second = True
+
+    if has_second:
+        return second
+    return None
