      "start_line": 104,
      "text": "  rule\n    <k>\n      #loop(list(intVals(INPUT:Ints)),\n            Name(\"value\"),\n            nextSmallestLoopBody)\n      ~> nextSmallestReturn\n      ~> #endcall\n    =>\n      nsScan(INPUT, SMALLEST:Int, SECOND:Int, COUNT:Int)\n      ~> CONT:K\n    </k>\n    <env> 1 => 0 </env>\n    <scopes>\n      (SC:Map\n       1 |-> scope((\"value\" |-> OLD_VALUE:Int\n                    \"lst\" |-> LST:Val\n                    \"smallest\" |-> SMALLEST\n                    \"second\" |-> SECOND\n                    \"count\" |-> COUNT),\n                   parent(0)))\n    =>\n      ((SC\n        1 |-> scope((\"value\" |-> OLD_VALUE\n                     \"lst\" |-> LST\n                     \"smallest\" |-> SMALLEST\n                     \"second\" |-> SECOND\n                     \"count\" |-> COUNT),\n                    parent(0))) [1 <- undef])\n    </scopes>\n    <scopeLoc> 2 => 1 </scopeLoc>\n    <heap> HEAP:Map </heap>\n    <heapLoc> HLOC:Int </heapLoc>\n    <stack>\n      ListItem(frame(CONT, 0, 1)) REST:List\n    =>\n      REST\n    </stack>\n    <ret> noRet </ret>\n    <exc> EXC:Exc </exc>\n    <exit-code> CODE:Int </exit-code>\n    requires notBool (1 in_keys(SC))\n    [priority(40)]"
    }
  ],
