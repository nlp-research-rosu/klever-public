     1	def next_smallest(lst):
     2	    smallest = 0
     3	    second = 0
     4	    count = 0
     5	    value = 0
     6	
     7	    for value in lst:
     8	        if count == 0:
     9	            smallest = value
    10	            count = 1
    11	        elif value < smallest:
    12	            second = smallest
    13	            count = 2
    14	            smallest = value
    15	        elif value != smallest:
    16	            if count == 1 or value < second:
    17	                second = value
    18	                count = 2
    19	
    20	    if count == 2:
    21	        return second
    22	    return None
