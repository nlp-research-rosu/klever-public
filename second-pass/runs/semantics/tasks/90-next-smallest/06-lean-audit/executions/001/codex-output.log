      "start_line": 91,
      "text": "  rule nsScan(IS:Ints, S:Int, N:Int, C:Int)\n    => nsScan(intsTail(IS), S, N, C)\n    requires notBool intsEmpty(IS) andBool notBool (C ==Int 0)\n     andBool notBool (C ==Int 1)\n     andBool intsHead(IS) >Int S andBool intsHead(IS) >=Int N"
    },
    {
