      "manifest_classification": "DOMAIN_LEMMA",
      "manifest_rationale": "Trusted loop-summary fact used by the entry proof; Stage 1 proved only a weaker claim with an existential final scopes map, not this rule's exact specific scope-deletion consequent.",
      "module": "NEXT-SMALLEST-WITH-LOOP-LEMMA",
      "normalized_sha256": "24e0b061b3462f2b6e58444f2f4c1b2a9c99ebe7e02e89ff2bfabb146ab52cba",
