    64	private partial def seedGeneratedInjections
    65	    (pattern actual : Expr) : MetaM Unit := do
    66	  let pattern ← instantiateMVars pattern
    67	  let actual ← instantiateMVars actual
    68	  let patternFn := pattern.getAppFn
    69	  if patternFn.isConstOf ``inj then
    70	    let patternArgs := pattern.getAppArgs
    71	    let actualArgs := actual.getAppArgs
    72	    if patternArgs.size ≥ 1 && actualArgs.size ≥ 1 then
    73	      let payloadPattern := patternArgs.back!
    74	      let payloadActual := actualArgs.back!
    75	      if payloadPattern.isMVar then
    76	        let payloadPatternType ← inferType payloadPattern
    77	        let payloadActualType ← inferType payloadActual
    78	        if ← isDefEq payloadPatternType payloadActualType then
    79	          payloadPattern.mvarId!.assign payloadActual
    80	        else
    81	          let payloadPatternType ← whnf payloadPatternType
    82	          if let .const targetSort _ := payloadPatternType then
    83	            if let .const actualConstructor _ := actual.getAppFn then
    84	              let suffixes ←
    85	                if actualConstructor == ``inj then
    86	                  match payloadActualType with
    87	                  | .const sourceSort _ =>
    88	                      let source := sourceSort.getString!
    89	                      if source.startsWith "Sort" then
    90	                        pure [s!"inj_{source}"]
    91	                      else
    92	                        pure [s!"inj_{source}", s!"inj_Sort{source}"]
    93	                  | _ => pure []
    94	                else
    95	                  pure [actualConstructor.getString!]
    96	              for suffix in suffixes do
    97	                let liftedConstructor := Name.str targetSort suffix
    98	                if (← getEnv).contains liftedConstructor then
    99	                  let lifted ← mkAppM liftedConstructor #[payloadActual]
   100	                  payloadPattern.mvarId!.assign lifted
   101	                else if targetSort == ``SortExpr then
   102	                  let valConstructor := Name.str ``SortVal suffix
   103	                  let exprConstructor := Name.str ``SortExpr "inj_SortVal"
   104	                  if (← getEnv).contains valConstructor &&
   105	                      (← getEnv).contains exprConstructor then
   106	                    let value ← mkAppM valConstructor #[payloadActual]
   107	                    let expression ← mkAppM exprConstructor #[value]
   108	                    payloadPattern.mvarId!.assign expression
   109	      else
   110	        seedGeneratedInjections payloadPattern payloadActual
   111	  else if patternFn == actual.getAppFn then
   112	    let patternArgs := pattern.getAppArgs
   113	    let actualArgs := actual.getAppArgs
   114	    if patternArgs.size = actualArgs.size then
   115	      for index in [:patternArgs.size] do
   116	        seedGeneratedInjections patternArgs[index]! actualArgs[index]!
   117	
   118	/--
   119	Apply one generated K rewrite rule and leave the remaining transitive rewrite
   120	as the sole goal. Rule side conditions are discharged by definitional
   121	reduction, simplification, arithmetic, and hypotheses in the current branch.
   122	-/
   123	elab "kstep" : tactic => do
   124	  let goals ← getGoals
   125	  let goal ← getMainGoal
   126	  let restGoals := goals.tail
   127	  let target ← whnf (← goal.getType)
   128	  let targetArgs := target.getAppArgs
   129	  unless targetArgs.size = 2 do
   130	    throwError "kstep: expected a binary Rewrites goal"
   131	  let source := targetArgs[0]!
   132	  let destination := targetArgs[1]!
   133	  let stateType ← inferType source
   134	  let intermediate ← mkFreshExprMVar stateType MetavarKind.natural
   135	  let firstStep ← mkFreshExprMVar
   136	    (mkAppN (mkConst ``Rewrites) #[source, intermediate])
   137	    MetavarKind.syntheticOpaque
   138	  let continuation ← mkFreshExprMVar
   139	    (mkAppN (mkConst ``Rewrites) #[intermediate, destination])
   140	    MetavarKind.syntheticOpaque
   141	  goal.assign <| mkAppN (mkConst ``Rewrites.tran)
   142	    #[source, intermediate, destination, firstStep, continuation]
   143	  let saved ← saveState
   144	  let ruleGoal := firstStep.mvarId!
   145	  let continuationGoal := continuation.mvarId!
   146	  let some (.inductInfo rewriteInfo) := (← getEnv).find? ``Rewrites
   147	    | throwError "kstep: Rewrites is not an inductive declaration"
   148	  let ruleConstructors := rewriteInfo.ctors.drop 1
   149	  for constructorName in ruleConstructors do
   150	    saved.restore
   151	    try
   152	      let constructor := mkConst constructorName
   153	      let constructorType ← inferType constructor
   154	      let (constructorMVars, _, constructorConclusion) ←
   155	        forallMetaTelescopeReducing constructorType
   156	      let ruleTarget ← ruleGoal.getType
   157	      let conclusionArgs := constructorConclusion.getAppArgs
   158	      let targetArgs := ruleTarget.getAppArgs
   159	      if conclusionArgs.size = 2 && targetArgs.size = 2 then
   160	        seedGeneratedInjections conclusionArgs[0]! targetArgs[0]!
   161	      let constructorApp := mkAppN constructor constructorMVars
   162	      let premiseGoals ← ruleGoal.apply constructorApp
   163	      let mut propositionGoals := []
   164	      let mut dataGoals := []
   165	      for premise in premiseGoals do
   166	        if ← isProp (← premise.getType) then
   167	          propositionGoals := propositionGoals ++ [premise]
   168	        else
   169	          dataGoals := dataGoals ++ [premise]
   170	      setGoals (propositionGoals ++ dataGoals)
   171	      evalTactic (← `(tactic|
   172	        all_goals
   173	          first
   174	          | assumption
   175	          | rfl
   176	          | (try simp
   177	             try kunfold_concrete_maps
   178	             try simp
   179	             try grind)))
   180	      let remainingPremises ← (← getGoals).filterM fun premise =>
   181	        not <$> premise.isAssigned
   182	      if remainingPremises.isEmpty then
   183	        setGoals (continuationGoal :: restGoals)
   184	        return
   185	    catch _ =>
   186	      pure ()
   187	  saved.restore
   188	  let target ← instantiateMVars (← ruleGoal.getType)
   189	  throwError "kstep: no generated operational rule closed the next step from\n{target}"
