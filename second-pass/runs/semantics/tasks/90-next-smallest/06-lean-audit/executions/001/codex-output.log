     6	private def generatedPrivateMapName (suffix : String) : TacticM Name := do
     7	  for (name, _) in (← getEnv).constants do
     8	    if name.toString.endsWith suffix then
     9	      return name
    10	  throwError "generated private map definition ending in '{suffix}' was not found"
    11	
    12	/-- Unfold the generated file-private map models in the current goal. -/
    13	elab "kunfold_maps" : tactic => do
    14	  let disjoint ← generatedPrivateMapName ".kleanMapDisjointModel"
    15	  let contains ← generatedPrivateMapName ".kleanMapContainsModel"
    16	  try
    17	    replaceMainGoal [← Meta.unfoldTarget (← getMainGoal) disjoint]
    18	  catch _ =>
    19	    pure ()
    20	  try
    21	    replaceMainGoal [← Meta.unfoldTarget (← getMainGoal) contains]
    22	  catch _ =>
    23	    pure ()
    24	
    25	/-- Unfold one layer of the generated file-private map membership model. -/
    26	elab "kunfold_contains" : tactic => do
    27	  let contains ← generatedPrivateMapName ".kleanMapContainsModel"
    28	  try
    29	    replaceMainGoal [← Meta.unfoldTarget (← getMainGoal) contains]
    30	  catch _ =>
    31	    pure ()
    32	
    33	/-- Unfold one layer of the generated file-private map deletion model. -/
    34	elab "kunfold_delete" : tactic => do
    35	  let delete ← generatedPrivateMapName ".kleanMapDeleteModel"
    36	  try
    37	    replaceMainGoal [← Meta.unfoldTarget (← getMainGoal) delete]
    38	  catch _ =>
    39	    pure ()
    40	
    41	elab "kunfold_delete" "at" hypothesis:ident : tactic => do
    42	  let delete ← generatedPrivateMapName ".kleanMapDeleteModel"
    43	  let goal ← getMainGoal
    44	  let fvar ← getFVarId hypothesis
    45	  replaceMainGoal [← Meta.unfoldLocalDecl goal fvar delete]
    46	
    47	/--
    48	Normalize generated lookup, update, deletion, membership, and disjointness
    49	models on the small explicit maps used by the frozen function frame.
    50	-/
    51	elab "kunfold_concrete_maps" : tactic => do
    52	  let lookup ← generatedPrivateMapName ".kleanMapLookupModel"
    53	  let update ← generatedPrivateMapName ".kleanMapUpdateModel"
    54	  let delete ← generatedPrivateMapName ".kleanMapDeleteModel"
    55	  let contains ← generatedPrivateMapName ".kleanMapContainsModel"
    56	  let disjoint ← generatedPrivateMapName ".kleanMapDisjointModel"
    57	  for _ in [:64] do
    58	    for name in [lookup, update, delete, contains, disjoint] do
    59	      try
    60	        replaceMainGoal [← Meta.unfoldTarget (← getMainGoal) name]
    61	      catch _ =>
    62	        pure ()
