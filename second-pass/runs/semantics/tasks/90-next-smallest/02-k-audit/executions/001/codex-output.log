+module AUDIT-NATIVE-LOOP-SPEC
+  imports AUDIT-NATIVE-VERIFICATION
+
+  claim
+    <k>
+      #loop(list(nativeIntVals(INPUT:Ints)),
+            Name("value"),
+            nextSmallestLoopBody)
+      ~> nextSmallestReturn
+      ~> #endcall
+    =>
+      nsScan(INPUT, SMALLEST:Int, SECOND:Int, COUNT:Int)
+      ~> CONT:K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (SC:Map
+       1 |-> scope(("value" |-> OLD_VALUE:Int
+                    "lst" |-> LST:Val
+                    "smallest" |-> SMALLEST
+                    "second" |-> SECOND
+                    "count" |-> COUNT),
+                   parent(0)))
+    =>
+      ?FINAL_SCOPES:Map
