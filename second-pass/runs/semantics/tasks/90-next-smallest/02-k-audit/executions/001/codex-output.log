diff --git a/evidence/audit-loop-body-mutation.k b/evidence/audit-loop-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..90a4c9707a70a9b4a92d16f5271448327b642109
--- /dev/null
+++ b/evidence/audit-loop-body-mutation.k
@@ -0,0 +1,64 @@
+requires "verification.k"
+
+module AUDIT-LOOP-BODY-MUTATION
+  imports NEXT-SMALLEST-VERIFICATION
+
+  // Operational-sensitivity mutation: when the inner branch records a new
+  // second minimum, store value + 1.  Input [1, 2] must then return 3 while the
+  // unmutated nsScan obligation still requires 2.
+  syntax Stmts ::= "auditMutatedLoopBody" [macro]
+  rule auditMutatedLoopBody =>
+    If(Compare(Name("count"), CmpOp("==", Int(0))),
+       Assign(Name("smallest"), Name("value"))
+       Assign(Name("count"), Int(1)),
+       If(Compare(Name("value"), CmpOp("<", Name("smallest"))),
+          Assign(Name("second"), Name("smallest"))
+          Assign(Name("count"), Int(2))
+          Assign(Name("smallest"), Name("value")),
+          If(Compare(Name("value"), CmpOp("!=", Name("smallest"))),
+             If(BoolOp("or",
+                       (Compare(Name("count"), CmpOp("==", Int(1))),
+                        Compare(Name("value"), CmpOp("<", Name("second"))),
+                        .Exprs)),
+                Assign(Name("second"),
+                       BinOp("+", Name("value"), Int(1)))
+                Assign(Name("count"), Int(2)),
+                .Stmts) .Stmts,
+             .Stmts) .Stmts))
+
+  claim
+    <k>
+      #loop(list(intVals(INPUT:Ints)),
+            Name("value"),
+            auditMutatedLoopBody)
+      ~> nextSmallestReturn
+      ~> #endcall
+    =>
+      nsScan(INPUT, SMALLEST:Int, SECOND:Int, COUNT:Int)
+      ~> CONT:K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (SC:Map
+       1 |-> scope(("value" |-> OLD_VALUE:Int
+                    "lst" |-> LST:Val
+                    "smallest" |-> SMALLEST
+                    "second" |-> SECOND
+                    "count" |-> COUNT),
+                   parent(0)))
+    =>
+      ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map => HEAP </heap>
+    <heapLoc> HLOC:Int => HLOC </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1)) REST:List
+    =>
+      REST
+    </stack>
+    <ret> noRet => noRet </ret>
+    <exc> EXC:Exc => EXC </exc>
+    <exit-code> CODE:Int => CODE </exit-code>
+    requires notBool (1 in_keys(SC))
+endmodule
