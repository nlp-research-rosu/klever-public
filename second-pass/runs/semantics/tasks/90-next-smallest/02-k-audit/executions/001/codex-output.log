/audit-output/evidence/run_logged.sh /audit-output/evidence/36-vacuity-dry-run.log kprove audit-spec-vacuity.k --definition entry-verification-kompiled --spec-module AUDIT-SPEC-VACUITY --dry-run' in /tmp/audit-work/candidate
