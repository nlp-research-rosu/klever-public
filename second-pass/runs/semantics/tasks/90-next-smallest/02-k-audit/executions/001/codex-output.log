+    [label(documented-permutation)]
+
+  claim
+    <k> nsScan(
+      consInts(-1,
+        consInts(-3,
+          consInts(-2,
+            consInts(-3, nilInts)))),
+      0, 0, 0)
+    =>
+    -2 </k>
+    [label(negative-duplicates)]
