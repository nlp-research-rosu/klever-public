+requires "verification.k"
+
+module AUDIT-MAP-DELETE-LEMMA
+  imports NEXT-SMALLEST-VERIFICATION
+
+  // Extensional MAP law needed only because the Haskell backend leaves this
+  // built-in update symbolic: deleting a freshly disjoint key removes its entry.
+  rule ((I:Int |-> S:Scope) M:Map) [ I <- undef ] => M
+    requires notBool I in_keys(M)
+    [simplification]
+endmodule
diff --git a/evidence/audit-mutated-verification.k b/evidence/audit-mutated-verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c315efe0a6d561b01ffa10284f4dfd2d9d682ed2
--- /dev/null
+++ b/evidence/audit-mutated-verification.k
@@ -0,0 +1,27 @@
+requires "verification.k"
+
+module AUDIT-MUTATED-VERIFICATION
+  imports NEXT-SMALLEST-VERIFICATION
+
+  // Operational-sensitivity mutation: when the inner branch records a new
+  // second minimum, store value + 1.
+  syntax Stmts ::= "auditMutatedLoopBody" [macro]
+  rule auditMutatedLoopBody =>
+    If(Compare(Name("count"), CmpOp("==", Int(0))),
+       Assign(Name("smallest"), Name("value"))
+       Assign(Name("count"), Int(1)),
+       If(Compare(Name("value"), CmpOp("<", Name("smallest"))),
+          Assign(Name("second"), Name("smallest"))
+          Assign(Name("count"), Int(2))
+          Assign(Name("smallest"), Name("value")),
+          If(Compare(Name("value"), CmpOp("!=", Name("smallest"))),
+             If(BoolOp("or",
+                       (Compare(Name("count"), CmpOp("==", Int(1))),
+                        Compare(Name("value"), CmpOp("<", Name("second"))),
+                        .Exprs)),
+                Assign(Name("second"),
+                       BinOp("+", Name("value"), Int(1)))
+                Assign(Name("count"), Int(2)),
+                .Stmts) .Stmts,
+             .Stmts) .Stmts))
+endmodule
