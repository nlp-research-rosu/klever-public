new file mode 100644
index 0000000000000000000000000000000000000000..721e1f03f0bda116b308c905cd4d1a2d16f25612
--- /dev/null
+++ b/evidence/audit-loop-connection-normalized.k
@@ -0,0 +1,42 @@
+requires "verification.k"
+
+module AUDIT-LOOP-CONNECTION-NORMALIZED
+  imports NEXT-SMALLEST-VERIFICATION
+
+  // Same operational theorem with the mathematically normalized post-scope SC.
+  claim
+    <k>
+      #loop(list(intVals(INPUT:Ints)),
+            Name("value"),
+            nextSmallestLoopBody)
+      ~> nextSmallestReturn
+      ~> #endcall
+    =>
+      nsScan(INPUT, SMALLEST:Int, SECOND:Int, COUNT:Int)
+      ~> CONT:K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (SC:Map
+       1 |-> scope(("value" |-> OLD_VALUE:Int
+                    "lst" |-> LST:Val
+                    "smallest" |-> SMALLEST
+                    "second" |-> SECOND
+                    "count" |-> COUNT),
+                   parent(0)))
+    =>
+      SC
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map => HEAP </heap>
+    <heapLoc> HLOC:Int => HLOC </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1)) REST:List
+    =>
+      REST
+    </stack>
+    <ret> noRet => noRet </ret>
+    <exc> EXC:Exc => EXC </exc>
+    <exit-code> CODE:Int => CODE </exit-code>
+    requires notBool (1 in_keys(SC))
+endmodule
