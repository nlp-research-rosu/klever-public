/bin/bash -lc '/audit-output/evidence/run_logged.sh /audit-output/evidence/35-kprove-native-loop.log kprove audit-native-loop-spec.k --definition audit-native-loop-kompiled --spec-module AUDIT-NATIVE-LOOP-SPEC' in /tmp/audit-work/candidate
