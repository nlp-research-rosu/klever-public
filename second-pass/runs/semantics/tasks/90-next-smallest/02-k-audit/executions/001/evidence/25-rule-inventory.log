RECORD 1113	/tmp/audit-work/candidate/verification.k:54	KIND=rule	ATTRS=equational
  rule intsEmpty(nilInts) => true

RECORD 1114	/tmp/audit-work/candidate/verification.k:55	KIND=rule	ATTRS=equational
  rule intsEmpty(consInts(_:Int, _:Ints)) => false

RECORD 1115	/tmp/audit-work/candidate/verification.k:56	KIND=rule	ATTRS=equational
  rule intsHead(consInts(X:Int, _:Ints)) => X

RECORD 1116	/tmp/audit-work/candidate/verification.k:57	KIND=rule	ATTRS=equational
