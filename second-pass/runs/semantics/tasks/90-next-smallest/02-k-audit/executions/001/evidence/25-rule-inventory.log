requires "reference-semantics/semantics.k"

RECORD 1098	/tmp/audit-work/candidate/verification.k:3	KIND=module	ATTRS=-
module NEXT-SMALLEST-VERIFICATION

RECORD 1099	/tmp/audit-work/candidate/verification.k:4	KIND=imports	ATTRS=-
  imports MPY

RECORD 1100	/tmp/audit-work/candidate/verification.k:8	KIND=syntax	ATTRS=macro
  syntax Stmts ::= "nextSmallestLoopBody" [macro]

RECORD 1101	/tmp/audit-work/candidate/verification.k:9	KIND=rule	ATTRS=equational
  rule nextSmallestLoopBody =>
    If(Compare(Name("count"), CmpOp("==", Int(0))),
       Assign(Name("smallest"), Name("value"))
       Assign(Name("count"), Int(1)),
       If(Compare(Name("value"), CmpOp("<", Name("smallest"))),
          Assign(Name("second"), Name("smallest"))
          Assign(Name("count"), Int(2))
          Assign(Name("smallest"), Name("value")),
          If(Compare(Name("value"), CmpOp("!=", Name("smallest"))),
             If(BoolOp("or",
                       (Compare(Name("count"), CmpOp("==", Int(1))),
                        Compare(Name("value"), CmpOp("<", Name("second"))),
                        .Exprs)),
                Assign(Name("second"), Name("value"))
                Assign(Name("count"), Int(2)),
                .Stmts) .Stmts,
             .Stmts) .Stmts))

RECORD 1102	/tmp/audit-work/candidate/verification.k:27	KIND=syntax	ATTRS=macro
  syntax Stmts ::= "nextSmallestReturn" [macro]

RECORD 1103	/tmp/audit-work/candidate/verification.k:28	KIND=rule	ATTRS=equational
  rule nextSmallestReturn =>
    If(Compare(Name("count"), CmpOp("==", Int(2))),
       Return(Name("second")) .Stmts,
       .Stmts)
    Return(NoneVal)

RECORD 1104	/tmp/audit-work/candidate/verification.k:34	KIND=syntax	ATTRS=macro
  syntax Stmts ::= "nextSmallestBody" [macro]

RECORD 1105	/tmp/audit-work/candidate/verification.k:35	KIND=rule	ATTRS=equational
  rule nextSmallestBody =>
    Assign(Name("smallest"), Int(0))
    Assign(Name("second"), Int(0))
    Assign(Name("count"), Int(0))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("lst"), nextSmallestLoopBody)
    nextSmallestReturn

RECORD 1106	/tmp/audit-work/candidate/verification.k:43	KIND=syntax	ATTRS=macro
  syntax Module ::= "solutionModule" [macro]

RECORD 1107	/tmp/audit-work/candidate/verification.k:44	KIND=rule	ATTRS=equational
  rule solutionModule =>
    Module(FuncDef("next_smallest", Params("lst"), nextSmallestBody))

