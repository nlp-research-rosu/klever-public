diff --git a//tmp/audit-work/proof/body-mutation-spec.k b//tmp/audit-work/proof/body-mutation-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..52cf081b53f6ccf67a7878c1e208d6669c4b76a9
--- /dev/null
+++ b//tmp/audit-work/proof/body-mutation-spec.k
@@ -0,0 +1,41 @@
+requires "body-mutant-verification.k"
+
+module BODY-MUTATION-SPEC
+  imports NEXT-SMALLEST-BODY-MUTANT
+
+  claim
+    <k>
+      #loop(list(intVals(INPUT:Ints)),
+            Name("value"),
+            nextSmallestLoopBody)
+      ~> nextSmallestReturn
+      ~> #endcall
+    =>
+      nsScan(INPUT, SMALLEST:Int, SECOND:Int, COUNT:Int)
+      ~> CONT:K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (SC:Map
+       1 |-> scope(("value" |-> OLD_VALUE:Int
+                    "lst" |-> LST:Val
+                    "smallest" |-> SMALLEST
+                    "second" |-> SECOND
+                    "count" |-> COUNT),
+                   parent(0)))
+    =>
+      ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map => HEAP </heap>
+    <heapLoc> HLOC:Int => HLOC </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1)) REST:List
+    =>
+      REST
+    </stack>
+    <ret> noRet => noRet </ret>
+    <exc> EXC:Exc => EXC </exc>
+    <exit-code> CODE:Int => CODE </exit-code>
+    requires notBool (1 in_keys(SC))
+endmodule
