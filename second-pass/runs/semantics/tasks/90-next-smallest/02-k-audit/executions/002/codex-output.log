+        1 |-> scope(("value" |-> OLD_VALUE
+                     "lst" |-> LST
+                     "smallest" |-> SMALLEST
+                     "second" |-> SECOND
+                     "count" |-> COUNT),
+                    parent(0))) [1 <- undef])
+    </scopes>
