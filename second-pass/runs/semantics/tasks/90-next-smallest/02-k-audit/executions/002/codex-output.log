diff --git a/evidence/witness-spec.k b/evidence/witness-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b7aa7923509763e8953c6bf4b6420a5e1639121a
--- /dev/null
+++ b/evidence/witness-spec.k
@@ -0,0 +1,16 @@
+requires "verification.k"
