index 0000000000000000000000000000000000000000..87f19d1ad486217597407af7168afcc3edd11a23
--- /dev/null
+++ b//tmp/audit-work/proof/bridge-connection-spec.k
@@ -0,0 +1,47 @@
+requires "bridge-validation.k"
+
+module BRIDGE-CONNECTION-SPEC
+  imports BRIDGE-VALIDATION
+
+  claim
+    <k>
+      #loop(list(intVals(INPUT:Ints)),
+            Name("value"),
+            nextSmallestLoopBody)
+      ~> nextSmallestReturn
+      ~> #endcall
+    =>
+      nsScan(INPUT, SMALLEST:Int, SECOND:Int, COUNT:Int)
+      ~> CONT:K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (SC:Map
+       1 |-> scope(("value" |-> OLD_VALUE:Int
+                    "lst" |-> LST:Val
+                    "smallest" |-> SMALLEST
+                    "second" |-> SECOND
+                    "count" |-> COUNT),
+                   parent(0)))
+    =>
+      ((SC
+        1 |-> scope(("value" |-> OLD_VALUE
+                     "lst" |-> LST
+                     "smallest" |-> SMALLEST
+                     "second" |-> SECOND
+                     "count" |-> COUNT),
+                    parent(0))) [1 <- undef])
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1)) REST:List
+    =>
+      REST
+    </stack>
+    <ret> noRet </ret>
+    <exc> EXC:Exc </exc>
+    <exit-code> CODE:Int </exit-code>
+    requires notBool (1 in_keys(SC))
+endmodule
diff --git a//tmp/audit-work/proof/bridge-validation.k b//tmp/audit-work/proof/bridge-validation.k
new file mode 100644
index 0000000000000000000000000000000000000000..30bc58ad46f104a046949a6294d5192183c94f92
--- /dev/null
+++ b//tmp/audit-work/proof/bridge-validation.k
@@ -0,0 +1,11 @@
+requires "verification.k"
+
+module BRIDGE-VALIDATION
+  imports NEXT-SMALLEST-VERIFICATION
+
+  // K's finite-map update with `undef` deletes a key.  This lemma makes the
+  // otherwise opaque symbolic deletion normalization available to the prover.
+  rule ((SC:Map 1 |-> S:Scope) [1 <- undef]) => SC
+    requires notBool (1 in_keys(SC))
+    [simplification]
+endmodule
