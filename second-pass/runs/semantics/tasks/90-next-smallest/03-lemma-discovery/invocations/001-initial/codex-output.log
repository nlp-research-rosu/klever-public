import json
from pathlib import Path
inv=json.loads(Path('/reference/rule-inventory.json').read_text())
out=json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert list(out.keys()) == ['schema_version','inventory_sha256','rules'], list(out)
assert out['schema_version']==2
assert out['inventory_sha256']==inv['inventory_sha256']
assert len(out['rules'])==len(inv['rules'])
for i,(got,want) in enumerate(zip(out['rules'],inv['rules']),1):
    assert list(got.keys())==['source_rule_id','classification','rationale'], (i,list(got))
    assert got['source_rule_id']==want['source_rule_id'], i
    assert got['classification'] in allowed, (i,got['classification'])
    assert isinstance(got['rationale'],str) and got['rationale'].strip(), i
assert len({r['source_rule_id'] for r in out['rules']})==len(out['rules'])
for r0,r1 in zip(inv['rules'],out['rules']):
    if any(a=='simplification' or a.startswith('simplification(') for a in r0['attributes']):
        assert r1['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
from collections import Counter
print('validated',len(out['rules']),'rules')
print(Counter(r['classification'] for r in out['rules']))
print('inventory_sha256',out['inventory_sha256'])
PY
