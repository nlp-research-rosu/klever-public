+        refine Rewrites.tran
+          (continue_loop (by rfl)) ?_
+        exact ih 1 SECOND value value
+      · have count_bool : (COUNT == 0) = false := by
+          simp [count_zero]
+        simp only [count_bool, if_neg count_zero]
+        finish_if_false
+        trace_state
+        sorry
 
