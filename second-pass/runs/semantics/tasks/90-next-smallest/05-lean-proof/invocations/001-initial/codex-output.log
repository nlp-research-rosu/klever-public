+            (HOLE := SortExpr.inj_SortInt $right)
+            (_Gen0 := SortVal.inj_SortInt $left) (_Gen1 := $operator)
+            (_Val0 := true) (_Val1 := true)
+            (by rfl) (by rfl) rfl) ?_;
