+        by_cases value_lt : value < SMALLEST
+        · simp only [value_lt]
+          finish_if_true
+          trace_state
+          sorry
+        · have value_bool : (value < SMALLEST) = false := by
+            exact decide_eq_false value_lt
+          simp only [value_bool, if_neg value_lt]
+          finish_if_false
+          trace_state
+          sorry
 
