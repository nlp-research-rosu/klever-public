+      by_cases count_two : COUNT = 2
+      · simp [count_two]
+        refine Rewrites.tran
+          (Rewrites.«MPY_SYNTAX_If(_,_,_)_MPY_SYNTAX_Stmt_Expr_Stmts_Stmts1_cool»
+            (HOLE := SortExpr.inj_SortBool true)
