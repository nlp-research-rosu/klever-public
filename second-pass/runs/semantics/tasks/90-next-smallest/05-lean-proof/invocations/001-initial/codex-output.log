+        simp only [inj_val_int]
+        refine Rewrites.tran
+          (Rewrites.«MPY_SYNTAX_Return(_)_MPY_SYNTAX_Stmt_Expr1_cool»
+            (HOLE := SortExpr.inj_SortInt SECOND)
