+            (LV := SortVal.inj_SortInt $left)
+            (RV := SortVal.inj_SortInt $right) (OP := $operator)
+            (_Val0 := $result) (by rfl)) ?_)
+
+syntax "finish_if_true" : tactic
+macro_rules
+  | `(tactic| finish_if_true) =>
