+      refine Rewrites.tran Rewrites._94bd14e ?_
+      refine Rewrites.tran
+        (Rewrites.«MPY_SYNTAX_If(_,_,_)_MPY_SYNTAX_Stmt_Expr_Stmts_Stmts1_heat»
+          (by rfl) (by rfl) (by rfl) rfl) ?_
+      refine Rewrites.tran
