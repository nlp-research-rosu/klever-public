+syntax "heat_assign_name" "(" term ", " term ")" : tactic
+macro_rules
+  | `(tactic| heat_assign_name ($target, $source)) =>
+      `(tactic|
+        refine Rewrites.tran
+          (Rewrites.«MPY_SYNTAX_Assign(_,_)_MPY_SYNTAX_Stmt_Expr_Expr2_heat»
