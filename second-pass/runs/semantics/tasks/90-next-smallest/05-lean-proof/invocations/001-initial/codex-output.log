+  let goals ← getGoals
+  let goal ← getMainGoal
+  let restGoals := goals.tail
+  let target ← whnf (← goal.getType)
+  let targetArgs := target.getAppArgs
+  unless targetArgs.size = 2 do
+    throwError "kstep: expected a binary Rewrites goal"
