+    let patternArgs := pattern.getAppArgs
+    let actualArgs := actual.getAppArgs
+    if patternArgs.size = actualArgs.size then
+      for index in [:patternArgs.size] do
+        seedGeneratedInjections patternArgs[index]! actualArgs[index]!
