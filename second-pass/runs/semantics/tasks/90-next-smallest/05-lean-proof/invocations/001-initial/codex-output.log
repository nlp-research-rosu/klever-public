--- /dev/null
+++ b/lean-proc-fix.c
@@ -0,0 +1,53 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+extern char *program_invocation_name;
+
+static int is_proc_exe(const char *path) {
+  size_t length;
+  if (path == NULL || strncmp(path, "/proc/", 6) != 0) return 0;
+  length = strlen(path);
