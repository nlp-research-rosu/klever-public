+        iterate 5 kstep
+        simp [count_not_two]
+        iterate 5 kstep
+        trace_state
+        sorry
+  | «consInts(_,_)_NEXT-SMALLEST-VERIFICATION_Ints_Int_Ints» value rest =>
+      sorry
 
