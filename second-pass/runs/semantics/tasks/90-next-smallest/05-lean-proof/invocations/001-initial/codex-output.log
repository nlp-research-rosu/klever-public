+        refine Rewrites.tran
+          (Rewrites.«MPY_SYNTAX_Assign(_,_)_MPY_SYNTAX_Stmt_Expr_Expr2_cool»
+            (HOLE := SortExpr.inj_SortInt $value)
+            (K0 := SortExpr.«Name(_)_MPY-SYNTAX_Expr_String» $target)
+            (_Val0 := true) (_Val1 := true)
+            (by rfl) (by rfl) rfl) ?_)
