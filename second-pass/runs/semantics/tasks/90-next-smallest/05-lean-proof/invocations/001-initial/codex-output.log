+                  | _ => pure []
+                else
+                  pure [actualConstructor.getString!]
+              for suffix in suffixes do
+                let liftedConstructor := Name.str targetSort suffix
+                if (← getEnv).contains liftedConstructor then
+                  let lifted ← mkAppM liftedConstructor #[payloadActual]
