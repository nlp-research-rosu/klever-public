index 809f05c5466d57405159171b13be88ab1ff0a442..bbcf5b8b093d14edc83f717e7a9db5f446bafeab
--- a/Proof.lean
+++ b/Proof.lean
@@ -1,26 +1,982 @@
+import Init.Classical
+import Proof.KStep
 import Klean90NextSmallest.Lemmas
 
