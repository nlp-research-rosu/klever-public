+@[simp] theorem inj_val_bool (value : SortBool) :
+    (@inj SortVal SortKItem) (SortVal.inj_SortBool value) =
+      SortKItem.inj_SortBool value := by
+  rfl
+
+@[simp] theorem singleton_concat_of_fresh
