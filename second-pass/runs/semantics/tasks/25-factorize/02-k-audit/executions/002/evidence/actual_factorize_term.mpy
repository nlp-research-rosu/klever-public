FuncDef("factorize", Params("n"),
  Assign(Name("factors"), ListExpr())
  Assign(Name("divisor"), Int(2))
  While(Compare(Name("n"), CmpOp(">", Int(1))),
    If(Compare(
      BinOp("%", Name("n"), Name("divisor")),
      CmpOp("==", Int(0))),
      Expr(
        Call(Attribute(Name("factors"), "append"), Name("divisor")))
      Assign(Name("n"), BinOp("//", Name("n"), Name("divisor"))),
      AugAssign(Name("divisor"), "+", Int(1))))
  Return(Name("factors")))
