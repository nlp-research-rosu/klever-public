+  exit 2
+fi
+
+mkdir -p "$audit_work"
+cp /candidate/solution.py "$audit_work/solution.py"
+cp /candidate/solution.mpy "$audit_work/solution.mpy.submitted"
+cp /candidate/spec.k "$audit_work/spec.k"
+cp /candidate/verification.k "$audit_work/verification.k"
