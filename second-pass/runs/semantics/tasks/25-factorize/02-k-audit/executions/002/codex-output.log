index 0000000000000000000000000000000000000000..0cff062e8db747b7c25474ef84fae19f21000f18
--- /dev/null
+++ b/evidence/actual_factorize_term.mpy
@@ -0,0 +1,12 @@
+FuncDef("factorize", Params("n"),
+  Assign(Name("factors"), ListExpr())
+  Assign(Name("divisor"), Int(2))
+  While(Compare(Name("n"), CmpOp(">", Int(1))),
+    If(Compare(
+      BinOp("%", Name("n"), Name("divisor")),
+      CmpOp("==", Int(0))),
+      Expr(
+        Call(Attribute(Name("factors"), "append"), Name("divisor")))
+      Assign(Name("n"), BinOp("//", Name("n"), Name("divisor"))),
+      AugAssign(Name("divisor"), "+", Int(1))))
+  Return(Name("factors")))
diff --git a/evidence/concrete_audit.py b/evidence/concrete_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..1110eae01d90def02b4a711991530cf0b683117f
--- /dev/null
+++ b/evidence/concrete_audit.py
@@ -0,0 +1,24 @@
+from typing import List
+
+
+def factorize(n: int) -> List[int]:
+    factors = []
+    divisor = 2
+    while n > 1:
+        if n % divisor == 0:
+            factors.append(divisor)
+            n = n // divisor
+        else:
+            divisor += 1
+    return factors
+
+
+assert factorize(1) == []
+assert factorize(2) == [2]
+assert factorize(3) == [3]
+assert factorize(4) == [2, 2]
+assert factorize(8) == [2, 2, 2]
+assert factorize(25) == [5, 5]
+assert factorize(70) == [2, 5, 7]
+assert factorize(97) == [97]
+assert factorize(360) == [2, 2, 2, 3, 3, 5]
