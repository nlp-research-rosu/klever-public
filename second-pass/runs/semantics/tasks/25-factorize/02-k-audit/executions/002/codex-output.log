@@ -0,0 +1,34 @@
+requires "verification.k"
+
+module AUDIT-BRIDGE-CONTINUATION
+  imports FACTORIZE-VERIFICATION
+
+  // A concrete loop followed by an observable scope update. The same claim is
+  // run once with only fixed semantics and once with the promoted loop rule.
+  claim [loop-preserves-continuation]:
+    <k>
+      #while(Compare(Name("n"), CmpOp(">", Int(1))), factorizeStep)
+      ~> Assign(Name("after"), Int(99))
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("n" |-> 4
+         "divisor" |-> 2
+         "factors" |-> ref(0)),
+        parent(0))
+      =>
+      1 |-> scope(
+        ("n" |-> 1
+         "divisor" |-> 2
+         "factors" |-> ref(0)
+         "after" |-> 99),
+        parent(0))
+    </scopes>
+    <heap>
+      0 |-> list(.ValSeq)
+      =>
+      0 |-> list(vCons(2, vCons(2, .ValSeq)))
+    </heap>
+endmodule
diff --git a/evidence/spec_concrete_substitutions.k b/evidence/spec_concrete_substitutions.k
new file mode 100644
index 0000000000000000000000000000000000000000..fc7bc0a71170bc90ce5f436cc2681c02c1f912e4
--- /dev/null
+++ b/evidence/spec_concrete_substitutions.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module AUDIT-CONCRETE-SUBSTITUTIONS
+  imports FACTORIZE-VERIFICATION-WITH-LOOP-LEMMA
+
+  claim [factorize-one]:
+    <k> Call(Name("factorize"), Int(1)) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("factorize" |-> closureVal("n", factorizeBody, 0), parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 => 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
+  claim [factorize-eight]:
+    <k> Call(Name("factorize"), Int(8)) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("factorize" |-> closureVal("n", factorizeBody, 0), parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
