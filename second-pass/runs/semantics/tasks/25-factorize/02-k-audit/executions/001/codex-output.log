+
+    print("--- COMPLETE_RECORDS ---")
+    for ordinal, (path, start, end, record_kind, text) in enumerate(records, 1):
+        attrs = [attr for attr in ATTRS if re.search(rf"\b{re.escape(attr)}\b", text)]
