+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf '%s\n' '--- OUTPUT ---'
+} >"$logfile"
+
+set +e
+"$@" >>"$logfile" 2>&1
+status=$?
+set -e
+
+{
+  printf '%s\n' '--- END OUTPUT ---'
+  printf 'EXIT_STATUS: %d\n' "$status"
+} >>"$logfile"
+
+exit "$status"

