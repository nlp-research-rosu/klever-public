diff --git a/evidence/body-mutation-ground-spec.k b/evidence/body-mutation-ground-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5bfd180aae38ad43e78120696c421f49c12ae33f
--- /dev/null
+++ b/evidence/body-mutation-ground-spec.k
@@ -0,0 +1,32 @@
+requires "verification.k"
+
+module FACTORIZE-BODY-MUTATION-GROUND-SPEC
+  imports FACTORIZE-VERIFICATION
+
+  // Satisfiable loop-head witness N=2,D=2,VS=[].
+  // The original body appends 2 and reaches n=1; the mutated body appends 3.
+  claim [mutated-loop-must-not-have-original-result]:
+    <k>
+      #while(Compare(Name("n"), CmpOp(">", Int(1))), factorizeStep)
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("n" |-> 2
+         "divisor" |-> 2
+         "factors" |-> ref(0)),
+        parent(0))
+      =>
+      1 |-> scope(
+        ("n" |-> 1
+         "divisor" |-> 2
+         "factors" |-> ref(0)),
+        parent(0))
+    </scopes>
+    <heap>
+      0 |-> list(.ValSeq)
+      =>
+      0 |-> list(vCons(2, .ValSeq))
+    </heap>
+endmodule
diff --git a/evidence/concrete_audit.py b/evidence/concrete_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..9cb0303c10ab540c8af8bffafbd67ccdbfc599f2
--- /dev/null
+++ b/evidence/concrete_audit.py
@@ -0,0 +1,25 @@
+from typing import List
+
+
+def factorize(n: int) -> List[int]:
+    factors = []
+    divisor = 2
+    while n > 1:
+        if n % divisor == 0:
+            factors.append(divisor)
+            n = n // divisor
+        else:
+            divisor += 1
+    return factors
+
+
+# Independently chosen normal, loop-boundary, branch, multiplicity, and prime cases.
+assert factorize(1) == []
+assert factorize(2) == [2]
+assert factorize(3) == [3]
+assert factorize(4) == [2, 2]
+assert factorize(8) == [2, 2, 2]
+assert factorize(25) == [5, 5]
+assert factorize(70) == [2, 5, 7]
+assert factorize(97) == [97]
+assert factorize(360) == [2, 2, 2, 3, 3, 5]
diff --git a/evidence/continuation-probe-spec.k b/evidence/continuation-probe-spec.k
