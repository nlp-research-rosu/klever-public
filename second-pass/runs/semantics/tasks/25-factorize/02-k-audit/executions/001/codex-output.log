+      => 0 |-> list(
+           valSeqConcat(
+             primeFactors(N),
+             vCons(2, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires N >=Int 1
+endmodule

