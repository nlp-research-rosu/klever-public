import json
from collections import Counter
from pathlib import Path
inv = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
expected = [r['source_rule_id'] for r in inv['rules']]
actual = [r['source_rule_id'] for r in out['rules']]
assert actual == expected
assert all(set(r) == {'source_rule_id', 'classification', 'rationale'} for r in out['rules'])
assert all(r['classification'] in allowed for r in out['rules'])
assert all(isinstance(r['rationale'], str) and r['rationale'].strip() for r in out['rules'])
assert all(n == 1 for n in Counter(actual).values())
by_id = {r['source_rule_id']: r for r in out['rules']}
for rule in inv['rules']:
    if any(a == 'simplification' or a.startswith('simplification(') for a in rule['attributes']):
        assert by_id[rule['source_rule_id']]['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
counts = Counter(r['classification'] for r in out['rules'])
assert counts == {'DEFINITION': 10, 'PROVED_DERIVED_LEMMA': 1}
print('trust-boundary validation passed')
print('inventory rules:', len(expected))
print('classifications:', dict(counts))
