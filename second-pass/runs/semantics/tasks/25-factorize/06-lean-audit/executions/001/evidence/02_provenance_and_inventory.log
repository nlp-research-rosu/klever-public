      "text": "  rule factorizeStep\n    => If(\n         Compare(BinOp(\"%\", Name(\"n\"), Name(\"divisor\")),\n                 CmpOp(\"==\", Int(0))),\n         Expr(Call(Attribute(Name(\"factors\"), \"append\"), Name(\"divisor\")))\n         Assign(Name(\"n\"), BinOp(\"//\", Name(\"n\"), Name(\"divisor\"))),\n         AugAssign(Name(\"divisor\"), \"+\", Int(1)))"
    },
    {
      "attributes": [],
      "end_line": 21,
      "manual_normalized_sha256": "ff36487c2202b88e3202d1e6622812de6a27d82188e3b7999b6c7c7be54797e8",
      "manual_source_rule_id": "rule-ff36487c2202b88e3202d1e6622812de6a27d82188e3b7999b6c7c7be54797e8",
      "module": "FACTORIZE-VERIFICATION",
      "normalized_sha256": "ff36487c2202b88e3202d1e6622812de6a27d82188e3b7999b6c7c7be54797e8",
      "self_consistent": true,
      "source_rule_id": "rule-ff36487c2202b88e3202d1e6622812de6a27d82188e3b7999b6c7c7be54797e8",
      "start_line": 17,
      "text": "  rule factorizeBody\n    => Assign(Name(\"factors\"), ListExpr(.Exprs))\n       Assign(Name(\"divisor\"), Int(2))\n       While(Compare(Name(\"n\"), CmpOp(\">\", Int(1))), factorizeStep)\n       Return(Name(\"factors\"))"
    },
