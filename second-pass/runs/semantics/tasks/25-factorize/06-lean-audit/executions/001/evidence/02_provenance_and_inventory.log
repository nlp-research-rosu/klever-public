      "start_line": 67,
      "text": "  rule\n    <k>\n      #while(Compare(Name(\"n\"), CmpOp(\">\", Int(1))), factorizeStep)\n      ~> KONT\n      => KONT\n    </k>\n    <env> L </env>\n    <scopes>\n      (L |-> scope(\n        (\"n\" |-> N\n         \"divisor\" |-> D\n         \"factors\" |-> ref(H)),\n        parent(0)))\n      SC\n      =>\n      (L |-> scope(\n        (\"n\" |-> 1\n         \"divisor\" |-> factorDivisor(N, D)\n         \"factors\" |-> ref(H)),\n        parent(0)))\n      SC\n    </scopes>\n    <heap>\n      (H |-> list(VS)) HP\n      => (H |-> list(factorLoop(N, D, VS))) HP\n    </heap>\n    requires N >=Int 1 andBool D >=Int 2\n    [priority(40), label(factorize-loop-lemma)]"
    }
