diff --git a/evidence/proc_self_exe_compat.c b/evidence/proc_self_exe_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..a353d1ed0a246f47bca48efd4ca624fb069cd424
--- /dev/null
+++ b/evidence/proc_self_exe_compat.c
@@ -0,0 +1,37 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+/*
+ * The audit container's PID namespace can expose a process-local PID that has
+ * no matching /proc/<pid>/exe entry. Lean 4.22 queries that numeric entry.
+ * Fall back to the kernel's equivalent /proc/self/exe only for that failed
+ * read, leaving every successful read and every other path unchanged.
+ */
+ssize_t readlink(const char *path, char *buf, size_t size) {
+    static readlink_fn real_readlink;
+    if (!real_readlink) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    ssize_t result = real_readlink(path, buf, size);
+    if (
+        result < 0
+        && errno == ENOENT
+        && strncmp(path, "/proc/", 6) == 0
+    ) {
+        const char *cursor = path + 6;
+        if (*cursor >= '0' && *cursor <= '9') {
+            while (*cursor >= '0' && *cursor <= '9') {
+                cursor++;
+            }
+            if (strcmp(cursor, "/exe") == 0) {
+                result = real_readlink("/proc/self/exe", buf, size);
+            }
+        }
+    }
+    return result;
+}

exec
/bin/bash -lc 'cp /audit-output/evidence/05_stage4_preflight.log /audit-output/evidence/05_stage4_preflight_initial_failure.log; cp /audit-output/evidence/05_stage4_preflight.exit /audit-output/evidence/05_stage4_preflight_initial_failure.exit; LD_PRELOAD=/tmp/audit-work/proc_self_exe_compat.so bash /audit-output/evidence/05_stage4_preflight.sh > /audit-output/evidence/05_stage4_preflight.log 2>&1; audit_rc=$?; printf '"'exit_code=%s\\n' \""'$audit_rc" > /audit-output/evidence/05_stage4_preflight.exit; sed -n '"'1,420p' /audit-output/evidence/05_stage4_preflight.log" in /audit-output
diff --git a//tmp/audit-work/readlink_trace.c b//tmp/audit-work/readlink_trace.c
new file mode 100644
index 0000000000000000000000000000000000000000..a472ca7a09883c11edaa352020ef8da1d6fab108
--- /dev/null
+++ b//tmp/audit-work/readlink_trace.c
@@ -0,0 +1,73 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+typedef ssize_t (*readlinkat_fn)(int, const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+    static readlink_fn real_readlink;
+    if (!real_readlink) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    ssize_t result = real_readlink(path, buf, size);
+    int saved_errno = errno;
+    char line[2048];
+    int length = snprintf(
+        line,
+        sizeof(line),
+        "readlink path=%s result=%zd errno=%d value=%.*s\n",
+        path,
+        result,
+        saved_errno,
+        result > 0 ? (int)result : 0,
+        result > 0 ? buf : ""
+    );
+    int fd = open(
+        "/tmp/audit-work/readlink_trace.log",
+        O_WRONLY | O_CREAT | O_APPEND,
+        0600
+    );
+    if (fd >= 0) {
+        write(fd, line, (size_t)length);
+        close(fd);
+    }
+    errno = saved_errno;
+    return result;
+}
+
+ssize_t readlinkat(int dirfd, const char *path, char *buf, size_t size) {
+    static readlinkat_fn real_readlinkat;
+    if (!real_readlinkat) {
+        real_readlinkat = (readlinkat_fn)dlsym(RTLD_NEXT, "readlinkat");
+    }
+    ssize_t result = real_readlinkat(dirfd, path, buf, size);
+    int saved_errno = errno;
+    char line[2048];
+    int length = snprintf(
+        line,
+        sizeof(line),
+        "readlinkat dirfd=%d path=%s result=%zd errno=%d value=%.*s\n",
+        dirfd,
+        path,
+        result,
+        saved_errno,
+        result > 0 ? (int)result : 0,
+        result > 0 ? buf : ""
+    );
+    int fd = open(
+        "/tmp/audit-work/readlink_trace.log",
+        O_WRONLY | O_CREAT | O_APPEND,
+        0600
+    );
+    if (fd >= 0) {
+        write(fd, line, (size_t)length);
+        close(fd);
+    }
+    errno = saved_errno;
+    return result;
+}
