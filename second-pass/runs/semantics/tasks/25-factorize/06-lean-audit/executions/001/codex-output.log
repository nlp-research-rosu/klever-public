/bin/bash -lc 'bash /audit-output/evidence/05_preflight_environment_fix.sh > /audit-output/evidence/05_preflight_environment_fix.log 2>&1
audit_rc=$?
printf '"'exit_code=%s\\n' \""'$audit_rc" > /audit-output/evidence/05_preflight_environment_fix.exit
export LD_PRELOAD=/tmp/audit-work/proc_self_exe_compat.so
bash /audit-output/evidence/05_stage4_preflight.sh > /audit-output/evidence/05_stage4_preflight.log 2>&1
audit_rc=$?
printf '"'exit_code=%s\\n' \""'$audit_rc" > /audit-output/evidence/05_stage4_preflight.exit
