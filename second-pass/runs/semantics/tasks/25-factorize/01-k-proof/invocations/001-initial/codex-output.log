new file mode 100644
index 0000000000000000000000000000000000000000..a5b3d2c66d11b81a206ed33303d8ea089cf29087
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+from typing import List
+
+
+def factorize(n: int) -> List[int]:
+    factors = []
+    divisor = 2
+    while n > 1:
+        if n % divisor == 0:
+            factors.append(divisor)
+            n = n // divisor
+        else:
+            divisor += 1
+    return factors
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c9c2a7256d3fe0779058d1b404e81f2f22089c09
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,60 @@
+requires "verification.k"
+
+module FACTORIZE-SPEC
+  imports FACTORIZE-VERIFICATION
+
+  // Loop invariant and summary.  It is proved first, then made available as a
+  // proved lemma for the entry-point theorem by prove.sh.
+  claim [factorize-loop]:
+    <k>
+      #while(Compare(Name("n"), CmpOp(">", Int(1))), factorizeStep)
+      ~> KONT
+      => KONT
+    </k>
+    <env> L </env>
+    <scopes>
+      (L |-> scope(
+        ("n" |-> N
+         "divisor" |-> D
+         "factors" |-> ref(H)),
+        parent(0)))
+      SC
+      =>
+      (L |-> scope(
+        ("n" |-> 1
+         "divisor" |-> factorDivisor(N, D)
+         "factors" |-> ref(H)),
+        parent(0)))
+      SC
+    </scopes>
+    <heap>
+      (H |-> list(VS)) HP
+      => (H |-> list(factorLoop(N, D, VS))) HP
+    </heap>
+    requires N >=Int 1 andBool D >=Int 2
+
+  // Public theorem: for every positive input, factorize returns the canonical
+  // ordered prime-factor sequence (the empty sequence for 1).
+  claim [factorize-correct]:
+    <k>
+      Call(Name("factorize"), Int(N))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "factorize" |-> closureVal("n", factorizeBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 => 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(primeFactors(N))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires N >=Int 1
+endmodule
