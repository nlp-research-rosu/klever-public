+  imports FACTORIZE-VERIFICATION
+
+  rule
+    <k>
+      #while(Compare(Name("n"), CmpOp(">", Int(1))), factorizeStep)
+      ~> KONT
+      => KONT
+    </k>
+    <env> L </env>
+    <scopes>
+      (L |-> scope(
+        ("n" |-> N
+         "divisor" |-> D
+         "factors" |-> ref(H)),
+        parent(0)))
+      SC
+      =>
+      (L |-> scope(
+        ("n" |-> 1
+         "divisor" |-> factorDivisor(N, D)
+         "factors" |-> ref(H)),
+        parent(0)))
+      SC
+    </scopes>
+    <heap>
+      (H |-> list(VS)) HP
+      => (H |-> list(factorLoop(N, D, VS))) HP
+    </heap>
+    requires N >=Int 1 andBool D >=Int 2
+    [label(factorize-loop-lemma)]
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module FACTORIZE-VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled && kompile verification.k --backend haskell --main-module FACTORIZE-VERIFICATION-WITH-LOOP-LEMMA --syntax-module MPY-SYNTAX --output-definition verification-with-lemma-kompiled' in /work
