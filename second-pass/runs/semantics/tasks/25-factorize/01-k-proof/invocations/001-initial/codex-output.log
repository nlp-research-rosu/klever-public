from solution import factorize

def is_prime(x):
    if x < 2:
        return False
    d = 2
    while d * d <= x:
        if x % d == 0:
            return False
        d += 1
    return True

for n in range(1, 1001):
    fs = factorize(n)
    assert fs == sorted(fs), (n, fs)
    assert all(is_prime(p) for p in fs), (n, fs)
    product = 1
    for p in fs:
        product *= p
    assert product == n, (n, fs, product)
print('independent Python contract check passed for n=1..1000')
PY" in /work
