diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..a5f5893d652a45fbe04a117ac3c15c68d216ac42
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,22 @@
+from typing import List
+
+
+def factorize(n: int) -> List[int]:
+    factors = []
+    divisor = 2
+    while n > 1:
+        if n % divisor == 0:
+            factors.append(divisor)
+            n = n // divisor
+        else:
+            divisor += 1
+    return factors
+
+
+assert factorize(1) == []
+assert factorize(2) == [2]
+assert factorize(8) == [2, 2, 2]
+assert factorize(25) == [5, 5]
+assert factorize(70) == [2, 5, 7]
+assert factorize(97) == [97]
+assert factorize(360) == [2, 2, 2, 3, 3, 5]
