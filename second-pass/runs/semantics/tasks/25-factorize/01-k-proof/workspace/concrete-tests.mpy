Module(
  ImportFrom("typing", "List")
  FuncDef("factorize", Params("n"),
    Assign(Name("factors"), ListExpr())
    Assign(Name("divisor"), Int(2))
    While(Compare(Name("n"), CmpOp(">", Int(1))),
      If(Compare(
        BinOp("%", Name("n"), Name("divisor")),
        CmpOp("==", Int(0))),
        Expr(
          Call(Attribute(Name("factors"), "append"), Name("divisor")))
        Assign(Name("n"), BinOp("//", Name("n"), Name("divisor"))),
        AugAssign(Name("divisor"), "+", Int(1))))
    Return(Name("factors")))
  Assert(
    Compare(Call(Name("factorize"), Int(1)), CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("factorize"), Int(2)),
      CmpOp("==", ListExpr(Int(2)))))
  Assert(
    Compare(
      Call(Name("factorize"), Int(8)),
      CmpOp("==", ListExpr(Int(2), Int(2), Int(2)))))
  Assert(
    Compare(
      Call(Name("factorize"), Int(25)),
      CmpOp("==", ListExpr(Int(5), Int(5)))))
  Assert(
    Compare(
      Call(Name("factorize"), Int(70)),
      CmpOp("==", ListExpr(Int(2), Int(5), Int(7)))))
  Assert(
    Compare(
      Call(Name("factorize"), Int(97)),
      CmpOp("==", ListExpr(Int(97)))))
  Assert(
    Compare(
      Call(Name("factorize"), Int(360)),
      CmpOp(
        "==",
        ListExpr(Int(2), Int(2), Int(2), Int(3), Int(3), Int(5))))))
