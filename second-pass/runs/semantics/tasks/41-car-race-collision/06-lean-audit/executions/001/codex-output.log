+  "verification_file": "verification.k",
+  "verification_module": "VERIFICATION",
+  "verification_modules": [
+    "VERIFICATION"
+  ],
+  "verification_sha256": "d12d37f461c934500948acbe2784945c8f09f41e72040506fb70507eb58e591b"
+}
