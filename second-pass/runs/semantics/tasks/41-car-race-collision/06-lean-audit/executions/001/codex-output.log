+    export_result["status"],
+)
+check(
+    "KLEAN_NO_OBLIGATIONS status: recorded preflight",
+    recorded_preflight["status"] == "KLEAN_NO_OBLIGATIONS",
+    recorded_preflight["status"],
+)
+check(
