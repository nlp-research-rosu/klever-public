     4	  imports VERIFICATION
     5	
     6	  claim
     7	    <k> #runCarRaceCollision(N:Int) => N *Int N </k>
     8	    <env> 0 </env>
     9	    <scopes>
    10	      0  |-> scope(.Map, parent(-1))
    11	      -1 |-> builtinsScope
    12	      =>
    13	      0  |-> scope(
    14	              "car_race_collision"
    15	                |-> closureVal(
    16	                      "n",
    17	                      Return(BinOp("*", Name("n"), Name("n"))),
    18	                      0),
    19	              parent(-1))
    20	      -1 |-> builtinsScope
    21	    </scopes>
    22	    <scopeLoc> 1 </scopeLoc>
    23	    <heap> .Map </heap>
    24	    <heapLoc> 0 </heapLoc>
    25	    <stack> .List </stack>
    26	    <ret> noRet </ret>
    27	    <exc> NoExc </exc>
    28	    <exit-code> 0 </exit-code>
    29	endmodule

===== solution.py =====
     1	def car_race_collision(n: int):
     2	    return n * n

===== solution.mpy =====
     1	Module(
     2	  FuncDef("car_race_collision", Params("n"),
     3	    Return(BinOp("*", Name("n"), Name("n")))))

===== prove.sh =====
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Recreate the required transliteration and ensure the concrete driver embeds
     5	# exactly the implementation from solution.py.
     6	python3 py2mpy.py solution.py > solution.mpy
     7	sed -n '1,2p' concrete_tests.py | diff -u solution.py -
     8	python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
     9	
    10	# Concrete execution under the required LLVM main and syntax modules.
    11	kompile reference-semantics/semantics.k \
    12	  --backend llvm \
    13	  --main-module MPY-KRUN \
    14	  --syntax-module MPY-SYNTAX \
    15	  --output-definition runtime-kompiled
    16	krun concrete_tests.mpy --definition runtime-kompiled
    17	
    18	# Symbolic proof. VERIFICATION imports MPY, which deliberately excludes the
    19	# concrete-only MPY-CONCRETE extension.
    20	kompile verification.k \
    21	  --backend haskell \
    22	  --main-module VERIFICATION \
    23	  --syntax-module VERIFICATION \
    24	  --output-definition verification-kompiled
    25	kprove spec.k \
    26	  --definition verification-kompiled \
    27	  --spec-module SPEC

