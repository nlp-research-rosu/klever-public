Module(
  FuncDef("car_race_collision", Params("n"),
    Return(BinOp("*", Name("n"), Name("n"))))
  Assert(
    Compare(
      Call(Name("car_race_collision"), Int(0)),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("car_race_collision"), Int(1)),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("car_race_collision"), Int(2)),
      CmpOp("==", Int(4))))
  Assert(
    Compare(
      Call(Name("car_race_collision"), Int(10)),
      CmpOp("==", Int(100))))
  Assert(
    Compare(
      Call(Name("car_race_collision"), UnaryOp("-", Int(3))),
      CmpOp("==", Int(9)))))
