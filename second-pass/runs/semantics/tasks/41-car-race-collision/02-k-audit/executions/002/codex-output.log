diff --git a//tmp/audit-work/reconstruct/verification-body-mutant.k b//tmp/audit-work/reconstruct/verification-body-mutant.k
new file mode 100644
index 0000000000000000000000000000000000000000..606c8c62ef4635181f94ed66bdd26fc5452d443c
