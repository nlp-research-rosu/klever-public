+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // Fresh auditor mutation: the real program returns N*N, never N*N+1.
+  // N=3 is a satisfying witness for which the false target demands 10.
+  claim
+    <k> #runCarRaceCollision(N:Int) => (N *Int N) +Int 1 </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+              "car_race_collision"
+                |-> closureVal(
+                      "n",
+                      Return(BinOp("*", Name("n"), Name("n"))),
+                      0),
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/reconstruct/spec-witness.k b//tmp/audit-work/reconstruct/spec-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..2b76f04fc5f0826a744820a430c85ed90d56e1f7
