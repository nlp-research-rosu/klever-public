+
+module SPEC-BODY-MUTANT
+  imports VERIFICATION-BODY-MUTANT
+
+  claim
+    <k> #runMutatedCarRaceCollision(N:Int) => N *Int N </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
