diff --git a//tmp/audit-work/reconstruct/spec-body-mutant.k b//tmp/audit-work/reconstruct/spec-body-mutant.k
new file mode 100644
index 0000000000000000000000000000000000000000..842b0f42caf978279532b3506220a2242fc6da30
--- /dev/null
+++ b//tmp/audit-work/reconstruct/spec-body-mutant.k
@@ -0,0 +1,29 @@
+requires "verification-body-mutant.k"
+
+module SPEC-BODY-MUTANT
+  imports VERIFICATION-BODY-MUTANT
+
+  claim
+    <k> #runMutatedCarRaceCollision(N:Int) => N *Int N </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+              "car_race_collision"
+                |-> closureVal(
+                      "n",
+                      Return(BinOp("+", Name("n"), Name("n"))),
+                      0),
+              parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
