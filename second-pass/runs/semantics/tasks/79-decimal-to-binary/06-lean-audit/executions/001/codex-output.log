+export LD_PRELOAD=/tmp/audit-work/proc_pid_compat.so
+
+echo '$ cd /tmp/audit-work/stage5-fresh'
+cd "$audit_stage5_dir"
+
+echo '$ lake clean'
+lake clean
+
+echo '$ lake build'
+lake build
