diff --git a//tmp/audit-work/k-operational/operational-spec.k b//tmp/audit-work/k-operational/operational-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d45c42a7374bd744692ad7d55a0ba915ac7597c3
--- /dev/null
+++ b//tmp/audit-work/k-operational/operational-spec.k
@@ -0,0 +1,47 @@
+requires "operational-audit.k"
+
+module OPERATIONAL-SPEC
+  imports OPERATIONAL-AUDIT
+
+  claim <k> doSlice(
+          str(iCons(48, iCons(98, .IntSeq))),
+          someB(2), noB, noB)
+     => str(.IntSeq) </k>
+
+  claim <k> doSlice(
+          str(iCons(48, iCons(98, iCons(49, .IntSeq)))),
+          someB(2), noB, noB)
+     => str(iCons(49, .IntSeq)) </k>
+
+  claim <k> doSlice(
+          str(iCons(10, iCons(20, iCons(30, iCons(40, .IntSeq))))),
+          someB(1), someB(4), someB(2))
+     => str(iCons(20, iCons(40, .IntSeq))) </k>
+
+  claim <k> doSlice(
+          str(iCons(10, iCons(20, iCons(30, iCons(40, iCons(50, .IntSeq)))))),
+          noB, noB, someB(-1))
+     => str(iCons(50, iCons(40, iCons(30, iCons(20, iCons(10, .IntSeq)))))) </k>
+
+  claim <k> doSlice(
+          str(iCons(10, iCons(20, iCons(30, iCons(40, iCons(50, .IntSeq)))))),
+          someB(3), someB(0), someB(-2))
+     => str(iCons(40, iCons(20, .IntSeq))) </k>
+
+  claim <k> doSlice(
+          list(vCons(10, vCons(20, vCons(30, vCons(40, .ValSeq))))),
+          someB(1), someB(4), someB(2))
+     => list(vCons(20, vCons(40, .ValSeq))) </k>
+
+  claim <k> doSlice(
+          tuple(vCons(10, vCons(20, vCons(30, .ValSeq)))),
+          noB, noB, someB(-1))
+     => tuple(vCons(30, vCons(20, vCons(10, .ValSeq)))) </k>
+
+  // Adversarial zero-step case. With both bounds explicit, slStart/slStop
+  // reduce and buildIS takes its non-iteration branch, producing empty.
+  claim <k> doSlice(
+          str(iCons(10, iCons(20, iCons(30, .IntSeq)))),
+          someB(0), someB(3), someB(0))
+     => str(.IntSeq) </k>
+endmodule
