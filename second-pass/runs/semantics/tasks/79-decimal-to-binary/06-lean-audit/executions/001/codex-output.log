diff --git a/evidence/08_axiom_audit.sh b/evidence/08_axiom_audit.sh
new file mode 100644
index 0000000000000000000000000000000000000000..5510bab1da70ab955d9d8025ee5e37122211fb3c
--- /dev/null
+++ b/evidence/08_axiom_audit.sh
@@ -0,0 +1,11 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+export ELAN_HOME=/opt/elan
+export LD_PRELOAD=/tmp/audit-work/proc_pid_compat.so
+
+echo '$ cd /tmp/audit-work/stage5-fresh'
+cd /tmp/audit-work/stage5-fresh
+
