index 0000000000000000000000000000000000000000..4b4196b4dc2cb8fbd5e83fb3b4af530c5275ed06
--- /dev/null
+++ b/evidence/10_ground_k_operational.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
