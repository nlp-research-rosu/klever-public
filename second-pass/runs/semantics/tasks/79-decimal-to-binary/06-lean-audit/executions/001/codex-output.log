    | «zipObjS(_,_)_MPY-CORE_Iterable_IntSeq_IntSeq» (x0 : SortIntSeq) (x1 : SortIntSeq) : SortIterable

  inductive SortK : Type where
    | dotk : SortK
    | kseq (x0 : SortKItem) (x1 : SortK) : SortK

  structure SortKCell : Type where
