      "text": "  rule #runDecimalToBinary(N:Int)\n    => Call(\n         closureVal(\n           \"decimal\",\n           Return(\n             BinOp(\n               \"+\",\n               BinOp(\n                 \"+\",\n                 Str(\"db\"),\n                 Subscript(\n                   Call(Name(\"bin\"), Name(\"decimal\")),\n                   Slice(Int(2), NoBound, NoBound))),\n               Str(\"db\")))\n           .Stmts,\n           0),\n         N)"
    }
