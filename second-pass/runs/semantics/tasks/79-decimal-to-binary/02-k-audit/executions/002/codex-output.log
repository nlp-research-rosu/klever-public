import pathlib,hashlib,itertools,os,stat
cases=[('/candidate/reference-semantics','1de6d5f51876cf9d0f4449a78f077f8b127a14add0504d5060da680fc5a443de'),('/generation-evidence/codex-trace','2480aa81995c414857253e35ad0d6a9c8eaae2bcbc6e22b96b49144401e74eed')]
for root,target in cases:
 r=pathlib.Path(root)
 files=sorted(p for p in r.rglob('*') if p.is_file())
 dirs=sorted(p for p in r.rglob('*') if p.is_dir())
 found=[]
 for incl_dirs in [False,True]:
  entries=sorted((files+(dirs if incl_dirs else [])), key=lambda p:p.relative_to(r).as_posix())
  for dot in [False,True]:
   for pathsep in [b'',b'\\0',b'\\n',b':',b' ']:
    for endsep in [b'',b'\\0',b'\\n']:
     for content_kind in ['raw','hex','bindigest','size_raw','mode_raw','type_raw','type_hex','type_size_raw']:
      h=hashlib.sha256()
      for p in entries:
       rel=p.relative_to(r).as_posix()
       if dot: rel='./'+rel
       h.update(rel.encode()); h.update(pathsep)
       isfile=p.is_file()
       raw=p.read_bytes() if isfile else b''
       hexd=hashlib.sha256(raw).hexdigest().encode() if isfile else b''
       bind=hashlib.sha256(raw).digest() if isfile else b''
       if content_kind=='raw': b=raw
       elif content_kind=='hex': b=hexd
       elif content_kind=='bindigest': b=bind
       elif content_kind=='size_raw': b=(str(len(raw)).encode()+b'\\0'+raw)
       elif content_kind=='mode_raw': b=(oct(p.lstat().st_mode).encode()+b'\\0'+raw)
       elif content_kind=='type_raw': b=(b'file\\0' if isfile else b'directory\\0')+raw
       elif content_kind=='type_hex': b=(b'file\\0' if isfile else b'directory\\0')+hexd
       elif content_kind=='type_size_raw': b=(b'file\\0' if isfile else b'directory\\0')+len(raw).to_bytes(8,'big')+raw
       h.update(b); h.update(endsep)
      if h.hexdigest()==target: found.append((incl_dirs,dot,pathsep,endsep,content_kind))
 print(root,'found',found)
