diff --git a//tmp/audit-work/79-decimal-to-binary/slice-ground.k b//tmp/audit-work/79-decimal-to-binary/slice-ground.k
new file mode 100644
index 0000000000000000000000000000000000000000..3f05ba6089d30918500cb77fd0376b000fea3073
--- /dev/null
+++ b//tmp/audit-work/79-decimal-to-binary/slice-ground.k
@@ -0,0 +1,29 @@
+requires "reference-semantics/semantics.k"
+
+module SLICE-GROUND
+  imports MPY
+
+  claim <k> doSlice(
+          str(iCons(65, iCons(66, .IntSeq))),
+          someB(2),
+          noB,
+          noB)
+      => str(.IntSeq) </k>
+    [label(empty-tail)]
+
+  claim <k> doSlice(
+          str(iCons(65, iCons(66, iCons(67, .IntSeq)))),
+          someB(2),
+          noB,
+          noB)
+      => str(iCons(67, .IntSeq)) </k>
+    [label(one-tail)]
+
+  claim <k> doSlice(
+          str(iCons(1, iCons(2, iCons(3, iCons(4, iCons(5, .IntSeq)))))),
+          someB(2),
+          noB,
+          noB)
+      => str(iCons(3, iCons(4, iCons(5, .IntSeq)))) </k>
+    [label(three-tail)]
+endmodule
