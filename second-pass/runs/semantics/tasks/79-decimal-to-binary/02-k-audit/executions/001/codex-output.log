+#!/usr/bin/env bash
+set -u
+
+if [ "$#" -lt 2 ]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log=$1
+shift
+
