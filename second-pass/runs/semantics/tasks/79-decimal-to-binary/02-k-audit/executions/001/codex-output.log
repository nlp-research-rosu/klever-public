+#!/usr/bin/env bash
+set -u
+
+work=/tmp/audit-work/79-decimal-to-binary
+generated=$work/solution.regenerated.mpy
+
+python3 "$work/trusted-py2mpy.py" "$work/solution.py" > "$generated"
+translate_status=$?
+printf 'TRANSLATOR_EXIT_STATUS: %d\n' "$translate_status"
+if [ "$translate_status" -ne 0 ]; then
+  exit "$translate_status"
+fi
+
+cmp "$generated" "$work/solution.mpy"
+cmp_status=$?
+printf 'BYTE_IDENTITY_CMP_STATUS: %d\n' "$cmp_status"
+if [ "$cmp_status" -ne 0 ]; then
+  diff -u "$work/solution.mpy" "$generated"
+fi
+exit "$cmp_status"
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..d62a856557490b611aa257a5bfbabc5ba6364aad
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -u
+
+if [ "$#" -lt 2 ]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$log"
+
+set +e
+"$@" >> "$log" 2>&1
+status=$?
+set -e
+
+printf 'EXIT_STATUS: %d\n' "$status" >> "$log"
+sed -n '1,400p' "$log"
+exit "$status"
