+requires "reference-semantics/semantics.k"
+
+module SLICE-GROUND
+  imports MPY
+
+  claim <k> doSlice(
+          str(iCons(65, iCons(66, .IntSeq))),
+          someB(2),
+          noB,
+          noB)
+      => str(.IntSeq) </k>
+    [label(empty-tail)]
