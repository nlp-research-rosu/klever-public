diff --git a/app_path_shim.c b/app_path_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..07b2112db2e7e46e0ec1ed8c0460db86ff5cddce
--- /dev/null
+++ b/app_path_shim.c
@@ -0,0 +1,32 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buffer, size_t capacity) {
+    const char *forced = getenv("KLEAN_APP_PATH");
+    size_t path_length = strlen(path);
+    if (forced != NULL &&
+        strncmp(path, "/proc/", 6) == 0 &&
+        path_length >= 4 &&
+        strcmp(path + path_length - 4, "/exe") == 0) {
+        size_t forced_length = strlen(forced);
+        if (forced_length > capacity) {
+            forced_length = capacity;
+        }
+        memcpy(buffer, forced, forced_length);
+        return (ssize_t)forced_length;
+    }
+
+    static ssize_t (*real_readlink)(const char *, char *, size_t) = NULL;
+    if (real_readlink == NULL) {
+        real_readlink = dlsym(RTLD_NEXT, "readlink");
+    }
+    if (real_readlink == NULL) {
+        errno = ENOSYS;
+        return -1;
+    }
+    return real_readlink(path, buffer, capacity);
+}

