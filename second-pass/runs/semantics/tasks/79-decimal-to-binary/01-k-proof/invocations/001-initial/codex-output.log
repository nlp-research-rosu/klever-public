index 0000000000000000000000000000000000000000..bf032b0b58f953046444c3f86fdad8c305afa723
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,20 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim <k>
+          #runDecimalToBinary(N)
+        =>
+          str(
+            iCons(
+              100,
+              iCons(
+                98,
+                seqConcat(
+                  binCodes(N),
+                  iCons(100, iCons(98, .IntSeq))))))
+        </k>
+    requires N >=Int 0
+    [label(decimal-to-binary-correct)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d60fd66b06c109a4723de8ece576f9e465afd35a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,25 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  syntax KItem ::= "#runDecimalToBinary" "(" Int ")"
+
+  rule #runDecimalToBinary(N:Int)
+    => #loadAll(
+         Module(
+           FuncDef(
+             "decimal_to_binary",
+             Params("decimal"),
+             Return(
+               BinOp(
+                 "+",
+                 BinOp(
+                   "+",
+                   Str("db"),
+                   Subscript(
+                     Call(Name("bin"), Name("decimal")),
+                     Slice(Int(2), NoBound, NoBound))),
+                 Str("db"))))))
+       ~> Call(Name("decimal_to_binary"), N)
+endmodule

apply patch
patch: completed
