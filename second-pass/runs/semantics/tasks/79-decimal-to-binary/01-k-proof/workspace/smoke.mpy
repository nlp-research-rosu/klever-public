Module(
  FuncDef("decimal_to_binary", Params("decimal"),
    Return(
      BinOp(
        "+",
        BinOp(
          "+",
          Str("db"),
          Subscript(
            Call(Name("bin"), Name("decimal")),
            Slice(Int(2), NoBound, NoBound))),
        Str("db"))))
  Assert(
    Compare(
      Call(Name("decimal_to_binary"), Int(0)),
      CmpOp("==", Str("db0db"))))
  Assert(
    Compare(
      Call(Name("decimal_to_binary"), Int(1)),
      CmpOp("==", Str("db1db"))))
  Assert(
    Compare(
      Call(Name("decimal_to_binary"), Int(15)),
      CmpOp("==", Str("db1111db"))))
  Assert(
    Compare(
      Call(Name("decimal_to_binary"), Int(32)),
      CmpOp("==", Str("db100000db"))))
  Assert(
    Compare(
      Call(Name("decimal_to_binary"), Int(103)),
      CmpOp("==", Str("db1100111db")))))
