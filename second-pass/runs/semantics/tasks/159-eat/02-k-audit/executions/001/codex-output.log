+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("eat" |-> eatClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
