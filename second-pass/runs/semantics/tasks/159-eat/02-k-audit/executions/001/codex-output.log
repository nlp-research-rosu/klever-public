+      .Map
+      => 0 |-> list(
+           vCons(
+             NUMBER +Int REMAINING,
+             vCons(0, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
