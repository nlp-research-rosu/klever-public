+python3 /audit-output/evidence/constructor_pinning.py \
+  /tmp/audit-work/159-eat/trusted/py2mpy.py \
+  /tmp/audit-work/159-eat/candidate-source/solution.py \
+  /tmp/audit-work/159-eat/candidate-source/verification.k \
