+    passed = actual == expected
+    print(
+        json.dumps(
+            {
+                "check": label,
+                "actual": actual,
+                "expected": expected,
+                "pass": passed,
+            },
+            sort_keys=True,
+        )
+    )
+    if not passed:
+        raise AssertionError(label)
+
