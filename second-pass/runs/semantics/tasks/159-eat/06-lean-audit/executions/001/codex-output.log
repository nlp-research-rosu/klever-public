+)
+hashes = resolution["hashes"]
+
+check("resolved_input_sha256", resolved_digest, audit_document["resolved_input_sha256"])
+check("AUDIT_MODE", os.environ.get("AUDIT_MODE"), "CLASSIFICATION_ONLY")
