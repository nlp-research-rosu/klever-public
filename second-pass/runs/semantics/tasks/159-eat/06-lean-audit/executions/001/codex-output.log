+discovery = json.loads(DISCOVERY.read_text())
+
+producer_hashes = {
+    name: sha256_file(PRODUCERS / name)
+    for name in ("klean_export.py", "klean.py")
+}
+check("producer files versus source manifest", producer_hashes, producer_manifest["files"])
+check(
