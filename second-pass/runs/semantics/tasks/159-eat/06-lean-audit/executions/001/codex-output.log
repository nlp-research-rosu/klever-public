     7	kompile reference-semantics/semantics.k \
     8	  --backend llvm \
     9	  --main-module MPY-KRUN \
    10	  --syntax-module MPY-SYNTAX \
    11	  --output-definition runtime-kompiled
    12	
    13	krun concrete_tests.mpy --definition runtime-kompiled
    14	
    15	kompile verification.k \
    16	  --backend haskell \
    17	  --main-module EAT-VERIFICATION \
    18	  --syntax-module MPY-SYNTAX \
    19	  --output-definition verification-kompiled
    20	
    21	kprove spec.k \
    22	  --definition verification-kompiled \
    23	  --spec-module EAT-SPEC
     1	Module(
     2	  FuncDef("eat", Params("number", "need", "remaining"),
     3	    If(Compare(Name("need"), CmpOp("<=", Name("remaining"))),
     4	      Return(
     5	        ListExpr(
     6	          BinOp("+", Name("number"), Name("need")),
     7	          BinOp("-", Name("remaining"), Name("need")))),
     8	      )
     9	    Return(
    10	      ListExpr(BinOp("+", Name("number"), Name("remaining")), Int(0)))))
