requires "reference-semantics/semantics.k"

module EAT-VERIFICATION
  imports MPY

  // This is the closure denoted by the FuncDef in solution.mpy.  Keeping the
  // translated statement tree here lets spec.k call the implementation with
  // symbolic arguments while using the supplied function-call semantics.
  syntax Val ::= "eatClosure" [function]

  rule eatClosure
    => closureVal(
         ("number", "need", "remaining"),
         If(
           Compare(Name("need"), CmpOp("<=", Name("remaining"))),
           Return(
             ListExpr(
               BinOp("+", Name("number"), Name("need")),
               BinOp("-", Name("remaining"), Name("need"))))
           .Stmts,
           .Stmts)
         Return(
           ListExpr(
             BinOp("+", Name("number"), Name("remaining")),
             Int(0)))
         .Stmts,
         0)
endmodule
requires "verification.k"

module EAT-SPEC
  imports EAT-VERIFICATION

  claim
    <k>
      Call(
        Name("eat"),
        Int(NUMBER:Int), Int(NEED:Int), Int(REMAINING:Int))
      => ref(0)
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope("eat" |-> eatClosure, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map
      => 0 |-> list(
           vCons(
             NUMBER +Int NEED,
             vCons(REMAINING -Int NEED, .ValSeq)))
    </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
