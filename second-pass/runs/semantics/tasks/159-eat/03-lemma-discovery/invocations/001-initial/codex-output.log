import json
from pathlib import Path
canonical = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert list(out) == ['schema_version', 'inventory_sha256', 'rules'], list(out)
assert out['schema_version'] == 2
assert out['inventory_sha256'] == canonical['inventory_sha256']
expected = [r['source_rule_id'] for r in canonical['rules']]
actual = [r['source_rule_id'] for r in out['rules']]
assert actual == expected, (actual, expected)
assert len(actual) == len(set(actual))
for item in out['rules']:
    assert list(item) == ['source_rule_id', 'classification', 'rationale'], list(item)
