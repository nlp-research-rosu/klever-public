index 0000000000000000000000000000000000000000..80d6c3ff806b36d8211578058041859a73b964cb
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,28 @@
+requires "reference-semantics/semantics.k"
+
+module EAT-VERIFICATION
+  imports MPY
+
+  // This is the closure denoted by the FuncDef in solution.mpy.  Keeping the
+  // translated statement tree here lets spec.k call the implementation with
+  // symbolic arguments while using the supplied function-call semantics.
+  syntax Val ::= "eatClosure" [function]
+
+  rule eatClosure
+    => closureVal(
+         ("number", "need", "remaining"),
+         If(
+           Compare(Name("need"), CmpOp("<=", Name("remaining"))),
+           Return(
+             ListExpr(
+               BinOp("+", Name("number"), Name("need")),
+               BinOp("-", Name("remaining"), Name("need"))))
+           .Stmts,
+           .Stmts)
+         Return(
+           ListExpr(
+             BinOp("+", Name("number"), Name("remaining")),
+             Int(0)))
+         .Stmts,
+         0)
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..53e54350f21621ceaa8b6ff92889503f26067eb8
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,10 @@
+def eat(number, need, remaining):
+    if need <= remaining:
+        return [number + need, remaining - need]
+    return [number + remaining, 0]
+
+
+assert eat(5, 6, 10) == [11, 4]
+assert eat(4, 8, 9) == [12, 1]
+assert eat(1, 10, 10) == [11, 0]
+assert eat(2, 11, 5) == [7, 0]
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..947d7c82046f3c67ecdb1cc0bc769c20b0c51e93
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete_tests.mpy --definition runtime-kompiled
+
+kompile verification.k \
+  --backend haskell \
+  --main-module EAT-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module EAT-SPEC
