      "start_line": 11,
      "text": "  rule eatClosure\n    => closureVal(\n         (\"number\", \"need\", \"remaining\"),\n         If(\n           Compare(Name(\"need\"), CmpOp(\"<=\", Name(\"remaining\"))),\n           Return(\n             ListExpr(\n               BinOp(\"+\", Name(\"number\"), Name(\"need\")),\n               BinOp(\"-\", Name(\"remaining\"), Name(\"need\"))))\n           .Stmts,\n           .Stmts)\n         Return(\n           ListExpr(\n             BinOp(\"+\", Name(\"number\"), Name(\"remaining\")),\n             Int(0)))\n         .Stmts,\n         0)"
    }
  ],
