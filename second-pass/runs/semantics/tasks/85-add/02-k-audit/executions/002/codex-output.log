+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  local status=0
+  "$@" || status=$?
+  printf '[exit %d]\n' "$status"
+  if (( status != 0 )); then
+    overall=1
+  fi
+  return 0
+}
+
+printf 'AUDIT INPUT AND REQUIRED RECORD TYPES\n'
+run stat -c '%F %a %s %n -> %N' \
+  /audit-input.json \
