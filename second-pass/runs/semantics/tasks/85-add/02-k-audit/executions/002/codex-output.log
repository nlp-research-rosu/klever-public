input=[1, -2] addAccSpec=-2 canonical=-2 generated=-2
input=[-2, -4, -6, -8] addAccSpec=-12 canonical=-12 generated=-12
input=[1, 3, 4, -6, 8, 10] addAccSpec=4 canonical=4 generated=4
witness_status=PASS
