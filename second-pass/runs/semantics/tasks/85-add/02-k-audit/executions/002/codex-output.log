+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <env> 0 </env>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
