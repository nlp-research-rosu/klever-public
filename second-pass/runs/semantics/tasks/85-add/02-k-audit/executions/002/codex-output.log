+    </k>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <env> 0 </env>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
