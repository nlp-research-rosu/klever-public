+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (L |-> scope(
+        ("lst" |-> LST:Val)
+        ("total" |-> ACC)
+        ("odd_index" |-> ODD)
+        ("value" |-> OLDVALUE:Int),
+        PARENT:Parent))
+      RESTSCOPES:Map
+      =>
+      (L |-> scope(
+        ("total" |-> addAccSpec(INPUT, ODD, ACC))
+        ?FINALBINDINGS:Map,
