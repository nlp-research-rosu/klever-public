+      #loop(
+        list(intVals(
+          iCons(4, iCons(2, iCons(6, iCons(7, .IntSeq))))
+        )),
+        Name("value"),
+        addLoopBody)
+      =>
+      .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("lst" |-> list(intVals(
+          iCons(4, iCons(2, iCons(6, iCons(7, .IntSeq))))
+        )))
+        ("total" |-> 0)
+        ("odd_index" |-> false)
+        ("value" |-> 0),
+        parent(0))
+      =>
+      1 |-> scope(
+        ("total" |-> 2)
+        ?FINALBINDINGS:Map,
+        parent(0))
+    </scopes>
+endmodule
