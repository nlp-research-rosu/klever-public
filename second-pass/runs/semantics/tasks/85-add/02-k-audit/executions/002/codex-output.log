diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..7db4e3b6098a852b034dfeb06c1a81252480e924
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,33 @@
+requires "/tmp/audit-work/85-add/verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Fresh false mutation: the real result for [4, 2, 6, 7] is 2, while this
+  // destination requires 3.  The full entry configuration is satisfiable.
+  claim [false-result]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(
+           Name("add"),
+           (list(intVals(
+             iCons(4, iCons(2, iCons(6, iCons(7, .IntSeq))))
+           )), .Exprs))
+      =>
+      3
+    </k>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
