+#!/usr/bin/env bash
+set -u
+overall=0
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  local status=0
+  "$@" || status=$?
+  printf '[exit %d]\n' "$status"
+  if (( status != 0 )); then
+    overall=1
+  fi
+  return 0
