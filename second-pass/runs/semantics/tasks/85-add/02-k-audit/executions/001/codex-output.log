/reference/reference-semantics/semantics/int.k:23:  rule applyCmp("<=", I1:Int, I2:Int)   => I1 <=Int I2
/reference/reference-semantics/semantics/int.k:24:  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int  I2
/reference/reference-semantics/semantics/int.k:25:  rule applyCmp(">=", I1:Int, I2:Int)   => I1 >=Int I2
/reference/reference-semantics/semantics/int.k:26:  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2
/reference/reference-semantics/semantics/int.k:27:  rule applyCmp("!=", I1:Int, I2:Int)   => I1 =/=Int I2
/reference/reference-semantics/semantics/int.k:28:endmodule
