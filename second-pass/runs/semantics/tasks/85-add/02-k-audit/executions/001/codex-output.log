+      ~> (Return(Name("total")) .Stmts):Stmts
+      ~> #endcall
+      =>
+      Return(addAccSpec(INPUT, ODD, ACC))
+      ~> #endcall
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (L |-> scope(
+        ("lst" |-> LST:Val)
+        ("total" |-> ACC:Int)
+        ("odd_index" |-> ODD:Bool)
+        ("value" |-> OLDVALUE:Int),
