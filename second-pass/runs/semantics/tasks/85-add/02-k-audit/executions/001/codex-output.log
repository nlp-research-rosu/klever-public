+    <env> L:Int </env>
+    <scopes>
+      (L |-> scope(
+        ("lst" |-> LST:Val)
+        ("total" |-> ACC:Int)
+        ("odd_index" |-> ODD:Bool)
+        ("value" |-> OLDVALUE:Int),
+        PARENT:Parent))
+      RESTSCOPES:Map
+      =>
+      (L |-> scope(
+        ("total" |-> addAccSpec(INPUT, ODD, ACC))
+        ?FINALBINDINGS:Map,
+        PARENT))
+      RESTSCOPES
+    </scopes>
+    requires notBool (L in_keys(RESTSCOPES))
+endmodule
