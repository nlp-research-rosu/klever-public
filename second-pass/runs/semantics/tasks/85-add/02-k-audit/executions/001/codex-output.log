+requires "verification-body-mutant.k"
+
+module BODY-SENSITIVITY
+  imports VERIFICATION-BODY-MUTANT
+
+  // Deliberately false after the body mutation: the operational body adds odd
+  // values, while addAccSpecMut continues to summarize even values.
+  claim [mutated-body-must-not-prove-original-summary]:
+    <k>
+      #loop(list(intValsMut(INPUT:IntSeq)), Name("value"), mutatedLoopBody)
+      =>
+      .K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (L |-> scope(
+        ("lst" |-> LST:Val)
+        ("total" |-> ACC)
+        ("odd_index" |-> ODD)
+        ("value" |-> OLDVALUE:Int),
+        PARENT:Parent))
+      RESTSCOPES:Map
+      =>
+      (L |-> scope(
+        ("total" |-> addAccSpecMut(INPUT, ODD, ACC))
+        ?FINALBINDINGS:Map,
+        PARENT))
+      RESTSCOPES
+    </scopes>
+    requires notBool (L in_keys(RESTSCOPES))
+endmodule
diff --git a//tmp/audit-work/candidate-src/bridge-connection.k b//tmp/audit-work/candidate-src/bridge-connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..4a8fa232a7ddee8abd88042c7800297fded65c7c
--- /dev/null
+++ b//tmp/audit-work/candidate-src/bridge-connection.k
@@ -0,0 +1,92 @@
+requires "verification-no-bridge.k"
+
+module BRIDGE-CONNECTION
+  imports VERIFICATION-NO-BRIDGE
+
+  claim [loop-summary-preserving-empty-stmts]:
+    <k>
+      #loop(list(intVals(INPUT:IntSeq)), Name("value"), addLoopBody)
+      ~> (Return(Name("total")) .Stmts):Stmts
+      ~> #endcall
+      =>
+      (Return(addAccSpec(INPUT, ODD, ACC)) .Stmts):Stmts
+      ~> #endcall
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (L |-> scope(
+        ("lst" |-> LST0:Val)
+        ("total" |-> ACC:Int)
+        ("odd_index" |-> ODD:Bool)
+        ("value" |-> OLDVALUE0:Int),
+        PARENT0:Parent))
+      RESTSCOPES0:Map
+      =>
+      (L |-> scope(
+        ("total" |-> addAccSpec(INPUT, ODD, ACC))
+        ?FINALBINDINGS0:Map,
+        PARENT0))
+      RESTSCOPES0
+    </scopes>
+    requires notBool (L in_keys(RESTSCOPES0))
+
+  // A literal one-step connection to the candidate bridge RHS is intentionally
+  // not asserted: fixed execution retains an empty Stmts item until Return
+  // unwinds the frame. This claim compares the complete observable call effect.
+  claim [observable-call-effect]:
+    <k>
+      #loop(list(intVals(INPUT:IntSeq)), Name("value"), addLoopBody)
+      ~> (Return(Name("total")) .Stmts):Stmts
+      ~> #endcall
+      =>
+      addAccSpec(INPUT, false, 0)
+      ~> CONT
+    </k>
+    <env> L:Int => CALLERL:Int </env>
+    <scopes>
+      (L |-> scope(
+        ("lst" |-> list(intVals(INPUT)))
+        ("total" |-> 0)
+        ("odd_index" |-> false)
+        ("value" |-> 0),
+        PARENT:Parent))
+      RESTSCOPES:Map
+      =>
+      RESTSCOPES
+    </scopes>
+    <scopeLoc> CURRENTLOC:Int => SAVEDLOC:Int </scopeLoc>
+    <stack>
+      ListItem(frame(CONT:K, CALLERL, SAVEDLOC)) RESTSTACK:List
+      =>
+      RESTSTACK
+    </stack>
+    <ret> noRet </ret>
+    requires notBool (L in_keys(RESTSCOPES))
+
+  claim [exact-loop-summary-with-continuation]:
+    <k>
+      #loop(list(intVals(INPUT:IntSeq)), Name("value"), addLoopBody)
+      ~> (Return(Name("total")) .Stmts):Stmts
+      ~> #endcall
+      =>
+      Return(addAccSpec(INPUT, ODD, ACC))
+      ~> #endcall
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (L |-> scope(
+        ("lst" |-> LST:Val)
+        ("total" |-> ACC:Int)
+        ("odd_index" |-> ODD:Bool)
+        ("value" |-> OLDVALUE:Int),
+        PARENT:Parent))
+      RESTSCOPES:Map
+      =>
+      (L |-> scope(
+        ("total" |-> addAccSpec(INPUT, ODD, ACC))
+        ?FINALBINDINGS:Map,
+        PARENT))
+      RESTSCOPES
+    </scopes>
+    requires notBool (L in_keys(RESTSCOPES))
+endmodule
