     1	def add(lst):
     2	    """Add the even elements that occur at odd zero-based indices."""
     3	    total = 0
     4	    odd_index = False
     5	    value = 0
     6	    for value in lst:
     7	        if odd_index:
     8	            if value % 2 == 0:
     9	                total += value
    10	        odd_index = not odd_index
    11	    return total
