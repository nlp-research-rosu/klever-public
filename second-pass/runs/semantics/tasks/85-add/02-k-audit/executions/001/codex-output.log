+      (1 |-> scope(
+        ("lst" |-> list(.ValSeq))
+        ("total" |-> 5)
+        ("odd_index" |-> true)
+        ("value" |-> 99),
+        parent(0)))
+      (-1 |-> builtinsScope)
+      =>
+      (1 |-> scope(
+        ("lst" |-> list(.ValSeq))
+        ("total" |-> 7)
+        ("odd_index" |-> true)
+        ("value" |-> 3),
+        parent(0)))
+      (-1 |-> builtinsScope)
+    </scopes>
+endmodule
