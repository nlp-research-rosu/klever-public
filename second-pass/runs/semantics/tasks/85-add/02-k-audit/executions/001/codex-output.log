+    <env> L:Int => CALLERL:Int </env>
+    <scopes>
+      (L |-> scope(
+        ("lst" |-> list(intVals(INPUT)))
+        ("total" |-> 0)
+        ("odd_index" |-> false)
+        ("value" |-> 0),
+        PARENT:Parent))
+      RESTSCOPES:Map
+      =>
