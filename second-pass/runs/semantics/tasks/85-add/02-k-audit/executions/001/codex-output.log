/reference/reference-semantics/semantics/int.k:4:module MPY-INT
/reference/reference-semantics/semantics/int.k:5:  imports MPY-CORE
/reference/reference-semantics/semantics/int.k:7:  rule applyUn("-", I:Int) => 0 -Int I
/reference/reference-semantics/semantics/int.k:9:  rule applyBin("+",  I1:Int, I2:Int) => I1 +Int I2
/reference/reference-semantics/semantics/int.k:11:  rule applyBin("+",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi
