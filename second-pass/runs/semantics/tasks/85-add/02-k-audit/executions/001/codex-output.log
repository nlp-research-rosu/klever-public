+      ~> #endcall
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (L |-> scope(
+        ("lst" |-> LST0:Val)
+        ("total" |-> ACC:Int)
+        ("odd_index" |-> ODD:Bool)
+        ("value" |-> OLDVALUE0:Int),
+        PARENT0:Parent))
+      RESTSCOPES0:Map
+      =>
