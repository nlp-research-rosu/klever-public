patch: completed
/tmp/lean_app_path.c
diff --git a//tmp/lean_app_path.c b//tmp/lean_app_path.c
new file mode 100644
index 0000000000000000000000000000000000000000..27a48644c6513da685c5cbcdb6327c96a77ee70b
--- /dev/null
+++ b//tmp/lean_app_path.c
@@ -0,0 +1,25 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  const char *replacement = getenv("CODEX_LEAN_APP_PATH");
+  size_t path_len = strlen(path);
+  if (replacement != NULL &&
+      (strcmp(path, "/proc/self/exe") == 0 ||
+       (path_len >= 4 && strcmp(path + path_len - 4, "/exe") == 0))) {
+    size_t replacement_len = strlen(replacement);
+    size_t copied = replacement_len < size ? replacement_len : size;
+    memcpy(buf, replacement, copied);
+    return (ssize_t)copied;
+  }
+
+  static readlink_fn real_readlink = NULL;
+  if (real_readlink == NULL)
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  return real_readlink(path, buf, size);
+}
