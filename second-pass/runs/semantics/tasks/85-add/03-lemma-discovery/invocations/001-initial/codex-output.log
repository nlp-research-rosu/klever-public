/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
from pathlib import Path
inv = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert [r['source_rule_id'] for r in out['rules']] == [r['source_rule_id'] for r in inv['rules']]
assert len({r['source_rule_id'] for r in out['rules']}) == len(inv['rules'])
for rule in out['rules']:
    assert list(rule) == ['source_rule_id', 'classification', 'rationale']
    assert rule['classification'] in allowed
    assert isinstance(rule['rationale'], str) and rule['rationale'].strip()
by_id = {r['source_rule_id']: r for r in out['rules']}
for rule in inv['rules']:
    if 'simplification' in rule['attributes']:
        assert by_id[rule['source_rule_id']]['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
counts = Counter(r['classification'] for r in out['rules'])
print('validated rules:', len(out['rules']))
print('inventory_sha256:', out['inventory_sha256'])
for name in sorted(allowed):
    print(name, counts[name])
PY
