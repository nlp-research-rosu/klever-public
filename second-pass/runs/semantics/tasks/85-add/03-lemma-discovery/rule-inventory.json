      "start_line": 22,
      "text": "  rule addAccSpec(iCons(_:Int, REST:IntSeq), false, ACC:Int)\n    => addAccSpec(REST, true, ACC)"
    },
    {
      "attributes": [],
      "end_line": 26,
      "module": "VERIFICATION",
