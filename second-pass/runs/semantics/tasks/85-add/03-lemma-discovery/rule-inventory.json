      "start_line": 24,
      "text": "  rule addAccSpec(iCons(I:Int, REST:IntSeq), true, ACC:Int)\n    => addAccSpec(REST, false, ACC +Int I)\n    requires pyMod(I, 2) ==Int 0"
    },
    {
      "attributes": [],
      "end_line": 29,
      "module": "VERIFICATION",
      "normalized_sha256": "257df2ab6228fb6898edcf541fddef46b6e142a0efb4d18939443a5604d4fa55",
      "source_rule_id": "rule-257df2ab6228fb6898edcf541fddef46b6e142a0efb4d18939443a5604d4fa55",
      "start_line": 27,
      "text": "  rule addAccSpec(iCons(I:Int, REST:IntSeq), true, ACC:Int)\n    => addAccSpec(REST, false, ACC)\n    requires pyMod(I, 2) =/=Int 0"
    },
    {
      "attributes": [],
      "end_line": 39,
      "module": "VERIFICATION",
      "normalized_sha256": "6d79b870c3994d5a4d3996adfaccbd406bf8e7b6535e8d2171c2e36f9d52ce9c",
      "source_rule_id": "rule-6d79b870c3994d5a4d3996adfaccbd406bf8e7b6535e8d2171c2e36f9d52ce9c",
      "start_line": 32,
      "text": "  rule addLoopBody\n    => If(Name(\"odd_index\"),\n         If(Compare(BinOp(\"%\", Name(\"value\"), Int(2)),\n                    CmpOp(\"==\", Int(0))),\n            AugAssign(Name(\"total\"), \"+\", Name(\"value\")),\n            .Stmts),\n         .Stmts)\n       Assign(Name(\"odd_index\"), UnaryOp(\"not\", Name(\"odd_index\")))"
    },
    {
      "attributes": [],
      "end_line": 48,
      "module": "VERIFICATION",
      "normalized_sha256": "df088a4377558d18840236f243c8491aceaf0070e2a9fe41701bcb9f3bfa6bfd",
      "source_rule_id": "rule-df088a4377558d18840236f243c8491aceaf0070e2a9fe41701bcb9f3bfa6bfd",
      "start_line": 42,
      "text": "  rule addFunctionBody\n    => Expr(Str(\"Add the even elements that occur at odd zero-based indices.\"))\n       Assign(Name(\"total\"), Int(0))\n       Assign(Name(\"odd_index\"), Bool(false))\n       Assign(Name(\"value\"), Int(0))\n       For(Name(\"value\"), Name(\"lst\"), addLoopBody)\n       Return(Name(\"total\"))"
    },
    {
      "attributes": [],
      "end_line": 52,
      "module": "VERIFICATION",
      "normalized_sha256": "f2439e43040de7c9ec4da41ff15bb398eeda5c0edda3ca447ded0344c3dc1ad2",
      "source_rule_id": "rule-f2439e43040de7c9ec4da41ff15bb398eeda5c0edda3ca447ded0344c3dc1ad2",
      "start_line": 51,
      "text": "  rule solutionModule\n    => Module(FuncDef(\"add\", Params(\"lst\"), addFunctionBody))"
    },
    {
      "attributes": [
        "priority(30)"
      ],
      "end_line": 75,
      "module": "VERIFICATION",
      "normalized_sha256": "97c5ca34b9b50dc1f2c9ed9ae56ea870fa5fc9060599752a28635a1372be2589",
      "source_rule_id": "rule-97c5ca34b9b50dc1f2c9ed9ae56ea870fa5fc9060599752a28635a1372be2589",
      "start_line": 57,
      "text": "  rule <k>\n         #loop(list(intVals(INPUT:IntSeq)), Name(\"value\"), addLoopBody)\n         ~> (Return(Name(\"total\")) .Stmts):Stmts\n         ~> #endcall\n       =>\n         Return(addAccSpec(INPUT, false, 0))\n         ~> #endcall\n       ... </k>\n       <env> L:Int </env>\n       <scopes>\n         ... L |-> scope(\n           (\"lst\" |-> list(intVals(INPUT)))\n           (\"total\" |-> 0)\n           (\"odd_index\" |-> false)\n           (\"value\" |-> 0),\n           _:Parent)\n         ...\n       </scopes>\n       [priority(30)]"
    }
  ],
