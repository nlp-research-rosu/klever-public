      "normalized_sha256": "b1e239f4cb7fb61a13ac5801e2b6eb289c8d821415647fad6c102fa6982d2e8c",
      "rationale": "Structural projection equation defining scopeMap as the binding map stored in a scope.",
      "source_rule_id": "rule-b1e239f4cb7fb61a13ac5801e2b6eb289c8d821415647fad6c102fa6982d2e8c",
      "start_line": 18,
      "text": "  rule scopeMap(scope(M:Map, _:Parent)) => M"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 21,
      "module": "VERIFICATION",
      "normalized_sha256": "f54ac27d0247408fcc2bb371ce2b9ea1bbc2b5ce47d40a3234c8beed4f1973db",
      "rationale": "Base equation of the addAccSpec mathematical recurrence: an empty input preserves the accumulator.",
      "source_rule_id": "rule-f54ac27d0247408fcc2bb371ce2b9ea1bbc2b5ce47d40a3234c8beed4f1973db",
      "start_line": 21,
      "text": "  rule addAccSpec(.IntSeq, _:Bool, ACC:Int) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 23,
      "module": "VERIFICATION",
      "normalized_sha256": "1e0ae7d59021cef0b7b715b2087c0943df3ee0c3be684da76639cf3edfeb02df",
      "rationale": "Recurrence equation for an even-index phase, skipping the head and advancing to the odd-index phase.",
      "source_rule_id": "rule-1e0ae7d59021cef0b7b715b2087c0943df3ee0c3be684da76639cf3edfeb02df",
      "start_line": 22,
      "text": "  rule addAccSpec(iCons(_:Int, REST:IntSeq), false, ACC:Int)\n    => addAccSpec(REST, true, ACC)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 26,
      "module": "VERIFICATION",
      "normalized_sha256": "e6fb701bd95df3716b79cec3e38a0e71fbcbcccbd0d1449e1c309849044ba4b6",
      "rationale": "Conditional recurrence equation adding an even head encountered during the odd-index phase.",
      "source_rule_id": "rule-e6fb701bd95df3716b79cec3e38a0e71fbcbcccbd0d1449e1c309849044ba4b6",
      "start_line": 24,
      "text": "  rule addAccSpec(iCons(I:Int, REST:IntSeq), true, ACC:Int)\n    => addAccSpec(REST, false, ACC +Int I)\n    requires pyMod(I, 2) ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 29,
      "module": "VERIFICATION",
      "normalized_sha256": "257df2ab6228fb6898edcf541fddef46b6e142a0efb4d18939443a5604d4fa55",
      "rationale": "Complementary recurrence equation skipping a non-even head encountered during the odd-index phase.",
      "source_rule_id": "rule-257df2ab6228fb6898edcf541fddef46b6e142a0efb4d18939443a5604d4fa55",
      "start_line": 27,
      "text": "  rule addAccSpec(iCons(I:Int, REST:IntSeq), true, ACC:Int)\n    => addAccSpec(REST, false, ACC)\n    requires pyMod(I, 2) =/=Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 39,
      "module": "VERIFICATION",
      "normalized_sha256": "6d79b870c3994d5a4d3996adfaccbd406bf8e7b6535e8d2171c2e36f9d52ce9c",
      "rationale": "Macro expansion defining the named addLoopBody proof term as the implementation's loop statements.",
      "source_rule_id": "rule-6d79b870c3994d5a4d3996adfaccbd406bf8e7b6535e8d2171c2e36f9d52ce9c",
      "start_line": 32,
      "text": "  rule addLoopBody\n    => If(Name(\"odd_index\"),\n         If(Compare(BinOp(\"%\", Name(\"value\"), Int(2)),\n                    CmpOp(\"==\", Int(0))),\n            AugAssign(Name(\"total\"), \"+\", Name(\"value\")),\n            .Stmts),\n         .Stmts)\n       Assign(Name(\"odd_index\"), UnaryOp(\"not\", Name(\"odd_index\")))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 48,
      "module": "VERIFICATION",
      "normalized_sha256": "df088a4377558d18840236f243c8491aceaf0070e2a9fe41701bcb9f3bfa6bfd",
      "rationale": "Macro expansion defining the named addFunctionBody proof term as the translated function body.",
      "source_rule_id": "rule-df088a4377558d18840236f243c8491aceaf0070e2a9fe41701bcb9f3bfa6bfd",
      "start_line": 42,
      "text": "  rule addFunctionBody\n    => Expr(Str(\"Add the even elements that occur at odd zero-based indices.\"))\n       Assign(Name(\"total\"), Int(0))\n       Assign(Name(\"odd_index\"), Bool(false))\n       Assign(Name(\"value\"), Int(0))\n       For(Name(\"value\"), Name(\"lst\"), addLoopBody)\n       Return(Name(\"total\"))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 52,
      "module": "VERIFICATION",
      "normalized_sha256": "f2439e43040de7c9ec4da41ff15bb398eeda5c0edda3ca447ded0344c3dc1ad2",
      "rationale": "Macro expansion defining solutionModule as the module containing the translated add function.",
      "source_rule_id": "rule-f2439e43040de7c9ec4da41ff15bb398eeda5c0edda3ca447ded0344c3dc1ad2",
      "start_line": 51,
      "text": "  rule solutionModule\n    => Module(FuncDef(\"add\", Params(\"lst\"), addFunctionBody))"
    }
  ],
