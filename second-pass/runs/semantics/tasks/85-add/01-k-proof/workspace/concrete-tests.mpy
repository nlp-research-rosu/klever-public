Module(
  FuncDef("add", Params("lst"),
    Expr(
      Str("Add the even elements that occur at odd zero-based indices."))
    Assign(Name("total"), Int(0))
    Assign(Name("odd_index"), Bool(false))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("lst"),
      If(Name("odd_index"),
        If(Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
          AugAssign(Name("total"), "+", Name("value")),
          ),
        )
      Assign(Name("odd_index"), UnaryOp("not", Name("odd_index"))))
    Return(Name("total")))
  Assert(
    Compare(
      Call(Name("add"), ListExpr(Int(4), Int(2), Int(6), Int(7))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(Call(Name("add"), ListExpr(Int(2))), CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("add"), ListExpr(Int(1), Int(2))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(
        Name("add"),
        ListExpr(
          Int(1),
          Int(3),
          Int(4),
          UnaryOp("-", Int(6)),
          Int(8),
          Int(10))),
      CmpOp("==", Int(4))))
  Assert(
    Compare(
      Call(
        Name("add"),
        ListExpr(
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(4)),
          UnaryOp("-", Int(6)),
          UnaryOp("-", Int(8)))),
      CmpOp("==", UnaryOp("-", Int(12)))))
  Assert(
    Compare(
      Call(Name("add"), ListExpr(Int(0), Int(0), Int(0), Int(0))),
      CmpOp("==", Int(0)))))
