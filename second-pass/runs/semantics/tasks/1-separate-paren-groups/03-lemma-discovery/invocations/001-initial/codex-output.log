requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // A declarative fold used only on claim right-hand sides.  It describes
  // the mathematical result of consuming a valid suffix from loop state
  // (CUR, DEPTH, ACC), independently of Python control-flow machinery.
  syntax ValSeq ::= scanGroups(IntSeq, IntSeq, Int, ValSeq) [function, total]
  rule scanGroups(.IntSeq, _CUR:IntSeq, _DEPTH:Int, ACC:ValSeq)
    => ACC
  rule scanGroups(iCons(32, REST:IntSeq), CUR:IntSeq,
                  DEPTH:Int, ACC:ValSeq)
    => scanGroups(REST, CUR, DEPTH, ACC)
  rule scanGroups(iCons(40, REST:IntSeq), CUR:IntSeq,
                  DEPTH:Int, ACC:ValSeq)
    => scanGroups(REST,
                  seqConcat(CUR, iCons(40, .IntSeq)),
                  DEPTH +Int 1,
                  ACC)
  rule scanGroups(iCons(C:Int, REST:IntSeq), CUR:IntSeq,
                  DEPTH:Int, ACC:ValSeq)
    => scanClose(C, REST, CUR, DEPTH, ACC)
    [owise]

  syntax ValSeq ::= scanClose(Int, IntSeq, IntSeq, Int, ValSeq)
                    [function, total]
  rule scanClose(C:Int, REST:IntSeq, CUR:IntSeq,
                 DEPTH:Int, ACC:ValSeq)
    => scanGroups(
         REST,
         .IntSeq,
         0,
         valSeqConcat(
           ACC,
           vCons(str(seqConcat(CUR, iCons(C, .IntSeq))), .ValSeq)))
    requires DEPTH -Int 1 ==Int 0
  rule scanClose(C:Int, REST:IntSeq, CUR:IntSeq,
                 DEPTH:Int, ACC:ValSeq)
    => scanGroups(REST,
                  seqConcat(CUR, iCons(C, .IntSeq)),
                  DEPTH -Int 1,
                  ACC)
    requires DEPTH -Int 1 =/=Int 0

  // balancedTail(CODES, DEPTH) is the contract domain: only spaces and
  // parentheses occur, no suffix prefix underflows DEPTH, and final depth is
  // zero. This admits spaces anywhere and adjacent top-level groups.
  syntax Bool ::= balancedTail(IntSeq, Int) [function, total]
  rule balancedTail(.IntSeq, DEPTH:Int) => DEPTH ==Int 0
  rule balancedTail(iCons(32, REST:IntSeq), DEPTH:Int)
    => balancedTail(REST, DEPTH)
  rule balancedTail(iCons(40, REST:IntSeq), DEPTH:Int)
    => balancedTail(REST, DEPTH +Int 1)
  rule balancedTail(iCons(C:Int, REST:IntSeq), DEPTH:Int)
    => C ==Int 41 andBool DEPTH >Int 0
       andBool balancedTail(REST, DEPTH -Int 1)
    requires C =/=Int 32 andBool C =/=Int 40

  syntax Bool ::= parenSpaceOnly(IntSeq) [function, total]
  rule parenSpaceOnly(.IntSeq) => true
  rule parenSpaceOnly(iCons(C:Int, REST:IntSeq))
    => (C ==Int 32 orBool C ==Int 40 orBool C ==Int 41)
       andBool parenSpaceOnly(REST)

  // The closure below is the exact FuncDef body emitted in solution.mpy.
  // Naming it keeps the claims readable; the macro adds no behavior.
  syntax Val ::= "solutionClosure" [macro]
  rule solutionClosure
    => closureVal(
         ("paren_string", .ParamNames),
         Assign(Name("groups"), ListExpr(.Exprs))
         Assign(Name("current"), Str(""))
         Assign(Name("depth"), Int(0))
         For(Name("character"), Name("paren_string"),
           If(Compare(Name("character"), CmpOp("==", Str(" "))),
             Continue .Stmts,
             .Stmts)
           AugAssign(Name("current"), "+", Name("character"))
           If(Compare(Name("character"), CmpOp("==", Str("("))),
             AugAssign(Name("depth"), "+", Int(1)) .Stmts,
             AugAssign(Name("depth"), "-", Int(1)) .Stmts)
           If(Compare(Name("depth"), CmpOp("==", Int(0))),
             Expr(Call(Attribute(Name("groups"), "append"),
                       (Name("current"), .Exprs)))
             Assign(Name("current"), Str(""))
             .Stmts,
             .Stmts)
           .Stmts)
         Return(Name("groups"))
         .Stmts,
         0)

endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  // Universal loop invariant.  Symbolic execution narrows CODES one
  // constructor at a time and uses this claim circularly on the remaining
  // suffix.  It covers every contract-valid input, not just the examples.
  claim [all-balanced-inputs]:
    <k>
      #loop(
        str(CODES:IntSeq),
        Name("character"),
        If(Compare(Name("character"), CmpOp("==", Str(" "))),
          Continue .Stmts,
          .Stmts)
        AugAssign(Name("current"), "+", Name("character"))
        If(Compare(Name("character"), CmpOp("==", Str("("))),
          AugAssign(Name("depth"), "+", Int(1)) .Stmts,
          AugAssign(Name("depth"), "-", Int(1)) .Stmts)
        If(Compare(Name("depth"), CmpOp("==", Int(0))),
          Expr(Call(Attribute(Name("groups"), "append"),
                    (Name("current"), .Exprs)))
          Assign(Name("current"), Str(""))
          .Stmts,
          .Stmts)
        .Stmts)
      ~> KONT:K
      => KONT
    </k>
    <env> 1 </env>
    <scopes>
      RESTSCOPES:Map
      1 |-> scope(
             "character" |-> (OLD:Val => ?FINAL:Val)
             "current"   |-> (str(CUR:IntSeq) => str(.IntSeq))
             "depth"     |-> (DEPTH:Int => 0)
             "groups"    |-> ref(H:Int)
             "paren_string" |-> INPUT:Val,
             parent(0))
    </scopes>
    <heap>
      H |-> list(ACC:ValSeq)
      => H |-> list(scanGroups(CODES, CUR, DEPTH, ACC))
    </heap>
    requires balancedTail(CODES, DEPTH)
     andBool parenSpaceOnly(CODES)
     andBool DEPTH >=Int 0
     andBool (DEPTH >Int 0 orBool CUR ==K .IntSeq)

  // End-to-end public-entry proof.  The universal loop claim discharges the
  // recursive phase after the ordinary call/allocation prefix has executed.
  claim [all-balanced-calls]:
    <k> Call(Name("separate_paren_groups"),
             (str(CODES:IntSeq), .Exprs))
        => ref(0) </k>
    <env> 0 </env>
    <scopes>
      -1 |-> builtinsScope
      0  |-> scope("separate_paren_groups" |-> solutionClosure,
                   parent(-1))
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map
      => 0 |-> list(scanGroups(CODES, .IntSeq, 0, .ValSeq))
    </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    requires balancedTail(CODES, 0)
     andBool parenSpaceOnly(CODES)

  claim [empty]:
    <k> Call(Name("separate_paren_groups"),
             (str(.IntSeq), .Exprs))
        => ref(0) </k>
    <env> 0 </env>
    <scopes>
      -1 |-> builtinsScope
      0  |-> scope("separate_paren_groups" |-> solutionClosure,
                   parent(-1))
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map => 0 |-> list(.ValSeq) </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>

  claim [prompt-example]:
    <k> Call(Name("separate_paren_groups"),
             (str(strToCodes("( ) (( )) (( )( ))")), .Exprs))
        => ref(0) </k>
    <env> 0 </env>
    <scopes>
      -1 |-> builtinsScope
      0  |-> scope("separate_paren_groups" |-> solutionClosure,
                   parent(-1))
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map
      => 0 |-> list(
           vCons(str(strToCodes("()")),
           vCons(str(strToCodes("(())")),
           vCons(str(strToCodes("(()())")), .ValSeq))))
    </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>

  claim [adjacent-and-spaced]:
    <k> Call(Name("separate_paren_groups"),
             (str(strToCodes("  (()())() ")), .Exprs))
        => ref(0) </k>
    <env> 0 </env>
    <scopes>
      -1 |-> builtinsScope
      0  |-> scope("separate_paren_groups" |-> solutionClosure,
                   parent(-1))
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map
      => 0 |-> list(
           vCons(str(strToCodes("(()())")),
           vCons(str(strToCodes("()")), .ValSeq)))
    </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>

  claim [deep-nesting]:
    <k> Call(Name("separate_paren_groups"),
             (str(strToCodes("(((())))")), .Exprs))
        => ref(0) </k>
    <env> 0 </env>
    <scopes>
      -1 |-> builtinsScope
      0  |-> scope("separate_paren_groups" |-> solutionClosure,
                   parent(-1))
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map
      => 0 |-> list(vCons(str(strToCodes("(((())))")), .ValSeq))
    </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>

