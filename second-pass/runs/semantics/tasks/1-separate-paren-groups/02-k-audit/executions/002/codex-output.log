+      => 0 |-> list(
+           vCons(str(strToCodes("()")),
+           vCons(str(strToCodes("(())")),
+           vCons(str(strToCodes("(()())")), .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
