===== /candidate/concrete_tests.py
     1	from typing import List
     2	
     3	
     4	def separate_paren_groups(paren_string: str) -> List[str]:
     5	    groups = []
     6	    current = ""
     7	    depth = 0
     8	
     9	    for character in paren_string:
    10	        if character == " ":
    11	            continue
    12	
    13	        current += character
    14	        if character == "(":
    15	            depth += 1
    16	        else:
    17	            depth -= 1
    18	
    19	        if depth == 0:
    20	            groups.append(current)
    21	            current = ""
    22	
    23	    return groups
    24	
    25	
    26	assert separate_paren_groups("( ) (( )) (( )( ))") == ["()", "(())", "(()())"]
    27	assert separate_paren_groups("") == []
    28	assert separate_paren_groups("()") == ["()"]
    29	assert separate_paren_groups("  (()())() ") == ["(()())", "()"]
    30	assert separate_paren_groups("(((())))") == ["(((())))"]
