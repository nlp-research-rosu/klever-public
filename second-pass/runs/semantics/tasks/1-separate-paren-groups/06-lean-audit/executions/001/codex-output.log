+  static char *(*real_realpath)(const char *, char *);
+  if (!real_realpath) real_realpath = dlsym(RTLD_NEXT, "realpath");
+  char *result = real_realpath(path, resolved);
+  int saved = errno;
+  fprintf(stderr, "TRACE realpath(%s)=%s errno=%d\n",
+          path, result ? result : "(null)", saved);
+  errno = saved;
+  return result;
+}
+
+char *getcwd(char *buf, size_t size) {
+  static char *(*real_getcwd)(char *, size_t);
+  if (!real_getcwd) real_getcwd = dlsym(RTLD_NEXT, "getcwd");
