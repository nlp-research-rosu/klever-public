      "source_rule_id": "rule-c4cf973db2aaba3fa41818b2cfd375063581ac7e7537dfa6b0d800172fd94fb4",
      "start_line": 21,
      "text": "  rule scanGroups(iCons(C:Int, REST:IntSeq), CUR:IntSeq,\n                  DEPTH:Int, ACC:ValSeq)\n    => scanClose(C, REST, CUR, DEPTH, ACC)\n    [owise]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 37,
      "module": "VERIFICATION",
      "normalized_sha256": "88b07135647f77b2ac45688ab13a9417020cd89887e9e61126e95361f18e27b4",
      "rationale": "Conditional scanClose equation defining the group-completion case: reset current/depth and append the completed group when closing reaches depth zero.",
      "source_rule_id": "rule-88b07135647f77b2ac45688ab13a9417020cd89887e9e61126e95361f18e27b4",
      "start_line": 28,
      "text": "  rule scanClose(C:Int, REST:IntSeq, CUR:IntSeq,\n                 DEPTH:Int, ACC:ValSeq)\n    => scanGroups(\n         REST,\n         .IntSeq,\n         0,\n         valSeqConcat(\n           ACC,\n           vCons(str(seqConcat(CUR, iCons(C, .IntSeq))), .ValSeq)))\n    requires DEPTH -Int 1 ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 44,
      "module": "VERIFICATION",
      "normalized_sha256": "de94016a500f0ae3a476b66b9867344d68f11feef7679f0217b6957f3232d51e",
      "rationale": "Complementary scanClose recurrence defining a nested close that extends the current group and decrements depth without emitting a group.",
      "source_rule_id": "rule-de94016a500f0ae3a476b66b9867344d68f11feef7679f0217b6957f3232d51e",
      "start_line": 38,
      "text": "  rule scanClose(C:Int, REST:IntSeq, CUR:IntSeq,\n                 DEPTH:Int, ACC:ValSeq)\n    => scanGroups(REST,\n                  seqConcat(CUR, iCons(C, .IntSeq)),\n                  DEPTH -Int 1,\n                  ACC)\n    requires DEPTH -Int 1 =/=Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 50,
      "module": "VERIFICATION",
      "normalized_sha256": "1f4dd256c8a442d51a26d58d45aaf94e320834d70065a9839ef1f815ed669a1f",
      "rationale": "Base equation defining balancedTail on an empty suffix as exactly the zero-final-depth condition.",
      "source_rule_id": "rule-1f4dd256c8a442d51a26d58d45aaf94e320834d70065a9839ef1f815ed669a1f",
      "start_line": 50,
      "text": "  rule balancedTail(.IntSeq, DEPTH:Int) => DEPTH ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 52,
      "module": "VERIFICATION",
      "normalized_sha256": "b806ffef368f4e8bcc51c8e8656c94e314678616cac1047c4e46d7e45301569c",
      "rationale": "Recursive balancedTail equation defining spaces as depth-neutral and ignored by the contract predicate.",
      "source_rule_id": "rule-b806ffef368f4e8bcc51c8e8656c94e314678616cac1047c4e46d7e45301569c",
      "start_line": 51,
      "text": "  rule balancedTail(iCons(32, REST:IntSeq), DEPTH:Int)\n    => balancedTail(REST, DEPTH)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 54,
      "module": "VERIFICATION",
      "normalized_sha256": "052713095a835e62065e1b83ded02956cd6447c7a07ccaea089f8297100dde9a",
      "rationale": "Recursive balancedTail equation defining an opening parenthesis as increasing the tracked depth.",
      "source_rule_id": "rule-052713095a835e62065e1b83ded02956cd6447c7a07ccaea089f8297100dde9a",
      "start_line": 53,
      "text": "  rule balancedTail(iCons(40, REST:IntSeq), DEPTH:Int)\n    => balancedTail(REST, DEPTH +Int 1)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 58,
      "module": "VERIFICATION",
      "normalized_sha256": "78cb55fdec63f3a267deff3351b4e0da41dc0fcb3e70055bfdd7882890bcaae7",
      "rationale": "Recursive balancedTail equation defining the remaining character case as a closing parenthesis with a positive-depth guard and depth decrement.",
      "source_rule_id": "rule-78cb55fdec63f3a267deff3351b4e0da41dc0fcb3e70055bfdd7882890bcaae7",
      "start_line": 55,
      "text": "  rule balancedTail(iCons(C:Int, REST:IntSeq), DEPTH:Int)\n    => C ==Int 41 andBool DEPTH >Int 0\n       andBool balancedTail(REST, DEPTH -Int 1)\n    requires C =/=Int 32 andBool C =/=Int 40"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 61,
      "module": "VERIFICATION",
