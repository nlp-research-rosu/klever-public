     4	def separate_paren_groups(paren_string: str) -> List[str]:
     5	    groups = []
     6	    current = ""
     7	    depth = 0
     8	
     9	    for character in paren_string:
    10	        if character == " ":
    11	            continue
    12	
    13	        current += character
    14	        if character == "(":
    15	            depth += 1
    16	        else:
    17	            depth -= 1
    18	
