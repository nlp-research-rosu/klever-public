      "module": "VERIFICATION",
      "normalized_sha256": "77e06410332620fe751a74099095be60fd529ac2ce38246b38c2bfb1874c8ff9",
      "rationale": "Recursive scanGroups equation for an opening parenthesis, defining current-group extension and depth increment.",
      "source_rule_id": "rule-77e06410332620fe751a74099095be60fd529ac2ce38246b38c2bfb1874c8ff9",
      "start_line": 15,
      "text": "  rule scanGroups(iCons(40, REST:IntSeq), CUR:IntSeq,\n                  DEPTH:Int, ACC:ValSeq)\n    => scanGroups(REST,\n                  seqConcat(CUR, iCons(40, .IntSeq)),\n                  DEPTH +Int 1,\n                  ACC)"
    },
    {
      "attributes": [
        "owise"
      ],
      "classification": "DEFINITION",
      "end_line": 24,
      "module": "VERIFICATION",
      "normalized_sha256": "c4cf973db2aaba3fa41818b2cfd375063581ac7e7537dfa6b0d800172fd94fb4",
      "rationale": "Owise structural dispatch equation completing scanGroups by delegating its remaining character case to the scanClose helper.",
      "source_rule_id": "rule-c4cf973db2aaba3fa41818b2cfd375063581ac7e7537dfa6b0d800172fd94fb4",
      "start_line": 21,
      "text": "  rule scanGroups(iCons(C:Int, REST:IntSeq), CUR:IntSeq,\n                  DEPTH:Int, ACC:ValSeq)\n    => scanClose(C, REST, CUR, DEPTH, ACC)\n    [owise]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 37,
      "module": "VERIFICATION",
      "normalized_sha256": "88b07135647f77b2ac45688ab13a9417020cd89887e9e61126e95361f18e27b4",
      "rationale": "Conditional scanClose equation defining the group-completion case: reset current/depth and append the completed group when closing reaches depth zero.",
      "source_rule_id": "rule-88b07135647f77b2ac45688ab13a9417020cd89887e9e61126e95361f18e27b4",
      "start_line": 28,
      "text": "  rule scanClose(C:Int, REST:IntSeq, CUR:IntSeq,\n                 DEPTH:Int, ACC:ValSeq)\n    => scanGroups(\n         REST,\n         .IntSeq,\n         0,\n         valSeqConcat(\n           ACC,\n           vCons(str(seqConcat(CUR, iCons(C, .IntSeq))), .ValSeq)))\n    requires DEPTH -Int 1 ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 44,
      "module": "VERIFICATION",
      "normalized_sha256": "de94016a500f0ae3a476b66b9867344d68f11feef7679f0217b6957f3232d51e",
      "rationale": "Complementary scanClose recurrence defining a nested close that extends the current group and decrements depth without emitting a group.",
      "source_rule_id": "rule-de94016a500f0ae3a476b66b9867344d68f11feef7679f0217b6957f3232d51e",
      "start_line": 38,
      "text": "  rule scanClose(C:Int, REST:IntSeq, CUR:IntSeq,\n                 DEPTH:Int, ACC:ValSeq)\n    => scanGroups(REST,\n                  seqConcat(CUR, iCons(C, .IntSeq)),\n                  DEPTH -Int 1,\n                  ACC)\n    requires DEPTH -Int 1 =/=Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 50,
      "module": "VERIFICATION",
      "normalized_sha256": "1f4dd256c8a442d51a26d58d45aaf94e320834d70065a9839ef1f815ed669a1f",
      "rationale": "Base equation defining balancedTail on an empty suffix as exactly the zero-final-depth condition.",
      "source_rule_id": "rule-1f4dd256c8a442d51a26d58d45aaf94e320834d70065a9839ef1f815ed669a1f",
      "start_line": 50,
      "text": "  rule balancedTail(.IntSeq, DEPTH:Int) => DEPTH ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 52,
      "module": "VERIFICATION",
      "normalized_sha256": "b806ffef368f4e8bcc51c8e8656c94e314678616cac1047c4e46d7e45301569c",
      "rationale": "Recursive balancedTail equation defining spaces as depth-neutral and ignored by the contract predicate.",
      "source_rule_id": "rule-b806ffef368f4e8bcc51c8e8656c94e314678616cac1047c4e46d7e45301569c",
      "start_line": 51,
      "text": "  rule balancedTail(iCons(32, REST:IntSeq), DEPTH:Int)\n    => balancedTail(REST, DEPTH)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 54,
      "module": "VERIFICATION",
      "normalized_sha256": "052713095a835e62065e1b83ded02956cd6447c7a07ccaea089f8297100dde9a",
      "rationale": "Recursive balancedTail equation defining an opening parenthesis as increasing the tracked depth.",
      "source_rule_id": "rule-052713095a835e62065e1b83ded02956cd6447c7a07ccaea089f8297100dde9a",
      "start_line": 53,
      "text": "  rule balancedTail(iCons(40, REST:IntSeq), DEPTH:Int)\n    => balancedTail(REST, DEPTH +Int 1)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 58,
      "module": "VERIFICATION",
      "normalized_sha256": "78cb55fdec63f3a267deff3351b4e0da41dc0fcb3e70055bfdd7882890bcaae7",
      "rationale": "Recursive balancedTail equation defining the remaining character case as a closing parenthesis with a positive-depth guard and depth decrement.",
      "source_rule_id": "rule-78cb55fdec63f3a267deff3351b4e0da41dc0fcb3e70055bfdd7882890bcaae7",
      "start_line": 55,
      "text": "  rule balancedTail(iCons(C:Int, REST:IntSeq), DEPTH:Int)\n    => C ==Int 41 andBool DEPTH >Int 0\n       andBool balancedTail(REST, DEPTH -Int 1)\n    requires C =/=Int 32 andBool C =/=Int 40"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 61,
      "module": "VERIFICATION",
      "normalized_sha256": "7122c1187dac6e0965cb40c98d018fda272ad1906e10604ba8bc64658613e8f4",
      "rationale": "Base equation defining the empty code sequence to satisfy the parenthesis-or-space alphabet predicate.",
      "source_rule_id": "rule-7122c1187dac6e0965cb40c98d018fda272ad1906e10604ba8bc64658613e8f4",
      "start_line": 61,
      "text": "  rule parenSpaceOnly(.IntSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 64,
      "module": "VERIFICATION",
      "normalized_sha256": "c1624dec045d7c2ed281b57c318598c2382d51c39e423e0ef43da3abdcb5bfeb",
      "rationale": "Recursive parenSpaceOnly equation defining the accepted character codes and recurring over the remaining sequence.",
      "source_rule_id": "rule-c1624dec045d7c2ed281b57c318598c2382d51c39e423e0ef43da3abdcb5bfeb",
      "start_line": 62,
      "text": "  rule parenSpaceOnly(iCons(C:Int, REST:IntSeq))\n    => (C ==Int 32 orBool C ==Int 40 orBool C ==Int 41)\n       andBool parenSpaceOnly(REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 92,
      "module": "VERIFICATION",
      "normalized_sha256": "84cd94932504b251c7285a2db82a43300e5031597cd250eb17bafd0f77c108af",
      "rationale": "Macro expansion defining the named solutionClosure proof term as the exact translated function closure; it introduces no execution fact.",
      "source_rule_id": "rule-84cd94932504b251c7285a2db82a43300e5031597cd250eb17bafd0f77c108af",
      "start_line": 69,
      "text": "  rule solutionClosure\n    => closureVal(\n         (\"paren_string\", .ParamNames),\n         Assign(Name(\"groups\"), ListExpr(.Exprs))\n         Assign(Name(\"current\"), Str(\"\"))\n         Assign(Name(\"depth\"), Int(0))\n         For(Name(\"character\"), Name(\"paren_string\"),\n           If(Compare(Name(\"character\"), CmpOp(\"==\", Str(\" \"))),\n             Continue .Stmts,\n             .Stmts)\n           AugAssign(Name(\"current\"), \"+\", Name(\"character\"))\n           If(Compare(Name(\"character\"), CmpOp(\"==\", Str(\"(\"))),\n             AugAssign(Name(\"depth\"), \"+\", Int(1)) .Stmts,\n             AugAssign(Name(\"depth\"), \"-\", Int(1)) .Stmts)\n           If(Compare(Name(\"depth\"), CmpOp(\"==\", Int(0))),\n             Expr(Call(Attribute(Name(\"groups\"), \"append\"),\n                       (Name(\"current\"), .Exprs)))\n             Assign(Name(\"current\"), Str(\"\"))\n             .Stmts,\n             .Stmts)\n           .Stmts)\n         Return(Name(\"groups\"))\n         .Stmts,\n         0)"
    }
  ],
