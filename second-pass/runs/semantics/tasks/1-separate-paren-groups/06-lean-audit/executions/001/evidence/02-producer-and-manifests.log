      "start_line": 12,
      "text": "  rule scanGroups(iCons(32, REST:IntSeq), CUR:IntSeq,\n                  DEPTH:Int, ACC:ValSeq)\n    => scanGroups(REST, CUR, DEPTH, ACC)"
    },
    {
      "attributes": [],
