    46	  // balancedTail(CODES, DEPTH) is the contract domain: only spaces and
    47	  // parentheses occur, no suffix prefix underflows DEPTH, and final depth is
    48	  // zero. This admits spaces anywhere and adjacent top-level groups.
    49	  syntax Bool ::= balancedTail(IntSeq, Int) [function, total]
    50	  rule balancedTail(.IntSeq, DEPTH:Int) => DEPTH ==Int 0
    51	  rule balancedTail(iCons(32, REST:IntSeq), DEPTH:Int)
    52	    => balancedTail(REST, DEPTH)
    53	  rule balancedTail(iCons(40, REST:IntSeq), DEPTH:Int)
    54	    => balancedTail(REST, DEPTH +Int 1)
    55	  rule balancedTail(iCons(C:Int, REST:IntSeq), DEPTH:Int)
    56	    => C ==Int 41 andBool DEPTH >Int 0
