+             (str(.IntSeq), .Exprs))
+        => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope("separate_paren_groups" |-> solutionClosure,
+                   parent(-1))
