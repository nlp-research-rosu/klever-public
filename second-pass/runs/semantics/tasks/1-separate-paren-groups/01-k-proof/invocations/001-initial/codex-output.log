+             Expr(Call(Attribute(Name("groups"), "append"),
+                       (Name("current"), .Exprs)))
+             Assign(Name("current"), Str(""))
+             .Stmts,
+             .Stmts)
+           .Stmts)
+         Return(Name("groups"))
+         .Stmts,
+         0)
+
+endmodule

