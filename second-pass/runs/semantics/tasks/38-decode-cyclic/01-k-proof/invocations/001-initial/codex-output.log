+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Induction lemma for one active decode_cyclic frame. Its circular use on
+  // the strictly shorter s[3:] call supplies the recursive proof step.
+  claim
+    <k> decodeBody ~> #endcall => #pop </k>
+    <env> L </env>
+    <scopes>
+      0 |-> scope("decode_cyclic" |-> decodeClosure, parent(-1))
+      L |-> scope("s" |-> str(CS), parent(0))
+      -1 |-> builtinsScope
+      SC:Map
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HNEXT </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet => retV(str(decodeCodes(CS))) </ret>
+    <exc> NoExc </exc>
+    <exit-code> CODE </exit-code>
+    requires L =/=Int 0
+     andBool L =/=Int -1
+     andBool L <Int NEXT
+     andBool 0 <Int NEXT
+     andBool keysBelow(SC, NEXT)
+
+  claim
+    <k>
+      Call(Name("decode_cyclic"), (str(CS), .Exprs))
+      =>
+      str(decodeCodes(CS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("decode_cyclic" |-> decodeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..6238cdef1e3565ea9044d977c9c2393d6b364b68
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,81 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // This is the exact translated body of decode_cyclic in solution.mpy.
+  syntax Stmts ::= "decodeBody" [macro]
+  rule decodeBody =>
+    Expr(
+      Str(
+        "\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    "))
+    If(Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
+      Return(Name("s")),
+      .Stmts)
+    Return(
+      BinOp(
+        "+",
+        BinOp(
+          "+",
+          Subscript(Name("s"), Int(2)),
+          Subscript(Name("s"), Slice(NoBound, Int(2), NoBound))),
+        Call(
+          Name("decode_cyclic"),
+          Subscript(Name("s"), Slice(Int(3), NoBound, NoBound)))))
+
+  syntax Val ::= "decodeClosure" [macro]
+  rule decodeClosure => closureVal("s", decodeBody, 0)
+
+  // Independent recursive specification: rotate every complete block of
+  // three codes to the right, and preserve a final block of length < 3.
+  // It is phrased with the semantics' sequence primitives so that symbolic
+  // (not yet constructor-split) IntSeq values can reduce under a length path
+  // condition.
+  syntax IntSeq ::= decodeCodes(IntSeq) [function, total]
+  rule decodeCodes(CS:IntSeq) => CS
+    requires isLen(CS) <Int 3
+  rule decodeCodes(CS:IntSeq)
+    => seqConcat(
+         seqConcat(
+           iCons(intSeqAt(CS, 2), .IntSeq),
+           buildIS(CS, 0, 2, 1)),
+         decodeCodes(buildIS(CS, 3, isLen(CS), 1)))
+    requires isLen(CS) >=Int 3
+
