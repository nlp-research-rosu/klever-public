diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f98e3f1d1861db02798c632e17dd7a366400c440
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,73 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // This is the exact translated body of decode_cyclic in solution.mpy.
+  syntax Stmts ::= "decodeBody" [macro]
+  rule decodeBody =>
+    Expr(
+      Str(
+        "\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    "))
+    If(Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
+      Return(Name("s")),
+      .Stmts)
+    Return(
+      BinOp(
+        "+",
+        BinOp(
+          "+",
+          Subscript(Name("s"), Int(2)),
+          Subscript(Name("s"), Slice(NoBound, Int(2), NoBound))),
+        Call(
+          Name("decode_cyclic"),
+          Subscript(Name("s"), Slice(Int(3), NoBound, NoBound)))))
+
+  syntax Val ::= "decodeClosure" [macro]
+  rule decodeClosure => closureVal("s", decodeBody, 0)
+
+  // Independent recursive specification: rotate every complete block of
+  // three codes to the right, and preserve a final block of length < 3.
+  // It is phrased with the semantics' sequence primitives so that symbolic
+  // (not yet constructor-split) IntSeq values can reduce under a length path
+  // condition.
+  syntax IntSeq ::= decodeCodes(IntSeq) [function, total]
+  rule decodeCodes(CS:IntSeq) => CS
+    requires isLen(CS) <Int 3
+  rule decodeCodes(CS:IntSeq)
+    => seqConcat(
+         seqConcat(
+           iCons(intSeqAt(CS, 2), .IntSeq),
+           buildIS(CS, 0, 2, 1)),
+         decodeCodes(buildIS(CS, 3, isLen(CS), 1)))
+    requires isLen(CS) >=Int 3
+
+  // Symbolic slice-length lemma for s[3:]. It is a derived fact about
+  // buildIS: with unit step and stop=len(s), exactly len(s)-3 codes remain.
+  rule isLen(buildIS(CS:IntSeq,
+                     clampHi(3, isLen(CS), 1),
+                     isLen(CS),
+                     1))
+    => isLen(CS) -Int 3
+    requires isLen(CS) >=Int 3
+    [simplification]
+
+  // Scope locations are allocated monotonically. keysBelow records the
+  // corresponding invariant for the abstract remainder of a scopes map.
+  syntax Bool ::= keysBelow(Map, Int) [function]
+  rule keysBelow(.Map, _N:Int) => true
+  rule keysBelow((I:Int |-> _S:Scope) REST:Map, N:Int)
+    => (I <Int N) andBool keysBelow(REST, N)
+
+  rule keysBelow(M:Map, N:Int +Int 1) => true
+    requires keysBelow(M, N)
+    [simplification]
+
+  rule N:Int in_keys(M:Map) => false
+    requires keysBelow(M, N)
+    [simplification]
+
+  rule (M:Map [ N:Int <- S:Scope ]) => (N |-> S) M
+    requires keysBelow(M, N)
+    [simplification]
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..43b2239d249e6ffa76057a3b2edc7797faf7832d
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,18 @@
+def encode_cyclic(s: str):
+    """
+    returns encoded string by cycling groups of three characters.
+    """
+    # split string to groups. Each of length 3.
+    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]
+    # cycle elements in each group. Unless group has fewer elements than 3.
+    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]
+    return "".join(groups)
+
+
+def decode_cyclic(s: str):
+    """
+    takes as input string encoded with encode_cyclic function. Returns decoded string.
+    """
+    if len(s) < 3:
+        return s
+    return s[2] + s[:2] + decode_cyclic(s[3:])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..a4783a037012f0ca51acf00fba423d5ad70c2ad3
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,48 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Induction lemma for one active decode_cyclic frame. Its circular use on
+  // the strictly shorter s[3:] call supplies the recursive proof step.
+  claim
+    <k> decodeBody ~> #endcall => #pop </k>
+    <env> L </env>
+    <scopes>
+      0 |-> scope("decode_cyclic" |-> decodeClosure, parent(-1))
+      L |-> scope("s" |-> str(CS), parent(0))
+      -1 |-> builtinsScope
+      SC:Map
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HNEXT </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet => retV(str(decodeCodes(CS))) </ret>
+    <exc> NoExc </exc>
+    <exit-code> CODE </exit-code>
+    requires L =/=Int 0
+     andBool L =/=Int -1
+     andBool L <Int NEXT
+     andBool 0 <Int NEXT
+     andBool keysBelow(SC, NEXT)
+
+  claim
+    <k>
+      Call(Name("decode_cyclic"), (str(CS), .Exprs))
+      =>
+      str(decodeCodes(CS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("decode_cyclic" |-> decodeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
