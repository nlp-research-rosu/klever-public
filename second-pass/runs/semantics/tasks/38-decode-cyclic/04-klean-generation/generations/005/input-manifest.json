      "normalized_sha256": "d56a068e4235aa49b1cd928b25a0294fe7010fa514d1d87cab8f18e9cc18acb0",
      "rationale": "Macro expansion defining the named decodeBody proof term as the translated statement sequence for decode_cyclic.",
      "source_rule_id": "rule-d56a068e4235aa49b1cd928b25a0294fe7010fa514d1d87cab8f18e9cc18acb0",
      "start_line": 8,
      "text": "  rule decodeBody =>\n    Expr(\n      Str(\n        \"\\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\\n    \"))\n    If(Compare(Call(Name(\"len\"), Name(\"s\")), CmpOp(\"<\", Int(3))),\n      Return(Name(\"s\")),\n      .Stmts)\n    Return(\n      BinOp(\n        \"+\",\n        BinOp(\n          \"+\",\n          Subscript(Name(\"s\"), Int(2)),\n          Subscript(Name(\"s\"), Slice(NoBound, Int(2), NoBound))),\n        Call(\n          Name(\"decode_cyclic\"),\n          Subscript(Name(\"s\"), Slice(Int(3), NoBound, NoBound)))))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 27,
      "module": "VERIFICATION",
      "normalized_sha256": "3f60be28f9a716cfc0f65ee7b19c2ab699cae630be41067b468e9568e86ef9aa",
      "rationale": "Macro equation defining the named decodeClosure value from its parameter, body summary, and defining environment.",
      "source_rule_id": "rule-3f60be28f9a716cfc0f65ee7b19c2ab699cae630be41067b468e9568e86ef9aa",
      "start_line": 27,
      "text": "  rule decodeClosure => closureVal(\"s\", decodeBody, 0)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 36,
      "module": "VERIFICATION",
      "normalized_sha256": "b1b7e1ad3003d8901aebf6310de9ea9b2cef51cbacac53679918f54f9f37c15d",
      "rationale": "Base equation of the recursive decodeCodes mathematical specification for sequences shorter than three.",
      "source_rule_id": "rule-b1b7e1ad3003d8901aebf6310de9ea9b2cef51cbacac53679918f54f9f37c15d",
      "start_line": 35,
      "text": "  rule decodeCodes(CS:IntSeq) => CS\n    requires isLen(CS) <Int 3"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 43,
      "module": "VERIFICATION",
      "normalized_sha256": "0ed947467c589a59b54691a21e8362e5ed2b18416565f0b33415cab8a5df0e8d",
      "rationale": "Recursive equation of the decodeCodes mathematical specification for a complete three-code block followed by the remaining sequence.",
      "source_rule_id": "rule-0ed947467c589a59b54691a21e8362e5ed2b18416565f0b33415cab8a5df0e8d",
      "start_line": 37,
      "text": "  rule decodeCodes(CS:IntSeq)\n    => seqConcat(\n         seqConcat(\n           iCons(intSeqAt(CS, 2), .IntSeq),\n           buildIS(CS, 0, 2, 1)),\n         decodeCodes(buildIS(CS, 3, isLen(CS), 1)))\n    requires isLen(CS) >=Int 3"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 62,
      "module": "VERIFICATION",
      "normalized_sha256": "dd1b844f1c32e6ed03487bd5db87a2b48c7ddeb9ae527405b433308910e6ed29",
      "rationale": "Base equation defining the keysBelow structural predicate on the empty map.",
      "source_rule_id": "rule-dd1b844f1c32e6ed03487bd5db87a2b48c7ddeb9ae527405b433308910e6ed29",
      "start_line": 62,
      "text": "  rule keysBelow(.Map, _N:Int) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 64,
      "module": "VERIFICATION",
      "normalized_sha256": "d293ed9920d4ca2960d4446a574adcd07c99a55533210e9e6bf6d7ec51386abf",
      "rationale": "Recursive structural equation defining keysBelow over one integer-keyed scope-map entry and the remaining map.",
      "source_rule_id": "rule-d293ed9920d4ca2960d4446a574adcd07c99a55533210e9e6bf6d7ec51386abf",
      "start_line": 63,
      "text": "  rule keysBelow((I:Int |-> _S:Scope) REST:Map, N:Int)\n    => (I <Int N) andBool keysBelow(REST, N)"
    }
  ],
