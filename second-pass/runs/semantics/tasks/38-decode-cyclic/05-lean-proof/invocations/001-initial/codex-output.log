 import Klean38DecodeCyclic.Lemmas
+import Std.Tactic.Omega
 
 namespace Proof
 
+def intSeqToList : SortIntSeq → List SortInt
+  | .«.IntSeq_MPY-CORE_IntSeq» => []
+  | .«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x xs => x :: intSeqToList xs
+
