@@ -0,0 +1,33 @@
+import Proof
+
+theorem generatedSortScopeIsEmpty (s : SortScope) : False := by
+  exact nomatch s
+
+theorem generatedMapUpdateObligationIsVacuous
+    (mapUpdate : SortMap → SortKItem → SortKItem → SortMap)
+    (mapConcat : SortMap → SortMap → SortMap)
+    (mapItem : SortKItem → SortKItem → SortMap)
+    (keysBelow : SortMap → SortInt → SortBool) :
+    ∀ (S : SortScope) (N : SortInt) (M : SortMap)
+      (h : keysBelow M N = true),
+      mapUpdate M (.inj_SortInt N) (.inj_SortScope S) =
+        mapConcat (mapItem (.inj_SortInt N) (.inj_SortScope S)) M := by
+  intro S
+  exact nomatch S
+
+theorem generatedMapDeleteObligationIsVacuous
+    (mapDelete : SortMap → SortKItem → SortMap)
+    (mapConcat : SortMap → SortMap → SortMap)
+    (mapItem : SortKItem → SortKItem → SortMap)
+    (keysBelow : SortMap → SortInt → SortBool) :
+    ∀ (N : SortInt) (M : SortMap) (S : SortScope)
+      (h : keysBelow M N = true),
+      mapDelete (mapConcat (mapItem (.inj_SortInt N) (.inj_SortScope S)) M)
+          (.inj_SortInt N) =
+        M := by
+  intro N M S
+  exact nomatch S
+
+#print axioms generatedSortScopeIsEmpty
+#print axioms generatedMapUpdateObligationIsVacuous
+#print axioms generatedMapDeleteObligationIsVacuous
