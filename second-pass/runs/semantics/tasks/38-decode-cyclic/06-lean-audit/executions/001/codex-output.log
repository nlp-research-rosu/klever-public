+theorem addition_negative_example : Proof.«_+Int_» (-7) 5 = -2 := rfl
+theorem comparison_false_example : Proof.«_>=Int_» 2 3 = false := rfl
+theorem length_example :
+    «isLen(_)_MPY-CORE_Int_IntSeq» seq0123 = 4 := rfl
+theorem build_unit_step_example :
+    «buildIS(_,_,_,_)_MPY-SUBSCRIPT_IntSeq_IntSeq_Int_Int_Int»
