+    «buildIS(_,_,_,_)_MPY-SUBSCRIPT_IntSeq_IntSeq_Int_Int_Int»
+      seq0123 1 4 1 = seq123 := rfl
+theorem build_positive_stride_example :
+    «buildIS(_,_,_,_)_MPY-SUBSCRIPT_IntSeq_IntSeq_Int_Int_Int»
+      seq0123 0 4 2 = seq02 := rfl
+theorem build_negative_stride_example :
+    «buildIS(_,_,_,_)_MPY-SUBSCRIPT_IntSeq_IntSeq_Int_Int_Int»
+      seq0123 3 (-1) (-1) = seq3210 := rfl
+theorem build_zero_stride_example :
+    «buildIS(_,_,_,_)_MPY-SUBSCRIPT_IntSeq_IntSeq_Int_Int_Int»
+      seq0123 0 4 0 = .«.IntSeq_MPY-CORE_IntSeq» := rfl
+theorem clamp_inside_example :
+    «clampHi(_,_,_)_MPY-SUBSCRIPT_Int_Int_Int_Int» 3 5 1 = 3 := rfl
+theorem clamp_high_positive_example :
+    «clampHi(_,_,_)_MPY-SUBSCRIPT_Int_Int_Int_Int» 7 5 1 = 5 := rfl
+theorem clamp_high_negative_example :
+    «clampHi(_,_,_)_MPY-SUBSCRIPT_Int_Int_Int_Int» 7 5 (-1) = 4 := rfl
+
+def intItem (value : SortInt) : SortKItem := .inj_SortInt value
+def singletonIntMap : SortMap := ⟨[(intItem 0, intItem 99)]⟩
+
+theorem map_concat_example :
+    _Map_ singletonIntMap ⟨[]⟩ = singletonIntMap := rfl
+theorem map_membership_empty_example :
+    «_in_keys(_)_MAP_Bool_KItem_Map» (intItem 0) ⟨[]⟩ = false := rfl
+theorem map_update_empty_example :
+    «Map:update» ⟨[]⟩ (intItem 0) (intItem 99) = singletonIntMap := rfl
+theorem keys_below_empty_example :
+    «keysBelow(_,_)_VERIFICATION_Bool_Map_Int» ⟨[]⟩ 0 = true := rfl
+theorem keys_below_int_key_example :
+    «keysBelow(_,_)_VERIFICATION_Bool_Map_Int» singletonIntMap 1 = true := rfl
+
+#print axioms build_unit_step_example
+#print axioms build_positive_stride_example
+#print axioms build_negative_stride_example
