+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char path[PATH_MAX];
+  ssize_t n = readlink("/proc/self/exe", path, sizeof(path) - 1);
+  if (n < 0) {
+    fprintf(stderr, "readlink failed: %s\n", strerror(errno));
+    return 1;
+  }
+  path[n] = '\0';
+  puts(path);
+  return 0;
+}
