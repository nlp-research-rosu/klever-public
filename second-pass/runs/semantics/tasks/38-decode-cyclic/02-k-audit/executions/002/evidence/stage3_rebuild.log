EXIT_STATUS=0

$ python3 py2mpy.py review_concrete_tests.py
Module(
  FuncDef("encode_cyclic", Params("s"), CellVars("s"), FreeVars(),
    Expr(
      Str(
        "\n    returns encoded string by cycling groups of three characters.\n    "))
    Assign(
      Name("groups"),
      ListComp(Subscript(
        Name("s"),
        Slice(
          BinOp("*", Int(3), Name("i")),
          Call(
            Name("min"),
            BinOp("+", BinOp("*", Int(3), Name("i")), Int(3)),
            Call(Name("len"), Name("s"))),
          NoBound)),
        CompFor(
          Name("i"),
          Call(
            Name("range"),
            BinOp(
              "//",
              BinOp("+", Call(Name("len"), Name("s")), Int(2)),
              Int(3))),
          Bool(true))))
    Assign(
      Name("groups"),
      ListComp(IfExp(
        Compare(Call(Name("len"), Name("group")), CmpOp("==", Int(3))),
        BinOp(
          "+",
          Subscript(Name("group"), Slice(Int(1), NoBound, NoBound)),
          Subscript(Name("group"), Int(0))),
        Name("group")),
        CompFor(Name("group"), Name("groups"), Bool(true))))
    Return(Call(Attribute(Str(""), "join"), Name("groups"))))
  FuncDef("decode_cyclic", Params("s"),
    Expr(
      Str(
        "\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    "))
    If(Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
      Return(Name("s")),
      )
    Return(
      BinOp(
        "+",
        BinOp(
          "+",
          Subscript(Name("s"), Int(2)),
          Subscript(Name("s"), Slice(NoBound, Int(2), NoBound))),
        Call(
          Name("decode_cyclic"),
          Subscript(Name("s"), Slice(Int(3), NoBound, NoBound))))))
  Assert(
    Compare(Call(Name("decode_cyclic"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("a")),
      CmpOp("==", Str("a"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("ab")),
      CmpOp("==", Str("ab"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("abc")),
      CmpOp("==", Str("cab"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("abcd")),
      CmpOp("==", Str("cabd"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("abcde")),
      CmpOp("==", Str("cabde"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("abcdef")),
      CmpOp("==", Str("cabfde"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("abcdefg")),
      CmpOp("==", Str("cabfdeg"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("abcdefgh")),
      CmpOp("==", Str("cabfdegh"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("abcdefghi")),
      CmpOp("==", Str("cabfdeigh"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("bca")),
      CmpOp("==", Str("abc"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("bcaefd")),
      CmpOp("==", Str("abcdef"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("bcaefdg")),
      CmpOp("==", Str("abcdefg"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("elho lorwld")),
      CmpOp("==", Str("hello world"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("\n\t ")),
      CmpOp("==", Str(" \n\t"))))
  Assert(
    Compare(
      Call(
        Name("decode_cyclic"),
        Call(Name("encode_cyclic"), Str("0123456789"))),
      CmpOp("==", Str("0123456789")))))
