@@ -0,0 +1,24 @@
+requires "verification.k"
+
+module SPEC-ENTRY
+  imports VERIFICATION
+
+  claim
+    <k>
+      Call(Name("decode_cyclic"), (str(CS), .Exprs))
+      =>
+      str(decodeCodes(CS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("decode_cyclic" |-> decodeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/38-decode-cyclic/spec-fixed-slice-lemmas.k b//tmp/audit-work/38-decode-cyclic/spec-fixed-slice-lemmas.k
new file mode 100644
index 0000000000000000000000000000000000000000..02acfc0f54535a49c391b163fb7e68dc492c5d44
--- /dev/null
+++ b//tmp/audit-work/38-decode-cyclic/spec-fixed-slice-lemmas.k
@@ -0,0 +1,72 @@
+requires "reference-semantics/semantics.k"
+
+module SPEC-FIXED-SLICE-LEMMAS
+  imports MPY
+
+  // General bridge-free induction: a positive-unit slice over the in-bounds
+  // half-open range [I, STOP) has STOP-I elements.
+  claim
+    <k>
+      isLen(buildIS(CS:IntSeq, I:Int, STOP:Int, 1))
+      =>
+      STOP -Int I
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int I
+     andBool I <=Int STOP
+     andBool STOP <=Int isLen(CS)
+
+  claim
+    <k>
+      clampHi(3, isLen(CS:IntSeq), 1)
+      =>
+      3
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires isLen(CS) >=Int 3
+
+  claim
+    <k>
+      isLen(buildIS(CS:IntSeq,
+                    clampHi(3, isLen(CS), 1),
+                    isLen(CS),
+                    1))
+      =>
+      isLen(CS) -Int 3
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires isLen(CS) >=Int 3
+endmodule
diff --git a//tmp/audit-work/38-decode-cyclic/spec-ground.k b//tmp/audit-work/38-decode-cyclic/spec-ground.k
new file mode 100644
index 0000000000000000000000000000000000000000..35bb08021e1c539729142a3a843862675ab55bd4
