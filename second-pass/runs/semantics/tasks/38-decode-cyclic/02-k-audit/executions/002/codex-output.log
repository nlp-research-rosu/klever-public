/reference/reference-semantics/semantics/builtins.k-226-  syntax Int ::= firstNdE(EvPair) [function, total]
/reference/reference-semantics/semantics/builtins.k-227-  rule firstNdE(evp(_:OpSeq, iCons(N:Int, _:IntSeq))) => N
/reference/reference-semantics/semantics/builtins.k-228-  rule firstNdE(_:EvPair) => 0 [owise]
