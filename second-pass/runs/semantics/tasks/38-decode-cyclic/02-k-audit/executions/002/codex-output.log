/reference/reference-semantics/semantics/methods.k:30:  rule joinCodes(SEP:IntSeq, vCons(str(CS:IntSeq), vCons(V:Val, R:ValSeq)))
/reference/reference-semantics/semantics/methods.k:34:  rule applyMethod(str(CS:IntSeq), "count", str(PC:IntSeq), .Vals) => cntSub(CS, PC)
/reference/reference-semantics/semantics/methods.k:35:  syntax Int ::= cntSub(IntSeq, IntSeq) [function]
/reference/reference-semantics/semantics/methods.k:36:  rule cntSub(.IntSeq, _:IntSeq) => 0
/reference/reference-semantics/semantics/methods.k:37:  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => 1 +Int cntSub(dropIS(iCons(C, R), isLen(PC)), PC)
/reference/reference-semantics/semantics/methods.k:39:  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => cntSub(R, PC)
/reference/reference-semantics/semantics/methods.k:41:  syntax IntSeq ::= dropIS(IntSeq, Int) [function, total]
/reference/reference-semantics/semantics/methods.k:42:  rule dropIS(S:IntSeq, N:Int) => S requires N <=Int 0
/reference/reference-semantics/semantics/methods.k:43:  rule dropIS(.IntSeq, _:Int) => .IntSeq [owise]
/reference/reference-semantics/semantics/methods.k:44:  rule dropIS(iCons(_:Int, R:IntSeq), N:Int) => dropIS(R, N -Int 1) requires N >Int 0
/reference/reference-semantics/semantics/methods.k:47:  rule applyMethod(str(CS:IntSeq), "strip", .Vals) => str(revIS(trimWS(revIS(trimWS(CS)))))
/reference/reference-semantics/semantics/methods.k:48:  syntax IntSeq ::= trimWS(IntSeq) [function, total]
/reference/reference-semantics/semantics/methods.k:49:  rule trimWS(.IntSeq) => .IntSeq
/reference/reference-semantics/semantics/methods.k:50:  rule trimWS(iCons(C:Int, R:IntSeq)) => trimWS(R) requires isWSC(C)
/reference/reference-semantics/semantics/methods.k:51:  rule trimWS(iCons(C:Int, R:IntSeq)) => iCons(C, R) requires notBool isWSC(C)
/reference/reference-semantics/semantics/methods.k:52:  syntax IntSeq ::= revIS(IntSeq) [function, total] | revISAcc(IntSeq, IntSeq) [function, total]
/reference/reference-semantics/semantics/methods.k:53:  rule revIS(S:IntSeq) => revISAcc(S, .IntSeq)
/reference/reference-semantics/semantics/methods.k:54:  rule revISAcc(.IntSeq, A:IntSeq) => A
/reference/reference-semantics/semantics/methods.k:55:  rule revISAcc(iCons(C:Int, R:IntSeq), A:IntSeq) => revISAcc(R, iCons(C, A))
/reference/reference-semantics/semantics/methods.k:58:  rule applyMethod(str(CS:IntSeq), "encode", str(_:IntSeq), .Vals) => str(CS)
/reference/reference-semantics/semantics/methods.k:61:  rule applyMethod(str(XC:IntSeq), "startswith", str(PC:IntSeq), .Vals) => startsWith(PC, XC)
/reference/reference-semantics/semantics/methods.k:64:  rule applyMethod(list(VS:ValSeq), "count", V:Val, .Vals) => cntOccVS(VS, V)
/reference/reference-semantics/semantics/methods.k:65:  syntax Int ::= cntOccVS(ValSeq, Val) [function, total]
/reference/reference-semantics/semantics/methods.k:66:  rule cntOccVS(.ValSeq, _:Val)                => 0
/reference/reference-semantics/semantics/methods.k:67:  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => 1 +Int cntOccVS(R, V) requires A ==K V
/reference/reference-semantics/semantics/methods.k:68:  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => cntOccVS(R, V)        requires notBool (A ==K V)
/reference/reference-semantics/semantics/methods.k:72:  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), .Vals)
/reference/reference-semantics/semantics/methods.k:75:  syntax ValSeq ::= splitWS(IntSeq, IntSeq, ValSeq) [function]  // remaining, current token, result
/reference/reference-semantics/semantics/methods.k:76:  rule splitWS(.IntSeq, CUR:IntSeq, ACC:ValSeq) => flushTok(ACC, CUR)
/reference/reference-semantics/semantics/methods.k:77:  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, .IntSeq, flushTok(ACC, CUR))
/reference/reference-semantics/semantics/methods.k:79:  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, seqConcat(CUR, iCons(C, .IntSeq)), ACC)
/reference/reference-semantics/semantics/methods.k:82:  syntax ValSeq ::= flushTok(ValSeq, IntSeq) [function]
/reference/reference-semantics/semantics/methods.k:83:  rule flushTok(ACC:ValSeq, .IntSeq)            => ACC
/reference/reference-semantics/semantics/methods.k:84:  rule flushTok(ACC:ValSeq, iCons(C:Int, T:IntSeq)) => valSeqConcat(ACC, vCons(str(iCons(C, T)), .ValSeq))
/reference/reference-semantics/semantics/methods.k:85:  syntax Bool ::= isWSC(Int) [function, total]
/reference/reference-semantics/semantics/methods.k:86:  rule isWSC(C:Int) => C ==Int 32 orBool C ==Int 9 orBool C ==Int 10 orBool C ==Int 13
/reference/reference-semantics/semantics/methods.k:89:  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), (kwV("sep", str(S:IntSeq)), .Vals))
/reference/reference-semantics/semantics/methods.k:94:  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), (str(iCons(SEP:Int, .IntSeq)), .Vals))
/reference/reference-semantics/semantics/methods.k:97:  syntax ValSeq ::= splitSep(IntSeq, Int, IntSeq) [function]  // remaining, sep code, current token
/reference/reference-semantics/semantics/methods.k:98:  rule splitSep(.IntSeq, _SEP:Int, CUR:IntSeq)              => vCons(str(CUR), .ValSeq)
/reference/reference-semantics/semantics/methods.k:99:  rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => vCons(str(CUR), splitSep(R, SEP, .IntSeq))
/reference/reference-semantics/semantics/methods.k:101:  rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => splitSep(R, SEP, seqConcat(CUR, iCons(C, .IntSeq)))
/reference/reference-semantics/semantics/methods.k:104:  rule applyMethod(str(CS:IntSeq), "replace", str(iCons(A:Int, .IntSeq)), str(iCons(B:Int, .IntSeq)), .Vals)
/reference/reference-semantics/semantics/methods.k:106:  syntax IntSeq ::= replaceC(IntSeq, Int, Int) [function, total]
/reference/reference-semantics/semantics/methods.k:107:  rule replaceC(.IntSeq, _:Int, _:Int)             => .IntSeq
/reference/reference-semantics/semantics/methods.k:108:  rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(B, replaceC(R, A, B)) requires C ==Int A
/reference/reference-semantics/semantics/methods.k:109:  rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(C, replaceC(R, A, B)) requires notBool (C ==Int A)
/reference/reference-semantics/semantics/methods.k:112:  syntax Bool ::= isUpperC(Int) [function, total]
/reference/reference-semantics/semantics/methods.k:113:  rule isUpperC(C:Int) => C >=Int 65 andBool C <=Int 90
/reference/reference-semantics/semantics/methods.k:115:  syntax Bool ::= isLowerC(Int) [function, total]
/reference/reference-semantics/semantics/methods.k:116:  rule isLowerC(C:Int) => C >=Int 97 andBool C <=Int 122
/reference/reference-semantics/semantics/methods.k:118:  syntax Bool ::= isAlphaC(Int) [function, total]
/reference/reference-semantics/semantics/methods.k:119:  rule isAlphaC(C:Int) => isUpperC(C) orBool isLowerC(C)
/reference/reference-semantics/semantics/methods.k:121:  syntax Bool ::= isDigitC(Int) [function, total]
/reference/reference-semantics/semantics/methods.k:122:  rule isDigitC(C:Int) => C >=Int 48 andBool C <=Int 57
/reference/reference-semantics/semantics/methods.k:124:  syntax Bool ::= hasUpper(IntSeq) [function, total]
/reference/reference-semantics/semantics/methods.k:125:  rule hasUpper(.IntSeq) => false
/reference/reference-semantics/semantics/methods.k:126:  rule hasUpper(iCons(C:Int, S:IntSeq)) => isUpperC(C) orBool hasUpper(S)
/reference/reference-semantics/semantics/methods.k:128:  syntax Bool ::= hasLower(IntSeq) [function, total]
/reference/reference-semantics/semantics/methods.k:129:  rule hasLower(.IntSeq) => false
/reference/reference-semantics/semantics/methods.k:130:  rule hasLower(iCons(C:Int, S:IntSeq)) => isLowerC(C) orBool hasLower(S)
/reference/reference-semantics/semantics/methods.k:132:  syntax Bool ::= allAlpha(IntSeq) [function, total]
/reference/reference-semantics/semantics/methods.k:133:  rule allAlpha(.IntSeq) => true
/reference/reference-semantics/semantics/methods.k:134:  rule allAlpha(iCons(C:Int, S:IntSeq)) => isAlphaC(C) andBool allAlpha(S)
/reference/reference-semantics/semantics/methods.k:136:  syntax Bool ::= allDigit(IntSeq) [function, total]
/reference/reference-semantics/semantics/methods.k:137:  rule allDigit(.IntSeq) => true
/reference/reference-semantics/semantics/methods.k:138:  rule allDigit(iCons(C:Int, S:IntSeq)) => isDigitC(C) andBool allDigit(S)
/reference/reference-semantics/semantics/methods.k:140:  syntax Int ::= lowerC(Int) [function, total]
/reference/reference-semantics/semantics/methods.k:142:  rule lowerC(C:Int) => C +Int 32 requires isUpperC(C)
/reference/reference-semantics/semantics/methods.k:143:  rule lowerC(C:Int) => C         [owise]
/reference/reference-semantics/semantics/methods.k:145:  syntax Int ::= upperC(Int) [function, total]
/reference/reference-semantics/semantics/methods.k:146:  rule upperC(C:Int) => C -Int 32 requires isLowerC(C)
/reference/reference-semantics/semantics/methods.k:147:  rule upperC(C:Int) => C         [owise]
/reference/reference-semantics/semantics/methods.k:149:  syntax Int ::= swapC(Int) [function, total]
/reference/reference-semantics/semantics/methods.k:150:  rule swapC(C:Int) => C +Int 32 requires isUpperC(C)
/reference/reference-semantics/semantics/methods.k:151:  rule swapC(C:Int) => C -Int 32 requires isLowerC(C)
/reference/reference-semantics/semantics/methods.k:152:  rule swapC(C:Int) => C         [owise]
/reference/reference-semantics/semantics/methods.k:154:  syntax IntSeq ::= mapLower(IntSeq) [function, total]
/reference/reference-semantics/semantics/methods.k:155:  rule mapLower(.IntSeq) => .IntSeq
/reference/reference-semantics/semantics/methods.k:156:  rule mapLower(iCons(C:Int, S:IntSeq)) => iCons(lowerC(C), mapLower(S))
/reference/reference-semantics/semantics/methods.k:158:  syntax IntSeq ::= mapUpper(IntSeq) [function, total]
