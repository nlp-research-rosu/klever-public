/reference/reference-semantics/semantics/builtins.k-243-  rule passPowE(_:OpSeq, .IntSeq) => evp(.OpSeq, .IntSeq) [owise]
/reference/reference-semantics/semantics/builtins.k-244-  syntax EvPair ::= powCombE(Int, EvPair) [function, total]
/reference/reference-semantics/semantics/builtins.k-245-  rule powCombE(N:Int, evp(OPS:OpSeq, iCons(M:Int, REST:IntSeq))) => evp(OPS, iCons(N ^Int M, REST))
