diff --git a//tmp/audit-work/38-decode-cyclic/spec-helper.k b//tmp/audit-work/38-decode-cyclic/spec-helper.k
new file mode 100644
index 0000000000000000000000000000000000000000..6b4e02bb978af1aaad7f8ddadc74f09e871f8ec2
--- /dev/null
+++ b//tmp/audit-work/38-decode-cyclic/spec-helper.k
@@ -0,0 +1,27 @@
+requires "verification.k"
+
+module SPEC-HELPER
+  imports VERIFICATION
+
+  claim
+    <k> decodeBody ~> #endcall => #pop </k>
+    <env> L </env>
+    <scopes>
+      0 |-> scope("decode_cyclic" |-> decodeClosure, parent(-1))
+      L |-> scope("s" |-> str(CS), parent(0))
+      -1 |-> builtinsScope
+      SC:Map
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HNEXT </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet => retV(str(decodeCodes(CS))) </ret>
+    <exc> NoExc </exc>
+    <exit-code> CODE </exit-code>
+    requires L =/=Int 0
+     andBool L =/=Int -1
+     andBool L <Int NEXT
+     andBool 0 <Int NEXT
+     andBool keysBelow(SC, NEXT)
+endmodule
