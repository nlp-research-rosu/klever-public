+requires "reference-semantics/semantics.k"
+
+module SPEC-FIXED-SLICE-LEMMAS
+  imports MPY
+
+  // General bridge-free induction: base case for [STOP, STOP).
+  claim
+    <k>
+      isLen(buildIS(CS:IntSeq, I:Int, STOP:Int, 1))
+      =>
+      STOP -Int I
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int I
+     andBool I ==Int STOP
+     andBool STOP <=Int isLen(CS)
+
+  // Inductive step for a nonempty positive-unit in-bounds slice.
+  claim
+    <k>
+      isLen(buildIS(CS:IntSeq, I:Int, STOP:Int, 1))
+      =>
+      STOP -Int I
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int I
+     andBool I <Int STOP
+     andBool STOP <=Int isLen(CS)
+
+  claim
+    <k>
+      clampHi(3, isLen(CS:IntSeq), 1)
+      =>
+      3
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires isLen(CS) >=Int 3
+
+  claim
+    <k>
+      isLen(buildIS(CS:IntSeq,
+                    clampHi(3, isLen(CS), 1),
+                    isLen(CS),
+                    1))
+      =>
+      isLen(CS) -Int 3
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires isLen(CS) >=Int 3
+endmodule
