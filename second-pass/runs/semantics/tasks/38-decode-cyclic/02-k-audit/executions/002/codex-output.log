+module SPEC-FIXED-SLICE-LEMMAS
+  imports MPY
+
+  claim
+    <k>
+      isLen(buildIS(CS:IntSeq,
+                    clampHi(3, isLen(CS), 1),
+                    isLen(CS),
+                    1))
+      =>
+      isLen(CS) -Int 3
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires isLen(CS) >=Int 3
+
+  claim
+    <k>
+      clampHi(3, isLen(CS:IntSeq), 1)
+      =>
+      3
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires isLen(CS) >=Int 3
+endmodule
