/reference/reference-semantics/semantics/builtins.k-16-  // applyBuiltin. This module owns applyBuiltin + the fold implementations.
/reference/reference-semantics/semantics/builtins.k-17-  syntax Val ::= applyBuiltin(String, Vals) [function]
/reference/reference-semantics/semantics/builtins.k-18-
/reference/reference-semantics/semantics/builtins.k-19-  // ==== len(obj) — O(1) per kind ============================================
/reference/reference-semantics/semantics/builtins.k-20-  syntax Int ::= seqLen(Val) [function]
/reference/reference-semantics/semantics/builtins.k-21-  rule applyBuiltin("len", OBJ:Val, .Vals) => seqLen(OBJ)
/reference/reference-semantics/semantics/builtins.k-22-  rule seqLen(list(VS:ValSeq))                  => vsLen(VS)
/reference/reference-semantics/semantics/builtins.k-23-  rule seqLen(tuple(VS:ValSeq))                 => vsLen(VS)
/reference/reference-semantics/semantics/builtins.k:24:  rule seqLen(str(IS:IntSeq))                   => isLen(IS)
/reference/reference-semantics/semantics/builtins.k:25:  rule seqLen(setV(DS:IntSeq))                  => isLen(DS)
/reference/reference-semantics/semantics/builtins.k-26-  rule seqLen(rangeObj(LO:Int, HI:Int, ST:Int)) => rangeLen(LO, HI, ST)
/reference/reference-semantics/semantics/builtins.k-27-
/reference/reference-semantics/semantics/builtins.k-28-  // ==== list(seq) — materialize a list/tuple into a list (e.g. list(d.keys())) ==
/reference/reference-semantics/semantics/builtins.k-29-  // Minimal: the "copy a sequence" case (list of a list is itself; list of a tuple keeps order).
/reference/reference-semantics/semantics/builtins.k-30-  // list() of other iterables (str/range/set/zip) is added via the iterator fold when needed.
/reference/reference-semantics/semantics/builtins.k-31-  // (k-cell — list() constructs a NEW object)
/reference/reference-semantics/semantics/builtins.k:32:  rule <k> #applyK(toCall(builtinV("list")), (list(VS:ValSeq),  .Vals)) => #alloc(list(VS)) ... </k>
/reference/reference-semantics/semantics/builtins.k:33:  rule <k> #applyK(toCall(builtinV("list")), (tuple(VS:ValSeq), .Vals)) => #alloc(list(VS)) ... </k>
/reference/reference-semantics/semantics/builtins.k:34:  rule <k> #applyK(toCall(builtinV("list")), .Vals)                     => #alloc(list(.ValSeq)) ... </k>
/reference/reference-semantics/semantics/builtins.k:35:  rule <k> #applyK(toCall(builtinV("list")), (str(CS:IntSeq), .Vals))   => #alloc(list(charsOf(CS))) ... </k>
/reference/reference-semantics/semantics/builtins.k:36:  syntax ValSeq ::= charsOf(IntSeq) [function, total]
/reference/reference-semantics/semantics/builtins.k-37-  rule charsOf(.IntSeq)                => .ValSeq
/reference/reference-semantics/semantics/builtins.k-38-  rule charsOf(iCons(C:Int, R:IntSeq)) => vCons(str(iCons(C, .IntSeq)), charsOf(R))
/reference/reference-semantics/semantics/builtins.k-39-
/reference/reference-semantics/semantics/builtins.k-40-  // ==== set(str) — distinct character codes =================================
/reference/reference-semantics/semantics/builtins.k-41-  rule applyBuiltin("set", str(CS:IntSeq), .Vals) => setV(dedupCodes(CS))
/reference/reference-semantics/semantics/builtins.k-42-
/reference/reference-semantics/semantics/builtins.k-43-  // ==== abs(int) ============================================================
/reference/reference-semantics/semantics/builtins.k-44-  rule applyBuiltin("abs", I:Int, .Vals) => absInt(I)
