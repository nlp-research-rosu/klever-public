+    --spec-module SPEC-HELPER || exit 1
+
+  run_step kprove spec-entry.k \
+    --definition verification-kompiled \
+    --spec-module SPEC-ENTRY || exit 1
+
+  run_step kprove spec.k \
+    --definition verification-kompiled \
+    --spec-module SPEC || exit 1
+} >"$log" 2>&1

