/reference/reference-semantics/semantics/methods.k:3:module MPY-METHODS
/reference/reference-semantics/semantics/methods.k:4:  imports MPY-CORE
/reference/reference-semantics/semantics/methods.k:5:  imports K-EQUAL
/reference/reference-semantics/semantics/methods.k:6:  imports MPY-STR
/reference/reference-semantics/semantics/methods.k:7:  imports MPY-LIST
/reference/reference-semantics/semantics/methods.k:10:  syntax Val ::= applyMethod(Val, String, Vals) [function]
/reference/reference-semantics/semantics/methods.k:13:  rule applyMethod(str(CS:IntSeq), "isupper", .Vals) => hasUpper(CS) andBool notBool hasLower(CS)
/reference/reference-semantics/semantics/methods.k:14:  rule applyMethod(str(CS:IntSeq), "islower", .Vals) => hasLower(CS) andBool notBool hasUpper(CS)
/reference/reference-semantics/semantics/methods.k:15:  rule applyMethod(str(CS:IntSeq), "isalpha", .Vals) => notBool (CS ==K .IntSeq) andBool allAlpha(CS)
/reference/reference-semantics/semantics/methods.k:16:  rule applyMethod(str(CS:IntSeq), "isdigit", .Vals) => notBool (CS ==K .IntSeq) andBool allDigit(CS)
/reference/reference-semantics/semantics/methods.k:19:  rule applyMethod(str(CS:IntSeq), "lower",    .Vals) => str(mapLower(CS))
/reference/reference-semantics/semantics/methods.k:20:  rule applyMethod(str(CS:IntSeq), "upper",    .Vals) => str(mapUpper(CS))
/reference/reference-semantics/semantics/methods.k:21:  rule applyMethod(str(CS:IntSeq), "swapcase", .Vals) => str(mapSwap(CS))
/reference/reference-semantics/semantics/methods.k:26:  rule applyMethod(str(SEP:IntSeq), "join", list(VS:ValSeq), .Vals) => str(joinCodes(SEP, VS))
