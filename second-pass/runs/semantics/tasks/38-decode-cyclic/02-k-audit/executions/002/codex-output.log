+requires "verification.k"
+
+module SPEC-GROUND
+  imports VERIFICATION
+
+  claim
+    <k> Call(Name("decode_cyclic"), (str(.IntSeq), .Exprs)) => str(.IntSeq) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("decode_cyclic" |-> decodeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim
+    <k>
+      Call(Name("decode_cyclic"),
+        (str(iCons(97, iCons(98, .IntSeq))), .Exprs))
+      =>
+      str(iCons(97, iCons(98, .IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("decode_cyclic" |-> decodeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
