/reference/reference-semantics/semantics/builtins.k-239-  rule passPowE(.OpSeq, NDS:IntSeq) => evp(.OpSeq, NDS)
/reference/reference-semantics/semantics/builtins.k-240-  rule passPowE(oCons("**", OPS:OpSeq), iCons(N:Int, NDS:IntSeq)) => powCombE(N, passPowE(OPS, NDS))
/reference/reference-semantics/semantics/builtins.k-241-  rule passPowE(oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq)) => powCarryE(O, N, passPowE(OPS, NDS))
