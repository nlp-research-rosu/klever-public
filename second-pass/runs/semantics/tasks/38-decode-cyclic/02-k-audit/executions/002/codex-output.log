/reference/reference-semantics/semantics/methods.k:160:  rule mapUpper(iCons(C:Int, S:IntSeq)) => iCons(upperC(C), mapUpper(S))
/reference/reference-semantics/semantics/methods.k:162:  syntax IntSeq ::= mapSwap(IntSeq) [function, total]
/reference/reference-semantics/semantics/methods.k:163:  rule mapSwap(.IntSeq) => .IntSeq
/reference/reference-semantics/semantics/methods.k:164:  rule mapSwap(iCons(C:Int, S:IntSeq)) => iCons(swapC(C), mapSwap(S))
/reference/reference-semantics/semantics/methods.k:166:  syntax Bool ::= startsWith(IntSeq, IntSeq) [function, total]
/reference/reference-semantics/semantics/methods.k:167:  rule startsWith(.IntSeq, _:IntSeq)               => true
/reference/reference-semantics/semantics/methods.k:168:  rule startsWith(iCons(_:Int, _:IntSeq), .IntSeq) => false
/reference/reference-semantics/semantics/methods.k:169:  rule startsWith(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool startsWith(As, Bs)
