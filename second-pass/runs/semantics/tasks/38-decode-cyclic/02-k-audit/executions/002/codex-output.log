/reference/reference-semantics/semantics/builtins.k-149-  rule applyBuiltin("str", str(CS:IntSeq), .Vals) => str(CS)
/reference/reference-semantics/semantics/builtins.k-150-
/reference/reference-semantics/semantics/builtins.k-151-  // ==== int(str) — a single digit char ('0'..'9', code 48..57) to its value =====
/reference/reference-semantics/semantics/builtins.k-152-  rule applyBuiltin("int", str(iCons(C:Int, .IntSeq)), .Vals) => C -Int 48
/reference/reference-semantics/semantics/builtins.k-153-       requires 48 <=Int C andBool C <=Int 57
/reference/reference-semantics/semantics/builtins.k-154-
/reference/reference-semantics/semantics/builtins.k-155-  // ==== int(str) — a multi-digit non-negative numeral (Horner fold; the single-char rule covers len 1)
/reference/reference-semantics/semantics/builtins.k-156-  rule applyBuiltin("int", str(CS:IntSeq), .Vals) => intDigAcc(CS, 0)
/reference/reference-semantics/semantics/builtins.k:157:       requires isLen(CS) >=Int 2
/reference/reference-semantics/semantics/builtins.k:158:  syntax Int ::= intDigAcc(IntSeq, Int) [function, total]
/reference/reference-semantics/semantics/builtins.k-159-  rule intDigAcc(.IntSeq, ACC:Int)             => ACC
/reference/reference-semantics/semantics/builtins.k-160-  rule intDigAcc(iCons(C:Int, R:IntSeq), ACC:Int) => intDigAcc(R, (ACC *Int 10) +Int (C -Int 48))
/reference/reference-semantics/semantics/builtins.k-161-
/reference/reference-semantics/semantics/builtins.k-162-  // ==== zip(a, b) — parallel iterable of pairs, truncating to the shorter =====
/reference/reference-semantics/semantics/builtins.k-163-  rule applyBuiltin("zip", list(A:ValSeq), list(B:ValSeq), .Vals) => zipObj(A, B)
/reference/reference-semantics/semantics/builtins.k-164-  rule applyBuiltin("zip", str(A:IntSeq), str(B:IntSeq), .Vals)   => zipObjS(A, B)
/reference/reference-semantics/semantics/builtins.k-165-
/reference/reference-semantics/semantics/builtins.k-166-  // zip's iterator-protocol cases (zip is created here, so its #iterNext lives here)
