/reference/reference-semantics/semantics/builtins.k-180-       requires S =/=Int 0
/reference/reference-semantics/semantics/builtins.k-181-
/reference/reference-semantics/semantics/builtins.k-182-  // ==== eval(str) — arithmetic expressions (ints, + - * // **, spaces) ========
/reference/reference-semantics/semantics/builtins.k-183-  // Python precedence: ** right-assoc, then * //, then + -. Promoted from 160's
/reference/reference-semantics/semantics/builtins.k-184-  // trusted pass evaluator, now DEFINED in the reference and driven by a
/reference/reference-semantics/semantics/builtins.k-185-  // code-level tokenizer. Reduces on concrete strings (krun); a symbolic
/reference/reference-semantics/semantics/builtins.k-186-  // argument leaves the call unevaluated for problem-level folds.
/reference/reference-semantics/semantics/builtins.k-187-  rule applyBuiltin("eval", str(CS:IntSeq), .Vals) => evalArith(CS)
/reference/reference-semantics/semantics/builtins.k:188:  syntax Int ::= evalArith(IntSeq) [function]
/reference/reference-semantics/semantics/builtins.k-189-  rule evalArith(CS:IntSeq)
/reference/reference-semantics/semantics/builtins.k-190-    => firstNdE(passAddE(passMulE(passPowE(tokOps(CS), tokNds(CS)))))
/reference/reference-semantics/semantics/builtins.k-191-
/reference/reference-semantics/semantics/builtins.k-192-  syntax OpSeq ::= ".OpSeq" | oCons(String, OpSeq)
/reference/reference-semantics/semantics/builtins.k-193-
/reference/reference-semantics/semantics/builtins.k-194-  syntax Bool ::= evDigit(Int) [function, total]
/reference/reference-semantics/semantics/builtins.k-195-  rule evDigit(C:Int) => C >=Int 48 andBool C <=Int 57
/reference/reference-semantics/semantics/builtins.k:196:  syntax Bool ::= evHead42(IntSeq) [function, total]
/reference/reference-semantics/semantics/builtins.k-197-  rule evHead42(iCons(42, _:IntSeq)) => true
/reference/reference-semantics/semantics/builtins.k-198-  rule evHead42(_:IntSeq)            => false [owise]
/reference/reference-semantics/semantics/builtins.k:199:  syntax Bool ::= evHead47(IntSeq) [function, total]
/reference/reference-semantics/semantics/builtins.k-200-  rule evHead47(iCons(47, _:IntSeq)) => true
/reference/reference-semantics/semantics/builtins.k-201-  rule evHead47(_:IntSeq)            => false [owise]
/reference/reference-semantics/semantics/builtins.k-202-
/reference/reference-semantics/semantics/builtins.k:203:  syntax OpSeq ::= tokOps(IntSeq) [function, total]
/reference/reference-semantics/semantics/builtins.k-204-  rule tokOps(.IntSeq)                 => .OpSeq
/reference/reference-semantics/semantics/builtins.k-205-  rule tokOps(iCons(32, R:IntSeq))     => tokOps(R)
/reference/reference-semantics/semantics/builtins.k-206-  rule tokOps(iCons(C:Int, R:IntSeq))  => tokOps(R) requires evDigit(C)
/reference/reference-semantics/semantics/builtins.k-207-  rule tokOps(iCons(42, iCons(42, R:IntSeq))) => oCons("**", tokOps(R))
/reference/reference-semantics/semantics/builtins.k-208-  rule tokOps(iCons(42, R:IntSeq))     => oCons("*", tokOps(R)) requires notBool evHead42(R)
/reference/reference-semantics/semantics/builtins.k-209-  rule tokOps(iCons(47, iCons(47, R:IntSeq))) => oCons("//", tokOps(R))
/reference/reference-semantics/semantics/builtins.k-210-  rule tokOps(iCons(47, R:IntSeq))     => oCons("/", tokOps(R)) requires notBool evHead47(R)
/reference/reference-semantics/semantics/builtins.k-211-  rule tokOps(iCons(43, R:IntSeq))     => oCons("+", tokOps(R))
/reference/reference-semantics/semantics/builtins.k-212-  rule tokOps(iCons(45, R:IntSeq))     => oCons("-", tokOps(R))
/reference/reference-semantics/semantics/builtins.k-213-
/reference/reference-semantics/semantics/builtins.k:214:  syntax IntSeq ::= tokNds(IntSeq) [function, total]
/reference/reference-semantics/semantics/builtins.k-215-                  | tokNdAcc(Int, IntSeq) [function, total]
/reference/reference-semantics/semantics/builtins.k-216-  rule tokNds(.IntSeq)                => .IntSeq
/reference/reference-semantics/semantics/builtins.k-217-  rule tokNds(iCons(32, R:IntSeq))    => tokNds(R)
/reference/reference-semantics/semantics/builtins.k-218-  rule tokNds(iCons(C:Int, R:IntSeq)) => tokNdAcc(C -Int 48, R) requires evDigit(C)
/reference/reference-semantics/semantics/builtins.k-219-  rule tokNds(iCons(C:Int, R:IntSeq)) => tokNds(R)
/reference/reference-semantics/semantics/builtins.k-220-       requires notBool evDigit(C) andBool C =/=Int 32
/reference/reference-semantics/semantics/builtins.k-221-  rule tokNdAcc(A:Int, iCons(C:Int, R:IntSeq)) => tokNdAcc(A *Int 10 +Int (C -Int 48), R)
/reference/reference-semantics/semantics/builtins.k-222-       requires evDigit(C)
/reference/reference-semantics/semantics/builtins.k-223-  rule tokNdAcc(A:Int, S:IntSeq) => iCons(A, tokNds(S)) [owise]
