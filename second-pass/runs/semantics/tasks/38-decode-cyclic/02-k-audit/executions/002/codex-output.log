/reference/reference-semantics/semantics/builtins.k-106-
/reference/reference-semantics/semantics/builtins.k-107-  // ==== bin(n) — "0b" + binary digit codes (promoted from 103's defined fold) ==
/reference/reference-semantics/semantics/builtins.k-108-  rule applyBuiltin("bin", N:Int, .Vals) => str(iCons(48, iCons(98, binCodes(N))))
/reference/reference-semantics/semantics/builtins.k-109-       requires N >=Int 0
/reference/reference-semantics/semantics/builtins.k-110-  // negative operand: the '-' sign prefixes the magnitude's digits
/reference/reference-semantics/semantics/builtins.k-111-  rule applyBuiltin("bin", N:Int, .Vals)
/reference/reference-semantics/semantics/builtins.k-112-    => str(iCons(45, iCons(48, iCons(98, binCodes(0 -Int N)))))
/reference/reference-semantics/semantics/builtins.k-113-       requires N <Int 0
/reference/reference-semantics/semantics/builtins.k:114:  syntax IntSeq ::= binCodes(Int) [function, total]
/reference/reference-semantics/semantics/builtins.k-115-  rule binCodes(0) => iCons(48, .IntSeq)
/reference/reference-semantics/semantics/builtins.k-116-  rule binCodes(N:Int) => binAcc(N, .IntSeq) requires N >Int 0
/reference/reference-semantics/semantics/builtins.k:117:  syntax IntSeq ::= binAcc(Int, IntSeq) [function, total]
/reference/reference-semantics/semantics/builtins.k-118-  rule binAcc(0, ACC:IntSeq) => ACC
/reference/reference-semantics/semantics/builtins.k-119-  rule binAcc(N:Int, ACC:IntSeq)
/reference/reference-semantics/semantics/builtins.k-120-    => binAcc((N -Int pyMod(N, 2)) /Int 2, iCons(48 +Int pyMod(N, 2), ACC))
/reference/reference-semantics/semantics/builtins.k-121-       requires N >Int 0
/reference/reference-semantics/semantics/builtins.k-122-
/reference/reference-semantics/semantics/builtins.k-123-  // ==== enumerate(xs) — pairs (i, v); materialized eagerly over a list =========
/reference/reference-semantics/semantics/builtins.k:124:  rule <k> #applyK(toCall(builtinV("enumerate")), (list(VS:ValSeq), .Vals))
/reference/reference-semantics/semantics/builtins.k:125:        => #alloc(list(enumVS(VS, 0))) ... </k>
/reference/reference-semantics/semantics/builtins.k-126-  syntax ValSeq ::= enumVS(ValSeq, Int) [function, total]
/reference/reference-semantics/semantics/builtins.k-127-  rule enumVS(.ValSeq, _:Int) => .ValSeq
/reference/reference-semantics/semantics/builtins.k-128-  rule enumVS(vCons(V:Val, R:ValSeq), I:Int)
/reference/reference-semantics/semantics/builtins.k-129-    => vCons(tuple(vCons(I, vCons(V, .ValSeq))), enumVS(R, I +Int 1))
/reference/reference-semantics/semantics/builtins.k-130-
/reference/reference-semantics/semantics/builtins.k-131-  // ==== map(str, xs) — eager (only the str case is in the subset) =============
/reference/reference-semantics/semantics/builtins.k:132:  rule <k> #applyK(toCall(builtinV("map")), (typeV("str"), list(VS:ValSeq), .Vals))
/reference/reference-semantics/semantics/builtins.k:133:        => #alloc(list(mapStrVS(VS))) ... </k>
/reference/reference-semantics/semantics/builtins.k-134-  syntax ValSeq ::= mapStrVS(ValSeq) [function, total]
/reference/reference-semantics/semantics/builtins.k-135-  rule mapStrVS(.ValSeq) => .ValSeq
/reference/reference-semantics/semantics/builtins.k-136-  rule mapStrVS(vCons(I:Int, R:ValSeq)) => vCons(str(strToCodes(Int2String(I))), mapStrVS(R))
/reference/reference-semantics/semantics/builtins.k-137-  rule mapStrVS(vCons(str(CS:IntSeq), R:ValSeq)) => vCons(str(CS), mapStrVS(R))
/reference/reference-semantics/semantics/builtins.k-138-
/reference/reference-semantics/semantics/builtins.k-139-  // ==== int(x) identities (int(round(x)) composes through) ====================
/reference/reference-semantics/semantics/builtins.k-140-  rule applyBuiltin("int", I:Int, .Vals) => I
/reference/reference-semantics/semantics/builtins.k-141-
