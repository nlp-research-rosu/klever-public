+        (str(iCons(98, iCons(99, iCons(97,
+             iCons(101, iCons(102, iCons(100, .IntSeq))))))), .Exprs))
+      =>
+      str(iCons(97, iCons(98, iCons(99,
+           iCons(100, iCons(101, iCons(102, .IntSeq)))))))
+    </k>
+    <env> 0 </env>
+    <scopes>
