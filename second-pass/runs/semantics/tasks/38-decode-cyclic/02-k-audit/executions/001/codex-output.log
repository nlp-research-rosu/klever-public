    [simplification]

  rule (M:Map [ N:Int <- S:Scope ]) => (N |-> S) M
    requires keysBelow(M, N)
    [simplification]

  rule (((N:Int |-> _S:Scope) M:Map) [ N <- undef]) => M
    requires keysBelow(M, N)
    [simplification]
endmodule
#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py concrete_tests.py > concrete_tests.mpy

kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun concrete_tests.mpy --definition runtime-kompiled

kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC
def encode_cyclic(s: str):
    """
    returns encoded string by cycling groups of three characters.
    """
    # split string to groups. Each of length 3.
    groups = [s[(3 * i):min((3 * i + 3), len(s))] for i in range((len(s) + 2) // 3)]
    # cycle elements in each group. Unless group has fewer elements than 3.
    groups = [(group[1:] + group[0]) if len(group) == 3 else group for group in groups]
    return "".join(groups)


def decode_cyclic(s: str):
    """
    takes as input string encoded with encode_cyclic function. Returns decoded string.
    """
    if len(s) < 3:
        return s
    return s[2] + s[:2] + decode_cyclic(s[3:])


assert decode_cyclic("") == ""
assert decode_cyclic("a") == "a"
assert decode_cyclic("ab") == "ab"
assert decode_cyclic("bca") == "abc"
assert decode_cyclic("bcaefd") == "abcdef"
assert decode_cyclic("bcaefdg") == "abcdefg"
assert decode_cyclic("elho lorwld") == "hello world"
assert decode_cyclic(encode_cyclic("0123456789")) == "0123456789"
Module(
  FuncDef("encode_cyclic", Params("s"), CellVars("s"), FreeVars(),
    Expr(
      Str(
        "\n    returns encoded string by cycling groups of three characters.\n    "))
    Assign(
      Name("groups"),
      ListComp(Subscript(
        Name("s"),
        Slice(
          BinOp("*", Int(3), Name("i")),
          Call(
            Name("min"),
            BinOp("+", BinOp("*", Int(3), Name("i")), Int(3)),
            Call(Name("len"), Name("s"))),
          NoBound)),
        CompFor(
          Name("i"),
          Call(
            Name("range"),
            BinOp(
              "//",
              BinOp("+", Call(Name("len"), Name("s")), Int(2)),
              Int(3))),
          Bool(true))))
    Assign(
      Name("groups"),
      ListComp(IfExp(
        Compare(Call(Name("len"), Name("group")), CmpOp("==", Int(3))),
        BinOp(
          "+",
          Subscript(Name("group"), Slice(Int(1), NoBound, NoBound)),
          Subscript(Name("group"), Int(0))),
        Name("group")),
        CompFor(Name("group"), Name("groups"), Bool(true))))
    Return(Call(Attribute(Str(""), "join"), Name("groups"))))
  FuncDef("decode_cyclic", Params("s"),
    Expr(
      Str(
        "\n    takes as input string encoded with encode_cyclic function. Returns decoded string.\n    "))
    If(Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
      Return(Name("s")),
      )
    Return(
      BinOp(
        "+",
        BinOp(
          "+",
          Subscript(Name("s"), Int(2)),
          Subscript(Name("s"), Slice(NoBound, Int(2), NoBound))),
        Call(
          Name("decode_cyclic"),
          Subscript(Name("s"), Slice(Int(3), NoBound, NoBound))))))
  Assert(
    Compare(Call(Name("decode_cyclic"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("a")),
      CmpOp("==", Str("a"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("ab")),
      CmpOp("==", Str("ab"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("bca")),
      CmpOp("==", Str("abc"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("bcaefd")),
      CmpOp("==", Str("abcdef"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("bcaefdg")),
      CmpOp("==", Str("abcdefg"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("elho lorwld")),
      CmpOp("==", Str("hello world"))))
  Assert(
    Compare(
      Call(
        Name("decode_cyclic"),
        Call(Name("encode_cyclic"), Str("0123456789"))),
      CmpOp("==", Str("0123456789")))))

