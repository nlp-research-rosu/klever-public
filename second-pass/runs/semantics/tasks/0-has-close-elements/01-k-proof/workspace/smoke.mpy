Module(
  ImportFrom("typing", "List")
  FuncDef("is_close_to_any", Params("number", "numbers", "threshold", "start"),
    Assign(Name("found"), Bool(false))
    Assign(Name("index"), Int(0))
    Assign(Name("other"), Name("number"))
    For(Name("other"), Name("numbers"),
      If(Compare(Name("index"), CmpOp(">=", Name("start"))),
        If(Compare(
          Call(Name("abs"), BinOp("-", Name("number"), Name("other"))),
          CmpOp("<", Name("threshold"))),
          Assign(Name("found"), Bool(true))
          Break,
          ),
        )
      AugAssign(Name("index"), "+", Int(1)))
    Assign(Name("index"), Int(0))
    Assign(Name("other"), Name("number"))
    Return(Name("found")))
  FuncDef("has_close_elements", Params("numbers", "threshold"),
    Assign(Name("found"), Bool(false))
    Assign(Name("start"), Int(1))
    Assign(Name("number"), Name("threshold"))
    For(Name("number"), Name("numbers"),
      If(Call(
        Name("is_close_to_any"),
        Name("number"),
        Name("numbers"),
        Name("threshold"),
        Name("start")),
        Assign(Name("found"), Bool(true))
        Break,
        )
      AugAssign(Name("start"), "+", Int(1)))
    Assign(Name("start"), Int(1))
    Assign(Name("number"), Name("threshold"))
    Return(Name("found")))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(Float(1.0), Float(2.0), Float(3.0)),
        Float(0.5)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(
          Float(1.0),
          Float(2.8),
          Float(3.0),
          Float(4.0),
          Float(5.0),
          Float(2.0)),
        Float(0.3)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("has_close_elements"), ListExpr(), Float(1.0)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("has_close_elements"), ListExpr(Float(1.0)), Float(1.0)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(Float(1.0), Float(1.0)),
        Float(0.1)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(Float(1.0), Float(1.3)),
        Float(0.3)),
      CmpOp("==", Bool(false)))))
