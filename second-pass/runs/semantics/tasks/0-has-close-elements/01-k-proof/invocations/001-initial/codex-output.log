/bin/bash -lc 'python3 py2mpy.py solution.py > solution.mpy && python3 py2mpy.py smoke.py > smoke.mpy && krun smoke.mpy --definition runtime-kompiled --output none && kompile verification.k --backend haskell --main-module VERIFICATION-BASE --syntax-module MPY-SYNTAX --output-definition typed-base-kompiled' in /work
