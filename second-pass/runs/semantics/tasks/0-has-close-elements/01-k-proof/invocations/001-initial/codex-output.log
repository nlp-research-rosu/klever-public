+  rule <k> #applyK(toCall(helperClosure()),
+                   (A:Val, list(VS:ValSeq), T:Val, J:Int, .Vals)) ~> K:K
+        => closeFrom(A, VS, T, J) ~> K ... </k>
+       <env> 1 </env>
+       <scopes>
+         0  |-> solutionScope()
+         1  |-> scope(EM:Map, parent(0))
+         -1 |-> builtinsScope
+       </scopes>
+       <scopeLoc> 2 </scopeLoc>
+       <ret> noRet </ret>
