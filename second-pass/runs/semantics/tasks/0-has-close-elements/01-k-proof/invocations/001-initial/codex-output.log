+          0  |-> solutionScope()
+          1  |-> (scope(.Map
+                         [ "numbers" <- list(ALL:FloatSeq) ]
+                         [ "threshold" <- T:Float ]
+                         [ "found" <- false ]
+                         [ "start" <- START:Int ]
+                         [ "number" <- Q:Float ],
+                        parent(0))
+                   => scope(.Map
+                            [ "numbers" <- list(ALL) ]
