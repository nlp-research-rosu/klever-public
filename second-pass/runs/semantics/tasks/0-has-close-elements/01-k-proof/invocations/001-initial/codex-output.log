+       <scopes>
+         0  |-> solutionScope()
+         1  |-> scope(EM:Map, parent(0))
+         2  |-> (scope(.Map
+                       [ "number" <- A:Float ]
+                       [ "numbers" <- list(ALL:FloatSeq) ]
+                       [ "threshold" <- T:Float ]
