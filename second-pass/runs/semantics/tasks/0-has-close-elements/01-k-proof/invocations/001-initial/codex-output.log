+                        [ "numbers" <- list(VS) ]
+                        [ "threshold" <- T:Val ]
+                        [ "index" <- Q:Int ],
+                       parent(0)) => .Map)
+         -1 |-> builtinsScope
+       </scopes>
+       <scopeLoc> 2 => 1 </scopeLoc>
+       <stack>
+         (ListItem(frame(K:K, 0, 1)) => .List) REST:List
+       </stack>
+       <ret> noRet </ret>
+    [priority(40)]
+endmodule
+
+module VERIFICATION-WITH-ENTRY
+  imports VERIFICATION-WITH-OUTER
+
+  rule <k> #applyK(toCall(entryClosure()),
+                   (list(VS:ValSeq), T:Val, .Vals)) ~> K:K
+        => hasCloseFrom(VS, T, 0) ~> K ... </k>
+       <env> 0 </env>
+       <scopes>
+         0  |-> solutionScope()
+         -1 |-> builtinsScope
+       </scopes>
+       <scopeLoc> 1 </scopeLoc>
+       <ret> noRet </ret>
+    [priority(40)]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-WITH-ENTRY
+endmodule

