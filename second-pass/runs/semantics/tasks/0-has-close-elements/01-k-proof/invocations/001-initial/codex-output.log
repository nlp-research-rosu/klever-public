+requires "verification.k"
+
+module SPEC-HELPER
+  imports VERIFICATION-BASE
+
+  // Lemma 1: the recursive suffix search implements closeFrom.
+  claim <k> #applyK(toCall(helperClosure()),
+                    (A:Val, list(VS:ValSeq), T:Val, J:Int, .Vals)) ~> K:K
+         => closeFrom(A, VS, T, J) ~> K ... </k>
+        <scopes> ... 0 |-> solutionScope() ... </scopes>
+        <scopeLoc> L:Int </scopeLoc>
+        <ret> noRet </ret>
+    requires L >=Int 1
+endmodule
+
+module SPEC-SCAN
+  imports VERIFICATION-WITH-HELPER
+
+  // Lemma 2: the recursive outer scan implements the pairwise search.
+  claim <k> #applyK(toCall(scanClosure()),
+                    (list(VS:ValSeq), T:Val, I:Int, .Vals)) ~> K:K
+         => hasCloseFrom(VS, T, I) ~> K ... </k>
+        <scopes> ... 0 |-> solutionScope() ... </scopes>
+        <scopeLoc> L:Int </scopeLoc>
+        <ret> noRet </ret>
+    requires L >=Int 1
+endmodule
+
+module SPEC-ENTRY
+  imports VERIFICATION-WITH-SCAN
+
+  // Lemma 3: the required entry point starts the pairwise search at zero.
+  claim <k> #applyK(toCall(entryClosure()),
+                    (list(VS:ValSeq), T:Val, .Vals)) ~> K:K
+         => hasCloseFrom(VS, T, 0) ~> K ... </k>
+        <scopes> ... 0 |-> solutionScope() ... </scopes>
+        <scopeLoc> L:Int </scopeLoc>
+        <ret> noRet </ret>
+    requires L >=Int 1
+endmodule
+
+module SPEC
+  imports VERIFICATION-WITH-SCAN
+
+  // End-to-end theorem: load the exact solution.mpy constructor tree, call the
+  // required entry point on an arbitrary value sequence and threshold, and
+  // obtain the mathematical all-pairs specification.
+  claim <k> #loadAll(solutionModule())
+             ~> Call(Name("has_close_elements"),
+                     list(VS:ValSeq), T:Val, .Exprs)
+         => hasCloseFrom(VS, T, 0) ... </k>
+        <env> 0 </env>
+        <scopes>
+          0  |-> (scope(.Map, parent(-1)) => solutionScope())
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c7758e64331532bd4868985b9e91c1f5472a8cf9
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,134 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  // The three closures are exactly the constructor trees in solution.mpy.
+  syntax Stmts ::= helperBody() [function, total]
+  rule helperBody() =>
+    If(Compare(Name("index"),
+               CmpOp(">=", Call(Name("len"), Name("numbers"), .Exprs))),
+       Return(Bool(false)) .Stmts,
+       .Stmts)
+    If(Compare(Call(Name("abs"),
+                    BinOp("-", Name("number"),
+                          Subscript(Name("numbers"), Name("index")))),
+               CmpOp("<", Name("threshold"))),
+       Return(Bool(true)) .Stmts,
+       .Stmts)
+    Return(Call(Name("is_close_to_any"),
+                Name("number"), Name("numbers"), Name("threshold"),
+                BinOp("+", Name("index"), Int(1)), .Exprs))
+    .Stmts
+
+  syntax Stmts ::= scanBody() [function, total]
+  rule scanBody() =>
+    If(Compare(Name("index"),
+               CmpOp(">=", Call(Name("len"), Name("numbers"), .Exprs))),
+       Return(Bool(false)) .Stmts,
+       .Stmts)
+    If(Call(Name("is_close_to_any"),
+            Subscript(Name("numbers"), Name("index")),
+            Name("numbers"), Name("threshold"),
+            BinOp("+", Name("index"), Int(1)), .Exprs),
+       Return(Bool(true)) .Stmts,
+       .Stmts)
+    Return(Call(Name("has_close_from"),
+                Name("numbers"), Name("threshold"),
+                BinOp("+", Name("index"), Int(1)), .Exprs))
+    .Stmts
+
+  syntax Stmts ::= entryBody() [function, total]
+  rule entryBody() =>
+    Return(Call(Name("has_close_from"),
+                Name("numbers"), Name("threshold"), Int(0), .Exprs))
+    .Stmts
+
+  syntax Val ::= helperClosure() [function, total]
+               | scanClosure()   [function, total]
+               | entryClosure()  [function, total]
+  rule helperClosure() =>
+    closureVal(("number", "numbers", "threshold", "index"), helperBody(), 0)
+  rule scanClosure() =>
+    closureVal(("numbers", "threshold", "index"), scanBody(), 0)
+  rule entryClosure() =>
+    closureVal(("numbers", "threshold"), entryBody(), 0)
+
+  syntax Module ::= solutionModule() [function, total]
+  rule solutionModule() =>
+    Module(
+      ImportFrom("typing", "List")
+      FuncDef("is_close_to_any",
+              Params("number", "numbers", "threshold", "index"),
+              helperBody())
+      FuncDef("has_close_from",
+              Params("numbers", "threshold", "index"),
+              scanBody())
+      FuncDef("has_close_elements",
+              Params("numbers", "threshold"),
+              entryBody())
+      .Stmts)
+
+  syntax Scope ::= solutionScope() [function, total]
+  rule solutionScope() =>
+    scope(.Map
+          [ "is_close_to_any" <- helperClosure() ]
+          [ "has_close_from" <- scanClosure() ]
+          [ "has_close_elements" <- entryClosure() ],
+          parent(-1))
+
+  // Logical specification: search the suffix beginning at J for a value
+  // close to NUMBER, then search every first index beginning at I.
+  syntax Bool ::= closeAtom(Val, Val, Val) [function, total]
+  rule closeAtom(A:Val, B:Val, T:Val) =>
+    applyCmp("<", applyBuiltin("abs", applyBin("-", A, B), .Vals), T)
+
+  syntax Bool ::= closeFrom(Val, ValSeq, Val, Int) [function]
+  rule closeFrom(_:Val, VS:ValSeq, _:Val, J:Int) => false
+    requires J >=Int vsLen(VS)
+  rule closeFrom(A:Val, VS:ValSeq, T:Val, J:Int) =>
+    closeAtom(A, valSeqAt(VS, J), T)
+    orBool closeFrom(A, VS, T, J +Int 1)
+    requires J <Int vsLen(VS)
+
+  syntax Bool ::= hasCloseFrom(ValSeq, Val, Int) [function]
+  rule hasCloseFrom(VS:ValSeq, _:Val, I:Int) => false
+    requires I >=Int vsLen(VS)
+  rule hasCloseFrom(VS:ValSeq, T:Val, I:Int) =>
+    closeFrom(valSeqAt(VS, I), VS, T, I +Int 1)
+    orBool hasCloseFrom(VS, T, I +Int 1)
+    requires I <Int vsLen(VS)
+endmodule
+
+// The rules in these modules are staged lemmas. prove.sh first proves each
+// identical reachability claim using a definition that does not yet contain
+// that lemma, then recompiles with the proved lemma available to the next rung.
+module VERIFICATION-WITH-HELPER
+  imports VERIFICATION-BASE
+
+  rule <k> #applyK(toCall(helperClosure()),
+                   (A:Val, list(VS:ValSeq), T:Val, J:Int, .Vals)) ~> K:K
+        => closeFrom(A, VS, T, J) ~> K ... </k>
+       <scopes> ... 0 |-> solutionScope() ... </scopes>
+       <scopeLoc> L:Int </scopeLoc>
+       <ret> noRet </ret>
+    requires L >=Int 1
+    [priority(40)]
+endmodule
+
+module VERIFICATION-WITH-SCAN
+  imports VERIFICATION-WITH-HELPER
+
+  rule <k> #applyK(toCall(scanClosure()),
+                   (list(VS:ValSeq), T:Val, I:Int, .Vals)) ~> K:K
+        => hasCloseFrom(VS, T, I) ~> K ... </k>
+       <scopes> ... 0 |-> solutionScope() ... </scopes>
+       <scopeLoc> L:Int </scopeLoc>
+       <ret> noRet </ret>
+    requires L >=Int 1
+    [priority(40)]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-WITH-SCAN
+endmodule

