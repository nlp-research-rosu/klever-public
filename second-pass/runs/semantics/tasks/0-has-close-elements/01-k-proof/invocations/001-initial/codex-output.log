+                       [ "start" <- START:Int ]
+                       [ "number" <- Q:Float ],
+                      parent(0))
+         -1 |-> builtinsScope
+       </scopes>
+       <scopeLoc> 2 </scopeLoc>
+       <stack> ListItem(frame(K:K, 0, 1)) REST:List </stack>
+       <ret> noRet </ret>
+    [priority(40)]
+endmodule
+
+module VERIFICATION-WITH-ENTRY
+  imports VERIFICATION-WITH-OUTER
+
