+  // A typed proof-only subsort using the very same .ValSeq/vCons constructor
+  // labels as MPY. It is therefore a genuine list representation while making
+  // every yielded element statically Float to the prover.
+  syntax ValSeq ::= FloatSeq
+  syntax FloatSeq ::= ".ValSeq" [symbol(.ValSeq)]
+                    | "vCons" "(" Float "," FloatSeq ")" [symbol(vCons)]
+
+  syntax Bool ::= near(Float, Float, Float) [function, total]
+  rule near(A:Float, B:Float, T:Float) => floatLt(absF(subF(A, B)), T)
+
+  // Search CUR, whose first element has absolute index I, ignoring elements
+  // before START. This is exactly the helper's loop invariant.
+  syntax Bool ::= closeSkip(Float, FloatSeq, Float, Int, Int) [function]
+  rule closeSkip(_:Float, .ValSeq, _:Float, _:Int, _:Int) => false
+  rule closeSkip(A:Float, vCons(_:Float, R:FloatSeq), T:Float,
+                 I:Int, START:Int)
+    => closeSkip(A, R, T, I +Int 1, START)
+    requires I <Int START
+  rule closeSkip(A:Float, vCons(B:Float, R:FloatSeq), T:Float,
+                 I:Int, START:Int)
+    => near(A, B, T) orBool closeSkip(A, R, T, I +Int 1, START)
+    requires I >=Int START
+
+  // For each head of CUR, compare it with the portion of ALL beginning at
+  // START, then advance both CUR and START. Initially CUR=ALL and START=1,
+  // so this denotes exactly all pairs of distinct positions i < j.
+  syntax Bool ::= hasPairs(FloatSeq, FloatSeq, Float, Int) [function]
+  rule hasPairs(_:FloatSeq, .ValSeq, _:Float, _:Int) => false
+  rule hasPairs(ALL:FloatSeq, vCons(A:Float, R:FloatSeq), T:Float, START:Int)
+    => closeSkip(A, ALL, T, 0, START)
+       orBool hasPairs(ALL, R, T, START +Int 1)
+
