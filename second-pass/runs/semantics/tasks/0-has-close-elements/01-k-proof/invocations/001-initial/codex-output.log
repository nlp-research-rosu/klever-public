+requires "verification.k"
+
+module SPEC-INNER
+  imports VERIFICATION-BASE
+
+  claim <k> #loop(rangeObj(J:Int, vsLen(VS:ValSeq), 1),
+                   Name("index"), innerBody())
+              ~> Return(Bool(false)) ~> #endcall
+         => closeFrom(A, VS, T, J) ~> K ... </k>
+        <env> 2 => 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(EM:Map, parent(0))
+          2  |-> (scope(.Map
+                         [ "number" <- A:Val ]
+                         [ "numbers" <- list(VS) ]
+                         [ "threshold" <- T:Val ]
+                         [ "start" <- S:Int ]
+                         [ "index" <- Q:Int ],
+                        parent(0)) => .Map)
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 3 => 2 </scopeLoc>
+        <stack>
+          (ListItem(frame(K:K, 1, 2)) => .List) REST:List
+        </stack>
+        <ret> noRet </ret>
+endmodule
+
+module SPEC-HELPER
+  imports VERIFICATION-WITH-INNER
+
+  claim <k> #applyK(toCall(helperClosure()),
+                    (A:Val, list(VS:ValSeq), T:Val, J:Int, .Vals)) ~> K:K
+         => closeFrom(A, VS, T, J) ~> K ... </k>
+        <env> 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(EM:Map, parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+module SPEC-OUTER
+  imports VERIFICATION-WITH-HELPER
+
+  claim <k> #loop(rangeObj(I:Int, vsLen(VS:ValSeq), 1),
+                   Name("index"), outerBody())
+              ~> Return(Bool(false)) ~> #endcall
+         => hasCloseFrom(VS, T, I) ~> K ... </k>
+        <env> 1 => 0 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> (scope(.Map
+                         [ "numbers" <- list(VS) ]
+                         [ "threshold" <- T:Val ]
+                         [ "index" <- Q:Int ],
+                        parent(0)) => .Map)
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 => 1 </scopeLoc>
+        <stack>
+          (ListItem(frame(K:K, 0, 1)) => .List) REST:List
+        </stack>
+        <ret> noRet </ret>
+endmodule
+
+module SPEC-ENTRY
+  imports VERIFICATION-WITH-OUTER
+
+  claim <k> #applyK(toCall(entryClosure()),
+                    (list(VS:ValSeq), T:Val, .Vals)) ~> K:K
+         => hasCloseFrom(VS, T, 0) ~> K ... </k>
+        <env> 0 </env>
+        <scopes>
+          0  |-> solutionScope()
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+module SPEC
+  imports VERIFICATION-WITH-ENTRY
+
+  // Load the exact solution.mpy constructor tree, then call the required
+  // entry point on an arbitrary sequence and threshold.
+  claim <k> #loadAll(solutionModule())
+              ~> Call(Name("has_close_elements"),
+                      list(VS:ValSeq), T:Val, .Exprs)
+         => hasCloseFrom(VS, T, 0) ... </k>
+        <env> 0 </env>
+        <scopes>
+          0  |-> (scope(.Map, parent(-1)) => solutionScope())
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
