+        <env> 2 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(EM:Map, parent(0))
+          2  |-> (scope(.Map
+                        [ "number" <- A:Float ]
+                        [ "numbers" <- list(ALL:FloatSeq) ]
+                        [ "threshold" <- T:Float ]
+                        [ "start" <- START:Int ]
+                        [ "found" <- false ]
+                        [ "index" <- I:Int ]
+                        [ "other" <- Q:Float ],
