+                   (list(VS:ValSeq), T:Val, .Vals)) ~> K:K
+        => hasCloseFrom(VS, T, 0) ~> K ... </k>
+       <env> 0 </env>
+       <scopes>
+         0  |-> solutionScope()
+         -1 |-> builtinsScope
+       </scopes>
+       <scopeLoc> 1 </scopeLoc>
