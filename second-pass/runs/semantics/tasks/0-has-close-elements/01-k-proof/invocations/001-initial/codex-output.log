+                   Name("index"), outerBody())
+              ~> Return(Bool(false)) ~> #endcall
+         => hasCloseFrom(VS, T, I) ~> K ... </k>
+        <env> 1 => 0 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> (scope(.Map
+                         [ "numbers" <- list(VS) ]
+                         [ "threshold" <- T:Val ]
+                         [ "index" <- Q:Int ],
+                        parent(0)) => .Map)
+          -1 |-> builtinsScope
+        </scopes>
