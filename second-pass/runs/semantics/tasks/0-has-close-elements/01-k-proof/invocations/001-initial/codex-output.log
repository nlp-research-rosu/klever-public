+       <env> 1 </env>
+       <scopes>
+         0  |-> solutionScope()
+         1  |-> scope(.Map
+                        [ "numbers" <- list(VS) ]
+                        [ "threshold" <- T:Val ]
+                        [ "found" <- (false => hasCloseFrom(VS, T, I)) ]
+                        [ "index" <- Q:Int ],
+                       parent(0))
+         -1 |-> builtinsScope
+       </scopes>
+       <scopeLoc> 2 </scopeLoc>
+       <stack> ListItem(frame(K:K, 0, 1)) REST:List </stack>
