+from typing import List
+
+
+def is_close_to_any(number: float, numbers: List[float], threshold: float) -> bool:
+    for other in numbers:
+        if abs(number - other) < threshold:
+            return True
+    return False
+
+
+def has_close_elements(numbers: List[float], threshold: float) -> bool:
+    """Return whether two distinct positions contain sufficiently close values."""
+    seen = []
+    for number in numbers:
+        if is_close_to_any(number, seen, threshold):
+            return True
+        seen.append(number)
+    return False

