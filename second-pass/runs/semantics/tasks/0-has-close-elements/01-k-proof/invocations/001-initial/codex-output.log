+
+  rule <k> #loop(rangeObj(I:Int, vsLen(VS:ValSeq), 1),
+                  Name("index"), outerBody())
+             ~> Return(Name("found")) ~> #endcall
+        => Return(Name("found")) ~> #endcall ... </k>
+       <env> 1 </env>
+       <scopes>
+         0  |-> solutionScope()
+         1  |-> (scope(.Map
+                        [ "numbers" <- list(VS) ]
+                        [ "threshold" <- T:Val ]
+                        [ "found" <- (false => hasCloseFrom(VS, T, I)) ]
+                        [ "index" <- Q:Int ],
+                       parent(0))
+         -1 |-> builtinsScope
+       </scopes>
+       <scopeLoc> 2 </scopeLoc>
+       <stack> ListItem(frame(K:K, 0, 1)) REST:List </stack>
+       <ret> noRet </ret>
+    [priority(40)]
+endmodule
+
+module VERIFICATION-WITH-ENTRY
+  imports VERIFICATION-WITH-OUTER
+
+  rule <k> #applyK(toCall(entryClosure()),
+                   (list(VS:ValSeq), T:Val, .Vals)) ~> K:K
+        => hasCloseFrom(VS, T, 0) ~> K ... </k>
+       <env> 0 </env>
+       <scopes>
+         0  |-> solutionScope()
+         -1 |-> builtinsScope
+       </scopes>
+       <scopeLoc> 1 </scopeLoc>
+       <ret> noRet </ret>
+    [priority(40)]
+endmodule
