+          2  |-> (scope(.Map
+                         [ "number" <- A:Float ]
+                         [ "numbers" <- list(ALL:FloatSeq) ]
+                         [ "threshold" <- T:Float ]
+                         [ "start" <- START:Int ]
+                         [ "found" <- false ]
+                         [ "index" <- I:Int ]
+                         [ "other" <- Q:Float ],
+                        parent(0))
+                   => scope(.Map
+                            [ "number" <- A ]
+                            [ "numbers" <- list(ALL) ]
+                            [ "threshold" <- T ]
+                            [ "start" <- START ]
+                            [ "found" <- closeSkip(A, R, T, I +Int 1, START) ]
+                            [ "index" <- 0 ]
