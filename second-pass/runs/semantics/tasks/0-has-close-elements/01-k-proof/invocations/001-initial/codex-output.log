diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..5d7927a84e322e6df885bd7a88c5a71aab7b8d9c
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,29 @@
+from typing import List
+
+
+def is_close_to_any(number: float, numbers: List[float], threshold: float, index: int) -> bool:
+    if index >= len(numbers):
+        return False
+    if abs(number - numbers[index]) < threshold:
+        return True
+    return is_close_to_any(number, numbers, threshold, index + 1)
+
+
+def has_close_from(numbers: List[float], threshold: float, index: int) -> bool:
+    if index >= len(numbers):
+        return False
+    if is_close_to_any(numbers[index], numbers, threshold, index + 1):
+        return True
+    return has_close_from(numbers, threshold, index + 1)
+
+
+def has_close_elements(numbers: List[float], threshold: float) -> bool:
+    return has_close_from(numbers, threshold, 0)
+
+
+assert has_close_elements([1.0, 2.0, 3.0], 0.5) == False
+assert has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3) == True
+assert has_close_elements([], 1.0) == False
+assert has_close_elements([1.0], 1.0) == False
+assert has_close_elements([1.0, 1.0], 0.1) == True
+assert has_close_elements([1.0, 1.3], 0.3) == False
