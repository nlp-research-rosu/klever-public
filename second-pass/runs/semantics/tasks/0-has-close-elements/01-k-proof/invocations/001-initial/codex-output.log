+
+  rule <k> #loop(rangeObj(J:Int, vsLen(VS:ValSeq), 1),
+                  Name("index"), innerBody())
+             ~> Return(Bool(false)) ~> #endcall
+        => closeFrom(A, VS, T, J) ~> K ... </k>
+       <env> 2 => 1 </env>
+       <scopes>
+         0  |-> solutionScope()
+         1  |-> scope(EM:Map, parent(0))
+         2  |-> (scope(.Map
+                        [ "number" <- A:Val ]
+                        [ "numbers" <- list(VS) ]
+                        [ "threshold" <- T:Val ]
+                        [ "start" <- S:Int ]
+                        [ "index" <- Q:Int ],
