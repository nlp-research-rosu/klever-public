+              ~> Assign(Name("start"), Int(1))
+              ~> Assign(Name("number"), Name("threshold"))
+              ~> Return(Name("found")) ~> #endcall
+         => Return(Name("found")) ~> #endcall </k>
+        <env> 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> (scope(.Map
+                        [ "numbers" <- list(ALL:FloatSeq) ]
+                        [ "threshold" <- T:Float ]
+                        [ "found" <- false ]
+                        [ "start" <- START:Int ]
+                        [ "number" <- Q:Float ],
+                       parent(0))
+                  => scope(.Map
+                           [ "numbers" <- list(ALL) ]
+                           [ "threshold" <- T ]
+                           [ "found" <- false ]
+                           [ "start" <- 1 ]
+                           [ "number" <- T ],
+                          parent(0)))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <stack> ListItem(frame(K:K, 0, 1)) REST:List </stack>
+        <ret> noRet </ret>
+
+  claim <k> #loop(list(fCons(A:Float, R:FloatSeq)),
+                   Name("number"), outerLoopBody())
+              ~> Assign(Name("start"), Int(1))
+              ~> Assign(Name("number"), Name("threshold"))
+              ~> Return(Name("found")) ~> #endcall
+         => Return(Name("found")) ~> #endcall </k>
+        <env> 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> (scope(.Map
+                         [ "numbers" <- list(ALL:FloatSeq) ]
+                         [ "threshold" <- T:Float ]
+                         [ "found" <- false ]
+                         [ "start" <- START:Int ]
+                         [ "number" <- Q:Float ],
+                        parent(0))
+                   => scope(.Map
+                            [ "numbers" <- list(ALL) ]
+                            [ "threshold" <- T ]
+                            [ "found" <- (closeSkip(A, ALL, T, 0, START)
+                                           orBool hasPairs(ALL, R, T, START +Int 1)) ]
+                            [ "start" <- 1 ]
+                            [ "number" <- T ],
+                           parent(0)))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <stack> ListItem(frame(K:K, 0, 1)) REST:List </stack>
+        <ret> noRet </ret>
+endmodule
+
+module SPEC-ENTRY
+  imports VERIFICATION-WITH-OUTER
+
+  claim <k> #applyK(toCall(entryClosure()),
+                    (list(ALL:FloatSeq), T:Float, .Vals)) ~> #proofDone
+         => hasPairs(ALL, ALL, T, 1) ~> #proofDone </k>
+        <env> 0 </env>
+        <scopes>
+          0  |-> solutionScope()
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+module SPEC
+  imports VERIFICATION-WITH-ENTRY
+
+  claim <k> #loadAll(solutionModule())
+              ~> Call(Name("has_close_elements"),
+                      list(ALL:FloatSeq), T:Float, .Exprs)
+         => hasPairs(ALL, ALL, T, 1) ... </k>
+        <env> 0 </env>
+        <scopes>
+          0  |-> (scope(.Map, parent(-1)) => solutionScope())
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
