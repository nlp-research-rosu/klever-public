+          0  |-> solutionScope()
+          1  |-> scope(.Map
+                        [ "numbers" <- list(ALL:FloatSeq) ]
+                        [ "threshold" <- T:Float ]
+                        [ "found" <- (false => hasPairs(ALL, CUR, T, START)) ]
+                        [ "start" <- START:Int ]
+                        [ "number" <- Q:Float ],
