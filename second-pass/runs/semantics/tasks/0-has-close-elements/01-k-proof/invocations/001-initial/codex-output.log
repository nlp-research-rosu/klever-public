+  rule <k> #applyK(toCall(entryClosure()),
+                   (list(ALL:FloatSeq), T:Float, .Vals)) ~> K:K
+        => hasPairs(ALL, ALL, T, 1) ~> K ... </k>
+       <env> 0 </env>
+       <scopes>
+         0  |-> solutionScope()
+         -1 |-> builtinsScope
+       </scopes>
+       <scopeLoc> 1 </scopeLoc>
+       <ret> noRet </ret>
+    [priority(40)]
+endmodule
+
+module VERIFICATION
