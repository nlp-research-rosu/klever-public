+requires "verification.k"
+
+module SPEC-INNER
+  imports VERIFICATION-BASE
+
+  claim <k> #loop(list(toVS(CUR:FloatSeq)),
+                   Name("other"), helperLoopBody())
+              ~> Return(Name("found")) ~> #endcall
+         => Return(Name("found")) ~> #endcall ... </k>
+        <env> 2 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(EM:Map, parent(0))
+          2  |-> scope(.Map
+                        [ "number" <- A:Float ]
+                        [ "numbers" <- list(toVS(ALL:FloatSeq)) ]
+                        [ "threshold" <- T:Float ]
+                        [ "start" <- START:Int ]
+                        [ "found" <- (false => closeSkip(A, CUR, T, I, START)) ]
+                        [ "index" <- I:Int ]
+                        [ "other" <- Q:Float ],
+                       parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 3 </scopeLoc>
+        <stack> ListItem(frame(K:K, 1, 2)) REST:List </stack>
+        <ret> noRet </ret>
+endmodule
+
+module SPEC-HELPER
+  imports VERIFICATION-WITH-INNER
+
+  claim <k> #applyK(toCall(helperClosure()),
+                    (A:Float, list(toVS(ALL:FloatSeq)),
+                     T:Float, START:Int, .Vals)) ~> #proofDone
+         => closeSkip(A, ALL, T, 0, START) ~> #proofDone ... </k>
+        <env> 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(EM:Map, parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+module SPEC-OUTER
+  imports VERIFICATION-WITH-HELPER
+
+  claim <k> #loop(list(toVS(CUR:FloatSeq)),
+                   Name("number"), outerLoopBody())
+              ~> Return(Name("found")) ~> #endcall
+         => Return(Name("found")) ~> #endcall ... </k>
+        <env> 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(.Map
+                        [ "numbers" <- list(toVS(ALL:FloatSeq)) ]
+                        [ "threshold" <- T:Float ]
+                        [ "found" <- (false => hasPairs(ALL, CUR, T, START)) ]
+                        [ "start" <- START:Int ]
+                        [ "number" <- Q:Float ],
+                       parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <stack> ListItem(frame(K:K, 0, 1)) REST:List </stack>
+        <ret> noRet </ret>
