+                         [ "number" <- A:Val ]
+                         [ "numbers" <- list(VS) ]
+                         [ "threshold" <- T:Val ]
+                         [ "start" <- S:Int ]
+                         [ "found" <- (false => closeFrom(A, VS, T, J)) ]
+                         [ "index" <- Q:Int ],
+                        parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 3 </scopeLoc>
+        <stack> ListItem(frame(K:K, 1, 2)) REST:List </stack>
