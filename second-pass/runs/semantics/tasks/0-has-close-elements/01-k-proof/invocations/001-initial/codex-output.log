+       <env> 1 => 0 </env>
+       <scopes>
+         0  |-> solutionScope()
+         1  |-> (scope(.Map
+                       [ "numbers" <- list(ALL:FloatSeq) ]
+                       [ "threshold" <- T:Float ]
+                       [ "found" <- (false => hasPairs(ALL, CUR, T, START)) ]
+                       [ "start" <- START:Int ]
+                       [ "number" <- Q:Float ],
+                      parent(0)) => .Map)
+         -1 |-> builtinsScope
+       </scopes>
+       <scopeLoc> 2 => 1 </scopeLoc>
+       <stack>
+         (ListItem(frame(#proofDone, 0, 1)) => .List) REST:List
+       </stack>
+       <ret> noRet </ret>
+    [priority(40)]
+endmodule
+
+module VERIFICATION-WITH-ENTRY
+  imports VERIFICATION-WITH-OUTER
+
+  rule <k> #applyK(toCall(entryClosure()),
+                   (list(ALL:FloatSeq), T:Float, .Vals)) ~> K:K
+        => hasPairs(ALL, ALL, T, 1) ~> K ... </k>
+       <env> 0 </env>
+       <scopes>
+         0  |-> solutionScope()
+         -1 |-> builtinsScope
+       </scopes>
+       <scopeLoc> 1 </scopeLoc>
+       <ret> noRet </ret>
+    [priority(40)]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-WITH-ENTRY
+endmodule

