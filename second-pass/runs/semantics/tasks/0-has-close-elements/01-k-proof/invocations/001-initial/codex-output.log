+                     T:Float, START:Int, .Vals)) ~> #proofDone
+         => closeSkip(A, ALL, T, 0, START) ~> #proofDone ... </k>
+        <env> 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(EM:Map, parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+module SPEC-OUTER
