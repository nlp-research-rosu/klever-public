diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0bc22e4697910a59ccd261383280913f29ba11c2
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,194 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  // These constructor terms are exactly the bodies emitted in solution.mpy.
+  syntax Stmts ::= innerBody() [function, total]
+  rule innerBody() =>
+    If(Compare(Call(Name("abs"),
+                    BinOp("-", Name("number"),
+                          Subscript(Name("numbers"), Name("index")))),
+               CmpOp("<", Name("threshold"))),
+       Assign(Name("found"), Bool(true))
+       Break
+       .Stmts,
+       .Stmts)
+    .Stmts
+
+  syntax Stmts ::= helperBody() [function, total]
+  rule helperBody() =>
+    Assign(Name("found"), Bool(false))
+    Assign(Name("index"), Name("start"))
+    For(Name("index"),
+        Call(Name("range"), Name("start"),
+             Call(Name("len"), Name("numbers"), .Exprs), .Exprs),
+        innerBody())
+    Return(Name("found"))
+    .Stmts
+
+  syntax Stmts ::= outerBody() [function, total]
+  rule outerBody() =>
+    If(Call(Name("is_close_to_any"),
+            Subscript(Name("numbers"), Name("index")),
+            Name("numbers"), Name("threshold"),
+            BinOp("+", Name("index"), Int(1)), .Exprs),
+       Assign(Name("found"), Bool(true))
+       Break
+       .Stmts,
+       .Stmts)
+    .Stmts
+
+  syntax Stmts ::= entryBody() [function, total]
+  rule entryBody() =>
+    Assign(Name("found"), Bool(false))
+    Assign(Name("index"), Int(0))
+    For(Name("index"),
+        Call(Name("range"),
+             Call(Name("len"), Name("numbers"), .Exprs), .Exprs),
+        outerBody())
+    Return(Name("found"))
+    .Stmts
+
+  syntax Val ::= helperClosure() [function, total]
+               | entryClosure()  [function, total]
+  rule helperClosure() =>
+    closureVal(("number", "numbers", "threshold", "start"), helperBody(), 0)
+  rule entryClosure() =>
+    closureVal(("numbers", "threshold"), entryBody(), 0)
+
+  syntax Module ::= solutionModule() [function, total]
+  rule solutionModule() =>
+    Module(
+      ImportFrom("typing", "List")
+      FuncDef("is_close_to_any",
+              Params("number", "numbers", "threshold", "start"),
+              helperBody())
+      FuncDef("has_close_elements",
+              Params("numbers", "threshold"),
+              entryBody())
+      .Stmts)
+
+  syntax Scope ::= solutionScope() [function, total]
+  rule solutionScope() =>
+    scope(.Map
+          [ "is_close_to_any" <- helperClosure() ]
+          [ "has_close_elements" <- entryClosure() ],
+          parent(-1))
+
+  // Pairwise logical specification. closeFrom checks NUMBER against indices
+  // J..len(VS)-1. hasCloseFrom selects each first index I in turn. Thus
+  // hasCloseFrom(VS,T,0) covers exactly all pairs 0 <= I < J < len(VS).
+  syntax Bool ::= closeAtom(Val, Val, Val) [function, total]
+  rule closeAtom(A:Val, B:Val, T:Val) =>
+    applyCmp("<", applyBuiltin("abs", applyBin("-", A, B), .Vals), T)
+
+  syntax Bool ::= closeFrom(Val, ValSeq, Val, Int) [function]
+  rule closeFrom(_:Val, VS:ValSeq, _:Val, J:Int) => false
+    requires J >=Int vsLen(VS)
+  rule closeFrom(A:Val, VS:ValSeq, T:Val, J:Int) =>
+    closeAtom(A, valSeqAt(VS, J), T)
+    orBool closeFrom(A, VS, T, J +Int 1)
+    requires J <Int vsLen(VS)
+
+  syntax Bool ::= hasCloseFrom(ValSeq, Val, Int) [function]
+  rule hasCloseFrom(VS:ValSeq, _:Val, I:Int) => false
+    requires I >=Int vsLen(VS)
+  rule hasCloseFrom(VS:ValSeq, T:Val, I:Int) =>
+    closeFrom(valSeqAt(VS, I), VS, T, I +Int 1)
+    orBool hasCloseFrom(VS, T, I +Int 1)
+    requires I <Int vsLen(VS)
+
+  // An inert delimiter used only to keep standalone function proofs from
+  // symbolically narrowing an otherwise-arbitrary caller continuation.
+  syntax KItem ::= "#proofDone"
+endmodule
+
+// Each following rule is an already-proved lemma in prove.sh's staged build.
+module VERIFICATION-WITH-INNER
+  imports VERIFICATION-BASE
+
+  rule <k> #loop(rangeObj(J:Int, vsLen(VS:ValSeq), 1),
+                  Name("index"), innerBody())
+             ~> Return(Name("found")) ~> #endcall
+        => Return(Name("found")) ~> #endcall ... </k>
+       <env> 2 </env>
+       <scopes>
+         0  |-> solutionScope()
+         1  |-> scope(EM:Map, parent(0))
+         2  |-> scope(.Map
+                        [ "number" <- A:Val ]
+                        [ "numbers" <- list(VS) ]
+                        [ "threshold" <- T:Val ]
+                        [ "start" <- S:Int ]
+                        [ "found" <- (false => closeFrom(A, VS, T, J)) ]
+                        [ "index" <- Q:Int ],
+                       parent(0))
+         -1 |-> builtinsScope
+       </scopes>
+       <scopeLoc> 3 </scopeLoc>
+       <stack> ListItem(frame(K:K, 1, 2)) REST:List </stack>
+       <ret> noRet </ret>
+    [priority(40)]
+endmodule
+
+module VERIFICATION-WITH-HELPER
+  imports VERIFICATION-WITH-INNER
+
+  rule <k> #applyK(toCall(helperClosure()),
+                   (A:Val, list(VS:ValSeq), T:Val, J:Int, .Vals)) ~> K:K
+        => closeFrom(A, VS, T, J) ~> K ... </k>
+       <env> 1 </env>
+       <scopes>
+         0  |-> solutionScope()
+         1  |-> scope(EM:Map, parent(0))
+         -1 |-> builtinsScope
+       </scopes>
+       <scopeLoc> 2 </scopeLoc>
+       <ret> noRet </ret>
+    [priority(40)]
+endmodule
+
+module VERIFICATION-WITH-OUTER
+  imports VERIFICATION-WITH-HELPER
+
+  rule <k> #loop(rangeObj(I:Int, vsLen(VS:ValSeq), 1),
+                  Name("index"), outerBody())
+             ~> Return(Name("found")) ~> #endcall
+        => Return(Name("found")) ~> #endcall ... </k>
+       <env> 1 </env>
+       <scopes>
+         0  |-> solutionScope()
+         1  |-> scope(.Map
+                        [ "numbers" <- list(VS) ]
+                        [ "threshold" <- T:Val ]
+                        [ "found" <- (false => hasCloseFrom(VS, T, I)) ]
+                        [ "index" <- Q:Int ],
+                       parent(0))
+         -1 |-> builtinsScope
+       </scopes>
+       <scopeLoc> 2 </scopeLoc>
+       <stack> ListItem(frame(K:K, 0, 1)) REST:List </stack>
+       <ret> noRet </ret>
+    [priority(40)]
+endmodule
+
+module VERIFICATION-WITH-ENTRY
+  imports VERIFICATION-WITH-OUTER
+
+  rule <k> #applyK(toCall(entryClosure()),
+                   (list(VS:ValSeq), T:Val, .Vals)) ~> K:K
+        => hasCloseFrom(VS, T, 0) ~> K ... </k>
+       <env> 0 </env>
+       <scopes>
+         0  |-> solutionScope()
+         -1 |-> builtinsScope
+       </scopes>
+       <scopeLoc> 1 </scopeLoc>
+       <ret> noRet </ret>
+    [priority(40)]
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-WITH-ENTRY
+endmodule

