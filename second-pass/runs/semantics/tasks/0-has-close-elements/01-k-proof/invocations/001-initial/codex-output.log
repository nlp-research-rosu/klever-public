+         => Return(Name("found")) ~> #endcall </k>
+        <env> 2 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(EM:Map, parent(0))
+          2  |-> (scope(.Map
+                         [ "number" <- A:Float ]
+                         [ "numbers" <- list(ALL:FloatSeq) ]
+                         [ "threshold" <- T:Float ]
+                         [ "start" <- START:Int ]
+                         [ "found" <- false ]
+                         [ "index" <- I:Int ]
+                         [ "other" <- Q:Float ],
+                        parent(0))
+                   => scope(.Map
+                            [ "number" <- A ]
+                            [ "numbers" <- list(ALL) ]
+                            [ "threshold" <- T ]
+                            [ "start" <- START ]
+                            [ "found" <- closeSkip(A, R, T, I +Int 1, START) ]
+                            [ "index" <- 0 ]
+                            [ "other" <- A ],
+                           parent(0)))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 3 </scopeLoc>
+        <stack> ListItem(frame(K:K, 1, 2)) REST:List </stack>
+        <ret> noRet </ret>
+    requires I <Int START
+
+  claim <k> #loop(list(fCons(F:Float, R:FloatSeq)),
+                   Name("other"), helperLoopBody())
+              ~> Assign(Name("index"), Int(0))
+              ~> Assign(Name("other"), Name("number"))
+              ~> Return(Name("found")) ~> #endcall
+         => Return(Name("found")) ~> #endcall </k>
+        <env> 2 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(EM:Map, parent(0))
+          2  |-> (scope(.Map
+                         [ "number" <- A:Float ]
+                         [ "numbers" <- list(ALL:FloatSeq) ]
+                         [ "threshold" <- T:Float ]
+                         [ "start" <- START:Int ]
+                         [ "found" <- false ]
+                         [ "index" <- I:Int ]
+                         [ "other" <- Q:Float ],
+                        parent(0))
+                   => scope(.Map
+                            [ "number" <- A ]
+                            [ "numbers" <- list(ALL) ]
+                            [ "threshold" <- T ]
+                            [ "start" <- START ]
+                            [ "found" <- (near(A, F, T)
+                                           orBool closeSkip(A, R, T, I +Int 1, START)) ]
+                            [ "index" <- 0 ]
+                            [ "other" <- A ],
+                           parent(0)))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 3 </scopeLoc>
+        <stack> ListItem(frame(K:K, 1, 2)) REST:List </stack>
+        <ret> noRet </ret>
+    requires I >=Int START
+endmodule
