+         => Return(Name("found")) ~> #endcall </k>
+        <env> 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> (scope(.Map
+                         [ "numbers" <- list(ALL:FloatSeq) ]
+                         [ "threshold" <- T:Float ]
+                         [ "found" <- false ]
+                         [ "start" <- START:Int ]
+                         [ "number" <- Q:Float ],
+                        parent(0))
+                   => scope(.Map
+                            [ "numbers" <- list(ALL) ]
+                            [ "threshold" <- T ]
+                            [ "found" <- (closeSkip(A, ALL, T, 0, START)
+                                           orBool hasPairs(ALL, R, T, START +Int 1)) ]
+                            [ "start" <- 1 ]
