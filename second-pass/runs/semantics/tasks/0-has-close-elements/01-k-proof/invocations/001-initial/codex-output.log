+
+module SPEC
+  imports VERIFICATION-WITH-ENTRY
+
+  // Load the exact solution.mpy constructor tree, then call the required
+  // entry point on an arbitrary sequence and threshold.
+  claim <k> #loadAll(solutionModule())
+              ~> Call(Name("has_close_elements"),
+                      list(VS:ValSeq), T:Val, .Exprs)
+         => hasCloseFrom(VS, T, 0) ... </k>
+        <env> 0 </env>
+        <scopes>
