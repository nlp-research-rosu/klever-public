+        <env> 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(.Map
+                        [ "numbers" <- list(toVS(ALL:FloatSeq)) ]
+                        [ "threshold" <- T:Float ]
+                        [ "found" <- (false => hasPairs(ALL, CUR, T, START)) ]
+                        [ "start" <- START:Int ]
+                        [ "number" <- Q:Float ],
+                       parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <stack> ListItem(frame(K:K, 0, 1)) REST:List </stack>
