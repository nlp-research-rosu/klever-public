diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..450349cd067dd4d855a50ca01a6b0568392242e3
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,104 @@
+requires "verification.k"
+
+module SPEC-INNER
+  imports VERIFICATION-BASE
+
+  claim <k> #loop(list(CUR:FloatSeq),
+                   Name("other"), helperLoopBody())
+              ~> Return(Name("found")) ~> #endcall
+         => closeSkip(A, CUR, T, I, START) ~> #proofDone ... </k>
+        <env> 2 => 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(EM:Map, parent(0))
+          2  |-> (scope(.Map
+                        [ "number" <- A:Float ]
+                        [ "numbers" <- list(ALL:FloatSeq) ]
+                        [ "threshold" <- T:Float ]
+                        [ "start" <- START:Int ]
+                        [ "found" <- (false => closeSkip(A, CUR, T, I, START)) ]
+                        [ "index" <- I:Int ]
+                        [ "other" <- Q:Float ],
+                       parent(0)) => .Map)
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 3 => 2 </scopeLoc>
+        <stack>
+          (ListItem(frame(#proofDone, 1, 2)) => .List) REST:List
+        </stack>
+        <ret> noRet </ret>
+endmodule
+
+module SPEC-HELPER
+  imports VERIFICATION-WITH-INNER
+
+  claim <k> #applyK(toCall(helperClosure()),
+                    (A:Float, list(ALL:FloatSeq),
+                     T:Float, START:Int, .Vals)) ~> #proofDone
+         => closeSkip(A, ALL, T, 0, START) ~> #proofDone ... </k>
+        <env> 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(EM:Map, parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+module SPEC-OUTER
+  imports VERIFICATION-WITH-HELPER
+
+  claim <k> #loop(list(CUR:FloatSeq),
+                   Name("number"), outerLoopBody())
+              ~> Return(Name("found")) ~> #endcall
+         => hasPairs(ALL, CUR, T, START) ~> #proofDone ... </k>
+        <env> 1 => 0 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> (scope(.Map
+                        [ "numbers" <- list(ALL:FloatSeq) ]
+                        [ "threshold" <- T:Float ]
+                        [ "found" <- (false => hasPairs(ALL, CUR, T, START)) ]
+                        [ "start" <- START:Int ]
+                        [ "number" <- Q:Float ],
+                       parent(0)) => .Map)
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 => 1 </scopeLoc>
+        <stack>
+          (ListItem(frame(#proofDone, 0, 1)) => .List) REST:List
+        </stack>
+        <ret> noRet </ret>
+endmodule
+
+module SPEC-ENTRY
+  imports VERIFICATION-WITH-OUTER
+
+  claim <k> #applyK(toCall(entryClosure()),
+                    (list(ALL:FloatSeq), T:Float, .Vals)) ~> #proofDone
+         => hasPairs(ALL, ALL, T, 1) ~> #proofDone ... </k>
+        <env> 0 </env>
+        <scopes>
+          0  |-> solutionScope()
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+module SPEC
+  imports VERIFICATION-WITH-ENTRY
+
+  claim <k> #loadAll(solutionModule())
+              ~> Call(Name("has_close_elements"),
+                      list(ALL:FloatSeq), T:Float, .Exprs)
+         => hasPairs(ALL, ALL, T, 1) ... </k>
+        <env> 0 </env>
+        <scopes>
+          0  |-> (scope(.Map, parent(-1)) => solutionScope())
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
