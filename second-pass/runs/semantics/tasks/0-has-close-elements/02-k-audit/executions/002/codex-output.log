ed build.\nmodule VERIFICATION-WITH-INNER\n  imports VERIFICATION-BASE\n\n  rule <k> #loop(rangeObj(J:Int, vsLen(VS:ValSeq), 1),\n                  Name(\"index\"), innerBody())\n             ~> Return(Bool(false)) ~> #endcall\n        => closeFrom(A, VS, T, J) ~> K ... </k>\n       <env> 2 => 1 </env>\n       <scopes>\n         0  |-> solutionScope()\n         1  |-> scope(EM:Map, parent(0))\n         2  |-> (scope(.Map\n                        [ \"number\" <- A:Val ]\n                        [ \"numbers\" <- list(VS) ]\n                        [ \"threshold\" <- T:Val ]\n                        [ \"start\" <- S:Int ]\n                        [ \"index\" <- Q:Int ],\n                       parent(0)) => .Map)\n         -1 |-> builtinsScope\n       </scopes>\n       <scopeLoc> 3 => 2 </scopeLoc>\n       <stack>\n         (ListItem(frame(K:K, 1, 2)) => .List) REST:List\n       </stack>\n       <ret> noRet </ret>\n    [priority(40)]\nendmodule\n\nmodule VERIFICATION-WITH-HELPER\n  imports VERIFICATION-WITH-INNER\n\n  rule <k> #applyK(toCall(helperClosure()),\n                   (A:Val, list(VS:ValSeq), T:Val, J:Int, .Vals)) ~> K:K\n        => closeFrom(A, VS, T, J) ~> K ... </k>\n       <env> 1 </env>\n       <scopes>\n         0  |-> solutionScope()\n         1  |-> scope(EM:Map, parent(0))\n         -1 |-> builtinsScope\n       </scopes>\n       <scopeLoc> 2 </scopeLoc>\n       <ret> noRet </ret>\n    [priority(40)]\nendmodule\n\nmodule VERIFICATION-WITH-OUTER\n  imports VERIFICATION-WITH-HELPER\n\n  rule <k> #loop(rangeObj(I:Int, vsLen(VS:ValSeq), 1),\n                  Name(\"index\"), outerBody())\n             ~> Return(Bool(false)) ~> #endcall\n        => hasCloseFrom(VS, T, I) ~> K ... </k>\n       <env> 1 => 0 </env>\n       <scopes>\n         0  |-> solutionScope()\n         1  |-> (scope(.Map\n                        [ \"numbers\" <- list(VS) ]\n                        [ \"threshold\" <- T:Val ]\n                        [ \"index\" <- Q:Int ],\n                       parent(0)) => .Map)\n         -1 |-> builtinsScope\n       </scopes>\n       <scopeLoc> 2 => 1 </scopeLoc>\n       <stack>\n         (ListItem(frame(K:K, 0, 1)) => .List) REST:List\n       </stack>\n       <ret> noRet </ret>\n    [priority(40)]\nendmodule\n\nmodule VERIFICATION-WITH-ENTRY\n  imports VERIFICATION-WITH-OUTER\n\n  rule <k> #applyK(toCall(entryClosure()),\n                   (list(VS:ValSeq), T:Val, .Vals)) ~> K:K\n        => hasCloseFrom(VS, T, 0) ~> K ... </k>\n       <env> 0 </env>\n       <scopes>\n         0  |-> solutionScope()\n         -1 |-> builtinsScope\n       </scopes>\n       <scopeLoc> 1 </scopeLoc>\n       <ret> noRet </ret>\n    [priority(40)]\nendmodule\n\nmodule VERIFICATION\n  imports VERIFICATION-WITH-ENTRY\nendmodule\n"},"/work/spec.k":{"type":"add","content":"requires \"verification.k\"\n\nmodule SPEC-INNER\n  imports VERIFICATION-BASE\n\n  claim <k> #loop(rangeObj(J:Int, vsLen(VS:ValSeq), 1),\n                   Name(\"index\"), innerBody())\n              ~> Return(Bool(false)) ~> #endcall\n         => closeFrom(A, VS, T, J) ~> K ... </k>\n        <env> 2 => 1 </env>\n        <scopes>\n          0  |-> solutionScope()\n          1  |-> scope(EM:Map, parent(0))\n          2  |-> (scope(.Map\n                         [ \"number\" <- A:Val ]\n                         [ \"numbers\" <- list(VS) ]\n                         [ \"threshold\" <- T:Val ]\n                         [ \"start\" <- S:Int ]\n                         [ \"index\" <- Q:Int ],\n                        parent(0)) => .Map)\n          -1 |-> builtinsScope\n        </scopes>\n        <scopeLoc> 3 => 2 </scopeLoc>\n        <stack>\n          (ListItem(frame(K:K, 1, 2)) => .List) REST:List\n        </stack>\n        <ret> noRet </ret>\nendmodule\n\nmodule SPEC-HELPER\n  imports VERIFICATION-WITH-INNER\n\n  claim <k> #applyK(toCall(helperClosure()),\n                    (A:Val, list(VS:ValSeq), T:Val, J:Int, .Vals)) ~> K:K\n         => closeFrom(A, VS, T, J) ~>