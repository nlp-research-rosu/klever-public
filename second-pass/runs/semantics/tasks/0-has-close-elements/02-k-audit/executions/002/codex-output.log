   127	module VERIFICATION-WITH-INNER
   128	  imports VERIFICATION-BASE
   129	
   130	  rule <k> For(Name("other"), list(ALL:FloatSeq), _B:Stmts)
   131	        => .K ... </k>
   132	       <env> 2 </env>
   133	       <scopes> ... 2 |-> scope(M:Map => M
   134	                                  [ "found" <- closeSkip(A, ALL, T, 0, START) ]
   135	                                  [ "index" <- 0 ]
   136	                                  [ "other" <- A ],
   137	                                parent(0)) ... </scopes>
   138	       <ret> noRet </ret>
   139	    requires {M["number"]}:>Val ==K A
   140	     andBool {M["numbers"]}:>Val ==K list(ALL)
   141	     andBool {M["threshold"]}:>Val ==K T
   142	     andBool {M["start"]}:>Val ==K START
   143	     andBool {M["found"]}:>Val ==K false
   144	     andBool {M["index"]}:>Val ==K 0
   145	    [priority(45)]
   146	endmodule
