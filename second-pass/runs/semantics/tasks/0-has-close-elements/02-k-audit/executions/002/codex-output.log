+#!/usr/bin/env bash
+set -uo pipefail
+
+LOG=/audit-output/evidence/02-fidelity.log
+exec > >(tee "$LOG") 2>&1
+
+run() {
+  echo "\$ $*"
+  "$@"
+  local status=$?
+  echo "[exit $status]"
+  return 0
+}
+
+echo '$ python3 /reference/py2mpy.py /candidate/solution.py > /tmp/audit-work/case/regenerated-solution.mpy'
