+#!/usr/bin/env bash
+set -uo pipefail
+
+LOG=/audit-output/evidence/01-provenance.log
+exec > >(tee "$LOG") 2>&1
+
+run() {
+  echo "\$ $*"
+  "$@"
+  local status=$?
