+        <env> 0 </env>
+        <scopes>
+          0 |-> scope(.Map
+                       [ "has_close_elements" <- closureVal(
+                           ("numbers", "threshold"),
+                           Return(Bool(true)) .Stmts, 0) ],
+                     parent(-1))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <stack> .List </stack>
+        <ret> noRet </ret>
+endmodule
