   148	module VERIFICATION-WITH-HELPER
   149	  imports VERIFICATION-WITH-INNER
   150	
   151	  rule <k> Call(Name("is_close_to_any"),
   152	                Name("number"), Name("numbers"), Name("threshold"),
   153	                Name("start"), .Exprs)
   154	        => closeSkip(A, ALL, T, 0, START) ... </k>
   155	       <env> 1 </env>
   156	       <scopes> ... 1 |-> scope(M:Map, parent(0)) ... </scopes>
   157	    requires {M["number"]}:>Val ==K A:Float
   158	     andBool {M["numbers"]}:>Val ==K list(ALL:FloatSeq)
   159	     andBool {M["threshold"]}:>Val ==K T:Float
   160	     andBool {M["start"]}:>Val ==K START:Int
   161	    [priority(40)]
   162	
   163	  rule <k> #applyK(toCall(closureVal(
   164	                     ("number", "numbers", "threshold", "start"),
   165	                     _BODY:Stmts, 0)),
   166	                   (A:Float, list(ALL:FloatSeq),
   167	                    T:Float, START:Int, .Vals)) ~> K:K
   168	        => closeSkip(A, ALL, T, 0, START) ~> K ... </k>
   169	       <env> 1 </env>
   170	       <scopeLoc> 2 </scopeLoc>
   171	       <ret> noRet </ret>
   172	    [priority(40)]
   173	endmodule
   174	
   175	module VERIFICATION-WITH-OUTER
   176	  imports VERIFICATION-WITH-HELPER
   177	
   178	  rule <k> For(Name("number"), list(ALL:FloatSeq), _B:Stmts)
   179	        => .K ... </k>
   180	       <env> 1 </env>
   181	       <scopes> ... 1 |-> scope(M:Map => M
   182	                                  [ "found" <- hasPairs(ALL, ALL, T, 1) ]
   183	                                  [ "start" <- 1 ]
   184	                                  [ "number" <- T ],
   185	                                parent(0)) ... </scopes>
   186	       <ret> noRet </ret>
   187	    requires {M["numbers"]}:>Val ==K list(ALL)
   188	     andBool {M["threshold"]}:>Val ==K T:Float
   189	     andBool {M["found"]}:>Val ==K false
   190	     andBool {M["start"]}:>Val ==K 1
   191	    [priority(45)]
   192	endmodule
   193	
   194	module VERIFICATION-WITH-ENTRY
   195	  imports VERIFICATION-WITH-OUTER
