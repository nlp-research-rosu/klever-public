+
+run_bounded() {
+  local label=$1
+  shift
+  local raw="$BUILD/${label}.raw.log"
+  echo "\$ $*"
+  "$@" >"$raw" 2>&1
+  local status=$?
+  local lines
+  lines=$(wc -l <"$raw")
+  echo "[exit $status; raw_lines=$lines]"
+  if (( lines <= 80 )); then
+    sed -n '1,80p' "$raw"
+  else
+    sed -n '1,45p' "$raw"
+    echo "[... bounded omission: $((lines - 70)) lines ...]"
+    tail -n 25 "$raw"
+  fi
+  echo "[end $label]"
