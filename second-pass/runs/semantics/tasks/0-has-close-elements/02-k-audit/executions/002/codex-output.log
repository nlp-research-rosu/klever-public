@@ -0,0 +1,114 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+LOG=/audit-output/evidence/01-provenance.log
+exec > >(tee "$LOG") 2>&1
+
+run() {
+  echo "\$ $*"
+  "$@"
+  local status=$?
+  echo "[exit $status]"
+  return 0
+}
+
+check_hash() {
+  local expected=$1
