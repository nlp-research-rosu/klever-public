     3	module VERIFICATION-BASE
     4	  imports MPY
     5	
     6	  // Exact constructor terms emitted in solution.mpy.
     7	  syntax Stmts ::= nearBody() [function, total]
     8	  rule nearBody() =>
     9	    If(Compare(Call(Name("abs"),
    10	                    BinOp("-", Name("number"), Name("other"))),
    11	               CmpOp("<", Name("threshold"))),
    12	       Assign(Name("found"), Bool(true))
    13	       Break
    14	       .Stmts,
    15	       .Stmts)
    16	    .Stmts
    17	
    18	  syntax Stmts ::= helperLoopBody() [function, total]
    19	  rule helperLoopBody() =>
    20	    If(Compare(Name("index"), CmpOp(">=", Name("start"))),
    21	       nearBody(),
    22	       .Stmts)
    23	    AugAssign(Name("index"), "+", Int(1))
    24	    .Stmts
    25	
    26	  syntax Stmts ::= helperBody() [function, total]
    27	  rule helperBody() =>
    28	    Assign(Name("found"), Bool(false))
    29	    Assign(Name("index"), Int(0))
    30	    Assign(Name("other"), Name("number"))
    31	    For(Name("other"), Name("numbers"), helperLoopBody())
    32	    Assign(Name("index"), Int(0))
    33	    Assign(Name("other"), Name("number"))
    34	    Return(Name("found"))
    35	    .Stmts
    36	
    37	  syntax Stmts ::= outerLoopBody() [function, total]
    38	  rule outerLoopBody() =>
    39	    If(Call(Name("is_close_to_any"),
    40	            Name("number"), Name("numbers"), Name("threshold"),
    41	            Name("start"), .Exprs),
    42	       Assign(Name("found"), Bool(true))
    43	       Break
    44	       .Stmts,
    45	       .Stmts)
    46	    AugAssign(Name("start"), "+", Int(1))
    47	    .Stmts
    48	
    49	  syntax Stmts ::= entryBody() [function, total]
    50	  rule entryBody() =>
    51	    Assign(Name("found"), Bool(false))
    52	    Assign(Name("start"), Int(1))
    53	    Assign(Name("number"), Name("threshold"))
    54	    For(Name("number"), Name("numbers"), outerLoopBody())
    55	    Assign(Name("start"), Int(1))
    56	    Assign(Name("number"), Name("threshold"))
    57	    Return(Name("found"))
    58	    .Stmts
    59	
    60	  syntax Val ::= helperClosure() [function, total]
    61	               | entryClosure()  [function, total]
    62	  rule helperClosure() =>
    63	    closureVal(("number", "numbers", "threshold", "start"), helperBody(), 0)
    64	  rule entryClosure() =>
    65	    closureVal(("numbers", "threshold"), entryBody(), 0)
    66	
    67	  syntax Module ::= solutionModule() [function, total]
    68	  rule solutionModule() =>
    69	    Module(
    70	      ImportFrom("typing", "List")
    71	      FuncDef("is_close_to_any",
    72	              Params("number", "numbers", "threshold", "start"),
    73	              helperBody())
    74	      FuncDef("has_close_elements",
    75	              Params("numbers", "threshold"),
    76	              entryBody())
    77	      .Stmts)
    78	
    79	  syntax Scope ::= solutionScope() [function, total]
    80	  rule solutionScope() =>
    81	    scope(.Map
    82	          [ "is_close_to_any" <- helperClosure() ]
    83	          [ "has_close_elements" <- entryClosure() ],
    84	          parent(-1))
    85	
    86	  // A typed proof-only ValSeq representation. The two iterator equations below
    87	  // are the representation relation to MPY lists and make every yielded
    88	  // element statically Float to the prover.
    89	  syntax ValSeq ::= FloatSeq
    90	  syntax FloatSeq ::= ".FloatSeq" | fCons(Float, FloatSeq)
    91	  rule <k> #iterNext(list(.FloatSeq)) => #iterDone ... </k>
    92	    [priority(40)]
    93	  rule <k> #iterNext(list(fCons(F:Float, R:FloatSeq)))
    94	        => #iterYield(F, list(R)) ... </k>
    95	    [priority(40)]
    96	
    97	  syntax Bool ::= near(Float, Float, Float) [function, total]
    98	  rule near(A:Float, B:Float, T:Float) => floatLt(absF(subF(A, B)), T)
    99	
   100	  // Search CUR, whose first element has absolute index I, ignoring elements
   101	  // before START. This is exactly the helper's loop invariant.
   102	  syntax Bool ::= closeSkip(Float, FloatSeq, Float, Int, Int) [function, total]
   103	  rule closeSkip(_:Float, .FloatSeq, _:Float, _:Int, _:Int) => false
   104	  rule closeSkip(A:Float, fCons(_:Float, R:FloatSeq), T:Float,
   105	                 I:Int, START:Int)
   106	    => closeSkip(A, R, T, I +Int 1, START)
   107	    requires I <Int START
   108	  rule closeSkip(A:Float, fCons(B:Float, R:FloatSeq), T:Float,
   109	                 I:Int, START:Int)
   110	    => near(A, B, T) orBool closeSkip(A, R, T, I +Int 1, START)
   111	    requires I >=Int START
   112	
   113	  // For each head of CUR, compare it with the portion of ALL beginning at
   114	  // START, then advance both CUR and START. Initially CUR=ALL and START=1,
   115	  // so this denotes exactly all pairs of distinct positions i < j.
   116	  syntax Bool ::= hasPairs(FloatSeq, FloatSeq, Float, Int) [function, total]
   117	  rule hasPairs(_:FloatSeq, .FloatSeq, _:Float, _:Int) => false
   118	  rule hasPairs(ALL:FloatSeq, fCons(A:Float, R:FloatSeq), T:Float, START:Int)
   119	    => closeSkip(A, ALL, T, 0, START)
   120	       orBool hasPairs(ALL, R, T, START +Int 1)
   121	
   122	  syntax KItem ::= "#proofDone"
   123	endmodule
