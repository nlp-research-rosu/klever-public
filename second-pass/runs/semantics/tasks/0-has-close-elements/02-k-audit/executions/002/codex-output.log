+                           Return(Bool(true)) .Stmts, 0) ],
+                     parent(-1))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <stack> .List </stack>
+        <ret> noRet </ret>
+endmodule
