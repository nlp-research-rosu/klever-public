+                       ("numbers", "threshold"),
+                       Assign(Name("found"), Bool(false))
+                       Assign(Name("start"), Int(1))
+                       Assign(Name("number"), Name("threshold"))
+                       For(Name("number"), Name("numbers"), .Stmts)
+                       Assign(Name("start"), Int(1))
+                       Assign(Name("number"), Name("threshold"))
+                       Return(Name("found"))
+                       .Stmts,
+                       0)),
+                     (list(fCons(A:Float,
+                                 fCons(A, .FloatSeq))),
+                      T:Float, .Vals)) ~> #proofDone
+         => false ~> #proofDone </k>
+        <env> 0 </env>
+        <scopes>
+          0  |-> solutionScope()
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+module WITNESS-BRIDGED-EMPTY-OUTER-LOOP-SUMMARY
+  imports VERIFICATION-WITH-OUTER
+
+  claim <k> #applyK(toCall(closureVal(
+                       ("numbers", "threshold"),
+                       Assign(Name("found"), Bool(false))
+                       Assign(Name("start"), Int(1))
+                       Assign(Name("number"), Name("threshold"))
+                       For(Name("number"), Name("numbers"), .Stmts)
+                       Assign(Name("start"), Int(1))
+                       Assign(Name("number"), Name("threshold"))
+                       Return(Name("found"))
+                       .Stmts,
+                       0)),
+                     (list(fCons(A:Float,
+                                 fCons(A, .FloatSeq))),
+                      T:Float, .Vals)) ~> #proofDone
