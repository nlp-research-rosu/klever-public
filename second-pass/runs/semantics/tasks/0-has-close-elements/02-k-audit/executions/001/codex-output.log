+++ b/evidence/spec-vacuity-audit.k
@@ -0,0 +1,19 @@
+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION-WITH-ENTRY
+
+  // Fresh false mutation: demand the Boolean complement of the result produced
+  // by the same exact program-load-and-call configuration.
+  claim <k> #loadAll(solutionModule())
+              ~> Call(Name("has_close_elements"),
+                      list(ALL:FloatSeq), T:Float, .Exprs)
+         => notBool hasPairs(ALL, ALL, T, 1) ... </k>
+        <env> 0 </env>
+        <scopes>
+          0  |-> (scope(.Map, parent(-1)) => solutionScope())
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <ret> noRet </ret>
+endmodule

exec
/bin/bash -lc 'set +e
ref_digest=$(cd /reference/reference-semantics && find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '"'{print "'$1}'"')
cand_digest="'$(cd /candidate/reference-semantics && find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum | awk '"'{print "'$1}'"')
printf 'reference_tree_digest=%s\\ncandidate_tree_digest=%s\\n' \""'$ref_digest" "$cand_digest"
test "$ref_digest" = "$cand_digest"
printf '"'digest_compare_exit=%s\\n' \""'$?"' in /audit-output
 succeeded in 0ms:
reference_tree_digest=06160f82a2076306c4a3074692c5615b898a13fa1c7c888b1dc7cb20944fff1e
candidate_tree_digest=06160f82a2076306c4a3074692c5615b898a13fa1c7c888b1dc7cb20944fff1e
digest_compare_exit=0

