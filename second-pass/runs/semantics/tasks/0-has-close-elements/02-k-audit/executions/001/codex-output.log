@@ -0,0 +1,254 @@
+requires "verification.k"
+
+// Same closure invocation and Float/List input in both claims.  The closure
+// body deliberately returns false.  The submitted generalized bridge ignores
+// that body and returns closeSkip(...).  The symbolic contrast is paired in
+// REVIEW.md with the satisfying ground instance A=1.0, T=0.1, for which the
+// concrete meaning of closeSkip(A,[A],T,0,0) is true.
+module WITNESS-FIXED-CLOSURE-FALSE
+  imports VERIFICATION-WITH-INNER
+
+  claim <k> #applyK(toCall(closureVal(
+                       ("number", "numbers", "threshold", "start"),
+                       Return(Bool(false)) .Stmts,
+                       0)),
+                     (A:Float, list(fCons(A, .FloatSeq)),
+                      T:Float, 0, .Vals)) ~> #proofDone
+         => false ~> #proofDone </k>
+        <env> 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(.Map, parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+module WITNESS-BRIDGED-CLOSURE-SUMMARY
+  imports VERIFICATION-WITH-HELPER
+
+  claim <k> #applyK(toCall(closureVal(
+                       ("number", "numbers", "threshold", "start"),
+                       Return(Bool(false)) .Stmts,
+                       0)),
+                     (A:Float, list(fCons(A, .FloatSeq)),
+                      T:Float, 0, .Vals)) ~> #proofDone
+         => closeSkip(A, fCons(A, .FloatSeq),
+                      T, 0, 0) ~> #proofDone </k>
+        <env> 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(.Map, parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+// The direct Call bridge does not check lookup/binding.  In this state the
+// current local scope deliberately shadows is_close_to_any with a closure that
+// returns false.
+module WITNESS-FIXED-SHADOWED-HELPER-FALSE
+  imports VERIFICATION-WITH-INNER
+
+  claim <k> Call(Name("is_close_to_any"),
+                  Name("number"), Name("numbers"), Name("threshold"),
+                  Name("start"), .Exprs) ~> #proofDone
+         => false ~> #proofDone </k>
+        <env> 1 </env>
+        <scopes>
+          0 |-> solutionScope()
+          1 |-> scope(.Map
+                      [ "number" <- A:Float ]
+                      [ "numbers" <- list(fCons(A, .FloatSeq)) ]
+                      [ "threshold" <- T:Float ]
+                      [ "start" <- 0 ]
+                      [ "is_close_to_any" <-
+                        closureVal(("number", "numbers", "threshold", "start"),
+                                   Return(Bool(false)) .Stmts, 0) ],
+                     parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+module WITNESS-BRIDGED-SHADOWED-HELPER-SUMMARY
+  imports VERIFICATION-WITH-HELPER
+
+  claim <k> Call(Name("is_close_to_any"),
+                  Name("number"), Name("numbers"), Name("threshold"),
+                  Name("start"), .Exprs) ~> #proofDone
+         => closeSkip(A, fCons(A, .FloatSeq), T, 0, 0)
+              ~> #proofDone </k>
+        <env> 1 </env>
+        <scopes>
+          0 |-> solutionScope()
+          1 |-> scope(.Map
+                      [ "number" <- A:Float ]
+                      [ "numbers" <- list(fCons(A, .FloatSeq)) ]
+                      [ "threshold" <- T:Float ]
+                      [ "start" <- 0 ]
+                      [ "is_close_to_any" <-
+                        closureVal(("number", "numbers", "threshold", "start"),
+                                   Return(Bool(false)) .Stmts, 0) ],
+                     parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+// The public-entry Call bridge likewise does not check the selected binding.
+module WITNESS-FIXED-SHADOWED-ENTRY-FALSE
+  imports VERIFICATION-WITH-OUTER
+
+  claim <k> Call(Name("has_close_elements"),
+                  list(ALL:FloatSeq), T:Float, .Exprs) ~> #proofDone
+         => false ~> #proofDone </k>
+        <env> 0 </env>
+        <scopes>
+          0 |-> scope(.Map
+                      [ "has_close_elements" <-
+                        closureVal(("numbers", "threshold"),
+                                   Return(Bool(false)) .Stmts, 0) ],
+                     parent(-1))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+module WITNESS-BRIDGED-SHADOWED-ENTRY-SUMMARY
+  imports VERIFICATION-WITH-ENTRY
+
+  claim <k> Call(Name("has_close_elements"),
+                  list(ALL:FloatSeq), T:Float, .Exprs) ~> #proofDone
+         => hasPairs(ALL, ALL, T, 1) ~> #proofDone </k>
+        <env> 0 </env>
+        <scopes>
+          0 |-> scope(.Map
+                      [ "has_close_elements" <-
+                        closureVal(("numbers", "threshold"),
+                                   Return(Bool(false)) .Stmts, 0) ],
+                     parent(-1))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+// The helper-loop bridge matches any loop body and any continuation.  Here the
+// body is empty, so fixed execution cannot set found to the proximity summary.
+module WITNESS-FIXED-EMPTY-INNER-LOOP-FALSE
+  imports VERIFICATION-BASE
+
+  claim <k> #applyK(toCall(closureVal(
+                       ("number", "numbers", "threshold", "start"),
+                       Assign(Name("found"), Bool(false))
+                       Assign(Name("index"), Int(0))
+                       Assign(Name("other"), Name("number"))
+                       For(Name("other"), Name("numbers"), .Stmts)
+                       Assign(Name("index"), Int(0))
+                       Assign(Name("other"), Name("number"))
+                       Return(Name("found"))
+                       .Stmts,
+                       0)),
+                     (A:Float, list(fCons(A, .FloatSeq)),
+                      T:Float, 0, .Vals)) ~> #proofDone
+         => false ~> #proofDone </k>
+        <env> 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(.Map, parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+module WITNESS-BRIDGED-EMPTY-INNER-LOOP-SUMMARY
+  imports VERIFICATION-WITH-INNER
+
+  claim <k> #applyK(toCall(closureVal(
+                       ("number", "numbers", "threshold", "start"),
+                       Assign(Name("found"), Bool(false))
+                       Assign(Name("index"), Int(0))
+                       Assign(Name("other"), Name("number"))
+                       For(Name("other"), Name("numbers"), .Stmts)
+                       Assign(Name("index"), Int(0))
+                       Assign(Name("other"), Name("number"))
+                       Return(Name("found"))
+                       .Stmts,
+                       0)),
+                     (A:Float, list(fCons(A, .FloatSeq)),
+                      T:Float, 0, .Vals)) ~> #proofDone
+         => closeSkip(A, fCons(A, .FloatSeq), T, 0, 0)
+              ~> #proofDone </k>
+        <env> 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(.Map, parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+// The outer-loop bridge has the same arbitrary-body/context generalization.
+module WITNESS-FIXED-EMPTY-OUTER-LOOP-FALSE
+  imports VERIFICATION-WITH-HELPER
+
+  claim <k> #applyK(toCall(closureVal(
+                       ("numbers", "threshold"),
+                       Assign(Name("found"), Bool(false))
+                       Assign(Name("start"), Int(1))
+                       Assign(Name("number"), Name("threshold"))
+                       For(Name("number"), Name("numbers"), .Stmts)
+                       Assign(Name("start"), Int(1))
+                       Assign(Name("number"), Name("threshold"))
+                       Return(Name("found"))
+                       .Stmts,
+                       0)),
+                     (list(fCons(A:Float,
+                                 fCons(A, .FloatSeq))),
+                      T:Float, .Vals)) ~> #proofDone
+         => false ~> #proofDone </k>
+        <env> 0 </env>
+        <scopes>
+          0  |-> solutionScope()
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+module WITNESS-BRIDGED-EMPTY-OUTER-LOOP-SUMMARY
+  imports VERIFICATION-WITH-OUTER
+
+  claim <k> #applyK(toCall(closureVal(
+                       ("numbers", "threshold"),
+                       Assign(Name("found"), Bool(false))
+                       Assign(Name("start"), Int(1))
+                       Assign(Name("number"), Name("threshold"))
+                       For(Name("number"), Name("numbers"), .Stmts)
+                       Assign(Name("start"), Int(1))
+                       Assign(Name("number"), Name("threshold"))
+                       Return(Name("found"))
+                       .Stmts,
+                       0)),
+                     (list(fCons(A:Float,
+                                 fCons(A, .FloatSeq))),
+                      T:Float, .Vals)) ~> #proofDone
+         => hasPairs(fCons(A, fCons(A, .FloatSeq)),
+                     fCons(A, fCons(A, .FloatSeq)),
+                     T, 1) ~> #proofDone </k>
+        <env> 0 </env>
+        <scopes>
+          0  |-> solutionScope()
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
diff --git a/evidence/concrete_semantics_test.py b/evidence/concrete_semantics_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..61253b50543a8ae53e12ddf13791b5e7bacf0a0b
--- /dev/null
+++ b/evidence/concrete_semantics_test.py
@@ -0,0 +1,43 @@
+from typing import List
+
+
+def is_close_to_any(number: float, numbers: List[float], threshold: float, start: int) -> bool:
+    found = False
+    index = 0
+    other = number
+    for other in numbers:
+        if index >= start:
+            if abs(number - other) < threshold:
+                found = True
+                break
+        index += 1
+    index = 0
+    other = number
+    return found
+
+
+def has_close_elements(numbers: List[float], threshold: float) -> bool:
+    found = False
+    start = 1
+    number = threshold
+    for number in numbers:
+        if is_close_to_any(number, numbers, threshold, start):
+            found = True
+            break
+        start += 1
+    start = 1
+    number = threshold
+    return found
+
+
+assert has_close_elements([1.0, 2.0, 3.0], 0.5) == False
+assert has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3) == True
+assert has_close_elements([], 1.0) == False
+assert has_close_elements([1.0], 1.0) == False
+assert has_close_elements([1.0, 1.0], 0.1) == True
+assert has_close_elements([1.0, 1.3], 0.3) == False
+assert has_close_elements([-3.0, -2.75, 9.0], 0.5) == True
+assert has_close_elements([2.0, 2.0], 0.0) == False
+assert has_close_elements([2.0, 2.0], -1.0) == False
+assert has_close_elements([1.0, 5.0, 1.25], 0.3) == True
+assert has_close_elements([5.0, 1.0, 1.25], 0.3) == True
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..24c7852e83bddc441f5ef16f9db0d575c42ff948
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,131 @@
+#!/usr/bin/env python3
+"""Independent candidate-vs-canonical differential test.
+
+The finite generated domain is explicit and reproducible.  This script does not
+import or reproduce any K proof equation.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import itertools
+import json
+import math
+import random
+import sys
+from pathlib import Path
+
+
+SCRATCH = Path("/tmp/audit-work/0-has-close-elements")
+MANIFEST = Path("/audit-output/evidence/differential-input-manifest.json")
+
+
+def load_module(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+canonical = load_module("trusted_canonical", SCRATCH / "canonical.py")
+candidate = load_module("candidate_solution", SCRATCH / "solution.py")
+
+edge_cases = [
+    ([1.0, 2.0, 3.0], 0.5, "documented false"),
+    ([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3, "documented true"),
+    ([], 1.0, "empty list"),
+    ([1.0], 1.0, "singleton"),
+    ([1.0, 1.0], 0.1, "duplicate"),
+    ([1.0, 1.3], 0.3, "strict exact threshold"),
+    ([1.0, 1.3], math.nextafter(0.3, math.inf), "just above threshold"),
+    ([1.0, 1.3], math.nextafter(0.3, -math.inf), "just below threshold"),
+    ([-3.0, -2.75, 9.0], 0.5, "negative values"),
+    ([0.0, -0.0], 0.0, "signed zero and zero threshold"),
+    ([0.0, -0.0], math.ulp(0.0), "signed zero and positive threshold"),
+    ([2.0, 2.0], 0.0, "duplicate with strict zero threshold"),
+    ([2.0, 2.0], -1.0, "negative threshold"),
+    ([math.inf, math.inf], 1.0, "positive infinities"),
+    ([-math.inf, math.inf], math.inf, "opposite infinities"),
+    ([math.nan, 1.0, 1.0], 0.1, "NaN plus duplicate finite values"),
+    ([math.nan, math.nan], math.inf, "NaN values"),
+    ([1e308, -1e308], math.inf, "overflowing subtraction"),
+    ([1.0, 5.0, 1.25], 0.3, "true only against later nonadjacent position"),
+    ([5.0, 1.0, 1.25], 0.3, "true in later outer iteration"),
+]
+
+small_values = (-2.0, -0.0, 0.25, 1.0, 2.0)
+small_thresholds = (-1.0, 0.0, 0.25, 0.5, 3.0)
+max_exhaustive_length = 5
+random_seed = 20260724
+random_case_count = 3000
+
+manifest = {
+    "edge_cases": [
+        {"numbers": xs, "threshold": t, "description": description}
+        for xs, t, description in edge_cases
+    ],
+    "exhaustive": {
+        "values": small_values,
+        "thresholds": small_thresholds,
+        "lengths": list(range(max_exhaustive_length + 1)),
+    },
+    "random": {
+        "seed": random_seed,
+        "count": random_case_count,
+        "list_length_range": [0, 10],
+        "integer_numerator_range": [-100, 100],
+        "number_denominator": 8,
+        "integer_threshold_numerator_range": [-16, 80],
+        "threshold_denominator": 8,
+    },
+}
+MANIFEST.write_text(json.dumps(manifest, indent=2, allow_nan=True) + "\n")
+
+mismatches = []
+checked = 0
+
+
+def check(numbers, threshold, provenance):
+    global checked
+    expected = canonical.has_close_elements(numbers, threshold)
+    actual = candidate.has_close_elements(numbers, threshold)
+    checked += 1
+    if type(actual) is not bool or actual != expected:
+        mismatches.append(
+            {
+                "numbers": numbers,
+                "threshold": threshold,
+                "canonical": expected,
+                "candidate": actual,
+                "provenance": provenance,
+            }
+        )
+
+
+for numbers, threshold, description in edge_cases:
+    check(numbers, threshold, f"edge:{description}")
+
+exhaustive_count = 0
+for length in range(max_exhaustive_length + 1):
+    for values in itertools.product(small_values, repeat=length):
+        for threshold in small_thresholds:
+            check(list(values), threshold, "exhaustive-small")
+            exhaustive_count += 1
+
+rng = random.Random(random_seed)
+for _ in range(random_case_count):
+    length = rng.randint(0, 10)
+    numbers = [rng.randint(-100, 100) / 8.0 for _ in range(length)]
+    threshold = rng.randint(-16, 80) / 8.0
+    check(numbers, threshold, "deterministic-random")
+
+print(f"edge_cases={len(edge_cases)}")
+print(f"exhaustive_cases={exhaustive_count}")
+print(f"random_cases={random_case_count}")
+print(f"total_cases={checked}")
+print(f"mismatches={len(mismatches)}")
+if mismatches:
+    print(json.dumps(mismatches[:20], indent=2, allow_nan=True))
+    sys.exit(1)
