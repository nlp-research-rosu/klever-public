@@ -0,0 +1,20 @@
+WORKDIR: /tmp/audit-work/0-has-close-elements
+
+COMMAND: python3 py2mpy.py solution.py > solution.regenerated.mpy
+EXIT: 0
+
+COMMAND: cmp -s solution.regenerated.mpy solution.mpy
+EXIT: 0
+
