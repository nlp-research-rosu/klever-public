--- verification.k ---
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION-BASE
     4	  imports MPY
     5	
     6	  // Exact constructor terms emitted in solution.mpy.
     7	  syntax Stmts ::= nearBody() [function, total]
     8	  rule nearBody() =>
     9	    If(Compare(Call(Name("abs"),
    10	                    BinOp("-", Name("number"), Name("other"))),
    11	               CmpOp("<", Name("threshold"))),
    12	       Assign(Name("found"), Bool(true))
    13	       Break
    14	       .Stmts,
    15	       .Stmts)
    16	    .Stmts
    17	
    18	  syntax Stmts ::= helperLoopBody() [function, total]
    19	  rule helperLoopBody() =>
    20	    If(Compare(Name("index"), CmpOp(">=", Name("start"))),
    21	       nearBody(),
    22	       .Stmts)
    23	    AugAssign(Name("index"), "+", Int(1))
    24	    .Stmts
    25	
    26	  syntax Stmts ::= helperBody() [function, total]
    27	  rule helperBody() =>
    28	    Assign(Name("found"), Bool(false))
    29	    Assign(Name("index"), Int(0))
    30	    Assign(Name("other"), Name("number"))
    31	    For(Name("other"), Name("numbers"), helperLoopBody())
    32	    Assign(Name("index"), Int(0))
    33	    Assign(Name("other"), Name("number"))
    34	    Return(Name("found"))
    35	    .Stmts
    36	
    37	  syntax Stmts ::= outerLoopBody() [function, total]
    38	  rule outerLoopBody() =>
    39	    If(Call(Name("is_close_to_any"),
    40	            Name("number"), Name("numbers"), Name("threshold"),
    41	            Name("start"), .Exprs),
    42	       Assign(Name("found"), Bool(true))
    43	       Break
    44	       .Stmts,
    45	       .Stmts)
    46	    AugAssign(Name("start"), "+", Int(1))
    47	    .Stmts
    48	
    49	  syntax Stmts ::= entryBody() [function, total]
    50	  rule entryBody() =>
    51	    Assign(Name("found"), Bool(false))
    52	    Assign(Name("start"), Int(1))
    53	    Assign(Name("number"), Name("threshold"))
    54	    For(Name("number"), Name("numbers"), outerLoopBody())
    55	    Assign(Name("start"), Int(1))
    56	    Assign(Name("number"), Name("threshold"))
    57	    Return(Name("found"))
    58	    .Stmts
    59	
    60	  syntax Val ::= helperClosure() [function, total]
    61	               | entryClosure()  [function, total]
    62	  rule helperClosure() =>
    63	    closureVal(("number", "numbers", "threshold", "start"), helperBody(), 0)
    64	  rule entryClosure() =>
    65	    closureVal(("numbers", "threshold"), entryBody(), 0)
    66	
    67	  syntax Module ::= solutionModule() [function, total]
    68	  rule solutionModule() =>
    69	    Module(
    70	      ImportFrom("typing", "List")
    71	      FuncDef("is_close_to_any",
    72	              Params("number", "numbers", "threshold", "start"),
    73	              helperBody())
    74	      FuncDef("has_close_elements",
    75	              Params("numbers", "threshold"),
    76	              entryBody())
    77	      .Stmts)
    78	
    79	  syntax Scope ::= solutionScope() [function, total]
    80	  rule solutionScope() =>
    81	    scope(.Map
    82	          [ "is_close_to_any" <- helperClosure() ]
    83	          [ "has_close_elements" <- entryClosure() ],
    84	          parent(-1))
    85	
    86	  // A typed proof-only ValSeq representation. The two iterator equations below
    87	  // are the representation relation to MPY lists and make every yielded
    88	  // element statically Float to the prover.
    89	  syntax ValSeq ::= FloatSeq
    90	  syntax FloatSeq ::= ".FloatSeq" | fCons(Float, FloatSeq)
    91	  rule <k> #iterNext(list(.FloatSeq)) => #iterDone ... </k>
    92	    [priority(40)]
    93	  rule <k> #iterNext(list(fCons(F:Float, R:FloatSeq)))
    94	        => #iterYield(F, list(R)) ... </k>
    95	    [priority(40)]
    96	
    97	  syntax Bool ::= near(Float, Float, Float) [function, total]
    98	  rule near(A:Float, B:Float, T:Float) => floatLt(absF(subF(A, B)), T)
    99	
   100	  // Search CUR, whose first element has absolute index I, ignoring elements
   101	  // before START. This is exactly the helper's loop invariant.
   102	  syntax Bool ::= closeSkip(Float, FloatSeq, Float, Int, Int) [function, total]
   103	  rule closeSkip(_:Float, .FloatSeq, _:Float, _:Int, _:Int) => false
   104	  rule closeSkip(A:Float, fCons(_:Float, R:FloatSeq), T:Float,
   105	                 I:Int, START:Int)
   106	    => closeSkip(A, R, T, I +Int 1, START)
   107	    requires I <Int START
   108	  rule closeSkip(A:Float, fCons(B:Float, R:FloatSeq), T:Float,
   109	                 I:Int, START:Int)
   110	    => near(A, B, T) orBool closeSkip(A, R, T, I +Int 1, START)
   111	    requires I >=Int START
   112	
   113	  // For each head of CUR, compare it with the portion of ALL beginning at
   114	  // START, then advance both CUR and START. Initially CUR=ALL and START=1,
   115	  // so this denotes exactly all pairs of distinct positions i < j.
   116	  syntax Bool ::= hasPairs(FloatSeq, FloatSeq, Float, Int) [function, total]
   117	  rule hasPairs(_:FloatSeq, .FloatSeq, _:Float, _:Int) => false
   118	  rule hasPairs(ALL:FloatSeq, fCons(A:Float, R:FloatSeq), T:Float, START:Int)
   119	    => closeSkip(A, ALL, T, 0, START)
   120	       orBool hasPairs(ALL, R, T, START +Int 1)
   121	
   122	  syntax KItem ::= "#proofDone"
   123	endmodule
   124	
   125	// Staged proved lemmas; prove.sh compiles each only after proving the identical
   126	// claim against the preceding module.
   127	module VERIFICATION-WITH-INNER
   128	  imports VERIFICATION-BASE
   129	
   130	  rule <k> For(Name("other"), list(ALL:FloatSeq), _B:Stmts)
   131	        => .K ... </k>
   132	       <env> 2 </env>
   133	       <scopes> ... 2 |-> scope(M:Map => M
   134	                                  [ "found" <- closeSkip(A, ALL, T, 0, START) ]
   135	                                  [ "index" <- 0 ]
   136	                                  [ "other" <- A ],
   137	                                parent(0)) ... </scopes>
   138	       <ret> noRet </ret>
   139	    requires {M["number"]}:>Val ==K A
   140	     andBool {M["numbers"]}:>Val ==K list(ALL)
   141	     andBool {M["threshold"]}:>Val ==K T
   142	     andBool {M["start"]}:>Val ==K START
   143	     andBool {M["found"]}:>Val ==K false
   144	     andBool {M["index"]}:>Val ==K 0
   145	    [priority(45)]
   146	endmodule
   147	
   148	module VERIFICATION-WITH-HELPER
   149	  imports VERIFICATION-WITH-INNER
   150	
   151	  rule <k> Call(Name("is_close_to_any"),
   152	                Name("number"), Name("numbers"), Name("threshold"),
   153	                Name("start"), .Exprs)
   154	        => closeSkip(A, ALL, T, 0, START) ... </k>
   155	       <env> 1 </env>
   156	       <scopes> ... 1 |-> scope(M:Map, parent(0)) ... </scopes>
   157	    requires {M["number"]}:>Val ==K A:Float
   158	     andBool {M["numbers"]}:>Val ==K list(ALL:FloatSeq)
   159	     andBool {M["threshold"]}:>Val ==K T:Float
   160	     andBool {M["start"]}:>Val ==K START:Int
   161	    [priority(40)]
   162	
   163	  rule <k> #applyK(toCall(closureVal(
   164	                     ("number", "numbers", "threshold", "start"),
   165	                     _BODY:Stmts, 0)),
   166	                   (A:Float, list(ALL:FloatSeq),
   167	                    T:Float, START:Int, .Vals)) ~> K:K
   168	        => closeSkip(A, ALL, T, 0, START) ~> K ... </k>
   169	       <env> 1 </env>
   170	       <scopeLoc> 2 </scopeLoc>
   171	       <ret> noRet </ret>
   172	    [priority(40)]
   173	endmodule
   174	
   175	module VERIFICATION-WITH-OUTER
   176	  imports VERIFICATION-WITH-HELPER
   177	
   178	  rule <k> For(Name("number"), list(ALL:FloatSeq), _B:Stmts)
   179	        => .K ... </k>
   180	       <env> 1 </env>
   181	       <scopes> ... 1 |-> scope(M:Map => M
   182	                                  [ "found" <- hasPairs(ALL, ALL, T, 1) ]
   183	                                  [ "start" <- 1 ]
   184	                                  [ "number" <- T ],
   185	                                parent(0)) ... </scopes>
   186	       <ret> noRet </ret>
   187	    requires {M["numbers"]}:>Val ==K list(ALL)
   188	     andBool {M["threshold"]}:>Val ==K T:Float
   189	     andBool {M["found"]}:>Val ==K false
   190	     andBool {M["start"]}:>Val ==K 1
   191	    [priority(45)]
   192	endmodule
   193	
   194	module VERIFICATION-WITH-ENTRY
   195	  imports VERIFICATION-WITH-OUTER
   196	
   197	  rule <k> Call(Name("has_close_elements"),
   198	                list(ALL:FloatSeq), T:Float, .Exprs)
   199	        => hasPairs(ALL, ALL, T, 1) ... </k>
   200	       <env> 0 </env>
   201	       <scopeLoc> 1 </scopeLoc>
   202	       <ret> noRet </ret>
   203	    [priority(40)]
   204	endmodule
   205	
   206	module VERIFICATION
   207	  imports VERIFICATION-WITH-ENTRY
   208	endmodule
--- prove.sh ---
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Keep every run collision-free and preserve its compiled definitions for audit.
     5	PROOF_BUILD=$(mktemp -d -p "$PWD" .kproof.XXXXXX)
     6	
     7	# Required translation and concrete LLVM execution.
     8	python3 py2mpy.py solution.py > solution.mpy
     9	python3 py2mpy.py smoke.py > smoke.mpy
    10	kompile reference-semantics/semantics.k \
    11	  --backend llvm \
    12	  --main-module MPY-KRUN \
    13	  --syntax-module MPY-SYNTAX \
    14	  --output-definition "$PROOF_BUILD/runtime-kompiled"
    15	krun smoke.mpy \
    16	  --definition "$PROOF_BUILD/runtime-kompiled" \
    17	  --output none
    18	
    19	# Proof rung 1: the helper's structural loop cases.
    20	kompile verification.k \
    21	  --backend haskell \
    22	  --main-module VERIFICATION-BASE \
    23	  --syntax-module MPY-SYNTAX \
    24	  --output-definition "$PROOF_BUILD/base-kompiled"
    25	kprove spec.k \
    26	  --definition "$PROOF_BUILD/base-kompiled" \
    27	  --spec-module SPEC-INNER
    28	
    29	# Proof rung 2: the complete helper call, using only rung 1's proved summary.
    30	kompile verification.k \
    31	  --backend haskell \
    32	  --main-module VERIFICATION-WITH-INNER \
    33	  --syntax-module MPY-SYNTAX \
    34	  --output-definition "$PROOF_BUILD/inner-kompiled"
    35	kprove spec.k \
    36	  --definition "$PROOF_BUILD/inner-kompiled" \
    37	  --spec-module SPEC-HELPER
    38	
    39	# Proof rung 3: the outer all-pairs traversal.
    40	kompile verification.k \
    41	  --backend haskell \
    42	  --main-module VERIFICATION-WITH-HELPER \
    43	  --syntax-module MPY-SYNTAX \
    44	  --output-definition "$PROOF_BUILD/helper-kompiled"
    45	kprove spec.k \
    46	  --definition "$PROOF_BUILD/helper-kompiled" \
    47	  --spec-module SPEC-OUTER
    48	
    49	# Proof rung 4: the required public entry point.
    50	kompile verification.k \
    51	  --backend haskell \
    52	  --main-module VERIFICATION-WITH-OUTER \
    53	  --syntax-module MPY-SYNTAX \
    54	  --output-definition "$PROOF_BUILD/outer-kompiled"
    55	kprove spec.k \
    56	  --definition "$PROOF_BUILD/outer-kompiled" \
    57	  --spec-module SPEC-ENTRY
    58	
    59	# Proof rung 5: load the exact solution.mpy tree and call the entry point.
    60	kompile verification.k \
    61	  --backend haskell \
    62	  --main-module VERIFICATION-WITH-ENTRY \
    63	  --syntax-module MPY-SYNTAX \
    64	  --output-definition "$PROOF_BUILD/entry-kompiled"
    65	kprove spec.k \
    66	  --definition "$PROOF_BUILD/entry-kompiled" \
    67	  --spec-module SPEC
    68	
    69	echo "Proof artifacts: $PROOF_BUILD"
--- smoke.py ---
     1	from typing import List
     2	
     3	
     4	def is_close_to_any(number: float, numbers: List[float], threshold: float, start: int) -> bool:
     5	    found = False
     6	    index = 0
     7	    other = number
     8	    for other in numbers:
     9	        if index >= start:
    10	            if abs(number - other) < threshold:
    11	                found = True
    12	                break
    13	        index += 1
    14	    index = 0
    15	    other = number
    16	    return found
    17	
    18	
    19	def has_close_elements(numbers: List[float], threshold: float) -> bool:
    20	    found = False
    21	    start = 1
    22	    number = threshold
    23	    for number in numbers:
    24	        if is_close_to_any(number, numbers, threshold, start):
    25	            found = True
    26	            break
    27	        start += 1
    28	    start = 1
    29	    number = threshold
    30	    return found
    31	
    32	
    33	assert has_close_elements([1.0, 2.0, 3.0], 0.5) == False
    34	assert has_close_elements([1.0, 2.8, 3.0, 4.0, 5.0, 2.0], 0.3) == True
    35	assert has_close_elements([], 1.0) == False
    36	assert has_close_elements([1.0], 1.0) == False
    37	assert has_close_elements([1.0, 1.0], 0.1) == True
    38	assert has_close_elements([1.0, 1.3], 0.3) == False
--- smoke.mpy ---
     1	Module(
     2	  ImportFrom("typing", "List")
     3	  FuncDef("is_close_to_any", Params("number", "numbers", "threshold", "start"),
     4	    Assign(Name("found"), Bool(false))
     5	    Assign(Name("index"), Int(0))
     6	    Assign(Name("other"), Name("number"))
     7	    For(Name("other"), Name("numbers"),
     8	      If(Compare(Name("index"), CmpOp(">=", Name("start"))),
     9	        If(Compare(
    10	          Call(Name("abs"), BinOp("-", Name("number"), Name("other"))),
    11	          CmpOp("<", Name("threshold"))),
    12	          Assign(Name("found"), Bool(true))
    13	          Break,
    14	          ),
    15	        )
    16	      AugAssign(Name("index"), "+", Int(1)))
    17	    Assign(Name("index"), Int(0))
    18	    Assign(Name("other"), Name("number"))
    19	    Return(Name("found")))
    20	  FuncDef("has_close_elements", Params("numbers", "threshold"),
    21	    Assign(Name("found"), Bool(false))
    22	    Assign(Name("start"), Int(1))
    23	    Assign(Name("number"), Name("threshold"))
    24	    For(Name("number"), Name("numbers"),
    25	      If(Call(
    26	        Name("is_close_to_any"),
    27	        Name("number"),
    28	        Name("numbers"),
    29	        Name("threshold"),
    30	        Name("start")),
    31	        Assign(Name("found"), Bool(true))
    32	        Break,
    33	        )
    34	      AugAssign(Name("start"), "+", Int(1)))
    35	    Assign(Name("start"), Int(1))
    36	    Assign(Name("number"), Name("threshold"))
    37	    Return(Name("found")))
    38	  Assert(
    39	    Compare(
    40	      Call(
    41	        Name("has_close_elements"),
    42	        ListExpr(Float(1.0), Float(2.0), Float(3.0)),
    43	        Float(0.5)),
