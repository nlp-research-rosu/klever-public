+         => closeSkip(A, fCons(A, .FloatSeq),
+                      T, 0, 0) ~> #proofDone </k>
+        <env> 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(.Map, parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
