+                     parent(-1))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+module WITNESS-BRIDGED-SHADOWED-ENTRY-SUMMARY
