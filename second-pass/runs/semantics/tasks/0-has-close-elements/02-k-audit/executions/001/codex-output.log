diff --git a/evidence/bridge-witness.k b/evidence/bridge-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..f0a1be6b0d47462ab782c37bdb7e869c0b0b9ac3
--- /dev/null
+++ b/evidence/bridge-witness.k
@@ -0,0 +1,46 @@
+requires "verification.k"
+
+// Same closure invocation and ordinary Float/List input in both claims.
+// The closure body deliberately returns false.  The submitted generalized
+// bridge ignores that body and returns closeSkip(...), which denotes true for
+// this ground input under the supplied concrete Float semantics.
+module WITNESS-FIXED-CLOSURE-FALSE
+  imports VERIFICATION-WITH-INNER
+
+  claim <k> #applyK(toCall(closureVal(
+                       ("number", "numbers", "threshold", "start"),
+                       Return(Bool(false)) .Stmts,
+                       0)),
+                     (1.0, list(fCons(1.0, .FloatSeq)),
+                      0.1, 0, .Vals)) ~> #proofDone
+         => false ~> #proofDone </k>
+        <env> 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(.Map, parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
+
+module WITNESS-BRIDGED-CLOSURE-SUMMARY
+  imports VERIFICATION-WITH-HELPER
+
+  claim <k> #applyK(toCall(closureVal(
+                       ("number", "numbers", "threshold", "start"),
+                       Return(Bool(false)) .Stmts,
+                       0)),
+                     (1.0, list(fCons(1.0, .FloatSeq)),
+                      0.1, 0, .Vals)) ~> #proofDone
+         => closeSkip(1.0, fCons(1.0, .FloatSeq),
+                      0.1, 0, 0) ~> #proofDone </k>
+        <env> 1 </env>
+        <scopes>
+          0  |-> solutionScope()
+          1  |-> scope(.Map, parent(0))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 2 </scopeLoc>
+        <ret> noRet </ret>
+endmodule
