from itertools import permutations
from solution import minPath

def brute(grid, k):
    n = len(grid)
    paths = [([grid[i][j]], i, j) for i in range(n) for j in range(n)]
    for _ in range(k - 1):
        nxt = []
        for values, i, j in paths:
            for di, dj in ((-1, 0), (1, 0), (0, -1), (0, 1)):
                ni, nj = i + di, j + dj
                if 0 <= ni < n and 0 <= nj < n:
                    nxt.append((values + [grid[ni][nj]], ni, nj))
        paths = nxt
    return min(values for values, _, _ in paths)

for p in permutations(range(1, 5)):
    g = [list(p[:2]), list(p[2:])]
    for k in range(1, 7):
        assert minPath(g, k) == brute(g, k), (g, k)
print('Python exhaustive 2x2 differential test: passed (144 cases)')
