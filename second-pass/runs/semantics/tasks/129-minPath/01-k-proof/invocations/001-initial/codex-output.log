+requires "verification.k"
+
+module MINPATH-SPEC
+  imports MINPATH-VERIFICATION
+
+  // Loop invariant: for arbitrary positive remaining length and arbitrary
+  // chosen neighbor N, the exact Python for-loop appends the alternating path.
+  claim
+    <k>
+      #loop(rangeObj(I, K, 1), Name("i"), minPathAppendBody)
+      => .K
+    </k>
+    <env> L </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("i" |-> OLD)
+        ("path" |-> ref(H))
+        ("neighbor" |-> N)
+        =>
+        ("i" |-> K -Int 1)
+        ("path" |-> ref(H))
+        ("neighbor" |-> N),
+        PARENT)
+      ...
+    </scopes>
+    <heap>
+      ...
+      H |-> list(P => minPathBuild(P, I, K, N))
+      ...
+    </heap>
+    requires
+      0 <=Int I andBool I <Int K
+
+  // Prompt example: top-left 1, path length 3.
+  claim
+    <k>
+      #loadAll(minPathProgram)
+      ~> Call(
+           Name("minPath"),
+           list(vCons(
+             list(vCons(1, vCons(2, vCons(3, .ValSeq)))),
+             vCons(
+               list(vCons(4, vCons(5, vCons(6, .ValSeq)))),
+               vCons(
+                 list(vCons(7, vCons(8, vCons(9, .ValSeq)))),
+                 .ValSeq)))),
+           Int(3))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0 |-> scope(("minPath" |-> minPathClosure), parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, vCons(2, vCons(1, .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Prompt example: interior 1 and the k=1 boundary case.
+  claim
+    <k>
+      #loadAll(minPathProgram)
+      ~> Call(
+           Name("minPath"),
+           list(vCons(
+             list(vCons(5, vCons(9, vCons(3, .ValSeq)))),
+             vCons(
+               list(vCons(4, vCons(1, vCons(6, .ValSeq)))),
+               vCons(
+                 list(vCons(7, vCons(8, vCons(2, .ValSeq)))),
+                 .ValSeq)))),
+           Int(1))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0 |-> scope(("minPath" |-> minPathClosure), parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(vCons(1, .ValSeq)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Symbolic theorem: for every permutation of 1..4 in a 2x2 grid, the
+  // implementation returns the unique length-four lexicographic minimum.
+  claim
+    <k>
+      #loadAll(minPathProgram)
+      ~> Call(
+           Name("minPath"),
+           list(vCons(
+             list(vCons(A, vCons(B, .ValSeq))),
+             vCons(list(vCons(C, vCons(D, .ValSeq))), .ValSeq))),
+           Int(4))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0 |-> scope(("minPath" |-> minPathClosure), parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(minPathFour(minPathNeighbor2(A, B, C, D)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires
+      1 <=Int A andBool A <=Int 4 andBool
+      1 <=Int B andBool B <=Int 4 andBool
+      1 <=Int C andBool C <=Int 4 andBool
+      1 <=Int D andBool D <=Int 4 andBool
+      A =/=Int B andBool A =/=Int C andBool A =/=Int D andBool
+      B =/=Int C andBool B =/=Int D andBool C =/=Int D
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..54d8d7ef3573c2ac1c4f9054f853b43f277043c9
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,117 @@
+requires "reference-semantics/semantics.k"
+
+module MINPATH-VERIFICATION
+  imports MPY
+
+  syntax Stmts ::= "minPathAppendBody" [macro]
+  rule minPathAppendBody =>
+    If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+       Expr(Call(Attribute(Name("path"), "append"), Int(1))),
+       Expr(Call(Attribute(Name("path"), "append"), Name("neighbor"))))
+
+  // The exact translated body from solution.mpy, named once so that the
+  // execution claims and the final module closure refer to the same program.
+  syntax Stmts ::= "minPathBody" [macro]
+  rule minPathBody =>
+    Assign(Name("n"), Call(Name("len"), Name("grid")))
+    Assign(Name("row"), Int(0))
+    Assign(Name("column"), Int(0))
+    For(Name("i"), Call(Name("range"), Name("n")),
+      For(Name("j"), Call(Name("range"), Name("n")),
+        If(Compare(
+             Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
+             CmpOp("==", Int(1))),
+           Assign(Name("row"), Name("i"))
+           Assign(Name("column"), Name("j")),
+           .Stmts)))
+    Assign(Name("neighbor"),
+      BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
+    If(Compare(Name("row"), CmpOp(">", Int(0))),
+       Assign(Name("value"),
+         Subscript(
+           Subscript(Name("grid"), BinOp("-", Name("row"), Int(1))),
+           Name("column")))
+       If(Compare(Name("value"), CmpOp("<", Name("neighbor"))),
+          Assign(Name("neighbor"), Name("value")),
+          .Stmts),
+       .Stmts)
+    If(Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),
+       Assign(Name("value"),
+         Subscript(
+           Subscript(Name("grid"), BinOp("+", Name("row"), Int(1))),
+           Name("column")))
+       If(Compare(Name("value"), CmpOp("<", Name("neighbor"))),
+          Assign(Name("neighbor"), Name("value")),
+          .Stmts),
+       .Stmts)
+    If(Compare(Name("column"), CmpOp(">", Int(0))),
+       Assign(Name("value"),
+         Subscript(
+           Subscript(Name("grid"), Name("row")),
+           BinOp("-", Name("column"), Int(1))))
+       If(Compare(Name("value"), CmpOp("<", Name("neighbor"))),
+          Assign(Name("neighbor"), Name("value")),
+          .Stmts),
+       .Stmts)
+    If(Compare(BinOp("+", Name("column"), Int(1)), CmpOp("<", Name("n"))),
+       Assign(Name("value"),
+         Subscript(
+           Subscript(Name("grid"), Name("row")),
+           BinOp("+", Name("column"), Int(1))))
+       If(Compare(Name("value"), CmpOp("<", Name("neighbor"))),
+          Assign(Name("neighbor"), Name("value")),
+          .Stmts),
+       .Stmts)
+    Assign(Name("path"), ListExpr(.Exprs))
+    For(Name("i"), Call(Name("range"), Name("k")),
+      minPathAppendBody)
+    Return(Name("path"))
+
+  syntax Module ::= "minPathProgram" [macro]
+  rule minPathProgram =>
+    Module(FuncDef("minPath", Params("grid", "k"), minPathBody))
+
+  syntax Val ::= "minPathClosure" [macro]
+  rule minPathClosure =>
+    closureVal(("grid", "k", .ParamNames), minPathBody, 0)
+
+  // Mathematical helpers used only in postconditions.
+  syntax Int ::= minPathMin(Int, Int) [function, total]
+  rule minPathMin(A:Int, B:Int) => A requires A <=Int B
+  rule minPathMin(A:Int, B:Int) => B requires A  >Int B
+
+  // On a 2x2 grid, all cells are corners. Under the spec's permutation
+  // precondition these four rules select the two neighbors of the unique 1.
+  syntax Int ::= minPathNeighbor2(Int, Int, Int, Int) [function, total]
+  rule minPathNeighbor2(A:Int, B:Int, C:Int, _D:Int)
+    => minPathMin(B, C)
+    requires A ==Int 1
+  rule minPathNeighbor2(A:Int, B:Int, _C:Int, D:Int)
+    => minPathMin(A, D)
+    requires A =/=Int 1 andBool B ==Int 1
+  rule minPathNeighbor2(A:Int, B:Int, C:Int, D:Int)
+    => minPathMin(A, D)
+    requires A =/=Int 1 andBool B =/=Int 1 andBool C ==Int 1
+  rule minPathNeighbor2(A:Int, B:Int, C:Int, _D:Int)
+    => minPathMin(B, C)
+    requires A =/=Int 1 andBool B =/=Int 1 andBool C =/=Int 1
+
+  syntax ValSeq ::= minPathFour(Int) [function, total]
+  rule minPathFour(M:Int)
+    => vCons(1, vCons(M, vCons(1, vCons(M, .ValSeq))))
+
+  // Accumulator specification for the exact append loop. It is deliberately
+  // phrased in accumulator form so the symbolic loop and this mathematical
+  // function advance in lockstep under circularity.
+  syntax ValSeq ::= minPathBuild(ValSeq, Int, Int, Int) [function, total]
+  rule minPathBuild(P:ValSeq, I:Int, K:Int, _M:Int) => P
+    requires I >=Int K
+  rule minPathBuild(P:ValSeq, I:Int, K:Int, M:Int)
+    => minPathBuild(
+         valSeqConcat(P, vCons(1, .ValSeq)), I +Int 1, K, M)
+    requires I <Int K andBool pyMod(I, 2) ==Int 0
+  rule minPathBuild(P:ValSeq, I:Int, K:Int, M:Int)
+    => minPathBuild(
+         valSeqConcat(P, vCons(M, .ValSeq)), I +Int 1, K, M)
+    requires I <Int K andBool pyMod(I, 2) =/=Int 0
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..d4f1b6a6c667f51636d951cbc263186f7f9fbb97
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,45 @@
+def minPath(grid, k):
+    n = len(grid)
+    row = 0
+    column = 0
+
+    for i in range(n):
+        for j in range(n):
+            if grid[i][j] == 1:
+                row = i
+                column = j
+
+    neighbor = n * n + 1
+
+    if row > 0:
+        value = grid[row - 1][column]
+        if value < neighbor:
+            neighbor = value
+    if row + 1 < n:
+        value = grid[row + 1][column]
+        if value < neighbor:
+            neighbor = value
+    if column > 0:
+        value = grid[row][column - 1]
+        if value < neighbor:
+            neighbor = value
+    if column + 1 < n:
+        value = grid[row][column + 1]
+        if value < neighbor:
+            neighbor = value
+
+    path = []
+    for i in range(k):
+        if i % 2 == 0:
+            path.append(1)
+        else:
+            path.append(neighbor)
+
+    return path
+
+
+assert minPath([[1, 2, 3], [4, 5, 6], [7, 8, 9]], 3) == [1, 2, 1]
+assert minPath([[5, 9, 3], [4, 1, 6], [7, 8, 2]], 1) == [1]
+assert minPath([[4, 3], [2, 1]], 6) == [1, 2, 1, 2, 1, 2]
+assert minPath([[2, 1], [3, 4]], 5) == [1, 2, 1, 2, 1]
+assert minPath([[8, 7, 6], [5, 1, 2], [4, 3, 9]], 4) == [1, 2, 1, 2]
