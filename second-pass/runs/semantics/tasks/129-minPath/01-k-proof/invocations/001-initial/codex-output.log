+                column = j
+
+    neighbor = n * n + 1
+
+    if row > 0:
+        value = grid[row - 1][column]
+        if value < neighbor:
+            neighbor = value
+    if row + 1 < n:
+        value = grid[row + 1][column]
+        if value < neighbor:
+            neighbor = value
+    if column > 0:
+        value = grid[row][column - 1]
