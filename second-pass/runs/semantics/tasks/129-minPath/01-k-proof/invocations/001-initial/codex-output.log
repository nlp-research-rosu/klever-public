+        if value < neighbor:
+            neighbor = value
+    if column > 0:
+        value = grid[row][column - 1]
+        if value < neighbor:
+            neighbor = value
+    if column + 1 < n:
+        value = grid[row][column + 1]
+        if value < neighbor:
