Module(
  FuncDef("minPath", Params("grid", "k"),
    Assign(Name("n"), Call(Name("len"), Name("grid")))
    Assign(Name("row"), Int(0))
    Assign(Name("column"), Int(0))
    For(Name("i"), Call(Name("range"), Name("n")),
      For(Name("j"), Call(Name("range"), Name("n")),
        If(Compare(
          Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
          CmpOp("==", Int(1))),
          Assign(Name("row"), Name("i"))
          Assign(Name("column"), Name("j")),
          )))
    Assign(
      Name("neighbor"),
      BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
    If(Compare(Name("row"), CmpOp(">", Int(0))),
      Assign(
        Name("value"),
        Subscript(
          Subscript(Name("grid"), BinOp("-", Name("row"), Int(1))),
          Name("column")))
      If(Compare(Name("value"), CmpOp("<", Name("neighbor"))),
        Assign(Name("neighbor"), Name("value")),
        ),
      )
    If(Compare(BinOp("+", Name("row"), Int(1)), CmpOp("<", Name("n"))),
      Assign(
        Name("value"),
        Subscript(
          Subscript(Name("grid"), BinOp("+", Name("row"), Int(1))),
          Name("column")))
      If(Compare(Name("value"), CmpOp("<", Name("neighbor"))),
        Assign(Name("neighbor"), Name("value")),
        ),
      )
    If(Compare(Name("column"), CmpOp(">", Int(0))),
      Assign(
        Name("value"),
        Subscript(
          Subscript(Name("grid"), Name("row")),
          BinOp("-", Name("column"), Int(1))))
      If(Compare(Name("value"), CmpOp("<", Name("neighbor"))),
        Assign(Name("neighbor"), Name("value")),
        ),
      )
    If(Compare(BinOp("+", Name("column"), Int(1)), CmpOp("<", Name("n"))),
      Assign(
        Name("value"),
        Subscript(
          Subscript(Name("grid"), Name("row")),
          BinOp("+", Name("column"), Int(1))))
      If(Compare(Name("value"), CmpOp("<", Name("neighbor"))),
        Assign(Name("neighbor"), Name("value")),
        ),
      )
    Assign(Name("path"), ListExpr())
    For(Name("i"), Call(Name("range"), Name("k")),
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
        Expr(Call(Attribute(Name("path"), "append"), Int(1))),
        Expr(Call(Attribute(Name("path"), "append"), Name("neighbor")))))
    Return(Name("path")))
  Assert(
    Compare(
      Call(
        Name("minPath"),
        ListExpr(
          ListExpr(Int(1), Int(2), Int(3)),
          ListExpr(Int(4), Int(5), Int(6)),
          ListExpr(Int(7), Int(8), Int(9))),
        Int(3)),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(1)))))
  Assert(
    Compare(
      Call(
        Name("minPath"),
        ListExpr(
          ListExpr(Int(5), Int(9), Int(3)),
          ListExpr(Int(4), Int(1), Int(6)),
          ListExpr(Int(7), Int(8), Int(2))),
        Int(1)),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(
        Name("minPath"),
        ListExpr(ListExpr(Int(4), Int(3)), ListExpr(Int(2), Int(1))),
        Int(6)),
      CmpOp(
        "==",
        ListExpr(Int(1), Int(2), Int(1), Int(2), Int(1), Int(2)))))
  Assert(
    Compare(
      Call(
        Name("minPath"),
        ListExpr(ListExpr(Int(2), Int(1)), ListExpr(Int(3), Int(4))),
        Int(5)),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(1), Int(2), Int(1)))))
  Assert(
    Compare(
      Call(
        Name("minPath"),
        ListExpr(
          ListExpr(Int(8), Int(7), Int(6)),
          ListExpr(Int(5), Int(1), Int(2)),
          ListExpr(Int(4), Int(3), Int(9))),
        Int(4)),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(1), Int(2))))))
