     6	def minPath(grid, k):
     7	    """
     8	    Given a grid with N rows and N columns (N >= 2) and a positive integer k, 
     9	    each cell of the grid contains a value. Every integer in the range [1, N * N]
    10	    inclusive appears exactly once on the cells of the grid.
    11	
    12	    You have to find the minimum path of length k in the grid. You can start
    13	    from any cell, and in each step you can move to any of the neighbor cells,
    14	    in other words, you can go to cells which share an edge with you current
    15	    cell.
    16	    Please note that a path of length k means visiting exactly k cells (not
    17	    necessarily distinct).
    18	    You CANNOT go off the grid.
    19	    A path A (of length k) is considered less than a path B (of length k) if
    20	    after making the ordered lists of the values on the cells that A and B go
    21	    through (let's call them lst_A and lst_B), lst_A is lexicographically less
    22	    than lst_B, in other words, there exist an integer index i (1 <= i <= k)
    23	    such that lst_A[i] < lst_B[i] and for any j (1 <= j < i) we have
    24	    lst_A[j] = lst_B[j].
    25	    It is guaranteed that the answer is unique.
    26	    Return an ordered list of the values on the cells that the minimum path go through.
    27	
    28	    Examples:
    29	
    30	        Input: grid = [ [1,2,3], [4,5,6], [7,8,9]], k = 3
    31	        Output: [1, 2, 1]
    32	
    33	        Input: grid = [ [5,9,3], [4,1,6], [7,8,2]], k = 1
    34	        Output: [1]
    35	    """
    36	    n = len(grid)
    37	    val = n * n + 1
    38	    for i in range(n):
    39	        for j in range(n):
    40	            if grid[i][j] == 1:
    41	                temp = []
    42	                if i != 0:
    43	                    temp.append(grid[i - 1][j])
    44	
    45	                if j != 0:
    46	                    temp.append(grid[i][j - 1])
    47	
    48	                if i != n - 1:
    49	                    temp.append(grid[i + 1][j])
    50	
    51	                if j != n - 1:
    52	                    temp.append(grid[i][j + 1])
    53	
    54	                val = min(temp)
    55	
    56	    ans = []
    57	    for i in range(k):
    58	        if i % 2 == 0:
    59	            ans.append(1)
    60	        else:
    61	            ans.append(val)
    62	    return ans
