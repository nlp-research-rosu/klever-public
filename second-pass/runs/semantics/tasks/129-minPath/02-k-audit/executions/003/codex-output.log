reference-semantics/semantics/range.k:12:  syntax Int ::= rangeLen(Int, Int, Int) [function]
reference-semantics/semantics/range.k:13:  rule rangeLen(LO:Int, HI:Int, ST:Int) => (HI -Int LO +Int ST -Int 1) /Int ST
reference-semantics/semantics/range.k:14:       requires ST >Int 0 andBool HI >Int LO
reference-semantics/semantics/range.k:15:  rule rangeLen(LO:Int, HI:Int, ST:Int) => (LO -Int HI -Int ST -Int 1) /Int (0 -Int ST)
reference-semantics/semantics/range.k:16:       requires ST <Int 0 andBool HI <Int LO
reference-semantics/semantics/range.k:17:  rule rangeLen(LO:Int, HI:Int, ST:Int) => 0
reference-semantics/semantics/range.k:18:       requires (ST >Int 0 andBool HI <=Int LO) orBool (ST <Int 0 andBool HI >=Int LO)
reference-semantics/semantics/range.k:20:  rule <k> #iterNext(rangeObj(I:Int, HI:Int, ST:Int))
reference-semantics/semantics/range.k:22:       requires inRange(I, HI, ST)
reference-semantics/semantics/range.k:23:  rule <k> #iterNext(rangeObj(I:Int, HI:Int, ST:Int)) => #iterDone ... </k>
reference-semantics/semantics/range.k:24:       requires notBool inRange(I, HI, ST)
