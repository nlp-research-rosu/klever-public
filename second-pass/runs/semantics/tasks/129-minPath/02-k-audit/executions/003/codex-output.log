        messages.append((n,payload.get('role'),str(c)[:1800]))
print('file:',p)
print('line_count:',sum(1 for _ in p.open()))
print('json_errors:',errors)
print('event_counts:')
for k,v in sorted(counts.items()): print(k,v)
