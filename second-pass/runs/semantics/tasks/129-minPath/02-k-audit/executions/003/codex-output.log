rg -n '\\bsymbol\\(|no-evaluators|\\bfunctional\\b|\\bsimplification\\b' /tmp/audit-work/129-minPath/reference-semantics /tmp/audit-work/129-minPath/verification.k
printf '%s\\n' '===== evidence inventory'
