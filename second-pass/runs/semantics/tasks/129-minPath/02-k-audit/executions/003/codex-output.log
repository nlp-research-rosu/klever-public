@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+"""Bounded structural inspection of the complete generation trace/log."""
+
+from __future__ import annotations
+
+import collections
+import json
+from pathlib import Path
+
+
+trace = next(Path("/generation-evidence/codex-trace").rglob("*.jsonl"))
+counts: collections.Counter[str] = collections.Counter()
+tool_calls = []
+json_errors = []
+line_count = 0
+for line_count, line in enumerate(trace.open(), 1):
+    try:
+        event = json.loads(line)
+    except Exception as err:
+        json_errors.append((line_count, type(err).__name__, str(err)))
+        continue
+    counts["event:" + str(event.get("type", "<none>"))] += 1
+    payload = event.get("payload")
+    if isinstance(payload, dict):
+        payload_type = payload.get("type")
+        if payload_type:
+            counts["payload:" + str(payload_type)] += 1
+        if payload_type == "function_call":
+            name = str(payload.get("name", ""))
+            arguments = str(payload.get("arguments", ""))
+            tool_calls.append((line_count, name, arguments))
+
+print("trace:", trace)
+print("trace_lines_scanned:", line_count)
+print("json_errors:", json_errors)
+print("event_counts:")
+for key, value in sorted(counts.items()):
+    print(f"  {key}: {value}")
+print("tool_calls:")
+for line_number, name, arguments in tool_calls:
+    compact = " ".join(arguments.split())
+    print(f"  line={line_number} name={name} arguments={compact[:600]}")
+
+output_log = Path("/generation-evidence/codex-output.log")
+output_lines = output_log.read_text(errors="replace").splitlines()
+print("codex_output_lines_scanned:", len(output_lines))
+for needle in ("#Top", "kprove", "kompile", "RESULT: KPROVE_PASSED"):
+    matches = [index + 1 for index, line in enumerate(output_lines) if needle in line]
+    print(f"codex_output_occurrences[{needle!r}]: count={len(matches)} lines={matches[:40]}")
+
+assert not json_errors
+assert line_count == 255
+print("GENERATION_TRACE_SCAN: PASS")
diff --git a/evidence/k_inventory.py b/evidence/k_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..bad852113800db999ee8901186792a722345bcf8
--- /dev/null
+++ b/evidence/k_inventory.py
@@ -0,0 +1,115 @@
+#!/usr/bin/env python3
+"""Emit an exhaustive declaration/rule inventory for the audited K sources."""
+
+from __future__ import annotations
+
+import collections
+import re
+from pathlib import Path
+
+
+ROOT = Path("/tmp/audit-work/129-minPath")
+FILES = [
+    ROOT / "reference-semantics/semantics.k",
+    *sorted((ROOT / "reference-semantics/semantics").glob("*.k")),
+    ROOT / "verification.k",
+    ROOT / "spec.k",
+]
+START = re.compile(r"^\s*(configuration|syntax|context|rule|claim)\b")
+STOP = re.compile(r"^\s*(configuration|syntax|context|rule|claim|module|endmodule|requires|imports)\b")
+
+
+def classify(source: Path, kind: str, block: str) -> list[str]:
+    tags = []
+    if "reference-semantics" in str(source):
+        tags.append("SUPPLIED_FIXED")
+    elif source.name == "verification.k":
+        tags.append("PROOF_LOCAL")
+    else:
+        tags.append("CLAIM_SPEC")
+    tags.append(kind.upper())
+    for attr, tag in (
+        ("function", "FUNCTION"),
+        ("functional", "FUNCTIONAL"),
+        ("total", "TOTAL"),
+        ("symbol(", "SYMBOL"),
+        ("no-evaluators", "OPAQUE"),
+        ("priority(", "PRIORITY"),
+        ("simplification", "SIMPLIFICATION"),
+        ("concrete", "CONCRETE"),
+        ("macro-rec", "MACRO_REC"),
+        ("macro", "MACRO"),
+        ("owise", "OWISE"),
+        ("strict", "STRICT"),
+        ("seqstrict", "SEQSTRICT"),
+    ):
+        if attr in block:
+            tags.append(tag)
+    return tags
+
+
+records = []
+for path in FILES:
+    lines = path.read_text().splitlines()
+    i = 0
+    while i < len(lines):
+        match = START.match(lines[i])
+        if not match:
+            i += 1
+            continue
+        kind = match.group(1)
+        start = i
+        i += 1
+        while i < len(lines) and not STOP.match(lines[i]):
+            i += 1
+        block = "\n".join(lines[start:i]).rstrip()
+        records.append(
+            {
+                "file": str(path.relative_to(ROOT)),
+                "start": start + 1,
+                "end": i,
+                "kind": kind,
+                "tags": classify(path, kind, block),
+                "block": block,
+            }
+        )
+
+by_file = collections.Counter(record["file"] for record in records)
+by_kind = collections.Counter(record["kind"] for record in records)
+by_tag = collections.Counter(tag for record in records for tag in record["tags"])
+
+print("# Exhaustive K declaration and rule inventory")
+print()
+print("Generated by `evidence/k_inventory.py` from the fresh scratch source copy.")
+print("Each `syntax`, `configuration`, `context`, `rule`, and `claim` block is listed once.")
+print()
+print(f"Total inventoried blocks: {len(records)}")
+print()
+print("## Counts by kind")
+print()
+for key, value in sorted(by_kind.items()):
+    print(f"- `{key}`: {value}")
+print()
+print("## Counts by classification tag")
+print()
+for key, value in sorted(by_tag.items()):
+    print(f"- `{key}`: {value}")
+print()
+print("## Counts by file")
+print()
+for key, value in sorted(by_file.items()):
+    print(f"- `{key}`: {value}")
+print()
+print("## Complete inventory")
+for index, record in enumerate(records, 1):
+    loc = f"{record['file']}:{record['start']}"
+    if record["end"] > record["start"]:
+        loc += f"-{record['end']}"
+    print()
+    print(f"### K-{index:04d} — `{loc}`")
+    print()
+    print("Tags: " + ", ".join(f"`{tag}`" for tag in record["tags"]))
+    print()
+    print("```k")
+    print(record["block"])
+    print("```")
