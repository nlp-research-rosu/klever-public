+        [1, 2, 1],
+    ),
+    (
+        "prompt-example-2",
+        [[5, 9, 3], [4, 1, 6], [7, 8, 2]],
+        1,
+        [1],
+    ),
+    (
+        "symbolic-2x2-k4 with A=1,B=2,C=3,D=4",
+        [[1, 2], [3, 4]],
+        4,
+        [1, 2, 1, 2],
+    ),
