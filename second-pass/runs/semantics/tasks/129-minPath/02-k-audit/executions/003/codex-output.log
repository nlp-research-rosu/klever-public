  echo '"'"'$ kast --expression minPathProgram --definition verification-kompiled --module MINPATH-VERIFICATION --sort Module --expand-macros --output kast > /audit-output/evidence/claim-program-expanded.kast'"'
  kast --expression minPathProgram --definition verification-kompiled --module MINPATH-VERIFICATION --sort Module --expand-macros --output kast > /audit-output/evidence/claim-program-expanded.kast
  status="'$?
  echo "CLAIM_PROGRAM_KAST_EXIT_STATUS=$status"
  if [ "$status" -ne 0 ]; then exit "$status"; fi
  echo '"'"'$ cmp -s /audit-output/evidence/solution-expanded.kast /audit-output/evidence/claim-program-expanded.kast'"'
  cmp -s /audit-output/evidence/solution-expanded.kast /audit-output/evidence/claim-program-expanded.kast
  status="'$?
  echo "EXPANDED_KAST_CMP_EXIT_STATUS=$status"
  sha256sum /audit-output/evidence/solution-expanded.kast /audit-output/evidence/claim-program-expanded.kast
  echo '"'"'$ rg -o --pcre2 "[A-Za-z#][A-Za-z0-9#-]*(?='"\\\\()\" solution.mpy | sort | uniq -c'
  rg -o --pcre2 '[A-Za-z#][A-Za-z0-9#-]*(?=\\()' solution.mpy | sort | uniq -c
  exit \""'$status"
) 2>&1 | tee /audit-output/evidence/program-pinning.log
(
  echo '"'"'$ python3 /audit-output/evidence/claim_witnesses.py'"'
  python3 /audit-output/evidence/claim_witnesses.py
  status="'$?
  echo "EXIT_STATUS=$status"
  exit "$status"
) 2>&1 | tee /audit-output/evidence/claim-witnesses.log' in /tmp/audit-work/129-minPath
