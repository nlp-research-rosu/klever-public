@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: $0 LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+logfile=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$logfile"
+
+"$@" >> "$logfile" 2>&1
+status=$?
+
+printf 'EXIT_STATUS: %d\n' "$status" >> "$logfile"
+exit "$status"

exec
/bin/bash -lc 'cp spec-vacuity.k /audit-output/evidence/spec-vacuity.k && /audit-output/evidence/run_logged.sh /audit-output/evidence/stage6-vacuity-dry-run.log kprove spec-vacuity.k --definition verification-kompiled --spec-module MINPATH-SPEC-VACUITY --dry-run' in /tmp/audit-work/129-minPath-audit
diff --git a//tmp/audit-work/129-minPath-audit/pinning-driver.py b//tmp/audit-work/129-minPath-audit/pinning-driver.py
new file mode 100644
index 0000000000000000000000000000000000000000..51ee88358b1ef7d8c6647dacd645dbba0a311d8c
--- /dev/null
+++ b//tmp/audit-work/129-minPath-audit/pinning-driver.py
@@ -0,0 +1,45 @@
+def minPath(grid, k):
+    n = len(grid)
+    row = 0
+    column = 0
+
+    for i in range(n):
+        for j in range(n):
+            if grid[i][j] == 1:
+                row = i
+                column = j
+
+    neighbor = n * n + 1
+
+    if row > 0:
+        value = grid[row - 1][column]
+        if value < neighbor:
+            neighbor = value
+    if row + 1 < n:
+        value = grid[row + 1][column]
+        if value < neighbor:
+            neighbor = value
+    if column > 0:
+        value = grid[row][column - 1]
+        if value < neighbor:
+            neighbor = value
+    if column + 1 < n:
+        value = grid[row][column + 1]
+        if value < neighbor:
+            neighbor = value
+
+    path = []
+    for i in range(k):
+        if i % 2 == 0:
+            path.append(1)
+        else:
+            path.append(neighbor)
+
+    return path
+
+
+# One satisfying instance for each entry claim. The third instantiates
+# A=1, B=2, C=3, D=4 in the symbolic 2x2 claim.
+assert minPath([[1, 2, 3], [4, 5, 6], [7, 8, 9]], 3) == [1, 2, 1]
+assert minPath([[5, 9, 3], [4, 1, 6], [7, 8, 2]], 1) == [1]
+assert minPath([[1, 2], [3, 4]], 4) == [1, 2, 1, 2]
