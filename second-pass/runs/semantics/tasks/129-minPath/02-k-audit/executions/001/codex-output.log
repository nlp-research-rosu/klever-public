new file mode 100644
index 0000000000000000000000000000000000000000..da708c36ba90103b8a66b07ae10bec55efc1e7ee
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: $0 LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+logfile=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$logfile"
+
+"$@" >> "$logfile" 2>&1
+status=$?
+
+printf 'EXIT_STATUS: %d\n' "$status" >> "$logfile"
+exit "$status"

