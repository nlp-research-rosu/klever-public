+    add("documented-example", [[1, 2, 3], [4, 5, 6], [7, 8, 9]], 3, True)
+    add("documented-example", [[5, 9, 3], [4, 1, 6], [7, 8, 2]], 1, True)
+
+    # Explicit outside-contract probes: empty grid and non-positive path length.
