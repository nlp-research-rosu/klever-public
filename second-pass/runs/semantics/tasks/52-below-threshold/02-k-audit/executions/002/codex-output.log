+  /candidate/verification.k \
+  /candidate/spec.k \
+  /candidate/prove.sh
+do
+  check_regular "$path"
+done
+
+printf 'PROVENANCE_FAILURE_COUNT=%s\n' "$failures"
+exit "$failures"
