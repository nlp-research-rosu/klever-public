+assert not below_threshold([6], 5)
+assert not below_threshold([5, -100, -100], 5)
+assert not below_threshold([-100, -100, 5], 5)
+assert below_threshold([-4, -10], -3)
+assert below_threshold([-(10 ** 12), 10 ** 12 - 1], 10 ** 12)
diff --git a//tmp/audit-work/52-below-threshold/reviewer-spec-vacuity.k b//tmp/audit-work/52-below-threshold/reviewer-spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..e6755ec38cd92092dfccf72c05053888ab44f05d
--- /dev/null
+++ b//tmp/audit-work/52-below-threshold/reviewer-spec-vacuity.k
@@ -0,0 +1,24 @@
+requires "verification.k"
+
+module REVIEWER-SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false result mutation. For IS=.IntSeq and T=0, the real
+  // function and belowThresholdSpec both return true, while this requires false.
+  claim
+    <k> #belowThresholdCall(IS:IntSeq, T:Int)
+      => notBool belowThresholdSpec(IS, T)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
