     3	module VERIFICATION-BASE
     4	  imports MPY
     5	
     6	  // IntSeq gives the proof a genuinely typed inductive domain for the prompt's
     7	  // "list of numbers". intsToVals is a symbolic ValSeq constructor whose
     8	  // iterator equations below are exactly those of
     9	  // vCons(I1, ... vCons(In, .ValSeq)).
    10	  syntax ValSeq ::= intsToVals(IntSeq)
    11	
    12	  // The generic list iterator cannot narrow through a symbolic function
    13	  // application. These conservative cases expose one constructor of that
    14	  // typed representation; they add no behavior for ordinary ValSeq terms.
    15	  rule <k> #iterNext(list(intsToVals(.IntSeq))) => #iterDone ... </k>
    16	       [priority(40)]
    17	  rule <k> #iterNext(list(intsToVals(iCons(I:Int, REST:IntSeq))))
    18	        => #iterYield(I, list(intsToVals(REST))) ... </k>
    19	       [priority(40)]
    20	
    21	  // Mathematical contract: every element is strictly less than T.
    22	  syntax Bool ::= belowThresholdSpec(IntSeq, Int) [function, total]
    23	  rule belowThresholdSpec(.IntSeq, _:Int) => true
    24	  rule belowThresholdSpec(iCons(I:Int, REST:IntSeq), T:Int)
    25	    => (I <Int T) andBool belowThresholdSpec(REST, T)
    26	
    27	  // Exact translated function body from solution.mpy, factored only to keep
    28	  // the claims readable. These are macros, not replacement execution rules.
    29	  syntax Stmts ::= "belowThresholdLoopBody" [macro]
    30	  rule belowThresholdLoopBody
    31	    => If(Compare(Name("number"), CmpOp(">=", Name("t"))),
    32	          Return(Bool(false)),
    33	          .Stmts)
    34	
    35	  syntax Stmts ::= "belowThresholdBody" [macro]
    36	  rule belowThresholdBody
    37	    => Expr(Str(
    38	         "Return True if all numbers in the list l are below threshold t.\n    >>> below_threshold([1, 2, 4, 10], 100)\n    True\n    >>> below_threshold([1, 20, 4, 10], 5)\n    False\n    "))
    39	       For(Name("number"), Name("l"), belowThresholdLoopBody)
    40	       Return(Bool(true))
    41	
    42	  syntax KItem ::= #belowThresholdCall(IntSeq, Int) [macro]
    43	  rule #belowThresholdCall(IS:IntSeq, T:Int)
    44	    => Call(
    45	         closureVal(("l", "t", .ParamNames), belowThresholdBody, 0),
    46	         (list(intsToVals(IS)), T, .Exprs))
