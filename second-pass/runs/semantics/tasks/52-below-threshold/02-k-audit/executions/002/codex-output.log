.Map, parent(-1))\n+      -1 |-> builtinsScope\n+    </scopes>\n+    <scopeLoc> 1 </scopeLoc>\n+    <heap> .Map </heap>\n+    <heapLoc> 0 </heapLoc>\n+    <stack> .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+endmodule\n*** End Patch\n","internal_chat_message_metadata_passthrough":{"turn_id":"019f8d66-ccdc-7b10-9a7a-4bc1329bddc0"}}}
