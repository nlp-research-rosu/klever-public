--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,13 @@
+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+logfile="$1"
+shift
+quoted_command="$(printf '%q ' "$@")"
+script_command="printf '%s\n' 'COMMAND: $quoted_command'; $quoted_command; status=\$?; printf '%s\n' \"EXIT_STATUS=\$status\"; exit \$status"
+script -q -e -c "$script_command" "$logfile"
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..f363038322383581aa651a6f2fa4f23de31c8221
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,27 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: require the function to return the Boolean opposite of
+  // its mathematical result.  The empty-list witness satisfies the entry state,
+  // returns true, and makes this destination false.
+  claim
+    <k>
+      #belowThresholdCall(IS:IntSeq, T:Int)
+      => notBool belowThresholdSpec(IS, T)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(false-opposite-result)]
+endmodule
