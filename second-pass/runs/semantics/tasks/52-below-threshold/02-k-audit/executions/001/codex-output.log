/bin/bash -lc 'chmod +x /audit-output/evidence/differential_test.py /audit-output/evidence/translate_and_compare.sh && /audit-output/evidence/run_logged.sh /audit-output/evidence/translation-byte-identity.log bash /audit-output/evidence/translate_and_compare.sh && /audit-output/evidence/run_logged.sh /audit-output/evidence/differential-test.log python3 /audit-output/evidence/differential_test.py' in /audit-output
