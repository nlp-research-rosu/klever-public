diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..4b273dd5e1d5d7638b5585b8642275252bbba926
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,18 @@
+def below_threshold(l: list, t: int):
+    """Return True if all numbers in the list l are below threshold t.
+    >>> below_threshold([1, 2, 4, 10], 100)
+    True
+    >>> below_threshold([1, 20, 4, 10], 5)
+    False
+    """
+    for number in l:
+        if number >= t:
+            return False
+    return True
+
+
+assert below_threshold([1, 2, 4, 10], 100)
+assert not below_threshold([1, 20, 4, 10], 5)
+assert below_threshold([], 0)
+assert not below_threshold([5], 5)
+assert below_threshold([-3, -1], 0)
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..32046955de21f01f3752fb81b9c1d907ba626daa
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Translate the submitted implementation and the concrete assertion harness.
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
+
+# Exercise the implementation through the supplied concrete LLVM semantics.
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun concrete-tests.mpy \
+  --definition runtime-kompiled \
+  --output pretty
+
+# First prove the recursive loop invariant against unextended MPY.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION-BASE \
+  --syntax-module VERIFICATION-BASE \
+  --output-definition verification-base-kompiled
+kprove spec.k \
+  --definition verification-base-kompiled \
+  --spec-module LOOP-SPEC \
+  --output pretty
+
+# Then admit that proved invariant verbatim as a derived rule and prove the
+# complete translated function call against its mathematical contract.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --output pretty
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..17ef042a1ba7a8676279acb0c21f6eb0cf45f995
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def below_threshold(l: list, t: int):
+    """Return True if all numbers in the list l are below threshold t.
+    >>> below_threshold([1, 2, 4, 10], 100)
+    True
+    >>> below_threshold([1, 20, 4, 10], 5)
+    False
+    """
+    for number in l:
+        if number >= t:
+            return False
+    return True
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..865345ece6d8d26f392b6beaf54b76c8635c9973
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,66 @@
+requires "verification.k"
+
+module LOOP-SPEC
+  imports VERIFICATION-BASE
+
+  // Loop invariant/circularity. The function frame and return continuation are
+  // included so an early Return(false) and normal Return(true) are both proved.
+  claim
+    <k> #loop(list(intsToVals(IS:IntSeq)),
+              Name("number"),
+              belowThresholdLoopBody)
+         ~> (Return(Bool(true)) .Stmts)
+         ~> #endcall
+      => belowThresholdSpec(IS, T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      1 |-> scope(
+        "l"      |-> list(intsToVals(_ORIGINAL:IntSeq))
+        "number" |-> _OLD:Int
+        "t"      |-> T:Int,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> BUILTINS:Scope
+      =>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(loop-invariant)]
+
+endmodule
+
+module SPEC
+  imports VERIFICATION
+
+  // End-to-end entry-point claim, composed with the independently proved
+  // loop-invariant rule in VERIFICATION.
+  claim
+    <k> #belowThresholdCall(IS:IntSeq, T:Int)
+      => belowThresholdSpec(IS, T)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(entry-point)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..20a5e184d0e505976525bc795dac8c58d469ca89
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,88 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  // IntSeq gives the proof a genuinely typed inductive domain for the prompt's
+  // "list of numbers". intsToVals is a symbolic ValSeq constructor whose
+  // iterator equations below are exactly those of
+  // vCons(I1, ... vCons(In, .ValSeq)).
+  syntax ValSeq ::= intsToVals(IntSeq)
+
+  // The generic list iterator cannot narrow through a symbolic function
+  // application. These conservative cases expose one constructor of that
+  // typed representation; they add no behavior for ordinary ValSeq terms.
+  rule <k> #iterNext(list(intsToVals(.IntSeq))) => #iterDone ... </k>
+       [priority(40)]
+  rule <k> #iterNext(list(intsToVals(iCons(I:Int, REST:IntSeq))))
+        => #iterYield(I, list(intsToVals(REST))) ... </k>
+       [priority(40)]
+
+  // Mathematical contract: every element is strictly less than T.
+  syntax Bool ::= belowThresholdSpec(IntSeq, Int) [function, total]
+  rule belowThresholdSpec(.IntSeq, _:Int) => true
+  rule belowThresholdSpec(iCons(I:Int, REST:IntSeq), T:Int)
+    => (I <Int T) andBool belowThresholdSpec(REST, T)
+
+  // Exact translated function body from solution.mpy, factored only to keep
+  // the claims readable. These are macros, not replacement execution rules.
+  syntax Stmts ::= "belowThresholdLoopBody" [macro]
+  rule belowThresholdLoopBody
+    => If(Compare(Name("number"), CmpOp(">=", Name("t"))),
+          Return(Bool(false)),
+          .Stmts)
+
+  syntax Stmts ::= "belowThresholdBody" [macro]
+  rule belowThresholdBody
+    => Expr(Str(
+         "Return True if all numbers in the list l are below threshold t.\n    >>> below_threshold([1, 2, 4, 10], 100)\n    True\n    >>> below_threshold([1, 20, 4, 10], 5)\n    False\n    "))
+       For(Name("number"), Name("l"), belowThresholdLoopBody)
+       Return(Bool(true))
+
+  syntax KItem ::= #belowThresholdCall(IntSeq, Int) [macro]
+  rule #belowThresholdCall(IS:IntSeq, T:Int)
+    => Call(
+         closureVal(("l", "t", .ParamNames), belowThresholdBody, 0),
+         (list(intsToVals(IS)), T, .Exprs))
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  // Derived loop-summary rule. LOOP-SPEC proves this exact reachability
+  // property against VERIFICATION-BASE (which does not contain this rule);
+  // SPEC then uses it to compose the end-to-end call proof.
+  rule
+    <k> #loop(list(intsToVals(IS:IntSeq)),
+              Name("number"),
+              belowThresholdLoopBody)
+         ~> (Return(Bool(true)) .Stmts)
+         ~> #endcall
+      => belowThresholdSpec(IS, T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      1 |-> scope(
+        "l"      |-> list(intsToVals(_ORIGINAL:IntSeq))
+        "number" |-> _OLD:Int
+        "t"      |-> T:Int,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> BUILTINS:Scope
+      =>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(40)]
+endmodule

exec
/bin/bash -lc "bash -n prove.sh
python3 -m doctest solution.py
python3 py2mpy.py solution.py | cmp -s - solution.mpy
sha256sum prompt.py py2mpy.py solution.py solution.mpy verification.k spec.k prove.sh
find . -maxdepth 1 -type f -printf '%f\\n' | sort
rg -n '"'^'"\\s*claim|\\[label\\(' spec.k
