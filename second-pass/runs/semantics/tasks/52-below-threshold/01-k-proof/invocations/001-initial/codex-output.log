index 0000000000000000000000000000000000000000..005ea16405e2931c268777f7673487b152e10f49
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,54 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant/circularity. The function frame and return continuation are
+  // included so an early Return(false) and normal Return(true) are both proved.
+  claim
+    <k> #loop(list(intsToVals(IS:IntSeq)),
+              Name("number"),
+              belowThresholdLoopBody)
+         ~> Return(Bool(true))
+         ~> #endcall
+      => belowThresholdSpec(IS, T)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (1 |-> scope(("t" |-> T:Int) LOCAL:Map, parent(0)))
+      OUTER:Map
+      =>
+      OUTER
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool ("t" in_keys(LOCAL))
+     andBool notBool (1 in_keys(OUTER))
+
+  // End-to-end entry-point claim.
+  claim
+    <k> #belowThresholdCall(IS:IntSeq, T:Int)
+      => belowThresholdSpec(IS, T)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..fa334a9bd6b6bda4018c5550a5589afa2a898e84
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,49 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // IntSeq gives the proof a genuinely typed inductive domain for the prompt's
+  // "list of numbers". intsToVals is its exact embedding into Python lists.
+  syntax ValSeq ::= intsToVals(IntSeq)
+  rule intsToVals(.IntSeq) => .ValSeq [anywhere]
+  rule intsToVals(iCons(I:Int, REST:IntSeq))
+    => vCons(I, intsToVals(REST)) [anywhere]
+
+  // The generic list iterator cannot narrow through a symbolic function
+  // application. This conservative bridge exposes one constructor of the
+  // exact embedding above; it adds no behavior for ordinary ValSeq terms.
+  syntax KItem ::= #iterInts(IntSeq)
+  rule <k> #iterNext(list(intsToVals(IS:IntSeq))) => #iterInts(IS) ... </k>
+       [priority(40)]
+  rule <k> #iterInts(.IntSeq) => #iterDone ... </k>
+  rule <k> #iterInts(iCons(I:Int, REST:IntSeq))
+        => #iterYield(I, list(intsToVals(REST))) ... </k>
+
+  // Mathematical contract: every element is strictly less than T.
+  syntax Bool ::= belowThresholdSpec(IntSeq, Int) [function, total]
+  rule belowThresholdSpec(.IntSeq, _:Int) => true
+  rule belowThresholdSpec(iCons(I:Int, REST:IntSeq), T:Int)
+    => (I <Int T) andBool belowThresholdSpec(REST, T)
+
+  // Exact translated function body from solution.mpy, factored only to keep
+  // the claims readable. These are macros, not replacement execution rules.
+  syntax Stmts ::= "belowThresholdLoopBody" [macro]
+  rule belowThresholdLoopBody
+    => If(Compare(Name("number"), CmpOp(">=", Name("t"))),
+          Return(Bool(false)),
+          .Stmts)
+
+  syntax Stmts ::= "belowThresholdBody" [macro]
+  rule belowThresholdBody
+    => Expr(Str(
+         "Return True if all numbers in the list l are below threshold t.\n    >>> below_threshold([1, 2, 4, 10], 100)\n    True\n    >>> below_threshold([1, 20, 4, 10], 5)\n    False\n    "))
+       For(Name("number"), Name("l"), belowThresholdLoopBody)
+       Return(Bool(true))
+
+  syntax KItem ::= #belowThresholdCall(IntSeq, Int) [macro]
+  rule #belowThresholdCall(IS:IntSeq, T:Int)
+    => Call(
+         closureVal(("l", "t", .ParamNames), belowThresholdBody, 0),
+         (list(intsToVals(IS)), T, .Exprs))
+endmodule

apply patch
patch: completed
/work/verification.k
