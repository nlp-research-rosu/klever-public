Module(
  FuncDef("below_threshold", Params("l", "t"),
    Expr(
      Str(
        "Return True if all numbers in the list l are below threshold t.\n    >>> below_threshold([1, 2, 4, 10], 100)\n    True\n    >>> below_threshold([1, 20, 4, 10], 5)\n    False\n    "))
    For(Name("number"), Name("l"),
      If(Compare(Name("number"), CmpOp(">=", Name("t"))),
        Return(Bool(false)),
        ))
    Return(Bool(true)))
  Assert(
    Call(
      Name("below_threshold"),
      ListExpr(Int(1), Int(2), Int(4), Int(10)),
      Int(100)))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("below_threshold"),
        ListExpr(Int(1), Int(20), Int(4), Int(10)),
        Int(5))))
  Assert(Call(Name("below_threshold"), ListExpr(), Int(0)))
  Assert(
    UnaryOp(
      "not",
      Call(Name("below_threshold"), ListExpr(Int(5)), Int(5))))
  Assert(
    Call(
      Name("below_threshold"),
      ListExpr(UnaryOp("-", Int(3)), UnaryOp("-", Int(1))),
      Int(0))))
