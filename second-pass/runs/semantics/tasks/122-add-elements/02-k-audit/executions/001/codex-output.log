+printf 'CMP_EXIT_STATUS: %d\n' "$compare_status"
+
+printf 'COMMAND: sha256sum %q %q\n' "$regenerated_mpy" "$submitted_mpy"
+sha256sum "$regenerated_mpy" "$submitted_mpy"
+exit "$compare_status"
