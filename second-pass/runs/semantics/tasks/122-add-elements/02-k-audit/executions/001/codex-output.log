+assert add_elements([111, 21, 3, 4000, 5, 6, 7, 8, 9], 4) == 24
+assert add_elements([-101, -100, -99, -10, -9, 0, 9, 10, 99, 100, 101], 11) == 0
+assert add_elements([-99], 1) == -99
+assert add_elements([
