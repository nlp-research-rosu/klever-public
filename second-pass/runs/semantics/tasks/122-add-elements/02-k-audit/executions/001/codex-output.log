LOOP_WITNESS_JSON:
{"abs_not_shadowed": true, "acc": 0, "arr": [-99], "claimed_final_total": -99, "globals": {}, "k": 1, "loop_precondition": true, "old_element": 1234, "v": -99, "vs": []}
EXIT_STATUS: 0

