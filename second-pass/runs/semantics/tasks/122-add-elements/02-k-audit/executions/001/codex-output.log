diff --git a//tmp/audit-work/src/connection-foundation-spec.k b//tmp/audit-work/src/connection-foundation-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..70bb9c8923a84cf95c972f15d0a97e44efa8c8b0
--- /dev/null
+++ b//tmp/audit-work/src/connection-foundation-spec.k
@@ -0,0 +1,21 @@
+requires "connection-verification.k"
+
+module ADD-ELEMENTS-CONNECTION-FOUNDATION-SPEC
+  imports ADD-ELEMENTS-CONNECTION-VERIFICATION
+
+  claim [concat-length]:
+    <k>
+      vsLen(valSeqConcat(PREFIX:ValSeq, SUFFIX:ValSeq))
+      =>
