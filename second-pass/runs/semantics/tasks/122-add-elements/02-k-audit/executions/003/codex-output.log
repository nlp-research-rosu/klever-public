+          )
+        ),
+        0,
+        vsLen(vCons(1, vCons(2, .ValSeq))) +Int 1,
+        1
+      )
+      =>
+      vCons(0, vCons(1, vCons(2, .ValSeq)))
+      ...
+    </k>
+endmodule
