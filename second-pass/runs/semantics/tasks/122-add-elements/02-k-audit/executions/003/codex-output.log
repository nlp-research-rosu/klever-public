+shift
+
+exec > >(tee "$log_path") 2>&1
+
+printf 'COMMAND:'
+printf ' %q' "$@"
+printf '\n'
+
+"$@"
+status=$?
+
+printf 'EXIT_STATUS: %d\n' "$status"
+exit "$status"
