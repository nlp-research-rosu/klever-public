+requires "verification.k"
+
+module ADD-ELEMENTS-BODY-SENSITIVITY
+  imports ADD-ELEMENTS-VERIFICATION
+
+  // Material mutation: the executed closure uses < 99 instead of < 100.
+  // On the satisfying ground input [99], the original body returns 99 while
+  // this mutated body returns 0. Keeping the original result obligation must
+  // therefore be rejected.
+  claim
+    <k>
+      Call(
+        closureVal(
+          ("arr", "k", .ParamNames),
+          Assign(Name("total"), Int(0))
+          For(
+            Name("element"),
+            Subscript(
+              Name("arr"),
+              Slice(NoBound, Name("k"), NoBound)
+            ),
+            If(
+              Compare(
+                Call(Name("abs"), Name("element")),
+                CmpOp("<", Int(99))
+              ),
+              AugAssign(Name("total"), "+", Name("element")),
+              .Stmts
+            )
+          )
+          Return(Name("total"))
+          .Stmts,
+          0
+        ),
+        list(vCons(99, .ValSeq)),
+        1
+      )
+      =>
+      99
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(.Map, parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINALHEAP:Map </heap>
+    <heapLoc> 0 => ?FINALLOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
