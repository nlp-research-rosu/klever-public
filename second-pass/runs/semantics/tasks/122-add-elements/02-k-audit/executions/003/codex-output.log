+
+  claim <k> applyBin("+", 5, -99) => -94 ... </k>
+
+  claim
+    <k>
+      slAdjust(
+        vsLen(vCons(1, vCons(2, .ValSeq))) +Int 1,
+        vsLen(
+          valSeqConcat(
+            vCons(1, vCons(2, .ValSeq)),
+            vCons(3, .ValSeq)
+          )
+        ) +Int 1,
+        1
+      )
+      =>
+      3
+      ...
+    </k>
+
+  claim
+    <k>
+      buildVS(
+        vCons(
+          0,
+          valSeqConcat(
+            vCons(1, vCons(2, .ValSeq)),
+            vCons(3, vCons(4, .ValSeq))
+          )
+        ),
+        0,
+        vsLen(vCons(1, vCons(2, .ValSeq))) +Int 1,
+        1
+      )
+      =>
+      vCons(0, vCons(1, vCons(2, .ValSeq)))
+      ...
+    </k>
+endmodule
