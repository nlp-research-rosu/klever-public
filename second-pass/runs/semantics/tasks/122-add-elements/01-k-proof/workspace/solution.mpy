Module(
  FuncDef("add_elements", Params("arr", "k"),
    Assign(Name("total"), Int(0))
    For(Name("element"), Subscript(Name("arr"), Slice(NoBound, Name("k"), NoBound)),
      If(Compare(Call(Name("abs"), Name("element")), CmpOp("<", Int(100))),
        AugAssign(Name("total"), "+", Name("element")),
        ))
    Return(Name("total"))))
