Module(
  FuncDef("add_elements", Params("arr", "k"),
    Assign(Name("total"), Int(0))
    For(Name("element"), Subscript(Name("arr"), Slice(NoBound, Name("k"), NoBound)),
      If(Compare(Call(Name("abs"), Name("element")), CmpOp("<", Int(100))),
        AugAssign(Name("total"), "+", Name("element")),
        ))
    Return(Name("total")))
  Assert(
    Compare(
      Call(
        Name("add_elements"),
        ListExpr(
          Int(111),
          Int(21),
          Int(3),
          Int(4000),
          Int(5),
          Int(6),
          Int(7),
          Int(8),
          Int(9)),
        Int(4)),
      CmpOp("==", Int(24))))
  Assert(
    Compare(
      Call(
        Name("add_elements"),
        ListExpr(
          Int(1),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(100)),
          Int(99),
          Int(100)),
        Int(5)),
      CmpOp("==", Int(98))))
  Assert(
    Compare(
      Call(Name("add_elements"), ListExpr(Int(0)), Int(1)),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("add_elements"),
        ListExpr(UnaryOp("-", Int(99)), Int(999), Int(10)),
        Int(2)),
      CmpOp("==", UnaryOp("-", Int(99))))))
