+requires "verification.k"
+
+module ADD-ELEMENTS-SPEC
+  imports ADD-ELEMENTS-VERIFICATION
+
+  // Loop invariant: starting from ACC, iteration over any non-empty integer
+  // sequence adds precisely its qualifying elements and leaves the loop
+  // variable equal to the final element.
+  claim
+    <k>
+      #loop(
+        list(vCons(V:Val, VS:ValSeq)),
+        Name("element"),
+        If(
+          Compare(
+            Call(Name("abs"), Name("element")),
+            CmpOp("<", Int(100))
+          ),
+          AugAssign(Name("total"), "+", Name("element")),
+          .Stmts
+        )
+      ) => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(GLOBALS:Map, parent(-1))
+      1 |-> scope(
+        "arr" |-> ARR:Val
+        "k" |-> KARG:Int
+        "total" |-> ACC:Int
+        "element" |-> OLD:Val,
+        parent(0)
+      )
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(GLOBALS, parent(-1))
+      1 |-> scope(
+        "arr" |-> ARR
+        "k" |-> KARG
+        "total" |-> qualifyingSumAcc(ACC, vCons(V, VS))
+        "element" |-> ?FINAL:Val,
+        parent(0)
+      )
+    </scopes>
+    requires notBool "abs" in_keys(GLOBALS)
+     andBool isInt(V)
+     andBool intsOnly(VS)
+
+  // The reference slice builder returns exactly P when asked for the first
+  // vsLen(P) elements of P followed by an arbitrary suffix.
+  claim
+    <k>
+      buildVS(
+        valSeqConcat(PREFIX:ValSeq, SUFFIX:ValSeq),
+        0,
+        vsLen(PREFIX),
+        1
+      )
+      =>
+      PREFIX
+      ...
+    </k>
+endmodule
