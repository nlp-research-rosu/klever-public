+    => qualifyingSumAcc(A +Int intValue(V), R)
+    requires isInt(V) andBool absInt(intValue(V)) <Int 100
+  rule qualifyingSumAcc(A:Int, vCons(V:Val, R:ValSeq))
+    => qualifyingSumAcc(A, R)
+    requires isInt(V) andBool absInt(intValue(V)) >=Int 100
+
+  // Refined-type bridge: under the contract's integer-list predicate, these
+  // are exactly the existing MPY rules with the generated Int projection made
+  // explicit for a symbolically Val-sorted head.
+  rule applyBuiltin("abs", V:Val, .Vals)
+    => absInt(intValue(V))
+    requires isInt(V)
+    [simplification]
+  rule applyBin("+", A:Int, V:Val)
+    => A +Int intValue(V)
+    requires isInt(V)
+    [simplification]
+
+  syntax Int ::= lastInt(IntSeq) [function]
+  rule lastInt(iCons(I:Int, .IntSeq)) => I
+  rule lastInt(iCons(_:Int, iCons(J:Int, R:IntSeq)))
+    => lastInt(iCons(J, R))
+
+  // Symbolic map updates preserve ordinary lookup/key facts.  The concrete
+  // MAP hook already computes these cases; these simplifiers expose the same
+  // facts to the Haskell prover when the untouched map remainder is symbolic.
+  rule K:KItem in_keys(M:Map [ K <- V:KItem ])
+    => true [simplification]
+  rule K1:KItem in_keys(M:Map [ K2:KItem <- V:KItem ])
+    => K1 in_keys(M)
+    requires K1 =/=K K2
+    [simplification]
+  rule (M:Map [ K:KItem <- V:KItem ]) [ K ] => V
+    [simplification]
+  rule (M:Map [ K2:KItem <- V:KItem ]) [ K1:KItem ] => M [ K1 ]
+    requires K1 =/=K K2
+    [simplification]
+
+  // intVals is an injective embedding.  Exposing its constructor cases lets
+  // circular loop proofs recover the IntSeq tail chosen by list iteration.
+  rule {
+    intVals(IS:IntSeq)
+    #Equals
+    vCons(I:Int, intVals(R:IntSeq))
+  } => { IS #Equals iCons(I, R) } [simplification]
+  rule {
+    vCons(I:Int, intVals(R:IntSeq))
+    #Equals
+    intVals(IS:IntSeq)
+  } => { IS #Equals iCons(I, R) } [simplification]
+  rule { intVals(IS:IntSeq) #Equals .ValSeq }
+    => { IS #Equals .IntSeq } [simplification]
+  rule { .ValSeq #Equals intVals(IS:IntSeq) }
+    => { IS #Equals .IntSeq } [simplification]
+
+  // Symbolic copies of the supplied list/slice equations.  Marking the exact
+  // reference rules as simplifications lets the prover perform constructor
+  // induction on an otherwise opaque ValSeq variable.
+  rule valSeqConcat(.ValSeq, T:ValSeq) => T [simplification]
+  rule valSeqConcat(vCons(V:Val, R:ValSeq), T:ValSeq)
+    => vCons(V, valSeqConcat(R, T)) [simplification]
+  rule vsLen(.ValSeq) => 0 [simplification]
+  rule vsLen(vCons(_:Val, R:ValSeq)) => 1 +Int vsLen(R)
+       [simplification]
+  rule valSeqAt(vCons(V:Val, _:ValSeq), 0) => V [simplification]
+  rule valSeqAt(vCons(_:Val, R:ValSeq), I:Int)
+    => valSeqAt(R, I -Int 1)
+    requires I >Int 0
+    [simplification]
