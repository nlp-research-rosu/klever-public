diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..8630690cf723891d050cd04112f8bab7014d20b9
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,12 @@
+def add_elements(arr, k):
+    total = 0
+    for element in arr[:k]:
+        if abs(element) < 100:
+            total += element
+    return total
+
+
+assert add_elements([111, 21, 3, 4000, 5, 6, 7, 8, 9], 4) == 24
+assert add_elements([1, -2, -100, 99, 100], 5) == 98
+assert add_elements([0], 1) == 0
+assert add_elements([-99, 999, 10], 2) == -99
