diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f831c0f6d0fe0d0c0b35eaea1349db0bcef1b9ef
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,49 @@
+requires "verification.k"
+
+module ADD-ELEMENTS-SPEC
+  imports ADD-ELEMENTS-VERIFICATION
+
+  // Loop invariant: starting from ACC, iteration over any non-empty integer
+  // sequence adds precisely its qualifying elements and leaves the loop
+  // variable equal to the final element.
+  claim
+    <k>
+      #loop(
+        list(vCons(I:Int, VS:ValSeq)),
+        Name("element"),
+        If(
+          Compare(
+            Call(Name("abs"), Name("element")),
+            CmpOp("<", Int(100))
+          ),
+          AugAssign(Name("total"), "+", Name("element")),
+          .Stmts
+        )
+      ) => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(GLOBALS:Map, parent(-1))
+      1 |-> scope(
+        "arr" |-> ARR:Val
+        "k" |-> KARG:Int
+        "total" |-> ACC:Int
+        "element" |-> OLD:Int,
+        parent(0)
+      )
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(GLOBALS, parent(-1))
+      1 |-> scope(
+        "arr" |-> ARR
+        "k" |-> KARG
+        "total" |-> qualifyingSumAcc(ACC, vCons(I, VS))
+        "element" |-> ?FINAL:Int,
+        parent(0)
+      )
+    </scopes>
+    requires notBool "abs" in_keys(GLOBALS)
+     andBool intsOnly(VS)
+endmodule
