+         vCons(HEAD:Val, valSeqConcat(PREFIX:ValSeq, SUFFIX:ValSeq)),
+         0,
+         1 +Int vsLen(PREFIX),
+         1
+       )
+    => vCons(HEAD, PREFIX)
+    [simplification]
+endmodule

exec
