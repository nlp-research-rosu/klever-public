+         vsLen(valSeqConcat(PREFIX, SUFFIX:ValSeq)) +Int 1,
+         1
+       )
+    => vsLen(PREFIX) +Int 1
+    [simplification]
+  rule buildVS(
+         vCons(HEAD:Val, valSeqConcat(PREFIX:ValSeq, SUFFIX:ValSeq)),
+         0,
+         vsLen(PREFIX) +Int 1,
+         1
+       )
+    => vCons(HEAD, PREFIX)
+    [simplification]
+endmodule

