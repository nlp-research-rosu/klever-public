new file mode 100644
index 0000000000000000000000000000000000000000..c3d8ebccf3650bb1a35f4cdf4a9c221d364a81c9
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,48 @@
+requires "verification.k"
+
+module ADD-ELEMENTS-SPEC
+  imports ADD-ELEMENTS-VERIFICATION
+
+  // Loop invariant: starting from ACC, iteration over any non-empty integer
+  // sequence adds precisely its qualifying elements and leaves the loop
+  // variable equal to the final element.
+  claim
+    <k>
+      #loop(
+        list(intVals(iCons(I:Int, IS:IntSeq))),
+        Name("element"),
+        If(
+          Compare(
+            Call(Name("abs"), Name("element")),
+            CmpOp("<", Int(100))
+          ),
+          AugAssign(Name("total"), "+", Name("element")),
+          .Stmts
+        )
+      ) => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(GLOBALS:Map, parent(-1))
+      1 |-> scope(
+        "arr" |-> ARR:Val
+        "k" |-> KARG:Int
+        "total" |-> ACC:Int
+        "element" |-> OLD:Int,
+        parent(0)
+      )
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(GLOBALS, parent(-1))
+      1 |-> scope(
+        "arr" |-> ARR
+        "k" |-> KARG
+        "total" |-> ACC +Int qualifyingSum(iCons(I, IS))
+        "element" |-> ?FINAL:Int,
+        parent(0)
+      )
+    </scopes>
+    requires notBool "abs" in_keys(GLOBALS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2293012c6ac0c38eed14232d25710f19cfb7cb65
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,41 @@
+requires "reference-semantics/semantics.k"
+
+module ADD-ELEMENTS-VERIFICATION
+  imports MPY
+
+  // Embed mathematical integer sequences as Python value sequences.
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  rule intVals(.IntSeq)                => .ValSeq
+  rule intVals(iCons(I:Int, R:IntSeq)) => vCons(I, intVals(R))
+
+  // The contract's sum: a sign is not a digit, so exactly the integers whose
+  // absolute value is below 100 contribute.
+  syntax Int ::= qualifyingSum(IntSeq) [function, total]
+  rule qualifyingSum(.IntSeq) => 0
+  rule qualifyingSum(iCons(I:Int, R:IntSeq))
+    => I +Int qualifyingSum(R)
+    requires absInt(I) <Int 100
+  rule qualifyingSum(iCons(I:Int, R:IntSeq))
+    => qualifyingSum(R)
+    requires absInt(I) >=Int 100
+
+  syntax Int ::= lastInt(IntSeq) [function]
+  rule lastInt(iCons(I:Int, .IntSeq)) => I
+  rule lastInt(iCons(_:Int, iCons(J:Int, R:IntSeq)))
+    => lastInt(iCons(J, R))
+
+  // Symbolic map updates preserve ordinary lookup/key facts.  The concrete
+  // MAP hook already computes these cases; these simplifiers expose the same
+  // facts to the Haskell prover when the untouched map remainder is symbolic.
+  rule K:KItem in_keys(M:Map [ K <- V:KItem ])
+    => true [simplification]
+  rule K1:KItem in_keys(M:Map [ K2:KItem <- V:KItem ])
+    => K1 in_keys(M)
+    requires K1 =/=K K2
+    [simplification]
+  rule (M:Map [ K:KItem <- V:KItem ]) [ K ] => V
+    [simplification]
+  rule (M:Map [ K2:KItem <- V:KItem ]) [ K1:KItem ] => M [ K1 ]
+    requires K1 =/=K K2
+    [simplification]
+endmodule

