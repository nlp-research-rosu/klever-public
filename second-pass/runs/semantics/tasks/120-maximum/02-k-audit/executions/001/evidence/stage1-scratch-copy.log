COMMAND: bash -c $'set -euo pipefail\nscratch=/tmp/audit-work/120-maximum\ncandidate_copy="$scratch/candidate-source"\ntrusted_copy="$scratch/trusted"\ntest ! -e "$scratch"\nmkdir -p "$candidate_copy" "$trusted_copy"\ncp -a --no-preserve=ownership /candidate/prompt.py /candidate/py2mpy.py /candidate/solution.py /candidate/solution.mpy /candidate/spec.k /candidate/verification.k /candidate/prove.sh /candidate/prove.log /candidate/concrete-tests.py /candidate/concrete-tests.mpy "$candidate_copy/"\ncp -a --no-preserve=ownership /candidate/reference-semantics "$candidate_copy/"\ncp -a --no-preserve=ownership /reference/canonical.py /reference/prompt.py /reference/py2mpy.py "$trusted_copy/"\ncp -a --no-preserve=ownership /reference/reference-semantics "$trusted_copy/"'
WORKING_DIRECTORY: /audit-output
OUTPUT_BEGIN
OUTPUT_END
EXIT_STATUS: 0
