+requires "reference-semantics/semantics.k"
+
+module MAXIMUM-VERIFICATION
+  imports MPY
+
+  // Reviewer body-sensitivity mutation: the k>0 return is deliberately wrong.
+  syntax Stmts ::= "maximumBody" [macro]
+  rule maximumBody
+    => If(Compare(Name("k"), CmpOp("==", Int(0))),
+          Return(ListExpr(.Exprs)) .Stmts,
+          .Stmts)
+       Return(ListExpr(.Exprs))
+       .Stmts
+
+  rule vsLen(sortVS(VS:ValSeq)) => vsLen(VS) [simplification]
+endmodule
diff --git a/evidence/stage6-mutation-witness.py b/evidence/stage6-mutation-witness.py
new file mode 100644
index 0000000000000000000000000000000000000000..e7dbc702ca0ab76e7fb19051ff83f659e35377fa
--- /dev/null
+++ b/evidence/stage6-mutation-witness.py
@@ -0,0 +1,18 @@
+#!/usr/bin/env python3
+
+arr = [-3, -4, 5]
+k = 2
+ordered = sorted(arr)
+true_result = ordered[len(arr) - k :]
+mutated_result = ordered[1 + len(arr) - k :]
+
+print(f"arr={arr}")
+print(f"k={k}")
+print(f"precondition={0 < k <= len(arr)}")
+print(f"true_start={len(arr) - k}")
+print(f"mutated_start={1 + len(arr) - k}")
+print(f"true_result={true_result}")
+print(f"mutated_result={mutated_result}")
+print(f"mutation_is_false={true_result != mutated_result}")
+
+raise SystemExit(0 if 0 < k <= len(arr) and true_result != mutated_result else 1)
