index 0000000000000000000000000000000000000000..1eb536715deebf337eee3af523d3385c8d1bbfdf
--- /dev/null
+++ b/evidence/stage3-spec-k0.k
@@ -0,0 +1,24 @@
+requires "verification.k"
+
+module AUDIT-SPEC-K0
+  imports MAXIMUM-VERIFICATION
+
+  claim [audit-k-zero]:
+    <k>
+      Call(Name("maximum"), list(VS:ValSeq), 0, .Exprs)
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+               "maximum" |-> closureVal(("arr", "k", .ParamNames), maximumBody, 0),
+               parent(-1))
+      -1 |-> builtinsScope
