+  claim [audit-false-off-by-one-result]:
+    <k>
+      Call(Name("maximum"), list(VS:ValSeq), K:Int, .Exprs)
+      => ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+               "maximum" |-> closureVal(("arr", "k", .ParamNames), maximumBody, 0),
+               parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => (0 |-> list(sortVS(VS)))
+         (1 |-> list(
