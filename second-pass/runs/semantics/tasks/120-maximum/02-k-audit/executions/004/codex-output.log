           buildVS(
             sortVS(VS),
             0 -Int K +Int vsLen(VS),
             vsLen(VS),
             1)))
    </heap>
    <heapLoc> 0 => 2 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    requires 0 <Int K andBool K <=Int vsLen(VS)
endmodule
