+#!/usr/bin/env bash
+set -uo pipefail
+
+WORK=/tmp/audit-work/maximum-120-audit
+status=0
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
