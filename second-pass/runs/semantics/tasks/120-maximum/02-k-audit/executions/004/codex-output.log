+      sortVS(vCons(-3, vCons(5, .ValSeq))),
+      1,
+      2,
+      1)
+    => vCons(5, .ValSeq)
+
+  // A second endpoint witness uses K = len(VS) = 2.
+  claim
+    buildVS(
+      sortVS(vCons(-3, vCons(5, .ValSeq))),
+      0,
+      2,
+      1)
+    => vCons(-3, vCons(5, .ValSeq))
+endmodule
