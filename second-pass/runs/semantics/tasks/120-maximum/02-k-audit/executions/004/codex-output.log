+         (1 |-> list(
+           buildVS(
+             sortVS(VS),
+             1 -Int K +Int vsLen(VS),
+             vsLen(VS),
+             1)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
