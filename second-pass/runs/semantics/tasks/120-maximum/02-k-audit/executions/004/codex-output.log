def maximum(arr, k):
    """
    Given an array arr of integers and a positive integer k, return a sorted list 
    of length k with the maximum k numbers in arr.

    Example 1:

        Input: arr = [-3, -4, 5], k = 3
        Output: [-4, -3, 5]

    Example 2:

        Input: arr = [4, -4, 4], k = 2
        Output: [4, 4]

    Example 3:

        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1
        Output: [2]

    Note:
        1. The length of the array will be in the range of [1, 1000].
        2. The elements in the array will be in the range of [-1000, 1000].
        3. 0 <= k <= len(arr)
    """
# canonical.py — the UNMODIFIED HumanEval/120 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: maximum


def maximum(arr, k):
    """
    Given an array arr of integers and a positive integer k, return a sorted list 
    of length k with the maximum k numbers in arr.

    Example 1:

        Input: arr = [-3, -4, 5], k = 3
        Output: [-4, -3, 5]

    Example 2:

        Input: arr = [4, -4, 4], k = 2
        Output: [4, 4]

    Example 3:

        Input: arr = [-3, 2, 1, 2, -1, -2, 1], k = 1
        Output: [2]

    Note:
        1. The length of the array will be in the range of [1, 1000].
        2. The elements in the array will be in the range of [-1000, 1000].
        3. 0 <= k <= len(arr)
    """
    if k == 0:
        return []
    arr.sort()
    ans = arr[-k:]
    return ans
def maximum(arr, k):
    if k == 0:
        return []
    return sorted(arr)[-k:]
Module(
  FuncDef("maximum", Params("arr", "k"),
    If(Compare(Name("k"), CmpOp("==", Int(0))),
      Return(ListExpr()),
      )
    Return(
      Subscript(
        Call(Name("sorted"), Name("arr")),
        Slice(UnaryOp("-", Name("k")), NoBound, NoBound)))))
requires "reference-semantics/semantics.k"

module MAXIMUM-VERIFICATION
  imports MPY

  // The generated body of solution.mpy, named once so the proof claims use
  // exactly the program that concrete execution parses.
  syntax Stmts ::= "maximumBody" [macro]
  rule maximumBody
    => If(Compare(Name("k"), CmpOp("==", Int(0))),
          Return(ListExpr(.Exprs)) .Stmts,
          .Stmts)
       Return(
         Subscript(
           Call(Name("sorted"), Name("arr"), .Exprs),
           Slice(UnaryOp("-", Name("k")), NoBound, NoBound)))
       .Stmts

  // sorted() is the supplied trusted ascending permutation.  Its symbolic
  // constructor is opaque, so expose the one extensional fact needed to
  // normalize Python's negative slice bound.
  rule vsLen(sortVS(VS:ValSeq)) => vsLen(VS) [simplification]
endmodule
requires "verification.k"

module MAXIMUM-SPEC
  imports MAXIMUM-VERIFICATION

  // The k = 0 branch is essential: sorted(arr)[-0:] would incorrectly return
  // the entire array.
  claim
    <k>
      Call(Name("maximum"), list(VS:ValSeq), 0, .Exprs)
      => ref(0)
    </k>
    <env> 0 </env>
    <scopes>
      0  |-> scope(
