+    done
+  done
+'
+
+printf '\nStructured trace validation and complete event inventory:\n'
+run bash -c '
+  trace=$(find /generation-evidence/codex-trace -type f -name "*.jsonl" -print -quit)
+  jq -c . "$trace" >/dev/null
+  jq -r ".type" "$trace" | sort | uniq -c
+  jq -r "select(.type == \"response_item\") | .payload.type" "$trace" | sort | uniq -c
+  jq -r "select(.type == \"response_item\" and .payload.type == \"function_call\") | [.payload.name,.payload.arguments] | @tsv" "$trace"
+'
+
+printf '\nGeneration-text records were scanned in full; salient proof claims:\n'
+run wc -l -c \
+  /generation-evidence/codex-last.txt /generation-evidence/codex-output.log \
+  /generation-evidence/prompt.txt /generation-evidence/codex-trace/2026/07/23/*.jsonl
+run rg -n 'KPROVE_PASSED|#Top|maximumBody|vsLen\\(sortVS|RESULT:' \
