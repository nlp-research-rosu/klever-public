Module(
  FuncDef("maximum", Params("arr", "k"),
    If(Compare(Name("k"), CmpOp("==", Int(0))),
      Return(ListExpr()),
      )
    Return(
      Subscript(
        Call(Name("sorted"), Name("arr")),
        Slice(UnaryOp("-", Name("k")), NoBound, NoBound))))
  Assert(
    Compare(
      Call(
        Name("maximum"),
        ListExpr(UnaryOp("-", Int(3)), UnaryOp("-", Int(4)), Int(5)),
        Int(3)),
      CmpOp(
        "==",
        ListExpr(UnaryOp("-", Int(4)), UnaryOp("-", Int(3)), Int(5)))))
  Assert(
    Compare(
      Call(
        Name("maximum"),
        ListExpr(Int(4), UnaryOp("-", Int(4)), Int(4)),
        Int(2)),
      CmpOp("==", ListExpr(Int(4), Int(4)))))
  Assert(
    Compare(
      Call(
        Name("maximum"),
        ListExpr(
          UnaryOp("-", Int(3)),
          Int(2),
          Int(1),
          Int(2),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(2)),
          Int(1)),
        Int(1)),
      CmpOp("==", ListExpr(Int(2)))))
  Assert(
    Compare(
      Call(Name("maximum"), ListExpr(Int(1), Int(2), Int(3)), Int(0)),
      CmpOp("==", ListExpr()))))
