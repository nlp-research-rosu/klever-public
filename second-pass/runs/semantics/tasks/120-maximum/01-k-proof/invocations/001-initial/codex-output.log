+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete-tests.mpy --definition runtime-kompiled
+
+kompile verification.k \
+  --backend haskell \
+  --main-module MAXIMUM-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module MAXIMUM-SPEC
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..3bf38936e49fc71bb58ca71cf25e3d37df738a8e
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,4 @@
+def maximum(arr, k):
+    if k == 0:
+        return []
+    return sorted(arr)[-k:]
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9f25322df626e9bc139be9861a8d9675fabd438c
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,57 @@
+requires "verification.k"
+
+module MAXIMUM-SPEC
+  imports MAXIMUM-VERIFICATION
+
+  // The k = 0 branch is essential: sorted(arr)[-0:] would incorrectly return
+  // the entire array.
+  claim
+    <k>
+      Call(Name("maximum"), list(VS:ValSeq), 0, .Exprs)
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+               "maximum" |-> closureVal(("arr", "k", .ParamNames), maximumBody, 0),
+               parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
+  // For 0 < k <= len(arr), the returned heap object is exactly the suffix of
+  // length k of the supplied ascending sorted permutation.
+  claim
+    <k>
+      Call(Name("maximum"), list(VS:ValSeq), K:Int, .Exprs)
+      => ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+               "maximum" |-> closureVal(("arr", "k", .ParamNames), maximumBody, 0),
+               parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => (0 |-> list(sortVS(VS)))
+         (1 |-> list(
+           buildVS(
+             sortVS(VS),
+             0 -Int K +Int vsLen(VS),
+             vsLen(VS),
+             1)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires 0 <Int K andBool K <=Int vsLen(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4adf7d5ddded00c998535de156a3dd9b4c1144a5
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,23 @@
+requires "reference-semantics/semantics.k"
+
+module MAXIMUM-VERIFICATION
+  imports MPY
+
+  // The generated body of solution.mpy, named once so the proof claims use
+  // exactly the program that concrete execution parses.
+  syntax Stmts ::= "maximumBody" [macro]
+  rule maximumBody
+    => If(Compare(Name("k"), CmpOp("==", Int(0))),
+          Return(ListExpr(.Exprs)) .Stmts,
+          .Stmts)
+       Return(
+         Subscript(
+           Call(Name("sorted"), Name("arr"), .Exprs),
+           Slice(UnaryOp("-", Name("k")), NoBound, NoBound)))
+       .Stmts
+
+  // sorted() is the supplied trusted ascending permutation.  Its symbolic
+  // constructor is opaque, so expose the one extensional fact needed to
+  // normalize Python's negative slice bound.
+  rule vsLen(sortVS(VS:ValSeq)) => vsLen(VS) [simplification]
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..fbcf460861dea858126668343c2162e2510077ee
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,10 @@
+def maximum(arr, k):
+    if k == 0:
+        return []
+    return sorted(arr)[-k:]
+
+
+assert maximum([-3, -4, 5], 3) == [-4, -3, 5]
+assert maximum([4, -4, 4], 2) == [4, 4]
+assert maximum([-3, 2, 1, 2, -1, -2, 1], 1) == [2]
+assert maximum([1, 2, 3], 0) == []
