+++ b/spec.k
@@ -0,0 +1,53 @@
+requires "verification.k"
+
+module MAXIMUM-SPEC
+  imports MAXIMUM-VERIFICATION
+
+  // The k = 0 branch is essential: sorted(arr)[-0:] would incorrectly return
+  // the entire array.
+  claim
+    <k>
+      Call(Name("maximum"), list(VS:ValSeq), 0)
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+               "maximum" |-> closureVal(("arr", "k"), maximumBody, 0),
+               parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
+  // For 0 < k <= len(arr), the returned heap object is exactly the suffix of
+  // length k of the supplied ascending sorted permutation.
+  claim
+    <k>
+      Call(Name("maximum"), list(VS:ValSeq), K:Int)
+      => ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+               "maximum" |-> closureVal(("arr", "k"), maximumBody, 0),
+               parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => (0 |-> list(sortVS(VS)))
+         (1 |-> list(
+           buildVS(sortVS(VS), vsLen(VS) -Int K, vsLen(VS), 1)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires 0 <Int K andBool K <=Int vsLen(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..eb39d6bbb3749d96e71a3658fddd49216f3ee09c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,24 @@
+requires "reference-semantics/semantics.k"
+
+module MAXIMUM-VERIFICATION
+  imports MPY
+
+  // The generated body of solution.mpy, named once so the proof claims use
+  // exactly the program that concrete execution parses.
+  syntax Stmts ::= "maximumBody"
+  rule maximumBody
+    => If(Compare(Name("k"), CmpOp("==", Int(0))),
+          Return(ListExpr()),
+          .Stmts)
+       Return(
+         Subscript(
+           Call(Name("sorted"), Name("arr")),
+           Slice(UnaryOp("-", Name("k")), NoBound, NoBound)))
+       .Stmts
+    [macro]
+
+  // sorted() is the supplied trusted ascending permutation.  Its symbolic
+  // constructor is opaque, so expose the one extensional fact needed to
+  // normalize Python's negative slice bound.
+  rule vsLen(sortVS(VS:ValSeq)) => vsLen(VS) [simplification]
+endmodule

