codex
I found the toolchain issue: this Lean build resolves its executable through `/proc/<numeric-pid>/exe`, while the managed runtime exposes only `/proc/self/exe`; that makes Lean’s `IO.appPath` fail before elaboration. I’ll use a temporary preload shim that redirects only that self-executable lookup, leaving the pinned toolchain and project files unchanged, then rerun the required build.
apply patch
patch: completed
/tmp/lean-readlink-fix.c
diff --git a//tmp/lean-readlink-fix.c b//tmp/lean-readlink-fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..55fa03f658474d55c7cf4d555fdf651a2bf00243
--- /dev/null
+++ b//tmp/lean-readlink-fix.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+    static readlink_fn real_readlink;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+
+    const size_t length = strlen(path);
+    if (strncmp(path, "/proc/", 6) == 0 &&
+        length >= 4 &&
+        strcmp(path + length - 4, "/exe") == 0) {
+        return real_readlink("/proc/self/exe", buf, size);
+    }
+    return real_readlink(path, buf, size);
+}
