+example : toInts (Proof.sortVS (ofInts [4, -4, 4])) = [-4, 4, 4] := rfl
+example : toInts (Proof.sortVS (ofInts [3, 2, 1, 0, -1])) = [-1, 0, 1, 2, 3] := rfl
