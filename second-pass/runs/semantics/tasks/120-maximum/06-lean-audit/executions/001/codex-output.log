+  | .«.ValSeq_MPY-CORE_ValSeq» => []
+  | .«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» (.inj_SortInt head) tail =>
+      head :: toInts tail
+  | .«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ tail =>
+      toInts tail
