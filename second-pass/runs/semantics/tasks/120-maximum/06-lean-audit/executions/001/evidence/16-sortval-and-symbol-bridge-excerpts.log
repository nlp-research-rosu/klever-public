/reference/k-proof/reference-semantics/semantics/core.k-10-  imports K-EQUAL
/reference/k-proof/reference-semantics/semantics/core.k-11-
/reference/k-proof/reference-semantics/semantics/core.k-12-  // ==== values, the algebraic lists, and the scope heap =====================
/reference/k-proof/reference-semantics/semantics/core.k-13-  syntax IntSeq ::= ".IntSeq" | iCons(Int, IntSeq)
/reference/k-proof/reference-semantics/semantics/core.k-14-  syntax ValSeq ::= ".ValSeq" | vCons(Val, ValSeq)
/reference/k-proof/reference-semantics/semantics/core.k:15:  syntax Str    ::= str(IntSeq)
/reference/k-proof/reference-semantics/semantics/core.k-16-
/reference/k-proof/reference-semantics/semantics/core.k-17-  // the iterable values, grouped under one sort (typing only — dispatch is <k>-cell)
/reference/k-proof/reference-semantics/semantics/core.k-18-  syntax Iterable ::= list(ValSeq)
/reference/k-proof/reference-semantics/semantics/core.k-19-                    | tuple(ValSeq)
/reference/k-proof/reference-semantics/semantics/core.k-20-                    | Str
--
/reference/k-proof/reference-semantics/semantics/core.k-218-  rule vals2valSeq(.Vals)            => .ValSeq
/reference/k-proof/reference-semantics/semantics/core.k-219-  rule vals2valSeq((V:Val, VS:Vals)) => vCons(V, vals2valSeq(VS))
/reference/k-proof/reference-semantics/semantics/core.k-220-
/reference/k-proof/reference-semantics/semantics/core.k-221-  // ==== shared sequence length (len / summaries across many modules) ========
/reference/k-proof/reference-semantics/semantics/core.k-222-  // (positional access valSeqAt/intSeqAt + normIdx live in subscript.k)
/reference/k-proof/reference-semantics/semantics/core.k:223:  syntax Int ::= vsLen(ValSeq) [function, total]
/reference/k-proof/reference-semantics/semantics/core.k:224:  rule vsLen(.ValSeq)                => 0
/reference/k-proof/reference-semantics/semantics/core.k:225:  rule vsLen(vCons(_:Val, S:ValSeq)) => 1 +Int vsLen(S)
/reference/k-proof/reference-semantics/semantics/core.k-226-
/reference/k-proof/reference-semantics/semantics/core.k-227-  syntax Int ::= isLen(IntSeq) [function, total]
/reference/k-proof/reference-semantics/semantics/core.k-228-  rule isLen(.IntSeq)                => 0
/reference/k-proof/reference-semantics/semantics/core.k-229-  rule isLen(iCons(_:Int, S:IntSeq)) => 1 +Int isLen(S)
/reference/k-proof/reference-semantics/semantics/core.k-230-
