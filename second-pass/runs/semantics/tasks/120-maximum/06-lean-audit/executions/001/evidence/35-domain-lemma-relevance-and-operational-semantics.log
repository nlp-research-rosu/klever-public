    27	  // For 0 < k <= len(arr), the returned heap object is exactly the suffix of
    28	  // length k of the supplied ascending sorted permutation.
    29	  claim
    30	    <k>
    31	      Call(Name("maximum"), list(VS:ValSeq), K:Int, .Exprs)
    32	      => ref(1)
    33	    </k>
    34	    <env> 0 </env>
    35	    <scopes>
    36	      0  |-> scope(
    37	               "maximum" |-> closureVal(("arr", "k", .ParamNames), maximumBody, 0),
    38	               parent(-1))
    39	      -1 |-> builtinsScope
    40	    </scopes>
    41	    <scopeLoc> 1 </scopeLoc>
    42	    <heap>
    43	      .Map
    44	      => (0 |-> list(sortVS(VS)))
    45	         (1 |-> list(
    46	           buildVS(
    47	             sortVS(VS),
    48	             0 -Int K +Int vsLen(VS),
    49	             vsLen(VS),
    50	             1)))
    51	    </heap>
    52	    <heapLoc> 0 => 2 </heapLoc>
    53	    <stack> .List </stack>
    54	    <ret> noRet </ret>
    55	    <exc> NoExc </exc>
    56	    requires 0 <Int K andBool K <=Int vsLen(VS)
    57	endmodule
