+            low, high = high, low
+        if high - low < best_high - best_low:
+            best_low = low
+            best_high = high
+
+        j += 1
+        if j == len(numbers):
+            i += 1
+            j = i + 1
+        low = best_low
+        high = best_high
+
+    return (best_low, best_high)
