+from typing import List, Tuple
+
+
+def find_closest_elements(numbers: List[float]) -> Tuple[float, float]:
+    """Return a closest pair, ordered from smaller to larger."""
+    best_low = numbers[0]
+    best_high = numbers[1]
+    if best_low > best_high:
+        best_low, best_high = best_high, best_low
+
+    i = 0
+    j = 1
+    while i < len(numbers) - 1:
+        low = numbers[i]
+        high = numbers[j]
+        if low > high:
+            low, high = high, low
+        if high - low < best_high - best_low:
+            best_low = low
+            best_high = high
+
+        j += 1
+        if j == len(numbers):
+            i += 1
+            j = i + 1
+
+    return (best_low, best_high)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..697f1d1c148d4d1d43e291bdc8accbd220c0690f
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,64 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal loop invariant.  This claim is proved first and is then used as
+  // a proved circularity (via --trusted closest-loop) for the entry-point
+  // theorem.  Its precondition is precisely the reachable index invariant.
+  claim [closest-loop]:
+    <k>
+      While(findClosestLoopCondition, findClosestLoopBody) ~> K:K
+      => K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      (L |-> scope(
+        M:Map
+        => M
+          [ "i"         <- vsLen(VS) -Int 1 ]
+          [ "j"         <- vsLen(VS) ]
+          [ "best_low"  <- pairLow(scanPairs(
+                              VS, I, J, pairState(BL, BH))) ]
+          [ "best_high" <- pairHigh(scanPairs(
+                              VS, I, J, pairState(BL, BH))) ]
+          [ "low"       <- pairLow(lastOrderedPair(VS)) ]
+          [ "high"      <- pairHigh(lastOrderedPair(VS)) ],
+        P:Parent))
+    </scopes>
+    requires {M["numbers"]}:>Val ==K list(VS)
+     andBool {M["i"]}:>Val ==K I
+     andBool {M["j"]}:>Val ==K J
+     andBool {M["best_low"]}:>Val ==K BL
+     andBool {M["best_high"]}:>Val ==K BH
+     andBool 0 <=Int I
+     andBool I <Int J
+     andBool J <Int vsLen(VS)
+     andBool I <Int vsLen(VS) -Int 1
+
+  // For every float list of length at least two, executing the actual
+  // translated entry point returns the exhaustive scan specification.
+  claim [entry-point]:
+    <k>
+      #applyK(
+        toCall(closureVal(("numbers", .ParamNames), findClosestBody, 0)),
+        (list(VS), .Vals))
+      => pairTuple(scanPairs(
+           VS, 0, 1,
+           orderPairState(valSeqAt(VS, 0), valSeqAt(VS, 1))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires VS ==K vCons(A:Float, vCons(B:Float, floatVals(FS:FloatSeq)))
+endmodule
