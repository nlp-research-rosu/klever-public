+    high = best_high
+    i = 0
+    j = 1
+    while i < len(numbers) - 1:
+        low = numbers[i]
+        high = numbers[j]
+        if low > high:
+            low, high = high, low
+        if high - low < best_high - best_low:
+            best_low = low
+            best_high = high
+
+        j += 1
