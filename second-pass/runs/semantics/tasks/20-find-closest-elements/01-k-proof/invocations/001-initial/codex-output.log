+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("numbers"   |-> list(floatVals(FS)))
+        ("i"         |-> (I => floatSeqLen(FS) -Int 1))
+        ("j"         |-> (J => floatSeqLen(FS)))
+        ("best_low"  |-> (BL => pairLow(scanPairs(
+                            FS, I, J, pairState(BL, BH)))))
+        ("best_high" |-> (BH => pairHigh(scanPairs(
+                            FS, I, J, pairState(BL, BH)))))
+        ("low"       |-> (_OLDL:Float => pairLow(scanPairs(
+                            FS, I, J, pairState(BL, BH)))))
+        ("high"      |-> (_OLDH:Float => pairHigh(scanPairs(
+                            FS, I, J, pairState(BL, BH))))),
+        parent(0))
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    requires 0 <=Int I
+     andBool I <Int J
+     andBool J <Int floatSeqLen(FS)
+     andBool I <Int floatSeqLen(FS) -Int 1
+    [priority(40)]
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled && kprove spec.k --definition verification-kompiled --spec-module SPEC' in /work
