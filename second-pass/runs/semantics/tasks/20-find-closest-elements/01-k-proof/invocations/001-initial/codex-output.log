exec
/bin/bash -lc "python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
python3 - <<'PY'
from solution import find_closest_elements
import random

def oracle(xs):
    return min((tuple(sorted((xs[i], xs[j]))) for i in range(len(xs)) for j in range(i + 1, len(xs))), key=lambda p: p[1] - p[0])
for n in range(2, 10):
    for _ in range(1000):
        xs = [random.randint(-100, 100) / 8 for _ in range(n)]
        assert find_closest_elements(xs) == oracle(xs)
print('random differential tests: passed')
PY
krun concrete_tests.mpy --definition runtime-kompiled --output none
sed -n '1,240p' solution.mpy" in /work
