+def find_closest_elements(numbers: List[float]) -> Tuple[float, float]:
+    best_low = numbers[0]
+    best_high = numbers[1]
+    if best_low > best_high:
+        best_low, best_high = best_high, best_low
+
+    i = 0
+    while i < len(numbers):
+        j = i + 1
+        while j < len(numbers):
+            low = numbers[i]
+            high = numbers[j]
+            if low > high:
+                low, high = high, low
+            if high - low < best_high - best_low:
+                best_low = low
+                best_high = high
+            j += 1
+        i += 1
+
