+  // the original While rules.
+  rule
+    <k>
+      While(findClosestLoopCondition, findClosestLoopBody) => .K ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ...
+      1 |-> scope(
+        ("numbers"   |-> list(VS))
+        ("i"         |-> (I => vsLen(VS) -Int 1))
+        ("j"         |-> (J => vsLen(VS)))
+        ("best_low"  |-> (BL:Float => closestLowVS(VS, I, J, BL, BH)))
+        ("best_high" |-> (BH:Float => closestHighVS(VS, I, J, BL, BH)))
+        ("low"       |-> (_OLDL:Float => closestLowVS(VS, I, J, BL, BH)))
+        ("high"      |-> (_OLDH:Float => closestHighVS(VS, I, J, BL, BH))),
+        parent(0))
+      ...
+    </scopes>
+    requires 0 <=Int I
+     andBool I <Int J
+     andBool J <Int vsLen(VS)
+     andBool I <Int vsLen(VS) -Int 1
+    [priority(40)]
+endmodule

exec
/bin/bash -lc "bash -n prove.sh
cmp -s solution.mpy <(python3 py2mpy.py solution.py)
python3 - <<'PY'
from solution import find_closest_elements
import random

def oracle(xs):
    return min(
        (tuple(sorted((xs[i], xs[j])))
         for i in range(len(xs)) for j in range(i + 1, len(xs))),
        key=lambda pair: pair[1] - pair[0],
    )

for n in range(2, 10):
    for _ in range(500):
        xs = [random.randint(-100, 100) / 8.0 for _ in range(n)]
        assert find_closest_elements(xs) == oracle(xs)
print(\"final randomized differential tests: passed\")
PY
ls -lh solution.py solution.mpy verification.k spec.k prove.sh" in /work
