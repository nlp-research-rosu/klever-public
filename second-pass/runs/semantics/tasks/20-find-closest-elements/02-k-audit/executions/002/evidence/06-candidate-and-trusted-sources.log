     1	from typing import List, Tuple
     2	
     3	
     4	def find_closest_elements(numbers: List[float]) -> Tuple[float, float]:
     5	    """Return a closest pair, ordered from smaller to larger."""
     6	    best_low = numbers[0]
     7	    best_high = numbers[1]
     8	    if best_low > best_high:
     9	        best_low, best_high = best_high, best_low
    10	
    11	    low = best_low
    12	    high = best_high
    13	    i = 0
    14	    j = 1
    15	    while i < len(numbers) - 1:
    16	        low = numbers[i]
    17	        high = numbers[j]
    18	        if low > high:
    19	            low, high = high, low
    20	        if high - low < best_high - best_low:
    21	            best_low = low
    22	            best_high = high
    23	
    24	        j += 1
    25	        if j == len(numbers):
    26	            i += 1
    27	            j = i + 1
    28	        low = best_low
    29	        high = best_high
    30	
    31	    return (best_low, best_high)
