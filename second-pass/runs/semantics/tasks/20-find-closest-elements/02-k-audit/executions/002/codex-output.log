   213	        ("best_high" |-> (BH:Float => closestHighVS(VS, I, J, BL, BH)))
   214	        ("low"       |-> (_OLDL:Float => closestLowVS(VS, I, J, BL, BH)))
   215	        ("high"      |-> (_OLDH:Float => closestHighVS(VS, I, J, BL, BH))),
   216	        parent(0))
   217	      ...
   218	    </scopes>
   219	    requires 0 <=Int I
   220	     andBool I <Int J
   221	     andBool J <Int vsLen(VS)
   222	     andBool I <Int vsLen(VS) -Int 1
   223	    [priority(40)]
