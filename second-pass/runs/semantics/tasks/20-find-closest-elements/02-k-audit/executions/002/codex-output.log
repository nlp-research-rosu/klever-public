diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..9617421be92be5846318d33e83b6f4a99e30a580
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: run_logged.sh LOGFILE COMMAND [ARG...]" >&2
+  exit 2
+fi
+
+logfile=$1
+shift
+
+{
+  printf 'cwd: %q\n' "$PWD"
+  printf 'command:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'started_utc: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} > "$logfile"
+
+set +e
+"$@" > >(tee -a "$logfile") 2> >(tee -a "$logfile" >&2)
+status=$?
+set -e
+
+{
+  printf 'exit_status: %d\n' "$status"
+  printf 'finished_utc: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} | tee -a "$logfile"
+
+exit "$status"

exec
/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import hashlib
for root in [Path('/reference/reference-semantics'),Path('/candidate/reference-semantics'),Path('/candidate')]:
 for variant in range(6):
  h=hashlib.sha256()
  for p in sorted(root.rglob('*')):
   if not p.is_file(): continue
   rel=p.relative_to(root).as_posix().encode()
   b=p.read_bytes()
   if variant==0: h.update(rel); h.update(b)
   if variant==1: h.update(rel+b'\\0'+b)
   if variant==2: h.update(rel+b'\\n'+hashlib.sha256(b).hexdigest().encode()+b'\\n')
   if variant==3: h.update(hashlib.sha256(b).digest())
   if variant==4: h.update(b)
   if variant==5: h.update((hashlib.sha256(b).hexdigest()+'  '+p.relative_to(root).as_posix()+'\\n').encode())
  print(root,variant,h.hexdigest())
PY" in /audit-output
