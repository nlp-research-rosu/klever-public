+        equal = left.read_bytes() == right.read_bytes()
+        print(f"{label}_byte_identical={equal}")
+        if not equal:
+            failures.append(f"{label} differs")
+
+    print(f"failures={failures}")
+    return 0 if not failures else 1
+
+
