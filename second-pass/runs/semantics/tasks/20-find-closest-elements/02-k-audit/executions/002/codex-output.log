     4	def find_closest_elements(numbers: List[float]) -> Tuple[float, float]:
     5	    best_low = numbers[0]
     6	    best_high = numbers[1]
     7	    if best_low > best_high:
     8	        best_low, best_high = best_high, best_low
     9	
    10	    low = best_low
    11	    high = best_high
    12	    i = 0
    13	    j = 1
    14	    while i < len(numbers) - 1:
    15	        low = numbers[i]
    16	        high = numbers[j]
    17	        if low > high:
    18	            low, high = high, low
    19	        if high - low < best_high - best_low:
    20	            best_low = low
    21	            best_high = high
    22	
    23	        j += 1
    24	        if j == len(numbers):
    25	            i += 1
    26	            j = i + 1
    27	        low = best_low
    28	        high = best_high
    29	
    30	    return (best_low, best_high)
