   253	  rule passAddE(evp(OPS:OpSeq, iCons(N0:Int, NDS:IntSeq))) => passLGoE("add", N0, OPS, NDS, .OpSeq, .IntSeq)
   254	  rule passAddE(evp(OPS:OpSeq, .IntSeq)) => evp(OPS, .IntSeq)
   255	  syntax EvPair ::= passLGoE(String, Int, OpSeq, IntSeq, OpSeq, IntSeq) [function, total]
   256	  rule passLGoE(_:String, CUR:Int, .OpSeq, _:IntSeq, OO:OpSeq, ON:IntSeq) => evp(OO, appendIE(ON, CUR))
   257	  rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)
   258	    => passLGoE(L, applyOpE(O, CUR, N), OPS, NDS, OO, ON)
   259	       requires inLevelE(L, O)
   260	  rule passLGoE(L:String, CUR:Int, oCons(O:String, OPS:OpSeq), iCons(N:Int, NDS:IntSeq), OO:OpSeq, ON:IntSeq)
   261	    => passLGoE(L, N, OPS, NDS, appendOpE(OO, O), appendIE(ON, CUR))
   262	       requires notBool inLevelE(L, O)
   263	  rule passLGoE(_:String, CUR:Int, oCons(_:String, _:OpSeq), .IntSeq, OO:OpSeq, ON:IntSeq)
   264	    => evp(OO, appendIE(ON, CUR)) [owise]
   265	  syntax Bool ::= inLevelE(String, String) [function, total]
   266	  rule inLevelE("mul", O:String) => O ==String "*" orBool O ==String "//" orBool O ==String "/"
   267	  rule inLevelE("add", O:String) => O ==String "+" orBool O ==String "-"
   268	  rule inLevelE(_:String, _:String) => false [owise]
   269	  syntax OpSeq ::= appendOpE(OpSeq, String) [function, total]
   270	  rule appendOpE(.OpSeq, O:String) => oCons(O, .OpSeq)
   271	  rule appendOpE(oCons(H:String, T:OpSeq), O:String) => oCons(H, appendOpE(T, O))
   272	  syntax IntSeq ::= appendIE(IntSeq, Int) [function, total]
   273	  rule appendIE(.IntSeq, N:Int) => iCons(N, .IntSeq)
   274	  rule appendIE(iCons(H:Int, T:IntSeq), N:Int) => iCons(H, appendIE(T, N))
   275	
   276	  // ==== hashlib.md5(S).hexdigest() — a trusted opaque digest ==================
   277	  // The md5 value itself is a named shared trust (sortVS-style, no concrete
   278	  // twin); proofs use the length/hex-charset lemmas (lemmas/builtins.k).
   279	  syntax KItem ::= "#md5"
   280	  rule <k> Call(Attribute(Name("hashlib"), "md5"), (E:Expr, .Exprs)) => E ~> #md5 ... </k>
   281	       [priority(40)]
   282	  rule <k> str(CS:IntSeq) ~> #md5 => md5Obj(CS) ... </k>
   283	  syntax Val ::= md5Obj(IntSeq)
   284	  rule applyMethod(md5Obj(CS:IntSeq), "hexdigest", .Vals) => str(md5hexCodes(CS))
   285	  syntax IntSeq ::= md5hexCodes(IntSeq) [function, total, symbol(md5hexCodes), no-evaluators]
   286	
   287	  // ==== isinstance(V, int|str) — an ordinary 2-arg builtin ===================
   288	  // The type argument (int/str) is an ordinary name that resolves via the builtins frame to
   289	  // typeV (see core.k's config); no Call-level special case. isIntV/isStrV mirror the old
   290	  // owise-on-Val test (concrete-sort args decide; a symbolic Val stays owise, as before).
   291	  rule applyBuiltin("isinstance", V:Val, typeV("int"), .Vals) => isIntV(V)
   292	  rule applyBuiltin("isinstance", V:Val, typeV("str"), .Vals) => isStrV(V)
   293	  syntax Bool ::= isIntV(Val) [function] | isStrV(Val) [function]
   294	  rule isIntV(_:Int)         => true
   295	  rule isIntV(_:Val)         => false [owise]
   296	  rule isStrV(str(_:IntSeq)) => true
   297	  rule isStrV(_:Val)         => false [owise]
   298	endmodule
FILE reference-semantics/semantics/comprehension.k
     1	// reference/src/semantics/comprehension.k — MPY-COMPREHENSION
     2	
     3	module MPY-COMPREHENSION
     4	  imports MPY-CORE
     5	  imports MPY-OPERATORS
     6	  imports MPY-LIST
     7	  imports MPY-CONTROLS
     8	  imports MPY-FUNCTIONS
     9	
    10	  // A comprehension is pure syntactic sugar
    11	  rule ListComp(ELT:Expr, Gs:CompFors) => Call(closureExpr(.ParamNames, compBody(Gs, ELT)), .Exprs)
    12	  rule GenExp(ELT:Expr, Gs:CompFors)   => Call(closureExpr(.ParamNames, compBody(Gs, ELT)), .Exprs)
    13	
    14	  syntax Stmts ::= compBody(CompFors, Expr) [macro]
    15	  rule compBody(Gs:CompFors, ELT:Expr)
    16	    => Assign(Name("$acc"), ListExpr(.Exprs)) compNest(Gs, ELT) Return(Name("$acc"))
    17	
    18	  syntax Stmt ::= compNest(CompFors, Expr) [macro-rec]
    19	  rule compNest(.CompFors, ELT:Expr)
    20	    => Assign(Name("$acc"), BinOp("+", Name("$acc"), ListExpr(ELT)))
    21	  rule compNest((CompFor(T:Expr, ITER:Expr, Fs:Exprs) GRest:CompFors), ELT:Expr)
    22	    => For(T, ITER, If(compGuard(Fs), compNest(GRest, ELT), .Stmts))
    23	
    24	  syntax Expr ::= compGuard(Exprs) [macro]
    25	  rule compGuard(.Exprs)             => Bool(true)
    26	  rule compGuard((F:Expr, Fs:Exprs)) => BoolOp("and", (F, Fs))
    27	endmodule
FILE reference-semantics/semantics/concrete.k
     1	// reference/src/semantics/concrete.k — MPY-CONCRETE
     2	// Concrete-execution-only rules, visible ONLY to the llvm build (run.sh kompiles
     3	// MPY-CONCRETE; verification builds import MPY and never see these). Rationale:
     4	// a k-cell rule matching value constructors NARROWS abstract Vals in the haskell
     5	// backend ([concrete] is not respected on rewrite rules) — probed on
     6	// 26-remove-duplicates, where element compares branched into deepEqVS.
     7	
     8	module MPY-CONCRETE
     9	  imports MPY
    10	
    11	  // deep equality for list compares whose elements are heap objects
    12	  // (list-of-lists): Python == is structural at every depth.
    13	  rule <k> Compare(list(A:ValSeq), CmpOp("==", list(B:ValSeq))) => deepEqVS(A, B, HP) ... </k>
    14	       <heap> HP:Map </heap>
    15	       requires hasRefVS(A) orBool hasRefVS(B)
    16	  rule <k> Compare(list(A:ValSeq), CmpOp("!=", list(B:ValSeq))) => notBool deepEqVS(A, B, HP) ... </k>
    17	       <heap> HP:Map </heap>
    18	       requires hasRefVS(A) orBool hasRefVS(B)
    19	
    20	  // ==== keyed sort, concrete leg ============================================
    21	  // Computes each key by a REAL call through the uniform #callee machinery
    22	  // (closures, len, type objects all work), stable-inserts on the key, and
    23	  // allocates the result. priority(40) beats sort.k's opaque rules, so krun
    24	  // runs this and proofs (which never see MPY-CONCRETE) keep sortKeyVS.
    25	  syntax Val ::= kvP(Val, Val)
    26	  syntax KItem ::= #ksort(ValSeq, Val, ValSeq, Bool)
    27	                 | #ksIns(Val, ValSeq, Val, ValSeq, Bool)
    28	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
    29	        => #ksort(VS, KV, .ValSeq, false) ... </k>
    30	       [priority(40)]
    31	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
    32	        => #ksort(VS, KV, .ValSeq, RB) ... </k>
    33	       [priority(40)]
    34	  rule <k> #ksort(.ValSeq, _:Val, ACC:ValSeq, RB:Bool)
    35	        => #alloc(list(condRev(unpairVS(ACC), RB))) ... </k>
    36	  rule <k> #ksort(vCons(V:Val, R:ValSeq), KV:Val, ACC:ValSeq, RB:Bool)
    37	        => KV ~> #callee((V, .Exprs)) ~> #ksIns(V, R, KV, ACC, RB) ... </k>
    38	  rule <k> K:Val ~> #ksIns(V:Val, R:ValSeq, KV:Val, ACC:ValSeq, RB:Bool)
    39	        => #ksort(R, KV, insPair(ACC, K, V), RB) ... </k>
    40	       requires notBool isKwV(K)
    41	
    42	  syntax ValSeq ::= insPair(ValSeq, Val, Val) [function]
    43	  rule insPair(.ValSeq, K:Val, V:Val) => vCons(kvP(K, V), .ValSeq)
    44	  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    45	    => vCons(kvP(K, V), vCons(kvP(K2, V2), R))
    46	       requires kLt(K, K2)
    47	  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    48	    => vCons(kvP(K2, V2), insPair(R, K, V))
    49	       requires notBool kLt(K, K2)
    50	
    51	  syntax Bool ::= kLt(Val, Val) [function]
    52	  rule kLt(I1:Int, I2:Int)             => I1 <Int I2
    53	  rule kLt(F1:Float, F2:Float)         => F1 <Float F2
    54	  rule kLt(str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
    55	
    56	  syntax ValSeq ::= unpairVS(ValSeq) [function, total]
    57	  rule unpairVS(.ValSeq) => .ValSeq
    58	  rule unpairVS(vCons(kvP(_:Val, V:Val), R:ValSeq)) => vCons(V, unpairVS(R))
    59	  rule unpairVS(vCons(V:Val, R:ValSeq)) => vCons(V, unpairVS(R)) [owise]
    60	endmodule
FILE reference-semantics/semantics/dict.k
     1	// reference/src/semantics/dict.k — MPY-DICT
     2	//
     3	// Minimal dict support. A dict value is `dictV(KS, VS)`: PARALLEL insertion-ordered key/value
     4	// ValSeqs (Python dict order; keys distinct; re-inserting a key updates its value in place, keeping
     5	// the original position). Concrete for krun (the ordered build + `.keys()` are the real ops); a proof
     6	// over a SYMBOLIC dict passes `dictV(KS, WS)` with a symbolic key sequence KS and reads
     7	// `d.keys() = list(KS)`, then keeps each key opaque problem-locally.
     8	//
     9	// Only the pieces needed so far: a dict VALUE (so `{}` inside a mixed list evaluates and
    10	// `isinstance(x, int)` rejects it), the `{k: v, ...}` literal, and `.keys()`. More dict ops (subscript
    11	// / `.get()` / `.values()` / dict `==`) are added as dict problems need them — kept minimal + additive.
    12	
    13	module MPY-DICT
    14	  imports MPY-CORE
    15	  imports MPY-ITER
    16	  imports MPY-METHODS
    17	  imports MPY-LIST
    18	
    19	  // dict as PARALLEL ordered key/value ValSeqs (same length; keys distinct).
    20	  syntax Val ::= dictV(ValSeq, ValSeq)
    21	
    22	  // ==== DictExpr: {k: v, ...} literal. Eval each key then value, left to right, insert-with-dedup.
    23	  syntax KItem ::= #dictAcc(Entries, ValSeq, ValSeq)
    24	                 | #dictKey(Expr, Entries, ValSeq, ValSeq)
    25	                 | #dictVal(Val, Entries, ValSeq, ValSeq)
    26	  rule <k> DictExpr(ES:Entries) => #dictAcc(ES, .ValSeq, .ValSeq) ... </k>
    27	  rule <k> #dictAcc(.Entries, KS:ValSeq, VS:ValSeq) => dictV(KS, VS) ... </k>
    28	  rule <k> #dictAcc((Entry(K:Expr, V:Expr), REST:Entries), KS:ValSeq, VS:ValSeq)
    29	        => K ~> #dictKey(V, REST, KS, VS) ... </k>
    30	  rule <k> KV:Val ~> #dictKey(V:Expr, REST:Entries, KS:ValSeq, VS:ValSeq)
    31	        => V ~> #dictVal(KV, REST, KS, VS) ... </k>
    32	  rule <k> VV:Val ~> #dictVal(KV:Val, REST:Entries, KS:ValSeq, VS:ValSeq)
    33	        => #dictAcc(REST, dPutK(KS, KV), dPutV(KS, VS, KV, VV)) ... </k>
    34	
    35	  // insert-with-dedup helpers (concrete Val key equality via ==K). [total] so buildFold over a dict is
    36	  // total (its #Ceil is #Top) — needed when a symbolic proof carries a built dict as a config value.
    37	  syntax Bool ::= dHasKey(ValSeq, Val) [function, total]
    38	  rule dHasKey(.ValSeq, _:Val)                => false
    39	  rule dHasKey(vCons(A:Val, _:ValSeq), K:Val) => true          requires A ==K K
    40	  rule dHasKey(vCons(A:Val, R:ValSeq), K:Val) => dHasKey(R, K) requires notBool (A ==K K)
    41	
    42	  // dPutK: KS unchanged if K already present, else append K (keep-first-position).
    43	  syntax ValSeq ::= dPutK(ValSeq, Val) [function, total]
    44	  rule dPutK(KS:ValSeq, K:Val) => KS                                  requires dHasKey(KS, K)
    45	  rule dPutK(KS:ValSeq, K:Val) => valSeqConcat(KS, vCons(K, .ValSeq)) requires notBool dHasKey(KS, K)
    46	
    47	  // dPutV: parallel to KS — set the value at K's position if present, else append V at the end. The
    48	  // [owise] catch-all covers the degenerate mismatched-length case (never reached for a well-formed dict).
    49	  syntax ValSeq ::= dPutV(ValSeq, ValSeq, Val, Val) [function, total]
    50	  rule dPutV(vCons(A:Val, _:ValSeq), vCons(_:Val, VR:ValSeq), K:Val, V:Val)  => vCons(V, VR)
    51	       requires A ==K K
    52	  rule dPutV(vCons(A:Val, KR:ValSeq), vCons(B:Val, VR:ValSeq), K:Val, V:Val) => vCons(B, dPutV(KR, VR, K, V))
    53	       requires notBool (A ==K K)
    54	  rule dPutV(_KS:ValSeq, VS:ValSeq, _K:Val, V:Val) => valSeqConcat(VS, vCons(V, .ValSeq)) [owise]
    55	
    56	  // ==== dict methods ========================================================
    57	  // d.keys() -> a FRESH list object of the ordered keys (k-cell: it allocates).
    58	  rule <k> #applyK(toCall(boundMethodV(dictV(KS:ValSeq, _:ValSeq), "keys")), .Vals)
    59	        => #alloc(list(KS)) ... </k>
    60	       [priority(40)]
    61	
    62	  // ==== dict subscript READ: d[k] (assoc lookup; KeyError is out of subset) ==
    63	  rule applyIndexD(dictV(KS:ValSeq, VS:ValSeq), K:Val) => dGet(KS, VS, K)
    64	  syntax Val ::= applyIndexD(Val, Val) [function]
    65	  rule <k> Subscript(dictV(KS:ValSeq, VS:ValSeq), K:Val) => applyIndexD(dictV(KS, VS), K) ... </k>
    66	       [priority(45)]
    67	
    68	  // ==== dict subscript-assign: d[k] = v (insert/update in place) =============
    69	  // Only for a LOCAL dict variable X (the current scope holds it). Reuses dPutK/dPutV.
    70	  syntax Val ::= dictSet(Val, Val, Val) [function]
    71	  rule dictSet(dictV(KS:ValSeq, VS:ValSeq), K:Val, V:Val) => dictV(dPutK(KS, K), dPutV(KS, VS, K, V))
    72	
    73	  // RHS evaluates first (Assign strictness), then the key. Dispatch on the scope
    74	  // value: a bare dict updates in the scope (dicts stay values); a ref (a heap
    75	  // list — or a heap dict later) writes the heap in place.
    76	  syntax KItem ::= #dsetK(String, Val)
    77	  rule <k> Assign(Subscript(Name(X:String), K:Expr), VV:Val) => K ~> #dsetK(X, VV) ... </k>
    78	  rule <k> KV:Val ~> #dsetK(X:String, VV:Val) => .K ... </k>
    79	       <env> L:Int </env>
    80	       <scopes> ... L |-> scope(M:Map => M [ X <- dictSet({M[X]}:>Val, KV, VV) ], _) ... </scopes>
    81	       requires X in_keys(M) andBool notBool isRefV({M[X]}:>Val)
    82	  rule <k> KV:Val ~> #dsetK(X:String, VV:Val) => #dsetV({M[X]}:>Val, KV, VV) ... </k>
    83	       <env> L:Int </env>
    84	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    85	       requires X in_keys(M) andBool isRefV({M[X]}:>Val)
    86	  syntax KItem ::= #dsetV(Val, Val, Val)
    87	  rule <k> #dsetV(ref(H:Int), I:Int, VV:Val) => .K ... </k>
    88	       <heap> ... H |-> list(VS:ValSeq => setVSAt(VS, normIdxD(I, vsLen(VS)), VV)) ... </heap>
    89	  // negative-index normalization local to the write (subscript.k's is not imported here)
    90	  syntax Int ::= normIdxD(Int, Int) [function, total]
    91	  rule normIdxD(I:Int, LEN:Int) => I +Int LEN requires I  <Int 0
    92	  rule normIdxD(I:Int, _:Int)   => I          requires I >=Int 0
    93	
    94	  // ==== dict == (order-insensitive: same size + same key->value pairs) =======
    95	  rule applyCmp("==", dictV(KS1:ValSeq, VS1:ValSeq), dictV(KS2:ValSeq, VS2:ValSeq))
    96	    => (vsLen(KS1) ==Int vsLen(KS2)) andBool dSubset(KS1, VS1, KS2, VS2)
    97	  syntax Bool ::= dSubset(ValSeq, ValSeq, ValSeq, ValSeq) [function]
    98	  rule dSubset(.ValSeq, .ValSeq, _:ValSeq, _:ValSeq) => true
    99	  rule dSubset(vCons(K:Val, KR:ValSeq), vCons(V:Val, VR:ValSeq), KS2:ValSeq, VS2:ValSeq)
   100	    => dHasKey(KS2, K) andBool (dGet(KS2, VS2, K) ==K V) andBool dSubset(KR, VR, KS2, VS2)
   101	  syntax Val ::= dGet(ValSeq, ValSeq, Val) [function]
   102	  rule dGet(vCons(A:Val, _:ValSeq), vCons(B:Val, _:ValSeq), K:Val) => B                requires A ==K K
   103	  rule dGet(vCons(A:Val, KR:ValSeq), vCons(_:Val, VR:ValSeq), K:Val) => dGet(KR, VR, K) requires notBool (A ==K K)
   104	endmodule

diff --git a/evidence/annotate_inventory.py b/evidence/annotate_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..d2aa616e884aeed67f469a66fd077a9508d7dd3d
--- /dev/null
+++ b/evidence/annotate_inventory.py
@@ -0,0 +1,155 @@
+#!/usr/bin/env python3
+"""Attach an audit decision to every row of k_inventory.tsv."""
+
+from __future__ import annotations
+
+import csv
+from pathlib import Path
+
+
+SOURCE = Path("/audit-output/evidence/k_inventory.tsv")
+OUTPUT = Path("/audit-output/evidence/k_inventory_review.tsv")
+
+
+USED_BASELINE_FILES = {
+    "reference-semantics/semantics/syntax.k",
+    "reference-semantics/semantics/core.k",
+    "reference-semantics/semantics/call.k",
+    "reference-semantics/semantics/functions.k",
+    "reference-semantics/semantics/controls.k",
+    "reference-semantics/semantics/float.k",
+    "reference-semantics/semantics/int.k",
+    "reference-semantics/semantics/operators.k",
+    "reference-semantics/semantics/subscript.k",
+    "reference-semantics/semantics/tuple.k",
+    "reference-semantics/semantics/str.k",
+    "reference-semantics/semantics/builtins.k",
+}
+
+
+def verification_assessment(line: int) -> tuple[str, str]:
+    if line in {7, 8, 13, 14}:
+        return (
+            "ACCEPT_EXACT_AST_FRAGMENT",
+            "Macro declaration/equation text matches the translated loop condition or body.",
+        )
+    if line in {39, 40}:
+        return (
+            "PINNING_GAP_MANUAL_COPY",
+            "Manual body equation matches the submitted AST by review, but the proof never loads solution.mpy.",
+        )
+    if 58 <= line <= 71:
+        return (
+            "ACCEPT_STRUCTURAL_DEFINITION",
+            "Constructor conversion/length equations are exhaustive, disjoint, and descending.",
+        )
+    if line == 72:
+        return (
+            "LIMITED_TOTAL_ABSTRACTION",
+            "Declared total beyond its equations; .FloatSeq/negative/OOB terms remain abstract. Target uses in-bounds indices.",
+        )
+    if line in {73, 74, 80}:
+        return (
+            "ACCEPT_ON_GUARDED_DOMAIN",
+            "Accessor equation is mathematically correct on its explicit in-bounds/descent domain.",
+        )
+    if 87 <= line <= 116:
+        return (
+            "ACCEPT_PAIR_DEFINITION",
+            "Projection, ordering, and strict-improvement equations match the program's pair update.",
+        )
+    if line == 124:
+        return (
+            "LIMITED_TOTAL_ABSTRACTION",
+            "scanPairs is totalized over arbitrary indices although only 0<=I<J<len is operationally justified.",
+        )
+    if 126 <= line <= 141:
+        return (
+            "ACCEPT_ON_LOOP_INDEX_INVARIANT",
+            "Equations enumerate lexicographic pairs and descend only under 0<=I<J<len; arbitrary indices are not justified.",
+        )
+    if line in {145, 146}:
+        return (
+            "UNUSED_PARTIAL_HELPER",
+            "lastOrderedPair is unused and accesses len-2/len-1 without a length guard.",
+        )
+    if line == 154:
+        return (
+            "LIMITED_TOTAL_ABSTRACTION",
+            "Declared total beyond Float-headed/in-bounds ValSeq cases; target calls remain Float-headed and in bounds.",
+        )
+    if line in {155, 156}:
+        return (
+            "ACCEPT_ON_GUARDED_DOMAIN",
+            "Float ValSeq accessor equation is correct for Float-headed in-bounds inputs.",
+        )
+    if line == 160:
+        return (
+            "LIMITED_TOTAL_ABSTRACTION",
+            "scanPairsVS is totalized beyond its valid loop-index/Float-list domain.",
+        )
+    if 162 <= line <= 177:
+        return (
+            "ACCEPT_ON_LOOP_INDEX_INVARIANT",
+            "Equations match one remaining iteration on valid Float-list loop states.",
+        )
+    if line == 185:
+        return (
+            "REJECT_RESULT_BEARING_ORACLE",
+            "Opaque symbolic projections influence the return and postcondition; only concrete evaluator equations constrain them.",
+        )
+    if line in {189, 192}:
+        return (
+            "ACCEPT_CONCRETE_ONLY",
+            "Ground evaluator equation agrees with scanPairsVS, but supplies no symbolic universal connection theorem.",
+        )
+    if line == 201:
+        return (
+            "REJECT_UNPROVED_OPERATIONAL_BRIDGE",
+            "Priority rule skips the real While and writes the exact desired scan summary without a bridge-free proof.",
+        )
+    return ("REVIEW_ERROR", "Unclassified verification entry.")
+
+
+with SOURCE.open(newline="") as source, OUTPUT.open("w", newline="") as output:
+    reader = csv.DictReader(source, delimiter="\t")
+    fieldnames = list(reader.fieldnames or []) + ["use_scope", "assessment", "rationale"]
+    writer = csv.DictWriter(output, fieldnames=fieldnames, delimiter="\t")
+    writer.writeheader()
+    count = 0
+    errors = 0
+    for row in reader:
+        path = row["file"]
+        line = int(row["start_line"])
+        if path.startswith("reference-semantics/"):
+            row["use_scope"] = (
+                "selected-baseline; constructs from this file are on the program path"
+                if path in USED_BASELINE_FILES
+                else "selected-baseline; unused by this submitted program"
+            )
+            row["assessment"] = "ACCEPT_FIXED_SUPPLIED_BASELINE"
+            row["rationale"] = (
+                "Byte-identical to the trusted supplied semantics; it defines the selected semantics level. "
+                "Program-used behavior is separately mapped in REVIEW.md."
+            )
+        elif path == "verification.k":
+            row["use_scope"] = "proof-local extension"
+            row["assessment"], row["rationale"] = verification_assessment(line)
+        elif path == "spec.k":
+            row["use_scope"] = "target entry claim"
+            row["assessment"] = "RESULT_CONSTRAINING_BUT_ASSUMPTION_DEPENDENT"
+            row["rationale"] = (
+                "The postcondition is discriminating, but repeats the same opaque closest* terms written by the loop bridge."
+            )
+        else:
+            row["use_scope"] = "unknown"
+            row["assessment"] = "REVIEW_ERROR"
+            row["rationale"] = "Unexpected inventory path."
+        errors += row["assessment"] == "REVIEW_ERROR"
+        writer.writerow(row)
+        count += 1
+
+print(f"reviewed_rows={count}")
+print(f"review_errors={errors}")
+print(f"output={OUTPUT}")
+raise SystemExit(1 if errors else 0)
diff --git a/evidence/body_sensitivity.sh b/evidence/body_sensitivity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..6afa89822116ef40eb44a8910bf8ddf57f4fe99f
--- /dev/null
+++ b/evidence/body_sensitivity.sh
@@ -0,0 +1,46 @@
+#!/usr/bin/env bash
+set -u
+
+scratch=/tmp/audit-work/reconstruction
+original="$scratch/solution.mpy"
+backup="$scratch/solution.mpy.audit-original"
+mutation=/audit-output/evidence/solution-body-mutation.mpy
+definition="$scratch/verification-body-mutated-kompiled"
+
+cp "$original" "$backup"
+restore() {
+  mv "$backup" "$original"
+}
+trap restore EXIT
+
+sed \
+  's/Return(TupleExpr(Name("best_low"), Name("best_high")))/Return(TupleExpr(Name("best_high"), Name("best_low")))/' \
+  "$backup" >"$original"
+cp "$original" "$mutation"
+
+echo "mutation: reverse the function's returned pair in the submitted program artifact"
+sha256sum "$backup" "$original" "$mutation"
+if cmp -s "$backup" "$original"; then
+  echo "mutation did not change solution.mpy"
+  exit 65
+fi
+
+echo "command: kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-body-mutated-kompiled"
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-body-mutated-kompiled
+build_status=$?
+printf 'build_exit_status=%s\n' "$build_status"
+if (( build_status != 0 )); then
+  exit "$build_status"
+fi
+
+echo "command: kprove spec.k --definition verification-body-mutated-kompiled --spec-module SPEC"
+kprove spec.k \
+  --definition verification-body-mutated-kompiled \
+  --spec-module SPEC
+proof_status=$?
+printf 'proof_exit_status=%s\n' "$proof_status"
+exit "$proof_status"
