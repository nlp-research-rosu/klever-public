+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [documented-example]:
+    <k>
+      #applyK(
+        toCall(closureVal(("numbers", .ParamNames), findClosestBody, 0)),
+        (list(vCons(1.0,
+              vCons(2.0,
+              vCons(3.0,
+              vCons(4.0,
+              vCons(5.0,
+              vCons(2.2, .ValSeq))))))), .Vals))
+      => tuple(vCons(2.0, vCons(2.2, .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..a538d26da95451a0cf8617290558957cab485746
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,38 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: demand (high, high) instead of (low, high).
+  // The satisfying input [1.0, 2.0] has original/model result (1.0, 2.0).
+  claim [false-first-component]:
+    <k>
+      #applyK(
+        toCall(closureVal(("numbers", .ParamNames), findClosestBody, 0)),
+        (list(floatVals(fCons(A, fCons(B, FS)))), .Vals))
+      => tuple(vCons(
+           closestHighVS(
+             floatVals(fCons(A, fCons(B, FS))), 0, 1,
+             pairLow(orderPairState(A, B)),
+             pairHigh(orderPairState(A, B))),
+           vCons(
+             closestHighVS(
+               floatVals(fCons(A, fCons(B, FS))), 0, 1,
+               pairLow(orderPairState(A, B)),
+               pairHigh(orderPairState(A, B))),
+             .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int floatSeqLen(FS)
+endmodule

diff --git a/evidence/body_sensitivity.sh b/evidence/body_sensitivity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..6afa89822116ef40eb44a8910bf8ddf57f4fe99f
--- /dev/null
+++ b/evidence/body_sensitivity.sh
@@ -0,0 +1,46 @@
+#!/usr/bin/env bash
+set -u
+
+scratch=/tmp/audit-work/reconstruction
+original="$scratch/solution.mpy"
+backup="$scratch/solution.mpy.audit-original"
+mutation=/audit-output/evidence/solution-body-mutation.mpy
+definition="$scratch/verification-body-mutated-kompiled"
+
+cp "$original" "$backup"
+restore() {
+  mv "$backup" "$original"
+}
+trap restore EXIT
+
+sed \
+  's/Return(TupleExpr(Name("best_low"), Name("best_high")))/Return(TupleExpr(Name("best_high"), Name("best_low")))/' \
+  "$backup" >"$original"
+cp "$original" "$mutation"
+
+echo "mutation: reverse the function's returned pair in the submitted program artifact"
+sha256sum "$backup" "$original" "$mutation"
+if cmp -s "$backup" "$original"; then
+  echo "mutation did not change solution.mpy"
+  exit 65
+fi
+
+echo "command: kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-body-mutated-kompiled"
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-body-mutated-kompiled
+build_status=$?
+printf 'build_exit_status=%s\n' "$build_status"
+if (( build_status != 0 )); then
+  exit "$build_status"
+fi
+
+echo "command: kprove spec.k --definition verification-body-mutated-kompiled --spec-module SPEC"
+kprove spec.k \
+  --definition verification-body-mutated-kompiled \
+  --spec-module SPEC
+proof_status=$?
+printf 'proof_exit_status=%s\n' "$proof_status"
+exit "$proof_status"
