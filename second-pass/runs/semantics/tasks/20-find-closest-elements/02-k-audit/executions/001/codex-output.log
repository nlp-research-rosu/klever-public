+#!/usr/bin/env bash
+set -u
+
+scratch=/tmp/audit-work/reconstruction
+python3 "$scratch/py2mpy.py" "$scratch/solution.py" >"$scratch/solution.regenerated.mpy"
+translate_status=$?
+printf 'translator_exit_status=%s\n' "$translate_status"
+if (( translate_status != 0 )); then
+  exit "$translate_status"
+fi
+
+cmp "$scratch/solution.regenerated.mpy" "$scratch/solution.mpy"
+cmp_status=$?
+printf 'byte_cmp_status=%s\n' "$cmp_status"
+sha256sum "$scratch/solution.regenerated.mpy" "$scratch/solution.mpy"
+exit "$cmp_status"
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..7290a45d1b70027f53970e1bb016c590db16d99d
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: $0 LABEL COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+label=$1
+shift
+evidence_dir=$(cd "$(dirname "$0")" && pwd)
+cmd_file="$evidence_dir/${label}.cmd"
+log_file="$evidence_dir/${label}.log"
+status_file="$evidence_dir/${label}.status"
+
+{
+  printf 'cwd=%q\n' "$PWD"
+  printf 'command='
+  printf '%q ' "$@"
+  printf '\n'
+} >"$cmd_file"
+
+set +e
+"$@" 2>&1 | tee "$log_file"
+status=${PIPESTATUS[0]}
+set -e
+printf '%s\n' "$status" >"$status_file"
+printf 'exit_status=%s\n' "$status"
+exit "$status"
diff --git a/evidence/spec-ground.k b/evidence/spec-ground.k
new file mode 100644
index 0000000000000000000000000000000000000000..a44ae71428eec61fb181d515fabe22aebc02bd2b
--- /dev/null
+++ b/evidence/spec-ground.k
@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module SPEC-GROUND
+  imports VERIFICATION
+
+  claim [two-elements-swapped]:
+    <k>
+      #applyK(
+        toCall(closureVal(("numbers", .ParamNames), findClosestBody, 0)),
+        (list(vCons(2.0, vCons(1.0, .ValSeq))), .Vals))
+      => tuple(vCons(1.0, vCons(2.0, .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [documented-example]:
+    <k>
+      #applyK(
+        toCall(closureVal(("numbers", .ParamNames), findClosestBody, 0)),
+        (list(vCons(1.0,
+              vCons(2.0,
+              vCons(3.0,
+              vCons(4.0,
+              vCons(5.0,
+              vCons(2.2, .ValSeq))))))), .Vals))
+      => tuple(vCons(2.0, vCons(2.2, .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
