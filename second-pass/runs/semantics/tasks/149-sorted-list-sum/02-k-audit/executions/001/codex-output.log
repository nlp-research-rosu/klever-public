new file mode 100644
index 0000000000000000000000000000000000000000..ed1ff868216d5865a138568f2ef08443184b3217
--- /dev/null
+++ b/evidence/witness-fixed.k
@@ -0,0 +1,17 @@
+requires "reference-semantics/semantics.k"
+
+module AUDIT-WITNESS-FIXED
+  imports MPY
+
+  syntax Stmts ::= "filterBody" [macro]
+  rule filterBody
+    => If(
+         Compare(
+           BinOp("%", Call(Name("len"), Name("word")), Int(2)),
+           CmpOp("==", Int(0))),
+         Expr(
+           Call(
+             Attribute(Name("even_words"), "append"),
+             Name("word"))),
+         .Stmts)
+endmodule

