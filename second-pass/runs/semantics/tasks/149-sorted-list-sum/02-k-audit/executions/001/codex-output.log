diff --git a/evidence/witness-fixed-false-spec.k b/evidence/witness-fixed-false-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..a8feabb5299c3a638c9195b9543e983d4092d1fe
--- /dev/null
+++ b/evidence/witness-fixed-false-spec.k
@@ -0,0 +1,35 @@
+requires "witness-fixed.k"
+
+module AUDIT-WITNESS-FIXED-FALSE-SPEC
+  imports AUDIT-WITNESS-FIXED
+
+  // False under fixed semantics: a nonempty for-loop must bind `word`.
+  claim
+    <k>
+      #loop(
+        list(vCons(str(iCons(97, iCons(97, .IntSeq))), .ValSeq)),
+        Name("word"),
+        filterBody)
+      ~> Name("word")
+    =>
+      Name("word")
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+      1  |-> scope(
+                     "lst" |-> list(vCons(
+                                      str(iCons(97, iCons(97, .IntSeq))),
+                                      .ValSeq))
+                     "even_words" |-> ref(0),
