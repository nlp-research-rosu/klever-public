+++ b/evidence/witness-fixed-true-spec.k
@@ -0,0 +1,42 @@
+requires "witness-fixed.k"
+
+module AUDIT-WITNESS-FIXED-TRUE-SPEC
+  imports AUDIT-WITNESS-FIXED
+
+  claim
+    <k>
+      #loop(
+        list(vCons(str(iCons(97, iCons(97, .IntSeq))), .ValSeq)),
+        Name("word"),
+        filterBody)
+      ~> Name("word")
+    =>
+      str(iCons(97, iCons(97, .IntSeq))) ~> .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+      1  |-> (scope(
+                     "lst" |-> list(vCons(
+                                      str(iCons(97, iCons(97, .IntSeq))),
+                                      .ValSeq))
+                     "even_words" |-> ref(0),
+                     parent(0))
+              =>
+              scope(
+                 "lst" |-> list(vCons(
+                                  str(iCons(97, iCons(97, .IntSeq))),
+                                  .ValSeq))
+                 "even_words" |-> ref(0)
+                 "word" |-> str(iCons(97, iCons(97, .IntSeq))),
+                 parent(0)))
+    </scopes>
+    <heap>
+      0 |-> list(.ValSeq)
+    =>
+      0 |-> list(vCons(
+                   str(iCons(97, iCons(97, .IntSeq))),
+                   .ValSeq))
+    </heap>
+endmodule
diff --git a/evidence/witness-fixed.k b/evidence/witness-fixed.k
new file mode 100644
index 0000000000000000000000000000000000000000..4e64cfd4ac7e1f9718f572092bfd39435b3b34e2
--- /dev/null
+++ b/evidence/witness-fixed.k
@@ -0,0 +1,25 @@
+requires "reference-semantics/semantics.k"
+
+module AUDIT-WITNESS-FIXED
+  imports MPY
+
+  syntax StrList ::= ".StrList"
+                   | sCons(IntSeq, StrList)
+
+  syntax ValSeq ::= strVals(StrList)
+  rule strVals(.StrList) => .ValSeq
+  rule strVals(sCons(CS:IntSeq, REST:StrList))
+    => vCons(str(CS), strVals(REST))
+
+  syntax Stmts ::= "filterBody" [macro]
+  rule filterBody
+    => If(
+         Compare(
+           BinOp("%", Call(Name("len"), Name("word")), Int(2)),
+           CmpOp("==", Int(0))),
+         Expr(
+           Call(
+             Attribute(Name("even_words"), "append"),
+             Name("word"))),
+         .Stmts)
+endmodule

