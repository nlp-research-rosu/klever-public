+requires "verification.k"
+
+module AUDIT-SPEC-VACUITY
+  imports HUMANEVAL-VERIFICATION
+
+  // Fresh false mutation: the real execution allocates and returns ref(2),
+  // while ref(1) is only the intermediate lexical-sort allocation.
+  claim
+    <k>
+      FuncDef("sorted_list_sum", Params("lst"), solutionBody)
+      ~> Call(Name("sorted_list_sum"), list(strVals(INPUT:StrList)))
+    =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+    =>
+      -1 |-> builtinsScope
+      0  |-> scope(solutionGlobals, parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      .Map
+        [ 0 <- list(evenAppend(.ValSeq, INPUT)) ]
+        [ 1 <- list(sortVS(evenAppend(.ValSeq, INPUT))) ]
+        [ 2 <- list(
+                 sortKeyVS(
+                   sortVS(evenAppend(.ValSeq, INPUT)),
+                   builtinV("len"))) ]
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/witness-bridge-false-spec.k b/evidence/witness-bridge-false-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..51d06c6fbe957d6d92d2bfa770adae622b5ff757
--- /dev/null
+++ b/evidence/witness-bridge-false-spec.k
@@ -0,0 +1,30 @@
+requires "verification.k"
+
+module AUDIT-WITNESS-BRIDGE-FALSE-SPEC
+  imports HUMANEVAL-VERIFICATION
+
+  // The candidate bridge proves this false fixed-semantics transition.
+  claim
+    <k>
+      #loop(
+        list(strVals(INPUT:StrList)),
+        Name("word"),
+        filterBody)
+      ~> Name("word")
+    =>
+      Name("word")
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ... 1 |-> scope(
+                     "lst" |-> list(strVals(INPUT))
+                     "even_words" |-> ref(0),
+                     parent(0))
+    </scopes>
+    <heap>
+      ... 0 |-> list(.ValSeq)
+    =>
+          0 |-> list(evenAppend(.ValSeq, INPUT)) ...
+    </heap>
