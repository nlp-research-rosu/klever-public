+    sed -n '1,220p' "$scratch_log"
+    printf '\n[... %s lines omitted from bounded audit log ...]\n\n' "$((line_count - 320))"
+    tail -n 100 "$scratch_log"
+  fi
+} > "$bounded_log"
+printf '%s\n' "$status" > "$status_file"
+
+cat "$bounded_log"
+printf 'exit_status=%s\n' "$status"
+exit "$status"
