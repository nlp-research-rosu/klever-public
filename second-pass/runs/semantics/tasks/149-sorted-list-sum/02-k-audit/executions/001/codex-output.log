+#!/usr/bin/env python3
+"""Ground the entry claim's three heap values on satisfying list[str] inputs."""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+from pathlib import Path
+
+
+ROOT = Path("/tmp/audit-work/reconstruction")
+
+
+def load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.sorted_list_sum
+
+
+canonical = load(ROOT / "trusted" / "canonical.py", "ground_canonical")
+submitted = load(ROOT / "solution.py", "ground_submitted")
+
+cases = [
+    [],
+    ["a", "bb", "aa", "cccc"],
+    ["zzzz", "aa", "bbbb", "cc", "x", "aa"],
+]
+
+for words in cases:
+    heap_0_even_append = [word for word in words if len(word) % 2 == 0]
+    heap_1_sort_vs = sorted(heap_0_even_append)
+    heap_2_sort_key_vs = sorted(heap_1_sort_vs, key=len)
+    record = {
+        "input": words,
+        "entry_precondition_witness": {
+            "INPUT_is_StrList": True,
+            "env": 0,
+            "scopeLoc": 1,
+            "heap": {},
+            "heapLoc": 0,
+            "stack": [],
+            "ret": "noRet",
+            "exc": "NoExc",
+            "exit_code": 0,
+        },
+        "claimed_heap_0_evenAppend": heap_0_even_append,
+        "claimed_heap_1_sortVS": heap_1_sort_vs,
+        "claimed_heap_2_sortKeyVS": heap_2_sort_key_vs,
+        "claimed_return_reference": 2,
+        "canonical_return": canonical(list(words)),
+        "submitted_return": submitted(list(words)),
+    }
+    print(json.dumps(record, ensure_ascii=False, sort_keys=True))
+    assert record["canonical_return"] == heap_2_sort_key_vs
+    assert record["submitted_return"] == heap_2_sort_key_vs
diff --git a/evidence/inventory_k.py b/evidence/inventory_k.py
new file mode 100644
index 0000000000000000000000000000000000000000..8f93ae1bfeb5c0e6adb57ccc47e28f65c23eaf6c
--- /dev/null
+++ b/evidence/inventory_k.py
@@ -0,0 +1,156 @@
+#!/usr/bin/env python3
+"""Produce an exhaustive, line-addressed K declaration/rule inventory."""
+
+from __future__ import annotations
+
+import re
+from collections import Counter
+from pathlib import Path
+
+
+ROOT = Path("/tmp/audit-work/reconstruction")
+OUT = Path("/audit-output/evidence/rule_inventory.md")
+START = re.compile(
+    r"^\s*(configuration|syntax|rule|claim|context|alias)\b"
+)
+
+
+def normalized(block: list[str]) -> str:
+    pieces = []
+    for raw in block:
+        code = raw.split("//", 1)[0].strip()
+        if code:
+            pieces.append(code)
+    return " ".join(pieces)
+
+
+def tags(kind: str, statement: str) -> list[str]:
+    found: list[str] = []
+    if kind == "syntax":
+        for tag in (
+            "function", "total", "functional", "symbol",
+            "no-evaluators", "macro-rec", "macro",
+        ):
+            if re.search(rf"\b{re.escape(tag)}\b", statement):
+                found.append(tag)
+        if "no-evaluators" in found:
+            found.append("opaque")
+    elif kind == "rule":
+        priority = re.search(r"priority\((\d+)\)", statement)
+        if priority:
+            found.append(f"priority({priority.group(1)})")
+        for tag in ("simplification", "concrete", "owise", "anywhere"):
+            if re.search(rf"\b{tag}\b", statement):
+                found.append(tag)
+        if not found:
+            found.append("ordinary")
+    elif kind == "claim":
+        if "functional" in statement:
+            found.append("functional")
+        else:
+            found.append("reachability")
+    return found
+
+
+USED_FIXED_FILES = {
+    "semantics.k",
+    "semantics/syntax.k",
+    "semantics/core.k",
+    "semantics/iter.k",
+    "semantics/operators.k",
+    "semantics/int.k",
+    "semantics/str.k",
+    "semantics/list.k",
+    "semantics/tuple.k",
+    "semantics/controls.k",
+    "semantics/functions.k",
+    "semantics/builtins.k",
+    "semantics/call.k",
+    "semantics/sort.k",
+}
+
+
+def assessment(relative: Path, line: int, kind: str, statement: str) -> str:
+    name = str(relative)
+    if name == "verification.k":
+        if kind == "rule" and line == 71:
+            return "REJECT—unsound operational bridge; see witnesses 18/19/21"
+        if kind in {"rule", "syntax"}:
+            return "ACCEPT—truthful definition, structural encoding, or exact macro"
+    if name == "spec.k":
+        return "TARGET—reachability obligation, not an assumed semantic rule"
+    if name.startswith("reference-semantics/"):
+        fixed_name = name.removeprefix("reference-semantics/")
+        if "no-evaluators" in statement:
+            if fixed_name == "semantics/sort.k" and (
+                "sortVS(" in statement or "sortKeyVS(" in statement
+            ):
+                return "TRUST—used result-bearing supplied sort primitive"
+            return "TRUST—unused supplied opaque primitive"
+        if fixed_name == "semantics/concrete.k":
+            return "ACCEPT—reviewed concrete-only supplied-semantics rule"
+        if fixed_name in USED_FIXED_FILES:
+            return "ACCEPT—reviewed fixed-semantics file on the used execution slice"
+        return "ACCEPT—reviewed supplied-semantics declaration/rule; unreachable here"
+    return "REVIEWED"
+
+
+paths = sorted((ROOT / "reference-semantics").rglob("*.k"))
+paths.extend([ROOT / "verification.k", ROOT / "spec.k"])
+summary: Counter[str] = Counter()
+sections: list[str] = [
+    "# Exhaustive K declaration and rule inventory",
+    "",
+    "Generated by `evidence/inventory_k.py`. Each item contains the source "
+    "line, declaration class, relevant attributes, and its whitespace-"
+    "normalized complete block. `ACCEPT` records the static decision, `TRUST` "
+    "marks an explicit supplied-semantics boundary, `TARGET` marks claims, "
+    "and `REJECT` marks the candidate defect.",
+    "",
+]
+
+for path in paths:
+    lines = path.read_text(encoding="utf-8").splitlines()
+    starts: list[tuple[int, str]] = []
+    for index, line in enumerate(lines):
+        match = START.match(line)
+        if match:
+            starts.append((index, match.group(1)))
+    sections.extend([f"## `{path.relative_to(ROOT)}`", ""])
+    if not starts:
+        sections.extend(["No local configuration, syntax, rule, or claim.", ""])
+        continue
+    for offset, (start, kind) in enumerate(starts):
+        end = starts[offset + 1][0] if offset + 1 < len(starts) else len(lines)
+        for candidate in range(start + 1, end):
+            if lines[candidate].strip() == "endmodule":
+                end = candidate
+                break
+        statement = normalized(lines[start:end])
+        item_tags = tags(kind, statement)
+        summary[kind] += 1
+        for tag in item_tags:
+            summary[f"{kind}:{tag}"] += 1
+        tag_text = ", ".join(item_tags) if item_tags else "declaration"
+        relative = path.relative_to(ROOT)
+        item_assessment = assessment(relative, start + 1, kind, statement)
+        summary[f"assessment:{item_assessment.split('—', 1)[0]}"] += 1
+        sections.append(
+            f"- `{relative}:{start + 1}` — "
+            f"**{kind}** ({tag_text}); **{item_assessment}**: `{statement}`"
+        )
+    sections.append("")
+
+sections.extend([
+    "## Totals",
+    "",
+])
+for key in sorted(summary):
+    sections.append(f"- `{key}`: {summary[key]}")
+sections.append("")
+
+OUT.write_text("\n".join(sections), encoding="utf-8")
+print(f"inventory_path={OUT}")
+print(f"files={len(paths)}")
+for key in sorted(summary):
+    print(f"{key}={summary[key]}")
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..1084e2cb70b0996564855c9af6cf1440c56f051f
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,42 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: $0 LABEL COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+label=$1
+shift
+evidence_dir=/audit-output/evidence
+scratch_log=/tmp/audit-work/"${label}.full.log"
+command_file="${evidence_dir}/${label}.cmd"
+bounded_log="${evidence_dir}/${label}.log"
+status_file="${evidence_dir}/${label}.status"
+
+{
+  printf 'cwd=%q\n' "$PWD"
+  printf 'command='
+  printf '%q ' "$@"
+  printf '\n'
+} > "$command_file"
+
+"$@" > "$scratch_log" 2>&1
+status=$?
+
+line_count=$(wc -l < "$scratch_log")
+{
+  printf 'captured_lines=%s\n' "$line_count"
+  if (( line_count <= 320 )); then
+    sed -n '1,320p' "$scratch_log"
+  else
+    sed -n '1,220p' "$scratch_log"
+    printf '\n[... %s lines omitted from bounded audit log ...]\n\n' "$((line_count - 320))"
+    tail -n 100 "$scratch_log"
+  fi
+} > "$bounded_log"
+printf '%s\n' "$status" > "$status_file"
+
+cat "$bounded_log"
+printf 'exit_status=%s\n' "$status"
+exit "$status"
