+requires "verification.k"
+
+module BRIDGE-SPURIOUS-TRANSITION-EXTENDED
+  imports HUMANEVAL-VERIFICATION
+
+  claim
+    <k>
+      #loop(
+        list(strVals(INPUT:StrList)),
+        Name("word"),
+        filterBody)
+      ~> Name("word")
+    =>
+      Name("word")
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(.Map, parent(-1))
+      1 |-> scope(
+             "lst" |-> list(strVals(WHOLE:StrList))
+             "even_words" |-> ref(0),
+             parent(0))
+    </scopes>
+    <heap>
+      0 |-> list(ACC:ValSeq)
+    =>
+      0 |-> list(evenAppend(ACC, INPUT))
+    </heap>
+endmodule
diff --git a/evidence/bridge-spurious-transition.k b/evidence/bridge-spurious-transition.k
new file mode 100644
index 0000000000000000000000000000000000000000..b490a1cbafc77b9f6cc3504000ec2d61d8324847
--- /dev/null
+++ b/evidence/bridge-spurious-transition.k
@@ -0,0 +1,33 @@
+requires "verification-no-bridge.k"
+
+module BRIDGE-SPURIOUS-TRANSITION
+  imports HUMANEVAL-VERIFICATION
+
+  // This is the candidate bridge specialized to an observable continuation.
+  // It claims that the loop can reach Name("word") while the local scope still
+  // has no "word" binding.
+  claim
+    <k>
+      #loop(
+        list(strVals(INPUT:StrList)),
+        Name("word"),
+        filterBody)
+      ~> Name("word")
+    =>
+      Name("word")
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(.Map, parent(-1))
+      1 |-> scope(
+             "lst" |-> list(strVals(WHOLE:StrList))
+             "even_words" |-> ref(0),
+             parent(0))
+    </scopes>
+    <heap>
+      0 |-> list(ACC:ValSeq)
+    =>
+      0 |-> list(evenAppend(ACC, INPUT))
+    </heap>
+endmodule
