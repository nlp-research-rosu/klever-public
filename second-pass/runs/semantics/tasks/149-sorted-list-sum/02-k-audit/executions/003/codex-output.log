/audit-output/evidence/run_logged.sh stage5_no_bridge_entry_claim kprove /audit-output/evidence/spec-no-bridge.k -I /tmp/audit-work/149-sorted-list-sum --definition verification-no-bridge-kompiled --spec-module HUMANEVAL-SPEC-NO-BRIDGE --claims entry-point
entry_status=$?
