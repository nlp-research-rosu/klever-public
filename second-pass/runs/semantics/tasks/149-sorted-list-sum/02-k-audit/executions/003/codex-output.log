+             "lst" |-> list(strVals(WHOLE:StrList))
+             "even_words" |-> ref(0),
+             parent(0))
+    </scopes>
+    <heap>
+      0 |-> list(ACC:ValSeq)
+    =>
+      0 |-> list(evenAppend(ACC, INPUT))
+    </heap>
+endmodule
