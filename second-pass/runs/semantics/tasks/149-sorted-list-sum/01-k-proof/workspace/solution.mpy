Module(
  FuncDef("sorted_list_sum", Params("lst"),
    Assign(Name("even_words"), ListExpr())
    For(Name("word"), Name("lst"),
      If(Compare(
        BinOp("%", Call(Name("len"), Name("word")), Int(2)),
        CmpOp("==", Int(0))),
        Expr(
          Call(Attribute(Name("even_words"), "append"), Name("word"))),
        ))
    Return(
      Call(
        Name("sorted"),
        Call(Name("sorted"), Name("even_words")),
        KwArg("key", Name("len"))))))
