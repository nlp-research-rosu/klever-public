Module(
  FuncDef("sorted_list_sum", Params("lst"),
    Assign(Name("even_words"), ListExpr())
    For(Name("word"), Name("lst"),
      If(Compare(
        BinOp("%", Call(Name("len"), Name("word")), Int(2)),
        CmpOp("==", Int(0))),
        Expr(
          Call(Attribute(Name("even_words"), "append"), Name("word"))),
        ))
    Return(
      Call(
        Name("sorted"),
        Call(Name("sorted"), Name("even_words")),
        KwArg("key", Name("len")))))
  Assert(
    Compare(
      Call(
        Name("sorted_list_sum"),
        ListExpr(Str("aa"), Str("a"), Str("aaa"))),
      CmpOp("==", ListExpr(Str("aa")))))
  Assert(
    Compare(
      Call(
        Name("sorted_list_sum"),
        ListExpr(Str("ab"), Str("a"), Str("aaa"), Str("cd"))),
      CmpOp("==", ListExpr(Str("ab"), Str("cd")))))
  Assert(
    Compare(
      Call(Name("sorted_list_sum"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("sorted_list_sum"),
        ListExpr(
          Str("zz"),
          Str("a"),
          Str("bbbb"),
          Str("aa"),
          Str("cc"),
          Str("odd"))),
      CmpOp(
        "==",
        ListExpr(Str("aa"), Str("cc"), Str("zz"), Str("bbbb")))))
  Assert(
    Compare(
      Call(
        Name("sorted_list_sum"),
        ListExpr(Str("bb"), Str("aa"), Str("bb"), Str("x"))),
      CmpOp("==", ListExpr(Str("aa"), Str("bb"), Str("bb"))))))
