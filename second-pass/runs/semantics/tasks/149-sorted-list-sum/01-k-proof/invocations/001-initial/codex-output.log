+      L  |-> scope(
+              bindWords(FRAME, sCons(CODES, REST)),
+              parent(0))
+    </scopes>
+    <heap>
+      ... H:Int |-> list(ACC:ValSeq)
+    =>
+          H     |-> list(
+                     evenAppend(
+                       ACC,
+                       sCons(CODES, REST))) ...
+    </heap>
+    requires L =/=Int -1
+     andBool L =/=Int 0
+     andBool "even_words" in_keys(FRAME)
+     andBool {FRAME["even_words"]}:>Val ==K ref(H)
+     andBool notBool ("$cells" in_keys(FRAME))
+     andBool notBool ("len" in_keys(FRAME))
