diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..21ca77884f34f99fde718c719ef58d455d7a91a3
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,74 @@
+requires "verification.k"
+
+module HUMANEVAL-SPEC
+  imports HUMANEVAL-VERIFICATION
+
+  // Loop invariant: for every list[str], the Python for-loop appends exactly
+  // the even-length elements, in input order, to the existing accumulator.
+  claim
+    <k>
+      #loop(list(strVals(INPUT:StrList)), Name("word"), filterBody)
+      ~> CONT:K
+    =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(GLOBALS:Map, parent(-1))
+      L  |-> scope(FRAME:Map, parent(0))
+    =>
+      -1 |-> builtinsScope
+      0  |-> scope(GLOBALS, parent(-1))
+      L  |-> scope(bindWords(FRAME, INPUT), parent(0))
+    </scopes>
+    <heap>
+      ... H:Int |-> list(ACC:ValSeq)
+    =>
+          H     |-> list(evenAppend(ACC, INPUT)) ...
+    </heap>
+    requires L =/=Int -1
+     andBool L =/=Int 0
+     andBool "even_words" in_keys(FRAME)
+     andBool {FRAME["even_words"]}:>Val ==K ref(H)
+     andBool notBool ("len" in_keys(FRAME))
+     andBool notBool ("len" in_keys(GLOBALS))
+
+  // End-to-end entry-point theorem.  INPUT ranges over lists of arbitrary
+  // length whose strings have arbitrary code sequences.  sortVS and sortKeyVS
+  // are the supplied semantics' trusted lexical and stable keyed-sort symbols.
+  claim
+    <k>
+      FuncDef("sorted_list_sum", Params("lst"), solutionBody)
+      ~> Call(Name("sorted_list_sum"), list(strVals(INPUT:StrList)))
+    =>
+      ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+    =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              .Map [ "sorted_list_sum" <- solutionClosure(0) ],
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      .Map
+        [ 0 <- list(evenAppend(.ValSeq, INPUT)) ]
+        [ 1 <- list(sortVS(evenAppend(.ValSeq, INPUT))) ]
+        [ 2 <- list(
+                 sortKeyVS(
+                   sortVS(evenAppend(.ValSeq, INPUT)),
+                   builtinV("len"))) ]
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4c9d90f188b638ad911545dcf2f8f1a6a696cb1c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,63 @@
+requires "reference-semantics/semantics.k"
+
+module HUMANEVAL-VERIFICATION
+  imports MPY
+
+  // A symbolic sequence containing only strings.  Encoding the input this way
+  // makes the Python precondition (list[str]) structural rather than assumed.
+  syntax StrList ::= ".StrList"
+                   | sCons(IntSeq, StrList)
+
+  syntax ValSeq ::= strVals(StrList) [function, total]
+  rule strVals(.StrList) => .ValSeq
+  rule strVals(sCons(CS:IntSeq, REST:StrList))
+    => vCons(str(CS), strVals(REST))
+
+  // Contract-level filter.  The accumulator form mirrors append exactly and
+  // avoids assuming an associativity axiom for valSeqConcat.
+  syntax ValSeq ::= evenAppend(ValSeq, StrList) [function, total]
+  rule evenAppend(ACC:ValSeq, .StrList) => ACC
+  rule evenAppend(ACC:ValSeq, sCons(CS:IntSeq, REST:StrList))
+    => evenAppend(
+         valSeqConcat(ACC, vCons(str(CS), .ValSeq)),
+         REST)
+    requires pyMod(isLen(CS), 2) ==Int 0
+  rule evenAppend(ACC:ValSeq, sCons(CS:IntSeq, REST:StrList))
+    => evenAppend(ACC, REST)
+    requires pyMod(isLen(CS), 2) =/=Int 0
+
+  // The loop leaves its induction variable bound to the last visited word.
+  syntax Map ::= bindWords(Map, StrList) [function, total]
+  rule bindWords(M:Map, .StrList) => M
+  rule bindWords(M:Map, sCons(CS:IntSeq, REST:StrList))
+    => bindWords(M [ "word" <- str(CS) ], REST)
+
+  // These macros are a direct K rendering of solution.mpy.  prove.sh first
+  // regenerates solution.mpy and checks it against the reviewed translation,
+  // so a source mutation cannot silently leave this proof target unchanged.
+  syntax Stmts ::= "filterBody" [macro]
+  rule filterBody
+    => If(
+         Compare(
+           BinOp("%", Call(Name("len"), Name("word")), Int(2)),
+           CmpOp("==", Int(0))),
+         Expr(
+           Call(
+             Attribute(Name("even_words"), "append"),
+             Name("word"))),
+         .Stmts)
+
+  syntax Stmts ::= "solutionBody" [macro]
+  rule solutionBody
+    => Assign(Name("even_words"), ListExpr(.Exprs))
+       For(Name("word"), Name("lst"), filterBody)
+       Return(
+         Call(
+           Name("sorted"),
+           Call(Name("sorted"), Name("even_words")),
+           KwArg("key", Name("len"))))
+
+  syntax Val ::= solutionClosure(Int) [function, total]
+  rule solutionClosure(L:Int)
+    => closureVal(("lst", .ParamNames), solutionBody, L)
+endmodule

