index 0000000000000000000000000000000000000000..86f6b1ecf0f7856ff0d914a40ac50a62e7b0c4ae
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def sorted_list_sum(lst):
+    even_words = []
+    for word in lst:
+        if len(word) % 2 == 0:
+            even_words.append(word)
+    return sorted(sorted(even_words), key=len)
