+requires "verification.k"
+
+module HUMANEVAL-SPEC
+  imports HUMANEVAL-VERIFICATION
+
+  // Empty-list anchor for the loop induction.
+  claim
+    <k>
+      #loop(list(strVals(.StrList)), Name("word"), filterBody)
+      ~> CONT:K
+    =>
+      CONT
+    </k>
+    <env> L:Int </env>
+
+  // First inductive step, before Python has bound the loop variable.
+  claim
+    <k>
+      #loop(
+        list(strVals(sCons(CODES:IntSeq, REST:StrList))),
+        Name("word"),
+        filterBody)
+      ~> CONT:K
+    =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(solutionGlobals, parent(-1))
+      L  |-> scope(baseFrame(WHOLE:StrList, H:Int), parent(0))
+    =>
+      -1 |-> builtinsScope
+      0  |-> scope(solutionGlobals, parent(-1))
+      L  |-> scope(
+              bindWords(
+                baseFrame(WHOLE, H),
+                sCons(CODES, REST)),
+              parent(0))
+    </scopes>
+    <heap>
+      ... H:Int |-> list(ACC:ValSeq)
+    =>
+          H     |-> list(
+                     evenAppend(
+                       ACC,
+                       sCons(CODES, REST))) ...
+    </heap>
+    requires L =/=Int -1
+     andBool L =/=Int 0
+
+  // General inductive step after at least one word has been visited.  It is
+  // reused circularly for a nonempty REST; the empty claim closes REST = [].
+  claim
+    <k>
+      #loop(
+        list(strVals(sCons(CODES:IntSeq, REST:StrList))),
+        Name("word"),
+        filterBody)
+      ~> CONT:K
+    =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(solutionGlobals, parent(-1))
+      L  |-> scope(
+              wordFrame(
+                WHOLE:StrList,
+                H:Int,
+                PREVIOUS:IntSeq),
+              parent(0))
+    =>
+      -1 |-> builtinsScope
+      0  |-> scope(solutionGlobals, parent(-1))
+      L  |-> scope(
+              bindWords(
+                wordFrame(WHOLE, H, PREVIOUS),
+                sCons(CODES, REST)),
+              parent(0))
+    </scopes>
+    <heap>
+      ... H |-> list(ACC:ValSeq)
+    =>
+          H |-> list(
+                 evenAppend(
+                   ACC,
+                   sCons(CODES, REST))) ...
+    </heap>
+    requires L =/=Int -1
+     andBool L =/=Int 0
+
+  // End-to-end entry-point theorem.  INPUT ranges over lists of arbitrary
+  // length whose strings have arbitrary code sequences.  sortVS and sortKeyVS
+  // are the supplied semantics' trusted lexical and stable keyed-sort symbols.
+  claim
+    <k>
+      FuncDef("sorted_list_sum", Params("lst"), solutionBody)
+      ~> Call(Name("sorted_list_sum"), list(strVals(INPUT:StrList)))
+    =>
+      ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+    =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              solutionGlobals,
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      .Map
+        [ 0 <- list(evenAppend(.ValSeq, INPUT)) ]
+        [ 1 <- list(sortVS(evenAppend(.ValSeq, INPUT))) ]
+        [ 2 <- list(
+                 sortKeyVS(
+                   sortVS(evenAppend(.ValSeq, INPUT)),
+                   builtinV("len"))) ]
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
