Module(
  FuncDef("by_length", Params("arr"),
    Assign(
      Name("names"),
      ListExpr(
        Str("One"),
        Str("Two"),
        Str("Three"),
        Str("Four"),
        Str("Five"),
        Str("Six"),
        Str("Seven"),
        Str("Eight"),
        Str("Nine")))
    Assign(Name("values"), ListExpr())
    For(Name("value"), Name("arr"),
      If(BoolOp(
        "and",
        Compare(Name("value"), CmpOp(">=", Int(1))),
        Compare(Name("value"), CmpOp("<=", Int(9)))),
        Expr(Call(Attribute(Name("values"), "append"), Name("value"))),
        ))
    Assign(
      Name("values"),
      Call(Name("sorted"), Name("values"), KwArg("reverse", Bool(true))))
    Assign(Name("result"), ListExpr())
    For(Name("value"), Name("values"),
      Expr(
        Call(
          Attribute(Name("result"), "append"),
          Subscript(Name("names"), BinOp("-", Name("value"), Int(1))))))
    Return(Name("result")))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(2), Int(1), Int(1), Int(4), Int(5), Int(8), Int(2), Int(3))), CmpOp("==", ListExpr(Str("Eight"), Str("Five"), Str("Four"), Str("Three"), Str("Two"), Str("Two"), Str("One"), Str("One")))))
  Assert(Compare(Call(Name("by_length"), ListExpr()), CmpOp("==", ListExpr())))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(1), UnaryOp("-", Int(1)), Int(55))), CmpOp("==", ListExpr(Str("One")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(9), Int(1), Int(10), Int(0), Int(9), Int(4))), CmpOp("==", ListExpr(Str("Nine"), Str("Nine"), Str("Four"), Str("One")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(2), Int(17), Int(30), UnaryOp("-", Int(14)), UnaryOp("-", Int(20)), UnaryOp("-", Int(1)), Int(13), Int(29), Int(16))), CmpOp("==", ListExpr(Str("Two")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(UnaryOp("-", Int(2)), UnaryOp("-", Int(10)), Int(2), UnaryOp("-", Int(10)), Int(28))), CmpOp("==", ListExpr(Str("Two")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(UnaryOp("-", Int(14)), Int(22))), CmpOp("==", ListExpr())))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(2), UnaryOp("-", Int(10)), Int(7), Int(19), Int(4), Int(9))), CmpOp("==", ListExpr(Str("Nine"), Str("Seven"), Str("Four"), Str("Two")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(23), UnaryOp("-", Int(6)), Int(25), UnaryOp("-", Int(9)), Int(19), UnaryOp("-", Int(1)), Int(13))), CmpOp("==", ListExpr())))
  Assert(Compare(Call(Name("by_length"), ListExpr(UnaryOp("-", Int(17)), Int(0), Int(19), UnaryOp("-", Int(13)))), CmpOp("==", ListExpr())))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(26), Int(28), Int(23), UnaryOp("-", Int(9)), Int(27))), CmpOp("==", ListExpr())))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(14), Int(12), Int(16), Int(28), Int(20), Int(20))), CmpOp("==", ListExpr())))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(19), Int(12), Int(4), Int(17), UnaryOp("-", Int(2)), Int(30), Int(13))), CmpOp("==", ListExpr(Str("Four")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(UnaryOp("-", Int(13)), Int(16), Int(6), Int(2), UnaryOp("-", Int(2)), Int(25), UnaryOp("-", Int(4)), Int(16), UnaryOp("-", Int(12)), UnaryOp("-", Int(13)), Int(15))), CmpOp("==", ListExpr(Str("Six"), Str("Two")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(30), Int(5), Int(2), Int(17), Int(29), UnaryOp("-", Int(20)), Int(15))), CmpOp("==", ListExpr(Str("Five"), Str("Two")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(UnaryOp("-", Int(7)), UnaryOp("-", Int(17)), Int(19))), CmpOp("==", ListExpr())))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(0), Int(28))), CmpOp("==", ListExpr())))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(7), Int(8), Int(29), Int(17), Int(12), UnaryOp("-", Int(10)), Int(22), UnaryOp("-", Int(18)), UnaryOp("-", Int(16)), Int(24), Int(20))), CmpOp("==", ListExpr(Str("Eight"), Str("Seven")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(2))), CmpOp("==", ListExpr(Str("Two")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(UnaryOp("-", Int(1)), UnaryOp("-", Int(3)), Int(22), UnaryOp("-", Int(5)), Int(21), Int(3), Int(6), UnaryOp("-", Int(1)), UnaryOp("-", Int(15)))), CmpOp("==", ListExpr(Str("Six"), Str("Three")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(UnaryOp("-", Int(13)), UnaryOp("-", Int(14)), Int(11), Int(30), UnaryOp("-", Int(10)), Int(7), Int(19), Int(1), UnaryOp("-", Int(15)), UnaryOp("-", Int(5)), Int(28), UnaryOp("-", Int(18)))), CmpOp("==", ListExpr(Str("Seven"), Str("One")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(UnaryOp("-", Int(7)), UnaryOp("-", Int(5)), Int(28), UnaryOp("-", Int(13)))), CmpOp("==", ListExpr())))
  Assert(Compare(Call(Name("by_length"), ListExpr(UnaryOp("-", Int(9)), Int(24), Int(13), UnaryOp("-", Int(7)), Int(19))), CmpOp("==", ListExpr())))
  Assert(Compare(Call(Name("by_length"), ListExpr(UnaryOp("-", Int(3)), UnaryOp("-", Int(13)), Int(11), Int(23))), CmpOp("==", ListExpr())))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(14), Int(10), Int(28), UnaryOp("-", Int(20)), Int(18), UnaryOp("-", Int(10)), Int(24), UnaryOp("-", Int(11)))), CmpOp("==", ListExpr())))
  Assert(Compare(Call(Name("by_length"), ListExpr(UnaryOp("-", Int(7)), Int(16), Int(24), UnaryOp("-", Int(17)), Int(21), Int(27), Int(8), Int(0), Int(28), UnaryOp("-", Int(5)), Int(22), Int(29))), CmpOp("==", ListExpr(Str("Eight")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(2), Int(3), UnaryOp("-", Int(20)), UnaryOp("-", Int(8)), Int(0))), CmpOp("==", ListExpr(Str("Three"), Str("Two")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(4), Int(1), Int(21), UnaryOp("-", Int(14)), UnaryOp("-", Int(6)), UnaryOp("-", Int(5)), UnaryOp("-", Int(4)), UnaryOp("-", Int(15)), UnaryOp("-", Int(3)), UnaryOp("-", Int(16)))), CmpOp("==", ListExpr(Str("Four"), Str("One"))))))
