new file mode 100644
index 0000000000000000000000000000000000000000..8b93a27b0939bf0c5e9def8a9976e9f4769041e7
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,21 @@
+def by_length(arr):
+    names = [
+        "One",
+        "Two",
+        "Three",
+        "Four",
+        "Five",
+        "Six",
+        "Seven",
+        "Eight",
+        "Nine",
+    ]
+    values = []
+    for value in arr:
+        if value >= 1 and value <= 9:
+            values.append(value)
+    values = sorted(values, reverse=True)
