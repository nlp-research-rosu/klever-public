+  rule <k>
+         For(
+           Name("value"),
+           list(VS:ValSeq),
+           Expr(
+             Call(
+               Attribute(Name("result"), "append"),
+               Subscript(
+                 Name("names"),
+                 BinOp("-", Name("value"), Int(1))))))
+         => .K
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
+       <heap>
+         ...
+         HN:Int |-> list(NAMES:ValSeq)
+         ...
+         HR:Int |-> (list(.ValSeq) => list(tableNames(VS)))
+         ...
+       </heap>
