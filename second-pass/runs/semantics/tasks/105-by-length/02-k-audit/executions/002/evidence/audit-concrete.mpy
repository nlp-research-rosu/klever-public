Module(
  FuncDef("by_length", Params("arr"),
    Assign(
      Name("names"),
      ListExpr(
        Str("One"),
        Str("Two"),
        Str("Three"),
        Str("Four"),
        Str("Five"),
        Str("Six"),
        Str("Seven"),
        Str("Eight"),
        Str("Nine")))
    Assign(Name("values"), ListExpr())
    For(Name("value"), Name("arr"),
      If(BoolOp(
        "and",
        Compare(Name("value"), CmpOp(">=", Int(1))),
        Compare(Name("value"), CmpOp("<=", Int(9)))),
        Expr(Call(Attribute(Name("values"), "append"), Name("value"))),
        ))
    Assign(
      Name("values"),
      Call(Name("sorted"), Name("values"), KwArg("reverse", Bool(true))))
    Assign(Name("result"), ListExpr())
    For(Name("value"), Name("values"),
      Expr(
        Call(
          Attribute(Name("result"), "append"),
          Subscript(Name("names"), BinOp("-", Name("value"), Int(1))))))
    Return(Name("result")))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(2), Int(1), Int(1), Int(4), Int(5), Int(8), Int(2), Int(3))), CmpOp("==", ListExpr(Str("Eight"), Str("Five"), Str("Four"), Str("Three"), Str("Two"), Str("Two"), Str("One"), Str("One")))))
  Assert(Compare(Call(Name("by_length"), ListExpr()), CmpOp("==", ListExpr())))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(1), UnaryOp("-", Int(1)), Int(55))), CmpOp("==", ListExpr(Str("One")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(0), Int(1), Int(9), Int(10))), CmpOp("==", ListExpr(Str("Nine"), Str("One")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(6), Int(7), Int(8), Int(9))), CmpOp("==", ListExpr(Str("Nine"), Str("Eight"), Str("Seven"), Str("Six"), Str("Five"), Str("Four"), Str("Three"), Str("Two"), Str("One")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(9), Int(9), Int(1), Int(1), UnaryOp("-", Int(1000000)), Int(1000000))), CmpOp("==", ListExpr(Str("Nine"), Str("Nine"), Str("One"), Str("One")))))
  Assert(Compare(Call(Name("by_length"), ListExpr(Int(5), Int(2), Int(8), Int(3), Int(5))), CmpOp("==", ListExpr(Str("Eight"), Str("Five"), Str("Five"), Str("Three"), Str("Two"))))))
