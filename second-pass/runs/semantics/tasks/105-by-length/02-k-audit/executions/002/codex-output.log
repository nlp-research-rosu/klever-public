    48	
    49	  syntax Val ::= "byLengthClosure" [function, total]
    50	  rule byLengthClosure => closureVal("arr", byLengthBody, 0)
    51	
    52	  // Embed an arbitrary sequence of mathematical integers as Python values.
    53	  // Quantifying IS:IntSeq in spec.k therefore covers every finite integer list.
    54	  syntax ValSeq ::= intVals(IntSeq) [function, total]
    55	  rule intVals(.IntSeq) => .ValSeq
    56	  rule intVals(iCons(I:Int, IS:IntSeq)) => vCons(I, intVals(IS))
    57	
    58	  // Contract-level filtering: retain exactly the values in [1, 9], preserving
    59	  // duplicates and their relative order before the trusted sort.
    60	  syntax ValSeq ::= filterDigits(ValSeq) [function, total]
    61	  rule filterDigits(.ValSeq) => .ValSeq
    62	  rule filterDigits(vCons(I:Int, REST:ValSeq))
    63	    => vCons(I, filterDigits(REST))
    64	    requires I >=Int 1 andBool I <=Int 9
    65	  rule filterDigits(vCons(I:Int, REST:ValSeq))
    66	    => filterDigits(REST)
    67	    requires I <Int 1 orBool I >Int 9
    68	
    69	  syntax ValSeq ::= "nameTable" [function, total]
    70	  rule nameTable
    71	    => vCons(str(strToCodes("One")),
    72	       vCons(str(strToCodes("Two")),
    73	       vCons(str(strToCodes("Three")),
    74	       vCons(str(strToCodes("Four")),
    75	       vCons(str(strToCodes("Five")),
    76	       vCons(str(strToCodes("Six")),
    77	       vCons(str(strToCodes("Seven")),
    78	       vCons(str(strToCodes("Eight")),
    79	       vCons(str(strToCodes("Nine")), .ValSeq)))))))))
    80	
    81	  // This is precisely names[value - 1] lifted pointwise to a value sequence.
    82	  syntax ValSeq ::= tableNames(ValSeq) [function, total]
    83	  rule tableNames(.ValSeq) => .ValSeq
    84	  rule tableNames(vCons(I:Int, REST:ValSeq))
    85	    => vCons(valSeqAt(nameTable, I -Int 1), tableNames(REST))
    86	
    87	  // Observe the structure of a returned heap list so that the postcondition
    88	  // states the actual Python return value rather than an allocation address.
    89	  syntax KItem ::= "#observeList"
    90	  rule <k> ref(H:Int) ~> #observeList => list(VS) ... </k>
    91	       <heap> ... H |-> list(VS:ValSeq) ... </heap>
