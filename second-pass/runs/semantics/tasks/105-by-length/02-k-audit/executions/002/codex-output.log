   108	               Call(
   109	                 Attribute(Name("values"), "append"),
   110	                 Name("value"))),
   111	             .Stmts))
   112	         => .K
   113	         ...
   114	       </k>
   115	       <env> L:Int </env>
   116	       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
   117	       <heap>
   118	         ...
   119	         HV:Int |-> (list(.ValSeq) => list(filterDigits(VS)))
   120	         ...
   121	       </heap>
