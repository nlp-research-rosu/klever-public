    96	  // AST rules expose the loops' standard filter/map folds while leaving
    97	  // sorted() itself governed by MPY-SORT.
    98	  rule <k>
    99	         For(
   100	           Name("value"),
   101	           list(VS:ValSeq),
   102	           If(
   103	             BoolOp(
   104	               "and",
   105	               Compare(Name("value"), CmpOp(">=", Int(1))),
   106	               Compare(Name("value"), CmpOp("<=", Int(9)))),
