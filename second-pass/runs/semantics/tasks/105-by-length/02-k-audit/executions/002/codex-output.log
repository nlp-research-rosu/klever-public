===== /reference/canonical.py =====
     1	# canonical.py — the UNMODIFIED HumanEval/105 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: by_length
     4	
     5	
     6	def by_length(arr):
     7	    """
     8	    Given an array of integers, sort the integers that are between 1 and 9 inclusive,
     9	    reverse the resulting array, and then replace each digit by its corresponding name from
    10	    "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine".
    11	
    12	    For example:
    13	      arr = [2, 1, 1, 4, 5, 8, 2, 3]   
    14	            -> sort arr -> [1, 1, 2, 2, 3, 4, 5, 8] 
    15	            -> reverse arr -> [8, 5, 4, 3, 2, 2, 1, 1]
    16	      return ["Eight", "Five", "Four", "Three", "Two", "Two", "One", "One"]
    17	    
    18	      If the array is empty, return an empty array:
    19	      arr = []
    20	      return []
    21	    
    22	      If the array has any strange number ignore it:
    23	      arr = [1, -1 , 55] 
    24	            -> sort arr -> [-1, 1, 55]
    25	            -> reverse arr -> [55, 1, -1]
    26	      return = ['One']
    27	    """
    28	    dic = {
    29	        1: "One",
    30	        2: "Two",
    31	        3: "Three",
    32	        4: "Four",
    33	        5: "Five",
    34	        6: "Six",
    35	        7: "Seven",
    36	        8: "Eight",
    37	        9: "Nine",
    38	    }
    39	    sorted_arr = sorted(arr, reverse=True)
    40	    new_arr = []
    41	    for var in sorted_arr:
    42	        try:
    43	            new_arr.append(dic[var])
    44	        except:
    45	            pass
    46	    return new_arr

===== /candidate/solution.py =====
     1	def by_length(arr):
     2	    names = [
     3	        "One",
     4	        "Two",
     5	        "Three",
     6	        "Four",
     7	        "Five",
     8	        "Six",
     9	        "Seven",
    10	        "Eight",
    11	        "Nine",
    12	    ]
    13	    values = []
    14	    for value in arr:
    15	        if value >= 1 and value <= 9:
    16	            values.append(value)
    17	    values = sorted(values, reverse=True)
    18	    result = []
    19	    for value in values:
    20	        result.append(names[value - 1])
    21	    return result

