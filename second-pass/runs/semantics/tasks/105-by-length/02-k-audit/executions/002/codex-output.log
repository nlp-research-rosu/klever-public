+printf 'MUTATION_STUCK_CHECK_EXIT_STATUS: %s\n' "$stuck_rc"
+if (( prove_rc == 0 || stuck_rc != 0 )); then
+  overall=1
+fi
+
+printf 'EXIT_STATUS: %s\n' "$overall"
+exit "$overall"
