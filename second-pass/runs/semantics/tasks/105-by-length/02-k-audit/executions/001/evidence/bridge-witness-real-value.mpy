Module(
  Assign(Name("values"), ListExpr())
  Assign(Name("value"), Int(99))
  For(
    Name("value"),
    ListExpr(Int(1)),
    If(
      BoolOp(
        "and",
        Compare(Name("value"), CmpOp(">=", Int(1))),
        Compare(Name("value"), CmpOp("<=", Int(9)))),
      Expr(
        Call(
          Attribute(Name("values"), "append"),
          Name("value"))),
      ))
  Assert(Compare(Name("value"), CmpOp("==", Int(1)))))
