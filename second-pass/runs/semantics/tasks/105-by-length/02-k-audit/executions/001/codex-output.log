+} >"$audit_log" 2>&1
+
+exit "$audit_status"

diff --git a//tmp/audit-work/105-by-length/candidate/spec-reviewer-vacuity.k b//tmp/audit-work/105-by-length/candidate/spec-reviewer-vacuity.k
