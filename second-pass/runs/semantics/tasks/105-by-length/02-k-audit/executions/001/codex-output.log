+    Expr(
+      Call(
+        Attribute(Name("result"), "append"),
+        Subscript(
+          Name("names"),
+          BinOp("-", Name("value"), Int(1))))))
+  Assert(Compare(Name("value"), CmpOp("==", Int(1)))))
diff --git a/evidence/map-bridge-witness-stale-value.mpy b/evidence/map-bridge-witness-stale-value.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..43aa87dd3feac1ba8d36d9a5e3ce53dc68debbae
--- /dev/null
+++ b/evidence/map-bridge-witness-stale-value.mpy
@@ -0,0 +1,25 @@
+Module(
