@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module BY-LENGTH-SPEC-REVIEWER-VACUITY-GROUND
+  imports BY-LENGTH-VERIFICATION
+
+  // Deliberately false result for the satisfying input []:
+  // the implementation returns [], not ["One"].
+  claim
+    <k>
+      #applyK(
+        toCall(byLengthClosure),
+        (list(intVals(.IntSeq)), .Vals))
+      ~> #observeList
+    =>
+      list(vCons(str(strToCodes("One")), .ValSeq))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINALHEAP:Map </heap>
+    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/105-by-length/candidate/spec-reviewer-vacuity.k b//tmp/audit-work/105-by-length/candidate/spec-reviewer-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..2076910118de22a44c94cf65b03ac5bc31db6fe1
--- /dev/null
+++ b//tmp/audit-work/105-by-length/candidate/spec-reviewer-vacuity.k
@@ -0,0 +1,36 @@
+requires "verification.k"
+
+module BY-LENGTH-SPEC-REVIEWER-VACUITY
+  imports BY-LENGTH-VERIFICATION
+
+  // Deliberately false mutation: prepend "One" to every result.
+  // IS = .IntSeq satisfies the entry precondition and the real result is [].
+  claim
+    <k>
+      #applyK(
+        toCall(byLengthClosure),
+        (list(intVals(IS:IntSeq)), .Vals))
+      ~> #observeList
+    =>
+      list(
+        vCons(
+          str(strToCodes("One")),
+          tableNames(
+            revVS(
+              sortVS(
+                filterDigits(
+                  intVals(IS)))))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINALHEAP:Map </heap>
+    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
