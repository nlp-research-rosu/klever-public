@@ -0,0 +1,25 @@
+Module(
+  Assign(
+    Name("names"),
+    ListExpr(
+      Str("One"),
+      Str("Two"),
+      Str("Three"),
+      Str("Four"),
+      Str("Five"),
+      Str("Six"),
+      Str("Seven"),
+      Str("Eight"),
+      Str("Nine")))
+  Assign(Name("result"), ListExpr())
+  Assign(Name("value"), Int(99))
+  For(
+    Name("value"),
+    ListExpr(Int(1)),
+    Expr(
