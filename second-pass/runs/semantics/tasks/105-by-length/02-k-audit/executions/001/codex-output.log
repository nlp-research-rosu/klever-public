+    generated = []
+    for _ in range(256):
+        length = rng.randrange(0, 33)
+        generated.append([rng.randint(-1000, 1000) for _ in range(length)])
+
+    cases: list[list[int]] = []
+    seen: set[tuple[int, ...]] = set()
