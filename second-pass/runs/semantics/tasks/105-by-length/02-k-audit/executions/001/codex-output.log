+      ~> #observeList
+    =>
+      list(
+        vCons(
+          str(strToCodes("One")),
+          tableNames(
+            revVS(
+              sortVS(
+                filterDigits(
+                  intVals(IS)))))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
