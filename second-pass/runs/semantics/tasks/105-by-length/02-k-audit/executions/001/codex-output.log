+#!/usr/bin/env bash
+set +e
+
+if (( $# < 2 )); then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 2
+fi
+
+audit_log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  audit_status=$?
+  printf '\nEXIT_STATUS: %d\n' "$audit_status"
+} >"$audit_log" 2>&1
+
+exit "$audit_status"

exec
/bin/bash -lc "/audit-output/evidence/run_logged.sh /audit-output/evidence/00-toolchain.log bash -c 'for audit_tool in kompile kprove krun python3; do command -v \""'$audit_tool"; done; kompile --version; kprove --version; krun --version; python3 --version'"' && cat /audit-output/evidence/00-toolchain.log" in /audit-output
