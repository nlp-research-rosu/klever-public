/bin/bash -lc 'set -o pipefail
python3 /audit-output/evidence/differential_test.py /reference/canonical.py /tmp/audit-work/reconstruction/solution.py 2>&1 | tee /audit-output/evidence/03-differential.log
diff_rc=${PIPESTATUS[0]}
printf '"'EXIT_STATUS=%s\\n' \""'$diff_rc" | tee -a /audit-output/evidence/03-differential.log
exit "$diff_rc"' in /tmp/audit-work/reconstruction
