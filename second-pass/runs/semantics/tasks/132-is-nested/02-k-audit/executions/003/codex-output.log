+                   .Stmts,
+                   .Stmts)
+                .Stmts,
+                .Stmts)
+             .Stmts)
+           .Stmts)
+        Return(Compare(Name("state"), CmpOp("==", Int(4))))
+        .Stmts,
+        0)
+    </k>
+    <env> 0 </env>
+    <scopes> .Map </scopes>
+    <scopeLoc> 0 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
