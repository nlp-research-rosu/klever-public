+      ~> (Return(Compare(Name("state"), CmpOp("==", Int(4))))
+          .Stmts):Stmts
+      ~> #endcall
+      => true
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (1 |-> scope(
+        "state" |-> 2
