+             .Stmts)
+           .Stmts)
+        Return(Compare(Name("state"), CmpOp("==", Int(4))))
+        .Stmts,
+        0)
+    </k>
+    <env> 0 </env>
+    <scopes> .Map </scopes>
+    <scopeLoc> 0 </scopeLoc>
+    <heap> .Map </heap>
