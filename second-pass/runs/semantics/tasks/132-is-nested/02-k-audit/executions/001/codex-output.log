+#!/usr/bin/env bash
+set -u
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local command_status=$?
+  printf '[exit %d]\n' "$command_status"
+  return 0
+}
