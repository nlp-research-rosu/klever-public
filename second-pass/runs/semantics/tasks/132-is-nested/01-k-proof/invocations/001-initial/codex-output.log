+    <scopes>
+      (1 |-> scope(
+        "state" |-> I
+        "char" |-> _CHAR:Val
+        "string" |-> _INPUT:Val,
+        parent(0)) => .Map)
+      0 |-> scope("is_nested" |-> isNestedClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
