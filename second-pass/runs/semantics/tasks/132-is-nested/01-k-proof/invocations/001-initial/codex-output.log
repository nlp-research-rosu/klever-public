+requires "verification.k"
+
+module IS-NESTED-SPEC
+  imports IS-NESTED-VERIFICATION
+
+  claim [empty-input]:
+    <k> Call(Name("is_nested"), str(bCodes(bNil))) => false </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("is_nested" |-> isNestedClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [scan-loop-empty]:
+    <k>
+      #loop(str(.IntSeq), Name("char"), scanBody)
+      ~> Return(Compare(Name("state"), CmpOp("==", Int(4))))
+      ~> #endcall
+      => I:Int ==Int 4
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (1 |-> scope(
+        "state" |-> I
+        "char" |-> _CHAR:Val
+        "string" |-> _INPUT:Val,
+        parent(0)) => .Map)
+      0 |-> scope("is_nested" |-> isNestedClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int I andBool I <=Int 4
+
+  claim [scan-loop-open]:
+    <k>
+      #loop(str(iCons(91, CS:IntSeq)), Name("char"), scanBody)
+      ~> Return(Compare(Name("state"), CmpOp("==", Int(4))))
+      ~> #endcall
+      => scanCodes(openStep(I:Int), CS) ==Int 4
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (1 |-> scope(
+        "state" |-> I
+        "char" |-> _CHAR:Val
+        "string" |-> _INPUT:Val,
+        parent(0)) => .Map)
+      0 |-> scope("is_nested" |-> isNestedClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int I andBool I <=Int 4
+         andBool bracketCodes(CS)
+
+  claim [scan-loop-close]:
+    <k>
+      #loop(str(iCons(93, CS:IntSeq)), Name("char"), scanBody)
+      ~> Return(Compare(Name("state"), CmpOp("==", Int(4))))
+      ~> #endcall
+      => scanCodes(closeStep(I:Int), CS) ==Int 4
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (1 |-> scope(
+        "state" |-> I
+        "char" |-> _CHAR:Val
+        "string" |-> _INPUT:Val,
+        parent(0)) => .Map)
+      0 |-> scope("is_nested" |-> isNestedClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int I andBool I <=Int 4
+         andBool bracketCodes(CS)
+
+  claim [all-bracket-strings]:
+    <k> Call(Name("is_nested"), str(CS:IntSeq)) => nestedCodes(CS) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("is_nested" |-> isNestedClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires bracketCodes(CS)
+endmodule
