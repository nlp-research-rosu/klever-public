index 0000000000000000000000000000000000000000..610c8093bb447b8e62369eaaa0e79b66a8cb2bb7
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def is_nested(string):
+    state = 0
+    char = ''
+    for char in string:
+        if ord(char) == 91:
+            if state < 2:
+                state += 1
+        else:
+            if state > 1:
+                if state < 4:
+                    state += 1
+    return state == 4
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..941bd26abc2dcbc62d0df81fdcfd4a417687fe80
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,66 @@
+requires "verification.k"
+
+module IS-NESTED-LOOP-SPEC
+  imports IS-NESTED-VERIFICATION
+
+  claim [scan-loop]:
+    <k>
+      #loop(str(bCodes(BS:BSeq)), Name("char"), scanBody)
+      ~> (Return(Compare(Name("state"), CmpOp("==", Int(4))))
+          .Stmts):Stmts
+      ~> #endcall
+      => scanState(I:Int, BS) ==Int 4
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (1 |-> scope(
+        "state" |-> I
+        "char" |-> _CHAR:Val
+        "string" |-> _INPUT:Val,
+        parent(0)) => .Map)
+      0 |-> scope("is_nested" |-> isNestedClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int I andBool I <=Int 4
+endmodule
+
+module IS-NESTED-TOP-SPEC
+  imports IS-NESTED-VERIFICATION-WITH-LOOP-LEMMA
+
+  claim [empty-input]:
+    <k> Call(Name("is_nested"), str(bCodes(bNil))) => false </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("is_nested" |-> isNestedClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [all-bracket-strings]:
+    <k> Call(Name("is_nested"), str(bCodes(BS:BSeq))) => nested(BS) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("is_nested" |-> isNestedClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..daa613e5dfe99727db5838d2e83645d8084b97f3
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,116 @@
+requires "reference-semantics/semantics.k"
+
+module IS-NESTED-VERIFICATION
+  imports MPY
+
+  // The translated implementation, factored only to keep the claims readable.
+  syntax Stmts ::= "scanBody" [function]
+  rule scanBody
+    => If(Compare(Call(Name("ord"), Name("char")),
+                 CmpOp("==", Int(91))),
+         If(Compare(Name("state"), CmpOp("<", Int(2))),
+            AugAssign(Name("state"), "+", Int(1))
+            .Stmts,
+            .Stmts)
+         .Stmts,
+         If(Compare(Name("state"), CmpOp(">", Int(1))),
+            If(Compare(Name("state"), CmpOp("<", Int(4))),
+               AugAssign(Name("state"), "+", Int(1))
+               .Stmts,
+               .Stmts)
+            .Stmts,
+            .Stmts)
+         .Stmts)
+       .Stmts
+
+  syntax Stmts ::= "isNestedBody" [function]
+  rule isNestedBody
+    => Assign(Name("state"), Int(0))
+       Assign(Name("char"), Str(""))
+       For(Name("char"), Name("string"), scanBody)
+       Return(Compare(Name("state"), CmpOp("==", Int(4))))
+       .Stmts
+
+  syntax Val ::= "isNestedClosure" [function]
+  rule isNestedClosure
+    => closureVal(("string", .ParamNames), isNestedBody, 0)
+
+  // All and only inputs admitted by the prompt: finite strings of '[' and ']'.
+  syntax BSeq ::= "bNil" | bOpen(BSeq) | bClose(BSeq)
+
+  // bCodes is a symbolic IntSeq encoding.  Its iterator observations are
+  // exactly those of the corresponding native 91/93 code sequence.
+  syntax IntSeq ::= bCodes(BSeq)
+  rule <k> #iterNext(str(bCodes(bNil))) => #iterDone ... </k>
+  rule <k> #iterNext(str(bCodes(bOpen(BS))))
+        => #iterYield(str(iCons(91, .IntSeq)), str(bCodes(BS))) ... </k>
+  rule <k> #iterNext(str(bCodes(bClose(BS))))
+        => #iterYield(str(iCons(93, .IntSeq)), str(bCodes(BS))) ... </k>
+
+  // Independent reference automaton for the subsequence [ [ ] ].
+  syntax Int ::= openStep(Int) [function, total]
+  rule openStep(I)
+    => #if I <Int 2 #then I +Int 1 #else I #fi
+
+  syntax Int ::= closeStep(Int) [function, total]
+  rule closeStep(I)
+    => #if I >Int 1 andBool I <Int 4 #then I +Int 1 #else I #fi
+
+  syntax Int ::= scanState(Int, BSeq) [function, total]
+  rule scanState(I, bNil)       => I
+  rule scanState(I, bOpen(BS))  => scanState(openStep(I), BS)
+  rule scanState(I, bClose(BS)) => scanState(closeStep(I), BS)
+
+  syntax Bool ::= nested(BSeq) [function, total]
+  rule nested(BS) => scanState(0, BS) ==Int 4
+endmodule
+
+// This module is compiled only after IS-NESTED-LOOP-SPEC has proved the rule
+// below against the base module.  It makes that established loop theorem
+// available as a modular lemma for the entry-point proof.
+module IS-NESTED-VERIFICATION-WITH-LOOP-LEMMA
+  imports IS-NESTED-VERIFICATION
+
+  rule [proved-scan-loop]:
+    <k>
+      #loop(str(bCodes(BS:BSeq)), Name("char"),
+        If(Compare(Call(Name("ord"), Name("char")),
+                   CmpOp("==", Int(91))),
+           If(Compare(Name("state"), CmpOp("<", Int(2))),
+              AugAssign(Name("state"), "+", Int(1))
+              .Stmts,
+              .Stmts)
+           .Stmts,
+           If(Compare(Name("state"), CmpOp(">", Int(1))),
+              If(Compare(Name("state"), CmpOp("<", Int(4))),
+                 AugAssign(Name("state"), "+", Int(1))
+                 .Stmts,
+                 .Stmts)
+              .Stmts,
+              .Stmts)
+           .Stmts)
+         .Stmts)
+      ~> (Return(Compare(Name("state"), CmpOp("==", Int(4))))
+          .Stmts):Stmts
+      ~> #endcall
+      => scanState(I:Int, BS) ==Int 4
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (1 |-> scope(
+        "state" |-> I
+        "char" |-> _CHAR:Val
+        "string" |-> _INPUT:Val,
+        parent(0)) => .Map)
+      _REST:Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int I andBool I <=Int 4
+    [priority(40)]
+endmodule

exec
/bin/bash -lc 'bash -n prove.sh && python3 py2mpy.py solution.py > /tmp/solution-regenerated.mpy && cmp -s solution.mpy /tmp/solution-regenerated.mpy && test ! -e NOTES.md && ls -l solution.py solution.mpy verification.k spec.k prove.sh concrete_tests.py concrete_tests.mpy && sha256sum solution.py solution.mpy verification.k spec.k prove.sh' in /work
