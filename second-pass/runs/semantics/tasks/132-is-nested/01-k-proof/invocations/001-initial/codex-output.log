/work/spec.k
/work/verification.k
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..48e1084ebc077ad37c205e37f175bc96e97ff254
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,20 @@
+def is_nested(string):
+    state = 0
+    char = ''
+    for char in string:
+        if ord(char) == 91:
+            if state < 2:
+                state += 1
+        else:
+            if state > 1:
+                if state < 4:
+                    state += 1
+    return state == 4
+
+
+assert is_nested('[[]]')
+assert not is_nested('[]]]]]]][[[[[]')
+assert not is_nested('[][]')
+assert not is_nested('[]')
+assert is_nested('[[][]]')
