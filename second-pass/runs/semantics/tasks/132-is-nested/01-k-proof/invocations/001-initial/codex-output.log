diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c4d53ae9c3ec7e4713ebeb2638cc515624e6ca85
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,63 @@
+requires "verification.k"
+
+module IS-NESTED-SPEC
+  imports IS-NESTED-VERIFICATION
+
+  claim [empty-input]:
+    <k> Call(Name("is_nested"), str(bCodes(bNil))) => false </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("is_nested" |-> isNestedClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [scan-loop]:
+    <k>
+      #loop(str(CS:IntSeq), Name("char"), scanBody)
+      ~> Return(Compare(Name("state"), CmpOp("==", Int(4))))
+      ~> #endcall
+      => scanCodes(I:Int, CS) ==Int 4
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (1 |-> scope(
+        "state" |-> I
+        "char" |-> CHAR:Val
+        "string" |-> INPUT:Val,
+        parent(0)) => .Map)
+      0 |-> scope("is_nested" |-> isNestedClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int I andBool I <=Int 4
+         andBool bracketCodes(CS)
+
+  claim [all-bracket-strings]:
+    <k> Call(Name("is_nested"), str(CS:IntSeq)) => nestedCodes(CS) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("is_nested" |-> isNestedClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires bracketCodes(CS)
+endmodule
