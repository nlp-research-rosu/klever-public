+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [all-bracket-strings]:
+    <k> Call(Name("is_nested"), str(bCodes(BS:BSeq))) => nested(BS) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("is_nested" |-> isNestedClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
