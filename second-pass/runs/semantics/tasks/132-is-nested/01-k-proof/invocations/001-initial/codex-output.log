+        "char" |-> _CHAR:Val
+        "string" |-> _INPUT:Val,
+        parent(0)) => .Map)
+      REST:Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
