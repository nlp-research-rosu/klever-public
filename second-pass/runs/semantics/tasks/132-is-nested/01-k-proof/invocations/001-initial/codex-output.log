from itertools import product, combinations
from solution import is_nested
for n in range(13):
    for xs in product('[]', repeat=n):
        s = ''.join(xs)
        expected = any(''.join(s[i] for i in q) == '[[]]' for q in combinations(range(n), 4))
        assert is_nested(s) == expected, s
print('exhaustive Python check passed through length 12')
PY
krun concrete_tests.mpy --definition runtime-kompiled --output pretty | sed -n '1,6p'" in /work
