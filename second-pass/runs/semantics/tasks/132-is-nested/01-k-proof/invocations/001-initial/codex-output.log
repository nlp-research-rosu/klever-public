new file mode 100644
index 0000000000000000000000000000000000000000..351dfc5b075b6f0241076fa66be5bd042d193c14
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,20 @@
+def is_nested(string):
+    state = 0
+    char = ''
+    for char in string:
+        if char == '[':
+            if state < 2:
+                state += 1
+        else:
+            if state > 1:
+                if state < 4:
+                    state += 1
+    return state == 4
+
+
+assert is_nested('[[]]')
+assert not is_nested('[]]]]]]][[[[[]')
+assert not is_nested('[][]')
+assert not is_nested('[]')
+assert is_nested('[[][]]')
+assert is_nested('[[]][[')
