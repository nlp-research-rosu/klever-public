index 0000000000000000000000000000000000000000..34a259c88a217dacd1cb245cfb2f9f88da5a7af0
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def is_nested(string):
+    state = 0
+    char = ''
+    for char in string:
+        if char == '[':
+            if state < 2:
+                state += 1
+        else:
+            if state > 1:
+                if state < 4:
+                    state += 1
+    return state == 4
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c4d53ae9c3ec7e4713ebeb2638cc515624e6ca85
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,63 @@
+requires "verification.k"
+
+module IS-NESTED-SPEC
+  imports IS-NESTED-VERIFICATION
+
+  claim [empty-input]:
+    <k> Call(Name("is_nested"), str(bCodes(bNil))) => false </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("is_nested" |-> isNestedClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [scan-loop]:
+    <k>
+      #loop(str(CS:IntSeq), Name("char"), scanBody)
+      ~> Return(Compare(Name("state"), CmpOp("==", Int(4))))
+      ~> #endcall
+      => scanCodes(I:Int, CS) ==Int 4
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (1 |-> scope(
+        "state" |-> I
+        "char" |-> CHAR:Val
+        "string" |-> INPUT:Val,
+        parent(0)) => .Map)
+      0 |-> scope("is_nested" |-> isNestedClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int I andBool I <=Int 4
+         andBool bracketCodes(CS)
+
+  claim [all-bracket-strings]:
+    <k> Call(Name("is_nested"), str(CS:IntSeq)) => nestedCodes(CS) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("is_nested" |-> isNestedClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires bracketCodes(CS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..204ab45ceab28c8f7757dcfd106608b4f4d8a1be
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,80 @@
+requires "reference-semantics/semantics.k"
+
+module IS-NESTED-VERIFICATION
+  imports MPY
+
+  // The translated implementation, factored only to keep the claims readable.
+  syntax Stmts ::= "scanBody" [function]
+  rule scanBody
+    => If(Compare(Name("char"), CmpOp("==", Str("["))),
+         If(Compare(Name("state"), CmpOp("<", Int(2))),
+            AugAssign(Name("state"), "+", Int(1))
+            .Stmts,
+            .Stmts)
+         .Stmts,
+         If(Compare(Name("state"), CmpOp(">", Int(1))),
+            If(Compare(Name("state"), CmpOp("<", Int(4))),
+               AugAssign(Name("state"), "+", Int(1))
+               .Stmts,
+               .Stmts)
+            .Stmts,
+            .Stmts)
+         .Stmts)
+       .Stmts
+
+  syntax Stmts ::= "isNestedBody" [function]
+  rule isNestedBody
+    => Assign(Name("state"), Int(0))
+       Assign(Name("char"), Str(""))
+       For(Name("char"), Name("string"), scanBody)
+       Return(Compare(Name("state"), CmpOp("==", Int(4))))
+       .Stmts
+
+  syntax Val ::= "isNestedClosure" [function]
+  rule isNestedClosure
+    => closureVal(("string", .ParamNames), isNestedBody, 0)
+
+  // All and only inputs admitted by the prompt: finite strings of '[' and ']'.
+  syntax BSeq ::= "bNil" | bOpen(BSeq) | bClose(BSeq)
+
+  syntax IntSeq ::= bCodes(BSeq) [function, total]
+  rule bCodes(bNil)      => .IntSeq
+  rule bCodes(bOpen(BS)) => iCons(91, bCodes(BS))
+  rule bCodes(bClose(BS)) => iCons(93, bCodes(BS))
+
+  // Independent reference automaton for the subsequence [ [ ] ].
+  syntax Int ::= openStep(Int) [function, total]
+  rule openStep(I) => I +Int 1 requires I <Int 2
+  rule openStep(I) => I        requires I >=Int 2
+
+  syntax Int ::= closeStep(Int) [function, total]
+  rule closeStep(I) => I +Int 1
+    requires I >Int 1 andBool I <Int 4
+  rule closeStep(I) => I
+    requires I <=Int 1 orBool I >=Int 4
+
+  syntax Int ::= scanState(Int, BSeq) [function, total]
+  rule scanState(I, bNil)       => I
+  rule scanState(I, bOpen(BS))  => scanState(openStep(I), BS)
+  rule scanState(I, bClose(BS)) => scanState(closeStep(I), BS)
+
+  syntax Bool ::= nested(BSeq) [function, total]
+  rule nested(BS) => scanState(0, BS) ==Int 4
+
+  // The same oracle over the semantics' native string representation.  This
+  // form lets symbolic execution decompose an arbitrary input one code at a
+  // time while bracketCodes states the prompt's input precondition.
+  syntax Bool ::= bracketCodes(IntSeq) [function, total]
+  rule bracketCodes(.IntSeq) => true
+  rule bracketCodes(iCons(C, CS))
+    => (C ==Int 91 orBool C ==Int 93) andBool bracketCodes(CS)
+
+  syntax Int ::= scanCodes(Int, IntSeq) [function, total]
+  rule scanCodes(I, .IntSeq)      => I
+  rule scanCodes(I, iCons(91, CS)) => scanCodes(openStep(I), CS)
+  rule scanCodes(I, iCons(C, CS))  => scanCodes(closeStep(I), CS)
+    requires C =/=Int 91
+
+  syntax Bool ::= nestedCodes(IntSeq) [function, total]
+  rule nestedCodes(CS) => scanCodes(0, CS) ==Int 4
+endmodule

exec
/bin/bash -lc "python3 py2mpy.py solution.py > solution.mpy && python3 py2mpy.py concrete_tests.py > concrete_tests.mpy && krun concrete_tests.mpy --definition runtime-kompiled --output pretty | sed -n '1,12p' && kompile verification.k --backend haskell --main-module IS-NESTED-VERIFICATION --syntax-module IS-NESTED-VERIFICATION --output-definition verification-kompiled" in /work
