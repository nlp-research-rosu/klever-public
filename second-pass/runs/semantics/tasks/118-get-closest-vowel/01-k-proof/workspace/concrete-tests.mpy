Module(
  FuncDef("get_closest_vowel", Params("word"),
    If(Compare(Call(Name("len"), Name("word")), CmpOp("<", Int(3))),
      Return(Str("")),
      )
    Assign(
      Name("result"),
      Call(
        Name("get_closest_vowel"),
        Subscript(Name("word"), Slice(Int(1), NoBound, NoBound))))
    If(Name("result"),
      Return(Name("result")),
      )
    If(BoolOp(
      "and",
      Compare(
        Subscript(Name("word"), Int(1)),
        CmpOp("in", Str("AEIOUaeiou"))),
      Compare(
        Subscript(Name("word"), Int(0)),
        CmpOp("not in", Str("AEIOUaeiou"))),
      Compare(
        Subscript(Name("word"), Int(2)),
        CmpOp("not in", Str("AEIOUaeiou")))),
      Return(Subscript(Name("word"), Int(1))),
      )
    Return(Str("")))
  Assert(
    Compare(
      Call(Name("get_closest_vowel"), Str("yogurt")),
      CmpOp("==", Str("u"))))
  Assert(
    Compare(
      Call(Name("get_closest_vowel"), Str("FULL")),
      CmpOp("==", Str("U"))))
  Assert(
    Compare(
      Call(Name("get_closest_vowel"), Str("quick")),
      CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("get_closest_vowel"), Str("ab")),
      CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("get_closest_vowel"), Str("")),
      CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("get_closest_vowel"), Str("bab")),
      CmpOp("==", Str("a"))))
  Assert(
    Compare(
      Call(Name("get_closest_vowel"), Str("xAy")),
      CmpOp("==", Str("A"))))
  Assert(
    Compare(
      Call(Name("get_closest_vowel"), Str("BAZZE")),
      CmpOp("==", Str("A")))))
