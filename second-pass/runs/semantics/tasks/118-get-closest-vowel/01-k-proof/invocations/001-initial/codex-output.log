diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..80fd55d42afa8243d0bdd97c61cb0bd26fbfc5e3
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,23 @@
+def get_closest_vowel(word):
+    if len(word) < 3:
+        return ""
+    result = get_closest_vowel(word[1:])
+    if result:
+        return result
+    if (
+        word[1] in "AEIOUaeiou"
+        and word[0] not in "AEIOUaeiou"
+        and word[2] not in "AEIOUaeiou"
+    ):
+        return word[1]
+    return ""
+
+
+assert get_closest_vowel("yogurt") == "u"
+assert get_closest_vowel("FULL") == "U"
+assert get_closest_vowel("quick") == ""
+assert get_closest_vowel("ab") == ""
+assert get_closest_vowel("") == ""
+assert get_closest_vowel("bab") == "a"
+assert get_closest_vowel("xAy") == "A"
+assert get_closest_vowel("BAZZE") == "A"
