@@ -0,0 +1,10 @@
+def get_closest_vowel(word):
+    if len(word) < 3:
+        return ""
+    if (
+        word[-2] in "AEIOUaeiou"
+        and word[-3] not in "AEIOUaeiou"
+        and word[-1] not in "AEIOUaeiou"
+    ):
+        return word[-2]
+    return get_closest_vowel(word[:-1])
