+  rule closestVowelSpec(CS:IntSeq)
+    => iCons(firstCode(tailCodes(CS)), .IntSeq)
+    requires isLen(CS) >=Int 3
+     andBool closestVowelSpec(tailCodes(CS)) ==K .IntSeq
+     andBool qualifyingFront(CS)
+  rule closestVowelSpec(CS:IntSeq)
+    => .IntSeq
+    requires isLen(CS) >=Int 3
+     andBool closestVowelSpec(tailCodes(CS)) ==K .IntSeq
+     andBool notBool qualifyingFront(CS)
