/bin/bash -lc "chmod +x prove.sh && bash -n prove.sh && python3 py2mpy.py solution.py > /tmp/solution.check.mpy && cmp -s solution.mpy /tmp/solution.check.mpy && echo 'solution.mpy is current; prove.sh syntax is valid'" in /work
