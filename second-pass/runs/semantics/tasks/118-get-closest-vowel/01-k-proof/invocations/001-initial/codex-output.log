+
+  // Contextual induction lemma.  It is generalized over the caller's
+  // continuation and stack, so its circular use is valid at every recursion
+  // depth.  The current Python frame has the module frame as its parent.
+  claim
+    <k> Call(Name("get_closest_vowel"),
+             str(iCons(A:Int, iCons(B:Int, iCons(C:Int, R:IntSeq)))))
+          ~> CONT:K
+      => str(closestVowelSpec(
+               iCons(A, iCons(B, iCons(C, R)))))
+          ~> CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      L  |-> scope(M:Map, parent(0))
+      0  |-> scope(
+              "get_closest_vowel"
