@@ -0,0 +1,59 @@
+requires "reference-semantics/semantics.k"
+
+module HUMAN-EVAL-118-VERIFICATION
+  imports MPY
+
+  // The exact function body generated in solution.mpy.
+  syntax Stmts ::= "getClosestBody" [macro]
+  rule getClosestBody
+    => If(Compare(Call(Name("len"), Name("word")), CmpOp("<", Int(3))),
+          Return(Str("")),
+          .Stmts)
+       If(BoolOp("and",
+            Compare(Subscript(Name("word"), UnaryOp("-", Int(2))),
+                    CmpOp("in", Str("AEIOUaeiou"))),
+            Compare(Subscript(Name("word"), UnaryOp("-", Int(3))),
+                    CmpOp("not in", Str("AEIOUaeiou"))),
+            Compare(Subscript(Name("word"), UnaryOp("-", Int(1))),
+                    CmpOp("not in", Str("AEIOUaeiou")))),
+          Return(Subscript(Name("word"), UnaryOp("-", Int(2)))),
+          .Stmts)
+       Return(Call(Name("get_closest_vowel"),
+                   Subscript(Name("word"),
+                             Slice(NoBound, UnaryOp("-", Int(1)), NoBound))))
+       .Stmts
+
+  // A code-level statement of the contract.  The three equations mirror the
+  // exhaustive cases: too short, a qualifying penultimate vowel, and removal
+  // of the non-qualifying final character.  closestVowelSpec returns either
+  // the empty code sequence or the singleton code sequence of the rightmost
+  // qualifying vowel.
+  syntax Bool ::= isVowelCode(Int) [function, total]
+  rule isVowelCode(C:Int)
+    => C ==Int 65 orBool C ==Int 69 orBool C ==Int 73
+       orBool C ==Int 79 orBool C ==Int 85
+       orBool C ==Int 97 orBool C ==Int 101 orBool C ==Int 105
+       orBool C ==Int 111 orBool C ==Int 117
+
+  syntax Bool ::= qualifyingPenultimate(IntSeq) [function]
+  rule qualifyingPenultimate(CS:IntSeq)
+    => isVowelCode(intSeqAt(CS, isLen(CS) -Int 2))
+       andBool notBool isVowelCode(intSeqAt(CS, isLen(CS) -Int 3))
+       andBool notBool isVowelCode(intSeqAt(CS, isLen(CS) -Int 1))
+
+  syntax IntSeq ::= dropLastCode(IntSeq) [function]
+  rule dropLastCode(CS:IntSeq)
+    => buildIS(CS, 0, isLen(CS) -Int 1, 1)
+
+  syntax IntSeq ::= closestVowelSpec(IntSeq) [function]
+  rule closestVowelSpec(CS:IntSeq) => .IntSeq
+    requires isLen(CS) <Int 3
+  rule closestVowelSpec(CS:IntSeq)
+    => iCons(intSeqAt(CS, isLen(CS) -Int 2), .IntSeq)
+    requires isLen(CS) >=Int 3
+     andBool qualifyingPenultimate(CS)
+  rule closestVowelSpec(CS:IntSeq)
+    => closestVowelSpec(dropLastCode(CS))
+    requires isLen(CS) >=Int 3
+     andBool notBool qualifyingPenultimate(CS)
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module HUMAN-EVAL-118-SPEC' in /work
