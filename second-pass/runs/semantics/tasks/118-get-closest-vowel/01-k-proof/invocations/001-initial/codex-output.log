+       requires isLen(CS) >=Int 1
+       [priority(40)]
+  rule <k> Subscript(str(CS:IntSeq), Int(1))
+        => str(iCons(firstCode(tailCodes(CS)), .IntSeq)) ... </k>
+       requires isLen(CS) >=Int 2
+       [priority(40)]
+  rule <k> Subscript(str(CS:IntSeq), Int(2))
+        => str(iCons(firstCode(tailCodes(tailCodes(CS))), .IntSeq)) ... </k>
+       requires isLen(CS) >=Int 3
+       [priority(40)]
+
+  syntax IntSeq ::= "vowelCodes" [macro]
+  rule vowelCodes
+    => iCons(65, iCons(69, iCons(73, iCons(79, iCons(85,
+       iCons(97, iCons(101, iCons(105, iCons(111, iCons(117,
+       .IntSeq))))))))))
+
+  rule strContains(iCons(C:Int, .IntSeq), vowelCodes)
+    => isVowelCode(C)
