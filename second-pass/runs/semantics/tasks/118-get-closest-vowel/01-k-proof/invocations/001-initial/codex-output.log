def oracle(word):
    for i in range(len(word) - 2, 0, -1):
        if word[i] in vowels and word[i - 1] not in vowels and word[i + 1] not in vowels:
            return word[i]
    return ''

checked = 0
for length in range(8):
    for chars in product('abEzy', repeat=length):
        word = ''.join(chars)
        assert get_closest_vowel(word) == oracle(word), word
        checked += 1
print(f'{checked} exhaustive CPython/oracle cases passed')
