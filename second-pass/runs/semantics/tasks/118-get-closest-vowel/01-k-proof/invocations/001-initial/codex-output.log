index 0000000000000000000000000000000000000000..63d8f7e9d667b2be89bda645166a19b73f90beba
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,25 @@
+requires "verification.k"
+
+module HUMAN-EVAL-118-SPEC
+  imports HUMAN-EVAL-118-VERIFICATION
+
+  claim
+    <k> Call(Name("get_closest_vowel"), str(CS:IntSeq))
+      => str(closestVowelSpec(CS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "get_closest_vowel"
+               |-> closureVal("word", getClosestBody, 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a17fe50dfbedbee7e27a4bc82b8d7f41155dcc97
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,108 @@
+requires "reference-semantics/semantics.k"
+
+module HUMAN-EVAL-118-VERIFICATION
+  imports MPY
+
+  // The exact function body generated in solution.mpy.
+  syntax Stmts ::= "getClosestBody" [macro]
+  rule getClosestBody
+    => If(Compare(Call(Name("len"), Name("word")), CmpOp("<", Int(3))),
+          Return(Str("")),
+          .Stmts)
+       Assign(Name("result"),
+         Call(Name("get_closest_vowel"),
+              Subscript(Name("word"), Slice(Int(1), NoBound, NoBound))))
+       If(Name("result"),
+          Return(Name("result")),
+          .Stmts)
+       If(BoolOp("and",
+            Compare(Subscript(Name("word"), Int(1)),
+                    CmpOp("in", Str("AEIOUaeiou"))),
+            Compare(Subscript(Name("word"), Int(0)),
+                    CmpOp("not in", Str("AEIOUaeiou"))),
+            Compare(Subscript(Name("word"), Int(2)),
+                    CmpOp("not in", Str("AEIOUaeiou")))),
+          Return(Subscript(Name("word"), Int(1))),
+          .Stmts)
+       Return(Str(""))
+       .Stmts
+
+  // A code-level statement of the contract.  closestVowelSpec returns either
+  // the empty code sequence or the singleton code sequence of the rightmost
+  // qualifying vowel.
+  syntax Bool ::= isVowelCode(Int) [function, total]
+  rule isVowelCode(C:Int)
+    => C ==Int 65 orBool C ==Int 69 orBool C ==Int 73
+       orBool C ==Int 79 orBool C ==Int 85
+       orBool C ==Int 97 orBool C ==Int 101 orBool C ==Int 105
+       orBool C ==Int 111 orBool C ==Int 117
+
+  syntax Bool ::= qualifyingTriple(Int, Int, Int) [function, total]
+  rule qualifyingTriple(A:Int, B:Int, C:Int)
+    => notBool isVowelCode(A)
+       andBool isVowelCode(B)
+       andBool notBool isVowelCode(C)
+
+  syntax IntSeq ::= tailCodes(IntSeq) [function, total]
+  rule tailCodes(.IntSeq) => .IntSeq
+  rule tailCodes(iCons(_:Int, R:IntSeq)) => R
+
+  syntax Int ::= firstCode(IntSeq) [function, total]
+  rule firstCode(.IntSeq) => 0
+  rule firstCode(iCons(C:Int, _:IntSeq)) => C
+
+  syntax Bool ::= qualifyingFront(IntSeq) [function, total]
+  rule qualifyingFront(CS:IntSeq)
+    => qualifyingTriple(firstCode(CS),
+                        firstCode(tailCodes(CS)),
+                        firstCode(tailCodes(tailCodes(CS))))
+
+  // This reference scans the tail first.  A nonempty tail result is therefore
+  // already the rightmost answer; only an empty tail permits the current
+  // three-character window to contribute its middle character.
+  syntax IntSeq ::= closestVowelSpec(IntSeq) [function, total]
+  rule closestVowelSpec(CS:IntSeq) => .IntSeq
+    requires isLen(CS) <Int 3
+  rule closestVowelSpec(CS:IntSeq)
+    => closestVowelSpec(tailCodes(CS))
+    requires isLen(CS) >=Int 3
+     andBool closestVowelSpec(tailCodes(CS)) =/=K .IntSeq
+  rule closestVowelSpec(CS:IntSeq)
+    => iCons(firstCode(tailCodes(CS)), .IntSeq)
+    requires isLen(CS) >=Int 3
+     andBool closestVowelSpec(tailCodes(CS)) ==K .IntSeq
+     andBool qualifyingFront(CS)
+  rule closestVowelSpec(CS:IntSeq)
+    => .IntSeq
+    requires isLen(CS) >=Int 3
+     andBool closestVowelSpec(tailCodes(CS)) ==K .IntSeq
+     andBool notBool qualifyingFront(CS)
+
+  // Extensional proof lemmas for the four observations made by the program.
+  // Their length guards are established by the surrounding len(word) branch.
+  rule <k> Subscript(str(CS:IntSeq), Slice(Int(1), NoBound, NoBound))
+        => str(tailCodes(CS)) ... </k>
+       requires isLen(CS) >=Int 1
+       [priority(40)]
+  rule <k> Subscript(str(CS:IntSeq), Int(0))
+        => str(iCons(firstCode(CS), .IntSeq)) ... </k>
+       requires isLen(CS) >=Int 1
+       [priority(40)]
+  rule <k> Subscript(str(CS:IntSeq), Int(1))
+        => str(iCons(firstCode(tailCodes(CS)), .IntSeq)) ... </k>
+       requires isLen(CS) >=Int 2
+       [priority(40)]
+  rule <k> Subscript(str(CS:IntSeq), Int(2))
+        => str(iCons(firstCode(tailCodes(tailCodes(CS))), .IntSeq)) ... </k>
+       requires isLen(CS) >=Int 3
+       [priority(40)]
+
+  syntax IntSeq ::= "vowelCodes" [macro]
+  rule vowelCodes
+    => iCons(65, iCons(69, iCons(73, iCons(79, iCons(85,
+       iCons(97, iCons(101, iCons(105, iCons(111, iCons(117,
+       .IntSeq))))))))))
+
+  rule strContains(iCons(C:Int, .IntSeq), vowelCodes)
+    => isVowelCode(C)
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..8db365d8bc76a0826f7936555639a62913f5a4e1
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def get_closest_vowel(word):
+    if len(word) < 3:
+        return ""
+    result = get_closest_vowel(word[1:])
+    if result:
+        return result
+    if (
+        word[1] in "AEIOUaeiou"
+        and word[0] not in "AEIOUaeiou"
+        and word[2] not in "AEIOUaeiou"
+    ):
+        return word[1]
+    return ""
