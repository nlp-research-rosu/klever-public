+find \
+  /candidate \
+  /reference \
+  /generation-evidence \
+  -type f -print0 |
+  sort -z |
+  xargs -0 sha256sum
+
+printf '%s\n' 'COMMAND: find mounted inputs -printf entry-type/path/link-target'
