@@ -0,0 +1,17 @@
+def get_closest_vowel(word):
+    if len(word) < 3:
+        return "X"
+    result = get_closest_vowel(word[1:])
+    if result:
+        return result
+    if (
+        word[1] in "AEIOUaeiou"
+        and word[0] not in "AEIOUaeiou"
+        and word[2] not in "AEIOUaeiou"
+    ):
+        return word[1]
+    return ""
+
+
+assert get_closest_vowel("bab") == "X"
+assert get_closest_vowel("bab") != "a"
diff --git a//tmp/audit-work/body-mutation/spec-mutant-false.k b//tmp/audit-work/body-mutation/spec-mutant-false.k
new file mode 100644
index 0000000000000000000000000000000000000000..cd71b25bb618e8549fc998f19387efdf35a7fd4d
--- /dev/null
+++ b//tmp/audit-work/body-mutation/spec-mutant-false.k
@@ -0,0 +1,28 @@
+requires "verification.k"
+
+module AUDIT-MUTANT-FALSE
+  imports HUMAN-EVAL-118-VERIFICATION
+
+  // This postcondition is false for the mutated body: CPython and fixed K
+  // execution both return "X" on "bab".
+  claim
+    <k> Call(Name("get_closest_vowel"),
+             str(iCons(98, iCons(97, iCons(98, .IntSeq)))))
+      => str(iCons(97, .IntSeq))
+    </k>
+    <env> 0 </env>
