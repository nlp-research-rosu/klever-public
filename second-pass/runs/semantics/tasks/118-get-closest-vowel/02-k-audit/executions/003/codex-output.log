+  // These four claims exhaust the algebraic IntSeq input domain.
+  claim
+    <k> Call(Name("get_closest_vowel"), str(.IntSeq))
+      => str(.IntSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "get_closest_vowel"
+               |-> closureVal("word", getClosestBody, 0),
+             parent(-1))
