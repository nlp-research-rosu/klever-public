from pathlib import Path
import hashlib,os,stat
for root in map(Path,['/candidate','/reference/reference-semantics']):
 es=[]; pending=[root]
 while pending:
  d=pending.pop()
  for c in os.scandir(d):
   p=Path(c.path); m=c.stat(follow_symlinks=False).st_mode; r=p.relative_to(root).as_posix()
   if stat.S_ISDIR(m): es.append((r,'directory',p)); pending.append(p)
   elif stat.S_ISREG(m): es.append((r,'file',p))
   else: es.append((r,'other',p))
 h=hashlib.sha256()
 for r,k,p in sorted(es):
  h.update(r.encode()+b'\\0'+k.encode()+b'\\0')
  if k=='file':h.update(p.read_bytes())
 print(root,h.hexdigest(),len(es))
PY" in /audit-output
