    97	  rule isLen(CS:IntSeq) <Int 0 => false [simplification]
    98	  rule isLen(CS:IntSeq) >=Int 0 => true [simplification]
    99	  rule isLen(CS:IntSeq) +Int 3 <Int 3 => false [simplification]
