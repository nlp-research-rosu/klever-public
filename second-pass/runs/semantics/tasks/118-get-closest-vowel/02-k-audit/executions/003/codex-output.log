+if (( dry_status == 0 && proof_status != 0 && residual_status == 0 )); then
+  printf '%s\n' 'NONVACUITY_RESULT: PASS (well-formed false mutation rejected for the expected unmet result)'
+  exit 0
+fi
+
+printf '%s\n' 'NONVACUITY_RESULT: FAIL'
+exit 1

