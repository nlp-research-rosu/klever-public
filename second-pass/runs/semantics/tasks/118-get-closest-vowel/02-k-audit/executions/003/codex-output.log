kprove --help | sed -n '1,220p'" in /tmp/audit-work/reconstruction
diff --git a//tmp/audit-work/reconstruction/audit-concrete.py b//tmp/audit-work/reconstruction/audit-concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..fe46813703c9b2db3f8cfc387b5684d6539948ca
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-concrete.py
@@ -0,0 +1,24 @@
+def get_closest_vowel(word):
+    if len(word) < 3:
+        return ""
+    result = get_closest_vowel(word[1:])
+    if result:
+        return result
+    if (
+        word[1] in "AEIOUaeiou"
+        and word[0] not in "AEIOUaeiou"
+        and word[2] not in "AEIOUaeiou"
+    ):
+        return word[1]
+    return ""
+
+
+assert get_closest_vowel("") == ""
+assert get_closest_vowel("a") == ""
+assert get_closest_vowel("ab") == ""
+assert get_closest_vowel("bab") == "a"
+assert get_closest_vowel("yogurt") == "u"
+assert get_closest_vowel("FULL") == "U"
+assert get_closest_vowel("quick") == ""
+assert get_closest_vowel("BAZZE") == "A"
+assert get_closest_vowel("zzAzzEzz") == "E"
