+      0 |-> scope(
+             "get_closest_vowel"
+               |-> closureVal("word", getClosestBody, 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
