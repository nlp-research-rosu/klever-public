+}
+
+echo '== Candidate bridge fabricates a result with an already-pending return =='
+run_bounded kprove bridge-retstate-witness.k \
+  --definition audit-proof-kompiled \
+  --spec-module AUDIT-BRIDGE-RETSTATE
+bridge_rc=$?
+if (( bridge_rc != 0 )); then
