+  lines=$(wc -l <"$out")
+  printf '[output lines %d]\n' "$lines"
+  if (( lines <= 200 )); then
+    sed -n '1,200p' "$out"
+  else
+    sed -n '1,130p' "$out"
+    printf '[... %d lines omitted ...]\n' "$((lines - 200))"
+    tail -n 70 "$out"
+  fi
+  printf '[exit %d]\n' "$rc"
+  return "$rc"
+}
