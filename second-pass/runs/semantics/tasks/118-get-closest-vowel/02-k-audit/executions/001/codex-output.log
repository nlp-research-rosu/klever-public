+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  rc=$?
+  printf '[exit %d]\n' "$rc"
+  if (( rc != 0 )); then
+    overall=1
+  fi
+}
+
+echo '== Regenerate the submitted MPY with the trusted translator =='
