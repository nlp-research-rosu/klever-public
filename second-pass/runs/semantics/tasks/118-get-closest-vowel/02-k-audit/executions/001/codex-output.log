+      => str(closestVowelSpec(
+               iCons(A, iCons(B, iCons(C, R)))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "get_closest_vowel"
+               |-> closureVal("word", getClosestBody, 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
