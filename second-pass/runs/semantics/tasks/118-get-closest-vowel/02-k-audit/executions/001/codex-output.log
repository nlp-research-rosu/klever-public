+if (( fixed_rc == 0 )); then
+  echo 'UNEXPECTED: bridge-free execution reached the fabricated result'
+  overall=1
+else
+  echo 'EXPECTED: bridge-free execution is stuck with retV(7), not at str(.IntSeq)'
+fi
+
+exit "$overall"
