        if line == 105:
            return "ACCEPT_FRESH_MAP_UPDATE_NORMALIZATION"
        return "REVIEW_PROOF_LOCAL_DECLARATION"
    return "UNCLASSIFIED"


rows = []
for path in files:
    lines = path.read_text().splitlines()
    starts = []
    for index, line_text in enumerate(lines):
        match = start_re.match(line_text)
        if match:
            starts.append((index, match.group(1)))
    for pos, (index, kind) in enumerate(starts):
        next_index = starts[pos + 1][0] if pos + 1 < len(starts) else len(lines)
        block_lines = []
        for block_line in lines[index:next_index]:
            if block_line.strip() == "endmodule":
                break
            if block_line.lstrip().startswith("//"):
                continue
            block_lines.append(block_line.strip())
        normalized = " ".join(part for part in block_lines if part)
        normalized = re.sub(r"\s+", " ", normalized)
        attrs = ",".join(
            re.sub(r"\s+", " ", value.strip())
            for value in attr_re.findall(normalized)
            if attribute_word_re.search(value)
        )
        relevance = "USED_PATH" if any(token in normalized for token in used_tokens) else "UNUSED_PATH"
        rows.append(
            {
                "id": f"K{len(rows) + 1:04d}",
     1	requires "reference-semantics/semantics.k"
     2	
     3	module HUMAN-EVAL-118-VERIFICATION
     4	  imports MPY
     5	
     6	  // The exact function body generated in solution.mpy.
     7	  syntax Stmts ::= "getClosestBody" [macro]
     8	  rule getClosestBody
     9	    => If(Compare(Call(Name("len"), Name("word")), CmpOp("<", Int(3))),
    10	          Return(Str("")),
    11	          .Stmts)
    12	       Assign(Name("result"),
    13	         Call(Name("get_closest_vowel"),
    14	              Subscript(Name("word"), Slice(Int(1), NoBound, NoBound))))
    15	       If(Name("result"),
    16	          Return(Name("result")),
    17	          .Stmts)
    18	       If(BoolOp("and",
    19	            Compare(Subscript(Name("word"), Int(1)),
    20	                    CmpOp("in", Str("AEIOUaeiou"))),
    21	            Compare(Subscript(Name("word"), Int(0)),
    22	                    CmpOp("not in", Str("AEIOUaeiou"))),
    23	            Compare(Subscript(Name("word"), Int(2)),
    24	                    CmpOp("not in", Str("AEIOUaeiou")))),
    25	          Return(Subscript(Name("word"), Int(1))),
    26	          .Stmts)
    27	       Return(Str(""))
    28	       .Stmts
    29	
    30	  // A code-level statement of the contract.  closestVowelSpec returns either
    31	  // the empty code sequence or the singleton code sequence of the rightmost
    32	  // qualifying vowel.
    33	  syntax Bool ::= isVowelCode(Int) [function, total]
    34	  rule isVowelCode(C:Int)
    35	    => C ==Int 65 orBool C ==Int 69 orBool C ==Int 73
    36	       orBool C ==Int 79 orBool C ==Int 85
    37	       orBool C ==Int 97 orBool C ==Int 101 orBool C ==Int 105
    38	       orBool C ==Int 111 orBool C ==Int 117
    39	
    40	  syntax Bool ::= qualifyingTriple(Int, Int, Int) [function, total]
    41	  rule qualifyingTriple(A:Int, B:Int, C:Int)
    42	    => notBool isVowelCode(A)
    43	       andBool isVowelCode(B)
    44	       andBool notBool isVowelCode(C)
    45	
    46	  // This reference scans the tail first.  A nonempty tail result is therefore
    47	  // already the rightmost answer; only an empty tail permits the current
    48	  // three-character window to contribute its middle character.
    49	  syntax IntSeq ::= closestVowelSpec(IntSeq) [function, total]
    50	  rule closestVowelSpec(CS:IntSeq) => .IntSeq
    51	    requires isLen(CS) <Int 3
    52	  rule closestVowelSpec(.IntSeq) => .IntSeq
    53	  rule closestVowelSpec(iCons(_:Int, .IntSeq)) => .IntSeq
    54	  rule closestVowelSpec(iCons(_:Int, iCons(_:Int, .IntSeq))) => .IntSeq
    55	  rule closestVowelSpec(iCons(A:Int, iCons(B:Int, iCons(C:Int, R:IntSeq))))
    56	    => closestVowelSpec(iCons(B, iCons(C, R)))
    57	    requires closestVowelSpec(iCons(B, iCons(C, R))) =/=K .IntSeq
    58	  rule closestVowelSpec(iCons(A:Int, iCons(B:Int, iCons(C:Int, R:IntSeq))))
    59	    => iCons(B, .IntSeq)
    60	    requires closestVowelSpec(iCons(B, iCons(C, R))) ==K .IntSeq
    61	     andBool qualifyingTriple(A, B, C)
    62	  rule closestVowelSpec(iCons(A:Int, iCons(B:Int, iCons(C:Int, R:IntSeq))))
    63	    => .IntSeq
    64	    requires closestVowelSpec(iCons(B, iCons(C, R))) ==K .IntSeq
    65	     andBool notBool qualifyingTriple(A, B, C)
    66	
    67	  // Valid for every nonempty string: Python's [1:] slice is its code tail.
    68	  // This proof lemma avoids expanding buildIS one index at a time.
    69	  rule <k> Subscript(str(iCons(_:Int, R:IntSeq)),
    70	                     Slice(Int(1), NoBound, NoBound))
