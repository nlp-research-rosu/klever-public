inv=json.load(open('/reference/rule-inventory.json'))
out=json.load(open('/workspace/trust-boundary.json'))
assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
expected=[r['source_rule_id'] for r in inv['rules']]
actual=[r['source_rule_id'] for r in out['rules']]
assert actual == expected
assert len(actual) == len(set(actual)) == len(expected)
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
for r in out['rules']:
    assert list(r) == ['source_rule_id','classification','rationale']
    assert r['classification'] in allowed
    assert isinstance(r['rationale'],str) and r['rationale'].strip()
by_id={r['source_rule_id']:r for r in out['rules']}
for r in inv['rules']:
    if 'simplification' in r['attributes']:
        assert by_id[r['source_rule_id']]['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
print('validated_rules', len(actual))
print('classifications', dict(Counter(r['classification'] for r in out['rules'])))
print('inventory_sha256', out['inventory_sha256'])
PY
