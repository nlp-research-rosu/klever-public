    41	      (OH |-> list(OALL))
    42	      (RH |-> list(ACC))
    43	      HEAP
    44	    =>
    45	      (EH |-> list(EVS))
    46	      (OH |-> list(OALL))
    47	      (RH |-> list(valSeqConcat(ACC, pairedVS(EVS, OVS, I))))
    48	      HEAP
    49	    </heap>
    50	  // Entry-point theorem.  sortVS is the supplied semantics' trusted,
    51	  // opaque ascending sort.  assembledEvenSort alternates that sorted even
    52	  // subsequence with the untouched odd subsequence.
    53	  claim [sort-even-correct]:
    54	    <k>
    55	      Call(Name("sort_even"), list(VS))
    56	      ~> #observeResult
    57	    =>
    58	      list(
    59	        assembledEvenSort(
    60	          sortVS(evenIndices(VS)),
    61	          oddIndices(VS)))
    62	    </k>
    63	    <env> 0 </env>
    64	    <scopes>
    65	      (0 |-> scope(
    66	        ("sort_even" |-> sortEvenClosure),
    67	        parent(-1)))
    68	      (-1 |-> builtinsScope)
    69	    </scopes>
    70	    <scopeLoc> 1 </scopeLoc>
    71	    <heap> .Map => ?HEAP </heap>
    72	    <heapLoc> 0 => ?HL </heapLoc>
    73	    <stack> .List </stack>
