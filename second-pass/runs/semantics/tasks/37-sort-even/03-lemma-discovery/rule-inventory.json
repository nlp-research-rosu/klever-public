      "text": "  rule loopBody =>\n    Expr(\n      Call(\n        Attribute(Name(\"result\"), \"append\"),\n        Subscript(Name(\"evens\"), Name(\"i\"))))\n    Expr(Call(Attribute(Name(\"result\"), \"append\"), Name(\"odd\")))\n    AugAssign(Name(\"i\"), \"+\", Int(1))"
    },
    {
      "attributes": [],
      "end_line": 36,
