   116	  // Returned Python lists are heap references.  Observe their structural
   117	  // value so the postcondition is independent of fresh heap addresses.
   118	  syntax KItem ::= "#observeResult"
   119	  rule <k> ref(H:Int) ~> #observeResult => V ... </k>
   120	       <heap> ... H |-> V:Val ... </heap>
   121	       [priority(40)]
   122	  rule <k> V:Val ~> #observeResult => V ... </k>
   123	       requires notBool isRefV(V)
   124	endmodule

