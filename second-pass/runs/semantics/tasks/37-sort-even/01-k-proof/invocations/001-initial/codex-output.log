+      ~> K
+    =>
+      ref(?RH) ~> K
+    </k>
+    <env> L </env>
+    <scopes>
+      (0 |-> scope(
+        ("_interleave" |-> interleaveClosure)
+        ("sort_even" |-> sortEvenClosure),
+        parent(-1)))
+      (-1 |-> builtinsScope)
+      SC
+    </scopes>
+    <scopeLoc> SL </scopeLoc>
+    <heap>
+      (EH |-> list(EVS))
+      (OH |-> list(OVS))
+      HEAP
+    =>
+      (?RH |-> list(weaveVS(EVS, OVS)))
+      ?HEAP2
+    </heap>
+    <heapLoc> HL => ?HL2 </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires SL >Int 0
+     andBool notBool HL in_keys(
+       (EH |-> list(EVS)) (OH |-> list(OVS)) HEAP)
+
+  claim [label(sort-even-correct)]:
+    <k>
+      Call(Name("sort_even"), list(VS))
+      ~> #observeResult
+    =>
+      list(weaveVS(sortVS(evenIndices(VS)), oddIndices(VS)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(
+        ("_interleave" |-> interleaveClosure)
+        ("sort_even" |-> sortEvenClosure),
+        parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?HEAP </heap>
+    <heapLoc> 0 => ?HL </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
