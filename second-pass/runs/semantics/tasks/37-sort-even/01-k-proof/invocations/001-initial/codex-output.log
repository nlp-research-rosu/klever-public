diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..e128708d3bbea066c6c4ceaa9396ff1374a2bef9
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,18 @@
+def sort_even(l: list):
+    evens = sorted(l[::2])
+    odds = l[1::2]
+    result = []
+    i = 0
+    odd = 0
+    for odd in odds:
+        result.append(evens[i])
+        result.append(odd)
+        i += 1
+    return result + evens[len(odds):]
+
+
+assert sort_even([]) == []
+assert sort_even([7]) == [7]
+assert sort_even([1, 2, 3]) == [1, 2, 3]
+assert sort_even([5, 6, 3, 4]) == [3, 6, 5, 4]
+assert sort_even([9, -1, 3, -2, 3, -3, 0]) == [0, -1, 3, -2, 3, -3, 9]
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..9c2e8ee6edf38eb94d011de9db3c6b4aebce9db3
