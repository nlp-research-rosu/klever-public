+def _interleave(evens, odds):
+    if not odds:
+        return evens
+    return [evens[0], odds[0]] + _interleave(evens[1:], odds[1:])
+
+
+def sort_even(l: list):
+    evens = sorted(l[::2])
+    odds = l[1::2]
+    return _interleave(evens, odds)
