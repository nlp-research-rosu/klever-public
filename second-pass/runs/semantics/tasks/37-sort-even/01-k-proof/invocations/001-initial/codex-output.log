+
+  syntax Val ::= "interleaveClosure" [function, total]
+               | "sortEvenClosure"   [function, total]
+  rule interleaveClosure =>
+    closureVal(("evens", "odds"), interleaveBody, 0)
+  rule sortEvenClosure =>
+    closureVal(("l"), sortEvenBody, 0)
+
+  // dropOneVS is exactly the ValSeq produced by Python's [1:] slice.
+  syntax ValSeq ::= dropOneVS(ValSeq) [function, total]
+  rule dropOneVS(VS:ValSeq) =>
+    buildVS(
+      VS,
+      slStart(someB(1), noB, vsLen(VS)),
+      slStop(noB, noB, vsLen(VS)),
+      slStep(noB))
+
+  // weaveVS states the functional contract of _interleave: consume one
+  // sorted even value for every untouched odd value, preserving a possible
+  // final extra even value.
+  syntax ValSeq ::= weaveVS(ValSeq, ValSeq) [function, total]
+  rule weaveVS(EVS:ValSeq, .ValSeq) => EVS
+  rule weaveVS(EVS:ValSeq, vCons(O:Val, OS:ValSeq)) =>
+    vCons(
+      valSeqAt(EVS, 0),
+      vCons(
+        O,
+        weaveVS(
+          dropOneVS(EVS),
+          dropOneVS(vCons(O, OS)))))
+
+  syntax ValSeq ::= evenIndices(ValSeq) [function, total]
+                  | oddIndices(ValSeq)  [function, total]
+  rule evenIndices(VS:ValSeq) =>
+    buildVS(
+      VS,
+      slStart(noB, someB(2), vsLen(VS)),
+      slStop(noB, someB(2), vsLen(VS)),
+      slStep(someB(2)))
+  rule oddIndices(VS:ValSeq) =>
+    buildVS(
+      VS,
+      slStart(someB(1), someB(2), vsLen(VS)),
+      slStop(noB, someB(2), vsLen(VS)),
+      slStep(someB(2)))
+
+  // Returned Python lists are heap references.  This continuation observes
+  // their structural value, making the postconditions independent of fresh
+  // heap addresses and temporary allocations.
+  syntax KItem ::= "#observeResult"
+  rule <k> ref(H:Int) ~> #observeResult => V ... </k>
+       <heap> ... H |-> V:Val ... </heap>
+       [priority(40)]
+  rule <k> V:Val ~> #observeResult => V ... </k>
+       requires notBool isRefV(V)
+endmodule

