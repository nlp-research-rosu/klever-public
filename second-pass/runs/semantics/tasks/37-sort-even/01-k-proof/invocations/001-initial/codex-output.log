diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..3596ff764c1807e55747fc084c735f81101e0ae9
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def _interleave(evens, odds):
+    if not odds:
+        return evens
+    return [evens[0], odds[0]] + _interleave(evens[1:], odds[1:])
+
+
+def sort_even(l: list):
+    evens = sorted(l[::2])
+    odds = l[1::2]
+    return _interleave(evens, odds)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b911349d75845ac7029a5a3c854e665850f044c9
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,64 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [interleave-correct]:
+    <k>
+      #applyK(
+        toCall(interleaveClosure),
+        (ref(EH), ref(OH), .Vals))
+      ~> K
+    =>
+      ref(?RH) ~> K
+    </k>
+    <env> L </env>
+    <scopes>
+      (0 |-> scope(
+        ("_interleave" |-> interleaveClosure)
+        ("sort_even" |-> sortEvenClosure),
+        parent(-1)))
+      (-1 |-> builtinsScope)
+      SC
+    </scopes>
+    <scopeLoc> SL </scopeLoc>
+    <heap>
+      (EH |-> list(EVS))
+      (OH |-> list(OVS))
+      HEAP
+    =>
+      (?RH |-> list(weaveVS(EVS, OVS)))
+      ?HEAP2
+    </heap>
+    <heapLoc> HL => ?HL2 </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires SL >Int 0
+     andBool notBool HL in_keys(
+       (EH |-> list(EVS)) (OH |-> list(OVS)) HEAP)
+
+  claim [sort-even-correct]:
+    <k>
+      Call(Name("sort_even"), list(VS))
+      ~> #observeResult
+    =>
+      list(weaveVS(sortVS(evenIndices(VS)), oddIndices(VS)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(
+        ("_interleave" |-> interleaveClosure)
+        ("sort_even" |-> sortEvenClosure),
+        parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?HEAP </heap>
+    <heapLoc> 0 => ?HL </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..20b5999a69b9461d70d0b48a79193b2fbfc410ea
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,90 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The two bodies below are the constructor terms generated in solution.mpy.
+  // Naming them keeps the specification readable without changing their
+  // operational meaning.
+  syntax Stmts ::= "interleaveBody" [function, total]
+  rule interleaveBody =>
+    If(UnaryOp("not", Name("odds")),
+       Return(Name("evens")),
+       .Stmts)
+    Return(
+      BinOp("+",
+        ListExpr(
+          Subscript(Name("evens"), Int(0)),
+          Subscript(Name("odds"), Int(0))),
+        Call(
+          Name("_interleave"),
+          Subscript(Name("evens"), Slice(Int(1), NoBound, NoBound)),
+          Subscript(Name("odds"), Slice(Int(1), NoBound, NoBound)))))
+
+  syntax Stmts ::= "sortEvenBody" [function, total]
+  rule sortEvenBody =>
+    Assign(
+      Name("evens"),
+      Call(
+        Name("sorted"),
+        Subscript(Name("l"), Slice(NoBound, NoBound, Int(2)))))
+    Assign(
+      Name("odds"),
+      Subscript(Name("l"), Slice(Int(1), NoBound, Int(2))))
+    Return(Call(Name("_interleave"), Name("evens"), Name("odds")))
+
+  syntax Val ::= "interleaveClosure" [function, total]
+               | "sortEvenClosure"   [function, total]
+  rule interleaveClosure =>
+    closureVal(("evens", "odds"), interleaveBody, 0)
+  rule sortEvenClosure =>
+    closureVal(("l"), sortEvenBody, 0)
+
+  // dropOneVS is exactly the ValSeq produced by Python's [1:] slice.
+  syntax ValSeq ::= dropOneVS(ValSeq) [function, total]
+  rule dropOneVS(VS:ValSeq) =>
+    buildVS(
+      VS,
+      slStart(someB(1), noB, vsLen(VS)),
+      slStop(noB, noB, vsLen(VS)),
+      slStep(noB))
+
+  // weaveVS states the functional contract of _interleave: consume one
+  // sorted even value for every untouched odd value, preserving a possible
+  // final extra even value.
+  syntax ValSeq ::= weaveVS(ValSeq, ValSeq) [function, total]
+  rule weaveVS(EVS:ValSeq, .ValSeq) => EVS
+  rule weaveVS(EVS:ValSeq, vCons(O:Val, OS:ValSeq)) =>
+    vCons(
+      valSeqAt(EVS, 0),
+      vCons(
+        O,
+        weaveVS(
+          dropOneVS(EVS),
+          dropOneVS(vCons(O, OS)))))
+
+  syntax ValSeq ::= evenIndices(ValSeq) [function, total]
+                  | oddIndices(ValSeq)  [function, total]
+  rule evenIndices(VS:ValSeq) =>
+    buildVS(
+      VS,
+      slStart(noB, someB(2), vsLen(VS)),
+      slStop(noB, someB(2), vsLen(VS)),
+      slStep(someB(2)))
+  rule oddIndices(VS:ValSeq) =>
+    buildVS(
+      VS,
+      slStart(someB(1), someB(2), vsLen(VS)),
+      slStop(noB, someB(2), vsLen(VS)),
+      slStep(someB(2)))
+
+  // Returned Python lists are heap references.  This continuation observes
+  // their structural value, making the postconditions independent of fresh
+  // heap addresses and temporary allocations.
+  syntax KItem ::= "#observeResult"
+  rule <k> ref(H:Int) ~> #observeResult => V ... </k>
+       <heap> ... H |-> V:Val ... </heap>
+       [priority(40)]
+  rule <k> V:Val ~> #observeResult => V ... </k>
+       requires notBool isRefV(V)
+endmodule

codex
The first recursive proof attempt exposed a genuine symbolic-state nuisance: recursive calls allocate both Python frames and sliced lists, so a reusable claim must carry unbounded freshness invariants for scope and heap locations. The concrete algorithm is fine, but that proof shape is unnecessarily costly. I’m switching to an equivalent single-frame `for` loop whose body only mutates one result list; this makes the loop invariant structural and avoids fresh allocation on every symbolic iteration.
apply patch
patch: completed
