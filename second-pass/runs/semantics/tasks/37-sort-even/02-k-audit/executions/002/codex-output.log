+  'COMMAND: cp -a /audit-output/evidence/05-bind-connection-spec.k /tmp/audit-work/37-sort-even/bind-connection-spec.k' \
+  > "$summary"
+cp -a "$evidence/05-bind-fixed.k" "$scratch/bind-fixed.k" >> "$summary" 2>&1
