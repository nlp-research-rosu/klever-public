@@ -0,0 +1,17 @@
+requires "bind-fixed.k"
+
+module BIND-CONNECTION-SPEC
+  imports BIND-FIXED
+
+  // Universal fixed-semantics behavior over the specialized rule's complete
+  // match domain, including arbitrary value, environment location, parent, and
+  // framed scope map.
+  claim [singleton-bind]:
+    <k> #bindP(("l"), (V:Val, .Vals)) => .K ... </k>
+    <env> L:Int </env>
+    <scopes>
+      SC1:Map
+      (L |-> scope(.Map => ("l" |-> V), P:Parent))
+      SC2:Map
+    </scopes>
+endmodule
