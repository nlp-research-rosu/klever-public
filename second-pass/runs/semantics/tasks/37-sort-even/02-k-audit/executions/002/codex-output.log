diff --git a/evidence/04b_run_body_sensitivity_ground.sh b/evidence/04b_run_body_sensitivity_ground.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c509de85739723838d07c90a2b43d2d0a70cec60
--- /dev/null
