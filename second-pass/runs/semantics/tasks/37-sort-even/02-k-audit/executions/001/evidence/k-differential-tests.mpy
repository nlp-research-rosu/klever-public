Module(
  FuncDef("sort_even", Params("l"),
    Assign(
      Name("evens"),
      Call(
        Name("sorted"),
        Subscript(Name("l"), Slice(NoBound, NoBound, Int(2)))))
    Assign(
      Name("odds"),
      Subscript(Name("l"), Slice(Int(1), NoBound, Int(2))))
    Assign(Name("result"), ListExpr())
    Assign(Name("i"), Int(0))
    Assign(Name("odd"), Int(0))
    For(Name("odd"), Name("odds"),
      Expr(
        Call(
          Attribute(Name("result"), "append"),
          Subscript(Name("evens"), Name("i"))))
      Expr(Call(Attribute(Name("result"), "append"), Name("odd")))
      AugAssign(Name("i"), "+", Int(1)))
    Return(
      BinOp(
        "+",
        Name("result"),
        Subscript(
          Name("evens"),
          Slice(Call(Name("len"), Name("odds")), NoBound, NoBound)))))
  Assert(
    Compare(
      Call(Name("sort_even"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("sort_even"), ListExpr(Int(7))),
      CmpOp("==", ListExpr(Int(7)))))
