          UnaryOp("-", Int(2)),
          Int(3),
          UnaryOp("-", Int(3)),
          Int(0))),
      CmpOp(
        "==",
        ListExpr(
          Int(0),
          UnaryOp("-", Int(1)),
          Int(3),
          UnaryOp("-", Int(2)),
          Int(3),
          UnaryOp("-", Int(3)),
