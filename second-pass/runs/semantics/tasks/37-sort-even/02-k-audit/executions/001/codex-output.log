+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(
+        ("sort_even" |-> sortEvenClosure),
+        parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?MUTHEAP </heap>
+    <heapLoc> 0 => ?MUTHL </heapLoc>
