+    <k>
+      Call(
+        Name("sort_even"),
+        list(vCons(5, vCons(6, vCons(3, vCons(4, .ValSeq))))))
+      ~> #observeResult
+    =>
+      list(vCons(3, vCons(6, vCons(5, vCons(4, .ValSeq)))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(
+        ("sort_even" |-> sortEvenClosure),
+        parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?GROUNDHEAP </heap>
+    <heapLoc> 0 => ?GROUNDHL </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
