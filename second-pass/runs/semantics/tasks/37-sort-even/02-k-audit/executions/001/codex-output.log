+  exit "$command_status"
+) > "$build_log" 2>&1
+build_status=$?
+echo "bridge_free_build_exit=$build_status"
+if test "$build_status" -ne 0; then
+  exit 1
+fi
+
+(
+  echo '$ kprove bind-connection-spec.k --definition bind-connection-kompiled --spec-module BIND-CONNECTION-SPEC --output pretty'
