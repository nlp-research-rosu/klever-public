+    <env> 1 </env>
+    <scopes>
+      (1 |-> scope(.Map => ("l" |-> 7), parent(0)))
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+endmodule
