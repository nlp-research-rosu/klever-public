+    --output pretty
+  command_status=$?
+  echo "exit=$command_status"
+  exit "$command_status"
+) > "$proof_log" 2>&1
+proof_status=$?
+echo "bridge_free_proof_exit=$proof_status"
+exit "$proof_status"
