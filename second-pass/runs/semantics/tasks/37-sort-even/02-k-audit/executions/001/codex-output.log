+echo "exit=$?"
+
+echo '$ kprove /audit-output/evidence/spec-ground.k --definition verification-kompiled --spec-module GROUND-SPEC --claims SPEC.loop-correct,GROUND-SPEC.ground-example --trusted SPEC.loop-correct --output pretty'
