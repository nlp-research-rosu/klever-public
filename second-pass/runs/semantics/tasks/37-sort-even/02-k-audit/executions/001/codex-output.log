     1	def sort_even(l: list):
     2	    evens = sorted(l[::2])
     3	    odds = l[1::2]
     4	    result = []
     5	    i = 0
     6	    odd = 0
     7	    for odd in odds:
     8	        result.append(evens[i])
     9	        result.append(odd)
    10	        i += 1
    11	    return result + evens[len(odds):]
    12	
    13	
    14	assert sort_even([]) == []
    15	assert sort_even([7]) == [7]
    16	assert sort_even([1, 2, 3]) == [1, 2, 3]
    17	assert sort_even([5, 6, 3, 4]) == [3, 6, 5, 4]
    18	assert sort_even([9, -1, 3, -2, 3, -3, 0]) == [0, -1, 3, -2, 3, -3, 9]

