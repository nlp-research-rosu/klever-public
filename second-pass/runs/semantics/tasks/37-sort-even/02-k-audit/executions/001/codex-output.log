+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?GROUNDHEAP </heap>
+    <heapLoc> 0 => ?GROUNDHL </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
