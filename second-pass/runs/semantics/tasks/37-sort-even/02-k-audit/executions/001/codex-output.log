diff --git a//tmp/audit-work/37-sort-even-audit/bridge-check/bind-connection-spec.k b//tmp/audit-work/37-sort-even-audit/bridge-check/bind-connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..3dbc29c0b9e17d7428d738396c74b904fdc0cb0a
--- /dev/null
+++ b//tmp/audit-work/37-sort-even-audit/bridge-check/bind-connection-spec.k
@@ -0,0 +1,21 @@
+requires "bind-connection.k"
+
+module BIND-CONNECTION-SPEC
+  imports BIND-CONNECTION
+
+  // Universal fixed-semantics derivation of verification.k:44-47 over its
+  // complete match domain.  No rule from verification.k is imported.
+  claim [singleton-plain-bind]:
+    <k>
+      #bindP(("l"), (V:Val, .Vals))
+      ~> K
+    =>
+      K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
