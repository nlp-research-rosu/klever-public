+  --spec-module GROUND-SPEC \
+  --claims SPEC.loop-correct,GROUND-SPEC.ground-example \
+  --trusted SPEC.loop-correct \
+  --output pretty
+proof_status=$?
+echo "exit=$proof_status"
+status=$((status | proof_status))
+
+echo "stage4_exit=$status"
+exit "$status"

