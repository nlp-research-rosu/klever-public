+requires "/tmp/audit-work/37-sort-even-audit/reconstruction-fresh/spec.k"
+
+module SPEC-VACUITY-AUDIT
+  imports SPEC
+
+  // Deliberately false mutation: prepend an extra 0 to every returned list.
+  // The original entry precondition remains unchanged.  In particular, VS =
+  // .ValSeq satisfies it and the real result is [], not [0].
+  claim [sort-even-false-extra-zero]:
+    <k>
+      Call(Name("sort_even"), list(VS))
+      ~> #observeResult
+    =>
+      list(
+        vCons(
+          0,
+          assembledEvenSort(
+            sortVS(evenIndices(VS)),
+            oddIndices(VS))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(
+        ("sort_even" |-> sortEvenClosure),
+        parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?MUTHEAP </heap>
+    <heapLoc> 0 => ?MUTHL </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
