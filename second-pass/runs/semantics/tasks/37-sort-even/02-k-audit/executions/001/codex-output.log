     7	  syntax Stmts ::= "loopBody" [function, total]
     8	  rule loopBody =>
     9	    Expr(
    10	      Call(
    11	        Attribute(Name("result"), "append"),
    12	        Subscript(Name("evens"), Name("i"))))
    13	    Expr(Call(Attribute(Name("result"), "append"), Name("odd")))
    14	    AugAssign(Name("i"), "+", Int(1))
    15	
    16	  syntax Stmts ::= "sortEvenBody" [function, total]
    17	  rule sortEvenBody =>
    18	    Assign(
    19	      Name("evens"),
    20	      Call(
    21	        Name("sorted"),
    22	        Subscript(Name("l"), Slice(NoBound, NoBound, Int(2)))))
    23	    Assign(
    24	      Name("odds"),
    25	      Subscript(Name("l"), Slice(Int(1), NoBound, Int(2))))
    26	    Assign(Name("result"), ListExpr(.Exprs))
    27	    Assign(Name("i"), Int(0))
    28	    Assign(Name("odd"), Int(0))
    29	    For(Name("odd"), Name("odds"), loopBody)
    30	    Return(
    31	      BinOp(
    32	        "+",
    33	        Name("result"),
    34	        Subscript(
    35	          Name("evens"),
    36	          Slice(Call(Name("len"), Name("odds")), NoBound, NoBound))))
    37	
    38	  syntax Val ::= "sortEvenClosure" [function, total]
    39	  rule sortEvenClosure => closureVal(("l"), sortEvenBody, 0)
    40	
    41	  // Specialized instance of MPY-FUNCTIONS' ordinary parameter-binding rule.
    42	  // Making the singleton shape explicit avoids a Haskell-backend narrowing
    43	  // ambiguity with the higher-priority closure-cell binding rule.
    44	  rule <k> #bindP(("l"), (V:Val, .Vals)) => .K ... </k>
    45	       <env> L:Int </env>
    46	       <scopes> ... L |-> scope(.Map => ("l" |-> V), _P:Parent) ... </scopes>
    47	       [priority(30)]
    48	
    49	  // The source list's even- and odd-index subsequences.  These formulae use
    50	  // the supplied slice.indices helpers exactly as Subscript evaluation does.
    51	  syntax ValSeq ::= evenIndices(ValSeq) [function, total]
    52	                  | oddIndices(ValSeq)  [function, total]
    53	  rule evenIndices(VS:ValSeq) =>
    54	    buildVS(
    55	      VS,
    56	      slStart(noB, someB(2), vsLen(VS)),
    57	      slStop(noB, someB(2), vsLen(VS)),
    58	      slStep(someB(2)))
    59	  rule oddIndices(VS:ValSeq) =>
    60	    buildVS(
    61	      VS,
    62	      slStart(someB(1), someB(2), vsLen(VS)),
    63	      slStop(noB, someB(2), vsLen(VS)),
    64	      slStep(someB(2)))
    65	
    66	  // Values appended by the for-loop while it consumes the odd-index list.
    67	  syntax ValSeq ::= pairedVS(ValSeq, ValSeq, Int) [function, total]
    68	  rule pairedVS(_:ValSeq, .ValSeq, _:Int) => .ValSeq
    69	  rule pairedVS(EVS:ValSeq, vCons(O:Val, OS:ValSeq), I:Int) =>
    70	    vCons(
    71	      valSeqAt(EVS, normIdx(I, vsLen(EVS))),
    72	      vCons(O, pairedVS(EVS, OS, I +Int 1)))
    73	
    74	  syntax Int ::= advancedIndex(Int, ValSeq) [function, total]
    75	  rule advancedIndex(I:Int, .ValSeq) => I
    76	  rule advancedIndex(I:Int, vCons(_:Val, OS:ValSeq)) =>
    77	    advancedIndex(I +Int 1, OS)
    78	
    79	  // The suffix evens[len(odds):], which is empty for even-length inputs and
    80	  // contains the final sorted even value for odd-length inputs.
    81	  syntax ValSeq ::= evenSuffix(ValSeq, ValSeq) [function, total]
    82	  rule evenSuffix(EVS:ValSeq, OVS:ValSeq) =>
    83	    buildVS(
    84	      EVS,
    85	      slStart(someB(vsLen(OVS)), noB, vsLen(EVS)),
    86	      slStop(noB, noB, vsLen(EVS)),
    87	      slStep(noB))
    88	
    89	  syntax ValSeq ::= assembledEvenSort(ValSeq, ValSeq) [function, total]
    90	  rule assembledEvenSort(EVS:ValSeq, OVS:ValSeq) =>
    91	    valSeqConcat(pairedVS(EVS, OVS, 0), evenSuffix(EVS, OVS))
    92	
    93	  // Symbolic ACC does not expose its head, so the reference definition's
    94	  // left-recursive concat rules cannot discover this right-identity case.
    95	  // The equation is the standard list-concatenation identity.
    96	  rule valSeqConcat(VS:ValSeq, .ValSeq) => VS [simplification]
    97	  rule valSeqConcat(
    98	         valSeqConcat(A:ValSeq, B:ValSeq),
    99	         C:ValSeq)
   100	    => valSeqConcat(A, valSeqConcat(B, C))
   101	    [simplification]
   102	
   103	  // Plain (non-closure-cell) loop frames contain these five explicit
   104	  // locals.  Exposing that "$cells" can only occur in the framed remainder
   105	  // prevents the prover from exploring the annotated-cell assignment rule.
   106	  rule "$cells" in_keys(
   107	         ("evens" |-> _EV:Val)
   108	         ("odds" |-> _OV:Val)
   109	         ("result" |-> _RV:Val)
   110	         ("i" |-> _IV:Val)
   111	         ("odd" |-> _ODD:Val)
   112	         M:Map)
   113	    => "$cells" in_keys(M)
   114	    [simplification]
   115	
   116	  // Returned Python lists are heap references.  Observe their structural
   117	  // value so the postcondition is independent of fresh heap addresses.
   118	  syntax KItem ::= "#observeResult"
   119	  rule <k> ref(H:Int) ~> #observeResult => V ... </k>
   120	       <heap> ... H |-> V:Val ... </heap>
   121	       [priority(40)]
   122	  rule <k> V:Val ~> #observeResult => V ... </k>
   123	       requires notBool isRefV(V)
   124	endmodule

