+#!/usr/bin/env bash
+set -u
+
+work=/tmp/audit-work/37-sort-even-audit/reconstruction-fresh
+evidence=/audit-output/evidence
+status=0
+
+echo '$ python3 /audit-output/evidence/ground_witness.py'
+python3 "$evidence/ground_witness.py"
