diff --git a//tmp/audit-work/app_path_probe.c b//tmp/audit-work/app_path_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..448dd6f4d673228194dd41e11eab6a4484a5656d
--- /dev/null
+++ b//tmp/audit-work/app_path_probe.c
@@ -0,0 +1,16 @@
+#include <limits.h>
+#include <stdio.h>
+#include <unistd.h>
+
+int main(int argc, char **argv) {
+    char buffer[PATH_MAX + 1];
+    ssize_t length = readlink("/proc/self/exe", buffer, PATH_MAX);
+    printf("argv0=%s\n", argc > 0 ? argv[0] : "(none)");
+    if (length < 0) {
+        perror("readlink");
+        return 1;
+    }
+    buffer[length] = '\0';
+    printf("proc_self_exe=%s\n", buffer);
+    return 0;
+}
diff --git a//tmp/audit-work/lean_proc_fix.c b//tmp/audit-work/lean_proc_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..4b4d34d8d21913a23d81bad74849cf905ed0408a
--- /dev/null
+++ b//tmp/audit-work/lean_proc_fix.c
@@ -0,0 +1,18 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (!real_readlink) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (strncmp(path, "/proc/", 6) == 0 &&
+        strcmp(path + strlen(path) - 4, "/exe") == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}
diff --git a//tmp/audit-work/readlink_probe.c b//tmp/audit-work/readlink_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..8fdf4a0fa63a09f2dc2f8a75445e5902537a176e
--- /dev/null
+++ b//tmp/audit-work/readlink_probe.c
@@ -0,0 +1,17 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stdio.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (!real_readlink) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    ssize_t result = real_readlink(path, buffer, size);
+    dprintf(2, "READLINK path=%s size=%zu result=%zd value=%.*s\n",
+            path, size, result, result > 0 ? (int)result : 0, buffer);
+    return result;
+}
