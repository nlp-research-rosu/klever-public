diff --git a//tmp/audit-work/app_path_probe.c b//tmp/audit-work/app_path_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..448dd6f4d673228194dd41e11eab6a4484a5656d
--- /dev/null
+++ b//tmp/audit-work/app_path_probe.c
@@ -0,0 +1,16 @@
+#include <limits.h>
+#include <stdio.h>
+#include <unistd.h>
+
+int main(int argc, char **argv) {
+    char buffer[PATH_MAX + 1];
+    ssize_t length = readlink("/proc/self/exe", buffer, PATH_MAX);
+    printf("argv0=%s\n", argc > 0 ? argv[0] : "(none)");
+    if (length < 0) {
+        perror("readlink");
+        return 1;
+    }
+    buffer[length] = '\0';
+    printf("proc_self_exe=%s\n", buffer);
+    return 0;
+}
diff --git a//tmp/audit-work/uv_exepath_probe.c b//tmp/audit-work/uv_exepath_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..438e7dcc0bbdd0dc0d8e205e0228ae445e40e309
--- /dev/null
+++ b//tmp/audit-work/uv_exepath_probe.c
@@ -0,0 +1,11 @@
+#include <stdio.h>
+#include <uv.h>
+
+int main(void) {
+    char buffer[4096];
+    size_t length = sizeof(buffer);
+    int code = uv_exepath(buffer, &length);
+    printf("code=%d name=%s length=%zu path=%.*s\n",
+           code, uv_err_name(code), length, (int)length, buffer);
+    return code == 0 ? 0 : 1;
+}

