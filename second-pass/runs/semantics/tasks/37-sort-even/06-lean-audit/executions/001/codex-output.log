+#include <stdio.h>
+#include <uv.h>
+
+int main(void) {
+    char buffer[4096];
+    size_t length = sizeof(buffer);
+    int code = uv_exepath(buffer, &length);
+    printf("code=%d name=%s length=%zu path=%.*s\n",
+           code, uv_err_name(code), length, (int)length, buffer);
+    return code == 0 ? 0 : 1;
+}
diff --git a/evidence/17_lean_proc_fix.c b/evidence/17_lean_proc_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..4b4d34d8d21913a23d81bad74849cf905ed0408a
--- /dev/null
+++ b/evidence/17_lean_proc_fix.c
@@ -0,0 +1,18 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (!real_readlink) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (strncmp(path, "/proc/", 6) == 0 &&
+        strcmp(path + strlen(path) - 4, "/exe") == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}
