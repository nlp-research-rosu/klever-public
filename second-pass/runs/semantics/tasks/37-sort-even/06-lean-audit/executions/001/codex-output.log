    71	    <heap> .Map => ?HEAP </heap>
    72	    <heapLoc> 0 => ?HL </heapLoc>
    73	    <stack> .List </stack>
    74	    <ret> noRet </ret>
    75	    <exc> NoExc </exc>
    76	    <exit-code> 0 </exit-code>
