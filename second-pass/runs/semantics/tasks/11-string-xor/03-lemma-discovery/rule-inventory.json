      "start_line": 47,
      "text": "  rule stringXorLoopBody\n    => If(Compare(Name(\"x\"), CmpOp(\"==\", Name(\"y\"))),\n          Assign(Name(\"result\"), BinOp(\"+\", Name(\"result\"), Str(\"0\"))),\n          Assign(Name(\"result\"), BinOp(\"+\", Name(\"result\"), Str(\"1\"))))"
    },
