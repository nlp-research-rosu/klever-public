      "start_line": 53,
      "text": "  rule stringXorBody\n    => Expr(Str(\"Return the bitwise XOR of two binary strings.\"))\n       Assign(Name(\"result\"), Str(\"\"))\n       Assign(Name(\"x\"), Str(\"\"))\n       Assign(Name(\"y\"), Str(\"\"))\n       For(stringXorTarget, Call(Name(\"zip\"), Name(\"a\"), Name(\"b\")),\n           stringXorLoopBody)\n       Return(Name(\"result\"))"
    },
