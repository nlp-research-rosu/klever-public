assert [r['source_rule_id'] for r in output['rules']] == [r['source_rule_id'] for r in inventory['rules']]
assert len(output['rules']) == len({r['source_rule_id'] for r in output['rules']}) == len(inventory['rules'])
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
for rule in output['rules']:
    assert list(rule) == ['source_rule_id', 'classification', 'rationale']
    assert rule['classification'] in allowed
    assert isinstance(rule['rationale'], str) and rule['rationale'].strip()

counts = Counter(r['classification'] for r in output['rules'])
print('validated rule count:', len(output['rules']))
print('classification counts:', dict(counts))
print('inventory_sha256:', output['inventory_sha256'])
