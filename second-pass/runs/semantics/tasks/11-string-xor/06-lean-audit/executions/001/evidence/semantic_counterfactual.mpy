Module(
  FuncDef("string_xor_mutated", Params("a", "b"),
    Assign(Name("result"), Str(""))
    Assign(Name("x"), Str(""))
    Assign(Name("y"), Str(""))
    For(TupleExpr(Name("x"), Name("y")), Call(Name("zip"), Name("a"), Name("b")),
      If(Compare(Name("x"), CmpOp("==", Name("y"))),
        Assign(Name("result"), BinOp("+", Name("result"), Str("1"))),
        Assign(Name("result"), BinOp("+", Name("result"), Str("1")))))
    Return(Name("result")))
  Assert(Compare(Call(Name("string_xor_mutated"), Str("0"), Str("0")),
    CmpOp("==", Str("0")))))
