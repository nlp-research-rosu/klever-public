Module(
  FuncDef("string_xor", Params("a", "b"),
    Assign(Name("result"), Str(""))
    Assign(Name("x"), Str(""))
    Assign(Name("y"), Str(""))
    For(TupleExpr(Name("x"), Name("y")), Call(Name("zip"), Name("a"), Name("b")),
      If(Compare(Name("x"), CmpOp("==", Name("y"))),
        Assign(Name("result"), BinOp("+", Name("result"), Str("0"))),
        Assign(Name("result"), BinOp("+", Name("result"), Str("1")))))
    Return(Name("result")))
  FuncDef("trace_xor", Params("a", "b"),
    Assign(Name("result"), Str(""))
    Assign(Name("x"), Str(""))
    Assign(Name("y"), Str(""))
    For(TupleExpr(Name("x"), Name("y")), Call(Name("zip"), Name("a"), Name("b")),
      If(Compare(Name("x"), CmpOp("==", Name("y"))),
        Assign(Name("result"), BinOp("+", Name("result"), Str("0"))),
        Assign(Name("result"), BinOp("+", Name("result"), Str("1")))))
    Return(TupleExpr(Name("result"), Name("x"), Name("y"))))
  Assert(Compare(Call(Name("string_xor"), Str(""), Str("")), CmpOp("==", Str(""))))
  Assert(Compare(Call(Name("string_xor"), Str("0"), Str("0")), CmpOp("==", Str("0"))))
  Assert(Compare(Call(Name("string_xor"), Str("0"), Str("1")), CmpOp("==", Str("1"))))
  Assert(Compare(Call(Name("string_xor"), Str("010"), Str("110")), CmpOp("==", Str("100"))))
  Assert(Compare(Call(Name("string_xor"), Str("10101"), Str("00111")), CmpOp("==", Str("10010"))))
  Assert(Compare(Call(Name("string_xor"), Str("10"), Str("1")), CmpOp("==", Str("0"))))
  Assert(Compare(Call(Name("string_xor"), Str("1"), Str("10")), CmpOp("==", Str("0"))))
  Assert(Compare(Call(Name("string_xor"), Str("111111"), Str("000")), CmpOp("==", Str("111"))))
  Assert(Compare(Call(Name("string_xor"), Str("0101"), Str("1010")), CmpOp("==", Str("1111"))))
  Assert(Compare(Call(Name("trace_xor"), Str(""), Str("")),
    CmpOp("==", TupleExpr(Str(""), Str(""), Str("")))))
  Assert(Compare(Call(Name("trace_xor"), Str("10"), Str("1")),
    CmpOp("==", TupleExpr(Str("0"), Str("1"), Str("1")))))
  Assert(Compare(Call(Name("trace_xor"), Str("01"), Str("10")),
    CmpOp("==", TupleExpr(Str("11"), Str("1"), Str("0"))))))
