@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+work=/tmp/audit-work/11-string-xor/candidate
+definition="$work/audit-verification-kompiled"
+
+run() {
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf 'EXIT_STATUS: %s\n' "$status"
+  return "$status"
+}
+
+run python3 /audit-output/evidence/generate_pinning_spec.py
+status=$?
+[ "$status" -eq 0 ] || exit "$status"
+
+run sha256sum \
+  /tmp/audit-work/11-string-xor/regenerated-solution.mpy \
+  "$work/solution.mpy" \
+  "$work/audit-pinning-spec.k"
+status=$?
+[ "$status" -eq 0 ] || exit "$status"
+
+cd "$work" || exit 1
+run timeout 180 kprove audit-pinning-spec.k \
+  --definition "$definition" \
+  --spec-module AUDIT-PINNING-SPEC
+pinning_status=$?
+
+run timeout 180 kprove /audit-output/evidence/adequacy-ground.k \
+  --definition "$definition" \
+  -I "$work" \
+  --spec-module AUDIT-ADEQUACY-GROUND
+ground_status=$?
+
+printf 'ADEQUACY_STATUS constructor-pinning=%s ground-witnesses=%s\n' \
+  "$pinning_status" "$ground_status"
+[ "$pinning_status" -eq 0 ] && [ "$ground_status" -eq 0 ]
+exit $?

exec
/bin/bash -lc "cd /tmp/audit-work/11-string-xor/candidate && printf 'COMMAND: timeout 180 kprove /audit-output/evidence/adequacy-ground.k --definition /tmp/audit-work/11-string-xor/candidate/audit-verification-kompiled -I /tmp/audit-work/11-string-xor/candidate --spec-module AUDIT-ADEQUACY-GROUND\\n' | tee /audit-output/evidence/adequacy_ground_complete.log && timeout 180 kprove /audit-output/evidence/adequacy-ground.k --definition /tmp/audit-work/11-string-xor/candidate/audit-verification-kompiled -I /tmp/audit-work/11-string-xor/candidate --spec-module AUDIT-ADEQUACY-GROUND 2>&1 | tee -a /audit-output/evidence/adequacy_ground_complete.log; status="'${PIPESTATUS[0]}; printf '"'EXIT_STATUS: %s\\n' \""'$status" | tee -a /audit-output/evidence/adequacy_ground_complete.log; test "$status" -eq 0' in /audit-output
diff --git a/evidence/adequacy-ground.k b/evidence/adequacy-ground.k
new file mode 100644
index 0000000000000000000000000000000000000000..a4cb0906d03421cfcf1319836e3837fd2bde538f
--- /dev/null
+++ b/evidence/adequacy-ground.k
@@ -0,0 +1,89 @@
+requires "verification.k"
+
+module AUDIT-ADEQUACY-GROUND
+  imports STRING-XOR-VERIFICATION
+
+  // "010" and "110" satisfy the binary-domain predicate.
+  claim
+    <k>
+      binaryCodes(iCons(48, iCons(49, iCons(48, .IntSeq))))
+      =>
+      true
+    </k>
+  claim
+    <k>
+      binaryCodes(iCons(49, iCons(49, iCons(48, .IntSeq))))
+      =>
+      true
+    </k>
+
+  // Substituting the documented example into the mathematical postcondition
+  // yields the code sequence for "100".
+  claim
+    <k>
+      xorAcc(
+        .IntSeq,
+        iCons(48, iCons(49, iCons(48, .IntSeq))),
+        iCons(49, iCons(49, iCons(48, .IntSeq))))
+      =>
+      iCons(49, iCons(48, iCons(48, .IntSeq)))
+    </k>
+
+  // Concrete satisfying witness for the loop claim's entry state.  The
+  // explicit execution is finite and does not import the symbolic spec claim.
+  claim
+    <k>
+      #loop(
+        zipObjS(
+          iCons(48, iCons(49, iCons(48, .IntSeq))),
+          iCons(49, iCons(49, iCons(48, .IntSeq)))),
+        stringXorTarget,
+        stringXorLoopBody)
+      =>
+      .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("a" |-> str(iCons(48, iCons(49, iCons(48, .IntSeq)))))
+        ("b" |-> str(iCons(49, iCons(49, iCons(48, .IntSeq)))))
+        ("result" |-> str(.IntSeq))
+        ("x" |-> str(.IntSeq))
+        ("y" |-> str(.IntSeq)),
+        root)
+      =>
+      1 |-> scope(
+        ("a" |-> str(iCons(48, iCons(49, iCons(48, .IntSeq)))))
+        ("b" |-> str(iCons(49, iCons(49, iCons(48, .IntSeq)))))
+        ("result" |-> str(iCons(49, iCons(48, iCons(48, .IntSeq)))))
+        ("x" |-> str(iCons(48, .IntSeq)))
+        ("y" |-> str(iCons(48, .IntSeq))),
+        root)
+    </scopes>
+
+  // Concrete satisfying witness for the end-to-end entry precondition.
+  claim
+    <k>
+      #loadAll(stringXorModule)
+      ~> Call(
+        Name("string_xor"),
+        str(iCons(48, iCons(49, iCons(48, .IntSeq)))),
+        str(iCons(49, iCons(49, iCons(48, .IntSeq)))))
+      =>
+      str(iCons(49, iCons(48, iCons(48, .IntSeq))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))) (-1 |-> builtinsScope)
+      =>
+      (0 |-> scope(("string_xor" |-> stringXorClosure), parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/build_rule_inventory.py b/evidence/build_rule_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..9c4fb80ba9d0cb223df4c53b1795284eae75ff6a
--- /dev/null
+++ b/evidence/build_rule_inventory.py
@@ -0,0 +1,118 @@
+#!/usr/bin/env python3
+"""Emit a complete line-addressed declaration/rule inventory for the audit."""
+
+from __future__ import annotations
+
+from collections import Counter
+from pathlib import Path
+import re
+
+
+roots = [
+    Path("/reference/reference-semantics/semantics.k"),
+    *sorted(Path("/reference/reference-semantics/semantics").glob("*.k")),
+    Path("/candidate/verification.k"),
+    Path("/candidate/spec.k"),
+]
+
+start_re = re.compile(
+    r"^\s*(requires|module|imports|syntax|configuration|context|rule|claim|endmodule)\b"
+)
+
+records: list[dict[str, object]] = []
+for path in roots:
+    lines = path.read_text(encoding="utf-8").splitlines()
+    starts = [index for index, line in enumerate(lines) if start_re.match(line)]
+    for position, start in enumerate(starts):
+        end = starts[position + 1] if position + 1 < len(starts) else len(lines)
+        block_lines = lines[start:end]
+        first = block_lines[0].strip()
+        kind = start_re.match(block_lines[0]).group(1)  # type: ignore[union-attr]
+        if kind not in {"syntax", "configuration", "context", "rule", "claim"}:
+            continue
+        block = "\n".join(block_lines).strip()
+        attrs: list[str] = []
+        if "[function" in block or re.search(r"\bfunction\b", block):
+            attrs.append("function")
+        for attr in (
+            "total",
+            "functional",
+            "symbol",
+            "no-evaluators",
+            "macro",
+            "macro-rec",
+            "strict",
+            "seqstrict",
+            "owise",
+            "concrete",
+            "simplification",
+        ):
+            if re.search(rf"\b{re.escape(attr)}\b", block):
+                attrs.append(attr)
+        priorities = re.findall(r"priority\(([^)]+)\)", block)
+        if priorities:
+            attrs.extend(f"priority({value})" for value in priorities)
+        records.append(
+            {
+                "path": path,
+                "line": start + 1,
+                "end": end,
+                "kind": kind,
+                "attrs": attrs,
+                "first": first,
+                "block": block,
+            }
+        )
+
+counts = Counter(str(record["kind"]) for record in records)
+attr_counts = Counter(
+    attr for record in records for attr in record["attrs"]  # type: ignore[index]
+)
+
+print("# Exhaustive K declaration and rule inventory")
+print()
+print(
+    "Source scope: trusted supplied `semantics.k` and every helper under "
+    "`semantics/`, plus candidate `verification.k` and `spec.k`."
+)
+print()
+print("## Counts")
+print()
+for kind in ("syntax", "configuration", "context", "rule", "claim"):
+    print(f"- {kind}: {counts[kind]}")
+for attr in (
+    "function",
+    "total",
+    "functional",
+    "symbol",
+    "no-evaluators",
+    "macro",
+    "macro-rec",
+    "strict",
+    "seqstrict",
+    "owise",
+    "concrete",
+    "simplification",
+):
+    print(f"- attribute `{attr}`: {attr_counts[attr]}")
+print(
+    f"- priority-bearing declarations/rules: "
+    f"{sum(value for key, value in attr_counts.items() if key.startswith('priority('))}"
+)
+print()
+
+current_path: Path | None = None
+ordinal = 0
+for record in records:
+    path = record["path"]
+    if path != current_path:
+        current_path = path  # type: ignore[assignment]
+        print(f"## `{path}`")
+        print()
+    ordinal += 1
+    attrs = ", ".join(record["attrs"]) if record["attrs"] else "none"  # type: ignore[arg-type]
+    first = str(record["first"]).replace("|", "\\|")
+    print(
+        f"- `INV-{ordinal:04d}` `{record['kind']}` "
+        f"lines {record['line']}-{record['end']}; attrs: {attrs}; `{first}`"
+    )
