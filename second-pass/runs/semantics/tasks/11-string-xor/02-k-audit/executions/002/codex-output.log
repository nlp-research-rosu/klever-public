from pathlib import Path
import hashlib,itertools,json,stat
root=Path('/reference/reference-semantics'); want='1de6d5f51876cf9d0f4449a78f077f8b127a14add0504d5060da680fc5a443de'
allents=sorted(root.rglob('*'),key=lambda p:p.relative_to(root).as_posix())
for incdirs in [0,1]:
 es=[p for p in allents if incdirs or p.is_file()]
 for rootfmt in ['', './', root.name+'/', str(root)+'/', str(root.resolve())+'/']:
  for sepfield,sepentry in itertools.product([b'',b'\\0',b'\\n',b' ',b':',b'  ',b'\\t'],repeat=2):
   for valuekind in ['content','hexdigest','digest']:
    for typekind in ['','char','word','mode','modeoct','size','type_size','mode_size']:
     for end in [0,1]:
      h=hashlib.sha256()
      for p in es:
       rel=(rootfmt+p.relative_to(root).as_posix()).encode()
       if p.is_dir(): content=b''; typ='d'
       else: content=p.read_bytes(); typ='f'
       val= content if valuekind=='content' else (hashlib.sha256(content).hexdigest().encode() if valuekind=='hexdigest' else hashlib.sha256(content).digest())
       mode=oct(p.stat().st_mode & 0o7777)[2:]
       if typekind=='': pre=b''
       elif typekind=='char': pre=typ.encode()
       elif typekind=='word': pre=(b'directory' if typ=='d' else b'file')
       elif typekind=='mode': pre=str(p.stat().st_mode).encode()
       elif typekind=='modeoct': pre=mode.encode()
       elif typekind=='size': pre=str(p.stat().st_size).encode()
       elif typekind=='type_size': pre=(typ+':'+str(p.stat().st_size)).encode()
       elif typekind=='mode_size': pre=(mode+':'+str(p.stat().st_size)).encode()
       h.update(pre+sepfield+rel+sepfield+val+sepentry)
      if end: h.update(sepentry)
      if h.hexdigest()==want:
       print('MATCH',incdirs,rootfmt,sepfield,sepentry,valuekind,typekind,end); raise SystemExit
print('no match')
PY" in /audit-output
