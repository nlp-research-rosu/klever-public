+#!/usr/bin/env bash
+set -uo pipefail
+
+work=/tmp/audit-work/11-string-xor/candidate
+definition="$work/audit-verification-kompiled"
+
+run() {
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf 'EXIT_STATUS: %s\n' "$status"
+  return "$status"
+}
+
+run python3 /audit-output/evidence/generate_pinning_spec.py
+status=$?
+[ "$status" -eq 0 ] || exit "$status"
+
+run sha256sum \
+  /tmp/audit-work/11-string-xor/regenerated-solution.mpy \
+  "$work/solution.mpy" \
+  "$work/audit-pinning-spec.k"
+status=$?
+[ "$status" -eq 0 ] || exit "$status"
+
+cd "$work" || exit 1
+run timeout 180 kprove audit-pinning-spec.k \
+  --definition "$definition" \
+  --spec-module AUDIT-PINNING-SPEC
+pinning_status=$?
+
+run timeout 180 kprove /audit-output/evidence/adequacy-ground.k \
+  --definition "$definition" \
+  -I "$work" \
+  --spec-module AUDIT-ADEQUACY-GROUND
+ground_status=$?
+
+printf 'ADEQUACY_STATUS constructor-pinning=%s ground-witnesses=%s\n' \
+  "$pinning_status" "$ground_status"
+[ "$pinning_status" -eq 0 ] && [ "$ground_status" -eq 0 ]
+exit $?

diff --git a/evidence/adequacy-ground.k b/evidence/adequacy-ground.k
new file mode 100644
index 0000000000000000000000000000000000000000..a4cb0906d03421cfcf1319836e3837fd2bde538f
--- /dev/null
+++ b/evidence/adequacy-ground.k
@@ -0,0 +1,89 @@
+requires "verification.k"
+
+module AUDIT-ADEQUACY-GROUND
+  imports STRING-XOR-VERIFICATION
+
+  // "010" and "110" satisfy the binary-domain predicate.
+  claim
+    <k>
+      binaryCodes(iCons(48, iCons(49, iCons(48, .IntSeq))))
+      =>
+      true
+    </k>
+  claim
+    <k>
+      binaryCodes(iCons(49, iCons(49, iCons(48, .IntSeq))))
+      =>
+      true
+    </k>
+
+  // Substituting the documented example into the mathematical postcondition
+  // yields the code sequence for "100".
+  claim
+    <k>
+      xorAcc(
+        .IntSeq,
+        iCons(48, iCons(49, iCons(48, .IntSeq))),
+        iCons(49, iCons(49, iCons(48, .IntSeq))))
+      =>
+      iCons(49, iCons(48, iCons(48, .IntSeq)))
+    </k>
+
+  // Concrete satisfying witness for the loop claim's entry state.  The
+  // explicit execution is finite and does not import the symbolic spec claim.
+  claim
+    <k>
+      #loop(
+        zipObjS(
+          iCons(48, iCons(49, iCons(48, .IntSeq))),
+          iCons(49, iCons(49, iCons(48, .IntSeq)))),
+        stringXorTarget,
+        stringXorLoopBody)
+      =>
+      .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("a" |-> str(iCons(48, iCons(49, iCons(48, .IntSeq)))))
+        ("b" |-> str(iCons(49, iCons(49, iCons(48, .IntSeq)))))
+        ("result" |-> str(.IntSeq))
+        ("x" |-> str(.IntSeq))
+        ("y" |-> str(.IntSeq)),
+        root)
+      =>
+      1 |-> scope(
+        ("a" |-> str(iCons(48, iCons(49, iCons(48, .IntSeq)))))
+        ("b" |-> str(iCons(49, iCons(49, iCons(48, .IntSeq)))))
+        ("result" |-> str(iCons(49, iCons(48, iCons(48, .IntSeq)))))
+        ("x" |-> str(iCons(48, .IntSeq)))
+        ("y" |-> str(iCons(48, .IntSeq))),
+        root)
+    </scopes>
+
+  // Concrete satisfying witness for the end-to-end entry precondition.
+  claim
+    <k>
+      #loadAll(stringXorModule)
+      ~> Call(
+        Name("string_xor"),
+        str(iCons(48, iCons(49, iCons(48, .IntSeq)))),
+        str(iCons(49, iCons(49, iCons(48, .IntSeq)))))
+      =>
+      str(iCons(49, iCons(48, iCons(48, .IntSeq))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))) (-1 |-> builtinsScope)
+      =>
+      (0 |-> scope(("string_xor" |-> stringXorClosure), parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/body_sensitivity.sh b/evidence/body_sensitivity.sh
