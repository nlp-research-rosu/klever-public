index 0000000000000000000000000000000000000000..a350dd96b37ab447aa13558fb9ba651ff75472ee
--- /dev/null
+++ b/evidence/stage1_integrity.sh
@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+printf 'COMMAND: python3 /audit-output/evidence/stage1_integrity.py\n'
