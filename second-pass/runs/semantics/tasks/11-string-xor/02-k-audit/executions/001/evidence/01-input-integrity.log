WORKDIR: /audit-output
COMMAND: bash -lc $'\nset +e\nprintf "TOOLCHAIN\\n"\ncommand -v kompile\nkompile --version\ncommand -v kprove\nkprove --version\nprintf "TRUSTED_MOUNT_TYPES\\n"\nfind /reference -printf "%y %p -> %l\\\\n" | sort\nprintf "CANDIDATE_TOP_LEVEL_TYPES\\n"\nfind /candidate -maxdepth 1 -mindepth 1 -printf "%y %f -> %l\\\\n" | sort\nprintf "REQUIRED_PROVENANCE\\n"\nfor name in run-input.json metrics.json codex-last.txt codex-output.log; do\n  if test -f "/candidate/$name" && ! test -L "/candidate/$name"; then\n    printf "PRESENT regular %s\\\\n" "$name"\n  else\n    printf "MISSING_OR_MISTYPED %s\\\\n" "$name"\n  fi\ndone\nprintf "POSSIBLE_STRUCTURED_TRACES\\n"\nfind /candidate -maxdepth 2 -type f \\( -iname "*trace*" -o -iname "*.jsonl" -o -iname "*events*" \\) -print | sort\nprintf "PROMPT_COMPARE\\n"\ncmp -s /candidate/prompt.py /reference/prompt.py\nprintf "prompt_cmp_status=%d\\\\n" "$?"\nsha256sum /candidate/prompt.py /reference/prompt.py\nprintf "TRANSLATOR_COMPARE\\n"\ncmp -s /candidate/py2mpy.py /reference/py2mpy.py\nprintf "translator_cmp_status=%d\\\\n" "$?"\nsha256sum /candidate/py2mpy.py /reference/py2mpy.py\nprintf "SEMANTICS_SYMLINK_CHECK\\n"\nfind /candidate/reference-semantics -type l -printf "%p -> %l\\\\n"\nprintf "SEMANTICS_TREE_COMPARE\\n"\ndiff --no-dereference -r /reference/reference-semantics /candidate/reference-semantics\nprintf "semantics_diff_status=%d\\\\n" "$?"\nprintf "SEMANTICS_TREE_MANIFESTS\\n"\nfind /reference/reference-semantics -printf "%y %P -> %l\\\\n" | sort\nfind /candidate/reference-semantics -printf "%y %P -> %l\\\\n" | sort\n'
