+    ("0", ""),
+    ("0", "0"),
+    ("1", "1"),
+    ("0", "1"),
+    ("1", "0"),
+    ("10", "1"),
+    ("1", "10"),
+    ("00000000", "11111111"),
+    ("11111111", "00000000"),
+]
