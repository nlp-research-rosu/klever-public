+explicit_cases = [
+    ("010", "110"),
+    ("", ""),
+    ("", "1"),
+    ("0", ""),
+    ("0", "0"),
+    ("1", "1"),
+    ("0", "1"),
+    ("1", "0"),
+    ("10", "1"),
+    ("1", "10"),
