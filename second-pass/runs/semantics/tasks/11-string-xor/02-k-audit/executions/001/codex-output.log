/reference/reference-semantics/semantics/call.k:24:  rule <k> #applyK(toCall(boundMethodV(OBJ:Val, M:String)), ACC:Vals) => applyMethod(OBJ, M, ACC) ... </k>
/reference/reference-semantics/semantics/call.k-25-
/reference/reference-semantics/semantics/call.k:26:  rule <k> #applyK(toCall(builtinV("sum")), (OBJ:Iterable, .Vals)) => #sumAcc(OBJ, 0) ... </k>
/reference/reference-semantics/semantics/call.k:27:  rule <k> #applyK(toCall(builtinV("all")), (OBJ:Iterable, .Vals)) => #allAcc(OBJ)    ... </k>
/reference/reference-semantics/semantics/call.k:28:  rule <k> #applyK(toCall(builtinV("any")), (OBJ:Iterable, .Vals)) => #anyAcc(OBJ)    ... </k>
/reference/reference-semantics/semantics/call.k:29:  rule <k> #applyK(toCall(builtinV("max")), (OBJ:Iterable, .Vals)) => #maxAcc0(OBJ)   ... </k>
/reference/reference-semantics/semantics/call.k:30:  rule <k> #applyK(toCall(builtinV("min")), (OBJ:Iterable, .Vals)) => #minAcc0(OBJ)   ... </k>
/reference/reference-semantics/semantics/call.k:31:  rule <k> #applyK(toCall(builtinV(BN:String)), ACC:Vals) => applyBuiltin(BN, ACC) ... </k> [owise]
/reference/reference-semantics/semantics/call.k:32:  rule <k> #applyK(toCall(typeV(T:String)),     ACC:Vals) => applyBuiltin(T, ACC)  ... </k>
/reference/reference-semantics/semantics/call.k-33-
/reference/reference-semantics/semantics/call.k-34-  // ==== heap-object arguments/receivers =====================================
/reference/reference-semantics/semantics/call.k-35-  // Builtins and type calls READ structure — deref the first two arg positions
