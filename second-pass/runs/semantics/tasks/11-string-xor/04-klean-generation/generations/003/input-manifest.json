{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 9,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "199ce5880ece2ffb12808eff7fef493bd984e1a076cd0e8d4b343706610da6dd",
      "rationale": "Defines the binaryCode predicate by equating it with membership in the two ASCII bit codes 48 and 49.",
      "source_rule_id": "rule-199ce5880ece2ffb12808eff7fef493bd984e1a076cd0e8d4b343706610da6dd",
      "start_line": 9,
      "text": "  rule binaryCode(C:Int) => C ==Int 48 orBool C ==Int 49"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 13,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "a148568eb04c7f9b8870ff300eaedf75c27d7157f87329038363c581ba31e006",
      "rationale": "Defines the equal-input branch of the mathematical xorCode summary on valid binary character codes.",
      "source_rule_id": "rule-a148568eb04c7f9b8870ff300eaedf75c27d7157f87329038363c581ba31e006",
      "start_line": 12,
      "text": "  rule xorCode(A:Int, B:Int) => 48\n    requires binaryCode(A) andBool binaryCode(B) andBool A ==Int B"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 15,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "fe604a49861f69b3d97a975621261928274be9ca20eacdb377de3f12c4cd20be",
      "rationale": "Defines the unequal-input branch of the mathematical xorCode summary on valid binary character codes.",
      "source_rule_id": "rule-fe604a49861f69b3d97a975621261928274be9ca20eacdb377de3f12c4cd20be",
      "start_line": 14,
      "text": "  rule xorCode(A:Int, B:Int) => 49\n    requires binaryCode(A) andBool binaryCode(B) andBool A =/=Int B"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 18,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "62aca2024c4118a16e877ed708bc7768249c5c00041d1b722b67419785a42cb7",
      "rationale": "Defines the xorAcc base case when the first remaining input sequence is empty.",
      "source_rule_id": "rule-62aca2024c4118a16e877ed708bc7768249c5c00041d1b722b67419785a42cb7",
      "start_line": 18,
      "text": "  rule xorAcc(P:IntSeq, .IntSeq, _:IntSeq) => P"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "3873758979b4fe1f32c7b6c9f3766c8a77b9e2692da5dd9a167d7ec6ed480a65",
      "rationale": "Defines the xorAcc base case when the second remaining input sequence is empty.",
      "source_rule_id": "rule-3873758979b4fe1f32c7b6c9f3766c8a77b9e2692da5dd9a167d7ec6ed480a65",
      "start_line": 19,
      "text": "  rule xorAcc(P:IntSeq, iCons(_:Int, _:IntSeq), .IntSeq) => P"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 21,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "5927925fd64b560eda4a130550ad28115a8190603ec3ef402ce86fd2e7f16246",
      "rationale": "Defines the recursive xorAcc equation that appends one summarized XOR code and advances both input sequences.",
      "source_rule_id": "rule-5927925fd64b560eda4a130550ad28115a8190603ec3ef402ce86fd2e7f16246",
      "start_line": 20,
      "text": "  rule xorAcc(P:IntSeq, iCons(A:Int, AS:IntSeq), iCons(B:Int, BS:IntSeq))\n    => xorAcc(seqConcat(P, iCons(xorCode(A, B), .IntSeq)), AS, BS)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "b95fbff73db146c39988a02bbcbb098c77c0429f2871f9f6ce9412cd30eb2a41",
      "rationale": "Defines the empty-sequence base case of the binaryCodes input predicate.",
      "source_rule_id": "rule-b95fbff73db146c39988a02bbcbb098c77c0429f2871f9f6ce9412cd30eb2a41",
      "start_line": 25,
      "text": "  rule binaryCodes(.IntSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 27,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "0a4b0a280fe4a4a35fd65b3556363daab4e64279cb451ed33f6978a946f2f288",
      "rationale": "Defines binaryCodes recursively as a binary head code followed by a binary tail.",
      "source_rule_id": "rule-0a4b0a280fe4a4a35fd65b3556363daab4e64279cb451ed33f6978a946f2f288",
      "start_line": 26,
      "text": "  rule binaryCodes(iCons(C:Int, REST:IntSeq))\n    => binaryCode(C) andBool binaryCodes(REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 33,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "51eed43ea34ea2b88fc0ee347ba2ce190ad10bf7d39e47c22ce25b918d176bd8",
      "rationale": "Defines xorLastX for termination caused by an empty first remaining sequence.",
      "source_rule_id": "rule-51eed43ea34ea2b88fc0ee347ba2ce190ad10bf7d39e47c22ce25b918d176bd8",
      "start_line": 33,
      "text": "  rule xorLastX(.IntSeq, _:IntSeq, X:IntSeq) => X"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 34,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "a38734cd4f874be55b9ca33cb03b46d5c734929e291f977a284b556b320c7a24",
      "rationale": "Defines xorLastX for termination caused by an empty second remaining sequence.",
      "source_rule_id": "rule-a38734cd4f874be55b9ca33cb03b46d5c734929e291f977a284b556b320c7a24",
      "start_line": 34,
      "text": "  rule xorLastX(iCons(_:Int, _:IntSeq), .IntSeq, X:IntSeq) => X"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 36,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "7fbbae800178ce2c9ba1863b427c2174c299cc3ade1339dce972aa9f67e5e909",
      "rationale": "Defines the recursive summary of the final value retained in loop variable x.",
      "source_rule_id": "rule-7fbbae800178ce2c9ba1863b427c2174c299cc3ade1339dce972aa9f67e5e909",
      "start_line": 35,
      "text": "  rule xorLastX(iCons(A:Int, AS:IntSeq), iCons(_:Int, BS:IntSeq), _:IntSeq)\n    => xorLastX(AS, BS, iCons(A, .IntSeq))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 37,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "7f5cb64a2e98293475868861131ad7741bf1e6a094fbf0ee0640e2a0798bb97b",
      "rationale": "Defines xorLastY for termination caused by an empty first remaining sequence.",
      "source_rule_id": "rule-7f5cb64a2e98293475868861131ad7741bf1e6a094fbf0ee0640e2a0798bb97b",
      "start_line": 37,
      "text": "  rule xorLastY(.IntSeq, _:IntSeq, Y:IntSeq) => Y"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 38,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "27fb8fe751825dffe32c8718d119f49236783d0d07bcd8a5db653b1dea712d16",
      "rationale": "Defines xorLastY for termination caused by an empty second remaining sequence.",
      "source_rule_id": "rule-27fb8fe751825dffe32c8718d119f49236783d0d07bcd8a5db653b1dea712d16",
      "start_line": 38,
      "text": "  rule xorLastY(iCons(_:Int, _:IntSeq), .IntSeq, Y:IntSeq) => Y"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 40,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "0c567126c3b88db4eaddf41bd503995b9c2bb3ac347550f17551712ad2763a7b",
      "rationale": "Defines the recursive summary of the final value retained in loop variable y.",
      "source_rule_id": "rule-0c567126c3b88db4eaddf41bd503995b9c2bb3ac347550f17551712ad2763a7b",
      "start_line": 39,
      "text": "  rule xorLastY(iCons(_:Int, AS:IntSeq), iCons(B:Int, BS:IntSeq), _:IntSeq)\n    => xorLastY(AS, BS, iCons(B, .IntSeq))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 44,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "b29ef2baa281c5fa26870dd0bdec73534d8ce1dfb5f50b7530fc079eb66befb8",
      "rationale": "Expands the named stringXorTarget proof term to the translated tuple assignment target.",
      "source_rule_id": "rule-b29ef2baa281c5fa26870dd0bdec73534d8ce1dfb5f50b7530fc079eb66befb8",
      "start_line": 44,
      "text": "  rule stringXorTarget => TupleExpr(Name(\"x\"), Name(\"y\"))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 50,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "fb6d7f05a768ed8021b86cfe5116ba4f3a3285bc89b5cb1b77d93545fe5b3e63",
      "rationale": "Expands the named stringXorLoopBody proof term to the translated conditional loop body.",
      "source_rule_id": "rule-fb6d7f05a768ed8021b86cfe5116ba4f3a3285bc89b5cb1b77d93545fe5b3e63",
      "start_line": 47,
      "text": "  rule stringXorLoopBody\n    => If(Compare(Name(\"x\"), CmpOp(\"==\", Name(\"y\"))),\n          Assign(Name(\"result\"), BinOp(\"+\", Name(\"result\"), Str(\"0\"))),\n          Assign(Name(\"result\"), BinOp(\"+\", Name(\"result\"), Str(\"1\"))))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 60,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "9038158948b425b3a65b4356422181488831c1971604f53f17abfdf852273664",
      "rationale": "Expands the named stringXorBody proof term to the complete translated function body.",
      "source_rule_id": "rule-9038158948b425b3a65b4356422181488831c1971604f53f17abfdf852273664",
      "start_line": 53,
      "text": "  rule stringXorBody\n    => Expr(Str(\"Return the bitwise XOR of two binary strings.\"))\n       Assign(Name(\"result\"), Str(\"\"))\n       Assign(Name(\"x\"), Str(\"\"))\n       Assign(Name(\"y\"), Str(\"\"))\n       For(stringXorTarget, Call(Name(\"zip\"), Name(\"a\"), Name(\"b\")),\n           stringXorLoopBody)\n       Return(Name(\"result\"))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 64,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "7ca33bffe28bd24537015e6017062942fea10d0e7b29d0e6493564505573088b",
      "rationale": "Defines the named stringXorClosure proof value from its parameters, body, and defining scope.",
      "source_rule_id": "rule-7ca33bffe28bd24537015e6017062942fea10d0e7b29d0e6493564505573088b",
      "start_line": 63,
      "text": "  rule stringXorClosure\n    => closureVal((\"a\", \"b\", .ParamNames), stringXorBody, 0)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 70,
      "module": "STRING-XOR-VERIFICATION",
      "normalized_sha256": "ddfff0b94e57e746b0fc84a9f6b2e7f71e126aed256bc39b9680c789117a7846",
      "rationale": "Expands the named stringXorModule proof term to the exact translated module structure.",
      "source_rule_id": "rule-ddfff0b94e57e746b0fc84a9f6b2e7f71e126aed256bc39b9680c789117a7846",
      "start_line": 67,
      "text": "  rule stringXorModule\n    => Module(\n         ImportFrom(\"typing\", \"List\")\n         FuncDef(\"string_xor\", Params(\"a\", \"b\"), stringXorBody))"
    }
  ],
