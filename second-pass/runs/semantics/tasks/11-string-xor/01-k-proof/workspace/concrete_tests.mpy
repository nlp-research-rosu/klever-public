Module(
  ImportFrom("typing", "List")
  FuncDef("string_xor", Params("a", "b"),
    Expr(Str("Return the bitwise XOR of two binary strings."))
    Assign(Name("result"), Str(""))
    Assign(Name("x"), Str(""))
    Assign(Name("y"), Str(""))
    For(TupleExpr(Name("x"), Name("y")), Call(Name("zip"), Name("a"), Name("b")),
      If(Compare(Name("x"), CmpOp("==", Name("y"))),
        Assign(Name("result"), BinOp("+", Name("result"), Str("0"))),
        Assign(Name("result"), BinOp("+", Name("result"), Str("1")))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("string_xor"), Str("010"), Str("110")),
      CmpOp("==", Str("100"))))
  Assert(
    Compare(
      Call(Name("string_xor"), Str(""), Str("")),
      CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("string_xor"), Str("1111"), Str("0101")),
      CmpOp("==", Str("1010"))))
  Assert(
    Compare(
      Call(Name("string_xor"), Str("10"), Str("1")),
      CmpOp("==", Str("0")))))
