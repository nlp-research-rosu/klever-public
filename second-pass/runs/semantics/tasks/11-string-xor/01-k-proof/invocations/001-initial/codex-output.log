+                    ("x" |-> str(X:IntSeq))
+                    ("y" |-> str(Y:IntSeq)),
+                    PAR:Parent)) SC:Map
+      =>
+      (L |-> scope(("a" |-> str(ORIGA))
+                    ("b" |-> str(ORIGB))
+                    ("result" |-> str(xorAcc(P, A, B)))
+                    ("x" |-> str(xorLastX(A, B, X)))
+                    ("y" |-> str(xorLastY(A, B, Y))),
+                    PAR)) SC
+    </scopes>
+    requires notBool (L in_keys(SC))
+     andBool binaryCodes(A)
+     andBool binaryCodes(B)
+
+  claim [solution-correct]:
