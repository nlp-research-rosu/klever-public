new file mode 100644
index 0000000000000000000000000000000000000000..9d5f57a9093a3826bdb88065e9823d9aab5898dc
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,20 @@
+from typing import List
+
+
+def string_xor(a: str, b: str) -> str:
+    """Return the bitwise XOR of two binary strings."""
+    result = ""
+    x = ""
+    y = ""
+    for x, y in zip(a, b):
+        if x == y:
+            result = result + "0"
+        else:
+            result = result + "1"
+    return result
+
+
+assert string_xor("010", "110") == "100"
+assert string_xor("", "") == ""
+assert string_xor("1111", "0101") == "1010"
+assert string_xor("10", "1") == "0"
