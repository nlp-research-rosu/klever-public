+  rule stringXorBody
+    => Expr(Str("Return the bitwise XOR of two binary strings."))
+       Assign(Name("result"), Str(""))
+       Assign(Name("x"), Str(""))
+       Assign(Name("y"), Str(""))
+       For(stringXorTarget, Call(Name("zip"), Name("a"), Name("b")),
+           stringXorLoopBody)
+       Return(Name("result"))
+
+  syntax Val ::= "stringXorClosure" [function]
