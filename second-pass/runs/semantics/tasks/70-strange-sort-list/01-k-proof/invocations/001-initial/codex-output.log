+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive loop invariant.  S is the already sorted sequence, N its
+  // length, and result contains exactly the first I alternating selections.
+  claim [loop-invariant]:
+    <k> #while(strangeCondition(), strangeLoopBody()) => .K </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        "ordered" |-> ref(HO:Int)
+        "result"  |-> ref(HR:Int)
+        "i"       |-> I:Int
+        FRAME:Map,
+        P:Parent)
+      SCOPES:Map
+      =>
+      L |-> scope(
+        "ordered" |-> ref(HO)
+        "result"  |-> ref(HR)
+        "i"       |-> N:Int
+        FRAME,
+        P)
+      SCOPES
+    </scopes>
+    <heap>
+      HO |-> list(S:ValSeq)
+      HR |-> list(strangePrefix(S, I, N))
+      HEAP:Map
+      =>
+      HO |-> list(S)
+      HR |-> list(strangePrefix(S, N, N))
+      HEAP
+    </heap>
+    requires 0 <=Int I andBool I <=Int N
+      andBool N ==Int vsLen(S)
+
+  // End-to-end claim for the actual translated function body.  The result is
+  // a fresh list containing the alternating low/high traversal of sortVS(VS).
+  claim [function-correct]:
+    <k>
+      Call(
+        closureVal(("lst", .ParamNames), strangeBody(), 0),
+        list(INPUT:ValSeq))
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(sortVS(INPUT))
+      1 |-> list(strangeResult(sortVS(INPUT)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c8109bf3ccc94b9e4f7408185e3d6509deb49e6e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,67 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The exact loop condition and body emitted by py2mpy.py for solution.py.
+  // Naming them keeps the invariant and the whole-function claim readable.
+  syntax Expr ::= strangeCondition() [macro]
+  rule strangeCondition()
+    => Compare(Name("i"),
+         CmpOp("<", Call(Name("len"), Name("ordered"))))
+
+  syntax Stmts ::= strangeLoopBody() [macro]
+  rule strangeLoopBody()
+    => If(
+         Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             Subscript(Name("ordered"), BinOp("//", Name("i"), Int(2))))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             Subscript(
+               Name("ordered"),
+               BinOp(
+                 "-",
+                 BinOp(
+                   "-",
+                   Call(Name("len"), Name("ordered")),
+                   BinOp("//", Name("i"), Int(2))),
+                 Int(1))))))
+       AugAssign(Name("i"), "+", Int(1))
+
+  syntax Stmts ::= strangeBody() [macro]
+  rule strangeBody()
+    => Assign(Name("ordered"), Call(Name("sorted"), Name("lst")))
+       Assign(Name("result"), ListExpr())
+       Assign(Name("i"), Int(0))
+       While(strangeCondition(), strangeLoopBody())
+       Return(Name("result"))
+
+  // Element selected at iteration I from an ascending sequence S of length N.
+  // pyMod(I, 2) is either zero or one for the nonnegative loop index.
+  syntax Val ::= strangePick(ValSeq, Int, Int) [function]
+  rule strangePick(S:ValSeq, I:Int, _N:Int)
+    => valSeqAt(S, (I -Int pyMod(I, 2)) /Int 2)
+    requires pyMod(I, 2) ==Int 0
+  rule strangePick(S:ValSeq, I:Int, N:Int)
+    => valSeqAt(S, N -Int ((I -Int pyMod(I, 2)) /Int 2) -Int 1)
+    requires pyMod(I, 2) =/=Int 0
+
+  // Prefix produced after I loop iterations.  The second rule is deliberately
+  // tail-facing: simplifying prefix(I + 1) exposes exactly one append, which
+  // is the list mutation performed by the next concrete loop step.
+  syntax ValSeq ::= strangePrefix(ValSeq, Int, Int) [function]
+  rule strangePrefix(_S:ValSeq, 0, _N:Int) => .ValSeq
+  rule strangePrefix(S:ValSeq, I:Int, N:Int)
+    => valSeqConcat(
+         strangePrefix(S, I -Int 1, N),
+         vCons(strangePick(S, I -Int 1, N), .ValSeq))
+    requires I >Int 0
+
+  syntax ValSeq ::= strangeResult(ValSeq) [function]
+  rule strangeResult(S:ValSeq)
+    => strangePrefix(S, vsLen(S), vsLen(S))
+endmodule

apply patch
