/bin/bash -lc "python3 - <<'PY'
import random
from solution import strange_sort_list

def oracle(xs):
    xs = sorted(xs)
    out = []
    lo, hi = 0, len(xs) - 1
    take_lo = True
    while lo <= hi:
        if take_lo:
            out.append(xs[lo])
            lo += 1
        else:
            out.append(xs[hi])
            hi -= 1
        take_lo = not take_lo
    return out

rng = random.Random(70)
for n in range(25):
    for _ in range(200):
        xs = [rng.randint(-20, 20) for _ in range(n)]
        assert strange_sort_list(xs) == oracle(xs)
print('5000 randomized CPython differential cases passed')
