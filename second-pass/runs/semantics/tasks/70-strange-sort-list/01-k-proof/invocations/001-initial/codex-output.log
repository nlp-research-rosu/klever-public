+        "lst"     |-> LIST
+        "ordered" |-> ref(HO)
+        "result"  |-> ref(HR)
+        "i"       |-> N:Int,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <heap>
+      HO |-> list(S:ValSeq)
+      HR |-> list(strangePrefix(S, I, N))
+      =>
