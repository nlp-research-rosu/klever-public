+      0 |-> list(sortVS(INPUT))
+      1 |-> list(strangeResult(sortVS(INPUT)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
