index 0000000000000000000000000000000000000000..c1611c54e7e6e9ed8ee236dbd7570b84f7831819
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,67 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The exact loop condition and body emitted by py2mpy.py for solution.py.
+  // Naming them keeps the invariant and the whole-function claim readable.
+  syntax Expr ::= strangeCondition() [macro]
+  rule strangeCondition()
+    => Compare(Name("i"),
+         CmpOp("<", Call(Name("len"), Name("ordered"))))
+
+  syntax Stmts ::= strangeLoopBody() [macro]
+  rule strangeLoopBody()
+    => If(
+         Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             Subscript(Name("ordered"), BinOp("//", Name("i"), Int(2))))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             Subscript(
+               Name("ordered"),
+               BinOp(
+                 "-",
+                 BinOp(
+                   "-",
+                   Call(Name("len"), Name("ordered")),
+                   BinOp("//", Name("i"), Int(2))),
+                 Int(1))))))
+       AugAssign(Name("i"), "+", Int(1))
+
+  syntax Stmts ::= strangeBody() [macro]
+  rule strangeBody()
+    => Assign(Name("ordered"), Call(Name("sorted"), Name("lst")))
+       Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("i"), Int(0))
+       While(strangeCondition(), strangeLoopBody())
+       Return(Name("result"))
+
+  // Element selected at iteration I from an ascending sequence S of length N.
+  // pyMod(I, 2) is either zero or one for the nonnegative loop index.
+  syntax Val ::= strangePick(ValSeq, Int, Int) [function]
+  rule strangePick(S:ValSeq, I:Int, _N:Int)
+    => valSeqAt(S, (I -Int pyMod(I, 2)) /Int 2)
+    requires pyMod(I, 2) ==Int 0
+  rule strangePick(S:ValSeq, I:Int, N:Int)
+    => valSeqAt(S, N -Int ((I -Int pyMod(I, 2)) /Int 2) -Int 1)
+    requires pyMod(I, 2) =/=Int 0
+
+  // Prefix produced after I loop iterations.  The second rule is deliberately
+  // tail-facing: simplifying prefix(I + 1) exposes exactly one append, which
+  // is the list mutation performed by the next concrete loop step.
+  syntax ValSeq ::= strangePrefix(ValSeq, Int, Int) [function]
+  rule strangePrefix(_S:ValSeq, 0, _N:Int) => .ValSeq
+  rule strangePrefix(S:ValSeq, I:Int, N:Int)
+    => valSeqConcat(
+         strangePrefix(S, I -Int 1, N),
+         vCons(strangePick(S, I -Int 1, N), .ValSeq))
+    requires I >Int 0
+
+  syntax ValSeq ::= strangeResult(ValSeq) [function]
+  rule strangeResult(S:ValSeq)
+    => strangePrefix(S, vsLen(S), vsLen(S))
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled' in /work
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..14410dbb7833d762753d8cb75497b18e385681ec
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,18 @@
+def strange_sort_list(lst):
+    ordered = sorted(lst)
+    result = []
+    i = 0
+    while i < len(ordered):
+        if i % 2 == 0:
+            result.append(ordered[i // 2])
+        else:
+            result.append(ordered[len(ordered) - (i // 2) - 1])
+        i += 1
+    return result
+
+
+assert strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]
+assert strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]
+assert strange_sort_list([]) == []
+assert strange_sort_list([3, -1, 3, 2, 0]) == [-1, 3, 0, 3, 2]
+assert strange_sort_list([9]) == [9]
