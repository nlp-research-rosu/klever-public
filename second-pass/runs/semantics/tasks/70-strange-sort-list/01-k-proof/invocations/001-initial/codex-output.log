+        "ordered" |-> ref(HO:Int)
+        "result"  |-> ref(HR:Int)
+        "i"       |-> I:Int,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> BS:Scope
+      =>
+      1 |-> scope(
+        "lst"     |-> LIST
+        "ordered" |-> ref(HO)
+        "result"  |-> ref(HR)
+        "i"       |-> N:Int,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> BS
+    </scopes>
+    <heap>
+      HO |-> list(S:ValSeq)
+      HR |-> list(ACC:ValSeq)
+      =>
+      HO |-> list(S)
+      HR |-> list(strangePrefix(S, N, N))
+    </heap>
+    <scopeLoc> 2 </scopeLoc>
+    <heapLoc> 2 </heapLoc>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int I andBool I <=Int N
+      andBool N ==Int vsLen(S)
+      andBool ACC ==K strangePrefix(S, I, N)
+    [priority(30)]
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..14410dbb7833d762753d8cb75497b18e385681ec
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,18 @@
+def strange_sort_list(lst):
+    ordered = sorted(lst)
+    result = []
+    i = 0
+    while i < len(ordered):
+        if i % 2 == 0:
+            result.append(ordered[i // 2])
+        else:
+            result.append(ordered[len(ordered) - (i // 2) - 1])
+        i += 1
+    return result
+
+
+assert strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]
+assert strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]
+assert strange_sort_list([]) == []
+assert strange_sort_list([3, -1, 3, 2, 0]) == [-1, 3, 0, 3, 2]
+assert strange_sort_list([9]) == [9]
