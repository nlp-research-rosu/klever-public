@@ -0,0 +1,11 @@
+def strange_sort_list(lst):
+    ordered = sorted(lst)
+    result = []
+    i = 0
+    while i < len(ordered):
+        if i % 2 == 0:
+            result.append(ordered[i // 2])
+        else:
+            result.append(ordered[len(ordered) - (i // 2) - 1])
+        i += 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f3b13fb6a5b4c69213798d93efc2942b168697fa
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,70 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive loop invariant.  S is the already sorted sequence, N its
+  // length, and result contains exactly the first I alternating selections.
+  claim [loop-invariant]:
+    <k> #while(strangeCondition(), strangeLoopBody()) => .K </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        "ordered" |-> ref(HO:Int)
+        "result"  |-> ref(HR:Int)
+        "i"       |-> I:Int
+        FRAME:Map,
+        P:Parent)
+      SCOPES:Map
+      =>
+      L |-> scope(
+        "ordered" |-> ref(HO)
+        "result"  |-> ref(HR)
+        "i"       |-> N:Int
+        FRAME,
+        P)
+      SCOPES
+    </scopes>
+    <heap>
+      HO |-> list(S:ValSeq)
+      HR |-> list(strangePrefix(S, I, N))
+      HEAP:Map
+      =>
+      HO |-> list(S)
+      HR |-> list(strangePrefix(S, N, N))
+      HEAP
+    </heap>
+    requires 0 <=Int I andBool I <=Int N
+      andBool N ==Int vsLen(S)
+
+  // End-to-end claim for the actual translated function body.  The result is
+  // a fresh list containing the alternating low/high traversal of sortVS(VS).
+  claim [function-correct]:
+    <k>
+      Call(
+        closureVal(("lst", .ParamNames), strangeBody(), 0),
+        list(INPUT:ValSeq))
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(sortVS(INPUT))
+      1 |-> list(strangeResult(sortVS(INPUT)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
