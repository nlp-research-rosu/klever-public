+        "ordered" |-> ref(HO:Int)
+        "result"  |-> ref(HR:Int)
+        "i"       |-> I:Int,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> BS:Scope
+      =>
+      1 |-> scope(
+        "lst"     |-> LIST
+        "ordered" |-> ref(HO)
+        "result"  |-> ref(HR)
+        "i"       |-> N:Int,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> BS
+    </scopes>
+    <heap>
+      HO |-> list(S:ValSeq)
+      HR |-> list(ACC:ValSeq)
+      =>
+      HO |-> list(S)
+      HR |-> list(strangePrefix(S, N, N))
+    </heap>
+    <scopeLoc> 2 </scopeLoc>
+    <heapLoc> 2 </heapLoc>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires 0 <=Int I andBool I <=Int N
+      andBool N ==Int vsLen(S)
+      andBool ACC ==K strangePrefix(S, I, N)
+    [priority(30)]
+endmodule

