+      0  |-> scope(.Map, parent(-1))
+      -1 |-> BS:Scope
+      =>
+      1 |-> scope(
+        "lst"     |-> LIST
+        "ordered" |-> ref(HO)
+        "result"  |-> ref(HR)
+        "i"       |-> N:Int,
