Module(
  FuncDef("strange_sort_list", Params("lst"),
    Assign(Name("ordered"), Call(Name("sorted"), Name("lst")))
    Assign(Name("result"), ListExpr())
    Assign(Name("i"), Int(0))
    While(Compare(Name("i"), CmpOp("<", Call(Name("len"), Name("ordered")))),
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
        Expr(
          Call(
            Attribute(Name("result"), "append"),
            Subscript(Name("ordered"), BinOp("//", Name("i"), Int(2))))),
        Expr(
          Call(
            Attribute(Name("result"), "append"),
            Subscript(
              Name("ordered"),
              BinOp(
                "-",
                BinOp(
                  "-",
                  Call(Name("len"), Name("ordered")),
                  BinOp("//", Name("i"), Int(2))),
                Int(1))))))
      AugAssign(Name("i"), "+", Int(1)))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("strange_sort_list"),
        ListExpr(Int(1), Int(2), Int(3), Int(4))),
      CmpOp("==", ListExpr(Int(1), Int(4), Int(2), Int(3)))))
  Assert(
    Compare(
      Call(
        Name("strange_sort_list"),
        ListExpr(Int(5), Int(5), Int(5), Int(5))),
      CmpOp("==", ListExpr(Int(5), Int(5), Int(5), Int(5)))))
  Assert(
    Compare(
      Call(Name("strange_sort_list"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("strange_sort_list"),
        ListExpr(Int(3), UnaryOp("-", Int(1)), Int(3), Int(2), Int(0))),
      CmpOp(
        "==",
        ListExpr(UnaryOp("-", Int(1)), Int(3), Int(0), Int(3), Int(2)))))
  Assert(
    Compare(
      Call(Name("strange_sort_list"), ListExpr(Int(9))),
      CmpOp("==", ListExpr(Int(9))))))
