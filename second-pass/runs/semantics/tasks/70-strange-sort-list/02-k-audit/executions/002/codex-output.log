+        "lst"     |-> list(vCons(1, .ValSeq))
+        "ordered" |-> ref(0)
+        "result"  |-> ref(1)
+        "i"       |-> 1,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> scope(.Map, root)
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(vCons(1, .ValSeq))
+      1 |-> list(.ValSeq)
+      =>
+      0 |-> list(vCons(1, .ValSeq))
+      1 |-> list(strangePrefix(vCons(1, .ValSeq), 1, 1))
+    </heap>
+    <heapLoc> 2 </heapLoc>
+    <stack> .List </stack>
