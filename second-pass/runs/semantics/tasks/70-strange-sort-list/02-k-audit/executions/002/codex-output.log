diff --git a/evidence/05_bridge_witness.k b/evidence/05_bridge_witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..e39161671c87506a2b05bac28f273fcb3a1c13b6
--- /dev/null
+++ b/evidence/05_bridge_witness.k
@@ -0,0 +1,83 @@
+requires "verification.k"
+
+module BRIDGE-WITNESS-BASE
+  imports VERIFICATION-BASE
+
+  // The loop-summary rule accepts an arbitrary scope at -1.  Here "len" is
+  // absent, so fixed execution cannot evaluate the while condition.
+  claim [missing-len-fixed]:
+    <k> #while(strangeCondition(), strangeLoopBody()) => .K </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "lst"     |-> list(vCons(1, .ValSeq))
+        "ordered" |-> ref(0)
+        "result"  |-> ref(1)
+        "i"       |-> 0,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> scope(.Map, root)
+      =>
+      1 |-> scope(
+        "lst"     |-> list(vCons(1, .ValSeq))
+        "ordered" |-> ref(0)
+        "result"  |-> ref(1)
+        "i"       |-> 1,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> scope(.Map, root)
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(vCons(1, .ValSeq))
+      1 |-> list(.ValSeq)
+      =>
+      0 |-> list(vCons(1, .ValSeq))
+      1 |-> list(strangePrefix(vCons(1, .ValSeq), 1, 1))
+    </heap>
+    <heapLoc> 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module BRIDGE-WITNESS-EXTENDED
+  imports VERIFICATION
+
+  claim [missing-len-bridge]:
+    <k> #while(strangeCondition(), strangeLoopBody()) => .K </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "lst"     |-> list(vCons(1, .ValSeq))
+        "ordered" |-> ref(0)
+        "result"  |-> ref(1)
+        "i"       |-> 0,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> scope(.Map, root)
+      =>
+      1 |-> scope(
+        "lst"     |-> list(vCons(1, .ValSeq))
+        "ordered" |-> ref(0)
+        "result"  |-> ref(1)
+        "i"       |-> 1,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> scope(.Map, root)
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(vCons(1, .ValSeq))
+      1 |-> list(.ValSeq)
+      =>
+      0 |-> list(vCons(1, .ValSeq))
+      1 |-> list(strangePrefix(vCons(1, .ValSeq), 1, 1))
+    </heap>
+    <heapLoc> 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/05_rule_inventory.py b/evidence/05_rule_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..5fdd828b86837ab3dbedf2a9d3ddfbda7686f46c
--- /dev/null
+++ b/evidence/05_rule_inventory.py
@@ -0,0 +1,277 @@
+#!/usr/bin/env python3
+"""Enumerate every K sentence and attach the audit disposition used in REVIEW.md."""
+
+from __future__ import annotations
+
+import glob
+import re
+from pathlib import Path
+
+
+ROOT = Path("/tmp/audit-work/task70")
+FILES = [
+    ROOT / "reference-semantics" / "semantics.k",
+    *map(Path, sorted(glob.glob(str(ROOT / "reference-semantics" / "semantics" / "*.k")))),
+    ROOT / "verification.k",
+]
+START = re.compile(
+    r"^\s*(configuration|syntax|context|rule|claim|alias)\b"
+)
+
+USED_MARKERS = {
+    "core.k": (
+        "#alloc",
+        "#loadAll",
+        "Name(",
+        "#look",
+        "builtinsScope",
+        "#evalArgs",
+        "#evalArgCont",
+        "Int(I",
+        "truthy(B",
+        "appendVal",
+        "vals2valSeq",
+        "vsLen",
+        "isRefV",
+    ),
+    "controls.k": (
+        "Assign(Name",
+        "AugAssign(Name",
+        "Expr(_:Val)",
+        "#branch",
+        "If(",
+        "#while",
+        "#whileCond",
+        "While(",
+    ),
+    "functions.k": (
+        "FuncDef(",
+        "#bindP",
+        "Return(",
+        "#endcall",
+        "#pop",
+        "frame(",
+    ),
+    "call.k": (
+        "Attribute(",
+        "Call(",
+        "#callee",
+        "#evalArgs",
+        "closureVal(",
+        "builtinV(BN",
+        "boundMethodV(",
+    ),
+    "int.k": (
+        'applyBin("+",',
+        'applyBin("-",',
+        'applyBin("%",',
+        'applyBin("//",',
+        "pyMod(",
+        'applyCmp("<",',
+        'applyCmp("==",',
+    ),
+    "operators.k": (
+        "BinOp(",
+        "Compare(",
+        "applyCmp(",
+    ),
+    "list.k": (
+        "#iterNext(list",
+        "ListExpr(",
+        "toList",
+        "valSeqConcat",
+        '"append"',
+    ),
+    "subscript.k": (
+        "valSeqAt",
+        "normIdx",
+        "Subscript(",
+        "applyIndex(list",
+    ),
+    "builtins.k": (
+        '"len"',
+        "seqLen(",
+    ),
+    "sort.k": (
