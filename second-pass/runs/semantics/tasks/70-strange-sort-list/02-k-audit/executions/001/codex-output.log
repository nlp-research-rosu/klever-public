+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "lst"     |-> list(vCons(2, vCons(1, vCons(3, .ValSeq))))
+        "ordered" |-> ref(0)
+        "result"  |-> ref(1)
+        "i"       |-> 0,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      1 |-> scope(
+        "lst"     |-> list(vCons(2, vCons(1, vCons(3, .ValSeq))))
+        "ordered" |-> ref(0)
+        "result"  |-> ref(1)
+        "i"       |-> 3
+        "marker"  |-> 99,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
