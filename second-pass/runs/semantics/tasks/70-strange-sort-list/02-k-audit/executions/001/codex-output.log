+      1 |-> list(strangePrefix(vCons(7, .ValSeq), 1, 1))
+    </heap>
+    <heapLoc> 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
