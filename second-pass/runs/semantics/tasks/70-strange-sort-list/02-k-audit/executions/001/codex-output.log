+++ b//tmp/audit-work/recon/ground-spec.k
@@ -0,0 +1,180 @@
+requires "verification.k"
+
+module GROUND-SPEC
+  imports VERIFICATION-BASE
+
+  claim [ground-empty]:
+    <k>
+      Call(
+        closureVal(("lst", .ParamNames), strangeBody(), 0),
+        list(.ValSeq))
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(.ValSeq)
+      1 |-> list(.ValSeq)
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [ground-three]:
+    <k>
+      Call(
+        closureVal(("lst", .ParamNames), strangeBody(), 0),
+        list(vCons(2, vCons(1, vCons(3, .ValSeq)))))
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
