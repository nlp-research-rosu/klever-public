diff --git a//tmp/audit-work/recon/audit_concrete.py b//tmp/audit-work/recon/audit_concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..b3a7b06610b75c52e1df960340bd34e3ab316534
--- /dev/null
+++ b//tmp/audit-work/recon/audit_concrete.py
@@ -0,0 +1,20 @@
+def strange_sort_list(lst):
+    ordered = sorted(lst)
+    result = []
+    i = 0
+    while i < len(ordered):
+        if i % 2 == 0:
+            result.append(ordered[i // 2])
+        else:
+            result.append(ordered[len(ordered) - (i // 2) - 1])
+        i += 1
+    return result
+
+
+assert strange_sort_list([]) == []
+assert strange_sort_list([0]) == [0]
+assert strange_sort_list([2, 1]) == [1, 2]
+assert strange_sort_list([2, 1, 3]) == [1, 3, 2]
+assert strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]
+assert strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]
+assert strange_sort_list([3, -1, 3, 2, 0]) == [-1, 3, 0, 3, 2]
diff --git a//tmp/audit-work/recon/ground-spec.k b//tmp/audit-work/recon/ground-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2445c248e4e6f5e48e079a9f66d50dd6d02e7ec6
--- /dev/null
+++ b//tmp/audit-work/recon/ground-spec.k
@@ -0,0 +1,180 @@
+requires "verification.k"
+
+module GROUND-SPEC
+  imports VERIFICATION-BASE
+
+  claim [ground-empty]:
+    <k>
+      Call(
+        closureVal(("lst", .ParamNames), strangeBody(), 0),
+        list(.ValSeq))
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(.ValSeq)
+      1 |-> list(.ValSeq)
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [ground-three]:
+    <k>
+      Call(
+        closureVal(("lst", .ParamNames), strangeBody(), 0),
+        list(vCons(2, vCons(1, vCons(3, .ValSeq)))))
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, vCons(2, vCons(3, .ValSeq))))
+      1 |-> list(vCons(1, vCons(3, vCons(2, .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [ground-four]:
+    <k>
+      Call(
+        closureVal(("lst", .ParamNames), strangeBody(), 0),
+        list(vCons(4, vCons(1, vCons(3, vCons(2, .ValSeq))))))
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, vCons(2, vCons(3, vCons(4, .ValSeq)))))
+      1 |-> list(vCons(1, vCons(4, vCons(2, vCons(3, .ValSeq)))))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module BRIDGE-CONTINUATION-SPEC
+  imports VERIFICATION-BASE
+
+  claim [continuation]:
+    <k>
+      #while(strangeCondition(), strangeLoopBody())
+      ~> Assign(Name("marker"), Int(99))
+      =>
+      .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "lst"     |-> list(vCons(2, vCons(1, vCons(3, .ValSeq))))
+        "ordered" |-> ref(0)
+        "result"  |-> ref(1)
+        "i"       |-> 0,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      1 |-> scope(
+        "lst"     |-> list(vCons(2, vCons(1, vCons(3, .ValSeq))))
+        "ordered" |-> ref(0)
+        "result"  |-> ref(1)
+        "i"       |-> 3
+        "marker"  |-> 99,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(vCons(1, vCons(2, vCons(3, .ValSeq))))
+      1 |-> list(.ValSeq)
+      =>
+      0 |-> list(vCons(1, vCons(2, vCons(3, .ValSeq))))
+      1 |-> list(vCons(1, vCons(3, vCons(2, .ValSeq))))
+    </heap>
+    <heapLoc> 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module BRIDGE-OVERBREADTH-SPEC
+  imports VERIFICATION-BASE
+
+  // The summary rule accepts this state because its BS variable does not
+  // require builtinsScope. Fixed execution cannot resolve len in this state.
+  claim [missing-builtins]:
+    <k> #while(strangeCondition(), strangeLoopBody()) => .K </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "lst"     |-> list(vCons(7, .ValSeq))
+        "ordered" |-> ref(0)
+        "result"  |-> ref(1)
+        "i"       |-> 0,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> scope(.Map, parent(-1))
+      =>
+      1 |-> scope(
+        "lst"     |-> list(vCons(7, .ValSeq))
+        "ordered" |-> ref(0)
+        "result"  |-> ref(1)
+        "i"       |-> 1,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> scope(.Map, parent(-1))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(vCons(7, .ValSeq))
+      1 |-> list(strangePrefix(vCons(7, .ValSeq), 0, 1))
+      =>
+      0 |-> list(vCons(7, .ValSeq))
+      1 |-> list(strangePrefix(vCons(7, .ValSeq), 1, 1))
+    </heap>
+    <heapLoc> 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
