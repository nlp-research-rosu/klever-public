+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [ground-four]:
+    <k>
