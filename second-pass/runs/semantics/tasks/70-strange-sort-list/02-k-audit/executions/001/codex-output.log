+#!/usr/bin/env bash
+set -u
+
+work=/tmp/audit-work/recon
+raw_dir="$work/raw-logs"
+mkdir -p "$raw_dir"
+failed=0
+
+run_bounded() {
+  local label=$1
+  shift
+  local raw="$raw_dir/$label.log"
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@" >"$raw" 2>&1
+  local status=$?
+  local lines
+  lines=$(wc -l <"$raw")
+  printf '[captured %d lines in %s]\n' "$lines" "$raw"
+  sed -n '1,180p' "$raw"
+  if (( lines > 260 )); then
+    printf '[... middle omitted from bounded evidence log ...]\n'
+    tail -n 80 "$raw"
+  fi
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+run_bounded kast_solution \
+  kast solution.mpy \
+  --definition runtime-kompiled \
+  --sort Module \
+  --module MPY-SYNTAX \
+  --output json \
+  --output-file solution.kast.json || failed=1
+run_bounded kast_macro \
+  kast \
+  --expression 'strangeBody()' \
+  --definition verification-base-kompiled \
+  --sort Stmts \
+  --module VERIFICATION-BASE \
+  --expand-macros \
+  --output json \
+  --output-file body.kast.json || failed=1
+run_bounded compare_body python3 /audit-output/evidence/compare_kast_body.py || failed=1
+
+run_bounded ground_base \
+  kprove ground-spec.k \
+  --definition verification-base-kompiled \
+  --spec-module GROUND-SPEC || failed=1
+run_bounded ground_summary \
+  kprove ground-spec.k \
+  --definition verification-kompiled \
+  --spec-module GROUND-SPEC || failed=1
+
+run_bounded continuation_base \
+  kprove ground-spec.k \
+  --definition verification-base-kompiled \
+  --spec-module BRIDGE-CONTINUATION-SPEC || failed=1
+run_bounded continuation_summary \
+  kprove ground-spec.k \
+  --definition verification-kompiled \
+  --spec-module BRIDGE-CONTINUATION-SPEC || failed=1
+
+printf '\nExpected diagnostic: the over-broad bridge claim must fail without the bridge.\n'
+run_bounded overbreadth_base \
+  kprove ground-spec.k \
+  --definition verification-base-kompiled \
+  --spec-module BRIDGE-OVERBREADTH-SPEC
+overbreadth_base_status=$?
+if (( overbreadth_base_status == 0 )); then
+  printf 'UNEXPECTED: fixed semantics proved the missing-builtins claim\n'
+  failed=1
+else
+  printf 'expected fixed-semantics rejection observed\n'
+fi
+
+printf '\nExpected diagnostic: the same claim closes with the candidate summary.\n'
+run_bounded overbreadth_summary \
+  kprove ground-spec.k \
+  --definition verification-kompiled \
+  --spec-module BRIDGE-OVERBREADTH-SPEC
+overbreadth_summary_status=$?
+if (( overbreadth_summary_status != 0 )); then
+  printf 'UNEXPECTED: bridge-enabled proof did not close\n'
+  failed=1
+else
+  printf 'bridge over-breadth witness confirmed\n'
+fi
+
+exit "$failed"

codex
The body-pinning check is exact: independent K parsing shows the expanded `strangeBody()` term equals the sole translated function body byte-for-structure. A deeper issue has surfaced: the fixed semantics proves concrete outputs, but the bridge-enabled definition stops at opaque `strangePrefix(...)` terms and cannot prove those equal the same concrete lists. I’m preserving that residual and checking whether it is merely an intent bridge limitation or permits a false entry-domain result.
diff --git a//tmp/audit-work/recon/audit_concrete.py b//tmp/audit-work/recon/audit_concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..b3a7b06610b75c52e1df960340bd34e3ab316534
--- /dev/null
+++ b//tmp/audit-work/recon/audit_concrete.py
@@ -0,0 +1,20 @@
+def strange_sort_list(lst):
+    ordered = sorted(lst)
+    result = []
+    i = 0
+    while i < len(ordered):
+        if i % 2 == 0:
+            result.append(ordered[i // 2])
+        else:
+            result.append(ordered[len(ordered) - (i // 2) - 1])
+        i += 1
+    return result
+
+
+assert strange_sort_list([]) == []
+assert strange_sort_list([0]) == [0]
+assert strange_sort_list([2, 1]) == [1, 2]
+assert strange_sort_list([2, 1, 3]) == [1, 3, 2]
+assert strange_sort_list([1, 2, 3, 4]) == [1, 4, 2, 3]
+assert strange_sort_list([5, 5, 5, 5]) == [5, 5, 5, 5]
+assert strange_sort_list([3, -1, 3, 2, 0]) == [-1, 3, 0, 3, 2]
