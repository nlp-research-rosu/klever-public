+      =>
+      0 |-> list(sortVS(INPUT))
+      1 |-> list(vCons(0, strangeResult(sortVS(INPUT))))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
