+#!/usr/bin/env bash
+set -u
+
+work=/tmp/audit-work/recon
+raw_dir="$work/raw-logs"
+mkdir -p "$raw_dir"
+failed=0
+
+run_bounded() {
+  local label=$1
+  shift
+  local raw="$raw_dir/$label.log"
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@" >"$raw" 2>&1
+  local status=$?
+  local lines
+  lines=$(wc -l <"$raw")
+  printf '[captured %d lines in %s]\n' "$lines" "$raw"
+  sed -n '1,180p' "$raw"
+  if (( lines > 260 )); then
+    printf '[... middle omitted from bounded evidence log ...]\n'
+    tail -n 80 "$raw"
+  fi
+  printf '[exit %d]\n' "$status"
