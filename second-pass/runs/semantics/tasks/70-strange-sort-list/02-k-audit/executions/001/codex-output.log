+      =>
+      1 |-> scope(
+        "lst"     |-> list(vCons(7, .ValSeq))
+        "ordered" |-> ref(0)
+        "result"  |-> ref(1)
+        "i"       |-> 1,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> scope(.Map, parent(-1))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(vCons(7, .ValSeq))
+      1 |-> list(strangePrefix(vCons(7, .ValSeq), 0, 1))
+      =>
+      0 |-> list(vCons(7, .ValSeq))
+      1 |-> list(strangePrefix(vCons(7, .ValSeq), 1, 1))
+    </heap>
+    <heapLoc> 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
