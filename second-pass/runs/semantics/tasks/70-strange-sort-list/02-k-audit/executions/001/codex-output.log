+        list(.ValSeq))
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(.ValSeq)
+      1 |-> list(.ValSeq)
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [ground-three]:
+    <k>
+      Call(
+        closureVal(("lst", .ParamNames), strangeBody(), 0),
+        list(vCons(2, vCons(1, vCons(3, .ValSeq)))))
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, vCons(2, vCons(3, .ValSeq))))
+      1 |-> list(vCons(1, vCons(3, vCons(2, .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [ground-four]:
+    <k>
+      Call(
+        closureVal(("lst", .ParamNames), strangeBody(), 0),
+        list(vCons(4, vCons(1, vCons(3, vCons(2, .ValSeq))))))
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(1, vCons(2, vCons(3, vCons(4, .ValSeq)))))
+      1 |-> list(vCons(1, vCons(4, vCons(2, vCons(3, .ValSeq)))))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module BRIDGE-CONTINUATION-SPEC
+  imports VERIFICATION-BASE
+
+  claim [continuation]:
+    <k>
+      #while(strangeCondition(), strangeLoopBody())
+      ~> Assign(Name("marker"), Int(99))
+      =>
+      .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "lst"     |-> list(vCons(2, vCons(1, vCons(3, .ValSeq))))
+        "ordered" |-> ref(0)
+        "result"  |-> ref(1)
+        "i"       |-> 0,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      1 |-> scope(
+        "lst"     |-> list(vCons(2, vCons(1, vCons(3, .ValSeq))))
+        "ordered" |-> ref(0)
+        "result"  |-> ref(1)
+        "i"       |-> 3
+        "marker"  |-> 99,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(vCons(1, vCons(2, vCons(3, .ValSeq))))
+      1 |-> list(.ValSeq)
+      =>
+      0 |-> list(vCons(1, vCons(2, vCons(3, .ValSeq))))
+      1 |-> list(vCons(1, vCons(3, vCons(2, .ValSeq))))
+    </heap>
+    <heapLoc> 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module BRIDGE-OVERBREADTH-SPEC
+  imports VERIFICATION-BASE
+
+  // The summary rule accepts this state because its BS variable does not
+  // require builtinsScope. Fixed execution cannot resolve len in this state.
+  claim [missing-builtins]:
+    <k> #while(strangeCondition(), strangeLoopBody()) => .K </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "lst"     |-> list(vCons(7, .ValSeq))
+        "ordered" |-> ref(0)
+        "result"  |-> ref(1)
+        "i"       |-> 0,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> scope(.Map, parent(-1))
+      =>
+      1 |-> scope(
+        "lst"     |-> list(vCons(7, .ValSeq))
+        "ordered" |-> ref(0)
+        "result"  |-> ref(1)
+        "i"       |-> 1,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> scope(.Map, parent(-1))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> list(vCons(7, .ValSeq))
+      1 |-> list(strangePrefix(vCons(7, .ValSeq), 0, 1))
+      =>
+      0 |-> list(vCons(7, .ValSeq))
+      1 |-> list(strangePrefix(vCons(7, .ValSeq), 1, 1))
+    </heap>
+    <heapLoc> 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/compare_kast_body.py b/evidence/compare_kast_body.py
new file mode 100644
index 0000000000000000000000000000000000000000..aad35088b6c73d8c39d3eec044586eea780d2ccd
--- /dev/null
+++ b/evidence/compare_kast_body.py
@@ -0,0 +1,48 @@
+#!/usr/bin/env python3
+"""Compare the translated function body with the expanded proof macro."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+
+def compact(value: object) -> bytes:
+    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()
+
+
+solution = json.loads(
+    Path("/tmp/audit-work/recon/solution.kast.json").read_text()
+)["term"]
+macro_body = json.loads(
+    Path("/tmp/audit-work/recon/body.kast.json").read_text()
+)["term"]
+
+assert solution["label"]["name"] == "Module(_)_MPY-SYNTAX_Module_Stmts"
+statements = solution["args"][0]
+assert statements["label"]["name"].startswith("___MPY-SYNTAX_Stmts_")
+function = statements["args"][0]
+tail = statements["args"][1]
+
+name_token, params, translated_body = function["args"]
+name = name_token["token"]
+param_name = params["args"][0]["args"][0]["token"]
+tail_label = tail["label"]["name"]
+
+body_equal = translated_body == macro_body
+translated_digest = hashlib.sha256(compact(translated_body)).hexdigest()
+macro_digest = hashlib.sha256(compact(macro_body)).hexdigest()
+
+print(f"translated_function_name={name}")
+print(f"translated_parameter={param_name}")
+print(f"translated_module_tail_label={tail_label}")
+print(f"translated_body_sha256={translated_digest}")
+print(f"expanded_strangeBody_sha256={macro_digest}")
+print(f"body_json_equal={body_equal}")
+
+if name != '"strange_sort_list"' or param_name != '"lst"':
+    raise SystemExit("unexpected translated entry point")
+if not tail_label.startswith(".List"):
+    raise SystemExit("solution.mpy contains unexpected top-level statements")
+raise SystemExit(0 if body_equal else 1)
