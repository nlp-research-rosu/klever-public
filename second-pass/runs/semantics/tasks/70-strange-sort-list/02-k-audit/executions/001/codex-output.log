+  /tmp/audit-work/recon/raw-logs/mutation_proof.log || failed=1
+run rg -n -F 'vCons ( 0 , strangePrefix' \
+  /tmp/audit-work/recon/raw-logs/mutation_proof.log || failed=1
+
+run sha256sum \
+  /audit-output/REVIEW.md \
+  /audit-output/evidence/differential_test.py \
