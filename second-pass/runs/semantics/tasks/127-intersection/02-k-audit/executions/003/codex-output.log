+        a = generator.randint(-10**6, 10**6)
+        b = a + generator.randint(0, 500)
+        c = generator.randint(-10**6, 10**6)
+        d = c + generator.randint(0, 500)
+        check("deterministic generated", (a, b), (c, d))
