     1	def intersection(interval1, interval2):
     2	    """You are given two intervals,
     3	    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).
     4	    The given intervals are closed which means that the interval (start, end)
     5	    includes both start and end.
     6	    For each given interval, it is assumed that its start is less or equal its end.
     7	    Your task is to determine whether the length of intersection of these two
     8	    intervals is a prime number.
     9	    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)
    10	    which its length is 1, which not a prime number.
    11	    If the length of the intersection is a prime number, return "YES",
    12	    otherwise, return "NO".
    13	    If the two intervals don't intersect, return "NO".
    14	
    15	
    16	    [input/output] samples:
    17	    intersection((1, 2), (2, 3)) ==> "NO"
    18	    intersection((-1, 1), (0, 4)) ==> "NO"
    19	    intersection((-3, 9), (-1, 4)) ==> "YES"
    20	    """
    21	    def is_prime(num):
    22	        if num == 1 or num == 0:
    23	            return False
    24	        if num == 2:
    25	            return True
    26	        for i in range(2, num):
    27	            if num%i == 0:
    28	                return False
    29	        return True
