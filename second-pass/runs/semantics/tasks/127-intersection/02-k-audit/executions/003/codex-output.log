+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: valid intervals with prime overlap (for example,
+  // (0,2) and (0,2)) must return YES, but this mutation requires NO always.
+  claim
+    <k> Call(Name("intersection"),
+             TupleExpr(Int(A:Int), Int(B:Int), .Exprs),
+             TupleExpr(Int(C:Int), Int(D:Int), .Exprs),
+             .Exprs)
+      => noV
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "intersection" |->
+          closureVal(("interval1", "interval2", .ParamNames),
+                     intersectionBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A <=Int B andBool C <=Int D
+    [label(false-postcondition)]
+endmodule

The detailed seven-stage review, complete evidence ledger, exact commands, static inventory, and final verdict are written and validated.
  ✓ Verify launcher manifests, campaign lock, mounted provenance, and supplied-semantics integrity
  ✓ Check program fidelity and run independent differential tests
  ✓ Rebuild semantics/proof cleanly and execute every positive claim
  ✓ Audit claim adequacy and pinning to the regenerated program
  ✓ Inventory and assess every local K declaration and rule
  ✓ Run a fresh meaningful false-postcondition mutation
  ✓ Account for proven versus assumed facts and write REVIEW.md with the verdict
