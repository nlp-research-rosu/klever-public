Module(
  FuncDef("intersection", Params("interval1", "interval2"),
    Assign(
      Name("left"),
      Call(
        Name("max"),
        Subscript(Name("interval1"), Int(0)),
        Subscript(Name("interval2"), Int(0))))
    Assign(
      Name("right"),
      Call(
        Name("min"),
        Subscript(Name("interval1"), Int(1)),
        Subscript(Name("interval2"), Int(1))))
    Assign(Name("length"), BinOp("-", Name("right"), Name("left")))
    If(Compare(Name("length"), CmpOp("<=", Int(1))),
      Return(Str("NO")),
      )
    Assign(Name("divisor"), Int(2))
    For(Name("divisor"), Call(Name("range"), Int(2), Name("length")),
      If(Compare(
        BinOp("%", Name("length"), Name("divisor")),
        CmpOp("==", Int(0))),
        Return(Str("NO")),
        ))
    Return(Str("YES")))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(1), Int(2)),
        TupleExpr(Int(2), Int(3))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(UnaryOp("-", Int(1)), Int(1)),
        TupleExpr(Int(0), Int(4))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(UnaryOp("-", Int(3)), UnaryOp("-", Int(1))),
        TupleExpr(UnaryOp("-", Int(5)), Int(5))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(1), Int(3)),
        TupleExpr(Int(0), Int(5))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(0), Int(7)),
        TupleExpr(Int(0), Int(7))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(0), Int(6)),
        TupleExpr(Int(0), Int(6))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("intersection"),
        TupleExpr(Int(0), Int(3)),
        TupleExpr(Int(10), Int(12))),
      CmpOp("==", Str("NO")))))
