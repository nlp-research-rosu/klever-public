+  --claims intersection-correct \
+  --output pretty
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..02324e3513b09d73a4239e86d7cd5f6bfc11db24
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def intersection(interval1, interval2):
+    left = max(interval1[0], interval2[0])
+    right = min(interval1[1], interval2[1])
+
+    length = right - left
+    if length <= 1:
+        return "NO"
+
+    divisor = 2
+    for divisor in range(2, length):
+        if length % divisor == 0:
+            return "NO"
+
+    return "YES"
