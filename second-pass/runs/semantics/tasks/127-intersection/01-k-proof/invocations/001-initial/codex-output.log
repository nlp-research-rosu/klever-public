new file mode 100644
index 0000000000000000000000000000000000000000..00f4278fd9fe48df0281d5d2db965860e04c82e3
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,19 @@
+def intersection(interval1, interval2):
+    left = interval1[0]
+    if interval2[0] > left:
+        left = interval2[0]
+
+    right = interval1[1]
+    if interval2[1] < right:
+        right = interval2[1]
+
+    length = right - left
+    if length <= 1:
+        return "NO"
+
+    divisor = 2
+    for divisor in range(2, length):
+        if length % divisor == 0:
+            return "NO"
+
+    return "YES"
