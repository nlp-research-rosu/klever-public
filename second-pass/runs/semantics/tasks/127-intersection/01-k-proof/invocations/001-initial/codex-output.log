+      => primeFrom(LENGTH, DIVISOR) ~> KONT:K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      SC:Map
+       1 |-> scope(
+         "interval1" |-> INTERVAL1:Val
+         "interval2" |-> INTERVAL2:Val
+         "left"      |-> LEFT:Int
+         "right"     |-> RIGHT:Int
+         "length"    |-> LENGTH
+         "divisor"   |-> OLD:Int,
+         parent(0))
+      => SC
