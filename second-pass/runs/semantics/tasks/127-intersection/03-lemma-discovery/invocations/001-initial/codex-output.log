+      "classification": "DEFINITION",
+      "rationale": "This equation defines primeResult for N greater than 1 by starting the primeFrom divisor recurrence at 2."
+    },
+    {
+      "source_rule_id": "rule-0c9edd4e23025de56e77c15f109ea9a7d86609c63e5f44e9d3c83c10c12c43a2",
+      "classification": "DEFINITION",
+      "rationale": "This equation defines the named mathematical summary overlapLength as the minimum right endpoint minus the maximum left endpoint."
+    },
+    {
+      "source_rule_id": "rule-3564ec1a0c7873a21e248d06a49acdb05fe46af166b68d498bbff1afc2702e72",
+      "classification": "PROVED_DERIVED_LEMMA",
+      "rationale": "The same loop summary is first proved by the loop-correct claim against VERIFICATION-BASE, which lacks this rule; prove.sh then compiles VERIFICATION, where the proved summary is installed for the end-to-end proof. The rule expands divisorBody and alpha-renames unused frame variables but otherwise matches the proved claim."
+    }
+  ]
+}

