from pathlib import Path
import re
counts = {}
names = {}
for path in sorted(Path('/workspace/Base/Klean127Intersection').glob('*.lean')):
    found=[]
    opaque=[]
    for line in path.read_text().splitlines():
        s=line.strip()
        if s.startswith('axiom '): found.append(s.split(':',1)[0].strip())
        if re.match(r'(?:private\\s+)?opaque\\s+',s): opaque.append(s)
    if found or opaque:
        counts[path.name]=(len(found),len(opaque))
        names[path.name]=found
print('base trusted counts:', counts)
print('base axiom total:', sum(a for a,_ in counts.values()))
print('base opaque total:', sum(o for _,o in counts.values()))
print('Func axioms:')
for name in names.get('Func.lean',[]): print(' ',name)
PY
