diff --git a/lean_app_path_shim.c b/lean_app_path_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..3dd31ef1051d329d500e2692d19f0ac0c2e7574b
--- /dev/null
+++ b/lean_app_path_shim.c
@@ -0,0 +1,17 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static ssize_t (*next_readlink)(const char *, char *, size_t) = NULL;
+  if (next_readlink == NULL) {
+    next_readlink = dlsym(RTLD_NEXT, "readlink");
+  }
+  if (strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + strlen(path) - 4, "/exe") == 0) {
+    path = "/proc/self/exe";
+  }
+  return next_readlink(path, buffer, size);
+}

