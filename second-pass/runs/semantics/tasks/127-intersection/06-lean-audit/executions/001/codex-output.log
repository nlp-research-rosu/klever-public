    40	
    41	# Then install precisely that proved invariant as a modular summary and prove
    42	# the universally quantified end-to-end function contract.
    43	kompile verification.k \
    44	  --backend haskell \
    45	  --main-module VERIFICATION \
    46	  --syntax-module MPY-SYNTAX \
    47	  --output-definition verification-kompiled
