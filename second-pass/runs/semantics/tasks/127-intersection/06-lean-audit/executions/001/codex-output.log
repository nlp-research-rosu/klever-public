    51	  --claims intersection-correct \
    52	  --output pretty

[spec.k]
     1	requires "verification.k"
     2	
     3	module LOOP-SPEC
     4	  imports VERIFICATION-BASE
     5	
     6	  // Loop invariant / total-correctness lemma.  Starting at candidate DIVISOR,
     7	  // the remaining MPY loop returns the same answer as primeFrom.
     8	  claim
     9	    <k> #loop(rangeObj(DIVISOR:Int, LENGTH:Int, 1),
    10	              Name("divisor"), divisorBody)
    11	        ~> (Return(Str("YES")) .Stmts) ~> #endcall
    12	      => primeFrom(LENGTH, DIVISOR) ~> KONT:K
    13	    </k>
    14	    <env> 1 => 0 </env>
    15	    <scopes>
    16	      SC:Map
    17	       1 |-> scope(
    18	         "interval1" |-> INTERVAL1:Val
    19	         "interval2" |-> INTERVAL2:Val
    20	         "left"      |-> LEFT:Int
    21	         "right"     |-> RIGHT:Int
    22	         "length"    |-> LENGTH
    23	         "divisor"   |-> OLD:Int,
    24	         parent(0))
    25	      => SC
    26	    </scopes>
    27	    <scopeLoc> 2 => 1 </scopeLoc>
    28	    <stack> ListItem(frame(KONT, 0, 1)) => .List </stack>
    29	    <ret> noRet </ret>
    30	    requires 2 <=Int DIVISOR andBool DIVISOR <=Int LENGTH
    31	    [label(loop-correct)]
    32	
    33	endmodule
    34	
    35	module SPEC
    36	  imports VERIFICATION
    37	
    38	  // The complete, universally quantified function contract.  A..B and C..D
    39	  // are valid closed intervals.  The result is YES exactly when
    40	  // min(B,D)-max(A,C) is prime according to the divisor definition above.
    41	  claim
    42	    <k> Call(Name("intersection"),
    43	             TupleExpr(Int(A:Int), Int(B:Int), .Exprs),
    44	             TupleExpr(Int(C:Int), Int(D:Int), .Exprs),
    45	             .Exprs)
    46	      => primeResult(overlapLength(A, B, C, D))
    47	    </k>
    48	    <env> 0 </env>
    49	    <scopes>
    50	      0 |-> scope(
    51	        "intersection" |->
    52	          closureVal(("interval1", "interval2", .ParamNames),
    53	                     intersectionBody, 0),
    54	        parent(-1))
    55	      -1 |-> builtinsScope
    56	    </scopes>
    57	    <scopeLoc> 1 </scopeLoc>
    58	    <heap> .Map </heap>
    59	    <heapLoc> 0 </heapLoc>
    60	    <stack> .List </stack>
    61	    <ret> noRet </ret>
    62	    <exc> NoExc </exc>
    63	    <exit-code> 0 </exit-code>
    64	    requires A <=Int B andBool C <=Int D
    65	    [label(intersection-correct)]
    66	endmodule

[solution.py]
     1	def intersection(interval1, interval2):
     2	    left = max(interval1[0], interval2[0])
     3	    right = min(interval1[1], interval2[1])
     4	
     5	    length = right - left
     6	    if length <= 1:
     7	        return "NO"
     8	
     9	    divisor = 2
    10	    for divisor in range(2, length):
    11	        if length % divisor == 0:
    12	            return "NO"
    13	
    14	    return "YES"

[prompt.py]
     1	
     2	def intersection(interval1, interval2):
     3	    """You are given two intervals,
     4	    where each interval is a pair of integers. For example, interval = (start, end) = (1, 2).
     5	    The given intervals are closed which means that the interval (start, end)
     6	    includes both start and end.
     7	    For each given interval, it is assumed that its start is less or equal its end.
     8	    Your task is to determine whether the length of intersection of these two 
     9	    intervals is a prime number.
    10	    Example, the intersection of the intervals (1, 3), (2, 4) is (2, 3)
    11	    which its length is 1, which not a prime number.
    12	    If the length of the intersection is a prime number, return "YES",
    13	    otherwise, return "NO".
    14	    If the two intervals don't intersect, return "NO".
    15	
    16	
    17	    [input/output] samples:
    18	    intersection((1, 2), (2, 3)) ==> "NO"
    19	    intersection((-1, 1), (0, 4)) ==> "NO"
    20	    intersection((-3, -1), (-5, 5)) ==> "YES"
    21	    """

