+import Proof
+
+namespace VacuityAudit
+
+theorem scopeEmpty : ∀ frame : SortScope, False := by
+  intro frame
+  exact nomatch frame
+
+-- Deliberately dishonest counterfactual bindings. If the generated target
+-- were meaningful, these should not establish the frozen Map deletion law.
+def badMap (left _right : SortMap) : SortMap := left
+def badInKeys (_key : SortKItem) (_map : SortMap) : SortBool := false
+def badRemove (map : SortMap) (_key : SortKItem) : SortMap := map
+def badElement (_key _value : SortKItem) : SortMap := ⟨[]⟩
+def badNotBool (_value : SortBool) : SortBool := true
+
+theorem badFinal :
+    Klean127Intersection.Lemmas.targetStatement
+      badMap badInKeys badRemove badElement badNotBool := by
+  intro _REST frame
+  exact nomatch frame
+
+-- Candidate concatenation accepts duplicate keys and returns an ordinary
+-- two-entry map instead of representing the K Map operation's undefined
+-- overlapping-key case.
+def oneKey : SortMap :=
+  Proof.«_|->_»
+    (SortKItem.inj_SortInt 1)
+    (SortKItem.inj_SortInt 7)
+
+example : (Proof._Map_ oneKey oneKey).coll.length = 2 := by
+  rfl
+
+#check scopeEmpty
+#check badFinal
+#print axioms badFinal
+#reduce (Proof._Map_ oneKey oneKey).coll.length
+
+end VacuityAudit
