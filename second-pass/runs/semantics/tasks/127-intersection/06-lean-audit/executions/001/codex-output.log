+printf 'EXIT_CODE=%s\n' "$?"
+printf '\n[explicit argv0 lean]\n'
+bash -c "exec -a lean $pinned_lean_root/bin/lean --version" 2>&1
+printf 'EXIT_CODE=%s\n' "$?"
+printf '\n[environment libraries]\n'
+env | sort | rg 'LD_|LEAN|LAKE|ELAN'
