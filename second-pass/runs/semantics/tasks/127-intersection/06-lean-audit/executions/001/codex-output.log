/bin/bash -lc "echo '"'$ LD_PRELOAD=/tmp/audit-work/proc_exe_compat.so lake env lean VacuityAudit.lean'"' | tee /audit-output/evidence/39_vacuity_and_counterfactual_lean_test.txt
LD_PRELOAD=/tmp/audit-work/proc_exe_compat.so lake env lean VacuityAudit.lean 2>&1 | tee -a /audit-output/evidence/39_vacuity_and_counterfactual_lean_test.txt
result="'${PIPESTATUS[0]}
