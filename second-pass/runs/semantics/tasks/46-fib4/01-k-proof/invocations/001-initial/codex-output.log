index 0000000000000000000000000000000000000000..e28b346d8b4e16ca59aea968e4fc891574ebf21e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,45 @@
+requires "verification.k"
+
+module FIB4-SPEC
+  imports FIB4-VERIFICATION
+
+  // Loop invariant/summary.  This is a circular reachability claim, not a
+  // semantic rule: kprove checks the zero-iteration branch and one arbitrary
+  // transition before it may reuse the claim.
+  claim
+    <k>
+      #while(
+        Compare(Name("i"), CmpOp("<=", Name("n"))),
+        Assign(
+          Name("next_value"),
+          BinOp(
+            "+",
+            BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
+            Name("d")))
+        Assign(Name("a"), Name("b"))
+        Assign(Name("b"), Name("c"))
+        Assign(Name("c"), Name("d"))
+        Assign(Name("d"), Name("next_value"))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+      ~> Return(Name("d"))
+      ~> #endcall
+      => Return(Name("d"))
+      ~> #endcall
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        ( "n"          |-> N:Int
+          "i"          |-> (I:Int => N +Int 1)
+          "a"          |-> (fib4Spec(I -Int 4) => fib4Spec(N -Int 3))
+          "b"          |-> (fib4Spec(I -Int 3) => fib4Spec(N -Int 2))
+          "c"          |-> (fib4Spec(I -Int 2) => fib4Spec(N -Int 1))
+          "d"          |-> (fib4Spec(I -Int 1) => fib4Spec(N))
+          "next_value" |-> (E:Int => fib4Last(E, N, I))
+          REST:Map ),
+        P:Parent)
+      ...
+    </scopes>
+    requires I >=Int 4 andBool I <=Int N +Int 1
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0592f3fd56c6f9f7da66918c22cbfd874659ebd7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,31 @@
+requires "reference-semantics/semantics.k"
+
+module FIB4-VERIFICATION
+  imports MPY
+
+  // Mathematical sequence used by the invariant.  fib4Spec is deliberately
+  // opaque beyond the finite initial values: the recurrence is supplied as
+  // the simplification equation below, in the direction needed by induction.
+  syntax Int ::= fib4Spec(Int) [function]
+  rule fib4Spec(0) => 0
+  rule fib4Spec(1) => 0
+  rule fib4Spec(2) => 2
+  rule fib4Spec(3) => 0
+  rule fib4Spec(4) => 2
+
+  rule ((fib4Spec(I -Int 4) +Int fib4Spec(I -Int 3))
+          +Int fib4Spec(I -Int 2))
+          +Int fib4Spec(I -Int 1)
+    => fib4Spec(I)
+    requires I >=Int 4
+    [simplification(20)]
+
+  // The loop temporary is unchanged for zero iterations, and otherwise holds
+  // the final sequence value.  This definition has no recursive branch.
+  syntax Int ::= fib4Last(Int, Int, Int) [function]
+  rule fib4Last(E:Int, N:Int, I:Int) => E
+    requires I >Int N
+  rule fib4Last(_:Int, N:Int, I:Int) => fib4Spec(N)
+    requires I <=Int N
+
+endmodule

