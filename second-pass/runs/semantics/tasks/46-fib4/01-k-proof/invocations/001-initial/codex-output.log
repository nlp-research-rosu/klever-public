new file mode 100644
index 0000000000000000000000000000000000000000..ffaeba58b8bfa5086b8423cf4dc5edbd80e1d41c
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,24 @@
+def fib4(n: int):
+    if n == 0:
+        return 0
+    if n == 1:
+        return 0
+    if n == 2:
+        return 2
+    if n == 3:
+        return 0
+
+    a = 0
+    b = 0
+    c = 2
+    d = 0
+    next_value = 0
+    i = 4
+    while i <= n:
+        next_value = a + b + c + d
+        a = b
+        b = c
+        c = d
+        d = next_value
+        i = i + 1
+    return d
