+            Name("d")))
+        Assign(Name("a"), Name("b"))
+        Assign(Name("b"), Name("c"))
+        Assign(Name("c"), Name("d"))
+        Assign(Name("d"), Name("next_value"))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+      ~> Return(Name("d"))
+      ~> #endcall
+      => Return(Name("d"))
+      ~> #endcall
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        ( "n"          |-> N:Int
+          "i"          |-> (I:Int => N +Int 1)
+          "a"          |-> (A:Int => fib4IterA(A, B, C, D, E, N -Int I +Int 1))
+          "b"          |-> (B:Int => fib4IterB(A, B, C, D, E, N -Int I +Int 1))
+          "c"          |-> (C:Int => fib4IterC(A, B, C, D, E, N -Int I +Int 1))
+          "d"          |-> (D:Int => fib4IterD(A, B, C, D, E, N -Int I +Int 1))
+          "next_value" |-> (E:Int => fib4IterE(A, B, C, D, E, N -Int I +Int 1))
+          REST:Map ),
+        P:Parent)
+      ...
+    </scopes>
+    requires I >=Int 4 andBool I <=Int N +Int 1
+endmodule
