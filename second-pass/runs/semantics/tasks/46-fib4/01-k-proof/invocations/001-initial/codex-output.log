--- /dev/null
+++ b/solution.py
@@ -0,0 +1,24 @@
+def fib4(n: int):
+    if n == 0:
+        return 0
+    if n == 1:
+        return 0
+    if n == 2:
+        return 2
+    if n == 3:
+        return 0
+
+    a = 0
+    b = 0
+    c = 2
+    d = 0
+    next_value = 0
+    i = 4
+    while i <= n:
+        next_value = a + b + c + d
+        a = b
+        b = c
+        c = d
+        d = next_value
+        i = i + 1
+    return d
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..dff09f145eaa31ee236cd691eec10b86b438ff47
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,45 @@
+requires "verification.k"
+
+module FIB4-SPEC
+  imports FIB4-VERIFICATION
+
+  // Loop invariant/summary.  This is a circular reachability claim, not a
+  // semantic rule: kprove checks the zero-iteration branch and one arbitrary
+  // transition before it may reuse the claim.
+  claim
+    <k>
+      #while(
+        Compare(Name("i"), CmpOp("<=", Name("n"))),
+        Assign(
+          Name("next_value"),
+          BinOp(
+            "+",
+            BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
+            Name("d")))
+        Assign(Name("a"), Name("b"))
+        Assign(Name("b"), Name("c"))
+        Assign(Name("c"), Name("d"))
+        Assign(Name("d"), Name("next_value"))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+      ~> Return(Name("d"))
+      ~> #endcall
+      => Return(Name("d"))
+      ~> #endcall
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        ( "n"          |-> N:Int
+          "i"          |-> (I:Int => N +Int 1)
+          "a"          |-> (A:Int => fib4IterA(A, B, C, D, E, N -Int I +Int 1))
+          "b"          |-> (B:Int => fib4IterB(A, B, C, D, E, N -Int I +Int 1))
+          "c"          |-> (C:Int => fib4IterC(A, B, C, D, E, N -Int I +Int 1))
+          "d"          |-> (D:Int => fib4IterD(A, B, C, D, E, N -Int I +Int 1))
+          "next_value" |-> (E:Int => fib4IterE(A, B, C, D, E, N -Int I +Int 1))
+          REST:Map ),
+        P:Parent)
+      ...
+    </scopes>
+    requires I >=Int 4 andBool I <=Int N +Int 1
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c3894f86e0353115f5c020aa4dd1e3b102280fbe
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,31 @@
+requires "reference-semantics/semantics.k"
+
+module FIB4-VERIFICATION
+  imports MPY
+
+  // Mathematical sequence used by the invariant.  fib4Spec is deliberately
+  // opaque beyond the finite initial values: the recurrence is supplied as
+  // the simplification equation below, in the direction needed by induction.
+  syntax Int ::= fib4Spec(Int)
+  rule fib4Spec(0) => 0
+  rule fib4Spec(1) => 0
+  rule fib4Spec(2) => 2
+  rule fib4Spec(3) => 0
+  rule fib4Spec(4) => 2
+
+  rule ((fib4Spec(I -Int 4) +Int fib4Spec(I -Int 3))
+          +Int fib4Spec(I -Int 2))
+          +Int fib4Spec(I -Int 1)
+    => fib4Spec(I)
+    requires I >=Int 4
+    [anywhere, priority(20)]
+
+  // The loop temporary is unchanged for zero iterations, and otherwise holds
+  // the final sequence value.  This definition has no recursive branch.
+  syntax Int ::= fib4Last(Int, Int, Int) [function]
+  rule fib4Last(E:Int, N:Int, I:Int) => E
+    requires I >Int N
+  rule fib4Last(_:Int, N:Int, I:Int) => fib4Spec(N)
+    requires I <=Int N
+
+endmodule

