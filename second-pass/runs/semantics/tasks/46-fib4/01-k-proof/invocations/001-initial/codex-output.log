+requires "reference-semantics/semantics.k"
+
+module FIB4-VERIFICATION
+  imports MPY
+
+  // The five projections of T applications of the loop transition
+  //   (A, B, C, D, E) |-> (B, C, D, A+B+C+D, A+B+C+D).
+  // E tracks the program's next_value temporary; the first four projections
+  // are the rolling Fib4 state.
+  syntax Int ::= fib4IterA(Int, Int, Int, Int, Int, Int) [function]
+               | fib4IterB(Int, Int, Int, Int, Int, Int) [function]
+               | fib4IterC(Int, Int, Int, Int, Int, Int) [function]
+               | fib4IterD(Int, Int, Int, Int, Int, Int) [function]
+               | fib4IterE(Int, Int, Int, Int, Int, Int) [function]
+
+  rule fib4IterA(A:Int, _:Int, _:Int, _:Int, _:Int, T:Int) => A
+    requires T <=Int 0
+  rule fib4IterB(_:Int, B:Int, _:Int, _:Int, _:Int, T:Int) => B
+    requires T <=Int 0
+  rule fib4IterC(_:Int, _:Int, C:Int, _:Int, _:Int, T:Int) => C
+    requires T <=Int 0
+  rule fib4IterD(_:Int, _:Int, _:Int, D:Int, _:Int, T:Int) => D
+    requires T <=Int 0
+  rule fib4IterE(_:Int, _:Int, _:Int, _:Int, E:Int, T:Int) => E
+    requires T <=Int 0
+
+  rule fib4IterA(A:Int, B:Int, C:Int, D:Int, _:Int, T:Int)
+    => fib4IterA(B, C, D, A +Int B +Int C +Int D,
+                 A +Int B +Int C +Int D, T -Int 1)
+    requires T >Int 0
+  rule fib4IterB(A:Int, B:Int, C:Int, D:Int, _:Int, T:Int)
+    => fib4IterB(B, C, D, A +Int B +Int C +Int D,
+                 A +Int B +Int C +Int D, T -Int 1)
+    requires T >Int 0
+  rule fib4IterC(A:Int, B:Int, C:Int, D:Int, _:Int, T:Int)
+    => fib4IterC(B, C, D, A +Int B +Int C +Int D,
+                 A +Int B +Int C +Int D, T -Int 1)
+    requires T >Int 0
+  rule fib4IterD(A:Int, B:Int, C:Int, D:Int, _:Int, T:Int)
+    => fib4IterD(B, C, D, A +Int B +Int C +Int D,
+                 A +Int B +Int C +Int D, T -Int 1)
+    requires T >Int 0
+  rule fib4IterE(A:Int, B:Int, C:Int, D:Int, _:Int, T:Int)
+    => fib4IterE(B, C, D, A +Int B +Int C +Int D,
+                 A +Int B +Int C +Int D, T -Int 1)
+    requires T >Int 0
+
+  // Independent executable specification of the sequence.  For N >= 4,
+  // N-3 applications advance the initial values through fib4(N).
+  syntax Int ::= fib4Spec(Int) [function]
+  rule fib4Spec(0) => 0
+  rule fib4Spec(1) => 0
+  rule fib4Spec(2) => 2
+  rule fib4Spec(3) => 0
+  rule fib4Spec(N:Int) => fib4IterD(0, 0, 2, 0, 0, N -Int 3)
+    requires N >=Int 4
+
+endmodule

