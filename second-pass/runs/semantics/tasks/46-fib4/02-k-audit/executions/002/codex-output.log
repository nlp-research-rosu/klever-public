+  --claims FIB4-SPEC.loop-step \
+  --output pretty
+
+run timeout 900 kprove spec.k \
+  --definition reviewer-verification-kompiled \
+  --spec-module FIB4-SPEC \
+  --claims FIB4-SPEC.operational-cases \
+  --output pretty
