+
+run find /generation-evidence/codex-trace -type f -printf '%P %s bytes\n'
+run wc -l /generation-evidence/codex-trace/2026/07/22/rollout-2026-07-22T23-54-55-019f8d53-a024-7c12-a582-699955cf5142.jsonl
