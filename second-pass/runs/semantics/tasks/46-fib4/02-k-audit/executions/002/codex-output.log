    67	       [priority(40)]
    68	
    69	  rule <k> #applyK(toCall(closureVal(PNS:ParamNames, BODY:Stmts, DEFL:Int)), ACC:Vals) ~> CONT
    70	        => #bindP(PNS, ACC) ~> BODY ~> #endcall </k>
    71	       <env>     CALLERL:Int => NEWL </env>
    72	       <scopes>   STORE:Map => STORE [ NEWL <- scope(.Map, parent(DEFL)) ] </scopes>
    73	       <scopeLoc> NEWL:Int => NEWL +Int 1 </scopeLoc>
    74	       <stack>   .List => ListItem(frame(CONT, CALLERL, NEWL)) ... </stack>
    75	
    76	  // annotated closure: the frame starts with the captured freevar cells, its
    77	  // parent is the module scope (all enclosing-local reads go through cells),
    78	  // and the cellvars' fresh cells allocate before params bind (a cellvar param
    79	  // then writes through its cell in #bindP).
    80	  rule <k> #applyK(toCall(closureValC(PNS:ParamNames, CVS:ParamNames, BODY:Stmts, CM:Map)), ACC:Vals) ~> CONT
    81	        => #allocCells(CVS) ~> #bindP(PNS, ACC) ~> BODY ~> #endcall </k>
    82	       <env>     CALLERL:Int => NEWL </env>
    83	       <scopes>   STORE:Map => STORE [ NEWL <- scope(CM [ "$cells" <- cellsMark(CVS) ], parent(0)) ] </scopes>
    84	       <scopeLoc> NEWL:Int => NEWL +Int 1 </scopeLoc>
    85	       <stack>   .List => ListItem(frame(CONT, CALLERL, NEWL)) ... </stack>
    86	
    87	  syntax KItem ::= #allocCells(ParamNames)
    88	  rule <k> #allocCells(.ParamNames) => .K ... </k>
    89	  rule <k> #allocCells((CV:String, R:ParamNames)) => #allocCells(R) ... </k>
    90	       <env> L:Int </env>
    91	       <scopes> ... L |-> scope(M:Map => M [ CV <- cellRef(N) ], _) ... </scopes>
    92	       <heap>    H:Map => (N |-> cellV(noneV)) H </heap>
    93	       <heapLoc> N:Int => N +Int 1 </heapLoc>
    94	       requires notBool N in_keys(H)
    95	endmodule
     1	// reference/src/semantics/operators.k — MPY-OPERATORS
     2	// The operator DISPATCH layer: operands evaluate by strictness (heat/cool over KResult=Val),
     3	// the cooled node hands to applyUn/applyBin/applyCmp (declared in core.k; each domain file
     4	// owns its cases — bool.k, int.k, float.k, str.k, list.k, tuple.k, set.k, dict.k).
     5	
     6	module MPY-OPERATORS
     7	  imports MPY-CORE
     8	  imports MPY-ITER
     9	
    10	  rule <k> UnaryOp(OP:String, V:Val) => applyUn(OP, V) ... </k>
    11	
    12	  rule <k> BinOp(OP:String, L:Val, R:Val) => applyBin(OP, L, R) ... </k>
    13	
    14	  // Compare's right operand sits under the CmpOp wrapper — contexts instead of attributes
    15	  context Compare(HOLE, _)
    16	  context Compare(_:Val, CmpOp(_, HOLE))
    17	  rule <k> Compare(LV:Val, CmpOp(OP:String, RV:Val)) => applyCmp(OP, LV, RV) ... </k> [owise]
    18	
    19	  rule applyCmp("is",     V:Val, noneV) => V ==K noneV
    20	  rule applyCmp("is not", V:Val, noneV) => notBool (V ==K noneV)
    21	
    22	  // ==== operand deref: heap objects combine/compare by STRUCTURE ============
    23	  // (Python: list == is structural; identity only via `is`.) priority(40)
    24	  // preempts the generic dispatch so applyUn/applyBin/applyCmp never see a ref.
    25	  rule <k> BinOp(OP:String, ref(H:Int), R:Expr) => BinOp(OP, V, R) ... </k>
    26	       <heap> ... H |-> V:Val ... </heap>
    27	       [priority(40)]
    28	  rule <k> BinOp(OP:String, L:Val, ref(H:Int)) => BinOp(OP, L, V) ... </k>
    29	       <heap> ... H |-> V:Val ... </heap>
    30	       requires notBool isRefV(L)
    31	       [priority(40)]
    32	
    33	  // the left operand of `in`/`not in` is an ELEMENT (compares by ==K) — never deref'd
    34	  rule <k> Compare(ref(H:Int), CmpOp(OP:String, R:Expr)) => Compare(V, CmpOp(OP, R)) ... </k>
    35	       <heap> ... H |-> V:Val ... </heap>
    36	       requires OP =/=String "in" andBool OP =/=String "not in"
    37	       [priority(40)]
    38	  rule <k> Compare(L:Val, CmpOp(OP:String, ref(H:Int))) => Compare(L, CmpOp(OP, V)) ... </k>
    39	       <heap> ... H |-> V:Val ... </heap>
    40	       requires notBool isRefV(L)
    41	        orBool OP ==String "in" orBool OP ==String "not in"
    42	       [priority(40)]
    43	
    44	  rule <k> UnaryOp(OP:String, ref(H:Int)) => UnaryOp(OP, V) ... </k>
    45	       <heap> ... H |-> V:Val ... </heap>
    46	       [priority(40)]
    47	endmodule
     1	// reference/src/semantics/int.k — MPY-INT
     2	// Int cases of the operator dispatch; Python // and % are floored (pyMod).
     3	
     4	module MPY-INT
     5	  imports MPY-CORE
     6	
     7	  rule applyUn("-", I:Int) => 0 -Int I
     8	
     9	  rule applyBin("+",  I1:Int, I2:Int) => I1 +Int I2
    10	  // Bool participates in int arithmetic (x += (a == b))
    11	  rule applyBin("+",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi
    12	  rule applyBin("+",  B:Bool, I:Int) => #if B #then 1 #else 0 #fi +Int I
    13	  rule applyBin("-",  I1:Int, I2:Int) => I1 -Int I2
    14	  rule applyBin("*",  I1:Int, I2:Int) => I1 *Int I2
    15	  rule applyBin("%",  I1:Int, I2:Int) => pyMod(I1, I2)
    16	  rule applyBin("//", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2
    17	  rule applyBin("**", I1:Int, I2:Int) => I1 ^Int I2 requires I2 >=Int 0
    18	
    19	  syntax Int ::= pyMod(Int, Int) [function]
    20	  rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2
    21	
    22	  rule applyCmp("<",  I1:Int, I2:Int)   => I1 <Int  I2
    23	  rule applyCmp("<=", I1:Int, I2:Int)   => I1 <=Int I2
    24	  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int  I2
    25	  rule applyCmp(">=", I1:Int, I2:Int)   => I1 >=Int I2
    26	  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2
    27	  rule applyCmp("!=", I1:Int, I2:Int)   => I1 =/=Int I2
    28	endmodule
     1	// reference/src/semantics/assert.k — MPY-ASSERT
     2	
     3	module MPY-ASSERT
     4	  imports MPY-CORE
     5	
     6	  rule <k> Assert(V:Val) => .K ... </k>
     7	       requires truthy(V)
     8	  rule <k> Assert(V:Val) ~> _ => .K </k>
     9	       <exc> NoExc => AssertionError </exc>
    10	       <exit-code> _ => 1 </exit-code>
    11	       requires notBool truthy(V)
    12	
    13	  rule <k> Assert(ref(H:Int)) => Assert(V) ... </k>
    14	       <heap> ... H |-> V:Val ... </heap>
    15	       [priority(40)]
    16	endmodule
     1	// reference/src/semantics/syntax.k — MPY-SYNTAX
     2	
     3	module MPY-SYNTAX
     4	  imports INT-SYNTAX
     5	  imports FLOAT-SYNTAX
     6	  imports BOOL-SYNTAX
     7	  imports STRING-SYNTAX
     8	
     9	  syntax Expr ::= "Int"      "(" Int ")"
    10	                | "Float"    "(" Float ")"
    11	                | "Bool"     "(" Bool ")"
    12	                | "Name"     "(" String ")"
    13	                | "Str"      "(" String ")"
    14	                | "UnaryOp"  "(" String "," Expr ")" [strict(2)]
    15	                | "BinOp"    "(" String "," Expr "," Expr ")" [seqstrict(2, 3)]
    16	                | "BoolOp"    "(" String "," Exprs ")"
    17	                | "ListExpr"  "(" Exprs ")"
    18	                | "DictExpr"  "(" Entries ")"
    19	                | "ListComp"  "(" Expr "," CompFors ")" [macro]
    20	                | "GenExp"    "(" Expr "," CompFors ")" [macro]
    21	                | "TupleExpr" "(" Exprs ")"
    22	                | "Subscript" "(" Expr "," Index ")"
    23	                | "IfExp"     "(" Expr "," Expr "," Expr ")" [strict(1)]
    24	                | "Lambda"    "(" Params "," Expr ")"
    25	                | "KwArg"     "(" String "," Expr ")"
    26	                | "Lambda"    "(" Params "," CellVars "," FreeVars "," Expr ")"
    27	                | "NoneVal"
    28	                | "Call"      "(" Expr "," Exprs ")"
    29	                | "Attribute" "(" Expr "," String ")" [strict(1)]
    30	                | "Compare"   "(" Expr "," CmpOp ")"
    31	
    32	  syntax CmpOp    ::= "CmpOp" "(" String "," Expr ")"
    33	  syntax Entry    ::= "Entry" "(" Expr "," Expr ")"
    34	  syntax Entries  ::= List{Entry, ","}
    35	  syntax CompFor  ::= "CompFor" "(" Expr "," Expr "," Exprs ")"
    36	  syntax CompFors ::= List{CompFor, ""}
    37	  syntax Exprs    ::= List{Expr, ","}
    38	  syntax Index    ::= Expr | "Slice" "(" Bound "," Bound "," Bound ")"
    39	  syntax Bound    ::= Expr | "NoBound"
    40	
    41	  syntax Stmt ::= "Assign"    "(" Expr "," Expr ")" [strict(2)]
    42	                | "Import"    "(" String ")"
    43	                | "ImportFrom" "(" String "," ParamNames ")"
    44	                | "AugAssign" "(" Expr "," String "," Expr ")" [strict(3)]
    45	                | "For"       "(" Expr "," Expr "," Stmts ")" [strict(2)]
    46	                | "While"     "(" Expr "," Stmts ")"
    47	                | "Break"
    48	                | "Continue"
    49	                | "If"        "(" Expr "," Stmts "," Stmts ")" [strict(1)]
    50	                | "Return"    "(" Expr ")" [strict]
    51	                | "Assert"    "(" Expr ")" [strict]
    52	                | "Expr"      "(" Expr ")" [strict]
    53	                | "FuncDef"   "(" String "," Params "," Stmts ")"
    54	                | "FuncDef"   "(" String "," Params "," CellVars "," FreeVars "," Stmts ")"
    55	
    56	  syntax Stmts      ::= List{Stmt, ""}
    57	  syntax Params     ::= "Params" "(" ParamNames ")"
    58	  syntax CellVars   ::= "CellVars" "(" ParamNames ")"
    59	  syntax FreeVars   ::= "FreeVars" "(" ParamNames ")"
    60	  syntax ParamNames ::= List{String, ","}
    61	  syntax Module     ::= "Module" "(" Stmts ")"
    62	endmodule
     1	// reference/src/semantics.k — the supplied `.mpy` semantics, ASSEMBLED.
     2	//
     3	//   kompile reference-semantics/semantics.k --backend llvm \
     4	//     --main-module MPY-KRUN --syntax-module MPY-SYNTAX \
     5	//     --output-definition runtime-kompiled
     6	//
     7	// Concrete-only legs are included through MPY-KRUN. Proof definitions import
     8	// MPY and any explicit proof extensions supplied by the task author.
     9	//
    10	// Files (dependency order — everything imports MPY-CORE):
    11	//   semantics/syntax.k         MPY-SYNTAX       AST productions
    12	//   semantics/core.k           MPY-CORE         values, config, load, lookup, shared helpers   [required]
    13	//   semantics/iter.k           MPY-ITER         the iterator protocol (#iterNext/#iterYield/#iterDone) decl
    14	//   semantics/range.k          MPY-RANGE        rangeObj: inRange / rangeLen / its #iterNext
    15	//   semantics/operators.k      MPY-OPERATORS    operator DISPATCH (UnaryOp/BinOp/Compare/BoolOp) — domain files own the cases
    16	//   semantics/int.k            MPY-INT          Int operator cases; floored // and % (pyMod)
    17	//   semantics/bool.k           MPY-BOOL         Bool operator cases + truthy not/and/or (BoolOp)
    18	//   semantics/float.k          MPY-FLOAT        Float Val: literal + opaque float ops ([concrete] for krun)
    19	//   semantics/str.k            MPY-STR          str(IntSeq): literal, +, ==, in
    20	//   semantics/set.k            MPY-SET          set(str): distinct char codes (len / membership)
    21	//   semantics/list.k           MPY-LIST         ListExpr, list(ValSeq): +, ==, in
    22	//   semantics/tuple.k          MPY-TUPLE        TupleExpr, tuple ==, target-binding + unpacking
    23	//   semantics/subscript.k      MPY-SUBSCRIPT    Subscript indexing + Slice
    24	//   semantics/comprehension.k  MPY-COMPREHENSION  list comprehensions [ELT for T in ITER if COND]
    25	//   semantics/methods.k        MPY-METHODS      pure str methods: is*/lower/upper/swapcase/startswith
    26	//   semantics/controls.k       MPY-CONTROLS     Assign/AugAssign, If, IfExp, For, While, break/continue
    27	//   semantics/functions.k      MPY-FUNCTIONS    def / call / return (frame stack)
    28	//   semantics/builtins.k       MPY-BUILTINS     builtins as calls: len/sum/abs/min/max/ord/chr/str
    29	//   semantics/call.k           MPY-CALL         ALL Call routing + argument evaluation
    30	//   semantics/sort.k           MPY-SORT         trusted sorted(): opaque sortVS + concrete insertion sort
    31	//   semantics/assert.k         MPY-ASSERT       Assert oracle (smoke programs only)
    32	//   semantics/dict.k           MPY-DICT         order-preserving dictV(KS,VS) + .keys() + list()
    33	
    34	requires "semantics/syntax.k"
    35	requires "semantics/core.k"
    36	requires "semantics/iter.k"
    37	requires "semantics/range.k"
    38	requires "semantics/operators.k"
    39	requires "semantics/int.k"
    40	requires "semantics/bool.k"
    41	requires "semantics/float.k"
    42	requires "semantics/str.k"
    43	requires "semantics/set.k"
    44	requires "semantics/list.k"
    45	requires "semantics/tuple.k"
    46	requires "semantics/subscript.k"
    47	requires "semantics/comprehension.k"
    48	requires "semantics/methods.k"
    49	requires "semantics/controls.k"
    50	requires "semantics/functions.k"
    51	requires "semantics/builtins.k"
    52	requires "semantics/call.k"
    53	requires "semantics/sort.k"
    54	requires "semantics/assert.k"
    55	requires "semantics/dict.k"
    56	requires "semantics/concrete.k"
    57	
    58	module MPY
    59	  imports MPY-CORE
    60	  imports MPY-ITER
    61	  imports MPY-RANGE
    62	  imports MPY-OPERATORS
    63	  imports MPY-INT
    64	  imports MPY-BOOL
    65	  imports MPY-FLOAT
    66	  imports MPY-STR
    67	  imports MPY-SET
    68	  imports MPY-LIST
    69	  imports MPY-TUPLE
    70	  imports MPY-SUBSCRIPT
    71	  imports MPY-COMPREHENSION
    72	  imports MPY-METHODS
    73	  imports MPY-CONTROLS
    74	  imports MPY-FUNCTIONS
    75	  imports MPY-BUILTINS
    76	  imports MPY-CALL
    77	  imports MPY-SORT
    78	  imports MPY-ASSERT
    79	  imports MPY-DICT
    80	endmodule
    81	
    82	// The krun (llvm) main module: MPY plus the concrete-only legs (keyed sort's
    83	// real key calls, deep list equality). Verification builds import MPY and
    84	// never see MPY-CONCRETE. The llvm kompile MUST use --main-module MPY-KRUN —
    85	// with plain MPY the concrete legs are silently absent (this was live for a
    86	// while: sorted-key stuck and comprehension asserted wrong under krun).
    87	module MPY-KRUN
    88	  imports MPY
    89	  imports MPY-CONCRETE
    90	endmodule

diff --git a/evidence/differential_fib4.py b/evidence/differential_fib4.py
new file mode 100644
index 0000000000000000000000000000000000000000..4bff95305ee1ed458116e2952168922646cc0cd9
--- /dev/null
+++ b/evidence/differential_fib4.py
@@ -0,0 +1,66 @@
+#!/usr/bin/env python3
+"""Independent differential test for HumanEval 46.
+
+The trusted canonical implementation and submitted implementation are imported
+from separate files.  Test inputs are selected here and do not reuse K claims
+or proof equations.
+"""
+
+from importlib.util import module_from_spec, spec_from_file_location
+from pathlib import Path
+import random
+
+
+SCRATCH = Path("/tmp/audit-work/46-fib4-review")
+
+
+def load_function(module_name: str, path: Path):
+    spec = spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.fib4
+
+
+canonical = load_function("trusted_canonical", SCRATCH / "canonical.py")
+candidate = load_function("submitted_solution", SCRATCH / "solution.py")
+
+documented = [5, 6, 7]
+branch_boundaries = [0, 1, 2, 3, 4]
+exhaustive_small = list(range(0, 201))
+rng = random.Random(460046)
+generated = [rng.randint(201, 2000) for _ in range(100)]
+intended_cases = sorted(set(documented + branch_boundaries + exhaustive_small + generated))
+
+mismatches = []
+for n in intended_cases:
+    expected = canonical(n)
+    actual = candidate(n)
+    if actual != expected:
+        mismatches.append((n, expected, actual))
+
+print("contract_domain=nonnegative integers (n-th sequence element)")
+print("empty_case=not applicable to an integer argument")
+print(f"documented_examples={documented}")
+print(f"branch_boundaries={branch_boundaries}")
+print("generated_seed=460046")
+print(f"generated_draws={len(generated)} range=[201,2000]")
+print(f"unique_intended_cases={len(intended_cases)}")
+print(f"mismatch_count={len(mismatches)}")
+print(f"mismatches={mismatches}")
+for n in [0, 1, 2, 3, 4, 5, 6, 7, 12, 50, 200, 1000, 2000]:
+    value = candidate(n)
+    print(f"sample n={n} value={value} decimal_digits={len(str(value))}")
+
+print("outside_domain_negative_probe:")
+for n in [-1, -2, -3, -4]:
+    observations = []
+    for name, function in [("canonical", canonical), ("candidate", candidate)]:
+        try:
+            observations.append((name, "value", function(n)))
+        except Exception as error:
+            observations.append((name, "exception", type(error).__name__))
+    print(f"n={n} observations={observations}")
+
+raise SystemExit(1 if mismatches else 0)
diff --git a/evidence/inspect_generation.py b/evidence/inspect_generation.py
new file mode 100644
index 0000000000000000000000000000000000000000..265440862ea0854ff4da605e16f75d9a4c9aed5c
--- /dev/null
+++ b/evidence/inspect_generation.py
@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+import collections
+import hashlib
+import json
+from pathlib import Path
+
+
+def sha256(path: str) -> str:
+    digest = hashlib.sha256()
+    with open(path, "rb") as handle:
+        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+audit = json.loads(Path("/audit-input.json").read_text())
+lock = json.loads(Path("/audit-campaign-lock.json").read_text())
+print(f"record_layout={audit['record_layout']}")
+print(f"semantics_mode={audit['semantics_mode']}")
+print(f"campaign_block_equal={audit['audit_campaign'] == lock}")
+
+hashes = audit["hashes"]
+mounted = {
+    "audit_campaign_lock_sha256": "/audit-campaign-lock.json",
+    "canonical_sha256": "/reference/canonical.py",
+    "trusted_prompt_sha256": "/reference/prompt.py",
+    "trusted_translator_sha256": "/reference/py2mpy.py",
+    "candidate_prompt_sha256": "/candidate/prompt.py",
+    "candidate_translator_sha256": "/candidate/py2mpy.py",
+    "run_manifest_sha256": "/run.json",
+    "task_manifest_sha256": "/task.json",
+    "stage1_result_sha256": "/generation-result.json",
+    "stage1_invocation_sha256": "/generation-evidence/invocation.json",
+    "generation_metrics_sha256": "/generation-evidence/metrics.json",
+    "generation_codex_last_sha256": "/generation-evidence/codex-last.txt",
+    "generation_codex_output_sha256": "/generation-evidence/codex-output.log",
+    "generation_prompt_sha256": "/generation-evidence/prompt.txt",
+    "generation_usage_sha256": "/generation-evidence/usage.json",
+}
+for key, path in mounted.items():
+    actual = sha256(path)
+    expected = hashes[key]
+    print(f"HASH {key} expected={expected} actual={actual} match={actual == expected}")
+
+invocation = json.loads(Path("/generation-evidence/invocation.json").read_text())
+for relative, expected in invocation["outputs"]["evidence"].items():
+    path = "/generation-evidence/" + relative
+    actual = sha256(path)
+    print(
+        f"INVOCATION_HASH {relative} expected={expected} actual={actual} "
+        f"match={actual == expected}"
+    )
+
+trace_path = Path(
+    "/generation-evidence/codex-trace/2026/07/22/"
+    "rollout-2026-07-22T23-54-55-019f8d53-a024-7c12-a582-699955cf5142.jsonl"
+)
+top_types: collections.Counter[str] = collections.Counter()
+payload_types: collections.Counter[str] = collections.Counter()
+tool_names: collections.Counter[str] = collections.Counter()
+roles: collections.Counter[str] = collections.Counter()
+parse_errors = []
+last_records = collections.deque(maxlen=8)
+with trace_path.open() as handle:
+    for line_number, line in enumerate(handle, 1):
+        try:
+            record = json.loads(line)
+        except Exception as error:
+            parse_errors.append((line_number, str(error)))
+            continue
+        top_types[str(record.get("type", ""))] += 1
+        payload = record.get("payload") or {}
+        payload_types[str(payload.get("type", ""))] += 1
+        name = payload.get("name")
+        if name:
+            tool_names[str(name)] += 1
+        role = payload.get("role")
+        if role:
+            roles[str(role)] += 1
+        last_records.append(
+            (
+                line_number,
+                record.get("type"),
+                payload.get("type"),
+                payload.get("role"),
+                payload.get("name"),
+            )
+        )
+
+print(f"TRACE lines={sum(top_types.values())} parse_errors={parse_errors}")
+print(f"TRACE top_types={dict(top_types)}")
+print(f"TRACE payload_types={dict(payload_types)}")
+print(f"TRACE tool_names={dict(tool_names)}")
+print(f"TRACE roles={dict(roles)}")
+print(f"TRACE last_records={list(last_records)}")
+
+for optional in (
+    "/generation-evidence/legacy-run-input.json",
+    "/generation-evidence/legacy-metrics.json",
+):
+    value = json.loads(Path(optional).read_text())
+    print(f"OPTIONAL_RECORD {optional}={json.dumps(value, sort_keys=True)}")
diff --git a/evidence/stage1-integrity.sh b/evidence/stage1-integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..06d8b8d0433811d5561d7982eeb2ddf4eba90c55
--- /dev/null
+++ b/evidence/stage1-integrity.sh
@@ -0,0 +1,82 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+run() {
+  printf '$'
