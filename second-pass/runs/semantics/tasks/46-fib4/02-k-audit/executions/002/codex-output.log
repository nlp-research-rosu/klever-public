+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+run python3 /audit-output/evidence/inspect_generation.py
+
+required=(
+  /audit-input.json
+  /audit-campaign-lock.json
+  /run.json
+  /task.json
+  /generation-result.json
+  /generation-evidence/invocation.json
