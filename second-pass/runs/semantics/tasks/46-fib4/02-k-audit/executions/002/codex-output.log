/bin/bash -lc 'for f in reference-semantics/semantics/bool.k reference-semantics/semantics/builtins.k reference-semantics/semantics/comprehension.k reference-semantics/semantics/concrete.k reference-semantics/semantics/dict.k reference-semantics/semantics/iter.k reference-semantics/semantics/list.k reference-semantics/semantics/range.k reference-semantics/semantics/set.k; do nl -ba "$f"; done' in /tmp/audit-work/46-fib4-review
