Module(
  FuncDef("vowels_count", Params("s"),
    Assign(Name("s"), Call(Attribute(Name("s"), "lower"), ))
    Assign(Name("count"), Int(0))
    Assign(Name("char"), Str(""))
    Assign(Name("last_y"), Bool(false))
    For(Name("char"), Name("s"),
      If(Compare(Name("char"), CmpOp("in", Str("aeiou"))),
        AugAssign(Name("count"), "+", Int(1)),
        )
      Assign(
        Name("last_y"),
        Compare(Name("char"), CmpOp("in", Str("y")))))
    Return(BinOp("+", Name("count"), Name("last_y")))))
