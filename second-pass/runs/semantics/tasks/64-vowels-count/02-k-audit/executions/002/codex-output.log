diff --git a//tmp/audit-work/proof/spec-ground-witness.k b//tmp/audit-work/proof/spec-ground-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..eeeef10d889f070885c12fcdaa1e30d8886250c9
--- /dev/null
