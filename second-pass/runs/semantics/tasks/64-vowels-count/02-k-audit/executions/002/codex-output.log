/bin/bash -lc '/audit-output/evidence/run-and-log.sh stage4-satisfying-main-k kprove spec-ground-witness.k --definition verification-kompiled --spec-module MAIN-GROUND-WITNESS --output pretty' in /tmp/audit-work/proof
