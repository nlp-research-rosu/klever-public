+        )
+        "count" |-> 2
+        "char" |-> str(.IntSeq)
+        "last_y" |-> false,
+        parent(0)
+      )
+      =>
+      1 |-> scope(
+        "s" |-> str(
+          iCons(65, iCons(67, iCons(69, iCons(68, iCons(89, .IntSeq)))))
+        )
+        "count" |-> 4
+        "char" |-> str(iCons(121, .IntSeq))
+        "last_y" |-> true,
+        parent(0)
+      )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
