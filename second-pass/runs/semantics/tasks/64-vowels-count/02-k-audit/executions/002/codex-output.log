diff --git a//tmp/audit-work/proof/k-unicode-claims-one.py b//tmp/audit-work/proof/k-unicode-claims-one.py
new file mode 100644
index 0000000000000000000000000000000000000000..bad5966e401aa9ead1d725c0f283f580df144909
--- /dev/null
+++ b//tmp/audit-work/proof/k-unicode-claims-one.py
@@ -0,0 +1,13 @@
+def vowels_count(s):
+    s = s.lower()
+    count = 0
+    char = ""
+    last_y = False
+    for char in s:
+        if char in "aeiou":
+            count += 1
+        last_y = char in "y"
+    return count + last_y
+
+
+assert vowels_count("İ") == 1
