Module(
  FuncDef("vowels_count", Params("s"),
    Assign(Name("s"), Call(Attribute(Name("s"), "lower"), ))
    Assign(Name("count"), Int(0))
    Assign(Name("char"), Str(""))
    Assign(Name("last_y"), Bool(false))
    For(Name("char"), Name("s"),
      If(Compare(Name("char"), CmpOp("in", Str("aeiou"))),
        AugAssign(Name("count"), "+", Int(1)),
        )
      Assign(
        Name("last_y"),
        Compare(Name("char"), CmpOp("in", Str("y")))))
    Return(BinOp("+", Name("count"), Name("last_y"))))
  Assign(Name("result_empty"), Call(Name("vowels_count"), Str("")))
  Assign(Name("result_a"), Call(Name("vowels_count"), Str("a")))
  Assign(Name("result_y"), Call(Name("vowels_count"), Str("y")))
  Assign(Name("result_by"), Call(Name("vowels_count"), Str("by")))
  Assign(Name("result_abcde"), Call(Name("vowels_count"), Str("abcde")))
  Assign(Name("result_acedy"), Call(Name("vowels_count"), Str("ACEDY")))
  Assign(
    Name("result_yellowy"),
    Call(Name("vowels_count"), Str("yellowy"))))
