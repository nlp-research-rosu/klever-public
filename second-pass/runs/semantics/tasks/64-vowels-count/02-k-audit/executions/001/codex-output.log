+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return 0
+}
+
+cd /tmp/audit-work/fresh || exit 1
+
+run kast \
+  --definition proof-base-kompiled \
+  --module VOWELS-BASE \
+  --sort Module \
+  --expand-macros \
+  --output kore \
+  --output-file solution.parsed.kore \
+  solution.mpy
+
+run kast \
+  --definition proof-base-kompiled \
+  --module VOWELS-BASE \
