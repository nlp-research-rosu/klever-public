+#!/usr/bin/env bash
+set -u
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+}
+
+run kompile --version
+run kprove --version
+run python3 --version
+run sha256sum \
