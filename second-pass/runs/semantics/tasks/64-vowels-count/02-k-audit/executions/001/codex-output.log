cd /tmp/audit-work/fresh
printf '"'$ kprove bridge-context-witness.k --definition proof-base-kompiled --spec-module BRIDGE-CONTEXT-WITNESS-BASE --output pretty'"\\n' | tee /audit-output/evidence/stage5-bridge-base.log
