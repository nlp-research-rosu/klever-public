+        parent(0)
+      )
+      =>
+      0 |-> scope(
+        "s"      |-> str(iCons(97, .IntSeq))
+        "count"  |-> 0
+        "char"   |-> str(.IntSeq)
+        "last_y" |-> false,
+        parent(-1)
+      )
+      1 |-> scope(
+        "s"      |-> str(iCons(97, .IntSeq))
+        "count"  |-> 1
