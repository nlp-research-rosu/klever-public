+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "s"      |-> str(iCons(97, .IntSeq))
+        "count"  |-> 0
+        "char"   |-> str(.IntSeq)
+        "last_y" |-> false,
+        parent(-1)
+      )
+      1 |-> scope(
+        "s"      |-> str(iCons(97, .IntSeq))
+        "count"  |-> 0
+        "char"   |-> str(.IntSeq)
+        "last_y" |-> false,
+        parent(0)
+      )
+      =>
+      0 |-> scope(
+        "s"      |-> str(iCons(97, .IntSeq))
+        "count"  |-> 0
+        "char"   |-> str(.IntSeq)
+        "last_y" |-> false,
+        parent(-1)
+      )
+      1 |-> scope(
+        "s"      |-> str(iCons(97, .IntSeq))
+        "count"  |-> 1
+        "char"   |-> str(iCons(97, .IntSeq))
+        "last_y" |-> false,
+        parent(0)
+      )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module BRIDGE-CONTEXT-WITNESS-EXTENDED
+  imports VOWELS-VERIFICATION
+
+  claim [env-mismatch-extended]:
+    <k>
+      #loop(
+        str(iCons(97, .IntSeq)),
+        Name("char"),
+        vowelLoopBody
+      )
+      =>
+      .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "s"      |-> str(iCons(97, .IntSeq))
+        "count"  |-> 0
+        "char"   |-> str(.IntSeq)
+        "last_y" |-> false,
+        parent(-1)
+      )
+      1 |-> scope(
+        "s"      |-> str(iCons(97, .IntSeq))
+        "count"  |-> 0
+        "char"   |-> str(.IntSeq)
+        "last_y" |-> false,
+        parent(0)
+      )
+      =>
+      0 |-> scope(
+        "s"      |-> str(iCons(97, .IntSeq))
+        "count"  |-> 0
+        "char"   |-> str(.IntSeq)
+        "last_y" |-> false,
+        parent(-1)
+      )
+      1 |-> scope(
+        "s"      |-> str(iCons(97, .IntSeq))
+        "count"  |-> 1
+        "char"   |-> str(iCons(97, .IntSeq))
+        "last_y" |-> false,
+        parent(0)
+      )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
