kprove bridge-context-witness.k --definition proof-base-kompiled --spec-module BRIDGE-CONTEXT-WITNESS-BASE --output pretty 2>&1 | tee -a /audit-output/evidence/stage5-bridge-base.log
status="'${PIPESTATUS[0]}
printf '"'[exit %d]\\n' \""'$status" | tee -a /audit-output/evidence/stage5-bridge-base.log
printf '"'"'$ kprove bridge-context-witness.k --definition verification-kompiled --spec-module BRIDGE-CONTEXT-WITNESS-EXTENDED --output pretty'"\\n' | tee /audit-output/evidence/stage5-bridge-extended.log
