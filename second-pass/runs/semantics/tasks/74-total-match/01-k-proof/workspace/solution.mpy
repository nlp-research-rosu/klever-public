Module(
  FuncDef("total_match", Params("lst1", "lst2"),
    Assign(Name("total1"), Int(0))
    Assign(Name("total2"), Int(0))
    For(Name("item"), Name("lst1"),
      AugAssign(Name("total1"), "+", Call(Name("len"), Name("item"))))
    For(Name("item"), Name("lst2"),
      AugAssign(Name("total2"), "+", Call(Name("len"), Name("item"))))
    If(Compare(Name("total1"), CmpOp("<=", Name("total2"))),
      Return(Name("lst1")),
      )
    Return(Name("lst2"))))
