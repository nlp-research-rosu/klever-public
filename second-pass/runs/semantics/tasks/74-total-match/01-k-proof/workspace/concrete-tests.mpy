Module(
  FuncDef("total_match", Params("lst1", "lst2"),
    Assign(Name("total1"), Int(0))
    Assign(Name("total2"), Int(0))
    For(Name("item"), Name("lst1"),
      AugAssign(Name("total1"), "+", Call(Name("len"), Name("item"))))
    For(Name("item"), Name("lst2"),
      AugAssign(Name("total2"), "+", Call(Name("len"), Name("item"))))
    If(Compare(Name("total1"), CmpOp("<=", Name("total2"))),
      Return(Name("lst1")),
      )
    Return(Name("lst2")))
  Assert(
    Compare(
      Call(Name("total_match"), ListExpr(), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("total_match"),
        ListExpr(Str("hi"), Str("admin")),
        ListExpr(Str("hI"), Str("Hi"))),
      CmpOp("==", ListExpr(Str("hI"), Str("Hi")))))
  Assert(
    Compare(
      Call(
        Name("total_match"),
        ListExpr(Str("hi"), Str("admin")),
        ListExpr(Str("hi"), Str("hi"), Str("admin"), Str("project"))),
      CmpOp("==", ListExpr(Str("hi"), Str("admin")))))
  Assert(
    Compare(
      Call(
        Name("total_match"),
        ListExpr(Str("hi"), Str("admin")),
        ListExpr(Str("hI"), Str("hi"), Str("hi"))),
      CmpOp("==", ListExpr(Str("hI"), Str("hi"), Str("hi")))))
  Assert(
    Compare(
      Call(
        Name("total_match"),
        ListExpr(Str("4")),
        ListExpr(Str("1"), Str("2"), Str("3"), Str("4"), Str("5"))),
      CmpOp("==", ListExpr(Str("4"))))))
