index 0000000000000000000000000000000000000000..d1434f8a026c2e336101e6713d87db4ec4d29c0e
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,22 @@
+def total_match(lst1, lst2):
+    total1 = 0
+    total2 = 0
+
+    for item in lst1:
+        total1 += len(item)
+
+    for item in lst2:
+        total2 += len(item)
+
+    if total1 <= total2:
+        return lst1
+    return lst2
+
+
+assert total_match([], []) == []
+assert total_match(["hi", "admin"], ["hI", "Hi"]) == ["hI", "Hi"]
+assert total_match(
+    ["hi", "admin"], ["hi", "hi", "admin", "project"]
+) == ["hi", "admin"]
+assert total_match(["hi", "admin"], ["hI", "hi", "hi"]) == ["hI", "hi", "hi"]
+assert total_match(["4"], ["1", "2", "3", "4", "5"]) == ["4"]
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..56b952b29aaf31ab634f00e98d3d005df8ea82fd
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,31 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Translate the submitted implementation.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Concrete execution of all five examples from prompt.py.
+python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun concrete-tests.mpy \
+  --definition runtime-kompiled \
+  --output none
+
+# Symbolic definition: MPY excludes the concrete-only execution extensions.
+kompile verification.k \
+  --backend haskell \
+  --main-module TOTAL-MATCH-VERIFICATION \
+  --syntax-module TOTAL-MATCH-VERIFICATION \
+  --output-definition verification-kompiled
+
+# Prove the recursive loop invariant, then both end-to-end result claims.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module TOTAL-MATCH-LOOP-SPEC
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module TOTAL-MATCH-SPEC
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..c2366c392ce83cb33174a01104564ec958b620b1
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def total_match(lst1, lst2):
+    total1 = 0
+    total2 = 0
+
+    for item in lst1:
+        total1 += len(item)
+
+    for item in lst2:
+        total2 += len(item)
+
+    if total1 <= total2:
+        return lst1
+    return lst2
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b7852626f8684e383118433ddbe379b0eb90d9f0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,75 @@
+requires "verification.k"
+
+module TOTAL-MATCH-LOOP-SPEC
+  imports TOTAL-MATCH-VERIFICATION
+
+  // Independent induction proof for the summary used by the program claims.
+  // The arbitrary OLD value generalizes the loop-variable binding between
+  // iterations.  The proof-only observer reads the accumulator and removes
+  // that unobservable binding at the end.
+  claim
+    <k>
+      #loop(
+        list(strVals(ITEMS:StrSeq)),
+        Name("item"),
+        AugAssign(
+          Name("acc"),
+          "+",
+          Call(Name("len"), Name("item"))) .Stmts)
+      ~> readAccAndDrop("acc", "item")
+      => I +Int totalChars(ITEMS)
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+      1  |-> scope(
+        (("acc" |-> I:Int) ("item" |-> OLD:Val)
+          => "acc" |-> (I +Int totalChars(ITEMS))),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
+
+module TOTAL-MATCH-SPEC
+  imports TOTAL-MATCH-VERIFICATION
+
+  claim
+    <k> runTotalMatch(A:StrSeq, B:StrSeq)
+      => list(strVals(A))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires totalChars(A) <=Int totalChars(B)
+
+  claim
+    <k> runTotalMatch(A:StrSeq, B:StrSeq)
+      => list(strVals(B))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires totalChars(A) >Int totalChars(B)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..3150ea50deede450347cf05a050ca8bd4bd7b942
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,139 @@
+requires "reference-semantics/semantics.k"
+
+module TOTAL-MATCH-VERIFICATION
+  imports MPY
+
+  // A proof-domain sequence whose elements are strings.  Keeping this sort
+  // separate from ValSeq records the HumanEval input precondition in the
+  // symbolic term itself.
+  syntax StrSeq ::= ".StrSeq"
+                  | ssCons(IntSeq, StrSeq)
+
+  syntax ValSeq ::= strVals(StrSeq)
+  rule strVals(.StrSeq) => .ValSeq
+  rule strVals(ssCons(S:IntSeq, REST:StrSeq))
+    => vCons(str(S), strVals(REST))
+
+  syntax Int ::= totalChars(StrSeq) [function, total]
+  rule totalChars(.StrSeq) => 0
+  rule totalChars(ssCons(S:IntSeq, REST:StrSeq))
+    => isLen(S) +Int totalChars(REST)
+
+  // Let the reference iterator consume the proof-domain representation one
+  // symbolic string at a time.  This adapter is used by the independent loop
+  // invariant claim in spec.k.
+  syntax KItem ::= nextStrings(StrSeq)
+  rule <k> #iterNext(list(strVals(ITEMS:StrSeq)))
+        => nextStrings(ITEMS)
+        ...
+       </k>
+       [priority(40)]
+  rule <k> nextStrings(.StrSeq)
+        => #iterDone
+        ...
+       </k>
+  rule <k> nextStrings(ssCons(S:IntSeq, REST:StrSeq))
+        => #iterYield(str(S), list(strVals(REST)))
+        ...
+       </k>
+
+  // A proof-only observer used after the real loop: read the accumulator and
+  // discard the loop variable, which is unobservable to total_match.
+  syntax KItem ::= readAccAndDrop(String, String)
+  rule <k> readAccAndDrop(ACC:String, ITEM:String)
+        => I
+        ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           (ACC |-> I:Int) M:Map,
+           _P:Parent)
+         ...
+       </scopes>
+       requires notBool (ACC in_keys(M))
+        andBool ACC =/=String ITEM
+        andBool notBool (ITEM in_keys(M))
+
+  rule <k> readAccAndDrop(ACC:String, ITEM:String)
+        => I
+        ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           ((ACC |-> I:Int) (ITEM |-> _V:Val) M:Map
+             => (ACC |-> I) M),
+           _P:Parent)
+         ...
+       </scopes>
+       requires notBool (ACC in_keys(M))
+        andBool notBool (ITEM in_keys(M))
+        andBool ACC =/=String ITEM
+
+  // Loop invariant for this program shape:
+  //
+  //   accumulator_after = accumulator_before + totalChars(remaining)
+  //
+  // The rule is deliberately restricted to iteration over strVals and to the
+  // exact `acc += len(item)` body.  TOTAL-MATCH-LOOP-SPEC proves the
+  // corresponding recursive #loop reachability claim using the reference
+  // iterator, binding, builtin-call, and AugAssign rules.  The loop variable's
+  // final binding is unobservable in total_match and its frame is discarded
+  // on return.
+  rule <k>
+         For(
+           Name(ITEM:String),
+           list(strVals(ITEMS:StrSeq)),
+           AugAssign(
+             Name(ACC:String),
+             "+",
+             Call(Name("len"), Name(ITEM))) .Stmts)
+         => .K
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           M:Map
+             => M [ ACC <- ({M[ACC]}:>Int +Int totalChars(ITEMS)) ],
+           _P:Parent)
+         ...
+       </scopes>
+       requires ACC in_keys(M)
+        andBool isInt({M[ACC]}:>Val)
+       [priority(40)]
+
+  // The translated function body, exposed as a callable closure so claims can
+  // supply arbitrary symbolic lists without changing the Python program.
+  syntax KItem ::= runTotalMatch(StrSeq, StrSeq)
+  rule <k> runTotalMatch(A:StrSeq, B:StrSeq)
+        => Call(
+             closureVal(
+               ("lst1", "lst2"),
+               Assign(Name("total1"), Int(0))
+               Assign(Name("total2"), Int(0))
+               For(Name("item"), Name("lst1"),
+                 AugAssign(
+                   Name("total1"),
+                   "+",
+                   Call(Name("len"), Name("item"))))
+               For(Name("item"), Name("lst2"),
+                 AugAssign(
+                   Name("total2"),
+                   "+",
+                   Call(Name("len"), Name("item"))))
+               If(
+                 Compare(Name("total1"), CmpOp("<=", Name("total2"))),
+                 Return(Name("lst1")),
+                 .Stmts)
+               Return(Name("lst2")),
+               0),
+             list(strVals(A)),
+             list(strVals(B)))
+           ...
+       </k>
+endmodule

exec
/bin/bash -lc ./prove.sh in /work
