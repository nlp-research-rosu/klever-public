      --save-temps         Do not delete temporary files when krun terminates.
      --search             Search for all possible output states after
                           rewriting. Only supported on symbolic backends.
      --search-all         Like --search, but also return interim states
      --search-final       Synonym for --search
      --search-one-or-more-steps  Like --search-all, but do not include the
                                  initial state in the result
      --search-one-step    Search for all possible states that are the
                           immediate successor of the input.
      --smt [none|z3]      Enable/disable SMT solver for symbolic execution.
      --smt-prelude FILE   Prepend FILE to all SMT queries during symbolic
                           execution.
      --smt-timeout SMT_TIMEOUT
                           Timeout for calls to the SMT solver, in milliseconds
      --statistics         Print number of steps executed. Currently only
                           supported on LLVM backend.
      --term               Use the value that would otherwise be considered the
                           value for $PGM as the entire input configuration.
                           i.e., skip composing configuration from
                           configuration variables.
      --version            Print version of K
      --                   Interpret all arguments following as positional
                           arguments.

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..c2366c392ce83cb33174a01104564ec958b620b1
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def total_match(lst1, lst2):
+    total1 = 0
+    total2 = 0
+
+    for item in lst1:
+        total1 += len(item)
+
+    for item in lst2:
+        total2 += len(item)
+
+    if total1 <= total2:
+        return lst1
+    return lst2
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..68c44cb6db3b1194bc33165e6784545d795a8eba
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,39 @@
+requires "verification.k"
+
+module TOTAL-MATCH-SPEC
+  imports TOTAL-MATCH-VERIFICATION
+
+  claim
+    <k> runTotalMatch(A:StrSeq, B:StrSeq)
+      => list(strVals(A))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires totalChars(A) <=Int totalChars(B)
+
+  claim
+    <k> runTotalMatch(A:StrSeq, B:StrSeq)
+      => list(strVals(B))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires totalChars(A) >Int totalChars(B)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..3c47e40a1e6df0b84cd7a584d214cbb036a3b240
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,82 @@
+requires "reference-semantics/semantics.k"
+
+module TOTAL-MATCH-VERIFICATION
+  imports MPY
+
+  // A proof-domain sequence whose elements are strings.  Keeping this sort
+  // separate from ValSeq records the HumanEval input precondition in the
+  // symbolic term itself.
+  syntax StrSeq ::= ".StrSeq"
+                  | ssCons(IntSeq, StrSeq)
+
+  syntax ValSeq ::= strVals(StrSeq)
+  rule strVals(.StrSeq) => .ValSeq
+  rule strVals(ssCons(S:IntSeq, REST:StrSeq))
+    => vCons(str(S), strVals(REST))
+
+  syntax Int ::= totalChars(StrSeq) [function, total]
+  rule totalChars(.StrSeq) => 0
+  rule totalChars(ssCons(S:IntSeq, REST:StrSeq))
+    => isLen(S) +Int totalChars(REST)
+
+  // Loop invariant for this program shape:
+  //
+  //   accumulator_after = accumulator_before + totalChars(remaining)
+  //
+  // The rule is deliberately restricted to iteration over strVals and to the
+  // exact `acc += len(item)` body.  The loop variable's final binding is
+  // unobservable in total_match and its frame is discarded on return.
+  rule <k>
+         For(
+           Name(ITEM:String),
+           list(strVals(ITEMS:StrSeq)),
+           AugAssign(
+             Name(ACC:String),
+             "+",
+             Call(Name("len"), Name(ITEM))) .Stmts)
+         => .K
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ...
+         L |-> scope(
+           M:Map
+             => M [ ACC <- ({M[ACC]}:>Int +Int totalChars(ITEMS)) ],
+           _P:Parent)
+         ...
+       </scopes>
+       requires ACC in_keys(M)
+        andBool isInt({M[ACC]}:>Val)
+       [priority(40)]
+
+  // The translated function body, exposed as a callable closure so claims can
+  // supply arbitrary symbolic lists without changing the Python program.
+  syntax KItem ::= runTotalMatch(StrSeq, StrSeq)
+  rule <k> runTotalMatch(A:StrSeq, B:StrSeq)
+        => Call(
+             closureVal(
+               ("lst1", "lst2"),
+               Assign(Name("total1"), Int(0))
+               Assign(Name("total2"), Int(0))
+               For(Name("item"), Name("lst1"),
+                 AugAssign(
+                   Name("total1"),
+                   "+",
+                   Call(Name("len"), Name("item"))))
+               For(Name("item"), Name("lst2"),
+                 AugAssign(
+                   Name("total2"),
+                   "+",
+                   Call(Name("len"), Name("item"))))
+               If(
+                 Compare(Name("total1"), CmpOp("<=", Name("total2"))),
+                 Return(Name("lst1")),
+                 .Stmts)
+               Return(Name("lst2")),
+               0),
+             list(strVals(A)),
+             list(strVals(B)))
+           ...
+       </k>
+endmodule

apply patch
