+  // accumulator and removes Python's unobservable final loop-variable binding.
+  claim
+    <k>
+      #loop(
+        list(strVals(ITEMS:StrSeq)),
+        Name("item"),
+        AugAssign(
+          Name("acc"),
+          "+",
+          Call(Name("len"), Name("item"))) .Stmts)
+      ~> readAccAndDrop("acc", "item")
+      => I +Int totalChars(ITEMS)
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+      1  |-> scope(
+        (("acc" |-> I:Int) EXTRA:Map
+          => ("acc" |-> (I +Int totalChars(ITEMS))) EXTRA),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires notBool ("acc" in_keys(EXTRA))
+     andBool notBool ("item" in_keys(EXTRA))
+     andBool notBool ("$cells" in_keys(EXTRA))
+endmodule
+
+module TOTAL-MATCH-SPEC
+  imports TOTAL-MATCH-VERIFICATION
+
+  claim
+    <k> runTotalMatch(A:StrSeq, B:StrSeq)
+      => list(strVals(A))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires totalChars(A) <=Int totalChars(B)
+
+  claim
+    <k> runTotalMatch(A:StrSeq, B:StrSeq)
+      => list(strVals(B))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
