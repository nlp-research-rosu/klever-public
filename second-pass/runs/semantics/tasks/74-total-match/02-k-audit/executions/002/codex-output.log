+requires "verification-no-loop-bridge.k"
+
+module BRIDGE-CONTEXT-WITNESS-NO
+  imports TOTAL-MATCH-VERIFICATION
+
+  // Identical false conclusion, checked without the candidate For bridge.
+  claim
+    <k>
+      For(
+        Name("item"),
+        list(strVals(ssCons(iCons(97, .IntSeq), .StrSeq))),
+        AugAssign(
+          Name("acc"),
+          "+",
+          Call(Name("len"), Name("item"))) .Stmts)
+      ~> Name("item")
+      => str(iCons(122, .IntSeq))
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+      1  |-> scope(
+        (("acc" |-> 0) ("item" |-> str(iCons(122, .IntSeq)))
+          => ("acc" |-> 1) ("item" |-> str(iCons(122, .IntSeq)))),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a//tmp/audit-work/74-total-match/bridge-context-witness.k b//tmp/audit-work/74-total-match/bridge-context-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..32a2506cc94321f6d6cb05efd3049178db1d8c25
--- /dev/null
+++ b//tmp/audit-work/74-total-match/bridge-context-witness.k
@@ -0,0 +1,36 @@
+requires "verification.k"
+
+module BRIDGE-CONTEXT-WITNESS
+  imports TOTAL-MATCH-VERIFICATION
+
+  // False under fixed semantics. The real loop overwrites item with "a", so
+  // the trailing Name("item") returns "a". The proof-local For bridge skips
+  // that binding effect and therefore returns the old value "z".
+  claim
+    <k>
+      For(
+        Name("item"),
+        list(strVals(ssCons(iCons(97, .IntSeq), .StrSeq))),
+        AugAssign(
+          Name("acc"),
+          "+",
+          Call(Name("len"), Name("item"))) .Stmts)
+      ~> Name("item")
+      => str(iCons(122, .IntSeq))
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+      1  |-> scope(
+        (("acc" |-> 0) ("item" |-> str(iCons(122, .IntSeq)))
+          => ("acc" |-> 1) ("item" |-> str(iCons(122, .IntSeq)))),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a//tmp/audit-work/74-total-match/spec-body-mut-right.k b//tmp/audit-work/74-total-match/spec-body-mut-right.k
new file mode 100644
index 0000000000000000000000000000000000000000..74fea968fb53b8ec28de874407bca2f2b04d34f6
--- /dev/null
+++ b//tmp/audit-work/74-total-match/spec-body-mut-right.k
@@ -0,0 +1,25 @@
+requires "verification-body-mut.k"
+
+module TOTAL-MATCH-BODY-MUT-RIGHT-SPEC
+  imports TOTAL-MATCH-VERIFICATION
+
+  // Same right-branch theorem, but runTotalMatch's first loop now adds zero.
+  // The satisfying witness A=["ab"], B=[] makes the original result B while
+  // the mutated executable term returns A.
+  claim
+    <k> runTotalMatch(A:StrSeq, B:StrSeq)
+      => list(strVals(B))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires totalChars(A) >Int totalChars(B)
+endmodule
