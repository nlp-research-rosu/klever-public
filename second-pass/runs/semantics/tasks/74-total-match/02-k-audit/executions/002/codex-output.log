diff --git a//tmp/audit-work/74-total-match/bridge-alias-witness-no.k b//tmp/audit-work/74-total-match/bridge-alias-witness-no.k
new file mode 100644
index 0000000000000000000000000000000000000000..970fe4b8db3494a58f4c6b68f48ef36736eba138
--- /dev/null
+++ b//tmp/audit-work/74-total-match/bridge-alias-witness-no.k
@@ -0,0 +1,30 @@
+requires "verification-no-loop-bridge.k"
+
+module BRIDGE-ALIAS-WITNESS-NO
+  imports TOTAL-MATCH-VERIFICATION
+
+  // Identical false conclusion, checked without the candidate For bridge.
+  claim
+    <k>
+      For(
+        Name("x"),
+        list(strVals(ssCons(iCons(97, .IntSeq), .StrSeq))),
+        AugAssign(
+          Name("x"),
+          "+",
+          Call(Name("len"), Name("x"))) .Stmts)
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+      1  |-> scope(("x" |-> 0 => "x" |-> 1), parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a//tmp/audit-work/74-total-match/bridge-alias-witness.k b//tmp/audit-work/74-total-match/bridge-alias-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..cf8c65aa355b2608f71c94ef361ab9bddeb39c26
--- /dev/null
+++ b//tmp/audit-work/74-total-match/bridge-alias-witness.k
@@ -0,0 +1,32 @@
+requires "verification.k"
+
+module BRIDGE-ALIAS-WITNESS
+  imports TOTAL-MATCH-VERIFICATION
+
+  // False under fixed semantics. Binding loop target x to "a" makes the body
+  // attempt "a" + len("a"), which has no valid Python/K operation. The bridge
+  // instead treats the old integer x as a separate accumulator and fabricates 1.
+  claim
+    <k>
+      For(
+        Name("x"),
+        list(strVals(ssCons(iCons(97, .IntSeq), .StrSeq))),
+        AugAssign(
+          Name("x"),
+          "+",
+          Call(Name("len"), Name("x"))) .Stmts)
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+      1  |-> scope(("x" |-> 0 => "x" |-> 1), parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
