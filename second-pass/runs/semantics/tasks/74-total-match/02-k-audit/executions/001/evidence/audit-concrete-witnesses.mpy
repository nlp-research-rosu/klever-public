Module(
  FuncDef("total_match", Params("lst1", "lst2"),
    Assign(Name("total1"), Int(0))
    Assign(Name("total2"), Int(0))
    For(Name("item"), Name("lst1"),
      AugAssign(Name("total1"), "+", Call(Name("len"), Name("item"))))
    For(Name("item"), Name("lst2"),
      AugAssign(Name("total2"), "+", Call(Name("len"), Name("item"))))
    If(Compare(Name("total1"), CmpOp("<=", Name("total2"))),
      Return(Name("lst1")),
      )
    Return(Name("lst2")))
  Assert(
    Compare(
      Call(Name("total_match"), ListExpr(), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("total_match"), ListExpr(Str("")), ListExpr()),
      CmpOp("==", ListExpr(Str("")))))
  Assert(
    Compare(
      Call(Name("total_match"), ListExpr(Str("a")), ListExpr(Str("b"))),
      CmpOp("==", ListExpr(Str("a")))))
  Assert(
    Compare(
      Call(Name("total_match"), ListExpr(Str("a")), ListExpr(Str("bb"))),
      CmpOp("==", ListExpr(Str("a")))))
  Assert(
    Compare(
      Call(Name("total_match"), ListExpr(Str("ab")), ListExpr(Str("x"))),
      CmpOp("==", ListExpr(Str("x")))))
  Assert(
    Compare(
      Call(
        Name("total_match"),
        ListExpr(Str("ab"), Str("c")),
        ListExpr(Str("x"), Str("yz"))),
      CmpOp("==", ListExpr(Str("ab"), Str("c")))))
  Assert(
    Compare(
      Call(
        Name("total_match"),
        ListExpr(Str(""), Str("")),
        ListExpr(Str(""))),
      CmpOp("==", ListExpr(Str(""), Str(""))))))
