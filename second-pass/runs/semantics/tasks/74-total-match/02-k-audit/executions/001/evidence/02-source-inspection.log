FILE /candidate/verification.k
     1	requires "reference-semantics/semantics.k"
     2	
     3	module TOTAL-MATCH-VERIFICATION
     4	  imports MPY
     5	
     6	  // A proof-domain sequence whose elements are strings.  Keeping this sort
     7	  // separate from ValSeq records the HumanEval input precondition in the
     8	  // symbolic term itself.
     9	  syntax StrSeq ::= ".StrSeq"
    10	                  | ssCons(IntSeq, StrSeq)
    11	
    12	  syntax ValSeq ::= strVals(StrSeq)
    13	  rule strVals(.StrSeq) => .ValSeq
    14	  rule strVals(ssCons(S:IntSeq, REST:StrSeq))
    15	    => vCons(str(S), strVals(REST))
    16	
    17	  syntax Int ::= totalChars(StrSeq) [function, total]
    18	  rule totalChars(.StrSeq) => 0
    19	  rule totalChars(ssCons(S:IntSeq, REST:StrSeq))
    20	    => isLen(S) +Int totalChars(REST)
    21	
    22	  // Let the reference iterator consume the proof-domain representation one
    23	  // symbolic string at a time.  This adapter is used by the independent loop
    24	  // invariant claim in spec.k.
    25	  syntax KItem ::= nextStrings(StrSeq)
    26	  rule <k> #iterNext(list(strVals(ITEMS:StrSeq)))
    27	        => nextStrings(ITEMS)
    28	        ...
    29	       </k>
    30	       [priority(40)]
    31	  rule <k> nextStrings(.StrSeq)
    32	        => #iterDone
    33	        ...
    34	       </k>
    35	  rule <k> nextStrings(ssCons(S:IntSeq, REST:StrSeq))
    36	        => #iterYield(str(S), list(strVals(REST)))
    37	        ...
    38	       </k>
    39	
    40	  // A proof-only observer used after the real loop: read the accumulator and
    41	  // discard the loop variable, which is unobservable to total_match.
    42	  syntax KItem ::= readAccAndDrop(String, String)
    43	  rule <k> readAccAndDrop(ACC:String, ITEM:String)
    44	        => I
    45	        ...
    46	       </k>
    47	       <env> L:Int </env>
    48	       <scopes>
    49	         ...
    50	         L |-> scope(
    51	           (ACC |-> I:Int) M:Map,
    52	           _P:Parent)
    53	         ...
    54	       </scopes>
    55	       requires notBool (ACC in_keys(M))
    56	        andBool ACC =/=String ITEM
    57	        andBool notBool (ITEM in_keys(M))
    58	
    59	  rule <k> readAccAndDrop(ACC:String, ITEM:String)
    60	        => I
    61	        ...
    62	       </k>
    63	       <env> L:Int </env>
    64	       <scopes>
    65	         ...
    66	         L |-> scope(
    67	           ((ACC |-> I:Int) (ITEM |-> _V:Val) M:Map
    68	             => (ACC |-> I) M),
    69	           _P:Parent)
    70	         ...
    71	       </scopes>
    72	       requires notBool (ACC in_keys(M))
    73	        andBool notBool (ITEM in_keys(M))
    74	        andBool ACC =/=String ITEM
    75	
    76	  // Loop invariant for this program shape:
    77	  //
    78	  //   accumulator_after = accumulator_before + totalChars(remaining)
    79	  //
    80	  // The rule is deliberately restricted to iteration over strVals and to the
    81	  // exact `acc += len(item)` body.  TOTAL-MATCH-LOOP-SPEC proves the
    82	  // corresponding recursive #loop reachability claim using the reference
    83	  // iterator, binding, builtin-call, and AugAssign rules.  The loop variable's
    84	  // final binding is unobservable in total_match and its frame is discarded
    85	  // on return.
    86	  rule <k>
    87	         For(
    88	           Name(ITEM:String),
    89	           list(strVals(ITEMS:StrSeq)),
    90	           AugAssign(
    91	             Name(ACC:String),
    92	             "+",
    93	             Call(Name("len"), Name(ITEM))) .Stmts)
    94	         => .K
    95	         ...
    96	       </k>
    97	       <env> L:Int </env>
    98	       <scopes>
    99	         ...
   100	         L |-> scope(
   101	           M:Map
   102	             => M [ ACC <- ({M[ACC]}:>Int +Int totalChars(ITEMS)) ],
   103	           _P:Parent)
   104	         ...
   105	       </scopes>
   106	       requires ACC in_keys(M)
   107	        andBool isInt({M[ACC]}:>Val)
   108	       [priority(40)]
   109	
   110	  // The translated function body, exposed as a callable closure so claims can
   111	  // supply arbitrary symbolic lists without changing the Python program.
   112	  syntax KItem ::= runTotalMatch(StrSeq, StrSeq)
   113	  rule <k> runTotalMatch(A:StrSeq, B:StrSeq)
   114	        => Call(
   115	             closureVal(
   116	               ("lst1", "lst2"),
   117	               Assign(Name("total1"), Int(0))
   118	               Assign(Name("total2"), Int(0))
   119	               For(Name("item"), Name("lst1"),
   120	                 AugAssign(
   121	                   Name("total1"),
   122	                   "+",
   123	                   Call(Name("len"), Name("item"))))
   124	               For(Name("item"), Name("lst2"),
   125	                 AugAssign(
   126	                   Name("total2"),
   127	                   "+",
   128	                   Call(Name("len"), Name("item"))))
   129	               If(
   130	                 Compare(Name("total1"), CmpOp("<=", Name("total2"))),
   131	                 Return(Name("lst1")),
   132	                 .Stmts)
   133	               Return(Name("lst2")),
   134	               0),
   135	             list(strVals(A)),
   136	             list(strVals(B)))
   137	           ...
   138	       </k>
   139	endmodule
