     1	def total_match(lst1, lst2):
     2	    total1 = 0
     3	    total2 = 0
     4	
     5	    for item in lst1:
     6	        total1 += len(item)
     7	
     8	    for item in lst2:
     9	        total2 += len(item)
    10	
    11	    if total1 <= total2:
    12	        return lst1
    13	    return lst2
