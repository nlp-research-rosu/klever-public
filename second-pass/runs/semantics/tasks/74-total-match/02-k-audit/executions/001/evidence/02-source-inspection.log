     3	module TOTAL-MATCH-LOOP-SPEC
     4	  imports TOTAL-MATCH-VERIFICATION
     5	
     6	  // Independent induction proof for the summary used by the program claims.
     7	  // The arbitrary OLD value generalizes the loop-variable binding between
     8	  // iterations.  The proof-only observer reads the accumulator and removes
     9	  // that unobservable binding at the end.
    10	  claim
    11	    <k>
    12	      #loop(
    13	        list(strVals(ITEMS:StrSeq)),
    14	        Name("item"),
    15	        AugAssign(
    16	          Name("acc"),
    17	          "+",
    18	          Call(Name("len"), Name("item"))) .Stmts)
    19	      ~> readAccAndDrop("acc", "item")
    20	      => I +Int totalChars(ITEMS)
    21	    </k>
    22	    <env> 1 </env>
    23	    <scopes>
    24	      -1 |-> builtinsScope
    25	      0  |-> scope(.Map, parent(-1))
    26	      1  |-> scope(
    27	        (("acc" |-> I:Int) ("item" |-> OLD:Val)
    28	          => "acc" |-> (I +Int totalChars(ITEMS))),
    29	        parent(0))
    30	    </scopes>
    31	    <scopeLoc> 2 </scopeLoc>
    32	    <heap> .Map </heap>
    33	    <heapLoc> 0 </heapLoc>
    34	    <stack> .List </stack>
    35	    <ret> noRet </ret>
    36	    <exc> NoExc </exc>
    37	endmodule
    38	
    39	module TOTAL-MATCH-SPEC
    40	  imports TOTAL-MATCH-VERIFICATION
    41	
    42	  claim
    43	    <k> runTotalMatch(A:StrSeq, B:StrSeq)
    44	      => list(strVals(A))
    45	    </k>
    46	    <env> 0 </env>
    47	    <scopes>
    48	      0  |-> scope(.Map, parent(-1))
    49	      -1 |-> builtinsScope
    50	    </scopes>
    51	    <scopeLoc> 1 </scopeLoc>
    52	    <heap> .Map </heap>
    53	    <heapLoc> 0 </heapLoc>
    54	    <stack> .List </stack>
    55	    <ret> noRet </ret>
    56	    <exc> NoExc </exc>
    57	    requires totalChars(A) <=Int totalChars(B)
    58	
    59	  claim
    60	    <k> runTotalMatch(A:StrSeq, B:StrSeq)
