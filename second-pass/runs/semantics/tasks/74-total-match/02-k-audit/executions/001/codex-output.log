diff --git a//tmp/audit-work/candidate-src/audit-fixed-witness.k b//tmp/audit-work/candidate-src/audit-fixed-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..039807d4c49602fbba7de9fbe13ac96762b491a0
--- /dev/null
