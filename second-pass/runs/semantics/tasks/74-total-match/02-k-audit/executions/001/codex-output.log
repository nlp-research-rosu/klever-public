diff --git a//tmp/audit-work/candidate-src/audit-bridge-false-witness.k b//tmp/audit-work/candidate-src/audit-bridge-false-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..889415a654c3bb71a45e0572b187cae7f47996c1
--- /dev/null
+++ b//tmp/audit-work/candidate-src/audit-bridge-false-witness.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module AUDIT-BRIDGE-FALSE-WITNESS
+  imports TOTAL-MATCH-VERIFICATION
+
+  claim
+    <k>
+      For(
+        Name("item"),
+        list(strVals(ssCons(iCons(97, .IntSeq), .StrSeq))),
+        AugAssign(
+          Name("acc"),
+          "+",
+          Call(Name("len"), Name("item"))) .Stmts)
+      ~> Name("item")
+      => str(iCons(122, .IntSeq))
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+      1  |-> scope(
+        (("acc" |-> 0) ("item" |-> str(iCons(122, .IntSeq)))
+          => ("acc" |-> 1) ("item" |-> str(iCons(122, .IntSeq)))),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a//tmp/audit-work/candidate-src/audit-bridge-witness-spec.k b//tmp/audit-work/candidate-src/audit-bridge-witness-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..6394163785bd992007acfd191c278528a6c09f96
--- /dev/null
+++ b//tmp/audit-work/candidate-src/audit-bridge-witness-spec.k
@@ -0,0 +1,68 @@
+requires "verification.k"
+requires "audit-fixed.k"
+
+module AUDIT-FIXED-WITNESS
+  imports AUDIT-FIXED
+
+  // Under fixed semantics, a one-element loop binds item to "a".
+  claim
+    <k>
+      For(
+        Name("item"),
+        list(strVals(ssCons(iCons(97, .IntSeq), .StrSeq))),
+        AugAssign(
+          Name("acc"),
+          "+",
+          Call(Name("len"), Name("item"))) .Stmts)
+      ~> Name("item")
+      => str(iCons(97, .IntSeq))
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+      1  |-> scope(
+        (("acc" |-> 0) ("item" |-> str(iCons(122, .IntSeq)))
+          => ("acc" |-> 1) ("item" |-> str(iCons(97, .IntSeq)))),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
+
+module AUDIT-BRIDGE-FALSE-WITNESS
+  imports TOTAL-MATCH-VERIFICATION
+
+  // The proof-local For bridge instead retains the old item value "z".
+  claim
+    <k>
+      For(
+        Name("item"),
+        list(strVals(ssCons(iCons(97, .IntSeq), .StrSeq))),
+        AugAssign(
+          Name("acc"),
+          "+",
+          Call(Name("len"), Name("item"))) .Stmts)
+      ~> Name("item")
+      => str(iCons(122, .IntSeq))
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+      1  |-> scope(
+        (("acc" |-> 0) ("item" |-> str(iCons(122, .IntSeq)))
+          => ("acc" |-> 1) ("item" |-> str(iCons(122, .IntSeq)))),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a//tmp/audit-work/candidate-src/audit-entry-split.k b//tmp/audit-work/candidate-src/audit-entry-split.k
new file mode 100644
index 0000000000000000000000000000000000000000..e92f09155b09d01b33c40d2bbe18dc2c7f2ed8b1
--- /dev/null
+++ b//tmp/audit-work/candidate-src/audit-entry-split.k
@@ -0,0 +1,43 @@
+requires "verification.k"
+
+module AUDIT-ENTRY-FIRST
+  imports TOTAL-MATCH-VERIFICATION
+
+  claim
+    <k> runTotalMatch(A:StrSeq, B:StrSeq)
+      => list(strVals(A))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires totalChars(A) <=Int totalChars(B)
+endmodule
+
+module AUDIT-ENTRY-SECOND
+  imports TOTAL-MATCH-VERIFICATION
+
+  claim
+    <k> runTotalMatch(A:StrSeq, B:StrSeq)
+      => list(strVals(B))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires totalChars(A) >Int totalChars(B)
+endmodule
