+  imports AUDIT-FIXED
+
+  // Under fixed semantics, a one-element loop binds item to "a".
+  claim
+    <k>
+      For(
+        Name("item"),
+        list(strVals(ssCons(iCons(97, .IntSeq), .StrSeq))),
+        AugAssign(
+          Name("acc"),
+          "+",
+          Call(Name("len"), Name("item"))) .Stmts)
+      ~> Name("item")
+      => str(iCons(97, .IntSeq))
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+      1  |-> scope(
+        (("acc" |-> 0) ("item" |-> str(iCons(122, .IntSeq)))
+          => ("acc" |-> 1) ("item" |-> str(iCons(97, .IntSeq)))),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
+
+module AUDIT-BRIDGE-FALSE-WITNESS
+  imports TOTAL-MATCH-VERIFICATION
+
+  // The proof-local For bridge instead retains the old item value "z".
+  claim
+    <k>
+      For(
+        Name("item"),
+        list(strVals(ssCons(iCons(97, .IntSeq), .StrSeq))),
+        AugAssign(
+          Name("acc"),
+          "+",
+          Call(Name("len"), Name("item"))) .Stmts)
+      ~> Name("item")
+      => str(iCons(122, .IntSeq))
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+      1  |-> scope(
+        (("acc" |-> 0) ("item" |-> str(iCons(122, .IntSeq)))
+          => ("acc" |-> 1) ("item" |-> str(iCons(122, .IntSeq)))),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a//tmp/audit-work/candidate-src/audit-concrete-witnesses.py b//tmp/audit-work/candidate-src/audit-concrete-witnesses.py
new file mode 100644
index 0000000000000000000000000000000000000000..adc61fdd0596a5987196942c7c300dd244c37978
--- /dev/null
+++ b//tmp/audit-work/candidate-src/audit-concrete-witnesses.py
@@ -0,0 +1,22 @@
+def total_match(lst1, lst2):
+    total1 = 0
+    total2 = 0
+
+    for item in lst1:
+        total1 += len(item)
+
+    for item in lst2:
+        total2 += len(item)
+
+    if total1 <= total2:
+        return lst1
+    return lst2
+
+
+assert total_match([], []) == []
+assert total_match([""], []) == [""]
+assert total_match(["a"], ["b"]) == ["a"]
+assert total_match(["a"], ["bb"]) == ["a"]
+assert total_match(["ab"], ["x"]) == ["x"]
+assert total_match(["ab", "c"], ["x", "yz"]) == ["ab", "c"]
+assert total_match(["", ""], [""]) == ["", ""]
