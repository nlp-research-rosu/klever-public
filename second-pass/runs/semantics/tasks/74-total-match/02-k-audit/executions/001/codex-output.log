index 0000000000000000000000000000000000000000..48f3214d6e9f3a805a26b486a60b472e705cf9dd
--- /dev/null
+++ b/evidence/validate_review.py
@@ -0,0 +1,26 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import re
+
+review = Path("/audit-output/REVIEW.md")
+text = review.read_text(encoding="utf-8")
+lines = text.splitlines()
+assert lines[-2:] == ["VERDICT: FAIL", "LEGITIMACY: NOT_LEGIT"]
+assert text.count("VERDICT: ") == 1
+assert text.count("LEGITIMACY: ") == 1
+
+missing = []
+for target in re.findall(r"\]\((evidence/[^)]+)\)", text):
+    if not (Path("/audit-output") / target).is_file():
+        missing.append(target)
+assert not missing, missing
+
+for stage in range(1, 8):
+    assert re.search(rf"^## {stage}\.", text, flags=re.MULTILINE), stage
+
+evidence_link_count = len(re.findall(r"\]\(evidence/[^)]+\)", text))
+print(f"review_bytes={len(text.encode('utf-8'))}")
+print(f"evidence_links={evidence_link_count}")
+print("seven_stages=present")
+print("terminal_markers=exact")
+print("RESULT: PASS")

Completed all seven stages in order, including fresh concrete/proof builds, independent differential tests, claim witnesses, exhaustive static inventory, a fixed-vs-bridge false-conclusion witness, a program-pinning mutation, and a meaningful non-vacuity mutation. REVIEW.md and reproducible evidence are finalized.
  ✓ Read mandated Kit skill instructions and verify semantics-mode mounts
  ✓ Stage 1: audit inputs, provenance, trusted-file integrity, and supplied semantics tree
  ✓ Stage 2: check program fidelity, regenerate MPY, and run independent differential tests
  ✓ Stage 3: rebuild definitions from clean source and rerun every positive proof claim
  ✓ Stage 4: audit claim adequacy, real-program pinning, and concrete witnesses
  ✓ Stage 5: inventory and review every semantic and verification rule
  ✓ Stage 6: create and run a fresh false non-vacuity mutation
  ✓ Stage 7: account for proven versus assumed boundaries and write REVIEW.md
