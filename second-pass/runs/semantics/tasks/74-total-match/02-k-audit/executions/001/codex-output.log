@@ -0,0 +1,33 @@
+requires "audit-fixed.k"
+
+module AUDIT-FIXED-WITNESS
+  imports AUDIT-FIXED
+
+  claim
+    <k>
+      For(
+        Name("item"),
+        list(strVals(ssCons(iCons(97, .IntSeq), .StrSeq))),
+        AugAssign(
+          Name("acc"),
+          "+",
+          Call(Name("len"), Name("item"))) .Stmts)
+      ~> Name("item")
+      => str(iCons(97, .IntSeq))
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+      1  |-> scope(
+        (("acc" |-> 0) ("item" |-> str(iCons(122, .IntSeq)))
+          => ("acc" |-> 1) ("item" |-> str(iCons(97, .IntSeq)))),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
