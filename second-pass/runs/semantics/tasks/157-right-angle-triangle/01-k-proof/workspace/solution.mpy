Module(
  FuncDef("right_angle_triangle", Params("a", "b", "c"),
    If(Compare(Name("a"), CmpOp("<=", Int(0))),
      Return(Bool(false)),
      )
    If(Compare(Name("b"), CmpOp("<=", Int(0))),
      Return(Bool(false)),
      )
    If(Compare(Name("c"), CmpOp("<=", Int(0))),
      Return(Bool(false)),
      )
    If(Compare(
      BinOp(
        "+",
        BinOp("*", Name("a"), Name("a")),
        BinOp("*", Name("b"), Name("b"))),
      CmpOp("==", BinOp("*", Name("c"), Name("c")))),
      Return(Bool(true)),
      )
    If(Compare(
      BinOp(
        "+",
        BinOp("*", Name("a"), Name("a")),
        BinOp("*", Name("c"), Name("c"))),
      CmpOp("==", BinOp("*", Name("b"), Name("b")))),
      Return(Bool(true)),
      )
    If(Compare(
      BinOp(
        "+",
        BinOp("*", Name("b"), Name("b")),
        BinOp("*", Name("c"), Name("c"))),
      CmpOp("==", BinOp("*", Name("a"), Name("a")))),
      Return(Bool(true)),
      )
    Return(Bool(false))))
