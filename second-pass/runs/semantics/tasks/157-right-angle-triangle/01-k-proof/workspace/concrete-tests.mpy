Module(
  FuncDef("right_angle_triangle", Params("a", "b", "c"),
    If(Compare(Name("a"), CmpOp("<=", Int(0))),
      Return(Bool(false)),
      )
    If(Compare(Name("b"), CmpOp("<=", Int(0))),
      Return(Bool(false)),
      )
    If(Compare(Name("c"), CmpOp("<=", Int(0))),
      Return(Bool(false)),
      )
    If(Compare(
      BinOp(
        "+",
        BinOp("*", Name("a"), Name("a")),
        BinOp("*", Name("b"), Name("b"))),
      CmpOp("==", BinOp("*", Name("c"), Name("c")))),
      Return(Bool(true)),
      )
    If(Compare(
      BinOp(
        "+",
        BinOp("*", Name("a"), Name("a")),
        BinOp("*", Name("c"), Name("c"))),
      CmpOp("==", BinOp("*", Name("b"), Name("b")))),
      Return(Bool(true)),
      )
    If(Compare(
      BinOp(
        "+",
        BinOp("*", Name("b"), Name("b")),
        BinOp("*", Name("c"), Name("c"))),
      CmpOp("==", BinOp("*", Name("a"), Name("a")))),
      Return(Bool(true)),
      )
    Return(Bool(false)))
  Assert(Call(Name("right_angle_triangle"), Int(3), Int(4), Int(5)))
  Assert(Call(Name("right_angle_triangle"), Int(3), Int(5), Int(4)))
  Assert(Call(Name("right_angle_triangle"), Int(5), Int(3), Int(4)))
  Assert(Call(Name("right_angle_triangle"), Int(5), Int(4), Int(3)))
  Assert(Call(Name("right_angle_triangle"), Int(4), Int(3), Int(5)))
  Assert(Call(Name("right_angle_triangle"), Int(4), Int(5), Int(3)))
  Assert(Call(Name("right_angle_triangle"), Int(5), Int(12), Int(13)))
  Assert(
    UnaryOp(
      "not",
      Call(Name("right_angle_triangle"), Int(1), Int(2), Int(3))))
  Assert(
    UnaryOp(
      "not",
      Call(Name("right_angle_triangle"), Int(0), Int(4), Int(4))))
  Assert(
    UnaryOp(
      "not",
      Call(Name("right_angle_triangle"), Int(4), Int(0), Int(4))))
  Assert(
    UnaryOp(
      "not",
      Call(Name("right_angle_triangle"), Int(4), Int(4), Int(0))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("right_angle_triangle"),
        UnaryOp("-", Int(3)),
        Int(4),
        Int(5)))))
