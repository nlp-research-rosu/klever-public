+    "full Stage 1 tree",
+    pipeline_contract.sha256_tree(FROZEN),
+    resolution["hashes"]["k_workspace_sha256"],
+)
+check(
+    "Stage 1 deterministic export tree",
+    klean_export.tree_digest(FROZEN),
+    resolution["hashes"]["stage1_export_sha256"],
+)
+check(
