+    "DOMAIN_LEMMA": input_manifest["source_rules"],
+    "OPERATIONAL_RULE": input_manifest["operational_rules"],
+    "PROVED_DERIVED_LEMMA": input_manifest["proved_derived_lemmas"],
+}
+for classification, recorded in partitions.items():
