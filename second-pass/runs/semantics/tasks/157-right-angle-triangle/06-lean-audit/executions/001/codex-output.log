     1	def right_angle_triangle(a, b, c):
     2	    if a <= 0:
     3	        return False
     4	    if b <= 0:
     5	        return False
     6	    if c <= 0:
     7	        return False
     8	    if a * a + b * b == c * c:
     9	        return True
    10	    if a * a + c * c == b * b:
    11	        return True
    12	    if b * b + c * c == a * a:
    13	        return True
    14	    return False
