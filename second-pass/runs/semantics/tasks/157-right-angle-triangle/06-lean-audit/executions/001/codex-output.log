+    ssize_t numeric_result =
+        readlink(proc_path, destination, sizeof(destination));
+    printf(
+        "pid=%d proc_path=%s readlink_result=%zd path=%s\n",
+        getpid(),
+        proc_path,
+        numeric_result,
+        destination
+    );
+    return result == 0 && numeric_result >= 0 ? 0 : 1;
+}

codex
The direct probe reproduced the sandbox defect precisely: `getpid()` returns the container PID (for example `4`), but `/proc/4/exe` is absent while `/proc/self/exe` works. Lean 4.22 hardcodes `/proc/<getpid()>/exe`. I’m applying a narrowly scoped preload shim that rewrites only that self-executable lookup to `/proc/self/exe`, then rerunning the unmodified trusted preflight.
apply patch
