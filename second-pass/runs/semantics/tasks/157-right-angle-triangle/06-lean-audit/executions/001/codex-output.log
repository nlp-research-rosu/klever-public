+    len(set(discovery_ids)),
+)
+check(
+    "verification source hash",
+    inventory["verification_sha256"],
+    input_manifest["verification_sha256"],
+)
+
+allowed_classes = {
+    "DEFINITION",
+    "DOMAIN_LEMMA",
+    "OPERATIONAL_RULE",
+    "PROVED_DERIVED_LEMMA",
+}
+observed_classes = [rule.get("classification") for rule in discovery["rules"]]
