WORKDIR: /tmp/audit-work
COMMAND: bash -lc for\ name\ in\ all_original\ pythagorean-c\ pythagorean-b\ pythagorean-a\ nonpositive-a\ nonpositive-b\ nonpositive-c\ positive-none\;\ do\ file=\"/audit-output/evidence/stage3_kprove_\$\{name\}.log\"\;\ printf\ \"%s:\ \"\ \"\$name\"\;\ if\ \[\ -f\ \"\$file\"\ \]\;\ then\ top=\$\(grep\ -c\ \"\^#Top\$\"\ \"\$file\"\ \|\|\ true\)\;\ status=\$\(sed\ -n\ \"s/\^EXIT_STATUS:\ //p\"\ \"\$file\"\ \|\ tail\ -1\)\;\ printf\ \"top_count=%s\ exit=%s\\n\"\ \"\$top\"\ \"\$status\"\;\ else\ printf\ \"MISSING_LOG\\n\"\;\ fi\;\ done
all_original: top_count=1 exit=0
pythagorean-c: top_count=1 exit=0
pythagorean-b: top_count=1 exit=0
pythagorean-a: top_count=1 exit=0
nonpositive-a: top_count=1 exit=0
nonpositive-b: top_count=1 exit=0
nonpositive-c: top_count=1 exit=0
positive-none: top_count=1 exit=0
EXIT_STATUS: 0
