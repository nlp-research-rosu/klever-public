===== verification.k =====
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // This is exactly the function body emitted in solution.mpy.  Keeping it as
     7	  // a named function lets each claim call the submitted implementation without
     8	  // loading any extra, proof-only Python code.
     9	  syntax Stmts ::= "#rightAngleTriangleBody" [function]
    10	  rule #rightAngleTriangleBody
    11	    => If(Compare(Name("a"), CmpOp("<=", Int(0))),
    12	          Return(Bool(false)),
    13	          .Stmts)
    14	       If(Compare(Name("b"), CmpOp("<=", Int(0))),
    15	          Return(Bool(false)),
    16	          .Stmts)
    17	       If(Compare(Name("c"), CmpOp("<=", Int(0))),
    18	          Return(Bool(false)),
    19	          .Stmts)
    20	       If(Compare(
    21	            BinOp("+",
    22	              BinOp("*", Name("a"), Name("a")),
    23	              BinOp("*", Name("b"), Name("b"))),
    24	            CmpOp("==", BinOp("*", Name("c"), Name("c")))),
    25	          Return(Bool(true)),
    26	          .Stmts)
    27	       If(Compare(
    28	            BinOp("+",
    29	              BinOp("*", Name("a"), Name("a")),
    30	              BinOp("*", Name("c"), Name("c"))),
    31	            CmpOp("==", BinOp("*", Name("b"), Name("b")))),
    32	          Return(Bool(true)),
    33	          .Stmts)
    34	       If(Compare(
    35	            BinOp("+",
    36	              BinOp("*", Name("b"), Name("b")),
    37	              BinOp("*", Name("c"), Name("c"))),
    38	            CmpOp("==", BinOp("*", Name("a"), Name("a")))),
    39	          Return(Bool(true)),
    40	          .Stmts)
    41	       Return(Bool(false))
    42	
    43	  syntax Val ::= "#rightAngleTriangleClosure" [function]
    44	  rule #rightAngleTriangleClosure
    45	    => closureVal(("a", "b", "c"), #rightAngleTriangleBody, 0)
    46	
    47	  syntax KItem ::= "#runRightAngleTriangle"
    48	                   "(" Int "," Int "," Int ")"
    49	  rule #runRightAngleTriangle(A:Int, B:Int, C:Int)
    50	    => Call(#rightAngleTriangleClosure, A, B, C)
    51	endmodule
===== prove.sh =====
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Regenerate the submitted constructor term with the fixed translator.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	python3 -m py_compile solution.py concrete_tests.py
     7	
     8	# Build and run the supplied concrete semantics.  The test program exercises
     9	# all hypotenuse positions, ordinary false cases, and non-positive lengths.
    10	python3 py2mpy.py concrete_tests.py > concrete-tests.mpy
    11	kompile reference-semantics/semantics.k \
    12	  --backend llvm \
    13	  --main-module MPY-KRUN \
    14	  --syntax-module MPY-SYNTAX \
    15	  --output-definition runtime-kompiled
    16	krun concrete-tests.mpy --definition runtime-kompiled
    17	
    18	# Build the symbolic definition from the supplied MPY modules and prove every
    19	# claim in spec.k.  Success is an exit status of zero and the output "#Top".
    20	kompile verification.k \
    21	  --backend haskell \
    22	  --main-module VERIFICATION \
    23	  --syntax-module MPY-SYNTAX \
    24	  --output-definition verification-kompiled
    25	kprove spec.k \
    26	  --definition verification-kompiled \
    27	  --spec-module SPEC
