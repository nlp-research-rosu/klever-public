     7	    '''
     8	    Given the lengths of the three sides of a triangle. Return True if the three
     9	    sides form a right-angled triangle, False otherwise.
    10	    A right-angled triangle is a triangle in which one angle is right angle or 
    11	    90 degree.
    12	    Example:
    13	    right_angle_triangle(3, 4, 5) == True
    14	    right_angle_triangle(1, 2, 3) == False
    15	    '''
    16	    return a*a == b*b + c*c or b*b == a*a + c*c or c*c == a*a + b*b
===== /candidate/solution.py =====
     1	def right_angle_triangle(a, b, c):
     2	    if a <= 0:
     3	        return False
     4	    if b <= 0:
     5	        return False
     6	    if c <= 0:
     7	        return False
     8	    if a * a + b * b == c * c:
     9	        return True
    10	    if a * a + c * c == b * b:
    11	        return True
    12	    if b * b + c * c == a * a:
    13	        return True
    14	    return False
