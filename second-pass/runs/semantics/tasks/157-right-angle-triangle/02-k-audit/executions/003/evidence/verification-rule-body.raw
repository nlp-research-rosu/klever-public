If(Compare(Name("a"), CmpOp("<=", Int(0))),
          Return(Bool(false)),
          .Stmts)
       If(Compare(Name("b"), CmpOp("<=", Int(0))),
          Return(Bool(false)),
          .Stmts)
       If(Compare(Name("c"), CmpOp("<=", Int(0))),
          Return(Bool(false)),
          .Stmts)
       If(Compare(
            BinOp("+",
              BinOp("*", Name("a"), Name("a")),
              BinOp("*", Name("b"), Name("b"))),
            CmpOp("==", BinOp("*", Name("c"), Name("c")))),
          Return(Bool(true)),
          .Stmts)
       If(Compare(
            BinOp("+",
              BinOp("*", Name("a"), Name("a")),
              BinOp("*", Name("c"), Name("c"))),
            CmpOp("==", BinOp("*", Name("b"), Name("b")))),
          Return(Bool(true)),
          .Stmts)
       If(Compare(
            BinOp("+",
              BinOp("*", Name("b"), Name("b")),
              BinOp("*", Name("c"), Name("c"))),
            CmpOp("==", BinOp("*", Name("a"), Name("a")))),
          Return(Bool(true)),
          .Stmts)
       Return(Bool(false))
