@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: $0 LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
