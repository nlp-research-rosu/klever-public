+  exit 64
+fi
+
+logfile="$1"
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$logfile"
+
+"$@" >> "$logfile" 2>&1
+status=$?
+
+printf 'EXIT STATUS: %d\n' "$status" >> "$logfile"
+exit "$status"

