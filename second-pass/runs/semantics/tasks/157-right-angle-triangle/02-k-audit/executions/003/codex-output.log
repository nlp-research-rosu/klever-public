new file mode 100644
index 0000000000000000000000000000000000000000..01ecac38562a841f063c924ef6816c2bfc0aa780
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: $0 LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+logfile="$1"
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$logfile"
+
+"$@" >> "$logfile" 2>&1
+status=$?
+
+printf 'EXIT STATUS: %d\n' "$status" >> "$logfile"
+exit "$status"

