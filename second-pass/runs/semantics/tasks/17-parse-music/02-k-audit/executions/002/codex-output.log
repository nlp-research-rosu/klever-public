/bin/bash -lc 'export PATH="/home/agent/.nix-profile/bin:$PATH"
kast --definition body-mutant-base-kompiled --module PARSE-MUSIC-BASE --sort Module --expand-macros --output json claim-program.mpy --output-file claim-program-body-mutant-expanded.json
kast_status=$?
