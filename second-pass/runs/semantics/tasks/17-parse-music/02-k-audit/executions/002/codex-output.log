           'actual Python type as read off the AST, not a semantic judgement.\n'
           '\n'
           'Anything outside the covered subset raises `Unsupported`, naming '
           'the node, so\n'
           'coverage gaps fail loudly instead of being silently dropped.\n'
           '\n'
           'Usage:\n'
           '    python scripts/py2mpy.py FILE.py          # print the .mpy '
           'term (default)\n'
           '    python scripts/py2mpy.py FILE.py --ast    # print the Python '
           'AST (ast.dump)\n'
           '"""\n'
           'from __future__ import annotations\n'
           '\n'
           'import argparse\n'
           'import symtable\n'
           'import ast\n'
           'import json\n'
           'import sys\n'
           '\n'
           '\n'
           'class Unsupported(Exception):\n'
           '    """Raised for any AST node the transliterator does not '
           'cover."""\n'
           '\n'
           '\n'
           '# '
           '---------------------------------------------------------------------------\n'
           '# Term model: a .mpy term is a tree of these three node kinds.\n'
           '#   Ctor(name, *args)  -> `name(arg, arg, ...)`  (comma-separated '
           'args)\n'
           '#   Seq([item, ...])   -> a statement list: juxtaposed, no parens, '
           'no commas\n'
           '#   str                -> a leaf token already in K surface form\n'
           '#                         (a quoted string `"op"`, a number `0`, '
           '`true`, `Break`)\n'
           '# '
           '---------------------------------------------------------------------------\n'
           'class Ctor:\n'
           '    __slots__ = ("name", "args")\n'
           '\n'
           '    def __init__(self, name: str, *args):\n'
           '        self.name = name\n'
           '        self.args = list(args)\n'
           '\n'
           '\n'
           'class Seq:\n'
           '    __slots__ = ("items",)\n'
           '\n'
           '    def __init__(self, items):\n'
           '        self.items = list(items)\n'
           '\n'
           '\n'
           'def q(s: str) -> str:\n'
           '    """A Python string as a K String token (double-quoted, '
           'escaped)."""\n'
           '    return json.dumps(s)\n'
           '\n'
           '\n'
           '# --- Operator spellings (string tokens carried inside '
           'constructors) ----------\n'
           '# These are transliterations of the operator *symbol*, not its '
           'meaning.\n'
           '_BINOP = {\n'
           '    ast.Add: "+", ast.Sub: "-", ast.Mult: "*", ast.Div: "/",\n'
           '    ast.FloorDiv: "//", ast.Mod: "%", ast.Pow: "**",\n'
           '    ast.BitOr: "|", ast.BitAnd: "&", ast.BitXor: "^",\n'
           '    ast.LShift: "<<", ast.RShift: ">>", ast.MatMult: "@",\n'
           '}\n'
           '_UNARY = {ast.USub: "-", ast.UAdd: "+", ast.Not: "not", '
           'ast.Invert: "~"}\n'
           '_BOOLOP = {ast.And: "and", ast.Or: "or"}\n'
           '_CMPOP = {\n'
           '    ast.Eq: "==", ast.NotEq: "!=", ast.Lt: "<", ast.LtE: "<=",\n'
           '    ast.Gt: ">", ast.GtE: ">=", ast.Is: "is", ast.IsNot: "is '
           'not",\n'
           '    ast.In: "in", ast.NotIn: "not in",\n'
           '}\n'
           '\n'
           '\n'
           '# '
           '---------------------------------------------------------------------------\n'
           "# Closure scopes (Python's own symtable, faithfully exposed)\n"
           '# '
           '---------------------------------------------------------------------------\n'
           '# (name, lineno) -> (cellvars, freevars, nested). A def/lambda '
           'gets the\n'
           '# ANNOTATED node form iff it is nested inside a function or has '
           'cells/frees;\n'
           '# module-level capture-free defs keep the old shape (zero churn).\n'
           'SCOPES: dict = {}\n'
           '\n'
           '\n'
           'def _frees(table):\n'
           '    return set(table.get_frees()) if isinstance(table, '
           'symtable.Function) else set()\n'
           '\n'
           '\n'
           'def _deep_frees(table):\n'
           '    out = _frees(table)\n'
           '    for g in table.get_children():\n'
           '        out |= _deep_frees(g) - set(table.get_locals())\n'
           '    return out\n'
           '\n'
           '\n'
           'def _walk_symtable(table, depth=0):\n'
           '    for child in table.get_children():\n'
           '        if child.get_type() in ("function", "lambda"):\n'
           '            frees = sorted(_frees(child))\n'
           '            cells = sorted(\n'
           '                s for s in child.get_locals()\n'
           '                if any(s in _deep_frees(g) for g in '
           'child.get_children())\n'
           '            )\n'
           '            SCOPES[(child.get_name(), child.get_lineno())] = (\n'
           '                cells, frees, depth > 0 or table.get_type() != '
           '"module")\n'
           '        _walk_symtable(child, depth + (1 if child.get_type() in '
           '("function", "lambda") else 0))\n'
           '\n'
           '\n'
           'def scope_info(name, lineno):\n'
           '    return SCOPES.get((name, lineno))\n'
           '\n'
           '\n'
           '# '
           '---------------------------------------------------------------------------\n'
           '# Expressions\n'
           '# '
           '---------------------------------------------------------------------------\n'
           'def emit_expr(node: ast.expr):\n'
           '    if isinstance(node, ast.Constant):\n'
           '        v = node.value\n'
           '        if v is None:\n'
           '            return "NoneVal"\n'
           '        if isinstance(v, bool):                 # MUST precede int '
           '(bool ⊂ int)\n'
           '            return Ctor("Bool", "true" if v else "false")\n'
           '        if isinstance(v, int):\n'
           '            return Ctor("Int", str(v))\n'
           '        if isinstance(v, float):\n'
           '            return Ctor("Float", repr(v))\n'
           '        if isinstance(v, str):\n'
           '            return Ctor("Str", q(v))\n'
           '        raise Unsupported(f"Constant {type(v).__name__}")\n'
           '\n'
           '    if isinstance(node, ast.Name):\n'
           '        return Ctor("Name", q(node.id))\n'
           '\n'
           '    if isinstance(node, ast.Lambda):\n'
           '        a = node.args\n'
           '        if a.vararg or a.kwarg or a.kwonlyargs or a.defaults or '
           'a.kw_defaults:\n'
           '            raise Unsupported("complex lambda signature")\n'
           '        names = [p.arg for p in (a.posonlyargs + a.args)]\n'
           '        params = Ctor("Params", *(q(n) for n in names))\n'
           '        info = scope_info("lambda", node.lineno)\n'
           '        if info and (info[0] or info[1] or info[2]):\n'
           '            cells, frees, _ = info\n'
           '            return Ctor("Lambda", params,\n'
           '                        Ctor("CellVars", *(q(n) for n in cells)),\n'
           '                        Ctor("FreeVars", *(q(n) for n in frees)),\n'
           '                        emit_expr(node.body))\n'
           '        return Ctor("Lambda", params, emit_expr(node.body))\n'
           '\n'
           '    if isinstance(node, ast.BinOp):\n'
           '        op = _BINOP.get(type(node.op))\n'
           '        if op is None:\n'
           '            raise Unsupported(f"BinOp {type(node.op).__name__}")\n'
           '        return Ctor("BinOp", q(op), emit_expr(node.left), '
           'emit_expr(node.right))\n'
           '\n'
           '    if isinstance(node, ast.UnaryOp):\n'
           '        op = _UNARY.get(type(node.op))\n'
           '        if op is None:\n'
           '            raise Unsupported(f"UnaryOp '
           '{type(node.op).__name__}")\n'
           '        return Ctor("UnaryOp", q(op), emit_expr(node.operand))\n'
           '\n'
           '    if isinstance(node, ast.BoolOp):\n'
           '        op = _BOOLOP[type(node.op)]\n'
           '        return Ctor("BoolOp", q(op), *(emit_expr(v) for v in '
           'node.values))\n'
           '\n'
           '    if isinstance(node, ast.Compare):\n'
           '        # Faithful, non-desugared: left operand + a chain of (op, '
           'comparator).\n'
           '        # Single comparison => one CmpOp; `a < b < c` => two '
           'CmpOps.\n'
           '        chain = [\n'
           '            Ctor("CmpOp", q(_op_or_raise(_CMPOP, op, "Compare")), '
           'emit_expr(c))\n'
           '            for op, c in zip(node.ops, node.comparators)\n'
           '        ]\n'
           '        return Ctor("Compare", emit_expr(node.left), *chain)\n'
           '\n'
           '    if isinstance(node, ast.List):\n'
           '        return Ctor("ListExpr", *(emit_expr(e) for e in '
           'node.elts))\n'
           '\n'
           '    if isinstance(node, ast.Tuple):\n'
           '        return Ctor("TupleExpr", *(emit_expr(e) for e in '
           'node.elts))\n'
           '\n'
           '    if isinstance(node, ast.Set):\n'
           '        return Ctor("SetExpr", *(emit_expr(e) for e in '
           'node.elts))\n'
           '\n'
           '    if isinstance(node, ast.Dict):\n'
           '        entries = []\n'
           '        for k, v in zip(node.keys, node.values):\n'
           '            if k is None:\n'
           '                raise Unsupported("dict unpacking {**x}")\n'
           '            entries.append(Ctor("Entry", emit_expr(k), '
           'emit_expr(v)))\n'
           '        return Ctor("DictExpr", *entries)\n'
           '\n'
           '    if isinstance(node, ast.Subscript):\n'
           '        return Ctor("Subscript", emit_expr(node.value), '
           'emit_index(node.slice))\n'
           '\n'
           '    if isinstance(node, ast.Attribute):\n'
           '        return Ctor("Attribute", emit_expr(node.value), '
           'q(node.attr))\n'
           '\n'
           '    if isinstance(node, ast.Call):\n'
           '        if any(isinstance(a, ast.Starred) for a in node.args):\n'
           '            raise Unsupported("*args unpacking")\n'
           '        if any(kw.arg is None for kw in node.keywords):\n'
           '            raise Unsupported("**kwargs unpacking")\n'
           '        # Call grammar is `Call(Expr, Exprs)` — the comma is '
           'mandatory, so a zero-arg\n'
           '        # call must render as `Call(f, )` (empty Exprs), NOT '
           "`Call(f)` (which won't parse).\n"
           '        args = [emit_expr(a) for a in node.args]\n'
           '        args += [Ctor("KwArg", q(kw.arg), emit_expr(kw.value)) for '
           'kw in node.keywords]\n'
           '        args = args or [""]\n'
           '        return Ctor("Call", emit_expr(node.func), *args)\n'
           '\n'
           '    if isinstance(node, ast.IfExp):\n'
           '        # AST field order: test, body, orelse — kept verbatim.\n'
           '        return Ctor("IfExp", emit_expr(node.test),\n'
           '                    emit_expr(node.body), emit_expr(node.orelse))\n'
           '\n'
           '    if isinstance(node, ast.ListComp):\n'
           '        return Ctor("ListComp", emit_expr(node.elt), '
           '_gens(node.generators))\n'
           '    if isinstance(node, ast.SetComp):\n'
           '        return Ctor("SetComp", emit_expr(node.elt), '
           '_gens(node.generators))\n'
           '    if isinstance(node, ast.GeneratorExp):\n'
           '        return Ctor("GenExp", emit_expr(node.elt), '
           '_gens(node.generators))\n'
           '    if isinstance(node, ast.DictComp):\n'
           '        return Ctor("DictComp", emit_expr(node.key), '
           'emit_expr(node.value),\n'
           '                    _gens(node.generators))\n'
           '\n'
           '    raise Unsupported(f"Expr {type(node).__name__}")\n'
           '\n'
           '\n'
           'def _op_or_raise(table, op, label):\n'
           '    spelled = table.get(type(op))\n'
           '    if spelled is None:\n'
           '        raise Unsupported(f"{label} {type(op).__name__}")\n'
           '    return spelled\n'
           '\n'
           '\n'
           'def _compfor(g):\n'
           '    """A single generator -> CompFor(target, iter, <ifs as Exprs; '
           '.Exprs if none>)."""\n'
           '    if getattr(g, "is_async", 0):\n'
           '        raise Unsupported("async comprehension")\n'
           '    ifs = [emit_expr(c) for c in g.ifs] or [Ctor("Bool", "true")]\n'
           '    return Ctor("CompFor", emit_expr(g.target), emit_expr(g.iter), '
           '*ifs)\n'
           '\n'
           '\n'
           'def _gens(generators):\n'
           '    """The generator list -> a juxtaposed CompFors (a Seq of '
           'CompFor)."""\n'
           '    return Seq([_compfor(g) for g in generators])\n'
           '\n'
           '\n'
           'def emit_index(node: ast.expr):\n'
           '    """Subscript index position: an `ast.Slice` -> `Slice(...)`, '
           'else the expr."""\n'
           '    # Python <3.9 wrapped the index in ast.Index; unwrap if '
           'present.\n'
           '    inner = getattr(ast, "Index", None)\n'
           '    if inner is not None and isinstance(node, inner):\n'
           '        node = node.value\n'
           '    if isinstance(node, ast.Slice):\n'
           '        def bound(b):\n'
           '            # omitted bound (absent field) OR an explicit None '
           'constant -> NoBound.\n'
           '            # Python treats `a[None:5]` exactly like `a[:5]`; only '
           'a *value* None\n'
           '            # (Constant(None) outside a slice) becomes NoneVal. '
           'Keeping the two\n'
           '            # distinct lets NoneVal be a real value without '
           'perturbing slices.\n'
           '            if b is None or (isinstance(b, ast.Constant) and '
           'b.value is None):\n'
           '                return "NoBound"\n'
           '            return emit_expr(b)\n'
           '        return Ctor("Slice", bound(node.lower), bound(node.upper), '
           'bound(node.step))\n'
           '    return emit_expr(node)\n'
           '\n',
 'internal_chat_message_metadata_passthrough': {'turn_id': '019f8cda-ff47-7600-bdfe-35ef1d87cc44'}}

diff --git a/evidence/provenance_check.py b/evidence/provenance_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..4dde3d6709b586f632541d02088e69354a21cccc
--- /dev/null
+++ b/evidence/provenance_check.py
@@ -0,0 +1,306 @@
+#!/usr/bin/env python3
+"""Independent provenance and mounted-tree integrity checks for this audit."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import stat
+from collections import Counter
+from pathlib import Path
+
+
+AUDIT_INPUT = Path("/audit-input.json")
+CAMPAIGN_LOCK = Path("/audit-campaign-lock.json")
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def kind(path: Path) -> str:
+    mode = path.lstat().st_mode
+    if stat.S_ISREG(mode):
+        return "file"
+    if stat.S_ISDIR(mode):
+        return "dir"
+    if stat.S_ISLNK(mode):
+        return "symlink"
+    return f"other:{stat.S_IFMT(mode):o}"
+
+
+def tree_manifest(root: Path) -> tuple[str, list[str]]:
+    """Hash an independently specified, path/type/mode/content tree manifest."""
+    records: list[str] = []
+    for path in sorted([root, *root.rglob("*")], key=lambda p: p.as_posix()):
+        rel = "." if path == root else path.relative_to(root).as_posix()
+        entry_kind = kind(path)
+        mode = stat.S_IMODE(path.lstat().st_mode)
+        if entry_kind == "file":
+            payload = sha256(path)
+        elif entry_kind == "symlink":
+            payload = os.readlink(path)
+        else:
+            payload = "-"
+        records.append(f"{entry_kind}\t{mode:04o}\t{rel}\t{payload}")
+    encoded = ("\n".join(records) + "\n").encode()
+    return hashlib.sha256(encoded).hexdigest(), records
+
+
+def compare_trees(left: Path, right: Path) -> list[str]:
+    left_entries = {
+        ("." if p == left else p.relative_to(left).as_posix()): p
+        for p in [left, *left.rglob("*")]
+    }
+    right_entries = {
+        ("." if p == right else p.relative_to(right).as_posix()): p
+        for p in [right, *right.rglob("*")]
+    }
+    issues: list[str] = []
+    for rel in sorted(set(left_entries) | set(right_entries)):
+        lp = left_entries.get(rel)
+        rp = right_entries.get(rel)
+        if lp is None:
+            issues.append(f"candidate missing {rel}")
+            continue
+        if rp is None:
+            issues.append(f"candidate additional {rel}")
+            continue
+        lk, rk = kind(lp), kind(rp)
+        if lk != rk:
+            issues.append(f"type mismatch {rel}: candidate={lk} trusted={rk}")
+            continue
+        if lk == "symlink":
+            issues.append(f"symlinked semantics entry {rel}")
+        elif lk == "file" and sha256(lp) != sha256(rp):
+            issues.append(f"content mismatch {rel}: {sha256(lp)} != {sha256(rp)}")
+    return issues
+
+
+def show_hash_check(label: str, path: Path, expected: str | None) -> bool:
+    actual = sha256(path)
+    ok = expected == actual if expected is not None else True
+    print(
+        f"HASH {label}: type={kind(path)} size={path.stat().st_size} "
+        f"actual={actual} expected={expected or 'not-recorded'} ok={ok}"
+    )
+    return ok
+
+
+def main() -> int:
+    failures: list[str] = []
+    audit = json.loads(AUDIT_INPUT.read_text())
+    lock = json.loads(CAMPAIGN_LOCK.read_text())
+
+    print(f"record_layout={audit.get('record_layout')}")
+    print(f"semantics_mode={audit.get('semantics_mode')}")
+    print(f"problem_id={audit.get('problem_id')}")
+    print(f"condition={audit.get('condition')}")
+
+    if audit.get("audit_campaign") != lock:
+        failures.append("audit_campaign object does not structurally equal campaign lock")
+    print(f"campaign_structural_match={audit.get('audit_campaign') == lock}")
+    if not show_hash_check(
+        "audit_campaign_lock",
+        CAMPAIGN_LOCK,
+        audit["hashes"].get("audit_campaign_lock_sha256"),
+    ):
+        failures.append("campaign lock hash mismatch")
+
+    required_mounts = {
+        "audit-input": AUDIT_INPUT,
+        "audit-campaign-lock": CAMPAIGN_LOCK,
+        "run": Path("/run.json"),
+        "task": Path("/task.json"),
+        "generation-result": Path("/generation-result.json"),
+        "candidate": Path(audit["container_paths"]["candidate"]),
+        "canonical": Path(audit["container_paths"]["canonical"]),
+        "trusted-prompt": Path(audit["container_paths"]["trusted_prompt"]),
+        "translator": Path(audit["container_paths"]["translator"]),
+        "generation-root": Path(audit["container_paths"]["generation_root"]),
+        "generation-invocation": Path(audit["container_paths"]["generation_manifest"]),
+        "generation-metrics": Path(audit["container_paths"]["generation_metrics"]),
+        "generation-last": Path(audit["container_paths"]["generation_last"]),
+        "generation-output": Path(audit["container_paths"]["generation_output"]),
+        "generation-trace": Path(audit["container_paths"]["generation_trace"]),
+        "generation-prompt": Path("/generation-evidence/prompt.txt"),
+    }
+    for label, path in required_mounts.items():
+        exists = path.exists()
+        readable = os.access(path, os.R_OK)
+        entry_kind = kind(path) if exists or path.is_symlink() else "missing"
+        print(f"MOUNT {label}: path={path} exists={exists} readable={readable} type={entry_kind}")
+        if not exists or not readable:
+            failures.append(f"required mount absent/unreadable: {label} {path}")
+
+    if audit.get("record_layout") != "legacy-selected-stage1":
+        failures.append(f"unexpected record layout {audit.get('record_layout')}")
+
+    required_records = [
+        Path("/generation-evidence/invocation.json"),
+        Path("/generation-evidence/metrics.json"),
+        Path("/generation-evidence/codex-last.txt"),
+        Path("/generation-evidence/codex-output.log"),
+        Path("/generation-evidence/prompt.txt"),
+    ]
+    usage = Path("/generation-evidence/usage.json")
+    if usage.exists():
+        required_records.append(usage)
+    for path in required_records:
+        if not path.is_file() or path.is_symlink() or not os.access(path, os.R_OK):
+            failures.append(f"required generation record invalid: {path}")
+        print(
+            f"RECORD {path}: exists={path.exists()} type="
+            f"{kind(path) if path.exists() or path.is_symlink() else 'missing'}"
+        )
+
+    file_hash_checks = [
+        ("canonical", Path("/reference/canonical.py"), "canonical_sha256"),
+        ("trusted-prompt", Path("/reference/prompt.py"), "trusted_prompt_sha256"),
+        ("trusted-translator", Path("/reference/py2mpy.py"), "trusted_translator_sha256"),
+        ("candidate-prompt", Path("/candidate/prompt.py"), "candidate_prompt_sha256"),
+        ("candidate-translator", Path("/candidate/py2mpy.py"), "candidate_translator_sha256"),
+        ("run", Path("/run.json"), "run_manifest_sha256"),
+        ("task", Path("/task.json"), "task_manifest_sha256"),
+        ("generation-result", Path("/generation-result.json"), "stage1_result_sha256"),
+        (
+            "generation-invocation",
+            Path("/generation-evidence/invocation.json"),
+            "stage1_invocation_sha256",
+        ),
+        ("generation-metrics", Path("/generation-evidence/metrics.json"), "generation_metrics_sha256"),
+        ("generation-last", Path("/generation-evidence/codex-last.txt"), "generation_codex_last_sha256"),
+        (
+            "generation-output",
+            Path("/generation-evidence/codex-output.log"),
+            "generation_codex_output_sha256",
+        ),
+        ("generation-prompt", Path("/generation-evidence/prompt.txt"), "generation_prompt_sha256"),
+    ]
+    if usage.exists():
+        file_hash_checks.append(
+            ("generation-usage", usage, "generation_usage_sha256")
+        )
+    for label, path, key in file_hash_checks:
+        if not show_hash_check(label, path, audit["hashes"].get(key)):
+            failures.append(f"recorded hash mismatch for {label}")
+
+    candidate = Path("/candidate")
+    candidate_symlinks = [p.relative_to(candidate).as_posix() for p in candidate.rglob("*") if p.is_symlink()]
+    print(f"candidate_symlinks={candidate_symlinks}")
+    if candidate_symlinks:
+        failures.append(f"candidate has symlinked entries: {candidate_symlinks}")
+
+    required_candidate = [
+        "prompt.py",
+        "py2mpy.py",
+        "solution.py",
+        "solution.mpy",
+        "verification.k",
+        "spec.k",
+        "prove.sh",
+        "reference-semantics",
+    ]
+    for rel in required_candidate:
+        path = candidate / rel
+        valid = path.exists() and not path.is_symlink()
+        print(f"CANDIDATE_REQUIRED {rel}: valid={valid} type={kind(path) if path.exists() else 'missing'}")
+        if not valid:
+            failures.append(f"candidate required artifact missing/mistyped/symlinked: {rel}")
+
+    if Path("/candidate/prompt.py").read_bytes() != Path("/reference/prompt.py").read_bytes():
+        failures.append("candidate prompt differs from trusted prompt")
+    if Path("/candidate/py2mpy.py").read_bytes() != Path("/reference/py2mpy.py").read_bytes():
+        failures.append("candidate translator differs from trusted translator")
+    print(
+        "candidate_prompt_matches_trusted="
+        f"{Path('/candidate/prompt.py').read_bytes() == Path('/reference/prompt.py').read_bytes()}"
