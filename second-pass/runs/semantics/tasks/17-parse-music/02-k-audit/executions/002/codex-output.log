diff --git a//tmp/audit-work/reconstruction/spec-no-bridge-context.k b//tmp/audit-work/reconstruction/spec-no-bridge-context.k
new file mode 100644
index 0000000000000000000000000000000000000000..a6c5f654d8756a82a6fa65eb735c51be1350735b
--- /dev/null
+++ b//tmp/audit-work/reconstruction/spec-no-bridge-context.k
@@ -0,0 +1,26 @@
+requires "no-bridge-observer.k"
+
+module PARSE-MUSIC-NO-BRIDGE-CONTEXT-SPEC
+  imports PARSE-MUSIC-NO-BRIDGE-OBSERVER
+
+  // Fixed supplied semantics returns a new reference and allocates split data.
+  claim
+    <k> #applyK(
+          toCall(
+            boundMethodV(
+              str(musicCodes(whole(.Music))),
+              "split")),
+          .Vals)
+         ~> #probeRef
+        => true ~> .K
+    </k>
+    <heap>
+      .Map
+      => 0 |-> list(
+           splitWS(
+             musicCodes(whole(.Music)),
+             .IntSeq,
+             .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+endmodule
