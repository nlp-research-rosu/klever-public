export PATH="/home/agent/.nix-profile/bin:$PATH"
kompile verification-body-mutant.k --backend haskell --main-module PARSE-MUSIC-BASE --syntax-module MPY-SYNTAX --output-definition body-mutant-base-kompiled 2>&1 | tee /audit-output/evidence/19-kompile-body-mutant.log
