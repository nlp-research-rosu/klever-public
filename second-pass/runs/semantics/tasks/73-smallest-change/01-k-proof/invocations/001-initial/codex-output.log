+           ref(H),
+           0,
+           vsLen(VS) -Int 1)
+       ... </k>
+       <heap> ... H |-> list(VS:ValSeq) ... </heap>
+
+  rule <k> #targetCall(helperCall, _:Val, L:Int, R:Int) => 0 ... </k>
+    requires L >=Int R
+
+  rule <k>
+         #targetCall(helperCall, ref(H:Int), L:Int, R:Int)
+       =>
+         #targetCall(helperCall, ref(H), L +Int 1, R -Int 1)
+         ~> #addMismatch(
+              notBool (
+                valSeqAt(VS, L) ==K valSeqAt(VS, R)))
+       ... </k>
+       <heap> ... H |-> list(VS:ValSeq) ... </heap>
