+    </k>
+    <env> CALLER </env>
+    <scopes>
+      (0 |-> scope(
+        ("_smallest_change" |-> #helperClosure
+         "smallest_change"  |-> #mainClosure
+         MODREST),
+        parent(-1))
+       -1 |-> builtinsScope
+       SCOPEREST)
+    =>
+      (0 |-> scope(
+        ("_smallest_change" |-> #helperClosure
+         "smallest_change"  |-> #mainClosure
+         MODREST),
+        parent(-1))
+       -1 |-> builtinsScope
+       ?FINALSCOPES)
+    </scopes>
+    <scopeLoc> NEXTSCOPE </scopeLoc>
+    <heap>
+      (H |-> list(VS) HEAPREST)
+    </heap>
+    <heapLoc> NEXTHEAP </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires NEXTSCOPE >Int 0
+     andBool freshScopes(
+       (0 |-> scope(
+          ("_smallest_change" |-> #helperClosure
+           "smallest_change"  |-> #mainClosure
+           MODREST),
+          parent(-1))
+        -1 |-> builtinsScope
+        SCOPEREST),
+       NEXTSCOPE)
