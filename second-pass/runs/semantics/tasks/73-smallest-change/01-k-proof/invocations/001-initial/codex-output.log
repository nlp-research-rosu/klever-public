+               ARR,
+               BinOp("+", L, Int(1)),
+               BinOp("-", R, Int(1))))),
+         .Stmts)
+       Return(
+         Call(
+           Name("_smallest_change"),
+           ARR,
+           BinOp("+", L, Int(1)),
+           BinOp("-", R, Int(1))))
+
+  syntax Stmts ::= #mainBodyV(Val) [function, total]
+  rule #mainBodyV(ARR:Val)
+    => Return(
+         Call(
+           Name("_smallest_change"),
+           ARR,
+           Int(0),
+           BinOp("-", Call(Name("len"), ARR), Int(1))))
+
+  syntax Val ::= "#helperClosure" [macro]
+  rule #helperClosure
+    => closureVal(("arr", "left", "right"), #helperBody, 0)
+
+  syntax Val ::= "#mainClosure" [macro]
+  rule #mainClosure
+    => closureVal(("arr"), #mainBody, 0)
