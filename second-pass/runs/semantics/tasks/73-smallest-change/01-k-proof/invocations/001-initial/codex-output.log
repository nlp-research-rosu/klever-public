diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..b2baa3cc15b90884936505b46ec9d520f0e23831
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def _smallest_change(arr, left, right):
+    if left >= right:
+        return 0
+    if arr[left] != arr[right]:
+        return 1 + _smallest_change(arr, left + 1, right - 1)
+    return _smallest_change(arr, left + 1, right - 1)
+
+
+def smallest_change(arr):
+    return _smallest_change(arr, 0, len(arr) - 1)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0879fb9527ec7038e379ec591d2999c6e1918deb
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,41 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [smallest-change-correct]:
+    <k>
+      #targetCall(KIND:TargetCall, ref(H), L, R) ~> CONT
+    =>
+      targetAnswer(KIND, VS, L, R) ~> CONT
+    </k>
+    <env> CALLER </env>
+    <scopes>
+      (0 |-> scope(
+        ("_smallest_change" |-> #helperClosure
+         "smallest_change"  |-> #mainClosure
+         MODREST),
+        parent(-1))
+       -1 |-> builtinsScope
+       SCOPEREST)
+    =>
+      (0 |-> scope(
+        ("_smallest_change" |-> #helperClosure
+         "smallest_change"  |-> #mainClosure
+         MODREST),
+        parent(-1))
+       -1 |-> builtinsScope
+       ?FINALSCOPES)
+    </scopes>
+    <scopeLoc> NEXTSCOPE </scopeLoc>
+    <heap>
+      (H |-> list(VS) HEAPREST)
+    </heap>
+    <heapLoc> NEXTHEAP </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires NEXTSCOPE >Int 0
+     andBool targetValid(KIND, VS, L, R)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e1d38004180c61f82831c76e5e8efccaad5e4227
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,131 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // These two terms are exactly the function bodies emitted in solution.mpy.
+  syntax Stmts ::= "#helperBody" [macro]
+  rule #helperBody
+    => If(
+         Compare(Name("left"), CmpOp(">=", Name("right"))),
+         Return(Int(0)),
+         .Stmts)
+       If(
+         Compare(
+           Subscript(Name("arr"), Name("left")),
+           CmpOp("!=", Subscript(Name("arr"), Name("right")))),
+         Return(
+           BinOp(
+             "+",
+             Int(1),
+             Call(
+               Name("_smallest_change"),
+               Name("arr"),
+               BinOp("+", Name("left"), Int(1)),
+               BinOp("-", Name("right"), Int(1))))),
+         .Stmts)
+       Return(
+         Call(
+           Name("_smallest_change"),
+           Name("arr"),
+           BinOp("+", Name("left"), Int(1)),
+           BinOp("-", Name("right"), Int(1))))
+
+  syntax Stmts ::= "#mainBody" [macro]
+  rule #mainBody
+    => Return(
+         Call(
+           Name("_smallest_change"),
+           Name("arr"),
+           Int(0),
+           BinOp("-", Call(Name("len"), Name("arr")), Int(1))))
+
+  syntax Val ::= "#helperClosure" [macro]
+  rule #helperClosure
+    => closureVal(("arr", "left", "right"), #helperBody, 0)
+
+  syntax Val ::= "#mainClosure" [macro]
+  rule #mainClosure
+    => closureVal(("arr"), #mainBody, 0)
+
+  // Mathematical mismatch count for the still-unchecked inclusive interval.
+  syntax Int ::= changeRange(ValSeq, Int, Int) [function]
+  rule changeRange(_:ValSeq, L:Int, R:Int) => 0
+    requires L >=Int R
+  rule changeRange(VS:ValSeq, L:Int, R:Int)
+    => (#if applyCmp("!=", valSeqAt(VS, L), valSeqAt(VS, R))
+        #then 1 #else 0 #fi)
+       +Int changeRange(VS, L +Int 1, R -Int 1)
+    requires L <Int R
+
+  // One call family covers the public wrapper and the recursive helper. This
+  // lets a single reachability claim serve as the helper's induction
+  // hypothesis while also establishing the required public entry point.
+  syntax TargetCall ::= "mainCall" | "helperCall"
+  syntax KItem ::= #targetCall(TargetCall, Val, Int, Int)
+
+  // Instrument only the two exact closures above. The following two rules
+  // replace the reference call dispatch with #targetCall; its two execution
+  // rules below are the same frame transition as MPY-CALL's closure rule.
+  // The marker provides one induction point shared by wrapper and helper.
+  rule <k>
+         #applyK(toCall(#mainClosure), (ARR:Val, .Vals))
+       =>
+         #targetCall(mainCall, ARR, 0, 0)
+       ... </k>
+    [priority(40)]
+  rule <k>
+         #applyK(
+           toCall(#helperClosure),
+           (ARR:Val, L:Int, R:Int, .Vals))
+       =>
+         #targetCall(helperCall, ARR, L, R)
+       ... </k>
+    [priority(40)]
+
+  rule <k>
+         #targetCall(mainCall, ARR:Val, _:Int, _:Int) ~> CONT
+       =>
+         #bindP(("arr"), (ARR, .Vals))
+         ~> #mainBody
+         ~> #endcall
+       </k>
+       <env> CALLER:Int => NEW </env>
+       <scopes>
+         STORE:Map => STORE [ NEW <- scope(.Map, parent(0)) ]
+       </scopes>
+       <scopeLoc> NEW:Int => NEW +Int 1 </scopeLoc>
+       <stack>
+         .List => ListItem(frame(CONT, CALLER, NEW)) ...
+       </stack>
+
+  rule <k>
+         #targetCall(helperCall, ARR:Val, L:Int, R:Int) ~> CONT
+       =>
+         #bindP(
+           ("arr", "left", "right"),
+           (ARR, L, R, .Vals))
+         ~> #helperBody
+         ~> #endcall
+       </k>
+       <env> CALLER:Int => NEW </env>
+       <scopes>
+         STORE:Map => STORE [ NEW <- scope(.Map, parent(0)) ]
+       </scopes>
+       <scopeLoc> NEW:Int => NEW +Int 1 </scopeLoc>
+       <stack>
+         .List => ListItem(frame(CONT, CALLER, NEW)) ...
+       </stack>
+
+  syntax Int ::= targetAnswer(TargetCall, ValSeq, Int, Int) [function, total]
+  rule targetAnswer(mainCall, VS:ValSeq, _:Int, _:Int)
+    => changeRange(VS, 0, vsLen(VS) -Int 1)
+  rule targetAnswer(helperCall, VS:ValSeq, L:Int, R:Int)
+    => changeRange(VS, L, R)
+
+  syntax Bool ::= targetValid(TargetCall, ValSeq, Int, Int) [function, total]
+  rule targetValid(mainCall, _:ValSeq, _:Int, _:Int) => true
+  rule targetValid(helperCall, VS:ValSeq, L:Int, R:Int)
+    => 0 <=Int L andBool L <=Int vsLen(VS)
+       andBool -1 <=Int R andBool R <Int vsLen(VS)
+endmodule

