+  rule <k>
+         #applyK(
+           toCall(#helperClosure),
+           (ARR:Val, L:Int, R:Int, .Vals))
+       =>
+         #targetCall(helperCall, ARR, L, R)
+       ... </k>
+    [priority(40)]
+
