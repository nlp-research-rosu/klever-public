+    </scopes>
+    <scopeLoc> NEXTSCOPE </scopeLoc>
+    <heap>
+      (H |-> list(VS) HEAPREST)
+    </heap>
+    <heapLoc> NEXTHEAP </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
