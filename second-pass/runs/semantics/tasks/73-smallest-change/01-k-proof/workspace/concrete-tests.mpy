Module(
  FuncDef("_smallest_change", Params("arr", "left", "right"),
    If(Compare(Name("left"), CmpOp(">=", Name("right"))),
      Return(Int(0)),
      )
    If(Compare(
      Subscript(Name("arr"), Name("left")),
      CmpOp("!=", Subscript(Name("arr"), Name("right")))),
      Return(
        BinOp(
          "+",
          Int(1),
          Call(
            Name("_smallest_change"),
            Name("arr"),
            BinOp("+", Name("left"), Int(1)),
            BinOp("-", Name("right"), Int(1))))),
      )
    Return(
      Call(
        Name("_smallest_change"),
        Name("arr"),
        BinOp("+", Name("left"), Int(1)),
        BinOp("-", Name("right"), Int(1)))))
  FuncDef("smallest_change", Params("arr"),
    Return(
      Call(
        Name("_smallest_change"),
        Name("arr"),
        Int(0),
        BinOp("-", Call(Name("len"), Name("arr")), Int(1)))))
  Assert(
    Compare(
      Call(Name("smallest_change"), ListExpr()),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("smallest_change"), ListExpr(Int(7))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("smallest_change"), ListExpr(Int(1), Int(2))),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(
        Name("smallest_change"),
        ListExpr(
          Int(1),
          Int(2),
          Int(3),
          Int(5),
          Int(4),
          Int(7),
          Int(9),
          Int(6))),
      CmpOp("==", Int(4))))
  Assert(
    Compare(
      Call(
        Name("smallest_change"),
        ListExpr(Int(1), Int(2), Int(3), Int(4), Int(3), Int(2), Int(2))),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(
        Name("smallest_change"),
        ListExpr(Int(1), Int(2), Int(3), Int(2), Int(1))),
      CmpOp("==", Int(0)))))
