+cp -a /candidate/solution.py "$scratch/solution.py"
+cp -a /candidate/solution.mpy "$scratch/solution.mpy"
+cp -a /candidate/spec.k "$scratch/spec.k"
+cp -a /candidate/verification.k "$scratch/verification.k"
