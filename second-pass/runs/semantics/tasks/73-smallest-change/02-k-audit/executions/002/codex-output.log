+
+echo 'TRANSLATE_COMMAND: python3 trusted-py2mpy.py body-mutant-concrete.py > body-mutant-concrete.mpy'
+python3 trusted-py2mpy.py body-mutant-concrete.py > body-mutant-concrete.mpy
