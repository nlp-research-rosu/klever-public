+cp -a /candidate/prove.sh "$scratch/prove.sh"
+cp -a /candidate/concrete-tests.py "$scratch/concrete-tests.py"
+cp -a /candidate/concrete-tests.mpy "$scratch/concrete-tests.mpy"
