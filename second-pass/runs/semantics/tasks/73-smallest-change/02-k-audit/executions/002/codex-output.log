diff --git a/evidence/spec-negative-model.k b/evidence/spec-negative-model.k
new file mode 100644
index 0000000000000000000000000000000000000000..413a518ae64fe9f52ba6ffb19a4e141fa3c12927
--- /dev/null
+++ b/evidence/spec-negative-model.k
@@ -0,0 +1,15 @@
+requires "verification-negative-model.k"
+
+module SPEC-NEGATIVE-MODEL
+  imports VERIFICATION-NEGATIVE-MODEL
+
+  claim [permitted-wrong-negative-index-result]:
+    <k>
+      #applyK(
+        toCall(#helperClosure),
+        (ref(0), -1, 0, .Vals))
+    =>
+      1
+    </k>
+    <heap> 0 |-> list(vCons(5, .ValSeq)) </heap>
+endmodule
