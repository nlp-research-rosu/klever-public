diff --git a/evidence/verification-negative-model.k b/evidence/verification-negative-model.k
new file mode 100644
index 0000000000000000000000000000000000000000..7252405d06e4d5a902e4ff4687d7b46d417cdad5
--- /dev/null
+++ b/evidence/verification-negative-model.k
@@ -0,0 +1,9 @@
+requires "verification.k"
+
+module VERIFICATION-NEGATIVE-MODEL
+  imports VERIFICATION
+
+  // Model completion permitted by the candidate target rule: unlike fixed
+  // Subscript semantics, its raw valSeqAt(VS, -1) has no defining equation.
+  rule valSeqAt(vCons(5, .ValSeq), -1) => 6
+endmodule

