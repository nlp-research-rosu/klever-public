{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 21,
      "module": "FIB-VERIFICATION",
      "normalized_sha256": "951beb64fbce92e456fcd1184e719112a1dfae8f2920b4e92ea537317f07c8c5",
      "rationale": "Expands the named fibBody proof term into the translated Python function body; it is a macro-style program representation, not an additional fact.",
      "source_rule_id": "rule-951beb64fbce92e456fcd1184e719112a1dfae8f2920b4e92ea537317f07c8c5",
      "start_line": 10,
      "text": "  rule fibBody =>\n    Expr(\n      Str(\n        \"Return n-th Fibonacci number.\\n    >>> fib(10)\\n    55\\n    >>> fib(1)\\n    1\\n    >>> fib(8)\\n    21\\n    \"))\n    Assign(Name(\"a\"), Int(0))\n    Assign(Name(\"b\"), Int(1))\n    Assign(Name(\"_\"), Int(0))\n    For(Name(\"_\"), Call(Name(\"range\"), Name(\"n\")),\n      Assign(\n        TupleExpr(Name(\"a\"), Name(\"b\")),\n        TupleExpr(Name(\"b\"), BinOp(\"+\", Name(\"a\"), Name(\"b\")))))\n    Return(Name(\"a\"))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 24,
      "module": "FIB-VERIFICATION",
      "normalized_sha256": "b493b8e29897cc7c9832cedd71cf42347ac6c23cc41617ee3267d644fcb82fa4",
      "rationale": "Defines the named fibClosure value from the parameter list, fibBody, and module environment location.",
      "source_rule_id": "rule-b493b8e29897cc7c9832cedd71cf42347ac6c23cc41617ee3267d644fcb82fa4",
      "start_line": 23,
      "text": "  rule fibClosure =>\n    closureVal((\"n\", .ParamNames), fibBody, 0)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 27,
      "module": "FIB-VERIFICATION",
      "normalized_sha256": "3c19c1ace444c19fcd0440bc740ffbe7c0b8d126b80d72d81a12abde7a68205c",
      "rationale": "Defines the named fibProgram module term containing the translated fib function definition.",
      "source_rule_id": "rule-3c19c1ace444c19fcd0440bc740ffbe7c0b8d126b80d72d81a12abde7a68205c",
      "start_line": 26,
      "text": "  rule fibProgram =>\n    Module(FuncDef(\"fib\", Params(\"n\"), fibBody))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "FIB-VERIFICATION",
      "normalized_sha256": "0cfc2191eeac25cc4298d7ecca5a92d3f57f7715af391c09d3156408ff6479f1",
      "rationale": "Gives the terminating equation of the mathematical fibRun summary when the iteration index has reached or passed its bound.",
      "source_rule_id": "rule-0cfc2191eeac25cc4298d7ecca5a92d3f57f7715af391c09d3156408ff6479f1",
      "start_line": 34,
      "text": "  rule fibRun(A:Int, _:Int, I:Int, N:Int) => A\n    requires I >=Int N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 39,
      "module": "FIB-VERIFICATION",
      "normalized_sha256": "8386dc93afab6158fba2ead31c4b2fbee2813be9182a6f184fca09c3dd0f7026",
      "rationale": "Gives the recursive equation of the mathematical fibRun summary for one Fibonacci-state transition before the bound.",
      "source_rule_id": "rule-8386dc93afab6158fba2ead31c4b2fbee2813be9182a6f184fca09c3dd0f7026",
      "start_line": 37,
      "text": "  rule fibRun(A:Int, B:Int, I:Int, N:Int)\n    => fibRun(B, A +Int B, I +Int 1, N)\n    requires I <Int N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 41,
      "module": "FIB-VERIFICATION",
      "normalized_sha256": "aefa2ce110bb5a36b28fe6339c0379ad6d3bccd04b6da20c57f6208b69da53ee",
      "rationale": "Defines fibSpec as the fibRun summary initialized with the standard Fibonacci state (0, 1, 0).",
      "source_rule_id": "rule-aefa2ce110bb5a36b28fe6339c0379ad6d3bccd04b6da20c57f6208b69da53ee",
      "start_line": 41,
      "text": "  rule fibSpec(N:Int) => fibRun(0, 1, 0, N)"
    }
  ],
