+  claim [fib-all-natural]:
+    <k>
+      #loadAll(fibProgram) ~> Call(Name("fib"), Int(N:Int))
+      =>
+      fibSpec(N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("fib" |-> fibClosure, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+    [depends(FIB-SPEC.fib-loop)]
+endmodule
