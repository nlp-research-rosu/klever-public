diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..90e210a1e0d3d6b429fd86e8b5aae12287f68c50
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def fib(n: int):
+    """Return n-th Fibonacci number.
+    >>> fib(10)
+    55
+    >>> fib(1)
+    1
+    >>> fib(8)
+    21
+    """
+    a = 0
+    b = 1
+    for _ in range(n):
+        a, b = b, a + b
+    return a
