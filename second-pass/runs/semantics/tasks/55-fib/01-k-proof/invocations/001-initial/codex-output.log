+    requires N >=Int 0
+     andBool notBool NEXT in_keys(
+       REST
+       0 |-> scope(("fib" |-> fibClosure) GLOBALS, PARENT))
+    [circularity]
+
+  claim [fib-zero]:
+    <k> #loadAll(fibProgram) ~> Call(Name("fib"), Int(0)) => 0 </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("fib" |-> fibClosure, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
