+          TupleExpr(Name("b"), BinOp("+", Name("a"), Name("b")))))
+      ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (REST:Map
+       L |-> scope(
+         ("n" |-> N
+          "a" |-> A:Int
+          "b" |-> B:Int
+          "_" |-> OLD_INDEX:Int),
+         parent(0)))
+      =>
+      (REST
+       L |-> scope(
+         ("n" |-> N
+          "a" |-> fibRun(A, B, I, N)
+          "b" |-> ?FINAL_B:Int
+          "_" |-> ?FINAL_INDEX:Int),
+         parent(0)))
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPNEXT:Int </heapLoc>
