+requires "verification.k"
+
+module FIB-SPEC
+  imports FIB-VERIFICATION
+
+  claim [fib-zero]:
+    <k> #loadAll(fibProgram) ~> Call(Name("fib"), Int(0)) => 0 </k>
+
+  claim [fib-one]:
+    <k> #loadAll(fibProgram) ~> Call(Name("fib"), Int(1)) => 1 </k>
+
+  claim [fib-eight]:
+    <k> #loadAll(fibProgram) ~> Call(Name("fib"), Int(8)) => 21 </k>
+
+  claim [fib-ten]:
+    <k> #loadAll(fibProgram) ~> Call(Name("fib"), Int(10)) => 55 </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..3f71b842845baf695666e9b136613da1ef401fad
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,30 @@
+requires "reference-semantics/semantics.k"
+
+module FIB-VERIFICATION
+  imports MPY
+
+  syntax Module ::= "fibProgram" [function]
+
+  rule fibProgram =>
+    Module(
+      FuncDef("fib", Params("n"),
+        Expr(
+          Str(
+            "Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    "))
+        If(Compare(Name("n"), CmpOp("<=", Int(1))),
+          Return(Name("n")),
+          .Stmts)
+        Return(
+          BinOp(
+            "+",
+            Call(Name("fib"), BinOp("-", Name("n"), Int(1))),
+            Call(Name("fib"), BinOp("-", Name("n"), Int(2)))))))
+
+  syntax Int ::= fibSpec(Int) [function]
+
+  rule fibSpec(N:Int) => N
+    requires N <=Int 1
+
+  rule fibSpec(N:Int) => fibSpec(N -Int 1) +Int fibSpec(N -Int 2)
+    requires N >Int 1
+endmodule

