diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..596ba7bb48aeace5b7e7d917223566454cd3ad75
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,123 @@
+requires "reference-semantics/semantics.k"
+
+module FIB-VERIFICATION
+  imports MPY
+
+  syntax Stmts ::= "fibBody" [function]
+  syntax Val ::= "fibClosure" [function]
+  syntax Module ::= "fibProgram" [function]
+
+  rule fibBody =>
+    Expr(
+      Str(
+        "Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    "))
+    If(Compare(Name("n"), CmpOp("<=", Int(1))),
+      Return(Name("n")),
+      .Stmts)
+    Return(
+      BinOp(
+        "+",
+        Call(Name("fib"), BinOp("-", Name("n"), Int(1))),
+        Call(Name("fib"), BinOp("-", Name("n"), Int(2)))))
+
+  rule fibClosure =>
+    closureVal(("n", .ParamNames), fibBody, 0)
+
+  rule fibProgram =>
+    Module(FuncDef("fib", Params("n"), fibBody))
+
+  syntax Int ::= fibSpec(Int) [function]
+
+  rule fibSpec(N:Int) => N
+    requires N <=Int 1
+
+  rule fibSpec(N:Int) => fibSpec(N -Int 1) +Int fibSpec(N -Int 2)
+    requires N >Int 1
+
+  // The operational rules in the reference semantics match scope-map entries
+  // structurally. Recursive symbolic calls leave those entries under a
+  // symbolic Map update, so these equivalent lookup/update rules expose the
+  // same plain-frame operations through the Map lookup function.
+  syntax Map ::= scopeBindings(Scope) [function, total]
+  syntax Parent ::= scopeParent(Scope) [function, total]
+  syntax Scope ::= putPlain(Scope, String, Val) [function, total]
+
+  rule scopeBindings(scope(M:Map, _:Parent)) => M
+  rule scopeParent(scope(_:Map, P:Parent)) => P
+  rule putPlain(scope(M:Map, P:Parent), X:String, V:Val)
+    => scope(M [ X <- V ], P)
+
+  rule <k>
+         #bindP((P:String, PS:ParamNames), (V:Val, VS:Vals))
+         =>
+         #bindP(PS, VS)
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         BASE:Map [ L <- scope(.Map, PAR:Parent) ]
+         =>
+         BASE [ L <- scope(P |-> V, PAR) ]
+       </scopes>
+    [priority(42), simplification]
+
+  rule <k>
+         #bindP((P:String, PS:ParamNames), (V:Val, VS:Vals))
+         =>
+         #bindP(PS, VS)
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         SC:Map
+         =>
+         SC [ L <- putPlain({SC[L]}:>Scope, P, V) ]
+       </scopes>
+    requires L in_keys(SC)
+     andBool notBool ("$cells" in_keys(
+       scopeBindings({SC[L]}:>Scope)))
+    [priority(45)]
+
+  syntax KItem ::= #lookMap(String, Int, Map)
+
+  rule <k> #look(X:String, L:Int) => #lookMap(X, L, SC) ... </k>
+       <scopes> SC:Map </scopes>
+    [priority(45)]
+
+  rule #lookMap(X:String, L:Int,
+         BASE:Map [ L <- scope(M:Map, _:Parent) ])
+    => {M[X]}:>Val
+    requires notBool ("$cells" in_keys(M))
+     andBool X in_keys(M)
+    [simplification]
+
+  rule #lookMap(X:String, L:Int,
+         BASE:Map [ L <- scope(M:Map, parent(P:Int)) ])
+    => #lookMap(X, P, BASE)
+    requires notBool ("$cells" in_keys(M))
+     andBool notBool X in_keys(M)
+    [simplification]
+
+  rule #lookMap(X:String, L:Int,
+         BASE:Map [ OTHER:Int <- _:Scope ])
+    => #lookMap(X, L, BASE)
+    requires L =/=Int OTHER
+    [simplification]
+
+  rule #lookMap(X:String, L:Int,
+         (REST:Map L |-> scope(M:Map, _:Parent)))
+    => {M[X]}:>Val
+    requires notBool ("$cells" in_keys(M))
+     andBool X in_keys(M)
+
+  rule #lookMap(X:String, L:Int,
+         (REST:Map L |-> scope(M:Map, parent(P:Int))))
+    => #lookMap(
+         X, P, REST L |-> scope(M, parent(P)))
+    requires notBool ("$cells" in_keys(M))
+     andBool notBool X in_keys(M)
+
+  syntax Bool ::= hasParent(Parent) [function, total]
+  syntax Int ::= parentLoc(Parent) [function]
+  rule hasParent(parent(_:Int)) => true
+  rule hasParent(root) => false
+  rule parentLoc(parent(L:Int)) => L
+endmodule

