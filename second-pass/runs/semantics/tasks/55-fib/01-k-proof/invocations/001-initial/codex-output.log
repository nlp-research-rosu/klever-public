diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..31a8e85c0661788365af354dfff65156241ed18b
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,72 @@
+requires "verification.k"
+
+module FIB-SPEC
+  imports FIB-VERIFICATION
+
+  // Loop invariant:
+  //   a = F(I), b = F(I + 1), with I iterations already completed.
+  claim [fib-loop]:
+    <k>
+      #loop(
+        rangeObj(I:Int, N:Int, 1),
+        Name("_"),
+        Assign(
+          TupleExpr(Name("a"), Name("b")),
+          TupleExpr(Name("b"), BinOp("+", Name("a"), Name("b")))))
+      =>
+      .K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (REST:Map
+       L |-> scope(
+         ("n" |-> N
+          "a" |-> fibSpec(I)
+          "b" |-> fibSpec(I +Int 1)
+          LOCALS:Map),
+         parent(0)))
+      =>
+      (REST
+       L |-> scope(
+         ("n" |-> N
+          "a" |-> fibSpec(N)
+          "b" |-> fibSpec(N +Int 1)
+          FINAL-LOCALS:Map),
+         parent(0)))
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPNEXT:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> RET:RetState </ret>
+    <exc> EXC:Exc </exc>
+    <exit-code> EXIT:Int </exit-code>
+    requires I >=Int 0 andBool I <=Int N
+    [circularity]
+
+  // For every natural-number input, running the translated function returns
+  // the mathematical Fibonacci value.
+  claim [fib-all-natural]:
+    <k>
+      #loadAll(fibProgram) ~> Call(Name("fib"), Int(N:Int))
+      =>
+      fibSpec(N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("fib" |-> fibClosure, parent(-1))
