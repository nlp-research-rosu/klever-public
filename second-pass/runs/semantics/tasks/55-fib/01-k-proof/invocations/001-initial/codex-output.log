@@ -0,0 +1,42 @@
+requires "reference-semantics/semantics.k"
+
+module FIB-VERIFICATION
+  imports MPY
+
+  syntax Stmts ::= "fibBody" [function]
+  syntax Val ::= "fibClosure" [function]
+  syntax Module ::= "fibProgram" [function]
+
+  rule fibBody =>
+    Expr(
+      Str(
+        "Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    "))
+    Assign(Name("a"), Int(0))
+    Assign(Name("b"), Int(1))
+    Assign(Name("_"), Int(0))
+    For(Name("_"), Call(Name("range"), Name("n")),
+      Assign(
+        TupleExpr(Name("a"), Name("b")),
+        TupleExpr(Name("b"), BinOp("+", Name("a"), Name("b")))))
+    Return(Name("a"))
+
+  rule fibClosure =>
+    closureVal(("n", .ParamNames), fibBody, 0)
+
+  rule fibProgram =>
+    Module(FuncDef("fib", Params("n"), fibBody))
+
+  // A mathematical tail-recursive Fibonacci fold. Starting from
+  // (A,B,I) = (0,1,0), it returns the N-th Fibonacci number.
+  syntax Int ::= fibRun(Int, Int, Int, Int) [function, total]
+  syntax Int ::= fibSpec(Int) [function, total]
+
+  rule fibRun(A:Int, _:Int, I:Int, N:Int) => A
+    requires I >=Int N
+
+  rule fibRun(A:Int, B:Int, I:Int, N:Int)
+    => fibRun(B, A +Int B, I +Int 1, N)
+    requires I <Int N
+
+  rule fibSpec(N:Int) => fibRun(0, 1, 0, N)
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..3eb6fffb06d0979a3db8554eaa580eaf985186a5
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,15 @@
+def fib(n: int):
+    """Return n-th Fibonacci number.
+    >>> fib(10)
+    55
+    >>> fib(1)
+    1
+    >>> fib(8)
+    21
+    """
+    a = 0
+    b = 1
+    _ = 0
+    for _ in range(n):
+        a, b = b, a + b
+    return a
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2504a7282a713d70d38def089d44e9c0d2554451
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,71 @@
+requires "verification.k"
+
+module FIB-SPEC
+  imports FIB-VERIFICATION
+
+  // The result of the remaining loop is the mathematical fold fibRun.
+  claim [fib-loop]:
+    <k>
+      #loop(
+        rangeObj(I:Int, N:Int, 1),
+        Name("_"),
+        Assign(
+          TupleExpr(Name("a"), Name("b")),
+          TupleExpr(Name("b"), BinOp("+", Name("a"), Name("b")))))
+      ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (REST:Map
+       L |-> scope(
+         ("n" |-> N
+          "a" |-> A:Int
+          "b" |-> B:Int
+          "_" |-> OLD_INDEX:Int),
+         parent(0)))
+      =>
+      (REST
+       L |-> scope(
+         ("n" |-> N
+          "a" |-> fibRun(A, B, I, N)
+          "b" |-> ?FINAL_B:Int
+          "_" |-> ?FINAL_INDEX:Int),
+         parent(0)))
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPNEXT:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> RET:RetState </ret>
+    <exc> EXC:Exc </exc>
+    <exit-code> EXIT:Int </exit-code>
+    [circularity]
+
+  // For every natural-number input, running the translated function returns
+  // the mathematical Fibonacci value.
+  claim [fib-all-natural]:
+    <k>
+      #loadAll(fibProgram) ~> Call(Name("fib"), Int(N:Int))
+      =>
+      fibSpec(N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("fib" |-> fibClosure, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+    [depends(FIB-SPEC.fib-loop)]
+endmodule
