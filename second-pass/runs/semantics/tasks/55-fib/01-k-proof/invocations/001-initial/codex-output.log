diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ff7ecc59ab6824b30a9efe5e6659b97c27f6f587
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,36 @@
+requires "reference-semantics/semantics.k"
+
+module FIB-VERIFICATION
+  imports MPY
+
+  syntax Stmts ::= "fibBody" [function]
+  syntax Val ::= "fibClosure" [function]
+  syntax Module ::= "fibProgram" [function]
+
+  rule fibBody =>
+    Expr(
+      Str(
+        "Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    "))
+    If(Compare(Name("n"), CmpOp("<=", Int(1))),
+      Return(Name("n")),
+      .Stmts)
+    Return(
+      BinOp(
+        "+",
+        Call(Name("fib"), BinOp("-", Name("n"), Int(1))),
+        Call(Name("fib"), BinOp("-", Name("n"), Int(2)))))
+
+  rule fibClosure =>
+    closureVal(("n", .ParamNames), fibBody, 0)
+
+  rule fibProgram =>
+    Module(FuncDef("fib", Params("n"), fibBody))
+
+  syntax Int ::= fibSpec(Int) [function]
+
+  rule fibSpec(N:Int) => N
+    requires N <=Int 1
+
+  rule fibSpec(N:Int) => fibSpec(N -Int 1) +Int fibSpec(N -Int 2)
+    requires N >Int 1
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module FIB-VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /work
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..fc5c68104a624c3e46595b4465e7fca54c96da80
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def fib(n: int):
+    """Return n-th Fibonacci number.
+    >>> fib(10)
+    55
+    >>> fib(1)
+    1
+    >>> fib(8)
+    21
+    """
+    if n <= 1:
+        return n
+    return fib(n - 1) + fib(n - 2)
