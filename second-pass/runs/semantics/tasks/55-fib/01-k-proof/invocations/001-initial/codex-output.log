index 0000000000000000000000000000000000000000..fc8097e46df46ed298bd02aef5c1961933a6de73
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,42 @@
+requires "reference-semantics/semantics.k"
+
+module FIB-VERIFICATION
+  imports MPY
+
+  syntax Stmts ::= "fibBody" [function]
+  syntax Val ::= "fibClosure" [function]
+  syntax Module ::= "fibProgram" [function]
+
+  rule fibBody =>
+    Expr(
+      Str(
+        "Return n-th Fibonacci number.\n    >>> fib(10)\n    55\n    >>> fib(1)\n    1\n    >>> fib(8)\n    21\n    "))
+    Assign(Name("a"), Int(0))
+    Assign(Name("b"), Int(1))
+    For(Name("_"), Call(Name("range"), Name("n")),
+      Assign(
+        TupleExpr(Name("a"), Name("b")),
+        TupleExpr(Name("b"), BinOp("+", Name("a"), Name("b")))))
+    Return(Name("a"))
+
+  rule fibClosure =>
+    closureVal(("n", .ParamNames), fibBody, 0)
+
+  rule fibProgram =>
+    Module(FuncDef("fib", Params("n"), fibBody))
+
+  // Mathematical Fibonacci, used only in claims and loop invariants.
+  syntax Int ::= fibSpec(Int) [function, total]
+
+  rule fibSpec(N:Int) => N
+    requires N <=Int 1
+
+  rule fibSpec(N:Int) => fibSpec(N -Int 1) +Int fibSpec(N -Int 2)
+    requires N >Int 1
+
+  // Canonicalize the negated range guard to a direct arithmetic inequality.
+  // This is valid over mathematical integers and keeps the endpoint equality
+  // visible to the SMT solver in the loop proof.
+  rule notBool (I:Int <Int N:Int) => I >=Int N
+    [simplification]
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..90e210a1e0d3d6b429fd86e8b5aae12287f68c50
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def fib(n: int):
+    """Return n-th Fibonacci number.
+    >>> fib(10)
+    55
+    >>> fib(1)
+    1
+    >>> fib(8)
+    21
+    """
+    a = 0
+    b = 1
+    for _ in range(n):
+        a, b = b, a + b
+    return a
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0ad84527caed08710d27e47677291ee02f7cfad1
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,72 @@
+requires "verification.k"
+
+module FIB-SPEC
+  imports FIB-VERIFICATION
+
+  // Loop invariant:
+  //   a = F(I), b = F(I + 1), with I iterations already completed.
+  claim [fib-loop]:
+    <k>
+      #loop(
+        rangeObj(I:Int, N:Int, 1),
+        Name("_"),
+        Assign(
+          TupleExpr(Name("a"), Name("b")),
+          TupleExpr(Name("b"), BinOp("+", Name("a"), Name("b")))))
+      =>
+      .K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (REST:Map
+       L |-> scope(
+         ("n" |-> N
+          "a" |-> fibSpec(I)
+          "b" |-> fibSpec(I +Int 1)
+          LOCALS:Map),
+         parent(0)))
+      =>
+      (REST
+       L |-> scope(
+         ("n" |-> N
+          "a" |-> fibSpec(N)
+          "b" |-> fibSpec(N +Int 1)
+          ?FINAL_LOCALS:Map),
+         parent(0)))
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPNEXT:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> RET:RetState </ret>
+    <exc> EXC:Exc </exc>
+    <exit-code> EXIT:Int </exit-code>
+    requires I >=Int 0 andBool I <=Int N
+    [circularity]
+
+  // For every natural-number input, running the translated function returns
+  // the mathematical Fibonacci value.
+  claim [fib-all-natural]:
+    <k>
+      #loadAll(fibProgram) ~> Call(Name("fib"), Int(N:Int))
+      =>
+      fibSpec(N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("fib" |-> fibClosure, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+    [depends(FIB-SPEC.fib-loop)]
+endmodule
