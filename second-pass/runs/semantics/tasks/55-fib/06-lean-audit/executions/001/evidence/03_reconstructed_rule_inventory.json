      "attributes": [],
      "text": "  rule fibBody =>\n    Expr(\n      Str(\n        \"Return n-th Fibonacci number.\\n    >>> fib(10)\\n    55\\n    >>> fib(1)\\n    1\\n    >>> fib(8)\\n    21\\n    \"))\n    Assign(Name(\"a\"), Int(0))\n    Assign(Name(\"b\"), Int(1))\n    Assign(Name(\"_\"), Int(0))\n    For(Name(\"_\"), Call(Name(\"range\"), Name(\"n\")),\n      Assign(\n        TupleExpr(Name(\"a\"), Name(\"b\")),\n        TupleExpr(Name(\"b\"), BinOp(\"+\", Name(\"a\"), Name(\"b\")))))\n    Return(Name(\"a\"))"
    },
    {
      "source_rule_id": "rule-b493b8e29897cc7c9832cedd71cf42347ac6c23cc41617ee3267d644fcb82fa4",
      "module": "FIB-VERIFICATION",
      "start_line": 23,
      "end_line": 24,
      "normalized_sha256": "b493b8e29897cc7c9832cedd71cf42347ac6c23cc41617ee3267d644fcb82fa4",
      "attributes": [],
      "text": "  rule fibClosure =>\n    closureVal((\"n\", .ParamNames), fibBody, 0)"
    },
    {
      "source_rule_id": "rule-3c19c1ace444c19fcd0440bc740ffbe7c0b8d126b80d72d81a12abde7a68205c",
      "module": "FIB-VERIFICATION",
      "start_line": 26,
      "end_line": 27,
      "normalized_sha256": "3c19c1ace444c19fcd0440bc740ffbe7c0b8d126b80d72d81a12abde7a68205c",
      "attributes": [],
      "text": "  rule fibProgram =>\n    Module(FuncDef(\"fib\", Params(\"n\"), fibBody))"
    },
    {
