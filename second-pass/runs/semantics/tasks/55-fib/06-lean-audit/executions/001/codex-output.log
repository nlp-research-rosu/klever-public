/reference/k-proof/reference-semantics/semantics/comprehension.k-14-  syntax Stmts ::= compBody(CompFors, Expr) [macro]
/reference/k-proof/reference-semantics/semantics/comprehension.k-15-  rule compBody(Gs:CompFors, ELT:Expr)
/reference/k-proof/reference-semantics/semantics/comprehension.k:16:    => Assign(Name("$acc"), ListExpr(.Exprs)) compNest(Gs, ELT) Return(Name("$acc"))
/reference/k-proof/reference-semantics/semantics/comprehension.k-17-
/reference/k-proof/reference-semantics/semantics/comprehension.k-18-  syntax Stmt ::= compNest(CompFors, Expr) [macro-rec]
/reference/k-proof/reference-semantics/semantics/comprehension.k-19-  rule compNest(.CompFors, ELT:Expr)
/reference/k-proof/reference-semantics/semantics/comprehension.k:20:    => Assign(Name("$acc"), BinOp("+", Name("$acc"), ListExpr(ELT)))
/reference/k-proof/reference-semantics/semantics/comprehension.k:21:  rule compNest((CompFor(T:Expr, ITER:Expr, Fs:Exprs) GRest:CompFors), ELT:Expr)
/reference/k-proof/reference-semantics/semantics/comprehension.k:22:    => For(T, ITER, If(compGuard(Fs), compNest(GRest, ELT), .Stmts))
/reference/k-proof/reference-semantics/semantics/comprehension.k-23-
/reference/k-proof/reference-semantics/semantics/comprehension.k-24-  syntax Expr ::= compGuard(Exprs) [macro]
/reference/k-proof/reference-semantics/semantics/comprehension.k-25-  rule compGuard(.Exprs)             => Bool(true)
