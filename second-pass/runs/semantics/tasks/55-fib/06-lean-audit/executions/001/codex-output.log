codex
I found the concrete cause: this sandbox reports namespace PID `2` to `getpid()` while `/proc` is mounted with host PIDs, so Lean 4.22’s `IO.appPath` tries `/proc/2/exe` and fails. `/proc/self/exe` works. I’m applying a narrowly scoped runtime shim that only redirects numeric `/proc/<pid>/exe` `readlink` calls to `/proc/self/exe`, restoring Lean’s intended executable-path lookup. I’ll hash and preserve the shim source/binary and rerun the unchanged trusted preflight.
apply patch
patch: completed
/tmp/audit-work/lean_proc_exe_shim.c
diff --git a//tmp/audit-work/lean_proc_exe_shim.c b//tmp/audit-work/lean_proc_exe_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..5834ed4b008604e97fe914c30310bf6d18e5318c
--- /dev/null
+++ b//tmp/audit-work/lean_proc_exe_shim.c
@@ -0,0 +1,28 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+
+  const char *prefix = "/proc/";
+  const char *cursor = path;
+  if (strncmp(cursor, prefix, strlen(prefix)) == 0) {
+    cursor += strlen(prefix);
+    const char *digits = cursor;
+    while (*cursor >= '0' && *cursor <= '9') {
+      cursor++;
+    }
+    if (cursor != digits && strcmp(cursor, "/exe") == 0) {
+      path = "/proc/self/exe";
+    }
+  }
+  return real_readlink(path, buffer, size);
+}
