/bin/bash -lc "python3 - <<'PY' | tee /audit-output/evidence/07_stage3_bijection_and_hash_checks.txt
from pathlib import Path
import hashlib, json
inv=json.loads(Path('/audit-output/evidence/03_reconstructed_rule_inventory.json').read_text())
disc=json.loads(Path('/reference/lemma-discovery.json').read_text())
source=Path('/reference/k-proof/verification.k').read_text()
lines=source.splitlines()
checks=[]
def check(label, ok, detail=''):
    checks.append(ok)
    print(f'{label}: {\"PASS\" if ok else \"FAIL\"}{(\" — \"+detail) if detail else \"\"}')
check('schema v2', inv['schema_version']==2 and disc['schema_version']==2)
check('verification source SHA-256', hashlib.sha256(Path('/reference/k-proof/verification.k').read_bytes()).hexdigest()==inv['verification_sha256'], inv['verification_sha256'])
canonical=hashlib.sha256(json.dumps(inv['rules'],sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
check('whole inventory SHA-256 recomputation', canonical==inv['inventory_sha256']==disc['inventory_sha256'], canonical)
inv_ids=[r['source_rule_id'] for r in inv['rules']]
disc_ids=[r['source_rule_id'] for r in disc['rules']]
check('six inventory entries', len(inv_ids)==6, str(len(inv_ids)))
check('six classified entries', len(disc_ids)==6, str(len(disc_ids)))
check('inventory IDs unique', len(set(inv_ids))==len(inv_ids))
check('classification IDs unique', len(set(disc_ids))==len(disc_ids))
check('exact ID set bijection', set(inv_ids)==set(disc_ids))
check('exact source-order identity', inv_ids==disc_ids)
for n,r in enumerate(inv['rules'],1):
    span='\\n'.join(lines[r['start_line']-1:r['end_line']])
    digest=hashlib.sha256(' '.join(span.split()).encode()).hexdigest()
    text_ok=span==r['text']
    digest_ok=digest==r['normalized_sha256'] and r['source_rule_id']=='rule-'+digest
    print(f'rule {n} span {r[\"start_line\"]}-{r[\"end_line\"]}: {\"PASS\" if text_ok else \"FAIL\"} exact source text')
    print(f'rule {n} normalized/source ID: {\"PASS\" if digest_ok else \"FAIL\"} {digest}')
    checks += [text_ok,digest_ok]
classifications=[r['classification'] for r in disc['rules']]
check('all classifications accounted', len(classifications)==len(inv_ids))
check('all classifications are DEFINITION', classifications==['DEFINITION']*6, repr(classifications))
check('no simplification attributes', all('simplification' not in r['attributes'] for r in inv['rules']))
print('OVERALL:', 'PASS' if all(checks) else 'FAIL')
