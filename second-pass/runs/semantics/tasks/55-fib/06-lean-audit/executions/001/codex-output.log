+#include <stdio.h>
+#include <stddef.h>
+
+int uv_exepath(char *buffer, size_t *size);
+const char *uv_err_name(int err);
+
+int main(void) {
+  char path[4096];
+  size_t size = sizeof(path);
+  int code = uv_exepath(path, &size);
+  printf("code=%d name=%s size=%zu path=%s\n",
+         code, uv_err_name(code), size, code == 0 ? path : "");
+  return code == 0 ? 0 : 1;
+}
