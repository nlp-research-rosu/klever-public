index 0000000000000000000000000000000000000000..57283fefc86a8c597a0bb2e06b506ee1f230ed43
--- /dev/null
+++ b/evidence/concrete_audit.py
@@ -0,0 +1,23 @@
+def fib(n: int):
+    """Return n-th Fibonacci number.
+    >>> fib(10)
+    55
+    >>> fib(1)
+    1
+    >>> fib(8)
+    21
+    """
+    a = 0
+    b = 1
+    _ = 0
+    for _ in range(n):
+        a, b = b, a + b
+    return a
+
+
+assert fib(0) == 0
+assert fib(1) == 1
+assert fib(2) == 1
+assert fib(8) == 21
+assert fib(10) == 55
+assert fib(20) == 6765
