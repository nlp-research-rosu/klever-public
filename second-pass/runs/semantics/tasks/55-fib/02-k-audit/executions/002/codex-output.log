+  claim [fib-loop]:
+    <k>
+      #loop(
+        rangeObj(I:Int, N:Int, 1),
+        Name("_"),
+        Assign(
+          TupleExpr(Name("a"), Name("b")),
+          TupleExpr(Name("b"), BinOp("+", Name("a"), Name("b")))))
+      ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (REST:Map
+       L |-> scope(
+         ("n" |-> N
+          "a" |-> A:Int
+          "b" |-> B:Int
+          "_" |-> OLD_INDEX:Int),
+         parent(0)))
+      =>
+      (REST
+       L |-> scope(
