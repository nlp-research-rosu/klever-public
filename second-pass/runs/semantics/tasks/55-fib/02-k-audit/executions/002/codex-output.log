diff --git a/evidence/concrete_audit.py b/evidence/concrete_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..8f4e6243834b2514d403538609e8aeb8cbf5b3b4
--- /dev/null
+++ b/evidence/concrete_audit.py
@@ -0,0 +1,23 @@
+def fib(n: int):
+    """Return n-th Fibonacci number.
+    >>> fib(10)
+    55
+    >>> fib(1)
+    1
+    >>> fib(8)
+    21
+    """
+    a = 0
+    b = 1
+    _ = 0
+    for _ in range(n):
+        a, b = b, a + b
+    return a
+
+
+assert fib(0) == 0
+assert fib(1) == 1
+assert fib(2) == 1
+assert fib(8) == 21
+assert fib(10) == 55
+assert fib(30) == 832040
