Concrete LLVM execution now passes six assertions, including both prompt examples, zero, negative all-even, all-odd, and a mixed number containing zeros. The symbolic proof is split deliberately: first the loop invariant is proved without any summary rule available; only then is that proved summary enabled to establish the arbitrary-integer entry-point theorem.
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..e41ef4b53c6ad7387673e9fd6cd777129c8ffe4c
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,19 @@
+def even_odd_count(num):
+    """Return the counts of even and odd decimal digits in num."""
+    even_count = 0
+    odd_count = 0
+    digit = 0
+    for digit in str(abs(num)):
+        if ord(digit) % 2 == 0:
+            even_count += 1
+        else:
+            odd_count += 1
+    return (even_count, odd_count)
+
+
+assert even_odd_count(-12) == (1, 1)
+assert even_odd_count(123) == (1, 2)
+assert even_odd_count(0) == (1, 0)
+assert even_odd_count(-24680) == (5, 0)
+assert even_odd_count(13579) == (0, 5)
+assert even_odd_count(102030405) == (6, 3)
