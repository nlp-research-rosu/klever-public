Module(
  FuncDef("even_odd_count", Params("num"),
    Expr(
      Str("Return the counts of even and odd decimal digits in num."))
    Assign(Name("even_count"), Int(0))
    Assign(Name("odd_count"), Int(0))
    Assign(Name("digit"), Int(0))
    For(Name("digit"), Call(Name("str"), Call(Name("abs"), Name("num"))),
      If(Compare(
        BinOp("%", Call(Name("ord"), Name("digit")), Int(2)),
        CmpOp("==", Int(0))),
        AugAssign(Name("even_count"), "+", Int(1)),
        AugAssign(Name("odd_count"), "+", Int(1))))
    Return(TupleExpr(Name("even_count"), Name("odd_count"))))
  Assert(
    Compare(
      Call(Name("even_odd_count"), UnaryOp("-", Int(12))),
      CmpOp("==", TupleExpr(Int(1), Int(1)))))
  Assert(
    Compare(
      Call(Name("even_odd_count"), Int(123)),
      CmpOp("==", TupleExpr(Int(1), Int(2)))))
  Assert(
    Compare(
      Call(Name("even_odd_count"), Int(0)),
      CmpOp("==", TupleExpr(Int(1), Int(0)))))
  Assert(
    Compare(
      Call(Name("even_odd_count"), UnaryOp("-", Int(24680))),
      CmpOp("==", TupleExpr(Int(5), Int(0)))))
  Assert(
    Compare(
      Call(Name("even_odd_count"), Int(13579)),
      CmpOp("==", TupleExpr(Int(0), Int(5)))))
  Assert(
    Compare(
      Call(Name("even_odd_count"), Int(102030405)),
      CmpOp("==", TupleExpr(Int(6), Int(3))))))
