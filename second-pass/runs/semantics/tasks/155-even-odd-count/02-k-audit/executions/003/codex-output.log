+
+run env PATH="/home/agent/.nix-profile/bin:$PATH" \
+  kprove "$fresh/spec.k" \
+  --definition "$fresh/verification-base-kompiled" \
+  --spec-module EVEN-ODD-LOOP-SPEC || exit $?
+
+run env PATH="/home/agent/.nix-profile/bin:$PATH" \
+  kompile "$fresh/verification.k" \
