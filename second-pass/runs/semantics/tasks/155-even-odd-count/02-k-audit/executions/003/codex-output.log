+#!/usr/bin/env bash
+set -u
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+fresh=/tmp/audit-work/fresh
+run find "$fresh" -maxdepth 2 -type d -o -type f || exit $?
+run test ! -e "$fresh/runtime-kompiled" || exit $?
