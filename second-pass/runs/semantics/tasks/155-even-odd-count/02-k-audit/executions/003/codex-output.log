+  --main-module EVEN-ODD-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition "$fresh/verification-base-kompiled" || exit $?
+
+run env PATH="/home/agent/.nix-profile/bin:$PATH" \
