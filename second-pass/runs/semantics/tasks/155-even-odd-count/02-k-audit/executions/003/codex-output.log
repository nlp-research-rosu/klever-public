+        vCons(
+          oddDigits(strToCodes(Int2String(absInt(N)))),
+          .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> #evenOddModuleScope
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule

