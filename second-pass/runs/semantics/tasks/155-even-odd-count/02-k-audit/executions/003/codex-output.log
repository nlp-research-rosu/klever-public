+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "num"        |-> 1
+        "even_count" |-> 0
+        "odd_count"  |-> 0
+        "digit"      |-> 0,
+        parent(0))
+    =>
+      1 |-> scope(
+        "num"        |-> 1
+        "even_count" |-> 0
+        "odd_count"  |-> 1
+        "digit"      |-> str(iCons(49, .IntSeq)),
+        parent(0))
+    </scopes>
+endmodule
