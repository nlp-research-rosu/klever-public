+#!/usr/bin/env bash
+set -u
+
+run_expected_failure() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d; expected nonzero]\n' "$status"
+  test "$status" -ne 0
+}
