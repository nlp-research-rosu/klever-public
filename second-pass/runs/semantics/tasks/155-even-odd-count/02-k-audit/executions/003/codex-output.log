    58	  // ==== all / any (short-circuiting #iterNext folds) ========================
    59	  syntax KItem ::= #allAcc(Iterable) | "#allCont"
    60	  rule <k> #allAcc(IT:Iterable) => #iterNext(IT) ~> #allCont ... </k>
    61	  rule <k> #iterDone ~> #allCont => true ... </k>
    62	  rule <k> #iterYield(V:Val, R:Iterable) ~> #allCont => #allAcc(R) ... </k>
    63	       requires truthy(V)
    64	  rule <k> #iterYield(V:Val, _:Iterable) ~> #allCont => false ... </k>
    65	       requires notBool truthy(V)
    66	
    67	  syntax KItem ::= #anyAcc(Iterable) | "#anyCont"
    68	  rule <k> #anyAcc(IT:Iterable) => #iterNext(IT) ~> #anyCont ... </k>
    69	  rule <k> #iterDone ~> #anyCont => false ... </k>
    70	  rule <k> #iterYield(V:Val, _:Iterable) ~> #anyCont => true ... </k>
    71	       requires truthy(V)
    72	  rule <k> #iterYield(V:Val, R:Iterable) ~> #anyCont => #anyAcc(R) ... </k>
    73	       requires notBool truthy(V)
    74	
    75	  // ==== max / min over an iterable (#iterNext folds; first element seeds) ====
    76	  syntax KItem ::= #maxAcc0(Iterable) | "#maxCont0" | #maxAcc(Iterable, Int) | #maxCont(Int)
    77	  rule <k> #maxAcc0(IT:Iterable) => #iterNext(IT) ~> #maxCont0 ... </k>
    78	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAcc(R, {V}:>Int) ... </k>
    79	       requires isInt(V)
    80	  rule <k> #maxAcc(IT:Iterable, M:Int) => #iterNext(IT) ~> #maxCont(M) ... </k>
    81	  rule <k> #iterDone ~> #maxCont(M:Int) => M ... </k>
    82	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont(M:Int)
    83	        => #maxAcc(R, maxInt(M, {V}:>Int)) ... </k>
    84	       requires isInt(V)
    85	
    86	  syntax KItem ::= #minAcc0(Iterable) | "#minCont0" | #minAcc(Iterable, Int) | #minCont(Int)
    87	  rule <k> #minAcc0(IT:Iterable) => #iterNext(IT) ~> #minCont0 ... </k>
    88	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAcc(R, {V}:>Int) ... </k>
    89	       requires isInt(V)
    90	  rule <k> #minAcc(IT:Iterable, M:Int) => #iterNext(IT) ~> #minCont(M) ... </k>
    91	  rule <k> #iterDone ~> #minCont(M:Int) => M ... </k>
    92	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont(M:Int)
    93	        => #minAcc(R, minInt(M, {V}:>Int)) ... </k>
    94	       requires isInt(V)
    95	
    96	  // ==== variadic max / min (a Vals fold) ====================================
    97	  syntax Int ::= maxVals(Int, Vals) [function]
    98	  rule applyBuiltin("max", I:Int, REST:Vals) => maxVals(I, REST)
    99	  rule maxVals(M:Int, .Vals)           => M
   100	  rule maxVals(M:Int, (I:Int, R:Vals)) => maxVals(maxInt(M, I), R)
   101	
   102	  syntax Int ::= minVals(Int, Vals) [function]
   103	  rule applyBuiltin("min", I:Int, REST:Vals) => minVals(I, REST)
   104	  rule minVals(M:Int, .Vals)           => M
   105	  rule minVals(M:Int, (I:Int, R:Vals)) => minVals(minInt(M, I), R)
   106	
   107	  // ==== bin(n) — "0b" + binary digit codes (promoted from 103's defined fold) ==
   108	  rule applyBuiltin("bin", N:Int, .Vals) => str(iCons(48, iCons(98, binCodes(N))))
   109	       requires N >=Int 0
   110	  // negative operand: the '-' sign prefixes the magnitude's digits
   111	  rule applyBuiltin("bin", N:Int, .Vals)
   112	    => str(iCons(45, iCons(48, iCons(98, binCodes(0 -Int N)))))
   113	       requires N <Int 0
   114	  syntax IntSeq ::= binCodes(Int) [function, total]
   115	  rule binCodes(0) => iCons(48, .IntSeq)
   116	  rule binCodes(N:Int) => binAcc(N, .IntSeq) requires N >Int 0
   117	  syntax IntSeq ::= binAcc(Int, IntSeq) [function, total]
   118	  rule binAcc(0, ACC:IntSeq) => ACC
   119	  rule binAcc(N:Int, ACC:IntSeq)
   120	    => binAcc((N -Int pyMod(N, 2)) /Int 2, iCons(48 +Int pyMod(N, 2), ACC))
   121	       requires N >Int 0
   122	
   123	  // ==== enumerate(xs) — pairs (i, v); materialized eagerly over a list =========
   124	  rule <k> #applyK(toCall(builtinV("enumerate")), (list(VS:ValSeq), .Vals))
   125	        => #alloc(list(enumVS(VS, 0))) ... </k>
   126	  syntax ValSeq ::= enumVS(ValSeq, Int) [function, total]
   127	  rule enumVS(.ValSeq, _:Int) => .ValSeq
   128	  rule enumVS(vCons(V:Val, R:ValSeq), I:Int)
   129	    => vCons(tuple(vCons(I, vCons(V, .ValSeq))), enumVS(R, I +Int 1))
   130	
   131	  // ==== map(str, xs) — eager (only the str case is in the subset) =============
   132	  rule <k> #applyK(toCall(builtinV("map")), (typeV("str"), list(VS:ValSeq), .Vals))
   133	        => #alloc(list(mapStrVS(VS))) ... </k>
   134	  syntax ValSeq ::= mapStrVS(ValSeq) [function, total]
   135	  rule mapStrVS(.ValSeq) => .ValSeq
   136	  rule mapStrVS(vCons(I:Int, R:ValSeq)) => vCons(str(strToCodes(Int2String(I))), mapStrVS(R))
   137	  rule mapStrVS(vCons(str(CS:IntSeq), R:ValSeq)) => vCons(str(CS), mapStrVS(R))
   138	
   139	  // ==== int(x) identities (int(round(x)) composes through) ====================
   140	  rule applyBuiltin("int", I:Int, .Vals) => I
   141	
   142	  // ==== ord / chr ===========================================================
   143	  rule applyBuiltin("ord", str(iCons(C:Int, .IntSeq)), .Vals) => C
   144	  rule applyBuiltin("chr", I:Int, .Vals) => str(iCons(I, .IntSeq))
   145	       requires 0 <=Int I andBool I <Int 128
   146	
   147	  // ==== str(int) / str(str) =================================================
   148	  rule applyBuiltin("str", I:Int, .Vals)       => str(strToCodes(Int2String(I)))
   149	  rule applyBuiltin("str", str(CS:IntSeq), .Vals) => str(CS)
   150	
   151	  // ==== int(str) — a single digit char ('0'..'9', code 48..57) to its value =====
   152	  rule applyBuiltin("int", str(iCons(C:Int, .IntSeq)), .Vals) => C -Int 48
   153	       requires 48 <=Int C andBool C <=Int 57
   154	
   155	  // ==== int(str) — a multi-digit non-negative numeral (Horner fold; the single-char rule covers len 1)
   156	  rule applyBuiltin("int", str(CS:IntSeq), .Vals) => intDigAcc(CS, 0)
   157	       requires isLen(CS) >=Int 2
   158	  syntax Int ::= intDigAcc(IntSeq, Int) [function, total]
   159	  rule intDigAcc(.IntSeq, ACC:Int)             => ACC
   160	  rule intDigAcc(iCons(C:Int, R:IntSeq), ACC:Int) => intDigAcc(R, (ACC *Int 10) +Int (C -Int 48))
   161	
   162	  // ==== zip(a, b) — parallel iterable of pairs, truncating to the shorter =====
   163	  rule applyBuiltin("zip", list(A:ValSeq), list(B:ValSeq), .Vals) => zipObj(A, B)
   164	  rule applyBuiltin("zip", str(A:IntSeq), str(B:IntSeq), .Vals)   => zipObjS(A, B)
   165	
   166	  // zip's iterator-protocol cases (zip is created here, so its #iterNext lives here)
   167	  rule <k> #iterNext(zipObj(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq)))
   168	        => #iterYield(tuple(vCons(A, vCons(B, .ValSeq))), zipObj(As, Bs)) ... </k>
   169	  rule <k> #iterNext(zipObj(.ValSeq, _:ValSeq))               => #iterDone ... </k>
   170	  rule <k> #iterNext(zipObj(vCons(_:Val, _:ValSeq), .ValSeq)) => #iterDone ... </k>
   171	  rule <k> #iterNext(zipObjS(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)))
   172	        => #iterYield(tuple(vCons(str(iCons(A, .IntSeq)), vCons(str(iCons(B, .IntSeq)), .ValSeq))), zipObjS(As, Bs)) ... </k>
   173	  rule <k> #iterNext(zipObjS(.IntSeq, _:IntSeq))              => #iterDone ... </k>
   174	  rule <k> #iterNext(zipObjS(iCons(_:Int, _:IntSeq), .IntSeq)) => #iterDone ... </k>
   175	
   176	  // ==== range(stop) / range(start, stop) / range(start, stop, step) =========
   177	  rule applyBuiltin("range", I:Int, .Vals)               => rangeObj(0, I, 1)
   178	  rule applyBuiltin("range", A:Int, B:Int, .Vals)        => rangeObj(A, B, 1)
   179	  rule applyBuiltin("range", A:Int, B:Int, S:Int, .Vals) => rangeObj(A, B, S)
   180	       requires S =/=Int 0
   181	
   182	  // ==== eval(str) — arithmetic expressions (ints, + - * // **, spaces) ========
   183	  // Python precedence: ** right-assoc, then * //, then + -. Promoted from 160's
   184	  // trusted pass evaluator, now DEFINED in the reference and driven by a
   185	  // code-level tokenizer. Reduces on concrete strings (krun); a symbolic
     1	// reference/src/semantics/concrete.k — MPY-CONCRETE
     2	// Concrete-execution-only rules, visible ONLY to the llvm build (run.sh kompiles
     3	// MPY-CONCRETE; verification builds import MPY and never see these). Rationale:
     4	// a k-cell rule matching value constructors NARROWS abstract Vals in the haskell
     5	// backend ([concrete] is not respected on rewrite rules) — probed on
     6	// 26-remove-duplicates, where element compares branched into deepEqVS.
     7	
     8	module MPY-CONCRETE
     9	  imports MPY
    10	
    11	  // deep equality for list compares whose elements are heap objects
    12	  // (list-of-lists): Python == is structural at every depth.
    13	  rule <k> Compare(list(A:ValSeq), CmpOp("==", list(B:ValSeq))) => deepEqVS(A, B, HP) ... </k>
    14	       <heap> HP:Map </heap>
    15	       requires hasRefVS(A) orBool hasRefVS(B)
    16	  rule <k> Compare(list(A:ValSeq), CmpOp("!=", list(B:ValSeq))) => notBool deepEqVS(A, B, HP) ... </k>
    17	       <heap> HP:Map </heap>
    18	       requires hasRefVS(A) orBool hasRefVS(B)
    19	
    20	  // ==== keyed sort, concrete leg ============================================
    21	  // Computes each key by a REAL call through the uniform #callee machinery
    22	  // (closures, len, type objects all work), stable-inserts on the key, and
    23	  // allocates the result. priority(40) beats sort.k's opaque rules, so krun
    24	  // runs this and proofs (which never see MPY-CONCRETE) keep sortKeyVS.
    25	  syntax Val ::= kvP(Val, Val)
    26	  syntax KItem ::= #ksort(ValSeq, Val, ValSeq, Bool)
    27	                 | #ksIns(Val, ValSeq, Val, ValSeq, Bool)
    28	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
    29	        => #ksort(VS, KV, .ValSeq, false) ... </k>
    30	       [priority(40)]
    31	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
    32	        => #ksort(VS, KV, .ValSeq, RB) ... </k>
    33	       [priority(40)]
    34	  rule <k> #ksort(.ValSeq, _:Val, ACC:ValSeq, RB:Bool)
    35	        => #alloc(list(condRev(unpairVS(ACC), RB))) ... </k>
    36	  rule <k> #ksort(vCons(V:Val, R:ValSeq), KV:Val, ACC:ValSeq, RB:Bool)
    37	        => KV ~> #callee((V, .Exprs)) ~> #ksIns(V, R, KV, ACC, RB) ... </k>
    38	  rule <k> K:Val ~> #ksIns(V:Val, R:ValSeq, KV:Val, ACC:ValSeq, RB:Bool)
    39	        => #ksort(R, KV, insPair(ACC, K, V), RB) ... </k>
    40	       requires notBool isKwV(K)
    41	
    42	  syntax ValSeq ::= insPair(ValSeq, Val, Val) [function]
    43	  rule insPair(.ValSeq, K:Val, V:Val) => vCons(kvP(K, V), .ValSeq)
    44	  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    45	    => vCons(kvP(K, V), vCons(kvP(K2, V2), R))
    46	       requires kLt(K, K2)
    47	  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    48	    => vCons(kvP(K2, V2), insPair(R, K, V))
    49	       requires notBool kLt(K, K2)
    50	
    51	  syntax Bool ::= kLt(Val, Val) [function]
    52	  rule kLt(I1:Int, I2:Int)             => I1 <Int I2
    53	  rule kLt(F1:Float, F2:Float)         => F1 <Float F2
    54	  rule kLt(str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
    55	
    56	  syntax ValSeq ::= unpairVS(ValSeq) [function, total]
    57	  rule unpairVS(.ValSeq) => .ValSeq
    58	  rule unpairVS(vCons(kvP(_:Val, V:Val), R:ValSeq)) => vCons(V, unpairVS(R))
    59	  rule unpairVS(vCons(V:Val, R:ValSeq)) => vCons(V, unpairVS(R)) [owise]
    60	endmodule
     1	// reference/src/semantics/assert.k — MPY-ASSERT
     2	
     3	module MPY-ASSERT
     4	  imports MPY-CORE
     5	
     6	  rule <k> Assert(V:Val) => .K ... </k>
     7	       requires truthy(V)
     8	  rule <k> Assert(V:Val) ~> _ => .K </k>
     9	       <exc> NoExc => AssertionError </exc>
    10	       <exit-code> _ => 1 </exit-code>
    11	       requires notBool truthy(V)
    12	
    13	  rule <k> Assert(ref(H:Int)) => Assert(V) ... </k>
    14	       <heap> ... H |-> V:Val ... </heap>
    15	       [priority(40)]
    16	endmodule
     1	// reference/src/semantics/iter.k — MPY-ITER
     2	// The iterator protocol, DECLARATION ONLY. Each iterable's #iterNext case lives in that
     3	// iterable's own module (list/tuple/str in their modules, rangeObj in range.k, zip in
     4	// builtins.k). Consumers (the for-loop, `x in _`, sum/all/any/max/min) import this.
     5	
     6	module MPY-ITER
     7	  imports MPY-CORE
     8	  syntax KItem ::= #iterNext(Iterable) | "#iterDone" | #iterYield(Val, Iterable)
     9	endmodule
     1	// reference/src/semantics/range.k — MPY-RANGE
     2	// rangeObj: the range helpers (inRange / rangeLen) + its #iterNext case. rangeObj itself is
     3	// declared in MPY-CORE's Iterable union; this module owns its behavior.
     4	
     5	module MPY-RANGE
     6	  imports MPY-CORE
     7	  imports MPY-ITER
     8	
     9	  syntax Bool ::= inRange(Int, Int, Int) [function, total]
    10	  rule inRange(I:Int, HI:Int, ST:Int) => (ST >Int 0 andBool I <Int HI) orBool (ST <Int 0 andBool I >Int HI)
    11	
    12	  syntax Int ::= rangeLen(Int, Int, Int) [function]
    13	  rule rangeLen(LO:Int, HI:Int, ST:Int) => (HI -Int LO +Int ST -Int 1) /Int ST
    14	       requires ST >Int 0 andBool HI >Int LO
    15	  rule rangeLen(LO:Int, HI:Int, ST:Int) => (LO -Int HI -Int ST -Int 1) /Int (0 -Int ST)
    16	       requires ST <Int 0 andBool HI <Int LO
    17	  rule rangeLen(LO:Int, HI:Int, ST:Int) => 0
    18	       requires (ST >Int 0 andBool HI <=Int LO) orBool (ST <Int 0 andBool HI >=Int LO)
    19	
    20	  rule <k> #iterNext(rangeObj(I:Int, HI:Int, ST:Int))
    21	        => #iterYield(I, rangeObj(I +Int ST, HI, ST)) ... </k>
    22	       requires inRange(I, HI, ST)
    23	  rule <k> #iterNext(rangeObj(I:Int, HI:Int, ST:Int)) => #iterDone ... </k>
    24	       requires notBool inRange(I, HI, ST)
    25	endmodule

diff --git a/evidence/01_provenance_checks.sh b/evidence/01_provenance_checks.sh
new file mode 100644
index 0000000000000000000000000000000000000000..e55e8c2a679abca5059cd24655e6e1648b79e474
--- /dev/null
+++ b/evidence/01_provenance_checks.sh
@@ -0,0 +1,56 @@
+#!/usr/bin/env bash
+set -u
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+run sha256sum \
+  /audit-input.json \
+  /audit-campaign-lock.json \
+  /run.json \
+  /task.json \
+  /generation-result.json \
+  /generation-evidence/invocation.json \
+  /generation-evidence/metrics.json \
+  /generation-evidence/usage.json \
+  /generation-evidence/codex-last.txt \
+  /generation-evidence/codex-output.log \
+  /generation-evidence/prompt.txt \
+  /generation-evidence/codex-trace/2026/07/23/rollout-2026-07-23T08-22-56-019f8f24-b7d4-73f3-8cab-481aed17f1e2.jsonl \
+  /reference/canonical.py \
+  /reference/prompt.py \
+  /reference/py2mpy.py \
+  /candidate/prompt.py \
+  /candidate/py2mpy.py
+
+run python3 -c 'import json; a=json.load(open("/audit-input.json")); b=json.load(open("/audit-campaign-lock.json")); assert a["audit_campaign"] == b'
+run cmp -s /candidate/prompt.py /reference/prompt.py
+run cmp -s /candidate/py2mpy.py /reference/py2mpy.py
+run diff -qr --no-dereference /candidate/reference-semantics /reference/reference-semantics
+
+run find /candidate /reference /generation-evidence -type l -printf '%p -> %l\n'
+run find /candidate/reference-semantics -printf '%y %P\n'
+run find /reference/reference-semantics -printf '%y %P\n'
+
+run test -r /run.json
+run test -r /task.json
+run test -r /generation-result.json
+run test -r /generation-evidence/invocation.json
+run test -r /generation-evidence/metrics.json
+run test -r /generation-evidence/codex-last.txt
+run test -r /generation-evidence/codex-output.log
+run test -r /generation-evidence/prompt.txt
+run test -r /generation-evidence/codex-trace/2026/07/23/rollout-2026-07-23T08-22-56-019f8f24-b7d4-73f3-8cab-481aed17f1e2.jsonl
+run test -r /generation-evidence/usage.json
+run test -d /reference/reference-semantics
+run test -d /candidate/reference-semantics
+
+run env PATH="/home/agent/.nix-profile/bin:$PATH" kompile --version
+run env PATH="/home/agent/.nix-profile/bin:$PATH" kprove --version
diff --git a/evidence/02_differential.py b/evidence/02_differential.py
new file mode 100644
index 0000000000000000000000000000000000000000..d8add4340236b008e0227787fe1f27c7716f54ca
--- /dev/null
+++ b/evidence/02_differential.py
@@ -0,0 +1,81 @@
+#!/usr/bin/env python3
+"""Independent differential test for HumanEval 155.
+
+The test does not import candidate proof equations.  It loads the trusted
+canonical Python and the submitted generated Python directly from their
+mounted source files.
+"""
+
+import importlib.util
+import random
+from pathlib import Path
+
+
+def load_function(module_name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.even_odd_count
+
+
+canonical = load_function("trusted_canonical", Path("/reference/canonical.py"))
+generated = load_function("candidate_solution", Path("/candidate/solution.py"))
+
+documented = [-12, 123]
+empty_or_boundary = [
+    0,
+    1,
+    -1,
+    2,
+    -2,
+    9,
+    -9,
+    10,
+    -10,
+    11,
+    -11,
+    99,
+    -99,
+    100,
+    -100,
+    101,
+    -101,
+    2**31 - 1,
+    -(2**31),
+    2**63 - 1,
+    -(2**63),
+]
+branch_boundaries = list(range(-20, 21)) + [
+    24680,
+    -24680,
+    13579,
+    -13579,
+    102030405,
+    -102030405,
+]
+powers = []
+for exponent in range(1, 101):
+    power = 10**exponent
+    powers.extend([power - 1, power, power + 1, -power + 1, -power, -power - 1])
+
+rng = random.Random(155)
+generated_inputs = [rng.randint(-(10**100), 10**100) for _ in range(2000)]
+inputs = list(dict.fromkeys(documented + empty_or_boundary + branch_boundaries + powers + generated_inputs))
+
+mismatches = []
+for value in inputs:
+    trusted_result = canonical(value)
+    generated_result = generated(value)
+    if trusted_result != generated_result:
+        mismatches.append((value, trusted_result, generated_result))
+
+print(f"documented={len(documented)}")
+print(f"empty_or_boundary={len(empty_or_boundary)}")
+print(f"branch_boundary={len(branch_boundaries)}")
+print(f"power_boundaries={len(powers)}")
+print(f"seed=155 generated={len(generated_inputs)} range=[-10**100,10**100]")
+print(f"unique_total={len(inputs)} mismatches={len(mismatches)}")
+if mismatches:
+    print(f"first_mismatches={mismatches[:10]}")
+    raise SystemExit(1)
diff --git a/evidence/02_fidelity_checks.sh b/evidence/02_fidelity_checks.sh
new file mode 100644
index 0000000000000000000000000000000000000000..bc738580a3fd9cd6c1048a4c1501b8f2fdd06669
--- /dev/null
+++ b/evidence/02_fidelity_checks.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+set -u
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+fresh=/tmp/audit-work/fresh
+run mkdir -p "$fresh/reference-semantics"
+run cp /candidate/solution.py "$fresh/solution.py"
+run cp /candidate/solution.mpy "$fresh/submitted-solution.mpy"
+run cp /candidate/verification.k "$fresh/verification.k"
+run cp /candidate/spec.k "$fresh/spec.k"
+run cp /reference/py2mpy.py "$fresh/py2mpy.py"
+run cp -a /reference/reference-semantics/. "$fresh/reference-semantics/"
+
+printf '$ python3 /reference/py2mpy.py /candidate/solution.py > /tmp/audit-work/fresh/regenerated-solution.mpy\n'
+python3 /reference/py2mpy.py /candidate/solution.py > "$fresh/regenerated-solution.mpy"
+status=$?
+printf '[exit %d]\n' "$status"
+
+run cmp -s "$fresh/regenerated-solution.mpy" /candidate/solution.mpy
+run sha256sum "$fresh/regenerated-solution.mpy" /candidate/solution.mpy
+run python3 /audit-output/evidence/02_differential.py
diff --git a/evidence/03_concrete_tests.py b/evidence/03_concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..30a1337f9f35d02d16b86930f5cb6b5b84a8b5fe
--- /dev/null
+++ b/evidence/03_concrete_tests.py
@@ -0,0 +1,22 @@
+def even_odd_count(num):
+    """Return the counts of even and odd decimal digits in num."""
+    even_count = 0
+    odd_count = 0
+    digit = 0
+    for digit in str(abs(num)):
+        if ord(digit) % 2 == 0:
+            even_count += 1
+        else:
+            odd_count += 1
+    return (even_count, odd_count)
+
+
+assert even_odd_count(-12) == (1, 1)
+assert even_odd_count(123) == (1, 2)
+assert even_odd_count(0) == (1, 0)
+assert even_odd_count(8) == (1, 0)
+assert even_odd_count(9) == (0, 1)
+assert even_odd_count(-24680) == (5, 0)
+assert even_odd_count(13579) == (0, 5)
+assert even_odd_count(102030405) == (6, 3)
+assert even_odd_count(-9223372036854775808) == (10, 9)
