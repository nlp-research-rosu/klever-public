     1	requires "reference-semantics/semantics.k"
     2	
     3	module EVEN-ODD-VERIFICATION
     4	  imports MPY
     5	
     6	  // Mathematical specification: count character codes of each parity.
     7	  // Decimal digit codes have the same parity as their represented digits
     8	  // because the code for "0" is 48.
     9	  syntax Int ::= evenDigits(IntSeq) [function, total]
    10	               | oddDigits(IntSeq)  [function, total]
    11	
    12	  rule evenDigits(.IntSeq) => 0
    13	  rule evenDigits(iCons(C:Int, R:IntSeq)) =>
    14	    (#if pyMod(C, 2) ==Int 0 #then 1 #else 0 #fi) +Int evenDigits(R)
    15	
    16	  rule oddDigits(.IntSeq) => 0
    17	  rule oddDigits(iCons(C:Int, R:IntSeq)) =>
    18	    (#if pyMod(C, 2) ==Int 0 #then 0 #else 1 #fi) +Int oddDigits(R)
    19	
    20	  // The loop target is deliberately initialized in solution.py.  Tracking its
    21	  // final value makes the loop invariant describe the full local scope.
    22	  syntax Val ::= lastSeen(IntSeq, Val) [function, total]
    23	  rule lastSeen(.IntSeq, D:Val) => D
    24	  rule lastSeen(iCons(C:Int, R:IntSeq), _:Val) =>
    25	    lastSeen(R, str(iCons(C, .IntSeq)))
    26	
    27	  syntax Stmts ::= "#digitLoopBody" [macro]
    28	  rule #digitLoopBody =>
    29	    If(
    30	      Compare(
    31	        BinOp("%", Call(Name("ord"), Name("digit")), Int(2)),
    32	        CmpOp("==", Int(0))),
    33	      AugAssign(Name("even_count"), "+", Int(1)),
    34	      AugAssign(Name("odd_count"), "+", Int(1)))
    35	
    36	  syntax Stmts ::= "#evenOddFunctionBody" [macro]
    37	  rule #evenOddFunctionBody =>
    38	    Expr(Str("Return the counts of even and odd decimal digits in num."))
    39	    Assign(Name("even_count"), Int(0))
    40	    Assign(Name("odd_count"), Int(0))
    41	    Assign(Name("digit"), Int(0))
    42	    For(
    43	      Name("digit"),
    44	      Call(Name("str"), Call(Name("abs"), Name("num"))),
    45	      #digitLoopBody)
    46	    Return(TupleExpr(Name("even_count"), Name("odd_count")))
    47	
    48	  syntax Scope ::= "#evenOddModuleScope" [macro]
    49	  rule #evenOddModuleScope =>
    50	    scope(
    51	      "even_odd_count" |->
    52	        closureVal(("num", .ParamNames), #evenOddFunctionBody, 0),
    53	      parent(-1))
    54	endmodule
    55	
    56	// This module contains the compositional loop summary used by the entry-point
    57	// theorem.  Its identical reachability claim is proved first against the base
    58	// module (where this rule is absent).
    59	module EVEN-ODD-VERIFICATION-SUMMARY
    60	  imports EVEN-ODD-VERIFICATION
    61	
    62	  rule
    63	    <k>
    64	      #loop(str(CS:IntSeq), Name("digit"), #digitLoopBody)
    65	      ~> CONT:K
    66	    =>
    67	      CONT
    68	    </k>
    69	    <env> 1 </env>
    70	    <scopes>
    71	      ... 1 |-> scope(
    72	        "num"        |-> N:Int
    73	        "even_count" |-> E:Int
    74	        "odd_count"  |-> O:Int
    75	        "digit"      |-> D:Val,
    76	        parent(0))
    77	    =>
    78	      1  |-> scope(
    79	        "num"        |-> N
    80	        "even_count" |-> E +Int evenDigits(CS)
    81	        "odd_count"  |-> O +Int oddDigits(CS)
    82	        "digit"      |-> lastSeen(CS, D),
    83	        parent(0))
    84	      ...
    85	    </scopes>
    86	    [priority(40)]
    87	endmodule
