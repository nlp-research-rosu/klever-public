     1	def even_odd_count(num):
     2	    """Return the counts of even and odd decimal digits in num."""
     3	    even_count = 0
     4	    odd_count = 0
     5	    digit = 0
     6	    for digit in str(abs(num)):
     7	        if ord(digit) % 2 == 0:
     8	            even_count += 1
     9	        else:
    10	            odd_count += 1
    11	    return (even_count, odd_count)
