    22	
    23	  // ==== join / count / strip / encode ========================================
    24	  // S.join(list-of-str): fold with separator codes (receiver + arg deref'd by
    25	  // the call layer; the result str is a value)
    26	  rule applyMethod(str(SEP:IntSeq), "join", list(VS:ValSeq), .Vals) => str(joinCodes(SEP, VS))
    27	  syntax IntSeq ::= joinCodes(IntSeq, ValSeq) [function, total]
    28	  rule joinCodes(_:IntSeq, .ValSeq) => .IntSeq
    29	  rule joinCodes(_:IntSeq, vCons(str(CS:IntSeq), .ValSeq)) => CS
    30	  rule joinCodes(SEP:IntSeq, vCons(str(CS:IntSeq), vCons(V:Val, R:ValSeq)))
    31	    => seqConcat(CS, seqConcat(SEP, joinCodes(SEP, vCons(V, R))))
    32	
    33	  // S.count(sub): non-overlapping window scan (Python str.count)
    34	  rule applyMethod(str(CS:IntSeq), "count", str(PC:IntSeq), .Vals) => cntSub(CS, PC)
    35	  syntax Int ::= cntSub(IntSeq, IntSeq) [function]
    36	  rule cntSub(.IntSeq, _:IntSeq) => 0
    37	  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => 1 +Int cntSub(dropIS(iCons(C, R), isLen(PC)), PC)
    38	       requires strPrefix(PC, iCons(C, R)) andBool isLen(PC) >Int 0
    39	  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => cntSub(R, PC)
    40	       requires notBool strPrefix(PC, iCons(C, R)) orBool isLen(PC) <=Int 0
    41	  syntax IntSeq ::= dropIS(IntSeq, Int) [function, total]
    42	  rule dropIS(S:IntSeq, N:Int) => S requires N <=Int 0
    43	  rule dropIS(.IntSeq, _:Int) => .IntSeq [owise]
    44	  rule dropIS(iCons(_:Int, R:IntSeq), N:Int) => dropIS(R, N -Int 1) requires N >Int 0
    45	
    46	  // S.strip(): trim whitespace runs from both ends
    47	  rule applyMethod(str(CS:IntSeq), "strip", .Vals) => str(revIS(trimWS(revIS(trimWS(CS)))))
    48	  syntax IntSeq ::= trimWS(IntSeq) [function, total]
    49	  rule trimWS(.IntSeq) => .IntSeq
    50	  rule trimWS(iCons(C:Int, R:IntSeq)) => trimWS(R) requires isWSC(C)
    51	  rule trimWS(iCons(C:Int, R:IntSeq)) => iCons(C, R) requires notBool isWSC(C)
    52	  syntax IntSeq ::= revIS(IntSeq) [function, total] | revISAcc(IntSeq, IntSeq) [function, total]
    53	  rule revIS(S:IntSeq) => revISAcc(S, .IntSeq)
    54	  rule revISAcc(.IntSeq, A:IntSeq) => A
    55	  rule revISAcc(iCons(C:Int, R:IntSeq), A:IntSeq) => revISAcc(R, iCons(C, A))
    56	
    57	  // S.encode('ascii'): identity on the code-sequence model (bytes == codes)
    58	  rule applyMethod(str(CS:IntSeq), "encode", str(_:IntSeq), .Vals) => str(CS)
    59	
    60	  // ==== prefix ===============================================================
    61	  rule applyMethod(str(XC:IntSeq), "startswith", str(PC:IntSeq), .Vals) => startsWith(PC, XC)
    62	
    63	  // ==== list.count(v) — number of occurrences of v in the list (concrete for krun) ==========
    64	  rule applyMethod(list(VS:ValSeq), "count", V:Val, .Vals) => cntOccVS(VS, V)
    65	  syntax Int ::= cntOccVS(ValSeq, Val) [function, total]
    66	  rule cntOccVS(.ValSeq, _:Val)                => 0
    67	  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => 1 +Int cntOccVS(R, V) requires A ==K V
    68	  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => cntOccVS(R, V)        requires notBool (A ==K V)
    69	
    70	  // ==== split (no-arg: on whitespace runs, dropping empty tokens) + replace (single char) ==========
    71	  // Concrete string ops for krun. A proof over a symbolic string intercepts the split problem-locally.
    72	  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), .Vals)
    73	        => #alloc(list(splitWS(CS, .IntSeq, .ValSeq))) ... </k>
    74	       [priority(40)]
    75	  syntax ValSeq ::= splitWS(IntSeq, IntSeq, ValSeq) [function]  // remaining, current token, result
    76	  rule splitWS(.IntSeq, CUR:IntSeq, ACC:ValSeq) => flushTok(ACC, CUR)
    77	  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, .IntSeq, flushTok(ACC, CUR))
    78	       requires isWSC(C)
    79	  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, seqConcat(CUR, iCons(C, .IntSeq)), ACC)
    80	       requires notBool isWSC(C)
    81	  // flush the current token to the result list iff non-empty.
    82	  syntax ValSeq ::= flushTok(ValSeq, IntSeq) [function]
    83	  rule flushTok(ACC:ValSeq, .IntSeq)            => ACC
    84	  rule flushTok(ACC:ValSeq, iCons(C:Int, T:IntSeq)) => valSeqConcat(ACC, vCons(str(iCons(C, T)), .ValSeq))
    85	  syntax Bool ::= isWSC(Int) [function, total]
    86	  rule isWSC(C:Int) => C ==Int 32 orBool C ==Int 9 orBool C ==Int 10 orBool C ==Int 13
    87	
    88	  // split(sep='x') keyword form delegates to the positional k-cell rule
    89	  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), (kwV("sep", str(S:IntSeq)), .Vals))
    90	        => #applyK(toCall(boundMethodV(str(CS), "split")), (str(S), .Vals)) ... </k>
    91	       [priority(39)]
    92	
    93	  // str.split(sep) — single-char separator, KEEPING empty parts (Python's sep-split; len == #sep + 1).
    94	  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), (str(iCons(SEP:Int, .IntSeq)), .Vals))
    95	        => #alloc(list(splitSep(CS, SEP, .IntSeq))) ... </k>
    96	       [priority(40)]
    97	  syntax ValSeq ::= splitSep(IntSeq, Int, IntSeq) [function]  // remaining, sep code, current token
    98	  rule splitSep(.IntSeq, _SEP:Int, CUR:IntSeq)              => vCons(str(CUR), .ValSeq)
    99	  rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => vCons(str(CUR), splitSep(R, SEP, .IntSeq))
   100	       requires C ==Int SEP
   101	  rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => splitSep(R, SEP, seqConcat(CUR, iCons(C, .IntSeq)))
   102	       requires notBool (C ==Int SEP)
   103	
   104	  rule applyMethod(str(CS:IntSeq), "replace", str(iCons(A:Int, .IntSeq)), str(iCons(B:Int, .IntSeq)), .Vals)
   105	    => str(replaceC(CS, A, B))
   106	  syntax IntSeq ::= replaceC(IntSeq, Int, Int) [function, total]
   107	  rule replaceC(.IntSeq, _:Int, _:Int)             => .IntSeq
   108	  rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(B, replaceC(R, A, B)) requires C ==Int A
   109	  rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(C, replaceC(R, A, B)) requires notBool (C ==Int A)
   110	
   111	  // ==== char helpers =========================================================
   112	  syntax Bool ::= isUpperC(Int) [function, total]
   113	  rule isUpperC(C:Int) => C >=Int 65 andBool C <=Int 90
   114	
   115	  syntax Bool ::= isLowerC(Int) [function, total]
   116	  rule isLowerC(C:Int) => C >=Int 97 andBool C <=Int 122
   117	
   118	  syntax Bool ::= isAlphaC(Int) [function, total]
   119	  rule isAlphaC(C:Int) => isUpperC(C) orBool isLowerC(C)
   120	
   121	  syntax Bool ::= isDigitC(Int) [function, total]
   122	  rule isDigitC(C:Int) => C >=Int 48 andBool C <=Int 57
   123	
   124	  syntax Bool ::= hasUpper(IntSeq) [function, total]
   125	  rule hasUpper(.IntSeq) => false
   126	  rule hasUpper(iCons(C:Int, S:IntSeq)) => isUpperC(C) orBool hasUpper(S)
   127	
   128	  syntax Bool ::= hasLower(IntSeq) [function, total]
   129	  rule hasLower(.IntSeq) => false
   130	  rule hasLower(iCons(C:Int, S:IntSeq)) => isLowerC(C) orBool hasLower(S)
   131	
   132	  syntax Bool ::= allAlpha(IntSeq) [function, total]
   133	  rule allAlpha(.IntSeq) => true
   134	  rule allAlpha(iCons(C:Int, S:IntSeq)) => isAlphaC(C) andBool allAlpha(S)
   135	
   136	  syntax Bool ::= allDigit(IntSeq) [function, total]
   137	  rule allDigit(.IntSeq) => true
   138	  rule allDigit(iCons(C:Int, S:IntSeq)) => isDigitC(C) andBool allDigit(S)
   139	
   140	  syntax Int ::= lowerC(Int) [function, total]
   141	
   142	  rule lowerC(C:Int) => C +Int 32 requires isUpperC(C)
   143	  rule lowerC(C:Int) => C         [owise]
   144	
   145	  syntax Int ::= upperC(Int) [function, total]
   146	  rule upperC(C:Int) => C -Int 32 requires isLowerC(C)
   147	  rule upperC(C:Int) => C         [owise]
   148	
   149	  syntax Int ::= swapC(Int) [function, total]
   150	  rule swapC(C:Int) => C +Int 32 requires isUpperC(C)
   151	  rule swapC(C:Int) => C -Int 32 requires isLowerC(C)
   152	  rule swapC(C:Int) => C         [owise]
   153	
   154	  syntax IntSeq ::= mapLower(IntSeq) [function, total]
   155	  rule mapLower(.IntSeq) => .IntSeq
   156	  rule mapLower(iCons(C:Int, S:IntSeq)) => iCons(lowerC(C), mapLower(S))
   157	
   158	  syntax IntSeq ::= mapUpper(IntSeq) [function, total]
   159	  rule mapUpper(.IntSeq) => .IntSeq
   160	  rule mapUpper(iCons(C:Int, S:IntSeq)) => iCons(upperC(C), mapUpper(S))
   161	
   162	  syntax IntSeq ::= mapSwap(IntSeq) [function, total]
   163	  rule mapSwap(.IntSeq) => .IntSeq
   164	  rule mapSwap(iCons(C:Int, S:IntSeq)) => iCons(swapC(C), mapSwap(S))
   165	
   166	  syntax Bool ::= startsWith(IntSeq, IntSeq) [function, total]
   167	  rule startsWith(.IntSeq, _:IntSeq)               => true
   168	  rule startsWith(iCons(_:Int, _:IntSeq), .IntSeq) => false
   169	  rule startsWith(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool startsWith(As, Bs)
   170	endmodule

diff --git a/evidence/audit_integrity.sh b/evidence/audit_integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ba36bfbe3da292dd2456f70767cf2ff49064b8d5
--- /dev/null
+++ b/evidence/audit_integrity.sh
@@ -0,0 +1,117 @@
+#!/usr/bin/env bash
+set -u
+
+integrity_fail=0
+
+report_failure() {
+  printf 'INTEGRITY_FAILURE: %s\n' "$1"
+  integrity_fail=1
+}
+
+printf '%s\n' '== Candidate top-level and nested inventory =='
+find /candidate -xdev -printf '%y %p -> %l\n' | LC_ALL=C sort
+
+printf '%s\n' '== Trusted reference inventory =='
+find /reference -xdev -printf '%y %p -> %l\n' | LC_ALL=C sort
+
+printf '%s\n' '== Required provenance records =='
+for audit_name in run-input.json metrics.json codex-last.txt codex-output.log; do
+  audit_path="/candidate/$audit_name"
+  if [[ ! -e "$audit_path" && ! -L "$audit_path" ]]; then
+    report_failure "missing /candidate/$audit_name"
+  elif [[ -L "$audit_path" ]]; then
+    report_failure "symlinked /candidate/$audit_name"
+  elif [[ ! -f "$audit_path" ]]; then
+    report_failure "mistyped /candidate/$audit_name (not a regular file)"
+  else
+    printf 'PRESENT regular file: %s\n' "$audit_path"
+  fi
+done
+
+printf '%s\n' '== Structured trace candidates, when present =='
+find /candidate -xdev \( -iname '*trace*' -o -iname '*.jsonl' \) \
+  -printf '%y %p -> %l\n' | LC_ALL=C sort
+
+printf '%s\n' '== Required source artifacts and types =='
+for audit_name in prompt.py py2mpy.py solution.py solution.mpy spec.k verification.k; do
+  audit_path="/candidate/$audit_name"
+  if [[ ! -e "$audit_path" && ! -L "$audit_path" ]]; then
+    report_failure "missing /candidate/$audit_name"
+  elif [[ -L "$audit_path" ]]; then
+    report_failure "symlinked /candidate/$audit_name"
+  elif [[ ! -f "$audit_path" ]]; then
+    report_failure "mistyped /candidate/$audit_name (not a regular file)"
+  else
+    printf 'PRESENT regular file: %s\n' "$audit_path"
+  fi
+done
+
+if [[ ! -e /candidate/reference-semantics && ! -L /candidate/reference-semantics ]]; then
+  report_failure 'missing /candidate/reference-semantics'
+elif [[ -L /candidate/reference-semantics ]]; then
+  report_failure 'symlinked /candidate/reference-semantics'
+elif [[ ! -d /candidate/reference-semantics ]]; then
+  report_failure 'mistyped /candidate/reference-semantics (not a directory)'
+fi
+
+if [[ ! -e /reference/reference-semantics && ! -L /reference/reference-semantics ]]; then
+  printf '%s\n' 'INFRASTRUCTURE_BREACH: supplied-semantics trusted tree is absent'
+  exit 70
+elif [[ -L /reference/reference-semantics || ! -d /reference/reference-semantics ]]; then
+  printf '%s\n' 'INFRASTRUCTURE_BREACH: trusted reference-semantics is symlinked or mistyped'
+  exit 70
+fi
+
+printf '%s\n' '== Trusted prompt and translator byte comparisons =='
+for audit_name in prompt.py py2mpy.py; do
+  if cmp -s "/candidate/$audit_name" "/reference/$audit_name"; then
+    printf 'BYTE_IDENTICAL: candidate/%s reference/%s\n' "$audit_name" "$audit_name"
+  else
+    report_failure "candidate/$audit_name differs from reference/$audit_name"
+    cmp -l "/candidate/$audit_name" "/reference/$audit_name" | head -n 20
+  fi
+done
+
+printf '%s\n' '== Candidate supplied-semantics recursive integrity =='
+if [[ -d /candidate/reference-semantics && ! -L /candidate/reference-semantics ]]; then
+  while IFS= read -r audit_rel; do
+    audit_ref="/reference/reference-semantics/$audit_rel"
+    audit_cand="/candidate/reference-semantics/$audit_rel"
+    if [[ ! -e "$audit_cand" && ! -L "$audit_cand" ]]; then
+      report_failure "missing candidate/reference-semantics/$audit_rel"
+      continue
+    fi
+    audit_ref_type=$(stat -c '%F' "$audit_ref")
+    audit_cand_type=$(stat -c '%F' "$audit_cand")
+    if [[ "$audit_cand_type" == 'symbolic link' ]]; then
+      report_failure "symlinked candidate/reference-semantics/$audit_rel"
+      continue
+    fi
+    if [[ "$audit_ref_type" != "$audit_cand_type" ]]; then
+      report_failure "mistyped candidate/reference-semantics/$audit_rel ($audit_cand_type versus $audit_ref_type)"
+      continue
+    fi
+    if [[ -f "$audit_ref" ]] && ! cmp -s "$audit_ref" "$audit_cand"; then
+      report_failure "changed candidate/reference-semantics/$audit_rel"
+    else
+      printf 'MATCH: candidate/reference-semantics/%s (%s)\n' "$audit_rel" "$audit_cand_type"
+    fi
+  done < <(cd /reference/reference-semantics && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort)
+
+  while IFS= read -r audit_rel; do
+    if [[ ! -e "/reference/reference-semantics/$audit_rel" && ! -L "/reference/reference-semantics/$audit_rel" ]]; then
+      report_failure "additional candidate/reference-semantics/$audit_rel"
+    fi
+  done < <(cd /candidate/reference-semantics && find . -mindepth 1 -printf '%P\n' | LC_ALL=C sort)
+fi
+
+printf '%s\n' '== Candidate symlink prohibition =='
+audit_symlink_count=$(find /candidate -xdev -type l -print | tee /dev/stderr | wc -l)
+if (( audit_symlink_count > 0 )); then
+  report_failure "candidate contains $audit_symlink_count symlink(s)"
+else
+  printf '%s\n' 'NO_CANDIDATE_SYMLINKS'
+fi
+
+printf 'INTEGRITY_FAILURE_COUNTED: %d\n' "$integrity_fail"
+exit "$integrity_fail"
diff --git a/evidence/bridge-context-witness.k b/evidence/bridge-context-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..9244f8ff3d6d314b621fbdffad85c2d9c89d9aa4
--- /dev/null
+++ b/evidence/bridge-context-witness.k
@@ -0,0 +1,108 @@
+requires "verification.k"
+
+// Concrete digit "1" with a module-level shadowing of ord. The fixed
+// semantics calls this closure and therefore classifies the digit as even.
+module BRIDGE-BASE-WITNESS
+  imports EVEN-ODD-VERIFICATION
+
+  claim
+    <k>
+      #loop(
+        str(iCons(49, .IntSeq)),
+        Name("digit"),
+        #digitLoopBody)
+    =>
+      .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "ord" |-> closureVal(
+          ("x", .ParamNames),
+          Return(Int(0)) .Stmts,
+          0),
+        parent(-1))
+      1  |-> scope(
+        "num"        |-> 1
+        "even_count" |-> 0
+        "odd_count"  |-> 0
+        "digit"      |-> 0,
+        parent(0))
+    =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "ord" |-> closureVal(
+          ("x", .ParamNames),
+          Return(Int(0)) .Stmts,
+          0),
+        parent(-1))
+      1  |-> scope(
+        "num"        |-> 1
+        "even_count" |-> 1
+        "odd_count"  |-> 0
+        "digit"      |-> str(iCons(49, .IntSeq)),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+// This is the opposite result. It is false under fixed semantics, but the
+// proof-local priority summary can establish it because its ellipses admit
+// the shadowed module scope and it never performs the ord lookup.
+module BRIDGE-SUMMARY-FALSE-WITNESS
+  imports EVEN-ODD-VERIFICATION-SUMMARY
+
+  claim
+    <k>
+      #loop(
+        str(iCons(49, .IntSeq)),
+        Name("digit"),
+        #digitLoopBody)
+    =>
+      .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "ord" |-> closureVal(
+          ("x", .ParamNames),
+          Return(Int(0)) .Stmts,
+          0),
+        parent(-1))
+      1  |-> scope(
+        "num"        |-> 1
+        "even_count" |-> 0
+        "odd_count"  |-> 0
+        "digit"      |-> 0,
+        parent(0))
+    =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "ord" |-> closureVal(
+          ("x", .ParamNames),
+          Return(Int(0)) .Stmts,
+          0),
+        parent(-1))
+      1  |-> scope(
+        "num"        |-> 1
+        "even_count" |-> 0
+        "odd_count"  |-> 1
+        "digit"      |-> str(iCons(49, .IntSeq)),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..ff2496b52097b6a27a7f0b017863f6252c8ba800
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,121 @@
+#!/usr/bin/env python3
+"""Independent differential check for HumanEval 155 on the integer domain."""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import random
+from pathlib import Path
+
+
+def load_entry(module_name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.even_odd_count
+
+
+canonical = load_entry(
+    "trusted_canonical", Path("/tmp/audit-work/trusted/canonical.py")
+)
+generated = load_entry(
+    "candidate_solution", Path("/tmp/audit-work/candidate-src/solution.py")
+)
+
+# The integer domain has no value whose abs-value has an empty decimal
+# representation. Zero is the unique minimal one-character boundary case.
+documented = [-12, 123]
+boundaries = [
+    0,
+    -1,
+    1,
+    -2,
+    2,
+    -9,
+    9,
+    -10,
+    10,
+    -11,
+    11,
+    -12,
+    12,
+    -19,
+    19,
+    -20,
+    20,
+    -99,
+    99,
+    -100,
+    100,
+    -101,
+    101,
+    -102,
+    102,
+    -24680,
+    24680,
+    -13579,
+    13579,
+    102030405,
+    10**50,
+    -(10**50),
+    int("20" * 50),
+    -int("13579" * 20),
+]
+exhaustive_small = list(range(-10_000, 10_001))
+
+rng = random.Random(155)
+generated_inputs = []
+for _ in range(2_000):
+    bit_count = rng.randint(0, 512)
+    value = rng.getrandbits(bit_count)
+    if rng.randrange(2):
+        value = -value
+    generated_inputs.append(value)
+
+inputs = list(
+    dict.fromkeys(documented + boundaries + exhaustive_small + generated_inputs)
+)
+Path("/audit-output/evidence/differential_inputs.json").write_text(
+    json.dumps(inputs, indent=2) + "\n", encoding="utf-8"
+)
+
+mismatches = []
+seen_digits = set()
+for number in inputs:
+    seen_digits.update(str(abs(number)))
+    expected = canonical(number)
+    actual = generated(number)
+    if expected != actual or type(expected) is not type(actual):
+        mismatches.append(
+            {
+                "input": number,
+                "canonical": repr(expected),
+                "generated": repr(actual),
+                "canonical_type": type(expected).__name__,
+                "generated_type": type(actual).__name__,
+            }
+        )
+
+summary = {
+    "oracle": "/tmp/audit-work/trusted/canonical.py:even_odd_count",
+    "implementation": "/tmp/audit-work/candidate-src/solution.py:even_odd_count",
+    "documented_examples": documented,
+    "empty_case": "not realizable for an integer; zero is the minimal decimal representation",
+    "input_count": len(inputs),
+    "exhaustive_interval": [-10_000, 10_000],
+    "deterministic_random_seed": 155,
+    "deterministic_random_count": len(generated_inputs),
+    "random_bit_width_range": [0, 512],
+    "decimal_digits_seen": sorted(seen_digits),
+    "mismatch_count": len(mismatches),
+    "first_mismatches": mismatches[:20],
+}
+print(json.dumps(summary, indent=2))
+
+if sorted(seen_digits) != list("0123456789"):
+    raise AssertionError("branch-driving decimal digits 0 through 9 were not all covered")
+if mismatches:
+    raise AssertionError(f"{len(mismatches)} differential mismatch(es)")
diff --git a/evidence/k_inventory.py b/evidence/k_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..cda8388aa09693c0f955c844033316953545b0a7
--- /dev/null
+++ b/evidence/k_inventory.py
@@ -0,0 +1,160 @@
+#!/usr/bin/env python3
+"""Emit an exhaustive declaration/rule index for the audited K sources."""
+
+from __future__ import annotations
+
+import re
+from collections import Counter
+from pathlib import Path
+
+
+ROOT = Path("/tmp/audit-work/candidate-src")
+SEMANTICS = ROOT / "reference-semantics"
+PROOF_FILES = [ROOT / "verification.k", ROOT / "spec.k"]
+
+ENTRY = re.compile(
+    r"^\s*(configuration|syntax|rule|claim|context(?:\s+alias)?|alias)\b"
+)
+ATTR = re.compile(
+    r"\b(function|total|functional|simplification|symbol|no-evaluators|"
+    r"priority|owise|macro|strict|seqstrict|concrete)\b"
+)
+
+# Terms on the actual solution path. A row that does not mention one of these
+# is still inventoried; it is classified as supplied/unreached for this proof.
+USED_TERMS = {
+    "#loadAll",
+    "#look",
+    "#evalArgs",
+    "#evalArgCont",
+    "#applyK",
+    "toCall",
+    "builtinsScope",
+    "appendVal",
+    "vals2valSeq",
+    "strToCodes",
+    "seqConcat",
+    "#iterNext",
+    "#iterDone",
+    "#iterYield",
+    "#loop",
+    "#loopStep",
+    "#loopLbl",
+    "#bindTgt",
+    "#branch",
+    "#bindP",
+    "#endcall",
+    "#pop",
+    "frame",
+    "closureVal",
+    "FuncDef",
+    "Return",
+    "Assign",
+    "AugAssign",
+    "If",
+    "For",
+    "Expr",
+    "Str",
+    "Int",
+    "Name",
+    "Call",
+    "BinOp",
+    "Compare",
+    "CmpOp",
+    "TupleExpr",
+    "applyBin",
+    "applyCmp",
+    "applyBuiltin",
+    "abs",
+    "ord",
+    "str",
+    "pyMod",
+    "Int2String",
+    "absInt",
+}
+
+
+def clean(text: str) -> str:
+    text = " ".join(
+        part.strip()
+        for part in text.splitlines()
+        if part.strip() and not part.lstrip().startswith("//")
+    )
+    return text.replace("|", r"\|")[:240]
+
+
+files = sorted(SEMANTICS.rglob("*.k")) + PROOF_FILES
+records = []
+for path in files:
+    lines = path.read_text(encoding="utf-8").splitlines()
+    starts = [i for i, line in enumerate(lines) if ENTRY.match(line)]
+    for pos, start in enumerate(starts):
+        stop = starts[pos + 1] if pos + 1 < len(starts) else len(lines)
+        block = "\n".join(lines[start:stop])
+        match = ENTRY.match(lines[start])
+        assert match is not None
+        kind = match.group(1).replace(" ", "-")
+        attrs = ",".join(sorted(set(ATTR.findall(block)))) or "-"
+        relative = path.relative_to(ROOT)
+        if path in PROOF_FILES:
+            provenance = "candidate-proof"
+            relevance = "PROOF_CRITICAL"
+        else:
+            provenance = "trusted-supplied"
+            relevance = (
+                "USED_PATH"
+                if any(term in block for term in USED_TERMS)
+                else "UNREACHED_BASELINE"
+            )
+        opaque = (
+            "OPAQUE_OR_EXTERNAL"
+            if re.search(r"\b(no-evaluators|concrete)\b|symbol\s*\(", block)
+            else "-"
+        )
+        records.append(
+            {
+                "file": str(relative),
+                "line": start + 1,
+                "kind": kind,
+                "attrs": attrs,
+                "provenance": provenance,
+                "relevance": relevance,
+                "opaque": opaque,
+                "text": clean(block),
+            }
+        )
+
+print("# Exhaustive K declaration and rule inventory")
+print()
+print(
+    "Each row is one `configuration`, `syntax`, `rule`, `claim`, `context`, "
+    "or `alias` declaration start. Multi-line text and attributes are folded "
+    "into that row. The candidate supplied-semantics tree was byte-identical "
+    "to the trusted reference tree."
+)
+print()
+print(f"Total entries: {len(records)}")
+print()
+print("Kinds:", dict(sorted(Counter(r["kind"] for r in records).items())))
+print(
+    "Provenance:",
+    dict(sorted(Counter(r["provenance"] for r in records).items())),
+)
+print(
+    "Relevance:",
+    dict(sorted(Counter(r["relevance"] for r in records).items())),
+)
+print()
+print(
+    "| # | Source | Kind | Attributes | Provenance | Relevance | "
+    "Opaque/external | Declaration or rule |"
+)
+print("|---:|---|---|---|---|---|---|---|")
+for number, record in enumerate(records, 1):
+    source = f"{record['file']}:{record['line']}"
+    print(
+        f"| {number} | `{source}` | {record['kind']} | "
+        f"{record['attrs']} | {record['provenance']} | "
+        f"{record['relevance']} | {record['opaque']} | "
+        f"{record['text']} |"
+    )
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..9811d58b1dbf2dda993a84a3971a26ba4805c18c
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+
+: > "$audit_log"
+exec > >(tee -a "$audit_log") 2>&1
+
+printf 'COMMAND:'
+printf ' %q' "$@"
+printf '\n'
+
+set +e
+"$@"
+audit_status=$?
+set -e
+
+printf 'EXIT_STATUS: %d\n' "$audit_status"
+exit "$audit_status"

exec
