+        parent(0))
+    =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "ord" |-> closureVal(
+          ("x", .ParamNames),
+          Return(Int(0)) .Stmts,
+          0),
+        parent(-1))
+      1  |-> scope(
+        "num"        |-> 1
+        "even_count" |-> 0
+        "odd_count"  |-> 1
+        "digit"      |-> str(iCons(49, .IntSeq)),
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
