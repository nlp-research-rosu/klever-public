Module(
  FuncDef("is_palindrome", Params("text"),
    Return(
      Compare(
        Name("text"),
        CmpOp(
          "==",
          Subscript(
            Name("text"),
            Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
  Assert(Call(Name("is_palindrome"), Str("")))
  Assert(Call(Name("is_palindrome"), Str("aba")))
  Assert(Call(Name("is_palindrome"), Str("aaaaa")))
  Assert(UnaryOp("not", Call(Name("is_palindrome"), Str("zbcd"))))
  Assert(Call(Name("is_palindrome"), Str("abccba")))
  Assert(UnaryOp("not", Call(Name("is_palindrome"), Str("abca")))))
