     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Mathematical contract: a code-point sequence is a palindrome exactly
     7	  // when it is structurally equal to the negative-step slice that reverses it.
     8	  syntax Bool ::= palindrome(IntSeq) [function]
     9	  rule palindrome(IS:IntSeq)
    10	    => IS ==K buildIS(IS, isLen(IS) -Int 1, -1, -1)
    11	endmodule
