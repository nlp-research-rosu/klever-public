     7	def is_palindrome(text: str):
     8	    """
     9	    Checks if given string is a palindrome
    10	    >>> is_palindrome('')
    11	    True
    12	    >>> is_palindrome('aba')
    13	    True
    14	    >>> is_palindrome('aaaaa')
    15	    True
    16	    >>> is_palindrome('zbcd')
    17	    False
    18	    """
    19	    for i in range(len(text)):
    20	        if text[i] != text[len(text) - 1 - i]:
    21	            return False
    22	    return True
