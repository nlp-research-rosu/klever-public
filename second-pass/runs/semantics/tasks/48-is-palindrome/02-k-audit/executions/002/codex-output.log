+          closureVal(
+            "text",
+            Return(
+              Compare(
+                Name("text"),
+                CmpOp(
+                  "==",
+                  Subscript(
+                    Name("text"),
+                    Slice(
+                      NoBound,
+                      NoBound,
+                      UnaryOp("-", Int(1)))))))
+            .Stmts,
+            0),
