/bin/bash -lc "/audit-output/evidence/run_logged.sh /audit-output/evidence/stage4-kast-constructor-comparison.log bash -lc 'set -e; kast solution.regenerated.mpy --definition audit-runtime-kompiled --module MPY-SYNTAX --sort Module --output kore --output-file solution.regenerated.kore; kast spec-executed-program-surface.mpy --definition audit-runtime-kompiled --module MPY-SYNTAX --sort Module --output kore --output-file spec-executed-program.kore; sha256sum solution.regenerated.kore spec-executed-program.kore; cmp -s solution.regenerated.kore spec-executed-program.kore; echo KAST_KORE_IDENTICAL'" in /tmp/audit-work/reconstruction-001
