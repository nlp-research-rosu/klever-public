+  // this destination is false.
+  claim
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "is_palindrome",
+            Params("text"),
+            Return(
+              Compare(
+                Name("text"),
+                CmpOp(
+                  "==",
+                  Subscript(
+                    Name("text"),
+                    Slice(
+                      NoBound,
+                      NoBound,
+                      UnaryOp("-", Int(1)))))))
+            .Stmts)))
+      ~> Call(Name("is_palindrome"), str(IS:IntSeq))
+    =>
+      notBool palindrome(IS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
