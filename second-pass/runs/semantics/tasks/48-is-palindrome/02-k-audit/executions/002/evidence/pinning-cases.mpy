Module(
  FuncDef("is_palindrome", Params("text"),
    Return(
      Compare(
        Name("text"),
        CmpOp(
          "==",
          Subscript(
            Name("text"),
            Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
  Assign(Name("empty_result"), Call(Name("is_palindrome"), Str("")))
  Assign(Name("odd_result"), Call(Name("is_palindrome"), Str("aba")))
  Assign(Name("even_result"), Call(Name("is_palindrome"), Str("abba")))
  Assign(
    Name("mismatch_result"),
    Call(Name("is_palindrome"), Str("zbcd"))))
