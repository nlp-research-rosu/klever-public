requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // Mathematical contract: a code-point sequence is a palindrome exactly
  // when it is structurally equal to the negative-step slice that reverses it.
  syntax Bool ::= palindrome(IntSeq) [function]
  rule palindrome(IS:IntSeq)
    => IS ==K buildIS(IS, isLen(IS) -Int 1, -1, -1)
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  claim
    <k>
      #loadAll(
        Module(
          FuncDef(
            "is_palindrome",
            Params("text"),
            Return(
              Compare(
                Name("text"),
                CmpOp(
                  "==",
                  Subscript(
                    Name("text"),
                    Slice(
                      NoBound,
                      NoBound,
                      UnaryOp("-", Int(1)))))))
            .Stmts)))
      ~> Call(Name("is_palindrome"), str(IS:IntSeq))
    =>
      palindrome(IS)
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    =>
      0 |-> scope(
        "is_palindrome" |->
          closureVal(
            "text",
            Return(
              Compare(
                Name("text"),
                CmpOp(
                  "==",
                  Subscript(
