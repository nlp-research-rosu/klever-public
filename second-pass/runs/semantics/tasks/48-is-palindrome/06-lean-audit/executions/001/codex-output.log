+seq=[97, 98] buildIS=[98, 97] python_reverse=[98, 97] palindrome=False
+seq=[97, 98, 97] buildIS=[97, 98, 97] python_reverse=[97, 98, 97] palindrome=True
+seq=[0, 127, 0] buildIS=[0, 127, 0] python_reverse=[0, 127, 0] palindrome=True
+seq=[97, 98, 99] buildIS=[99, 98, 97] python_reverse=[99, 98, 97] palindrome=False
