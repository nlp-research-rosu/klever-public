+ 'lean_workspace_sha256':None,
+ 'lean_invocation_sha256':None,
+}
+for name,actual in checks.items():
+    expected=resolution['hashes'][name]
+    print(f'{name}: expected={expected} actual={actual} match={expected==actual}')
+actual_sources={p.relative_to('/reference/k-proof').as_posix():pipeline_contract.sha256_file(p) for p in pipeline_contract._walk_regular_files(Path('/reference/k-proof'),'Stage 1 source workspace')}
+expected_sources=resolution['stage1_source_hashes']
+print(f'stage1_source_hashes: expected_count={len(expected_sources)} actual_count={len(actual_sources)} exact_keys={set(expected_sources)==set(actual_sources)} exact_values={expected_sources==actual_sources}')
+for name in sorted(set(expected_sources)|set(actual_sources)):
+    expected=expected_sources.get(name)
+    actual=actual_sources.get(name)
+    print(f'  {name}: expected={expected} actual={actual} match={expected==actual}')
+PY
