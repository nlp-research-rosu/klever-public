/bin/bash -lc "python3 - <<'PY'
import hashlib, json
from pathlib import Path
text=Path('/reference/k-proof/verification.k').read_text()
lines=text.splitlines()
span='\\n'.join(lines[8:10])
normalized=' '.join(span.split())
digest=hashlib.sha256(normalized.encode()).hexdigest()
rule={
 'source_rule_id':'rule-'+digest,
 'module':'VERIFICATION',
 'start_line':9,
 'end_line':10,
 'normalized_sha256':digest,
 'attributes':[],
 'text':span,
}
canonical=json.dumps([rule],sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()
inventory_hash=hashlib.sha256(canonical).hexdigest()
manifest=json.loads(Path('/reference/lemma-discovery.json').read_text())
manifest_ids=[entry['source_rule_id'] for entry in manifest['rules']]
print('source_span=verification.k:9-10')
print('source_text='+repr(span))
print('normalized='+repr(normalized))
print('normalized_sha256='+digest)
print('source_rule_id='+rule['source_rule_id'])
print('inventory_canonical_json='+canonical.decode())
print('inventory_sha256='+inventory_hash)
print('manifest_inventory_sha256='+manifest['inventory_sha256'])
print('inventory_hash_match='+str(inventory_hash==manifest['inventory_sha256']))
print('canonical_rule_ids='+json.dumps([rule['source_rule_id']]))
print('manifest_rule_ids='+json.dumps(manifest_ids))
print('ordered_bijection='+str(manifest_ids==[rule['source_rule_id']] and len(set(manifest_ids))==1))
print('classification='+manifest['rules'][0]['classification'])
