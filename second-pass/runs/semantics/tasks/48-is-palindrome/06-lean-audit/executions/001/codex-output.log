+COMMAND
+PYTHONPATH=/reference python3 - <<'PY'
+import hashlib, json, re
+from pathlib import Path
+from tools import klean_export
+from tools.k_rule_inventory import inventory_verification
+workspace=Path('/reference/k-proof')
+discovery=json.loads(Path('/reference/lemma-discovery.json').read_text())
+input_manifest=json.loads(Path('/reference/klean-generation/input-manifest.json').read_text())
+generator=json.loads(Path('/reference/klean-generation/generator-manifest.json').read_text())
+obligation_path=Path('/reference/klean-generation/generated/obligation-map.json')
+obligation_map=json.loads(obligation_path.read_text())
+audit=json.loads(Path('/audit-input.json').read_text())['resolution']
+canonical=inventory_verification(workspace)['rules']
+classification_by_id={x['source_rule_id']:x['classification'] for x in discovery['rules']}
+independent_domain=[r for r in canonical if classification_by_id[r['source_rule_id']]=='DOMAIN_LEMMA']
+expected_ids=[r['source_rule_id'] for r in independent_domain]
+source_ids=[r['source_rule_id'] for r in obligation_map['source_rules']]
+obligation_ids=[r['source_rule_id'] for r in obligation_map['obligations']]
+print('canonical_rule_count='+str(len(canonical)))
+print('independently_reclassified_domain_count='+str(len(independent_domain)))
+print('expected_domain_ids='+json.dumps(expected_ids))
+print('input_manifest_source_rules='+json.dumps(input_manifest['source_rules'],sort_keys=True))
+print('obligation_map_source_rules='+json.dumps(obligation_map['source_rules'],sort_keys=True))
+print('obligation_map_obligations='+json.dumps(obligation_map['obligations'],sort_keys=True))
+print('obligation_map_trust_parameters='+json.dumps(obligation_map['trust_parameters'],sort_keys=True))
+print('ordered_source_bijection='+str(source_ids==expected_ids and len(source_ids)==len(set(source_ids))))
+print('ordered_obligation_bijection='+str(obligation_ids==expected_ids and len(obligation_ids)==len(set(obligation_ids))))
+print('no_vacuous_conjuncts='+str(len(obligation_map['obligations'])==0))
+map_hash=hashlib.sha256(obligation_path.read_bytes()).hexdigest()
+print('obligation_map_sha256='+map_hash)
+print('generator_obligation_map_sha256='+generator['obligation_map_sha256'])
+print('obligation_map_hash_match='+str(map_hash==generator['obligation_map_sha256']))
+print('generator_obligation_count='+str(generator['obligation_count']))
+print('generator_target='+json.dumps(generator['target']))
+print('audit_target='+json.dumps(audit['target']))
+print('computed_target='+json.dumps(klean_export.target_statement(Path('/reference/klean-generation/generated'))))
+print('expected_target_definition='+json.dumps(klean_export.expected_target_definition(obligation_map)))
+print('target_module_exists='+str((Path('/reference/klean-generation/generated')/'Klean48IsPalindrome'/'KleanObligations.lean').exists()))
+lean_text='\n'.join(p.read_text() for p in Path('/reference/klean-generation/generated').rglob('*.lean'))
+print('target_token_occurrences='+str(len(re.findall(r'\bTarget\b',lean_text))))
+print('candidate_exists='+str(Path('/candidate').exists()))
+print('stage5_result='+json.dumps(audit['stage5_result']))
+print('status_consistent='+str(generator['obligation_count']==0 and generator['target'] is None and audit['target'] is None and not Path('/candidate').exists()))
+PY
+
+EXIT CODE
+0
+
