+COMMAND
+pwd
+printenv AUDIT_MODE
+PYTHONPATH=/reference python3 - <<'PY'
+import json
+from pathlib import Path
+from tools.stage6_resolution_contract import verify_audit_input
+document = json.loads(Path('/audit-input.json').read_text())
+resolution, digest = verify_audit_input(document)
+print('mode=' + resolution['mode'])
