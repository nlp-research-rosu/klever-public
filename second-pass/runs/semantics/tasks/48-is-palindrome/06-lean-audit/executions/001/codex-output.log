+     1	requires "reference-semantics/semantics.k"
+     2	
+     3	module VERIFICATION
+     4	  imports MPY
+     5	
+     6	  // Mathematical contract: a code-point sequence is a palindrome exactly
+     7	  // when it is structurally equal to the negative-step slice that reverses it.
+     8	  syntax Bool ::= palindrome(IntSeq) [function]
+     9	  rule palindrome(IS:IntSeq)
+    10	    => IS ==K buildIS(IS, isLen(IS) -Int 1, -1, -1)
+    11	endmodule
+
+COMMAND
+rg -n --glob '*.k' --glob '*.mpy' --glob '*.py' 'palindrome|buildIS\(|isLen\(|applyCmp\("==", str|Subscript\(OBJ:Val, Slice|slStart\(noB|slStop\(noB|slStep\(someB' /reference/k-proof
+
+EXIT CODE
+0
+
+OUTPUT (selected raw matches for the verification rule and frozen operational path)
+/reference/k-proof/spec.k:11:            "is_palindrome",
+/reference/k-proof/spec.k:25:      ~> Call(Name("is_palindrome"), str(IS:IntSeq))
+/reference/k-proof/spec.k:27:      palindrome(IS)
