+/reference/k-proof/reference-semantics/semantics/subscript.k:69:    => str(buildIS(IS, slStart(LO, ST, isLen(IS)), slStop(HI, ST, isLen(IS)), slStep(ST)))
+/reference/k-proof/reference-semantics/semantics/subscript.k:74:  rule slStep(someB(S:Int)) => S
+/reference/k-proof/reference-semantics/semantics/subscript.k:77:  rule slStart(noB,          ST:OptInt, _LEN:Int) => 0
+/reference/k-proof/reference-semantics/semantics/subscript.k:79:  rule slStart(noB,          ST:OptInt, LEN:Int)  => LEN -Int 1
+/reference/k-proof/reference-semantics/semantics/subscript.k:84:  rule slStop(noB,          ST:OptInt, LEN:Int)  => LEN
+/reference/k-proof/reference-semantics/semantics/subscript.k:86:  rule slStop(noB,          ST:OptInt, _LEN:Int) => -1
+/reference/k-proof/reference-semantics/semantics/subscript.k:116:  syntax IntSeq ::= buildIS(IntSeq, Int, Int, Int) [function]
+/reference/k-proof/reference-semantics/semantics/subscript.k:117:  rule buildIS(IS:IntSeq, I:Int, STOP:Int, STEP:Int)
+/reference/k-proof/reference-semantics/semantics/subscript.k:118:    => iCons(intSeqAt(IS, I), buildIS(IS, I +Int STEP, STOP, STEP))
+/reference/k-proof/reference-semantics/semantics/subscript.k:120:  rule buildIS(_:IntSeq, I:Int, STOP:Int, STEP:Int) => .IntSeq
+/reference/k-proof/reference-semantics/semantics/core.k:227:  syntax Int ::= isLen(IntSeq) [function, total]
+/reference/k-proof/reference-semantics/semantics/core.k:228:  rule isLen(.IntSeq)                => 0
+/reference/k-proof/reference-semantics/semantics/core.k:229:  rule isLen(iCons(_:Int, S:IntSeq)) => 1 +Int isLen(S)
+/reference/k-proof/reference-semantics/semantics/str.k:25:  rule applyCmp("==", str(A:IntSeq), str(B:IntSeq)) => A ==K B
+/reference/k-proof/solution.py:1:def is_palindrome(text: str):
+
+COMMAND
+python3 - <<'PY'
+from itertools import product
+def int_seq_at(seq,i):
+    if not seq or i < 0 or i >= len(seq):
+        raise IndexError('stuck intSeqAt')
+    return seq[i]
+def build_is(seq,i,stop,step):
+    out=[]
+    while (step > 0 and i < stop) or (step < 0 and i > stop):
+        out.append(int_seq_at(seq,i))
+        i += step
+    return out
+cases=[[],[97],[97,98],[97,98,97],[0,127,0],[97,98,99]]
+for seq in cases:
+    reversed_by_rules=build_is(seq,len(seq)-1,-1,-1)
+    print(f'seq={seq} buildIS={reversed_by_rules} python_reverse={seq[::-1]} palindrome={seq==reversed_by_rules}')
+print('exhaustive_small_alphabet_len_le_5='+str(all(build_is(list(xs),len(xs)-1,-1,-1)==list(xs)[::-1] for n in range(6) for xs in product(range(3),repeat=n))))
+print('counterfactual_identity_ab='+str([97,98]==[97,98]))
+print('actual_definition_ab='+str([97,98]==build_is([97,98],1,-1,-1)))
+print('counterfactual_constant_true_ab=True')
+print('counterfactual_step_plus_one_ab='+str(build_is([97,98],1,-1,1)))
+PY
+
+EXIT CODE
+0
+
