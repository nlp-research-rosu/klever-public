+COMMAND
+python3 - <<'PY'
+from itertools import product
+def int_seq_at(seq,i):
+    if not seq or i < 0 or i >= len(seq):
+        raise IndexError('stuck intSeqAt')
+    return seq[i]
+def build_is(seq,i,stop,step):
+    out=[]
+    while (step > 0 and i < stop) or (step < 0 and i > stop):
+        out.append(int_seq_at(seq,i))
+        i += step
+    return out
+cases=[[],[97],[97,98],[97,98,97],[0,127,0],[97,98,99]]
+for seq in cases:
+    reversed_by_rules=build_is(seq,len(seq)-1,-1,-1)
+    print(f'seq={seq} buildIS={reversed_by_rules} python_reverse={seq[::-1]} palindrome={seq==reversed_by_rules}')
+print('exhaustive_small_alphabet_len_le_5='+str(all(build_is(list(xs),len(xs)-1,-1,-1)==list(xs)[::-1] for n in range(6) for xs in product(range(3),repeat=n))))
+print('counterfactual_identity_ab='+str([97,98]==[97,98]))
+print('actual_definition_ab='+str([97,98]==build_is([97,98],1,-1,-1)))
+print('counterfactual_constant_true_ab=True')
