     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Translate the submitted implementation with the fixed front end.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# Compile and run concrete assertions through the required LLVM semantics.
     8	python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
     9	kompile reference-semantics/semantics.k \
    10	  --backend llvm \
    11	  --main-module MPY-KRUN \
    12	  --syntax-module MPY-SYNTAX \
    13	  --output-definition runtime-kompiled
    14	krun concrete-tests.mpy --definition runtime-kompiled
    15	
    16	# Compile the symbolic extension without the concrete-only module, then prove
    17	# every claim in SPEC. Successful proof output is exactly #Top (plus warnings).
    18	kompile verification.k \
    19	  --backend haskell \
    20	  --main-module VERIFICATION \
    21	  --syntax-module MPY-SYNTAX \
    22	  --output-definition verification-kompiled
    23	kprove spec.k \
    24	  --definition verification-kompiled \
    25	  --spec-module SPEC
