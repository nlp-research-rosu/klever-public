+def _is_prime_from(n, divisor):
+    if divisor * divisor > n:
+        return True
+    if n % divisor == 0:
+        return False
+    return _is_prime_from(n, divisor + 1)
+
+
+def _is_prime(n):
+    if n < 2:
+        return False
+    return _is_prime_from(n, 2)
+
+
+def _digit_sum(n):
+    if n == 0:
+        return 0
+    return n % 10 + _digit_sum(n // 10)
+
+
+def skjkasdkd(lst):
+    largest = 0
+    for number in lst:
+        if number > largest and _is_prime(number):
+            largest = number
+    return _digit_sum(largest)
