+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "skjkasdkd" |-> closureVal(
+          ("lst", .ParamNames),
+          Return(Int(1)),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
