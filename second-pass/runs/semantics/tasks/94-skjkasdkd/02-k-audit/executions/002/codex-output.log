+++ b/evidence/04-body-sensitivity.sh
@@ -0,0 +1,135 @@
+#!/usr/bin/env bash
+set -u
+
+evidence=/audit-output/evidence
+work=/tmp/audit-work/body-mutation
+overall=0
+
+run_logged() {
+  local name="$1"
+  shift
+  local log="$evidence/$name.log"
+  {
+    printf 'COMMAND:'
+    printf ' %q' "$@"
+    printf '\n'
+    "$@"
+    rc=$?
+    echo "EXIT_STATUS=$rc"
+  } > "$log" 2>&1
+  echo "$name exit=$rc"
+  return "$rc"
+}
+
+{
