    timeout 30s kprove totality-probe.k --definition reviewer-verification-kompiled --spec-module TOTALITY-PROBE --claims "TOTALITY-PROBE.$label" --output pretty
    rc=$?
    echo "EXIT_STATUS=$rc"
  } > "$log" 2>&1
  echo "$label rc=$rc"
done
