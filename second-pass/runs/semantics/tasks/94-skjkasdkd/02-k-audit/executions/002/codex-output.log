diff --git a//tmp/audit-work/body-mutation/body-mut-ground-bridge.k b//tmp/audit-work/body-mutation/body-mut-ground-bridge.k
new file mode 100644
index 0000000000000000000000000000000000000000..d7d9252fe900a212f59a86c5092670ca34eb3524
--- /dev/null
+++ b//tmp/audit-work/body-mutation/body-mut-ground-bridge.k
@@ -0,0 +1,34 @@
+requires "verification-body-mut.k"
