+#!/usr/bin/env python3
+"""Build a fresh concrete K harness around the copied submitted program."""
+
+from pathlib import Path
+
+
+SOLUTION = Path("/tmp/audit-work/reconstruction/solution.py")
+HARNESS = Path("/tmp/audit-work/reconstruction/audit-concrete.py")
+
+ASSERTIONS = r'''
+
+assert skjkasdkd([]) == 0
+assert skjkasdkd([-5, -1, 0]) == 0
+assert skjkasdkd([1]) == 0
+assert skjkasdkd([2]) == 2
+assert skjkasdkd([3]) == 3
+assert skjkasdkd([4]) == 0
+assert skjkasdkd([5]) == 5
+assert skjkasdkd([9]) == 0
+assert skjkasdkd([49]) == 0
+assert skjkasdkd([97, 101, 99]) == 2
+assert skjkasdkd([0, 3, 2, 1, 3, 5, 7, 4, 5, 5, 5, 2, 181, 32, 4, 32, 3, 2, 32, 324, 4, 3]) == 10
+assert skjkasdkd([1, 0, 1, 8, 2, 4597, 2, 1, 3, 40, 1, 2, 1, 2, 4, 2, 5, 1]) == 25
+assert skjkasdkd([1, 3, 1, 32, 5107, 34, 83278, 109, 163, 23, 2323, 32, 30, 1, 9, 3]) == 13
+assert skjkasdkd([0, 724, 32, 71, 99, 32, 6, 0, 5, 91, 83, 0, 5, 6]) == 11
+assert skjkasdkd([0, 81, 12, 3, 1, 21]) == 3
+assert skjkasdkd([0, 8, 1, 2, 1, 7]) == 7
+'''
+
+
+HARNESS.write_text(
+    SOLUTION.read_text(encoding="utf-8").rstrip() + ASSERTIONS + "\n",
+    encoding="utf-8",
+)
+print(HARNESS)
