+      Proof._Map_
+      Proof.«_in_keys(_)_MAP_Bool_KItem_Map»
+      Proof.«_[_<-undef]»
+      Proof.«_|->_»
+      Proof.«Map:update»
+      Proof.notBool_ :=
+  Proof.final
diff --git a//tmp/audit-work/map-bridge-audit.k b//tmp/audit-work/map-bridge-audit.k
