+example :
+    Klean94Skjkasdkd.Lemmas.targetStatement
+      Proof._Map_
+      Proof.«_in_keys(_)_MAP_Bool_KItem_Map»
+      Proof.«_[_<-undef]»
+      Proof.«_|->_»
+      Proof.«Map:update»
+      Proof.notBool_ :=
+  Proof.final
