    34	private theorem filter_missing_key
    35	    (key : SortKItem) (entries : List (SortKItem × SortKItem))
    36	    (h : !(entries.any (fun entry => sameKey entry.1 key)) = true) :
    37	    entries.filter (fun entry => !(sameKey entry.1 key)) = entries := by
    38	  induction entries with
    39	  | nil =>
    40	      rfl
    41	  | cons entry rest ih =>
    42	      cases hkey : sameKey entry.1 key with
    43	      | false =>
    44	          have hrest :
    45	              !(rest.any (fun item => sameKey item.1 key)) = true := by
    46	            simpa [hkey] using h
    47	          rw [List.filter_cons]
    48	          simp only [hkey, Bool.not_false, if_true]
    49	          rw [ih hrest]
