@@ -0,0 +1,78 @@
+python3 - <<'PY'
+import json
+from pathlib import Path
+
+target = json.loads(
+    Path("/reference/klean-generation/generator-manifest.json").read_text()
+)["target"]
+judgments = {
+    "_Map_": {
+        "candidate_lines": [14, 15],
+        "judgment": "FAIL",
+        "reason": (
+            "List append is order-sensitive and always returns a SortMap. "
+            "K MAP.concat is associative/commutative with .Map as unit and "
+            "fails on overlapping keys. The compiled witnesses show K treats "
+            "two disjoint maps as equal after swapping, while this candidate "
+            "function provably returns unequal SortMap values."
+        ),
+    },
+    "«_in_keys(_)_MAP_Bool_KItem_Map»": {
+        "candidate_lines": [17, 19],
+        "judgment": "ALIGNED_ON_VALID_UNIQUE_KEY_LISTS",
+        "reason": (
+            "List.any with mathematical key equality implements membership "
+            "when the list represents a valid unique-key K Map; it does not "
+            "establish or preserve the missing representation invariant."
+        ),
+    },
+    "«_[_<-undef]»": {
+        "candidate_lines": [21, 22],
+        "judgment": "ALIGNED_ON_VALID_UNIQUE_KEY_LISTS",
+        "reason": (
+            "Filtering the named key implements deletion extensionally on a "
+            "valid unique-key list representation."
+        ),
+    },
+    "«_|->_»": {
+        "candidate_lines": [24, 25],
+        "judgment": "ALIGNED",
+        "reason": "A singleton key/value list represents one K Map element.",
+    },
+    "«Map:update»": {
+        "candidate_lines": [27, 29],
+        "judgment": "ALIGNED_ONLY_EXTENSIONALLY",
+        "reason": (
+            "Filter-old-then-prepend implements update on valid unique-key "
+            "lists, but operates inside the order-sensitive, noncanonical "
+            "SortMap representation and does not repair the concat mismatch."
+        ),
+    },
+    "notBool_": {
+        "candidate_lines": [31, 32],
+        "judgment": "ALIGNED",
+        "reason": "Lean Bool negation matches the K BOOL.not hook.",
+    },
+}
+for parameter in target["parameters"]:
+    name = parameter["name"]
+    judgments[name].update({
+        "kore_symbol": parameter["kore_symbol"],
+        "source_rule_ids": parameter["source_rule_ids"],
+        "type": parameter["type"],
+    })
+print(json.dumps({
+    "parameters": [
+        {"name": parameter["name"], **judgments[parameter["name"]]}
+        for parameter in target["parameters"]
+    ],
+    "all_target_parameters_located_exactly_once": True,
+    "overall_operational_bridge": "FAIL",
+    "adversarial_evidence": [
+        "/audit-output/evidence/08_bridge_adversarial.result.txt",
+        "/audit-output/evidence/09_k_map_witness.second-rerun.result.txt",
+        "/audit-output/evidence/AuditBridge.lean",
+        "/audit-output/evidence/AuditDegenerate.lean",
+    ],
+}, indent=2, sort_keys=True))
+PY
