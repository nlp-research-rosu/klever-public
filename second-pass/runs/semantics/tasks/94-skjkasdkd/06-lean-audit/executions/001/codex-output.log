+    ),
+    "proved_derived_lemmas": (
+        input_manifest["proved_derived_lemmas"]
+        == validated["proved_derived_lemmas"]
+    ),
+    "domain_source_rules": (
+        input_manifest["source_rules"] == obligation_map["source_rules"]
+    ),
+}
+
+actual_target = target_statement(generated)
+base_target = target_statement(base)
+expected_definition = expected_target_definition(obligation_map)
+candidate_text = (candidate / "Proof.lean").read_text()
+forbidden = {
+    token: [
+        line_number
+        for line_number, line in enumerate(candidate_text.splitlines(), 1)
+        if re.search(rf"\b{token}\b", line)
+    ]
+    for token in ("sorry", "admit", "unsafe")
+}
+candidate_target_declarations = [
+    line_number
+    for line_number, line in enumerate(candidate_text.splitlines(), 1)
+    if re.search(r"^\s*(?:def|theorem|opaque|axiom)\s+targetStatement\b", line)
+]
+
+result = {
+    "recorded_tree_hashes": {
+        "actual": actual_pipeline_hashes,
+        "expected": expected_pipeline_hashes,
+        "all_match": actual_pipeline_hashes == expected_pipeline_hashes,
+    },
+    "stage1_export_tree_sha256": tree_digest(workspace),
+    "stage1_export_tree_matches_audit_input": (
+        tree_digest(workspace)
+        == audit_input["hashes"]["stage1_export_sha256"]
+    ),
+    "generated_tree_sha256": tree_digest(generated),
+    "generated_tree_matches_every_record": all(
+        tree_digest(generated) == value
+        for value in (
+            audit_input["hashes"]["generated_tree_sha256"],
+            input_manifest["frozen_input_sha256"]
+            and generator_manifest["generated_tree_sha256"],
+            export_result["generated_tree_sha256"],
+        )
+    ),
+    "base_tree_sha256_after_build": tree_digest(base),
+    "base_is_exact_generated_tree_after_build": (
+        tree_digest(base) == tree_digest(generated)
+    ),
+    "discovery_manifest_sha256": hashlib.sha256(
+        discovery_path.read_bytes()
+    ).hexdigest(),
+    "discovery_hash_matches_audit_input": (
+        hashlib.sha256(discovery_path.read_bytes()).hexdigest()
+        == audit_input["hashes"]["discovery_manifest_sha256"]
+    ),
+    "stage1_source_hash_count": len(actual_stage1_source_hashes),
+    "stage1_source_hashes_match_audit_input": (
+        actual_stage1_source_hashes == audit_input["stage1_source_hashes"]
+    ),
+    "verification_sha256": sha256_file(workspace / "verification.k"),
+    "verification_hash_matches_input_manifest": (
+        sha256_file(workspace / "verification.k")
+        == input_manifest["verification_sha256"]
+    ),
+    "classification_groups_match_input_manifest": (
+        classification_groups_match_input_manifest
+    ),
+    "obligation_bijection": {
+        "domain_ids": domain_ids,
+        "source_rule_ids": source_rule_ids,
+        "obligation_ids": obligation_ids,
+        "same_order": domain_ids == source_rule_ids == obligation_ids,
+        "all_unique": (
+            len(set(domain_ids))
+            == len(domain_ids)
+            == len(set(source_rule_ids))
+            == len(source_rule_ids)
+            == len(set(obligation_ids))
+            == len(obligation_ids)
+        ),
+        "per_obligation": obligation_checks,
+        "obligation_map_sha256": sha256_file(
+            generated / "obligation-map.json"
+        ),
+        "obligation_map_hash_matches_generator_manifest": (
+            sha256_file(generated / "obligation-map.json")
+            == generator_manifest["obligation_map_sha256"]
+        ),
+    },
+    "target_identity": {
+        "actual_target": actual_target,
+        "base_target_after_build": base_target,
+        "generator_manifest_target": generator_manifest["target"],
+        "audit_input_target": audit_input["target"],
+        "audit_input_preflight_target": audit_input["stage4_preflight"]["target"],
+        "all_target_records_equal": (
+            actual_target
+            == base_target
+            == generator_manifest["target"]
+            == audit_input["target"]
+            == audit_input["stage4_preflight"]["target"]
+        ),
+        "expected_definition_sha256": sha256_text(expected_definition),
+        "expected_definition_hash_matches_target": (
+            sha256_text(expected_definition)
+            == generator_manifest["target"]["definition_sha256"]
+        ),
+    },
+    "candidate_policy": {
+        "forbidden_token_lines": forbidden,
+        "new_axiom_or_opaque_declarations": lean_trust_declarations(
+            candidate / "Proof.lean"
+        ),
+        "candidate_target_statement_declarations": candidate_target_declarations,
+    },
+}
+print(json.dumps(result, indent=2, sort_keys=True))
+PY
