bridge_code=$?
printf '"'EXIT_CODE=%s\\n' \""'$bridge_code" >> /audit-output/evidence/08_bridge_adversarial.result.txt
sed -n '"'1,240p' /audit-output/evidence/08_bridge_adversarial.result.txt
exit \""'$bridge_code"' in /tmp/audit-work/94-skjkasdkd-stage6-proof
