    76	        have hupdated :
    77	            (X, V) :: entries.filter (fun entry => !(sameKey entry.1 X)) =
    78	              (X, V) :: entries :=
    79	          congrArg (List.cons (X, V)) hfilter
    80	        simpa [_Map_, «_|->_», «Map:update»] using
    81	          congrArg SortMap.mk hupdated
    82	
    83	end Proof
