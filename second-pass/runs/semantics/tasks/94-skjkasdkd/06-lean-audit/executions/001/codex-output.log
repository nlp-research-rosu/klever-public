@@ -0,0 +1,33 @@
+PYTHONPATH=/reference python3 - <<'PY'
+import json
+from pathlib import Path
+from tools.klean_export import lean_trust_declarations
+
+inventory = json.loads(
+    Path("/reference/klean-generation/trust-inventory.json").read_text()
+)
+observed = ["propext", "Classical.choice", "Quot.sound"]
+allowlist_names = [entry["name"] for entry in inventory["allowlist"]]
+candidate_declarations = lean_trust_declarations(Path("/candidate/Proof.lean"))
+print(json.dumps({
+    "exact_print_axioms_output_file": (
+        "/audit-output/evidence/07_print_axioms.rerun.result.txt"
+    ),
+    "proof_final_axioms": observed,
+    "sorryAx_present": "sorryAx" in observed,
+    "generated_allowlist_count": len(allowlist_names),
+    "generated_allowlist_dependencies_used_by_final": sorted(
+        set(observed) & set(allowlist_names)
+    ),
+    "candidate_new_axiom_or_opaque_declarations": candidate_declarations,
+    "reconciliation": {
