diff --git a//tmp/lean-host-pid.c b//tmp/lean-host-pid.c
new file mode 100644
index 0000000000000000000000000000000000000000..009d1e6984597948167686e87d8f4bf04e4c9521
--- /dev/null
+++ b//tmp/lean-host-pid.c
@@ -0,0 +1,47 @@
+#define _GNU_SOURCE
+
+#include <ctype.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The command sandbox uses a PID namespace but exposes the host /proc mount.
+ * Lean asks for /proc/getpid()/exe, so return the host-side Pid reported by
+ * /proc/self/status.  This file and its shared object stay outside the proof
+ * workspace and are only a launcher compatibility shim.
+ */
+pid_t getpid(void) {
+  char status[4096];
+  int fd = open("/proc/self/status", O_RDONLY);
+  if (fd >= 0) {
+    ssize_t count = read(fd, status, sizeof(status) - 1);
+    close(fd);
+    if (count > 0) {
+      status[count] = '\0';
+      const char *line = status;
+      while (line != NULL && *line != '\0') {
+        if (strncmp(line, "Pid:", 4) == 0) {
+          const char *digits = line + 4;
+          while (*digits != '\0' && isspace((unsigned char)*digits)) {
+            ++digits;
+          }
+          long host_pid = strtol(digits, NULL, 10);
+          if (host_pid > 0) {
+            return (pid_t)host_pid;
+          }
+          break;
+        }
+        line = strchr(line, '\n');
+        if (line != NULL) {
+          ++line;
+        }
+      }
+    }
+  }
+  return (pid_t)syscall(SYS_getpid);
+}
