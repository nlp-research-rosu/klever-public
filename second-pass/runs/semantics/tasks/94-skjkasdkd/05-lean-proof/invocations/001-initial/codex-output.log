def ByteArray.decEq (a b : ByteArray) : Decidable (Eq a b) :=
  match a, b with
  | ⟨⟨al⟩⟩, ⟨⟨bl⟩⟩ => match List.hasDecEq al bl with
    | isTrue t => isTrue (by rw [t])
    | isFalse f => isFalse (by simp [f])

instance: DecidableEq SortBytes := ByteArray.decEq

