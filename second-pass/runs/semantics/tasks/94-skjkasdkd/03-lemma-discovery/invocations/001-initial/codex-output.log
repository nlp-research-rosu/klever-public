   111	  rule <k> If(Name(X:String), T:Stmts, E:Stmts)
   112	        => #branch(truthy(V), T, E) ... </k>
   113	       <env> L:Int </env>
   114	       <scopes> ... L |-> scope((X |-> V:Val) M:Map, _:Parent) ... </scopes>
   115	       requires notBool (X in_keys(M))
   116	         andBool notBool ("$cells" in_keys((X |-> V) M))
