    90	  // Strictness-normalized forms used by the outer list loop.
    91	  rule <k> Compare(Name(X:String), CmpOp(OP:String, Name(Y:String)))
    92	        => applyCmp(OP, A, B) ... </k>
    93	       <env> L:Int </env>
    94	       <scopes> ... L |-> scope(
    95	         (X |-> A:Val) (Y |-> B:Val) M:Map,
    96	         _:Parent) ... </scopes>
    97	       requires X =/=String Y
    98	         andBool notBool (X in_keys(M))
    99	         andBool notBool (Y in_keys(M))
   100	         andBool notBool ("$cells" in_keys((X |-> A) (Y |-> B) M))
   101	       [priority(38)]
