   166	  rule <k>
   167	         Assign(
   168	           Name("prime"),
   169	           Compare(Name("number"), CmpOp(">=", Int(2))))
   170	        => Assign(Name("prime"), N >=Int 2) ...
   171	       </k>
   172	       <env> L:Int </env>
   173	       <scopes> ... L |-> scope(("number" |-> N:Int) M:Map, _:Parent) ... </scopes>
   174	       requires notBool ("number" in_keys(M))
