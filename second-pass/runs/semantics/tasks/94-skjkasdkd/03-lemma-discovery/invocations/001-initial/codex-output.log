   142	  rule <k>
   143	         Call(
   144	           Name("skjkasdkd"),
   145	           (list(asVals(IS:IntList)), .Exprs))
   146	        => #applyK(
   147	             toCall(closureVal(
   148	               ("lst", .ParamNames),
   149	               #functionBody,
   150	               0)),
   151	             (list(asVals(IS)), .Vals)) ...
   152	       </k>
   153	       <env> 0 </env>
   154	       <scopes>
   155	         ... 0 |-> scope(
   156	           ("skjkasdkd" |-> closureVal(
   157	             ("lst", .ParamNames),
   158	             #functionBody,
   159	             0))
   160	           M:Map,
   161	           parent(-1)) ...
   162	       </scopes>
   163	       requires notBool ("skjkasdkd" in_keys(M))
   164	       [priority(38)]
