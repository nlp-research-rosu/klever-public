--- prove.sh ---
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# The required translation artifact.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# Concrete LLVM execution: the six prompt examples and four edge cases are
     8	# assertions in concrete-tests.py.
     9	python3 - <<'PY'
    10	import ast
    11	
    12	def first_function(path):
    13	    with open(path, encoding="utf-8") as source:
    14	        tree = ast.parse(source.read(), filename=path)
    15	    return next(node for node in tree.body if isinstance(node, ast.FunctionDef))
    16	
    17	assert ast.dump(first_function("solution.py")) == ast.dump(first_function("concrete-tests.py"))
    18	PY
    19	python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
    20	kompile reference-semantics/semantics.k \
    21	  --backend llvm \
    22	  --main-module MPY-KRUN \
    23	  --syntax-module MPY-SYNTAX \
    24	  --output-definition runtime-kompiled
    25	krun concrete-tests.mpy --definition runtime-kompiled
    26	
    27	# Symbolic definition: VERIFICATION imports MPY, never MPY-CONCRETE.
    28	kompile verification.k \
    29	  --backend haskell \
    30	  --main-module VERIFICATION \
    31	  --syntax-module VERIFICATION \
    32	  --output-definition verification-kompiled \
    33	  -I .
    34	
    35	# Prove each invariant before admitting it as a trusted dependency of a later
    36	# modular proof command.
    37	kprove spec.k \
    38	  --definition verification-kompiled \
    39	  --spec-module SPEC \
    40	  --claims SPEC.prime-loop \
    41	  --output pretty
    42	
    43	kprove spec.k \
