--- verification.k ---
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Explicit form of Map deletion used by function-frame teardown.
     7	  rule (((X:KItem |-> _:KItem) M:Map) [ X <- undef ]) => M
     8	       requires notBool (X in_keys(M))
     9	       [simplification]
    10	  rule (M:Map [ X:KItem <- V:KItem ]) => (X |-> V) M
    11	       requires notBool (X in_keys(M))
    12	       [simplification]
    13	
    14	  // Proof-normalization lemmas for ordinary (non-closure-cell) frames.  These
    15	  // are guarded specializations of MPY's existing rules; the priority prevents
    16	  // the symbolic prover from exploring impossible cellRef branches after the
    17	  // guard has established that "$cells" is absent.
    18	  rule <k> Name(X:String) => {M[X]}:>Val ... </k>
    19	       <env> L:Int </env>
    20	       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
    21	       requires X in_keys(M) andBool notBool ("$cells" in_keys(M))
    22	       [priority(39)]
    23	
    24	  rule <k> Name(X:String) => V:Val ... </k>
    25	       <env> L:Int </env>
    26	       <scopes> ... L |-> scope((X |-> V) M:Map, _:Parent) ... </scopes>
    27	       requires notBool (X in_keys(M))
    28	         andBool notBool ("$cells" in_keys((X |-> V) M))
    29	       [priority(38)]
    30	
    31	  rule <k> Assign(Name(X:String), V:Val) => .K ... </k>
    32	       <env> L:Int </env>
    33	       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _:Parent) ... </scopes>
    34	       requires notBool ("$cells" in_keys(M))
    35	       [priority(39)]
    36	
    37	  // Direct literal cooling, equivalent to Int(I) => I followed by Assign's
    38	  // strictness context.  Keeping it explicit avoids a symbolic freezer branch
    39	  // at loop-summary boundaries.
    40	  rule <k> Assign(Name(X:String), Int(I:Int)) => Assign(Name(X), I) ... </k>
    41	       [priority(39)]
    42	
    43	  rule <k> Assign(Name(X:String), Bool(B:Bool)) => Assign(Name(X), B) ... </k>
    44	       [priority(39)]
    45	
    46	  rule <k> Assign(Name(X:String), V:Val) => .K ... </k>
    47	       <env> L:Int </env>
    48	       <scopes> ... L |-> scope(
    49	         ((X |-> _:Val) M:Map => (X |-> V) M),
    50	         _:Parent) ... </scopes>
    51	       requires notBool (X in_keys(M))
    52	         andBool notBool ("$cells" in_keys((X |-> V) M))
    53	       [priority(38)]
    54	
    55	  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => .K ... </k>
    56	       <env> L:Int </env>
    57	       <scopes> ... L |-> scope(
    58	         M:Map => M [ X <- applyBin(OP, {M[X]}:>Val, V) ],
    59	         _:Parent) ... </scopes>
    60	       requires X in_keys(M)
    61	         andBool notBool ("$cells" in_keys(M))
    62	         andBool notBool isRefV({M[X]}:>Val)
    63	       [priority(39)]
    64	
    65	  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => .K ... </k>
    66	       <env> L:Int </env>
    67	       <scopes> ... L |-> scope(
    68	         ((X |-> A:Val) M:Map => (X |-> applyBin(OP, A, V)) M),
    69	         _:Parent) ... </scopes>
    70	       requires notBool (X in_keys(M))
    71	         andBool notBool ("$cells" in_keys((X |-> A) M))
    72	         andBool notBool isRefV(A)
    73	       [priority(38)]
    74	
    75	  rule <k> #bindTgt(Name(X:String), V:Val) => .K ... </k>
    76	       <env> L:Int </env>
    77	       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _:Parent) ... </scopes>
    78	       requires notBool ("$cells" in_keys(M))
    79	       [priority(39)]
    80	
    81	  rule <k> #bindTgt(Name(X:String), V:Val) => .K ... </k>
    82	       <env> L:Int </env>
    83	       <scopes> ... L |-> scope(
    84	         ((X |-> _:Val) M:Map => (X |-> V) M),
    85	         _:Parent) ... </scopes>
    86	       requires notBool (X in_keys(M))
    87	         andBool notBool ("$cells" in_keys((X |-> V) M))
    88	       [priority(38)]
