   122	       <scopes> ... L |-> scope((Y |-> V:Val) M:Map, _:Parent) ... </scopes>
   123	       requires notBool (Y in_keys(M))
   124	         andBool notBool ("$cells" in_keys((Y |-> V) M))
   125	       [priority(38)]
   126	
   127	  rule <k> Return(Name(X:String)) => Return(V) ... </k>
   128	       <env> L:Int </env>
   129	       <scopes> ... L |-> scope((X |-> V:Val) M:Map, _:Parent) ... </scopes>
   130	       requires notBool (X in_keys(M))
   131	         andBool notBool ("$cells" in_keys((X |-> V) M))
   132	       [priority(38)]
   133	
   134	  rule <k> For(T:Expr, Name(X:String), B:Stmts)
   135	        => #loop(V, T, B) ... </k>
   136	       <env> L:Int </env>
   137	       <scopes> ... L |-> scope((X |-> V:Val) M:Map, _:Parent) ... </scopes>
   138	       requires notBool (X in_keys(M))
   139	         andBool notBool ("$cells" in_keys((X |-> V) M))
   140	       [priority(38)]
