   178	  // Integer-only input lists.  This sort makes the task's stated input
   179	  // precondition structural, so symbolic execution never admits a non-int
   180	  // element.
   181	  syntax IntList ::= ".IntList" | intCons(Int, IntList)
   182	
   183	  syntax ValSeq ::= asVals(IntList)
   184	
   185	  // Structural iterator cases expose IntList's constructors to narrowing.
   186	  rule <k> #iterNext(list(asVals(.IntList))) => #iterDone ... </k>
   187	       [priority(39)]
   188	  rule <k> #iterNext(list(asVals(intCons(I:Int, IS:IntList))))
   189	        => #iterYield(I, list(asVals(IS))) ... </k>
   190	       [priority(39)]
   191	
   192	  // The mathematical primality oracle follows the implementation's trial
   193	  // division exactly.  false means that an earlier divisor was already found.
   194	  syntax Bool ::= trialPrime(Int, Int, Bool) [function, total]
   195	  rule trialPrime(_:Int, _:Int, false) => false
   196	  rule trialPrime(N:Int, D:Int, true) => true
   197	    requires D *Int D >Int N
   198	  rule trialPrime(N:Int, D:Int, true) => false
   199	    requires D *Int D <=Int N andBool pyMod(N, D) ==Int 0
   200	    [simplification]
   201	  rule trialPrime(N:Int, D:Int, true) => trialPrime(N, D +Int 1, true)
   202	    requires D *Int D <=Int N
   203	      andBool notBool (pyMod(N, D) ==Int 0)
   204	    [simplification]
   205	
   206	  // The final divisor value is specified too, allowing the loop invariant to
   207	  // describe the whole local store rather than hiding a side effect.
   208	  syntax Int ::= trialDivisor(Int, Int, Bool) [function, total]
   209	  rule trialDivisor(_:Int, D:Int, false) => D
   210	  rule trialDivisor(N:Int, D:Int, true) => D
   211	    requires D *Int D >Int N
   212	  rule trialDivisor(N:Int, D:Int, true) => D +Int 1
   213	    requires D *Int D <=Int N andBool pyMod(N, D) ==Int 0
   214	    [simplification]
   215	  rule trialDivisor(N:Int, D:Int, true)
   216	    => trialDivisor(N, D +Int 1, true)
   217	    requires D *Int D <=Int N
   218	      andBool notBool (pyMod(N, D) ==Int 0)
   219	    [simplification]
   220	
   221	  syntax Bool ::= isPrime(Int) [function, total]
   222	  rule isPrime(N:Int) => trialPrime(N, 2, N >=Int 2)
   223	
   224	  syntax Int ::= largestPrime(IntList, Int) [function, total]
   225	  rule largestPrime(.IntList, CUR:Int) => CUR
   226	  rule largestPrime(intCons(N:Int, IS:IntList), CUR:Int)
   227	    => largestPrime(IS, N)
   228	    requires N >Int CUR andBool isPrime(N)
   229	    [simplification]
   230	  rule largestPrime(intCons(N:Int, IS:IntList), CUR:Int)
   231	    => largestPrime(IS, CUR)
   232	    requires N <=Int CUR
   233	      orBool (N >Int CUR andBool notBool isPrime(N))
   234	    [simplification]
   235	
   236	  syntax Int ::= digitAcc(Int, Int) [function, total]
   237	  rule digitAcc(N:Int, A:Int) => A
   238	    requires N <=Int 0
   239	    [simplification]
   240	  rule digitAcc(N:Int, A:Int)
   241	    => digitAcc(
   242	         (N -Int pyMod(N, 10)) /Int 10,
   243	         A +Int pyMod(N, 10))
   244	    requires N >Int 0
   245	    [simplification]
   246	
   247	  syntax Int ::= digitSum(Int) [function, total]
   248	  rule digitSum(N:Int) => digitAcc(N, 0)
   249	
   250	  // Exact AST fragments emitted by py2mpy.py for solution.py.
   251	  syntax Expr ::= "#primeCond" [macro]
   252	  rule #primeCond => BoolOp(
   253	    "and",
   254	    Name("prime"),
   255	    Compare(
   256	      BinOp("*", Name("divisor"), Name("divisor")),
   257	      CmpOp("<=", Name("number"))))
   258	
   259	  syntax Stmts ::= "#primeBody" [macro]
   260	  rule #primeBody =>
   261	    If(Compare(
   262	      BinOp("%", Name("number"), Name("divisor")),
   263	      CmpOp("==", Int(0))),
   264	      Assign(Name("prime"), Bool(false)),
   265	      .Stmts)
   266	    AugAssign(Name("divisor"), "+", Int(1))
   267	
   268	  syntax Stmts ::= "#scanBody" [macro]
   269	  rule #scanBody =>
   270	    If(Compare(Name("number"), CmpOp(">", Name("largest"))),
   271	      Assign(Name("divisor"), Int(2))
   272	      Assign(
   273	        Name("prime"),
   274	        Compare(Name("number"), CmpOp(">=", Int(2))))
   275	      While(#primeCond, #primeBody)
   276	      If(Name("prime"),
   277	        Assign(Name("largest"), Name("number")),
   278	        .Stmts),
   279	      .Stmts)
   280	
   281	  syntax Expr ::= "#digitCond" [macro]
   282	  rule #digitCond =>
   283	    Compare(Name("largest"), CmpOp(">", Int(0)))
   284	
   285	  syntax Stmts ::= "#digitBody" [macro]
   286	  rule #digitBody =>
   287	    AugAssign(
   288	      Name("digit_total"),
   289	      "+",
   290	      BinOp("%", Name("largest"), Int(10)))
   291	    AugAssign(Name("largest"), "//", Int(10))
   292	
   293	  syntax Stmts ::= "#functionBody" [macro]
   294	  rule #functionBody =>
   295	    Assign(Name("largest"), Int(0))
   296	    Assign(Name("number"), Int(0))
   297	    Assign(Name("divisor"), Int(2))
   298	    Assign(Name("prime"), Bool(false))
   299	    Assign(Name("digit_total"), Int(0))
   300	    For(Name("number"), Name("lst"), #scanBody)
   301	    While(#digitCond, #digitBody)
   302	    Return(Name("digit_total"))
