/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
inv_path = '/reference/rule-inventory.json'
out_path = '/workspace/trust-boundary.json'
with open(inv_path) as f: inv = json.load(f)
with open(out_path) as f: out = json.load(f)
assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules']) == 45
expected_ids = [r['source_rule_id'] for r in inv['rules']]
actual_ids = [r['source_rule_id'] for r in out['rules']]
assert actual_ids == expected_ids
assert len(set(actual_ids)) == len(actual_ids)
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
for src, entry in zip(inv['rules'], out['rules']):
    assert list(entry) == ['source_rule_id', 'classification', 'rationale']
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
    if 'simplification' in src['attributes']:
        assert entry['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
counts = Counter(e['classification'] for e in out['rules'])
print('validated inventory hash:', out['inventory_sha256'])
print('validated ordered unique rules:', len(actual_ids))
for key in sorted(allowed): print(key, counts[key])
PY
