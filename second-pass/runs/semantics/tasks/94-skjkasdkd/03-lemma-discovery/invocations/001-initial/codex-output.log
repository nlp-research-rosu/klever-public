   105	       <env> L:Int </env>
   106	       <scopes> ... L |-> scope((X |-> A:Val) M:Map, _:Parent) ... </scopes>
   107	       requires notBool (X in_keys(M))
   108	         andBool notBool ("$cells" in_keys((X |-> A) M))
   109	       [priority(38)]
