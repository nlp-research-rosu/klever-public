Module(
  FuncDef("skjkasdkd", Params("lst"),
    Assign(Name("largest"), Int(0))
    Assign(Name("number"), Int(0))
    Assign(Name("divisor"), Int(2))
    Assign(Name("prime"), Bool(false))
    Assign(Name("digit_total"), Int(0))
    For(Name("number"), Name("lst"),
      If(Compare(Name("number"), CmpOp(">", Name("largest"))),
        Assign(Name("divisor"), Int(2))
        Assign(
          Name("prime"),
          Compare(Name("number"), CmpOp(">=", Int(2))))
        While(BoolOp(
          "and",
          Name("prime"),
          Compare(
            BinOp("*", Name("divisor"), Name("divisor")),
            CmpOp("<=", Name("number")))),
          If(Compare(
            BinOp("%", Name("number"), Name("divisor")),
            CmpOp("==", Int(0))),
            Assign(Name("prime"), Bool(false)),
            )
          AugAssign(Name("divisor"), "+", Int(1)))
        If(Name("prime"),
          Assign(Name("largest"), Name("number")),
          ),
        ))
    While(Compare(Name("largest"), CmpOp(">", Int(0))),
      AugAssign(
        Name("digit_total"),
        "+",
        BinOp("%", Name("largest"), Int(10)))
      AugAssign(Name("largest"), "//", Int(10)))
    Return(Name("digit_total")))
  Assert(
    Compare(
      Call(
        Name("skjkasdkd"),
        ListExpr(
          Int(0),
          Int(3),
          Int(2),
          Int(1),
          Int(3),
          Int(5),
          Int(7),
          Int(4),
          Int(5),
          Int(5),
          Int(5),
          Int(2),
          Int(181),
          Int(32),
          Int(4),
          Int(32),
          Int(3),
          Int(2),
          Int(32),
          Int(324),
          Int(4),
          Int(3))),
      CmpOp("==", Int(10))))
  Assert(
    Compare(
      Call(
        Name("skjkasdkd"),
        ListExpr(
          Int(1),
          Int(0),
          Int(1),
          Int(8),
          Int(2),
          Int(4597),
          Int(2),
          Int(1),
          Int(3),
          Int(40),
          Int(1),
          Int(2),
          Int(1),
          Int(2),
          Int(4),
          Int(2),
          Int(5),
          Int(1))),
      CmpOp("==", Int(25))))
  Assert(
    Compare(
      Call(
        Name("skjkasdkd"),
        ListExpr(
          Int(1),
          Int(3),
          Int(1),
          Int(32),
          Int(5107),
          Int(34),
          Int(83278),
          Int(109),
          Int(163),
          Int(23),
          Int(2323),
          Int(32),
          Int(30),
          Int(1),
          Int(9),
          Int(3))),
      CmpOp("==", Int(13))))
  Assert(
    Compare(
      Call(
        Name("skjkasdkd"),
        ListExpr(
          Int(0),
          Int(724),
          Int(32),
          Int(71),
          Int(99),
          Int(32),
          Int(6),
          Int(0),
          Int(5),
          Int(91),
          Int(83),
          Int(0),
          Int(5),
          Int(6))),
      CmpOp("==", Int(11))))
  Assert(
    Compare(
      Call(
        Name("skjkasdkd"),
        ListExpr(Int(0), Int(81), Int(12), Int(3), Int(1), Int(21))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("skjkasdkd"),
        ListExpr(Int(0), Int(8), Int(1), Int(2), Int(1), Int(7))),
      CmpOp("==", Int(7))))
  Assert(
    Compare(Call(Name("skjkasdkd"), ListExpr()), CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("skjkasdkd"),
        ListExpr(
          UnaryOp("-", Int(5)),
          UnaryOp("-", Int(2)),
          Int(0),
          Int(1),
          Int(4))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("skjkasdkd"), ListExpr(Int(2))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("skjkasdkd"), ListExpr(Int(97), Int(101), Int(99))),
      CmpOp("==", Int(2)))))
