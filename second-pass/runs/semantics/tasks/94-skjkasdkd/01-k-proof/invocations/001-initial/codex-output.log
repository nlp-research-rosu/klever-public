+      ~> #endcall
+      => digitSum(largestPrime(IS, CUR)) ~> CONT:K
+    </k>
+    <env> S:Int => CALLER:Int </env>
+    <scopes>
+      BASE:Map
+      S |-> scope(
+        ("largest" |-> CUR:Int)
+        REST:Map,
+        parent(0))
+      => BASE
