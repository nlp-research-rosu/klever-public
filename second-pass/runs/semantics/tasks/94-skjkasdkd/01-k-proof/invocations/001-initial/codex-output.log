+    requires D *Int D <=Int N
+      andBool notBool (pyMod(N, D) ==Int 0)
+    [simplification]
+
+  syntax Bool ::= isPrime(Int) [function, total]
+  rule isPrime(N:Int) => false requires N <Int 2
+  rule isPrime(N:Int) => trialPrime(N, 2, true) requires N >=Int 2
+
