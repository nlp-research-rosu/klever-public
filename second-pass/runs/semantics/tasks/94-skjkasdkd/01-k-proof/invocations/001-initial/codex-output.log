+def skjkasdkd(lst):
+    largest = 0
+    for number in lst:
+        if number > largest:
+            divisor = 2
+            prime = number >= 2
+            while prime and divisor * divisor <= number:
+                if number % divisor == 0:
+                    prime = False
+                divisor += 1
+            if prime:
+                largest = number
