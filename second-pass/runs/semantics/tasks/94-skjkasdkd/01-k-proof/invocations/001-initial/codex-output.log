+    Module(FuncDef("skjkasdkd", Params("lst"), #functionBody))
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.scan-loop --trusted SPEC.prime-loop,SPEC.digit-loop --output pretty' in /work
