+      BASE:Map
+      S |-> scope(
+        ("largest" |-> CUR:Int)
+        REST:Map,
+        parent(0))
+      => BASE
+    </scopes>
+    <scopeLoc> S +Int 1 => S </scopeLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, S)) STACK:List
+      => STACK
+    </stack>
