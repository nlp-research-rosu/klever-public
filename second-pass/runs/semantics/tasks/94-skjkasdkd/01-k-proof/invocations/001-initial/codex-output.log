+        ("divisor" |-> OLDD:Int)
+        ("prime" |-> OLDB:Bool)
+        ("digit_total" |-> 0)
+        REST:Map,
+        parent(0))
+      => BASE
+    </scopes>
+    <scopeLoc> S +Int 1 => S </scopeLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, S)) STACK:List
+      => STACK
+    </stack>
+    <ret> noRet </ret>
+    requires CUR >=Int 0
+      andBool notBool ("largest" in_keys(REST))
+      andBool notBool ("number" in_keys(REST))
