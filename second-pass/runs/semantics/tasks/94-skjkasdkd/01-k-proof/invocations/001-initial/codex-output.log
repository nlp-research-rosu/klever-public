@@ -0,0 +1,20 @@
+def skjkasdkd(lst):
+    largest = 0
+    number = 0
+    divisor = 2
+    prime = False
+    digit_total = 0
+    for number in lst:
+        if number > largest:
+            divisor = 2
+            prime = number >= 2
+            while prime and divisor * divisor <= number:
+                if number % divisor == 0:
+                    prime = False
+                divisor += 1
+            if prime:
