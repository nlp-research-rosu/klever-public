+  rule #functionBody =>
+    Assign(Name("largest"), Int(0))
+    For(Name("number"), Name("lst"), #scanBody)
+    Assign(Name("digit_total"), Int(0))
+    While(#digitCond, #digitBody)
+    Return(Name("digit_total"))
+
+  syntax Module ::= "solutionModule" [macro]
+  rule solutionModule =>
+    Module(FuncDef("skjkasdkd", Params("lst"), #functionBody))
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..516808494d1f10536f2b0881aca81153113bf933
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,17 @@
+def skjkasdkd(lst):
+    largest = 0
+    for number in lst:
+        if number > largest:
+            divisor = 2
+            prime = number >= 2
+            while prime and divisor * divisor <= number:
+                if number % divisor == 0:
+                    prime = False
+                divisor += 1
+            if prime:
+                largest = number
+    digit_total = 0
+    while largest > 0:
+        digit_total += largest % 10
+        largest //= 10
+    return digit_total
