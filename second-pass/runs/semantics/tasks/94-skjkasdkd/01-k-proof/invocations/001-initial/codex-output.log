+      L |-> scope(
+        ("largest" |-> N:Int)
+        ("digit_total" |-> A:Int)
+        REST:Map,
+        P:Parent)
+      =>
+      SC
+      L |-> scope(
+        ("largest" |-> 0)
+        ("digit_total" |-> A +Int digitSum(N))
+        REST,
+        P)
+    </scopes>
+    requires N >=Int 0
