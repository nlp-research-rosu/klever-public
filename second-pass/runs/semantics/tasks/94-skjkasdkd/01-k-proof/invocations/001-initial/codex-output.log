+++ b/solution.py
@@ -0,0 +1,17 @@
+def skjkasdkd(lst):
+    largest = 0
+    for number in lst:
+        if number > largest:
+            divisor = 2
+            prime = number >= 2
+            while prime and divisor * divisor <= number:
+                if number % divisor == 0:
+                    prime = False
+                divisor += 1
+            if prime:
+                largest = number
+    digit_total = 0
+    while largest > 0:
+        digit_total += largest % 10
+        largest //= 10
+    return digit_total
