COMMAND (translate-concrete):
 python3 py2mpy.py concrete_tests.py
Module(
  FuncDef("is_prime", Params("n"),
    If(Compare(Name("n"), CmpOp("<", Int(2))),
      Return(Bool(false)),
      )
    Assign(Name("divisor"), Int(2))
    While(Compare(
      BinOp("*", Name("divisor"), Name("divisor")),
      CmpOp("<=", Name("n"))),
      If(Compare(
        BinOp("%", Name("n"), Name("divisor")),
        CmpOp("==", Int(0))),
        Return(Bool(false)),
        )
      AugAssign(Name("divisor"), "+", Int(1)))
    Return(Bool(true)))
  Assert(
    Compare(Call(Name("is_prime"), Int(6)), CmpOp("==", Bool(false))))
  Assert(
    Compare(Call(Name("is_prime"), Int(101)), CmpOp("==", Bool(true))))
  Assert(
    Compare(Call(Name("is_prime"), Int(11)), CmpOp("==", Bool(true))))
  Assert(
    Compare(Call(Name("is_prime"), Int(13441)), CmpOp("==", Bool(true))))
  Assert(
    Compare(Call(Name("is_prime"), Int(61)), CmpOp("==", Bool(true))))
  Assert(
    Compare(Call(Name("is_prime"), Int(4)), CmpOp("==", Bool(false))))
  Assert(
    Compare(Call(Name("is_prime"), Int(1)), CmpOp("==", Bool(false)))))
EXIT_STATUS (translate-concrete): 0
EXIT_STATUS (write-concrete-translation): 0

