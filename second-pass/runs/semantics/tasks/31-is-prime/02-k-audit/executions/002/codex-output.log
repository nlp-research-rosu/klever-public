bash evidence/stage2_fidelity.sh 2>&1 | tee evidence/stage2_fidelity.log
status=${PIPESTATUS[0]}
echo "RECORDED_PIPELINE_EXIT_STATUS: ${status}" | tee -a evidence/stage2_fidelity.log
exit "${status}"' in /audit-output
