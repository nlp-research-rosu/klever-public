diff --git a//tmp/audit-work/31-is-prime-audit/spec-vacuity.k b//tmp/audit-work/31-is-prime-audit/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..b6ad658e2275b396d005203d40c40b08708c0c6c
--- /dev/null
+++ b//tmp/audit-work/31-is-prime-audit/spec-vacuity.k
@@ -0,0 +1,48 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Fresh reviewer mutation: the real function returns false whenever N < 2,
+  // so requiring true is false for the satisfying witness N = 1.
+  claim
+    <k>
+      #entryBody ~> #endcall
+      =>
+      true
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (
+        -1 |-> B:Scope
+        0 |-> scope(
+          "is_prime" |-> closureVal(
+            "n", .ParamNames,
+            #entryBody,
+            0),
+          parent(-1))
+        1 |-> scope("n" |-> N, parent(0)))
+      =>
+      (
+        -1 |-> B
+        0 |-> scope(
+          "is_prime" |-> closureVal(
+            "n", .ParamNames,
+            #entryBody,
+            0),
+          parent(-1)))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N <Int 2
+    [label(false-entry-result)]
+endmodule
