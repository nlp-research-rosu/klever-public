diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..11efa0079a09286d410ec60656b0e780a02afedb
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def is_prime(n):
+    if n < 2:
+        return False
+    divisor = 2
+    while divisor * divisor <= n:
+        if n % divisor == 0:
+            return False
+        divisor += 1
+    return True
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..bc49e00c9384129caf81bcaab324bf9cd25fc0e2
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,107 @@
+requires "verification.k"
+
+module LOOP-SPEC
+  imports VERIFICATION-BASE
+
+  // Loop invariant/induction theorem.  At candidate divisor D, executing the
+  // remaining loop returns the mathematical trialPrime(N,D) result and
+  // restores the ordinary Python call frame.
+  claim
+    <k>
+      #while(#primeCond, #primeLoopBody)
+        ~> Return(Bool(true))
+        ~> #endcall
+      =>
+      trialPrime(N:Int, D:Int) ~> CONT:K
+    </k>
+    <env> L:Int => CALLER:Int </env>
+    <scopes>
+      (SC:Map
+        0 |-> scope(
+          "is_prime" |-> closureVal(
+            "n", .ParamNames,
+            #entryBody,
+            0),
+          parent(-1))
+        L |-> scope(
+          "n" |-> N
+          "divisor" |-> D,
+          parent(0)))
+      =>
+      (SC
+        0 |-> scope(
+          "is_prime" |-> closureVal(
+            "n", .ParamNames,
+            #entryBody,
+            0),
+          parent(-1)))
+    </scopes>
+    <scopeLoc> L +Int 1 => L </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, L)) STACK:List
+      =>
+      STACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2
+     andBool D >=Int 2
+     andBool notBool (L in_keys(
+       SC
+         0 |-> scope(
+           "is_prime" |-> closureVal(
+             "n", .ParamNames,
+             #entryBody,
+             0),
+           parent(-1))))
+    [label(loop-correct)]
+
+endmodule
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal entry-point theorem over every mathematical integer.
+  claim
+    <k>
+      #entryBody ~> #endcall
+      =>
+      isPrimeSpec(N:Int) ~> CONT:K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (
+        -1 |-> builtinsScope
+        0 |-> scope(
+          "is_prime" |-> closureVal(
+            "n", .ParamNames,
+            #entryBody,
+            0),
+          parent(-1))
+        1 |-> scope("n" |-> N, parent(0)))
+      =>
+      (
+        -1 |-> builtinsScope
+        0 |-> scope(
+          "is_prime" |-> closureVal(
+            "n", .ParamNames,
+            #entryBody,
+            0),
+          parent(-1)))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(entry-correct)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..412b228bf92e87e4d003c1da0afeedb1743f1c74
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,109 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  // The call semantics removes a fresh frame with a symbolic map update.
+  // MAP does not simplify these identities under path constraints on its own,
+  // so expose the elementary finite-map facts to the symbolic backend.
+  rule M:Map [ L:Int <- undef ] => M
+    requires notBool (L in_keys(M))
+  rule ((M:Map L:Int |-> _V:Scope) [ L <- undef ]) => M
+    requires notBool (L in_keys(M))
+
+  // Closed syntax terms taken verbatim from solution.mpy.  These equations
+  // only abbreviate syntax; they do not summarize execution.
+  syntax Expr ::= "#primeCond" [macro]
+  rule #primeCond
+    => Compare(
+         BinOp("*", Name("divisor"), Name("divisor")),
+         CmpOp("<=", Name("n")))
+
+  syntax Stmts ::= "#primeLoopBody" [macro]
+  rule #primeLoopBody
+    => If(Compare(
+         BinOp("%", Name("n"), Name("divisor")),
+         CmpOp("==", Int(0))),
+         Return(Bool(false)),
+         .Stmts)
+       AugAssign(Name("divisor"), "+", Int(1))
+
+  syntax Stmts ::= "#entryBody" [macro]
+  rule #entryBody
+    => If(Compare(Name("n"), CmpOp("<", Int(2))),
+         Return(Bool(false)),
+         .Stmts)
+       Assign(Name("divisor"), Int(2))
+       While(#primeCond, #primeLoopBody)
+       Return(Bool(true))
+
+  // Executable mathematical specification.  For n >= 2, trialPrime(n,d)
+  // says that no divisor at or above d and at or below sqrt(n) divides n.
+  // Every composite n >= 2 has a factor no greater than sqrt(n), so the entry
+  // predicate below is exactly mathematical primality.
+  syntax Bool ::= trialPrime(Int, Int) [function]
+  rule trialPrime(N:Int, D:Int) => true
+    requires D *Int D >Int N
+  rule trialPrime(N:Int, D:Int) => false
+    requires D *Int D <=Int N andBool N %Int D ==Int 0
+  rule trialPrime(N:Int, D:Int) => trialPrime(N, D +Int 1)
+    requires D *Int D <=Int N andBool N %Int D =/=Int 0
+
+  syntax Bool ::= isPrimeSpec(Int) [function]
+  rule isPrimeSpec(N:Int) => false requires N <Int 2
+  rule isPrimeSpec(N:Int) => trialPrime(N, 2) requires N >=Int 2
+endmodule
+
+// Modular proof layer.  DERIVED-LOOP is the D=2, top-level-call instance of
+// the general loop-correct theorem proved in module LOOP-SPEC.  The second
+// positive proof command uses that established theorem to prove the public
+// entry point without re-unrolling the loop.
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  rule [DERIVED-LOOP]:
+    <k>
+      #while(#primeCond, #primeLoopBody)
+        ~> Return(Bool(true))
+        ~> #endcall
+      =>
+      trialPrime(N:Int, 2) ~> CONT:K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (
+        -1 |-> builtinsScope
+        0 |-> scope(
+          "is_prime" |-> closureVal(
+            "n", .ParamNames,
+            #entryBody,
+            0),
+          parent(-1))
+        1 |-> scope(
+          "n" |-> N
+          "divisor" |-> 2,
+          parent(0)))
+      =>
+      (
+        -1 |-> builtinsScope
+        0 |-> scope(
+          "is_prime" |-> closureVal(
+            "n", .ParamNames,
+            #entryBody,
+            0),
+          parent(-1)))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2
+    [priority(20)]
+endmodule

