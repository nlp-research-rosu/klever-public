+    <scopes>
+      ...
+      1 |-> scope(
+        "n" |-> N
+        "divisor" |-> 2,
+        parent(0))
+      ...
+    </scopes>
+    [priority(20)]
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..11efa0079a09286d410ec60656b0e780a02afedb
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def is_prime(n):
+    if n < 2:
+        return False
+    divisor = 2
+    while divisor * divisor <= n:
+        if n % divisor == 0:
+            return False
+        divisor += 1
+    return True
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f4593e00e26cc0fbff8962bc042badb0d8905270
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,91 @@
+requires "verification.k"
+
+module LOOP-SPEC
+  imports VERIFICATION-BASE
+
+  // Loop invariant/induction theorem.  At candidate divisor D, executing the
+  // remaining loop returns the mathematical trialPrime(N,D) result and
+  // restores the ordinary Python call frame.
+  claim
+    <k>
+      #while(#primeCond, #primeLoopBody)
+        ~> Return(Bool(true))
+        ~> #endcall
+      =>
+      trialPrime(N:Int, D:Int) ~> CONT:K
+    </k>
+    <env> L:Int => CALLER:Int </env>
+    <scopes>
+      (SC:Map
+        0 |-> GLOBAL:Scope
+        L |-> scope(
+          "n" |-> N
+          "divisor" |-> D,
+          parent(0)))
+      =>
+      (SC
+        0 |-> GLOBAL)
+    </scopes>
+    <scopeLoc> L +Int 1 => L </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, L)) STACK:List
+      =>
+      STACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires D >=Int 2
+     andBool L =/=Int 0
+     andBool notBool (0 in_keys(SC))
+     andBool notBool (L in_keys(SC))
+    [label(loop-correct)]
+
+endmodule
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal entry-point theorem over every mathematical integer.
+  claim
+    <k>
+      #entryBody ~> #endcall
+      =>
+      isPrimeSpec(N:Int) ~> CONT:K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (
+        -1 |-> B:Scope
+        0 |-> scope(
+          "is_prime" |-> closureVal(
+            "n", .ParamNames,
+            #entryBody,
+            0),
+          parent(-1))
+        1 |-> scope("n" |-> N, parent(0)))
+      =>
+      (
+        -1 |-> B
+        0 |-> scope(
+          "is_prime" |-> closureVal(
+            "n", .ParamNames,
+            #entryBody,
+            0),
+          parent(-1)))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(entry-correct)]
+endmodule
