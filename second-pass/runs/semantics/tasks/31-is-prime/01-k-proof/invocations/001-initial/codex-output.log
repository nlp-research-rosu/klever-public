+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires D >=Int 2
+     andBool L =/=Int 0
+     andBool notBool (0 in_keys(SC))
+     andBool notBool (L in_keys(SC))
+    [label(loop-correct)]
