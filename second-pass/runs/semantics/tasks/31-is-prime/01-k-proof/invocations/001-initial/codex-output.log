+          (M
+            "_is_prime_from" |-> closureVal(
+              "n", "divisor", .ParamNames,
+              #helperBody,
+              0)),
+          P))
+    </scopes>
+    <scopeLoc> L +Int 1 => L </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, L)) STACK:List
+      =>
+      STACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool (L in_keys(
+      SC
+        0 |-> scope(
+          (M
+            "_is_prime_from" |-> closureVal(
+              "n", "divisor", .ParamNames,
+              #helperBody,
+              0)),
+          P)))
+endmodule
