+               Return(Bool(false)),
+               .Stmts)
+             AugAssign(Name("divisor"), "+", Int(1)))
+           Return(Bool(true)))
+         Assign(Name("$result"),
+           Call(Name("is_prime"), Int(N))))) ... </k>
+endmodule

