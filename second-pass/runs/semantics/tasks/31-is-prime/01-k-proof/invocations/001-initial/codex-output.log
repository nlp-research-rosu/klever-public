+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (SC:Map
+        0 |-> GLOBAL:Scope
+        1 |-> scope(
+          "n" |-> N
+          "divisor" |-> 2,
+          parent(0)))
+      =>
+      (SC
+        0 |-> GLOBAL)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool (0 in_keys(SC))
+     andBool notBool (1 in_keys(SC))
+    [priority(20)]
+endmodule

