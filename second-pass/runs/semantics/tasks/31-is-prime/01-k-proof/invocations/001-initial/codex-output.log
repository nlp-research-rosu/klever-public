+  // equations merely unfold syntax and do not summarize program execution.
+  syntax Stmts ::= "#helperBody" [function, total]
+  rule #helperBody
+    => If(Compare(
+         BinOp("*", Name("divisor"), Name("divisor")),
+         CmpOp(">", Name("n"))),
+         Return(Bool(true)),
+         .Stmts)
+       If(Compare(
+         BinOp("%", Name("n"), Name("divisor")),
+         CmpOp("==", Int(0))),
+         Return(Bool(false)),
+         .Stmts)
+       Return(Call(
+         Name("_is_prime_from"),
+         Name("n"),
+         BinOp("+", Name("divisor"), Int(1))))
+
+  syntax Stmts ::= "#entryBody" [function, total]
+  rule #entryBody
+    => If(Compare(Name("n"), CmpOp("<", Int(2))),
+         Return(Bool(false)),
+         .Stmts)
