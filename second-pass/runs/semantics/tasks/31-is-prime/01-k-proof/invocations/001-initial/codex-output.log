+    <k>
+      #while(#primeCond, #primeLoopBody)
+        ~> Return(Bool(true))
+        ~> #endcall
+      =>
+      trialPrime(N:Int, D:Int) ~> CONT:K
+    </k>
+    <env> L:Int => CALLER:Int </env>
+    <scopes>
+      (SC:Map
+        0 |-> scope(
+          "is_prime" |-> closureVal(
+            "n", .ParamNames,
+            #entryBody,
+            0),
+          parent(-1))
+        L |-> scope(
+          "n" |-> N
+          "divisor" |-> D,
+          parent(0)))
+      =>
+      (SC
