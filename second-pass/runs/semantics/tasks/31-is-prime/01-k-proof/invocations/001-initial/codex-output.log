diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..31b71ae45a763c20b3384f83e539f821b42077d8
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,62 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  // The call semantics removes a fresh frame with a symbolic map update.
+  // MAP does not simplify these identities under path constraints on its own,
+  // so expose the elementary finite-map facts to the symbolic backend.
+  rule M:Map [ L:Int <- undef ] => M
+    requires notBool (L in_keys(M))
+  rule ((M:Map L:Int |-> _V:Scope) [ L <- undef ]) => M
+    requires notBool (L in_keys(M))
+
+  // Closed syntax terms taken verbatim from solution.mpy.  These equations
+  // only abbreviate syntax; they do not summarize execution.
+  syntax Expr ::= "#primeCond" [macro]
+  rule #primeCond
+    => Compare(
+         BinOp("*", Name("divisor"), Name("divisor")),
+         CmpOp("<=", Name("n")))
+
+  syntax Stmts ::= "#primeLoopBody" [macro]
+  rule #primeLoopBody
+    => If(Compare(
+         BinOp("%", Name("n"), Name("divisor")),
+         CmpOp("==", Int(0))),
+         Return(Bool(false)),
+         .Stmts)
+       AugAssign(Name("divisor"), "+", Int(1))
+
+  syntax Stmts ::= "#entryBody" [macro]
+  rule #entryBody
+    => If(Compare(Name("n"), CmpOp("<", Int(2))),
+         Return(Bool(false)),
+         .Stmts)
+       Assign(Name("divisor"), Int(2))
+       While(#primeCond, #primeLoopBody)
+       Return(Bool(true))
+
+  // Executable mathematical specification.  For n >= 2, trialPrime(n,d)
+  // says that no divisor at or above d and at or below sqrt(n) divides n.
+  // Every composite n >= 2 has a factor no greater than sqrt(n), so the entry
+  // predicate below is exactly mathematical primality.
+  syntax Bool ::= trialPrime(Int, Int) [function]
+  rule trialPrime(N:Int, D:Int) => true
+    requires D *Int D >Int N
+  rule trialPrime(N:Int, D:Int) => false
+    requires D *Int D <=Int N andBool N %Int D ==Int 0
+  rule trialPrime(N:Int, D:Int) => trialPrime(N, D +Int 1)
+    requires D *Int D <=Int N andBool N %Int D =/=Int 0
+
+  syntax Bool ::= isPrimeSpec(Int) [function]
+  rule isPrimeSpec(N:Int) => false requires N <Int 2
+  rule isPrimeSpec(N:Int) => trialPrime(N, 2) requires N >=Int 2
+endmodule
+
+// Public proof module.  The specification composes a finite entry-prefix
+// theorem with the general loop theorem, so no unproved execution-summary
+// rule is added here.
+module VERIFICATION
+  imports VERIFICATION-BASE
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..9829bcfcf6d35ec9a238e72c944ac599eafbbd6d
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,18 @@
+def is_prime(n):
+    if n < 2:
+        return False
+    divisor = 2
+    while divisor * divisor <= n:
+        if n % divisor == 0:
+            return False
+        divisor += 1
+    return True
+
+
+assert is_prime(6) == False
+assert is_prime(101) == True
+assert is_prime(11) == True
+assert is_prime(13441) == True
+assert is_prime(61) == True
+assert is_prime(4) == False
+assert is_prime(1) == False
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..4481b4eae27adba9796d9bce9283989cf4411570
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Translate the submitted implementation and the concrete prompt-example
+# harness with the fixed front end.
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+
+# Concrete execution under the required LLVM definition.  All seven prompt
+# examples are assertions; success ends with <exc> NoExc and exit code 0.
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun concrete_tests.mpy --definition runtime-kompiled
+
+# Prove the general trial-divisor loop theorem from the supplied MPY rules.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION-BASE \
+  --syntax-module MPY-SYNTAX \
+  --output-definition proof-base-kompiled
+kprove spec.k \
+  --definition proof-base-kompiled \
+  --spec-module LOOP-SPEC
+
+# Prove both exhaustive entry branches.  For n >= 2 the prefix establishes
+# divisor = 2 and reaches the source of the loop theorem above.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition proof-kompiled
+kprove spec.k \
+  --definition proof-kompiled \
+  --spec-module SPEC
