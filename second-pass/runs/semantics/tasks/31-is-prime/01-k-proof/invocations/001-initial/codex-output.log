+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (
+        -1 |-> B:Scope
+        0 |-> scope(
+          "is_prime" |-> closureVal(
+            "n", .ParamNames,
+            #entryBody,
+            0),
+          parent(-1))
+        1 |-> scope(
+          "n" |-> N
+          "divisor" |-> 2,
+          parent(0)))
+      =>
+      (
+        -1 |-> B
+        0 |-> scope(
