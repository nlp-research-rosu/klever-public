/work/solution.py
/work/spec.k
/work/verification.k
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..11efa0079a09286d410ec60656b0e780a02afedb
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def is_prime(n):
+    if n < 2:
+        return False
+    divisor = 2
+    while divisor * divisor <= n:
+        if n % divisor == 0:
+            return False
+        divisor += 1
+    return True
