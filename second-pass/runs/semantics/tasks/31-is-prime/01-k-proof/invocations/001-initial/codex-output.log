+++ b/spec.k
@@ -0,0 +1,71 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Induction lemma for the recursive divisor search.  The claim starts at
+  // the semantics' ordinary user-closure dispatch and restores every caller
+  // cell, so it proves the real helper body rather than a model of it.
+  claim
+    <k>
+      #applyK(toCall(closureVal(
+        "n", "divisor", .ParamNames,
+        #helperBody,
+        0)),
+        (N:Int, D:Int, .Vals)) ~> CONT:K
+      =>
+      trialPrime(N, D) ~> CONT
+    </k>
+    <env> L:Int </env>
+    <scopes> SC:Map </scopes>
+    <scopeLoc> SL:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2
+     andBool D >=Int 2
+     andBool notBool (SL in_keys(SC))
+
+  // Universal entry-point theorem: for every mathematical integer n, the
+  // function returns precisely the independently defined primality predicate.
+  claim
+    <k>
+      #applyK(toCall(closureVal(
+        "n", .ParamNames,
+        #entryBody,
+        0)),
+        (N:Int, .Vals)) ~> CONT:K
+      =>
+      isPrimeSpec(N) ~> CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+        0 |-> scope(
+          M:Map
+            [ "_is_prime_from" <- closureVal(
+                "n", "divisor", .ParamNames,
+                #helperBody,
+                0) ],
+          P:Parent)
+    </scopes>
+    <scopeLoc> SL:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool (SL in_keys(
+      SC
+        0 |-> scope(
+          M
+            [ "_is_prime_from" <- closureVal(
+                "n", "divisor", .ParamNames,
+                #helperBody,
+                0) ],
+          P)))
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4f58862fe227ca789e574dd2aea14e172ec7d536
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,48 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // These two closed statement terms are the exact bodies emitted in
+  // solution.mpy.  Naming them keeps the reachability claims readable; the
+  // equations merely unfold syntax and do not summarize program execution.
+  syntax Stmts ::= "#helperBody" [function, total]
+  rule #helperBody
+    => If(Compare(
+         BinOp("*", Name("divisor"), Name("divisor")),
+         CmpOp(">", Name("n"))),
+         Return(Bool(true)),
+         .Stmts)
+       If(Compare(
+         BinOp("%", Name("n"), Name("divisor")),
+         CmpOp("==", Int(0))),
+         Return(Bool(false)),
+         .Stmts)
+       Return(Call(
+         Name("_is_prime_from"),
+         Name("n"),
+         BinOp("+", Name("divisor"), Int(1))))
+
+  syntax Stmts ::= "#entryBody" [function, total]
+  rule #entryBody
+    => If(Compare(Name("n"), CmpOp("<", Int(2))),
+         Return(Bool(false)),
+         .Stmts)
+       Return(Call(Name("_is_prime_from"), Name("n"), Int(2)))
+
+  // Executable mathematical specification.  For n >= 2, trialPrime(n,d)
+  // says that no divisor at or above d and at or below sqrt(n) divides n.
+  // This is the standard trial-division characterization of primality:
+  // every composite n >= 2 has a factor no greater than sqrt(n).
+  syntax Bool ::= trialPrime(Int, Int) [function]
+  rule trialPrime(N:Int, D:Int) => true
+    requires D *Int D >Int N
+  rule trialPrime(N:Int, D:Int) => false
+    requires D *Int D <=Int N andBool N %Int D ==Int 0
+  rule trialPrime(N:Int, D:Int) => trialPrime(N, D +Int 1)
+    requires D *Int D <=Int N andBool N %Int D =/=Int 0
+
+  syntax Bool ::= isPrimeSpec(Int) [function]
+  rule isPrimeSpec(N:Int) => false requires N <Int 2
+  rule isPrimeSpec(N:Int) => trialPrime(N, 2) requires N >=Int 2
+endmodule

apply patch
