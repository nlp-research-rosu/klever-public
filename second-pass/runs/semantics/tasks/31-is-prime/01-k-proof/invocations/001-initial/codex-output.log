+  claim
+    <k>
+      #helperBody ~> #endcall
+      =>
+      trialPrime(N:Int, D:Int) ~> CONT:K
+    </k>
+    <env> L:Int => CALLER:Int </env>
+    <scopes>
+      (SC:Map
+        0 |-> scope(
+          (M:Map
+            "_is_prime_from" |-> closureVal(
+              "n", "divisor", .ParamNames,
+              #helperBody,
+              0)),
+          P:Parent)
+        L |-> scope(
+          "n" |-> N
+          "divisor" |-> D,
+          parent(0)))
+      =>
+      (SC
+        0 |-> scope(
+          (M
+            "_is_prime_from" |-> closureVal(
+              "n", "divisor", .ParamNames,
+              #helperBody,
+              0)),
+          P))
