+  imports VERIFICATION
+
+  // The n < 2 half of the universal entry-point theorem.
+  claim
+    <k>
+      #entryBody ~> #endcall
+      =>
+      false ~> CONT:K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (
+        -1 |-> B:Scope
+        0 |-> scope(
+          "is_prime" |-> closureVal(
+            "n", .ParamNames,
+            #entryBody,
+            0),
+          parent(-1))
+        1 |-> scope("n" |-> N, parent(0)))
+      =>
+      (
+        -1 |-> B
+        0 |-> scope(
+          "is_prime" |-> closureVal(
+            "n", .ParamNames,
+            #entryBody,
+            0),
+          parent(-1)))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
