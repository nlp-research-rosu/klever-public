diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..537e8dcf312b7a145f57fb01091bcb8556deb03f
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,43 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim
+    <k> #callIsPrime(6) => .K </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        .Map
+          [ "is_prime" <- closureVal(
+              "n" , .ParamNames,
+              If(Compare(Name("n"), CmpOp("<", Int(2))),
+                Return(Bool(false)),
+                .Stmts)
+              Assign(Name("divisor"), Int(2))
+              While(Compare(
+                BinOp("*", Name("divisor"), Name("divisor")),
+                CmpOp("<=", Name("n"))),
+                If(Compare(
+                  BinOp("%", Name("n"), Name("divisor")),
+                  CmpOp("==", Int(0))),
+                  Return(Bool(false)),
+                  .Stmts)
+                AugAssign(Name("divisor"), "+", Int(1)))
+              Return(Bool(true)),
+              0) ]
+          [ "$result" <- false ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d9a18ecd9b5343cf7a21d094e71113f4709c08b7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,29 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Proof harness for the exact AST generated in solution.mpy.  The fresh
+  // module-level name "$result" makes a function's returned value observable
+  // in the final configuration.
+  syntax KItem ::= "#callIsPrime" "(" Int ")"
+
+  rule <k> #callIsPrime(N:Int) => #loadAll(Module(
+         FuncDef("is_prime", Params("n"),
+           If(Compare(Name("n"), CmpOp("<", Int(2))),
+             Return(Bool(false)),
+             .Stmts)
+           Assign(Name("divisor"), Int(2))
+           While(Compare(
+             BinOp("*", Name("divisor"), Name("divisor")),
+             CmpOp("<=", Name("n"))),
+             If(Compare(
+               BinOp("%", Name("n"), Name("divisor")),
+               CmpOp("==", Int(0))),
+               Return(Bool(false)),
+               .Stmts)
+             AugAssign(Name("divisor"), "+", Int(1)))
+           Return(Bool(true)))
+         Assign(Name("$result"),
+           Call(Name("is_prime"), Int(N))))) ... </k>
+endmodule

