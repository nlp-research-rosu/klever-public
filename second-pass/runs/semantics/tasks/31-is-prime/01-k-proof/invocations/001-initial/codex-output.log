diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..fdb4024e264e4292c8f0b1146b1ffc236b9f2477
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,56 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The call semantics removes a fresh frame with a symbolic map update.
+  // MAP does not simplify this identity under a path constraint on its own,
+  // so expose the elementary finite-map fact to the symbolic backend.
+  rule M:Map [ L:Int <- undef ] => M
+    requires notBool (L in_keys(M))
+  rule ((M:Map L:Int |-> _V:Scope) [ L <- undef ]) => M
+    requires notBool (L in_keys(M))
+
+  // These two closed statement terms are the exact bodies emitted in
+  // solution.mpy.  Naming them keeps the reachability claims readable; the
+  // equations merely unfold syntax and do not summarize program execution.
+  syntax Stmts ::= "#helperBody" [function, total]
+  rule #helperBody
+    => If(Compare(
+         BinOp("*", Name("divisor"), Name("divisor")),
+         CmpOp(">", Name("n"))),
+         Return(Bool(true)),
+         .Stmts)
+       If(Compare(
+         BinOp("%", Name("n"), Name("divisor")),
+         CmpOp("==", Int(0))),
+         Return(Bool(false)),
+         .Stmts)
+       Return(Call(
+         Name("_is_prime_from"),
+         Name("n"),
+         BinOp("+", Name("divisor"), Int(1))))
+
+  syntax Stmts ::= "#entryBody" [function, total]
+  rule #entryBody
+    => If(Compare(Name("n"), CmpOp("<", Int(2))),
+         Return(Bool(false)),
+         .Stmts)
+       Return(Call(Name("_is_prime_from"), Name("n"), Int(2)))
+
+  // Executable mathematical specification.  For n >= 2, trialPrime(n,d)
+  // says that no divisor at or above d and at or below sqrt(n) divides n.
+  // This is the standard trial-division characterization of primality:
+  // every composite n >= 2 has a factor no greater than sqrt(n).
+  syntax Bool ::= trialPrime(Int, Int) [function]
+  rule trialPrime(N:Int, D:Int) => true
+    requires D *Int D >Int N
+  rule trialPrime(N:Int, D:Int) => false
+    requires D *Int D <=Int N andBool N %Int D ==Int 0
+  rule trialPrime(N:Int, D:Int) => trialPrime(N, D +Int 1)
+    requires D *Int D <=Int N andBool N %Int D =/=Int 0
+
+  syntax Bool ::= isPrimeSpec(Int) [function]
+  rule isPrimeSpec(N:Int) => false requires N <Int 2
+  rule isPrimeSpec(N:Int) => trialPrime(N, 2) requires N >=Int 2
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition proof-kompiled' in /work
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..6e2fec4fedf5ce9ca884af31b73f083d80abae97
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def _is_prime_from(n, divisor):
+    if divisor * divisor > n:
+        return True
+    if n % divisor == 0:
+        return False
+    return _is_prime_from(n, divisor + 1)
+
+
+def is_prime(n):
+    if n < 2:
+        return False
+    return _is_prime_from(n, 2)
