+  imports VERIFICATION-BASE
+
+  rule [DERIVED-LOOP]:
+    <k>
+      #while(#primeCond, #primeLoopBody)
+        ~> Return(Bool(true))
+        ~> #endcall
+      =>
+      Return(trialPrime(N:Int, 2))
+        ~> #endcall
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ...
+      1 |-> scope(
+        "n" |-> N
+        "divisor" |-> 2,
+        parent(0))
+      ...
+    </scopes>
+    [priority(20)]
+endmodule

