+            #helperBody,
+            0)
+          "is_prime" |-> closureVal(
+            "n", .ParamNames,
+            #entryBody,
+            0),
+          parent(-1)))
+    </scopes>
+    <scopeLoc> L +Int 1 => L </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, L)) STACK:List
+      =>
+      STACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool (L in_keys(
+      SC
+        0 |-> scope(
+          "_is_prime_from" |-> closureVal(
+            "n", "divisor", .ParamNames,
+            #helperBody,
+            0)
+          "is_prime" |-> closureVal(
+            "n", .ParamNames,
