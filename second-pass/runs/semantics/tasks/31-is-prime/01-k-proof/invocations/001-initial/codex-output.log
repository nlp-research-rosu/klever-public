+      =>
+      STACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2
+     andBool D >=Int 2
+     andBool SL ==Int L +Int 1
+     andBool notBool (L in_keys(
+       SC
+         0 |-> scope(
+           "is_prime" |-> closureVal(
+             "n", .ParamNames,
+             #entryBody,
+             0),
+           parent(-1))))
+endmodule

