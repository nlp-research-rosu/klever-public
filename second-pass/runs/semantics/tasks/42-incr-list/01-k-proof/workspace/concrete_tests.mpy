Module(
  FuncDef("incr_list", Params("l"),
    Expr(Str("Return list with elements incremented by 1."))
    Assign(Name("result"), ListExpr())
    For(Name("x"), Name("l"),
      Expr(
        Call(
          Attribute(Name("result"), "append"),
          BinOp("+", Name("x"), Int(1)))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("incr_list"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", ListExpr(Int(2), Int(3), Int(4)))))
  Assert(
    Compare(
      Call(
        Name("incr_list"),
        ListExpr(
          Int(5),
          Int(3),
          Int(5),
          Int(2),
          Int(3),
          Int(3),
          Int(9),
          Int(0),
          Int(123))),
      CmpOp(
        "==",
        ListExpr(
          Int(6),
          Int(4),
          Int(6),
          Int(3),
          Int(4),
          Int(4),
          Int(10),
          Int(1),
          Int(124)))))
  Assert(
    Compare(
      Call(Name("incr_list"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("incr_list"),
        ListExpr(UnaryOp("-", Int(2)), UnaryOp("-", Int(1)), Int(0))),
      CmpOp("==", ListExpr(UnaryOp("-", Int(1)), Int(0), Int(1))))))
