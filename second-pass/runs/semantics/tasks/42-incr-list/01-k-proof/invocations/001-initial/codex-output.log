diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..7ae8a699dbadbc64f4a60e00f5cda059e835beaf
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,36 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The exact constructor tree generated in solution.mpy.
+  syntax Module ::= "solutionProgram" [function, total]
+  rule solutionProgram =>
+    Module(
+      FuncDef("incr_list", Params("l"),
+        Expr(Str("Return list with elements incremented by 1."))
+        Return(
+          ListComp(BinOp("+", Name("x"), Int(1)),
+            CompFor(Name("x"), Name("l"), Bool(true))))))
+
+  // State the integer-list input domain and the element-wise result expected
+  // by the HumanEval contract directly over the semantics' native ValSeq.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(_:Int, VS:ValSeq)) => allInts(VS)
+  rule allInts(vCons(V:Val, _:ValSeq)) => false
+    requires notBool isInt(V)
+
+  syntax ValSeq ::= incrVals(ValSeq) [function, total]
+  rule incrVals(.ValSeq) => .ValSeq
+  rule incrVals(vCons(I:Int, VS:ValSeq)) =>
+    vCons(I +Int 1, incrVals(VS))
+  rule incrVals(VS:ValSeq) => .ValSeq
+    requires VS ==K .ValSeq
+
+  // Observe a returned heap object by its value. Temporary allocations remain
+  // in the heap but are deliberately outside the functional postcondition.
+  syntax KItem ::= "#observeResult"
+  rule <k> ref(H:Int) ~> #observeResult => V ... </k>
+       <heap> ... H |-> V:Val ... </heap>
+endmodule

