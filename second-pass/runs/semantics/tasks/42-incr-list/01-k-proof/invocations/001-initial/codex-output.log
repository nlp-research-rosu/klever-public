+       REST_SCOPES:Map)
+    </scopes>
+    <heap>
+      H |-> list(
+        PREFIX:ValSeq
+        => valSeqConcat(PREFIX, incrVals(IS)))
+      REST_HEAP:Map
+    </heap>
+endmodule
