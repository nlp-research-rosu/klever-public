+  claim [incr-list]:
+    <k>
+      #loadAll(solutionProgram)
+      ~> Call(Name("incr_list"), list(intVals(IS:IntSeq)))
+      ~> #observeResult
+      => list(?RESULT:ValSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINAL_SCOPES:Map
+    </scopes>
