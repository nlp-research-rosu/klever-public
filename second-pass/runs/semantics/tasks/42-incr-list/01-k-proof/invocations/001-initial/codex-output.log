+requires "verification.k"
+
+module LOOP-SPEC
+  imports VERIFICATION
+
+  claim [incr-loop]:
+    <k>
+      #loop(list(intVals(IS:IntSeq)), Name("x"), incrLoopBody)
+      ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (L |-> scope(("l" |-> INPUT:Val)
+                   ("result" |-> ref(H:Int))
+                   ("x" |-> (OLD_X:Val => ?FINAL_X:Val)),
+                   PAR:Parent)
+       REST_SCOPES:Map)
+    </scopes>
+    <heap>
+      H |-> list(
+        PREFIX:ValSeq
+        => valSeqConcat(PREFIX, incrVals(IS)))
+      REST_HEAP:Map
+    </heap>
+endmodule
