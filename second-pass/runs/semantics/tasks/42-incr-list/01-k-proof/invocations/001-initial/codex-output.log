exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification7-kompiled -I . && kprove loop-spec.k --definition verification7-kompiled --spec-module LOOP-SPEC --output pretty' in /work
