index 0000000000000000000000000000000000000000..4d4c41f64531b6af2a39055e6fbbfeb02a3c3a32
--- /dev/null
+++ b/sort-test.k
@@ -0,0 +1,8 @@
+requires "reference-semantics/semantics.k"
+
+module SORT-TEST
+  imports MPY
+  syntax IntValSeq ::= ".IntValSeq" [klabel(.ValSeq)]
+                     | "ivCons" "(" Int "," IntValSeq ")" [klabel(vCons)]
+  syntax ValSeq ::= IntValSeq
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..22c4267e2441f144f30b6cdf10146b4a76aa6f1c
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,26 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [incr-list]:
+    <k>
+      #loadAll(solutionProgram)
+      ~> Call(Name("incr_list"), list(intVals(IS:IntSeq)))
+      ~> #observeResult
+      => list(?RESULT:ValSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINAL_HEAP:Map </heap>
+    <heapLoc> 0 => ?FINAL_HEAP_LOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    ensures ?RESULT ==K incrVals(IS)
+endmodule
diff --git a/tmp-spec.k b/tmp-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..6fbd8bd71cf843f0cbbd219a880667f39798da5a
--- /dev/null
+++ b/tmp-spec.k
@@ -0,0 +1,8 @@
+requires "verification.k"
+
+module TMP-SPEC
+  imports VERIFICATION
+
+  claim <k> incrVals(VS:ValSeq) => .ValSeq </k>
+    requires VS ==K .ValSeq
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..83ec6ed72c64ca571c8612600039a2d756293bc5
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,59 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The exact constructor tree generated in solution.mpy.
+  syntax Module ::= "solutionProgram" [function, total]
+  rule solutionProgram =>
+    Module(
+      FuncDef("incr_list", Params("l"),
+        Expr(Str("Return list with elements incremented by 1."))
+        Assign(Name("result"), ListExpr(.Exprs))
+        For(Name("x"), Name("l"),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              BinOp("+", Name("x"), Int(1)))))
+        Return(Name("result"))))
+
+  // Embed a symbolic sequence of Python integers into ValSeq and define the
+  // mathematical element-wise increment used in the postcondition.
+  syntax ValSeq ::= intVals(IntSeq)
+                  | incrVals(IntSeq) [function, total]
+  rule incrVals(.IntSeq) => .ValSeq
+  rule incrVals(iCons(I:Int, IS:IntSeq)) =>
+    vCons(I +Int 1, incrVals(IS))
+
+  // Constructor-visible iterator equations let symbolic execution split on
+  // the IntSeq domain rather than widening each element to an arbitrary Val.
+  rule <k> #iterNext(list(intVals(.IntSeq))) => #iterDone ... </k>
+  rule <k> #iterNext(list(intVals(iCons(I:Int, IS:IntSeq))))
+        => #iterYield(I, list(intVals(IS))) ... </k>
+
+  syntax Stmts ::= "incrLoopBody" [function, total]
+  rule incrLoopBody =>
+    Expr(
+      Call(
+        Attribute(Name("result"), "append"),
+        BinOp("+", Name("x"), Int(1))))
+    .Stmts
+
+  // Right-associate concatenation so the loop invariant is preserved after
+  // appending one singleton to a symbolic prefix.
+  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
+    => valSeqConcat(A, valSeqConcat(B, C))
+    [simplification]
+  rule valSeqConcat(A:ValSeq, .ValSeq) => A
+    [simplification]
+
+  // Observe a returned heap object by its value. Temporary allocations remain
+  // in the heap but are deliberately outside the functional postcondition.
+  syntax KItem ::= "#observeResult" | "#observeNamed" "(" String ")"
+  rule <k> ref(H:Int) ~> #observeResult => V ... </k>
+       <heap> ... H |-> V:Val ... </heap>
+  rule <k> #observeNamed(X:String) => V ... </k>
+       <env> L:Int </env>
+       <scopes> ... L |-> scope((X |-> ref(H:Int)) _:Map, _) ... </scopes>
+       <heap> ... H |-> V:Val ... </heap>
+endmodule

diff --git a/loop-spec.k b/loop-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..04c0cfb5e2805212d18d9e5ba5782bba170ffd1d
--- /dev/null
+++ b/loop-spec.k
@@ -0,0 +1,23 @@
+requires "verification.k"
+
+module LOOP-SPEC
+  imports VERIFICATION
+
+  claim [incr-loop]:
+    <k>
+      #loop(list(intVals(IS:IntSeq)), Name("x"), incrLoopBody)
+      ~> #observeNamed("result")
+      => list(?RESULT:ValSeq)
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (L |-> scope(("result" |-> ref(H:Int)) FRAME:Map, PAR:Parent)
+       REST_SCOPES:Map)
+      => ?FINAL_SCOPES:Map
+    </scopes>
+    <heap>
+      (H |-> list(PREFIX:ValSeq) REST_HEAP:Map)
+      => ?FINAL_HEAP:Map
+    </heap>
+    ensures ?RESULT ==K valSeqConcat(PREFIX, incrVals(IS))
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..bb5fa6736b5546309299feb2a34f01cdbe6a2d51
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def incr_list(l: list):
+    """Return list with elements incremented by 1."""
+    result = []
+    for x in l:
+        result.append(x + 1)
+    return result
