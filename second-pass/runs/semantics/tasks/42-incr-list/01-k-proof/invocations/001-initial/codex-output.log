index 0000000000000000000000000000000000000000..4d4c41f64531b6af2a39055e6fbbfeb02a3c3a32
--- /dev/null
+++ b/sort-test.k
@@ -0,0 +1,8 @@
+requires "reference-semantics/semantics.k"
+
+module SORT-TEST
+  imports MPY
+  syntax IntValSeq ::= ".IntValSeq" [klabel(.ValSeq)]
+                     | "ivCons" "(" Int "," IntValSeq ")" [klabel(vCons)]
+  syntax ValSeq ::= IntValSeq
+endmodule
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..7901ae19d56216d152e6b9317fee0d8615fda7d6
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,27 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [incr-list]:
+    <k>
+      #loadAll(solutionProgram)
+      ~> Call(Name("incr_list"), list(VS:ValSeq))
+      ~> #observeResult
+      => list(?RESULT:ValSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINAL_HEAP:Map </heap>
+    <heapLoc> 0 => ?FINAL_HEAP_LOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires allInts(VS)
+    ensures ?RESULT ==K incrVals(VS)
+endmodule
