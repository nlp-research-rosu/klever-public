@@ -0,0 +1,47 @@
+requires "verification.k"
+
+module SPEC-GROUND-WITNESS
+  imports VERIFICATION
+
+  claim [empty]:
+    <k>
+      #loadAll(solutionProgram)
+      ~> Call(Name("incr_list"), list(intVals(.IntSeq)))
+      ~> #observeResult
+      => list(.ValSeq)
+    </k>
+    <env> 0 </env>
+    <scopes>
