index 0000000000000000000000000000000000000000..73da4eac0dee8665ecab02dd76b20aeb09c802cc
--- /dev/null
+++ b//tmp/audit-work/review/candidate/spec-ground-witness.k
@@ -0,0 +1,47 @@
+requires "verification.k"
+
+module SPEC-GROUND-WITNESS
+  imports VERIFICATION
+
+  claim [empty]:
+    <k>
+      #loadAll(solutionProgram)
+      ~> Call(Name("incr_list"), list(intVals(.IntSeq)))
+      ~> #observeResult
+      => list(.ValSeq)
