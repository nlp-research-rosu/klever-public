+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?_FINAL_HEAP:Map </heap>
+    <heapLoc> 0 => ?_FINAL_HEAP_LOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
+  claim [two-elements]:
