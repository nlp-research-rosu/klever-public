    38	    <scopes>
    39	      (0 |-> scope(.Map, parent(-1))
    40	       -1 |-> builtinsScope)
    41	      => ?_FINAL_SCOPES:Map
    42	    </scopes>
    43	    <scopeLoc> 1 </scopeLoc>
    44	    <heap> .Map => ?_FINAL_HEAP:Map </heap>
    45	    <heapLoc> 0 => ?_FINAL_HEAP_LOC:Int </heapLoc>
