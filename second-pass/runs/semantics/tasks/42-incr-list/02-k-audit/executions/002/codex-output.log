+      (L |-> scope(("l" |-> _INPUT:Val)
+                   ("result" |-> ref(H:Int))
+                   ("x" |-> (_OLD_X:Val => ?_FINAL_X:Val)),
+                   _PAR:Parent)
+       _REST_SCOPES:Map)
+    </scopes>
