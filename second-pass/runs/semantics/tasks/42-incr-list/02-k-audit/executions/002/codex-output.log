diff --git a//tmp/audit-work/reconstruction/auditor_concrete.py b//tmp/audit-work/reconstruction/auditor_concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..eb9eb1d51e535b37e7ca70acd0b195d4c76dc3db
--- /dev/null
+++ b//tmp/audit-work/reconstruction/auditor_concrete.py
@@ -0,0 +1,14 @@
+def incr_list(l: list):
+    """Return list with elements incremented by 1."""
+    result = []
+    for x in l:
+        result.append(x + 1)
+    return result
+
+
+assert incr_list([1, 2, 3]) == [2, 3, 4]
+assert incr_list([5, 3, 5, 2, 3, 3, 9, 0, 123]) == [
+    6, 4, 6, 3, 4, 4, 10, 1, 124
+]
+assert incr_list([]) == []
+assert incr_list([-2, -1, 0, 1]) == [-1, 0, 1, 2]
