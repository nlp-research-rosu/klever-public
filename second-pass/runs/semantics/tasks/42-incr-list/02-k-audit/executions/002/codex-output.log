+        and (REFERENCE / "reference-semantics").is_dir()
+    )
+    print(f"{'OK' if mode_ok else 'FAIL'} supplied-semantics mode/mount consistency")
+    ok &= mode_ok
+
+    pairs = [
+        ("prompt", CANDIDATE / "prompt.py", REFERENCE / "prompt.py"),
