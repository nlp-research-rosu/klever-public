    19	
    20	  // Embed a symbolic sequence of Python integers into ValSeq and define the
    21	  // mathematical element-wise increment used in the postcondition.
    22	  syntax ValSeq ::= intVals(IntSeq)
    23	                  | incrVals(IntSeq) [function, total]
    24	  rule incrVals(.IntSeq) => .ValSeq
    25	  rule incrVals(iCons(I:Int, IS:IntSeq)) =>
    26	    vCons(I +Int 1, incrVals(IS))
    27	
    28	  // Constructor-visible iterator equations let symbolic execution split on
    29	  // the IntSeq domain rather than widening each element to an arbitrary Val.
    30	  rule <k> #iterNext(list(intVals(.IntSeq))) => #iterDone ... </k>
    31	  rule <k> #iterNext(list(intVals(iCons(I:Int, IS:IntSeq))))
    32	        => #iterYield(I, list(intVals(IS))) ... </k>
    33	
    34	  syntax Stmts ::= "incrLoopBody" [function, total]
    35	  rule incrLoopBody =>
    36	    Expr(
    37	      Call(
    38	        Attribute(Name("result"), "append"),
    39	        BinOp("+", Name("x"), Int(1))))
    40	    .Stmts
    41	
    42	  // Right-associate concatenation so the loop invariant is preserved after
    43	  // appending one singleton to a symbolic prefix.
    44	  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
    45	    => valSeqConcat(A, valSeqConcat(B, C))
    46	    [simplification]
    47	  rule valSeqConcat(A:ValSeq, .ValSeq) => A
    48	    [simplification]
    49	
    50	  // Observe a returned heap object by its value. Temporary allocations remain
    51	  // in the heap but are deliberately outside the functional postcondition.
    52	  syntax KItem ::= "#observeResult"
    53	  rule <k> ref(H:Int) ~> #observeResult => V ... </k>
