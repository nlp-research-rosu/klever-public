     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Inductive loop invariant. The accumulator object stays at the same heap
     7	  // location and gains exactly the incremented form of the remaining input.
     8	  claim [incr-loop]:
     9	    <k>
    10	      #loop(list(intVals(IS:IntSeq)), Name("x"), incrLoopBody)
    11	      ~> CONT:K
    12	      => CONT
    13	    </k>
    14	    <env> L:Int </env>
    15	    <scopes>
    16	      (L |-> scope(("l" |-> _INPUT:Val)
    17	                   ("result" |-> ref(H:Int))
    18	                   ("x" |-> (_OLD_X:Val => ?_FINAL_X:Val)),
    19	                   _PAR:Parent)
    20	       _REST_SCOPES:Map)
    21	    </scopes>
    22	    <heap>
    23	      H |-> list(
    24	        PREFIX:ValSeq
    25	        => valSeqConcat(PREFIX, incrVals(IS)))
    26	      _REST_HEAP:Map
    27	    </heap>
    28	
    29	  // End-to-end contract for the exact solution.mpy constructor tree.
    30	  claim [incr-list]:
    31	    <k>
    32	      #loadAll(solutionProgram)
