+  claim [incr-loop]:
+    <k>
+      #loop(list(intVals(IS:IntSeq)), Name("x"), incrLoopBody)
+      ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (L |-> scope(("l" |-> _INPUT:Val)
+                   ("result" |-> ref(H:Int))
+                   ("x" |-> (_OLD_X:Val => ?_FINAL_X:Val)),
+                   _PAR:Parent)
+       _REST_SCOPES:Map)
+    </scopes>
+    <heap>
+      H |-> list(
+        PREFIX:ValSeq
+        => valSeqConcat(PREFIX, incrVals(IS)))
+      _REST_HEAP:Map
