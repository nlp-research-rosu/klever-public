+      1 |-> list(vCons(A, .ValSeq))
+      2 |-> list(vCons(B, vCons(C, vCons(D, .ValSeq))))
+      3 |-> list(
+             addMatch(
+               A, X, 1, 0,
+               addMatch(
+                 D, X, 2, 2,
+                 addMatch(
+                   C, X, 2, 1,
+                   addMatch(B, X, 2, 0, .ValSeq)))))
+      4 |-> list(
