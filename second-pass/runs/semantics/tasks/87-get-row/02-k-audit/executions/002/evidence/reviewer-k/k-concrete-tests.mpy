Module(
  FuncDef("get_row", Params("lst", "x"),
    Assign(Name("result"), ListExpr())
    For(TupleExpr(Name("row_index"), Name("row")), Call(Name("enumerate"), Name("lst")),
      For(Name("column_index"), Call(
        Name("range"),
        BinOp("-", Call(Name("len"), Name("row")), Int(1)),
        UnaryOp("-", Int(1)),
        UnaryOp("-", Int(1))),
        If(Compare(
          Subscript(Name("row"), Name("column_index")),
          CmpOp("==", Name("x"))),
          Expr(
            Call(
              Attribute(Name("result"), "append"),
              TupleExpr(Name("row_index"), Name("column_index")))),
          )))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("get_row"), ListExpr(), Int(9)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("get_row"), ListExpr(ListExpr()), UnaryOp("-", Int(1))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("get_row"), ListExpr(ListExpr(Int(0))), Int(0)),
      CmpOp("==", ListExpr(TupleExpr(Int(0), Int(0))))))
  Assert(
    Compare(
      Call(Name("get_row"), ListExpr(ListExpr(Int(0))), Int(1)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("get_row"),
        ListExpr(
          ListExpr(
            UnaryOp("-", Int(1)),
            UnaryOp("-", Int(1)),
            Int(0),
            UnaryOp("-", Int(1)))),
        UnaryOp("-", Int(1))),
      CmpOp(
        "==",
        ListExpr(
          TupleExpr(Int(0), Int(3)),
          TupleExpr(Int(0), Int(1)),
          TupleExpr(Int(0), Int(0))))))
  Assert(
    Compare(
      Call(
        Name("get_row"),
        ListExpr(
          ListExpr(),
          ListExpr(Int(5)),
          ListExpr(Int(5), Int(6), Int(5))),
        Int(5)),
      CmpOp(
        "==",
        ListExpr(
          TupleExpr(Int(1), Int(0)),
          TupleExpr(Int(2), Int(2)),
          TupleExpr(Int(2), Int(0))))))
  Assert(
    Compare(
      Call(
        Name("get_row"),
        ListExpr(
          ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(6)),
          ListExpr(Int(1), Int(2), Int(3), Int(4), Int(1), Int(6)),
          ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(1))),
        Int(1)),
      CmpOp(
        "==",
        ListExpr(
          TupleExpr(Int(0), Int(0)),
          TupleExpr(Int(1), Int(4)),
          TupleExpr(Int(1), Int(0)),
          TupleExpr(Int(2), Int(5)),
          TupleExpr(Int(2), Int(0)))))))
