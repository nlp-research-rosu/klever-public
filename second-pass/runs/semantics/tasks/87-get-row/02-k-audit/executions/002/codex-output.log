/bin/bash -lc "sed -n '1,120p' /tmp/audit-work/rebuild/expected-body.mpy
kast --definition /tmp/audit-work/rebuild/audit-verification-kompiled --input program --sort Stmts /tmp/audit-work/rebuild/expected-body.mpy --output json | sed -n '1,3p'" in /audit-output
