+(( rc == 0 )) || status=1
+
+python3 /reference/py2mpy.py k-concrete-tests.py > k-concrete-tests.mpy
+rc=$?
+printf 'concrete_test_translation_exit=%d\n' "$rc"
+(( rc == 0 )) || status=1
+
+kompile reference-semantics/semantics.k \
