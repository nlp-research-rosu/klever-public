rg -n '"'^'"\\s*(syntax|configuration|context|rule|claim|priority|module|endmodule)\\b' /reference/reference-semantics/semantics.k /reference/reference-semantics/semantics/*.k /candidate/verification.k /candidate/spec.k | sed -n '1,1200p'" in /audit-output
