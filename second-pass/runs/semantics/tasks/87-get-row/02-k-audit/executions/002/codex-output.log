@@ -0,0 +1,65 @@
+requires "verification.k"
+
+module AUDIT-BODY-IDENTITY
+  imports GET-ROW-VERIFICATION
+
+  // Independently transcribed constructor term from the freshly regenerated
+  // solution.mpy. K normalization compares it mechanically with the candidate
+  // proof-local definitions in the two reachability claims below.
+  syntax Stmts ::= "expectedGetRowBody" [function]
+  rule expectedGetRowBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       For(
+         TupleExpr(Name("row_index"), Name("row"), .Exprs),
+         Call(Name("enumerate"), Name("lst"), .Exprs),
+         For(
+           Name("column_index"),
+           Call(
+             Name("range"),
+             BinOp("-", Call(Name("len"), Name("row"), .Exprs), Int(1)),
+             UnaryOp("-", Int(1)),
+             UnaryOp("-", Int(1)),
+             .Exprs),
+           If(
+             Compare(
+               Subscript(Name("row"), Name("column_index")),
+               CmpOp("==", Name("x"))),
+             Expr(
+               Call(
+                 Attribute(Name("result"), "append"),
+                 TupleExpr(Name("row_index"), Name("column_index"), .Exprs),
+                 .Exprs)),
+             .Stmts)
+           .Stmts)
+         .Stmts)
+       Return(Name("result"))
+       .Stmts
+
+  syntax Val ::= "expectedGetRowClosure" [function]
+  rule expectedGetRowClosure
+    => closureVal(("lst", "x", .ParamNames), expectedGetRowBody, 0)
+
+  claim [body-identity]:
+    <k> getRowBody => expectedGetRowBody </k>
+    <env> E:Int </env>
+    <scopes> SC:Map </scopes>
+    <scopeLoc> SL:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> RS:RetState </ret>
+    <exc> EX:Exc </exc>
+    <exit-code> EC:Int </exit-code>
+
+  claim [closure-identity]:
+    <k> getRowClosure => expectedGetRowClosure </k>
+    <env> E:Int </env>
+    <scopes> SC:Map </scopes>
+    <scopeLoc> SL:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> RS:RetState </ret>
+    <exc> EX:Exc </exc>
+    <exit-code> EC:Int </exit-code>
+endmodule
diff --git a//tmp/audit-work/rebuild/k-concrete-tests.py b//tmp/audit-work/rebuild/k-concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..9f83551b4037de6d8bd2554b1eb2486c171710cb
--- /dev/null
+++ b//tmp/audit-work/rebuild/k-concrete-tests.py
@@ -0,0 +1,23 @@
+def get_row(lst, x):
+    result = []
+    for row_index, row in enumerate(lst):
+        for column_index in range(len(row) - 1, -1, -1):
+            if row[column_index] == x:
+                result.append((row_index, column_index))
+    return result
+
+
+assert get_row([], 9) == []
+assert get_row([[]], -1) == []
+assert get_row([[0]], 0) == [(0, 0)]
+assert get_row([[0]], 1) == []
+assert get_row([[-1, -1, 0, -1]], -1) == [(0, 3), (0, 1), (0, 0)]
+assert get_row([[], [5], [5, 6, 5]], 5) == [(1, 0), (2, 2), (2, 0)]
+assert get_row(
+    [
+        [1, 2, 3, 4, 5, 6],
+        [1, 2, 3, 4, 1, 6],
+        [1, 2, 3, 4, 5, 1],
+    ],
+    1,
+) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]
