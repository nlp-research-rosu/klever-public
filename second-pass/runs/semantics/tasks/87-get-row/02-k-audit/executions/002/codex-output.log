+requires "verification.k"
+
+module AUDIT-BODY-IDENTITY
+  imports GET-ROW-VERIFICATION
+
+  claim [body-identity]:
+    getRowBody
+    =>
+    Assign(Name("result"), ListExpr(.Exprs))
+    For(
+      TupleExpr(Name("row_index"), Name("row"), .Exprs),
+      Call(Name("enumerate"), Name("lst"), .Exprs),
+      For(
+        Name("column_index"),
+        Call(
+          Name("range"),
+          BinOp("-", Call(Name("len"), Name("row"), .Exprs), Int(1)),
+          UnaryOp("-", Int(1)),
+          UnaryOp("-", Int(1)),
+          .Exprs),
+        If(
+          Compare(
+            Subscript(Name("row"), Name("column_index")),
+            CmpOp("==", Name("x"))),
+          Expr(
+            Call(
+              Attribute(Name("result"), "append"),
+              TupleExpr(Name("row_index"), Name("column_index"), .Exprs),
+              .Exprs)),
+          .Stmts)
+        .Stmts)
+      .Stmts)
+    Return(Name("result"))
+    .Stmts
+
+  claim [closure-identity]:
+    getRowClosure
+    =>
+    closureVal(("lst", "x", .ParamNames), getRowBody, 0)
+endmodule
diff --git a//tmp/audit-work/rebuild/k-concrete-tests.py b//tmp/audit-work/rebuild/k-concrete-tests.py
