+printf 'positive_shape_claim_exit=%d\n' "$rc"
+(( rc == 0 )) || status=1
+
+kprove spec.k \
+  --definition audit-verification-kompiled \
+  --spec-module GET-ROW-SPEC
+rc=$?
+printf 'positive_combined_candidate_spec_exit=%d\n' "$rc"
+(( rc == 0 )) || status=1
+
+printf 'stage3_rebuild_exit=%d\n' "$status"
+exit "$status"
