  // with isInt(V) in its path condition refutes this branch without sort reasoning.
  syntax KItem ::= #sumAccF(Iterable, Float) | #sumContF(Float)
  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
        => #sumAccF(R, addF(intToF(ACC), {V}:>Float)) ... </k>
       requires isFloat(V) andBool notBool (isInt(V) orBool isBool(V))
  rule <k> #sumAccF(IT:Iterable, ACC:Float) => #iterNext(IT) ~> #sumContF(ACC) ... </k>
  rule <k> #iterDone ~> #sumContF(ACC:Float) => ACC ... </k>
  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
        => #sumAccF(R, addF(ACC, {V}:>Float)) ... </k>
       requires isFloat(V)
  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
        => #sumAccF(R, addF(ACC, intToF(intOf(V)))) ... </k>
       requires isInt(V) orBool isBool(V)
endmodule
requires "reference-semantics/semantics.k"

module GET-ROW-VERIFICATION
  imports MPY

  // This is the body emitted in solution.mpy, factored into a macro so that
  // the claims can install the function in the module scope without first
  // executing unrelated module-loading steps.
  syntax Stmts ::= "getRowBody" [function]
  rule getRowBody
    => Assign(Name("result"), ListExpr(.Exprs))
       For(
         TupleExpr(Name("row_index"), Name("row"), .Exprs),
         Call(Name("enumerate"), Name("lst"), .Exprs),
         For(
           Name("column_index"),
           Call(
             Name("range"),
             BinOp("-", Call(Name("len"), Name("row"), .Exprs), Int(1)),
             UnaryOp("-", Int(1)),
             UnaryOp("-", Int(1)),
             .Exprs),
           If(
             Compare(
               Subscript(Name("row"), Name("column_index")),
               CmpOp("==", Name("x"))),
             Expr(
               Call(
                 Attribute(Name("result"), "append"),
                 TupleExpr(Name("row_index"), Name("column_index"), .Exprs),
                 .Exprs)),
             .Stmts)
           .Stmts)
         .Stmts)
       Return(Name("result"))
       .Stmts

  syntax Val ::= "getRowClosure" [function]
  rule getRowClosure
    => closureVal(("lst", "x", .ParamNames), getRowBody, 0)

  // Prepend (ROW, COLUMN) exactly when VALUE equals the requested integer.
  // Nesting addMatch from the last visited coordinate to the first gives the
  // mathematical result sequence for a fixed ragged shape.
  syntax ValSeq ::= addMatch(Int, Int, Int, Int, ValSeq) [function, total]
  rule addMatch(V:Int, X:Int, R:Int, C:Int, REST:ValSeq)
    => vCons(tuple(vCons(R, vCons(C, .ValSeq))), REST)
    requires V ==Int X
  rule addMatch(V:Int, X:Int, _R:Int, _C:Int, REST:ValSeq)
    => REST
    requires V =/=Int X
endmodule
requires "verification.k"

module GET-ROW-SPEC
  imports GET-ROW-VERIFICATION

  // Every target integer maps the empty outer list to a fresh empty result.
  claim
    <k>
      Call(Name("get_row"), list(.ValSeq), X:Int, .Exprs)
      =>
      ref(0)
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope("get_row" |-> getRowClosure, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map
      =>
      0 |-> list(.ValSeq)
      1 |-> list(.ValSeq)
    </heap>
    <heapLoc> 0 => 2 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>

  // Exhaustive symbolic proof for a ragged [[], [A], [B,C,D]] shape.
  // A, B, C, D, and X are unconstrained integers, so kprove covers all
  // 2^4 match/non-match combinations.  The expected sequence encodes row
  // order 1 then 2 and descending columns 2, 1, 0 within the final row.
  claim
    <k>
      Call(
        Name("get_row"),
        list(vCons(ref(0), vCons(ref(1), vCons(ref(2), .ValSeq)))),
        X:Int,
        .Exprs)
      =>
      ref(3)
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope("get_row" |-> getRowClosure, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      0 |-> list(.ValSeq)
      1 |-> list(vCons(A:Int, .ValSeq))
      2 |-> list(vCons(B:Int, vCons(C:Int, vCons(D:Int, .ValSeq))))
      =>
      0 |-> list(.ValSeq)
      1 |-> list(vCons(A, .ValSeq))
      2 |-> list(vCons(B, vCons(C, vCons(D, .ValSeq))))
      3 |-> list(
             addMatch(
               A, X, 1, 0,
               addMatch(
                 D, X, 2, 2,
                 addMatch(
                   C, X, 2, 1,
                   addMatch(B, X, 2, 0, .ValSeq)))))
      4 |-> list(
             vCons(
               tuple(vCons(0, vCons(ref(0), .ValSeq))),
               vCons(
                 tuple(vCons(1, vCons(ref(1), .ValSeq))),
                 vCons(
                   tuple(vCons(2, vCons(ref(2), .ValSeq))),
                   .ValSeq))))
    </heap>
    <heapLoc> 3 => 5 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule

diff --git a//tmp/audit-work/rebuild/k-concrete-tests.py b//tmp/audit-work/rebuild/k-concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..9f83551b4037de6d8bd2554b1eb2486c171710cb
--- /dev/null
+++ b//tmp/audit-work/rebuild/k-concrete-tests.py
@@ -0,0 +1,23 @@
+def get_row(lst, x):
+    result = []
+    for row_index, row in enumerate(lst):
+        for column_index in range(len(row) - 1, -1, -1):
+            if row[column_index] == x:
+                result.append((row_index, column_index))
+    return result
+
+
+assert get_row([], 9) == []
+assert get_row([[]], -1) == []
+assert get_row([[0]], 0) == [(0, 0)]
+assert get_row([[0]], 1) == []
+assert get_row([[-1, -1, 0, -1]], -1) == [(0, 3), (0, 1), (0, 0)]
+assert get_row([[], [5], [5, 6, 5]], 5) == [(1, 0), (2, 2), (2, 0)]
+assert get_row(
+    [
+        [1, 2, 3, 4, 5, 6],
+        [1, 2, 3, 4, 1, 6],
+        [1, 2, 3, 4, 5, 1],
+    ],
+    1,
+) == [(0, 0), (1, 4), (1, 0), (2, 5), (2, 0)]
