Module(
  FuncDef("get_row", Params("lst", "x"),
    Assign(Name("result"), ListExpr())
    For(TupleExpr(Name("row_index"), Name("row")), Call(Name("enumerate"), Name("lst")),
      For(Name("column_index"), Call(
        Name("range"),
        BinOp("-", Call(Name("len"), Name("row")), Int(1)),
        UnaryOp("-", Int(1)),
        UnaryOp("-", Int(1))),
        If(Compare(
          Subscript(Name("row"), Name("column_index")),
          CmpOp("==", Name("x"))),
          Expr(
            Call(
              Attribute(Name("result"), "append"),
              TupleExpr(Name("row_index"), Name("column_index")))),
          )))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("get_row"), ListExpr(), Int(1)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("get_row"),
        ListExpr(
          ListExpr(),
          ListExpr(Int(1)),
          ListExpr(Int(2), Int(3), Int(4))),
        Int(9)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("get_row"),
        ListExpr(
          ListExpr(),
          ListExpr(Int(1)),
          ListExpr(Int(2), Int(3), Int(4))),
        Int(3)),
      CmpOp("==", ListExpr(TupleExpr(Int(2), Int(1))))))
  Assert(
    Compare(
      Call(
        Name("get_row"),
        ListExpr(
          ListExpr(Int(7), Int(7)),
          ListExpr(),
          ListExpr(Int(7), Int(8), Int(7))),
        Int(7)),
      CmpOp(
        "==",
        ListExpr(
          TupleExpr(Int(0), Int(1)),
          TupleExpr(Int(0), Int(0)),
          TupleExpr(Int(2), Int(2)),
          TupleExpr(Int(2), Int(0)))))))
