+from __future__ import annotations
+
+import collections
+import re
+from pathlib import Path
+
+WORK = Path("/tmp/audit-work/87-get-row")
+BASE = WORK / "reference-semantics"
+FILES = sorted(BASE.rglob("*.k")) + [WORK / "verification.k", WORK / "spec.k"]
+
