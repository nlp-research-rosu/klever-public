      "normalized_sha256": "8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "rationale": "Base equation defining the allInts structural precondition on the empty value sequence.",
      "source_rule_id": "rule-8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "start_line": 9,
      "text": "  rule allInts(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 11,
      "module": "REMOVE-DUPLICATES-VERIFICATION",
      "normalized_sha256": "4b7d8a3dd89930bb1f991f9d000323aad3d585fbda5fd4d1848373fe82de4ec3",
      "rationale": "Recursive equation defining allInts by checking the head value and recursing over the tail.",
      "source_rule_id": "rule-4b7d8a3dd89930bb1f991f9d000323aad3d585fbda5fd4d1848373fe82de4ec3",
      "start_line": 10,
      "text": "  rule allInts(vCons(V:Val, REST:ValSeq))\n    => isIntV(V) andBool allInts(REST)"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 17,
      "module": "REMOVE-DUPLICATES-VERIFICATION",
      "normalized_sha256": "45d546041e07c693a02ce0e4998fc5dd461eeaae328b3591a97828211cae17bd",
      "rationale": "Base case of the keepSinglesAcc mathematical summary, returning the accumulator when no input remains.",
      "source_rule_id": "rule-45d546041e07c693a02ce0e4998fc5dd461eeaae328b3591a97828211cae17bd",
      "start_line": 16,
      "text": "  rule keepSinglesAcc(ACC:ValSeq, .ValSeq, _ALL:ValSeq) => ACC\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 26,
      "module": "REMOVE-DUPLICATES-VERIFICATION",
      "normalized_sha256": "f182c17eceebcd68e6c4d08bf4b41078be53cda610c80ce60798a366c6efea7e",
      "rationale": "Recursive keepSinglesAcc equation defining the retain-head case when the head occurs exactly once in the original sequence.",
      "source_rule_id": "rule-f182c17eceebcd68e6c4d08bf4b41078be53cda610c80ce60798a366c6efea7e",
      "start_line": 18,
      "text": "  rule keepSinglesAcc(ACC:ValSeq,\n                      vCons(V:Val, REST:ValSeq),\n                      ALL:ValSeq)\n    => keepSinglesAcc(\n         valSeqConcat(ACC, vCons(V, .ValSeq)),\n         REST,\n         ALL)\n    requires 1 ==Int cntOccVS(ALL, V)\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 32,
      "module": "REMOVE-DUPLICATES-VERIFICATION",
      "normalized_sha256": "85709daa813b144f2a9305803f8c34a89fc45b5a3840fd340b8b6aa009594317",
      "rationale": "Recursive keepSinglesAcc equation defining the discard-head case when the head does not occur exactly once.",
      "source_rule_id": "rule-85709daa813b144f2a9305803f8c34a89fc45b5a3840fd340b8b6aa009594317",
      "start_line": 27,
      "text": "  rule keepSinglesAcc(ACC:ValSeq,\n                      vCons(V:Val, REST:ValSeq),\n                      ALL:ValSeq)\n    => keepSinglesAcc(ACC, REST, ALL)\n    requires notBool (1 ==Int cntOccVS(ALL, V))\n    [simplification]"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 49,
      "module": "REMOVE-DUPLICATES-VERIFICATION",
      "normalized_sha256": "442613f43787a483184b024d9daa6f57fe06416478d0dc9655232ec3c4d92fb5",
      "rationale": "Macro expansion naming the exact translated loop body used by the invariant and entry-point claims.",
      "source_rule_id": "rule-442613f43787a483184b024d9daa6f57fe06416478d0dc9655232ec3c4d92fb5",
      "start_line": 36,
      "text": "  rule #removeDuplicatesBody\n    => If(\n         Compare(\n           Call(\n             Attribute(Name(\"numbers\"), \"count\"),\n             Name(\"number\"), .Exprs),\n           CmpOp(\"==\", Int(1))),\n         Expr(\n           Call(\n             Attribute(Name(\"result\"), \"append\"),\n             Name(\"number\"), .Exprs))\n         .Stmts,\n         .Stmts)\n       .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 63,
      "module": "REMOVE-DUPLICATES-VERIFICATION",
      "normalized_sha256": "acbb93cb727d3a609e3ca238b000272a949fbd1c144b42dd558c237dc078cc11",
      "rationale": "Macro expansion naming the exact translated remove_duplicates closure used by the entry-point claims.",
      "source_rule_id": "rule-acbb93cb727d3a609e3ca238b000272a949fbd1c144b42dd558c237dc078cc11",
      "start_line": 53,
      "text": "  rule #removeDuplicatesClosure\n    => closureVal(\n         \"numbers\",\n         Assign(Name(\"result\"), ListExpr(.Exprs))\n         For(\n           Name(\"number\"),\n           Name(\"numbers\"),\n           #removeDuplicatesBody)\n         Return(Name(\"result\"))\n         .Stmts,\n         0)"
    }
  ],
