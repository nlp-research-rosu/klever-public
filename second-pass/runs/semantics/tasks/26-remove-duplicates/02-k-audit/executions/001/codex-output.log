+    [-9223372036854775808, -9223372036854775808, 9223372036854775807],
+    [10000000000000000000000000000000000000000, -10000000000000000000000000000000000000000],
+    [10000000000000000000000000000000000000000, 1, 10000000000000000000000000000000000000000]
+  ],
+  "exhaustive": {
+    "alphabet": [-2, -1, 0, 1, 2],
+    "lengths": [0, 1, 2, 3, 4, 5, 6]
+  },
+  "random": {
+    "seed": 260026,
+    "case_count": 2000,
+    "min_length": 0,
+    "max_length": 40,
+    "min_value": -1000000,
+    "max_value": 1000000,
+    "duplicate_injection_probability": 0.7
+  }
+}
