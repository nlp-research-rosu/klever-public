+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def check(label: str, condition: bool, detail: object = "") -> None:
+    if not condition:
+        raise AssertionError(f"FAIL {label}: {detail}")
+    print(f"PASS {label}: {detail}")
