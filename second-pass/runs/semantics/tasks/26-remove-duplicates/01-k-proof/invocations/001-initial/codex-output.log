+     andBool allInts(REST)
+
+  // Entry-point theorem: for every List[int], the returned list is exactly
+  // the stable subsequence of values whose total occurrence count is one.
+  claim
+    <k>
+      Call(
+        closureVal(
+          "numbers",
+          Assign(Name("result"), ListExpr(.Exprs))
+          For(
+            Name("number"),
+            Name("numbers"),
+            #removeDuplicatesBody)
+          Return(Name("result"))
+          .Stmts,
+          0),
+        list(INPUT), .Exprs)
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(keepSinglesAcc(.ValSeq, INPUT, INPUT))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(INPUT)
