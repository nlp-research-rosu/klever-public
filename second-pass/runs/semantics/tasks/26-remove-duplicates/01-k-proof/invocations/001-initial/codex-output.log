diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f2ab01b3a160ffa45564198a47427214246be8bb
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,39 @@
+requires "verification.k"
+
+module REMOVE-DUPLICATES-SPEC
+  imports REMOVE-DUPLICATES-VERIFICATION
+
+  claim
+    <k>
+      Call(
+        closureValC(
+          "numbers",
+          "numbers",
+          Return(
+            ListComp(Name("number"),
+              CompFor(
+                Name("number"),
+                Name("numbers"),
+                Compare(
+                  Call(Attribute(Name("numbers"), "count"), Name("number")),
+                  CmpOp("==", Int(1)))))),
+          .Map),
+        list(intVals(INPUT)), .Exprs)
+      => ref(?RESULT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => (?RESULT |-> list(keepSingles(intVals(INPUT), intVals(INPUT)))) ?HEAP
+    </heap>
+    <heapLoc> 0 => ?NEXT </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ae52fc20ac8fdc80e24baa9d5661561e22fedc6b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,22 @@
+requires "reference-semantics/semantics.k"
+
+module REMOVE-DUPLICATES-VERIFICATION
+  imports MPY
+
+  // HumanEval's input type is List[int].  This constructor embeds a symbolic
+  // sequence of mathematical integers into the semantics' heterogeneous ValSeq.
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  rule intVals(.IntSeq) => .ValSeq
+  rule intVals(iCons(I:Int, REST:IntSeq)) => vCons(I, intVals(REST))
+
+  // Mathematical specification: retain precisely those values whose total
+  // occurrence count in the original sequence is one, preserving order.
+  syntax ValSeq ::= keepSingles(ValSeq, ValSeq) [function]
+  rule keepSingles(.ValSeq, _ALL:ValSeq) => .ValSeq
+  rule keepSingles(vCons(V:Val, REST:ValSeq), ALL:ValSeq)
+    => vCons(V, keepSingles(REST, ALL))
+    requires cntOccVS(ALL, V) ==Int 1
+  rule keepSingles(vCons(V:Val, REST:ValSeq), ALL:ValSeq)
+    => keepSingles(REST, ALL)
+    requires notBool (cntOccVS(ALL, V) ==Int 1)
+endmodule

apply patch
patch: completed
/work/spec.k
/work/verification.k
