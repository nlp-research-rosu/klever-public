from typing import List


def remove_duplicates(numbers: List[int]) -> List[int]:
    result = []
    for number in numbers:
        if numbers.count(number) == 1:
            result.append(number)
    return result
Module(
  ImportFrom("typing", "List")
  FuncDef("remove_duplicates", Params("numbers"),
    Assign(Name("result"), ListExpr())
    For(Name("number"), Name("numbers"),
      If(Compare(
        Call(Attribute(Name("numbers"), "count"), Name("number")),
        CmpOp("==", Int(1))),
        Expr(Call(Attribute(Name("result"), "append"), Name("number"))),
        ))
    Return(Name("result"))))
requires "reference-semantics/semantics.k"

module REMOVE-DUPLICATES-VERIFICATION
  imports MPY

  // HumanEval's input type is List[int].  The predicate is carried as the
  // symbolic precondition, excluding the other Val constructors in MPY.
  syntax Bool ::= allInts(ValSeq) [function, total]
  rule allInts(.ValSeq) => true
  rule allInts(vCons(V:Val, REST:ValSeq))
    => isIntV(V) andBool allInts(REST)

  // Mathematical specification in accumulator form.  The form mirrors the
  // comprehension loop and therefore also serves as its induction invariant.
  syntax ValSeq ::= keepSinglesAcc(ValSeq, ValSeq, ValSeq) [function]
  rule keepSinglesAcc(ACC:ValSeq, .ValSeq, _ALL:ValSeq) => ACC
  rule keepSinglesAcc(ACC:ValSeq,
                      vCons(V:Val, REST:ValSeq),
                      ALL:ValSeq)
    => keepSinglesAcc(
         valSeqConcat(ACC, vCons(V, .ValSeq)),
         REST,
         ALL)
    requires cntOccVS(ALL, V) ==Int 1
  rule keepSinglesAcc(ACC:ValSeq,
                      vCons(V:Val, REST:ValSeq),
                      ALL:ValSeq)
    => keepSinglesAcc(ACC, REST, ALL)
    requires notBool (cntOccVS(ALL, V) ==Int 1)

  // The exact loop body emitted by py2mpy for solution.py.
  syntax Stmts ::= "#removeDuplicatesBody" [macro]
  rule #removeDuplicatesBody
    => If(
         Compare(
           Call(
             Attribute(Name("numbers"), "count"),
             Name("number"), .Exprs),
           CmpOp("==", Int(1))),
         Expr(
           Call(
             Attribute(Name("result"), "append"),
             Name("number"), .Exprs))
         .Stmts,
         .Stmts)
       .Stmts
endmodule
requires "verification.k"

module REMOVE-DUPLICATES-SPEC
  imports REMOVE-DUPLICATES-VERIFICATION

  // Loop invariant.  It is inductive on REST; the recursive #loop state is
  // discharged by circularity.
  claim [remove-duplicates-loop]:
    <k>
      #loop(list(REST), Name("number"), #removeDuplicatesBody)
      => .K
    </k>
    <env> LOCAL </env>
    <scopes>
      SCOPES
      LOCAL |-> scope(
        ("number" |-> OLD),
        ("numbers" |-> list(ALL))
        ("result" |-> ref(RESULT)),
        PARENT)
      =>
      SCOPES
      LOCAL |-> scope(
        ("number" |-> ?LAST),
        ("numbers" |-> list(ALL))
        ("result" |-> ref(RESULT)),
        PARENT)
    </scopes>
    <heap>
      (RESULT |-> list(ACC))
      HEAP
      =>
      (?RESULT |-> list(keepSinglesAcc(ACC, REST, ALL)))
      HEAP
    </heap>
    requires allInts(ALL)
     andBool allInts(REST)

  // Entry-point theorem: for every List[int], the returned list is exactly
  // the stable subsequence of values whose total occurrence count is one.
  claim
    <k>
      Call(
        closureVal(
          "numbers",
          Assign(Name("result"), ListExpr(.Exprs))
          For(
            Name("number"),
            Name("numbers"),
            #removeDuplicatesBody)
          Return(Name("result"))
          .Stmts,
          0),
        list(INPUT), .Exprs)
      => ref(0)
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map
      => 0 |-> list(keepSinglesAcc(.ValSeq, INPUT, INPUT))
    </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires allInts(INPUT)
endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..fe179955f9bfb0db8a52c0e8dc44d115b844cbdb
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,17 @@
+from typing import List
+
+
+def remove_duplicates(numbers: List[int]) -> List[int]:
+    result = []
+    for number in numbers:
+        if numbers.count(number) == 1:
+            result.append(number)
+    return result
+
+
+assert remove_duplicates([]) == []
+assert remove_duplicates([1]) == [1]
+assert remove_duplicates([1, 2, 3, 2, 4]) == [1, 3, 4]
+assert remove_duplicates([1, 1]) == []
+assert remove_duplicates([3, 1, 3, 2, 2, 4]) == [1, 4]
+assert remove_duplicates([-1, 0, -1, 2]) == [0, 2]
