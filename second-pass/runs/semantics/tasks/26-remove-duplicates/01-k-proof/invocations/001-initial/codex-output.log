+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(vCons(V, REST))
+     andBool 1 ==Int cntOccVS(vCons(V, REST), V)
+
+  claim [entry-drop]:
+    <k>
+      Call(
+        #removeDuplicatesClosure,
+        list(vCons(V, REST)), .Exprs)
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+           keepSinglesAcc(
+             .ValSeq,
+             REST,
+             vCons(V, REST)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(vCons(V, REST))
+     andBool notBool (
+       1 ==Int cntOccVS(vCons(V, REST), V))
