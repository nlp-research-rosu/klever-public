+requires "verification.k"
+
+module REMOVE-DUPLICATES-SPEC
+  imports REMOVE-DUPLICATES-VERIFICATION
+
+  // Induction invariant for the loop.  The result list contains the existing
+  // accumulator followed by precisely the singleton-occurrence elements in
+  // REST, in their original order.
+  claim [loop-invariant]:
+    <k>
+      #loop(list(REST), Name("number"), #removeDuplicatesBody)
+      => .K
+    </k>
+    <env> LOCAL </env>
+    <scopes>
+      SCOPES
+      LOCAL |-> scope(
+        ("number" |-> OLD)
+        ("numbers" |-> list(ALL))
+        ("result" |-> ref(RESULT)),
+        PARENT)
+      =>
+      SCOPES
+      LOCAL |-> scope(
+        ("number" |-> ?LAST)
+        ("numbers" |-> list(ALL))
+        ("result" |-> ref(RESULT)),
+        PARENT)
+    </scopes>
+    <heap>
+      (RESULT |-> list(ACC))
+      HEAP
+      =>
+      (RESULT |-> list(keepSinglesAcc(ACC, REST, ALL)))
+      HEAP
+    </heap>
+    requires allInts(ALL)
+     andBool allInts(REST)
+
+  // Entry-point theorem for every value satisfying the prompt's List[int]
+  // precondition.
+  claim [entry-correct]:
+    <k>
+      Call(#removeDuplicatesClosure, list(INPUT), .Exprs)
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(keepSinglesAcc(.ValSeq, INPUT, INPUT))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(INPUT)
+endmodule
