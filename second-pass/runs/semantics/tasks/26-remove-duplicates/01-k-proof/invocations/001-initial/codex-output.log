diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..56f4a564264fb989b516f5c5664a8e692e63ef82
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,86 @@
+requires "verification.k"
+
+module REMOVE-DUPLICATES-SPEC
+  imports REMOVE-DUPLICATES-VERIFICATION
+
+  // Loop invariant for the desugared list comprehension.  It is inductive on
+  // REST; the recursive #loop state is discharged by circularity.
+  claim [remove-duplicates-loop]:
+    <k>
+      #loop(list(REST), Name("number"), #removeDuplicatesBody)
+      => .K
+    </k>
+    <env> LOCAL </env>
+    <scopes>
+      SCOPES
+      LOCAL |-> scope(
+        ("$acc" |-> ref(ACCLOC)) LOCALVARS,
+        parent(OUTER))
+      OUTER |-> scope(
+        ("numbers" |-> cellRef(CELL))
+        ("$cells" |-> cellsMark("numbers"))
+        OUTERVARS,
+        OUTERPARENT)
+      =>
+      ?SCOPES
+      LOCAL |-> scope(
+        ("$acc" |-> ref(?RESULT)) ?LOCALVARS,
+        parent(OUTER))
+      OUTER |-> scope(
+        ("numbers" |-> cellRef(CELL))
+        ("$cells" |-> cellsMark("numbers"))
+        ?OUTERVARS,
+        OUTERPARENT)
+    </scopes>
+    <heap>
+      (CELL |-> cellV(list(ALL)))
+      (ACCLOC |-> list(ACC))
+      HEAP
+      =>
+      (CELL |-> cellV(list(ALL)))
+      (?RESULT |-> list(keepSinglesAcc(ACC, REST, ALL)))
+      ?HEAP
+    </heap>
+    <heapLoc> NEXT => ?NEXT </heapLoc>
+    requires allInts(ALL)
+     andBool allInts(REST)
+     andBool notBool ("$cells" in_keys(LOCALVARS))
+
+  // Entry-point theorem: for every List[int], the returned list is exactly
+  // the stable subsequence of values whose total occurrence count is one.
+  claim
+    <k>
+      Call(
+        closureValC(
+          "numbers",
+          "numbers",
+          Return(
+            ListComp(Name("number"),
+              CompFor(
+                Name("number"),
+                Name("numbers"),
+                Compare(
+                  Call(Attribute(Name("numbers"), "count"), Name("number")),
+                  CmpOp("==", Int(1)))))),
+          .Map),
+        list(INPUT), .Exprs)
+      => ref(?RESULT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => (?RESULT |-> list(
+            keepSinglesAcc(.ValSeq, INPUT, INPUT))) ?HEAP
+    </heap>
+    <heapLoc> 0 => ?NEXT </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(INPUT)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..6131185bf0cd0d00993a433303b2f2835984926c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,53 @@
+requires "reference-semantics/semantics.k"
+
+module REMOVE-DUPLICATES-VERIFICATION
+  imports MPY
+
+  // HumanEval's input type is List[int].  The predicate is carried as the
+  // symbolic precondition, excluding the other Val constructors in MPY.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, REST:ValSeq))
+    => isIntV(V) andBool allInts(REST)
+
+  // Mathematical specification in accumulator form.  The form mirrors the
+  // comprehension loop and therefore also serves as its induction invariant.
+  syntax ValSeq ::= keepSinglesAcc(ValSeq, ValSeq, ValSeq) [function]
+  rule keepSinglesAcc(ACC:ValSeq, .ValSeq, _ALL:ValSeq) => ACC
+  rule keepSinglesAcc(ACC:ValSeq,
+                      vCons(V:Val, REST:ValSeq),
+                      ALL:ValSeq)
+    => keepSinglesAcc(
+         valSeqConcat(ACC, vCons(V, .ValSeq)),
+         REST,
+         ALL)
+    requires cntOccVS(ALL, V) ==Int 1
+  rule keepSinglesAcc(ACC:ValSeq,
+                      vCons(V:Val, REST:ValSeq),
+                      ALL:ValSeq)
+    => keepSinglesAcc(ACC, REST, ALL)
+    requires notBool (cntOccVS(ALL, V) ==Int 1)
+
+  // The exact loop body produced by py2mpy's ListComp term and MPY's
+  // comprehension macro.
+  syntax Stmts ::= "#removeDuplicatesBody" [macro]
+  rule #removeDuplicatesBody
+    => If(
+         BoolOp(
+           "and",
+           Compare(
+             Call(
+               Attribute(Name("numbers"), "count"),
+               Name("number"), .Exprs),
+             CmpOp("==", Int(1))),
+           .Exprs),
+         Assign(
+           Name("$acc"),
+           BinOp(
+             "+",
+             Name("$acc"),
+             ListExpr(Name("number"), .Exprs)))
+         .Stmts,
+         .Stmts)
+       .Stmts
+endmodule

