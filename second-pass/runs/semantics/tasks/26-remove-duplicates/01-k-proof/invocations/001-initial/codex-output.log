+      => .K
+    </k>
+    <env> LOCAL </env>
+    <scopes>
+      SCOPES
+      LOCAL |-> scope(
+        ("number" |-> OLD)
+        ("numbers" |-> list(ALL))
+        ("result" |-> ref(RESULT)),
+        PARENT)
+      =>
+      SCOPES
+      LOCAL |-> scope(
+        ("number" |-> ?LAST)
+        ("numbers" |-> list(ALL))
+        ("result" |-> ref(RESULT)),
+        PARENT)
+    </scopes>
+    <heap>
