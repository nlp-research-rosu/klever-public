+               Name("number"), .Exprs),
+             CmpOp("==", Int(1))),
+           .Exprs),
+         Assign(
+           Name("$acc"),
+           BinOp(
+             "+",
+             Name("$acc"),
+             ListExpr(Name("number"), .Exprs)))
+         .Stmts,
+         .Stmts)
+       .Stmts
+endmodule

