+requires "verification.k"
+
+module REMOVE-DUPLICATES-SPEC
+  imports REMOVE-DUPLICATES-VERIFICATION
+
+  // The three loop claims form one exhaustive induction invariant: empty
+  // suffix, singleton-occurrence head, and repeated head.
+  claim [loop-empty]:
+    <k>
+      #loop(list(.ValSeq), Name("number"), #removeDuplicatesBody)
+      => .K
+    </k>
+    <env> LOCAL </env>
+    <scopes>
+      SCOPES
+      LOCAL |-> scope(
+        ("number" |-> OLD)
+        ("numbers" |-> list(ALL))
+        ("result" |-> ref(RESULT)),
+        PARENT)
+    </scopes>
+    <heap>
+      (RESULT |-> list(ACC))
+      HEAP
+    </heap>
+    requires allInts(ALL)
+
+  claim [loop-keep]:
+    <k>
+      #loop(
+        list(vCons(V, REST)),
+        Name("number"),
+        #removeDuplicatesBody)
+      => .K
+    </k>
+    <env> LOCAL </env>
+    <scopes>
+      SCOPES
+      LOCAL |-> scope(
+        ("number" |-> OLD)
+        ("numbers" |-> list(ALL))
+        ("result" |-> ref(RESULT)),
+        PARENT)
+      =>
+      SCOPES
+      LOCAL |-> scope(
+        ("number" |-> ?LAST)
+        ("numbers" |-> list(ALL))
+        ("result" |-> ref(RESULT)),
+        PARENT)
+    </scopes>
+    <heap>
+      (RESULT |-> list(ACC))
+      HEAP
+      =>
+      (RESULT |-> list(
+        keepSinglesAcc(
+          valSeqConcat(ACC, vCons(V, .ValSeq)),
+          REST,
+          ALL)))
+      HEAP
+    </heap>
+    requires allInts(ALL)
+     andBool allInts(vCons(V, REST))
+     andBool 1 ==Int cntOccVS(ALL, V)
+
+  claim [loop-drop]:
+    <k>
+      #loop(
+        list(vCons(V, REST)),
+        Name("number"),
+        #removeDuplicatesBody)
+      => .K
+    </k>
+    <env> LOCAL </env>
+    <scopes>
+      SCOPES
+      LOCAL |-> scope(
+        ("number" |-> OLD)
+        ("numbers" |-> list(ALL))
+        ("result" |-> ref(RESULT)),
+        PARENT)
+      =>
+      SCOPES
+      LOCAL |-> scope(
+        ("number" |-> ?LAST)
+        ("numbers" |-> list(ALL))
+        ("result" |-> ref(RESULT)),
+        PARENT)
+    </scopes>
+    <heap>
+      (RESULT |-> list(ACC))
+      HEAP
+      =>
+      (RESULT |-> list(
+        keepSinglesAcc(ACC, REST, ALL)))
+      HEAP
+    </heap>
+    requires allInts(ALL)
+     andBool allInts(vCons(V, REST))
+     andBool notBool (1 ==Int cntOccVS(ALL, V))
+
+  claim [entry-empty]:
+    <k>
+      Call(#removeDuplicatesClosure, list(.ValSeq), .Exprs)
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
