for item, source in zip(out['rules'], inv['rules']):
    assert list(item) == ['source_rule_id', 'classification', 'rationale']
    assert item['classification'] in allowed
    assert isinstance(item['rationale'], str) and item['rationale'].strip()
    if 'simplification' in source['attributes']:
        assert item['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
print(f\"validated {len(out['rules'])} rules; inventory {out['inventory_sha256']}\")
print('classification counts:')
for classification in sorted(allowed):
    print(classification, sum(r['classification'] == classification for r in out['rules']))
