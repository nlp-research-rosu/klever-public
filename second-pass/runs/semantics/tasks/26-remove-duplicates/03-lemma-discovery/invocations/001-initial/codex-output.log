requires "reference-semantics/semantics.k"

module REMOVE-DUPLICATES-VERIFICATION
  imports MPY

  // HumanEval's input type is List[int].  The predicate is carried as the
  // symbolic precondition, excluding the other Val constructors in MPY.
  syntax Bool ::= allInts(ValSeq) [function, total]
  rule allInts(.ValSeq) => true
  rule allInts(vCons(V:Val, REST:ValSeq))
    => isIntV(V) andBool allInts(REST)

  // Mathematical specification in accumulator form.  The form mirrors the
  // program loop and therefore also serves as its induction invariant.
  syntax ValSeq ::= keepSinglesAcc(ValSeq, ValSeq, ValSeq) [function, total]
  rule keepSinglesAcc(ACC:ValSeq, .ValSeq, _ALL:ValSeq) => ACC
    [simplification]
  rule keepSinglesAcc(ACC:ValSeq,
                      vCons(V:Val, REST:ValSeq),
                      ALL:ValSeq)
    => keepSinglesAcc(
         valSeqConcat(ACC, vCons(V, .ValSeq)),
         REST,
         ALL)
    requires 1 ==Int cntOccVS(ALL, V)
    [simplification]
  rule keepSinglesAcc(ACC:ValSeq,
                      vCons(V:Val, REST:ValSeq),
                      ALL:ValSeq)
    => keepSinglesAcc(ACC, REST, ALL)
    requires notBool (1 ==Int cntOccVS(ALL, V))
    [simplification]

  // The exact loop body emitted by py2mpy for solution.py.
  syntax Stmts ::= "#removeDuplicatesBody" [macro]
  rule #removeDuplicatesBody
    => If(
         Compare(
           Call(
             Attribute(Name("numbers"), "count"),
             Name("number"), .Exprs),
           CmpOp("==", Int(1))),
         Expr(
           Call(
             Attribute(Name("result"), "append"),
             Name("number"), .Exprs))
         .Stmts,
         .Stmts)
       .Stmts

  // Exact translated function body used by the entry-point claims.
  syntax Val ::= "#removeDuplicatesClosure" [macro]
  rule #removeDuplicatesClosure
    => closureVal(
         "numbers",
         Assign(Name("result"), ListExpr(.Exprs))
         For(
           Name("number"),
           Name("numbers"),
           #removeDuplicatesBody)
         Return(Name("result"))
         .Stmts,
         0)
endmodule
requires "verification.k"

module REMOVE-DUPLICATES-SPEC
  imports REMOVE-DUPLICATES-VERIFICATION

  // Induction invariant for the loop.  The result list contains the existing
  // accumulator followed by precisely the singleton-occurrence elements in
  // REST, in their original order.
  claim [loop-invariant]:
    <k>
      #loop(list(REST), Name("number"), #removeDuplicatesBody)
      ~> CONT
      => CONT
    </k>
    <env> LOCAL </env>
    <scopes>
      SCOPES
      LOCAL |-> scope(
        ("number" |-> OLD)
        ("numbers" |-> list(ALL))
        ("result" |-> ref(RESULT)),
        PARENT)
      =>
      SCOPES
      LOCAL |-> scope(
        ("number" |-> ?LAST)
        ("numbers" |-> list(ALL))
        ("result" |-> ref(RESULT)),
        PARENT)
    </scopes>
    <heap>
      (RESULT |-> list(ACC))
      HEAP
      =>
      (RESULT |-> list(keepSinglesAcc(ACC, REST, ALL)))
      HEAP
    </heap>
    requires allInts(ALL)
     andBool allInts(REST)

  // The following exhaustive entry cases establish the theorem for every
  // value satisfying the prompt's List[int] precondition.
  claim [entry-empty]:
    <k>
      Call(#removeDuplicatesClosure, list(.ValSeq), .Exprs)
      => ref(0)
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map
      => 0 |-> list(.ValSeq)
    </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>

  claim [entry-keep]:
    <k>
      Call(
        #removeDuplicatesClosure,
        list(vCons(V, REST)), .Exprs)
      => ref(0)
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map
      => 0 |-> list(
           keepSinglesAcc(
             vCons(V, .ValSeq),
             REST,
             vCons(V, REST)))
    </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires allInts(vCons(V, REST))
     andBool 1 ==Int cntOccVS(vCons(V, REST), V)

  claim [entry-drop]:
    <k>
      Call(
        #removeDuplicatesClosure,
        list(vCons(V, REST)), .Exprs)
      => ref(0)
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map
      => 0 |-> list(
           keepSinglesAcc(
             .ValSeq,
             REST,
             vCons(V, REST)))
    </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires allInts(vCons(V, REST))
     andBool notBool (
       1 ==Int cntOccVS(vCons(V, REST), V))
endmodule
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py concrete-tests.py > concrete-tests.mpy

kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun concrete-tests.mpy \
  --definition runtime-kompiled \
  --output none

kompile verification.k \
  --backend haskell \
  --main-module REMOVE-DUPLICATES-VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

# First prove the reusable loop invariant by circularity.
kprove spec.k \
  --definition verification-kompiled \
  --spec-module REMOVE-DUPLICATES-SPEC \
  --claims REMOVE-DUPLICATES-SPEC.loop-invariant \
  --output pretty

# Then use that already-proved invariant as a lemma for all entry cases.
kprove spec.k \
  --definition verification-kompiled \
  --spec-module REMOVE-DUPLICATES-SPEC \
  --trusted REMOVE-DUPLICATES-SPEC.loop-invariant \
  --output pretty

