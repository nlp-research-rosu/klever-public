+# helper trusted for this single-target replay so only `entry` is an obligation.
+run kprove spec-labeled.k \
+  --definition verification-kompiled \
+  --spec-module HOW-MANY-TIMES-SPEC-LABELED \
+  --claims acc,entry \
+  --trusted acc
+
+exit "$overall"

