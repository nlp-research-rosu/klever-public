+                     howManyTimesBody,
+                     0))
+             MODULE:Map,
+             parent(-1))
+      -1 |-> builtinsScope
+      REST:Map
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPNEXT:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
