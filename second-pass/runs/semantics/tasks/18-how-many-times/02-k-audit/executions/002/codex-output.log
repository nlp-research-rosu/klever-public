+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/fresh/spec-labeled.k b//tmp/audit-work/fresh/spec-labeled.k
new file mode 100644
