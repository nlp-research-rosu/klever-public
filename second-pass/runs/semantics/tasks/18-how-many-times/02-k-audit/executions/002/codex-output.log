diff --git a//tmp/audit-work/fresh/spec-bad-env-bridge.k b//tmp/audit-work/fresh/spec-bad-env-bridge.k
new file mode 100644
index 0000000000000000000000000000000000000000..7f2e3f2efb46a116521faea854d4317841ff4f3c
--- /dev/null
+++ b//tmp/audit-work/fresh/spec-bad-env-bridge.k
@@ -0,0 +1,27 @@
+requires "verification.k"
+
+module HOW-MANY-TIMES-BAD-ENV-BRIDGE
+  imports HOW-MANY-TIMES-VERIFICATION
