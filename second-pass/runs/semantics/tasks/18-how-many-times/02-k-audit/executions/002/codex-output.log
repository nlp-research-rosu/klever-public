diff --git a//tmp/audit-work/fresh/fixed-only.k b//tmp/audit-work/fresh/fixed-only.k
new file mode 100644
index 0000000000000000000000000000000000000000..304e8979c7d1924b3c857b676ffa71fd6cd32591
--- /dev/null
+++ b//tmp/audit-work/fresh/fixed-only.k
@@ -0,0 +1,26 @@
+requires "reference-semantics/semantics.k"
+
+module HOW-MANY-TIMES-FIXED-ONLY
+  imports MPY
+
+  syntax Stmts ::= "howManyTimesBody" [macro]
+  rule howManyTimesBody
+    => If(Compare(Name("substring"), CmpOp("==", Str(""))),
+          Return(BinOp("+", Call(Name("len"), Name("string")), Int(1))),
+          .Stmts)
+       If(Compare(Name("string"), CmpOp("==", Str(""))),
+          Return(Int(0)),
+          .Stmts)
+       Return(
+         BinOp(
+           "+",
+           IfExp(
+             Call(Attribute(Name("string"), "startswith"), Name("substring")),
+             Int(1),
+             Int(0)),
+           Call(
+             Name("how_many_times"),
+             Subscript(Name("string"), Slice(Int(1), NoBound, NoBound)),
+             Name("substring"))))
+       .Stmts
+endmodule
