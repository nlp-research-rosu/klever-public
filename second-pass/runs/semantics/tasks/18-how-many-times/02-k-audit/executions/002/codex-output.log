diff --git a//tmp/audit-work/fresh/spec-acc.k b//tmp/audit-work/fresh/spec-acc.k
new file mode 100644
index 0000000000000000000000000000000000000000..c5d5411aa0f9f78a5ab8753c9abb8f858c34fbc3
--- /dev/null
+++ b//tmp/audit-work/fresh/spec-acc.k
@@ -0,0 +1,16 @@
+requires "verification.k"
+
+module HOW-MANY-TIMES-SPEC-ACC
+  imports HOW-MANY-TIMES-VERIFICATION
+
+  claim
+    <k>
+      #overlapAcc(
+        S:IntSeq,
+        iCons(PC:Int, PS:IntSeq),
+        A:Int)
+      ~> CONT:K
+    =>
+      (A +Int overlapCount(S, iCons(PC, PS))) ~> CONT
+    </k>
+endmodule
diff --git a//tmp/audit-work/fresh/spec-entry.k b//tmp/audit-work/fresh/spec-entry.k
new file mode 100644
index 0000000000000000000000000000000000000000..88a1b1698ad50672c5e7d78cbab11fd2c6474ba5
--- /dev/null
+++ b//tmp/audit-work/fresh/spec-entry.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module HOW-MANY-TIMES-SPEC-ENTRY
+  imports HOW-MANY-TIMES-VERIFICATION
+
+  claim
+    <k>
+      #applyK(
+        toCall(
+          closureVal(
+            ("string", "substring"),
+            howManyTimesBody,
+            0)),
+        (str(S:IntSeq), str(P:IntSeq), .Vals))
+      ~> CONT:K
+    =>
+      overlapCount(S, P) ~> CONT
+    </k>
+    <env> CALLER:Int </env>
+    <scopes>
+      0 |-> scope(
+             ("how_many_times"
+               |-> closureVal(
+                     ("string", "substring"),
+                     howManyTimesBody,
+                     0))
+             MODULE:Map,
+             parent(-1))
+      -1 |-> builtinsScope
+      REST:Map
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPNEXT:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool
+      NEXT in_keys(
+        (0 |-> scope(
+                ("how_many_times"
+                  |-> closureVal(
+                        ("string", "substring"),
+                        howManyTimesBody,
+                        0))
+                MODULE,
+                parent(-1)))
+        (-1 |-> builtinsScope)
+        REST)
+endmodule
