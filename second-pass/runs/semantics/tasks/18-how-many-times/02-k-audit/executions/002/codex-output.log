+      overlapCount(S, P) ~> CONT
+    </k>
+    <env> CALLER:Int </env>
+    <scopes>
+      0 |-> scope(
+             ("how_many_times"
+               |-> closureVal(
+                     ("string", "substring"),
+                     howManyTimesBody,
+                     0))
+             MODULE:Map,
+             parent(-1))
+      -1 |-> builtinsScope
+      REST:Map
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPNEXT:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool
+      NEXT in_keys(
+        (0 |-> scope(
+                ("how_many_times"
+                  |-> closureVal(
+                        ("string", "substring"),
+                        howManyTimesBody,
+                        0))
+                MODULE,
+                parent(-1)))
+        (-1 |-> builtinsScope)
+        REST)
+    [label(entry)]
+endmodule
