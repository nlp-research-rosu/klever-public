+    <k>
+      #overlapAcc(
+        S:IntSeq,
+        iCons(PC:Int, PS:IntSeq),
+        A:Int)
+      ~> CONT:K
+    =>
+      (A +Int overlapCount(S, iCons(PC, PS))) ~> CONT
+    </k>
+
+  claim [entry]:
+    <k>
+      #applyK(
+        toCall(
+          closureVal(
