+    <heapLoc> HEAPNEXT:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool
+      NEXT in_keys(
+        (0 |-> scope(
+                ("how_many_times"
+                  |-> closureVal(
+                        ("string", "substring"),
+                        howManyTimesBody,
+                        0))
+                MODULE,
+                parent(-1)))
+        (-1 |-> builtinsScope)
+        REST)
+endmodule
