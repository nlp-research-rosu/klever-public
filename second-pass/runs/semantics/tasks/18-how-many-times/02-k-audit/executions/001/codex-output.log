rg -n 'SEMANTICS_DIFF_EXIT|DIFFERENTIAL_EXIT|LLVM_BUILD_EXIT|HASKELL_BUILD_EXIT|COMBINED_KPROVE_EXIT|HELPER_KPROVE_EXIT|ENTRY_KPROVE_EXIT|BRIDGE_WRONG_BINDING_KPROVE_EXIT|FIXED_WRONG_BINDING_KPROVE_EXIT|MUTATION_DRY_RUN_EXIT|MUTATION_KPROVE_EXIT' /audit-output/evidence/*.log
printf '%s\\n' '--- evidence total ---'
du -sh /audit-output/evidence /audit-output/REVIEW.md" in /audit-output
 succeeded in 0ms:
