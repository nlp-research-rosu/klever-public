+Module(
+  FuncDef("how_many_times", Params("string", "substring"),
+    If(Compare(Name("substring"), CmpOp("==", Str(""))),
+      Return(BinOp("+", Call(Name("len"), Name("string")), Int(1))),
+      )
+    If(Compare(Name("string"), CmpOp("==", Str(""))),
+      Return(Int(0)),
+      )
+    Return(
+      BinOp(
+        "+",
+        IfExp(
+          Call(
+            Attribute(Name("string"), "startswith"),
+            Name("substring")),
+          Int(1),
+          Int(0)),
+        Call(
+          Name("how_many_times"),
+          Subscript(Name("string"), Slice(Int(1), NoBound, NoBound)),
+          Name("substring")))))
+  Assert(
+    Compare(
+      Call(Name("how_many_times"), Str(""), Str("a")),
+      CmpOp("==", Int(0))))
+  Assert(
+    Compare(
+      Call(Name("how_many_times"), Str("aaa"), Str("a")),
+      CmpOp("==", Int(3))))
+  Assert(
+    Compare(
+      Call(Name("how_many_times"), Str("aaaa"), Str("aa")),
+      CmpOp("==", Int(3))))
+  Assert(
+    Compare(
+      Call(Name("how_many_times"), Str("abc"), Str("")),
+      CmpOp("==", Int(4)))))
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4bdd92399884efa3edb36b3b63fd1213a85a9223
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,8 @@
+def how_many_times(string: str, substring: str) -> int:
+    if substring == "":
+        return len(string) + 1
+    if string == "":
+        return 0
+    return (1 if string.startswith(substring) else 0) + how_many_times(
+        string[1:], substring
+    )
