--- /dev/null
+++ b/verification.k
@@ -0,0 +1,99 @@
+requires "reference-semantics/semantics.k"
+
+module HOW-MANY-TIMES-VERIFICATION
+  imports MPY
+
+  // The exact body emitted in solution.mpy, named so the proof claim can
+  // quantify over the surrounding machine state without duplicating the AST.
+  syntax Stmts ::= "howManyTimesBody" [macro]
+  rule howManyTimesBody
+    => If(Compare(Name("substring"), CmpOp("==", Str(""))),
+          Return(BinOp("+", Call(Name("len"), Name("string")), Int(1))),
+          .Stmts)
+       If(Compare(Name("string"), CmpOp("==", Str(""))),
+          Return(Int(0)),
+          .Stmts)
+       Return(
+         BinOp(
+           "+",
+           IfExp(
+             Call(Attribute(Name("string"), "startswith"), Name("substring")),
+             Int(1),
+             Int(0)),
+           Call(
+             Name("how_many_times"),
+             Subscript(Name("string"), Slice(Int(1), NoBound, NoBound)),
+             Name("substring"))))
+       .Stmts
+
+  // Mathematical contract: count a match at every starting position.  The
+  // empty pattern occurs at every boundary, including after the final code.
+  syntax Int ::= overlapCount(IntSeq, IntSeq) [function, total]
+  rule overlapCount(S:IntSeq, .IntSeq) => isLen(S) +Int 1
+  rule overlapCount(.IntSeq, iCons(_:Int, _:IntSeq)) => 0
+  rule overlapCount(
+         iCons(C:Int, CS:IntSeq),
+         iCons(PC:Int, PS:IntSeq))
+    => (#if startsWith(iCons(PC, PS), iCons(C, CS))
+         #then 1
+         #else 0
+         #fi)
+       +Int overlapCount(CS, iCons(PC, PS))
+
+  // Net effects of the two base-case calls.  Frame allocation, binding,
+  // lookup, return, and pop cancel out, leaving only the returned value.
+  rule
+    <k>
+      #applyK(
+        toCall(
+          closureVal(
+            ("string", "substring"),
+            howManyTimesBody,
+            0)),
+        (str(S:IntSeq), str(.IntSeq), .Vals))
+      ~> CONT:K
+      => (isLen(S) +Int 1) ~> CONT
+    </k>
+    [priority(30)]
+
+  rule
+    <k>
+      #applyK(
+        toCall(
+          closureVal(
+            ("string", "substring"),
+            howManyTimesBody,
+            0)),
+        (str(.IntSeq), str(iCons(PC:Int, PS:IntSeq)), .Vals))
+      ~> CONT:K
+      => 0 ~> CONT
+    </k>
+    [priority(30)]
+
+  // Inductive call summary for the recursive case.  The exact closure body
+  // in the redex ties the summary to solution.mpy.  Its equation is one
+  // unfolding of that body: test the current prefix, advance one code, and
+  // continue with the same nonempty pattern.
+  rule
+    <k>
+      #applyK(
+        toCall(
+          closureVal(
+            ("string", "substring"),
+            howManyTimesBody,
+            0)),
+        (str(iCons(C:Int, CS:IntSeq)),
+         str(iCons(PC:Int, PS:IntSeq)),
+         .Vals))
+      ~> CONT:K
+      => ((#if startsWith(
+                   iCons(PC, PS),
+                   iCons(C, CS))
+             #then 1
+             #else 0
+             #fi)
+          +Int overlapCount(CS, iCons(PC, PS)))
+         ~> CONT
+    </k>
+    [priority(30)]
+endmodule

