diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b653e1b37779c163bf2aa7098f99e8f06e21a517
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,105 @@
+requires "reference-semantics/semantics.k"
+
+module HOW-MANY-TIMES-VERIFICATION
+  imports MPY
+
+  // The exact body emitted in solution.mpy, named so the proof claim can
+  // quantify over the surrounding machine state without duplicating the AST.
+  syntax Stmts ::= "howManyTimesBody" [macro]
+  rule howManyTimesBody
+    => If(Compare(Name("substring"), CmpOp("==", Str(""))),
+          Return(BinOp("+", Call(Name("len"), Name("string")), Int(1))),
+          .Stmts)
+       If(Compare(Name("string"), CmpOp("==", Str(""))),
+          Return(Int(0)),
+          .Stmts)
+       Return(
+         BinOp(
+           "+",
+           IfExp(
+             Call(Attribute(Name("string"), "startswith"), Name("substring")),
+             Int(1),
+             Int(0)),
+           Call(
+             Name("how_many_times"),
+             Subscript(Name("string"), Slice(Int(1), NoBound, NoBound)),
+             Name("substring"))))
+       .Stmts
+
+  // The body after ordinary parameter substitution and global/builtin lookup.
+  // This is used only by the proof-frame specialization below.
+  syntax Stmts ::= "howManyTimesBodyFor" "(" Val "," Val ")" [macro]
+  rule howManyTimesBodyFor(STRING:Val, SUBSTRING:Val)
+    => If(Compare(SUBSTRING, CmpOp("==", str(.IntSeq))),
+          Return(
+            BinOp(
+              "+",
+              Call(builtinV("len"), STRING),
+              1)),
+          .Stmts)
+       If(Compare(STRING, CmpOp("==", str(.IntSeq))),
+          Return(0),
+          .Stmts)
+       Return(
+         BinOp(
+           "+",
+           IfExp(
+             Call(
+               boundMethodV(STRING, "startswith"),
+               SUBSTRING),
+             1,
+             0),
+           Call(
+             closureVal(
+               ("string", "substring"),
+               howManyTimesBody,
+               0),
+             Subscript(STRING, Slice(1, NoBound, NoBound)),
+             SUBSTRING)))
+       .Stmts
+
+  // Mathematical contract: count a match at every starting position.  The
+  // empty pattern occurs at every boundary, including after the final code.
+  syntax Int ::= overlapCount(IntSeq, IntSeq) [function, total]
+  rule overlapCount(S:IntSeq, .IntSeq) => isLen(S) +Int 1
+  rule overlapCount(.IntSeq, iCons(_:Int, _:IntSeq)) => 0
+  rule overlapCount(
+         iCons(C:Int, CS:IntSeq),
+         iCons(PC:Int, PS:IntSeq))
+    => (#if startsWith(iCons(PC, PS), iCons(C, CS))
+         #then 1
+         #else 0
+         #fi)
+       +Int overlapCount(CS, iCons(PC, PS))
+
+  // Symbolic Map unification otherwise loses parameter values between
+  // MPY-CALL's frame allocation, MPY-FUNCTIONS' #bindP steps, and ordinary
+  // name lookup.  This rule composes exactly those deterministic steps.
+  rule
+    <k>
+      #applyK(
+        toCall(
+          closureVal(
+            ("string", "substring"),
+            howManyTimesBody,
+            0)),
+        (STRING:Val, SUBSTRING:Val, .Vals))
+      ~> CONT:K
+      => howManyTimesBodyFor(STRING, SUBSTRING) ~> #endcall
+    </k>
+    <env> CALLER:Int => NEW:Int </env>
+    <scopes>
+      STORE:Map
+      => STORE [
+           NEW <-
+             scope(.Map, parent(0))
+         ]
+    </scopes>
+    <scopeLoc> NEW => NEW +Int 1 </scopeLoc>
+    <stack>
+      .List
+      => ListItem(frame(CONT, CALLER, NEW))
+      ...
+    </stack>
+    [priority(35)]
+endmodule

