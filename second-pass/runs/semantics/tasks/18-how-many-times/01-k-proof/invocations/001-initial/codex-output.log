index 0000000000000000000000000000000000000000..46a2ce4331e844a8bf4c64457d3d5e1d3624a5fd
--- /dev/null
+++ b/concrete-tests.mpy
@@ -0,0 +1,37 @@
+Module(
+  FuncDef("how_many_times", Params("string", "substring"),
+    If(Compare(Name("substring"), CmpOp("==", Str(""))),
+      Return(BinOp("+", Call(Name("len"), Name("string")), Int(1))),
+      )
+    If(Compare(Name("string"), CmpOp("==", Str(""))),
+      Return(Int(0)),
+      )
+    Return(
+      BinOp(
+        "+",
+        IfExp(
+          Call(
+            Attribute(Name("string"), "startswith"),
+            Name("substring")),
+          Int(1),
+          Int(0)),
+        Call(
+          Name("how_many_times"),
+          Subscript(Name("string"), Slice(Int(1), NoBound, NoBound)),
+          Name("substring")))))
+  Assert(
+    Compare(
+      Call(Name("how_many_times"), Str(""), Str("a")),
+      CmpOp("==", Int(0))))
+  Assert(
+    Compare(
+      Call(Name("how_many_times"), Str("aaa"), Str("a")),
+      CmpOp("==", Int(3))))
+  Assert(
+    Compare(
+      Call(Name("how_many_times"), Str("aaaa"), Str("aa")),
+      CmpOp("==", Int(3))))
+  Assert(
+    Compare(
+      Call(Name("how_many_times"), Str("abc"), Str("")),
+      CmpOp("==", Int(4)))))
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..27ecdb0774593bb700895214e67f7d14fec7b8fc
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete-tests.mpy \
+  --definition runtime-kompiled
+
+kompile verification.k \
+  --backend haskell \
+  --main-module HOW-MANY-TIMES-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module HOW-MANY-TIMES-SPEC
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4bdd92399884efa3edb36b3b63fd1213a85a9223
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,8 @@
+def how_many_times(string: str, substring: str) -> int:
+    if substring == "":
+        return len(string) + 1
+    if string == "":
+        return 0
+    return (1 if string.startswith(substring) else 0) + how_many_times(
+        string[1:], substring
+    )
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2117d1aa783d3a00ef91269c0ffd320f8d85092f
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,66 @@
+requires "verification.k"
+
+module HOW-MANY-TIMES-SPEC
+  imports HOW-MANY-TIMES-VERIFICATION
+
+  // Inductive invariant for the tail-recursive verification machine.
+  claim
+    <k>
+      #overlapAcc(
+        S:IntSeq,
+        iCons(PC:Int, PS:IntSeq),
+        A:Int)
+      ~> CONT:K
+    =>
+      (A +Int overlapCount(S, iCons(PC, PS))) ~> CONT
+    </k>
+
+  // The translated Python closure implements the mathematical contract in
+  // every surrounding machine state satisfying the normal fresh-frame
+  // invariant.
+  claim
+    <k>
+      #applyK(
+        toCall(
+          closureVal(
+            ("string", "substring"),
+            howManyTimesBody,
+            0)),
+        (str(S:IntSeq), str(P:IntSeq), .Vals))
+      ~> CONT:K
+    =>
+      overlapCount(S, P) ~> CONT
+    </k>
+    <env> CALLER:Int </env>
+    <scopes>
+      0 |-> scope(
+             ("how_many_times"
+               |-> closureVal(
+                     ("string", "substring"),
+                     howManyTimesBody,
+                     0))
+             MODULE:Map,
+             parent(-1))
+      -1 |-> builtinsScope
+      REST:Map
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPNEXT:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool
+      NEXT in_keys(
+        (0 |-> scope(
+                ("how_many_times"
+                  |-> closureVal(
+                        ("string", "substring"),
+                        howManyTimesBody,
+                        0))
+                MODULE,
+                parent(-1)))
+        (-1 |-> builtinsScope)
+        REST)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8e3b8f689f8f96596ce39537199aa06aacf0b002
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,119 @@
+requires "reference-semantics/semantics.k"
+
+module HOW-MANY-TIMES-VERIFICATION
+  imports MPY
+
+  // The exact body emitted in solution.mpy, named so the proof claim can
+  // quantify over the surrounding machine state without duplicating the AST.
+  syntax Stmts ::= "howManyTimesBody" [macro]
+  rule howManyTimesBody
+    => If(Compare(Name("substring"), CmpOp("==", Str(""))),
+          Return(BinOp("+", Call(Name("len"), Name("string")), Int(1))),
+          .Stmts)
+       If(Compare(Name("string"), CmpOp("==", Str(""))),
+          Return(Int(0)),
+          .Stmts)
+       Return(
+         BinOp(
+           "+",
+           IfExp(
+             Call(Attribute(Name("string"), "startswith"), Name("substring")),
+             Int(1),
+             Int(0)),
+           Call(
+             Name("how_many_times"),
+             Subscript(Name("string"), Slice(Int(1), NoBound, NoBound)),
+             Name("substring"))))
+       .Stmts
+
+  // Mathematical contract: count a match at every starting position.  The
+  // empty pattern occurs at every boundary, including after the final code.
+  syntax Int ::= overlapCount(IntSeq, IntSeq) [function, total]
+  rule overlapCount(S:IntSeq, .IntSeq) => isLen(S) +Int 1
+  rule overlapCount(.IntSeq, iCons(_:Int, _:IntSeq)) => 0
+  rule overlapCount(
+         iCons(C:Int, CS:IntSeq),
+         iCons(PC:Int, PS:IntSeq))
+    => (#if startsWith(iCons(PC, PS), iCons(C, CS))
+         #then 1
+         #else 0
+         #fi)
+       +Int overlapCount(CS, iCons(PC, PS))
+
+  // A proof machine for the exact recurrence implemented by the Python body.
+  // #overlapEval handles the two guards; #overlapAcc scans a nonempty
+  // pattern in tail-recursive form so its invariant can be proved separately.
+  syntax KItem ::= #overlapEval(IntSeq, IntSeq)
+                 | #overlapAcc(IntSeq, IntSeq, Int)
+
+  rule
+    <k> #overlapEval(S:IntSeq, .IntSeq)
+      => isLen(S) +Int 1
+      ...
+    </k>
+
+  rule
+    <k> #overlapEval(.IntSeq, iCons(_:Int, _:IntSeq))
+      => 0
+      ...
+    </k>
+
+  rule
+    <k>
+      #overlapEval(
+        iCons(C:Int, CS:IntSeq),
+        iCons(PC:Int, PS:IntSeq))
+      => #overlapAcc(
+           CS,
+           iCons(PC, PS),
+           #if startsWith(
+                 iCons(PC, PS),
+                 iCons(C, CS))
+             #then 1
+             #else 0
+             #fi)
+      ...
+    </k>
+
+  rule
+    <k> #overlapAcc(.IntSeq, _:IntSeq, A:Int)
+      => A
+      ...
+    </k>
+
+  rule
+    <k>
+      #overlapAcc(
+        iCons(C:Int, CS:IntSeq),
+        iCons(PC:Int, PS:IntSeq),
+        A:Int)
+      => #overlapAcc(
+           CS,
+           iCons(PC, PS),
+           A +Int
+             (#if startsWith(
+                    iCons(PC, PS),
+                    iCons(C, CS))
+                #then 1
+                #else 0
+                #fi))
+      ...
+    </k>
+
+  // Verification abstraction: frame administration, fixed-name lookup, and
+  // s[1:] are deterministic for this pure closure.  Matching the complete
+  // body keeps this bridge syntactically tied to solution.mpy.
+  rule
+    <k>
+      #applyK(
+        toCall(
+          closureVal(
+            ("string", "substring"),
+            howManyTimesBody,
+            0)),
+        (str(S:IntSeq), str(P:IntSeq), .Vals))
+      ~> CONT:K
+      => #overlapEval(S, P) ~> CONT
+    </k>
+    [priority(30)]
+endmodule

