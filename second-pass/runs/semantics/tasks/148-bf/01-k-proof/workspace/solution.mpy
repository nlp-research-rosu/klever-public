Module(
  FuncDef("bf", Params("planet1", "planet2"),
    Assign(
      Name("planets"),
      TupleExpr(
        Str("Mercury"),
        Str("Venus"),
        Str("Earth"),
        Str("Mars"),
        Str("Jupiter"),
        Str("Saturn"),
        Str("Uranus"),
        Str("Neptune")))
    If(BoolOp(
      "or",
      Compare(Name("planet1"), CmpOp("not in", Name("planets"))),
      Compare(Name("planet2"), CmpOp("not in", Name("planets")))),
      Return(TupleExpr()),
      )
    Assign(
      Name("first"),
      Call(Attribute(Name("planets"), "index"), Name("planet1")))
    Assign(
      Name("second"),
      Call(Attribute(Name("planets"), "index"), Name("planet2")))
    If(Compare(Name("first"), CmpOp("<", Name("second"))),
      Return(
        Subscript(
          Name("planets"),
          Slice(
            BinOp("+", Name("first"), Int(1)),
            Name("second"),
            NoBound))),
      )
    Return(
      Subscript(
        Name("planets"),
        Slice(
          BinOp("+", Name("second"), Int(1)),
          Name("first"),
          NoBound)))))
