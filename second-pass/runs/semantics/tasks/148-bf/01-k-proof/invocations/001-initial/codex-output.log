codex
The exhaustive claim is running as one symbolic proof over arbitrary strings. It is exploring the finite valid-name partition plus the invalid-name case; memory is stable at about 1.25 GB, safely below the 8 GB limit.
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..706533d840972032d574f6b12b3123a3e87b57fd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,18 @@
+def bf(planet1, planet2):
+    planets = (
+        "Mercury",
+        "Venus",
+        "Earth",
+        "Mars",
+        "Jupiter",
+        "Saturn",
+        "Uranus",
+        "Neptune",
+    )
+    if planet1 not in planets or planet2 not in planets:
+        return ()
+    first = planets.index(planet1)
+    second = planets.index(planet2)
+    if first < second:
+        return planets[first + 1:second]
+    return planets[second + 1:first]
