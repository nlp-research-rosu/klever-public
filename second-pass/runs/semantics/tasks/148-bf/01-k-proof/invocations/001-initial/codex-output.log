@@ -0,0 +1,18 @@
+def bf(planet1, planet2):
+    planets = (
+        "Mercury",
+        "Venus",
+        "Earth",
+        "Mars",
+        "Jupiter",
+        "Saturn",
+        "Uranus",
+        "Neptune",
+    )
+    if planet1 not in planets or planet2 not in planets:
+        return ()
+    first = planets.index(planet1)
+    second = planets.index(planet2)
+    if first < second:
+        return planets[first + 1:second]
+    return planets[second + 1:first]
