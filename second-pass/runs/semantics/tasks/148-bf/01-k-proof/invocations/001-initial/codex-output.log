+     andBool A =/=K strToCodes("Neptune")
+
+  // If the first name is valid and the second is invalid.
+  claim
+    <k> bfRun(str(A), str(B)) => tuple(.ValSeq) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires (A ==K strToCodes("Mercury")
