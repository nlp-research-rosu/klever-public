+
+module BF-SPEC
+  imports BF-VERIFICATION
+
+  claim
+    <k>
+      bfRun(str(planetCodes(P)), str(planetCodes(Q)))
+    =>
+      expectedBetween(planetPosition(P), planetPosition(Q))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
