/bin/bash -lc "python3 - <<'PY'
import hashlib, json, pathlib, sys
inv_path=pathlib.Path('/reference/rule-inventory.json')
out_path=pathlib.Path('/workspace/trust-boundary.json')
inv=json.loads(inv_path.read_text())
out=json.loads(out_path.read_text())
errors=[]
if list(out.keys()) "'!= ['"'schema_version','inventory_sha256','rules']:
    errors.append(f'top-level keys/order: {list(out.keys())}')
if out.get('schema_version') "'!= 2:
    errors.append('"'schema_version')
if out.get('inventory_sha256') "'!= inv.get('"'inventory_sha256'):
    errors.append('inventory_sha256')
expected=[r['source_rule_id'] for r in inv['rules']]
actual=[r.get('source_rule_id') for r in out.get('rules',[])]
if actual "'!= expected:
    errors.append('"'rule ids/order')
if len(actual) "'!= len(set(actual)):
    errors.append('"'duplicate rule ids')
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
for i,r in enumerate(out.get('rules',[])):
    if set(r) "'!= {'"'source_rule_id','classification','rationale'}:
        errors.append(f'entry {i} fields {set(r)}')
    if r.get('classification') not in allowed:
        errors.append(f'entry {i} classification')
    if not isinstance(r.get('rationale'),str) or not r['rationale'].strip():
        errors.append(f'entry {i} rationale')
byid={r['source_rule_id']:r for r in out['rules']}
for r in inv['rules']:
    if 'simplification' in r.get('attributes',[]) and byid[r['source_rule_id']]['classification'] not in {'DEFINITION','DOMAIN_LEMMA'}:
        errors.append(f'simplification classification {r[\"source_rule_id\"]}')
counts={c:sum(r['classification']==c for r in out['rules']) for c in sorted(allowed)}
print('inventory_sha256:', out['inventory_sha256'])
print('rules:', len(actual), 'unique:', len(set(actual)), 'order_exact:', actual == expected)
print('classifications:', counts)
print('top_keys_exact:', set(out)=={'schema_version','inventory_sha256','rules'})
print('entry_fields_exact:', all(set(r)=={'source_rule_id','classification','rationale'} for r in out['rules']))
print('simplification_rules:', sum('simplification' in r.get('attributes',[]) for r in inv['rules']))
print('validation:', 'PASS' if not errors else 'FAIL')
if errors:
    print('\\n'.join(errors))
    sys.exit(1)
PY
