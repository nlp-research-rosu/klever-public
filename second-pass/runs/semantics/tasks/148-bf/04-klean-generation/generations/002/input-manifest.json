      "rationale": "Executes and observes one nonterminal valid input pair, then advances the case-loop column.",
      "source_rule_id": "rule-ffb05297da40e46fafcaf4530ad7a485c977e134a4983325d93634de75d267f0",
      "start_line": 128,
      "text": "  rule <k>\n         #validCases(I, J)\n       =>\n         Assert(\n           Compare(\n             bfRun(planetExpr(I), planetExpr(J)),\n             CmpOp(\"==\", expectedBetween(I, J))))\n         ~> #validCases(I, J +Int 1)\n       ...\n       </k>\n    requires 0 <=Int I andBool I <=Int 7\n     andBool 0 <=Int J andBool J <Int 7"
    },
    {
      "attributes": [],
      "classification": "OPERATIONAL_RULE",
      "end_line": 151,
      "module": "BF-VERIFICATION",
      "normalized_sha256": "6462e50ab9a7329c72b43763c45f6aba79d2fb66ce11b90ba820a450a8bdbe12",
      "rationale": "Executes and observes the final pair in a row, then advances the case loop to the next planet.",
      "source_rule_id": "rule-6462e50ab9a7329c72b43763c45f6aba79d2fb66ce11b90ba820a450a8bdbe12",
      "start_line": 141,
      "text": "  rule <k>\n         #validCases(I, 7)\n       =>\n         Assert(\n           Compare(\n             bfRun(planetExpr(I), planetExpr(7)),\n             CmpOp(\"==\", expectedBetween(I, 7))))\n         ~> #validCases(I +Int 1, 0)\n       ...\n       </k>\n    requires 0 <=Int I andBool I <Int 7"
    },
    {
      "attributes": [],
      "classification": "OPERATIONAL_RULE",
      "end_line": 161,
      "module": "BF-VERIFICATION",
      "normalized_sha256": "2dd8d74da214581b9df0ad3500d04b12e48fc4ec51d5293f41e413d184095f26",
      "rationale": "Executes and observes the terminal valid input pair and ends the deterministic case loop.",
      "source_rule_id": "rule-2dd8d74da214581b9df0ad3500d04b12e48fc4ec51d5293f41e413d184095f26",
      "start_line": 153,
      "text": "  rule <k>\n         #validCases(7, 7)\n       =>\n         Assert(\n           Compare(\n             bfRun(planetExpr(7), planetExpr(7)),\n             CmpOp(\"==\", expectedBetween(7, 7))))\n       ...\n       </k>"
    }
