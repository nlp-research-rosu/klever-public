{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 50,
      "module": "BF-VERIFICATION",
      "normalized_sha256": "498d8a44f2723977b196cf5bbaf97b3f8453e2903e81a8f5f21fe32c024a2018",
      "rationale": "Expands the named bfBody proof term to the exact translated statement sequence of the submitted function.",
      "source_rule_id": "rule-498d8a44f2723977b196cf5bbaf97b3f8453e2903e81a8f5f21fe32c024a2018",
      "start_line": 9,
      "text": "  rule bfBody\n    => Assign(\n         Name(\"planets\"),\n         TupleExpr(\n           Str(\"Mercury\"),\n           Str(\"Venus\"),\n           Str(\"Earth\"),\n           Str(\"Mars\"),\n           Str(\"Jupiter\"),\n           Str(\"Saturn\"),\n           Str(\"Uranus\"),\n           Str(\"Neptune\")))\n       If(\n         BoolOp(\n           \"or\",\n           Compare(Name(\"planet1\"), CmpOp(\"not in\", Name(\"planets\"))),\n           Compare(Name(\"planet2\"), CmpOp(\"not in\", Name(\"planets\")))),\n         Return(TupleExpr(.Exprs)),\n         .Stmts)\n       Assign(\n         Name(\"first\"),\n         Call(Attribute(Name(\"planets\"), \"index\"), Name(\"planet1\")))\n       Assign(\n         Name(\"second\"),\n         Call(Attribute(Name(\"planets\"), \"index\"), Name(\"planet2\")))\n       If(\n         Compare(Name(\"first\"), CmpOp(\"<\", Name(\"second\"))),\n         Return(\n           Subscript(\n             Name(\"planets\"),\n             Slice(\n               BinOp(\"+\", Name(\"first\"), Int(1)),\n               Name(\"second\"),\n               NoBound))),\n         .Stmts)\n       Return(\n         Subscript(\n           Name(\"planets\"),\n           Slice(\n             BinOp(\"+\", Name(\"second\"), Int(1)),\n             Name(\"first\"),\n             NoBound)))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 56,
      "module": "BF-VERIFICATION",
      "normalized_sha256": "77347eaa3187dac6a4f962f36a918b4ac43e18e4364241d8d5f17291d2a4391a",
      "rationale": "Expands bfCall into a module containing the target definition followed by a call with the supplied arguments.",
      "source_rule_id": "rule-77347eaa3187dac6a4f962f36a918b4ac43e18e4364241d8d5f17291d2a4391a",
      "start_line": 53,
      "text": "  rule bfCall(P1, P2)\n    => Module(\n         FuncDef(\"bf\", Params(\"planet1\", \"planet2\"), bfBody)\n         Expr(Call(Name(\"bf\"), P1, P2)))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 66,
      "module": "BF-VERIFICATION",
      "normalized_sha256": "f90f2f08172a8bad8de9637aa6a398a985df3abcee34709a1fc04ce72781cc44",
      "rationale": "Expands bfRun into the closure-valued target call used as the named proof execution term.",
      "source_rule_id": "rule-f90f2f08172a8bad8de9637aa6a398a985df3abcee34709a1fc04ce72781cc44",
      "start_line": 59,
      "text": "  rule bfRun(P1, P2)\n    => Call(\n         closureVal(\n           \"planet1\", \"planet2\", .ParamNames,\n           bfBody,\n           0),\n         P1,\n         P2)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 79,
      "module": "BF-VERIFICATION",
      "normalized_sha256": "66d6d332b22c0d29515d8cdac09c963fc7556c6fbe037fe69572e476beee68a0",
      "rationale": "Defines the canonical ordered ValSeq of the eight planet-name values.",
      "source_rule_id": "rule-66d6d332b22c0d29515d8cdac09c963fc7556c6fbe037fe69572e476beee68a0",
      "start_line": 71,
      "text": "  rule planetVals\n    => vCons(str(strToCodes(\"Mercury\")),\n       vCons(str(strToCodes(\"Venus\")),\n       vCons(str(strToCodes(\"Earth\")),\n       vCons(str(strToCodes(\"Mars\")),\n       vCons(str(strToCodes(\"Jupiter\")),\n       vCons(str(strToCodes(\"Saturn\")),\n       vCons(str(strToCodes(\"Uranus\")),\n       vCons(str(strToCodes(\"Neptune\")), .ValSeq))))))))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 87,
      "module": "BF-VERIFICATION",
      "normalized_sha256": "236019d7f25c5784d0c8fa28338365d5e0ef879d47617466312519cf19cc5d01",
      "rationale": "Defines the mathematical expected result as the open slice between two orbital indices.",
      "source_rule_id": "rule-236019d7f25c5784d0c8fa28338365d5e0ef879d47617466312519cf19cc5d01",
      "start_line": 82,
      "text": "  rule expectedBetween(I, J)\n    => doSlice(\n         tuple(planetVals),\n         someB(minInt(I, J) +Int 1),\n         someB(maxInt(I, J)),\n         noB)"
    },
    {
