     1	requires "reference-semantics/semantics.k"
     2	
     3	module BF-VERIFICATION
     4	  imports MPY
     5	
     6	  // This is the exact AST emitted in solution.mpy, factored out only so that
     7	  // the reachability claims can supply arbitrary arguments to a final call.
     8	  syntax Stmts ::= "bfBody" [macro]
     9	  rule bfBody
    10	    => Assign(
    11	         Name("planets"),
    12	         TupleExpr(
    13	           Str("Mercury"),
    14	           Str("Venus"),
    15	           Str("Earth"),
    16	           Str("Mars"),
    17	           Str("Jupiter"),
    18	           Str("Saturn"),
    19	           Str("Uranus"),
    20	           Str("Neptune")))
    21	       If(
    22	         BoolOp(
    23	           "or",
    24	           Compare(Name("planet1"), CmpOp("not in", Name("planets"))),
    25	           Compare(Name("planet2"), CmpOp("not in", Name("planets")))),
    26	         Return(TupleExpr(.Exprs)),
    27	         .Stmts)
    28	       Assign(
    29	         Name("first"),
    30	         Call(Attribute(Name("planets"), "index"), Name("planet1")))
    31	       Assign(
    32	         Name("second"),
    33	         Call(Attribute(Name("planets"), "index"), Name("planet2")))
    34	       If(
    35	         Compare(Name("first"), CmpOp("<", Name("second"))),
    36	         Return(
    37	           Subscript(
    38	             Name("planets"),
    39	             Slice(
    40	               BinOp("+", Name("first"), Int(1)),
    41	               Name("second"),
    42	               NoBound))),
    43	         .Stmts)
    44	       Return(
    45	         Subscript(
    46	           Name("planets"),
    47	           Slice(
    48	             BinOp("+", Name("second"), Int(1)),
    49	             Name("first"),
    50	             NoBound)))
    51	
    52	  syntax Module ::= "bfCall" "(" Expr "," Expr ")" [macro]
    53	  rule bfCall(P1, P2)
    54	    => Module(
    55	         FuncDef("bf", Params("planet1", "planet2"), bfBody)
    56	         Expr(Call(Name("bf"), P1, P2)))
    57	
    58	  syntax Expr ::= "bfRun" "(" Expr "," Expr ")" [macro]
    59	  rule bfRun(P1, P2)
    60	    => Call(
    61	         closureVal(
    62	           "planet1", "planet2", .ParamNames,
    63	           bfBody,
    64	           0),
    65	         P1,
    66	         P2)
    67	
    68	  // An independent mathematical form of the contract: take the open interval
    69	  // between the two orbital positions from the canonical planet sequence.
    70	  syntax ValSeq ::= "planetVals" [function, total]
    71	  rule planetVals
    72	    => vCons(str(strToCodes("Mercury")),
    73	       vCons(str(strToCodes("Venus")),
    74	       vCons(str(strToCodes("Earth")),
    75	       vCons(str(strToCodes("Mars")),
    76	       vCons(str(strToCodes("Jupiter")),
    77	       vCons(str(strToCodes("Saturn")),
    78	       vCons(str(strToCodes("Uranus")),
    79	       vCons(str(strToCodes("Neptune")), .ValSeq))))))))
    80	
    81	  syntax Val ::= expectedBetween(Int, Int) [function, total]
    82	  rule expectedBetween(I, J)
