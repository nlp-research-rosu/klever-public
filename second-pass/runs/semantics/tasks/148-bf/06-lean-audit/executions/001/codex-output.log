    99	  rule planetCodes(pJupiter) => strToCodes("Jupiter")
   100	  rule planetCodes(pSaturn)  => strToCodes("Saturn")
   101	  rule planetCodes(pUranus)  => strToCodes("Uranus")
   102	  rule planetCodes(pNeptune) => strToCodes("Neptune")
   103	
