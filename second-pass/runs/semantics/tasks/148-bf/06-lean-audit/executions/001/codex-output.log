/reference/k-proof/reference-semantics/semantics/call.k-58-       <heap> ... H |-> V:Val ... </heap>
/reference/k-proof/reference-semantics/semantics/call.k-59-       requires notBool isMutMethod(M)
/reference/k-proof/reference-semantics/semantics/call.k-60-       [priority(40)]
/reference/k-proof/reference-semantics/semantics/call.k-61-  // non-mutating methods READ their heap-object arguments too (join's list);
/reference/k-proof/reference-semantics/semantics/call.k-62-  // mutators keep refs (append of a list into a list-of-lists stays aliased)
/reference/k-proof/reference-semantics/semantics/call.k:63:  rule <k> #applyK(toCall(boundMethodV(OBJ:Val, M:String)), (ref(H:Int), REST:Vals))
/reference/k-proof/reference-semantics/semantics/call.k-64-        => #applyK(toCall(boundMethodV(OBJ, M)), (V, REST)) ... </k>
/reference/k-proof/reference-semantics/semantics/call.k-65-       <heap> ... H |-> V:Val ... </heap>
/reference/k-proof/reference-semantics/semantics/call.k-66-       requires notBool isMutMethod(M) andBool notBool isRefV(OBJ)
/reference/k-proof/reference-semantics/semantics/call.k-67-       [priority(40)]
/reference/k-proof/reference-semantics/semantics/call.k-68-
/reference/k-proof/reference-semantics/semantics/call.k:69:  rule <k> #applyK(toCall(closureVal(PNS:ParamNames, BODY:Stmts, DEFL:Int)), ACC:Vals) ~> CONT
/reference/k-proof/reference-semantics/semantics/call.k-70-        => #bindP(PNS, ACC) ~> BODY ~> #endcall </k>
/reference/k-proof/reference-semantics/semantics/call.k-71-       <env>     CALLERL:Int => NEWL </env>
/reference/k-proof/reference-semantics/semantics/call.k-72-       <scopes>   STORE:Map => STORE [ NEWL <- scope(.Map, parent(DEFL)) ] </scopes>
