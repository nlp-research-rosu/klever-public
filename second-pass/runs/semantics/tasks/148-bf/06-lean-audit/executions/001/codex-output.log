    88	
    89	  // A finite specification sort lets one symbolic claim quantify over all
    90	  // 8 x 8 valid input pairs without treating arbitrary strings as planets.
    91	  syntax Planet ::= "pMercury" | "pVenus" | "pEarth" | "pMars"
    92	                  | "pJupiter" | "pSaturn" | "pUranus" | "pNeptune"
