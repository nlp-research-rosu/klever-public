+++ b//tmp/uv_exepath_fix.c
@@ -0,0 +1,40 @@
+#define _GNU_SOURCE
+#include <stddef.h>
+#include <dlfcn.h>
+#include <string.h>
+#include <sys/types.h>
+
+int uv_exepath(char *buffer, size_t *size) {
+    static const char executable[] =
+        "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+    const size_t length = sizeof(executable) - 1;
+
+    if (*size <= length) {
+        *size = length + 1;
+        return -105;
+    }
+    memcpy(buffer, executable, length + 1);
+    *size = length;
+    return 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static const char executable[] =
+        "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+    static ssize_t (*real_readlink)(const char *, char *, size_t);
+    const size_t path_length = strlen(path);
+
+    if (strncmp(path, "/proc/", 6) == 0 &&
+        path_length >= 4 &&
+        strcmp(path + path_length - 4, "/exe") == 0) {
+        const size_t length = sizeof(executable) - 1;
+        const size_t copied = length < size ? length : size;
+        memcpy(buffer, executable, copied);
+        return (ssize_t)copied;
+    }
+
+    if (real_readlink == NULL) {
+        real_readlink = dlsym(RTLD_NEXT, "readlink");
+    }
+    return real_readlink(path, buffer, size);
+}
