index 0000000000000000000000000000000000000000..7e16882041ff724fe6292542a09587d8d391e7e0
--- /dev/null
+++ b//tmp/check_uv_exepath.c
@@ -0,0 +1,15 @@
+#include <errno.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+
+extern int uv_exepath(char *buffer, size_t *size);
+
+int main(void) {
+    char buffer[4096];
+    size_t size = sizeof(buffer);
+    int result = uv_exepath(buffer, &size);
+    printf("result=%d size=%zu errno=%d (%s) path=%s\n",
+           result, size, errno, strerror(errno), result == 0 ? buffer : "");
+    return result != 0;
+}
diff --git a//tmp/uv_exepath_fix.c b//tmp/uv_exepath_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..1f505338904eff207e3cde1c1fc4a6b2f6de9015
--- /dev/null
+++ b//tmp/uv_exepath_fix.c
@@ -0,0 +1,40 @@
+#define _GNU_SOURCE
+#include <stddef.h>
+#include <dlfcn.h>
+#include <string.h>
+#include <sys/types.h>
+
+int uv_exepath(char *buffer, size_t *size) {
+    static const char executable[] =
+        "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+    const size_t length = sizeof(executable) - 1;
+
+    if (*size <= length) {
+        *size = length + 1;
+        return -105;
+    }
+    memcpy(buffer, executable, length + 1);
+    *size = length;
+    return 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static const char executable[] =
+        "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+    static ssize_t (*real_readlink)(const char *, char *, size_t);
+    const size_t path_length = strlen(path);
+
+    if (strncmp(path, "/proc/", 6) == 0 &&
+        path_length >= 4 &&
+        strcmp(path + path_length - 4, "/exe") == 0) {
+        const size_t length = sizeof(executable) - 1;
+        const size_t copied = length < size ? length : size;
+        memcpy(buffer, executable, copied);
+        return (ssize_t)copied;
+    }
+
+    if (real_readlink == NULL) {
+        real_readlink = dlsym(RTLD_NEXT, "readlink");
+    }
+    return real_readlink(path, buffer, size);
+}
