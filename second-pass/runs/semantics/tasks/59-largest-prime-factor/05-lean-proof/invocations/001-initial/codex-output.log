codex
`lake build` is currently blocked before elaboration because the mounted Lean executable cannot resolve `IO.appPath`; Lake reports that it cannot detect its own installation. This is an environment-launcher issue, not a project error. I’m testing a process-local executable-path shim in `/tmp` so the pinned Lean/Lake binaries can run unchanged; it will not alter the toolchain, dependency files, Base, or theorem.
apply patch
patch: completed
/tmp/uv_exepath_fix.c
diff --git a//tmp/uv_exepath_fix.c b//tmp/uv_exepath_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..2526ca7f782d554e0f712d11dfd154ef4929a4d6
--- /dev/null
+++ b//tmp/uv_exepath_fix.c
@@ -0,0 +1,16 @@
+#include <stddef.h>
+#include <string.h>
+
+int uv_exepath(char *buffer, size_t *size) {
+    static const char executable[] =
+        "/opt/elan/toolchains/leanprover--lean4---v4.22.0/bin/lean";
+    const size_t length = sizeof(executable) - 1;
+
+    if (*size <= length) {
+        *size = length + 1;
+        return -105;
+    }
+    memcpy(buffer, executable, length + 1);
+    *size = length;
+    return 0;
+}
