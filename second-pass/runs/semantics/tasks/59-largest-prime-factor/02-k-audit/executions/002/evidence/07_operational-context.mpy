Module(
  FuncDef("largest_prime_factor", Params("n"),
    Assign(Name("factor"), Int(2))
    While(Compare(Name("n"), CmpOp(">", Name("factor"))),
      If(Compare(
        BinOp("%", Name("n"), Name("factor")),
        CmpOp("==", Int(0))),
        Assign(Name("n"), BinOp("//", Name("n"), Name("factor"))),
        AugAssign(Name("factor"), "+", Int(1))))
    Return(Name("factor"))
    AugAssign(Name("factor"), "+", Int(100)))
  Assign(Name("observed"), Call(Name("largest_prime_factor"), Int(4)))
  Assert(Compare(Name("observed"), CmpOp("==", Int(2))))
  Assign(Name("observed"), Call(Name("largest_prime_factor"), Int(9)))
  Assert(Compare(Name("observed"), CmpOp("==", Int(3))))
  Assign(Name("observed"), Call(Name("largest_prime_factor"), Int(12)))
  Assert(Compare(Name("observed"), CmpOp("==", Int(3))))
  Assign(Name("observed"), Call(Name("largest_prime_factor"), Int(49)))
  Assert(Compare(Name("observed"), CmpOp("==", Int(7)))))
