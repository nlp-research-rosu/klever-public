diff --git a//tmp/audit-work/59-lpf/spec-vacuity-reviewer.k b//tmp/audit-work/59-lpf/spec-vacuity-reviewer.k
new file mode 100644
index 0000000000000000000000000000000000000000..ea3875768f4d852409fd1038ced18274e5ae522b
--- /dev/null
+++ b//tmp/audit-work/59-lpf/spec-vacuity-reviewer.k
@@ -0,0 +1,32 @@
+requires "verification.k"
+
+module SPEC-VACUITY-REVIEWER
+  imports VERIFICATION
+
+  // Fresh false mutation: the real return summary is deliberately increased
+  // by one. For the satisfying state N=4, F=2, L=1 this demands 2 == 3.
+  claim [lpf-loop-plus-one]:
+    <k>
+      #while(lpfCondition, lpfStep)
+      ~> (Return(Name("factor")) .Stmts)
+      ~> #endcall
+      => (lpfSpec(N, F) +Int 1) ~> CONT
+    </k>
+    <env> L => CALLER </env>
+    <scopes>
+      SC (L |-> scope(("n" |-> N) ("factor" |-> F), parent(0)))
+      => SC
+    </scopes>
+    <scopeLoc> L +Int 1 => L </scopeLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, L)) REST
+      => REST
+    </stack>
+    <ret> noRet </ret>
+    requires N >Int 1
+     andBool F >Int 1
+     andBool L >=Int 1
+     andBool notBool (L in_keys(SC))
+    [circularity]
+
+endmodule
