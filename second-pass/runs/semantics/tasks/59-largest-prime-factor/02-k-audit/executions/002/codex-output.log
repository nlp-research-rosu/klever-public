+#!/usr/bin/env bash
+set -uo pipefail
+
+SCRATCH=/tmp/audit-work/59-lpf
+EVIDENCE=/audit-output/evidence
+
+run_logged() {
+  log=$1
+  shift
+  {
+    echo "\$ $*"
+    "$@"
+    status=$?
+    echo "[exit $status]"
+    exit "$status"
+  } 2>&1 | tee "$EVIDENCE/$log"
+  return "${PIPESTATUS[0]}"
+}
