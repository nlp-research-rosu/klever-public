   221	              #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi)
   222	       #else Float2Int(floorFloat(F +Float 0.5)) #fi [concrete]
   223	  syntax Float ::= roundFN(Float, Int) [function, total, symbol(roundFN), no-evaluators]
   224	  rule roundFN(F:Float, N:Int)
   225	    => Int2Float(roundF(F *Float Int2Float(10 ^Int N, 53, 11)), 53, 11)
   226	       /Float Int2Float(10 ^Int N, 53, 11) [concrete]
   227	  rule applyBuiltin("round", F:Float, .Vals)        => roundF(F)
   228	  rule applyBuiltin("round", F:Float, N:Int, .Vals) => roundFN(F, N)
   229	
   230	  syntax Float ::= sqrtF(Float) [function, total, symbol(sqrtF), no-evaluators]
   231	  rule sqrtF(F:Float) => sqrtFloat(F) [concrete]
   232	  syntax KItem ::= "#mathSqrt"
   233	  rule <k> Call(Attribute(Name("math"), "sqrt"), (E:Expr, .Exprs)) => E ~> #mathSqrt ... </k> [priority(40)]
   234	  rule <k> F:Float ~> #mathSqrt => sqrtF(F) ... </k>
   235	  rule <k> I:Int ~> #mathSqrt => sqrtF(intToF(I)) ... </k>
   236	
   237	  // ---- min / max over a FLOAT list — FLOAT branch of the shared #minCont0/#maxCont0 folds (which
   238	  // seed/step with `requires isInt(V)`, so they are STUCK on floats). These add the `requires
   239	  // isFloat(V)` seed + a Float-accumulator fold via K's minFloat/maxFloat — concrete for krun. A proof
   240	  // over a SYMBOLIC float list intercepts min/max problem-locally to an opaque minVF/maxVF (at
   241	  // #applyK, priority 40, in its verification.k) BEFORE #minAcc0, so this fold is krun-only. Additive:
   242	  // the isFloat guard is disjoint from the existing isInt one.
   243	  syntax KItem ::= #maxAccF(Iterable, Float) | #maxContF(Float)
   244	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   245	  rule <k> #maxAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #maxContF(M) ... </k>
   246	  rule <k> #iterDone ~> #maxContF(M:Float) => M ... </k>
   247	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContF(M:Float) => #maxAccF(R, maxFloat(M, {V}:>Float)) ... </k>
   248	       requires isFloat(V)
   249	
   250	  syntax KItem ::= #minAccF(Iterable, Float) | #minContF(Float)
   251	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   252	  rule <k> #minAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #minContF(M) ... </k>
   253	  rule <k> #iterDone ~> #minContF(M:Float) => M ... </k>
   254	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContF(M:Float) => #minAccF(R, minFloat(M, {V}:>Float)) ... </k>
   255	       requires isFloat(V)
   256	
   257	  // ---- sum over a float list (krun; mirrors the min/max float paths). The Int-only shared
   258	  // #sumCont sticks on a Float yield; switch to a Float-headed fold via addF (concrete twin).
   259	  // The switch guard carries the SYNTACTIC negation of the Int rule's guard so a symbolic proof
   260	  // with isInt(V) in its path condition refutes this branch without sort reasoning.
   261	  syntax KItem ::= #sumAccF(Iterable, Float) | #sumContF(Float)
   262	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
   263	        => #sumAccF(R, addF(intToF(ACC), {V}:>Float)) ... </k>
   264	       requires isFloat(V) andBool notBool (isInt(V) orBool isBool(V))
   265	  rule <k> #sumAccF(IT:Iterable, ACC:Float) => #iterNext(IT) ~> #sumContF(ACC) ... </k>
   266	  rule <k> #iterDone ~> #sumContF(ACC:Float) => ACC ... </k>
   267	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   268	        => #sumAccF(R, addF(ACC, {V}:>Float)) ... </k>
   269	       requires isFloat(V)
   270	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   271	        => #sumAccF(R, addF(ACC, intToF(intOf(V)))) ... </k>
   272	       requires isInt(V) orBool isBool(V)
   273	endmodule
     1	// reference/src/semantics/str.k — MPY-STR
     2	
     3	module MPY-STR
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	
     7	  // ==== iteration (the iterator protocol's str case; yields 1-char strings) ==
     8	  rule <k> #iterNext(str(.IntSeq))                 => #iterDone ... </k>
     9	  rule <k> #iterNext(str(iCons(C:Int, R:IntSeq)))
    10	        => #iterYield(str(iCons(C, .IntSeq)), str(R)) ... </k>
    11	
    12	  // ==== str literal (ASCII-only) ============================================
    13	  syntax IntSeq ::= strToCodes(String) [function]
    14	  rule <k> Str(S:String) => str(strToCodes(S)) ... </k>
    15	  rule strToCodes("") => .IntSeq
    16	  rule strToCodes(S:String) => iCons(ordChar(substrString(S, 0, 1)), strToCodes(substrString(S, 1, lengthString(S))))
    17	    requires S =/=String "" andBool ordChar(substrString(S, 0, 1)) <Int 128
    18	
    19	  // ==== operators: + / == / != / in =========================================
    20	  syntax IntSeq ::= seqConcat(IntSeq, IntSeq) [function, total]
    21	  rule seqConcat(.IntSeq, T:IntSeq)                => T
    22	  rule seqConcat(iCons(I:Int, S:IntSeq), T:IntSeq) => iCons(I, seqConcat(S, T))
    23	
    24	  rule applyBin("+",  str(A:IntSeq), str(B:IntSeq)) => str(seqConcat(A, B))
    25	  rule applyCmp("==", str(A:IntSeq), str(B:IntSeq)) => A ==K B
    26	  rule applyCmp("!=", str(A:IntSeq), str(B:IntSeq)) => notBool (A ==K B)
    27	
    28	  // substring membership: `P in X` iff the code-seq P occurs contiguously in X
    29	  rule applyCmp("in",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)
    30	  rule applyCmp("not in", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)
    31	
    32	  syntax Bool ::= strPrefix(IntSeq, IntSeq) [function, total]
    33	  rule strPrefix(.IntSeq, _:IntSeq)               => true
    34	  rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false
    35	  rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)
    36	
    37	  syntax Bool ::= strContains(IntSeq, IntSeq) [function, total]
    38	  rule strContains(P:IntSeq, X:IntSeq) => true  requires strPrefix(P, X)
    39	  rule strContains(P:IntSeq, .IntSeq)  => false requires notBool strPrefix(P, .IntSeq)
    40	  rule strContains(P:IntSeq, iCons(C:Int, Xs:IntSeq)) => strContains(P, Xs)
    41	       requires notBool strPrefix(P, iCons(C, Xs))
    42	
    43	  // ==== lexicographic order: < / <= / > / >= by code point (= Python str order on the code
    44	  // model). strLt reduces on GROUND code-seqs (krun) but is inert/OPAQUE on symbolic ones
    45	  // (a proof's codesProj(V) is an abstract IntSeq — no constructor rule matches), so a symbolic
    46	  // str `<` stays a trusted opaque term the way sortVS / intFloatDiv do. Additive: fires only on
    47	  // str </<=/>/>= comparisons.
    48	  syntax Bool ::= strLt(IntSeq, IntSeq) [function, total]
    49	  rule strLt(.IntSeq, .IntSeq)                => false
    50	  rule strLt(.IntSeq, iCons(_:Int, _:IntSeq)) => true
    51	  rule strLt(iCons(_:Int, _:IntSeq), .IntSeq) => false
    52	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => true          requires A  <Int B
    53	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B
    54	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B
    55	
    56	  rule applyCmp("<",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
    57	  rule applyCmp(">",  str(A:IntSeq), str(B:IntSeq)) => strLt(B, A)
    58	  rule applyCmp("<=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(B, A)
    59	  rule applyCmp(">=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(A, B)
    60	endmodule
     1	// reference/src/semantics/set.k — MPY-SET
     2	
     3	module MPY-SET
     4	  imports MPY-CORE
     5	
     6	  // a set value, carried as its distinct codes in first-seen order (order is irrelevant
     7	  // to membership/cardinality — the two observations sets support here).
     8	  syntax Val ::= setV(IntSeq)
     9	
    10	  // membership of a code in the accumulated distinct-code sequence
    11	  syntax Bool ::= codeIn(Int, IntSeq) [function, total]
    12	  rule codeIn(_:Int, .IntSeq)                => false
    13	  rule codeIn(C:Int, iCons(H:Int, T:IntSeq)) => C ==Int H orBool codeIn(C, T)
    14	
    15	  // the distinct codes of CS (insert-if-absent fold, first-seen order)
    16	  syntax IntSeq ::= dedupCodes(IntSeq)         [function, total]
    17	                  | dedupFrom(IntSeq, IntSeq)  [function, total]
    18	  rule dedupCodes(CS:IntSeq) => dedupFrom(CS, .IntSeq)
    19	  rule dedupFrom(.IntSeq, ACC:IntSeq) => ACC
    20	  rule dedupFrom(iCons(C:Int, S:IntSeq), ACC:IntSeq) => dedupFrom(S, ACC)
    21	       requires codeIn(C, ACC)
    22	  rule dedupFrom(iCons(C:Int, S:IntSeq), ACC:IntSeq) => dedupFrom(S, snocCode(ACC, C))
    23	       requires notBool codeIn(C, ACC)
    24	
    25	  syntax IntSeq ::= snocCode(IntSeq, Int) [function, total]
    26	  rule snocCode(.IntSeq, C:Int)                => iCons(C, .IntSeq)
    27	  rule snocCode(iCons(H:Int, T:IntSeq), C:Int) => iCons(H, snocCode(T, C))
    28	
    29	  // ==== set equality: two sets are equal iff mutually subsuming ==============
    30	  // subsetCodes(A, B) — every code of A occurs in B (duplicates in A are harmless).
    31	  syntax Bool ::= subsetCodes(IntSeq, IntSeq) [function, total]
    32	  rule subsetCodes(.IntSeq, _:IntSeq)                => true
    33	  rule subsetCodes(iCons(C:Int, S:IntSeq), B:IntSeq) => codeIn(C, B) andBool subsetCodes(S, B)
    34	
    35	  syntax Bool ::= sameSet(IntSeq, IntSeq) [function, total]
    36	  rule sameSet(A:IntSeq, B:IntSeq) => subsetCodes(A, B) andBool subsetCodes(B, A)
    37	
    38	  // set == set  (the only comparison sets support here)
    39	  rule applyCmp("==", setV(A:IntSeq), setV(B:IntSeq)) => sameSet(A, B)
    40	endmodule
     1	// reference/src/semantics/dict.k — MPY-DICT
     2	//
     3	// Minimal dict support. A dict value is `dictV(KS, VS)`: PARALLEL insertion-ordered key/value
     4	// ValSeqs (Python dict order; keys distinct; re-inserting a key updates its value in place, keeping
     5	// the original position). Concrete for krun (the ordered build + `.keys()` are the real ops); a proof
     6	// over a SYMBOLIC dict passes `dictV(KS, WS)` with a symbolic key sequence KS and reads
     7	// `d.keys() = list(KS)`, then keeps each key opaque problem-locally.
     8	//
     9	// Only the pieces needed so far: a dict VALUE (so `{}` inside a mixed list evaluates and
    10	// `isinstance(x, int)` rejects it), the `{k: v, ...}` literal, and `.keys()`. More dict ops (subscript
    11	// / `.get()` / `.values()` / dict `==`) are added as dict problems need them — kept minimal + additive.
    12	
    13	module MPY-DICT
    14	  imports MPY-CORE
    15	  imports MPY-ITER
    16	  imports MPY-METHODS
    17	  imports MPY-LIST
    18	
    19	  // dict as PARALLEL ordered key/value ValSeqs (same length; keys distinct).
    20	  syntax Val ::= dictV(ValSeq, ValSeq)
    21	
    22	  // ==== DictExpr: {k: v, ...} literal. Eval each key then value, left to right, insert-with-dedup.
    23	  syntax KItem ::= #dictAcc(Entries, ValSeq, ValSeq)
    24	                 | #dictKey(Expr, Entries, ValSeq, ValSeq)
    25	                 | #dictVal(Val, Entries, ValSeq, ValSeq)
    26	  rule <k> DictExpr(ES:Entries) => #dictAcc(ES, .ValSeq, .ValSeq) ... </k>
    27	  rule <k> #dictAcc(.Entries, KS:ValSeq, VS:ValSeq) => dictV(KS, VS) ... </k>
    28	  rule <k> #dictAcc((Entry(K:Expr, V:Expr), REST:Entries), KS:ValSeq, VS:ValSeq)
    29	        => K ~> #dictKey(V, REST, KS, VS) ... </k>
    30	  rule <k> KV:Val ~> #dictKey(V:Expr, REST:Entries, KS:ValSeq, VS:ValSeq)
    31	        => V ~> #dictVal(KV, REST, KS, VS) ... </k>
    32	  rule <k> VV:Val ~> #dictVal(KV:Val, REST:Entries, KS:ValSeq, VS:ValSeq)
    33	        => #dictAcc(REST, dPutK(KS, KV), dPutV(KS, VS, KV, VV)) ... </k>
    34	
    35	  // insert-with-dedup helpers (concrete Val key equality via ==K). [total] so buildFold over a dict is
    36	  // total (its #Ceil is #Top) — needed when a symbolic proof carries a built dict as a config value.
    37	  syntax Bool ::= dHasKey(ValSeq, Val) [function, total]
    38	  rule dHasKey(.ValSeq, _:Val)                => false
    39	  rule dHasKey(vCons(A:Val, _:ValSeq), K:Val) => true          requires A ==K K
    40	  rule dHasKey(vCons(A:Val, R:ValSeq), K:Val) => dHasKey(R, K) requires notBool (A ==K K)
    41	
    42	  // dPutK: KS unchanged if K already present, else append K (keep-first-position).
    43	  syntax ValSeq ::= dPutK(ValSeq, Val) [function, total]
    44	  rule dPutK(KS:ValSeq, K:Val) => KS                                  requires dHasKey(KS, K)
    45	  rule dPutK(KS:ValSeq, K:Val) => valSeqConcat(KS, vCons(K, .ValSeq)) requires notBool dHasKey(KS, K)
    46	
    47	  // dPutV: parallel to KS — set the value at K's position if present, else append V at the end. The
    48	  // [owise] catch-all covers the degenerate mismatched-length case (never reached for a well-formed dict).
    49	  syntax ValSeq ::= dPutV(ValSeq, ValSeq, Val, Val) [function, total]
    50	  rule dPutV(vCons(A:Val, _:ValSeq), vCons(_:Val, VR:ValSeq), K:Val, V:Val)  => vCons(V, VR)
    51	       requires A ==K K
    52	  rule dPutV(vCons(A:Val, KR:ValSeq), vCons(B:Val, VR:ValSeq), K:Val, V:Val) => vCons(B, dPutV(KR, VR, K, V))
    53	       requires notBool (A ==K K)
    54	  rule dPutV(_KS:ValSeq, VS:ValSeq, _K:Val, V:Val) => valSeqConcat(VS, vCons(V, .ValSeq)) [owise]
    55	
    56	  // ==== dict methods ========================================================
    57	  // d.keys() -> a FRESH list object of the ordered keys (k-cell: it allocates).
    58	  rule <k> #applyK(toCall(boundMethodV(dictV(KS:ValSeq, _:ValSeq), "keys")), .Vals)
    59	        => #alloc(list(KS)) ... </k>
    60	       [priority(40)]
    61	
    62	  // ==== dict subscript READ: d[k] (assoc lookup; KeyError is out of subset) ==
    63	  rule applyIndexD(dictV(KS:ValSeq, VS:ValSeq), K:Val) => dGet(KS, VS, K)
    64	  syntax Val ::= applyIndexD(Val, Val) [function]
    65	  rule <k> Subscript(dictV(KS:ValSeq, VS:ValSeq), K:Val) => applyIndexD(dictV(KS, VS), K) ... </k>
    66	       [priority(45)]
    67	
    68	  // ==== dict subscript-assign: d[k] = v (insert/update in place) =============
    69	  // Only for a LOCAL dict variable X (the current scope holds it). Reuses dPutK/dPutV.
    70	  syntax Val ::= dictSet(Val, Val, Val) [function]
    71	  rule dictSet(dictV(KS:ValSeq, VS:ValSeq), K:Val, V:Val) => dictV(dPutK(KS, K), dPutV(KS, VS, K, V))
    72	
    73	  // RHS evaluates first (Assign strictness), then the key. Dispatch on the scope
    74	  // value: a bare dict updates in the scope (dicts stay values); a ref (a heap
    75	  // list — or a heap dict later) writes the heap in place.
    76	  syntax KItem ::= #dsetK(String, Val)
    77	  rule <k> Assign(Subscript(Name(X:String), K:Expr), VV:Val) => K ~> #dsetK(X, VV) ... </k>
    78	  rule <k> KV:Val ~> #dsetK(X:String, VV:Val) => .K ... </k>
    79	       <env> L:Int </env>
    80	       <scopes> ... L |-> scope(M:Map => M [ X <- dictSet({M[X]}:>Val, KV, VV) ], _) ... </scopes>
    81	       requires X in_keys(M) andBool notBool isRefV({M[X]}:>Val)
    82	  rule <k> KV:Val ~> #dsetK(X:String, VV:Val) => #dsetV({M[X]}:>Val, KV, VV) ... </k>
    83	       <env> L:Int </env>
    84	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    85	       requires X in_keys(M) andBool isRefV({M[X]}:>Val)
    86	  syntax KItem ::= #dsetV(Val, Val, Val)
    87	  rule <k> #dsetV(ref(H:Int), I:Int, VV:Val) => .K ... </k>
    88	       <heap> ... H |-> list(VS:ValSeq => setVSAt(VS, normIdxD(I, vsLen(VS)), VV)) ... </heap>
    89	  // negative-index normalization local to the write (subscript.k's is not imported here)
    90	  syntax Int ::= normIdxD(Int, Int) [function, total]
    91	  rule normIdxD(I:Int, LEN:Int) => I +Int LEN requires I  <Int 0
    92	  rule normIdxD(I:Int, _:Int)   => I          requires I >=Int 0
    93	
    94	  // ==== dict == (order-insensitive: same size + same key->value pairs) =======
    95	  rule applyCmp("==", dictV(KS1:ValSeq, VS1:ValSeq), dictV(KS2:ValSeq, VS2:ValSeq))
    96	    => (vsLen(KS1) ==Int vsLen(KS2)) andBool dSubset(KS1, VS1, KS2, VS2)
    97	  syntax Bool ::= dSubset(ValSeq, ValSeq, ValSeq, ValSeq) [function]
    98	  rule dSubset(.ValSeq, .ValSeq, _:ValSeq, _:ValSeq) => true
    99	  rule dSubset(vCons(K:Val, KR:ValSeq), vCons(V:Val, VR:ValSeq), KS2:ValSeq, VS2:ValSeq)
   100	    => dHasKey(KS2, K) andBool (dGet(KS2, VS2, K) ==K V) andBool dSubset(KR, VR, KS2, VS2)
   101	  syntax Val ::= dGet(ValSeq, ValSeq, Val) [function]
   102	  rule dGet(vCons(A:Val, _:ValSeq), vCons(B:Val, _:ValSeq), K:Val) => B                requires A ==K K
   103	  rule dGet(vCons(A:Val, KR:ValSeq), vCons(_:Val, VR:ValSeq), K:Val) => dGet(KR, VR, K) requires notBool (A ==K K)
   104	endmodule

diff --git a/evidence/01_integrity.sh b/evidence/01_integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..b571924322a7317d113cfed2e1396236f05c736c
--- /dev/null
+++ b/evidence/01_integrity.sh
@@ -0,0 +1,130 @@
+#!/usr/bin/env bash
+set -u
+
+run() {
+  echo "\$ $*"
+  "$@"
+  status=$?
+  echo "[exit $status]"
+  return "$status"
+}
+
+echo "== Required mounts and records =="
+run stat -c '%F %a %U:%G %n' \
+  /audit-input.json \
+  /audit-campaign-lock.json \
+  /run.json \
+  /task.json \
+  /generation-result.json \
+  /reference/canonical.py \
+  /reference/prompt.py \
+  /reference/py2mpy.py \
+  /reference/reference-semantics \
+  /candidate \
+  /generation-evidence/invocation.json \
+  /generation-evidence/metrics.json \
+  /generation-evidence/usage.json \
+  /generation-evidence/codex-last.txt \
+  /generation-evidence/codex-output.log \
+  /generation-evidence/prompt.txt \
+  /generation-evidence/codex-trace
+
+echo "== Independent file hashes =="
+run sha256sum \
+  /audit-input.json \
+  /audit-campaign-lock.json \
+  /run.json \
+  /task.json \
+  /generation-result.json \
+  /reference/canonical.py \
+  /reference/prompt.py \
+  /reference/py2mpy.py \
+  /candidate/prompt.py \
+  /candidate/py2mpy.py \
+  /generation-evidence/invocation.json \
+  /generation-evidence/metrics.json \
+  /generation-evidence/usage.json \
+  /generation-evidence/codex-last.txt \
+  /generation-evidence/codex-output.log \
+  /generation-evidence/prompt.txt \
+  /generation-evidence/codex-trace/2026/07/23/rollout-2026-07-23T00-38-25-019f8d7b-710f-7f03-8454-aa05bfcdc438.jsonl
+
+echo "== Campaign lock and recorded hashes =="
+run python3 - <<'PY'
+import hashlib
+import json
+from pathlib import Path
+
+audit = json.loads(Path("/audit-input.json").read_text())
+lock_raw = Path("/audit-campaign-lock.json").read_bytes()
+lock = json.loads(lock_raw)
+actual_lock_hash = hashlib.sha256(lock_raw).hexdigest()
+print("record_layout:", audit["record_layout"])
+print("semantics_mode:", audit["semantics_mode"])
+print("campaign_block_equals_lock:", audit["audit_campaign"] == lock)
+print("recorded_lock_hash:", audit["hashes"]["audit_campaign_lock_sha256"])
+print("actual_lock_hash:", actual_lock_hash)
+print("lock_hash_matches:", actual_lock_hash == audit["hashes"]["audit_campaign_lock_sha256"])
+
+paths = {
+    "run_manifest_sha256": "/run.json",
+    "task_manifest_sha256": "/task.json",
+    "stage1_result_sha256": "/generation-result.json",
+    "stage1_invocation_sha256": "/generation-evidence/invocation.json",
+    "generation_metrics_sha256": "/generation-evidence/metrics.json",
+    "generation_usage_sha256": "/generation-evidence/usage.json",
+    "generation_codex_last_sha256": "/generation-evidence/codex-last.txt",
+    "generation_codex_output_sha256": "/generation-evidence/codex-output.log",
+    "generation_prompt_sha256": "/generation-evidence/prompt.txt",
+    "canonical_sha256": "/reference/canonical.py",
+    "trusted_prompt_sha256": "/reference/prompt.py",
+    "trusted_translator_sha256": "/reference/py2mpy.py",
+}
+for key, path in paths.items():
+    actual = hashlib.sha256(Path(path).read_bytes()).hexdigest()
+    expected = audit["hashes"][key]
+    print(f"{key}: match={actual == expected} expected={expected} actual={actual} path={path}")
+PY
+
+echo "== Candidate/trusted file identity =="
+run cmp /candidate/prompt.py /reference/prompt.py
+run cmp /candidate/py2mpy.py /reference/py2mpy.py
+run diff -qr --no-dereference /candidate/reference-semantics /reference/reference-semantics
+
+echo "== Type and symlink checks =="
+run find /candidate/reference-semantics -printf '%y %P -> %l\n'
+run find /reference/reference-semantics -printf '%y %P -> %l\n'
+run find /candidate -maxdepth 2 -type l -print
+
+echo "== Reviewer-defined normalized semantics hashes =="
+run bash -c 'cd /candidate/reference-semantics && find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum'
+run bash -c 'cd /reference/reference-semantics && find . -type f -print0 | sort -z | xargs -0 sha256sum | sha256sum'
+
+echo "== Structured trace integrity and inventory =="
+run python3 - <<'PY'
+import collections
+import hashlib
+import json
+from pathlib import Path
+
+p = Path("/generation-evidence/codex-trace/2026/07/23/rollout-2026-07-23T00-38-25-019f8d7b-710f-7f03-8454-aa05bfcdc438.jsonl")
+top = collections.Counter()
+payload = collections.Counter()
+bad = []
+last_line = 0
+for last_line, line in enumerate(p.open(), 1):
+    try:
+        event = json.loads(line)
+    except Exception as err:
+        bad.append((last_line, str(err)))
+        continue
+    top[event.get("type")] += 1
+    body = event.get("payload")
+    if isinstance(body, dict):
+        payload[(event.get("type"), body.get("type"))] += 1
+print("lines:", last_line)
+print("invalid_json_lines:", bad)
+print("top_level_types:", sorted(top.items(), key=lambda item: str(item[0])))
+print("payload_types:", sorted(payload.items(), key=lambda item: str(item[0])))
+print("file_sha256:", hashlib.sha256(p.read_bytes()).hexdigest())
+PY
diff --git a/evidence/02_generation_trace_summary.py b/evidence/02_generation_trace_summary.py
new file mode 100644
index 0000000000000000000000000000000000000000..57faf142f2310abe328298c51011f12cbd620d5f
--- /dev/null
+++ b/evidence/02_generation_trace_summary.py
@@ -0,0 +1,58 @@
+#!/usr/bin/env python3
+"""Bounded, reviewer-authored extraction of every structured generation event."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+
+TRACE = Path(
+    "/generation-evidence/codex-trace/2026/07/23/"
+    "rollout-2026-07-23T00-38-25-019f8d7b-710f-7f03-8454-aa05bfcdc438.jsonl"
+)
+
+
+def bounded(value: object, limit: int = 1800) -> str:
+    if isinstance(value, str):
+        text = value
+    else:
+        text = json.dumps(value, sort_keys=True)
+    text = text.replace("\x1b", "<ESC>")
+    if len(text) <= limit:
+        return text
+    half = limit // 2
+    return text[:half] + f"\n... <{len(text) - limit} chars omitted> ...\n" + text[-half:]
+
+
+for line_number, line in enumerate(TRACE.open(), 1):
+    event = json.loads(line)
+    kind = event.get("type")
+    body = event.get("payload")
+    if not isinstance(body, dict):
+        continue
+    subtype = body.get("type")
+    if kind == "response_item" and subtype in {
+        "function_call",
+        "function_call_output",
+        "custom_tool_call",
+        "custom_tool_call_output",
+    }:
+        if subtype in {"function_call", "custom_tool_call"}:
+            name = body.get("name", subtype)
+            arguments = body.get("arguments", body.get("input", ""))
+            print(f"\nTRACE LINE {line_number}: {subtype} {name}\n{bounded(arguments)}")
+        else:
+            output = body.get("output", body.get("content", ""))
+            print(f"\nTRACE LINE {line_number}: {subtype}\n{bounded(output)}")
+    elif kind == "event_msg" and subtype in {
+        "agent_message",
+        "task_complete",
+        "user_message",
+        "web_search_end",
+    }:
+        message = body.get(
+            "message",
+            body.get("last_agent_message", body),
+        )
+        print(f"\nTRACE LINE {line_number}: event {subtype}\n{bounded(message)}")
diff --git a/evidence/03_differential.py b/evidence/03_differential.py
new file mode 100644
index 0000000000000000000000000000000000000000..936f9d10cd5493d3d8fefe9a0ceef1f0e456c7b8
--- /dev/null
+++ b/evidence/03_differential.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+"""Independent differential test for HumanEval/59.
+
+The intended input domain is integer n > 1 with n composite. There is no
+collection-valued "empty" input. The smallest domain boundary is n = 4.
+"""
+
+from __future__ import annotations
+
+import importlib.util
+import random
+from pathlib import Path
+
+
+def load_entry(path: str, module_name: str):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.largest_prime_factor
+
+
+canonical = load_entry("/reference/canonical.py", "trusted_canonical")
+candidate = load_entry("/tmp/audit-work/59-lpf/solution.py", "candidate_solution")
+
+
+def prime(n: int) -> bool:
+    if n < 2:
+        return False
+    d = 2
+    while d * d <= n:
+        if n % d == 0:
+            return False
+        d += 1
+    return True
+
+
+def independent_oracle(n: int) -> int:
+    """Largest factor via descending search, independent of both algorithms."""
+    for d in range(n // 2, 1, -1):
+        if n % d == 0 and prime(d):
+            return d
+    return n
+
+
+documented = [13195, 2048]
+boundaries = [
+    4,   # smallest allowed composite; divisible branch at factor 2
+    6,   # divisible branch, then non-divisible increment branch
+    8,   # repeated division by the same factor
+    9,   # initial non-divisible branch, then division by factor 3
+    10,  # even semiprime
+    12,  # repeated and distinct factors
+    15,  # odd semiprime
+    25,  # odd prime square
+    27,  # repeated odd factor
+    49,  # square of a larger prime
+]
+exhaustive = [n for n in range(4, 5001) if not prime(n)]
+
+rng = random.Random(590059)
+primes = [n for n in range(2, 150) if prime(n)]
+generated = [rng.choice(primes) * rng.choice(primes) for _ in range(250)]
+
+inputs = sorted(set(documented + boundaries + exhaustive + generated))
+mismatches = []
+for n in inputs:
+    assert n > 1 and not prime(n), f"generated off-domain input: {n}"
+    expected = independent_oracle(n)
+    canonical_result = canonical(n)
+    candidate_result = candidate(n)
+    if canonical_result != expected or candidate_result != expected:
+        mismatches.append((n, expected, canonical_result, candidate_result))
+
+print("domain: integers n > 1 that are not prime")
+print("empty case: not applicable to this integer contract")
+print("documented_examples:", documented)
+print("branch_boundaries:", boundaries)
+print("exhaustive_composites_4_through_5000:", len(exhaustive))
+print("seeded_generated_products:", len(generated), "seed=590059")
+print("unique_inputs:", len(inputs))
+print("mismatches:", len(mismatches))
+for mismatch in mismatches[:20]:
+    print("MISMATCH", mismatch)
+raise SystemExit(1 if mismatches else 0)
