+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        ("n" |-> N:Int) ("factor" |-> F:Int) REST:Map
+        => ("n" |-> ((N -Int pyMod(N, F)) /Int F))
+           ("factor" |-> F) REST,
+        P:Parent)
+      ...
+    </scopes>
+    requires F >Int 1
+     andBool notBool ("$cells" in_keys(REST))
+
+  claim [augassign-one]:
+    <k>
