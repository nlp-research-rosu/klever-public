+      ... L |-> scope(
+        ("n" |-> N:Int) ("factor" |-> F:Int) REST:Map
+        => ("n" |-> ((N -Int pyMod(N, F)) /Int F))
+           ("factor" |-> F) REST,
+        P:Parent)
+      ...
+    </scopes>
+    requires F >Int 1
+
+  claim [augassign-one]:
+    <k>
+      AugAssign(Name("factor"), "+", Int(1))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        ("n" |-> N:Int) ("factor" |-> F:Int) REST:Map
+        => ("n" |-> N) ("factor" |-> (F +Int 1)) REST,
+        P:Parent)
+      ...
+    </scopes>
+
+  claim [return-factor]:
+    <k> Return(Name("factor")) ~> RESTK:K => #pop </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        ("factor" |-> F:Int) REST:Map,
+        P:Parent)
+      ...
+    </scopes>
+    <ret> noRet => retV(F) </ret>
+
+endmodule
