+      --spec-module BRIDGE-CONNECTIONS-REACHABLE \
+      --claims "BRIDGE-CONNECTIONS-REACHABLE.$label" \
+    > "$log" 2>&1
+  status=$?
+  top_count=$(rg -c '^#Top$' "$log" || true)
