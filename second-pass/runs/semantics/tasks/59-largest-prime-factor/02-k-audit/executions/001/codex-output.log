diff --git a/evidence/stage6_nonvacuity.sh b/evidence/stage6_nonvacuity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..9d536ec75d975e7a89156de318546dd7b7db6b00
--- /dev/null
+++ b/evidence/stage6_nonvacuity.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+set -u
+
+cd /tmp/audit-work/review-59/candidate-src || exit 90
+raw=/tmp/audit-work/review-59/stage6-proof.raw.log
+
+echo '$ cmp -s scratch/spec-vacuity.k /audit-output/evidence/spec-vacuity.k'
+cmp -s spec-vacuity.k /audit-output/evidence/spec-vacuity.k
+copy_status=$?
+echo "exit=$copy_status"
+
+echo '$ kprove spec-vacuity.k --definition verification-kompiled --spec-module SPEC-VACUITY --dry-run'
+kprove spec-vacuity.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY \
+  --dry-run
+dry_status=$?
+echo "exit=$dry_status"
+
+echo '$ kprove spec-vacuity.k --definition verification-kompiled --spec-module SPEC-VACUITY'
+kprove spec-vacuity.k \
+  --definition verification-kompiled \
+  --spec-module SPEC-VACUITY > "$raw" 2>&1
+proof_status=$?
+sed -n '1,260p' "$raw"
+echo "exit=$proof_status"
+
+grep -q 'WarnStuckClaimState' "$raw"
+stuck_status=$?
+echo "stuck_marker_status=$stuck_status"
+grep -Fq 'F +Int 1' "$raw"
+obligation_status=$?
+echo "result_obligation_marker_status=$obligation_status"
+
+if [ "$copy_status" -ne 0 ] || [ "$dry_status" -ne 0 ]; then
+  exit 1
+fi
+if [ "$proof_status" -eq 0 ] || [ "$stuck_status" -ne 0 ] || [ "$obligation_status" -ne 0 ]; then
+  exit 2
+fi
+exit 0

diff --git a//tmp/audit-work/review-59/candidate-src/ground-instances.k b//tmp/audit-work/review-59/candidate-src/ground-instances.k
new file mode 100644
index 0000000000000000000000000000000000000000..c66074a6b104764e8f80091f12d7c8fdb9ec4559
--- /dev/null
+++ b//tmp/audit-work/review-59/candidate-src/ground-instances.k
@@ -0,0 +1,15 @@
+requires "verification.k"
+
+module GROUND-INSTANCES
+  imports VERIFICATION
+
+  // Ground substitutions for satisfiable loop-claim preconditions.
+  claim [ground-12]:
+    <k> lpfSpec(12, 2) => 3 </k>
+
+  claim [ground-2048]:
+    <k> lpfSpec(2048, 2) => 2 </k>
+
+  claim [ground-13195]:
+    <k> lpfSpec(13195, 2) => 29 </k>
