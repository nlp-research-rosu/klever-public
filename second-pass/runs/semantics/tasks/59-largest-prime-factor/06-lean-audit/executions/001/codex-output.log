+        (Proof.«_|->_» key0 key0)
+        (Proof.«_|->_» key1 key1)
+      ≠
+    Proof._Map_
+        (Proof.«_|->_» key1 key1)
+        (Proof.«_|->_» key0 key0) := by
+  simp [Proof._Map_, Proof.«_|->_», key0, key1]
+
+end BridgeAudit
