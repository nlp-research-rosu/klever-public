The trusted Stage 4 preflight now passes on a fresh generated copy: one obligation, exact one-to-one source mapping, exact fixed target, zero sorries, and 51 allowlisted generated trust declarations. All mounted tree/file hashes and producer image bindings also match the launcher. I’m moving to the separately reconstructed Stage 5 workspace and clean proof build.
exec
/bin/bash -lc 'set -euo pipefail
audit_project=/tmp/audit-work/stage5-fresh-001
test ! -e "$audit_project"
mkdir -p "$audit_project"
cp -a /candidate/. "$audit_project/"
cp -a /reference/klean-generation/generated/. "$audit_project/Base/"
printf '"'fresh_project=%s\\n' \""'$audit_project" | tee /audit-output/evidence/stage5-fresh-path.txt
find "$audit_project" -path "$audit_project/.lake" -prune -o -path "$audit_project/Base/.lake" -prune -o -printf '"'%y %P\\n' | sort | tee /audit-output/evidence/stage5-fresh-tree.txt
set +e
(
  cd \""'$audit_project"
  LD_PRELOAD=/tmp/audit-work/proc-self-exe-shim.so lake clean
) 2>&1 | tee /audit-output/evidence/stage5-lake-clean.log
clean_status=${PIPESTATUS[0]}
printf '"'lake clean exit_code=%s\\n' \""'$clean_status" | tee /audit-output/evidence/stage5-lake-clean.status
(
  cd "$audit_project"
  LD_PRELOAD=/tmp/audit-work/proc-self-exe-shim.so lake build
) 2>&1 | tee /audit-output/evidence/stage5-lake-build.log
build_status=${PIPESTATUS[0]}
printf '"'lake build exit_code=%s\\n' \""'$build_status" | tee /audit-output/evidence/stage5-lake-build.status
exit "$build_status"' in /audit-output
