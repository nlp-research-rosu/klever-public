--- frozen solution.py ---
     1	def largest_prime_factor(n: int):
     2	    factor = 2
     3	    while n > factor:
     4	        if n % factor == 0:
     5	            n = n // factor
     6	        else:
     7	            factor += 1
     8	    return factor
