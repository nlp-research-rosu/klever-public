+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant/circularity: from any positive trial state, the operational
+  // while loop returns exactly the value of the mathematical recurrence.
+  claim [lpf-loop]:
+    <k>
+      #while(lpfCondition, lpfStep)
+      ~> Return(Name("factor"))
+      ~> #endcall
+      => lpfSpec(N, F) ~> CONT
+    </k>
+    <env> L => CALLER </env>
+    <scopes>
+      SC (L |-> scope(("n" |-> N) ("factor" |-> F), parent(0)))
+      => SC
+    </scopes>
+    <scopeLoc> L +Int 1 => L </scopeLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, L)) REST
+      => REST
+    </stack>
+    <ret> noRet </ret>
+    requires N >Int 1
+     andBool F >Int 1
+     andBool L >=Int 1
+     andBool notBool (L in_keys(SC))
+    [circularity]
+
+  // End-to-end symbolic execution from module loading through the function
+  // call. This is the positive target proof for all inputs in the contract.
+  claim [largest-prime-factor]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("largest_prime_factor"), Int(N))
+      => lpfSpec(N, 2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+        "largest_prime_factor" |->
+          closureVal(
+            ("n", .ParamNames),
+            Assign(Name("factor"), Int(2))
+            While(lpfCondition, lpfStep)
+            Return(Name("factor")),
+            0),
+        parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 1
+    [depends(lpf-loop)]
+
+  // The prompt examples are also closed as direct semantic claims, guarding
+  // the recurrence and end-to-end invariant against accidental weakening.
+  claim [example-13195]:
+    lpfSpec(13195, 2) => 29
+
+  claim [example-2048]:
+    lpfSpec(2048, 2) => 2
+endmodule
