diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..830580db65a77296fa79cd77c777186b67af0dd2
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,66 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant/circularity: from any positive trial state, the operational
+  // while loop returns exactly the value of the mathematical recurrence.
+  claim [lpf-loop]:
+    <k>
+      #while(lpfCondition, lpfStep)
+      ~> Return(Name("factor"))
+      ~> #endcall
+      => lpfSpec(N, F) ~> CONT
+    </k>
+    <env> L => CALLER </env>
+    <scopes>
+      SC (L |-> scope(("n" |-> N) ("factor" |-> F), parent(0)))
+      => SC
+    </scopes>
+    <scopeLoc> L +Int 1 => L </scopeLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, L)) REST
+      => REST
+    </stack>
+    <ret> noRet </ret>
+    requires N >Int 1
+     andBool F >Int 1
+     andBool L >=Int 1
+     andBool notBool (L in_keys(SC))
+    [circularity]
+
+  // End-to-end symbolic execution from module loading through the function
+  // call. This is the positive target proof for all inputs in the contract.
+  claim [largest-prime-factor]:
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("largest_prime_factor"), Int(N))
+      => lpfSpec(N, 2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+        "largest_prime_factor" |->
+          closureVal(
+            ("n", .ParamNames),
+            Assign(Name("factor"), Int(2))
+            While(lpfCondition, lpfStep)
+            Return(Name("factor")),
+            0),
+        parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 1
+    [depends(lpf-loop)]
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d9e463f60b83a07f014547a2b8bac761ea00af1c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,129 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Deallocating a fresh call frame restores the surrounding scope map. This
+  // is the symbolic form of the concrete Map update simplification used by
+  // MPY-FUNCTIONS.#pop.
+  rule ((L:Int |-> V:Scope) M:Map) [ L <- undef ] => M
+    requires notBool (L in_keys(M))
+    [simplification]
+
+  // The exact constructor term generated from solution.py, named so that the
+  // proof claim can start from the same module that krun parses.
+  syntax Module ::= "solutionModule" [macro]
+  rule solutionModule
+    => Module(
+         FuncDef("largest_prime_factor", Params("n"),
+           Assign(Name("factor"), Int(2))
+           While(Compare(Name("n"), CmpOp(">", Name("factor"))),
+             If(Compare(
+               BinOp("%", Name("n"), Name("factor")),
+               CmpOp("==", Int(0))),
+               Assign(Name("n"),
+                 BinOp("//", Name("n"), Name("factor"))),
+               AugAssign(Name("factor"), "+", Int(1))))
+           Return(Name("factor"))))
+
+  // Names for the loop fragments used by the circular loop claim.
+  syntax Expr ::= "lpfCondition" [macro]
+  rule lpfCondition
+    => Compare(Name("n"), CmpOp(">", Name("factor")))
+
+  syntax Stmts ::= "lpfStep" [macro]
+  rule lpfStep
+    => If(Compare(
+         BinOp("%", Name("n"), Name("factor")),
+         CmpOp("==", Int(0))),
+         Assign(Name("n"), BinOp("//", Name("n"), Name("factor"))),
+         AugAssign(Name("factor"), "+", Int(1)))
+
+  // Independent mathematical recurrence for trial division. The loop proof
+  // establishes that the Python execution refines this specification.
+  syntax Int ::= lpfSpec(Int, Int) [function, total]
+  rule lpfSpec(N:Int, F:Int) => F
+    requires N <=Int F
+  rule lpfSpec(N:Int, F:Int)
+    => lpfSpec((N -Int pyMod(N, F)) /Int F, F)
+    requires N >Int F andBool pyMod(N, F) ==Int 0
+  rule lpfSpec(N:Int, F:Int) => lpfSpec(N, F +Int 1)
+    requires N >Int F andBool pyMod(N, F) =/=Int 0
+
+  // Symbolic accelerator rules derived directly from the MPY rules. The
+  // Haskell backend cannot cool a symbolic Int through generated strictness
+  // freezers in this semantics, so these rules collapse only the exact
+  // integer redexes used by this program. They preserve the reference
+  // semantics' lookup, pyMod, floor-division, assignment, and return effects.
+  rule <k>
+         Compare(Name("n"), CmpOp(">", Name("factor")))
+         => N >Int F
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("n" |-> N:Int) ("factor" |-> F:Int) REST:Map,
+           P:Parent)
+         ...
+       </scopes>
+       [priority(40)]
+
+  rule <k>
+         Compare(
+           BinOp("%", Name("n"), Name("factor")),
+           CmpOp("==", Int(0)))
+         => pyMod(N, F) ==Int 0
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("n" |-> N:Int) ("factor" |-> F:Int) REST:Map,
+           P:Parent)
+         ...
+       </scopes>
+       [priority(40)]
+
+  rule <k>
+         Assign(Name("n"), BinOp("//", Name("n"), Name("factor")))
+         => .K
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("n" |-> N:Int) ("factor" |-> F:Int) REST:Map
+           => ("n" |-> ((N -Int pyMod(N, F)) /Int F))
+              ("factor" |-> F) REST,
+           P:Parent)
+         ...
+       </scopes>
+       [priority(40)]
+
+  rule <k>
+         AugAssign(Name("factor"), "+", Int(1))
+         => .K
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("n" |-> N:Int) ("factor" |-> F:Int) REST:Map
+           => ("n" |-> N) ("factor" |-> (F +Int 1)) REST,
+           P:Parent)
+         ...
+       </scopes>
+       [priority(40)]
+
+  rule <k> Return(Name("factor")) ~> _ => #pop </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("factor" |-> F:Int) REST:Map,
+           P:Parent)
+         ...
+       </scopes>
+       <ret> noRet => retV(F) </ret>
+       [priority(40)]
+endmodule

