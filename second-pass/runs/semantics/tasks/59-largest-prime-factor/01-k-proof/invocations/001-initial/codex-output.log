+         => pyMod(N, F) ==Int 0
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("n" |-> N:Int) ("factor" |-> F:Int) REST:Map,
+           P:Parent)
+         ...
+       </scopes>
+       [priority(40)]
+
+  rule <k>
+         Assign(Name("n"), BinOp("//", Name("n"), Name("factor")))
+         => .K
