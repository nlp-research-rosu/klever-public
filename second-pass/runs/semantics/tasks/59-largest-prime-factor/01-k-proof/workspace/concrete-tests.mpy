Module(
  FuncDef("largest_prime_factor", Params("n"),
    Assign(Name("factor"), Int(2))
    While(Compare(Name("n"), CmpOp(">", Name("factor"))),
      If(Compare(
        BinOp("%", Name("n"), Name("factor")),
        CmpOp("==", Int(0))),
        Assign(Name("n"), BinOp("//", Name("n"), Name("factor"))),
        AugAssign(Name("factor"), "+", Int(1))))
    Return(Name("factor")))
  Assert(
    Compare(
      Call(Name("largest_prime_factor"), Int(13195)),
      CmpOp("==", Int(29))))
  Assert(
    Compare(
      Call(Name("largest_prime_factor"), Int(2048)),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("largest_prime_factor"), Int(4)),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("largest_prime_factor"), Int(6)),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("largest_prime_factor"), Int(12)),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("largest_prime_factor"), Int(49)),
      CmpOp("==", Int(7)))))
