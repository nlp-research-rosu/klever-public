+  --backend haskell \
+  --main-module STRONGEST-EXTENSION-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition "$SCRATCH/verification-kompiled" \
+  -I "$SCRATCH"
+
+run_logged stage3_character_claim \
