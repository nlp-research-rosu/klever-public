+#!/usr/bin/env bash
+set -u
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return 0
+}
+
