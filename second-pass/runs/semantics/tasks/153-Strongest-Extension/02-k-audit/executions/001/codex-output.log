+}
+
+printf '\n$ python3 /reference/py2mpy.py /candidate/solution.py > /tmp/audit-work/regenerated-solution.mpy\n'
+python3 /reference/py2mpy.py /candidate/solution.py \
+  > /tmp/audit-work/regenerated-solution.mpy
