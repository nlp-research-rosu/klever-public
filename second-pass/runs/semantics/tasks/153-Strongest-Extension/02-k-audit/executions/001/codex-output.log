+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return 0
+}
+
+run_logged() {
+  name=$1
+  shift
+  log="$EVIDENCE/$name.log"
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@" 2>&1 | tee "$log"
+  status=${PIPESTATUS[0]}
+  printf '[exit %d]\n' "$status"
+  return 0
+}
