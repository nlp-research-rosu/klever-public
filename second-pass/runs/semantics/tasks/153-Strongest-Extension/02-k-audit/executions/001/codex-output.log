+}
+
+run_logged() {
+  name=$1
+  shift
+  log="$EVIDENCE/$name.log"
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@" 2>&1 | tee "$log"
+  status=${PIPESTATUS[0]}
+  printf '[exit %d]\n' "$status"
+  return 0
+}
+
+run rm -rf "$SCRATCH"
+run mkdir -p "$SCRATCH"
+run cp -a /candidate/reference-semantics "$SCRATCH/reference-semantics"
