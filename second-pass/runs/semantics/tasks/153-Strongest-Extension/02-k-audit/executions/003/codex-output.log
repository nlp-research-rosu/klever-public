+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        ("x" |-> str(iCons(65, .IntSeq)))
+        ("_extension_strength" |->
+          closureVal(
+            ("extension", .ParamNames),
+            Return(Int(999)),
+            0)),
+        parent(0)))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
