diff --git a/evidence/check_integrity.sh b/evidence/check_integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..024ea4f15d4aae14aaa463963e9d341b5490d2b5
--- /dev/null
+++ b/evidence/check_integrity.sh
@@ -0,0 +1,127 @@
+#!/usr/bin/env bash
+set -u
+
+status=0
+check_hash() {
+  local label="$1"
+  local path="$2"
+  local expected="$3"
+  local actual
+  if [[ ! -f "$path" ]]; then
+    echo "MISSING $label $path"
+    status=1
+    return
+  fi
+  actual="$(sha256sum "$path" | awk '{print $1}')"
+  echo "$label expected=$expected actual=$actual"
+  if [[ "$actual" != "$expected" ]]; then
+    echo "HASH_MISMATCH $label"
+    status=1
+  fi
+}
+
+echo "record_layout=$(jq -r .record_layout /audit-input.json)"
+echo "semantics_mode=$(jq -r .semantics_mode /audit-input.json)"
+
+check_hash audit_campaign_lock /audit-campaign-lock.json \
+  "$(jq -r .hashes.audit_campaign_lock_sha256 /audit-input.json)"
+check_hash run_manifest /run.json \
+  "$(jq -r .hashes.run_manifest_sha256 /audit-input.json)"
+check_hash task_manifest /task.json \
+  "$(jq -r .hashes.task_manifest_sha256 /audit-input.json)"
+check_hash stage1_result /generation-result.json \
+  "$(jq -r .hashes.stage1_result_sha256 /audit-input.json)"
+check_hash stage1_invocation /generation-evidence/invocation.json \
+  "$(jq -r .hashes.stage1_invocation_sha256 /audit-input.json)"
+check_hash generation_metrics /generation-evidence/metrics.json \
+  "$(jq -r .hashes.generation_metrics_sha256 /audit-input.json)"
+check_hash generation_usage /generation-evidence/usage.json \
