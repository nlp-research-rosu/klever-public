diff --git a/evidence/differential.py b/evidence/differential.py
new file mode 100644
index 0000000000000000000000000000000000000000..7f4ec2a786d0c154c9244a0ff5f9957b06196890
--- /dev/null
+++ b/evidence/differential.py
@@ -0,0 +1,120 @@
+#!/usr/bin/env python3
+"""Independent source-level differential audit for HumanEval 153."""
+
+from __future__ import annotations
+
+import importlib.util
+import itertools
+import random
+from pathlib import Path
+
+
+def load_function(module_name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.Strongest_Extension
+
+
+canonical = load_function("trusted_canonical", Path("/reference/canonical.py"))
+candidate = load_function(
+    "audited_candidate", Path("/tmp/audit-work/candidate/solution.py")
+)
+
+
+def independent_oracle(class_name: str, extensions: list[str]) -> str:
+    if not extensions:
+        raise IndexError("empty extension list")
+
+    def strength(extension: str) -> int:
+        upper = sum(character.isalpha() and character.isupper() for character in extension)
+        lower = sum(character.isalpha() and character.islower() for character in extension)
+        return upper - lower
+
+    best_index = max(range(len(extensions)), key=lambda index: strength(extensions[index]))
+    return class_name + "." + extensions[best_index]
+
+
+def outcome(function, class_name: str, extensions: list[str]):
+    try:
+        return ("return", function(class_name, list(extensions)))
+    except Exception as error:  # boundary comparison intentionally records failures
+        return ("raise", type(error).__name__)
+
+
+curated = [
+    ("Slices", ["SErviNGSliCes", "Cheese", "StuFfed"]),
+    ("my_class", ["AA", "Be", "CC"]),
+    ("", [""]),
+    ("C", [""]),
+    ("Single", ["Aa"]),
+    ("Tie", ["AA", "CC"]),
+    ("GreaterAtSecond", ["a", "A"]),
+    ("LowerAtSecond", ["A", "a"]),
+    ("LateMaximum", ["a", "Aa", "AAA", "AA"]),
+    ("FourWayTie", ["AA", "BB", "CC", "DD"]),
+    ("LongList", ["abc", "A", "zz", "ZZ", "", "AaA"]),
+    ("Unicode", ["é", "É", "ß", "ΩΩ", "δ"]),
+    ("Punctuation", ["!!!", "A-1", "a_2", ""]),
+    ("EmptyBoundary", []),
+]
+
+alphabet = "aAZz09_-.éÉΩδß"
+small_names = [
+    "".join(chars)
+    for length in range(3)
+    for chars in itertools.product(alphabet[:6], repeat=length)
+]
+
+rng = random.Random(153)
+generated = []
+for _ in range(1000):
+    class_name = "".join(rng.choice(alphabet) for _ in range(rng.randrange(0, 9)))
+    count = rng.randrange(1, 9)
+    extensions = [
+        "".join(rng.choice(alphabet) for _ in range(rng.randrange(0, 13)))
+        for _ in range(count)
+    ]
+    generated.append((class_name, extensions))
+
+# Deterministically cover lengths 1 through 8 with many repeated/equal-strength names.
+for length in range(1, 9):
+    for offset in range(40):
+        names = [
+            small_names[(offset * (index + 1) + index) % len(small_names)]
+            for index in range(length)
+        ]
+        generated.append((f"C{length}", names))
+
+cases = curated + generated
+mismatches = []
+length_counts = {}
+for index, (class_name, extensions) in enumerate(cases):
+    length_counts[len(extensions)] = length_counts.get(len(extensions), 0) + 1
+    expected = outcome(independent_oracle, class_name, extensions)
+    trusted = outcome(canonical, class_name, extensions)
+    actual = outcome(candidate, class_name, extensions)
+    if not (expected == trusted == actual):
+        mismatches.append(
+            {
+                "index": index,
+                "class_name": class_name,
+                "extensions": extensions,
+                "oracle": expected,
+                "canonical": trusted,
+                "candidate": actual,
+            }
+        )
+
+print("oracle=independent stable first-maximum using Python character predicates")
+print(f"seed=153")
+print(f"curated_cases={len(curated)} generated_cases={len(generated)}")
+print(f"length_counts={dict(sorted(length_counts.items()))}")
+print(f"mismatches={len(mismatches)}")
+for mismatch in mismatches[:20]:
+    print(f"mismatch={mismatch!r}")
+
+if mismatches:
+    raise SystemExit(1)
diff --git a/evidence/pinning_check.py b/evidence/pinning_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..4d49b7210f9073b1053d7a8ce01f1b43d49911d8
--- /dev/null
+++ b/evidence/pinning_check.py
@@ -0,0 +1,232 @@
+#!/usr/bin/env python3
+"""Mechanical constructor-level source-to-proof pinning checks."""
+
+from __future__ import annotations
+
+import importlib.util
+import re
+from pathlib import Path
+
+
+ROOT = Path("/tmp/audit-work/candidate")
+mpy = (ROOT / "solution.mpy").read_text()
+verification = (ROOT / "verification.k").read_text()
+spec = (ROOT / "spec.k").read_text()
+
+
+def matching_paren(text: str, opening: int) -> int:
+    depth = 0
+    quoted = False
+    escaped = False
+    for index in range(opening, len(text)):
+        character = text[index]
+        if quoted:
+            if escaped:
+                escaped = False
+            elif character == "\\":
+                escaped = True
+            elif character == '"':
+                quoted = False
+            continue
+        if character == '"':
+            quoted = True
+        elif character == "(":
+            depth += 1
+        elif character == ")":
+            depth -= 1
+            if depth == 0:
+                return index
+    raise ValueError(f"unclosed parenthesis at {opening}")
+
+
+def top_level_segments(term: str) -> list[str]:
+    opening = term.index("(")
+    closing = matching_paren(term, opening)
+    body = term[opening + 1 : closing]
+    segments = []
+    start = 0
+    depth = 0
+    quoted = False
+    escaped = False
+    for index, character in enumerate(body):
+        if quoted:
+            if escaped:
+                escaped = False
+            elif character == "\\":
+                escaped = True
+            elif character == '"':
+                quoted = False
+            continue
+        if character == '"':
+            quoted = True
+        elif character in "([":
+            depth += 1
+        elif character in ")]":
+            depth -= 1
+        elif character == "," and depth == 0:
+            segments.append(body[start:index])
+            start = index + 1
+    segments.append(body[start:])
+    return segments
+
+
+def function_parts(name: str):
+    marker = f'FuncDef("{name}"'
+    start = mpy.index(marker)
+    opening = mpy.index("(", start)
+    closing = matching_paren(mpy, opening)
+    term = mpy[start : closing + 1]
+    parts = top_level_segments(term)
+    if len(parts) < 3:
+        raise AssertionError(f"malformed FuncDef for {name}")
+    return parts[1], "".join(parts[2:])
+
+
+def alias_rhs(name: str) -> str:
+    match = re.search(rf"\brule\s+{re.escape(name)}\s*=>", verification)
+    if not match:
+        raise AssertionError(f"missing alias rule {name}")
+    tail = verification[match.end() :]
+    end = re.search(r"\n\s*\n  (?=(?:rule|syntax|endmodule)\b)", tail)
+    if not end:
+        raise AssertionError(f"cannot find end of alias rule {name}")
+    return tail[: end.start()]
+
+
+def normalized(term: str) -> str:
+    result = re.sub(r"\s+", "", term)
+    # The translator pretty-printer leaves empty variadic tails blank, while K
+    # source spells the corresponding constructor identities explicitly.
+    result = result.replace(",.Exprs)", ",)")
+    result = result.replace(",.Stmts)", ",)")
+    return result
+
+
+def expanded_alias(name: str) -> str:
+    result = normalized(alias_rhs(name))
+    nested_aliases = {
+        "extensionStrengthBody": ["characterStrengthBody"],
+        "strongestExtensionBody": ["selectionLoopBody"],
+    }
+    for nested in nested_aliases.get(name, []):
+        result = result.replace(nested, normalized(alias_rhs(nested)))
+    return result
+
+
+checks = [
+    ("_extension_strength", "extensionStrengthBody", 'Params("extension")'),
+    (
+        "Strongest_Extension",
+        "strongestExtensionBody",
+        'Params("class_name","extensions")',
+    ),
+]
+
+for function_name, alias, expected_params in checks:
+    params, source_body = function_parts(function_name)
+    proof_body = expanded_alias(alias)
+    params_match = normalized(params) == expected_params
+    body_match = normalized(source_body) == proof_body
+    print(
+        f"function={function_name} alias={alias} "
+        f"params_match={params_match} body_match={body_match}"
+    )
+    if not (params_match and body_match):
+        print(f"source_body={normalized(source_body)}")
+        print(f"proof_body={normalized(proof_body)}")
+        raise SystemExit(1)
+
+binding_fragments = [
+    '["_extension_strength"<-closureVal(("extension",.ParamNames),extensionStrengthBody,0)]',
+    '["Strongest_Extension"<-closureVal(("class_name","extensions",.ParamNames),strongestExtensionBody,0)]',
+]
+normalized_verification = normalized(verification)
+for fragment in binding_fragments:
+    present = fragment in normalized_verification
+    print(f"solution_scope_binding={fragment} present={present}")
+    if not present:
+        raise SystemExit(1)
+
+entry_call = normalized(
+    """Call(
+      Name("Strongest_Extension"),
+      str(CLASS:IntSeq),
+      list(vCons(
+        str(E1:IntSeq),
+        vCons(str(E2:IntSeq),
+        vCons(str(E3:IntSeq), .ValSeq)))))"""
+)
+entry_binding = normalized(
+    """<env> 0 </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+    </scopes>"""
+)
+print(f"entry_call_exactly_three_present={entry_call in normalized(spec)}")
+print(f"entry_solution_scope_present={entry_binding in normalized(spec)}")
+if entry_call not in normalized(spec) or entry_binding not in normalized(spec):
+    raise SystemExit(1)
+
+
+def load_function(module_name: str, path: Path):
+    module_spec = importlib.util.spec_from_file_location(module_name, path)
+    assert module_spec and module_spec.loader
+    module = importlib.util.module_from_spec(module_spec)
+    module_spec.loader.exec_module(module)
+    return module.Strongest_Extension
+
+
+canonical = load_function("canonical_for_pinning", Path("/reference/canonical.py"))
+candidate = load_function("candidate_for_pinning", ROOT / "solution.py")
+
+
+def proof_strength(text: str) -> int:
+    # The proof's isUpperC/isLowerC primitives operate over ASCII codes.
+    return sum(
+        (1 if "A" <= character <= "Z" else 0)
+        - (1 if "a" <= character <= "z" else 0)
+        for character in text
+    )
+
+
+def claimed_result(class_name: str, extensions: list[str]) -> str:
+    best = extensions[0]
+    best_strength = proof_strength(best)
+    for extension in extensions:
+        strength = proof_strength(extension)
+        if strength > best_strength:
+            best = extension
+            best_strength = strength
+    return class_name + "." + best
+
+
+witness_class = "my_class"
+witness_extensions = ["AA", "Be", "CC"]
+summary = claimed_result(witness_class, witness_extensions)
+trusted = canonical(witness_class, witness_extensions)
+actual = candidate(witness_class, witness_extensions)
+print(
+    "entry_witness="
+    f"{(witness_class, witness_extensions)!r} "
+    f"claimed={summary!r} canonical={trusted!r} candidate={actual!r}"
+)
+if not (summary == trusted == actual == "my_class.AA"):
+    raise SystemExit(1)
+
+print(
+    "character_claim_witness="
+    "CURRENT=65 REST=.IntSeq ALL=iCons(65,.IntSeq) ACC=0 PREV=.IntSeq"
+)
+print(
+    "helper_claim_witness="
+    'CS=iCons(65,.IntSeq) LOCALS=.Map and "_extension_strength" not in LOCALS'
+)
+print(
+    "selection_claim_witness="
+    'E1="a" E2="A" E3="" BEST="a" BESTS=-1 LAST="a" SCORE=-1'
+)
+print(
+    "entry_claim_witness="
+    'CLASS="my_class" E1="AA" E2="Be" E3="CC" with fixed initial cells'
+)
diff --git a/evidence/reconstruct.sh b/evidence/reconstruct.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c9faf79a5c320632a1df3d277f00cdc20a238432
--- /dev/null
+++ b/evidence/reconstruct.sh
@@ -0,0 +1,86 @@
+#!/usr/bin/env bash
+set -u
+
+cd /tmp/audit-work/candidate || exit 97
+overall=0
+
+run_step() {
+  local label="$1"
+  shift
+  echo "BEGIN $label"
+  printf 'COMMAND'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local result=$?
+  echo "EXIT $label $result"
+  if [[ $result -ne 0 ]]; then
+    overall=1
+  fi
+  echo "END $label"
+}
+
+run_step tool_versions kompile --version
+
+run_step build_character \
+  kompile verification.k \
+    --backend haskell \
+    --main-module STRONGEST-EXTENSION-VERIFICATION \
+    --syntax-module MPY-SYNTAX \
+    --output-definition audit-verification-kompiled \
+    -I .
+
+run_step prove_character \
+  kprove spec.k \
+    --definition audit-verification-kompiled \
+    --spec-module STRONGEST-EXTENSION-SPEC \
+    --claims character-loop-correct \
+    --output pretty
+
+run_step build_strength \
+  kompile verification.k \
+    --backend haskell \
+    --main-module STRONGEST-EXTENSION-WITH-CHAR-LOOP-LEMMA \
+    --syntax-module MPY-SYNTAX \
+    --output-definition audit-char-loop-lemma-kompiled \
+    -I .
+
+run_step prove_strength \
+  kprove spec.k \
+    --definition audit-char-loop-lemma-kompiled \
+    --spec-module STRONGEST-EXTENSION-SPEC \
+    --claims extension-strength-correct \
+    --output pretty
+
+run_step build_selection \
+  kompile verification.k \
+    --backend haskell \
+    --main-module STRONGEST-EXTENSION-WITH-STRENGTH-LEMMA \
+    --syntax-module MPY-SYNTAX \
+    --output-definition audit-strength-lemma-kompiled \
+    -I .
+
+run_step prove_selection \
+  kprove spec.k \
+    --definition audit-strength-lemma-kompiled \
+    --spec-module STRONGEST-EXTENSION-SPEC \
+    --claims selection-loop-correct \
+    --output pretty
+
+run_step build_entry \
+  kompile verification.k \
+    --backend haskell \
+    --main-module STRONGEST-EXTENSION-WITH-LOOP-LEMMAS \
+    --syntax-module MPY-SYNTAX \
+    --output-definition audit-loop-lemmas-kompiled \
+    -I .
+
+run_step prove_entry \
+  kprove spec.k \
+    --definition audit-loop-lemmas-kompiled \
+    --spec-module STRONGEST-EXTENSION-SPEC \
+    --claims strongest-extension-correct \
+    --output pretty
+
+echo "RECONSTRUCTION_OVERALL_EXIT=$overall"
+exit "$overall"

exec
/bin/bash -lc "sed -n '1,240p' /reference/reference-semantics/semantics/assert.k; sed -n '1,240p' /reference/reference-semantics/semantics/comprehension.k; sed -n '1,240p' /reference/reference-semantics/semantics/concrete.k; sed -n '1,240p' /reference/reference-semantics/semantics/range.k; sed -n '1,260p' /reference/reference-semantics/semantics/subscript.k; sed -n '1,260p' /reference/reference-semantics/semantics/controls.k; sed -n '1,160p' /reference/reference-semantics/semantics/iter.k; sed -n '1,220p' /reference/reference-semantics/semantics.k" in /audit-output
 succeeded in 0ms:
// reference/src/semantics/assert.k — MPY-ASSERT

module MPY-ASSERT
  imports MPY-CORE

  rule <k> Assert(V:Val) => .K ... </k>
       requires truthy(V)
  rule <k> Assert(V:Val) ~> _ => .K </k>
       <exc> NoExc => AssertionError </exc>
       <exit-code> _ => 1 </exit-code>
       requires notBool truthy(V)

  rule <k> Assert(ref(H:Int)) => Assert(V) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]
endmodule
// reference/src/semantics/comprehension.k — MPY-COMPREHENSION

module MPY-COMPREHENSION
  imports MPY-CORE
  imports MPY-OPERATORS
  imports MPY-LIST
  imports MPY-CONTROLS
  imports MPY-FUNCTIONS

  // A comprehension is pure syntactic sugar
  rule ListComp(ELT:Expr, Gs:CompFors) => Call(closureExpr(.ParamNames, compBody(Gs, ELT)), .Exprs)
  rule GenExp(ELT:Expr, Gs:CompFors)   => Call(closureExpr(.ParamNames, compBody(Gs, ELT)), .Exprs)

  syntax Stmts ::= compBody(CompFors, Expr) [macro]
  rule compBody(Gs:CompFors, ELT:Expr)
    => Assign(Name("$acc"), ListExpr(.Exprs)) compNest(Gs, ELT) Return(Name("$acc"))

  syntax Stmt ::= compNest(CompFors, Expr) [macro-rec]
  rule compNest(.CompFors, ELT:Expr)
    => Assign(Name("$acc"), BinOp("+", Name("$acc"), ListExpr(ELT)))
  rule compNest((CompFor(T:Expr, ITER:Expr, Fs:Exprs) GRest:CompFors), ELT:Expr)
    => For(T, ITER, If(compGuard(Fs), compNest(GRest, ELT), .Stmts))

  syntax Expr ::= compGuard(Exprs) [macro]
  rule compGuard(.Exprs)             => Bool(true)
  rule compGuard((F:Expr, Fs:Exprs)) => BoolOp("and", (F, Fs))
endmodule
// reference/src/semantics/concrete.k — MPY-CONCRETE
// Concrete-execution-only rules, visible ONLY to the llvm build (run.sh kompiles
// MPY-CONCRETE; verification builds import MPY and never see these). Rationale:
// a k-cell rule matching value constructors NARROWS abstract Vals in the haskell
// backend ([concrete] is not respected on rewrite rules) — probed on
// 26-remove-duplicates, where element compares branched into deepEqVS.

module MPY-CONCRETE
  imports MPY

  // deep equality for list compares whose elements are heap objects
  // (list-of-lists): Python == is structural at every depth.
  rule <k> Compare(list(A:ValSeq), CmpOp("==", list(B:ValSeq))) => deepEqVS(A, B, HP) ... </k>
       <heap> HP:Map </heap>
       requires hasRefVS(A) orBool hasRefVS(B)
  rule <k> Compare(list(A:ValSeq), CmpOp("!=", list(B:ValSeq))) => notBool deepEqVS(A, B, HP) ... </k>
       <heap> HP:Map </heap>
       requires hasRefVS(A) orBool hasRefVS(B)

  // ==== keyed sort, concrete leg ============================================
  // Computes each key by a REAL call through the uniform #callee machinery
  // (closures, len, type objects all work), stable-inserts on the key, and
  // allocates the result. priority(40) beats sort.k's opaque rules, so krun
  // runs this and proofs (which never see MPY-CONCRETE) keep sortKeyVS.
  syntax Val ::= kvP(Val, Val)
  syntax KItem ::= #ksort(ValSeq, Val, ValSeq, Bool)
                 | #ksIns(Val, ValSeq, Val, ValSeq, Bool)
  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
        => #ksort(VS, KV, .ValSeq, false) ... </k>
       [priority(40)]
  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
        => #ksort(VS, KV, .ValSeq, RB) ... </k>
       [priority(40)]
  rule <k> #ksort(.ValSeq, _:Val, ACC:ValSeq, RB:Bool)
        => #alloc(list(condRev(unpairVS(ACC), RB))) ... </k>
  rule <k> #ksort(vCons(V:Val, R:ValSeq), KV:Val, ACC:ValSeq, RB:Bool)
        => KV ~> #callee((V, .Exprs)) ~> #ksIns(V, R, KV, ACC, RB) ... </k>
  rule <k> K:Val ~> #ksIns(V:Val, R:ValSeq, KV:Val, ACC:ValSeq, RB:Bool)
        => #ksort(R, KV, insPair(ACC, K, V), RB) ... </k>
       requires notBool isKwV(K)

  syntax ValSeq ::= insPair(ValSeq, Val, Val) [function]
  rule insPair(.ValSeq, K:Val, V:Val) => vCons(kvP(K, V), .ValSeq)
  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    => vCons(kvP(K, V), vCons(kvP(K2, V2), R))
       requires kLt(K, K2)
  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    => vCons(kvP(K2, V2), insPair(R, K, V))
       requires notBool kLt(K, K2)

  syntax Bool ::= kLt(Val, Val) [function]
  rule kLt(I1:Int, I2:Int)             => I1 <Int I2
  rule kLt(F1:Float, F2:Float)         => F1 <Float F2
  rule kLt(str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)

  syntax ValSeq ::= unpairVS(ValSeq) [function, total]
  rule unpairVS(.ValSeq) => .ValSeq
  rule unpairVS(vCons(kvP(_:Val, V:Val), R:ValSeq)) => vCons(V, unpairVS(R))
  rule unpairVS(vCons(V:Val, R:ValSeq)) => vCons(V, unpairVS(R)) [owise]
endmodule
// reference/src/semantics/range.k — MPY-RANGE
// rangeObj: the range helpers (inRange / rangeLen) + its #iterNext case. rangeObj itself is
// declared in MPY-CORE's Iterable union; this module owns its behavior.

module MPY-RANGE
  imports MPY-CORE
  imports MPY-ITER

  syntax Bool ::= inRange(Int, Int, Int) [function, total]
  rule inRange(I:Int, HI:Int, ST:Int) => (ST >Int 0 andBool I <Int HI) orBool (ST <Int 0 andBool I >Int HI)

  syntax Int ::= rangeLen(Int, Int, Int) [function]
  rule rangeLen(LO:Int, HI:Int, ST:Int) => (HI -Int LO +Int ST -Int 1) /Int ST
       requires ST >Int 0 andBool HI >Int LO
  rule rangeLen(LO:Int, HI:Int, ST:Int) => (LO -Int HI -Int ST -Int 1) /Int (0 -Int ST)
       requires ST <Int 0 andBool HI <Int LO
  rule rangeLen(LO:Int, HI:Int, ST:Int) => 0
       requires (ST >Int 0 andBool HI <=Int LO) orBool (ST <Int 0 andBool HI >=Int LO)

  rule <k> #iterNext(rangeObj(I:Int, HI:Int, ST:Int))
        => #iterYield(I, rangeObj(I +Int ST, HI, ST)) ... </k>
       requires inRange(I, HI, ST)
  rule <k> #iterNext(rangeObj(I:Int, HI:Int, ST:Int)) => #iterDone ... </k>
       requires notBool inRange(I, HI, ST)
endmodule
// reference/src/semantics/subscript.k — MPY-SUBSCRIPT

module MPY-SUBSCRIPT
  imports MPY-CORE

  // ==== positional access + negative-index normalization (used only here) ===
  // valSeqAt is [total]: in-bounds vCons access reduces as usual; on an OPAQUE sequence (e.g.
  // a trusted sort's sortVS(VS)) or OOB it stays an abstract total value — so indexing the
  // opaque sorted list is DEFINED (no undischarged #Ceil), matching the old semantics' total
  // atK. K trusts the [total] annotation; valid programs index in-bounds.
  syntax Val ::= valSeqAt(ValSeq, Int) [function, total]
  rule valSeqAt(vCons(V:Val, _:ValSeq), 0)     => V
  rule valSeqAt(vCons(_:Val, S:ValSeq), I:Int) => valSeqAt(S, I -Int 1)
       requires I >Int 0

  syntax Int ::= intSeqAt(IntSeq, Int) [function]
  rule intSeqAt(iCons(C:Int, _:IntSeq), 0)     => C
  rule intSeqAt(iCons(_:Int, S:IntSeq), I:Int) => intSeqAt(S, I -Int 1)
       requires I >Int 0

  syntax Int ::= normIdx(Int, Int) [function, total]
  rule normIdx(I:Int, LEN:Int) => I +Int LEN requires I  <Int 0
  rule normIdx(I:Int, _:Int)   => I          requires I >=Int 0

  // ==== Subscript: indexing obj[i] (list / tuple / str) =====================
  // contexts (not strict attrs): the Index slot's Slice alternative must never heat
  context Subscript(HOLE, _)
  context Subscript(_:Val, HOLE:Expr)

  // heap-object deref (covers both the index and slice forms via the Index slot)
  rule <k> Subscript(ref(H:Int), IX:Index) => Subscript(V, IX) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]

  rule <k> Subscript(OBJ:Val, I:Int) => applyIndex(OBJ, I) ... </k>

  syntax Val ::= applyIndex(Val, Int) [function]
  rule applyIndex(list(VS:ValSeq),  I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
  rule applyIndex(tuple(VS:ValSeq), I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
  rule applyIndex(str(IS:IntSeq),   I:Int)
    => str(iCons(intSeqAt(IS, normIdx(I, isLen(IS))), .IntSeq))

  // ==== Slice: obj[lo:hi:step] (list / str) — CPython slice.indices ==========
  syntax KItem ::= #evalB(Bound) | "#toSome"
                 | #slLo(Val, Bound, Bound)
                 | #slHi(Val, OptInt, Bound)
                 | #slStep(Val, OptInt, OptInt)

  syntax OptInt ::= "noB" | someB(Int)
  rule <k> #evalB(NoBound)  => noB ... </k>
  rule <k> #evalB(E:Expr)   => E ~> #toSome ... </k>
  rule <k> I:Int ~> #toSome => someB(I) ... </k>

  rule <k> Subscript(OBJ:Val, Slice(LO:Bound, HI:Bound, ST:Bound)) => #evalB(LO) ~> #slLo(OBJ, HI, ST) ... </k>
  rule <k> LO:OptInt ~> #slLo(OBJ:Val, HI:Bound, ST:Bound)   => #evalB(HI) ~> #slHi(OBJ, LO, ST) ... </k>
  rule <k> HI:OptInt ~> #slHi(OBJ:Val, LO:OptInt, ST:Bound)  => #evalB(ST) ~> #slStep(OBJ, LO, HI) ... </k>
  // a list slice constructs a NEW object; a str slice stays a value
  rule <k> ST:OptInt ~> #slStep(list(VS:ValSeq), LO:OptInt, HI:OptInt)
        => #alloc(doSlice(list(VS), LO, HI, ST)) ... </k>
       [priority(45)]
  rule <k> ST:OptInt ~> #slStep(OBJ:Val, LO:OptInt, HI:OptInt) => doSlice(OBJ, LO, HI, ST) ... </k>

  syntax Val ::= doSlice(Val, OptInt, OptInt, OptInt) [function]
  rule doSlice(list(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    => list(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))
  rule doSlice(tuple(VS:ValSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    => tuple(buildVS(VS, slStart(LO, ST, vsLen(VS)), slStop(HI, ST, vsLen(VS)), slStep(ST)))
  rule doSlice(str(IS:IntSeq), LO:OptInt, HI:OptInt, ST:OptInt)
    => str(buildIS(IS, slStart(LO, ST, isLen(IS)), slStop(HI, ST, isLen(IS)), slStep(ST)))

  // ==== slice.indices: step / start / stop / clamp ==========================
  syntax Int ::= slStep(OptInt) [function, total]
  rule slStep(noB)          => 1
  rule slStep(someB(S:Int)) => S

  syntax Int ::= slStart(OptInt, OptInt, Int) [function]
  rule slStart(noB,          ST:OptInt, _LEN:Int) => 0
       requires slStep(ST) >Int 0
  rule slStart(noB,          ST:OptInt, LEN:Int)  => LEN -Int 1
       requires slStep(ST) <Int 0
  rule slStart(someB(I:Int), ST:OptInt, LEN:Int)  => slAdjust(I, LEN, slStep(ST))

  syntax Int ::= slStop(OptInt, OptInt, Int) [function]
  rule slStop(noB,          ST:OptInt, LEN:Int)  => LEN
       requires slStep(ST) >Int 0
  rule slStop(noB,          ST:OptInt, _LEN:Int) => -1
       requires slStep(ST) <Int 0
  rule slStop(someB(I:Int), ST:OptInt, LEN:Int)  => slAdjust(I, LEN, slStep(ST))

  syntax Int ::= slAdjust(Int, Int, Int) [function, total]
  rule slAdjust(I:Int, LEN:Int, STEP:Int) => clampLo(I +Int LEN, STEP)
       requires I  <Int 0
  rule slAdjust(I:Int, LEN:Int, STEP:Int) => clampHi(I, LEN, STEP)
       requires I >=Int 0

  syntax Int ::= clampLo(Int, Int) [function, total]
  rule clampLo(J:Int, _STEP:Int) => J
       requires J >=Int 0
  rule clampLo(J:Int, STEP:Int)  => #if STEP <Int 0 #then -1 #else 0 #fi
       requires J <Int 0

  syntax Int ::= clampHi(Int, Int, Int) [function, total]
  rule clampHi(I:Int, LEN:Int, _STEP:Int) => I
       requires I  <Int LEN
  rule clampHi(I:Int, LEN:Int, STEP:Int)  => #if STEP <Int 0 #then LEN -Int 1 #else LEN #fi
       requires I >=Int LEN

  // ==== build the strided sub-sequence (indices in range by construction) ====
  syntax ValSeq ::= buildVS(ValSeq, Int, Int, Int) [function]
  rule buildVS(VS:ValSeq, I:Int, STOP:Int, STEP:Int)
    => vCons(valSeqAt(VS, I), buildVS(VS, I +Int STEP, STOP, STEP))
       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)
  rule buildVS(_:ValSeq, I:Int, STOP:Int, STEP:Int) => .ValSeq
       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))

  syntax IntSeq ::= buildIS(IntSeq, Int, Int, Int) [function]
  rule buildIS(IS:IntSeq, I:Int, STOP:Int, STEP:Int)
    => iCons(intSeqAt(IS, I), buildIS(IS, I +Int STEP, STOP, STEP))
       requires (STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP)
  rule buildIS(_:IntSeq, I:Int, STOP:Int, STEP:Int) => .IntSeq
       requires notBool ((STEP >Int 0 andBool I <Int STOP) orBool (STEP <Int 0 andBool I >Int STOP))
endmodule
// reference/src/semantics/controls.k — MPY-CONTROLS

module MPY-CONTROLS
  imports MPY-CORE
  imports MPY-TUPLE
  imports MPY-ITER

  // ==== Assign / AugAssign (write the current scope; RHS evaluated by strictness) ==
  rule <k> Assign(Name(X:String), V:Val) => .K ... </k>
       <env> L:Int </env>
       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>
  rule <k> Assign(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>
       <env> L:Int </env>
       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
       requires "$cells" in_keys(M)
        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
        andBool X in_keys(M) andBool isCellRef({M[X]}:>Val)
       [priority(40)]

  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => .K ... </k>
       <env> L:Int </env>
       <scopes> ... L |-> scope(M:Map => M [ X <- applyBin(OP, {M[X]}:>Val, V) ], _) ... </scopes>
       requires X in_keys(M)
  // `lst += [..]` where lst is a heap ref: the generic rule leaves applyBin(OP, ref, V) — but the
  // ref-deref preemption is BinOp-level (operators.k), so applyBin never derefs and it sticks. Route
  // the ref case through BinOp so the deref + list-concat + #alloc path fires (result is a fresh ref).
  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => Assign(Name(X), BinOp(OP, Name(X), V)) ... </k>
       <env> L:Int </env>
       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
       requires X in_keys(M) andBool isRefV({M[X]}:>Val)
       [priority(40)]

  // ==== import trivia: `from math import floor, ceil` binds the supported
  // names as builtins in the current scope; every other import is a no-op
  rule <k> ImportFrom("math", NS:ParamNames) => #bindImports(NS) ... </k>
  rule <k> ImportFrom(_:String, _:ParamNames) => .K ... </k> [owise]
  syntax KItem ::= #bindImports(ParamNames)
  rule <k> #bindImports(.ParamNames) => .K ... </k>
  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
       <env> L:Int </env>
       <scopes> ... L |-> scope(M:Map => M [ N <- builtinV(N) ], _) ... </scopes>
       requires N ==String "floor" orBool N ==String "ceil"
  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
       requires notBool (N ==String "floor" orBool N ==String "ceil")

  // ==== Expr statement: evaluate for effect, discard the value ===============
  // (bare calls — mutator methods, docstrings; the WP0 statement-trivia rung)
  rule <k> Expr(_:Val) => .K ... </k>

  // ==== If (condition evaluated by strictness) ==============================
  syntax KItem ::= #branch(Bool, Stmts, Stmts)
  rule <k> If(C:Val, T:Stmts, E:Stmts) => #branch(truthy(C), T, E) ... </k>
  rule <k> #branch(true,  T:Stmts, _:Stmts) => T ... </k>
  rule <k> #branch(false, _:Stmts, E:Stmts) => E ... </k>

  // ==== IfExp: ternary T if C else E ========================================
  rule <k> IfExp(V:Val, T:Expr, _:Expr) => T ... </k>
       requires truthy(V)
  rule <k> IfExp(V:Val, _:Expr, E:Expr) => E ... </k>
       requires notBool truthy(V)

  // ==== For: one loop, in-cell continuation, over #iterNext =================
  // (the iterable is evaluated once, by strictness; the protocol stays rewrites —
  // circularities anchor on #loop and narrowing substitutes the structure)
  syntax KItem ::= #loop(Val, Expr, Stmts) | #loopStep(Expr, Stmts)
                 | #while(Expr, Stmts) | #whileCond(Expr, Stmts)
                 | #loopLbl(K) | "#cont" | "#brk"

  rule <k> For(T:Expr, OBJ:Val, B:Stmts) => #loop(OBJ, T, B) ... </k>

  rule <k> #loop(IT:Iterable, T:Expr, B:Stmts) => #iterNext(IT) ~> #loopStep(T, B) ... </k>
  rule <k> #iterDone ~> #loopStep(_:Expr, _:Stmts) => .K ... </k>
  rule <k> #iterYield(V:Val, REST:Iterable) ~> #loopStep(T:Expr, B:Stmts)
        => #bindTgt(T, V) ~> B ~> #loopLbl(#loop(REST, T, B)) ... </k>

  // ==== While ==============================================================
  rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>
  rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>
  rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>
       requires truthy(V)
  rule <k> V:Val ~> #whileCond(_C:Expr, _B:Stmts) => .K ... </k>
       requires notBool truthy(V)

  // ==== loop control (break / continue) =====================================
  rule <k> #loopLbl(NEXT:K) => NEXT ... </k>
  rule <k> Continue => #cont ... </k>
  rule <k> Break => #brk ... </k>
  rule <k> #cont ~> #loopLbl(NEXT:K) => NEXT ... </k>
  rule <k> #cont ~> (_:KItem => .K) ... </k> [owise]
  rule <k> #brk ~> #loopLbl(_:K) => .K ... </k>
  rule <k> #brk ~> (_:KItem => .K) ... </k> [owise]

  // ==== heap-object deref at the truthiness/iteration consumers ==============
  // (priority(40) preempts the generic Val rules so truthy/#loop never see a ref)
  rule <k> If(ref(H:Int), T:Stmts, E:Stmts) => If(V, T, E) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]
  rule <k> IfExp(ref(H:Int), T:Expr, E:Expr) => IfExp(V, T, E) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]
  rule <k> ref(H:Int) ~> #whileCond(C:Expr, B:Stmts) => V ~> #whileCond(C, B) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]
  // For derefs its iterable ONCE at loop start (iteration is over the snapshot;
  // mutating the iterated list inside its own loop is outside the subset)
  rule <k> For(T:Expr, ref(H:Int), B:Stmts) => For(T, V, B) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]
endmodule
// reference/src/semantics/iter.k — MPY-ITER
// The iterator protocol, DECLARATION ONLY. Each iterable's #iterNext case lives in that
// iterable's own module (list/tuple/str in their modules, rangeObj in range.k, zip in
// builtins.k). Consumers (the for-loop, `x in _`, sum/all/any/max/min) import this.

module MPY-ITER
  imports MPY-CORE
  syntax KItem ::= #iterNext(Iterable) | "#iterDone" | #iterYield(Val, Iterable)
endmodule
// reference/src/semantics.k — the supplied `.mpy` semantics, ASSEMBLED.
//
//   kompile reference-semantics/semantics.k --backend llvm \
//     --main-module MPY-KRUN --syntax-module MPY-SYNTAX \
//     --output-definition runtime-kompiled
//
// Concrete-only legs are included through MPY-KRUN. Proof definitions import
// MPY and any explicit proof extensions supplied by the task author.
//
// Files (dependency order — everything imports MPY-CORE):
//   semantics/syntax.k         MPY-SYNTAX       AST productions
//   semantics/core.k           MPY-CORE         values, config, load, lookup, shared helpers   [required]
//   semantics/iter.k           MPY-ITER         the iterator protocol (#iterNext/#iterYield/#iterDone) decl
//   semantics/range.k          MPY-RANGE        rangeObj: inRange / rangeLen / its #iterNext
//   semantics/operators.k      MPY-OPERATORS    operator DISPATCH (UnaryOp/BinOp/Compare/BoolOp) — domain files own the cases
//   semantics/int.k            MPY-INT          Int operator cases; floored // and % (pyMod)
//   semantics/bool.k           MPY-BOOL         Bool operator cases + truthy not/and/or (BoolOp)
//   semantics/float.k          MPY-FLOAT        Float Val: literal + opaque float ops ([concrete] for krun)
//   semantics/str.k            MPY-STR          str(IntSeq): literal, +, ==, in
//   semantics/set.k            MPY-SET          set(str): distinct char codes (len / membership)
//   semantics/list.k           MPY-LIST         ListExpr, list(ValSeq): +, ==, in
//   semantics/tuple.k          MPY-TUPLE        TupleExpr, tuple ==, target-binding + unpacking
//   semantics/subscript.k      MPY-SUBSCRIPT    Subscript indexing + Slice
//   semantics/comprehension.k  MPY-COMPREHENSION  list comprehensions [ELT for T in ITER if COND]
//   semantics/methods.k        MPY-METHODS      pure str methods: is*/lower/upper/swapcase/startswith
//   semantics/controls.k       MPY-CONTROLS     Assign/AugAssign, If, IfExp, For, While, break/continue
//   semantics/functions.k      MPY-FUNCTIONS    def / call / return (frame stack)
//   semantics/builtins.k       MPY-BUILTINS     builtins as calls: len/sum/abs/min/max/ord/chr/str
//   semantics/call.k           MPY-CALL         ALL Call routing + argument evaluation
//   semantics/sort.k           MPY-SORT         trusted sorted(): opaque sortVS + concrete insertion sort
//   semantics/assert.k         MPY-ASSERT       Assert oracle (smoke programs only)
//   semantics/dict.k           MPY-DICT         order-preserving dictV(KS,VS) + .keys() + list()

requires "semantics/syntax.k"
requires "semantics/core.k"
requires "semantics/iter.k"
requires "semantics/range.k"
requires "semantics/operators.k"
requires "semantics/int.k"
requires "semantics/bool.k"
requires "semantics/float.k"
requires "semantics/str.k"
requires "semantics/set.k"
requires "semantics/list.k"
requires "semantics/tuple.k"
requires "semantics/subscript.k"
requires "semantics/comprehension.k"
requires "semantics/methods.k"
requires "semantics/controls.k"
requires "semantics/functions.k"
requires "semantics/builtins.k"
requires "semantics/call.k"
requires "semantics/sort.k"
requires "semantics/assert.k"
requires "semantics/dict.k"
requires "semantics/concrete.k"

module MPY
  imports MPY-CORE
  imports MPY-ITER
  imports MPY-RANGE
  imports MPY-OPERATORS
  imports MPY-INT
  imports MPY-BOOL
  imports MPY-FLOAT
  imports MPY-STR
  imports MPY-SET
  imports MPY-LIST
  imports MPY-TUPLE
  imports MPY-SUBSCRIPT
  imports MPY-COMPREHENSION
  imports MPY-METHODS
  imports MPY-CONTROLS
  imports MPY-FUNCTIONS
  imports MPY-BUILTINS
  imports MPY-CALL
  imports MPY-SORT
  imports MPY-ASSERT
  imports MPY-DICT
endmodule

// The krun (llvm) main module: MPY plus the concrete-only legs (keyed sort's
// real key calls, deep list equality). Verification builds import MPY and
// never see MPY-CONCRETE. The llvm kompile MUST use --main-module MPY-KRUN —
// with plain MPY the concrete legs are silently absent (this was live for a
// while: sorted-key stuck and comprehension asserted wrong under krun).
module MPY-KRUN
  imports MPY
  imports MPY-CONCRETE
endmodule

