    74	    Assign(Name("score"), Call(Name("_extension_strength"), Name("extension")))
    75	    If(Compare(Name("score"), CmpOp(">", Name("strongest_strength"))),
    76	      Assign(Name("strongest"), Name("extension"))
    77	      Assign(Name("strongest_strength"), Name("score")),
    78	      .Stmts)
    79	
    80	  rule strongestExtensionBody =>
    81	    Assign(Name("strongest"), Subscript(Name("extensions"), Int(0)))
    82	    Assign(Name("strongest_strength"),
    83	      Call(Name("_extension_strength"), Name("strongest")))
    84	    Assign(Name("extension"), Name("strongest"))
    85	    Assign(Name("score"), Name("strongest_strength"))
    86	    For(Name("extension"), Name("extensions"), selectionLoopBody)
    87	    Return(BinOp("+",
    88	      BinOp("+", Name("class_name"), Str(".")),
    89	      Name("strongest")))
    90	
    91	  syntax Scope ::= "solutionScope" [function]
    92	  rule solutionScope =>
    93	    scope(
    94	      .Map
    95	        [ "_extension_strength" <-
    96	          closureVal(("extension", .ParamNames), extensionStrengthBody, 0) ]
    97	        [ "Strongest_Extension" <-
    98	          closureVal(("class_name", "extensions", .ParamNames),
    99	                     strongestExtensionBody, 0) ],
   100	      parent(-1))
   101	endmodule
   102	
   103	// Stage 1: use the character-loop theorem after proving it in the base module.
   104	module STRONGEST-EXTENSION-WITH-CHAR-LOOP-LEMMA
   105	  imports STRONGEST-EXTENSION-VERIFICATION
   106	
   107	  rule
   108	    <k>
   109	      #loop(
   110	        str(iCons(CURRENT:Int, REST:IntSeq)),
   111	        Name("character"),
   112	        BODY:Stmts)
   113	      => .K
   114	      ...
   115	    </k>
   116	    <env> L:Int </env>
   117	    <scopes>
   118	      SCOPES:Map
   119	      L |-> scope(
   120	        ("extension" |-> str(ALL:IntSeq))
   121	        ("score" |-> ACC:Int)
   122	        ("character" |-> str(PREV:IntSeq)),
   123	        PARENT:Parent)
   124	    =>
   125	      SCOPES
   126	      L |-> scope(
   127	        ("extension" |-> str(ALL))
   128	        ("score" |->
   129	          strengthAcc(iCons(CURRENT, REST), ACC))
   130	        ("character" |->
   131	          str(lastCharacter(iCons(CURRENT, REST), PREV))),
   132	        PARENT)
   133	    </scopes>
   134	    requires BODY ==K characterStrengthBody
   135	    [priority(40)]
   136	endmodule
   137	
   138	// Stage 2: use the proved helper theorem while verifying the outer loop.
   139	module STRONGEST-EXTENSION-WITH-STRENGTH-LEMMA
   140	  imports STRONGEST-EXTENSION-WITH-CHAR-LOOP-LEMMA
   141	
   142	  rule
   143	    <k>
   144	      Call(Name("_extension_strength"), Name(X:String))
   145	      => extensionStrength(CS)
   146	      ...
   147	    </k>
   148	    <env> L:Int </env>
   149	    <scopes>
   150	      ...
   151	      L |-> scope((X |-> str(CS:IntSeq)) _REST:Map, _P:Parent)
   152	      ...
   153	    </scopes>
   154	    [priority(40)]
   155	
   156	  rule <k>
   157	    #applyK(
   158	      toCall(closureVal(("extension", .ParamNames), BODY:Stmts, 0)),
   159	      (str(CS:IntSeq), .Vals))
   160	    => extensionStrength(CS)
   161	    ...
   162	  </k>
   163	  requires BODY ==K extensionStrengthBody
   164	  [priority(40)]
   165	endmodule
   166	
   167	// Stage 3: use both proved loop summaries for the symbolic three-name theorem.
   168	module STRONGEST-EXTENSION-WITH-LOOP-LEMMAS
   169	  imports STRONGEST-EXTENSION-WITH-STRENGTH-LEMMA
   170	
   171	  rule
   172	    <k>
   173	      #loop(
   174	        list(vCons(
   175	          str(E1:IntSeq),
   176	          vCons(str(E2:IntSeq),
   177	          vCons(str(E3:IntSeq), .ValSeq)))),
   178	        Name("extension"),
   179	        BODY:Stmts)
   180	      => .K
   181	      ...
   182	    </k>
   183	    <env> 1 </env>
   184	    <scopes>
   185	      (0 |-> MODULESCOPE:Scope)
   186	      (-1 |-> BUILTINSSCOPE:Scope)
   187	      (1 |-> scope(
   188	        ("class_name" |-> str(CLASS:IntSeq))
   189	        ("extensions" |-> list(ALL:ValSeq))
   190	        ("strongest" |-> str(BEST:IntSeq))
   191	        ("strongest_strength" |-> BESTS:Int)
   192	        ("extension" |-> str(LAST:IntSeq))
   193	        ("score" |-> SCORE:Int),
   194	        parent(0)))
   195	    =>
   196	      (0 |-> MODULESCOPE)
   197	      (-1 |-> BUILTINSSCOPE)
   198	      (1 |-> scope(
   199	        ("class_name" |-> str(CLASS))
   200	        ("extensions" |-> list(ALL))
   201	        ("strongest" |->
   202	          str(bestExtension(
   203	            vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
   204	            BEST,
   205	            BESTS)))
   206	        ("strongest_strength" |->
   207	          bestStrength(
   208	            vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
   209	            BEST,
   210	            BESTS))
   211	        ("extension" |->
   212	          str(lastExtension(
   213	            vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
   214	            LAST)))
   215	        ("score" |->
   216	          extensionStrength(
   217	            lastExtension(
   218	              vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
   219	              LAST))),
   220	        parent(0)))
   221	    </scopes>
   222	    requires BODY ==K selectionLoopBody
   223	     andBool MODULESCOPE ==K solutionScope
   224	     andBool BUILTINSSCOPE ==K builtinsScope
   225	     andBool SCORE ==Int extensionStrength(LAST)
   226	    [priority(40)]
   227	endmodule
     1	requires "verification.k"
     2	
     3	module STRONGEST-EXTENSION-SPEC
     4	  imports STRONGEST-EXTENSION-VERIFICATION
     5	
     6	  // Induction step for the character loop.  The empty suffix is discharged by
     7	  // the reference semantics; the nonempty suffix reuses this circularity.
     8	  claim
     9	    <k>
    10	      #loop(
    11	        str(iCons(CURRENT:Int, REST:IntSeq)),
    12	        Name("character"),
    13	        characterStrengthBody)
    14	      ~> CONT:K
    15	    =>
    16	      CONT
    17	    </k>
    18	    <env> 2 </env>
    19	    <scopes>
    20	      (0 |-> solutionScope)
    21	      (-1 |-> builtinsScope)
    22	      (2 |-> scope(
    23	        ("extension" |-> str(ALL:IntSeq))
    24	        ("score" |-> ACC:Int)
    25	        ("character" |-> str(PREV:IntSeq)),
    26	        parent(0)))
    27	    =>
    28	      (0 |-> solutionScope)
    29	      (-1 |-> builtinsScope)
    30	      (2 |-> scope(
    31	        ("extension" |-> str(ALL))
    32	        ("score" |->
    33	          strengthAcc(iCons(CURRENT, REST), ACC))
    34	        ("character" |->
    35	          str(lastCharacter(iCons(CURRENT, REST), PREV))),
    36	        parent(0)))
    37	    </scopes>
    38	    <scopeLoc> 3 </scopeLoc>
    39	    <heap> HEAP:Map </heap>
    40	    <heapLoc> HLOC:Int </heapLoc>
    41	    <stack> STACK:List </stack>
    42	    <ret> noRet </ret>
    43	    <exc> NoExc </exc>
    44	    <exit-code> 0 </exit-code>
    45	    [label(character-loop-correct), circularity]
    46	
    47	  // Helper theorem, proved using only the already-discharged character loop.
    48	  claim
    49	    <k>
    50	      Call(Name("_extension_strength"), str(CS:IntSeq))
    51	      ~> CONT:K
    52	    =>
    53	      extensionStrength(CS)
    54	      ~> CONT
    55	    </k>
    56	    <env> 1 </env>
    57	    <scopes>
    58	      (0 |-> solutionScope)
    59	      (-1 |-> builtinsScope)
    60	      (1 |-> scope(LOCALS:Map, parent(0)))
    61	    </scopes>
    62	    <scopeLoc> 2 </scopeLoc>
    63	    <heap> HEAP:Map </heap>
    64	    <heapLoc> HLOC:Int </heapLoc>
    65	    <stack> STACK:List </stack>
    66	    <ret> noRet </ret>
    67	    <exc> NoExc </exc>
    68	    <exit-code> 0 </exit-code>
    69	    requires notBool ("_extension_strength" in_keys(LOCALS))
    70	    [label(extension-strength-correct), depends(character-loop-correct)]
    71	
    72	  // Symbolic stable first-maximum loop theorem for three arbitrary names.
    73	  claim
    74	    <k>
    75	      #loop(
    76	        list(vCons(
    77	          str(E1:IntSeq),
    78	          vCons(str(E2:IntSeq),
    79	          vCons(str(E3:IntSeq), .ValSeq)))),
    80	        Name("extension"),
    81	        selectionLoopBody)
    82	      ~> CONT:K
    83	    =>
    84	      CONT
    85	    </k>
    86	    <env> 1 </env>
    87	    <scopes>
    88	      (0 |-> solutionScope)
    89	      (-1 |-> builtinsScope)
    90	      (1 |-> scope(
    91	        ("class_name" |-> str(CLASS:IntSeq))
    92	        ("extensions" |-> list(ALL:ValSeq))
    93	        ("strongest" |-> str(BEST:IntSeq))
    94	        ("strongest_strength" |-> BESTS:Int)
    95	        ("extension" |-> str(LAST:IntSeq))
    96	        ("score" |-> extensionStrength(LAST)),
    97	        parent(0)))
    98	    =>
    99	      (0 |-> solutionScope)
   100	      (-1 |-> builtinsScope)
   101	      (1 |-> scope(
   102	        ("class_name" |-> str(CLASS))
   103	        ("extensions" |-> list(ALL))
   104	        ("strongest" |->
   105	          str(bestExtension(
   106	            vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
   107	            BEST,
   108	            BESTS)))
   109	        ("strongest_strength" |->
   110	          bestStrength(
   111	            vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
   112	            BEST,
   113	            BESTS))
   114	        ("extension" |->
   115	          str(lastExtension(
   116	            vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
   117	            LAST)))
   118	        ("score" |->
   119	          extensionStrength(
   120	            lastExtension(
   121	              vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
   122	              LAST))),
   123	        parent(0)))
   124	    </scopes>
   125	    <scopeLoc> 2 </scopeLoc>
   126	    <heap> HEAP:Map </heap>
   127	    <heapLoc> HLOC:Int </heapLoc>
   128	    <stack> STACK:List </stack>
   129	    <ret> noRet </ret>
   130	    <exc> NoExc </exc>
   131	    <exit-code> 0 </exit-code>
   132	    [label(selection-loop-correct),
   133	     depends(extension-strength-correct)]
   134	
   135	  // Entry-point theorem for an arbitrary ASCII class and three arbitrary
   136	  // ASCII extension names (the shape used by the prompt's main example).
   137	  claim
   138	    <k>
   139	      Call(
   140	        Name("Strongest_Extension"),
   141	        str(CLASS:IntSeq),
   142	        list(vCons(
   143	          str(E1:IntSeq),
   144	          vCons(str(E2:IntSeq),
   145	          vCons(str(E3:IntSeq), .ValSeq)))))
   146	    =>
   147	      str(seqConcat(
   148	        seqConcat(CLASS, iCons(46, .IntSeq)),
   149	        bestExtension(
   150	          vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
   151	          E1,
   152	          extensionStrength(E1))))
   153	    </k>
   154	    <env> 0 </env>
   155	    <scopes>
   156	      (0 |-> solutionScope)
   157	      (-1 |-> builtinsScope)
   158	    </scopes>
   159	    <scopeLoc> 1 </scopeLoc>
   160	    <heap> .Map </heap>
   161	    <heapLoc> 0 </heapLoc>
   162	    <stack> .List </stack>
   163	    <ret> noRet </ret>
   164	    <exc> NoExc </exc>
   165	    <exit-code> 0 </exit-code>
   166	    [label(strongest-extension-correct),
   167	     depends(extension-strength-correct, selection-loop-correct)]
   168	endmodule

