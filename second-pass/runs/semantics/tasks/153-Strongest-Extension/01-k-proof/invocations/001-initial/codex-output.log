+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allExtensionNames(EXTS)
+     andBool notBool ("strongest" in_keys(RESTLOCALS))
+     andBool notBool ("strongest_strength" in_keys(RESTLOCALS))
+     andBool notBool ("extension" in_keys(RESTLOCALS))
+     andBool notBool ("score" in_keys(RESTLOCALS))
+     andBool notBool ("_extension_strength" in_keys(RESTLOCALS))
+    [label(selection-loop-correct), circularity,
+     depends(extension-strength-correct)]
