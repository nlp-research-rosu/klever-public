+    score -= extension.count("p")
+    score -= extension.count("q")
+    score -= extension.count("r")
+    score -= extension.count("s")
+    score -= extension.count("t")
+    score -= extension.count("u")
+    score -= extension.count("v")
+    score -= extension.count("w")
+    score -= extension.count("x")
+    score -= extension.count("y")
+    score -= extension.count("z")
+    return score
+
+
+def Strongest_Extension(class_name, extensions):
+    strongest = extensions[0]
+    strongest_strength = _extension_strength(strongest)
+    extension = strongest
+    score = strongest_strength
