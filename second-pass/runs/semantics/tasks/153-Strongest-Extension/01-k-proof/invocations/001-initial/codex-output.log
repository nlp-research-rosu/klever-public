+          vCons(str(E2:IntSeq),
+          vCons(str(E3:IntSeq), .ValSeq)))),
+        Name("extension"),
+        selectionLoopBody)
+      ~> CONT:K
+    =>
+      CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        ("class_name" |-> str(CLASS:IntSeq))
+        ("extensions" |-> list(ALL:ValSeq))
+        ("strongest" |-> str(BEST:IntSeq))
+        ("strongest_strength" |-> BESTS:Int)
+        ("extension" |-> str(LAST:IntSeq))
+        ("score" |-> extensionStrength(LAST)),
+        parent(0)))
+    =>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        ("class_name" |-> str(CLASS))
+        ("extensions" |-> list(ALL))
+        ("strongest" |->
+          str(bestExtension(
+            vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
+            BEST,
+            BESTS)))
+        ("strongest_strength" |->
+          bestStrength(
+            vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
+            BEST,
+            BESTS))
+        ("extension" |->
+          str(lastExtension(
+            vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
+            LAST)))
+        ("score" |->
+          extensionStrength(
+            lastExtension(
+              vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
+              LAST))),
