+  claim
+    <k>
+      #loop(list(EXTS:ValSeq), Name("extension"), selectionLoopBody)
+      ~> CONT:K
+    =>
+      CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
