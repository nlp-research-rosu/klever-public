+    </k>
+    <env> 1 </env>
+    <scopes>
+      (0 |-> MODULESCOPE:Scope)
+      (-1 |-> BUILTINSSCOPE:Scope)
+      (1 |-> scope(
+        ("class_name" |-> str(CLASS:IntSeq))
+        ("extensions" |-> list(ALL:ValSeq))
+        ("strongest" |-> str(BEST:IntSeq))
+        ("strongest_strength" |-> BESTS:Int)
+        ("extension" |-> str(LAST:IntSeq))
+        ("score" |-> SCORE:Int),
+        parent(0)))
+    =>
+      (0 |-> MODULESCOPE)
+      (-1 |-> BUILTINSSCOPE)
+      (1 |-> scope(
+        ("class_name" |-> str(CLASS))
+        ("extensions" |-> list(ALL))
+        ("strongest" |->
+          str(bestExtension(
+            vCons(str(CURRENT), extensionVals(NAMES)),
+            BEST,
+            BESTS)))
+        ("strongest_strength" |->
+          bestStrength(
+            vCons(str(CURRENT), extensionVals(NAMES)),
+            BEST,
+            BESTS))
+        ("extension" |->
+          str(lastExtension(
