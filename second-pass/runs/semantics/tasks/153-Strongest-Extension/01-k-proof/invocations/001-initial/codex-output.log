+    score += extension.count("J")
+    score += extension.count("K")
+    score += extension.count("L")
+    score += extension.count("M")
+    score += extension.count("N")
+    score += extension.count("O")
+    score += extension.count("P")
+    score += extension.count("Q")
+    score += extension.count("R")
+    score += extension.count("S")
+    score += extension.count("T")
+    score += extension.count("U")
+    score += extension.count("V")
+    score += extension.count("W")
+    score += extension.count("X")
+    score += extension.count("Y")
+    score += extension.count("Z")
+    score -= extension.count("a")
+    score -= extension.count("b")
+    score -= extension.count("c")
+    score -= extension.count("d")
+    score -= extension.count("e")
+    score -= extension.count("f")
+    score -= extension.count("g")
+    score -= extension.count("h")
+    score -= extension.count("i")
+    score -= extension.count("j")
+    score -= extension.count("k")
+    score -= extension.count("l")
+    score -= extension.count("m")
+    score -= extension.count("n")
+    score -= extension.count("o")
+    score -= extension.count("p")
+    score -= extension.count("q")
+    score -= extension.count("r")
+    score -= extension.count("s")
+    score -= extension.count("t")
+    score -= extension.count("u")
+    score -= extension.count("v")
+    score -= extension.count("w")
+    score -= extension.count("x")
+    score -= extension.count("y")
+    score -= extension.count("z")
+    return score
+
+
+def Strongest_Extension(class_name, extensions):
+    strongest = extensions[0]
+    strongest_strength = _extension_strength(strongest)
+    extension = strongest
+    score = strongest_strength
+    for extension in extensions:
+        score = _extension_strength(extension)
+        if score > strongest_strength:
+            strongest = extension
+            strongest_strength = score
+    return class_name + "." + strongest
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..eebf7528ded0a131ec29c3f5ab22c54d5f8f6c44
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,117 @@
+requires "verification.k"
+
+module STRONGEST-EXTENSION-SPEC
+  imports STRONGEST-EXTENSION-VERIFICATION
+
+  // The helper is proved in exactly the kind of caller frame in which the
+  // entry point invokes it.  The continuation and caller locals are arbitrary.
+  claim
+    <k>
+      Call(Name("_extension_strength"), str(CS:IntSeq))
+      ~> CONT:K
+    =>
+      extensionStrength(CS)
+      ~> CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (1 |-> scope(LOCALS:Map, parent(0)))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool ("_extension_strength" in_keys(LOCALS))
+    [label(extension-strength-correct)]
+
+  // Loop invariant.  The four explicit locals are initialized before the
+  // Python for-loop.  The RHS states the stable first-maximum fold and the
+  // final values of Python's loop variable and per-candidate score.
+  claim
+    <k>
+      #loop(
+        list(vCons(str(CURRENT:IntSeq), REST:ValSeq)),
+        Name("extension"),
+        selectionLoopBody)
+      ~> CONT:K
+    =>
+      CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        ("class_name" |-> str(CLASS:IntSeq))
+        ("extensions" |-> list(ALL:ValSeq))
+        ("strongest" |-> str(BEST:IntSeq))
+        ("strongest_strength" |-> BESTS:Int)
+        ("extension" |-> str(LAST:IntSeq))
+        ("score" |-> extensionStrength(LAST)),
+        parent(0)))
+    =>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        ("class_name" |-> str(CLASS))
+        ("extensions" |-> list(ALL))
+        ("strongest" |->
+          str(bestExtension(vCons(str(CURRENT), REST), BEST, BESTS)))
+        ("strongest_strength" |->
+          bestStrength(vCons(str(CURRENT), REST), BEST, BESTS))
+        ("extension" |->
+          str(lastExtension(vCons(str(CURRENT), REST), LAST)))
+        ("score" |->
+          extensionStrength(
+            lastExtension(vCons(str(CURRENT), REST), LAST))),
+        parent(0)))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allExtensionNames(REST)
+    [label(selection-loop-correct), circularity,
+     depends(extension-strength-correct)]
+
+  // Universal entry-point theorem for every ASCII class name and every
+  // nonempty finite list of ASCII extension-name strings.
+  claim
+    <k>
+      Call(
+        Name("Strongest_Extension"),
+        str(CLASS:IntSeq),
+        list(vCons(str(FIRST:IntSeq), REST:ValSeq)))
+    =>
+      str(seqConcat(
+        CLASS,
+        iCons(46,
+          bestExtension(
+            vCons(str(FIRST), REST),
+            FIRST,
+            extensionStrength(FIRST)))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allExtensionNames(REST)
+    [label(strongest-extension-correct),
+     depends(extension-strength-correct, selection-loop-correct)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..96010ca0fde348d78da080e766e0036718702567
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,148 @@
+requires "reference-semantics/semantics.k"
+
+module STRONGEST-EXTENSION-VERIFICATION
+  imports MPY
+
+  // The Python source uses one-character count calls.  These functions give
+  // their mathematical meaning: add the counts for ASCII A..Z, then subtract
+  // the counts for ASCII a..z.
+  syntax Int ::= extensionStrength(IntSeq) [function]
+               | upperStrength(IntSeq, Int, Int) [function]
+               | lowerStrength(IntSeq, Int, Int) [function]
+
+  rule extensionStrength(CS:IntSeq) => upperStrength(CS, 65, 0)
+  rule upperStrength(CS:IntSeq, C:Int, ACC:Int)
+    => upperStrength(CS, C +Int 1, ACC +Int cntSub(CS, iCons(C, .IntSeq)))
+    requires C <=Int 90
+  rule upperStrength(CS:IntSeq, C:Int, ACC:Int)
+    => lowerStrength(CS, 97, ACC)
+    requires C >Int 90
+  rule lowerStrength(CS:IntSeq, C:Int, ACC:Int)
+    => lowerStrength(CS, C +Int 1, ACC -Int cntSub(CS, iCons(C, .IntSeq)))
+    requires C <=Int 122
+  rule lowerStrength(_:IntSeq, C:Int, ACC:Int) => ACC
+    requires C >Int 122
+
+  // Recursive, stable first-maximum specification.  Keeping the best value
+  // and its score as separate functions makes the strict-greater tie rule
+  // explicit.
+  syntax IntSeq ::= bestExtension(ValSeq, IntSeq, Int) [function]
+                  | lastExtension(ValSeq, IntSeq) [function]
+  syntax Int ::= bestStrength(ValSeq, IntSeq, Int) [function]
+
+  rule bestExtension(.ValSeq, BEST:IntSeq, _:Int) => BEST
+  rule bestExtension(vCons(str(CS:IntSeq), REST:ValSeq), _:IntSeq, BS:Int)
+    => bestExtension(REST, CS, extensionStrength(CS))
+    requires extensionStrength(CS) >Int BS
+  rule bestExtension(vCons(str(CS:IntSeq), REST:ValSeq), BEST:IntSeq, BS:Int)
+    => bestExtension(REST, BEST, BS)
+    requires extensionStrength(CS) <=Int BS
+
+  rule bestStrength(.ValSeq, _:IntSeq, BS:Int) => BS
+  rule bestStrength(vCons(str(CS:IntSeq), REST:ValSeq), _:IntSeq, BS:Int)
+    => bestStrength(REST, CS, extensionStrength(CS))
+    requires extensionStrength(CS) >Int BS
+  rule bestStrength(vCons(str(CS:IntSeq), REST:ValSeq), BEST:IntSeq, BS:Int)
+    => bestStrength(REST, BEST, BS)
+    requires extensionStrength(CS) <=Int BS
+
+  rule lastExtension(.ValSeq, PREV:IntSeq) => PREV
+  rule lastExtension(vCons(str(CS:IntSeq), REST:ValSeq), _:IntSeq)
+    => lastExtension(REST, CS)
+
+  syntax Bool ::= allExtensionNames(ValSeq) [function, total]
+  rule allExtensionNames(.ValSeq) => true
+  rule allExtensionNames(vCons(V:Val, REST:ValSeq))
+    => isStrV(V) andBool allExtensionNames(REST)
+
+  // Exact statement bodies generated from solution.py.  Naming them keeps the
+  // configurations and claims readable while retaining the actual MPY AST.
+  syntax Stmts ::= "extensionStrengthBody" [function]
+                 | "selectionLoopBody" [function]
+                 | "strongestExtensionBody" [function]
+
+  rule extensionStrengthBody =>
+    Assign(Name("score"), Int(0))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("A")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("B")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("C")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("D")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("E")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("F")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("G")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("H")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("I")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("J")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("K")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("L")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("M")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("N")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("O")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("P")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("Q")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("R")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("S")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("T")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("U")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("V")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("W")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("X")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("Y")))
+    AugAssign(Name("score"), "+", Call(Attribute(Name("extension"), "count"), Str("Z")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("a")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("b")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("c")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("d")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("e")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("f")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("g")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("h")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("i")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("j")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("k")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("l")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("m")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("n")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("o")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("p")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("q")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("r")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("s")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("t")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("u")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("v")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("w")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("x")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("y")))
+    AugAssign(Name("score"), "-", Call(Attribute(Name("extension"), "count"), Str("z")))
+    Return(Name("score"))
+
+  rule selectionLoopBody =>
+    Assign(Name("score"), Call(Name("_extension_strength"), Name("extension")))
+    If(Compare(Name("score"), CmpOp(">", Name("strongest_strength"))),
+      Assign(Name("strongest"), Name("extension"))
+      Assign(Name("strongest_strength"), Name("score")),
+      .Stmts)
+
+  rule strongestExtensionBody =>
+    Assign(Name("strongest"), Subscript(Name("extensions"), Int(0)))
+    Assign(Name("strongest_strength"),
+      Call(Name("_extension_strength"), Name("strongest")))
+    Assign(Name("extension"), Name("strongest"))
+    Assign(Name("score"), Name("strongest_strength"))
+    For(Name("extension"), Name("extensions"), selectionLoopBody)
+    Return(BinOp("+",
+      BinOp("+", Name("class_name"), Str(".")),
+      Name("strongest")))
+
+  syntax Scope ::= "solutionScope" [function]
+  rule solutionScope =>
+    scope(
+      .Map
+        [ "_extension_strength" <-
+          closureVal(("extension", .ParamNames), extensionStrengthBody, 0) ]
+        [ "Strongest_Extension" <-
+          closureVal(("class_name", "extensions", .ParamNames),
+                     strongestExtensionBody, 0) ],
+      parent(-1))
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module STRONGEST-EXTENSION-SPEC --claims selection-loop-correct --output pretty' in /work
