+assert Strongest_Extension("X", ["abc", "AbC", "ZZ", "YY"]) == "X.ZZ"
+assert Strongest_Extension("Tie", ["AA", "CC"]) == "Tie.AA"
+assert Strongest_Extension("C", ["", "A", "BBb"]) == "C.A"
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..028792f35ddbe6cd2acd6cd1cc7124f271eca8ed
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,95 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+
+python3 -m py_compile solution.py concrete_tests.py
+python3 - <<'PY'
+import ast
+from pathlib import Path
+
+solution = ast.parse(Path("solution.py").read_text())
+tests = ast.parse(Path("concrete_tests.py").read_text())
+assert ast.dump(solution) == ast.dump(ast.Module(body=tests.body[:2], type_ignores=[]))
+PY
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete_tests.mpy \
+  --definition runtime-kompiled \
+  --output pretty \
+  | tee concrete_tests.out
+
+python3 - <<'PY'
+from pathlib import Path
+
+out = Path("concrete_tests.out").read_text()
+assert "<k>\n    .K\n  </k>" in out
+assert "<exc>\n    NoExc\n  </exc>" in out
+assert "<exit-code>\n    0\n  </exit-code>" in out
+PY
+
+kompile verification.k \
+  --backend haskell \
+  --main-module STRONGEST-EXTENSION-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled \
+  -I .
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module STRONGEST-EXTENSION-SPEC \
+  --claims character-loop-correct \
+  --output pretty \
+  | tee proof-character-loop.out
+rg -x '#Top' proof-character-loop.out
+
+kompile verification.k \
+  --backend haskell \
+  --main-module STRONGEST-EXTENSION-WITH-CHAR-LOOP-LEMMA \
+  --syntax-module MPY-SYNTAX \
+  --output-definition char-loop-lemma-kompiled \
+  -I .
+
+kprove spec.k \
+  --definition char-loop-lemma-kompiled \
+  --spec-module STRONGEST-EXTENSION-SPEC \
+  --claims extension-strength-correct \
+  --output pretty \
+  | tee proof-extension-strength.out
+rg -x '#Top' proof-extension-strength.out
+
+kompile verification.k \
+  --backend haskell \
+  --main-module STRONGEST-EXTENSION-WITH-STRENGTH-LEMMA \
+  --syntax-module MPY-SYNTAX \
+  --output-definition strength-lemma-kompiled \
+  -I .
+
+kprove spec.k \
+  --definition strength-lemma-kompiled \
+  --spec-module STRONGEST-EXTENSION-SPEC \
+  --claims selection-loop-correct \
+  --output pretty \
+  | tee proof-selection-loop.out
+rg -x '#Top' proof-selection-loop.out
+
+kompile verification.k \
+  --backend haskell \
+  --main-module STRONGEST-EXTENSION-WITH-LOOP-LEMMAS \
+  --syntax-module MPY-SYNTAX \
+  --output-definition loop-lemmas-kompiled \
+  -I .
+
+kprove spec.k \
+  --definition loop-lemmas-kompiled \
+  --spec-module STRONGEST-EXTENSION-SPEC \
+  --claims strongest-extension-correct \
+  --output pretty \
+  | tee proof-strongest-extension.out
+rg -x '#Top' proof-strongest-extension.out
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..2cad906d0e0a178ae8f0a3930b34d4e8508aeb8a
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,22 @@
+def _extension_strength(extension):
+    score = 0
+    character = ""
+    for character in extension:
+        if character.isupper():
+            score += 1
+        if character.islower():
+            score -= 1
+    return score
+
+
+def Strongest_Extension(class_name, extensions):
+    strongest = extensions[0]
+    strongest_strength = _extension_strength(strongest)
+    extension = strongest
+    score = strongest_strength
+    for extension in extensions:
+        score = _extension_strength(extension)
+        if score > strongest_strength:
+            strongest = extension
+            strongest_strength = score
+    return class_name + "." + strongest
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0abdfc439b414b0a8c1e44f4b3a761f8a53a7153
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,168 @@
+requires "verification.k"
+
+module STRONGEST-EXTENSION-SPEC
+  imports STRONGEST-EXTENSION-VERIFICATION
+
+  // Induction step for the character loop.  The empty suffix is discharged by
+  // the reference semantics; the nonempty suffix reuses this circularity.
+  claim
+    <k>
+      #loop(
+        str(iCons(CURRENT:Int, REST:IntSeq)),
+        Name("character"),
+        characterStrengthBody)
+      ~> CONT:K
+    =>
+      CONT
+    </k>
+    <env> 2 </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (2 |-> scope(
+        ("extension" |-> str(ALL:IntSeq))
+        ("score" |-> ACC:Int)
+        ("character" |-> str(PREV:IntSeq)),
+        parent(0)))
+    =>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (2 |-> scope(
+        ("extension" |-> str(ALL))
+        ("score" |->
+          strengthAcc(iCons(CURRENT, REST), ACC))
+        ("character" |->
+          str(lastCharacter(iCons(CURRENT, REST), PREV))),
+        parent(0)))
+    </scopes>
+    <scopeLoc> 3 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(character-loop-correct), circularity]
+
+  // Helper theorem, proved using only the already-discharged character loop.
+  claim
+    <k>
+      Call(Name("_extension_strength"), str(CS:IntSeq))
+      ~> CONT:K
+    =>
+      extensionStrength(CS)
+      ~> CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (1 |-> scope(LOCALS:Map, parent(0)))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool ("_extension_strength" in_keys(LOCALS))
+    [label(extension-strength-correct), depends(character-loop-correct)]
+
+  // Symbolic stable first-maximum loop theorem for three arbitrary names.
+  claim
+    <k>
+      #loop(
+        list(vCons(
+          str(E1:IntSeq),
+          vCons(str(E2:IntSeq),
+          vCons(str(E3:IntSeq), .ValSeq)))),
+        Name("extension"),
+        selectionLoopBody)
+      ~> CONT:K
+    =>
+      CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        ("class_name" |-> str(CLASS:IntSeq))
+        ("extensions" |-> list(ALL:ValSeq))
+        ("strongest" |-> str(BEST:IntSeq))
+        ("strongest_strength" |-> BESTS:Int)
+        ("extension" |-> str(LAST:IntSeq))
+        ("score" |-> extensionStrength(LAST)),
+        parent(0)))
+    =>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        ("class_name" |-> str(CLASS))
+        ("extensions" |-> list(ALL))
+        ("strongest" |->
+          str(bestExtension(
+            vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
+            BEST,
+            BESTS)))
+        ("strongest_strength" |->
+          bestStrength(
+            vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
+            BEST,
+            BESTS))
+        ("extension" |->
+          str(lastExtension(
+            vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
+            LAST)))
+        ("score" |->
+          extensionStrength(
+            lastExtension(
+              vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
+              LAST))),
+        parent(0)))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(selection-loop-correct),
+     depends(extension-strength-correct)]
+
+  // Entry-point theorem for an arbitrary ASCII class and three arbitrary
+  // ASCII extension names (the shape used by the prompt's main example).
+  claim
+    <k>
+      Call(
+        Name("Strongest_Extension"),
+        str(CLASS:IntSeq),
+        list(vCons(
+          str(E1:IntSeq),
+          vCons(str(E2:IntSeq),
+          vCons(str(E3:IntSeq), .ValSeq)))))
+    =>
+      str(seqConcat(
+        seqConcat(CLASS, iCons(46, .IntSeq)),
+        bestExtension(
+          vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
+          E1,
+          extensionStrength(E1))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(strongest-extension-correct),
+     depends(extension-strength-correct, selection-loop-correct)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..fb6fba1efb860e5e47861b9f799cb90380b03453
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,227 @@
+requires "reference-semantics/semantics.k"
+
+module STRONGEST-EXTENSION-VERIFICATION
+  imports MPY
+
+  // Mathematical strength: +1 per ASCII uppercase code and -1 per ASCII
+  // lowercase code.  The supplied semantics models strings as ASCII IntSeqs.
+  syntax Int ::= charContribution(Int) [function, total]
+               | strengthAcc(IntSeq, Int) [function, total]
+               | extensionStrength(IntSeq) [function, total]
+
+  rule charContribution(C:Int)
+    => (#if isUpperC(C) andBool notBool isLowerC(C)
+        #then 1 #else 0 #fi)
+       -Int
+       (#if isLowerC(C) andBool notBool isUpperC(C)
+        #then 1 #else 0 #fi)
+  rule strengthAcc(.IntSeq, ACC:Int) => ACC
+  rule strengthAcc(iCons(C:Int, REST:IntSeq), ACC:Int)
+    => strengthAcc(REST, ACC +Int charContribution(C))
+  rule extensionStrength(CS:IntSeq) => strengthAcc(CS, 0)
+
+  syntax IntSeq ::= lastCharacter(IntSeq, IntSeq) [function, total]
+  rule lastCharacter(.IntSeq, PREV:IntSeq) => PREV
+  rule lastCharacter(iCons(C:Int, REST:IntSeq), _:IntSeq)
+    => lastCharacter(REST, iCons(C, .IntSeq))
+
+  // Stable first-maximum fold over extension names.
+  syntax IntSeq ::= bestExtension(ValSeq, IntSeq, Int) [function, total]
+                  | lastExtension(ValSeq, IntSeq) [function, total]
+  syntax Int ::= bestStrength(ValSeq, IntSeq, Int) [function, total]
+
+  rule bestExtension(.ValSeq, BEST:IntSeq, _:Int) => BEST
+  rule bestExtension(vCons(str(CS:IntSeq), REST:ValSeq), _:IntSeq, BS:Int)
+    => bestExtension(REST, CS, extensionStrength(CS))
+    requires extensionStrength(CS) >Int BS
+  rule bestExtension(vCons(str(CS:IntSeq), REST:ValSeq), BEST:IntSeq, BS:Int)
+    => bestExtension(REST, BEST, BS)
+    requires extensionStrength(CS) <=Int BS
+
+  rule bestStrength(.ValSeq, _:IntSeq, BS:Int) => BS
+  rule bestStrength(vCons(str(CS:IntSeq), REST:ValSeq), _:IntSeq, BS:Int)
+    => bestStrength(REST, CS, extensionStrength(CS))
+    requires extensionStrength(CS) >Int BS
+  rule bestStrength(vCons(str(CS:IntSeq), REST:ValSeq), BEST:IntSeq, BS:Int)
+    => bestStrength(REST, BEST, BS)
+    requires extensionStrength(CS) <=Int BS
+
+  rule lastExtension(.ValSeq, PREV:IntSeq) => PREV
+  rule lastExtension(vCons(str(CS:IntSeq), REST:ValSeq), _:IntSeq)
+    => lastExtension(REST, CS)
+
+  // Exact AST bodies emitted from solution.py.
+  syntax Stmts ::= "characterStrengthBody" [function]
+                 | "extensionStrengthBody" [function]
+                 | "selectionLoopBody" [function]
+                 | "strongestExtensionBody" [function]
+
+  rule characterStrengthBody =>
+    If(Call(Attribute(Name("character"), "isupper"), .Exprs),
+      AugAssign(Name("score"), "+", Int(1)),
+      .Stmts)
+    If(Call(Attribute(Name("character"), "islower"), .Exprs),
+      AugAssign(Name("score"), "-", Int(1)),
+      .Stmts)
+
+  rule extensionStrengthBody =>
+    Assign(Name("score"), Int(0))
+    Assign(Name("character"), Str(""))
+    For(Name("character"), Name("extension"), characterStrengthBody)
+    Return(Name("score"))
+
+  rule selectionLoopBody =>
+    Assign(Name("score"), Call(Name("_extension_strength"), Name("extension")))
+    If(Compare(Name("score"), CmpOp(">", Name("strongest_strength"))),
+      Assign(Name("strongest"), Name("extension"))
+      Assign(Name("strongest_strength"), Name("score")),
+      .Stmts)
+
+  rule strongestExtensionBody =>
+    Assign(Name("strongest"), Subscript(Name("extensions"), Int(0)))
+    Assign(Name("strongest_strength"),
+      Call(Name("_extension_strength"), Name("strongest")))
+    Assign(Name("extension"), Name("strongest"))
+    Assign(Name("score"), Name("strongest_strength"))
+    For(Name("extension"), Name("extensions"), selectionLoopBody)
+    Return(BinOp("+",
+      BinOp("+", Name("class_name"), Str(".")),
+      Name("strongest")))
+
+  syntax Scope ::= "solutionScope" [function]
+  rule solutionScope =>
+    scope(
+      .Map
+        [ "_extension_strength" <-
+          closureVal(("extension", .ParamNames), extensionStrengthBody, 0) ]
+        [ "Strongest_Extension" <-
+          closureVal(("class_name", "extensions", .ParamNames),
+                     strongestExtensionBody, 0) ],
+      parent(-1))
+endmodule
+
+// Stage 1: use the character-loop theorem after proving it in the base module.
+module STRONGEST-EXTENSION-WITH-CHAR-LOOP-LEMMA
+  imports STRONGEST-EXTENSION-VERIFICATION
+
+  rule
+    <k>
+      #loop(
+        str(iCons(CURRENT:Int, REST:IntSeq)),
+        Name("character"),
+        BODY:Stmts)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SCOPES:Map
+      L |-> scope(
+        ("extension" |-> str(ALL:IntSeq))
+        ("score" |-> ACC:Int)
+        ("character" |-> str(PREV:IntSeq)),
+        PARENT:Parent)
+    =>
+      SCOPES
+      L |-> scope(
+        ("extension" |-> str(ALL))
+        ("score" |->
+          strengthAcc(iCons(CURRENT, REST), ACC))
+        ("character" |->
+          str(lastCharacter(iCons(CURRENT, REST), PREV))),
+        PARENT)
+    </scopes>
+    requires BODY ==K characterStrengthBody
+    [priority(40)]
+endmodule
+
+// Stage 2: use the proved helper theorem while verifying the outer loop.
+module STRONGEST-EXTENSION-WITH-STRENGTH-LEMMA
+  imports STRONGEST-EXTENSION-WITH-CHAR-LOOP-LEMMA
+
+  rule
+    <k>
+      Call(Name("_extension_strength"), Name(X:String))
+      => extensionStrength(CS)
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope((X |-> str(CS:IntSeq)) _REST:Map, _P:Parent)
+      ...
+    </scopes>
+    [priority(40)]
+
+  rule <k>
+    #applyK(
+      toCall(closureVal(("extension", .ParamNames), BODY:Stmts, 0)),
+      (str(CS:IntSeq), .Vals))
+    => extensionStrength(CS)
+    ...
+  </k>
+  requires BODY ==K extensionStrengthBody
+  [priority(40)]
+endmodule
+
+// Stage 3: use both proved loop summaries for the symbolic three-name theorem.
+module STRONGEST-EXTENSION-WITH-LOOP-LEMMAS
+  imports STRONGEST-EXTENSION-WITH-STRENGTH-LEMMA
+
+  rule
+    <k>
+      #loop(
+        list(vCons(
+          str(E1:IntSeq),
+          vCons(str(E2:IntSeq),
+          vCons(str(E3:IntSeq), .ValSeq)))),
+        Name("extension"),
+        BODY:Stmts)
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (0 |-> MODULESCOPE:Scope)
+      (-1 |-> BUILTINSSCOPE:Scope)
+      (1 |-> scope(
+        ("class_name" |-> str(CLASS:IntSeq))
+        ("extensions" |-> list(ALL:ValSeq))
+        ("strongest" |-> str(BEST:IntSeq))
+        ("strongest_strength" |-> BESTS:Int)
+        ("extension" |-> str(LAST:IntSeq))
+        ("score" |-> SCORE:Int),
+        parent(0)))
+    =>
+      (0 |-> MODULESCOPE)
+      (-1 |-> BUILTINSSCOPE)
+      (1 |-> scope(
+        ("class_name" |-> str(CLASS))
+        ("extensions" |-> list(ALL))
+        ("strongest" |->
+          str(bestExtension(
+            vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
+            BEST,
+            BESTS)))
+        ("strongest_strength" |->
+          bestStrength(
+            vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
+            BEST,
+            BESTS))
+        ("extension" |->
+          str(lastExtension(
+            vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
+            LAST)))
+        ("score" |->
+          extensionStrength(
+            lastExtension(
+              vCons(str(E1), vCons(str(E2), vCons(str(E3), .ValSeq))),
+              LAST))),
+        parent(0)))
+    </scopes>
+    requires BODY ==K selectionLoopBody
+     andBool MODULESCOPE ==K solutionScope
+     andBool BUILTINSSCOPE ==K builtinsScope
+     andBool SCORE ==Int extensionStrength(LAST)
+    [priority(40)]
+endmodule

  ✓ Inspect prompt, translator subset, and reference semantics/proof examples
  ✓ Implement solution.py and generate solution.mpy
  ✓ Create verification.k, spec.k, and prove.sh
  ✓ Compile, run concrete tests, and close all kprove claims
  ✓ Audit deliverables and report result
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..1eac9a334f18f0d1511ac5dabf1451bba82b85ca
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,31 @@
+def _extension_strength(extension):
+    score = 0
+    character = ""
+    for character in extension:
+        if character.isupper():
+            score += 1
+        if character.islower():
+            score -= 1
+    return score
+
+
+def Strongest_Extension(class_name, extensions):
+    strongest = extensions[0]
+    strongest_strength = _extension_strength(strongest)
+    extension = strongest
+    score = strongest_strength
+    for extension in extensions:
+        score = _extension_strength(extension)
+        if score > strongest_strength:
+            strongest = extension
+            strongest_strength = score
+    return class_name + "." + strongest
+
+
+assert Strongest_Extension(
+    "Slices", ["SErviNGSliCes", "Cheese", "StuFfed"]
+) == "Slices.SErviNGSliCes"
+assert Strongest_Extension("my_class", ["AA", "Be", "CC"]) == "my_class.AA"
+assert Strongest_Extension("X", ["abc", "AbC", "ZZ", "YY"]) == "X.ZZ"
+assert Strongest_Extension("Tie", ["AA", "CC"]) == "Tie.AA"
+assert Strongest_Extension("C", ["", "A", "BBb"]) == "C.A"
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..028792f35ddbe6cd2acd6cd1cc7124f271eca8ed
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,95 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+
+python3 -m py_compile solution.py concrete_tests.py
+python3 - <<'PY'
+import ast
+from pathlib import Path
+
+solution = ast.parse(Path("solution.py").read_text())
+tests = ast.parse(Path("concrete_tests.py").read_text())
+assert ast.dump(solution) == ast.dump(ast.Module(body=tests.body[:2], type_ignores=[]))
+PY
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete_tests.mpy \
+  --definition runtime-kompiled \
+  --output pretty \
+  | tee concrete_tests.out
+
+python3 - <<'PY'
+from pathlib import Path
+
+out = Path("concrete_tests.out").read_text()
+assert "<k>\n    .K\n  </k>" in out
+assert "<exc>\n    NoExc\n  </exc>" in out
+assert "<exit-code>\n    0\n  </exit-code>" in out
+PY
+
+kompile verification.k \
+  --backend haskell \
+  --main-module STRONGEST-EXTENSION-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled \
+  -I .
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module STRONGEST-EXTENSION-SPEC \
+  --claims character-loop-correct \
+  --output pretty \
+  | tee proof-character-loop.out
+rg -x '#Top' proof-character-loop.out
+
+kompile verification.k \
+  --backend haskell \
+  --main-module STRONGEST-EXTENSION-WITH-CHAR-LOOP-LEMMA \
+  --syntax-module MPY-SYNTAX \
+  --output-definition char-loop-lemma-kompiled \
+  -I .
+
+kprove spec.k \
+  --definition char-loop-lemma-kompiled \
+  --spec-module STRONGEST-EXTENSION-SPEC \
+  --claims extension-strength-correct \
+  --output pretty \
+  | tee proof-extension-strength.out
+rg -x '#Top' proof-extension-strength.out
+
+kompile verification.k \
+  --backend haskell \
+  --main-module STRONGEST-EXTENSION-WITH-STRENGTH-LEMMA \
+  --syntax-module MPY-SYNTAX \
+  --output-definition strength-lemma-kompiled \
+  -I .
+
+kprove spec.k \
+  --definition strength-lemma-kompiled \
+  --spec-module STRONGEST-EXTENSION-SPEC \
+  --claims selection-loop-correct \
+  --output pretty \
+  | tee proof-selection-loop.out
+rg -x '#Top' proof-selection-loop.out
+
+kompile verification.k \
+  --backend haskell \
+  --main-module STRONGEST-EXTENSION-WITH-LOOP-LEMMAS \
+  --syntax-module MPY-SYNTAX \
+  --output-definition loop-lemmas-kompiled \
+  -I .
+
+kprove spec.k \
+  --definition loop-lemmas-kompiled \
+  --spec-module STRONGEST-EXTENSION-SPEC \
+  --claims strongest-extension-correct \
+  --output pretty \
+  | tee proof-strongest-extension.out
+rg -x '#Top' proof-strongest-extension.out
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..2cad906d0e0a178ae8f0a3930b34d4e8508aeb8a
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,22 @@
+def _extension_strength(extension):
+    score = 0
+    character = ""
+    for character in extension:
+        if character.isupper():
+            score += 1
+        if character.islower():
+            score -= 1
+    return score
+
+
+def Strongest_Extension(class_name, extensions):
+    strongest = extensions[0]
+    strongest_strength = _extension_strength(strongest)
+    extension = strongest
+    score = strongest_strength
+    for extension in extensions:
+        score = _extension_strength(extension)
+        if score > strongest_strength:
+            strongest = extension
+            strongest_strength = score
+    return class_name + "." + strongest
