+          bestStrength(vCons(str(CURRENT), REST), BEST, BESTS))
+        ("extension" |->
+          str(lastExtension(vCons(str(CURRENT), REST), LAST)))
+        ("score" |->
+          extensionStrength(
+            lastExtension(vCons(str(CURRENT), REST), LAST))),
+        parent(0)))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allExtensionNames(REST)
+    [label(selection-loop-correct), circularity,
+     depends(extension-strength-correct)]
+
+  // Universal entry-point theorem for every ASCII class name and every
+  // nonempty finite list of ASCII extension-name strings.
+  claim
+    <k>
+      Call(
+        Name("Strongest_Extension"),
+        str(CLASS:IntSeq),
+        list(vCons(str(FIRST:IntSeq), REST:ValSeq)))
+    =>
+      str(seqConcat(
+        CLASS,
+        iCons(46,
+          bestExtension(
+            vCons(str(FIRST), REST),
+            FIRST,
+            extensionStrength(FIRST)))))
