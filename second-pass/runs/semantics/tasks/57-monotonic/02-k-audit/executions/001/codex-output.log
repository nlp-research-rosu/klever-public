+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+run command -v kompile
+run command -v kprove
+run command -v krun
+run kompile --version
+run kprove --version
+
+run cp /audit-output/evidence/03_spec_claim_1.k "$WORK/spec-claim-1.k"
+run cp /audit-output/evidence/03_spec_claim_2.k "$WORK/spec-claim-2.k"
