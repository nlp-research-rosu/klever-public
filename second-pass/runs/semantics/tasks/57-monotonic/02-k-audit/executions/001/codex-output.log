diff --git a/evidence/04_ground_entry_spec.k b/evidence/04_ground_entry_spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..48970784664c4843978cb387da0655a07c4b059d
--- /dev/null
+++ b/evidence/04_ground_entry_spec.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module GROUND-ENTRY-SPEC
+  imports MONOTONIC-VERIFICATION
+
+  claim [ascending-ground]:
+    <k>
+      #loadAll(monotonicProgram)
+      ~> Call(
+           Name("monotonic"),
+           list(vCons(1, vCons(2, vCons(2, .ValSeq))))
+         )
