diff --git a/evidence/07_evidence_manifest.sh b/evidence/07_evidence_manifest.sh
new file mode 100644
index 0000000000000000000000000000000000000000..ee61aa72e4a649484ee982f44343f93711264a44
--- /dev/null
+++ b/evidence/07_evidence_manifest.sh
@@ -0,0 +1,9 @@
+#!/usr/bin/env bash
+set -o pipefail
+
+find /audit-output/evidence -maxdepth 1 -type f \
+  ! -name '07_evidence_manifest.txt' \
+  ! -name '07_evidence_manifest.log' \
+  -print0 \
+  | sort -z \
+  | xargs -0 sha256sum

exec
/bin/bash -lc 'chmod +x /audit-output/evidence/07_evidence_manifest.sh
/audit-output/evidence/07_evidence_manifest.sh > /audit-output/evidence/07_evidence_manifest.txt
