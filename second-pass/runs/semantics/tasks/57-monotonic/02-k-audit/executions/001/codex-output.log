    27	                     Name("sorted"),
    28	                     Name("l"),
    29	                     KwArg("reverse", Bool(true))
    30	                   )
    31	                 )
    32	               )
    33	             )
    34	           )
    35	         )
    36	       )
    37	
    38	  // Independent, executable definitions of the two adjacent-element order
    39	  // predicates. These equations also document that equality is permitted.
    40	  syntax Bool ::= nondecreasing(ValSeq) [function, total]
    41	                | nonincreasing(ValSeq) [function, total]
    42	  rule nondecreasing(.ValSeq) => true
    43	  rule nondecreasing(vCons(_:Val, .ValSeq)) => true
    44	  rule nondecreasing(vCons(A:Val, vCons(B:Val, REST:ValSeq)))
    45	    => applyCmp("<=", A, B) andBool nondecreasing(vCons(B, REST))
    46	
    47	  rule nonincreasing(.ValSeq) => true
    48	  rule nonincreasing(vCons(_:Val, .ValSeq)) => true
    49	  rule nonincreasing(vCons(A:Val, vCons(B:Val, REST:ValSeq)))
    50	    => applyCmp(">=", A, B) andBool nonincreasing(vCons(B, REST))
    51	
    52	  // sortVS is explicitly a trusted ascending-sort abstraction in the supplied
    53	  // semantics. sortEquality is a proof-only equality summary, introduced at
    54	  // the same Compare point where MPY-LIST would otherwise use opaque ==K.
    55	  syntax Bool ::= sortEquality(ValSeq, ValSeq)
    56	                  [function, total, symbol(sortEquality), no-evaluators]
    57	  rule <k>
    58	         Compare(list(A:ValSeq), CmpOp("==", list(B:ValSeq)))
    59	         => sortEquality(A, B)
    60	       ... </k>
    61	       [priority(45)]
    62	  rule sortEquality(VS:ValSeq, sortVS(VS))
    63	    => nondecreasing(VS)
    64	    [simplification]
    65	  // revVS unfolds once to revVSAcc before the equality summary sees it.
    66	  rule sortEquality(
    67	         VS:ValSeq,
    68	         revVSAcc(sortVS(VS), .ValSeq)
    69	       )
    70	    => nonincreasing(VS)
    71	    [simplification]
    72	
    73	  // The natural-language contract: either adjacent order may hold.
    74	  syntax Bool ::= isMonotonic(ValSeq) [function, total]
    75	  rule isMonotonic(VS:ValSeq)
    76	    => nondecreasing(VS) orBool nonincreasing(VS)
    77	endmodule

