+requires "verification.k"
+
+module GROUND-ENTRY-SPEC
+  imports MONOTONIC-VERIFICATION
+
+  claim [ascending-ground]:
+    <k>
+      #loadAll(monotonicProgram)
+      ~> Call(
+           Name("monotonic"),
+           list(vCons(1, vCons(2, vCons(2, .ValSeq))))
+         )
