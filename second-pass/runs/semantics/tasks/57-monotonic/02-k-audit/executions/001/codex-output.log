diff --git a/evidence/04_bridge_connection_spec.k b/evidence/04_bridge_connection_spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2af084ee94f2987c503724c03e1275525339fd0a
--- /dev/null
+++ b/evidence/04_bridge_connection_spec.k
@@ -0,0 +1,44 @@
+requires "verification-no-bridge.k"
+
+module BRIDGE-CONNECTION-SPEC
+  imports MONOTONIC-VERIFICATION-NO-BRIDGE
+
+  claim [ascending-connection]:
+    <k>
+      Compare(list(VS:ValSeq), CmpOp("==", list(sortVS(VS))))
+      => nondecreasing(VS)
+    </k>
+    <env> 0 </env>
