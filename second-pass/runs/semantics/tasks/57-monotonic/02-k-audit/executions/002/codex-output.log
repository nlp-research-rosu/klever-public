+    <k>
+      #loadAll(monotonicProgram)
+      ~> Call(Name("monotonic"), list(VS:ValSeq))
+      => true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0  |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      => ?FINALSCOPES:Map
