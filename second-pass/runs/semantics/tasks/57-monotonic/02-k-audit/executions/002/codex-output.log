diff --git a/evidence/connection-verification.k b/evidence/connection-verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b7d419311565ff1df50b6902c4c1e98728511b86
--- /dev/null
+++ b/evidence/connection-verification.k
@@ -0,0 +1,12 @@
+requires "reference-semantics/semantics.k"
+
+module CONNECTION-VERIFICATION
+  imports MPY
+
+  syntax Bool ::= connectionNondecreasing(ValSeq) [function, total]
+  rule connectionNondecreasing(.ValSeq) => true
+  rule connectionNondecreasing(vCons(_:Val, .ValSeq)) => true
+  rule connectionNondecreasing(vCons(A:Val, vCons(B:Val, REST:ValSeq)))
+    => applyCmp("<=", A, B)
+       andBool connectionNondecreasing(vCons(B, REST))
+endmodule
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
