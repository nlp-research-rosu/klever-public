diff --git a/evidence/spec-no-bridge.k b/evidence/spec-no-bridge.k
new file mode 100644
index 0000000000000000000000000000000000000000..2e56441dd96d34745a823c8d99c1030f67191391
--- /dev/null
+++ b/evidence/spec-no-bridge.k
@@ -0,0 +1,47 @@
+requires "verification-no-bridge.k"
+
