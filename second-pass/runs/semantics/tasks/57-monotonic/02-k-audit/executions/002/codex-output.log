diff --git a/evidence/spec-claim2.k b/evidence/spec-claim2.k
new file mode 100644
index 0000000000000000000000000000000000000000..2a07ab14d69689999665032a148156701f3899dc
--- /dev/null
+++ b/evidence/spec-claim2.k
@@ -0,0 +1,26 @@
+requires "verification.k"
+
+module MONOTONIC-SPEC-CLAIM2
+  imports MONOTONIC-VERIFICATION
+
+  claim
+    <k>
+      #loadAll(monotonicProgram)
+      ~> Call(Name("monotonic"), list(VS:ValSeq))
+      => nonincreasing(VS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0  |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      => ?FINALSCOPES:Map
