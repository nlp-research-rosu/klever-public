Module(
  FuncDef("triangle_area", Params("a", "h"),
    Return(BinOp("/", BinOp("*", Name("a"), Name("h")), Int(2))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(5), Int(3)),
      CmpOp("==", Float(7.5))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(0), Int(0)),
      CmpOp("==", Float(0.0))))
  Assert(
    Compare(
      Call(Name("triangle_area"), UnaryOp("-", Int(3)), Int(6)),
      CmpOp("==", UnaryOp("-", Float(9.0)))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(3), Int(3)),
      CmpOp("==", Float(4.5))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(9007199254740991), Int(2)),
      CmpOp("==", Float(9007199254740991.0)))))
