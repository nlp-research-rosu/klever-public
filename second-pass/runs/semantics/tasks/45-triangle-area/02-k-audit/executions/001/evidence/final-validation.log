COMMAND: bash -c $'set -e\nreview=/audit-output/REVIEW.md\ntest "$(tail -n 2 "$review")" = $\'VERDICT: FAIL\\nLEGITIMACY: NOT_LEGIT\'\ntest "$(rg -c "^VERDICT:" "$review")" -eq 1\ntest "$(rg -c "^LEGITIMACY:" "$review")" -eq 1\nfor f in stage1-integrity.log translation-regeneration.log differential.log kompile-runtime.log kompile-verification.log kprove-positive.log k-rule-inventory.md static-path-analysis.md vacuity-build.log vacuity-proof.log python-division-scaling-boundary.log krun-division-scaling-boundary.log; do test -s "/audit-output/evidence/$f"; done\nbash -n /audit-output/evidence/run_logged.sh\npython3 -m py_compile /audit-output/evidence/differential_triangle_area.py /audit-output/evidence/inventory_k.py /audit-output/evidence/ground_witness_compare.py\nsha256sum "$review"\ntail -n 2 "$review"'
WORKDIR: /audit-output
