+    return a * h / 2
+
+
+# CPython scales integer true division before binary64 conversion. This
+# numerator is twice the largest finite binary64 integer, so exact division by
+# two is the largest finite float rather than infinity.
+assert triangle_area(
+    ,
+    1,
+) == 1.7976931348623157e308
