+
+    print(json.dumps(
+        {
+            "oracle": str(Path(sys.argv[1]).resolve()),
+            "generated": str(Path(sys.argv[2]).resolve()),
+            "seed": 450045,
+            "case_count": len(cases),
+            "branch_boundaries": "none: source contains no conditional branches",
