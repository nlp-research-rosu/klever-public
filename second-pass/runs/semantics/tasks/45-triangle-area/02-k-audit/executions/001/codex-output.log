index 0000000000000000000000000000000000000000..49b16937f66ceda943d842aca6564a875beb81c6
--- /dev/null
+++ b/evidence/concrete_division_scaling_boundary.py
@@ -0,0 +1,8 @@
+def triangle_area(a, h):
+    return a * h / 2
+
+
+# CPython scales integer true division before binary64 conversion. This
+# numerator is twice the largest finite binary64 integer, so exact division by
+# two is the largest finite float rather than infinity.
+assert triangle_area((2**53 - 1) * (2**972), 1) == 1.7976931348623157e308
