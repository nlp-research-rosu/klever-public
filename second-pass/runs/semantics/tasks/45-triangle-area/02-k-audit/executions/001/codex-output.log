diff --git a/evidence/spec-vacuity-audit.k b/evidence/spec-vacuity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..4221b9b7c4a999a12b3847ed655cd35b87c25a0f
--- /dev/null
+++ b/evidence/spec-vacuity-audit.k
@@ -0,0 +1,40 @@
+requires "verification.k"
+
+module TRIANGLE-AREA-SPEC-VACUITY-AUDIT
+  imports TRIANGLE-AREA-VERIFICATION
+
+  // Deliberately false: for A=5 and H=3, real execution returns divII(15, 2),
+  // while this mutation demands divII(16, 2).
+  claim
+    <k>
+      #loadAll(triangleAreaProgram)
+      ~> Call(Name("triangle_area"), Int(A), Int(H))
+      => divII((A *Int H) +Int 1, 2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope
+      =>
+        0 |-> scope(
+               "triangle_area"
+                 |-> closureVal(
+                       ("a", "h"),
+                       Return(
+                         BinOp(
+                           "/",
+                           BinOp("*", Name("a"), Name("h")),
+                           Int(2))),
+                       0),
+               parent(-1))
+        -1 |-> builtinsScope
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule

