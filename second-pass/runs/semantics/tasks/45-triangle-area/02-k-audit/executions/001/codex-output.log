+++ b/evidence/run_logged.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf '%s\n' '--- OUTPUT ---'
+} >"$log_path"
+
+"$@" >>"$log_path" 2>&1
+status=$?
+
+{
+  printf '%s\n' '--- END OUTPUT ---'
+  printf 'EXIT_STATUS: %d\n' "$status"
+} >>"$log_path"
+
+exit "$status"
