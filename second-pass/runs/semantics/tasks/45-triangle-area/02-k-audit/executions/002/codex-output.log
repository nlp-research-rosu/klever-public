+event_types: Counter[str] = Counter()
+payload_types: Counter[str] = Counter()
+session_ids: set[str] = set()
+line_count = 0
+for path in trace_files:
+    with path.open() as stream:
+        for raw_line in stream:
+            line_count += 1
