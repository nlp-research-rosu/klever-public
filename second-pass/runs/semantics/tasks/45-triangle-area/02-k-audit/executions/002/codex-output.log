+                           "/",
+                           BinOp("+", Name("a"), Name("h")),
+                           Int(2))),
+                       0),
+               parent(-1))
+        -1 |-> builtinsScope
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
