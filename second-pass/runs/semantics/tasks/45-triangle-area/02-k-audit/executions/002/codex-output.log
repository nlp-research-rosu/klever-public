# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: triangle_area



def triangle_area(a, h):
    """Given length of a side and high return area for a triangle.
    >>> triangle_area(5, 3)
    7.5
    """
    return a * h / 2.0
def triangle_area(a, h):
    return a * h / 2
Module(
  FuncDef("triangle_area", Params("a", "h"),
    Return(BinOp("/", BinOp("*", Name("a"), Name("h")), Int(2)))))
requires "verification.k"

module TRIANGLE-AREA-SPEC
  imports TRIANGLE-AREA-VERIFICATION

  // For every pair of Python integers, calling the generated function returns
  // Python true division of their product by two.  divII is the supplied
  // semantics' symbolic representation of Int / Int.
  claim
    <k>
      #loadAll(triangleAreaProgram)
      ~> Call(Name("triangle_area"), Int(A), Int(H))
      => divII(A *Int H, 2)
    </k>
    <env> 0 </env>
    <scopes>
      ( 0 |-> scope(.Map, parent(-1))
        -1 |-> builtinsScope
      =>
        0 |-> scope(
               "triangle_area"
                 |-> closureVal(
                       ("a", "h"),
                       Return(
                         BinOp(
                           "/",
                           BinOp("*", Name("a"), Name("h")),
                           Int(2))),
                       0),
               parent(-1))
        -1 |-> builtinsScope
      )
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule
requires "reference-semantics/semantics.k"

module TRIANGLE-AREA-VERIFICATION
  imports MPY

  // This is exactly the constructor tree generated in solution.mpy.
  syntax Module ::= "triangleAreaProgram" [function, total]
  rule triangleAreaProgram
    => Module(
         FuncDef("triangle_area", Params("a", "h"),
           Return(BinOp("/", BinOp("*", Name("a"), Name("h")), Int(2)))))
endmodule
