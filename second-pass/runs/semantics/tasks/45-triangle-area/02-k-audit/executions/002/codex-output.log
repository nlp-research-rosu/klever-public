7:  syntax Bool ::= dSubset(ValSeq, ValSeq, ValSeq, ValSeq) [function]\nreference-semantics/semantics/dict.k:101:  syntax Val ::= dGet(ValSeq, ValSeq, Val) [function]\nreference-semantics/semantics/tuple.k:1:// reference/src/semantics/tuple.k — MPY-TUPLE\nreference-semantics/semantics/tuple.k:3:module MPY-TUPLE\nreference-semantics/semantics/tuple.k:9:  // ==== iteration (the iterator protocol's tuple case) ======================\nreference-semantics/semantics/tuple.k:10:  rule <k> #iterNext(tuple(.ValSeq))                => #iterDone ... </k>\nreference-semantics/semantics/tuple.k:11:  rule <k> #iterNext(tuple(vCons(V:Val, R:ValSeq))) => #iterYield(V, tuple(R)) ... </k>\nreference-semantics/semantics/tuple.k:13:  // ==== TupleExpr: tuple(ValSeq) literal + == != ===========================\nreference-semantics/semantics/tuple.k:15:  rule <k> TupleExpr(ES:Exprs) => #evalArgs(ES, .Vals, toTuple) ... </k>\nreference-semantics/semantics/tuple.k:16:  rule <k> #applyK(toTuple, ACC:Vals) => tuple(vals2valSeq(ACC)) ... </k>\nreference-semantics/semantics/tuple.k:19:  // membership routes through the same k-cell fold as lists (list.k)\nreference-semantics/semantics/tuple.k:20:  rule <k> Compare(LV:Val, CmpOp(\"in\",     tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ... </k>\nreference-semantics/semantics/tuple.k:21:  rule <k> Compare(LV:Val, CmpOp(\"not in\", tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ~> #notB ... </k>\nreference-semantics/semantics/tuple.k:22:  // t.index(v): first index of v (ValueError out of subset)\nreference-semantics/semantics/tuple.k:24:  syntax Int ::= idxOfVS(ValSeq, Val, Int) [function]\nreference-semantics/semantics/tuple.k:30:  // ==== target binding: bind a Name or a TupleExpr target to a value ========\nreference-semantics/semantics/tuple.k:32:  rule <k> #bindTgt(Name(X:String), V:Val) => .K ... </k>\nreference-semantics/semantics/tuple.k:33:       <env> L:Int </env>\nreference-semantics/semantics/tuple.k:34:       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>\nreference-semantics/semantics/tuple.k:35:  rule <k> #bindTgt(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>\nreference-semantics/semantics/tuple.k:36:       <env> L:Int </env>\nreference-semantics/semantics/tuple.k:37:       <scopes> ... L |-> scope(M:Map, _) ... </scopes>\nreference-semantics/semantics/tuple.k:42:  rule <k> #bindTgt(TupleExpr(TS:Exprs), tuple(VS:ValSeq)) => #unpackSeq(TS, VS) ... </k>\nreference-semantics/semantics/tuple.k:43:  rule <k> #bindTgt(TupleExpr(TS:Exprs), list(VS:ValSeq))  => #unpackSeq(TS, VS) ... </k>\nreference-semantics/semantics/tuple.k:44:  rule <k> #bindTgt(TupleExpr(TS:Exprs), ref(H:Int)) => #bindTgt(TupleExpr(TS), V) ... </k>\nreference-semantics/semantics/tuple.k:45:       <heap> ... H |-> V:Val ... </heap>\nreference-semantics/semantics/tuple.k:48:  // ==== unpacking: a, b = <tuple|list> (RHS evaluated by strictness) ========\nreference-semantics/semantics/tuple.k:50:  rule <k> Assign(TupleExpr(TS:Exprs), tuple(VS:ValSeq)) => #unpackSeq(TS, VS) ... </k>\nreference-semantics/semantics/tuple.k:51:  rule <k> Assign(TupleExpr(TS:Exprs), list(VS:ValSeq))  => #unpackSeq(TS, VS) ... </k>\nreference-semantics/semantics/tuple.k:52:  rule <k> Assign(TupleExpr(TS:Exprs), ref(H:Int)) => Assign(TupleExpr(TS), V) ... </k>\nreference-semantics/semantics/tuple.k:53:       <heap> ... H |-> V:Val ... </heap>\nreference-semantics/semantics/tuple.k:56:        => #bindTgt(T, V) ~> #unpackSeq(TS, VS) ... </k>\nreference-semantics/semantics/tuple.k:57:  rule <k> #unpackSeq(.Exprs, .ValSeq) => .K ... </k>\nreference-semantics/semantics/int.k:1:// reference/src/semantics/int.k — MPY-INT\nreference-semantics/semantics/int.k:2:// Int cases of the operator dispatch; Python // and % are floored (pyMod).\nreference-semantics/semantics/int.k:4:module MPY-INT\nreference-semantics/semantics/int.k:10:  // Bool participates in int arithmetic (x += (a == b))\nreference-semantics/semantics/int.k:16:  rule applyBin(\"//\", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2\nreference-semantics/semantics/int.k:19:  syntax Int ::= pyMod(Int, Int) [function]\nreference-semantics/semantics/int.k:27:  rule applyCmp(\"!=\", I1:Int, I2:Int)   => I1 =/=Int I2\nreference-semantics/semantics/methods.k:1:// reference/src/semantics/methods.k — MPY-METHODS\nreference-semantics/semantics/methods.k:3:module MPY-METHODS\nreference-semantics/semantics/methods.k:9:  // method-call routing + arg-eval live in call.k; this module owns applyMethod.\nreference-semantics/semantics/methods.k:10:  syntax Val ::= applyMethod(Val, String, Vals) [function]\nreference-semantics/semantics/methods.k:12:  // ==== string predicates (Python semantics) =================================\nreference-semantics/semantics/methods.k:18:  // ==== case maps ============================================================\nreference-semantics/semantics/methods.k:23:  // ==== join / count / strip / encode ========================================\nreference-semantics/semantics/methods.k:24:  // S.join(list-of-str): fold with separator codes (receiver + arg deref'd by\nreference-semantics/semantics/methods.k:25:  // the call layer; the result str is a value)\nreference-semantics/semantics/methods.k:27:  syntax IntSeq ::= joinCodes(IntSeq, ValSeq) [function, total]\nreference-semantics/semantics/methods.k:33:  // S.count(sub): non-overlapping window scan (Python str.count)\nreference-semantics/semantics/methods.k:35:  syntax Int ::= cntSub(IntSeq, IntSeq) [function]\nreference-semantics/semantics/methods.k:41:  syntax IntSeq ::= dropIS(IntSeq, Int) [function, total]\nreference-semantics/semantics/methods.k:46:  // S.strip(): trim whitespace runs from both ends\nreference-semantics/semantics/methods.k:48:  syntax IntSeq ::= trimWS(IntSeq) [function, total]\nreference-semantics/semantics/methods.k:52:  syntax IntSeq ::= revIS(IntSeq) [function, total] | revISAcc(IntSeq, IntSeq) [function, total]\nreference-semantics/semantics/methods.k:57:  // S.encode('ascii'): identity on the code-sequence model (bytes == codes)\nreference-semantics/semantics/methods.k:60:  // ==== prefix ===============================================================\nreference-semantics/semantics/methods.k:63:  // ==== list.count(v) — number of occurrences of v in the list (concrete for krun) ==========\nreference-semantics/semantics/methods.k:65:  syntax Int ::= cntOccVS(ValSeq, Val) [function, total]\nreference-semantics/semantics/methods.k:70:  // ==== split (no-arg: on whitespace runs, dropping empty tokens) + replace (single char) ==========\nreference-semantics/semantics/methods.k:71:  // Concrete string ops for krun. A proof over a symbolic string intercepts the split problem-locally.\nreference-semantics/semantics/methods.k:73:        => #alloc(list(splitWS(CS, .IntSeq, .ValSeq))) ... </k>\nreference-semantics/semantics/methods.k:75:  syntax ValSeq ::= splitWS(IntSeq, IntSeq, ValSeq) [function]  // remaining, current token, result\nreference-semantics/semantics/methods.k:81:  // flush the current token to the result list iff non-empty.\nreference-semantics/semantics/methods.k:82:  syntax ValSeq ::= flushTok(ValSeq, IntSeq) [function]\nreference-semantics/semantics/methods.k:85:  syntax Bool ::= isWSC(Int) [function, total]\nreference-semantics/semantics/methods.k:88:  // split(sep='x') keyword form delegates to the positional k-cell rule\nreference-semantics/semantics/methods.k:90:        => #applyK(toCall(boundMethodV(str(CS), \"split\")), (str(S), .Vals)) ... </k>\nreference-semantics/semantics/methods.k:93:  // str.split(sep) — single-char separator, KEEPING empty parts (Python's sep-split; len == #sep + 1).\nreference-semantics/semantics/methods.k:95:        => #alloc(list(splitSep(CS, SEP, .IntSeq))) ... </k>\nreference-semantics/semantics/methods.k:97:  syntax ValSeq ::= splitSep(IntSeq, Int, IntSeq) [function]  // remaining, sep code, current token\nreference-semantics/semantics/methods.k:106:  syntax IntSeq ::= replaceC(IntSeq, Int, Int) [function, total]\nreference-semantics/semantics/methods.k:111:  // ==== char helpers =========================================================\nreference-semantics/semantics/methods.k:112:  syntax Bool ::= isUpperC(Int) [function, total]\nreference-semantics/semantics/methods.k:115:  syntax Bool ::= isLowerC(Int) [function, total]\nreference-semantics/semantics/methods.k:118:  syntax Bool ::= isAlphaC(Int) [function, total]\nreference-semantics/semantics/methods.k:121:  syntax Bool ::= isDigitC(Int) [function, total]\nreference-semantics/semantics/methods.k:124:  syntax Bool ::= hasUpper(IntSeq) [function, total]\nreference-semantics/semantics/methods.k:128:  syntax Bool ::= hasLower(IntSeq) [function, total]\nreference-semantics/semantics/methods.k:132:  syntax Bool ::= allAlpha(IntSeq) [function, total]\nreference-semantics/semantics/methods.k:136:  syntax Bool ::= allDigit(IntSeq) [function, total]\nreference-semantics/semantics/methods.k:140:  syntax Int ::= lowerC(Int) [function, total]\nreference-semantics/semantics/methods.k:145:  syntax Int ::= upperC(Int) [function, total]\nreference-semantics/semantics/methods.k:149:  syntax Int ::= swapC(Int) [function, total]\nreference-semantics/semantics/methods.k:154:  syntax IntSeq ::= mapLower(IntSeq) [function, total]\nreference-semantics/semantics/methods.k:158:  syntax IntSeq ::= mapUpper(IntSeq) [function, total]\nreference-semantics/semantics/methods.k:162:  syntax IntSeq ::= mapSwap(IntSeq) [function, total]\nreference-semantics/semantics/methods.k:166:  syntax Bool ::= startsWith(IntSeq, IntSeq) [function, total]\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"019f8d50-6ce3-7971-aaf4-0938f974abfc"}}}
