Module(
  FuncDef("add", Params("x", "y"),
    Return(BinOp("+", Name("x"), Name("y"))))
  Assert(
    Compare(
      Call(Name("add"), Int(2), Int(3)),
      CmpOp("==", Int(5))))
  Assert(
    Compare(
      Call(Name("add"), Int(5), Int(7)),
      CmpOp("==", Int(12))))
  Assert(
    Compare(
      Call(Name("add"), Int(-10), Int(3)),
      CmpOp("==", Int(-7)))))
