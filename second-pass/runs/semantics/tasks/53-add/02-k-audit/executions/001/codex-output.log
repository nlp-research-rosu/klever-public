new file mode 100644
index 0000000000000000000000000000000000000000..b7eb7743a815e4efe11f3a715147c9ff67239d47
--- /dev/null
+++ b/evidence/spec-ground.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module ADD-SPEC-GROUND
+  imports ADD-VERIFICATION
+
+  // Concrete satisfying instance of the universal entry precondition: X=2, Y=3.
+  claim
+    <k> #callAdd(2, 3) => 5 </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+        "add" |-> closureVal(
+          ("x", "y"),
+          Return(BinOp("+", Name("x"), Name("y"))),
+          0),
+        parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule

codex
The pinning check is clean: the exact normalized AST embedded in `verification.k` equals the submitted `solution.mpy`, so the wrapper loads the submitted function body rather than a substitute. A concrete pre-state at `X=2, Y=3` satisfies every entry cell, its ground claim closes to `5`, and fresh K executions agree with both Python implementations on zero, negative, 64-bit-overflow-edge, and arbitrary-precision cases.

The exhaustive source index now covers 931 declarations/contexts/claims across all supplied helper files and the proof files. No proof-local opaque symbol, lemma, simplification, totality assertion, or priority rule exists; the only proof-local extension is the `#callAdd` entry expansion. I’m moving to the independent false-result mutation required by the non-vacuity gate.
