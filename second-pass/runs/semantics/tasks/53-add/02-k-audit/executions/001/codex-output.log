+exec >"$LOG" 2>&1
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local rc=$?
+  printf '[exit %d]\n' "$rc"
+  return "$rc"
+}
+
+run command -v kompile || exit $?
+run command -v krun || exit $?
+run command -v kprove || exit $?
+run kompile --version || exit $?
+run krun --version || exit $?
+run kprove --version || exit $?
+
+printf '\n$ cd %q\n' "$WORK"
+cd "$WORK" || exit 1
+printf '[exit 0]\n'
