+
+printf '\nCandidate and trusted file digests:\n'
+find /candidate/reference-semantics -type f -print0 |
+  sort -z |
+  xargs -0 sha256sum
+find /reference/reference-semantics -type f -print0 |
+  sort -z |
+  xargs -0 sha256sum
