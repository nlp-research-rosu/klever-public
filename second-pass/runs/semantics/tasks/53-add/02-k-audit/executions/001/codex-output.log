+run cmp -s regenerated-solution.mpy solution.mpy
+run sha256sum regenerated-solution.mpy solution.mpy
+run diff -u solution.mpy regenerated-solution.mpy
+run find . -maxdepth 3 -printf '%y %p -> %l\n'
