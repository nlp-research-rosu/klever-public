+        "add" |-> closureVal(
+          ("x", "y"),
+          Return(BinOp("+", Name("x"), Name("y"))),
+          0),
+        parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
