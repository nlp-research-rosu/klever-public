+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/spec-instances.k b/evidence/spec-instances.k
new file mode 100644
index 0000000000000000000000000000000000000000..86d9f3f4fbc70e94d11bf3e3077e259ad56673c2
--- /dev/null
+++ b/evidence/spec-instances.k
@@ -0,0 +1,74 @@
+requires "verification.k"
+
+module ADD-SPEC-INSTANCES
+  imports ADD-VERIFICATION
+
+  claim
