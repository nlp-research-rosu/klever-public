+++ b/evidence/spec-instances.k
@@ -0,0 +1,74 @@
+requires "verification.k"
+
+module ADD-SPEC-INSTANCES
+  imports ADD-VERIFICATION
+
+  claim
+    <k> #callAdd(2, 3) => 5 </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+        "add" |-> closureVal(
+          ("x", "y"),
+          Return(BinOp("+", Name("x"), Name("y"))),
+          0),
+        parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
