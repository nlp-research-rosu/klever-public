import hashlib,os,stat,itertools
from pathlib import Path
root=Path('/reference/reference-semantics'); target='1de6d5f51876cf9d0f4449a78f077f8b127a14add0504d5060da680fc5a443de'
allents=[]
for p in root.rglob('*'):
 m=p.lstat().st_mode;r=p.relative_to(root).as_posix();
 if p.is_dir(): k='d'
 elif p.is_file():k='f'
 else:continue
 allents.append((r,k,p))
allents.sort()
entrysets={'all':allents,'files':[x for x in allents if x[1]=='f']}
pathforms={'rel':lambda r:r,'dot':lambda r:'./'+r,'slashdir':lambda r:r}
kindvals={'none':{'d':b'','f':b''},'df':{'d':b'd','f':b'f'},'DF':{'d':b'D','f':b'F'},'long':{'d':b'directory','f':b'file'},'num':{'d':b'0','f':b'1'}}
seps=[b'',b'\\0',b'\\n',b':',b' ']
prefixes=['none','len4be','len8be']
filevals=['content','hex','digest','size8content','size8hex','size8digest']
for esn,ents in entrysets.items():
 for pfn,pf in pathforms.items():
  for kvn,kv in kindvals.items():
   for sep1,sep2,end,prefix,fv in itertools.product(seps,seps,seps,prefixes,filevals):
    h=hashlib.sha256()
    for r,k,p in ents:
     rb=pf(r).encode()
     if prefix=='len4be':h.update(len(rb).to_bytes(4,'big'))
     elif prefix=='len8be':h.update(len(rb).to_bytes(8,'big'))
     h.update(rb);h.update(sep1);h.update(kv[k]);h.update(sep2)
     if k=='f':
      data=p.read_bytes();d=hashlib.sha256(data)
      if fv.startswith('size8'):h.update(len(data).to_bytes(8,'big'))
      base=fv.removeprefix('size8')
      h.update(data if base=='content' else d.hexdigest().encode() if base=='hex' else d.digest())
     h.update(end)
    if h.hexdigest()==target:
     print('MATCH',esn,pfn,kvn,sep1,sep2,end,prefix,fv);raise SystemExit
print('no match')
