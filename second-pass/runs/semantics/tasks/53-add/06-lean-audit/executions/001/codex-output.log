+    recorded_diagnostic_hash_checks.append(
+        {
+            "command": diagnostic["command"],
+            "recorded_output_sha256": diagnostic["output_sha256"],
+            "stored_output_tail_sha256": hashlib.sha256(
+                output_tail.encode()
