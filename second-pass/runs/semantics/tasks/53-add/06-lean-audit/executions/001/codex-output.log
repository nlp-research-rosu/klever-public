+    "all_image_ids_match": (
+        generator_manifest["provenance"]["generator_image_id"]
+        == source_manifest["generator_image_id"]
+        == audit_image_id
+    ),
+}
+
+print(json.dumps(result, indent=2, sort_keys=True))

