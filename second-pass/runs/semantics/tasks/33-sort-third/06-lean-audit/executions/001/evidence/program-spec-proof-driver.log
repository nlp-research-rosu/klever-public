     1	def sort_third(l: list):
     2	    """Sort the elements whose indices are divisible by three."""
     3	    thirds = sorted(l[::3])
     4	    result = []
     5	    i = 0
     6	    value = None
     7	    for value in l:
     8	        if i % 3 == 0:
     9	            result.append(thirds[i // 3])
    10	        else:
    11	            result.append(value)
    12	        i += 1
    13	    return result
