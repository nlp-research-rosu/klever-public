diff --git a//tmp/audit-work/lean_app_path_shim.c b//tmp/audit-work/lean_app_path_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..1ade49ffc4aade45427a041095ffe9ac0c89e425
--- /dev/null
+++ b//tmp/audit-work/lean_app_path_shim.c
@@ -0,0 +1,24 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (
+        path != NULL
+        && strncmp(path, "/proc/", 6) == 0
+        && strlen(path) >= 4
+        && strcmp(path + strlen(path) - 4, "/exe") == 0
+    ) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}
