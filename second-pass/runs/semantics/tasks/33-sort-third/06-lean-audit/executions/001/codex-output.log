            "text": "  rule sortThirdFunctionBody\n    => Expr(Str(\"Sort the elements whose indices are divisible by three.\"))\n       Assign(\n         Name(\"thirds\"),\n         Call(\n           Name(\"sorted\"),\n           Subscript(Name(\"l\"), Slice(NoBound, NoBound, Int(3)))))\n       Assign(Name(\"result\"), ListExpr(.Exprs))\n       Assign(Name(\"i\"), Int(0))\n       Assign(Name(\"value\"), NoneVal)\n       For(Name(\"value\"), Name(\"l\"), sortThirdBody)\n       Return(Name(\"result\"))\n       .Stmts"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 40,
            "module": "VERIFICATION",
            "normalized_sha256": "7c593d3abb10208b9212ec827fa30fc4ff49f3dfa4acc1d6d12a35777a7a8b39",
            "rationale": "Defines the named sortThirdClosure proof term as the closure value for the already defined function body.",
            "source_rule_id": "rule-7c593d3abb10208b9212ec827fa30fc4ff49f3dfa4acc1d6d12a35777a7a8b39",
            "start_line": 39,
            "text": "  rule sortThirdClosure\n    => closureVal((\"l\", .ParamNames), sortThirdFunctionBody, 0)"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 50,
            "module": "VERIFICATION",
            "normalized_sha256": "10b3747ff64f7edc5c2b2739b560b4381fc410dad54630e3f5c2a3f0a1b3d3de",
            "rationale": "Defines sortThirdModule as the module AST containing the translated sort_third function.",
            "source_rule_id": "rule-10b3747ff64f7edc5c2b2739b560b4381fc410dad54630e3f5c2a3f0a1b3d3de",
            "start_line": 45,
            "text": "  rule sortThirdModule\n    => Module(\n         FuncDef(\n           \"sort_third\",\n           Params(\"l\"),\n           sortThirdFunctionBody))"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 58,
            "module": "VERIFICATION",
            "normalized_sha256": "6bf57cc70b116bf57d62cb53019c3bc3a8afd519690929ee08b6bb00a2334384",
            "rationale": "Defines the divisible-by-three branch of the thirdValue selector by indexing the sorted every-third subsequence.",
            "source_rule_id": "rule-6bf57cc70b116bf57d62cb53019c3bc3a8afd519690929ee08b6bb00a2334384",
            "start_line": 56,
            "text": "  rule thirdValue(_:Val, SORTED:ValSeq, I:Int)\n    => valSeqAt(SORTED, (I -Int pyMod(I, 3)) /Int 3)\n    requires pyMod(I, 3) ==Int 0"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 60,
            "module": "VERIFICATION",
            "normalized_sha256": "d67c9157105f75b20f186a8416a8374e66a206669477ae93c784de085518a12d",
            "rationale": "Defines the complementary thirdValue branch, preserving the original value when the index is not divisible by three.",
            "source_rule_id": "rule-d67c9157105f75b20f186a8416a8374e66a206669477ae93c784de085518a12d",
            "start_line": 59,
            "text": "  rule thirdValue(V:Val, _:ValSeq, I:Int) => V\n    requires pyMod(I, 3) =/=Int 0"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 64,
            "module": "VERIFICATION",
            "normalized_sha256": "265d11e00e4fbf524925232abb23c7127d163ff9a4a0fb40c8dd70453168070e",
            "rationale": "Defines the empty-input base case of the sortThirdAcc mathematical fold.",
            "source_rule_id": "rule-265d11e00e4fbf524925232abb23c7127d163ff9a4a0fb40c8dd70453168070e",
            "start_line": 64,
            "text": "  rule sortThirdAcc(.ValSeq, _:ValSeq, _:Int, ACC:ValSeq) => ACC"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 73,
            "module": "VERIFICATION",
            "normalized_sha256": "48d8e0a8b82574ed851e8ab7b2c422bde84aba1f278d3e73a9ee43b27ebff908",
            "rationale": "Defines the nonempty recursive case of sortThirdAcc by advancing the index and extending the accumulated output.",
            "source_rule_id": "rule-48d8e0a8b82574ed851e8ab7b2c422bde84aba1f278d3e73a9ee43b27ebff908",
            "start_line": 65,
            "text": "  rule sortThirdAcc(vCons(V:Val, REST:ValSeq), SORTED:ValSeq,\n                    I:Int, ACC:ValSeq)\n    => sortThirdAcc(\n         REST,\n         SORTED,\n         I +Int 1,\n         valSeqConcat(\n           ACC,\n           vCons(thirdValue(V, SORTED, I), .ValSeq)))"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 76,
            "module": "VERIFICATION",
            "normalized_sha256": "5003da3d7156c8d67318d1d506c428d29a27f6057012a2b10ef5b4a0bc66f7a0",
            "rationale": "Defines the empty-input base case of the lastLoopValue structural helper.",
            "source_rule_id": "rule-5003da3d7156c8d67318d1d506c428d29a27f6057012a2b10ef5b4a0bc66f7a0",
            "start_line": 76,
            "text": "  rule lastLoopValue(.ValSeq, OLD:Val) => OLD"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 78,
            "module": "VERIFICATION",
            "normalized_sha256": "7b6f7fc609a2303132cffc76dbf0fb13227389bda8ad1906153b016750d88a66",
            "rationale": "Defines the nonempty recursive case of lastLoopValue by retaining the most recently traversed element.",
            "source_rule_id": "rule-7b6f7fc609a2303132cffc76dbf0fb13227389bda8ad1906153b016750d88a66",
            "start_line": 77,
            "text": "  rule lastLoopValue(vCons(V:Val, REST:ValSeq), _:Val)\n    => lastLoopValue(REST, V)"
        },
        {
            "attributes": [],
            "classification": "DEFINITION",
            "end_line": 86,
            "module": "VERIFICATION",
            "normalized_sha256": "784a582d08c3bf5c89efdcf597adcf9e84c7d8e69114ac1324c993790561826b",
            "rationale": "Defines the top-level sortThird summary by initializing sortThirdAcc with the trusted sorted stride-three slice and an empty accumulator.",
            "source_rule_id": "rule-784a582d08c3bf5c89efdcf597adcf9e84c7d8e69114ac1324c993790561826b",
            "start_line": 81,
            "text": "  rule sortThird(INPUT:ValSeq)\n    => sortThirdAcc(\n         INPUT,\n         sortVS(buildVS(INPUT, 0, vsLen(INPUT), 3)),\n         0,\n         .ValSeq)"
        }
    ],
