+        mode = path.stat(follow_symlinks=False).st_mode
+        if stat.S_ISREG(mode):
+            names.append(path.relative_to(root).as_posix())
+        elif not stat.S_ISDIR(mode):
+            raise RuntimeError(f"unsafe tree entry: {path}")
+    return names
