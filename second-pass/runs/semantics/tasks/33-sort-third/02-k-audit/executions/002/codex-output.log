    95	  rule applyCmp("==", dictV(KS1:ValSeq, VS1:ValSeq), dictV(KS2:ValSeq, VS2:ValSeq))
    96	    => (vsLen(KS1) ==Int vsLen(KS2)) andBool dSubset(KS1, VS1, KS2, VS2)
    97	  syntax Bool ::= dSubset(ValSeq, ValSeq, ValSeq, ValSeq) [function]
    98	  rule dSubset(.ValSeq, .ValSeq, _:ValSeq, _:ValSeq) => true
    99	  rule dSubset(vCons(K:Val, KR:ValSeq), vCons(V:Val, VR:ValSeq), KS2:ValSeq, VS2:ValSeq)
   100	    => dHasKey(KS2, K) andBool (dGet(KS2, VS2, K) ==K V) andBool dSubset(KR, VR, KS2, VS2)
   101	  syntax Val ::= dGet(ValSeq, ValSeq, Val) [function]
   102	  rule dGet(vCons(A:Val, _:ValSeq), vCons(B:Val, _:ValSeq), K:Val) => B                requires A ==K K
   103	  rule dGet(vCons(A:Val, KR:ValSeq), vCons(_:Val, VR:ValSeq), K:Val) => dGet(KR, VR, K) requires notBool (A ==K K)
   104	endmodule

diff --git a//tmp/audit-work/33-sort-third/audit_concrete_tests.py b//tmp/audit-work/33-sort-third/audit_concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..39b81607d0a59e9dec96cc0cfd868838508a7cf3
--- /dev/null
+++ b//tmp/audit-work/33-sort-third/audit_concrete_tests.py
@@ -0,0 +1,33 @@
+def sort_third(l: list):
+    """Sort the elements whose indices are divisible by three."""
+    thirds = sorted(l[::3])
+    result = []
+    i = 0
+    value = None
+    for value in l:
+        if i % 3 == 0:
+            result.append(thirds[i // 3])
+        else:
+            result.append(value)
+        i += 1
+    return result
+
+
+assert sort_third([]) == []
+assert sort_third([7]) == [7]
+assert sort_third([2, 1]) == [2, 1]
+assert sort_third([3, 2, 1]) == [3, 2, 1]
+assert sort_third([3, 2, 1, 0]) == [0, 2, 1, 3]
+assert sort_third([5, 6, 3, 4, 8, 9, 2]) == [2, 6, 3, 4, 8, 9, 5]
+assert sort_third([9, -1, 8, 6, -2, 5, 3, -3, 2, 0]) == [
+    0,
+    -1,
+    8,
+    3,
+    -2,
+    5,
+    6,
+    -3,
+    2,
+    9,
+]
