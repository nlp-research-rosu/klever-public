Module(
  FuncDef("sort_third", Params("l"),
    Expr(Str("Sort the elements whose indices are divisible by three."))
    Assign(
      Name("thirds"),
      Call(
        Name("sorted"),
        Subscript(Name("l"), Slice(NoBound, NoBound, Int(3)))))
    Assign(Name("result"), ListExpr())
    Assign(Name("i"), Int(0))
    Assign(Name("value"), NoneVal)
    For(Name("value"), Name("l"),
      If(Compare(BinOp("%", Name("i"), Int(3)), CmpOp("==", Int(0))),
        Expr(
          Call(
            Attribute(Name("result"), "append"),
            Subscript(Name("thirds"), BinOp("//", Name("i"), Int(3))))),
        Expr(Call(Attribute(Name("result"), "append"), Name("value"))))
      AugAssign(Name("i"), "+", Int(1)))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("sort_third"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("sort_third"), ListExpr(Int(7))),
      CmpOp("==", ListExpr(Int(7)))))
  Assert(
    Compare(
      Call(Name("sort_third"), ListExpr(Int(2), Int(1))),
      CmpOp("==", ListExpr(Int(2), Int(1)))))
  Assert(
    Compare(
      Call(Name("sort_third"), ListExpr(Int(3), Int(2), Int(1))),
      CmpOp("==", ListExpr(Int(3), Int(2), Int(1)))))
  Assert(
    Compare(
      Call(Name("sort_third"), ListExpr(Int(3), Int(2), Int(1), Int(0))),
      CmpOp("==", ListExpr(Int(0), Int(2), Int(1), Int(3)))))
  Assert(
    Compare(
      Call(
        Name("sort_third"),
        ListExpr(Int(5), Int(6), Int(3), Int(4), Int(8), Int(9), Int(2))),
      CmpOp(
        "==",
        ListExpr(Int(2), Int(6), Int(3), Int(4), Int(8), Int(9), Int(5)))))
  Assert(
    Compare(
      Call(
        Name("sort_third"),
        ListExpr(
          Int(9),
          UnaryOp("-", Int(1)),
          Int(8),
          Int(6),
          UnaryOp("-", Int(2)),
          Int(5),
          Int(3),
          UnaryOp("-", Int(3)),
          Int(2),
          Int(0))),
      CmpOp(
        "==",
        ListExpr(
          Int(0),
          UnaryOp("-", Int(1)),
          Int(8),
          Int(3),
          UnaryOp("-", Int(2)),
          Int(5),
          Int(6),
          UnaryOp("-", Int(3)),
          Int(2),
          Int(9))))))
