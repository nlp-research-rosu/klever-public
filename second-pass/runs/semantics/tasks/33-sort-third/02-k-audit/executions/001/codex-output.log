+      ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        "i"      |-> (I:Int => I +Int vsLen(INPUT))
+        "l"      |-> LISTARG:Val
+        "value"  |-> (OLD:Val => lastLoopValue(INPUT, OLD))
+        "result" |-> ref(HR:Int)
