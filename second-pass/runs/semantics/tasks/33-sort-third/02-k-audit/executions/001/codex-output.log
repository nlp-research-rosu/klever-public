+      #loadAll(sortThirdModule)
+      ~> Call(Name("sort_third"), list(INPUT:ValSeq))
+      => ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+        .Map
+        => ("sort_third" |-> sortThirdClosure),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(buildVS(INPUT, 0, vsLen(INPUT), 3))
+      1 |-> list(sortVS(buildVS(INPUT, 0, vsLen(INPUT), 3)))
+      2 |-> list(
+        valSeqConcat(
+          sortThird(INPUT),
+          vCons(0, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
