@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module PINNING
+  imports VERIFICATION
+
+  // Reviewer-authored equality check: the proof's named module reduces to the
+  // exact trusted-translator output submitted as solution.mpy.
+  claim
+    <k>
+      sortThirdModule
+      =>
+      Module(
+      FuncDef("sort_third", Params("l"),
+        Expr(Str("Sort the elements whose indices are divisible by three."))
+        Assign(
+          Name("thirds"),
+          Call(
+            Name("sorted"),
+            Subscript(Name("l"), Slice(NoBound, NoBound, Int(3)))))
+        Assign(Name("result"), ListExpr(.Exprs))
+        Assign(Name("i"), Int(0))
+        Assign(Name("value"), NoneVal)
+        For(Name("value"), Name("l"),
+          If(Compare(BinOp("%", Name("i"), Int(3)), CmpOp("==", Int(0))),
+            Expr(
+              Call(
+                Attribute(Name("result"), "append"),
+                Subscript(Name("thirds"), BinOp("//", Name("i"), Int(3))))),
+            Expr(Call(Attribute(Name("result"), "append"), Name("value"))))
+          AugAssign(Name("i"), "+", Int(1)))
+        Return(Name("result"))))
+    </k>
+endmodule
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..fafd67e9571723e3843846dd29f644f7b6dea46e
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+# Run one command, preserving its exact argv, bounded output, and exit status.
+set -u
+
+if [[ "$#" -lt 2 ]]; then
+  printf 'usage: %s LOG_PATH COMMAND [ARG ...]\n' "$0" >&2
+  exit 2
+fi
+
+log_path=$1
+shift
+raw_log=$(mktemp /tmp/audit-command.XXXXXX)
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$raw_log"
+
+"$@" >> "$raw_log" 2>&1
+command_status=$?
+printf '\nEXIT_STATUS: %d\n' "$command_status" >> "$raw_log"
+
+raw_size=$(wc -c < "$raw_log")
+if [[ "$raw_size" -le 120000 ]]; then
+  cp "$raw_log" "$log_path"
+else
+  {
+    head -c 80000 "$raw_log"
+    printf '\n... OUTPUT BOUNDED: %d total bytes; middle omitted ...\n' "$raw_size"
+    tail -c 40000 "$raw_log"
+  } > "$log_path"
+fi
+
+rm -f "$raw_log"
+sed -n '1,260p' "$log_path"
+exit "$command_status"
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..278c67d5cdb7e9d6aa132d6150ecc432132adb0c
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,65 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Keep the real auxiliary invariant available and simultaneously discharged.
+  claim [sort-third-loop-vacuity-support]:
+    <k>
+      #loop(list(INPUT:ValSeq), Name("value"), sortThirdBody)
+      ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        "i"      |-> (I:Int => I +Int vsLen(INPUT))
+        "l"      |-> LISTARG:Val
+        "value"  |-> (OLD:Val => lastLoopValue(INPUT, OLD))
+        "result" |-> ref(HR:Int)
+        "thirds" |-> ref(HT:Int),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    <heap>
+      HT |-> list(SORTED:ValSeq)
+      HR |-> list(
+        ACC:ValSeq
+        => sortThirdAcc(INPUT, SORTED, I, ACC))
+      RESTHEAP:Map
+    </heap>
+    requires I >=Int 0
+
+  // Deliberately false mutation: require an additional trailing zero in the
+  // returned list. For [5,6,3,4,8,9,2], the real result has length 7, not 8.
+  claim [sort-third-false-appended-zero]:
+    <k>
+      #loadAll(sortThirdModule)
+      ~> Call(Name("sort_third"), list(INPUT:ValSeq))
+      => ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+        .Map
+        => ("sort_third" |-> sortThirdClosure),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(buildVS(INPUT, 0, vsLen(INPUT), 3))
+      1 |-> list(sortVS(buildVS(INPUT, 0, vsLen(INPUT), 3)))
+      2 |-> list(
+        valSeqConcat(
+          sortThird(INPUT),
+          vCons(0, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
