diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..fd153bccfaff5c4d0a5f657c61a4e9a56f5ac528
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,66 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive loop invariant.  It is intentionally generalized over the
+  // starting index and already-built prefix so that the recursive loop state
+  // is another instance of the same claim.
+  claim [sort-third-loop]:
+    <k>
+      #loop(list(INPUT:ValSeq), Name("value"), sortThirdBody)
+      ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      L |-> scope(
+        "i"      |-> (I:Int => I +Int vsLen(INPUT))
+        "l"      |-> LISTARG:Val
+        "value"  |-> (OLD:Val => lastLoopValue(INPUT, OLD))
+        "result" |-> ref(HR:Int)
+        "thirds" |-> ref(HT:Int),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    <heap>
+      HT |-> list(SORTED:ValSeq)
+      HR |-> list(
+        ACC:ValSeq
+        => sortThirdAcc(INPUT, SORTED, I, ACC))
+      RESTHEAP:Map
+    </heap>
+    requires I >=Int 0
+
+  // End-to-end claim from loading the translated module through returning the
+  // freshly allocated result.  INPUT is arbitrary; the trusted sort primitive
+  // remains opaque, while the complete surrounding list transformation is
+  // proved.
+  claim [sort-third-correct]:
+    <k>
+      #loadAll(sortThirdModule)
+      ~> Call(Name("sort_third"), list(INPUT:ValSeq))
+      => ref(2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(
+        .Map
+        => ("sort_third" |-> sortThirdClosure),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(buildVS(INPUT, 0, vsLen(INPUT), 3))
+      1 |-> list(sortVS(buildVS(INPUT, 0, vsLen(INPUT), 3)))
+      2 |-> list(sortThird(INPUT))
+    </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..90f610d30f47a7a3693d9037ede14a3d8130651b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,87 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  syntax Stmts ::= "sortThirdBody" [function, total]
+  rule sortThirdBody
+    => If(Compare(BinOp("%", Name("i"), Int(3)),
+                  CmpOp("==", Int(0))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             Subscript(
+               Name("thirds"),
+               BinOp("//", Name("i"), Int(3))))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             Name("value"))))
+       AugAssign(Name("i"), "+", Int(1))
+       .Stmts
+
+  syntax Stmts ::= "sortThirdFunctionBody" [function, total]
+  rule sortThirdFunctionBody
+    => Expr(Str("Sort the elements whose indices are divisible by three."))
+       Assign(
+         Name("thirds"),
+         Call(
+           Name("sorted"),
+           Subscript(Name("l"), Slice(NoBound, NoBound, Int(3)))))
+       Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("i"), Int(0))
+       Assign(Name("value"), NoneVal)
+       For(Name("value"), Name("l"), sortThirdBody)
+       Return(Name("result"))
+       .Stmts
+
+  syntax Val ::= "sortThirdClosure" [function, total]
+  rule sortThirdClosure
+    => closureVal(("l", .ParamNames), sortThirdFunctionBody, 0)
+
+  // The exact program emitted in solution.mpy, named so that specifications
+  // can start from the normal MPY module loader without duplicating the AST.
+  syntax Module ::= "sortThirdModule" [function, total]
+  rule sortThirdModule
+    => Module(
+         FuncDef(
+           "sort_third",
+           Params("l"),
+           sortThirdFunctionBody))
+
+  // Mathematical fold describing the loop. SORTED is the trusted ascending
+  // sort of the input's every-third slice.  I is the original list index and
+  // ACC is the prefix already constructed by the implementation.
+  syntax Val ::= thirdValue(Val, ValSeq, Int) [function, total]
+  rule thirdValue(_:Val, SORTED:ValSeq, I:Int)
+    => valSeqAt(SORTED, (I -Int pyMod(I, 3)) /Int 3)
+    requires pyMod(I, 3) ==Int 0
+  rule thirdValue(V:Val, _:ValSeq, I:Int) => V
+    requires pyMod(I, 3) =/=Int 0
+
+  syntax ValSeq ::= sortThirdAcc(ValSeq, ValSeq, Int, ValSeq)
+                    [function, total]
+  rule sortThirdAcc(.ValSeq, _:ValSeq, _:Int, ACC:ValSeq) => ACC
+  rule sortThirdAcc(vCons(V:Val, REST:ValSeq), SORTED:ValSeq,
+                    I:Int, ACC:ValSeq)
+    => sortThirdAcc(
+         REST,
+         SORTED,
+         I +Int 1,
+         valSeqConcat(
+           ACC,
+           vCons(thirdValue(V, SORTED, I), .ValSeq)))
+
+  syntax Val ::= lastLoopValue(ValSeq, Val) [function, total]
+  rule lastLoopValue(.ValSeq, OLD:Val) => OLD
+  rule lastLoopValue(vCons(V:Val, REST:ValSeq), _:Val)
+    => lastLoopValue(REST, V)
+
+  syntax ValSeq ::= sortThird(ValSeq) [function, total]
+  rule sortThird(INPUT:ValSeq)
+    => sortThirdAcc(
+         INPUT,
+         sortVS(buildVS(INPUT, 0, vsLen(INPUT), 3)),
+         0,
+         .ValSeq)
+endmodule

codex
Concrete K execution passes the prompt examples and additional empty, negative, and longer-list cases; 4,000 randomized CPython differential cases also match the slice-assignment oracle. The full unfiltered `kprove spec.k` run has already returned `#Top`; I’m replaying the exact `prove.sh` workflow once end to end.
exec
/bin/bash -lc ./prove.sh in /work
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..fafa3077d82d7d0bc989387805e51f9d37edff6b
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,30 @@
+def sort_third(l: list):
+    """Sort the elements whose indices are divisible by three."""
+    thirds = sorted(l[::3])
+    result = []
+    i = 0
+    value = None
+    for value in l:
+        if i % 3 == 0:
+            result.append(thirds[i // 3])
+        else:
+            result.append(value)
+        i += 1
+    return result
+
+
+assert sort_third([]) == []
+assert sort_third([1, 2, 3]) == [1, 2, 3]
+assert sort_third([5, 6, 3, 4, 8, 9, 2]) == [2, 6, 3, 4, 8, 9, 5]
+assert sort_third([9, -1, 8, 6, -2, 5, 3, -3, 2, 0]) == [
+    0,
+    -1,
+    8,
+    3,
+    -2,
+    5,
+    6,
+    -3,
+    2,
+    9,
+]
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..81f1b4837ca0557a4244ff3927d043c2b97c582b
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Recreate the required translation from the submitted Python source.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Compile the supplied semantics' concrete LLVM entry point and exercise the
+# prompt examples plus edge cases.  Failed K assertions make krun exit nonzero.
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+python3 py2mpy.py concrete_tests.py > concrete-tests.mpy
+krun concrete-tests.mpy --definition runtime-kompiled
+
+# Compile the symbolic definition without MPY-CONCRETE, then prove every claim
+# in spec.k.  Success prints #Top and exits zero.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
