\""},{"node":"KApply","label":{"node":"KLabel","name":"ref(_)_MPY-CORE_Val_Int","params":[]},"arity":1,"args":[{"node":"KVariable","name":"HT","sort":{"node":"KSort","name":"Int"}}]}]}]},{"node":"KApply","label":{"node":"KLabel","name":"parent(_)_MPY-CORE_Parent_Int","params":[]},"arity":1,"args":[{"node":"KToken","sort":{"node":"KSort","name":"Int"},"token":"0"}]}]}]},{"node":"KVariable","name":"RESTSCOPES","sort":{"node":"KSort","name":"Map"}}]}]},{"node":"KVariable","name":"_Gen1","sort":{"node":"KSort","name":"ScopeLocCell"}},{"node":"KApply","label":{"node":"KLabel","name":"<heap>","params":[]},"arity":1,"args":[{"node":"KApply","label":{"node":"KLabel","name":"_Map_","params":[]},"arity":2,"args":[{"node":"KApply","label":{"node":"KLabel","name":"_Map_","params":[]},"arity":2,"args":[{"node":"KApply","label":{"node":"KLabel","name":"_|->_","params":[]},"arity":2,"args":[{"node":"KVariable","name":"HT","sort":{"node":"KSort","name":"Int"}},{"node":"KApply","label":{"node":"KLabel","name":"list(_)_MPY-CORE_Iterable_ValSeq","params":[]},"arity":1,"args":[{"node":"KVariable","name":"SORTED","sort":{"node":"KSort","name":"ValSeq"}}]}]},{"node":"KApply","label":{"node":"KLabel","name":"_|->_","params":[]},"arity":2,"args":[{"node":"KVariable","name":"HR","sort":{"node":"KSort","name":"Int"}},{"node":"KApply","label":{"node":"KLabel","name":"list(_)_MPY-CORE_Iterable_ValSeq","params":[]},"arity":1,"args":[{"node":"KRewrite","lhs":{"node":"KVariable","name":"ACC","sort":{"node":"KSort","name":"ValSeq"}},"rhs":{"node":"KApply","label":{"node":"KLabel","name":"sortThirdAcc(_,_,_,_)_VERIFICATION_ValSeq_ValSeq_ValSeq_Int_ValSeq","params":[]},"arity":4,"args":[{"node":"KVariable","name":"INPUT","sort":{"node":"KSort","name":"ValSeq"}},{"node":"KVariable","name":"SORTED","sort":{"node":"KSort","name":"ValSeq"}},{"node":"KVariable","name":"I","sort":{"node":"KSort","name":"Int"}},{"node":"KVariable","name":"ACC","sort":{"node":"KSort","name":"ValSeq"}}]}}]}]}]},{"node":"KVariable","name":"RESTHEAP","sort":{"node":"KSort","name":"Map"}}]}]},{"node":"KVariable","name":"_Gen2","sort":{"node":"KSort","name":"HeapLocCell"}},{"node":"KVariable","name":"_Gen3","sort":{"node":"KSort","name":"StackCell"}},{"node":"KVariable","name":"_Gen4","sort":{"node":"KSort","name":"RetCell"}},{"node":"KVariable","name":"_Gen5","sort":{"node":"KSort","name":"ExcCell"}},{"node":"KVariable","name":"_Gen6","sort":{"node":"KSort","name":"ExitCodeCell"}},{"node":"KApply","label":{"node":"KLabel","name":"<generatedCounter>","params":[]},"arity":1,"args":[{"node":"KRewrite","lhs":{"node":"KVariable","name":"_Gen0","sort":{"node":"KSort","name":"Int"}},"rhs":{"node":"KVariable","name":"?_Gen1","sort":{"node":"KSort","name":"Int"}}}]}]},"requires":{"node":"KApply","label":{"node":"KLabel","name":"_>=Int_","params":[]},"arity":2,"args":[{"node":"KVariable","name":"I","sort":{"node":"KSort","name":"Int"}},{"node":"KToken","sort":{"node":"KSort","name":"Int"},"token":"0"}]},"ensures":{"node":"KToken","sort":{"node":"KSort","name":"Bool"},"token":"true"},"att":{"node":"KAtt","att":{"org.kframework.definition.Production":{"node":"KProduction","klabel":{"node":"KLabel","name":"#ruleRequires","params":[]},"productionItems":[{"node":"KNonTerminal","sort":{"node":"KSort","name":"#RuleBody"}},{"node":"KTerminal","value":"requires"},{"node":"KNonTerminal","sort":{"node":"KSort","name":"Bool"}}],"params":[],"sort":{"node":"KSort","name":"#RuleContent"},"att":{"node":"KAtt","att":{"symbol":"#ruleRequires","org.kframework.attributes.Location":[346,27,346,94],"org.kframework.attributes.Source":"/usr/include/kframework/builtin/kast.md"}}},"UNIQUE_ID":"d80738bdc7080a350136a9bcd7fb523160c9b70edcd6daf1394528128fceb9ba","label":"SPEC.sort-third-loop","org.kframework.attributes.Source":"/work/spec.k","org.kframework.attributes.Location":[10,5,33,23]}}}],"att":{"node":"KAtt","att":{"org.kframework.attributes.Location":[3,1,66,10],"org.kframework.attributes.Source":"/work/spec.k","digest"