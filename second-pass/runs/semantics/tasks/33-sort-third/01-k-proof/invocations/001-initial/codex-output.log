\""},{"node":"KApply","label":{"node":"KLabel","name":"ref(_)_MPY-CORE_Val_Int","params":[]},"arity":1,"args":[{"node":"KVariable","name":"HT","sort":{"node":"KSort","name":"Int"}}]}]}]},{"node":"KApply","label":{"node":"KLabel","name":"parent(_)_MPY-CORE_Parent_Int","params":[]},"arity":1,"args":[{"node":"KToken","sort":{"node":"KSort","name":"Int"},"token":"0"}]}]}]},{"node":"KVariable","name":"RESTSCOPES","sort":{"node":"KSort","name":"Map"}}]}]},{"node":"KVariable","name":"_Gen1","sort":{"node":"KSort","name":"ScopeLocCell"}},{"node":"KApply","label":{"node":"KLabel","name":"<heap>","params":[]},"arity":1,"args":[{"node":"KApply","label":{"node":"KLabel","name":"_Map_","params":[]},"arity":2,"args":[{"node":"KApply","label":{"node":"KLabel","name":"_Map_","params":[]},"arity":2,"args":[{"node":"KApply","label":{"node":"KLabel","name":"_|->_","params":[]},"arity":2,"args":[{"node":"KVariable","name":"HT","sort":{"node":"KSort","name":"Int"}},{"node":"KApply","label":{"node":"KLabel","name":"list(_)_MPY-CORE_Iterable_ValSeq","params":[]},"arity":1,"args":[{"node":"KVariable","name":"SORTED","sort":{"node":"KSort","name":"ValSeq"}}]}]},{"node":"KApply","label":{"node":"KLabel","name":"_|->_","params":[]},"arity":2,"args":[{"node":"KVariable","name":"HR","sort":{"node":"KSort","name":"Int"}},{"node":"KApply","label":{"node":"KLabel","name":"list(_)_MPY-CORE_Iterable_ValSeq","params":[]},"arity":1,"args":[{"node":"KRewrite","lhs":{"node":"KVariable","name":"ACC","sort":{"node":"KSort","name":"ValSeq"}},"rhs":{"node":"KApply","label":{"node":"KLabel","name":"sortThirdAcc(_,_,_,_)_VERIFICATION_ValSeq_ValSeq_ValSeq_Int_ValSeq","params":[]},"arity":4,"args":[{"node":"KVariable","name":"INPUT","sort":{"node":"KSort","name":"ValSeq"}},{"node":"KVariable","name":"SORTED","sort":{"node":"KSort","name":"ValSeq"}},{"node":"KVariable","name":"I","sort":{"node":"KSort","name":"Int"}},{"node":"KVariable","name":"ACC","sort":{"node":"KSort","name":"ValSeq"}}]}}]}]}]},{"node":"KVar