      "source_rule_id": "rule-30f896f4a78788a4df1bfd241f27a89c6a07e729eefa54e20e31be5cceb2c6bb",
      "start_line": 7,
      "text": "  rule sortThirdBody\n    => If(Compare(BinOp(\"%\", Name(\"i\"), Int(3)),\n                  CmpOp(\"==\", Int(0))),\n         Expr(\n           Call(\n             Attribute(Name(\"result\"), \"append\"),\n             Subscript(\n               Name(\"thirds\"),\n               BinOp(\"//\", Name(\"i\"), Int(3))))),\n         Expr(\n           Call(\n             Attribute(Name(\"result\"), \"append\"),\n             Name(\"value\"))))\n       AugAssign(Name(\"i\"), \"+\", Int(1))\n       .Stmts"
    },
    {
      "attributes": [],
      "end_line": 36,
      "module": "VERIFICATION",
      "normalized_sha256": "21093175dbb8f2943626cf550979b0da747b2af38d29798aa0321b8a05e4bb0c",
      "source_rule_id": "rule-21093175dbb8f2943626cf550979b0da747b2af38d29798aa0321b8a05e4bb0c",
      "start_line": 24,
      "text": "  rule sortThirdFunctionBody\n    => Expr(Str(\"Sort the elements whose indices are divisible by three.\"))\n       Assign(\n         Name(\"thirds\"),\n         Call(\n           Name(\"sorted\"),\n           Subscript(Name(\"l\"), Slice(NoBound, NoBound, Int(3)))))\n       Assign(Name(\"result\"), ListExpr(.Exprs))\n       Assign(Name(\"i\"), Int(0))\n       Assign(Name(\"value\"), NoneVal)\n       For(Name(\"value\"), Name(\"l\"), sortThirdBody)\n       Return(Name(\"result\"))\n       .Stmts"
    },
    {
      "attributes": [],
      "end_line": 40,
      "module": "VERIFICATION",
      "normalized_sha256": "7c593d3abb10208b9212ec827fa30fc4ff49f3dfa4acc1d6d12a35777a7a8b39",
      "source_rule_id": "rule-7c593d3abb10208b9212ec827fa30fc4ff49f3dfa4acc1d6d12a35777a7a8b39",
      "start_line": 39,
      "text": "  rule sortThirdClosure\n    => closureVal((\"l\", .ParamNames), sortThirdFunctionBody, 0)"
    },
    {
      "attributes": [],
      "end_line": 50,
      "module": "VERIFICATION",
      "normalized_sha256": "10b3747ff64f7edc5c2b2739b560b4381fc410dad54630e3f5c2a3f0a1b3d3de",
      "source_rule_id": "rule-10b3747ff64f7edc5c2b2739b560b4381fc410dad54630e3f5c2a3f0a1b3d3de",
      "start_line": 45,
      "text": "  rule sortThirdModule\n    => Module(\n         FuncDef(\n           \"sort_third\",\n           Params(\"l\"),\n           sortThirdFunctionBody))"
    },
    {
      "attributes": [],
      "end_line": 58,
      "module": "VERIFICATION",
