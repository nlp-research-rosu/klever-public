      "source_rule_id": "rule-6bf57cc70b116bf57d62cb53019c3bc3a8afd519690929ee08b6bb00a2334384",
      "start_line": 56,
      "text": "  rule thirdValue(_:Val, SORTED:ValSeq, I:Int)\n    => valSeqAt(SORTED, (I -Int pyMod(I, 3)) /Int 3)\n    requires pyMod(I, 3) ==Int 0"
    },
    {
      "attributes": [],
      "end_line": 60,
      "module": "VERIFICATION",
      "normalized_sha256": "d67c9157105f75b20f186a8416a8374e66a206669477ae93c784de085518a12d",
