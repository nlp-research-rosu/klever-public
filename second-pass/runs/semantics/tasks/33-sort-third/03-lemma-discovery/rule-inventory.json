      "start_line": 65,
      "text": "  rule sortThirdAcc(vCons(V:Val, REST:ValSeq), SORTED:ValSeq,\n                    I:Int, ACC:ValSeq)\n    => sortThirdAcc(\n         REST,\n         SORTED,\n         I +Int 1,\n         valSeqConcat(\n           ACC,\n           vCons(thirdValue(V, SORTED, I), .ValSeq)))"
    },
