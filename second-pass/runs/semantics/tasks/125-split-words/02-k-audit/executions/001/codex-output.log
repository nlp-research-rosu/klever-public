+        "$proofPath" |-> 2
+        "txt" |-> str(iCons(97, iCons(98, iCons(99, .IntSeq)))),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
+  claim [path3-true-forces-second-else]:
