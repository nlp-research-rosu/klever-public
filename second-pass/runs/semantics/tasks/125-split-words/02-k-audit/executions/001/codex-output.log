+    echo "SYMLINK $path -> $(readlink "$path")"
+  elif [ -e "$path" ]; then
+    stat -c '%F %s %n' "$path"
+  else
+    echo "MISSING $path"
+  fi
+done
+
+echo 'SOURCE_HASHES:'
+sha256sum \
+  "$candidate/prompt.py" \
+  "$reference/prompt.py" \
+  "$candidate/py2mpy.py" \
+  "$reference/py2mpy.py" \
+  "$candidate/solution.py" \
+  "$candidate/solution.mpy" \
+  "$candidate/spec.k" \
+  "$candidate/verification.k"
+
+exit 0

