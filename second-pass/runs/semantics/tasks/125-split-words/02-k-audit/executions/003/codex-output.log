+#!/usr/bin/env bash
+set -u
+set -o pipefail
+
+cd /tmp/audit-work/125-split-words
+
+echo '$ python3 /audit-output/evidence/04_generate_pinning.py'
+python3 /audit-output/evidence/04_generate_pinning.py
+echo "generate_pinning_exit=$?"
+
