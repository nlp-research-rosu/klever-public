@@ -0,0 +1,58 @@
+#!/usr/bin/env bash
+set -u
+set -o pipefail
+
+cd /tmp/audit-work/125-split-words
+
+echo '$ kompile --version; krun --version; kprove --version'
+kompile --version
+krun --version
