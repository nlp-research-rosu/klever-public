/bin/bash -lc 'bash /audit-output/evidence/04_pinning.sh > /audit-output/evidence/04_pinning.log 2>&1; status=$?; echo pinning_script_exit=$status; rg -n '"'"'^'"\\"'$|''^#Top$|_exit=|extracted|wrote|'"\\[Error\\]|WarnStuck' /audit-output/evidence/04_pinning.log" in /audit-output
