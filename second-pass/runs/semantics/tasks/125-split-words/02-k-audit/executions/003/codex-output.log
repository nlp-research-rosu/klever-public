+
+echo '$ kompile verification-no-bridges.k --backend haskell --main-module SPLIT-WORDS-NO-BRIDGES --syntax-module MPY-SYNTAX --output-definition audit-no-bridges-kompiled'
+kompile verification-no-bridges.k \
