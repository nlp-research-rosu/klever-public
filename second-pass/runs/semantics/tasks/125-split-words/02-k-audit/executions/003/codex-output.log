@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+set -u
+set -o pipefail
+
+cd /tmp/audit-work/125-split-words
+cp /audit-output/evidence/05_bridge_false_witnesses.k bridge-false-witnesses.k
