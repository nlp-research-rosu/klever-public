+assert split_words(",") == ["", ""]
+assert split_words("") == 0
+'''
+(WORK / "audit-ground-witnesses.py").write_text(source + tests, encoding="utf-8")
+print("wrote=", WORK / "audit-ground-witnesses.py", sep="")
