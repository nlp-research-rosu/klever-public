+  claim <k>
+          runDoAlgebra(
+            vCons(plusV, .ValSeq),
+            vCons(A:Int, vCons(B:Int, .ValSeq)))
+          => (A +Int B) +Int 1
+        </k>
+        <env> 0 </env>
+        <scopes>
+          (0 |-> scope(.Map, parent(-1)))
+          (-1 |-> builtinsScope)
+          => ?FINAL_SCOPES:Map
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <heap> .Map </heap>
+        <heapLoc> 0 </heapLoc>
+        <stack> .List </stack>
+        <ret> noRet </ret>
+        <exc> NoExc </exc>
+        <exit-code> 0 </exit-code>
