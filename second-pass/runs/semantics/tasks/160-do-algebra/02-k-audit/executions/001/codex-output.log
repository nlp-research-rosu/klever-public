+#!/usr/bin/env bash
+set -u
+
+LOG=/audit-output/evidence/01_integrity.log
+: > "$LOG"
+
+run() {
+  printf 'COMMAND: ' >> "$LOG"
+  printf '%q ' "$@" >> "$LOG"
+  printf '\n' >> "$LOG"
+  "$@" >> "$LOG" 2>&1
+  status=$?
+  printf 'EXIT: %d\n\n' "$status" >> "$LOG"
+  return 0
+}
+
+run pwd
+run kompile --version
+run kprove --version
+run find /candidate /reference -printf '%y %p -> %l\n'
+
