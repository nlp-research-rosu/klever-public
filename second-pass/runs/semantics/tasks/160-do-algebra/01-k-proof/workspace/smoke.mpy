Module(
  FuncDef("_evaluate", Params("operator", "operand", "start", "end", "level"),
    If(Compare(Name("level"), CmpOp("==", Int(0))),
      Assign(Name("i"), BinOp("-", Name("end"), Int(1)))
      While(Compare(Name("i"), CmpOp(">=", Name("start"))),
        If(Compare(
          Subscript(Name("operator"), Name("i")),
          CmpOp("==", Str("+"))),
          Return(
            BinOp(
              "+",
              Call(
                Name("_evaluate"),
                Name("operator"),
                Name("operand"),
                Name("start"),
                Name("i"),
                Int(0)),
              Call(
                Name("_evaluate"),
                Name("operator"),
                Name("operand"),
                BinOp("+", Name("i"), Int(1)),
                Name("end"),
                Int(1)))),
          )
        If(Compare(
          Subscript(Name("operator"), Name("i")),
          CmpOp("==", Str("-"))),
          Return(
            BinOp(
              "-",
              Call(
                Name("_evaluate"),
                Name("operator"),
                Name("operand"),
                Name("start"),
                Name("i"),
                Int(0)),
              Call(
                Name("_evaluate"),
                Name("operator"),
                Name("operand"),
                BinOp("+", Name("i"), Int(1)),
                Name("end"),
                Int(1)))),
          )
        AugAssign(Name("i"), "-", Int(1)))
      Return(
        Call(
          Name("_evaluate"),
          Name("operator"),
          Name("operand"),
          Name("start"),
          Name("end"),
          Int(1))),
      )
    If(Compare(Name("level"), CmpOp("==", Int(1))),
      Assign(Name("i"), BinOp("-", Name("end"), Int(1)))
      While(Compare(Name("i"), CmpOp(">=", Name("start"))),
        If(Compare(
          Subscript(Name("operator"), Name("i")),
          CmpOp("==", Str("*"))),
          Return(
            BinOp(
              "*",
              Call(
                Name("_evaluate"),
                Name("operator"),
                Name("operand"),
                Name("start"),
                Name("i"),
                Int(1)),
              Call(
                Name("_evaluate"),
                Name("operator"),
                Name("operand"),
                BinOp("+", Name("i"), Int(1)),
                Name("end"),
                Int(2)))),
          )
        If(Compare(
          Subscript(Name("operator"), Name("i")),
          CmpOp("==", Str("//"))),
          Return(
            BinOp(
              "//",
              Call(
                Name("_evaluate"),
                Name("operator"),
                Name("operand"),
                Name("start"),
                Name("i"),
                Int(1)),
              Call(
                Name("_evaluate"),
                Name("operator"),
                Name("operand"),
                BinOp("+", Name("i"), Int(1)),
                Name("end"),
                Int(2)))),
          )
        AugAssign(Name("i"), "-", Int(1)))
      Return(
        Call(
          Name("_evaluate"),
          Name("operator"),
          Name("operand"),
          Name("start"),
          Name("end"),
          Int(2))),
      )
    If(Compare(Name("level"), CmpOp("==", Int(2))),
      Assign(Name("i"), Name("start"))
      While(Compare(Name("i"), CmpOp("<", Name("end"))),
        If(Compare(
          Subscript(Name("operator"), Name("i")),
          CmpOp("==", Str("**"))),
          Return(
            BinOp(
              "**",
              Call(
                Name("_evaluate"),
                Name("operator"),
                Name("operand"),
                Name("start"),
                Name("i"),
                Int(3)),
              Call(
                Name("_evaluate"),
                Name("operator"),
                Name("operand"),
                BinOp("+", Name("i"), Int(1)),
                Name("end"),
                Int(2)))),
          )
        AugAssign(Name("i"), "+", Int(1)))
      Return(
        Call(
          Name("_evaluate"),
          Name("operator"),
          Name("operand"),
          Name("start"),
          Name("end"),
          Int(3))),
      )
    Return(Subscript(Name("operand"), Name("start"))))
  FuncDef("do_algebra", Params("operator", "operand"),
    Return(
      Call(
        Name("_evaluate"),
        Name("operator"),
        Name("operand"),
        Int(0),
        Call(Name("len"), Name("operator")),
        Int(0))))
  Assert(Compare(Call(Name("do_algebra"), ListExpr(Str("+"), Str("*"), Str("-")), ListExpr(Int(2), Int(3), Int(4), Int(5))), CmpOp("==", Int(9))))
  Assert(Compare(Call(Name("do_algebra"), ListExpr(Str("-"), Str("-")), ListExpr(Int(20), Int(5), Int(3))), CmpOp("==", Int(12))))
  Assert(Compare(Call(Name("do_algebra"), ListExpr(Str("//"), Str("//")), ListExpr(Int(20), Int(3), Int(2))), CmpOp("==", Int(3))))
  Assert(Compare(Call(Name("do_algebra"), ListExpr(Str("**"), Str("**")), ListExpr(Int(2), Int(3), Int(2))), CmpOp("==", Int(512))))
  Assert(Compare(Call(Name("do_algebra"), ListExpr(Str("+"), Str("*"), Str("**"), Str("//"), Str("-")), ListExpr(Int(4), Int(3), Int(2), Int(3), Int(5), Int(1))), CmpOp("==", Int(7))))
)
