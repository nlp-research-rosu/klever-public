+    requires A >=Int 0 andBool B >=Int 0
+    [label(minus)]
+
+  claim <k>
+          runDoAlgebra(
+            vCons(timesV, .ValSeq),
+            vCons(A:Int, vCons(B:Int, .ValSeq)))
+          => A *Int B
+        </k>
+        <env> 0 </env>
+        <scopes>
+          (0 |-> scope(.Map, parent(-1)))
+          (-1 |-> builtinsScope)
+          => ?FINAL_SCOPES:Map
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <heap> .Map </heap>
+        <heapLoc> 0 </heapLoc>
