+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Each primitive operator is proved for arbitrary contract-valid operands.
+  claim <k>
+          runDoAlgebra(
+            vCons(plusV, .ValSeq),
+            vCons(A:Int, vCons(B:Int, .ValSeq)))
+          => A +Int B
+        </k>
