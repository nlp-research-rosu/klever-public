+        <scopes>
+          (0 |-> scope(.Map, parent(-1)))
+          (-1 |-> builtinsScope)
+          => ?FINAL_SCOPES:Map
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <heap> .Map </heap>
+        <heapLoc> 0 </heapLoc>
+        <stack> .List </stack>
+        <ret> noRet </ret>
+        <exc> NoExc </exc>
+        <exit-code> 0 </exit-code>
+    requires A >=Int 0 andBool B >Int 0
+    [label(floor)]
+
+  claim <k>
+          runDoAlgebra(
+            vCons(powerV, .ValSeq),
+            vCons(2, vCons(5, .ValSeq)))
