+  rule timesV    => str(iCons(42, .IntSeq)) [macro]
+  rule floorDivV => str(iCons(47, iCons(47, .IntSeq))) [macro]
+  rule powerV    => str(iCons(42, iCons(42, .IntSeq))) [macro]
+
+  syntax KItem ::= runDoAlgebra(ValSeq, ValSeq)
