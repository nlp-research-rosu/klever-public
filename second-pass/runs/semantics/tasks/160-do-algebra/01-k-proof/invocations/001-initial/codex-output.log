+          => ?FINAL_SCOPES:Map
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <heap> .Map </heap>
+        <heapLoc> 0 </heapLoc>
+        <stack> .List </stack>
+        <ret> noRet </ret>
+        <exc> NoExc </exc>
+        <exit-code> 0 </exit-code>
+    requires A >=Int 0 andBool B >=Int 0
+
+  claim <k>
+          runDoAlgebra(
+            vCons(minusV, .ValSeq),
