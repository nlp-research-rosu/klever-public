+  claim <k>
+          runDoAlgebra(
+            vCons(plusV,
+              vCons(timesV,
+                vCons(powerV,
+                  vCons(floorDivV, vCons(minusV, .ValSeq))))),
+            vCons(A:Int,
+              vCons(B:Int,
+                vCons(C:Int,
+                  vCons(D:Int, vCons(E:Int, vCons(F:Int, .ValSeq)))))))
+          => (A +Int floorQuot(B *Int (C ^Int D), E)) -Int F
+        </k>
