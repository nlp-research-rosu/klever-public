+        <scopes>
+          0 |-> scope("ord" |-> builtinV("len"), parent(-1))
+          -1 |-> builtinsScope
+          (1 |-> scope(
+             ("result" |-> str(.IntSeq))
+             ("char" |-> str(.IntSeq))
+             ("s" |-> str(iCons(97, .IntSeq))),
+             parent(0))
+           =>
+           1 |-> scope(
