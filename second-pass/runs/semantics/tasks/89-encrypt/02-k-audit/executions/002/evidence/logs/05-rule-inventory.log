END_ENTRY

ENTRY 0866 FILE=/reference/reference-semantics/semantics/subscript.k LINE=44 KIND=syntax ATTRIBUTES=-
  syntax KItem ::= #evalB(Bound) | "#toSome"
                 | #slLo(Val, Bound, Bound)
                 | #slHi(Val, OptInt, Bound)
                 | #slStep(Val, OptInt, OptInt)
END_ENTRY

ENTRY 0867 FILE=/reference/reference-semantics/semantics/subscript.k LINE=49 KIND=syntax ATTRIBUTES=-
