  rule lastChar(iCons(C:Int, CS:IntSeq), _:Str)
    => lastChar(CS, str(iCons(C, .IntSeq)))
END_ENTRY

ENTRY 0012 FILE=/candidate/verification.k LINE=27 KIND=syntax ATTRIBUTES=macro
  syntax Stmts ::= "encryptLoopBody" [macro]
END_ENTRY

ENTRY 0013 FILE=/candidate/verification.k LINE=28 KIND=rule ATTRIBUTES=-
  rule encryptLoopBody
    => AugAssign(
         Name("result"),
         "+",
         Call(
           Name("chr"),
           BinOp(
             "+",
             BinOp(
               "%",
               BinOp(
                 "+",
                 BinOp("-", Call(Name("ord"), Name("char")), Int(97)),
                 Int(4)),
               Int(26)),
             Int(97))))
       .Stmts
END_ENTRY

ENTRY 0014 FILE=/candidate/verification.k LINE=46 KIND=syntax ATTRIBUTES=macro
  syntax Stmts ::= "encryptFunctionBody" [macro]
END_ENTRY

ENTRY 0015 FILE=/candidate/verification.k LINE=47 KIND=rule ATTRIBUTES=-
  rule encryptFunctionBody
    => Assign(Name("result"), Str(""))
       Assign(Name("char"), Str(""))
       For(Name("char"), Name("s"), encryptLoopBody)
       Return(Name("result"))
       .Stmts
END_ENTRY

ENTRY 0016 FILE=/candidate/verification.k LINE=54 KIND=syntax ATTRIBUTES=macro
  syntax Val ::= "encryptClosure" [macro]
END_ENTRY

ENTRY 0017 FILE=/candidate/verification.k LINE=55 KIND=rule ATTRIBUTES=-
  rule encryptClosure
    => closureVal("s", encryptFunctionBody, 0)
END_ENTRY

