ENTRY 0906 FILE=/reference/reference-semantics/semantics/syntax.k LINE=9 KIND=syntax ATTRIBUTES=macro
  syntax Expr ::= "Int"      "(" Int ")"
                | "Float"    "(" Float ")"
                | "Bool"     "(" Bool ")"
                | "Name"     "(" String ")"
                | "Str"      "(" String ")"
                | "UnaryOp"  "(" String "," Expr ")" [strict(2)]
                | "BinOp"    "(" String "," Expr "," Expr ")" [seqstrict(2, 3)]
                | "BoolOp"    "(" String "," Exprs ")"
                | "ListExpr"  "(" Exprs ")"
                | "DictExpr"  "(" Entries ")"
                | "ListComp"  "(" Expr "," CompFors ")" [macro]
                | "GenExp"    "(" Expr "," CompFors ")" [macro]
                | "TupleExpr" "(" Exprs ")"
                | "Subscript" "(" Expr "," Index ")"
                | "IfExp"     "(" Expr "," Expr "," Expr ")" [strict(1)]
                | "Lambda"    "(" Params "," Expr ")"
                | "KwArg"     "(" String "," Expr ")"
                | "Lambda"    "(" Params "," CellVars "," FreeVars "," Expr ")"
                | "NoneVal"
                | "Call"      "(" Expr "," Exprs ")"
                | "Attribute" "(" Expr "," String ")" [strict(1)]
                | "Compare"   "(" Expr "," CmpOp ")"
END_ENTRY

ENTRY 0907 FILE=/reference/reference-semantics/semantics/syntax.k LINE=32 KIND=syntax ATTRIBUTES=-
  syntax CmpOp    ::= "CmpOp" "(" String "," Expr ")"
END_ENTRY

ENTRY 0908 FILE=/reference/reference-semantics/semantics/syntax.k LINE=33 KIND=syntax ATTRIBUTES=-
  syntax Entry    ::= "Entry" "(" Expr "," Expr ")"
END_ENTRY

ENTRY 0909 FILE=/reference/reference-semantics/semantics/syntax.k LINE=34 KIND=syntax ATTRIBUTES=-
  syntax Entries  ::= List{Entry, ","}
END_ENTRY

ENTRY 0910 FILE=/reference/reference-semantics/semantics/syntax.k LINE=35 KIND=syntax ATTRIBUTES=-
  syntax CompFor  ::= "CompFor" "(" Expr "," Expr "," Exprs ")"
END_ENTRY

ENTRY 0911 FILE=/reference/reference-semantics/semantics/syntax.k LINE=36 KIND=syntax ATTRIBUTES=-
  syntax CompFors ::= List{CompFor, ""}
END_ENTRY

ENTRY 0912 FILE=/reference/reference-semantics/semantics/syntax.k LINE=37 KIND=syntax ATTRIBUTES=-
  syntax Exprs    ::= List{Expr, ","}
END_ENTRY

ENTRY 0913 FILE=/reference/reference-semantics/semantics/syntax.k LINE=38 KIND=syntax ATTRIBUTES=-
  syntax Index    ::= Expr | "Slice" "(" Bound "," Bound "," Bound ")"
END_ENTRY

ENTRY 0914 FILE=/reference/reference-semantics/semantics/syntax.k LINE=39 KIND=syntax ATTRIBUTES=-
  syntax Bound    ::= Expr | "NoBound"
END_ENTRY

ENTRY 0915 FILE=/reference/reference-semantics/semantics/syntax.k LINE=41 KIND=syntax ATTRIBUTES=-
  syntax Stmt ::= "Assign"    "(" Expr "," Expr ")" [strict(2)]
                | "Import"    "(" String ")"
                | "ImportFrom" "(" String "," ParamNames ")"
                | "AugAssign" "(" Expr "," String "," Expr ")" [strict(3)]
                | "For"       "(" Expr "," Expr "," Stmts ")" [strict(2)]
                | "While"     "(" Expr "," Stmts ")"
                | "Break"
                | "Continue"
                | "If"        "(" Expr "," Stmts "," Stmts ")" [strict(1)]
                | "Return"    "(" Expr ")" [strict]
                | "Assert"    "(" Expr ")" [strict]
                | "Expr"      "(" Expr ")" [strict]
                | "FuncDef"   "(" String "," Params "," Stmts ")"
                | "FuncDef"   "(" String "," Params "," CellVars "," FreeVars "," Stmts ")"
END_ENTRY

ENTRY 0916 FILE=/reference/reference-semantics/semantics/syntax.k LINE=56 KIND=syntax ATTRIBUTES=-
  syntax Stmts      ::= List{Stmt, ""}
END_ENTRY

ENTRY 0917 FILE=/reference/reference-semantics/semantics/syntax.k LINE=57 KIND=syntax ATTRIBUTES=-
