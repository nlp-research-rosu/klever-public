ENTRY 0001 FILE=/candidate/spec.k LINE=6 KIND=claim ATTRIBUTES=-
  claim <k>
          #loop(str(CS:IntSeq), Name("char"), encryptLoopBody)
          => .K
        </k>
        <env> 1 </env>
        <scopes>
          0 |-> scope("encrypt" |-> encryptClosure, parent(-1))
          -1 |-> builtinsScope
          (1 |-> scope(
             ("result" |-> str(A:IntSeq))
             ("char" |-> OLD:Str)
             ("s" |-> str(INPUT:IntSeq)),
             parent(0))
           =>
           1 |-> scope(
             ("result" |-> str(encryptAcc(A, CS)))
             ("char" |-> lastChar(CS, OLD))
             ("s" |-> str(INPUT)),
             parent(0)))
        </scopes>
        <heap> .Map </heap>
END_ENTRY

