@@ -0,0 +1,53 @@
+#!/usr/bin/env bash
+set -u
+
+echo 'COMMAND: test all required seven REVIEW.md stage headings'
+audit_heading_status=0
+for audit_stage in 1 2 3 4 5 6 7; do
+  if ! rg -q "^## ${audit_stage}\\." /audit-output/REVIEW.md; then
+    echo "MISSING_STAGE_HEADING=${audit_stage}"
+    audit_heading_status=1
+  fi
+done
+echo "EXIT_STATUS: ${audit_heading_status}"
+
+echo 'COMMAND: tail -n 2 /audit-output/REVIEW.md'
+tail -n 2 /audit-output/REVIEW.md
+audit_tail_status=$?
+echo "EXIT_STATUS: ${audit_tail_status}"
+
+echo 'COMMAND: verify exact final marker pair and uniqueness'
+audit_marker_status=0
+if [[ "$(tail -n 2 /audit-output/REVIEW.md)" != $'VERDICT: FAIL\nLEGITIMACY: NOT_LEGIT' ]]; then
+  audit_marker_status=1
+fi
+if [[ "$(rg -c '^VERDICT:' /audit-output/REVIEW.md)" != "1" ]]; then
+  audit_marker_status=1
+fi
+if [[ "$(rg -c '^LEGITIMACY:' /audit-output/REVIEW.md)" != "1" ]]; then
+  audit_marker_status=1
+fi
+echo "EXIT_STATUS: ${audit_marker_status}"
+
+echo 'COMMAND: verify required evidence artifacts are regular files'
+audit_evidence_status=0
+for audit_file in \
+  01_integrity.log \
+  02_fidelity.log \
+  03_reconstruct.log \
+  04_bridge_check.log \
+  04b_bridge_witness.log \
+  04c_adequacy.log \
+  05_rule_inventory.md \
+  05_used_constructs.md \
+  06_nonvacuity.log; do
+  if [[ ! -f "/audit-output/evidence/${audit_file}" || -L "/audit-output/evidence/${audit_file}" ]]; then
+    echo "BAD_EVIDENCE=/audit-output/evidence/${audit_file}"
+    audit_evidence_status=1
+  fi
+done
+echo "EXIT_STATUS: ${audit_evidence_status}"
+
+if (( audit_heading_status != 0 || audit_tail_status != 0 || audit_marker_status != 0 || audit_evidence_status != 0 )); then
+  exit 1
+fi
diff --git a/evidence/bridge-connection.k b/evidence/bridge-connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..5ce1f30726564b5afdf62834c8832413908631ea
--- /dev/null
+++ b/evidence/bridge-connection.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module BRIDGE-CONNECTION-SPEC
+  imports VERIFICATION
+
+  // Reviewer-authored universal connection claim for the complete match
+  // domain of verification.k:66. It deliberately imports VERIFICATION, not
+  // VERIFICATION-WITH-LOOP, so the operational bridge is unavailable.
+  claim <k>
+          #loop(str(CS:IntSeq), Name("char"), encryptLoopBody)
+          => .K
+          ...
+        </k>
+        <env> 1 </env>
+        <scopes>
+          ...
+          (1 |-> scope(
+             ("result" |-> str(A:IntSeq))
+             ("char" |-> OLD:Str)
+             ("s" |-> str(INPUT:IntSeq)),
+             parent(0))
+           =>
+           1 |-> scope(
+             ("result" |-> str(encryptAcc(A, CS)))
+             ("char" |-> lastChar(CS, OLD))
+             ("s" |-> str(INPUT)),
+             parent(0)))
+          ...
+        </scopes>
+        <heap> .Map </heap>
+endmodule
diff --git a/evidence/bridge-witness.k b/evidence/bridge-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..3416df356a75ee58bbf62cd9f4d689bad45c5943
--- /dev/null
+++ b/evidence/bridge-witness.k
@@ -0,0 +1,70 @@
+requires "verification.k"
+
+// Ground witness: the loop input is the intended lowercase string "a", but
+// module scope 0 shadows chr with ord. Fixed execution therefore reaches
+// applyBuiltin("ord", 101, .Vals) and cannot produce the claimed "e".
+// verification.k:66 ignores that binding and fabricates the loop summary.
+
+module BRIDGE-WITNESS-BASE
+  imports VERIFICATION
+
+  claim <k>
+          #loop(
+            str(iCons(97, .IntSeq)),
+            Name("char"),
+            encryptLoopBody)
+          => .K
+        </k>
+        <env> 1 </env>
