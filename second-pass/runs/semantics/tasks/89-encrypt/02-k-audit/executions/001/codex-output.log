+        <heapLoc> 0 </heapLoc>
+        <stack> .List </stack>
+        <ret> noRet </ret>
+        <exc> NoExc </exc>
+
+  claim [uppercase-A]:
+        <k>
+          Call(Name("encrypt"), str(iCons(65, .IntSeq)))
+          =>
+          str(iCons(121, .IntSeq))
+        </k>
+        <env> 0 </env>
+        <scopes>
+          0  |-> scope("encrypt" |-> encryptClosure, parent(-1))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <heap> .Map </heap>
+        <heapLoc> 0 </heapLoc>
+        <stack> .List </stack>
+        <ret> noRet </ret>
+        <exc> NoExc </exc>
+endmodule
