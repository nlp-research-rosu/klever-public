index 0000000000000000000000000000000000000000..46fcc67f55698411568bb5f8637d8afe2db70361
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,24 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION-WITH-LOOP
+
+  // Fresh false result mutation of FUNCTION-SPEC. The original empty-input
+  // result is str(.IntSeq); this mutation demands the one-character string
+  // "x" (code 120) from the same satisfiable initial state.
+  claim <k>
+          Call(Name("encrypt"), str(.IntSeq))
+          => str(iCons(120, .IntSeq))
+        </k>
+        <env> 0 </env>
+        <scopes>
+          0  |-> scope("encrypt" |-> encryptClosure, parent(-1))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <heap> .Map </heap>
+        <heapLoc> 0 </heapLoc>
+        <stack> .List </stack>
+        <ret> noRet </ret>
+        <exc> NoExc </exc>
+endmodule

exec
/bin/bash -lc "chmod +x /audit-output/evidence/05_inventory_check.sh /audit-output/evidence/06_nonvacuity.sh
script -q -e -c '/audit-output/evidence/05_inventory_check.sh' /audit-output/evidence/05_inventory_check.log
script -q -e -c '/audit-output/evidence/06_nonvacuity.sh' /audit-output/evidence/06_nonvacuity.log" in /audit-output
