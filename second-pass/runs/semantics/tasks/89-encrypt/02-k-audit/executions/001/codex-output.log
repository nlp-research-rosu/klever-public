diff --git a/evidence/bridge-connection.k b/evidence/bridge-connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..5ce1f30726564b5afdf62834c8832413908631ea
--- /dev/null
+++ b/evidence/bridge-connection.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module BRIDGE-CONNECTION-SPEC
+  imports VERIFICATION
+
+  // Reviewer-authored universal connection claim for the complete match
+  // domain of verification.k:66. It deliberately imports VERIFICATION, not
+  // VERIFICATION-WITH-LOOP, so the operational bridge is unavailable.
+  claim <k>
+          #loop(str(CS:IntSeq), Name("char"), encryptLoopBody)
+          => .K
+          ...
+        </k>
+        <env> 1 </env>
+        <scopes>
+          ...
+          (1 |-> scope(
+             ("result" |-> str(A:IntSeq))
+             ("char" |-> OLD:Str)
+             ("s" |-> str(INPUT:IntSeq)),
+             parent(0))
+           =>
+           1 |-> scope(
+             ("result" |-> str(encryptAcc(A, CS)))
+             ("char" |-> lastChar(CS, OLD))
+             ("s" |-> str(INPUT)),
+             parent(0)))
+          ...
+        </scopes>
+        <heap> .Map </heap>
+endmodule
diff --git a/evidence/bridge-witness.k b/evidence/bridge-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..3416df356a75ee58bbf62cd9f4d689bad45c5943
--- /dev/null
+++ b/evidence/bridge-witness.k
@@ -0,0 +1,70 @@
+requires "verification.k"
+
+// Ground witness: the loop input is the intended lowercase string "a", but
+// module scope 0 shadows chr with ord. Fixed execution therefore reaches
+// applyBuiltin("ord", 101, .Vals) and cannot produce the claimed "e".
+// verification.k:66 ignores that binding and fabricates the loop summary.
+
+module BRIDGE-WITNESS-BASE
+  imports VERIFICATION
+
+  claim <k>
+          #loop(
+            str(iCons(97, .IntSeq)),
+            Name("char"),
+            encryptLoopBody)
+          => .K
+        </k>
+        <env> 1 </env>
+        <scopes>
+          0 |-> scope(
+            ("encrypt" |-> encryptClosure)
+            ("chr" |-> builtinV("ord")),
+            parent(-1))
+          -1 |-> builtinsScope
+          (1 |-> scope(
+             ("result" |-> str(.IntSeq))
+             ("char" |-> str(.IntSeq))
+             ("s" |-> str(iCons(97, .IntSeq))),
+             parent(0))
+           =>
+           1 |-> scope(
+             ("result" |-> str(iCons(101, .IntSeq)))
+             ("char" |-> str(iCons(97, .IntSeq)))
+             ("s" |-> str(iCons(97, .IntSeq))),
+             parent(0)))
+        </scopes>
+        <heap> .Map </heap>
+endmodule
+
+module BRIDGE-WITNESS-EXTENDED
+  imports VERIFICATION-WITH-LOOP
