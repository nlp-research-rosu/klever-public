Module(
  FuncDef("encrypt", Params("s"),
    Assign(Name("result"), Str(""))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("s"),
      AugAssign(
        Name("result"),
        "+",
        Call(
          Name("chr"),
          BinOp(
            "+",
            BinOp(
              "%",
              BinOp(
                "+",
                BinOp("-", Call(Name("ord"), Name("char")), Int(97)),
                Int(4)),
              Int(26)),
            Int(97)))))
    Return(Name("result")))
  Assert(
    Compare(Call(Name("encrypt"), Str("hi")), CmpOp("==", Str("lm"))))
  Assert(
    Compare(
      Call(Name("encrypt"), Str("asdfghjkl")),
      CmpOp("==", Str("ewhjklnop"))))
  Assert(
    Compare(Call(Name("encrypt"), Str("gf")), CmpOp("==", Str("kj"))))
  Assert(
    Compare(Call(Name("encrypt"), Str("et")), CmpOp("==", Str("ix"))))
  Assert(Compare(Call(Name("encrypt"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("encrypt"), Str("wxyz")),
      CmpOp("==", Str("abcd"))))
  Assert(
    Compare(
      Call(Name("encrypt"), Str("abcdefghijklmnopqrstuvwxyz")),
      CmpOp("==", Str("efghijklmnopqrstuvwxyzabcd")))))
