+  rule encryptLoopBody
+    => AugAssign(
+         Name("result"),
+         "+",
+         Call(
+           Name("chr"),
+           BinOp(
+             "+",
+             BinOp(
+               "%",
+               BinOp(
+                 "+",
+                 BinOp("-", Call(Name("ord"), Name("char")), Int(97)),
+                 Int(4)),
+               Int(26)),
+             Int(97))))
+       .Stmts
+
