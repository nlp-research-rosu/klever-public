+          Call(Name("encrypt"), str(CS:IntSeq))
+          => str(encryptCodes(CS))
+        </k>
+        <env> 0 </env>
+        <scopes>
+          0  |-> scope("encrypt" |-> encryptClosure, parent(-1))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <heap> .Map </heap>
