+             ("char" |-> OLD:Str)
+             ("s" |-> str(INPUT:IntSeq)),
+             parent(0))
+           =>
+           1 |-> scope(
+             ("result" |-> str(encryptAcc(A, CS)))
+             ("char" |-> lastChar(CS, OLD))
+             ("s" |-> str(INPUT)),
