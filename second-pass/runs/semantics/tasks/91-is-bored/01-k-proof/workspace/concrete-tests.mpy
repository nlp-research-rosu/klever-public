Module(
  FuncDef("is_bored", Params("S"),
    Assign(Name("count"), Int(0))
    Assign(Name("state"), Int(0))
    Assign(Name("ch"), Str(""))
    Assign(Name("code"), Int(0))
    For(Name("ch"), Name("S"),
      Assign(Name("code"), Call(Name("ord"), Name("ch")))
      If(BoolOp(
        "or",
        Compare(Name("code"), CmpOp("==", Int(46))),
        Compare(Name("code"), CmpOp("==", Int(63))),
        Compare(Name("code"), CmpOp("==", Int(33)))),
        Assign(Name("state"), Int(0)),
        If(Compare(Name("state"), CmpOp("==", Int(0))),
          If(BoolOp(
            "or",
            Compare(Name("code"), CmpOp("==", Int(32))),
            BoolOp(
              "and",
              Compare(Name("code"), CmpOp(">=", Int(9))),
              Compare(Name("code"), CmpOp("<=", Int(13))))),
            Assign(Name("state"), Int(0)),
            If(Compare(Name("code"), CmpOp("==", Int(73))),
              Assign(Name("state"), Int(1)),
              Assign(Name("state"), Int(2)))),
          If(Compare(Name("state"), CmpOp("==", Int(1))),
            If(Compare(Name("code"), CmpOp("==", Int(32))),
              AugAssign(Name("count"), "+", Int(1)),
              )
            Assign(Name("state"), Int(2)),
            ))))
    Return(Name("count")))
  Assert(
    Compare(
      Call(Name("is_bored"), Str("Hello world")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("is_bored"),
        Str("The sky is blue. The sun is shining. I love this weather")),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(
        Name("is_bored"),
        Str(
          "I am bored. I think. You are not!  I agree?Is this counted? Ironic.")),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("is_bored"),
        Str("  I start here!\tI tab-leading.\n\nI newline-leading")),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("is_bored"), Str("I. I? I!")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("is_bored"), Str("It is fine. Island time.")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("is_bored"), Str("You and I are going for a walk")),
      CmpOp("==", Int(0)))))
