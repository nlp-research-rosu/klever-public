+            else:
+                state = 2
+        elif state == 1:
+            if ch == " ":
+                count += 1
+            state = 2
+    return count
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0bd53a8184fdede68436f3f0ac49895e4afcca2e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,124 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant for state 0: the current sentence has contained only
+  // leading whitespace.
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("ch"), boredLoopBody)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => bored0(CS, N)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL:Map, parent(-1))
+        1 |-> scope(
+          ("count" |-> N:Int) ("state" |-> 0) FRAME:Map,
+          parent(0)
+        )
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Loop invariant for state 1: the first non-whitespace character was "I"
+  // and its following character has not been consumed yet.
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("ch"), boredLoopBody)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => bored1(CS, N)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL:Map, parent(-1))
+        1 |-> scope(
+          ("count" |-> N:Int) ("state" |-> 1) FRAME:Map,
+          parent(0)
+        )
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Loop invariant for state 2: the current sentence cannot be a boredom.
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("ch"), boredLoopBody)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => bored2(CS, N)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL:Map, parent(-1))
+        1 |-> scope(
+          ("count" |-> N:Int) ("state" |-> 2) FRAME:Map,
+          parent(0)
+        )
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // End-to-end contract: calling the translated function on any ASCII code
+  // sequence returns the independently defined boredom count.
+  claim
+    <k>
+      Call(Name("is_bored"), str(CS:IntSeq))
+      => bored0(CS, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "is_bored" |-> closureVal(
+          ("S", .ParamNames),
+          boredFunctionBody,
+          0
+        ),
+        parent(-1)
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
