+          ("state" |-> 2)
+          ("ch" |-> CH:Val)
+          ("code" |-> CODE:Int),
+          parent(0)
+        )
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool ("ord" in_keys(GLOBAL))
+    [label(loop-state-2)]
+
+  // End-to-end contract: calling the translated function on any ASCII code
+  // sequence returns the independently defined boredom count.
+  claim
+    <k>
+      Call(Name("is_bored"), str(CS:IntSeq))
+      => bored0(CS, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "is_bored" |-> closureVal(
+          ("S", .ParamNames),
+          boredFunctionBody,
+          0
+        ),
+        parent(-1)
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
