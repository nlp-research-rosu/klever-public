diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4990f11e6db9191c6d0c540d5c56c1ac76077731
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,18 @@
+def is_bored(S):
+    count = 0
+    state = 0
+    for ch in S:
+        if ch == "." or ch == "?" or ch == "!":
+            state = 0
+        elif state == 0:
+            if ch in " \t\n\r\v\f":
+                pass
+            elif ch == "I":
+                state = 1
+            else:
+                state = 2
+        elif state == 1:
+            if ch == " ":
+                count += 1
+            state = 2
+    return count

