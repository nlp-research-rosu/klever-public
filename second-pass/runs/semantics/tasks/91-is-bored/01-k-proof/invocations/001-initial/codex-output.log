+    count = 0
+    state = 0
+    ch = ""
+    for ch in S:
+        if ch == "." or ch == "?" or ch == "!":
+            state = 0
+        elif state == 0:
+            if ch == " " or (ord(ch) >= 9 and ord(ch) <= 13):
+                state = 0
+            elif ch == "I":
+                state = 1
+            else:
+                state = 2
+        elif state == 1:
+            if ch == " ":
+                count += 1
+            state = 2
+    return count
