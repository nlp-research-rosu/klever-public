+            if ch == " " or ch == "\t" or ch == "\n" or ch == "\r" or ch == "\v" or ch == "\f":
+                state = 0
+            elif ch == "I":
+                state = 1
+            else:
+                state = 2
+        elif state == 1:
+            if ch == " ":
+                count += 1
+            state = 2
+    return count
