+++ b/spec.k
@@ -0,0 +1,172 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant for state 0: the current sentence has contained only
+  // leading whitespace.
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("ch"), boredLoopBody)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => bored0(CS, N)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL:Map, parent(-1))
+        1 |-> scope(
+          ("S" |-> str(INPUT:IntSeq))
+          ("count" |-> N:Int)
+          ("state" |-> 0)
+          ("ch" |-> CH:Val)
+          ("code" |-> CODE:Int),
+          parent(0)
+        )
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool ("ord" in_keys(GLOBAL))
+    [label(loop-state-0)]
+
+  // Loop invariant for state 1: the first non-whitespace character was "I"
+  // and its following character has not been consumed yet.
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("ch"), boredLoopBody)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => bored1(CS, N)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL:Map, parent(-1))
+        1 |-> scope(
+          ("S" |-> str(INPUT:IntSeq))
+          ("count" |-> N:Int)
+          ("state" |-> 1)
+          ("ch" |-> CH:Val)
+          ("code" |-> CODE:Int),
+          parent(0)
+        )
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool ("ord" in_keys(GLOBAL))
+    [label(loop-state-1)]
+
+  // Loop invariant for state 2: the current sentence cannot be a boredom.
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("ch"), boredLoopBody)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => bored2(CS, N)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL:Map, parent(-1))
+        1 |-> scope(
+          ("S" |-> str(INPUT:IntSeq))
+          ("count" |-> N:Int)
+          ("state" |-> 2)
+          ("ch" |-> CH:Val)
+          ("code" |-> CODE:Int),
+          parent(0)
+        )
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool ("ord" in_keys(GLOBAL))
+    [label(loop-state-2)]
+
+  // Direct full-function proof of the prompt's first example.
+  claim
+    <k>
+      Call(Name("is_bored"), Str("Hello world"))
+      => 0
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "is_bored" |-> closureVal(
+          ("S", .ParamNames),
+          boredFunctionBody,
+          0
+        ),
+        parent(-1)
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(prompt-example-0)]
+
+  // Direct full-function proof of the prompt's second example.
+  claim
+    <k>
+      Call(
+        Name("is_bored"),
+        Str("The sky is blue. The sun is shining. I love this weather")
+      )
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "is_bored" |-> closureVal(
+          ("S", .ParamNames),
+          boredFunctionBody,
+          0
+        ),
+        parent(-1)
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(prompt-example-1)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..fa39c422b71b252b8035b201d3877f5461bab403
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,112 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Names for the exact translated source fragments.  These are merely AST
+  // abbreviations; their equations do not summarize any execution.
+  syntax Stmts ::= "boredLoopBody" [function, total]
+                 | "boredFunctionBody" [function, total]
+
+  rule boredLoopBody
+    => Assign(Name("code"), Call(Name("ord"), Name("ch")))
+       If(
+         BoolOp(
+           "or",
+           Compare(Name("code"), CmpOp("==", Int(46))),
+           Compare(Name("code"), CmpOp("==", Int(63))),
+           Compare(Name("code"), CmpOp("==", Int(33)))
+         ),
+         Assign(Name("state"), Int(0)),
+         If(
+           Compare(Name("state"), CmpOp("==", Int(0))),
+           If(
+             BoolOp(
+               "or",
+               Compare(Name("code"), CmpOp("==", Int(32))),
+               BoolOp(
+                 "and",
+                 Compare(Name("code"), CmpOp(">=", Int(9))),
+                 Compare(Name("code"), CmpOp("<=", Int(13)))
+               )
+             ),
+             Assign(Name("state"), Int(0)),
+             If(
+               Compare(Name("code"), CmpOp("==", Int(73))),
+               Assign(Name("state"), Int(1)),
+               Assign(Name("state"), Int(2))
+             )
+           ),
+           If(
+             Compare(Name("state"), CmpOp("==", Int(1))),
+             If(
+               Compare(Name("code"), CmpOp("==", Int(32))),
+               AugAssign(Name("count"), "+", Int(1)),
+               .Stmts
+             )
+             Assign(Name("state"), Int(2)),
+             .Stmts
+           )
+         )
+       )
+
+  rule boredFunctionBody
+    => Assign(Name("count"), Int(0))
+       Assign(Name("state"), Int(0))
+       Assign(Name("ch"), Str(""))
+       Assign(Name("code"), Int(0))
+       For(Name("ch"), Name("S"), boredLoopBody)
+       Return(Name("count"))
+
+  // The three scanner states have the following contract:
+  //   0: only leading whitespace has been seen in the current sentence;
+  //   1: that first non-whitespace character was "I";
+  //   2: the sentence can no longer be a boredom.
+  syntax Bool ::= isBoredDelimiter(Int) [function, total]
+                | isBoredWhitespace(Int) [function, total]
+
+  rule isBoredDelimiter(C:Int)
+    => C ==Int 46 orBool C ==Int 63 orBool C ==Int 33
+
+  rule isBoredWhitespace(C:Int)
+    => C ==Int 32 orBool (C >=Int 9 andBool C <=Int 13)
+
+  // bored0/bored1/bored2 are an independent recursive specification over
+  // character codes.  The Int argument is the count accumulated so far.
+  syntax Val ::= bored0(IntSeq, Int) [function, total, no-evaluators]
+               | bored1(IntSeq, Int) [function, total, no-evaluators]
+               | bored2(IntSeq, Int) [function, total, no-evaluators]
+
+  rule bored0(.IntSeq, N:Int) => N [simplification]
+  rule bored0(iCons(C:Int, R:IntSeq), N:Int)
+    => #if isBoredDelimiter(C)
+       #then bored0(R, N)
+       #else #if isBoredWhitespace(C)
+             #then bored0(R, N)
+             #else #if C ==Int 73
+                   #then bored1(R, N)
+                   #else bored2(R, N)
+                   #fi
+             #fi
+       #fi
+    [simplification]
+
+  rule bored1(.IntSeq, N:Int) => N [simplification]
+  rule bored1(iCons(C:Int, R:IntSeq), N:Int)
+    => #if isBoredDelimiter(C)
+       #then bored0(R, N)
+       #else #if C ==Int 32
+             #then bored2(R, N +Int 1)
+             #else bored2(R, N)
+             #fi
+       #fi
+    [simplification]
+
+  rule bored2(.IntSeq, N:Int) => N [simplification]
+  rule bored2(iCons(C:Int, R:IntSeq), N:Int)
+    => #if isBoredDelimiter(C)
+       #then bored0(R, N)
+       #else bored2(R, N)
+       #fi
+    [simplification]
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..8853a43479fde539f6b39f66dd0a1e352878a2ef
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,30 @@
+def is_bored(S):
+    count = 0
+    state = 0
+    ch = ""
+    code = 0
+    for ch in S:
+        code = ord(ch)
+        if code == 46 or code == 63 or code == 33:
+            state = 0
+        elif state == 0:
+            if code == 32 or (code >= 9 and code <= 13):
+                state = 0
+            elif code == 73:
+                state = 1
+            else:
+                state = 2
+        elif state == 1:
+            if code == 32:
+                count += 1
+            state = 2
+    return count
+
+
+assert is_bored("Hello world") == 0
+assert is_bored("The sky is blue. The sun is shining. I love this weather") == 1
+assert is_bored("I am bored. I think. You are not!  I agree?Is this counted? Ironic.") == 3
+assert is_bored("  I start here!\tI tab-leading.\n\nI newline-leading") == 3
+assert is_bored("I. I? I!") == 0
+assert is_bored("It is fine. Island time.") == 0
+assert is_bored("You and I are going for a walk") == 0
