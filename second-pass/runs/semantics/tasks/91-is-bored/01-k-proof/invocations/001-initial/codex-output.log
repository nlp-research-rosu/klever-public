+            if code == 32 or (code >= 9 and code <= 13):
+                state = 0
+            elif code == 73:
+                state = 1
+            else:
+                state = 2
+        elif state == 1:
+            if code == 32:
+                count += 1
+            state = 2
+    return count
+
+
