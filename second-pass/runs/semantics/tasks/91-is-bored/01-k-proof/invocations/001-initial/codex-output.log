new file mode 100644
index 0000000000000000000000000000000000000000..8eb5f076167489761b1a5d8abd001e45ce2f8916
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,21 @@
+def is_bored(S):
+    count = 0
+    state = 0
+    ch = ""
+    code = 0
+    for ch in S:
+        code = ord(ch)
+        if code == 46 or code == 63 or code == 33:
+            state = 0
+        elif state == 0:
+            if code == 32 or (code >= 9 and code <= 13):
+                state = 0
+            elif code == 73:
+                state = 1
+            else:
+                state = 2
+        elif state == 1:
+            if code == 32:
+                count += 1
+            state = 2
+    return count
