+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool ("ord" in_keys(GLOBAL))
+    [label(loop-state-2)]
+
+  // Function-entry lemma: an arbitrary call evaluates its argument, builds
+  // the function frame, initializes the scanner, and reaches loop-state-0.
+  // Composing this claim with loop-state-0 gives the end-to-end contract.
+  claim
+    <k>
+      Call(Name("is_bored"), str(CS:IntSeq))
+      =>
+      #loop(str(CS), Name("ch"), boredLoopBody)
+      ~> Return(Name("count"))
+      ~> #endcall
+    </k>
+    <env> 0 => 1 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(
+          "is_bored" |-> closureVal(
+            ("S", .ParamNames),
+            boredFunctionBody,
+            0
+          ),
+          parent(-1)
+        )
+      )
+      =>
