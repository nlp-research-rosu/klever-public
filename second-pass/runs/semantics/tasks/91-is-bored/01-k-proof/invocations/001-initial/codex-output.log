+    code = 0
+    for ch in S:
+        code = ord(ch)
+        if code == 46 or code == 63 or code == 33:
+            state = 0
+        elif state == 0:
+            if code == 32 or (code >= 9 and code <= 13):
+                state = 0
+            elif code == 73:
+                state = 1
+            else:
+                state = 2
+        elif state == 1:
+            if code == 32:
+                count += 1
+            state = 2
+    return count
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e62de133ae8b26c1960757bd422fb6387622a285
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,212 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant for state 0: the current sentence has contained only
+  // leading whitespace.
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("ch"), boredLoopBody)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => bored0(CS, N)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL:Map, parent(-1))
+        1 |-> scope(
+          ("S" |-> str(INPUT:IntSeq))
+          ("count" |-> N:Int)
+          ("state" |-> 0)
+          ("ch" |-> CH:Val)
+          ("code" |-> CODE:Int),
+          parent(0)
+        )
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool ("ord" in_keys(GLOBAL))
+    [label(loop-state-0)]
+
+  // Loop invariant for state 1: the first non-whitespace character was "I"
+  // and its following character has not been consumed yet.
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("ch"), boredLoopBody)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => bored1(CS, N)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL:Map, parent(-1))
+        1 |-> scope(
+          ("S" |-> str(INPUT:IntSeq))
+          ("count" |-> N:Int)
+          ("state" |-> 1)
+          ("ch" |-> CH:Val)
+          ("code" |-> CODE:Int),
+          parent(0)
+        )
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool ("ord" in_keys(GLOBAL))
+    [label(loop-state-1)]
+
+  // Loop invariant for state 2: the current sentence cannot be a boredom.
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("ch"), boredLoopBody)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => bored2(CS, N)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL:Map, parent(-1))
+        1 |-> scope(
+          ("S" |-> str(INPUT:IntSeq))
+          ("count" |-> N:Int)
+          ("state" |-> 2)
+          ("ch" |-> CH:Val)
+          ("code" |-> CODE:Int),
+          parent(0)
+        )
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool ("ord" in_keys(GLOBAL))
+    [label(loop-state-2)]
+
+  // Call-entry lemma: lookup and argument evaluation enter the function frame.
+  claim
+    <k>
+      Call(Name("is_bored"), str(CS:IntSeq))
+      =>
+      #bindP(("S", .ParamNames), (str(CS), .Vals))
+      ~> boredFunctionBody
+      ~> #endcall
+    </k>
+    <env> 0 => 1 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(
+          "is_bored" |-> closureVal(
+            ("S", .ParamNames),
+            boredFunctionBody,
+            0
+          ),
+          parent(-1)
+        )
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(
+          "is_bored" |-> closureVal(
+            ("S", .ParamNames),
+            boredFunctionBody,
+            0
+          ),
+          parent(-1)
+        )
+        1 |-> scope(.Map, parent(0))
+      )
+    </scopes>
+    <scopeLoc> 1 => 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List => ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(call-enters-frame)]
+
+  // Initialization lemma: parameter binding and the translated assignments
+  // establish loop-state-0.  Composing this and the call-entry lemma with
+  // loop-state-0 gives the end-to-end contract.
+  claim
+    <k>
+      #bindP(("S", .ParamNames), (str(CS:IntSeq), .Vals))
+      ~> boredFunctionBody
+      ~> #endcall
+      =>
+      #loop(str(CS), Name("ch"), BODY:Stmts) ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(
+          "is_bored" |-> closureVal(
+            ("S", .ParamNames),
+            boredFunctionBody,
+            0
+          ),
+          parent(-1)
+        )
+        1 |-> scope(.Map, parent(0))
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(
+          "is_bored" |-> closureVal(
+            ("S", .ParamNames),
+            boredFunctionBody,
+            0
+          ),
+          parent(-1)
+        )
+        1 |-> scope(
+          ("S" |-> str(CS))
+          ("count" |-> 0)
+          ("state" |-> 0)
+          ("ch" |-> str(.IntSeq))
+          ("code" |-> 0),
+          parent(0)
+        )
+      )
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    ensures BODY ==K boredLoopBody
+    [label(frame-enters-invariant)]
+endmodule
