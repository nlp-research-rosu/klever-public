+    [label(loop-state-1)]
+
+  // Loop invariant for state 2: the current sentence cannot be a boredom.
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("ch"), boredLoopBody)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => bored2(CS, N)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL:Map, parent(-1))
+        1 |-> scope(
+          ("S" |-> str(INPUT:IntSeq))
+          ("count" |-> N:Int)
+          ("state" |-> 2)
+          ("ch" |-> CH:Val)
+          ("code" |-> CODE:Int),
+          parent(0)
+        )
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
