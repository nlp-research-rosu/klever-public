+++ b/spec.k
@@ -0,0 +1,139 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant for state 0: the current sentence has contained only
+  // leading whitespace.
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("ch"), boredLoopBody)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => bored0(CS, N)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL:Map, parent(-1))
+        1 |-> scope(
+          ("count" |-> N:Int) ("state" |-> 0) FRAME:Map,
+          parent(0)
+        )
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool (
+      "$cells" in_keys(
+        ("count" |-> N) ("state" |-> 0) FRAME
+      )
+    )
+
+  // Loop invariant for state 1: the first non-whitespace character was "I"
+  // and its following character has not been consumed yet.
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("ch"), boredLoopBody)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => bored1(CS, N)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL:Map, parent(-1))
+        1 |-> scope(
+          ("count" |-> N:Int) ("state" |-> 1) FRAME:Map,
+          parent(0)
+        )
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool (
+      "$cells" in_keys(
+        ("count" |-> N) ("state" |-> 1) FRAME
+      )
+    )
+
+  // Loop invariant for state 2: the current sentence cannot be a boredom.
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("ch"), boredLoopBody)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => bored2(CS, N)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL:Map, parent(-1))
+        1 |-> scope(
+          ("count" |-> N:Int) ("state" |-> 2) FRAME:Map,
+          parent(0)
+        )
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0 |-> scope(GLOBAL, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool (
+      "$cells" in_keys(
+        ("count" |-> N) ("state" |-> 2) FRAME
+      )
+    )
+
+  // End-to-end contract: calling the translated function on any ASCII code
+  // sequence returns the independently defined boredom count.
+  claim
+    <k>
+      Call(Name("is_bored"), str(CS:IntSeq))
+      => bored0(CS, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "is_bored" |-> closureVal(
+          ("S", .ParamNames),
+          boredFunctionBody,
+          0
+        ),
+        parent(-1)
+      )
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8e3fe3a7e583c26f739d829cd203c7e6b352e1c2
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,95 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Names for the exact translated source fragments.  These are merely AST
+  // abbreviations; their equations do not summarize any execution.
+  syntax Stmts ::= "boredLoopBody" [function, total]
+                 | "boredFunctionBody" [function, total]
+
+  rule boredLoopBody
+    => If(
+         BoolOp(
+           "or",
+           Compare(Name("ch"), CmpOp("==", Str("."))),
+           Compare(Name("ch"), CmpOp("==", Str("?"))),
+           Compare(Name("ch"), CmpOp("==", Str("!")))
+         ),
+         Assign(Name("state"), Int(0)),
+         If(
+           Compare(Name("state"), CmpOp("==", Int(0))),
+           If(
+             Compare(Name("ch"), CmpOp("in", Str(" \t\n\r\u000b\f"))),
+             Assign(Name("state"), Int(0)),
+             If(
+               Compare(Name("ch"), CmpOp("==", Str("I"))),
+               Assign(Name("state"), Int(1)),
+               Assign(Name("state"), Int(2))
+             )
+           ),
+           If(
+             Compare(Name("state"), CmpOp("==", Int(1))),
+             If(
+               Compare(Name("ch"), CmpOp("==", Str(" "))),
+               AugAssign(Name("count"), "+", Int(1)),
+               .Stmts
+             )
+             Assign(Name("state"), Int(2)),
+             .Stmts
+           )
+         )
+       )
+
+  rule boredFunctionBody
+    => Assign(Name("count"), Int(0))
+       Assign(Name("state"), Int(0))
+       For(Name("ch"), Name("S"), boredLoopBody)
+       Return(Name("count"))
+
+  // The three scanner states have the following contract:
+  //   0: only leading whitespace has been seen in the current sentence;
+  //   1: that first non-whitespace character was "I";
+  //   2: the sentence can no longer be a boredom.
+  syntax Bool ::= isBoredDelimiter(Int) [function, total]
+                | isBoredWhitespace(Int) [function, total]
+
+  rule isBoredDelimiter(C:Int)
+    => C ==Int 46 orBool C ==Int 63 orBool C ==Int 33
+
+  rule isBoredWhitespace(C:Int)
+    => C ==Int 32 orBool C ==Int 9  orBool C ==Int 10
+       orBool C ==Int 13 orBool C ==Int 11 orBool C ==Int 12
+
+  // bored0/bored1/bored2 are an independent recursive specification over
+  // character codes.  The Int argument is the count accumulated so far.
+  syntax Int ::= bored0(IntSeq, Int) [function]
+               | bored1(IntSeq, Int) [function]
+               | bored2(IntSeq, Int) [function]
+
+  rule bored0(.IntSeq, N:Int) => N
+  rule bored0(iCons(C:Int, R:IntSeq), N:Int) => bored0(R, N)
+    requires isBoredDelimiter(C)
+  rule bored0(iCons(C:Int, R:IntSeq), N:Int) => bored0(R, N)
+    requires notBool isBoredDelimiter(C) andBool isBoredWhitespace(C)
+  rule bored0(iCons(C:Int, R:IntSeq), N:Int) => bored1(R, N)
+    requires notBool isBoredDelimiter(C)
+      andBool notBool isBoredWhitespace(C) andBool C ==Int 73
+  rule bored0(iCons(C:Int, R:IntSeq), N:Int) => bored2(R, N)
+    requires notBool isBoredDelimiter(C)
+      andBool notBool isBoredWhitespace(C) andBool C =/=Int 73
+
+  rule bored1(.IntSeq, N:Int) => N
+  rule bored1(iCons(C:Int, R:IntSeq), N:Int) => bored0(R, N)
+    requires isBoredDelimiter(C)
+  rule bored1(iCons(C:Int, R:IntSeq), N:Int) => bored2(R, N +Int 1)
+    requires notBool isBoredDelimiter(C) andBool C ==Int 32
+  rule bored1(iCons(C:Int, R:IntSeq), N:Int) => bored2(R, N)
+    requires notBool isBoredDelimiter(C) andBool C =/=Int 32
+
+  rule bored2(.IntSeq, N:Int) => N
+  rule bored2(iCons(C:Int, R:IntSeq), N:Int) => bored0(R, N)
+    requires isBoredDelimiter(C)
+  rule bored2(iCons(C:Int, R:IntSeq), N:Int) => bored2(R, N)
+    requires notBool isBoredDelimiter(C)
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..452d23c235e971470b747fed54e5c9bec4bd76c4
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,27 @@
+def is_bored(S):
+    count = 0
+    state = 0
+    for ch in S:
+        if ch == "." or ch == "?" or ch == "!":
+            state = 0
+        elif state == 0:
+            if ch in " \t\n\r\v\f":
+                state = 0
+            elif ch == "I":
+                state = 1
+            else:
+                state = 2
+        elif state == 1:
+            if ch == " ":
+                count += 1
+            state = 2
+    return count
+
+
+assert is_bored("Hello world") == 0
+assert is_bored("The sky is blue. The sun is shining. I love this weather") == 1
+assert is_bored("I am bored. I think. You are not!  I agree?Is this counted? Ironic.") == 3
+assert is_bored("  I start here!\tI tab-leading.\n\nI newline-leading") == 3
+assert is_bored("I. I? I!") == 0
+assert is_bored("It is fine. Island time.") == 0
+assert is_bored("You and I are going for a walk") == 0
