+        0 |-> scope(GLOBAL:Map, parent(-1))
+        1 |-> scope(
+          ("S" |-> str(INPUT:IntSeq))
+          ("count" |-> N:Int)
+          ("state" |-> 0)
+          ("ch" |-> CH:Val),
+          parent(0)
+        )
+      )
+      =>
