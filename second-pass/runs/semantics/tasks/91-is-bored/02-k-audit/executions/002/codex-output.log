/bin/bash -lc "for f in reference-semantics/semantics.k reference-semantics/semantics/syntax.k reference-semantics/semantics/core.k reference-semantics/semantics/controls.k reference-semantics/semantics/functions.k reference-semantics/semantics/call.k reference-semantics/semantics/bool.k reference-semantics/semantics/int.k reference-semantics/semantics/str.k reference-semantics/semantics/operators.k reference-semantics/semantics/assert.k reference-semantics/semantics/iter.k; do printf '\\n===== %s =====\\n' \""'$f"; sed -n '"'1,360p' \""'$f"; done' in /tmp/audit-work/fresh
 succeeded in 0ms:

