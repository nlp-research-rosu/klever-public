  </env>
  <scopes>
    -1 |-> scope ( "abs" |-> builtinV ( "abs" )
    "all" |-> builtinV ( "all" )
    "any" |-> builtinV ( "any" )
    "bin" |-> builtinV ( "bin" )
    "chr" |-> builtinV ( "chr" )
    "enumerate" |-> builtinV ( "enumerate" )
    "eval" |-> builtinV ( "eval" )
    "float" |-> typeV ( "float" )
    "int" |-> typeV ( "int" )
