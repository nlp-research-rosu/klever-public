+    "a",
+    "x",
+    " ",
+    "\t",
+    "\n",
+    "\r",
+    "\v",
+    "\f",
+    ".",
+    "?",
+    "!",
+    "\u00a0",
+    "\u0085",
+    "\u2003",
+    "\u2028",
