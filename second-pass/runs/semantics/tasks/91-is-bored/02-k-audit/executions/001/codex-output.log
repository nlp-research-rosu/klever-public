+  --spec-module SPEC-VACUITY \
+  --claims prompt-example-0-false
+prove_status=$?
+printf '[exit %d]\n' "$prove_status"
+
+if (( python_status == 0 && dry_status == 0 && prove_status != 0 && prove_status != 124 )); then
