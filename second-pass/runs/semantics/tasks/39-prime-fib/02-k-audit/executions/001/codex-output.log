    32	    if value == 2 or value == 3:
    33	        return True
    34	    if value % 2 == 0 or value % 3 == 0:
    35	        return False
    36	    divisor = 5
    37	    while divisor * divisor <= value:
    38	        if value % divisor == 0 or value % (divisor + 2) == 0:
    39	            return False
    40	        divisor += 6
    41	    return True
    42	
    43	
    44	def prime_fib(n: int):
    45	    """
    46	    prime_fib returns n-th number that is a Fibonacci number and it's also prime.
    47	    >>> prime_fib(1)
    48	    2
    49	    >>> prime_fib(2)
    50	    3
    51	    >>> prime_fib(3)
    52	    5
    53	    >>> prime_fib(4)
    54	    13
    55	    >>> prime_fib(5)
    56	    89
    57	    """
    58	    first = 0
    59	    second = 1
    60	    found = 0
    61	    while found < n:
    62	        following = first + second
    63	        first = second
    64	        second = following
    65	        if _is_prime(first):
    66	            found += 1
    67	    return first
