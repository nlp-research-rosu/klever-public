+  if (( status != 0 )); then
+    overall=1
+  fi
+done
+exit "$overall"
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..9a0fc73d5bbbcb1d5ac48bbe2e076f0d61835c30
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 3 )); then
+  echo "usage: run_logged.sh LABEL WORKDIR COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+label=$1
+run_dir=$2
+shift 2
+log="/audit-output/evidence/${label}.log"
+
+{
+  printf 'WORKDIR: %q\n' "$run_dir"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$log"
+
+(
+  cd "$run_dir" || exit 65
+  "$@"
+) 2>&1 | tee -a "$log"
+status=${PIPESTATUS[0]}
+printf 'EXIT_STATUS: %d\n' "$status" | tee -a "$log"
+exit "$status"
