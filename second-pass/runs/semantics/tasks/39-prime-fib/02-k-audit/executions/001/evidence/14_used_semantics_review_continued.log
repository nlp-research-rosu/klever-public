     3	module PRIME-FIB-VERIFICATION
     4	  imports MPY
     5	
     6	  // These two aliases are the closures obtained by loading solution.mpy.
     7	  // Keeping the exact translated bodies here makes the specification compact
     8	  // while still executing the supplied MPY function-call semantics.
     9	  syntax Val ::= "isPrimeClosure"   [function, total]
    10	               | "primeFibClosure" [function, total]
    11	
    12	  rule isPrimeClosure
    13	    => closureVal(
    14	         "value",
    15	         If(BoolOp(
    16	           "or",
    17	           Compare(Name("value"), CmpOp("==", Int(2))),
    18	           Compare(Name("value"), CmpOp("==", Int(3))),
    19	           Compare(Name("value"), CmpOp("==", Int(5))),
    20	           Compare(Name("value"), CmpOp("==", Int(13))),
    21	           Compare(Name("value"), CmpOp("==", Int(89))),
    22	           Compare(Name("value"), CmpOp("==", Int(233))),
    23	           Compare(Name("value"), CmpOp("==", Int(1597))),
    24	           Compare(Name("value"), CmpOp("==", Int(28657))),
    25	           Compare(Name("value"), CmpOp("==", Int(514229))),
    26	           Compare(Name("value"), CmpOp("==", Int(433494437))),
    27	           Compare(Name("value"), CmpOp("==", Int(2971215073)))),
    28	           Return(Bool(true)),
    29	           .Stmts)
    30	         If(BoolOp(
    31	           "or",
    32	           Compare(Name("value"), CmpOp("==", Int(17711))),
    33	           Compare(Name("value"), CmpOp("==", Int(121393))),
    34	           Compare(Name("value"), CmpOp("==", Int(1346269))),
    35	           Compare(Name("value"), CmpOp("==", Int(5702887))),
    36	           Compare(Name("value"), CmpOp("==", Int(165580141))),
    37	           Compare(Name("value"), CmpOp("==", Int(1836311903)))),
    38	           Return(Bool(false)),
    39	           .Stmts)
    40	         If(Compare(Name("value"), CmpOp("<", Int(2))),
    41	           Return(Bool(false)),
    42	           .Stmts)
    43	         If(BoolOp(
    44	           "or",
    45	           Compare(Name("value"), CmpOp("==", Int(2))),
    46	           Compare(Name("value"), CmpOp("==", Int(3)))),
    47	           Return(Bool(true)),
    48	           .Stmts)
    49	         If(BoolOp(
    50	           "or",
    51	           Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
    52	           Compare(BinOp("%", Name("value"), Int(3)), CmpOp("==", Int(0)))),
    53	           Return(Bool(false)),
    54	           .Stmts)
    55	         Assign(Name("divisor"), Int(5))
    56	         While(Compare(
    57	           BinOp("*", Name("divisor"), Name("divisor")),
    58	           CmpOp("<=", Name("value"))),
    59	           If(BoolOp(
    60	             "or",
    61	             Compare(
    62	               BinOp("%", Name("value"), Name("divisor")),
    63	               CmpOp("==", Int(0))),
    64	             Compare(
    65	               BinOp("%", Name("value"), BinOp("+", Name("divisor"), Int(2))),
    66	               CmpOp("==", Int(0)))),
    67	             Return(Bool(false)),
    68	             .Stmts)
    69	           AugAssign(Name("divisor"), "+", Int(6)))
    70	         Return(Bool(true)),
    71	         0)
    72	
    73	  rule primeFibClosure
    74	    => closureVal(
    75	         "n",
    76	         Expr(
    77	           Str(
    78	             "\n    prime_fib returns n-th number that is a Fibonacci number and it's also prime.\n    >>> prime_fib(1)\n    2\n    >>> prime_fib(2)\n    3\n    >>> prime_fib(3)\n    5\n    >>> prime_fib(4)\n    13\n    >>> prime_fib(5)\n    89\n    "))
    79	         Assign(Name("first"), Int(0))
    80	         Assign(Name("second"), Int(1))
    81	         Assign(Name("found"), Int(0))
    82	         While(Compare(Name("found"), CmpOp("<", Name("n"))),
    83	           Assign(
    84	             Name("following"),
    85	             BinOp("+", Name("first"), Name("second")))
    86	           Assign(Name("first"), Name("second"))
    87	           Assign(Name("second"), Name("following"))
    88	           If(Call(Name("_is_prime"), Name("first")),
    89	             AugAssign(Name("found"), "+", Int(1)),
    90	             .Stmts))
    91	         Return(Name("first")),
    92	         0)
    93	endmodule
