     7	def prime_fib(n: int):
     8	    """
     9	    prime_fib returns n-th number that is a Fibonacci number and it's also prime.
    10	    >>> prime_fib(1)
    11	    2
    12	    >>> prime_fib(2)
    13	    3
    14	    >>> prime_fib(3)
    15	    5
    16	    >>> prime_fib(4)
    17	    13
    18	    >>> prime_fib(5)
    19	    89
    20	    """
    21	    import math
    22	
    23	    def is_prime(p):
    24	        if p < 2:
    25	            return False
    26	        for k in range(2, min(int(math.sqrt(p)) + 1, p - 1)):
    27	            if p % k == 0:
    28	                return False
    29	        return True
    30	    f = [0, 1]
    31	    while True:
    32	        f.append(f[-1] + f[-2])
    33	        if is_prime(f[-1]):
    34	            n -= 1
    35	        if n == 0:
    36	            return f[-1]
