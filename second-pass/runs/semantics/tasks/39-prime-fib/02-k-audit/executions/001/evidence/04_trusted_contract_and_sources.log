===== /candidate/prove.sh =====
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Regenerate the translated program from the submitted Python source.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# Build the required concrete LLVM definition.
     8	kompile reference-semantics/semantics.k \
     9	  --backend llvm \
    10	  --main-module MPY-KRUN \
    11	  --syntax-module MPY-SYNTAX \
    12	  --output-definition runtime-kompiled
    13	
    14	# Add one top-level assignment to a temporary concrete harness. The final
    15	# character removed here is solution.mpy's closing Module parenthesis.
    16	sed '$s/.$//' solution.mpy > concrete-test.mpy
    17	printf '  Assign(Name("answer"), Call(Name("prime_fib"), Int(11)))\n)\n' \
    18	  >> concrete-test.mpy
    19	krun concrete-test.mpy --definition runtime-kompiled | tee krun.out
    20	grep -F '"answer" |-> 2971215073' krun.out
    21	
    22	# Build the symbolic definition, importing MPY (not MPY-CONCRETE).
    23	kompile verification.k \
    24	  --backend haskell \
    25	  --main-module PRIME-FIB-VERIFICATION \
    26	  --syntax-module MPY-SYNTAX \
    27	  --output-definition proof-kompiled
    28	
    29	# The eleven independent claims are balanced across three proof processes.
    30	# Peak use remains below the container's 8 GB limit, while every kprove
    31	# command still proves only claims from spec.k and must print #Top.
    32	run_group() {
    33	  local claims=$1
    34	  local log=$2
    35	  kprove spec.k \
    36	    --definition proof-kompiled \
    37	    --spec-module PRIME-FIB-SPEC \
    38	    --claims "$claims" 2>&1 | tee "$log"
    39	}
    40	
    41	run_group \
    42	  PRIME-FIB-SPEC.pf11,PRIME-FIB-SPEC.pf4,PRIME-FIB-SPEC.pf3,PRIME-FIB-SPEC.pf2,PRIME-FIB-SPEC.pf1 \
    43	  kprove-group-1.out &
    44	group1=$!
    45	run_group \
    46	  PRIME-FIB-SPEC.pf10,PRIME-FIB-SPEC.pf7,PRIME-FIB-SPEC.pf5 \
    47	  kprove-group-2.out &
    48	group2=$!
    49	run_group \
    50	  PRIME-FIB-SPEC.pf9,PRIME-FIB-SPEC.pf8,PRIME-FIB-SPEC.pf6 \
    51	  kprove-group-3.out &
    52	group3=$!
