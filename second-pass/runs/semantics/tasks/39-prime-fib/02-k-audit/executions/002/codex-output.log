new file mode 100644
index 0000000000000000000000000000000000000000..316edd83227f8bda257003891db3bebcd00e7226
--- /dev/null
+++ b/evidence/trace_inspect.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""Parse every structured generation-trace record and summarize its shape."""
+
+from __future__ import annotations
+
+import json
+from collections import Counter
+from pathlib import Path
+
+trace_root = Path("/generation-evidence/codex-trace")
+files = sorted(trace_root.rglob("*"))
+trace_files = [path for path in files if path.is_file()]
+print(f"trace files={len(trace_files)}")
+
+for path in trace_files:
+    counts: Counter[str] = Counter()
+    parse_errors = 0
+    lines = 0
+    first_timestamp = None
+    last_timestamp = None
+    tool_names: Counter[str] = Counter()
+    assistant_messages = 0
+    for raw in path.read_text(errors="replace").splitlines():
+        lines += 1
+        try:
+            obj = json.loads(raw)
+        except json.JSONDecodeError:
+            parse_errors += 1
+            continue
+        event_type = str(obj.get("type", "<missing>"))
+        counts[event_type] += 1
+        timestamp = obj.get("timestamp")
+        if timestamp is not None:
+            first_timestamp = first_timestamp or timestamp
+            last_timestamp = timestamp
+        payload = obj.get("payload")
+        if isinstance(payload, dict):
+            payload_type = payload.get("type")
+            if payload_type is not None:
+                counts[f"payload:{payload_type}"] += 1
+            if payload_type == "function_call":
+                tool_names[str(payload.get("name", "<missing>"))] += 1
+            if payload_type == "message" and payload.get("role") == "assistant":
+                assistant_messages += 1
+    print(f"file={path}")
+    print(
+        f"lines={lines} parse_errors={parse_errors} "
+        f"first_timestamp={first_timestamp} last_timestamp={last_timestamp}"
+    )
+    print(f"event_counts={dict(sorted(counts.items()))}")
+    print(f"tool_counts={dict(sorted(tool_names.items()))}")
+    print(f"assistant_messages={assistant_messages}")

exec
/bin/bash -lc "set -o pipefail
printf '%s\\n' 'RETRY: normalize only explicit .Stmts empty-list tokens for standalone parser' | tee -a /audit-output/evidence/program-pinning.log
python3 /audit-output/evidence/extract_pinning_terms.py 2>&1 | tee -a /audit-output/evidence/program-pinning.log
extract_status="'${PIPESTATUS[0]}
printf '"'RETRY EXTRACT EXIT: %s\\n' \""'$extract_status" | tee -a /audit-output/evidence/program-pinning.log
if [ "$extract_status" -ne 0 ]; then exit "$extract_status"; fi
for stem in isprime primefib; do
  for origin in source verification; do
    kast "pinning-${stem}-${origin}.k" --definition proof-kompiled --module PRIME-FIB-VERIFICATION --sort Val --output kore --output-file "pinning-${stem}-${origin}.kore" 2>&1 | tee -a /audit-output/evidence/program-pinning.log
    parse_status=${PIPESTATUS[0]}
    printf '"'RETRY KAST EXIT %s %s: %s\\n' \""'$stem" "$origin" "$parse_status" | tee -a /audit-output/evidence/program-pinning.log
    if [ "$parse_status" -ne 0 ]; then exit "$parse_status"; fi
  done
  cmp -s "pinning-${stem}-source.kore" "pinning-${stem}-verification.kore"
  cmp_status=$?
  sha256sum "pinning-${stem}-source.kore" "pinning-${stem}-verification.kore" | tee -a /audit-output/evidence/program-pinning.log
  printf '"'RETRY KORE CMP EXIT %s: %s\\n' \""'$stem" "$cmp_status" | tee -a /audit-output/evidence/program-pinning.log
  if [ "$cmp_status" -ne 0 ]; then diff -u "pinning-${stem}-source.kore" "pinning-${stem}-verification.kore" | tee -a /audit-output/evidence/program-pinning.log; exit "$cmp_status"; fi
done
printf '"'%s\\n' 'RETRY OVERALL EXIT: 0' | tee -a /audit-output/evidence/program-pinning.log" in /tmp/audit-work/prime-fib-audit
