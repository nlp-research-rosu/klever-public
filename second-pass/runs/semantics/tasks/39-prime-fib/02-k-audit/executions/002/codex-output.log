+      printf 'FAILED pf%s\n' "${ns[$i]}" >> "$summary"
+      overall=1
+    fi
+  done
+done
+
+printf 'OVERALL EXIT: %s\n' "$overall" >> "$summary"
+cat "$summary"
+exit "$overall"
