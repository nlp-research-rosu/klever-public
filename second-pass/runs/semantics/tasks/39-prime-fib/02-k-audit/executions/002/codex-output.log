+        counts[event_type] += 1
+        timestamp = obj.get("timestamp")
+        if timestamp is not None:
+            first_timestamp = first_timestamp or timestamp
+            last_timestamp = timestamp
+        payload = obj.get("payload")
+        if isinstance(payload, dict):
+            payload_type = payload.get("type")
