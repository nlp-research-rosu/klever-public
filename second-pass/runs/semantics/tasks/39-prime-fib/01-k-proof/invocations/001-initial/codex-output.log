diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..025dcc3f69dec89c33d5492d5ec059dcb9a21fff
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,101 @@
+requires "reference-semantics/semantics.k"
+
+module PRIME-FIB-VERIFICATION
+  imports MPY
+
+  // These two aliases are the closures obtained by loading solution.mpy.
+  // Keeping the exact translated bodies here makes the specification compact
+  // while still executing the supplied MPY function-call semantics.
+  syntax Val ::= "isPrimeClosure"
+               | "primeFibClosure"
+
+  rule isPrimeClosure
+    => closureVal(
+         "value",
+         If(Compare(Name("value"), CmpOp("<", Int(2))),
+           Return(Bool(false)),
+           .Stmts)
+         If(BoolOp(
+           "or",
+           Compare(Name("value"), CmpOp("==", Int(2))),
+           Compare(Name("value"), CmpOp("==", Int(3)))),
+           Return(Bool(true)),
+           .Stmts)
+         If(BoolOp(
+           "or",
+           Compare(BinOp("%", Name("value"), Int(2)), CmpOp("==", Int(0))),
+           Compare(BinOp("%", Name("value"), Int(3)), CmpOp("==", Int(0)))),
+           Return(Bool(false)),
+           .Stmts)
+         Assign(Name("divisor"), Int(5))
+         While(Compare(
+           BinOp("*", Name("divisor"), Name("divisor")),
+           CmpOp("<=", Name("value"))),
+           If(BoolOp(
+             "or",
+             Compare(
+               BinOp("%", Name("value"), Name("divisor")),
+               CmpOp("==", Int(0))),
+             Compare(
+               BinOp("%", Name("value"), BinOp("+", Name("divisor"), Int(2))),
+               CmpOp("==", Int(0)))),
+             Return(Bool(false)),
+             .Stmts)
+           AugAssign(Name("divisor"), "+", Int(6)))
+         Return(Bool(true)),
+         0)
+
+  rule primeFibClosure
+    => closureVal(
+         "n",
+         Expr(
+           Str(
+             "\n    Return the n-th Fibonacci number that is also prime.\n\n    The initial cases are a fast path for the ordinary HumanEval input range;\n    the loop is the general implementation for later positive indices.\n    "))
+         If(Compare(Name("n"), CmpOp("==", Int(1))),
+           Return(Int(2)),
+           .Stmts)
+         If(Compare(Name("n"), CmpOp("==", Int(2))),
+           Return(Int(3)),
+           .Stmts)
+         If(Compare(Name("n"), CmpOp("==", Int(3))),
+           Return(Int(5)),
+           .Stmts)
+         If(Compare(Name("n"), CmpOp("==", Int(4))),
+           Return(Int(13)),
+           .Stmts)
+         If(Compare(Name("n"), CmpOp("==", Int(5))),
+           Return(Int(89)),
+           .Stmts)
+         If(Compare(Name("n"), CmpOp("==", Int(6))),
+           Return(Int(233)),
+           .Stmts)
+         If(Compare(Name("n"), CmpOp("==", Int(7))),
+           Return(Int(1597)),
+           .Stmts)
+         If(Compare(Name("n"), CmpOp("==", Int(8))),
+           Return(Int(28657)),
+           .Stmts)
+         If(Compare(Name("n"), CmpOp("==", Int(9))),
+           Return(Int(514229)),
+           .Stmts)
+         If(Compare(Name("n"), CmpOp("==", Int(10))),
+           Return(Int(433494437)),
+           .Stmts)
+         If(Compare(Name("n"), CmpOp("==", Int(11))),
+           Return(Int(2971215073)),
+           .Stmts)
+         Assign(Name("first"), Int(0))
+         Assign(Name("second"), Int(1))
+         Assign(Name("found"), Int(0))
+         While(Compare(Name("found"), CmpOp("<", Name("n"))),
+           Assign(
+             Name("following"),
+             BinOp("+", Name("first"), Name("second")))
+           Assign(Name("first"), Name("second"))
+           Assign(Name("second"), Name("following"))
+           If(Call(Name("_is_prime"), Name("first")),
+             AugAssign(Name("found"), "+", Int(1)),
+             .Stmts))
+         Return(Name("first")),
+         0)
+endmodule

