+        value == 17711
+        or value == 121393
+        or value == 1346269
+        or value == 5702887
+        or value == 165580141
+        or value == 1836311903
+    ):
+        return False
+    if value < 2:
+        return False
+    if value == 2 or value == 3:
+        return True
+    if value % 2 == 0 or value % 3 == 0:
+        return False
+    divisor = 5
+    while divisor * divisor <= value:
+        if value % divisor == 0 or value % (divisor + 2) == 0:
+            return False
+        divisor += 6
+    return True
+
+
+def prime_fib(n: int):
+    """
+    prime_fib returns n-th number that is a Fibonacci number and it's also prime.
+    >>> prime_fib(1)
+    2
+    >>> prime_fib(2)
+    3
+    >>> prime_fib(3)
+    5
+    >>> prime_fib(4)
+    13
+    >>> prime_fib(5)
+    89
+    """
+    first = 0
+    second = 1
+    found = 0
+    while found < n:
+        following = first + second
+        first = second
+        second = following
+        if _is_prime(first):
+            found += 1
+    return first
