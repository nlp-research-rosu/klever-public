+    >>> prime_fib(3)
+    5
+    >>> prime_fib(4)
+    13
+    >>> prime_fib(5)
+    89
+    """
+    first = 0
+    second = 1
+    found = 0
+    while found < n:
+        following = first + second
+        first = second
+        second = following
+        if _is_prime(first):
+            found += 1
+    return first
