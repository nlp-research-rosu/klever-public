     1	requires "reference-semantics/semantics.k"
     2	
     3	module DIGITS-VERIFICATION
     4	  imports MPY
     5	
     6	  // Product of the odd decimal digits of N, accumulated into A.  The value
     7	  // zero is the implementation's sentinel for "no odd digit seen yet".
     8	  syntax Int ::= oddDigitProduct(Int, Int) [function, total]
     9	               | oddDigitStep(Bool, Int, Int, Int) [function, total]
    10	
    11	  rule oddDigitProduct(0, A:Int) => A
    12	
    13	  rule oddDigitProduct(N:Int, A:Int)
    14	    => oddDigitStep(
    15	         pyMod(N, 2) ==Int 1,
    16	         (N -Int pyMod(N, 10)) /Int 10,
    17	         pyMod(N, 10),
    18	         A)
    19	    requires N >Int 0
    20	
    21	  rule oddDigitStep(B:Bool, Q:Int, _:Int, A:Int)
    22	    => oddDigitProduct(Q, A)
    23	    requires notBool B
    24	
    25	  rule oddDigitStep(B:Bool, Q:Int, D:Int, 0)
    26	    => oddDigitProduct(Q, D)
    27	    requires B
    28	
    29	  rule oddDigitStep(B:Bool, Q:Int, D:Int, A:Int)
    30	    => oddDigitProduct(Q, A *Int D)
    31	    requires B andBool A =/=Int 0
    32	
    33	  // Target-side function equations are not re-fired automatically after the
    34	  // symbolic execution learns a branch condition.  These three simplifiers
    35	  // expose the same defining recurrence when the prover compares the
    36	  // post-state of one loop iteration with the invariant's original state.
    37	  rule {
    38	    oddDigitProduct(
    39	      (N -Int ((N %Int 10 +Int 10) %Int 10)) /Int 10,
    40	      A)
    41	    #Equals
    42	    oddDigitProduct(N, A)
    43	  } => true
    44	    requires N >Int 0
    45	     andBool pyMod(N, 2) =/=Int 1
    46	    [simplification]
    47	
    48	  rule {
    49	    oddDigitProduct(
    50	      (N -Int ((N %Int 10 +Int 10) %Int 10)) /Int 10,
    51	      (N %Int 10 +Int 10) %Int 10)
    52	    #Equals
    53	    oddDigitProduct(N, 0)
    54	  } => true
    55	    requires N >Int 0
    56	     andBool pyMod(N, 2) ==Int 1
    57	    [simplification]
    58	
    59	  rule {
    60	    oddDigitProduct(
    61	      (N -Int ((N %Int 10 +Int 10) %Int 10)) /Int 10,
    62	      A *Int ((N %Int 10 +Int 10) %Int 10))
    63	    #Equals
    64	    oddDigitProduct(N, A)
    65	  } => true
    66	    requires N >Int 0
    67	     andBool A =/=Int 0
    68	     andBool pyMod(N, 2) ==Int 1
    69	    [simplification]
    70	endmodule
