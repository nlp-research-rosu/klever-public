diff --git a//tmp/audit-work/131-digits-proof-audit/AuditBridge.lean b//tmp/audit-work/131-digits-proof-audit/AuditBridge.lean
new file mode 100644
index 0000000000000000000000000000000000000000..f9e8a2312815063fccd5984f0198afc4ae748d0b
--- /dev/null
+++ b//tmp/audit-work/131-digits-proof-audit/AuditBridge.lean
@@ -0,0 +1,76 @@
+import Proof
+
+open Proof
+
+-- Primitive K-hook witnesses, including values that distinguish truncating
+-- division/remainder from Euclidean division/remainder.
+#eval Proof.«_-Int_» 7 12
+#eval Proof._andBool_ true false
+#eval Proof.«_>Int_» 7 3
+#eval Proof.«_==Int_» (-4) (-4)
+#eval Proof.«_=/=Int_» (-4) 4
+#eval Proof.«_%Int_» (-13) 10
+#eval Int.emod (-13) 10
+#eval Proof.«_/Int_» (-13) 10
+#eval Int.ediv (-13) 10
+#eval Proof.«_*Int_» (-7) 6
+#eval Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» (-13) 10
+
+-- Boundary and representative executions of the frozen recurrence.
+#eval Proof.oddDigitProductCore 0 11
+#eval Proof.oddDigitProductCore 1 0
+#eval Proof.oddDigitProductCore 24680 0
+#eval Proof.oddDigitProductCore 135 0
+#eval Proof.oddDigitProductCore 10305 0
+#eval Proof.oddDigitProductCore 123456789 0
+#eval Proof.oddDigitProductCore 123 2
+#eval Proof.«oddDigitProduct(_,_)_DIGITS-VERIFICATION_Int_Int_Int» (-13) 11
+
+-- Concrete witnesses for each of the three generated recurrence obligations.
+#eval decide (
+  Proof.oddDigitProductCore
+      ((14 - Proof.pyModCore 14 10).tdiv 10).toNat 7 =
+  Proof.oddDigitProductCore 14 7)
+#eval decide (
+  Proof.oddDigitProductCore
+      ((135 - Proof.pyModCore 135 10).tdiv 10).toNat
+      (Proof.pyModCore 135 10) =
+  Proof.oddDigitProductCore 135 0)
+#eval decide (
+  Proof.oddDigitProductCore
+      ((135 - Proof.pyModCore 135 10).tdiv 10).toNat
+      (2 * Proof.pyModCore 135 10) =
+  Proof.oddDigitProductCore 135 2)
+
+-- The fixed equation alone admits a constant oracle, demonstrating why the
+-- independent operational-bridge check is necessary.
+def constantSummary (_ _ : SortInt) : SortInt := 0
+
+theorem constantSummarySatisfiesEquations :
+    Klean131Digits.Lemmas.targetStatement
+      Proof.«_-Int_» Proof._andBool_ Proof.«_>Int_» Proof.«_==Int_»
+      Proof.«_=/=Int_» Proof.«_%Int_» Proof.«_+Int_» Proof.«_/Int_»
+      Proof.«_*Int_»
+      constantSummary
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» := by
+  unfold Klean131Digits.Lemmas.targetStatement
+  simp [constantSummary]
+
+#eval decide (
+  constantSummary 135 0 ≠
+  Proof.«oddDigitProduct(_,_)_DIGITS-VERIFICATION_Int_Int_Int» 135 0)
+
+-- More convenient but wrong interpretations are exposed by adversarial signs.
+def euclideanRemainder : SortInt → SortInt → SortInt := Int.emod
+def euclideanDivision : SortInt → SortInt → SortInt := Int.ediv
+def directRemainder : SortInt → SortInt → SortInt := Int.tmod
+
+#eval decide (
+  euclideanRemainder (-13) 10 ≠ Proof.«_%Int_» (-13) 10)
+#eval decide (
+  euclideanDivision (-13) 10 ≠ Proof.«_/Int_» (-13) 10)
+#eval decide (
+  directRemainder (-13) 10 ≠
+  Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» (-13) 10)
+
+#check Proof.final
diff --git a//tmp/audit-work/131-digits-proof-audit/AuditDifferential.lean b//tmp/audit-work/131-digits-proof-audit/AuditDifferential.lean
new file mode 100644
index 0000000000000000000000000000000000000000..5a308ce4250d4b29fd44b115c5370f20b8d1ebca
--- /dev/null
+++ b//tmp/audit-work/131-digits-proof-audit/AuditDifferential.lean
@@ -0,0 +1,56 @@
+import Proof
+
+-- Independent executable reading of the source loop using only Nat decimal
+-- division/remainder and an Int accumulator.
+def sourceOracle (n : Nat) : Int :=
+  loop n 0
+where
+  loop (n : Nat) (product : Int) : Int :=
+    if hn : n = 0 then
+      product
+    else
+      let digit : Int := Int.ofNat (n % 10)
+      let nextProduct :=
+        if n % 2 = 1 then
+          if product = 0 then digit else product * digit
+        else
+          product
+      loop (n / 10) nextProduct
+  termination_by n
+  decreasing_by
+    exact Nat.div_lt_self (Nat.pos_of_ne_zero hn) (by decide)
+
+#eval (List.range 5000).all fun n =>
+  sourceOracle n == Proof.oddDigitProductCore n 0
+
+#eval [0, 1, 2, 9, 10, 11, 99, 101, 1001, 90909, 24680,
+  13579, 123456789, 987654321, 999999999].map fun n =>
+  (n, sourceOracle n, Proof.oddDigitProductCore n 0)
+
+-- A material source-body mutation (multiply even digits instead) is detected.
+def evenDigitMutation (n : Nat) : Int :=
+  loop n 0
+where
+  loop (n : Nat) (product : Int) : Int :=
+    if hn : n = 0 then
+      product
+    else
+      let digit : Int := Int.ofNat (n % 10)
+      let nextProduct :=
+        if n % 2 = 0 then
+          if product = 0 then digit else product * digit
+        else
+          product
+      loop (n / 10) nextProduct
+  termination_by n
+  decreasing_by
+    exact Nat.div_lt_self (Nat.pos_of_ne_zero hn) (by decide)
+
+#eval decide (
+  evenDigitMutation 2468 ≠ Proof.oddDigitProductCore 2468 0)
+#eval decide (
+  (fun (_n _a : Int) => 0) 135 0 ≠
+    Proof.«oddDigitProduct(_,_)_DIGITS-VERIFICATION_Int_Int_Int» 135 0)
+#eval decide (
+  (fun (_n a : Int) => a) 135 0 ≠
+    Proof.«oddDigitProduct(_,_)_DIGITS-VERIFICATION_Int_Int_Int» 135 0)
diff --git a//tmp/audit-work/k-adversarial.mpy b//tmp/audit-work/k-adversarial.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..933088c9c666a301cc23218e164f44670c2e36e7
--- /dev/null
+++ b//tmp/audit-work/k-adversarial.mpy
@@ -0,0 +1,33 @@
+Module(
+  FuncDef("digits", Params("n"),
+    Assign(Name("product"), Int(0))
+    While(Compare(Name("n"), CmpOp(">", Int(0))),
+      If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
+        If(Compare(Name("product"), CmpOp("==", Int(0))),
+          Assign(Name("product"), BinOp("%", Name("n"), Int(10))),
+          AugAssign(
+            Name("product"),
+            "*",
+            BinOp("%", Name("n"), Int(10)))),
+        )
+      AugAssign(Name("n"), "//", Int(10)))
+    Return(Name("product")))
+  Assert(Compare(Call(Name("digits"), Int(1)), CmpOp("==", Int(1))))
+  Assert(Compare(Call(Name("digits"), Int(2)), CmpOp("==", Int(0))))
+  Assert(Compare(Call(Name("digits"), Int(9)), CmpOp("==", Int(9))))
+  Assert(Compare(Call(Name("digits"), Int(10)), CmpOp("==", Int(1))))
+  Assert(Compare(Call(Name("digits"), Int(11)), CmpOp("==", Int(1))))
+  Assert(Compare(Call(Name("digits"), Int(99)), CmpOp("==", Int(81))))
+  Assert(Compare(Call(Name("digits"), Int(101)), CmpOp("==", Int(1))))
+  Assert(Compare(Call(Name("digits"), Int(1001)), CmpOp("==", Int(1))))
+  Assert(Compare(Call(Name("digits"), Int(90909)), CmpOp("==", Int(729))))
+  Assert(Compare(Call(Name("digits"), Int(24680)), CmpOp("==", Int(0))))
+  Assert(Compare(Call(Name("digits"), Int(13579)), CmpOp("==", Int(945))))
+  Assert(
+    Compare(
+      Call(Name("digits"), Int(123456789)),
+      CmpOp("==", Int(945))))
+  Assert(
+    Compare(
+      Call(Name("digits"), Int(999999999)),
+      CmpOp("==", Int(387420489)))))
diff --git a//tmp/audit-work/lean-proc-self-shim.c b//tmp/audit-work/lean-proc-self-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..0a0cfd349a754bc5d68986519facf68ae6e42d23
--- /dev/null
+++ b//tmp/audit-work/lean-proc-self-shim.c
@@ -0,0 +1,20 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn next_readlink;
+  if (next_readlink == NULL) {
+    next_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  if (path != NULL &&
+      strncmp(path, "/proc/", 6) == 0 &&
+      strstr(path + 6, "/exe") != NULL) {
+    return next_readlink("/proc/self/exe", buffer, size);
+  }
+  return next_readlink(path, buffer, size);
+}
diff --git a/evidence/independent_manifest_check.py b/evidence/independent_manifest_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..cbd76f5e5b22841dabaed34af4424ad9498d9ee6
--- /dev/null
+++ b/evidence/independent_manifest_check.py
@@ -0,0 +1,320 @@
+#!/usr/bin/env python3
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+
+from tools.k_rule_inventory import inventory_verification
+from tools.klean_export import (
+    expected_target_definition,
+    sha256_text,
+    target_statement,
+    tree_digest,
+)
+from tools.lemma_discovery_contract import validate_trust_boundary
+from tools.pipeline_contract import sha256_tree
+
+
+def read_json(path: str | Path) -> dict:
+    return json.loads(Path(path).read_text())
+
+
+def file_sha256(path: str | Path) -> str:
+    return hashlib.sha256(Path(path).read_bytes()).hexdigest()
+
+
+def require(label: str, condition: bool, checks: list[dict]) -> None:
+    checks.append({"check": label, "pass": bool(condition)})
+    if not condition:
+        raise AssertionError(label)
+
+
+def main() -> None:
+    audit = read_json("/audit-input.json")
+    resolution = audit["resolution"]
+    generator = read_json("/reference/klean-generation/generator-manifest.json")
+    source_manifest = read_json("/reference/generation-tools/source-manifest.json")
+    input_manifest = read_json("/reference/klean-generation/input-manifest.json")
+    obligation_map = read_json(
+        "/reference/klean-generation/generated/obligation-map.json"
+    )
+    recorded_preflight = read_json("/reference/klean-generation/preflight.json")
+    rerun_preflight = read_json("/audit-output/evidence/preflight-rerun.json")
+    discovery = read_json("/reference/lemma-discovery.json")
+    lock = read_json("/reference/klean-toolchain.lock.json")
+    inventory = inventory_verification(Path("/reference/k-proof"))
+    validated = validate_trust_boundary(
+        Path("/reference/k-proof"), Path("/reference/lemma-discovery.json")
+    )
+    actual_target = target_statement(
+        Path("/reference/klean-generation/generated")
+    )
+    checks: list[dict] = []
+
+    require(
+        "launcher mode agrees with AUDIT_MODE",
+        resolution["mode"] == os.environ["AUDIT_MODE"]
+        == "CLASSIFICATION_AND_PROOF",
+        checks,
+    )
+    require(
+        "semantics mode is SUPPLIED_SEMANTICS",
+        resolution["semantics_mode"] == "SUPPLIED_SEMANTICS",
+        checks,
+    )
+
+    image_id = generator["provenance"]["generator_image_id"]
+    producer_hashes = {
+        "klean_export.py": file_sha256(
+            "/reference/generation-tools/klean_export.py"
+        ),
+        "klean.py": file_sha256("/reference/generation-tools/klean.py"),
+    }
+    require(
+        "producer file hashes equal source manifest",
+        producer_hashes == source_manifest["files"],
+        checks,
+    )
+    require(
+        "producer file hashes equal generator manifest",
+        producer_hashes["klean_export.py"] == generator["exporter_sha256"]
+        and producer_hashes["klean.py"] == generator["klean_py_sha256"],
+        checks,
+    )
+    require(
+        "producer image ID is identical in both manifests",
+        source_manifest["generator_image_id"] == image_id,
+        checks,
+    )
+    require(
+        "launcher producer path is bound to image ID",
+        Path(resolution["generation_producer_sources"]).name
+        == image_id.removeprefix("sha256:"),
+        checks,
+    )
+    require(
+        "launcher producer tree hash matches mounted bundle",
+        sha256_tree(Path("/reference/generation-tools"))
+        == resolution["hashes"]["generation_producer_sources_sha256"],
+        checks,
+    )
+
+    require(
+        "verification source hash matches launcher",
+        file_sha256("/reference/k-proof/verification.k")
+        == resolution["stage1_source_hashes"]["verification.k"],
+        checks,
+    )
+    require(
+        "canonical inventory hash matches discovery",
+        inventory["inventory_sha256"] == discovery["inventory_sha256"],
+        checks,
+    )
+    canonical_ids = [entry["source_rule_id"] for entry in inventory["rules"]]
+    discovery_ids = [entry["source_rule_id"] for entry in discovery["rules"]]
+    require(
+        "discovery identities are a unique exact ordered bijection",
+        discovery_ids == canonical_ids
+        and len(discovery_ids) == len(set(discovery_ids)),
+        checks,
+    )
+    require(
+        "canonical source_rule_id is normalized hash",
+        all(
+            entry["source_rule_id"]
+            == "rule-" + entry["normalized_sha256"]
+            for entry in inventory["rules"]
+        ),
+        checks,
+    )
+    require(
+        "verification-module closure is local and exact",
+        inventory["verification_modules"] == ["DIGITS-VERIFICATION"],
+        checks,
+    )
+
+    classified = {
+        entry["source_rule_id"]: entry["classification"]
+        for entry in discovery["rules"]
+    }
+    expected_classes = ["DEFINITION"] * 5 + ["DOMAIN_LEMMA"] * 3
+    require(
+        "classification sequence is five definitions then three domain lemmas",
+        [classified[source_id] for source_id in canonical_ids]
+        == expected_classes,
+        checks,
+    )
+    require(
+        "all simplification rules are domain lemmas",
+        all(
+            classified[entry["source_rule_id"]] == "DOMAIN_LEMMA"
+            for entry in inventory["rules"]
+            if "simplification" in entry["attributes"]
+        ),
+        checks,
+    )
+    domain_rules = validated["domain_lemmas"]
+    domain_ids = [entry["source_rule_id"] for entry in domain_rules]
+    require(
+        "generated source rules equal validated domain rules",
+        input_manifest["source_rules"] == obligation_map["source_rules"]
+        == [
+            {
+                **entry,
+                "inventory_sha256": inventory["inventory_sha256"],
+                "discovery_manifest_sha256": file_sha256(
+                    "/reference/lemma-discovery.json"
+                ),
+            }
+            for entry in domain_rules
+        ],
+        checks,
+    )
+
+    obligations = obligation_map["obligations"]
+    obligation_ids = [entry["source_rule_id"] for entry in obligations]
+    require(
+        "obligations are a unique exact ordered domain-rule bijection",
+        obligation_ids == domain_ids
+        and len(obligation_ids) == len(set(obligation_ids)),
+        checks,
+    )
+    for source, obligation in zip(domain_rules, obligations, strict=True):
+        require(
+            f"{source['source_rule_id']} span and hashes are exact",
+            obligation["source_span"]
+            == {
+                "start_line": source["start_line"],
+                "end_line": source["end_line"],
+            }
+            and obligation["normalized_sha256"]
+            == source["normalized_sha256"]
+            and obligation["inventory_sha256"]
+            == inventory["inventory_sha256"]
+            and obligation["discovery_manifest_sha256"]
+            == file_sha256("/reference/lemma-discovery.json")
+            and obligation["lean_conjunct_sha256"]
+            == sha256_text(obligation["lean_conjunct"]),
+            checks,
+        )
+        conjunct = obligation["lean_conjunct"]
+        require(
+            f"{source['source_rule_id']} conjunct is guarded and nontrivial",
+            conjunct.startswith("∀ ")
+            and "(h :" in conjunct
+            and "= true)" in conjunct
+            and ") = (" in conjunct
+            and conjunct.strip() not in {"True", "∀ (_ : False), True"},
+            checks,
+        )
+
+    expected_definition = expected_target_definition(obligation_map)
+    require(
+        "actual target is exact generated conjunction",
+        actual_target == generator["target"]
+        and actual_target["definition_sha256"]
+        == sha256_text(expected_definition),
+        checks,
+    )
+    require(
+        "target is identical across generator, preflight, rerun, and launcher",
+        generator["target"]
+        == recorded_preflight["target"]
+        == rerun_preflight["target"]
+        == resolution["target"],
+        checks,
+    )
+    require(
+        "rerun preflight exactly reproduces recorded preflight",
+        rerun_preflight == recorded_preflight
+        == resolution["stage4_preflight"],
+        checks,
+    )
+    require(
+        "generator toolchain equals pinned lock",
+        generator["toolchain"] == lock,
+        checks,
+    )
+    require(
+        "obligation map file hash and count match generator",
+        file_sha256(
+            "/reference/klean-generation/generated/obligation-map.json"
+        )
+        == generator["obligation_map_sha256"]
+        and len(obligations) == generator["obligation_count"] == 3,
+        checks,
+    )
+
+    expected_hashes = resolution["hashes"]
+    require(
+        "Stage 1 pipeline tree hash matches launcher",
+        sha256_tree(Path("/reference/k-proof"))
+        == expected_hashes["k_workspace_sha256"],
+        checks,
+    )
+    require(
+        "Stage 1 export tree hash matches launcher and manifests",
+        tree_digest(Path("/reference/k-proof"))
+        == expected_hashes["stage1_export_sha256"]
+        == generator["provenance"]["stage1_workspace_sha256"]
+        == input_manifest["stage1_workspace_sha256"],
+        checks,
+    )
+    require(
+        "discovery file hash matches launcher and manifests",
+        file_sha256("/reference/lemma-discovery.json")
+        == expected_hashes["discovery_manifest_sha256"]
+        == generator["provenance"]["stage3_discovery_manifest_sha256"]
+        == input_manifest["stage3_discovery_manifest_sha256"],
+        checks,
+    )
+    require(
+        "Stage 2 audit pipeline tree hash matches launcher",
+        sha256_tree(Path("/reference/k-audit"))
+        == expected_hashes["k_audit_sha256"],
+        checks,
+    )
+    require(
+        "Stage 4 generation pipeline tree hash matches launcher",
+        sha256_tree(Path("/reference/klean-generation"))
+        == expected_hashes["klean_generation_sha256"],
+        checks,
+    )
+    require(
+        "generated export tree hash matches launcher and generator",
+        tree_digest(Path("/reference/klean-generation/generated"))
+        == expected_hashes["generated_tree_sha256"]
+        == generator["generated_tree_sha256"],
+        checks,
+    )
+    require(
+        "candidate pipeline tree hash matches launcher",
+        sha256_tree(Path("/candidate"))
+        == expected_hashes["lean_workspace_sha256"],
+        checks,
+    )
+
+    print(
+        json.dumps(
+            {
+                "status": "PASS",
+                "check_count": len(checks),
+                "inventory_rule_count": len(canonical_ids),
+                "domain_rule_count": len(domain_ids),
