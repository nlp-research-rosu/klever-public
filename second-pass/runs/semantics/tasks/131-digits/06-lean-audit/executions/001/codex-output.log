+            == sha256_text(obligation["lean_conjunct"]),
+            checks,
+        )
+        conjunct = obligation["lean_conjunct"]
+        require(
+            f"{source['source_rule_id']} conjunct is guarded and nontrivial",
+            conjunct.startswith("∀ ")
+            and "(h :" in conjunct
+            and "= true)" in conjunct
+            and ") = (" in conjunct
+            and conjunct.strip() not in {"True", "∀ (_ : False), True"},
+            checks,
+        )
