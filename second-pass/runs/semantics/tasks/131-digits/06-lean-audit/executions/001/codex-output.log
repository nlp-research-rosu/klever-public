The supported environment overrides are insufficient because Lean itself fails before they take effect. I’m applying a narrow local process-namespace workaround: interpose only `readlink("/proc/<pid>/exe")` so it resolves `/proc/self/exe`, which is the correct equivalent in this sandbox. The shim lives under `/tmp/audit-work`, does not touch any candidate or provenance input, and will be recorded with the build commands.
apply patch
patch: completed
/tmp/audit-work/lean-proc-self-shim.c
diff --git a//tmp/audit-work/lean-proc-self-shim.c b//tmp/audit-work/lean-proc-self-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..0a0cfd349a754bc5d68986519facf68ae6e42d23
--- /dev/null
+++ b//tmp/audit-work/lean-proc-self-shim.c
@@ -0,0 +1,20 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn next_readlink;
+  if (next_readlink == NULL) {
+    next_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  if (path != NULL &&
+      strncmp(path, "/proc/", 6) == 0 &&
+      strstr(path + 6, "/exe") != NULL) {
+    return next_readlink("/proc/self/exe", buffer, size);
+  }
+  return next_readlink(path, buffer, size);
+}

