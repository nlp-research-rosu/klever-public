index 0000000000000000000000000000000000000000..5a308ce4250d4b29fd44b115c5370f20b8d1ebca
--- /dev/null
+++ b//tmp/audit-work/131-digits-proof-audit/AuditDifferential.lean
@@ -0,0 +1,56 @@
+import Proof
+
+-- Independent executable reading of the source loop using only Nat decimal
+-- division/remainder and an Int accumulator.
+def sourceOracle (n : Nat) : Int :=
+  loop n 0
+where
+  loop (n : Nat) (product : Int) : Int :=
+    if hn : n = 0 then
+      product
+    else
+      let digit : Int := Int.ofNat (n % 10)
+      let nextProduct :=
+        if n % 2 = 1 then
+          if product = 0 then digit else product * digit
+        else
+          product
+      loop (n / 10) nextProduct
+  termination_by n
+  decreasing_by
+    exact Nat.div_lt_self (Nat.pos_of_ne_zero hn) (by decide)
+
+#eval (List.range 5000).all fun n =>
+  sourceOracle n == Proof.oddDigitProductCore n 0
+
+#eval [0, 1, 2, 9, 10, 11, 99, 101, 1001, 90909, 24680,
+  13579, 123456789, 987654321, 999999999].map fun n =>
+  (n, sourceOracle n, Proof.oddDigitProductCore n 0)
+
+-- A material source-body mutation (multiply even digits instead) is detected.
+def evenDigitMutation (n : Nat) : Int :=
+  loop n 0
+where
+  loop (n : Nat) (product : Int) : Int :=
+    if hn : n = 0 then
+      product
+    else
+      let digit : Int := Int.ofNat (n % 10)
+      let nextProduct :=
+        if n % 2 = 0 then
+          if product = 0 then digit else product * digit
+        else
+          product
+      loop (n / 10) nextProduct
+  termination_by n
+  decreasing_by
+    exact Nat.div_lt_self (Nat.pos_of_ne_zero hn) (by decide)
+
+#eval decide (
+  evenDigitMutation 2468 ≠ Proof.oddDigitProductCore 2468 0)
+#eval decide (
+  (fun (_n _a : Int) => 0) 135 0 ≠
+    Proof.«oddDigitProduct(_,_)_DIGITS-VERIFICATION_Int_Int_Int» 135 0)
+#eval decide (
+  (fun (_n a : Int) => a) 135 0 ≠
+    Proof.«oddDigitProduct(_,_)_DIGITS-VERIFICATION_Int_Int_Int» 135 0)
