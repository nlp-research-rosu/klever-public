+import Proof
+
+open Proof
+
+-- Primitive K-hook witnesses, including values that distinguish truncating
+-- division/remainder from Euclidean division/remainder.
+#eval Proof.«_-Int_» 7 12
+#eval Proof._andBool_ true false
+#eval Proof.«_>Int_» 7 3
+#eval Proof.«_==Int_» (-4) (-4)
+#eval Proof.«_=/=Int_» (-4) 4
+#eval Proof.«_%Int_» (-13) 10
+#eval Int.emod (-13) 10
+#eval Proof.«_/Int_» (-13) 10
+#eval Int.ediv (-13) 10
+#eval Proof.«_*Int_» (-7) 6
+#eval Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» (-13) 10
+
+-- Boundary and representative executions of the frozen recurrence.
+#eval Proof.oddDigitProductCore 0 11
+#eval Proof.oddDigitProductCore 1 0
+#eval Proof.oddDigitProductCore 24680 0
+#eval Proof.oddDigitProductCore 135 0
+#eval Proof.oddDigitProductCore 10305 0
+#eval Proof.oddDigitProductCore 123456789 0
+#eval Proof.oddDigitProductCore 123 2
+#eval Proof.«oddDigitProduct(_,_)_DIGITS-VERIFICATION_Int_Int_Int» (-13) 11
+
+-- Concrete witnesses for each of the three generated recurrence obligations.
+#eval decide (
+  Proof.oddDigitProductCore
+      ((14 - Proof.pyModCore 14 10).tdiv 10).toNat 7 =
+  Proof.oddDigitProductCore 14 7)
+#eval decide (
+  Proof.oddDigitProductCore
+      ((135 - Proof.pyModCore 135 10).tdiv 10).toNat
+      (Proof.pyModCore 135 10) =
+  Proof.oddDigitProductCore 135 0)
+#eval decide (
+  Proof.oddDigitProductCore
+      ((135 - Proof.pyModCore 135 10).tdiv 10).toNat
+      (2 * Proof.pyModCore 135 10) =
+  Proof.oddDigitProductCore 135 2)
+
+-- The fixed equation alone admits a constant oracle, demonstrating why the
+-- independent operational-bridge check is necessary.
+def constantSummary (_ _ : SortInt) : SortInt := 0
+
+theorem constantSummarySatisfiesEquations :
+    Klean131Digits.Lemmas.targetStatement
+      Proof.«_-Int_» Proof._andBool_ Proof.«_>Int_» Proof.«_==Int_»
+      Proof.«_=/=Int_» Proof.«_%Int_» Proof.«_+Int_» Proof.«_/Int_»
+      Proof.«_*Int_»
+      constantSummary
+      Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» := by
+  unfold Klean131Digits.Lemmas.targetStatement
+  simp [constantSummary]
+
+#eval decide (
+  constantSummary 135 0 ≠
+  Proof.«oddDigitProduct(_,_)_DIGITS-VERIFICATION_Int_Int_Int» 135 0)
+
+-- More convenient but wrong interpretations are exposed by adversarial signs.
+def euclideanRemainder : SortInt → SortInt → SortInt := Int.emod
+def euclideanDivision : SortInt → SortInt → SortInt := Int.ediv
+def directRemainder : SortInt → SortInt → SortInt := Int.tmod
+
+#eval decide (
+  euclideanRemainder (-13) 10 ≠ Proof.«_%Int_» (-13) 10)
+#eval decide (
+  euclideanDivision (-13) 10 ≠ Proof.«_/Int_» (-13) 10)
+#eval decide (
+  directRemainder (-13) 10 ≠
+  Proof.«pyMod(_,_)_MPY-INT_Int_Int_Int» (-13) 10)
+
+#check Proof.final
