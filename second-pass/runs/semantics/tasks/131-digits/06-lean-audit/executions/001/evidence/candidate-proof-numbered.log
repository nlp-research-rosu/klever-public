   116	theorem final :
   117	    Klean131Digits.Lemmas.targetStatement «_-Int_» _andBool_ «_>Int_» «_==Int_» «_=/=Int_» «_%Int_» «_+Int_» «_/Int_» «_*Int_» «oddDigitProduct(_,_)_DIGITS-VERIFICATION_Int_Int_Int» «pyMod(_,_)_MPY-INT_Int_Int_Int» := by
   118	  unfold Klean131Digits.Lemmas.targetStatement
   119	  constructor
   120	  · intro A N h
   121	    have hcond : N > 0 ∧ pyModCore N 2 ≠ 1 := by
   122	      simpa [_andBool_, «_>Int_», «_=/=Int_»,
   123	        «pyMod(_,_)_MPY-INT_Int_Int_Int»] using h
   124	    obtain ⟨hN, hparity⟩ := hcond
   125	    have hcast : Int.ofNat N.toNat = N :=
   126	      Int.toNat_of_nonneg (Int.le_of_lt hN)
   127	    have hn : N.toNat ≠ 0 := by
   128	      intro hz
   129	      rw [hz] at hcast
   130	      simp at hcast
   131	      exact (Int.ne_of_gt hN) hcast.symm
   132	    rw [← hcast] at hparity ⊢
   133	    change
   134	      oddDigitProductCore
   135	          (((Int.ofNat N.toNat -
   136	              pyModCore (Int.ofNat N.toNat) 10).tdiv 10).toNat)
   137	          A =
   138	        oddDigitProductCore N.toNat A
   139	    exact
   140	      (oddDigitProductCore_even N.toNat A hn hparity).symm
