     5	/- K's `%Int` and `/Int` hooks are truncating remainder and quotient.  The
     6	   frozen pyMod equation applies truncating remainder twice to obtain Python's
     7	   nonnegative remainder for the positive moduli used by the program. -/
     8	def pyModCore (a b : Int) : Int := (a.tmod b + b).tmod b
     9	
    10	theorem tmod_of_nonneg (a b : Int) (ha : 0 ≤ a) :
    11	    a.tmod b = a % b := by
    12	  simp [Int.tmod_eq_emod, ha]
    13	
    14	theorem quotient_ofNat (n : Nat) :
    15	    (((Int.ofNat n - pyModCore (Int.ofNat n) 10).tdiv 10).toNat) =
    16	      n / 10 := by
    17	  rw [show pyModCore (Int.ofNat n) 10 = Int.ofNat (n % 10) by
    18	    unfold pyModCore
    19	    rw [show (Int.ofNat n).tmod 10 = (Int.ofNat n) % 10 by
    20	      exact tmod_of_nonneg _ _ (Int.ofNat_zero_le n)]
    21	    rw [tmod_of_nonneg _ _ (by
    22	      have := Int.emod_nonneg (Int.ofNat n) (by omega : (10 : Int) ≠ 0)
    23	      omega)]
    24	    rw [Int.add_emod]
    25	    simp]
    26	  have hdecomp := Int.ediv_add_emod (Int.ofNat n) 10
    27	  have hmod : (Int.ofNat n) % 10 = Int.ofNat (n % 10) := by simp
    28	  have hdiv : (Int.ofNat n) / 10 = Int.ofNat (n / 10) := by simp
    29	  have hnum :
    30	      Int.ofNat n - Int.ofNat (n % 10) =
    31	        10 * Int.ofNat (n / 10) := by
    32	    omega
    33	  rw [hnum, Int.tdiv_eq_ediv]
    34	  simp
    35	  exact Int.toNat_natCast (n / 10)
    36	
    37	/- This is the total operational reading of oddDigitProduct.  Positive inputs
    38	   take exactly the frozen K recurrence; zero (and negative inputs, which are
    39	   outside that recurrence's guard) return the accumulator.  Recursion
    40	   terminates because the positive decimal quotient is strictly smaller. -/
    41	def oddDigitProductCore (n : Nat) (A : Int) : Int :=
    42	  if _hn : n = 0 then
    43	    A
    44	  else
    45	    let N : Int := Int.ofNat n
    46	    let D := pyModCore N 10
    47	    let Q : Nat := ((N - D).tdiv 10).toNat
    48	    if pyModCore N 2 = 1 then
    49	      if A = 0 then
    50	        oddDigitProductCore Q D
    51	      else
    52	        oddDigitProductCore Q (A * D)
    53	    else
    54	      oddDigitProductCore Q A
    55	termination_by n
    56	decreasing_by
    57	  all_goals
    58	    rw [quotient_ofNat]
    59	    exact Nat.div_lt_self (Nat.pos_of_ne_zero _hn) (by decide)
    60	
    61	theorem oddDigitProductCore_even
    62	    (n : Nat) (A : Int) (hn : n ≠ 0)
    63	    (heven : pyModCore (Int.ofNat n) 2 ≠ 1) :
    64	    oddDigitProductCore n A =
    65	      oddDigitProductCore
    66	        (((Int.ofNat n - pyModCore (Int.ofNat n) 10).tdiv 10).toNat) A := by
    67	  rw [oddDigitProductCore.eq_def n A]
    68	  simp only [dif_neg hn, if_neg heven]
    69	
    70	theorem oddDigitProductCore_first
    71	    (n : Nat) (hn : n ≠ 0)
    72	    (hodd : pyModCore (Int.ofNat n) 2 = 1) :
    73	    oddDigitProductCore n 0 =
    74	      oddDigitProductCore
    75	        (((Int.ofNat n - pyModCore (Int.ofNat n) 10).tdiv 10).toNat)
    76	        (pyModCore (Int.ofNat n) 10) := by
    77	  rw [oddDigitProductCore.eq_def n 0]
    78	  simp only [dif_neg hn, if_pos hodd, if_pos]
    79	
    80	theorem oddDigitProductCore_later
    81	    (n : Nat) (A : Int) (hn : n ≠ 0)
    82	    (hodd : pyModCore (Int.ofNat n) 2 = 1) (hA : A ≠ 0) :
    83	    oddDigitProductCore n A =
    84	      oddDigitProductCore
    85	        (((Int.ofNat n - pyModCore (Int.ofNat n) 10).tdiv 10).toNat)
    86	        (A * pyModCore (Int.ofNat n) 10) := by
    87	  rw [oddDigitProductCore.eq_def n A]
    88	  simp only [dif_neg hn, if_pos hodd, if_neg hA]
