   167	        «pyMod(_,_)_MPY-INT_Int_Int_Int»] using h
   168	    obtain ⟨⟨hN, hA⟩, hparity⟩ := hcond
   169	    have hcast : Int.ofNat N.toNat = N :=
   170	      Int.toNat_of_nonneg (Int.le_of_lt hN)
   171	    have hn : N.toNat ≠ 0 := by
   172	      intro hz
