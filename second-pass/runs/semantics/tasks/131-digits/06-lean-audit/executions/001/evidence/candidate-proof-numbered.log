   146	    obtain ⟨hN, hparity⟩ := hcond
   147	    have hcast : Int.ofNat N.toNat = N :=
   148	      Int.toNat_of_nonneg (Int.le_of_lt hN)
   149	    have hn : N.toNat ≠ 0 := by
   150	      intro hz
   151	      rw [hz] at hcast
   152	      simp at hcast
   153	      exact (Int.ne_of_gt hN) hcast.symm
   154	    rw [← hcast] at hparity ⊢
   155	    change
   156	      oddDigitProductCore
   157	          (((Int.ofNat N.toNat -
   158	              pyModCore (Int.ofNat N.toNat) 10).tdiv 10).toNat)
