+                          "*",
+                          BinOp("%", Name("n"), Int(10)))),
+                      .Stmts)
+                    AugAssign(Name("n"), "//", Int(10)))
+                  Return(Name("product")),
+                  0),
+              parent(-1))
+      1  |-> scope(
+              .Map [ "n" <- N:Int ] [ "product" <- A:Int ],
+              parent(0))
+      =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "digits" |->
+                closureVal(
+                  "n",
+                  Assign(Name("product"), Int(0))
+                  While(
+                    Compare(Name("n"), CmpOp(">", Int(0))),
+                    If(
+                      Compare(
