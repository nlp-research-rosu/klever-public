new file mode 100644
index 0000000000000000000000000000000000000000..76f5dc827dec973f4226ff55d7a0246519b39eca
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,33 @@
+requires "reference-semantics/semantics.k"
+
+module DIGITS-VERIFICATION
+  imports MPY
+
+  // Product of the odd decimal digits of N, accumulated into A.  The value
+  // zero is the implementation's sentinel for "no odd digit seen yet".
+  syntax Int ::= oddDigitProduct(Int, Int) [function]
+
+  rule oddDigitProduct(0, A:Int) => A
+
+  rule oddDigitProduct(N:Int, A:Int)
+    => oddDigitProduct(
+         (N -Int pyMod(N, 10)) /Int 10,
+         A)
+    requires N >Int 0
+     andBool pyMod(N, 2) ==Int 0
+
+  rule oddDigitProduct(N:Int, 0)
+    => oddDigitProduct(
+         (N -Int pyMod(N, 10)) /Int 10,
+         pyMod(N, 10))
+    requires N >Int 0
+     andBool pyMod(N, 2) ==Int 1
+
+  rule oddDigitProduct(N:Int, A:Int)
+    => oddDigitProduct(
+         (N -Int pyMod(N, 10)) /Int 10,
+         A *Int pyMod(N, 10))
+    requires N >Int 0
+     andBool A =/=Int 0
+     andBool pyMod(N, 2) ==Int 1
+endmodule

