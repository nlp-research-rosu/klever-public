diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..db29e694546e34aa9e85ec2e7c1077c5aab4b410
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,70 @@
+requires "reference-semantics/semantics.k"
+
+module DIGITS-VERIFICATION
+  imports MPY
+
+  // Product of the odd decimal digits of N, accumulated into A.  The value
+  // zero is the implementation's sentinel for "no odd digit seen yet".
+  syntax Int ::= oddDigitProduct(Int, Int) [function, total]
+               | oddDigitStep(Bool, Int, Int, Int) [function, total]
+
+  rule oddDigitProduct(0, A:Int) => A
+
+  rule oddDigitProduct(N:Int, A:Int)
+    => oddDigitStep(
+         pyMod(N, 2) ==Int 1,
+         (N -Int pyMod(N, 10)) /Int 10,
+         pyMod(N, 10),
+         A)
+    requires N >Int 0
+
+  rule oddDigitStep(B:Bool, Q:Int, _:Int, A:Int)
+    => oddDigitProduct(Q, A)
+    requires notBool B
+
+  rule oddDigitStep(B:Bool, Q:Int, D:Int, 0)
+    => oddDigitProduct(Q, D)
+    requires B
+
+  rule oddDigitStep(B:Bool, Q:Int, D:Int, A:Int)
+    => oddDigitProduct(Q, A *Int D)
+    requires B andBool A =/=Int 0
+
+  // Target-side function equations are not re-fired automatically after the
+  // symbolic execution learns a branch condition.  These three simplifiers
+  // expose the same defining recurrence when the prover compares the
+  // post-state of one loop iteration with the invariant's original state.
+  rule {
+    oddDigitProduct(
+      (N -Int pyMod(N, 10)) /Int 10,
+      A)
+    #Equals
+    oddDigitProduct(N, A)
+  } => true
+    requires N >Int 0
+     andBool pyMod(N, 2) =/=Int 1
+    [simplification]
+
+  rule {
+    oddDigitProduct(
+      (N -Int pyMod(N, 10)) /Int 10,
+      pyMod(N, 10))
+    #Equals
+    oddDigitProduct(N, 0)
+  } => true
+    requires N >Int 0
+     andBool pyMod(N, 2) ==Int 1
+    [simplification]
+
+  rule {
+    oddDigitProduct(
+      (N -Int pyMod(N, 10)) /Int 10,
+      A *Int pyMod(N, 10))
+    #Equals
+    oddDigitProduct(N, A)
+  } => true
+    requires N >Int 0
+     andBool A =/=Int 0
+     andBool pyMod(N, 2) ==Int 1
+    [simplification]
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..a9032acb79b3d93c3238fd063982fd989b5b8acb
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,18 @@
+def digits(n):
+    product = 0
+    while n > 0:
+        if n % 2 == 1:
+            if product == 0:
+                product = n % 10
+            else:
+                product *= n % 10
+        n //= 10
+    return product
+
+
+assert digits(1) == 1
+assert digits(4) == 0
+assert digits(235) == 15
+assert digits(2468) == 0
+assert digits(13579) == 945
+assert digits(10203) == 3
