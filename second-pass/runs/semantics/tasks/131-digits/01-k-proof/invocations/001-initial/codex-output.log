+      A *Int ((N %Int 10 +Int 10) %Int 10))
+    #Equals
+    oddDigitProduct(N, A)
+  } => true
+    requires N >Int 0
+     andBool A =/=Int 0
+     andBool pyMod(N, 2) ==Int 1
