diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..52c9a3724dd969e36196a5768e5546b4f287de70
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,134 @@
+requires "verification.k"
+
+module DIGITS-SPEC
+  imports DIGITS-VERIFICATION
+
+  claim [digits-loop]:
+    <k>
+      #while(
+        Compare(Name("n"), CmpOp(">", Int(0))),
+        If(
+          Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
+          If(
+            Compare(Name("product"), CmpOp("==", Int(0))),
+            Assign(Name("product"), BinOp("%", Name("n"), Int(10))),
+            AugAssign(
+              Name("product"),
+              "*",
+              BinOp("%", Name("n"), Int(10)))),
+          .Stmts)
+        AugAssign(Name("n"), "//", Int(10)))
+      ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "digits" |->
+                closureVal(
+                  "n",
+                  Assign(Name("product"), Int(0))
+                  While(
+                    Compare(Name("n"), CmpOp(">", Int(0))),
+                    If(
+                      Compare(
+                        BinOp("%", Name("n"), Int(2)),
+                        CmpOp("==", Int(1))),
+                      If(
+                        Compare(Name("product"), CmpOp("==", Int(0))),
+                        Assign(
+                          Name("product"),
+                          BinOp("%", Name("n"), Int(10))),
+                        AugAssign(
+                          Name("product"),
+                          "*",
+                          BinOp("%", Name("n"), Int(10)))),
+                      .Stmts)
+                    AugAssign(Name("n"), "//", Int(10)))
+                  Return(Name("product")),
+                  0),
+              parent(-1))
+      1  |-> scope(
+              .Map [ "n" <- N:Int ] [ "product" <- A:Int ],
+              parent(0))
+      =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "digits" |->
+                closureVal(
+                  "n",
+                  Assign(Name("product"), Int(0))
+                  While(
+                    Compare(Name("n"), CmpOp(">", Int(0))),
+                    If(
+                      Compare(
+                        BinOp("%", Name("n"), Int(2)),
+                        CmpOp("==", Int(1))),
+                      If(
+                        Compare(Name("product"), CmpOp("==", Int(0))),
+                        Assign(
+                          Name("product"),
+                          BinOp("%", Name("n"), Int(10))),
+                        AugAssign(
+                          Name("product"),
+                          "*",
+                          BinOp("%", Name("n"), Int(10)))),
+                      .Stmts)
+                    AugAssign(Name("n"), "//", Int(10)))
+                  Return(Name("product")),
+                  0),
+              parent(-1))
+      1  |-> scope(
+              .Map
+                [ "n" <- 0 ]
+                [ "product" <- oddDigitProduct(N, A) ],
+              parent(0))
+    </scopes>
+    requires N >=Int 0 andBool A >=Int 0
+
+  claim [digits-correct]:
+    <k>
+      Call(Name("digits"), Int(N:Int))
+      =>
+      oddDigitProduct(N, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "digits" |->
+                closureVal(
+                  "n",
+                  Assign(Name("product"), Int(0))
+                  While(
+                    Compare(Name("n"), CmpOp(">", Int(0))),
+                    If(
+                      Compare(
+                        BinOp("%", Name("n"), Int(2)),
+                        CmpOp("==", Int(1))),
+                      If(
+                        Compare(Name("product"), CmpOp("==", Int(0))),
+                        Assign(
+                          Name("product"),
+                          BinOp("%", Name("n"), Int(10))),
+                        AugAssign(
+                          Name("product"),
+                          "*",
+                          BinOp("%", Name("n"), Int(10)))),
+                      .Stmts)
+                    AugAssign(Name("n"), "//", Int(10)))
+                  Return(Name("product")),
+                  0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4f7530a1f915602c1240a9eb93103f34812332be
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,70 @@
+requires "reference-semantics/semantics.k"
+
+module DIGITS-VERIFICATION
+  imports MPY
+
+  // Product of the odd decimal digits of N, accumulated into A.  The value
+  // zero is the implementation's sentinel for "no odd digit seen yet".
+  syntax Int ::= oddDigitProduct(Int, Int) [function, total]
+               | oddDigitStep(Bool, Int, Int, Int) [function, total]
+
+  rule oddDigitProduct(0, A:Int) => A
+
+  rule oddDigitProduct(N:Int, A:Int)
+    => oddDigitStep(
+         pyMod(N, 2) ==Int 1,
+         (N -Int pyMod(N, 10)) /Int 10,
+         pyMod(N, 10),
+         A)
+    requires N >Int 0
+
+  rule oddDigitStep(B:Bool, Q:Int, _:Int, A:Int)
+    => oddDigitProduct(Q, A)
+    requires notBool B
+
+  rule oddDigitStep(B:Bool, Q:Int, D:Int, 0)
+    => oddDigitProduct(Q, D)
+    requires B
+
+  rule oddDigitStep(B:Bool, Q:Int, D:Int, A:Int)
+    => oddDigitProduct(Q, A *Int D)
+    requires B andBool A =/=Int 0
+
+  // Target-side function equations are not re-fired automatically after the
+  // symbolic execution learns a branch condition.  These three simplifiers
+  // expose the same defining recurrence when the prover compares the
+  // post-state of one loop iteration with the invariant's original state.
+  rule {
+    oddDigitProduct(
+      (N -Int ((N %Int 10 +Int 10) %Int 10)) /Int 10,
+      A)
+    #Equals
+    oddDigitProduct(N, A)
+  } => true
+    requires N >Int 0
+     andBool pyMod(N, 2) =/=Int 1
+    [simplification]
+
+  rule {
+    oddDigitProduct(
+      (N -Int ((N %Int 10 +Int 10) %Int 10)) /Int 10,
+      (N %Int 10 +Int 10) %Int 10)
+    #Equals
+    oddDigitProduct(N, 0)
+  } => true
+    requires N >Int 0
+     andBool pyMod(N, 2) ==Int 1
+    [simplification]
+
+  rule {
+    oddDigitProduct(
+      (N -Int ((N %Int 10 +Int 10) %Int 10)) /Int 10,
+      A *Int ((N %Int 10 +Int 10) %Int 10))
+    #Equals
+    oddDigitProduct(N, A)
+  } => true
+    requires N >Int 0
+     andBool A =/=Int 0
+     andBool pyMod(N, 2) ==Int 1
+    [simplification]
+endmodule

