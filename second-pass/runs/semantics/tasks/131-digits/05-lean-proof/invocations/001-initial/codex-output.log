new file mode 100644
index 0000000000000000000000000000000000000000..b66a01bab28f49843deff252287f6b438b786501
--- /dev/null
+++ b/lean-wrapper.c
@@ -0,0 +1,14 @@
+#include <lean/lean.h>
+
+extern lean_object *initialize_Lean(uint8_t builtin);
+extern int lean_main(int argc, char **argv);
+
+int main(int argc, char **argv) {
+  lean_initialize();
+  lean_set_panic_messages(false);
+  lean_object *init_result = initialize_Lean(1);
+  lean_dec(init_result);
+  lean_set_panic_messages(true);
+  lean_io_mark_end_initialization();
+  return lean_main(argc, argv);
+}

