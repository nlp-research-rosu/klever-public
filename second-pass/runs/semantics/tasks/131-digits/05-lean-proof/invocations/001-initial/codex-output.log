+        (kmod (Int.ofNat n) 10) := by
+  rw [oddNat]
+  simp [hn, hodd]
+
+theorem oddNat_later
+    (n : Nat) (A : Int) (hn : n ≠ 0)
+    (hodd : kmod (Int.ofNat n) 2 = 1) (hA : A ≠ 0) :
+    oddNat n A =
+      oddNat (((Int.ofNat n - kmod (Int.ofNat n) 10).tdiv 10).toNat)
+        (A * kmod (Int.ofNat n) 10) := by
