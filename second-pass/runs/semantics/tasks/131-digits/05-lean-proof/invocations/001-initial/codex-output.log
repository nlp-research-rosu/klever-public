+import Klean131Digits.Lemmas
+
+#check Int.tdiv
+#check Int.tmod
+#check Int.ediv
+#check Int.emod
+#check Int.ofNat_toNat
+#check Int.toNat_of_nonneg
+#check Int.toNat_ofNat
+#check Int.natAbs_ofNat
+#check Int.natAbs_of_nonneg
+#check Int.tmod_eq_emod
+#check Int.tdiv_eq_ediv
+#check Nat.div_lt_self
+#check Nat.mod_lt
+#check Bool.and_eq_true
+#check Bool.not_eq_true
+#check beq_iff_eq
+#check of_decide_eq_true
+
+example (n : Nat) (h : 0 < n) : n / 10 < n := by omega
+
+def kmod (a b : Int) : Int := (a.tmod b + b).tmod b
+
+example (n : Nat) : (Int.ofNat n).tmod 10 = Int.ofNat (n % 10) := by
+  simp [Int.tmod_eq_emod]
+
+example (n : Nat) : kmod (Int.ofNat n) 10 = Int.ofNat (n % 10) := by
+  simp [kmod, Int.tmod_eq_emod]
+
+example (n : Nat) :
+    (((Int.ofNat n - kmod (Int.ofNat n) 10).tdiv 10).toNat) = n / 10 := by
+  simp [kmod, Int.tmod_eq_emod, Int.tdiv_eq_ediv, Nat.sub_mod_eq_sub_mod]
+
+def oddNat (n : Nat) (A : Int) : Int :=
+  if hn : n = 0 then
+    A
+  else
+    let N : Int := Int.ofNat n
+    let D := kmod N 10
+    let Q : Nat := ((N - D).tdiv 10).toNat
+    if kmod N 2 = 1 then
+      if A = 0 then oddNat Q D else oddNat Q (A * D)
+    else
+      oddNat Q A
+termination_by n
+decreasing_by
+  all_goals
+    simp_all [kmod, Int.tmod_eq_emod, Int.tdiv_eq_ediv]
+    omega
diff --git a/fixproc.c b/fixproc.c
new file mode 100644
index 0000000000000000000000000000000000000000..499a9a6b24cb7a6a3560302308a7fde3a4101a7b
--- /dev/null
+++ b/fixproc.c
@@ -0,0 +1,17 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static readlink_fn real_readlink = 0;
+  if (!real_readlink)
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  size_t len = strlen(path);
+  if (len > 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + len - 4, "/exe") == 0)
+    return real_readlink("/proc/self/exe", buf, size);
+  return real_readlink(path, buf, size);
+}
