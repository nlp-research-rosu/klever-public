+    exact (oddNat_even N.toNat A hn hparity).symm
+  constructor
+  · intro N h
+    have hcond : N > 0 ∧ kmod N 2 = 1 := by
+      simpa [kand, kgt, keq] using h
+    obtain ⟨hN, hparity⟩ := hcond
+    have hcast : Int.ofNat N.toNat = N :=
+      Int.toNat_of_nonneg (le_of_lt hN)
+    have hn : N.toNat ≠ 0 := by
+      intro hz
+      rw [hz] at hcast
+      simp at hcast
+      omega
+    rw [← hcast] at hparity ⊢
+    change
+      oddNat
+          (((Int.ofNat N.toNat -
+              kmod (Int.ofNat N.toNat) 10).tdiv 10).toNat)
+          (kmod (Int.ofNat N.toNat) 10) =
+        oddNat N.toNat 0
+    exact (oddNat_first N.toNat hn hparity).symm
+  · intro A N h
+    have hcond : (N > 0 ∧ A ≠ 0) ∧ kmod N 2 = 1 := by
+      simpa [kand, kgt, kne, keq] using h
+    obtain ⟨⟨hN, hA⟩, hparity⟩ := hcond
