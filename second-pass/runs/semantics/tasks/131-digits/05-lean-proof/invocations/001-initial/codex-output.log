+def kand : Bool → Bool → Bool := Bool.and
+def kgt (a b : Int) : Bool := decide (a > b)
+def keq (a b : Int) : Bool := decide (a = b)
+def kne (a b : Int) : Bool := decide (a ≠ b)
+def ktmod : Int → Int → Int := Int.tmod
+def kadd : Int → Int → Int := Int.add
+def ktdiv : Int → Int → Int := Int.tdiv
+def kmul : Int → Int → Int := Int.mul
+def kproduct (N A : Int) : Int := oddNat N.toNat A
+
+theorem targetScratch :
+    Klean131Digits.Lemmas.targetStatement
