+    have hn : N.toNat ≠ 0 := by
+      intro hz
+      rw [hz] at hcast
+      simp at hcast
+      omega
+    rw [← hcast] at hparity ⊢
+    change
+      oddNat
+          (((Int.ofNat N.toNat -
+              kmod (Int.ofNat N.toNat) 10).tdiv 10).toNat)
+          (A * kmod (Int.ofNat N.toNat) 10) =
+        oddNat N.toNat A
