+      Int.toNat_of_nonneg (Int.le_of_lt hN)
+    have hn : N.toNat ≠ 0 := by
+      intro hz
+      rw [hz] at hcast
+      simp at hcast
+      exact (Int.ne_of_gt hN) hcast.symm
+    rw [← hcast] at hparity ⊢
+    change
+      oddNat
+          (((Int.ofNat N.toNat -
+              kmod (Int.ofNat N.toNat) 10).tdiv 10).toNat)
