+    have hn : N.toNat ≠ 0 := by
+      intro hz
+      rw [hz] at hcast
+      simp at hcast
+      exact (Int.ne_of_gt hN) hcast.symm
+    rw [← hcast] at hparity ⊢
+    change
+      oddNat
+          (((Int.ofNat N.toNat -
+              kmod (Int.ofNat N.toNat) 10).tdiv 10).toNat)
+          A =
+        oddNat N.toNat A
+    exact (oddNat_even N.toNat A hn hparity).symm
+  constructor
+  · intro N h
+    have hcond : N > 0 ∧ kmod N 2 = 1 := by
