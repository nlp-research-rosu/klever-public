+decreasing_by
+  all_goals
+    rw [quotient_ofNat]
+    exact Nat.div_lt_self (Nat.pos_of_ne_zero hn) (by decide)
+
+#check oddNat.eq_def
+#check oddNat.eq_1
+
+theorem oddNat_even
+    (n : Nat) (A : Int) (hn : n ≠ 0)
+    (heven : kmod (Int.ofNat n) 2 ≠ 1) :
+    oddNat n A =
