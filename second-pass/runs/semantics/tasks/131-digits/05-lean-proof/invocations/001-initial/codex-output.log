diff --git a/Explore.lean b/Explore.lean
new file mode 100644
index 0000000000000000000000000000000000000000..eff86942880b97dd7bb636cd4a7eb17fab67fb37
--- /dev/null
+++ b/Explore.lean
@@ -0,0 +1,92 @@
+import Klean131Digits.Lemmas
+
+#check Int.tdiv
+#check Int.tmod
+#check Int.ediv
+#check Int.emod
+#check Int.ofNat_toNat
+#check Int.toNat_of_nonneg
+#check Int.toNat_ofNat
+#check Int.natAbs_ofNat
+#check Int.natAbs_of_nonneg
+#check Int.tmod_eq_emod
+#check Int.tdiv_eq_ediv
+#check Int.emod_nonneg
+#check Int.emod_lt
+#check Int.ediv_emod_unique
+#check Int.ediv_add_emod
+#check Int.ofNat_ediv
+#check Int.ofNat_emod
+#check Int.ofNat_zero_le
+#check Int.toNat_of_nonneg
+#check Int.emod_eq_of_lt
+#check Int.add_emod
+#check Int.sub_emod
+#check Int.mul_ediv_cancel_left
+#check Int.mul_ediv_cancel
+#check Int.ediv_mul_cancel
+#check Nat.div_lt_self
+#check Nat.mod_lt
+#check Bool.and_eq_true
+#check Bool.not_eq_true
+#check beq_iff_eq
+#check of_decide_eq_true
+
+example (n : Nat) (h : 0 < n) : n / 10 < n := by omega
+
+def kmod (a b : Int) : Int := (a.tmod b + b).tmod b
+
+theorem tmod_of_nonneg (a b : Int) (ha : 0 ≤ a) :
+    a.tmod b = a % b := by
+  simp [Int.tmod_eq_emod, ha]
+
+example (n : Nat) : (Int.ofNat n).tmod 10 = Int.ofNat (n % 10) := by
+  simp [Int.tmod_eq_emod]
+
+theorem kmod_ofNat (n : Nat) : kmod (Int.ofNat n) 10 = Int.ofNat (n % 10) := by
+  unfold kmod
+  rw [show (Int.ofNat n).tmod 10 = (Int.ofNat n) % 10 by
+    exact tmod_of_nonneg _ _ (Int.ofNat_zero_le n)]
+  rw [tmod_of_nonneg _ _ (by
+    have := Int.emod_nonneg (Int.ofNat n) (by omega : (10:Int) ≠ 0)
+    omega)]
+  rw [Int.add_emod]
+  simp
+
+theorem quotient_ofNat (n : Nat) :
+    (((Int.ofNat n - kmod (Int.ofNat n) 10).tdiv 10).toNat) = n / 10 := by
+  rw [show kmod (Int.ofNat n) 10 = Int.ofNat (n % 10) by
+    unfold kmod
+    rw [show (Int.ofNat n).tmod 10 = (Int.ofNat n) % 10 by
+      exact tmod_of_nonneg _ _ (Int.ofNat_zero_le n)]
+    rw [tmod_of_nonneg _ _ (by
+      have := Int.emod_nonneg (Int.ofNat n) (by omega : (10:Int) ≠ 0)
+      omega)]
+    rw [Int.add_emod]
+    simp]
+  have hdecomp := Int.ediv_add_emod (Int.ofNat n) 10
+  have hmod : (Int.ofNat n) % 10 = Int.ofNat (n % 10) := by simp
+  have hdiv : (Int.ofNat n) / 10 = Int.ofNat (n / 10) := by simp
+  have hnum :
+      Int.ofNat n - Int.ofNat (n % 10) = 10 * Int.ofNat (n / 10) := by
+    omega
+  rw [hnum, Int.tdiv_eq_ediv]
+  simp
+  exact Int.toNat_ofNat (n / 10)
+
+def oddNat (n : Nat) (A : Int) : Int :=
+  if hn : n = 0 then
+    A
+  else
+    let N : Int := Int.ofNat n
+    let D := kmod N 10
+    let Q : Nat := ((N - D).tdiv 10).toNat
+    if kmod N 2 = 1 then
+      if A = 0 then oddNat Q D else oddNat Q (A * D)
+    else
+      oddNat Q A
+termination_by n
+decreasing_by
+  all_goals
+    rw [quotient_ofNat]
+    exact Nat.div_lt_self (Nat.pos_of_ne_zero hn) (by decide)
diff --git a/fixproc.c b/fixproc.c
new file mode 100644
index 0000000000000000000000000000000000000000..499a9a6b24cb7a6a3560302308a7fde3a4101a7b
--- /dev/null
+++ b/fixproc.c
@@ -0,0 +1,17 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static readlink_fn real_readlink = 0;
+  if (!real_readlink)
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  size_t len = strlen(path);
+  if (len > 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + len - 4, "/exe") == 0)
+    return real_readlink("/proc/self/exe", buf, size);
+  return real_readlink(path, buf, size);
+}
