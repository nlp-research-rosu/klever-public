+theorem quotient_ofNat (n : Nat) :
+    (((Int.ofNat n - pyModCore (Int.ofNat n) 10).tdiv 10).toNat) =
+      n / 10 := by
+  rw [show pyModCore (Int.ofNat n) 10 = Int.ofNat (n % 10) by
