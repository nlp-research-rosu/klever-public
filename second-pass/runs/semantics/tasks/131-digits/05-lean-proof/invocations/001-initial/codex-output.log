Int.ofNat_toNat (a : Int) : ↑a.toNat = max a 0
Int.toNat_of_nonneg {a : Int} (h : 0 ≤ a) : ↑a.toNat = a
Int.toNat_ofNat (n : Nat) : (↑n).toNat = n
Int.natAbs_ofNat (n : Nat) : (↑n).natAbs = n
Int.natAbs_of_nonneg {a : Int} (H : 0 ≤ a) : ↑a.natAbs = a
Int.tmod_eq_emod {a b : Int} : a.tmod b = a % b - ↑(if 0 ≤ a ∨ b ∣ a then 0 else b.natAbs)
Int.tdiv_eq_ediv {a b : Int} : a.tdiv b = a / b + if 0 ≤ a ∨ b ∣ a then 0 else b.sign
Int.emod_nonneg (a : Int) {b : Int} : b ≠ 0 → 0 ≤ a % b
Int.emod_lt (a : Int) {b : Int} (h : b ≠ 0) : a % b < ↑b.natAbs
Int.ediv_emod_unique {a b r q : Int} (h : 0 < b) : a / b = q ∧ a % b = r ↔ r + b * q = a ∧ 0 ≤ r ∧ r < b
Int.ediv_add_emod (a b : Int) : b * (a / b) + a % b = a
Int.ofNat_ediv (m n : Nat) : ↑(m / n) = ↑m / ↑n
Int.ofNat_emod (m n : Nat) : ↑(m % n) = ↑m % ↑n
Int.emod_eq_of_lt {a b : Int} (H1 : 0 ≤ a) (H2 : a < b) : a % b = a
Int.add_emod (a b n : Int) : (a + b) % n = (a % n + b % n) % n
Int.sub_emod (a b n : Int) : (a - b) % n = (a % n - b % n) % n
Nat.div_lt_self {n k : Nat} (hLtN : 0 < n) (hLtK : 1 < k) : n / k < n
Nat.mod_lt (x : Nat) {y : Nat} : y > 0 → x % y < y
