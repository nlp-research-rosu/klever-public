+  simp [Int.tmod_eq_emod]
+
+theorem kmod_ofNat (n : Nat) : kmod (Int.ofNat n) 10 = Int.ofNat (n % 10) := by
+  unfold kmod
+  rw [show (Int.ofNat n).tmod 10 = (Int.ofNat n) % 10 by
+    exact tmod_of_nonneg _ _ (Int.ofNat_zero_le n)]
+  rw [tmod_of_nonneg _ _ (by
+    have := Int.emod_nonneg (Int.ofNat n) (by omega : (10:Int) ≠ 0)
+    omega)]
+  rw [Int.add_emod]
+  simp
+
+theorem quotient_ofNat (n : Nat) :
+    (((Int.ofNat n - kmod (Int.ofNat n) 10).tdiv 10).toNat) = n / 10 := by
+  rw [show kmod (Int.ofNat n) 10 = Int.ofNat (n % 10) by
+    unfold kmod
+    rw [show (Int.ofNat n).tmod 10 = (Int.ofNat n) % 10 by
+      exact tmod_of_nonneg _ _ (Int.ofNat_zero_le n)]
+    rw [tmod_of_nonneg _ _ (by
+      have := Int.emod_nonneg (Int.ofNat n) (by omega : (10:Int) ≠ 0)
+      omega)]
+    rw [Int.add_emod]
+    simp]
+  have hdecomp := Int.ediv_add_emod (Int.ofNat n) 10
+  have hmod : (Int.ofNat n) % 10 = Int.ofNat (n % 10) := by simp
+  have hdiv : (Int.ofNat n) / 10 = Int.ofNat (n / 10) := by simp
+  have hnum :
+      Int.ofNat n - Int.ofNat (n % 10) = 10 * Int.ofNat (n / 10) := by
+    omega
+  rw [hnum, Int.tdiv_eq_ediv]
+  simp
+  exact Int.toNat_ofNat (n / 10)
+
+def oddNat (n : Nat) (A : Int) : Int :=
+  if hn : n = 0 then
+    A
+  else
+    let N : Int := Int.ofNat n
+    let D := kmod N 10
+    let Q : Nat := ((N - D).tdiv 10).toNat
+    if kmod N 2 = 1 then
+      if A = 0 then oddNat Q D else oddNat Q (A * D)
+    else
