TRACE_CALL 14 name=apply_patch args="*** Begin Patch\n*** Add File: /work/verification.k\n+requires \"reference-semantics/semantics.k\"\n+\n+module DIGITS-VERIFICATION\n+  imports MPY\n+\n+  // Product of the odd decimal digits of N, accumulated into A.  The value\n+  // zero is the implementation's sentinel for \"no odd digit seen yet\".\n+  syntax Int ::= oddDigitProduct(Int, Int) [function]\n+\n+  rule oddDigitProduct(0, A:Int) => A\n+\n+  rule oddDigitProduct(N:Int, A:Int)\n+    => oddDigitProduct(\n+         (N -Int pyMod(N, 10)) /Int 10,\n+         A)\n+    requires N >Int 0\n+     andBool pyMod(N, 2) ==Int 0\n+\n+  rule oddDigitProduct(N:Int, 0)\n+    => oddDigitProduct(\n+         (N -Int pyMod(N, 10)) /Int 10,\n+         pyMod(N, 10))\n+    requires N >Int 0\n+     andBool pyMod(N, 2) ==Int 1\n+\n+  rule oddDigitProduct(N:Int, A:Int)\n+    => oddDigitProduct(\n+         (N -Int pyMod(N, 10)) /Int 10,\n+         A *Int pyMod(N, 10))\n+    requires N >Int 0\n+     andBool A =/=Int 0\n+     andBool pyMod(N, 2) ==Int 1\n+endmodule\n*** End Patch\n"
