+    required_path_keys = [
+        "audit_campaign_lock",
+        "candidate",
+        "canonical",
+        "generation_last",
+        "generation_manifest",
+        "generation_metrics",
+        "generation_output",
+        "generation_root",
+        "generation_trace",
+        "run_manifest",
+        "stage1_result",
+        "task_manifest",
+        "translator",
+        "trusted_prompt",
+    ]
+    for key in required_path_keys:
+        path = paths[key]
+        if key in {"candidate", "generation_root", "generation_trace"}:
+            require_directory(path, f"container_paths.{key}")
+        else:
+            require_regular(path, f"container_paths.{key}")
+
