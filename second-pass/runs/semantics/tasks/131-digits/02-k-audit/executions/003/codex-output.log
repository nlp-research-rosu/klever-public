     1	def digits(n):
     2	    product = 0
     3	    while n > 0:
     4	        if n % 2 == 1:
     5	            if product == 0:
     6	                product = n % 10
     7	            else:
     8	                product *= n % 10
     9	        n //= 10
    10	    return product
