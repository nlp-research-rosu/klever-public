log=/audit-output/evidence/stage5_connection-build.log
printf '%s\\n' '+ cp /audit-output/evidence/verification-base.k /audit-output/evidence/simplifier-connection-spec.k /tmp/audit-work/reconstruction/' | tee \""'$log"
