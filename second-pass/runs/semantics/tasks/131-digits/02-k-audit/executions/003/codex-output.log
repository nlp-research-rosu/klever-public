     6	def digits(n):
     7	    """Given a positive integer n, return the product of the odd digits.
     8	    Return 0 if all digits are even.
     9	    For example:
    10	    digits(1)  == 1
    11	    digits(4)  == 0
    12	    digits(235) == 15
    13	    """
    14	    product = 1
    15	    odd_count = 0
    16	    for digit in str(n):
    17	        int_digit = int(digit)
    18	        if int_digit%2 == 1:
    19	            product= product*int_digit
    20	            odd_count+=1
    21	    if odd_count ==0:
    22	        return 0
    23	    else:
    24	        return product
