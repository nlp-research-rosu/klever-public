Module(
  FuncDef("digits", Params("n"),
    Assign(Name("product"), Int(0))
    While(Compare(Name("n"), CmpOp(">", Int(0))),
      If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
        If(Compare(Name("product"), CmpOp("==", Int(0))),
          Assign(Name("product"), BinOp("%", Name("n"), Int(10))),
          AugAssign(
            Name("product"),
            "*",
            BinOp("%", Name("n"), Int(10)))),
        )
      AugAssign(Name("n"), "//", Int(10)))
    Return(Name("product")))
  Assert(Compare(Call(Name("digits"), Int(0)), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("digits"), Int(1)), CmpOp("==", Int(1))))
  Assert(Compare(Call(Name("digits"), Int(2)), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("digits"), Int(4)), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("digits"), Int(9)), CmpOp("==", Int(9))))
  Assert(Compare(Call(Name("digits"), Int(10)), CmpOp("==", Int(1))))
  Assert(Compare(Call(Name("digits"), Int(11)), CmpOp("==", Int(1))))
  Assert(Compare(Call(Name("digits"), Int(99)), CmpOp("==", Int(81))))
  Assert(Compare(Call(Name("digits"), Int(100)), CmpOp("==", Int(1))))
  Assert(Compare(Call(Name("digits"), Int(235)), CmpOp("==", Int(15))))
  Assert(Compare(Call(Name("digits"), Int(2468)), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("digits"), Int(10203)), CmpOp("==", Int(3))))
  Assert(
    Compare(Call(Name("digits"), Int(13579)), CmpOp("==", Int(945)))))
