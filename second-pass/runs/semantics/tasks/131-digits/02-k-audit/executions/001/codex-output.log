+  return 0
+}
+
+run timeout 600 kompile \
+  "$WORK_DIR/verification-base.k" \
+  --backend haskell \
+  --main-module DIGITS-VERIFICATION-BASE \
+  --syntax-module MPY-SYNTAX \
+  --output-definition "$WORK_DIR/verification-base-kompiled"
