index 0000000000000000000000000000000000000000..f08040cd00edaf5476c12031bf49614d9bddb386
--- /dev/null
+++ b/evidence/stage2_fidelity.sh
@@ -0,0 +1,46 @@
+#!/usr/bin/env bash
+set -u
+
