    12	    digits(235) == 15
    13	    """
    14	    product = 1
    15	    odd_count = 0
    16	    for digit in str(n):
    17	        int_digit = int(digit)
    18	        if int_digit%2 == 1:
    19	            product= product*int_digit
    20	            odd_count+=1
    21	    if odd_count ==0:
    22	        return 0
    23	    else:
    24	        return product

