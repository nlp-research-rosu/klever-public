+#!/usr/bin/env bash
+set -u
+
+EVIDENCE_DIR=/audit-output/evidence
+WORK_DIR=/tmp/audit-work/audit-131-digits
+CANDIDATE_DIR="$WORK_DIR/candidate"
+LOG_FILE="$EVIDENCE_DIR/stage3_rebuild.log"
+
