+    "$WORK_DIR/regenerated-solution.mpy"
+} >> "$LOG_FILE"
+python3 "$WORK_DIR/trusted/py2mpy.py" \
+  "$WORK_DIR/candidate/solution.py" \
+  > "$WORK_DIR/regenerated-solution.mpy" 2>> "$LOG_FILE"
