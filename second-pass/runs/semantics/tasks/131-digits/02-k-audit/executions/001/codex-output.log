diff --git a//tmp/audit-work/audit-131-digits/extension-lemmas.k b//tmp/audit-work/audit-131-digits/extension-lemmas.k
new file mode 100644
index 0000000000000000000000000000000000000000..83ecd4947ad1506feb16417c4860f43af06f119f
--- /dev/null
+++ b//tmp/audit-work/audit-131-digits/extension-lemmas.k
@@ -0,0 +1,39 @@
+requires "verification-base.k"
+
+module EXTENSION-LEMMAS
+  imports DIGITS-VERIFICATION-BASE
+
+  claim [even-step-equation]:
+    <k>
+      oddDigitProduct(
+        (N -Int ((N %Int 10 +Int 10) %Int 10)) /Int 10,
+        A)
+      =>
+      oddDigitProduct(N, A)
+    </k>
+    requires N >Int 0
+     andBool pyMod(N, 2) =/=Int 1
+
+  claim [first-odd-step-equation]:
+    <k>
+      oddDigitProduct(
+        (N -Int ((N %Int 10 +Int 10) %Int 10)) /Int 10,
+        (N %Int 10 +Int 10) %Int 10)
+      =>
+      oddDigitProduct(N, 0)
+    </k>
+    requires N >Int 0
+     andBool pyMod(N, 2) ==Int 1
+
+  claim [later-odd-step-equation]:
+    <k>
+      oddDigitProduct(
+        (N -Int ((N %Int 10 +Int 10) %Int 10)) /Int 10,
+        A *Int ((N %Int 10 +Int 10) %Int 10))
+      =>
+      oddDigitProduct(N, A)
+    </k>
+    requires N >Int 0
+     andBool A =/=Int 0
+     andBool pyMod(N, 2) ==Int 1
+endmodule
diff --git a//tmp/audit-work/audit-131-digits/program-pinning.k b//tmp/audit-work/audit-131-digits/program-pinning.k
new file mode 100644
index 0000000000000000000000000000000000000000..f8afea375656190b22e4e7ef4953590893cb4e44
--- /dev/null
+++ b//tmp/audit-work/audit-131-digits/program-pinning.k
@@ -0,0 +1,73 @@
+requires "candidate/spec.k"
+
+module PROGRAM-PINNING
+  imports DIGITS-SPEC
+
+  claim [program-pinned]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("digits", Params("n"),
+            Assign(Name("product"), Int(0))
+            While(Compare(Name("n"), CmpOp(">", Int(0))),
+              If(
+                Compare(
+                  BinOp("%", Name("n"), Int(2)),
+                  CmpOp("==", Int(1))),
+                If(
+                  Compare(Name("product"), CmpOp("==", Int(0))),
+                  Assign(
+                    Name("product"),
+                    BinOp("%", Name("n"), Int(10))),
+                  AugAssign(
+                    Name("product"),
+                    "*",
+                    BinOp("%", Name("n"), Int(10)))),
+                .Stmts)
+              AugAssign(Name("n"), "//", Int(10)))
+            Return(Name("product")))))
+      ~> Call(Name("digits"), Int(N:Int))
+      =>
+      oddDigitProduct(N, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+      =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "digits" |->
+                closureVal(
+                  "n",
+                  Assign(Name("product"), Int(0))
+                  While(
+                    Compare(Name("n"), CmpOp(">", Int(0))),
+                    If(
+                      Compare(
+                        BinOp("%", Name("n"), Int(2)),
+                        CmpOp("==", Int(1))),
+                      If(
+                        Compare(Name("product"), CmpOp("==", Int(0))),
+                        Assign(
+                          Name("product"),
+                          BinOp("%", Name("n"), Int(10))),
+                        AugAssign(
+                          Name("product"),
+                          "*",
+                          BinOp("%", Name("n"), Int(10)))),
+                      .Stmts)
+                    AugAssign(Name("n"), "//", Int(10)))
+                  Return(Name("product")),
+                  0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0
+endmodule
diff --git a//tmp/audit-work/audit-131-digits/reviewer-concrete-tests.py b//tmp/audit-work/audit-131-digits/reviewer-concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..f94c8fb8dc0b71481923421303e70b2a0da0f67b
--- /dev/null
+++ b//tmp/audit-work/audit-131-digits/reviewer-concrete-tests.py
@@ -0,0 +1,25 @@
+def digits(n):
+    product = 0
+    while n > 0:
+        if n % 2 == 1:
+            if product == 0:
+                product = n % 10
+            else:
+                product *= n % 10
+        n //= 10
+    return product
+
+
+assert digits(0) == 0
+assert digits(1) == 1
+assert digits(2) == 0
+assert digits(4) == 0
+assert digits(9) == 9
+assert digits(10) == 1
+assert digits(11) == 1
+assert digits(99) == 81
+assert digits(100) == 1
+assert digits(235) == 15
+assert digits(2468) == 0
+assert digits(10203) == 3
+assert digits(13579) == 945
diff --git a//tmp/audit-work/audit-131-digits/verification-base.k b//tmp/audit-work/audit-131-digits/verification-base.k
new file mode 100644
index 0000000000000000000000000000000000000000..511b784ef83e45884b7d338df258bbb60389d9e5
--- /dev/null
+++ b//tmp/audit-work/audit-131-digits/verification-base.k
@@ -0,0 +1,30 @@
+requires "candidate/reference-semantics/semantics.k"
+
+module DIGITS-VERIFICATION-BASE
+  imports MPY
+
+  syntax Int ::= oddDigitProduct(Int, Int) [function, total]
+               | oddDigitStep(Bool, Int, Int, Int) [function, total]
+
+  rule oddDigitProduct(0, A:Int) => A
+
+  rule oddDigitProduct(N:Int, A:Int)
+    => oddDigitStep(
+         pyMod(N, 2) ==Int 1,
+         (N -Int pyMod(N, 10)) /Int 10,
+         pyMod(N, 10),
+         A)
+    requires N >Int 0
+
+  rule oddDigitStep(B:Bool, Q:Int, _:Int, A:Int)
+    => oddDigitProduct(Q, A)
+    requires notBool B
+
+  rule oddDigitStep(B:Bool, Q:Int, D:Int, 0)
+    => oddDigitProduct(Q, D)
+    requires B
+
+  rule oddDigitStep(B:Bool, Q:Int, D:Int, A:Int)
+    => oddDigitProduct(Q, A *Int D)
+    requires B andBool A =/=Int 0
+endmodule
