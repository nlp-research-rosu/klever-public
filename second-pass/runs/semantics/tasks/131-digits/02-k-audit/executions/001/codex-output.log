index 0000000000000000000000000000000000000000..50fe8cba9c06e61e8b4832ed1a57743b051e9ca7
--- /dev/null
+++ b/evidence/stage3_rebuild.sh
@@ -0,0 +1,76 @@
+#!/usr/bin/env bash
+set -u
+
