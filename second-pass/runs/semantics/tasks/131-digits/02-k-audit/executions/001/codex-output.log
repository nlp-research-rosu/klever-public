+LOG_FILE="$EVIDENCE_DIR/stage2_fidelity.log"
+
+: > "$LOG_FILE"
+
+run() {
+  {
+    printf 'COMMAND:'
+    printf ' %q' "$@"
+    printf '\n'
+  } >> "$LOG_FILE"
+  "$@" >> "$LOG_FILE" 2>&1
+  status=$?
+  printf 'EXIT_STATUS: %d\n\n' "$status" >> "$LOG_FILE"
+  return 0
+}
+
+run python3 "$WORK_DIR/trusted/py2mpy.py" \
+  "$WORK_DIR/candidate/solution.py"
