index 0000000000000000000000000000000000000000..0f800b8f9fef1600aa73d3a450be4773f9a69df8
--- /dev/null
+++ b/evidence/stage5_inventory.sh
@@ -0,0 +1,17 @@
+#!/usr/bin/env bash
+set -u
+
+LOG_FILE=/audit-output/evidence/stage5_inventory.log
