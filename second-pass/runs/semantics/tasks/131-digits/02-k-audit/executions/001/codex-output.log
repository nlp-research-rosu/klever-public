+#!/usr/bin/env bash
+set -u
+
+WORK_DIR=/tmp/audit-work/audit-131-digits
+LOG_FILE=/audit-output/evidence/stage5_extension_lemmas.log
+: > "$LOG_FILE"
+
+run() {
+  {
