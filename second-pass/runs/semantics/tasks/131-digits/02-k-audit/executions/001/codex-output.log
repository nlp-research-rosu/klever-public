+CANDIDATE_DIR="$WORK_DIR/candidate"
+MUTATION="$CANDIDATE_DIR/spec-vacuity-audit.k"
+PRESERVED_MUTATION=/audit-output/evidence/spec-vacuity-audit.k
+LOG_FILE=/audit-output/evidence/stage6_nonvacuity.log
+: > "$LOG_FILE"
+
+run() {
