+  --definition "$WORK_DIR/verification-base-kompiled" \
+  --spec-module EXTENSION-LEMMAS \
+  --claims EXTENSION-LEMMAS.first-odd-step-equation
+run timeout 600 kprove \
+  "$WORK_DIR/extension-lemmas.k" \
+  --definition "$WORK_DIR/verification-base-kompiled" \
+  --spec-module EXTENSION-LEMMAS \
