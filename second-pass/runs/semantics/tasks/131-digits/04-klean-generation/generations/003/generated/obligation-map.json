      "normalized_sha256": "4d51675c3f64dd8d5acd7f855e28f517fc1edc539220ae3724773ad4a26eded2",
      "rationale": "This simplifier asserts the non-odd-digit recurrence as an equality fact used during target comparison; it was present in verification.k before kprove ran and has no separate Stage 1 proof against a module omitting it.",
      "source_rule_id": "rule-4d51675c3f64dd8d5acd7f855e28f517fc1edc539220ae3724773ad4a26eded2",
      "start_line": 37,
      "text": "  rule {\n    oddDigitProduct(\n      (N -Int ((N %Int 10 +Int 10) %Int 10)) /Int 10,\n      A)\n    #Equals\n    oddDigitProduct(N, A)\n  } => true\n    requires N >Int 0\n     andBool pyMod(N, 2) =/=Int 1\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "2a00407680a3395423482e655efbf8f90a6525107c72153df942265f88a8f003",
      "end_line": 57,
      "inventory_sha256": "997f9d867d49fb42b1d83ee8bdd60f1713a245267682473af0e3d6032a48e174",
      "module": "DIGITS-VERIFICATION",
      "normalized_sha256": "3978fc0ec976783d9a30feccc0ac292802be0d3aecc09914bc975f6c302270b2",
      "rationale": "This simplifier asserts the first-odd-digit recurrence for a zero accumulator; Stage 1 trusted it in the compiled verification definition rather than first proving its exact statement without the rule.",
      "source_rule_id": "rule-3978fc0ec976783d9a30feccc0ac292802be0d3aecc09914bc975f6c302270b2",
      "start_line": 48,
      "text": "  rule {\n    oddDigitProduct(\n      (N -Int ((N %Int 10 +Int 10) %Int 10)) /Int 10,\n      (N %Int 10 +Int 10) %Int 10)\n    #Equals\n    oddDigitProduct(N, 0)\n  } => true\n    requires N >Int 0\n     andBool pyMod(N, 2) ==Int 1\n    [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "2a00407680a3395423482e655efbf8f90a6525107c72153df942265f88a8f003",
      "end_line": 69,
      "inventory_sha256": "997f9d867d49fb42b1d83ee8bdd60f1713a245267682473af0e3d6032a48e174",
      "module": "DIGITS-VERIFICATION",
      "normalized_sha256": "373920d268cfa5acff78b262ff1885548fb9bfba4fc32627ec554bbb6f424ebd",
      "rationale": "This simplifier asserts the later-odd-digit multiplication recurrence for a nonzero accumulator; it was available to the Stage 1 proof from compilation onward and was not separately established.",
      "source_rule_id": "rule-373920d268cfa5acff78b262ff1885548fb9bfba4fc32627ec554bbb6f424ebd",
      "start_line": 59,
      "text": "  rule {\n    oddDigitProduct(\n      (N -Int ((N %Int 10 +Int 10) %Int 10)) /Int 10,\n      A *Int ((N %Int 10 +Int 10) %Int 10))\n    #Equals\n    oddDigitProduct(N, A)\n  } => true\n    requires N >Int 0\n     andBool A =/=Int 0\n     andBool pyMod(N, 2) ==Int 1\n    [simplification]"
    }
  ],
