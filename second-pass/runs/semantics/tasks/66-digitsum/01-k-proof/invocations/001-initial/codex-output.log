+      ~> #endcall
+      => A:Int +Int digitSumSpec(S)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> digitSumBuiltins
+      ( 1 |->
+        scope(
+          "s" |-> INPUT:Val
+          "result" |-> A
+          "char" |-> OLDCHAR:Val
+          "code" |-> OLDCODE:Val,
