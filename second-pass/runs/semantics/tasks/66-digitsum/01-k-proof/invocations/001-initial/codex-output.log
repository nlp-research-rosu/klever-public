+      1 |->
+        scope(
+          "s" |-> str(S)
+          "result" |-> 0
+          "char" |-> str(.IntSeq)
+          "code" |-> 0,
+          parent(0)
+        )
+    </scopes>
+    <scopeLoc> 1 => 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      .List
+      => ListItem(frame(.K, 0, 1))
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
