diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..92f43161b0021f8f2cc6865e19241c4ddf46b05a
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module DIGIT-SUM-SPEC
+  imports DIGIT-SUM-VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #loop(str(S:IntSeq), Name("char"), digitSumLoopBody)
+      ~> Return(Name("result"))
+      ~> #endcall
+      => A:Int +Int digitSumSpec(S) ~> K:K
+    </k>
+    <env> L:Int => CALLER:Int </env>
+    <scopes>
+      SC:Map (L |-> scope(M:Map [ "result" <- A ], P:Parent))
+      => SC
+    </scopes>
+    <scopeLoc> L +Int 1 => L </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack>
+      ListItem(frame(K, CALLER, L)) STACK:List
+      => STACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool L in_keys(SC)
+
+  claim [entry-point]:
+    <k>
+      Call(
+        closureVal(("s", .ParamNames), digitSumBody, 0),
+        (str(S:IntSeq), .Exprs)
+      )
+      => digitSumSpec(S)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..3f263cd279be26700bf61ef03212c82687dc3c0f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,36 @@
+requires "reference-semantics/semantics.k"
+
+module DIGIT-SUM-VERIFICATION
+  imports MPY
+
+  syntax Stmts ::= "digitSumLoopBody" [macro]
+  rule digitSumLoopBody
+    => Assign(Name("code"), Call(Name("ord"), (Name("char"), .Exprs)))
+       If(
+         BoolOp(
+           "and",
+           ( Compare(Name("code"), CmpOp(">=", Int(65)))
+           , Compare(Name("code"), CmpOp("<=", Int(90)))
+           , .Exprs
+           )
+         ),
+         AugAssign(Name("result"), "+", Name("code")) .Stmts,
+         .Stmts
+       )
+       .Stmts
+
+  syntax Stmts ::= "digitSumBody" [macro]
+  rule digitSumBody
+    => Assign(Name("result"), Int(0))
+       For(Name("char"), Name("s"), digitSumLoopBody)
+       Return(Name("result"))
+       .Stmts
+
+  syntax Int ::= digitSumSpec(IntSeq) [function, total]
+  rule digitSumSpec(.IntSeq) => 0
+  rule digitSumSpec(iCons(C:Int, REST:IntSeq))
+    => (#if C >=Int 65 andBool C <=Int 90
+        #then C
+        #else 0
+        #fi) +Int digitSumSpec(REST)
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module DIGIT-SUM-SPEC --output pretty' in /work
