index 0000000000000000000000000000000000000000..3fe00c199dce335d200e9dfae09f0cde9578cb29
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,7 @@
+def digitSum(s):
+    result = 0
+    for char in s:
+        code = ord(char)
+        if code >= 65 and code <= 90:
+            result += code
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c0ddd349f0604ec6a8482620f208d798518a1be5
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,61 @@
+requires "verification.k"
+
+module DIGIT-SUM-SPEC
+  imports DIGIT-SUM-VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #loop(str(S:IntSeq), Name("char"), digitSumLoopBody)
+      ~> Return(Name("result"))
+      ~> #endcall
+      => A:Int +Int digitSumSpec(S)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      ( 1 |->
+        scope(
+          "s" |-> INPUT:Val
+          "result" |-> A
+          "char" |-> OLDCHAR:Val
+          "code" |-> OLDCODE:Val,
+          parent(0)
+        )
+      )
+      =>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [entry-point]:
+    <k>
+      Call(
+        closureVal(("s", .ParamNames), digitSumBody, 0),
+        (str(S:IntSeq), .Exprs)
+      )
+      => digitSumSpec(S)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..3f263cd279be26700bf61ef03212c82687dc3c0f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,36 @@
+requires "reference-semantics/semantics.k"
+
+module DIGIT-SUM-VERIFICATION
+  imports MPY
+
+  syntax Stmts ::= "digitSumLoopBody" [macro]
+  rule digitSumLoopBody
+    => Assign(Name("code"), Call(Name("ord"), (Name("char"), .Exprs)))
+       If(
+         BoolOp(
+           "and",
+           ( Compare(Name("code"), CmpOp(">=", Int(65)))
+           , Compare(Name("code"), CmpOp("<=", Int(90)))
+           , .Exprs
+           )
+         ),
+         AugAssign(Name("result"), "+", Name("code")) .Stmts,
+         .Stmts
+       )
+       .Stmts
+
+  syntax Stmts ::= "digitSumBody" [macro]
+  rule digitSumBody
+    => Assign(Name("result"), Int(0))
+       For(Name("char"), Name("s"), digitSumLoopBody)
+       Return(Name("result"))
+       .Stmts
+
+  syntax Int ::= digitSumSpec(IntSeq) [function, total]
+  rule digitSumSpec(.IntSeq) => 0
+  rule digitSumSpec(iCons(C:Int, REST:IntSeq))
+    => (#if C >=Int 65 andBool C <=Int 90
+        #then C
+        #else 0
+        #fi) +Int digitSumSpec(REST)
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module DIGIT-SUM-SPEC --claims DIGIT-SUM-SPEC.loop-invariant --output pretty' in /work
