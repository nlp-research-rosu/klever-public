+          root
+        )
+      ( 1 |->
+        scope(
+          "s" |-> INPUT:Val
+          "result" |-> A
+          "char" |-> OLDCHAR:Val
+          "code" |-> OLDCODE:Val,
+          parent(0)
+        )
+      )
+      =>
+      0 |-> scope(.Map, parent(-1))
+      -1 |->
+        scope(
+          ("ord" |-> builtinV("ord")) BUILTINS,
+          root
+        )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
