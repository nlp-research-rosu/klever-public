+      #loop(str(S:IntSeq), Name("char"), digitSumLoopBody)
+      ~> Return(Name("result"))
+      ~> #endcall
+      => A:Int +Int digitSumSpec(S)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> digitSumBuiltins
+      ( 1 |->
+        scope(
+          "s" |-> INPUT:Val
+          "result" |-> A
+          "char" |-> OLDCHAR:Val
+          "code" |-> OLDCODE:Val,
+          parent(0)
+        )
+      )
+      =>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> digitSumBuiltins
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule

