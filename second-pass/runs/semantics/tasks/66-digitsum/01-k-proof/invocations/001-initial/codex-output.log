+         "set" |-> builtinV("set")
+         "sum" |-> builtinV("sum")
+         "abs" |-> builtinV("abs")
+         "min" |-> builtinV("min")
+         "max" |-> builtinV("max")
+         "ord" |-> builtinV("ord")
