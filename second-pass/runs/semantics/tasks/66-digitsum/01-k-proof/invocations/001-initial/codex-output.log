diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..761ad1ecfdb29c7c9e5b83f7588d566fb7ded103
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,108 @@
+requires "verification.k"
+
+module DIGIT-SUM-LOOP-SPEC
+  imports DIGIT-SUM-VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #loop(str(S:IntSeq), Name("char"), digitSumLoopBody)
+      ~> (Return(Name("result")) .Stmts)
+      ~> #endcall
+      => A:Int +Int digitSumSpec(S)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> digitSumBuiltins
+      ( 1 |->
+        scope(
+          "s" |-> INPUT:Val
+          "result" |-> A
+          "char" |-> OLDCHAR:Val
+          "code" |-> OLDCODE:Val,
+          parent(0)
+        )
+      )
+      =>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> digitSumBuiltins
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+endmodule
+
+module DIGIT-SUM-INITIALIZATION-SPEC
+  imports DIGIT-SUM-VERIFICATION
+
+  claim [initialization]:
+    <k>
+      Call(
+        closureVal(("s", .ParamNames), digitSumBody, 0),
+        (str(S:IntSeq), .Exprs)
+      )
+      =>
+      #loop(str(S), Name("char"), digitSumLoopBody)
+      ~> (Return(Name("result")) .Stmts)
+      ~> #endcall
+    </k>
+    <env> 0 => 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> digitSumBuiltins
+      =>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> digitSumBuiltins
+      1 |->
+        scope(
+          "s" |-> str(S)
+          "result" |-> 0
+          "char" |-> str(.IntSeq)
+          "code" |-> 0,
+          parent(0)
+        )
+    </scopes>
+    <scopeLoc> 1 => 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      .List
+      => ListItem(frame(.K, 0, 1))
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module DIGIT-SUM-ENTRY-SPEC
+  imports DIGIT-SUM-VERIFICATION-WITH-LOOP-LEMMA
+
+  claim [entry-point]:
+    <k>
+      Call(
+        closureVal(("s", .ParamNames), digitSumBody, 0),
+        (str(S:IntSeq), .Exprs)
+      )
+      => digitSumSpec(S)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b9f0e79a26d82e35900b18b648aa603d99ae6038
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,147 @@
+requires "reference-semantics/semantics.k"
+
+module DIGIT-SUM-VERIFICATION
+  imports MPY
+
+  syntax Scope ::= "digitSumBuiltins" [macro]
+  rule digitSumBuiltins
+    => scope(
+         "len" |-> builtinV("len")
+         "set" |-> builtinV("set")
+         "sum" |-> builtinV("sum")
+         "abs" |-> builtinV("abs")
+         "min" |-> builtinV("min")
+         "max" |-> builtinV("max")
+         "ord" |-> builtinV("ord")
+         "chr" |-> builtinV("chr")
+         "range" |-> builtinV("range")
+         "all" |-> builtinV("all")
+         "any" |-> builtinV("any")
+         "zip" |-> builtinV("zip")
+         "isinstance" |-> builtinV("isinstance")
+         "sorted" |-> builtinV("sorted")
+         "list" |-> builtinV("list")
+         "round" |-> builtinV("round")
+         "bin" |-> builtinV("bin")
+         "enumerate" |-> builtinV("enumerate")
+         "map" |-> builtinV("map")
+         "eval" |-> builtinV("eval")
+         "int" |-> typeV("int")
+         "str" |-> typeV("str")
+         "float" |-> typeV("float"),
+         root
+       )
+
+  syntax Stmts ::= "digitSumLoopBody" [macro]
+  rule digitSumLoopBody
+    => Assign(Name("code"), Call(Name("ord"), (Name("char"), .Exprs)))
+       If(
+         BoolOp(
+           "and",
+           ( Compare(Name("code"), CmpOp(">=", Int(65)))
+           , Compare(Name("code"), CmpOp("<=", Int(90)))
+           , .Exprs
+           )
+         ),
+         AugAssign(Name("result"), "+", Name("code")) .Stmts,
+         .Stmts
+       )
+       .Stmts
+
+  syntax Stmts ::= "digitSumBody" [macro]
+  rule digitSumBody
+    => Assign(Name("result"), Int(0))
+       Assign(Name("char"), Str(""))
+       Assign(Name("code"), Int(0))
+       For(Name("char"), Name("s"), digitSumLoopBody)
+       Return(Name("result"))
+       .Stmts
+
+  syntax Int ::= digitSumSpec(IntSeq) [function, total]
+  rule digitSumSpec(.IntSeq) => 0
+  rule digitSumSpec(iCons(C:Int, REST:IntSeq))
+    => (#if C >=Int 65 andBool C <=Int 90
+        #then C
+        #else 0
+        #fi) +Int digitSumSpec(REST)
+endmodule
+
+// This module packages the loop theorem as a reusable rewrite.  prove.sh first
+// proves the identical reachability claim against DIGIT-SUM-VERIFICATION, then
+// compiles this extension solely to prove the public entry-point claim.
+module DIGIT-SUM-VERIFICATION-WITH-LOOP-LEMMA
+  imports DIGIT-SUM-VERIFICATION
+
+  rule [digit-sum-initialization-lemma]:
+    <k>
+      Call(
+        closureVal(("s", .ParamNames), digitSumBody, 0),
+        (str(S:IntSeq), .Exprs)
+      )
+      =>
+      #loop(str(S), Name("char"), digitSumLoopBody)
+      ~> (Return(Name("result")) .Stmts)
+      ~> #endcall
+    </k>
+    <env> 0 => 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> digitSumBuiltins
+      =>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> digitSumBuiltins
+      1 |->
+        scope(
+          "s" |-> str(S)
+          "result" |-> 0
+          "char" |-> str(.IntSeq)
+          "code" |-> 0,
+          parent(0)
+        )
+    </scopes>
+    <scopeLoc> 1 => 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      .List
+      => ListItem(frame(.K, 0, 1))
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  rule [digit-sum-loop-lemma]:
+    <k>
+      #loop(str(S:IntSeq), Name("char"), digitSumLoopBody)
+      ~> (Return(Name("result")) .Stmts)
+      ~> #endcall
+      => A:Int +Int digitSumSpec(S)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> digitSumBuiltins
+      ( 1 |->
+        scope(
+          "s" |-> INPUT:Val
+          "result" |-> A
+          "char" |-> OLDCHAR:Val
+          "code" |-> OLDCODE:Val,
+          parent(0)
+        )
+      )
+      =>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> digitSumBuiltins
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-with-lemma-kompiled --spec-module DIGIT-SUM-ENTRY-SPEC --output pretty' in /work
