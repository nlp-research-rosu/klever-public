Module(
  FuncDef("digitSum", Params("s"),
    Assign(Name("result"), Int(0))
    Assign(Name("char"), Str(""))
    Assign(Name("code"), Int(0))
    For(Name("char"), Name("s"),
      Assign(Name("code"), Call(Name("ord"), Name("char")))
      If(BoolOp(
        "and",
        Compare(Name("code"), CmpOp(">=", Int(65))),
        Compare(Name("code"), CmpOp("<=", Int(90)))),
        AugAssign(Name("result"), "+", Name("code")),
        ))
    Return(Name("result")))
  Assert(Compare(Call(Name("digitSum"), Str("")), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("digitSum"), Str("abAB")), CmpOp("==", Int(131))))
  Assert(
    Compare(Call(Name("digitSum"), Str("abcCd")), CmpOp("==", Int(67))))
  Assert(
    Compare(Call(Name("digitSum"), Str("helloE")), CmpOp("==", Int(69))))
  Assert(
    Compare(
      Call(Name("digitSum"), Str("woArBld")),
      CmpOp("==", Int(131))))
  Assert(
    Compare(
      Call(Name("digitSum"), Str("aAaaaXa")),
      CmpOp("==", Int(153))))
  Assert(
    Compare(
      Call(Name("digitSum"), Str("ABCDEFGHIJKLMNOPQRSTUVWXYZ")),
      CmpOp("==", Int(2015))))
  Assert(
    Compare(
      Call(Name("digitSum"), Str("0123!@#$abcdefghijklmnopqrstuvwxyz")),
      CmpOp("==", Int(0)))))
