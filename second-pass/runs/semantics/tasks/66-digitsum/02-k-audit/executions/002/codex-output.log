index 0000000000000000000000000000000000000000..7887168dea70b3ef7a1de3e14b3e693da2ad1514
--- /dev/null
+++ b/evidence/ground-spec.k
@@ -0,0 +1,54 @@
+requires "verification.k"
+
+module DIGIT-SUM-GROUND-SPEC
+  imports DIGIT-SUM-VERIFICATION
+
+  claim [ground-empty]:
+    <k> digitSumSpec(.IntSeq) => 0 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> digitSumBuiltins
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [ground-abAB]:
+    <k>
+      digitSumSpec(
+        iCons(97, iCons(98, iCons(65, iCons(66, .IntSeq))))
+      ) => 131
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> digitSumBuiltins
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [ground-non-ascii-uppercase]:
+    <k> digitSumSpec(iCons(201, .IntSeq)) => 0 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> digitSumBuiltins
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
