index 0000000000000000000000000000000000000000..5768796834911cab67a76b936274eb1fdcae931c
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+: > "$audit_log"
+{
+  printf 'WORKDIR: %q\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} | tee -a "$audit_log"
+
+"$@" 2>&1 | tee -a "$audit_log"
+audit_status=${PIPESTATUS[0]}
+printf 'EXIT_STATUS=%s\n' "$audit_status" | tee -a "$audit_log"
+exit "$audit_status"

exec
