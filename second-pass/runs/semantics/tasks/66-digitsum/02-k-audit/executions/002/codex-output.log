+        "input": value,
+        "codepoints": [ord(char) for char in value],
+        "formal_digitSumSpec": formal,
+        "candidate_python": candidate(value),
+        "trusted_canonical_python": canonical(value),
+    }, ensure_ascii=True))
+print("EXIT_STATUS=0")
