new file mode 100644
index 0000000000000000000000000000000000000000..8a3879bab675a8db4d55f21516256de2a8eac4ea
--- /dev/null
+++ b/evidence/k_runtime_ascii_probe.py
@@ -0,0 +1,16 @@
+def digitSum(s):
+    result = 0
+    char = ""
+    code = 0
+    for char in s:
+        code = ord(char)
+        if code >= 65 and code <= 90:
+            result += code
+    return result
+
+
+assert digitSum("") == 0
+assert digitSum("abAB") == 131
+assert digitSum("@A[Z") == 155
+assert digitSum("abcdefghijklmnopqrstuvwxyz") == 0
+assert digitSum("ABCDEFGHIJKLMNOPQRSTUVWXYZ") == 2015
