===== /candidate/solution.py
     1	def digitSum(s):
     2	    result = 0
     3	    char = ""
     4	    code = 0
     5	    for char in s:
     6	        code = ord(char)
     7	        if code >= 65 and code <= 90:
     8	            result += code
     9	    return result
