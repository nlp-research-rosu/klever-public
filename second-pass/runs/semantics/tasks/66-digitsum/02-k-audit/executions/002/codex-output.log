+      Call(
+        closureVal(("s", .ParamNames), digitSumBody, 0),
+        (str(S:IntSeq), .Exprs)
+      )
+      => digitSumSpec(S) +Int 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> digitSumBuiltins
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
