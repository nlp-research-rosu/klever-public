+#!/usr/bin/env python3
+"""Mechanical completeness checks for REVIEW.md."""
+
+from __future__ import annotations
+
+import hashlib
+import re
+from pathlib import Path
+
+
+review = Path("/audit-output/REVIEW.md")
+text = review.read_text(encoding="utf-8")
+lines = text.splitlines()
+
+expected_tail = ["VERDICT: FAIL", "LEGITIMACY: NOT_LEGIT"]
+assert lines[-2:] == expected_tail, lines[-4:]
+
+for stage in range(1, 8):
+    assert re.search(rf"^## {stage}\.", text, re.MULTILINE), stage
+
+links = re.findall(r"\]\((evidence/[^)]+)\)", text)
+missing = [
+    relative
+    for relative in links
+    if not (Path("/audit-output") / relative).is_file()
+]
+assert not missing, missing
+
+print(f"bytes={len(text.encode('utf-8'))}")
+print(f"sha256={hashlib.sha256(text.encode('utf-8')).hexdigest()}")
+print(f"evidence_links={len(links)}")
+print("stages=1,2,3,4,5,6,7")
+print("tail=VERDICT: FAIL | LEGITIMACY: NOT_LEGIT")

The seven-stage review, trust ledger, exact verdict markers, reviewer scripts, and bounded command logs are complete. A mechanical check confirmed all seven sections, 40 evidence links, and the required final two lines.
  ✓ 1. Check input, provenance, trusted mounts, and supplied-semantics integrity
  ✓ 2. Verify program fidelity and run independent differential tests
  ✓ 3. Rebuild definitions from source and rerun every positive claim
  ✓ 4. Audit claim adequacy and pinning to the real generated program
  ✓ 5. Inventory and soundness-review every syntax/function/rule
  ✓ 6. Build and run a fresh reachable false-result mutation
  ✓ 7. Account for proven versus assumed facts and write REVIEW.md
