     6	def digitSum(s):
     7	    """Task
     8	    Write a function that takes a string as input and returns the sum of the upper characters only'
     9	    ASCII codes.
    10	
    11	    Examples:
    12	        digitSum("") => 0
    13	        digitSum("abAB") => 131
    14	        digitSum("abcCd") => 67
    15	        digitSum("helloE") => 69
    16	        digitSum("woArBld") => 131
    17	        digitSum("aAaaaXa") => 153
    18	    """
    19	    if s == "": return 0
    20	    return sum(ord(char) if char.isupper() else 0 for char in s)

===== /candidate/solution.py =====
     1	def digitSum(s):
     2	    result = 0
     3	    char = ""
     4	    code = 0
     5	    for char in s:
     6	        code = ord(char)
     7	        if code >= 65 and code <= 90:
     8	            result += code
     9	    return result

