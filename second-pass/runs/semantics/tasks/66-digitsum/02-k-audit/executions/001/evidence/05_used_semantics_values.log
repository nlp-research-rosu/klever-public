COMMAND: bash -lc for\ f\ in\ reference-semantics/semantics/builtins.k\ reference-semantics/semantics/operators.k\ reference-semantics/semantics/int.k\ reference-semantics/semantics/bool.k\;\ do\ printf\ \'\\n=====\ %s\ =====\\n\'\ \"\$f\"\;\ nl\ -ba\ \"\$f\"\;\ done

