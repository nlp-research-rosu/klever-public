ID=938 verification.k:76 priority-rule attrs=priority
  rule [digit-sum-initialization-lemma]:
    <k>
      Call(
        closureVal(("s", .ParamNames), digitSumBody, 0),
        (str(S:IntSeq), .Exprs)
      )
      =>
      #loop(str(S), Name("char"), digitSumLoopBody)
      ~> (Return(Name("result")) .Stmts)
      ~> #endcall
    </k>
    <env> 0 => 1 </env>
    <scopes>
      0 |-> scope(.Map, parent(-1))
      -1 |-> digitSumBuiltins
      =>
      0 |-> scope(.Map, parent(-1))
      -1 |-> digitSumBuiltins
      1 |->
        scope(
          "s" |-> str(S)
          "result" |-> 0
          "char" |-> str(.IntSeq)
          "code" |-> 0,
          parent(0)
        )
    </scopes>
    <scopeLoc> 1 => 2 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack>
      .List
      => ListItem(frame(.K, 0, 1))
    </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    [priority(20)]
