ID=931 verification.k:35 macro-syntax-declaration attrs=macro
  syntax Stmts ::= "digitSumLoopBody" [macro]
---
ID=932 verification.k:36 ordinary-rule attrs=
  rule digitSumLoopBody
    => Assign(Name("code"), Call(Name("ord"), (Name("char"), .Exprs)))
       If(
         BoolOp(
           "and",
           ( Compare(Name("code"), CmpOp(">=", Int(65)))
           , Compare(Name("code"), CmpOp("<=", Int(90)))
           , .Exprs
           )
         ),
         AugAssign(Name("result"), "+", Name("code")) .Stmts,
         .Stmts
       )
       .Stmts
---
ID=933 verification.k:51 macro-syntax-declaration attrs=macro
  syntax Stmts ::= "digitSumBody" [macro]
---
ID=934 verification.k:52 ordinary-rule attrs=
  rule digitSumBody
    => Assign(Name("result"), Int(0))
       Assign(Name("char"), Str(""))
       Assign(Name("code"), Int(0))
       For(Name("char"), Name("s"), digitSumLoopBody)
       Return(Name("result"))
       .Stmts
