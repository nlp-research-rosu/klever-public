      ( 1 |->
        scope(
          "s" |-> INPUT:Val
          "result" |-> A
          "char" |-> OLDCHAR:Val
          "code" |-> OLDCODE:Val,
          parent(0)
        )
      )
      =>
      0 |-> scope(.Map, parent(-1))
      -1 |-> digitSumBuiltins
    </scopes>
    <scopeLoc> 2 => 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack>
      ListItem(frame(.K, 0, 1))
      => .List
