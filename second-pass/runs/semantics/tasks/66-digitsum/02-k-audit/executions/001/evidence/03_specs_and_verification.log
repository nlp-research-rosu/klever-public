     3	module DIGIT-SUM-VERIFICATION
     4	  imports MPY
     5	
     6	  syntax Scope ::= "digitSumBuiltins" [macro]
     7	  rule digitSumBuiltins
     8	    => scope(
     9	         "len" |-> builtinV("len")
    10	         "set" |-> builtinV("set")
    11	         "sum" |-> builtinV("sum")
    12	         "abs" |-> builtinV("abs")
    13	         "min" |-> builtinV("min")
    14	         "max" |-> builtinV("max")
    15	         "ord" |-> builtinV("ord")
    16	         "chr" |-> builtinV("chr")
    17	         "range" |-> builtinV("range")
    18	         "all" |-> builtinV("all")
    19	         "any" |-> builtinV("any")
    20	         "zip" |-> builtinV("zip")
    21	         "isinstance" |-> builtinV("isinstance")
    22	         "sorted" |-> builtinV("sorted")
    23	         "list" |-> builtinV("list")
    24	         "round" |-> builtinV("round")
    25	         "bin" |-> builtinV("bin")
    26	         "enumerate" |-> builtinV("enumerate")
    27	         "map" |-> builtinV("map")
    28	         "eval" |-> builtinV("eval")
    29	         "int" |-> typeV("int")
    30	         "str" |-> typeV("str")
    31	         "float" |-> typeV("float"),
    32	         root
    33	       )
    34	
    35	  syntax Stmts ::= "digitSumLoopBody" [macro]
    36	  rule digitSumLoopBody
    37	    => Assign(Name("code"), Call(Name("ord"), (Name("char"), .Exprs)))
    38	       If(
    39	         BoolOp(
    40	           "and",
    41	           ( Compare(Name("code"), CmpOp(">=", Int(65)))
    42	           , Compare(Name("code"), CmpOp("<=", Int(90)))
    43	           , .Exprs
    44	           )
    45	         ),
    46	         AugAssign(Name("result"), "+", Name("code")) .Stmts,
    47	         .Stmts
    48	       )
    49	       .Stmts
    50	
    51	  syntax Stmts ::= "digitSumBody" [macro]
    52	  rule digitSumBody
    53	    => Assign(Name("result"), Int(0))
    54	       Assign(Name("char"), Str(""))
    55	       Assign(Name("code"), Int(0))
    56	       For(Name("char"), Name("s"), digitSumLoopBody)
    57	       Return(Name("result"))
    58	       .Stmts
    59	
    60	  syntax Int ::= digitSumSpec(IntSeq) [function, total]
    61	  rule digitSumSpec(.IntSeq) => 0
    62	  rule digitSumSpec(iCons(C:Int, REST:IntSeq))
    63	    => (#if C >=Int 65 andBool C <=Int 90
    64	        #then C
    65	        #else 0
    66	        #fi) +Int digitSumSpec(REST)
    67	endmodule
