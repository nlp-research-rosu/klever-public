requires "reference-semantics/semantics.k"

module X-OR-Y-VERIFICATION
  imports MPY

  // The translated body of solution.py, named here so the claims remain
  // readable.  These are syntax macros, not additional execution semantics.
  syntax Stmts ::= "xOrYLoopBody" [macro]
  rule xOrYLoopBody
    => If(
         Compare(BinOp("%", Name("n"), Name("divisor")),
                 CmpOp("==", Int(0))),
         Return(Name("y")),
         .Stmts)

  syntax Stmts ::= "xOrYBody" [macro]
  rule xOrYBody
    => If(Compare(Name("n"), CmpOp("<", Int(2))),
          Return(Name("y")),
          .Stmts)
       For(Name("divisor"), Call(Name("range"), (Int(2), Name("n"))),
           xOrYLoopBody)
       Return(Name("x"))

  // A call of the actual translated function body in a clean module frame.
  syntax KItem ::= "#xOrY" "(" Int "," Val "," Val ")" [macro]
  rule #xOrY(N:Int, X:Val, Y:Val)
    => Call(closureVal(("n", "x", "y"), xOrYBody, 0), (N, X, Y))

  // Mathematical trial-division specification.  primeSelect(N,D,X,Y) is X
  // exactly when N >= 2 and none of D,D+1,...,N-1 divides N; otherwise it is Y.
  // In particular primeSelect(N,2,X,Y) is the contract of x_or_y.
  syntax Val ::= primeSelect(Int, Int, Val, Val) [function]

  rule primeSelect(N:Int, D:Int, X:Val, Y:Val) => Y
    requires D >=Int 2 andBool N <Int 2

  rule primeSelect(N:Int, D:Int, X:Val, Y:Val) => X
    requires D >=Int 2 andBool N >=Int 2 andBool D >=Int N

  rule primeSelect(N:Int, D:Int, X:Val, Y:Val) => Y
    requires D >=Int 2 andBool N >=Int 2 andBool D <Int N
      andBool pyMod(N, D) ==Int 0

  rule primeSelect(N:Int, D:Int, X:Val, Y:Val)
    => primeSelect(N, D +Int 1, X, Y)
    requires D >=Int 2 andBool N >=Int 2 andBool D <Int N
      andBool pyMod(N, D) =/=Int 0

  // The corresponding final value of the Python local `divisor`.  Tracking
  // this small piece of mutable frame state makes the loop invariant exact.
  syntax Int ::= scanLast(Int, Int, Int) [function]

  rule scanLast(N:Int, D:Int, OLD:Int) => OLD
    requires N >=Int 2 andBool D >=Int 2 andBool D >=Int N

  rule scanLast(N:Int, D:Int, OLD:Int) => D
    requires N >=Int 2 andBool D >=Int 2 andBool D <Int N
      andBool pyMod(N, D) ==Int 0

  rule scanLast(N:Int, D:Int, OLD:Int)
    => scanLast(N, D +Int 1, D)
    requires N >=Int 2 andBool D >=Int 2 andBool D <Int N
      andBool pyMod(N, D) =/=Int 0
endmodule

// Modular proof layer.  The rule below is byte-for-byte the reachability
// summary proved as loop_correct in X-OR-Y-LOOP-SPEC.  It is kept out of the
// base module used for that proof, then imported only for the top-level proof.
module X-OR-Y-SUMMARY
  imports X-OR-Y-VERIFICATION

  rule
    <k>
      #loop(rangeObj(D:Int, N:Int, 1), Name("divisor"), xOrYLoopBody)
      ~> (Return(Name("x")) .Stmts)
      ~> #endcall
      => #pop
    </k>
    <env> 1 </env>
    <scopes>
      -1 |-> BS:Scope
      0 |-> scope(.Map, parent(-1))
      1 |-> scope(
        "divisor" |-> (OLD:Int => scanLast(N, D, OLD))
        "n" |-> N:Int
        "x" |-> X:Val
        "y" |-> Y:Val,
        parent(0))
    </scopes>
    <scopeLoc> 2 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> ListItem(frame(.K, 0, 1)) </stack>
    <ret> noRet => retV(primeSelect(N, D, X:Val, Y:Val)) </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N >=Int 2
      andBool D >=Int 2
    [priority(40)]
endmodule
requires "verification.k"

module X-OR-Y-LOOP-SPEC
  imports X-OR-Y-VERIFICATION

  // Inductive loop invariant.  The recursive non-divisor case advances both
  // the Python range iterator and primeSelect, allowing this claim to close
  // by circularity.
  claim
    <k>
      #loop(rangeObj(D:Int, N:Int, 1), Name("divisor"), xOrYLoopBody)
      ~> (Return(Name("x")) .Stmts)
      ~> #endcall
      => #pop
    </k>
    <env> 1 </env>
    <scopes>
      -1 |-> BS:Scope
      0 |-> scope(.Map, parent(-1))
      1 |-> scope(
        "divisor" |-> (OLD:Int => scanLast(N, D, OLD))
        "n" |-> N:Int
        "x" |-> X:Val
        "y" |-> Y:Val,
        parent(0))
    </scopes>
    <scopeLoc> 2 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> ListItem(frame(.K, 0, 1)) </stack>
    <ret> noRet => retV(primeSelect(N, D, X:Val, Y:Val)) </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N >=Int 2
      andBool D >=Int 2
    [label(loop_correct)]
endmodule

module X-OR-Y-MAIN-SPEC
  imports X-OR-Y-SUMMARY

  // Universal functional correctness for every integer n and arbitrary
  // Python values x and y, from the reference semantics' initial state.
  claim
    <k> #xOrY(N:Int, X:Val, Y:Val) => primeSelect(N, 2, X, Y) </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    [label(main_correct)]
endmodule
#!/usr/bin/env bash
set -euo pipefail

# Translate the submitted implementation, and ensure the concrete smoke
# program embeds that implementation verbatim.
python3 py2mpy.py solution.py > solution.mpy
head -n 7 concrete_tests.py | cmp - solution.py
python3 py2mpy.py concrete_tests.py > concrete_tests.mpy

# Concrete execution under the required LLVM definition.  A failed assertion
# sets the MPY exit code and makes krun exit nonzero.
kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled
krun concrete_tests.mpy --definition runtime-kompiled

# Prove the inductive loop summary using only the supplied MPY semantics.
kompile verification.k \
  --backend haskell \
  --main-module X-OR-Y-VERIFICATION \
  --syntax-module X-OR-Y-VERIFICATION \
  --output-definition verification-kompiled
kprove spec.k \
  --definition verification-kompiled \
  --spec-module X-OR-Y-LOOP-SPEC \
  --claims loop_correct

# Import the now-proved summary as a modular proof rule, then prove the
# universal function contract.
kompile verification.k \
  --backend haskell \
  --main-module X-OR-Y-SUMMARY \
  --syntax-module X-OR-Y-SUMMARY \
  --output-definition summary-kompiled
kprove spec.k \
  --definition summary-kompiled \
  --spec-module X-OR-Y-MAIN-SPEC \
  --claims main_correct

