     1	requires "reference-semantics/semantics.k"
     2	
     3	module X-OR-Y-VERIFICATION
     4	  imports MPY
     5	
     6	  // The translated body of solution.py, named here so the claims remain
     7	  // readable.  These are syntax macros, not additional execution semantics.
     8	  syntax Stmts ::= "xOrYLoopBody" [macro]
     9	  rule xOrYLoopBody
    10	    => If(
    11	         Compare(BinOp("%", Name("n"), Name("divisor")),
    12	                 CmpOp("==", Int(0))),
    13	         Return(Name("y")),
    14	         .Stmts)
    15	
    16	  syntax Stmts ::= "xOrYBody" [macro]
    17	  rule xOrYBody
    18	    => If(Compare(Name("n"), CmpOp("<", Int(2))),
    19	          Return(Name("y")),
    20	          .Stmts)
    21	       For(Name("divisor"), Call(Name("range"), (Int(2), Name("n"))),
    22	           xOrYLoopBody)
    23	       Return(Name("x"))
    24	
    25	  // A call of the actual translated function body in a clean module frame.
    26	  syntax KItem ::= "#xOrY" "(" Int "," Val "," Val ")" [macro]
    27	  rule #xOrY(N:Int, X:Val, Y:Val)
    28	    => Call(closureVal(("n", "x", "y"), xOrYBody, 0), (N, X, Y))
    29	
    30	  // Mathematical trial-division specification.  primeSelect(N,D,X,Y) is X
    31	  // exactly when N >= 2 and none of D,D+1,...,N-1 divides N; otherwise it is Y.
    32	  // In particular primeSelect(N,2,X,Y) is the contract of x_or_y.
    33	  syntax Val ::= primeSelect(Int, Int, Val, Val) [function]
    34	
    35	  rule primeSelect(N:Int, D:Int, X:Val, Y:Val) => Y
    36	    requires D >=Int 2 andBool N <Int 2
    37	
    38	  rule primeSelect(N:Int, D:Int, X:Val, Y:Val) => X
    39	    requires D >=Int 2 andBool N >=Int 2 andBool D >=Int N
    40	
    41	  rule primeSelect(N:Int, D:Int, X:Val, Y:Val) => Y
    42	    requires D >=Int 2 andBool N >=Int 2 andBool D <Int N
    43	      andBool pyMod(N, D) ==Int 0
    44	
    45	  rule primeSelect(N:Int, D:Int, X:Val, Y:Val)
    46	    => primeSelect(N, D +Int 1, X, Y)
    47	    requires D >=Int 2 andBool N >=Int 2 andBool D <Int N
    48	      andBool pyMod(N, D) =/=Int 0
    49	
    50	  // The corresponding final value of the Python local `divisor`.  Tracking
    51	  // this small piece of mutable frame state makes the loop invariant exact.
    52	  syntax Int ::= scanLast(Int, Int, Int) [function]
    53	
    54	  rule scanLast(N:Int, D:Int, OLD:Int) => OLD
    55	    requires N >=Int 2 andBool D >=Int 2 andBool D >=Int N
    56	
    57	  rule scanLast(N:Int, D:Int, OLD:Int) => D
    58	    requires N >=Int 2 andBool D >=Int 2 andBool D <Int N
    59	      andBool pyMod(N, D) ==Int 0
    60	
    61	  rule scanLast(N:Int, D:Int, OLD:Int)
    62	    => scanLast(N, D +Int 1, D)
    63	    requires N >=Int 2 andBool D >=Int 2 andBool D <Int N
    64	      andBool pyMod(N, D) =/=Int 0
    65	endmodule
