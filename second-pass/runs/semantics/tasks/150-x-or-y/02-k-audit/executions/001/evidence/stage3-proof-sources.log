===== concrete_tests.py =====
     1	def x_or_y(n, x, y):
     2	    if n < 2:
     3	        return y
     4	    for divisor in range(2, n):
     5	        if n % divisor == 0:
     6	            return y
     7	    return x
     8	
     9	
    10	assert x_or_y(7, 34, 12) == 34
    11	assert x_or_y(15, 8, 5) == 5
    12	assert x_or_y(1, 7, 9) == 9
    13	assert x_or_y(2, 11, 13) == 11
    14	assert x_or_y(0, 4, 6) == 6
    15	assert x_or_y(97, -2, 10) == -2
    16	assert x_or_y(49, 3, 4) == 4
