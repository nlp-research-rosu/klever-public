@@ -0,0 +1,88 @@
+requires "verification.k"
+
+module GROUND-MAIN-WITNESSES
+  imports X-OR-Y-SUMMARY
+
+  claim
+    <k> #xOrY(1, 7, 9) => 9 </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1)) -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(main_n1)]
+
