+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> (
+        scope(.Map, parent(-1))
+        =>
+        scope(
+          "x_or_y" |-> closureVal(
+            ("n", "x", "y"),
+            If(Compare(Name("n"), CmpOp("<", Int(2))),
+              Return(Name("y")),
+              .Stmts)
+            For(Name("divisor"), Call(Name("range"), (Int(2), Name("n"))),
