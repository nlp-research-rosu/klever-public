+assert x_or_y(2, 11, 22) == 11
+assert x_or_y(3, 11, 22) == 11
+assert x_or_y(4, 11, 22) == 22
+assert x_or_y(9, 11, 22) == 22
+assert x_or_y(49, 11, 22) == 22
