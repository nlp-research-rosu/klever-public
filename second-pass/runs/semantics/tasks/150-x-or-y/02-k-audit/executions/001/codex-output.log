+                BinOp("%", Name("n"), Name("divisor")),
+                CmpOp("==", Int(0))),
+                Return(Name("y")),
+                .Stmts))
+            Return(Name("x")),
+            0),
+          parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
