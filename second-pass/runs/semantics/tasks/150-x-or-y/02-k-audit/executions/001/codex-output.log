+      ~> Call(Name("x_or_y"), N:Int, X:Val, Y:Val)
+      => primeSelect(N, 2, X, Y)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> (
+        scope(.Map, parent(-1))
+        =>
+        scope(
+          "x_or_y" |-> closureVal(
+            ("n", "x", "y"),
+            If(Compare(Name("n"), CmpOp("<", Int(2))),
+              Return(Name("y")),
+              .Stmts)
+            For(Name("divisor"), Call(Name("range"), (Int(2), Name("n"))),
+              If(Compare(
+                BinOp("%", Name("n"), Name("divisor")),
+                CmpOp("==", Int(0))),
+                Return(Name("y")),
+                .Stmts))
+            Return(Name("x")),
+            0),
+          parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
