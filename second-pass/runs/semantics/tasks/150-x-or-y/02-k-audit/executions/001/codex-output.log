+      0 |-> scope(.Map, parent(-1))
+      1 |-> scope(
+        "divisor" |-> (99 => 3)
+        "n" |-> 9
+        "x" |-> 91
+        "y" |-> 92,
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
