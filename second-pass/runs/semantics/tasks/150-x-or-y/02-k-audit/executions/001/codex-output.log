+              .Stmts)
+            For(Name("divisor"), Call(Name("range"), (Int(2), Name("n"))),
+              If(Compare(
+                BinOp("%", Name("n"), Name("divisor")),
+                CmpOp("==", Int(0))),
+                Return(Name("y")),
+                .Stmts))
+            Return(Name("x")),
+            0),
+          parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
