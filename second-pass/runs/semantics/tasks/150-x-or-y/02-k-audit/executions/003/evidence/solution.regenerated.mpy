Module(
  FuncDef("x_or_y", Params("n", "x", "y"),
    If(Compare(Name("n"), CmpOp("<", Int(2))),
      Return(Name("y")),
      )
    For(Name("divisor"), Call(Name("range"), Int(2), Name("n")),
      If(Compare(
        BinOp("%", Name("n"), Name("divisor")),
        CmpOp("==", Int(0))),
        Return(Name("y")),
        ))
    Return(Name("x"))))
