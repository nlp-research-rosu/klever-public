    49	      -1 |-> builtinsScope
    50	    </scopes>
    51	    <scopeLoc> 1 </scopeLoc>
    52	    <heap> .Map </heap>
    53	    <heapLoc> 0 </heapLoc>
    54	    <stack> .List </stack>
    55	    <ret> noRet </ret>
    56	    <exc> NoExc </exc>
    57	    <exit-code> 0 </exit-code>
    58	    [label(main_correct)]
    59	endmodule
     1	
     2	def x_or_y(n, x, y):
     3	    """A simple program which should return the value of x if n is 
     4	    a prime number and should return the value of y otherwise.
     5	
     6	    Examples:
     7	    for x_or_y(7, 34, 12) == 34
     8	    for x_or_y(15, 8, 5) == 5
     9	    
    10	    """
     1	# canonical.py — the UNMODIFIED HumanEval/150 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: x_or_y
     4	
     5	
     6	def x_or_y(n, x, y):
     7	    """A simple program which should return the value of x if n is 
     8	    a prime number and should return the value of y otherwise.
     9	
    10	    Examples:
    11	    for x_or_y(7, 34, 12) == 34
    12	    for x_or_y(15, 8, 5) == 5
    13	    
    14	    """
    15	    if n == 1:
    16	        return y
    17	    for i in range(2, n):
    18	        if n % i == 0:
