    69	// base module used for that proof, then imported only for the top-level proof.
    70	module X-OR-Y-SUMMARY
    71	  imports X-OR-Y-VERIFICATION
    72	
    73	  rule
    74	    <k>
    75	      #loop(rangeObj(D:Int, N:Int, 1), Name("divisor"), xOrYLoopBody)
    76	      ~> (Return(Name("x")) .Stmts)
    77	      ~> #endcall
    78	      => #pop
    79	    </k>
    80	    <env> 1 </env>
    81	    <scopes>
    82	      -1 |-> BS:Scope
    83	      0 |-> scope(.Map, parent(-1))
    84	      1 |-> scope(
    85	        "divisor" |-> (OLD:Int => scanLast(N, D, OLD))
    86	        "n" |-> N:Int
    87	        "x" |-> X:Val
    88	        "y" |-> Y:Val,
    89	        parent(0))
    90	    </scopes>
    91	    <scopeLoc> 2 </scopeLoc>
    92	    <heap> .Map </heap>
    93	    <heapLoc> 0 </heapLoc>
    94	    <stack> ListItem(frame(.K, 0, 1)) </stack>
    95	    <ret> noRet => retV(primeSelect(N, D, X:Val, Y:Val)) </ret>
    96	    <exc> NoExc </exc>
    97	    <exit-code> 0 </exit-code>
    98	    requires N >=Int 2
    99	      andBool D >=Int 2
   100	    [priority(40)]
   101	endmodule
     1	requires "verification.k"
     2	
     3	module X-OR-Y-LOOP-SPEC
     4	  imports X-OR-Y-VERIFICATION
     5	
     6	  // Inductive loop invariant.  The recursive non-divisor case advances both
     7	  // the Python range iterator and primeSelect, allowing this claim to close
     8	  // by circularity.
     9	  claim
    10	    <k>
    11	      #loop(rangeObj(D:Int, N:Int, 1), Name("divisor"), xOrYLoopBody)
    12	      ~> (Return(Name("x")) .Stmts)
    13	      ~> #endcall
    14	      => #pop
    15	    </k>
    16	    <env> 1 </env>
    17	    <scopes>
    18	      -1 |-> BS:Scope
    19	      0 |-> scope(.Map, parent(-1))
    20	      1 |-> scope(
    21	        "divisor" |-> (OLD:Int => scanLast(N, D, OLD))
    22	        "n" |-> N:Int
    23	        "x" |-> X:Val
    24	        "y" |-> Y:Val,
    25	        parent(0))
    26	    </scopes>
    27	    <scopeLoc> 2 </scopeLoc>
