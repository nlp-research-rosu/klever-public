    30	    <stack> ListItem(frame(.K, 0, 1)) </stack>
    31	    <ret> noRet => retV(primeSelect(N, D, X:Val, Y:Val)) </ret>
    32	    <exc> NoExc </exc>
    33	    <exit-code> 0 </exit-code>
    34	    requires N >=Int 2
    35	      andBool D >=Int 2
    36	    [label(loop_correct)]
    37	endmodule
    38	
    39	module X-OR-Y-MAIN-SPEC
    40	  imports X-OR-Y-SUMMARY
    41	
    42	  // Universal functional correctness for every integer n and arbitrary
    43	  // Python values x and y, from the reference semantics' initial state.
    44	  claim
    45	    <k> #xOrY(N:Int, X:Val, Y:Val) => primeSelect(N, 2, X, Y) </k>
    46	    <env> 0 </env>
