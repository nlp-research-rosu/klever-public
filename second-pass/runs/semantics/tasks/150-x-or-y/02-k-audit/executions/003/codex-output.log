diff --git a//tmp/audit-work/150-x-or-y-review/body-mutation-verification.k b//tmp/audit-work/150-x-or-y-review/body-mutation-verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..97f601947b9f18c44d7a25e6204dae88792574d0
--- /dev/null
+++ b//tmp/audit-work/150-x-or-y-review/body-mutation-verification.k
@@ -0,0 +1,14 @@
+requires "verification.k"
+
+module X-OR-Y-BODY-MUT-VERIFICATION
+  imports X-OR-Y-VERIFICATION
+
+  // Material mutation: a found divisor returns x instead of y.
+  syntax Stmts ::= "xOrYLoopBodyMutated" [macro]
+  rule xOrYLoopBodyMutated
+    => If(
+         Compare(BinOp("%", Name("n"), Name("divisor")),
+                 CmpOp("==", Int(0))),
+         Return(Name("x")),
+         .Stmts)
+endmodule
