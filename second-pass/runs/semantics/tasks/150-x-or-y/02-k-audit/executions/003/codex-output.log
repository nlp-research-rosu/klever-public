import hashlib, os, stat
from pathlib import Path

def td(root):
 d=hashlib.sha256(); es=[]
 for base,dirs,files in os.walk(root,followlinks=False):
  for name in dirs+files:
   p=Path(base)/name; m=p.stat(follow_symlinks=False).st_mode; rel=p.relative_to(root).as_posix()
   if stat.S_ISDIR(m): k='directory'
   elif stat.S_ISREG(m): k='file'
   else: raise Exception(p)
   es.append((rel,k,p))
 for rel,k,p in sorted(es):
  d.update(rel.encode()+b'\\0'+k.encode()+b'\\0')
  if k=='file': d.update(p.read_bytes())
 return d.hexdigest()
for p in map(Path,['/candidate','/candidate/reference-semantics','/reference/reference-semantics','/generation-evidence/codex-trace']): print(p,td(p))
