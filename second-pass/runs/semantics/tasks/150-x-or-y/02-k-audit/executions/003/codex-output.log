+requires "verification.k"
+
+module X-OR-Y-BODY-MUT-VERIFICATION
+  imports X-OR-Y-VERIFICATION
+
+  // Material mutation: a found divisor returns x instead of y.
+  syntax Stmts ::= "xOrYLoopBodyMutated" [macro]
+  rule xOrYLoopBodyMutated
+    => If(
+         Compare(BinOp("%", Name("n"), Name("divisor")),
+                 CmpOp("==", Int(0))),
+         Return(Name("x")),
+         .Stmts)
+endmodule
diff --git a//tmp/audit-work/150-x-or-y-review/body-sensitivity.k b//tmp/audit-work/150-x-or-y-review/body-sensitivity.k
new file mode 100644
index 0000000000000000000000000000000000000000..699340d09a32a4f359f28c7ae07c3f8c469eeb61
--- /dev/null
+++ b//tmp/audit-work/150-x-or-y-review/body-sensitivity.k
@@ -0,0 +1,35 @@
+requires "body-mutation-verification.k"
+
+module X-OR-Y-BODY-SENSITIVITY
+  imports X-OR-Y-BODY-MUT-VERIFICATION
+
+  // Reachable original-program loop-head witness after testing divisor 2:
+  // n=9, next D=3, old divisor=2, x=1, y=2. The mutated body returns 1,
+  // while the original summary obligation requires 2.
+  claim
+    <k>
+      #loop(rangeObj(3, 9, 1), Name("divisor"), xOrYLoopBodyMutated)
+      ~> (Return(Name("x")) .Stmts)
+      ~> #endcall
+      => #pop
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(.Map, parent(-1))
+      1 |-> scope(
+        "divisor" |-> (2 => scanLast(9, 3, 2))
+        "n" |-> 9
+        "x" |-> 1
+        "y" |-> 2,
+        parent(0))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet => retV(primeSelect(9, 3, 1, 2)) </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(body_sensitivity)]
+endmodule
diff --git a//tmp/audit-work/150-x-or-y-review/concrete_audit.py b//tmp/audit-work/150-x-or-y-review/concrete_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..629ee39fabb3f7e48035fd43698c3679c2451075
--- /dev/null
+++ b//tmp/audit-work/150-x-or-y-review/concrete_audit.py
@@ -0,0 +1,22 @@
+def x_or_y(n, x, y):
+    if n < 2:
+        return y
+    for divisor in range(2, n):
+        if n % divisor == 0:
+            return y
+    return x
+
+
+# Prompt examples.
+assert x_or_y(7, 34, 12) == 34
+assert x_or_y(15, 8, 5) == 5
+
+# Boundary and branch-sensitive cases.
+assert x_or_y(-3, 1, 2) == 2
+assert x_or_y(0, 3, 4) == 4
+assert x_or_y(1, 5, 6) == 6
+assert x_or_y(2, 7, 8) == 7
+assert x_or_y(4, 9, 10) == 10
+assert x_or_y(9, 11, 12) == 12
+assert x_or_y(97, 13, 14) == 13
+assert x_or_y(49, 15, 16) == 16
