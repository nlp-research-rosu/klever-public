+requires "verification.k"
+
+module X-OR-Y-ADEQUACY-GROUND
+  imports X-OR-Y-SUMMARY
+
+  claim
+    <k> #xOrY(7, 34, 12) => 34 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
