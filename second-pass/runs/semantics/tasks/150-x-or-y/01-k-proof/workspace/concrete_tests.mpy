Module(
  FuncDef("x_or_y", Params("n", "x", "y"),
    If(Compare(Name("n"), CmpOp("<", Int(2))),
      Return(Name("y")),
      )
    For(Name("divisor"), Call(Name("range"), Int(2), Name("n")),
      If(Compare(
        BinOp("%", Name("n"), Name("divisor")),
        CmpOp("==", Int(0))),
        Return(Name("y")),
        ))
    Return(Name("x")))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(7), Int(34), Int(12)),
      CmpOp("==", Int(34))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(15), Int(8), Int(5)),
      CmpOp("==", Int(5))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(1), Int(7), Int(9)),
      CmpOp("==", Int(9))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(2), Int(11), Int(13)),
      CmpOp("==", Int(11))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(0), Int(4), Int(6)),
      CmpOp("==", Int(6))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(97), UnaryOp("-", Int(2)), Int(10)),
      CmpOp("==", UnaryOp("-", Int(2)))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(49), Int(3), Int(4)),
      CmpOp("==", Int(4)))))
