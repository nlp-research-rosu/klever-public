        "start_line": 73,
        "text": "  rule\n    <k>\n      #loop(rangeObj(D:Int, N:Int, 1), Name(\"divisor\"), xOrYLoopBody)\n      ~> (Return(Name(\"x\")) .Stmts)\n      ~> #endcall\n      => #pop\n    </k>\n    <env> 1 </env>\n    <scopes>\n      -1 |-> BS:Scope\n      0 |-> scope(.Map, parent(-1))\n      1 |-> scope(\n        \"divisor\" |-> (OLD:Int => scanLast(N, D, OLD))\n        \"n\" |-> N:Int\n        \"x\" |-> X:Val\n        \"y\" |-> Y:Val,\n        parent(0))\n    </scopes>\n    <scopeLoc> 2 </scopeLoc>\n    <heap> .Map </heap>\n    <heapLoc> 0 </heapLoc>\n    <stack> ListItem(frame(.K, 0, 1)) </stack>\n    <ret> noRet => retV(primeSelect(N, D, X:Val, Y:Val)) </ret>\n    <exc> NoExc </exc>\n    <exit-code> 0 </exit-code>\n    requires N >=Int 2\n      andBool D >=Int 2\n    [priority(40)]"
