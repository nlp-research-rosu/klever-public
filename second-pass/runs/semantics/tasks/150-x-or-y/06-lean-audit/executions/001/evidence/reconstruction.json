        "start_line": 9,
        "text": "  rule xOrYLoopBody\n    => If(\n         Compare(BinOp(\"%\", Name(\"n\"), Name(\"divisor\")),\n                 CmpOp(\"==\", Int(0))),\n         Return(Name(\"y\")),\n         .Stmts)"
      },
      {
        "attributes": [],
        "end_line": 23,
        "module": "X-OR-Y-VERIFICATION",
        "normalized_sha256": "c3590d006a48f7fb580323c09a84fb8d8b67e624d7743626829c8f229f5f3639",
