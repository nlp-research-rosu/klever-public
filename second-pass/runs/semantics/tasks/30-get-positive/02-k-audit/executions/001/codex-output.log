+        list(intVals(INPUT)),
+        Name("x"),
+        positiveLoopBody)
+      ~> CONT
+      => CONT
+    </k>
+    <env> LOCAL </env>
+    <scopes>
+      ...
+      LOCAL |-> (
+        scope(
+          ("l" |-> ARG)
+          ("result" |-> ref(ACC_LOC))
+          ("x" |-> _OLD_X),
+          parent(0))
+        =>
+        scope(
+          ("l" |-> ARG)
+          ("result" |-> ref(ACC_LOC))
+          ("x" |-> ?_FINAL_X),
+          parent(0)))
+      ...
