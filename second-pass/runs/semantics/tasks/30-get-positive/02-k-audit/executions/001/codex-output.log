+printf '\n$ wc -c %s/spec-vacuity.kore\n' "$work"
+wc -c "$work/spec-vacuity.kore"
+wc_status=$?
+printf '[exit %d]\n' "$wc_status"
+if test "$wc_status" -ne 0; then
+  failed=1
