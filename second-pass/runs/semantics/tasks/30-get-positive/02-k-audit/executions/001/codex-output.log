+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local status=$?
+  printf '[exit %d]\n' "$status"
+}
+
+run sha256sum \
+  /reference/prompt.py /candidate/prompt.py \
+  /reference/py2mpy.py /candidate/py2mpy.py
