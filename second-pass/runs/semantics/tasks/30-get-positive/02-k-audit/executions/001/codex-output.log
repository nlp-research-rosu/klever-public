+
+  claim [ground-entry]:
+    <k>
+      Call(
+        Name("get_positive"),
+        list(intVals(
+          iCons(-2, iCons(0, iCons(3, iCons(1, .IntSeq)))))))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
