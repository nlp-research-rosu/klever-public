+  '^\s*(syntax|rule|claim)\b|\[(?:[^\]]*\b(?:function|total|functional|macro|simplification|priority|concrete|owise)\b[^\]]*)\]' \
+  /candidate/verification.k /candidate/spec.k
+
+run rg -n 'syntax .*\bsymbol\(' \
+  /reference/reference-semantics
+

