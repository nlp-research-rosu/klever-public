+          ("l" |-> ARG)
+          ("result" |-> ref(ACC_LOC))
+          ("x" |-> ?_FINAL_X),
+          parent(0)))
+      ...
+    </scopes>
+    <heap>
+      ...
+      ACC_LOC |-> list(
+        PREFIX
+        =>
+        filterPositiveMut(PREFIX, INPUT))
+      ...
+    </heap>
+endmodule
