+  // submitted body to > 1.
+  claim [filter-loop-body-mut]:
+    <k>
+      #loop(
+        list(intValsMut(INPUT)),
+        Name("x"),
+        positiveLoopBodyMut)
+      ~> CONT
+      => CONT
+    </k>
+    <env> LOCAL </env>
+    <scopes>
