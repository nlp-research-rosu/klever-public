+        else:
+            disposition = "Reachability claim; adequacy and closure individually reviewed."
+        if attrs:
+            disposition += " Attributes: " + ", ".join(attrs) + "."
+
+        print(
+            f"| `{rel}:{start + 1}` | {kind} | `{text}` | {disposition} |"
+        )
