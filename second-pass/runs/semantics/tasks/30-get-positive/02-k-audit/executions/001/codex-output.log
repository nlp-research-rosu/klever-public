+    stat -c '%F %n' "/candidate/$artifact"
+    printf '[exit 0]\n'
+  else
+    printf 'MISSING /candidate/%s\n' "$artifact"
+    printf '[exit 1]\n'
+  fi
+done
+
+run find /candidate -maxdepth 2 -type f \
+  \( -iname '*trace*' -o -iname '*.jsonl' \) -print
+
