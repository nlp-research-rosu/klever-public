+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  claim [filter-loop]:
+    <k>
+      #loop(
+        list(intVals(INPUT)),
+        Name("x"),
+        positiveLoopBody)
+      ~> CONT
+      => CONT
+    </k>
+    <env> LOCAL </env>
+    <scopes>
+      ...
+      LOCAL |-> (
+        scope(
+          ("l" |-> ARG)
+          ("result" |-> ref(ACC_LOC))
+          ("x" |-> _OLD_X),
+          parent(0))
+        =>
+        scope(
+          ("l" |-> ARG)
+          ("result" |-> ref(ACC_LOC))
+          ("x" |-> ?_FINAL_X),
+          parent(0)))
+      ...
+    </scopes>
+    <heap>
+      ...
+      ACC_LOC |-> list(
+        PREFIX
+        =>
+        filterPositive(PREFIX, INPUT))
+      ...
+    </heap>
+
+  // Deliberately false: append zero to every claimed result.  For the
+  // satisfying empty input, the real result is [] but this demands [0].
+  claim [get-positive-wrong]:
+    <k>
+      Call(
+        Name("get_positive"),
+        list(intVals(INPUT)))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "get_positive"
+               |-> closureVal(("l", .ParamNames), getPositiveBody, 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        valSeqConcat(
+          filterPositive(.ValSeq, INPUT),
+          vCons(0, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
diff --git a//tmp/audit-work/30-get-positive/verification-body-mut.k b//tmp/audit-work/30-get-positive/verification-body-mut.k
new file mode 100644
index 0000000000000000000000000000000000000000..c7119eeac5debf3e846c70f946b81d07913e1c41
--- /dev/null
+++ b//tmp/audit-work/30-get-positive/verification-body-mut.k
@@ -0,0 +1,41 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BODY-MUT
+  imports MPY
+
+  syntax Stmts ::= "getPositiveBodyMut" [macro]
+  rule getPositiveBodyMut
+    => Assign(Name("result"), ListExpr(.Exprs))
+       For(Name("x"), Name("l"), positiveLoopBodyMut)
+       Return(Name("result"))
+
+  syntax Stmts ::= "positiveLoopBodyMut" [macro]
+  rule positiveLoopBodyMut
+    => If(
+         Compare(Name("x"), CmpOp(">", Int(1))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             Name("x"))),
+         .Stmts)
+
+  syntax ValSeq ::= intValsMut(IntSeq)
+  rule <k> #iterNext(list(intValsMut(.IntSeq))) => #iterDone ... </k>
+  rule <k> #iterNext(list(intValsMut(iCons(I, IS))))
+        => #iterYield(I, list(intValsMut(IS))) ... </k>
+
+  syntax ValSeq ::= filterPositiveMut(ValSeq, IntSeq) [function]
+  rule filterPositiveMut(ACC, .IntSeq) => ACC
+  rule filterPositiveMut(ACC, iCons(I, IS))
+    => filterPositiveBranchMut(I >Int 0, ACC, I, IS)
+
+  syntax ValSeq ::= filterPositiveBranchMut(Bool, ValSeq, Int, IntSeq)
+                    [function, total]
+  rule filterPositiveBranchMut(true, ACC, I, IS)
+    => filterPositiveMut(
+         valSeqConcat(ACC, vCons(I, .ValSeq)),
+         IS)
+  rule filterPositiveBranchMut(false, ACC, _I, IS)
+    => filterPositiveMut(ACC, IS)
+endmodule
+
diff --git a/REVIEW.md b/REVIEW.md
new file mode 100644
index 0000000000000000000000000000000000000000..3b9ec80e1cf27c3b1a318462d9d4b5cc286f80a2
--- /dev/null
+++ b/REVIEW.md
@@ -0,0 +1,498 @@
+# Independent adversarial review: 30-get-positive
+
+This audit was performed against the trusted mounts, from fresh source builds in
+`/tmp/audit-work/30-get-positive`. Nothing under `/candidate` was executed or
+modified in place, and no candidate-provided compiled definition or cache was
+used.
+
+The proof is legitimate but limited. It machine-checks the real submitted
+function body for arbitrary finite integer sequences represented through a
+proof-local input adapter. The result is constrained and the proof is
+non-vacuous. The limitations are that the entry claim manually seeds the exact
+closure instead of loading the submitted `Module(...)` term, the universal
+input is a synthetic `intVals(IntSeq)` representation rather than the supplied
+semantics' ordinary `vCons` list representation, and the formal theorem covers
+integers only although the prose says “numbers.” These are visible,
+non-oracular bridges; they do not enable a false conclusion in the theorem's
+formal domain, but they preclude an unqualified PASS.
+
+## 1. Input and provenance integrity
+
+### Mount-condition check
+
+The rendered mode is `SUPPLIED_SEMANTICS`, and
+`/reference/reference-semantics` is present. There is no mount contradiction,
+so this is a candidate audit rather than an infrastructure error.
+
+The recursive command
+
+```text
+diff -ruN --no-dereference \
