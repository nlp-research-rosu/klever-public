+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition "$work/runtime-kompiled"
+
+run krun "$work/solution.mpy" \
+  --definition "$work/runtime-kompiled"
+
+run python3 /audit-output/evidence/04_reviewer_concrete.py
+
+run krun "$work/reviewer-concrete.mpy" \
+  --definition "$work/runtime-kompiled"
+
+exit "$failed"
+
diff --git a/evidence/04_reviewer_concrete.py b/evidence/04_reviewer_concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..c8cc7dc6f5d9b9dd45f7a7cc5076b1656085de49
--- /dev/null
+++ b/evidence/04_reviewer_concrete.py
@@ -0,0 +1,19 @@
+"""Reviewer-authored concrete harness for the submitted implementation."""
+
+
+def get_positive(l: list):
+    result = []
+    for x in l:
+        if x > 0:
+            result.append(x)
+    return result
+
+
+assert get_positive([-1, 2, -4, 5, 6]) == [2, 5, 6]
+assert get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10]) == [
+    5, 3, 2, 3, 9, 123, 1
+]
+assert get_positive([]) == []
+assert get_positive([-1, 0, 1]) == [1]
+assert get_positive([3, 0, -2, 3, 1]) == [3, 3, 1]
+
