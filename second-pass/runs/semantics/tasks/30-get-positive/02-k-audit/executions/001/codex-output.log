diff --git a//tmp/audit-work/30-get-positive/spec-vacuity.k b//tmp/audit-work/30-get-positive/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..0159aa222e731ccf4833e08640f71b52cc79172b
--- /dev/null
+++ b//tmp/audit-work/30-get-positive/spec-vacuity.k
@@ -0,0 +1,73 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  claim [filter-loop]:
+    <k>
+      #loop(
+        list(intVals(INPUT)),
+        Name("x"),
+        positiveLoopBody)
+      ~> CONT
+      => CONT
+    </k>
+    <env> LOCAL </env>
+    <scopes>
+      ...
+      LOCAL |-> (
+        scope(
+          ("l" |-> ARG)
+          ("result" |-> ref(ACC_LOC))
+          ("x" |-> _OLD_X),
+          parent(0))
+        =>
+        scope(
+          ("l" |-> ARG)
+          ("result" |-> ref(ACC_LOC))
+          ("x" |-> ?_FINAL_X),
+          parent(0)))
+      ...
+    </scopes>
+    <heap>
+      ...
+      ACC_LOC |-> list(
+        PREFIX
+        =>
+        filterPositive(PREFIX, INPUT))
+      ...
+    </heap>
+
+  // Deliberately false: append zero to every claimed result.  For the
+  // satisfying empty input, the real result is [] but this demands [0].
+  claim [get-positive-wrong]:
+    <k>
+      Call(
+        Name("get_positive"),
+        list(intVals(INPUT)))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "get_positive"
+               |-> closureVal(("l", .ParamNames), getPositiveBody, 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        valSeqConcat(
+          filterPositive(.ValSeq, INPUT),
+          vCons(0, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
diff --git a//tmp/audit-work/30-get-positive/verification-body-mut.k b//tmp/audit-work/30-get-positive/verification-body-mut.k
new file mode 100644
index 0000000000000000000000000000000000000000..c7119eeac5debf3e846c70f946b81d07913e1c41
--- /dev/null
+++ b//tmp/audit-work/30-get-positive/verification-body-mut.k
@@ -0,0 +1,41 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BODY-MUT
+  imports MPY
+
+  syntax Stmts ::= "getPositiveBodyMut" [macro]
+  rule getPositiveBodyMut
+    => Assign(Name("result"), ListExpr(.Exprs))
+       For(Name("x"), Name("l"), positiveLoopBodyMut)
+       Return(Name("result"))
+
+  syntax Stmts ::= "positiveLoopBodyMut" [macro]
+  rule positiveLoopBodyMut
+    => If(
+         Compare(Name("x"), CmpOp(">", Int(1))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             Name("x"))),
+         .Stmts)
+
+  syntax ValSeq ::= intValsMut(IntSeq)
+  rule <k> #iterNext(list(intValsMut(.IntSeq))) => #iterDone ... </k>
+  rule <k> #iterNext(list(intValsMut(iCons(I, IS))))
+        => #iterYield(I, list(intValsMut(IS))) ... </k>
+
+  syntax ValSeq ::= filterPositiveMut(ValSeq, IntSeq) [function]
+  rule filterPositiveMut(ACC, .IntSeq) => ACC
+  rule filterPositiveMut(ACC, iCons(I, IS))
+    => filterPositiveBranchMut(I >Int 0, ACC, I, IS)
+
+  syntax ValSeq ::= filterPositiveBranchMut(Bool, ValSeq, Int, IntSeq)
+                    [function, total]
+  rule filterPositiveBranchMut(true, ACC, I, IS)
+    => filterPositiveMut(
+         valSeqConcat(ACC, vCons(I, .ValSeq)),
+         IS)
+  rule filterPositiveBranchMut(false, ACC, _I, IS)
+    => filterPositiveMut(ACC, IS)
+endmodule
+
diff --git a/evidence/00_provenance.sh b/evidence/00_provenance.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c46a3aaa09d8791f968e3aa12e8cd5c39021cb6f
--- /dev/null
+++ b/evidence/00_provenance.sh
@@ -0,0 +1,46 @@
+#!/usr/bin/env bash
+set -u
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local status=$?
+  printf '[exit %d]\n' "$status"
+}
+
+run sha256sum \
+  /reference/prompt.py /candidate/prompt.py \
+  /reference/py2mpy.py /candidate/py2mpy.py
+run cmp /reference/prompt.py /candidate/prompt.py
+run cmp /reference/py2mpy.py /candidate/py2mpy.py
+run diff -ruN --no-dereference \
+  /reference/reference-semantics /candidate/reference-semantics
+run find /candidate/reference-semantics -printf '%y %P -> %l\n'
+run find /reference/reference-semantics -printf '%y %P -> %l\n'
+run stat -c '%F %n -> %N' \
+  /candidate/prompt.py \
+  /candidate/py2mpy.py \
+  /candidate/solution.py \
+  /candidate/solution.mpy \
+  /candidate/spec.k \
+  /candidate/verification.k \
+  /candidate/reference-semantics
+run find /candidate -maxdepth 4 -type l -printf '%p -> %l\n'
+
+for artifact in \
+  run-input.json metrics.json codex-last.txt codex-output.log
+do
+  printf '\n$ test -e /candidate/%s\n' "$artifact"
+  if test -e "/candidate/$artifact"; then
+    stat -c '%F %n' "/candidate/$artifact"
+    printf '[exit 0]\n'
+  else
+    printf 'MISSING /candidate/%s\n' "$artifact"
+    printf '[exit 1]\n'
+  fi
+done
+
+run find /candidate -maxdepth 2 -type f \
+  \( -iname '*trace*' -o -iname '*.jsonl' \) -print
