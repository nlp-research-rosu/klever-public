+    <k>
+      Call(
+        Name("get_positive"),
+        list(intVals(INPUT)))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "get_positive"
+               |-> closureVal(("l", .ParamNames), mutatedGetPositiveBody, 0),
