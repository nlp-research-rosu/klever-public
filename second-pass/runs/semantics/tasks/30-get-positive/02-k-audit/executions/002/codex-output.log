+        scope(
+          ("l" |-> ref(9))
+          ("result" |-> ref(0))
+          ("x" |-> 42),
+          parent(0))
+        =>
+        scope(
+          ("l" |-> ref(9))
+          ("result" |-> ref(0))
+          ("x" |-> 3),
+          parent(0)))
+    </scopes>
+    <heap>
+      0 |-> list(vCons(7, .ValSeq))
+      =>
+      0 |-> list(vCons(7, vCons(3, .ValSeq)))
+    </heap>
+endmodule
