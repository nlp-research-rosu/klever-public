+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      1 |-> (
+        scope(
+          ("l" |-> ref(9))
+          ("result" |-> ref(0))
+          ("x" |-> 42),
+          parent(0))
+        =>
