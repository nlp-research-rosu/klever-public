Module(
  FuncDef("get_positive", Params("l"),
    Assign(Name("result"), ListExpr())
    For(Name("x"), Name("l"),
      If(Compare(Name("x"), CmpOp(">", Int(0))),
        Expr(Call(Attribute(Name("result"), "append"), Name("x"))),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Int(1)),
          Int(2),
          UnaryOp("-", Int(4)),
          Int(5),
          Int(6))),
      CmpOp("==", ListExpr(Int(2), Int(5), Int(6)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Int(5),
          Int(3),
          UnaryOp("-", Int(5)),
          Int(2),
          UnaryOp("-", Int(3)),
          Int(3),
          Int(9),
          Int(0),
          Int(123),
          Int(1),
          UnaryOp("-", Int(10)))),
      CmpOp(
        "==",
        ListExpr(
          Int(5),
          Int(3),
          Int(2),
          Int(3),
          Int(9),
          Int(123),
          Int(1)))))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(1)),
          Int(0))),
      CmpOp("==", ListExpr()))))
