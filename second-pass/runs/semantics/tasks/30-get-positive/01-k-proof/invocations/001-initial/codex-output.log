+  imports VERIFICATION
+
+  // Loop invariant and induction lemma.  This state is reached after the
+  // first target binding, so the function-local frame has exactly l, result,
+  // and x.  Python's for-loop may change only the value of x.
+  claim [filter-loop]:
+    <k>
+      #loop(
+        list(intVals(INPUT)),
+        Name("x"),
+        positiveLoopBody)
+      ~> CONT
+      => CONT
+    </k>
+    <env> LOCAL </env>
+    <scopes>
+      ...
+      LOCAL |-> (
+        scope(
+          ("l" |-> ARG)
+          ("result" |-> ref(ACC_LOC))
+          ("x" |-> _OLD_X),
+          parent(0))
+        =>
+        scope(
+          ("l" |-> ARG)
+          ("result" |-> ref(ACC_LOC))
+          ("x" |-> ?_FINAL_X),
+          parent(0)))
+      ...
+    </scopes>
+    <heap>
+      ...
+      ACC_LOC |-> list(
+        PREFIX
+        =>
+        filterPositive(PREFIX, INPUT))
+      ...
+    </heap>
+
+  claim [get-positive-correct]:
+    <k>
+      Call(
+        Name("get_positive"),
+        list(intVals(INPUT)))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+             "get_positive"
+               |-> closureVal(("l", .ParamNames), getPositiveBody, 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(filterPositive(.ValSeq, INPUT))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..df38de7b732b1b0d3d5dd9db9fa62ff7d136efae
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,49 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The translated body of solution.py.  Keeping it as a macro makes the
+  // correspondence between the executable .mpy term and the proof term
+  // explicit while allowing the specification to call the closure directly.
+  syntax Stmts ::= "getPositiveBody" [macro]
+  rule getPositiveBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       For(Name("x"), Name("l"), positiveLoopBody)
+       Return(Name("result"))
+
+  syntax Stmts ::= "positiveLoopBody" [macro]
+  rule positiveLoopBody
+    => If(
+         Compare(Name("x"), CmpOp(">", Int(0))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             Name("x"))),
+         .Stmts)
+
+  // `intVals` is an isomorphic, symbolic embedding of arbitrary finite integer
+  // sequences.  These two iterator rules expose exactly one constructor per
+  // proof step, allowing the loop claim in spec.k to serve as the induction
+  // hypothesis.
+  syntax ValSeq ::= intVals(IntSeq)
+  rule <k> #iterNext(list(intVals(.IntSeq))) => #iterDone ... </k>
+  rule <k> #iterNext(list(intVals(iCons(I, IS))))
+        => #iterYield(I, list(intVals(IS))) ... </k>
+
+  // Mathematical left-to-right filter, generalized over an accumulator so
+  // that its recursive call is exactly the program loop invariant.
+  syntax ValSeq ::= filterPositive(ValSeq, IntSeq) [function]
+  rule filterPositive(ACC, .IntSeq) => ACC
+  rule filterPositive(ACC, iCons(I, IS))
+    => filterPositiveBranch(I >Int 0, ACC, I, IS)
+
+  syntax ValSeq ::= filterPositiveBranch(Bool, ValSeq, Int, IntSeq)
+                    [function, total]
+  rule filterPositiveBranch(true, ACC, I, IS)
+    => filterPositive(
+         valSeqConcat(ACC, vCons(I, .ValSeq)),
+         IS)
+  rule filterPositiveBranch(false, ACC, _I, IS)
+    => filterPositive(ACC, IS)
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..e60dc08856d6bcd7a002731c59e4d1587c8899d1
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,14 @@
+def get_positive(l: list):
+    result = []
+    for x in l:
+        if x > 0:
+            result.append(x)
+    return result
+
+
+assert get_positive([-1, 2, -4, 5, 6]) == [2, 5, 6]
+assert get_positive([5, 3, -5, 2, -3, 3, 9, 0, 123, 1, -10]) == [
+    5, 3, 2, 3, 9, 123, 1
+]
+assert get_positive([]) == []
+assert get_positive([-3, -2, -1, 0]) == []
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..e4fa676dc8364ee856e96c288a8a0157ef315775
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Translate the submitted implementation and the concrete assertion harness.
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+
+# Required concrete LLVM definition and executions.
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+python3 concrete_tests.py
+krun concrete_tests.mpy --definition runtime-kompiled
+
+# Symbolic definition (MPY only, through VERIFICATION) and all proof claims.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --smt-timeout 10000
