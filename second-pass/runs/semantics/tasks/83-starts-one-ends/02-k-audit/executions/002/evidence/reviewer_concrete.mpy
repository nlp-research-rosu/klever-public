Module(
  FuncDef("starts_one_ends", Params("n"),
    Expr(
      Str(
        "\n    Given a positive integer n, return the count of the numbers of n-digit\n    positive integers that start or end with 1.\n    "))
    If(Compare(Name("n"), CmpOp("==", Int(1))),
      Return(Int(1)),
      )
    Return(
      BinOp(
        "*",
        Int(18),
        BinOp("**", Int(10), BinOp("-", Name("n"), Int(2))))))
  Assert(
    Compare(Call(Name("starts_one_ends"), Int(1)), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("starts_one_ends"), Int(2)), CmpOp("==", Int(18))))
  Assert(
    Compare(
      Call(Name("starts_one_ends"), Int(3)),
      CmpOp("==", Int(180))))
  Assert(
    Compare(
      Call(Name("starts_one_ends"), Int(5)),
      CmpOp("==", Int(18000))))
  Assert(
    Compare(
      Call(Name("starts_one_ends"), Int(10)),
      CmpOp("==", Int(1800000000)))))
