+    requires N >=Int 2
+endmodule
diff --git a//tmp/audit-work/83-starts-one-ends-audit/spec-n-ge-2.k b//tmp/audit-work/83-starts-one-ends-audit/spec-n-ge-2.k
new file mode 100644
index 0000000000000000000000000000000000000000..6b3f295918f9c13f52334b68080361dededc70d0
