/reference/reference-semantics/semantics/range.k:22:       requires inRange(I, HI, ST)
/reference/reference-semantics/semantics/range.k:23:  rule <k> #iterNext(rangeObj(I:Int, HI:Int, ST:Int)) => #iterDone ... </k>
/reference/reference-semantics/semantics/range.k:24:       requires notBool inRange(I, HI, ST)
/reference/reference-semantics/semantics/range.k:25:endmodule
