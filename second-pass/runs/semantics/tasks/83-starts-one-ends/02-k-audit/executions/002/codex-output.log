/reference/reference-semantics/semantics/range.k:7:  imports MPY-ITER
/reference/reference-semantics/semantics/range.k:9:  syntax Bool ::= inRange(Int, Int, Int) [function, total]
/reference/reference-semantics/semantics/range.k:10:  rule inRange(I:Int, HI:Int, ST:Int) => (ST >Int 0 andBool I <Int HI) orBool (ST <Int 0 andBool I >Int HI)
/reference/reference-semantics/semantics/range.k:12:  syntax Int ::= rangeLen(Int, Int, Int) [function]
/reference/reference-semantics/semantics/range.k:13:  rule rangeLen(LO:Int, HI:Int, ST:Int) => (HI -Int LO +Int ST -Int 1) /Int ST
/reference/reference-semantics/semantics/range.k:14:       requires ST >Int 0 andBool HI >Int LO
/reference/reference-semantics/semantics/range.k:15:  rule rangeLen(LO:Int, HI:Int, ST:Int) => (LO -Int HI -Int ST -Int 1) /Int (0 -Int ST)
/reference/reference-semantics/semantics/range.k:16:       requires ST <Int 0 andBool HI <Int LO
/reference/reference-semantics/semantics/range.k:17:  rule rangeLen(LO:Int, HI:Int, ST:Int) => 0
/reference/reference-semantics/semantics/range.k:18:       requires (ST >Int 0 andBool HI <=Int LO) orBool (ST <Int 0 andBool HI >=Int LO)
