/reference/reference-semantics/semantics/methods.k:30:  rule joinCodes(SEP:IntSeq, vCons(str(CS:IntSeq), vCons(V:Val, R:ValSeq)))
/reference/reference-semantics/semantics/methods.k:34:  rule applyMethod(str(CS:IntSeq), "count", str(PC:IntSeq), .Vals) => cntSub(CS, PC)
/reference/reference-semantics/semantics/methods.k:35:  syntax Int ::= cntSub(IntSeq, IntSeq) [function]
/reference/reference-semantics/semantics/methods.k:36:  rule cntSub(.IntSeq, _:IntSeq) => 0
/reference/reference-semantics/semantics/methods.k:37:  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => 1 +Int cntSub(dropIS(iCons(C, R), isLen(PC)), PC)
