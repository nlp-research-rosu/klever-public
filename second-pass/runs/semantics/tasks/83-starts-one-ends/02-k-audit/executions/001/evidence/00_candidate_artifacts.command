cwd: /audit-output
command: bash -c for\ name\ in\ run-input.json\ metrics.json\ codex-last.txt\ codex-output.log\;\ do\ if\ \[\[\ -L\ /candidate/\$name\ \]\]\;\ then\ printf\ \"SYMLINK\ %s\ -\>\ %s\\n\"\ \"\$name\"\ \"\$\(readlink\ /candidate/\$name\)\"\;\ elif\ \[\[\ -f\ /candidate/\$name\ \]\]\;\ then\ printf\ \"FILE\ %s\\n\"\ \"\$name\"\;\ elif\ \[\[\ -e\ /candidate/\$name\ \]\]\;\ then\ printf\ \"MISTYPED\ %s\\n\"\ \"\$name\"\;\ else\ printf\ \"MISSING\ %s\\n\"\ \"\$name\"\;\ fi\;\ done\;\ find\ /candidate\ -maxdepth\ 3\ -iname\ \"\*trace\*\"\ -printf\ \"TRACE\ %y\ %p\ -\>\ %l\\n\"\;\ find\ /candidate\ -type\ l\ -printf\ \"SYMLINK_ANY\ %p\ -\>\ %l\\n\"
