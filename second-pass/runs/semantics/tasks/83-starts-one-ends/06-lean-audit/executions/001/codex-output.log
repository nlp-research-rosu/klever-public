+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+
+from tools import klean_export
+from tools import stage6_resolution_contract
+from tools.k_rule_inventory import inventory_verification
+from tools.lemma_discovery_contract import validate_trust_boundary
+from tools.pipeline_contract import sha256_tree
+
+
+AUDIT_INPUT = Path("/audit-input.json")
+K_PROOF = Path("/reference/k-proof")
+K_AUDIT = Path("/reference/k-audit")
+DISCOVERY = Path("/reference/lemma-discovery.json")
+GENERATION = Path("/reference/klean-generation")
+GENERATED = GENERATION / "generated"
+PRODUCERS = Path("/reference/generation-tools")
+LOCK = Path("/reference/klean-toolchain.lock.json")
+
+
+def load(path: Path) -> dict:
+    value = json.loads(path.read_bytes())
+    assert isinstance(value, dict), path
+    return value
+
+
+def file_sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def report(label: str, observed: object, expected: object) -> None:
+    assert observed == expected, (
+        f"{label}: observed {observed!r}, expected {expected!r}"
+    )
+    print(f"PASS {label}: {observed!r}")
+
+
+def main() -> None:
+    audit_document = load(AUDIT_INPUT)
+    resolution = audit_document["resolution"]
+    hashes = resolution["hashes"]
+
+    report("AUDIT_MODE", os.environ.get("AUDIT_MODE"), resolution["mode"])
+    report("mode", resolution["mode"], "CLASSIFICATION_ONLY")
+    report(
+        "resolved input canonical hash",
+        stage6_resolution_contract.canonical_json_sha256(resolution),
+        audit_document["resolved_input_sha256"],
+    )
+
+    report(
+        "Stage 1 launcher tree hash",
+        sha256_tree(K_PROOF),
+        hashes["k_workspace_sha256"],
+    )
+    report(
+        "Stage 1 export tree hash",
+        klean_export.tree_digest(K_PROOF),
+        hashes["stage1_export_sha256"],
+    )
+    report(
+        "Stage 2 selected-audit tree hash",
+        sha256_tree(K_AUDIT),
+        hashes["k_audit_sha256"],
+    )
+    report(
+        "Stage 3 manifest file hash",
+        file_sha256(DISCOVERY),
+        hashes["discovery_manifest_sha256"],
+    )
+    report(
+        "Stage 4 generation tree hash",
+        sha256_tree(GENERATION),
+        hashes["klean_generation_sha256"],
+    )
+    report(
+        "generated project tree hash",
+        klean_export.tree_digest(GENERATED),
+        hashes["generated_tree_sha256"],
+    )
+    report(
+        "producer-source tree hash",
+        sha256_tree(PRODUCERS),
+        hashes["generation_producer_sources_sha256"],
+    )
+    report("Lean workspace hash", hashes["lean_workspace_sha256"], None)
+    report("Lean invocation hash", hashes["lean_invocation_sha256"], None)
+
+    observed_source_hashes = {
+        path.relative_to(K_PROOF).as_posix(): file_sha256(path)
+        for path in sorted(K_PROOF.rglob("*"))
+        if path.is_file()
+    }
+    report(
+        "all Stage 1 source file hashes",
+        observed_source_hashes,
+        resolution["stage1_source_hashes"],
+    )
+
+    producer_manifest = load(PRODUCERS / "source-manifest.json")
+    generator_manifest = load(GENERATION / "generator-manifest.json")
+    input_manifest = load(GENERATION / "input-manifest.json")
+    export_result = load(GENERATION / "export-result.json")
+    stored_preflight = load(GENERATION / "preflight.json")
+    obligation_map = load(GENERATED / "obligation-map.json")
+    lock = load(LOCK)
+
+    producer_names = sorted(
+        path.relative_to(PRODUCERS).as_posix()
+        for path in PRODUCERS.rglob("*")
+        if path.is_file()
+    )
+    report(
+        "exact producer-source file set",
+        producer_names,
+        ["klean.py", "klean_export.py", "source-manifest.json"],
+    )
+    producer_hashes = {
+        "klean.py": file_sha256(PRODUCERS / "klean.py"),
+        "klean_export.py": file_sha256(PRODUCERS / "klean_export.py"),
+    }
+    report(
+        "producer files versus source manifest",
+        producer_hashes,
+        producer_manifest["files"],
+    )
+    report(
+        "exporter source hash versus generator manifest",
+        producer_hashes["klean_export.py"],
+        generator_manifest["exporter_sha256"],
+    )
+    report(
+        "klean.py source hash versus generator manifest",
+        producer_hashes["klean.py"],
+        generator_manifest["klean_py_sha256"],
+    )
+    generator_image_id = producer_manifest["generator_image_id"]
+    report(
+        "generator image ID versus generator manifest",
+        generator_image_id,
+        generator_manifest["provenance"]["generator_image_id"],
+    )
+    report(
+        "generator image ID versus launcher producer path",
+        generator_image_id.removeprefix("sha256:"),
+        Path(resolution["generation_producer_sources"]).name,
+    )
+    report(
+        "pinned toolchain manifest",
+        generator_manifest["toolchain"],
+        lock,
+    )
+
+    inventory = inventory_verification(K_PROOF)
+    classified = validate_trust_boundary(K_PROOF, DISCOVERY)
+    discovery_document = load(DISCOVERY)
+    report(
+        "inventory rule IDs in source order",
+        [rule["source_rule_id"] for rule in inventory["rules"]],
+        [rule["source_rule_id"] for rule in discovery_document["rules"]],
+    )
+    report(
+        "inventory identities unique",
+        len({rule["source_rule_id"] for rule in inventory["rules"]}),
+        len(inventory["rules"]),
+    )
+    report(
+        "whole inventory hash",
+        inventory["inventory_sha256"],
+        discovery_document["inventory_sha256"],
+    )
+    report(
+        "input-manifest inventory hash",
+        input_manifest["inventory_sha256"],
+        inventory["inventory_sha256"],
+    )
+    report(
+        "generator inventory provenance",
+        generator_manifest["provenance"]["inventory_sha256"],
+        inventory["inventory_sha256"],
+    )
+    report(
+        "verification.k raw hash",
+        file_sha256(K_PROOF / "verification.k"),
+        input_manifest["verification_sha256"],
+    )
+    report(
+        "Stage 1 hash in input manifest",
+        input_manifest["stage1_workspace_sha256"],
+        hashes["stage1_export_sha256"],
+    )
+    report(
+        "frozen input hash in input manifest",
+        input_manifest["frozen_input_sha256"],
+        hashes["stage1_export_sha256"],
+    )
+    report(
+        "Stage 1 provenance in generator manifest",
+        generator_manifest["provenance"]["stage1_workspace_sha256"],
+        hashes["stage1_export_sha256"],
+    )
+    report(
+        "Stage 3 provenance in input manifest",
+        input_manifest["stage3_discovery_manifest_sha256"],
+        hashes["discovery_manifest_sha256"],
+    )
+    report(
+        "Stage 3 provenance in generator manifest",
+        generator_manifest["provenance"][
+            "stage3_discovery_manifest_sha256"
+        ],
+        hashes["discovery_manifest_sha256"],
+    )
+
+    report(
+        "Stage 3 definitions",
+        [rule["source_rule_id"] for rule in classified["definitions"]],
+        [
+            "rule-259271eac22df31da5442025e304bd2f6d2ba0dd1b9a82b0d0000ac062b8f3cd"
+        ],
+    )
+    report(
+        "Stage 3 operational rules",
+        [
+            rule["source_rule_id"]
+            for rule in classified["operational_rules"]
+        ],
+        [
+            "rule-565589a3e4823e29c1250cdf77d45455a605950437a4a7c40cbe97ef94b43c69"
+        ],
+    )
+    report("Stage 3 proved derived lemmas", classified["proved_derived_lemmas"], [])
+    report("Stage 3 domain lemmas", classified["domain_lemmas"], [])
+    report("input-manifest source rules", input_manifest["source_rules"], [])
+    report("obligation-map source rules", obligation_map["source_rules"], [])
+    report("obligation-map obligations", obligation_map["obligations"], [])
+    report("obligation-map trust parameters", obligation_map["trust_parameters"], [])
+    report(
+        "obligation-map file hash",
+        file_sha256(GENERATED / "obligation-map.json"),
+        generator_manifest["obligation_map_sha256"],
+    )
+    report("generator obligation count", generator_manifest["obligation_count"], 0)
+    report("export obligation count", export_result["obligation_count"], 0)
+    report("stored-preflight obligation count", stored_preflight["obligation_count"], 0)
+    report("launcher-preflight obligation count", resolution["stage4_preflight"]["obligation_count"], 0)
+    report("generator target", generator_manifest["target"], None)
+    report("stored-preflight target", stored_preflight["target"], None)
+    report("launcher target", resolution["target"], None)
+    report("launcher-preflight target", resolution["stage4_preflight"]["target"], None)
+    report("parsed generated target", klean_export.target_statement(GENERATED), None)
+    report("expected generated target", klean_export.expected_target_definition(obligation_map), None)
+    report("export status", export_result["status"], "KLEAN_NO_OBLIGATIONS")
+    report("stored-preflight status", stored_preflight["status"], "KLEAN_NO_OBLIGATIONS")
+    report(
+        "launcher selection status",
+        resolution["selections"]["klean_generation"]["status"],
+        "KLEAN_NO_OBLIGATIONS",
+    )
+    report(
+        "generated tree hash in generator manifest",
+        generator_manifest["generated_tree_sha256"],
+        hashes["generated_tree_sha256"],
+    )
+    report(
+        "generated tree hash in export result",
+        export_result["generated_tree_sha256"],
+        hashes["generated_tree_sha256"],
+    )
+    report(
+        "generated tree hash in stored preflight",
+        stored_preflight["generated_tree_sha256"],
+        hashes["generated_tree_sha256"],
+    )
+    report(
+        "trust-inventory file hash",
+        file_sha256(GENERATION / "trust-inventory.json"),
+        export_result["trust_inventory_sha256"],
+    )
+    report(
+        "stored preflight versus launcher preflight",
+        stored_preflight,
+        resolution["stage4_preflight"],
+    )
+    print("ALL STRUCTURAL AND HASH CHECKS PASSED")
+
+
+if __name__ == "__main__":
+    main()

