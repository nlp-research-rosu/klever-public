+        lock,
+    )
+
+    inventory = inventory_verification(K_PROOF)
+    classified = validate_trust_boundary(K_PROOF, DISCOVERY)
+    discovery_document = load(DISCOVERY)
+    report(
+        "inventory rule IDs in source order",
