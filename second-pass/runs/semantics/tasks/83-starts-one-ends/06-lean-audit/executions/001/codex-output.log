+    )
+    report("generator obligation count", generator_manifest["obligation_count"], 0)
+    report("export obligation count", export_result["obligation_count"], 0)
+    report("stored-preflight obligation count", stored_preflight["obligation_count"], 0)
+    report("launcher-preflight obligation count", resolution["stage4_preflight"]["obligation_count"], 0)
+    report("generator target", generator_manifest["target"], None)
+    report("stored-preflight target", stored_preflight["target"], None)
+    report("launcher target", resolution["target"], None)
+    report("launcher-preflight target", resolution["stage4_preflight"]["target"], None)
+    report("parsed generated target", klean_export.target_statement(GENERATED), None)
+    report("expected generated target", klean_export.expected_target_definition(obligation_map), None)
+    report("export status", export_result["status"], "KLEAN_NO_OBLIGATIONS")
+    report("stored-preflight status", stored_preflight["status"], "KLEAN_NO_OBLIGATIONS")
+    report(
