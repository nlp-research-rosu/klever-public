+    report("Lean workspace hash", hashes["lean_workspace_sha256"], None)
+    report("Lean invocation hash", hashes["lean_invocation_sha256"], None)
+
+    observed_source_hashes = {
+        path.relative_to(K_PROOF).as_posix(): file_sha256(path)
+        for path in sorted(K_PROOF.rglob("*"))
+        if path.is_file()
+    }
