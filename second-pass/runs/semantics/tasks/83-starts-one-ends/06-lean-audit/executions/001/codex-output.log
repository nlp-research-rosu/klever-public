+        hashes["generation_producer_sources_sha256"],
+    )
+    report("Lean workspace hash", hashes["lean_workspace_sha256"], None)
+    report("Lean invocation hash", hashes["lean_invocation_sha256"], None)
+
+    observed_source_hashes = {
+        path.relative_to(K_PROOF).as_posix(): file_sha256(path)
+        for path in sorted(K_PROOF.rglob("*"))
+        if path.is_file()
+    }
+    report(
+        "all Stage 1 source file hashes",
+        observed_source_hashes,
+        resolution["stage1_source_hashes"],
+    )
+
+    producer_manifest = load(PRODUCERS / "source-manifest.json")
+    generator_manifest = load(GENERATION / "generator-manifest.json")
+    input_manifest = load(GENERATION / "input-manifest.json")
