+        "KLEAN_NO_OBLIGATIONS",
+    )
+    report(
+        "generated tree hash in generator manifest",
+        generator_manifest["generated_tree_sha256"],
+        hashes["generated_tree_sha256"],
+    )
+    report(
+        "generated tree hash in export result",
+        export_result["generated_tree_sha256"],
+        hashes["generated_tree_sha256"],
+    )
+    report(
+        "generated tree hash in stored preflight",
+        stored_preflight["generated_tree_sha256"],
+        hashes["generated_tree_sha256"],
+    )
+    report(
+        "trust-inventory file hash",
+        file_sha256(GENERATION / "trust-inventory.json"),
+        export_result["trust_inventory_sha256"],
