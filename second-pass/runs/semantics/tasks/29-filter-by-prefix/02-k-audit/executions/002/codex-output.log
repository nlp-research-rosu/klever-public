+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      => ?FINALSC:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(vCons(str(iCons(97, .IntSeq)), .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a//tmp/audit-work/reconstruction/spec-labeled.k b//tmp/audit-work/reconstruction/spec-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..af656494bdbdd3f39ed05acf7acfd714cfbb3373
--- /dev/null
+++ b//tmp/audit-work/reconstruction/spec-labeled.k
@@ -0,0 +1,75 @@
+requires "verification.k"
+
+module FILTER-BY-PREFIX-SPEC-LABELED
+  imports VERIFICATION
+
+  // Byte-for-byte claim body from spec.k, with only a reviewer label added.
+  claim
+    <k>
+      #loop(
+        stringList(REST:StrList),
+        Name("string"),
+        If(
+          Call(Attribute(Name("string"), "startswith"), Name("prefix")),
+          Expr(Call(Attribute(Name("result"), "append"), Name("string"))),
+          .Stmts))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        "prefix" |-> str(PREFIX:IntSeq)
+        "result" |-> ref(H:Int)
+        "string" |-> CURRENT:Val
+        "strings" |-> stringList(ORIGINAL:StrList),
+        parent(0))
+      =>
+      SC
+      L |-> scope(
+        "prefix" |-> str(PREFIX)
+        "result" |-> ref(H)
+        "string" |-> ?FINALCURRENT:Val
+        "strings" |-> stringList(ORIGINAL),
+        parent(0))
+    </scopes>
+    <heap>
+      H |-> list(
+        ACC:ValSeq
+        => valSeqConcat(ACC, prefixFilter(PREFIX, REST)))
+    </heap>
+    [label(loop-invariant)]
+
+  // Byte-for-byte claim body from spec.k, with only a reviewer label added.
+  claim
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          filterByPrefixDef))
+      ~> Call(
+           Name("filter_by_prefix"),
+           stringList(INPUT:StrList),
+           str(PREFIX:IntSeq))
+      ~> #checkFilter(
+           prefixFilter(PREFIX, INPUT))
+      => true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      => ?FINALSC:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(prefixFilter(PREFIX, INPUT))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    [label(entry-correctness)]
+endmodule
