+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The exact translated function definition from solution.mpy.
+  syntax Stmt ::= "filterByPrefixDef" [macro]
+  rule filterByPrefixDef
+    => FuncDef(
+         "filter_by_prefix",
+         Params("strings", "prefix"),
+         Assign(Name("result"), ListExpr(.Exprs))
+         For(
+           Name("string"),
+           Name("strings"),
+           If(
+             Call(Attribute(Name("string"), "startswith"), Name("prefix")),
+             Expr(Call(Attribute(Name("result"), "append"), Name("string"))),
+             .Stmts))
+         Return(Name("result")))
+
+  // Mathematical result: retain exactly the strings satisfying startsWith.
+  syntax ValSeq ::= prefixFilter(IntSeq, ValSeq) [function]
+  rule prefixFilter(_:IntSeq, .ValSeq) => .ValSeq
+  rule prefixFilter(P:IntSeq, vCons(str(S:IntSeq), REST:ValSeq))
+    => vCons(str(S), prefixFilter(P, REST))
+    requires startsWith(P, S)
+  rule prefixFilter(P:IntSeq, vCons(str(S:IntSeq), REST:ValSeq))
+    => prefixFilter(P, REST)
+    requires notBool startsWith(P, S)
+
+  // The HumanEval input domain is a list whose elements are strings.
+  syntax Bool ::= stringsOnly(ValSeq) [function, total]
+  rule stringsOnly(.ValSeq) => true
+  rule stringsOnly(vCons(str(_:IntSeq), REST:ValSeq)) => stringsOnly(REST)
+  rule stringsOnly(_:ValSeq) => false [owise]
+
+  // Observe a returned heap list structurally, hiding its allocation address.
+  syntax KItem ::= #checkFilter(ValSeq)
+  rule <k> ref(H:Int) ~> #checkFilter(EXPECTED:ValSeq)
+        => (ACTUAL ==K EXPECTED) ... </k>
+       <heap> ... H |-> list(ACTUAL:ValSeq) ... </heap>
+endmodule
