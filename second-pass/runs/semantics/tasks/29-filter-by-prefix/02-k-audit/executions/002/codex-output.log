+          filterByPrefixDef))
+      ~> Call(
+           Name("filter_by_prefix"),
+           list(
+             vCons(str(iCons(97, .IntSeq)),
+               vCons(str(iCons(98, .IntSeq)), .ValSeq))),
+           str(iCons(97, .IntSeq)))
+      ~> #checkFilter(
+           vCons(str(iCons(97, .IntSeq)), .ValSeq))
+      => true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      => ?FINALSC:Map
