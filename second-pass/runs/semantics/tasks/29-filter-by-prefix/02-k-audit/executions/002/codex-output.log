+requires "verification.k"
+
+module FILTER-BY-PREFIX-REAL-LIST-GROUND
+  imports VERIFICATION
+
+  // Fixed-semantics bare-list input: no stringList iterator rule can match.
+  claim
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          filterByPrefixDef))
+      ~> Call(
+           Name("filter_by_prefix"),
+           list(
+             vCons(str(iCons(97, .IntSeq)),
+               vCons(str(iCons(98, .IntSeq)), .ValSeq))),
+           str(iCons(97, .IntSeq)))
+      ~> #checkFilter(
+           vCons(str(iCons(97, .IntSeq)), .ValSeq))
+      => true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      => ?FINALSC:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(vCons(str(iCons(97, .IntSeq)), .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a//tmp/audit-work/reconstruction/spec-real-list.k b//tmp/audit-work/reconstruction/spec-real-list.k
new file mode 100644
index 0000000000000000000000000000000000000000..4b33f1fb0d2ce74e0d8707b5702c7c16bc1fc6a0
