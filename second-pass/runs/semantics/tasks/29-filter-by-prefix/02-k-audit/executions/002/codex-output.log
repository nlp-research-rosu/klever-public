+requires "verification.k"
+
+module FILTER-BY-PREFIX-SPEC
+  imports VERIFICATION
+
+  // Loop invariant.  The list at H contains ACC, while processing REST must
+  // append prefixFilter(PREFIX, REST).  The call frame is then popped and the
+  // observational continuation checks that combined sequence.
+  claim
+    <k>
+      #loop(
+        list(REST:ValSeq),
+        Name("string"),
+        If(
+          Call(Attribute(Name("string"), "startswith"), Name("prefix")),
+          Expr(Call(Attribute(Name("result"), "append"), Name("string"))),
+          .Stmts))
+      ~> Return(Name("result"))
+      ~> #endcall
+      => true
+    </k>
+    <env> L:Int => 0 </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        FRAME:Map
+          [ "prefix" <- str(PREFIX:IntSeq) ]
+          [ "result" <- ref(H:Int) ],
+        PARENT:Parent)
+      => SC
+    </scopes>
+    <scopeLoc> _ => L </scopeLoc>
+    <heap> H |-> list(ACC:ValSeq) </heap>
+    <heapLoc> N:Int </heapLoc>
+    <stack>
+      ListItem(
+        frame(
+          #checkFilter(
+            valSeqConcat(
+              ACC,
+              prefixFilter(PREFIX, REST))),
+          0,
+          L))
+      => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires stringsOnly(REST)
+     andBool 0 <=Int L
+     andBool L <Int N
+
+  // End-to-end functional correctness for every finite list of strings and
+  // every finite prefix.  The target is Boolean true only when the returned
+  // heap list is exactly prefixFilter(PREFIX, INPUT).
+  claim
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          filterByPrefixDef))
+      ~> Call(
+           Name("filter_by_prefix"),
+           ListExpr(INPUT:Exprs),
+           Str(PREFIX:String))
+      ~> #checkFilter(
+           prefixFilter(
+             strToCodes(PREFIX),
+             vals2valSeq(INPUT)))
+      => true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires stringsOnly(vals2valSeq(INPUT))
+endmodule
