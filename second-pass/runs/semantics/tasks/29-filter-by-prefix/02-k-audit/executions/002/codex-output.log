]},"arity":1,"args":[{"node":"KToken","sort":{"node":"KSort","name":"String"},"token":"\"string\""}]},{"node":"KToken","sort":{"node":"KSort","name":"String"},"token":"\"startswith\""}]},{"node":"KApply","label":{"node":"KLabel","name":"_,__MPY-SYNTAX_Exprs_Expr_Exprs","params":[]},"arity":2,"args":[{"node":"KApply","label":{"node":"KLabel","name":"Name(_)_MPY-SYNTAX_Expr_String","params":[]},"arity":1,"args":[{"node":"KToken","sort":{"node":"KSort","name":"String"},"token":"\"prefix\""}]},{"node":"KApply","label":{"node":"KLabel","name":".List{\"_,__MPY-SYNTAX_Exprs_Expr_Exprs\"}_Exprs","params":[]},"arity":0,"args":[]}]}]},{"node":"KApply","label":{"node":"KLabel","name":"___MPY-SYNTAX_Stmts_Stmt_Stmts","params":[]},"arity":2,"args":[{"node":"KApply","label":{"node":"KLabel","name":"Expr(_)_MPY-SYNTAX_Stmt_Expr","params":[]},"arity":1,"args":[{"node":"KApply","label":{"node":"KLabel","name":"Call(_,_)_MPY-SYNTAX_Expr_Expr_Exprs","params":[]},"arity":2,"args":[{"node":"KApply","label":{"node":"KLabel","name":"Attribute(_,_)_MPY-SYNTAX_Expr_Expr_String","params":[]},"arity":2,"args":[{"node":"KApply","label":{"node":"KLabel","name":"Name(_)_MPY-SYNTAX_Expr_String","params":[]},"arity":1,"args":[{"node":"KToken","sort":{"node":"KSort","name":"String"},"token":"\"result\""}]},{"node":"KToken","sort":{"node":"KSort","name":"String"},"token":"\"append\""}]},{"node":"KApply","label":{"node":"KLabel","name":"_,__MPY-SYNTAX_Exprs_Expr_Exprs","params":[]},"arity":2,"args":[{"node":"KApply","label":{"node":"KLabel","name":"Name(_)_MPY-SYNTAX_Expr_String","params":[]},"arity":1,"args":[{"node":"KToken","sort":{"node":"KSort","name":"String"},"token":"\"string\""}]},{"node":"KApply","label":{"node":"KLabel","name":".List{\"_,__MPY-SYNTAX_Exprs_Expr_Exprs\"}_Exprs","params":[]},"arity":0,"args":[]}]}]}]},{"node":"KApply","label":{"node":"KLabel","name":".List{\"___MPY-SYNTAX_Stmts_Stmt_Stmts\"}_Stmts","params":[]},"arity":0,"args":[]}]},{"node":"KApply","label":{"node":"KLabel"