diff --git a//tmp/audit-work/reconstruction/executed-module.mpy b//tmp/audit-work/reconstruction/executed-module.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..d08c84b6e3a02f247be14cfc1d195e822a4b9454
--- /dev/null
+++ b//tmp/audit-work/reconstruction/executed-module.mpy
@@ -0,0 +1,15 @@
+Module(
+  ImportFrom("typing", "List")
+  FuncDef(
+    "filter_by_prefix",
+    Params("strings", "prefix"),
+    Assign(Name("result"), ListExpr())
+    Assign(Name("string"), Str(""))
+    For(
+      Name("string"),
+      Name("strings"),
+      If(
+        Call(Attribute(Name("string"), "startswith"), Name("prefix")),
+        Expr(Call(Attribute(Name("result"), "append"), Name("string"))),
+        ))
+    Return(Name("result"))))
