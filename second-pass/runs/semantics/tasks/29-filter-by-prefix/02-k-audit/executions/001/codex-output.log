+if (( rc == 0 )); then
+  printf '%s\n' 'UNEXPECTED: wrong body proved the original result/heap obligation.'
+  status=1
+else
+  printf '%s\n' 'EXPECTED: wrong body was rejected.'
+fi
+printf '\n'
+
+printf 'SCRIPT_EXIT: %d\n' "$status"
+exit "$status"
