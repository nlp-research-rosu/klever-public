+  --definition verification-kompiled \
+  --spec-module FILTER-BY-PREFIX-ENTRY-WITH-PROVEN-LOOP-SPEC
+rc=$?
+printf 'EXIT: %d\n\n' "$rc"
+(( rc == 0 )) || status=1
+
+printf 'SCRIPT_EXIT: %d\n' "$status"
+exit "$status"
