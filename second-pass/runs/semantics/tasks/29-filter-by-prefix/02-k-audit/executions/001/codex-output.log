    56	           str(PREFIX:IntSeq))
    57	      ~> #checkFilter(
    58	           prefixFilter(PREFIX, INPUT))
    59	      => true
    60	    </k>
    61	    <env> 0 </env>
    62	    <scopes>
    63	      0 |-> scope(.Map, parent(-1))
    64	      -1 |-> builtinsScope
    65	      => ?FINALSC:Map
    66	    </scopes>
    67	    <scopeLoc> 1 </scopeLoc>
    68	    <heap>
    69	      .Map
    70	      => 0 |-> list(prefixFilter(PREFIX, INPUT))
    71	    </heap>
    72	    <heapLoc> 0 => 1 </heapLoc>
    73	    <stack> .List </stack>
    74	    <ret> noRet </ret>
    75	    <exc> NoExc </exc>
    76	endmodule
--- verification.k ---
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // The exact translated function definition from solution.mpy.
     7	  syntax Stmt ::= "filterByPrefixDef" [macro]
     8	  rule filterByPrefixDef
     9	    => FuncDef(
    10	         "filter_by_prefix",
    11	         Params("strings", "prefix"),
    12	         Assign(Name("result"), ListExpr(.Exprs))
    13	         Assign(Name("string"), Str(""))
    14	         For(
    15	           Name("string"),
    16	           Name("strings"),
    17	           If(
    18	             Call(Attribute(Name("string"), "startswith"), Name("prefix")),
    19	             Expr(Call(Attribute(Name("result"), "append"), Name("string"))),
    20	             .Stmts))
    21	         Return(Name("result")))
    22	
    23	  // A typed, list-isomorphic proof value.  Its iterator emits exactly the
    24	  // same string values, in the same order, as a Python list of strings.
    25	  syntax StrList ::= ".StrList" [constructor]
    26	                   | sCons(IntSeq, StrList) [constructor]
    27	  syntax Iterable ::= stringList(StrList)
    28	  rule <k> #iterNext(stringList(.StrList)) => #iterDone ... </k>
    29	  rule <k> #iterNext(stringList(sCons(S:IntSeq, REST:StrList)))
    30	        => #iterYield(str(S), stringList(REST)) ... </k>
    31	
    32	  // Mathematical result: retain exactly the strings satisfying startsWith.
    33	  syntax ValSeq ::= prefixFilter(IntSeq, StrList) [function, total]
    34	  rule prefixFilter(_:IntSeq, .StrList) => .ValSeq
    35	    [simplification]
    36	  rule prefixFilter(P:IntSeq, sCons(S:IntSeq, REST:StrList))
    37	    => vCons(str(S), prefixFilter(P, REST))
    38	    requires startsWith(P, S) ==Bool true
    39	    [simplification]
    40	  rule prefixFilter(P:IntSeq, sCons(S:IntSeq, REST:StrList))
    41	    => prefixFilter(P, REST)
    42	    requires startsWith(P, S) ==Bool false
    43	    [simplification]
    44	
    45	  // Derived list lemma needed when ACC is symbolic (right identity).
    46	  rule valSeqConcat(VS:ValSeq, .ValSeq) => VS [simplification]
    47	  // Derived associativity lemma normalizes accumulator appends to the right.
    48	  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
    49	    => valSeqConcat(A, valSeqConcat(B, C))
    50	    [simplification]
    51	
    52	  // Observe a returned heap list structurally, hiding its allocation address.
    53	  syntax KItem ::= #checkFilter(ValSeq)
    54	  rule <k> ref(H:Int) ~> #checkFilter(EXPECTED:ValSeq)
    55	        => (ACTUAL ==K EXPECTED) ... </k>
    56	       <heap> ... H |-> list(ACTUAL:ValSeq) ... </heap>
    57	endmodule
--- prove.sh ---
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	python3 py2mpy.py solution.py > solution.mpy
     5	python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
     6	
