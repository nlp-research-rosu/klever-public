+rg -n "function|functional|total|simplification|priority|owise|macro|trusted" \
+  /audit-output/evidence/rule_inventory.md
+rc=$?
+printf 'EXIT: %d\n\n' "$rc"
+(( rc == 0 )) || status=1
+
+printf 'SCRIPT_EXIT: %d\n' "$status"
+exit "$status"
