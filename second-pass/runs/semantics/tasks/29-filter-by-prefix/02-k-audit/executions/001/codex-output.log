    22	
    23	kprove spec.k \
    24	  --definition verification-kompiled \
    25	  --spec-module FILTER-BY-PREFIX-SPEC
--- concrete-tests.py ---
     1	from typing import List
     2	
     3	
     4	def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:
     5	    result = []
     6	    string = ""
     7	    for string in strings:
     8	        if string.startswith(prefix):
     9	            result.append(string)
    10	    return result
    11	
    12	
    13	assert filter_by_prefix([], "a") == []
    14	assert filter_by_prefix(["abc", "bcd", "cde", "array"], "a") == ["abc", "array"]
    15	assert filter_by_prefix(["", "a", "ab"], "") == ["", "a", "ab"]
    16	assert filter_by_prefix(["a", "aa", "ba"], "aa") == ["aa"]
