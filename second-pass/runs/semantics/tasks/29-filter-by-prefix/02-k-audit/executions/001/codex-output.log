+
+for name in verification-body-mutation.k spec-body-mutation.k; do
+  printf 'COMMAND: cp /audit-output/evidence/%s /tmp/audit-work/29-filter-by-prefix/candidate-src/%s\n' "$name" "$name"
+  cp "$evidence/$name" "$scratch/$name"
