new file mode 100644
index 0000000000000000000000000000000000000000..24e295b4c95229256c053467468a1228c025c823
--- /dev/null
+++ b/evidence/spec-body-mutation.k
@@ -0,0 +1,71 @@
+requires "verification-body-mutation.k"
+
+module FILTER-BY-PREFIX-BODY-MUTATION-SPEC
+  imports VERIFICATION-BODY-MUTATION
+
+  claim
+    <k>
+      #loop(
+        stringList(REST:StrList),
+        Name("string"),
+        If(
+          Call(Attribute(Name("string"), "startswith"), Name("prefix")),
+          Expr(Call(Attribute(Name("result"), "append"), Name("string"))),
+          .Stmts))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        "prefix" |-> str(PREFIX:IntSeq)
+        "result" |-> ref(H:Int)
+        "string" |-> CURRENT:Val
+        "strings" |-> stringList(ORIGINAL:StrList),
+        parent(0))
+      =>
+      SC
+      L |-> scope(
+        "prefix" |-> str(PREFIX)
+        "result" |-> ref(H)
+        "string" |-> ?FINALCURRENT:Val
+        "strings" |-> stringList(ORIGINAL),
+        parent(0))
+    </scopes>
+    <heap>
+      H |-> list(
+        ACC:ValSeq
+        => valSeqConcat(ACC, prefixFilter(PREFIX, REST)))
+    </heap>
+
+  claim
+    <k>
+      #loadAll(
+        Module(
+          ImportFrom("typing", "List")
+          filterByPrefixDefMutated))
+      ~> Call(
+           Name("filter_by_prefix"),
+           stringList(INPUT:StrList),
+           str(PREFIX:IntSeq))
+      ~> #checkFilter(
+           prefixFilter(PREFIX, INPUT))
+      => true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      => ?FINALSC:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(prefixFilter(PREFIX, INPUT))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
