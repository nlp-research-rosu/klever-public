Module(
  ImportFrom("typing", "List")
  FuncDef("filter_by_prefix", Params("strings", "prefix"),
    Assign(Name("result"), ListExpr())
    Assign(Name("string"), Str(""))
    For(Name("string"), Name("strings"),
      If(Call(Attribute(Name("string"), "startswith"), Name("prefix")),
        Expr(Call(Attribute(Name("result"), "append"), Name("string"))),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("filter_by_prefix"), ListExpr(), Str("a")),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("filter_by_prefix"),
        ListExpr(Str("abc"), Str("bcd"), Str("cde"), Str("array")),
        Str("a")),
      CmpOp("==", ListExpr(Str("abc"), Str("array")))))
  Assert(
    Compare(
      Call(
        Name("filter_by_prefix"),
        ListExpr(Str(""), Str("a"), Str("ab")),
        Str("")),
      CmpOp("==", ListExpr(Str(""), Str("a"), Str("ab")))))
  Assert(
    Compare(
      Call(
        Name("filter_by_prefix"),
        ListExpr(Str("a"), Str("aa"), Str("ba")),
        Str("aa")),
      CmpOp("==", ListExpr(Str("aa"))))))
