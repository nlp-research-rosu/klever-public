    let go (res : Nat×Nat) (b : UInt8) : Nat×Nat :=
      -- `place` is `res.1`
      -- `acc` is `res.2`
      let place := res.1 * 0x100
      let acc := res.2 + res.1 * b.toNat
      ⟨place, acc⟩
    List.foldl go (1, 0) littleEndian

