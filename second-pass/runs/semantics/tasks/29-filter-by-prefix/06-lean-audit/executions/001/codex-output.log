    20	  rule valSeqConcat(vCons(V:Val, S:ValSeq), T:ValSeq) => vCons(V, valSeqConcat(S, T))
    21	
    22	  // list + list constructs a NEW object (k-cell — it allocates; operands land here
    23	  // already deref'd). priority(45) beats the generic BinOp dispatch.
    24	  rule <k> BinOp("+", list(A:ValSeq), list(B:ValSeq)) => #alloc(list(valSeqConcat(A, B))) ... </k>
    25	       [priority(45)]
    26	
    27	  rule applyCmp("==", list(A:ValSeq), list(B:ValSeq)) => A ==K B
    28	  rule applyCmp("!=", list(A:ValSeq), list(B:ValSeq)) => notBool (A ==K B)
    29	
    30	  // ==== deep equality when elements are heap objects (list-of-lists) ========
    31	  // Python == is structural at every depth. Fires ONLY when a ref is present
    32	  // (the guard decides on concrete seqs); the plain ==K path above is unchanged.
    33	  syntax Bool ::= hasRefVS(ValSeq) [function, total]
    34	  rule hasRefVS(.ValSeq)                => false
    35	  rule hasRefVS(vCons(V:Val, R:ValSeq)) => isRefV(V) orBool hasRefVS(R)
    36	
    37	  syntax Bool ::= deepEqVS(ValSeq, ValSeq, Map) [function]
    38	                | deepEqV(Val, Val, Map)        [function]
    39	  rule deepEqVS(.ValSeq, .ValSeq, _:Map)                   => true
    40	  rule deepEqVS(.ValSeq, vCons(_:Val, _:ValSeq), _:Map)    => false
    41	  rule deepEqVS(vCons(_:Val, _:ValSeq), .ValSeq, _:Map)    => false
    42	  rule deepEqVS(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq), HP:Map)
    43	    => deepEqV(A, B, HP) andBool deepEqVS(As, Bs, HP)
    44	
    45	  rule deepEqV(ref(H:Int), B:Val, HP:Map) => deepEqV({HP[H]}:>Val, B, HP)
    46	       requires H in_keys(HP)
    47	  rule deepEqV(A:Val, ref(H:Int), HP:Map) => deepEqV(A, {HP[H]}:>Val, HP)
    48	       requires notBool isRefV(A) andBool H in_keys(HP)
    49	  rule deepEqV(list(A:ValSeq), list(B:ValSeq), HP:Map) => deepEqVS(A, B, HP)
    50	  rule deepEqV(A:Val, B:Val, _:Map) => A ==K B [owise]
    51	
    52	  // ==== mutator: xs.append(v) — an in-place heap write ======================
    53	  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), "append")), (V:Val, .Vals)) => noneV ... </k>
    54	       <heap> ... H |-> list(VS:ValSeq => valSeqConcat(VS, vCons(V, .ValSeq))) ... </heap>
    55	       [priority(40)]
    56	
    57	  // ==== `x in list` — a <k>-cell fold over #iterNext ========================
    58	  syntax KItem ::= #memberAcc(Val, Iterable) | #memberCont(Val) | "#notB"
    59	  rule <k> Compare(LV:Val, CmpOp("in",     list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ... </k>
    60	  rule <k> Compare(LV:Val, CmpOp("not in", list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ~> #notB ... </k>
    61	  rule <k> #memberAcc(V:Val, IT:Iterable) => #iterNext(IT) ~> #memberCont(V) ... </k>
    62	  rule <k> #iterDone ~> #memberCont(_V:Val) => false ... </k>
    63	  rule <k> #iterYield(E:Val, _:Iterable) ~> #memberCont(V:Val) => true ... </k>
    64	       requires E ==K V
    65	  rule <k> #iterYield(E:Val, R:Iterable) ~> #memberCont(V:Val) => #memberAcc(V, R) ... </k>
    66	       requires notBool (E ==K V)
    67	  rule <k> B:Bool ~> #notB => notBool B ... </k>
    68	endmodule

  // ==== Expr statement: evaluate for effect, discard the value ===============
  // (bare calls — mutator methods, docstrings; the WP0 statement-trivia rung)
  rule <k> Expr(_:Val) => .K ... </k>

  // ==== If (condition evaluated by strictness) ==============================
  syntax KItem ::= #branch(Bool, Stmts, Stmts)
  rule <k> If(C:Val, T:Stmts, E:Stmts) => #branch(truthy(C), T, E) ... </k>
  rule <k> #branch(true,  T:Stmts, _:Stmts) => T ... </k>
  rule <k> #branch(false, _:Stmts, E:Stmts) => E ... </k>

  // ==== IfExp: ternary T if C else E ========================================
  rule <k> IfExp(V:Val, T:Expr, _:Expr) => T ... </k>
       requires truthy(V)
  rule <k> IfExp(V:Val, _:Expr, E:Expr) => E ... </k>
       requires notBool truthy(V)

  // ==== For: one loop, in-cell continuation, over #iterNext =================
  // (the iterable is evaluated once, by strictness; the protocol stays rewrites —
  // circularities anchor on #loop and narrowing substitutes the structure)
  syntax KItem ::= #loop(Val, Expr, Stmts) | #loopStep(Expr, Stmts)
                 | #while(Expr, Stmts) | #whileCond(Expr, Stmts)
                 | #loopLbl(K) | "#cont" | "#brk"

  rule <k> For(T:Expr, OBJ:Val, B:Stmts) => #loop(OBJ, T, B) ... </k>

  rule <k> #loop(IT:Iterable, T:Expr, B:Stmts) => #iterNext(IT) ~> #loopStep(T, B) ... </k>
  rule <k> #iterDone ~> #loopStep(_:Expr, _:Stmts) => .K ... </k>
  rule <k> #iterYield(V:Val, REST:Iterable) ~> #loopStep(T:Expr, B:Stmts)
        => #bindTgt(T, V) ~> B ~> #loopLbl(#loop(REST, T, B)) ... </k>

  // ==== While ==============================================================
  rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>
  rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>
  rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>
       requires truthy(V)
  rule <k> V:Val ~> #whileCond(_C:Expr, _B:Stmts) => .K ... </k>
       requires notBool truthy(V)

  // ==== loop control (break / continue) =====================================
  rule <k> #loopLbl(NEXT:K) => NEXT ... </k>
  rule <k> Continue => #cont ... </k>
  rule <k> Break => #brk ... </k>
  rule <k> #cont ~> #loopLbl(NEXT:K) => NEXT ... </k>
  rule <k> #cont ~> (_:KItem => .K) ... </k> [owise]
  rule <k> #brk ~> #loopLbl(_:K) => .K ... </k>
  rule <k> #brk ~> (_:KItem => .K) ... </k> [owise]

  // ==== heap-object deref at the truthiness/iteration consumers ==============
  // (priority(40) preempts the generic Val rules so truthy/#loop never see a ref)
  rule <k> If(ref(H:Int), T:Stmts, E:Stmts) => If(V, T, E) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]
  rule <k> IfExp(ref(H:Int), T:Expr, E:Expr) => IfExp(V, T, E) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]
  rule <k> ref(H:Int) ~> #whileCond(C:Expr, B:Stmts) => V ~> #whileCond(C, B) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]
  // For derefs its iterable ONCE at loop start (iteration is over the snapshot;
  // mutating the iterated list inside its own loop is outside the subset)
  rule <k> For(T:Expr, ref(H:Int), B:Stmts) => For(T, V, B) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]
endmodule
  rule trimWS(iCons(C:Int, R:IntSeq)) => trimWS(R) requires isWSC(C)
  rule trimWS(iCons(C:Int, R:IntSeq)) => iCons(C, R) requires notBool isWSC(C)
  syntax IntSeq ::= revIS(IntSeq) [function, total] | revISAcc(IntSeq, IntSeq) [function, total]
  rule revIS(S:IntSeq) => revISAcc(S, .IntSeq)
  rule revISAcc(.IntSeq, A:IntSeq) => A
  rule revISAcc(iCons(C:Int, R:IntSeq), A:IntSeq) => revISAcc(R, iCons(C, A))

  // S.encode('ascii'): identity on the code-sequence model (bytes == codes)
  rule applyMethod(str(CS:IntSeq), "encode", str(_:IntSeq), .Vals) => str(CS)

  // ==== prefix ===============================================================
  rule applyMethod(str(XC:IntSeq), "startswith", str(PC:IntSeq), .Vals) => startsWith(PC, XC)

  // ==== list.count(v) — number of occurrences of v in the list (concrete for krun) ==========
  rule applyMethod(list(VS:ValSeq), "count", V:Val, .Vals) => cntOccVS(VS, V)
  syntax Int ::= cntOccVS(ValSeq, Val) [function, total]
  rule cntOccVS(.ValSeq, _:Val)                => 0
  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => 1 +Int cntOccVS(R, V) requires A ==K V
  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => cntOccVS(R, V)        requires notBool (A ==K V)

  // ==== split (no-arg: on whitespace runs, dropping empty tokens) + replace (single char) ==========
  // Concrete string ops for krun. A proof over a symbolic string intercepts the split problem-locally.
  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), .Vals)
        => #alloc(list(splitWS(CS, .IntSeq, .ValSeq))) ... </k>
       [priority(40)]
  syntax ValSeq ::= splitWS(IntSeq, IntSeq, ValSeq) [function]  // remaining, current token, result
  rule splitWS(.IntSeq, CUR:IntSeq, ACC:ValSeq) => flushTok(ACC, CUR)
  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, .IntSeq, flushTok(ACC, CUR))
       requires isWSC(C)
  rule splitWS(iCons(C:Int, R:IntSeq), CUR:IntSeq, ACC:ValSeq) => splitWS(R, seqConcat(CUR, iCons(C, .IntSeq)), ACC)
       requires notBool isWSC(C)
  // flush the current token to the result list iff non-empty.
  syntax ValSeq ::= flushTok(ValSeq, IntSeq) [function]
  rule flushTok(ACC:ValSeq, .IntSeq)            => ACC
  rule flushTok(ACC:ValSeq, iCons(C:Int, T:IntSeq)) => valSeqConcat(ACC, vCons(str(iCons(C, T)), .ValSeq))
  syntax Bool ::= isWSC(Int) [function, total]
  rule isWSC(C:Int) => C ==Int 32 orBool C ==Int 9 orBool C ==Int 10 orBool C ==Int 13

  // split(sep='x') keyword form delegates to the positional k-cell rule
  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), (kwV("sep", str(S:IntSeq)), .Vals))
        => #applyK(toCall(boundMethodV(str(CS), "split")), (str(S), .Vals)) ... </k>
       [priority(39)]

  // str.split(sep) — single-char separator, KEEPING empty parts (Python's sep-split; len == #sep + 1).
  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), (str(iCons(SEP:Int, .IntSeq)), .Vals))
        => #alloc(list(splitSep(CS, SEP, .IntSeq))) ... </k>
       [priority(40)]
  syntax ValSeq ::= splitSep(IntSeq, Int, IntSeq) [function]  // remaining, sep code, current token
  rule splitSep(.IntSeq, _SEP:Int, CUR:IntSeq)              => vCons(str(CUR), .ValSeq)
  rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => vCons(str(CUR), splitSep(R, SEP, .IntSeq))
       requires C ==Int SEP
  rule splitSep(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq) => splitSep(R, SEP, seqConcat(CUR, iCons(C, .IntSeq)))
       requires notBool (C ==Int SEP)

  rule applyMethod(str(CS:IntSeq), "replace", str(iCons(A:Int, .IntSeq)), str(iCons(B:Int, .IntSeq)), .Vals)
    => str(replaceC(CS, A, B))
  syntax IntSeq ::= replaceC(IntSeq, Int, Int) [function, total]
  rule replaceC(.IntSeq, _:Int, _:Int)             => .IntSeq
  rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(B, replaceC(R, A, B)) requires C ==Int A
  rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(C, replaceC(R, A, B)) requires notBool (C ==Int A)

  // ==== char helpers =========================================================
  syntax Bool ::= isUpperC(Int) [function, total]
  rule isUpperC(C:Int) => C >=Int 65 andBool C <=Int 90

  syntax Bool ::= isLowerC(Int) [function, total]
  rule isLowerC(C:Int) => C >=Int 97 andBool C <=Int 122

  syntax Bool ::= isAlphaC(Int) [function, total]
  rule isAlphaC(C:Int) => isUpperC(C) orBool isLowerC(C)

  syntax Bool ::= isDigitC(Int) [function, total]
  rule isDigitC(C:Int) => C >=Int 48 andBool C <=Int 57

  syntax Bool ::= hasUpper(IntSeq) [function, total]
  rule hasUpper(.IntSeq) => false
  rule hasUpper(iCons(C:Int, S:IntSeq)) => isUpperC(C) orBool hasUpper(S)

  syntax Bool ::= hasLower(IntSeq) [function, total]
  rule hasLower(.IntSeq) => false
  rule hasLower(iCons(C:Int, S:IntSeq)) => isLowerC(C) orBool hasLower(S)

  syntax Bool ::= allAlpha(IntSeq) [function, total]
  rule allAlpha(.IntSeq) => true
  rule allAlpha(iCons(C:Int, S:IntSeq)) => isAlphaC(C) andBool allAlpha(S)

  syntax Bool ::= allDigit(IntSeq) [function, total]
  rule allDigit(.IntSeq) => true
  rule allDigit(iCons(C:Int, S:IntSeq)) => isDigitC(C) andBool allDigit(S)

  syntax Int ::= lowerC(Int) [function, total]

  rule lowerC(C:Int) => C +Int 32 requires isUpperC(C)
  rule lowerC(C:Int) => C         [owise]

  syntax Int ::= upperC(Int) [function, total]
  rule upperC(C:Int) => C -Int 32 requires isLowerC(C)
  rule upperC(C:Int) => C         [owise]

  syntax Int ::= swapC(Int) [function, total]
  rule swapC(C:Int) => C +Int 32 requires isUpperC(C)
  rule swapC(C:Int) => C -Int 32 requires isLowerC(C)
  rule swapC(C:Int) => C         [owise]

  syntax IntSeq ::= mapLower(IntSeq) [function, total]
  rule mapLower(.IntSeq) => .IntSeq
  rule mapLower(iCons(C:Int, S:IntSeq)) => iCons(lowerC(C), mapLower(S))

  syntax IntSeq ::= mapUpper(IntSeq) [function, total]
  rule mapUpper(.IntSeq) => .IntSeq
  rule mapUpper(iCons(C:Int, S:IntSeq)) => iCons(upperC(C), mapUpper(S))

  syntax IntSeq ::= mapSwap(IntSeq) [function, total]
  rule mapSwap(.IntSeq) => .IntSeq
  rule mapSwap(iCons(C:Int, S:IntSeq)) => iCons(swapC(C), mapSwap(S))

  syntax Bool ::= startsWith(IntSeq, IntSeq) [function, total]
  rule startsWith(.IntSeq, _:IntSeq)               => true
  rule startsWith(iCons(_:Int, _:IntSeq), .IntSeq) => false
  rule startsWith(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool startsWith(As, Bs)
endmodule

diff --git a/evidence/check_producer_provenance.py b/evidence/check_producer_provenance.py
new file mode 100644
index 0000000000000000000000000000000000000000..19c125e4ca61e35e36636f5ea609c76ec47e8367
--- /dev/null
+++ b/evidence/check_producer_provenance.py
@@ -0,0 +1,86 @@
+#!/usr/bin/env python3
+import hashlib
+import json
+from pathlib import Path
+
+from tools import pipeline_contract
+
+
+audit = json.loads(Path("/audit-input.json").read_text())["resolution"]
+generator = json.loads(
+    Path("/reference/klean-generation/generator-manifest.json").read_text()
+)
+source = json.loads(
+    Path("/reference/generation-tools/source-manifest.json").read_text()
+)
+bundle = Path("/reference/generation-tools")
+
+
+def sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+exporter = sha256(bundle / "klean_export.py")
+klean = sha256(bundle / "klean.py")
+generator_image_id = generator["provenance"]["generator_image_id"]
+source_image_id = source["generator_image_id"]
+audit_bundle_component = Path(
+    audit["generation_producer_sources"]
+).name
+expected_files = {
+    "klean_export.py": generator["exporter_sha256"],
+    "klean.py": generator["klean_py_sha256"],
+}
+
+print(
+    json.dumps(
+        {
+            "bundle_entries": sorted(
+                path.relative_to(bundle).as_posix()
+                for path in bundle.iterdir()
+            ),
+            "bundle_tree_sha256": {
+                "observed": pipeline_contract.sha256_tree(bundle),
+                "expected": audit["hashes"][
+                    "generation_producer_sources_sha256"
+                ],
+            },
+            "generator_image_id": {
+                "generator_manifest": generator_image_id,
+                "source_manifest": source_image_id,
+                "audit_input_path_component": audit_bundle_component,
+                "all_match": (
+                    generator_image_id == source_image_id
+                    and generator_image_id.removeprefix("sha256:")
+                    == audit_bundle_component
+                ),
+            },
+            "producer_files": {
+                "klean_export.py": {
+                    "observed": exporter,
+                    "generator_manifest": generator["exporter_sha256"],
+                    "source_manifest": source["files"]["klean_export.py"],
+                    "all_match": (
+                        exporter
+                        == generator["exporter_sha256"]
+                        == source["files"]["klean_export.py"]
+                    ),
+                },
+                "klean.py": {
+                    "observed": klean,
+                    "generator_manifest": generator["klean_py_sha256"],
+                    "source_manifest": source["files"]["klean.py"],
+                    "all_match": (
+                        klean
+                        == generator["klean_py_sha256"]
+                        == source["files"]["klean.py"]
+                    ),
+                },
+            },
+            "source_manifest_exact_file_map": source["files"]
+            == expected_files,
+        },
+        indent=2,
+        sort_keys=True,
+    )
+)
diff --git a/evidence/check_recorded_hashes.py b/evidence/check_recorded_hashes.py
new file mode 100644
index 0000000000000000000000000000000000000000..7885b65b97d53b84efe07b4115d959c389970e2b
--- /dev/null
+++ b/evidence/check_recorded_hashes.py
@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+import hashlib
+import json
+from pathlib import Path
+
+from tools import klean_export, pipeline_contract
+from tools.klean_audit_contract import verify_stage6_audit_input
+
+
+audit_path = Path("/audit-input.json")
+audit = json.loads(audit_path.read_text())
+resolution = audit["resolution"]
+expected = resolution["hashes"]
+
+
+def file_sha256(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+observed = {
+    "k_workspace_sha256": pipeline_contract.sha256_tree(
+        Path("/reference/k-proof")
+    ),
+    "stage1_export_sha256": klean_export.tree_digest(
+        Path("/reference/k-proof")
+    ),
+    "discovery_manifest_sha256": file_sha256(
+        Path("/reference/lemma-discovery.json")
+    ),
+    "k_audit_sha256": pipeline_contract.sha256_tree(
+        Path("/reference/k-audit")
+    ),
+    "klean_generation_sha256": pipeline_contract.sha256_tree(
+        Path("/reference/klean-generation")
+    ),
+    "generation_producer_sources_sha256": pipeline_contract.sha256_tree(
+        Path("/reference/generation-tools")
+    ),
+    "generated_tree_sha256": klean_export.tree_digest(
+        Path("/reference/klean-generation/generated")
+    ),
+    "lean_workspace_sha256": pipeline_contract.sha256_tree(
+        Path("/candidate")
+    ),
+}
+
+source_expected = resolution["stage1_source_hashes"]
+source_observed = {
+    relative: file_sha256(Path("/reference/k-proof") / relative)
+    for relative in source_expected
+}
+
+verified_resolution, verified_digest = verify_stage6_audit_input(audit)
+print(
+    json.dumps(
+        {
+            "audit_input_contract": {
+                "verified_digest": verified_digest,
+                "recorded_digest": audit["resolved_input_sha256"],
+                "match": verified_digest == audit["resolved_input_sha256"],
+                "verified_mode": verified_resolution["mode"],
+            },
+            "mounted_hashes": {
+                key: {
+                    "expected": expected[key],
+                    "observed": value,
+                    "match": expected[key] == value,
+                }
+                for key, value in observed.items()
+            },
+            "stage1_source_hashes": {
+                relative: {
+                    "expected": source_expected[relative],
+                    "observed": source_observed[relative],
+                    "match": source_expected[relative]
+                    == source_observed[relative],
+                }
+                for relative in source_expected
+            },
+            "unmounted_recorded_hashes_not_used_as_evidence": {
+                "lean_invocation_sha256": expected["lean_invocation_sha256"],
+            },
+        },
+        indent=2,
+        sort_keys=True,
+    )
+)
diff --git a/evidence/reconstruct_inventory.py b/evidence/reconstruct_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..0ca787cf236fbb4aa314deccf8c9861be33779be
--- /dev/null
+++ b/evidence/reconstruct_inventory.py
@@ -0,0 +1,68 @@
+#!/usr/bin/env python3
+import json
+from pathlib import Path
+
+from tools.k_rule_inventory import inventory_verification
+from tools.lemma_discovery_contract import validate_trust_boundary
+
+
+workspace = Path("/reference/k-proof")
+manifest_path = Path("/reference/lemma-discovery.json")
+inventory = inventory_verification(workspace)
+manifest = json.loads(manifest_path.read_text())
+validated = validate_trust_boundary(workspace, manifest_path)
+
+canonical_ids = [rule["source_rule_id"] for rule in inventory["rules"]]
+classified_ids = [rule["source_rule_id"] for rule in manifest["rules"]]
+classification_by_id = {
+    rule["source_rule_id"]: {
+        "classification": rule["classification"],
+        "rationale": rule["rationale"],
+    }
+    for rule in manifest["rules"]
+}
+
+comparison = {
+    "canonical_rule_count": len(canonical_ids),
+    "classified_rule_count": len(classified_ids),
+    "duplicate_classified_ids": sorted(
+        source_rule_id
+        for source_rule_id in set(classified_ids)
+        if classified_ids.count(source_rule_id) > 1
+    ),
+    "extra_classified_ids": sorted(set(classified_ids) - set(canonical_ids)),
+    "missing_classified_ids": sorted(set(canonical_ids) - set(classified_ids)),
+    "ordered_identities_match": classified_ids == canonical_ids,
+    "manifest_inventory_hash_matches": (
+        manifest["inventory_sha256"] == inventory["inventory_sha256"]
+    ),
+    "validated_definition_ids": [
+        rule["source_rule_id"] for rule in validated["definitions"]
+    ],
+    "validated_operational_rule_ids": [
+        rule["source_rule_id"] for rule in validated["operational_rules"]
+    ],
+    "validated_proved_derived_lemma_ids": [
+        rule["source_rule_id"] for rule in validated["proved_derived_lemmas"]
+    ],
+    "validated_domain_lemma_ids": [
+        rule["source_rule_id"] for rule in validated["domain_lemmas"]
+    ],
+}
+
+classified_inventory = [
+    {**rule, **classification_by_id[rule["source_rule_id"]]}
+    for rule in inventory["rules"]
+]
+
+print(
+    json.dumps(
+        {
+            "comparison": comparison,
+            "inventory": inventory,
