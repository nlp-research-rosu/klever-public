/reference/k-proof/verification.k-23-  // A typed, list-isomorphic proof value.  Its iterator emits exactly the
/reference/k-proof/verification.k-24-  // same string values, in the same order, as a Python list of strings.
/reference/k-proof/verification.k-25-  syntax StrList ::= ".StrList" [constructor]
/reference/k-proof/verification.k-26-                   | sCons(IntSeq, StrList) [constructor]
/reference/k-proof/verification.k:27:  syntax Iterable ::= stringList(StrList)
/reference/k-proof/verification.k:28:  rule <k> #iterNext(stringList(.StrList)) => #iterDone ... </k>
/reference/k-proof/verification.k:29:  rule <k> #iterNext(stringList(sCons(S:IntSeq, REST:StrList)))
/reference/k-proof/verification.k:30:        => #iterYield(str(S), stringList(REST)) ... </k>
/reference/k-proof/verification.k-31-
/reference/k-proof/verification.k:32:  // Mathematical result: retain exactly the strings satisfying startsWith.
/reference/k-proof/verification.k:33:  syntax ValSeq ::= prefixFilter(IntSeq, StrList) [function, total]
/reference/k-proof/verification.k:34:  rule prefixFilter(_:IntSeq, .StrList) => .ValSeq
/reference/k-proof/verification.k-35-    [simplification]
/reference/k-proof/verification.k-36-  rule prefixFilter(P:IntSeq, sCons(S:IntSeq, REST:StrList))
/reference/k-proof/verification.k:37:    => vCons(str(S), prefixFilter(P, REST))
/reference/k-proof/verification.k:38:    requires startsWith(P, S) ==Bool true
/reference/k-proof/verification.k-39-    [simplification]
/reference/k-proof/verification.k-40-  rule prefixFilter(P:IntSeq, sCons(S:IntSeq, REST:StrList))
/reference/k-proof/verification.k-41-    => prefixFilter(P, REST)
/reference/k-proof/verification.k:42:    requires startsWith(P, S) ==Bool false
/reference/k-proof/verification.k-43-    [simplification]
/reference/k-proof/verification.k-44-
/reference/k-proof/verification.k-45-  // Derived list lemma needed when ACC is symbolic (right identity).
/reference/k-proof/verification.k:46:  rule valSeqConcat(VS:ValSeq, .ValSeq) => VS [simplification]
/reference/k-proof/verification.k-47-  // Derived associativity lemma normalizes accumulator appends to the right.
/reference/k-proof/verification.k:48:  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
/reference/k-proof/verification.k:49:    => valSeqConcat(A, valSeqConcat(B, C))
/reference/k-proof/verification.k-50-    [simplification]
/reference/k-proof/verification.k-51-
/reference/k-proof/verification.k-52-  // Observe a returned heap list structurally, hiding its allocation address.
/reference/k-proof/verification.k-53-  syntax KItem ::= #checkFilter(ValSeq)
/reference/k-proof/verification.k-54-  rule <k> ref(H:Int) ~> #checkFilter(EXPECTED:ValSeq)
/reference/k-proof/verification.k-55-        => (ACTUAL ==K EXPECTED) ... </k>
/reference/k-proof/verification.k-56-       <heap> ... H |-> list(ACTUAL:ValSeq) ... </heap>
/reference/k-proof/verification.k-57-endmodule
