     4	def filter_by_prefix(strings: List[str], prefix: str) -> List[str]:
     5	    result = []
     6	    string = ""
     7	    for string in strings:
     8	        if string.startswith(prefix):
     9	            result.append(string)
    10	    return result
     1	Module(
     2	  ImportFrom("typing", "List")
     3	  FuncDef("filter_by_prefix", Params("strings", "prefix"),
     4	    Assign(Name("result"), ListExpr())
     5	    Assign(Name("string"), Str(""))
     6	    For(Name("string"), Name("strings"),
     7	      If(Call(Attribute(Name("string"), "startswith"), Name("prefix")),
     8	        Expr(Call(Attribute(Name("result"), "append"), Name("string"))),
     9	        ))
    10	    Return(Name("result"))))
