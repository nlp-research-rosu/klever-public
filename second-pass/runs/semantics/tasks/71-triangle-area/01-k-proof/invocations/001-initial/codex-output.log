--- /dev/null
+++ b/solution.py
@@ -0,0 +1,5 @@
+def triangle_area(a, b, c):
+    if a + b <= c or a + c <= b or b + c <= a:
+        return -1
+    s = (a + b + c) / 2
+    return round((s * (s - a) * (s - b) * (s - c)) ** 0.5, 2)
