diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..eb4ac1578dee10a4863543998fc4908896979eaa
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,77 @@
+requires "verification.k"
+
+module TRIANGLE-SPEC
+  imports TRIANGLE-VERIFICATION
+
+  // The four claims partition all integer triples according to the program's
+  // left-to-right short-circuit validity test.
+
+  claim
+    <k> Call(triangleAreaClosure, (A:Int, B:Int, C:Int, .Exprs))
+      =>* -1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires A +Int B <=Int C
+
+  claim
+    <k> Call(triangleAreaClosure, (A:Int, B:Int, C:Int, .Exprs))
+      =>* -1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires A +Int B >Int C
+     andBool A +Int C <=Int B
+
+  claim
+    <k> Call(triangleAreaClosure, (A:Int, B:Int, C:Int, .Exprs))
+      =>* -1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires A +Int B >Int C
+     andBool A +Int C >Int B
+     andBool B +Int C <=Int A
+
+  claim
+    <k> Call(triangleAreaClosure, (A:Int, B:Int, C:Int, .Exprs))
+      =>* expectedArea(A, B, C)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires A +Int B >Int C
+     andBool A +Int C >Int B
+     andBool B +Int C >Int A
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..0623750866eca708b69af994374df0ce4751f2c2
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,66 @@
+requires "reference-semantics/semantics.k"
+
+module TRIANGLE-VERIFICATION
+  imports MPY
+
+  // This is the translated body from solution.mpy, packaged as a value so the
+  // claims can call it directly without depending on a module-scope map entry.
+  syntax Stmts ::= "triangleAreaBody" [function]
+  rule triangleAreaBody
+    => If(
+         BoolOp(
+           "or",
+           Compare(BinOp("+", Name("a"), Name("b")),
+                   CmpOp("<=", Name("c"))),
+           Compare(BinOp("+", Name("a"), Name("c")),
+                   CmpOp("<=", Name("b"))),
+           Compare(BinOp("+", Name("b"), Name("c")),
+                   CmpOp("<=", Name("a")))),
+         Return(UnaryOp("-", Int(1))),
+         .Stmts)
+       Assign(
+         Name("s"),
+         BinOp(
+           "/",
+           BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
+           Int(2)))
+       Return(
+         Call(
+           Name("round"),
+           BinOp(
+             "**",
+             BinOp(
+               "*",
+               BinOp(
+                 "*",
+                 BinOp("*", Name("s"),
+                       BinOp("-", Name("s"), Name("a"))),
+                 BinOp("-", Name("s"), Name("b"))),
+               BinOp("-", Name("s"), Name("c"))),
+             Float(0.5)),
+           Int(2)))
+
+  syntax Val ::= "triangleAreaClosure" [function]
+  rule triangleAreaClosure
+    => closureVal(("a", "b", "c"), triangleAreaBody, 0)
+
+  // The exact proof-domain value of Heron's formula.  The supplied reference
+  // semantics deliberately keeps float operations opaque under kprove, so
+  // correctness is structural at these trusted float primitives.
+  syntax Float ::= semiPerimeter(Int, Int, Int) [function]
+  rule semiPerimeter(A, B, C) => divII(A +Int B +Int C, 2)
+
+  syntax Float ::= expectedArea(Int, Int, Int) [function]
+  rule expectedArea(A, B, C)
+    => roundFN(
+         powF(
+           mulF(
+             mulF(
+               mulF(
+                 semiPerimeter(A, B, C),
+                 subF(semiPerimeter(A, B, C), intToF(A))),
+               subF(semiPerimeter(A, B, C), intToF(B))),
+             subF(semiPerimeter(A, B, C), intToF(C))),
+           0.5),
+         2)
+endmodule

