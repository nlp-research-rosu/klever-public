Module(
  FuncDef("triangle_area", Params("a", "b", "c"),
    If(BoolOp(
      "or",
      Compare(BinOp("+", Name("a"), Name("b")), CmpOp("<=", Name("c"))),
      Compare(BinOp("+", Name("a"), Name("c")), CmpOp("<=", Name("b"))),
      Compare(BinOp("+", Name("b"), Name("c")), CmpOp("<=", Name("a")))),
      Return(UnaryOp("-", Int(1))),
      )
    Assign(
      Name("s"),
      BinOp(
        "/",
        BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
        Int(2)))
    Return(
      Call(
        Name("round"),
        BinOp(
          "**",
          BinOp(
            "*",
            BinOp(
              "*",
              BinOp("*", Name("s"), BinOp("-", Name("s"), Name("a"))),
              BinOp("-", Name("s"), Name("b"))),
            BinOp("-", Name("s"), Name("c"))),
          Float(0.5)),
        Int(2))))
  Assert(
    Compare(
      Call(
        Name("triangle_area"),
        UnaryOp("-", Int(3)),
        UnaryOp("-", Int(3)),
        UnaryOp("-", Int(3))),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(
        Name("triangle_area"),
        UnaryOp("-", Int(3)),
        UnaryOp("-", Int(3)),
        UnaryOp("-", Int(2))),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
