+    <ret> noRet </ret>
+    requires A +Int B >Int C
+     andBool A +Int C <=Int B
+
+  claim [invalid-third]:
+    <k> Call(triangleAreaClosure, (A:Int, B:Int, C:Int, .Exprs))
+      => -1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires A +Int B >Int C
+     andBool A +Int C >Int B
+     andBool B +Int C <=Int A
+
+  claim [valid]:
+    <k> Call(triangleAreaClosure, (A:Int, B:Int, C:Int, .Exprs))
+      => expectedArea(A, B, C)
+    </k>
+    <env> 0 </env>
