+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires A +Int B >Int C
+     andBool A +Int C >Int B
+     andBool B +Int C >Int A
+endmodule
