diff --git a//tmp/audit-work/candidate-src/spec-labeled.k b//tmp/audit-work/candidate-src/spec-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..3bae75276842dd7a090c036ad1f18d91b3930854
--- /dev/null
+++ b//tmp/audit-work/candidate-src/spec-labeled.k
@@ -0,0 +1,90 @@
+requires "verification.k"
+
+module TRIANGLE-SPEC-LABELED
+  imports TRIANGLE-VERIFICATION
+
+  // Loading the translated module binds the required entry point to precisely
+  // the closure whose behavior is proved below.
+  claim [load-module]:
+    <k> #loadAll(triangleAreaModule) => .K </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        => "triangle_area" |-> triangleAreaClosure,
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+
+  // The four claims partition all integer triples according to the program's
+  // left-to-right short-circuit validity test.
+
+  claim [invalid-first]:
+    <k> Call(triangleAreaClosure, (A:Int, B:Int, C:Int, .Exprs))
+      => -1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires A +Int B <=Int C
+
+  claim [invalid-second]:
+    <k> Call(triangleAreaClosure, (A:Int, B:Int, C:Int, .Exprs))
+      => -1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires A +Int B >Int C
+     andBool A +Int C <=Int B
+
+  claim [invalid-third]:
+    <k> Call(triangleAreaClosure, (A:Int, B:Int, C:Int, .Exprs))
+      => -1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires A +Int B >Int C
+     andBool A +Int C >Int B
+     andBool B +Int C <=Int A
+
+  claim [valid]:
+    <k> Call(triangleAreaClosure, (A:Int, B:Int, C:Int, .Exprs))
+      => expectedArea(A, B, C)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires A +Int B >Int C
+     andBool A +Int C >Int B
+     andBool B +Int C >Int A
+endmodule
