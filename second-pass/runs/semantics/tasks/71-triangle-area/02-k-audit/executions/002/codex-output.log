/bin/bash -lc "script -q -e -c 'set -x; python3 /audit-output/evidence/04-adequacy/witnesses.py; python3 py2mpy.py /audit-output/evidence/04-adequacy/witnesses.py > /audit-output/evidence/04-adequacy/witnesses.mpy; krun /audit-output/evidence/04-adequacy/witnesses.mpy --definition audit-runtime-kompiled' /audit-output/evidence/04-adequacy/concrete-witnesses.log
