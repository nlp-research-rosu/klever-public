+  | xargs -0 sha256sum
+
+echo "Candidate semantics regular-file manifest:"
+find /candidate/reference-semantics -type f -print0 \
+  | sort -z \
+  | xargs -0 sha256sum
+
+echo "SEMANTICS_TREE_IDENTITY_OK"
