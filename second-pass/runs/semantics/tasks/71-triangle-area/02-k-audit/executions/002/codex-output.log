+endmodule
+
+module AUDIT-INVALID-SECOND-SPEC
+  imports TRIANGLE-VERIFICATION
+
+  claim
+    <k> Call(triangleAreaClosure, (A:Int, B:Int, C:Int, .Exprs))
+      => -1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
