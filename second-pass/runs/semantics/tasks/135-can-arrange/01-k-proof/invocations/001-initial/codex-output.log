@@ -0,0 +1,19 @@
+def can_arrange(arr):
+    result = -1
+    index = 0
+    previous = 0
+    for current in arr:
+        if index > 0:
+            if current < previous:
+                result = index
+        previous = current
+        index = index + 1
+    return result
+
+
+assert can_arrange([1, 2, 4, 3, 5]) == 3
