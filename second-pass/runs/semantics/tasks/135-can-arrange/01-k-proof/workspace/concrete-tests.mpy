Module(
  FuncDef("can_arrange", Params("arr"),
    Assign(Name("result"), UnaryOp("-", Int(1)))
    Assign(Name("index"), Int(0))
    Assign(Name("previous"), Int(0))
    For(Name("current"), Name("arr"),
      If(Compare(Name("index"), CmpOp(">", Int(0))),
        If(Compare(Name("current"), CmpOp("<", Name("previous"))),
          Assign(Name("result"), Name("index")),
          ),
        )
      Assign(Name("previous"), Name("current"))
      Assign(Name("index"), BinOp("+", Name("index"), Int(1))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("can_arrange"),
        ListExpr(Int(1), Int(2), Int(4), Int(3), Int(5))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("can_arrange"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("can_arrange"), ListExpr()),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("can_arrange"), ListExpr(Int(7))),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(
        Name("can_arrange"),
        ListExpr(Int(5), Int(4), Int(3), Int(2), Int(1))),
      CmpOp("==", Int(4))))
  Assert(
    Compare(
      Call(
        Name("can_arrange"),
        ListExpr(
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(2)),
          Int(0),
          UnaryOp("-", Int(4)))),
      CmpOp("==", Int(4)))))
