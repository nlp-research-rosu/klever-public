def can_arrange(arr):
    """Create a function which returns the largest index of an element which
    is not greater than or equal to the element immediately preceding it. If
    no such element exists then return -1. The given array will not contain
    duplicate values.

    Examples:
    can_arrange([1,2,4,3,5]) = 3
    can_arrange([1,2,3]) = -1
    """
# canonical.py — the UNMODIFIED HumanEval/135 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: can_arrange


def can_arrange(arr):
    """Create a function which returns the largest index of an element which
    is not greater than or equal to the element immediately preceding it. If
    no such element exists then return -1. The given array will not contain
    duplicate values.

    Examples:
    can_arrange([1,2,4,3,5]) = 3
    can_arrange([1,2,3]) = -1
    """
    ind=-1
    i=1
    while i<len(arr):
      if arr[i]<arr[i-1]:
        ind=i
      i+=1
    return ind
def can_arrange(arr):
    result = -1
    index = 0
    previous = 0
    for current in arr:
        if index > 0:
            if current < previous:
                result = index
        previous = current
        index = index + 1
    return result
Module(
  FuncDef("can_arrange", Params("arr"),
    Assign(Name("result"), UnaryOp("-", Int(1)))
    Assign(Name("index"), Int(0))
    Assign(Name("previous"), Int(0))
    For(Name("current"), Name("arr"),
      If(Compare(Name("index"), CmpOp(">", Int(0))),
        If(Compare(Name("current"), CmpOp("<", Name("previous"))),
          Assign(Name("result"), Name("index")),
          ),
        )
      Assign(Name("previous"), Name("current"))
      Assign(Name("index"), BinOp("+", Name("index"), Int(1))))
    Return(Name("result"))))
requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // The constructor term generated in solution.mpy, factored only so that the
  // loop body can also be named in the inductive claim.
  syntax Stmts ::= "arrangeBody" [function]
  rule arrangeBody
    => If(Compare(Name("index"), CmpOp(">", Int(0))),
         If(Compare(Name("current"), CmpOp("<", Name("previous"))),
            Assign(Name("result"), Name("index")),
            .Stmts),
         .Stmts)
       Assign(Name("previous"), Name("current"))
       Assign(Name("index"), BinOp("+", Name("index"), Int(1)))

  syntax Module ::= "solutionProgram" [function]
  rule solutionProgram
    => Module(
         FuncDef("can_arrange", Params("arr"),
           Assign(Name("result"), UnaryOp("-", Int(1)))
           Assign(Name("index"), Int(0))
           Assign(Name("previous"), Int(0))
           For(Name("current"), Name("arr"), arrangeBody)
           Return(Name("result"))))

  // Domain predicate: every element in the HumanEval array is an integer.
  syntax Bool ::= ints(ValSeq) [function, total]
  rule ints(.ValSeq) => true
  rule ints(vCons(V:Val, REST:ValSeq))
    => isInt(V) andBool ints(REST)

  // A proof-only sort refinement. The iterator protocol yields a generic Val
  // even when `ints` proves that value is an Int. `intValue` gives SMT an
  // Int-sorted view and agrees definitionally with every concrete Int.
  syntax Int ::= intValue(Val) [function, total]
  rule intValue(I:Int) => I

  rule applyCmp("<", L:Val, R:Val)
    => intValue(L) <Int intValue(R)
    requires isInt(L) andBool isInt(R)

  // Mathematical result of scanning the unprocessed suffix.  INDEX is the
  // next absolute index, PREVIOUS is the preceding item (ignored at index 0),
  // and RESULT is the latest violating index seen so far.
  syntax Int ::= arrangeResult(ValSeq) [function]
               | arrangeScan(ValSeq, Int, Val, Int) [function]
  rule arrangeResult(VS:ValSeq) => arrangeScan(VS, 0, 0, -1)
  rule arrangeScan(.ValSeq, _:Int, _:Val, RESULT:Int) => RESULT
  rule arrangeScan(vCons(CURRENT:Val, REST:ValSeq),
                   INDEX:Int, PREVIOUS:Val, RESULT:Int)
    => arrangeScan(
         REST,
         INDEX +Int 1,
         CURRENT,
         #if INDEX >Int 0
               andBool intValue(CURRENT) <Int intValue(PREVIOUS)
         #then INDEX
         #else RESULT
         #fi)
    requires isInt(CURRENT)
     andBool (INDEX ==Int 0 orBool isInt(PREVIOUS))
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  // Inductive loop invariant.  This claim is a circularity over the remaining
  // ValSeq: one semantic loop step exposes its head and the recursive state
  // matches the same claim on its tail.
  claim
    <k> #loop(list(VS:ValSeq), Name("current"), arrangeBody)
        ~> (Return(Name("result")) .Stmts):Stmts ~> #endcall
      => #pop
    </k>
    <env> L:Int </env>
    <scopes>
      (L |-> scope(("arr" |-> ARRAY:Val
                    "current" |-> OLD_CURRENT:Val
                    "index" |-> INDEX:Int
                    "previous" |-> PREVIOUS:Val
                    "result" |-> RESULT:Int),
                   PARENT:Parent)
       OTHER:Map)
      =>
      (L |-> scope(?FINALMAP:Map, PARENT)
       OTHER)
    </scopes>
    <ret>
      noRet
      =>
      retV(arrangeScan(VS, INDEX, PREVIOUS, RESULT))
    </ret>
    requires ints(VS)
     andBool INDEX >=Int 1
     andBool isInt(PREVIOUS)
    [label(loop-correct)]

  // End-to-end correctness of the translated function from a fresh module
  // configuration, for every finite integer ValSeq.
  claim
    <k> #loadAll(solutionProgram)
        ~> Call(Name("can_arrange"), list(VS:ValSeq))
      => arrangeResult(VS)
    </k>
    <env> 0 </env>
    <scopes>
      (0 |-> scope(.Map, parent(-1))
       -1 |-> builtinsScope)
      =>
      ?FINALSCOPES:Map
    </scopes>
    <scopeLoc> 1 => ?FINALSCOPELOC:Int </scopeLoc>
    <heap> .Map => ?FINALHEAP:Map </heap>
    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>
    <stack> .List => ?FINALSTACK:List </stack>
    <ret> noRet => ?FINALRET:RetState </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires ints(VS)
    [label(function-correct)]
endmodule
#!/usr/bin/env bash
set -euo pipefail

# Regenerate the submitted constructor term and the concrete smoke program.
python3 py2mpy.py solution.py > solution.mpy
head -n 11 concrete-tests.py | cmp - solution.py
python3 py2mpy.py concrete-tests.py > concrete-tests.mpy

# Concrete execution uses the required LLVM main/syntax modules.
kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled
krun concrete-tests.mpy --definition runtime-kompiled

# Symbolic verification imports MPY (not MPY-KRUN/MPY-CONCRETE).
kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

# First prove the structural loop invariant. Then prove the only remaining
# claim with that independently proved label available as a lemma.
kprove spec.k \
  --definition verification-kompiled \
  --claims loop-correct
kprove spec.k \
  --definition verification-kompiled \
  --trusted loop-correct
def can_arrange(arr):
    result = -1
    index = 0
    previous = 0
    for current in arr:
        if index > 0:
            if current < previous:
                result = index
        previous = current
        index = index + 1
    return result


assert can_arrange([1, 2, 4, 3, 5]) == 3
assert can_arrange([1, 2, 3]) == -1
assert can_arrange([]) == -1
assert can_arrange([7]) == -1
assert can_arrange([5, 4, 3, 2, 1]) == 4
assert can_arrange([-3, -1, -2, 0, -4]) == 4
Module(
  FuncDef("can_arrange", Params("arr"),
    Assign(Name("result"), UnaryOp("-", Int(1)))
    Assign(Name("index"), Int(0))
    Assign(Name("previous"), Int(0))
    For(Name("current"), Name("arr"),
      If(Compare(Name("index"), CmpOp(">", Int(0))),
        If(Compare(Name("current"), CmpOp("<", Name("previous"))),
          Assign(Name("result"), Name("index")),
          ),
        )
      Assign(Name("previous"), Name("current"))
      Assign(Name("index"), BinOp("+", Name("index"), Int(1))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("can_arrange"),
        ListExpr(Int(1), Int(2), Int(4), Int(3), Int(5))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("can_arrange"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("can_arrange"), ListExpr()),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("can_arrange"), ListExpr(Int(7))),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(
        Name("can_arrange"),
        ListExpr(Int(5), Int(4), Int(3), Int(2), Int(1))),
      CmpOp("==", Int(4))))
  Assert(
    Compare(
      Call(
        Name("can_arrange"),
        ListExpr(
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(2)),
          Int(0),
          UnaryOp("-", Int(4)))),
      CmpOp("==", Int(4)))))

