CUSTOM_OUTPUT line=62 call_id=call_vA9brMdC4NahCl3bb8SDG787 source=(60, 'apply_patch', '*** Begin Patch\n*** Add File: verification.k\n+requires "reference-semantics/semantics.k"\n+\n+module VERIFICATION\n+  imports MPY\n+\n+  // The constructor term generated in solution.mpy, factored only so that the\n+  // loop body can also be named in the inductive claim.\n+  syntax Stmts ::= "arrangeBody" [function]\n+  rule arrangeBody\n+    => If(Compare(Name("index"), CmpOp(">", Int(0))),\n+         If(Compare(Name("current"), CmpOp("<", Name("previous"))),\n+            Assign(Name("result"), Name("index")),\n+            .Stmts),\n+         .Stmts)\n+       Assign(Name("previous"), Name("current"))\n+       Assign(Name("index"), BinOp("+", Name("index"), Int(1)))\n+\n+  syntax Module ::= "solutionProgram" [function]\n+  rule solutionProgram\n+    => Module(\n+         FuncDef("can_arrange", Params("arr"),\n+           Assign(Name("result"), UnaryOp("-", Int(1)))\n+           Assign(Name("index"), Int(0))\n+           Assign(Name("previous"), Int(0))\n+           For(Name("current"), Name("arr"), arrangeBody)\n+           Return(Name("result"))))\n+\n+  // Domain predicate: HumanEval supplies an array of integers.\n+  syntax Bool ::= ints(ValSeq) [function, total]\n+  rule ints(.ValSeq) => true\n+  rule ints(vCons(_:Int, REST:ValSeq)) => ints(REST)\n+  rule ints(vCons(_:Val, _:ValSeq)) => false [owise]\n+\n+  // Mathematical result of scanning the unprocessed suffix.  INDEX is the\n+  // next absolute index, PREVIOUS is the preceding item (ignored at index 0),\n+  // and RESULT is the latest violating index seen so far.\n+  syntax Int ::= arrangeResult(ValSeq) [function]\n+               | arrangeScan(ValSeq, Int, Int, Int) [function]\n+  rule arrangeResult(VS:ValSeq) => arrangeScan(VS, 0, 0, -1)\n+  rule arrangeScan(.ValSeq, _:Int, _:Int, RESULT:Int) => RESULT\n+  rule arrangeScan(vCons(CURRENT:Int, REST:ValSeq),\n+                   INDEX:Int, PREVIOUS:Int, RESULT:Int)\n+    => arrangeScan(\n+         REST,\n+         INDEX +Int 1,\n+         CURRENT,\n+         #if INDEX >Int 0 andBool CURRENT <Int PREVIOUS\n+         #then INDEX\n+         #else RESULT\n+         #fi)\n+endmodule\n*** Add File: spec.k\n+requires "verification.k"\n+\n+module SPEC\n+  imports VERIFICATION\n+\n+  // Inductive loop invariant.  This claim is a circularity over the remaining\n+  // ValSeq: one semantic loop step exposes its head and the recursive state\n+  // matches the same claim on its tail.\n+  claim\n+    <k> #loop(list(VS:ValSeq), Name("current"), arrangeBody)\n+        ~> Return(Name("result")) ~> #endcall\n+      => #pop\n+    </k>\n+    <env> L:Int </env>\n+    <scopes>\n+      (L |-> scope(("index" |-> INDEX:Int\n+                    "previous" |-> PREVIOUS:Int\n+                    "result" |-> RESULT:Int\n+                    RESTMAP:Map), PARENT:Parent)\n+       OTHER:Map)\n+      =>\n+      (L |-> scope(?FINALMAP:Map, PARENT)\n+       OTHER)\n+    </scopes>\n+    <ret> noRet => retV(arrangeScan(VS, INDEX, PREVIOUS, RESULT)) </ret>\n+    requires ints(VS) andBool INDEX >=Int 0\n+\n+  // End-to-end correctness of the translated function from a fresh module\n+  // configuration, for every finite integer ValSeq.\n+  claim\n+    <k> #loadAll(solutionProgram)\n+        ~> Call(Name("can_arrange"), list(VS:ValSeq))\n+      => arrangeResult(VS)\n+    </k>\n+    <env> 0 </env>\n+    <scopes>\n+      (0 |-> scope(.Map, parent(-1))\n+       -1 |-> builtinsScope)\n+      =>\n+      ?FINALSCOPES:Map\n+    </scopes>\n+    <scopeLoc> 1 => ?FINALSCOPELOC:Int </scopeLoc>\n+    <heap> .Map => ?FINALHEAP:Map </heap>\n+    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>\n+    <stack> .List => ?FINALSTACK:List </stack>\n+    <ret> noRet => ?FINALRET:RetState </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+    requires ints(VS)\n+endmodule\n*** End Patch\n') output_sha256=5cef1d63e276956348b8a635274af04649a5b7e5d37008fd95efca3525a2c8d3
