    18	  syntax Module ::= "solutionProgram" [function]
    19	  rule solutionProgram
    20	    => Module(
    21	         FuncDef("can_arrange", Params("arr"),
    22	           Assign(Name("result"), UnaryOp("-", Int(1)))
    23	           Assign(Name("index"), Int(0))
