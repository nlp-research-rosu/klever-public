    31	  rule ints(vCons(V:Val, REST:ValSeq))
    32	    => isInt(V) andBool ints(REST)
    33	
    34	  // A proof-only sort refinement. The iterator protocol yields a generic Val
    35	  // even when `ints` proves that value is an Int. `intValue` gives SMT an
    36	  // Int-sorted view and agrees definitionally with every concrete Int.
    37	  syntax Int ::= intValue(Val) [function, total]
