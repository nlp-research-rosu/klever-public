requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // The digit in decimal place P (P = 1, 10, 100, ...).  Python's
  // non-negative // and % are expressed with the supplied pyMod operation.
  syntax Int ::= decimalDigit(Int, Int) [function, total]
  rule decimalDigit(N:Int, 1) => pyMod(N, 10)
  rule decimalDigit(N:Int, P:Int)
    => pyMod((N -Int pyMod(N, P)) /Int P, 10)
    requires N >=Int 0 andBool P >Int 1

  // N is bounded by 10000, so these are all and only its possible places.
  syntax Int ::= decimalDigitSum(Int) [function, total]
  rule decimalDigitSum(N:Int)
    => decimalDigit(N, 1)
       +Int decimalDigit(N, 10)
       +Int decimalDigit(N, 100)
       +Int decimalDigit(N, 1000)
       +Int decimalDigit(N, 10000)
    requires 0 <=Int N andBool N <=Int 10000

  // A binary numeral has no Python "0b" prefix.
  syntax Str ::= binaryNumeral(Int) [function, total]
  rule binaryNumeral(N:Int) => str(binCodes(N))

  // Symbolic slicing in the reference semantics deliberately leaves buildIS
  // opaque when its tail is opaque.  This exact prefix lemma is the defining
  // slice identity needed for bin(N)[2:]; it does not summarize solve.
  rule <k>
         Subscript(
           str(iCons(48, iCons(98, REST:IntSeq))),
           Slice(Int(2), NoBound, NoBound))
         => str(REST)
         ...
       </k>
       [priority(40)]
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  claim
    <k>
      #loadAll(
        Module(
          FuncDef("solve", Params("N"),
            Assign(
              Name("digit_sum"),
              BinOp(
                "+",
                BinOp(
                  "+",
                  BinOp(
                    "+",
                    BinOp(
                      "+",
                      BinOp("%", Name("N"), Int(10)),
                      BinOp("%", BinOp("//", Name("N"), Int(10)), Int(10))),
                    BinOp("%", BinOp("//", Name("N"), Int(100)), Int(10))),
                  BinOp("%", BinOp("//", Name("N"), Int(1000)), Int(10))),
                BinOp("%", BinOp("//", Name("N"), Int(10000)), Int(10))))
            Return(
              Subscript(
                Call(Name("bin"), Name("digit_sum")),
                Slice(Int(2), NoBound, NoBound)))))
      ) ~> Call(Name("solve"), Int(N))
      => binaryNumeral(decimalDigitSum(N))
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(
        .Map
        => .Map [
          "solve" <-
            closureVal(
              ("N", .ParamNames),
              Assign(
                Name("digit_sum"),
                BinOp(
                  "+",
                  BinOp(
                    "+",
                    BinOp(
                      "+",
                      BinOp(
                        "+",
                        BinOp("%", Name("N"), Int(10)),
                        BinOp("%", BinOp("//", Name("N"), Int(10)), Int(10))),
                      BinOp("%", BinOp("//", Name("N"), Int(100)), Int(10))),
                    BinOp("%", BinOp("//", Name("N"), Int(1000)), Int(10))),
                  BinOp("%", BinOp("//", Name("N"), Int(10000)), Int(10))))
              Return(
                Subscript(
                  Call(Name("bin"), Name("digit_sum")),
                  Slice(Int(2), NoBound, NoBound)))
              .Stmts,
              0)
        ],
        parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    requires 0 <=Int N andBool N <=Int 10000
endmodule
#!/usr/bin/env bash
set -euo pipefail

# Translate the delivered implementation and the concrete assertion harness.
python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py concrete-tests.py > concrete-tests.mpy

# Required concrete LLVM definition and K-level execution.
kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled
krun concrete-tests.mpy \
  --definition runtime-kompiled \
  --output pretty \
  --statistics

# Symbolic definition: VERIFICATION imports MPY, not MPY-CONCRETE.
kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

# Positive target proof: success is "#Top" with exit status 0.
kprove spec.k \
  --definition verification-kompiled \
  --output pretty

