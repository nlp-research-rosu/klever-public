index 0000000000000000000000000000000000000000..1c93d53c67238c1c7692458def90ccd1f503b76a
--- /dev/null
+++ b/evidence/03_rebuild_and_prove.sh
@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+set -u
+
+export PATH="/home/agent/.nix-profile/bin:$PATH"
+work=/tmp/audit-work/candidate-src
+overall=0
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  rc=$?
+  printf '[exit %d]\n' "$rc"
+  if (( rc != 0 )); then
+    overall=1
+  fi
+}
+
+run kompile --version
+run kprove --version
+run test ! -e "$work/runtime-kompiled"
+run test ! -e "$work/verification-kompiled"
+
+run kompile "$work/reference-semantics/semantics.k" \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition "$work/runtime-kompiled"
+
+run krun "$work/concrete-tests.mpy" \
+  --definition "$work/runtime-kompiled" \
+  --output pretty
+
+run kompile "$work/verification.k" \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition "$work/verification-kompiled"
+
+# spec.k contains the sole positive target claim (SPEC, unlabeled).
+run kprove "$work/spec.k" \
+  --definition "$work/verification-kompiled" \
+  --spec-module SPEC \
+  --output pretty
+
+exit "$overall"
diff --git a/evidence/04_slice_connection.k b/evidence/04_slice_connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..ffb6326298ad65b65894766b8bc91fdcccb871fd
--- /dev/null
+++ b/evidence/04_slice_connection.k
@@ -0,0 +1,18 @@
+requires "/tmp/audit-work/candidate-src/reference-semantics/semantics.k"
+
+module SLICE-CONNECTION
+  imports MPY
+
+  // Bridge-free universal connection theorem for verification.k:31-38.
+  // CONT is arbitrary, so the theorem checks the complete continuation domain
+  // accepted by the local operational bridge.
+  claim
+    <k>
+      Subscript(
+        str(iCons(48, iCons(98, REST:IntSeq))),
+        Slice(Int(2), NoBound, NoBound)
+      ) ~> CONT:K
+      =>
+      str(REST) ~> CONT
+    </k>
+endmodule
diff --git a/evidence/04_validate_slice_bridge.sh b/evidence/04_validate_slice_bridge.sh
new file mode 100644
index 0000000000000000000000000000000000000000..2adad873a0052e47ee56227f460401d19c605ddd
--- /dev/null
+++ b/evidence/04_validate_slice_bridge.sh
@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+set -u
+
+export PATH="/home/agent/.nix-profile/bin:$PATH"
+base=/tmp/audit-work/base-semantics-kompiled
+overall=0
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  rc=$?
+  printf '[exit %d]\n' "$rc"
+  if (( rc != 0 )); then
+    overall=1
+  fi
+}
+
+run test ! -e "$base"
+run kompile \
+  /tmp/audit-work/candidate-src/reference-semantics/semantics.k \
+  --backend haskell \
+  --main-module MPY \
+  --syntax-module MPY-SYNTAX \
+  --output-definition "$base"
+run kprove /audit-output/evidence/04_slice_connection.k \
+  --definition "$base" \
+  --spec-module SLICE-CONNECTION \
+  --output pretty
+
+exit "$overall"

