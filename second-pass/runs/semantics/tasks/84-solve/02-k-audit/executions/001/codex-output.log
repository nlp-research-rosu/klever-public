     6	  // The digit in decimal place P (P = 1, 10, 100, ...).  Python's
     7	  // non-negative // and % are expressed with the supplied pyMod operation.
     8	  syntax Int ::= decimalDigit(Int, Int) [function, total]
     9	  rule decimalDigit(N:Int, 1) => pyMod(N, 10)
    10	  rule decimalDigit(N:Int, P:Int)
    11	    => pyMod((N -Int pyMod(N, P)) /Int P, 10)
    12	    requires N >=Int 0 andBool P >Int 1
    13	
    14	  // N is bounded by 10000, so these are all and only its possible places.
    15	  syntax Int ::= decimalDigitSum(Int) [function, total]
    16	  rule decimalDigitSum(N:Int)
    17	    => decimalDigit(N, 1)
    18	       +Int decimalDigit(N, 10)
    19	       +Int decimalDigit(N, 100)
    20	       +Int decimalDigit(N, 1000)
    21	       +Int decimalDigit(N, 10000)
    22	    requires 0 <=Int N andBool N <=Int 10000
    23	
    24	  // A binary numeral has no Python "0b" prefix.
