index 0000000000000000000000000000000000000000..74858366e49dc6677b5f3ce18aabd7032ce8503c
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,75 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Fresh false-postcondition probe: N=0 executes to "0", while this
+  // off-by-one postcondition requires binaryNumeral(1), namely "1".
+  claim
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("solve", Params("N"),
+            Assign(
+              Name("digit_sum"),
+              BinOp(
+                "+",
+                BinOp(
+                  "+",
+                  BinOp(
+                    "+",
+                    BinOp(
+                      "+",
+                      BinOp("%", Name("N"), Int(10)),
+                      BinOp("%", BinOp("//", Name("N"), Int(10)), Int(10))),
+                    BinOp("%", BinOp("//", Name("N"), Int(100)), Int(10))),
+                  BinOp("%", BinOp("//", Name("N"), Int(1000)), Int(10))),
+                BinOp("%", BinOp("//", Name("N"), Int(10000)), Int(10))))
+            Return(
+              Subscript(
+                Call(Name("bin"), Name("digit_sum")),
+                Slice(Int(2), NoBound, NoBound)))))
+      ) ~> Call(Name("solve"), Int(N))
+      => binaryNumeral(decimalDigitSum(N) +Int 1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        => .Map [
+          "solve" <-
+            closureVal(
+              ("N", .ParamNames),
+              Assign(
+                Name("digit_sum"),
+                BinOp(
+                  "+",
+                  BinOp(
+                    "+",
+                    BinOp(
+                      "+",
+                      BinOp(
+                        "+",
+                        BinOp("%", Name("N"), Int(10)),
+                        BinOp("%", BinOp("//", Name("N"), Int(10)), Int(10))),
+                      BinOp("%", BinOp("//", Name("N"), Int(100)), Int(10))),
+                    BinOp("%", BinOp("//", Name("N"), Int(1000)), Int(10))),
+                  BinOp("%", BinOp("//", Name("N"), Int(10000)), Int(10))))
+              Return(
+                Subscript(
+                  Call(Name("bin"), Name("digit_sum")),
+                  Slice(Int(2), NoBound, NoBound)))
+              .Stmts,
+              0)
+        ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires 0 <=Int N andBool N <=Int 10000
+endmodule
diff --git a/evidence/trace_audit.py b/evidence/trace_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..034516190bc63b11b0bd17b9314d6bd26f3b5e50
--- /dev/null
+++ b/evidence/trace_audit.py
@@ -0,0 +1,60 @@
+#!/usr/bin/env python3
+"""Read and summarize every structured generation-trace record."""
+
+from __future__ import annotations
+
+import collections
+import json
+from pathlib import Path
+
+
+trace_root = Path("/generation-evidence/codex-trace")
+files = sorted(path for path in trace_root.rglob("*.jsonl") if path.is_file() and not path.is_symlink())
+outer_types: collections.Counter[str] = collections.Counter()
+payload_types: collections.Counter[str] = collections.Counter()
+roles: collections.Counter[str] = collections.Counter()
+tool_names: collections.Counter[str] = collections.Counter()
+commands: list[str] = []
+agent_messages: list[str] = []
+line_count = 0
+
+for path in files:
+    with path.open() as stream:
+        for line in stream:
+            line_count += 1
+            record = json.loads(line)
+            outer_types[str(record.get("type"))] += 1
+            payload = record.get("payload")
+            if not isinstance(payload, dict):
+                continue
+            payload_types[str(payload.get("type"))] += 1
+            if "role" in payload:
+                roles[str(payload["role"])] += 1
+            if payload.get("type") == "agent_message":
+                agent_messages.append(str(payload.get("message", "")))
+            if payload.get("type") == "function_call":
+                name = str(payload.get("name"))
+                tool_names[name] += 1
+                arguments = payload.get("arguments")
+                if name in {"exec_command", "exec"} and isinstance(arguments, str):
+                    try:
+                        decoded = json.loads(arguments)
+                    except json.JSONDecodeError:
+                        decoded = {"raw": arguments}
+                    command = decoded.get("cmd") or decoded.get("raw")
+                    if command:
+                        commands.append(str(command))
+
+print("files:", len(files))
+print("lines:", line_count)
+print("outer_types:", dict(sorted(outer_types.items())))
+print("payload_types:", dict(sorted(payload_types.items())))
+print("roles:", dict(sorted(roles.items())))
+print("tool_names:", dict(sorted(tool_names.items())))
+print("recorded_commands:", len(commands))
+for index, command in enumerate(commands, 1):
+    print(f"COMMAND {index}:")
+    print(command)
+print("agent_messages:", len(agent_messages))
+for index, message in enumerate(agent_messages, 1):
+    print(f"AGENT_MESSAGE {index}: {message}")
diff --git a/evidence/verification-no-bridge.k b/evidence/verification-no-bridge.k
new file mode 100644
index 0000000000000000000000000000000000000000..88c73d000eff3431cda6c37eb7533263c3a2b99c
--- /dev/null
+++ b/evidence/verification-no-bridge.k
@@ -0,0 +1,23 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-NO-BRIDGE
+  imports MPY
+
+  syntax Int ::= decimalDigit(Int, Int) [function, total]
+  rule decimalDigit(N:Int, 1) => pyMod(N, 10)
+  rule decimalDigit(N:Int, P:Int)
+    => pyMod((N -Int pyMod(N, P)) /Int P, 10)
+    requires N >=Int 0 andBool P >Int 1
+
+  syntax Int ::= decimalDigitSum(Int) [function, total]
+  rule decimalDigitSum(N:Int)
+    => decimalDigit(N, 1)
+       +Int decimalDigit(N, 10)
+       +Int decimalDigit(N, 100)
+       +Int decimalDigit(N, 1000)
+       +Int decimalDigit(N, 10000)
+    requires 0 <=Int N andBool N <=Int 10000
+
+  syntax Str ::= binaryNumeral(Int) [function, total]
+  rule binaryNumeral(N:Int) => str(binCodes(N))
+endmodule

diff --git a/evidence/adequacy_witness.py b/evidence/adequacy_witness.py
new file mode 100644
index 0000000000000000000000000000000000000000..33d214c1a2489ed628261d51154070af5fd97605
--- /dev/null
+++ b/evidence/adequacy_witness.py
@@ -0,0 +1,53 @@
+#!/usr/bin/env python3
+"""Ground witnesses for the formal precondition and claimed summary."""
+
+from __future__ import annotations
+
+import importlib.util
+import sys
+from pathlib import Path
+
+
+def load_solve(path: Path, name: str):
+    module_spec = importlib.util.spec_from_file_location(name, path)
+    if module_spec is None or module_spec.loader is None:
+        raise RuntimeError(path)
+    module = importlib.util.module_from_spec(module_spec)
+    module_spec.loader.exec_module(module)
+    return module.solve
+
+
+def py_mod(nonnegative: int, divisor: int) -> int:
+    return nonnegative % divisor
+
+
+def decimal_digit(value: int, place: int) -> int:
+    if place == 1:
+        return py_mod(value, 10)
+    assert value >= 0 and place > 1
+    return py_mod((value - py_mod(value, place)) // place, 10)
+
+
+def formal_summary(value: int) -> str:
+    assert 0 <= value <= 10000
+    digit_sum = sum(decimal_digit(value, place) for place in (1, 10, 100, 1000, 10000))
+    return format(digit_sum, "b")
+
+
+if len(sys.argv) != 3:
+    raise SystemExit("usage: adequacy_witness.py CANONICAL_PY SOLUTION_PY")
+
+canonical = load_solve(Path(sys.argv[1]), "witness_canonical")
+generated = load_solve(Path(sys.argv[2]), "witness_generated")
+
+for value in (0, 1, 147, 9999, 10000):
+    precondition = 0 <= value <= 10000
+    claimed = formal_summary(value)
+    original = canonical(value)
+    submitted = generated(value)
+    print(
+        f"N={value} precondition={precondition} "
+        f"formal={claimed!r} canonical={original!r} submitted={submitted!r}"
+    )
+    assert precondition
+    assert claimed == original == submitted
