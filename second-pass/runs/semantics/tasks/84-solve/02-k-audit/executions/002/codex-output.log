+              Return(
+                Subscript(
+                  Call(Name("bin"), Name("digit_sum")),
+                  Slice(Int(2), NoBound, NoBound)))
+              .Stmts,
+              0)
+        ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires 0 <=Int N andBool N <=Int 10000
+endmodule
