@@ -0,0 +1,26 @@
+#define _GNU_SOURCE
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+    FILE *status = fopen("/proc/self/status", "r");
+    if (status == NULL) {
+        return (pid_t)-1;
+    }
+
+    char *line = NULL;
+    size_t capacity = 0;
+    pid_t outer_pid = (pid_t)-1;
+    while (getline(&line, &capacity, status) != -1) {
+        long value;
+        if (sscanf(line, "Pid:\t%ld", &value) == 1) {
+            outer_pid = (pid_t)value;
+            break;
+        }
+    }
+    free(line);
+    fclose(status);
+    return outer_pid;
+}
