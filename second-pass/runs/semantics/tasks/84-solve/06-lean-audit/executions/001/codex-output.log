+        lines = (WORKSPACE / "verification.k").read_text().splitlines()
+        source_span = "\n".join(
+            lines[rule["start_line"] - 1 : rule["end_line"]]
+        )
+        require(
+            f"{rule['source_rule_id']} source span",
+            source_span.strip(),
