+        "Stage 1 pipeline tree",
+        pipeline_contract.sha256_tree(WORKSPACE),
+        audit_hashes["k_workspace_sha256"],
+    )
+    require(
+        "Stage 1 export tree",
+        klean_export.tree_digest(WORKSPACE),
+        audit_hashes["stage1_export_sha256"],
+    )
