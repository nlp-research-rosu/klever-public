+        "launcher mode",
+        resolution["mode"],
+        "CLASSIFICATION_AND_PROOF",
+    )
+    require(
+        "semantics mode",
+        resolution["semantics_mode"],
+        "SUPPLIED_SEMANTICS",
+    )
+
+    audit_hashes = resolution["hashes"]
