def inventory_verification(workspace: Path) -> dict[str, Any]:
    workspace = Path(workspace)
    try:
        workspace_mode = workspace.stat(follow_symlinks=False).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        ) from error
    if not stat.S_ISDIR(workspace_mode):
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        )
    verification = workspace / "verification.k"
    try:
        verification_mode = verification.stat(
            follow_symlinks=False
        ).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        ) from error
    if not stat.S_ISREG(verification_mode):
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        )
    try:
        verification_bytes = verification.read_bytes()
        text = verification_bytes.decode()
    except (OSError, UnicodeError) as error:
        raise KRuleInventoryError(
            f"cannot read verification.k: {verification}"
        ) from error
    masked_text = _mask_non_code(text)
    modules = _modules(masked_text)
    module = _verification_module(
        modules, _last_verification_main_module(workspace)
    )
    closure = _verification_closure(modules, module)
    rule_documents = _rule_documents(text, closure)
    return {
        "schema_version": 2,
        "verification_file": "verification.k",
        "verification_sha256": hashlib.sha256(verification_bytes).hexdigest(),
        "verification_module": module.name,
        "verification_modules": [module.name for module in closure],
        "rules": rule_documents,
        "inventory_sha256": canonical_json_sha256(rule_documents),
    }
requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // The digit in decimal place P (P = 1, 10, 100, ...).  Python's
  // non-negative // and % are expressed with the supplied pyMod operation.
  syntax Int ::= decimalDigit(Int, Int) [function, total]
  rule decimalDigit(N:Int, 1) => pyMod(N, 10)
  rule decimalDigit(N:Int, P:Int)
    => pyMod((N -Int pyMod(N, P)) /Int P, 10)
    requires N >=Int 0 andBool P >Int 1

  // N is bounded by 10000, so these are all and only its possible places.
  syntax Int ::= decimalDigitSum(Int) [function, total]
  rule decimalDigitSum(N:Int)
    => decimalDigit(N, 1)
       +Int decimalDigit(N, 10)
       +Int decimalDigit(N, 100)
       +Int decimalDigit(N, 1000)
       +Int decimalDigit(N, 10000)
    requires 0 <=Int N andBool N <=Int 10000

  // A binary numeral has no Python "0b" prefix.
  syntax Str ::= binaryNumeral(Int) [function, total]
  rule binaryNumeral(N:Int) => str(binCodes(N))

  // Symbolic slicing in the reference semantics deliberately leaves buildIS
  // opaque when its tail is opaque.  This exact prefix lemma is the defining
  // slice identity needed for bin(N)[2:]; it does not summarize solve.
  rule <k>
         Subscript(
           str(iCons(48, iCons(98, REST:IntSeq))),
           Slice(Int(2), NoBound, NoBound))
         => str(REST)
         ...
       </k>
       [priority(40)]
endmodule
