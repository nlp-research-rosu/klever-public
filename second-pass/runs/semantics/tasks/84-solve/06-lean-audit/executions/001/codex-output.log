+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+    FILE *status = fopen("/proc/self/status", "r");
+    if (status == NULL) {
+        return (pid_t)-1;
+    }
+
+    char *line = NULL;
+    size_t capacity = 0;
+    pid_t outer_pid = (pid_t)-1;
