diff --git a//tmp/audit-work/procfs_getpid.c b//tmp/audit-work/procfs_getpid.c
new file mode 100644
index 0000000000000000000000000000000000000000..2a218e7088618054a43eca89186ababbb3e254a2
--- /dev/null
+++ b//tmp/audit-work/procfs_getpid.c
@@ -0,0 +1,26 @@
+#define _GNU_SOURCE
+#include <stdio.h>
+#include <stdlib.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+    FILE *status = fopen("/proc/self/status", "r");
+    if (status == NULL) {
+        return (pid_t)-1;
+    }
+
+    char *line = NULL;
+    size_t capacity = 0;
+    pid_t outer_pid = (pid_t)-1;
+    while (getline(&line, &capacity, status) != -1) {
+        long value;
+        if (sscanf(line, "Pid:\t%ld", &value) == 1) {
+            outer_pid = (pid_t)value;
+            break;
+        }
+    }
+    free(line);
+    fclose(status);
+    return outer_pid;
+}
