Module(
  FuncDef("solve", Params("N"),
    Assign(
      Name("digit_sum"),
      BinOp(
        "+",
        BinOp(
          "+",
          BinOp(
            "+",
            BinOp(
              "+",
              BinOp("%", Name("N"), Int(10)),
              BinOp("%", BinOp("//", Name("N"), Int(10)), Int(10))),
            BinOp("%", BinOp("//", Name("N"), Int(100)), Int(10))),
          BinOp("%", BinOp("//", Name("N"), Int(1000)), Int(10))),
        BinOp("%", BinOp("//", Name("N"), Int(10000)), Int(10))))
    Return(
      Subscript(
        Call(Name("bin"), Name("digit_sum")),
        Slice(Int(2), NoBound, NoBound))))
  Assert(Compare(Call(Name("solve"), Int(0)), CmpOp("==", Str("0"))))
  Assert(
    Compare(Call(Name("solve"), Int(147)), CmpOp("==", Str("1100"))))
  Assert(
    Compare(Call(Name("solve"), Int(150)), CmpOp("==", Str("110"))))
  Assert(Compare(Call(Name("solve"), Int(1000)), CmpOp("==", Str("1"))))
  Assert(
    Compare(Call(Name("solve"), Int(9999)), CmpOp("==", Str("100100"))))
  Assert(
    Compare(Call(Name("solve"), Int(10000)), CmpOp("==", Str("1")))))
