index 0000000000000000000000000000000000000000..720031ca93a7902d9925b65ed976e21f4eafefd7
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def solve(N):
+    digit_sum = (
+        N % 10
+        + (N // 10) % 10
+        + (N // 100) % 10
+        + (N // 1000) % 10
+        + (N // 10000) % 10
+    )
+    return bin(digit_sum)[2:]
