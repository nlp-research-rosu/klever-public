diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..d7a5239c1d98da5c480ae6248d203c0e8fed9d15
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,17 @@
+def solve(N):
+    digit_sum = (
+        N % 10
+        + (N // 10) % 10
+        + (N // 100) % 10
+        + (N // 1000) % 10
+        + (N // 10000) % 10
+    )
+    return bin(digit_sum)[2:]
+
+
+assert solve(0) == "0"
+assert solve(147) == "1100"
+assert solve(150) == "110"
+assert solve(1000) == "1"
+assert solve(9999) == "100100"
+assert solve(10000) == "1"
