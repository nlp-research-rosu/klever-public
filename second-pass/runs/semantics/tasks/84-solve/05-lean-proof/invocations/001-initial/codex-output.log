+  rfl
+
+theorem fuelModel_append_suffix
+    (pre rest : SortIntSeq) (extra : Nat) (extra_pos : 0 < extra) :
+    fuelModel (lengthModel rest + extra) (append pre rest)
+        (Int.ofNat (lengthModel pre))
+        (Int.ofNat (lengthModel pre + lengthModel rest))
