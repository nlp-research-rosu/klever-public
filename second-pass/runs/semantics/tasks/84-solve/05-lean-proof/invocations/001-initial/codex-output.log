+import Klean84Solve.Lemmas
+
+set_option pp.privateNames true in
+#print «buildIS(_,_,_,_)_MPY-SUBSCRIPT_IntSeq_IntSeq_Int_Int_Int»
+
+#print Lean.Meta.Simp.Config
