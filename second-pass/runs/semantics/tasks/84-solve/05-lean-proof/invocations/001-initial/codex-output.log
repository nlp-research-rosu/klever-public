+            SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»)
+      have recursive_eq :
+          fuelModel (lengthModel rest + extra)
+              (append pre
+                (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq»
+                  x rest))
+              (Int.ofNat (lengthModel pre) + 1)
+              (Int.ofNat
+                (lengthModel pre +
+                  lengthModel
