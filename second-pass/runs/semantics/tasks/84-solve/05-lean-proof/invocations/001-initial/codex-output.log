+              (Int.ofNat
+                (lengthModel pre +
+                  lengthModel
+                    (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq»
+                      x rest)))
+              1 =
+            some rest := by
+        have next_ih := ih (pre := nextPre)
+        rw [← append_cons_assoc pre rest x] at next_ih
+        simpa [
