+  rfl
+
+theorem buildModel_append_suffix (pre rest : SortIntSeq) :
+    buildModel (append pre rest)
+        (Int.ofNat (lengthModel pre))
+        (Int.ofNat (lengthModel pre + lengthModel rest))
+        1 =
