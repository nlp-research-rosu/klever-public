+  | SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x xs, ys =>
+      SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x (append xs ys)
