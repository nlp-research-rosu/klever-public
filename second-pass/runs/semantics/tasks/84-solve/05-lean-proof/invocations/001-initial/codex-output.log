+          Int.add_pos_of_nonneg_of_pos
+            (Int.ofNat_nonneg (lengthModel rest))
+            (by decide)
+        have shifted :=
+          Int.add_lt_add_left positive_increment
+            (Int.ofNat (lengthModel pre))
+        simpa using shifted
+      rw [if_pos continue_eq]
+      have at_eq :
+          atModel
