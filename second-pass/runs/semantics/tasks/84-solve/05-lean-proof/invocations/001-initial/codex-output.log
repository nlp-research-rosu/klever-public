index 0000000000000000000000000000000000000000..a0346b2d1ffc26827ea3296a42dcc9cd4a10a607
--- /dev/null
+++ b//tmp/PrivateAlias.lean
@@ -0,0 +1,20 @@
+import Klean84Solve.Lemmas
+import Lean
+
+open Lean Elab Term
+
+private def findPrivateConstant (suffix : String) : TermElabM Name := do
+  let environment ← getEnv
+  match environment.constants.toList.find? fun entry =>
+      entry.1.toString.endsWith suffix with
+  | some entry => pure entry.1
+  | none => throwError "missing private constant ending in {suffix}"
+
+elab "kleanPrivateBuildISModel" : term => do
+  return .const (← findPrivateConstant "kleanBuildISModel") []
+
+def exposedBuildISModel :
+    SortIntSeq → SortInt → SortInt → SortInt → Option SortIntSeq :=
+  kleanPrivateBuildISModel
+
+#print exposedBuildISModel
diff --git a//tmp/lean-proc-shim.c b//tmp/lean-proc-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..f98b164a135d3cc63dd57399db0f53a5187003ed
--- /dev/null
+++ b//tmp/lean-proc-shim.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink = NULL;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+
+  size_t length = strlen(path);
+  if (length > 10 && strncmp(path, "/proc/", 6) == 0 &&
+      strcmp(path + length - 4, "/exe") == 0) {
+    return real_readlink("/proc/self/exe", buffer, size);
+  }
+
+  return real_readlink(path, buffer, size);
+}
