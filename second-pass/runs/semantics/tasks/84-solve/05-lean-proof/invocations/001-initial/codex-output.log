+              (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» 98
+                rest))))
+        1 =
+      some rest := by
+  simpa [
+    twoPrefix,
+    append,
+    Nat.add_assoc,
