+  have extra_pos : 0 < lengthModel pre + 1 := by
+    omega
+  simpa [
+    Nat.add_assoc,
+    Nat.add_comm,
+    Nat.add_left_comm
+  ] using
+    fuelModel_append_suffix pre rest (lengthModel pre + 1) extra_pos
