+                  (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq»
+                    x rest) :=
+          Nat.lt_add_of_pos_right tail_length_pos
+        have int_lt :
+            Int.ofNat (lengthModel pre) <
+              Int.ofNat
+                (lengthModel pre +
+                  lengthModel
+                    (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq»
+                      x rest)) :=
+          Int.ofNat_lt.mpr nat_lt
+        simp [continueModel_eq, int_lt]
+      rw [if_pos continue_eq]
+      have at_eq :
+          atModel
+              (append pre
