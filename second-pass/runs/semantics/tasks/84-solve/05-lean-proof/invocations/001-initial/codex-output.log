+                  x rest) +
+              extra =
+            (lengthModel rest + extra) + 1 := by
+        simp
+        omega
+      rw [fuel_eq, fuelModel_succ]
+      have continue_eq :
+          continueModel
+              (Int.ofNat (lengthModel pre))
+              (Int.ofNat
+                (lengthModel pre +
+                  lengthModel
+                    (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq»
+                      x rest)))
+              1 =
+            true := by
+        rw [continueModel_eq]
+        simp
+        omega
