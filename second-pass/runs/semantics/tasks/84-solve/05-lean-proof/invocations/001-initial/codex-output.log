+          (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» x
+            SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»))
+        rest := by
+  induction pre with
+  | «.IntSeq_MPY-CORE_IntSeq» => rfl
+  | «iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» y pre ih =>
+      simp [append, ih]
