{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 9,
      "module": "VERIFICATION",
      "normalized_sha256": "a2a0cbc29f4bdad308197b05bda1a7c12d26bc5f4bf5c5fa4bc8efb1a6bef1ff",
      "rationale": "This equation defines the units-place case of the newly introduced decimalDigit mathematical summary.",
      "source_rule_id": "rule-a2a0cbc29f4bdad308197b05bda1a7c12d26bc5f4bf5c5fa4bc8efb1a6bef1ff",
      "start_line": 9,
      "text": "  rule decimalDigit(N:Int, 1) => pyMod(N, 10)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 12,
      "module": "VERIFICATION",
      "normalized_sha256": "23f89684a132dd7dad23f7ecb3fe9fd76732744d67c2b56c21111f9a39c9ad85",
      "rationale": "This guarded equation defines decimalDigit at higher positive decimal place values using the supplied quotient and remainder operations.",
      "source_rule_id": "rule-23f89684a132dd7dad23f7ecb3fe9fd76732744d67c2b56c21111f9a39c9ad85",
      "start_line": 10,
      "text": "  rule decimalDigit(N:Int, P:Int)\n    => pyMod((N -Int pyMod(N, P)) /Int P, 10)\n    requires N >=Int 0 andBool P >Int 1"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 22,
      "module": "VERIFICATION",
      "normalized_sha256": "979ae1f2895c98614c80e18ea6320fbc542082fabe9dd57a189f28dab4ca187b",
      "rationale": "This equation defines the bounded decimalDigitSum summary as the sum of the only five possible decimal places for inputs through 10000.",
      "source_rule_id": "rule-979ae1f2895c98614c80e18ea6320fbc542082fabe9dd57a189f28dab4ca187b",
      "start_line": 16,
      "text": "  rule decimalDigitSum(N:Int)\n    => decimalDigit(N, 1)\n       +Int decimalDigit(N, 10)\n       +Int decimalDigit(N, 100)\n       +Int decimalDigit(N, 1000)\n       +Int decimalDigit(N, 10000)\n    requires 0 <=Int N andBool N <=Int 10000"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 26,
      "module": "VERIFICATION",
      "normalized_sha256": "0ff761fe64416f5fd80a5acdadc928772e06c444ab5ca99ba4614d2bcbce761e",
      "rationale": "This equation defines the named binaryNumeral proof term as the supplied semantics' prefix-free binCodes representation.",
      "source_rule_id": "rule-0ff761fe64416f5fd80a5acdadc928772e06c444ab5ca99ba4614d2bcbce761e",
      "start_line": 26,
      "text": "  rule binaryNumeral(N:Int) => str(binCodes(N))"
    }
  ],
