def select_words(s, n):
    """Given a string s and a natural number n, you have been tasked to implement 
    a function that returns a list of all words from string s that contain exactly 
    n consonants, in order these words appear in the string s.
    If the string s is empty then the function should return an empty list.
    Note: you may assume the input string contains only letters and spaces.
    Examples:
    select_words("Mary had a little lamb", 4) ==> ["little"]
    select_words("Mary had a little lamb", 3) ==> ["Mary", "lamb"]
    select_words("simple white space", 2) ==> []
    select_words("Hello world", 4) ==> ["world"]
    select_words("Uncle sam", 3) ==> ["Uncle"]
    """
# canonical.py — the UNMODIFIED HumanEval/117 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: select_words


def select_words(s, n):
    """Given a string s and a natural number n, you have been tasked to implement 
    a function that returns a list of all words from string s that contain exactly 
    n consonants, in order these words appear in the string s.
    If the string s is empty then the function should return an empty list.
    Note: you may assume the input string contains only letters and spaces.
    Examples:
    select_words("Mary had a little lamb", 4) ==> ["little"]
    select_words("Mary had a little lamb", 3) ==> ["Mary", "lamb"]
    select_words("simple white space", 2) ==> []
    select_words("Hello world", 4) ==> ["world"]
    select_words("Uncle sam", 3) ==> ["Uncle"]
    """
    result = []
    for word in s.split():
        n_consonants = 0
        for i in range(0, len(word)):
            if word[i].lower() not in ["a","e","i","o","u"]:
                n_consonants += 1 
        if n_consonants == n:
            result.append(word)
    return result

def select_words(s, n):
    result = []
    for word in s.split():
        lower = word.lower()
        consonants = (
            len(word)
            - lower.count("a")
            - lower.count("e")
            - lower.count("i")
            - lower.count("o")
            - lower.count("u")
        )
        if consonants == n:
            result.append(word)
    return result
Module(
  FuncDef("select_words", Params("s", "n"),
    Assign(Name("result"), ListExpr())
    For(Name("word"), Call(Attribute(Name("s"), "split"), ),
      Assign(Name("lower"), Call(Attribute(Name("word"), "lower"), ))
      Assign(
        Name("consonants"),
        BinOp(
          "-",
          BinOp(
            "-",
            BinOp(
              "-",
              BinOp(
                "-",
                BinOp(
                  "-",
                  Call(Name("len"), Name("word")),
                  Call(Attribute(Name("lower"), "count"), Str("a"))),
                Call(Attribute(Name("lower"), "count"), Str("e"))),
              Call(Attribute(Name("lower"), "count"), Str("i"))),
            Call(Attribute(Name("lower"), "count"), Str("o"))),
          Call(Attribute(Name("lower"), "count"), Str("u"))))
      If(Compare(Name("consonants"), CmpOp("==", Name("n"))),
        Expr(Call(Attribute(Name("result"), "append"), Name("word"))),
        ))
    Return(Name("result"))))
requires "reference-semantics/semantics.k"

module SELECT-WORDS-VERIFICATION
  imports MPY

  // A symbolic sequence of the words produced by whitespace splitting.
  // keepWord represents a word whose consonant count equals n; skipWord
  // represents one whose count differs. This is the complete behavioral
  // partition relevant to select_words for any fixed n.
  syntax WordSeq ::= ".WordSeq"
                   | keepWord(IntSeq, WordSeq)
                   | skipWord(IntSeq, WordSeq)

  // Opaque symbolic input whose split projection is exactly the given words.
  syntax IntSeq ::= inputWords(Int, WordSeq)
                  | countedWord(Int, IntSeq)

  // The program only iterates over s.split(); this proof-only iterable avoids
  // forcing the concrete splitWS function to destruct an unknown IntSeq.
  syntax Iterable ::= wordIter(Int, WordSeq)

  rule <k> #applyK(
             toCall(boundMethodV(str(inputWords(N:Int, WS:WordSeq)), "split")),
             .Vals)
        => wordIter(N, WS) ... </k>
       [priority(30)]

  rule <k> #iterNext(wordIter(_N:Int, .WordSeq))
        => #iterDone ... </k>
  rule <k> #iterNext(wordIter(N:Int, keepWord(W:IntSeq, WS:WordSeq)))
        => #iterYield(str(countedWord(N, W)), wordIter(N, WS)) ... </k>
  rule <k> #iterNext(wordIter(N:Int, skipWord(W:IntSeq, WS:WordSeq)))
        => #iterYield(str(countedWord(N +Int 1, W)), wordIter(N, WS)) ... </k>

  // Mathematical consonant count used by the contract. Since prompt inputs
  // contain only letters and spaces, a word's non-vowels are its consonants.
  // countedWord carries that mathematical count through the symbolic quotient.
  syntax Int ::= consonantCount(IntSeq)
                 [function, total, symbol(consonantCount), no-evaluators]
  rule ((((isLen(W:IntSeq)
           -Int cntSub(mapLower(W), iCons(97, .IntSeq)))
          -Int cntSub(mapLower(W), iCons(101, .IntSeq)))
         -Int cntSub(mapLower(W), iCons(105, .IntSeq)))
        -Int cntSub(mapLower(W), iCons(111, .IntSeq)))
       -Int cntSub(mapLower(W), iCons(117, .IntSeq))
    => consonantCount(W)
    [simplification]
  rule consonantCount(countedWord(C:Int, _W:IntSeq)) => C

  // Contract-level filter: preserve precisely the words with n consonants,
  // and preserve their order.
  syntax ValSeq ::= selectedWords(WordSeq, Int) [function, total]
  rule selectedWords(.WordSeq, _N:Int) => .ValSeq
  rule selectedWords(keepWord(W:IntSeq, WS:WordSeq), N:Int)
    => vCons(str(countedWord(N, W)), selectedWords(WS, N))
  rule selectedWords(skipWord(_W:IntSeq, WS:WordSeq), N:Int)
    => selectedWords(WS, N)

  // Associativity is a definitional theorem of valSeqConcat and is oriented
  // for the append-based loop invariant.
  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
    => valSeqConcat(A, valSeqConcat(B, C))
    [simplification]
  rule valSeqConcat(A:ValSeq, .ValSeq) => A
    [simplification]

  // Expose absence of the closure-cell marker through ordinary map entries;
  // this keeps symbolic plain-frame assignments from spuriously narrowing to
  // the annotated-closure write rule.
  rule "$cells" in_keys ((X:String |-> _V:Val) REST:Map)
    => "$cells" in_keys (REST)
    requires X =/=String "$cells"
    [simplification]
  rule X:String in_keys (_M:Map [ X <- _V:Val ]) => true
    [simplification]
  rule {((X:String |-> V:Val) _REST:Map)[X]}:>Val => V
    [simplification]

  // Continuation used only to observe the structural contents of the returned
  // list reference.
  syntax KItem ::= #expectList(ValSeq)
  rule <k> ref(H:Int) ~> #expectList(VS:ValSeq) => .K ... </k>
       <heap> ... H |-> list(VS) ... </heap>

  // These macros are the exact translated function body in solution.mpy.
  syntax Stmts ::= "selectLoopBody" [macro]
  rule selectLoopBody
    => Assign(Name("lower"),
              Call(Attribute(Name("word"), "lower"), .Exprs))
       Assign(
         Name("consonants"),
         BinOp(
           "-",
           BinOp(
             "-",
             BinOp(
               "-",
               BinOp(
                 "-",
                 BinOp(
                   "-",
                   Call(Name("len"), Name("word")),
                   Call(Attribute(Name("lower"), "count"),
                        Str("a"))),
                 Call(Attribute(Name("lower"), "count"),
                      Str("e"))),
               Call(Attribute(Name("lower"), "count"),
                    Str("i"))),
             Call(Attribute(Name("lower"), "count"),
                  Str("o"))),
           Call(Attribute(Name("lower"), "count"),
                Str("u"))))
       If(Compare(Name("consonants"), CmpOp("==", Name("n"))),
          Expr(Call(Attribute(Name("result"), "append"),
                    Name("word")))
          .Stmts,
          .Stmts)
       .Stmts

  syntax Stmts ::= "selectFunctionBody" [macro]
  rule selectFunctionBody
    => Assign(Name("result"), ListExpr(.Exprs))
       For(Name("word"),
           Call(Attribute(Name("s"), "split"), .Exprs),
           selectLoopBody)
       Return(Name("result"))
       .Stmts

  syntax Module ::= "selectWordsModule" [macro]
  rule selectWordsModule
    => Module(
         FuncDef("select_words",
                 Params("s", "n"),
                 selectFunctionBody)
         .Stmts)
endmodule
requires "verification.k"

module SELECT-WORDS-SPEC
  imports SELECT-WORDS-VERIFICATION

  // Inductive loop invariant. ACC is the already-produced prefix; processing
  // WS appends exactly the contract filter selectedWords(WS, N).
  claim [select-loop]:
    <k>
      #loop(wordIter(N:Int, WS:WordSeq), Name("word"), selectLoopBody)
      =>
      .K
      ...
    </k>
    <env> L:Int </env>
    <scopes>
      ...
      L |->
        scope(
          ("s" |-> S:Val
           "n" |-> N:Int
           "result" |-> ref(H:Int)
           "word" |-> OLDWORD:Val
           "lower" |-> OLDLOWER:Val
           "consonants" |-> OLDCOUNT:Int)
          =>
          ("s" |-> S
           "n" |-> N
           "result" |-> ref(H)
           "word" |-> ?FINALWORD:Val
           "lower" |-> ?FINALLOWER:Val
           "consonants" |-> ?FINALCOUNT:Int),
          parent(0))
      0 |-> scope("select_words" |-> SELECTFN:Val, parent(-1))
      -1 |-> builtinsScope
      ...
    </scopes>
    <heap>
      ...
      H |-> list(ACC:ValSeq => valSeqConcat(ACC, selectedWords(WS, N)))
      ...
    </heap>
    [circularity]

  // The function enters its first iteration before the loop-carried locals
  // exist. One symbolic step establishes the recurrent invariant above.
  claim [select-loop-entry]:
    <k>
      #loop(wordIter(N:Int, WS:WordSeq), Name("word"), selectLoopBody)
      =>
      .K
      ...
    </k>
    <env> L:Int </env>
    <scopes>
      ...
      L |->
        scope(
          ("s" |-> S:Val
           "n" |-> N
           "result" |-> ref(H:Int))
          =>
          ("s" |-> S
           "n" |-> N
           "result" |-> ref(H)
           ?FINAL:Map),
          parent(0))
      0 |-> scope("select_words" |-> SELECTFN:Val, parent(-1))
      -1 |-> builtinsScope
      ...
    </scopes>
    <heap>
      ...
      H |-> list(ACC:ValSeq => valSeqConcat(ACC, selectedWords(WS, N)))
      ...
    </heap>
    [depends(select-loop)]

  // End-to-end functional correctness for every natural n and every symbolic
  // whitespace-split word sequence.
  claim [select-words-correct]:
    <k>
      #loadAll(selectWordsModule)
      ~> Call(Name("select_words"),
              str(inputWords(N:Int, WS:WordSeq)), N)
      ~> #expectList(selectedWords(WS, N))
      =>
      .K
    </k>
    <env> 0 </env>
    <scopes>
      (0 |-> scope(.Map, parent(-1))
       -1 |-> builtinsScope)
      =>
      (0 |-> scope(
               "select_words" |->
                 closureVal(("s", "n", .ParamNames),
                            selectFunctionBody,
                            0),
               parent(-1))
       -1 |-> builtinsScope)
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map
      =>
      0 |-> list(selectedWords(WS, N))
    </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N >=Int 0
    [depends(select-loop-entry)]
endmodule
#!/usr/bin/env bash
set -euo pipefail

# Translate the submitted implementation with the fixed frontend.
python3 py2mpy.py solution.py > solution.mpy

# Concrete execution uses exactly the required LLVM modules.
python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled
krun concrete_tests.mpy --definition runtime-kompiled

# Symbolic verification imports MPY, without the concrete-only MPY-CONCRETE leg.
kompile verification.k \
  --backend haskell \
  --main-module SELECT-WORDS-VERIFICATION \
  --syntax-module SELECT-WORDS-VERIFICATION \
  --output-definition verification-kompiled
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SELECT-WORDS-SPEC
def select_words(s, n):
    result = []
    for word in s.split():
        lower = word.lower()
        consonants = (
            len(word)
            - lower.count("a")
            - lower.count("e")
            - lower.count("i")
            - lower.count("o")
            - lower.count("u")
        )
        if consonants == n:
            result.append(word)
    return result


assert select_words("Mary had a little lamb", 4) == ["little"]
assert select_words("Mary had a little lamb", 3) == ["Mary", "lamb"]
assert select_words("simple white space", 2) == []
assert select_words("Hello world", 4) == ["world"]
assert select_words("Uncle sam", 3) == ["Uncle"]
assert select_words("", 0) == []
assert select_words("AEIOU xyz", 0) == ["AEIOU"]
Module(
  FuncDef("select_words", Params("s", "n"),
    Assign(Name("result"), ListExpr())
    For(Name("word"), Call(Attribute(Name("s"), "split"), ),
      Assign(Name("lower"), Call(Attribute(Name("word"), "lower"), ))
      Assign(
        Name("consonants"),
        BinOp(
          "-",
          BinOp(
            "-",
            BinOp(
              "-",
              BinOp(
                "-",
                BinOp(
                  "-",
                  Call(Name("len"), Name("word")),
                  Call(Attribute(Name("lower"), "count"), Str("a"))),
                Call(Attribute(Name("lower"), "count"), Str("e"))),
              Call(Attribute(Name("lower"), "count"), Str("i"))),
            Call(Attribute(Name("lower"), "count"), Str("o"))),
          Call(Attribute(Name("lower"), "count"), Str("u"))))
      If(Compare(Name("consonants"), CmpOp("==", Name("n"))),
        Expr(Call(Attribute(Name("result"), "append"), Name("word"))),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("select_words"), Str("Mary had a little lamb"), Int(4)),
      CmpOp("==", ListExpr(Str("little")))))
  Assert(
    Compare(
      Call(Name("select_words"), Str("Mary had a little lamb"), Int(3)),
      CmpOp("==", ListExpr(Str("Mary"), Str("lamb")))))
  Assert(
    Compare(
      Call(Name("select_words"), Str("simple white space"), Int(2)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("select_words"), Str("Hello world"), Int(4)),
      CmpOp("==", ListExpr(Str("world")))))
  Assert(
    Compare(
      Call(Name("select_words"), Str("Uncle sam"), Int(3)),
      CmpOp("==", ListExpr(Str("Uncle")))))
  Assert(
    Compare(
      Call(Name("select_words"), Str(""), Int(0)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("select_words"), Str("AEIOU xyz"), Int(0)),
      CmpOp("==", ListExpr(Str("AEIOU"))))))

