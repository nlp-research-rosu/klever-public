                Call(Attribute(Name("lower"), "count"), Str("e"))),
              Call(Attribute(Name("lower"), "count"), Str("i"))),
            Call(Attribute(Name("lower"), "count"), Str("o"))),
          Call(Attribute(Name("lower"), "count"), Str("u"))))
      If(Compare(Name("consonants"), CmpOp("==", Name("n"))),
        Expr(Call(Attribute(Name("result"), "append"), Name("word"))),
        ))
    Return(Name("result")))
