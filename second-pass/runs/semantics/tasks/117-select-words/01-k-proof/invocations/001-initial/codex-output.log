+def select_words(s, n):
+    result = []
+    for word in s.split():
+        lower = word.lower()
+        consonants = (
+            len(word)
+            - lower.count("a")
+            - lower.count("e")
+            - lower.count("i")
+            - lower.count("o")
+            - lower.count("u")
+        )
+        if consonants == n:
+            result.append(word)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..78bf689943792745d0d06c1b13e46b09a7dd1390
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,82 @@
+requires "verification.k"
+
+module SELECT-WORDS-SPEC
+  imports SELECT-WORDS-VERIFICATION
+
+  // Inductive loop invariant. ACC is the already-produced prefix; processing
+  // WS appends exactly the contract filter selectedWords(WS, N).
+  claim [select-loop]:
+    <k>
+      #loop(wordIter(WS:WordSeq), Name("word"), selectLoopBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |->
+        scope(
+          ("s" |-> S:Val
+           "n" |-> N:Int
+           "result" |-> ref(H:Int)
+           "word" |-> OLDWORD:Val
+           "lower" |-> OLDLOWER:Val
+           "consonants" |-> OLDCOUNT:Int)
+          =>
+          ("s" |-> S
+           "n" |-> N
+           "result" |-> ref(H)
+           "word" |-> ?FINALWORD:Val
+           "lower" |-> ?FINALLOWER:Val
+           "consonants" |-> ?FINALCOUNT:Int),
+          parent(0))
+      0 |-> scope("select_words" |-> SELECTFN:Val, parent(-1))
+      -1 |-> builtinsScope
+      ...
+    </scopes>
+    <heap>
+      ...
+      H |-> list(ACC:ValSeq => valSeqConcat(ACC, selectedWords(WS, N)))
+      ...
+    </heap>
+    [circularity]
+
+  // End-to-end functional correctness for every natural n and every symbolic
+  // whitespace-split word sequence.
+  claim [select-words-correct]:
+    <k>
+      #loadAll(selectWordsModule)
+      ~> Call(Name("select_words"),
+              str(inputWords(WS:WordSeq)), N:Int)
+      ~> #expectList(selectedWords(WS, N))
+      =>
+      .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+               "select_words" |->
+                 closureVal(("s", "n", .ParamNames),
+                            selectFunctionBody,
+                            0),
+               parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(selectedWords(WS, N))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+    [depends(select-loop)]
+endmodule
