+           "lower" |-> OLDLOWER:Val
+           "consonants" |-> OLDCOUNT:Int)
+          =>
+          ("s" |-> S
+           "n" |-> N
+           "result" |-> ref(H)
+           "word" |-> ?FINALWORD:Val
+           "lower" |-> ?FINALLOWER:Val
+           "consonants" |-> ?FINALCOUNT:Int),
+          P:Parent)
+      ...
+    </scopes>
+    <heap>
