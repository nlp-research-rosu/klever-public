+           "result" |-> ref(H:Int)
+           REST:Map)
+          =>
+          ("n" |-> N
+           "result" |-> ref(H)
+           ?FINAL:Map),
+          P:Parent)
+      ...
+    </scopes>
+    <heap>
+      ...
+      H |-> list(ACC:ValSeq => valSeqConcat(ACC, selectedWords(WS, N)))
+      ...
+    </heap>
+    [circularity]
