+    <scopes>
+      ...
+      L |->
+        scope(
+          ("n" |-> N:Int
+           "result" |-> ref(H:Int)
+           REST:Map)
+          =>
+          ("n" |-> N
+           "result" |-> ref(H)
+           ?FINAL:Map),
+          parent(0))
+      0 |-> scope("select_words" |-> SELECTFN:Val, parent(-1))
+      -1 |-> builtinsScope
+      ...
+    </scopes>
+    <heap>
