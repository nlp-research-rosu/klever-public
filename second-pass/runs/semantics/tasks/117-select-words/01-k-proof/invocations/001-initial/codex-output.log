+  // whitespace-split word sequence.
+  claim [select-words-correct]:
+    <k>
+      #loadAll(selectWordsModule)
+      ~> Call(Name("select_words"),
+              (str(inputWords(WS:WordSeq)), N:Int, .Exprs))
+      ~> #expectList(selectedWords(WS, N))
+      =>
+      .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+               "select_words" |->
+                 closureVal(("s", "n", .ParamNames),
+                            selectFunctionBody,
+                            0),
+               parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(selectedWords(WS, N))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+    [depends(select-loop)]
+endmodule
