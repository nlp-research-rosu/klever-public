+        lower = word.lower()
+        consonants = (
+            len(word)
+            - lower.count("a")
+            - lower.count("e")
+            - lower.count("i")
+            - lower.count("o")
+            - lower.count("u")
+        )
+        if consonants == n:
+            result.append(word)
+    return result
