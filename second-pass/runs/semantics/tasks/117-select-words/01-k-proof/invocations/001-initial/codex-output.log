+      #loop(wordIter(N:Int, WS:WordSeq), Name("word"), selectLoopBody)
+      =>
+      .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |->
+        scope(
+          ("s" |-> S:Val
+           "n" |-> N
+           "result" |-> ref(H:Int))
+          =>
+          ("s" |-> S
+           "n" |-> N
+           "result" |-> ref(H)
+           ?FINAL:Map),
+          parent(0))
