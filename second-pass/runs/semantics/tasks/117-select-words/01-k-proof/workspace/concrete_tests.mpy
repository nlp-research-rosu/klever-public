Module(
  FuncDef("select_words", Params("s", "n"),
    Assign(Name("result"), ListExpr())
    For(Name("word"), Call(Attribute(Name("s"), "split"), ),
      Assign(Name("lower"), Call(Attribute(Name("word"), "lower"), ))
      Assign(
        Name("consonants"),
        BinOp(
          "-",
          BinOp(
            "-",
            BinOp(
              "-",
              BinOp(
                "-",
                BinOp(
                  "-",
                  Call(Name("len"), Name("word")),
                  Call(Attribute(Name("lower"), "count"), Str("a"))),
                Call(Attribute(Name("lower"), "count"), Str("e"))),
              Call(Attribute(Name("lower"), "count"), Str("i"))),
            Call(Attribute(Name("lower"), "count"), Str("o"))),
          Call(Attribute(Name("lower"), "count"), Str("u"))))
      If(Compare(Name("consonants"), CmpOp("==", Name("n"))),
        Expr(Call(Attribute(Name("result"), "append"), Name("word"))),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("select_words"), Str("Mary had a little lamb"), Int(4)),
      CmpOp("==", ListExpr(Str("little")))))
  Assert(
    Compare(
      Call(Name("select_words"), Str("Mary had a little lamb"), Int(3)),
      CmpOp("==", ListExpr(Str("Mary"), Str("lamb")))))
  Assert(
    Compare(
      Call(Name("select_words"), Str("simple white space"), Int(2)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("select_words"), Str("Hello world"), Int(4)),
      CmpOp("==", ListExpr(Str("world")))))
  Assert(
    Compare(
      Call(Name("select_words"), Str("Uncle sam"), Int(3)),
      CmpOp("==", ListExpr(Str("Uncle")))))
  Assert(
    Compare(
      Call(Name("select_words"), Str(""), Int(0)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("select_words"), Str("AEIOU xyz"), Int(0)),
      CmpOp("==", ListExpr(Str("AEIOU"))))))
