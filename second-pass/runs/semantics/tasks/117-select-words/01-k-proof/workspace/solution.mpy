Module(
  FuncDef("select_words", Params("s", "n"),
    Assign(Name("result"), ListExpr())
    For(Name("word"), Call(Attribute(Name("s"), "split"), ),
      Assign(Name("lower"), Call(Attribute(Name("word"), "lower"), ))
      Assign(
        Name("consonants"),
        BinOp(
          "-",
          BinOp(
            "-",
            BinOp(
              "-",
              BinOp(
                "-",
                BinOp(
                  "-",
                  Call(Name("len"), Name("word")),
                  Call(Attribute(Name("lower"), "count"), Str("a"))),
                Call(Attribute(Name("lower"), "count"), Str("e"))),
              Call(Attribute(Name("lower"), "count"), Str("i"))),
            Call(Attribute(Name("lower"), "count"), Str("o"))),
          Call(Attribute(Name("lower"), "count"), Str("u"))))
      If(Compare(Name("consonants"), CmpOp("==", Name("n"))),
        Expr(Call(Attribute(Name("result"), "append"), Name("word"))),
        ))
    Return(Name("result"))))
