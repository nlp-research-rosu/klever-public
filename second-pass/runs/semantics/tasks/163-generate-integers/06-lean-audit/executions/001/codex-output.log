+        == sha256_file(discovery)
+        and preflight["generated_tree_sha256"]
+        == klean_export.tree_digest(generation / "generated")
+    ),
+    "recorded_clean_output_hash": (
+        preflight["diagnostics"][0]["output_sha256"]
+        == hashlib.sha256(
