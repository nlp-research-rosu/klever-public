+    "obligation_ids_unique": (
+        len(
+            {
+                entry.get("source_rule_id")
+                for entry in obligation_map["obligations"]
+            }
+        )
+        == len(obligation_map["obligations"])
+    ),
+    "generator_obligation_count": generator_manifest[
+        "obligation_count"
