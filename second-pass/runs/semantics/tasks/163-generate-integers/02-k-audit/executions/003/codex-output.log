+bash -lc "python3 trusted-py2mpy.py solution.py > regenerated-solution.mpy; cmp --verbose regenerated-solution.mpy solution.mpy; sha256sum regenerated-solution.mpy solution.mpy"
+# exit 0; stage2-translation.log
