            ( Compare(Name("a"), CmpOp("<=", Int(4))),
              Compare(Int(4), CmpOp("<=", Name("b"))),
              .Exprs
            )
          ),
          BoolOp(
            "and",
            ( Compare(Name("b"), CmpOp("<=", Int(4))),
              Compare(Int(4), CmpOp("<=", Name("a"))),
              .Exprs
            )
          ),
          .Exprs
        )
      ),
      Expr(Call(Attribute(Name("result"), "append"), (Int(4), .Exprs))),
      .Stmts
    )
    If(
      BoolOp(
        "or",
        ( BoolOp(
            "and",
            ( Compare(Name("a"), CmpOp("<=", Int(6))),
              Compare(Int(6), CmpOp("<=", Name("b"))),
              .Exprs
            )
          ),
          BoolOp(
            "and",
            ( Compare(Name("b"), CmpOp("<=", Int(6))),
              Compare(Int(6), CmpOp("<=", Name("a"))),
              .Exprs
            )
          ),
          .Exprs
        )
      ),
      Expr(Call(Attribute(Name("result"), "append"), (Int(6), .Exprs))),
      .Stmts
    )
    If(
      BoolOp(
        "or",
        ( BoolOp(
            "and",
            ( Compare(Name("a"), CmpOp("<=", Int(8))),
              Compare(Int(8), CmpOp("<=", Name("b"))),
              .Exprs
            )
          ),
          BoolOp(
            "and",
            ( Compare(Name("b"), CmpOp("<=", Int(8))),
              Compare(Int(8), CmpOp("<=", Name("a"))),
              .Exprs
            )
          ),
          .Exprs
        )
      ),
      Expr(Call(Attribute(Name("result"), "append"), (Int(8), .Exprs))),
      .Stmts
    )
    Return(Name("result"))

  syntax Module ::= "solutionModule" [macro]
  rule solutionModule =>
    Module(
      FuncDef(
        "generate_integers",
        Params("a", "b"),
        generateIntegersBody
      )
    )

  syntax Val ::= "generateIntegersClosure" [macro]
  rule generateIntegersClosure =>
    closureVal(("a", "b"), generateIntegersBody, 0)

  // Mathematical result: retain each even decimal digit exactly when it lies
  // in the inclusive interval whose endpoints are A and B.
  syntax Bool ::= betweenEndpoints(Int, Int, Int) [function, total]
  rule betweenEndpoints(A, B, D) =>
    (A <=Int D andBool D <=Int B)
      orBool (B <=Int D andBool D <=Int A)

  syntax ValSeq ::= keepDigit(Bool, Int, ValSeq) [function, total]
  rule keepDigit(true,  D, REST) => vCons(D, REST)
  rule keepDigit(false, _, REST) => REST

  syntax ValSeq ::= evenDigits(Int, Int) [function, total]
  rule evenDigits(A, B) =>
    keepDigit(
      betweenEndpoints(A, B, 2),
      2,
      keepDigit(
        betweenEndpoints(A, B, 4),
        4,
        keepDigit(
          betweenEndpoints(A, B, 6),
          6,
          keepDigit(
            betweenEndpoints(A, B, 8),
            8,
            .ValSeq
          )
        )
      )
    )
endmodule
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py concrete_tests.py > concrete_tests.mpy

kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun concrete_tests.mpy \
  --definition runtime-kompiled

kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --smt-timeout 10000
def generate_integers(a, b):
    result = []
    if (a <= 2 and 2 <= b) or (b <= 2 and 2 <= a):
        result.append(2)
    if (a <= 4 and 4 <= b) or (b <= 4 and 4 <= a):
        result.append(4)
    if (a <= 6 and 6 <= b) or (b <= 6 and 6 <= a):
        result.append(6)
    if (a <= 8 and 8 <= b) or (b <= 8 and 8 <= a):
        result.append(8)
    return result


assert generate_integers(2, 8) == [2, 4, 6, 8]
assert generate_integers(8, 2) == [2, 4, 6, 8]
assert generate_integers(10, 14) == []
assert generate_integers(1, 9) == [2, 4, 6, 8]
assert generate_integers(3, 7) == [4, 6]
assert generate_integers(8, 8) == [8]
assert generate_integers(1, 1) == []
Module(
  FuncDef("generate_integers", Params("a", "b"),
    Assign(Name("result"), ListExpr())
    If(BoolOp(
      "or",
      BoolOp(
        "and",
        Compare(Name("a"), CmpOp("<=", Int(2))),
        Compare(Int(2), CmpOp("<=", Name("b")))),
      BoolOp(
        "and",
        Compare(Name("b"), CmpOp("<=", Int(2))),
        Compare(Int(2), CmpOp("<=", Name("a"))))),
      Expr(Call(Attribute(Name("result"), "append"), Int(2))),
      )
    If(BoolOp(
      "or",
      BoolOp(
        "and",
        Compare(Name("a"), CmpOp("<=", Int(4))),
        Compare(Int(4), CmpOp("<=", Name("b")))),
      BoolOp(
        "and",
        Compare(Name("b"), CmpOp("<=", Int(4))),
        Compare(Int(4), CmpOp("<=", Name("a"))))),
      Expr(Call(Attribute(Name("result"), "append"), Int(4))),
      )
    If(BoolOp(
      "or",
      BoolOp(
        "and",
        Compare(Name("a"), CmpOp("<=", Int(6))),
        Compare(Int(6), CmpOp("<=", Name("b")))),
      BoolOp(
        "and",
        Compare(Name("b"), CmpOp("<=", Int(6))),
        Compare(Int(6), CmpOp("<=", Name("a"))))),
      Expr(Call(Attribute(Name("result"), "append"), Int(6))),
      )
    If(BoolOp(
      "or",
      BoolOp(
        "and",
        Compare(Name("a"), CmpOp("<=", Int(8))),
        Compare(Int(8), CmpOp("<=", Name("b")))),
      BoolOp(
        "and",
        Compare(Name("b"), CmpOp("<=", Int(8))),
        Compare(Int(8), CmpOp("<=", Name("a"))))),
      Expr(Call(Attribute(Name("result"), "append"), Int(8))),
      )
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(2), Int(8)),
      CmpOp("==", ListExpr(Int(2), Int(4), Int(6), Int(8)))))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(8), Int(2)),
      CmpOp("==", ListExpr(Int(2), Int(4), Int(6), Int(8)))))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(10), Int(14)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(1), Int(9)),
      CmpOp("==", ListExpr(Int(2), Int(4), Int(6), Int(8)))))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(3), Int(7)),
      CmpOp("==", ListExpr(Int(4), Int(6)))))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(8), Int(8)),
      CmpOp("==", ListExpr(Int(8)))))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(1), Int(1)),
      CmpOp("==", ListExpr()))))

exec
/bin/bash -lc "wc -l /reference/reference-semantics/semantics.k /reference/reference-semantics/semantics/*.k /candidate/verification.k /candidate/spec.k; rg -n '"'^'"\\s*(syntax|rule|claim|configuration|context|alias|endmodule|module|imports|requires)' /reference/reference-semantics /candidate/verification.k /candidate/spec.k" in /audit-output
