diff --git a/evidence/spec-witnesses.k b/evidence/spec-witnesses.k
new file mode 100644
index 0000000000000000000000000000000000000000..e2927be89863168f065ca04673089d0abc151cfb
--- /dev/null
+++ b/evidence/spec-witnesses.k
@@ -0,0 +1,98 @@
+requires "/tmp/audit-work/verification.k"
+
+module SPEC-WITNESSES
+  imports VERIFICATION
+
+  claim
+    <k>
+      #loadAll(solutionModule)
