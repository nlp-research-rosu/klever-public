+def generate_integers(a, b):
+    result = []
+    if (a <= 2 and 2 <= b) or (b <= 2 and 2 <= a):
+        result.append(2)
+    if (a <= 4 and 4 <= b) or (b <= 4 and 4 <= a):
+        result.append(4)
+    if (a <= 6 and 6 <= b) or (b <= 6 and 6 <= a):
+        result.append(6)
+    if (a <= 8 and 8 <= b) or (b <= 8 and 8 <= a):
+        result.append(8)
+    return result
+
+
+assert generate_integers(2, 8) == [2, 4, 6, 8]
+assert generate_integers(8, 2) == [2, 4, 6, 8]
+assert generate_integers(10, 14) == []
+assert generate_integers(1, 9) == [2, 4, 6, 8]
+assert generate_integers(3, 7) == [4, 6]
+assert generate_integers(8, 8) == [8]
+assert generate_integers(1, 1) == []
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..93b278d37d90e37490e18c52c8b7043a246d210b
