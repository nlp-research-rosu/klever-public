+assert generate_integers(8, 2) == [2, 4, 6, 8]
+assert generate_integers(10, 14) == []
+assert generate_integers(1, 9) == [2, 4, 6, 8]
+assert generate_integers(3, 7) == [4, 6]
+assert generate_integers(8, 8) == [8]
