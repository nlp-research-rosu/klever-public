Module(
  FuncDef("generate_integers", Params("a", "b"),
    Assign(Name("result"), ListExpr())
    If(BoolOp(
      "or",
      BoolOp(
        "and",
        Compare(Name("a"), CmpOp("<=", Int(2))),
        Compare(Int(2), CmpOp("<=", Name("b")))),
      BoolOp(
        "and",
        Compare(Name("b"), CmpOp("<=", Int(2))),
        Compare(Int(2), CmpOp("<=", Name("a"))))),
      Expr(Call(Attribute(Name("result"), "append"), Int(2))),
      )
    If(BoolOp(
      "or",
      BoolOp(
        "and",
        Compare(Name("a"), CmpOp("<=", Int(4))),
        Compare(Int(4), CmpOp("<=", Name("b")))),
      BoolOp(
        "and",
        Compare(Name("b"), CmpOp("<=", Int(4))),
        Compare(Int(4), CmpOp("<=", Name("a"))))),
      Expr(Call(Attribute(Name("result"), "append"), Int(4))),
      )
    If(BoolOp(
      "or",
      BoolOp(
        "and",
        Compare(Name("a"), CmpOp("<=", Int(6))),
        Compare(Int(6), CmpOp("<=", Name("b")))),
      BoolOp(
        "and",
        Compare(Name("b"), CmpOp("<=", Int(6))),
        Compare(Int(6), CmpOp("<=", Name("a"))))),
      Expr(Call(Attribute(Name("result"), "append"), Int(6))),
      )
    If(BoolOp(
      "or",
      BoolOp(
        "and",
        Compare(Name("a"), CmpOp("<=", Int(8))),
        Compare(Int(8), CmpOp("<=", Name("b")))),
      BoolOp(
        "and",
        Compare(Name("b"), CmpOp("<=", Int(8))),
        Compare(Int(8), CmpOp("<=", Name("a"))))),
      Expr(Call(Attribute(Name("result"), "append"), Int(8))),
      )
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(2), Int(8)),
      CmpOp("==", ListExpr(Int(2), Int(4), Int(6), Int(8)))))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(8), Int(2)),
      CmpOp("==", ListExpr(Int(2), Int(4), Int(6), Int(8)))))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(10), Int(14)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(1), Int(9)),
      CmpOp("==", ListExpr(Int(2), Int(4), Int(6), Int(8)))))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(3), Int(7)),
      CmpOp("==", ListExpr(Int(4), Int(6)))))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(8), Int(8)),
      CmpOp("==", ListExpr(Int(8)))))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(1), Int(1)),
      CmpOp("==", ListExpr()))))
