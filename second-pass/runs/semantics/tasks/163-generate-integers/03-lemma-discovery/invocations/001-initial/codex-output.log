import json
from pathlib import Path
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
inv=json.loads(Path('/reference/rule-inventory.json').read_text())
out=json.loads(Path('/workspace/trust-boundary.json').read_text())
assert list(out)==['schema_version','inventory_sha256','rules'], list(out)
assert out['schema_version']==2
assert out['inventory_sha256']==inv['inventory_sha256']
assert len(out['rules'])==len(inv['rules'])
expected=[r['source_rule_id'] for r in inv['rules']]
actual=[r['source_rule_id'] for r in out['rules']]
assert actual==expected
assert len(actual)==len(set(actual))
for r in out['rules']:
    assert list(r)==['source_rule_id','classification','rationale'], list(r)
    assert r['classification'] in allowed
    assert isinstance(r['rationale'],str) and r['rationale'].strip()
attrs={r['source_rule_id']:r.get('attributes',[]) for r in inv['rules']}
for r in out['rules']:
    if 'simplification' in attrs[r['source_rule_id']]:
        assert r['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
print(f\"validated {len(actual)} rules\")
from collections import Counter
print(dict(Counter(r['classification'] for r in out['rules'])))
print('inventory_sha256', out['inventory_sha256'])
PY
