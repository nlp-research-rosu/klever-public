Module(
  FuncDef("cycpattern_check", Params("a", "b"),
    Assign(Name("pattern"), Name("b"))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("b"),
      If(Compare(Name("pattern"), CmpOp("in", Name("a"))),
        Return(Bool(true)),
        )
      Assign(
        Name("pattern"),
        BinOp(
          "+",
          Subscript(Name("pattern"), Slice(Int(1), NoBound, NoBound)),
          Name("char"))))
    Return(Bool(false)))
  Assert(
    Compare(
      Call(Name("cycpattern_check"), Str("abcd"), Str("abd")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("cycpattern_check"), Str("hello"), Str("ell")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("cycpattern_check"), Str("whassup"), Str("psus")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("cycpattern_check"), Str("abab"), Str("baa")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("cycpattern_check"), Str("efef"), Str("eeff")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("cycpattern_check"), Str("himenss"), Str("simen")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("cycpattern_check"), Str(""), Str("")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("cycpattern_check"), Str("a"), Str("")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("cycpattern_check"), Str(""), Str("a")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("cycpattern_check"), Str("a"), Str("a")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("cycpattern_check"), Str("a"), Str("b")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("cycpattern_check"), Str("ab"), Str("ba")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("cycpattern_check"), Str("ab"), Str("aba")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("cycpattern_check"), Str("xxbcayy"), Str("abc")),
      CmpOp("==", Bool(true)))))
