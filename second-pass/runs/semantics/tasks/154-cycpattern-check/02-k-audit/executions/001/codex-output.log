+  </k>
+
+  // Documented false case.
+  claim <k>
+    rotationsLoop(
+      strToCodes("abcd"),
+      strToCodes("abd"),
+      strToCodes("abd"))
+    => false
+  </k>
+
+  // A later rotation ("baa" -> "aab" -> "aba") is found.
