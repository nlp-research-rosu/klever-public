+        isLen(S),
+        1)
+      ~> CONT:K
+    =>
+      dropOneConnection(S)
+      ~> CONT
+    </k>
+endmodule
diff --git a/evidence/slice-connection-spec.k b/evidence/slice-connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..8e945d135c018e5f84138e4bef6e6274ab71c3b2
--- /dev/null
+++ b/evidence/slice-connection-spec.k
@@ -0,0 +1,16 @@
+requires "/audit-output/evidence/slice-connection-verification.k"
+
+module SLICE-CONNECTION-SPEC
+  imports SLICE-CONNECTION
+
+  // Bridge-free fixed-semantics execution under an arbitrary continuation.
+  claim <k>
+    Subscript(
+      str(S:IntSeq),
+      Slice(Int(1), NoBound, NoBound))
+    ~> CONT:K
+  =>
+    str(dropOneConnection(S))
+    ~> CONT
+  </k>
+endmodule
