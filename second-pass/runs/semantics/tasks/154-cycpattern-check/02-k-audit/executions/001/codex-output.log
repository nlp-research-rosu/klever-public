+      ~> CONT
+    </k>
+
+  // Full arbitrary-sequence connection needed by the candidate shortcut.
+  claim [slice-value]:
+    <k>
+      buildIS(
+        S:IntSeq,
+        clampHi(1, isLen(S), 1),
+        isLen(S),
+        1)
+      ~> CONT:K
+    =>
+      dropOneConnection(S)
+      ~> CONT
+    </k>
+endmodule
