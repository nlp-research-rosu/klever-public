Module(
  FuncDef("after_slice", Params("s"),
    Assign(
      Name("tail"),
      Subscript(Name("s"), Slice(Int(1), NoBound, NoBound)))
    Assign(Name("marker"), Str("after"))
    Return(BinOp("+", Name("tail"), Name("marker"))))
  Assert(
    Compare(
      Call(Name("after_slice"), Str("")),
      CmpOp("==", Str("after"))))
  Assert(
    Compare(
      Call(Name("after_slice"), Str("a")),
      CmpOp("==", Str("after"))))
  Assert(
    Compare(
      Call(Name("after_slice"), Str("ab")),
      CmpOp("==", Str("bafter"))))
  Assert(
    Compare(
      Call(Name("after_slice"), Str("abcd")),
      CmpOp("==", Str("bcdafter")))))
