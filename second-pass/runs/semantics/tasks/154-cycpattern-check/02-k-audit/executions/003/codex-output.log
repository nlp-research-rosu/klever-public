+  // required to return the Boolean complement of its proven result summary.
+  // Satisfying witness: a="hello", b="ell" executes to true, while this RHS is
+  // notBool true = false.
+  claim [entry-point-negated-result]:
+    <k>
+      Call(
+        Name("cycpattern_check"),
+        str(A), str(B), .Exprs)
+    =>
+      notBool rotationsLoop(A, B, B)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "cycpattern_check" |->
+          closureVal(
+            ("a", "b", .ParamNames),
+            Assign(Name("pattern"), Name("b"))
+            Assign(Name("char"), Str(""))
+            For(
+              Name("char"),
+              Name("b"),
+              If(
+                Compare(
+                  Name("pattern"),
+                  CmpOp("in", Name("a"))),
+                Return(Bool(true)),
+                .Stmts)
+              Assign(
+                Name("pattern"),
+                BinOp(
+                  "+",
+                  Subscript(
+                    Name("pattern"),
+                    Slice(Int(1), NoBound, NoBound)),
+                  Name("char")))
+              .Stmts)
+            Return(Bool(false))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
