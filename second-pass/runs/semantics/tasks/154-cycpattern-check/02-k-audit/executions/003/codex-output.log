+#!/usr/bin/env bash
+set -u
+
+overall=0
+run() {
+  echo "\$ $*"
+  "$@"
+  status=$?
+  echo "EXIT: $status"
+  if [ "$status" -ne 0 ]; then overall=1; fi
+  return 0
+}
+
+cd /tmp/audit-work/fresh || exit 125
+run cp /audit-output/evidence/slice-connection.k /tmp/audit-work/fresh/slice-connection.k
+run kompile slice-connection.k \
+  --backend haskell \
+  --main-module SLICE-AUDIT \
+  --syntax-module MPY-SYNTAX \
+  --output-definition audit-slice-kompiled
+run kprove slice-connection.k \
+  --definition audit-slice-kompiled \
+  --spec-module SLICE-AUDIT-SPEC \
+  --output pretty
+echo "SLICE_CONNECTION_OVERALL_EXIT: $overall"
+exit "$overall"
diff --git a/evidence/spec-body-mutation.k b/evidence/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..a6d6534af6cb57fc8622715b4979241fff40f2ab
--- /dev/null
+++ b/evidence/spec-body-mutation.k
@@ -0,0 +1,54 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Body-sensitivity probe: the actual closure term returns true after the loop,
+  // while the original result summary remains unchanged.
+  claim [entry-body-mutated]:
+    <k>
+      Call(
+        Name("cycpattern_check"),
+        str(A), str(B), .Exprs)
+    =>
+      rotationsLoop(A, B, B)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "cycpattern_check" |->
+          closureVal(
+            ("a", "b", .ParamNames),
+            Assign(Name("pattern"), Name("b"))
+            Assign(Name("char"), Str(""))
+            For(
+              Name("char"),
+              Name("b"),
+              If(
+                Compare(
+                  Name("pattern"),
+                  CmpOp("in", Name("a"))),
+                Return(Bool(true)),
+                .Stmts)
+              Assign(
+                Name("pattern"),
+                BinOp(
+                  "+",
+                  Subscript(
+                    Name("pattern"),
+                    Slice(Int(1), NoBound, NoBound)),
+                  Name("char")))
+              .Stmts)
+            Return(Bool(true))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..3440e174e0cf704ca51aad8fa79a5d00c06a6b24
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,56 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Fresh false-postcondition mutation: the exact generated function body is
+  // required to return the Boolean complement of its proven result summary.
+  // Satisfying witness: a="hello", b="ell" executes to true, while this RHS is
+  // notBool true = false.
+  claim [entry-point-negated-result]:
+    <k>
+      Call(
+        Name("cycpattern_check"),
+        str(A), str(B), .Exprs)
+    =>
+      notBool rotationsLoop(A, B, B)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "cycpattern_check" |->
+          closureVal(
+            ("a", "b", .ParamNames),
+            Assign(Name("pattern"), Name("b"))
+            Assign(Name("char"), Str(""))
+            For(
+              Name("char"),
+              Name("b"),
+              If(
+                Compare(
+                  Name("pattern"),
+                  CmpOp("in", Name("a"))),
+                Return(Bool(true)),
+                .Stmts)
+              Assign(
+                Name("pattern"),
+                BinOp(
+                  "+",
+                  Subscript(
+                    Name("pattern"),
+                    Slice(Int(1), NoBound, NoBound)),
+                  Name("char")))
+              .Stmts)
+            Return(Bool(false))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
