@@ -0,0 +1,54 @@
+requires "reference-semantics/semantics.k"
+
+module SLICE-AUDIT
+  imports MPY
+
+  syntax IntSeq ::= auditDropOne(IntSeq) [function, total]
+  rule auditDropOne(.IntSeq) => .IntSeq
+  rule auditDropOne(iCons(_:Int, R:IntSeq)) => R
+endmodule
+
+module SLICE-AUDIT-SPEC
+  imports SLICE-AUDIT
+
+  // Bridge-free connection theorem for verification.k's s[1:] acceleration.
+  claim [slice-one-to-end]:
+    <k>
+      Subscript(
+        str(S:IntSeq),
+        Slice(Int(1), NoBound, NoBound))
+      ~> CONT
+    =>
+      str(auditDropOne(S))
+      ~> CONT
+    </k>
+endmodule
+
+module SLICE-AUDIT-GROUND-SPEC
+  imports SLICE-AUDIT
+
+  claim [slice-empty]:
+    <k>
+      Subscript(str(.IntSeq), Slice(Int(1), NoBound, NoBound))
+    =>
+      str(.IntSeq)
+    </k>
+
+  claim [slice-singleton]:
+    <k>
+      Subscript(
+        str(iCons(65, .IntSeq)),
+        Slice(Int(1), NoBound, NoBound))
+    =>
+      str(.IntSeq)
+    </k>
+
+  claim [slice-two]:
+    <k>
+      Subscript(
+        str(iCons(65, iCons(66, .IntSeq))),
+        Slice(Int(1), NoBound, NoBound))
+    =>
+      str(iCons(66, .IntSeq))
+    </k>
+endmodule
diff --git a/evidence/slice_connection_commands.sh b/evidence/slice_connection_commands.sh
new file mode 100644
index 0000000000000000000000000000000000000000..b7308b72f84bcfeed5dcbd5feef9210bc924d299
--- /dev/null
+++ b/evidence/slice_connection_commands.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -u
+
+overall=0
+run() {
+  echo "\$ $*"
+  "$@"
+  status=$?
+  echo "EXIT: $status"
+  if [ "$status" -ne 0 ]; then overall=1; fi
+  return 0
+}
+
+cd /tmp/audit-work/fresh || exit 125
+run cp /audit-output/evidence/slice-connection.k /tmp/audit-work/fresh/slice-connection.k
+run kompile slice-connection.k \
+  --backend haskell \
+  --main-module SLICE-AUDIT \
+  --syntax-module MPY-SYNTAX \
+  --output-definition audit-slice-kompiled
+run kprove slice-connection.k \
+  --definition audit-slice-kompiled \
+  --spec-module SLICE-AUDIT-SPEC \
+  --output pretty
+echo "SLICE_CONNECTION_OVERALL_EXIT: $overall"
+exit "$overall"
diff --git a/evidence/spec-body-mutation.k b/evidence/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..a6d6534af6cb57fc8622715b4979241fff40f2ab
--- /dev/null
+++ b/evidence/spec-body-mutation.k
@@ -0,0 +1,54 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Body-sensitivity probe: the actual closure term returns true after the loop,
+  // while the original result summary remains unchanged.
+  claim [entry-body-mutated]:
+    <k>
+      Call(
+        Name("cycpattern_check"),
+        str(A), str(B), .Exprs)
+    =>
+      rotationsLoop(A, B, B)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "cycpattern_check" |->
+          closureVal(
+            ("a", "b", .ParamNames),
+            Assign(Name("pattern"), Name("b"))
+            Assign(Name("char"), Str(""))
+            For(
+              Name("char"),
+              Name("b"),
+              If(
+                Compare(
+                  Name("pattern"),
+                  CmpOp("in", Name("a"))),
+                Return(Bool(true)),
+                .Stmts)
+              Assign(
+                Name("pattern"),
+                BinOp(
+                  "+",
+                  Subscript(
+                    Name("pattern"),
+                    Slice(Int(1), NoBound, NoBound)),
+                  Name("char")))
+              .Stmts)
+            Return(Bool(true))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..3440e174e0cf704ca51aad8fa79a5d00c06a6b24
