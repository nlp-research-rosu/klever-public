+run cp /candidate/spec.k /tmp/audit-work/fresh/spec.k
+run cp /candidate/verification.k /tmp/audit-work/fresh/verification.k
+run cp /candidate/concrete_tests.py /tmp/audit-work/fresh/concrete_tests.py
