+              If(
+                Compare(
+                  BinOp(
+                    "+",
+                    Subscript(
+                      Name("b"),
+                      Slice(Name("i"), NoBound, NoBound)),
+                    Subscript(
+                      Name("b"),
+                      Slice(NoBound, Name("i"), NoBound))),
+                  CmpOp("in", Name("a"))),
+                Return(Bool(true)),
+                .Stmts)
+              AugAssign(Name("i"), "+", Int(1))
+              .Stmts)
+            Return(Bool(false))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
