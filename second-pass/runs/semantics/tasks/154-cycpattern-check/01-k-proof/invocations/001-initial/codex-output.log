+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        str(REM),
+        Name("char"),
+        If(
+          Compare(Name("pattern"), CmpOp("in", Name("a"))),
+          Return(Bool(true)),
+          .Stmts)
+        Assign(
+          Name("pattern"),
+          BinOp(
+            "+",
+            Subscript(
+              Name("pattern"),
+              Slice(Int(1), NoBound, NoBound)),
+            Name("char")))
+        .Stmts)
+      ~> Return(Bool(false))
+      ~> #endcall
+    =>
+      #pop
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("a" |-> str(A))
+        ("b" |-> str(B))
+        ("char" |-> (str(CH) => str(?_:IntSeq)))
+        ("pattern" |-> (str(P) => str(?_:IntSeq))),
+        parent(0))
+      0 |-> scope(G, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <ret>
+      noRet => retV(rotationsLoop(A, P, REM))
+    </ret>
+    requires notBool "len" in_keys(G)
+
+  claim [entry-point]:
+    <k>
+      Call(
+        Name("cycpattern_check"),
+        str(A), str(B), .Exprs)
+    =>
+      rotationsLoop(A, B, B)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "cycpattern_check" |->
+          closureVal(
+            ("a", "b", .ParamNames),
+            Assign(Name("pattern"), Name("b"))
+            Assign(Name("char"), Str(""))
+            For(
+              Name("char"),
+              Name("b"),
+              If(
+                Compare(
+                  Name("pattern"),
+                  CmpOp("in", Name("a"))),
+                Return(Bool(true)),
+                .Stmts)
+              Assign(
+                Name("pattern"),
+                BinOp(
+                  "+",
+                  Subscript(
+                    Name("pattern"),
+                    Slice(Int(1), NoBound, NoBound)),
+                  Name("char")))
+              .Stmts)
+            Return(Bool(false))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
