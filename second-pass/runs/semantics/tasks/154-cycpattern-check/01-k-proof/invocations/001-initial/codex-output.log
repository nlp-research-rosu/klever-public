+  claim [entry-point]:
+    <k>
+      Call(
+        Name("cycpattern_check"),
+        str(A), str(B), .Exprs)
+    =>
+      rotationsContain(A, B, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "cycpattern_check" |->
+          closureVal(
+            ("a", "b", .ParamNames),
+            Assign(Name("i"), Int(0))
