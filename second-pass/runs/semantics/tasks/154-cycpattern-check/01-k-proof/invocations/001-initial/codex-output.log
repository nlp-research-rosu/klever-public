+              Subscript(Name("b"), Slice(NoBound, Name("i"), NoBound))),
+            CmpOp("in", Name("a"))),
+          Return(Bool(true)),
+          .Stmts)
+        AugAssign(Name("i"), "+", Int(1))
+        .Stmts)
+      ~> Return(Bool(false))
+      ~> #endcall
+    =>
+      Return(rotationsContain(A, B, I))
+      ~> #endcall
+    </k>
+    <env> L </env>
+    <scopes>
+      SC
+      (L |-> scope(
+        ("a" |-> str(A))
+        ("b" |-> str(B))
