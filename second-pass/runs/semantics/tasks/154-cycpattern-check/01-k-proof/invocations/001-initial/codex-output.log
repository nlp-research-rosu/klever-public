+                Name("i"),
+                CmpOp("<", Call(Name("len"), Name("b"), .Exprs))),
+              If(
+                Compare(
+                  BinOp(
+                    "+",
+                    Subscript(
+                      Name("b"),
+                      Slice(Name("i"), NoBound, NoBound)),
+                    Subscript(
+                      Name("b"),
+                      Slice(NoBound, Name("i"), NoBound))),
+                  CmpOp("in", Name("a"))),
+                Return(Bool(true)),
+                .Stmts)
+              AugAssign(Name("i"), "+", Int(1))
+              .Stmts)
+            Return(Bool(false))
