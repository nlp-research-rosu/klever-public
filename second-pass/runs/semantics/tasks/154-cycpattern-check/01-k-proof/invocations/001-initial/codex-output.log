diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f88cc2061b77a033d4ac196e0f41a15baf884e99
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,88 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #while(
+        Compare(Name("i"), CmpOp("<", Call(Name("len"), Name("b"), .Exprs))),
+        If(
+          Compare(
+            BinOp(
+              "+",
+              Subscript(Name("b"), Slice(Name("i"), NoBound, NoBound)),
+              Subscript(Name("b"), Slice(NoBound, Name("i"), NoBound))),
+            CmpOp("in", Name("a"))),
+          Return(Bool(true)),
+          .Stmts)
+        AugAssign(Name("i"), "+", Int(1))
+        .Stmts)
+      ~> Return(Bool(false))
+      ~> #endcall
+    =>
+      #pop
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("a" |-> str(A))
+        ("b" |-> str(B))
+        ("i" |-> I),
+        parent(0))
+      0 |-> scope(G, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <ret>
+      noRet => retV(rotationsContain(A, B, I))
+    </ret>
+    requires 0 <=Int I andBool I <=Int isLen(B)
+     andBool notBool "len" in_keys(G)
+
+  claim [entry-point]:
+    <k>
+      Call(
+        Name("cycpattern_check"),
+        str(A), str(B), .Exprs)
+    =>
+      rotationsContain(A, B, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "cycpattern_check" |->
+          closureVal(
+            ("a", "b", .ParamNames),
+            Assign(Name("i"), Int(0))
+            While(
+              Compare(
+                Name("i"),
+                CmpOp("<", Call(Name("len"), Name("b"), .Exprs))),
+              If(
+                Compare(
+                  BinOp(
+                    "+",
+                    Subscript(
+                      Name("b"),
+                      Slice(Name("i"), NoBound, NoBound)),
+                    Subscript(
+                      Name("b"),
+                      Slice(NoBound, Name("i"), NoBound))),
+                  CmpOp("in", Name("a"))),
+                Return(Bool(true)),
+                .Stmts)
+              AugAssign(Name("i"), "+", Int(1))
+              .Stmts)
+            Return(Bool(false))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
