+          Return(Bool(true)),
+          .Stmts)
+        Assign(
+          Name("pattern"),
+          BinOp(
+            "+",
+            Subscript(
+              Name("pattern"),
+              Slice(Int(1), NoBound, NoBound)),
+            Name("char")))
+        .Stmts)
+      ~> Return(Bool(false))
+      ~> #endcall
+    =>
