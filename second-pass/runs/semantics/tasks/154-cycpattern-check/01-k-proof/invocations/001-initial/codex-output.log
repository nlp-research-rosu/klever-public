+requires "verification.k"
+
+module SPEC-LEMMA
+  imports VERIFICATION-BASE
+
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        str(REM),
+        Name("char"),
+        If(
+          Compare(Name("pattern"), CmpOp("in", Name("a"))),
+          Return(Bool(true)),
+          .Stmts)
+        Assign(
+          Name("pattern"),
+          BinOp(
+            "+",
+            Subscript(
+              Name("pattern"),
+              Slice(Int(1), NoBound, NoBound)),
+            Name("char")))
+        .Stmts)
+      ~> (Return(Bool(false)) .Stmts)
+      ~> #endcall
+    =>
+      rotationsLoop(A, P, REM)
+      ~> CONT
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (1 |-> scope(
+         ("a" |-> str(A))
+         ("b" |-> str(B))
+         ("char" |-> str(CH))
+         ("pattern" |-> str(P)),
+         parent(0))
+       0 |-> scope(G, parent(-1))
+       -1 |-> BS:Scope)
+    =>
