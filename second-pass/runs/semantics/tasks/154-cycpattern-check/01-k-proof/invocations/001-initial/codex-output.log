--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,16 @@
+def cycpattern_check(a, b):
+    pattern = b
+    for char in b:
+        if pattern in a:
+            return True
+        pattern = pattern[1:] + char
+    return False
+
+
+assert cycpattern_check("abcd", "abd") == False
