+
+  claim [loop-invariant]:
+    <k>
+      #while(
+        Compare(Name("i"), CmpOp("<", Call(Name("len"), Name("b"), .Exprs))),
+        If(
+          Compare(
+            BinOp(
+              "+",
+              Subscript(Name("b"), Slice(Name("i"), NoBound, NoBound)),
+              Subscript(Name("b"), Slice(NoBound, Name("i"), NoBound))),
+            CmpOp("in", Name("a"))),
+          Return(Bool(true)),
+          .Stmts)
+        AugAssign(Name("i"), "+", Int(1))
+        .Stmts)
+      ~> Return(Bool(false))
+      ~> #endcall
+    =>
+      Return(rotationsContain(A, B, I))
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("a" |-> str(A))
+        ("b" |-> str(B))
+        ("i" |-> I),
+        parent(0))
+      0 |-> scope(G, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    requires 0 <=Int I andBool I <=Int isLen(B)
+     andBool notBool "len" in_keys(G)
+
+  claim [entry-point]:
+    <k>
