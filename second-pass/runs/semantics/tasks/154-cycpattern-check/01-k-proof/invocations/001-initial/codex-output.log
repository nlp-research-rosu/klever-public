diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..cce7ea581ff9479fb8540f5471e2ca23de7c832f
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,91 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [loop-invariant]:
+    <k>
+      #loop(
+        str(REM),
+        Name("char"),
+        If(
+          Compare(Name("pattern"), CmpOp("in", Name("a"))),
+          Return(Bool(true)),
+          .Stmts)
+        Assign(
+          Name("pattern"),
+          BinOp(
+            "+",
+            Subscript(
+              Name("pattern"),
+              Slice(Int(1), NoBound, NoBound)),
+            Name("char")))
+        .Stmts)
+      ~> Return(Bool(false))
+      ~> #endcall
+    =>
+      #pop
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        M
+        ("a" |-> str(A))
+        ("pattern" |-> str(P)),
+        parent(0))
+      0 |-> scope(G, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <ret>
+      noRet => retV(rotationsLoop(A, P, REM))
+    </ret>
+    requires notBool "a" in_keys(M)
+     andBool notBool "pattern" in_keys(M)
+     andBool notBool "len" in_keys(G)
+
+  claim [entry-point]:
+    <k>
+      Call(
+        Name("cycpattern_check"),
+        str(A), str(B), .Exprs)
+    =>
+      rotationsLoop(A, B, B)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "cycpattern_check" |->
+          closureVal(
+            ("a", "b", .ParamNames),
+            Assign(Name("pattern"), Name("b"))
+            For(
+              Name("char"),
+              Name("b"),
+              If(
+                Compare(
+                  Name("pattern"),
+                  CmpOp("in", Name("a"))),
+                Return(Bool(true)),
+                .Stmts)
+              Assign(
+                Name("pattern"),
+                BinOp(
+                  "+",
+                  Subscript(
+                    Name("pattern"),
+                    Slice(Int(1), NoBound, NoBound)),
+                  Name("char")))
+              .Stmts)
+            Return(Bool(false))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
