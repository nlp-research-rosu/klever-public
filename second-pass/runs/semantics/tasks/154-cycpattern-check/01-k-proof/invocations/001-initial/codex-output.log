diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..17ba12d75cfd1270d7cf395b2ad3f232b5be5722
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,58 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Let symbolic Boolean conditions split the same way concrete true/false
+  // conditions do. The reference rules already handle ground Booleans.
+  rule <k> #branch(C:Bool, T:Stmts, _:Stmts) => T ... </k>
+       requires C
+  rule <k> #branch(C:Bool, _:Stmts, E:Stmts) => E ... </k>
+       requires notBool C
+
+  // Total prefix/drop views. These are proof-side names for the two valid,
+  // unit-step slices used by the program.
+  syntax IntSeq ::= takePrefix(IntSeq, Int) [function, total]
+                  | dropPrefix(IntSeq, Int) [function, total]
+
+  rule takePrefix(_:IntSeq, 0) => .IntSeq
+  rule takePrefix(iCons(C:Int, R:IntSeq), N:Int)
+    => iCons(C, takePrefix(R, N -Int 1))
+       requires N >Int 0
+  rule takePrefix(.IntSeq, N:Int) => .IntSeq
+       requires N >Int 0
+
+  rule dropPrefix(S:IntSeq, 0) => S
+  rule dropPrefix(iCons(_:Int, R:IntSeq), N:Int)
+    => dropPrefix(R, N -Int 1)
+       requires N >Int 0
+  rule dropPrefix(.IntSeq, N:Int) => .IntSeq
+       requires N >Int 0
+
+  // For 0 <= i <= len(b), these equations are immediate inductions over b.
+  // Priority keeps buildIS from first exposing its partial indexing helper.
+  rule buildIS(B:IntSeq, I:Int, STOP:Int, 1) => dropPrefix(B, I)
+       requires STOP ==Int isLen(B)
+        andBool 0 <=Int I andBool I <=Int STOP
+       [priority(30)]
+  rule buildIS(B:IntSeq, 0, I:Int, 1) => takePrefix(B, I)
+       requires 0 <=Int I andBool I <=Int isLen(B)
+       [priority(30)]
+
+  // The characters of b[i:] + b[:i], for an in-bounds rotation index i.
+  syntax IntSeq ::= rotationAt(IntSeq, Int) [function, total]
+  rule rotationAt(B:IntSeq, I:Int)
+    => seqConcat(dropPrefix(B, I), takePrefix(B, I))
+
+  // Search the rotations at indices i, i + 1, ..., len(b) - 1.
+  syntax Bool ::= rotationsContain(IntSeq, IntSeq, Int) [function]
+  rule rotationsContain(_:IntSeq, B:IntSeq, I:Int) => false
+       requires I >=Int isLen(B)
+  rule rotationsContain(A:IntSeq, B:IntSeq, I:Int) => true
+       requires I <Int isLen(B)
+        andBool strContains(rotationAt(B, I), A)
+  rule rotationsContain(A:IntSeq, B:IntSeq, I:Int)
+    => rotationsContain(A, B, I +Int 1)
+       requires I <Int isLen(B)
+        andBool notBool strContains(rotationAt(B, I), A)
+endmodule

