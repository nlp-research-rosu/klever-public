Module(
  FuncDef("cycpattern_check", Params("a", "b"),
    Assign(Name("pattern"), Name("b"))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("b"),
      If(Compare(Name("pattern"), CmpOp("in", Name("a"))),
        Return(Bool(true)),
        )
      Assign(
        Name("pattern"),
        BinOp(
          "+",
          Subscript(Name("pattern"), Slice(Int(1), NoBound, NoBound)),
          Name("char"))))
    Return(Bool(false))))
