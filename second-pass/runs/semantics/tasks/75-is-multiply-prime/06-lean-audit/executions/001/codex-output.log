new file mode 100644
index 0000000000000000000000000000000000000000..05384dcb8cce2e5a6597fff8960bc5c4b34c0b1c
--- /dev/null
+++ b//tmp/audit-work/proc_self_exe_compat.c
@@ -0,0 +1,17 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static readlink_fn next;
+  if (!next) next = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  if (strncmp(path, "/proc/", 6) == 0) {
+    const char *suffix = strrchr(path, '/');
+    if (suffix && strcmp(suffix, "/exe") == 0)
+      return next("/proc/self/exe", buf, size);
+  }
+  return next(path, buf, size);
+}
diff --git a//tmp/audit-work/trace_paths.c b//tmp/audit-work/trace_paths.c
new file mode 100644
index 0000000000000000000000000000000000000000..364bfc72954030873ca21bdd26d04802ec298e18
--- /dev/null
+++ b//tmp/audit-work/trace_paths.c
@@ -0,0 +1,44 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+typedef char *(*getcwd_fn)(char *, size_t);
+typedef char *(*realpath_fn)(const char *, char *);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static readlink_fn next;
+  if (!next) next = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  ssize_t result = next(path, buf, size);
+  int saved = errno;
+  dprintf(2, "TRACE readlink(%s, %zu) = %zd errno=%d value=%.*s\n",
+          path, size, result, saved, result > 0 ? (int)result : 0, buf);
+  errno = saved;
+  return result;
+}
+
+char *getcwd(char *buf, size_t size) {
+  static getcwd_fn next;
+  if (!next) next = (getcwd_fn)dlsym(RTLD_NEXT, "getcwd");
+  char *result = next(buf, size);
+  int saved = errno;
+  dprintf(2, "TRACE getcwd(%zu) = %s errno=%d\n",
+          size, result ? result : "(null)", saved);
+  errno = saved;
+  return result;
+}
+
+char *realpath(const char *path, char *resolved) {
+  static realpath_fn next;
+  if (!next) next = (realpath_fn)dlsym(RTLD_NEXT, "realpath");
+  char *result = next(path, resolved);
+  int saved = errno;
+  dprintf(2, "TRACE realpath(%s) = %s errno=%d\n",
+          path, result ? result : "(null)", saved);
+  errno = saved;
+  return result;
+}
