index 0000000000000000000000000000000000000000..9bab0c7e131e07a13b39f14afb1d6166ce74adb8
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,21 @@
+def is_multiply_prime(a):
+    factor_count = 0
+    factor = 2
+
+    while factor * factor <= a:
+        if a % factor == 0:
+            factor_count += 1
+            a //= factor
+        else:
+            factor += 1
+
+    if a > 1:
+        factor_count += 1
+
+    return factor_count == 3
+
+
+assert is_multiply_prime(30)
+assert is_multiply_prime(8)
+assert not is_multiply_prime(10)
+assert not is_multiply_prime(-7)
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..1efb48020f856805671e0bf5b09e2db76bcdb660
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,16 @@
+def is_multiply_prime(a):
+    """Return whether a has exactly three prime factors, with multiplicity."""
+    factor_count = 0
+    factor = 2
+
+    while factor * factor <= a:
+        if a % factor == 0:
+            factor_count += 1
+            a //= factor
+        else:
+            factor += 1
+
+    if a > 1:
+        factor_count += 1
+
+    return factor_count == 3
