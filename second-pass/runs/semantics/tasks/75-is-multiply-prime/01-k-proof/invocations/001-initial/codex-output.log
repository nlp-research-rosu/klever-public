import re
from itertools import product
from pathlib import Path

text = Path('spec.k').read_text()
cases = [(int(n), b == 'true') for n, b in re.findall(
    r'#runIsMultiplyPrime\\((\\d+)\\)\\s*~>\\s*#expect\\((true|false)\\)', text
)]
assert [n for n, _ in cases] == list(range(2, 100))

def prime(n):
    return n >= 2 and all(n % d for d in range(2, int(n ** 0.5) + 1))

primes = [n for n in range(2, 100) if prime(n)]
products3 = {a * b * c for a, b, c in product(primes, repeat=3)}
assert all(expected == (n in products3) for n, expected in cases)
assert 'requires A <Int 2' in text
print('spec covers every integer below 100 and matches the independent prime-product oracle')
PY" in /work
