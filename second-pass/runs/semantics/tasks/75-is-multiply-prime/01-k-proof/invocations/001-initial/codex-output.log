+                   Compare(Name("a"), CmpOp(">", Int(1))),
+                   AugAssign(Name("factor_count"), "+", Int(1)),
+                   .Stmts)
+                 Return(
+                   Compare(
+                     Name("factor_count"),
+                     CmpOp("==", Int(3)))),
+                 0)),
+             (A, .Vals)) ... </k>
+endmodule

