     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // The Module term below is the exact program generated in solution.mpy.
     7	  // #forgetEntryPoint removes only the module binding installed by #loadAll,
     8	  // restoring the initial proof state between exhaustive checkpoints.
     9	  syntax KItem ::= #runIsMultiplyPrime(Int)
    10	                 | "#forgetEntryPoint"
    11	                 | #expect(Bool)
    12	
    13	  // A concrete result can pass its checkpoint only when it is the expected
    14	  // Boolean. A wrong result leaves the proof configuration stuck.
    15	  rule <k> B:Bool ~> #expect(B) => .K ... </k>
    16	
    17	  rule <k> #runIsMultiplyPrime(A:Int)
    18	        => #loadAll(
    19	             Module(
    20	               FuncDef(
    21	                 "is_multiply_prime",
    22	                 Params("a"),
    23	                 Expr(
    24	                   Str(
    25	                     "Return whether a has exactly three prime factors, with multiplicity."))
    26	                 Assign(Name("factor_count"), Int(0))
    27	                 Assign(Name("factor"), Int(2))
    28	                 While(
    29	                   Compare(
    30	                     BinOp("*", Name("factor"), Name("factor")),
    31	                     CmpOp("<=", Name("a"))),
    32	                   If(
    33	                     Compare(
    34	                       BinOp("%", Name("a"), Name("factor")),
    35	                       CmpOp("==", Int(0))),
    36	                     AugAssign(Name("factor_count"), "+", Int(1))
    37	                     AugAssign(Name("a"), "//", Name("factor")),
    38	                     AugAssign(Name("factor"), "+", Int(1))))
    39	                 If(
    40	                   Compare(Name("a"), CmpOp(">", Int(1))),
    41	                   AugAssign(Name("factor_count"), "+", Int(1)),
    42	                   .Stmts)
    43	                 Return(
    44	                   Compare(
    45	                     Name("factor_count"),
    46	                     CmpOp("==", Int(3)))))))
    47	           ~> Call(Name("is_multiply_prime"), Int(A))
    48	           ~> #forgetEntryPoint ... </k>
    49	
    50	  rule <k> B:Bool ~> #forgetEntryPoint => B ... </k>
    51	       <scopes>
    52	         ... 0 |-> scope(
    53	           M:Map => M [ "is_multiply_prime" <- undef ],
    54	           parent(-1))
    55	         ...
    56	       </scopes>
    57	    requires "is_multiply_prime" in_keys(M)
    58	endmodule
