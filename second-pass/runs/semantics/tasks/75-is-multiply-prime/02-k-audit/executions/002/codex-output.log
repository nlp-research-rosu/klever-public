+++ b//tmp/audit-work/75-is-multiply-prime/verification-body-mutant.k
@@ -1,6 +1,6 @@
 requires "reference-semantics/semantics.k"
 
-module VERIFICATION
+module VERIFICATION-BODY-MUTANT
   imports MPY
 
   // The Module term below is the exact program generated in solution.mpy.
@@ -43,7 +43,7 @@
                  Return(
                    Compare(
                      Name("factor_count"),
-                     CmpOp("==", Int(3)))))))
+                     CmpOp("==", Int(4)))))))
            ~> Call(Name("is_multiply_prime"), Int(A))
            ~> #forgetEntryPoint ... </k>
 
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..0d6a5a6d7202c931542f3f805d085c69424abce7
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: run_logged.sh LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_file=$1
+shift
+
+mkdir -p "$(dirname "$log_file")"
+{
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf '%s\n' '--- OUTPUT ---'
+} >"$log_file"
+
+"$@" > >(tee -a "$log_file") 2> >(tee -a "$log_file" >&2)
+status=$?
+
+{
+  printf '\n%s\n' '--- END OUTPUT ---'
+  printf 'EXIT_STATUS: %d\n' "$status"
+} >>"$log_file"
+
+exit "$status"
