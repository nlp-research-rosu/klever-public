     1	def is_multiply_prime(a):
     2	    """Return whether a has exactly three prime factors, with multiplicity."""
     3	    factor_count = 0
     4	    factor = 2
     5	
     6	    while factor * factor <= a:
     7	        if a % factor == 0:
     8	            factor_count += 1
     9	            a //= factor
    10	        else:
    11	            factor += 1
    12	
    13	    if a > 1:
    14	        factor_count += 1
    15	
    16	    return factor_count == 3
===== /candidate/solution.mpy =====
     1	Module(
     2	  FuncDef("is_multiply_prime", Params("a"),
     3	    Expr(
     4	      Str(
     5	        "Return whether a has exactly three prime factors, with multiplicity."))
     6	    Assign(Name("factor_count"), Int(0))
     7	    Assign(Name("factor"), Int(2))
     8	    While(Compare(
     9	      BinOp("*", Name("factor"), Name("factor")),
    10	      CmpOp("<=", Name("a"))),
    11	      If(Compare(
    12	        BinOp("%", Name("a"), Name("factor")),
    13	        CmpOp("==", Int(0))),
    14	        AugAssign(Name("factor_count"), "+", Int(1))
    15	        AugAssign(Name("a"), "//", Name("factor")),
    16	        AugAssign(Name("factor"), "+", Int(1))))
    17	    If(Compare(Name("a"), CmpOp(">", Int(1))),
