     6	def is_multiply_prime(a):
     7	    """Write a function that returns true if the given number is the multiplication of 3 prime numbers
     8	    and false otherwise.
     9	    Knowing that (a) is less then 100. 
    10	    Example:
    11	    is_multiply_prime(30) == True
    12	    30 = 2 * 3 * 5
    13	    """
    14	    def is_prime(n):
    15	        for j in range(2,n):
    16	            if n%j == 0:
    17	                return False
    18	        return True
    19	
    20	    for i in range(2,101):
    21	        if not is_prime(i): continue
    22	        for j in range(2,101):
    23	            if not is_prime(j): continue
    24	            for k in range(2,101):
    25	                if not is_prime(k): continue
    26	                if i*j*k == a: return True
    27	    return False
