     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Translate the submitted implementation with the fixed front end.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# Required concrete LLVM definition and representative end-to-end execution.
     8	kompile reference-semantics/semantics.k \
     9	  --backend llvm \
    10	  --main-module MPY-KRUN \
    11	  --syntax-module MPY-SYNTAX \
    12	  --output-definition runtime-kompiled
    13	python3 py2mpy.py smoke.py > smoke.mpy
    14	krun smoke.mpy --definition runtime-kompiled
    15	
    16	# The proof definition imports MPY (not its concrete-only MPY-KRUN extension).
    17	kompile verification.k \
    18	  --backend haskell \
    19	  --main-module VERIFICATION \
    20	  --syntax-module VERIFICATION \
    21	  --output-definition verification-kompiled
