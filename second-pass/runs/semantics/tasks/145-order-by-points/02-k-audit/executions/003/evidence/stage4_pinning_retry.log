COMMAND: sed -n 1,120p pinning-spec.k
requires "verification.k"

module REVIEWER-PINNING-SPEC
  imports ORDER-BY-POINTS-VERIFICATION

  claim
    <k> solutionModule
         =>
         Module(
           FuncDef("digit_sum", Params("n"),
             Assign(Name("negative"), Compare(Name("n"), CmpOp("<", Int(0))))
             Assign(Name("n"), Call(Name("abs"), Name("n")))
             Assign(Name("total"), Int(0))
             Assign(Name("most_significant"), Int(0))
             While(Name("n"),
               Assign(Name("most_significant"), BinOp("%", Name("n"), Int(10)))
               AugAssign(Name("total"), "+", Name("most_significant"))
               AugAssign(Name("n"), "//", Int(10)))
             If(Name("negative"),
               AugAssign(
                 Name("total"),
                 "-",
                 BinOp("*", Int(2), Name("most_significant"))),
               )
             Return(Name("total")))
           FuncDef("order_by_points", Params("nums"),
             Return(
               Call(
                 Name("sorted"),
                 Name("nums"),
                 KwArg("key", Name("digit_sum"))))))
    </k>
  [label(module_identity)]
endmodule
EXIT_STATUS: 0
