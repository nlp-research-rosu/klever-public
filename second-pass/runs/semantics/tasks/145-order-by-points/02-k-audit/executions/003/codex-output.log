+  /tmp/audit-work/source/solution.regenerated.mpy
+printf 'EXIT_STATUS: %s\n' "$?"
+
+printf '%s\n' 'COMMAND: python3 /audit-output/evidence/differential_test.py'
+python3 /audit-output/evidence/differential_test.py
+printf 'EXIT_STATUS: %s\n' "$?"
