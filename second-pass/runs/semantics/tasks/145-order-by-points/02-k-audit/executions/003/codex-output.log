+    <k> #runDigitSum(11) => 2 </k>
+    <env> 0 </env>
+    <scopes> initialScopes => loadedScopes </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+  [label(ds11)]
+
+  claim
+    <k> #runDigitSum(-1) => -1 </k>
+    <env> 0 </env>
+    <scopes> initialScopes => loadedScopes </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+  [label(ds_neg1)]
+
+  claim
+    <k> #runDigitSum(-11) => 0 </k>
+    <env> 0 </env>
+    <scopes> initialScopes => loadedScopes </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+  [label(ds_neg11)]
+
+  claim
+    <k> #runDigitSum(-12) => 1 </k>
+    <env> 0 </env>
+    <scopes> initialScopes => loadedScopes </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+  [label(ds_neg12)]
+
+  claim
+    <k> #runDigitSum(-123) => 4 </k>
+    <env> 0 </env>
+    <scopes> initialScopes => loadedScopes </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+  [label(ds_neg123)]
+
+  claim
