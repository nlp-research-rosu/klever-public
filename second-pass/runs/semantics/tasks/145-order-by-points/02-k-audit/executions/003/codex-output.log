diff --git a//tmp/audit-work/source/opposite-interpretation.k b//tmp/audit-work/source/opposite-interpretation.k
new file mode 100644
index 0000000000000000000000000000000000000000..a4c158c55fd1e0dfcd257b323e3b079cc7175d13
--- /dev/null
+++ b//tmp/audit-work/source/opposite-interpretation.k
@@ -0,0 +1,10 @@
+requires "verification.k"
+
+module OPPOSITE-INTERPRETATION
+  imports ORDER-BY-POINTS-VERIFICATION
+
+  // Deliberately false interpretation: keyed sort reverses every input.
+  // This is not a proposed fix; it probes whether the original opaque symbol
+  // has any equation constraining it to the intended keyed-sort behavior.
+  rule sortKeyVS(VS:ValSeq, _:Val) => revVS(VS)
+endmodule
diff --git a//tmp/audit-work/source/reviewer_concrete.py b//tmp/audit-work/source/reviewer_concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..8b462882cbd6804453c76dab3b1194efdafedf28
--- /dev/null
+++ b//tmp/audit-work/source/reviewer_concrete.py
@@ -0,0 +1,24 @@
+def digit_sum(n):
+    negative = n < 0
+    n = abs(n)
+    total = 0
+    most_significant = 0
+    while n:
+        most_significant = n % 10
+        total += most_significant
+        n //= 10
+    if negative:
+        total -= 2 * most_significant
+    return total
+
+
+def order_by_points(nums):
+    return sorted(nums, key=digit_sum)
+
+
+assert order_by_points([]) == []
+assert order_by_points([0]) == [0]
+assert order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]
+assert order_by_points([-9, -10, -11, -99, -100, -101]) == [-9, -10, -100, -11, -99, -101]
+assert order_by_points([11, 20, 101, 2]) == [11, 20, 101, 2]
+assert order_by_points([11, 11, -11, -11, 20, 20]) == [-11, -11, 11, 11, 20, 20]
diff --git a//tmp/audit-work/source/spec-labeled.k b//tmp/audit-work/source/spec-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..1f9b7c76100e76ca108ccb22066f2bc643ee3e47
--- /dev/null
+++ b//tmp/audit-work/source/spec-labeled.k
@@ -0,0 +1,105 @@
+requires "verification.k"
+
+module ORDER-BY-POINTS-SPEC-LABELED
+  imports ORDER-BY-POINTS-VERIFICATION
+
+  claim
+    <k> #runDigitSum(0) => 0 </k>
+    <env> 0 </env>
+    <scopes> initialScopes => loadedScopes </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+  [label(ds0)]
+
+  claim
+    <k> #runDigitSum(1) => 1 </k>
+    <env> 0 </env>
+    <scopes> initialScopes => loadedScopes </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+  [label(ds1)]
+
+  claim
+    <k> #runDigitSum(11) => 2 </k>
+    <env> 0 </env>
+    <scopes> initialScopes => loadedScopes </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+  [label(ds11)]
+
+  claim
+    <k> #runDigitSum(-1) => -1 </k>
+    <env> 0 </env>
+    <scopes> initialScopes => loadedScopes </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+  [label(ds_neg1)]
+
+  claim
+    <k> #runDigitSum(-11) => 0 </k>
+    <env> 0 </env>
+    <scopes> initialScopes => loadedScopes </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+  [label(ds_neg11)]
+
+  claim
+    <k> #runDigitSum(-12) => 1 </k>
