+
+  // Deliberately false interpretation: keyed sort reverses every input.
+  // This is not a proposed fix; it probes whether the original opaque symbol
+  // has any equation constraining it to the intended keyed-sort behavior.
+  rule sortKeyVS(VS:ValSeq, _:Val) => revVS(VS)
+endmodule
