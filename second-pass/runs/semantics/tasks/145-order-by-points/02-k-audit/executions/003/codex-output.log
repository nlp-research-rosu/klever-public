diff --git a//tmp/audit-work/source/reviewer_concrete.py b//tmp/audit-work/source/reviewer_concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..b12e0d0f63f4f10157d8b57d5670722cfc91fc58
--- /dev/null
+++ b//tmp/audit-work/source/reviewer_concrete.py
@@ -0,0 +1,24 @@
+def digit_sum(n):
+    negative = n < 0
+    n = abs(n)
+    total = 0
+    most_significant = 0
+    while n:
+        most_significant = n % 10
+        total += most_significant
+        n //= 10
+    if negative:
+        total -= 2 * most_significant
+    return total
+
+
+def order_by_points(nums):
+    return sorted(nums, key=digit_sum)
+
+
+assert order_by_points([]) == []
+assert order_by_points([0]) == [0]
+assert order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]
+assert order_by_points([-9, -10, -11, -99, -100, -101]) == [-9, -10, -11, -100, -101, -99]
+assert order_by_points([11, 20, 101, 2]) == [11, 20, 101, 2]
+assert order_by_points([11, 11, -11, -11, 20, 20]) == [-11, -11, 11, 11, 20, 20]
