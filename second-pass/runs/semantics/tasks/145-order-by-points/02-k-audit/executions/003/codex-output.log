+
+print('requires "verification.k"')
+print()
+print("module REVIEWER-PINNING-SPEC")
+print("  imports ORDER-BY-POINTS-VERIFICATION")
+print()
+print("  claim")
+print("    <k> solutionModule")
+print("         =>")
