+diff -r --no-dereference /candidate/reference-semantics /reference/reference-semantics
+record_status "$?"
+
+printf '%s\n' 'COMMAND: cmp -s /candidate/prompt.py /reference/prompt.py'
+cmp -s /candidate/prompt.py /reference/prompt.py
+record_status "$?"
