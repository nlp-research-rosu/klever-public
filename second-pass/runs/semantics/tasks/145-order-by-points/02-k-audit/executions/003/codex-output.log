+
+run_and_record kompile \
+  /tmp/audit-work/source/verification.k \
+  --backend haskell \
+  --main-module ORDER-BY-POINTS-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition /tmp/audit-work/source/verification-kompiled

