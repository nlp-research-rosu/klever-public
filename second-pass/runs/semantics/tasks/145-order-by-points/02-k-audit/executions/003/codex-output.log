+requires "verification.k"
+
+module ORDER-BY-POINTS-SPEC-LABELED
+  imports ORDER-BY-POINTS-VERIFICATION
+
+  claim
+    <k> #runDigitSum(0) => 0 </k>
+    <env> 0 </env>
+    <scopes> initialScopes => loadedScopes </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+  [label(ds0)]
+
+  claim
+    <k> #runDigitSum(1) => 1 </k>
+    <env> 0 </env>
+    <scopes> initialScopes => loadedScopes </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+  [label(ds1)]
+
