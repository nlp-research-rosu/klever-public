diff --git a/evidence/stage3_prove_each.sh b/evidence/stage3_prove_each.sh
new file mode 100644
index 0000000000000000000000000000000000000000..046d9231884db3c640959540690f506b724e0ea2
--- /dev/null
+++ b/evidence/stage3_prove_each.sh
@@ -0,0 +1,41 @@
+#!/usr/bin/env bash
+set -u
+cd /tmp/audit-work/source
+
+claims=(
+  ds0
+  ds1
+  ds11
+  ds_neg1
+  ds_neg11
+  ds_neg12
+  ds_neg123
+  order_symbolic
+)
+
+overall=0
+for claim_name in "${claims[@]}"; do
+  log="/audit-output/evidence/kprove_${claim_name}.log"
+  printf '%s\n' \
+    "COMMAND: kprove spec-labeled.k --definition verification-kompiled --spec-module ORDER-BY-POINTS-SPEC-LABELED --claims ${claim_name}" \
+    > "$log"
+  kprove \
+    spec-labeled.k \
+    --definition verification-kompiled \
+    --spec-module ORDER-BY-POINTS-SPEC-LABELED \
+    --claims "$claim_name" \
+    >> "$log" 2>&1
+  status=$?
+  printf 'EXIT_STATUS: %s\n' "$status" >> "$log"
+  printf '%s claim=%s top_count=%s\n' \
+    "RESULT:" \
+    "$claim_name" \
+    "$(rg -c '^#Top$' "$log" || true)"
+  printf 'EXIT_STATUS: %s\n' "$status"
+  if [[ "$status" -ne 0 ]] || ! rg -q '^#Top$' "$log"; then
+    overall=1
+  fi
+done
+
+printf 'OVERALL_EXIT_STATUS: %s\n' "$overall"
+exit "$overall"

diff --git a//tmp/audit-work/source/reviewer_concrete.py b//tmp/audit-work/source/reviewer_concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..8b462882cbd6804453c76dab3b1194efdafedf28
--- /dev/null
+++ b//tmp/audit-work/source/reviewer_concrete.py
@@ -0,0 +1,24 @@
+def digit_sum(n):
+    negative = n < 0
+    n = abs(n)
+    total = 0
+    most_significant = 0
+    while n:
+        most_significant = n % 10
+        total += most_significant
+        n //= 10
+    if negative:
+        total -= 2 * most_significant
+    return total
+
+
+def order_by_points(nums):
+    return sorted(nums, key=digit_sum)
+
+
+assert order_by_points([]) == []
+assert order_by_points([0]) == [0]
+assert order_by_points([1, 11, -1, -11, -12]) == [-1, -11, 1, -12, 11]
+assert order_by_points([-9, -10, -11, -99, -100, -101]) == [-9, -10, -100, -11, -99, -101]
+assert order_by_points([11, 20, 101, 2]) == [11, 20, 101, 2]
+assert order_by_points([11, 11, -11, -11, 20, 20]) == [-11, -11, 11, 11, 20, 20]
