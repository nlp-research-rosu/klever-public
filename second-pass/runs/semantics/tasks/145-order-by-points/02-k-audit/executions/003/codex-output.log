+printf 'EXIT_STATUS: %s\n' "$?"
+
+printf '%s\n' 'COMMAND: kast solution.regenerated.mpy --definition runtime-kompiled --sort Module --output kast > regenerated-module.kast'
+kast \
+  solution.regenerated.mpy \
