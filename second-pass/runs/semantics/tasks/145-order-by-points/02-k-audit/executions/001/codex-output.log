+          .Stmts,
+          .Stmts)
+        Return(Name("total"))
+        .Stmts)
+      FuncDef("order_by_points", Params(("nums", .ParamNames)),
+        Return(
+          Call(
+            Name("sorted"),
+            (Name("nums"),
+             KwArg("key", Name("digit_sum")),
+             .Exprs)))
+        .Stmts)
+      .Stmts))
+    </k>
+    <env> 0 </env>
+    <scopes> initialScopes </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
