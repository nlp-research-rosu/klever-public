Module(
  FuncDef("digit_sum", Params("n"),
    Assign(Name("negative"), Compare(Name("n"), CmpOp("<", Int(0))))
    Assign(Name("n"), Call(Name("abs"), Name("n")))
    Assign(Name("total"), Int(0))
    Assign(Name("most_significant"), Int(0))
    While(Name("n"),
      Assign(Name("most_significant"), BinOp("%", Name("n"), Int(10)))
      AugAssign(Name("total"), "+", Name("most_significant"))
      AugAssign(Name("n"), "//", Int(10)))
    If(Name("negative"),
      AugAssign(
        Name("total"),
        "-",
        BinOp("*", Int(2), Name("most_significant"))),
      )
    Return(Name("total")))
  FuncDef("order_by_points", Params("nums"),
    Return(
      Call(
        Name("sorted"),
        Name("nums"),
        KwArg("key", Name("digit_sum")))))
  Assert(
    Compare(
      Call(
        Name("order_by_points"),
        ListExpr(
          Int(1),
          Int(11),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(11)),
          UnaryOp("-", Int(12)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(11)),
          Int(1),
          UnaryOp("-", Int(12)),
          Int(11)))))
  Assert(
    Compare(
      Call(Name("order_by_points"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("order_by_points"),
        ListExpr(
          Int(0),
          UnaryOp("-", Int(10)),
          Int(100),
          Int(2),
          UnaryOp("-", Int(2)),
          Int(20))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(10)),
          Int(0),
          Int(100),
          Int(2),
          Int(20)))))
  Assert(
    Compare(
      Call(
        Name("order_by_points"),
        ListExpr(
          Int(99),
          UnaryOp("-", Int(123)),
          Int(8),
          Int(80),
          UnaryOp("-", Int(9)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(9)),
          UnaryOp("-", Int(123)),
          Int(8),
          Int(80),
          Int(99))))))
