new file mode 100644
index 0000000000000000000000000000000000000000..e5a0a2c39bac325c82cb0dcacdddff6ab1c1ca45
--- /dev/null
+++ b/evidence/semantic_domain_witness.py
@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+"""Print source-level outputs for the two mixed-numeric K-semantics witnesses."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+
+def load(module_name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    assert spec is not None and spec.loader is not None
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.common
+
+
+canonical = load("canonical_witness", Path("/reference/canonical.py"))
+generated = load("generated_witness", Path("/tmp/audit-work/58-common-002/solution.py"))
+
+for first, second in (([True], [1]), ([1], [1.0])):
+    expected = canonical(first.copy(), second.copy())
+    actual = generated(first.copy(), second.copy())
+    print(f"FIRST={first!r} SECOND={second!r} canonical={expected!r} generated={actual!r}")
+    assert expected == actual and expected
+
+print("SOURCE_WITNESSES_OK")

The detailed seven-stage review, trust ledger, exhaustive rule inventory, and preserved evidence are complete. Final consistency checks confirmed all three fresh positive logs contain #Top/exit 0, both negative probes fail as expected, and REVIEW.md ends with the required FAIL / NOT_LEGIT markers.
  ✓ Read required Kit skills and verify audit manifests/mount integrity
  ✓ Check source fidelity and run independent Python differential tests
  ✓ Rebuild K definitions and rerun all positive proof claims from scratch
  ✓ Audit claim adequacy, real-program pinning, and concrete witnesses
  ✓ Inventory and review every semantics/verification rule for soundness
  ✓ Create and run a fresh false non-vacuity mutation
  ✓ Account for proven vs assumed boundaries and write REVIEW.md verdict
