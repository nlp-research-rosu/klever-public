+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      0 |-> list(commonSpec(FIRST, SECOND))
+      1 |-> list(.ValSeq)
+    </heap>
