+              commonBody,
+              0
+            ),
+          parent(-1)
+        )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      0 |-> list(commonSpec(FIRST, SECOND))
+      1 |-> list(.ValSeq)
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
