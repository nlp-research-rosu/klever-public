     path=(prefix+rel).encode(); data=c
     rec=(path+sep+data if order==0 else data+sep+path)+end
     h.update(hashlib.sha256(rec).digest())
    if h.hexdigest()==exp: print('MATCHREC',prefix,sep,end,order)
print('done')
