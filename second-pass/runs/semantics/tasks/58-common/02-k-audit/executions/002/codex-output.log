diff --git a//tmp/audit-work/58-common-002/semantic-mismatch-bool.py b//tmp/audit-work/58-common-002/semantic-mismatch-bool.py
new file mode 100644
index 0000000000000000000000000000000000000000..dee81a70ccd54852e5bbbaff232bf424ee707f7e
--- /dev/null
+++ b//tmp/audit-work/58-common-002/semantic-mismatch-bool.py
@@ -0,0 +1,10 @@
+def common(l1: list, l2: list):
+    result = []
+    item = 0
+    for item in l1:
+        if item in l2 and item not in result:
+            result.append(item)
+    return sorted(result)
+
+
+assert common([True], [1]) == [True]
