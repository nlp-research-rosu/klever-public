+++ b/evidence/stage6/mutation_witness.py
@@ -0,0 +1,15 @@
+#!/usr/bin/env python3
+"""Show why returning heap object 0 is observably false for a ground input."""
+
+first = [2, 2, 1, 1]
+second = [1, 2, 2]
+heap_0_accumulator = [2, 1]
+heap_1_sorted_return = [1, 2]
+
+print(f"FIRST={first}")
+print(f"SECOND={second}")
+print(f"mutated ref(0) denotes accumulator={heap_0_accumulator}")
+print(f"actual ref(1) denotes sorted return={heap_1_sorted_return}")
+print(f"observable_values_differ={heap_0_accumulator != heap_1_sorted_return}")
+
+assert heap_0_accumulator != heap_1_sorted_return
diff --git a/evidence/stage6/spec-vacuity.k b/evidence/stage6/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..9644807839e20ca99e03ca5f427bb7f0820bbbe3
--- /dev/null
+++ b/evidence/stage6/spec-vacuity.k
@@ -0,0 +1,44 @@
+requires "spec.k"
+
+module SPEC-VACUITY
+  imports SPEC
+
+  // Fresh false mutation: the real execution returns the newly allocated
+  // sorted-list object at heap location 1, not the accumulator object at 0.
+  claim [wrong-return-ref]:
+    <k>
+      #loadAll(Module(commonDefinition))
+      ~> Call(Name("common"), list(FIRST:ValSeq), list(SECOND:ValSeq))
+    =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0 |->
+        scope(
+          "common" |->
+            closureVal(
+              ("l1", "l2"),
+              commonBody,
+              0
+            ),
+          parent(-1)
+        )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      0 |-> list(commonSpec(FIRST, SECOND))
+      1 |-> list(sortVS(commonSpec(FIRST, SECOND)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
