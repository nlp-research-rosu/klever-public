/bin/bash -lc '/audit-output/evidence/run_logged.sh /audit-output/evidence/stage6/kprove_false_mutation.log kprove spec-vacuity.k --definition verification-kompiled --spec-module SPEC-VACUITY --claims SPEC.member-fold,SPEC.common-loop,SPEC-VACUITY.wrong-return-ref --trusted SPEC.member-fold,SPEC.common-loop --output pretty' in /tmp/audit-work/case58
