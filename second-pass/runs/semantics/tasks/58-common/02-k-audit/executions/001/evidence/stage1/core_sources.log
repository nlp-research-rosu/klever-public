===== /candidate/verification.k
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // The exact translated body of solution.py, factored into named syntax so
     7	  // both the loop invariant and the function-level claim use the same term.
     8	  syntax Stmts ::= "commonLoopBody" [macro]
     9	  rule commonLoopBody =>
    10	    If(
    11	      BoolOp(
    12	        "and",
    13	        Compare(Name("item"), CmpOp("in", Name("l2"))),
    14	        Compare(Name("item"), CmpOp("not in", Name("result")))
    15	      ),
    16	      Expr(Call(Attribute(Name("result"), "append"), Name("item"))),
    17	      .Stmts
    18	    )
    19	
    20	  syntax Stmts ::= "commonBody" [macro]
    21	  rule commonBody =>
    22	    Assign(Name("result"), ListExpr(.Exprs))
    23	    Assign(Name("item"), Int(0))
    24	    For(Name("item"), Name("l1"), commonLoopBody)
    25	    Return(Call(Name("sorted"), Name("result")))
    26	
    27	  syntax Stmt ::= "commonDefinition" [macro]
    28	  rule commonDefinition =>
    29	    FuncDef("common", Params("l1", "l2"), commonBody)
    30	
    31	  // Mathematical membership.  spec.k proves separately that this recursive
    32	  // function is exactly the supplied #memberAcc operational fold.
    33	  syntax Bool ::= memberVS(Val, ValSeq) [function, total]
    34	  rule memberVS(_:Val, .ValSeq) => false [simplification]
    35	  rule memberVS(V:Val, vCons(E:Val, _:ValSeq)) => true
    36	    requires V ==K E
    37	    [simplification]
    38	  rule memberVS(V:Val, vCons(E:Val, REST:ValSeq)) =>
    39	    memberVS(V, REST)
    40	    requires notBool (V ==K E)
    41	    [simplification]
    42	
    43	  syntax Bool ::= shouldAdd(Val, ValSeq, ValSeq) [function, total]
    44	  rule shouldAdd(V:Val, SECOND:ValSeq, ACC:ValSeq) =>
    45	    memberVS(V, SECOND) andBool notBool memberVS(V, ACC)
    46	
    47	  // commonAcc scans FIRST from left to right, retains precisely the elements
    48	  // that occur in SECOND, and suppresses later duplicates using ACC.
    49	  syntax ValSeq ::= commonAcc(ValSeq, ValSeq, ValSeq) [function, total]
    50	  rule commonAcc(.ValSeq, _:ValSeq, ACC:ValSeq) => ACC
    51	  rule commonAcc(vCons(V:Val, REST:ValSeq), SECOND:ValSeq, ACC:ValSeq) =>
    52	    #if shouldAdd(V, SECOND, ACC)
    53	    #then
    54	      commonAcc(
    55	        REST,
    56	        SECOND,
    57	        valSeqConcat(ACC, vCons(V, .ValSeq))
    58	      )
    59	    #else commonAcc(REST, SECOND, ACC)
    60	    #fi
    61	
    62	  syntax ValSeq ::= commonSpec(ValSeq, ValSeq) [function, total]
    63	  rule commonSpec(FIRST:ValSeq, SECOND:ValSeq) =>
    64	    commonAcc(FIRST, SECOND, .ValSeq)
    65	
    66	  // The loop writes each yielded element to `item`; this helper describes that
    67	  // otherwise irrelevant final local binding and makes the invariant exact.
    68	  syntax Val ::= lastAfter(ValSeq, Val) [function, total]
    69	  rule lastAfter(.ValSeq, OLD:Val) => OLD
    70	  rule lastAfter(vCons(V:Val, REST:ValSeq), _:Val) =>
    71	    lastAfter(REST, V)
    72	endmodule
