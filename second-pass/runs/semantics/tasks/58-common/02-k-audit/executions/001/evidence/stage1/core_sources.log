     6	
     7	def common(l1: list, l2: list):
     8	    """Return sorted unique common elements for two lists.
     9	    >>> common([1, 4, 3, 34, 653, 2, 5], [5, 7, 1, 5, 9, 653, 121])
    10	    [1, 5, 653]
    11	    >>> common([5, 3, 2, 8], [3, 2])
    12	    [2, 3]
    13	
    14	    """
    15	    ret = set()
    16	    for e1 in l1:
    17	        for e2 in l2:
    18	            if e1 == e2:
    19	                ret.add(e1)
    20	    return sorted(list(ret))
===== /candidate/solution.py
     1	def common(l1: list, l2: list):
     2	    result = []
     3	    item = 0
     4	    for item in l1:
     5	        if item in l2 and item not in result:
     6	            result.append(item)
     7	    return sorted(result)
