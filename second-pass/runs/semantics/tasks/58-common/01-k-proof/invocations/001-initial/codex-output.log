+    [5, 7, 1, 5, 9, 653, 121],
+) == [1, 5, 653]
+assert common([5, 3, 2, 8], [3, 2]) == [2, 3]
+assert common([], [1, 2]) == []
+assert common([2, 2, 1, 1], [1, 2, 2]) == [1, 2]
