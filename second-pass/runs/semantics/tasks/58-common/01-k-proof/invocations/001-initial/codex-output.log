+  // Membership in a semantic value sequence.  The supplied list-membership
+  // rules use the same K equality test, so this is the mathematical model of
+  // Python's `item in xs` for the supported value domain.
+  syntax Bool ::= inVS(Val, ValSeq) [function, total]
+  rule inVS(_:Val, .ValSeq) => false
+  rule inVS(V:Val, vCons(E:Val, R:ValSeq)) => true
+    requires E ==K V
+  rule inVS(V:Val, vCons(E:Val, R:ValSeq)) => inVS(V, R)
+    requires notBool (E ==K V)
+
