@@ -0,0 +1,81 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The exact translated body of solution.py, factored into named syntax so
+  // both the loop invariant and the function-level claim use the same term.
+  syntax Stmts ::= "commonLoopBody" [macro]
+  rule commonLoopBody =>
+    If(
+      BoolOp(
+        "and",
+        Compare(Name("item"), CmpOp("in", Name("l2"))),
+        Compare(Name("item"), CmpOp("not in", Name("result")))
+      ),
+      Expr(Call(Attribute(Name("result"), "append"), Name("item"))),
+      .Stmts
+    )
+
+  syntax Stmts ::= "commonBody" [macro]
+  rule commonBody =>
+    Assign(Name("result"), ListExpr(.Exprs))
+    Assign(Name("item"), Int(0))
+    For(Name("item"), Name("l1"), commonLoopBody)
+    Return(Call(Name("sorted"), Name("result")))
+
+  syntax Stmt ::= "commonDefinition" [macro]
+  rule commonDefinition =>
+    FuncDef("common", Params("l1", "l2"), commonBody)
+
+  // A typed mathematical view of integer-valued Python lists.  Keeping this
+  // datatype separate makes all symbolic element equalities SMT-decidable.
+  syntax IntVals ::= ".IntVals" | ivCons(Int, IntVals)
+
+  syntax ValSeq ::= toValSeq(IntVals) [function, total]
+  rule toValSeq(.IntVals) => .ValSeq
+  rule toValSeq(ivCons(I:Int, REST:IntVals)) =>
+    vCons(I, toValSeq(REST))
+
+  syntax IntVals ::= snocInt(IntVals, Int) [function, total]
+  rule snocInt(.IntVals, I:Int) => ivCons(I, .IntVals)
+  rule snocInt(ivCons(H:Int, REST:IntVals), I:Int) =>
+    ivCons(H, snocInt(REST, I))
+
+  syntax Bool ::= intIn(Int, IntVals) [function, total]
+  rule intIn(_:Int, .IntVals) => false
+  rule intIn(I:Int, ivCons(J:Int, _:IntVals)) => true
+    requires I ==Int J
+  rule intIn(I:Int, ivCons(J:Int, REST:IntVals)) => intIn(I, REST)
+    requires I =/=Int J
+
+  syntax Bool ::= shouldAdd(Int, IntVals, IntVals) [function, total]
+  rule shouldAdd(I:Int, SECOND:IntVals, ACC:IntVals) =>
+    intIn(I, SECOND) andBool notBool intIn(I, ACC)
+
+  // commonAcc scans FIRST from left to right, retains precisely the elements
+  // that occur in SECOND, and suppresses later duplicates using ACC.
+  syntax IntVals ::= commonAcc(IntVals, IntVals, IntVals) [function, total]
+  rule commonAcc(.IntVals, _:IntVals, ACC:IntVals) => ACC
+  rule commonAcc(ivCons(I:Int, REST:IntVals), SECOND:IntVals, ACC:IntVals) =>
+    #if shouldAdd(I, SECOND, ACC)
+    #then
+      commonAcc(
+        REST,
+        SECOND,
+        snocInt(ACC, I)
+      )
+    #else commonAcc(REST, SECOND, ACC)
+    #fi
+
+  syntax ValSeq ::= commonSpec(IntVals, IntVals) [function, total]
+  rule commonSpec(FIRST:IntVals, SECOND:IntVals) =>
+    toValSeq(commonAcc(FIRST, SECOND, .IntVals))
+
+  // The loop writes each yielded element to `item`; this helper describes that
+  // otherwise irrelevant final local binding and makes the invariant exact.
+  syntax Val ::= lastAfter(IntVals, Val) [function, total]
+  rule lastAfter(.IntVals, OLD:Val) => OLD
+  rule lastAfter(ivCons(I:Int, REST:IntVals), _:Val) =>
+    lastAfter(REST, I)
+endmodule

