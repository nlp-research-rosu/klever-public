diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..bb860629a6587801ea37e9ca66bacbc042d7f247
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,90 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // The semantics implements list membership as an iterator fold.  This lemma
+  // connects that operational fold to the mathematical intIn function.
+  claim [member-fold]:
+    <k>
+      #memberAcc(I:Int, list(toValSeq(XS:IntVals))) ~> CONT:K
+    =>
+      intIn(I, XS) ~> CONT
+    </k>
+
+  // Inductive loop invariant.  The result heap object is transformed exactly
+  // by commonAcc; all unrelated scope and heap entries remain unchanged.
+  claim [common-loop]:
+    <k>
+      #loop(list(toValSeq(FIRST:IntVals)), Name("item"), commonLoopBody)
+      ~> CONT:K
+    =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |->
+        scope(
+          ("l1" |-> list(toValSeq(ORIGINAL:IntVals)))
+          ("l2" |-> list(toValSeq(SECOND:IntVals)))
+          ("result" |-> ref(H:Int))
+          ("item" |-> (OLD:Val => lastAfter(FIRST, OLD)))
+          .Map,
+          parent(0)
+        )
+      ...
+    </scopes>
+    <heap>
+      ... H |->
+        list(
+          toValSeq(ACC:IntVals)
+        =>
+          toValSeq(commonAcc(FIRST, SECOND, ACC))
+        )
+      ...
+    </heap>
+
+  // Whole-function correctness from the pristine semantic configuration.
+  // sorted is the reference semantics' trusted ascending-sort primitive;
+  // commonSpec is the unique intersection defined above.
+  claim [common-function]:
+    <k>
+      #loadAll(Module(commonDefinition))
+      ~> Call(
+           Name("common"),
+           list(toValSeq(FIRST:IntVals)),
+           list(toValSeq(SECOND:IntVals))
+         )
+    =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0 |->
+        scope(
+          "common" |->
+            closureVal(
+              ("l1", "l2"),
+              commonBody,
+              0
+            ),
+          parent(-1)
+        )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      0 |-> list(commonSpec(FIRST, SECOND))
+      1 |-> list(sortVS(commonSpec(FIRST, SECOND)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
