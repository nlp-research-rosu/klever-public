Module(
  FuncDef("common", Params("l1", "l2"),
    Assign(Name("result"), ListExpr())
    Assign(Name("item"), Int(0))
    For(Name("item"), Name("l1"),
      If(BoolOp(
        "and",
        Compare(Name("item"), CmpOp("in", Name("l2"))),
        Compare(Name("item"), CmpOp("not in", Name("result")))),
        Expr(Call(Attribute(Name("result"), "append"), Name("item"))),
        ))
    Return(Call(Name("sorted"), Name("result"))))
  Assert(
    Compare(
      Call(
        Name("common"),
        ListExpr(
          Int(1),
          Int(4),
          Int(3),
          Int(34),
          Int(653),
          Int(2),
          Int(5)),
        ListExpr(
          Int(5),
          Int(7),
          Int(1),
          Int(5),
          Int(9),
          Int(653),
          Int(121))),
      CmpOp("==", ListExpr(Int(1), Int(5), Int(653)))))
  Assert(
    Compare(
      Call(
        Name("common"),
        ListExpr(Int(5), Int(3), Int(2), Int(8)),
        ListExpr(Int(3), Int(2))),
      CmpOp("==", ListExpr(Int(2), Int(3)))))
  Assert(
    Compare(
      Call(Name("common"), ListExpr(), ListExpr(Int(1), Int(2))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("common"),
        ListExpr(Int(2), Int(2), Int(1), Int(1)),
        ListExpr(Int(1), Int(2), Int(2))),
      CmpOp("==", ListExpr(Int(1), Int(2))))))
