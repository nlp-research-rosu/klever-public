Module(
  FuncDef("greatest_common_divisor", Params("a", "b"),
    Assign(Name("a"), Call(Name("abs"), Name("a")))
    Assign(Name("b"), Call(Name("abs"), Name("b")))
    While(Compare(Name("b"), CmpOp("!=", Int(0))),
      Assign(
        TupleExpr(Name("a"), Name("b")),
        TupleExpr(Name("b"), BinOp("%", Name("a"), Name("b")))))
    Return(Name("a")))
  Assert(
    Compare(
      Call(Name("greatest_common_divisor"), Int(3), Int(5)),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("greatest_common_divisor"), Int(25), Int(15)),
      CmpOp("==", Int(5))))
  Assert(
    Compare(
      Call(
        Name("greatest_common_divisor"),
        UnaryOp("-", Int(54)),
        Int(24)),
      CmpOp("==", Int(6))))
  Assert(
    Compare(
      Call(Name("greatest_common_divisor"), Int(0), Int(0)),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("greatest_common_divisor"),
        Int(0),
        UnaryOp("-", Int(9))),
      CmpOp("==", Int(9)))))
