+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires D:Int >=Int 0
+    ensures ?G >=Int 0
+      andBool commonDivisor(?G, absInt(A0), absInt(B0))
+      andBool (notBool commonDivisor(D, absInt(A0), absInt(B0))
+               orBool dividesZ(D, ?G))
