+def greatest_common_divisor(a: int, b: int) -> int:
+    a = abs(a)
+    b = abs(b)
+    while b != 0:
+        a, b = b, a % b
+    return a
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..47b7be2b2606a808c4c969ecbeb189e88fb18f4b
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,102 @@
+requires "verification.k"
+
+module GCD-SPEC
+  imports GCD-VERIFICATION
+
+  // Universal loop-refinement theorem.  The proof-only observer is an
+  // executable Euclidean specification: it advances exactly once per program
+  // iteration and accepts only the same nonnegative terminal result.
+  claim
+    <k>
+      #while(GcdCondition, GcdLoopBody)
+      ~> Return(Name("a"))
+      ~> #endcall
+      => gcdVerified(?G:Int)
+    </k>
+    <env> L:Int => CALLER:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(("a" |-> A:Int
+                   "b" |-> B:Int), P:Parent)
+      => SC
+    </scopes>
+    <scopeLoc> L +Int 1 => L </scopeLoc>
+    <heap> .Map </heap>
+    <stack>
+      ListItem(frame(#gcdCheck(A, B), CALLER, L)) REST:List
+      => REST
+    </stack>
+    <ret> noRet </ret>
+    requires A >=Int 0 andBool B >=Int 0
+    ensures ?G >=Int 0
+    [label(loop-refines-spec)]
+
+  // Whole submitted program, for arbitrary signed integer arguments.
+  // The two abs calls establish the nonnegative Euclidean precondition.
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"),
+              (A0:Int, B0:Int, .Exprs))
+      ~> #gcdCheck(absInt(A0), absInt(B0))
+      => gcdVerified(?G:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    ensures ?G >=Int 0
+    [label(program-refines-spec)]
+
+  // Prompt examples are also proved directly to exact values.
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"), (3, 5, .Exprs))
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    [label(example-3-5)]
+
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"), (25, 15, .Exprs))
+      => 5
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    [label(example-25-15)]
+endmodule
