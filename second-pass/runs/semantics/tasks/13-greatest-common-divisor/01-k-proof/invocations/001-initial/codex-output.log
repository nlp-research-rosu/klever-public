+  // Zero-aware divisibility: 0 divides only 0.  This makes the standard
+  // divisibility characterization cover gcd(0, 0) = 0 without a partial mod.
+  syntax Bool ::= dividesZ(Int, Int) [function, total]
+  rule dividesZ(N:Int, N) => true
+    requires N >=Int 0
+    [simplification]
+  rule dividesZ(D:Int, 0) => true
+    requires D >=Int 0
+    [simplification]
+  rule dividesZ(0, N:Int) => N ==Int 0
+  rule dividesZ(D:Int, N:Int) => (N %Int D) ==Int 0
+    requires D =/=Int 0
+
+  syntax Bool ::= commonDivisor(Int, Int, Int) [function, total]
+  rule commonDivisor(D:Int, A:Int, B:Int) =>
+    dividesZ(D, A) andBool dividesZ(D, B)
+endmodule

codex
The arithmetic abstraction is now stable: symbolic inputs are summarized to an opaque `gcdSpec(abs(a), abs(b))`, while `gcdSpec` evaluates by the same Euclidean recurrence on concrete inputs. This prevents symbolic divergence without weakening the concrete path. The universal claim and both exact prompt-example claims now each print `#Top`; I’m packaging those exact commands into `prove.sh` and doing a clean end-to-end rerun.
apply patch
