--- /dev/null
+++ b/verification.k
@@ -0,0 +1,46 @@
+requires "reference-semantics/semantics.k"
+
+module GCD-VERIFICATION
+  imports MPY
+
+  // These macros are the exact constructor tree emitted in solution.mpy.
+  // Keeping the tree here lets kprove reason about the submitted program,
+  // while the shell check in prove.sh prevents the two copies from drifting.
+  syntax Stmt ::= "GcdDef" [macro]
+  syntax Stmts ::= "GcdBody" [macro]
+
+  rule GcdDef =>
+    FuncDef("greatest_common_divisor", Params("a", "b"), GcdBody)
+
+  rule GcdBody =>
+    Assign(Name("a"), Call(Name("abs"), (Name("a"), .Exprs)))
+    Assign(Name("b"), Call(Name("abs"), (Name("b"), .Exprs)))
+    While(Compare(Name("b"), CmpOp("!=", Int(0))),
+      Assign(TupleExpr((Name("a"), Name("b"), .Exprs)),
+             TupleExpr((Name("b"),
+                        BinOp("%", Name("a"), Name("b")), .Exprs)))
+      .Stmts)
+    Return(Name("a"))
+    .Stmts
+
+  syntax Val ::= "GcdClosure" [macro]
+  rule GcdClosure =>
+    closureVal(("a", "b", .ParamNames), GcdBody, 0)
+
+  // Zero-aware divisibility: 0 divides only 0.  This makes the standard
+  // divisibility characterization cover gcd(0, 0) = 0 without a partial mod.
+  syntax Bool ::= dividesZ(Int, Int) [function, total]
+  rule dividesZ(N:Int, N) => true
+    requires N >=Int 0
+    [simplification]
+  rule dividesZ(D:Int, 0) => true
+    requires D >=Int 0
+    [simplification]
+  rule dividesZ(0, N:Int) => N ==Int 0
+  rule dividesZ(D:Int, N:Int) => (N %Int D) ==Int 0
+    requires D =/=Int 0
+
+  syntax Bool ::= commonDivisor(Int, Int, Int) [function, total]
+  rule commonDivisor(D:Int, A:Int, B:Int) =>
+    dividesZ(D, A) andBool dividesZ(D, B)
+endmodule

exec
/bin/bash -lc 'kprove arith_spec.k --definition verification-kompiled --spec-module ARITH-SPEC --claims common-forward' in /work
diff --git a/arith_spec.k b/arith_spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..55d25733a54706d600b94f0e06baac9a3464375b
--- /dev/null
+++ b/arith_spec.k
@@ -0,0 +1,15 @@
+requires "verification.k"
+
+module ARITH-SPEC
+  imports GCD-VERIFICATION
+
+  claim <k> commonDivisor(D:Int, B:Int, pyMod(A:Int, B)) => true </k>
+    requires A >=Int 0 andBool B >Int 0 andBool D >=Int 0
+      andBool commonDivisor(D, A, B)
+    [label(common-forward)]
+
+  claim <k> commonDivisor(D:Int, A:Int, B:Int) => true </k>
+    requires A >=Int 0 andBool B >Int 0 andBool D >=Int 0
+      andBool commonDivisor(D, B, pyMod(A, B))
+    [label(common-backward)]
+endmodule
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..c9ffc060560dab863b78287b226f4597e13633a7
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,13 @@
+def greatest_common_divisor(a: int, b: int) -> int:
+    a = abs(a)
+    b = abs(b)
+    while b != 0:
+        a, b = b, a % b
+    return a
+
+
+assert greatest_common_divisor(3, 5) == 1
+assert greatest_common_divisor(25, 15) == 5
+assert greatest_common_divisor(-54, 24) == 6
+assert greatest_common_divisor(0, 0) == 0
+assert greatest_common_divisor(0, -9) == 9
