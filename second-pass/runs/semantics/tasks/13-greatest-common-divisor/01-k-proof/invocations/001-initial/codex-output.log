+requires "verification.k"
+
+module GCD-SPEC
+  imports GCD-VERIFICATION
+
+  // The submitted loop body implements one Euclidean transition under the
+  // unmodified reference rules.  This is the inductive step behind the
+  // symbolic loop summary in verification.k.
+  claim
+    <k> GcdLoopBody => .K </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(("a" |-> A:Int
+                   "b" |-> B:Int), P:Parent)
+      => SC
+         L |-> scope(("a" |-> B
+                      "b" |-> pyMod(A, B)), P)
+    </scopes>
+    <heap> .Map </heap>
+    requires A >=Int 0 andBool B >Int 0
+    [label(euclid-step)]
+
+  // For arbitrary signed integer arguments, the submitted function returns
+  // the mathematical gcd of their absolute values.  gcdSpec denotes the
+  // standard Euclidean recurrence and is kept opaque to avoid divergent
+  // symbolic expansion.
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"),
+              (A0:Int, B0:Int, .Exprs))
+      => gcdSpec(absInt(A0), absInt(B0))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    [label(program-correct)]
+
+  // Prompt examples are proved directly with the reference semantics.  The
+  // symbolic loop summary is inapplicable because both loop locals are
+  // concrete, so these also guard the implementation/specification linkage.
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"), (3, 5, .Exprs))
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    [label(example-3-5)]
+
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"), (25, 15, .Exprs))
+      => 5
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    [label(example-25-15)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d8716515169a957993a48b3c6d69b3f22de0a60c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,76 @@
+requires "reference-semantics/semantics.k"
+
+module GCD-VERIFICATION
+  imports MPY
+
+  // These macros are the exact constructor tree emitted in solution.mpy.
+  // Keeping the tree here lets kprove reason about the submitted program,
+  // while the shell check in prove.sh prevents the two copies from drifting.
+  syntax Stmt ::= "GcdDef" [macro]
+  syntax Stmts ::= "GcdBody" [macro]
+  syntax Expr ::= "GcdCondition" [macro]
+  syntax Stmts ::= "GcdLoopBody" [macro]
+
+  rule GcdDef =>
+    FuncDef("greatest_common_divisor", Params("a", "b"), GcdBody)
+
+  rule GcdCondition =>
+    Compare(Name("b"), CmpOp("!=", Int(0)))
+
+  rule GcdLoopBody =>
+    Assign(TupleExpr((Name("a"), Name("b"), .Exprs)),
+           TupleExpr((Name("b"),
+                      BinOp("%", Name("a"), Name("b")), .Exprs)))
+    .Stmts
+
+  rule GcdBody =>
+    Assign(Name("a"), Call(Name("abs"), (Name("a"), .Exprs)))
+    Assign(Name("b"), Call(Name("abs"), (Name("b"), .Exprs)))
+    While(GcdCondition, GcdLoopBody)
+    Return(Name("a"))
+    .Stmts
+
+  syntax Val ::= "GcdClosure" [macro]
+  rule GcdClosure =>
+    closureVal(("a", "b", .ParamNames), GcdBody, 0)
+
+  // Mathematical gcd, characterized by Euclid's recurrence.  It stays opaque
+  // to the backend so symbolic terms do not expand forever.
+  syntax Int ::= gcdSpec(Int, Int)
+    [function, symbol(gcdSpec), no-evaluators]
+  rule gcdSpec(A:Int, 0) => A
+    requires A >=Int 0
+    [concrete]
+  rule gcdSpec(A:Int, B:Int) => gcdSpec(B, pyMod(A, B))
+    requires A >=Int 0 andBool B >Int 0
+    [concrete]
+
+  // Inductive loop summary used only when at least one loop-state component
+  // is symbolic.  Concrete executions continue through the unmodified MPY
+  // rules; the exact-value claims below therefore remain independent probes.
+  rule <k> #while(GcdCondition, GcdLoopBody) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("a" |-> (A:Int => gcdSpec(A, B))
+                          "b" |-> (B:Int => 0)), P:Parent) ...
+       </scopes>
+    requires A >=Int 0 andBool B >=Int 0
+    [priority(40), symbolic(A, B)]
+
+  // Zero-aware divisibility: 0 divides only 0.  This makes the standard
+  // divisibility characterization cover gcd(0, 0) = 0 without a partial mod.
+  syntax Bool ::= dividesZ(Int, Int) [function, total]
+  rule dividesZ(N:Int, N) => true
+    requires N >=Int 0
+    [simplification]
+  rule dividesZ(D:Int, 0) => true
+    requires D >=Int 0
+    [simplification]
+  rule dividesZ(0, N:Int) => N ==Int 0
+  rule dividesZ(D:Int, N:Int) => (N %Int D) ==Int 0
+    requires D =/=Int 0
+
+  syntax Bool ::= commonDivisor(Int, Int, Int) [function, total]
+  rule commonDivisor(D:Int, A:Int, B:Int) =>
+    dividesZ(D, A) andBool dividesZ(D, B)
+endmodule

