+requires "verification.k"
+
+module GCD-SPEC
+  imports GCD-VERIFICATION
+
+  // Universal loop-refinement theorem.  The proof-only observer is an
+  // executable Euclidean specification: it advances exactly once per program
+  // iteration and accepts only the same nonnegative terminal result.
+  claim
+    <k>
+      #while(GcdCondition, GcdLoopBody)
+      ~> Return(Name("a"))
+      ~> #endcall
+      => gcdVerified(?G:Int)
+    </k>
+    <env> L:Int => CALLER:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(("a" |-> A:Int
+                   "b" |-> B:Int), P:Parent)
+      => (SC
+          L |-> scope(("a" |-> ?G:Int
+                       "b" |-> 0), P))[L <- undef]
+    </scopes>
+    <scopeLoc> L +Int 1 => L </scopeLoc>
+    <heap> .Map </heap>
+    <stack>
+      ListItem(frame(#gcdCheck(A, B), CALLER, L)) REST:List
+      => REST
+    </stack>
+    <ret> noRet </ret>
+    requires A >=Int 0 andBool B >=Int 0
+    ensures ?G >=Int 0
+    [label(loop-refines-spec)]
+
+  // Whole submitted program, for arbitrary signed integer arguments.
+  // The two abs calls establish the nonnegative Euclidean precondition.
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"),
+              (A0:Int, B0:Int, .Exprs))
+      ~> #gcdCheck(absInt(A0), absInt(B0))
+      => gcdVerified(?G:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    ensures ?G >=Int 0
+    [label(program-refines-spec)]
+
+  // Prompt examples are also proved directly to exact values.
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"), (3, 5, .Exprs))
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    [label(example-3-5)]
+
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"), (25, 15, .Exprs))
+      => 5
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    [label(example-25-15)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e0d1eff007c087f0571c92485d22ba7896f5e47c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,77 @@
+requires "reference-semantics/semantics.k"
+
+module GCD-VERIFICATION
+  imports MPY
+
+  // These macros are the exact constructor tree emitted in solution.mpy.
+  // Keeping the tree here lets kprove reason about the submitted program,
+  // while the shell check in prove.sh prevents the two copies from drifting.
+  syntax Stmt ::= "GcdDef" [macro]
+  syntax Stmts ::= "GcdBody" [macro]
+  syntax Expr ::= "GcdCondition" [macro]
+  syntax Stmts ::= "GcdLoopBody" [macro]
+
+  rule GcdDef =>
+    FuncDef("greatest_common_divisor", Params("a", "b"), GcdBody)
+
+  rule GcdCondition =>
+    Compare(Name("b"), CmpOp("!=", Int(0)))
+
+  rule GcdLoopBody =>
+    Assign(TupleExpr((Name("a"), Name("b"), .Exprs)),
+           TupleExpr((Name("b"),
+                      BinOp("%", Name("a"), Name("b")), .Exprs)))
+    .Stmts
+
+  rule GcdBody =>
+    Assign(Name("a"), Call(Name("abs"), (Name("a"), .Exprs)))
+    Assign(Name("b"), Call(Name("abs"), (Name("b"), .Exprs)))
+    While(GcdCondition, GcdLoopBody)
+    Return(Name("a"))
+    .Stmts
+
+  syntax Val ::= "GcdClosure" [macro]
+  rule GcdClosure =>
+    closureVal(("a", "b", .ParamNames), GcdBody, 0)
+
+  // Proof-only observer for the independent Euclidean recurrence
+  //   gcd(A, 0) = A
+  //   gcd(A, B) = gcd(B, A mod B), for A >= 0 and B > 0.
+  // It never changes program locals.  At each loop head it advances the
+  // expected pair in the suspended call continuation; at return it accepts
+  // only the matching normal form.
+  syntax KItem ::= #gcdCheck(Int, Int)
+  syntax Val ::= gcdVerified(Int)
+
+  rule <k> #while(GcdCondition, GcdLoopBody) ... </k>
+       <env> L:Int </env>
+       <scopes> ... L |-> scope(("a" |-> A:Int
+                                 "b" |-> B:Int), _) ... </scopes>
+       <stack>
+         ListItem(frame(#gcdCheck(A, B), CALLER:Int, SAVED:Int))
+         => ListItem(frame(#gcdCheck(B, pyMod(A, B)), CALLER, SAVED))
+         ...
+       </stack>
+    requires A >=Int 0 andBool B >Int 0
+    [priority(40)]
+
+  rule <k> G:Int ~> #gcdCheck(G, 0) => gcdVerified(G) ... </k>
+    requires G >=Int 0
+
+  // Zero-aware divisibility: 0 divides only 0.  This makes the standard
+  // divisibility characterization cover gcd(0, 0) = 0 without a partial mod.
+  syntax Bool ::= dividesZ(Int, Int) [function, total]
+  rule dividesZ(N:Int, N) => true
+    requires N >=Int 0
+    [simplification]
+  rule dividesZ(D:Int, 0) => true
+    requires D >=Int 0
+    [simplification]
+  rule dividesZ(0, N:Int) => N ==Int 0
+  rule dividesZ(D:Int, N:Int) => (N %Int D) ==Int 0
+    requires D =/=Int 0
+
+  syntax Bool ::= commonDivisor(Int, Int, Int) [function, total]
+  rule commonDivisor(D:Int, A:Int, B:Int) =>
+    dividesZ(D, A) andBool dividesZ(D, B)
+endmodule

