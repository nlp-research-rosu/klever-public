+    <stack> .List </stack>
+    <ret> noRet </ret>
+    [label(example-3-5)]
+
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"), (25, 15, .Exprs))
+      => 5
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
