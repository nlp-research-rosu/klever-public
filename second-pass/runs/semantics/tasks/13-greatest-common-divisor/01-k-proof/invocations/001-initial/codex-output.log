diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..e0d1eff007c087f0571c92485d22ba7896f5e47c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,77 @@
+requires "reference-semantics/semantics.k"
+
+module GCD-VERIFICATION
+  imports MPY
+
+  // These macros are the exact constructor tree emitted in solution.mpy.
+  // Keeping the tree here lets kprove reason about the submitted program,
+  // while the shell check in prove.sh prevents the two copies from drifting.
+  syntax Stmt ::= "GcdDef" [macro]
+  syntax Stmts ::= "GcdBody" [macro]
+  syntax Expr ::= "GcdCondition" [macro]
+  syntax Stmts ::= "GcdLoopBody" [macro]
+
+  rule GcdDef =>
+    FuncDef("greatest_common_divisor", Params("a", "b"), GcdBody)
+
+  rule GcdCondition =>
+    Compare(Name("b"), CmpOp("!=", Int(0)))
+
+  rule GcdLoopBody =>
+    Assign(TupleExpr((Name("a"), Name("b"), .Exprs)),
+           TupleExpr((Name("b"),
+                      BinOp("%", Name("a"), Name("b")), .Exprs)))
+    .Stmts
+
+  rule GcdBody =>
+    Assign(Name("a"), Call(Name("abs"), (Name("a"), .Exprs)))
+    Assign(Name("b"), Call(Name("abs"), (Name("b"), .Exprs)))
+    While(GcdCondition, GcdLoopBody)
+    Return(Name("a"))
+    .Stmts
+
+  syntax Val ::= "GcdClosure" [macro]
+  rule GcdClosure =>
+    closureVal(("a", "b", .ParamNames), GcdBody, 0)
+
+  // Proof-only observer for the independent Euclidean recurrence
+  //   gcd(A, 0) = A
+  //   gcd(A, B) = gcd(B, A mod B), for A >= 0 and B > 0.
+  // It never changes program locals.  At each loop head it advances the
+  // expected pair in the suspended call continuation; at return it accepts
+  // only the matching normal form.
+  syntax KItem ::= #gcdCheck(Int, Int)
+  syntax Val ::= gcdVerified(Int)
+
+  rule <k> #while(GcdCondition, GcdLoopBody) ... </k>
+       <env> L:Int </env>
+       <scopes> ... L |-> scope(("a" |-> A:Int
+                                 "b" |-> B:Int), _) ... </scopes>
+       <stack>
+         ListItem(frame(#gcdCheck(A, B), CALLER:Int, SAVED:Int))
+         => ListItem(frame(#gcdCheck(B, pyMod(A, B)), CALLER, SAVED))
+         ...
+       </stack>
+    requires A >=Int 0 andBool B >Int 0
+    [priority(40)]
+
+  rule <k> G:Int ~> #gcdCheck(G, 0) => gcdVerified(G) ... </k>
+    requires G >=Int 0
+
+  // Zero-aware divisibility: 0 divides only 0.  This makes the standard
+  // divisibility characterization cover gcd(0, 0) = 0 without a partial mod.
+  syntax Bool ::= dividesZ(Int, Int) [function, total]
+  rule dividesZ(N:Int, N) => true
+    requires N >=Int 0
+    [simplification]
+  rule dividesZ(D:Int, 0) => true
+    requires D >=Int 0
+    [simplification]
+  rule dividesZ(0, N:Int) => N ==Int 0
+  rule dividesZ(D:Int, N:Int) => (N %Int D) ==Int 0
+    requires D =/=Int 0
+
+  syntax Bool ::= commonDivisor(Int, Int, Int) [function, total]
+  rule commonDivisor(D:Int, A:Int, B:Int) =>
+    dividesZ(D, A) andBool dividesZ(D, B)
+endmodule

apply patch
patch: completed
/work/spec.k
/work/verification.k
