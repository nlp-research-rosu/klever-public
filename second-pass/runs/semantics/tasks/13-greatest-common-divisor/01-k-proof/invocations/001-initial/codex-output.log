+requires "verification.k"
+
+module GCD-SPEC
+  imports GCD-VERIFICATION
+
+  // Inductive loop theorem.  The result is nonnegative, is a common divisor,
+  // and is divisible by every nonnegative common divisor D.  Because D is an
+  // arbitrary input variable, the last conjunct is the universal greatestness
+  // condition in the divisibility ordering.
+  claim
+    <k>
+      While(Compare(Name("b"), CmpOp("!=", Int(0))),
+        Assign(TupleExpr((Name("a"), Name("b"), .Exprs)),
+               TupleExpr((Name("b"),
+                          BinOp("%", Name("a"), Name("b")), .Exprs)))
+        .Stmts)
+      => .K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(("a" |-> A:Int
+                       "b" |-> B:Int
+                       REST:Map), P:Parent)
+      => L |-> scope(("a" |-> ?G:Int
+                      "b" |-> 0
+                      REST), P) ...
+    </scopes>
+    requires A >=Int 0 andBool B >=Int 0 andBool D:Int >=Int 0
+    ensures ?G >=Int 0
+      andBool commonDivisor(?G, A, B)
+      andBool (notBool commonDivisor(D, A, B) orBool dividesZ(D, ?G))
+
+  // Whole-program theorem from arbitrary signed Python integer arguments.
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"),
+              (A0:Int, B0:Int, .Exprs))
+      => ?G:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires D:Int >=Int 0
+    ensures ?G >=Int 0
+      andBool commonDivisor(?G, absInt(A0), absInt(B0))
+      andBool (notBool commonDivisor(D, absInt(A0), absInt(B0))
+               orBool dividesZ(D, ?G))
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ef56d30a356391d5242363d471ea3fad17609e77
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,40 @@
+requires "reference-semantics/semantics.k"
+
+module GCD-VERIFICATION
+  imports MPY
+
+  // These macros are the exact constructor tree emitted in solution.mpy.
+  // Keeping the tree here lets kprove reason about the submitted program,
+  // while the shell check in prove.sh prevents the two copies from drifting.
+  syntax Stmt ::= "GcdDef" [macro]
+  syntax Stmts ::= "GcdBody" [macro]
+
+  rule GcdDef =>
+    FuncDef("greatest_common_divisor", Params("a", "b"), GcdBody)
+
+  rule GcdBody =>
+    Assign(Name("a"), Call(Name("abs"), (Name("a"), .Exprs)))
+    Assign(Name("b"), Call(Name("abs"), (Name("b"), .Exprs)))
+    While(Compare(Name("b"), CmpOp("!=", Int(0))),
+      Assign(TupleExpr((Name("a"), Name("b"), .Exprs)),
+             TupleExpr((Name("b"),
+                        BinOp("%", Name("a"), Name("b")), .Exprs)))
+      .Stmts)
+    Return(Name("a"))
+    .Stmts
+
+  syntax Val ::= "GcdClosure" [macro]
+  rule GcdClosure =>
+    closureVal(("a", "b", .ParamNames), GcdBody, 0)
+
+  // Zero-aware divisibility: 0 divides only 0.  This makes the standard
+  // divisibility characterization cover gcd(0, 0) = 0 without a partial mod.
+  syntax Bool ::= dividesZ(Int, Int) [function, total]
+  rule dividesZ(0, N:Int) => N ==Int 0
+  rule dividesZ(D:Int, N:Int) => (N %Int D) ==Int 0
+    requires D =/=Int 0
+
+  syntax Bool ::= commonDivisor(Int, Int, Int) [function, total]
+  rule commonDivisor(D:Int, A:Int, B:Int) =>
+    dividesZ(D, A) andBool dividesZ(D, B)
+endmodule

