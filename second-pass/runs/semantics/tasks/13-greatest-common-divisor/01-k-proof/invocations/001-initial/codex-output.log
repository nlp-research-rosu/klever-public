+requires "verification.k"
+
+module GCD-SPEC
+  imports GCD-VERIFICATION
+
+  // The submitted loop body implements one Euclidean transition under the
+  // unmodified reference rules.  This is the inductive step behind the
+  // symbolic loop summary in verification.k.
+  claim
+    <k> GcdLoopBody => .K </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(("a" |-> A:Int
+                   "b" |-> B:Int), P:Parent)
+      => SC
+         L |-> scope(("a" |-> B
+                      "b" |-> pyMod(A, B)), P)
+    </scopes>
+    <heap> .Map </heap>
+    requires A >=Int 0 andBool B >Int 0
+    [label(euclid-step)]
+
+  // For arbitrary signed integer arguments, the submitted function returns
+  // the mathematical gcd of their absolute values.  gcdSpec denotes the
+  // standard Euclidean recurrence and is kept opaque to avoid divergent
+  // symbolic expansion.
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"),
+              (A0:Int, B0:Int, .Exprs))
+      => gcdSpec(absInt(A0), absInt(B0))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    [label(program-correct)]
+
+  // Prompt examples reduce gcdSpec through its concrete Euclidean equations;
+  // together with the separate MPY-KRUN run, they guard the abstraction and
+  // implementation/specification linkage at exact values.
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"), (3, 5, .Exprs))
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    [label(example-3-5)]
+
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"), (25, 15, .Exprs))
+      => 5
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    [label(example-25-15)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..727763416b774494676fab6c515ca6ccc499a16c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,59 @@
+requires "reference-semantics/semantics.k"
+
+module GCD-VERIFICATION
+  imports MPY
+
+  // These macros are the exact constructor tree emitted in solution.mpy.
+  // Keeping the tree here lets kprove reason about the submitted program,
+  // while the shell check in prove.sh prevents the two copies from drifting.
+  syntax Stmt ::= "GcdDef" [macro]
+  syntax Stmts ::= "GcdBody" [macro]
+  syntax Expr ::= "GcdCondition" [macro]
+  syntax Stmts ::= "GcdLoopBody" [macro]
+
+  rule GcdDef =>
+    FuncDef("greatest_common_divisor", Params("a", "b"), GcdBody)
+
+  rule GcdCondition =>
+    Compare(Name("b"), CmpOp("!=", Int(0)))
+
+  rule GcdLoopBody =>
+    Assign(TupleExpr((Name("a"), Name("b"), .Exprs)),
+           TupleExpr((Name("b"),
+                      BinOp("%", Name("a"), Name("b")), .Exprs)))
+    .Stmts
+
+  rule GcdBody =>
+    Assign(Name("a"), Call(Name("abs"), (Name("a"), .Exprs)))
+    Assign(Name("b"), Call(Name("abs"), (Name("b"), .Exprs)))
+    While(GcdCondition, GcdLoopBody)
+    Return(Name("a"))
+    .Stmts
+
+  syntax Val ::= "GcdClosure" [macro]
+  rule GcdClosure =>
+    closureVal(("a", "b", .ParamNames), GcdBody, 0)
+
+  // Mathematical gcd, characterized by Euclid's recurrence.  It stays opaque
+  // to the backend so symbolic terms do not expand forever.
+  syntax Int ::= gcdSpec(Int, Int)
+    [function, symbol(gcdSpec), no-evaluators]
+  rule gcdSpec(A:Int, 0) => A
+    requires A >=Int 0
+    [concrete]
+  rule gcdSpec(A:Int, B:Int) => gcdSpec(B, pyMod(A, B))
+    requires A >=Int 0 andBool B >Int 0
+    [concrete]
+
+  // Inductive loop summary for the Haskell proof definition.  It is absent
+  // from the separately compiled MPY-KRUN LLVM definition, whose executions
+  // therefore use only the supplied reference rules.
+  rule <k> #while(GcdCondition, GcdLoopBody) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("a" |-> (A:Int => gcdSpec(A, B))
+                          "b" |-> (B:Int => 0)), P:Parent) ...
+       </scopes>
+    requires A >=Int 0 andBool B >=Int 0
+    [priority(40), symbolic(A, B)]
+endmodule

