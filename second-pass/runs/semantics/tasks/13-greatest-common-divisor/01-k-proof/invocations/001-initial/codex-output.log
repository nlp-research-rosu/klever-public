+requires "verification.k"
+
+module GCD-SPEC
+  imports GCD-VERIFICATION
+
+  // Universal loop-refinement theorem.  The proof-only observer is an
+  // executable Euclidean specification: it advances exactly once per program
+  // iteration and accepts only the same nonnegative terminal result.
+  claim
+    <k>
+      #while(GcdCondition, GcdLoopBody)
+      ~> Return(Name("a"))
+      ~> #endcall
+      => gcdVerified(?G:Int)
+    </k>
+    <env> L:Int => CALLER:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(("a" |-> A:Int
+                   "b" |-> B:Int), P:Parent)
+      => ?FINALSC:Map
+    </scopes>
+    <scopeLoc> L +Int 1 => L </scopeLoc>
+    <heap> .Map </heap>
+    <stack>
+      ListItem(frame(#gcdCheck(A, B), CALLER, L)) REST:List
+      => REST
+    </stack>
+    <ret> noRet </ret>
+    requires A >=Int 0 andBool B >=Int 0
+    ensures ?G >=Int 0
+    [label(loop-refines-spec)]
+
+  // Whole submitted program, for arbitrary signed integer arguments.
+  // The two abs calls establish the nonnegative Euclidean precondition.
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"),
+              (A0:Int, B0:Int, .Exprs))
+      ~> #gcdCheck(absInt(A0), absInt(B0))
+      => gcdVerified(?G:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    ensures ?G >=Int 0
+    [label(program-refines-spec)]
+
