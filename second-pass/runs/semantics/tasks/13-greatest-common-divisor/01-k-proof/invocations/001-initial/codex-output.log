new file mode 100644
index 0000000000000000000000000000000000000000..3bdaff303379f810aa3acdeaa6919f502c71e7de
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,61 @@
+requires "verification.k"
+
+module GCD-SPEC
+  imports GCD-VERIFICATION
+
+  // Inductive loop theorem.  The result is nonnegative, is a common divisor,
+  // and is divisible by every nonnegative common divisor D.  Because D is an
+  // arbitrary input variable, the last conjunct is the universal greatestness
+  // condition in the divisibility ordering.
+  claim
+    <k>
+      While(Compare(Name("b"), CmpOp("!=", Int(0))),
+        Assign(TupleExpr((Name("a"), Name("b"), .Exprs)),
+               TupleExpr((Name("b"),
+                          BinOp("%", Name("a"), Name("b")), .Exprs)))
+        .Stmts)
+      => .K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(("a" |-> A:Int
+                   "b" |-> B:Int), P:Parent)
+      => SC
+         L |-> scope(("a" |-> ?G:Int
+                      "b" |-> 0), P)
+    </scopes>
+    <heap> .Map </heap>
+    requires A >=Int 0 andBool B >=Int 0 andBool D:Int >=Int 0
+    ensures ?G >=Int 0
+      andBool commonDivisor(?G, A, B)
+      andBool (notBool commonDivisor(D, A, B) orBool dividesZ(D, ?G))
+    [label(loop-correct)]
+
+  // Whole-program theorem from arbitrary signed Python integer arguments.
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"),
+              (A0:Int, B0:Int, .Exprs))
+      => ?G:Int
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires D:Int >=Int 0
+    ensures ?G >=Int 0
+      andBool commonDivisor(?G, absInt(A0), absInt(B0))
+      andBool (notBool commonDivisor(D, absInt(A0), absInt(B0))
+               orBool dividesZ(D, ?G))
+    [label(program-correct)]
+endmodule
