+)
+print(f"structured_trace_candidates={trace_candidates}")
+
+compare_file(CANDIDATE / "prompt.py", REFERENCE / "prompt.py", "prompt provenance")
+compare_file(CANDIDATE / "py2mpy.py", REFERENCE / "py2mpy.py", "translator provenance")
