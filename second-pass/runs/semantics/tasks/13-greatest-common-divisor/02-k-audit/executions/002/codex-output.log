index 0000000000000000000000000000000000000000..8e697d8e51db15c9027199778da2179720350242
--- /dev/null
+++ b/evidence/k_concrete_cases.py
@@ -0,0 +1,21 @@
+def greatest_common_divisor(a: int, b: int) -> int:
+    a = abs(a)
+    b = abs(b)
+    while b != 0:
+        a, b = b, a % b
+    return a
+
+
+assert greatest_common_divisor(3, 5) == 1
+assert greatest_common_divisor(25, 15) == 5
+assert greatest_common_divisor(0, 0) == 0
+assert greatest_common_divisor(1, 0) == 1
+assert greatest_common_divisor(0, 1) == 1
+assert greatest_common_divisor(-1, 0) == 1
+assert greatest_common_divisor(0, -1) == 1
+assert greatest_common_divisor(-54, 24) == 6
+assert greatest_common_divisor(54, -24) == 6
+assert greatest_common_divisor(-54, -24) == 6
+assert greatest_common_divisor(13, 17) == 1
+assert greatest_common_divisor(20, 5) == 5
+assert greatest_common_divisor(1048576, 32768) == 32768
diff --git a/evidence/run_and_log.sh b/evidence/run_and_log.sh
new file mode 100644
index 0000000000000000000000000000000000000000..395d39cc365b6a560a2e93e2b708084cf183ac78
--- /dev/null
+++ b/evidence/run_and_log.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} | tee "$log_path"
+
+set +e
+"$@" 2>&1 | tee -a "$log_path"
+command_status=${PIPESTATUS[0]}
+set -e
+
+printf 'EXIT_STATUS: %s\n' "$command_status" | tee -a "$log_path"
+exit "$command_status"
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..0da63e0e0f38d142bd2e1b17ed5bb1c4c04a3e6f
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,28 @@
+requires "verification.k"
+
+module GCD-SPEC-VACUITY
+  imports GCD-VERIFICATION
+
+  // Fresh reviewer mutation: the real submitted program returns 1 for (3, 5),
+  // so changing its exact result to 2 must leave an unmet proof obligation.
+  claim
+    <k>
+      #loadAll(Module(GcdDef .Stmts))
+      ~> Call(Name("greatest_common_divisor"), (3, 5, .Exprs))
+      => 2
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope("greatest_common_divisor" |-> GcdClosure,
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    [label(false-result)]
+endmodule

