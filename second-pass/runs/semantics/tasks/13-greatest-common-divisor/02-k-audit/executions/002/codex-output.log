+    (13, 17),
+    (17, 13),
+    (20, 5),
+    (5, 20),
+    (2**127 - 1, 2**61 - 1),
+    (-(2**127 - 1), 2**61 - 1),
+    (2**127 - 1, -(2**61 - 1)),
+]
+
+all_cases = list(fixed_cases)
+all_cases.extend((a, b) for a in range(-100, 101) for b in range(-100, 101))
+rng = random.Random(130013)
+all_cases.extend(
+    (
+        rng.randint(-(2**255), 2**255),
+        rng.randint(-(2**255), 2**255),
+    )
+    for _ in range(1000)
+)
+
+seen = set()
