LOG /audit-output/evidence/03_translate_concrete.log
EXIT 0
OUTPUT_BEGIN
Module(
  ImportFrom("typing", "List")
  FuncDef("intersperse", Params("numbers", "delimeter"),
    Assign(Name("result"), ListExpr())
    For(Name("number"), Name("numbers"),
      If(Name("result"),
        Expr(
          Call(Attribute(Name("result"), "append"), Name("delimeter"))),
        )
      Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("intersperse"), ListExpr(), Int(4)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("intersperse"), ListExpr(Int(7)), UnaryOp("-", Int(2))),
      CmpOp("==", ListExpr(Int(7)))))
  Assert(
    Compare(
      Call(
        Name("intersperse"),
        ListExpr(UnaryOp("-", Int(1)), Int(0)),
        Int(9)),
      CmpOp("==", ListExpr(UnaryOp("-", Int(1)), Int(9), Int(0)))))
  Assert(
    Compare(
      Call(
        Name("intersperse"),
        ListExpr(Int(1), Int(2), Int(3)),
        Int(4)),
      CmpOp("==", ListExpr(Int(1), Int(4), Int(2), Int(4), Int(3)))))
  Assert(
    Compare(
      Call(Name("intersperse"), ListExpr(Int(0), Int(0)), Int(0)),
      CmpOp("==", ListExpr(Int(0), Int(0), Int(0)))))
  Assert(
    Compare(
      Call(
        Name("intersperse"),
        ListExpr(
          Int(0),
          UnaryOp("-", Int(1)),
          Int(2),
          UnaryOp("-", Int(3))),
        Int(0)),
      CmpOp(
        "==",
        ListExpr(
          Int(0),
          Int(0),
          UnaryOp("-", Int(1)),
          Int(0),
          Int(2),
          Int(0),
          UnaryOp("-", Int(3))))))
  Assert(
    Compare(
      Call(
        Name("intersperse"),
        ListExpr(
          Int(100000000000000000000),
          UnaryOp("-", Int(100000000000000000000))),
        Int(1000000000000000000000000000000)),
      CmpOp(
        "==",
        ListExpr(
          Int(100000000000000000000),
          Int(1000000000000000000000000000000),
          UnaryOp("-", Int(100000000000000000000)))))))
OUTPUT_END
