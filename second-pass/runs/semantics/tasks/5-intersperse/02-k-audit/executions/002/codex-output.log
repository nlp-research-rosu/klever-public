   120	
   121	  syntax Bool ::= isDigitC(Int) [function, total]
   122	  rule isDigitC(C:Int) => C >=Int 48 andBool C <=Int 57
   123	
   124	  syntax Bool ::= hasUpper(IntSeq) [function, total]
   125	  rule hasUpper(.IntSeq) => false
   126	  rule hasUpper(iCons(C:Int, S:IntSeq)) => isUpperC(C) orBool hasUpper(S)
   127	
   128	  syntax Bool ::= hasLower(IntSeq) [function, total]
   129	  rule hasLower(.IntSeq) => false
   130	  rule hasLower(iCons(C:Int, S:IntSeq)) => isLowerC(C) orBool hasLower(S)
   131	
   132	  syntax Bool ::= allAlpha(IntSeq) [function, total]
   133	  rule allAlpha(.IntSeq) => true
   134	  rule allAlpha(iCons(C:Int, S:IntSeq)) => isAlphaC(C) andBool allAlpha(S)
   135	
   136	  syntax Bool ::= allDigit(IntSeq) [function, total]
   137	  rule allDigit(.IntSeq) => true
   138	  rule allDigit(iCons(C:Int, S:IntSeq)) => isDigitC(C) andBool allDigit(S)
   139	
   140	  syntax Int ::= lowerC(Int) [function, total]
   141	
   142	  rule lowerC(C:Int) => C +Int 32 requires isUpperC(C)
   143	  rule lowerC(C:Int) => C         [owise]
   144	
   145	  syntax Int ::= upperC(Int) [function, total]
   146	  rule upperC(C:Int) => C -Int 32 requires isLowerC(C)
   147	  rule upperC(C:Int) => C         [owise]
   148	
   149	  syntax Int ::= swapC(Int) [function, total]
   150	  rule swapC(C:Int) => C +Int 32 requires isUpperC(C)
   151	  rule swapC(C:Int) => C -Int 32 requires isLowerC(C)
   152	  rule swapC(C:Int) => C         [owise]
   153	
   154	  syntax IntSeq ::= mapLower(IntSeq) [function, total]
   155	  rule mapLower(.IntSeq) => .IntSeq
   156	  rule mapLower(iCons(C:Int, S:IntSeq)) => iCons(lowerC(C), mapLower(S))
   157	
   158	  syntax IntSeq ::= mapUpper(IntSeq) [function, total]
   159	  rule mapUpper(.IntSeq) => .IntSeq
   160	  rule mapUpper(iCons(C:Int, S:IntSeq)) => iCons(upperC(C), mapUpper(S))
   161	
   162	  syntax IntSeq ::= mapSwap(IntSeq) [function, total]
   163	  rule mapSwap(.IntSeq) => .IntSeq
   164	  rule mapSwap(iCons(C:Int, S:IntSeq)) => iCons(swapC(C), mapSwap(S))
   165	
   166	  syntax Bool ::= startsWith(IntSeq, IntSeq) [function, total]
   167	  rule startsWith(.IntSeq, _:IntSeq)               => true
   168	  rule startsWith(iCons(_:Int, _:IntSeq), .IntSeq) => false
   169	  rule startsWith(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool startsWith(As, Bs)
   170	endmodule

FILE /reference/reference-semantics/semantics/bool.k
     1	// reference/src/semantics/bool.k — MPY-BOOL
     2	// Bool operator cases + the truthy boolean operations (not / and / or; and-or are
     3	// value-returning short-circuit over any Vals, per Python).
     4	
     5	module MPY-BOOL
     6	  imports MPY-CORE
     7	
     8	  rule applyUn("not", V:Val) => notBool truthy(V)
     9	
    10	  rule applyCmp("==", B1:Bool, B2:Bool) => B1 ==Bool B2
    11	  rule applyCmp("!=", B1:Bool, B2:Bool) => B1 =/=Bool B2
    12	
    13	  // ==== BoolOp: short-circuit, value-returning and / or =====================
    14	  // the node is its own accumulator: heat the HEAD element only, then either return it
    15	  // (short-circuit) or drop it and continue
    16	  context BoolOp(_, (HOLE:Expr, _:Exprs))
    17	  rule <k> BoolOp(_:String, (V:Val, .Exprs)) => V ... </k>
    18	  rule <k> BoolOp("and", (V:Val, A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
    19	       requires truthy(V)
    20	  rule <k> BoolOp("and", (V:Val, _:Expr, _:Exprs)) => V ... </k>
    21	       requires notBool truthy(V)
    22	  rule <k> BoolOp("or",  (V:Val, _:Expr, _:Exprs)) => V ... </k>
    23	       requires truthy(V)
    24	  rule <k> BoolOp("or",  (V:Val, A:Expr, REST:Exprs)) => BoolOp("or", (A, REST)) ... </k>
    25	       requires notBool truthy(V)
    26	
    27	  // ==== heap-object head: decide truthiness THROUGH the heap, never rewrite the
    28	  // operand — and/or return the OBJECT itself (Python identity), not its structure
    29	  rule <k> BoolOp(_:String, (ref(H:Int), .Exprs)) => ref(H) ... </k>
    30	       [priority(40)]
    31	  rule <k> BoolOp("and", (ref(H:Int), A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
    32	       <heap> ... H |-> V:Val ... </heap>
    33	       requires truthy(V)
    34	       [priority(40)]
    35	  rule <k> BoolOp("and", (ref(H:Int), _:Expr, _:Exprs)) => ref(H) ... </k>
    36	       <heap> ... H |-> V:Val ... </heap>
    37	       requires notBool truthy(V)
    38	       [priority(40)]
    39	  rule <k> BoolOp("or", (ref(H:Int), _:Expr, _:Exprs)) => ref(H) ... </k>
    40	       <heap> ... H |-> V:Val ... </heap>
    41	       requires truthy(V)
    42	       [priority(40)]
    43	  rule <k> BoolOp("or", (ref(H:Int), A:Expr, REST:Exprs)) => BoolOp("or", (A, REST)) ... </k>
    44	       <heap> ... H |-> V:Val ... </heap>
    45	       requires notBool truthy(V)
    46	       [priority(40)]
    47	endmodule

FILE /reference/reference-semantics/semantics/int.k
     1	// reference/src/semantics/int.k — MPY-INT
     2	// Int cases of the operator dispatch; Python // and % are floored (pyMod).
     3	
     4	module MPY-INT
     5	  imports MPY-CORE
     6	
     7	  rule applyUn("-", I:Int) => 0 -Int I
     8	
     9	  rule applyBin("+",  I1:Int, I2:Int) => I1 +Int I2
    10	  // Bool participates in int arithmetic (x += (a == b))
    11	  rule applyBin("+",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi
    12	  rule applyBin("+",  B:Bool, I:Int) => #if B #then 1 #else 0 #fi +Int I
    13	  rule applyBin("-",  I1:Int, I2:Int) => I1 -Int I2
    14	  rule applyBin("*",  I1:Int, I2:Int) => I1 *Int I2
    15	  rule applyBin("%",  I1:Int, I2:Int) => pyMod(I1, I2)
    16	  rule applyBin("//", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2
    17	  rule applyBin("**", I1:Int, I2:Int) => I1 ^Int I2 requires I2 >=Int 0
    18	
    19	  syntax Int ::= pyMod(Int, Int) [function]
    20	  rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2
    21	
    22	  rule applyCmp("<",  I1:Int, I2:Int)   => I1 <Int  I2
    23	  rule applyCmp("<=", I1:Int, I2:Int)   => I1 <=Int I2
    24	  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int  I2
    25	  rule applyCmp(">=", I1:Int, I2:Int)   => I1 >=Int I2
    26	  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2
    27	  rule applyCmp("!=", I1:Int, I2:Int)   => I1 =/=Int I2
    28	endmodule

FILE /reference/reference-semantics/semantics/operators.k
     1	// reference/src/semantics/operators.k — MPY-OPERATORS
     2	// The operator DISPATCH layer: operands evaluate by strictness (heat/cool over KResult=Val),
     3	// the cooled node hands to applyUn/applyBin/applyCmp (declared in core.k; each domain file
     4	// owns its cases — bool.k, int.k, float.k, str.k, list.k, tuple.k, set.k, dict.k).
     5	
     6	module MPY-OPERATORS
     7	  imports MPY-CORE
     8	  imports MPY-ITER
     9	
    10	  rule <k> UnaryOp(OP:String, V:Val) => applyUn(OP, V) ... </k>
    11	
    12	  rule <k> BinOp(OP:String, L:Val, R:Val) => applyBin(OP, L, R) ... </k>
    13	
    14	  // Compare's right operand sits under the CmpOp wrapper — contexts instead of attributes
    15	  context Compare(HOLE, _)
    16	  context Compare(_:Val, CmpOp(_, HOLE))
    17	  rule <k> Compare(LV:Val, CmpOp(OP:String, RV:Val)) => applyCmp(OP, LV, RV) ... </k> [owise]
    18	
    19	  rule applyCmp("is",     V:Val, noneV) => V ==K noneV
    20	  rule applyCmp("is not", V:Val, noneV) => notBool (V ==K noneV)
    21	
    22	  // ==== operand deref: heap objects combine/compare by STRUCTURE ============
    23	  // (Python: list == is structural; identity only via `is`.) priority(40)
    24	  // preempts the generic dispatch so applyUn/applyBin/applyCmp never see a ref.
    25	  rule <k> BinOp(OP:String, ref(H:Int), R:Expr) => BinOp(OP, V, R) ... </k>
    26	       <heap> ... H |-> V:Val ... </heap>
    27	       [priority(40)]
    28	  rule <k> BinOp(OP:String, L:Val, ref(H:Int)) => BinOp(OP, L, V) ... </k>
    29	       <heap> ... H |-> V:Val ... </heap>
    30	       requires notBool isRefV(L)
    31	       [priority(40)]
    32	
    33	  // the left operand of `in`/`not in` is an ELEMENT (compares by ==K) — never deref'd
    34	  rule <k> Compare(ref(H:Int), CmpOp(OP:String, R:Expr)) => Compare(V, CmpOp(OP, R)) ... </k>
    35	       <heap> ... H |-> V:Val ... </heap>
    36	       requires OP =/=String "in" andBool OP =/=String "not in"
    37	       [priority(40)]
    38	  rule <k> Compare(L:Val, CmpOp(OP:String, ref(H:Int))) => Compare(L, CmpOp(OP, V)) ... </k>
    39	       <heap> ... H |-> V:Val ... </heap>
    40	       requires notBool isRefV(L)
    41	        orBool OP ==String "in" orBool OP ==String "not in"
    42	       [priority(40)]
    43	
    44	  rule <k> UnaryOp(OP:String, ref(H:Int)) => UnaryOp(OP, V) ... </k>
    45	       <heap> ... H |-> V:Val ... </heap>
    46	       [priority(40)]
    47	endmodule

FILE /reference/reference-semantics/semantics/assert.k
     1	// reference/src/semantics/assert.k — MPY-ASSERT
     2	
     3	module MPY-ASSERT
     4	  imports MPY-CORE
     5	
     6	  rule <k> Assert(V:Val) => .K ... </k>
     7	       requires truthy(V)
     8	  rule <k> Assert(V:Val) ~> _ => .K </k>
     9	       <exc> NoExc => AssertionError </exc>
    10	       <exit-code> _ => 1 </exit-code>
    11	       requires notBool truthy(V)
    12	
    13	  rule <k> Assert(ref(H:Int)) => Assert(V) ... </k>
    14	       <heap> ... H |-> V:Val ... </heap>
    15	       [priority(40)]
    16	endmodule

FILE /reference/reference-semantics/semantics/concrete.k
     1	// reference/src/semantics/concrete.k — MPY-CONCRETE
     2	// Concrete-execution-only rules, visible ONLY to the llvm build (run.sh kompiles
     3	// MPY-CONCRETE; verification builds import MPY and never see these). Rationale:
     4	// a k-cell rule matching value constructors NARROWS abstract Vals in the haskell
     5	// backend ([concrete] is not respected on rewrite rules) — probed on
     6	// 26-remove-duplicates, where element compares branched into deepEqVS.
     7	
     8	module MPY-CONCRETE
     9	  imports MPY
    10	
    11	  // deep equality for list compares whose elements are heap objects
    12	  // (list-of-lists): Python == is structural at every depth.
    13	  rule <k> Compare(list(A:ValSeq), CmpOp("==", list(B:ValSeq))) => deepEqVS(A, B, HP) ... </k>
    14	       <heap> HP:Map </heap>
    15	       requires hasRefVS(A) orBool hasRefVS(B)
    16	  rule <k> Compare(list(A:ValSeq), CmpOp("!=", list(B:ValSeq))) => notBool deepEqVS(A, B, HP) ... </k>
    17	       <heap> HP:Map </heap>
    18	       requires hasRefVS(A) orBool hasRefVS(B)
    19	
    20	  // ==== keyed sort, concrete leg ============================================
    21	  // Computes each key by a REAL call through the uniform #callee machinery
    22	  // (closures, len, type objects all work), stable-inserts on the key, and
    23	  // allocates the result. priority(40) beats sort.k's opaque rules, so krun
    24	  // runs this and proofs (which never see MPY-CONCRETE) keep sortKeyVS.
    25	  syntax Val ::= kvP(Val, Val)
    26	  syntax KItem ::= #ksort(ValSeq, Val, ValSeq, Bool)
    27	                 | #ksIns(Val, ValSeq, Val, ValSeq, Bool)
    28	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
    29	        => #ksort(VS, KV, .ValSeq, false) ... </k>
    30	       [priority(40)]
    31	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
    32	        => #ksort(VS, KV, .ValSeq, RB) ... </k>
    33	       [priority(40)]
    34	  rule <k> #ksort(.ValSeq, _:Val, ACC:ValSeq, RB:Bool)
    35	        => #alloc(list(condRev(unpairVS(ACC), RB))) ... </k>
    36	  rule <k> #ksort(vCons(V:Val, R:ValSeq), KV:Val, ACC:ValSeq, RB:Bool)
    37	        => KV ~> #callee((V, .Exprs)) ~> #ksIns(V, R, KV, ACC, RB) ... </k>
    38	  rule <k> K:Val ~> #ksIns(V:Val, R:ValSeq, KV:Val, ACC:ValSeq, RB:Bool)
    39	        => #ksort(R, KV, insPair(ACC, K, V), RB) ... </k>
    40	       requires notBool isKwV(K)
    41	
    42	  syntax ValSeq ::= insPair(ValSeq, Val, Val) [function]
    43	  rule insPair(.ValSeq, K:Val, V:Val) => vCons(kvP(K, V), .ValSeq)
    44	  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    45	    => vCons(kvP(K, V), vCons(kvP(K2, V2), R))
    46	       requires kLt(K, K2)
    47	  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    48	    => vCons(kvP(K2, V2), insPair(R, K, V))
    49	       requires notBool kLt(K, K2)
    50	
    51	  syntax Bool ::= kLt(Val, Val) [function]
    52	  rule kLt(I1:Int, I2:Int)             => I1 <Int I2
    53	  rule kLt(F1:Float, F2:Float)         => F1 <Float F2
    54	  rule kLt(str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
    55	
    56	  syntax ValSeq ::= unpairVS(ValSeq) [function, total]
    57	  rule unpairVS(.ValSeq) => .ValSeq
    58	  rule unpairVS(vCons(kvP(_:Val, V:Val), R:ValSeq)) => vCons(V, unpairVS(R))
    59	  rule unpairVS(vCons(V:Val, R:ValSeq)) => vCons(V, unpairVS(R)) [owise]
    60	endmodule

diff --git a/evidence/01_integrity.sh b/evidence/01_integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c89b5c4c42cba2d1e2f640336160261d7c74c9cc
--- /dev/null
+++ b/evidence/01_integrity.sh
@@ -0,0 +1,156 @@
+#!/usr/bin/env bash
+set -u
+set -o pipefail
+
+overall=0
+
+check_file() {
+  local path="$1"
+  if [[ -f "$path" && -r "$path" && ! -L "$path" ]]; then
+    printf 'OK regular-readable %s\n' "$path"
+  else
+    printf 'BAD required-file %s\n' "$path"
+    overall=1
+  fi
+}
+
+check_hash() {
+  local expected="$1"
+  local path="$2"
+  local actual
+  actual="$(sha256sum "$path" | awk '{print $1}')"
+  if [[ "$actual" == "$expected" ]]; then
+    printf 'OK sha256 %s %s\n' "$actual" "$path"
+  else
+    printf 'BAD sha256 expected=%s actual=%s %s\n' "$expected" "$actual" "$path"
+    overall=1
+  fi
+}
+
+printf 'Declared layout and mode\n'
+python3 -c 'import json; d=json.load(open("/audit-input.json")); print(d["record_layout"]); print(d["semantics_mode"]); print(d["condition"]); print(d["problem_id"])'
+
+required=(
+  /audit-input.json
+  /audit-campaign-lock.json
+  /run.json
+  /task.json
+  /generation-result.json
+  /generation-evidence/invocation.json
+  /generation-evidence/metrics.json
+  /generation-evidence/codex-last.txt
+  /generation-evidence/codex-output.log
+  /generation-evidence/prompt.txt
+  /reference/canonical.py
+  /reference/prompt.py
+  /reference/py2mpy.py
+)
+for path in "${required[@]}"; do
+  check_file "$path"
+done
+
+if [[ -d /generation-evidence/codex-trace && ! -L /generation-evidence/codex-trace ]]; then
+  printf 'OK trace-directory /generation-evidence/codex-trace\n'
+else
+  printf 'BAD trace-directory /generation-evidence/codex-trace\n'
+  overall=1
+fi
+
+if [[ -d /reference/reference-semantics && ! -L /reference/reference-semantics ]]; then
+  printf 'OK supplied-semantics mount present\n'
+else
+  printf 'BAD supplied-semantics mount absent-or-symlinked\n'
+  overall=1
+fi
+
+printf 'Campaign block comparison\n'
+if python3 -c 'import json,sys; a=json.load(open("/audit-input.json"))["audit_campaign"]; b=json.load(open("/audit-campaign-lock.json")); sys.exit(0 if a == b else 1)'; then
+  printf 'OK campaign block equals lock\n'
+else
+  printf 'BAD campaign block differs from lock\n'
+  overall=1
+fi
+
+printf 'Declared individual hashes\n'
+check_hash ad5dfcc006af70c4d0d2c6641f0878a6c54a266e9ad2b54cd225b2381a78d745 /audit-campaign-lock.json
+check_hash 9690482d345e93d4b2789571770686de5547be7bba1ade3d325e6a1428923e15 /reference/canonical.py
+check_hash 388474ac71e5b893802f5971102df2e4ea82ddf2f916a4a55361c19370f54012 /reference/prompt.py
+check_hash 406485eac118431c08ef59f30f79dfa6aa9d5825408917fc5ce7c806e664db16 /reference/py2mpy.py
+check_hash 321818dc4f5c9795e25ea800ab12c1b1e5cf0bcc70b308443b9f08339a122db0 /run.json
+check_hash 3bc98cf0ea750daf3178d3da4b74188232e76cc1a9dbb1bdd021c5b7e4932ecb /task.json
+check_hash d577093b0aac2a47705def6d52fb26a770430dd819dd36a7bd2a592e00a5dec9 /generation-result.json
+check_hash b645be834ea0aa4fdabdefde59dd96a0f1cd9380ac22df92e9ff720cf289014f /generation-evidence/invocation.json
+check_hash e9c2f349ff9a8ef5dc550c3600aa75abcb8c2a8ea18563bd7b5022742cdb0d87 /generation-evidence/metrics.json
+check_hash d81af044dfe2ec704f0e89313f2a222aed787f16175a55eb28d5fe23c888f21b /generation-evidence/usage.json
+check_hash 52e3083c794a482aa9eb1c17c65d371cb938d873d4d03a143b079c5df1a3b101 /generation-evidence/codex-last.txt
+check_hash d0153862576d4bfd638dea177f4697c785436de582aa525c047f5104078336bf /generation-evidence/codex-output.log
+check_hash 3ccfe05a1e1620ec7e34cf354de6eeb973da0fe27a12a04f4ac62b0a78eeec09 /generation-evidence/prompt.txt
+
+trace_file=/generation-evidence/codex-trace/2026/07/22/rollout-2026-07-22T20-43-37-019f8ca4-7aa5-7871-bd85-ac5b2bfa206b.jsonl
+check_file "$trace_file"
+check_hash 3e160f9de83d5a1119a80b778ffa8ac54530516c956855bb2f725a3f274b4e14 "$trace_file"
+
+printf 'Candidate trusted-artifact comparisons\n'
+for pair in \
+  '/candidate/prompt.py /reference/prompt.py' \
+  '/candidate/py2mpy.py /reference/py2mpy.py'
+do
+  read -r left right <<<"$pair"
+  if cmp -s "$left" "$right"; then
+    printf 'OK byte-identical %s %s\n' "$left" "$right"
+  else
+    printf 'BAD content-difference %s %s\n' "$left" "$right"
+    overall=1
+  fi
+done
+
+if find /candidate/reference-semantics /reference/reference-semantics -type l -print -quit | grep -q .; then
+  printf 'BAD symlink in semantics trees\n'
+  find /candidate/reference-semantics /reference/reference-semantics -type l -printf '%p -> %l\n'
+  overall=1
+else
+  printf 'OK no symlinks in semantics trees\n'
+fi
+
+if diff -r --no-dereference /candidate/reference-semantics /reference/reference-semantics; then
+  printf 'OK candidate semantics recursively byte-identical to trusted semantics\n'
+else
+  printf 'BAD candidate semantics differs from trusted semantics\n'
+  overall=1
+fi
+
+printf 'Required candidate proof artifacts\n'
+for path in \
+  /candidate/solution.py \
+  /candidate/solution.mpy \
+  /candidate/spec.k \
+  /candidate/verification.k \
+  /candidate/prove.sh
+do
+  check_file "$path"
+done
+
+printf 'Structured trace validation and event counts\n'
+if python3 -c 'import json,sys; [json.loads(line) for line in open(sys.argv[1], encoding="utf-8")]' "$trace_file"; then
+  printf 'OK every trace line is valid JSON\n'
+  python3 -c 'import collections,json,sys; counts=collections.Counter(json.loads(line)["type"] for line in open(sys.argv[1], encoding="utf-8")); [print(counts[key], key) for key in sorted(counts)]' "$trace_file"
+else
+  printf 'BAD malformed structured trace\n'
+  overall=1
+fi
+
+printf 'Independent mounted-file SHA-256 inventory\n'
+find /candidate /reference /generation-evidence -type f -print0 \
+  | sort -z \
+  | xargs -0 sha256sum
+
+printf 'Symlink inventory for all mounted input trees\n'
+symlinks="$(find /candidate /reference /generation-evidence -type l -printf '%p -> %l\n')"
+if [[ -n "$symlinks" ]]; then
+  printf '%s\n' "$symlinks"
+else
+  printf 'NONE\n'
+fi
+
+printf 'INTEGRITY_SCRIPT_STATUS=%d\n' "$overall"
+exit "$overall"
diff --git a/evidence/02_differential.py b/evidence/02_differential.py
new file mode 100644
index 0000000000000000000000000000000000000000..27f44f6a9bf10b024d013a0d938d487d639d53ed
--- /dev/null
+++ b/evidence/02_differential.py
@@ -0,0 +1,102 @@
+#!/usr/bin/env python3
+"""Independent differential test for HumanEval/5 intersperse."""
+
+from __future__ import annotations
+
+import importlib.util
+import itertools
+import random
+from pathlib import Path
+
+
+SCRATCH = Path("/tmp/audit-work/5-intersperse")
+
+
+def load_function(module_name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.intersperse
+
+
+canonical = load_function("trusted_canonical", SCRATCH / "canonical.py")
+generated = load_function("generated_solution", SCRATCH / "solution.py")
+
+explicit_cases = [
+    ([], 4),
+    ([1, 2, 3], 4),
+    ([7], -2),
+    ([0, 0], 0),
+    ([-1, 0], 9),
+    ([1, 2], -5),
+    ([5, 5, 5], 5),
+    ([0, -1, 2, -3], 0),
+    ([10**80, -(10**80)], 10**100),
+]
+
+cases: list[tuple[list[int], int, str]] = [
+    (numbers, delimiter, "explicit") for numbers, delimiter in explicit_cases
+]
+
+small_values = (-2, -1, 0, 1, 2)
+small_delimiters = (-10, -1, 0, 1, 10)
+for length in range(0, 6):
+    for items in itertools.product(small_values, repeat=length):
+        for delimiter in small_delimiters:
+            cases.append((list(items), delimiter, "exhaustive-small"))
+
+rng = random.Random(5005)
+for _ in range(2000):
+    length = rng.randrange(0, 41)
+    numbers = [rng.randrange(-(10**12), 10**12 + 1) for _ in range(length)]
+    delimiter = rng.randrange(-(10**15), 10**15 + 1)
+    cases.append((numbers, delimiter, "seeded-generated"))
+
+mismatches = []
+mutations = []
+for index, (numbers, delimiter, source) in enumerate(cases):
+    canonical_input = list(numbers)
+    generated_input = list(numbers)
+    canonical_result = canonical(canonical_input, delimiter)
+    generated_result = generated(generated_input, delimiter)
+    direct_oracle = [
+        item
+        for position, number in enumerate(numbers)
+        for item in ((delimiter, number) if position else (number,))
+    ]
+    if canonical_input != numbers or generated_input != numbers:
+        mutations.append((index, source, numbers, delimiter))
+    if not (
+        canonical_result == generated_result == direct_oracle
+        and type(generated_result) is list
+    ):
+        mismatches.append(
+            (
+                index,
+                source,
+                numbers,
+                delimiter,
+                canonical_result,
+                generated_result,
+                direct_oracle,
+            )
+        )
+        if len(mismatches) >= 10:
+            break
+
+print("oracle=trusted canonical.py plus independent direct construction")
+print("explicit_cases=9")
+print("exhaustive_small_lengths=0..5")
+print("exhaustive_small_values=-2,-1,0,1,2")
+print("exhaustive_small_delimiters=-10,-1,0,1,10")
+print("seeded_generated_seed=5005 count=2000 lengths=0..40")
+print(f"total_cases={len(cases)}")
+print(f"mismatch_count={len(mismatches)}")
+print(f"input_mutation_count={len(mutations)}")
+if mismatches:
+    print(f"first_mismatches={mismatches!r}")
+if mutations:
+    print(f"first_input_mutations={mutations[:10]!r}")
+raise SystemExit(1 if mismatches or mutations else 0)
