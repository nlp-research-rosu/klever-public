index 0000000000000000000000000000000000000000..0d179a26be30d62c2f459febb63903801e780bdc
--- /dev/null
+++ b/evidence/03_k_concrete_tests.py
@@ -0,0 +1,26 @@
+from typing import List
+
+
+def intersperse(numbers: List[int], delimeter: int) -> List[int]:
+    result = []
+    for number in numbers:
+        if result:
+            result.append(delimeter)
+        result.append(number)
+    return result
+
+
+assert intersperse([], 4) == []
+assert intersperse([7], -2) == [7]
+assert intersperse([-1, 0], 9) == [-1, 9, 0]
+assert intersperse([1, 2, 3], 4) == [1, 4, 2, 4, 3]
+assert intersperse([0, 0], 0) == [0, 0, 0]
+assert intersperse([0, -1, 2, -3], 0) == [0, 0, -1, 0, 2, 0, -3]
+assert intersperse(
+    [100000000000000000000, -100000000000000000000],
+    1000000000000000000000000000000,
+) == [
+    100000000000000000000,
+    1000000000000000000000000000000,
+    -100000000000000000000,
+]
