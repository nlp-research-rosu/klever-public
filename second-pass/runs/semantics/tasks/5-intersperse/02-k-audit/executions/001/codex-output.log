index 0000000000000000000000000000000000000000..41cb9e3c6587fcc0a6ae8e0b081d29c13f1b817c
--- /dev/null
+++ b/evidence/06_nonvacuity.sh
@@ -0,0 +1,29 @@
+#!/usr/bin/env bash
+set +e
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return 0
+}
+
+SCRATCH=/tmp/audit-work/candidate
+DEF="$SCRATCH/verification-kompiled"
+
+printf '%s\n' 'Stage 6: fresh false-result mutation'
+printf '%s\n' 'Witness: numbers=[1,2,3], delimeter=4'
+printf '%s\n' 'True result:  [1,4,2,4,3]'
+printf '%s\n' 'False target: [1,4,2,4,4]'
+
+run cp /audit-output/evidence/06_spec_vacuity.k "$SCRATCH/audit-spec-vacuity.k"
+run kprove "$SCRATCH/audit-spec-vacuity.k" \
+  --definition "$DEF" \
+  --spec-module AUDIT-SPEC-VACUITY \
+  --dry-run
+run kprove "$SCRATCH/audit-spec-vacuity.k" \
+  --definition "$DEF" \
+  --spec-module AUDIT-SPEC-VACUITY
diff --git a/evidence/06_spec_vacuity.k b/evidence/06_spec_vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..06ec88e28aee4707401ed7614754dda71d6ac5b7
--- /dev/null
+++ b/evidence/06_spec_vacuity.k
@@ -0,0 +1,57 @@
+requires "verification.k"
+
+module AUDIT-SPEC-VACUITY
+  imports INTERSPERSE-VERIFICATION
+
+  // Satisfying ground input: numbers=[1,2,3], delimeter=4.
+  // Deliberately false result: the correct final element is 3, not 4.
+  claim [wrong-final-element]:
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List")
+        FuncDef("intersperse", Params("numbers", "delimeter"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          For(Name("number"), Name("numbers"),
+            If(Name("result"),
+              Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+              .Stmts)
+            Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+          Return(Name("result")))))
+      ~> Call(
+        Name("intersperse"),
+        list(vCons(1, vCons(2, vCons(3, .ValSeq)))),
+        4)
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "intersperse" |-> closureVal(
+          ("numbers", "delimeter"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          For(Name("number"), Name("numbers"),
+            If(Name("result"),
+              Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+              .Stmts)
+            Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+          Return(Name("result")),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        vCons(1, vCons(4, vCons(2, vCons(4, vCons(4, .ValSeq))))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule

apply patch
