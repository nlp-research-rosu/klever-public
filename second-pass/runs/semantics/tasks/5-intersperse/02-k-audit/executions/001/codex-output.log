+printf '[exit %d]\n' "$?"
+
+printf '%s\n' '$ wc -l -c /audit-output/evidence/05_rule_inventory.md'
+wc -l -c /audit-output/evidence/05_rule_inventory.md
+printf '[exit %d]\n' "$?"
