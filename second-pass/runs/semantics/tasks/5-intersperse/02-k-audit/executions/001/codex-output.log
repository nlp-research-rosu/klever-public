+#!/usr/bin/env bash
+set +e
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return 0
+}
+
+SCRATCH=/tmp/audit-work/candidate
+SPEC="$SCRATCH/audit-spec-labeled.k"
+DEF="$SCRATCH/verification-kompiled"
+
+printf '%s\n' 'Per-target runs with required circularity dependency closures'
