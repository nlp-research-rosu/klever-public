+  > /tmp/audit-work/regenerated-solution.mpy
+regen_status=$?
+printf '\n$ python3 /reference/py2mpy.py /tmp/audit-work/candidate/solution.py > /tmp/audit-work/regenerated-solution.mpy\n'
