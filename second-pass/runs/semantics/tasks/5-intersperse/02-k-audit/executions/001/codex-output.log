+#!/usr/bin/env bash
+set +e
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return 0
+}
+
+printf '%s\n' 'Stage 2: translation identity and independent differential test'
+run python3 /reference/py2mpy.py /tmp/audit-work/candidate/solution.py
