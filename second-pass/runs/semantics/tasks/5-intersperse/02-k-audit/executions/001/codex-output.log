+          Assign(Name("result"), ListExpr(.Exprs))
+          For(Name("number"), Name("numbers"),
+            If(Name("result"),
+              Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+              .Stmts)
+            Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+          Return(Name("result")),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
