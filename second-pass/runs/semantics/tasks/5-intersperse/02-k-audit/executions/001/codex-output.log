index 0000000000000000000000000000000000000000..b3f36f941acd3a33000a59c2a144802a8b144ffe
--- /dev/null
+++ b/evidence/03_reconstruct.sh
@@ -0,0 +1,66 @@
+#!/usr/bin/env bash
+set +e
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return 0
+}
+
+SCRATCH=/tmp/audit-work/candidate
+printf '%s\n' 'Stage 3: clean proof reconstruction'
+printf 'scratch=%s\n' "$SCRATCH"
+
+run find "$SCRATCH" -maxdepth 2 -type d -name '*-kompiled' -o -name '.kompile-*'
+run sha256sum "$SCRATCH/solution.py" "$SCRATCH/solution.mpy" \
+  "$SCRATCH/spec.k" "$SCRATCH/verification.k"
+
+run python3 /reference/py2mpy.py /audit-output/evidence/03_concrete_program.py
+python3 /reference/py2mpy.py /audit-output/evidence/03_concrete_program.py \
+  > "$SCRATCH/audit-concrete.mpy"
+printf '\n$ python3 /reference/py2mpy.py /audit-output/evidence/03_concrete_program.py > %s/audit-concrete.mpy\n' "$SCRATCH"
+printf '[exit %d]\n' "$?"
+
+run kompile "$SCRATCH/reference-semantics/semantics.k" \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition "$SCRATCH/runtime-kompiled"
+
+run krun "$SCRATCH/audit-concrete.mpy" \
+  --definition "$SCRATCH/runtime-kompiled"
+
+run kompile "$SCRATCH/verification.k" \
+  --backend haskell \
+  --main-module INTERSPERSE-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition "$SCRATCH/verification-kompiled"
+
+run kprove "$SCRATCH/spec.k" \
+  --definition "$SCRATCH/verification-kompiled" \
+  --spec-module INTERSPERSE-SPEC
+
+for name in loop_empty loop_first loop_rest entry; do
+  cp "/audit-output/evidence/03_spec_${name}.k" "$SCRATCH/audit-spec-${name}.k"
+  printf '\n$ cp %q %q\n' \
+    "/audit-output/evidence/03_spec_${name}.k" \
+    "$SCRATCH/audit-spec-${name}.k"
+  printf '[exit %d]\n' "$?"
+done
+
+run kprove "$SCRATCH/audit-spec-loop_empty.k" \
+  --definition "$SCRATCH/verification-kompiled" \
+  --spec-module AUDIT-SPEC-LOOP-EMPTY
+run kprove "$SCRATCH/audit-spec-loop_first.k" \
+  --definition "$SCRATCH/verification-kompiled" \
+  --spec-module AUDIT-SPEC-LOOP-FIRST
+run kprove "$SCRATCH/audit-spec-loop_rest.k" \
+  --definition "$SCRATCH/verification-kompiled" \
+  --spec-module AUDIT-SPEC-LOOP-REST
+run kprove "$SCRATCH/audit-spec-entry.k" \
+  --definition "$SCRATCH/verification-kompiled" \
+  --spec-module AUDIT-SPEC-ENTRY
diff --git a/evidence/03_spec_entry.k b/evidence/03_spec_entry.k
new file mode 100644
index 0000000000000000000000000000000000000000..09e300957ab4a4ed5a1324939ae85a4669f3c605
--- /dev/null
+++ b/evidence/03_spec_entry.k
@@ -0,0 +1,47 @@
+requires "verification.k"
+
+module AUDIT-SPEC-ENTRY
+  imports INTERSPERSE-VERIFICATION
+
+  claim
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List")
+        FuncDef("intersperse", Params("numbers", "delimeter"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          For(Name("number"), Name("numbers"),
+            If(Name("result"),
+              Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+              .Stmts)
+            Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+          Return(Name("result")))))
+      ~> Call(Name("intersperse"), list(NUMBERS), D)
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "intersperse" |-> closureVal(
+          ("numbers", "delimeter"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          For(Name("number"), Name("numbers"),
+            If(Name("result"),
+              Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+              .Stmts)
+            Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+          Return(Name("result")),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(intersperseVS(NUMBERS, D)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/03_spec_labeled.k b/evidence/03_spec_labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..86f3c35055cb0f0454fd2b35f4d9850d75b52228
--- /dev/null
+++ b/evidence/03_spec_labeled.k
@@ -0,0 +1,142 @@
+requires "verification.k"
+
+module AUDIT-SPEC-LABELED
+  imports INTERSPERSE-VERIFICATION
+
+  claim [loop-empty]:
+    <k>
+      #loop(
+        list(.ValSeq), Name("number"),
+        If(Name("result"),
+          Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+          .Stmts)
+        Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+      ~> CONT
+      => CONT
+    </k>
+    <env> L </env>
+    <scopes>
+      SCOPES
+      L |-> scope(
+        "numbers" |-> list(NUMBERS)
+        "result" |-> ref(H)
+        "delimeter" |-> D,
+        PARENT)
+    </scopes>
+    <heap> HEAP H |-> list(.ValSeq) </heap>
+    requires notBool (L in_keys(SCOPES))
+     andBool notBool (H in_keys(HEAP))
+
+  claim [loop-first]:
+    <k>
+      #loop(
+        list(vCons(V, REST)), Name("number"),
+        If(Name("result"),
+          Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+          .Stmts)
+        Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+      ~> CONT
+      => CONT
+    </k>
+    <env> L </env>
+    <scopes>
+      SCOPES
+      L |-> scope(
+        "numbers" |-> list(NUMBERS)
+        "result" |-> ref(H)
+        "delimeter" |-> D,
+        PARENT)
+      =>
+      SCOPES
+      L |-> scope(
+        "numbers" |-> list(NUMBERS)
+        "number" |-> lastNumber(V, REST)
+        "result" |-> ref(H)
+        "delimeter" |-> D,
+        PARENT)
+    </scopes>
+    <heap>
+      HEAP H |-> list(.ValSeq)
+      => HEAP H |-> list(intersperseAcc(.ValSeq, vCons(V, REST), D))
+    </heap>
+    requires notBool (L in_keys(SCOPES))
+     andBool notBool (H in_keys(HEAP))
+
+  claim [loop-rest]:
+    <k>
+      #loop(
+        list(REST), Name("number"),
+        If(Name("result"),
+          Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+          .Stmts)
+        Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+      ~> CONT
+      => CONT
+    </k>
+    <env> L </env>
+    <scopes>
+      SCOPES
+      L |-> scope(
+        "numbers" |-> list(NUMBERS)
+        "number" |-> OLD
+        "result" |-> ref(H)
+        "delimeter" |-> D,
+        PARENT)
+      =>
+      SCOPES
+      L |-> scope(
+        "numbers" |-> list(NUMBERS)
+        "number" |-> lastNumber(OLD, REST)
+        "result" |-> ref(H)
+        "delimeter" |-> D,
+        PARENT)
+    </scopes>
+    <heap>
+      HEAP H |-> list(vCons(A, AS))
+      => HEAP H |-> list(intersperseAcc(vCons(A, AS), REST, D))
+    </heap>
+    requires notBool (L in_keys(SCOPES))
+     andBool notBool (H in_keys(HEAP))
+
+  claim [entry]:
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List")
+        FuncDef("intersperse", Params("numbers", "delimeter"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          For(Name("number"), Name("numbers"),
+            If(Name("result"),
+              Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+              .Stmts)
+            Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+          Return(Name("result")))))
+      ~> Call(Name("intersperse"), list(NUMBERS), D)
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "intersperse" |-> closureVal(
+          ("numbers", "delimeter"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          For(Name("number"), Name("numbers"),
+            If(Name("result"),
+              Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+              .Stmts)
+            Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+          Return(Name("result")),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(intersperseVS(NUMBERS, D)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
