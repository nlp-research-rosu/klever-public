+requires "verification.k"
+
+module AUDIT-SPEC-VACUITY
+  imports INTERSPERSE-VERIFICATION
+
+  // Satisfying ground input: numbers=[1,2,3], delimeter=4.
+  // Deliberately false result: the correct final element is 3, not 4.
+  claim [wrong-final-element]:
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List")
+        FuncDef("intersperse", Params("numbers", "delimeter"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          For(Name("number"), Name("numbers"),
+            If(Name("result"),
+              Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+              .Stmts)
+            Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+          Return(Name("result")))))
+      ~> Call(
+        Name("intersperse"),
+        list(vCons(1, vCons(2, vCons(3, .ValSeq)))),
+        4)
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "intersperse" |-> closureVal(
+          ("numbers", "delimeter"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          For(Name("number"), Name("numbers"),
+            If(Name("result"),
+              Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+              .Stmts)
+            Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+          Return(Name("result")),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        vCons(1, vCons(4, vCons(2, vCons(4, vCons(4, .ValSeq))))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule

codex
The false mutation built successfully, executed the real ground program, reached the correct heap `[1,4,2,4,3]`, and failed with `WarnStuckClaimState`/exit 1 against the deliberately wrong `[1,4,2,4,4]`. That is direct non-vacuity evidence. I’m cleaning the evidence index now so the successful reconstruction log is separate from the earlier claim-isolation diagnostic.
