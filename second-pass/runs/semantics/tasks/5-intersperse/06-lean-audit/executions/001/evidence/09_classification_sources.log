    17	
    18	  // ==== For: one loop, in-cell continuation, over #iterNext =================
    19	  // (the iterable is evaluated once, by strictness; the protocol stays rewrites —
    20	  // circularities anchor on #loop and narrowing substitutes the structure)
    21	  syntax KItem ::= #loop(Val, Expr, Stmts) | #loopStep(Expr, Stmts)
    22	                 | #while(Expr, Stmts) | #whileCond(Expr, Stmts)
    23	                 | #loopLbl(K) | "#cont" | "#brk"
    24	
    25	  rule <k> For(T:Expr, OBJ:Val, B:Stmts) => #loop(OBJ, T, B) ... </k>
    26	
    27	  rule <k> #loop(IT:Iterable, T:Expr, B:Stmts) => #iterNext(IT) ~> #loopStep(T, B) ... </k>
    28	  rule <k> #iterDone ~> #loopStep(_:Expr, _:Stmts) => .K ... </k>
    29	  rule <k> #iterYield(V:Val, REST:Iterable) ~> #loopStep(T:Expr, B:Stmts)
    30	        => #bindTgt(T, V) ~> B ~> #loopLbl(#loop(REST, T, B)) ... </k>
