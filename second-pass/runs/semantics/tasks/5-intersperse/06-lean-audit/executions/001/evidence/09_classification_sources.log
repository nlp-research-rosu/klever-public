    16	  rule truthy(B:Bool)          => B
    17	  rule truthy(noneV)           => false
    18	  rule truthy(I:Int)           => I =/=Int 0
    19	  rule truthy(str(S:IntSeq))   => notBool (S ==K .IntSeq)
