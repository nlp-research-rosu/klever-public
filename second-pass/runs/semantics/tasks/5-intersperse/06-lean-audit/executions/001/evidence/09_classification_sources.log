+ nl -ba /reference/k-proof/solution.py
     1	from typing import List
     2	
     3	
     4	def intersperse(numbers: List[int], delimeter: int) -> List[int]:
     5	    result = []
     6	    for number in numbers:
     7	        if result:
     8	            result.append(delimeter)
     9	        result.append(number)
    10	    return result
