+    )
+
+
+def k_intersperse_vs(numbers: list[int], delimiter: int) -> list[int]:
+    return k_intersperse_acc([], numbers, delimiter)
+
+
+def k_last_number(old: int, rest: list[int]) -> int:
+    if not rest:
+        return old
+    return k_last_number(rest[0], rest[1:])
+
+
+values = [-1, 0, 2]
