+    ),
+    "producer_tree_hash": (
+        computed["generation_producer_sources_sha256"]
+        == recorded_hashes["generation_producer_sources_sha256"]
+    ),
+    "workspace_pipeline_tree_hash": (
+        computed["k_workspace_sha256"]
+        == recorded_hashes["k_workspace_sha256"]
+    ),
