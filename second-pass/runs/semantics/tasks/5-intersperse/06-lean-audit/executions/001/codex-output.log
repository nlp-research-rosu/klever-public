     7	  syntax KItem ::= #branch(Bool, Stmts, Stmts)
     8	  rule <k> If(C:Val, T:Stmts, E:Stmts) => #branch(truthy(C), T, E) ... </k>
     9	  rule <k> #branch(true,  T:Stmts, _:Stmts) => T ... </k>
    10	  rule <k> #branch(false, _:Stmts, E:Stmts) => E ... </k>
