      "module": "INTERSPERSE-VERIFICATION",
      "normalized_sha256": "05af82756816da99d1e49a9f8d009c94185476c6c7d0fb7678256f49b7839b01",
      "rationale": "Base equation for the total mathematical accumulator summary: with no remaining input, intersperseAcc returns the accumulated ValSeq.",
      "source_rule_id": "rule-05af82756816da99d1e49a9f8d009c94185476c6c7d0fb7678256f49b7839b01",
      "start_line": 7,
      "text": "  rule intersperseAcc(ACC:ValSeq, .ValSeq, _:Int) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 9,
      "module": "INTERSPERSE-VERIFICATION",
      "normalized_sha256": "a69c7f927a81762ea2c4fbf188360727e079a96344cde3099709abd953299501",
      "rationale": "Recursive equation defining the first-element case of intersperseAcc when the accumulator is empty.",
      "source_rule_id": "rule-a69c7f927a81762ea2c4fbf188360727e079a96344cde3099709abd953299501",
      "start_line": 8,
      "text": "  rule intersperseAcc(.ValSeq, vCons(V:Val, REST:ValSeq), D:Int)\n    => intersperseAcc(vCons(V, .ValSeq), REST, D)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 17,
      "module": "INTERSPERSE-VERIFICATION",
      "normalized_sha256": "96273f0b4eae15373ec58939dbd00740dde58870a697d93b32a5a4bd04ed197b",
      "rationale": "Recursive equation defining the nonempty-accumulator case by appending the delimiter and next value before processing the remaining sequence.",
      "source_rule_id": "rule-96273f0b4eae15373ec58939dbd00740dde58870a697d93b32a5a4bd04ed197b",
      "start_line": 10,
      "text": "  rule intersperseAcc(vCons(A:Val, AS:ValSeq),\n                      vCons(V:Val, REST:ValSeq), D:Int)\n    => intersperseAcc(\n         valSeqConcat(\n           valSeqConcat(vCons(A, AS), vCons(D, .ValSeq)),\n           vCons(V, .ValSeq)),\n         REST,\n         D)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 21,
      "module": "INTERSPERSE-VERIFICATION",
      "normalized_sha256": "9be9c742f13371df267a06b8e67ec2e35592c9ac3cd5aa5b772100f6bf8c3abe",
      "rationale": "Defining equation for the named intersperseVS proof summary in terms of intersperseAcc with an empty initial accumulator.",
      "source_rule_id": "rule-9be9c742f13371df267a06b8e67ec2e35592c9ac3cd5aa5b772100f6bf8c3abe",
      "start_line": 20,
      "text": "  rule intersperseVS(NUMBERS:ValSeq, D:Int)\n    => intersperseAcc(.ValSeq, NUMBERS, D)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 24,
      "module": "INTERSPERSE-VERIFICATION",
      "normalized_sha256": "20166af5adb55b2aa1e6c90c631d9e6c733f576541555c546a5a90c9a7e7f3b7",
      "rationale": "Base equation for the total lastNumber structural helper: an empty remaining sequence preserves the prior loop value.",
      "source_rule_id": "rule-20166af5adb55b2aa1e6c90c631d9e6c733f576541555c546a5a90c9a7e7f3b7",
      "start_line": 24,
      "text": "  rule lastNumber(OLD:Val, .ValSeq) => OLD"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 26,
      "module": "INTERSPERSE-VERIFICATION",
      "normalized_sha256": "1602c9e6a845786876a75dac174363782ca1ac8b767d2e5f3baca81621fbc25b",
      "rationale": "Recursive equation for lastNumber that advances the remembered loop value through the remaining ValSeq.",
      "source_rule_id": "rule-1602c9e6a845786876a75dac174363782ca1ac8b767d2e5f3baca81621fbc25b",
      "start_line": 25,
      "text": "  rule lastNumber(_:Val, vCons(V:Val, REST:ValSeq))\n    => lastNumber(V, REST)"
    }
  ],
