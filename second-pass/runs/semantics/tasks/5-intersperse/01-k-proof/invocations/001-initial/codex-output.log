+requires "verification.k"
+
+module INTERSPERSE-SPEC
+  imports INTERSPERSE-VERIFICATION
+
+  // Loop entry before the first target binding. Its nonempty branch reaches
+  // the invariant below after one body execution.
+  claim
+    <k>
+      #loop(
+        list(REST), Name("number"),
+        If(Name("result"),
+          Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+          .Stmts)
+        Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+      ~> CONT
+      => CONT
+    </k>
+    <env> L </env>
+    <scopes>
+      SCOPES
+      L |-> scope(
+        "numbers" |-> list(NUMBERS)
+        "result" |-> ref(H)
+        "delimeter" |-> D,
+        PARENT)
+      =>
+      SCOPES
+      L |-> scope(
+        ("result" |-> ref(H)
+         "delimeter" |-> D)
+        loopScope("numbers" |-> list(NUMBERS), REST),
+        PARENT)
+    </scopes>
+    <heap>
+      HEAP H |-> list(ACC)
+      => HEAP H |-> list(intersperseAcc(ACC, REST, D))
+    </heap>
+    requires notBool (L in_keys(SCOPES))
+     andBool notBool (H in_keys(HEAP))
+
+  // Loop invariant after at least one target binding. The current number is
+  // overwritten on the next iteration and is otherwise semantically dead.
+  claim
+    <k>
+      #loop(
+        list(REST), Name("number"),
+        If(Name("result"),
+          Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+          .Stmts)
+        Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+      ~> CONT
+      => CONT
+    </k>
+    <env> L </env>
+    <scopes>
+      SCOPES
+      L |-> scope(
+        "numbers" |-> list(NUMBERS)
+        "number" |-> OLD
+        "result" |-> ref(H)
+        "delimeter" |-> D,
+        PARENT)
+      =>
+      SCOPES
+      L |-> scope(
+        ("result" |-> ref(H)
+         "delimeter" |-> D)
+        loopScope(
+          ("numbers" |-> list(NUMBERS) "number" |-> OLD),
+          REST),
+        PARENT)
+    </scopes>
+    <heap>
+      HEAP H |-> list(ACC)
+      => HEAP H |-> list(intersperseAcc(ACC, REST, D))
+    </heap>
+    requires notBool (L in_keys(SCOPES))
+     andBool notBool (H in_keys(HEAP))
+
+  claim
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List")
+        FuncDef("intersperse", Params("numbers", "delimeter"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          For(Name("number"), Name("numbers"),
+            If(Name("result"),
+              Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+              .Stmts)
+            Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+          Return(Name("result")))))
+      ~> Call(Name("intersperse"), list(NUMBERS), D)
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "intersperse" |-> closureVal(
+          ("numbers", "delimeter"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          For(Name("number"), Name("numbers"),
+            If(Name("result"),
+              Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+              .Stmts)
+            Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+          Return(Name("result")),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(intersperseVS(NUMBERS, D)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
