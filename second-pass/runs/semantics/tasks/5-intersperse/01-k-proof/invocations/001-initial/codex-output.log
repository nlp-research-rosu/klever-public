+    <env> L </env>
+    <scopes>
+      SCOPES
+      L |-> scope(
+        ("result" |-> ref(H)
+         "delimeter" |-> D)
+        LOCALS,
+        PARENT)
+      =>
+      SCOPES
+      L |-> scope(
+        ("result" |-> ref(H)
+         "delimeter" |-> D)
+        loopScope(LOCALS, REST),
+        PARENT)
+    </scopes>
+    <heap>
+      HEAP H |-> list(ACC)
+      => HEAP H |-> list(intersperseAcc(ACC, REST, D))
+    </heap>
+    requires notBool (L in_keys(SCOPES))
