+        "result" |-> ref(H)
+        "delimeter" |-> D,
+        PARENT)
+      =>
+      SCOPES
+      L |-> scope(
+        ("result" |-> ref(H)
+         "delimeter" |-> D)
+        loopScope("numbers" |-> list(NUMBERS), REST),
+        PARENT)
+    </scopes>
+    <heap>
+      HEAP H |-> list(.ValSeq)
+      => HEAP H |-> list(intersperseAcc(.ValSeq, REST, D))
+    </heap>
+    requires notBool (L in_keys(SCOPES))
+     andBool notBool (H in_keys(HEAP))
+
+  // Loop invariant after at least one target binding. The current number is
+  // overwritten on the next iteration and is otherwise semantically dead.
+  claim
+    <k>
+      #loop(
+        list(REST), Name("number"),
+        If(Name("result"),
+          Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+          .Stmts)
+        Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+      ~> CONT
+      => CONT
+    </k>
+    <env> L </env>
+    <scopes>
+      SCOPES
+      L |-> scope(
+        "numbers" |-> list(NUMBERS)
+        "number" |-> OLD
+        "result" |-> ref(H)
+        "delimeter" |-> D,
+        PARENT)
+      =>
+      SCOPES
+      L |-> scope(
+        ("result" |-> ref(H)
+         "delimeter" |-> D)
+        loopScope(
+          ("numbers" |-> list(NUMBERS) "number" |-> OLD),
+          REST),
+        PARENT)
+    </scopes>
+    <heap>
+      HEAP H |-> list(vCons(A, AS))
+      => HEAP H |-> list(intersperseAcc(vCons(A, AS), REST, D))
+    </heap>
+    requires notBool (L in_keys(SCOPES))
+     andBool notBool (H in_keys(HEAP))
+
+  claim
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List")
+        FuncDef("intersperse", Params("numbers", "delimeter"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          For(Name("number"), Name("numbers"),
+            If(Name("result"),
+              Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+              .Stmts)
+            Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
