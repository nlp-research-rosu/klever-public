+          .Stmts)
+        Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+      ~> CONT
+      => CONT
+    </k>
+    <env> L </env>
+    <scopes>
+      SCOPES
+      L |-> scope(
+        "numbers" |-> list(NUMBERS)
+        "number" |-> OLD
+        "result" |-> ref(H)
+        "delimeter" |-> D,
+        PARENT)
+      =>
