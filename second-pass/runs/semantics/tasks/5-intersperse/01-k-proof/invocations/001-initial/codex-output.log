diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b328049e0ff7fa85688527040de32ac434c7dea1
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,147 @@
+requires "verification.k"
+
+module INTERSPERSE-SPEC
+  imports INTERSPERSE-VERIFICATION
+
+  // Empty loop at function entry: no target has yet been bound.
+  claim
+    <k>
+      #loop(
+        list(.ValSeq), Name("number"),
+        If(Name("result"),
+          Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+          .Stmts)
+        Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+      ~> CONT
+      => CONT
+    </k>
+    <env> L </env>
+    <scopes>
+      SCOPES
+      L |-> scope(
+        "numbers" |-> list(NUMBERS)
+        "result" |-> ref(H)
+        "delimeter" |-> D,
+        PARENT)
+    </scopes>
+    <heap> HEAP H |-> list(.ValSeq) </heap>
+    requires notBool (L in_keys(SCOPES))
+     andBool notBool (H in_keys(HEAP))
+
+  // Nonempty loop at function entry. One execution establishes the invariant
+  // in the following claim.
+  claim
+    <k>
+      #loop(
+        list(vCons(V, REST)), Name("number"),
+        If(Name("result"),
+          Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+          .Stmts)
+        Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+      ~> CONT
+      => CONT
+    </k>
+    <env> L </env>
+    <scopes>
+      SCOPES
+      L |-> scope(
+        "numbers" |-> list(NUMBERS)
+        "result" |-> ref(H)
+        "delimeter" |-> D,
+        PARENT)
+      =>
+      SCOPES
+      L |-> scope(
+        "numbers" |-> list(NUMBERS)
+        "number" |-> lastNumber(V, REST)
+        "result" |-> ref(H)
+        "delimeter" |-> D,
+        PARENT)
+    </scopes>
+    <heap>
+      HEAP H |-> list(.ValSeq)
+      => HEAP H |-> list(intersperseAcc(.ValSeq, vCons(V, REST), D))
+    </heap>
+    requires notBool (L in_keys(SCOPES))
+     andBool notBool (H in_keys(HEAP))
+
+  // Once the first item has been appended, the accumulator is nonempty and
+  // every later iteration appends the delimiter followed by the next item.
+  claim
+    <k>
+      #loop(
+        list(REST), Name("number"),
+        If(Name("result"),
+          Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+          .Stmts)
+        Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+      ~> CONT
+      => CONT
+    </k>
+    <env> L </env>
+    <scopes>
+      SCOPES
+      L |-> scope(
+        "numbers" |-> list(NUMBERS)
+        "number" |-> OLD
+        "result" |-> ref(H)
+        "delimeter" |-> D,
+        PARENT)
+      =>
+      SCOPES
+      L |-> scope(
+        "numbers" |-> list(NUMBERS)
+        "number" |-> lastNumber(OLD, REST)
+        "result" |-> ref(H)
+        "delimeter" |-> D,
+        PARENT)
+    </scopes>
+    <heap>
+      HEAP H |-> list(vCons(A, AS))
+      => HEAP H |-> list(intersperseAcc(vCons(A, AS), REST, D))
+    </heap>
+    requires notBool (L in_keys(SCOPES))
+     andBool notBool (H in_keys(HEAP))
+
+  claim
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List")
+        FuncDef("intersperse", Params("numbers", "delimeter"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          For(Name("number"), Name("numbers"),
+            If(Name("result"),
+              Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+              .Stmts)
+            Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+          Return(Name("result")))))
+      ~> Call(Name("intersperse"), list(NUMBERS), D)
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "intersperse" |-> closureVal(
+          ("numbers", "delimeter"),
+          Assign(Name("result"), ListExpr(.Exprs))
+          For(Name("number"), Name("numbers"),
+            If(Name("result"),
+              Expr(Call(Attribute(Name("result"), "append"), Name("delimeter"))),
+              .Stmts)
+            Expr(Call(Attribute(Name("result"), "append"), Name("number"))))
+          Return(Name("result")),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(intersperseVS(NUMBERS, D)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..bd155dc029e07aba7473dbe0bf97d864c1217d3e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,27 @@
+requires "reference-semantics/semantics.k"
+
+module INTERSPERSE-VERIFICATION
+  imports MPY
+
+  syntax ValSeq ::= intersperseAcc(ValSeq, ValSeq, Int) [function, total]
+  rule intersperseAcc(ACC:ValSeq, .ValSeq, _:Int) => ACC
+  rule intersperseAcc(.ValSeq, vCons(V:Val, REST:ValSeq), D:Int)
+    => intersperseAcc(vCons(V, .ValSeq), REST, D)
+  rule intersperseAcc(vCons(A:Val, AS:ValSeq),
+                      vCons(V:Val, REST:ValSeq), D:Int)
+    => intersperseAcc(
+         valSeqConcat(
+           valSeqConcat(vCons(A, AS), vCons(D, .ValSeq)),
+           vCons(V, .ValSeq)),
+         REST,
+         D)
+
+  syntax ValSeq ::= intersperseVS(ValSeq, Int) [function, total]
+  rule intersperseVS(NUMBERS:ValSeq, D:Int)
+    => intersperseAcc(.ValSeq, NUMBERS, D)
+
+  syntax Val ::= lastNumber(Val, ValSeq) [function, total]
+  rule lastNumber(OLD:Val, .ValSeq) => OLD
+  rule lastNumber(_:Val, vCons(V:Val, REST:ValSeq))
+    => lastNumber(V, REST)
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module INTERSPERSE-VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /work
