The expanded proof is still running through the symbolic equality partitions; the concrete claims have already shown they close quickly. I’ve bounded the symbolic cases to all equality patterns for inputs of up to three arbitrary tokens, which directly exercises insertion, incrementing, maximum replacement, and tie retention without assuming concrete letters.
diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..2e53cb6215471b8b31840d2820ed00fff845d751
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,26 @@
+def histogram(test):
+    counts = {}
+    maximum = 0
+
+    for letter in test.split():
+        if letter in counts.keys():
+            counts[letter] = counts[letter] + 1
+        else:
+            counts[letter] = 1
+
+        if counts[letter] > maximum:
+            maximum = counts[letter]
+
+    result = {}
+    for letter in counts.keys():
+        if counts[letter] == maximum:
+            result[letter] = counts[letter]
+
+    return result
+
+
+assert histogram("a b c") == {"a": 1, "b": 1, "c": 1}
+assert histogram("a b b a") == {"a": 2, "b": 2}
+assert histogram("a b c a b") == {"a": 2, "b": 2}
+assert histogram("b b b b a") == {"b": 4}
+assert histogram("") == {}
