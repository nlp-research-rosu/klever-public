index 0000000000000000000000000000000000000000..91e2a37644a0db0458610485a18f184b9c6e3ad6
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,49 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A proof-only representation of a string whose whitespace split is TS.
+  // It lets claims quantify over token contents while retaining the supplied
+  // split and loop semantics for the implementation itself.
+  syntax IntSeq ::= tokenText(ValSeq) [constructor]
+  rule splitWS(tokenText(TS:ValSeq), .IntSeq, .ValSeq) => TS
+
+  // The translated solution plus one oracle assertion.  This macro is kept
+  // byte-for-byte structurally aligned with solution.mpy.
+  syntax Module ::= histogramCheck(Expr, Expr)
+  rule histogramCheck(INPUT:Expr, EXPECTED:Expr)
+    => Module(
+         FuncDef("histogram", Params("test"),
+           Assign(Name("counts"), DictExpr(.Entries))
+           Assign(Name("maximum"), Int(0))
+           For(Name("letter"), Call(Attribute(Name("test"), "split"), .Exprs),
+             If(Compare(
+               Name("letter"),
+               CmpOp("in", Call(Attribute(Name("counts"), "keys"), .Exprs))),
+               Assign(
+                 Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+               Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+             If(Compare(
+               Subscript(Name("counts"), Name("letter")),
+               CmpOp(">", Name("maximum"))),
+               Assign(
+                 Name("maximum"),
+                 Subscript(Name("counts"), Name("letter"))),
+               .Stmts))
+           Assign(Name("result"), DictExpr(.Entries))
+           For(Name("letter"), Call(Attribute(Name("counts"), "keys"), .Exprs),
+             If(Compare(
+               Subscript(Name("counts"), Name("letter")),
+               CmpOp("==", Name("maximum"))),
+               Assign(
+                 Subscript(Name("result"), Name("letter")),
+                 Subscript(Name("counts"), Name("letter"))),
+               .Stmts))
+           Return(Name("result")))
+         Assert(Compare(
+           Call(Name("histogram"), INPUT),
+           CmpOp("==", EXPECTED))))
+       [macro]
+endmodule

exec
/bin/bash -lc "sed -n '1,100p' reference-semantics/semantics/comprehension.k" in /work
 succeeded in 0ms:
// reference/src/semantics/comprehension.k — MPY-COMPREHENSION

module MPY-COMPREHENSION
  imports MPY-CORE
  imports MPY-OPERATORS
  imports MPY-LIST
  imports MPY-CONTROLS
  imports MPY-FUNCTIONS

  // A comprehension is pure syntactic sugar
  rule ListComp(ELT:Expr, Gs:CompFors) => Call(closureExpr(.ParamNames, compBody(Gs, ELT)), .Exprs)
  rule GenExp(ELT:Expr, Gs:CompFors)   => Call(closureExpr(.ParamNames, compBody(Gs, ELT)), .Exprs)

  syntax Stmts ::= compBody(CompFors, Expr) [macro]
  rule compBody(Gs:CompFors, ELT:Expr)
    => Assign(Name("$acc"), ListExpr(.Exprs)) compNest(Gs, ELT) Return(Name("$acc"))

  syntax Stmt ::= compNest(CompFors, Expr) [macro-rec]
  rule compNest(.CompFors, ELT:Expr)
    => Assign(Name("$acc"), BinOp("+", Name("$acc"), ListExpr(ELT)))
  rule compNest((CompFor(T:Expr, ITER:Expr, Fs:Exprs) GRest:CompFors), ELT:Expr)
    => For(T, ITER, If(compGuard(Fs), compNest(GRest, ELT), .Stmts))

  syntax Expr ::= compGuard(Exprs) [macro]
  rule compGuard(.Exprs)             => Bool(true)
  rule compGuard((F:Expr, Fs:Exprs)) => BoolOp("and", (F, Fs))
endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..2e53cb6215471b8b31840d2820ed00fff845d751
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,26 @@
+def histogram(test):
+    counts = {}
+    maximum = 0
+
+    for letter in test.split():
+        if letter in counts.keys():
+            counts[letter] = counts[letter] + 1
+        else:
+            counts[letter] = 1
+
+        if counts[letter] > maximum:
+            maximum = counts[letter]
+
+    result = {}
+    for letter in counts.keys():
+        if counts[letter] == maximum:
+            result[letter] = counts[letter]
+
+    return result
+
+
+assert histogram("a b c") == {"a": 1, "b": 1, "c": 1}
+assert histogram("a b b a") == {"a": 2, "b": 2}
+assert histogram("a b c a b") == {"a": 2, "b": 2}
+assert histogram("b b b b a") == {"b": 4}
+assert histogram("") == {}
