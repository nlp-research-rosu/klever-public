  claim
    <k>
      #loadAll(histogramCheck(
        Str(""),
        DictExpr(.Entries)))
      => .K
    </k>
    <env> 0 </env>
    <scopes>
      (0 |-> scope(.Map, parent(-1))
       -1 |-> builtinsScope)
      => ?FINALSCOPES:Map
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map => ?FINALHEAP:Map </heap>
    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>

  claim
    <k>
      #loadAll(histogramCheck(
        Str("a b c"),
        DictExpr(
          Entry(Str("a"), Int(1)),
          Entry(Str("b"), Int(1)),
          Entry(Str("c"), Int(1)))))
      => .K
    </k>
    <env> 0 </env>
    <scopes>
      (0 |-> scope(.Map, parent(-1))
       -1 |-> builtinsScope)
      => ?FINALSCOPES:Map
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map => ?FINALHEAP:Map </heap>
    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>

  claim
    <k>
      #loadAll(histogramCheck(
        Str("a b b a"),
        DictExpr(
          Entry(Str("a"), Int(2)),
          Entry(Str("b"), Int(2)))))
      => .K
    </k>
    <env> 0 </env>
    <scopes>
      (0 |-> scope(.Map, parent(-1))
       -1 |-> builtinsScope)
      => ?FINALSCOPES:Map
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map => ?FINALHEAP:Map </heap>
    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>

  claim
    <k>
      #loadAll(histogramCheck(
        Str("a b c a b"),
        DictExpr(
          Entry(Str("a"), Int(2)),
          Entry(Str("b"), Int(2)))))
  claim
    <k>
      #loadAll(histogramCheck(
        str(tokenText(
          vCons(str(A:IntSeq),
          vCons(str(B:IntSeq),
          vCons(str(A), .ValSeq))))),
        DictExpr(Entry(str(A), Int(2)))))
      => .K
    </k>
    <env> 0 </env>
    <scopes>
      (0 |-> scope(.Map, parent(-1))
       -1 |-> builtinsScope)
      => ?FINALSCOPES:Map
    </scopes>
