Module(
  FuncDef("histogram", Params("test"),
    Assign(Name("counts"), DictExpr())
    Assign(Name("maximum"), Int(0))
    For(Name("letter"), Call(Attribute(Name("test"), "split"), ),
      If(Compare(
        Name("letter"),
        CmpOp("in", Call(Attribute(Name("counts"), "keys"), ))),
        Assign(
          Subscript(Name("counts"), Name("letter")),
          BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
        Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
      If(Compare(
        Subscript(Name("counts"), Name("letter")),
        CmpOp(">", Name("maximum"))),
        Assign(
          Name("maximum"),
          Subscript(Name("counts"), Name("letter"))),
        ))
    Assign(Name("result"), DictExpr())
    For(Name("letter"), Call(Attribute(Name("counts"), "keys"), ),
      If(Compare(
        Subscript(Name("counts"), Name("letter")),
        CmpOp("==", Name("maximum"))),
        Assign(
          Subscript(Name("result"), Name("letter")),
          Subscript(Name("counts"), Name("letter"))),
        ))
    Return(Name("result")))
  Assert(
    Compare(Call(Name("histogram"), Str("")), CmpOp("==", DictExpr())))
  Assert(
    Compare(
      Call(Name("histogram"), Str("z")),
      CmpOp("==", DictExpr(Entry(Str("z"), Int(1))))))
  Assert(
    Compare(
      Call(Name("histogram"), Str("z z")),
      CmpOp("==", DictExpr(Entry(Str("z"), Int(2))))))
  Assert(
    Compare(
      Call(Name("histogram"), Str("z y")),
      CmpOp(
        "==",
        DictExpr(Entry(Str("z"), Int(1)), Entry(Str("y"), Int(1))))))
  Assert(
    Compare(
      Call(Name("histogram"), Str("z z y")),
      CmpOp("==", DictExpr(Entry(Str("z"), Int(2))))))
  Assert(
    Compare(
      Call(Name("histogram"), Str("z y z")),
      CmpOp("==", DictExpr(Entry(Str("z"), Int(2))))))
  Assert(
    Compare(
      Call(Name("histogram"), Str("z y y")),
      CmpOp("==", DictExpr(Entry(Str("y"), Int(2))))))
  Assert(
    Compare(
      Call(Name("histogram"), Str("z y x")),
      CmpOp(
        "==",
        DictExpr(
          Entry(Str("z"), Int(1)),
          Entry(Str("y"), Int(1)),
          Entry(Str("x"), Int(1))))))
  Assert(
    Compare(
      Call(Name("histogram"), Str("a a b b c")),
      CmpOp(
        "==",
        DictExpr(Entry(Str("a"), Int(2)), Entry(Str("b"), Int(2)))))))
