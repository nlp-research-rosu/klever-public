+requires "verification.k"
+
+module SYNTHETIC-WHITESPACE-WITNESS
+  imports VERIFICATION
+
+  // A is the concrete code sequence for "a b". The synthetic split abstraction
+  // treats the whole whitespace-containing A as one token.
+  claim
+    <k>
+      #loadAll(histogramCheck(
+        str(tokenText(vCons(
+          str(iCons(97, iCons(32, iCons(98, .IntSeq)))),
+          .ValSeq))),
+        DictExpr(Entry(
+          str(iCons(97, iCons(32, iCons(98, .IntSeq)))),
+          Int(1)))))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINALHEAP:Map </heap>
+    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/reconstruction/verification-ground.k b//tmp/audit-work/reconstruction/verification-ground.k
new file mode 100644
index 0000000000000000000000000000000000000000..249b34f8890627ac52a3b82a064cf6088fc1cdad
--- /dev/null
+++ b//tmp/audit-work/reconstruction/verification-ground.k
@@ -0,0 +1,40 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-GROUND
+  imports MPY
+
+  syntax Module ::= histogramCheck(Expr, Expr) [macro]
+  rule histogramCheck(INPUT:Expr, EXPECTED:Expr)
+    => Module(
+         FuncDef("histogram", Params("test"),
+           Assign(Name("counts"), DictExpr(.Entries))
+           Assign(Name("maximum"), Int(0))
+           For(Name("letter"), Call(Attribute(Name("test"), "split"), .Exprs),
+             If(Compare(
+               Name("letter"),
+               CmpOp("in", Call(Attribute(Name("counts"), "keys"), .Exprs))),
+               Assign(
+                 Subscript(Name("counts"), Name("letter")),
+                 BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
+               Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
+             If(Compare(
+               Subscript(Name("counts"), Name("letter")),
+               CmpOp(">", Name("maximum"))),
+               Assign(
+                 Name("maximum"),
+                 Subscript(Name("counts"), Name("letter"))),
+               .Stmts))
+           Assign(Name("result"), DictExpr(.Entries))
+           For(Name("letter"), Call(Attribute(Name("counts"), "keys"), .Exprs),
+             If(Compare(
+               Subscript(Name("counts"), Name("letter")),
+               CmpOp("==", Name("maximum"))),
+               Assign(
+                 Subscript(Name("result"), Name("letter")),
+                 Subscript(Name("counts"), Name("letter"))),
+               .Stmts))
+           Return(Name("result")))
+         Assert(Compare(
+           Call(Name("histogram"), INPUT),
+           CmpOp("==", EXPECTED))))
+endmodule
