def histogram(test):
    """Given a string representing a space separated lowercase letters, return a dictionary
    of the letter with the most repetition and containing the corresponding count.
    If several letters have the same occurrence, return all of them.
    
    Example:
    histogram('a b c') == {'a': 1, 'b': 1, 'c': 1}
    histogram('a b b a') == {'a': 2, 'b': 2}
    histogram('a b c a b') == {'a': 2, 'b': 2}
    histogram('b b b b a') == {'b': 4}
    histogram('') == {}

    """
# canonical.py — the UNMODIFIED HumanEval/111 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: histogram


def histogram(test):
    """Given a string representing a space separated lowercase letters, return a dictionary
    of the letter with the most repetition and containing the corresponding count.
    If several letters have the same occurrence, return all of them.
    
    Example:
    histogram('a b c') == {'a': 1, 'b': 1, 'c': 1}
    histogram('a b b a') == {'a': 2, 'b': 2}
    histogram('a b c a b') == {'a': 2, 'b': 2}
    histogram('b b b b a') == {'b': 4}
    histogram('') == {}

    """
    dict1={}
    list1=test.split(" ")
    t=0

    for i in list1:
        if(list1.count(i)>t) and i!='':
            t=list1.count(i)
    if t>0:
        for i in list1:
            if(list1.count(i)==t):
                
                dict1[i]=t
    return dict1
def histogram(test):
    counts = {}
    maximum = 0

    for letter in test.split():
        if letter in counts.keys():
            counts[letter] = counts[letter] + 1
        else:
            counts[letter] = 1

        if counts[letter] > maximum:
            maximum = counts[letter]

    result = {}
    for letter in counts.keys():
        if counts[letter] == maximum:
            result[letter] = counts[letter]

    return result
Module(
  FuncDef("histogram", Params("test"),
    Assign(Name("counts"), DictExpr())
    Assign(Name("maximum"), Int(0))
    For(Name("letter"), Call(Attribute(Name("test"), "split"), ),
      If(Compare(
        Name("letter"),
        CmpOp("in", Call(Attribute(Name("counts"), "keys"), ))),
        Assign(
          Subscript(Name("counts"), Name("letter")),
          BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
        Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
      If(Compare(
        Subscript(Name("counts"), Name("letter")),
        CmpOp(">", Name("maximum"))),
        Assign(
          Name("maximum"),
          Subscript(Name("counts"), Name("letter"))),
        ))
    Assign(Name("result"), DictExpr())
    For(Name("letter"), Call(Attribute(Name("counts"), "keys"), ),
      If(Compare(
        Subscript(Name("counts"), Name("letter")),
        CmpOp("==", Name("maximum"))),
        Assign(
          Subscript(Name("result"), Name("letter")),
          Subscript(Name("counts"), Name("letter"))),
        ))
    Return(Name("result"))))
