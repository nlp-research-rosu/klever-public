Module(
  FuncDef("histogram", Params("test"),
    Assign(Name("counts"), DictExpr())
    Assign(Name("maximum"), Int(0))
    For(Name("letter"), Call(Attribute(Name("test"), "split"), ),
      If(Compare(
        Name("letter"),
        CmpOp("in", Call(Attribute(Name("counts"), "keys"), ))),
        Assign(
          Subscript(Name("counts"), Name("letter")),
          BinOp("+", Subscript(Name("counts"), Name("letter")), Int(1))),
        Assign(Subscript(Name("counts"), Name("letter")), Int(1)))
      If(Compare(
        Subscript(Name("counts"), Name("letter")),
        CmpOp(">", Name("maximum"))),
        Assign(
          Name("maximum"),
          Subscript(Name("counts"), Name("letter"))),
        ))
    Assign(Name("result"), DictExpr())
    For(Name("letter"), Call(Attribute(Name("counts"), "keys"), ),
      If(Compare(
        Subscript(Name("counts"), Name("letter")),
        CmpOp("==", Name("maximum"))),
        Assign(
          Subscript(Name("result"), Name("letter")),
          Subscript(Name("counts"), Name("letter"))),
        ))
    Return(Name("result"))))
