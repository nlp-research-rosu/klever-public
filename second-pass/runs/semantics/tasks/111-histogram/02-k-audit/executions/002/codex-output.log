+    --spec-module HISTOGRAM-SPEC-VACUITY \
+    --warnings none
+)
+command_status=$?
+printf 'MUTATION_BUILD_EXIT_STATUS: %s\n' "$command_status"
+if (( command_status != 0 )); then overall_status=1; fi
+
+printf '%s\n' \
