/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import hashlib,itertools
root=Path('/reference/reference-semantics'); exp='1de6d5f51876cf9d0f4449a78f077f8b127a14add0504d5060da680fc5a443de'
allents=sorted([(p.relative_to(root).as_posix(),p.is_dir(),p) for p in root.rglob('*')])
for dirs,pathpre,sep,typemode,payload,size,trail in itertools.product([0,1],['','./'],[b'',b'\\0',b'\\n',b' '],['','word','char'],['raw','hex','bin'],['','dec','bin8'],[b'',b'\\0',b'\\n']):
 h=hashlib.sha256()
 for r,isdir,p in allents:
  if isdir and not dirs:continue
  h.update((pathpre+r).encode());h.update(sep)
  if typemode=='word':h.update(b'directory' if isdir else b'file');h.update(sep)
  elif typemode=='char':h.update(b'd' if isdir else b'f');h.update(sep)
  if not isdir:
   b=p.read_bytes()
   if size=='dec':h.update(str(len(b)).encode());h.update(sep)
   elif size=='bin8':h.update(len(b).to_bytes(8,'big'));h.update(sep)
   if payload=='raw':h.update(b)
   elif payload=='hex':h.update(hashlib.sha256(b).hexdigest().encode())
   else:h.update(hashlib.sha256(b).digest())
  h.update(trail)
 if h.hexdigest()==exp:
  print('MATCH',dirs,pathpre,sep,typemode,payload,size,trail);break
else:print('no match')
PY" in /audit-output
