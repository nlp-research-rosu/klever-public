+  --backend haskell \
+  --main-module CLOSEST-INTEGER-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module CLOSEST-INTEGER-SPEC
