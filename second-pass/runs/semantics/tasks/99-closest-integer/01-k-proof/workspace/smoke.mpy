Module(
  FuncDef("closest_integer", Params("value"),
    Assign(Name("number"), Call(Name("float"), Name("value")))
    If(Compare(Name("number"), CmpOp(">", Float(0.0))),
      Return(Call(Name("int"), BinOp("+", Name("number"), Float(0.5)))),
      )
    Return(Call(Name("int"), BinOp("-", Name("number"), Float(0.5)))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("10")),
      CmpOp("==", Int(10))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("15.3")),
      CmpOp("==", Int(15))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("14.5")),
      CmpOp("==", Int(15))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-14.5")),
      CmpOp("==", UnaryOp("-", Int(15)))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-14.4")),
      CmpOp("==", UnaryOp("-", Int(14)))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("0.5")),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-0.5")),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("0")),
      CmpOp("==", Int(0)))))
