Module(
  FuncDef("closest_integer", Params("value"),
    Assign(Name("number"), Call(Name("float"), Name("value")))
    If(Compare(Name("number"), CmpOp(">", Float(0.0))),
      Return(Call(Name("int"), BinOp("+", Name("number"), Float(0.5)))),
      )
    Return(Call(Name("int"), BinOp("-", Name("number"), Float(0.5))))))
