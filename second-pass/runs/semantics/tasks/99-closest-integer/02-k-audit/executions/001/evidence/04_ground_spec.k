requires "verification.k"

module CLOSEST-INTEGER-GROUND-SPEC
  imports CLOSEST-INTEGER-VERIFICATION

  // Documented ordinary input.
  claim
    <k> runClosest(str(strToCodes("10"))) => 10 </k>
    <env> 0 </env>
    <scopes>
      0  |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>

  // Valid decimal-string witness on which the candidate differs from both
  // the trusted canonical implementation and exact decimal rounding.
  claim
    <k> runClosest(str(strToCodes("0.49999999999999994"))) => 1 </k>
    <env> 0 </env>
    <scopes>
      0  |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule
