--- /dev/null
+++ b/evidence/run-and-log.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  command_status=$?
+  printf '\nEXIT STATUS: %d\n' "$command_status"
+  exit "$command_status"
+} >"$log_path" 2>&1

