python3 -c 'import importlib.util; p=\"/tmp/audit-work/candidate-src/solution.py\"; s=importlib.util.spec_from_file_location(\"solution\",p); m=importlib.util.module_from_spec(s); s.loader.exec_module(m); print(m.closest_integer(\"1e1\"))' 2>&1 | tee -a /audit-output/evidence/04_semantics_divergence_witness.log
