+         Name("even_position"),
+         Assign(
+           Name("total"),
+           BinOp(
+             "+",
+             Name("total"),
+             BinOp(
+               "*",
+               Name("value"),
+               BinOp("%", Name("value"), Int(2)))))
+         .Stmts,
+         .Stmts)
+       Assign(
+         Name("even_position"),
+         UnaryOp("not", Name("even_position")))
+       .Stmts
