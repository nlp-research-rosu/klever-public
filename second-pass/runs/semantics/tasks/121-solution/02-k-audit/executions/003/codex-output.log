+      Call(solutionClosure, (list(.ValSeq), .Exprs))
+      => 0
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
