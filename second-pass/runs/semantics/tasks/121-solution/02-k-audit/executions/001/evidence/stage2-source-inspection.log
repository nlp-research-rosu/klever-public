===== /reference/canonical.py =====
     1	# canonical.py — the UNMODIFIED HumanEval/121 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: solution
     4	
     5	
     6	def solution(lst):
     7	    """Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.
     8	    
     9	
    10	    Examples
    11	    solution([5, 8, 7, 1]) ==> 12
    12	    solution([3, 3, 3, 3, 3]) ==> 9
    13	    solution([30, 13, 24, 321]) ==>0
    14	    """
    15	    return sum([x for idx, x in enumerate(lst) if idx%2==0 and x%2==1])

===== /candidate/solution.py =====
     1	def solution(lst):
     2	    total = 0
     3	    even_position = True
     4	    value = 0
     5	    for value in lst:
     6	        if even_position:
     7	            total = total + value * (value % 2)
     8	        even_position = not even_position
     9	    return total

===== /candidate/solution.mpy =====
     1	Module(
     2	  FuncDef("solution", Params("lst"),
     3	    Assign(Name("total"), Int(0))
     4	    Assign(Name("even_position"), Bool(true))
     5	    Assign(Name("value"), Int(0))
     6	    For(Name("value"), Name("lst"),
     7	      If(Name("even_position"),
     8	        Assign(
     9	          Name("total"),
    10	          BinOp(
    11	            "+",
    12	            Name("total"),
    13	            BinOp("*", Name("value"), BinOp("%", Name("value"), Int(2))))),
    14	        )
    15	      Assign(
    16	        Name("even_position"),
    17	        UnaryOp("not", Name("even_position"))))
    18	    Return(Name("total"))))

===== /candidate/spec.k =====
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Inductive loop invariant: starting with TOTAL and parity EVEN, consuming
     7	  // VS adds exactly the contract value for that suffix.  The rest of the local
     8	  // frame is existential on the right because the loop also updates its
     9	  // iteration variable and parity flag; neither is observable after return.
    10	  claim [loop-invariant]:
    11	    <k>
    12	      #loop(list(VS:ValSeq), Name("value"), solutionLoopBody)
    13	      ~> KONT:K
    14	      =>
    15	      KONT
    16	    </k>
    17	    <env> L:Int </env>
    18	    <scopes>
    19	      BASE:Map
    20	      L |-> scope(
    21	        "lst" |-> LIST:Val
    22	        "total" |-> TOTAL:Int
    23	        "even_position" |-> EVEN:Bool
    24	        "value" |-> OLD:Val,
    25	        P:Parent)
    26	      =>
    27	      BASE
    28	      L |-> scope(
    29	        "lst" |-> LIST
    30	        "total" |-> oddAtEvenAcc(VS, EVEN, TOTAL)
    31	        "even_position" |-> ?FINAL_EVEN:Bool
    32	        "value" |-> ?FINAL_VALUE:Val,
    33	        P)
    34	    </scopes>
    35	    requires allInts(VS)
    36	
    37	  claim [solution-correct]:
    38	    <k>
    39	      Call(solutionClosure, (list(VS:ValSeq), .Exprs))
    40	      =>
    41	      oddAtEvenPositions(VS, true)
    42	    </k>
    43	    <env> 0 </env>
    44	    <scopes>
    45	      0  |-> scope(.Map, parent(-1))
    46	      -1 |-> builtinsScope
    47	    </scopes>
    48	    <scopeLoc> 1 </scopeLoc>
    49	    <heap> .Map </heap>
    50	    <heapLoc> 0 </heapLoc>
    51	    <stack> .List </stack>
    52	    <ret> noRet </ret>
    53	    <exc> NoExc </exc>
    54	    <exit-code> 0 </exit-code>
    55	    requires allInts(VS)
    56	endmodule

===== /candidate/verification.k =====
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // These macros are the exact constructor terms emitted in solution.mpy.
     7	  syntax Stmts ::= "solutionLoopBody" [macro]
     8	  rule solutionLoopBody
     9	    => If(
    10	         Name("even_position"),
    11	         Assign(
    12	           Name("total"),
    13	           BinOp(
    14	             "+",
    15	             Name("total"),
    16	             BinOp(
    17	               "*",
    18	               Name("value"),
    19	               BinOp("%", Name("value"), Int(2)))))
    20	         .Stmts,
    21	         .Stmts)
    22	       Assign(
    23	         Name("even_position"),
    24	         UnaryOp("not", Name("even_position")))
    25	       .Stmts
    26	
    27	  syntax Stmts ::= "solutionBody" [macro]
    28	  rule solutionBody
    29	    => Assign(Name("total"), Int(0))
    30	       Assign(Name("even_position"), Bool(true))
    31	       Assign(Name("value"), Int(0))
    32	       For(Name("value"), Name("lst"), solutionLoopBody)
    33	       Return(Name("total"))
    34	       .Stmts
    35	
    36	  syntax Val ::= "solutionClosure" [macro]
    37	  rule solutionClosure
    38	    => closureVal(("lst", .ParamNames), solutionBody, 0)
    39	
    40	  // Mathematical contract.  The boolean says whether the next element is at
    41	  // an even zero-based position.  Only odd integers at such positions add in.
    42	  syntax Bool ::= allInts(ValSeq) [function, total]
    43	  rule allInts(.ValSeq) => true
    44	  rule allInts(vCons(V:Val, R:ValSeq)) => isInt(V) andBool allInts(R)
    45	
    46	  // The Haskell backend retains an allInts-constrained element at sort Val.
    47	  // This projection and the two guarded rules express the corresponding
    48	  // subsort fact without changing behavior for any concrete Python integer.
    49	  syntax Int ::= intProjection(Val) [function, total]
    50	  rule intProjection(I:Int) => I
    51	
    52	  rule <k> BinOp("%", V:Val, I:Int) => pyMod(intProjection(V), I) ... </k>
    53	    requires isInt(V)
    54	    [priority(40)]
    55	  rule <k> BinOp("+", I:Int, V:Val) => I +Int intProjection(V) ... </k>
    56	    requires isInt(V)
    57	    [priority(40)]
    58	  rule <k> BinOp("*", V:Val, I:Int) => intProjection(V) *Int I ... </k>
    59	    requires isInt(V)
    60	    [priority(40)]
    61	
    62	  syntax Int ::= oddAtEvenPositions(ValSeq, Bool) [function]
    63	               | oddAtEvenAcc(ValSeq, Bool, Int) [function]
    64	  rule oddAtEvenPositions(VS:ValSeq, B:Bool)
    65	    => oddAtEvenAcc(VS, B, 0)
    66	  rule oddAtEvenAcc(.ValSeq, _:Bool, ACC:Int) => ACC
    67	  rule oddAtEvenAcc(vCons(V:Val, R:ValSeq), true, ACC:Int)
    68	    => oddAtEvenAcc(
    69	         R,
    70	         false,
    71	         ACC +Int intProjection(V) *Int pyMod(intProjection(V), 2))
    72	  rule oddAtEvenAcc(vCons(_:Val, R:ValSeq), false, ACC:Int)
    73	    => oddAtEvenAcc(R, true, ACC)
    74	endmodule

