COMMAND: bash -lc $'\nset +e\nprintf "TOOL_VERSIONS\\n"\ncommand -v kup\ncommand -v kompile\nkompile --version\nkprove --version\nprintf "\\nCANDIDATE_TREE\\n"\nfind /candidate -printf "%y %P -> %l\\n" | sort\nprintf "\\nREFERENCE_TREE\\n"\nfind /reference -printf "%y %P -> %l\\n" | sort\nprintf "\\nCANDIDATE_SYMLINKS\\n"\nfind /candidate -type l -printf "%P -> %l\\n"\nprintf "\\nREQUIRED_UNTRUSTED_METADATA\\n"\nfor item in run-input.json metrics.json codex-last.txt codex-output.log generation-trace.json trace.json; do\n  if test -e "/candidate/$item" || test -L "/candidate/$item"; then\n    stat -c "%F %n" "/candidate/$item"\n  else\n    printf "MISSING /candidate/%s\\n" "$item"\n  fi\ndone\nprintf "\\nPROMPT_CMP\\n"\ncmp -s /candidate/prompt.py /reference/prompt.py\nprintf "prompt.py cmp status=%d\\n" "$?"\nsha256sum /candidate/prompt.py /reference/prompt.py\nprintf "\\nTRANSLATOR_CMP\\n"\ncmp -s /candidate/py2mpy.py /reference/py2mpy.py\nprintf "py2mpy.py cmp status=%d\\n" "$?"\nsha256sum /candidate/py2mpy.py /reference/py2mpy.py\nprintf "\\nSEMANTICS_DIFF\\n"\ndiff -ruN --no-dereference /reference/reference-semantics /candidate/reference-semantics\nprintf "semantics diff status=%d\\n" "$?"\nprintf "\\nTOP_LEVEL_TYPES\\n"\nfor item in prompt.py py2mpy.py solution.py solution.mpy spec.k verification.k reference-semantics; do\n  if test -e "/candidate/$item" || test -L "/candidate/$item"; then\n    stat -c "%F %n" "/candidate/$item"\n  else\n    printf "MISSING /candidate/%s\\n" "$item"\n  fi\ndone\nexit 0\n'
