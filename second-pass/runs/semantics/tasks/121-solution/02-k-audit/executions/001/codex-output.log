index 0000000000000000000000000000000000000000..0417ff14307ab6443a64279cd52418af0a0cd0a3
--- /dev/null
+++ b/evidence/verification-bridgefree.k
@@ -0,0 +1,10 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BRIDGEFREE
+  imports MPY
