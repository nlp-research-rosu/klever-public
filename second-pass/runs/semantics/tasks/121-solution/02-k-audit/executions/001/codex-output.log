cd /audit-output
printf \"FINAL_MARKERS\\n\"
tail -2 REVIEW.md
printf \"HELPER_FILE_COUNT\\n\"
find /reference/reference-semantics/semantics -maxdepth 1 -type f -name \"*.k\" | wc -l
printf \"REVIEW_LINK_CHECK\\n\"
rg -oP \"(?<=\\\\]\\\\()evidence/["'^)]+" REVIEW.md | sort -u | while IFS= read -r target; do test -f "$target" || { printf "MISSING %s'"\\n\" \""'$target"; exit 1; }; done
