new file mode 100644
index 0000000000000000000000000000000000000000..47a5175ce814f520dbd439def6ba2d041292c27f
--- /dev/null
+++ b/evidence/spec-witness.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module SPEC-WITNESS
+  imports VERIFICATION
+
+  claim [summary-ground]:
+    oddAtEvenPositions(
+      vCons(5, vCons(8, vCons(7, vCons(1, .ValSeq)))),
+      true)
+    =>
+    12
+
+  claim [entry-ground]:
+    <k>
+      Call(
+        solutionClosure,
+        (list(vCons(5, vCons(8, vCons(7, vCons(1, .ValSeq))))), .Exprs))
+      =>
+      12
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
