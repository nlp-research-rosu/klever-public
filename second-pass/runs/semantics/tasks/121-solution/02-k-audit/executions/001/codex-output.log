diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..afa7dcd226bdc9027577ac4d211b10dcb7a17588
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,28 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // False mutation: the submitted program returns 12 for this satisfying input,
