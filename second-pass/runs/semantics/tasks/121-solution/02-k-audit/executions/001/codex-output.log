diff --git a/evidence/stage3-proof-solution-correct.log b/evidence/stage3-proof-solution-correct.log
index b23408b9e80a7cbc2409b47d007880173dbc205f..24f37c24f3735651136e4a75fb2844d27816dc02
--- a/evidence/stage3-proof-solution-correct.log
