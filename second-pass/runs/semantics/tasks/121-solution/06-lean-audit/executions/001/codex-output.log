--- solution.py
     1	def solution(lst):
     2	    total = 0
     3	    even_position = True
     4	    value = 0
     5	    for value in lst:
     6	        if even_position:
     7	            total = total + value * (value % 2)
     8	        even_position = not even_position
     9	    return total
--- prompt.py
     1	
     2	def solution(lst):
     3	    """Given a non-empty list of integers, return the sum of all of the odd elements that are in even positions.
     4	    
     5	
     6	    Examples
     7	    solution([5, 8, 7, 1]) ==> 12
     8	    solution([3, 3, 3, 3, 3]) ==> 9
     9	    solution([30, 13, 24, 321]) ==>0
    10	    """
--- solution.mpy
     1	Module(
     2	  FuncDef("solution", Params("lst"),
     3	    Assign(Name("total"), Int(0))
     4	    Assign(Name("even_position"), Bool(true))
     5	    Assign(Name("value"), Int(0))
     6	    For(Name("value"), Name("lst"),
     7	      If(Name("even_position"),
     8	        Assign(
     9	          Name("total"),
    10	          BinOp(
    11	            "+",
    12	            Name("total"),
    13	            BinOp("*", Name("value"), BinOp("%", Name("value"), Int(2))))),
    14	        )
    15	      Assign(
    16	        Name("even_position"),
    17	        UnaryOp("not", Name("even_position"))))
    18	    Return(Name("total"))))
