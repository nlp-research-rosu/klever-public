codex
The root cause is the container’s PID/proc mapping: Lean 4.22 asks `/proc/<getpid>/exe`, while this sandbox exposes the running executable reliably only as `/proc/self/exe`. I’m applying a narrow read-only compatibility shim that redirects only that executable-path lookup; it does not alter project files, Lean terms, or build outputs.
apply patch
patch: completed
/tmp/audit-work/lean_proc_compat.c
diff --git a//tmp/audit-work/lean_proc_compat.c b//tmp/audit-work/lean_proc_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..563d2f8136b2fe1c548363de4dd2871d4498542f
--- /dev/null
+++ b//tmp/audit-work/lean_proc_compat.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (path != NULL
+        && strncmp(path, "/proc/", 6) == 0
+        && strcmp(path + strlen(path) - 4, "/exe") == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}

