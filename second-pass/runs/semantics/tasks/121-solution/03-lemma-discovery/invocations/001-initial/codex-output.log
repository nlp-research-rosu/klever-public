import json
from collections import Counter
from pathlib import Path
inv = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
expected = [r['source_rule_id'] for r in inv['rules']]
actual = [r['source_rule_id'] for r in out['rules']]
assert actual == expected
assert len(actual) == len(set(actual)) == len(expected)
for entry in out['rules']:
    assert list(entry) == ['source_rule_id', 'classification', 'rationale']
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
classes = {r['source_rule_id']: r['classification'] for r in out['rules']}
for source in inv['rules']:
    if 'simplification' in source['attributes']:
        assert classes[source['source_rule_id']] in {'DEFINITION', 'DOMAIN_LEMMA'}
print('validated rules:', len(actual))
print('classification counts:', dict(Counter(r['classification'] for r in out['rules'])))
print('inventory sha256:', out['inventory_sha256'])
PY
