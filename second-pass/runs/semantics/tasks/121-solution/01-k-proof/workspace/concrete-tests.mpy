Module(
  FuncDef("solution", Params("lst"),
    Assign(Name("total"), Int(0))
    Assign(Name("even_position"), Bool(true))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("lst"),
      If(Name("even_position"),
        Assign(
          Name("total"),
          BinOp(
            "+",
            Name("total"),
            BinOp("*", Name("value"), BinOp("%", Name("value"), Int(2))))),
        )
      Assign(
        Name("even_position"),
        UnaryOp("not", Name("even_position"))))
    Return(Name("total")))
  Assert(
    Compare(
      Call(Name("solution"), ListExpr(Int(5), Int(8), Int(7), Int(1))),
      CmpOp("==", Int(12))))
  Assert(
    Compare(
      Call(
        Name("solution"),
        ListExpr(Int(3), Int(3), Int(3), Int(3), Int(3))),
      CmpOp("==", Int(9))))
  Assert(
    Compare(
      Call(
        Name("solution"),
        ListExpr(Int(30), Int(13), Int(24), Int(321))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("solution"),
        ListExpr(UnaryOp("-", Int(5)), Int(2), UnaryOp("-", Int(3)))),
      CmpOp("==", UnaryOp("-", Int(8)))))
  Assert(
    Compare(
      Call(Name("solution"), ListExpr(Int(2))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("solution"), ListExpr(Int(7))),
      CmpOp("==", Int(7)))))
