Module(
  FuncDef("solution", Params("lst"),
    Assign(Name("total"), Int(0))
    Assign(Name("even_position"), Bool(true))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("lst"),
      If(Name("even_position"),
        Assign(
          Name("total"),
          BinOp(
            "+",
            Name("total"),
            BinOp("*", Name("value"), BinOp("%", Name("value"), Int(2))))),
        )
      Assign(
        Name("even_position"),
        UnaryOp("not", Name("even_position"))))
    Return(Name("total"))))
