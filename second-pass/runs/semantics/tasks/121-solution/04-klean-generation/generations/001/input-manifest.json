{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 25,
      "module": "VERIFICATION",
      "normalized_sha256": "9a14ac8ea99ac106c04cbb7c22e479d72e4847d41db160f4562818da0ee3bca8",
      "rationale": "Macro equation expanding the named solutionLoopBody proof term into the exact loop-body constructor sequence.",
      "source_rule_id": "rule-9a14ac8ea99ac106c04cbb7c22e479d72e4847d41db160f4562818da0ee3bca8",
      "start_line": 8,
      "text": "  rule solutionLoopBody\n    => If(\n         Name(\"even_position\"),\n         Assign(\n           Name(\"total\"),\n           BinOp(\n             \"+\",\n             Name(\"total\"),\n             BinOp(\n               \"*\",\n               Name(\"value\"),\n               BinOp(\"%\", Name(\"value\"), Int(2)))))\n         .Stmts,\n         .Stmts)\n       Assign(\n         Name(\"even_position\"),\n         UnaryOp(\"not\", Name(\"even_position\")))\n       .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 34,
      "module": "VERIFICATION",
      "normalized_sha256": "22be61e6781eb774e366d137c780a1f77737942b17fbae671d156477c70b08a0",
      "rationale": "Macro equation expanding the named solutionBody proof term into initialization, the loop, and return.",
      "source_rule_id": "rule-22be61e6781eb774e366d137c780a1f77737942b17fbae671d156477c70b08a0",
      "start_line": 28,
      "text": "  rule solutionBody\n    => Assign(Name(\"total\"), Int(0))\n       Assign(Name(\"even_position\"), Bool(true))\n       Assign(Name(\"value\"), Int(0))\n       For(Name(\"value\"), Name(\"lst\"), solutionLoopBody)\n       Return(Name(\"total\"))\n       .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 38,
      "module": "VERIFICATION",
      "normalized_sha256": "1a409f5300e51fca790020cff977d81f9de163192788d447b7120daeebad1cef",
      "rationale": "Macro equation defining solutionClosure as the closure value for the translated solution body.",
      "source_rule_id": "rule-1a409f5300e51fca790020cff977d81f9de163192788d447b7120daeebad1cef",
      "start_line": 37,
      "text": "  rule solutionClosure\n    => closureVal((\"lst\", .ParamNames), solutionBody, 0)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 43,
      "module": "VERIFICATION",
      "normalized_sha256": "8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "rationale": "Base equation of the structural allInts predicate on an empty value sequence.",
      "source_rule_id": "rule-8277b118773512287e2b2b20da4dbf45607f85956623bafa9028b50596471d08",
      "start_line": 43,
      "text": "  rule allInts(.ValSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 44,
      "module": "VERIFICATION",
      "normalized_sha256": "bb65aed9f318cb650e6f3aaeb61b929864859d3dc05404f2b4a53b0d1f2058d0",
      "rationale": "Recursive equation defining allInts on a nonempty value sequence.",
      "source_rule_id": "rule-bb65aed9f318cb650e6f3aaeb61b929864859d3dc05404f2b4a53b0d1f2058d0",
      "start_line": 44,
      "text": "  rule allInts(vCons(V:Val, R:ValSeq)) => isInt(V) andBool allInts(R)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 50,
      "module": "VERIFICATION",
      "normalized_sha256": "ee037f34560a885384a02e8e8903ff3f2cbeff693f36c18833c7231057e4bc19",
      "rationale": "Equation defining intProjection to be the identity when its value is syntactically an Int.",
      "source_rule_id": "rule-ee037f34560a885384a02e8e8903ff3f2cbeff693f36c18833c7231057e4bc19",
      "start_line": 50,
      "text": "  rule intProjection(I:Int) => I"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 65,
      "module": "VERIFICATION",
      "normalized_sha256": "53298cdf4c77bed8d7c5e2361f072271e2906436d920db13625e8fe95c00059e",
      "rationale": "Equation defining the public odd-at-even-positions summary through its accumulator helper.",
      "source_rule_id": "rule-53298cdf4c77bed8d7c5e2361f072271e2906436d920db13625e8fe95c00059e",
      "start_line": 64,
      "text": "  rule oddAtEvenPositions(VS:ValSeq, B:Bool)\n    => oddAtEvenAcc(VS, B, 0)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 66,
      "module": "VERIFICATION",
      "normalized_sha256": "b90cbd7971f5c0b6cec4fed6ab9e1f1bd1e0dde901bf0ad36076336bf0adf6c1",
      "rationale": "Base equation of the oddAtEvenAcc recurrence, returning the accumulator for an empty sequence.",
      "source_rule_id": "rule-b90cbd7971f5c0b6cec4fed6ab9e1f1bd1e0dde901bf0ad36076336bf0adf6c1",
      "start_line": 66,
      "text": "  rule oddAtEvenAcc(.ValSeq, _:Bool, ACC:Int) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 71,
      "module": "VERIFICATION",
      "normalized_sha256": "b11e6d456c5e0099088d2aae2ee0cd578aafde80c6a6063e83c41b7e70706874",
      "rationale": "Recursive equation defining the accumulator update when the current sequence position is even.",
      "source_rule_id": "rule-b11e6d456c5e0099088d2aae2ee0cd578aafde80c6a6063e83c41b7e70706874",
      "start_line": 67,
      "text": "  rule oddAtEvenAcc(vCons(V:Val, R:ValSeq), true, ACC:Int)\n    => oddAtEvenAcc(\n         R,\n         false,\n         ACC +Int intProjection(V) *Int pyMod(intProjection(V), 2))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 73,
      "module": "VERIFICATION",
      "normalized_sha256": "1d0ba6e27067d73690cdcc54d10563b209badc6ceb26f05e23c549fcecee3699",
      "rationale": "Recursive equation defining the accumulator transition when the current sequence position is odd.",
      "source_rule_id": "rule-1d0ba6e27067d73690cdcc54d10563b209badc6ceb26f05e23c549fcecee3699",
      "start_line": 72,
      "text": "  rule oddAtEvenAcc(vCons(_:Val, R:ValSeq), false, ACC:Int)\n    => oddAtEvenAcc(R, true, ACC)"
    }
  ],
