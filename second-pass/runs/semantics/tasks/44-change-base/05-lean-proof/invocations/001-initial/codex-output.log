+#include <sys/types.h>
+#include <unistd.h>
+#include <stdlib.h>
+
+pid_t getpid(void) {
+    char path[64];
+    ssize_t size = readlink("/proc/self", path, sizeof(path) - 1);
+    if (size <= 0) {
+        return (pid_t)-1;
+    }
+    path[size] = '\0';
+    return (pid_t)strtol(path, NULL, 10);
+}
