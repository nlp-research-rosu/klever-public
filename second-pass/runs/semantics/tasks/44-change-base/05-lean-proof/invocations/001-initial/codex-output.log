The same container PID-namespace issue prevents Lean from locating its own executable through numeric `/proc`. I’m recreating the temporary `/proc/self` PID shim outside the project, then running the unchanged pinned toolchain with it.
apply patch
patch: completed
/tmp/lean-host-pid.c
diff --git a//tmp/lean-host-pid.c b//tmp/lean-host-pid.c
new file mode 100644
index 0000000000000000000000000000000000000000..988ee74b8bc098219ca6de66f74a9d725c4383b3
--- /dev/null
+++ b//tmp/lean-host-pid.c
@@ -0,0 +1,13 @@
+#include <sys/types.h>
+#include <unistd.h>
+#include <stdlib.h>
+
+pid_t getpid(void) {
+    char path[64];
+    ssize_t size = readlink("/proc/self", path, sizeof(path) - 1);
+    if (size <= 0) {
+        return (pid_t)-1;
+    }
+    path[size] = '\0';
+    return (pid_t)strtol(path, NULL, 10);
+}
