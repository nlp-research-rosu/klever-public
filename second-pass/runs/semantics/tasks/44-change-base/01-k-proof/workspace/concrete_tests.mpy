Module(
  FuncDef("change_base", Params("x", "base"),
    Expr(
      Str(
        "Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    "))
    If(Compare(Name("x"), CmpOp("==", Int(0))),
      Return(Str("")),
      )
    Return(
      BinOp(
        "+",
        Call(
          Name("change_base"),
          BinOp("//", Name("x"), Name("base")),
          Name("base")),
        Call(
          Name("chr"),
          BinOp("+", Int(48), BinOp("%", Name("x"), Name("base")))))))
  Assert(
    Compare(
      Call(Name("change_base"), Int(8), Int(3)),
      CmpOp("==", Str("22"))))
  Assert(
    Compare(
      Call(Name("change_base"), Int(8), Int(2)),
      CmpOp("==", Str("1000"))))
  Assert(
    Compare(
      Call(Name("change_base"), Int(7), Int(2)),
      CmpOp("==", Str("111"))))
  Assert(
    Compare(
      Call(Name("change_base"), Int(0), Int(2)),
      CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("change_base"), Int(31), Int(5)),
      CmpOp("==", Str("111"))))
  Assert(
    Compare(
      Call(Name("change_base"), Int(999), Int(9)),
      CmpOp("==", Str("1330")))))
