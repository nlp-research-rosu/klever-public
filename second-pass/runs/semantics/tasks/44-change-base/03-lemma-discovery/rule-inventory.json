{
  "inventory_sha256": "6d22f78dc4e994c53e63142f6d44ae227e2c41a30f113c97810968f0c36e2308",
  "rules": [
    {
      "attributes": [],
      "end_line": 8,
      "module": "VERIFICATION",
      "normalized_sha256": "62ed89db83ac9521d185c3efa101e7178564396966b30641c489bd6e0da25b21",
      "source_rule_id": "rule-62ed89db83ac9521d185c3efa101e7178564396966b30641c489bd6e0da25b21",
      "start_line": 8,
      "text": "  rule freshScopes(_:Int, .Map) => true"
    },
    {
      "attributes": [],
      "end_line": 10,
      "module": "VERIFICATION",
      "normalized_sha256": "437465420fc6223721ad7c1f90c24fba6434c7a8d0b69e9c65c7139faac9cb24",
      "source_rule_id": "rule-437465420fc6223721ad7c1f90c24fba6434c7a8d0b69e9c65c7139faac9cb24",
      "start_line": 9,
      "text": "  rule L:Int in_keys(S:Map) => false\n    requires freshScopes(L, S)"
    },
    {
      "attributes": [],
      "end_line": 12,
      "module": "VERIFICATION",
      "normalized_sha256": "5f7d67ec7de6f261bc639a5357fe24c0755d69896737437ce4a6460d8c904b01",
      "source_rule_id": "rule-5f7d67ec7de6f261bc639a5357fe24c0755d69896737437ce4a6460d8c904b01",
      "start_line": 11,
      "text": "  rule freshScopes(N:Int, (L:Int |-> _:Scope) S:Map) => true\n    requires N ==Int L +Int 1 andBool freshScopes(L, S)"
    },
    {
      "attributes": [],
      "end_line": 18,
      "module": "VERIFICATION",
      "normalized_sha256": "746c49465cb8335d005b3a331b93eb26bdf586974933b9d025250760d4d0c29d",
      "source_rule_id": "rule-746c49465cb8335d005b3a331b93eb26bdf586974933b9d025250760d4d0c29d",
      "start_line": 17,
      "text": "  rule S:Map [ L:Int <- V:Scope ] => (L |-> V) S\n    requires notBool L in_keys(S)"
    },
    {
      "attributes": [],
      "end_line": 20,
      "module": "VERIFICATION",
      "normalized_sha256": "82f2c726c84180f9e0c75a16a31dd3a15476f84ccb4dacad03db18bcaca52fda",
      "source_rule_id": "rule-82f2c726c84180f9e0c75a16a31dd3a15476f84ccb4dacad03db18bcaca52fda",
      "start_line": 19,
      "text": "  rule ((L:Int |-> V:Scope) S:Map) [ L <- undef ] => S\n    requires notBool L in_keys(S)"
    },
    {
      "attributes": [],
      "end_line": 43,
      "module": "VERIFICATION",
      "normalized_sha256": "9389ac349c7264d24779fe506309eca98bcd5f175d2c68b09ee24d4612d2cd90",
      "source_rule_id": "rule-9389ac349c7264d24779fe506309eca98bcd5f175d2c68b09ee24d4612d2cd90",
      "start_line": 24,
      "text": "  rule changeBaseBody =>\n    Expr(\n      Str(\n        \"Change numerical base of input number x to base.\\n    return string representation after the conversion.\\n    base numbers are less than 10.\\n    >>> change_base(8, 3)\\n    '22'\\n    >>> change_base(8, 2)\\n    '1000'\\n    >>> change_base(7, 2)\\n    '111'\\n    \"))\n    If(Compare(Name(\"x\"), CmpOp(\"==\", Int(0))),\n      Return(Str(\"\")),\n      .Stmts)\n    Return(\n      BinOp(\n        \"+\",\n        Call(\n          Name(\"change_base\"),\n          BinOp(\"//\", Name(\"x\"), Name(\"base\")),\n          Name(\"base\")),\n        Call(\n          Name(\"chr\"),\n          BinOp(\n            \"+\",\n            Int(48),\n            BinOp(\"%\", Name(\"x\"), Name(\"base\"))))))"
    },
    {
      "attributes": [],
      "end_line": 49,
      "module": "VERIFICATION",
      "normalized_sha256": "6a85e13e9e00989679ee454ab9a6312358f25a6af6f49da2f2cfaea3756357f4",
      "source_rule_id": "rule-6a85e13e9e00989679ee454ab9a6312358f25a6af6f49da2f2cfaea3756357f4",
      "start_line": 46,
      "text": "  rule solutionModule =>\n    Module(\n      FuncDef(\"change_base\", Params(\"x\", \"base\"),\n        changeBaseBody))"
    },
    {
      "attributes": [],
      "end_line": 53,
      "module": "VERIFICATION",
      "normalized_sha256": "e42c4c16b30b74db12ec47f2e2a59c4d1e568e5aff8fe56aef128de15f5b614b",
      "source_rule_id": "rule-e42c4c16b30b74db12ec47f2e2a59c4d1e568e5aff8fe56aef128de15f5b614b",
      "start_line": 52,
      "text": "  rule changeBaseClosure =>\n    closureVal((\"x\", \"base\", .ParamNames), changeBaseBody, 0)"
    },
    {
      "attributes": [
        "simplification"
      ],
      "end_line": 58,
      "module": "VERIFICATION",
      "normalized_sha256": "a24b2678e0b18c55695f70b54faddde8407de9768d019653098bb326e564557a",
      "source_rule_id": "rule-a24b2678e0b18c55695f70b54faddde8407de9768d019653098bb326e564557a",
      "start_line": 58,
      "text": "  rule baseDigits(0, _:Int) => .IntSeq [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
      "end_line": 64,
      "module": "VERIFICATION",
      "normalized_sha256": "91e33937d50f2f1a09154fc22d8b5577e75677533363d7a9391ff2152f58497f",
      "source_rule_id": "rule-91e33937d50f2f1a09154fc22d8b5577e75677533363d7a9391ff2152f58497f",
      "start_line": 59,
      "text": "  rule baseDigits(N:Int, B:Int)\n    => seqConcat(\n         baseDigits((N -Int pyMod(N, B)) /Int B, B),\n         iCons(48 +Int pyMod(N, B), .IntSeq))\n    requires N >Int 0 andBool B >=Int 2\n    [simplification]"
    }
  ],
