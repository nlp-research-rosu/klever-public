def Proof._Map_ : SortMap → SortMap → SortMap :=
fun left right => { coll := left.coll ++ right.coll }
def Proof.«_in_keys(_)_MAP_Bool_KItem_Map» : SortKItem → SortMap → SortBool :=
fun key map => map.coll.any fun entry => Proof.kItemEq entry.fst key
def Proof.«_[_<-undef]» : SortMap → SortKItem → SortMap :=
fun map key => { coll := List.filter (fun entry => !Proof.kItemEq entry.fst key) map.coll }
def Proof.«_|->_» : SortKItem → SortKItem → SortMap :=
fun key value => { coll := [(key, value)] }
def Proof.«Map:update» : SortMap → SortKItem → SortKItem → SortMap :=
fun map key value => { coll := (key, value) :: (Proof.«_[_<-undef]» map key).coll }
def Proof.«freshScopes(_,_)_VERIFICATION_Bool_Int_Map» : SortInt → SortMap → SortBool :=
fun next map => map.coll.all (Proof.priorScopeKey next)
def Proof.notBool_ : SortBool → SortBool :=
