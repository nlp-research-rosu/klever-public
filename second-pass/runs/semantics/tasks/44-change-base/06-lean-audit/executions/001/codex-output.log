    27	/- KORE symbol: Lbl'UndsLSqBUnds-LT-'-undef'RSqB'; frozen source obligations: rule-82f2c726c84180f9e0c75a16a31dd3a15476f84ccb4dacad03db18bcaca52fda. Replace this stub with its honest total meaning from the frozen K semantics. -/
    28	noncomputable def «_[_<-undef]»
    29	    (map : SortMap) (key : SortKItem) : SortMap :=
