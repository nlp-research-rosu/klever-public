      "end_line": 64,
      "independent_normalized_sha256": "91e33937d50f2f1a09154fc22d8b5577e75677533363d7a9391ff2152f58497f",
      "index": 9,
      "module": "VERIFICATION",
      "normalized_sha256": "91e33937d50f2f1a09154fc22d8b5577e75677533363d7a9391ff2152f58497f",
      "rationale": "This simplification recurrence defines positive baseDigits values by quotient recursion and appending the remainder digit.",
      "recomputed_source_rule_id": "rule-91e33937d50f2f1a09154fc22d8b5577e75677533363d7a9391ff2152f58497f",
      "source_rule_id": "rule-91e33937d50f2f1a09154fc22d8b5577e75677533363d7a9391ff2152f58497f",
      "start_line": 59,
      "text": "  rule baseDigits(N:Int, B:Int)\n    => seqConcat(\n         baseDigits((N -Int pyMod(N, B)) /Int B, B),\n         iCons(48 +Int pyMod(N, B), .IntSeq))\n    requires N >Int 0 andBool B >=Int 2\n    [simplification]"
