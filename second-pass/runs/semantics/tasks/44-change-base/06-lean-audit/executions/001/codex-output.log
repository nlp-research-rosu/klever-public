diff --git a//tmp/audit-work/proof-audit.QWcnih/Adversarial.lean b//tmp/audit-work/proof-audit.QWcnih/Adversarial.lean
new file mode 100644
index 0000000000000000000000000000000000000000..7e82e5255adc37bbc44e94ff3e65f03b3540e63d
--- /dev/null
+++ b//tmp/audit-work/proof-audit.QWcnih/Adversarial.lean
@@ -0,0 +1,64 @@
+import Proof
+
+namespace Adversarial
+
+def emptyMap : SortMap := ⟨[]⟩
+
+def constantMap₂ (_ _ : SortMap) : SortMap := emptyMap
+def constantMembership (_ : SortKItem) (_ : SortMap) : SortBool := true
+def constantDelete (_ : SortMap) (_ : SortKItem) : SortMap := emptyMap
+def constantSingleton (_ _ : SortKItem) : SortMap := emptyMap
+def constantUpdate (_ : SortMap) (_ _ : SortKItem) : SortMap := emptyMap
+def constantFresh (_ : SortInt) (_ : SortMap) : SortBool := false
+def constantNot (_ : SortBool) : SortBool := false
+
+theorem sortScopeIsEmpty (value : SortScope) : False := by
+  exact nomatch value
+
+/- Every operational parameter can be constant and the fixed target still
+   closes: conjunct 1 has a false antecedent, and conjuncts 2 and 3 quantify
+   over the generated empty SortScope. -/
+theorem constantDefinitionsStillProveTarget :
+    Klean44ChangeBase.Lemmas.targetStatement
+      constantMap₂
+      constantMembership
+      constantDelete
+      constantSingleton
+      constantUpdate
+      constantFresh
+      constantNot := by
+  constructor
+  · intro S L h
+    simp [constantFresh] at h
+  constructor
+  · intro V
+    exact nomatch V
+  · intro L S V
+    exact nomatch V
+
+/- The candidate totalizes freshScopes beyond the frozen K recurrence:
+   freshScopes(2, 0 |-> 99) is true here even though the K rule requires the
+   value to have sort Scope and the exact predecessor recurrence to hold. -/
+theorem candidateFreshAcceptsNonScopeValue :
+    Proof.«freshScopes(_,_)_VERIFICATION_Bool_Int_Map»
+      2
+      ⟨[(
+        SortKItem.inj_SortInt 0,
+        SortKItem.inj_SortInt 99
+      )]⟩ = true := by
+  rfl
+
+/- The candidate gives total ordered-list behavior to K's partial, AC
+   disjoint-map concatenation, including an overlapping-key representation. -/
+theorem candidateConcatAcceptsOverlap :
+    (Proof._Map_
+      ⟨[(SortKItem.inj_SortInt 0, SortKItem.inj_SortInt 10)]⟩
+      ⟨[(SortKItem.inj_SortInt 0, SortKItem.inj_SortInt 20)]⟩).coll
+    =
+      [
+        (SortKItem.inj_SortInt 0, SortKItem.inj_SortInt 10),
+        (SortKItem.inj_SortInt 0, SortKItem.inj_SortInt 20)
+      ] := by
+  rfl
+
+end Adversarial
