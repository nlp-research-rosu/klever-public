fun key map => map.coll.any fun entry => Proof.kItemEq entry.fst key
def Proof.«_[_<-undef]» : SortMap → SortKItem → SortMap :=
fun map key => { coll := List.filter (fun entry => !Proof.kItemEq entry.fst key) map.coll }
