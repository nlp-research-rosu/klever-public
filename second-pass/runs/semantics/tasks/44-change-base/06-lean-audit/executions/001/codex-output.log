      "normalized_sha256": "746c49465cb8335d005b3a331b93eb26bdf586974933b9d025250760d4d0c29d",
      "rationale": "This is an additional, unproved finite-map identity that turns a fresh-key Map update into a disjoint binding so symbolic scope allocation can normalize.",
      "recomputed_source_rule_id": "rule-746c49465cb8335d005b3a331b93eb26bdf586974933b9d025250760d4d0c29d",
      "source_rule_id": "rule-746c49465cb8335d005b3a331b93eb26bdf586974933b9d025250760d4d0c29d",
      "start_line": 17,
      "text": "  rule S:Map [ L:Int <- V:Scope ] => (L |-> V) S\n    requires notBool L in_keys(S)"
    },
    {
      "attributes": [],
      "classification": "DOMAIN_LEMMA",
      "end_line": 20,
      "independent_normalized_sha256": "82f2c726c84180f9e0c75a16a31dd3a15476f84ccb4dacad03db18bcaca52fda",
      "index": 4,
      "module": "VERIFICATION",
      "normalized_sha256": "82f2c726c84180f9e0c75a16a31dd3a15476f84ccb4dacad03db18bcaca52fda",
      "rationale": "This is an additional, unproved finite-map deletion identity used to restore a scope store after removing a uniquely bound fresh key.",
      "recomputed_source_rule_id": "rule-82f2c726c84180f9e0c75a16a31dd3a15476f84ccb4dacad03db18bcaca52fda",
      "source_rule_id": "rule-82f2c726c84180f9e0c75a16a31dd3a15476f84ccb4dacad03db18bcaca52fda",
      "start_line": 19,
      "text": "  rule ((L:Int |-> V:Scope) S:Map) [ L <- undef ] => S\n    requires notBool L in_keys(S)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 43,
      "independent_normalized_sha256": "9389ac349c7264d24779fe506309eca98bcd5f175d2c68b09ee24d4612d2cd90",
      "index": 5,
      "module": "VERIFICATION",
      "normalized_sha256": "9389ac349c7264d24779fe506309eca98bcd5f175d2c68b09ee24d4612d2cd90",
      "rationale": "This macro equation defines the named changeBaseBody proof term as the exact translated function-body constructor tree.",
      "recomputed_source_rule_id": "rule-9389ac349c7264d24779fe506309eca98bcd5f175d2c68b09ee24d4612d2cd90",
      "source_rule_id": "rule-9389ac349c7264d24779fe506309eca98bcd5f175d2c68b09ee24d4612d2cd90",
      "start_line": 24,
      "text": "  rule changeBaseBody =>\n    Expr(\n      Str(\n        \"Change numerical base of input number x to base.\\n    return string representation after the conversion.\\n    base numbers are less than 10.\\n    >>> change_base(8, 3)\\n    '22'\\n    >>> change_base(8, 2)\\n    '1000'\\n    >>> change_base(7, 2)\\n    '111'\\n    \"))\n    If(Compare(Name(\"x\"), CmpOp(\"==\", Int(0))),\n      Return(Str(\"\")),\n      .Stmts)\n    Return(\n      BinOp(\n        \"+\",\n        Call(\n          Name(\"change_base\"),\n          BinOp(\"//\", Name(\"x\"), Name(\"base\")),\n          Name(\"base\")),\n        Call(\n          Name(\"chr\"),\n          BinOp(\n            \"+\",\n            Int(48),\n            BinOp(\"%\", Name(\"x\"), Name(\"base\"))))))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 49,
      "independent_normalized_sha256": "6a85e13e9e00989679ee454ab9a6312358f25a6af6f49da2f2cfaea3756357f4",
      "index": 6,
      "module": "VERIFICATION",
      "normalized_sha256": "6a85e13e9e00989679ee454ab9a6312358f25a6af6f49da2f2cfaea3756357f4",
      "rationale": "This macro equation defines solutionModule by wrapping the named function body in the translated module and function constructors.",
      "recomputed_source_rule_id": "rule-6a85e13e9e00989679ee454ab9a6312358f25a6af6f49da2f2cfaea3756357f4",
      "source_rule_id": "rule-6a85e13e9e00989679ee454ab9a6312358f25a6af6f49da2f2cfaea3756357f4",
      "start_line": 46,
      "text": "  rule solutionModule =>\n    Module(\n      FuncDef(\"change_base\", Params(\"x\", \"base\"),\n        changeBaseBody))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 53,
      "independent_normalized_sha256": "e42c4c16b30b74db12ec47f2e2a59c4d1e568e5aff8fe56aef128de15f5b614b",
      "index": 7,
      "module": "VERIFICATION",
      "normalized_sha256": "e42c4c16b30b74db12ec47f2e2a59c4d1e568e5aff8fe56aef128de15f5b614b",
      "rationale": "This equation defines the named changeBaseClosure proof value from its parameters, body, and module definition location.",
      "recomputed_source_rule_id": "rule-e42c4c16b30b74db12ec47f2e2a59c4d1e568e5aff8fe56aef128de15f5b614b",
      "source_rule_id": "rule-e42c4c16b30b74db12ec47f2e2a59c4d1e568e5aff8fe56aef128de15f5b614b",
      "start_line": 52,
      "text": "  rule changeBaseClosure =>\n    closureVal((\"x\", \"base\", .ParamNames), changeBaseBody, 0)"
    },
    {
      "attributes": [
        "simplification"
      ],
      "classification": "DEFINITION",
      "end_line": 58,
      "independent_normalized_sha256": "a24b2678e0b18c55695f70b54faddde8407de9768d019653098bb326e564557a",
      "index": 8,
      "module": "VERIFICATION",
      "normalized_sha256": "a24b2678e0b18c55695f70b54faddde8407de9768d019653098bb326e564557a",
      "rationale": "This simplification equation is the zero case of the mathematical baseDigits definition.",
      "recomputed_source_rule_id": "rule-a24b2678e0b18c55695f70b54faddde8407de9768d019653098bb326e564557a",
      "source_rule_id": "rule-a24b2678e0b18c55695f70b54faddde8407de9768d019653098bb326e564557a",
      "start_line": 58,
      "text": "  rule baseDigits(0, _:Int) => .IntSeq [simplification]"
    },
    {
      "attributes": [
        "simplification"
      ],
