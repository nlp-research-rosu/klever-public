===== /candidate/concrete_tests.py =====
     1	def change_base(x: int, base: int):
     2	    """Change numerical base of input number x to base.
     3	    return string representation after the conversion.
     4	    base numbers are less than 10.
     5	    >>> change_base(8, 3)
     6	    '22'
     7	    >>> change_base(8, 2)
     8	    '1000'
     9	    >>> change_base(7, 2)
    10	    '111'
    11	    """
    12	    if x == 0:
    13	        return ""
    14	    return change_base(x // base, base) + chr(48 + x % base)
    15	
    16	
    17	assert change_base(8, 3) == "22"
    18	assert change_base(8, 2) == "1000"
    19	assert change_base(7, 2) == "111"
    20	assert change_base(0, 2) == ""
    21	assert change_base(31, 5) == "111"
    22	assert change_base(999, 9) == "1330"
