     9	  rule L:Int in_keys(S:Map) => false
    10	    requires freshScopes(L, S)
    11	  rule freshScopes(N:Int, (L:Int |-> _:Scope) S:Map) => true
    12	    requires N ==Int L +Int 1 andBool freshScopes(L, S)
    13	
    14	  // Symbolic scope allocation uses a Map update in MPY-CALL.  Expose a fresh
    15	  // update as a disjoint binding so the existing parameter-binding rules can
    16	  // see the new frame.
    17	  rule S:Map [ L:Int <- V:Scope ] => (L |-> V) S
    18	    requires notBool L in_keys(S)
    19	  rule ((L:Int |-> V:Scope) S:Map) [ L <- undef ] => S
