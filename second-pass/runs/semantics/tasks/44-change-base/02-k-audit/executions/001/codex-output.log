+      => str(baseDigits(X, B))
+      ~> K
+    </k>
+    <env> L </env>
+    <scopes>
+      (0 |-> scope(
+        ("change_base" |-> changeBaseClosure),
+        parent(-1)))
+      (-1 |-> builtinsScope)
+      FRAMES
+    </scopes>
+    <scopeLoc> N </scopeLoc>
+    <heap> H </heap>
+    <heapLoc> HL </heapLoc>
+    <stack> ST </stack>
+    <ret> noRet </ret>
