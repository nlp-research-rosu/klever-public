index 0000000000000000000000000000000000000000..9dc1332b154a9d81d18ef1c3529c6fd12da0528b
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: $0 LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+logfile=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} > "$logfile"
+
+set +e
+"$@" > >(tee -a "$logfile") 2>&1
+status=$?
+set -e
+
+{
+  printf 'EXIT_STATUS: %d\n' "$status"
+  printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} | tee -a "$logfile"
+
+exit "$status"

