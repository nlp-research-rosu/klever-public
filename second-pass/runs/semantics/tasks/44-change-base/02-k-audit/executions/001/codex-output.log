diff --git a//tmp/audit-work/reconstruction/spec-vacuity.k b//tmp/audit-work/reconstruction/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..30826a7e97350664ea7ac4240d09f61c0965814f
