+#!/usr/bin/env bash
+set -u
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: $0 LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+logfile=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} > "$logfile"
+
+set +e
+"$@" > >(tee -a "$logfile") 2>&1
+status=$?
+set -e
+
+{
+  printf 'EXIT_STATUS: %d\n' "$status"
+  printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} | tee -a "$logfile"
+
+exit "$status"

codex
I corrected the isolation method: the load claim depends on the direct-call claim as its recursive circularity, so omitting that helper makes the diagnostic diverge. I preserved that interrupted diagnostic separately and restarted with both claims retained but only the labeled load target selected, which tests the target without deleting its proof dependency.
