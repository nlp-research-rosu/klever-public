@@ -0,0 +1,61 @@
+requires "verification.k"
+
+module SPEC-LOAD-WITH-PROVEN-HELPER
+  imports VERIFICATION
+
+  // This is byte-for-byte the already proved direct-call claim, admitted here
+  // only to make its use as an auxiliary circularity explicit for the separate
+  // load-entry run.
+  claim [trusted, label(helper_call)]:
+    <k>
+      #applyK(
+        toCall(changeBaseClosure),
+        (X, B, .Vals))
+      ~> K
+      => str(baseDigits(X, B))
+      ~> K
+    </k>
+    <env> L </env>
+    <scopes>
+      (0 |-> scope(
+        ("change_base" |-> changeBaseClosure),
+        parent(-1)))
+      (-1 |-> builtinsScope)
+      FRAMES
+    </scopes>
+    <scopeLoc> N </scopeLoc>
