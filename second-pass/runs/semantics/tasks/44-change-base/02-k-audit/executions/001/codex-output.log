@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: $0 LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+logfile=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} > "$logfile"
+
+set +e
+"$@" > >(tee -a "$logfile") 2>&1
+status=$?
+set -e
+
+{
+  printf 'EXIT_STATUS: %d\n' "$status"
+  printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} | tee -a "$logfile"
+
+exit "$status"

codex
K’s supported modular mechanism is a CLI-level `--trusted` dependency, not a source `trusted` attribute. I found that in the installed K regression suite and am now proving only the load target while admitting the separately closed direct-call claim by its exact label. This preserves a clean dependency chain without treating an unproved shortcut as trusted.
