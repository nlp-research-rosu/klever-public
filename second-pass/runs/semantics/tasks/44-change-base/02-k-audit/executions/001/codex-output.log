@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module SPEC-ENTRY-CALL
+  imports VERIFICATION
+
+  claim
+    <k>
+      #applyK(
+        toCall(changeBaseClosure),
+        (X, B, .Vals))
+      ~> K
+      => str(baseDigits(X, B))
+      ~> K
+    </k>
+    <env> L </env>
+    <scopes>
+      (0 |-> scope(
+        ("change_base" |-> changeBaseClosure),
+        parent(-1)))
+      (-1 |-> builtinsScope)
+      FRAMES
+    </scopes>
+    <scopeLoc> N </scopeLoc>
+    <heap> H </heap>
+    <heapLoc> HL </heapLoc>
+    <stack> ST </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> EC </exit-code>
+    requires X >=Int 0 andBool B >=Int 2 andBool B <Int 10
+     andBool N >Int 0
+     andBool freshScopes(N, FRAMES)
+endmodule
diff --git a//tmp/audit-work/reconstruction/spec-entry-load.k b//tmp/audit-work/reconstruction/spec-entry-load.k
new file mode 100644
index 0000000000000000000000000000000000000000..41ef2cef054c4a7b84e5194abdad21c0fea19c1f
--- /dev/null
+++ b//tmp/audit-work/reconstruction/spec-entry-load.k
@@ -0,0 +1,30 @@
+requires "verification.k"
+
+module SPEC-ENTRY-LOAD
+  imports VERIFICATION
+
+  claim
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("change_base"), Int(X), Int(B))
+      => str(baseDigits(X, B))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0 |-> scope(
+        "change_base" |-> changeBaseClosure,
+        parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
