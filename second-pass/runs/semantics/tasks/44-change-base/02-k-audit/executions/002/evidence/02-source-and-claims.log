     7	def change_base(x: int, base: int):
     8	    """Change numerical base of input number x to base.
     9	    return string representation after the conversion.
    10	    base numbers are less than 10.
    11	    >>> change_base(8, 3)
    12	    '22'
    13	    >>> change_base(8, 2)
    14	    '1000'
    15	    >>> change_base(7, 2)
    16	    '111'
