COMMAND: bash -c $'python3 - <<"PY"\nfrom pathlib import Path\np=Path("/audit-output/REVIEW.md")\ntext=p.read_text()\nassert text.splitlines()[-2:]==["VERDICT: CONCERNS","LEGITIMACY: LEGIT"]\nfor stage in range(1,8):\n    assert f"## {stage}." in text\nmissing=[]\nimport re\nfor target in re.findall(r"\\]\\((evidence/[^)]+)\\)",text):\n    if not (Path("/audit-output")/target).is_file(): missing.append(target)\nassert not missing, missing\nprint("REVIEW_END_MARKERS=PASS")\nprint("SEVEN_STAGES=PASS")\nprint("EVIDENCE_LINKS=PASS")\nprint(f"REVIEW_LINES={len(text.splitlines())}")\nPY\nsha256sum /audit-output/REVIEW.md\nfor f in 01-provenance-check.log 02-translation-identity.log 02-differential.log 03-kompile-haskell.log 03-kprove-all.log 03-kprove-apply-only.log 03-kprove-module-trusted-helper.log 04-kprove-body-mutant.log 06-vacuity-dry-run.log 06-kprove-vacuity.log; do tail -1 "/audit-output/evidence/$f" | sed "s|^|$f: |"; done'
