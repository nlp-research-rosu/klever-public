@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: $0 LOG_PATH COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf '%s\n' '--- OUTPUT ---'
+} >"$log_path"
+
+set +e
+"$@" 2>&1 | tee -a "$log_path"
+command_status=${PIPESTATUS[0]}
+set -e
+
+{
+  printf '%s\n' '--- END OUTPUT ---'
+  printf 'EXIT STATUS: %d\n' "$command_status"
+} >>"$log_path"
+
+exit "$command_status"
