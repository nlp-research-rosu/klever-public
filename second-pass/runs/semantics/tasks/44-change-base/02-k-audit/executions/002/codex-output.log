  if k=='file': d.update(p.stat().st_size.to_bytes(8,'big'));d.update(p.read_bytes())
 return d.hexdigest(),len(es)
for name,f in [
('all',lambda r:False),('no_pycache',lambda r:r=='__pycache__' or r.startswith('__pycache__/')),
