diff --git a/evidence/spec-module-only.k b/evidence/spec-module-only.k
new file mode 100644
index 0000000000000000000000000000000000000000..7e9366d7ffaeee68769fd040bc980ce531c3da07
--- /dev/null
+++ b/evidence/spec-module-only.k
@@ -0,0 +1,30 @@
+requires "verification.k"
