     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Allocator invariant for the symbolic suffix of the scope store.
     7	  syntax Bool ::= freshScopes(Int, Map) [function]
     8	  rule freshScopes(_:Int, .Map) => true
     9	  rule L:Int in_keys(S:Map) => false
    10	    requires freshScopes(L, S)
    11	  rule freshScopes(N:Int, (L:Int |-> _:Scope) S:Map) => true
    12	    requires N ==Int L +Int 1 andBool freshScopes(L, S)
    13	
    14	  // Symbolic scope allocation uses a Map update in MPY-CALL.  Expose a fresh
    15	  // update as a disjoint binding so the existing parameter-binding rules can
    16	  // see the new frame.
    17	  rule S:Map [ L:Int <- V:Scope ] => (L |-> V) S
    18	    requires notBool L in_keys(S)
    19	  rule ((L:Int |-> V:Scope) S:Map) [ L <- undef ] => S
    20	    requires notBool L in_keys(S)
    21	
    22	  // This is the exact constructor tree emitted in solution.mpy.
    23	  syntax Stmts ::= "changeBaseBody" [function]
    24	  rule changeBaseBody =>
    25	    Expr(
    26	      Str(
    27	        "Change numerical base of input number x to base.\n    return string representation after the conversion.\n    base numbers are less than 10.\n    >>> change_base(8, 3)\n    '22'\n    >>> change_base(8, 2)\n    '1000'\n    >>> change_base(7, 2)\n    '111'\n    "))
    28	    If(Compare(Name("x"), CmpOp("==", Int(0))),
    29	      Return(Str("")),
    30	      .Stmts)
    31	    Return(
    32	      BinOp(
    33	        "+",
    34	        Call(
    35	          Name("change_base"),
    36	          BinOp("//", Name("x"), Name("base")),
    37	          Name("base")),
    38	        Call(
    39	          Name("chr"),
    40	          BinOp(
    41	            "+",
    42	            Int(48),
    43	            BinOp("%", Name("x"), Name("base"))))))
    44	
    45	  syntax Module ::= "solutionModule" [function]
    46	  rule solutionModule =>
    47	    Module(
    48	      FuncDef("change_base", Params("x", "base"),
    49	        changeBaseBody))
    50	
    51	  syntax Val ::= "changeBaseClosure" [function]
    52	  rule changeBaseClosure =>
    53	    closureVal(("x", "base", .ParamNames), changeBaseBody, 0)
    54	
    55	  // Big-endian base-B digits for a nonnegative integer.  The empty sequence
    56	  // at zero matches the contract-compatible behavior of the supplied task.
    57	  syntax IntSeq ::= baseDigits(Int, Int) [function]
    58	  rule baseDigits(0, _:Int) => .IntSeq [simplification]
    59	  rule baseDigits(N:Int, B:Int)
    60	    => seqConcat(
    61	         baseDigits((N -Int pyMod(N, B)) /Int B, B),
    62	         iCons(48 +Int pyMod(N, B), .IntSeq))
    63	    requires N >Int 0 andBool B >=Int 2
    64	    [simplification]
    65	endmodule
