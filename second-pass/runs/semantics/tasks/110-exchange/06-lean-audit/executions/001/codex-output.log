     1	requires "reference-semantics/semantics.k"
     2	
     3	module EXCHANGE-VERIFICATION
     4	  imports MPY
     5	
     6	  // A typed symbolic view of Python integer-list contents.  Its iterator
     7	  // equations are exactly the two MPY-LIST equations for .ValSeq/vCons.
     8	  // Concrete execution still uses ordinary list literals and MPY-LIST.
     9	  syntax ValSeq ::= intVals(IntSeq)
    10	  rule <k> #iterNext(list(intVals(.IntSeq))) => #iterDone ... </k>
    11	  rule <k> #iterNext(list(intVals(iCons(I:Int, R:IntSeq))))
    12	        => #iterYield(I, list(intVals(R))) ... </k>
    13	
    14	  // Accumulator-form counts mirror the program's AugAssign exactly.  Besides
    15	  // avoiding any reliance on algebraic normalization, oddAcc(0, VS) and
    16	  // evenAcc(0, VS) are the ordinary odd/even element counts.
    17	  syntax Int ::= oddAcc(Int, IntSeq) [function, total]
    18	  rule oddAcc(A:Int, .IntSeq) => A
    19	  rule oddAcc(A:Int, iCons(I:Int, R:IntSeq)) => oddAcc(A, R)
    20	    requires pyMod(I, 2) ==Int 0
    21	  rule oddAcc(A:Int, iCons(I:Int, R:IntSeq)) => oddAcc(A +Int 1, R)
    22	    requires pyMod(I, 2) =/=Int 0
    23	
    24	  syntax Int ::= evenAcc(Int, IntSeq) [function, total]
    25	  rule evenAcc(A:Int, .IntSeq) => A
    26	  rule evenAcc(A:Int, iCons(I:Int, R:IntSeq)) => evenAcc(A +Int 1, R)
    27	    requires pyMod(I, 2) ==Int 0
    28	  rule evenAcc(A:Int, iCons(I:Int, R:IntSeq)) => evenAcc(A, R)
    29	    requires pyMod(I, 2) =/=Int 0
    30	
    31	  syntax Val ::= exchangeResult(IntSeq, IntSeq) [function, total]
    32	  rule exchangeResult(A:IntSeq, B:IntSeq)
    33	    => str(iCons(89, iCons(69, iCons(83, .IntSeq))))
    34	    requires oddAcc(0, A) <=Int evenAcc(0, B)
    35	  rule exchangeResult(A:IntSeq, B:IntSeq)
    36	    => str(iCons(78, iCons(79, .IntSeq)))
    37	    requires oddAcc(0, A) >Int evenAcc(0, B)
    38	
    39	  // These macros are the exact constructor form generated in solution.mpy.
    40	  // Factoring the loop bodies makes the induction claims readable.
    41	  syntax Stmts ::= "ODD-BODY" [macro]
    42	  rule ODD-BODY
    43	    => If(
    44	         Compare(BinOp("%", Name("number"), Int(2)),
    45	                 CmpOp("!=", Int(0))),
    46	         AugAssign(Name("odd"), "+", Int(1)),
    47	         .Stmts)
    48	
    49	  syntax Stmts ::= "EVEN-BODY" [macro]
    50	  rule EVEN-BODY
    51	    => If(
    52	         Compare(BinOp("%", Name("number"), Int(2)),
    53	                 CmpOp("==", Int(0))),
    54	         AugAssign(Name("even"), "+", Int(1)),
    55	         .Stmts)
    56	
    57	  syntax Stmt ::= "exchangeDef" [macro]
    58	  rule exchangeDef
    59	    => FuncDef(
    60	         "exchange",
    61	         Params("lst1", "lst2"),
    62	         Assign(Name("odd"), Int(0))
    63	         Assign(Name("even"), Int(0))
    64	         Assign(Name("number"), Int(0))
    65	         For(Name("number"), Name("lst1"), ODD-BODY)
    66	         For(Name("number"), Name("lst2"), EVEN-BODY)
    67	         If(Compare(Name("odd"), CmpOp("<=", Name("even"))),
    68	            Return(Str("YES")),
    69	            .Stmts)
    70	         Return(Str("NO")))
    71	endmodule

