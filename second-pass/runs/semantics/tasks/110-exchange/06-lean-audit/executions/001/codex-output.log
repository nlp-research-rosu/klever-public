diff --git a//tmp/audit-work/readlink_probe.c b//tmp/audit-work/readlink_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..f0a8e677a6ad7598140a1cdbe7b0564e76b48a08
--- /dev/null
+++ b//tmp/audit-work/readlink_probe.c
@@ -0,0 +1,33 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    errno = 0;
+    ssize_t result = syscall(SYS_readlink, path, buffer, size);
+    int saved_errno = errno;
+    if (result >= 0) {
+        dprintf(
+            STDERR_FILENO,
+            "AUDIT_READLINK path=%s result=%zd target=%.*s\n",
+            path,
+            result,
+            (int)result,
+            buffer
+        );
+    } else {
+        dprintf(
+            STDERR_FILENO,
+            "AUDIT_READLINK path=%s result=%zd errno=%d message=%s\n",
+            path,
+            result,
+            saved_errno,
+            strerror(saved_errno)
+        );
+    }
+    errno = saved_errno;
+    return result;
+}
diff --git a//tmp/audit-work/readlink_proc_repair.c b//tmp/audit-work/readlink_proc_repair.c
new file mode 100644
index 0000000000000000000000000000000000000000..9cc74bb06cb768f26b1f88ebc2a228ca3904e0b0
--- /dev/null
+++ b//tmp/audit-work/readlink_proc_repair.c
@@ -0,0 +1,36 @@
+#define _GNU_SOURCE
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+extern char *program_invocation_name;
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    errno = 0;
+    ssize_t result = syscall(SYS_readlink, path, buffer, size);
+    int saved_errno = errno;
+    if (
+        result < 0 &&
+        saved_errno == ENOENT &&
+        strncmp(path, "/proc/", 6) == 0 &&
+        strstr(path + 6, "/exe") != NULL &&
+        program_invocation_name != NULL
+    ) {
+        size_t length = strlen(program_invocation_name);
+        result = (ssize_t)(length < size ? length : size);
+        memcpy(buffer, program_invocation_name, (size_t)result);
+        dprintf(
+            STDERR_FILENO,
+            "AUDIT_PROC_REPAIR path=%s target=%.*s\n",
+            path,
+            (int)result,
+            buffer
+        );
+        errno = 0;
+        return result;
+    }
+    errno = saved_errno;
+    return result;
+}
