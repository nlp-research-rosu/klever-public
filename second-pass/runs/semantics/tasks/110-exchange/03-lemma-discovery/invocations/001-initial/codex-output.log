/bin/bash -lc "python3 - <<'PY'
import hashlib, json
from collections import Counter
inv_path = '/reference/rule-inventory.json'
out_path = '/workspace/trust-boundary.json'
inv = json.load(open(inv_path, encoding='utf-8'))
out = json.load(open(out_path, encoding='utf-8'))
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert list(out.keys()) == ['schema_version', 'inventory_sha256', 'rules'], list(out.keys())
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
inv_ids = [r['source_rule_id'] for r in inv['rules']]
out_ids = [r['source_rule_id'] for r in out['rules']]
assert out_ids == inv_ids
assert len(out_ids) == len(set(out_ids)) == len(inv_ids) == 13
for i, r in enumerate(out['rules']):
    assert list(r.keys()) == ['source_rule_id', 'classification', 'rationale'], (i, list(r.keys()))
    assert r['classification'] in allowed
    assert isinstance(r['rationale'], str) and r['rationale'].strip()
attrs = {r['source_rule_id']: r.get('attributes', []) for r in inv['rules']}
for r in out['rules']:
    if 'simplification' in attrs[r['source_rule_id']]:
        assert r['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
counts = Counter(r['classification'] for r in out['rules'])
print('inventory_sha256:', out['inventory_sha256'])
print('rules:', len(out_ids))
print('classifications:', dict(sorted(counts.items())))
print('simplification rules:', sum('simplification' in a for a in attrs.values()))
print('JSON validation: PASS')
print('trust-boundary.json sha256:', hashlib.sha256(open(out_path,'rb').read()).hexdigest())
PY
