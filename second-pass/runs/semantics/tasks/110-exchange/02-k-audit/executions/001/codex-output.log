+#!/usr/bin/env bash
+set -u
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: $0 LOG-NAME COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log_name=$1
+shift
+audit_log_path="/audit-output/evidence/${audit_log_name}"
+
+{
+  printf 'UTC_START: '
+  date -u '+%Y-%m-%dT%H:%M:%SZ'
+  printf 'CWD: %s\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} >"$audit_log_path"
+
+set +e
+"$@" 2>&1 | tee -a "$audit_log_path"
+audit_pipeline=("${PIPESTATUS[@]}")
+audit_status=${audit_pipeline[0]}
+set -e
+
+{
+  printf 'EXIT_STATUS: %s\n' "$audit_status"
+  printf 'UTC_END: '
+  date -u '+%Y-%m-%dT%H:%M:%SZ'
+} >>"$audit_log_path"
+
+exit "$audit_status"

codex
The entry theorem is result-constraining and reachable: fresh ground K proofs execute the exact body to `YES` for `([1],[2])` and `NO` for `([1,3],[2])`, matching both Python implementations. Static review found no answer-injection, oracle, simplification, priority, or execution-bypass rule in `verification.k`; its only operational extension is a two-equation symbolic integer-list iterator. I’m testing that extension’s continuation behavior and its precise abstraction boundary before moving to the false mutation.
