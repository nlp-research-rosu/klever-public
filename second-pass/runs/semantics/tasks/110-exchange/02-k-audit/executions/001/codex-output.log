/audit-output/evidence/run_logged.sh 31-vacuity-witness-python.txt python3 -c 'import importlib.util; load=lambda n,p:(lambda s:(lambda m:(s.loader.exec_module(m),m)[1])(importlib.util.module_from_spec(s)))(importlib.util.spec_from_file_location(n,p)); c=load(\"c\",\"/reference/canonical.py\").exchange; s=load(\"s\",\"/tmp/audit-work/exchange-110-fresh/solution.py\").exchange; print(\"witness=([2],[1]) canonical=\",c([2],[1]),\"generated=\",s([2],[1]),\"mutated=NO\")'
/audit-output/evidence/run_logged.sh 32-vacuity-dry-run.txt kprove spec-vacuity.k --definition verification-fresh-kompiled --spec-module EXCHANGE-SPEC-VACUITY --dry-run --output pretty" in /tmp/audit-work/exchange-110-fresh
