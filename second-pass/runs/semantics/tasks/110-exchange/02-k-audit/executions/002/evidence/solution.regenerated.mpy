Module(
  FuncDef("exchange", Params("lst1", "lst2"),
    Assign(Name("odd"), Int(0))
    Assign(Name("even"), Int(0))
    Assign(Name("number"), Int(0))
    For(Name("number"), Name("lst1"),
      If(Compare(BinOp("%", Name("number"), Int(2)), CmpOp("!=", Int(0))),
        AugAssign(Name("odd"), "+", Int(1)),
        ))
    For(Name("number"), Name("lst2"),
      If(Compare(BinOp("%", Name("number"), Int(2)), CmpOp("==", Int(0))),
        AugAssign(Name("even"), "+", Int(1)),
        ))
    If(Compare(Name("odd"), CmpOp("<=", Name("even"))),
      Return(Str("YES")),
      )
    Return(Str("NO"))))
