// reference/src/semantics/concrete.k — MPY-CONCRETE
// Concrete-execution-only rules, visible ONLY to the llvm build (run.sh kompiles
// MPY-CONCRETE; verification builds import MPY and never see these). Rationale:
// a k-cell rule matching value constructors NARROWS abstract Vals in the haskell
// backend ([concrete] is not respected on rewrite rules) — probed on
// 26-remove-duplicates, where element compares branched into deepEqVS.

module MPY-CONCRETE
  imports MPY

  // deep equality for list compares whose elements are heap objects
  // (list-of-lists): Python == is structural at every depth.
  rule <k> Compare(list(A:ValSeq), CmpOp("==", list(B:ValSeq))) => deepEqVS(A, B, HP) ... </k>
       <heap> HP:Map </heap>
       requires hasRefVS(A) orBool hasRefVS(B)
  rule <k> Compare(list(A:ValSeq), CmpOp("!=", list(B:ValSeq))) => notBool deepEqVS(A, B, HP) ... </k>
       <heap> HP:Map </heap>
       requires hasRefVS(A) orBool hasRefVS(B)

  // ==== keyed sort, concrete leg ============================================
  // Computes each key by a REAL call through the uniform #callee machinery
  // (closures, len, type objects all work), stable-inserts on the key, and
  // allocates the result. priority(40) beats sort.k's opaque rules, so krun
  // runs this and proofs (which never see MPY-CONCRETE) keep sortKeyVS.
  syntax Val ::= kvP(Val, Val)
  syntax KItem ::= #ksort(ValSeq, Val, ValSeq, Bool)
                 | #ksIns(Val, ValSeq, Val, ValSeq, Bool)
  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
        => #ksort(VS, KV, .ValSeq, false) ... </k>
       [priority(40)]
  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
        => #ksort(VS, KV, .ValSeq, RB) ... </k>
       [priority(40)]
  rule <k> #ksort(.ValSeq, _:Val, ACC:ValSeq, RB:Bool)
        => #alloc(list(condRev(unpairVS(ACC), RB))) ... </k>
  rule <k> #ksort(vCons(V:Val, R:ValSeq), KV:Val, ACC:ValSeq, RB:Bool)
        => KV ~> #callee((V, .Exprs)) ~> #ksIns(V, R, KV, ACC, RB) ... </k>
  rule <k> K:Val ~> #ksIns(V:Val, R:ValSeq, KV:Val, ACC:ValSeq, RB:Bool)
        => #ksort(R, KV, insPair(ACC, K, V), RB) ... </k>
       requires notBool isKwV(K)

  syntax ValSeq ::= insPair(ValSeq, Val, Val) [function]
  rule insPair(.ValSeq, K:Val, V:Val) => vCons(kvP(K, V), .ValSeq)
  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    => vCons(kvP(K, V), vCons(kvP(K2, V2), R))
       requires kLt(K, K2)
  rule insPair(vCons(kvP(K2:Val, V2:Val), R:ValSeq), K:Val, V:Val)
    => vCons(kvP(K2, V2), insPair(R, K, V))
       requires notBool kLt(K, K2)

  syntax Bool ::= kLt(Val, Val) [function]
  rule kLt(I1:Int, I2:Int)             => I1 <Int I2
  rule kLt(F1:Float, F2:Float)         => F1 <Float F2
  rule kLt(str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)

  syntax ValSeq ::= unpairVS(ValSeq) [function, total]
  rule unpairVS(.ValSeq) => .ValSeq
  rule unpairVS(vCons(kvP(_:Val, V:Val), R:ValSeq)) => vCons(V, unpairVS(R))
  rule unpairVS(vCons(V:Val, R:ValSeq)) => vCons(V, unpairVS(R)) [owise]
endmodule
requires "reference-semantics/semantics.k"

module EXCHANGE-VERIFICATION
  imports MPY

  // A typed symbolic view of Python integer-list contents.  Its iterator
  // equations are exactly the two MPY-LIST equations for .ValSeq/vCons.
  // Concrete execution still uses ordinary list literals and MPY-LIST.
  syntax ValSeq ::= intVals(IntSeq)
  rule <k> #iterNext(list(intVals(.IntSeq))) => #iterDone ... </k>
  rule <k> #iterNext(list(intVals(iCons(I:Int, R:IntSeq))))
        => #iterYield(I, list(intVals(R))) ... </k>

  // Accumulator-form counts mirror the program's AugAssign exactly.  Besides
  // avoiding any reliance on algebraic normalization, oddAcc(0, VS) and
  // evenAcc(0, VS) are the ordinary odd/even element counts.
  syntax Int ::= oddAcc(Int, IntSeq) [function, total]
  rule oddAcc(A:Int, .IntSeq) => A
  rule oddAcc(A:Int, iCons(I:Int, R:IntSeq)) => oddAcc(A, R)
    requires pyMod(I, 2) ==Int 0
  rule oddAcc(A:Int, iCons(I:Int, R:IntSeq)) => oddAcc(A +Int 1, R)
    requires pyMod(I, 2) =/=Int 0

  syntax Int ::= evenAcc(Int, IntSeq) [function, total]
  rule evenAcc(A:Int, .IntSeq) => A
  rule evenAcc(A:Int, iCons(I:Int, R:IntSeq)) => evenAcc(A +Int 1, R)
    requires pyMod(I, 2) ==Int 0
  rule evenAcc(A:Int, iCons(I:Int, R:IntSeq)) => evenAcc(A, R)
    requires pyMod(I, 2) =/=Int 0

  syntax Val ::= exchangeResult(IntSeq, IntSeq) [function, total]
  rule exchangeResult(A:IntSeq, B:IntSeq)
    => str(iCons(89, iCons(69, iCons(83, .IntSeq))))
    requires oddAcc(0, A) <=Int evenAcc(0, B)
  rule exchangeResult(A:IntSeq, B:IntSeq)
    => str(iCons(78, iCons(79, .IntSeq)))
    requires oddAcc(0, A) >Int evenAcc(0, B)

  // These macros are the exact constructor form generated in solution.mpy.
  // Factoring the loop bodies makes the induction claims readable.
  syntax Stmts ::= "ODD-BODY" [macro]
  rule ODD-BODY
    => If(
         Compare(BinOp("%", Name("number"), Int(2)),
                 CmpOp("!=", Int(0))),
         AugAssign(Name("odd"), "+", Int(1)),
         .Stmts)

  syntax Stmts ::= "EVEN-BODY" [macro]
  rule EVEN-BODY
    => If(
         Compare(BinOp("%", Name("number"), Int(2)),
                 CmpOp("==", Int(0))),
         AugAssign(Name("even"), "+", Int(1)),
         .Stmts)

  syntax Stmt ::= "exchangeDef" [macro]
  rule exchangeDef
    => FuncDef(
         "exchange",
         Params("lst1", "lst2"),
         Assign(Name("odd"), Int(0))
         Assign(Name("even"), Int(0))
         Assign(Name("number"), Int(0))
         For(Name("number"), Name("lst1"), ODD-BODY)
         For(Name("number"), Name("lst2"), EVEN-BODY)
         If(Compare(Name("odd"), CmpOp("<=", Name("even"))),
            Return(Str("YES")),
            .Stmts)
         Return(Str("NO")))
endmodule
requires "verification.k"

module EXCHANGE-SPEC
  imports EXCHANGE-VERIFICATION

  // Induction invariant for the first loop.
  claim [odd-loop]:
    <k>
      #loop(list(intVals(iCons(I:Int, IS:IntSeq))),
            Name("number"), ODD-BODY) ~> CONT:K
      =>
      CONT
    </k>
    <env> L:Int </env>
    <scopes>
      SC:Map
      L |-> scope(
        ( "lst1"  |-> LST1:Val
          "lst2"  |-> LST2:Val
          "odd"   |-> O:Int
          "even"  |-> E:Int
          "number" |-> N:Int ),
        P:Parent)
      =>
      SC
      L |-> scope(
        ( "lst1"  |-> LST1
          "lst2"  |-> LST2
          "odd"   |-> oddAcc(O, iCons(I, IS))
          "even"  |-> E
          "number" |-> ?ODDLAST:Int ),
        P)
    </scopes>
    requires notBool L in_keys(SC)

  // The analogous invariant for the second loop.
  claim [even-loop]:
    <k>
      #loop(list(intVals(iCons(I:Int, IS:IntSeq))),
            Name("number"), EVEN-BODY) ~> CONT:K
      =>
      CONT
    </k>
    <env> L:Int </env>
    <scopes>
      SC:Map
      L |-> scope(
        ( "lst1"  |-> LST1:Val
          "lst2"  |-> LST2:Val
          "odd"   |-> O:Int
          "even"  |-> E:Int
          "number" |-> N:Int ),
        P:Parent)
      =>
      SC
      L |-> scope(
        ( "lst1"  |-> LST1
          "lst2"  |-> LST2
          "odd"   |-> O
          "even"  |-> evenAcc(E, iCons(I, IS))
          "number" |-> ?EVENLAST:Int ),
        P)
    </scopes>
    requires notBool L in_keys(SC)

  // End-to-end functional correctness for all non-empty integer lists, the
  // input domain promised by prompt.py.
  claim [exchange-correct]:
    <k>
      #loadAll(Module(exchangeDef))
      ~> Call(
           Name("exchange"),
           ( list(intVals(iCons(A:Int, AS:IntSeq)))
           , list(intVals(iCons(B:Int, BS:IntSeq)))
           , .Exprs))
      =>
      exchangeResult(
        iCons(A, AS),
        iCons(B, BS))
    </k>
    <env> 0 </env>
    <scopes>
      ( 0  |-> scope(.Map, parent(-1))
        -1 |-> builtinsScope )
      =>
      ?FINALSCOPES:Map
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule

