+           Name("exchange"),
+           ( list(vCons(A:Int, intsVS(AS:IntSeq)))
+           , list(vCons(B:Int, intsVS(BS:IntSeq)))
+           , .Exprs))
+      =>
+      exchangeResult(
+        vCons(A, intsVS(AS)),
+        vCons(B, intsVS(BS)))
+    </k>
+endmodule
