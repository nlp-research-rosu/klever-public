+         For(Name("number"), Name("lst2"), EVEN-BODY)
+         If(Compare(Name("odd"), CmpOp("<=", Name("even"))),
+            Return(Str("YES")),
+            .Stmts)
+         Return(Str("NO")))
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..6bbd2dd4092e8b7848e93e7b87518abb1d767db4
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def exchange(lst1, lst2):
+    odd = 0
+    even = 0
+    for number in lst1:
+        if number % 2 != 0:
+            odd += 1
+    for number in lst2:
+        if number % 2 == 0:
+            even += 1
+    if odd <= even:
+        return "YES"
+    return "NO"
