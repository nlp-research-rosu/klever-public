+    <k>
+      #loop(list(vCons(I:Int, intsVS(IS:IntSeq))),
+            Name("number"), EVEN-BODY) ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        ( "lst1"  |-> LST1:Val
+          "lst2"  |-> LST2:Val
+          "odd"   |-> O:Int
+          "even"  |-> E:Int
+          "number" |-> N:Int ),
