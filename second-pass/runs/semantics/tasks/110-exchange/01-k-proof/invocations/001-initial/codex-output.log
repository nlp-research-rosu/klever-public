+      L |-> scope(
+        ( "lst1"  |-> LST1
+          "lst2"  |-> LST2
+          "odd"   |-> O +Int oddVS(vCons(I, intsVS(IS)))
+          "even"  |-> E
+          "number" |-> lastVS(I, intsVS(IS)) ),
+        P)
+    </scopes>
+    requires notBool L in_keys(SC)
+
+  // The analogous invariant for the second loop.
+  claim [even-loop]:
+    <k>
+      #loop(list(vCons(I:Int, intsVS(IS:IntSeq))),
+            Name("number"), EVEN-BODY) ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        ( "lst1"  |-> LST1:Val
+          "lst2"  |-> LST2:Val
+          "odd"   |-> O:Int
+          "even"  |-> E:Int
+          "number" |-> N:Int ),
+        P:Parent)
+      =>
+      SC
+      L |-> scope(
+        ( "lst1"  |-> LST1
+          "lst2"  |-> LST2
+          "odd"   |-> O
+          "even"  |-> E +Int evenVS(vCons(I, intsVS(IS)))
+          "number" |-> lastVS(I, intsVS(IS)) ),
+        P)
+    </scopes>
+    requires notBool L in_keys(SC)
+
+  // End-to-end functional correctness for all non-empty integer lists, the
+  // input domain promised by prompt.py.
+  claim [exchange-correct]:
+    <k>
+      #loadAll(Module(exchangeDef))
+      ~> Call(
+           Name("exchange"),
+           ( list(vCons(A:Int, intsVS(AS:IntSeq)))
+           , list(vCons(B:Int, intsVS(BS:IntSeq)))
+           , .Exprs))
+      =>
+      exchangeResult(
+        vCons(A, intsVS(AS)),
+        vCons(B, intsVS(BS)))
+    </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..bcf7c8ee5f27bcc4d65db1bf1a7ee8576c1ec9f6
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,72 @@
+requires "reference-semantics/semantics.k"
+
+module EXCHANGE-VERIFICATION
+  imports MPY
+
+  // Embed an arbitrary K IntSeq as a Python list's ValSeq.  This keeps the
+  // theorem's input domain exactly "lists of integers".
+  syntax ValSeq ::= intsVS(IntSeq) [function, total, injective]
+  rule intsVS(.IntSeq)                => .ValSeq
+  rule intsVS(iCons(I:Int, R:IntSeq)) => vCons(I, intsVS(R))
+
+  syntax Int ::= oddVS(ValSeq) [function]
+  rule oddVS(.ValSeq) => 0
+  rule oddVS(vCons(I:Int, R:ValSeq)) => oddVS(R)
+    requires pyMod(I, 2) ==Int 0
+  rule oddVS(vCons(I:Int, R:ValSeq)) => 1 +Int oddVS(R)
+    requires pyMod(I, 2) =/=Int 0
+
+  syntax Int ::= evenVS(ValSeq) [function]
+  rule evenVS(.ValSeq) => 0
+  rule evenVS(vCons(I:Int, R:ValSeq)) => 1 +Int evenVS(R)
+    requires pyMod(I, 2) ==Int 0
+  rule evenVS(vCons(I:Int, R:ValSeq)) => evenVS(R)
+    requires pyMod(I, 2) =/=Int 0
+
+  // The value left in the Python for-target after traversing a non-empty
+  // integer sequence.
+  syntax Int ::= lastVS(Int, ValSeq) [function]
+  rule lastVS(I:Int, .ValSeq)                => I
+  rule lastVS(_:Int, vCons(I:Int, R:ValSeq)) => lastVS(I, R)
+
+  syntax Val ::= exchangeResult(ValSeq, ValSeq) [function]
+  rule exchangeResult(A:ValSeq, B:ValSeq)
+    => str(iCons(89, iCons(69, iCons(83, .IntSeq))))
+    requires oddVS(A) <=Int evenVS(B)
+  rule exchangeResult(A:ValSeq, B:ValSeq)
+    => str(iCons(78, iCons(79, .IntSeq)))
+    requires oddVS(A) >Int evenVS(B)
+
+  // These macros are the exact constructor form generated in solution.mpy.
+  // Factoring the loop bodies makes the induction claims readable.
+  syntax Stmts ::= "ODD-BODY" [macro]
+  rule ODD-BODY
+    => If(
+         Compare(BinOp("%", Name("number"), Int(2)),
+                 CmpOp("!=", Int(0))),
+         AugAssign(Name("odd"), "+", Int(1)),
+         .Stmts)
+
+  syntax Stmts ::= "EVEN-BODY" [macro]
+  rule EVEN-BODY
+    => If(
+         Compare(BinOp("%", Name("number"), Int(2)),
+                 CmpOp("==", Int(0))),
+         AugAssign(Name("even"), "+", Int(1)),
+         .Stmts)
+
+  syntax Stmt ::= "exchangeDef" [macro]
+  rule exchangeDef
+    => FuncDef(
+         "exchange",
+         Params("lst1", "lst2"),
+         Assign(Name("odd"), Int(0))
+         Assign(Name("even"), Int(0))
+         Assign(Name("number"), Int(0))
+         For(Name("number"), Name("lst1"), ODD-BODY)
+         For(Name("number"), Name("lst2"), EVEN-BODY)
+         If(Compare(Name("odd"), CmpOp("<=", Name("even"))),
+            Return(Str("YES")),
+            .Stmts)
+         Return(Str("NO")))
+endmodule

apply patch
