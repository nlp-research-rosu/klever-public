+          "even"  |-> E
+          "number" |-> lastIS(I, IS) ),
+        P)
+    </scopes>
+    requires notBool L in_keys(SC)
+
+  // The analogous invariant for the second loop.
+  claim [even-loop]:
+    <k>
+      #loop(list(vCons(I:Int, intsVS(IS:IntSeq))),
+            Name("number"), EVEN-BODY) ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        ( "lst1"  |-> LST1:Val
+          "lst2"  |-> LST2:Val
+          "odd"   |-> O:Int
+          "even"  |-> E:Int
+          "number" |-> N:Int ),
+        P:Parent)
+      =>
