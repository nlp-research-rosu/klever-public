+module EXCHANGE-SPEC
+  imports EXCHANGE-VERIFICATION
+
+  // Induction invariant for the first loop.
+  claim [odd-loop]:
+    <k>
+      #loop(list(vCons(I:Int, intsVS(IS:IntSeq))),
+            Name("number"), ODD-BODY) ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        ( "lst1"  |-> LST1:Val
+          "lst2"  |-> LST2:Val
+          "odd"   |-> O:Int
+          "even"  |-> E:Int
+          "number" |-> N:Int ),
+        P:Parent)
+      =>
+      SC
+      L |-> scope(
+        ( "lst1"  |-> LST1
+          "lst2"  |-> LST2
+          "odd"   |-> oddAcc(O, vCons(I, intsVS(IS)))
+          "even"  |-> E
+          "number" |-> ?ODDLAST:Int ),
+        P)
+    </scopes>
+    requires notBool L in_keys(SC)
+
+  // The analogous invariant for the second loop.
+  claim [even-loop]:
+    <k>
+      #loop(list(vCons(I:Int, intsVS(IS:IntSeq))),
+            Name("number"), EVEN-BODY) ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        ( "lst1"  |-> LST1:Val
+          "lst2"  |-> LST2:Val
+          "odd"   |-> O:Int
+          "even"  |-> E:Int
+          "number" |-> N:Int ),
+        P:Parent)
+      =>
+      SC
+      L |-> scope(
+        ( "lst1"  |-> LST1
+          "lst2"  |-> LST2
+          "odd"   |-> O
+          "even"  |-> evenAcc(E, vCons(I, intsVS(IS)))
+          "number" |-> ?EVENLAST:Int ),
