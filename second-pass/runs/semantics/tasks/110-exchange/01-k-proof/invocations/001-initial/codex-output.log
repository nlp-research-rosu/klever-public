new file mode 100644
index 0000000000000000000000000000000000000000..2e7fb4051ac5add44c119a06dea29d945a7bb3dd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def exchange(lst1, lst2):
+    odd = 0
+    even = 0
+    number = 0
+    for number in lst1:
+        if number % 2 != 0:
+            odd += 1
+    for number in lst2:
+        if number % 2 == 0:
+            even += 1
+    if odd <= even:
+        return "YES"
+    return "NO"
