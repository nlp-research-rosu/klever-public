index 0000000000000000000000000000000000000000..6bbd2dd4092e8b7848e93e7b87518abb1d767db4
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def exchange(lst1, lst2):
+    odd = 0
+    even = 0
+    for number in lst1:
+        if number % 2 != 0:
+            odd += 1
+    for number in lst2:
+        if number % 2 == 0:
+            even += 1
+    if odd <= even:
+        return "YES"
+    return "NO"
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..7c127861554ff3d06be71755212416f2cbe6a17c
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,64 @@
+requires "verification.k"
+
+module EXCHANGE-SPEC
+  imports EXCHANGE-VERIFICATION
+
+  // Induction invariant for the first loop.  M may already contain a value
+  // for "number"; a non-empty for-loop overwrites it with its last element.
+  claim [odd-loop]:
+    <k>
+      #loop(list(vCons(I:Int, intsVS(IS:IntSeq))),
+            Name("number"), ODD-BODY) ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(M:Map [ "odd" <- O:Int ], P:Parent)
+      =>
+      SC
+      L |-> scope(
+        (M [ "odd" <- O +Int oddIS(iCons(I, IS)) ])
+          [ "number" <- lastIS(I, IS) ],
+        P)
+    </scopes>
+    requires notBool L in_keys(SC)
+     andBool notBool "odd" in_keys(M)
+
+  // The analogous invariant for the second loop.
+  claim [even-loop]:
+    <k>
+      #loop(list(vCons(I:Int, intsVS(IS:IntSeq))),
+            Name("number"), EVEN-BODY) ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(M:Map [ "even" <- E:Int ], P:Parent)
+      =>
+      SC
+      L |-> scope(
+        (M [ "even" <- E +Int evenIS(iCons(I, IS)) ])
+          [ "number" <- lastIS(I, IS) ],
+        P)
+    </scopes>
+    requires notBool L in_keys(SC)
+     andBool notBool "even" in_keys(M)
+
+  // End-to-end functional correctness for all non-empty integer lists, the
+  // input domain promised by prompt.py.
+  claim [exchange-correct]:
+    <k>
+      #loadAll(Module(exchangeDef))
+      ~> Call(
+           Name("exchange"),
+           ( list(vCons(A:Int, intsVS(AS:IntSeq)))
+           , list(vCons(B:Int, intsVS(BS:IntSeq)))
+           , .Exprs))
+      =>
+      exchangeResult(iCons(A, AS), iCons(B, BS))
+    </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9b6f9229d91625a7443619f7870f2c629bc3678b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,71 @@
+requires "reference-semantics/semantics.k"
+
+module EXCHANGE-VERIFICATION
+  imports MPY
+
+  // Embed an arbitrary K IntSeq as a Python list's ValSeq.  This keeps the
+  // theorem's input domain exactly "lists of integers".
+  syntax ValSeq ::= intsVS(IntSeq) [function, total]
+  rule intsVS(.IntSeq)                => .ValSeq
+  rule intsVS(iCons(I:Int, R:IntSeq)) => vCons(I, intsVS(R))
+
+  syntax Int ::= oddIS(IntSeq) [function, total]
+  rule oddIS(.IntSeq) => 0
+  rule oddIS(iCons(I:Int, R:IntSeq)) => oddIS(R)
+    requires pyMod(I, 2) ==Int 0
+  rule oddIS(iCons(I:Int, R:IntSeq)) => 1 +Int oddIS(R)
+    requires pyMod(I, 2) =/=Int 0
+
+  syntax Int ::= evenIS(IntSeq) [function, total]
+  rule evenIS(.IntSeq) => 0
+  rule evenIS(iCons(I:Int, R:IntSeq)) => 1 +Int evenIS(R)
+    requires pyMod(I, 2) ==Int 0
+  rule evenIS(iCons(I:Int, R:IntSeq)) => evenIS(R)
+    requires pyMod(I, 2) =/=Int 0
+
+  // The value left in the Python for-target after traversing a non-empty
+  // integer sequence.
+  syntax Int ::= lastIS(Int, IntSeq) [function, total]
+  rule lastIS(I:Int, .IntSeq)                => I
+  rule lastIS(_:Int, iCons(I:Int, R:IntSeq)) => lastIS(I, R)
+
+  syntax Val ::= exchangeResult(IntSeq, IntSeq) [function, total]
+  rule exchangeResult(A:IntSeq, B:IntSeq)
+    => str(iCons(89, iCons(69, iCons(83, .IntSeq))))
+    requires oddIS(A) <=Int evenIS(B)
+  rule exchangeResult(A:IntSeq, B:IntSeq)
+    => str(iCons(78, iCons(79, .IntSeq)))
+    requires oddIS(A) >Int evenIS(B)
+
+  // These macros are the exact constructor form generated in solution.mpy.
+  // Factoring the loop bodies makes the induction claims readable.
+  syntax Stmts ::= "ODD-BODY" [macro]
+  rule ODD-BODY
+    => If(
+         Compare(BinOp("%", Name("number"), Int(2)),
+                 CmpOp("!=", Int(0))),
+         AugAssign(Name("odd"), "+", Int(1)),
+         .Stmts)
+
+  syntax Stmts ::= "EVEN-BODY" [macro]
+  rule EVEN-BODY
+    => If(
+         Compare(BinOp("%", Name("number"), Int(2)),
+                 CmpOp("==", Int(0))),
+         AugAssign(Name("even"), "+", Int(1)),
+         .Stmts)
+
+  syntax Stmt ::= "exchangeDef" [macro]
+  rule exchangeDef
+    => FuncDef(
+         "exchange",
+         Params("lst1", "lst2"),
+         Assign(Name("odd"), Int(0))
+         Assign(Name("even"), Int(0))
+         For(Name("number"), Name("lst1"), ODD-BODY)
+         For(Name("number"), Name("lst2"), EVEN-BODY)
+         If(Compare(Name("odd"), CmpOp("<=", Name("even"))),
+            Return(Str("YES")),
+            .Stmts)
+         Return(Str("NO")))
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module EXCHANGE-SPEC --output pretty' in /work
