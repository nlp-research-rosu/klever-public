+            Name("number"), ODD-BODY) ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        ( "lst1"  |-> LST1:Val
+          "lst2"  |-> LST2:Val
+          "odd"   |-> O:Int
+          "even"  |-> E:Int
+          "number" |-> N:Int ),
+        P:Parent)
+      =>
+      SC
+      L |-> scope(
+        ( "lst1"  |-> LST1
+          "lst2"  |-> LST2
+          "odd"   |-> oddAcc(O, vCons(I, intsVS(IS)))
+          "even"  |-> E
+          "number" |-> ?ODDLAST:Int ),
+        P)
+    </scopes>
+    requires notBool L in_keys(SC)
+
+  // The analogous invariant for the second loop.
