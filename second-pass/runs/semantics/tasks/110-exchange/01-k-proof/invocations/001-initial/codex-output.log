+      SC:Map
+      L |-> scope(
+        ( "lst1"  |-> LST1:Val
+          "lst2"  |-> LST2:Val
+          "odd"   |-> O:Int
+          "even"  |-> E:Int
+          "number" |-> N:Int ),
+        P:Parent)
+      =>
+      SC
+      L |-> scope(
+        ( "lst1"  |-> LST1
+          "lst2"  |-> LST2
+          "odd"   |-> O
+          "even"  |-> evenAcc(E, iCons(I, IS))
+          "number" |-> ?EVENLAST:Int ),
+        P)
+    </scopes>
+    requires notBool L in_keys(SC)
+
+  // End-to-end functional correctness for all non-empty integer lists, the
+  // input domain promised by prompt.py.
+  claim [exchange-correct]:
+    <k>
+      #loadAll(Module(exchangeDef))
+      ~> Call(
+           Name("exchange"),
+           ( list(intVals(iCons(A:Int, AS:IntSeq)))
+           , list(intVals(iCons(B:Int, BS:IntSeq)))
+           , .Exprs))
+      =>
+      exchangeResult(
+        iCons(A, AS),
+        iCons(B, BS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      ( 0  |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope )
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
