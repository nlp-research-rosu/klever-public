+      L |-> scope(
+        ( "lst1"  |-> LST1
+          "lst2"  |-> LST2
+          "odd"   |-> O
+          "even"  |-> evenAcc(E, vCons(I, VS))
+          "number" |-> ?EVENLAST:Int ),
