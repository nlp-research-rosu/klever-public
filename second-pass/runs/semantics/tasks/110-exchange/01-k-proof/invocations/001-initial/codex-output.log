diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..2e7fb4051ac5add44c119a06dea29d945a7bb3dd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def exchange(lst1, lst2):
+    odd = 0
+    even = 0
+    number = 0
+    for number in lst1:
+        if number % 2 != 0:
+            odd += 1
+    for number in lst2:
+        if number % 2 == 0:
+            even += 1
+    if odd <= even:
+        return "YES"
+    return "NO"
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0ef5882bdafe919ed8b5727af508f8ef7695d627
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,79 @@
+requires "verification.k"
+
+module EXCHANGE-SPEC
+  imports EXCHANGE-VERIFICATION
+
+  // Induction invariant for the first loop.
+  claim [odd-loop]:
+    <k>
+      #loop(list(vCons(I:Int, intsVS(IS:IntSeq))),
+            Name("number"), ODD-BODY) ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
