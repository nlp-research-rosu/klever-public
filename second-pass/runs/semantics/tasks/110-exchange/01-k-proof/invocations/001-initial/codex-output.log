diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..660ea773d41e62e55a3843532148c2989c00e17c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,75 @@
+requires "reference-semantics/semantics.k"
+
+module EXCHANGE-VERIFICATION
+  imports MPY
+
+  // Embed an arbitrary K IntSeq as a Python list's ValSeq.  This keeps the
+  // theorem's input domain exactly "lists of integers".
+  syntax ValSeq ::= intsVS(IntSeq) [function, total, injective]
+  rule intsVS(.IntSeq)                => .ValSeq
+  rule intsVS(iCons(I:Int, R:IntSeq)) => vCons(I, intsVS(R))
+
+  // Accumulator-form counts mirror the program's AugAssign exactly.  Besides
+  // avoiding any reliance on algebraic normalization, oddAcc(0, VS) and
+  // evenAcc(0, VS) are the ordinary odd/even element counts.
+  syntax Int ::= oddAcc(Int, ValSeq) [function]
+  rule oddAcc(A:Int, .ValSeq) => A
+  rule oddAcc(A:Int, vCons(I:Int, R:ValSeq)) => oddAcc(A, R)
+    requires pyMod(I, 2) ==Int 0
+  rule oddAcc(A:Int, vCons(I:Int, R:ValSeq)) => oddAcc(A +Int 1, R)
+    requires pyMod(I, 2) =/=Int 0
+
+  syntax Int ::= evenAcc(Int, ValSeq) [function]
+  rule evenAcc(A:Int, .ValSeq) => A
+  rule evenAcc(A:Int, vCons(I:Int, R:ValSeq)) => evenAcc(A +Int 1, R)
+    requires pyMod(I, 2) ==Int 0
+  rule evenAcc(A:Int, vCons(I:Int, R:ValSeq)) => evenAcc(A, R)
+    requires pyMod(I, 2) =/=Int 0
+
+  // The value left in the Python for-target after traversing a non-empty
+  // integer sequence.
+  syntax Int ::= lastVS(Int, ValSeq) [function]
+  rule lastVS(I:Int, .ValSeq)                => I
+  rule lastVS(_:Int, vCons(I:Int, R:ValSeq)) => lastVS(I, R)
+
+  syntax Val ::= exchangeResult(ValSeq, ValSeq) [function]
+  rule exchangeResult(A:ValSeq, B:ValSeq)
+    => str(iCons(89, iCons(69, iCons(83, .IntSeq))))
+    requires oddAcc(0, A) <=Int evenAcc(0, B)
+  rule exchangeResult(A:ValSeq, B:ValSeq)
+    => str(iCons(78, iCons(79, .IntSeq)))
+    requires oddAcc(0, A) >Int evenAcc(0, B)
+
+  // These macros are the exact constructor form generated in solution.mpy.
+  // Factoring the loop bodies makes the induction claims readable.
+  syntax Stmts ::= "ODD-BODY" [macro]
+  rule ODD-BODY
+    => If(
+         Compare(BinOp("%", Name("number"), Int(2)),
+                 CmpOp("!=", Int(0))),
+         AugAssign(Name("odd"), "+", Int(1)),
+         .Stmts)
+
+  syntax Stmts ::= "EVEN-BODY" [macro]
+  rule EVEN-BODY
+    => If(
+         Compare(BinOp("%", Name("number"), Int(2)),
+                 CmpOp("==", Int(0))),
+         AugAssign(Name("even"), "+", Int(1)),
+         .Stmts)
+
+  syntax Stmt ::= "exchangeDef" [macro]
+  rule exchangeDef
+    => FuncDef(
+         "exchange",
+         Params("lst1", "lst2"),
+         Assign(Name("odd"), Int(0))
+         Assign(Name("even"), Int(0))
+         Assign(Name("number"), Int(0))
+         For(Name("number"), Name("lst1"), ODD-BODY)
+         For(Name("number"), Name("lst2"), EVEN-BODY)
+         If(Compare(Name("odd"), CmpOp("<=", Name("even"))),
+            Return(Str("YES")),
+            .Stmts)
+         Return(Str("NO")))
+endmodule

