Module(
  FuncDef("exchange", Params("lst1", "lst2"),
    Assign(Name("odd"), Int(0))
    Assign(Name("even"), Int(0))
    Assign(Name("number"), Int(0))
    For(Name("number"), Name("lst1"),
      If(Compare(BinOp("%", Name("number"), Int(2)), CmpOp("!=", Int(0))),
        AugAssign(Name("odd"), "+", Int(1)),
        ))
    For(Name("number"), Name("lst2"),
      If(Compare(BinOp("%", Name("number"), Int(2)), CmpOp("==", Int(0))),
        AugAssign(Name("even"), "+", Int(1)),
        ))
    If(Compare(Name("odd"), CmpOp("<=", Name("even"))),
      Return(Str("YES")),
      )
    Return(Str("NO")))
  Assert(
    Compare(
      Call(
        Name("exchange"),
        ListExpr(Int(1), Int(2), Int(3), Int(4)),
        ListExpr(Int(1), Int(2), Int(3), Int(4))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(
        Name("exchange"),
        ListExpr(Int(1), Int(2), Int(3), Int(4)),
        ListExpr(Int(1), Int(5), Int(3), Int(4))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(Name("exchange"), ListExpr(Int(2)), ListExpr(Int(1))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(Name("exchange"), ListExpr(Int(1)), ListExpr(Int(2))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(Name("exchange"), ListExpr(Int(1), Int(3)), ListExpr(Int(2))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("exchange"),
        ListExpr(UnaryOp("-", Int(3)), UnaryOp("-", Int(2))),
        ListExpr(UnaryOp("-", Int(4)), Int(5))),
      CmpOp("==", Str("YES")))))
