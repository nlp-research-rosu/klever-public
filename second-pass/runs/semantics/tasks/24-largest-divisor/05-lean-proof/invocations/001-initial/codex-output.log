diff --git a//tmp/lean_proc_shim.c b//tmp/lean_proc_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..3cb1de01701fa5d2fc0a50834247cf02fb6e5930
--- /dev/null
+++ b//tmp/lean_proc_shim.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink = NULL;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  if (strncmp(path, "/proc/", 6) == 0) {
+    size_t length = strlen(path);
+    if (length >= 10 && strcmp(path + length - 4, "/exe") == 0) {
+      return real_readlink("/proc/self/exe", buffer, size);
+    }
+  }
+  return real_readlink(path, buffer, size);
+}
