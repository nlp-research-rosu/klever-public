Module(
  FuncDef("largest_divisor", Params("n"),
    Expr(
      Str(
        "Return the largest positive divisor of n that is smaller than n."))
    Assign(Name("divisor"), BinOp("-", Name("n"), Int(1)))
    While(Compare(BinOp("%", Name("n"), Name("divisor")), CmpOp("!=", Int(0))),
      AugAssign(Name("divisor"), "-", Int(1)))
    Return(Name("divisor")))
  Assert(
    Compare(Call(Name("largest_divisor"), Int(2)), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("largest_divisor"), Int(3)), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("largest_divisor"), Int(10)), CmpOp("==", Int(5))))
  Assert(
    Compare(Call(Name("largest_divisor"), Int(15)), CmpOp("==", Int(5))))
  Assert(
    Compare(Call(Name("largest_divisor"), Int(49)), CmpOp("==", Int(7))))
  Assert(
    Compare(
      Call(Name("largest_divisor"), Int(100)),
      CmpOp("==", Int(50)))))
