+
+  // Loop invariant/circularity: D is a positive candidate below N.  The
+  // semantics and reference scan both either return D when it divides N or
+  // continue with D - 1.  At D = 1 the non-divisor branch is impossible.
+  claim
+    <k>
+      #while(
+        Compare(
+          BinOp("%", Name("n"), Name("divisor")),
+          CmpOp("!=", Int(0))),
+        AugAssign(Name("divisor"), "-", Int(1)))
+      ~> Return(Name("divisor"))
+      ~> #endcall
+      => firstDivisorAtOrBelow(N, D) ~> .K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      SC:Map
+      1 |-> scope(
+        "n" |-> N
+        "divisor" |-> D,
+        parent(0))
+      =>
+      SC
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 1 andBool D >=Int 1 andBool D <Int N
+    [label(loopCorrect)]
+endmodule
+
+module SPEC
+  imports VERIFICATION-WITH-LOOP-LEMMA
+
+  // Public-entry proof for the exact translated definition.  The precondition
+  // N > 1 is the natural domain on which a positive proper divisor exists.
+  claim
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "largest_divisor",
+            Params("n"),
+            largestDivisorBody())))
+      ~> Call(Name("largest_divisor"), Int(N))
+      => largestProperDivisor(N) ~> .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "largest_divisor" |->
+          closureVal("n", largestDivisorBody(), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
