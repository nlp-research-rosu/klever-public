diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e4c8d16904d46d1028922932a21d07bd90b516a8
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,79 @@
+requires "verification.k"
+
+module LOOP-SPEC
+  imports VERIFICATION
+
+  // Loop invariant/circularity: D is a positive candidate below N.  The
+  // semantics and reference scan both either return D when it divides N or
+  // continue with D - 1.  At D = 1 the non-divisor branch is impossible.
+  claim
+    <k>
+      #while(
+        Compare(
+          BinOp("%", Name("n"), Name("divisor")),
+          CmpOp("!=", Int(0))),
+        AugAssign(Name("divisor"), "-", Int(1)))
+      ~> Return(Name("divisor"))
+      ~> #endcall
+      => firstDivisorAtOrBelow(N, D) ~> .K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(G:Map, parent(-1))
+      -1 |-> B:Scope
+      1 |-> scope(
+        "n" |-> N
+        "divisor" |-> D,
+        parent(0))
