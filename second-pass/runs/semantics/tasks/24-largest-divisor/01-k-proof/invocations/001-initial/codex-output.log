+          CmpOp("!=", Int(0))),
+        AugAssign(Name("divisor"), "-", Int(1)))
+      ~> Return(Name("divisor"))
+      ~> #endcall
+      => firstDivisorAtOrBelow(N, D) ~> .K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(G:Map, parent(-1))
+      -1 |-> B:Scope
+      1 |-> scope(
+        "n" |-> N
+        "divisor" |-> D,
+        parent(0))
+      =>
