+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "largest_divisor",
+            Params("n"),
+            largestDivisorBody())))
+      ~> Call(Name("largest_divisor"), Int(N))
+      => largestProperDivisor(N) ~> .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "largest_divisor" |->
+          closureVal("n", largestDivisorBody(), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
