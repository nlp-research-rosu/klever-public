diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2f96a9eeee68d2cbc0b745c11c923fe88581e9e2
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,77 @@
+requires "verification.k"
+
+module LOOP-SPEC
+  imports VERIFICATION
+
+  // Loop invariant/circularity: D is a positive candidate below N.  The
+  // semantics and reference scan both either return D when it divides N or
+  // continue with D - 1.  At D = 1 the non-divisor branch is impossible.
+  claim
+    <k>
+      #while(
+        Compare(
+          BinOp("%", Name("n"), Name("divisor")),
+          CmpOp("!=", Int(0))),
+        AugAssign(Name("divisor"), "-", Int(1)))
+      ~> Return(Name("divisor"))
+      ~> #endcall
+      => firstDivisorAtOrBelow(N, D) ~> .K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      SC:Map
+      1 |-> scope(
+        "n" |-> N
+        "divisor" |-> D,
+        parent(0))
+      =>
+      SC
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 1 andBool D >=Int 1 andBool D <Int N
+    [label(loopCorrect)]
+endmodule
+
+module SPEC
+  imports VERIFICATION-WITH-LOOP-LEMMA
+
+  // Public-entry proof for the exact translated definition.  The precondition
+  // N > 1 is the natural domain on which a positive proper divisor exists.
+  claim
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "largest_divisor",
+            Params("n"),
+            largestDivisorBody())))
+      ~> Call(Name("largest_divisor"), Int(N))
+      => largestProperDivisor(N) ~> .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "largest_divisor" |->
+          closureVal("n", largestDivisorBody(), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 1
+    [label(entryCorrect)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..318221bc8a0d349501652c75bb67578058e8d128
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,80 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The exact statement body emitted in solution.mpy.  Naming it keeps the
+  // reachability claims readable; this equation is only syntactic sharing.
+  syntax Stmts ::= largestDivisorBody() [function]
+  rule largestDivisorBody()
+    => Expr(Str("Return the largest positive divisor of n that is smaller than n."))
+       Assign(Name("divisor"), BinOp("-", Name("n"), Int(1)))
+       While(
+         Compare(
+           BinOp("%", Name("n"), Name("divisor")),
+           CmpOp("!=", Int(0))),
+         AugAssign(Name("divisor"), "-", Int(1)))
+       Return(Name("divisor"))
+
+  // Mathematical reference result: scan the positive candidates strictly
+  // below N in descending order and select the first divisor.  Thus the
+  // result divides N, is below N, and no larger candidate below N divides N.
+  syntax Int ::= largestProperDivisor(Int) [function]
+               | firstDivisorAtOrBelow(Int, Int) [function]
+
+  rule largestProperDivisor(N:Int)
+    => firstDivisorAtOrBelow(N, N -Int 1)
+
+  rule firstDivisorAtOrBelow(N:Int, D:Int) => D
+    requires D >Int 0 andBool pyMod(N, D) ==Int 0
+
+  rule firstDivisorAtOrBelow(N:Int, D:Int)
+    => firstDivisorAtOrBelow(N, D -Int 1)
+    requires D >Int 1 andBool pyMod(N, D) =/=Int 0
+
+  // The symbolic Map backend leaves deletion of a symbolic frame as an
+  // update term.  This extensional simplification is the Map fact used by
+  // #pop: deleting the fresh key 1 restores the untouched remainder.
+  rule
+    (1 |-> _S:Scope SC:Map) [1 <- undef] => SC
+    requires notBool 1 in_keys(SC)
+    [simplification, label(deleteFreshFrame)]
+endmodule
+
+// Proof-stage module.  LOOP-SPEC proves this exact reachability step against
+// VERIFICATION first; only then is it made available as a reusable lemma for
+// the public-entry proof in SPEC.
+module VERIFICATION-WITH-LOOP-LEMMA
+  imports VERIFICATION
+
+  rule
+    <k>
+      While(
+        Compare(
+          BinOp("%", Name("n"), Name("divisor")),
+          CmpOp("!=", Int(0))),
+        AugAssign(Name("divisor"), "-", Int(1)))
+      ~> Return(Name("divisor"))
+      ~> #endcall
+      => firstDivisorAtOrBelow(N, D) ~> .K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      SC:Map
+      1 |-> scope(
+        "n" |-> N
+        "divisor" |-> D,
+        parent(0))
+      =>
+      SC
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 1 andBool D >=Int 1 andBool D <Int N
+    [priority(20), label(loopLemma)]
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module LOOP-SPEC' in /work
