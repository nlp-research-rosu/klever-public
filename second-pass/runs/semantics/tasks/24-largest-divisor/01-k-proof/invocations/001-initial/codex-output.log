+    <k>
+      #while(
+        Compare(
+          BinOp("%", Name("n"), Name("divisor")),
+          CmpOp("!=", Int(0))),
+        AugAssign(Name("divisor"), "-", Int(1)))
+      ~> Return(Name("divisor"))
+      ~> #endcall
+      => firstDivisorAtOrBelow(N, D) ~> .K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      SC:Map
+      1 |-> scope(
+        "n" |-> N
+        "divisor" |-> D,
+        parent(0))
+      =>
