+  imports VERIFICATION
+
+  rule
+    <k>
+      #while(
+        Compare(
+          BinOp("%", Name("n"), Name("divisor")),
+          CmpOp("!=", Int(0))),
+        AugAssign(Name("divisor"), "-", Int(1)))
+      ~> Return(Name("divisor"))
+      ~> #endcall
+      => firstDivisorAtOrBelow(N, D) ~> .K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(G:Map, parent(-1))
+      -1 |-> B:Scope
+      1 |-> scope(
+        "n" |-> N
+        "divisor" |-> D,
+        parent(0))
+      =>
+      0 |-> scope(G, parent(-1))
+      -1 |-> B
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 1 andBool D >=Int 1 andBool D <Int N
+    [priority(20), label(loopLemma)]
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..70fa74fe1b520d259c69ecd9aa75e2e20748e5d8
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,14 @@
+def largest_divisor(n: int) -> int:
+    """Return the largest positive divisor of n that is smaller than n."""
+    divisor = n - 1
+    while n % divisor != 0:
+        divisor -= 1
+    return divisor
+
+
+assert largest_divisor(2) == 1
+assert largest_divisor(3) == 1
+assert largest_divisor(10) == 5
+assert largest_divisor(15) == 5
+assert largest_divisor(49) == 7
+assert largest_divisor(100) == 50
