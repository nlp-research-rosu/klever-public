+      ~> Return(Name("divisor")) .Stmts
+      ~> #endcall
+    </k>
+    <env> 1 </env>
+    <scopes>
+      SC:Map
+      1 |-> scope("n" |-> N, parent(0))
+      =>
+      SC
+      1 |-> scope(
+        "n" |-> N
+        "divisor" |-> ?D:Int,
+        parent(0))
