+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "largest_divisor" |->
+          closureVal("n", largestDivisorBody(), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        "n" |-> N
+        "divisor" |-> ?D:Int,
+        parent(0))
+    </scopes>
+    <scopeLoc> 1 => 2 </scopeLoc>
+    <heap> .Map </heap>
