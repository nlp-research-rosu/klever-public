{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 17,
      "module": "VERIFICATION",
      "normalized_sha256": "4dc883be7558c48413570e94ef894be86bb7f2defba4701dddd8ecbdfc6fdf61",
      "rationale": "This equation expands the named largestDivisorBody proof term into the exact translated Python program body, providing syntactic sharing for the specifications.",
      "source_rule_id": "rule-4dc883be7558c48413570e94ef894be86bb7f2defba4701dddd8ecbdfc6fdf61",
      "start_line": 9,
      "text": "  rule largestDivisorBody()\n    => Expr(Str(\"Return the largest positive divisor of n that is smaller than n.\"))\n       Assign(Name(\"divisor\"), BinOp(\"-\", Name(\"n\"), Int(1)))\n       While(\n         Compare(\n           BinOp(\"%\", Name(\"n\"), Name(\"divisor\")),\n           CmpOp(\"!=\", Int(0))),\n         AugAssign(Name(\"divisor\"), \"-\", Int(1)))\n       Return(Name(\"divisor\"))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 26,
      "module": "VERIFICATION",
      "normalized_sha256": "7e08785f2fa3d9871eb727a17489e6ad09a58d3acdd6b1aa0576bb1cf35e0069",
      "rationale": "This equation defines largestProperDivisor(N) by initializing the descending reference scan at N - 1.",
      "source_rule_id": "rule-7e08785f2fa3d9871eb727a17489e6ad09a58d3acdd6b1aa0576bb1cf35e0069",
      "start_line": 25,
      "text": "  rule largestProperDivisor(N:Int)\n    => firstDivisorAtOrBelow(N, N -Int 1)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 29,
      "module": "VERIFICATION",
      "normalized_sha256": "ff250606498fa2b0f63ef3d95275fc5bcf246520b20e477dc18297ba8710f027",
      "rationale": "This is the terminating equation of firstDivisorAtOrBelow: a positive candidate that divides N is returned.",
      "source_rule_id": "rule-ff250606498fa2b0f63ef3d95275fc5bcf246520b20e477dc18297ba8710f027",
      "start_line": 28,
      "text": "  rule firstDivisorAtOrBelow(N:Int, D:Int) => D\n    requires D >Int 0 andBool pyMod(N, D) ==Int 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 33,
      "module": "VERIFICATION",
      "normalized_sha256": "864338f2577bfe3d8f78663dcfd53efcfbb9747d6d849326441f6cbd4b554fb8",
      "rationale": "This is the recursive equation of firstDivisorAtOrBelow: a nondividing candidate above 1 advances the mathematical scan to D - 1.",
      "source_rule_id": "rule-864338f2577bfe3d8f78663dcfd53efcfbb9747d6d849326441f6cbd4b554fb8",
      "start_line": 31,
      "text": "  rule firstDivisorAtOrBelow(N:Int, D:Int)\n    => firstDivisorAtOrBelow(N, D -Int 1)\n    requires D >Int 1 andBool pyMod(N, D) =/=Int 0"
    }
  ],
