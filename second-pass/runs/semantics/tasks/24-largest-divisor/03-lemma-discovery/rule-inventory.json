      "start_line": 25,
      "text": "  rule largestProperDivisor(N:Int)\n    => firstDivisorAtOrBelow(N, N -Int 1)"
    },
    {
      "attributes": [],
      "end_line": 29,
      "module": "VERIFICATION",
