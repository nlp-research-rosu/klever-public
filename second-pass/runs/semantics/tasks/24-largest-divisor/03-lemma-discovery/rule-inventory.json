      "start_line": 9,
      "text": "  rule largestDivisorBody()\n    => Expr(Str(\"Return the largest positive divisor of n that is smaller than n.\"))\n       Assign(Name(\"divisor\"), BinOp(\"-\", Name(\"n\"), Int(1)))\n       While(\n         Compare(\n           BinOp(\"%\", Name(\"n\"), Name(\"divisor\")),\n           CmpOp(\"!=\", Int(0))),\n         AugAssign(Name(\"divisor\"), \"-\", Int(1)))\n       Return(Name(\"divisor\"))"
    },
