diff --git a//tmp/audit-work/lean-proc-pid-shim.c b//tmp/audit-work/lean-proc-pid-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..78679ace1cfbbacad5ff8e86a11f46a3f51b15f8
--- /dev/null
+++ b//tmp/audit-work/lean-proc-pid-shim.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+#include <limits.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+    char target[64];
+    ssize_t count = readlink("/proc/self", target, sizeof(target) - 1);
+    if (count > 0 && count < (ssize_t)sizeof(target)) {
+        long value = 0;
+        target[count] = '\0';
+        for (ssize_t i = 0; i < count; ++i) {
+            if (target[i] < '0' || target[i] > '9') {
+                value = -1;
+                break;
+            }
+            value = value * 10 + (target[i] - '0');
+            if (value > INT_MAX) {
+                value = -1;
+                break;
+            }
+        }
+        if (value > 0) {
+            return (pid_t)value;
+        }
+    }
+    return (pid_t)syscall(SYS_getpid);
+}

