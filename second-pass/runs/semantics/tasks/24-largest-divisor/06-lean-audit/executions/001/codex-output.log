+import Proof
+
+namespace AuditAdversarial
+
+def k1 : SortKItem := .inj_SortInt 1
+def k2 : SortKItem := .inj_SortInt 2
+def v1 : SortKItem := .inj_SortInt 10
+def v2 : SortKItem := .inj_SortInt 20
+def m1 : SortMap := ⟨[(k1, v1)]⟩
+def m2 : SortMap := ⟨[(k2, v2)]⟩
+
+def firstKeyIs (key : SortKItem) (map : SortMap) : SortBool :=
+  match map.coll with
+  | [] => false
+  | entry :: _ => Proof.sameMapKey key entry.1
+
+#eval firstKeyIs k1 (Proof._Map_ m1 m2)
+#eval firstKeyIs k1 (Proof._Map_ m2 m1)
+
+example : Proof._Map_ m1 m2 ≠ Proof._Map_ m2 m1 := by
+  simp [Proof._Map_, m1, m2, k1, k2, v1, v2]
+
+def boolKey : SortKItem := .inj_SortBool true
+def boolMap : SortMap := ⟨[(boolKey, v1)]⟩
+
+#eval Proof.«_in_keys(_)_MAP_Bool_KItem_Map» boolKey boolMap
+#eval (Proof.«_[_<-undef]» boolMap boolKey).coll.length
+
+example :
+    Proof.«_in_keys(_)_MAP_Bool_KItem_Map» boolKey boolMap = false := by
+  rfl
+
+example : (Proof.«_[_<-undef]» boolMap boolKey).coll.length = 1 := by
+  rfl
+
+def nonsenseMap (_left right : SortMap) : SortMap := right
+def nonsenseInKeys (_key : SortKItem) (_map : SortMap) : SortBool := true
+def nonsenseDelete (map : SortMap) (_key : SortKItem) : SortMap := map
+def nonsenseElement (_key _value : SortKItem) : SortMap := ⟨[]⟩
+def nonsenseNot (_value : SortBool) : SortBool := false
+
+theorem targetIsVacuous :
+    Klean24LargestDivisor.Lemmas.targetStatement
+      nonsenseMap nonsenseInKeys nonsenseDelete nonsenseElement nonsenseNot := by
+  unfold Klean24LargestDivisor.Lemmas.targetStatement
+  intro _SC impossibleScope _h
+  exact nomatch impossibleScope
+
+end AuditAdversarial
