===== /reference/canonical.py =====
     1	# canonical.py — the UNMODIFIED HumanEval/24 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: largest_divisor
     4	
     5	
     6	
     7	def largest_divisor(n: int) -> int:
     8	    """ For a given number n, find the largest number that divides n evenly, smaller than n
     9	    >>> largest_divisor(15)
    10	    5
    11	    """
    12	    for i in reversed(range(n)):
    13	        if n % i == 0:
    14	            return i

