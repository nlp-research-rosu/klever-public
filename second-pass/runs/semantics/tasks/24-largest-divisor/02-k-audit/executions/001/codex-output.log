+#!/usr/bin/env bash
+set -u
+
+export PATH="/home/agent/.nix-profile/bin:$PATH"
+
+echo '$ python3 /audit-output/evidence/stage4_witnesses.py'
+python3 /audit-output/evidence/stage4_witnesses.py
+witness_rc=$?
