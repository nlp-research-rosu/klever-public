===== /candidate/solution.py =====
     1	def largest_divisor(n: int) -> int:
     2	    """Return the largest positive divisor of n that is smaller than n."""
     3	    divisor = n - 1
     4	    while n % divisor != 0:
     5	        divisor -= 1
     6	    return divisor

