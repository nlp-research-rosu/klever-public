     3	module LOOP-SPEC
     4	  imports VERIFICATION
     5	
     6	  // Loop invariant/circularity: D is a positive candidate below N.  The
     7	  // semantics and reference scan both either return D when it divides N or
     8	  // continue with D - 1.  At D = 1 the non-divisor branch is impossible.
     9	  claim
    10	    <k>
    11	      #while(
    12	        Compare(
    13	          BinOp("%", Name("n"), Name("divisor")),
    14	          CmpOp("!=", Int(0))),
    15	        AugAssign(Name("divisor"), "-", Int(1)))
    16	      ~> Return(Name("divisor")) .Stmts
    17	      ~> #endcall
    18	      => firstDivisorAtOrBelow(N, D) ~> .K
    19	    </k>
    20	    <env> 1 => 0 </env>
    21	    <scopes>
    22	      SC:Map
    23	      1 |-> scope(
    24	        "n" |-> N
    25	        "divisor" |-> D,
    26	        parent(0))
    27	      =>
    28	      SC
    29	    </scopes>
    30	    <scopeLoc> 2 => 1 </scopeLoc>
    31	    <heap> .Map </heap>
    32	    <heapLoc> 0 </heapLoc>
    33	    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
    34	    <ret> noRet </ret>
    35	    <exc> NoExc </exc>
    36	    <exit-code> 0 </exit-code>
    37	    requires N >Int 1 andBool D >=Int 1 andBool D <Int N
    38	    [label(loopCorrect)]
    39	endmodule
