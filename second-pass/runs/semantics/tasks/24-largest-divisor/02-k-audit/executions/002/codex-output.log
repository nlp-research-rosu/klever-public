+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  "$@"
+  command_status=$?
+  printf 'EXIT_STATUS: %d\n' "$command_status"
+  exit "$command_status"
+} 2>&1 | tee "$log_path"
+
+exit "${PIPESTATUS[0]}"

