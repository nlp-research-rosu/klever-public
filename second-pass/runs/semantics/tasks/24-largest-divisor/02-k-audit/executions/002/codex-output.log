     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // The exact statement body emitted in solution.mpy.  Naming it keeps the
     7	  // reachability claims readable; this equation is only syntactic sharing.
     8	  syntax Stmts ::= largestDivisorBody() [function]
     9	  rule largestDivisorBody()
    10	    => Expr(Str("Return the largest positive divisor of n that is smaller than n."))
    11	       Assign(Name("divisor"), BinOp("-", Name("n"), Int(1)))
    12	       While(
    13	         Compare(
    14	           BinOp("%", Name("n"), Name("divisor")),
    15	           CmpOp("!=", Int(0))),
    16	         AugAssign(Name("divisor"), "-", Int(1)))
    17	       Return(Name("divisor"))
    18	
    19	  // Mathematical reference result: scan the positive candidates strictly
    20	  // below N in descending order and select the first divisor.  Thus the
    21	  // result divides N, is below N, and no larger candidate below N divides N.
    22	  syntax Int ::= largestProperDivisor(Int) [function]
    23	               | firstDivisorAtOrBelow(Int, Int) [function]
    24	
    25	  rule largestProperDivisor(N:Int)
    26	    => firstDivisorAtOrBelow(N, N -Int 1)
    27	
    28	  rule firstDivisorAtOrBelow(N:Int, D:Int) => D
    29	    requires D >Int 0 andBool pyMod(N, D) ==Int 0
    30	
    31	  rule firstDivisorAtOrBelow(N:Int, D:Int)
    32	    => firstDivisorAtOrBelow(N, D -Int 1)
    33	    requires D >Int 1 andBool pyMod(N, D) =/=Int 0
    34	
    35	  // The symbolic Map backend leaves deletion of a symbolic frame as an
    36	  // update term.  This extensional simplification is the Map fact used by
    37	  // #pop: deleting the fresh key 1 restores the untouched remainder.
    38	  rule
    39	    (1 |-> _S:Scope SC:Map) [1 <- undef] => SC
    40	    requires notBool 1 in_keys(SC)
    41	    [simplification, label(deleteFreshFrame)]
    42	endmodule
