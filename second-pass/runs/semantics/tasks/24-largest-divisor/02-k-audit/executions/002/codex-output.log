+++ b/evidence/body-mutation-spec.k
@@ -0,0 +1,61 @@
+requires "spec.k"
+
+module BODY-MUTATION-SPEC
+  imports LOOP-SPEC
+
+  // Operational-sensitivity probe: the submitted return is changed from
+  // `divisor` to `divisor + 1`, while the expected result for n=15 stays 5.
+  // The real mutated body must execute and produce 6.
+  claim
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "largest_divisor",
+            Params("n"),
+            Expr(
+              Str(
+                "Return the largest positive divisor of n that is smaller than n."))
+            Assign(Name("divisor"), BinOp("-", Name("n"), Int(1)))
+            While(
+              Compare(
+                BinOp("%", Name("n"), Name("divisor")),
+                CmpOp("!=", Int(0))),
+              AugAssign(Name("divisor"), "-", Int(1)))
+            Return(BinOp("+", Name("divisor"), Int(1))))))
+      ~> Call(Name("largest_divisor"), Int(15))
+      =>
+      5 ~> .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "largest_divisor" |->
+          closureVal(
+            "n",
+            Expr(
+              Str(
+                "Return the largest positive divisor of n that is smaller than n."))
+            Assign(Name("divisor"), BinOp("-", Name("n"), Int(1)))
+            While(
+              Compare(
+                BinOp("%", Name("n"), Name("divisor")),
+                CmpOp("!=", Int(0))),
+              AugAssign(Name("divisor"), "-", Int(1)))
+            Return(BinOp("+", Name("divisor"), Int(1))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(mutatedBodyMustNotProveOriginalResult)]
+endmodule
diff --git a/evidence/concrete_k_tests.py b/evidence/concrete_k_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..54817cf0fdf075dfaf2aee58d316d605e2787a3a
--- /dev/null
+++ b/evidence/concrete_k_tests.py
@@ -0,0 +1,19 @@
+def largest_divisor(n: int) -> int:
+    """Return the largest positive divisor of n that is smaller than n."""
+    divisor = n - 1
+    while n % divisor != 0:
+        divisor -= 1
+    return divisor
+
+
+assert largest_divisor(2) == 1
+assert largest_divisor(3) == 1
+assert largest_divisor(4) == 2
+assert largest_divisor(5) == 1
+assert largest_divisor(6) == 3
+assert largest_divisor(10) == 5
+assert largest_divisor(15) == 5
+assert largest_divisor(25) == 5
+assert largest_divisor(49) == 7
+assert largest_divisor(100) == 50
+assert largest_divisor(101) == 1
