+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  "$@"
+  command_status=$?
+  printf 'EXIT_STATUS: %d\n' "$command_status"
+  exit "$command_status"
+} 2>&1 | tee "$log_path"
+
+exit "${PIPESTATUS[0]}"

