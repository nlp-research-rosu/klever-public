Module(
  FuncDef("check_dict_case", Params("dict"),
    Assign(Name("has_key"), Bool(false))
    Assign(Name("all_lower"), Bool(true))
    Assign(Name("all_upper"), Bool(true))
    Assign(Name("key"), NoneVal)
    For(Name("key"), Call(Attribute(Name("dict"), "keys"), ),
      Assign(Name("has_key"), Bool(true))
      If(UnaryOp("not", Call(Name("isinstance"), Name("key"), Name("str"))),
        Assign(Name("all_lower"), Bool(false))
        Assign(Name("all_upper"), Bool(false)),
        If(UnaryOp("not", Call(Attribute(Name("key"), "islower"), )),
          Assign(Name("all_lower"), Bool(false)),
          )
        If(UnaryOp("not", Call(Attribute(Name("key"), "isupper"), )),
          Assign(Name("all_upper"), Bool(false)),
          )))
    Return(
      BoolOp(
        "and",
        Name("has_key"),
        BoolOp("or", Name("all_lower"), Name("all_upper")))))
  Assert(
    Compare(
      Call(
        Name("check_dict_case"),
        DictExpr(
          Entry(Str("a"), Str("apple")),
          Entry(Str("b"), Str("banana")))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("check_dict_case"),
        DictExpr(
          Entry(Str("a"), Str("apple")),
          Entry(Str("A"), Str("banana")),
          Entry(Str("B"), Str("banana")))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("check_dict_case"),
        DictExpr(
          Entry(Str("a"), Str("apple")),
          Entry(Int(8), Str("banana")))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("check_dict_case"),
        DictExpr(
          Entry(Str("Name"), Str("John")),
          Entry(Str("Age"), Str("36")),
          Entry(Str("City"), Str("Houston")))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("check_dict_case"),
        DictExpr(
          Entry(Str("STATE"), Str("NC")),
          Entry(Str("ZIP"), Str("12345")))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("check_dict_case"), DictExpr()),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("check_dict_case"),
        DictExpr(Entry(Str("123"), Str("digits")))),
      CmpOp("==", Bool(false)))))
