+         ~> Call(Name("check_dict_case"),
+                 (dictV(KS:ValSeq, VS:ValSeq), .Exprs))
+        =>
+         #loop(list(KS), Name("key"), checkDictLoopBody())
+         ~> (Return(checkDictResultExpr()) .Stmts)
+         ~> #endcall
+    </k>
+    <env> 0 => 1 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
