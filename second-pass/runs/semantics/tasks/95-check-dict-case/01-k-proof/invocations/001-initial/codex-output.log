+def check_dict_case(dict):
+    has_key = False
+    all_lower = True
+    all_upper = True
+
+    for key in dict.keys():
+        has_key = True
+        if not isinstance(key, str):
+            all_lower = False
+            all_upper = False
+        else:
+            if not key.islower():
