+def check_dict_case(dict):
+    has_key = False
+    all_lower = True
+    all_upper = True
+
+    for key in dict.keys():
+        has_key = True
+        if not isinstance(key, str):
+            return False
+        if not key.islower():
+            all_lower = False
+        if not key.isupper():
+            all_upper = False
+
+    return has_key and (all_lower or all_upper)

