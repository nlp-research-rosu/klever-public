+               "check_dict_case"
+                 |-> closureVal(("dict", .ParamNames), checkDictBody(), 0),
+               parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+               "dict"      |-> dictV(KS, VS)
+               "has_key"   |-> false
+               "all_lower" |-> true
+               "all_upper" |-> true,
+               parent(0))
