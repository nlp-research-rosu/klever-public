+  rule <k> #applyK(toCall(boundMethodV(V:Val, "islower")), .Vals)
+        => true ... </k>
+       requires stringCaseKey(V) andBool lowerCaseKey(V)
+       [priority(30)]
+  rule <k> #applyK(toCall(boundMethodV(V:Val, "islower")), .Vals)
