diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..466e2ed16ae744d844968efd2c03e0b3c98322f5
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,17 @@
+def check_dict_case(dict):
+    has_key = False
+    all_lower = True
+    all_upper = True
+
+    for key in dict.keys():
+        has_key = True
+        if not isinstance(key, str):
+            all_lower = False
+            all_upper = False
+        else:
+            if not key.islower():
+                all_lower = False
+            if not key.isupper():
+                all_upper = False
+
+    return has_key and (all_lower or all_upper)
