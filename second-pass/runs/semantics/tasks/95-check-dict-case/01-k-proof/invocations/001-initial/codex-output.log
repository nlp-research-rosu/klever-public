+               parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+               "dict"      |-> dictV(KS, VS)
+               "has_key"   |-> false
+               "all_lower" |-> true
+               "all_upper" |-> true,
+               parent(0))
+    </scopes>
+    <scopeLoc> 1 => 2 </scopeLoc>
+    <heap> .Map => 0 |-> list(KS) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack>
