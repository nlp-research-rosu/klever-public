/bin/bash -lc "sed -n '1,180p' reference-semantics/semantics/functions.k && sed -n '1,180p' reference-semantics/semantics/call.k && sed -n '1,120p' reference-semantics/semantics/operators.k && sed -n '1,120p' reference-semantics/semantics/bool.k && sed -n '1,80p' reference-semantics/semantics/iter.k && sed -n '1,150p' reference-semantics/semantics/list.k && sed -n '1,120p' reference-semantics/semantics/str.k" in /work
