     7	    """
     8	    Given a dictionary, return True if all keys are strings in lower 
     9	    case or all keys are strings in upper case, else return False.
    10	    The function should return False is the given dictionary is empty.
    11	    Examples:
    12	    check_dict_case({"a":"apple", "b":"banana"}) should return True.
    13	    check_dict_case({"a":"apple", "A":"banana", "B":"banana"}) should return False.
    14	    check_dict_case({"a":"apple", 8:"banana", "a":"apple"}) should return False.
    15	    check_dict_case({"Name":"John", "Age":"36", "City":"Houston"}) should return False.
    16	    check_dict_case({"STATE":"NC", "ZIP":"12345" }) should return True.
    17	    """
    18	    if len(dict.keys()) == 0:
    19	        return False
    20	    else:
    21	        state = "start"
    22	        for key in dict.keys():
    23	
    24	            if isinstance(key, str) == False:
    25	                state = "mixed"
    26	                break
    27	            if state == "start":
    28	                if key.isupper():
    29	                    state = "upper"
    30	                elif key.islower():
    31	                    state = "lower"
    32	                else:
    33	                    break
    34	            elif (state == "upper" and not key.isupper()) or (state == "lower" and not key.islower()):
    35	                    state = "mixed"
    36	                    break
    37	            else:
    38	                break
    39	        return state == "upper" or state == "lower" 
