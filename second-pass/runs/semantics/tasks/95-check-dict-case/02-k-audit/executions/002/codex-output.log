diff --git a/evidence/ref-loop-extended-spec.k b/evidence/ref-loop-extended-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..280a0f4af4be0b97e65899d4d8a366083ab93e69
--- /dev/null
+++ b/evidence/ref-loop-extended-spec.k
@@ -0,0 +1,44 @@
+requires "verification.k"
+
+module REF-LOOP-EXTENDED-SPEC
+  imports CHECK-DICT-CASE-VERIFICATION
+
+  // Same ground precondition. The candidate's priority(30) splitter preempts
+  // dereference, so its extended semantics returns false.
+  claim [loop-ref-to-string]:
+    <k> #loop(list(vCons(ref(0), .ValSeq)),
+              Name("key"), checkDictLoopBody())
+         ~> (Return(checkDictResultExpr()) .Stmts)
+         ~> #endcall
+      => false
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(
+             "check_dict_case"
+               |-> closureVal(("dict", .ParamNames), checkDictBody(), 0),
+             parent(-1))
