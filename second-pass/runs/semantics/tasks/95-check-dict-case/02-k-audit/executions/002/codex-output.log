@@ -0,0 +1,25 @@
+requires "verification-no-bridges.k"
+
+module REF-DEREFERENCE-FIXED-SPEC
+  imports CHECK-DICT-CASE-VERIFICATION
+
+  // Under the fixed call layer, the priority(40) builtin-argument rule reads
+  // heap object 0 before dispatching isinstance, so the result is true.
+  claim [ref-to-string-isinstance]:
+    <k> #applyK(toCall(builtinV("isinstance")),
+                 (ref(0), typeV("str"), .Vals))
+      => true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> 0 |-> str(iCons(97, .IntSeq)) </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/ref-loop-extended-spec.k b/evidence/ref-loop-extended-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..280a0f4af4be0b97e65899d4d8a366083ab93e69
--- /dev/null
+++ b/evidence/ref-loop-extended-spec.k
@@ -0,0 +1,44 @@
+requires "verification.k"
+
+module REF-LOOP-EXTENDED-SPEC
+  imports CHECK-DICT-CASE-VERIFICATION
+
+  // Same ground precondition. The candidate's priority(30) splitter preempts
+  // dereference, so its extended semantics returns false.
+  claim [loop-ref-to-string]:
+    <k> #loop(list(vCons(ref(0), .ValSeq)),
+              Name("key"), checkDictLoopBody())
+         ~> (Return(checkDictResultExpr()) .Stmts)
+         ~> #endcall
+      => false
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(
+             "check_dict_case"
+               |-> closureVal(("dict", .ParamNames), checkDictBody(), 0),
+             parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+             "has_key"   |-> false
+             "all_lower" |-> true
+             "all_upper" |-> true
+             "dict"      |-> dictV(vCons(ref(0), .ValSeq),
+                                    vCons(0, .ValSeq))
+             "key"       |-> noneV,
+             parent(0))
+      =>
+      0 |-> scope(
+             "check_dict_case"
+               |-> closureVal(("dict", .ParamNames), checkDictBody(), 0),
+             parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> 0 |-> str(iCons(97, .IntSeq)) </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/ref-loop-fixed-spec.k b/evidence/ref-loop-fixed-spec.k
