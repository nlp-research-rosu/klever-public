+      -1 |-> builtinsScope
+      1 |-> scope(
+             "has_key"   |-> SEEN:Bool
+             "all_lower" |-> LOWER:Bool
+             "all_upper" |-> UPPER:Bool
+             "dict"      |-> DICT:Val
+             "key"       |-> OLDKEY:Val,
+             parent(0))
+      =>
