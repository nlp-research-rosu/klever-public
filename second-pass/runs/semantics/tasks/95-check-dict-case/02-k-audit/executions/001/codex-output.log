+    ("late_mixed_after_two_lower", {"a": 0, "b": 0, "A": 0}),
+    ("late_nonstr_after_two_lower", {"a": 0, "b": 0, 7: 0}),
+    ("late_mixed_after_two_upper", {"A": 0, "B": 0, "a": 0}),
+    ("unicode_lower", {"é": 0}),
+    ("unicode_upper", {"É": 0}),
+]
+
