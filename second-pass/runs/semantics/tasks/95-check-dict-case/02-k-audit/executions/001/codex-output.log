+    <scopes>
+      0  |-> scope(
+               "check_dict_case"
+                 |-> closureVal(("dict", .ParamNames), checkDictBody(), 0),
+               parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+               "has_key"   |-> SEEN:Bool
+               "all_lower" |-> LOWER:Bool
+               "all_upper" |-> UPPER:Bool
+               "dict"      |-> DICT:Val
+               "key"       |-> OLDKEY:Val,
+               parent(0))
+      =>
+      0  |-> scope(
+               "check_dict_case"
+                 |-> closureVal(("dict", .ParamNames), checkDictBody(), 0),
+               parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXTHEAP:Int </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
