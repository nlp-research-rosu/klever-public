new file mode 100644
index 0000000000000000000000000000000000000000..0367bbfb46c656dac5bea20506d5586279b5f09a
--- /dev/null
+++ b/evidence/rule_inventory.py
@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+"""Emit a line-addressable inventory of candidate-local and supplied K items."""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+ROOTS = [
+    Path("/tmp/audit-work/src/reference-semantics/semantics.k"),
+    *sorted(Path("/tmp/audit-work/src/reference-semantics/semantics").glob("*.k")),
+    Path("/tmp/audit-work/src/verification.k"),
+    Path("/tmp/audit-work/src/spec.k"),
+]
+
+START = re.compile(
+    r"^\s*(configuration|context|syntax|rule|claim|alias|macro)\b"
+)
+CONTINUATION = re.compile(r"^\s*(\||\[\s*(?:function|total|functional|"
+                          r"simplification|concrete|priority|owise|macro))")
+
+for path in ROOTS:
+    lines = path.read_text(encoding="utf-8").splitlines()
+    print(f"FILE {path}")
+    for number, line in enumerate(lines, 1):
+        if START.search(line) or CONTINUATION.search(line):
+            print(f"{number:04d}: {line.rstrip()}")
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..77b8380750710833bf44f62e1653214dd2209e14
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: run_logged.sh LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+
+exec > >(tee "$audit_log") 2>&1
+
+printf 'WORKDIR: %s\n' "$PWD"
+printf 'COMMAND:'
+printf ' %q' "$@"
+printf '\n'
+
+set +e
+"$@"
+audit_status=$?
+set -e
+
+printf 'EXIT_STATUS: %d\n' "$audit_status"
+exit "$audit_status"

codex
The regenerated `.mpy` is byte-identical to the submission. An independent 2,599-case differential found no generated-implementation failures against the prompt’s direct predicate, but found 166 disagreements with the trusted canonical: the canonical prematurely stops after the second consistently cased key and can miss a later mixed/non-string key. That canonical defect is now preserved as evidence and will be separated from proof soundness. Next I’m doing fresh LLVM and Haskell builds.
exec
/bin/bash -lc "mkdir -p /tmp/audit-work/build
/audit-output/evidence/run_logged.sh /audit-output/evidence/06-generate-smoke-mpy.log bash -c 'python3 /tmp/audit-work/trusted/py2mpy.py /tmp/audit-work/src/smoke.py > /tmp/audit-work/build/smoke.mpy && sha256sum /tmp/audit-work/build/smoke.mpy'
/audit-output/evidence/run_logged.sh /audit-output/evidence/07-kompile-llvm.log kompile /tmp/audit-work/src/reference-semantics/semantics.k --backend llvm --main-module MPY-KRUN --syntax-module MPY-SYNTAX --output-definition /tmp/audit-work/build/runtime-kompiled" in /tmp/audit-work
