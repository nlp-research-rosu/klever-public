+++ b/evidence/ground_cases.py
@@ -0,0 +1,28 @@
+def check_dict_case(dict):
+    has_key = False
+    all_lower = True
+    all_upper = True
+    key = None
+
+    for key in dict.keys():
+        has_key = True
+        if not isinstance(key, str):
+            all_lower = False
+            all_upper = False
+        else:
+            if not key.islower():
+                all_lower = False
+            if not key.isupper():
+                all_upper = False
+
+    return has_key and (all_lower or all_upper)
+
+
+# Satisfying witnesses for the entry claim, plus branch boundaries.
+assert check_dict_case({}) == False
+assert check_dict_case({"a": 0}) == True
+assert check_dict_case({"A": 0}) == True
+assert check_dict_case({"123": 0}) == False
+assert check_dict_case({7: 0}) == False
+assert check_dict_case({"a": 0, "b": 0, "A": 0}) == False
+assert check_dict_case({"A": 0, "B": 0, "a": 0}) == False
