diff --git a/evidence/rule_inventory.py b/evidence/rule_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..0367bbfb46c656dac5bea20506d5586279b5f09a
--- /dev/null
+++ b/evidence/rule_inventory.py
@@ -0,0 +1,27 @@
+#!/usr/bin/env python3
+"""Emit a line-addressable inventory of candidate-local and supplied K items."""
+
+from __future__ import annotations
+
+import re
+from pathlib import Path
+
+ROOTS = [
+    Path("/tmp/audit-work/src/reference-semantics/semantics.k"),
+    *sorted(Path("/tmp/audit-work/src/reference-semantics/semantics").glob("*.k")),
+    Path("/tmp/audit-work/src/verification.k"),
+    Path("/tmp/audit-work/src/spec.k"),
+]
+
+START = re.compile(
+    r"^\s*(configuration|context|syntax|rule|claim|alias|macro)\b"
+)
+CONTINUATION = re.compile(r"^\s*(\||\[\s*(?:function|total|functional|"
+                          r"simplification|concrete|priority|owise|macro))")
+
+for path in ROOTS:
+    lines = path.read_text(encoding="utf-8").splitlines()
+    print(f"FILE {path}")
+    for number, line in enumerate(lines, 1):
+        if START.search(line) or CONTINUATION.search(line):
+            print(f"{number:04d}: {line.rstrip()}")
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..77b8380750710833bf44f62e1653214dd2209e14
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: run_logged.sh LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+
+exec > >(tee "$audit_log") 2>&1
+
+printf 'WORKDIR: %s\n' "$PWD"
+printf 'COMMAND:'
+printf ' %q' "$@"
+printf '\n'
+
+set +e
+"$@"
+audit_status=$?
+set -e
+
+printf 'EXIT_STATUS: %d\n' "$audit_status"
+exit "$audit_status"
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..e244d5a456e6bdccd77c4b81d5622d9b44b36ec4
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,48 @@
+requires "verification.k"
+
+module CHECK-DICT-CASE-SPEC-VACUITY
+  imports CHECK-DICT-CASE-VERIFICATION
+
+  // Deliberately false mutation: negate the result-constraining loop summary.
+  // Ground counterexample:
+  //   KS=.ValSeq, SEEN=true, LOWER=true, UPPER=false,
+  //   DICT=dictV(.ValSeq,.ValSeq), OLDKEY=noneV, HEAP=.Map, NEXTHEAP=0.
+  // The real execution returns true; this destination requires false.
+  claim [false-loop-result]:
+    <k> #loop(list(KS:ValSeq), Name("key"), checkDictLoopBody())
+         ~> (Return(checkDictResultExpr()) .Stmts)
+         ~> #endcall
+        =>
+         notBool checkDictCaseResult(KS, SEEN, LOWER, UPPER)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0  |-> scope(
+               "check_dict_case"
+                 |-> closureVal(("dict", .ParamNames), checkDictBody(), 0),
+               parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+               "has_key"   |-> SEEN:Bool
+               "all_lower" |-> LOWER:Bool
+               "all_upper" |-> UPPER:Bool
+               "dict"      |-> DICT:Val
+               "key"       |-> OLDKEY:Val,
+               parent(0))
+      =>
+      0  |-> scope(
+               "check_dict_case"
+                 |-> closureVal(("dict", .ParamNames), checkDictBody(), 0),
+               parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXTHEAP:Int </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/unicode_case.py b/evidence/unicode_case.py
new file mode 100644
index 0000000000000000000000000000000000000000..1882d763421af54ffc6bd91572c616f2361ef13c
--- /dev/null
+++ b/evidence/unicode_case.py
@@ -0,0 +1,22 @@
+def check_dict_case(dict):
+    has_key = False
+    all_lower = True
+    all_upper = True
+    key = None
+
+    for key in dict.keys():
+        has_key = True
+        if not isinstance(key, str):
+            all_lower = False
+            all_upper = False
+        else:
+            if not key.islower():
+                all_lower = False
+            if not key.isupper():
+                all_upper = False
+
+    return has_key and (all_lower or all_upper)
+
+
+# CPython classifies this non-ASCII cased string as lower-case.
+assert check_dict_case({"é": 0}) == True

