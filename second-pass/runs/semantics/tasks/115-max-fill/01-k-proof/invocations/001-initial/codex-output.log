+
+  rule <k> #sumAcc(list(rowVals(iCons(I:Int, IS:IntSeq))), A:Int)
+        => #sumAcc(list(rowVals(IS)), A +Int I)
+        ...
+       </k>
+       [priority(40)]
+
+  rule <k> #loop(
+             list(gridVals(.GridRows)),
+             _T:Expr,
+             _B:Stmts)
+        => .K
+        ...
+       </k>
+       [priority(40)]
+
+  rule <k> #loop(
+             list(gridVals(gCons(IS:IntSeq, GS:GridRows))),
+             T:Expr,
+             B:Stmts)
+        => #bindTgt(T, list(rowVals(IS)))
+           ~> B
+           ~> #loopLbl(#loop(list(gridVals(GS)), T, B))
+        ...
+       </k>
