+requires "verification.k"
+
+module MAX-FILL-SPEC
+  imports MAX-FILL-VERIFICATION
+
+  // Auxiliary induction: MPY's iterator-based sum agrees with rowSum.
+  // The step claim exposes an Int head syntactically.  Its recursive use
+  // narrows the tail to either the empty claim or another integer head.
+  claim [sum-empty]:
+    <k> #sumAcc(list(.ValSeq), A:Int) ~> K:K
+     => rowTotal(A, .ValSeq) ~> K
+    </k>
+
+  claim [sum-step]:
+    <k> #sumAcc(
+          list(vCons(I:Int, IS:ValSeq)),
+          A:Int)
+          ~> K:K
+     => rowTotal(A, vCons(I, IS)) ~> K
+    </k>
+    requires intRow(IS)
+
+  // Main loop invariant.  The frame's grid binding is part of M; capacity and
+  // the accumulator are exposed so each iteration updates them symbolically.
+  claim [fill-loop]:
+    <k> #loop(
+          list(GS:ValSeq),
+          Name("row"),
+          MAX_FILL_LOOP_BODY)
+          ~> K:K
+     => K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        M:Map [ "capacity" <- C:Int ] [ "result" <- A:Int ],
+        P:Parent)
+      =>
+      SC
+      L |-> scope(
+        frameRest(GS, M)
+          [ "capacity" <- C ]
+          [ "result" <- A +Int maxFillSpec(GS, C) ],
+        P)
+    </scopes>
+    requires C >Int 0 andBool validGrid(GS)
+
+  // Universal functional correctness of the loaded Python entry point.
+  claim [max-fill-correct]:
+    <k> #runMaxFill(GS:ValSeq, C:Int)
+     => maxFillSpec(GS, C)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
