+requires "reference-semantics/semantics.k"
+
+module MAX-FILL-VERIFICATION
+  imports MPY
+
+  // Input-shape predicates.  validGrid accepts exactly native ValSeq grids
+  // made of integer rows; this includes every prompt-valid 0/1 grid.
+  syntax Bool ::= intRow(ValSeq) [function, total]
+                | validGrid(ValSeq) [function, total]
+
+  rule intRow(.ValSeq)                 => true
+  rule intRow(vCons(_I:Int, R:ValSeq)) => intRow(R)
+  rule intRow(vCons(_V:Val, _R:ValSeq)) => false [owise]
+
+  rule validGrid(.ValSeq) => true
+  rule validGrid(vCons(list(R:ValSeq), GS:ValSeq))
+    => intRow(R) andBool validGrid(GS)
+  rule validGrid(vCons(_V:Val, _GS:ValSeq)) => false [owise]
+
+  // Mathematical contract: sum a row, take ceil(sum / capacity), and add
+  // those bucket counts for all rows.  ceilDiv is written with the same
+  // integer floor-division primitive used by MPY-INT.
+  syntax Int ::= rowSum(ValSeq) [function]
+               | ceilDiv(Int, Int) [function, total]
+               | maxFillSpec(ValSeq, Int) [function]
+
+  rule rowSum(.ValSeq)                 => 0
+  rule rowSum(vCons(I:Int, IS:ValSeq)) => I +Int rowSum(IS)
+
+  rule ceilDiv(N:Int, C:Int)
+    => ((N +Int C -Int 1) -Int pyMod(N +Int C -Int 1, C)) /Int C
+
+  rule maxFillSpec(.ValSeq, _C:Int) => 0
+  rule maxFillSpec(vCons(list(IS:ValSeq), GS:ValSeq), C:Int)
+    => ceilDiv(rowSum(IS), C) +Int maxFillSpec(GS, C)
+
+  // The for-loop leaves Python's last row and water locals in its frame.
+  // Tracking that harmless state makes the loop invariant exact.
+  syntax Map ::= frameRest(ValSeq, Map) [function]
+  rule frameRest(.ValSeq, M:Map) => M
+  rule frameRest(vCons(list(IS:ValSeq), GS:ValSeq), M:Map)
+    => frameRest(
+         GS,
