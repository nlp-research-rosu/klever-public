index 0000000000000000000000000000000000000000..fb12e9e0b5d6f3f3ebe5b5c45c74ab9f10262758
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def max_fill(grid, capacity):
+    result = 0
+    for row in grid:
+        water = sum(row)
+        result += (water + capacity - 1) // capacity
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..37c1dec0ade73201bf78b79a3461dd26eca5b541
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,102 @@
+requires "verification.k"
+
+module MAX-FILL-BRIDGE-SPEC
+  imports MAX-FILL-DATA
+
+  // These finite claims justify every symbolic bridge in
+  // MAX-FILL-BRIDGES directly from the supplied MPY rules.
+  claim [bridge-sum-empty]:
+    <k> #sumAcc(list(rowVals(.IntSeq)), A:Int) ~> K:K
+     => #iterNext(list(.ValSeq)) ~> #sumCont(A) ~> K
+    </k>
+
+  claim [bridge-sum-step]:
+    <k> #sumAcc(
+          list(rowVals(iCons(I:Int, IS:IntSeq))),
+          A:Int)
+          ~> K:K
+     => #iterNext(list(vCons(I, rowVals(IS))))
+        ~> #sumCont(A)
+        ~> K
+    </k>
+
+  claim [bridge-loop-empty]:
+    <k> #loop(
+          list(gridVals(.GridRows)),
+          T:Expr,
+          B:Stmts)
+          ~> K:K
+     => #iterNext(list(.ValSeq))
+        ~> #loopStep(T, B)
+        ~> K
+    </k>
+
+  claim [bridge-loop-step]:
+    <k> #loop(
+          list(gridVals(gCons(IS:IntSeq, GS:GridRows))),
+          T:Expr,
+          B:Stmts)
+          ~> K:K
+     => #iterNext(
+          list(vCons(list(rowVals(IS)), gridVals(GS))))
+        ~> #loopStep(T, B)
+        ~> K
+    </k>
+endmodule
+
+module MAX-FILL-SPEC
+  imports MAX-FILL-VERIFICATION
+
+  // Auxiliary induction: MPY's iterator-based sum agrees with rowSum.
+  claim [sum-fold]:
+    <k> #sumAcc(list(rowVals(IS:IntSeq)), A:Int) ~> K:K
+     => rowTotal(A, rowVals(IS)) ~> K
+    </k>
+
+  // Main loop invariant.  The frame's grid binding is part of M; capacity and
+  // the accumulator are exposed so each iteration updates them symbolically.
+  claim [fill-loop]:
+    <k> #loop(
+          list(gridVals(GS:GridRows)),
+          Name("row"),
+          MAX_FILL_LOOP_BODY)
+          ~> K:K
+     => K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        M:Map [ "capacity" <- C:Int ] [ "result" <- A:Int ],
+        P:Parent)
+      =>
+      SC
+      L |-> scope(
+        frameRest(GS, M)
+          [ "capacity" <- C ]
+          [ "result" <- fillTotal(A, GS, C) ],
+        P)
+    </scopes>
+    requires C >Int 0
+
+  // Universal functional correctness of the loaded Python entry point.
+  claim [max-fill-correct]:
+    <k> #runMaxFill(GS:GridRows, C:Int)
+     => maxFillSpec(GS, C)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires C >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..7b291aef286c63b4683a92de13ebbc31f444cab6
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,132 @@
+requires "reference-semantics/semantics.k"
+
+module MAX-FILL-DATA
+  imports MPY
+
+  // A symbolic grid whose rows contain integers.  This representation includes
+  // every grid allowed by the prompt (whose integers are restricted to 0/1).
+  syntax GridRows ::= ".GridRows"
+                    | gCons(IntSeq, GridRows)
+
+  syntax ValSeq ::= rowVals(IntSeq) [function, total]
+                  | gridVals(GridRows) [function, total]
+
+  rule rowVals(.IntSeq)                 => .ValSeq
+  rule rowVals(iCons(I:Int, IS:IntSeq)) => vCons(I, rowVals(IS))
+
+  rule gridVals(.GridRows) => .ValSeq
+  rule gridVals(gCons(IS:IntSeq, GS:GridRows))
+    => vCons(list(rowVals(IS)), gridVals(GS))
+
+  // Mathematical contract: sum a row, take ceil(sum / capacity), and add
+  // those bucket counts for all rows.  ceilDiv is written with the same
+  // integer floor-division primitive used by MPY-INT.
+  syntax Int ::= rowSum(IntSeq) [function, total]
+               | rowTotal(Int, ValSeq) [function]
+               | ceilDiv(Int, Int) [function, total]
+               | fillTotal(Int, GridRows, Int) [function, total]
+               | maxFillSpec(GridRows, Int) [function, total]
+
+  rule rowSum(IS:IntSeq) => rowTotal(0, rowVals(IS))
+  rule rowTotal(A:Int, .ValSeq) => A
+  rule rowTotal(A:Int, vCons(I:Int, IS:ValSeq))
+    => rowTotal(A +Int I, IS)
+
+  rule ceilDiv(N:Int, C:Int)
+    => ((N +Int C -Int 1) -Int pyMod(N +Int C -Int 1, C)) /Int C
+
+  rule fillTotal(A:Int, .GridRows, _C:Int) => A
+  rule fillTotal(A:Int, gCons(IS:IntSeq, GS:GridRows), C:Int)
+    => fillTotal(A +Int ceilDiv(rowSum(IS), C), GS, C)
+  rule maxFillSpec(GS:GridRows, C:Int) => fillTotal(0, GS, C)
+
+  // The for-loop leaves Python's last row and water locals in its frame.
+  // Tracking that harmless state makes the loop invariant exact.
+  syntax Map ::= frameRest(GridRows, Map) [function, total]
+  rule frameRest(.GridRows, M:Map) => M
+  rule frameRest(gCons(IS:IntSeq, GS:GridRows), M:Map)
+    => frameRest(
+         GS,
+         M [ "row" <- list(rowVals(IS)) ]
+           [ "water" <- rowSum(IS) ])
+
+  // Exact translated loop body from solution.mpy.
+  syntax Stmts ::= "MAX_FILL_LOOP_BODY" [macro]
+  rule MAX_FILL_LOOP_BODY
+    => Assign(Name("water"), Call(Name("sum"), Name("row")))
+       AugAssign(
+         Name("result"),
+         "+",
+         BinOp(
+           "//",
+           BinOp(
+             "-",
+             BinOp("+", Name("water"), Name("capacity")),
+             Int(1)),
+           Name("capacity")))
+       .Stmts
+
+endmodule
+
+// One-step symbolic bridges for the typed constructor representation above.
+// Each bridge is separately proved against MAX-FILL-DATA (which imports only
+// MPY) before this module is used by the unbounded proof.
+module MAX-FILL-BRIDGES
+  imports MAX-FILL-DATA
+
+  rule <k> #sumAcc(list(rowVals(.IntSeq)), A:Int)
+       => #iterNext(list(.ValSeq)) ~> #sumCont(A)
+        ...
+       </k>
+       [priority(40), simplification]
+
+  rule <k> #sumAcc(list(rowVals(iCons(I:Int, IS:IntSeq))), A:Int)
+        => #iterNext(list(vCons(I, rowVals(IS)))) ~> #sumCont(A)
+        ...
+       </k>
+       [priority(40), simplification]
+
+  rule <k> #loop(
+             list(gridVals(.GridRows)),
+             T:Expr,
+             B:Stmts)
+        => #iterNext(list(.ValSeq)) ~> #loopStep(T, B)
+        ...
+       </k>
+       [priority(40), simplification]
+
+  rule <k> #loop(
+             list(gridVals(gCons(IS:IntSeq, GS:GridRows))),
+             T:Expr,
+             B:Stmts)
+        => #iterNext(
+             list(vCons(list(rowVals(IS)), gridVals(GS))))
+           ~> #loopStep(T, B)
+        ...
+       </k>
+       [priority(40), simplification]
+endmodule
+
+module MAX-FILL-VERIFICATION
+  imports MAX-FILL-BRIDGES
+
+  // A closed driver that loads and invokes the exact translated entry point.
+  // Keeping the AST here makes the reachability claim execute the program
+  // itself rather than a hand-written summary of it.
+  syntax KItem ::= #runMaxFill(GridRows, Int)
+  rule <k> #runMaxFill(GS:GridRows, C:Int)
+        => #loadAll(
+             Module(
+               FuncDef(
+                 "max_fill",
+                 Params("grid", "capacity"),
+                 Assign(Name("result"), Int(0))
+                 For(
+                   Name("row"),
+                   Name("grid"),
+                   MAX_FILL_LOOP_BODY)
+                 Return(Name("result")))))
+           ~> Call(Name("max_fill"), list(gridVals(GS)), C)
+           ...
+       </k>
+endmodule

