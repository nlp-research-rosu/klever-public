+            {
+                "label": label,
+                "grid": grid,
+                "capacity": capacity,
+                "trusted": trusted,
+                "generated": generated,
+                "expected": expected,
+            }
+        )
+        if len(mismatches) >= 20:
+            break
+
+print(f"total_cases={len(tests)}")
+print(f"category_counts={label_counts}")
+print(f"mismatch_count={len(mismatches)}")
+for mismatch in mismatches:
+    print(f"MISMATCH {mismatch}")
+
+assert not mismatches
