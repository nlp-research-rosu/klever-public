+        )
+        if not ok:
+            failures.append(f"generation evidence mismatch: {rel}")
+
+    for path in [
+        Path("/candidate"),
+        Path("/reference/reference-semantics"),
+        Path("/generation-evidence"),
+    ]:
+        links = [p for p in path.rglob("*") if p.is_symlink()]
+        print(f"symlinks under {path}: {[str(p) for p in links]}")
+        if links:
