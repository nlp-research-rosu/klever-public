diff --git a/evidence/spec-ground-witness.k b/evidence/spec-ground-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..00908ee1179a995fe731424ea09260af8296e59c
--- /dev/null
+++ b/evidence/spec-ground-witness.k
@@ -0,0 +1,25 @@
+requires "spec.k"
+
+module SPEC-GROUND-WITNESS
+  imports MAX-FILL-VERIFICATION
+
+  // Realizable contract input: grid [[1]], capacity 2. Python returns 1.
+  claim [one-cell-capacity-two]:
+    <k> #runMaxFill(gCons(iCons(1, .IntSeq), .GridRows), 2)
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
