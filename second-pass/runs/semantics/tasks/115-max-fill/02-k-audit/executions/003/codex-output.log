+    )
+    if missing or additional or changed:
+        failures.append("candidate semantics tree differs from trusted tree")
+
+    prompt_equal = Path("/candidate/prompt.py").read_bytes() == Path(
+        "/reference/prompt.py"
+    ).read_bytes()
