diff --git a/evidence/05_fixed_representation.k b/evidence/05_fixed_representation.k
new file mode 100644
index 0000000000000000000000000000000000000000..d6b9b2686275757fbca5bac3ea9ea36112e27463
--- /dev/null
+++ b/evidence/05_fixed_representation.k
@@ -0,0 +1,99 @@
+requires "verification.k"
+
+// Independent validation module: no MAX-FILL-BRIDGES import.  It runs the
+// same submitted AST on the ordinary rowVals/gridVals representation that is
+// reduced solely by MAX-FILL-DATA plus the supplied MPY semantics.
+module MAX-FILL-FIXED-REPRESENTATION
+  imports MAX-FILL-DATA
+
+  syntax Val ::= fixedFinalRow(GridRows, Val) [function, total]
+  syntax Int ::= fixedFinalWater(GridRows, Int) [function, total]
+
+  rule fixedFinalRow(.GridRows, V:Val) => V
+  rule fixedFinalRow(gCons(IS:IntSeq, GS:GridRows), _V:Val)
+    => fixedFinalRow(GS, list(rowVals(IS)))
+
+  rule fixedFinalWater(.GridRows, W:Int) => W
+  rule fixedFinalWater(gCons(IS:IntSeq, GS:GridRows), _W:Int)
+    => fixedFinalWater(GS, rowSum(IS))
+
+  syntax KItem ::= #runMaxFillFixed(GridRows, Int)
+  rule <k> #runMaxFillFixed(GS:GridRows, C:Int)
+        => #loadAll(
+             Module(
+               FuncDef(
+                 "max_fill",
+                 Params("grid", "capacity"),
+                 Assign(Name("result"), Int(0))
+                 Assign(Name("row"), Int(0))
+                 Assign(Name("water"), Int(0))
+                 For(
+                   Name("row"),
+                   Name("grid"),
+                   MAX_FILL_LOOP_BODY)
+                 Return(Name("result")))))
+           ~> Call(Name("max_fill"), list(gridVals(GS)), C)
+           ...
+       </k>
+endmodule
+
+module MAX-FILL-FIXED-REPRESENTATION-SPEC
+  imports MAX-FILL-FIXED-REPRESENTATION
+
+  claim [fixed-sum-fold]:
+    <k> #sumAcc(list(rowVals(IS:IntSeq)), A:Int) ~> K:K
+     => rowTotal(A, IS) ~> K
+    </k>
+
+  claim [fixed-fill-loop]:
+    <k> #loop(
+          list(gridVals(GS:GridRows)),
+          Name("row"),
+          MAX_FILL_LOOP_BODY)
+          ~> K:K
+     => K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope("max_fill" |-> F:Val, parent(-1))
+      1 |-> scope(
+        "grid" |-> list(gridVals(INPUT:GridRows))
+        "capacity" |-> C:Int
+        "result" |-> A:Int
+        "row" |-> RV:Val
+        "water" |-> W:Int,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope("max_fill" |-> F, parent(-1))
+      1 |-> scope(
+        "grid" |-> list(gridVals(INPUT))
+        "capacity" |-> C
+        "result" |-> fillTotal(A, GS, C)
+        "row" |-> fixedFinalRow(GS, RV)
+        "water" |-> fixedFinalWater(GS, W),
+        parent(0))
+    </scopes>
+    requires C >Int 0
+
+  claim [fixed-max-fill-correct]:
+    <k> #runMaxFillFixed(GS:GridRows, C:Int)
+     => maxFillSpec(GS, C)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires C >Int 0
+endmodule
diff --git a/evidence/05_fixed_representation.sh b/evidence/05_fixed_representation.sh
new file mode 100644
index 0000000000000000000000000000000000000000..40fd2da059033debef4a1ae34d7bcd1d14937cf6
--- /dev/null
+++ b/evidence/05_fixed_representation.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+set -u
+set -o pipefail
+
+WORK=/tmp/audit-work/115-max-fill
+SOURCE=/audit-output/evidence/05_fixed_representation.k
+DEF="$WORK/fixed-representation-kompiled"
+overall=0
+
+run() {
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf 'EXIT_STATUS: %s\n\n' "$status"
+  if [[ "$status" -ne 0 ]]; then
+    overall=1
+  fi
+  return 0
+}
+
+cd "$WORK" || exit 125
+run timeout 600s kompile "$SOURCE" \
+  -I "$WORK" \
+  --backend haskell \
+  --main-module MAX-FILL-FIXED-REPRESENTATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition "$DEF"
+run timeout 600s kprove "$SOURCE" \
+  -I "$WORK" \
+  --definition "$DEF" \
+  --spec-module MAX-FILL-FIXED-REPRESENTATION-SPEC
+exit "$overall"
diff --git a/evidence/06_false_postcondition.k b/evidence/06_false_postcondition.k
new file mode 100644
index 0000000000000000000000000000000000000000..fb1ba11561e221596e886477e3f9e1d4dc159518
--- /dev/null
+++ b/evidence/06_false_postcondition.k
@@ -0,0 +1,64 @@
+requires "verification.k"
+
+module MAX-FILL-SPEC-VACUITY
+  imports MAX-FILL-VERIFICATION
+
+  claim [sum-fold-vacuity]:
+    <k> #sumAcc(list(symRow(IS:IntSeq)), A:Int) ~> K:K
+     => rowTotal(A, IS) ~> K
+    </k>
+
+  claim [fill-loop-vacuity]:
+    <k> #loop(
+          list(symGrid(GS:GridRows)),
+          Name("row"),
+          MAX_FILL_LOOP_BODY)
+          ~> K:K
+     => K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope("max_fill" |-> F:Val, parent(-1))
+      1 |-> scope(
+        "grid" |-> list(symGrid(INPUT:GridRows))
+        "capacity" |-> C:Int
+        "result" |-> A:Int
+        "row" |-> RV:Val
+        "water" |-> W:Int,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope("max_fill" |-> F, parent(-1))
+      1 |-> scope(
+        "grid" |-> list(symGrid(INPUT))
+        "capacity" |-> C
+        "result" |-> fillTotal(A, GS, C)
+        "row" |-> finalRow(GS, RV)
+        "water" |-> finalWater(GS, W),
+        parent(0))
+    </scopes>
+    requires C >Int 0
+
+  // Deliberately false: every legitimate result is required to be one larger.
+  // Satisfying witness: GS=.GridRows, C=1; execution returns 0, destination is 1.
+  claim [max-fill-false-plus-one]:
+    <k> #runMaxFill(GS:GridRows, C:Int)
+     => maxFillSpec(GS, C) +Int 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires C >Int 0
+endmodule
