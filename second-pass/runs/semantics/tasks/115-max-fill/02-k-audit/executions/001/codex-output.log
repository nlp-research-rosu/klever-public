file /candidate/kore-exec.tar.gz
printf 'EXIT_STATUS: %s\\n\\n' \""'$?"
printf '"'%s\\n' 'COMMAND: tar -tzf /candidate/kore-exec.tar.gz'
tar -tzf /candidate/kore-exec.tar.gz
