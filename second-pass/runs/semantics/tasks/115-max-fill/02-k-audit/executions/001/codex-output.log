+
+  claim [ground-empty]:
+    <k> #runMaxFill(.GridRows, 1) => 0 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
