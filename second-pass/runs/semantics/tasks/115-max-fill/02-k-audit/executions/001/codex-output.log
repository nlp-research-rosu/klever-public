+
+cd "$WORK" || exit 125
+
+printf 'COMMAND: timeout 300s kprove %q -I %q --definition verification-kompiled --spec-module MAX-FILL-SPEC-VACUITY --dry-run\n' "$SPEC" "$WORK"
