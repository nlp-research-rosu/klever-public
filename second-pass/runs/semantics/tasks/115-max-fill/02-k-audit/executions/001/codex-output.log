+done
+
+printf '%s\n' '## Each main target with necessary preceding auxiliaries'
+run timeout 300s kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module MAX-FILL-SPEC \
+  --claims MAX-FILL-SPEC.sum-fold
