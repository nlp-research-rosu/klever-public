diff --git a/evidence/03_rebuild_and_positive_proofs.sh b/evidence/03_rebuild_and_positive_proofs.sh
new file mode 100644
index 0000000000000000000000000000000000000000..67936b715dbae28f59e191774370c4ca21014b4c
