+  if [[ "$status" -ne 0 ]]; then
+    overall=1
+  fi
+  return 0
+}
+
+cd "$WORK" || exit 125
+export PATH="$HOME/.nix-profile/bin:$PATH"
+
+printf '%s\n' '## Every bridge claim selected independently'
+for label in \
+  MAX-FILL-BRIDGE-SPEC.bridge-sum-empty \
