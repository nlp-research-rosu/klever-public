+
+printf '%s\n' '## Hash manifests'
+run bash -c 'find /candidate/reference-semantics -type f -print0 | sort -z | xargs -0 sha256sum'
+run bash -c 'find /reference/reference-semantics -type f -print0 | sort -z | xargs -0 sha256sum'
