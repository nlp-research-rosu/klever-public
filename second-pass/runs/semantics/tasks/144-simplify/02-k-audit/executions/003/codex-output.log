+      1 |-> list(
+             vCons(str(numCodes(C)),
+             vCons(str(numCodes(D)), .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
