/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import os,stat,hashlib

def h(root, exclude=lambda r:False):
 root=Path(root); entries=[]; pending=[root]
 while pending:
  d=pending.pop()
  for c in os.scandir(d):
   p=Path(c.path); r=p.relative_to(root).as_posix(); m=c.stat(follow_symlinks=False).st_mode
   if exclude(r): continue
   if stat.S_ISDIR(m): entries.append((r,'directory',p)); pending.append(p)
   elif stat.S_ISREG(m): entries.append((r,'file',p))
 dig=hashlib.sha256()
 for r,k,p in sorted(entries):
  e=r.encode();dig.update(len(e).to_bytes(4,'big'));dig.update(e);dig.update(k.encode()+b'\\0')
  if k=='file':
   b=p.read_bytes();dig.update(len(b).to_bytes(8,'big'));dig.update(b)
 return dig.hexdigest()
for desc, ex in [('all',lambda r:False),('no pyc',lambda r:r.endswith('.pyc')),('no cache',lambda r:r=='__pycache__' or r.startswith('__pycache__/')),('sources only',lambda r:not (r.endswith(('.py','.mpy','.k','.sh')) or r.startswith('reference-semantics')) )]: print(desc,h('/candidate',ex))
