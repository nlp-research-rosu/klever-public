@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ "$#" -lt 2 ]]; then
+  printf 'usage: %s LOG COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  command_status=$?
+  printf '\nEXIT_STATUS: %d\n' "$command_status"
+  exit "$command_status"
+} > >(tee "$log_path") 2>&1
