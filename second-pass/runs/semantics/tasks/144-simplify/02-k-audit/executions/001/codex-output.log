+    fi
+
+    if [[ "$candidate_type" != "$reference_type" ]]; then
+      printf 'TYPE_OR_PRESENCE_MISMATCH %s candidate=%s reference=%s\n' \
+        "$relative_path" "$candidate_type" "$reference_type"
