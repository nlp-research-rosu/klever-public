diff --git a/evidence/spec-no-bridges.k b/evidence/spec-no-bridges.k
new file mode 100644
index 0000000000000000000000000000000000000000..11b136d3f3e319bb225e00949515e1b99e7b0207
--- /dev/null
+++ b/evidence/spec-no-bridges.k
@@ -0,0 +1,35 @@
+requires "verification-no-bridges.k"
+
+module SIMPLIFY-SPEC-NO-BRIDGES
+  imports SIMPLIFY-VERIFICATION-NO-BRIDGES
+
+  claim
+    <k> runSimplify(
+          str(fractionCodes(A:Int, B:Int)),
+          str(fractionCodes(C:Int, D:Int)))
+      => pyMod(A *Int C, B *Int D) ==Int 0
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+             vCons(str(numCodes(A)),
+             vCons(str(numCodes(B)), .ValSeq)))
+      1 |-> list(
+             vCons(str(numCodes(C)),
+             vCons(str(numCodes(D)), .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A >Int 0 andBool B >Int 0
+     andBool C >Int 0 andBool D >Int 0
+endmodule
diff --git a/evidence/verification-no-bridges.k b/evidence/verification-no-bridges.k
new file mode 100644
index 0000000000000000000000000000000000000000..0c3aeda637b25e347e77621b86573ce5b48bb075
--- /dev/null
+++ b/evidence/verification-no-bridges.k
@@ -0,0 +1,37 @@
+requires "reference-semantics/semantics.k"
+
+module SIMPLIFY-VERIFICATION-NO-BRIDGES
+  imports MPY
+
+  syntax IntSeq ::= numCodes(Int)
+                  | fractionCodes(Int, Int)
+
+  syntax KItem ::= runSimplify(Val, Val)
+  rule <k> runSimplify(X:Val, N:Val)
+        => #applyK(
+             toCall(
+               closureVal(
+                 ("x", "n"),
+                 Assign(
+                   TupleExpr(Name("x_num"), Name("x_den")),
+                   Call(Attribute(Name("x"), "split"), Str("/")))
+                 Assign(
+                   TupleExpr(Name("n_num"), Name("n_den")),
+                   Call(Attribute(Name("n"), "split"), Str("/")))
+                 Return(
+                   Compare(
+                     BinOp(
+                       "%",
+                       BinOp(
+                         "*",
+                         Call(Name("int"), Name("x_num")),
+                         Call(Name("int"), Name("n_num"))),
+                       BinOp(
+                         "*",
+                         Call(Name("int"), Name("x_den")),
+                         Call(Name("int"), Name("n_den")))),
+                     CmpOp("==", Int(0)))),
+                 0)),
+             (X, N, .Vals))
+        ... </k>
+endmodule

