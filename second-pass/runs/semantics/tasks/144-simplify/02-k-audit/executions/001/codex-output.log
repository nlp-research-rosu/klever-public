/bin/bash -lc "sed -n '1,260p' /kit-skills/using-kit/SKILL.md; sed -n '261,520p' /kit-skills/using-kit/SKILL.md; sed -n '1,340p' /kit-skills/validating-proof/SKILL.md; sed -n '341,700p' /kit-skills/validating-proof/SKILL.md; sed -n '1,360p' /kit-skills/shared/proof-extension-soundness.md; sed -n '361,720p' /kit-skills/shared/proof-extension-soundness.md" in /audit-output
