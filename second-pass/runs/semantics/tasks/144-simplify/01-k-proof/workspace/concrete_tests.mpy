Module(
  FuncDef("simplify", Params("x", "n"),
    Assign(
      TupleExpr(Name("x_num"), Name("x_den")),
      Call(Attribute(Name("x"), "split"), Str("/")))
    Assign(
      TupleExpr(Name("n_num"), Name("n_den")),
      Call(Attribute(Name("n"), "split"), Str("/")))
    Return(
      Compare(
        BinOp(
          "%",
          BinOp(
            "*",
            Call(Name("int"), Name("x_num")),
            Call(Name("int"), Name("n_num"))),
          BinOp(
            "*",
            Call(Name("int"), Name("x_den")),
            Call(Name("int"), Name("n_den")))),
        CmpOp("==", Int(0)))))
  Assert(
    Compare(
      Call(Name("simplify"), Str("1/5"), Str("5/1")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("simplify"), Str("1/6"), Str("2/1")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("simplify"), Str("7/10"), Str("10/2")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("simplify"), Str("12/35"), Str("70/24")),
      CmpOp("==", Bool(true)))))
