Module(
  FuncDef("check_if_last_char_is_a_letter", Params("txt"),
    If(Compare(Call(Name("len"), Name("txt")), CmpOp("==", Int(0))),
      Return(Bool(false)),
      )
    If(UnaryOp(
      "not",
      Call(
        Attribute(
          Subscript(Name("txt"), UnaryOp("-", Int(1))),
          "isalpha"),
        )),
      Return(Bool(false)),
      )
    If(Compare(Call(Name("len"), Name("txt")), CmpOp("==", Int(1))),
      Return(Bool(true)),
      )
    Return(
      Compare(
        Subscript(Name("txt"), UnaryOp("-", Int(2))),
        CmpOp("==", Str(" ")))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("apple pie")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("apple pi e")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("apple pi e ")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("a")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("7")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("ab")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("a b")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("a !")),
      CmpOp("==", Bool(false)))))
