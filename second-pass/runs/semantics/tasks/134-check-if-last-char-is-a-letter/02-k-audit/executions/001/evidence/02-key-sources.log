     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // The harness invokes exactly the closure produced by solution.mpy after
     7	  // its module-level FuncDef has loaded.
     8	  syntax KItem ::= "#checkIfLastChar" "(" Val ")"
     9	
    10	  rule #checkIfLastChar(V:Val)
    11	    => Call(
    12	         closureVal(
    13	           "txt",
    14	           If(Compare(Call(Name("len"), Name("txt")),
    15	                      CmpOp("==", Int(0))),
    16	              Return(Bool(false)),
    17	              .Stmts)
    18	           If(UnaryOp("not",
    19	                      Call(Attribute(
    20	                             Subscript(Name("txt"), UnaryOp("-", Int(1))),
    21	                             "isalpha"),
    22	                           .Exprs)),
    23	              Return(Bool(false)),
    24	              .Stmts)
    25	           If(Compare(Call(Name("len"), Name("txt")),
    26	                      CmpOp("==", Int(1))),
    27	              Return(Bool(true)),
    28	              .Stmts)
    29	           Return(Compare(
    30	                    Subscript(Name("txt"), UnaryOp("-", Int(2))),
    31	                    CmpOp("==", Str(" ")))),
    32	           0),
    33	         V)
    34	
    35	  // Symbolic suffix lemmas.  Every string with at least two characters is
    36	  // seqConcat(PREFIX, iCons(PREV, iCons(LAST, .IntSeq))) for some PREFIX.
    37	  // These equations expose len() and Python's negative indexing without
    38	  // assuming anything about that prefix.
    39	  rule isLen(seqConcat(P:IntSeq, iCons(A:Int, iCons(B:Int, .IntSeq))))
    40	    => isLen(P) +Int 2
    41	    [simplification]
    42	
    43	  rule intSeqAt(
    44	         seqConcat(P:IntSeq, iCons(A:Int, iCons(B:Int, .IntSeq))),
    45	         isLen(P))
    46	    => A
    47	    [simplification]
    48	
    49	  rule intSeqAt(
    50	         seqConcat(P:IntSeq, iCons(A:Int, iCons(B:Int, .IntSeq))),
    51	         isLen(P) +Int 1)
    52	    => B
    53	    [simplification]
    54	endmodule
