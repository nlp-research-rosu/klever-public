     6	def check_if_last_char_is_a_letter(txt):
     7	    '''
     8	    Create a function that returns True if the last character
     9	    of a given string is an alphabetical character and is not
    10	    a part of a word, and False otherwise.
    11	    Note: "word" is a group of characters separated by space.
    12	
    13	    Examples:
    14	    check_if_last_char_is_a_letter("apple pie") ➞ False
    15	    check_if_last_char_is_a_letter("apple pi e") ➞ True
    16	    check_if_last_char_is_a_letter("apple pi e ") ➞ False
    17	    check_if_last_char_is_a_letter("") ➞ False 
    18	    '''
    19	 
    20	    check = txt.split(' ')[-1]
    21	    return True if len(check) == 1 and (97 <= ord(check.lower()) <= 122) else False
===== /candidate/solution.py =====
     1	def check_if_last_char_is_a_letter(txt):
     2	    if len(txt) == 0:
     3	        return False
     4	    if not txt[-1].isalpha():
     5	        return False
     6	    if len(txt) == 1:
     7	        return True
     8	    return txt[-2] == " "
