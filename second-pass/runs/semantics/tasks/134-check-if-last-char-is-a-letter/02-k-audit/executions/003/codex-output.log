diff --git a/evidence/verification-body-mut.k b/evidence/verification-body-mut.k
new file mode 100644
index 0000000000000000000000000000000000000000..6d07e423414824f6013043bb8c849421cc9f1aa2
--- /dev/null
+++ b/evidence/verification-body-mut.k
@@ -0,0 +1,50 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BODY-MUT
+  imports MPY
+
+  syntax KItem ::= "#checkIfLastCharMut" "(" Val ")"
+
+  // Deliberate body mutation: compare the penultimate character to "x"
+  // instead of the submitted body's " ".
+  rule #checkIfLastCharMut(V:Val)
+    => Call(
+         closureVal(
+           "txt",
+           If(Compare(Call(Name("len"), Name("txt")),
+                      CmpOp("==", Int(0))),
+              Return(Bool(false)),
+              .Stmts)
+           If(UnaryOp("not",
+                      Call(Attribute(
+                             Subscript(Name("txt"), UnaryOp("-", Int(1))),
+                             "isalpha"),
+                           .Exprs)),
+              Return(Bool(false)),
+              .Stmts)
+           If(Compare(Call(Name("len"), Name("txt")),
+                      CmpOp("==", Int(1))),
+              Return(Bool(true)),
+              .Stmts)
+           Return(Compare(
+                    Subscript(Name("txt"), UnaryOp("-", Int(2))),
+                    CmpOp("==", Str("x")))),
+           0),
+         V)
+
+  rule isLen(seqConcat(P:IntSeq, iCons(A:Int, iCons(B:Int, .IntSeq))))
+    => isLen(P) +Int 2
+    [simplification]
+
+  rule intSeqAt(
+         seqConcat(P:IntSeq, iCons(A:Int, iCons(B:Int, .IntSeq))),
+         isLen(P))
+    => A
+    [simplification]
+
+  rule intSeqAt(
+         seqConcat(P:IntSeq, iCons(A:Int, iCons(B:Int, .IntSeq))),
+         isLen(P) +Int 1)
+    => B
+    [simplification]
+endmodule
diff --git a/evidence/witness_comparison.py b/evidence/witness_comparison.py
new file mode 100644
index 0000000000000000000000000000000000000000..9cebfb4b6f09ace6c536d3659f883f9685e29e1c
--- /dev/null
+++ b/evidence/witness_comparison.py
@@ -0,0 +1,43 @@
+#!/usr/bin/env python3
+"""Ground witnesses for every entry-claim precondition."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+
+def load(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.check_if_last_char_is_a_letter
+
+
+canonical = load(Path("/reference/canonical.py"), "canonical_witness")
+candidate = load(
+    Path("/tmp/audit-work/candidate/solution.py"), "candidate_witness"
+)
+
+witnesses = [
+    ("empty", "", False),
+    ("one-alpha", "a", True),
+    ("one-nonalpha", "7", False),
+    ("long-true", " a", True),
+    ("long-last-nonalpha", " !", False),
+    ("long-prev-not-space", "aa", False),
+]
+
+for claim, text, claimed in witnesses:
+    canonical_result = canonical(text)
+    candidate_result = candidate(text)
+    print(
+        f"{claim}: input={text!r} claimed={claimed!r} "
+        f"canonical={canonical_result!r} candidate={candidate_result!r}"
+    )
+    assert canonical_result == claimed
+    assert candidate_result == claimed
+
+print(f"satisfying_witnesses={len(witnesses)} all_match=true")

