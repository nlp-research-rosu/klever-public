+  /generation-evidence/codex-trace/2026/07/23/rollout-2026-07-23T06-30-11-019f8ebd-805f-71e1-ba58-cb3a4a52cb13.jsonl
+)
+
+for artifact in "${required_records[@]}"; do
+  test -f "$artifact"
+  test ! -L "$artifact"
+  test -r "$artifact"
+done
+
+python3 - <<'PY'
