+requires "verification.k"
+
+module SPEC-EMPTY
+  imports VERIFICATION
+  claim
+    <k> #checkIfLastChar(str(.IntSeq)) => false </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module SPEC-ONE-ALPHA
+  imports VERIFICATION
+  claim
+    <k> #checkIfLastChar(str(iCons(C:Int, .IntSeq))) => true </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires isAlphaC(C)
+endmodule
+
+module SPEC-ONE-NONALPHA
+  imports VERIFICATION
+  claim
+    <k> #checkIfLastChar(str(iCons(C:Int, .IntSeq))) => false </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
