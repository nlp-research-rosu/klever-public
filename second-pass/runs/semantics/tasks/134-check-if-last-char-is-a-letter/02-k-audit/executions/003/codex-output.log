+test "$(sha256sum /run.json | cut -d ' ' -f 1)" = \
+  321818dc4f5c9795e25ea800ab12c1b1e5cf0bcc70b308443b9f08339a122db0
+test "$(sha256sum /task.json | cut -d ' ' -f 1)" = \
