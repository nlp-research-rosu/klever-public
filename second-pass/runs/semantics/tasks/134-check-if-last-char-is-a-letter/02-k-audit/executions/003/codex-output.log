+#!/usr/bin/env bash
+set -euo pipefail
+set -x
+
+required_records=(
+  /audit-input.json
+  /audit-campaign-lock.json
+  /run.json
+  /task.json
+  /generation-result.json
+  /generation-evidence/invocation.json
