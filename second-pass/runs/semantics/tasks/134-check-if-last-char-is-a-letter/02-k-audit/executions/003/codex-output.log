+  claim
+    <k>
+      intSeqAt(
+        seqConcat(P:IntSeq, iCons(A:Int, iCons(B:Int, .IntSeq))),
+        isLen(P) +Int 1)
+      =>
+      B
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
