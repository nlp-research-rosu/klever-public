index 0000000000000000000000000000000000000000..6872073defbdba20b3f5a17ffefdd3b0e9b86046
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,8 @@
+import math
+
+
+def sum_squares(lst):
+    result = 0
+    for number in lst:
+        result += math.ceil(number) ** 2
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..da7041245542d7573f649dc27c51abf201e27468
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,70 @@
+requires "verification.k"
+
+module SUM-SQUARES-SPEC
+  imports SUM-SQUARES-VERIFICATION
+
+  // The exact loop generated from solution.py.
+  claim [loop-correct]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("number"),
+        AugAssign(
+          Name("result"),
+          "+",
+          BinOp(
+            "**",
+            Call(Attribute(Name("math"), "ceil"), Name("number")),
+            Int(2)))
+      )
+      ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (L |->
+        scope(
+          "lst" |-> INPUT:Val
+          "number" |-> (CURRENT:Val => lastFrom(CURRENT, VS))
+          "result" |-> (ACC:Int => sumSquaresFrom(ACC, VS)),
+          PARENT:Parent))
+      GLOBAL:Map
+    </scopes>
+    requires notBool (L in_keys(GLOBAL))
+
+  // End-to-end call theorem for the closure body translated from solution.py.
+  claim [function-correct]:
+    <k>
+      Call(
+        closureVal(
+          ("lst", .ParamNames),
+          Assign(Name("result"), Int(0))
+          For(
+            Name("number"),
+            Name("lst"),
+            AugAssign(
+              Name("result"),
+              "+",
+              BinOp(
+                "**",
+                Call(Attribute(Name("math"), "ceil"), Name("number")),
+                Int(2))))
+          Return(Name("result")),
+          0),
+        list(VS:ValSeq))
+      ~> CONT:K
+      =>
+      sumSquaresFrom(0, VS)
+      ~> CONT
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    [depends(loop-correct)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..16d17dc267bb8786dcf844e9b8dcd0c9150a2ac7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,18 @@
+requires "reference-semantics/semantics.k"
+
+module SUM-SQUARES-VERIFICATION
+  imports MPY
+
+  // Mathematical summary of the implementation's left-to-right accumulator.
+  syntax Int ::= sumSquaresFrom(Int, ValSeq) [function, total]
+  rule sumSquaresFrom(ACC:Int, .ValSeq) => ACC
+  rule sumSquaresFrom(ACC:Int, vCons(V:Val, REST:ValSeq))
+    => sumSquaresFrom(ACC +Int (ceilF(V) ^Int 2), REST)
+
+  // Final value of the loop target; needed only to state the complete scope
+  // update without hiding the target variable behind an existential.
+  syntax Val ::= lastFrom(Val, ValSeq) [function, total]
+  rule lastFrom(CURRENT:Val, .ValSeq) => CURRENT
+  rule lastFrom(_:Val, vCons(V:Val, REST:ValSeq))
+    => lastFrom(V, REST)
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..9b2ead1997641685e8f6f3cd906114ad4ceebc00
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,16 @@
+import math
+
+
+def sum_squares(lst):
+    result = 0
+    for number in lst:
+        result += math.ceil(number) ** 2
+    return result
+
+
+assert sum_squares([1, 2, 3]) == 14
+assert sum_squares([1, 4, 9]) == 98
+assert sum_squares([1, 3, 5, 7]) == 84
+assert sum_squares([1.4, 4.2, 0]) == 29
+assert sum_squares([-2.4, 1, 1]) == 6
+assert sum_squares([]) == 0
