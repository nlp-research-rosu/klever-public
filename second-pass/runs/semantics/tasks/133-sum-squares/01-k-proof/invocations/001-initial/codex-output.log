diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c8b5fdfa1f452264b7991b9e91c09417a1869cd6
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,77 @@
+requires "verification.k"
+
+module SUM-SQUARES-SPEC
+  imports SUM-SQUARES-VERIFICATION
+
+  // The exact loop generated from solution.py.  The continuation includes the
+  // function return, so the local frame (including the loop-target binding) is
+  // removed on both sides of the invariant.
+  claim [loop-correct]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("number"),
+        AugAssign(
+          Name("result"),
+          "+",
+          BinOp(
+            "**",
+            Call(Attribute(Name("math"), "ceil"), Name("number")),
+            Int(2)))
+      )
+      ~> Return(Name("result"))
+      ~> #endcall
+      =>
+      sumSquaresFrom(ACC:Int, VS)
+      ~> CONT:K
+    </k>
+    <env> L:Int => CALLER:Int </env>
+    <scopes>
+      (L |-> scope(("result" |-> ACC) LOCAL:Map, PARENT:Parent))
+      GLOBAL:Map
+      =>
+      GLOBAL
+    </scopes>
+    <scopeLoc> L +Int 1 => L </scopeLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, L)) REST:List
+      =>
+      REST
+    </stack>
+    <ret> noRet </ret>
+    requires notBool (L in_keys(GLOBAL))
+      andBool notBool ("$cells" in_keys(("result" |-> ACC) LOCAL))
+
+  // End-to-end call theorem for the closure body translated from solution.py.
+  claim [function-correct]:
+    <k>
+      Call(
+        closureVal(
+          ("lst", .ParamNames),
+          Assign(Name("result"), Int(0))
+          For(
+            Name("number"),
+            Name("lst"),
+            AugAssign(
+              Name("result"),
+              "+",
+              BinOp(
+                "**",
+                Call(Attribute(Name("math"), "ceil"), Name("number")),
+                Int(2))))
+          Return(Name("result")),
+          DEFINITIONENV:Int),
+        list(VS:ValSeq))
+      ~> CONT:K
+      =>
+      sumSquaresFrom(0, VS)
+      ~> CONT
+    </k>
+    <env> CALLER:Int </env>
+    <scopes> SCOPES:Map </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    requires notBool (NEXT in_keys(SCOPES))
+    [depends(loop-correct)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..da89d990138a09fbf4a1dbf7491977cb74da2f30
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,11 @@
+requires "reference-semantics/semantics.k"
+
+module SUM-SQUARES-VERIFICATION
+  imports MPY
+
+  // Mathematical summary of the implementation's left-to-right accumulator.
+  syntax Int ::= sumSquaresFrom(Int, ValSeq) [function, total]
+  rule sumSquaresFrom(ACC:Int, .ValSeq) => ACC
+  rule sumSquaresFrom(ACC:Int, vCons(V:Val, REST:ValSeq))
+    => sumSquaresFrom(ACC +Int (ceilF(V) ^Int 2), REST)
+endmodule

