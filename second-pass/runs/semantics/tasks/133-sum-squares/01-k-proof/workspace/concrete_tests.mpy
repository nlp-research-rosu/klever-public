Module(
  Import("math")
  FuncDef("sum_squares", Params("lst"),
    Assign(Name("result"), Int(0))
    For(Name("number"), Name("lst"),
      AugAssign(
        Name("result"),
        "+",
        BinOp(
          "**",
          Call(Attribute(Name("math"), "ceil"), Name("number")),
          Int(2))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("sum_squares"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Int(14))))
  Assert(
    Compare(
      Call(Name("sum_squares"), ListExpr(Int(1), Int(4), Int(9))),
      CmpOp("==", Int(98))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(Int(1), Int(3), Int(5), Int(7))),
      CmpOp("==", Int(84))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(Float(1.4), Float(4.2), Int(0))),
      CmpOp("==", Int(29))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(UnaryOp("-", Float(2.4)), Int(1), Int(1))),
      CmpOp("==", Int(6))))
  Assert(
    Compare(Call(Name("sum_squares"), ListExpr()), CmpOp("==", Int(0)))))
