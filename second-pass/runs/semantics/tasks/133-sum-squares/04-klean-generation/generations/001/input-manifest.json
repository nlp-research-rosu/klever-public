      "start_line": 15,
      "text": "  rule lastFrom(CURRENT:Val, .ValSeq) => CURRENT"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 17,
      "module": "SUM-SQUARES-VERIFICATION-BASE",
      "normalized_sha256": "d51eea8592ab9aaeac0075e7adf2716fa54493fd8ace05402072151930790876",
      "rationale": "Recursive equation defining lastFrom by carrying the current head value through the remaining ValSeq.",
      "source_rule_id": "rule-d51eea8592ab9aaeac0075e7adf2716fa54493fd8ace05402072151930790876",
      "start_line": 16,
      "text": "  rule lastFrom(_:Val, vCons(V:Val, REST:ValSeq))\n    => lastFrom(V, REST)"
    }
