      "start_line": 27,
      "text": "  rule\n    <k>\n      #loop(\n        list(VS:ValSeq),\n        Name(\"number\"),\n        AugAssign(\n          Name(\"result\"),\n          \"+\",\n          BinOp(\n            \"**\",\n            Call(Attribute(Name(\"math\"), \"ceil\"), Name(\"number\")),\n            Int(2)))\n      )\n      ~> CONT:K\n      =>\n      CONT\n    </k>\n    <env> L:Int </env>\n    <scopes>\n      (L |->\n        scope(\n          \"lst\" |-> INPUT:Val\n          \"number\" |-> (CURRENT:Val => lastFrom(CURRENT, VS))\n          \"result\" |-> (ACC:Int => sumSquaresFrom(ACC, VS)),\n          PARENT:Parent))\n      GLOBAL:Map\n    </scopes>\n    requires notBool (L in_keys(GLOBAL))\n    [priority(40)]"
    }
