      "start_line": 9,
      "text": "  rule sumSquaresFrom(ACC:Int, vCons(V:Val, REST:ValSeq))\n    => sumSquaresFrom(ACC +Int (ceilF(V) ^Int 2), REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 15,
