    49	
    50	  // ==== If (condition evaluated by strictness) ==============================
    51	  syntax KItem ::= #branch(Bool, Stmts, Stmts)
    52	  rule <k> If(C:Val, T:Stmts, E:Stmts) => #branch(truthy(C), T, E) ... </k>
    53	  rule <k> #branch(true,  T:Stmts, _:Stmts) => T ... </k>
    54	  rule <k> #branch(false, _:Stmts, E:Stmts) => E ... </k>
    55	
    56	  // ==== IfExp: ternary T if C else E ========================================
    57	  rule <k> IfExp(V:Val, T:Expr, _:Expr) => T ... </k>
    58	       requires truthy(V)
    59	  rule <k> IfExp(V:Val, _:Expr, E:Expr) => E ... </k>
    60	       requires notBool truthy(V)
    61	
    62	  // ==== For: one loop, in-cell continuation, over #iterNext =================
    63	  // (the iterable is evaluated once, by strictness; the protocol stays rewrites —
    64	  // circularities anchor on #loop and narrowing substitutes the structure)
    65	  syntax KItem ::= #loop(Val, Expr, Stmts) | #loopStep(Expr, Stmts)
    66	                 | #while(Expr, Stmts) | #whileCond(Expr, Stmts)
    67	                 | #loopLbl(K) | "#cont" | "#brk"
    68	
    69	  rule <k> For(T:Expr, OBJ:Val, B:Stmts) => #loop(OBJ, T, B) ... </k>
    70	
    71	  rule <k> #loop(IT:Iterable, T:Expr, B:Stmts) => #iterNext(IT) ~> #loopStep(T, B) ... </k>
    72	  rule <k> #iterDone ~> #loopStep(_:Expr, _:Stmts) => .K ... </k>
    73	  rule <k> #iterYield(V:Val, REST:Iterable) ~> #loopStep(T:Expr, B:Stmts)
    74	        => #bindTgt(T, V) ~> B ~> #loopLbl(#loop(REST, T, B)) ... </k>
    75	
    76	  // ==== While ==============================================================
    77	  rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>
    78	  rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>
    79	  rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>
    80	       requires truthy(V)
    81	  rule <k> V:Val ~> #whileCond(_C:Expr, _B:Stmts) => .K ... </k>
    82	       requires notBool truthy(V)
    83	
    84	  // ==== loop control (break / continue) =====================================
    85	  rule <k> #loopLbl(NEXT:K) => NEXT ... </k>
    86	  rule <k> Continue => #cont ... </k>
    87	  rule <k> Break => #brk ... </k>
    88	  rule <k> #cont ~> #loopLbl(NEXT:K) => NEXT ... </k>
    89	  rule <k> #cont ~> (_:KItem => .K) ... </k> [owise]
    90	  rule <k> #brk ~> #loopLbl(_:K) => .K ... </k>
    91	  rule <k> #brk ~> (_:KItem => .K) ... </k> [owise]
    92	
    93	  // ==== heap-object deref at the truthiness/iteration consumers ==============
    94	  // (priority(40) preempts the generic Val rules so truthy/#loop never see a ref)
    95	  rule <k> If(ref(H:Int), T:Stmts, E:Stmts) => If(V, T, E) ... </k>
    96	       <heap> ... H |-> V:Val ... </heap>
    97	       [priority(40)]
    98	  rule <k> IfExp(ref(H:Int), T:Expr, E:Expr) => IfExp(V, T, E) ... </k>
    99	       <heap> ... H |-> V:Val ... </heap>
   100	       [priority(40)]
   101	  rule <k> ref(H:Int) ~> #whileCond(C:Expr, B:Stmts) => V ~> #whileCond(C, B) ... </k>
   102	       <heap> ... H |-> V:Val ... </heap>
   103	       [priority(40)]
   104	  // For derefs its iterable ONCE at loop start (iteration is over the snapshot;
   105	  // mutating the iterated list inside its own loop is outside the subset)
   106	  rule <k> For(T:Expr, ref(H:Int), B:Stmts) => For(T, V, B) ... </k>
   107	       <heap> ... H |-> V:Val ... </heap>
   108	       [priority(40)]
   109	endmodule

===== semantics/operators.k =====
     1	// reference/src/semantics/operators.k — MPY-OPERATORS
     2	// The operator DISPATCH layer: operands evaluate by strictness (heat/cool over KResult=Val),
     3	// the cooled node hands to applyUn/applyBin/applyCmp (declared in core.k; each domain file
     4	// owns its cases — bool.k, int.k, float.k, str.k, list.k, tuple.k, set.k, dict.k).
     5	
     6	module MPY-OPERATORS
     7	  imports MPY-CORE
     8	  imports MPY-ITER
     9	
    10	  rule <k> UnaryOp(OP:String, V:Val) => applyUn(OP, V) ... </k>
    11	
    12	  rule <k> BinOp(OP:String, L:Val, R:Val) => applyBin(OP, L, R) ... </k>
    13	
    14	  // Compare's right operand sits under the CmpOp wrapper — contexts instead of attributes
    15	  context Compare(HOLE, _)
    16	  context Compare(_:Val, CmpOp(_, HOLE))
    17	  rule <k> Compare(LV:Val, CmpOp(OP:String, RV:Val)) => applyCmp(OP, LV, RV) ... </k> [owise]
    18	
    19	  rule applyCmp("is",     V:Val, noneV) => V ==K noneV
    20	  rule applyCmp("is not", V:Val, noneV) => notBool (V ==K noneV)
    21	
    22	  // ==== operand deref: heap objects combine/compare by STRUCTURE ============
    23	  // (Python: list == is structural; identity only via `is`.) priority(40)
    24	  // preempts the generic dispatch so applyUn/applyBin/applyCmp never see a ref.
    25	  rule <k> BinOp(OP:String, ref(H:Int), R:Expr) => BinOp(OP, V, R) ... </k>
    26	       <heap> ... H |-> V:Val ... </heap>
    27	       [priority(40)]
    28	  rule <k> BinOp(OP:String, L:Val, ref(H:Int)) => BinOp(OP, L, V) ... </k>
    29	       <heap> ... H |-> V:Val ... </heap>
    30	       requires notBool isRefV(L)
    31	       [priority(40)]
    32	
    33	  // the left operand of `in`/`not in` is an ELEMENT (compares by ==K) — never deref'd
    34	  rule <k> Compare(ref(H:Int), CmpOp(OP:String, R:Expr)) => Compare(V, CmpOp(OP, R)) ... </k>
    35	       <heap> ... H |-> V:Val ... </heap>
    36	       requires OP =/=String "in" andBool OP =/=String "not in"
    37	       [priority(40)]
    38	  rule <k> Compare(L:Val, CmpOp(OP:String, ref(H:Int))) => Compare(L, CmpOp(OP, V)) ... </k>
    39	       <heap> ... H |-> V:Val ... </heap>
    40	       requires notBool isRefV(L)
    41	        orBool OP ==String "in" orBool OP ==String "not in"
    42	       [priority(40)]
    43	
    44	  rule <k> UnaryOp(OP:String, ref(H:Int)) => UnaryOp(OP, V) ... </k>
    45	       <heap> ... H |-> V:Val ... </heap>
    46	       [priority(40)]
    47	endmodule

===== semantics/int.k =====
     1	// reference/src/semantics/int.k — MPY-INT
     2	// Int cases of the operator dispatch; Python // and % are floored (pyMod).
     3	
     4	module MPY-INT
     5	  imports MPY-CORE
     6	
     7	  rule applyUn("-", I:Int) => 0 -Int I
     8	
     9	  rule applyBin("+",  I1:Int, I2:Int) => I1 +Int I2
    10	  // Bool participates in int arithmetic (x += (a == b))
    11	  rule applyBin("+",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi
    12	  rule applyBin("+",  B:Bool, I:Int) => #if B #then 1 #else 0 #fi +Int I
    13	  rule applyBin("-",  I1:Int, I2:Int) => I1 -Int I2
    14	  rule applyBin("*",  I1:Int, I2:Int) => I1 *Int I2
    15	  rule applyBin("%",  I1:Int, I2:Int) => pyMod(I1, I2)
    16	  rule applyBin("//", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2
    17	  rule applyBin("**", I1:Int, I2:Int) => I1 ^Int I2 requires I2 >=Int 0
    18	
    19	  syntax Int ::= pyMod(Int, Int) [function]
    20	  rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2
    21	
    22	  rule applyCmp("<",  I1:Int, I2:Int)   => I1 <Int  I2
    23	  rule applyCmp("<=", I1:Int, I2:Int)   => I1 <=Int I2
    24	  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int  I2
    25	  rule applyCmp(">=", I1:Int, I2:Int)   => I1 >=Int I2
    26	  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2
    27	  rule applyCmp("!=", I1:Int, I2:Int)   => I1 =/=Int I2
    28	endmodule

===== semantics/float.k =====
     1	// reference/src/semantics/float.k — MPY-FLOAT
     2	//
     3	// Minimal, TRUSTED float support. K/Haskell (kprove) has no usable symbolic IEEE-754 theory and
     4	// no Int2Float hook, so a float value stays an OPAQUE proof-domain primitive: `intFloatDiv(I, F)`
     5	// (the Python true division I / F) is `[no-evaluators]` for kprove — it never reduces on symbolic
     6	// input, and the proof verifies only the STRUCTURE (the result is the exact term the program
     7	// builds). The `[concrete]` rule evaluates it for krun (llvm HAS the Int2Float / /Float hooks), so
     8	// smoke tests run the real float value.
     9	//
    10	// Only the pieces needed so far: Float as a Val, the float literal, and Int / float true division
    11	// (the `a * h / 2.0` idiom). More float ops (float +/-/*, comparison) are added as float problems
    12	// need them — kept minimal + sound.
    13	
    14	module MPY-FLOAT
    15	  imports MPY-OPERATORS
    16	  imports MPY-BUILTINS
    17	  imports FLOAT
    18	
    19	  // Float is a value; the float literal evaluates to the K Float.
    20	  syntax Val ::= Float
    21	  rule <k> Float(F:Float) => F ... </k>
    22	
    23	  // Int / float true division. OPAQUE for kprove (no-evaluators); concrete for krun.
    24	  syntax Float ::= intFloatDiv(Int, Float) [function, total, symbol(intFloatDiv), no-evaluators]
    25	  rule intFloatDiv(I:Int, F:Float) => Int2Float(I, 53, 11) /Float F [concrete]
    26	
    27	  rule applyBin("/", I:Int, F:Float) => intFloatDiv(I, F)
    28	
    29	  // Int / Int true division (Python: always a float). OPAQUE for kprove; concrete for krun.
    30	  syntax Float ::= divII(Int, Int) [function, total, symbol(divII), no-evaluators]
    31	  rule divII(I1:Int, I2:Int) => Int2Float(I1, 53, 11) /Float Int2Float(I2, 53, 11) [concrete]
    32	  rule applyBin("/", I1:Int, I2:Int) => divII(I1, I2)
    33	
    34	  // float % float (e.g. `number % 1.0` = the fractional part). OPAQUE for kprove, concrete for
    35	  // krun. Python's float `%` is floor-based: a % b = a - floor(a/b)*b (K's %Float is IEEE
    36	  // remainder, which differs — 3.5 %Float 1.0 = -0.5 vs Python 0.5 — so it is NOT used).
    37	  syntax Float ::= floatMod(Float, Float) [function, total, symbol(floatMod), no-evaluators]
    38	  rule floatMod(F1:Float, F2:Float) => F1 -Float (floorFloat(F1 /Float F2) *Float F2) [concrete]
    39	  rule applyBin("%", F1:Float, F2:Float) => floatMod(F1, F2)
    40	
    41	  // float equality — for concrete krun asserts (e.g. `area == 7.5`); the FLOAT.eq hook is fine on
    42	  // concrete floats. kprove proofs return floats structurally and do not compare them.
    43	  rule applyCmp("==", F1:Float, F2:Float) => F1 ==Float F2
    44	  rule applyCmp("!=", F1:Float, F2:Float) => notBool (F1 ==Float F2)
    45	
    46	  // float `<` and abs — OPAQUE for kprove ([no-evaluators], so a SYMBOLIC float compare stays an
    47	  // uninterpreted Bool a proof case-splits on — a SINGLE compare per branch, not a nonlinear cascade),
    48	  // [concrete] for krun. Additive, sort-disjoint from the Int rules. (has_close_elements: the pairwise
    49	  // `abs(a-b) < t` proximity test.)
    50	  syntax Bool ::= floatLt(Float, Float) [function, total, symbol(floatLt), no-evaluators]
    51	  rule floatLt(F1:Float, F2:Float) => F1 <Float F2 [concrete]
    52	  rule applyCmp("<", F1:Float, F2:Float) => floatLt(F1, F2)
    53	
    54	  syntax Float ::= absF(Float) [function, total, symbol(absF), no-evaluators]
    55	  rule absF(F:Float) => absFloat(F) [concrete]
    56	  rule applyBuiltin("abs", F:Float, .Vals) => absF(F)
    57	
    58	  // ==== math.ceil ===========================================================
    59	  // `import X` is a no-op (we intercept the specific math functions syntactically; `math` itself is
    60	  // never bound as a value).
    61	  rule <k> Import(_:String) => .K ... </k>
    62	
    63	  // math.ceil(x): ceiling to an int. Intercepted at the Call BEFORE `math` is looked up (higher
    64	  // priority than the generic Attribute/method dispatch in call.k).
    65	  syntax KItem ::= "#mathCeil"
    66	  rule <k> Call(Attribute(Name("math"), "ceil"), (E:Expr, .Exprs)) => E ~> #mathCeil ... </k> [priority(40)]
    67	  rule <k> V:Val ~> #mathCeil => ceilF(V) ... </k>
    68	
    69	  // math.floor(x) — same interception shape as math.ceil
    70	  syntax KItem ::= "#mathFloor"
    71	  rule <k> Call(Attribute(Name("math"), "floor"), (E:Expr, .Exprs)) => E ~> #mathFloor ... </k> [priority(40)]
    72	  rule <k> V:Val ~> #mathFloor => floorFI(V) ... </k>
    73	  syntax Int ::= floorFI(Val) [function, total, symbol(floorFI)]
    74	  rule floorFI(I:Int)   => I                        [concrete]
    75	  rule floorFI(F:Float) => Float2Int(floorFloat(F)) [concrete]
    76	
    77	  // bare floor/ceil (bound by `from math import floor, ceil`)
    78	  rule applyBuiltin("floor", V:Val, .Vals) => floorFI(V)
    79	  rule applyBuiltin("ceil",  V:Val, .Vals) => ceilF(V)
    80	
    81	  // math.pow(x, y) — a two-arg interception onto powF (ints promote)
    82	  syntax KItem ::= #mathPow1(Expr) | #mathPow2(Val)
    83	  rule <k> Call(Attribute(Name("math"), "pow"), (E1:Expr, E2:Expr, .Exprs)) => E1 ~> #mathPow1(E2) ... </k> [priority(40)]
    84	  rule <k> V1:Val ~> #mathPow1(E2:Expr) => E2 ~> #mathPow2(V1) ... </k>
    85	  rule <k> V2:Val ~> #mathPow2(V1:Val) => powF(toF(V1), toF(V2)) ... </k>
    86	  syntax Float ::= toF(Val) [function, total, symbol(toF)]
    87	  rule toF(F:Float) => F        [concrete]
    88	  rule toF(I:Int)   => intToF(I) [concrete]
    89	
    90	  // ceilF: math.ceil as an Int. TOTAL (K trusts it; a symbolic list element stays opaque for
    91	  // kprove — structural). [concrete] so the Int2Float/ceilFloat hooks only run for krun (llvm).
    92	  // Matches Python incl. negatives: ceil(-2.4) = -2 = Float2Int(ceilFloat(-2.4)).
    93	  syntax Int ::= ceilF(Val) [function, total, symbol(ceilF)]
    94	  rule ceilF(I:Int)   => I                       [concrete]
    95	  rule ceilF(F:Float) => Float2Int(ceilFloat(F)) [concrete]
    96	
    97	  // unary minus on a float (e.g. the literal -2.4 = UnaryOp("-", Float(2.4))). Concrete for krun;
    98	  // proofs use symbolic elements, never a float literal.
    99	  rule applyUn("-", F:Float) => 0.0 -Float F
   100	
   101	  // ---- float - / / / + (OPAQUE for kprove [no-evaluators], concrete for krun) — for float-list
   102	  // element maps (x - lo) / (hi - lo). Mirror intFloatDiv: additive, sort-disjoint from the Int rules.
   103	  syntax Float ::= subF(Float, Float) [function, total, symbol(subF), no-evaluators]
   104	  rule subF(F1:Float, F2:Float) => F1 -Float F2 [concrete]
   105	  rule applyBin("-", F1:Float, F2:Float) => subF(F1, F2)
   106	
   107	  syntax Float ::= divF(Float, Float) [function, total, symbol(divF), no-evaluators]
   108	  rule divF(F1:Float, F2:Float) => F1 /Float F2 [concrete]
   109	  rule applyBin("/", F1:Float, F2:Float) => divF(F1, F2)
   110	
   111	  syntax Float ::= addF(Float, Float) [function, total, symbol(addF), no-evaluators]
   112	  rule addF(F1:Float, F2:Float) => F1 +Float F2 [concrete]
   113	  rule applyBin("+", F1:Float, F2:Float) => addF(F1, F2)
   114	
   115	  syntax Float ::= mulF(Float, Float) [function, total, symbol(mulF), no-evaluators]
   116	  rule mulF(F1:Float, F2:Float) => F1 *Float F2 [concrete]
   117	  rule applyBin("*", F1:Float, F2:Float) => mulF(F1, F2)
   118	
   119	  syntax Float ::= powF(Float, Float) [function, total, symbol(powF), no-evaluators]
   120	  rule powF(F1:Float, F2:Float) => F1 ^Float F2 [concrete]
   121	  rule applyBin("**", F1:Float, F2:Float) => powF(F1, F2)
   122	
   123	  // ---- the remaining comparisons (gtF promoted from find_zero — its summaries
   124	  //      case-split on the atom; >= / <= derive from the two opaque compares) ----
   125	  syntax Bool ::= gtF(Float, Float) [function, total, symbol(gtF), no-evaluators]
   126	  rule gtF(F1:Float, F2:Float) => F1 >Float F2 [concrete]
   127	  rule applyCmp(">",  F1:Float, F2:Float) => gtF(F1, F2)
   128	  rule applyCmp(">=", F1:Float, F2:Float) => notBool floatLt(F1, F2)
   129	  rule applyCmp("<=", F1:Float, F2:Float) => notBool gtF(F1, F2)
   130	
   131	  // ---- mixed Int/Float operators promote the Int side (n ** 0.5 etc.) ----
   132	  rule applyBin("**", I:Int, F:Float) => powF(intToF(I), F)
   133	  rule applyBin("**", F:Float, I:Int) => powF(F, intToF(I))
   134	  rule applyBin("-",  I:Int, F:Float) => subF(intToF(I), F)
   135	  rule applyBin("-",  F:Float, I:Int) => subF(F, intToF(I))
   136	  rule applyBin("+",  I:Int, F:Float) => addF(intToF(I), F)
   137	  rule applyBin("+",  F:Float, I:Int) => addF(F, intToF(I))
   138	  rule applyBin("*",  I:Int, F:Float) => mulF(intToF(I), F)
   139	  rule applyBin("*",  F:Float, I:Int) => mulF(F, intToF(I))
   140	
   141	  // ---- mixed Int == Float (shared eqF; opaque symbolic / concrete twin) ----
   142	  syntax Bool ::= eqF(Float, Float) [function, total, symbol(eqF), no-evaluators]
   143	  rule eqF(F1:Float, F2:Float) => F1 ==Float F2 [concrete]
   144	  rule applyCmp("==", I:Int, F:Float) => eqF(intToF(I), F)
   145	  rule applyCmp("==", F:Float, I:Int) => eqF(F, intToF(I))
   146	  rule applyCmp("!=", I:Int, F:Float) => notBool eqF(intToF(I), F)
   147	  rule applyCmp("!=", F:Float, I:Int) => notBool eqF(F, intToF(I))
   148	  rule applyCmp("<",  I:Int, F:Float) => floatLt(intToF(I), F)
   149	  rule applyCmp("<",  F:Float, I:Int) => floatLt(F, intToF(I))
   150	  rule applyCmp(">",  I:Int, F:Float) => gtF(intToF(I), F)
   151	  rule applyCmp(">",  F:Float, I:Int) => gtF(F, intToF(I))
   152	
   153	  // ---- x == None (promoted from 137; `is` cases live in operators.k) ----
   154	  rule applyCmp("==", V:Val, noneV) => V ==K noneV
   155	  rule applyCmp("!=", V:Val, noneV) => notBool (V ==K noneV)
   156	
   157	  // ---- float(str): decimal parse (promoted from 137's defined chain) ----
   158	  // digits '.' digits, optional leading '-'; concrete evaluation only (the
   159	  // symbolic side stays an opaque decStrToF term a proof case-splits on).
   160	  syntax Float ::= decStrToF(IntSeq) [function, total, symbol(decStrToF), no-evaluators]
   161	  rule decStrToF(iCons(45, CS:IntSeq)) => 0.0 -Float decStrToF(CS) [concrete]
   162	  rule decStrToF(CS:IntSeq)
   163	    => intToF(intPart(CS)) +Float (intToF(fracPart(CS)) /Float intToF(fracScale(CS)))
   164	       requires isLen(CS) >Int 0 andBool headIS(CS) =/=Int 45 [concrete]
   165	  syntax Int ::= headIS(IntSeq) [function]
   166	  rule headIS(iCons(C:Int, _:IntSeq)) => C
   167	  syntax Int ::= intPart(IntSeq) [function, total] | intPartAcc(IntSeq, Int) [function, total]
   168	  rule intPart(CS:IntSeq) => intPartAcc(CS, 0)
   169	  rule intPartAcc(.IntSeq, A:Int) => A
   170	  rule intPartAcc(iCons(46, _:IntSeq), A:Int) => A
   171	  rule intPartAcc(iCons(C:Int, R:IntSeq), A:Int) => intPartAcc(R, A *Int 10 +Int (C -Int 48))
   172	       requires C =/=Int 46
   173	  syntax Int ::= fracPart(IntSeq) [function, total] | fracAcc(IntSeq, Int) [function, total]
   174	  rule fracPart(.IntSeq) => 0
   175	  rule fracPart(iCons(46, R:IntSeq)) => fracAcc(R, 0)
   176	  rule fracPart(iCons(C:Int, R:IntSeq)) => fracPart(R) requires C =/=Int 46
   177	  rule fracAcc(.IntSeq, A:Int) => A
   178	  rule fracAcc(iCons(C:Int, R:IntSeq), A:Int) => fracAcc(R, A *Int 10 +Int (C -Int 48))
   179	  syntax Int ::= fracScale(IntSeq) [function, total] | fscAcc(IntSeq, Int) [function, total]
   180	  rule fracScale(.IntSeq) => 1
   181	  rule fracScale(iCons(46, R:IntSeq)) => fscAcc(R, 1)
   182	  rule fracScale(iCons(C:Int, R:IntSeq)) => fracScale(R) requires C =/=Int 46
   183	  rule fscAcc(.IntSeq, A:Int) => A
   184	  rule fscAcc(iCons(_:Int, R:IntSeq), A:Int) => fscAcc(R, A *Int 10)
   185	  rule applyBuiltin("float", str(CS:IntSeq), .Vals) => decStrToF(CS)
   186	  rule applyBuiltin("float", I:Int, .Vals)          => intToF(I)
   187	  rule applyBuiltin("float", F:Float, .Vals)        => F
   188	
   189	  // ---- float / int division (promoted from mean_absolute_deviation) ----
   190	  syntax Float ::= divFloatIntV(Float, Int) [function, total, symbol(divFloatIntV), no-evaluators]
   191	  rule divFloatIntV(F:Float, I:Int) => F /Float Int2Float(I, 53, 11) [concrete]
   192	  rule applyBin("/", F:Float, I:Int) => divFloatIntV(F, I)
   193	
   194	  // ---- int -> float promotion for the remaining mixed arithmetic/compares ----
   195	  syntax Float ::= intToF(Int) [function, total, symbol(intToF), no-evaluators]
   196	  rule intToF(I:Int) => Int2Float(I, 53, 11) [concrete]
   197	  rule applyBin("+", I:Int, F:Float) => addF(intToF(I), F)
   198	  rule applyBin("+", F:Float, I:Int) => addF(F, intToF(I))
   199	  rule applyBin("-", I:Int, F:Float) => subF(intToF(I), F)
   200	  rule applyBin("-", F:Float, I:Int) => subF(F, intToF(I))
   201	  rule applyBin("*", I:Int, F:Float) => mulF(intToF(I), F)
   202	  rule applyBin("*", F:Float, I:Int) => mulF(F, intToF(I))
   203	  rule applyCmp("<", I:Int, F:Float) => floatLt(intToF(I), F)
   204	  rule applyCmp("<", F:Float, I:Int) => floatLt(F, intToF(I))
   205	  rule applyCmp(">", I:Int, F:Float) => gtF(intToF(I), F)
   206	  rule applyCmp(">", F:Float, I:Int) => gtF(F, intToF(I))
   207	
   208	  // ---- conversions: int(float) truncates toward zero; float(int); round; math.sqrt ----
   209	  syntax Int ::= truncF(Float) [function, total, symbol(truncF), no-evaluators]
   210	  rule truncF(F:Float) => #if F >=Float 0.0 #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi [concrete]
   211	  rule applyBuiltin("int", F:Float, .Vals) => truncF(F)
   212	
   213	  rule applyBuiltin("float", I:Int, .Vals)   => intToF(I)
   214	  rule applyBuiltin("float", F:Float, .Vals) => F
   215	
   216	  // round: Python half-even (banker's); round(F, N) scales by 10^N
   217	  syntax Int ::= roundF(Float) [function, total, symbol(roundF), no-evaluators]
   218	  rule roundF(F:Float)
   219	    => #if (F -Float floorFloat(F)) ==Float 0.5
   220	       #then (#if Float2Int(floorFloat(F)) %Int 2 ==Int 0
   221	              #then Float2Int(floorFloat(F)) #else Float2Int(ceilFloat(F)) #fi)
   222	       #else Float2Int(floorFloat(F +Float 0.5)) #fi [concrete]
   223	  syntax Float ::= roundFN(Float, Int) [function, total, symbol(roundFN), no-evaluators]
   224	  rule roundFN(F:Float, N:Int)
   225	    => Int2Float(roundF(F *Float Int2Float(10 ^Int N, 53, 11)), 53, 11)
   226	       /Float Int2Float(10 ^Int N, 53, 11) [concrete]
   227	  rule applyBuiltin("round", F:Float, .Vals)        => roundF(F)
   228	  rule applyBuiltin("round", F:Float, N:Int, .Vals) => roundFN(F, N)
   229	
   230	  syntax Float ::= sqrtF(Float) [function, total, symbol(sqrtF), no-evaluators]
   231	  rule sqrtF(F:Float) => sqrtFloat(F) [concrete]
   232	  syntax KItem ::= "#mathSqrt"
   233	  rule <k> Call(Attribute(Name("math"), "sqrt"), (E:Expr, .Exprs)) => E ~> #mathSqrt ... </k> [priority(40)]
   234	  rule <k> F:Float ~> #mathSqrt => sqrtF(F) ... </k>
   235	  rule <k> I:Int ~> #mathSqrt => sqrtF(intToF(I)) ... </k>
   236	
   237	  // ---- min / max over a FLOAT list — FLOAT branch of the shared #minCont0/#maxCont0 folds (which
   238	  // seed/step with `requires isInt(V)`, so they are STUCK on floats). These add the `requires
   239	  // isFloat(V)` seed + a Float-accumulator fold via K's minFloat/maxFloat — concrete for krun. A proof
   240	  // over a SYMBOLIC float list intercepts min/max problem-locally to an opaque minVF/maxVF (at
   241	  // #applyK, priority 40, in its verification.k) BEFORE #minAcc0, so this fold is krun-only. Additive:
   242	  // the isFloat guard is disjoint from the existing isInt one.
   243	  syntax KItem ::= #maxAccF(Iterable, Float) | #maxContF(Float)
   244	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   245	  rule <k> #maxAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #maxContF(M) ... </k>
   246	  rule <k> #iterDone ~> #maxContF(M:Float) => M ... </k>
   247	  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContF(M:Float) => #maxAccF(R, maxFloat(M, {V}:>Float)) ... </k>
   248	       requires isFloat(V)
   249	
   250	  syntax KItem ::= #minAccF(Iterable, Float) | #minContF(Float)
   251	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAccF(R, {V}:>Float) ... </k> requires isFloat(V)
   252	  rule <k> #minAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #minContF(M) ... </k>
   253	  rule <k> #iterDone ~> #minContF(M:Float) => M ... </k>
   254	  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContF(M:Float) => #minAccF(R, minFloat(M, {V}:>Float)) ... </k>
   255	       requires isFloat(V)
   256	
   257	  // ---- sum over a float list (krun; mirrors the min/max float paths). The Int-only shared
   258	  // #sumCont sticks on a Float yield; switch to a Float-headed fold via addF (concrete twin).
   259	  // The switch guard carries the SYNTACTIC negation of the Int rule's guard so a symbolic proof
   260	  // with isInt(V) in its path condition refutes this branch without sort reasoning.
   261	  syntax KItem ::= #sumAccF(Iterable, Float) | #sumContF(Float)
   262	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
   263	        => #sumAccF(R, addF(intToF(ACC), {V}:>Float)) ... </k>
   264	       requires isFloat(V) andBool notBool (isInt(V) orBool isBool(V))
   265	  rule <k> #sumAccF(IT:Iterable, ACC:Float) => #iterNext(IT) ~> #sumContF(ACC) ... </k>
   266	  rule <k> #iterDone ~> #sumContF(ACC:Float) => ACC ... </k>
   267	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   268	        => #sumAccF(R, addF(ACC, {V}:>Float)) ... </k>
   269	       requires isFloat(V)
   270	  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
   271	        => #sumAccF(R, addF(ACC, intToF(intOf(V)))) ... </k>
   272	       requires isInt(V) orBool isBool(V)
   273	endmodule

===== semantics/iter.k =====
     1	// reference/src/semantics/iter.k — MPY-ITER
     2	// The iterator protocol, DECLARATION ONLY. Each iterable's #iterNext case lives in that
     3	// iterable's own module (list/tuple/str in their modules, rangeObj in range.k, zip in
     4	// builtins.k). Consumers (the for-loop, `x in _`, sum/all/any/max/min) import this.
     5	
     6	module MPY-ITER
     7	  imports MPY-CORE
     8	  syntax KItem ::= #iterNext(Iterable) | "#iterDone" | #iterYield(Val, Iterable)
     9	endmodule

===== semantics/range.k =====
     1	// reference/src/semantics/range.k — MPY-RANGE
     2	// rangeObj: the range helpers (inRange / rangeLen) + its #iterNext case. rangeObj itself is
     3	// declared in MPY-CORE's Iterable union; this module owns its behavior.
     4	
     5	module MPY-RANGE
     6	  imports MPY-CORE
     7	  imports MPY-ITER
     8	
     9	  syntax Bool ::= inRange(Int, Int, Int) [function, total]
    10	  rule inRange(I:Int, HI:Int, ST:Int) => (ST >Int 0 andBool I <Int HI) orBool (ST <Int 0 andBool I >Int HI)
    11	
    12	  syntax Int ::= rangeLen(Int, Int, Int) [function]
    13	  rule rangeLen(LO:Int, HI:Int, ST:Int) => (HI -Int LO +Int ST -Int 1) /Int ST
    14	       requires ST >Int 0 andBool HI >Int LO
    15	  rule rangeLen(LO:Int, HI:Int, ST:Int) => (LO -Int HI -Int ST -Int 1) /Int (0 -Int ST)
    16	       requires ST <Int 0 andBool HI <Int LO
    17	  rule rangeLen(LO:Int, HI:Int, ST:Int) => 0
    18	       requires (ST >Int 0 andBool HI <=Int LO) orBool (ST <Int 0 andBool HI >=Int LO)
    19	
    20	  rule <k> #iterNext(rangeObj(I:Int, HI:Int, ST:Int))
    21	        => #iterYield(I, rangeObj(I +Int ST, HI, ST)) ... </k>
    22	       requires inRange(I, HI, ST)
    23	  rule <k> #iterNext(rangeObj(I:Int, HI:Int, ST:Int)) => #iterDone ... </k>
    24	       requires notBool inRange(I, HI, ST)
    25	endmodule

diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..2660ee0040b958f34409880f2bf423bb05823733
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,106 @@
+#!/usr/bin/env python3
+"""Independent differential test for HumanEval 133."""
+
+from __future__ import annotations
+
+import importlib.util
+import math
+import random
+from pathlib import Path
+
+
+def load(path: str, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+canonical = load("/reference/canonical.py", "trusted_canonical_133")
+generated = load("/tmp/audit-work/candidate/solution.py", "generated_solution_133")
+
+documented = [
+    ([1, 2, 3], 14),
+    ([1, 4, 9], 98),
+    ([1, 3, 5, 7], 84),
+    ([1.4, 4.2, 0], 29),
+    ([-2.4, 1, 1], 6),
+]
+
+boundaries = [
+    [],
+    [0],
+    [-0.0],
+    [0.000000001],
+    [-0.000000001],
+    [0.999999999],
+    [1.0],
+    [1.000000001],
+    [-0.999999999],
+    [-1.0],
+    [-1.000000001],
+    [-1.999999999],
+    [-2.0],
+    [-2.000000001],
+    [10**30],
+    [-(10**30)],
+    [-2.4, 0, 1.4, 4.2],
+    list(range(-25, 26)),
+]
+
+rng = random.Random(133_2026)
+generated_inputs: list[list[int | float]] = []
+for _ in range(1000):
+    values: list[int | float] = []
+    for _ in range(rng.randrange(0, 25)):
+        if rng.randrange(3) == 0:
+            values.append(rng.randrange(-10_000, 10_001))
+        else:
+            numerator = rng.randrange(-1_000_000, 1_000_001)
+            denominator = rng.choice((10, 100, 1000, 10_000))
+            values.append(numerator / denominator)
+    generated_inputs.append(values)
+
+cases = [case for case, _ in documented] + boundaries + generated_inputs
+mismatches: list[tuple[list[int | float], object, object]] = []
+
+for case, expected in documented:
+    can = canonical.sum_squares(list(case))
+    got = generated.sum_squares(list(case))
+    if can != expected or got != expected:
+        mismatches.append((case, can, got))
+
+for case in boundaries + generated_inputs:
+    try:
+        can: object = canonical.sum_squares(list(case))
+    except Exception as err:  # compare exception types as observable behavior
+        can = ("EXCEPTION", type(err).__name__, str(err))
+    try:
+        got: object = generated.sum_squares(list(case))
+    except Exception as err:
+        got = ("EXCEPTION", type(err).__name__, str(err))
+    if can != got:
+        mismatches.append((case, can, got))
+
+print("oracle=/reference/canonical.py:sum_squares")
+print("candidate=/tmp/audit-work/candidate/solution.py:sum_squares")
+print(f"documented_examples={len(documented)}")
+print(f"hand_boundary_cases={len(boundaries)}")
+print(f"seed=1332026 generated_cases={len(generated_inputs)}")
+print(f"total_cases={len(cases)}")
+print(f"mismatch_count={len(mismatches)}")
+for mismatch in mismatches[:20]:
+    print(f"MISMATCH {mismatch!r}")
+
+for witness in ([], [1.4, 4.2, 0], [-2.4, 1, 1], [2.0001, -2.0001]):
+    print(
+        "WITNESS "
+        f"input={witness!r} "
+        f"canonical={canonical.sum_squares(list(witness))!r} "
+        f"candidate={generated.sum_squares(list(witness))!r}"
+    )
+
+if mismatches:
+    raise SystemExit(1)
diff --git a/evidence/stage1_integrity.py b/evidence/stage1_integrity.py
new file mode 100644
index 0000000000000000000000000000000000000000..9fec8030c81aba4f0c4e5a491ee836dd10698afa
--- /dev/null
+++ b/evidence/stage1_integrity.py
@@ -0,0 +1,191 @@
+#!/usr/bin/env python3
+"""Independent provenance and mount-integrity checks for the audit."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import stat
+from collections import Counter
+from pathlib import Path
+
+
+AUDIT = Path("/audit-input.json")
+LOCK = Path("/audit-campaign-lock.json")
+GEN = Path("/generation-evidence")
+TRACE = GEN / "codex-trace/2026/07/23/rollout-2026-07-23T06-21-08-019f8eb5-362d-7ac3-b26b-bb7e5f57964a.jsonl"
+
+
+def digest(path: Path) -> str:
+    h = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            h.update(block)
+    return h.hexdigest()
+
+
+def regular_file(path: Path) -> bool:
+    try:
+        mode = path.lstat().st_mode
+    except FileNotFoundError:
+        return False
+    return stat.S_ISREG(mode) and not stat.S_ISLNK(mode)
+
+
+def compare_trees(left: Path, right: Path) -> list[str]:
+    problems: list[str] = []
+    left_entries = {str(p.relative_to(left)): p for p in left.rglob("*")}
+    right_entries = {str(p.relative_to(right)): p for p in right.rglob("*")}
+    for rel in sorted(set(left_entries) | set(right_entries)):
+        a = left_entries.get(rel)
+        b = right_entries.get(rel)
+        if a is None:
+            problems.append(f"missing-left {rel}")
+            continue
+        if b is None:
+            problems.append(f"additional-left {rel}")
+            continue
+        am = a.lstat().st_mode
+        bm = b.lstat().st_mode
+        ak = "symlink" if stat.S_ISLNK(am) else "dir" if stat.S_ISDIR(am) else "file" if stat.S_ISREG(am) else "other"
+        bk = "symlink" if stat.S_ISLNK(bm) else "dir" if stat.S_ISDIR(bm) else "file" if stat.S_ISREG(bm) else "other"
+        if ak != bk:
+            problems.append(f"type {rel}: {ak} != {bk}")
+        elif ak == "symlink":
+            problems.append(f"symlink {rel}")
+        elif ak == "file" and digest(a) != digest(b):
+            problems.append(f"content {rel}")
+    return problems
+
+
+data = json.loads(AUDIT.read_text())
+lock = json.loads(LOCK.read_text())
+expected = data["hashes"]
+
+required = [
+    AUDIT,
+    LOCK,
+    Path("/run.json"),
+    Path("/task.json"),
+    Path("/generation-result.json"),
+    GEN / "invocation.json",
+    GEN / "metrics.json",
+    GEN / "codex-last.txt",
+    GEN / "codex-output.log",
+    GEN / "prompt.txt",
+    GEN / "usage.json",
+    TRACE,
+    Path("/reference/canonical.py"),
+    Path("/reference/prompt.py"),
+    Path("/reference/py2mpy.py"),
+]
+
+print("REQUIRED REGULAR NON-SYMLINK FILES")
+for path in required:
+    print(f"{'OK' if regular_file(path) else 'BAD'} {path}")
+
+checks = {
+    LOCK: expected["audit_campaign_lock_sha256"],
+    Path("/run.json"): expected["run_manifest_sha256"],
+    Path("/task.json"): expected["task_manifest_sha256"],
+    Path("/generation-result.json"): expected["stage1_result_sha256"],
+    GEN / "invocation.json": expected["stage1_invocation_sha256"],
+    GEN / "metrics.json": expected["generation_metrics_sha256"],
+    GEN / "codex-last.txt": expected["generation_codex_last_sha256"],
+    GEN / "codex-output.log": expected["generation_codex_output_sha256"],
+    GEN / "prompt.txt": expected["generation_prompt_sha256"],
+    GEN / "usage.json": expected["generation_usage_sha256"],
+    Path("/candidate/prompt.py"): expected["candidate_prompt_sha256"],
+    Path("/candidate/py2mpy.py"): expected["candidate_translator_sha256"],
+    Path("/reference/canonical.py"): expected["canonical_sha256"],
+    Path("/reference/prompt.py"): expected["trusted_prompt_sha256"],
+    Path("/reference/py2mpy.py"): expected["trusted_translator_sha256"],
+}
+
+print("\nRECORDED FILE HASHES")
+for path, want in checks.items():
+    got = digest(path)
+    print(f"{'MATCH' if got == want else 'MISMATCH'} {got} {path} expected={want}")
+
+result = json.loads(Path("/generation-result.json").read_text())
+trace_rel = str(TRACE.relative_to(GEN))
+trace_expected = result["outputs"]["evidence"][trace_rel]
+trace_got = digest(TRACE)
+print(f"{'MATCH' if trace_got == trace_expected else 'MISMATCH'} {trace_got} {TRACE} expected={trace_expected}")
+
+print("\nCAMPAIGN LOCK")
+print(f"exact_json_match={lock == data['audit_campaign']}")
+print(f"lock_file_hash_match={digest(LOCK) == expected['audit_campaign_lock_sha256']}")
+
+print("\nTRUSTED-CANDIDATE BYTE CHECKS")
+for candidate, trusted in [
+    (Path("/candidate/prompt.py"), Path("/reference/prompt.py")),
+    (Path("/candidate/py2mpy.py"), Path("/reference/py2mpy.py")),
+]:
+    same = candidate.read_bytes() == trusted.read_bytes()
+    print(f"{'IDENTICAL' if same else 'DIFFERENT'} {candidate} {trusted}")
+
+tree_problems = compare_trees(
+    Path("/candidate/reference-semantics"),
+    Path("/reference/reference-semantics"),
+)
+print("\nREFERENCE SEMANTICS RECURSIVE COMPARISON")
+print(f"problem_count={len(tree_problems)}")
+for problem in tree_problems:
+    print(problem)
+
+print("\nREFERENCE SEMANTICS FILE HASHES")
+root = Path("/reference/reference-semantics")
+for path in sorted(root.rglob("*")):
+    if path.is_file() and not path.is_symlink():
+        print(f"{digest(path)}  {path.relative_to(root)}")
+
+print("\nSTRUCTURED TRACE FULL-PARSE SUMMARY")
+top_types: Counter[str] = Counter()
+payload_types: Counter[str] = Counter()
+tool_calls: list[tuple[str, str]] = []
+tool_outputs = 0
+assistant_messages: list[str] = []
+line_count = 0
+with TRACE.open(encoding="utf-8") as stream:
+    for line_count, line in enumerate(stream, 1):
+        item = json.loads(line)
+        top_types[str(item.get("type"))] += 1
+        payload = item.get("payload")
+        if isinstance(payload, dict):
+            payload_type = str(payload.get("type"))
+            payload_types[payload_type] += 1
+            if item.get("type") == "response_item" and payload_type == "function_call":
+                tool_calls.append((str(payload.get("name")), str(payload.get("arguments"))))
+            elif item.get("type") == "response_item" and payload_type == "function_call_output":
+                tool_outputs += 1
+            elif item.get("type") == "response_item" and payload_type == "message":
+                if payload.get("role") == "assistant":
+                    texts = []
+                    for content in payload.get("content", []):
+                        if isinstance(content, dict) and "text" in content:
+                            texts.append(str(content["text"]))
+                    if texts:
+                        assistant_messages.append("\n".join(texts))
+
+print(f"parsed_lines={line_count}")
+print(f"top_types={dict(sorted(top_types.items()))}")
+print(f"payload_types={dict(sorted(payload_types.items()))}")
+print(f"function_calls={len(tool_calls)} function_outputs={tool_outputs}")
+for index, (name, arguments) in enumerate(tool_calls, 1):
+    flattened = " ".join(arguments.split())
+    print(f"call[{index}] name={name} args={flattened[:320]}")
+print(f"assistant_message_count={len(assistant_messages)}")
+if assistant_messages:
+    print("final_assistant_message=" + " ".join(assistant_messages[-1].split()))
+
+print("\nCANDIDATE TREE FILE HASHES")
+candidate_root = Path("/candidate")
+for path in sorted(candidate_root.rglob("*")):
+    mode = path.lstat().st_mode
+    rel = path.relative_to(candidate_root)
+    if stat.S_ISLNK(mode):
+        print(f"SYMLINK {rel} -> {os.readlink(path)}")
+    elif stat.S_ISREG(mode):
+        print(f"{digest(path)}  {rel}")
diff --git a/evidence/stage2_program_fidelity.sh b/evidence/stage2_program_fidelity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..cdefdd0e8023965e85555b30c2a5918ca4742a9c
--- /dev/null
+++ b/evidence/stage2_program_fidelity.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -u
+
+cd /tmp/audit-work/candidate || exit 90
+
+printf '%s\n' '$ python3 /reference/py2mpy.py solution.py > solution.regenerated.mpy'
+python3 /reference/py2mpy.py solution.py > solution.regenerated.mpy
+translate_status=$?
+printf 'EXIT: %s\n' "$translate_status"
+
+printf '%s\n' '$ sha256sum solution.mpy solution.regenerated.mpy'
+sha256sum solution.mpy solution.regenerated.mpy
+hash_status=$?
+printf 'EXIT: %s\n' "$hash_status"
+
+printf '%s\n' '$ cmp solution.mpy solution.regenerated.mpy'
+cmp solution.mpy solution.regenerated.mpy
+cmp_status=$?
+printf 'EXIT: %s\n' "$cmp_status"
+
+printf '%s\n' '$ python3 /audit-output/evidence/differential_test.py'
+python3 /audit-output/evidence/differential_test.py
+diff_status=$?
+printf 'EXIT: %s\n' "$diff_status"
+
+if (( translate_status != 0 || hash_status != 0 || cmp_status != 0 || diff_status != 0 )); then
+  exit 1
+fi
diff --git a/evidence/stage3_clean_rebuild.sh b/evidence/stage3_clean_rebuild.sh
new file mode 100644
index 0000000000000000000000000000000000000000..b5d427e3bc745ddcb5c588a525b3dd6af38b3b20
--- /dev/null
+++ b/evidence/stage3_clean_rebuild.sh
@@ -0,0 +1,75 @@
+#!/usr/bin/env bash
+set -u
+
+work=/tmp/audit-work/candidate
+cd "$work" || exit 90
+
+run_plain() {
+  printf '\n$ %s\n' "$*"
+  "$@"
+  local status=$?
+  printf 'EXIT: %s\n' "$status"
+  return "$status"
+}
+
+run_proof() {
+  printf '\n$ %s\n' "$*"
+  local output
+  output=$("$@" 2>&1)
+  local status=$?
+  printf '%s\n' "$output"
+  printf 'EXIT: %s\n' "$status"
+  if (( status != 0 )); then
+    return "$status"
+  fi
+  if ! grep -Fxq '#Top' <<<"$output"; then
+    printf '%s\n' 'ERROR: exit 0 without an exact #Top output line'
+    return 91
+  fi
+}
