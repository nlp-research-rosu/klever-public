diff --git a//tmp/audit-work/candidate/spec-vacuity-audit.k b//tmp/audit-work/candidate/spec-vacuity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..d9d64b7d332b512f484dc1759d5404eb23ba4611
--- /dev/null
