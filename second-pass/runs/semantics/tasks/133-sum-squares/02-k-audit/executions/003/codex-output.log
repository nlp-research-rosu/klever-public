+requires "verification.k"
+
+module SUM-SQUARES-BODY-MUTATION-SPEC
+  imports SUM-SQUARES-VERIFICATION
+
+  // Executed body mutation: exponent 2 -> 3. On [2], this returns 8, not 4.
+  claim [body-sensitive]:
+    <k>
+      Call(
+        closureVal(
+          ("lst", .ParamNames),
+          Assign(Name("result"), Int(0))
+          For(
+            Name("number"),
+            Name("lst"),
+            AugAssign(
+              Name("result"),
+              "+",
+              BinOp(
+                "**",
+                Call(Attribute(Name("math"), "ceil"), Name("number")),
+                Int(3))))
+          Return(Name("result")),
+          0),
+        list(vCons(2, .ValSeq)))
+      ~> CONT:K
+      =>
+      4 ~> CONT
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+endmodule
