+                "**",
+                Call(Attribute(Name("math"), "ceil"), Name("number")),
+                Int(2))))
+          Return(Name("result")),
+          0),
+        list(.ValSeq))
+      ~> CONT:K
+      =>
+      0 ~> CONT
+    </k>
+    <env> 0 </env>
