     6	  imports MPY-LIST
     7	  imports MPY-CONTROLS
     8	  imports MPY-FUNCTIONS
     9	
    10	  // A comprehension is pure syntactic sugar
    11	  rule ListComp(ELT:Expr, Gs:CompFors) => Call(closureExpr(.ParamNames, compBody(Gs, ELT)), .Exprs)
    12	  rule GenExp(ELT:Expr, Gs:CompFors)   => Call(closureExpr(.ParamNames, compBody(Gs, ELT)), .Exprs)
    13	
    14	  syntax Stmts ::= compBody(CompFors, Expr) [macro]
    15	  rule compBody(Gs:CompFors, ELT:Expr)
    16	    => Assign(Name("$acc"), ListExpr(.Exprs)) compNest(Gs, ELT) Return(Name("$acc"))
    17	
    18	  syntax Stmt ::= compNest(CompFors, Expr) [macro-rec]
    19	  rule compNest(.CompFors, ELT:Expr)
    20	    => Assign(Name("$acc"), BinOp("+", Name("$acc"), ListExpr(ELT)))
    21	  rule compNest((CompFor(T:Expr, ITER:Expr, Fs:Exprs) GRest:CompFors), ELT:Expr)
    22	    => For(T, ITER, If(compGuard(Fs), compNest(GRest, ELT), .Stmts))
    23	
    24	  syntax Expr ::= compGuard(Exprs) [macro]
    25	  rule compGuard(.Exprs)             => Bool(true)
    26	  rule compGuard((F:Expr, Fs:Exprs)) => BoolOp("and", (F, Fs))
    27	endmodule

===== verification.k =====
     1	requires "reference-semantics/semantics.k"
     2	
     3	module SUM-SQUARES-VERIFICATION-BASE
     4	  imports MPY
     5	
     6	  // Mathematical summary of the implementation's left-to-right accumulator.
     7	  syntax Int ::= sumSquaresFrom(Int, ValSeq) [function, total]
     8	  rule sumSquaresFrom(ACC:Int, .ValSeq) => ACC
     9	  rule sumSquaresFrom(ACC:Int, vCons(V:Val, REST:ValSeq))
    10	    => sumSquaresFrom(ACC +Int (ceilF(V) ^Int 2), REST)
    11	
    12	  // Final value of the loop target; needed only to state the complete scope
    13	  // update without hiding the target variable behind an existential.
    14	  syntax Val ::= lastFrom(Val, ValSeq) [function, total]
    15	  rule lastFrom(CURRENT:Val, .ValSeq) => CURRENT
    16	  rule lastFrom(_:Val, vCons(V:Val, REST:ValSeq))
    17	    => lastFrom(V, REST)
    18	endmodule
    19	
    20	// Downstream proof definition.  The rule below is textually the loop theorem
    21	// proved as SUM-SQUARES-LOOP-SPEC.loop-correct against the BASE module.  It is
    22	// compiled only after that proof command succeeds (see prove.sh), allowing the
    23	// end-to-end function theorem to use the established loop lemma.
    24	module SUM-SQUARES-VERIFICATION
    25	  imports SUM-SQUARES-VERIFICATION-BASE
    26	
    27	  rule
    28	    <k>
    29	      #loop(
    30	        list(VS:ValSeq),
    31	        Name("number"),
    32	        AugAssign(
    33	          Name("result"),
    34	          "+",
    35	          BinOp(
    36	            "**",
    37	            Call(Attribute(Name("math"), "ceil"), Name("number")),
    38	            Int(2)))
    39	      )
    40	      ~> CONT:K
    41	      =>
    42	      CONT
    43	    </k>
    44	    <env> L:Int </env>
    45	    <scopes>
    46	      (L |->
    47	        scope(
    48	          "lst" |-> INPUT:Val
    49	          "number" |-> (CURRENT:Val => lastFrom(CURRENT, VS))
    50	          "result" |-> (ACC:Int => sumSquaresFrom(ACC, VS)),
    51	          PARENT:Parent))
    52	      GLOBAL:Map
    53	    </scopes>
    54	    requires notBool (L in_keys(GLOBAL))
    55	    [priority(40)]
    56	endmodule

===== spec.k =====
     1	requires "verification.k"
     2	
     3	module SUM-SQUARES-LOOP-SPEC
     4	  imports SUM-SQUARES-VERIFICATION-BASE
     5	
     6	  // The exact loop generated from solution.py.
     7	  claim [loop-correct]:
     8	    <k>
     9	      #loop(
