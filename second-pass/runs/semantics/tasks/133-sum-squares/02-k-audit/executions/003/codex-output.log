+  syntax KItem ::= auditSumSquares(ValSeq) [macro]
+  rule auditSumSquares(VS:ValSeq)
+    => Call(
+         closureVal(
+           ("lst", .ParamNames),
+           Assign(Name("result"), Int(0))
+           For(
+             Name("number"),
+             Name("lst"),
+             AugAssign(
+               Name("result"),
+               "+",
+               BinOp(
+                 "**",
+                 Call(Attribute(Name("math"), "ceil"), Name("number")),
+                 Int(2))))
+           Return(Name("result")),
+           0),
+         list(VS))
+
+  claim [ground-empty]:
+    <k> auditSumSquares(.ValSeq) ~> CONT:K => 0 ~> CONT </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+
+  claim [ground-ints]:
