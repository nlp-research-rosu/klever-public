+++ b/evidence/stage4_pinning.sh
@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
+set -u
+
+printf '%s\n' '$ python3 /audit-output/evidence/program_pinning.py'
+python3 /audit-output/evidence/program_pinning.py
+status=$?
