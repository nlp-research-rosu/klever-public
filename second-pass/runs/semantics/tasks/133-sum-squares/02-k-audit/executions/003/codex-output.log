+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+
+  claim [ground-floats]:
+    <k>
+      Call(
+        closureVal(
+          ("lst", .ParamNames),
+          Assign(Name("result"), Int(0))
+          For(
+            Name("number"),
+            Name("lst"),
+            AugAssign(
+              Name("result"),
+              "+",
+              BinOp(
+                "**",
+                Call(Attribute(Name("math"), "ceil"), Name("number")),
+                Int(2))))
+          Return(Name("result")),
+          0),
+        list(vCons(1.4, vCons(4.2, vCons(0, .ValSeq)))))
+      ~> CONT:K
+      =>
+      29 ~> CONT
+    </k>
+    <env> 0 </env>
