    15	          BinOp(
    16	            "**",
    17	            Call(Attribute(Name("math"), "ceil"), Name("number")),
    18	            Int(2)))
    19	      )
    20	      ~> CONT:K
    21	      =>
    22	      CONT
    23	    </k>
    24	    <env> L:Int </env>
    25	    <scopes>
    26	      (L |->
    27	        scope(
    28	          "lst" |-> INPUT:Val
    29	          "number" |-> (CURRENT:Val => lastFrom(CURRENT, VS))
    30	          "result" |-> (ACC:Int => sumSquaresFrom(ACC, VS)),
    31	          PARENT:Parent))
    32	      GLOBAL:Map
    33	    </scopes>
    34	    requires notBool (L in_keys(GLOBAL))
    35	
    36	endmodule
    37	
    38	module SUM-SQUARES-SPEC
    39	  imports SUM-SQUARES-VERIFICATION
    40	
    41	  // End-to-end call theorem for the closure body translated from solution.py.
    42	  claim [function-correct]:
    43	    <k>
    44	      Call(
    45	        closureVal(
    46	          ("lst", .ParamNames),
    47	          Assign(Name("result"), Int(0))
    48	          For(
    49	            Name("number"),
    50	            Name("lst"),
    51	            AugAssign(
    52	              Name("result"),
    53	              "+",
    54	              BinOp(
    55	                "**",
    56	                Call(Attribute(Name("math"), "ceil"), Name("number")),
    57	                Int(2))))
    58	          Return(Name("result")),
    59	          0),
    60	        list(VS:ValSeq))
    61	      ~> CONT:K
    62	      =>
    63	      sumSquaresFrom(0, VS)
    64	      ~> CONT
    65	    </k>
    66	    <env> 0 </env>
    67	    <scopes>
    68	      0 |-> scope(.Map, parent(-1))
    69	      -1 |-> builtinsScope
    70	    </scopes>
    71	    <scopeLoc> 1 </scopeLoc>
