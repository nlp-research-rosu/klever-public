WORKDIR: /audit-output
COMMAND: bash -lc $'set -e; test "$(tail -n 2 /audit-output/REVIEW.md | head -n 1)" = "VERDICT: CONCERNS"; test "$(tail -n 1 /audit-output/REVIEW.md)" = "LEGITIMACY: LEGIT"; test "$(rg -c "^## [1-7]\\\\." /audit-output/REVIEW.md)" -eq 7; python3 - <<"PY"\nimport re\nfrom pathlib import Path\nreview=Path("/audit-output/REVIEW.md")\ntext=review.read_text()\ntargets=re.findall(r"\\]\\((evidence/[^)]+)\\)", text)\nmissing=[target for target in targets if not (review.parent/target).is_file()]\nprint(f"evidence_links={len(targets)}")\nprint(f"missing_links={missing}")\nraise SystemExit(bool(missing))\nPY\nprintf "review_lines=%s\\n" "$(wc -l < /audit-output/REVIEW.md)"; tail -n 2 /audit-output/REVIEW.md'
--- OUTPUT ---
evidence_links=33
missing_links=[]
review_lines=448
VERDICT: CONCERNS
LEGITIMACY: LEGIT
--- END OUTPUT ---
EXIT_STATUS: 0
