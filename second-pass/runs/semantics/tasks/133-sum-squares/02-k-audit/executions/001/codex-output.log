diff --git a/evidence/spec-vacuity-loop-ground.k b/evidence/spec-vacuity-loop-ground.k
new file mode 100644
index 0000000000000000000000000000000000000000..8f27e6166c1c658150c45c5d1bbc8856e7bd0ac6
