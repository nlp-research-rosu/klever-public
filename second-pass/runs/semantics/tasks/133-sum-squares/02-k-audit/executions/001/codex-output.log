+        [float("nan")],
+        [float("inf")],
+        [float("-inf")],
+    ]
+
+    atom_pool: list[int | float] = [
+        -3,
+        -2.000000001,
+        -2,
+        -1.2,
+        -0.000000001,
+        0,
+        0.000000001,
+        1,
+        1.999999999,
+    ]
+    exhaustive = [
