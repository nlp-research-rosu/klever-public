+          For(
+            Name("number"),
+            Name("lst"),
+            AugAssign(
+              Name("result"),
+              "+",
+              BinOp(
+                "**",
+                Call(Attribute(Name("math"), "ceil"), Name("number")),
+                Int(2))))
+          Return(Name("result")),
+          0),
+        list(VS:ValSeq))
+      ~> CONT:K
+      =>
+      (sumSquaresFrom(0, VS) +Int 1)
+      ~> CONT
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+endmodule

