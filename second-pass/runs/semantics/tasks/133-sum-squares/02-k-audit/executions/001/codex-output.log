index 0000000000000000000000000000000000000000..120e8e6316843965262814f0f09af89ede91bf54
--- /dev/null
+++ b/evidence/concrete_witness.py
@@ -0,0 +1,16 @@
+import math
+
+
+def sum_squares(lst):
+    result = 0
+    for number in lst:
+        result += math.ceil(number) ** 2
+    return result
+
+
+# Satisfying ground instances used for the function claim and loop invariant.
+assert sum_squares([]) == 0
+assert sum_squares([1, 2, 3]) == 14
+assert sum_squares([1.4, 4.2, 0]) == 29
+assert sum_squares([-2.4, 1, 1]) == 6
+assert sum_squares([-1.000000001, -0.999999999, 1.000000001]) == 5
