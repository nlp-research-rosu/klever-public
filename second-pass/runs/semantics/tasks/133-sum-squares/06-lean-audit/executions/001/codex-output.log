new file mode 100644
index 0000000000000000000000000000000000000000..d2c6e99279912cc0e94e468dd4c0f4e35f241340
--- /dev/null
+++ b//tmp/audit-work/procself_readlink_shim.c
@@ -0,0 +1,24 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    const char *effective = path;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    if (path != NULL && strncmp(path, "/proc/", 6) == 0) {
+        const char *suffix = strrchr(path, '/');
+        if (suffix != NULL && strcmp(suffix, "/exe") == 0) {
+            effective = "/proc/self/exe";
+        }
+    }
+    return real_readlink(effective, buffer, size);
+}

