requires "reference-semantics/semantics.k"

module SUM-SQUARES-VERIFICATION-BASE
  imports MPY

  // Mathematical summary of the implementation's left-to-right accumulator.
  syntax Int ::= sumSquaresFrom(Int, ValSeq) [function, total]
  rule sumSquaresFrom(ACC:Int, .ValSeq) => ACC
  rule sumSquaresFrom(ACC:Int, vCons(V:Val, REST:ValSeq))
    => sumSquaresFrom(ACC +Int (ceilF(V) ^Int 2), REST)

  // Final value of the loop target; needed only to state the complete scope
  // update without hiding the target variable behind an existential.
  syntax Val ::= lastFrom(Val, ValSeq) [function, total]
  rule lastFrom(CURRENT:Val, .ValSeq) => CURRENT
  rule lastFrom(_:Val, vCons(V:Val, REST:ValSeq))
    => lastFrom(V, REST)
endmodule

// Downstream proof definition.  The rule below is textually the loop theorem
// proved as SUM-SQUARES-LOOP-SPEC.loop-correct against the BASE module.  It is
// compiled only after that proof command succeeds (see prove.sh), allowing the
// end-to-end function theorem to use the established loop lemma.
module SUM-SQUARES-VERIFICATION
  imports SUM-SQUARES-VERIFICATION-BASE

  rule
    <k>
      #loop(
        list(VS:ValSeq),
        Name("number"),
        AugAssign(
          Name("result"),
          "+",
          BinOp(
            "**",
            Call(Attribute(Name("math"), "ceil"), Name("number")),
            Int(2)))
      )
      ~> CONT:K
      =>
      CONT
    </k>
    <env> L:Int </env>
    <scopes>
      (L |->
        scope(
          "lst" |-> INPUT:Val
          "number" |-> (CURRENT:Val => lastFrom(CURRENT, VS))
          "result" |-> (ACC:Int => sumSquaresFrom(ACC, VS)),
          PARENT:Parent))
      GLOBAL:Map
    </scopes>
    requires notBool (L in_keys(GLOBAL))
    [priority(40)]
endmodule
requires "verification.k"

module SUM-SQUARES-LOOP-SPEC
  imports SUM-SQUARES-VERIFICATION-BASE

  // The exact loop generated from solution.py.
  claim [loop-correct]:
    <k>
      #loop(
        list(VS:ValSeq),
        Name("number"),
        AugAssign(
          Name("result"),
          "+",
          BinOp(
            "**",
            Call(Attribute(Name("math"), "ceil"), Name("number")),
            Int(2)))
      )
      ~> CONT:K
      =>
      CONT
    </k>
    <env> L:Int </env>
    <scopes>
      (L |->
        scope(
          "lst" |-> INPUT:Val
          "number" |-> (CURRENT:Val => lastFrom(CURRENT, VS))
          "result" |-> (ACC:Int => sumSquaresFrom(ACC, VS)),
          PARENT:Parent))
      GLOBAL:Map
    </scopes>
    requires notBool (L in_keys(GLOBAL))

endmodule

module SUM-SQUARES-SPEC
  imports SUM-SQUARES-VERIFICATION

  // End-to-end call theorem for the closure body translated from solution.py.
  claim [function-correct]:
    <k>
      Call(
        closureVal(
          ("lst", .ParamNames),
          Assign(Name("result"), Int(0))
          For(
            Name("number"),
            Name("lst"),
            AugAssign(
              Name("result"),
              "+",
              BinOp(
                "**",
                Call(Attribute(Name("math"), "ceil"), Name("number")),
                Int(2))))
          Return(Name("result")),
          0),
        list(VS:ValSeq))
      ~> CONT:K
      =>
      sumSquaresFrom(0, VS)
      ~> CONT
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
endmodule
#!/usr/bin/env bash
set -euo pipefail

# Translate the submitted implementation and the concrete smoke program.
python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py concrete_tests.py > concrete_tests.mpy

# Concrete execution uses the required LLVM main and syntax modules.
kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled
krun concrete_tests.mpy \
  --definition runtime-kompiled \
  --output pretty

# First prove the inductive loop lemma without assuming its promoted rule.
kompile verification.k \
  --backend haskell \
  --main-module SUM-SQUARES-VERIFICATION-BASE \
  --syntax-module MPY-SYNTAX \
  --output-definition loop-verification-kompiled
kprove spec.k \
  --definition loop-verification-kompiled \
  --spec-module SUM-SQUARES-LOOP-SPEC \
  --claims SUM-SQUARES-LOOP-SPEC.loop-correct \
  --output pretty

# Then make the proved loop lemma available to the end-to-end call proof.
kompile verification.k \
  --backend haskell \
  --main-module SUM-SQUARES-VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SUM-SQUARES-SPEC \
  --claims SUM-SQUARES-SPEC.function-correct \
  --output pretty

