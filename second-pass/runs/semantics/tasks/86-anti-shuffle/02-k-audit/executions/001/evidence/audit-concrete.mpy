Module(
  FuncDef("anti_shuffle", Params("s"),
    Assign(Name("result"), Str(""))
    Assign(Name("word"), Str(""))
    For(Name("word"), Call(Attribute(Name("s"), "split"), Str(" ")),
      AugAssign(
        Name("result"),
        "+",
        Call(
          Attribute(Str(""), "join"),
          Call(Name("sorted"), Call(Name("list"), Name("word")))))
      AugAssign(Name("result"), "+", Str(" ")))
    Return(
      Subscript(
        Name("result"),
        Slice(NoBound, UnaryOp("-", Int(1)), NoBound))))
  Assert(
    Compare(
      Call(Name("anti_shuffle"), Str("Hi")),
      CmpOp("==", Str("Hi"))))
  Assert(
    Compare(
      Call(Name("anti_shuffle"), Str("hello")),
      CmpOp("==", Str("ehllo"))))
  Assert(
    Compare(
      Call(Name("anti_shuffle"), Str("Hello World!!!")),
      CmpOp("==", Str("Hello !!!Wdlor"))))
  Assert(
    Compare(Call(Name("anti_shuffle"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("anti_shuffle"), Str("  ba  dc ")),
      CmpOp("==", Str("  ab  cd "))))
  Assert(
    Compare(
      Call(Name("anti_shuffle"), Str("ba")),
      CmpOp("==", Str("ab")))))
