+      "word"   |-> str(.IntSeq),
+      parent(0))
+    0  |-> scope(.Map, parent(-1))
+    -1 |-> builtinsScope
+    =>
+    ?SCBASE:Map
+  </scopes>
+  <heap> .Map </heap>
+  <heapLoc> 0 </heapLoc>
+endmodule
