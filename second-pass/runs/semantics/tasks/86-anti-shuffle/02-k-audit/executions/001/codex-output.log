+  <scopes>
+    1 |-> scope(
+      "result" |-> str(.IntSeq)
+      "s"      |-> str(iCons(98, iCons(97, .IntSeq)))
+      "word"   |-> str(.IntSeq),
+      parent(0))
+    0  |-> scope(.Map, parent(-1))
+    -1 |-> builtinsScope
+    =>
+    ?SCBASE:Map
+  </scopes>
+  <heap> .Map </heap>
+  <heapLoc> 0 </heapLoc>
+endmodule
