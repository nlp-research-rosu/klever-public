     1	requires "reference-semantics/semantics.k"
     2	
     3	module ANTI-SHUFFLE-BASE
     4	  imports MPY
     5	
     6	  // The two macros below are the exact constructor form emitted in
     7	  // solution.mpy.  Naming the blocks keeps the reachability claims readable.
     8	  syntax Stmts ::= "antiLoopBody" [macro]
     9	  rule antiLoopBody
    10	    => AugAssign(
    11	         Name("result"),
    12	         "+",
    13	         Call(
    14	           Attribute(Str(""), "join"),
    15	           Call(Name("sorted"), Call(Name("list"), Name("word")))))
    16	       AugAssign(Name("result"), "+", Str(" "))
    17	       .Stmts
    18	
    19	  syntax Stmts ::= "antiBody" [macro]
    20	  rule antiBody
    21	    => Assign(Name("result"), Str(""))
    22	       Assign(Name("word"), Str(""))
    23	       For(
    24	         Name("word"),
    25	         Call(Attribute(Name("s"), "split"), Str(" ")),
    26	         antiLoopBody)
    27	       Return(
    28	         Subscript(
    29	           Name("result"),
    30	           Slice(NoBound, UnaryOp("-", Int(1)), NoBound)))
    31	       .Stmts
    32	
    33	  // sortWord is the semantics-level meaning of
    34	  //     "".join(sorted(list(word)))
    35	  // sortVS is intentionally the supplied trusted symbolic sorting primitive.
    36	  syntax IntSeq ::= sortWord(IntSeq) [function, total]
    37	  rule sortWord(W:IntSeq)
    38	    => joinCodes(.IntSeq, sortVS(charsOf(W)))
    39	
    40	  // A typed sequence of word code sequences. This avoids asking the prover to
    41	  // recover "every element is a string" from an abstract ValSeq.
    42	  syntax Words ::= ".Words" | wCons(IntSeq, Words)
    43	
    44	  syntax ValSeq ::= wordVals(Words) [function, total]
    45	  rule wordVals(.Words) => .ValSeq
    46	  rule wordVals(wCons(W:IntSeq, REST:Words))
    47	    => vCons(str(W), wordVals(REST))
    48	
    49	  // The same recurrence as the supplied splitSep, with the result represented
    50	  // by Words. WORD-SPEC proves their equivalence.
    51	  syntax Words ::= splitWords(IntSeq, Int, IntSeq) [function, total]
    52	  rule splitWords(.IntSeq, _SEP:Int, CUR:IntSeq)
    53	    => wCons(CUR, .Words)
    54	  rule splitWords(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq)
    55	    => wCons(CUR, splitWords(R, SEP, .IntSeq))
    56	    requires C ==Int SEP
    57	  rule splitWords(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq)
    58	    => splitWords(R, SEP, seqConcat(CUR, iCons(C, .IntSeq)))
    59	    requires notBool (C ==Int SEP)
    60	
    61	  // emitWordSeq describes the loop before its final result[:-1]: every sorted
    62	  // word is followed by exactly one ASCII space.
    63	  syntax IntSeq ::= emitWordSeq(Words) [function, total]
    64	  rule emitWordSeq(.Words) => .IntSeq
    65	  rule emitWordSeq(wCons(W:IntSeq, REST:Words))
    66	    => seqConcat(sortWord(W), iCons(32, emitWordSeq(REST)))
    67	
    68	  // Declarative contract. splitSep preserves empty fields, so leading,
    69	  // trailing, and repeated spaces are all preserved. The slice removes only
    70	  // the loop's one deliberately-added trailing space.
    71	  syntax Val ::= antiShuffleSpec(IntSeq) [function, total]
    72	  rule antiShuffleSpec(S:IntSeq)
    73	    => doSlice(
    74	         str(emitWordSeq(splitWords(S, 32, .IntSeq))),
    75	         noB,
    76	         someB(-1),
    77	         noB)
    78	
    79	  // Algebraic normalizations needed by the accumulator invariant. Both are
    80	  // standard consequences of seqConcat's defining equations.
    81	  rule seqConcat(A:IntSeq, .IntSeq) => A [simplification]
    82	  rule seqConcat(seqConcat(A:IntSeq, B:IntSeq), C:IntSeq)
    83	    => seqConcat(A, seqConcat(B, C))
    84	    [simplification]
    85	endmodule
    86	
    87	module ANTI-SHUFFLE-LOOP-VERIFICATION
    88	  imports ANTI-SHUFFLE-BASE
    89	
    90	  // Iteration-only view of split's result. The program never observes the
    91	  // temporary list except through For, so this avoids an opaque symbolic
    92	  // ValSeq while retaining splitSep's exact recurrence.
    93	  syntax Iterable ::= wordsObj(Words)
    94	  rule <k> #iterNext(wordsObj(.Words)) => #iterDone ... </k>
    95	  rule <k> #iterNext(wordsObj(wCons(W:IntSeq, REST:Words)))
    96	        => #iterYield(str(W), wordsObj(REST)) ... </k>
    97	
    98	  rule <k>
    99	         #applyK(
   100	           toCall(boundMethodV(str(S:IntSeq), "split")),
   101	           (str(iCons(SEP:Int, .IntSeq)), .Vals))
   102	         => wordsObj(splitWords(S, SEP, .IntSeq))
   103	         ...
   104	       </k>
   105	       [priority(35)]
   106	
   107	  // Observational summary of the two temporary list allocations used to sort
   108	  // one word. WORD-SPEC proves this composition separately from MPY rules.
   109	  rule <k>
   110	         Call(
   111	           Attribute(Str(""), "join"),
   112	           Call(Name("sorted"), Call(Name("list"), Name("word"))))
   113	         => str(sortWord(W))
   114	         ...
   115	       </k>
   116	       <env> L:Int </env>
   117	       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
   118	       requires "word" in_keys(M)
   119	       andBool {M["word"]}:>Val ==K str(W:IntSeq)
   120	       [priority(40)]
   121	endmodule
   122	
   123	module ANTI-SHUFFLE-VERIFICATION
   124	  imports ANTI-SHUFFLE-LOOP-VERIFICATION
   125	
   126	  // This is the proved anti-loop reachability invariant, installed as a
   127	  // summary for the end-to-end claim. loop-spec.k proves it without this rule.
   128	  rule <k>
   129	         #loop(wordsObj(WS:Words), Name("word"), antiLoopBody)
   130	         => .K
   131	         ...
   132	       </k>
   133	       <env> 1 </env>
   134	       <scopes>
   135	         ... 1 |-> scope(
   136	           (("result" |-> str(A:IntSeq)) M:Map)
   137	           =>
   138	           (("result" |-> str(seqConcat(A, emitWordSeq(WS)))) M),
   139	           P:Parent)
   140	         ...
   141	       </scopes>
   142	       requires notBool ("result" in_keys(M))
   143	       [priority(40)]
   144	endmodule

