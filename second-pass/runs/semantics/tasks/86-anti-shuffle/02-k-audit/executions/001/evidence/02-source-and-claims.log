     6	  // The allocation-free word summary used by the main proof is exactly the
     7	  // observable value produced by list(word), sorted(...), and "".join(...).
     8	  claim [sort-word-summary]:
     9	    <k>
    10	      Call(
    11	        Attribute(Str(""), "join"),
    12	        Call(Name("sorted"), Call(Name("list"), str(W:IntSeq))))
    13	      =>
    14	      str(sortWord(W))
    15	    </k>
    16	    <env> 0 </env>
    17	    <scopes>
    18	      0  |-> scope(.Map, parent(-1))
    19	      -1 |-> builtinsScope
    20	    </scopes>
    21	    <scopeLoc> 1 </scopeLoc>
    22	    <heap> H:Map => ?HFINAL:Map </heap>
    23	    <heapLoc> N:Int => ?NFINAL:Int </heapLoc>
    24	    <stack> .List </stack>
    25	    <ret> noRet </ret>
    26	    <exc> NoExc </exc>
    27	    <exit-code> 0 </exit-code>
    28	    requires notBool (N in_keys(H))
