     1	def anti_shuffle(s):
     2	    result = ""
     3	    word = ""
     4	    for word in s.split(" "):
     5	        result += "".join(sorted(list(word)))
     6	        result += " "
     7	    return result[:-1]
     8	
     9	
    10	assert anti_shuffle("Hi") == "Hi"
    11	assert anti_shuffle("hello") == "ehllo"
    12	assert anti_shuffle("Hello World!!!") == "Hello !!!Wdlor"
    13	assert anti_shuffle("") == ""
    14	assert anti_shuffle("  ba  dc ") == "  ab  cd "

