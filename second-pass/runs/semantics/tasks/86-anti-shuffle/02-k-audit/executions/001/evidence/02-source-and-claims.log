     1	
     2	def anti_shuffle(s):
     3	    """
     4	    Write a function that takes a string and returns an ordered version of it.
     5	    Ordered version of string, is a string where all words (separated by space)
     6	    are replaced by a new word where all the characters arranged in
     7	    ascending order based on ascii value.
     8	    Note: You should keep the order of words and blank spaces in the sentence.
     9	
    10	    For example:
    11	    anti_shuffle('Hi') returns 'Hi'
    12	    anti_shuffle('hello') returns 'ehllo'
    13	    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'
    14	    """

===== /reference/canonical.py =====
     1	# canonical.py — the UNMODIFIED HumanEval/86 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: anti_shuffle
     4	
     5	
     6	def anti_shuffle(s):
     7	    """
     8	    Write a function that takes a string and returns an ordered version of it.
     9	    Ordered version of string, is a string where all words (separated by space)
    10	    are replaced by a new word where all the characters arranged in
    11	    ascending order based on ascii value.
    12	    Note: You should keep the order of words and blank spaces in the sentence.
    13	
    14	    For example:
    15	    anti_shuffle('Hi') returns 'Hi'
    16	    anti_shuffle('hello') returns 'ehllo'
    17	    anti_shuffle('Hello World!!!') returns 'Hello !!!Wdlor'
    18	    """
    19	    return ' '.join([''.join(sorted(list(i))) for i in s.split(' ')])

===== /candidate/solution.py =====
     1	def anti_shuffle(s):
     2	    result = ""
     3	    word = ""
     4	    for word in s.split(" "):
     5	        result += "".join(sorted(list(word)))
     6	        result += " "
     7	    return result[:-1]

