+requires "reference-semantics/semantics.k"
+
+module ANTI-SHUFFLE-VERIFICATION
+  imports MPY
+
+  // The two macros below are the exact constructor form emitted in
+  // solution.mpy.  Naming the blocks keeps the reachability claims readable.
+  syntax Stmts ::= "antiLoopBody" [macro]
+  rule antiLoopBody
+    => AugAssign(
+         Name("result"),
+         "+",
+         Call(
+           Attribute(Str(""), "join"),
+           Call(Name("sorted"), Call(Name("list"), Name("word")))))
+       AugAssign(Name("result"), "+", Str(" "))
+       .Stmts
+
+  syntax Stmts ::= "antiBody" [macro]
+  rule antiBody
+    => Assign(Name("result"), Str(""))
+       For(
+         Name("word"),
+         Call(Attribute(Name("s"), "split"), Str(" ")),
+         antiLoopBody)
+       Return(
+         Subscript(
+           Name("result"),
+           Slice(NoBound, UnaryOp("-", Int(1)), NoBound)))
+       .Stmts
+
+  // sortWord is the semantics-level meaning of
+  //     "".join(sorted(list(word)))
+  // sortVS is intentionally the supplied trusted symbolic sorting primitive.
+  syntax IntSeq ::= sortWord(IntSeq) [function, total]
+  rule sortWord(W:IntSeq)
+    => joinCodes(.IntSeq, sortVS(charsOf(W)))
+
+  // emitWords describes the loop before its final result[:-1]: every sorted
+  // word is followed by exactly one ASCII space.
+  syntax IntSeq ::= emitWords(ValSeq) [function, total]
+  rule emitWords(.ValSeq) => .IntSeq
+  rule emitWords(vCons(str(W:IntSeq), REST:ValSeq))
+    => seqConcat(sortWord(W), iCons(32, emitWords(REST)))
+
+  // Declarative contract. splitSep preserves empty fields, so leading,
+  // trailing, and repeated spaces are all preserved. The slice removes only
+  // the loop's one deliberately-added trailing space.
+  syntax Val ::= antiShuffleSpec(IntSeq) [function, total]
+  rule antiShuffleSpec(S:IntSeq)
+    => doSlice(
+         str(emitWords(splitSep(S, 32, .IntSeq))),
+         noB,
+         someB(-1),
+         noB)
+
+  // Algebraic normalizations needed by the accumulator invariant. Both are
+  // standard consequences of seqConcat's defining equations.
+  rule seqConcat(A:IntSeq, .IntSeq) => A [priority(40)]
+  rule seqConcat(seqConcat(A:IntSeq, B:IntSeq), C:IntSeq)
+    => seqConcat(A, seqConcat(B, C))
+    [priority(40)]
+endmodule
*** Add File: /work/spec.k
+requires "verification.k"
+
+module ANTI-SHUFFLE-SPEC
+  imports ANTI-SHUFFLE-VERIFICATION
+
+  // Inductive loop invariant. Starting with prefix A and remaining words VS,
+  // the loop leaves exactly A ++ emitWords(VS). Heap growth is existential:
+  // list(word) and sorted(...) allocate fresh temporary list objects.
+  claim [anti-loop]:
+    <k>
+      #loop(list(VS:ValSeq), Name("word"), antiLoopBody)
+      ~> Name("result")
+      =>
+      str(seqConcat(A, emitWords(VS)))
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (L |-> scope(("result" |-> str(A:IntSeq)) M:Map, P:Parent))
+      SCREST:Map
+      =>
+      SCFINAL:Map
+    </scopes>
+    <heap> H:Map => HFINAL:Map </heap>
+    <heapLoc> N:Int => NFINAL:Int </heapLoc>
+    requires notBool ("result" in_keys(M))
+     andBool notBool (L in_keys(SCREST))
+
+  // End-to-end functional correctness of the exact solution body for every
+  // symbolic ASCII code sequence S accepted by the supplied string model.
+  claim [anti-shuffle-correct]:
+    <k>
+      Call(
+        closureVal(("s", .ParamNames), antiBody, 0),
+        (str(S:IntSeq), .Exprs))
+      =>
+      antiShuffleSpec(S)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => HFINAL:Map </heap>
+    <heapLoc> 0 => NFINAL:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
