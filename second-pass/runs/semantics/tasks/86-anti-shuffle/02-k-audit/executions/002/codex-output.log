+    trace_root = Path(record["container_paths"]["generation_trace"])
+    trace_entries, trace_ok = manifest(trace_root)
+    if not trace_ok or not trace_entries:
+        print("ERROR structured trace tree absent, empty, or mistyped")
+        failures += 1
+    else:
+        trace_files = [
