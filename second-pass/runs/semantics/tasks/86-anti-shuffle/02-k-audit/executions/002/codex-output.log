+    "🙂a 🚀Z",
+    "é é",
+    "中a 文B"
+  ],
+  "exhaustive": {
+    "alphabet": [
+      "\u0000",
+      " ",
+      "\t",
+      "A",
+      "a",
+      "!",
+      "é",
+      "🙂"
+    ],
