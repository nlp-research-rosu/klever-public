+  ],
+  "exhaustive": {
+    "alphabet": [
+      "\u0000",
+      " ",
+      "\t",
+      "A",
+      "a",
+      "!",
+      "é",
+      "🙂"
+    ],
+    "maximum_length": 5,
+    "method": "all Cartesian products for lengths 0 through maximum_length"
+  },
+  "random": {
+    "alphabet": "\u0000 \t\n!09AZazéΩ中🙂🚀",
+    "count": 1000,
+    "maximum_length": 60,
+    "minimum_length": 0,
+    "seed": 860086
+  }
+}
