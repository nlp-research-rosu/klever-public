index 0000000000000000000000000000000000000000..0bd46039615dfa477987efa172d2091babd1607c
--- /dev/null
+++ b//tmp/audit-work/86-anti-shuffle/stage4-body-mutation.py
@@ -0,0 +1,10 @@
+def anti_shuffle(s):
+    result = ""
+    word = ""
+    for word in s.split(" "):
+        result += "".join(sorted(list(word)))
+        result += "!"
+    return result[:-1]
+
+
+assert anti_shuffle("ba a") == "ab!a"
