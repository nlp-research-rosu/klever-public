+        "result" |-> str(A:IntSeq)
+        "s"      |-> str(INPUT:IntSeq)
+        "word"   |-> WORD0:Val,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?SCFINAL:Map
+    </scopes>
+    <heap> H:Map => ?HFINAL:Map </heap>
