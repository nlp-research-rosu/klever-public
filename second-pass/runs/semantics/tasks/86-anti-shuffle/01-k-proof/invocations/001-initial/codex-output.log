index 0000000000000000000000000000000000000000..8f934abd1edabebcaaf53e3431220007b51d6303
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,14 @@
+def anti_shuffle(s):
+    result = ""
+    word = ""
+    for word in s.split(" "):
+        result += "".join(sorted(list(word)))
+        result += " "
+    return result[:-1]
+
+
+assert anti_shuffle("Hi") == "Hi"
+assert anti_shuffle("hello") == "ehllo"
+assert anti_shuffle("Hello World!!!") == "Hello !!!Wdlor"
+assert anti_shuffle("") == ""
+assert anti_shuffle("  ba  dc ") == "  ab  cd "
diff --git a/loop-spec.k b/loop-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..914b3e4ed14c04ae4efde2e6da49657fc5a33ccc
--- /dev/null
+++ b/loop-spec.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module ANTI-LOOP-SPEC
+  imports ANTI-SHUFFLE-LOOP-VERIFICATION
+
+  // Inductive loop invariant. Starting with prefix A and remaining words WS,
+  // the loop leaves exactly A ++ emitWordSeq(WS).
+  claim [anti-loop]:
+    <k>
+      #loop(wordsObj(WS:Words), Name("word"), antiLoopBody)
+      ~> Name("result")
+      =>
+      str(seqConcat(A, emitWordSeq(WS)))
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "result" |-> str(A:IntSeq)
+        "s"      |-> str(INPUT:IntSeq)
+        "word"   |-> WORD0:Val,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?SCFINAL:Map
+    </scopes>
+    <heap> H:Map => ?HFINAL:Map </heap>
+    <heapLoc> N:Int => ?NFINAL:Int </heapLoc>
+endmodule
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..94b052d92df88ef2188bd6e19df9320d513a7ca6
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete-tests.mpy \
+  --definition runtime-kompiled \
+  --output none
+
+kompile verification.k \
+  --backend haskell \
+  --main-module ANTI-SHUFFLE-BASE \
+  --syntax-module MPY-SYNTAX \
+  --output-definition word-verification-kompiled
+
+kprove word-spec.k \
+  --definition word-verification-kompiled \
+  --spec-module WORD-SPEC
+
+kompile verification.k \
+  --backend haskell \
+  --main-module ANTI-SHUFFLE-LOOP-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition loop-verification-kompiled
+
+kprove loop-spec.k \
+  --definition loop-verification-kompiled \
+  --spec-module ANTI-LOOP-SPEC
+
+kompile verification.k \
+  --backend haskell \
+  --main-module ANTI-SHUFFLE-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module ANTI-SHUFFLE-SPEC
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..b29f7e10ec22a0d842e8702d2fee3577bac49d10
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,7 @@
+def anti_shuffle(s):
+    result = ""
+    word = ""
+    for word in s.split(" "):
+        result += "".join(sorted(list(word)))
+        result += " "
+    return result[:-1]
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..3428c230e42815694fa6564996e2513c1c1f1c3b
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,28 @@
+requires "verification.k"
+
+module ANTI-SHUFFLE-SPEC
+  imports ANTI-SHUFFLE-VERIFICATION
+
+  // End-to-end functional correctness of the exact solution body for every
+  // symbolic ASCII code sequence S accepted by the supplied string model.
+  claim [anti-shuffle-correct]:
+    <k>
+      Call(
+        closureVal(("s", .ParamNames), antiBody, 0),
+        (str(S:IntSeq), .Exprs))
+      =>
+      antiShuffleSpec(S)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?HFINAL:Map </heap>
+    <heapLoc> 0 => ?NFINAL:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..dbe926e611b334b0af560050ba88bf75df2b07df
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,144 @@
+requires "reference-semantics/semantics.k"
+
+module ANTI-SHUFFLE-BASE
+  imports MPY
+
+  // The two macros below are the exact constructor form emitted in
+  // solution.mpy.  Naming the blocks keeps the reachability claims readable.
+  syntax Stmts ::= "antiLoopBody" [macro]
+  rule antiLoopBody
+    => AugAssign(
+         Name("result"),
+         "+",
+         Call(
+           Attribute(Str(""), "join"),
+           Call(Name("sorted"), Call(Name("list"), Name("word")))))
+       AugAssign(Name("result"), "+", Str(" "))
+       .Stmts
+
+  syntax Stmts ::= "antiBody" [macro]
+  rule antiBody
+    => Assign(Name("result"), Str(""))
+       Assign(Name("word"), Str(""))
+       For(
+         Name("word"),
+         Call(Attribute(Name("s"), "split"), Str(" ")),
+         antiLoopBody)
+       Return(
+         Subscript(
+           Name("result"),
+           Slice(NoBound, UnaryOp("-", Int(1)), NoBound)))
+       .Stmts
+
+  // sortWord is the semantics-level meaning of
+  //     "".join(sorted(list(word)))
+  // sortVS is intentionally the supplied trusted symbolic sorting primitive.
+  syntax IntSeq ::= sortWord(IntSeq) [function, total]
+  rule sortWord(W:IntSeq)
+    => joinCodes(.IntSeq, sortVS(charsOf(W)))
+
+  // A typed sequence of word code sequences. This avoids asking the prover to
+  // recover "every element is a string" from an abstract ValSeq.
+  syntax Words ::= ".Words" | wCons(IntSeq, Words)
+
+  syntax ValSeq ::= wordVals(Words) [function, total]
+  rule wordVals(.Words) => .ValSeq
+  rule wordVals(wCons(W:IntSeq, REST:Words))
+    => vCons(str(W), wordVals(REST))
+
+  // The same recurrence as the supplied splitSep, with the result represented
+  // by Words. WORD-SPEC proves their equivalence.
+  syntax Words ::= splitWords(IntSeq, Int, IntSeq) [function, total]
+  rule splitWords(.IntSeq, _SEP:Int, CUR:IntSeq)
+    => wCons(CUR, .Words)
+  rule splitWords(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq)
+    => wCons(CUR, splitWords(R, SEP, .IntSeq))
+    requires C ==Int SEP
+  rule splitWords(iCons(C:Int, R:IntSeq), SEP:Int, CUR:IntSeq)
+    => splitWords(R, SEP, seqConcat(CUR, iCons(C, .IntSeq)))
+    requires notBool (C ==Int SEP)
+
+  // emitWordSeq describes the loop before its final result[:-1]: every sorted
+  // word is followed by exactly one ASCII space.
+  syntax IntSeq ::= emitWordSeq(Words) [function, total]
+  rule emitWordSeq(.Words) => .IntSeq
+  rule emitWordSeq(wCons(W:IntSeq, REST:Words))
+    => seqConcat(sortWord(W), iCons(32, emitWordSeq(REST)))
+
+  // Declarative contract. splitSep preserves empty fields, so leading,
+  // trailing, and repeated spaces are all preserved. The slice removes only
+  // the loop's one deliberately-added trailing space.
+  syntax Val ::= antiShuffleSpec(IntSeq) [function, total]
+  rule antiShuffleSpec(S:IntSeq)
+    => doSlice(
+         str(emitWordSeq(splitWords(S, 32, .IntSeq))),
+         noB,
+         someB(-1),
+         noB)
+
+  // Algebraic normalizations needed by the accumulator invariant. Both are
+  // standard consequences of seqConcat's defining equations.
+  rule seqConcat(A:IntSeq, .IntSeq) => A [simplification]
+  rule seqConcat(seqConcat(A:IntSeq, B:IntSeq), C:IntSeq)
+    => seqConcat(A, seqConcat(B, C))
+    [simplification]
+endmodule
+
+module ANTI-SHUFFLE-LOOP-VERIFICATION
+  imports ANTI-SHUFFLE-BASE
+
+  // Iteration-only view of split's result. The program never observes the
+  // temporary list except through For, so this avoids an opaque symbolic
+  // ValSeq while retaining splitSep's exact recurrence.
+  syntax Iterable ::= wordsObj(Words)
+  rule <k> #iterNext(wordsObj(.Words)) => #iterDone ... </k>
+  rule <k> #iterNext(wordsObj(wCons(W:IntSeq, REST:Words)))
+        => #iterYield(str(W), wordsObj(REST)) ... </k>
+
+  rule <k>
+         #applyK(
+           toCall(boundMethodV(str(S:IntSeq), "split")),
+           (str(iCons(SEP:Int, .IntSeq)), .Vals))
+         => wordsObj(splitWords(S, SEP, .IntSeq))
+         ...
+       </k>
+       [priority(35)]
+
+  // Observational summary of the two temporary list allocations used to sort
+  // one word. WORD-SPEC proves this composition separately from MPY rules.
+  rule <k>
+         Call(
+           Attribute(Str(""), "join"),
+           Call(Name("sorted"), Call(Name("list"), Name("word"))))
+         => str(sortWord(W))
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
+       requires "word" in_keys(M)
+       andBool {M["word"]}:>Val ==K str(W:IntSeq)
+       [priority(40)]
+endmodule
+
+module ANTI-SHUFFLE-VERIFICATION
+  imports ANTI-SHUFFLE-LOOP-VERIFICATION
+
+  // This is the proved anti-loop reachability invariant, installed as a
+  // summary for the end-to-end claim. loop-spec.k proves it without this rule.
+  rule <k>
+         #loop(wordsObj(WS:Words), Name("word"), antiLoopBody)
+         => .K
+         ...
+       </k>
+       <env> 1 </env>
+       <scopes>
+         ... 1 |-> scope(
+           (("result" |-> str(A:IntSeq)) M:Map)
+           =>
+           (("result" |-> str(seqConcat(A, emitWordSeq(WS)))) M),
+           P:Parent)
+         ...
+       </scopes>
+       requires notBool ("result" in_keys(M))
+       [priority(40)]
+endmodule
diff --git a/word-spec.k b/word-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0f406889717d78b2718d0eacff6ffac5fa6e8bd6
--- /dev/null
+++ b/word-spec.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module WORD-SPEC
+  imports ANTI-SHUFFLE-BASE
+
+  // The allocation-free word summary used by the main proof is exactly the
+  // observable value produced by list(word), sorted(...), and "".join(...).
+  claim [sort-word-summary]:
+    <k>
+      Call(
+        Attribute(Str(""), "join"),
+        Call(Name("sorted"), Call(Name("list"), str(W:IntSeq))))
+      =>
+      str(sortWord(W))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> H:Map => ?HFINAL:Map </heap>
+    <heapLoc> N:Int => ?NFINAL:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool (N in_keys(H))
+     andBool notBool ((N +Int 1) in_keys(H))
+
+endmodule

