diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..8f934abd1edabebcaaf53e3431220007b51d6303
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,14 @@
+def anti_shuffle(s):
+    result = ""
+    word = ""
+    for word in s.split(" "):
+        result += "".join(sorted(list(word)))
+        result += " "
+    return result[:-1]
+
+
+assert anti_shuffle("Hi") == "Hi"
+assert anti_shuffle("hello") == "ehllo"
+assert anti_shuffle("Hello World!!!") == "Hello !!!Wdlor"
+assert anti_shuffle("") == ""
+assert anti_shuffle("  ba  dc ") == "  ab  cd "
diff --git a/loop-spec.k b/loop-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..914b3e4ed14c04ae4efde2e6da49657fc5a33ccc
--- /dev/null
+++ b/loop-spec.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module ANTI-LOOP-SPEC
+  imports ANTI-SHUFFLE-LOOP-VERIFICATION
+
+  // Inductive loop invariant. Starting with prefix A and remaining words WS,
+  // the loop leaves exactly A ++ emitWordSeq(WS).
+  claim [anti-loop]:
+    <k>
+      #loop(wordsObj(WS:Words), Name("word"), antiLoopBody)
+      ~> Name("result")
+      =>
+      str(seqConcat(A, emitWordSeq(WS)))
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "result" |-> str(A:IntSeq)
+        "s"      |-> str(INPUT:IntSeq)
+        "word"   |-> WORD0:Val,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?SCFINAL:Map
+    </scopes>
+    <heap> H:Map => ?HFINAL:Map </heap>
+    <heapLoc> N:Int => ?NFINAL:Int </heapLoc>
+endmodule
