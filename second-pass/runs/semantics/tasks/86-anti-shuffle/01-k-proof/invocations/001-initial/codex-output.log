+
+  // splitSep from the supplied semantics is extensionally the typed split
+  // recurrence used by the loop invariant.
+  claim [split-summary]:
+    <k>
+      splitSep(S:IntSeq, SEP:Int, CUR:IntSeq)
+      =>
+      wordVals(splitWords(S, SEP, CUR))
+    </k>
+endmodule

