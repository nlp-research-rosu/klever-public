+      =>
+      str(sortWord(W))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> H:Map => ?HFINAL:Map </heap>
+    <heapLoc> N:Int => ?NFINAL:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
