+      ~> Name("result")
+      =>
+      str(seqConcat(A, emitWordSeq(WS)))
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "result" |-> str(A:IntSeq)
+        "s"      |-> str(INPUT:IntSeq)
+        "word"   |-> WORD0:Val,
+        parent(0))
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?SCFINAL:Map
+    </scopes>
