Module(
  FuncDef("anti_shuffle", Params("s"),
    Assign(Name("result"), Str(""))
    Assign(Name("word"), Str(""))
    For(Name("word"), Call(Attribute(Name("s"), "split"), Str(" ")),
      AugAssign(
        Name("result"),
        "+",
        Call(
          Attribute(Str(""), "join"),
          Call(Name("sorted"), Call(Name("list"), Name("word")))))
      AugAssign(Name("result"), "+", Str(" ")))
    Return(
      Subscript(
        Name("result"),
        Slice(NoBound, UnaryOp("-", Int(1)), NoBound)))))
