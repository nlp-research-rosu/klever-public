===== prompt.py =====
     1	
     2	def sort_array(arr):
     3	    """
     4	    In this Kata, you have to sort an array of non-negative integers according to
     5	    number of ones in their binary representation in ascending order.
     6	    For similar number of ones, sort based on decimal value.
     7	
     8	    It must be implemented like this:
     9	    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]
    10	    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]
    11	    >>> sort_array([1, 0, 2, 3, 4]) [0, 1, 2, 3, 4]
    12	    """

