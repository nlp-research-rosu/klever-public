/reference/k-proof/reference-semantics/semantics/builtins.k-107-  // ==== bin(n) — "0b" + binary digit codes (promoted from 103's defined fold) ==
/reference/k-proof/reference-semantics/semantics/builtins.k:108:  rule applyBuiltin("bin", N:Int, .Vals) => str(iCons(48, iCons(98, binCodes(N))))
/reference/k-proof/reference-semantics/semantics/builtins.k-109-       requires N >=Int 0
/reference/k-proof/reference-semantics/semantics/builtins.k-110-  // negative operand: the '-' sign prefixes the magnitude's digits
/reference/k-proof/reference-semantics/semantics/builtins.k:111:  rule applyBuiltin("bin", N:Int, .Vals)
/reference/k-proof/reference-semantics/semantics/builtins.k:112:    => str(iCons(45, iCons(48, iCons(98, binCodes(0 -Int N)))))
/reference/k-proof/reference-semantics/semantics/builtins.k-113-       requires N <Int 0
/reference/k-proof/reference-semantics/semantics/builtins.k:114:  syntax IntSeq ::= binCodes(Int) [function, total]
/reference/k-proof/reference-semantics/semantics/builtins.k:115:  rule binCodes(0) => iCons(48, .IntSeq)
/reference/k-proof/reference-semantics/semantics/builtins.k:116:  rule binCodes(N:Int) => binAcc(N, .IntSeq) requires N >Int 0
/reference/k-proof/reference-semantics/semantics/builtins.k-117-  syntax IntSeq ::= binAcc(Int, IntSeq) [function, total]
/reference/k-proof/reference-semantics/semantics/builtins.k-118-  rule binAcc(0, ACC:IntSeq) => ACC
/reference/k-proof/reference-semantics/semantics/builtins.k-119-  rule binAcc(N:Int, ACC:IntSeq)
/reference/k-proof/reference-semantics/semantics/builtins.k-120-    => binAcc((N -Int pyMod(N, 2)) /Int 2, iCons(48 +Int pyMod(N, 2), ACC))
/reference/k-proof/reference-semantics/semantics/builtins.k-121-       requires N >Int 0
/reference/k-proof/reference-semantics/semantics/builtins.k-122-
/reference/k-proof/reference-semantics/semantics/builtins.k-123-  // ==== enumerate(xs) — pairs (i, v); materialized eagerly over a list =========
/reference/k-proof/reference-semantics/semantics/builtins.k-124-  rule <k> #applyK(toCall(builtinV("enumerate")), (list(VS:ValSeq), .Vals))
--
/reference/k-proof/reference-semantics/semantics/methods.k-26-  rule applyMethod(str(SEP:IntSeq), "join", list(VS:ValSeq), .Vals) => str(joinCodes(SEP, VS))
/reference/k-proof/reference-semantics/semantics/methods.k-27-  syntax IntSeq ::= joinCodes(IntSeq, ValSeq) [function, total]
/reference/k-proof/reference-semantics/semantics/methods.k-28-  rule joinCodes(_:IntSeq, .ValSeq) => .IntSeq
/reference/k-proof/reference-semantics/semantics/methods.k-29-  rule joinCodes(_:IntSeq, vCons(str(CS:IntSeq), .ValSeq)) => CS
/reference/k-proof/reference-semantics/semantics/methods.k-30-  rule joinCodes(SEP:IntSeq, vCons(str(CS:IntSeq), vCons(V:Val, R:ValSeq)))
/reference/k-proof/reference-semantics/semantics/methods.k-31-    => seqConcat(CS, seqConcat(SEP, joinCodes(SEP, vCons(V, R))))
/reference/k-proof/reference-semantics/semantics/methods.k-32-
/reference/k-proof/reference-semantics/semantics/methods.k-33-  // S.count(sub): non-overlapping window scan (Python str.count)
/reference/k-proof/reference-semantics/semantics/methods.k:34:  rule applyMethod(str(CS:IntSeq), "count", str(PC:IntSeq), .Vals) => cntSub(CS, PC)
/reference/k-proof/reference-semantics/semantics/methods.k:35:  syntax Int ::= cntSub(IntSeq, IntSeq) [function]
/reference/k-proof/reference-semantics/semantics/methods.k:36:  rule cntSub(.IntSeq, _:IntSeq) => 0
/reference/k-proof/reference-semantics/semantics/methods.k:37:  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => 1 +Int cntSub(dropIS(iCons(C, R), isLen(PC)), PC)
/reference/k-proof/reference-semantics/semantics/methods.k-38-       requires strPrefix(PC, iCons(C, R)) andBool isLen(PC) >Int 0
/reference/k-proof/reference-semantics/semantics/methods.k:39:  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => cntSub(R, PC)
/reference/k-proof/reference-semantics/semantics/methods.k-40-       requires notBool strPrefix(PC, iCons(C, R)) orBool isLen(PC) <=Int 0
/reference/k-proof/reference-semantics/semantics/methods.k-41-  syntax IntSeq ::= dropIS(IntSeq, Int) [function, total]
/reference/k-proof/reference-semantics/semantics/methods.k-42-  rule dropIS(S:IntSeq, N:Int) => S requires N <=Int 0
/reference/k-proof/reference-semantics/semantics/methods.k-43-  rule dropIS(.IntSeq, _:Int) => .IntSeq [owise]
/reference/k-proof/reference-semantics/semantics/methods.k-44-  rule dropIS(iCons(_:Int, R:IntSeq), N:Int) => dropIS(R, N -Int 1) requires N >Int 0
/reference/k-proof/reference-semantics/semantics/methods.k-45-
/reference/k-proof/reference-semantics/semantics/methods.k-46-  // S.strip(): trim whitespace runs from both ends
/reference/k-proof/reference-semantics/semantics/methods.k-47-  rule applyMethod(str(CS:IntSeq), "strip", .Vals) => str(revIS(trimWS(revIS(trimWS(CS)))))
