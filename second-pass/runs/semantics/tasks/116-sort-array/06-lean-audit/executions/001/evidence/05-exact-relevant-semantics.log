/reference/k-proof/reference-semantics/semantics/methods.k-56-
/reference/k-proof/reference-semantics/semantics/methods.k-57-  // S.encode('ascii'): identity on the code-sequence model (bytes == codes)
/reference/k-proof/reference-semantics/semantics/methods.k-58-  rule applyMethod(str(CS:IntSeq), "encode", str(_:IntSeq), .Vals) => str(CS)
/reference/k-proof/reference-semantics/semantics/methods.k-59-
/reference/k-proof/reference-semantics/semantics/methods.k-60-  // ==== prefix ===============================================================
/reference/k-proof/reference-semantics/semantics/methods.k-61-  rule applyMethod(str(XC:IntSeq), "startswith", str(PC:IntSeq), .Vals) => startsWith(PC, XC)
/reference/k-proof/reference-semantics/semantics/methods.k-62-
/reference/k-proof/reference-semantics/semantics/methods.k-63-  // ==== list.count(v) — number of occurrences of v in the list (concrete for krun) ==========
/reference/k-proof/reference-semantics/semantics/methods.k:64:  rule applyMethod(list(VS:ValSeq), "count", V:Val, .Vals) => cntOccVS(VS, V)
/reference/k-proof/reference-semantics/semantics/methods.k-65-  syntax Int ::= cntOccVS(ValSeq, Val) [function, total]
/reference/k-proof/reference-semantics/semantics/methods.k-66-  rule cntOccVS(.ValSeq, _:Val)                => 0
/reference/k-proof/reference-semantics/semantics/methods.k-67-  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => 1 +Int cntOccVS(R, V) requires A ==K V
/reference/k-proof/reference-semantics/semantics/methods.k-68-  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => cntOccVS(R, V)        requires notBool (A ==K V)
/reference/k-proof/reference-semantics/semantics/methods.k-69-
/reference/k-proof/reference-semantics/semantics/methods.k-70-  // ==== split (no-arg: on whitespace runs, dropping empty tokens) + replace (single char) ==========
/reference/k-proof/reference-semantics/semantics/methods.k-71-  // Concrete string ops for krun. A proof over a symbolic string intercepts the split problem-locally.
/reference/k-proof/reference-semantics/semantics/methods.k-72-  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), .Vals)

