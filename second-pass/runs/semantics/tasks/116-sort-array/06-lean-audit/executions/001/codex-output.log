+$ cd /audit-output
+$ printf '===== verification.k =====\n'
+nl -ba /reference/k-proof/verification.k
+printf '\n===== spec.k =====\n'
+nl -ba /reference/k-proof/spec.k
+printf '\n===== solution.py =====\n'
