+    92	    <exit-code> 0 </exit-code>
+    93	    requires N <Int 0
+    94	endmodule
+
+===== solution.py =====
+     1	def sort_array(arr):
+     2	    return sorted(
+     3	        sorted(arr),
+     4	        key=lambda value: (
+     5	            0
+     6	            if value < 0
+     7	            else bin(value).count("1")
+     8	        ),
+     9	    )
