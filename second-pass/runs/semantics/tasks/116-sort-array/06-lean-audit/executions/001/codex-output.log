===== solution.py =====
     1	def sort_array(arr):
     2	    return sorted(
     3	        sorted(arr),
     4	        key=lambda value: (
     5	            0
     6	            if value < 0
     7	            else bin(value).count("1")
     8	        ),
     9	    )

