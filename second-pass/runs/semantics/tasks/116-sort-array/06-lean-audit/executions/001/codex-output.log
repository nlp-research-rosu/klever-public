+     6	        Call(Name("sorted"), Name("arr")),
+     7	        KwArg(
+     8	          "key",
+     9	          Lambda(
+    10	            Params("value"),
+    11	            CellVars(),
+    12	            FreeVars(),
+    13	            IfExp(
