+     1	#!/usr/bin/env bash
+     2	set -euo pipefail
+     3	
+     4	python3 py2mpy.py solution.py > solution.mpy
+     5	
+     6	kompile reference-semantics/semantics.k \
+     7	  --backend llvm \
+     8	  --main-module MPY-KRUN \
+     9	  --syntax-module MPY-SYNTAX \
+    10	  --output-definition runtime-kompiled
+    11	
+    12	python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
+    13	krun concrete-tests.mpy --definition runtime-kompiled
+    14	python3 differential_test.py
+    15	
+    16	kompile verification.k \
