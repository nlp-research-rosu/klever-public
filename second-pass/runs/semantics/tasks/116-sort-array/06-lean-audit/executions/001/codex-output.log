+/reference/k-proof/reference-semantics/semantics/concrete.k:24:  // runs this and proofs (which never see MPY-CONCRETE) keep sortKeyVS.
+/reference/k-proof/reference-semantics/semantics/concrete.k-25-  syntax Val ::= kvP(Val, Val)
+/reference/k-proof/reference-semantics/semantics/concrete.k-26-  syntax KItem ::= #ksort(ValSeq, Val, ValSeq, Bool)
+/reference/k-proof/reference-semantics/semantics/concrete.k-27-                 | #ksIns(Val, ValSeq, Val, ValSeq, Bool)
+/reference/k-proof/reference-semantics/semantics/concrete.k:28:  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
+/reference/k-proof/reference-semantics/semantics/concrete.k-29-        => #ksort(VS, KV, .ValSeq, false) ... </k>
+/reference/k-proof/reference-semantics/semantics/concrete.k-30-       [priority(40)]
+/reference/k-proof/reference-semantics/semantics/concrete.k:31:  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
+/reference/k-proof/reference-semantics/semantics/concrete.k-32-        => #ksort(VS, KV, .ValSeq, RB) ... </k>
+/reference/k-proof/reference-semantics/semantics/concrete.k-33-       [priority(40)]
+/reference/k-proof/reference-semantics/semantics/concrete.k-34-  rule <k> #ksort(.ValSeq, _:Val, ACC:ValSeq, RB:Bool)
+/reference/k-proof/reference-semantics/semantics/concrete.k-35-        => #alloc(list(condRev(unpairVS(ACC), RB))) ... </k>
+--
+/reference/k-proof/reference-semantics/semantics/dict.k-54-  rule dPutV(_KS:ValSeq, VS:ValSeq, _K:Val, V:Val) => valSeqConcat(VS, vCons(V, .ValSeq)) [owise]
+/reference/k-proof/reference-semantics/semantics/dict.k-55-
+/reference/k-proof/reference-semantics/semantics/dict.k-56-  // ==== dict methods ========================================================
+/reference/k-proof/reference-semantics/semantics/dict.k-57-  // d.keys() -> a FRESH list object of the ordered keys (k-cell: it allocates).
+/reference/k-proof/reference-semantics/semantics/dict.k:58:  rule <k> #applyK(toCall(boundMethodV(dictV(KS:ValSeq, _:ValSeq), "keys")), .Vals)
+/reference/k-proof/reference-semantics/semantics/dict.k-59-        => #alloc(list(KS)) ... </k>
+/reference/k-proof/reference-semantics/semantics/dict.k-60-       [priority(40)]
+/reference/k-proof/reference-semantics/semantics/dict.k-61-
+/reference/k-proof/reference-semantics/semantics/dict.k-62-  // ==== dict subscript READ: d[k] (assoc lookup; KeyError is out of subset) ==
+--
+/reference/k-proof/reference-semantics/semantics/methods.k-68-  rule cntOccVS(vCons(A:Val, R:ValSeq), V:Val) => cntOccVS(R, V)        requires notBool (A ==K V)
+/reference/k-proof/reference-semantics/semantics/methods.k-69-
+/reference/k-proof/reference-semantics/semantics/methods.k-70-  // ==== split (no-arg: on whitespace runs, dropping empty tokens) + replace (single char) ==========
+/reference/k-proof/reference-semantics/semantics/methods.k-71-  // Concrete string ops for krun. A proof over a symbolic string intercepts the split problem-locally.
+/reference/k-proof/reference-semantics/semantics/methods.k:72:  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), .Vals)
+/reference/k-proof/reference-semantics/semantics/methods.k-73-        => #alloc(list(splitWS(CS, .IntSeq, .ValSeq))) ... </k>
+/reference/k-proof/reference-semantics/semantics/methods.k-74-       [priority(40)]
+/reference/k-proof/reference-semantics/semantics/methods.k-75-  syntax ValSeq ::= splitWS(IntSeq, IntSeq, ValSeq) [function]  // remaining, current token, result
+/reference/k-proof/reference-semantics/semantics/methods.k-76-  rule splitWS(.IntSeq, CUR:IntSeq, ACC:ValSeq) => flushTok(ACC, CUR)
+--
+/reference/k-proof/reference-semantics/semantics/methods.k-85-  syntax Bool ::= isWSC(Int) [function, total]
+/reference/k-proof/reference-semantics/semantics/methods.k-86-  rule isWSC(C:Int) => C ==Int 32 orBool C ==Int 9 orBool C ==Int 10 orBool C ==Int 13
+/reference/k-proof/reference-semantics/semantics/methods.k-87-
+/reference/k-proof/reference-semantics/semantics/methods.k-88-  // split(sep='x') keyword form delegates to the positional k-cell rule
+/reference/k-proof/reference-semantics/semantics/methods.k:89:  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), (kwV("sep", str(S:IntSeq)), .Vals))
+/reference/k-proof/reference-semantics/semantics/methods.k:90:        => #applyK(toCall(boundMethodV(str(CS), "split")), (str(S), .Vals)) ... </k>
+/reference/k-proof/reference-semantics/semantics/methods.k-91-       [priority(39)]
+/reference/k-proof/reference-semantics/semantics/methods.k-92-
+/reference/k-proof/reference-semantics/semantics/methods.k-93-  // str.split(sep) — single-char separator, KEEPING empty parts (Python's sep-split; len == #sep + 1).
+/reference/k-proof/reference-semantics/semantics/methods.k:94:  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), (str(iCons(SEP:Int, .IntSeq)), .Vals))
+/reference/k-proof/reference-semantics/semantics/methods.k-95-        => #alloc(list(splitSep(CS, SEP, .IntSeq))) ... </k>
+/reference/k-proof/reference-semantics/semantics/methods.k-96-       [priority(40)]
+/reference/k-proof/reference-semantics/semantics/methods.k-97-  syntax ValSeq ::= splitSep(IntSeq, Int, IntSeq) [function]  // remaining, sep code, current token
+/reference/k-proof/reference-semantics/semantics/methods.k-98-  rule splitSep(.IntSeq, _SEP:Int, CUR:IntSeq)              => vCons(str(CUR), .ValSeq)
