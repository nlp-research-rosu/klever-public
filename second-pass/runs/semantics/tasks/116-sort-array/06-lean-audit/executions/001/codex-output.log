+/reference/k-proof/reference-semantics/semantics/core.k-183-  // ==== argument/element evaluation: ONE left-to-right loop, tagged by destination ==
+/reference/k-proof/reference-semantics/semantics/core.k-184-  // (list/tuple literals and calls all use it; modules extend ApplyK with their tags)
+/reference/k-proof/reference-semantics/semantics/core.k:185:  syntax ApplyK ::= toCall(Val)
