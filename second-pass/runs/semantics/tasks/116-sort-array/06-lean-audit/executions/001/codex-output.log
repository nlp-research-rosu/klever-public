diff --git a/evidence/04-relevant-operational-semantics-search.log b/evidence/04-relevant-operational-semantics-search.log
new file mode 100644
index 0000000000000000000000000000000000000000..983abafa3dd5610265b7de383942d458d2b8eb31
--- /dev/null
+++ b/evidence/04-relevant-operational-semantics-search.log
@@ -0,0 +1,422 @@
+$ cd /audit-output
+$ rg -n -C 4 'sortKeyVS|sortVS|closureValC|closureVal\(|Lambda\(|#loadAll|FuncDef\(|Call\(' /reference/k-proof/reference-semantics/semantics /reference/k-proof/reference-semantics/semantics.k | sed -n '1,1400p'
+
+/reference/k-proof/reference-semantics/semantics/subscript.k-4-  imports MPY-CORE
+/reference/k-proof/reference-semantics/semantics/subscript.k-5-
+/reference/k-proof/reference-semantics/semantics/subscript.k-6-  // ==== positional access + negative-index normalization (used only here) ===
+/reference/k-proof/reference-semantics/semantics/subscript.k-7-  // valSeqAt is [total]: in-bounds vCons access reduces as usual; on an OPAQUE sequence (e.g.
+/reference/k-proof/reference-semantics/semantics/subscript.k:8:  // a trusted sort's sortVS(VS)) or OOB it stays an abstract total value — so indexing the
+/reference/k-proof/reference-semantics/semantics/subscript.k-9-  // opaque sorted list is DEFINED (no undischarged #Ceil), matching the old semantics' total
+/reference/k-proof/reference-semantics/semantics/subscript.k-10-  // atK. K trusts the [total] annotation; valid programs index in-bounds.
+/reference/k-proof/reference-semantics/semantics/subscript.k-11-  syntax Val ::= valSeqAt(ValSeq, Int) [function, total]
+/reference/k-proof/reference-semantics/semantics/subscript.k-12-  rule valSeqAt(vCons(V:Val, _:ValSeq), 0)     => V
+--
+/reference/k-proof/reference-semantics/semantics/comprehension.k-7-  imports MPY-CONTROLS
+/reference/k-proof/reference-semantics/semantics/comprehension.k-8-  imports MPY-FUNCTIONS
+/reference/k-proof/reference-semantics/semantics/comprehension.k-9-
+/reference/k-proof/reference-semantics/semantics/comprehension.k-10-  // A comprehension is pure syntactic sugar
+/reference/k-proof/reference-semantics/semantics/comprehension.k:11:  rule ListComp(ELT:Expr, Gs:CompFors) => Call(closureExpr(.ParamNames, compBody(Gs, ELT)), .Exprs)
+/reference/k-proof/reference-semantics/semantics/comprehension.k:12:  rule GenExp(ELT:Expr, Gs:CompFors)   => Call(closureExpr(.ParamNames, compBody(Gs, ELT)), .Exprs)
+/reference/k-proof/reference-semantics/semantics/comprehension.k-13-
+/reference/k-proof/reference-semantics/semantics/comprehension.k-14-  syntax Stmts ::= compBody(CompFors, Expr) [macro]
+/reference/k-proof/reference-semantics/semantics/comprehension.k-15-  rule compBody(Gs:CompFors, ELT:Expr)
+/reference/k-proof/reference-semantics/semantics/comprehension.k-16-    => Assign(Name("$acc"), ListExpr(.Exprs)) compNest(Gs, ELT) Return(Name("$acc"))
+--
+/reference/k-proof/reference-semantics/semantics/core.k-27-                    | "noneV"
+/reference/k-proof/reference-semantics/semantics/core.k-28-                    | Iterable
+/reference/k-proof/reference-semantics/semantics/core.k-29-                    | ref(Int)          // a heap object: <heap> holds its list(VS)
+/reference/k-proof/reference-semantics/semantics/core.k-30-                    | cellRef(Int)      // a closure cell: <heap> holds cellV(V)
+/reference/k-proof/reference-semantics/semantics/core.k:31:                    | closureVal(ParamNames, Stmts, Int)
+/reference/k-proof/reference-semantics/semantics/core.k-32-                    | typeV(String)     // a type object (int/str), resolved from the builtins frame
+/reference/k-proof/reference-semantics/semantics/core.k-33-                    | builtinV(String)  // a builtin function, resolved like any name (LEGB fallthrough)
+/reference/k-proof/reference-semantics/semantics/core.k-34-                    | boundMethodV(Val, String)   // a cooled Attribute: obj.method
+/reference/k-proof/reference-semantics/semantics/core.k-35-
+--
+/reference/k-proof/reference-semantics/semantics/core.k-46-  // chain; scopeLoc only allocates >=1, so -1 never collides). The module scope (loc 0)
+/reference/k-proof/reference-semantics/semantics/core.k-47-  // has it as parent, so an unbound name resolves there last — exactly LEGB. `int`/`str`
+/reference/k-proof/reference-semantics/semantics/core.k-48-  // resolve to their type objects; any local/global binding shadows them via normal lookup.
