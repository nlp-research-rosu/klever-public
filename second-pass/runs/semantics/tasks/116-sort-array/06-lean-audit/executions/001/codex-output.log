+/reference/k-proof/reference-semantics/semantics/sort.k-9-
+/reference/k-proof/reference-semantics/semantics/sort.k-10-module MPY-SORT
+/reference/k-proof/reference-semantics/semantics/sort.k-11-  imports MPY-BUILTINS
+/reference/k-proof/reference-semantics/semantics/sort.k-12-  imports MPY-SUBSCRIPT
+/reference/k-proof/reference-semantics/semantics/sort.k-13-
