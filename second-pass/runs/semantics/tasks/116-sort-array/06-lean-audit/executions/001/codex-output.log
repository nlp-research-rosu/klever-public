+/reference/k-proof/reference-semantics/semantics/sort.k-15-  // concrete insertion sort for krun.
+/reference/k-proof/reference-semantics/semantics/sort.k-16-  // Concrete sort matches Int-sorted elements directly (an int Val IS an Int); projectIntTotal
+/reference/k-proof/reference-semantics/semantics/sort.k-17-  // (lemmas-only) is not available in the semantics. Int and str lists.
+/reference/k-proof/reference-semantics/semantics/sort.k:18:  syntax ValSeq ::= sortVS(ValSeq) [function, total, symbol(sortVS), no-evaluators]
+/reference/k-proof/reference-semantics/semantics/sort.k-19-  syntax ValSeq ::= insVS(Int, ValSeq) [function]
+/reference/k-proof/reference-semantics/semantics/sort.k:20:  rule sortVS(.ValSeq)                => .ValSeq          [concrete]
+/reference/k-proof/reference-semantics/semantics/sort.k:21:  rule sortVS(vCons(X:Int, R:ValSeq)) => insVS(X, sortVS(R)) [concrete]
+/reference/k-proof/reference-semantics/semantics/sort.k-22-  rule insVS(X:Int, .ValSeq)                => vCons(X, .ValSeq) [concrete]
+/reference/k-proof/reference-semantics/semantics/sort.k-23-  rule insVS(X:Int, vCons(Y:Int, R:ValSeq)) => vCons(X, vCons(Y, R)) requires X <=Int Y [concrete]
+/reference/k-proof/reference-semantics/semantics/sort.k-24-  rule insVS(X:Int, vCons(Y:Int, R:ValSeq)) => vCons(Y, insVS(X, R)) requires X  >Int Y [concrete]
+/reference/k-proof/reference-semantics/semantics/sort.k-25-  // str elements insert by the shared lexicographic strLt (methods.k)
+/reference/k-proof/reference-semantics/semantics/sort.k-26-  syntax ValSeq ::= insVSs(IntSeq, ValSeq) [function]
+/reference/k-proof/reference-semantics/semantics/sort.k:27:  rule sortVS(vCons(str(CS:IntSeq), R:ValSeq)) => insVSs(CS, sortVS(R)) [concrete]
+/reference/k-proof/reference-semantics/semantics/sort.k-28-  rule insVSs(A:IntSeq, .ValSeq) => vCons(str(A), .ValSeq) [concrete]
+/reference/k-proof/reference-semantics/semantics/sort.k-29-  rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(A), vCons(str(B), R))
+/reference/k-proof/reference-semantics/semantics/sort.k-30-       requires strLt(A, B) orBool A ==K B [concrete]
+/reference/k-proof/reference-semantics/semantics/sort.k-31-  rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(B), insVSs(A, R))
