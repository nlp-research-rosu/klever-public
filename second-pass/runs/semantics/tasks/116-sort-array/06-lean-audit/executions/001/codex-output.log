index 0000000000000000000000000000000000000000..a9d9edb49d99a1bea57a150b23202e6223f1d303
--- /dev/null
+++ b/evidence/05-exact-relevant-semantics.log
@@ -0,0 +1,362 @@
+$ cd /audit-output
+$ printf '===== semantics/sort.k =====\n'
+nl -ba /reference/k-proof/reference-semantics/semantics/sort.k
+printf '\n===== semantics/functions.k =====\n'
+nl -ba /reference/k-proof/reference-semantics/semantics/functions.k
