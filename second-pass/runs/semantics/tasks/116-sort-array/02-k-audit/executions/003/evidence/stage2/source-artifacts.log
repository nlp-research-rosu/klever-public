     6	def sort_array(arr):
     7	    """
     8	    In this Kata, you have to sort an array of non-negative integers according to
     9	    number of ones in their binary representation in ascending order.
    10	    For similar number of ones, sort based on decimal value.
    11	
    12	    It must be implemented like this:
    13	    >>> sort_array([1, 5, 2, 3, 4]) == [1, 2, 3, 4, 5]
    14	    >>> sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]
    15	    >>> sort_array([1, 0, 2, 3, 4]) [0, 1, 2, 3, 4]
    16	    """
    17	    return sorted(sorted(arr), key=lambda x: bin(x)[2:].count('1'))
FILE:/candidate/solution.py
     1	def sort_array(arr):
     2	    return sorted(
     3	        sorted(arr),
     4	        key=lambda value: (
     5	            0
     6	            if value < 0
     7	            else bin(value).count("1")
     8	        ),
     9	    )
