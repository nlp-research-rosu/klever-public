+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNonNegativeInts(VS)
+endmodule
diff --git a//tmp/audit-work/reconstruction/spec-vacuity-audit.k b//tmp/audit-work/reconstruction/spec-vacuity-audit.k
new file mode 100644
