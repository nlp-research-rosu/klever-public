+#!/usr/bin/env bash
+set -u
+
+if [ "$#" -lt 2 ]; then
+  echo "usage: run-logged.sh LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log_path=$1
+shift
+
+{
