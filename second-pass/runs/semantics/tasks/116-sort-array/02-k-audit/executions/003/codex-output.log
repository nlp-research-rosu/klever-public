diff --git a//tmp/audit-work/reconstruction/spec-main-only.k b//tmp/audit-work/reconstruction/spec-main-only.k
new file mode 100644
index 0000000000000000000000000000000000000000..b57f64921eaa1d46b8f17cfd7f96af3d11312b09
--- /dev/null
+++ b//tmp/audit-work/reconstruction/spec-main-only.k
@@ -0,0 +1,30 @@
+requires "verification.k"
+
+module SPEC-MAIN-ONLY
+  imports SORT-ARRAY-VERIFICATION
+
+  claim
+    <k>
+      Call(sortArrayClosure, list(VS))
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
