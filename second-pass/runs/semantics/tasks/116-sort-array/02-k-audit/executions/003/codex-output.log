@@ -0,0 +1,27 @@
+requires "verification.k"
+
+module SPEC-KEY-NONNEGATIVE-ONLY
+  imports SORT-ARRAY-VERIFICATION
+
+  claim
+    <k>
+      Call(popcountKeyClosure, Int(N))
+      =>
+      cntSub(
+        iCons(48, iCons(98, binCodes(N))),
+        iCons(49, .IntSeq))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
