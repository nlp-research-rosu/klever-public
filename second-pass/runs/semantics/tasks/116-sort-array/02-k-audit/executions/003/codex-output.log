diff --git a/evidence/stage6/spec-vacuity-content.k b/evidence/stage6/spec-vacuity-content.k
new file mode 100644
index 0000000000000000000000000000000000000000..bbe1ad1694b57da5e5e29311de9d88cfef8506c4
--- /dev/null
+++ b/evidence/stage6/spec-vacuity-content.k
@@ -0,0 +1,32 @@
+requires "verification.k"
+
+module SPEC-VACUITY-CONTENT
+  imports SORT-ARRAY-VERIFICATION
+
+  // Deliberately false: keep the returned outer ref but require it to contain
+  // only the decimal pre-sort, omitting the keyed popcount sort.
+  claim
+    <k>
+      Call(sortArrayClosure, list(VS))
+      =>
+      ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
