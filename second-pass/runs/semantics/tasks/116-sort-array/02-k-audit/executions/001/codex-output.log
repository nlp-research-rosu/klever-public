diff --git a/evidence/spec-key-nonnegative-only.k b/evidence/spec-key-nonnegative-only.k
new file mode 100644
index 0000000000000000000000000000000000000000..a6930089abd9f7b13625664e5586a589e82e4ab3
--- /dev/null
+++ b/evidence/spec-key-nonnegative-only.k
@@ -0,0 +1,27 @@
+requires "/tmp/audit-work/rebuild/verification.k"
+
+module REVIEW-SPEC-KEY-NONNEGATIVE-ONLY
+  imports SORT-ARRAY-VERIFICATION
+
+  claim
+    <k>
+      Call(popcountKeyClosure, Int(N))
+      =>
+      cntSub(
+        iCons(48, iCons(98, binCodes(N))),
+        iCons(49, .IntSeq))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
