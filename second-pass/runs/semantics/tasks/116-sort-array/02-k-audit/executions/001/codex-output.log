diff --git a/evidence/spec-key-negative-only.k b/evidence/spec-key-negative-only.k
new file mode 100644
index 0000000000000000000000000000000000000000..fd42a201121edfbcab325b767c86c8f82df3560d
--- /dev/null
+++ b/evidence/spec-key-negative-only.k
@@ -0,0 +1,21 @@
+requires "/tmp/audit-work/rebuild/verification.k"
+
+module REVIEW-SPEC-KEY-NEGATIVE-ONLY
+  imports SORT-ARRAY-VERIFICATION
+
+  claim
+    <k> Call(popcountKeyClosure, Int(N)) => 0 </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
