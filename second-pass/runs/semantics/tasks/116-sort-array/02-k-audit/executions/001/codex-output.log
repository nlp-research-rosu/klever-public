    62	  imports MPY-OPERATORS
    63	  imports MPY-INT
    64	  imports MPY-BOOL
    65	  imports MPY-FLOAT
    66	  imports MPY-STR
    67	  imports MPY-SET
    68	  imports MPY-LIST
    69	  imports MPY-TUPLE
    70	  imports MPY-SUBSCRIPT
    71	  imports MPY-COMPREHENSION
    72	  imports MPY-METHODS
    73	  imports MPY-CONTROLS
    74	  imports MPY-FUNCTIONS
    75	  imports MPY-BUILTINS
    76	  imports MPY-CALL
    77	  imports MPY-SORT
    78	  imports MPY-ASSERT
    79	  imports MPY-DICT
    80	endmodule
    81	
    82	// The krun (llvm) main module: MPY plus the concrete-only legs (keyed sort's
    83	// real key calls, deep list equality). Verification builds import MPY and
    84	// never see MPY-CONCRETE. The llvm kompile MUST use --main-module MPY-KRUN —
    85	// with plain MPY the concrete legs are silently absent (this was live for a
    86	// while: sorted-key stuck and comprehension asserted wrong under krun).
    87	module MPY-KRUN
    88	  imports MPY
    89	  imports MPY-CONCRETE
    90	endmodule
     1	// reference/src/semantics/syntax.k — MPY-SYNTAX
     2	
     3	module MPY-SYNTAX
     4	  imports INT-SYNTAX
     5	  imports FLOAT-SYNTAX
     6	  imports BOOL-SYNTAX
     7	  imports STRING-SYNTAX
     8	
     9	  syntax Expr ::= "Int"      "(" Int ")"
    10	                | "Float"    "(" Float ")"
    11	                | "Bool"     "(" Bool ")"
    12	                | "Name"     "(" String ")"
    13	                | "Str"      "(" String ")"
    14	                | "UnaryOp"  "(" String "," Expr ")" [strict(2)]
    15	                | "BinOp"    "(" String "," Expr "," Expr ")" [seqstrict(2, 3)]
    16	                | "BoolOp"    "(" String "," Exprs ")"
    17	                | "ListExpr"  "(" Exprs ")"
    18	                | "DictExpr"  "(" Entries ")"
    19	                | "ListComp"  "(" Expr "," CompFors ")" [macro]
    20	                | "GenExp"    "(" Expr "," CompFors ")" [macro]
    21	                | "TupleExpr" "(" Exprs ")"
    22	                | "Subscript" "(" Expr "," Index ")"
    23	                | "IfExp"     "(" Expr "," Expr "," Expr ")" [strict(1)]
    24	                | "Lambda"    "(" Params "," Expr ")"
    25	                | "KwArg"     "(" String "," Expr ")"
    26	                | "Lambda"    "(" Params "," CellVars "," FreeVars "," Expr ")"
    27	                | "NoneVal"
    28	                | "Call"      "(" Expr "," Exprs ")"
    29	                | "Attribute" "(" Expr "," String ")" [strict(1)]
    30	                | "Compare"   "(" Expr "," CmpOp ")"
    31	
    32	  syntax CmpOp    ::= "CmpOp" "(" String "," Expr ")"
    33	  syntax Entry    ::= "Entry" "(" Expr "," Expr ")"
    34	  syntax Entries  ::= List{Entry, ","}
    35	  syntax CompFor  ::= "CompFor" "(" Expr "," Expr "," Exprs ")"
    36	  syntax CompFors ::= List{CompFor, ""}
    37	  syntax Exprs    ::= List{Expr, ","}
    38	  syntax Index    ::= Expr | "Slice" "(" Bound "," Bound "," Bound ")"
    39	  syntax Bound    ::= Expr | "NoBound"
    40	
    41	  syntax Stmt ::= "Assign"    "(" Expr "," Expr ")" [strict(2)]
    42	                | "Import"    "(" String ")"
    43	                | "ImportFrom" "(" String "," ParamNames ")"
    44	                | "AugAssign" "(" Expr "," String "," Expr ")" [strict(3)]
    45	                | "For"       "(" Expr "," Expr "," Stmts ")" [strict(2)]
    46	                | "While"     "(" Expr "," Stmts ")"
    47	                | "Break"
    48	                | "Continue"
    49	                | "If"        "(" Expr "," Stmts "," Stmts ")" [strict(1)]
    50	                | "Return"    "(" Expr ")" [strict]
    51	                | "Assert"    "(" Expr ")" [strict]
    52	                | "Expr"      "(" Expr ")" [strict]
    53	                | "FuncDef"   "(" String "," Params "," Stmts ")"
    54	                | "FuncDef"   "(" String "," Params "," CellVars "," FreeVars "," Stmts ")"
    55	
    56	  syntax Stmts      ::= List{Stmt, ""}
    57	  syntax Params     ::= "Params" "(" ParamNames ")"
    58	  syntax CellVars   ::= "CellVars" "(" ParamNames ")"
    59	  syntax FreeVars   ::= "FreeVars" "(" ParamNames ")"
    60	  syntax ParamNames ::= List{String, ","}
    61	  syntax Module     ::= "Module" "(" Stmts ")"
    62	endmodule
     1	// reference/src/semantics/core.k — MPY-CORE
     2	
     3	module MPY-CORE
     4	  imports MPY-SYNTAX
     5	  imports INT
     6	  imports BOOL
     7	  imports STRING
     8	  imports MAP
     9	  imports LIST
    10	  imports K-EQUAL
    11	
    12	  // ==== values, the algebraic lists, and the scope heap =====================
    13	  syntax IntSeq ::= ".IntSeq" | iCons(Int, IntSeq)
    14	  syntax ValSeq ::= ".ValSeq" | vCons(Val, ValSeq)
    15	  syntax Str    ::= str(IntSeq)
    16	
    17	  // the iterable values, grouped under one sort (typing only — dispatch is <k>-cell)
    18	  syntax Iterable ::= list(ValSeq)
    19	                    | tuple(ValSeq)
    20	                    | Str
    21	                    | rangeObj(Int, Int, Int)
    22	                    | zipObj(ValSeq, ValSeq)
    23	                    | zipObjS(IntSeq, IntSeq)
    24	
    25	  syntax Val      ::= Int
    26	                    | Bool
    27	                    | "noneV"
    28	                    | Iterable
    29	                    | ref(Int)          // a heap object: <heap> holds its list(VS)
    30	                    | cellRef(Int)      // a closure cell: <heap> holds cellV(V)
    31	                    | closureVal(ParamNames, Stmts, Int)
    32	                    | typeV(String)     // a type object (int/str), resolved from the builtins frame
    33	                    | builtinV(String)  // a builtin function, resolved like any name (LEGB fallthrough)
    34	                    | boundMethodV(Val, String)   // a cooled Attribute: obj.method
    35	
    36	  syntax Parent   ::= "root" | parent(Int)
    37	  syntax Scope    ::= scope(Map, Parent)
    38	  syntax KResult  ::= Val
    39	  syntax Expr     ::= Val   // cooling puts results back into expression holes
    40	  syntax Vals     ::= List{Val, ","}
    41	  syntax Exc      ::= "NoExc" | "AssertionError"
    42	  syntax RetState ::= "noRet" | retV(Val)
    43	
    44	  // ==== configuration =======================================================
    45	  // The builtins namespace is a real scope at reserved location -1 (the bottom of every
    46	  // chain; scopeLoc only allocates >=1, so -1 never collides). The module scope (loc 0)
    47	  // has it as parent, so an unbound name resolves there last — exactly LEGB. `int`/`str`
    48	  // resolve to their type objects; any local/global binding shadows them via normal lookup.
    49	  configuration
    50	    <k>       #loadAll($PGM:Module) </k>
    51	    <env>     0 </env>
    52	    <scopes>   0     |-> scope(.Map, parent(-1))
    53	              -1    |-> builtinsScope </scopes>
    54	    <scopeLoc> 1 </scopeLoc>
    55	    <heap>    .Map </heap>
    56	    <heapLoc> 0 </heapLoc>
    57	    <stack>   .List </stack>
    58	    <ret>     noRet </ret>
    59	    <exc>     NoExc </exc>
    60	    <exit-code exit=""> 0 </exit-code>
    61	
    62	  // ==== heap allocation (constructed lists become objects) ==================
    63	  // Cons-form emission with a freshness guard (the heap-list-probe discipline:
    64	  // an update-form H[N <- _] never re-normalizes symbolically). heapLoc is
    65	  // monotonic — it does NOT wind back at #pop: returned lists escape by ref.
    66	  // A bare list(VS) Val stays legal (read-only inputs in claims flow unboxed);
    67	  // only CONSTRUCTORS in program syntax allocate.
    68	  syntax Bool ::= isRefV(Val) [function, total]
    69	  rule isRefV(ref(_:Int)) => true
    70	  rule isRefV(_:Val)      => false [owise]
    71	
    72	  // closure cells (Python-faithful capture): the heap holds cellV(V); a
    73	  // cellRef surfacing as the k-redex reads through (lookup is the only use —
    74	  // cellRefs never escape to user-visible values)
    75	  syntax HeapVal ::= cellV(Val)
    76	  syntax Bool ::= isCellRef(Val) [function, total]
    77	  rule isCellRef(cellRef(_:Int)) => true
    78	  rule isCellRef(_:Val)          => false [owise]
    79	  // k-top deref for cell-bound reads surfacing INSIDE the annotated frame
    80	  // (AugAssign's in-place read and friends). The "$cells" guard keeps this
    81	  // DECIDABLY inapplicable in plain frames — an unguarded rule lets the
    82	  // prover narrow abstract k-top values into cellRef junk (probed on
    83	  // 26-remove-duplicates). Cross-frame reads (a comprehension closure
    84	  // reading the enclosing function's cellvar) deref inside #look instead.
    85	  rule <k> cellRef(H:Int) => V ... </k>
    86	       <env> L:Int </env>
    87	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    88	       <heap> ... H |-> cellV(V:Val) ... </heap>
    89	       requires "$cells" in_keys(M)
    90	       [priority(40)]
    91	
    92	  // write through a cell (Assign / #bindP / #bindTgt dispatch here on
    93	  // cell-bound names)
    94	  // a keyword argument cools to a TAGGED value (consumed by kw-aware builtins)
    95	  syntax Val ::= kwV(String, Val)
    96	  syntax KItem ::= #kwTag(String)
    97	  rule <k> KwArg(N:String, E:Expr) => E ~> #kwTag(N) ... </k>
    98	  rule <k> V:Val ~> #kwTag(N:String) => kwV(N, V) ... </k>
    99	       requires notBool isKwV(V)
   100	  syntax Bool ::= isKwV(Val) [function, total]
   101	  rule isKwV(kwV(_:String, _:Val)) => true
   102	  rule isKwV(_:Val)                => false [owise]
   103	
   104	  // the frame marker carries the CONCRETE cellvar list, so cell-write dispatch
   105	  // decides by pnMember even over an abstract frame rest (no prover branching)
   106	  syntax Val ::= cellsMark(ParamNames)
   107	  syntax ParamNames ::= cellsOf(Val) [function]
   108	  rule cellsOf(cellsMark(CVS:ParamNames)) => CVS
   109	  syntax Bool ::= pnMember(String, ParamNames) [function, total]
   110	  rule pnMember(_:String, .ParamNames) => false
   111	  rule pnMember(X:String, (P:String, R:ParamNames)) => X ==String P orBool pnMember(X, R)
   112	
   113	  syntax KItem ::= #cellW(Val, Val)
   114	  rule <k> #cellW(cellRef(H:Int), V:Val) => .K ... </k>
   115	       <heap> ... H |-> cellV(_:Val => V) ... </heap>
   116	
   117	  syntax KItem ::= #alloc(Val)
   118	  rule <k> #alloc(V:Val) => ref(N) ... </k>
   119	       <heap>    H:Map => (N |-> V) H </heap>
   120	       <heapLoc> N:Int => N +Int 1 </heapLoc>
   121	       requires notBool N in_keys(H)
   122	
   123	  // ==== module load + statement sequencing ==================================
   124	  syntax KItem ::= #loadAll(Module)
   125	  rule <k> #loadAll(Module(SS:Stmts)) => SS ... </k>
   126	  rule <k> (S:Stmt SS:Stmts):Stmts => S ~> SS ... </k>
   127	  rule <k> .Stmts => .K ... </k>
   128	
   129	  // ==== Name lookup (walk the scope chain; builtins live in the -1 scope) ====
   130	  syntax KItem ::= #look(String, Int)
   131	  rule <k> Name(X:String) => #look(X, L) ... </k> <env> L:Int </env>
   132	  rule <k> #look(X:String, L:Int) => {M[X]}:>Val ... </k>
   133	       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
   134	       requires X in_keys(M)
   135	  // a SYNTACTICALLY cell-bound name reads through the heap cell AT THE
   136	  // LOOKUP (higher priority beats the plain return above on concrete cell
   137	  // bindings; abstract claim values take the plain rule unchanged) — this
   138	  // covers cross-frame cell reads (a comprehension closure reading the
   139	  // enclosing function's cellvar) without a narrowing-prone k-top redex
   140	  // guarded on the FOUND frame's DECLARED cellvars (pnMember over the
   141	  // cellsMark): decidable for every concrete frame pin — plain frames and
   142	  // non-cell names prune outright, so an abstract looked-up value never
   143	  // drags a narrowing cellV heap match along (probed on 5-intersperse and
   144	  // Q4's abstract `numbers` in the annotated frame)
   145	  rule <k> #look(X:String, L:Int) => V ... </k>
   146	       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
   147	       <heap> ... H |-> cellV(V:Val) ... </heap>
   148	       requires X in_keys(M) andBool "$cells" in_keys(M)
   149	        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
   150	        andBool {M[X]}:>Val ==K cellRef(H)
   151	       [priority(40)]
   152	  rule <k> #look(X:String, L:Int) => #look(X, P) ... </k>
   153	       <scopes> ... L |-> scope(M:Map, parent(P:Int)) ... </scopes>
   154	       requires notBool (X in_keys(M))
   155	
   156	  // the ONE predefined builtins scope (the -1 frame; claims write `-1 |-> builtinsScope`)
   157	  syntax Scope ::= "builtinsScope" [function, total]
   158	  rule builtinsScope
   159	    => scope(.Map [ "len"    <- builtinV("len")    ]
   160	                  [ "set"    <- builtinV("set")    ]
   161	                  [ "sum"    <- builtinV("sum")    ]
   162	                  [ "abs"    <- builtinV("abs")    ]
   163	                  [ "min"    <- builtinV("min")    ]
   164	                  [ "max"    <- builtinV("max")    ]
   165	                  [ "ord"    <- builtinV("ord")    ]
   166	                  [ "chr"    <- builtinV("chr")    ]
   167	                  [ "range"  <- builtinV("range")  ]
   168	                  [ "all"    <- builtinV("all")    ]
   169	                  [ "any"    <- builtinV("any")    ]
   170	                  [ "zip"    <- builtinV("zip")    ]
   171	                  [ "isinstance" <- builtinV("isinstance") ]
   172	                  [ "sorted" <- builtinV("sorted") ]
   173	                  [ "list"   <- builtinV("list")   ]
   174	                  [ "round"  <- builtinV("round")  ]
   175	                  [ "bin"    <- builtinV("bin")    ]
   176	                  [ "enumerate" <- builtinV("enumerate") ]
   177	                  [ "map"    <- builtinV("map")    ]
   178	                  [ "eval"   <- builtinV("eval")   ]
   179	                  [ "int"    <- typeV("int")       ]
   180	                  [ "str"    <- typeV("str")       ]
   181	                  [ "float"  <- typeV("float")     ], root)
   182	
   183	  // ==== argument/element evaluation: ONE left-to-right loop, tagged by destination ==
   184	  // (list/tuple literals and calls all use it; modules extend ApplyK with their tags)
   185	  syntax ApplyK ::= toCall(Val)
   186	  syntax KItem  ::= #evalArgs(Exprs, Vals, ApplyK)
   187	                  | #evalArgCont(Exprs, Vals, ApplyK)
   188	                  | #applyK(ApplyK, Vals)
   189	  rule <k> #evalArgs((A:Expr, REST:Exprs), ACC:Vals, K:ApplyK) => A ~> #evalArgCont(REST, ACC, K) ... </k>
   190	  rule <k> V:Val ~> #evalArgCont(REST:Exprs, ACC:Vals, K:ApplyK) => #evalArgs(REST, appendVal(ACC, V), K) ... </k>
   191	  rule <k> #evalArgs(.Exprs, ACC:Vals, K:ApplyK) => #applyK(K, ACC) ... </k>
   192	
   193	  // ==== Int / Bool / None literals ==========================================
   194	  rule <k> Int(I:Int)   => I ... </k>
   195	  rule <k> Bool(B:Bool) => B ... </k>
   196	  rule <k> NoneVal      => noneV ... </k>
   197	
   198	  // ==== truthy (If, Assert, BoolOp, IfExp, not, While) ======================
   199	  syntax Bool ::= truthy(Val) [function]
   200	  rule truthy(B:Bool)          => B
   201	  rule truthy(noneV)           => false
   202	  rule truthy(I:Int)           => I =/=Int 0
   203	  rule truthy(str(S:IntSeq))   => notBool (S ==K .IntSeq)
   204	  rule truthy(list(V:ValSeq))  => notBool (V ==K .ValSeq)
   205	  rule truthy(tuple(V:ValSeq)) => notBool (V ==K .ValSeq)
   206	
   207	  // ==== extensible operator dispatch (cases added by the construct modules) ==
   208	  syntax Val  ::= applyUn(String, Val) [function]
   209	  syntax Val  ::= applyBin(String, Val, Val) [function]
   210	  syntax Bool ::= applyCmp(String, Val, Val) [function]
   211	
   212	  // ==== shared list helpers =================================================
   213	  syntax Vals ::= appendVal(Vals, Val) [function, total]
   214	  rule appendVal(.Vals, V:Val)              => V , .Vals
   215	  rule appendVal((V0:Val, VS:Vals), V:Val)  => V0 , appendVal(VS, V)
   216	
   217	  syntax ValSeq ::= vals2valSeq(Vals) [function, total]
   218	  rule vals2valSeq(.Vals)            => .ValSeq
   219	  rule vals2valSeq((V:Val, VS:Vals)) => vCons(V, vals2valSeq(VS))
   220	
   221	  // ==== shared sequence length (len / summaries across many modules) ========
   222	  // (positional access valSeqAt/intSeqAt + normIdx live in subscript.k)
   223	  syntax Int ::= vsLen(ValSeq) [function, total]
   224	  rule vsLen(.ValSeq)                => 0
   225	  rule vsLen(vCons(_:Val, S:ValSeq)) => 1 +Int vsLen(S)
   226	
   227	  syntax Int ::= isLen(IntSeq) [function, total]
   228	  rule isLen(.IntSeq)                => 0
   229	  rule isLen(iCons(_:Int, S:IntSeq)) => 1 +Int isLen(S)
   230	
   231	  // in-bounds positional write (list subscript-assign); OOB leaves the seq unchanged
   232	  // (valid programs write in-bounds — mirrors valSeqAt's total-but-underspecified stance)
   233	  syntax ValSeq ::= setVSAt(ValSeq, Int, Val) [function, total]
   234	  rule setVSAt(.ValSeq, _:Int, _:Val)               => .ValSeq
   235	  rule setVSAt(vCons(_:Val, S:ValSeq), 0, V:Val)    => vCons(V, S)
   236	  rule setVSAt(vCons(W:Val, S:ValSeq), I:Int, V:Val) => vCons(W, setVSAt(S, I -Int 1, V))
   237	       requires I >Int 0
   238	  rule setVSAt(VS:ValSeq, I:Int, _:Val)             => VS
   239	       requires I <Int 0
   240	endmodule
     1	// reference/src/semantics/controls.k — MPY-CONTROLS
     2	
     3	module MPY-CONTROLS
     4	  imports MPY-CORE
     5	  imports MPY-TUPLE
     6	  imports MPY-ITER
     7	
     8	  // ==== Assign / AugAssign (write the current scope; RHS evaluated by strictness) ==
     9	  rule <k> Assign(Name(X:String), V:Val) => .K ... </k>
    10	       <env> L:Int </env>
    11	       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>
    12	  rule <k> Assign(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>
    13	       <env> L:Int </env>
    14	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    15	       requires "$cells" in_keys(M)
    16	        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
    17	        andBool X in_keys(M) andBool isCellRef({M[X]}:>Val)
    18	       [priority(40)]
    19	
    20	  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => .K ... </k>
    21	       <env> L:Int </env>
    22	       <scopes> ... L |-> scope(M:Map => M [ X <- applyBin(OP, {M[X]}:>Val, V) ], _) ... </scopes>
    23	       requires X in_keys(M)
    24	  // `lst += [..]` where lst is a heap ref: the generic rule leaves applyBin(OP, ref, V) — but the
    25	  // ref-deref preemption is BinOp-level (operators.k), so applyBin never derefs and it sticks. Route
    26	  // the ref case through BinOp so the deref + list-concat + #alloc path fires (result is a fresh ref).
    27	  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => Assign(Name(X), BinOp(OP, Name(X), V)) ... </k>
    28	       <env> L:Int </env>
    29	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    30	       requires X in_keys(M) andBool isRefV({M[X]}:>Val)
    31	       [priority(40)]
    32	
    33	  // ==== import trivia: `from math import floor, ceil` binds the supported
    34	  // names as builtins in the current scope; every other import is a no-op
    35	  rule <k> ImportFrom("math", NS:ParamNames) => #bindImports(NS) ... </k>
    36	  rule <k> ImportFrom(_:String, _:ParamNames) => .K ... </k> [owise]
    37	  syntax KItem ::= #bindImports(ParamNames)
    38	  rule <k> #bindImports(.ParamNames) => .K ... </k>
    39	  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
    40	       <env> L:Int </env>
    41	       <scopes> ... L |-> scope(M:Map => M [ N <- builtinV(N) ], _) ... </scopes>
    42	       requires N ==String "floor" orBool N ==String "ceil"
    43	  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
    44	       requires notBool (N ==String "floor" orBool N ==String "ceil")
    45	
    46	  // ==== Expr statement: evaluate for effect, discard the value ===============
    47	  // (bare calls — mutator methods, docstrings; the WP0 statement-trivia rung)
    48	  rule <k> Expr(_:Val) => .K ... </k>
    49	
    50	  // ==== If (condition evaluated by strictness) ==============================
    51	  syntax KItem ::= #branch(Bool, Stmts, Stmts)
    52	  rule <k> If(C:Val, T:Stmts, E:Stmts) => #branch(truthy(C), T, E) ... </k>
    53	  rule <k> #branch(true,  T:Stmts, _:Stmts) => T ... </k>
    54	  rule <k> #branch(false, _:Stmts, E:Stmts) => E ... </k>
    55	
    56	  // ==== IfExp: ternary T if C else E ========================================
    57	  rule <k> IfExp(V:Val, T:Expr, _:Expr) => T ... </k>
    58	       requires truthy(V)
    59	  rule <k> IfExp(V:Val, _:Expr, E:Expr) => E ... </k>
    60	       requires notBool truthy(V)
    61	
    62	  // ==== For: one loop, in-cell continuation, over #iterNext =================
    63	  // (the iterable is evaluated once, by strictness; the protocol stays rewrites —
    64	  // circularities anchor on #loop and narrowing substitutes the structure)
    65	  syntax KItem ::= #loop(Val, Expr, Stmts) | #loopStep(Expr, Stmts)
    66	                 | #while(Expr, Stmts) | #whileCond(Expr, Stmts)
    67	                 | #loopLbl(K) | "#cont" | "#brk"
    68	
    69	  rule <k> For(T:Expr, OBJ:Val, B:Stmts) => #loop(OBJ, T, B) ... </k>
    70	
    71	  rule <k> #loop(IT:Iterable, T:Expr, B:Stmts) => #iterNext(IT) ~> #loopStep(T, B) ... </k>
    72	  rule <k> #iterDone ~> #loopStep(_:Expr, _:Stmts) => .K ... </k>
    73	  rule <k> #iterYield(V:Val, REST:Iterable) ~> #loopStep(T:Expr, B:Stmts)
    74	        => #bindTgt(T, V) ~> B ~> #loopLbl(#loop(REST, T, B)) ... </k>
    75	
    76	  // ==== While ==============================================================
    77	  rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>
    78	  rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>
    79	  rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>
    80	       requires truthy(V)
    81	  rule <k> V:Val ~> #whileCond(_C:Expr, _B:Stmts) => .K ... </k>
    82	       requires notBool truthy(V)
    83	
    84	  // ==== loop control (break / continue) =====================================
    85	  rule <k> #loopLbl(NEXT:K) => NEXT ... </k>
    86	  rule <k> Continue => #cont ... </k>
    87	  rule <k> Break => #brk ... </k>
    88	  rule <k> #cont ~> #loopLbl(NEXT:K) => NEXT ... </k>
    89	  rule <k> #cont ~> (_:KItem => .K) ... </k> [owise]
    90	  rule <k> #brk ~> #loopLbl(_:K) => .K ... </k>
    91	  rule <k> #brk ~> (_:KItem => .K) ... </k> [owise]
    92	
    93	  // ==== heap-object deref at the truthiness/iteration consumers ==============
    94	  // (priority(40) preempts the generic Val rules so truthy/#loop never see a ref)
    95	  rule <k> If(ref(H:Int), T:Stmts, E:Stmts) => If(V, T, E) ... </k>
    96	       <heap> ... H |-> V:Val ... </heap>
    97	       [priority(40)]
    98	  rule <k> IfExp(ref(H:Int), T:Expr, E:Expr) => IfExp(V, T, E) ... </k>
    99	       <heap> ... H |-> V:Val ... </heap>
   100	       [priority(40)]
   101	  rule <k> ref(H:Int) ~> #whileCond(C:Expr, B:Stmts) => V ~> #whileCond(C, B) ... </k>
   102	       <heap> ... H |-> V:Val ... </heap>
   103	       [priority(40)]
   104	  // For derefs its iterable ONCE at loop start (iteration is over the snapshot;
   105	  // mutating the iterated list inside its own loop is outside the subset)
   106	  rule <k> For(T:Expr, ref(H:Int), B:Stmts) => For(T, V, B) ... </k>
   107	       <heap> ... H |-> V:Val ... </heap>
   108	       [priority(40)]
   109	endmodule
     1	// reference/src/semantics/operators.k — MPY-OPERATORS
     2	// The operator DISPATCH layer: operands evaluate by strictness (heat/cool over KResult=Val),
     3	// the cooled node hands to applyUn/applyBin/applyCmp (declared in core.k; each domain file
     4	// owns its cases — bool.k, int.k, float.k, str.k, list.k, tuple.k, set.k, dict.k).
     5	
     6	module MPY-OPERATORS
     7	  imports MPY-CORE
     8	  imports MPY-ITER
     9	
    10	  rule <k> UnaryOp(OP:String, V:Val) => applyUn(OP, V) ... </k>
    11	
    12	  rule <k> BinOp(OP:String, L:Val, R:Val) => applyBin(OP, L, R) ... </k>
    13	
    14	  // Compare's right operand sits under the CmpOp wrapper — contexts instead of attributes
    15	  context Compare(HOLE, _)
    16	  context Compare(_:Val, CmpOp(_, HOLE))
    17	  rule <k> Compare(LV:Val, CmpOp(OP:String, RV:Val)) => applyCmp(OP, LV, RV) ... </k> [owise]
    18	
    19	  rule applyCmp("is",     V:Val, noneV) => V ==K noneV
    20	  rule applyCmp("is not", V:Val, noneV) => notBool (V ==K noneV)
    21	
    22	  // ==== operand deref: heap objects combine/compare by STRUCTURE ============
    23	  // (Python: list == is structural; identity only via `is`.) priority(40)
    24	  // preempts the generic dispatch so applyUn/applyBin/applyCmp never see a ref.
    25	  rule <k> BinOp(OP:String, ref(H:Int), R:Expr) => BinOp(OP, V, R) ... </k>
    26	       <heap> ... H |-> V:Val ... </heap>
    27	       [priority(40)]
    28	  rule <k> BinOp(OP:String, L:Val, ref(H:Int)) => BinOp(OP, L, V) ... </k>
    29	       <heap> ... H |-> V:Val ... </heap>
    30	       requires notBool isRefV(L)
    31	       [priority(40)]
    32	
    33	  // the left operand of `in`/`not in` is an ELEMENT (compares by ==K) — never deref'd
    34	  rule <k> Compare(ref(H:Int), CmpOp(OP:String, R:Expr)) => Compare(V, CmpOp(OP, R)) ... </k>
    35	       <heap> ... H |-> V:Val ... </heap>
    36	       requires OP =/=String "in" andBool OP =/=String "not in"
    37	       [priority(40)]
    38	  rule <k> Compare(L:Val, CmpOp(OP:String, ref(H:Int))) => Compare(L, CmpOp(OP, V)) ... </k>
    39	       <heap> ... H |-> V:Val ... </heap>
    40	       requires notBool isRefV(L)
    41	        orBool OP ==String "in" orBool OP ==String "not in"
    42	       [priority(40)]
    43	
    44	  rule <k> UnaryOp(OP:String, ref(H:Int)) => UnaryOp(OP, V) ... </k>
    45	       <heap> ... H |-> V:Val ... </heap>
    46	       [priority(40)]
    47	endmodule
     1	// reference/src/semantics/sort.k — MPY-SORT
     2	// Trusted sorted(): sorted(list) as an opaque ascending permutation `sortVS` — opaque symbolic
     3	// for kprove (a trusted primitive, correctness/ordering proved in Lean / notes/sort-probe),
     4	// and a concrete insertion sort for krun. Wrappers verify the logic AROUND the sort (index /
     5	// slice / filter / dedup); indexing an opaque sortVS(VS) carries through as an opaque term, so
     6	// no ordering lemma is needed in K — the trust (sortVS = real sorted) is discharged by each
     7	// problem's differential test. Only int lists (compared by projectIntTotal); keyed / string
     8	// sorts are separate. Fires only via the "sorted" builtin, so inert for non-sorting programs.
     9	
    10	module MPY-SORT
    11	  imports MPY-BUILTINS
    12	  imports MPY-SUBSCRIPT
    13	
    14	  // sortVS(VS): the ascending sort of the Val list VS. Opaque for symbolic VS (no-evaluators);
    15	  // concrete insertion sort for krun.
    16	  // Concrete sort matches Int-sorted elements directly (an int Val IS an Int); projectIntTotal
    17	  // (lemmas-only) is not available in the semantics. Int and str lists.
    18	  syntax ValSeq ::= sortVS(ValSeq) [function, total, symbol(sortVS), no-evaluators]
    19	  syntax ValSeq ::= insVS(Int, ValSeq) [function]
    20	  rule sortVS(.ValSeq)                => .ValSeq          [concrete]
    21	  rule sortVS(vCons(X:Int, R:ValSeq)) => insVS(X, sortVS(R)) [concrete]
    22	  rule insVS(X:Int, .ValSeq)                => vCons(X, .ValSeq) [concrete]
    23	  rule insVS(X:Int, vCons(Y:Int, R:ValSeq)) => vCons(X, vCons(Y, R)) requires X <=Int Y [concrete]
    24	  rule insVS(X:Int, vCons(Y:Int, R:ValSeq)) => vCons(Y, insVS(X, R)) requires X  >Int Y [concrete]
    25	  // str elements insert by the shared lexicographic strLt (methods.k)
    26	  syntax ValSeq ::= insVSs(IntSeq, ValSeq) [function]
    27	  rule sortVS(vCons(str(CS:IntSeq), R:ValSeq)) => insVSs(CS, sortVS(R)) [concrete]
    28	  rule insVSs(A:IntSeq, .ValSeq) => vCons(str(A), .ValSeq) [concrete]
    29	  rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(A), vCons(str(B), R))
    30	       requires strLt(A, B) orBool A ==K B [concrete]
    31	  rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(B), insVSs(A, R))
    32	       requires notBool (strLt(A, B) orBool A ==K B) [concrete]
    33	
    34	  // sorted(list) constructs a NEW object: k-cell pre-dispatch (beats the [owise]
    35	  // applyBuiltin routing in call.k) so the result allocates.
    36	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), .Vals))
    37	        => #alloc(list(sortVS(VS))) ... </k>
    38	
    39	  // mutator: xs.sort() — the in-place heap write over the same trusted sortVS
    40	  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), "sort")), .Vals) => noneV ... </k>
    41	       <heap> ... H |-> list(VS:ValSeq => sortVS(VS)) ... </heap>
    42	       [priority(40)]
    43	
    44	  // ==== keyed / reversed sorted() (WP2) =====================================
    45	  // sortKeyVS(VS, KV): the stable ascending sort of VS by the key value KV
    46	  // (a closure/builtin/type — anything callable). OPAQUE here; the concrete
    47	  // leg (MPY-CONCRETE, llvm only) computes keys by REAL calls and stable-
    48	  // inserts, at priority(40) over these.
    49	  syntax ValSeq ::= sortKeyVS(ValSeq, Val) [function, total, symbol(sortKeyVS), no-evaluators]
    50	
    51	  syntax ValSeq ::= revVS(ValSeq) [function, total]
    52	                  | revVSAcc(ValSeq, ValSeq) [function, total]
    53	  rule revVS(S:ValSeq) => revVSAcc(S, .ValSeq)
    54	  rule revVSAcc(.ValSeq, A:ValSeq) => A
    55	  rule revVSAcc(vCons(V:Val, R:ValSeq), A:ValSeq) => revVSAcc(R, vCons(V, A))
    56	
    57	  syntax ValSeq ::= condRev(ValSeq, Bool) [function, total]
    58	  rule condRev(S:ValSeq, false) => S
    59	  rule condRev(S:ValSeq, true)  => revVS(S)
    60	
    61	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
    62	        => #alloc(list(sortKeyVS(VS, KV))) ... </k>
    63	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
    64	        => #alloc(list(condRev(sortKeyVS(VS, KV), RB))) ... </k>
    65	  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("reverse", RB:Bool), .Vals))
    66	        => #alloc(list(condRev(sortVS(VS), RB))) ... </k>
    67	
    68	  // Indexing the opaque sorted list: `valSeqAt(sortVS(VS), I)` is DEFINED because valSeqAt is
    69	  // [total] (subscript.k) — it stays an abstract total value for a symbolic sort and reduces
    70	  // over the concrete sort for krun. No separate sortedAt indirection is needed; wrappers write
    71	  // their postcondition directly as valSeqAt(sortVS(VS), …).
    72	endmodule
   100	  rule maxVals(M:Int, (I:Int, R:Vals)) => maxVals(maxInt(M, I), R)
   101	
   102	  syntax Int ::= minVals(Int, Vals) [function]
   103	  rule applyBuiltin("min", I:Int, REST:Vals) => minVals(I, REST)
   104	  rule minVals(M:Int, .Vals)           => M
   105	  rule minVals(M:Int, (I:Int, R:Vals)) => minVals(minInt(M, I), R)
   106	
   107	  // ==== bin(n) — "0b" + binary digit codes (promoted from 103's defined fold) ==
   108	  rule applyBuiltin("bin", N:Int, .Vals) => str(iCons(48, iCons(98, binCodes(N))))
   109	       requires N >=Int 0
   110	  // negative operand: the '-' sign prefixes the magnitude's digits
   111	  rule applyBuiltin("bin", N:Int, .Vals)
   112	    => str(iCons(45, iCons(48, iCons(98, binCodes(0 -Int N)))))
   113	       requires N <Int 0
   114	  syntax IntSeq ::= binCodes(Int) [function, total]
   115	  rule binCodes(0) => iCons(48, .IntSeq)
   116	  rule binCodes(N:Int) => binAcc(N, .IntSeq) requires N >Int 0
   117	  syntax IntSeq ::= binAcc(Int, IntSeq) [function, total]
   118	  rule binAcc(0, ACC:IntSeq) => ACC
   119	  rule binAcc(N:Int, ACC:IntSeq)
   120	    => binAcc((N -Int pyMod(N, 2)) /Int 2, iCons(48 +Int pyMod(N, 2), ACC))
   121	       requires N >Int 0
   122	
   123	  // ==== enumerate(xs) — pairs (i, v); materialized eagerly over a list =========
   124	  rule <k> #applyK(toCall(builtinV("enumerate")), (list(VS:ValSeq), .Vals))
   125	        => #alloc(list(enumVS(VS, 0))) ... </k>
   126	  syntax ValSeq ::= enumVS(ValSeq, Int) [function, total]
   127	  rule enumVS(.ValSeq, _:Int) => .ValSeq
   128	  rule enumVS(vCons(V:Val, R:ValSeq), I:Int)
   129	    => vCons(tuple(vCons(I, vCons(V, .ValSeq))), enumVS(R, I +Int 1))
   130	
     1	// reference/src/semantics/methods.k — MPY-METHODS
     2	
     3	module MPY-METHODS
     4	  imports MPY-CORE
     5	  imports K-EQUAL
     6	  imports MPY-STR
     7	  imports MPY-LIST
     8	
     9	  // method-call routing + arg-eval live in call.k; this module owns applyMethod.
    10	  syntax Val ::= applyMethod(Val, String, Vals) [function]
    11	
    12	  // ==== string predicates (Python semantics) =================================
    13	  rule applyMethod(str(CS:IntSeq), "isupper", .Vals) => hasUpper(CS) andBool notBool hasLower(CS)
    14	  rule applyMethod(str(CS:IntSeq), "islower", .Vals) => hasLower(CS) andBool notBool hasUpper(CS)
    15	  rule applyMethod(str(CS:IntSeq), "isalpha", .Vals) => notBool (CS ==K .IntSeq) andBool allAlpha(CS)
    16	  rule applyMethod(str(CS:IntSeq), "isdigit", .Vals) => notBool (CS ==K .IntSeq) andBool allDigit(CS)
    17	
    18	  // ==== case maps ============================================================
    19	  rule applyMethod(str(CS:IntSeq), "lower",    .Vals) => str(mapLower(CS))
    20	  rule applyMethod(str(CS:IntSeq), "upper",    .Vals) => str(mapUpper(CS))
    21	  rule applyMethod(str(CS:IntSeq), "swapcase", .Vals) => str(mapSwap(CS))
    22	
    23	  // ==== join / count / strip / encode ========================================
    24	  // S.join(list-of-str): fold with separator codes (receiver + arg deref'd by
    25	  // the call layer; the result str is a value)
    26	  rule applyMethod(str(SEP:IntSeq), "join", list(VS:ValSeq), .Vals) => str(joinCodes(SEP, VS))
    27	  syntax IntSeq ::= joinCodes(IntSeq, ValSeq) [function, total]
    28	  rule joinCodes(_:IntSeq, .ValSeq) => .IntSeq
    29	  rule joinCodes(_:IntSeq, vCons(str(CS:IntSeq), .ValSeq)) => CS
    30	  rule joinCodes(SEP:IntSeq, vCons(str(CS:IntSeq), vCons(V:Val, R:ValSeq)))
    31	    => seqConcat(CS, seqConcat(SEP, joinCodes(SEP, vCons(V, R))))
    32	
    33	  // S.count(sub): non-overlapping window scan (Python str.count)
    34	  rule applyMethod(str(CS:IntSeq), "count", str(PC:IntSeq), .Vals) => cntSub(CS, PC)
    35	  syntax Int ::= cntSub(IntSeq, IntSeq) [function]
    36	  rule cntSub(.IntSeq, _:IntSeq) => 0
    37	  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => 1 +Int cntSub(dropIS(iCons(C, R), isLen(PC)), PC)
    38	       requires strPrefix(PC, iCons(C, R)) andBool isLen(PC) >Int 0
    39	  rule cntSub(iCons(C:Int, R:IntSeq), PC:IntSeq) => cntSub(R, PC)
    40	       requires notBool strPrefix(PC, iCons(C, R)) orBool isLen(PC) <=Int 0
    41	  syntax IntSeq ::= dropIS(IntSeq, Int) [function, total]
    42	  rule dropIS(S:IntSeq, N:Int) => S requires N <=Int 0
    43	  rule dropIS(.IntSeq, _:Int) => .IntSeq [owise]
    44	  rule dropIS(iCons(_:Int, R:IntSeq), N:Int) => dropIS(R, N -Int 1) requires N >Int 0
    45	
    46	  // S.strip(): trim whitespace runs from both ends
    47	  rule applyMethod(str(CS:IntSeq), "strip", .Vals) => str(revIS(trimWS(revIS(trimWS(CS)))))
    48	  syntax IntSeq ::= trimWS(IntSeq) [function, total]
    49	  rule trimWS(.IntSeq) => .IntSeq
    50	  rule trimWS(iCons(C:Int, R:IntSeq)) => trimWS(R) requires isWSC(C)
     1	// reference/src/semantics/call.k — MPY-CALL
     2	// ONE call route for every callable: evaluate the callee to a VALUE (name lookup reaches
     3	// builtins at the root; a cooled Attribute is a bound method), evaluate the args (the shared
     4	// #evalArgs loop in core.k), then dispatch on the callee value:
     5	//   closureVal    -> bind params, push a frame (user function)
     6	//   boundMethodV  -> applyMethod
     7	//   builtinV      -> the #iterNext folds (sum/all/any/max/min) or applyBuiltin
     8	//   typeV         -> callable type objects: int(...) / str(...)
     9	
    10	module MPY-CALL
    11	  imports MPY-METHODS
    12	  imports MPY-BUILTINS
    13	  imports MPY-FUNCTIONS
    14	
    15	  // a cooled attribute is a bound method value
    16	  rule <k> Attribute(V:Val, M:String) => boundMethodV(V, M) ... </k>
    17	
    18	  // evaluate callee, then args ([owise]: problem-local Call interceptions beat this)
    19	  syntax KItem ::= #callee(Exprs)
    20	  rule <k> Call(Fe:Expr, ARGS:Exprs) => Fe ~> #callee(ARGS) ... </k> [owise]
    21	  rule <k> CV:Val ~> #callee(ARGS:Exprs) => #evalArgs(ARGS, .Vals, toCall(CV)) ... </k>
    22	
    23	  // ==== dispatch on the callee value ========================================
    24	  rule <k> #applyK(toCall(boundMethodV(OBJ:Val, M:String)), ACC:Vals) => applyMethod(OBJ, M, ACC) ... </k>
    25	
    26	  rule <k> #applyK(toCall(builtinV("sum")), (OBJ:Iterable, .Vals)) => #sumAcc(OBJ, 0) ... </k>
    27	  rule <k> #applyK(toCall(builtinV("all")), (OBJ:Iterable, .Vals)) => #allAcc(OBJ)    ... </k>
    28	  rule <k> #applyK(toCall(builtinV("any")), (OBJ:Iterable, .Vals)) => #anyAcc(OBJ)    ... </k>
    29	  rule <k> #applyK(toCall(builtinV("max")), (OBJ:Iterable, .Vals)) => #maxAcc0(OBJ)   ... </k>
    30	  rule <k> #applyK(toCall(builtinV("min")), (OBJ:Iterable, .Vals)) => #minAcc0(OBJ)   ... </k>
    31	  rule <k> #applyK(toCall(builtinV(BN:String)), ACC:Vals) => applyBuiltin(BN, ACC) ... </k> [owise]
    32	  rule <k> #applyK(toCall(typeV(T:String)),     ACC:Vals) => applyBuiltin(T, ACC)  ... </k>
    33	
    34	  // ==== heap-object arguments/receivers =====================================
    35	  // Builtins and type calls READ structure — deref the first two arg positions
    36	  // (covers len/sum/all/any/max/min/sorted/list/set + zip's pair). Mutating list
    37	  // methods take the ref itself; every other method receiver is deref'd.
    38	  rule <k> #applyK(toCall(builtinV(BN:String)), (ref(H:Int), REST:Vals))
    39	        => #applyK(toCall(builtinV(BN)), (V, REST)) ... </k>
    40	       <heap> ... H |-> V:Val ... </heap>
    41	       [priority(40)]
    42	  rule <k> #applyK(toCall(builtinV(BN:String)), (A:Val, ref(H:Int), REST:Vals))
    43	        => #applyK(toCall(builtinV(BN)), (A, V, REST)) ... </k>
    44	       <heap> ... H |-> V:Val ... </heap>
    45	       requires notBool isRefV(A)
    46	       [priority(40)]
    47	  rule <k> #applyK(toCall(typeV(T:String)), (ref(H:Int), REST:Vals))
    48	        => #applyK(toCall(typeV(T)), (V, REST)) ... </k>
    49	       <heap> ... H |-> V:Val ... </heap>
    50	       [priority(40)]
    51	
    52	  syntax Bool ::= isMutMethod(String) [function, total]
    53	  rule isMutMethod(M:String)
    54	    => M ==String "append" orBool M ==String "sort" orBool M ==String "extend"
    55	       orBool M ==String "insert" orBool M ==String "pop" orBool M ==String "remove"
    56	  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), M:String)), ACC:Vals)
    57	        => #applyK(toCall(boundMethodV(V, M)), ACC) ... </k>
    58	       <heap> ... H |-> V:Val ... </heap>
    59	       requires notBool isMutMethod(M)
    60	       [priority(40)]
    61	  // non-mutating methods READ their heap-object arguments too (join's list);
    62	  // mutators keep refs (append of a list into a list-of-lists stays aliased)
    63	  rule <k> #applyK(toCall(boundMethodV(OBJ:Val, M:String)), (ref(H:Int), REST:Vals))
    64	        => #applyK(toCall(boundMethodV(OBJ, M)), (V, REST)) ... </k>
    65	       <heap> ... H |-> V:Val ... </heap>
    66	       requires notBool isMutMethod(M) andBool notBool isRefV(OBJ)
    67	       [priority(40)]
    68	
    69	  rule <k> #applyK(toCall(closureVal(PNS:ParamNames, BODY:Stmts, DEFL:Int)), ACC:Vals) ~> CONT
    70	        => #bindP(PNS, ACC) ~> BODY ~> #endcall </k>
    71	       <env>     CALLERL:Int => NEWL </env>
    72	       <scopes>   STORE:Map => STORE [ NEWL <- scope(.Map, parent(DEFL)) ] </scopes>
    73	       <scopeLoc> NEWL:Int => NEWL +Int 1 </scopeLoc>
    74	       <stack>   .List => ListItem(frame(CONT, CALLERL, NEWL)) ... </stack>
    75	
    76	  // annotated closure: the frame starts with the captured freevar cells, its
    77	  // parent is the module scope (all enclosing-local reads go through cells),
    78	  // and the cellvars' fresh cells allocate before params bind (a cellvar param
    79	  // then writes through its cell in #bindP).
    80	  rule <k> #applyK(toCall(closureValC(PNS:ParamNames, CVS:ParamNames, BODY:Stmts, CM:Map)), ACC:Vals) ~> CONT
    81	        => #allocCells(CVS) ~> #bindP(PNS, ACC) ~> BODY ~> #endcall </k>
    82	       <env>     CALLERL:Int => NEWL </env>
    83	       <scopes>   STORE:Map => STORE [ NEWL <- scope(CM [ "$cells" <- cellsMark(CVS) ], parent(0)) ] </scopes>
    84	       <scopeLoc> NEWL:Int => NEWL +Int 1 </scopeLoc>
    85	       <stack>   .List => ListItem(frame(CONT, CALLERL, NEWL)) ... </stack>
    86	
    87	  syntax KItem ::= #allocCells(ParamNames)
    88	  rule <k> #allocCells(.ParamNames) => .K ... </k>
    89	  rule <k> #allocCells((CV:String, R:ParamNames)) => #allocCells(R) ... </k>
    90	       <env> L:Int </env>
    91	       <scopes> ... L |-> scope(M:Map => M [ CV <- cellRef(N) ], _) ... </scopes>
    92	       <heap>    H:Map => (N |-> cellV(noneV)) H </heap>
    93	       <heapLoc> N:Int => N +Int 1 </heapLoc>
    94	       requires notBool N in_keys(H)
    95	endmodule
     1	// reference/src/semantics/functions.k — MPY-FUNCTIONS
     2	
     3	module MPY-FUNCTIONS
     4	  imports MPY-CORE
     5	
     6	  // call routing + callee/arg evaluation (#callee/#args/#argCont) live in call.k;
     7	  // this module owns the frame lifecycle (bind params, return, pop).
     8	  syntax KItem ::= frame(continuation: K, callerEnv: Int, savedLoc: Int)
     9	                 | #bindP(ParamNames, Vals)
    10	                 | "#pop"
    11	                 | "#endcall"
    12	
    13	  // ==== def / anonymous closure =============================================
    14	  rule <k> FuncDef(F:String, Params(PNS:ParamNames), BODY:Stmts) => .K ... </k>
    15	       <env> L:Int </env>
    16	       <scopes> ... L |-> scope(M:Map => M [ F <- closureVal(PNS, BODY, L) ], _) ... </scopes>
    17	
    18	  syntax Expr ::= closureExpr(ParamNames, Stmts)
    19	  rule <k> closureExpr(PNS:ParamNames, BODY:Stmts) => closureVal(PNS, BODY, L) ... </k>
    20	       <env> L:Int </env>
    21	
    22	  // ==== annotated def/lambda (closure cells; spec 2.3) ======================
    23	  // closureValC(params, cellvars, body, captured-cells). No frame anchor: all
    24	  // enclosing-local reads are freevars (symtable-complete) and go through the
    25	  // captured cells; everything else is global/builtin, so the callee frame's
    26	  // parent is the module scope (0) — sound after the defining frame dies.
    27	  syntax Val ::= closureValC(ParamNames, ParamNames, Stmts, Map)
    28	
    29	  // capture: resolve each freevar to the enclosing frame's cellRef, then bind
    30	  // (FuncDef) or yield (Lambda) the closure value.
    31	  syntax KItem ::= #mkClosure(String, ParamNames, ParamNames, ParamNames, Stmts, Map)
    32	                 | #mkLambda(ParamNames, ParamNames, ParamNames, Stmts, Map)
    33	  rule <k> FuncDef(F:String, Params(PNS:ParamNames), CellVars(CVS:ParamNames),
    34	                   FreeVars(FVS:ParamNames), BODY:Stmts)
    35	        => #mkClosure(F, PNS, CVS, FVS, BODY, .Map) ... </k>
    36	  rule <k> #mkClosure(F:String, PNS:ParamNames, CVS:ParamNames,
    37	                      (FV:String, FVR:ParamNames), BODY:Stmts, CM:Map)
    38	        => #mkClosure(F, PNS, CVS, FVR, BODY, CM [ FV <- {M[FV]}:>Val ]) ... </k>
    39	       <env> L:Int </env>
    40	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    41	       requires FV in_keys(M)
    42	  rule <k> #mkClosure(F:String, PNS:ParamNames, CVS:ParamNames,
    43	                      .ParamNames, BODY:Stmts, CM:Map) => .K ... </k>
    44	       <env> L:Int </env>
    45	       <scopes> ... L |-> scope(M:Map => M [ F <- closureValC(PNS, CVS, BODY, CM) ], _) ... </scopes>
    46	
    47	  rule <k> Lambda(Params(PNS:ParamNames), E:Expr)
    48	        => closureVal(PNS, Return(E) .Stmts, L) ... </k>
    49	       <env> L:Int </env>
    50	  rule <k> Lambda(Params(PNS:ParamNames), CellVars(CVS:ParamNames),
    51	                  FreeVars(FVS:ParamNames), E:Expr)
    52	        => #mkLambda(PNS, CVS, FVS, Return(E) .Stmts, .Map) ... </k>
    53	  rule <k> #mkLambda(PNS:ParamNames, CVS:ParamNames,
    54	                     (FV:String, FVR:ParamNames), BODY:Stmts, CM:Map)
    55	        => #mkLambda(PNS, CVS, FVR, BODY, CM [ FV <- {M[FV]}:>Val ]) ... </k>
    56	       <env> L:Int </env>
    57	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    58	       requires FV in_keys(M)
    59	  rule <k> #mkLambda(PNS:ParamNames, CVS:ParamNames, .ParamNames, BODY:Stmts, CM:Map)
    60	        => closureValC(PNS, CVS, BODY, CM) ... </k>
    61	
    62	  // ==== bind params ========================================================
    63	  rule <k> #bindP(.ParamNames, .Vals) => .K ... </k>
    64	  rule <k> #bindP((P:String, PS:ParamNames), (V:Val, VS:Vals)) => #bindP(PS, VS) ... </k>
    65	       <env> L:Int </env>
    66	       <scopes> ... L |-> scope(M:Map => M [ P <- V ], _) ... </scopes>
    67	  // a param that is a cellvar was pre-bound to its cell at frame entry
    68	  rule <k> #bindP((P:String, PS:ParamNames), (V:Val, VS:Vals))
    69	        => #cellW({M[P]}:>Val, V) ~> #bindP(PS, VS) ... </k>
    70	       <env> L:Int </env>
    71	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    72	       requires "$cells" in_keys(M)
    73	        andBool pnMember(P, cellsOf({M["$cells"]}:>Val))
    74	        andBool P in_keys(M) andBool isCellRef({M[P]}:>Val)
    75	       [priority(40)]
    76	
    77	  // ==== return / pop the frame (the returned expr evaluates by strictness) ==
    78	  rule <k> Return(V:Val) ~> _ => #pop </k>
    79	       <ret> noRet => retV(V) </ret>
    80	  rule <k> #endcall => #pop ... </k>
    81	       <ret> noRet => retV(noneV) </ret>
    82	  // pop: restore env, DEALLOCATE the callee frame, and wind scopeLoc back (LIFO allocation
    83	  // makes the saved loc the callee frame's own loc). Sound because no closureVal outlives its
    84	  // defining frame (frontend subset: no returned/stored closures; module defs live in loc 0).
    85	  rule <k> #pop => V ~> CONT </k>
    86	       <ret>   retV(V) => noRet </ret>
    87	       <stack> ListItem(frame(CONT:K, CALLERL:Int, SAVEDL:Int)) => .List ... </stack>
    88	       <env>   L:Int => CALLERL </env>
    89	       <scopes> SC:Map => SC [ L <- undef ] </scopes>
    90	       <scopeLoc> _ => SAVEDL </scopeLoc>
    91	endmodule

diff --git a/evidence/concrete_audit.py b/evidence/concrete_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..6e6f414f2e64102444877cd134c08e10ac583662
--- /dev/null
+++ b/evidence/concrete_audit.py
@@ -0,0 +1,20 @@
+def sort_array(arr):
+    return sorted(
+        sorted(arr),
+        key=lambda value: (
+            0
+            if value < 0
+            else bin(value).count("1")
+        ),
+    )
+
+
+assert sort_array([]) == []
+assert sort_array([0]) == [0]
+assert sort_array([1, 0]) == [0, 1]
+assert sort_array([1, 5, 2, 3, 4]) == [1, 2, 4, 3, 5]
+assert sort_array([0, 1, 2, 3, 4, 7, 8, 15, 16]) == [
+    0, 1, 2, 4, 8, 16, 3, 7, 15
+]
+assert sort_array([3, 3, 0, 7, 1, 1]) == [0, 1, 1, 3, 3, 7]
+assert sort_array([-2, -3, -4, -5, -6]) == [-6, -5, -4, -3, -2]
diff --git a/evidence/differential_audit.py b/evidence/differential_audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..da8c38a801bed3f531763a09b01f533a1ba7c621
--- /dev/null
+++ b/evidence/differential_audit.py
@@ -0,0 +1,172 @@
+#!/usr/bin/env python3
+"""Independent differential test for HumanEval/116-sort-array.
+
+The oracle and candidate modules are imported directly from the trusted and
+scratch paths supplied on the command line.  The intended-domain suite contains
+only lists of non-negative Python integers.  Contradictory prompt examples and
+negative exploratory cases are reported separately.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import importlib.util
+import itertools
+import json
+import random
+from pathlib import Path
+from types import ModuleType
+from typing import Callable
+
+
+def load_module(name: str, path: Path) -> ModuleType:
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def encode_inputs(cases: list[list[int]]) -> bytes:
+    return json.dumps(cases, separators=(",", ":"), ensure_ascii=True).encode()
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--canonical", type=Path, required=True)
+    parser.add_argument("--candidate", type=Path, required=True)
+    parser.add_argument("--inputs-out", type=Path, required=True)
+    parser.add_argument("--results-out", type=Path, required=True)
+    args = parser.parse_args()
+
+    oracle: Callable[[list[int]], list[int]] = load_module(
+        "trusted_canonical", args.canonical
+    ).sort_array
+    generated: Callable[[list[int]], list[int]] = load_module(
+        "generated_solution", args.candidate
+    ).sort_array
+
+    named: list[tuple[str, list[int]]] = [
+        ("empty", []),
+        ("singleton_zero", [0]),
+        ("singleton_one", [1]),
+        ("branch_boundary_0_1", [1, 0]),
+        ("duplicates", [3, 3, 0, 7, 1, 1]),
+        ("prompt_example_1", [1, 5, 2, 3, 4]),
+        ("prompt_example_3", [1, 0, 2, 3, 4]),
+        ("binary_boundaries", [0, 1, 2, 3, 4, 7, 8, 15, 16, 31, 32, 33]),
+        ("tie_breaks", [10, 9, 6, 5, 3, 12]),
+        ("large_ints", [2**128, 2**128 - 1, 2**128 + 1, 2**255]),
+    ]
+
+    exhaustive = [
+        list(xs)
+        for length in range(5)
+        for xs in itertools.product(range(9), repeat=length)
+    ]
+
+    rng = random.Random(116)
+    generated_cases: list[list[int]] = []
+    boundary_values = [
+        0,
+        1,
+        2,
+        3,
+        4,
+        7,
+        8,
+        15,
+        16,
+        31,
+        32,
+        63,
+        64,
+        127,
+        128,
+        255,
+        256,
+        2**32 - 1,
+        2**32,
+        2**63,
+    ]
+    for _ in range(1000):
+        length = rng.randrange(0, 30)
+        generated_cases.append(
+            [
+                rng.choice(boundary_values)
+                if rng.random() < 0.55
+                else rng.randrange(0, 2**80)
+                for _ in range(length)
+            ]
+        )
+
+    intended_cases = [case for _, case in named] + exhaustive + generated_cases
+    mismatches: list[dict[str, object]] = []
+    mutation_errors: list[dict[str, object]] = []
+    for index, case in enumerate(intended_cases):
+        before = list(case)
+        expected = oracle(list(case))
+        actual = generated(list(case))
+        if case != before:
+            mutation_errors.append({"index": index, "input": before, "after": case})
+        if expected != actual:
+            mismatches.append(
+                {
+                    "index": index,
+                    "input": before,
+                    "canonical": expected,
+                    "candidate": actual,
+                }
+            )
+
+    contradictory_expectations = [
+        {
+            "input": [1, 5, 2, 3, 4],
+            "prompt_expected": [1, 2, 3, 4, 5],
+            "canonical": oracle([1, 5, 2, 3, 4]),
+            "candidate": generated([1, 5, 2, 3, 4]),
+        },
+        {
+            "input": [1, 0, 2, 3, 4],
+            "prompt_expected": [0, 1, 2, 3, 4],
+            "canonical": oracle([1, 0, 2, 3, 4]),
+            "candidate": generated([1, 0, 2, 3, 4]),
+        },
+    ]
+    outside_domain = []
+    for case in [[-1], [-2, -3, -4, -5, -6], [-1, 0, 1], [-8, -7, -3, 2]]:
+        outside_domain.append(
+            {
+                "input": case,
+                "canonical": oracle(list(case)),
+                "candidate": generated(list(case)),
+            }
+        )
+
+    input_bytes = encode_inputs(intended_cases)
+    args.inputs_out.write_bytes(input_bytes + b"\n")
+    results = {
+        "intended_domain": "finite lists of non-negative Python integers",
+        "named_count": len(named),
+        "exhaustive_scope": "all lists of lengths 0..4 over integer values 0..8",
+        "exhaustive_count": len(exhaustive),
+        "generated_scope": "1000 deterministic lists, lengths 0..29, seed 116",
+        "generated_count": len(generated_cases),
+        "total_intended_count": len(intended_cases),
+        "inputs_sha256": hashlib.sha256(input_bytes).hexdigest(),
+        "mismatch_count": len(mismatches),
+        "mismatches": mismatches,
+        "input_mutation_count": len(mutation_errors),
+        "input_mutations": mutation_errors,
+        "contradictory_prompt_examples": contradictory_expectations,
+        "outside_domain_observations": outside_domain,
+    }
+    args.results_out.write_text(json.dumps(results, indent=2) + "\n")
+    print(json.dumps(results, indent=2))
+    return 0 if not mismatches and not mutation_errors else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/evidence/integrity_audit.sh b/evidence/integrity_audit.sh
new file mode 100644
index 0000000000000000000000000000000000000000..0c4af07e65dba706cd3b892ddbb5fa5c28cc502e
--- /dev/null
+++ b/evidence/integrity_audit.sh
@@ -0,0 +1,71 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+candidate=/candidate
+reference=/reference
+status=0
+
+for artifact in run-input.json metrics.json codex-last.txt codex-output.log; do
+  if [[ -e "$candidate/$artifact" || -L "$candidate/$artifact" ]]; then
+    printf 'PRESENT_REQUIRED_PROVENANCE: %s\n' "$artifact"
+    stat -c 'TYPE=%F MODE=%A SIZE=%s PATH=%n' "$candidate/$artifact"
+  else
+    printf 'MISSING_REQUIRED_PROVENANCE: %s\n' "$artifact"
+  fi
+done
+
+printf 'STRUCTURED_TRACE_CANDIDATES:\n'
+find -P "$candidate" -maxdepth 1 -type f \
+  \( -iname '*trace*.json' -o -iname '*trace*.jsonl' -o -iname '*trace*.log' \) \
+  -printf '%f\n' | sort
+
+for pair in \
+  "$reference/prompt.py:$candidate/prompt.py" \
+  "$reference/py2mpy.py:$candidate/py2mpy.py"; do
+  trusted=${pair%%:*}
+  submitted=${pair#*:}
+  if [[ -L "$submitted" ]]; then
+    printf 'INTEGRITY_FAILURE_SYMLINK: %s -> %s\n' "$submitted" "$(readlink "$submitted")"
+    status=1
+  elif [[ ! -f "$submitted" ]]; then
+    printf 'INTEGRITY_FAILURE_MISSING_OR_MISTYPED: %s\n' "$submitted"
+    status=1
+  elif cmp -s "$trusted" "$submitted"; then
+    printf 'BYTE_IDENTICAL: %s %s\n' "$trusted" "$submitted"
+    sha256sum "$trusted" "$submitted"
+  else
+    printf 'INTEGRITY_FAILURE_CHANGED: %s %s\n' "$trusted" "$submitted"
+    diff -u "$trusted" "$submitted" || true
+    status=1
+  fi
+done
+
+if [[ ! -d "$reference/reference-semantics" || -L "$reference/reference-semantics" ]]; then
+  printf 'INFRASTRUCTURE_BREACH_TRUSTED_SEMANTICS_TYPE: %s\n' \
+    "$reference/reference-semantics"
+  exit 2
+fi
+
+printf 'CANDIDATE_SEMANTICS_SYMLINKS:\n'
+find -P "$candidate/reference-semantics" -type l -printf '%p -> %l\n' | sort
+if find -P "$candidate/reference-semantics" -type l -print -quit | grep -q .; then
+  status=1
+fi
+
+set +e
+diff -r --no-dereference --brief \
+  "$reference/reference-semantics" "$candidate/reference-semantics"
+semantics_diff=$?
+set -e
+printf 'SEMANTICS_RECURSIVE_DIFF_STATUS: %s\n' "$semantics_diff"
+if [[ "$semantics_diff" -ne 0 ]]; then
+  status=1
+else
+  printf 'SEMANTICS_TREE_BYTE_AND_ENTRY_IDENTICAL: yes\n'
+fi
+
+printf 'CANDIDATE_TOP_LEVEL_TYPES:\n'
+find -P "$candidate" -maxdepth 1 -mindepth 1 \
+  -printf '%y %f -> %l\n' | sort
+
+exit "$status"
diff --git a/evidence/k_rule_inventory.py b/evidence/k_rule_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..49ee5af9ca243824d9bc66a6db069d33c1a920ac
--- /dev/null
+++ b/evidence/k_rule_inventory.py
@@ -0,0 +1,169 @@
+#!/usr/bin/env python3
+"""Emit a lossless, line-addressed inventory of candidate K declarations."""
+
+from __future__ import annotations
+
+import csv
+import json
+import re
+from collections import Counter
+from pathlib import Path
+
+
+ROOTS = [
+    Path("/candidate/reference-semantics"),
+    Path("/candidate/verification.k"),
+    Path("/candidate/spec.k"),
+]
+OUT_DIR = Path("/audit-output/evidence")
+START = re.compile(
+    r"^\s*(requires|module|imports|endmodule|configuration|syntax|rule|claim|context|alias)\b"
+)
+MODULE = re.compile(r"^\s*module\s+(\S+)")
+ATTR = re.compile(r"\[([^\]]+)\]")
+FLAGS = (
+    "function",
+    "total",
+    "functional",
+    "simplification",
+    "anywhere",
+    "priority",
+    "owise",
+    "concrete",
+    "macro",
+    "macro-rec",
+    "no-evaluators",
+    "symbol",
+)
+
+
+def source_files() -> list[Path]:
+    paths: list[Path] = []
+    for root in ROOTS:
+        if root.is_dir():
+            paths.extend(sorted(root.rglob("*.k")))
+        else:
+            paths.append(root)
+    return paths
+
+
+def disposition(path: Path, kind: str) -> str:
+    if "reference-semantics" in path.parts:
+        return "fixed-supplied-semantics"
+    if path.name == "verification.k":
+        return "candidate-proof-extension"
+    if path.name == "spec.k" and kind == "claim":
+        return "candidate-positive-claim"
+    return "candidate-spec-structure"
+
+
+def inventory_file(path: Path) -> list[dict[str, object]]:
+    lines = path.read_text().splitlines()
+    starts = [(index, START.match(line)) for index, line in enumerate(lines)]
+    starts = [(index, match) for index, match in starts if match]
+    entries: list[dict[str, object]] = []
+    current_module = ""
+    for position, (index, match) in enumerate(starts):
+        assert match is not None
+        kind = match.group(1)
+        next_index = starts[position + 1][0] if position + 1 < len(starts) else len(lines)
+        block_lines = lines[index:next_index]
+        while block_lines and not block_lines[-1].strip():
+            block_lines.pop()
+        block = "\n".join(block_lines)
+        module_match = MODULE.match(lines[index])
+        if module_match:
+            current_module = module_match.group(1)
+        attrs = "; ".join(ATTR.findall(block))
+        flags = [flag for flag in FLAGS if re.search(rf"\b{re.escape(flag)}\b", attrs)]
+        entries.append(
+            {
+                "source": str(path),
+                "module": current_module,
+                "start_line": index + 1,
+                "end_line": index + max(1, len(block_lines)),
+                "kind": kind,
+                "attributes": attrs,
+                "flags": ",".join(flags),
+                "disposition": disposition(path, kind),
+                "text": block,
+            }
+        )
+        if kind == "endmodule":
+            current_module = ""
+    return entries
+
+
+def main() -> int:
+    entries: list[dict[str, object]] = []
+    for path in source_files():
+        entries.extend(inventory_file(path))
+
+    inventory_path = OUT_DIR / "k-inventory.tsv"
+    fieldnames = [
+        "id",
+        "source",
+        "module",
+        "start_line",
+        "end_line",
+        "kind",
+        "attributes",
+        "flags",
+        "disposition",
+        "text",
+    ]
+    with inventory_path.open("w", newline="") as stream:
+        writer = csv.DictWriter(
+            stream,
+            fieldnames=fieldnames,
+            delimiter="\t",
+            lineterminator="\n",
+            quoting=csv.QUOTE_MINIMAL,
+        )
+        writer.writeheader()
+        for number, entry in enumerate(entries, 1):
+            writer.writerow({"id": f"K{number:04d}", **entry})
+
+    special = [entry for entry in entries if entry["flags"]]
+    special_path = OUT_DIR / "k-special-declarations.tsv"
+    with special_path.open("w", newline="") as stream:
+        writer = csv.DictWriter(
+            stream,
+            fieldnames=fieldnames,
+            delimiter="\t",
+            lineterminator="\n",
+            quoting=csv.QUOTE_MINIMAL,
+        )
+        writer.writeheader()
+        for number, entry in enumerate(special, 1):
+            writer.writerow({"id": f"S{number:04d}", **entry})
+
+    by_kind = Counter(str(entry["kind"]) for entry in entries)
+    by_file = Counter(str(entry["source"]) for entry in entries)
+    by_disposition = Counter(str(entry["disposition"]) for entry in entries)
+    flag_counts = Counter(
+        flag
+        for entry in entries
+        for flag in str(entry["flags"]).split(",")
+        if flag
+    )
+    summary = {
+        "source_files": len(source_files()),
+        "total_entries": len(entries),
+        "by_kind": dict(sorted(by_kind.items())),
+        "by_file": dict(sorted(by_file.items())),
+        "by_disposition": dict(sorted(by_disposition.items())),
+        "flag_counts": dict(sorted(flag_counts.items())),
+        "special_entry_count": len(special),
+        "inventory": str(inventory_path),
+        "special_inventory": str(special_path),
+    }
+    (OUT_DIR / "k-inventory-summary.json").write_text(
+        json.dumps(summary, indent=2) + "\n"
+    )
+    print(json.dumps(summary, indent=2))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..fd3e82f844453e4cd4d353156eb0e82ba2da3802
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  set +e
+  "$@"
+  command_status=$?
+  set -e
+  printf 'EXIT_STATUS: %s\n' "$command_status"
+  printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  exit "$command_status"
+} 2>&1 | tee "$log_path"
+
+exit "${PIPESTATUS[0]}"
