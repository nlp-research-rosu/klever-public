Module(
  FuncDef("sort_array", Params("arr"),
    Return(
      Call(
        Name("sorted"),
        Call(Name("sorted"), Name("arr")),
        KwArg(
          "key",
          Lambda(
            Params("value"),
            CellVars(),
            FreeVars(),
            IfExp(
              Compare(Name("value"), CmpOp("<", Int(0))),
              Int(0),
              Call(
                Attribute(Call(Name("bin"), Name("value")), "count"),
                Str("1")))))))))
