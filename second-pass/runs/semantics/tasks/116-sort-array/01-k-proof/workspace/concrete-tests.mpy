Module(
  FuncDef("sort_array", Params("arr"),
    Return(
      Call(
        Name("sorted"),
        Call(Name("sorted"), Name("arr")),
        KwArg(
          "key",
          Lambda(
            Params("value"),
            CellVars(),
            FreeVars(),
            IfExp(
              Compare(Name("value"), CmpOp("<", Int(0))),
              Int(0),
              Call(
                Attribute(Call(Name("bin"), Name("value")), "count"),
                Str("1"))))))))
  Assert(
    Compare(
      Call(Name("sort_array"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("sort_array"), ListExpr(Int(0))),
      CmpOp("==", ListExpr(Int(0)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(Int(1), Int(5), Int(2), Int(3), Int(4))),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(4), Int(3), Int(5)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(Int(1), Int(0), Int(2), Int(3), Int(4))),
      CmpOp("==", ListExpr(Int(0), Int(1), Int(2), Int(4), Int(3)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(Int(7), Int(3), Int(5), Int(6), Int(9), Int(8))),
      CmpOp(
        "==",
        ListExpr(Int(8), Int(3), Int(5), Int(6), Int(9), Int(7)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(4)),
          UnaryOp("-", Int(5)),
          UnaryOp("-", Int(6)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(6)),
          UnaryOp("-", Int(5)),
          UnaryOp("-", Int(4)),
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(2)))))))
