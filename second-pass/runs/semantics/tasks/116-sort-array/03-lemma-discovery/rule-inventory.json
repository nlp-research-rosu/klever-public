      "start_line": 22,
      "text": "  rule sortArrayBody\n    => Return(\n         Call(\n           Name(\"sorted\"),\n           Call(Name(\"sorted\"), Name(\"arr\")),\n           KwArg(\"key\", sortArrayLambda)))"
    },
