requires "reference-semantics/semantics.k"

module SORT-ARRAY-VERIFICATION
  imports MPY

  // This is the translated program, factored into named terms so that the
  // specification can refer to exactly the code in solution.mpy.
  syntax Expr ::= "sortArrayLambda" [function, total]
  rule sortArrayLambda
    => Lambda(
         Params("value"),
         CellVars(.ParamNames),
         FreeVars(.ParamNames),
         IfExp(
           Compare(Name("value"), CmpOp("<", Int(0))),
           Int(0),
           Call(
             Attribute(Call(Name("bin"), Name("value")), "count"),
             Str("1"))))

  syntax Stmts ::= "sortArrayBody" [function, total]
  rule sortArrayBody
    => Return(
         Call(
           Name("sorted"),
           Call(Name("sorted"), Name("arr")),
           KwArg("key", sortArrayLambda)))

  syntax Val ::= "sortArrayClosure" [function, total]
  rule sortArrayClosure
    => closureVal("arr", sortArrayBody, 0)

  syntax Module ::= "sortArrayModule" [function, total]
  rule sortArrayModule
    => Module(FuncDef("sort_array", Params("arr"), sortArrayBody))

  // Evaluation of the annotated lambda above produces this closure.  The
  // reference semantics models keyed sorting by the trusted sortKeyVS
  // primitive, and ordinary integer sorting by sortVS.
  syntax Val ::= "popcountKeyClosure" [function, total]
  rule popcountKeyClosure
    => closureValC(
         "value",
         .ParamNames,
         Return(
           IfExp(
             Compare(Name("value"), CmpOp("<", Int(0))),
             Int(0),
             Call(
               Attribute(Call(Name("bin"), Name("value")), "count"),
               Str("1")))),
         .Map)

  syntax ValSeq ::= sortArraySpec(ValSeq) [function, total]
  rule sortArraySpec(VS:ValSeq)
    => sortKeyVS(sortVS(VS), popcountKeyClosure)

  syntax Bool ::= allNonNegativeInts(ValSeq) [function, total]
  rule allNonNegativeInts(.ValSeq) => true
  rule allNonNegativeInts(vCons(I:Int, REST:ValSeq))
    => I >=Int 0 andBool allNonNegativeInts(REST)
  rule allNonNegativeInts(vCons(_:Val, _:ValSeq)) => false [owise]
endmodule
requires "verification.k"

module SORT-ARRAY-SPEC
  imports SORT-ARRAY-VERIFICATION

  // Loading the exact translated module installs the closure used below.
  claim
    <k> #loadAll(sortArrayModule) => .K </k>
    <env> 0 </env>
    <scopes>
      0  |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
      =>
      0  |-> scope("sort_array" |-> sortArrayClosure, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>

  // For every list in the task's stated domain, execution returns exactly the
  // reference semantics' stable sort by popcount and then decimal value.
  claim
    <k>
      Call(sortArrayClosure, list(VS))
      =>
      ref(1)
    </k>
    <env> 0 </env>
    <scopes>
      0  |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap>
      .Map
      =>
      0 |-> list(sortVS(VS))
      1 |-> list(sortArraySpec(VS))
    </heap>
    <heapLoc> 0 => 2 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires allNonNegativeInts(VS)

  // The key closure computes the number of "1" digits in bin(N).  The leading
  // "0b" contributes no matches, so this is the supplied semantics' popcount.
  claim
    <k>
      Call(popcountKeyClosure, Int(N))
      =>
      cntSub(
        iCons(48, iCons(98, binCodes(N))),
        iCons(49, .IntSeq))
    </k>
    <env> 0 </env>
    <scopes>
      0  |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N >=Int 0

  // Outside the promised domain, the extension assigns every negative the
  // same key.  The stable decimal pre-sort therefore matches the prompt's
