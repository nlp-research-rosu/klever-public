diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..99b23380f1f6487add7029142d054fd24eb86b8f
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,30 @@
+from typing import List
+
+
+def parse_nested_parens(paren_string: str) -> List[int]:
+    result = []
+    depth = 0
+    maximum = 0
+    char = ''
+
+    for char in paren_string:
+        if char == '(':
+            depth += 1
+            if depth > maximum:
+                maximum = depth
+        elif char == ')':
+            depth -= 1
+        elif char == ' ':
+            result.append(maximum)
+            depth = 0
+            maximum = 0
+
+    result.append(maximum)
+    return result
+
+
+assert parse_nested_parens('(()()) ((())) () ((())()())') == [2, 3, 1, 3]
+assert parse_nested_parens('()') == [1]
+assert parse_nested_parens('((()))') == [3]
+assert parse_nested_parens('() ()') == [1, 1]
+assert parse_nested_parens('') == [0]
