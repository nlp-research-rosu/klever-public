Module(
  ImportFrom("typing", "List")
  FuncDef("parse_nested_parens", Params("paren_string"),
    Assign(Name("result"), ListExpr())
    Assign(Name("depth"), Int(0))
    Assign(Name("maximum"), Int(0))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("paren_string"),
      If(Compare(Name("char"), CmpOp("==", Str("("))),
        AugAssign(Name("depth"), "+", Int(1))
        If(Compare(Name("depth"), CmpOp(">", Name("maximum"))),
          Assign(Name("maximum"), Name("depth")),
          ),
        If(Compare(Name("char"), CmpOp("==", Str(")"))),
          AugAssign(Name("depth"), "-", Int(1)),
          If(Compare(Name("char"), CmpOp("==", Str(" "))),
            Expr(
              Call(Attribute(Name("result"), "append"), Name("maximum")))
            Assign(Name("depth"), Int(0))
            Assign(Name("maximum"), Int(0)),
            ))))
    Expr(Call(Attribute(Name("result"), "append"), Name("maximum")))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("parse_nested_parens"),
        Str("(()()) ((())) () ((())()())")),
      CmpOp("==", ListExpr(Int(2), Int(3), Int(1), Int(3)))))
  Assert(
    Compare(
      Call(Name("parse_nested_parens"), Str("")),
      CmpOp("==", ListExpr(Int(0)))))
  Assert(
    Compare(
      Call(Name("parse_nested_parens"), Str(" ()")),
      CmpOp("==", ListExpr(Int(0), Int(1)))))
  Assert(
    Compare(
      Call(Name("parse_nested_parens"), Str("() ")),
      CmpOp("==", ListExpr(Int(1), Int(0)))))
  Assert(
    Compare(
      Call(Name("parse_nested_parens"), Str("()  ()")),
      CmpOp("==", ListExpr(Int(1), Int(0), Int(1)))))
  Assert(
    Compare(
      Call(Name("parse_nested_parens"), Str("(())()")),
      CmpOp("==", ListExpr(Int(2))))))
