+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import re
+from collections import Counter
+from pathlib import Path
+
+
+START = re.compile(
+    r"^(?:"
+    r"(?P<header_kind>module|endmodule|requires)\b"
+    r"|[ \t]+(?P<body_kind>syntax|rule|claim|configuration|context|imports)\b"
+    r")"
+)
