+print(f"generated_python_result={generated(witness)}")
+assert canonical(witness) == expected
+assert generated(witness) == expected
+print("GROUND_THREE_WAY_COMPARISON=PASS")
+PY
+status=$?
+echo "EXIT_STATUS: $status"
+exit "$status"
