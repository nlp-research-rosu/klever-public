+    assert actual == expected
+for rel, expected in invocation["outputs"]["evidence"].items():
+    path = Path("/generation-evidence") / rel
+    require_plain_file(path)
+    actual = sha256(path)
+    assert actual == expected, (rel, expected, actual)
