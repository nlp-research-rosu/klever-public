new file mode 100644
index 0000000000000000000000000000000000000000..d1475e908f013967c1eeb4ab0f5c1fb4f6df1723
--- /dev/null
+++ b//tmp/audit-work/reconstruction/spec-ground.k
@@ -0,0 +1,28 @@
+requires "verification.k"
+
+module SPEC-GROUND
+  imports VERIFICATION
+
+  // Satisfying witness: "(()()) ()" consists only of (, ), and space.
+  // The claimed result is fixed explicitly to [2, 1].
+  claim [ground-satisfying-witness]:
+    <k>
+      Call(parseNestedParensClosure, str(strToCodes("(()()) ()")))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(vCons(2, vCons(1, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires parenInput(strToCodes("(()()) ()"))
+endmodule
