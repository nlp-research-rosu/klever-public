diff --git a//tmp/audit-work/reconstruction/audit_concrete.py b//tmp/audit-work/reconstruction/audit_concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..3a892d3309823ddd280a6bf8bf2061d53592d217
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit_concrete.py
@@ -0,0 +1,31 @@
+from typing import List
+
+
+def parse_nested_parens(paren_string: str) -> List[int]:
+    result = []
+    depth = 0
+    maximum = 0
+    char = ''
+
+    for char in paren_string:
+        if char == '(':
+            depth += 1
+            if depth > maximum:
+                maximum = depth
+        elif char == ')':
+            depth -= 1
+        elif char == ' ':
+            result.append(maximum)
+            depth = 0
+            maximum = 0
+
+    result.append(maximum)
+    return result
+
+
+assert parse_nested_parens('(()()) ((())) () ((())()())') == [2, 3, 1, 3]
+assert parse_nested_parens('()') == [1]
+assert parse_nested_parens('()()') == [1]
+assert parse_nested_parens('(()) () (()())') == [2, 1, 2]
+assert parse_nested_parens('') == [0]
+assert parse_nested_parens('()  ()') == [1, 0, 1]
