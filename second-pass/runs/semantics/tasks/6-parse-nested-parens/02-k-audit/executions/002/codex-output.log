+requires "verification.k"
+
+module SPEC-GROUND
+  imports VERIFICATION
+
+  // Satisfying witness: "(()()) ()" consists only of (, ), and space.
+  // The claimed result is fixed explicitly to [2, 1].
+  claim [ground-satisfying-witness]:
+    <k>
+      Call(parseNestedParensClosure, str(strToCodes("(()()) ()")))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(vCons(2, vCons(1, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires parenInput(strToCodes("(()()) ()"))
+endmodule
