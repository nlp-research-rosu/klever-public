diff --git a//tmp/audit-work/reconstruction/audit_concrete.py b//tmp/audit-work/reconstruction/audit_concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..3a892d3309823ddd280a6bf8bf2061d53592d217
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit_concrete.py
@@ -0,0 +1,31 @@
+from typing import List
+
+
+def parse_nested_parens(paren_string: str) -> List[int]:
+    result = []
+    depth = 0
+    maximum = 0
+    char = ''
+
+    for char in paren_string:
+        if char == '(':
+            depth += 1
+            if depth > maximum:
+                maximum = depth
+        elif char == ')':
+            depth -= 1
+        elif char == ' ':
+            result.append(maximum)
+            depth = 0
+            maximum = 0
+
+    result.append(maximum)
+    return result
+
+
+assert parse_nested_parens('(()()) ((())) () ((())()())') == [2, 3, 1, 3]
+assert parse_nested_parens('()') == [1]
+assert parse_nested_parens('()()') == [1]
+assert parse_nested_parens('(()) () (()())') == [2, 1, 2]
+assert parse_nested_parens('') == [0]
+assert parse_nested_parens('()  ()') == [1, 0, 1]
diff --git a//tmp/audit-work/reconstruction/spec-ground.k b//tmp/audit-work/reconstruction/spec-ground.k
new file mode 100644
index 0000000000000000000000000000000000000000..d1475e908f013967c1eeb4ab0f5c1fb4f6df1723
--- /dev/null
+++ b//tmp/audit-work/reconstruction/spec-ground.k
@@ -0,0 +1,28 @@
+requires "verification.k"
+
+module SPEC-GROUND
+  imports VERIFICATION
+
+  // Satisfying witness: "(()()) ()" consists only of (, ), and space.
+  // The claimed result is fixed explicitly to [2, 1].
+  claim [ground-satisfying-witness]:
+    <k>
+      Call(parseNestedParensClosure, str(strToCodes("(()()) ()")))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map => 0 |-> list(vCons(2, vCons(1, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires parenInput(strToCodes("(()()) ()"))
+endmodule
