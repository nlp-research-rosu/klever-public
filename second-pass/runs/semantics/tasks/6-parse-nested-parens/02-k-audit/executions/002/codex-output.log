+  cd "$work" || exit 1
+  python3 py2mpy.py solution.py > solution.regenerated.mpy
+)
+status=$?
+echo "EXIT_STATUS: $status"
+if [ "$status" -ne 0 ]; then
+  exit "$status"
+fi
+
