+    requires parenInput(strToCodes("(()()) ()"))
+endmodule
diff --git a/evidence/01_provenance.py b/evidence/01_provenance.py
new file mode 100644
index 0000000000000000000000000000000000000000..44a0a1b655bee27f5243833f23d5debca9dc98f9
--- /dev/null
+++ b/evidence/01_provenance.py
@@ -0,0 +1,120 @@
+#!/usr/bin/env python3
+"""Independent provenance and mount-integrity checks for this audit."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+
+
+AUDIT_INPUT = Path("/audit-input.json")
+LOCK = Path("/audit-campaign-lock.json")
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        while chunk := stream.read(1024 * 1024):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def require_plain_file(path: Path) -> None:
+    assert path.exists(), f"missing required record: {path}"
+    assert path.is_file(), f"not a regular file: {path}"
+    assert not path.is_symlink(), f"symlinked required record: {path}"
+    with path.open("rb") as stream:
+        stream.read(1)
+
+
