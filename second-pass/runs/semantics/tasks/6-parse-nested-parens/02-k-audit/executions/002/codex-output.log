+  python3 py2mpy.py solution.py > solution.regenerated.mpy
+)
+status=$?
+echo "EXIT_STATUS: $status"
+if [ "$status" -ne 0 ]; then
+  exit "$status"
+fi
+
+echo 'COMMAND: cmp -s solution.regenerated.mpy solution.mpy'
+cmp -s "$work/solution.regenerated.mpy" "$work/solution.mpy"
