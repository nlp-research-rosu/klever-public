+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // Deliberately false: the real function returns parsedParens(S), not that
+  // list with an additional trailing zero. S = "()" is a satisfying witness:
+  // actual [1], mutated obligation [1, 0].
+  claim [false-extra-result]:
+    <k> Call(parseNestedParensClosure, str(S:IntSeq)) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+           valSeqConcat(parsedParens(S), vCons(0, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires parenInput(S)
+endmodule
