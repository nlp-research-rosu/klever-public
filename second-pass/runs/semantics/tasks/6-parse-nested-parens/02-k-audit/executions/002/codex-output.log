+assert Path("/reference/reference-semantics").is_dir()
+assert Path("/candidate/reference-semantics").is_dir()
+print("required_supplied_semantics_mounts_present=true")
+
+for root in [
+    Path("/candidate"),
+    Path("/reference/reference-semantics"),
