import json
from pathlib import Path
inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert list(out) == ['schema_version', 'inventory_sha256', 'rules'], list(out)
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inventory['inventory_sha256']
expected_ids = [r['source_rule_id'] for r in inventory['rules']]
actual_ids = [r['source_rule_id'] for r in out['rules']]
assert actual_ids == expected_ids
assert len(actual_ids) == len(set(actual_ids)) == len(expected_ids)
for i, rule in enumerate(out['rules']):
    assert list(rule) == ['source_rule_id', 'classification', 'rationale'], (i, list(rule))
    assert rule['classification'] in allowed
    assert isinstance(rule['rationale'], str) and rule['rationale'].strip()
counts = {name: sum(r['classification'] == name for r in out['rules']) for name in sorted(allowed)}
print('validated rules:', len(actual_ids))
print('inventory_sha256:', out['inventory_sha256'])
print('classification counts:', counts)
