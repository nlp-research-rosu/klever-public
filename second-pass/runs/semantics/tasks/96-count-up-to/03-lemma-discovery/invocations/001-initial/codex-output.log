+      "classification": "DEFINITION",
+      "rationale": "This is the terminating equation for noDivisor: an empty divisor interval evaluates to true."
+    },
+    {
+      "source_rule_id": "rule-2ddb2c047b23e8c62bd5f396488db85f22bdeb90e9cd3f012b55c4a8afdf044f",
+      "classification": "DEFINITION",
+      "rationale": "This equation defines noDivisor to be false when the current divisor lies in the interval and divides the candidate."
+    },
+    {
+      "source_rule_id": "rule-a5dd03d74f2397ad15d952b0f1061edc2250d99cff9166dce37b08b892342316",
+      "classification": "DEFINITION",
+      "rationale": "This is the recursive noDivisor equation that advances past a current non-divisor."
+    },
+    {
+      "source_rule_id": "rule-21d36a84375658a572f41d1591520a1c2d9b6006b7b384021af3b07d880e290c",
+      "classification": "DEFINITION",
+      "rationale": "This equation defines the false branch of appendIfPrime by leaving the accumulated sequence unchanged."
+    },
+    {
+      "source_rule_id": "rule-165d98d2cdf2e1e8fc6bb2cb8c7a4690fdf535c966e889a7fd578bb38293f334",
+      "classification": "DEFINITION",
+      "rationale": "This equation defines the true branch of appendIfPrime by appending the candidate to the accumulated sequence."
+    },
+    {
+      "source_rule_id": "rule-e3f610fa6210b74d8634f7c0ea1fba43078d455966137ef34884cac9b79169a2",
+      "classification": "DEFINITION",
+      "rationale": "This is the terminating equation for primesAcc when the candidate index has reached or passed the upper bound."
+    },
+    {
+      "source_rule_id": "rule-c693e9dfdde9b8d6790e2a6e90151e9c3705ea0219e6f32fa07265391856459b",
+      "classification": "DEFINITION",
+      "rationale": "This recurrence defines primesAcc by conditionally appending the current candidate and advancing the index."
+    },
+    {
+      "source_rule_id": "rule-3e4c9acccabad57e7ba8e25c78b46534c3490b6a4643e19530860adcfcd9f03e",
+      "classification": "DOMAIN_LEMMA",
+      "rationale": "This whole-divisor-loop summary is an additional correctness fact. Stage 1 proves a related claim before adding the rule, but that claim fixes builtinsScope and several configuration cells whereas this rule admits an arbitrary builtins map and arbitrary preserved omitted cells, so the mounted evidence does not prove this exact reusable statement."
+    },
+    {
+      "source_rule_id": "rule-61fd7317a61776818f367054e0c73dd9601ffc1ed75d9f4c6442d0f67fa51cb5",
+      "classification": "DOMAIN_LEMMA",
+      "rationale": "This whole-candidate-loop summary is an additional correctness fact used by the entry proofs. Its staged Stage 1 claim fixes builtinsScope and several configuration cells, while the reusable rule generalizes those contexts, so the exact inventoried rule was not established by the mounted proof command."
+    }
+  ]
+}

