     1	def count_up_to(n):
     2	    result = []
     3	    candidate = 2
     4	    is_prime = True
     5	    divisor = 2
     6	    while candidate < n:
     7	        while divisor < candidate:
     8	            if candidate % divisor == 0:
     9	                is_prime = False
    10	            divisor += 1
    11	        if is_prime:
    12	            result.append(candidate)
    13	        candidate += 1
    14	        is_prime = True
    15	        divisor = 2
    16	    return result
