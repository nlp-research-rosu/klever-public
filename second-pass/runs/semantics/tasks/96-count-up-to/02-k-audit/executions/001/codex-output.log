diff --git a//tmp/audit-work/96-count-up-to/concrete_tests.py b//tmp/audit-work/96-count-up-to/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..7ae41e7357b1a7908b5720a87ecf22986998a0f3
--- /dev/null
+++ b//tmp/audit-work/96-count-up-to/concrete_tests.py
@@ -0,0 +1,28 @@
+def count_up_to(n):
+    result = []
+    candidate = 2
+    is_prime = True
+    divisor = 2
+    while candidate < n:
+        while divisor < candidate:
+            if candidate % divisor == 0:
+                is_prime = False
+            divisor += 1
+        if is_prime:
+            result.append(candidate)
+        candidate += 1
+        is_prime = True
+        divisor = 2
+    return result
+
+
+# Satisfying witnesses for both entry-claim domains, plus loop/branch edges.
+assert count_up_to(0) == []
+assert count_up_to(1) == []
+assert count_up_to(2) == []
+assert count_up_to(3) == [2]
+assert count_up_to(4) == [2, 3]
+assert count_up_to(5) == [2, 3]
+assert count_up_to(6) == [2, 3, 5]
+assert count_up_to(11) == [2, 3, 5, 7]
+assert count_up_to(20) == [2, 3, 5, 7, 11, 13, 17, 19]
diff --git a//tmp/audit-work/96-count-up-to/spec-vacuity.k b//tmp/audit-work/96-count-up-to/spec-vacuity.k
