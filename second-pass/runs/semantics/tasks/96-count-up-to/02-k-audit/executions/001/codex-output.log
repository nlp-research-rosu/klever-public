+         ("candidate" |-> 4
+          "divisor" |-> (2 => 4)
+          "is_prime" |-> (true => false)
+          "n" |-> (5 => 99)
+          "result" |-> ref(0)),
+         parent(0)))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
+
+module AUDIT-INNER-CONTEXT-EXTENDED-SPEC
+  imports COUNT-UP-TO-WITH-INNER
+
+  claim
+    <k>
+      (#while(
+        Compare(Name("divisor"), CmpOp("<", Name("candidate"))),
