+      ~> Assign(Name("n"), Int(99)))
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope(
+         ("n" |-> (5 => 99)
+          "candidate" |-> (2 => 5)
+          "is_prime" |-> true
+          "divisor" |-> 2
+          "result" |-> ref(0)),
+         parent(0)))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      0 |-> (list(.ValSeq)
+        => list(vCons(2, vCons(3, .ValSeq))))
+    </heap>
+    <heapLoc> 1 </heapLoc>
