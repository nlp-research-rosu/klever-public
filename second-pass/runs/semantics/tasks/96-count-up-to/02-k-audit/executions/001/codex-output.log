diff --git a//tmp/audit-work/96-count-up-to/concrete_tests.py b//tmp/audit-work/96-count-up-to/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..7ae41e7357b1a7908b5720a87ecf22986998a0f3
--- /dev/null
+++ b//tmp/audit-work/96-count-up-to/concrete_tests.py
@@ -0,0 +1,28 @@
+def count_up_to(n):
+    result = []
+    candidate = 2
+    is_prime = True
+    divisor = 2
+    while candidate < n:
+        while divisor < candidate:
+            if candidate % divisor == 0:
+                is_prime = False
+            divisor += 1
+        if is_prime:
+            result.append(candidate)
+        candidate += 1
+        is_prime = True
+        divisor = 2
+    return result
+
+
+# Satisfying witnesses for both entry-claim domains, plus loop/branch edges.
+assert count_up_to(0) == []
+assert count_up_to(1) == []
+assert count_up_to(2) == []
+assert count_up_to(3) == [2]
+assert count_up_to(4) == [2, 3]
+assert count_up_to(5) == [2, 3]
+assert count_up_to(6) == [2, 3, 5]
+assert count_up_to(11) == [2, 3, 5, 7]
+assert count_up_to(20) == [2, 3, 5, 7, 11, 13, 17, 19]
diff --git a//tmp/audit-work/96-count-up-to/spec-vacuity.k b//tmp/audit-work/96-count-up-to/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..5eb4ab5bb827afee7b5489ebe5fe1c750554e185
--- /dev/null
+++ b//tmp/audit-work/96-count-up-to/spec-vacuity.k
@@ -0,0 +1,55 @@
+requires "source/verification.k"
+
+// Fresh false result mutation. The genuine postcondition begins at candidate
+// 2. Starting the summary at 3 wrongly drops prime 2; N=3 is a satisfying
+// counterexample because the real result is [2], not [].
+module SPEC-VACUITY
+  imports COUNT-UP-TO-WITH-OUTER
+
+  claim
+    <k>
+      Assign(Name("result"), ListExpr(.Exprs))
+      Assign(Name("candidate"), Int(2))
+      Assign(Name("is_prime"), Bool(true))
+      Assign(Name("divisor"), Int(2))
+      While(
+        Compare(Name("candidate"), CmpOp("<", Name("n"))),
+        While(
+          Compare(Name("divisor"), CmpOp("<", Name("candidate"))),
+          If(
+            Compare(
+              BinOp("%", Name("candidate"), Name("divisor")),
+              CmpOp("==", Int(0))),
+            Assign(Name("is_prime"), Bool(false)),
+            .Stmts)
+          AugAssign(Name("divisor"), "+", Int(1)))
+        If(
+          Name("is_prime"),
+          Expr(Call(
+            Attribute(Name("result"), "append"),
+            Name("candidate"))),
+          .Stmts)
+        AugAssign(Name("candidate"), "+", Int(1))
+        Assign(Name("is_prime"), Bool(true))
+        Assign(Name("divisor"), Int(2)))
+      Return(Name("result"))
+      ~> #endcall
+    => ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope("n" |-> N:Int, parent(0)))
+    =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(primesAcc(.ValSeq, 3, N)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires N >=Int 2
+endmodule
