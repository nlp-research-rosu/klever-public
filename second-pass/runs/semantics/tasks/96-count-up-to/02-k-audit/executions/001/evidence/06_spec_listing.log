    43	// Lemma 2: starting with a prefix VS at candidate I, the outer loop appends
    44	// exactly the increasing prime sequence in [I, N).
    45	module COUNT-UP-TO-OUTER-LOOP-SPEC
    46	  imports COUNT-UP-TO-WITH-INNER
    47	
    48	  claim
    49	    <k>
    50	      #while(
    51	        Compare(Name("candidate"), CmpOp("<", Name("n"))),
    52	        While(
    53	          Compare(Name("divisor"), CmpOp("<", Name("candidate"))),
    54	          If(
    55	            Compare(
    56	              BinOp("%", Name("candidate"), Name("divisor")),
    57	              CmpOp("==", Int(0))),
    58	            Assign(Name("is_prime"), Bool(false)),
    59	            .Stmts)
    60	          AugAssign(Name("divisor"), "+", Int(1)))
    61	        If(
    62	          Name("is_prime"),
    63	          Expr(Call(
    64	            Attribute(Name("result"), "append"),
    65	            Name("candidate"))),
    66	          .Stmts)
    67	        AugAssign(Name("candidate"), "+", Int(1))
    68	        Assign(Name("is_prime"), Bool(true))
    69	        Assign(Name("divisor"), Int(2)))
    70	    => .K
    71	      ...
    72	    </k>
    73	    <env> 1 </env>
    74	    <scopes>
    75	      0 |-> scope(MOD:Map, parent(-1))
    76	      -1 |-> builtinsScope
    77	      1 |-> scope(
    78	        ("n" |-> N:Int
    79	         "candidate" |-> (I:Int => N)
    80	         "is_prime" |-> true
    81	         "divisor" |-> 2
    82	         "result" |-> ref(0)),
    83	        parent(0))
    84	    </scopes>
    85	    <heap>
    86	      0 |-> (list(VS:ValSeq) => list(primesAcc(VS, I, N)))
    87	    </heap>
    88	    <scopeLoc> 2 </scopeLoc>
    89	    <heapLoc> 1 </heapLoc>
    90	    <stack> ST:List </stack>
    91	    <ret> noRet </ret>
    92	    <exc> NoExc </exc>
    93	    requires 2 <=Int I andBool I <=Int N
    94	endmodule
