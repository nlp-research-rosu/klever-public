    96	// The entry-body theorem uses only the two preceding, independently proved
    97	// loop lemmas.  primesAcc(.ValSeq, 2, N) is the formal contract result.
    98	module COUNT-UP-TO-ENTRY-SPEC
    99	  imports COUNT-UP-TO-WITH-OUTER
   100	
   101	  claim
   102	    <k>
   103	      Assign(Name("result"), ListExpr(.Exprs))
   104	      Assign(Name("candidate"), Int(2))
   105	      Assign(Name("is_prime"), Bool(true))
   106	      Assign(Name("divisor"), Int(2))
   107	      While(
   108	        Compare(Name("candidate"), CmpOp("<", Name("n"))),
   109	        While(
   110	          Compare(Name("divisor"), CmpOp("<", Name("candidate"))),
   111	          If(
   112	            Compare(
   113	              BinOp("%", Name("candidate"), Name("divisor")),
   114	              CmpOp("==", Int(0))),
   115	            Assign(Name("is_prime"), Bool(false)),
   116	            .Stmts)
   117	          AugAssign(Name("divisor"), "+", Int(1)))
   118	        If(
   119	          Name("is_prime"),
   120	          Expr(Call(
   121	            Attribute(Name("result"), "append"),
   122	            Name("candidate"))),
   123	          .Stmts)
   124	        AugAssign(Name("candidate"), "+", Int(1))
   125	        Assign(Name("is_prime"), Bool(true))
   126	        Assign(Name("divisor"), Int(2)))
   127	      Return(Name("result"))
   128	      ~> #endcall
   129	    => ref(0)
   130	    </k>
   131	    <env> 1 => 0 </env>
   132	    <scopes>
   133	      (0 |-> scope(.Map, parent(-1))
   134	       -1 |-> builtinsScope
   135	       1 |-> scope("n" |-> N:Int, parent(0)))
   136	    =>
   137	      (0 |-> scope(.Map, parent(-1))
   138	       -1 |-> builtinsScope)
   139	    </scopes>
   140	    <scopeLoc> 2 => 1 </scopeLoc>
   141	    <heap> .Map => 0 |-> list(primesAcc(.ValSeq, 2, N)) </heap>
   142	    <heapLoc> 0 => 1 </heapLoc>
   143	    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
   144	    <ret> noRet </ret>
   145	    <exc> NoExc </exc>
   146	    requires N >=Int 2
   147	endmodule
