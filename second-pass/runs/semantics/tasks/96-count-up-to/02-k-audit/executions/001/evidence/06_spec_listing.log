     3	// Lemma 1: scanning the possible divisors updates is_prime to the conjunction
     4	// of its incoming value and the mathematical no-divisor predicate.
     5	module COUNT-UP-TO-INNER-LOOP-SPEC
     6	  imports COUNT-UP-TO-BASE
     7	
     8	  claim
     9	    <k>
    10	      #while(
    11	        Compare(Name("divisor"), CmpOp("<", Name("candidate"))),
    12	        If(
    13	          Compare(
    14	            BinOp("%", Name("candidate"), Name("divisor")),
    15	            CmpOp("==", Int(0))),
    16	          Assign(Name("is_prime"), Bool(false)),
    17	          .Stmts)
    18	        AugAssign(Name("divisor"), "+", Int(1)))
    19	    => .K
    20	      ...
    21	    </k>
    22	    <env> 1 </env>
    23	    <scopes>
    24	      0 |-> scope(MOD:Map, parent(-1))
    25	      -1 |-> builtinsScope
    26	      1 |-> scope(
    27	        ("candidate" |-> C:Int
    28	         "divisor" |-> (D:Int => C)
    29	         "is_prime" |-> (B:Bool => B andBool noDivisor(C, D, C))
    30	         "n" |-> N:Int
    31	         "result" |-> ref(0)),
    32	        parent(0))
    33	    </scopes>
    34	    <scopeLoc> 2 </scopeLoc>
    35	    <heap> 0 |-> list(VS:ValSeq) </heap>
    36	    <heapLoc> 1 </heapLoc>
    37	    <stack> ST:List </stack>
    38	    <ret> noRet </ret>
    39	    <exc> NoExc </exc>
    40	    requires 2 <=Int D andBool D <=Int C
    41	endmodule
