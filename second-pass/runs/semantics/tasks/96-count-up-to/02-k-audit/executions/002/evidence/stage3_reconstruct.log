COMMAND[stage3_translate_concrete]: python3 /tmp/audit-work/audit96/py2mpy.py /tmp/audit-work/audit96/build/concrete_tests.py 
Module(
  FuncDef("count_up_to", Params("n"),
    Assign(Name("result"), ListExpr())
    Assign(Name("candidate"), Int(2))
    Assign(Name("is_prime"), Bool(true))
    Assign(Name("divisor"), Int(2))
    While(Compare(Name("candidate"), CmpOp("<", Name("n"))),
      While(Compare(Name("divisor"), CmpOp("<", Name("candidate"))),
        If(Compare(
          BinOp("%", Name("candidate"), Name("divisor")),
          CmpOp("==", Int(0))),
          Assign(Name("is_prime"), Bool(false)),
          )
        AugAssign(Name("divisor"), "+", Int(1)))
      If(Name("is_prime"),
        Expr(
          Call(Attribute(Name("result"), "append"), Name("candidate"))),
        )
      AugAssign(Name("candidate"), "+", Int(1))
      Assign(Name("is_prime"), Bool(true))
      Assign(Name("divisor"), Int(2)))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("count_up_to"), Int(5)),
      CmpOp("==", ListExpr(Int(2), Int(3)))))
  Assert(
    Compare(
      Call(Name("count_up_to"), Int(11)),
      CmpOp("==", ListExpr(Int(2), Int(3), Int(5), Int(7)))))
  Assert(
    Compare(Call(Name("count_up_to"), Int(0)), CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("count_up_to"), Int(20)),
      CmpOp(
        "==",
        ListExpr(
          Int(2),
          Int(3),
          Int(5),
          Int(7),
          Int(11),
          Int(13),
          Int(17),
          Int(19)))))
  Assert(
    Compare(Call(Name("count_up_to"), Int(1)), CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("count_up_to"), Int(18)),
      CmpOp(
        "==",
        ListExpr(
          Int(2),
          Int(3),
          Int(5),
          Int(7),
          Int(11),
          Int(13),
          Int(17))))))
