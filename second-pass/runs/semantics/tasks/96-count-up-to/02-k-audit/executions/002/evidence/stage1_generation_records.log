TOOL_CALL {"arguments": "*** Begin Patch\n*** Delete File: /work/verification.k\n*** Add File: /work/verification.k\n+requires \"reference-semantics/semantics.k\"\n+\n+// Mathematical definitions and the unmodified Python semantics.\n+module COUNT-UP-TO-BASE\n+  imports MPY\n+\n+  // noDivisor(C, D, HI) says that none of D, D+1, ..., HI-1\n+  // divides C.  All calls made by the program satisfy 2 <= D <= HI.\n+  syntax Bool ::= noDivisor(Int, Int, Int) [function, total]\n+  rule noDivisor(_:Int, D:Int, HI:Int) => true\n+    requires D >=Int HI\n+  rule noDivisor(C:Int, D:Int, HI:Int) => false\n+    requires D <Int HI andBool pyMod(C, D) ==Int 0\n+  rule noDivisor(C:Int, D:Int, HI:Int)\n+    => noDivisor(C, D +Int 1, HI)\n+    requires D <Int HI andBool pyMod(C, D) =/=Int 0\n+\n+  // Append I exactly when the divisor scan establishes that I is prime.\n+  syntax ValSeq ::= appendIfPrime(ValSeq, Int, Bool) [function, total]\n+  rule appendIfPrime(VS:ValSeq, _:Int, false) => VS\n+  rule appendIfPrime(VS:ValSeq, I:Int, true)\n+    => valSeqConcat(VS, vCons(I, .ValSeq))\n+\n+  // primesAcc(VS, I, N) is VS followed by every prime in [I, N), in\n+  // increasing order.  Since all reachable I are at least 2, primality is\n+  // exactly noDivisor(I, 2, I).\n+  syntax ValSeq ::= primesAcc(ValSeq, Int, Int) [function, total]\n+  rule primesAcc(VS:ValSeq, I:Int, N:Int) => VS\n+    requires I >=Int N\n+  rule primesAcc(VS:ValSeq, I:Int, N:Int)\n+    => primesAcc(\n+         appendIfPrime(VS, I, noDivisor(I, 2, I)),\n+         I +Int 1,\n+         N)\n+    requires I <Int N\n+endmodule\n+\n+// This module adds the inner-loop theorem as a reusable semantic rule.  The\n+// corresponding claim is proved against COUNT-UP-TO-BASE alone in spec.k.\n+module COUNT-UP-TO-WITH-INNER\n+  imports COUNT-UP-TO-BASE\n+\n+  rule <k>\n+         #while(\n+           Compare(Name(\"divisor\"), CmpOp(\"<\", Name(\"candidate\"))),\n+           If(\n+             Compare(\n+               BinOp(\"%\", Name(\"candidate\"), Name(\"divisor\")),\n+               CmpOp(\"==\", Int(0))),\n+             Assign(Name(\"is_prime\"), Bool(false)),\n+             .Stmts)\n+           AugAssign(Name(\"divisor\"), \"+\", Int(1)))\n+         => .K\n+         ...\n+       </k>\n+       <env> L:Int </env>\n+       <scopes>\n+         ... L |-> scope(\n+           (\"candidate\" |-> C:Int\n+            \"divisor\" |-> (D:Int => C)\n+            \"is_prime\" |-> (B:Bool => B andBool noDivisor(C, D, C))\n+            REST:Map),\n+           P:Parent)\n+         ...\n+       </scopes>\n+       requires 2 <=Int D andBool D <=Int C\n+       [priority(40)]\n+endmodule\n+\n+// This module adds the outer-loop theorem as a reusable semantic rule.  Its\n+// claim is proved against COUNT-UP-TO-WITH-INNER, so the only trusted layer at\n+// that stage is the already-proved inner-loop theorem.\n+module COUNT-UP-TO-WITH-OUTER\n+  imports COUNT-UP-TO-WITH-INNER\n+\n+  rule <k>\n+         #while(\n+           Compare(Name(\"candidate\"), CmpOp(\"<\", Name(\"n\"))),\n+           Assign(Name(\"is_prime\"), Bool(true))\n+           Assign(Name(\"divisor\"), Int(2))\n+           While(\n+             Compare(Name(\"divisor\"), CmpOp(\"<\", Name(\"candidate\"))),\n+             If(\n+               Compare(\n+                 BinOp(\"%\", Name(\"candidate\"), Name(\"divisor\")),\n+                 CmpOp(\"==\", Int(0))),\n+               Assign(Name(\"is_prime\"), Bool(false)),\n+               .Stmts)\n+             AugAssign(Name(\"divisor\"), \"+\", Int(1)))\n+           If(\n+             Name(\"is_prime\"),\n+             Expr(Call(\n+               Attribute(Name(\"result\"), \"append\"),\n+               Name(\"candidate\"))),\n+             .Stmts)\n+           AugAssign(Name(\"candidate\"), \"+\", Int(1)))\n+         => .K\n+         ...\n+       </k>\n+       <env> L:Int </env>\n+       <scopes>\n+         ... L |-> scope(\n+           (\"n\" |-> N:Int\n+            \"candidate\" |-> (I:Int => N)\n+            \"is_prime\" |-> _:Bool\n+            \"divisor\" |-> _:Int\n+            \"result\" |-> ref(H:Int)\n+            REST:Map),\n+           P:Parent)\n+         ...\n+       </scopes>\n+       <heap>\n+         ... H |-> (list(VS:ValSeq) => list(primesAcc(VS, I, N))) ...\n+       </heap>\n+       requires 2 <=Int I andBool I <=Int N\n+       [priority(40)]\n+endmodule\n*** Delete File: /work/spec.k\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+// Lemma 1: scanning the possible divisors updates is_prime to the conjunction\n+// of its incoming value and the mathematical no-divisor predicate.\n+module COUNT-UP-TO-INNER-LOOP-SPEC\n+  imports COUNT-UP-TO-BASE\n+\n+  claim\n+    <k>\n+      #while(\n+        Compare(Name(\"divisor\"), CmpOp(\"<\", Name(\"candidate\"))),\n+        If(\n+          Compare(\n+            BinOp(\"%\", Name(\"candidate\"), Name(\"divisor\")),\n+            CmpOp(\"==\", Int(0))),\n+          Assign(Name(\"is_prime\"), Bool(false)),\n+          .Stmts)\n+        AugAssign(Name(\"divisor\"), \"+\", Int(1)))\n+    => .K\n+      ...\n+    </k>\n+    <env> L:Int </env>\n+    <scopes>\n+      ... L |-> scope(\n+        (\"candidate\" |-> C:Int\n+         \"divisor\" |-> (D:Int => C)\n+         \"is_prime\" |-> (B:Bool => B andBool noDivisor(C, D, C))\n+         REST:Map),\n+        P:Parent)\n+      ...\n+    </scopes>\n+    requires 2 <=Int D andBool D <=Int C\n+endmodule\n+\n+// Lemma 2: starting with a prefix VS at candidate I, the outer loop appends\n+// exactly the increasing prime sequence in [I, N).\n+module COUNT-UP-TO-OUTER-LOOP-SPEC\n+  imports COUNT-UP-TO-WITH-INNER\n+\n+  claim\n+    <k>\n+      #while(\n+        Compare(Name(\"candidate\"), CmpOp(\"<\", Name(\"n\"))),\n+        Assign(Name(\"is_prime\"), Bool(true))\n+        Assign(Name(\"divisor\"), Int(2))\n+        While(\n+          Compare(Name(\"divisor\"), CmpOp(\"<\", Name(\"candidate\"))),\n+          If(\n+            Compare(\n+              BinOp(\"%\", Name(\"candidate\"), Name(\"divisor\")),\n+              CmpOp(\"==\", Int(0))),\n+            Assign(Name(\"is_prime\"), Bool(false)),\n+            .Stmts)\n+          AugAssign(Name(\"divisor\"), \"+\", Int(1)))\n+        If(\n+          Name(\"is_prime\"),\n+          Expr(Call(\n+            Attribute(Name(\"result\"), \"append\"),\n+            Name(\"candidate\"))),\n+          .Stmts)\n+        AugAssign(Name(\"candidate\"), \"+\", Int(1)))\n+    => .K\n+      ...\n+    </k>\n+    <env> L:Int </env>\n+    <scopes>\n+      ... L |-> scope(\n+        (\"n\" |-> N:Int\n+         \"candidate\" |-> (I:Int => N)\n+         \"is_prime\" |-> _:Bool\n+         \"divisor\" |-> _:Int\n+         \"result\" |-> ref(H:Int)\n+         REST:Map),\n+        P:Parent)\n+      ...\n+    </scopes>\n+    <heap>\n+      ... H |-> (list(VS:ValSeq) => list(primesAcc(VS, I, N))) ...\n+    </heap>\n+    requires 2 <=Int I andBool I <=Int N\n+endmodule\n+\n+// The entry-body theorem uses only the two preceding, independently proved\n+// loop lemmas.  primesAcc(.ValSeq, 2, N) is the formal contract result.\n+module COUNT-UP-TO-ENTRY-SPEC\n+  imports COUNT-UP-TO-WITH-OUTER\n+\n+  claim\n+    <k>\n+      Assign(Name(\"result\"), ListExpr(.Exprs))\n+      Assign(Name(\"candidate\"), Int(2))\n+      Assign(Name(\"is_prime\"), Bool(true))\n+      Assign(Name(\"divisor\"), Int(2))\n+      While(\n+        Compare(Name(\"candidate\"), CmpOp(\"<\", Name(\"n\"))),\n+        Assign(Name(\"is_prime\"), Bool(true))\n+        Assign(Name(\"divisor\"), Int(2))\n+        While(\n+          Compare(Name(\"divisor\"), CmpOp(\"<\", Name(\"candidate\"))),\n+          If(\n+            Compare(\n+              BinOp(\"%\", Name(\"candidate\"), Name(\"divisor\")),\n+              CmpOp(\"==\", Int(0))),\n+            Assign(Name(\"is_prime\"), Bool(false)),\n+            .Stmts)\n+          AugAssign(Name(\"divisor\"), \"+\", Int(1)))\n+        If(\n+          Name(\"is_prime\"),\n+          Expr(Call(\n+            Attribute(Name(\"result\"), \"append\"),\n+            Name(\"candidate\"))),\n+          .Stmts)\n+        AugAssign(Name(\"candidate\"), \"+\", Int(1)))\n+      Return(Name(\"result\"))\n+      ~> #endcall\n+    => ref(0)\n+    </k>\n+    <env> 1 => 0 </env>\n+    <scopes>\n+      (0 |-> scope(.Map, parent(-1))\n+       -1 |-> builtinsScope\n+       1 |-> scope(\"n\" |-> N:Int, parent(0)))\n+    =>\n+      (0 |-> scope(.Map, parent(-1))\n+       -1 |-> builtinsScope)\n+    </scopes>\n+    <scopeLoc> 2 => 1 </scopeLoc>\n+    <heap> .Map => 0 |-> list(primesAcc(.ValSeq, 2, N)) </heap>\n+    <heapLoc> 0 => 1 </heapLoc>\n+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    requires N >=Int 2\n+endmodule\n+\n+// The n < 2 boundary is a separate claim because the outer-loop lemma's\n+// induction domain starts at candidate 2.  The contract result is empty.\n+module COUNT-UP-TO-BOUNDARY-SPEC\n+  imports COUNT-UP-TO-WITH-OUTER\n+\n+  claim\n+    <k>\n+      Assign(Name(\"result\"), ListExpr(.Exprs))\n+      Assign(Name(\"candidate\"), Int(2))\n+      Assign(Name(\"is_prime\"), Bool(true))\n+      Assign(Name(\"divisor\"), Int(2))\n+      While(\n+        Compare(Name(\"candidate\"), CmpOp(\"<\", Name(\"n\"))),\n+        Assign(Name(\"is_prime\"), Bool(true))\n+        Assign(Name(\"divisor\"), Int(2))\n+        While(\n+          Compare(Name(\"divisor\"), CmpOp(\"<\", Name(\"candidate\"))),\n+          If(\n+            Compare(\n+              BinOp(\"%\", Name(\"candidate\"), Name(\"divisor\")),\n+              CmpOp(\"==\", Int(0))),\n+            Assign(Name(\"is_prime\"), Bool(false)),\n+            .Stmts)\n+          AugAssign(Name(\"divisor\"), \"+\", Int(1)))\n+        If(\n+          Name(\"is_prime\"),\n+          Expr(Call(\n+            Attribute(Name(\"result\"), \"append\"),\n+            Name(\"candidate\"))),\n+          .Stmts)\n+        AugAssign(Name(\"candidate\"), \"+\", Int(1)))\n+      Return(Name(\"result\"))\n+      ~> #endcall\n+    => ref(0)\n+    </k>\n+    <env> 1 => 0 </env>\n+    <scopes>\n+      (0 |-> scope(.Map, parent(-1))\n+       -1 |-> builtinsScope\n+       1 |-> scope(\"n\" |-> N:Int, parent(0)))\n+    =>\n+      (0 |-> scope(.Map, parent(-1))\n+       -1 |-> builtinsScope)\n+    </scopes>\n+    <scopeLoc> 2 => 1 </scopeLoc>\n+    <heap> .Map => 0 |-> list(.ValSeq) </heap>\n+    <heapLoc> 0 => 1 </heapLoc>\n+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    requires 0 <=Int N andBool N <Int 2\n+endmodule\n*** End Patch\n", "line": 143, "name": "apply_patch"}
