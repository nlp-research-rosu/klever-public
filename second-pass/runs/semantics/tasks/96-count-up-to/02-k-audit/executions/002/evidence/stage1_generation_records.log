TOOL_CALL {"arguments": "*** Begin Patch\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module COUNT-UP-TO-SPEC\n+  imports COUNT-UP-TO-VERIFICATION\n+\n+  // Universal entry-body theorem.  This begins in a normal function-call\n+  // frame with n bound to an arbitrary non-negative integer and ends with the\n+  // returned heap object containing the canonical sequence primesBelow(N).\n+  claim\n+    <k>\n+      Assign(Name(\"result\"), ListExpr())\n+      For(\n+        Name(\"candidate\"),\n+        Call(Name(\"range\"), Int(2), Name(\"n\")),\n+        Assign(Name(\"is_prime\"), Bool(true))\n+        For(\n+          Name(\"divisor\"),\n+          Call(Name(\"range\"), Int(2), Name(\"candidate\")),\n+          If(\n+            Compare(\n+              BinOp(\"%\", Name(\"candidate\"), Name(\"divisor\")),\n+              CmpOp(\"==\", Int(0))),\n+            Assign(Name(\"is_prime\"), Bool(false)),\n+            .Stmts))\n+        If(\n+          Name(\"is_prime\"),\n+          Expr(Call(\n+            Attribute(Name(\"result\"), \"append\"),\n+            Name(\"candidate\"))),\n+          .Stmts))\n+      Return(Name(\"result\"))\n+      ~> #endcall\n+    => ref(0)\n+    </k>\n+    <env> 1 => 0 </env>\n+    <scopes>\n+      (0 |-> scope(.Map, parent(-1))\n+       -1 |-> builtinsScope\n+       1 |-> scope(\"n\" |-> N:Int, parent(0)))\n+    =>\n+      (0 |-> scope(.Map, parent(-1))\n+       -1 |-> builtinsScope)\n+    </scopes>\n+    <scopeLoc> 2 => 1 </scopeLoc>\n+    <heap> .Map => 0 |-> list(primesBelow(N)) </heap>\n+    <heapLoc> 0 => 1 </heapLoc>\n+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    requires N >=Int 0\n+endmodule\n*** End Patch\n", "line": 73, "name": "apply_patch"}
