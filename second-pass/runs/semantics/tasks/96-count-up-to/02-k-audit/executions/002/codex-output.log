+            Assign(Name("divisor"), Int(2)))
+          => .K
+          ...
+        </k>
+        <env> 1 </env>
+        <scopes>
+          0 |-> scope(MOD:Map, parent(-1))
+          -1 |-> scope(BI:Map, root)
+          1 |-> scope(
+            ("n" |-> N:Int
+             "candidate" |-> (I:Int => N)
+             "is_prime" |-> true
+             "divisor" |-> 2
+             "result" |-> ref(0)),
+            parent(0))
+        </scopes>
+        <heap>
+          0 |-> (list(VS:ValSeq) => list(primesAcc(VS, I, N)))
+        </heap>
+        requires 2 <=Int I andBool I <=Int N
