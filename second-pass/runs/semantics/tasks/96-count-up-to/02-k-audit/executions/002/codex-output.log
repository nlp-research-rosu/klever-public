+       -1 |-> builtinsScope
+       1 |-> scope("n" |-> N:Int, parent(0)))
+    =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(primesAcc(.ValSeq, 2, N)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires N >=Int 2
+endmodule

