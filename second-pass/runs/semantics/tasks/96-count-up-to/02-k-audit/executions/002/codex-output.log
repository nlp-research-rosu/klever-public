+              CmpOp("==", Int(0))),
+            Assign(Name("is_prime"), Bool(false)),
+            .Stmts)
+          AugAssign(Name("divisor"), "+", Int(1)))
+        If(
+          Name("is_prime"),
+          Expr(Call(
+            Attribute(Name("result"), "append"),
+            Name("candidate"))),
+          .Stmts)
+        AugAssign(Name("candidate"), "+", Int(1))
+        Assign(Name("is_prime"), Bool(true))
+        Assign(Name("divisor"), Int(2)))
+      Return(Name("result"))
+      ~> #endcall
+    => ref(1)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope("n" |-> N:Int, parent(0)))
+    =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(primesAcc(.ValSeq, 2, N)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires N >=Int 2
+endmodule

exec
/bin/bash -lc "script -q -e -c 'kprove /audit-output/evidence/stage4_body_sensitivity.k --definition /tmp/audit-work/audit96/build/entry-proof-kompiled --spec-module AUDIT-BODY-SENSITIVITY-SPEC --dry-run --output none' /audit-output/evidence/stage4_body_sensitivity_dry_run.log
body_dry="'$?
printf '"'stage4_body_sensitivity_dry_run_exit=%s\\n' \""'$body_dry"
