    17	    primes = []
    18	    for i in range(2, n):
    19	        is_prime = True
    20	        for j in range(2, i):
    21	            if i % j == 0:
    22	                is_prime = False
    23	                break
    24	        if is_prime:
    25	            primes.append(i)
    26	    return primes
