auditNoDivisorBase (candidate divisor upper : Int) (done : upper ≤ divisor) :
  Proof.noDivisor candidate divisor upper = true
auditNoDivisorFound (candidate divisor upper : Int) (scan : divisor < upper)
  (found : pyModTotal candidate divisor = 0) : Proof.noDivisor candidate divisor upper = false
auditNoDivisorNext (candidate divisor upper : Int) (scan : divisor < upper) (clear : pyModTotal candidate divisor ≠ 0) :
  Proof.noDivisor candidate divisor upper = Proof.noDivisor candidate (divisor + 1) upper
auditPrimesAccBase (values : SortValSeq) (start upper : Int) (done : upper ≤ start) :
  Proof.primesAcc values start upper = values
auditPrimesAccNext (values : SortValSeq) (start upper : Int) (scan : start < upper) :
  Proof.primesAcc values start upper =
    Proof.primesAcc (if Proof.noDivisor start 2 start = true then valSeqAppendInt values start else values) (start + 1)
      upper
Proof.valSeqConcatSingleton (values : SortValSeq) (value : SortInt) :
  «valSeqConcat(_,_)_MPY-LIST_ValSeq_ValSeq_ValSeq» values
      (SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» (SortVal.inj_SortInt value)
        SortValSeq.«.ValSeq_MPY-CORE_ValSeq») =
    some (valSeqAppendInt values value)
