/bin/bash -lc "PYTHONPATH=/reference python - <<'PY' | tee /audit-output/evidence/mounted-hash-reconciliation.txt
import hashlib, json
from pathlib import Path
from tools import pipeline_contract, klean_export
A=json.loads(Path('/audit-input.json').read_text())['resolution']
checks={}
def emit(name, observed, expected):
    ok=observed==expected
    checks[name]=ok
    print(f'{name}: observed={observed} expected={expected} match={ok}')
print('COMMAND: recompute mounted hashes with launcher/generator canonical hash functions')
emit('k_workspace_sha256', pipeline_contract.sha256_tree(Path('/reference/k-proof')), A['hashes']['k_workspace_sha256'])
emit('stage1_export_sha256', klean_export.tree_digest(Path('/reference/k-proof')), A['hashes']['stage1_export_sha256'])
emit('discovery_manifest_sha256', hashlib.sha256(Path('/reference/lemma-discovery.json').read_bytes()).hexdigest(), A['hashes']['discovery_manifest_sha256'])
emit('k_audit_sha256', pipeline_contract.sha256_tree(Path('/reference/k-audit')), A['hashes']['k_audit_sha256'])
emit('klean_generation_sha256', pipeline_contract.sha256_tree(Path('/reference/klean-generation')), A['hashes']['klean_generation_sha256'])
emit('generation_producer_sources_sha256', pipeline_contract.sha256_tree(Path('/reference/generation-tools')), A['hashes']['generation_producer_sources_sha256'])
emit('generated_tree_sha256', klean_export.tree_digest(Path('/reference/klean-generation/generated')), A['hashes']['generated_tree_sha256'])
emit('lean_workspace_sha256', pipeline_contract.sha256_tree(Path('/candidate')), A['hashes']['lean_workspace_sha256'])
print('lean_invocation_sha256: not independently mounted; launcher record=' + str(A['hashes']['lean_invocation_sha256']))
print('stage1 individual source hashes:')
workspace=Path('/reference/k-proof')
source_checks=[]
for rel,expected in sorted(A['stage1_source_hashes'].items()):
    path=workspace/rel
    observed=hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() and not path.is_symlink() else None
    ok=observed==expected
    source_checks.append(ok)
    print(f'  {rel}: observed={observed} expected={expected} match={ok}')
print('all mounted top-level hashes match:', all(checks.values()))
print('all Stage 1 source hashes match:', all(source_checks) and len(source_checks)==len(A['stage1_source_hashes']))
if not all(checks.values()) or not all(source_checks): raise SystemExit(1)
