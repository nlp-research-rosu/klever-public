exec
/bin/bash -lc "python - <<'PY'
import os
p=os.getpid()
print('pid',p)
for x in ['/proc/self/exe',f'/proc/{p}/exe']:
    try: print(x, os.readlink(x))
    except Exception as e: print(x,type(e).__name__,e)
PY
perl -e '"'$p=$$; print "pid $p'"\\n\"; for "'$x ("/proc/self/exe", "/proc/$p/exe") { $v=readlink($x); print "$x ", defined($v)?$v:$!,"'"\\n\"; }'" in /audit-output
 succeeded in 0ms:
pid 3
/proc/self/exe /usr/bin/python3.10
/proc/3/exe FileNotFoundError [Errno 2] No such file or directory: '/proc/3/exe'
pid 2
/proc/self/exe /usr/bin/perl
/proc/2/exe No such file or directory

codex
I found the precise environment defect: Lean 4.22 resolves its executable through `/proc/<getpid()>/exe`, but this managed sandbox gives the process an inner PID while mounting an outer `/proc`; `/proc/self/exe` works and `/proc/<inner-pid>/exe` does not. I’m applying a narrow audit-only preload shim that redirects only that exact executable lookup to `/proc/self/exe`. This does not alter the project, theorem, compiler, or proof kernel; it restores the toolchain’s own path discovery. I’ll preserve the shim source and diagnostics in the evidence.
apply patch
patch: completed
/tmp/audit-work/lean-proc-shim.c
diff --git a//tmp/audit-work/lean-proc-shim.c b//tmp/audit-work/lean-proc-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..afe6d47c0dadbb7fdb7fe72588507e99918a3448
--- /dev/null
+++ b//tmp/audit-work/lean-proc-shim.c
@@ -0,0 +1,43 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+static int is_proc_pid_exe(const char *path) {
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/exe";
+    const char *cursor;
+
+    if (path == NULL || strncmp(path, prefix, sizeof(prefix) - 1) != 0) {
+        return 0;
+    }
+    cursor = path + sizeof(prefix) - 1;
+    if (*cursor < '0' || *cursor > '9') {
+        return 0;
+    }
+    while (*cursor >= '0' && *cursor <= '9') {
+        ++cursor;
+    }
+    return strcmp(cursor, suffix) == 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+        if (real_readlink == NULL) {
+            errno = ENOSYS;
+            return -1;
+        }
+    }
+    if (is_proc_pid_exe(path)) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}

