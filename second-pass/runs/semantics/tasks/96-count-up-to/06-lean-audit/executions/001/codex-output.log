      "inventory_sha256": "248228e8fdfc6e33e8b384cf6ee6d6599339e96ceb0bed8b684817fefeffc574",
      "module": "COUNT-UP-TO-WITH-INNER",
      "normalized_sha256": "3e4c9acccabad57e7ba8e25c78b46534c3490b6a4643e19530860adcfcd9f03e",
      "rationale": "This whole-divisor-loop summary is an additional correctness fact. Stage 1 proves a related claim before adding the rule, but that claim fixes builtinsScope and several configuration cells whereas this rule admits an arbitrary builtins map and arbitrary preserved omitted cells, so the mounted evidence does not prove this exact reusable statement.",
      "source_rule_id": "rule-3e4c9acccabad57e7ba8e25c78b46534c3490b6a4643e19530860adcfcd9f03e",
      "start_line": 46,
      "text": "  rule <k>\n         #while(\n           Compare(Name(\"divisor\"), CmpOp(\"<\", Name(\"candidate\"))),\n           If(\n             Compare(\n               BinOp(\"%\", Name(\"candidate\"), Name(\"divisor\")),\n               CmpOp(\"==\", Int(0))),\n             Assign(Name(\"is_prime\"), Bool(false)),\n             .Stmts)\n           AugAssign(Name(\"divisor\"), \"+\", Int(1)))\n         => .K\n         ...\n       </k>\n       <env> 1 </env>\n       <scopes>\n         0 |-> scope(MOD:Map, parent(-1))\n         -1 |-> scope(BI:Map, root)\n         1 |-> scope(\n           (\"candidate\" |-> C:Int\n            \"divisor\" |-> (D:Int => C)\n            \"is_prime\" |-> (B:Bool => B andBool noDivisor(C, D, C))\n            \"n\" |-> N:Int\n            \"result\" |-> ref(0)),\n           parent(0))\n       </scopes>\n       <heap> 0 |-> list(VS:ValSeq) </heap>\n       requires 2 <=Int D andBool D <=Int C\n       [priority(40)]"
    },
    {
      "attributes": [
        "priority(40)"
      ],
      "classification": "DOMAIN_LEMMA",
      "discovery_manifest_sha256": "dc4482e6beb53430c8640b901dae31bf53af2b2871e2ca964764c613fb6e9a06",
      "end_line": 122,
      "inventory_sha256": "248228e8fdfc6e33e8b384cf6ee6d6599339e96ceb0bed8b684817fefeffc574",
      "module": "COUNT-UP-TO-WITH-OUTER",
      "normalized_sha256": "61fd7317a61776818f367054e0c73dd9601ffc1ed75d9f4c6442d0f67fa51cb5",
      "rationale": "This whole-candidate-loop summary is an additional correctness fact used by the entry proofs. Its staged Stage 1 claim fixes builtinsScope and several configuration cells, while the reusable rule generalizes those contexts, so the exact inventoried rule was not established by the mounted proof command.",
      "source_rule_id": "rule-61fd7317a61776818f367054e0c73dd9601ffc1ed75d9f4c6442d0f67fa51cb5",
      "start_line": 82,
      "text": "  rule <k>\n         #while(\n           Compare(Name(\"candidate\"), CmpOp(\"<\", Name(\"n\"))),\n           While(\n             Compare(Name(\"divisor\"), CmpOp(\"<\", Name(\"candidate\"))),\n             If(\n               Compare(\n                 BinOp(\"%\", Name(\"candidate\"), Name(\"divisor\")),\n                 CmpOp(\"==\", Int(0))),\n               Assign(Name(\"is_prime\"), Bool(false)),\n               .Stmts)\n             AugAssign(Name(\"divisor\"), \"+\", Int(1)))\n           If(\n             Name(\"is_prime\"),\n             Expr(Call(\n               Attribute(Name(\"result\"), \"append\"),\n               Name(\"candidate\"))),\n             .Stmts)\n           AugAssign(Name(\"candidate\"), \"+\", Int(1))\n           Assign(Name(\"is_prime\"), Bool(true))\n           Assign(Name(\"divisor\"), Int(2)))\n         => .K\n         ...\n       </k>\n       <env> 1 </env>\n       <scopes>\n         0 |-> scope(MOD:Map, parent(-1))\n         -1 |-> scope(BI:Map, root)\n         1 |-> scope(\n           (\"n\" |-> N:Int\n            \"candidate\" |-> (I:Int => N)\n            \"is_prime\" |-> true\n            \"divisor\" |-> 2\n            \"result\" |-> ref(0)),\n           parent(0))\n       </scopes>\n       <heap>\n         0 |-> (list(VS:ValSeq) => list(primesAcc(VS, I, N)))\n       </heap>\n       requires 2 <=Int I andBool I <=Int N\n       [priority(40)]"
    }
  ],
