diff --git a//tmp/audit-work/lean-audit.bYtJFO/AuditBridge.lean b//tmp/audit-work/lean-audit.bYtJFO/AuditBridge.lean
new file mode 100644
index 0000000000000000000000000000000000000000..ffdbe901ce773d4b23d40f9c5ec644cfa8092fc2
--- /dev/null
+++ b//tmp/audit-work/lean-audit.bYtJFO/AuditBridge.lean
@@ -0,0 +1,130 @@
+import Proof
+
+open Proof
+open Klean96CountUpTo
+
+def auditValSeqToInts : SortValSeq → Option (List Int)
+  | .«.ValSeq_MPY-CORE_ValSeq» => some []
+  | .«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» (.inj_SortInt value) rest =>
+      (value :: ·) <$> auditValSeqToInts rest
+  | .«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ _ => none
+
+def auditIntSeq (values : List Int) : SortValSeq :=
+  values.foldr
+    (fun value rest =>
+      .«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» (.inj_SortInt value) rest)
+    .«.ValSeq_MPY-CORE_ValSeq»
+
+def auditLookupIntInt (entries : List (SortKItem × SortKItem))
+    (wanted : Int) : Option Int :=
+  match entries with
+  | [] => none
+  | (.inj_SortInt key, .inj_SortInt value) :: rest =>
+      if key = wanted then some value else auditLookupIntInt rest wanted
+  | _ :: rest => auditLookupIntInt rest wanted
+
+def auditSingleton (key value : Int) : SortMap :=
+  Proof.«_|->_» (.inj_SortInt key) (.inj_SortInt value)
+
+#eval [
+  Proof._andBool_ false false,
+  Proof._andBool_ false true,
+  Proof._andBool_ true false,
+  Proof._andBool_ true true
+]
+
+#eval [
+  Proof.«_<=Int_» (-1) 0,
+  Proof.«_<=Int_» 2 2,
+  Proof.«_<=Int_» 3 2
+]
+
+#eval [
+  Proof.pyModTotal (-5) 3,
+  Proof.pyModTotal 5 (-3),
+  Proof.pyModTotal 9 3
+]
+
+#eval [
+  Proof.noDivisor 2 2 2,
+  Proof.noDivisor 4 2 4,
+  Proof.noDivisor 5 2 5,
+  Proof.noDivisor 9 2 9,
+  Proof.noDivisor 11 2 11,
+  Proof.noDivisor 15 2 15
+]
+
+#eval auditValSeqToInts
+  (Proof.primesAcc .«.ValSeq_MPY-CORE_ValSeq» 2 2)
+#eval auditValSeqToInts
+  (Proof.primesAcc .«.ValSeq_MPY-CORE_ValSeq» 2 10)
+#eval auditValSeqToInts
+  (Proof.primesAcc (auditIntSeq [99]) 2 6)
+#eval auditValSeqToInts
+  (Proof.primesAcc .«.ValSeq_MPY-CORE_ValSeq» 3 8)
+#eval auditValSeqToInts
+  (Proof.primesAcc .«.ValSeq_MPY-CORE_ValSeq» 4 8)
+
+def auditUnion : SortMap :=
+  Proof._Map_ (auditSingleton 1 10) (auditSingleton 2 20)
+
+#eval auditUnion.coll.length
+#eval auditLookupIntInt auditUnion.coll 1
+#eval auditLookupIntInt auditUnion.coll 2
+#eval auditLookupIntInt auditUnion.coll 3
+#eval (auditSingleton 7 70).coll.length
+#eval auditLookupIntInt (auditSingleton 7 70).coll 7
+
+theorem auditNoDivisorBase (candidate divisor upper : Int)
+    (done : upper ≤ divisor) :
+    Proof.noDivisor candidate divisor upper = true := by
+  have zero : (upper - divisor).toNat = 0 := by omega
+  simp [Proof.noDivisor, zero, Proof.noDivisorSteps]
+
+theorem auditNoDivisorFound (candidate divisor upper : Int)
+    (scan : divisor < upper)
+    (found : Proof.pyModTotal candidate divisor = 0) :
+    Proof.noDivisor candidate divisor upper = false := by
+  have step :
+      (upper - divisor).toNat =
+        Nat.succ (upper - (divisor + 1)).toNat := by
+    omega
+  simp [Proof.noDivisor, step, Proof.noDivisorSteps, found]
+
+theorem auditNoDivisorNext (candidate divisor upper : Int)
+    (scan : divisor < upper)
+    (clear : Proof.pyModTotal candidate divisor ≠ 0) :
+    Proof.noDivisor candidate divisor upper =
+      Proof.noDivisor candidate (divisor + 1) upper := by
+  have step :
+      (upper - divisor).toNat =
+        Nat.succ (upper - (divisor + 1)).toNat := by
+    omega
+  simp [Proof.noDivisor, step, Proof.noDivisorSteps, clear]
+
+theorem auditPrimesAccBase (values : SortValSeq) (start upper : Int)
+    (done : upper ≤ start) :
+    Proof.primesAcc values start upper = values := by
+  have zero : (upper - start).toNat = 0 := by omega
+  simp [Proof.primesAcc, zero, Proof.primesAccSteps]
+
+theorem auditPrimesAccNext (values : SortValSeq) (start upper : Int)
+    (scan : start < upper) :
+    Proof.primesAcc values start upper =
+      Proof.primesAcc
+        (if Proof.noDivisor start 2 start then
+          Proof.valSeqAppendInt values start
+        else values)
+        (start + 1) upper := by
+  have step :
+      (upper - start).toNat =
+        Nat.succ (upper - (start + 1)).toNat := by
+    omega
+  simp [Proof.primesAcc, step, Proof.primesAccSteps]
+
+#check auditNoDivisorBase
+#check auditNoDivisorFound
+#check auditNoDivisorNext
+#check auditPrimesAccBase
+#check auditPrimesAccNext
+#check Proof.valSeqConcatSingleton
diff --git a//tmp/audit-work/lean-proc-shim.c b//tmp/audit-work/lean-proc-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..afe6d47c0dadbb7fdb7fe72588507e99918a3448
--- /dev/null
+++ b//tmp/audit-work/lean-proc-shim.c
@@ -0,0 +1,43 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+static int is_proc_pid_exe(const char *path) {
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/exe";
+    const char *cursor;
+
+    if (path == NULL || strncmp(path, prefix, sizeof(prefix) - 1) != 0) {
+        return 0;
+    }
+    cursor = path + sizeof(prefix) - 1;
+    if (*cursor < '0' || *cursor > '9') {
+        return 0;
+    }
+    while (*cursor >= '0' && *cursor <= '9') {
+        ++cursor;
+    }
+    return strcmp(cursor, suffix) == 0;
+}
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+        if (real_readlink == NULL) {
+            errno = ENOSYS;
+            return -1;
+        }
+    }
+    if (is_proc_pid_exe(path)) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}
