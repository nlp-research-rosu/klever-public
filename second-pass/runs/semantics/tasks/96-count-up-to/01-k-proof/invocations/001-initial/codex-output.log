+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        ("n" |-> N:Int
+         "candidate" |-> (I:Int => N)
+         "is_prime" |-> _:Bool
+         "divisor" |-> _:Int
+         "result" |-> ref(H:Int)
+         REST:Map),
+        P:Parent)
+      ...
+    </scopes>
+    <heap>
+      ... H |-> (list(VS:ValSeq) => list(primesAcc(VS, I, N))) ...
+    </heap>
+    requires 2 <=Int I andBool I <=Int N
+endmodule
+
