+            .Stmts)
+          AugAssign(Name("divisor"), "+", Int(1)))
+        If(
+          Name("is_prime"),
+          Expr(Call(
+            Attribute(Name("result"), "append"),
+            Name("candidate"))),
+          .Stmts)
+        AugAssign(Name("candidate"), "+", Int(1)))
+      Return(Name("result"))
+      ~> #endcall
+    => ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
