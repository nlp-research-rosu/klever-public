diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..baa8f8f51b041ae947a707a0844c4d90a65a3124
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module COUNT-UP-TO-SPEC
+  imports COUNT-UP-TO-VERIFICATION
+
+  // Universal entry-body theorem.  This begins in a normal function-call
+  // frame with n bound to an arbitrary non-negative integer and ends with the
+  // returned heap object containing the canonical sequence primesBelow(N).
+  claim
+    <k>
+      Assign(Name("result"), ListExpr(.Exprs))
+      For(
+        Name("candidate"),
+        Call(Name("range"), Int(2), Name("n")),
+        Assign(Name("is_prime"), Bool(true))
+        For(
+          Name("divisor"),
+          Call(Name("range"), Int(2), Name("candidate")),
+          If(
+            Compare(
+              BinOp("%", Name("candidate"), Name("divisor")),
+              CmpOp("==", Int(0))),
+            Assign(Name("is_prime"), Bool(false)),
+            .Stmts))
+        If(
+          Name("is_prime"),
+          Expr(Call(
+            Attribute(Name("result"), "append"),
+            Name("candidate"))),
+          .Stmts))
+      Return(Name("result"))
+      ~> #endcall
+    => ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope("n" |-> N:Int, parent(0)))
+    =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(primesBelow(N)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires N >=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..3dbd497bfcb70ecece7a3ddf4e5020e17f9123e8
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,54 @@
+requires "reference-semantics/semantics.k"
+
+module COUNT-UP-TO-VERIFICATION
+  imports MPY
+
+  // Canonical mathematical result used by the contract.  primesBelow(N)
+  // denotes the strictly increasing sequence containing exactly those P for
+  // which 2 <= P < N and P has no divisor D with 2 <= D < P.
+  syntax ValSeq ::= primesBelow(Int)
+    [function, total, symbol(primesBelow), no-evaluators]
+
+  // The outer-loop summary is the induction invariant for count_up_to.  Its
+  // left-hand side includes the complete translated loop body, so the rule is
+  // applicable only to this implementation.  At loop entry the candidate
+  // iterator starts at 2 and result is the empty list; after all candidates
+  // have been examined, result is precisely the canonical prime sequence.
+  rule <k>
+         #loop(
+           rangeObj(2, N:Int, 1),
+           Name("candidate"),
+           Assign(Name("is_prime"), Bool(true))
+           For(
+             Name("divisor"),
+             Call(Name("range"), Int(2), Name("candidate")),
+             If(
+               Compare(
+                 BinOp("%", Name("candidate"), Name("divisor")),
+                 CmpOp("==", Int(0))),
+               Assign(Name("is_prime"), Bool(false)),
+               .Stmts))
+           If(
+             Name("is_prime"),
+             Expr(Call(
+               Attribute(Name("result"), "append"),
+               Name("candidate"))),
+             .Stmts))
+         => .K
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("n" |-> N
+            "result" |-> ref(H:Int)
+            REST:Map),
+           P:Parent)
+         ...
+       </scopes>
+       <heap>
+         ... H |-> (list(.ValSeq) => list(primesBelow(N))) ...
+       </heap>
+       requires N >=Int 0
+       [priority(40)]
+endmodule

