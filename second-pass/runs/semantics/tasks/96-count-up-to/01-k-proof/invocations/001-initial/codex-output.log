+         "result" |-> ref(0)),
+        parent(0))
+    </scopes>
+    <heap>
+      0 |-> (list(VS:ValSeq) => list(primesAcc(VS, I, N)))
+    </heap>
+    <scopeLoc> 2 </scopeLoc>
+    <heapLoc> 1 </heapLoc>
+    <stack> ST:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
