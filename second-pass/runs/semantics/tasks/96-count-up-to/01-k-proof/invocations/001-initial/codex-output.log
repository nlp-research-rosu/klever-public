+              CmpOp("==", Int(0))),
+            Assign(Name("is_prime"), Bool(false)),
+            .Stmts)
+          AugAssign(Name("divisor"), "+", Int(1)))
+        If(
+          Name("is_prime"),
+          Expr(Call(
+            Attribute(Name("result"), "append"),
+            Name("candidate"))),
+          .Stmts)
+        AugAssign(Name("candidate"), "+", Int(1)))
+      Return(Name("result"))
+      ~> #endcall
+    => ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope("n" |-> N:Int, parent(0)))
+    =>
