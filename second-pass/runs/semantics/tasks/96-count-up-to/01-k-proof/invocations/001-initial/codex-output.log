+           ("candidate" |-> C:Int
+            "divisor" |-> (D:Int => C)
+            "is_prime" |-> (B:Bool => B andBool noDivisor(C, D, C))
+            "n" |-> N:Int
+            "result" |-> ref(0)),
+           parent(0))
