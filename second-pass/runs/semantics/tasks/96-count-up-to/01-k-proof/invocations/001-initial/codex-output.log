diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..366d8f2370d67a4073e69282a2553080ed08266e
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,24 @@
+def count_up_to(n):
+    result = []
+    candidate = 2
+    is_prime = True
+    divisor = 2
+    while candidate < n:
+        while divisor < candidate:
+            if candidate % divisor == 0:
+                is_prime = False
+            divisor += 1
+        if is_prime:
+            result.append(candidate)
+        candidate += 1
+        is_prime = True
+        divisor = 2
+    return result
+
+
+assert count_up_to(5) == [2, 3]
+assert count_up_to(11) == [2, 3, 5, 7]
+assert count_up_to(0) == []
+assert count_up_to(20) == [2, 3, 5, 7, 11, 13, 17, 19]
+assert count_up_to(1) == []
+assert count_up_to(18) == [2, 3, 5, 7, 11, 13, 17]
