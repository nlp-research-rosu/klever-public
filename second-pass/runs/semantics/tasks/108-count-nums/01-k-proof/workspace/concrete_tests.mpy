Module(
  FuncDef("positive_digit_sum", Params("n"),
    Assign(Name("total"), Int(0))
    While(Compare(Name("n"), CmpOp(">", Int(0))),
      AugAssign(Name("total"), "+", BinOp("%", Name("n"), Int(10)))
      AugAssign(Name("n"), "//", Int(10)))
    Return(Name("total")))
  FuncDef("negative_digit_sum", Params("n"),
    Assign(Name("total"), Int(0))
    While(Compare(Name("n"), CmpOp(">=", Int(10))),
      AugAssign(Name("total"), "+", BinOp("%", Name("n"), Int(10)))
      AugAssign(Name("n"), "//", Int(10)))
    Return(BinOp("-", Name("total"), Name("n"))))
  FuncDef("signed_digit_sum", Params("n"),
    If(Compare(Name("n"), CmpOp("<", Int(0))),
      Return(
        Call(Name("negative_digit_sum"), BinOp("-", Int(0), Name("n")))),
      )
    Return(Call(Name("positive_digit_sum"), Name("n"))))
  FuncDef("count_nums", Params("arr"),
    Assign(Name("count"), Int(0))
    For(Name("n"), Name("arr"),
      If(Compare(
        Call(Name("signed_digit_sum"), Name("n")),
        CmpOp(">", Int(0))),
        AugAssign(Name("count"), "+", Int(1)),
        ))
    Return(Name("count")))
  Assert(
    Compare(Call(Name("count_nums"), ListExpr()), CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("count_nums"),
        ListExpr(UnaryOp("-", Int(1)), Int(11), UnaryOp("-", Int(11)))),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("count_nums"), ListExpr(Int(1), Int(1), Int(2))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("count_nums"),
        ListExpr(
          Int(0),
          Int(10),
          UnaryOp("-", Int(10)),
          Int(123),
          UnaryOp("-", Int(123)))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("count_nums"),
        ListExpr(
          UnaryOp("-", Int(12)),
          UnaryOp("-", Int(21)),
          UnaryOp("-", Int(123)),
          UnaryOp("-", Int(999)),
          Int(100),
          UnaryOp("-", Int(100)))),
      CmpOp("==", Int(4)))))
