+            ("n" |-> N:Int "total" |-> A:Int)
+            => ("n" |-> leadingDigit(N)
+                "total" |-> negativeTotal(N, A)),
+            P:Parent)
+          ...
+        </scopes>
+        requires N >=Int 0
+endmodule
+
