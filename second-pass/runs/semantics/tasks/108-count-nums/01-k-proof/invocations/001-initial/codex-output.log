+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("arr" |-> list(ALL:ValSeq)
+            "count" |-> C:Int
+            "n" |-> OLD:Val)
+           => ("arr" |-> list(ALL)
+               "count" |-> countFold(VS, C)
+               "n" |-> lastOr(VS, OLD)),
+           parent(0))
+         ...
+       </scopes>
+       [priority(40)]
+endmodule
+
+module COUNT-LOOP-LEMMA
+  imports COUNT-LOOP-WITH-N-LEMMA
+
