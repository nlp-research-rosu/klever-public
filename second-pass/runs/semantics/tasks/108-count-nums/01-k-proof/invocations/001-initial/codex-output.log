+++ b/spec.k
@@ -0,0 +1,173 @@
+requires "verification.k"
+
+module POSITIVE-LOOP-SPEC
+  imports COUNT-NUMS-VERIFICATION-BASE
+
+  claim <k> #while(Compare(Name("n"), CmpOp(">", Int(0))),
+                    positiveLoopBody) => .K ... </k>
+        <env> L:Int </env>
+        <scopes>
+          ... L |-> scope(
+            ("n" |-> N:Int "total" |-> A:Int)
+            => ("n" |-> 0
+                "total" |-> positiveFold(N, A)),
+            P:Parent)
+          ...
+        </scopes>
+        requires N >=Int 0
+endmodule
+
+module NEGATIVE-LOOP-SPEC
+  imports COUNT-NUMS-VERIFICATION-BASE
+
+  claim <k> #while(Compare(Name("n"), CmpOp(">=", Int(10))),
+                    negativeLoopBody) => .K ... </k>
+        <env> L:Int </env>
+        <scopes>
+          ... L |-> scope(
+            ("n" |-> N:Int "total" |-> A:Int)
+            => ("n" |-> leadingDigit(N)
+                "total" |-> negativeTotal(N, A)),
+            P:Parent)
+          ...
+        </scopes>
+        requires N >=Int 0
+endmodule
+
+module POSITIVE-FUNCTION-SPEC
+  imports DIGIT-LOOP-LEMMAS
+
+  claim
+    <k> #applyK(toCall(positiveDigitClosure), (N:Int, .Vals))
+      => positiveDigitSum(N) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
+
+module NEGATIVE-FUNCTION-SPEC
+  imports DIGIT-LOOP-LEMMAS
+
+  claim
+    <k> #applyK(toCall(negativeDigitClosure), (N:Int, .Vals))
+      => negativeDigitSum(N) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
+
+module SIGNED-FUNCTION-SPEC
+  imports DIGIT-FUNCTION-LEMMAS
+
+  claim
+    <k> #applyK(toCall(signedDigitClosure), (N:Int, .Vals))
+      => signedDigitSum(N) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(digitFunctionBindings, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module COUNT-LOOP-WITH-N-SPEC
+  imports SIGNED-DIGIT-LEMMA
+
+  claim <k> #loop(list(VS:ValSeq), Name("n"), countLoopBody)
+          => .K ... </k>
+        <env> L:Int </env>
+        <scopes>
+          ... 0 |-> scope(digitFunctionBindings, parent(-1))
+              L |-> scope(
+                ("arr" |-> list(ALL:ValSeq)
+                 "count" |-> C:Int
+                 "n" |-> OLD:Val)
+                => ("arr" |-> list(ALL)
+                    "count" |-> countFold(VS, C)
+                    "n" |-> lastOr(VS, OLD)),
+                parent(0))
+          ...
+        </scopes>
+        requires L =/=Int 0 andBool allInts(VS)
+endmodule
+
+module COUNT-LOOP-SPEC
+  imports COUNT-LOOP-WITH-N-LEMMA
+
+  claim <k> #loop(list(.ValSeq), Name("n"), countLoopBody)
+          => .K ... </k>
+        <env> L:Int </env>
+        <scopes>
+          ... 0 |-> scope(digitFunctionBindings, parent(-1))
+              L |-> scope(
+                ("arr" |-> list(ALL:ValSeq) "count" |-> C:Int),
+                parent(0))
+          ...
+        </scopes>
+        requires L =/=Int 0
+
+  claim <k> #loop(list(vCons(H:Val, REST:ValSeq)),
+                   Name("n"), countLoopBody)
+          => .K ... </k>
+        <env> L:Int </env>
+        <scopes>
+          ... 0 |-> scope(digitFunctionBindings, parent(-1))
+              L |-> scope(
+                ("arr" |-> list(ALL:ValSeq) "count" |-> C:Int)
+                => ("arr" |-> list(ALL)
+                    "count" |-> countFold(vCons(H, REST), C)
+                    "n" |-> lastOr(REST, H)),
+                parent(0))
+          ...
+        </scopes>
+        requires L =/=Int 0
+         andBool isInt(H) andBool allInts(REST)
+endmodule
+
+module COUNT-NUMS-SPEC
+  imports COUNT-NUMS-VERIFICATION
+
+  claim
+    <k> #applyK(toCall(countNumsClosure),
+                (list(VS:ValSeq), .Vals))
+      => countPositive(VS) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(digitFunctionBindings, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..3a61515a342e7b479fa61e018a804aa95b50c073
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,248 @@
+requires "reference-semantics/semantics.k"
+
+module COUNT-NUMS-VERIFICATION-BASE
+  imports MPY
+
+  // Mathematical model of base-10 digit processing for nonnegative inputs.
+  syntax Int ::= digitQuot(Int) [function, total]
+  rule digitQuot(N:Int) => (N -Int pyMod(N, 10)) /Int 10
+
+  syntax Int ::= positiveFold(Int, Int) [function, total]
+  rule positiveFold(N:Int, A:Int) => A requires N <=Int 0
+  rule positiveFold(N:Int, A:Int)
+    => positiveFold(digitQuot(N), A +Int pyMod(N, 10))
+    requires N >Int 0
+
+  syntax Int ::= positiveDigitSum(Int) [function, total]
+  rule positiveDigitSum(N:Int) => positiveFold(N, 0)
+
+  // For a negative original input, the magnitude's leading digit is negated.
+  syntax Int ::= leadingDigit(Int) [function, total]
+  rule leadingDigit(N:Int) => N
+    requires N <Int 10
+  rule leadingDigit(N:Int) => leadingDigit(digitQuot(N))
+    requires N >=Int 10
+
+  syntax Int ::= negativeTotal(Int, Int) [function, total]
+  rule negativeTotal(N:Int, A:Int) => A
+    requires N <Int 10
+  rule negativeTotal(N:Int, A:Int)
+    => negativeTotal(digitQuot(N), A +Int pyMod(N, 10))
+    requires N >=Int 10
+
+  syntax Int ::= negativeDigitSum(Int) [function, total]
+  rule negativeDigitSum(N:Int)
+    => negativeTotal(N, 0) -Int leadingDigit(N)
+
+  syntax Int ::= signedDigitSum(Int) [function, total]
+  rule signedDigitSum(N:Int) => negativeDigitSum(0 -Int N)
+    requires N <Int 0
+  rule signedDigitSum(N:Int) => positiveDigitSum(N)
+    requires N >=Int 0
+
+  // Total proof-level projection used only under an isInt(V) path condition.
+  syntax Int ::= intValue(Val) [function, total]
+  rule intValue(N:Int) => N
+  rule intValue(_:Val) => 0 [owise]
+
+  syntax Int ::= positiveBit(Int) [function, total]
+  rule positiveBit(N:Int) => 1 requires N >Int 0
+  rule positiveBit(N:Int) => 0 requires N <=Int 0
+
+  syntax Int ::= countFold(ValSeq, Int) [function, total]
+  rule countFold(.ValSeq, C:Int) => C
+  rule countFold(vCons(V:Val, REST:ValSeq), C:Int)
+    => countFold(REST,
+                 C +Int positiveBit(signedDigitSum(intValue(V))))
+    requires isInt(V)
+
+  syntax Int ::= countPositive(ValSeq) [function, total]
+  rule countPositive(VS:ValSeq) => countFold(VS, 0)
+
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, REST:ValSeq))
+    => isInt(V) andBool allInts(REST)
+
+  // The loop target remains bound after a Python for-loop.
+  syntax Val ::= lastOr(ValSeq, Val) [function, total]
+  rule lastOr(.ValSeq, OLD:Val) => OLD
+  rule lastOr(vCons(V:Val, REST:ValSeq), _OLD:Val)
+    => lastOr(REST, V)
+
+  // Exact statement blocks emitted in solution.mpy.
+  syntax Stmts ::= "positiveLoopBody" [macro]
+  rule positiveLoopBody
+    => AugAssign(Name("total"), "+", BinOp("%", Name("n"), Int(10)))
+       AugAssign(Name("n"), "//", Int(10))
+
+  syntax Stmts ::= "negativeLoopBody" [macro]
+  rule negativeLoopBody
+    => AugAssign(Name("total"), "+", BinOp("%", Name("n"), Int(10)))
+       AugAssign(Name("n"), "//", Int(10))
+
+  syntax Stmts ::= "positiveFunctionBody" [macro]
+  rule positiveFunctionBody
+    => Assign(Name("total"), Int(0))
+       While(Compare(Name("n"), CmpOp(">", Int(0))), positiveLoopBody)
+       Return(Name("total"))
+
+  syntax Stmts ::= "negativeFunctionBody" [macro]
+  rule negativeFunctionBody
+    => Assign(Name("total"), Int(0))
+       While(Compare(Name("n"), CmpOp(">=", Int(10))), negativeLoopBody)
+       Return(BinOp("-", Name("total"), Name("n")))
+
+  syntax Stmts ::= "signedFunctionBody" [macro]
+  rule signedFunctionBody
+    => If(Compare(Name("n"), CmpOp("<", Int(0))),
+          Return(Call(Name("negative_digit_sum"),
+                      BinOp("-", Int(0), Name("n")))),
+          .Stmts)
+       Return(Call(Name("positive_digit_sum"), Name("n")))
+
+  syntax Stmts ::= "countLoopBody" [macro]
+  rule countLoopBody
+    => If(Compare(Call(Name("signed_digit_sum"), Name("n")),
+                 CmpOp(">", Int(0))),
+          AugAssign(Name("count"), "+", Int(1)),
+          .Stmts)
+
+  syntax Stmts ::= "countFunctionBody" [macro]
+  rule countFunctionBody
+    => Assign(Name("count"), Int(0))
+       For(Name("n"), Name("arr"), countLoopBody)
+       Return(Name("count"))
+
+  syntax Val ::= "positiveDigitClosure" [macro]
+  rule positiveDigitClosure
+    => closureVal("n", positiveFunctionBody, 0)
+
+  syntax Val ::= "negativeDigitClosure" [macro]
+  rule negativeDigitClosure
+    => closureVal("n", negativeFunctionBody, 0)
+
+  syntax Val ::= "signedDigitClosure" [macro]
+  rule signedDigitClosure
+    => closureVal("n", signedFunctionBody, 0)
+
+  syntax Val ::= "countNumsClosure" [macro]
+  rule countNumsClosure
+    => closureVal("arr", countFunctionBody, 0)
+
+  syntax Map ::= "digitFunctionBindings" [macro]
+  rule digitFunctionBindings
+    => ("positive_digit_sum" |-> positiveDigitClosure
+        "negative_digit_sum" |-> negativeDigitClosure
+        "signed_digit_sum"   |-> signedDigitClosure)
+endmodule
+
+// These rules are the already-proved loop invariants, exposed as reusable
+// semantic lemmas for the function-level claims.
+module DIGIT-LOOP-LEMMAS
+  imports COUNT-NUMS-VERIFICATION-BASE
+
+  rule <k> #while(Compare(Name("n"), CmpOp(">", Int(0))),
+                   positiveLoopBody) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("n" |-> N:Int "total" |-> A:Int)
+           => ("n" |-> 0
+               "total" |-> positiveFold(N, A)),
+           P:Parent)
+         ...
+       </scopes>
+       requires N >=Int 0
+       [priority(40)]
+
+  rule <k> #while(Compare(Name("n"), CmpOp(">=", Int(10))),
+                   negativeLoopBody) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("n" |-> N:Int "total" |-> A:Int)
+           => ("n" |-> leadingDigit(N)
+               "total" |-> negativeTotal(N, A)),
+           P:Parent)
+         ...
+       </scopes>
+       requires N >=Int 0
+       [priority(40)]
+endmodule
+
+module DIGIT-FUNCTION-LEMMAS
+  imports DIGIT-LOOP-LEMMAS
+
+  rule <k> #applyK(toCall(positiveDigitClosure), (N:Int, .Vals))
+        => positiveDigitSum(N) ... </k>
+       requires N >=Int 0
+       [priority(40)]
+
+  rule <k> #applyK(toCall(negativeDigitClosure), (N:Int, .Vals))
+        => negativeDigitSum(N) ... </k>
+       requires N >=Int 0
+       [priority(40)]
+endmodule
+
+module SIGNED-DIGIT-LEMMA
+  imports DIGIT-FUNCTION-LEMMAS
+
+  rule <k> #applyK(toCall(signedDigitClosure), (V:Val, .Vals))
+        => signedDigitSum(intValue(V)) ... </k>
+       requires isInt(V)
+       [priority(40)]
+endmodule
+
+module COUNT-LOOP-WITH-N-LEMMA
+  imports SIGNED-DIGIT-LEMMA
+
+  rule <k> #loop(list(VS:ValSeq), Name("n"), countLoopBody) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("arr" |-> list(ALL:ValSeq)
+               "count" |-> C:Int
+            "n" |-> OLD:Val)
+           => ("arr" |-> list(ALL)
+               "count" |-> countFold(VS, C)
+               "n" |-> lastOr(VS, OLD)),
+           parent(0))
+         ...
+       </scopes>
+       requires allInts(VS)
+       [priority(40)]
+endmodule
+
+module COUNT-LOOP-LEMMA
+  imports COUNT-LOOP-WITH-N-LEMMA
+
+  rule <k> #loop(list(.ValSeq), Name("n"), countLoopBody) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("arr" |-> list(ALL:ValSeq) "count" |-> C:Int),
+           parent(0))
+         ...
+       </scopes>
+       [priority(40)]
+
+  rule <k> #loop(list(vCons(H:Val, REST:ValSeq)),
+                  Name("n"), countLoopBody) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("arr" |-> list(ALL:ValSeq) "count" |-> C:Int)
+           => ("arr" |-> list(ALL)
+               "count" |-> countFold(vCons(H, REST), C)
+               "n" |-> lastOr(REST, H)),
+           parent(0))
+         ...
+       </scopes>
+       requires isInt(H) andBool allInts(REST)
+       [priority(40)]
+endmodule
+
+module COUNT-NUMS-VERIFICATION
+  imports COUNT-LOOP-LEMMA
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..0b972833045b22484dfb4a82d3c03390714aa42c
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,35 @@
+def positive_digit_sum(n):
+    total = 0
+    while n > 0:
+        total += n % 10
+        n //= 10
+    return total
+
+
+def negative_digit_sum(n):
+    total = 0
+    while n >= 10:
+        total += n % 10
+        n //= 10
+    return total - n
+
+
+def signed_digit_sum(n):
+    if n < 0:
+        return negative_digit_sum(0 - n)
+    return positive_digit_sum(n)
+
+
+def count_nums(arr):
+    count = 0
+    for n in arr:
+        if signed_digit_sum(n) > 0:
+            count += 1
+    return count
+
+
+assert count_nums([]) == 0
+assert count_nums([-1, 11, -11]) == 1
+assert count_nums([1, 1, 2]) == 3
+assert count_nums([0, 10, -10, 123, -123]) == 3
+assert count_nums([-12, -21, -123, -999, 100, -100]) == 4
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..01599cb3c27d4f51956eeba9ffa58c5171a2175e
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,77 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Translate the submitted implementation.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Concrete execution using the required LLVM main and syntax modules.
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+krun concrete_tests.mpy --definition runtime-kompiled
+
+# Prove each layer only after compiling the previously proved lemmas.
+# In particular, the definition used for a claim never contains that claim's
+# own summary rule.
+kompile verification.k \
+  --backend haskell \
+  --main-module COUNT-NUMS-VERIFICATION-BASE \
+  --syntax-module MPY-SYNTAX \
+  --output-definition loop-base-kompiled
+kprove spec.k \
+  --definition loop-base-kompiled \
+  --spec-module POSITIVE-LOOP-SPEC
+kprove spec.k \
+  --definition loop-base-kompiled \
+  --spec-module NEGATIVE-LOOP-SPEC
+
+kompile verification.k \
+  --backend haskell \
+  --main-module DIGIT-LOOP-LEMMAS \
+  --syntax-module MPY-SYNTAX \
+  --output-definition digit-loop-kompiled
+kprove spec.k \
+  --definition digit-loop-kompiled \
+  --spec-module POSITIVE-FUNCTION-SPEC
+kprove spec.k \
+  --definition digit-loop-kompiled \
+  --spec-module NEGATIVE-FUNCTION-SPEC
+
+kompile verification.k \
+  --backend haskell \
+  --main-module DIGIT-FUNCTION-LEMMAS \
+  --syntax-module MPY-SYNTAX \
+  --output-definition digit-function-kompiled
+kprove spec.k \
+  --definition digit-function-kompiled \
+  --spec-module SIGNED-FUNCTION-SPEC
+
+kompile verification.k \
+  --backend haskell \
+  --main-module SIGNED-DIGIT-LEMMA \
+  --syntax-module MPY-SYNTAX \
+  --output-definition signed-digit-kompiled
+kprove spec.k \
+  --definition signed-digit-kompiled \
+  --spec-module COUNT-LOOP-WITH-N-SPEC
+
+kompile verification.k \
+  --backend haskell \
+  --main-module COUNT-LOOP-WITH-N-LEMMA \
+  --syntax-module MPY-SYNTAX \
+  --output-definition count-loop-with-n-kompiled
+kprove spec.k \
+  --definition count-loop-with-n-kompiled \
+  --spec-module COUNT-LOOP-SPEC
+
+kompile verification.k \
+  --backend haskell \
+  --main-module COUNT-LOOP-LEMMA \
+  --syntax-module MPY-SYNTAX \
+  --output-definition count-loop-kompiled
+kprove spec.k \
+  --definition count-loop-kompiled \
+  --spec-module COUNT-NUMS-SPEC
