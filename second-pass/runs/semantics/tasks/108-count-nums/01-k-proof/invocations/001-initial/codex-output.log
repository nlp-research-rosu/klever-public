+requires "verification.k"
+
+module POSITIVE-LOOP-SPEC
+  imports COUNT-NUMS-VERIFICATION-BASE
+
+  claim <k> #while(Compare(Name("n"), CmpOp(">", Int(0))),
+                    positiveLoopBody) => .K ... </k>
+        <env> L:Int </env>
+        <scopes>
+          ... L |-> scope(
+            ("n" |-> N:Int "total" |-> A:Int M:Map)
+            => ("n" |-> 0
+                "total" |-> A +Int positiveDigitSum(N)
+                M),
+            P:Parent)
+          ...
+        </scopes>
+        requires N >=Int 0
+         andBool notBool ("n" in_keys(M))
+         andBool notBool ("total" in_keys(M))
+endmodule
+
+module NEGATIVE-LOOP-SPEC
+  imports COUNT-NUMS-VERIFICATION-BASE
+
+  claim <k> #while(Compare(Name("n"), CmpOp(">=", Int(10))),
+                    negativeLoopBody) => .K ... </k>
+        <env> L:Int </env>
+        <scopes>
+          ... L |-> scope(
+            ("n" |-> N:Int "total" |-> A:Int M:Map)
+            => ("n" |-> leadingDigit(N)
+                "total" |-> A +Int negativeDigitSum(N) +Int leadingDigit(N)
+                M),
+            P:Parent)
+          ...
+        </scopes>
+        requires N >=Int 0
+         andBool notBool ("n" in_keys(M))
+         andBool notBool ("total" in_keys(M))
+endmodule
+
+module POSITIVE-FUNCTION-SPEC
+  imports DIGIT-LOOP-LEMMAS
+
+  claim
+    <k> Call(closureExpr("n", positiveFunctionBody), (N:Int, .Exprs))
+      => positiveDigitSum(N) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+    requires N >=Int 0
+endmodule
+
+module NEGATIVE-FUNCTION-SPEC
+  imports DIGIT-LOOP-LEMMAS
+
+  claim
+    <k> Call(closureExpr("n", negativeFunctionBody), (N:Int, .Exprs))
+      => negativeDigitSum(N) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+    requires N >=Int 0
+endmodule
+
+module SIGNED-FUNCTION-SPEC
+  imports DIGIT-FUNCTION-LEMMAS
+
+  claim
+    <k> Call(closureExpr("n", signedFunctionBody), (N:Int, .Exprs))
+      => signedDigitSum(N) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(digitFunctionBindings, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+endmodule
+
+module COUNT-LOOP-SPEC
+  imports SIGNED-DIGIT-LEMMA
+
+  claim <k> #loop(list(VS:ValSeq), Name("n"), countLoopBody)
+          => .K ... </k>
+        <env> L:Int </env>
+        <scopes>
+          ... 0 |-> scope(digitFunctionBindings, parent(-1))
+              L |-> scope(
+                ("count" |-> C:Int M:Map)
+                => ("count" |-> C +Int countPositive(VS)
+                    updateLoopTarget(VS, M)),
+                P:Parent)
+          ...
+        </scopes>
+        requires L =/=Int 0
+         andBool notBool ("count" in_keys(M))
+endmodule
+
+module COUNT-NUMS-SPEC
+  imports COUNT-NUMS-VERIFICATION
+
+  claim
+    <k> Call(closureExpr("arr", countFunctionBody),
+             (list(VS:ValSeq), .Exprs))
+      => countPositive(VS) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(digitFunctionBindings, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+endmodule
