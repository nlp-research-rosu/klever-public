+    <k> #applyK(toCall(countNumsClosure),
+                (list(VS:ValSeq), .Vals))
+      => countPositive(VS) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(digitFunctionBindings, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
