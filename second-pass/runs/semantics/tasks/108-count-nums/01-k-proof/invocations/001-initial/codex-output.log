+            ("n" |-> N:Int "total" |-> A:Int)
+            => ("n" |-> leadingDigit(N)
+                "total" |-> A +Int negativeDigitSum(N) +Int leadingDigit(N)),
+            P:Parent)
+          ...
+        </scopes>
+        requires N >=Int 0
