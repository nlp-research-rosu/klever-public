+          ... 0 |-> scope(digitFunctionBindings, parent(-1))
+              L |-> scope(
+                ("arr" |-> list(ALL:ValSeq)
+                 "count" |-> C:Int
+                 "n" |-> OLD:Val)
+                => ("arr" |-> list(ALL)
+                    "count" |-> countFold(VS, C)
+                    "n" |-> lastOr(VS, OLD)),
