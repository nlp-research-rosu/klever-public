/bin/bash -lc 'kompile verification.k --backend haskell --main-module COUNT-NUMS-VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /work
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..cd294a000946ac6d70a20878216a0f3f2270a07d
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,28 @@
+def positive_digit_sum(n):
+    total = 0
+    while n > 0:
+        total += n % 10
+        n //= 10
+    return total
+
+
+def negative_digit_sum(n):
+    total = 0
+    while n >= 10:
+        total += n % 10
+        n //= 10
+    return total - n
+
+
+def signed_digit_sum(n):
+    if n < 0:
+        return negative_digit_sum(0 - n)
+    return positive_digit_sum(n)
+
+
+def count_nums(arr):
+    count = 0
+    for n in arr:
+        if signed_digit_sum(n) > 0:
+            count += 1
+    return count
