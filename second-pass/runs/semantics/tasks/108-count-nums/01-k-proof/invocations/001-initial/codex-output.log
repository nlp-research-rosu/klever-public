+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+    requires N >=Int 0
+endmodule
+
+module NEGATIVE-FUNCTION-SPEC
+  imports DIGIT-LOOP-LEMMAS
+
+  claim
+    <k> Call(closureExpr("n", negativeFunctionBody), (N:Int, .Exprs))
+      => negativeDigitSum(N) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+    requires N >=Int 0
+endmodule
+
+module SIGNED-FUNCTION-SPEC
+  imports DIGIT-FUNCTION-LEMMAS
+
+  claim
+    <k> Call(closureExpr("n", signedFunctionBody), (N:Int, .Exprs))
+      => signedDigitSum(N) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(digitFunctionBindings, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+endmodule
+
+module COUNT-LOOP-SPEC
+  imports SIGNED-DIGIT-LEMMA
+
+  claim <k> #loop(list(VS:ValSeq), Name("n"), countLoopBody)
+          => .K ... </k>
+        <env> L:Int </env>
+        <scopes>
+          ... 0 |-> scope(digitFunctionBindings, parent(-1))
+              L |-> scope(
+                ("count" |-> C:Int M:Map)
+                => ("count" |-> C +Int countPositive(VS)
+                    updateLoopTarget(VS, M)),
+                P:Parent)
+          ...
+        </scopes>
+        requires L =/=Int 0
+         andBool notBool ("count" in_keys(M))
+         andBool notBool ("$cells" in_keys(M))
+endmodule
+
+module COUNT-NUMS-SPEC
+  imports COUNT-NUMS-VERIFICATION
+
+  claim
+    <k> Call(closureExpr("arr", countFunctionBody),
+             (list(VS:ValSeq), .Exprs))
+      => countPositive(VS) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(digitFunctionBindings, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
