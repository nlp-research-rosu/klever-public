+                    negativeLoopBody) => .K ... </k>
+        <env> L:Int </env>
+        <scopes>
+          ... L |-> scope(
+            ("n" |-> N:Int "total" |-> A:Int)
+            => ("n" |-> leadingDigit(N)
+                "total" |-> negativeTotal(N, A)),
+            P:Parent)
+          ...
+        </scopes>
+        requires N >=Int 0
+endmodule
+
+module POSITIVE-FUNCTION-SPEC
