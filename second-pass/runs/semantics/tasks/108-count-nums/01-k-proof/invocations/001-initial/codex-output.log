+def positive_digit_sum(n):
+    if n < 10:
+        return n
+    return n % 10 + positive_digit_sum(n // 10)
+
+
+def negative_digit_sum(n):
+    if n < 10:
+        return 0 - n
+    return n % 10 + negative_digit_sum(n // 10)
+
+
+def signed_digit_sum(n):
+    if n < 0:
+        return negative_digit_sum(0 - n)
+    return positive_digit_sum(n)
+
+
+def count_nums(arr):
+    count = 0
+    for n in arr:
+        if signed_digit_sum(n) > 0:
+            count += 1
+    return count

