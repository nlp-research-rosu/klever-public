FILE /reference/canonical.py
     1	# canonical.py — the UNMODIFIED HumanEval/108 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: count_nums
     4	
     5	
     6	def count_nums(arr):
     7	    """
     8	    Write a function count_nums which takes an array of integers and returns
     9	    the number of elements which has a sum of digits > 0.
    10	    If a number is negative, then its first signed digit will be negative:
    11	    e.g. -123 has signed digits -1, 2, and 3.
    12	    >>> count_nums([]) == 0
    13	    >>> count_nums([-1, 11, -11]) == 1
    14	    >>> count_nums([1, 1, 2]) == 3
    15	    """
    16	    def digits_sum(n):
    17	        neg = 1
    18	        if n < 0: n, neg = -1 * n, -1 
    19	        n = [int(i) for i in str(n)]
    20	        n[0] = n[0] * neg
    21	        return sum(n)
    22	    return len(list(filter(lambda x: x > 0, [digits_sum(i) for i in arr])))
