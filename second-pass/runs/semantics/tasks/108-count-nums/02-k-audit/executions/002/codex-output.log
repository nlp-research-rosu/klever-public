/bin/bash -lc 'kast solution.mpy --definition audit-loop-base-kompiled --sort Module --output json --expand-macros > /tmp/audit-work/solution-kast.json
for term in positiveFunctionBody negativeFunctionBody signedFunctionBody countFunctionBody positiveLoopBody negativeLoopBody countLoopBody positiveDigitClosure negativeDigitClosure signedDigitClosure countNumsClosure digitFunctionBindings; do
  kast --definition audit-loop-base-kompiled --sort Stmts --expression "$term" --output json --expand-macros > "/tmp/audit-work/${term}.json" 2>"/tmp/audit-work/${term}.err" || true
done
