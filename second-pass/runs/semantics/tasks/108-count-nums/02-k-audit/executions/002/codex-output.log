+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module AUDIT-COUNT-INITIAL-BRIDGE-RESULT-SPEC
+  imports COUNT-LOOP-WITH-N-LEMMA
+
