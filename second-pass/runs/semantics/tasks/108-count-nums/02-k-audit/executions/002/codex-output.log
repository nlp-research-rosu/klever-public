+
+  claim
+    <k> #applyK(toCall(signedDigitClosure), (-1, .Vals)) => 99 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        ("negative_digit_sum" |-> closureVal("n", Return(Int(99)), 0)),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
