     6	def count_nums(arr):
     7	    """
     8	    Write a function count_nums which takes an array of integers and returns
     9	    the number of elements which has a sum of digits > 0.
    10	    If a number is negative, then its first signed digit will be negative:
    11	    e.g. -123 has signed digits -1, 2, and 3.
    12	    >>> count_nums([]) == 0
    13	    >>> count_nums([-1, 11, -11]) == 1
    14	    >>> count_nums([1, 1, 2]) == 3
