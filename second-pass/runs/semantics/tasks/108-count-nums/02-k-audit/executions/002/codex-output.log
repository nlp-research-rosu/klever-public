) 2>&1 | tee /audit-output/evidence/02-translation-identity.log
status="'${PIPESTATUS[0]}
printf '"'COMMAND_EXIT_STATUS=%s\\n' \""'$status" | tee -a /audit-output/evidence/02-translation-identity.log
exit "$status"' in /tmp/audit-work/reconstruction
