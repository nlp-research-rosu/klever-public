+        => ("arr" |-> list(vCons(-1, .ValSeq)) "count" |-> 1 "n" |-> -1),
+        parent(0))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
