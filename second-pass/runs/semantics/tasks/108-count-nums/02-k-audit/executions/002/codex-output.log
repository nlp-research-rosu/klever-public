     1	def positive_digit_sum(n):
     2	    total = 0
     3	    while n > 0:
     4	        total += n % 10
     5	        n //= 10
     6	    return total
     7	
     8	
     9	def negative_digit_sum(n):
    10	    total = 0
    11	    while n >= 10:
    12	        total += n % 10
    13	        n //= 10
    14	    return total - n
    15	
    16	
    17	def signed_digit_sum(n):
    18	    if n < 0:
    19	        return negative_digit_sum(0 - n)
    20	    return positive_digit_sum(n)
    21	
    22	
    23	def count_nums(arr):
    24	    count = 0
    25	    for n in arr:
    26	        if signed_digit_sum(n) > 0:
    27	            count += 1
    28	    return count
    29	
    30	
    31	assert count_nums([]) == 0
    32	assert count_nums([-1, 11, -11]) == 1
    33	assert count_nums([1, 1, 2]) == 3
    34	assert count_nums([0, 10, -10, 123, -123]) == 3
    35	assert count_nums([-12, -21, -123, -999, 100, -100]) == 4
