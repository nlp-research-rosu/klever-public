+overall=0
+
+run_bounded() {
+  label=$1
+  shift
+  temporary=$(mktemp "/tmp/${label}.XXXXXX")
+  printf 'RUN %s\n' "$label"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@" >"$temporary" 2>&1
