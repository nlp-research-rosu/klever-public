+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> retV(99) </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module POSITIVE-BRIDGE-FIXED-COMPARISON
+  imports COUNT-NUMS-VERIFICATION-BASE
+
+  claim
+    <k> #applyK(toCall(positiveDigitClosure), (12, .Vals))
+      => 3 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
