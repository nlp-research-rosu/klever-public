+#!/usr/bin/env bash
+set -o pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: run-command.sh LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+logfile=$1
+shift
+
+{
