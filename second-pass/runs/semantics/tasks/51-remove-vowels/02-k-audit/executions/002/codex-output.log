.k:29:      OUTER\nspec.k:30:    ) </scopes>\nspec.k:31:\nspec.k:32:  claim\nspec.k:33:    <k> (\nspec.k:34:      #loop(\nspec.k:35:        str(iCons(C:Int, REST:IntSeq)),\nspec.k:36:        Name(\"char\"),\nspec.k:37:        removeVowelsLoopBody)\nspec.k:38:      =>\nspec.k:39:      .K\nspec.k:40:    ) ... </k>\nspec.k:41:    <env> CALLEE:Int </env>\nspec.k:42:    <scopes> (\nspec.k:43:      CALLEE |-> scope(\nspec.k:44:        \"text\" |-> str(TEXT:IntSeq)\nspec.k:45:        \"result\" |-> str(ACC:IntSeq)\nspec.k:46:        \"char\" |-> CHAR:Val,\nspec.k:47:        parent(0))\nspec.k:48:      OUTER:Map\nspec.k:49:      =>\nspec.k:50:      CALLEE |-> scope(\nspec.k:51:        \"text\" |-> str(TEXT)\nspec.k:52:        \"result\" |-> str(removeVowelCodesAcc(ACC, REST))\nspec.k:53:        \"char\" |-> ?FINALCHAR:Val,\nspec.k:54:        parent(0))\nspec.k:55:      OUTER\nspec.k:56:    ) </scopes>\nspec.k:57:    requires isVowelCode(C)\nspec.k:58:\nspec.k:59:  claim\nspec.k:60:    <k> (\nspec.k:61:      #loop(\nspec.k:62:        str(iCons(C:Int, REST:IntSeq)),\nspec.k:63:        Name(\"char\"),\nspec.k:64:        removeVowelsLoopBody)\nspec.k:65:      =>\nspec.k:66:      .K\nspec.k:67:    ) ... </k>\nspec.k:68:    <env> CALLEE:Int </env>\nspec.k:69:    <scopes> (\nspec.k:70:      CALLEE |-> scope(\nspec.k:71:        \"text\" |-> str(TEXT:IntSeq)\nspec.k:72:        \"result\" |-> str(ACC:IntSeq)\nspec.k:73:        \"char\" |-> CHAR:Val,\nspec.k:74:        parent(0))\nspec.k:75:      OUTER:Map\nspec.k:76:      =>\nspec.k:77:      CALLEE |-> scope(\nspec.k:78:        \"text\" |-> str(TEXT)\nspec.k:79:        \"result\" |-> str(\nspec.k:80:          removeVowelCodesAcc(\nspec.k:81:            seqConcat(ACC, iCons(C, .IntSeq)),\nspec.k:82:            REST))\nspec.k:83:        \"char\" |-> ?FINALCHAR:Val,\nspec.k:84:        parent(0))\nspec.k:85:      OUTER\nspec.k:86:    ) </scopes>\nspec.k:87:    requires notBool isVowelCode(C)\nspec.k:88:\nspec.k:89:  claim\nspec.k:90:    <k>\nspec.k:91:      #loadAll(removeVowelsProgram)\nspec.k:92:      ~> Call(Name(\"remove_vowels\"), str(CODES:IntSeq))\nspec.k:93:      =>\nspec.k:94:      str(removeVowelCodes(CODES))\nspec.k:95:    </k>\nspec.k:96:    <env> 0 </env>\nspec.k:97:    <scopes>\nspec.k:98:      0 |-> scope(.Map, parent(-1))\nspec.k:99:      -1 |-> builtinsScope\nspec.k:100:      =>\nspec.k:101:      0 |-> scope(\nspec.k:102:        \"remove_vowels\" |->\nspec.k:103:          closureVal((\"text\", .ParamNames), removeVowelsBody, 0),\nspec.k:104:        parent(-1))\nspec.k:105:      -1 |-> builtinsScope\nspec.k:106:    </scopes>\nspec.k:107:    <scopeLoc> 1 </scopeLoc>\nspec.k:108:    <heap> .Map </heap>\nspec.k:109:    <heapLoc> 0 </heapLoc>\nspec.k:110:    <stack> .List </stack>\nspec.k:111:    <ret> noRet </ret>\nspec.k:112:    <exc> NoExc </exc>\nspec.k:113:    <exit-code> 0 </exit-code>\nspec.k:114:endmodule\nsolution.py:1:def remove_vowels(text):\nsolution.py:2:    result = \"\"\nsolution.py:3:    char = \"\"\nsolution.py:4:    for char in text:\nsolution.py:5:        if char not in \"aeiouAEIOU\":\nsolution.py:6:            result += char\nsolution.py:7:    return result\nverification.k:1:requires \"reference-semantics/semantics.k\"\nverification.k:2:\nverification.k:3:module VERIFICATION\nverification.k:4:  imports MPY\nverification.k:5:\nverification.k:6:  syntax IntSeq ::= \"vowelCodes\" [macro]\nverification.k:7:  rule vowelCodes\nverification.k:8:    => iCons(97, iCons(101, iCons(105, iCons(111, iCons(117,\nverification.k:9:       iCons(65, iCons(69, iCons(73, iCons(79, iCons(85, .IntSeq))))))))))\nverification.k:10:\nverification.k:11:  syntax Bool ::= isVowelCode(Int) [function, total]\nverification.k:12:  rule isVowelCode(C:Int)\nverification.k:13:    => C ==Int 65  orBool C ==Int 69  orBool C ==Int 73\nverification.k:14:       orBool C ==Int 79  orBool C ==Int 85  orBool C ==Int 97\nverification.k:15:       orBool C ==Int 101 orBool C ==Int 105 orBool C ==Int 111\nverification.k:16:       orBool C ==Int 117\nverification.k:17:\nverification.k:18:  // This is a proved-by-definition specialization of MPY-STR's substring\nverification.k:19:  // search for a one-character needle and this fixed ten-character haystack.\nverification.k:20:  // It prevents symbolic execution from forking once per haystack position.\nverification.k:21:  rule strContains(iCons(C:Int, .IntSeq), vowelCodes)\nverification.k:22:    => isVowelCode(C)\nverification.k:23:    [priority(40)]\nverification.k:24:\nverification.k:25:  syntax IntSeq ::= removeVowelCodesAcc(IntSeq, IntSeq) [function, total]\nverification.k:26:  rule removeVowelCodesAcc(ACC:IntSeq, .IntSeq) => ACC\nverification.k:27:  rule removeVowelCodesAcc(ACC:IntSeq, iCons(C:Int, REST:IntSeq))\nverification.k:28:    => removeVowelCodesAcc(ACC, REST)\nverification.k:29:    requires isVowelCode(C)\nverification.k:30:  rule removeVowelCodesAcc(ACC:IntSeq, iCons(C:Int, REST:IntSeq))\nverification.k:31:    => removeVowelCodesAcc(\nverification.k:32:         seqConcat(ACC, iCons(C, .IntSeq)),\nverification.k:33:         REST)\nverification.k:34:    requires notBool isVowelCode(C)\nverification.k:35:\nverification.k:36:  syntax IntSeq ::= removeVowelCodes(IntSeq) [function, total]\nverification.k:37:  rule removeVowelCodes(CODES:IntSeq)\nverification.k:38:    => removeVowelCodesAcc(.IntSeq, CODES)\nverification.k:39:\nverification.k:40:  syntax Stmts ::= \"removeVowelsLoopBody\" [macro]\nverification.k:41:  rule removeVowelsLoopBody\nverification.k:42:    => If(Compare(Name(\"char\"), CmpOp(\"not in\", Str(\"aeiouAEIOU\"))),\nverification.k:43:         AugAssign(Name(\"result\"), \"+\", Name(\"char\")),\nverification.k:44:         .Stmts)\nverification.k:45:\nverification.k:46:  syntax Stmts ::= \"removeVowelsBody\" [macro]\nverification.k:47:  rule removeVowelsBody\nverification.k:48:    => Assign(Name(\"result\"), Str(\"\"))\nverification.k:49:       Assign(Name(\"char\"), Str(\"\"))\nverification.k:50:       For(Name(\"char\"), Name(\"text\"), removeVowelsLoopBody)\nverification.k:51:       Return(Name(\"result\"))\nverification.k:52:\nverification.k:53:  syntax Module ::= \"removeVowelsProgram\" [macro]\nverification.k:54:  rule removeVowelsProgram\nverification.k:55:    => Module(\nverification.k:56:         FuncDef(\"remove_vowels\", Params(\"text\"), removeVowelsBody))\nverification.k:57:endmodule\nsolution.mpy:1:Module(\nsolution.mpy:2:  FuncDef(\"remove_vowels\", Params(\"text\"),\nsolution.mpy:3:    Assign(Name(\"result\"), Str(\"\"))\nsolution.mpy:4:    Assign(Name(\"char\"), Str(\"\"))\nsolution.mpy:5:    For(Name(\"char\"), Name(\"text\"),\nsolution.mpy:6:      If(Compare(Name(\"char\"), CmpOp(\"not in\", Str(\"aeiouAEIOU\"))),\nsolution.mpy:7:        AugAssign(Name(\"result\"), \"+\", Name(\"char\")),\nsolution.mpy:8:        ))\nsolution.mpy:9:    Return(Name(\"result\"))))\n","internal_chat_message_metadata_passthrough":{"turn_id":"019f8d65-69f4-77f0-8aaa-5b5f62f6b6ba"}}}
