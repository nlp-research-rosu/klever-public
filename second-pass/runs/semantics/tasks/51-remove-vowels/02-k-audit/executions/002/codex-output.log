+        str(iCons(C:Int, REST:IntSeq)),
+        Name("char"),
+        removeVowelsLoopBody)
+      =>
+      .K
+    ) ... </k>
+    <env> CALLEE:Int </env>
+    <scopes> (
+      CALLEE |-> scope(
+        "text" |-> str(TEXT:IntSeq)
+        "result" |-> str(ACC:IntSeq)
+        "char" |-> CHAR:Val,
+        parent(0))
+      OUTER:Map
+      =>
+      CALLEE |-> scope(
+        "text" |-> str(TEXT)
+        "result" |-> str(removeVowelCodesAcc(ACC, REST))
+        "char" |-> ?FINALCHAR:Val,
+        parent(0))
+      OUTER
+    ) </scopes>
+    requires isVowelCode(C)
+
+  claim [loop-consonant]:
+    <k> (
+      #loop(
+        str(iCons(C:Int, REST:IntSeq)),
+        Name("char"),
+        removeVowelsLoopBody)
+      =>
+      .K
+    ) ... </k>
+    <env> CALLEE:Int </env>
+    <scopes> (
+      CALLEE |-> scope(
+        "text" |-> str(TEXT:IntSeq)
+        "result" |-> str(ACC:IntSeq)
+        "char" |-> CHAR:Val,
+        parent(0))
+      OUTER:Map
+      =>
+      CALLEE |-> scope(
+        "text" |-> str(TEXT)
+        "result" |-> str(
+          removeVowelCodesAcc(
+            seqConcat(ACC, iCons(C, .IntSeq)),
+            REST))
+        "char" |-> ?FINALCHAR:Val,
+        parent(0))
+      OUTER
+    ) </scopes>
+    requires notBool isVowelCode(C)
+
+  claim [entry]:
+    <k>
+      #loadAll(removeVowelsProgram)
+      ~> Call(Name("remove_vowels"), str(CODES:IntSeq))
+      =>
+      str(removeVowelCodes(CODES))
