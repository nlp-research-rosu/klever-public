+requires "connection-verification.k"
+
+module CONNECTION-SPEC
+  imports CONNECTION
+
+  claim [below-65]:
+    <k> auditCheck(C:Int) => .K </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope("$audit" |-> (9 => 0), parent(-1)) -1 |-> builtinsScope </scopes>
+    requires C <Int 65
