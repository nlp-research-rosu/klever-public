+        "result" |-> str(
+          removeVowelCodesAcc(
+            seqConcat(ACC, iCons(C, .IntSeq)),
+            REST))
+        "char" |-> ?FINALCHAR:Val,
+        parent(0))
+      OUTER
+    ) </scopes>
+    requires notBool isVowelCode(C)
+
+  claim [entry]:
