+requires "connection-verification.k"
+
+module CONNECTION-SPEC
+  imports CONNECTION
+
+  claim [one-char-vowel-membership-true]:
+    <k>
+      strContains(iCons(C:Int, .IntSeq), auditVowelCodes)
+      =>
+      true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires auditIsVowelCode(C)
+
+  claim [one-char-vowel-membership-false]:
+    <k>
+      strContains(iCons(C:Int, .IntSeq), auditVowelCodes)
+      =>
+      false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool auditIsVowelCode(C)
+endmodule
