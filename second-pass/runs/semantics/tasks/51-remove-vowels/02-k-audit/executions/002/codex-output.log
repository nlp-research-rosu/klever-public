+requires "connection-verification.k"
+
+module CONNECTION-SPEC
+  imports CONNECTION
+
+  claim [one-char-vowel-membership-true]:
+    <k>
+      If(
+        Compare(
+          str(iCons(C:Int, .IntSeq)),
+          CmpOp("in", Str("aeiouAEIOU"))),
+        Assign(Name("$audit"), Int(1)),
+        Assign(Name("$audit"), Int(0)))
+      =>
+      .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("$audit" |-> (9 => 1), parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires auditIsVowelCode(C)
+
+  claim [one-char-vowel-membership-false]:
+    <k>
+      If(
+        Compare(
+          str(iCons(C:Int, .IntSeq)),
+          CmpOp("in", Str("aeiouAEIOU"))),
+        Assign(Name("$audit"), Int(1)),
+        Assign(Name("$audit"), Int(0)))
+      =>
+      .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("$audit" |-> (9 => 0), parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool auditIsVowelCode(C)
+endmodule
diff --git a//tmp/audit-work/reconstruction/connection-verification.k b//tmp/audit-work/reconstruction/connection-verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..8f879c6fb8d4839c8f40c239770d6c4354f0201f
--- /dev/null
+++ b//tmp/audit-work/reconstruction/connection-verification.k
@@ -0,0 +1,17 @@
+requires "reference-semantics/semantics.k"
+
+module CONNECTION
+  imports MPY
+
+  syntax IntSeq ::= "auditVowelCodes" [macro]
+  rule auditVowelCodes
+    => iCons(97, iCons(101, iCons(105, iCons(111, iCons(117,
+       iCons(65, iCons(69, iCons(73, iCons(79, iCons(85, .IntSeq))))))))))
+
+  syntax Bool ::= auditIsVowelCode(Int) [function, total]
+  rule auditIsVowelCode(C:Int)
+    => C ==Int 65  orBool C ==Int 69  orBool C ==Int 73
+       orBool C ==Int 79  orBool C ==Int 85  orBool C ==Int 97
+       orBool C ==Int 101 orBool C ==Int 105 orBool C ==Int 111
+       orBool C ==Int 117
+endmodule
