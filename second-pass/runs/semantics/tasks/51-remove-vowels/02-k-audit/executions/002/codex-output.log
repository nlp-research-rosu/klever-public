+        parent(0))
+      OUTER:Map
+      =>
+      CALLEE |-> scope(
+        "text" |-> str(TEXT)
+        "result" |-> str(
+          removeVowelCodesAcc(
+            seqConcat(ACC, iCons(C, .IntSeq)),
+            REST))
+        "char" |-> ?FINALCHAR:Val,
+        parent(0))
+      OUTER
+    ) </scopes>
+    requires notBool isVowelCode(C)
+
+  claim [entry]:
