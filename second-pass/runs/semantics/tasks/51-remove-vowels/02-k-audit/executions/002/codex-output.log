+    <env> CALLEE:Int </env>
+    <scopes> (
+      CALLEE |-> scope(
+        "text" |-> str(TEXT:IntSeq)
+        "result" |-> str(ACC:IntSeq)
+        "char" |-> CHAR:Val,
+        parent(0))
+      OUTER:Map
+      =>
+      CALLEE |-> scope(
+        "text" |-> str(TEXT)
+        "result" |-> str(ACC)
+        "char" |-> CHAR,
+        parent(0))
+      OUTER
