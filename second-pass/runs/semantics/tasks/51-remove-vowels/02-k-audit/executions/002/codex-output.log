+#!/usr/bin/env bash
+set -u
+
+if (( $# < 2 )); then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_path=$1
+shift
+tmp_path=$(mktemp /tmp/audit-command.XXXXXX)
+
+set +e
+"$@" >"$tmp_path" 2>&1
+command_status=$?
+set -e
+
