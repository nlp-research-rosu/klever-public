Module(
  FuncDef("remove_vowels", Params("text"),
    Assign(Name("result"), Str(""))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("text"),
      If(Compare(Name("char"), CmpOp("not in", Str("aeiouAEIOU"))),
        AugAssign(Name("result"), "+", Name("char")),
        ))
    Return(Name("result")))
  Assert(
    Compare(Call(Name("remove_vowels"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(Call(Name("remove_vowels"), Str("a")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("remove_vowels"), Str("b")),
      CmpOp("==", Str("b"))))
  Assert(
    Compare(
      Call(Name("remove_vowels"), Str("abEcdU")),
      CmpOp("==", Str("bcd")))))
