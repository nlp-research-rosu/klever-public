      "start_line": 7,
      "text": "  rule vowelCodes\n    => iCons(97, iCons(101, iCons(105, iCons(111, iCons(117,\n       iCons(65, iCons(69, iCons(73, iCons(79, iCons(85, .IntSeq))))))))))"
    },
    {
      "attributes": [],
      "end_line": 16,
      "module": "VERIFICATION",
      "normalized_sha256": "c967809d7c1f7190c8ad73e7c196724ba72b22ff8161f4b280ffeb5eec91a81e",
      "source_rule_id": "rule-c967809d7c1f7190c8ad73e7c196724ba72b22ff8161f4b280ffeb5eec91a81e",
      "start_line": 12,
      "text": "  rule isVowelCode(C:Int)\n    => C ==Int 65  orBool C ==Int 69  orBool C ==Int 73\n       orBool C ==Int 79  orBool C ==Int 85  orBool C ==Int 97\n       orBool C ==Int 101 orBool C ==Int 105 orBool C ==Int 111\n       orBool C ==Int 117"
    },
    {
      "attributes": [
        "priority(40)"
      ],
      "end_line": 23,
      "module": "VERIFICATION",
      "normalized_sha256": "94d2fdc35d3fdf3c396f6195fb860162747c2dc403f48fae46276855a3075f93",
      "source_rule_id": "rule-94d2fdc35d3fdf3c396f6195fb860162747c2dc403f48fae46276855a3075f93",
      "start_line": 21,
      "text": "  rule strContains(iCons(C:Int, .IntSeq), vowelCodes)\n    => isVowelCode(C)\n    [priority(40)]"
    },
    {
      "attributes": [],
      "end_line": 26,
      "module": "VERIFICATION",
      "normalized_sha256": "97869f576bcf072c1e721ed24f69ba5c2404fb7d8241edd4bd0cbf2adf281b44",
      "source_rule_id": "rule-97869f576bcf072c1e721ed24f69ba5c2404fb7d8241edd4bd0cbf2adf281b44",
      "start_line": 26,
      "text": "  rule removeVowelCodesAcc(ACC:IntSeq, .IntSeq) => ACC"
    },
    {
      "attributes": [],
      "end_line": 29,
      "module": "VERIFICATION",
      "normalized_sha256": "df6da58f7a0c1c0940d1bd577e8a42fc8ff60217334b4e9bd2e5a09b1823c83d",
      "source_rule_id": "rule-df6da58f7a0c1c0940d1bd577e8a42fc8ff60217334b4e9bd2e5a09b1823c83d",
      "start_line": 27,
      "text": "  rule removeVowelCodesAcc(ACC:IntSeq, iCons(C:Int, REST:IntSeq))\n    => removeVowelCodesAcc(ACC, REST)\n    requires isVowelCode(C)"
    },
    {
      "attributes": [],
      "end_line": 34,
      "module": "VERIFICATION",
      "normalized_sha256": "8ec35c1199777440cd8b9746f870473e6535a49693f2fb23e096ec49b033f27c",
      "source_rule_id": "rule-8ec35c1199777440cd8b9746f870473e6535a49693f2fb23e096ec49b033f27c",
      "start_line": 30,
      "text": "  rule removeVowelCodesAcc(ACC:IntSeq, iCons(C:Int, REST:IntSeq))\n    => removeVowelCodesAcc(\n         seqConcat(ACC, iCons(C, .IntSeq)),\n         REST)\n    requires notBool isVowelCode(C)"
    },
    {
      "attributes": [],
      "end_line": 38,
      "module": "VERIFICATION",
      "normalized_sha256": "e49f3d3c6e39dc85fb288d725af9349d2df4de5586b32a1b424f814fac9349eb",
      "source_rule_id": "rule-e49f3d3c6e39dc85fb288d725af9349d2df4de5586b32a1b424f814fac9349eb",
      "start_line": 37,
      "text": "  rule removeVowelCodes(CODES:IntSeq)\n    => removeVowelCodesAcc(.IntSeq, CODES)"
    },
    {
      "attributes": [],
      "end_line": 44,
      "module": "VERIFICATION",
      "normalized_sha256": "a9e187a09a57d67c0d8c745e6d6ada346f64b15ef44e8ec7b86c0a2433ed155c",
      "source_rule_id": "rule-a9e187a09a57d67c0d8c745e6d6ada346f64b15ef44e8ec7b86c0a2433ed155c",
      "start_line": 41,
      "text": "  rule removeVowelsLoopBody\n    => If(Compare(Name(\"char\"), CmpOp(\"not in\", Str(\"aeiouAEIOU\"))),\n         AugAssign(Name(\"result\"), \"+\", Name(\"char\")),\n         .Stmts)"
    },
    {
      "attributes": [],
      "end_line": 51,
      "module": "VERIFICATION",
      "normalized_sha256": "5394773feede596d124dfa31cfc1aa168d372d38c5862101ecba343ac2ca9a0a",
      "source_rule_id": "rule-5394773feede596d124dfa31cfc1aa168d372d38c5862101ecba343ac2ca9a0a",
      "start_line": 47,
      "text": "  rule removeVowelsBody\n    => Assign(Name(\"result\"), Str(\"\"))\n       Assign(Name(\"char\"), Str(\"\"))\n       For(Name(\"char\"), Name(\"text\"), removeVowelsLoopBody)\n       Return(Name(\"result\"))"
    },
    {
      "attributes": [],
      "end_line": 56,
      "module": "VERIFICATION",
      "normalized_sha256": "1c6bbd7732f50537067c061cd7f506047f5635d0143334615f896552cdfe5711",
      "source_rule_id": "rule-1c6bbd7732f50537067c061cd7f506047f5635d0143334615f896552cdfe5711",
      "start_line": 54,
      "text": "  rule removeVowelsProgram\n    => Module(\n         FuncDef(\"remove_vowels\", Params(\"text\"), removeVowelsBody))"
    }
  ],
