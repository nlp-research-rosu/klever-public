Module(
  FuncDef("remove_vowels", Params("text"),
    Assign(Name("result"), Str(""))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("text"),
      If(Compare(Name("char"), CmpOp("not in", Str("aeiouAEIOU"))),
        AugAssign(Name("result"), "+", Name("char")),
        ))
    Return(Name("result")))
  Assert(
    Compare(Call(Name("remove_vowels"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("remove_vowels"), Str("abcdef\nghijklm")),
      CmpOp("==", Str("bcdf\nghjklm"))))
  Assert(
    Compare(
      Call(Name("remove_vowels"), Str("abcdef")),
      CmpOp("==", Str("bcdf"))))
  Assert(
    Compare(
      Call(Name("remove_vowels"), Str("aaaaa")),
      CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("remove_vowels"), Str("aaBAA")),
      CmpOp("==", Str("B"))))
  Assert(
    Compare(
      Call(Name("remove_vowels"), Str("zbcd")),
      CmpOp("==", Str("zbcd")))))
