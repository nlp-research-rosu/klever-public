--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete-tests.mpy --definition runtime-kompiled
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k --definition verification-kompiled
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..cc159eff49f98ece525feb44b1b755562be44f18
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,7 @@
+def remove_vowels(text):
+    result = ""
+    char = ""
+    for char in text:
+        if char not in "aeiouAEIOU":
+            result += char
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5db457dc22c9aa65d90408e6a6395e01c1de09d6
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,114 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim
+    <k> (
+      #loop(
+        str(.IntSeq),
+        Name("char"),
+        removeVowelsLoopBody)
+      =>
+      .K
+    ) ... </k>
+    <env> CALLEE:Int </env>
+    <scopes> (
+      CALLEE |-> scope(
+        "text" |-> str(TEXT:IntSeq)
+        "result" |-> str(ACC:IntSeq)
+        "char" |-> CHAR:Val,
+        parent(0))
+      OUTER:Map
+      =>
+      CALLEE |-> scope(
+        "text" |-> str(TEXT)
+        "result" |-> str(ACC)
+        "char" |-> CHAR,
+        parent(0))
+      OUTER
+    ) </scopes>
+
+  claim
+    <k> (
+      #loop(
+        str(iCons(C:Int, REST:IntSeq)),
+        Name("char"),
+        removeVowelsLoopBody)
+      =>
+      .K
+    ) ... </k>
+    <env> CALLEE:Int </env>
+    <scopes> (
+      CALLEE |-> scope(
+        "text" |-> str(TEXT:IntSeq)
+        "result" |-> str(ACC:IntSeq)
+        "char" |-> CHAR:Val,
+        parent(0))
+      OUTER:Map
+      =>
+      CALLEE |-> scope(
+        "text" |-> str(TEXT)
+        "result" |-> str(removeVowelCodesAcc(ACC, REST))
+        "char" |-> ?FINALCHAR:Val,
+        parent(0))
+      OUTER
+    ) </scopes>
+    requires isVowelCode(C)
+
+  claim
+    <k> (
+      #loop(
+        str(iCons(C:Int, REST:IntSeq)),
+        Name("char"),
+        removeVowelsLoopBody)
+      =>
+      .K
+    ) ... </k>
+    <env> CALLEE:Int </env>
+    <scopes> (
+      CALLEE |-> scope(
+        "text" |-> str(TEXT:IntSeq)
+        "result" |-> str(ACC:IntSeq)
+        "char" |-> CHAR:Val,
+        parent(0))
+      OUTER:Map
+      =>
+      CALLEE |-> scope(
+        "text" |-> str(TEXT)
+        "result" |-> str(
+          removeVowelCodesAcc(
+            seqConcat(ACC, iCons(C, .IntSeq)),
+            REST))
+        "char" |-> ?FINALCHAR:Val,
+        parent(0))
+      OUTER
+    ) </scopes>
+    requires notBool isVowelCode(C)
+
+  claim
+    <k>
+      #loadAll(removeVowelsProgram)
+      ~> Call(Name("remove_vowels"), str(CODES:IntSeq))
+      =>
+      str(removeVowelCodes(CODES))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "remove_vowels" |->
+          closureVal(("text", .ParamNames), removeVowelsBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ddd7e64c22380f51b60c838e2123bc40a12f7614
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,57 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  syntax IntSeq ::= "vowelCodes" [macro]
+  rule vowelCodes
+    => iCons(97, iCons(101, iCons(105, iCons(111, iCons(117,
+       iCons(65, iCons(69, iCons(73, iCons(79, iCons(85, .IntSeq))))))))))
+
+  syntax Bool ::= isVowelCode(Int) [function, total]
+  rule isVowelCode(C:Int)
+    => C ==Int 65  orBool C ==Int 69  orBool C ==Int 73
+       orBool C ==Int 79  orBool C ==Int 85  orBool C ==Int 97
+       orBool C ==Int 101 orBool C ==Int 105 orBool C ==Int 111
+       orBool C ==Int 117
+
+  // This is a proved-by-definition specialization of MPY-STR's substring
+  // search for a one-character needle and this fixed ten-character haystack.
+  // It prevents symbolic execution from forking once per haystack position.
+  rule strContains(iCons(C:Int, .IntSeq), vowelCodes)
+    => isVowelCode(C)
+    [priority(40)]
+
+  syntax IntSeq ::= removeVowelCodesAcc(IntSeq, IntSeq) [function, total]
+  rule removeVowelCodesAcc(ACC:IntSeq, .IntSeq) => ACC
+  rule removeVowelCodesAcc(ACC:IntSeq, iCons(C:Int, REST:IntSeq))
+    => removeVowelCodesAcc(ACC, REST)
+    requires isVowelCode(C)
+  rule removeVowelCodesAcc(ACC:IntSeq, iCons(C:Int, REST:IntSeq))
+    => removeVowelCodesAcc(
+         seqConcat(ACC, iCons(C, .IntSeq)),
+         REST)
+    requires notBool isVowelCode(C)
+
+  syntax IntSeq ::= removeVowelCodes(IntSeq) [function, total]
+  rule removeVowelCodes(CODES:IntSeq)
+    => removeVowelCodesAcc(.IntSeq, CODES)
+
+  syntax Stmts ::= "removeVowelsLoopBody" [macro]
+  rule removeVowelsLoopBody
+    => If(Compare(Name("char"), CmpOp("not in", Str("aeiouAEIOU"))),
+         AugAssign(Name("result"), "+", Name("char")),
+         .Stmts)
+
+  syntax Stmts ::= "removeVowelsBody" [macro]
+  rule removeVowelsBody
+    => Assign(Name("result"), Str(""))
+       Assign(Name("char"), Str(""))
+       For(Name("char"), Name("text"), removeVowelsLoopBody)
+       Return(Name("result"))
+
+  syntax Module ::= "removeVowelsProgram" [macro]
+  rule removeVowelsProgram
+    => Module(
+         FuncDef("remove_vowels", Params("text"), removeVowelsBody))
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..501921c98d6fae9df767cebdbd6596c87d31c181
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,15 @@
+def remove_vowels(text):
+    result = ""
+    char = ""
+    for char in text:
+        if char not in "aeiouAEIOU":
+            result += char
+    return result
+
+
+assert remove_vowels("") == ""
+assert remove_vowels("abcdef\nghijklm") == "bcdf\nghjklm"
+assert remove_vowels("abcdef") == "bcdf"
+assert remove_vowels("aaaaa") == ""
+assert remove_vowels("aaBAA") == "B"
+assert remove_vowels("zbcd") == "zbcd"
