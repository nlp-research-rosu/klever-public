@@ -0,0 +1,6 @@
+def remove_vowels(text):
+    result = ""
+    for char in text:
+        if char not in "aeiouAEIOU":
+            result += char
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5102057799a765bb44afaa6f49b492ce936f3495
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,69 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim
+    <k>
+      #loop(
+        str(CODES:IntSeq),
+        Name("char"),
+        removeVowelsLoopBody)
+      ~> Return(Name("result"))
+      ~> #endcall
+      =>
+      str(removeVowelCodesAcc(ACC:IntSeq, CODES))
+      ~> CONT:K
+    </k>
+    <env> CALLEE:Int => CALLER:Int </env>
+    <scopes>
+      CALLEE |-> scope(
+        "result" |-> str(ACC)
+        LOCAL:Map,
+        PARENT:Parent)
+      OUTER:Map
+      =>
+      OUTER
+    </scopes>
+    <scopeLoc> CURRENT:Int => SAVED:Int </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, SAVED)) REST:List
+      =>
+      REST
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> EXIT:Int </exit-code>
+    requires notBool (
+      "$cells" in_keys (
+        "result" |-> str(ACC)
+        LOCAL))
+
+  claim
+    <k>
+      #loadAll(removeVowelsProgram)
+      ~> Call(Name("remove_vowels"), str(CODES:IntSeq))
+      =>
+      str(removeVowelCodes(CODES))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "remove_vowels" |->
+          closureVal(("text", .ParamNames), removeVowelsBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
