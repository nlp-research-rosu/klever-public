index 0000000000000000000000000000000000000000..5c536f3b385ca2a543696d2f544435cbdf49c582
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim
+    <k>
+      #loadAll(removeVowelsProgram)
+      ~> Call(Name("remove_vowels"), str(CODES:IntSeq))
+      =>
+      str(removeVowelCodes(CODES))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "remove_vowels" |->
+          closureVal(("text", .ParamNames), removeVowelsBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..7915a9e8bced3498df0fac02820a2eefddea5fde
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,33 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  syntax IntSeq ::= "vowelCodes" [function, total]
+  rule vowelCodes
+    => iCons(97, iCons(101, iCons(105, iCons(111, iCons(117,
+       iCons(65, iCons(69, iCons(73, iCons(79, iCons(85, .IntSeq))))))))))
+
+  syntax IntSeq ::= removeVowelCodes(IntSeq) [function, total]
+  rule removeVowelCodes(.IntSeq) => .IntSeq
+  rule removeVowelCodes(iCons(C:Int, REST:IntSeq))
+    => removeVowelCodes(REST)
+    requires strContains(iCons(C, .IntSeq), vowelCodes)
+  rule removeVowelCodes(iCons(C:Int, REST:IntSeq))
+    => iCons(C, removeVowelCodes(REST))
+    requires notBool strContains(iCons(C, .IntSeq), vowelCodes)
+
+  syntax Stmts ::= "removeVowelsBody" [macro]
+  rule removeVowelsBody
+    => Assign(Name("result"), Str(""))
+       For(Name("char"), Name("text"),
+         If(Compare(Name("char"), CmpOp("not in", Str("aeiouAEIOU"))),
+           AugAssign(Name("result"), "+", Name("char")),
+           .Stmts))
+       Return(Name("result"))
+
+  syntax Module ::= "removeVowelsProgram" [macro]
+  rule removeVowelsProgram
+    => Module(
+         FuncDef("remove_vowels", Params("text"), removeVowelsBody))
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..44ec75fc14a33128c2ded87c414c4d12a3cb1c14
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def remove_vowels(text):
+    result = ""
+    for char in text:
+        if char not in "aeiouAEIOU":
+            result += char
+    return result
