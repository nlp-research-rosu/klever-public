diff --git a//tmp/lean-hostpid.c b//tmp/lean-hostpid.c
new file mode 100644
index 0000000000000000000000000000000000000000..27ce3219612d844c871a4517550d41a657725cb7
--- /dev/null
+++ b//tmp/lean-hostpid.c
@@ -0,0 +1,24 @@
+#define _GNU_SOURCE
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+    char buffer[4096];
+    int fd = open("/proc/self/status", O_RDONLY);
+    if (fd >= 0) {
+        ssize_t count = read(fd, buffer, sizeof(buffer) - 1);
+        close(fd);
+        if (count > 0) {
+            buffer[count] = '\0';
+            char *line = strstr(buffer, "\nPid:");
+            if (line != NULL) {
+                return (pid_t)strtol(line + 5, NULL, 10);
+            }
+        }
+    }
+    return (pid_t)syscall(SYS_getpid);
+}
