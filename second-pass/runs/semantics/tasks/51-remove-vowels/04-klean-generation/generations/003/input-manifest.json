      "normalized_sha256": "94d2fdc35d3fdf3c396f6195fb860162747c2dc403f48fae46276855a3075f93",
      "rationale": "Specializes the reference semantics' existing strContains function for a one-character needle and vowelCodes; it is an additional equivalence compiled into the proof definition before kprove and is not separately proved without the rule.",
      "source_rule_id": "rule-94d2fdc35d3fdf3c396f6195fb860162747c2dc403f48fae46276855a3075f93",
      "start_line": 21,
      "text": "  rule strContains(iCons(C:Int, .IntSeq), vowelCodes)\n    => isVowelCode(C)\n    [priority(40)]"
    }
