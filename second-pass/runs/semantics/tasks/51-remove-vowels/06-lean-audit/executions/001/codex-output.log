+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char proc_path[64];
+  snprintf(proc_path, sizeof(proc_path), "/proc/%ld/exe", (long)getpid());
+  char buffer[PATH_MAX + 1];
+  ssize_t count = readlink(proc_path, buffer, PATH_MAX);
+  if (count < 0) {
+    printf("readlink errno=%d %s\n", errno, strerror(errno));
+  } else {
+    buffer[count] = '\0';
+    printf("readlink=%s\n", buffer);
+  }
+  char *resolved = realpath(proc_path, NULL);
+  if (resolved == NULL) {
+    printf("realpath errno=%d %s\n", errno, strerror(errno));
+  } else {
+    printf("realpath=%s\n", resolved);
+    free(resolved);
+  }
+  return 0;
+}
diff --git a//tmp/audit-work/lean_proc_exe_compat.c b//tmp/audit-work/lean_proc_exe_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..0a22f5b50a5a52b5e6bed8111fa96ed6e99a29b7
--- /dev/null
+++ b//tmp/audit-work/lean_proc_exe_compat.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink = NULL;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    if (real_readlink == NULL) {
+      errno = ENOSYS;
+      return -1;
+    }
+  }
+
+  char expected[64];
+  int length = snprintf(expected, sizeof(expected), "/proc/%ld/exe",
+                        (long)getpid());
+  if (length > 0 && (size_t)length < sizeof(expected) &&
+      strcmp(path, expected) == 0) {
+    return real_readlink("/proc/self/exe", buffer, size);
+  }
+  return real_readlink(path, buffer, size);
+}
