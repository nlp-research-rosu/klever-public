+  Proof.«isVowelCode(_)_VERIFICATION_Bool_Int» 65,
+  Proof.«isVowelCode(_)_VERIFICATION_Bool_Int» 66,
+  Proof.«isVowelCode(_)_VERIFICATION_Bool_Int» 97,
