@@ -0,0 +1,25 @@
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char buffer[PATH_MAX + 1];
+  ssize_t count = readlink("/proc/self/exe", buffer, PATH_MAX);
+  if (count < 0) {
+    printf("readlink errno=%d %s\n", errno, strerror(errno));
+  } else {
+    buffer[count] = '\0';
+    printf("readlink=%s\n", buffer);
+  }
+  char *resolved = realpath("/proc/self/exe", NULL);
+  if (resolved == NULL) {
+    printf("realpath errno=%d %s\n", errno, strerror(errno));
+  } else {
+    printf("realpath=%s\n", resolved);
+    free(resolved);
+  }
+  return 0;
+}
