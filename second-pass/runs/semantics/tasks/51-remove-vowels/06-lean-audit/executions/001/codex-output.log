diff --git a//tmp/audit-work/app_path_diag.c b//tmp/audit-work/app_path_diag.c
new file mode 100644
index 0000000000000000000000000000000000000000..bc0921a2900821734f32e27986b3330eea7c1f82
--- /dev/null
+++ b//tmp/audit-work/app_path_diag.c
@@ -0,0 +1,27 @@
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char proc_path[64];
+  snprintf(proc_path, sizeof(proc_path), "/proc/%ld/exe", (long)getpid());
+  char buffer[PATH_MAX + 1];
+  ssize_t count = readlink(proc_path, buffer, PATH_MAX);
+  if (count < 0) {
+    printf("readlink errno=%d %s\n", errno, strerror(errno));
+  } else {
+    buffer[count] = '\0';
+    printf("readlink=%s\n", buffer);
+  }
+  char *resolved = realpath(proc_path, NULL);
+  if (resolved == NULL) {
+    printf("realpath errno=%d %s\n", errno, strerror(errno));
+  } else {
+    printf("realpath=%s\n", resolved);
+    free(resolved);
+  }
+  return 0;
+}
