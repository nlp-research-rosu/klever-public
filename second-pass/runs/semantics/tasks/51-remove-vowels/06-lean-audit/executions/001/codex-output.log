            definition = scratch / "kompiled"
            command = [
                "kompile",
                str(export_k),
                "--backend",
                "haskell",
                "--main-module",
                export_module_name,
                "--syntax-module",
                resolution.syntax_module,
                "--output-definition",
                str(definition),
            ]
            code, output = run_command(
                command,

