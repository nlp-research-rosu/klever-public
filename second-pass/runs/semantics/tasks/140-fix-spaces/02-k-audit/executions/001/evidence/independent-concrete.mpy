Module(
  FuncDef("fix_spaces", Params("text"),
    Assign(Name("result"), Str(""))
    Assign(Name("spaces"), Int(0))
    Assign(Name("char"), Str(""))
    For(Name("char"), Name("text"),
      If(BinOp("-", Call(Name("ord"), Name("char")), Int(32)),
        If(Compare(Name("spaces"), CmpOp(">", Int(2))),
          AugAssign(Name("result"), "+", Str("-")),
          If(Compare(Name("spaces"), CmpOp("==", Int(1))),
            AugAssign(Name("result"), "+", Str("_")),
            If(Compare(Name("spaces"), CmpOp("==", Int(2))),
              AugAssign(Name("result"), "+", Str("__")),
              )))
        AugAssign(Name("result"), "+", Name("char"))
        Assign(Name("spaces"), Int(0)),
        AugAssign(Name("spaces"), "+", Int(1))))
    If(Compare(Name("spaces"), CmpOp(">", Int(2))),
      AugAssign(Name("result"), "+", Str("-")),
      If(Compare(Name("spaces"), CmpOp("==", Int(1))),
        AugAssign(Name("result"), "+", Str("_")),
        If(Compare(Name("spaces"), CmpOp("==", Int(2))),
          AugAssign(Name("result"), "+", Str("__")),
          )))
    Return(Name("result")))
  Assert(
    Compare(Call(Name("fix_spaces"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str("Example")),
      CmpOp("==", Str("Example"))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str("Example 1")),
      CmpOp("==", Str("Example_1"))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str(" Example 2")),
      CmpOp("==", Str("_Example_2"))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str(" Example   3")),
      CmpOp("==", Str("_Example-3"))))
  Assert(
    Compare(Call(Name("fix_spaces"), Str(" ")), CmpOp("==", Str("_"))))
  Assert(
    Compare(Call(Name("fix_spaces"), Str("  ")), CmpOp("==", Str("__"))))
  Assert(
    Compare(Call(Name("fix_spaces"), Str("   ")), CmpOp("==", Str("-"))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str("    ")),
      CmpOp("==", Str("-"))))
  Assert(
    Compare(Call(Name("fix_spaces"), Str("a ")), CmpOp("==", Str("a_"))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str("a  ")),
      CmpOp("==", Str("a__"))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str("a   ")),
      CmpOp("==", Str("a-"))))
  Assert(
    Compare(Call(Name("fix_spaces"), Str(" a")), CmpOp("==", Str("_a"))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str("  a")),
      CmpOp("==", Str("__a"))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str("   a")),
      CmpOp("==", Str("-a"))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str("a b")),
      CmpOp("==", Str("a_b"))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str("a  b")),
      CmpOp("==", Str("a__b"))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str("a   b")),
      CmpOp("==", Str("a-b"))))
  Assert(
    Compare(
      Call(Name("fix_spaces"), Str("  a   b  ")),
      CmpOp("==", Str("__a-b__")))))
