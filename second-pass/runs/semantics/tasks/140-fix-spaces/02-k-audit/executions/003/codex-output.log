     1	def fix_spaces(text):
     2	    result = ""
     3	    spaces = 0
     4	    char = ""
     5	
     6	    for char in text:
     7	        if ord(char) - 32:
     8	            if spaces > 2:
     9	                result += "-"
    10	            elif spaces == 1:
    11	                result += "_"
    12	            elif spaces == 2:
    13	                result += "__"
    14	
    15	            result += char
    16	            spaces = 0
    17	        else:
    18	            spaces += 1
    19	
    20	    if spaces > 2:
    21	        result += "-"
    22	    elif spaces == 1:
    23	        result += "_"
    24	    elif spaces == 2:
    25	        result += "__"
    26	
    27	    return result
    28	
    29	
    30	assert fix_spaces("Example") == "Example"
    31	assert fix_spaces("Example 1") == "Example_1"
    32	assert fix_spaces(" Example 2") == "_Example_2"
    33	assert fix_spaces(" Example   3") == "_Example-3"
    34	assert fix_spaces("") == ""
    35	assert fix_spaces("  ") == "__"
    36	assert fix_spaces("   ") == "-"
    37	assert fix_spaces("      ") == "-"
    38	assert fix_spaces("a     b") == "a-b"
