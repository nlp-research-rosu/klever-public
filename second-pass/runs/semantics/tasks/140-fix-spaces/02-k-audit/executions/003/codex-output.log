@@ -0,0 +1,106 @@
+requires "verification.k"
+
+module TAIL-CONTEXT-SPEC
+  imports FIX-SPACES-BASE
+
+  claim
+    <k>
+      fixSpacesTailStmt
+      ~> Assign(Name("result"), Str("Z"))
+      =>
+      .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |->
+        scope(
+          ("text"   |-> str(.IntSeq))
+          ("result" |-> str(.IntSeq))
+          ("spaces" |-> 2)
+          ("char"   |-> str(.IntSeq)),
+          parent(0)))
+      (0 |-> scope("fix_spaces" |-> noneV, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
