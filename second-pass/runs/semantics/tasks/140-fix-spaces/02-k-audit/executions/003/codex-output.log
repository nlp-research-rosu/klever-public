    42	    [simplification]
    43	  rule fixSpacesLoop(A:IntSeq, iCons(C:Int, R:IntSeq), N:Int)
    44	    => fixSpacesLoop(
    45	         seqConcat(appendPending(A, N), iCons(C, .IntSeq)),
    46	         R,
    47	         0)
    48	    requires C =/=Int 32
    49	    [simplification]
    50	
    51	  // The two remaining pieces of loop state are specified as folds too.  They
    52	  // let the loop lemma describe the exact final local frame, not just result.
    53	  syntax Int ::= trailingSpaces(IntSeq, Int) [function, total]
    54	  rule trailingSpaces(.IntSeq, N:Int) => N
    55	  rule trailingSpaces(iCons(32, R:IntSeq), N:Int)
    56	    => trailingSpaces(R, N +Int 1)
    57	    [simplification]
    58	  rule trailingSpaces(iCons(C:Int, R:IntSeq), _:Int)
    59	    => trailingSpaces(R, 0)
    60	    requires C =/=Int 32
    61	    [simplification]
    62	
    63	  syntax IntSeq ::= finalChar(IntSeq, IntSeq) [function, total]
    64	  rule finalChar(.IntSeq, CH:IntSeq) => CH
    65	  rule finalChar(iCons(C:Int, R:IntSeq), _:IntSeq)
    66	    => finalChar(R, iCons(C, .IntSeq))
    67	
    68	  // Constructor terms copied exactly from solution.mpy, factored only to keep
    69	  // the proof rule and claims readable.
    70	  syntax Stmt ::= "fixSpacesLoopBodyStmt" [macro]
    71	  rule fixSpacesLoopBodyStmt
    72	    => If(
    73	         BinOp(
    74	           "-",
    75	           Call(Name("ord"), Name("char")),
    76	           Int(32)),
    77	         If(Compare(Name("spaces"), CmpOp(">", Int(2))),
    78	           AugAssign(Name("result"), "+", Str("-")),
    79	           If(
    80	             Compare(Name("spaces"), CmpOp("==", Int(1))),
    81	             AugAssign(Name("result"), "+", Str("_")),
    82	             If(
    83	               Compare(Name("spaces"), CmpOp("==", Int(2))),
    84	               AugAssign(Name("result"), "+", Str("__")),
    85	               .Stmts)))
    86	         AugAssign(Name("result"), "+", Name("char"))
    87	         Assign(Name("spaces"), Int(0)),
    88	         AugAssign(Name("spaces"), "+", Int(1)))
    89	
    90	  syntax Stmts ::= "fixSpacesLoopBody" [macro]
    91	  rule fixSpacesLoopBody => fixSpacesLoopBodyStmt
    92	
    93	  syntax Stmt ::= "fixSpacesTailStmt" [macro]
    94	  rule fixSpacesTailStmt
    95	    => If(
    96	         Compare(Name("spaces"), CmpOp(">", Int(2))),
    97	         AugAssign(Name("result"), "+", Str("-")),
    98	         If(
    99	           Compare(Name("spaces"), CmpOp("==", Int(1))),
   100	           AugAssign(Name("result"), "+", Str("_")),
   101	           If(
   102	             Compare(Name("spaces"), CmpOp("==", Int(2))),
   103	             AugAssign(Name("result"), "+", Str("__")),
   104	             .Stmts))
   105	         )
   106	
   107	  syntax Stmts ::= "fixSpacesTail" [macro]
   108	  rule fixSpacesTail => fixSpacesTailStmt
