   110	  syntax Stmts ::= "fixSpacesFunctionBody" [macro]
   111	  rule fixSpacesFunctionBody
   112	    => Assign(Name("result"), Str(""))
   113	       Assign(Name("spaces"), Int(0))
   114	       Assign(Name("char"), Str(""))
   115	       For(Name("char"), Name("text"), fixSpacesLoopBody)
