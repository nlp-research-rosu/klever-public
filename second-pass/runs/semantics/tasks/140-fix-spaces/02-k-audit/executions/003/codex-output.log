+          ("text"   |-> str(.IntSeq))
+          ("result" |-> str(.IntSeq))
+          ("spaces" |-> 2)
+          ("char"   |-> str(.IntSeq)),
+          parent(0)))
+      (0 |-> scope("fix_spaces" |-> noneV, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (1 |->
+        scope(
+          ("text"   |-> str(.IntSeq))
+          ("result" |-> str(iCons(90, .IntSeq)))
+          ("spaces" |-> 2)
+          ("char"   |-> str(.IntSeq)),
+          parent(0)))
+      (0 |-> scope("fix_spaces" |-> noneV, parent(-1)))
+      (-1 |-> builtinsScope)
