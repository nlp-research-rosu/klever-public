+      (-1 |-> builtinsScope)
+      =>
+      (1 |->
+        scope(
+          ("text"   |-> str(iCons(97, .IntSeq)))
+          ("result" |-> str(iCons(97, .IntSeq)))
+          ("spaces" |-> 0)
+          ("char"   |-> str(iCons(97, .IntSeq))),
+          parent(0)))
+      (0 |->
+        scope(
+          ("fix_spaces" |-> noneV)
+          ("ord" |-> closureVal("x", Return(Int(32)), 0)),
+          parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
