+      .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |->
+        scope(
+          ("text"   |-> str(.IntSeq))
+          ("result" |-> str(.IntSeq))
+          ("spaces" |-> 2)
+          ("char"   |-> str(.IntSeq)),
+          parent(0)))
+      (0 |-> scope("fix_spaces" |-> noneV, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
