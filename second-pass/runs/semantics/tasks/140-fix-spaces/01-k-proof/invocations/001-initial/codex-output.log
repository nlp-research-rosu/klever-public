exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module FIX-SPACES-VERIFICATION --syntax-module MPY-SYNTAX --output-definition proof-main-kompiled' in /work
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..6f0d432c371502b40adfda93f6363ec8ebc28db7
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,27 @@
+def fix_spaces(text):
+    result = ""
+    spaces = 0
+    char = ""
+
+    for char in text:
+        if ord(char) - 32:
+            if spaces > 2:
+                result += "-"
+            elif spaces == 1:
+                result += "_"
+            elif spaces == 2:
+                result += "__"
+
+            result += char
+            spaces = 0
+        else:
+            spaces += 1
+
+    if spaces > 2:
+        result += "-"
+    elif spaces == 1:
+        result += "_"
+    elif spaces == 2:
+        result += "__"
+
+    return result
