+// The space and non-space body cases are proved in FIX-SPACES-STEP-SPEC.
+module FIX-SPACES-STEP-VERIFICATION
+  imports FIX-SPACES-FLUSH-VERIFICATION
+
+  rule
+    <k> fixSpacesLoopBodyStmt => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(iCons(32, .IntSeq))),
+          parent(0)))
+      (0 |-> MODULE:Scope)
+      (-1 |-> BUILTINS:Scope)
+      =>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(A))
+          ("spaces" |-> N +Int 1)
+          ("char"   |-> str(iCons(32, .IntSeq))),
+          parent(0)))
+      (0 |-> MODULE)
+      (-1 |-> BUILTINS)
+    </scopes>
+    requires N >=Int 0
+    [priority(20)]
+
+  rule
+    <k> fixSpacesLoopBodyStmt => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(iCons(C:Int, .IntSeq))),
+          parent(0)))
+      (0 |-> MODULE:Scope)
+      (-1 |-> BUILTINS:Scope)
+      =>
