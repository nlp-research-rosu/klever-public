+      1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> 2)
+          ("char"   |-> str(CH:IntSeq)),
+          parent(0))
+      =>
+      1 |->
+        scope(
+          ("text"   |-> str(TEXT))
