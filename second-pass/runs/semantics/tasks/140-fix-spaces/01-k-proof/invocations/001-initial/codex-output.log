+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |->
+            str(
+              seqConcat(
+                A,
+                iCons(95, iCons(95, .IntSeq)))))
+          ("spaces" |-> 2)
+          ("char"   |-> str(CH)),
+          parent(0))
+      ...
+    </scopes>
+
+  claim [flush-many]:
+    <k> fixSpacesTailStmt => .K </k>
+    <env> 1 </env>
+    <scopes>
+      ...
+      1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(CH:IntSeq)),
