+// This module promotes the separately proved loop claim to a proof-only
+// summary rule.  It is never imported by the LLVM concrete definition.
+module FIX-SPACES-VERIFICATION
+  imports FIX-SPACES-BASE
+
+  rule
+    <k>
+      #loop(str(IS:IntSeq), Name("char"), fixSpacesLoopBody)
+      ~> fixSpacesTail
+      =>
+      .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(CH:IntSeq)),
+          parent(0))
+      =>
+      L |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(fixSpacesLoop(A, IS, N)))
+          ("spaces" |-> trailingSpaces(IS, N))
+          ("char"   |-> str(finalChar(IS, CH))),
+          parent(0))
+      ...
+    </scopes>
+    requires N >=Int 0
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..a25b2fa91ef300d6b38c0025ad62ee20a192ea1c
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,27 @@
+def fix_spaces(text):
+    result = ""
+    spaces = 0
+    char = ""
+
+    for char in text:
+        if char == " ":
+            spaces += 1
+        else:
+            if spaces > 2:
+                result += "-"
+            elif spaces == 1:
+                result += "_"
+            elif spaces == 2:
+                result += "__"
+
+            result += char
+            spaces = 0
+
+    if spaces > 2:
+        result += "-"
+    elif spaces == 1:
+        result += "_"
+    elif spaces == 2:
+        result += "__"
+
+    return result
