+
+  claim [flush-many]:
+    <k> fixSpacesTailStmt => .K </k>
+    <env> 1 </env>
+    <scopes>
+      ...
+      1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(CH:IntSeq)),
+          parent(0))
+      =>
+      1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(seqConcat(A, iCons(45, .IntSeq))))
+          ("spaces" |-> N)
+          ("char"   |-> str(CH)),
+          parent(0))
