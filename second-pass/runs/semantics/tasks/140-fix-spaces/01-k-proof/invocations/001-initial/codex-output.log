+        scope(
+          "fix_spaces" |->
+            closureVal("text", fixSpacesFunctionBody, 0),
+          parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
