+          ("spaces" |-> N)
+          ("char"   |-> str(CH)),
+          parent(0))
+      ...
+    </scopes>
+    requires N >Int 2
+endmodule
+
+module FIX-SPACES-STEP-SPEC
+  imports FIX-SPACES-FLUSH-VERIFICATION
+
+  claim [step-space]:
+    <k> fixSpacesLoopBody => .K </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(iCons(32, .IntSeq))),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION:Val,
+          parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(A))
+          ("spaces" |-> N +Int 1)
