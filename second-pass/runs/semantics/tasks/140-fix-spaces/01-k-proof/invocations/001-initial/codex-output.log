+            str(
+              seqConcat(
+                appendPending(A, N),
+                iCons(C, .IntSeq))))
+          ("spaces" |-> 0)
+          ("char"   |-> str(iCons(C, .IntSeq))),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION,
