    84	       Assign(Name("spaces"), Int(0))
    85	       Assign(Name("char"), Str(""))
    86	       For(Name("char"), Name("text"), fixSpacesLoopBody)
    87	       fixSpacesTail
    88	       Return(Name("result"))
