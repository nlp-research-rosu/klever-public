+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |->
+            str(
+              seqConcat(
+                appendPending(A, N),
+                iCons(C, .IntSeq))))
+          ("spaces" |-> 0)
+          ("char"   |-> str(iCons(C, .IntSeq))),
