new file mode 100644
index 0000000000000000000000000000000000000000..4cad683bc353153b715f3b3328ad1f9c7a79ad51
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,27 @@
+def fix_spaces(text):
+    result = ""
+    spaces = 0
+    char = ""
+
+    for char in text:
+        if ord(char) == 32:
+            spaces += 1
+        else:
+            if spaces > 2:
+                result += "-"
+            elif spaces == 1:
+                result += "_"
+            elif spaces == 2:
+                result += "__"
+
+            result += char
+            spaces = 0
+
+    if spaces > 2:
+        result += "-"
+    elif spaces == 1:
+        result += "_"
+    elif spaces == 2:
+        result += "__"
+
+    return result
