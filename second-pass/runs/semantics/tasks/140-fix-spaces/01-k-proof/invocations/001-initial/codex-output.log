+          "fix_spaces" |-> FUNCTION:Val,
+          parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(A))
+          ("spaces" |-> N +Int 1)
+          ("char"   |-> str(iCons(32, .IntSeq))),
+          parent(0)))
+      (0 |->
+        scope(
