+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(CH:IntSeq)),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION:Val,
+          parent(-1)))
+      (-1 |-> BUILTINS:Scope)
+      =>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(fixSpacesLoop(A, IS, N)))
+          ("spaces" |-> trailingSpaces(IS, N))
+          ("char"   |-> str(finalChar(IS, CH))),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION,
+          parent(-1)))
+      (-1 |->
+        scope(
+          ("ord" |-> builtinV("ord"))
+          BUILTIN_REST,
+          root))
+    </scopes>
+    requires N >=Int 0
+endmodule

