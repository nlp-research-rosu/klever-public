+          ("text"   |-> str(TEXT))
+          ("result" |-> str(seqConcat(A, iCons(45, .IntSeq))))
+          ("spaces" |-> N)
+          ("char"   |-> str(CH)),
+          parent(0))
+      ...
+    </scopes>
+    requires N >Int 2
