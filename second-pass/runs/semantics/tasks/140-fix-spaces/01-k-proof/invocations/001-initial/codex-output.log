+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(CH:IntSeq)),
+          parent(0))
+      =>
+      L |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(fixSpacesLoop(A, IS, N)))
+          ("spaces" |-> trailingSpaces(IS, N))
+          ("char"   |-> str(finalChar(IS, CH))),
+          parent(0))
+      ...
+    </scopes>
+    requires N >=Int 0
+endmodule

