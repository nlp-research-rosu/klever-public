+    </scopes>
+    requires N >=Int 0
+
+  claim [step-non-space]:
+    <k> fixSpacesLoopBodyStmt => .K </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
