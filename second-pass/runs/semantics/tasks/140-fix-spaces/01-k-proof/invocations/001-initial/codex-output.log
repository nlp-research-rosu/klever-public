+  // let the loop lemma describe the exact final local frame, not just result.
+  syntax Int ::= trailingSpaces(IntSeq, Int) [function, total]
+  rule trailingSpaces(.IntSeq, N:Int) => N
+  rule trailingSpaces(iCons(32, R:IntSeq), N:Int)
+    => trailingSpaces(R, N +Int 1)
+    [simplification]
+  rule trailingSpaces(iCons(C:Int, R:IntSeq), _:Int)
+    => trailingSpaces(R, 0)
+    requires C =/=Int 32
+    [simplification]
+
+  syntax IntSeq ::= finalChar(IntSeq, IntSeq) [function, total]
+  rule finalChar(.IntSeq, CH:IntSeq) => CH
+  rule finalChar(iCons(C:Int, R:IntSeq), _:IntSeq)
+    => finalChar(R, iCons(C, .IntSeq))
+
+  // Constructor terms copied exactly from solution.mpy, factored only to keep
+  // the proof rule and claims readable.
+  syntax Stmts ::= "fixSpacesLoopBody" [macro]
+  rule fixSpacesLoopBody
+    => If(
+         Compare(
+           Call(Name("ord"), Name("char")),
+           CmpOp("==", Int(32))),
+         AugAssign(Name("spaces"), "+", Int(1)),
+         If(
+           Compare(Name("spaces"), CmpOp(">", Int(2))),
+           AugAssign(Name("result"), "+", Str("-")),
+           If(
+             Compare(Name("spaces"), CmpOp("==", Int(1))),
+             AugAssign(Name("result"), "+", Str("_")),
+             If(
+               Compare(Name("spaces"), CmpOp("==", Int(2))),
+               AugAssign(Name("result"), "+", Str("__")),
+               .Stmts))))
+         AugAssign(Name("result"), "+", Name("char"))
+         Assign(Name("spaces"), Int(0))
+
+  syntax Stmts ::= "fixSpacesTail" [macro]
+  rule fixSpacesTail
+    => If(
+         Compare(Name("spaces"), CmpOp(">", Int(2))),
+         AugAssign(Name("result"), "+", Str("-")),
+         If(
+           Compare(Name("spaces"), CmpOp("==", Int(1))),
+           AugAssign(Name("result"), "+", Str("_")),
+           If(
+             Compare(Name("spaces"), CmpOp("==", Int(2))),
+             AugAssign(Name("result"), "+", Str("__")),
+             .Stmts))
+         )
+
+  syntax Stmts ::= "fixSpacesFunctionBody" [macro]
+  rule fixSpacesFunctionBody
+    => Assign(Name("result"), Str(""))
+       Assign(Name("spaces"), Int(0))
+       Assign(Name("char"), Str(""))
+       For(Name("char"), Name("text"), fixSpacesLoopBody)
+       If(
+         Compare(Name("spaces"), CmpOp(">", Int(2))),
+         AugAssign(Name("result"), "+", Str("-")),
+         If(
+           Compare(Name("spaces"), CmpOp("==", Int(1))),
+           AugAssign(Name("result"), "+", Str("_")),
+           If(
+             Compare(Name("spaces"), CmpOp("==", Int(2))),
+             AugAssign(Name("result"), "+", Str("__")),
+             .Stmts))
+         )
+       Return(Name("result"))
+
+  syntax Module ::= "solutionModule" [macro]
+  rule solutionModule
+    => Module(
+         FuncDef(
+           "fix_spaces",
+           Params("text"),
+           fixSpacesFunctionBody))
+endmodule
+
+// The four arithmetic cases of this summary are proved in
+// FIX-SPACES-FLUSH-SPEC before this module is used for the loop proof.
+module FIX-SPACES-FLUSH-VERIFICATION
+  imports FIX-SPACES-BASE
+
+  rule
+    <k>
+      fixSpacesTail
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(CH:IntSeq)),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION:Val,
+          parent(-1)))
+      (-1 |-> BUILTINS:Scope)
+      =>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(appendPending(A, N)))
+          ("spaces" |-> N)
+          ("char"   |-> str(CH)),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION,
+          parent(-1)))
+      (-1 |-> BUILTINS)
+    </scopes>
+    requires N >=Int 0
+    [priority(30)]
+endmodule
+
+// The space and non-space body cases are proved in FIX-SPACES-STEP-SPEC.
+module FIX-SPACES-STEP-VERIFICATION
+  imports FIX-SPACES-FLUSH-VERIFICATION
+
+  rule
+    <k> fixSpacesLoopBody => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(iCons(32, .IntSeq))),
+          parent(0)))
+      (0 |-> MODULE:Scope)
+      (-1 |-> BUILTINS:Scope)
+      =>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(A))
+          ("spaces" |-> N +Int 1)
+          ("char"   |-> str(iCons(32, .IntSeq))),
+          parent(0)))
+      (0 |-> MODULE)
+      (-1 |-> BUILTINS)
+    </scopes>
+    requires N >=Int 0
+    [priority(20)]
+
+  rule
+    <k> fixSpacesLoopBody => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(iCons(C:Int, .IntSeq))),
+          parent(0)))
+      (0 |-> MODULE:Scope)
+      (-1 |-> BUILTINS:Scope)
+      =>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |->
+            str(
+              seqConcat(
+                appendPending(A, N),
+                iCons(C, .IntSeq))))
+          ("spaces" |-> 0)
+          ("char"   |-> str(iCons(C, .IntSeq))),
+          parent(0)))
+      (0 |-> MODULE)
+      (-1 |-> BUILTINS)
+    </scopes>
+    requires N >=Int 0 andBool C =/=Int 32
+    [priority(20)]
+endmodule
+
+// This module promotes the separately proved loop claim to a proof-only
+// summary rule.  It is never imported by the LLVM concrete definition.
+module FIX-SPACES-VERIFICATION
+  imports FIX-SPACES-STEP-VERIFICATION
+
+  rule
+    <k>
+      #loop(str(IS:IntSeq), Name("char"), fixSpacesLoopBody)
+      ~> fixSpacesTail
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(CH:IntSeq)),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION:Val,
+          parent(-1)))
+      (-1 |-> BUILTINS:Scope)
+      =>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(fixSpacesLoop(A, IS, N)))
+          ("spaces" |-> trailingSpaces(IS, N))
+          ("char"   |-> str(finalChar(IS, CH))),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION,
+          parent(-1)))
+      (-1 |-> BUILTINS)
+    </scopes>
+    requires N >=Int 0
+      andBool BUILTINS ==K builtinsScope
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..4cad683bc353153b715f3b3328ad1f9c7a79ad51
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,27 @@
+def fix_spaces(text):
+    result = ""
+    spaces = 0
+    char = ""
+
+    for char in text:
+        if ord(char) == 32:
+            spaces += 1
+        else:
+            if spaces > 2:
+                result += "-"
+            elif spaces == 1:
+                result += "_"
+            elif spaces == 2:
+                result += "__"
+
+            result += char
+            spaces = 0
+
+    if spaces > 2:
+        result += "-"
+    elif spaces == 1:
+        result += "_"
+    elif spaces == 2:
+        result += "__"
+
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..63b3ebeff42932538313a2bf0a196e324bf4c8d7
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,248 @@
+requires "verification.k"
+
+module FIX-SPACES-FLUSH-SPEC
+  imports FIX-SPACES-BASE
+
+  claim [flush-zero]:
+    <k> fixSpacesTail => .K </k>
+    <env> 1 </env>
+    <scopes>
+      ...
+      1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> 0)
+          ("char"   |-> str(CH:IntSeq)),
+          parent(0))
+      =>
+      1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(A))
+          ("spaces" |-> 0)
+          ("char"   |-> str(CH)),
+          parent(0))
+      ...
+    </scopes>
+
+  claim [flush-one]:
+    <k> fixSpacesTail => .K </k>
+    <env> 1 </env>
+    <scopes>
+      ...
+      1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> 1)
+          ("char"   |-> str(CH:IntSeq)),
+          parent(0))
+      =>
+      1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(seqConcat(A, iCons(95, .IntSeq))))
+          ("spaces" |-> 1)
+          ("char"   |-> str(CH)),
+          parent(0))
+      ...
+    </scopes>
+
+  claim [flush-two]:
+    <k> fixSpacesTail => .K </k>
+    <env> 1 </env>
+    <scopes>
+      ...
+      1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> 2)
+          ("char"   |-> str(CH:IntSeq)),
+          parent(0))
+      =>
+      1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |->
+            str(
+              seqConcat(
+                A,
+                iCons(95, iCons(95, .IntSeq)))))
+          ("spaces" |-> 2)
+          ("char"   |-> str(CH)),
+          parent(0))
+      ...
+    </scopes>
+
+  claim [flush-many]:
+    <k> fixSpacesTail => .K </k>
+    <env> 1 </env>
+    <scopes>
+      ...
+      1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(CH:IntSeq)),
+          parent(0))
+      =>
+      1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(seqConcat(A, iCons(45, .IntSeq))))
+          ("spaces" |-> N)
+          ("char"   |-> str(CH)),
+          parent(0))
+      ...
+    </scopes>
+    requires N >Int 2
+endmodule
+
+module FIX-SPACES-STEP-SPEC
+  imports FIX-SPACES-FLUSH-VERIFICATION
+
+  claim [step-space]:
+    <k> fixSpacesLoopBody => .K </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(iCons(32, .IntSeq))),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION:Val,
+          parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(A))
+          ("spaces" |-> N +Int 1)
+          ("char"   |-> str(iCons(32, .IntSeq))),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION,
+          parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    requires N >=Int 0
+
+  claim [step-non-space]:
+    <k> fixSpacesLoopBody => .K </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(iCons(C:Int, .IntSeq))),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION:Val,
+          parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |->
+            str(
+              seqConcat(
+                appendPending(A, N),
+                iCons(C, .IntSeq))))
+          ("spaces" |-> 0)
+          ("char"   |-> str(iCons(C, .IntSeq))),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION,
+          parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    requires N >=Int 0 andBool C =/=Int 32
+endmodule
+
+module FIX-SPACES-LOOP-SPEC
+  imports FIX-SPACES-STEP-VERIFICATION
+
+  // Structural induction over IS proves the exact loop summary used below.
+  claim
+    <k>
+      #loop(str(IS:IntSeq), Name("char"), fixSpacesLoopBody)
+      ~> fixSpacesTail
+      =>
+      .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(CH:IntSeq)),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION:Val,
+          parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(fixSpacesLoop(A, IS, N)))
+          ("spaces" |-> trailingSpaces(IS, N))
+          ("char"   |-> str(finalChar(IS, CH))),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION,
+          parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    requires N >=Int 0
+endmodule
+
+module FIX-SPACES-MAIN-SPEC
+  imports FIX-SPACES-VERIFICATION
+
+  // End-to-end functional correctness from the translated function body.
+  claim
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(Name("fix_spaces"), str(IS:IntSeq))
+      =>
+      str(fixSpacesLoop(.IntSeq, IS, 0))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (0 |->
+        scope(
+          "fix_spaces" |->
+            closureVal("text", fixSpacesFunctionBody, 0),
+          parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..60fa889401a46f375dff0d6e6da46b62777fd871
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,291 @@
+requires "reference-semantics/semantics.k"
+
+module FIX-SPACES-BASE
+  imports MPY
+
+  // Proof-oriented specialization of the loop's integer comparison.  These
+  // two disjoint equations expose the exact space/non-space split to the
+  // symbolic backend instead of leaving an infeasible Boolean branch alive.
+  rule applyCmp("==", 32, 32) => true
+    [priority(40)]
+  rule applyCmp("==", C:Int, 32) => false
+    requires C =/=Int 32
+    [priority(40)]
+
+  // The output contributed by one completed run of pending spaces.
+  syntax IntSeq ::= pendingSpaces(Int) [function, total]
+  rule pendingSpaces(N:Int)
+    => #if N >Int 2
+       #then iCons(45, .IntSeq)
+       #else #if N ==Int 1
+             #then iCons(95, .IntSeq)
+             #else #if N ==Int 2
+                   #then iCons(95, iCons(95, .IntSeq))
+                   #else .IntSeq
+                   #fi
+             #fi
+       #fi
+
+  syntax IntSeq ::= appendPending(IntSeq, Int) [function, total]
+  rule appendPending(A:IntSeq, N:Int)
+    => #if N >Int 2
+       #then seqConcat(A, iCons(45, .IntSeq))
+       #else #if N ==Int 1
+             #then seqConcat(A, iCons(95, .IntSeq))
+             #else #if N ==Int 2
+                   #then seqConcat(
+                           A,
+                           iCons(95, iCons(95, .IntSeq)))
+                   #else A
+                   #fi
+             #fi
+       #fi
+
+  // Independent mathematical model of the loop.  A is the output already
+  // emitted, IS is the unprocessed suffix, and N is the pending-space count.
+  syntax IntSeq ::= fixSpacesLoop(IntSeq, IntSeq, Int) [function, total]
+  rule fixSpacesLoop(A:IntSeq, .IntSeq, N:Int)
+    => appendPending(A, N)
+  rule fixSpacesLoop(A:IntSeq, iCons(32, R:IntSeq), N:Int)
+    => fixSpacesLoop(A, R, N +Int 1)
+    [simplification]
+  rule fixSpacesLoop(A:IntSeq, iCons(C:Int, R:IntSeq), N:Int)
+    => fixSpacesLoop(
+         seqConcat(appendPending(A, N), iCons(C, .IntSeq)),
+         R,
+         0)
+    requires C =/=Int 32
+    [simplification]
+
+  // The two remaining pieces of loop state are specified as folds too.  They
+  // let the loop lemma describe the exact final local frame, not just result.
+  syntax Int ::= trailingSpaces(IntSeq, Int) [function, total]
+  rule trailingSpaces(.IntSeq, N:Int) => N
+  rule trailingSpaces(iCons(32, R:IntSeq), N:Int)
+    => trailingSpaces(R, N +Int 1)
+    [simplification]
+  rule trailingSpaces(iCons(C:Int, R:IntSeq), _:Int)
+    => trailingSpaces(R, 0)
+    requires C =/=Int 32
+    [simplification]
+
+  syntax IntSeq ::= finalChar(IntSeq, IntSeq) [function, total]
+  rule finalChar(.IntSeq, CH:IntSeq) => CH
+  rule finalChar(iCons(C:Int, R:IntSeq), _:IntSeq)
+    => finalChar(R, iCons(C, .IntSeq))
+
+  // Constructor terms copied exactly from solution.mpy, factored only to keep
+  // the proof rule and claims readable.
+  syntax Stmts ::= "fixSpacesLoopBody" [macro]
+  rule fixSpacesLoopBody
+    => If(
+         Compare(
+           Call(Name("ord"), Name("char")),
+           CmpOp("==", Int(32))),
+         AugAssign(Name("spaces"), "+", Int(1)),
+         If(
+           Compare(Name("spaces"), CmpOp(">", Int(2))),
+           AugAssign(Name("result"), "+", Str("-")),
+           If(
+             Compare(Name("spaces"), CmpOp("==", Int(1))),
+             AugAssign(Name("result"), "+", Str("_")),
+             If(
+               Compare(Name("spaces"), CmpOp("==", Int(2))),
+               AugAssign(Name("result"), "+", Str("__")),
+               .Stmts))))
+         AugAssign(Name("result"), "+", Name("char"))
+         Assign(Name("spaces"), Int(0))
+
+  syntax Stmts ::= "fixSpacesTail" [macro]
+  rule fixSpacesTail
+    => If(
+         Compare(Name("spaces"), CmpOp(">", Int(2))),
+         AugAssign(Name("result"), "+", Str("-")),
+         If(
+           Compare(Name("spaces"), CmpOp("==", Int(1))),
+           AugAssign(Name("result"), "+", Str("_")),
+           If(
+             Compare(Name("spaces"), CmpOp("==", Int(2))),
+             AugAssign(Name("result"), "+", Str("__")),
+             .Stmts))
+         )
+
+  syntax Stmts ::= "fixSpacesFunctionBody" [macro]
+  rule fixSpacesFunctionBody
+    => Assign(Name("result"), Str(""))
+       Assign(Name("spaces"), Int(0))
+       Assign(Name("char"), Str(""))
+       For(Name("char"), Name("text"), fixSpacesLoopBody)
+       If(
+         Compare(Name("spaces"), CmpOp(">", Int(2))),
+         AugAssign(Name("result"), "+", Str("-")),
+         If(
+           Compare(Name("spaces"), CmpOp("==", Int(1))),
+           AugAssign(Name("result"), "+", Str("_")),
+           If(
+             Compare(Name("spaces"), CmpOp("==", Int(2))),
+             AugAssign(Name("result"), "+", Str("__")),
+             .Stmts))
+         )
+       Return(Name("result"))
+
+  syntax Module ::= "solutionModule" [macro]
+  rule solutionModule
+    => Module(
+         FuncDef(
+           "fix_spaces",
+           Params("text"),
+           fixSpacesFunctionBody))
+endmodule
+
+// The four arithmetic cases of this summary are proved in
+// FIX-SPACES-FLUSH-SPEC before this module is used for the loop proof.
+module FIX-SPACES-FLUSH-VERIFICATION
+  imports FIX-SPACES-BASE
+
+  rule
+    <k>
+      fixSpacesTail
+      =>
+      .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(CH:IntSeq)),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION:Val,
+          parent(-1)))
+      (-1 |-> BUILTINS:Scope)
+      =>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(appendPending(A, N)))
+          ("spaces" |-> N)
+          ("char"   |-> str(CH)),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION,
+          parent(-1)))
+      (-1 |-> BUILTINS)
+    </scopes>
+    requires N >=Int 0
+    [priority(30)]
+endmodule
+
+// The space and non-space body cases are proved in FIX-SPACES-STEP-SPEC.
+module FIX-SPACES-STEP-VERIFICATION
+  imports FIX-SPACES-FLUSH-VERIFICATION
+
+  rule
+    <k> fixSpacesLoopBody => .K ... </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |->
+        scope(
