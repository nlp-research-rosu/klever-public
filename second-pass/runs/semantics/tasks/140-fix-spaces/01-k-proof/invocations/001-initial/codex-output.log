+            str(
+              seqConcat(
+                appendPending(A, N),
+                iCons(C, .IntSeq))))
+          ("spaces" |-> 0)
+          ("char"   |-> str(iCons(C, .IntSeq))),
+          parent(0)))
+      (0 |-> MODULE)
+      (-1 |-> BUILTINS)
+    </scopes>
+    requires N >=Int 0 andBool C =/=Int 32
+    [priority(20)]
+endmodule
