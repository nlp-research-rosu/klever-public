    64	         AugAssign(Name("result"), "+", Name("char"))
    65	         Assign(Name("spaces"), Int(0))
    66	
    67	  syntax Stmts ::= "fixSpacesTail" [function]
    68	  rule fixSpacesTail
    69	    => If(
    70	         Compare(Name("spaces"), CmpOp(">", Int(2))),
    71	         AugAssign(Name("result"), "+", Str("-")),
    72	         If(
