+
+  claim [flush-many]:
+    <k> fixSpacesTailStmt => .K </k>
+    <env> 1 </env>
+    <scopes>
+      ...
+      1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(CH:IntSeq)),
