The modular proof ladder is now closing: the flush cases, body-step cases, and the full structural loop induction each return `#Top`. The remaining end-to-end claim is running through module loading, function-frame setup, the proved loop summary, and return cleanup; I’m monitoring it now, then I’ll validate the LLVM execution and package the exact reproducible commands.
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..6f0d432c371502b40adfda93f6363ec8ebc28db7
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,27 @@
+def fix_spaces(text):
+    result = ""
+    spaces = 0
+    char = ""
+
+    for char in text:
+        if ord(char) - 32:
+            if spaces > 2:
+                result += "-"
+            elif spaces == 1:
+                result += "_"
+            elif spaces == 2:
+                result += "__"
+
+            result += char
+            spaces = 0
+        else:
+            spaces += 1
+
+    if spaces > 2:
+        result += "-"
+    elif spaces == 1:
+        result += "_"
+    elif spaces == 2:
+        result += "__"
+
+    return result
