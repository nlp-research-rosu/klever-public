codex
The end-to-end configuration is still the expensive part, but its proof definition now uses the generalized, already-proved loop summary without comparing the entire builtins map. The prover is actively consuming CPU and remains within memory; I’ll let this run while preserving the faster modular proofs as separate required commands.
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..6f0d432c371502b40adfda93f6363ec8ebc28db7
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,27 @@
+def fix_spaces(text):
+    result = ""
+    spaces = 0
+    char = ""
+
+    for char in text:
+        if ord(char) - 32:
+            if spaces > 2:
+                result += "-"
+            elif spaces == 1:
+                result += "_"
+            elif spaces == 2:
+                result += "__"
+
+            result += char
+            spaces = 0
+        else:
+            spaces += 1
+
+    if spaces > 2:
+        result += "-"
+    elif spaces == 1:
+        result += "_"
+    elif spaces == 2:
+        result += "__"
+
+    return result
