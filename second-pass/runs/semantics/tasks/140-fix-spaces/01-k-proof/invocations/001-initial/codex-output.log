+          parent(0)))
+      (0 |-> MODULE:Scope)
+      (-1 |->
+        scope(
+          ("ord" |-> builtinV("ord"))
+          BUILTIN_REST:Map,
+          root))
+      =>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(A))
+          ("spaces" |-> N +Int 1)
+          ("char"   |-> str(iCons(32, .IntSeq))),
+          parent(0)))
+      (0 |-> MODULE)
+      (-1 |->
+        scope(
+          ("ord" |-> builtinV("ord"))
+          BUILTIN_REST,
+          root))
+    </scopes>
+    requires N >=Int 0
+    [priority(20)]
+
+  rule
