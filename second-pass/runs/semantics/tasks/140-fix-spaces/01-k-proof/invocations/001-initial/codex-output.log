+          ("result" |-> str(seqConcat(A, iCons(95, .IntSeq))))
+          ("spaces" |-> 1)
+          ("char"   |-> str(CH)),
+          parent(0))
+      ...
+    </scopes>
+
+  claim [flush-two]:
