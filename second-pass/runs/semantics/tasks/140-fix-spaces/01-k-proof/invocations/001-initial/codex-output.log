+                appendPending(A, N),
+                iCons(C, .IntSeq))))
+          ("spaces" |-> 0)
+          ("char"   |-> str(iCons(C, .IntSeq))),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION,
+          parent(-1)))
+      (-1 |-> builtinsScope)
+    </scopes>
+    requires N >=Int 0 andBool C =/=Int 32
