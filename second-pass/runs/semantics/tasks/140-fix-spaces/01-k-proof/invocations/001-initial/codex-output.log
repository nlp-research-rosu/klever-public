+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> 0)
+          ("char"   |-> str(CH:IntSeq)),
+          parent(0))
+      =>
+      1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(A))
+          ("spaces" |-> 0)
+          ("char"   |-> str(CH)),
+          parent(0))
+      ...
+    </scopes>
+
+  claim [flush-one]:
