+             Compare(Name("spaces"), CmpOp("==", Int(2))),
+             AugAssign(Name("result"), "+", Str("__")),
+             .Stmts))
+         )
+       Return(Name("result"))
+
+  syntax Module ::= "solutionModule" [function]
+  rule solutionModule
+    => Module(
+         FuncDef(
+           "fix_spaces",
+           Params("text"),
+           fixSpacesFunctionBody))
