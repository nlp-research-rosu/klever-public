new file mode 100644
index 0000000000000000000000000000000000000000..a25b2fa91ef300d6b38c0025ad62ee20a192ea1c
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,27 @@
+def fix_spaces(text):
+    result = ""
+    spaces = 0
+    char = ""
+
+    for char in text:
+        if char == " ":
+            spaces += 1
+        else:
+            if spaces > 2:
+                result += "-"
+            elif spaces == 1:
+                result += "_"
+            elif spaces == 2:
+                result += "__"
+
+            result += char
+            spaces = 0
+
+    if spaces > 2:
+        result += "-"
+    elif spaces == 1:
+        result += "_"
+    elif spaces == 2:
+        result += "__"
+
+    return result
