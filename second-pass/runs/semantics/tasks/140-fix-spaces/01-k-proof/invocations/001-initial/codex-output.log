+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> N:Int)
+          ("char"   |-> str(CH:IntSeq)),
+          parent(0)))
+      (0 |->
+        scope(
+          "fix_spaces" |-> FUNCTION:Val,
+          parent(-1)))
+      (-1 |-> builtinsScope)
+      =>
+      (1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(fixSpacesLoop(A, IS, N)))
