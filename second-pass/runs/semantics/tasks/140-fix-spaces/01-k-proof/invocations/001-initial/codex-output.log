diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1b80a6bdecae47378d38fafe39c07fece8d81153
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,277 @@
+requires "verification.k"
+
+module FIX-SPACES-FLUSH-SPEC
+  imports FIX-SPACES-BASE
+
+  claim [flush-zero]:
+    <k> fixSpacesTailStmt => .K </k>
+    <env> 1 </env>
+    <scopes>
+      ...
+      1 |->
+        scope(
+          ("text"   |-> str(TEXT:IntSeq))
+          ("result" |-> str(A:IntSeq))
+          ("spaces" |-> 0)
+          ("char"   |-> str(CH:IntSeq)),
+          parent(0))
+      =>
+      1 |->
+        scope(
+          ("text"   |-> str(TEXT))
+          ("result" |-> str(A))
