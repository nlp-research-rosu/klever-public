COMMAND: bash -lc cd\ /tmp/audit-work/workspace\ \&\&\ python3\ /reference/py2mpy.py\ concrete-audit.py\ \>\ concrete-audit.mpy\ \&\&\ sha256sum\ concrete-audit.mpy\ \&\&\ sed\ -n\ \"1\,220p\"\ concrete-audit.mpy
528875e81ddb94e26a52ec16dec598c434594dbea1cd3dc82fc7c8fe8a1139df  concrete-audit.mpy
Module(
  FuncDef("_all_digits_odd", Params("n"),
    Assign(Name("result"), Bool(true))
    While(Compare(Name("n"), CmpOp(">", Int(0))),
      If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0))),
        Assign(Name("result"), Bool(false))
        Break,
        )
      AugAssign(Name("n"), "//", Int(10)))
    Return(Name("result")))
  FuncDef("unique_digits", Params("x"),
    Assign(Name("result"), ListExpr())
    Assign(Name("n"), Int(0))
    For(Name("n"), Name("x"),
      If(Call(Name("_all_digits_odd"), Name("n")),
        Expr(Call(Attribute(Name("result"), "append"), Name("n"))),
        ))
    Return(Call(Name("sorted"), Name("result"))))
  Assert(
    Compare(
      Call(Name("unique_digits"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("unique_digits"), ListExpr(Int(1))),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(Name("unique_digits"), ListExpr(Int(2))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("unique_digits"),
        ListExpr(Int(15), Int(33), Int(1422), Int(1))),
      CmpOp("==", ListExpr(Int(1), Int(15), Int(33)))))
  Assert(
    Compare(
      Call(
        Name("unique_digits"),
        ListExpr(Int(152), Int(323), Int(1422), Int(10))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("unique_digits"),
        ListExpr(Int(21), Int(23451), Int(97531), Int(101), Int(11))),
      CmpOp("==", ListExpr(Int(11), Int(97531)))))
  Assert(
    Compare(
      Call(
        Name("unique_digits"),
        ListExpr(Int(33), Int(11), Int(33), Int(11))),
      CmpOp("==", ListExpr(Int(11), Int(11), Int(33), Int(33))))))

