+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      0 |-> list(filterOddAcc(.ValSeq, INPUT))
+      1 |-> list(sortVS(filterOddAcc(.ValSeq, INPUT)))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires positiveInts(INPUT)
+endmodule
