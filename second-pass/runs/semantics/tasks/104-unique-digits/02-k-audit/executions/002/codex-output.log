diff --git a//tmp/audit-work/workspace/concrete-audit.py b//tmp/audit-work/workspace/concrete-audit.py
new file mode 100644
index 0000000000000000000000000000000000000000..e2b02520720d86191a7ade024b1a2da3ee189b51
--- /dev/null
+++ b//tmp/audit-work/workspace/concrete-audit.py
@@ -0,0 +1,26 @@
+def _all_digits_odd(n):
+    result = True
+    while n > 0:
+        if n % 2 == 0:
+            result = False
+            break
+        n //= 10
+    return result
+
+
+def unique_digits(x):
+    result = []
+    n = 0
+    for n in x:
+        if _all_digits_odd(n):
+            result.append(n)
+    return sorted(result)
+
+
+assert unique_digits([]) == []
+assert unique_digits([1]) == [1]
+assert unique_digits([2]) == []
+assert unique_digits([15, 33, 1422, 1]) == [1, 15, 33]
+assert unique_digits([152, 323, 1422, 10]) == []
+assert unique_digits([21, 23451, 97531, 101, 11]) == [11, 97531]
+assert unique_digits([33, 11, 33, 11]) == [11, 11, 33, 33]
