index 0000000000000000000000000000000000000000..a074a23e69eb8d514e95dd73c9d92bc533d7ca48
--- /dev/null
+++ b/evidence/run_capture.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 2
+fi
+
+log=$1
+shift
+
+: > "$log"
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} | tee -a "$log"
+
+set -o pipefail
+"$@" 2>&1 | tee -a "$log"
+status=${PIPESTATUS[0]}
+printf 'EXIT_STATUS: %s\n' "$status" | tee -a "$log"
+exit "$status"
