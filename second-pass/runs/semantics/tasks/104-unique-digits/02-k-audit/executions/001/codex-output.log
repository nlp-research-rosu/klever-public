+  claim
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "_all_digits_odd",
+            Params("n"),
+            oddDigitsBody)
+          FuncDef(
+            "unique_digits",
+            Params("x"),
+            uniqueDigitsBody)))
+      ~> Call(Name("unique_digits"), list(vCons(2, .ValSeq)))
+    =>
