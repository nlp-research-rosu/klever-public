+        if sha256_tree(trusted_semantics) != audit["hashes"]["trusted_reference_semantics_sha256"]:
+            failures.append("trusted semantics modern tree hash mismatch")
+        if sha256_tree(candidate_semantics) != audit["hashes"]["candidate_reference_semantics_sha256"]:
+            failures.append("candidate semantics modern tree hash mismatch")
+        if legacy_tree_digest(trusted_semantics) != audit["hashes"]["trusted_reference_semantics_legacy_sha256"]:
+            failures.append("trusted semantics legacy tree hash mismatch")
+        if sha256_tree(trusted_semantics) == sha256_tree(candidate_semantics):
