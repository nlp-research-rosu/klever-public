   203	  rule truthy(str(S:IntSeq))   => notBool (S ==K .IntSeq)
   204	  rule truthy(list(V:ValSeq))  => notBool (V ==K .ValSeq)
   205	  rule truthy(tuple(V:ValSeq)) => notBool (V ==K .ValSeq)
   206	
   207	  // ==== extensible operator dispatch (cases added by the construct modules) ==
   208	  syntax Val  ::= applyUn(String, Val) [function]
   209	  syntax Val  ::= applyBin(String, Val, Val) [function]
   210	  syntax Bool ::= applyCmp(String, Val, Val) [function]
   211	
   212	  // ==== shared list helpers =================================================
   213	  syntax Vals ::= appendVal(Vals, Val) [function, total]
   214	  rule appendVal(.Vals, V:Val)              => V , .Vals
   215	  rule appendVal((V0:Val, VS:Vals), V:Val)  => V0 , appendVal(VS, V)
   216	
   217	  syntax ValSeq ::= vals2valSeq(Vals) [function, total]
   218	  rule vals2valSeq(.Vals)            => .ValSeq
   219	  rule vals2valSeq((V:Val, VS:Vals)) => vCons(V, vals2valSeq(VS))
   220	
   221	  // ==== shared sequence length (len / summaries across many modules) ========
   222	  // (positional access valSeqAt/intSeqAt + normIdx live in subscript.k)
   223	  syntax Int ::= vsLen(ValSeq) [function, total]
   224	  rule vsLen(.ValSeq)                => 0
   225	  rule vsLen(vCons(_:Val, S:ValSeq)) => 1 +Int vsLen(S)
   226	
   227	  syntax Int ::= isLen(IntSeq) [function, total]
   228	  rule isLen(.IntSeq)                => 0
   229	  rule isLen(iCons(_:Int, S:IntSeq)) => 1 +Int isLen(S)
   230	
   231	  // in-bounds positional write (list subscript-assign); OOB leaves the seq unchanged
   232	  // (valid programs write in-bounds — mirrors valSeqAt's total-but-underspecified stance)
   233	  syntax ValSeq ::= setVSAt(ValSeq, Int, Val) [function, total]
   234	  rule setVSAt(.ValSeq, _:Int, _:Val)               => .ValSeq
   235	  rule setVSAt(vCons(_:Val, S:ValSeq), 0, V:Val)    => vCons(V, S)
   236	  rule setVSAt(vCons(W:Val, S:ValSeq), I:Int, V:Val) => vCons(W, setVSAt(S, I -Int 1, V))
   237	       requires I >Int 0
   238	  rule setVSAt(VS:ValSeq, I:Int, _:Val)             => VS
   239	       requires I <Int 0
   240	endmodule
FILE reference-semantics/semantics/controls.k
     1	// reference/src/semantics/controls.k — MPY-CONTROLS
     2	
     3	module MPY-CONTROLS
     4	  imports MPY-CORE
     5	  imports MPY-TUPLE
     6	  imports MPY-ITER
     7	
     8	  // ==== Assign / AugAssign (write the current scope; RHS evaluated by strictness) ==
     9	  rule <k> Assign(Name(X:String), V:Val) => .K ... </k>
    10	       <env> L:Int </env>
    11	       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>
    12	  rule <k> Assign(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>
    13	       <env> L:Int </env>
    14	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    15	       requires "$cells" in_keys(M)
    16	        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
    17	        andBool X in_keys(M) andBool isCellRef({M[X]}:>Val)
    18	       [priority(40)]
    19	
    20	  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => .K ... </k>
    21	       <env> L:Int </env>
    22	       <scopes> ... L |-> scope(M:Map => M [ X <- applyBin(OP, {M[X]}:>Val, V) ], _) ... </scopes>
    23	       requires X in_keys(M)
    24	  // `lst += [..]` where lst is a heap ref: the generic rule leaves applyBin(OP, ref, V) — but the
    25	  // ref-deref preemption is BinOp-level (operators.k), so applyBin never derefs and it sticks. Route
    26	  // the ref case through BinOp so the deref + list-concat + #alloc path fires (result is a fresh ref).
    27	  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => Assign(Name(X), BinOp(OP, Name(X), V)) ... </k>
    28	       <env> L:Int </env>
    29	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    30	       requires X in_keys(M) andBool isRefV({M[X]}:>Val)
    31	       [priority(40)]
    32	
    33	  // ==== import trivia: `from math import floor, ceil` binds the supported
    34	  // names as builtins in the current scope; every other import is a no-op
    35	  rule <k> ImportFrom("math", NS:ParamNames) => #bindImports(NS) ... </k>
    36	  rule <k> ImportFrom(_:String, _:ParamNames) => .K ... </k> [owise]
    37	  syntax KItem ::= #bindImports(ParamNames)
    38	  rule <k> #bindImports(.ParamNames) => .K ... </k>
    39	  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
    40	       <env> L:Int </env>
    41	       <scopes> ... L |-> scope(M:Map => M [ N <- builtinV(N) ], _) ... </scopes>
    42	       requires N ==String "floor" orBool N ==String "ceil"
    43	  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
    44	       requires notBool (N ==String "floor" orBool N ==String "ceil")
    45	
    46	  // ==== Expr statement: evaluate for effect, discard the value ===============
    47	  // (bare calls — mutator methods, docstrings; the WP0 statement-trivia rung)
    48	  rule <k> Expr(_:Val) => .K ... </k>
    49	
    50	  // ==== If (condition evaluated by strictness) ==============================
    51	  syntax KItem ::= #branch(Bool, Stmts, Stmts)
    52	  rule <k> If(C:Val, T:Stmts, E:Stmts) => #branch(truthy(C), T, E) ... </k>
    53	  rule <k> #branch(true,  T:Stmts, _:Stmts) => T ... </k>
    54	  rule <k> #branch(false, _:Stmts, E:Stmts) => E ... </k>
    55	
    56	  // ==== IfExp: ternary T if C else E ========================================
    57	  rule <k> IfExp(V:Val, T:Expr, _:Expr) => T ... </k>
    58	       requires truthy(V)
    59	  rule <k> IfExp(V:Val, _:Expr, E:Expr) => E ... </k>
    60	       requires notBool truthy(V)
    61	
    62	  // ==== For: one loop, in-cell continuation, over #iterNext =================
    63	  // (the iterable is evaluated once, by strictness; the protocol stays rewrites —
    64	  // circularities anchor on #loop and narrowing substitutes the structure)
    65	  syntax KItem ::= #loop(Val, Expr, Stmts) | #loopStep(Expr, Stmts)
    66	                 | #while(Expr, Stmts) | #whileCond(Expr, Stmts)
    67	                 | #loopLbl(K) | "#cont" | "#brk"
    68	
    69	  rule <k> For(T:Expr, OBJ:Val, B:Stmts) => #loop(OBJ, T, B) ... </k>
    70	
    71	  rule <k> #loop(IT:Iterable, T:Expr, B:Stmts) => #iterNext(IT) ~> #loopStep(T, B) ... </k>
    72	  rule <k> #iterDone ~> #loopStep(_:Expr, _:Stmts) => .K ... </k>
    73	  rule <k> #iterYield(V:Val, REST:Iterable) ~> #loopStep(T:Expr, B:Stmts)
    74	        => #bindTgt(T, V) ~> B ~> #loopLbl(#loop(REST, T, B)) ... </k>
    75	
    76	  // ==== While ==============================================================
    77	  rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>
    78	  rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>
    79	  rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>
    80	       requires truthy(V)
    81	  rule <k> V:Val ~> #whileCond(_C:Expr, _B:Stmts) => .K ... </k>
    82	       requires notBool truthy(V)
    83	
    84	  // ==== loop control (break / continue) =====================================
    85	  rule <k> #loopLbl(NEXT:K) => NEXT ... </k>
    86	  rule <k> Continue => #cont ... </k>
    87	  rule <k> Break => #brk ... </k>
    88	  rule <k> #cont ~> #loopLbl(NEXT:K) => NEXT ... </k>
    89	  rule <k> #cont ~> (_:KItem => .K) ... </k> [owise]
    90	  rule <k> #brk ~> #loopLbl(_:K) => .K ... </k>
    91	  rule <k> #brk ~> (_:KItem => .K) ... </k> [owise]
    92	
    93	  // ==== heap-object deref at the truthiness/iteration consumers ==============
    94	  // (priority(40) preempts the generic Val rules so truthy/#loop never see a ref)
    95	  rule <k> If(ref(H:Int), T:Stmts, E:Stmts) => If(V, T, E) ... </k>
    96	       <heap> ... H |-> V:Val ... </heap>
    97	       [priority(40)]
    98	  rule <k> IfExp(ref(H:Int), T:Expr, E:Expr) => IfExp(V, T, E) ... </k>
    99	       <heap> ... H |-> V:Val ... </heap>
   100	       [priority(40)]
   101	  rule <k> ref(H:Int) ~> #whileCond(C:Expr, B:Stmts) => V ~> #whileCond(C, B) ... </k>
   102	       <heap> ... H |-> V:Val ... </heap>
   103	       [priority(40)]
   104	  // For derefs its iterable ONCE at loop start (iteration is over the snapshot;
   105	  // mutating the iterated list inside its own loop is outside the subset)
   106	  rule <k> For(T:Expr, ref(H:Int), B:Stmts) => For(T, V, B) ... </k>
   107	       <heap> ... H |-> V:Val ... </heap>
   108	       [priority(40)]
   109	endmodule
FILE reference-semantics/semantics/functions.k
     1	// reference/src/semantics/functions.k — MPY-FUNCTIONS
     2	
     3	module MPY-FUNCTIONS
     4	  imports MPY-CORE
     5	
     6	  // call routing + callee/arg evaluation (#callee/#args/#argCont) live in call.k;
     7	  // this module owns the frame lifecycle (bind params, return, pop).
     8	  syntax KItem ::= frame(continuation: K, callerEnv: Int, savedLoc: Int)
     9	                 | #bindP(ParamNames, Vals)
    10	                 | "#pop"
    11	                 | "#endcall"
    12	
    13	  // ==== def / anonymous closure =============================================
    14	  rule <k> FuncDef(F:String, Params(PNS:ParamNames), BODY:Stmts) => .K ... </k>
    15	       <env> L:Int </env>
    16	       <scopes> ... L |-> scope(M:Map => M [ F <- closureVal(PNS, BODY, L) ], _) ... </scopes>
    17	
    18	  syntax Expr ::= closureExpr(ParamNames, Stmts)
    19	  rule <k> closureExpr(PNS:ParamNames, BODY:Stmts) => closureVal(PNS, BODY, L) ... </k>
    20	       <env> L:Int </env>
    21	
    22	  // ==== annotated def/lambda (closure cells; spec 2.3) ======================
    23	  // closureValC(params, cellvars, body, captured-cells). No frame anchor: all
    24	  // enclosing-local reads are freevars (symtable-complete) and go through the
    25	  // captured cells; everything else is global/builtin, so the callee frame's
    26	  // parent is the module scope (0) — sound after the defining frame dies.
    27	  syntax Val ::= closureValC(ParamNames, ParamNames, Stmts, Map)
    28	
    29	  // capture: resolve each freevar to the enclosing frame's cellRef, then bind
    30	  // (FuncDef) or yield (Lambda) the closure value.
    31	  syntax KItem ::= #mkClosure(String, ParamNames, ParamNames, ParamNames, Stmts, Map)
    32	                 | #mkLambda(ParamNames, ParamNames, ParamNames, Stmts, Map)
    33	  rule <k> FuncDef(F:String, Params(PNS:ParamNames), CellVars(CVS:ParamNames),
    34	                   FreeVars(FVS:ParamNames), BODY:Stmts)
    35	        => #mkClosure(F, PNS, CVS, FVS, BODY, .Map) ... </k>
    36	  rule <k> #mkClosure(F:String, PNS:ParamNames, CVS:ParamNames,
    37	                      (FV:String, FVR:ParamNames), BODY:Stmts, CM:Map)
    38	        => #mkClosure(F, PNS, CVS, FVR, BODY, CM [ FV <- {M[FV]}:>Val ]) ... </k>
    39	       <env> L:Int </env>
    40	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    41	       requires FV in_keys(M)
    42	  rule <k> #mkClosure(F:String, PNS:ParamNames, CVS:ParamNames,
    43	                      .ParamNames, BODY:Stmts, CM:Map) => .K ... </k>
    44	       <env> L:Int </env>
    45	       <scopes> ... L |-> scope(M:Map => M [ F <- closureValC(PNS, CVS, BODY, CM) ], _) ... </scopes>
    46	
    47	  rule <k> Lambda(Params(PNS:ParamNames), E:Expr)
    48	        => closureVal(PNS, Return(E) .Stmts, L) ... </k>
    49	       <env> L:Int </env>
    50	  rule <k> Lambda(Params(PNS:ParamNames), CellVars(CVS:ParamNames),
    51	                  FreeVars(FVS:ParamNames), E:Expr)
    52	        => #mkLambda(PNS, CVS, FVS, Return(E) .Stmts, .Map) ... </k>
    53	  rule <k> #mkLambda(PNS:ParamNames, CVS:ParamNames,
    54	                     (FV:String, FVR:ParamNames), BODY:Stmts, CM:Map)
    55	        => #mkLambda(PNS, CVS, FVR, BODY, CM [ FV <- {M[FV]}:>Val ]) ... </k>
    56	       <env> L:Int </env>
    57	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    58	       requires FV in_keys(M)
    59	  rule <k> #mkLambda(PNS:ParamNames, CVS:ParamNames, .ParamNames, BODY:Stmts, CM:Map)
    60	        => closureValC(PNS, CVS, BODY, CM) ... </k>
    61	
    62	  // ==== bind params ========================================================
    63	  rule <k> #bindP(.ParamNames, .Vals) => .K ... </k>
    64	  rule <k> #bindP((P:String, PS:ParamNames), (V:Val, VS:Vals)) => #bindP(PS, VS) ... </k>
    65	       <env> L:Int </env>
    66	       <scopes> ... L |-> scope(M:Map => M [ P <- V ], _) ... </scopes>
    67	  // a param that is a cellvar was pre-bound to its cell at frame entry
    68	  rule <k> #bindP((P:String, PS:ParamNames), (V:Val, VS:Vals))
    69	        => #cellW({M[P]}:>Val, V) ~> #bindP(PS, VS) ... </k>
    70	       <env> L:Int </env>
    71	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    72	       requires "$cells" in_keys(M)
    73	        andBool pnMember(P, cellsOf({M["$cells"]}:>Val))
    74	        andBool P in_keys(M) andBool isCellRef({M[P]}:>Val)
    75	       [priority(40)]
    76	
    77	  // ==== return / pop the frame (the returned expr evaluates by strictness) ==
    78	  rule <k> Return(V:Val) ~> _ => #pop </k>
    79	       <ret> noRet => retV(V) </ret>
    80	  rule <k> #endcall => #pop ... </k>
    81	       <ret> noRet => retV(noneV) </ret>
    82	  // pop: restore env, DEALLOCATE the callee frame, and wind scopeLoc back (LIFO allocation
    83	  // makes the saved loc the callee frame's own loc). Sound because no closureVal outlives its
    84	  // defining frame (frontend subset: no returned/stored closures; module defs live in loc 0).
    85	  rule <k> #pop => V ~> CONT </k>
    86	       <ret>   retV(V) => noRet </ret>
    87	       <stack> ListItem(frame(CONT:K, CALLERL:Int, SAVEDL:Int)) => .List ... </stack>
    88	       <env>   L:Int => CALLERL </env>
    89	       <scopes> SC:Map => SC [ L <- undef ] </scopes>
    90	       <scopeLoc> _ => SAVEDL </scopeLoc>
    91	endmodule
FILE reference-semantics/semantics/call.k
     1	// reference/src/semantics/call.k — MPY-CALL
     2	// ONE call route for every callable: evaluate the callee to a VALUE (name lookup reaches
     3	// builtins at the root; a cooled Attribute is a bound method), evaluate the args (the shared
     4	// #evalArgs loop in core.k), then dispatch on the callee value:
     5	//   closureVal    -> bind params, push a frame (user function)
     6	//   boundMethodV  -> applyMethod
     7	//   builtinV      -> the #iterNext folds (sum/all/any/max/min) or applyBuiltin
     8	//   typeV         -> callable type objects: int(...) / str(...)
     9	
    10	module MPY-CALL
    11	  imports MPY-METHODS
    12	  imports MPY-BUILTINS
    13	  imports MPY-FUNCTIONS
    14	
    15	  // a cooled attribute is a bound method value
    16	  rule <k> Attribute(V:Val, M:String) => boundMethodV(V, M) ... </k>
    17	
    18	  // evaluate callee, then args ([owise]: problem-local Call interceptions beat this)
    19	  syntax KItem ::= #callee(Exprs)
    20	  rule <k> Call(Fe:Expr, ARGS:Exprs) => Fe ~> #callee(ARGS) ... </k> [owise]
    21	  rule <k> CV:Val ~> #callee(ARGS:Exprs) => #evalArgs(ARGS, .Vals, toCall(CV)) ... </k>
    22	
    23	  // ==== dispatch on the callee value ========================================
    24	  rule <k> #applyK(toCall(boundMethodV(OBJ:Val, M:String)), ACC:Vals) => applyMethod(OBJ, M, ACC) ... </k>
    25	
    26	  rule <k> #applyK(toCall(builtinV("sum")), (OBJ:Iterable, .Vals)) => #sumAcc(OBJ, 0) ... </k>
    27	  rule <k> #applyK(toCall(builtinV("all")), (OBJ:Iterable, .Vals)) => #allAcc(OBJ)    ... </k>
    28	  rule <k> #applyK(toCall(builtinV("any")), (OBJ:Iterable, .Vals)) => #anyAcc(OBJ)    ... </k>
    29	  rule <k> #applyK(toCall(builtinV("max")), (OBJ:Iterable, .Vals)) => #maxAcc0(OBJ)   ... </k>
    30	  rule <k> #applyK(toCall(builtinV("min")), (OBJ:Iterable, .Vals)) => #minAcc0(OBJ)   ... </k>
    31	  rule <k> #applyK(toCall(builtinV(BN:String)), ACC:Vals) => applyBuiltin(BN, ACC) ... </k> [owise]
    32	  rule <k> #applyK(toCall(typeV(T:String)),     ACC:Vals) => applyBuiltin(T, ACC)  ... </k>
    33	
    34	  // ==== heap-object arguments/receivers =====================================
    35	  // Builtins and type calls READ structure — deref the first two arg positions
    36	  // (covers len/sum/all/any/max/min/sorted/list/set + zip's pair). Mutating list
    37	  // methods take the ref itself; every other method receiver is deref'd.
    38	  rule <k> #applyK(toCall(builtinV(BN:String)), (ref(H:Int), REST:Vals))
    39	        => #applyK(toCall(builtinV(BN)), (V, REST)) ... </k>
    40	       <heap> ... H |-> V:Val ... </heap>
    41	       [priority(40)]
    42	  rule <k> #applyK(toCall(builtinV(BN:String)), (A:Val, ref(H:Int), REST:Vals))
    43	        => #applyK(toCall(builtinV(BN)), (A, V, REST)) ... </k>
    44	       <heap> ... H |-> V:Val ... </heap>
    45	       requires notBool isRefV(A)
    46	       [priority(40)]
    47	  rule <k> #applyK(toCall(typeV(T:String)), (ref(H:Int), REST:Vals))
    48	        => #applyK(toCall(typeV(T)), (V, REST)) ... </k>
    49	       <heap> ... H |-> V:Val ... </heap>
    50	       [priority(40)]
    51	
    52	  syntax Bool ::= isMutMethod(String) [function, total]
    53	  rule isMutMethod(M:String)
    54	    => M ==String "append" orBool M ==String "sort" orBool M ==String "extend"
    55	       orBool M ==String "insert" orBool M ==String "pop" orBool M ==String "remove"
    56	  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), M:String)), ACC:Vals)
    57	        => #applyK(toCall(boundMethodV(V, M)), ACC) ... </k>
    58	       <heap> ... H |-> V:Val ... </heap>
    59	       requires notBool isMutMethod(M)
    60	       [priority(40)]
    61	  // non-mutating methods READ their heap-object arguments too (join's list);
    62	  // mutators keep refs (append of a list into a list-of-lists stays aliased)
    63	  rule <k> #applyK(toCall(boundMethodV(OBJ:Val, M:String)), (ref(H:Int), REST:Vals))
    64	        => #applyK(toCall(boundMethodV(OBJ, M)), (V, REST)) ... </k>
    65	       <heap> ... H |-> V:Val ... </heap>
    66	       requires notBool isMutMethod(M) andBool notBool isRefV(OBJ)
    67	       [priority(40)]
    68	
    69	  rule <k> #applyK(toCall(closureVal(PNS:ParamNames, BODY:Stmts, DEFL:Int)), ACC:Vals) ~> CONT
    70	        => #bindP(PNS, ACC) ~> BODY ~> #endcall </k>
    71	       <env>     CALLERL:Int => NEWL </env>
    72	       <scopes>   STORE:Map => STORE [ NEWL <- scope(.Map, parent(DEFL)) ] </scopes>
    73	       <scopeLoc> NEWL:Int => NEWL +Int 1 </scopeLoc>
    74	       <stack>   .List => ListItem(frame(CONT, CALLERL, NEWL)) ... </stack>
    75	
    76	  // annotated closure: the frame starts with the captured freevar cells, its
    77	  // parent is the module scope (all enclosing-local reads go through cells),
    78	  // and the cellvars' fresh cells allocate before params bind (a cellvar param
    79	  // then writes through its cell in #bindP).
    80	  rule <k> #applyK(toCall(closureValC(PNS:ParamNames, CVS:ParamNames, BODY:Stmts, CM:Map)), ACC:Vals) ~> CONT
    81	        => #allocCells(CVS) ~> #bindP(PNS, ACC) ~> BODY ~> #endcall </k>
    82	       <env>     CALLERL:Int => NEWL </env>
    83	       <scopes>   STORE:Map => STORE [ NEWL <- scope(CM [ "$cells" <- cellsMark(CVS) ], parent(0)) ] </scopes>
    84	       <scopeLoc> NEWL:Int => NEWL +Int 1 </scopeLoc>
    85	       <stack>   .List => ListItem(frame(CONT, CALLERL, NEWL)) ... </stack>
    86	
    87	  syntax KItem ::= #allocCells(ParamNames)
    88	  rule <k> #allocCells(.ParamNames) => .K ... </k>
    89	  rule <k> #allocCells((CV:String, R:ParamNames)) => #allocCells(R) ... </k>
    90	       <env> L:Int </env>
    91	       <scopes> ... L |-> scope(M:Map => M [ CV <- cellRef(N) ], _) ... </scopes>
    92	       <heap>    H:Map => (N |-> cellV(noneV)) H </heap>
    93	       <heapLoc> N:Int => N +Int 1 </heapLoc>
    94	       requires notBool N in_keys(H)
    95	endmodule
FILE reference-semantics/semantics/int.k
     1	// reference/src/semantics/int.k — MPY-INT
     2	// Int cases of the operator dispatch; Python // and % are floored (pyMod).
     3	
     4	module MPY-INT
     5	  imports MPY-CORE
     6	
     7	  rule applyUn("-", I:Int) => 0 -Int I
     8	
     9	  rule applyBin("+",  I1:Int, I2:Int) => I1 +Int I2
    10	  // Bool participates in int arithmetic (x += (a == b))
    11	  rule applyBin("+",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi
    12	  rule applyBin("+",  B:Bool, I:Int) => #if B #then 1 #else 0 #fi +Int I
    13	  rule applyBin("-",  I1:Int, I2:Int) => I1 -Int I2
    14	  rule applyBin("*",  I1:Int, I2:Int) => I1 *Int I2
    15	  rule applyBin("%",  I1:Int, I2:Int) => pyMod(I1, I2)
    16	  rule applyBin("//", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2
    17	  rule applyBin("**", I1:Int, I2:Int) => I1 ^Int I2 requires I2 >=Int 0
    18	
    19	  syntax Int ::= pyMod(Int, Int) [function]
    20	  rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2
    21	
    22	  rule applyCmp("<",  I1:Int, I2:Int)   => I1 <Int  I2
    23	  rule applyCmp("<=", I1:Int, I2:Int)   => I1 <=Int I2
    24	  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int  I2
    25	  rule applyCmp(">=", I1:Int, I2:Int)   => I1 >=Int I2
    26	  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2
    27	  rule applyCmp("!=", I1:Int, I2:Int)   => I1 =/=Int I2
    28	endmodule
FILE reference-semantics/semantics/bool.k
     1	// reference/src/semantics/bool.k — MPY-BOOL
     2	// Bool operator cases + the truthy boolean operations (not / and / or; and-or are
     3	// value-returning short-circuit over any Vals, per Python).
     4	
     5	module MPY-BOOL
     6	  imports MPY-CORE
     7	
     8	  rule applyUn("not", V:Val) => notBool truthy(V)
     9	
    10	  rule applyCmp("==", B1:Bool, B2:Bool) => B1 ==Bool B2
    11	  rule applyCmp("!=", B1:Bool, B2:Bool) => B1 =/=Bool B2
    12	
    13	  // ==== BoolOp: short-circuit, value-returning and / or =====================
    14	  // the node is its own accumulator: heat the HEAD element only, then either return it
    15	  // (short-circuit) or drop it and continue
    16	  context BoolOp(_, (HOLE:Expr, _:Exprs))
    17	  rule <k> BoolOp(_:String, (V:Val, .Exprs)) => V ... </k>
    18	  rule <k> BoolOp("and", (V:Val, A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
    19	       requires truthy(V)
    20	  rule <k> BoolOp("and", (V:Val, _:Expr, _:Exprs)) => V ... </k>
    21	       requires notBool truthy(V)
    22	  rule <k> BoolOp("or",  (V:Val, _:Expr, _:Exprs)) => V ... </k>
    23	       requires truthy(V)
    24	  rule <k> BoolOp("or",  (V:Val, A:Expr, REST:Exprs)) => BoolOp("or", (A, REST)) ... </k>
    25	       requires notBool truthy(V)
    26	
    27	  // ==== heap-object head: decide truthiness THROUGH the heap, never rewrite the
    28	  // operand — and/or return the OBJECT itself (Python identity), not its structure
    29	  rule <k> BoolOp(_:String, (ref(H:Int), .Exprs)) => ref(H) ... </k>
    30	       [priority(40)]
    31	  rule <k> BoolOp("and", (ref(H:Int), A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
    32	       <heap> ... H |-> V:Val ... </heap>
    33	       requires truthy(V)
    34	       [priority(40)]
    35	  rule <k> BoolOp("and", (ref(H:Int), _:Expr, _:Exprs)) => ref(H) ... </k>
    36	       <heap> ... H |-> V:Val ... </heap>
    37	       requires notBool truthy(V)
    38	       [priority(40)]
    39	  rule <k> BoolOp("or", (ref(H:Int), _:Expr, _:Exprs)) => ref(H) ... </k>
    40	       <heap> ... H |-> V:Val ... </heap>
    41	       requires truthy(V)
    42	       [priority(40)]
    43	  rule <k> BoolOp("or", (ref(H:Int), A:Expr, REST:Exprs)) => BoolOp("or", (A, REST)) ... </k>
    44	       <heap> ... H |-> V:Val ... </heap>
    45	       requires notBool truthy(V)
    46	       [priority(40)]
    47	endmodule
FILE reference-semantics/semantics/operators.k
     1	// reference/src/semantics/operators.k — MPY-OPERATORS
     2	// The operator DISPATCH layer: operands evaluate by strictness (heat/cool over KResult=Val),
     3	// the cooled node hands to applyUn/applyBin/applyCmp (declared in core.k; each domain file
     4	// owns its cases — bool.k, int.k, float.k, str.k, list.k, tuple.k, set.k, dict.k).
     5	
     6	module MPY-OPERATORS
     7	  imports MPY-CORE
     8	  imports MPY-ITER
     9	
    10	  rule <k> UnaryOp(OP:String, V:Val) => applyUn(OP, V) ... </k>
    11	
    12	  rule <k> BinOp(OP:String, L:Val, R:Val) => applyBin(OP, L, R) ... </k>
    13	
    14	  // Compare's right operand sits under the CmpOp wrapper — contexts instead of attributes
    15	  context Compare(HOLE, _)
    16	  context Compare(_:Val, CmpOp(_, HOLE))
    17	  rule <k> Compare(LV:Val, CmpOp(OP:String, RV:Val)) => applyCmp(OP, LV, RV) ... </k> [owise]
    18	
    19	  rule applyCmp("is",     V:Val, noneV) => V ==K noneV
    20	  rule applyCmp("is not", V:Val, noneV) => notBool (V ==K noneV)
    21	
    22	  // ==== operand deref: heap objects combine/compare by STRUCTURE ============
    23	  // (Python: list == is structural; identity only via `is`.) priority(40)
    24	  // preempts the generic dispatch so applyUn/applyBin/applyCmp never see a ref.
    25	  rule <k> BinOp(OP:String, ref(H:Int), R:Expr) => BinOp(OP, V, R) ... </k>
    26	       <heap> ... H |-> V:Val ... </heap>
    27	       [priority(40)]
    28	  rule <k> BinOp(OP:String, L:Val, ref(H:Int)) => BinOp(OP, L, V) ... </k>
    29	       <heap> ... H |-> V:Val ... </heap>
    30	       requires notBool isRefV(L)
    31	       [priority(40)]
    32	
    33	  // the left operand of `in`/`not in` is an ELEMENT (compares by ==K) — never deref'd
    34	  rule <k> Compare(ref(H:Int), CmpOp(OP:String, R:Expr)) => Compare(V, CmpOp(OP, R)) ... </k>
    35	       <heap> ... H |-> V:Val ... </heap>
    36	       requires OP =/=String "in" andBool OP =/=String "not in"
    37	       [priority(40)]
    38	  rule <k> Compare(L:Val, CmpOp(OP:String, ref(H:Int))) => Compare(L, CmpOp(OP, V)) ... </k>
    39	       <heap> ... H |-> V:Val ... </heap>
    40	       requires notBool isRefV(L)
    41	        orBool OP ==String "in" orBool OP ==String "not in"
    42	       [priority(40)]
    43	
    44	  rule <k> UnaryOp(OP:String, ref(H:Int)) => UnaryOp(OP, V) ... </k>
    45	       <heap> ... H |-> V:Val ... </heap>
    46	       [priority(40)]
    47	endmodule
FILE reference-semantics/semantics/iter.k
     1	// reference/src/semantics/iter.k — MPY-ITER
     2	// The iterator protocol, DECLARATION ONLY. Each iterable's #iterNext case lives in that
     3	// iterable's own module (list/tuple/str in their modules, rangeObj in range.k, zip in
     4	// builtins.k). Consumers (the for-loop, `x in _`, sum/all/any/max/min) import this.
     5	
     6	module MPY-ITER
     7	  imports MPY-CORE
     8	  syntax KItem ::= #iterNext(Iterable) | "#iterDone" | #iterYield(Val, Iterable)
     9	endmodule
FILE reference-semantics/semantics/list.k
     1	// reference/src/semantics/list.k — MPY-LIST
     2	
     3	module MPY-LIST
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	  imports MPY-OPERATORS
     7	
     8	  // ==== iteration (the iterator protocol's list case) =======================
     9	  rule <k> #iterNext(list(.ValSeq))                => #iterDone ... </k>
    10	  rule <k> #iterNext(list(vCons(V:Val, R:ValSeq))) => #iterYield(V, list(R)) ... </k>
    11	
    12	  // ==== ListExpr: [...] literal -> a fresh heap object =======================
    13	  syntax ApplyK ::= "toList"
    14	  rule <k> ListExpr(ES:Exprs) => #evalArgs(ES, .Vals, toList) ... </k>
    15	  rule <k> #applyK(toList, ACC:Vals) => #alloc(list(vals2valSeq(ACC))) ... </k>
    16	
    17	  // ==== list ops: + / == / != ===============================================
    18	  syntax ValSeq ::= valSeqConcat(ValSeq, ValSeq) [function, total]
    19	  rule valSeqConcat(.ValSeq, T:ValSeq)                => T
    20	  rule valSeqConcat(vCons(V:Val, S:ValSeq), T:ValSeq) => vCons(V, valSeqConcat(S, T))
    21	
    22	  // list + list constructs a NEW object (k-cell — it allocates; operands land here
    23	  // already deref'd). priority(45) beats the generic BinOp dispatch.
    24	  rule <k> BinOp("+", list(A:ValSeq), list(B:ValSeq)) => #alloc(list(valSeqConcat(A, B))) ... </k>
    25	       [priority(45)]
    26	
    27	  rule applyCmp("==", list(A:ValSeq), list(B:ValSeq)) => A ==K B
    28	  rule applyCmp("!=", list(A:ValSeq), list(B:ValSeq)) => notBool (A ==K B)
    29	
    30	  // ==== deep equality when elements are heap objects (list-of-lists) ========
    31	  // Python == is structural at every depth. Fires ONLY when a ref is present
    32	  // (the guard decides on concrete seqs); the plain ==K path above is unchanged.
    33	  syntax Bool ::= hasRefVS(ValSeq) [function, total]
    34	  rule hasRefVS(.ValSeq)                => false
    35	  rule hasRefVS(vCons(V:Val, R:ValSeq)) => isRefV(V) orBool hasRefVS(R)
    36	
    37	  syntax Bool ::= deepEqVS(ValSeq, ValSeq, Map) [function]
    38	                | deepEqV(Val, Val, Map)        [function]
    39	  rule deepEqVS(.ValSeq, .ValSeq, _:Map)                   => true
    40	  rule deepEqVS(.ValSeq, vCons(_:Val, _:ValSeq), _:Map)    => false
    41	  rule deepEqVS(vCons(_:Val, _:ValSeq), .ValSeq, _:Map)    => false
    42	  rule deepEqVS(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq), HP:Map)
    43	    => deepEqV(A, B, HP) andBool deepEqVS(As, Bs, HP)
    44	
    45	  rule deepEqV(ref(H:Int), B:Val, HP:Map) => deepEqV({HP[H]}:>Val, B, HP)
    46	       requires H in_keys(HP)
    47	  rule deepEqV(A:Val, ref(H:Int), HP:Map) => deepEqV(A, {HP[H]}:>Val, HP)
    48	       requires notBool isRefV(A) andBool H in_keys(HP)
    49	  rule deepEqV(list(A:ValSeq), list(B:ValSeq), HP:Map) => deepEqVS(A, B, HP)
    50	  rule deepEqV(A:Val, B:Val, _:Map) => A ==K B [owise]
    51	
    52	  // ==== mutator: xs.append(v) — an in-place heap write ======================
    53	  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), "append")), (V:Val, .Vals)) => noneV ... </k>
    54	       <heap> ... H |-> list(VS:ValSeq => valSeqConcat(VS, vCons(V, .ValSeq))) ... </heap>
    55	       [priority(40)]
    56	
    57	  // ==== `x in list` — a <k>-cell fold over #iterNext ========================
    58	  syntax KItem ::= #memberAcc(Val, Iterable) | #memberCont(Val) | "#notB"
    59	  rule <k> Compare(LV:Val, CmpOp("in",     list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ... </k>
    60	  rule <k> Compare(LV:Val, CmpOp("not in", list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ~> #notB ... </k>
    61	  rule <k> #memberAcc(V:Val, IT:Iterable) => #iterNext(IT) ~> #memberCont(V) ... </k>
    62	  rule <k> #iterDone ~> #memberCont(_V:Val) => false ... </k>
    63	  rule <k> #iterYield(E:Val, _:Iterable) ~> #memberCont(V:Val) => true ... </k>
    64	       requires E ==K V
    65	  rule <k> #iterYield(E:Val, R:Iterable) ~> #memberCont(V:Val) => #memberAcc(V, R) ... </k>
    66	       requires notBool (E ==K V)
    67	  rule <k> B:Bool ~> #notB => notBool B ... </k>
    68	endmodule

diff --git a/evidence/claim_witnesses.py b/evidence/claim_witnesses.py
new file mode 100644
index 0000000000000000000000000000000000000000..5ea1a18dd8c030804a011c25de2586b62516054f
--- /dev/null
+++ b/evidence/claim_witnesses.py
@@ -0,0 +1,82 @@
+#!/usr/bin/env python3
+"""Concrete satisfying states and substitutions for both formal claims."""
+
+from __future__ import annotations
+
+import importlib.util
+from pathlib import Path
+
+
+def load_pluck(path: Path, name: str):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.pluck
+
+
+def val_seq(values: list[int]) -> str:
+    result = ".ValSeq"
+    for value in reversed(values):
+        result = f"vCons({value}, {result})"
+    return result
+
+
+def scan_pluck(
+    values: list[int], best: int, best_index: int, index: int, last: int
+) -> tuple[int, int, int, int]:
+    for value in values:
+        if value % 2 == 0 and (best == -1 or value < best):
+            best = value
+            best_index = index
+        index += 1
+        last = value
+    return best, best_index, index, last
+
+
+def result_seq(values: list[int]) -> str:
+    best, best_index, _, _ = scan_pluck(values, -1, -1, 0, 0)
+    return ".ValSeq" if best == -1 else val_seq([best, best_index])
+
+
+def main() -> None:
+    canonical = load_pluck(Path("/reference/canonical.py"), "canonical_witness")
+    candidate = load_pluck(Path("/candidate/solution.py"), "candidate_witness")
+    entry_inputs = [[], [4, 2, 3], [5, 0, 3, 0, 4, 2], [7, 5, 9]]
+    for values in entry_inputs:
+        precondition = all(isinstance(value, int) and value >= 0 for value in values)
+        expected = result_seq(values)
+        canonical_result = canonical(list(values))
+        candidate_result = candidate(list(values))
+        python_as_seq = val_seq(candidate_result)
+        print(
+            f"ENTRY values={values} VS={val_seq(values)} "
+            f"allNonNegative={str(precondition).lower()} "
+            f"pluckResult={expected} canonical={canonical_result} "
+            f"candidate={candidate_result} python_result_seq={python_as_seq} "
+            f"agree={expected == python_as_seq and canonical_result == candidate_result}"
+        )
+        if not precondition or expected != python_as_seq or canonical_result != candidate_result:
+            raise SystemExit(1)
+
+    loop_values = [4, 2, 3]
+    loop_initial = (-1, -1, 0, 0)
+    loop_final = scan_pluck(loop_values, *loop_initial)
+    print(
+        "LOOP satisfying_state="
+        f"VS:{val_seq(loop_values)} B:{loop_initial[0]} BI:{loop_initial[1]} "
+        f"I:{loop_initial[2]} LAST:{loop_initial[3]} "
+        "L:1 ARR:ref(7) P:parent(0) K:.K "
+        "allNonNegative=true"
+    )
+    print(
+        "LOOP substituted_summary="
+        f"pstate({loop_final[0]}, {loop_final[1]}, "
+        f"{loop_final[2]}, {loop_final[3]})"
+    )
+    print("CLAIM_WITNESSES=PASS")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..a0c4416b01b65768841e67c244499a9087f83bcc
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,128 @@
+#!/usr/bin/env python3
+"""Independent differential test for trusted canonical.py and candidate solution.py."""
+
+from __future__ import annotations
+
+import importlib.util
+import json
+import random
+from pathlib import Path
+
+
+CANONICAL_PATH = Path("/reference/canonical.py")
+CANDIDATE_PATH = Path("/candidate/solution.py")
+CORPUS_PATH = Path("/audit-output/evidence/differential_corpus.json")
+SEED = 680068
+
+
+def load_function(path: Path, module_name: str):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.pluck
+
+
+def independent_oracle(values: list[int]) -> list[int]:
+    even_pairs = [
+        (value, index)
+        for index, value in enumerate(values)
+        if value % 2 == 0
+    ]
+    if not even_pairs:
+        return []
+    value, index = min(even_pairs)
+    return [value, index]
+
+
+def main() -> None:
+    canonical = load_function(CANONICAL_PATH, "trusted_canonical_68")
+    candidate = load_function(CANDIDATE_PATH, "candidate_solution_68")
+    fixed_cases: list[dict[str, object]] = [
+        {"label": "prompt-example-1", "input": [4, 2, 3], "expected": [2, 1]},
+        {"label": "prompt-example-2", "input": [1, 2, 3], "expected": [2, 1]},
+        {"label": "prompt-empty", "input": [], "expected": []},
+        {
+            "label": "prompt-example-4-duplicate-zero",
+            "input": [5, 0, 3, 0, 4, 2],
+            "expected": [0, 1],
+        },
+        {"label": "singleton-zero", "input": [0], "expected": [0, 0]},
+        {"label": "singleton-even", "input": [2], "expected": [2, 0]},
+        {"label": "singleton-odd", "input": [1], "expected": []},
+        {"label": "no-even", "input": [1, 3, 5, 7], "expected": []},
+        {"label": "first-even-sentinel-branch", "input": [9, 8], "expected": [8, 1]},
+        {"label": "later-smaller-update", "input": [8, 9, 6], "expected": [6, 2]},
+        {"label": "later-greater-no-update", "input": [2, 9, 8], "expected": [2, 0]},
+        {"label": "equal-tie-no-update", "input": [4, 7, 4], "expected": [4, 0]},
+        {"label": "zero-after-positive-even", "input": [8, 0], "expected": [0, 1]},
+        {
+            "label": "arbitrary-precision-values",
+            "input": [10**100 + 1, 10**100 + 2, 0, 10**100],
+            "expected": [0, 2],
+        },
+        {
+            "label": "maximum-documented-length",
+            "input": [9999] * 9999 + [2],
+            "expected": [2, 9999],
+        },
+    ]
+
+    rng = random.Random(SEED)
+    generated_inputs: list[list[int]] = []
+    for _ in range(2000):
+        length = rng.randrange(0, 129)
+        generated_inputs.append([rng.randrange(0, 10001) for _ in range(length)])
+    for _ in range(20):
+        length = rng.randrange(1000, 10001)
+        generated_inputs.append([rng.randrange(0, 1000001) for _ in range(length)])
+
+    corpus = {
+        "domain": "finite lists of nonnegative Python integers",
+        "seed": SEED,
+        "fixed_cases": fixed_cases,
+        "generated_inputs": generated_inputs,
+    }
+    CORPUS_PATH.write_text(json.dumps(corpus, separators=(",", ":")) + "\n")
+
+    mismatch_count = 0
+    for case in fixed_cases:
+        values = case["input"]
+        expected = case["expected"]
+        assert isinstance(values, list)
+        canonical_result = canonical(list(values))
+        candidate_result = candidate(list(values))
+        oracle_result = independent_oracle(list(values))
+        ok = canonical_result == candidate_result == oracle_result == expected
+        print(
+            f"FIXED label={case['label']} length={len(values)} "
+            f"canonical={canonical_result} candidate={candidate_result} "
+            f"oracle={oracle_result} expected={expected} ok={ok}"
+        )
+        mismatch_count += int(not ok)
+
+    for index, values in enumerate(generated_inputs):
+        canonical_result = canonical(list(values))
+        candidate_result = candidate(list(values))
+        oracle_result = independent_oracle(list(values))
+        if not (canonical_result == candidate_result == oracle_result):
+            mismatch_count += 1
+            print(
+                f"MISMATCH generated_index={index} input={values!r} "
+                f"canonical={canonical_result!r} candidate={candidate_result!r} "
+                f"oracle={oracle_result!r}"
+            )
+
+    print(f"seed={SEED}")
+    print(f"fixed_case_count={len(fixed_cases)}")
+    print(f"generated_case_count={len(generated_inputs)}")
+    print(f"total_case_count={len(fixed_cases) + len(generated_inputs)}")
+    print(f"mismatch_count={mismatch_count}")
+    if mismatch_count:
+        raise SystemExit(1)
+    print("DIFFERENTIAL=PASS")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/evidence/extract_claimed_program.py b/evidence/extract_claimed_program.py
new file mode 100644
index 0000000000000000000000000000000000000000..8bb0ff8cd28fdc5ec475e5e3a3cd730879c060dd
--- /dev/null
+++ b/evidence/extract_claimed_program.py
@@ -0,0 +1,66 @@
+#!/usr/bin/env python3
+"""Extract the complete #loadAll argument from the entry claim for K parsing."""
+
+from pathlib import Path
+
+
+SPEC = Path("/tmp/audit-work/candidate/spec.k")
+RAW_OUTPUT = Path("/audit-output/evidence/claimed_program_from_spec.kterm")
+OUTPUT = Path("/audit-output/evidence/claimed_program_from_spec.mpy")
+
+
+def main() -> None:
+    text = SPEC.read_text()
+    marker = "#loadAll("
+    if text.count(marker) != 1:
+        raise SystemExit(f"expected one {marker!r}, found {text.count(marker)}")
+    start = text.index(marker) + len(marker)
+    while text[start].isspace():
+        start += 1
+    if not text.startswith("Module(", start):
+        raise SystemExit("entry claim #loadAll argument does not begin with Module(")
+
+    depth = 0
+    in_string = False
+    escaped = False
+    end = None
+    for index in range(start, len(text)):
+        char = text[index]
+        if in_string:
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == '"':
+                in_string = False
+            continue
+        if char == '"':
+            in_string = True
+        elif char == "(":
+            depth += 1
+        elif char == ")":
+            depth -= 1
+            if depth == 0:
+                end = index + 1
+                break
+            if depth < 0:
+                raise SystemExit("unbalanced closing parenthesis")
+    if end is None:
+        raise SystemExit("unterminated Module term")
+    claimed_program = text[start:end] + "\n"
+    RAW_OUTPUT.write_text(claimed_program)
+    # .Stmts and .Exprs are the explicit K unit constructors accepted in a
+    # claim term. The MPY program parser spells the same units by omission.
+    parser_form = claimed_program.replace(".Stmts", "").replace(".Exprs", "")
+    OUTPUT.write_text(parser_form)
+    print(f"source={SPEC}")
+    print(f"raw_output={RAW_OUTPUT}")
+    print(f"output={OUTPUT}")
+    print(f"raw_chars={len(claimed_program)}")
+    print(f"parser_chars={len(parser_form)}")
+    print("normalization=remove explicit .Stmts/.Exprs unit spellings")
+    print("EXTRACTION=PASS")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/evidence/generation_records_inspect.py b/evidence/generation_records_inspect.py
new file mode 100644
index 0000000000000000000000000000000000000000..55bc263c36277afb3b93054eb6ab577b7c8e4ed9
--- /dev/null
+++ b/evidence/generation_records_inspect.py
@@ -0,0 +1,92 @@
+#!/usr/bin/env python3
+"""Read and summarize every required legacy-selected-stage1 generation record."""
+
+from __future__ import annotations
+
+import json
+from collections import Counter
+from pathlib import Path
+
+
+ROOT = Path("/generation-evidence")
+
+
+def clipped(value: object, limit: int = 320) -> str:
+    text = str(value).replace("\r", "\\r").replace("\n", "\\n")
+    return text if len(text) <= limit else text[:limit] + "...<clipped>"
+
+
+def main() -> None:
+    required_json = [
+        Path("/run.json"),
+        Path("/task.json"),
+        Path("/generation-result.json"),
+        ROOT / "invocation.json",
+        ROOT / "metrics.json",
+    ]
+    optional_json = [ROOT / "usage.json"]
+    for path in required_json + [p for p in optional_json if p.exists()]:
+        document = json.loads(path.read_text())
+        print(
+            f"JSON_OK path={path} top_type={type(document).__name__} "
+            f"top_keys={sorted(document) if isinstance(document, dict) else 'n/a'}"
+        )
+
+    prompt = (ROOT / "prompt.txt").read_text()
+    last = (ROOT / "codex-last.txt").read_text()
+    output = (ROOT / "codex-output.log").read_text()
+    print(f"PROMPT_READ chars={len(prompt)} lines={len(prompt.splitlines())}")
+    print(f"CODEX_LAST_READ chars={len(last)} lines={len(last.splitlines())}")
+    print(f"CODEX_OUTPUT_READ chars={len(output)} lines={len(output.splitlines())}")
+    print(f"CODEX_LAST={clipped(last, 1200)}")
+    markers = {
+        "#Top": output.count("#Top"),
+        "KPROVE_PASSED": output.count("KPROVE_PASSED"),
+        "kprove": output.count("kprove"),
+        "kompile": output.count("kompile"),
+        "krun": output.count("krun"),
+        "WarnStuckClaimState": output.count("WarnStuckClaimState"),
+        "[Error]": output.count("[Error]"),
+    }
+    print(f"CODEX_OUTPUT_MARKER_COUNTS={markers}")
+
+    top_types: Counter[str] = Counter()
+    payload_types: Counter[str] = Counter()
+    function_names: Counter[str] = Counter()
+    trace_records = 0
+    calls: list[tuple[str, str, str]] = []
+    assistant_messages: list[str] = []
+    for trace_path in sorted((ROOT / "codex-trace").rglob("*.jsonl")):
+        relative = trace_path.relative_to(ROOT)
+        with trace_path.open() as stream:
+            for line_number, line in enumerate(stream, 1):
+                item = json.loads(line)
+                trace_records += 1
+                top_types[str(item.get("type"))] += 1
+                payload = item.get("payload")
+                if not isinstance(payload, dict):
+                    continue
+                payload_type = str(payload.get("type"))
+                payload_types[payload_type] += 1
+                if payload_type in {"function_call", "custom_tool_call"}:
+                    name = str(payload.get("name"))
+                    function_names[name] += 1
+                    arguments = payload.get("arguments", payload.get("input", ""))
+                    calls.append((f"{relative}:{line_number}", name, clipped(arguments)))
+                if payload_type == "message" and payload.get("role") == "assistant":
+                    content = payload.get("content")
+                    assistant_messages.append(clipped(content, 1200))
+    print(f"TRACE_RECORDS_READ={trace_records}")
+    print(f"TRACE_TOP_TYPES={dict(sorted(top_types.items()))}")
+    print(f"TRACE_PAYLOAD_TYPES={dict(sorted(payload_types.items()))}")
+    print(f"TRACE_FUNCTION_NAMES={dict(sorted(function_names.items()))}")
+    print(f"TRACE_FUNCTION_CALLS={len(calls)}")
+    for location, name, arguments in calls:
+        print(f"CALL location={location} name={name} args={arguments}")
+    print(f"TRACE_ASSISTANT_MESSAGES={len(assistant_messages)}")
+    for index, message in enumerate(assistant_messages, 1):
+        print(f"ASSISTANT_MESSAGE[{index}]={message}")
+
+
+if __name__ == "__main__":
+    main()
