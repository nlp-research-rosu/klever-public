+    ],
+    "reference-semantics/semantics/iter.k": [(6, 9)],
+    "reference-semantics/semantics/operators.k": [(6, 17)],
+    "reference-semantics/semantics/int.k": [(4, 27)],
+    "reference-semantics/semantics/list.k": [(3, 20)],
