+requires "reference-semantics/semantics.k"
+
+module AUDIT-ITER-CONNECTION
+  imports MPY
+
+  // Same definitional cast as the candidate, but deliberately no operational
+  // iterator bridge is imported into this connection definition.
+  syntax Int ::= auditAsInt(Val) [function, total]
+  rule auditAsInt(I:Int) => I
+endmodule
+
+module AUDIT-ITER-CONNECTION-SPEC
+  imports AUDIT-ITER-CONNECTION
+
+  claim [fixed-list-iter-specialization]:
+    <k>
+      #iterNext(list(vCons(V:Val, REST:ValSeq))) ~> K:K
+      =>
+      #iterYield(auditAsInt(V), list(REST)) ~> K
+    </k>
+    requires isInt(V)
+
+  // The exact source-contract domain uses Int elements. This typed theorem
+  // checks every such element without relying on symbolic isInt narrowing.
+  claim [fixed-list-iter-int-domain]:
+    <k>
+      #iterNext(list(vCons(I:Int, REST:ValSeq))) ~> K:K
+      =>
+      #iterYield(auditAsInt(I), list(REST)) ~> K
+    </k>
+endmodule
