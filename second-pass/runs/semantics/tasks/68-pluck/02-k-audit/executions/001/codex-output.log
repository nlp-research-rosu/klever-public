       -1 |-> builtinsScope
     </scopes>
     <scopeLoc> 1 </scopeLoc>
-    <heap> .Map => 0 |-> list(pluckResult(VS)) </heap>
+    // Deliberately false mutation: every return is required to be the empty
+    // list, although input [4, 2, 3] satisfies the precondition and returns
+    // [2, 1]. This changes the result-bearing obligation only.
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
     <heapLoc> 0 => 1 </heapLoc>
     <stack> .List </stack>
     <ret> noRet </ret>
