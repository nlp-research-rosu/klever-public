+#!/usr/bin/env bash
+set +e
+cd /tmp/audit-work/68-pluck || exit 90
+
+show_bounded() {
+  local raw=$1
+  local lines
+  lines=$(wc -l <"$raw")
+  echo "lines=$lines"
+  if (( lines <= 180 )); then
+    sed -n '1,180p' "$raw"
+  else
+    sed -n '1,90p' "$raw"
+    echo "... [bounded log: middle omitted] ..."
+    tail -90 "$raw"
+  fi
+}
+
+echo '$ diff -u spec.k spec-vacuity.k'
+diff -u spec.k spec-vacuity.k
+diff_rc=$?
+echo "exit=$diff_rc (1 means the intended difference was present)"
