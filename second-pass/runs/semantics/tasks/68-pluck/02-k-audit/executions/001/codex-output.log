+
+echo '$ rg -c "^\\s*syntax\\b|^\\s*configuration\\b|^\\s*context(?: alias)?\\b|^\\s*rule\\b|^\\s*claim\\b" [all audited K sources]'
+rg -c '^\s*syntax\b|^\s*configuration\b|^\s*context(?: alias)?\b|^\s*rule\b|^\s*claim\b' "${files[@]}"
