+      --definition fixed-audit-kompiled \
+      --spec-module ITER-BRIDGE-CONNECTION \
+      --output pretty
+  proof_rc=$?
+else
+  proof_rc=99
+fi
+
+echo "SUMMARY build=$build_rc proof=$proof_rc"
+if (( build_rc != 0 || proof_rc != 0 )); then
+  exit 1
+fi
