+    sed -n '1,60p' "$raw"
+    echo "... [bounded log: middle omitted] ..."
+    tail -60 "$raw"
+  fi
+  return "$rc"
+}
+
+echo '$ rm -rf /tmp/audit-work/68-pluck/fixed-audit-kompiled'
+rm -rf /tmp/audit-work/68-pluck/fixed-audit-kompiled
+echo "exit=$?"
+
+run_bounded 05a_kompile_fixed \
