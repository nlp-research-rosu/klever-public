+              If(
+                Compare(
+                  BinOp("%", Name("value"), Int(2)),
+                  CmpOp("==", Int(0))),
+                If(
+                  Compare(
+                    Name("smallest"),
+                    CmpOp("==", UnaryOp("-", Int(1)))),
