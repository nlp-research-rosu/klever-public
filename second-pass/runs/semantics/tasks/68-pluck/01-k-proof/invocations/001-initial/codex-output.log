+                  Assign(Name("smallest_index"), Name("index")),
+                  If(
+                    Compare(
+                      Name("value"),
+                      CmpOp("<", Name("smallest"))),
+                    Assign(Name("smallest"), Name("value"))
+                    Assign(Name("smallest_index"), Name("index")),
+                    .Stmts)),
+                .Stmts)
+              AugAssign(Name("index"), "+", Int(1)))
+            If(
+              Compare(
+                Name("smallest"),
+                CmpOp("==", UnaryOp("-", Int(1)))),
+              Return(ListExpr(.Exprs)),
+              .Stmts)
+            Return(
+              ListExpr(
+                Name("smallest"),
+                Name("smallest_index")))))
+        )
+      ~> Call(Name("pluck"), list(VS:ValSeq))
+      => ref(0)
+    </k>
