+                Name("smallest"),
+                Name("smallest_index")))))
+        )
+      ~> Call(Name("pluck"), list(VS:ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
