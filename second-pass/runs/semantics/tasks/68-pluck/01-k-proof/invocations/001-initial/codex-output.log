/bin/bash -lc "python3 - <<'PY'
import random
from solution import pluck

def oracle(arr):
    evens = [(value, index) for index, value in enumerate(arr) if value % 2 == 0]
    return list(min(evens)) if evens else []

rng = random.Random(0)
for _ in range(10000):
    arr = [rng.randrange(0, 1000) for _ in range(rng.randrange(0, 100))]
    assert pluck(arr) == oracle(arr), arr
print('random oracle checks passed: 10000')
PY" in /work
