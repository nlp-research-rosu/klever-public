+requires "verification.k"
+
+module PLUCK-SPEC
+  imports PLUCK-VERIFICATION
+
+  claim [pluck-loop]:
+    <k>
+      #loop(
+        list(intsToVals(IS:IntSeq)),
+        Name("value"),
+        If(
+          Compare(
+            BinOp("%", Name("value"), Int(2)),
+            CmpOp("==", Int(0))),
+          If(
+            Compare(
+              Name("smallest"),
+              CmpOp("==", UnaryOp("-", Int(1)))),
+            Assign(Name("smallest"), Name("value"))
+            Assign(Name("smallest_index"), Name("index")),
+            If(
+              Compare(Name("value"), CmpOp("<", Name("smallest"))),
+              Assign(Name("smallest"), Name("value"))
+              Assign(Name("smallest_index"), Name("index")),
+              .Stmts)),
+          .Stmts)
+        AugAssign(Name("index"), "+", Int(1)))
+      ~> K:K
+      => K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        M:Map
+        "smallest" |-> B:Int
+        "smallest_index" |-> BI:Int
+        "index" |-> I:Int
+        "value" |-> LAST:Int,
+        P:Parent)
+      => L |-> scope(
+        M
+        "smallest" |-> stateBest(scanPluck(IS, B, BI, I, LAST))
+        "smallest_index" |-> stateBestIndex(scanPluck(IS, B, BI, I, LAST))
+        "index" |-> stateIndex(scanPluck(IS, B, BI, I, LAST))
+        "value" |-> stateLast(scanPluck(IS, B, BI, I, LAST)),
+        P) ...
+    </scopes>
+
+  claim [pluck-correct]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("pluck", Params("arr"),
+            Assign(Name("smallest"), UnaryOp("-", Int(1)))
+            Assign(Name("smallest_index"), UnaryOp("-", Int(1)))
+            Assign(Name("index"), Int(0))
+            Assign(Name("value"), Int(0))
+            For(Name("value"), Name("arr"),
+              If(
+                Compare(
+                  BinOp("%", Name("value"), Int(2)),
+                  CmpOp("==", Int(0))),
+                If(
+                  Compare(
+                    Name("smallest"),
+                    CmpOp("==", UnaryOp("-", Int(1)))),
+                  Assign(Name("smallest"), Name("value"))
+                  Assign(Name("smallest_index"), Name("index")),
+                  If(
+                    Compare(
+                      Name("value"),
+                      CmpOp("<", Name("smallest"))),
+                    Assign(Name("smallest"), Name("value"))
+                    Assign(Name("smallest_index"), Name("index")),
+                    .Stmts)),
+                .Stmts)
+              AugAssign(Name("index"), "+", Int(1)))
+            If(
+              Compare(
+                Name("smallest"),
+                CmpOp("==", UnaryOp("-", Int(1)))),
+              Return(ListExpr(.Exprs)),
+              .Stmts)
+            Return(
+              ListExpr(
+                Name("smallest"),
+                Name("smallest_index")))))
+        )
+      ~> Call(Name("pluck"), list(intsToVals(IS:IntSeq)))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "pluck" |-> closureVal(
+          "arr",
+          Assign(Name("smallest"), UnaryOp("-", Int(1)))
+          Assign(Name("smallest_index"), UnaryOp("-", Int(1)))
+          Assign(Name("index"), Int(0))
+          Assign(Name("value"), Int(0))
+          For(Name("value"), Name("arr"),
+            If(
+              Compare(
+                BinOp("%", Name("value"), Int(2)),
+                CmpOp("==", Int(0))),
+              If(
+                Compare(
+                  Name("smallest"),
+                  CmpOp("==", UnaryOp("-", Int(1)))),
+                Assign(Name("smallest"), Name("value"))
+                Assign(Name("smallest_index"), Name("index")),
+                If(
+                  Compare(
+                    Name("value"),
+                    CmpOp("<", Name("smallest"))),
+                  Assign(Name("smallest"), Name("value"))
+                  Assign(Name("smallest_index"), Name("index")),
+                  .Stmts)),
+              .Stmts)
+            AugAssign(Name("index"), "+", Int(1)))
+          If(
+            Compare(
+              Name("smallest"),
+              CmpOp("==", UnaryOp("-", Int(1)))),
+            Return(ListExpr(.Exprs)),
+            .Stmts)
+          Return(
+            ListExpr(
+              Name("smallest"),
+              Name("smallest_index"))),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(pluckResult(IS)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNonNegative(IS)
+endmodule
