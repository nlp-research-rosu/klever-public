+              Compare(
+                BinOp("%", Name("value"), Int(2)),
+                CmpOp("==", Int(0))),
+              If(
+                Compare(
+                  Name("smallest"),
+                  CmpOp("==", UnaryOp("-", Int(1)))),
+                Assign(Name("smallest"), Name("value"))
+                Assign(Name("smallest_index"), Name("index")),
+                If(
+                  Compare(
+                    Name("value"),
+                    CmpOp("<", Name("smallest"))),
+                  Assign(Name("smallest"), Name("value"))
+                  Assign(Name("smallest_index"), Name("index")),
+                  .Stmts)),
