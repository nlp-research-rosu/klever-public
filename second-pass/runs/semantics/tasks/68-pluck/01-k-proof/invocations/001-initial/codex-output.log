+  syntax Int ::= stateBest(PluckState) [function, total]
+               | stateBestIndex(PluckState) [function, total]
+               | stateIndex(PluckState) [function, total]
+               | stateLast(PluckState) [function, total]
+  rule stateBest(pstate(B:Int, _:Int, _:Int, _:Int)) => B
+  rule stateBestIndex(pstate(_:Int, BI:Int, _:Int, _:Int)) => BI
+  rule stateIndex(pstate(_:Int, _:Int, I:Int, _:Int)) => I
+  rule stateLast(pstate(_:Int, _:Int, _:Int, LAST:Int)) => LAST
+
+  syntax ValSeq ::= pluckResult(ValSeq) [function]
+                  | resultFromState(PluckState) [function, total]
+  rule pluckResult(VS:ValSeq)
+    => resultFromState(scanPluck(VS, -1, -1, 0, 0))
+  rule resultFromState(pstate(-1, _:Int, _:Int, _:Int))
+    => .ValSeq
+  rule resultFromState(pstate(B:Int, BI:Int, _:Int, _:Int))
+    => vCons(B, vCons(BI, .ValSeq))
+    requires B =/=Int -1
+
+  // The HumanEval precondition: every node is non-negative.
+  syntax Bool ::= allNonNegative(ValSeq) [function]
+  rule allNonNegative(.ValSeq) => true
+  rule allNonNegative(vCons(I:Int, REST:ValSeq))
+    => I >=Int 0 andBool allNonNegative(REST)
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..76da0f62edfe7c3fdebf0b86298432a6a57ff1ca
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,18 @@
+def pluck(arr):
+    smallest = -1
+    smallest_index = -1
+    index = 0
+    value = 0
+    for value in arr:
+        if value % 2 == 0:
+            if smallest == -1:
+                smallest = value
+                smallest_index = index
+            else:
+                if value < smallest:
+                    smallest = value
+                    smallest_index = index
+        index += 1
+    if smallest == -1:
+        return []
+    return [smallest, smallest_index]
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..60bca8b91524fe565983e4709b6dc65a5ed031ab
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,147 @@
+requires "verification.k"
+
+module PLUCK-SPEC
+  imports PLUCK-VERIFICATION
+
+  claim [pluck-loop]:
+    <k>
+      #loop(
+        list(VS:ValSeq),
+        Name("value"),
+        If(
+          Compare(
+            BinOp("%", Name("value"), Int(2)),
+            CmpOp("==", Int(0))),
+          If(
+            Compare(
+              Name("smallest"),
+              CmpOp("==", UnaryOp("-", Int(1)))),
+            Assign(Name("smallest"), Name("value"))
+            Assign(Name("smallest_index"), Name("index")),
+            If(
+              Compare(Name("value"), CmpOp("<", Name("smallest"))),
+              Assign(Name("smallest"), Name("value"))
+              Assign(Name("smallest_index"), Name("index")),
+              .Stmts)),
+          .Stmts)
+        AugAssign(Name("index"), "+", Int(1)))
+      ~> K:K
+      => K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "arr" |-> ARR:Val
+        "smallest" |-> B:Int
+        "smallest_index" |-> BI:Int
+        "index" |-> I:Int
+        "value" |-> LAST:Int,
+        P:Parent)
+      => L |-> scope(
+        "arr" |-> ARR
+        "smallest" |-> stateBest(scanPluck(VS, B, BI, I, LAST))
+        "smallest_index" |-> stateBestIndex(scanPluck(VS, B, BI, I, LAST))
+        "index" |-> stateIndex(scanPluck(VS, B, BI, I, LAST))
+        "value" |-> stateLast(scanPluck(VS, B, BI, I, LAST)),
+        P) ...
+    </scopes>
+    requires allNonNegative(VS)
+
+  claim [pluck-correct]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("pluck", Params("arr"),
+            Assign(Name("smallest"), UnaryOp("-", Int(1)))
+            Assign(Name("smallest_index"), UnaryOp("-", Int(1)))
+            Assign(Name("index"), Int(0))
+            Assign(Name("value"), Int(0))
+            For(Name("value"), Name("arr"),
+              If(
+                Compare(
+                  BinOp("%", Name("value"), Int(2)),
+                  CmpOp("==", Int(0))),
+                If(
+                  Compare(
+                    Name("smallest"),
+                    CmpOp("==", UnaryOp("-", Int(1)))),
+                  Assign(Name("smallest"), Name("value"))
+                  Assign(Name("smallest_index"), Name("index")),
+                  If(
+                    Compare(
+                      Name("value"),
+                      CmpOp("<", Name("smallest"))),
+                    Assign(Name("smallest"), Name("value"))
+                    Assign(Name("smallest_index"), Name("index")),
+                    .Stmts)),
+                .Stmts)
+              AugAssign(Name("index"), "+", Int(1)))
+            If(
+              Compare(
+                Name("smallest"),
+                CmpOp("==", UnaryOp("-", Int(1)))),
+              Return(ListExpr(.Exprs)),
+              .Stmts)
+            Return(
+              ListExpr(
+                Name("smallest"),
+                Name("smallest_index")))))
+        )
+      ~> Call(Name("pluck"), list(VS:ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "pluck" |-> closureVal(
+          "arr",
+          Assign(Name("smallest"), UnaryOp("-", Int(1)))
+          Assign(Name("smallest_index"), UnaryOp("-", Int(1)))
+          Assign(Name("index"), Int(0))
+          Assign(Name("value"), Int(0))
+          For(Name("value"), Name("arr"),
+            If(
+              Compare(
+                BinOp("%", Name("value"), Int(2)),
+                CmpOp("==", Int(0))),
+              If(
+                Compare(
+                  Name("smallest"),
+                  CmpOp("==", UnaryOp("-", Int(1)))),
+                Assign(Name("smallest"), Name("value"))
+                Assign(Name("smallest_index"), Name("index")),
+                If(
+                  Compare(
+                    Name("value"),
+                    CmpOp("<", Name("smallest"))),
+                  Assign(Name("smallest"), Name("value"))
+                  Assign(Name("smallest_index"), Name("index")),
+                  .Stmts)),
+              .Stmts)
+            AugAssign(Name("index"), "+", Int(1)))
+          If(
+            Compare(
+              Name("smallest"),
+              CmpOp("==", UnaryOp("-", Int(1)))),
+            Return(ListExpr(.Exprs)),
+            .Stmts)
+          Return(
+            ListExpr(
+              Name("smallest"),
+              Name("smallest_index"))),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(pluckResult(VS)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNonNegative(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..55f48a40ade4b39fa0929a3edc10621c749dcd29
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,63 @@
+requires "reference-semantics/semantics.k"
+
+module PLUCK-VERIFICATION
+  imports MPY
+
+  // The predicate exactly captures when the implementation replaces its
+  // current candidate.  B == -1 represents "no even value seen yet".
+  syntax Bool ::= pluckTake(Int, Int) [function, total]
+  rule pluckTake(V:Int, B:Int)
+    => pyMod(V, 2) ==Int 0
+       andBool (B ==Int -1 orBool V <Int B)
+
+  syntax Int ::= nextBest(Int, Int) [function, total]
+               | nextBestIndex(Int, Int, Int, Int) [function, total]
+  rule nextBest(V:Int, B:Int) => V
+    requires pluckTake(V, B)
+  rule nextBest(V:Int, B:Int) => B
+    requires notBool pluckTake(V, B)
+  rule nextBestIndex(V:Int, B:Int, _:Int, I:Int) => I
+    requires pluckTake(V, B)
+  rule nextBestIndex(V:Int, B:Int, BI:Int, _:Int) => BI
+    requires notBool pluckTake(V, B)
+
+  // Functional reference fold used by the invariant and final contract.
+  syntax PluckState ::= pstate(Int, Int, Int, Int)
+  syntax PluckState ::= scanPluck(ValSeq, Int, Int, Int, Int)
+                        [function]
+  rule scanPluck(.ValSeq, B:Int, BI:Int, I:Int, LAST:Int)
+    => pstate(B, BI, I, LAST)
+  rule scanPluck(vCons(V:Int, REST:ValSeq),
+                 B:Int, BI:Int, I:Int, _:Int)
+    => scanPluck(
+         REST,
+         nextBest(V, B),
+         nextBestIndex(V, B, BI, I),
+         I +Int 1,
+         V)
+
+  syntax Int ::= stateBest(PluckState) [function, total]
+               | stateBestIndex(PluckState) [function, total]
+               | stateIndex(PluckState) [function, total]
+               | stateLast(PluckState) [function, total]
+  rule stateBest(pstate(B:Int, _:Int, _:Int, _:Int)) => B
+  rule stateBestIndex(pstate(_:Int, BI:Int, _:Int, _:Int)) => BI
+  rule stateIndex(pstate(_:Int, _:Int, I:Int, _:Int)) => I
+  rule stateLast(pstate(_:Int, _:Int, _:Int, LAST:Int)) => LAST
+
+  syntax ValSeq ::= pluckResult(ValSeq) [function]
+                  | resultFromState(PluckState) [function, total]
+  rule pluckResult(VS:ValSeq)
+    => resultFromState(scanPluck(VS, -1, -1, 0, 0))
+  rule resultFromState(pstate(-1, _:Int, _:Int, _:Int))
+    => .ValSeq
+  rule resultFromState(pstate(B:Int, BI:Int, _:Int, _:Int))
+    => vCons(B, vCons(BI, .ValSeq))
+    requires B =/=Int -1
+
+  // The HumanEval precondition: every node is non-negative.
+  syntax Bool ::= allNonNegative(ValSeq) [function]
+  rule allNonNegative(.ValSeq) => true
+  rule allNonNegative(vCons(I:Int, REST:ValSeq))
+    => I >=Int 0 andBool allNonNegative(REST)
+endmodule

