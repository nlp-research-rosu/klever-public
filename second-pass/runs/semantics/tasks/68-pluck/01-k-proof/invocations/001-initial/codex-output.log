index 0000000000000000000000000000000000000000..dd26ed6ea7b1bf03850ffe0d1a3de4e3b53e9a16
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,69 @@
+requires "reference-semantics/semantics.k"
+
+module PLUCK-VERIFICATION
+  imports MPY
+
+  // Embed the contract's integer arrays into the semantics' value sequences.
+  syntax ValSeq ::= intsToVals(IntSeq) [function, total]
+  rule intsToVals(.IntSeq) => .ValSeq
+  rule intsToVals(iCons(I:Int, IS:IntSeq))
+    => vCons(I, intsToVals(IS))
+
+  // The predicate exactly captures when the implementation replaces its
+  // current candidate.  B == -1 represents "no even value seen yet".
+  syntax Bool ::= pluckTake(Int, Int) [function, total]
+  rule pluckTake(V:Int, B:Int)
+    => pyMod(V, 2) ==Int 0
+       andBool (B ==Int -1 orBool V <Int B)
+
+  syntax Int ::= nextBest(Int, Int) [function, total]
+               | nextBestIndex(Int, Int, Int, Int) [function, total]
+  rule nextBest(V:Int, B:Int) => V
+    requires pluckTake(V, B)
+  rule nextBest(V:Int, B:Int) => B
+    requires notBool pluckTake(V, B)
+  rule nextBestIndex(V:Int, B:Int, _:Int, I:Int) => I
+    requires pluckTake(V, B)
+  rule nextBestIndex(V:Int, B:Int, BI:Int, _:Int) => BI
+    requires notBool pluckTake(V, B)
+
+  // Functional reference fold used by the invariant and final contract.
+  syntax PluckState ::= pstate(Int, Int, Int, Int)
+  syntax PluckState ::= scanPluck(IntSeq, Int, Int, Int, Int)
+                        [function, total]
+  rule scanPluck(.IntSeq, B:Int, BI:Int, I:Int, LAST:Int)
+    => pstate(B, BI, I, LAST)
+  rule scanPluck(iCons(V:Int, REST:IntSeq),
+                 B:Int, BI:Int, I:Int, _:Int)
+    => scanPluck(
+         REST,
+         nextBest(V, B),
+         nextBestIndex(V, B, BI, I),
+         I +Int 1,
+         V)
+
+  syntax Int ::= stateBest(PluckState) [function, total]
+               | stateBestIndex(PluckState) [function, total]
+               | stateIndex(PluckState) [function, total]
+               | stateLast(PluckState) [function, total]
+  rule stateBest(pstate(B:Int, _:Int, _:Int, _:Int)) => B
+  rule stateBestIndex(pstate(_:Int, BI:Int, _:Int, _:Int)) => BI
+  rule stateIndex(pstate(_:Int, _:Int, I:Int, _:Int)) => I
+  rule stateLast(pstate(_:Int, _:Int, _:Int, LAST:Int)) => LAST
+
+  syntax ValSeq ::= pluckResult(IntSeq) [function, total]
+                  | resultFromState(PluckState) [function, total]
+  rule pluckResult(IS:IntSeq)
+    => resultFromState(scanPluck(IS, -1, -1, 0, 0))
+  rule resultFromState(pstate(-1, _:Int, _:Int, _:Int))
+    => .ValSeq
+  rule resultFromState(pstate(B:Int, BI:Int, _:Int, _:Int))
+    => vCons(B, vCons(BI, .ValSeq))
+    requires B =/=Int -1
+
+  // The HumanEval precondition: every node is non-negative.
+  syntax Bool ::= allNonNegative(IntSeq) [function, total]
+  rule allNonNegative(.IntSeq) => true
+  rule allNonNegative(iCons(I:Int, REST:IntSeq))
+    => I >=Int 0 andBool allNonNegative(REST)
+endmodule

codex
The implementation and its `.mpy` translation are now in place and pass the prompt examples plus tie/no-even cases in CPython. I’ve encoded a mathematical fold for “first index of the smallest even value” and am now checking whether the loop invariant is accepted and inductive under K’s symbolic semantics.
exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module PLUCK-VERIFICATION --syntax-module MPY-SYNTAX --output-definition proof-kompiled' in /work
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..76da0f62edfe7c3fdebf0b86298432a6a57ff1ca
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,18 @@
+def pluck(arr):
+    smallest = -1
+    smallest_index = -1
+    index = 0
+    value = 0
+    for value in arr:
+        if value % 2 == 0:
+            if smallest == -1:
+                smallest = value
+                smallest_index = index
+            else:
+                if value < smallest:
+                    smallest = value
+                    smallest_index = index
+        index += 1
+    if smallest == -1:
+        return []
+    return [smallest, smallest_index]
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..974683828cd49ba646b1661f27256f9e603deb67
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,146 @@
+requires "verification.k"
+
+module PLUCK-SPEC
+  imports PLUCK-VERIFICATION
+
+  claim [pluck-loop]:
+    <k>
+      #loop(
+        list(intsToVals(IS:IntSeq)),
+        Name("value"),
+        If(
+          Compare(
+            BinOp("%", Name("value"), Int(2)),
+            CmpOp("==", Int(0))),
+          If(
+            Compare(
+              Name("smallest"),
+              CmpOp("==", UnaryOp("-", Int(1)))),
+            Assign(Name("smallest"), Name("value"))
+            Assign(Name("smallest_index"), Name("index")),
+            If(
+              Compare(Name("value"), CmpOp("<", Name("smallest"))),
+              Assign(Name("smallest"), Name("value"))
+              Assign(Name("smallest_index"), Name("index")),
+              .Stmts)),
+          .Stmts)
+        AugAssign(Name("index"), "+", Int(1)))
+      ~> K:K
+      => K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        M:Map
+        "smallest" |-> B:Int
+        "smallest_index" |-> BI:Int
+        "index" |-> I:Int
+        "value" |-> LAST:Int,
+        P:Parent)
+      => L |-> scope(
+        M
+        "smallest" |-> stateBest(scanPluck(IS, B, BI, I, LAST))
+        "smallest_index" |-> stateBestIndex(scanPluck(IS, B, BI, I, LAST))
+        "index" |-> stateIndex(scanPluck(IS, B, BI, I, LAST))
+        "value" |-> stateLast(scanPluck(IS, B, BI, I, LAST)),
+        P) ...
+    </scopes>
+
+  claim [pluck-correct]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("pluck", Params("arr"),
+            Assign(Name("smallest"), UnaryOp("-", Int(1)))
+            Assign(Name("smallest_index"), UnaryOp("-", Int(1)))
+            Assign(Name("index"), Int(0))
+            Assign(Name("value"), Int(0))
+            For(Name("value"), Name("arr"),
+              If(
+                Compare(
+                  BinOp("%", Name("value"), Int(2)),
+                  CmpOp("==", Int(0))),
+                If(
+                  Compare(
+                    Name("smallest"),
+                    CmpOp("==", UnaryOp("-", Int(1)))),
+                  Assign(Name("smallest"), Name("value"))
+                  Assign(Name("smallest_index"), Name("index")),
+                  If(
+                    Compare(
+                      Name("value"),
+                      CmpOp("<", Name("smallest"))),
+                    Assign(Name("smallest"), Name("value"))
+                    Assign(Name("smallest_index"), Name("index")),
+                    .Stmts)),
+                .Stmts)
+              AugAssign(Name("index"), "+", Int(1)))
+            If(
+              Compare(
+                Name("smallest"),
+                CmpOp("==", UnaryOp("-", Int(1)))),
+              Return(ListExpr()),
+              .Stmts)
+            Return(
+              ListExpr(
+                Name("smallest"),
+                Name("smallest_index")))))
+        )
+      ~> Call(Name("pluck"), list(intsToVals(IS:IntSeq)))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "pluck" |-> closureVal(
+          "arr",
+          Assign(Name("smallest"), UnaryOp("-", Int(1)))
+          Assign(Name("smallest_index"), UnaryOp("-", Int(1)))
+          Assign(Name("index"), Int(0))
+          Assign(Name("value"), Int(0))
+          For(Name("value"), Name("arr"),
+            If(
+              Compare(
+                BinOp("%", Name("value"), Int(2)),
+                CmpOp("==", Int(0))),
+              If(
+                Compare(
+                  Name("smallest"),
+                  CmpOp("==", UnaryOp("-", Int(1)))),
+                Assign(Name("smallest"), Name("value"))
+                Assign(Name("smallest_index"), Name("index")),
+                If(
+                  Compare(
+                    Name("value"),
+                    CmpOp("<", Name("smallest"))),
+                  Assign(Name("smallest"), Name("value"))
+                  Assign(Name("smallest_index"), Name("index")),
+                  .Stmts)),
+              .Stmts)
+            AugAssign(Name("index"), "+", Int(1)))
+          If(
+            Compare(
+              Name("smallest"),
+              CmpOp("==", UnaryOp("-", Int(1)))),
+            Return(ListExpr()),
+            .Stmts)
+          Return(
+            ListExpr(
+              Name("smallest"),
+              Name("smallest_index"))),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(pluckResult(IS)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allNonNegative(IS)
+endmodule
