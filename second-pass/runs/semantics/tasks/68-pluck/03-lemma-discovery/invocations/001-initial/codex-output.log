requires "reference-semantics/semantics.k"

module PLUCK-VERIFICATION
  imports MPY

  syntax Int ::= asInt(Val) [function, total]
  rule asInt(I:Int) => I

  // Derived specialization of MPY-LIST's iterator rule.  Its higher priority
  // exposes the contract's integer element sort to symbolic execution; for
  // concrete integer lists it has exactly the same right-hand side as MPY.
  rule <k> #iterNext(list(vCons(V:Val, REST:ValSeq)))
        => #iterYield(asInt(V), list(REST)) ... </k>
       requires isInt(V)
       [priority(40)]

  // The predicate exactly captures when the implementation replaces its
  // current candidate.  B == -1 represents "no even value seen yet".
  syntax Bool ::= pluckTake(Int, Int) [function, total]
  rule pluckTake(V:Int, B:Int)
    => pyMod(V, 2) ==Int 0
       andBool (B ==Int -1 orBool V <Int B)

  syntax Int ::= nextBest(Int, Int) [function, total]
               | nextBestIndex(Int, Int, Int, Int) [function, total]
  rule nextBest(V:Int, B:Int) => V
    requires pyMod(V, 2) ==Int 0 andBool B ==Int -1
  rule nextBest(V:Int, B:Int) => V
    requires pyMod(V, 2) ==Int 0
     andBool B =/=Int -1 andBool V <Int B
  rule nextBest(V:Int, B:Int) => B
    requires pyMod(V, 2) =/=Int 0
  rule nextBest(V:Int, B:Int) => B
    requires pyMod(V, 2) ==Int 0
     andBool B =/=Int -1 andBool V >=Int B
  rule nextBestIndex(V:Int, B:Int, _:Int, I:Int) => I
    requires pyMod(V, 2) ==Int 0 andBool B ==Int -1
  rule nextBestIndex(V:Int, B:Int, _:Int, I:Int) => I
    requires pyMod(V, 2) ==Int 0
     andBool B =/=Int -1 andBool V <Int B
  rule nextBestIndex(V:Int, _B:Int, BI:Int, _:Int) => BI
    requires pyMod(V, 2) =/=Int 0
  rule nextBestIndex(V:Int, B:Int, BI:Int, _:Int) => BI
    requires pyMod(V, 2) ==Int 0
     andBool B =/=Int -1 andBool V >=Int B

  // Functional reference fold used by the invariant and final contract.
  syntax PluckState ::= pstate(Int, Int, Int, Int)
  syntax PluckState ::= scanPluck(ValSeq, Int, Int, Int, Int)
                        [function, total]
  rule scanPluck(.ValSeq, B:Int, BI:Int, I:Int, LAST:Int)
    => pstate(B, BI, I, LAST)
  rule scanPluck(vCons(V:Val, REST:ValSeq),
                 B:Int, BI:Int, I:Int, _:Int)
    => scanPluck(
         REST,
         nextBest(asInt(V), B),
         nextBestIndex(asInt(V), B, BI, I),
         I +Int 1,
         asInt(V))

  syntax Int ::= stateBest(PluckState) [function, total]
               | stateBestIndex(PluckState) [function, total]
               | stateIndex(PluckState) [function, total]
               | stateLast(PluckState) [function, total]
  rule stateBest(pstate(B:Int, _:Int, _:Int, _:Int)) => B
  rule stateBestIndex(pstate(_:Int, BI:Int, _:Int, _:Int)) => BI
  rule stateIndex(pstate(_:Int, _:Int, I:Int, _:Int)) => I
  rule stateLast(pstate(_:Int, _:Int, _:Int, LAST:Int)) => LAST

  syntax ValSeq ::= pluckResult(ValSeq) [function, total]
  rule pluckResult(VS:ValSeq)
    => .ValSeq
    requires stateBest(scanPluck(VS, -1, -1, 0, 0)) ==Int -1
  rule pluckResult(VS:ValSeq)
    => vCons(
         stateBest(scanPluck(VS, -1, -1, 0, 0)),
         vCons(
           stateBestIndex(scanPluck(VS, -1, -1, 0, 0)),
           .ValSeq))
    requires stateBest(scanPluck(VS, -1, -1, 0, 0)) =/=Int -1

  // The HumanEval precondition: every node is non-negative.
  syntax Bool ::= allNonNegative(ValSeq) [function, total]
  rule allNonNegative(.ValSeq) => true
  rule allNonNegative(vCons(V:Val, REST:ValSeq))
    => isInt(V)
       andBool asInt(V) >=Int 0
       andBool allNonNegative(REST)
endmodule
requires "verification.k"

module PLUCK-SPEC
  imports PLUCK-VERIFICATION

  claim [pluck-loop]:
    <k>
      #loop(
        list(VS:ValSeq),
        Name("value"),
        If(
          Compare(
            BinOp("%", Name("value"), Int(2)),
            CmpOp("==", Int(0))),
          If(
            Compare(
              Name("smallest"),
              CmpOp("==", UnaryOp("-", Int(1)))),
            Assign(Name("smallest"), Name("value"))
            Assign(Name("smallest_index"), Name("index")),
            If(
              Compare(Name("value"), CmpOp("<", Name("smallest"))),
              Assign(Name("smallest"), Name("value"))
              Assign(Name("smallest_index"), Name("index")),
              .Stmts)),
          .Stmts)
        AugAssign(Name("index"), "+", Int(1)))
      ~> K:K
      => K
    </k>
    <env> L:Int </env>
    <scopes>
      ... L |-> scope(
        "arr" |-> ARR:Val
        "smallest" |-> B:Int
        "smallest_index" |-> BI:Int
        "index" |-> I:Int
        "value" |-> LAST:Int,
        P:Parent)
      => L |-> scope(
        "arr" |-> ARR
        "smallest" |-> stateBest(scanPluck(VS, B, BI, I, LAST))
        "smallest_index" |-> stateBestIndex(scanPluck(VS, B, BI, I, LAST))
        "index" |-> stateIndex(scanPluck(VS, B, BI, I, LAST))
        "value" |-> stateLast(scanPluck(VS, B, BI, I, LAST)),
        P) ...
    </scopes>
    requires allNonNegative(VS)

  claim [pluck-correct]:
    <k>
      #loadAll(
        Module(
          FuncDef("pluck", Params("arr"),
            Assign(Name("smallest"), UnaryOp("-", Int(1)))
            Assign(Name("smallest_index"), UnaryOp("-", Int(1)))
            Assign(Name("index"), Int(0))
            Assign(Name("value"), Int(0))
            For(Name("value"), Name("arr"),
              If(
                Compare(
                  BinOp("%", Name("value"), Int(2)),
                  CmpOp("==", Int(0))),
                If(
                  Compare(
                    Name("smallest"),
                    CmpOp("==", UnaryOp("-", Int(1)))),
                  Assign(Name("smallest"), Name("value"))
                  Assign(Name("smallest_index"), Name("index")),
                  If(
                    Compare(
                      Name("value"),
                      CmpOp("<", Name("smallest"))),
                    Assign(Name("smallest"), Name("value"))
                    Assign(Name("smallest_index"), Name("index")),
                    .Stmts)),
                .Stmts)
              AugAssign(Name("index"), "+", Int(1)))
            If(
              Compare(
                Name("smallest"),
                CmpOp("==", UnaryOp("-", Int(1)))),
              Return(ListExpr(.Exprs)),
              .Stmts)
            Return(
              ListExpr(
                Name("smallest"),
                Name("smallest_index")))))
        )
      ~> Call(Name("pluck"), list(VS:ValSeq))
      => ref(0)
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
      =>
      0 |-> scope(
        "pluck" |-> closureVal(
          "arr",
          Assign(Name("smallest"), UnaryOp("-", Int(1)))
          Assign(Name("smallest_index"), UnaryOp("-", Int(1)))
          Assign(Name("index"), Int(0))
          Assign(Name("value"), Int(0))
          For(Name("value"), Name("arr"),
            If(
              Compare(
                BinOp("%", Name("value"), Int(2)),
                CmpOp("==", Int(0))),
              If(
                Compare(
                  Name("smallest"),
                  CmpOp("==", UnaryOp("-", Int(1)))),
                Assign(Name("smallest"), Name("value"))
                Assign(Name("smallest_index"), Name("index")),
                If(
                  Compare(
                    Name("value"),
                    CmpOp("<", Name("smallest"))),
                  Assign(Name("smallest"), Name("value"))
                  Assign(Name("smallest_index"), Name("index")),
                  .Stmts)),
              .Stmts)
            AugAssign(Name("index"), "+", Int(1)))
          If(
            Compare(
              Name("smallest"),
              CmpOp("==", UnaryOp("-", Int(1)))),
            Return(ListExpr(.Exprs)),
            .Stmts)
          Return(
            ListExpr(
              Name("smallest"),
              Name("smallest_index"))),
          0),
        parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map => 0 |-> list(pluckResult(VS)) </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires allNonNegative(VS)
endmodule
#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py concrete_tests.py > concrete_tests.mpy

kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun solution.mpy --definition runtime-kompiled
krun concrete_tests.mpy --definition runtime-kompiled

kompile verification.k \
  --backend haskell \
  --main-module PLUCK-VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition proof-kompiled

# First prove the induction lemma over the arbitrary input tail.
kprove spec.k \
  --definition proof-kompiled \
  --spec-module PLUCK-SPEC \
  --claims PLUCK-SPEC.pluck-loop \
  --output pretty

# Then prove module loading, call/return, and the result contract, using only
# the induction lemma proved by the preceding command as a trusted dependency.
kprove spec.k \
  --definition proof-kompiled \
  --spec-module PLUCK-SPEC \
  --claims PLUCK-SPEC.pluck-correct,PLUCK-SPEC.pluck-loop \
  --trusted PLUCK-SPEC.pluck-loop \
  --output pretty

