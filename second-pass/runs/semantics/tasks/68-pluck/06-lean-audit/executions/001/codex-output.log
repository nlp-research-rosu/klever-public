+        (GENERATION / "trust-inventory.json").read_text()
+    )
+    obligation_map = json.loads(
+        (GENERATED / "obligation-map.json").read_text()
+    )
+    toolchain_lock = json.loads(
+        Path("/reference/klean-toolchain.lock.json").read_text()
