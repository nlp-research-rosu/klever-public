+                "span": [rule["start_line"], rule["end_line"]],
+                "text_exact": extracted == rule["text"],
+                "normalized_sha256": mismatch(
+                    rule["normalized_sha256"], normalized_sha256
+                ),
+                "source_rule_id_recomputed": mismatch(
