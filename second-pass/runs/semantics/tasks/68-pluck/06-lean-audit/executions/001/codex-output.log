new file mode 100644
index 0000000000000000000000000000000000000000..617a66bc1eb21061b9f864de4d2d751d106004de
--- /dev/null
+++ b//tmp/audit-work/readlinklog.c
@@ -0,0 +1,28 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    ssize_t result = real_readlink(path, buffer, size);
+    int saved_errno = errno;
+    dprintf(
+        STDERR_FILENO,
+        "AUDIT READLINK path=%s result=%zd errno=%d pid=%d\n",
+        path,
+        result,
+        saved_errno,
+        getpid()
+    );
+    errno = saved_errno;
+    return result;
+}
diff --git a/audit_checks.py b/audit_checks.py
