+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List", "Optional")
+        FuncDef("longest", Params("strings"),
+          Assign(Name("result"), NoneVal)
+          For(Name("string"), Name("strings"),
+            If(Compare(Name("result"), CmpOp("is", NoneVal)),
+              Assign(Name("result"), Name("string")),
+              If(Compare(
+                Call(Name("len"), Name("string")),
+                CmpOp(">", Call(Name("len"), Name("result")))),
+                Assign(Name("result"), Name("string")),
+                .Stmts)))
+          Return(Name("result")))
+        Assign(Name("answer"),
+          Call(Name("longest"), list(stringVals(INPUT:StringSeq)), .Exprs))))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+      => 0 |-> scope(
+           "answer" |-> longestAcc(noneV, INPUT)
+           "longest" |-> closureVal("strings",
+             Assign(Name("result"), NoneVal)
+             For(Name("string"), Name("strings"),
+               If(Compare(Name("result"), CmpOp("is", NoneVal)),
+                 Assign(Name("result"), Name("string")),
+                 If(Compare(
+                   Call(Name("len"), Name("string")),
+                   CmpOp(">", Call(Name("len"), Name("result")))),
+                   Assign(Name("result"), Name("string")),
+                   .Stmts)))
+             Return(Name("result")),
+             0),
+           parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
