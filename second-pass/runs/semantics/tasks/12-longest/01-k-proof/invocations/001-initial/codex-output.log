index 0000000000000000000000000000000000000000..bf2fa50e8808a2fe4773e134fbfb630991210256
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+from typing import List, Optional
+
+
+def longest(strings: List[str]) -> Optional[str]:
+    result = None
+    string = None
+    for string in strings:
+        if result is None:
+            result = string
+        elif len(string) <= len(result):
+            result = result
+        elif len(string) > len(result):
+            result = string
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e057519428de22db73b6a86eb9d0f9994b806f97
