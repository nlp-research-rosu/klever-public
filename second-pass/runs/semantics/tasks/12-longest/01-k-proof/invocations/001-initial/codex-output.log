+         "strings" |-> ARG:Val
+         "result" |-> noneV
+         "string" |-> CURRENT:Val,
+         parent(0))
+      => 0 |-> scope("longest" |-> CLOSURE, parent(-1))
+         -1 |-> builtinsScope)
