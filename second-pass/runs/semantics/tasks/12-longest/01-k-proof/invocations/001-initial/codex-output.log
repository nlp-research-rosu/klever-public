+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant.  The function frame is popped at the destination, so
+  // loop-local updates disappear and only the returned accumulator remains.
+  claim
+    <k>
+      (#loop(list(stringVals(.StringSeq)), Name("string"),
+        If(Compare(Name("result"), CmpOp("is", NoneVal)),
+          Assign(Name("result"), Name("string")),
+          If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp("<=", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("result")),
+            If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp(">", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("string")),
+            .Stmts))))
+      ~> Return(Name("result"))
+      ~> #endcall)
+      => (noneV ~> CONT:K)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope("longest" |-> CLOSURE:Val, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope(
+         "strings" |-> ARG:Val
+         "result" |-> noneV
+         "string" |-> CURRENT:Val,
+         parent(0))
+      => 0 |-> scope("longest" |-> CLOSURE, parent(-1))
+         -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1)) RESTSTACK:List
+      => RESTSTACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(loop-init-empty)]
+
+  // The first string replaces the None sentinel unconditionally.
+  claim
+    <k>
+      (#loop(list(stringVals(sCons(CS:IntSeq, REST:StringSeq))), Name("string"),
+        If(Compare(Name("result"), CmpOp("is", NoneVal)),
+          Assign(Name("result"), Name("string")),
+          If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp("<=", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("result")),
+            If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp(">", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("string")),
+            .Stmts))))
+      ~> Return(Name("result"))
+      ~> #endcall)
+      => (longestAcc(str(CS), REST) ~> CONT:K)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope("longest" |-> CLOSURE:Val, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope(
+         "strings" |-> ARG:Val
+         "result" |-> noneV
+         "string" |-> CURRENT:Val,
+         parent(0))
+      => 0 |-> scope("longest" |-> CLOSURE, parent(-1))
+         -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1)) RESTSTACK:List
+      => RESTSTACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(loop-init-cons)]
+
+  // String-accumulator base case.
+  claim
+    <k>
+      (#loop(list(stringVals(.StringSeq)), Name("string"),
+        If(Compare(Name("result"), CmpOp("is", NoneVal)),
+          Assign(Name("result"), Name("string")),
+          If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp("<=", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("result")),
+            If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp(">", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("string")),
+            .Stmts))))
+      ~> Return(Name("result"))
+      ~> #endcall)
+      => (str(BESTCODES:IntSeq) ~> CONT:K)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope("longest" |-> CLOSURE:Val, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope(
+         "strings" |-> ARG:Val
+         "result" |-> str(BESTCODES)
+         "string" |-> CURRENT:Val,
+         parent(0))
+      => 0 |-> scope("longest" |-> CLOSURE, parent(-1))
+         -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1)) RESTSTACK:List
+      => RESTSTACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(loop-empty)]
+
+  // A strictly longer head replaces the accumulator.
+  claim
+    <k>
+      (#loop(list(stringVals(sCons(CS:IntSeq, REST:StringSeq))), Name("string"),
+        If(Compare(Name("result"), CmpOp("is", NoneVal)),
+          Assign(Name("result"), Name("string")),
+          If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp("<=", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("result")),
+            If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp(">", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("string")),
+            .Stmts))))
+      ~> Return(Name("result"))
+      ~> #endcall)
+      => (longestAcc(str(CS), REST) ~> CONT:K)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope("longest" |-> CLOSURE:Val, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope(
+         "strings" |-> ARG:Val
+         "result" |-> str(BESTCODES:IntSeq)
+         "string" |-> CURRENT:Val,
+         parent(0))
+      => 0 |-> scope("longest" |-> CLOSURE, parent(-1))
+         -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1)) RESTSTACK:List
+      => RESTSTACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires isLen(CS) >Int isLen(BESTCODES)
+    [label(loop-longer)]
+
+  // A shorter or tied head retains the earlier accumulator.
+  claim
+    <k>
+      (#loop(list(stringVals(sCons(CS:IntSeq, REST:StringSeq))), Name("string"),
+        If(Compare(Name("result"), CmpOp("is", NoneVal)),
+          Assign(Name("result"), Name("string")),
+          If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp("<=", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("result")),
+            If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp(">", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("string")),
+            .Stmts))))
+      ~> Return(Name("result"))
+      ~> #endcall)
+      => (longestAcc(str(BESTCODES:IntSeq), REST) ~> CONT:K)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope("longest" |-> CLOSURE:Val, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope(
+         "strings" |-> ARG:Val
+         "result" |-> str(BESTCODES)
+         "string" |-> CURRENT:Val,
+         parent(0))
+      => 0 |-> scope("longest" |-> CLOSURE, parent(-1))
+         -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1)) RESTSTACK:List
+      => RESTSTACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires isLen(CS) <=Int isLen(BESTCODES)
+    [label(loop-retain)]
+
+  // Loading solution.mpy installs exactly the closure used below.
+  claim
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List", "Optional")
+        FuncDef("longest", Params("strings"),
+          Assign(Name("result"), NoneVal)
+          Assign(Name("string"), NoneVal)
+          For(Name("string"), Name("strings"),
+            If(Compare(Name("result"), CmpOp("is", NoneVal)),
+              Assign(Name("result"), Name("string")),
+              If(Compare(
+                Call(Name("len"), Name("string")),
+                CmpOp("<=", Call(Name("len"), Name("result")))),
+                Assign(Name("result"), Name("result")),
+                If(Compare(
+                  Call(Name("len"), Name("string")),
+                  CmpOp(">", Call(Name("len"), Name("result")))),
+                  Assign(Name("result"), Name("string")),
+                  .Stmts))))
+          Return(Name("result")))))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+      => 0 |-> scope("longest" |-> longestSolution, parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(load-solution)]
+
+  // Calls cover the two constructors of every finite string sequence.
+  claim
+    <k>
+      Call(Name("longest"), list(stringVals(.StringSeq)), .Exprs)
+      => noneV
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("longest" |-> longestSolution, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(call-empty)]
+
+  claim
+    <k>
+      Call(Name("longest"),
+        list(stringVals(sCons(HEAD:IntSeq, TAIL:StringSeq))),
+        .Exprs)
+      => (#bindP(("strings", .ParamNames),
+                 (list(stringVals(sCons(HEAD, TAIL))), .Vals))
+          ~> (Assign(Name("result"), NoneVal)
+              Assign(Name("string"), NoneVal)
+              For(Name("string"), Name("strings"),
+                If(Compare(Name("result"), CmpOp("is", NoneVal)),
+                  Assign(Name("result"), Name("string")),
+                  If(Compare(
+                    Call(Name("len"), Name("string")),
+                    CmpOp("<=", Call(Name("len"), Name("result")))),
+                    Assign(Name("result"), Name("result")),
+                    If(Compare(
+                      Call(Name("len"), Name("string")),
+                      CmpOp(">", Call(Name("len"), Name("result")))),
+                      Assign(Name("result"), Name("string")),
+                      .Stmts))))
+              Return(Name("result")))
+          ~> #endcall)
+    </k>
+    <env> 0 => 1 </env>
+    <scopes>
+      (0 |-> scope("longest" |-> longestSolution, parent(-1))
+       -1 |-> builtinsScope
+      => 0 |-> scope("longest" |-> longestSolution, parent(-1))
+         -1 |-> builtinsScope
+         1 |-> scope(.Map, parent(0)))
+    </scopes>
+    <scopeLoc> 1 => 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List => ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(call-cons-dispatch)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b536f89f628505dacd4f76bf157507be09e12ccd
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,58 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A proof-domain sequence containing only strings.  stringVals embeds it
+  // into the ValSeq used by the supplied Python semantics.
+  syntax StringSeq ::= ".StringSeq"
+                     | sCons(IntSeq, StringSeq)
+
+  syntax ValSeq ::= stringVals(StringSeq)
+  rule stringVals(.StringSeq) => .ValSeq
+  rule stringVals(sCons(CS:IntSeq, REST:StringSeq))
+    => vCons(str(CS), stringVals(REST))
+
+  // Symbolic iterator equations for the embedded sequence.  They are the two
+  // MPY-LIST iterator rules composed with the stringVals equations above.
+  rule <k> #iterNext(list(stringVals(.StringSeq))) => #iterDone ... </k>
+       [priority(40)]
+  rule <k> #iterNext(list(stringVals(sCons(CS:IntSeq, REST:StringSeq))))
+        => #iterYield(str(CS), list(stringVals(REST))) ... </k>
+       [priority(40)]
+
+  // Mathematical left fold for the contract.  Strict comparison is
+  // deliberate: on a tie the existing (earlier) result is retained.
+  syntax Val ::= longestAcc(Val, StringSeq) [function, total]
+  rule longestAcc(BEST:Val, .StringSeq) => BEST
+  rule longestAcc(noneV, sCons(CS:IntSeq, REST:StringSeq))
+    => longestAcc(str(CS), REST)
+  rule longestAcc(str(BEST:IntSeq), sCons(CS:IntSeq, REST:StringSeq))
+    => longestAcc(str(CS), REST)
+    requires isLen(CS) >Int isLen(BEST)
+  rule longestAcc(str(BEST:IntSeq), sCons(CS:IntSeq, REST:StringSeq))
+    => longestAcc(str(BEST), REST)
+    requires isLen(CS) <=Int isLen(BEST)
+
+  // Exact closure produced by loading solution.mpy; used to keep the call
+  // theorems compact while still tying them to the translated program.
+  syntax Val ::= "longestSolution" [macro]
+  rule longestSolution
+    => closureVal("strings",
+         Assign(Name("result"), NoneVal)
+         Assign(Name("string"), NoneVal)
+         For(Name("string"), Name("strings"),
+           If(Compare(Name("result"), CmpOp("is", NoneVal)),
+             Assign(Name("result"), Name("string")),
+             If(Compare(
+               Call(Name("len"), Name("string")),
+               CmpOp("<=", Call(Name("len"), Name("result")))),
+               Assign(Name("result"), Name("result")),
+               If(Compare(
+                 Call(Name("len"), Name("string")),
+                 CmpOp(">", Call(Name("len"), Name("result")))),
+                 Assign(Name("result"), Name("string")),
+                 .Stmts))))
+         Return(Name("result")),
+         0)
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --claims call-cons-dispatch' in /work
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..b27ef934d072345b67fc00fec074065bf29d780e
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,21 @@
+from typing import List, Optional
+
+
+def longest(strings: List[str]) -> Optional[str]:
+    result = None
+    string = None
+    for string in strings:
+        if result is None:
+            result = string
+        elif len(string) <= len(result):
+            result = result
+        elif len(string) > len(result):
+            result = string
+    return result
+
+
+assert longest([]) is None
+assert longest(["a", "b", "c"]) == "a"
+assert longest(["a", "bb", "ccc"]) == "ccc"
+assert longest(["first", "x", "later"]) == "first"
+assert longest(["", ""]) == ""
