+            CmpOp("<=", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("result")),
+            If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp(">", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("string")),
+            .Stmts))))
+      ~> Return(Name("result"))
+      ~> #endcall)
+      => (noneV ~> CONT:K)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope("longest" |-> CLOSURE:Val, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope(
+         "strings" |-> ARG:Val
+         "result" |-> noneV
+         "string" |-> CURRENT:Val,
+         parent(0))
+      => 0 |-> scope("longest" |-> CLOSURE, parent(-1))
+         -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1)) RESTSTACK:List
+      => RESTSTACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(loop-init-empty)]
+
+  // The first string replaces the None sentinel unconditionally.
+  claim
+    <k>
+      (#loop(list(stringVals(sCons(CS:IntSeq, REST:StringSeq))), Name("string"),
+        If(Compare(Name("result"), CmpOp("is", NoneVal)),
+          Assign(Name("result"), Name("string")),
+          If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp("<=", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("result")),
+            If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp(">", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("string")),
+            .Stmts))))
+      ~> Return(Name("result"))
+      ~> #endcall)
+      => (longestAcc(str(CS), REST) ~> CONT:K)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope("longest" |-> CLOSURE:Val, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope(
+         "strings" |-> ARG:Val
+         "result" |-> noneV
+         "string" |-> CURRENT:Val,
+         parent(0))
+      => 0 |-> scope("longest" |-> CLOSURE, parent(-1))
+         -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1)) RESTSTACK:List
+      => RESTSTACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(loop-init-cons)]
+
+  // String-accumulator base case.
+  claim
+    <k>
+      (#loop(list(stringVals(.StringSeq)), Name("string"),
+        If(Compare(Name("result"), CmpOp("is", NoneVal)),
+          Assign(Name("result"), Name("string")),
+          If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp("<=", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("result")),
+            If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp(">", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("string")),
+            .Stmts))))
+      ~> Return(Name("result"))
+      ~> #endcall)
+      => (str(BESTCODES:IntSeq) ~> CONT:K)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope("longest" |-> CLOSURE:Val, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope(
+         "strings" |-> ARG:Val
+         "result" |-> str(BESTCODES)
+         "string" |-> CURRENT:Val,
+         parent(0))
+      => 0 |-> scope("longest" |-> CLOSURE, parent(-1))
+         -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1)) RESTSTACK:List
+      => RESTSTACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(loop-empty)]
