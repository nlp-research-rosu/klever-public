+      (0 |-> scope("longest" |-> CLOSURE:Val, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope(
+         "strings" |-> ARG:Val
+         "result" |-> noneV
+         "string" |-> CURRENT:Val,
+         parent(0))
+      => 0 |-> scope("longest" |-> CLOSURE, parent(-1))
+         -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack>
