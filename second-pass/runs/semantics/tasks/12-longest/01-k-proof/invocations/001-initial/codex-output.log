diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d831042350ad33cf47659cad19979ad0ff0ce70d
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,134 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant.  The function frame is popped at the destination, so
+  // loop-local updates disappear and only the returned accumulator remains.
+  claim
+    <k>
+      (#loop(list(stringVals(INPUT:StringSeq)), Name("string"),
+        If(Compare(Name("result"), CmpOp("is", NoneVal)),
+          Assign(Name("result"), Name("string")),
+          If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp(">", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("string")),
+            .Stmts)))
+      ~> Return(Name("result"))
+      ~> #endcall)
+      => (longestAcc(noneV, INPUT) ~> CONT:K)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope("longest" |-> CLOSURE:Val, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope(
+         "strings" |-> ARG:Val
+         "result" |-> noneV
+         "string" |-> CURRENT:Val,
+         parent(0))
+      => 0 |-> scope("longest" |-> CLOSURE, parent(-1))
+         -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1)) RESTSTACK:List
+      => RESTSTACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Recursive invariant after the first element has established a string
+  // accumulator.  This separate shape excludes impossible non-string values.
+  claim
+    <k>
+      (#loop(list(stringVals(INPUT:StringSeq)), Name("string"),
+        If(Compare(Name("result"), CmpOp("is", NoneVal)),
+          Assign(Name("result"), Name("string")),
+          If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp(">", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("string")),
+            .Stmts)))
+      ~> Return(Name("result"))
+      ~> #endcall)
+      => (longestAcc(str(BESTCODES:IntSeq), INPUT) ~> CONT:K)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope("longest" |-> CLOSURE:Val, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope(
+         "strings" |-> ARG:Val
+         "result" |-> str(BESTCODES)
+         "string" |-> CURRENT:Val,
+         parent(0))
+      => 0 |-> scope("longest" |-> CLOSURE, parent(-1))
+         -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, 0, 1)) RESTSTACK:List
+      => RESTSTACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // End-to-end theorem for the translated solution on every finite list of
+  // strings, from the standard initial MPY configuration.
+  claim
+    <k>
+      #loadAll(Module(
+        ImportFrom("typing", "List", "Optional")
+        FuncDef("longest", Params("strings"),
+          Assign(Name("result"), NoneVal)
+          Assign(Name("string"), NoneVal)
+          For(Name("string"), Name("strings"),
+            If(Compare(Name("result"), CmpOp("is", NoneVal)),
+              Assign(Name("result"), Name("string")),
+              If(Compare(
+                Call(Name("len"), Name("string")),
+                CmpOp(">", Call(Name("len"), Name("result")))),
+                Assign(Name("result"), Name("string")),
+                .Stmts)))
+          Return(Name("result")))
+        Assign(Name("answer"),
+          Call(Name("longest"), list(stringVals(ALL:StringSeq)), .Exprs))))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+      => 0 |-> scope(
+           "answer" |-> longestAcc(noneV, ALL)
+           "longest" |-> closureVal("strings",
+             Assign(Name("result"), NoneVal)
+             Assign(Name("string"), NoneVal)
+             For(Name("string"), Name("strings"),
+               If(Compare(Name("result"), CmpOp("is", NoneVal)),
+                 Assign(Name("result"), Name("string")),
+                 If(Compare(
+                   Call(Name("len"), Name("string")),
+                   CmpOp(">", Call(Name("len"), Name("result")))),
+                   Assign(Name("result"), Name("string")),
+                   .Stmts)))
+             Return(Name("result")),
+             0),
+           parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
