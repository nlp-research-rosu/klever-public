+requires "verification.k"
+
+module VERIFICATION-DISPATCH-MUTANT
+  imports VERIFICATION
+
+  // Deliberately wrong implementation: it executes the submitted loop but
+  // discards the accumulator and always returns None.
+  syntax Val ::= "longestMutant" [macro]
+  rule longestMutant
+    => closureVal("strings",
+         Assign(Name("result"), NoneVal)
+         Assign(Name("string"), NoneVal)
+         For(Name("string"), Name("strings"),
+           If(Compare(Name("result"), CmpOp("is", NoneVal)),
+             Assign(Name("result"), Name("string")),
+             If(Compare(
+               Call(Name("len"), Name("string")),
+               CmpOp("<=", Call(Name("len"), Name("result")))),
+               Assign(Name("result"), Name("result")),
+               If(Compare(
+                 Call(Name("len"), Name("string")),
+                 CmpOp(">", Call(Name("len"), Name("result")))),
+                 Assign(Name("result"), Name("string")),
+                 .Stmts))))
+         Return(NoneVal),
+         0)
+endmodule
diff --git a/evidence/verification-no-iter-bridge.k b/evidence/verification-no-iter-bridge.k
new file mode 100644
index 0000000000000000000000000000000000000000..85ac7737fa0267812ddf04e29f1491da693069a2
--- /dev/null
+++ b/evidence/verification-no-iter-bridge.k
@@ -0,0 +1,13 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-NO-ITER-BRIDGE
+  imports MPY
+
+  syntax StringSeq ::= ".StringSeq"
+                     | sCons(IntSeq, StringSeq)
+
+  syntax ValSeq ::= stringVals(StringSeq)
+  rule stringVals(.StringSeq) => .ValSeq
+  rule stringVals(sCons(CS:IntSeq, REST:StringSeq))
+    => vCons(str(CS), stringVals(REST))
