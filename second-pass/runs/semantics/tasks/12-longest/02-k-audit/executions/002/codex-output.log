+                      .Stmts))))
+              Return(NoneVal))
+          ~> #endcall)
+    </k>
+    <env> 0 => 1 </env>
+    <scopes>
+      (0 |-> scope("longest" |-> longestMutant, parent(-1))
+       -1 |-> builtinsScope
+      => 0 |-> scope("longest" |-> longestMutant, parent(-1))
+         -1 |-> builtinsScope
+         1 |-> scope(.Map, parent(0)))
