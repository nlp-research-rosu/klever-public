index 0000000000000000000000000000000000000000..046bbd06e49d19703da0e474c6fc90cb287df935
--- /dev/null
+++ b/evidence/spec-dispatch-mutant.k
@@ -0,0 +1,48 @@
+requires "verification-dispatch-mutant.k"
+
+module SPEC-DISPATCH-MUTANT
+  imports VERIFICATION-DISPATCH-MUTANT
+
+  // The candidate's entry-theorem shape still closes for the wrong body,
+  // because its destination is only that body's initial call frame.
+  claim
+    <k>
+      Call(Name("longest"),
+        list(stringVals(sCons(HEAD:IntSeq, TAIL:StringSeq))),
+        .Exprs)
+      => (#bindP(("strings", .ParamNames),
+                 (list(stringVals(sCons(HEAD, TAIL))), .Vals))
+          ~> (Assign(Name("result"), NoneVal)
+              Assign(Name("string"), NoneVal)
+              For(Name("string"), Name("strings"),
+                If(Compare(Name("result"), CmpOp("is", NoneVal)),
+                  Assign(Name("result"), Name("string")),
+                  If(Compare(
+                    Call(Name("len"), Name("string")),
+                    CmpOp("<=", Call(Name("len"), Name("result")))),
+                    Assign(Name("result"), Name("result")),
+                    If(Compare(
+                      Call(Name("len"), Name("string")),
+                      CmpOp(">", Call(Name("len"), Name("result")))),
+                      Assign(Name("result"), Name("string")),
+                      .Stmts))))
+              Return(NoneVal))
+          ~> #endcall)
+    </k>
+    <env> 0 => 1 </env>
+    <scopes>
+      (0 |-> scope("longest" |-> longestMutant, parent(-1))
+       -1 |-> builtinsScope
+      => 0 |-> scope("longest" |-> longestMutant, parent(-1))
+         -1 |-> builtinsScope
+         1 |-> scope(.Map, parent(0)))
+    </scopes>
+    <scopeLoc> 1 => 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List => ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(call-cons-dispatch-mutant)]
+endmodule
diff --git a/evidence/verification-dispatch-mutant.k b/evidence/verification-dispatch-mutant.k
new file mode 100644
index 0000000000000000000000000000000000000000..dbbca48387d3f34ca8a7f56323978a89abf66f54
--- /dev/null
+++ b/evidence/verification-dispatch-mutant.k
@@ -0,0 +1,27 @@
+requires "verification.k"
+
+module VERIFICATION-DISPATCH-MUTANT
+  imports VERIFICATION
+
+  // Deliberately wrong implementation: it executes the submitted loop but
+  // discards the accumulator and always returns None.
+  syntax Val ::= "longestMutant" [macro]
+  rule longestMutant
+    => closureVal("strings",
+         Assign(Name("result"), NoneVal)
+         Assign(Name("string"), NoneVal)
+         For(Name("string"), Name("strings"),
+           If(Compare(Name("result"), CmpOp("is", NoneVal)),
+             Assign(Name("result"), Name("string")),
+             If(Compare(
+               Call(Name("len"), Name("string")),
+               CmpOp("<=", Call(Name("len"), Name("result")))),
+               Assign(Name("result"), Name("result")),
+               If(Compare(
+                 Call(Name("len"), Name("string")),
+                 CmpOp(">", Call(Name("len"), Name("result")))),
+                 Assign(Name("result"), Name("string")),
+                 .Stmts))))
+         Return(NoneVal),
+         0)
+endmodule

