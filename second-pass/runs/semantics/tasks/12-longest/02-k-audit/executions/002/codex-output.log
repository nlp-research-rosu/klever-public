+      => REST
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |-> scope(.Map, parent(0))
+       => 1 |-> scope("strings" |-> ARG, parent(0)))
+      OTHER:Map
+    </scopes>
+    [label(bind-input-step)]
+
+  claim
+    <k>
+      Assign(Name("result"), NoneVal) ~> REST:K
+      => REST
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |-> scope("strings" |-> ARG:Val, parent(0))
+       => 1 |-> scope(
+            "strings" |-> ARG
+            "result" |-> noneV,
+            parent(0)))
+      OTHER:Map
+    </scopes>
+    [label(init-result-step)]
+
+  claim
+    <k>
+      Assign(Name("string"), NoneVal) ~> REST:K
+      => REST
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |-> scope(
+            "strings" |-> ARG:Val
+            "result" |-> noneV,
+            parent(0))
+       => 1 |-> scope(
+            "strings" |-> ARG
+            "result" |-> noneV
+            "string" |-> noneV,
+            parent(0)))
+      OTHER:Map
+    </scopes>
