@@ -0,0 +1,52 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Satisfiable false mutation: current best is "x", remaining head is "ab",
+  // but the destination incorrectly retains "x".
+  claim
+    <k>
+      (#loop(
+        list(stringVals(sCons(
+          iCons(97, iCons(98, .IntSeq)),
+          .StringSeq))),
+        Name("string"),
+        If(Compare(Name("result"), CmpOp("is", NoneVal)),
+          Assign(Name("result"), Name("string")),
+          If(Compare(
+            Call(Name("len"), Name("string")),
+            CmpOp("<=", Call(Name("len"), Name("result")))),
+            Assign(Name("result"), Name("result")),
+            If(Compare(
+              Call(Name("len"), Name("string")),
+              CmpOp(">", Call(Name("len"), Name("result")))),
+              Assign(Name("result"), Name("string")),
+              .Stmts))))
+      ~> Return(Name("result"))
+      ~> #endcall)
+      => (str(iCons(120, .IntSeq)) ~> .K)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope("longest" |-> longestSolution, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope(
+         "strings" |-> list(stringVals(sCons(
+           iCons(97, iCons(98, .IntSeq)),
+           .StringSeq)))
+         "result" |-> str(iCons(120, .IntSeq))
+         "string" |-> noneV,
+         parent(0))
+      => 0 |-> scope("longest" |-> longestSolution, parent(-1))
+         -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(false-retain-longer)]
+endmodule
diff --git a/evidence/verification-dispatch-mutant.k b/evidence/verification-dispatch-mutant.k
new file mode 100644
index 0000000000000000000000000000000000000000..dbbca48387d3f34ca8a7f56323978a89abf66f54
--- /dev/null
+++ b/evidence/verification-dispatch-mutant.k
@@ -0,0 +1,27 @@
+requires "verification.k"
+
+module VERIFICATION-DISPATCH-MUTANT
+  imports VERIFICATION
+
+  // Deliberately wrong implementation: it executes the submitted loop but
+  // discards the accumulator and always returns None.
+  syntax Val ::= "longestMutant" [macro]
+  rule longestMutant
+    => closureVal("strings",
+         Assign(Name("result"), NoneVal)
+         Assign(Name("string"), NoneVal)
+         For(Name("string"), Name("strings"),
+           If(Compare(Name("result"), CmpOp("is", NoneVal)),
+             Assign(Name("result"), Name("string")),
+             If(Compare(
+               Call(Name("len"), Name("string")),
+               CmpOp("<=", Call(Name("len"), Name("result")))),
+               Assign(Name("result"), Name("result")),
+               If(Compare(
+                 Call(Name("len"), Name("string")),
+                 CmpOp(">", Call(Name("len"), Name("result")))),
+                 Assign(Name("result"), Name("string")),
+                 .Stmts))))
+         Return(NoneVal),
+         0)
+endmodule
diff --git a/evidence/verification-no-iter-bridge.k b/evidence/verification-no-iter-bridge.k
