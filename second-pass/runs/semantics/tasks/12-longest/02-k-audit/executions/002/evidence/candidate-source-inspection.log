     1	from typing import List, Optional
     2	
     3	
     4	def longest(strings: List[str]) -> Optional[str]:
     5	    result = None
     6	    string = None
     7	    for string in strings:
     8	        if result is None:
     9	            result = string
    10	        elif len(string) <= len(result):
    11	            result = result
    12	        elif len(string) > len(result):
    13	            result = string
    14	    return result
    15	
    16	
    17	assert longest([]) is None
    18	assert longest(["a", "b", "c"]) == "a"
    19	assert longest(["a", "bb", "ccc"]) == "ccc"
    20	assert longest(["first", "x", "later"]) == "first"
    21	assert longest(["", ""]) == ""
