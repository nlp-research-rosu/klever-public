     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // A proof-domain sequence containing only strings.  stringVals embeds it
     7	  // into the ValSeq used by the supplied Python semantics.
     8	  syntax StringSeq ::= ".StringSeq"
     9	                     | sCons(IntSeq, StringSeq)
    10	
    11	  syntax ValSeq ::= stringVals(StringSeq)
    12	  rule stringVals(.StringSeq) => .ValSeq
    13	  rule stringVals(sCons(CS:IntSeq, REST:StringSeq))
    14	    => vCons(str(CS), stringVals(REST))
    15	
    16	  // Symbolic iterator equations for the embedded sequence.  They are the two
    17	  // MPY-LIST iterator rules composed with the stringVals equations above.
    18	  rule <k> #iterNext(list(stringVals(.StringSeq))) => #iterDone ... </k>
    19	       [priority(40)]
    20	  rule <k> #iterNext(list(stringVals(sCons(CS:IntSeq, REST:StringSeq))))
    21	        => #iterYield(str(CS), list(stringVals(REST))) ... </k>
    22	       [priority(40)]
    23	
    24	  // Mathematical left fold for the contract.  Strict comparison is
    25	  // deliberate: on a tie the existing (earlier) result is retained.
    26	  syntax Val ::= longestAcc(Val, StringSeq) [function, total]
    27	  rule longestAcc(BEST:Val, .StringSeq) => BEST
    28	  rule longestAcc(noneV, sCons(CS:IntSeq, REST:StringSeq))
    29	    => longestAcc(str(CS), REST)
    30	  rule longestAcc(str(BEST:IntSeq), sCons(CS:IntSeq, REST:StringSeq))
    31	    => longestAcc(str(CS), REST)
    32	    requires isLen(CS) >Int isLen(BEST)
    33	  rule longestAcc(str(BEST:IntSeq), sCons(CS:IntSeq, REST:StringSeq))
    34	    => longestAcc(str(BEST), REST)
    35	    requires isLen(CS) <=Int isLen(BEST)
    36	
    37	  // Exact closure produced by loading solution.mpy; used to keep the call
    38	  // theorems compact while still tying them to the translated program.
    39	  syntax Val ::= "longestSolution" [macro]
    40	  rule longestSolution
    41	    => closureVal("strings",
    42	         Assign(Name("result"), NoneVal)
    43	         Assign(Name("string"), NoneVal)
    44	         For(Name("string"), Name("strings"),
    45	           If(Compare(Name("result"), CmpOp("is", NoneVal)),
    46	             Assign(Name("result"), Name("string")),
    47	             If(Compare(
    48	               Call(Name("len"), Name("string")),
    49	               CmpOp("<=", Call(Name("len"), Name("result")))),
    50	               Assign(Name("result"), Name("result")),
    51	               If(Compare(
    52	                 Call(Name("len"), Name("string")),
    53	                 CmpOp(">", Call(Name("len"), Name("result")))),
    54	                 Assign(Name("result"), Name("string")),
    55	                 .Stmts))))
    56	         Return(Name("result")),
    57	         0)
    58	endmodule
