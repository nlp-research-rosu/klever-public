     1	# canonical.py — the UNMODIFIED HumanEval/12 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: longest
     4	
     5	from typing import List, Optional
     6	
     7	
     8	def longest(strings: List[str]) -> Optional[str]:
     9	    """ Out of list of strings, return the longest one. Return the first one in case of multiple
    10	    strings of the same length. Return None in case the input list is empty.
    11	    >>> longest([])
    12	
    13	    >>> longest(['a', 'b', 'c'])
    14	    'a'
    15	    >>> longest(['a', 'bb', 'ccc'])
    16	    'ccc'
    17	    """
    18	    if not strings:
    19	        return None
    20	
    21	    maxlen = max(len(x) for x in strings)
    22	    for s in strings:
    23	        if len(s) == maxlen:
    24	            return s
FILE: /candidate/solution.py
     1	from typing import List, Optional
     2	
     3	
     4	def longest(strings: List[str]) -> Optional[str]:
     5	    result = None
     6	    string = None
     7	    for string in strings:
     8	        if result is None:
     9	            result = string
    10	        elif len(string) <= len(result):
    11	            result = result
    12	        elif len(string) > len(result):
    13	            result = string
    14	    return result
