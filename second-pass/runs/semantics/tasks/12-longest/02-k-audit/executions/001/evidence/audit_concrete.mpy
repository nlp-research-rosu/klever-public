Module(
  ImportFrom("typing", "List", "Optional")
  FuncDef("longest", Params("strings"),
    Assign(Name("result"), NoneVal)
    Assign(Name("string"), NoneVal)
    For(Name("string"), Name("strings"),
      If(Compare(Name("result"), CmpOp("is", NoneVal)),
        Assign(Name("result"), Name("string")),
        If(Compare(
          Call(Name("len"), Name("string")),
          CmpOp("<=", Call(Name("len"), Name("result")))),
          Assign(Name("result"), Name("result")),
          If(Compare(
            Call(Name("len"), Name("string")),
            CmpOp(">", Call(Name("len"), Name("result")))),
            Assign(Name("result"), Name("string")),
            ))))
    Return(Name("result")))
  Assert(
    Compare(Call(Name("longest"), ListExpr()), CmpOp("is", NoneVal)))
  Assert(
    Compare(
      Call(Name("longest"), ListExpr(Str("a"), Str("b"), Str("c"))),
      CmpOp("==", Str("a"))))
  Assert(
    Compare(
      Call(Name("longest"), ListExpr(Str("a"), Str("bb"), Str("ccc"))),
      CmpOp("==", Str("ccc"))))
  Assert(
    Compare(
      Call(Name("longest"), ListExpr(Str("bb"), Str("a"))),
      CmpOp("==", Str("bb"))))
  Assert(
    Compare(
      Call(Name("longest"), ListExpr(Str("aa"), Str("bb"))),
      CmpOp("==", Str("aa"))))
  Assert(
    Compare(
      Call(Name("longest"), ListExpr(Str(""), Str(""), Str(""))),
      CmpOp("==", Str("")))))
