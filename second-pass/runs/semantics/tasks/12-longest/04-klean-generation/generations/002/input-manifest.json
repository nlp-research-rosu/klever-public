{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 12,
      "module": "VERIFICATION",
      "normalized_sha256": "61a7e85b99e1fd517b3f029cca636566b11a786aa2f24d053db8e5dea4317820",
      "rationale": "Base equation of the stringVals structural embedding, defining the empty proof-domain string sequence as the empty MPY ValSeq.",
      "source_rule_id": "rule-61a7e85b99e1fd517b3f029cca636566b11a786aa2f24d053db8e5dea4317820",
      "start_line": 12,
      "text": "  rule stringVals(.StringSeq) => .ValSeq"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 14,
      "module": "VERIFICATION",
      "normalized_sha256": "06cf824ccd2247d57e4141172b5e6494e4acc57dc1a88a94144097b09d59b0c1",
      "rationale": "Recursive equation of the stringVals structural embedding, mapping one code sequence to an MPY string value and recurring on the tail.",
      "source_rule_id": "rule-06cf824ccd2247d57e4141172b5e6494e4acc57dc1a88a94144097b09d59b0c1",
      "start_line": 13,
      "text": "  rule stringVals(sCons(CS:IntSeq, REST:StringSeq))\n    => vCons(str(CS), stringVals(REST))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 27,
      "module": "VERIFICATION",
      "normalized_sha256": "f40c65506711d9264ce5e002c00c58e14bffb284ba0a0ef1e062022c850058fa",
      "rationale": "Base equation of the mathematical longestAcc fold, defining the result on an empty remaining sequence as the current accumulator.",
      "source_rule_id": "rule-f40c65506711d9264ce5e002c00c58e14bffb284ba0a0ef1e062022c850058fa",
      "start_line": 27,
      "text": "  rule longestAcc(BEST:Val, .StringSeq) => BEST"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 29,
      "module": "VERIFICATION",
      "normalized_sha256": "4344ff90b2feb479d11bd8ad23e5a852fa65b2184ee2ab2a22a60b8b24b7a9ba",
      "rationale": "Initialization equation of longestAcc, defining the first string as the accumulator when the prior accumulator is noneV.",
      "source_rule_id": "rule-4344ff90b2feb479d11bd8ad23e5a852fa65b2184ee2ab2a22a60b8b24b7a9ba",
      "start_line": 28,
      "text": "  rule longestAcc(noneV, sCons(CS:IntSeq, REST:StringSeq))\n    => longestAcc(str(CS), REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 32,
      "module": "VERIFICATION",
      "normalized_sha256": "0f388914c90471f2074c0ae8359e3fa11b9f73200e404e8cded4c53936bcd932",
      "rationale": "Recursive longestAcc equation for a strictly longer head, defining the fold to replace the accumulator and continue on the tail.",
      "source_rule_id": "rule-0f388914c90471f2074c0ae8359e3fa11b9f73200e404e8cded4c53936bcd932",
      "start_line": 30,
      "text": "  rule longestAcc(str(BEST:IntSeq), sCons(CS:IntSeq, REST:StringSeq))\n    => longestAcc(str(CS), REST)\n    requires isLen(CS) >Int isLen(BEST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION",
      "normalized_sha256": "370c2d5a71b42f964c5e0bc4fde658a3d2f206ee26b68793283aebc5d57f27f9",
      "rationale": "Recursive longestAcc equation for a shorter or tied head, defining retention of the earlier accumulator and therefore first-on-tie behavior.",
      "source_rule_id": "rule-370c2d5a71b42f964c5e0bc4fde658a3d2f206ee26b68793283aebc5d57f27f9",
      "start_line": 33,
      "text": "  rule longestAcc(str(BEST:IntSeq), sCons(CS:IntSeq, REST:StringSeq))\n    => longestAcc(str(BEST), REST)\n    requires isLen(CS) <=Int isLen(BEST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 57,
      "module": "VERIFICATION",
      "normalized_sha256": "1b6d53d96f4b4a82eb6b7f9bafc5577f204500d0110e04dbb065f0e26a91bc18",
      "rationale": "Macro expansion defining the named longestSolution proof term as the exact closure loaded from the translated solution.",
      "source_rule_id": "rule-1b6d53d96f4b4a82eb6b7f9bafc5577f204500d0110e04dbb065f0e26a91bc18",
      "start_line": 40,
      "text": "  rule longestSolution\n    => closureVal(\"strings\",\n         Assign(Name(\"result\"), NoneVal)\n         Assign(Name(\"string\"), NoneVal)\n         For(Name(\"string\"), Name(\"strings\"),\n           If(Compare(Name(\"result\"), CmpOp(\"is\", NoneVal)),\n             Assign(Name(\"result\"), Name(\"string\")),\n             If(Compare(\n               Call(Name(\"len\"), Name(\"string\")),\n               CmpOp(\"<=\", Call(Name(\"len\"), Name(\"result\")))),\n               Assign(Name(\"result\"), Name(\"result\")),\n               If(Compare(\n                 Call(Name(\"len\"), Name(\"string\")),\n                 CmpOp(\">\", Call(Name(\"len\"), Name(\"result\")))),\n                 Assign(Name(\"result\"), Name(\"string\")),\n                 .Stmts))))\n         Return(Name(\"result\")),\n         0)"
    }
  ],
