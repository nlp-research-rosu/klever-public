kprove spec.k \
  --definition verification-kompiled \
  --claims loop-init-empty,loop-init-cons,loop-empty,loop-longer,loop-retain

kprove spec.k \
  --definition verification-kompiled \
  --claims load-solution,call-empty,call-cons-dispatch
