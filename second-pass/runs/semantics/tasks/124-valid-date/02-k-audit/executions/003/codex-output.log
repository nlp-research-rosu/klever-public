    v=hashlib.sha256((json.dumps(obj,**kw)+newline).encode()).hexdigest()
    variants[f'json {objname} sort={sort} compact={compact} nl={newline"'!r}'"']=v
for k,v in variants.items():
 if v in targets: print('MATCH',v,k)
print('tested',len(variants))
