+
+  printf '%s\n' 'COMMAND: cmp exact submitted and trusted-regenerated solution.mpy'
+  cmp -s \
+    /tmp/audit-work/124-valid-date/solution.mpy \
+    /tmp/audit-work/124-valid-date/regenerated-solution.mpy
