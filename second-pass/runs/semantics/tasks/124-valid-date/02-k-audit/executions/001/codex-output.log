--- /dev/null
+++ b//tmp/audit-work/reconstruction/spec-claim1.k
@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module VALID-DATE-SPEC-CLAIM1
+  imports VALID-DATE-VERIFICATION
+
+  claim
+    <k>
+      #loadAll(validDateModule)
+      ~> Call(Name("valid_date"), str(CS:IntSeq))
+      =>
+      false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope("valid_date" |-> validDateClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires isLen(CS) =/=Int 10
+endmodule
