+                          iCons(Y3:Int, .IntSeq)))))))))))
+      )
+      =>
+      notBool validDate10(
+        M0, M1, SEP1, D0, D1, SEP2, Y0, Y1, Y2, Y3
+      )
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope("valid_date" |-> validDateClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
