+            iCons(
+              SEP1:Int,
+              iCons(
+                D0:Int,
+                iCons(
+                  D1:Int,
+                  iCons(
+                    SEP2:Int,
+                    iCons(
+                      Y0:Int,
+                      iCons(
+                        Y1:Int,
+                        iCons(
