+  claim
+    <k>
+      #loadAll(validDateModule)
+      ~>
+      Call(
+        Name("valid_date"),
+        str(iCons(
+          M0:Int,
+          iCons(
+            M1:Int,
+            iCons(
+              SEP1:Int,
+              iCons(
+                D0:Int,
+                iCons(
+                  D1:Int,
+                  iCons(
+                    SEP2:Int,
+                    iCons(
+                      Y0:Int,
+                      iCons(
+                        Y1:Int,
+                        iCons(
+                          Y2:Int,
+                          iCons(Y3:Int, .IntSeq)))))))))))
+      )
+      =>
+      notBool validDate10(
+        M0, M1, SEP1, D0, D1, SEP2, Y0, Y1, Y2, Y3
+      )
+    </k>
+    <env> 0 </env>
+    <scopes>
