+        Name("valid_date"),
+        str(iCons(
+          M0:Int,
+          iCons(
+            M1:Int,
+            iCons(
+              SEP1:Int,
+              iCons(
+                D0:Int,
+                iCons(
+                  D1:Int,
+                  iCons(
