#!/usr/bin/env python3
"""Canonical lexical inventory of simplification rules in verification.k."""

from __future__ import annotations

import dataclasses
import hashlib
import json
import re
import stat
from dataclasses import dataclass
from pathlib import Path
from typing import Any


_MODULE_NAME_RE = re.compile(
    r"^[ \t]+(?P<name>[A-Za-z][A-Za-z0-9_'-]*)"
    r"(?:[ \t]+\[[^\]\r\n]*\])?[ \t]*$"
)
_TRAILING_ATTRIBUTES_RE = re.compile(
    r"\[(?P<attributes>[^\[\]]*)\][ \t\r\n]*\Z", re.S
)
_CELL_TAG_RE = re.compile(
    r"<(?P<close>/)?(?P<name>[A-Za-z][A-Za-z0-9_'-]*)"
    r"[ \t]*(?P<self_close>/)?>"
)
_OUTER_SENTENCE_KEYWORDS = {
    "imports",
    "syntax",
    "rule",
    "configuration",
    "context",
    "claim",
    "alias",
}


class KRuleInventoryError(RuntimeError):
    """Raised when verification.k cannot produce a canonical inventory."""


@dataclass(frozen=True)
class KRule:
    source_rule_id: str
    module: str
    start_line: int
    end_line: int
    normalized_sha256: str
    attributes: list[str]
    text: str


@dataclass(frozen=True)
class _Sentence:
    keyword: str
    start: int


@dataclass(frozen=True)
class _Module:
    name: str
    content_start: int
    content_end: int
    imports: tuple[str, ...]
    sentences: tuple[_Sentence, ...]


@dataclass(frozen=True)
class _RuleSpan:
    rule: KRule
    start_offset: int
    end_offset: int
    attribute_start: int | None
    attribute_end: int | None


def canonical_json_sha256(document: Any) -> str:
    encoded = json.dumps(
        document,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
    ).encode()
    return hashlib.sha256(encoded).hexdigest()


def _mask_non_code(text: str) -> str:
    """Mask comments and string bodies without changing source offsets."""

    output = list(text)
    index = 0
    block_depth = 0
    state = "code"
    while index < len(text):
        character = text[index]
        following = text[index + 1] if index + 1 < len(text) else ""
        if state == "line-comment":
            if character in "\r\n":
                state = "code"
            else:
                output[index] = " "
            index += 1
            continue
        if state == "string":
            if character == "\\" and following:
                output[index] = " "
                output[index + 1] = " "
                index += 2
                continue
            if character == '"':
                state = "code"
            elif character not in "\r\n":
                output[index] = " "
            index += 1
            continue
        if state == "block-comment":
            if character == "/" and following == "*":
                output[index] = output[index + 1] = " "
                block_depth += 1
                index += 2
                continue
            if character == "*" and following == "/":
                output[index] = output[index + 1] = " "
                block_depth -= 1
                index += 2
                if block_depth == 0:
                    state = "code"
                continue
            if character not in "\r\n":
                output[index] = " "
            index += 1
            continue
        if character == "/" and following == "/":
            output[index] = output[index + 1] = " "
            state = "line-comment"
            index += 2
            continue
        if character == "/" and following == "*":
            output[index] = output[index + 1] = " "
            state = "block-comment"
            block_depth = 1
            index += 2
            continue
        if character == '"':
            state = "string"
        index += 1
    return "".join(output)


def _line_ranges(text: str, start: int = 0) -> list[tuple[int, int, int]]:
    ranges: list[tuple[int, int, int]] = []
    line_start = start
    while line_start < len(text):
        newline = text.find("\n", line_start)
        next_start = len(text) if newline < 0 else newline + 1
        line_end = len(text) if newline < 0 else newline
        content_end = (
            line_end - 1
            if line_end > line_start and text[line_end - 1] == "\r"
            else line_end
        )
        ranges.append((line_start, content_end, next_start))
        if newline < 0:
            break
        line_start = next_start
    return ranges


def _line_heads(text: str) -> list[tuple[int, int, str, str]]:
    """Return physical-line word heads without assigning K grammar meaning."""

    heads: list[tuple[int, int, str, str]] = []
    for line_start, content_end, _next_start in _line_ranges(text):
        index = line_start
        while index < content_end and text[index] in " \t":
            index += 1
        word_end = index
        while word_end < content_end and (
            text[word_end].isalnum() or text[word_end] in "_'"
        ):
        ):
            word_end += 1
        if word_end > index:
            heads.append(
                (
                    line_start,
                    content_end,
                    text[index:word_end],
                    text[word_end:content_end],
                )
            )
    return heads


def _line_word(line: str) -> tuple[str, str, int]:
    stripped = line.lstrip()
    indent = len(line) - len(stripped)
    word_end = 0
    while word_end < len(stripped) and (
        stripped[word_end].isalnum() or stripped[word_end] in "_'"
    ):
        word_end += 1
    return stripped[:word_end], stripped[word_end:], indent + word_end


def _rule_continuation(line: str) -> tuple[str, int] | None:
    stripped = line.lstrip()
    if stripped.startswith("["):
        return "attributes", len(line) - len(stripped)
    word, rest, word_end = _line_word(line)
    for keyword in ("requires", "ensures"):
        if word == keyword and (
            not rest
            or not (
                rest[0].isalnum()
                or rest[0] in "_'"
            )
        ):
            return keyword, word_end
    return None


def _starts_outer_transition(line: str) -> bool:
    keyword, rest, _word_end = _line_word(line)
    separated = bool(rest) and rest[0] in " \t"
    if keyword == "module":
        return separated and _MODULE_NAME_RE.fullmatch(rest) is not None
    if keyword == "endmodule":
        return not rest.strip()
    if keyword == "rule":
        return not rest or separated
    return keyword in _OUTER_SENTENCE_KEYWORDS and separated


def _terminal_attribute_line(line: str) -> bool:
    match = _TRAILING_ATTRIBUTES_RE.search(line)
    if match is None:
        return False
    start = match.start()
    return start == 0 or line[start - 1].isspace()


def _scan_rule_delimiters(
    line: str,
    delimiters: list[str],
) -> None:
    closing = {")": "(", "]": "[", "}": "{"}
    index = 0
    while index < len(line):
        if line[index] == "<":
            cell = _CELL_TAG_RE.match(line, index)
            if cell is not None:
                marker = f"<{cell.group('name')}>"
                if cell.group("close"):
                    if delimiters and delimiters[-1] == marker:
                        delimiters.pop()
                elif not cell.group("self_close"):
                    delimiters.append(marker)
                index = cell.end()
                continue
        character = line[index]
        if character in "([{":
            delimiters.append(character)
        elif character in closing:
            if delimiters and delimiters[-1] == closing[character]:
                delimiters.pop()
        index += 1


def _rule_bubble_end(masked_text: str, start: int) -> int:
    """Find when an outer rule bubble returns control to outer parsing."""

    seen_rewrite = False
    clause_has_content = False
    candidate_end: int | None = None
    delimiters: list[str] = []
    ranges = _line_ranges(masked_text, start)
    for line_start, line_end, next_start in ranges:
        line = masked_text[line_start:line_end]
        if not line.strip():
            continue

        continuation = (
            _rule_continuation(line)
            if seen_rewrite and candidate_end is not None
            else None
        )
        if candidate_end is not None:
            if continuation is None and _starts_outer_transition(line):
                return candidate_end
            candidate_end = None

        content_start = 0
        if continuation is not None:
            kind, content_start = continuation
            if kind in {"requires", "ensures"}:
                clause_has_content = False

        if not seen_rewrite:
            rewrite = line.find("=>")
            if rewrite >= 0:
                seen_rewrite = True
                content_start = rewrite + 2
            else:
                content_start = len(line)

        _scan_rule_delimiters(line, delimiters)
        if seen_rewrite and line[content_start:].strip():
            clause_has_content = True

        if (
            seen_rewrite
            and clause_has_content
            and not delimiters
            and _terminal_attribute_line(line)
        ):
            return next_start
        if seen_rewrite and clause_has_content and not delimiters:
            candidate_end = next_start
    if candidate_end is not None:
        return candidate_end
    return len(masked_text) + 1


def _modules(masked_text: str) -> tuple[_Module, ...]:
    modules: list[_Module] = []
    open_module: tuple[
        str, int, list[str], list[_Sentence]
    ] | None = None
    open_rule_until = 0
    for line_start, line_end, keyword, rest in _line_heads(masked_text):
        if line_start < open_rule_until:
            continue
        open_rule_until = 0
        separated = bool(rest) and rest[0] in " \t"
        if keyword == "module":
            if not separated:
                raise KRuleInventoryError(
                    "verification.k has malformed module boundaries"
                )
            named = _MODULE_NAME_RE.fullmatch(rest)
            if named is None or open_module is not None:
                raise KRuleInventoryError(
                    "verification.k has malformed module boundaries"
                )
            open_module = (named.group("name"), line_end, [], [])
            continue
        if keyword == "endmodule":
            if rest.strip():
                raise KRuleInventoryError(
                    "verification.k has malformed module boundaries"
                )
            if open_module is None:
                raise KRuleInventoryError(
                    "verification.k has malformed module boundaries"
                )
            name, content_start, imports, sentences = open_module
            modules.append(
                _Module(
                    name=name,
                    content_start=content_start,
                    content_end=line_start,
                    imports=tuple(imports),
                    sentences=tuple(sentences),
                )
            )
            open_module = None
            continue
        if open_module is not None and keyword == "rule":
            open_module[3].append(
                _Sentence(keyword=keyword, start=line_start)
            )
            open_rule_until = _rule_bubble_end(masked_text, line_start)
            continue
        if open_module is not None and keyword == "imports" and separated:
            imported = rest.strip().split()
            if len(imported) != 1:
                raise KRuleInventoryError(
                    "verification.k has malformed imports"
                )
            open_module[2].append(imported[0])
        if (
            open_module is not None
            and keyword in _OUTER_SENTENCE_KEYWORDS
            and separated
        ):
            open_module[3].append(
                _Sentence(keyword=keyword, start=line_start)
            )
    if not modules or open_module is not None:
        raise KRuleInventoryError(
            "verification.k has malformed module boundaries"
        )
    return tuple(modules)


def _verification_module(
    modules: tuple[_Module, ...], selected_name: str | None = None
) -> _Module:
    if selected_name is not None:
        selected = [module for module in modules if module.name == selected_name]
        if len(selected) != 1:
            raise KRuleInventoryError(
                "prove.sh selects an unknown verification main module: "
                + selected_name
            )
        return selected[0]
    candidates = [
        module
        for module in modules
        if module.name.endswith("VERIFICATION")
        and not module.name.endswith("-SYNTAX")
    ]
    if len(candidates) != 1:
        raise KRuleInventoryError(
            "verification.k must contain exactly one verification module"
        )
    return candidates[0]


def _last_verification_main_module(workspace: Path) -> str | None:
    script = workspace / "prove.sh"
    if not script.exists() and not script.is_symlink():
        return None
    try:
        mode = script.stat(follow_symlinks=False).st_mode
    except OSError as error:
        raise KRuleInventoryError(f"cannot inspect prove.sh: {script}") from error
    if not stat.S_ISREG(mode):
        raise KRuleInventoryError(f"prove.sh must be a regular file: {script}")
    try:
        text = script.read_text()
    except (OSError, UnicodeError) as error:
        raise KRuleInventoryError(f"cannot read prove.sh: {script}") from error
    logical = re.sub(r"\\\r?\n", " ", text)
    selected: str | None = None
    for line in logical.splitlines():
        code = line.split("#", 1)[0]
        if not re.search(r"(?:^|[;&|]\s*)kompile\s+", code):
            continue
        if re.search(r"(?:^|\s)(?:\./)?verification\.k(?:\s|$)", code) is None:
            continue
        match = re.search(
            r"(?:^|\s)--main-module(?:=|\s+)([A-Za-z][A-Za-z0-9_'-]*)",
            code,
        )
        if match is not None:
            selected = match.group(1)
    return selected


def _verification_closure(
    modules: tuple[_Module, ...], verification: _Module
) -> tuple[_Module, ...]:
    by_name = {module.name: module for module in modules}
    reached: set[str] = set()
    pending = [verification.name]
    while pending:
        name = pending.pop()
        if name in reached:
            continue
            continue
        reached.add(name)
        module = by_name.get(name)
        if module is not None:
            pending.extend(module.imports)
    return tuple(module for module in modules if module.name in reached)


def _without_comments(text: str) -> str:
    """Remove K comments while preserving strings and their exact contents."""

    output: list[str] = []
    index = 0
    block_depth = 0
    state = "code"
    while index < len(text):
        character = text[index]
        following = text[index + 1] if index + 1 < len(text) else ""
        if state == "line-comment":
            if character in "\r\n":
                output.append(character)
                state = "code"
            index += 1
            continue
        if state == "string":
            output.append(character)
            if character == "\\" and following:
                output.append(following)
                index += 2
                continue
            if character == '"':
                state = "code"
            index += 1
            continue
        if state == "block-comment":
            if character == "/" and following == "*":
                block_depth += 1
                index += 2
                continue
            if character == "*" and following == "/":
                block_depth -= 1
                index += 2
                if block_depth == 0:
                    state = "code"
                continue
            if character in "\r\n":
                output.append(character)
            index += 1
            continue
        if character == "/" and following == "/":
            output.append(" ")
            state = "line-comment"
            index += 2
            continue
        if character == "/" and following == "*":
            output.append(" ")
            state = "block-comment"
            block_depth = 1
            index += 2
            continue
        output.append(character)
        if character == '"':
            state = "string"
        index += 1
    return "".join(output)


def _attribute_tokens(text: str, masked_text: str) -> list[str]:
    tokens: list[str] = []
    start = 0
    depth = 0
    for index, character in enumerate(masked_text):
        if character in "([{":
            depth += 1
        elif character in ")]}":
            depth = max(depth - 1, 0)
        elif character == "," and depth == 0:
            token = _without_comments(text[start:index]).strip()
            if token:
                tokens.append(token)
            start = index + 1
    final = _without_comments(text[start:]).strip()
    if final:
        tokens.append(final)
    return tokens


def _rule_spans(text: str, module: _Module) -> list[_RuleSpan]:
    masked_text = _mask_non_code(text)
    sentences = module.sentences
    rules: list[_RuleSpan] = []
    seen_hashes: set[str] = set()
    for index, sentence in enumerate(sentences):
        if sentence.keyword != "rule":
            continue
        end_offset = (
            sentences[index + 1].start
            if index + 1 < len(sentences)
            else module.content_end
        )
        start_offset = sentence.start
        raw_segment = text[start_offset:end_offset]
        masked_segment = masked_text[start_offset:end_offset]
        logical_length = len(masked_segment.rstrip(" \t\r\n"))
        if logical_length == 0:
            continue
        rule_text = raw_segment[:logical_length].rstrip(" \t\r\n")
        masked_rule = _mask_non_code(rule_text)
        attribute_match = _TRAILING_ATTRIBUTES_RE.search(masked_rule)
        attribute_start = None
        attribute_end = None
        attributes: list[str] = []
        if attribute_match is not None:
            attribute_start = attribute_match.start("attributes")
            attribute_end = attribute_match.end("attributes")
            attributes = _attribute_tokens(
                rule_text[attribute_start:attribute_end],
                masked_rule[attribute_start:attribute_end],
            )
        normalized = " ".join(rule_text.split())
        digest = hashlib.sha256(normalized.encode()).hexdigest()
        if digest in seen_hashes:
            raise KRuleInventoryError(
                f"duplicate normalized simplification rule hash: {digest}"
            )
        seen_hashes.add(digest)
        start_line = text.count("\n", 0, start_offset) + 1
        end_line = start_line + rule_text.count("\n")
        rule = KRule(
            source_rule_id=f"rule-{digest}",
            module=module.name,
            start_line=start_line,
            end_line=end_line,
            normalized_sha256=digest,
            attributes=attributes,
            text=rule_text,
        )
        rules.append(
            _RuleSpan(
                rule=rule,
                start_offset=start_offset,
                end_offset=start_offset + len(rule_text),
                attribute_start=(
                    None
                    if attribute_match is None
                    else start_offset + attribute_match.start()
                ),
                attribute_end=(
                    None
                    if attribute_match is None
                    else start_offset + attribute_match.end()
                ),
            )
        )
    return rules


def _rule_documents(
    text: str, modules: tuple[_Module, ...]
) -> list[dict[str, Any]]:
    spans = [span for module in modules for span in _rule_spans(text, module)]
    spans.sort(key=lambda span: span.start_offset)
    return [dataclasses.asdict(span.rule) for span in spans]


def _attribute_token_spans(
    text: str,
    masked_text: str,
) -> list[tuple[int, int, str]]:
    spans: list[tuple[int, int, str]] = []
    start = 0
    depth = 0
    for index, character in enumerate(masked_text):
        if character in "([{":
            depth += 1
        elif character in ")]}":
            depth = max(depth - 1, 0)
        elif character == "," and depth == 0:
            spans.append(
                (
                    start,
                    index,
                    _without_comments(text[start:index]).strip(),
                )
            )
            start = index + 1
    spans.append(
        (
            start,
            len(text),
            _without_comments(text[start:]).strip(),
        )
    )
    return spans


def _blank_non_newlines(text: str) -> str:
    return "".join(
        character if character in "\r\n" else " "
        for character in text
    )


def desimplify_rule_ids(
    text: str,
    source_rule_ids: list[str],
) -> str:
    """Remove simplification from exactly the selected canonical rule IDs."""

    if len(source_rule_ids) != len(set(source_rule_ids)):
        raise KRuleInventoryError(
            "exact rule transformation contains a duplicate source rule ID"
        )
    selected = set(source_rule_ids)
    modules = _modules(_mask_non_code(text))
    spans = [
        span
        for local_module in modules
        for span in _rule_spans(text, local_module)
    ]
    by_id = {span.rule.source_rule_id: span for span in spans}
    unknown = sorted(selected - set(by_id))
    if unknown:
        raise KRuleInventoryError(
            "exact rule transformation names an unknown source rule ID: "
            + ", ".join(unknown)
        )

    edits: list[tuple[int, int]] = []
    for source_rule_id in source_rule_ids:
        span = by_id[source_rule_id]
        if span.attribute_start is None or span.attribute_end is None:
            raise KRuleInventoryError(
                "selected source rule has no simplification attribute: "
                f"{source_rule_id}"
            )
        attribute_text = text[
            span.attribute_start + 1 : span.attribute_end - 1
        ]
        masked_attributes = _mask_non_code(attribute_text)
        tokens = _attribute_token_spans(
            attribute_text,
            masked_attributes,
        )
        matches = [
            index
            for index, (_start, _end, token) in enumerate(tokens)
            if token == "simplification"
        ]
        if len(matches) != 1:
            raise KRuleInventoryError(
                "selected source rule has ambiguous simplification "
                f"attributes: {source_rule_id}"
            )
        token_index = matches[0]
        if len(tokens) == 1:
            edit_start = span.attribute_start
            edit_end = span.attribute_end
        elif token_index < len(tokens) - 1:
            edit_start = (
                span.attribute_start + 1 + tokens[token_index][0]
            )
            edit_end = (
                span.attribute_start + 1 + tokens[token_index + 1][0]
            )
        else:
            edit_start = (
                span.attribute_start + 1 + tokens[token_index - 1][1]
            )
            edit_end = (
                span.attribute_start + 1 + tokens[token_index][1]
            )
        edits.append((edit_start, edit_end))

    transformed = text
    for start, end in sorted(edits, reverse=True):
        transformed = (
            transformed[:start]
            + _blank_non_newlines(transformed[start:end])
            + transformed[end:]
        )
    return transformed


def inventory_verification(workspace: Path) -> dict[str, Any]:
    workspace = Path(workspace)
    try:
        workspace_mode = workspace.stat(follow_symlinks=False).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        ) from error
    if not stat.S_ISDIR(workspace_mode):
        raise KRuleInventoryError(
            f"workspace must be a real directory: {workspace}"
        )
    verification = workspace / "verification.k"
    try:
        verification_mode = verification.stat(
            follow_symlinks=False
        ).st_mode
    except OSError as error:
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        ) from error
    if not stat.S_ISREG(verification_mode):
        raise KRuleInventoryError(
            f"workspace has no regular verification.k: {verification}"
        )
    try:
        verification_bytes = verification.read_bytes()
        text = verification_bytes.decode()
    except (OSError, UnicodeError) as error:
        raise KRuleInventoryError(
            f"cannot read verification.k: {verification}"
        ) from error
    masked_text = _mask_non_code(text)
    modules = _modules(masked_text)
    module = _verification_module(
        modules, _last_verification_main_module(workspace)
    )
    closure = _verification_closure(modules, module)
    rule_documents = _rule_documents(text, closure)
    return {
        "schema_version": 2,
        "verification_file": "verification.k",
        "verification_sha256": hashlib.sha256(verification_bytes).hexdigest(),
        "verification_module": module.name,
        "verification_modules": [module.name for module in closure],
        "rules": rule_documents,
        "inventory_sha256": canonical_json_sha256(rule_documents),
    }
def check_generation(
    frozen_input: Path,
    discovery_manifest: Path,
    generation: Path,
    *,
    toolchain_lock: Path,
    run_command: Callable[..., tuple[int, str]] = _run,
) -> dict[str, Any]:
    frozen_input = Path(frozen_input)
    discovery_manifest = Path(discovery_manifest)
    generation = Path(generation)
    generated = generation / "generated"
    if not frozen_input.is_dir() or frozen_input.is_symlink():
        raise KleanPreflightError("frozen K input must be a real directory")
    if not discovery_manifest.is_file() or discovery_manifest.is_symlink():
        raise KleanPreflightError(
            "validated Stage 3 discovery manifest must be a regular file"
        )
    if not generation.is_dir() or generation.is_symlink():
        raise KleanPreflightError("generation must be a real directory")
    if not generated.is_dir() or generated.is_symlink():
        raise KleanPreflightError("generated project must be a real directory")
    # Traversing every entry rejects symlinks/FIFOs before any build command.
    klean_export._tree_entries(generated)
    snapshot = _preflight_snapshot(
        frozen_input, discovery_manifest, generation
    )
    input_manifest = _regular_json(
        generation / "input-manifest.json", "input manifest"
    )
    generator_manifest = _regular_json(
        generation / "generator-manifest.json", "generator manifest"
    )
    inventory = _regular_json(
        generation / "trust-inventory.json", "trust inventory"
    )
    export_result = _regular_json(
        generation / "export-result.json", "export result"
    )
    lock = _regular_json(Path(toolchain_lock), "toolchain lock")
    export_status = export_result.get("status")
    if export_result.get("schema_version") != 3:
        raise KleanPreflightError("export result schema version is not 3")
    if export_status not in {"OK", "KLEAN_NO_OBLIGATIONS"}:
        raise KleanPreflightError("export result status is invalid")
    input_hash = snapshot.stage1_workspace_sha256
    discovery_hash = snapshot.stage3_discovery_manifest_sha256
    generated_hash = snapshot.generated_tree_sha256
    sidecar_hashes = dict(snapshot.sidecar_sha256)
    if input_manifest.get("schema_version") != 3:
        raise KleanPreflightError("input manifest schema version is not 3")
    if generator_manifest.get("schema_version") != 3:
        raise KleanPreflightError("generator manifest schema version is not 3")
    if input_manifest.get("frozen_input_sha256") != input_hash:
        raise KleanPreflightError("frozen Stage 1 input hash changed")
    if input_manifest.get("stage1_workspace_sha256") != input_hash:
        raise KleanPreflightError("Stage 1 workspace hash changed")
    if (
        input_manifest.get("stage3_discovery_manifest_sha256")
        != discovery_hash
    ):
        raise KleanPreflightError(
            "validated Stage 3 discovery manifest hash changed"
        )
    if generator_manifest.get("generated_tree_sha256") != generated_hash:
        raise KleanPreflightError("generated project hash changed")
    if generator_manifest.get("toolchain") != lock:
        raise KleanPreflightError("generator toolchain differs from pinned lock")
    provenance = generator_manifest.get("provenance")
    if not isinstance(provenance, dict):
        raise KleanPreflightError("generator provenance is malformed")
    if provenance.get("stage1_workspace_sha256") != input_hash:
        raise KleanPreflightError(
            "Stage 1 provenance differs between generation manifests"
        )
    if provenance.get("stage3_discovery_manifest_sha256") != discovery_hash:
        raise KleanPreflightError(
            "Stage 3 provenance differs between generation manifests"
        )
    if provenance.get("inventory_sha256") != input_manifest.get(
        "inventory_sha256"
    ):
        raise KleanPreflightError(
            "Stage 1/Stage 3 inventory provenance differs"
        )
    _source_rules, obligations = _source_and_obligation_gate(
        frozen_input,
        discovery_manifest,
        generated,
        input_manifest,
        generator_manifest,
    )
    expected_export_status = "OK" if obligations else "KLEAN_NO_OBLIGATIONS"
    if export_status != expected_export_status:
        raise KleanPreflightError(
            "export status disagrees with generated obligation count"
        )
    if export_result.get("obligation_count") != len(obligations):
        raise KleanPreflightError(
            "export result obligation_count does not match generated obligations"
        )

    try:
        target = klean_export.target_statement(generated)
    except klean_export.KleanExportError as error:
        raise KleanPreflightError(str(error)) from error
    expected_target = generator_manifest.get("target")
    if target != expected_target:
        raise KleanPreflightError("target theorem statement or location changed")
    if bool(obligations) != bool(target):
        raise KleanPreflightError(
            "target proposition and obligation inventory disagree"
        )
    sources = _lean_sources(generated)
    sorry_locations: list[str] = []
    for source in sources:
        text = source.read_text()
        for forbidden in (r"\badmit\b", r"\bunsafe\b"):
            if re.search(forbidden, text):
                raise KleanPreflightError(
                    f"forbidden Lean token in {source.relative_to(generated)}"
                )
        for match in re.finditer(r"\bsorry\b", text):
            sorry_locations.append(source.relative_to(generated).as_posix())
    if sorry_locations:
        raise KleanPreflightError("generated immutable project contains sorry")
    if inventory.get("designated_sorries") != 0 or inventory.get(
        "other_sorries"
    ) != 0:
        raise KleanPreflightError("trust inventory has unexpected proof-hole counts")

    declared = _trust_declarations(sources)
    _reject_proposition_trust(generated, sources, declared)
    allowlist = inventory.get("allowlist")
    if not isinstance(allowlist, list):
        raise KleanPreflightError("trust inventory allowlist is malformed")
    expected: dict[str, tuple[str, str]] = {}
    for entry in allowlist:
        if not isinstance(entry, dict):
            raise KleanPreflightError("trust allowlist entry is malformed")
        name = entry.get("name")
        kind = entry.get("kind")
        lean_type = entry.get("type")
        reason = entry.get("reason")
        if not all(
            isinstance(value, str) and value
            for value in (name, kind, lean_type, reason)
        ):
            raise KleanPreflightError("trust allowlist entry is incomplete")
        if name in expected:
            raise KleanPreflightError(
                f"duplicate trust allowlist entry: {name}"
            )
        expected[name] = (kind, lean_type)
    if declared != expected:
        raise KleanPreflightError(
            "generated axiom/opaque declarations differ from trust allowlist"
        )
    _check_imports(generated, sources)
    export_bindings = {
        "frozen_input_sha256": input_hash,
        "stage3_discovery_manifest_sha256": discovery_hash,
        "generated_tree_sha256": generated_hash,
        "trust_inventory_sha256": sidecar_hashes[
            "trust-inventory.json"
        ],
    }
    for field, expected_hash in export_bindings.items():
        if export_result.get(field) != expected_hash:
            label = (
                "trust inventory hash"
                if field == "trust_inventory_sha256"
                else field
            )
            raise KleanPreflightError(
                f"export result {label} does not match immutable inputs"
            )

    with tempfile.TemporaryDirectory(prefix="klean-preflight-") as temporary:
        clean = Path(temporary) / "project"
        shutil.copytree(generated, clean)
        diagnostics: list[dict[str, Any]] = []
        for command in (["lake", "clean"], ["lake", "build"]):
            code, output = run_command(command, cwd=clean, timeout=600)
            diagnostics.append(
                {
                    "command": command,
                    "exit_code": code,
                    "output_sha256": hashlib.sha256(output.encode()).hexdigest(),
                    "output_tail": output[-4000:],
                }
            )
            if code != 0:
                raise KleanPreflightError(
                    f"{' '.join(command)} failed ({code}): {output[-600:]}"
                )
    _require_unchanged_snapshot(
        snapshot, frozen_input, discovery_manifest, generation
    )
    return {
        "schema_version": 3,
        "status": "PASS" if obligations else "KLEAN_NO_OBLIGATIONS",
        "frozen_input_sha256": input_hash,
        "stage1_workspace_sha256": input_hash,
        "stage3_discovery_manifest_sha256": discovery_hash,
        "generated_tree_sha256": generated_hash,
        "target": target,
        "obligation_count": len(obligations),
        "trust_declaration_count": len(declared),
        "designated_sorry_count": 0,
        "diagnostics": diagnostics,
    }


