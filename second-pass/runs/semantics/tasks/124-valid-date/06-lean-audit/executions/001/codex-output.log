/bin/bash -lc "set -o pipefail && python - <<'PY' 2>&1 | tee /audit-output/evidence/27_semantic_adversarial_checks.log
from itertools import product

def program_control(c):
    if len(c) "'!= 10:
        return False
    if c[2] != 45 or c[5] != 45:
        return False
    m0,m1,d0,d1,y0,y1,y2,y3=c[0],c[1],c[3],c[4],c[6],c[7],c[8],c[9]
    if any(x < 48 or x > 57 for x in (m0,m1,d0,d1,y0,y1,y2,y3)):
        return False
    month=(m0-48)*10+m1-48
    day=(d0-48)*10+d1-48
    if month < 1 or month > 12:
        return False
    if day < 1:
        return False
    if month == 2:
        return day <= 29
    if month in (4,6,9,11):
        return day <= 30
    return day <= 31

def digit_code(x): return 48 <= x <= 57
def date_number(t,o): return (t-48)*10+o-48
def date_limit(m): return 29 if m==2 else (30 if m in (4,6,9,11) else 31)
def k_summary(c):
    if len(c) != 10: return False
    m0,m1,s1,d0,d1,s2,y0,y1,y2,y3=c
    m=date_number(m0,m1); d=date_number(d0,d1)
    return (s1==45 and s2==45 and
            all(digit_code(x) for x in (m0,m1,d0,d1,y0,y1,y2,y3)) and
            1 <= m <= 12 and 1 <= d <= date_limit(m))

def codes(s): return tuple(map(ord,s))
examples=['"'','03-11-2000','15-01-2012','04-0-2040','06-04-2020','06/04/2020',
          '02-29-2023','02-30-2023','04-30-2040','04-31-2040','01-31-0000',
          '00-01-2000','12-00-2000','12-31-20x0','12-31-20000','1a-01-2000',
          '01-01-000x','13-01-2000','11-31-2000','12-31-9999']
print('TARGETED')
for s in examples:
    a=program_control(codes(s)); b=k_summary(codes(s))
    print(repr(s),a,b,'MATCH',a==b)

representatives=[-1000,45,47,*range(48,58),58,1000]
separators=[-1000,44,45,46,1000]
year=(50,48,50,51)
checked=0; mismatches=[]
for m0,m1,d0,d1,s1,s2 in product(representatives,representatives,representatives,representatives,separators,separators):
    c=(m0,m1,s1,d0,d1,s2,*year)
    a=program_control(c); b=k_summary(c); checked+=1
    if a"'!=b and len(mismatches)<10: mismatches.append((c,a,b))
print('"'PARTITION_PRODUCT_CHECKED',checked,'MISMATCH_COUNT',len(mismatches))
print('MISMATCHES',mismatches)

# Every year position is separately perturbed across low, boundary, high and extreme codes.
year_checked=0; year_mismatches=[]
base=list(codes('12-31-2023'))
for pos in (6,7,8,9):
    for value in representatives:
        c=base.copy(); c[pos]=value; c=tuple(c)
        a=program_control(c); b=k_summary(c); year_checked+=1
        if a"'!=b: year_mismatches.append((c,a,b))
print('"'YEAR_PERTURBATIONS_CHECKED',year_checked,'MISMATCH_COUNT',len(year_mismatches))

# Length partition and arbitrary-code witnesses.
length_checked=0; length_mismatches=[]
for n in list(range(0,10))+list(range(11,16)):
    for value in (-1000,0,45,48,57,58,1000):
        c=(value,)*n; a=program_control(c); b=k_summary(c); length_checked+=1
        if a"'!=b: length_mismatches.append((c,a,b))
print('"'NON_TEN_LENGTHS_CHECKED',length_checked,'MISMATCH_COUNT',len(length_mismatches))

# Deliberate counterfactual summaries, each with a frozen-source discriminator.
def mutated(c, mutation):
    if len(c)"'!=10: return False
    m0,m1,s1,d0,d1,s2,y0,y1,y2,y3=c
    m=date_number(m0,m1); d=date_number(d0,d1)
    year_ok=all(digit_code(x) for x in (y0,y1,y2,y3))
    if mutation=='"'omit_year_digits': year_ok=True
    sep_ok=(s1==45 and s2==45)
    if mutation=='allow_slash': sep_ok=(s1 in (45,47) and s2 in (45,47))
    digit_ok=all(digit_code(x) for x in (m0,m1,d0,d1)) and year_ok
    month_ok=1<=m<=12
    if mutation=='allow_month_zero': month_ok=0<=m<=12
    lim=date_limit(m)
    if mutation=='feb_28' and m==2: lim=28
    if mutation=='april_31' and m==4: lim=31
    return sep_ok and digit_ok and month_ok and 1<=d<=lim
witnesses={
 'feb_28':'02-29-2023',
 'omit_year_digits':'01-01-20x0',
 'allow_slash':'06/04/2020',
 'allow_month_zero':'00-01-2000',
 'april_31':'04-31-2040',
}
print('COUNTERFACTUALS')
for mutation,s in witnesses.items():
    c=codes(s); actual=program_control(c); wrong=mutated(c,mutation)
    print(mutation,repr(s),'program=',actual,'mutated=',wrong,'DISCRIMINATES',actual"'!=wrong)
print('"'ORIGINAL_ZERO_MISMATCH',not mismatches and not year_mismatches and not length_mismatches)
