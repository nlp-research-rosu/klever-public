diff --git a/evidence/lean_pidns_fix.c b/evidence/lean_pidns_fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..3686c0268a2642a1cd8327b126c80c6676b79af7
--- /dev/null
+++ b/evidence/lean_pidns_fix.c
@@ -0,0 +1,16 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <string.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+    static ssize_t (*real_readlink)(const char *, char *, size_t);
+    if (!real_readlink) real_readlink = dlsym(RTLD_NEXT, "readlink");
+    ssize_t result = real_readlink(path, buf, size);
+    if (result < 0 && path && strncmp(path, "/proc/", 6) == 0 &&
+        strlen(path) > 10 &&
+        strcmp(path + strlen(path) - 4, "/exe") == 0) {
+        return real_readlink("/proc/self/exe", buf, size);
+    }
+    return result;
+}

