import hashlib, json
from pathlib import Path
from tools.k_rule_inventory import inventory_verification, canonical_json_sha256
from tools.lemma_discovery_contract import validate_trust_boundary
w=Path('/reference/k-proof'); m=Path('/reference/lemma-discovery.json')
inv=inventory_verification(w)
disc=json.loads(m.read_text())
validated=validate_trust_boundary(w,m)
print('validate_trust_boundary=PASS')
print('verification_module', inv['verification_module'])
print('verification_modules', inv['verification_modules'])
print('inventory_count', len(inv['rules']))
print('discovery_count', len(disc['rules']))
print('inventory_sha256_recomputed', canonical_json_sha256(inv['rules']))
print('inventory_sha256_inventory', inv['inventory_sha256'])
print('inventory_sha256_discovery', disc['inventory_sha256'])
print('validated_inventory_sha256', validated['inventory_sha256'])
print('discovery_file_sha256', hashlib.sha256(m.read_bytes()).hexdigest())
print('id_unique_inventory', len({r['source_rule_id'] for r in inv['rules']}) == len(inv['rules']))
print('id_unique_discovery', len({r['source_rule_id'] for r in disc['rules']}) == len(disc['rules']))
print('ordered_ids_equal', [r['source_rule_id'] for r in inv['rules']] == [r['source_rule_id'] for r in disc['rules']])
print('set_ids_equal', {r['source_rule_id'] for r in inv['rules']} == {r['source_rule_id'] for r in disc['rules']})
for i,(r,c) in enumerate(zip(inv['rules'],disc['rules']),1):
    normalized=' '.join(r['text'].split())
    direct=hashlib.sha256(normalized.encode()).hexdigest()
    print(f'RULE {i}')
    print(' id',r['source_rule_id'])
    print(' module',r['module'])
    print(' span',r['start_line'],r['end_line'])
    print(' attributes',r['attributes'])
    print(' normalized_sha256',r['normalized_sha256'])
    print(' independently_rehashed',direct,'MATCH',direct==r['normalized_sha256'])
    print(' source_rule_id_formula_match',r['source_rule_id']=='rule-'+direct)
    print(' discovery_order_id_match',r['source_rule_id']==c['source_rule_id'])
    print(' classification',c['classification'])
    print(' rationale',c['rationale'])
print('validated_categories', {k:len(validated[k]) for k in ('definitions','operational_rules','proved_derived_lemmas','domain_lemmas')})
