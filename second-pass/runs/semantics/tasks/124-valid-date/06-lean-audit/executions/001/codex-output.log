diff --git a//tmp/audit-work/pathtrace.c b//tmp/audit-work/pathtrace.c
new file mode 100644
index 0000000000000000000000000000000000000000..ff00ea3413939596e2443b47f2d2fda2391a6de6
--- /dev/null
+++ b//tmp/audit-work/pathtrace.c
@@ -0,0 +1,36 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+    static ssize_t (*real_readlink)(const char *, char *, size_t);
+    if (!real_readlink) real_readlink = dlsym(RTLD_NEXT, "readlink");
+    ssize_t result = real_readlink(path, buf, size);
+    if (result < 0 && path && path[0] == '/' &&
+        strncmp(path, "/proc/", 6) == 0 &&
+        strlen(path) > 10 &&
+        strcmp(path + strlen(path) - 4, "/exe") == 0) {
+        result = real_readlink("/proc/self/exe", buf, size);
+    }
+    int saved = errno;
+    fprintf(stderr, "PATHTRACE readlink(%s) -> %zd errno=%d value=%.*s\n",
+            path, result, saved, result > 0 ? (int)result : 0, buf);
+    errno = saved;
+    return result;
+}
+
+char *realpath(const char *path, char *resolved) {
+    static char *(*real_realpath)(const char *, char *);
+    if (!real_realpath) real_realpath = dlsym(RTLD_NEXT, "realpath");
+    char *result = real_realpath(path, resolved);
+    int saved = errno;
+    fprintf(stderr, "PATHTRACE realpath(%s) -> %s errno=%d\n",
+            path, result ? result : "(null)", saved);
+    errno = saved;
+    return result;
+}
