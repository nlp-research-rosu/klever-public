    24	      Name("m0"),
    25	      Call(Name("ord"), Subscript(Name("date"), Int(0))))
    26	    Assign(
    27	      Name("m1"),
    28	      Call(Name("ord"), Subscript(Name("date"), Int(1))))
    29	    Assign(
    30	      Name("d0"),
    31	      Call(Name("ord"), Subscript(Name("date"), Int(3))))
    32	    Assign(
    33	      Name("d1"),
    34	      Call(Name("ord"), Subscript(Name("date"), Int(4))))
    35	    Assign(
    36	      Name("y0"),
    37	      Call(Name("ord"), Subscript(Name("date"), Int(6))))
    38	    Assign(
    39	      Name("y1"),
