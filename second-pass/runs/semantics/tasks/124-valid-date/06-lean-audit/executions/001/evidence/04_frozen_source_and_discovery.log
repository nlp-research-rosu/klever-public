+ nl -ba /reference/k-proof/solution.py
     1	def valid_date(date):
     2	    if len(date) != 10:
     3	        return False
     4	
     5	    if ord(date[2]) != 45 or ord(date[5]) != 45:
     6	        return False
     7	
     8	    m0 = ord(date[0])
     9	    m1 = ord(date[1])
    10	    d0 = ord(date[3])
    11	    d1 = ord(date[4])
    12	    y0 = ord(date[6])
    13	    y1 = ord(date[7])
    14	    y2 = ord(date[8])
    15	    y3 = ord(date[9])
    16	
    17	    if (
    18	        m0 < 48 or m0 > 57
    19	        or m1 < 48 or m1 > 57
    20	        or d0 < 48 or d0 > 57
    21	        or d1 < 48 or d1 > 57
    22	        or y0 < 48 or y0 > 57
    23	        or y1 < 48 or y1 > 57
    24	        or y2 < 48 or y2 > 57
    25	        or y3 < 48 or y3 > 57
    26	    ):
    27	        return False
    28	
    29	    month = (m0 - 48) * 10 + m1 - 48
    30	    day = (d0 - 48) * 10 + d1 - 48
    31	
    32	    if month < 1 or month > 12:
    33	        return False
    34	    if day < 1:
    35	        return False
    36	
    37	    if month == 2:
    38	        return day <= 29
    39	    if month == 4 or month == 6 or month == 9 or month == 11:
    40	        return day <= 30
    41	    return day <= 31
