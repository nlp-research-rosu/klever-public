     5	
     6	kompile reference-semantics/semantics.k \
     7	  --backend llvm \
     8	  --main-module MPY-KRUN \
     9	  --syntax-module MPY-SYNTAX \
    10	  --output-definition runtime-kompiled
    11	
    12	cp solution.py .concrete_tests.py
    13	printf '%s\n' '' \
    14	  'assert valid_date("03-11-2000") == True' \
    15	  'assert valid_date("15-01-2012") == False' \
    16	  'assert valid_date("04-0-2040") == False' \
    17	  'assert valid_date("06-04-2020") == True' \
    18	  'assert valid_date("06/04/2020") == False' \
    19	  'assert valid_date("") == False' \
    20	  'assert valid_date("02-29-2023") == True' \
    21	  'assert valid_date("02-30-2023") == False' \
    22	  'assert valid_date("04-30-2040") == True' \
    23	  'assert valid_date("04-31-2040") == False' \
    24	  'assert valid_date("01-31-0000") == True' \
    25	  'assert valid_date("00-01-2000") == False' \
    26	  'assert valid_date("12-00-2000") == False' \
    27	  'assert valid_date("12-31-20x0") == False' \
    28	  'assert valid_date("12-31-20000") == False' >> .concrete_tests.py
    29	python3 py2mpy.py .concrete_tests.py > .concrete_tests.mpy
    30	krun .concrete_tests.mpy --definition runtime-kompiled
    31	rm -f .concrete_tests.py .concrete_tests.mpy
