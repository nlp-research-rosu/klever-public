    35	    <k>
    36	      #loadAll(validDateModule)
    37	      ~>
    38	      Call(
    39	        Name("valid_date"),
    40	        str(iCons(
    41	          M0:Int,
    42	          iCons(
    43	            M1:Int,
    44	            iCons(
    45	              SEP1:Int,
    46	              iCons(
    47	                D0:Int,
    48	                iCons(
    49	                  D1:Int,
    50	                  iCons(
    51	                    SEP2:Int,
    52	                    iCons(
    53	                      Y0:Int,
    54	                      iCons(
    55	                        Y1:Int,
    56	                        iCons(
    57	                          Y2:Int,
    58	                          iCons(Y3:Int, .IntSeq)))))))))))
    59	      )
    60	      =>
    61	      validDate10(M0, M1, SEP1, D0, D1, SEP2, Y0, Y1, Y2, Y3)
    62	    </k>
