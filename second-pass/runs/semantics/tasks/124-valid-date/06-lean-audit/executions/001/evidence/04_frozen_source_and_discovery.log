   110	  syntax Module ::= "validDateModule" [function, total]
   111	  rule validDateModule =>
   112	    Module(FuncDef("valid_date", Params("date"), validDateBody))
   113	
   114	  // Independent executable form of the natural-language contract.
   115	  syntax Bool ::= digitCode(Int) [function, total]
   116	  rule digitCode(C:Int) => 48 <=Int C andBool C <=Int 57
   117	
   118	  syntax Int ::= dateNumber(Int, Int) [function, total]
   119	  rule dateNumber(T:Int, O:Int) => ((T -Int 48) *Int 10) +Int O -Int 48
   120	
   121	  syntax Int ::= dateLimit(Int) [function, total]
   122	  rule dateLimit(M:Int) =>
   123	    #if M ==Int 2
   124	    #then 29
   125	    #else
   126	      #if M ==Int 4 orBool M ==Int 6 orBool M ==Int 9 orBool M ==Int 11
   127	      #then 30
   128	      #else 31
   129	      #fi
   130	    #fi
   131	
   132	  syntax Bool ::= validDate10(
   133	    Int, Int, Int, Int, Int, Int, Int, Int, Int, Int
   134	  ) [function, total]
   135	  rule validDate10(
   136	    M0:Int, M1:Int, SEP1:Int, D0:Int, D1:Int, SEP2:Int,
   137	    Y0:Int, Y1:Int, Y2:Int, Y3:Int
   138	  ) =>
   139	    SEP1 ==Int 45
   140	    andBool SEP2 ==Int 45
   141	    andBool digitCode(M0)
   142	    andBool digitCode(M1)
   143	    andBool digitCode(D0)
   144	    andBool digitCode(D1)
   145	    andBool digitCode(Y0)
   146	    andBool digitCode(Y1)
   147	    andBool digitCode(Y2)
   148	    andBool digitCode(Y3)
   149	    andBool 1 <=Int dateNumber(M0, M1)
   150	    andBool dateNumber(M0, M1) <=Int 12
   151	    andBool 1 <=Int dateNumber(D0, D1)
   152	    andBool dateNumber(D0, D1) <=Int dateLimit(dateNumber(M0, M1))
   153	endmodule
