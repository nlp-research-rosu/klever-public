     6	  // Every string whose length is not ten is rejected. Together with the next
     7	  // claim, this covers every string in the semantics' IntSeq representation.
     8	  claim
     9	    <k>
    10	      #loadAll(validDateModule)
    11	      ~> Call(Name("valid_date"), str(CS:IntSeq))
    12	      =>
    13	      false
    14	    </k>
    15	    <env> 0 </env>
    16	    <scopes>
    17	      0  |-> scope(.Map, parent(-1))
    18	      -1 |-> builtinsScope
    19	      =>
    20	      0  |-> scope("valid_date" |-> validDateClosure, parent(-1))
    21	      -1 |-> builtinsScope
    22	    </scopes>
    23	    <scopeLoc> 1 </scopeLoc>
    24	    <heap> .Map </heap>
    25	    <heapLoc> 0 </heapLoc>
    26	    <stack> .List </stack>
    27	    <ret> noRet </ret>
    28	    <exc> NoExc </exc>
    29	    <exit-code> 0 </exit-code>
    30	    requires isLen(CS) =/=Int 10
    31	
    32	  // A ten-character string is accepted exactly when it has mm-dd-yyyy digit
    33	  // and separator syntax and its month/day obey the prompt's bounds.
