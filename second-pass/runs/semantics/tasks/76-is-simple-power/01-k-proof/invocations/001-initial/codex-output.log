+      => simplePower(X, N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+  requires X >Int 1 andBool N <=Int 1
+
+  claim [function-positive-domain]:
+    <k> #loadAll(solutionModule)
+         ~> Call(Name("is_simple_power"), Int(X), Int(N))
+      => simplePower(X, N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+  requires X >Int 1 andBool N >Int 1
+endmodule
