+requires "verification.k"
+
+module SIMPLE-POWER-SPEC
+  imports SIMPLE-POWER-VERIFICATION
+
+  // Inductive invariant: at the head of the repeated-division loop, the
+  // remaining computation returns simplePower of the current x and n.
+  claim [loop-correct]:
+    <k> #while(powerCondition, powerLoopBody)
+         ~> (Return(powerResult) .Stmts) ~> #endcall
+      => positivePowerLoop(X, N)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      BASE:Map
+      1 |-> scope(.Map [ "x" <- X ] [ "n" <- N ], _P:Parent)
+      =>
+      ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+  requires N >Int 1
+
+  // The following four end-to-end claims partition all integer arguments.
+  // Each starts from the supplied MPY namespaces, loads the exact generated
+  // solution module, calls its entry point, and observes the returned Boolean.
+  claim [function-one]:
+    <k> #loadAll(solutionModule)
+         ~> Call(Name("is_simple_power"), Int(1), Int(N))
+      => simplePower(1, N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+
+  claim [function-below-one]:
+    <k> #loadAll(solutionModule)
+         ~> Call(Name("is_simple_power"), Int(X), Int(N))
+      => simplePower(X, N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+  requires X <Int 1
+
+  claim [function-degenerate-base]:
+    <k> #loadAll(solutionModule)
+         ~> Call(Name("is_simple_power"), Int(X), Int(N))
+      => simplePower(X, N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+  requires X >Int 1 andBool N <=Int 1
+
+  claim [function-positive-domain]:
+    <k> #loadAll(solutionModule)
+         ~> Call(Name("is_simple_power"), Int(X), Int(N))
+      => simplePower(X, N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+  requires X >Int 1 andBool N >Int 1
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..3b80b72ccd310f5ee61f6ca369e1bffb92f1b9d3
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,56 @@
+requires "reference-semantics/semantics.k"
+
+module SIMPLE-POWER-VERIFICATION
+  imports MPY
+
+  // A total characterization over K integers.  On the meaningful power
+  // domain X >= 1 and N >= 2, exact division removes one factor of N.
+  syntax Bool ::= simplePower(Int, Int) [function]
+                | positivePowerLoop(Int, Int) [function]
+
+  rule simplePower(X, _N) => true
+    requires X ==Int 1
+  rule simplePower(X, _N) => false
+    requires X <Int 1
+  rule simplePower(X, N) => false
+    requires X >Int 1 andBool N <=Int 1
+  rule simplePower(X, N) => positivePowerLoop(X, N)
+    requires X >Int 1 andBool N >Int 1
+
+  rule positivePowerLoop(X, N) => positivePowerLoop(X /Int N, N)
+    requires pyMod(X, N) ==Int 0
+  rule positivePowerLoop(X, N) => X ==Int 1
+    requires pyMod(X, N) =/=Int 0
+
+  // Named pieces of the generated AST keep the claims readable.  Their
+  // expansions are exactly the constructors in solution.mpy.
+  syntax Expr ::= "powerCondition" [macro]
+  rule powerCondition
+    => Compare(BinOp("%", Name("x"), Name("n")), CmpOp("==", Int(0)))
+
+  syntax Stmts ::= "powerLoopBody" [macro]
+  rule powerLoopBody
+    => Assign(Name("x"), BinOp("//", Name("x"), Name("n")))
+
+  syntax Expr ::= "powerResult" [macro]
+  rule powerResult
+    => Compare(Name("x"), CmpOp("==", Int(1)))
+
+  syntax Stmt ::= "powerLoop" [macro]
+  rule powerLoop => While(powerCondition, powerLoopBody)
+
+  syntax Stmts ::= "powerBody" [macro]
+  rule powerBody
+    => If(Compare(Name("x"), CmpOp("==", Int(1))),
+          Return(Bool(true)), .Stmts)
+       If(Compare(Name("x"), CmpOp("<", Int(1))),
+          Return(Bool(false)), .Stmts)
+       If(Compare(Name("n"), CmpOp("<=", Int(1))),
+          Return(Bool(false)), .Stmts)
+       powerLoop
+       Return(powerResult)
+
+  syntax Module ::= "solutionModule" [macro]
+  rule solutionModule
+    => Module(FuncDef("is_simple_power", Params("x", "n"), powerBody))
+endmodule

