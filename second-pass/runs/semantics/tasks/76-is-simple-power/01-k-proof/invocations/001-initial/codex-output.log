import ast
from pathlib import Path
from solution import is_simple_power

source = ast.parse(Path('solution.py').read_text())
assert isinstance(source.body[0], ast.FunctionDef)
assert source.body[0].name == 'is_simple_power'
assert [a.arg for a in source.body[0].args.args] == ['x', 'n']

def mathematical_positive_power(x, n):
    if x == 1:
        return True
    if x < 1 or n <= 1:
        return False
    p = 1
    while p < x:
        p *= n
    return p == x

for x in range(-5, 501):
