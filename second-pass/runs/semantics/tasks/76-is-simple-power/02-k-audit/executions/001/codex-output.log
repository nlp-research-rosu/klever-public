+  exit 64
+fi
+
+log_path=$1
+shift
+tmp_path=$(mktemp /tmp/audit-command-output.XXXXXX)
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$log_path"
+
+set +e
+"$@" > "$tmp_path" 2>&1
+command_status=$?
