     2	  FuncDef("is_simple_power", Params("x", "n"),
     3	    If(Compare(Name("x"), CmpOp("==", Int(1))),
     4	      Return(Bool(true)),
     5	      )
     6	    If(Compare(Name("x"), CmpOp("<", Int(1))),
     7	      Return(Bool(false)),
     8	      )
     9	    If(Compare(Name("n"), CmpOp("<=", Int(1))),
    10	      Return(Bool(false)),
    11	      )
    12	    While(Compare(BinOp("%", Name("x"), Name("n")), CmpOp("==", Int(0))),
    13	      Assign(Name("x"), BinOp("//", Name("x"), Name("n"))))
    14	    Return(Compare(Name("x"), CmpOp("==", Int(1))))))

