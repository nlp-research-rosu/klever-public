     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd -- "$(dirname -- "$0")"
     5	
     6	# Regenerate both MPY programs from their Python sources.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
     9	python3 -c 'import ast, pathlib; s = ast.parse(pathlib.Path("solution.py").read_text()).body[0]; h = ast.parse(pathlib.Path("concrete_tests.py").read_text()).body[0]; assert ast.dump(s) == ast.dump(h)'
    10	
    11	# Concrete LLVM execution of all examples from prompt.py.
    12	kompile reference-semantics/semantics.k \
    13	  --backend llvm \
    14	  --main-module MPY-KRUN \
    15	  --syntax-module MPY-SYNTAX \
    16	  --output-definition runtime-kompiled
    17	krun concrete_tests.mpy \
    18	  --definition runtime-kompiled \
    19	  --output none
    20	
    21	# Symbolic definition: verification.k imports MPY from the supplied semantics.
    22	kompile verification.k \
    23	  --backend haskell \
    24	  --main-module SIMPLE-POWER-VERIFICATION \
    25	  --syntax-module SIMPLE-POWER-VERIFICATION \
    26	  --output-definition verification-kompiled
    27	
    28	# Gate the hand-readable solutionModule macro against the translator output.
    29	diff -u \
    30	  <(kast solution.mpy --definition verification-kompiled --module SIMPLE-POWER-VERIFICATION --sort Module --expand-macros --output kore) \
    31	  <(kast --expression solutionModule --definition verification-kompiled --module SIMPLE-POWER-VERIFICATION --sort Module --expand-macros --output kore)
    32	
    33	# First prove the inductive loop lemma.
    34	kprove spec.k \
    35	  --definition verification-kompiled \
    36	  --spec-module SIMPLE-POWER-SPEC \
    37	  --claims SIMPLE-POWER-SPEC.loop-correct \
    38	  --smt-timeout 10000
    39	
    40	# Prove the three terminating guard partitions.
    41	kprove spec.k \
    42	  --definition verification-kompiled \
    43	  --spec-module SIMPLE-POWER-SPEC \
    44	  --claims SIMPLE-POWER-SPEC.function-one,SIMPLE-POWER-SPEC.function-below-one,SIMPLE-POWER-SPEC.function-degenerate-base \
    45	  --smt-timeout 10000
    46	
    47	# Prove the positive-domain entry point, using the loop claim proved above as
    48	# a lemma in this independent kprove invocation.
    49	kprove spec.k \
    50	  --definition verification-kompiled \
    51	  --spec-module SIMPLE-POWER-SPEC \
    52	  --claims SIMPLE-POWER-SPEC.loop-correct,SIMPLE-POWER-SPEC.function-positive-domain \
    53	  --trusted SIMPLE-POWER-SPEC.loop-correct \
    54	  --smt-timeout 10000

===== /candidate/concrete_tests.py =====
     1	def is_simple_power(x, n):
     2	    if x == 1:
     3	        return True
     4	    if x < 1:
     5	        return False
     6	    if n <= 1:
     7	        return False
     8	    while x % n == 0:
     9	        x = x // n
    10	    return x == 1
    11	
    12	
    13	assert is_simple_power(1, 4)
    14	assert is_simple_power(2, 2)
    15	assert is_simple_power(8, 2)
    16	assert not is_simple_power(3, 2)
    17	assert not is_simple_power(3, 1)
    18	assert not is_simple_power(5, 3)

