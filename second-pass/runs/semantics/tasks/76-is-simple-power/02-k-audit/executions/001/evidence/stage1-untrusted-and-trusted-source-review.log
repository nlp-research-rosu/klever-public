     6	def is_simple_power(x, n):
     7	    """Your task is to write a function that returns true if a number x is a simple
     8	    power of n and false in other cases.
     9	    x is a simple power of n if n**int=x
    10	    For example:
    11	    is_simple_power(1, 4) => true
    12	    is_simple_power(2, 2) => true
    13	    is_simple_power(8, 2) => true
    14	    is_simple_power(3, 2) => false
    15	    is_simple_power(3, 1) => false
    16	    is_simple_power(5, 3) => false
    17	    """
    18	    if (n == 1): 
    19	        return (x == 1) 
    20	    power = 1
    21	    while (power < x): 
    22	        power = power * n 
    23	    return (power == x) 

===== /candidate/solution.py =====
     1	def is_simple_power(x, n):
     2	    if x == 1:
     3	        return True
     4	    if x < 1:
     5	        return False
     6	    if n <= 1:
     7	        return False
     8	    while x % n == 0:
     9	        x = x // n
    10	    return x == 1

