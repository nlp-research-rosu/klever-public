===== /candidate/verification.k =====
     1	requires "reference-semantics/semantics.k"
     2	
     3	module SIMPLE-POWER-VERIFICATION
     4	  imports MPY
     5	
     6	  // A total characterization over K integers.  On the meaningful power
     7	  // domain X >= 1 and N >= 2, exact division removes one factor of N.
     8	  syntax Bool ::= simplePower(Int, Int) [function]
     9	                | positivePowerLoop(Int, Int) [function]
    10	
    11	  rule simplePower(X, _N) => true
    12	    requires X ==Int 1
    13	  rule simplePower(X, _N) => false
    14	    requires X <Int 1
    15	  rule simplePower(X, N) => false
    16	    requires X >Int 1 andBool N <=Int 1
    17	  rule simplePower(X, N) => positivePowerLoop(X, N)
    18	    requires X >Int 1 andBool N >Int 1
    19	
    20	  rule positivePowerLoop(X, N) => positivePowerLoop(X /Int N, N)
    21	    requires pyMod(X, N) ==Int 0
    22	  rule positivePowerLoop(X, N) => X ==Int 1
    23	    requires pyMod(X, N) =/=Int 0
    24	
    25	  // Named pieces of the generated AST keep the claims readable.  Their
    26	  // expansions are exactly the constructors in solution.mpy.
    27	  syntax Expr ::= "powerCondition" [macro]
    28	  rule powerCondition
    29	    => Compare(BinOp("%", Name("x"), Name("n")), CmpOp("==", Int(0)))
    30	
    31	  syntax Stmts ::= "powerLoopBody" [macro]
    32	  rule powerLoopBody
    33	    => Assign(Name("x"), BinOp("//", Name("x"), Name("n")))
    34	
    35	  syntax Expr ::= "powerResult" [macro]
    36	  rule powerResult
    37	    => Compare(Name("x"), CmpOp("==", Int(1)))
    38	
    39	  syntax Stmt ::= "powerLoop" [macro]
    40	  rule powerLoop => While(powerCondition, powerLoopBody)
    41	
    42	  syntax Stmts ::= "powerBody" [macro]
    43	  rule powerBody
    44	    => If(Compare(Name("x"), CmpOp("==", Int(1))),
    45	          Return(Bool(true)), .Stmts)
    46	       If(Compare(Name("x"), CmpOp("<", Int(1))),
    47	          Return(Bool(false)), .Stmts)
    48	       If(Compare(Name("n"), CmpOp("<=", Int(1))),
    49	          Return(Bool(false)), .Stmts)
    50	       powerLoop
    51	       Return(powerResult)
    52	
    53	  syntax Module ::= "solutionModule" [macro]
    54	  rule solutionModule
    55	    => Module(FuncDef("is_simple_power", Params("x", "n"), powerBody))
    56	endmodule

