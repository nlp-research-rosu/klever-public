+ATTRIBUTES = (
+    "function",
+    "total",
+    "functional",
+    "opaque",
+    "macro",
+    "strict",
+    "seqstrict",
+    "priority",
+    "owise",
+    "simplification",
+    "concrete",
+    "symbol",
+)
