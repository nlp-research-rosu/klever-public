===== /candidate/solution.py
     1	def is_simple_power(x, n):
     2	    if x == 1:
     3	        return True
     4	    if x < 1:
     5	        return False
     6	    if n <= 1:
     7	        return False
     8	    while x % n == 0:
     9	        x = x // n
    10	    return x == 1
