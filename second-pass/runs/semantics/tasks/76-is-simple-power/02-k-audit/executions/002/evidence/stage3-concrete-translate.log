COMMAND: bash -lc python3\ py2mpy.py\ audit_concrete_tests.py\ \>\ audit_concrete_tests.mpy\;\ sha256sum\ audit_concrete_tests.py\ audit_concrete_tests.mpy\;\ sed\ -n\ \"1\,120p\"\ audit_concrete_tests.mpy
f931aef4e1354f08dd96e9a01a36119e22c0fbb2650750c6807535c0166d6210  audit_concrete_tests.py
0be28426c3eef1446ca066a81f3c3a7b1f857c16233ca6890be8450b2ef82eb8  audit_concrete_tests.mpy
Module(
  FuncDef("is_simple_power", Params("x", "n"),
    If(Compare(Name("x"), CmpOp("==", Int(1))),
      Return(Bool(true)),
      )
    If(Compare(Name("x"), CmpOp("<", Int(1))),
      Return(Bool(false)),
      )
    If(Compare(Name("n"), CmpOp("<=", Int(1))),
      Return(Bool(false)),
      )
    While(Compare(BinOp("%", Name("x"), Name("n")), CmpOp("==", Int(0))),
      Assign(Name("x"), BinOp("//", Name("x"), Name("n"))))
    Return(Compare(Name("x"), CmpOp("==", Int(1)))))
  Assert(Call(Name("is_simple_power"), Int(1), Int(4)))
  Assert(Call(Name("is_simple_power"), Int(2), Int(2)))
  Assert(Call(Name("is_simple_power"), Int(8), Int(2)))
  Assert(UnaryOp("not", Call(Name("is_simple_power"), Int(3), Int(2))))
  Assert(UnaryOp("not", Call(Name("is_simple_power"), Int(3), Int(1))))
  Assert(UnaryOp("not", Call(Name("is_simple_power"), Int(5), Int(3))))
  Assert(
    UnaryOp(
      "not",
      Call(Name("is_simple_power"), UnaryOp("-", Int(1)), Int(2))))
  Assert(UnaryOp("not", Call(Name("is_simple_power"), Int(0), Int(2))))
  Assert(Call(Name("is_simple_power"), Int(1), UnaryOp("-", Int(1))))
  Assert(
    UnaryOp(
      "not",
      Call(Name("is_simple_power"), Int(2), UnaryOp("-", Int(1)))))
  Assert(UnaryOp("not", Call(Name("is_simple_power"), Int(2), Int(0))))
  Assert(UnaryOp("not", Call(Name("is_simple_power"), Int(2), Int(1))))
  Assert(Call(Name("is_simple_power"), Int(16), Int(2)))
  Assert(Call(Name("is_simple_power"), Int(16), Int(4)))
  Assert(UnaryOp("not", Call(Name("is_simple_power"), Int(24), Int(2))))
  Assert(
    UnaryOp("not", Call(Name("is_simple_power"), Int(128), Int(4)))))
EXIT_STATUS: 0
