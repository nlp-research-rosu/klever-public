reference-semantics/semantics/builtins.k:209:  rule tokOps(iCons(47, iCons(47, R:IntSeq))) => oCons("//", tokOps(R))
reference-semantics/semantics/builtins.k:234:  rule applyOpE("//", A:Int, B:Int) => A divInt B
reference-semantics/semantics/builtins.k:266:  rule inLevelE("mul", O:String) => O ==String "*" orBool O ==String "//" orBool O ==String "/"
reference-semantics/semantics/builtins.k:276:  // ==== hashlib.md5(S).hexdigest() — a trusted opaque digest ==================
