+    <k> #loop(list(VS:ValSeq), Name("num"), #specialElementBody)
+      => .K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        "nums"   |-> list(ALL:ValSeq)
+        "count"  |-> C:Int
+        "num"    |-> OLDNUM:Int
+        "digits" |-> OLDDIGITS:Str,
+        P:Parent)
+      =>
+      SC
+      L |-> scope(
+        "nums"   |-> list(ALL)
+        "count"  |-> C +Int specialCount(VS)
+        "num"    |-> finalNum(OLDNUM, VS)
+        "digits" |-> finalDigits(OLDDIGITS, VS),
+        P)
+    </scopes>
+    requires intsOnly(VS)
+endmodule

