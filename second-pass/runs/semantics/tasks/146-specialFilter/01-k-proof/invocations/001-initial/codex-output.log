+    <k>
+      #loadAll(#specialModule)
+      ~> Call(Name("specialFilter"), list(intVals(NS:IntSeq)))
+      =>
+      specialCount(NS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+        "specialFilter" |->
+          closureVal(("nums", .ParamNames), #specialFunctionBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
