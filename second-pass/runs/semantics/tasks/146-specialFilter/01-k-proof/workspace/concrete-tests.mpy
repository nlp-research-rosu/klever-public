Module(
  FuncDef("specialFilter", Params("nums"),
    Assign(Name("count"), Int(0))
    Assign(Name("num"), Int(0))
    Assign(Name("digits"), Str(""))
    For(Name("num"), Name("nums"),
      If(Compare(Name("num"), CmpOp(">", Int(10))),
        Assign(Name("digits"), Call(Name("str"), Name("num")))
        If(BoolOp(
          "and",
          Compare(
            Subscript(Name("digits"), Int(0)),
            CmpOp("in", Str("13579"))),
          Compare(
            Subscript(Name("digits"), UnaryOp("-", Int(1))),
            CmpOp("in", Str("13579")))),
          AugAssign(Name("count"), "+", Int(1)),
          ),
        ))
    Return(Name("count")))
  Assert(
    Compare(
      Call(
        Name("specialFilter"),
        ListExpr(
          Int(15),
          UnaryOp("-", Int(73)),
          Int(14),
          UnaryOp("-", Int(15)))),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(
        Name("specialFilter"),
        ListExpr(
          Int(33),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(3)),
          Int(45),
          Int(21),
          Int(109))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("specialFilter"), ListExpr()),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("specialFilter"),
        ListExpr(
          Int(11),
          Int(13),
          Int(22),
          Int(31),
          Int(79),
          Int(109),
          Int(111),
          Int(13579),
          Int(20),
          Int(9990))),
      CmpOp("==", Int(7))))
  Assert(
    Compare(
      Call(
        Name("specialFilter"),
        ListExpr(
          Int(10),
          UnaryOp("-", Int(11)),
          Int(12),
          Int(20),
          Int(101),
          Int(123),
          Int(333),
          Int(707))),
      CmpOp("==", Int(4)))))
