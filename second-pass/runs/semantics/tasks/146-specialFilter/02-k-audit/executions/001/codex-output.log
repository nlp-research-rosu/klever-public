+    printf 'UNEXPECTED_BODY_MUTANT_PROOF_SUCCESS\n'
+    overall=1
+  fi
+  grep -q 'WarnStuckClaimState' "$evidence/stage5_body_mutant_proof.log"
+  stuck_status=$?
