+
+printf 'EXPECTED_BODY_MUTANT_PROOF_NONZERO=%s\n' "${proof_status:-not-run}"
+printf 'BODY_SENSITIVITY_OVERALL_EXIT=%s\n' "$overall"
+exit "$overall"
