diff --git a/evidence/oracle-witness-spec.k b/evidence/oracle-witness-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..cdc87822ab8b40a1dbbc92eb97957843e22a8a2f
--- /dev/null
+++ b/evidence/oracle-witness-spec.k
@@ -0,0 +1,41 @@
+requires "oracle-witness.k"
+
+module OPPOSITE-DECIMAL-INTERPRETATION-SPEC
+  imports OPPOSITE-DECIMAL-INTERPRETATION
+
+  // This executes the actual element body under the candidate's proof syntax,
+  // without importing the candidate's derived loop-summary rule. The admitted
+  // opposite interpretation proves that every symbolic N > 10 increments
+  // count. N=12 is a false concrete instance of that symbolic conclusion.
+  claim [opposite-loop-result]:
+    <k> #loop(
+          list(intVals(iCons(N:Int, .IntSeq))),
+          Name("num"),
+          #specialElementBody)
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        "nums"   |-> list(intVals(iCons(N, .IntSeq)))
+        "count"  |-> 0
+        "num"    |-> 0
+        "digits" |-> str(.IntSeq),
+        parent(0))
+      0  |-> scope(GLOBAL:Map, parent(-1))
+      -1 |-> scope(BUILTINMAP:Map, root)
+      =>
+      1 |-> scope(
+        "nums"   |-> list(intVals(iCons(N, .IntSeq)))
+        "count"  |-> 1
+        "num"    |-> N
+        "digits" |-> str(decimalCodes(N)),
+        parent(0))
+      0  |-> scope(GLOBAL, parent(-1))
+      -1 |-> scope(BUILTINMAP, root)
+    </scopes>
+    requires N >Int 10
+      andBool notBool ("str" in_keys(GLOBAL))
+      andBool "str" in_keys(BUILTINMAP)
+      andBool {BUILTINMAP["str"]}:>Val ==K typeV("str")
+endmodule
diff --git a/evidence/oracle-witness.k b/evidence/oracle-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..8ae2f1432080b18114f36ada23e08ae53856b5e5
--- /dev/null
+++ b/evidence/oracle-witness.k
@@ -0,0 +1,11 @@
+requires "verification.k"
+
+module OPPOSITE-DECIMAL-INTERPRETATION
+  imports SPECIALFILTER-VERIFICATION-SYNTAX
+
+  // A consistent opposite interpretation admitted by the three opaque
+  // decimal abstractions on symbolic integers: every integer appears to have
+  // two characters, both ASCII '1'.
+  rule decimalLength(_:Int) => 2
+  rule decimalCodeAt(_:Int, _:Int) => 49
+endmodule
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..361f8f2653b5af97f3db445c07c89a9ba6f076d9
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module SPECIALFILTER-SPEC-VACUITY
+  imports SPECIALFILTER-VERIFICATION
+
+  // False mutation: the empty input is required to return 1 instead of 0.
+  // Its precondition is the same satisfiable precondition as the positive
+  // closure-entry claim.
+  claim [specialfilter-empty-call-false-result]:
+    <k>
+      #applyK(
+        toCall(closureVal(
+          ("nums", .ParamNames),
+          #specialFunctionBody,
+          0)),
+        (list(intVals(.IntSeq)), .Vals))
+      =>
+      1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> scope(BUILTINMAP:Map, root)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires "str" in_keys(BUILTINMAP)
+      andBool {BUILTINMAP["str"]}:>Val ==K typeV("str")
+endmodule
diff --git a/evidence/stage1_integrity.sh b/evidence/stage1_integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..5b6094941b9cc7d9a9b371a26befeaee3d612054
--- /dev/null
+++ b/evidence/stage1_integrity.sh
@@ -0,0 +1,133 @@
+#!/usr/bin/env bash
+set -u
+set -o pipefail
+set -x
+
+printf '== candidate required metadata ==\n'
+for path in \
+  /candidate/run-input.json \
+  /candidate/metrics.json \
+  /candidate/codex-last.txt \
+  /candidate/codex-output.log
+do
+  if [[ -e "$path" || -L "$path" ]]; then
+    stat -c '%F %n -> %N' "$path"
+  else
+    printf 'MISSING %s\n' "$path"
+  fi
+done
+
+printf '== candidate structured traces ==\n'
+find /candidate -maxdepth 2 \
+  \( -iname '*trace*' -o -iname '*.jsonl' -o -iname '*.json' \) \
+  -printf '%y %p -> %l\n' | sort
+
+printf '== other candidate proof claims (untrusted, bounded) ==\n'
+for path in \
+  /candidate/PROOF.md \
+  /candidate/call-proof.out \
+  /candidate/loop-proof.out \
+  /candidate/concrete-krun.out
+do
+  if [[ -f "$path" && ! -L "$path" ]]; then
+    stat -c '%F %s bytes %n' "$path"
+    sha256sum "$path"
+    sed -n '1,160p' "$path"
+  elif [[ -e "$path" || -L "$path" ]]; then
+    stat -c 'MISTYPED_OR_SYMLINKED %F %n -> %N' "$path"
+  else
+    printf 'MISSING %s\n' "$path"
+  fi
+done
+
+printf '== trusted-mode boundary ==\n'
+if [[ -d /reference/reference-semantics && ! -L /reference/reference-semantics ]]; then
+  printf 'TRUSTED_SEMANTICS_PRESENT_DIRECTORY\n'
+else
+  printf 'TRUSTED_SEMANTICS_BOUNDARY_BREACH\n'
+fi
+
+printf '== candidate required source types ==\n'
+for path in \
+  /candidate/prompt.py \
+  /candidate/py2mpy.py \
+  /candidate/solution.py \
+  /candidate/solution.mpy \
+  /candidate/spec.k \
+  /candidate/verification.k \
+  /candidate/reference-semantics
+do
+  if [[ -e "$path" || -L "$path" ]]; then
+    stat -c '%F %n -> %N' "$path"
+  else
+    printf 'MISSING %s\n' "$path"
+  fi
+done
+
+printf '== prompt identity ==\n'
+cmp --silent /candidate/prompt.py /reference/prompt.py
+prompt_status=$?
+printf 'PROMPT_CMP_EXIT=%s\n' "$prompt_status"
+sha256sum /candidate/prompt.py /reference/prompt.py
+
+printf '== translator identity ==\n'
+cmp --silent /candidate/py2mpy.py /reference/py2mpy.py
+translator_status=$?
+printf 'TRANSLATOR_CMP_EXIT=%s\n' "$translator_status"
+sha256sum /candidate/py2mpy.py /reference/py2mpy.py
+
+printf '== semantics recursive type/path/content comparison ==\n'
+python3 - <<'PY'
+import hashlib
+import os
+from pathlib import Path
+
+trusted = Path("/reference/reference-semantics")
+candidate = Path("/candidate/reference-semantics")
+
+def inventory(root: Path):
+    entries = {}
+    for base, dirs, files in os.walk(root, followlinks=False):
+        for name in dirs + files:
+            path = Path(base) / name
+            rel = path.relative_to(root).as_posix()
+            if path.is_symlink():
+                entries[rel] = ("symlink", os.readlink(path))
+            elif path.is_dir():
+                entries[rel] = ("directory", None)
+            elif path.is_file():
+                entries[rel] = (
+                    "file",
+                    hashlib.sha256(path.read_bytes()).hexdigest(),
+                )
+            else:
+                entries[rel] = ("other", None)
+    return entries
+
+t = inventory(trusted)
+c = inventory(candidate)
+all_paths = sorted(set(t) | set(c))
+differences = 0
+for rel in all_paths:
+    if rel not in t:
+        print(f"ADDITIONAL {rel}: {c[rel]}")
+        differences += 1
+    elif rel not in c:
+        print(f"MISSING {rel}: expected {t[rel]}")
+        differences += 1
+    elif t[rel] != c[rel]:
+        print(f"CHANGED_OR_MISTYPED {rel}: trusted={t[rel]} candidate={c[rel]}")
+        differences += 1
+    elif c[rel][0] == "symlink":
+        print(f"SYMLINKED {rel}: candidate={c[rel]}")
+        differences += 1
+print(f"SEMANTICS_DIFFERENCE_COUNT={differences}")
+raise SystemExit(0 if differences == 0 else 1)
+PY
+semantics_status=$?
+printf 'SEMANTICS_COMPARE_EXIT=%s\n' "$semantics_status"
+
+if (( prompt_status == 0 && translator_status == 0 && semantics_status == 0 )); then
+  exit 0
+fi
+exit 1
