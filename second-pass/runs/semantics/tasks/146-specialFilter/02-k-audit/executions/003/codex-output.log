/reference/reference-semantics/semantics/methods.k:104:  rule applyMethod(str(CS:IntSeq), "replace", str(iCons(A:Int, .IntSeq)), str(iCons(B:Int, .IntSeq)), .Vals)
/reference/reference-semantics/semantics/methods.k:106:  syntax IntSeq ::= replaceC(IntSeq, Int, Int) [function, total]
/reference/reference-semantics/semantics/methods.k:107:  rule replaceC(.IntSeq, _:Int, _:Int)             => .IntSeq
/reference/reference-semantics/semantics/methods.k:108:  rule replaceC(iCons(C:Int, R:IntSeq), A:Int, B:Int) => iCons(B, replaceC(R, A, B)) requires C ==Int A
