/reference/reference-semantics/semantics/methods.k:126:  rule hasUpper(iCons(C:Int, S:IntSeq)) => isUpperC(C) orBool hasUpper(S)
/reference/reference-semantics/semantics/methods.k:128:  syntax Bool ::= hasLower(IntSeq) [function, total]
/reference/reference-semantics/semantics/methods.k:129:  rule hasLower(.IntSeq) => false
/reference/reference-semantics/semantics/methods.k:130:  rule hasLower(iCons(C:Int, S:IntSeq)) => isLowerC(C) orBool hasLower(S)
/reference/reference-semantics/semantics/methods.k:132:  syntax Bool ::= allAlpha(IntSeq) [function, total]
/reference/reference-semantics/semantics/methods.k:133:  rule allAlpha(.IntSeq) => true
/reference/reference-semantics/semantics/methods.k:134:  rule allAlpha(iCons(C:Int, S:IntSeq)) => isAlphaC(C) andBool allAlpha(S)
/reference/reference-semantics/semantics/methods.k:136:  syntax Bool ::= allDigit(IntSeq) [function, total]
/reference/reference-semantics/semantics/methods.k:137:  rule allDigit(.IntSeq) => true
/reference/reference-semantics/semantics/methods.k:138:  rule allDigit(iCons(C:Int, S:IntSeq)) => isDigitC(C) andBool allDigit(S)
