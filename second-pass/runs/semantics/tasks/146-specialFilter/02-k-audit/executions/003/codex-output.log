/reference/reference-semantics/semantics/methods.k:82:  syntax ValSeq ::= flushTok(ValSeq, IntSeq) [function]
/reference/reference-semantics/semantics/methods.k:83:  rule flushTok(ACC:ValSeq, .IntSeq)            => ACC
/reference/reference-semantics/semantics/methods.k:84:  rule flushTok(ACC:ValSeq, iCons(C:Int, T:IntSeq)) => valSeqConcat(ACC, vCons(str(iCons(C, T)), .ValSeq))
/reference/reference-semantics/semantics/methods.k:85:  syntax Bool ::= isWSC(Int) [function, total]
/reference/reference-semantics/semantics/methods.k:86:  rule isWSC(C:Int) => C ==Int 32 orBool C ==Int 9 orBool C ==Int 10 orBool C ==Int 13
/reference/reference-semantics/semantics/methods.k:89:  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), (kwV("sep", str(S:IntSeq)), .Vals))
