COMMAND: nl -ba frozen verification.k, spec.k, solution.py, solution.mpy
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // This is the executable body emitted in solution.mpy, packaged as a value
     7	  // so a claim can call it with arbitrary K integers.
     8	  syntax Val ::= "multiplyClosure" [function, total]
     9	  rule multiplyClosure
    10	    => closureVal(
    11	         ("a", "b"),
    12	         (Expr(
    13	            Str(
    14	              "Complete the function that takes two integers and returns\n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    "))
    15	          Return(
    16	            BinOp(
    17	              "*",
    18	              BinOp("%", Name("a"), Int(10)),
    19	              BinOp("%", Name("b"), Int(10))))),
    20	         0)
    21	
    22	  syntax KItem ::= "#runMultiply" "(" Int "," Int ")"
    23	  rule <k> #runMultiply(A:Int, B:Int)
    24	        => Call(multiplyClosure, A, B) ... </k>
    25	
    26	  // Contract vocabulary: Python's unit digit is its remainder modulo 10.
    27	  syntax Int ::= unitDigit(Int) [function, total]
    28	  rule unitDigit(I:Int) => pyMod(I, 10)
    29	
    30	  syntax Int ::= unitDigitProduct(Int, Int) [function, total]
    31	  rule unitDigitProduct(A:Int, B:Int)
    32	    => unitDigit(A) *Int unitDigit(B)
    33	endmodule
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  claim [multiply-correct]:
     7	    <k> #runMultiply(A:Int, B:Int)
     8	      => unitDigitProduct(A, B) </k>
     9	    <env> 0 </env>
    10	    <scopes>
    11	      0  |-> scope(.Map, parent(-1))
    12	      -1 |-> builtinsScope
    13	    </scopes>
    14	    <scopeLoc> 1 </scopeLoc>
    15	    <heap> .Map </heap>
    16	    <heapLoc> 0 </heapLoc>
    17	    <stack> .List </stack>
    18	    <ret> noRet </ret>
    19	    <exc> NoExc </exc>
    20	    <exit-code> 0 </exit-code>
    21	endmodule
     1	def multiply(a, b):
     2	    """Complete the function that takes two integers and returns
     3	    the product of their unit digits.
     4	    Assume the input is always valid.
     5	    Examples:
     6	    multiply(148, 412) should return 16.
     7	    multiply(19, 28) should return 72.
     8	    multiply(2020, 1851) should return 0.
     9	    multiply(14,-15) should return 20.
    10	    """
    11	    return (a % 10) * (b % 10)
     1	Module(
     2	  FuncDef("multiply", Params("a", "b"),
     3	    Expr(
     4	      Str(
     5	        "Complete the function that takes two integers and returns\n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    "))
     6	    Return(
     7	      BinOp(
     8	        "*",
     9	        BinOp("%", Name("a"), Int(10)),
    10	        BinOp("%", Name("b"), Int(10))))))
