diff --git a//tmp/audit-work/app_path_probe.c b//tmp/audit-work/app_path_probe.c
new file mode 100644
index 0000000000000000000000000000000000000000..32c47b54a3e93c9d99103b4ac347676cd9fba09c
--- /dev/null
+++ b//tmp/audit-work/app_path_probe.c
@@ -0,0 +1,14 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+    char name[128];
+    char target[4096] = {0};
+    int written = snprintf(name, sizeof(name), "/proc/%d/exe", getpid());
+    ssize_t count = readlink(name, target, sizeof(target) - 1);
+    printf("pid=%d name=%s snprintf=%d readlink=%zd errno=%d (%s) target=%s\n",
+           getpid(), name, written, count, errno, strerror(errno), target);
+    return count < 0;
+}
