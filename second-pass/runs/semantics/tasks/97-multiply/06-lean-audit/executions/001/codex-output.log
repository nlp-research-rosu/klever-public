+for path in \
+  /reference/k-proof \
+  /reference/k-audit \
+  /reference/lemma-discovery.json \
+  /reference/klean-generation \
+  /reference/generation-tools \
+  /reference/tools \
+  /reference/klean-toolchain.lock.json \
+  /candidate
+do
+  if test -e "$path"; then
+    stat -c 'PRESENT %F %A %U:%G %s %n' "$path"
