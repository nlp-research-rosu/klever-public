+printf '\nCOMMAND: python3 -m json.tool --sort-keys /audit-input.json\n'
+python3 -m json.tool --sort-keys /audit-input.json
+printf '\nCOMMAND: filesystem presence checks\n'
+for path in \
+  /reference/k-proof \
+  /reference/k-audit \
+  /reference/lemma-discovery.json \
