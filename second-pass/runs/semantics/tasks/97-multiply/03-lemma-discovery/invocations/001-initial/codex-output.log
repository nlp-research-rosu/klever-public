/bin/bash -lc "python3 - <<'PY'
import json
from pathlib import Path
inv = json.loads(Path('/reference/rule-inventory.json').read_text(encoding='utf-8'))
out = json.loads(Path('/workspace/trust-boundary.json').read_text(encoding='utf-8'))
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
assert [r['source_rule_id'] for r in out['rules']] == [r['source_rule_id'] for r in inv['rules']]
assert len({r['source_rule_id'] for r in out['rules']}) == len(inv['rules'])
for r in out['rules']:
    assert list(r) == ['source_rule_id', 'classification', 'rationale']
    assert r['classification'] in allowed
    assert isinstance(r['rationale'], str) and r['rationale'].strip()
for source, classified in zip(inv['rules'], out['rules']):
    if 'simplification' in source['attributes']:
        assert classified['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
assert not any(r['classification'] == 'PROVED_DERIVED_LEMMA' for r in out['rules'])
assert not any(r['classification'] == 'DOMAIN_LEMMA' for r in out['rules'])
print(f\"validated {len(out['rules'])} rules in canonical order\")
print('classifications:', [r['classification'] for r in out['rules']])
print('inventory_sha256:', out['inventory_sha256'])
