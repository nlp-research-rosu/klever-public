Module(
  FuncDef("multiply", Params("a", "b"),
    Expr(
      Str(
        "Concrete copy of solution.py for execution under the supplied semantics."))
    Return(
      BinOp(
        "*",
        BinOp("%", Name("a"), Int(10)),
        BinOp("%", Name("b"), Int(10)))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(148), Int(412)),
      CmpOp("==", Int(16))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(19), Int(28)),
      CmpOp("==", Int(72))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(2020), Int(1851)),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(14), UnaryOp("-", Int(15))),
      CmpOp("==", Int(20))))
  Assert(
    Compare(
      Call(
        Name("multiply"),
        UnaryOp("-", Int(14)),
        UnaryOp("-", Int(15))),
      CmpOp("==", Int(30)))))
