      "module": "VERIFICATION",
      "normalized_sha256": "d095c8888afcb3dd088fdc3c664435491743c78be0a54a41138084f98215f5e0",
      "rationale": "This equation defines the named proof term multiplyClosure as the exact executable closure value used to represent the translated solution.",
      "source_rule_id": "rule-d095c8888afcb3dd088fdc3c664435491743c78be0a54a41138084f98215f5e0",
      "start_line": 9,
      "text": "  rule multiplyClosure\n    => closureVal(\n         (\"a\", \"b\"),\n         (Expr(\n            Str(\n              \"Complete the function that takes two integers and returns\\n    the product of their unit digits.\\n    Assume the input is always valid.\\n    Examples:\\n    multiply(148, 412) should return 16.\\n    multiply(19, 28) should return 72.\\n    multiply(2020, 1851) should return 0.\\n    multiply(14,-15) should return 20.\\n    \"))\n          Return(\n            BinOp(\n              \"*\",\n              BinOp(\"%\", Name(\"a\"), Int(10)),\n              BinOp(\"%\", Name(\"b\"), Int(10))))),\n         0)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 28,
      "module": "VERIFICATION",
      "normalized_sha256": "9dd6dbfcce1300ea93b427dc414913c5a4ca13d4f90781207d2a75f3181ad8e0",
      "rationale": "This equation defines the contract summary unitDigit as the supplied semantics' Python-style remainder modulo 10.",
      "source_rule_id": "rule-9dd6dbfcce1300ea93b427dc414913c5a4ca13d4f90781207d2a75f3181ad8e0",
      "start_line": 28,
      "text": "  rule unitDigit(I:Int) => pyMod(I, 10)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 32,
      "module": "VERIFICATION",
      "normalized_sha256": "6aad8f4cafb083a2584e89e9e7ced610b42247ea1e1eadf1af9063b72ec8e2cd",
      "rationale": "This equation defines unitDigitProduct compositionally as the integer product of the two unitDigit summaries.",
      "source_rule_id": "rule-6aad8f4cafb083a2584e89e9e7ced610b42247ea1e1eadf1af9063b72ec8e2cd",
      "start_line": 31,
      "text": "  rule unitDigitProduct(A:Int, B:Int)\n    => unitDigit(A) *Int unitDigit(B)"
    }
  ],
  "frozen_input_sha256": "c28dc050066ba480f3a7e6cdebe0cbb3a6ea2cb0021bddda34532eddc61ef8ec",
