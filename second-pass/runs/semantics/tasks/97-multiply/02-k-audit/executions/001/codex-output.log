diff --git a/evidence/validate_review.py b/evidence/validate_review.py
new file mode 100644
index 0000000000000000000000000000000000000000..3d5ddd90ecc1586fd10f004c71e7518441404bd0
--- /dev/null
+++ b/evidence/validate_review.py
@@ -0,0 +1,21 @@
+#!/usr/bin/env python3
+from pathlib import Path
+import re
+
+
+review = Path("/audit-output/REVIEW.md")
+text = review.read_text(encoding="utf-8")
+links = re.findall(r"\]\((evidence/[^)]+)\)", text)
+missing = [link for link in links if not (review.parent / link).is_file()]
+stage_count = len(re.findall(r"^## [1-7]\.", text, re.MULTILINE))
+expected_end = "VERDICT: CONCERNS\nLEGITIMACY: LEGIT\n"
+
+print(f"stage_headers={stage_count}")
+print(f"evidence_links={len(links)} unique={len(set(links))}")
+print(f"missing_links={missing}")
+print(f"last_lines={text.splitlines()[-2:]}")
+print(f"ends_exact={text.endswith(expected_end)}")
+
+assert stage_count == 7
+assert not missing
+assert text.endswith(expected_end)
diff --git a/evidence/verification-body-mutated.k b/evidence/verification-body-mutated.k
new file mode 100644
index 0000000000000000000000000000000000000000..7a72a2daf524dedfdf123a149eee841dcc0466f8
--- /dev/null
+++ b/evidence/verification-body-mutated.k
@@ -0,0 +1,30 @@
+requires "/tmp/audit-work/candidate-src/reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  syntax Val ::= "multiplyClosure" [function, total]
+  rule multiplyClosure
+    => closureVal(
+         ("a", "b"),
+         (Expr(
+            Str(
+              "Complete the function that takes two integers and returns\n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    "))
+          Return(
+            BinOp(
+              "+",
+              BinOp("%", Name("a"), Int(10)),
+              BinOp("%", Name("b"), Int(10))))),
+         0)
+
+  syntax KItem ::= "#runMultiply" "(" Int "," Int ")"
+  rule <k> #runMultiply(A:Int, B:Int)
+        => Call(multiplyClosure, A, B) ... </k>
+
+  syntax Int ::= unitDigit(Int) [function, total]
+  rule unitDigit(I:Int) => pyMod(I, 10)
+
+  syntax Int ::= unitDigitProduct(Int, Int) [function, total]
+  rule unitDigitProduct(A:Int, B:Int)
+    => unitDigit(A) *Int unitDigit(B)
+endmodule

