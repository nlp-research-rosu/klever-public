index 0000000000000000000000000000000000000000..25a3eaa563b6828bb49fa1c074ebf3007b83a350
--- /dev/null
+++ b/evidence/ground-witness.k
@@ -0,0 +1,35 @@
+requires "/tmp/audit-work/candidate-src/verification.k"
+
+module GROUND-WITNESS
+  imports VERIFICATION
+
+  claim [example-positive-negative]:
