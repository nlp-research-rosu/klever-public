Module(
  FuncDef("multiply", Params("a", "b"),
    Return(
      BinOp(
        "*",
        BinOp("%", Name("a"), Int(10)),
        BinOp("%", Name("b"), Int(10)))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(148), Int(412)),
      CmpOp("==", Int(16))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(19), Int(28)),
      CmpOp("==", Int(72))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(2020), Int(1851)),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(14), UnaryOp("-", Int(15))),
      CmpOp("==", Int(20))))
  Assert(
    Compare(Call(Name("multiply"), Int(0), Int(0)), CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(9), Int(9)),
      CmpOp("==", Int(81))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(9), Int(10)),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(10), Int(9)),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("multiply"), UnaryOp("-", Int(9)), Int(9)),
      CmpOp("==", Int(9))))
  Assert(
    Compare(
      Call(Name("multiply"), UnaryOp("-", Int(10)), Int(9)),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("multiply"), UnaryOp("-", Int(11)), Int(9)),
      CmpOp("==", Int(81))))
  Assert(
    Compare(
      Call(Name("multiply"), UnaryOp("-", Int(9)), UnaryOp("-", Int(9))),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(
        Name("multiply"),
        UnaryOp("-", Int(10)),
        UnaryOp("-", Int(10))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("multiply"),
        UnaryOp("-", Int(11)),
        UnaryOp("-", Int(11))),
      CmpOp("==", Int(81)))))
