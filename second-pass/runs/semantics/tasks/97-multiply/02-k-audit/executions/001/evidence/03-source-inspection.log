     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd "$(dirname "$0")"
     5	
     6	# Translate the submitted implementation with the fixed front end.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
     9	
    10	# The concrete harness has its own docstring and assertions, but its function
    11	# signature and executable statements must remain identical to solution.py.
    12	python3 - <<'PY'
    13	import ast
    14	from pathlib import Path
    15	
    16	
    17	def function(path):
    18	    tree = ast.parse(Path(path).read_text(encoding="utf-8"), filename=path)
    19	    return next(node for node in tree.body
    20	                if isinstance(node, ast.FunctionDef) and node.name == "multiply")
    21	
    22	
    23	def executable(function_def):
    24	    body = function_def.body
    25	    if (body and isinstance(body[0], ast.Expr)
    26	            and isinstance(body[0].value, ast.Constant)
    27	            and isinstance(body[0].value.value, str)):
    28	        body = body[1:]
    29	    return ast.dump(function_def.args), ast.dump(ast.Module(body=body, type_ignores=[]))
    30	
    31	
    32	assert executable(function("solution.py")) == executable(function("concrete-tests.py"))
    33	PY
    34	
    35	# Concrete execution, using the required LLVM main and syntax modules.
    36	kompile reference-semantics/semantics.k \
    37	  --backend llvm \
    38	  --main-module MPY-KRUN \
    39	  --syntax-module MPY-SYNTAX \
    40	  --output-definition runtime-kompiled
    41	krun solution.mpy --definition runtime-kompiled
    42	krun concrete-tests.mpy --definition runtime-kompiled
    43	
    44	# Symbolic definition and the universal reachability proof.
    45	kompile verification.k \
