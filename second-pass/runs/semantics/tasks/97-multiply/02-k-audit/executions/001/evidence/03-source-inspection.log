     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // This is the executable body emitted in solution.mpy, packaged as a value
     7	  // so a claim can call it with arbitrary K integers.
     8	  syntax Val ::= "multiplyClosure" [function, total]
     9	  rule multiplyClosure
    10	    => closureVal(
    11	         ("a", "b"),
    12	         (Expr(
    13	            Str(
    14	              "Complete the function that takes two integers and returns\n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    "))
    15	          Return(
    16	            BinOp(
    17	              "*",
    18	              BinOp("%", Name("a"), Int(10)),
    19	              BinOp("%", Name("b"), Int(10))))),
    20	         0)
    21	
    22	  syntax KItem ::= "#runMultiply" "(" Int "," Int ")"
    23	  rule <k> #runMultiply(A:Int, B:Int)
    24	        => Call(multiplyClosure, A, B) ... </k>
    25	
    26	  // Contract vocabulary: Python's unit digit is its remainder modulo 10.
    27	  syntax Int ::= unitDigit(Int) [function, total]
    28	  rule unitDigit(I:Int) => pyMod(I, 10)
    29	
    30	  syntax Int ::= unitDigitProduct(Int, Int) [function, total]
    31	  rule unitDigitProduct(A:Int, B:Int)
    32	    => unitDigit(A) *Int unitDigit(B)
    33	endmodule
