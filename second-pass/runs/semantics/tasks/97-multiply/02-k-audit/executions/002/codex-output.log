@@ -0,0 +1,150 @@
+#!/usr/bin/env python3
+"""Probe common deterministic tree-manifest encodings against recorded digests."""
+
+from __future__ import annotations
+
+import hashlib
+import itertools
+import json
+import stat
+from pathlib import Path
+
+
+TARGET = "1de6d5f51876cf9d0f4449a78f077f8b127a14add0504d5060da680fc5a443de"
+ROOT = Path("/reference/reference-semantics")
+
+
+def h(data: bytes) -> str:
+    return hashlib.sha256(data).hexdigest()
+
+
+entries = []
+for path in sorted(ROOT.rglob("*"), key=lambda p: p.relative_to(ROOT).as_posix()):
+    rel = path.relative_to(ROOT).as_posix()
+    mode = path.lstat().st_mode
+    kind = "directory" if stat.S_ISDIR(mode) else "file"
+    data = path.read_bytes() if kind == "file" else b""
+    entries.append(
+        {
+            "path": rel,
+            "type": kind,
+            "kind": kind,
+            "size": len(data),
+            "sha256": h(data),
+            "data": data,
+        }
+    )
+
+
+def check(label: str, payload: bytes) -> bool:
+    digest = h(payload)
+    if digest == TARGET:
+        print("MATCH", label, len(payload))
+        return True
+    return False
+
+
+matched = False
+for include_dirs in (False, True):
+    selected = [e for e in entries if include_dirs or e["type"] == "file"]
+    for prefix in ("", "./", ROOT.name + "/"):
+        for path_sep in ("\0", "\n", " ", ":"):
+            for entry_sep in ("\0", "\n", ""):
+                for file_value in ("raw", "hex", "binary", "size_raw", "size_hex"):
+                    parts = []
+                    for e in selected:
+                        path = (prefix + e["path"]).encode()
+                        typ = e["type"].encode()
+                        if e["type"] == "directory":
+                            value = b""
+                        elif file_value == "raw":
+                            value = e["data"]
+                        elif file_value == "hex":
+                            value = e["sha256"].encode()
+                        elif file_value == "binary":
+                            value = bytes.fromhex(e["sha256"])
+                        elif file_value == "size_raw":
+                            value = str(e["size"]).encode() + path_sep.encode() + e["data"]
+                        else:
+                            value = str(e["size"]).encode() + path_sep.encode() + e["sha256"].encode()
+                        parts.append(path + path_sep.encode() + typ + path_sep.encode() + value)
+                    matched |= check(
+                        f"flat dirs={include_dirs} prefix={prefix!r} ps={path_sep!r} "
+                        f"es={entry_sep!r} value={file_value}",
+                        entry_sep.encode().join(parts),
+                    )
+
+for include_dirs in (False, True):
+    selected = [e for e in entries if include_dirs or e["type"] == "file"]
+    for fields in (
+        ("path", "type", "size", "sha256"),
+        ("path", "type", "sha256"),
+        ("path", "kind", "size", "sha256"),
+        ("path", "kind", "sha256"),
+        ("path", "size", "sha256"),
+        ("path", "sha256"),
+    ):
+        rows = []
+        for e in selected:
+            row = {}
+            for field in fields:
+                if e["type"] == "directory" and field in {"size", "sha256"}:
+                    continue
+                row[field] = e[field]
+            rows.append(row)
+        containers = [
+            rows,
+            {"entries": rows},
+            {"files": rows},
+            {row["path"]: row.get("sha256", row.get("type")) for row in rows},
+        ]
+        for container_index, container in enumerate(containers):
+            for sort_keys, separators, indent, newline in itertools.product(
+                (False, True),
+                (None, (",", ":")),
+                (None, 2),
+                (False, True),
+            ):
+                payload = json.dumps(
+                    container,
+                    sort_keys=sort_keys,
+                    separators=separators,
+                    indent=indent,
+                ).encode() + (b"\n" if newline else b"")
+                matched |= check(
+                    f"json dirs={include_dirs} fields={fields} c={container_index} "
+                    f"sort={sort_keys} sep={separators} indent={indent} nl={newline}",
+                    payload,
+                )
+
+
+def merkle(directory: Path, variant: int) -> bytes:
+    parts = []
+    for child in sorted(directory.iterdir(), key=lambda p: p.name):
+        if child.is_dir():
+            value = merkle(child, variant)
+            kind = b"directory"
+        else:
+            value = hashlib.sha256(child.read_bytes()).digest()
+            kind = b"file"
+        name = child.name.encode()
+        if variant == 0:
+            parts.append(name + b"\0" + kind + b"\0" + value)
+        elif variant == 1:
+            parts.append(kind + b"\0" + name + b"\0" + value)
+        elif variant == 2:
+            parts.append(name + b"\0" + value)
+        elif variant == 3:
+            parts.append(len(name).to_bytes(4, "big") + name + kind + b"\0" + value)
+        elif variant == 4:
+            parts.append(kind[:1] + b" " + name + b"\0" + value)
+    return hashlib.sha256(b"".join(parts)).digest()
+
+
+for variant in range(5):
+    digest = merkle(ROOT, variant).hex()
+    if digest == TARGET:
+        print("MATCH merkle", variant)
+        matched = True
+
+print("matched=", matched)
