requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // This is the executable body emitted in solution.mpy, packaged as a value
  // so a claim can call it with arbitrary K integers.
  syntax Val ::= "multiplyClosure" [function, total]
  rule multiplyClosure
    => closureVal(
         ("a", "b"),
         (Expr(
            Str(
              "Complete the function that takes two integers and returns\n    the product of their unit digits.\n    Assume the input is always valid.\n    Examples:\n    multiply(148, 412) should return 16.\n    multiply(19, 28) should return 72.\n    multiply(2020, 1851) should return 0.\n    multiply(14,-15) should return 20.\n    "))
          Return(
            BinOp(
              "*",
              BinOp("%", Name("a"), Int(10)),
              BinOp("%", Name("b"), Int(10))))),
         0)

  syntax KItem ::= "#runMultiply" "(" Int "," Int ")"
  rule <k> #runMultiply(A:Int, B:Int)
        => Call(multiplyClosure, A, B) ... </k>

  // Contract vocabulary: Python's unit digit is its remainder modulo 10.
  syntax Int ::= unitDigit(Int) [function, total]
  rule unitDigit(I:Int) => pyMod(I, 10)

  syntax Int ::= unitDigitProduct(Int, Int) [function, total]
  rule unitDigitProduct(A:Int, B:Int)
    => unitDigit(A) *Int unitDigit(B)
endmodule
#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

# Translate the submitted implementation with the fixed front end.
python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py concrete-tests.py > concrete-tests.mpy

# The concrete harness has its own docstring and assertions, but its function
# signature and executable statements must remain identical to solution.py.
python3 - <<'PY'
import ast
from pathlib import Path


def function(path):
    tree = ast.parse(Path(path).read_text(encoding="utf-8"), filename=path)
    return next(node for node in tree.body
                if isinstance(node, ast.FunctionDef) and node.name == "multiply")


def executable(function_def):
    body = function_def.body
    if (body and isinstance(body[0], ast.Expr)
            and isinstance(body[0].value, ast.Constant)
            and isinstance(body[0].value.value, str)):
        body = body[1:]
    return ast.dump(function_def.args), ast.dump(ast.Module(body=body, type_ignores=[]))


assert executable(function("solution.py")) == executable(function("concrete-tests.py"))
PY

# Concrete execution, using the required LLVM main and syntax modules.
kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled
krun solution.mpy --definition runtime-kompiled
krun concrete-tests.mpy --definition runtime-kompiled

# Symbolic definition and the universal reachability proof.
kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled
kprove spec.k --definition verification-kompiled
def multiply(a, b):
    """Concrete copy of solution.py for execution under the supplied semantics."""
    return (a % 10) * (b % 10)


assert multiply(148, 412) == 16
assert multiply(19, 28) == 72
assert multiply(2020, 1851) == 0
assert multiply(14, -15) == 20
assert multiply(-14, -15) == 30
Module(
  FuncDef("multiply", Params("a", "b"),
    Expr(
      Str(
        "Concrete copy of solution.py for execution under the supplied semantics."))
    Return(
      BinOp(
        "*",
        BinOp("%", Name("a"), Int(10)),
        BinOp("%", Name("b"), Int(10)))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(148), Int(412)),
      CmpOp("==", Int(16))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(19), Int(28)),
      CmpOp("==", Int(72))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(2020), Int(1851)),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(14), UnaryOp("-", Int(15))),
      CmpOp("==", Int(20))))
  Assert(
    Compare(
      Call(
        Name("multiply"),
        UnaryOp("-", Int(14)),
        UnaryOp("-", Int(15))),
      CmpOp("==", Int(30)))))

