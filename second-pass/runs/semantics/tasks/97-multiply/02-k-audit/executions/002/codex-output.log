reference-semantics/semantics/methods.k:125:  rule hasUpper(.IntSeq) => false
reference-semantics/semantics/methods.k:126:  rule hasUpper(iCons(C:Int, S:IntSeq)) => isUpperC(C) orBool hasUpper(S)
