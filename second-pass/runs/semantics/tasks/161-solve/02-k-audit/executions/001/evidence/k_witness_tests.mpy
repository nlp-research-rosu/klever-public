Module(
  Expr(
    Str(
      "Concrete ASCII witnesses for both formal entry-claim preconditions."))
  FuncDef("solve", Params("s"),
    Assign(Name("result"), Call(Attribute(Name("s"), "swapcase"), ))
    If(Compare(Name("result"), CmpOp("==", Name("s"))),
      Return(
        Subscript(
          Name("s"),
          Slice(NoBound, NoBound, UnaryOp("-", Int(1))))),
      )
    Return(Name("result")))
  Assert(Compare(Call(Name("solve"), Str("a")), CmpOp("==", Str("A"))))
  Assert(
    Compare(Call(Name("solve"), Str("a1B!")), CmpOp("==", Str("A1b!"))))
  Assert(Compare(Call(Name("solve"), Str("")), CmpOp("==", Str(""))))
  Assert(Compare(Call(Name("solve"), Str("0")), CmpOp("==", Str("0"))))
  Assert(
    Compare(Call(Name("solve"), Str("12!?")), CmpOp("==", Str("?!21")))))
