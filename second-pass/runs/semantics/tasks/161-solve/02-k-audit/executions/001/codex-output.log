# canonical.py — the UNMODIFIED HumanEval/161 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: solve


def solve(s):
    """You are given a string s.
    if s[i] is a letter, reverse its case from lower to upper or vise versa, 
    otherwise keep it as it is.
    If the string contains no letters, reverse the string.
    The function should return the resulted string.
    Examples
    solve("1234") = "4321"
    solve("ab") = "AB"
    solve("#a@C") = "#A@c"
    """
    flg = 0
    idx = 0
    new_str = list(s)
    for i in s:
        if i.isalpha():
            new_str[idx] = i.swapcase()
            flg = 1
        idx += 1
    s = ""
    for i in new_str:
        s += i
    if flg == 0:
        return s[len(s)::-1]
    return s
def solve(s):
    result = s.swapcase()
    if result == s:
        return s[::-1]
    return result
Module(
  FuncDef("solve", Params("s"),
    Assign(Name("result"), Call(Attribute(Name("s"), "swapcase"), ))
    If(Compare(Name("result"), CmpOp("==", Name("s"))),
      Return(
        Subscript(
          Name("s"),
          Slice(NoBound, NoBound, UnaryOp("-", Int(1))))),
      )
    Return(Name("result"))))
requires "verification.k"

module SPEC
  imports VERIFICATION

  claim [swaps-when-a-letter-exists]:
    <k> #runSolve(CS:IntSeq) => str(mapSwap(CS)) </k>
    <env> 0 </env>
    <scopes>
      0  |-> scope(.Map => "solve" |-> solutionClosure(), parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires notBool (CS ==K mapSwap(CS))

  claim [reverses-when-no-letter-exists]:
    <k> #runSolve(CS:IntSeq) => str(revIS(CS)) </k>
    <env> 0 </env>
    <scopes>
      0  |-> scope(.Map => "solve" |-> solutionClosure(), parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires CS ==K mapSwap(CS)
endmodule
requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // The exact constructor tree emitted in solution.mpy.
  syntax Stmts ::= solveBody ( ) [function, total]
  rule solveBody()
    => Assign(Name("result"),
         Call(Attribute(Name("s"), "swapcase"), .Exprs))
       If(Compare(Name("result"), CmpOp("==", Name("s"))),
         Return(Subscript(Name("s"),
           Slice(NoBound, NoBound, UnaryOp("-", Int(1))))) .Stmts,
         .Stmts)
       Return(Name("result")) .Stmts

  syntax Module ::= solutionModule ( ) [function, total]
  rule solutionModule()
    => Module(FuncDef("solve", Params("s"), solveBody()))

  syntax Val ::= solutionClosure ( ) [function, total]
  rule solutionClosure()
    => closureVal("s", .ParamNames, solveBody(), 0)

  // Natural contract on the reference semantics' ASCII code-sequence model.
  syntax Bool ::= containsLetter ( IntSeq ) [function, total]
  rule containsLetter(CS) => notBool (mapSwap(CS) ==K CS)

  syntax IntSeq ::= solveSpec ( IntSeq ) [function, total]
  rule solveSpec(CS)
    => #if containsLetter(CS)
       #then mapSwap(CS)
       #else revIS(CS)
       #fi

  // Sound proof lemma connecting a full negative-step slice to reversal.
  rule doSlice(str(CS), noB, noB, someB(-1))
    => str(revIS(CS))
    [simplification]

  rule buildIS(CS, isLen(CS) +Int -1, -1, -1)
    => revIS(CS)
    [simplification]

  syntax KItem ::= #runSolve ( IntSeq )
  rule <k> #runSolve(CS)
        => #loadAll(solutionModule())
        ~> Call(Name("solve"), (str(CS), .Exprs)) ... </k>
endmodule

module VERIFICATION-SYNTAX
  imports VERIFICATION
endmodule
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py concrete_tests.py > concrete_tests.mpy

kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun solution.mpy --definition runtime-kompiled
krun concrete_tests.mpy --definition runtime-kompiled

kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module VERIFICATION-SYNTAX \
  --output-definition verification-kompiled

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC
def solve(s):
    result = s.swapcase()
    if result == s:
        return s[::-1]
    return result


assert solve("1234") == "4321"
assert solve("ab") == "AB"
assert solve("#a@C") == "#A@c"
assert solve("") == ""
assert solve("a1B!") == "A1b!"
Module(
  FuncDef("solve", Params("s"),
    Assign(Name("result"), Call(Attribute(Name("s"), "swapcase"), ))
    If(Compare(Name("result"), CmpOp("==", Name("s"))),
      Return(
        Subscript(
          Name("s"),
          Slice(NoBound, NoBound, UnaryOp("-", Int(1))))),
      )
    Return(Name("result")))
  Assert(
    Compare(Call(Name("solve"), Str("1234")), CmpOp("==", Str("4321"))))
  Assert(
    Compare(Call(Name("solve"), Str("ab")), CmpOp("==", Str("AB"))))
  Assert(
    Compare(Call(Name("solve"), Str("#a@C")), CmpOp("==", Str("#A@c"))))
  Assert(Compare(Call(Name("solve"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(Call(Name("solve"), Str("a1B!")), CmpOp("==", Str("A1b!")))))

