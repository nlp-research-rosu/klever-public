+
+  // Bridge-free universal obligations for both candidate simplifications.
+  claim [reverse-builder-connection]:
+    <k> buildIS(CS:IntSeq, isLen(CS) +Int -1, -1, -1)
+      => revIS(CS)
+    </k>
+
+  claim [reverse-slice-connection]:
+    <k> doSlice(str(CS:IntSeq), noB, noB, someB(-1))
+      => str(revIS(CS))
+    </k>
+endmodule
diff --git a/evidence/capture.sh b/evidence/capture.sh
new file mode 100644
index 0000000000000000000000000000000000000000..3b3e21beaa9855506b90a15c7b071ea385f218ff
--- /dev/null
+++ b/evidence/capture.sh
@@ -0,0 +1,23 @@
+#!/usr/bin/env bash
+set -u
+
+if [ "$#" -lt 2 ]; then
+  echo "usage: capture.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} >"$audit_log"
+
+"$@" >>"$audit_log" 2>&1
+audit_status=$?
+
+printf 'EXIT_STATUS: %d\n' "$audit_status" >>"$audit_log"
+sed -n '1,260p' "$audit_log"
+exit "$audit_status"
