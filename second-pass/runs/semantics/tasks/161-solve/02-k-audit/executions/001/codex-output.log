/bin/bash -lc '/audit-output/evidence/capture.sh /audit-output/evidence/stage6-vacuity-kprove.log kprove spec-vacuity.k --definition /tmp/audit-work/161-solve/verification-kompiled --spec-module SPEC-VACUITY' in /tmp/audit-work/161-solve/source
