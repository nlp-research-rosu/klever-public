Module(
  FuncDef("solve", Params("s"),
    Assign(Name("result"), Call(Attribute(Name("s"), "swapcase"), ))
    If(Compare(Name("result"), CmpOp("==", Name("s"))),
      Return(
        Subscript(
          Name("s"),
          Slice(NoBound, NoBound, UnaryOp("-", Int(1))))),
      )
    Return(Name("result")))
  Assert(
    Compare(Call(Name("solve"), Str("1234")), CmpOp("==", Str("4321"))))
  Assert(
    Compare(Call(Name("solve"), Str("ab")), CmpOp("==", Str("AB"))))
  Assert(
    Compare(Call(Name("solve"), Str("#a@C")), CmpOp("==", Str("#A@c"))))
  Assert(Compare(Call(Name("solve"), Str("")), CmpOp("==", Str(""))))
  Assert(Compare(Call(Name("solve"), Str("#")), CmpOp("==", Str("#"))))
  Assert(
    Compare(Call(Name("solve"), Str("a1B!")), CmpOp("==", Str("A1b!"))))
  Assert(
    Compare(
      Call(Name("solve"), Str("@AZ[\\`az{")),
      CmpOp("==", Str("@az[\\`AZ{")))))

