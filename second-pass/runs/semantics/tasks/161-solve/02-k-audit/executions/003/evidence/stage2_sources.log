     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // The exact constructor tree emitted in solution.mpy.
     7	  syntax Stmts ::= solveBody ( ) [function, total]
     8	  rule solveBody()
     9	    => Assign(Name("result"),
    10	         Call(Attribute(Name("s"), "swapcase"), .Exprs))
    11	       If(Compare(Name("result"), CmpOp("==", Name("s"))),
    12	         Return(Subscript(Name("s"),
    13	           Slice(NoBound, NoBound, UnaryOp("-", Int(1))))) .Stmts,
    14	         .Stmts)
    15	       Return(Name("result")) .Stmts
    16	
    17	  syntax Module ::= solutionModule ( ) [function, total]
    18	  rule solutionModule()
    19	    => Module(FuncDef("solve", Params("s"), solveBody()))
    20	
    21	  syntax Val ::= solutionClosure ( ) [function, total]
    22	  rule solutionClosure()
    23	    => closureVal("s", .ParamNames, solveBody(), 0)
    24	
    25	  // Natural contract on the reference semantics' ASCII code-sequence model.
    26	  syntax Bool ::= containsLetter ( IntSeq ) [function, total]
    27	  rule containsLetter(CS) => notBool (mapSwap(CS) ==K CS)
    28	
    29	  syntax IntSeq ::= solveSpec ( IntSeq ) [function, total]
    30	  rule solveSpec(CS)
    31	    => #if containsLetter(CS)
    32	       #then mapSwap(CS)
    33	       #else revIS(CS)
    34	       #fi
    35	
    36	  // Sound proof lemma connecting a full negative-step slice to reversal.
    37	  rule doSlice(str(CS), noB, noB, someB(-1))
    38	    => str(revIS(CS))
    39	    [simplification]
    40	
    41	  rule buildIS(CS, isLen(CS) +Int -1, -1, -1)
    42	    => revIS(CS)
    43	    [simplification]
    44	
    45	  syntax KItem ::= #runSolve ( IntSeq )
    46	  rule <k> #runSolve(CS)
    47	        => #loadAll(solutionModule())
    48	        ~> Call(Name("solve"), (str(CS), .Exprs)) ... </k>
    49	endmodule
    50	
    51	module VERIFICATION-SYNTAX
    52	  imports VERIFICATION
    53	endmodule
