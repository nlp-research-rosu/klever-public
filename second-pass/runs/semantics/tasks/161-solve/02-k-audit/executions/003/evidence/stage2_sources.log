     6	def solve(s):
     7	    """You are given a string s.
     8	    if s[i] is a letter, reverse its case from lower to upper or vise versa, 
     9	    otherwise keep it as it is.
    10	    If the string contains no letters, reverse the string.
    11	    The function should return the resulted string.
    12	    Examples
    13	    solve("1234") = "4321"
    14	    solve("ab") = "AB"
    15	    solve("#a@C") = "#A@c"
    16	    """
    17	    flg = 0
    18	    idx = 0
    19	    new_str = list(s)
    20	    for i in s:
    21	        if i.isalpha():
    22	            new_str[idx] = i.swapcase()
    23	            flg = 1
    24	        idx += 1
    25	    s = ""
    26	    for i in new_str:
    27	        s += i
    28	    if flg == 0:
    29	        return s[len(s)::-1]
    30	    return s
===== /candidate/solution.py =====
     1	def solve(s):
     2	    result = s.swapcase()
     3	    if result == s:
     4	        return s[::-1]
     5	    return result
