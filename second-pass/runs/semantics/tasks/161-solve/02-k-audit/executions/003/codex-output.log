index 0000000000000000000000000000000000000000..365aa243d1e92013d7a30664d4d526ddd707609a
--- /dev/null
+++ b/evidence/verification-body-mutant.k
@@ -0,0 +1,40 @@
+requires "/tmp/audit-work/161-solve/reference-semantics/semantics.k"
+
+module VERIFICATION-BODY-MUTANT
+  imports MPY
+
+  syntax Stmts ::= solveBodyMutant ( ) [function, total]
+  rule solveBodyMutant()
+    => Assign(Name("result"),
+         Call(Attribute(Name("s"), "lower"), .Exprs))
+       If(Compare(Name("result"), CmpOp("==", Name("s"))),
+         Return(Subscript(Name("s"),
+           Slice(NoBound, NoBound, UnaryOp("-", Int(1))))) .Stmts,
+         .Stmts)
+       Return(Name("result")) .Stmts
+
+  syntax Module ::= solutionModuleMutant ( ) [function, total]
+  rule solutionModuleMutant()
+    => Module(FuncDef("solve", Params("s"), solveBodyMutant()))
+
+  syntax Val ::= solutionClosureMutant ( ) [function, total]
+  rule solutionClosureMutant()
+    => closureVal("s", .ParamNames, solveBodyMutant(), 0)
+
+  rule doSlice(str(CS), noB, noB, someB(-1))
+    => str(revIS(CS))
+    [simplification]
+
+  rule buildIS(CS, isLen(CS) +Int -1, -1, -1)
+    => revIS(CS)
+    [simplification]
+
+  syntax KItem ::= #runSolveMutant ( IntSeq )
+  rule <k> #runSolveMutant(CS)
+        => #loadAll(solutionModuleMutant())
+        ~> Call(Name("solve"), (str(CS), .Exprs)) ... </k>
+endmodule
+
+module VERIFICATION-BODY-MUTANT-SYNTAX
+  imports VERIFICATION-BODY-MUTANT
+endmodule

diff --git a/evidence/adequacy_witnesses.py b/evidence/adequacy_witnesses.py
new file mode 100644
index 0000000000000000000000000000000000000000..30aaa25e4ab27872186eb99786dcf9723ea108ef
--- /dev/null
+++ b/evidence/adequacy_witnesses.py
@@ -0,0 +1,45 @@
+#!/usr/bin/env python3
+"""Ground witnesses for both claims and the source-contract counterexample."""
+
+from __future__ import annotations
+
+import importlib.util
+
+
+def load_entry(path: str, module_name: str):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.solve
+
+
+canonical = load_entry("/reference/canonical.py", "canonical_witness")
+candidate = load_entry("/candidate/solution.py", "candidate_witness")
+
+
+def ascii_map_swap(value: str) -> str:
+    out = []
+    for ch in value:
+        code = ord(ch)
+        if 65 <= code <= 90:
+            out.append(chr(code + 32))
+        elif 97 <= code <= 122:
+            out.append(chr(code - 32))
+        else:
+            out.append(ch)
+    return "".join(out)
+
+
+for value in ("a1", "12", "", "1中", "aΣ"):
+    mapped = ascii_map_swap(value)
+    branch = "swap" if mapped != value else "reverse"
+    k_claim_result = mapped if branch == "swap" else value[::-1]
+    print(
+        f"input={value!r}",
+        f"k_precondition_branch={branch}",
+        f"k_claim_result={k_claim_result!r}",
+        f"canonical={canonical(value)!r}",
+        f"candidate_python={candidate(value)!r}",
+    )
diff --git a/evidence/audit_concrete_tests.py b/evidence/audit_concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..e5bad08a540c19677df965f6a609d19ed2f6e5b8
--- /dev/null
+++ b/evidence/audit_concrete_tests.py
@@ -0,0 +1,15 @@
+def solve(s):
+    result = s.swapcase()
+    if result == s:
+        return s[::-1]
+    return result
+
+
+# Documented examples and both control-flow branches.
+assert solve("1234") == "4321"
+assert solve("ab") == "AB"
+assert solve("#a@C") == "#A@c"
+assert solve("") == ""
+assert solve("#") == "#"
+assert solve("a1B!") == "A1b!"
+assert solve("@AZ[\\`az{") == "@az[\\`AZ{"
diff --git a/evidence/audit_concrete_unicode.py b/evidence/audit_concrete_unicode.py
new file mode 100644
index 0000000000000000000000000000000000000000..9aed9935a3ba0c29c420bd0e4183fc33148ce7c1
