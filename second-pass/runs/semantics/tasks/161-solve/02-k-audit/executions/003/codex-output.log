new file mode 100644
index 0000000000000000000000000000000000000000..d01a1075b4bf8da8badfb58c5cd0d4f861ff9a5e
--- /dev/null
+++ b/evidence/spec-body-mutant.k
@@ -0,0 +1,21 @@
+requires "verification-body-mutant.k"
+
+module SPEC-BODY-MUTANT
+  imports VERIFICATION-BODY-MUTANT
+
+  claim [mutated-body-must-not-prove-swapcase]:
+    <k> #runSolveMutant(CS:IntSeq) => str(mapSwap(CS)) </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map => "solve" |-> solutionClosureMutant(), parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool (CS ==K mapSwap(CS))
+endmodule
