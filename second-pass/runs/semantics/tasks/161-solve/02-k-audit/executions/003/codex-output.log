+        "--sort",
+        "Module",
+        "regenerated-solution.mpy",
+        "--output",
+        "pretty",
+    ],
+    cwd=root,
+    check=True,
+    text=True,
+    stdout=subprocess.PIPE,
+).stdout.strip()
+spec = f'''requires "/tmp/audit-work/161-solve/verification.k"
