diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..6ad6c44f4745dcbcfd32c92243cfcaa9db907dc3
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,23 @@
+requires "/tmp/audit-work/161-solve/verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // False for CS = iCons(97, .IntSeq), which satisfies the precondition:
