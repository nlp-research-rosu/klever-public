+        stream,
+        fieldnames=(
+            "file",
+            "line",
+            "kind",
+            "classification",
+            "attributes",
+            "text",
+        ),
+        dialect="excel-tab",
+    )
+    writer.writeheader()
+    writer.writerows(rows)
