--- /dev/null
+++ b/spec.k
@@ -0,0 +1,37 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [swaps-when-a-letter-exists]:
+    <k> #runSolve(CS:IntSeq) => str(mapSwap(CS)) </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool (CS ==K mapSwap(CS))
+
+  claim [reverses-when-no-letter-exists]:
+    <k> #runSolve(CS:IntSeq) => str(revIS(CS)) </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires CS ==K mapSwap(CS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..53ed1bd20438300c902a725cc0899aa9210cd833
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,52 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The exact constructor tree emitted in solution.mpy.
+  syntax Stmts ::= solveBody ( ) [function, total]
+  rule solveBody()
+    => Assign(Name("result"),
+         Call(Attribute(Name("s"), "swapcase"), .Exprs))
+       If(Compare(Name("result"), CmpOp("==", Name("s"))),
+         Return(Subscript(Name("s"),
+           Slice(NoBound, NoBound, UnaryOp("-", Int(1))))) .Stmts,
+         .Stmts)
+       Return(Name("result")) .Stmts
+
+  syntax Module ::= solutionModule ( ) [function, total]
+  rule solutionModule()
+    => Module(FuncDef("solve", Params("s"), solveBody()))
+
+  syntax Val ::= solutionClosure ( ) [function, total]
+  rule solutionClosure()
+    => closureVal("s", .ParamNames, solveBody(), 0)
+
+  // Natural contract on the reference semantics' ASCII code-sequence model.
+  syntax Bool ::= containsLetter ( IntSeq ) [function, total]
+  rule containsLetter(CS) => notBool (mapSwap(CS) ==K CS)
+
+  syntax IntSeq ::= solveSpec ( IntSeq ) [function, total]
+  rule solveSpec(CS)
+    => #if containsLetter(CS)
+       #then mapSwap(CS)
+       #else revIS(CS)
+       #fi
+
+  // Sound proof lemma connecting a full negative-step slice to reversal.
+  rule doSlice(str(CS), noB, noB, someB(-1))
+    => str(revIS(CS))
+    [simplification]
+
+  rule buildIS(CS, isLen(CS) +Int -1, -1, -1)
+    => revIS(CS)
+    [simplification]
+
+  syntax KItem ::= #runSolve ( IntSeq )
+  rule <k> #runSolve(CS)
+        => Call(solutionClosure(), (str(CS), .Exprs)) ... </k>
+endmodule
+
+module VERIFICATION-SYNTAX
+  imports VERIFICATION
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..5b69ff04faa63ca5cec5506498f8953d3a6be19f
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,12 @@
+def solve(s):
+    result = s.swapcase()
+    if result == s:
+        return s[::-1]
+    return result
+
+
+assert solve("1234") == "4321"
+assert solve("ab") == "AB"
+assert solve("#a@C") == "#A@c"
+assert solve("") == ""
+assert solve("a1B!") == "A1b!"
