diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..fd7f9f1996ad533e3f15914067fe7da34aed252f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,53 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The exact constructor tree emitted in solution.mpy.
+  syntax Stmts ::= solveBody ( ) [function, total]
+  rule solveBody()
+    => Assign(Name("result"),
+         Call(Attribute(Name("s"), "swapcase"), .Exprs))
+       If(Compare(Name("result"), CmpOp("==", Name("s"))),
+         Return(Subscript(Name("s"),
+           Slice(NoBound, NoBound, UnaryOp("-", Int(1))))) .Stmts,
+         .Stmts)
+       Return(Name("result")) .Stmts
+
+  syntax Module ::= solutionModule ( ) [function, total]
+  rule solutionModule()
+    => Module(FuncDef("solve", Params("s"), solveBody()))
+
+  syntax Val ::= solutionClosure ( ) [function, total]
+  rule solutionClosure()
+    => closureVal("s", .ParamNames, solveBody(), 0)
+
+  // Natural contract on the reference semantics' ASCII code-sequence model.
+  syntax Bool ::= containsLetter ( IntSeq ) [function, total]
+  rule containsLetter(CS) => notBool (mapSwap(CS) ==K CS)
+
+  syntax IntSeq ::= solveSpec ( IntSeq ) [function, total]
+  rule solveSpec(CS)
+    => #if containsLetter(CS)
+       #then mapSwap(CS)
+       #else revIS(CS)
+       #fi
+
+  // Sound proof lemma connecting a full negative-step slice to reversal.
+  rule doSlice(str(CS), noB, noB, someB(-1))
+    => str(revIS(CS))
+    [simplification]
+
+  rule buildIS(CS, isLen(CS) +Int -1, -1, -1)
+    => revIS(CS)
+    [simplification]
+
+  syntax KItem ::= #runSolve ( IntSeq )
+  rule <k> #runSolve(CS)
+        => #loadAll(solutionModule())
+        ~> Call(Name("solve"), (str(CS), .Exprs)) ... </k>
+endmodule
+
+module VERIFICATION-SYNTAX
+  imports VERIFICATION
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..5b69ff04faa63ca5cec5506498f8953d3a6be19f
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,12 @@
+def solve(s):
+    result = s.swapcase()
+    if result == s:
+        return s[::-1]
+    return result
+
+
+assert solve("1234") == "4321"
+assert solve("ab") == "AB"
+assert solve("#a@C") == "#A@c"
+assert solve("") == ""
+assert solve("a1B!") == "A1b!"
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..2a14fca68f9c4f87044c3923b87f01958875ee53
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun solution.mpy --definition runtime-kompiled
+krun concrete_tests.mpy --definition runtime-kompiled
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module VERIFICATION-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
