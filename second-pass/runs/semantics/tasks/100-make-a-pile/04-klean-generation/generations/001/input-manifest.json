{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 8,
      "module": "PILE-VERIFICATION",
      "normalized_sha256": "22751b6f0ce256a241dc19f1640dcb5480b4efc2a26bbfa044ba4629c8bb9c35",
      "rationale": "Macro expansion defining the named proof expression pileCondition as the program's i < n comparison.",
      "source_rule_id": "rule-22751b6f0ce256a241dc19f1640dcb5480b4efc2a26bbfa044ba4629c8bb9c35",
      "start_line": 7,
      "text": "  rule pileCondition\n    => Compare(Name(\"i\"), CmpOp(\"<\", Name(\"n\")))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 16,
      "module": "PILE-VERIFICATION",
      "normalized_sha256": "4fb38cd43bd4ca35e7dae0edae393d11b590c0f523ccfc1dd9bed6969c629464",
      "rationale": "Macro expansion defining the named loop-body proof term from the exact append and increment statements.",
      "source_rule_id": "rule-4fb38cd43bd4ca35e7dae0edae393d11b590c0f523ccfc1dd9bed6969c629464",
      "start_line": 11,
      "text": "  rule pileLoopBody\n    => Expr(\n         Call(\n           Attribute(Name(\"stones\"), \"append\"),\n           BinOp(\"+\", Name(\"n\"), BinOp(\"*\", Int(2), Name(\"i\")))))\n       AugAssign(Name(\"i\"), \"+\", Int(1))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 23,
      "module": "PILE-VERIFICATION",
      "normalized_sha256": "f23f2f7e0eba99112c099245082f9d758a2c0c6c59eddffb11a02898914989bf",
      "rationale": "Macro expansion defining the complete function-body proof term from initialization, loop, and return statements.",
      "source_rule_id": "rule-f23f2f7e0eba99112c099245082f9d758a2c0c6c59eddffb11a02898914989bf",
      "start_line": 19,
      "text": "  rule pileBody\n    => Assign(Name(\"stones\"), ListExpr(.Exprs))\n       Assign(Name(\"i\"), Int(0))\n       While(pileCondition, pileLoopBody)\n       Return(Name(\"stones\"))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 26,
      "module": "PILE-VERIFICATION",
      "normalized_sha256": "6010dc93df234a84e52b82001b1f5013df8aa366d7a3250587f36b7863f45a53",
      "rationale": "Macro expansion defining the named closure value used to represent make_a_pile in proof configurations.",
      "source_rule_id": "rule-6010dc93df234a84e52b82001b1f5013df8aa366d7a3250587f36b7863f45a53",
      "start_line": 26,
      "text": "  rule pileClosure => closureVal((\"n\", .ParamNames), pileBody, 0)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 30,
      "module": "PILE-VERIFICATION",
      "normalized_sha256": "49c485cbb59af517bd2978b8d663cb5072f818f9d7ceb9f26cf6e545770689f4",
      "rationale": "Macro expansion defining the named module term containing the translated make_a_pile function.",
      "source_rule_id": "rule-49c485cbb59af517bd2978b8d663cb5072f818f9d7ceb9f26cf6e545770689f4",
      "start_line": 29,
      "text": "  rule pileModule\n    => Module(FuncDef(\"make_a_pile\", Params(\"n\"), pileBody))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 36,
      "module": "PILE-VERIFICATION",
      "normalized_sha256": "c7bc3f6e9e3d053f0d1a231faec47b72f24e3a9d1bf5bd7dcc951f8cea4f6fa4",
      "rationale": "Base equation of the pile mathematical-summary recurrence, defining the empty suffix once the level index reaches n.",
      "source_rule_id": "rule-c7bc3f6e9e3d053f0d1a231faec47b72f24e3a9d1bf5bd7dcc951f8cea4f6fa4",
      "start_line": 35,
      "text": "  rule pile(N:Int, I:Int) => .ValSeq\n    requires I >=Int N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 39,
      "module": "PILE-VERIFICATION",
      "normalized_sha256": "facdd655b24df1d5b12ab16ecd73c39d00a41e6f338a787a0ccad6551c07e234",
      "rationale": "Recursive equation of the pile mathematical summary, defining the next value n + 2*i and the suffix at i + 1.",
      "source_rule_id": "rule-facdd655b24df1d5b12ab16ecd73c39d00a41e6f338a787a0ccad6551c07e234",
      "start_line": 37,
      "text": "  rule pile(N:Int, I:Int)\n    => vCons(N +Int (2 *Int I), pile(N, I +Int 1))\n    requires I <Int N"
    }
  ],
