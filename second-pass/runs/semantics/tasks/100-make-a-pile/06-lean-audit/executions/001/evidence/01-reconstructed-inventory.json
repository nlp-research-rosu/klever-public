      "start_line": 35,
      "text": "  rule pile(N:Int, I:Int) => .ValSeq\n    requires I >=Int N"
    },
    {
      "attributes": [],
      "end_line": 39,
      "module": "PILE-VERIFICATION",
      "normalized_sha256": "facdd655b24df1d5b12ab16ecd73c39d00a41e6f338a787a0ccad6551c07e234",
      "source_rule_id": "rule-facdd655b24df1d5b12ab16ecd73c39d00a41e6f338a787a0ccad6551c07e234",
      "start_line": 37,
      "text": "  rule pile(N:Int, I:Int)\n    => vCons(N +Int (2 *Int I), pile(N, I +Int 1))\n    requires I <Int N"
    },
