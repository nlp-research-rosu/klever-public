print(json.dumps({
 'exact_output':output,
 'no_axioms_reported':no_axioms,
 'reported_dependencies':reported,
 'recorded_allowlist_count':len(allow),
 'unrecorded_dependencies':sorted(set(reported)-allow),
 'sorryAx_present':'sorryAx' in output,
 'reconciliation_pass':no_axioms and 'sorryAx' not in output,
