/reference/k-proof/reference-semantics/semantics/functions.k-6-  // call routing + callee/arg evaluation (#callee/#args/#argCont) live in call.k;
/reference/k-proof/reference-semantics/semantics/functions.k-7-  // this module owns the frame lifecycle (bind params, return, pop).
/reference/k-proof/reference-semantics/semantics/functions.k-8-  syntax KItem ::= frame(continuation: K, callerEnv: Int, savedLoc: Int)
/reference/k-proof/reference-semantics/semantics/functions.k-9-                 | #bindP(ParamNames, Vals)
/reference/k-proof/reference-semantics/semantics/functions.k-10-                 | "#pop"
/reference/k-proof/reference-semantics/semantics/functions.k:11:                 | "#endcall"
/reference/k-proof/reference-semantics/semantics/functions.k-12-
/reference/k-proof/reference-semantics/semantics/functions.k-13-  // ==== def / anonymous closure =============================================
/reference/k-proof/reference-semantics/semantics/functions.k-14-  rule <k> FuncDef(F:String, Params(PNS:ParamNames), BODY:Stmts) => .K ... </k>
/reference/k-proof/reference-semantics/semantics/functions.k-15-       <env> L:Int </env>
/reference/k-proof/reference-semantics/semantics/functions.k-16-       <scopes> ... L |-> scope(M:Map => M [ F <- closureVal(PNS, BODY, L) ], _) ... </scopes>
