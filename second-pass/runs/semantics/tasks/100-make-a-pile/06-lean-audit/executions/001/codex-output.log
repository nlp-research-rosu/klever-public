diff --git a//tmp/audit-work/uv_exepath_test.c b//tmp/audit-work/uv_exepath_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..0bfd45cb2d03eadad4ad2ccd7cdcd668018a528e
--- /dev/null
