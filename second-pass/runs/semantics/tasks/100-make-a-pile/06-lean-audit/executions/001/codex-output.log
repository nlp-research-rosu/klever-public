/reference/k-proof/reference-semantics/semantics/controls.k-61-
/reference/k-proof/reference-semantics/semantics/controls.k-62-  // ==== For: one loop, in-cell continuation, over #iterNext =================
/reference/k-proof/reference-semantics/semantics/controls.k-63-  // (the iterable is evaluated once, by strictness; the protocol stays rewrites —
/reference/k-proof/reference-semantics/semantics/controls.k-64-  // circularities anchor on #loop and narrowing substitutes the structure)
/reference/k-proof/reference-semantics/semantics/controls.k-65-  syntax KItem ::= #loop(Val, Expr, Stmts) | #loopStep(Expr, Stmts)
/reference/k-proof/reference-semantics/semantics/controls.k:66:                 | #while(Expr, Stmts) | #whileCond(Expr, Stmts)
/reference/k-proof/reference-semantics/semantics/controls.k-67-                 | #loopLbl(K) | "#cont" | "#brk"
/reference/k-proof/reference-semantics/semantics/controls.k-68-
/reference/k-proof/reference-semantics/semantics/controls.k-69-  rule <k> For(T:Expr, OBJ:Val, B:Stmts) => #loop(OBJ, T, B) ... </k>
/reference/k-proof/reference-semantics/semantics/controls.k-70-
/reference/k-proof/reference-semantics/semantics/controls.k-71-  rule <k> #loop(IT:Iterable, T:Expr, B:Stmts) => #iterNext(IT) ~> #loopStep(T, B) ... </k>
/reference/k-proof/reference-semantics/semantics/controls.k-72-  rule <k> #iterDone ~> #loopStep(_:Expr, _:Stmts) => .K ... </k>
/reference/k-proof/reference-semantics/semantics/controls.k-73-  rule <k> #iterYield(V:Val, REST:Iterable) ~> #loopStep(T:Expr, B:Stmts)
/reference/k-proof/reference-semantics/semantics/controls.k-74-        => #bindTgt(T, V) ~> B ~> #loopLbl(#loop(REST, T, B)) ... </k>
