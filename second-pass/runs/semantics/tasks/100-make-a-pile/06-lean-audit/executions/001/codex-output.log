     1	
     2	def make_a_pile(n):
     3	    """
     4	    Given a positive integer n, you have to make a pile of n levels of stones.
     5	    The first level has n stones.
     6	    The number of stones in the next level is:
     7	        - the next odd number if n is odd.
     8	        - the next even number if n is even.
     9	    Return the number of stones in each level in a list, where element at index
    10	    i represents the number of stones in the level (i+1).
    11	
    12	    Examples:
    13	    >>> make_a_pile(3)
    14	    [3, 5, 7]
    15	    """
