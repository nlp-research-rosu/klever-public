import hashlib,json,re,stat
from pathlib import Path
from tools.klean_export import lean_trust_declarations
root=Path('/candidate')
lean_files=sorted(p for p in root.rglob('*.lean') if p.is_file() and not p.is_symlink())
findings={}
for p in lean_files:
    text=p.read_text()
    findings[p.relative_to(root).as_posix()]={
      'sha256':hashlib.sha256(p.read_bytes()).hexdigest(),
      'sorry_tokens':len(re.findall(r'\\bsorry\\b',text)),
      'admit_tokens':len(re.findall(r'\\badmit\\b',text)),
      'unsafe_tokens':len(re.findall(r'\\bunsafe\\b',text)),
      'new_axiom_or_opaque_declarations':re.findall(r'(?m)"'^'"\\s*(?:axiom|opaque)\\s+(["'^'"\\s:]+)',text),
      'trust_declarations':lean_trust_declarations(p),
      'target_declaration_count':len(re.findall(r'(?m)"'^'"\\s*(?:def|theorem|lemma|axiom|opaque)\\s+targetStatement\\b',text)),
      'final_declaration_count':len(re.findall(r'(?m)"'^'"\\s*theorem\\s+final\\b',text)),
    }
all_entries=[]
for p in root.rglob('*'):
    mode=p.lstat().st_mode
    if stat.S_ISLNK(mode): all_entries.append(p.relative_to(root).as_posix())
result={
 'lean_files':[p.relative_to(root).as_posix() for p in lean_files],
 'findings':findings,
 'symlinks':sorted(all_entries),
 'base_directory_initially_empty':(root/'Base').is_dir() and not any((root/'Base').iterdir()),
 'candidate_defines_no_targetStatement':all(x['target_declaration_count']==0 for x in findings.values()),
 'candidate_has_exactly_one_final':sum(x['final_declaration_count'] for x in findings.values())==1,
 'forbidden_token_or_trust_escape_absent':all(x['sorry_tokens']==x['admit_tokens']==x['unsafe_tokens']==0 and not x['new_axiom_or_opaque_declarations'] and not x['trust_declarations'] for x in findings.values()),
}
print(json.dumps(result,indent=2,sort_keys=True,ensure_ascii=False))
