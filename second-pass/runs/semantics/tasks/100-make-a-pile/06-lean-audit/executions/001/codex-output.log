+#include <stdio.h>
+#include <stddef.h>
+#include <unistd.h>
+
+int uv_exepath(char *buffer, size_t *size);
+
+int main(void) {
+  char buffer[4096];
+  size_t size = sizeof(buffer);
+  int code = uv_exepath(buffer, &size);
+  printf("code=%d size=%zu path=%.*s\n", code, size, (int)size, buffer);
+  char proc[4096];
+  snprintf(proc, sizeof(proc), "/proc/%d/exe", getpid());
+  ssize_t read = readlink(proc, buffer, sizeof(buffer));
+  printf("readlink_path=%s read=%zd path=%.*s\n",
+         proc, read, read < 0 ? 0 : (int)read, buffer);
+  return code != 0 || read < 0;
+}

