Module(
  FuncDef("make_a_pile", Params("n"),
    Assign(Name("stones"), ListExpr())
    Assign(Name("i"), Int(0))
    While(Compare(Name("i"), CmpOp("<", Name("n"))),
      Expr(
        Call(
          Attribute(Name("stones"), "append"),
          BinOp("+", Name("n"), BinOp("*", Int(2), Name("i")))))
      AugAssign(Name("i"), "+", Int(1)))
    Return(Name("stones")))
  Assert(
    Compare(
      Call(Name("make_a_pile"), Int(1)),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(Name("make_a_pile"), Int(3)),
      CmpOp("==", ListExpr(Int(3), Int(5), Int(7)))))
  Assert(
    Compare(
      Call(Name("make_a_pile"), Int(4)),
      CmpOp("==", ListExpr(Int(4), Int(6), Int(8), Int(10))))))
