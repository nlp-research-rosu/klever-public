Module(
  FuncDef("make_a_pile", Params("n"),
    Assign(Name("stones"), ListExpr())
    Assign(Name("i"), Int(0))
    While(Compare(Name("i"), CmpOp("<", Name("n"))),
      Expr(
        Call(
          Attribute(Name("stones"), "append"),
          BinOp("+", Name("n"), BinOp("*", Int(2), Name("i")))))
      AugAssign(Name("i"), "+", Int(1)))
    Return(Name("stones"))))
