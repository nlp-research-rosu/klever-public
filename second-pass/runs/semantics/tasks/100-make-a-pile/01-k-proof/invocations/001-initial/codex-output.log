+      ~> #endcall
+    </k>
+    <env> 0 => 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> BUILTINS:Scope
+    =>
+      -1 |-> BUILTINS
+      0 |-> scope(
