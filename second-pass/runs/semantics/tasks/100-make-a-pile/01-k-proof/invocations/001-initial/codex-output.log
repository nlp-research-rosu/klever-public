+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "make_a_pile" |-> pileClosure,
+        parent(-1))
+      1 |-> scope(
+        ("n" |-> N:Int)
+        ("stones" |-> ref(0))
+        ("i" |-> I:Int),
