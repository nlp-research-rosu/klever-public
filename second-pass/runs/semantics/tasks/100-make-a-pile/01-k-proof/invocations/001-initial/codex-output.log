+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("n" |-> N:Int)
+        ("stones" |-> ref(0))
+        ("i" |-> (I:Int => N)),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
