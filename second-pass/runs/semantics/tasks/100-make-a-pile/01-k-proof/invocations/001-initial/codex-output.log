+      -1 |-> builtinsScope
+    =>
+      0 |-> scope(
+        "make_a_pile" |-> pileClosure,
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(pile(N, 0)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
