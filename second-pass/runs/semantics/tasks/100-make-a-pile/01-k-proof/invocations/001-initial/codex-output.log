+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "make_a_pile" |-> pileClosure,
+        parent(-1))
+      1 |-> scope(
+        ("n" |-> N:Int)
+        ("stones" |-> ref(0))
+        ("i" |-> I:Int),
+        parent(0))
+    =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "make_a_pile" |-> pileClosure,
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(VS:ValSeq)
+    =>
+      0 |-> list(
+        valSeqConcat(
+          VS,
+          pile(N +Int (2 *Int I), N -Int I)))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires
+      N >Int 0
+      andBool I >=Int 0
+      andBool I <=Int N
+
