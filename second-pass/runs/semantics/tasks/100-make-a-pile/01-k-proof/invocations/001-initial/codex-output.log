diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..ba5e2ec4647c5a47fe227dc71c4819b519ef8638
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,79 @@
+requires "verification.k"
+
+module PILE-LOOP-SPEC
+  imports PILE-VERIFICATION
+
+  claim
+    <k>
+      #while(pileCondition, pileLoopBody)
+      ~> Return(Name("stones"))
+      ~> #endcall
+    =>
+      ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "make_a_pile" |-> pileClosure,
+        parent(-1))
+      1 |-> scope(
+        ("n" |-> N:Int)
+        ("stones" |-> ref(0))
+        ("i" |-> I:Int),
+        parent(0))
+    =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "make_a_pile" |-> pileClosure,
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(VS:ValSeq)
+    =>
+      0 |-> list(
+        valSeqConcat(
+          VS,
+          pile(N, I)))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires
+      N >Int 0
+      andBool I >=Int 0
+      andBool I <=Int N
+endmodule
+
+module PILE-MAIN-SPEC
+  imports PILE-VERIFIED-LOOP
+
+  claim
+    <k>
+      #loadAll(pileModule)
+      ~> Call(Name("make_a_pile"), Int(N:Int))
+    =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0 |-> scope(
+        "make_a_pile" |-> pileClosure,
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(pile(N, 0)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires N >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f0f4f54ca1584b925c6451f7b8df4f7c17dca6e4
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,97 @@
+requires "reference-semantics/semantics.k"
+
+module PILE-VERIFICATION
+  imports MPY
+
+  syntax Expr ::= "pileCondition" [macro]
+  rule pileCondition
+    => Compare(Name("i"), CmpOp("<", Name("n")))
+
+  syntax Stmts ::= "pileLoopBody" [macro]
+  rule pileLoopBody
+    => Expr(
+         Call(
+           Attribute(Name("stones"), "append"),
+           BinOp("+", Name("n"), BinOp("*", Int(2), Name("i")))))
+       AugAssign(Name("i"), "+", Int(1))
+
+  syntax Stmts ::= "pileBody" [macro]
+  rule pileBody
+    => Assign(Name("stones"), ListExpr(.Exprs))
+       Assign(Name("i"), Int(0))
+       While(pileCondition, pileLoopBody)
+       Return(Name("stones"))
+
+  syntax Val ::= "pileClosure" [macro]
+  rule pileClosure => closureVal(("n"), pileBody, 0)
+
+  syntax Module ::= "pileModule" [macro]
+  rule pileModule
+    => Module(FuncDef("make_a_pile", Params("n"), pileBody))
+
+  // pile(N, I) is the mathematical suffix at level index I:
+  // [N + 2*I, N + 2*(I+1), ..., N + 2*(N-1)].
+  syntax ValSeq ::= pile(Int, Int) [function]
+  rule pile(N:Int, I:Int) => .ValSeq
+    requires I >=Int N
+  rule pile(N:Int, I:Int)
+    => vCons(N +Int (2 *Int I), pile(N, I +Int 1))
+    requires I <Int N
+
+  // Two standard list-concatenation identities orient symbolic accumulators
+  // into the same form on successive induction steps.
+  rule valSeqConcat(VS:ValSeq, .ValSeq) => VS [simplification]
+  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
+    => valSeqConcat(A, valSeqConcat(B, C))
+    [simplification]
+endmodule
+
+// This module packages the loop theorem as a rewrite lemma for downstream
+// proofs. prove.sh first proves the identical claim against PILE-VERIFICATION,
+// then compiles this extension to prove the public entry point compositionally.
+module PILE-VERIFIED-LOOP
+  imports PILE-VERIFICATION
+
+  rule
+    <k>
+      #while(pileCondition, pileLoopBody)
+      ~> Return(Name("stones"))
+      ~> #endcall
+    =>
+      ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "make_a_pile" |-> pileClosure,
+        parent(-1))
+      1 |-> scope(
+        ("n" |-> N:Int)
+        ("stones" |-> ref(0))
+        ("i" |-> I:Int),
+        parent(0))
+    =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "make_a_pile" |-> pileClosure,
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(VS:ValSeq)
+    =>
+      0 |-> list(valSeqConcat(VS, pile(N, I)))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires
+      N >Int 0
+      andBool I >=Int 0
+      andBool I <=Int N
+    [priority(40)]
+endmodule

