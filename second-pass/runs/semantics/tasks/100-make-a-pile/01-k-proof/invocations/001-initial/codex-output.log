+  syntax Stmts ::= "pileMainBody" [macro]
+  rule pileMainBody
+    => Return(
+         Call(
+           Name("make_a_pile_helper"),
+           Name("n"),
+           Name("n"),
+           ListExpr(.Exprs)))
+
+  syntax Val ::= "pileHelperClosure" [macro]
+  rule pileHelperClosure
+    => closureVal(
+         ("value", "levels", "stones"),
+         pileHelperBody,
+         0)
+
+  syntax Val ::= "pileMainClosure" [macro]
+  rule pileMainClosure
+    => closureVal(("n"), pileMainBody, 0)
+
+  syntax Module ::= "pileModule" [macro]
+  rule pileModule
+    => Module(
+         FuncDef(
+           "make_a_pile_helper",
+           Params("value", "levels", "stones"),
+           pileHelperBody)
+         FuncDef("make_a_pile", Params("n"), pileMainBody))
+
+  // pile(V, L) is the mathematical result: L values beginning at V and
+  // increasing by two.
+  syntax ValSeq ::= pile(Int, Int) [function]
+  rule pile(_:Int, 0) => .ValSeq
+  rule pile(V:Int, L:Int)
+    => vCons(V, pile(V +Int 2, L -Int 1))
+    requires L >Int 0
+
+  // Two standard list-concatenation identities orient symbolic accumulators
+  // into the same form on successive induction steps.
+  rule valSeqConcat(VS:ValSeq, .ValSeq) => VS [simplification]
+  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
+    => valSeqConcat(A, valSeqConcat(B, C))
+    [simplification]
+endmodule

