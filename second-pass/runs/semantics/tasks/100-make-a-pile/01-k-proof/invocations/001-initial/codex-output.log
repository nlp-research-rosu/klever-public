diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e02aed9bc4ed6c94f128d83aeb5e307106d08fd8
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,64 @@
+requires "verification.k"
+
+module PILE-SPEC
+  imports PILE-VERIFICATION
+
+  claim
+    <k>
+      #applyK(
+        toCall(pileHelperClosure),
+        (V:Int, L:Int, ref(H:Int), .Vals))
+      ~> CONT:K
+    =>
+      ref(H) ~> CONT
+    </k>
+    <env> CALLER:Int </env>
+    <scopes> SCOPES:Map </scopes>
+    <scopeLoc> NEXTSCOPE:Int </scopeLoc>
+    <heap>
+      (H |-> list(VS:ValSeq)) RESTHEAP:Map
+    =>
+      (H |-> list(valSeqConcat(VS, pile(V, L)))) RESTHEAP
+    </heap>
+    <heapLoc> NEXTHEAP:Int </heapLoc>
+    <stack> STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires
+      L >=Int 0
+      andBool notBool H in_keys(RESTHEAP)
+      andBool notBool NEXTSCOPE in_keys(SCOPES)
+      andBool 0 in_keys(SCOPES)
+      andBool {
+        SCOPES[0]
+      }:>Scope ==K scope(
+        ("make_a_pile_helper" |-> pileHelperClosure)
+        ("make_a_pile" |-> pileMainClosure),
+        parent(-1))
+
+  claim
+    <k>
+      #loadAll(pileModule)
+      ~> Call(Name("make_a_pile"), Int(N:Int))
+    =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0 |-> scope(
+        ("make_a_pile_helper" |-> pileHelperClosure)
+        ("make_a_pile" |-> pileMainClosure),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(pile(N, N)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires N >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f2cd2bb1da0c452baf94c6cc111bdeac5538b778
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,65 @@
+requires "reference-semantics/semantics.k"
+
+module PILE-VERIFICATION
+  imports MPY
+
+  // The exact bodies emitted in solution.mpy, named here so the claims remain
+  // readable while still executing the supplied Python semantics.
+  syntax Stmts ::= "pileHelperBody" [macro]
+  rule pileHelperBody
+    => If(
+         Compare(Name("levels"), CmpOp("==", Int(0))),
+         Return(Name("stones")),
+         .Stmts)
+       Expr(Call(Attribute(Name("stones"), "append"), Name("value")))
+       Return(
+         Call(
+           Name("make_a_pile_helper"),
+           BinOp("+", Name("value"), Int(2)),
+           BinOp("-", Name("levels"), Int(1)),
+           Name("stones")))
+
+  syntax Stmts ::= "pileMainBody" [macro]
+  rule pileMainBody
+    => Return(
+         Call(
+           Name("make_a_pile_helper"),
+           Name("n"),
+           Name("n"),
+           ListExpr(.Exprs)))
+
+  syntax Val ::= "pileHelperClosure" [macro]
+  rule pileHelperClosure
+    => closureVal(
+         ("value", "levels", "stones"),
+         pileHelperBody,
+         0)
+
+  syntax Val ::= "pileMainClosure" [macro]
+  rule pileMainClosure
+    => closureVal(("n"), pileMainBody, 0)
+
+  syntax Module ::= "pileModule" [macro]
+  rule pileModule
+    => Module(
+         FuncDef(
+           "make_a_pile_helper",
+           Params("value", "levels", "stones"),
+           pileHelperBody)
+         FuncDef("make_a_pile", Params("n"), pileMainBody))
+
+  // pile(V, L) is the mathematical result: L values beginning at V and
+  // increasing by two.
+  syntax ValSeq ::= pile(Int, Int) [function]
+  rule pile(_:Int, 0) => .ValSeq
+  rule pile(V:Int, L:Int)
+    => vCons(V, pile(V +Int 2, L -Int 1))
+    requires L >Int 0
+
+  // Two standard list-concatenation identities orient symbolic accumulators
+  // into the same form on successive induction steps.
+  rule valSeqConcat(VS:ValSeq, .ValSeq) => VS [simplification]
+  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
+    => valSeqConcat(A, valSeqConcat(B, C))
+    [simplification]
+endmodule

