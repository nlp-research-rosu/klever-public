+def make_a_pile(n):
+    stones = []
+    i = 0
+    while i < n:
+        stones.append(n + 2 * i)
+        i += 1
+    return stones
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..92c25feb30b91ff9da55a6be5c4924eeb254357b
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,77 @@
+requires "verification.k"
+
+module PILE-LOOP-SPEC
+  imports PILE-VERIFICATION
+
+  claim
+    <k>
+      #while(pileCondition, pileLoopBody)
+      ~> Return(Name("stones"))
+      ~> #endcall
+    =>
+      ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> BUILTINS:Scope
+      0 |-> scope(
+        MODULE:Map,
+        parent(-1))
+      1 |-> scope(
+        ("n" |-> N:Int)
+        ("stones" |-> ref(0))
+        ("i" |-> I:Int),
+        parent(0))
+    =>
+      -1 |-> BUILTINS
+      0 |-> scope(
+        MODULE,
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(VS:ValSeq)
+    =>
+      0 |-> list(
+        valSeqConcat(
+          VS,
+          pile(N, I)))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires
+      N >Int 0
+      andBool I >=Int 0
+      andBool I <=Int N
+endmodule
+
+module PILE-PREFIX-SPEC
+  imports PILE-VERIFICATION
+
+  claim
+    <k>
+      #loadAll(pileModule)
+      ~> Call(Name("make_a_pile"), Int(N:Int))
+    =>
+      #while(pileCondition, pileLoopBody)
+      ~> ?CONT:K
+    </k>
+    <env> 0 => ?ENV:Int </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> BUILTINS:Scope
+    =>
+      ?SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => ?SCOPELOC:Int </scopeLoc>
+    <heap> .Map => ?HEAP:Map </heap>
+    <heapLoc> 0 => ?HEAPLOC:Int </heapLoc>
+    <stack>
+      .List => ?STACK:List
+    </stack>
+    <ret> noRet => ?RET:RetState </ret>
+    <exc> NoExc => ?EXC:Exc </exc>
+    requires N >Int 0
+endmodule
