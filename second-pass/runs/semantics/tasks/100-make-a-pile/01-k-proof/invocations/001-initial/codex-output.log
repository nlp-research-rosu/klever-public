+requires "verification.k"
+
+module PILE-SPEC
+  imports PILE-VERIFICATION
+
+  claim
+    <k>
+      #while(pileCondition, pileLoopBody)
+      ~> Return(Name("stones"))
+      ~> #endcall
+    =>
+      ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "make_a_pile" |-> pileClosure,
+        parent(-1))
+      1 |-> scope(
+        ("n" |-> N:Int)
+        ("stones" |-> ref(0))
+        ("i" |-> I:Int),
+        parent(0))
+    =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "make_a_pile" |-> pileClosure,
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(VS:ValSeq)
+    =>
+      0 |-> list(
+        valSeqConcat(
+          VS,
+          pile(N +Int (2 *Int I), N -Int I)))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1)) => .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires
+      N >Int 0
+      andBool I >=Int 0
+      andBool I <=Int N
+
+  claim
+    <k>
+      #loadAll(pileModule)
+      ~> Call(Name("make_a_pile"), Int(N:Int))
+    =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0 |-> scope(
+        "make_a_pile" |-> pileClosure,
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(pile(N, N)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires N >Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..46bb0ef8dd6333812dbb7bcacceac54872d47671
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,46 @@
+requires "reference-semantics/semantics.k"
+
+module PILE-VERIFICATION
+  imports MPY
+
+  syntax Expr ::= "pileCondition" [macro]
+  rule pileCondition
+    => Compare(Name("i"), CmpOp("<", Name("n")))
+
+  syntax Stmts ::= "pileLoopBody" [macro]
+  rule pileLoopBody
+    => Expr(
+         Call(
+           Attribute(Name("stones"), "append"),
+           BinOp("+", Name("n"), BinOp("*", Int(2), Name("i")))))
+       AugAssign(Name("i"), "+", Int(1))
+
+  syntax Stmts ::= "pileBody" [macro]
+  rule pileBody
+    => Assign(Name("stones"), ListExpr(.Exprs))
+       Assign(Name("i"), Int(0))
+       While(pileCondition, pileLoopBody)
+       Return(Name("stones"))
+
+  syntax Val ::= "pileClosure" [macro]
+  rule pileClosure => closureVal(("n"), pileBody, 0)
+
+  syntax Module ::= "pileModule" [macro]
+  rule pileModule
+    => Module(FuncDef("make_a_pile", Params("n"), pileBody))
+
+  // pile(V, L) is the mathematical result: L values beginning at V and
+  // increasing by two.
+  syntax ValSeq ::= pile(Int, Int) [function]
+  rule pile(_:Int, 0) => .ValSeq
+  rule pile(V:Int, L:Int)
+    => vCons(V, pile(V +Int 2, L -Int 1))
+    requires L >Int 0
+
+  // Two standard list-concatenation identities orient symbolic accumulators
+  // into the same form on successive induction steps.
+  rule valSeqConcat(VS:ValSeq, .ValSeq) => VS [simplification]
+  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
+    => valSeqConcat(A, valSeqConcat(B, C))
+    [simplification]
+endmodule

