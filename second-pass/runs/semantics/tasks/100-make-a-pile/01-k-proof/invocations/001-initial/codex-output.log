diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..dea5e415007d218bbc7883989c373a39abd94ff9
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,88 @@
+requires "reference-semantics/semantics.k"
+
+module PILE-VERIFICATION
+  imports MPY
+
+  syntax Expr ::= "pileCondition" [macro]
+  rule pileCondition
+    => Compare(Name("i"), CmpOp("<", Name("n")))
+
+  syntax Stmts ::= "pileLoopBody" [macro]
+  rule pileLoopBody
+    => Expr(
+         Call(
+           Attribute(Name("stones"), "append"),
+           BinOp("+", Name("n"), BinOp("*", Int(2), Name("i")))))
+       AugAssign(Name("i"), "+", Int(1))
+
+  syntax Stmts ::= "pileBody" [macro]
+  rule pileBody
+    => Assign(Name("stones"), ListExpr(.Exprs))
+       Assign(Name("i"), Int(0))
+       While(pileCondition, pileLoopBody)
+       Return(Name("stones"))
+
+  syntax Val ::= "pileClosure" [macro]
+  rule pileClosure => closureVal(("n"), pileBody, 0)
+
+  syntax Module ::= "pileModule" [macro]
+  rule pileModule
+    => Module(FuncDef("make_a_pile", Params("n"), pileBody))
+
+  // pile(N, I) is the mathematical suffix at level index I:
+  // [N + 2*I, N + 2*(I+1), ..., N + 2*(N-1)].
+  syntax ValSeq ::= pile(Int, Int) [function]
+  rule pile(N:Int, I:Int) => .ValSeq
+    requires I >=Int N
+  rule pile(N:Int, I:Int)
+    => vCons(N +Int (2 *Int I), pile(N, I +Int 1))
+    requires I <Int N
+
+  // Two standard list-concatenation identities orient symbolic accumulators
+  // into the same form on successive induction steps.
+  rule valSeqConcat(.ValSeq, VS:ValSeq) => VS [simplification]
+  rule valSeqConcat(VS:ValSeq, .ValSeq) => VS [simplification]
+  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
+    => valSeqConcat(A, valSeqConcat(B, C))
+    [simplification]
+endmodule
+
+// This module packages the loop theorem as a rewrite lemma for downstream
+// proofs. prove.sh first proves the identical claim against PILE-VERIFICATION,
+// then compiles this extension to prove the public entry point compositionally.
+module PILE-VERIFIED-LOOP
+  imports PILE-VERIFICATION
+
+  rule
+    <k>
+      #while(
+        Compare(Name("i"), CmpOp("<", Name("n"))),
+        Expr(
+          Call(
+            Attribute(Name("stones"), "append"),
+            BinOp("+", Name("n"), BinOp("*", Int(2), Name("i")))))
+        AugAssign(Name("i"), "+", Int(1)))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      1 |-> scope(
+        ("n" |-> N:Int)
+        ("stones" |-> ref(0))
+        ("i" |-> (I:Int => N)),
+        parent(0))
+      RESTSCOPES:Map
+    </scopes>
+    <heap>
+      0 |-> (list(VS:ValSeq) => list(valSeqConcat(VS, pile(N, I))))
+      RESTHEAP:Map
+    </heap>
+    requires
+      N >Int 0
+      andBool I >=Int 0
+      andBool I <=Int N
+      andBool notBool 1 in_keys(RESTSCOPES)
+      andBool notBool 0 in_keys(RESTHEAP)
+    [simplification]
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module PILE-VERIFIED-LOOP --syntax-module MPY-SYNTAX --output-definition verified-loop-kompiled >/tmp/pile-lemma-kompile.log 2>&1 && kprove spec.k --definition verified-loop-kompiled --spec-module PILE-MAIN-SPEC' in /work
