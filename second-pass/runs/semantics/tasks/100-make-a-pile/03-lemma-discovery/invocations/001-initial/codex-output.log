/bin/bash -lc "python3 - <<'PY'
import json
from pathlib import Path
inv=json.loads(Path('/reference/rule-inventory.json').read_text())
out=json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert list(out) == ['schema_version','inventory_sha256','rules'], list(out)
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
assert [r['source_rule_id'] for r in out['rules']] == [r['source_rule_id'] for r in inv['rules']]
assert len({r['source_rule_id'] for r in out['rules']}) == len(out['rules'])
for r in out['rules']:
    assert set(r) == {'source_rule_id','classification','rationale'}, r
    assert r['classification'] in allowed
    assert isinstance(r['rationale'],str) and r['rationale'].strip()
byid={r['source_rule_id']:r for r in out['rules']}
for r in inv['rules']:
    if 'simplification' in r.get('attributes',[]):
        assert byid[r['source_rule_id']]['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
print('validated_rules', len(out['rules']))
print('inventory_sha256', out['inventory_sha256'])
from collections import Counter
print('classifications', dict(Counter(r['classification'] for r in out['rules'])))
PY" in /workspace
