requires "reference-semantics/semantics.k"

module PILE-VERIFICATION
  imports MPY

  syntax Expr ::= "pileCondition" [macro]
  rule pileCondition
    => Compare(Name("i"), CmpOp("<", Name("n")))

  syntax Stmts ::= "pileLoopBody" [macro]
  rule pileLoopBody
    => Expr(
         Call(
           Attribute(Name("stones"), "append"),
           BinOp("+", Name("n"), BinOp("*", Int(2), Name("i")))))
       AugAssign(Name("i"), "+", Int(1))

  syntax Stmts ::= "pileBody" [macro]
  rule pileBody
    => Assign(Name("stones"), ListExpr(.Exprs))
       Assign(Name("i"), Int(0))
       While(pileCondition, pileLoopBody)
       Return(Name("stones"))

  syntax Val ::= "pileClosure" [macro]
  rule pileClosure => closureVal(("n", .ParamNames), pileBody, 0)

  syntax Module ::= "pileModule" [macro]
  rule pileModule
    => Module(FuncDef("make_a_pile", Params("n"), pileBody))

  // pile(N, I) is the mathematical suffix at level index I:
  // [N + 2*I, N + 2*(I+1), ..., N + 2*(N-1)].
  syntax ValSeq ::= pile(Int, Int) [function, total]
  rule pile(N:Int, I:Int) => .ValSeq
    requires I >=Int N
  rule pile(N:Int, I:Int)
    => vCons(N +Int (2 *Int I), pile(N, I +Int 1))
    requires I <Int N

  // Two standard list-concatenation identities orient symbolic accumulators
  // into the same form on successive induction steps.
  rule valSeqConcat(VS:ValSeq, .ValSeq) => VS [simplification]
  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
    => valSeqConcat(A, valSeqConcat(B, C))
    [simplification]
endmodule
requires "verification.k"

module PILE-LOOP-SPEC
  imports PILE-VERIFICATION

  claim
    <k>
      #while(pileCondition, pileLoopBody)
      ~> (Return(Name("stones")) .Stmts):Stmts
      ~> #endcall
    =>
      ref(0)
    </k>
    <env> 1 => 0 </env>
    <scopes>
      -1 |-> BUILTINS:Scope
      0 |-> scope(
        MODULE:Map,
        parent(-1))
      1 |-> scope(
        ("n" |-> N:Int)
        ("stones" |-> ref(0))
        ("i" |-> I:Int),
        parent(0))
    =>
      -1 |-> BUILTINS
      0 |-> scope(
        MODULE,
        parent(-1))
    </scopes>
    <scopeLoc> 2 => 1 </scopeLoc>
    <heap>
      0 |-> list(VS:ValSeq)
    =>
      0 |-> list(
        valSeqConcat(
          VS,
          pile(N, I)))
    </heap>
    <heapLoc> 1 </heapLoc>
    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    requires
      N >Int 0
      andBool I >=Int 0
      andBool I <=Int N
endmodule

module PILE-PREFIX-SPEC
  imports PILE-VERIFICATION

  claim
    <k>
      #loadAll(pileModule)
      ~> Call(Name("make_a_pile"), Int(N:Int))
    =>
      #while(pileCondition, pileLoopBody)
      ~> (Return(Name("stones")) .Stmts):Stmts
      ~> #endcall
    </k>
    <env> 0 => 1 </env>
    <scopes>
      0 |-> scope(.Map, parent(-1))
      -1 |-> BUILTINS:Scope
    =>
      -1 |-> BUILTINS
      0 |-> scope(
        ?MODULE:Map,
        parent(-1))
      1 |-> scope(
        ("n" |-> N)
        ("stones" |-> ref(0))
        ("i" |-> 0),
        parent(0))
    </scopes>
    <scopeLoc> 1 => 2 </scopeLoc>
    <heap> .Map => 0 |-> list(.ValSeq) </heap>
    <heapLoc> 0 => 1 </heapLoc>
    <stack>
      .List => ListItem(frame(.K, 0, 1))
    </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    requires N >Int 0
endmodule
#!/usr/bin/env bash
set -euo pipefail

# Translate the submitted implementation with the fixed front end.
python3 py2mpy.py solution.py > solution.mpy

# Build the required concrete LLVM semantics and exercise representative
# positive odd/even inputs, including the smallest allowed input.
kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled
python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
krun concrete_tests.mpy --definition runtime-kompiled

# Build the symbolic definition from the supplied MPY modules plus the
# mathematical sequence and list lemmas in verification.k.
kompile verification.k \
  --backend haskell \
  --main-module PILE-VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

# The two #Top results compose at the exact loop-entry configuration:
# public entry point -> initialized invariant -> returned progression.
kprove spec.k \
  --definition verification-kompiled \
  --spec-module PILE-PREFIX-SPEC
kprove spec.k \
  --definition verification-kompiled \
  --spec-module PILE-LOOP-SPEC

