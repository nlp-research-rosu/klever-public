@@ -0,0 +1,19 @@
+#!/usr/bin/env python3
+"""Ground falsity witness for spec-vacuity-audit.k."""
+
+
+def pile(n: int, i: int) -> list[int]:
+    return [n + 2 * index for index in range(i, n)]
+
+
+n, i, vs = 3, 0, []
+assert n > 0 and i >= 0 and i < n
+actual = vs + pile(n, i)
+mutated = vs + pile(n, i + 1)
+assert actual == [3, 5, 7]
+assert mutated == [5, 7]
+assert actual != mutated
+print(f"satisfying_input=(N={n}, I={i}, VS={vs})")
+print(f"actual_result={actual}")
+print(f"mutated_obligation={mutated}")
+print("MUTATION_DEMONSTRABLY_FALSE")

All seven required stages are complete. The detailed review and reproducible evidence have been written, with the required final verdict markers.
  ✓ Stage 1: validate audit manifests, record layout, hashes, mounts, and supplied-semantics integrity
  ✓ Stage 2: establish contract, regenerate program, and run independent differential tests
  ✓ Stage 3: reconstruct K definitions and independently prove all positive claims
  ✓ Stage 4: audit claim adequacy and real-program pinning with satisfying witnesses
  ✓ Stage 5: inventory and audit every relevant K declaration and rule
  ✓ Stage 6: create and run a fresh meaningful false mutation
  ✓ Stage 7: account for proven versus assumed facts and write REVIEW.md
