+    fields = [
+        "id",
+        "file",
+        "start_line",
+        "end_line",
+        "kind",
+        "attributes",
+        "relevance",
+        "decision",
+        "justification",
+        "sentence",
+    ]
+    with OUTPUT.open("w", newline="") as stream:
