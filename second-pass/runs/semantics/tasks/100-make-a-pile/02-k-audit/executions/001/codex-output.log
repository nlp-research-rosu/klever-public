+      #loadAll(pileModule)
+      ~> Call(Name("make_a_pile"), Int(3))
+    =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> BUILTINS:Scope
+    =>
+      -1 |-> BUILTINS
+      0 |-> scope(
+        "make_a_pile" |-> pileClosure,
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      0 |-> list(
+        vCons(3,
+          vCons(5,
+            vCons(7, .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
+
+module PILE-GROUND-LOOP-WITNESS-SPEC
