+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> BUILTINS:Scope
+      0 |-> scope(MODULE:Map, parent(-1))
+      1 |-> scope(
+        ("n" |-> 3)
+        ("stones" |-> ref(0))
+        ("i" |-> 1),
+        parent(0))
+    =>
+      -1 |-> BUILTINS
+      0 |-> scope(MODULE, parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(vCons(3, .ValSeq))
+    =>
+      0 |-> list(
+        vCons(3,
+          vCons(5,
+            vCons(7, .ValSeq))))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
