+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> BUILTINS:Scope
+    =>
+      -1 |-> BUILTINS
+      0 |-> scope(
+        "make_a_pile" |-> pileClosure,
+        parent(-1))
