+    --definition body-mutant-kompiled \
+    --spec-module PILE-BODY-MUTANT-SPEC
+  status=$?
+  echo "EXIT_STATUS: ${status}"
+  exit "${status}"
+) > /audit-output/evidence/05b_body_mutant_kprove.log 2>&1
+prove_status=$?
