+requires "verification.k"
+
+module PILE-LOOP-SPEC-VACUITY
+  imports PILE-VERIFICATION
+
+  // Deliberately false: when I < N, it omits the first remaining level.
+  // Witness N=1, I=0, VS=.ValSeq: execution appends 1, while this target
+  // requires the heap list to remain empty (pile(1,1) = .ValSeq).
+  claim
+    <k>
+      #while(pileCondition, pileLoopBody)
+      ~> (Return(Name("stones")) .Stmts):Stmts
+      ~> #endcall
+    =>
+      ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> BUILTINS:Scope
+      0 |-> scope(
+        MODULE:Map,
+        parent(-1))
+      1 |-> scope(
+        ("n" |-> N:Int)
+        ("stones" |-> ref(0))
+        ("i" |-> I:Int),
+        parent(0))
+    =>
+      -1 |-> BUILTINS
+      0 |-> scope(
+        MODULE,
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(VS:ValSeq)
+    =>
+      0 |-> list(
+        valSeqConcat(
+          VS,
+          pile(N, I +Int 1)))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires
+      N >Int 0
+      andBool I >=Int 0
+      andBool I <=Int N
+endmodule

codex
The validation checks are discriminating: an off-by-one postcondition mutation compiled but failed with the expected stuck implication, and a separate `2*i → 3*i` body mutation also compiled but failed on the resulting value mismatch. Exact macro-expanded KORE for the proved `pileModule` is byte-identical to parsed `solution.mpy`. I’m writing the seven-stage report and trust ledger now.
