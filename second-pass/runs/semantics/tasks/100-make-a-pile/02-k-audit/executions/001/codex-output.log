+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> BUILTINS:Scope
+      0 |-> scope(MODULE:Map, parent(-1))
+      1 |-> scope(
+        ("n" |-> N:Int)
+        ("stones" |-> ref(0))
+        ("i" |-> I:Int),
+        parent(0))
+    =>
+      -1 |-> BUILTINS
+      0 |-> scope(MODULE, parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
