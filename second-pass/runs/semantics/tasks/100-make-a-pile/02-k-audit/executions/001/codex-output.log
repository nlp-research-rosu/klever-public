+      0 |-> list(vCons(3, .ValSeq))
+    =>
+      0 |-> list(
+        vCons(3,
+          vCons(5,
+            vCons(7, .ValSeq))))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
