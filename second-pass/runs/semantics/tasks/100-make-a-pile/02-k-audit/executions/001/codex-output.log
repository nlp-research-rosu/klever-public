diff --git a/evidence/06_spec_vacuity.k b/evidence/06_spec_vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..7e4b5c039f74311010fdf606340100725687d716
--- /dev/null
+++ b/evidence/06_spec_vacuity.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module PILE-LOOP-SPEC-VACUITY
+  imports PILE-VERIFICATION
+
+  // Deliberately false: when I < N, it omits the first remaining level.
+  // Witness N=1, I=0, VS=.ValSeq: execution appends 1, while this target
+  // requires the heap list to remain empty (pile(1,1) = .ValSeq).
+  claim
+    <k>
+      #while(pileCondition, pileLoopBody)
+      ~> (Return(Name("stones")) .Stmts):Stmts
+      ~> #endcall
+    =>
+      ref(0)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> BUILTINS:Scope
+      0 |-> scope(
+        MODULE:Map,
+        parent(-1))
+      1 |-> scope(
+        ("n" |-> N:Int)
+        ("stones" |-> ref(0))
+        ("i" |-> I:Int),
+        parent(0))
+    =>
+      -1 |-> BUILTINS
+      0 |-> scope(
+        MODULE,
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      0 |-> list(VS:ValSeq)
+    =>
+      0 |-> list(
+        valSeqConcat(
+          VS,
+          pile(N, I +Int 1)))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires
+      N >Int 0
+      andBool I >=Int 0
+      andBool I <=Int N
+endmodule

exec
/bin/bash -lc '/audit-output/evidence/04_check_program_pinning.sh && cat /audit-output/evidence/04c_kast_solution.log && cat /audit-output/evidence/04d_kast_macro.log && cat /audit-output/evidence/04e_program_pinning_cmp.log' in /audit-output
