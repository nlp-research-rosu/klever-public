diff --git a/evidence/06_run_vacuity.sh b/evidence/06_run_vacuity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..f2e8bffb1facad2e6432025dba520d5aa7791313
--- /dev/null
+++ b/evidence/06_run_vacuity.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /tmp/audit-work
+cp /audit-output/evidence/06_spec_vacuity.k spec-vacuity.k
+
+(
