diff --git a/evidence/05_body_mutant_verification.k b/evidence/05_body_mutant_verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..46d1f79902a5decd7bc0791848f1df1412ba1a4d
--- /dev/null
+++ b/evidence/05_body_mutant_verification.k
@@ -0,0 +1,44 @@
+requires "reference-semantics/semantics.k"
+
+module PILE-VERIFICATION-MUTANT
+  imports MPY
+
+  syntax Expr ::= "pileCondition" [macro]
+  rule pileCondition
+    => Compare(Name("i"), CmpOp("<", Name("n")))
+
+  syntax Stmts ::= "pileLoopBody" [macro]
+  // Deliberate body mutation: 3 * i instead of the submitted 2 * i.
+  rule pileLoopBody
+    => Expr(
+         Call(
+           Attribute(Name("stones"), "append"),
+           BinOp("+", Name("n"), BinOp("*", Int(3), Name("i")))))
+       AugAssign(Name("i"), "+", Int(1))
+
+  syntax Stmts ::= "pileBody" [macro]
+  rule pileBody
+    => Assign(Name("stones"), ListExpr(.Exprs))
+       Assign(Name("i"), Int(0))
+       While(pileCondition, pileLoopBody)
+       Return(Name("stones"))
+
+  syntax Val ::= "pileClosure" [macro]
+  rule pileClosure => closureVal(("n", .ParamNames), pileBody, 0)
+
+  syntax Module ::= "pileModule" [macro]
+  rule pileModule
+    => Module(FuncDef("make_a_pile", Params("n"), pileBody))
+
+  syntax ValSeq ::= pile(Int, Int) [function, total]
+  rule pile(N:Int, I:Int) => .ValSeq
+    requires I >=Int N
+  rule pile(N:Int, I:Int)
+    => vCons(N +Int (2 *Int I), pile(N, I +Int 1))
+    requires I <Int N
+
+  rule valSeqConcat(VS:ValSeq, .ValSeq) => VS [simplification]
+  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
+    => valSeqConcat(A, valSeqConcat(B, C))
+    [simplification]
+endmodule
diff --git a/evidence/05_rule_inventory.py b/evidence/05_rule_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..71677b7fb36d1cca9695667338e5697670adcbd1
--- /dev/null
+++ b/evidence/05_rule_inventory.py
@@ -0,0 +1,98 @@
+#!/usr/bin/env python3
+"""Enumerate every local K directive and soundness-sensitive attribute."""
+
+from __future__ import annotations
+
+import collections
+import re
+from pathlib import Path
+
+
+ROOT = Path("/tmp/audit-work")
+FILES = sorted((ROOT / "reference-semantics").rglob("*.k")) + [
+    ROOT / "verification.k",
+    ROOT / "spec.k",
+]
+START = re.compile(
+    r"^\s*(syntax|rule|claim|configuration|context|alias)\b"
+)
+ATTRIBUTE_WORDS = (
+    "function",
+    "total",
+    "functional",
+    "simplification",
+    "priority",
+    "owise",
+    "macro",
+    "macro-rec",
+    "symbol",
+    "no-evaluators",
+    "concrete",
+    "anywhere",
+)
+
+
+def rel(path: Path) -> str:
+    return str(path.relative_to(ROOT))
+
+
+records: list[dict[str, str | int]] = []
+for path in FILES:
+    lines = path.read_text().splitlines()
+    starts = [i for i, line in enumerate(lines) if START.match(line)]
+    for ordinal, start in enumerate(starts):
+        stop = starts[ordinal + 1] if ordinal + 1 < len(starts) else len(lines)
+        block_lines = []
+        for line in lines[start:stop]:
+            if line.strip() == "endmodule":
+                break
+            if line.lstrip().startswith("//"):
+                continue
+            if line.strip().startswith(("module ", "imports ")):
+                continue
+            if line.strip():
+                block_lines.append(line.strip())
+        statement = " ".join(block_lines)
+        kind = START.match(lines[start]).group(1)  # type: ignore[union-attr]
+        attrs = [
+            word
+            for word in ATTRIBUTE_WORDS
+            if re.search(rf"(?<![A-Za-z0-9_-]){re.escape(word)}(?![A-Za-z0-9_-])", statement)
+        ]
+        records.append(
+            {
+                "id": len(records) + 1,
+                "file": rel(path),
+                "line": start + 1,
+                "kind": kind,
+                "attributes": ",".join(attrs) if attrs else "-",
+                "statement": statement,
+            }
+        )
+
+counts = collections.Counter(record["kind"] for record in records)
+source_counts = collections.Counter(
+    "candidate-proof"
+    if str(record["file"]) in {"verification.k", "spec.k"}
+    else "trusted-supplied-semantics"
+    for record in records
+)
+attribute_counts = collections.Counter()
+for record in records:
+    if record["attributes"] != "-":
+        attribute_counts.update(str(record["attributes"]).split(","))
+
+print("# Inventory summary")
+print(f"files={len(FILES)}")
+print(f"directives={len(records)}")
+print("directive_counts=" + repr(dict(sorted(counts.items()))))
+print("source_counts=" + repr(dict(sorted(source_counts.items()))))
+print("attribute_counts=" + repr(dict(sorted(attribute_counts.items()))))
+print()
+print("id\tfile\tline\tkind\tattributes\tstatement")
+for record in records:
+    statement = str(record["statement"]).replace("\t", " ").replace("\n", " ")
+    print(
+        f"{record['id']}\t{record['file']}\t{record['line']}\t"
+        f"{record['kind']}\t{record['attributes']}\t{statement}"
+    )
