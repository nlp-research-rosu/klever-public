+  exit "${status}"
+) > /audit-output/evidence/05a_body_mutant_kompile.log 2>&1
+build_status=$?
+
+(
+  echo 'COMMAND: kprove body-mutant-spec.k --definition body-mutant-kompiled --spec-module PILE-BODY-MUTANT-SPEC'
