+          pile(N, I +Int 1)))
+    </heap>
+    <heapLoc> 1 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires
+      N >Int 0
+      andBool I >=Int 0
+      andBool I <=Int N
+endmodule

