@@ -0,0 +1,176 @@
+requires "verification.k"
+
+module LOOP-SPEC
+  imports VERIFICATION
+
+  // Loop invariant: N is at least two, candidates [2,D) have already been
+  // eliminated, and the remaining computation returns exactly the result of
+  // testing D through N - 1.  Re-entering #while establishes the circularity.
+  claim [divisor-loop]:
+    <k>
+      #while(
+        Compare(Name("divisor"), CmpOp("<", Name("n"))),
+        primeLoopBody)
+      ~> Return(Bool(true))
+      ~> .Stmts
+      ~> #endcall
+      =>
+      noDivisorsFrom(N:Int, D:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS:Map, root)
+       1 |-> scope(
+         "divisor" |-> D
+         "n" |-> N
+         "string" |-> _S:Val,
+         parent(0)))
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS, root))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires D >=Int 2
+endmodule
+
+module WHILE-SPEC
+  imports VERIFICATION-WITH-LOOP-LEMMA
+
+  claim [while-wrapper]:
+    <k>
+      While(
+        Compare(Name("divisor"), CmpOp("<", Name("n"))),
+        primeLoopBody)
+      ~> Return(Bool(true))
+      ~> .Stmts
+      ~> #endcall
+      =>
+      noDivisorsFrom(N:Int, D:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS:Map, root)
+       1 |-> scope(
+         "divisor" |-> D
+         "n" |-> N
+         "string" |-> _S:Val,
+         parent(0)))
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS, root))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires D >=Int 2
+endmodule
+
+module WHILE-REUSE-SPEC
+  imports VERIFICATION-WITH-WHILE-LEMMA
+
+  claim [while-reuse-smoke]:
+    <k>
+      While(
+        Compare(Name("divisor"), CmpOp("<", Name("n"))),
+        primeLoopBody)
+      ~> Return(Bool(true))
+      ~> .Stmts
+      ~> #endcall
+      =>
+      noDivisorsFrom(N:Int, 2)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS:Map, root)
+       1 |-> scope(
+         "divisor" |-> 2
+         "n" |-> N
+         "string" |-> _S:Val,
+         parent(0)))
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS, root))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module SPEC
+  imports VERIFICATION-WITH-WHILE-LEMMA
+
+  claim [prime-length-small]:
+    <k>
+      #applyK(
+        toCall(primeLengthClosure),
+        (str(CS:IntSeq), .Vals))
+      =>
+      false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N ==Int isLen(CS)
+     andBool N >=Int 0
+     andBool N <Int 2
+
+  claim [prime-length-large]:
+    <k>
+      #applyK(
+        toCall(primeLengthClosure),
+        (str(CS:IntSeq), .Vals))
+      =>
+      noDivisorsFrom(N:Int, 2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N ==Int isLen(CS) andBool N >=Int 2
