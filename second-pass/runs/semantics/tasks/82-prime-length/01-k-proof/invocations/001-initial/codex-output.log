diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..bac19489fd8bcaf4f058ca39641ccf96d89e364a
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,99 @@
+requires "verification.k"
+
+// Inductive loop theorem.  It proves the exact state reached by the entry
+// setup claim below, generalized over the length N and current divisor D.
+module LOOP-SPEC
+  imports VERIFICATION
+
+  claim [divisor-loop]:
+    <k>
+      #while(
+        Compare(Name("divisor"), CmpOp("<", Name("n"))),
+        primeLoopBody)
+      ~> Return(Bool(true))
+      ~> .Stmts
+      ~> #endcall
+      =>
+      noDivisorsFrom(N:Int, D:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS:Map, root)
+       1 |-> scope(
+         "divisor" |-> D
+         "n" |-> N
+         "string" |-> _S:Val,
+         parent(0)))
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS, root))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires D >=Int 2
+endmodule
+
+module SPEC
+  imports VERIFICATION
+
+  // Lengths zero and one return False before entering the divisor loop.
+  claim [prime-length-small]:
+    <k>
+      #applyK(
+        toCall(primeLengthClosure),
+        (str(CS:IntSeq), .Vals))
+      =>
+      false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires isLen(CS) >=Int 0
+     andBool isLen(CS) <Int 2
+
+  // For every length at least two, setup reaches the loop theorem's LHS with
+  // N = len(string) and D = 2.  Together with divisor-loop, this yields
+  // noDivisorsFrom(N,2), the definition of primality on this domain.
+  claim [prime-length-setup]:
+    <k>
+      #applyK(
+        toCall(primeLengthClosure),
+        (str(CS:IntSeq), .Vals))
+      =>
+      #primeLoopEntry(isLen(CS), 2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      .Map
+    </scopes>
+    <scopeLoc> 1 => 0 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires isLen(CS) >=Int 2
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..af62619187f92f7b070609354b91a27e9af338a0
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,81 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact constructor form generated from solution.py.  These are only
+  // abbreviations, so symbolic execution still uses the supplied MPY rules.
+  syntax Stmts ::= "primeLoopBody" [function]
+  rule primeLoopBody
+    => If(
+         Compare(
+           BinOp("%", Name("n"), Name("divisor")),
+           CmpOp("==", Int(0))),
+         Return(Bool(false)) .Stmts,
+         .Stmts)
+       AugAssign(Name("divisor"), "+", Int(1))
+       .Stmts
+
+  syntax Stmts ::= "primeBody" [function]
+  rule primeBody
+    => Assign(Name("n"), Call(Name("len"), (Name("string"), .Exprs)))
+       If(
+         Compare(Name("n"), CmpOp("<", Int(2))),
+         Return(Bool(false)) .Stmts,
+         .Stmts)
+       Assign(Name("divisor"), Int(2))
+       While(
+         Compare(Name("divisor"), CmpOp("<", Name("n"))),
+         primeLoopBody)
+       Return(Bool(true))
+       .Stmts
+
+  syntax Val ::= "primeLengthClosure" [function]
+  rule primeLengthClosure
+    => closureVal(("string", .ParamNames), primeBody, 0)
+
+  // Proof-only observation points used by the setup claim.  They stop at the
+  // generated While statement and capture its live n and divisor values;
+  // they do not summarize or execute the loop body.
+  syntax KItem ::= #primeLoopEntry(Int, Int)
+                 | "#capturePrimeLoopN"
+                 | #capturePrimeLoopD(Int)
+  rule <k>
+         While(_C:Expr, _B:Stmts)
+         =>
+         Name("n") ~> #capturePrimeLoopN
+         ...
+       </k>
+       [priority(1)]
+
+  rule <k>
+         N:Int ~> #capturePrimeLoopN ~> REST:K
+         =>
+         Name("divisor") ~> #capturePrimeLoopD(N) ~> REST
+       </k>
+       [priority(40)]
+
+  rule
+    <k>
+      D:Int ~> #capturePrimeLoopD(N:Int) ~> _REST:K
+      =>
+      #primeLoopEntry(N, D)
+    </k>
+    <env> _ => 0 </env>
+    <scopes> _ => .Map </scopes>
+    <scopeLoc> _ => 0 </scopeLoc>
+    <stack> _ => .List </stack>
+    <ret> _ => noRet </ret>
+    [priority(40)]
+
+  // Mathematical result of testing the candidate divisors D, D + 1, ..., N - 1.
+  // The equations deliberately mirror the Python loop.
+  syntax Bool ::= noDivisorsFrom(Int, Int) [function]
+  rule noDivisorsFrom(N:Int, D:Int) => true
+    requires D >=Int N
+  rule noDivisorsFrom(N:Int, D:Int) => false
+    requires D <Int N andBool pyMod(N, D) ==Int 0
+  rule noDivisorsFrom(N:Int, D:Int) => noDivisorsFrom(N, D +Int 1)
+    requires D <Int N andBool pyMod(N, D) =/=Int 0
+
+endmodule

codex
