+      ~> #endcall
+      =>
+      noDivisorsFrom(N:Int, 2)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS:Map, root)
+       1 |-> scope(
