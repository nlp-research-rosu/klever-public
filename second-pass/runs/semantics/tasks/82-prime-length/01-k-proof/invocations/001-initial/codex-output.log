+        .Stmts)
+      ~> Return(Bool(true))
+      ~> .Stmts
+      ~> #endcall
+      =>
+      noDivisorsFrom(N:Int, 2)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS:Map, root)
+       1 |-> scope(
+         "divisor" |-> 2
+         "n" |-> N
+         "string" |-> _S:Val,
+         parent(0)))
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS, root))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(40)]
+endmodule

