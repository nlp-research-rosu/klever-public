+      ~> .Stmts
+      ~> #endcall
+    </k>
+    <env> 0 => 1 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope(
+         "divisor" |-> 2
+         "n" |-> N
+         "string" |-> str(CS),
+         parent(0)))
+    </scopes>
+    <scopeLoc> 1 => 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      .List
+      =>
