diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..10f7096f54172f425fd44068999450a7db811d2e
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,22 @@
+def prime_length(string):
+    n = len(string)
+    if n < 2:
+        return False
+
+    divisor = 2
+    while divisor < n:
+        if n % divisor == 0:
+            return False
+        divisor += 1
+
+    return True
+
+
+assert prime_length("Hello") == True
+assert prime_length("abcdcba") == True
+assert prime_length("kittens") == True
+assert prime_length("orange") == False
+assert prime_length("") == False
+assert prime_length("a") == False
+assert prime_length("abcdefghijk") == True
+assert prime_length("abcdefghijkl") == False
