+    <k>
+      #applyK(
+        toCall(primeLengthClosure),
+        (str(CS:IntSeq), .Vals))
+      =>
+      isPrime(N:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
