+      While(
+        Compare(Name("divisor"), CmpOp("<", Name("n"))),
+        primeLoopBody)
+      ~> Return(Bool(true))
+      ~> .Stmts
+      ~> #endcall
+      =>
+      noDivisorsFrom(N:Int, 2)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
