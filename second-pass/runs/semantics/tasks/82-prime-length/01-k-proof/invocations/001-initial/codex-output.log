+  imports VERIFICATION
+
+  rule
+    <k>
+      While(
+        Compare(Name("divisor"), CmpOp("<", Name("n"))),
+        If(
+          Compare(
+            BinOp("%", Name("n"), Name("divisor")),
+            CmpOp("==", Int(0))),
+          Return(Bool(false)) .Stmts,
+          .Stmts)
+        AugAssign(Name("divisor"), "+", Int(1))
+        .Stmts)
+      ~> Return(Bool(true))
+      ~> .Stmts
+      ~> #endcall
+      =>
+      noDivisorsFrom(N:Int, D:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS:Map, root)
+       1 |-> scope(
+         "divisor" |-> D
+         "n" |-> N
+         "string" |-> _S:Val,
+         parent(0)))
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS, root))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires D >=Int 2
+    [priority(40)]
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module WHILE-SPEC' in /work
