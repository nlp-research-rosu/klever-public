+requires "verification.k"
+
+module LOOP-SPEC
+  imports VERIFICATION
+
+  // Loop invariant: N is at least two, candidates [2,D) have already been
+  // eliminated, and the remaining computation returns exactly the result of
+  // testing D through N - 1.  Re-entering #while establishes the circularity.
+  claim [divisor-loop]:
+    <k>
+      #while(
+        Compare(Name("divisor"), CmpOp("<", Name("n"))),
+        primeLoopBody)
+      ~> Return(Bool(true))
+      ~> .Stmts
+      ~> #endcall
+      =>
+      noDivisorsFrom(N:Int, D:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope(
+         "divisor" |-> D
+         "n" |-> N
+         "string" |-> _S:Val,
+         parent(0)))
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2
+     andBool D >=Int 2
+     andBool D <=Int N
+endmodule
+
+module SPEC
+  imports VERIFICATION-WITH-LOOP-LEMMA
+
+  // Entry-point theorem for every semantic string.  The N >= 0 side condition
+  // is intrinsic to isLen and records the Python-string input domain.
+  claim [prime-length]:
+    <k>
+      #applyK(
+        toCall(primeLengthClosure),
+        (str(CS:IntSeq), .Vals))
+      =>
+      isPrime(N:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N ==Int isLen(CS) andBool N >=Int 0
+endmodule
