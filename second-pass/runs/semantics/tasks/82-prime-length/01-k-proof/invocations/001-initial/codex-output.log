      D:Int ~> #capturePrimeLoopD(N:Int) ~> _REST:K
      =>
      #primeLoopEntry(N, D)
    </k>
    <env> _ => 0 </env>
    <scopes> _ => .Map </scopes>
    <scopeLoc> _ => 0 </scopeLoc>
    <stack> _ => .List </stack>
    <ret> _ => noRet </ret>
    [priority(40)]

  // Mathematical result of testing the candidate divisors D, D + 1, ..., N - 1.
  // The equations deliberately mirror the Python loop.
  syntax Bool ::= noDivisorsFrom(Int, Int) [function]
  rule noDivisorsFrom(N:Int, D:Int) => true
    requires D >=Int N
  rule noDivisorsFrom(N:Int, D:Int) => false
    requires D <Int N andBool pyMod(N, D) ==Int 0
  rule noDivisorsFrom(N:Int, D:Int) => noDivisorsFrom(N, D +Int 1)
    requires D <Int N andBool pyMod(N, D) =/=Int 0

endmodule
requires "verification.k"

// Inductive loop theorem.  It proves the exact state reached by the entry
// setup claim below, generalized over the length N and current divisor D.
module LOOP-SPEC
  imports VERIFICATION

  claim [divisor-loop]:
    <k>
      #while(
        Compare(Name("divisor"), CmpOp("<", Name("n"))),
        primeLoopBody)
      ~> Return(Bool(true))
      ~> .Stmts
      ~> #endcall
      =>
      noDivisorsFrom(N:Int, D:Int)
    </k>
    <env> 1 => 0 </env>
    <scopes>
      (0 |-> scope(.Map, parent(-1))
       -1 |-> scope(BUILTINS:Map, root)
       1 |-> scope(
         "divisor" |-> D
         "n" |-> N
         "string" |-> _S:Val,
         parent(0)))
      =>
      (0 |-> scope(.Map, parent(-1))
       -1 |-> scope(BUILTINS, root))
    </scopes>
    <scopeLoc> 2 => 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack>
      ListItem(frame(.K, 0, 1))
      =>
      .List
    </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires D >=Int 2
endmodule

module SPEC
  imports VERIFICATION

  // Lengths zero and one return False before entering the divisor loop.
  claim [prime-length-small]:
    <k>
      #applyK(
        toCall(primeLengthClosure),
        (str(CS:IntSeq), .Vals))
      =>
      false
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires isLen(CS) >=Int 0
     andBool isLen(CS) <Int 2

  // For every length at least two, setup reaches the loop theorem's LHS with
  // N = len(string) and D = 2.  Together with divisor-loop, this yields
  // noDivisorsFrom(N,2), the definition of primality on this domain.
  claim [prime-length-setup]:
    <k>
      #applyK(
        toCall(primeLengthClosure),
        (str(CS:IntSeq), .Vals))
      =>
      #primeLoopEntry(isLen(CS), 2)
    </k>
    <env> 0 </env>
    <scopes>
      (0 |-> scope(.Map, parent(-1))
       -1 |-> builtinsScope)
      =>
      .Map
    </scopes>
    <scopeLoc> 1 => 0 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires isLen(CS) >=Int 2
endmodule
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py concrete_tests.py > concrete_tests.mpy

kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun concrete_tests.mpy --definition runtime-kompiled

kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC

kprove spec.k \
  --definition verification-kompiled \
  --spec-module LOOP-SPEC

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..10f7096f54172f425fd44068999450a7db811d2e
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,22 @@
+def prime_length(string):
+    n = len(string)
+    if n < 2:
+        return False
+
+    divisor = 2
+    while divisor < n:
+        if n % divisor == 0:
+            return False
+        divisor += 1
+
+    return True
+
+
+assert prime_length("Hello") == True
+assert prime_length("abcdcba") == True
+assert prime_length("kittens") == True
+assert prime_length("orange") == False
+assert prime_length("") == False
+assert prime_length("a") == False
+assert prime_length("abcdefghijk") == True
+assert prime_length("abcdefghijkl") == False
