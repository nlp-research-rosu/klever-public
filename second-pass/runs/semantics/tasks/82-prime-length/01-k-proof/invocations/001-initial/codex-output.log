diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..22b74ae99ab74161e8915327e8a005f70a400b48
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,95 @@
+requires "verification.k"
+
+module LOOP-SPEC
+  imports VERIFICATION
+
+  // Loop invariant: N is at least two, candidates [2,D) have already been
+  // eliminated, and the remaining computation returns exactly the result of
+  // testing D through N - 1.  Re-entering #while establishes the circularity.
+  claim [divisor-loop]:
+    <k>
+      #while(
+        Compare(Name("divisor"), CmpOp("<", Name("n"))),
+        primeLoopBody)
+      ~> Return(Bool(true))
+      ~> .Stmts
+      ~> #endcall
+      =>
+      noDivisorsFrom(N:Int, D:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS:Map, root)
+       1 |-> scope(
+         "divisor" |-> D
+         "n" |-> N
+         "string" |-> _S:Val,
+         parent(0)))
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS, root))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires D >=Int 2
+endmodule
+
+module SPEC
+  imports VERIFICATION-WITH-LOOP-LEMMA
+
+  claim [prime-length-small]:
+    <k>
+      #applyK(
+        toCall(primeLengthClosure),
+        (str(CS:IntSeq), .Vals))
+      =>
+      isPrime(N:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N ==Int isLen(CS)
+     andBool N >=Int 0
+     andBool N <Int 2
+
+  claim [prime-length-large]:
+    <k>
+      #applyK(
+        toCall(primeLengthClosure),
+        (str(CS:IntSeq), .Vals))
+      =>
+      isPrime(N:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N ==Int isLen(CS) andBool N >=Int 2
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c489be61603ec6ee2dec9a191b24d1df80a31a13
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,105 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact constructor form generated from solution.py.  These are only
+  // abbreviations, so symbolic execution still uses the supplied MPY rules.
+  syntax Stmts ::= "primeLoopBody" [function]
+  rule primeLoopBody
+    => If(
+         Compare(
+           BinOp("%", Name("n"), Name("divisor")),
+           CmpOp("==", Int(0))),
+         Return(Bool(false)) .Stmts,
+         .Stmts)
+       AugAssign(Name("divisor"), "+", Int(1))
+       .Stmts
+
+  syntax Stmts ::= "primeBody" [function]
+  rule primeBody
+    => Assign(Name("n"), Call(Name("len"), (Name("string"), .Exprs)))
+       If(
+         Compare(Name("n"), CmpOp("<", Int(2))),
+         Return(Bool(false)) .Stmts,
+         .Stmts)
+       Assign(Name("divisor"), Int(2))
+       While(
+         Compare(Name("divisor"), CmpOp("<", Name("n"))),
+         primeLoopBody)
+       Return(Bool(true))
+       .Stmts
+
+  syntax Val ::= "primeLengthClosure" [function]
+  rule primeLengthClosure
+    => closureVal(("string", .ParamNames), primeBody, 0)
+
+  // Mathematical result of testing the candidate divisors D, D + 1, ..., N - 1.
+  // The equations deliberately mirror the Python loop.
+  syntax Bool ::= noDivisorsFrom(Int, Int) [function]
+  rule noDivisorsFrom(N:Int, D:Int) => true
+    requires D >=Int N
+  rule noDivisorsFrom(N:Int, D:Int) => false
+    requires D <Int N andBool pyMod(N, D) ==Int 0
+  rule noDivisorsFrom(N:Int, D:Int) => noDivisorsFrom(N, D +Int 1)
+    requires D <Int N andBool pyMod(N, D) =/=Int 0
+
+  // A nonnegative integer is prime exactly when it is at least two and has
+  // no divisor in [2, N).
+  syntax Bool ::= isPrime(Int) [function]
+  rule isPrime(N:Int) => false
+    requires N <Int 2
+  rule isPrime(N:Int) => noDivisorsFrom(N, 2)
+    requires N >=Int 2
+endmodule
+
+// The second proof definition reuses the independently proved divisor-loop
+// reachability claim as a high-priority semantic lemma for the entry theorem.
+module VERIFICATION-WITH-LOOP-LEMMA
+  imports VERIFICATION
+
+  rule
+    <k>
+      #while(
+        Compare(Name("divisor"), CmpOp("<", Name("n"))),
+        If(
+          Compare(
+            BinOp("%", Name("n"), Name("divisor")),
+            CmpOp("==", Int(0))),
+          Return(Bool(false)) .Stmts,
+          .Stmts)
+        AugAssign(Name("divisor"), "+", Int(1))
+        .Stmts)
+      ~> Return(Bool(true))
+      ~> .Stmts
+      ~> #endcall
+      =>
+      noDivisorsFrom(N:Int, D:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS:Map, root)
+       1 |-> scope(
+         "divisor" |-> D
+         "n" |-> N
+         "string" |-> _S:Val,
+         parent(0)))
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> scope(BUILTINS, root))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires D >=Int 2
+    [priority(40)]
+endmodule

