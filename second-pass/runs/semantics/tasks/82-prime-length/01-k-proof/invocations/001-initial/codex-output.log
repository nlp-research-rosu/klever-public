diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0fd60956dddbe96404d0f82423437416fbcccb5c
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,93 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [divisor-loop]:
+    <k>
+      #while(
+        Compare(Name("divisor"), CmpOp("<", Name("n"))),
+        If(
+          Compare(
+            BinOp("%", Name("n"), Name("divisor")),
+            CmpOp("==", Int(0))),
+          Return(Bool(false)) .Stmts,
+          .Stmts)
+        AugAssign(Name("divisor"), "+", Int(1))
+        .Stmts)
+      ~> Return(Bool(true))
+      ~> .Stmts
+      ~> #endcall
+      =>
+      noDivisorsFrom(N:Int, D:Int) ~> CONT:K
+    </k>
+    <env> 1 => CALLER:Int </env>
+    <scopes>
+      (G:Map
+       1 |-> scope(
+         "divisor" |-> D
+         "n" |-> N
+         REST:Map,
+         parent(0)))
+      =>
+      G
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, 1)) STACK:List
+      =>
+      STACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2
+     andBool D >=Int 2
+     andBool D <=Int N
+     andBool notBool (1 in_keys(G))
+
+  claim [prime-length]:
+    <k>
+      Call(Name("prime_length"), (str(CS:IntSeq), .Exprs))
+      =>
+      isPrime(N:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "prime_length" |->
+          closureVal(
+            ("string", .ParamNames),
+            Assign(Name("n"), Call(Name("len"), (Name("string"), .Exprs)))
+            If(
+              Compare(Name("n"), CmpOp("<", Int(2))),
+              Return(Bool(false)) .Stmts,
+              .Stmts)
+            Assign(Name("divisor"), Int(2))
+            While(
+              Compare(Name("divisor"), CmpOp("<", Name("n"))),
+              If(
+                Compare(
+                  BinOp("%", Name("n"), Name("divisor")),
+                  CmpOp("==", Int(0))),
+                Return(Bool(false)) .Stmts,
+                .Stmts)
+              AugAssign(Name("divisor"), "+", Int(1))
+              .Stmts)
+            Return(Bool(true))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N ==Int isLen(CS) andBool N >=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c742b3849da82dc6ff6ed579e6300e35b950a161
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,23 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical result of testing the candidate divisors D, D + 1, ..., N - 1.
+  // The equations deliberately mirror the Python loop.
+  syntax Bool ::= noDivisorsFrom(Int, Int) [function]
+  rule noDivisorsFrom(N:Int, D:Int) => true
+    requires D >=Int N
+  rule noDivisorsFrom(N:Int, D:Int) => false
+    requires D <Int N andBool pyMod(N, D) ==Int 0
+  rule noDivisorsFrom(N:Int, D:Int) => noDivisorsFrom(N, D +Int 1)
+    requires D <Int N andBool pyMod(N, D) =/=Int 0
+
+  // A nonnegative integer is prime exactly when it is at least two and has
+  // no divisor in [2, N).
+  syntax Bool ::= isPrime(Int) [function]
+  rule isPrime(N:Int) => false
+    requires N <Int 2
+  rule isPrime(N:Int) => noDivisorsFrom(N, 2)
+    requires N >=Int 2
+endmodule

