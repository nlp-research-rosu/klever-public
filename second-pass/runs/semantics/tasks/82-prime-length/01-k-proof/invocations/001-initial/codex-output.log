+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Loop invariant: N is at least two, candidates [2,D) have already been
+  // eliminated, and the remaining computation returns exactly the result of
+  // testing D through N - 1.  Re-entering #while establishes the circularity.
+  claim [divisor-loop]:
+    <k>
+      #while(
+        Compare(Name("divisor"), CmpOp("<", Name("n"))),
+        primeLoopBody)
+      ~> Return(Bool(true))
+      ~> .Stmts
+      ~> #endcall
+      =>
+      noDivisorsFrom(N:Int, D:Int)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope
+       1 |-> scope(
+         "divisor" |-> D
+         "n" |-> N
+         "string" |-> S:Val,
+         parent(0)))
+      =>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 2
+     andBool D >=Int 2
+     andBool D <=Int N
+
+  // Entry-point theorem for every semantic string.  The N >= 0 side condition
+  // is intrinsic to isLen and records the Python-string input domain.
+  claim [prime-length]:
+    <k>
+      #applyK(
+        toCall(primeLengthClosure),
+        (str(CS:IntSeq), .Vals))
+      =>
+      isPrime(N:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N ==Int isLen(CS) andBool N >=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..09faea180548c56049d125e730d88da43a175c35
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,54 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact constructor form generated from solution.py.  These are only
+  // abbreviations, so symbolic execution still uses the supplied MPY rules.
+  syntax Stmts ::= "primeLoopBody" [function]
+  rule primeLoopBody
+    => If(
+         Compare(
+           BinOp("%", Name("n"), Name("divisor")),
+           CmpOp("==", Int(0))),
+         Return(Bool(false)) .Stmts,
+         .Stmts)
+       AugAssign(Name("divisor"), "+", Int(1))
+       .Stmts
+
+  syntax Stmts ::= "primeBody" [function]
+  rule primeBody
+    => Assign(Name("n"), Call(Name("len"), (Name("string"), .Exprs)))
+       If(
+         Compare(Name("n"), CmpOp("<", Int(2))),
+         Return(Bool(false)) .Stmts,
+         .Stmts)
+       Assign(Name("divisor"), Int(2))
+       While(
+         Compare(Name("divisor"), CmpOp("<", Name("n"))),
+         primeLoopBody)
+       Return(Bool(true))
+       .Stmts
+
+  syntax Val ::= "primeLengthClosure" [function]
+  rule primeLengthClosure
+    => closureVal(("string", .ParamNames), primeBody, 0)
+
+  // Mathematical result of testing the candidate divisors D, D + 1, ..., N - 1.
+  // The equations deliberately mirror the Python loop.
+  syntax Bool ::= noDivisorsFrom(Int, Int) [function]
+  rule noDivisorsFrom(N:Int, D:Int) => true
+    requires D >=Int N
+  rule noDivisorsFrom(N:Int, D:Int) => false
+    requires D <Int N andBool pyMod(N, D) ==Int 0
+  rule noDivisorsFrom(N:Int, D:Int) => noDivisorsFrom(N, D +Int 1)
+    requires D <Int N andBool pyMod(N, D) =/=Int 0
+
+  // A nonnegative integer is prime exactly when it is at least two and has
+  // no divisor in [2, N).
+  syntax Bool ::= isPrime(Int) [function]
+  rule isPrime(N:Int) => false
+    requires N <Int 2
+  rule isPrime(N:Int) => noDivisorsFrom(N, 2)
+    requires N >=Int 2
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..10f7096f54172f425fd44068999450a7db811d2e
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,22 @@
+def prime_length(string):
+    n = len(string)
+    if n < 2:
+        return False
+
+    divisor = 2
+    while divisor < n:
+        if n % divisor == 0:
+            return False
+        divisor += 1
+
+    return True
+
+
+assert prime_length("Hello") == True
+assert prime_length("abcdcba") == True
+assert prime_length("kittens") == True
+assert prime_length("orange") == False
+assert prime_length("") == False
+assert prime_length("a") == False
+assert prime_length("abcdefghijk") == True
+assert prime_length("abcdefghijkl") == False
