Module(
  FuncDef("prime_length", Params("string"),
    Assign(Name("n"), Call(Name("len"), Name("string")))
    If(Compare(Name("n"), CmpOp("<", Int(2))),
      Return(Bool(false)),
      )
    Assign(Name("divisor"), Int(2))
    While(Compare(Name("divisor"), CmpOp("<", Name("n"))),
      If(Compare(
        BinOp("%", Name("n"), Name("divisor")),
        CmpOp("==", Int(0))),
        Return(Bool(false)),
        )
      AugAssign(Name("divisor"), "+", Int(1)))
    Return(Bool(true)))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("Hello")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("abcdcba")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("kittens")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("orange")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("a")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("aa")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("aaa")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("aaaa")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("aaaaa")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("aaaaaa")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("aaaaaaa")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("aaaaaaaa")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("aaaaaaaaa")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("aaaaaaaaaaa")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("aaaaaaaaaaaa")),
      CmpOp("==", Bool(false)))))
