===== /candidate/solution.py
     1	def prime_length(string):
     2	    n = len(string)
     3	    if n < 2:
     4	        return False
     5	
     6	    divisor = 2
     7	    while divisor < n:
     8	        if n % divisor == 0:
     9	            return False
    10	        divisor += 1
    11	
    12	    return True
