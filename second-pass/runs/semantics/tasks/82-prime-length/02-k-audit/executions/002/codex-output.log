     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Exact constructor form generated from solution.py.  These are only
     7	  // abbreviations, so symbolic execution still uses the supplied MPY rules.
     8	  syntax Stmts ::= "primeLoopBody" [function]
     9	  rule primeLoopBody
    10	    => If(
    11	         Compare(
    12	           BinOp("%", Name("n"), Name("divisor")),
    13	           CmpOp("==", Int(0))),
    14	         Return(Bool(false)) .Stmts,
    15	         .Stmts)
    16	       AugAssign(Name("divisor"), "+", Int(1))
    17	       .Stmts
    18	
    19	  syntax Stmts ::= "primeBody" [function]
    20	  rule primeBody
    21	    => Assign(Name("n"), Call(Name("len"), (Name("string"), .Exprs)))
    22	       If(
    23	         Compare(Name("n"), CmpOp("<", Int(2))),
    24	         Return(Bool(false)) .Stmts,
    25	         .Stmts)
    26	       Assign(Name("divisor"), Int(2))
    27	       While(
    28	         Compare(Name("divisor"), CmpOp("<", Name("n"))),
    29	         primeLoopBody)
    30	       Return(Bool(true))
    31	       .Stmts
    32	
    33	  syntax Val ::= "primeLengthClosure" [function]
    34	  rule primeLengthClosure
    35	    => closureVal(("string", .ParamNames), primeBody, 0)
    36	
    37	  // Proof-only observation points used by the setup claim.  They stop at the
    38	  // generated While statement and capture its live n and divisor values;
    39	  // they do not summarize or execute the loop body.
    40	  syntax KItem ::= #primeLoopEntry(Int, Int)
    41	                 | "#capturePrimeLoopN"
    42	                 | #capturePrimeLoopD(Int)
    43	  rule <k>
    44	         While(_C:Expr, _B:Stmts)
    45	         =>
    46	         Name("n") ~> #capturePrimeLoopN
    47	         ...
    48	       </k>
    49	       [priority(1)]
    50	
    51	  rule <k>
    52	         N:Int ~> #capturePrimeLoopN ~> REST:K
    53	         =>
    54	         Name("divisor") ~> #capturePrimeLoopD(N) ~> REST
    55	       </k>
    56	       [priority(40)]
    57	
    58	  rule
    59	    <k>
    60	      D:Int ~> #capturePrimeLoopD(N:Int) ~> _REST:K
    61	      =>
    62	      #primeLoopEntry(N, D)
    63	    </k>
    64	    <env> _ => 0 </env>
    65	    <scopes> _ => .Map </scopes>
    66	    <scopeLoc> _ => 0 </scopeLoc>
    67	    <stack> _ => .List </stack>
    68	    <ret> _ => noRet </ret>
    69	    [priority(40)]
    70	
    71	  // Mathematical result of testing the candidate divisors D, D + 1, ..., N - 1.
    72	  // The equations deliberately mirror the Python loop.
    73	  syntax Bool ::= noDivisorsFrom(Int, Int) [function]
    74	  rule noDivisorsFrom(N:Int, D:Int) => true
    75	    requires D >=Int N
    76	  rule noDivisorsFrom(N:Int, D:Int) => false
    77	    requires D <Int N andBool pyMod(N, D) ==Int 0
    78	  rule noDivisorsFrom(N:Int, D:Int) => noDivisorsFrom(N, D +Int 1)
    79	    requires D <Int N andBool pyMod(N, D) =/=Int 0
    80	
    81	endmodule
