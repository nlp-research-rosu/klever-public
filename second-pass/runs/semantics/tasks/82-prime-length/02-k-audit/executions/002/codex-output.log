     1	def prime_length(string):
     2	    n = len(string)
     3	    if n < 2:
     4	        return False
     5	
     6	    divisor = 2
     7	    while divisor < n:
     8	        if n % divisor == 0:
     9	            return False
    10	        divisor += 1
    11	
    12	    return True
    13	
    14	
    15	assert prime_length("Hello") == True
    16	assert prime_length("abcdcba") == True
    17	assert prime_length("kittens") == True
    18	assert prime_length("orange") == False
    19	assert prime_length("") == False
    20	assert prime_length("a") == False
    21	assert prime_length("abcdefghijk") == True
    22	assert prime_length("abcdefghijkl") == False
