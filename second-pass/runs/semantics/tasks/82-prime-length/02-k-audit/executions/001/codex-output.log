kprove spec.k \
  --definition verification-kompiled \
  --spec-module LOOP-SPEC
def prime_length(string):
    n = len(string)
    if n < 2:
        return False

    divisor = 2
    while divisor < n:
        if n % divisor == 0:
            return False
        divisor += 1

    return True


assert prime_length("Hello") == True
assert prime_length("abcdcba") == True
assert prime_length("kittens") == True
assert prime_length("orange") == False
assert prime_length("") == False
assert prime_length("a") == False
assert prime_length("abcdefghijk") == True
assert prime_length("abcdefghijkl") == False
Module(
  FuncDef("prime_length", Params("string"),
    Assign(Name("n"), Call(Name("len"), Name("string")))
    If(Compare(Name("n"), CmpOp("<", Int(2))),
      Return(Bool(false)),
      )
    Assign(Name("divisor"), Int(2))
    While(Compare(Name("divisor"), CmpOp("<", Name("n"))),
      If(Compare(
        BinOp("%", Name("n"), Name("divisor")),
        CmpOp("==", Int(0))),
        Return(Bool(false)),
        )
      AugAssign(Name("divisor"), "+", Int(1)))
    Return(Bool(true)))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("Hello")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("abcdcba")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("kittens")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("orange")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("a")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("abcdefghijk")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("prime_length"), Str("abcdefghijkl")),
      CmpOp("==", Bool(false)))))

