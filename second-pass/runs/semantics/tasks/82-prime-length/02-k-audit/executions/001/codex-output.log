+requires "verification.k"
+
+module AUDIT-VACUITY
+  imports VERIFICATION
+
+  // Fresh reviewer mutation of the result-constraining small-input claim.
+  // The empty string satisfies the original precondition, but the real result
+  // is false; this deliberately and incorrectly demands true.
+  claim [false-small-result]:
+    <k>
+      #applyK(
+        toCall(primeLengthClosure),
+        (str(.IntSeq), .Vals))
+      =>
+      true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/used_construct_map.md b/evidence/used_construct_map.md
new file mode 100644
index 0000000000000000000000000000000000000000..b9eb775baaad6373d86d97f1a2368f8058bd51b3
--- /dev/null
+++ b/evidence/used_construct_map.md
@@ -0,0 +1,19 @@
+# `solution.mpy` construct-to-semantics map
+
+| Submitted construct | Declaration | Execution rules |
+|---|---|---|
