     3	module UNIQUE-VERIFICATION
     4	  imports MPY
     5	
     6	  // Membership and append-if-absent in the same first-seen order used by
     7	  // solution.py's result list.
     8	  syntax Bool ::= memberVS(Val, ValSeq) [function, total]
     9	  rule memberVS(_:Val, .ValSeq) => false [simplification]
    10	  rule memberVS(V:Val, vCons(V, _:ValSeq)) => true [simplification]
    11	  rule memberVS(V:Val, vCons(H:Val, T:ValSeq)) => memberVS(V, T)
    12	    requires notBool (V ==K H)
    13	    [simplification]
    14	
    15	  syntax ValSeq ::= addUnique(ValSeq, Val) [function, total]
    16	  rule addUnique(ACC:ValSeq, V:Val) => ACC
    17	    requires memberVS(V, ACC)
    18	  rule addUnique(ACC:ValSeq, V:Val)
    19	    => valSeqConcat(ACC, vCons(V, .ValSeq))
    20	    requires notBool memberVS(V, ACC)
    21	
    22	  syntax ValSeq ::= uniqueAcc(ValSeq, ValSeq) [function, total]
    23	  rule uniqueAcc(.ValSeq, ACC:ValSeq) => ACC
    24	  rule uniqueAcc(vCons(V:Val, REST:ValSeq), ACC:ValSeq)
    25	    => uniqueAcc(REST, addUnique(ACC, V))
    26	
    27	  // A for-loop leaves the loop variable bound to the final visited element.
    28	  syntax Val ::= lastItem(ValSeq, Val) [function, total]
    29	  rule lastItem(.ValSeq, OLD:Val) => OLD
    30	  rule lastItem(vCons(V:Val, REST:ValSeq), _:Val)
    31	    => lastItem(REST, V)
    32	
    33	  syntax Stmts ::= "uniqueLoopBody" [function, total]
    34	  rule uniqueLoopBody
    35	    => If(
    36	         Compare(Name("item"), CmpOp("not in", Name("result"))),
    37	         Expr(Call(Attribute(Name("result"), "append"), Name("item"))),
    38	         .Stmts)
    39	
    40	  syntax Stmts ::= "uniqueBody" [function, total]
    41	  rule uniqueBody
    42	    => Assign(Name("result"), ListExpr(.Exprs))
    43	       For(Name("item"), Name("l"), uniqueLoopBody)
    44	       Return(Call(Name("sorted"), Name("result")))
    45	endmodule
