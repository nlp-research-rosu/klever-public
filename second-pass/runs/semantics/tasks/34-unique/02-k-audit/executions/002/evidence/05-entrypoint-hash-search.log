[[ -w "$OUTPUT_DIR" && -x "$OUTPUT_DIR" ]] \
  || setup_error "audit output is not writable: $OUTPUT_DIR"
is_real_directory "$SUPERVISOR_PARENT" \
  || setup_error "supervisor parent is missing, linked, or not a directory: $SUPERVISOR_PARENT"

