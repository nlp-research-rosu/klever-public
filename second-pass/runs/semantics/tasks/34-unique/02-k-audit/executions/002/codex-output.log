index 0000000000000000000000000000000000000000..c874a6e50e90854e3ed3b7fffe418e314f6b51b8
--- /dev/null
+++ b/evidence/spec-vacuity-audit.k
@@ -0,0 +1,66 @@
+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports UNIQUE-VERIFICATION
+
+  claim [member-summary-vacuity-support]:
+    <k>
+      #memberAcc(V:Val, list(VS:ValSeq)) ~> CONT:K
+      => memberVS(V, VS) ~> CONT
+    </k>
+
+  claim [unique-loop-vacuity-support]:
+    <k>
+      #loop(list(INPUT:ValSeq), Name("item"), uniqueLoopBody) ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        .Map
+          [ "l" <- ARG:Val ]
+          [ "result" <- ref(H) ]
+          [ "item" <- OLD:Val => lastItem(INPUT, OLD) ],
+        parent(P:Int)) ...
+    </scopes>
+    <heap>
+      ... H:Int |-> list(ACC:ValSeq => uniqueAcc(INPUT, ACC)) ...
+    </heap>
+
+  // Deliberately false result mutation.  For INPUT=.ValSeq, the real returned
+  // list is empty, not [999].
+  claim [unique-false-result]:
+    <k>
+      #loadAll(
+        Module(
+          FuncDef("unique", Params("l"), uniqueBody)
+          Assign(
+            Name("answer"),
+            Call(Name("unique"), list(INPUT:ValSeq)))))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        .Map
+          [ "unique" <- closureVal("l", uniqueBody, 0) ]
+          [ "answer" <- ref(1) ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(uniqueAcc(INPUT, .ValSeq))
+      1 |-> list(vCons(999, sortVS(uniqueAcc(INPUT, .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/verification-body-mutation.k b/evidence/verification-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..bafb72d97e161956710e619e94b60a57af1514f3
--- /dev/null
+++ b/evidence/verification-body-mutation.k
@@ -0,0 +1,44 @@
+requires "reference-semantics/semantics.k"
+
+module UNIQUE-VERIFICATION-BODY-MUTATION
+  imports MPY
+
+  syntax Bool ::= memberVS(Val, ValSeq) [function, total]
+  rule memberVS(_:Val, .ValSeq) => false [simplification]
+  rule memberVS(V:Val, vCons(V, _:ValSeq)) => true [simplification]
+  rule memberVS(V:Val, vCons(H:Val, T:ValSeq)) => memberVS(V, T)
+    requires notBool (V ==K H)
+    [simplification]
+
+  syntax ValSeq ::= addUnique(ValSeq, Val) [function, total]
+  rule addUnique(ACC:ValSeq, V:Val) => ACC
+    requires memberVS(V, ACC)
+  rule addUnique(ACC:ValSeq, V:Val)
+    => valSeqConcat(ACC, vCons(V, .ValSeq))
+    requires notBool memberVS(V, ACC)
+
+  syntax ValSeq ::= uniqueAcc(ValSeq, ValSeq) [function, total]
+  rule uniqueAcc(.ValSeq, ACC:ValSeq) => ACC
+  rule uniqueAcc(vCons(V:Val, REST:ValSeq), ACC:ValSeq)
+    => uniqueAcc(REST, addUnique(ACC, V))
+
+  syntax Val ::= lastItem(ValSeq, Val) [function, total]
+  rule lastItem(.ValSeq, OLD:Val) => OLD
+  rule lastItem(vCons(V:Val, REST:ValSeq), _:Val)
+    => lastItem(REST, V)
+
+  syntax Stmts ::= "uniqueLoopBody" [function, total]
+  rule uniqueLoopBody
+    => If(
+         Compare(Name("item"), CmpOp("not in", Name("result"))),
+         Expr(Call(Attribute(Name("result"), "append"), Name("item"))),
+         .Stmts)
+
+  // Deliberate material mutation: omit the call to sorted and return the
+  // first-seen accumulator object directly.
+  syntax Stmts ::= "uniqueBody" [function, total]
+  rule uniqueBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       For(Name("item"), Name("l"), uniqueLoopBody)
+       Return(Name("result"))
+endmodule

exec
/bin/bash -lc "set -o pipefail; { echo '"'$ kprove spec-vacuity-audit.k --definition audit-verification-kompiled --spec-module SPEC-VACUITY-AUDIT'"'; set +e; kprove spec-vacuity-audit.k --definition audit-verification-kompiled --spec-module SPEC-VACUITY-AUDIT; proof_status="'$?; set -e; echo "KPROVE EXIT: $proof_status"; if [ "$proof_status" -eq 0 ]; then echo '"'AUDIT RESULT: UNEXPECTED FALSE-RESULT SUCCESS'; exit 1; fi; echo 'AUDIT RESULT: EXPECTED FALSE-RESULT FAILURE'; exit 0; } 2>&1 | tee /audit-output/evidence/38-vacuity-kprove.log" in /tmp/audit-work/reconstruction
