+      1 |-> list(vCons(999, sortVS(uniqueAcc(INPUT, .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
