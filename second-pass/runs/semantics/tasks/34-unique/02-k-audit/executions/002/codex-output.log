+        .Map
+          [ "unique" <- closureVal("l", uniqueBody, 0) ]
+          [ "answer" <- ref(1) ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(vCons(2, vCons(1, vCons(3, .ValSeq))))
+      1 |-> list(vCons(1, vCons(2, vCons(3, .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
