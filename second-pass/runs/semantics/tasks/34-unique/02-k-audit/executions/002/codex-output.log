+                  vCons(1, vCons(2, vCons(3, vCons(1, .ValSeq))))))))))
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        .Map
+          [ "unique" <- closureVal("l", uniqueBody, 0) ]
+          [ "answer" <- ref(1) ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
