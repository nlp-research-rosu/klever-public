+    print(f"codex_output_noteworthy_counts={dict(noteworthy)}")
+
+    print(f"ISSUE_COUNT={len(issues)}")
+    for issue in issues:
+        print(f"ISSUE: {issue}")
+    return 1 if issues else 0
+
+
