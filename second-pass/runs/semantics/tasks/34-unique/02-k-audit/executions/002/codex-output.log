+        raise RuntimeError("could not extract uniqueBody defining RHS")
+    claimed_body_text = body_match.group(1).strip()
+    claimed_body = run_kast(
+        "--expression",
+        claimed_body_text,
+        "--definition",
+        str(DEFINITION),
+        "--module",
+        "UNIQUE-VERIFICATION",
+        "--sort",
+        "Stmts",
+        "--output",
+        "json",
+    )
