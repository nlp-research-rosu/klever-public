index 0000000000000000000000000000000000000000..493f354d556fb0ac0c516ded4de00e3da533ee51
--- /dev/null
+++ b/evidence/differential_unique.py
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+"""Independent differential test for HumanEval 34's unique entry point."""
+
+from __future__ import annotations
+
+import copy
+import importlib.util
+import itertools
+import json
+import random
+import sys
+from pathlib import Path
+
+
+def load_module(name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot load {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def outcome(function, value):
+    try:
+        return ("return", function(copy.deepcopy(value)))
+    except Exception as error:  # Compare observable exception classes too.
+        return ("raise", type(error).__name__, str(error))
+
+
+def main() -> int:
+    if len(sys.argv) != 4:
+        print(
+            "usage: differential_unique.py CANONICAL.py SOLUTION.py INPUTS.json",
+            file=sys.stderr,
+        )
+        return 64
+
+    canonical = load_module("trusted_canonical", Path(sys.argv[1]))
+    generated = load_module("generated_solution", Path(sys.argv[2]))
+
+    curated = [
+        ("documented-example", [5, 3, 5, 2, 3, 3, 9, 0, 123]),
+        ("empty-loop-boundary", []),
+        ("singleton-new-branch", [1]),
+        ("duplicate-branch", [1, 1]),
+        ("new-then-new", [1, 2]),
+        ("sorting-reversal", [2, 1]),
+        ("negative-and-duplicates", [-1, 3, -1, 2, 3]),
+        ("already-sorted", [-3, -2, -1, 0, 1, 2, 3]),
+        ("reverse-sorted", [3, 2, 1, 0, -1, -2, -3]),
+        ("alternating-branches", [0, 1, 0, 2, 1, 3, 2, 3]),
+        ("integer-boundaries", [-(2**63), 2**63 - 1, -(2**63), 0]),
+        ("unbounded-integers", [10**100, -(10**100), 10**100, 7]),
+        ("bool-int-equality", [True, 1, False, 0, 2]),
+        ("homogeneous-strings", ["z", "a", "z", "", "a"]),
+        ("homogeneous-tuples", [(2, 0), (1, 9), (2, 0), (1, 3)]),
+    ]
+
+    exhaustive = [
+        (f"exhaustive-small-int-len-{length}", list(values))
+        for length in range(0, 6)
+        for values in itertools.product([-2, -1, 0, 1, 2], repeat=length)
+    ]
+
+    random_source = random.Random(340034)
+    generated_cases = [
+        (
+            "seeded-random-int",
+            [
+                random_source.randint(-10**6, 10**6)
+                for _ in range(random_source.randint(0, 40))
+            ],
+        )
+        for _ in range(250)
+    ]
+
+    cases = curated + exhaustive + generated_cases
+    corpus = [
+        {"ordinal": ordinal, "category": category, "input_repr": repr(value)}
+        for ordinal, (category, value) in enumerate(cases)
+    ]
+    Path(sys.argv[3]).write_text(
+        json.dumps(corpus, indent=2, sort_keys=True) + "\n", encoding="utf-8"
+    )
+
+    mismatches = []
+    for ordinal, (category, value) in enumerate(cases):
+        expected = outcome(canonical.unique, value)
+        actual = outcome(generated.unique, value)
+        if expected != actual:
+            mismatches.append(
+                {
+                    "ordinal": ordinal,
+                    "category": category,
+                    "input": repr(value),
+                    "canonical": repr(expected),
+                    "generated": repr(actual),
+                }
+            )
+
+    print(f"oracle=/reference/canonical.py:unique")
+    print(f"subject=/candidate/solution.py:unique (scratch copy)")
+    print(f"curated_cases={len(curated)}")
+    print(
+        "exhaustive_scope=all integer lists of lengths 0..5 "
+        "over alphabet [-2,-1,0,1,2]"
+    )
+    print(f"exhaustive_cases={len(exhaustive)}")
+    print("random_scope=250 seeded integer lists; seed=340034; lengths=0..40")
+    print(f"generated_cases={len(generated_cases)}")
+    print(f"total_cases={len(cases)}")
+    print(f"mismatch_count={len(mismatches)}")
+    for ground in ([], [1], [2, 1, 2], [5, 3, 5, 2, 3, 3, 9, 0, 123]):
+        print(
+            f"ground={ground!r} "
+            f"canonical={outcome(canonical.unique, ground)!r} "
+            f"generated={outcome(generated.unique, ground)!r}"
+        )
+    if mismatches:
+        print(json.dumps(mismatches[:10], indent=2, sort_keys=True))
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/evidence/inventory_k.py b/evidence/inventory_k.py
new file mode 100644
index 0000000000000000000000000000000000000000..e3125fe07ec6820b4a96cc37a11422a42b1c5689
--- /dev/null
+++ b/evidence/inventory_k.py
@@ -0,0 +1,130 @@
+#!/usr/bin/env python3
+"""Produce a line-bounded inventory of K declarations and rule-like statements."""
+
+from __future__ import annotations
+
+import re
+import sys
+from collections import Counter
+from pathlib import Path
+
+
+START = re.compile(
+    r"^(?P<indent>[ \t]+)(?P<kind>"
+    r"configuration|syntax|rule|claim|context|alias"
+    r")\b"
+)
+BOUNDARY = re.compile(
+    r"^(?:[ \t]+(?:configuration|syntax|rule|claim|context|alias)\b"
+    r"|[ \t]*(?:module|endmodule|imports|requires)\b)"
+)
+
+
+def classify(kind: str, statement: str) -> str:
+    tags = [kind]
+    if kind == "syntax":
+        for attribute in ("function", "total", "functional", "hook", "symbol"):
+            if re.search(rf"\b{attribute}\b", statement):
+                tags.append(attribute)
+        if re.search(r"\btoken\b", statement):
+            tags.append("token")
+        if re.search(r"\bpriorit(?:y|ies)\b", statement):
+            tags.append("priority-declaration")
+    elif kind == "rule":
+        if re.search(r"\bsimplification\b", statement):
+            tags.append("simplification")
+        else:
+            tags.append("ordinary")
+        if re.search(r"\bpriority\s*\(", statement):
+            tags.append("priority-rule")
+        if re.search(r"\bowise\b", statement):
+            tags.append("owise")
+        if re.search(r"\banywhere\b", statement):
+            tags.append("anywhere")
+        if re.search(r"\bmacro\b", statement):
+            tags.append("macro")
+    return ",".join(tags)
+
+
+def inventory(path: Path):
+    lines = path.read_text(encoding="utf-8").splitlines()
+    statements = []
+    index = 0
+    while index < len(lines):
+        match = START.match(lines[index])
+        if match is None:
+            index += 1
+            continue
+        indent_width = len(match.group("indent").expandtabs(8))
+        # Only module-level statements are indented one logical level. Content
+        # nested inside a statement is more deeply indented.
+        if indent_width > 2:
+            index += 1
+            continue
+        kind = match.group("kind")
+        start = index
+        index += 1
+        while index < len(lines):
+            next_match = START.match(lines[index])
+            if next_match is not None:
+                next_indent = len(next_match.group("indent").expandtabs(8))
+                if next_indent <= 2:
+                    break
+            if re.match(r"^[ \t]*endmodule\b", lines[index]):
+                break
+            index += 1
+        end = index
+        text = "\n".join(lines[start:end]).rstrip()
+        statements.append((start + 1, end, kind, classify(kind, text), text))
+    return statements
+
+
+def main() -> int:
+    if len(sys.argv) < 2:
+        print(f"usage: {sys.argv[0]} FILE_OR_DIRECTORY [...]", file=sys.stderr)
+        return 64
+
+    files = []
+    for raw_path in sys.argv[1:]:
+        path = Path(raw_path)
+        if path.is_dir():
+            files.extend(sorted(path.rglob("*.k")))
+        else:
+            files.append(path)
+    files = sorted(dict.fromkeys(files))
+
+    totals = Counter()
+    print("# Exhaustive K declaration and rule inventory")
+    print()
+    print("Generated by inventory_k.py from fresh scratch source copies.")
+    for path in files:
+        statements = inventory(path)
+        local = Counter(item[2] for item in statements)
+        print()
+        print(f"## {path}")
+        print()
+        print(
+            "Local counts: "
+            + ", ".join(f"{kind}={local[kind]}" for kind in sorted(local))
+        )
+        print()
+        for start, end, kind, classification, text in statements:
+            totals[kind] += 1
+            for tag in classification.split(",")[1:]:
+                totals[f"{kind}:{tag}"] += 1
+            print(f"### lines {start}-{end}: {classification}")
+            print()
+            print("```k")
+            print(text)
+            print("```")
+            print()
+
+    print("## Totals")
+    print()
+    for key in sorted(totals):
+        print(f"- {key}: {totals[key]}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/evidence/k_concrete_tests.py b/evidence/k_concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..55dccfa7c8e0f85c12d978abe2c8bed098d33d5c
--- /dev/null
+++ b/evidence/k_concrete_tests.py
@@ -0,0 +1,14 @@
+def unique(l: list):
+    result = []
+    for item in l:
+        if item not in result:
+            result.append(item)
+    return sorted(result)
+
+
+assert unique([]) == []
+assert unique([7]) == [7]
+assert unique([4, 4, 4]) == [4]
+assert unique([2, 1]) == [1, 2]
+assert unique([-1, 3, -1, 2, 3]) == [-1, 2, 3]
+assert unique([5, 3, 5, 2, 3, 3, 9, 0, 123]) == [0, 2, 3, 5, 9, 123]
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..bcc7dc4d06437f646e7058bcf2bb0a963c664d28
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ "$#" -lt 3 ]]; then
+  echo "usage: $0 LOG_FILE WORKDIR COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_file=$1
+work_dir=$2
+shift 2
+
+{
+  printf 'WORKDIR: %q\n' "$work_dir"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} >"$log_file"
+
+(
+  cd "$work_dir" || exit 72
+  "$@"
+) >>"$log_file" 2>&1
+status=$?
+
+printf 'EXIT_STATUS: %d\n' "$status" >>"$log_file"
+exit "$status"
