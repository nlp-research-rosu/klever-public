Module(
  FuncDef("unique", Params("l"),
    Assign(Name("result"), ListExpr())
    For(Name("item"), Name("l"),
      If(Compare(Name("item"), CmpOp("not in", Name("result"))),
        Expr(Call(Attribute(Name("result"), "append"), Name("item"))),
        ))
    Return(Call(Name("sorted"), Name("result"))))
  Assert(
    Compare(Call(Name("unique"), ListExpr()), CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("unique"), ListExpr(Int(1))),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(Name("unique"), ListExpr(Int(4), Int(4), Int(4))),
      CmpOp("==", ListExpr(Int(4)))))
  Assert(
    Compare(
      Call(
        Name("unique"),
        ListExpr(
          UnaryOp("-", Int(1)),
          Int(3),
          UnaryOp("-", Int(1)),
          Int(2),
          Int(3))),
      CmpOp("==", ListExpr(UnaryOp("-", Int(1)), Int(2), Int(3)))))
  Assert(
    Compare(
      Call(
        Name("unique"),
        ListExpr(
          Int(5),
          Int(3),
          Int(5),
          Int(2),
          Int(3),
          Int(3),
          Int(9),
          Int(0),
          Int(123))),
      CmpOp(
        "==",
        ListExpr(Int(0), Int(2), Int(3), Int(5), Int(9), Int(123))))))
