+requires "verification.k"
+
+module UNIQUE-SPEC
+  imports UNIQUE-VERIFICATION
+
+  claim [unique-loop]:
+    <k>
+      #loop(list(INPUT:ValSeq), Name("item"), uniqueLoopBody) ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(M:Map => bindItems(INPUT, M), P:Parent) ...
+    </scopes>
