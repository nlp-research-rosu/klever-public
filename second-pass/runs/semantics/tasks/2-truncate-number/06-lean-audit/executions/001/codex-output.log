codex
The root cause is concrete: this sandbox’s process reports namespace PID `2`, while `/proc/2/exe` is absent and `/proc/self/exe` is valid; Lean 4.22 hard-codes `/proc/<getpid()>/exe`. I’m applying a narrow read-only compatibility shim that redirects only that exact self-executable lookup, then rerunning the unchanged trusted preflight function.
apply patch
patch: completed
/audit-output/evidence/proc_exe_compat.c
diff --git a/evidence/proc_exe_compat.c b/evidence/proc_exe_compat.c
new file mode 100644
index 0000000000000000000000000000000000000000..125f3f1033745abda930816669f258f478ce6030
--- /dev/null
+++ b/evidence/proc_exe_compat.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+#include <stdio.h>
+#include <string.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    char namespace_self[64];
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    snprintf(
+        namespace_self,
+        sizeof(namespace_self),
+        "/proc/%ld/exe",
+        (long)getpid()
+    );
+    if (strcmp(path, namespace_self) == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}

