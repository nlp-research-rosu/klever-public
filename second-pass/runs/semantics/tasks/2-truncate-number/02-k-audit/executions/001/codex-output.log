new file mode 100644
index 0000000000000000000000000000000000000000..61b22e24d6d263a5e767bca30895c1491d92fa53
--- /dev/null
+++ b/evidence/spec-ground.k
@@ -0,0 +1,77 @@
+requires "verification.k"
+
+module SPEC-GROUND
+  imports VERIFICATION
+
+  claim [documented]:
+    <k> #loadAll(solutionProgram)
+         ~> Call(Name("truncate_number"), (Float(3.5), .Exprs))
+      => 0.5 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      => 0 |-> scope(
+           "truncate_number" |-> closureVal(
+             ("number", .ParamNames),
+             Return(BinOp("%", Name("number"), Float(1.0))) .Stmts,
+             0),
+           parent(-1))
+         -1 |-> builtinsScope
