const patch = "*** Begin Patch\n*** Add File: /work/solution.py\n+def truncate_number(number: float) -> float:\n+    return number % 1.0\n*** Add File: /work/verification.k\n+requires \"reference-semantics/semantics.k\"\n+\n+module VERIFICATION\n+  imports MPY\n+\n+  // The translated solution, named so every proof claim executes precisely\n+  // the program represented by solution.mpy.\n+  syntax Module ::= \"solutionProgram\"\n+  rule solutionProgram\n+    => Module(\n+         FuncDef(\"truncate_number\", Params(\"number\"),\n+           Return(BinOp(\"%\", Name(\"number\"), Float(1.0)))))\n+       [macro]\n+endmodule\n*** Add File: /work/spec.k\n+requires \"verification.k\"\n+\n+module SPEC\n+  imports VERIFICATION\n+\n+  // For an arbitrary floating-point input, executing the translated function\n+  // returns exactly the semantics' Python floor-modulo primitive.  The\n+  // supplied semantics evaluates that primitive concretely as\n+  // n - floor(n / 1.0) * 1.0, i.e. the requested decimal part for n > 0.\n+  claim\n+    <k> #loadAll(solutionProgram)\n+         ~> Call(Name(\"truncate_number\"), (Float(N:Float), .Exprs))\n+      => floatMod(N, 1.0) ... </k>\n+    <env> 0 </env>\n+    <scopes> 0 |-> scope(.Map, parent(-1))\n+              -1 |-> builtinsScope </scopes>\n+    <scopeLoc> 1 </scopeLoc>\n+    <heap> .Map </heap>\n+    <heapLoc> 0 </heapLoc>\n+    <stack> .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+endmodule\n*** End Patch";
text(await tools.apply_patch(patch));

