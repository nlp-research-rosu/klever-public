+    Call(Name("truncate_number"), Float(5e-324d)))
+  Assign(Name("modLongD"),
+    Call(Name("truncate_number"), Float(4.9406564584124654e-324d)))
+  Assign(Name("modShortExplicit"),
+    Call(Name("truncate_number"), Float(5e-324p53x11)))
+  Assign(Name("modLongExplicit"),
