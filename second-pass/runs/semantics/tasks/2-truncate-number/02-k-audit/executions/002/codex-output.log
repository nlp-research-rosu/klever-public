diff --git a/evidence/spec-body-mutation.k b/evidence/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..f7b9fd987f82a6688e066a6ad6955d89413a5548
--- /dev/null
+++ b/evidence/spec-body-mutation.k
@@ -0,0 +1,30 @@
+requires "verification-body-mutation.k"
+
+module AUDITOR-SPEC-BODY-MUTATION
+  imports AUDITOR-VERIFICATION-BODY-MUTATION
+
+  // Keep the original result obligation while changing the executed body.
+  claim
+    <k> #loadAll(mutatedSolutionProgram)
+         ~> Call(Name("truncate_number"), (Float(N:Float), .Exprs))
+      => floatMod(N, 1.0) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      => 0 |-> scope(
+           "truncate_number" |-> closureVal(
+             ("number", .ParamNames),
+             Return(BinOp("+", Name("number"), Float(1.0))) .Stmts,
+             0),
+           parent(-1))
+         -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..6ffbcf6257dd69baffbb1a20cb6e8a979fd4ee1a
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module AUDITOR-SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false result mutation. For the satisfying input N = 1.5,
+  // Python and concrete K both give 1.5 % 1.0 = 0.5, while 1.5 % 2.0 = 1.5.
+  claim
+    <k> #loadAll(solutionProgram)
+         ~> Call(Name("truncate_number"), (Float(N:Float), .Exprs))
