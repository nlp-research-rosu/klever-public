+      => 0.5 </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      => 0 |-> scope(
+           "truncate_number" |-> closureVal(
+             ("number", .ParamNames),
+             Return(BinOp("%", Name("number"), Float(1.0))) .Stmts,
