Module(
  FuncDef("truncate_number", Params("number"),
    Return(BinOp("%", Name("number"), Float(1.0))))
  Assert(
    Compare(
      Call(Name("truncate_number"), Float(3.5)),
      CmpOp("==", Float(0.5))))
  Assert(
    Compare(
      Call(Name("truncate_number"), Float(1.0)),
      CmpOp("==", Float(0.0))))
  Assert(
    Compare(
      Call(Name("truncate_number"), Float(0.25)),
      CmpOp("==", Float(0.25))))
  Assert(
    Compare(
      Call(Name("truncate_number"), Float(7.75)),
      CmpOp("==", Float(0.75)))))
