import json
from pathlib import Path
inv_path=Path('/reference/rule-inventory.json')
out_path=Path('/workspace/trust-boundary.json')
inv=json.loads(inv_path.read_text())
out=json.loads(out_path.read_text())
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert list(out.keys()) == ['schema_version','inventory_sha256','rules'], list(out.keys())
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
expected=[r['source_rule_id'] for r in inv['rules']]
actual=[r['source_rule_id'] for r in out['rules']]
assert actual == expected, (actual,expected)
assert len(actual) == len(set(actual)) == len(expected)
for i,r in enumerate(out['rules']):
    assert list(r.keys()) == ['source_rule_id','classification','rationale'], (i,list(r.keys()))
    assert r['classification'] in allowed
    assert isinstance(r['rationale'],str) and r['rationale'].strip()
print(f'validated {len(actual)} rules in canonical order; coverage and uniqueness exact')
from collections import Counter
print(dict(Counter(r['classification'] for r in out['rules'])))
