+
+if (( cmp_status != 0 )); then
+  diff -u \
+    /tmp/audit-work/candidate-src/solution.mpy \
+    /tmp/audit-work/regenerated-solution.mpy || true
+fi
+
+if (( translate_status != 0 || cmp_status != 0 )); then
+  exit 1
+fi
