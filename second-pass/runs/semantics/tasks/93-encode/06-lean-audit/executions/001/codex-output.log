diff --git a//tmp/audit-work/lean_proc_self_shim.c b//tmp/audit-work/lean_proc_self_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..1c15a1aa6b5d0f96108d44a772aec541a0602ba8
--- /dev/null
+++ b//tmp/audit-work/lean_proc_self_shim.c
@@ -0,0 +1,33 @@
+#define _GNU_SOURCE
+
+#include <stdio.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+/*
+ * The audit container's PID namespace does not expose /proc/<getpid()>/exe,
+ * although /proc/self/exe is available. Lean 4.22's lean_io_app_path uses the
+ * former spelling. Redirect only that exact self lookup and leave every other
+ * readlink call unchanged.
+ */
+ssize_t readlink(const char *path, char *buffer, size_t buffer_size) {
+    char self_pid_path[64];
+    int length = snprintf(
+        self_pid_path,
+        sizeof(self_pid_path),
+        "/proc/%ld/exe",
+        (long)getpid()
+    );
+    const char *resolved_path = path;
+
+    if (
+        length > 0
+        && (size_t)length < sizeof(self_pid_path)
+        && strcmp(path, self_pid_path) == 0
+    ) {
+        resolved_path = "/proc/self/exe";
+    }
+    return syscall(SYS_readlink, resolved_path, buffer, buffer_size);
+}

