Module(
  FuncDef("encode", Params("message"),
    Assign(Name("result"), Str(""))
    Assign(Name("char"), Str(""))
    Assign(Name("code"), Int(0))
    For(Name("char"), Name("message"),
      Assign(Name("char"), Call(Attribute(Name("char"), "swapcase"), ))
      Assign(Name("code"), Call(Name("ord"), Name("char")))
      If(BoolOp(
        "or",
        Compare(Name("code"), CmpOp("==", Int(97))),
        Compare(Name("code"), CmpOp("==", Int(101))),
        Compare(Name("code"), CmpOp("==", Int(105))),
        Compare(Name("code"), CmpOp("==", Int(111))),
        Compare(Name("code"), CmpOp("==", Int(117))),
        Compare(Name("code"), CmpOp("==", Int(65))),
        Compare(Name("code"), CmpOp("==", Int(69))),
        Compare(Name("code"), CmpOp("==", Int(73))),
        Compare(Name("code"), CmpOp("==", Int(79))),
        Compare(Name("code"), CmpOp("==", Int(85)))),
        AugAssign(
          Name("result"),
          "+",
          Call(Name("chr"), BinOp("+", Name("code"), Int(2)))),
        AugAssign(Name("result"), "+", Name("char"))))
    Return(Name("result")))
  Assert(Compare(Call(Name("encode"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(Call(Name("encode"), Str("test")), CmpOp("==", Str("TGST"))))
  Assert(
    Compare(
      Call(Name("encode"), Str("This is a message")),
      CmpOp("==", Str("tHKS KS C MGSSCGG"))))
  Assert(
    Compare(
      Call(Name("encode"), Str("aeiouAEIOU")),
      CmpOp("==", Str("CGKQWcgkqw"))))
  Assert(
    Compare(
      Call(Name("encode"), Str("xyz XYZ")),
      CmpOp("==", Str("XYZ xyz")))))
