+          CmpOp("in", Str("aeiouAEIOU"))),
+        AugAssign(
+          Name("result"),
+          "+",
+          Call(
+            Name("chr"),
+            (BinOp(
+              "+",
+              Call(Name("ord"), (Name("char"), .Exprs)),
+              Int(2)),
+             .Exprs))),
+        AugAssign(
+          Name("result"),
+          "+",
+          Name("char")))
+      .Stmts
