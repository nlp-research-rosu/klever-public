+             "result"  |-> str(.IntSeq)
+             "char"    |-> str(.IntSeq)
+             "code"    |-> 0,
+             parent(0))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 => 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List => ListItem(frame(.K, 0, 1)) </stack>
