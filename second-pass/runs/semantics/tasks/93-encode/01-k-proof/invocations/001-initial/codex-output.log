diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..8d5524a4accfc95adcac0bcffd3084e995b95673
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,99 @@
+requires "verification.k"
+
+module ENCODE-SPEC
+  imports ENCODE-VERIFICATION
+
+  // End-to-end contract.  During the joint proof this composes encode-init
+  // with the independently inductive encode-loop claim below.
+  claim [encode-total]:
+    <k>
+      Call(
+        closureVal(
+          ("message", .ParamNames),
+          encodeFunctionBody,
+          0),
+        (str(INPUT:IntSeq), .Exprs))
+      =>
+      str(encodeCodes(INPUT))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Phase 1: normal function-call setup reaches the loop invariant with the
+  // original message and an empty output accumulator.
+  claim [encode-init]:
+    <k>
+      Call(
+        closureVal(
+          ("message", .ParamNames),
+          encodeFunctionBody,
+          0),
+        (str(INPUT:IntSeq), .Exprs))
+      =>
+      #loop(str(INPUT), Name("char"), encodeLoopBody)
+      ~> (Return(Name("result")) .Stmts)
+      ~> #endcall
+    </k>
+    <env> 0 => 1 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(.Map, parent(-1))
+      1 |-> scope(
+             "message" |-> str(INPUT)
+             "result"  |-> str(.IntSeq)
+             "char"    |-> str(.IntSeq)
+             "code"    |-> 0,
+             parent(0))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 => 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List => ListItem(frame(.K, 0, 1)) </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Phase 2: K proves the loop invariant by circularity over INPUT.
+  claim [encode-loop]:
+    <k>
+      #loop(str(INPUT:IntSeq), Name("char"), encodeLoopBody)
+      ~> (Return(Name("result")) .Stmts)
+      ~> #endcall
+      =>
+      str(encodeAcc(INPUT, ACC))
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      1 |-> scope(
+             "message" |-> str(_MESSAGE:IntSeq)
+             "result"  |-> str(ACC:IntSeq)
+             "char"    |-> str(_OLDCHAR:IntSeq)
+             "code"    |-> _OLDCODE:Int,
+             parent(0))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..93049dde05e42cb617b4e44abb43b7239bf910f0
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,83 @@
+requires "reference-semantics/semantics.k"
+
+module ENCODE-VERIFICATION
+  imports MPY
+
+  // Exact loop body emitted by solution.mpy, named once so both proof phases
+  // are checked against the same AST.
+  syntax Stmts ::= "encodeLoopBody" [macro]
+  rule encodeLoopBody
+    =>
+      Assign(
+        Name("char"),
+        Call(Attribute(Name("char"), "swapcase"), .Exprs))
+      Assign(
+        Name("code"),
+        Call(Name("ord"), (Name("char"), .Exprs)))
+      If(
+        BoolOp(
+          "or",
+          (Compare(Name("code"), CmpOp("==", Int(97))),
+           Compare(Name("code"), CmpOp("==", Int(101))),
+           Compare(Name("code"), CmpOp("==", Int(105))),
+           Compare(Name("code"), CmpOp("==", Int(111))),
+           Compare(Name("code"), CmpOp("==", Int(117))),
+           Compare(Name("code"), CmpOp("==", Int(65))),
+           Compare(Name("code"), CmpOp("==", Int(69))),
+           Compare(Name("code"), CmpOp("==", Int(73))),
+           Compare(Name("code"), CmpOp("==", Int(79))),
+           Compare(Name("code"), CmpOp("==", Int(85))),
+           .Exprs)),
+        AugAssign(
+          Name("result"),
+          "+",
+          Call(
+            Name("chr"),
+            (BinOp(
+              "+",
+              Name("code"),
+              Int(2)),
+             .Exprs))),
+        AugAssign(
+          Name("result"),
+          "+",
+          Name("char")))
+      .Stmts
+
+  syntax Stmts ::= "encodeFunctionBody" [macro]
+  rule encodeFunctionBody
+    =>
+      Assign(Name("result"), Str(""))
+      Assign(Name("char"), Str(""))
+      Assign(Name("code"), Int(0))
+      For(Name("char"), Name("message"), encodeLoopBody)
+      Return(Name("result"))
+      .Stmts
+
+  // Mathematical contract: first swap each ASCII letter's case, then advance
+  // every (now case-swapped) vowel by two code points.
+  syntax Bool ::= isVowelCode(Int) [function, total]
+  rule isVowelCode(C:Int)
+    => C ==Int 65  orBool C ==Int 69  orBool C ==Int 73
+       orBool C ==Int 79  orBool C ==Int 85
+       orBool C ==Int 97  orBool C ==Int 101 orBool C ==Int 105
+       orBool C ==Int 111 orBool C ==Int 117
+
+  syntax Int ::= encodeCode(Int) [function, total]
+  rule encodeCode(C:Int) => swapC(C) +Int 2
+    requires isVowelCode(swapC(C))
+  rule encodeCode(C:Int) => swapC(C)
+    requires notBool isVowelCode(swapC(C))
+
+  // Accumulator form mirrors the implementation's left-to-right loop.  It is
+  // also the induction measure used by the loop claim in spec.k.
+  syntax IntSeq ::= encodeAcc(IntSeq, IntSeq) [function, total]
+  rule encodeAcc(.IntSeq, ACC:IntSeq) => ACC
+  rule encodeAcc(iCons(C:Int, REST:IntSeq), ACC:IntSeq)
+    => encodeAcc(
+         REST,
+         seqConcat(ACC, iCons(encodeCode(C), .IntSeq)))
+
+  syntax IntSeq ::= encodeCodes(IntSeq) [function, total]
+  rule encodeCodes(INPUT:IntSeq) => encodeAcc(INPUT, .IntSeq)
+endmodule

