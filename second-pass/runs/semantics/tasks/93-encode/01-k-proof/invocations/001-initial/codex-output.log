diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..141286c525bccf7673f90cc168590336b7519180
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,16 @@
+def encode(message):
+    result = ""
+    for char in message:
+        char = char.swapcase()
+        if char in "aeiouAEIOU":
+            result += chr(ord(char) + 2)
+        else:
+            result += char
+    return result
+
+
+assert encode("") == ""
+assert encode("test") == "TGST"
+assert encode("This is a message") == "tHKS KS C MGSSCGG"
+assert encode("aeiouAEIOU") == "CGKQWcgkqw"
+assert encode("xyz XYZ") == "XYZ xyz"
