     1	def triples_sum_to_zero(l: list):
     2	    for i in range(len(l)):
     3	        for j in range(i + 1, len(l)):
     4	            for k in range(j + 1, len(l)):
     5	                if l[i] + l[j] + l[k] == 0:
     6	                    return True
     7	    return False
