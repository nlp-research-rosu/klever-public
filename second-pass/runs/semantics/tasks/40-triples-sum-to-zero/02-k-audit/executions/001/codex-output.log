+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: the satisfying input A=B=C=0 makes the real copied
+  // body return true, while this postcondition demands false.
+  claim <k> #runTriples(
+            vCons(A:Int, vCons(B:Int, vCons(C:Int, .ValSeq))))
+          => false ... </k>
+        <env> 0 </env>
+        <scopes>
+          0 |-> scope(.Map, parent(-1))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <heap> .Map </heap>
+        <heapLoc> 0 </heapLoc>
+        <stack> .List </stack>
+        <ret> noRet </ret>
+        <exc> NoExc </exc>
+        <exit-code> 0 </exit-code>
+    [label(false-length-three)]
+endmodule
diff --git a/evidence/static_inventory.py b/evidence/static_inventory.py
