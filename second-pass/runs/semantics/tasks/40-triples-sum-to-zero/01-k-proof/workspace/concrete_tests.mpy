Module(
  FuncDef("triples_sum_to_zero", Params("l"),
    For(Name("i"), Call(Name("range"), Call(Name("len"), Name("l"))),
      For(Name("j"), Call(
        Name("range"),
        BinOp("+", Name("i"), Int(1)),
        Call(Name("len"), Name("l"))),
        For(Name("k"), Call(
          Name("range"),
          BinOp("+", Name("j"), Int(1)),
          Call(Name("len"), Name("l"))),
          If(Compare(
            BinOp(
              "+",
              BinOp(
                "+",
                Subscript(Name("l"), Name("i")),
                Subscript(Name("l"), Name("j"))),
              Subscript(Name("l"), Name("k"))),
            CmpOp("==", Int(0))),
            Return(Bool(true)),
            ))))
    Return(Bool(false)))
  Assert(
    Compare(
      Call(
        Name("triples_sum_to_zero"),
        ListExpr(Int(1), Int(3), Int(5), Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("triples_sum_to_zero"),
        ListExpr(Int(1), Int(3), UnaryOp("-", Int(2)), Int(1))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("triples_sum_to_zero"),
        ListExpr(Int(1), Int(2), Int(3), Int(7))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("triples_sum_to_zero"),
        ListExpr(
          Int(2),
          Int(4),
          UnaryOp("-", Int(5)),
          Int(3),
          Int(9),
          Int(7))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("triples_sum_to_zero"), ListExpr(Int(1))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("triples_sum_to_zero"),
        ListExpr(Int(0), Int(0), Int(0))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("triples_sum_to_zero"), ListExpr(Int(0), Int(0))),
      CmpOp("==", Bool(false)))))
