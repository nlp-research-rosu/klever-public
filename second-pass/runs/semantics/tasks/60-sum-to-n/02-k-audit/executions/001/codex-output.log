+                     Return(
+                       BinOp(
+                         "//",
+                         BinOp("*", Name("n"), BinOp("+", Name("n"), Int(2))),
+                         Int(2)))
+                     .Stmts,
+                     0),
+               parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
