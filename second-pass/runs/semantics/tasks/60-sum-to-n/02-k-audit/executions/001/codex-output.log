diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..9bd44f2665e51f49ebd07566a5f5e9a98273fa3b
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,37 @@
+requires "verification.k"
+
+module SUM-TO-N-SPEC-VACUITY
+  imports SUM-TO-N-VERIFICATION
+
+  // Fresh false postcondition: the real result is triangular(N), not +1.
+  // N = 0 satisfies the precondition and witnesses 0 =/= 1.
+  claim
+    <k> #runSumToN(N) => triangular(N) +Int 1 </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+               "sum_to_n"
+               |-> closureVal(
+                     "n",
+                     Return(
+                       BinOp(
+                         "//",
+                         BinOp("*", Name("n"), BinOp("+", Name("n"), Int(1))),
+                         Int(2)))
+                     .Stmts,
+                     0),
+               parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
