+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf '%s\n' '----- OUTPUT -----'
+} >"$log_path"
+
+"$@" >>"$log_path" 2>&1
+command_status=$?
+
+{
