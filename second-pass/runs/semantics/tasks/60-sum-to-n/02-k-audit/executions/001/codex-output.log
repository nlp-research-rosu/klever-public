+                     Return(
+                       BinOp(
+                         "//",
+                         BinOp("*", Name("n"), BinOp("+", Name("n"), Int(1))),
+                         Int(2)))
+                     .Stmts,
+                     0),
+               parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
