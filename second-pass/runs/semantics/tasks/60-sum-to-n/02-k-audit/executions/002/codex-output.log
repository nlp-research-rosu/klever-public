     9	    => #loadAll(
    10	         Module(
    11	           FuncDef(
    12	             "sum_to_n",
    13	             Params("n"),
    14	             Return(
    15	               BinOp(
    16	                 "//",
    17	                 BinOp("*", Name("n"), BinOp("+", Name("n"), Int(1))),
    18	                 Int(2))))))
