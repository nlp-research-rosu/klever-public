+  printf '[exit %d]\n\n' "$rc"
+  return 0
+}
+
+check_sha() {
+  local expected="$1"
+  local path="$2"
+  local actual
+  printf '$ sha256sum %q\n' "$path"
+  actual="$(sha256sum "$path" | awk '{print $1}')"
+  printf '%s  %s\n' "$actual" "$path"
+  if [[ "$actual" == "$expected" ]]; then
