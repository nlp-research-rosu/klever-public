+rc=$?
+printf '[exit %d]\n\n' "$rc"
+
+printf '$ cmp -s solution.regenerated.mpy solution.mpy\n'
+cmp -s solution.regenerated.mpy solution.mpy
+rc=$?
+printf '[exit %d]\n' "$rc"
+if (( rc == 0 )); then
+  printf 'BYTE_IDENTICAL\n\n'
+else
