+run bash -c 'for f in reference-semantics/semantics.k reference-semantics/semantics/*.k verification.k spec.k; do printf "%s " "$f"; rg -c "^[[:space:]]*(syntax|rule|claim|configuration|context|alias)\\b" "$f"; done'

