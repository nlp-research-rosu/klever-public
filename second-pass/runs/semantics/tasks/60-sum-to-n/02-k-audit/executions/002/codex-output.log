    20	
    21	  // Mathematical triangular number.  This spells floor division exactly as
    22	  // the supplied Python semantics does.  For N >= 0, N * (N + 1) is even, so
    23	  // this is the standard N * (N + 1) / 2 closed form.
    24	  syntax Int ::= triangular(Int) [function, total]
