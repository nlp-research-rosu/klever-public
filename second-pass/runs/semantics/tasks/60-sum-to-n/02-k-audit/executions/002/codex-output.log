+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /tmp/audit-work/reconstruction || exit 99
+
+printf 'Witness: N=2. Mutated body computes 2*(2+2)//2=4; required triangular(2)=3.\n\n'
+
+printf '$ kompile verification-body-mutation.k --backend haskell --main-module SUM-TO-N-BODY-MUTATION --syntax-module MPY-SYNTAX --output-definition body-mutation-kompiled\n'
+kompile verification-body-mutation.k \
+  --backend haskell \
+  --main-module SUM-TO-N-BODY-MUTATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition body-mutation-kompiled
+rc=$?
+printf '[exit %d]\n\n' "$rc"
+
+printf '$ kprove spec-body-mutation.k --definition body-mutation-kompiled --spec-module SUM-TO-N-BODY-MUTATION-SPEC\n'
+kprove spec-body-mutation.k \
+  --definition body-mutation-kompiled \
+  --spec-module SUM-TO-N-BODY-MUTATION-SPEC
+rc=$?
+printf '[exit %d]\n' "$rc"

exec
/bin/bash -lc 'bash /audit-output/evidence/run_body_mutation.sh > /audit-output/evidence/body_mutation.log 2>&1; body_rc=$?; printf '"'[outer exit %d]\\n' \""'$body_rc" >> /audit-output/evidence/body_mutation.log; tail -100 /audit-output/evidence/body_mutation.log' in /audit-output
diff --git a//tmp/audit-work/reconstruction/spec-body-mutation.k b//tmp/audit-work/reconstruction/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..7008fddda302fe43f8d347db79319e06ad9b3a6e
--- /dev/null
+++ b//tmp/audit-work/reconstruction/spec-body-mutation.k
@@ -0,0 +1,35 @@
+requires "verification-body-mutation.k"
+
+module SUM-TO-N-BODY-MUTATION-SPEC
+  imports SUM-TO-N-BODY-MUTATION
+
+  claim
+    <k> #runSumToNBodyMut(N) => triangularBodyMut(N) </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+               "sum_to_n"
+               |-> closureVal(
+                     "n",
+                     Return(
+                       BinOp(
+                         "//",
+                         BinOp("*", Name("n"), BinOp("+", Name("n"), Int(2))),
+                         Int(2)))
+                     .Stmts,
+                     0),
+               parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
diff --git a//tmp/audit-work/reconstruction/verification-body-mutation.k b//tmp/audit-work/reconstruction/verification-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..43ec9638b5feb134787d9d77c1a4aa23dbffc3bd
--- /dev/null
+++ b//tmp/audit-work/reconstruction/verification-body-mutation.k
@@ -0,0 +1,24 @@
+requires "reference-semantics/semantics.k"
+
+module SUM-TO-N-BODY-MUTATION
+  imports MPY
+
+  // Materially changed executed body: n * (n + 2) // 2.
+  syntax KItem ::= "#runSumToNBodyMut" "(" Int ")"
+  rule #runSumToNBodyMut(N:Int)
+    => #loadAll(
+         Module(
+           FuncDef(
+             "sum_to_n",
+             Params("n"),
+             Return(
+               BinOp(
+                 "//",
+                 BinOp("*", Name("n"), BinOp("+", Name("n"), Int(2))),
+                 Int(2))))))
+       ~> Call(Name("sum_to_n"), Int(N), .Exprs)
+
+  syntax Int ::= triangularBodyMut(Int) [function, total]
+  rule triangularBodyMut(N:Int)
+    => (N *Int (N +Int 1) -Int pyMod(N *Int (N +Int 1), 2)) /Int 2
+endmodule
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..6dbd3d170f769e59feb73c657a4c95007c5772f0
