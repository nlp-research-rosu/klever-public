diff --git a//tmp/audit-work/reconstruction/verification-body-mutation.k b//tmp/audit-work/reconstruction/verification-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..43ec9638b5feb134787d9d77c1a4aa23dbffc3bd
--- /dev/null
+++ b//tmp/audit-work/reconstruction/verification-body-mutation.k
@@ -0,0 +1,24 @@
+requires "reference-semantics/semantics.k"
+
+module SUM-TO-N-BODY-MUTATION
+  imports MPY
+
+  // Materially changed executed body: n * (n + 2) // 2.
+  syntax KItem ::= "#runSumToNBodyMut" "(" Int ")"
+  rule #runSumToNBodyMut(N:Int)
+    => #loadAll(
+         Module(
+           FuncDef(
+             "sum_to_n",
+             Params("n"),
+             Return(
+               BinOp(
+                 "//",
+                 BinOp("*", Name("n"), BinOp("+", Name("n"), Int(2))),
+                 Int(2))))))
+       ~> Call(Name("sum_to_n"), Int(N), .Exprs)
+
+  syntax Int ::= triangularBodyMut(Int) [function, total]
+  rule triangularBodyMut(N:Int)
+    => (N *Int (N +Int 1) -Int pyMod(N *Int (N +Int 1), 2)) /Int 2
+endmodule
