+run python3 -c 'import json,sys; a=json.load(open("/audit-input.json")); b=json.load(open("/audit-campaign-lock.json")); print("MATCH" if a["audit_campaign"] == b else "MISMATCH"); sys.exit(0 if a["audit_campaign"] == b else 1)'
