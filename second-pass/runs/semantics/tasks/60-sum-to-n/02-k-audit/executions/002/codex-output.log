+  diff -u solution.mpy solution.regenerated.mpy
+  printf '\n'
+fi
+
+printf '$ python3 /audit-output/evidence/differential_test.py\n'
+python3 /audit-output/evidence/differential_test.py
+rc=$?
+printf '[exit %d]\n' "$rc"
