+
+  claim
+    <k> #runSumToN(N) => triangular(N) </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+               "sum_to_n"
+               |-> closureVal(
+                     "n",
+                     Return(
+                       BinOp(
+                         "//",
+                         BinOp("*", Name("n"), BinOp("+", Name("n"), Int(1))),
+                         Int(2)))
+                     .Stmts,
+                     0),
+               parent(-1))
+      -1 |-> builtinsScope
