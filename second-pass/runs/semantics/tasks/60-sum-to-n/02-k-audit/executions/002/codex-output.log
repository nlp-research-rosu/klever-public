+        ch = text[i]
+        if in_comment:
+            if ch == "\n":
+                in_comment = False
+            i += 1
+            continue
+        if quoted:
+            out.append(ch)
+            if escaped:
+                escaped = False
+            elif ch == "\\":
+                escaped = True
+            elif ch == '"':
+                quoted = False
+        elif ch == "/" and i + 1 < len(text) and text[i + 1] == "/":
+            in_comment = True
+            i += 1
+        elif ch == '"':
+            quoted = True
+            out.append(ch)
+        elif not ch.isspace():
+            out.append(ch)
+        i += 1
+    return "".join(out)
+
+
+def balanced_argument(text: str, marker: str) -> str:
+    start = text.index(marker) + len(marker)
+    depth = 1
+    quoted = False
+    escaped = False
+    for i in range(start, len(text)):
+        ch = text[i]
+        if quoted:
+            if escaped:
+                escaped = False
+            elif ch == "\\":
+                escaped = True
+            elif ch == '"':
+                quoted = False
+        elif ch == '"':
+            quoted = True
+        elif ch == "(":
+            depth += 1
+        elif ch == ")":
+            depth -= 1
+            if depth == 0:
+                return text[start:i]
+    raise ValueError(f"unbalanced marker {marker!r}")
+
+
+submitted = compact_k((ROOT / "solution.mpy").read_text())
+verification = compact_k((ROOT / "verification.k").read_text())
+executed_module = balanced_argument(verification, "#loadAll(")
+pin_ok = submitted == executed_module
