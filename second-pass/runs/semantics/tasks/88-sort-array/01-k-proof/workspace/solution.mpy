Module(
  FuncDef("sort_array", Params("array"),
    If(UnaryOp("not", Name("array")),
      Return(ListExpr()),
      )
    If(Compare(
      BinOp(
        "%",
        BinOp(
          "+",
          Subscript(Name("array"), Int(0)),
          Subscript(Name("array"), UnaryOp("-", Int(1)))),
        Int(2)),
      CmpOp("==", Int(1))),
      Return(Call(Name("sorted"), Name("array"))),
      )
    Return(
      Call(Name("sorted"), Name("array"), KwArg("reverse", Bool(true))))))
