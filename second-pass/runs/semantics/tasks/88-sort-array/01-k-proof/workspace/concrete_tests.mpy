Module(
  FuncDef("sort_array", Params("array"),
    If(UnaryOp("not", Name("array")),
      Return(ListExpr()),
      )
    If(Compare(
      BinOp(
        "%",
        BinOp(
          "+",
          Subscript(Name("array"), Int(0)),
          Subscript(Name("array"), UnaryOp("-", Int(1)))),
        Int(2)),
      CmpOp("==", Int(1))),
      Return(Call(Name("sorted"), Name("array"))),
      )
    Return(
      Call(Name("sorted"), Name("array"), KwArg("reverse", Bool(true)))))
  Assert(
    Compare(
      Call(Name("sort_array"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("sort_array"), ListExpr(Int(5))),
      CmpOp("==", ListExpr(Int(5)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(Int(2), Int(4), Int(3), Int(0), Int(1), Int(5))),
      CmpOp(
        "==",
        ListExpr(Int(0), Int(1), Int(2), Int(3), Int(4), Int(5)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(Int(2), Int(4), Int(3), Int(0), Int(1), Int(5), Int(6))),
      CmpOp(
        "==",
        ListExpr(Int(6), Int(5), Int(4), Int(3), Int(2), Int(1), Int(0)))))
  Assign(
    Name("original"),
    ListExpr(Int(2), Int(4), Int(3), Int(0), Int(1), Int(5)))
  Assign(Name("result"), Call(Name("sort_array"), Name("original")))
  Assert(
    Compare(
      Name("original"),
      CmpOp(
        "==",
        ListExpr(Int(2), Int(4), Int(3), Int(0), Int(1), Int(5)))))
  Assert(
    Compare(
      Name("result"),
      CmpOp(
        "==",
        ListExpr(Int(0), Int(1), Int(2), Int(3), Int(4), Int(5))))))
