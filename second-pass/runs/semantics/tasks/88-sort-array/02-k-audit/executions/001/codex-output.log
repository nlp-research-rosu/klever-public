     1	def sort_array(array):
     2	    if not array:
     3	        return []
     4	    if (array[0] + array[-1]) % 2 == 1:
     5	        return sorted(array)
     6	    return sorted(array, reverse=True)
     7	
     8	
     9	assert sort_array([]) == []
    10	assert sort_array([5]) == [5]
    11	assert sort_array([2, 4, 3, 0, 1, 5]) == [0, 1, 2, 3, 4, 5]
    12	assert sort_array([2, 4, 3, 0, 1, 5, 6]) == [6, 5, 4, 3, 2, 1, 0]
    13	
    14	original = [2, 4, 3, 0, 1, 5]
    15	result = sort_array(original)
    16	assert original == [2, 4, 3, 0, 1, 5]
    17	assert result == [0, 1, 2, 3, 4, 5]
