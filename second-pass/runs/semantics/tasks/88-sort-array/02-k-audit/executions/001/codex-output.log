+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      0 |-> list(
+        vCons(F:Int, snocVS(intsVS(MIDDLE:IntSeq), L:Int)))
+      =>
+      (0 |-> list(vCons(F, snocVS(intsVS(MIDDLE), L))))
+      (1 |-> list(
+        sortVS(vCons(F, snocVS(intsVS(MIDDLE), L)))))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires F >=Int 0
+      andBool L >=Int 0
+      andBool nonNegativeIS(MIDDLE)
+      andBool pyMod(F +Int L, 2) ==Int 1
+endmodule
