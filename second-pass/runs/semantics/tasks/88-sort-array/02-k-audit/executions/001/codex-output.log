+      (1 |-> list(.ValSeq))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
