+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      0 |-> list(vCons(2, vCons(4, vCons(3, vCons(6, .ValSeq)))))
+      =>
+      (0 |-> list(vCons(2, vCons(4, vCons(3, vCons(6, .ValSeq))))))
+      (1 |-> list(condRev(
+        sortVS(vCons(2, vCons(4, vCons(3, vCons(6, .ValSeq))))),
+        true)))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
