+      =>
+      (0 |-> list(vCons(2, vCons(4, vCons(3, vCons(5, .ValSeq))))))
+      (1 |-> list(sortVS(vCons(2, vCons(4, vCons(3, vCons(5, .ValSeq)))))))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
