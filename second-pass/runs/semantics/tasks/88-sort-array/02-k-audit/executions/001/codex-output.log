+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      0 |-> list(
+        vCons(F:Int, snocVS(intsVS(MIDDLE:IntSeq), L:Int)))
+      =>
