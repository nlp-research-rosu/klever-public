/bin/bash -lc 'for f in semantics/core.k semantics/controls.k semantics/functions.k semantics/call.k semantics/operators.k semantics/bool.k semantics/int.k; do echo "===== $f ====="; nl -ba "/reference/reference-semantics/$f"; done' in /audit-output
