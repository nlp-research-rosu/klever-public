+    <heapLoc> 1 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+    requires F >=Int 0
+      andBool L >=Int 0
+      andBool nonNegativeIS(MIDDLE)
+      andBool pyMod(F +Int L, 2) ==Int 1
+
+  // Even endpoint parity selects descending (reverse of ascending) order.
+  claim
+    <k>
+      Call(Name("sort_array"), (ref(0), .Exprs))
