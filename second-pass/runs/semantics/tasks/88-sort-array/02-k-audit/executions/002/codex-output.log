+      => ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("sort_array" |-> sortArrayClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
