sha256sum /audit-output/evidence/* | sort -k2
rg -n 'SCRIPT_EXIT|INTEGRITY_CHECK|DIFFERENTIAL_TEST|#Top|EXPECTED_PROOF_FAILURE|BRIDGE_FREE_CONNECTION|NONVACUITY|RULE_INVENTORY' /audit-output/evidence/*.log" in /audit-output
