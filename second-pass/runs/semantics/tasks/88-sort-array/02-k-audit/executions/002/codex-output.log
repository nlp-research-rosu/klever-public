+  run "python3 $evidence_dir/differential_test.py" || exit $?
+} 2>&1 | tee "$log_file"
+status=${PIPESTATUS[0]}
+printf 'SCRIPT_EXIT=%d\n' "$status" | tee -a "$log_file"
+exit "$status"
