diff --git a/evidence/spec-labeled.k b/evidence/spec-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..1a30d80c6f4ecb02b07342015bab63b61be2fa81
--- /dev/null
+++ b/evidence/spec-labeled.k
@@ -0,0 +1,115 @@
+requires "verification.k"
+
+module SPEC-LABELED
+  imports VERIFICATION
+
+  claim
+    <k>
+      Call(Name("sort_array"), (ref(0), .Exprs))
+      => ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("sort_array" |-> sortArrayClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      0 |-> list(.ValSeq)
+      =>
+      (0 |-> list(.ValSeq))
+      (1 |-> list(.ValSeq))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(empty)]
+
+  claim
+    <k>
+      Call(Name("sort_array"), (ref(0), .Exprs))
+      => ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("sort_array" |-> sortArrayClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      0 |-> list(vCons(F:Int, .ValSeq))
+      =>
+      (0 |-> list(vCons(F, .ValSeq)))
+      (1 |-> list(condRev(sortVS(vCons(F, .ValSeq)), true)))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires F >=Int 0
+    [label(singleton)]
+
+  claim
+    <k>
+      Call(Name("sort_array"), (ref(0), .Exprs))
+      => ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("sort_array" |-> sortArrayClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      0 |-> list(
+        vCons(F:Int, snocVS(intsVS(MIDDLE:IntSeq), L:Int)))
+      =>
+      (0 |-> list(vCons(F, snocVS(intsVS(MIDDLE), L))))
+      (1 |-> list(
+        sortVS(vCons(F, snocVS(intsVS(MIDDLE), L)))))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires F >=Int 0
+      andBool L >=Int 0
+      andBool nonNegativeIS(MIDDLE)
+      andBool pyMod(F +Int L, 2) ==Int 1
+    [label(odd)]
+
+  claim
+    <k>
+      Call(Name("sort_array"), (ref(0), .Exprs))
+      => ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("sort_array" |-> sortArrayClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      0 |-> list(
+        vCons(F:Int, snocVS(intsVS(MIDDLE:IntSeq), L:Int)))
+      =>
+      (0 |-> list(vCons(F, snocVS(intsVS(MIDDLE), L))))
+      (1 |-> list(condRev(
+        sortVS(vCons(F, snocVS(intsVS(MIDDLE), L))),
+        true)))
+    </heap>
+    <heapLoc> 1 => 2 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires F >=Int 0
+      andBool L >=Int 0
+      andBool nonNegativeIS(MIDDLE)
+      andBool pyMod(F +Int L, 2) ==Int 0
+    [label(even)]
+endmodule
diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..aef8cf2cf5eb07c0f7e64c535c46799c4d0468a5
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,30 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Deliberately false: sort_array([]) returns a fresh empty list, not [99].
+  // The entry precondition is satisfied by the concrete empty input object at 0.
+  claim
+    <k>
+      Call(Name("sort_array"), (ref(0), .Exprs))
+      => ref(1)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("sort_array" |-> sortArrayClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      0 |-> list(.ValSeq)
+      =>
+      (0 |-> list(.ValSeq))
+      (1 |-> list(vCons(99, .ValSeq)))
