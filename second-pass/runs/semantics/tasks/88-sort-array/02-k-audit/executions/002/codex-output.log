+#!/usr/bin/env bash
+set -uo pipefail
+
+evidence_dir=/audit-output/evidence
+scratch_dir=/tmp/audit-work/88-sort-array
+log_file="$evidence_dir/stage1_stage2.log"
+
+run() {
