@@ -0,0 +1,70 @@
+import Proof
+
+namespace AuditBridge
+
+open Proof
+
+def empty : SortValSeq :=
+  SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+
+def intVal (value : Int) : SortVal :=
+  SortVal.inj_SortInt value
+
+def cons (head : SortVal) (tail : SortValSeq) : SortValSeq :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» head tail
+
+example :
+    Proof.«snocVS(_,_)_VERIFICATION_ValSeq_ValSeq_Val» empty (intVal 7)
+      = cons (intVal 7) empty := by
+  rfl
+
+example :
+    Proof.«snocVS(_,_)_VERIFICATION_ValSeq_ValSeq_Val»
+        (cons (intVal 3) empty) (intVal 7)
+      = cons (intVal 3) (cons (intVal 7) empty) := by
+  rfl
+
+example :
+    Proof.«snocVS(_,_)_VERIFICATION_ValSeq_ValSeq_Val»
+        (cons (intVal 3) (cons (intVal 4) empty)) (intVal 7)
+      = cons (intVal 3) (cons (intVal 4) (cons (intVal 7) empty)) := by
+  rfl
+
+example (first last : SortInt) (middle : SortValSeq) :
+    «applyIndex(_,_)_MPY-SUBSCRIPT_Val_Val_Int»
+        (SortVal.inj_SortIterable
+          (SortIterable.«list(_)_MPY-CORE_Iterable_ValSeq»
+            (cons
+              (SortVal.inj_SortInt first)
+              (Proof.«snocVS(_,_)_VERIFICATION_ValSeq_ValSeq_Val»
+                middle (SortVal.inj_SortInt last)))))
+        (-1)
+      = some (SortVal.inj_SortInt last) := by
+  exact applyIndex_list_cons_snoc_last first last middle
+
+-- Counterfactual implementations used to test operational sensitivity.
+def identityMutation (values : SortValSeq) (_last : SortVal) : SortValSeq :=
+  values
+
+def singletonMutation (_values : SortValSeq) (last : SortVal) : SortValSeq :=
+  cons last empty
+
+def prependMutation (values : SortValSeq) (last : SortVal) : SortValSeq :=
+  cons last values
+
+example :
+    identityMutation (cons (intVal 3) empty) (intVal 7)
+      = cons (intVal 3) empty := by
+  rfl
+
+example :
+    singletonMutation (cons (intVal 3) (cons (intVal 4) empty)) (intVal 7)
+      = cons (intVal 7) empty := by
+  rfl
+
+example :
+    prependMutation (cons (intVal 3) empty) (intVal 7)
+      = cons (intVal 7) (cons (intVal 3) empty) := by
+  rfl
+
+end AuditBridge
