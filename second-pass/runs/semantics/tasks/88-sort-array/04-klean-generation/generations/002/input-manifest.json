      "module": "VERIFICATION",
      "normalized_sha256": "263bd15cb4ec361038ce827fc81456896d90f6704755944c2de296883bce1485",
      "rationale": "Expands the named sortArrayBody proof term into the exact translated statement sequence of the submitted function.",
      "source_rule_id": "rule-263bd15cb4ec361038ce827fc81456896d90f6704755944c2de296883bce1485",
      "start_line": 10,
      "text": "  rule sortArrayBody\n    => If(\n         UnaryOp(\"not\", Name(\"array\")),\n         Return(ListExpr(.Exprs)) .Stmts,\n         .Stmts)\n       If(\n         Compare(\n           BinOp(\n             \"%\",\n             BinOp(\n               \"+\",\n               Subscript(Name(\"array\"), Int(0)),\n               Subscript(Name(\"array\"), UnaryOp(\"-\", Int(1)))),\n             Int(2)),\n           CmpOp(\"==\", Int(1))),\n         Return(Call(Name(\"sorted\"), (Name(\"array\"), .Exprs))) .Stmts,\n         .Stmts)\n       Return(\n         Call(\n           Name(\"sorted\"),\n           (Name(\"array\"), KwArg(\"reverse\", Bool(true)), .Exprs)))\n       .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "VERIFICATION",
      "normalized_sha256": "14d4ccfe4563a625070d0aba326cb259d3cdce5e8e8e45d5dbcc3ecbadd201a9",
      "rationale": "Defines the named sortArrayClosure proof value from its parameter list, previously defined body, and module environment.",
      "source_rule_id": "rule-14d4ccfe4563a625070d0aba326cb259d3cdce5e8e8e45d5dbcc3ecbadd201a9",
      "start_line": 34,
      "text": "  rule sortArrayClosure\n    => closureVal((\"array\", .ParamNames), sortArrayBody, 0)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 39,
      "module": "VERIFICATION",
      "normalized_sha256": "0d4c46a7163f5c5ee21b30bb397721cb0628a5455c22404392aa20e5e8d42cb8",
      "rationale": "Provides the empty-case equation for the structural conversion from IntSeq to ValSeq.",
      "source_rule_id": "rule-0d4c46a7163f5c5ee21b30bb397721cb0628a5455c22404392aa20e5e8d42cb8",
      "start_line": 39,
      "text": "  rule intsVS(.IntSeq) => .ValSeq"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 40,
      "module": "VERIFICATION",
      "normalized_sha256": "5d37caabd948d738dd2dcc088a48c04f3cd6d66f0ae83ccf8ee0b133c09faae2",
      "rationale": "Provides the recursive equation for the structural conversion from a nonempty IntSeq to ValSeq.",
      "source_rule_id": "rule-5d37caabd948d738dd2dcc088a48c04f3cd6d66f0ae83ccf8ee0b133c09faae2",
      "start_line": 40,
      "text": "  rule intsVS(iCons(I:Int, IS:IntSeq)) => vCons(I, intsVS(IS))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 43,
      "module": "VERIFICATION",
      "normalized_sha256": "03661db14f885c490255229be7866dfea6edcd71783c1e638ae5d2e6bfabdc91",
      "rationale": "Defines the base case of the nonNegativeIS summary predicate.",
      "source_rule_id": "rule-03661db14f885c490255229be7866dfea6edcd71783c1e638ae5d2e6bfabdc91",
      "start_line": 43,
      "text": "  rule nonNegativeIS(.IntSeq) => true"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 45,
      "module": "VERIFICATION",
      "normalized_sha256": "3ba97f4ae1b69bd9ddfe88cafba9dfe0564e263c89af2db957db5f8b413286b1",
      "rationale": "Defines the recursive case of the nonNegativeIS summary predicate by checking the head and recurring on the tail.",
      "source_rule_id": "rule-3ba97f4ae1b69bd9ddfe88cafba9dfe0564e263c89af2db957db5f8b413286b1",
      "start_line": 44,
      "text": "  rule nonNegativeIS(iCons(I:Int, IS:IntSeq))\n    => I >=Int 0 andBool nonNegativeIS(IS)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 51,
      "module": "VERIFICATION",
      "normalized_sha256": "becebddf142d7576a24cbe9dcc443d2914a5940ec4d344d1d179d0b17c2a8678",
      "rationale": "Defines the base case of snocVS by appending a value to an empty ValSeq.",
      "source_rule_id": "rule-becebddf142d7576a24cbe9dcc443d2914a5940ec4d344d1d179d0b17c2a8678",
      "start_line": 51,
      "text": "  rule snocVS(.ValSeq, V:Val) => vCons(V, .ValSeq)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 53,
      "module": "VERIFICATION",
      "normalized_sha256": "a074558c6e6502d0ec637dab6d4ea3994203ef7eb07051486fef343a035c7b87",
      "rationale": "Defines the recursive case of snocVS by retaining the head and appending through the tail.",
      "source_rule_id": "rule-a074558c6e6502d0ec637dab6d4ea3994203ef7eb07051486fef343a035c7b87",
      "start_line": 52,
      "text": "  rule snocVS(vCons(H:Val, T:ValSeq), V:Val)\n    => vCons(H, snocVS(T, V))"
    }
  ],
