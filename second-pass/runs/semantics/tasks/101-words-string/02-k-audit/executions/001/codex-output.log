+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+        =>
+        "words_string" |->
+          closureVal(
+            ("s", .ParamNames),
+            Return(
+              Call(
+                Attribute(
+                  Call(
+                    Attribute(Name("s"), "replace"),
+                    (Str(","), Str(" "), .Exprs)),
+                  "split"),
+                .Exprs))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
