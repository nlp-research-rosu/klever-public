index 0000000000000000000000000000000000000000..0f4c60e11c66b91693d9d503b4fd8107c4f508aa
--- /dev/null
+++ b/evidence/concrete_reconstruction.py
@@ -0,0 +1,12 @@
+def words_string(s):
+    return s.replace(",", " ").split()
+
+
+assert words_string("Hi, my name is John") == [
+    "Hi", "my", "name", "is", "John"
+]
+assert words_string("") == []
+assert words_string(",") == []
+assert words_string("a,,b") == ["a", "b"]
+assert words_string("  alpha,,beta\tgamma\n") == ["alpha", "beta", "gamma"]
+assert words_string(",a,") == ["a"]
