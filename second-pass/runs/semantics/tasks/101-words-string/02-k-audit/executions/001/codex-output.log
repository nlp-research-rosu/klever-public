diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..a247ce2e01062b0c8d46a21de0f968bd99fd35af
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,34 @@
+requires "verification.k"
+
+module WORDS-STRING-SPEC-VACUITY
+  imports WORDS-STRING-VERIFICATION
+
+  // Fresh false result mutation: prepend an extra "X" token to the required
+  // result. The original precondition is unchanged. For the satisfying witness
+  // CS = .IntSeq (the empty Python string), execution returns [], not ["X"].
+  claim
+    <k>
+      Call(wordsStringFunction, (str(CS), .Exprs))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+        vCons(
+          str(iCons(88, .IntSeq)),
+          wordsStringExpected(CS)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/verification-body-mutation.k b/evidence/verification-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..146f10c3c96ee6c798df8813ea332699c94c5777
--- /dev/null
+++ b/evidence/verification-body-mutation.k
@@ -0,0 +1,26 @@
+requires "reference-semantics/semantics.k"
+
+module WORDS-STRING-VERIFICATION-BODY-MUTATION
+  imports MPY
+
+  // Deliberate operational-sensitivity mutation: commas become "X", while
+  // the postcondition summary below still requires commas to become spaces.
+  syntax Val ::= "wordsStringFunctionBodyMutation" [function]
+  rule wordsStringFunctionBodyMutation =>
+    closureVal(
+      ("s", .ParamNames),
+      Return(
+        Call(
+          Attribute(
+            Call(
+              Attribute(Name("s"), "replace"),
+              (Str(","), Str("X"), .Exprs)),
+            "split"),
+          .Exprs))
+      .Stmts,
+      0)
+
+  syntax ValSeq ::= wordsStringExpectedBodyMutation(IntSeq) [function, total]
+  rule wordsStringExpectedBodyMutation(CS:IntSeq) =>
+    splitWS(replaceC(CS, 44, 32), .IntSeq, .ValSeq)
+endmodule

diff --git a/REVIEW.md b/REVIEW.md
new file mode 100644
index 0000000000000000000000000000000000000000..1a273f2dcd1d2062b3be3c1f30529a074b1d649f
--- /dev/null
+++ b/REVIEW.md
@@ -0,0 +1,556 @@
+# Independent adversarial audit: 101-words-string
+
+This audit used the rendered `SUPPLIED_SEMANTICS` boundary. I treated every
+candidate artifact and prior output as untrusted, copied only source artifacts
+to `/tmp/audit-work`, and rebuilt from source with K 7.1.337. The candidate's
+proof reconstructs successfully and is result-sensitive. I found no
+execution-bypassing or mathematically false proof-local rule. There are,
+however, two non-fatal audit limitations: the entry claim invokes an exact
+literal closure instead of formally loading and looking up the submitted
+top-level module, and the supplied string model recognizes fewer whitespace
+characters than Python `str.split()`. Four requested generation-provenance
+files are also absent.
+
+## 1. Input and provenance integrity
+
