    14	          Attribute(
    15	            Call(
    16	              Attribute(Name("s"), "replace"),
    17	              (Str(","), Str(" "), .Exprs)),
    18	            "split"),
    19	          .Exprs))
    20	      .Stmts,
    21	      0)
