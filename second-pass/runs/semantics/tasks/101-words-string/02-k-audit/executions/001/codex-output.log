     6	  // This is exactly the function body emitted in solution.mpy, represented as
     7	  // a callable value so that a symbolic claim can invoke it with any string.
     8	  syntax Val ::= "wordsStringFunction" [function]
     9	  rule wordsStringFunction =>
    10	    closureVal(
    11	      ("s", .ParamNames),
    12	      Return(
