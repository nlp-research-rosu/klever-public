diff --git a/evidence/spec-ground.k b/evidence/spec-ground.k
new file mode 100644
index 0000000000000000000000000000000000000000..fd76ba3d741b1eaaf7e768af40dc4d95c2b462f7
--- /dev/null
+++ b/evidence/spec-ground.k
@@ -0,0 +1,34 @@
+requires "verification.k"
+
+module WORDS-STRING-SPEC-GROUND
