Module(
  FuncDef("words_string", Params("s"),
    Return(
      Call(
        Attribute(
          Call(Attribute(Name("s"), "replace"), Str(","), Str(" ")),
          "split"),
        )))
  Assert(
    Compare(
      Call(Name("words_string"), Str("a\u000bb")),
      CmpOp("==", ListExpr(Str("a"), Str("b"))))))
