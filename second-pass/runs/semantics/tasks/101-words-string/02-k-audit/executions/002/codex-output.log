index 0000000000000000000000000000000000000000..1f16c7c220efcc53936a79e2690988aa1a50b0cc
--- /dev/null
+++ b//tmp/audit-work/101-words-string-independent-audit/verification-body-mutant.k
@@ -0,0 +1,20 @@
+requires "verification.k"
+
+module WORDS-STRING-BODY-MUTANT
+  imports WORDS-STRING-VERIFICATION
+
+  syntax Val ::= "wordsStringFunctionMutant" [function]
+  rule wordsStringFunctionMutant =>
+    closureVal(
+      ("s", .ParamNames),
+      Return(
+        Call(
+          Attribute(
+            Call(
+              Attribute(Name("s"), "replace"),
+              (Str(","), Str("x"), .Exprs)),
+            "split"),
+          .Exprs))
+      .Stmts,
+      0)
+endmodule
