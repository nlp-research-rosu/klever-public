diff --git a/evidence/concrete_k_cases.mpy b/evidence/concrete_k_cases.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..1780d491ca16d0ece69c2f358e7c579866c03d78
--- /dev/null
+++ b/evidence/concrete_k_cases.mpy
@@ -0,0 +1,35 @@
+Module(
+  FuncDef("words_string", Params("s"),
+    Return(
+      Call(
+        Attribute(
+          Call(Attribute(Name("s"), "replace"), Str(","), Str(" ")),
+          "split"),
+        )))
+  Assert(
+    Compare(
+      Call(Name("words_string"), Str("Hi, my name is John")),
+      CmpOp(
+        "==",
+        ListExpr(
+          Str("Hi"),
+          Str("my"),
+          Str("name"),
+          Str("is"),
+          Str("John")))))
+  Assert(
+    Compare(
+      Call(Name("words_string"), Str("")),
+      CmpOp("==", ListExpr())))
+  Assert(
+    Compare(
+      Call(Name("words_string"), Str(",,,")),
+      CmpOp("==", ListExpr())))
+  Assert(
+    Compare(
+      Call(Name("words_string"), Str(" a,,b \t c\n")),
+      CmpOp("==", ListExpr(Str("a"), Str("b"), Str("c")))))
+  Assert(
+    Compare(
+      Call(Name("words_string"), Str("alpha\u00a0beta")),
+      CmpOp("==", ListExpr(Str("alpha"), Str("beta"))))))
diff --git a/evidence/concrete_k_cases.py b/evidence/concrete_k_cases.py
new file mode 100644
index 0000000000000000000000000000000000000000..4a1e6321a7c247ff8e52128275bd13a6d0e745d2
--- /dev/null
+++ b/evidence/concrete_k_cases.py
@@ -0,0 +1,11 @@
+def words_string(s):
+    return s.replace(",", " ").split()
+
+
+assert words_string("Hi, my name is John") == [
+    "Hi", "my", "name", "is", "John"
+]
+assert words_string("") == []
+assert words_string(",,,") == []
+assert words_string(" a,,b \t c\n") == ["a", "b", "c"]
