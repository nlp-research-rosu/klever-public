+    "generated_ground",
+)
+
+for source, formal_result in [("", []), ("a,b", ["a", "b"])]:
+    oracle = canonical(source)
+    subject = generated(source)
+    assert formal_result == oracle == subject
+    print(
+        f"input={source!r} formal={formal_result!r} "
+        f"canonical={oracle!r} generated={subject!r}"
+    )
