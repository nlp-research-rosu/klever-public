+    <k>
+      Call(
+        wordsStringFunction,
+        (str(iCons(97, iCons(44, iCons(98, .IntSeq)))), .Exprs))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
