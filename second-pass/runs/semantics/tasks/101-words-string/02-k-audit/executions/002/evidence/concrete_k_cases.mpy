Module(
  FuncDef("words_string", Params("s"),
    Return(
      Call(
        Attribute(
          Call(Attribute(Name("s"), "replace"), Str(","), Str(" ")),
          "split"),
        )))
  Assert(
    Compare(
      Call(Name("words_string"), Str("Hi, my name is John")),
      CmpOp(
        "==",
        ListExpr(
          Str("Hi"),
          Str("my"),
          Str("name"),
          Str("is"),
          Str("John")))))
  Assert(
    Compare(
      Call(Name("words_string"), Str("")),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("words_string"), Str(",,,")),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("words_string"), Str(" a,,b \t c\n")),
      CmpOp("==", ListExpr(Str("a"), Str("b"), Str("c")))))
  Assert(
    Compare(
      Call(Name("words_string"), Str("alpha\u00a0beta")),
      CmpOp("==", ListExpr(Str("alpha"), Str("beta"))))))
