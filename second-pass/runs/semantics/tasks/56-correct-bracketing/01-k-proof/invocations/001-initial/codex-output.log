+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> (D:Int => D -Int 1)
+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
+       </scopes>
+       [priority(40)]
+
