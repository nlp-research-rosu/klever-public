diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b37cb2bbf99070baa6d432804eab9d1e2647c0a3
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,128 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive loop invariant at depth zero.  Returning also pops the function
+  // frame, so this claim describes that complete transition.
+  claim [loop-zero]:
+    <k>
+      #loop(str(S:IntSeq), Name("bracket"),
+        If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+          AugAssign(Name("depth"), "+", Int(1)),
+          AugAssign(Name("depth"), "-", Int(1)))
+        If(Compare(Name("depth"), CmpOp("<", Int(0))),
+          Return(Bool(false)),
+          .Stmts))
+      ~> (Return(Compare(Name("depth"), CmpOp("==", Int(0)))) .Stmts)
+      ~> #endcall
+    =>
+      bracketResult(S, 0) ~> CONT
+    </k>
+    <env> L => CALLER </env>
+    <scopes>
+      (L |-> scope(
+          "brackets" |-> str(INPUT:IntSeq)
+          "depth" |-> 0
+          "bracket" |-> OLD:Val,
+          P:Parent)
+       SC:Map)
+    =>
+      SC
+    </scopes>
+    <scopeLoc> _ => SAVED </scopeLoc>
+    <stack>
+      ListItem(frame(CONT:K, CALLER:Int, SAVED:Int)) REST:List => REST
+    </stack>
+    <ret> noRet </ret>
+    requires notBool L in_keys(SC)
+
+  // The positive-depth half of the invariant.  Splitting zero from positive
+  // depth makes the final integer equality decidable on every proof branch.
+  claim [loop-positive]:
+    <k>
+      #loop(str(S:IntSeq), Name("bracket"),
+        If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+          AugAssign(Name("depth"), "+", Int(1)),
+          AugAssign(Name("depth"), "-", Int(1)))
+        If(Compare(Name("depth"), CmpOp("<", Int(0))),
+          Return(Bool(false)),
+          .Stmts))
+      ~> (Return(Compare(Name("depth"), CmpOp("==", Int(0)))) .Stmts)
+      ~> #endcall
+    =>
+      bracketResult(S, D) ~> CONT
+    </k>
+    <env> L => CALLER </env>
+    <scopes>
+      (L |-> scope(
+          "brackets" |-> str(INPUT:IntSeq)
+          "depth" |-> D
+          "bracket" |-> OLD:Val,
+          P:Parent)
+       SC:Map)
+    =>
+      SC
+    </scopes>
+    <scopeLoc> _ => SAVED </scopeLoc>
+    <stack>
+      ListItem(frame(CONT:K, CALLER:Int, SAVED:Int)) REST:List => REST
+    </stack>
+    <ret> noRet </ret>
+    requires D >Int 0
+      andBool notBool L in_keys(SC)
+
+  // The translated implementation, from module loading through its returned
+  // value, agrees with the mathematical bracket predicate for every string.
+  claim [correct-bracketing]:
+    <k>
+      #loadAll(Module(
+        FuncDef("correct_bracketing", Params("brackets"),
+          Expr(
+            Str("Return whether the angle brackets are correctly balanced."))
+          Assign(Name("depth"), Int(0))
+          Assign(Name("bracket"), Str(""))
+          For(Name("bracket"), Name("brackets"),
+            If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+              AugAssign(Name("depth"), "+", Int(1)),
+              AugAssign(Name("depth"), "-", Int(1)))
+            If(Compare(Name("depth"), CmpOp("<", Int(0))),
+              Return(Bool(false)),
+              .Stmts))
+          Return(Compare(Name("depth"), CmpOp("==", Int(0)))))))
+      ~> Call(Name("correct_bracketing"), str(S:IntSeq))
+    =>
+      bracketResult(S, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0 |-> scope(
+        "correct_bracketing" |->
+          closureVal(("brackets", .ParamNames),
+            Expr(
+              Str("Return whether the angle brackets are correctly balanced."))
+            Assign(Name("depth"), Int(0))
+            Assign(Name("bracket"), Str(""))
+            For(Name("bracket"), Name("brackets"),
+              If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+                AugAssign(Name("depth"), "+", Int(1)),
+                AugAssign(Name("depth"), "-", Int(1)))
+              If(Compare(Name("depth"), CmpOp("<", Int(0))),
+                Return(Bool(false)),
+                .Stmts))
+            Return(Compare(Name("depth"), CmpOp("==", Int(0)))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4809ccfe248f7fd1dc87601e37246615f0dc6535
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,169 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical result for the unprocessed suffix when the current nesting
+  // depth is D.  The implementation's else branch treats every non-"<"
+  // character as a close bracket; on the prompt's domain those are exactly
+  // the ">" characters.
+  syntax Bool ::= bracketResult(IntSeq, Int) [function, total]
+
+  rule bracketResult(.IntSeq, 0) => true [simplification]
+  rule bracketResult(.IntSeq, D:Int) => false
+       requires D >Int 0
+       [simplification]
+  rule bracketResult(.IntSeq, D:Int) => false
+       requires D <Int 0
+       [simplification]
+
+  rule bracketResult(iCons(60, REST:IntSeq), 0)
+    => bracketResult(REST, 1)
+       [simplification]
+  rule bracketResult(iCons(C:Int, _REST:IntSeq), 0) => false
+       requires notBool (C ==Int 60)
+       [simplification]
+
+  rule bracketResult(iCons(60, REST:IntSeq), D:Int)
+    => bracketResult(REST, D +Int 1)
+       requires D >Int 0
+  rule bracketResult(iCons(C:Int, REST:IntSeq), D:Int)
+    => bracketResult(REST, D -Int 1)
+       requires notBool (C ==Int 60) andBool D >Int 0
+  rule bracketResult(iCons(_C:Int, _REST:IntSeq), D:Int) => false
+       requires D <Int 0
+       [simplification]
+
+  // Proof-only derived macro steps for this program's two return forms.
+  // The Haskell prover otherwise leaves evaluated Bool values in the strict
+  // Return freezer.  Each rule is the composition of the reference literal /
+  // lookup / comparison rules with MPY-FUNCTIONS' Return rule.
+  rule <k> Return(Bool(B:Bool)) ~> _ => #pop </k>
+       <ret> noRet => retV(B) </ret>
+       [priority(40)]
+
+  rule <k>
+         Return(Compare(Name("depth"), CmpOp("==", Int(0)))) ~> _
+       =>
+         #pop
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> D:Int
+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
+       </scopes>
+       <ret> noRet => retV(D ==Int 0) </ret>
+       [priority(40)]
+
+  rule <k>
+         If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+            THEN:Stmts, ELSE:Stmts)
+       =>
+         #branch(true, THEN, ELSE)
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> _D:Int
+           "bracket" |-> str(iCons(C:Int, .IntSeq)),
+           _PARENT:Parent) ...
+       </scopes>
+       requires C ==Int 60
+       [priority(40)]
+
+  rule <k>
+         If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+            THEN:Stmts, ELSE:Stmts)
+       =>
+         #branch(false, THEN, ELSE)
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> _D:Int
+           "bracket" |-> str(iCons(C:Int, .IntSeq)),
+           _PARENT:Parent) ...
+       </scopes>
+       requires C =/=Int 60
+       [priority(40)]
+
+  rule <k>
+         AugAssign(Name("depth"), "+", Int(1)) => .K
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> (D:Int => D +Int 1)
+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
+       </scopes>
+       [priority(40)]
+
+  rule <k>
+         AugAssign(Name("depth"), "-", Int(1)) => .K
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> (D:Int => D -Int 1)
+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
+       </scopes>
+       [priority(40)]
+
+  rule <k>
+         If(Compare(Name("depth"), CmpOp("<", Int(0))),
+            THEN:Stmts, ELSE:Stmts)
+       =>
+         #branch(true, THEN, ELSE)
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> D:Int
+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
+       </scopes>
+       requires D <Int 0
+       [priority(40)]
+
+  rule <k>
+         If(Compare(Name("depth"), CmpOp("<", Int(0))),
+            THEN:Stmts, ELSE:Stmts)
+       =>
+         #branch(false, THEN, ELSE)
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> D:Int
+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
+       </scopes>
+       requires D >=Int 0
+       [priority(40)]
+
+  // Normal form of MPY-FUNCTIONS' #pop rule when the callee location is known
+  // fresh in the rest of the scope map.  This removes the symbolic
+  // `MAP [ L <- undef ]` update that the backend intentionally does not
+  // normalize on its own.
+  rule <k> #pop => V ~> CONT </k>
+       <ret> retV(V:Val) => noRet </ret>
+       <stack>
+         ListItem(frame(CONT:K, CALLER:Int, SAVED:Int)) REST:List => REST
+       </stack>
+       <env> L:Int => CALLER </env>
+       <scopes> (L |-> _FRAME:Scope SC:Map) => SC </scopes>
+       <scopeLoc> _ => SAVED </scopeLoc>
+       requires notBool L in_keys(SC)
+       [priority(40)]
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..d14028a26508342fe0c9347b707ce98ff7c55d6c
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,22 @@
+def correct_bracketing(brackets: str):
+    """Return whether the angle brackets are correctly balanced."""
+    depth = 0
+    bracket = ""
+    for bracket in brackets:
+        if bracket == "<":
+            depth += 1
+        else:
+            depth -= 1
+        if depth < 0:
+            return False
+    return depth == 0
+
+
+assert correct_bracketing("<") == False
+assert correct_bracketing("<>") == True
+assert correct_bracketing("<<><>>") == True
+assert correct_bracketing("><<>") == False
+assert correct_bracketing("") == True
+assert correct_bracketing("<<>>") == True
+assert correct_bracketing("<><>") == True
+assert correct_bracketing("<<>") == False
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..56dc9731aa112760c6fcae8ca094569c1764ca22
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,30 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+# Translate the submitted implementation and the concrete assertion harness.
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+
+# Concrete execution under the required LLVM main and syntax modules.
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun concrete_tests.mpy \
+  --definition runtime-kompiled \
+  --output pretty
+
+# Symbolic definition and the single positive command proving every claim.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.loop-zero,SPEC.loop-positive,SPEC.correct-bracketing \
+  --output pretty
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..b58a786fcd714bb65530d88988bfdd3a5b3a8a92
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def correct_bracketing(brackets: str):
+    """Return whether the angle brackets are correctly balanced."""
+    depth = 0
+    bracket = ""
+    for bracket in brackets:
+        if bracket == "<":
+            depth += 1
+        else:
+            depth -= 1
+        if depth < 0:
+            return False
+    return depth == 0
