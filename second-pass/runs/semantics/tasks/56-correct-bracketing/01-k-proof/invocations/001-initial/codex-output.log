--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def correct_bracketing(brackets: str):
+    """Return whether the angle brackets are correctly balanced."""
+    depth = 0
+    bracket = ""
+    for bracket in brackets:
+        if bracket == "<":
+            depth += 1
+        else:
+            depth -= 1
+        if depth < 0:
+            return False
+    return depth == 0
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..d33f35f81c78905744b5f3a6c1cf9eb4cf3c46e8
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,128 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive loop invariant at depth zero.  Returning also pops the function
+  // frame, so this claim describes that complete transition.
+  claim [loop-zero]:
+    <k>
+      #loop(str(S:IntSeq), Name("bracket"),
+        If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+          AugAssign(Name("depth"), "+", Int(1)),
+          AugAssign(Name("depth"), "-", Int(1)))
+        If(Compare(Name("depth"), CmpOp("<", Int(0))),
+          Return(Bool(false)),
+          .Stmts))
+      ~> Return(Compare(Name("depth"), CmpOp("==", Int(0))))
+      ~> #endcall
+    =>
+      bracketResult(S, 0) ~> CONT
+    </k>
+    <env> L => CALLER </env>
+    <scopes>
+      (L |-> scope(
+          "brackets" |-> str(INPUT:IntSeq)
+          "depth" |-> 0
+          "bracket" |-> OLD:Val,
+          P:Parent)
+       SC:Map)
+    =>
+      SC
+    </scopes>
+    <scopeLoc> _ => SAVED </scopeLoc>
+    <stack>
+      ListItem(frame(CONT:K, CALLER:Int, SAVED:Int)) REST:List => REST
+    </stack>
+    <ret> noRet </ret>
+    requires notBool L in_keys(SC)
+
+  // The positive-depth half of the invariant.  Splitting zero from positive
+  // depth makes the final integer equality decidable on every proof branch.
+  claim [loop-positive]:
+    <k>
+      #loop(str(S:IntSeq), Name("bracket"),
+        If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+          AugAssign(Name("depth"), "+", Int(1)),
+          AugAssign(Name("depth"), "-", Int(1)))
+        If(Compare(Name("depth"), CmpOp("<", Int(0))),
+          Return(Bool(false)),
+          .Stmts))
+      ~> Return(Compare(Name("depth"), CmpOp("==", Int(0))))
+      ~> #endcall
+    =>
+      bracketResult(S, D) ~> CONT
+    </k>
+    <env> L => CALLER </env>
+    <scopes>
+      (L |-> scope(
+          "brackets" |-> str(INPUT:IntSeq)
+          "depth" |-> D
+          "bracket" |-> OLD:Val,
+          P:Parent)
+       SC:Map)
+    =>
+      SC
+    </scopes>
+    <scopeLoc> _ => SAVED </scopeLoc>
+    <stack>
+      ListItem(frame(CONT:K, CALLER:Int, SAVED:Int)) REST:List => REST
+    </stack>
+    <ret> noRet </ret>
+    requires D >Int 0
+      andBool notBool L in_keys(SC)
+
+  // The translated implementation, from module loading through its returned
+  // value, agrees with the mathematical bracket predicate for every string.
+  claim [correct-bracketing]:
+    <k>
+      #loadAll(Module(
+        FuncDef("correct_bracketing", Params("brackets"),
+          Expr(
+            Str("Return whether the angle brackets are correctly balanced."))
+          Assign(Name("depth"), Int(0))
+          Assign(Name("bracket"), Str(""))
+          For(Name("bracket"), Name("brackets"),
+            If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+              AugAssign(Name("depth"), "+", Int(1)),
+              AugAssign(Name("depth"), "-", Int(1)))
+            If(Compare(Name("depth"), CmpOp("<", Int(0))),
+              Return(Bool(false)),
+              .Stmts))
+          Return(Compare(Name("depth"), CmpOp("==", Int(0)))))))
+      ~> Call(Name("correct_bracketing"), str(S:IntSeq))
+    =>
+      bracketResult(S, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0 |-> scope(
+        "correct_bracketing" |->
+          closureVal(("brackets", .ParamNames),
+            Expr(
+              Str("Return whether the angle brackets are correctly balanced."))
+            Assign(Name("depth"), Int(0))
+            Assign(Name("bracket"), Str(""))
+            For(Name("bracket"), Name("brackets"),
+              If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+                AugAssign(Name("depth"), "+", Int(1)),
+                AugAssign(Name("depth"), "-", Int(1)))
+              If(Compare(Name("depth"), CmpOp("<", Int(0))),
+                Return(Bool(false)),
+                .Stmts))
+            Return(Compare(Name("depth"), CmpOp("==", Int(0)))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a704b7f6bf9e5f606589f8702a074349ca766ff2
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,161 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical result for the unprocessed suffix when the current nesting
+  // depth is D.  The implementation's else branch treats every non-"<"
+  // character as a close bracket; on the prompt's domain those are exactly
+  // the ">" characters.
+  syntax Bool ::= bracketResult(IntSeq, Int) [function]
+
+  rule bracketResult(.IntSeq, 0) => true
+  rule bracketResult(.IntSeq, D:Int) => false
+       requires D >Int 0
+
+  rule bracketResult(iCons(60, REST:IntSeq), 0)
+    => bracketResult(REST, 1)
+  rule bracketResult(iCons(_C:Int, _REST:IntSeq), 0) => false
+       [owise]
+
+  rule bracketResult(iCons(60, REST:IntSeq), D:Int)
+    => bracketResult(REST, D +Int 1)
+       requires D >Int 0
+  rule bracketResult(iCons(_C:Int, REST:IntSeq), D:Int)
+    => bracketResult(REST, D -Int 1)
+       requires D >Int 0
+       [owise]
+
+  // Proof-only derived macro steps for this program's two return forms.
+  // The Haskell prover otherwise leaves evaluated Bool values in the strict
+  // Return freezer.  Each rule is the composition of the reference literal /
+  // lookup / comparison rules with MPY-FUNCTIONS' Return rule.
+  rule <k> Return(Bool(B:Bool)) ~> _ => #pop </k>
+       <ret> noRet => retV(B) </ret>
+       [priority(40)]
+
+  rule <k>
+         Return(Compare(Name("depth"), CmpOp("==", Int(0)))) ~> _
+       =>
+         #pop
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> D:Int
+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
+       </scopes>
+       <ret> noRet => retV(D ==Int 0) </ret>
+       [priority(40)]
+
+  rule <k>
+         If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+            THEN:Stmts, ELSE:Stmts)
+       =>
+         #branch(true, THEN, ELSE)
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> _D:Int
+           "bracket" |-> str(iCons(C:Int, .IntSeq)),
+           _PARENT:Parent) ...
+       </scopes>
+       requires C ==Int 60
+       [priority(40)]
+
+  rule <k>
+         If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+            THEN:Stmts, ELSE:Stmts)
+       =>
+         #branch(false, THEN, ELSE)
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> _D:Int
+           "bracket" |-> str(iCons(C:Int, .IntSeq)),
+           _PARENT:Parent) ...
+       </scopes>
+       requires C =/=Int 60
+       [priority(40)]
+
+  rule <k>
+         AugAssign(Name("depth"), "+", Int(1)) => .K
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> (D:Int => D +Int 1)
+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
+       </scopes>
+       [priority(40)]
+
+  rule <k>
+         AugAssign(Name("depth"), "-", Int(1)) => .K
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> (D:Int => D -Int 1)
+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
+       </scopes>
+       [priority(40)]
+
+  rule <k>
+         If(Compare(Name("depth"), CmpOp("<", Int(0))),
+            THEN:Stmts, ELSE:Stmts)
+       =>
+         #branch(true, THEN, ELSE)
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> D:Int
+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
+       </scopes>
+       requires D <Int 0
+       [priority(40)]
+
+  rule <k>
+         If(Compare(Name("depth"), CmpOp("<", Int(0))),
+            THEN:Stmts, ELSE:Stmts)
+       =>
+         #branch(false, THEN, ELSE)
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> D:Int
+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
+       </scopes>
+       requires D >=Int 0
+       [priority(40)]
+
+  // Normal form of MPY-FUNCTIONS' #pop rule when the callee location is known
+  // fresh in the rest of the scope map.  This removes the symbolic
+  // `MAP [ L <- undef ]` update that the backend intentionally does not
+  // normalize on its own.
+  rule <k> #pop => V ~> CONT </k>
+       <ret> retV(V:Val) => noRet </ret>
+       <stack>
+         ListItem(frame(CONT:K, CALLER:Int, SAVED:Int)) REST:List => REST
+       </stack>
+       <env> L:Int => CALLER </env>
+       <scopes> (L |-> _FRAME:Scope SC:Map) => SC </scopes>
+       <scopeLoc> _ => SAVED </scopeLoc>
+       requires notBool L in_keys(SC)
+       [priority(40)]
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC --output pretty' in /work
