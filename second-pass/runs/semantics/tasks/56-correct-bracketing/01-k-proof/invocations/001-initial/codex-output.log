+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> (D:Int => D +Int 1)
+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
+       </scopes>
+       [priority(40)]
+
+  rule <k>
+         AugAssign(Name("depth"), "-", Int(1)) => .K
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> (D:Int => D -Int 1)
+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
+       </scopes>
+       [priority(40)]
+
+  rule <k>
+         If(Compare(Name("depth"), CmpOp("<", Int(0))),
+            THEN:Stmts, ELSE:Stmts)
+       =>
+         #branch(true, THEN, ELSE)
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> D:Int
+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
+       </scopes>
+       requires D <Int 0
+       [priority(40)]
+
+  rule <k>
+         If(Compare(Name("depth"), CmpOp("<", Int(0))),
+            THEN:Stmts, ELSE:Stmts)
+       =>
+         #branch(false, THEN, ELSE)
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> D:Int
+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
