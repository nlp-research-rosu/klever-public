+          Return(Bool(false)),
+          .Stmts))
+      ~> Return(Compare(Name("depth"), CmpOp("==", Int(0))))
+      ~> #endcall
+    =>
+      bracketResult(S, D) ~> CONT
+    </k>
+    <env> L => CALLER </env>
+    <scopes>
+      (L |-> scope(
+          "brackets" |-> str(INPUT:IntSeq)
+          "depth" |-> D
+          "bracket" |-> OLD:Val,
+          P:Parent)
+       SC:Map)
+    =>
