diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..fc9772ed6f4280e8b7109ed2bfcfd635daea1e50
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def correct_bracketing(brackets: str):
+    """Return whether the angle brackets are correctly balanced."""
+    depth = 0
+    for bracket in brackets:
+        if bracket == "<":
+            depth += 1
+        else:
+            depth -= 1
+        if depth < 0:
+            return False
+    return depth == 0
