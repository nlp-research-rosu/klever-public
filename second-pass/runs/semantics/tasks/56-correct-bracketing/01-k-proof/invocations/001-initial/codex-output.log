+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0 |-> scope(
+        "correct_bracketing" |->
+          closureVal(("brackets", .ParamNames),
+            Expr(
