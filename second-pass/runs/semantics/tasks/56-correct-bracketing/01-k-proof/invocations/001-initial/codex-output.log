The structural oracle is now simplifying under path conditions, and `kprove` has advanced past the earlier stuck branches. The current full proof is still running; I’m letting it complete before changing anything further.
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..b58a786fcd714bb65530d88988bfdd3a5b3a8a92
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def correct_bracketing(brackets: str):
+    """Return whether the angle brackets are correctly balanced."""
+    depth = 0
+    bracket = ""
+    for bracket in brackets:
+        if bracket == "<":
+            depth += 1
+        else:
+            depth -= 1
+        if depth < 0:
+            return False
+    return depth == 0
