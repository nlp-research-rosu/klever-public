diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b0f4774a51d2d8a5cf4d26ac198cc72d6bc9e0ad
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,86 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive loop invariant.  At nesting depth D, executing the remaining
+  // string suffix S returns exactly bracketResult(S, D).  Returning also pops
+  // the function frame, so this claim describes that complete transition.
+  claim [loop-invariant]:
+    <k>
+      #loop(str(S:IntSeq), Name("bracket"),
+        If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+          AugAssign(Name("depth"), "+", Int(1)),
+          AugAssign(Name("depth"), "-", Int(1)))
+        If(Compare(Name("depth"), CmpOp("<", Int(0))),
+          Return(Bool(false)),
+          .Stmts))
+      ~> Return(Compare(Name("depth"), CmpOp("==", Int(0))))
+      ~> #endcall
+    =>
+      bracketResult(S, D) ~> CONT
+    </k>
+    <env> L => CALLER </env>
+    <scopes>
+      ... L |-> scope(("depth" |-> D) M:Map, P:Parent) => .Map ...
+    </scopes>
+    <scopeLoc> _ => SAVED </scopeLoc>
+    <stack>
+      ListItem(frame(CONT:K, CALLER:Int, SAVED:Int)) REST:List => REST
+    </stack>
+    <ret> noRet </ret>
+    requires D >=Int 0
+      andBool notBool ("depth" in_keys(M))
+
+  // The translated implementation, from module loading through its returned
+  // value, agrees with the mathematical bracket predicate for every string.
+  claim [correct-bracketing]:
+    <k>
+      #loadAll(Module(
+        FuncDef("correct_bracketing", Params("brackets"),
+          Expr(
+            Str("Return whether the angle brackets are correctly balanced."))
+          Assign(Name("depth"), Int(0))
+          For(Name("bracket"), Name("brackets"),
+            If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+              AugAssign(Name("depth"), "+", Int(1)),
+              AugAssign(Name("depth"), "-", Int(1)))
+            If(Compare(Name("depth"), CmpOp("<", Int(0))),
+              Return(Bool(false)),
+              .Stmts))
+          Return(Compare(Name("depth"), CmpOp("==", Int(0))))))
+      ~> Call(Name("correct_bracketing"), str(S:IntSeq))
+    =>
+      bracketResult(S, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0 |-> scope(
+        "correct_bracketing" |->
+          closureVal(("brackets", .ParamNames),
+            Expr(
+              Str("Return whether the angle brackets are correctly balanced."))
+            Assign(Name("depth"), Int(0))
+            For(Name("bracket"), Name("brackets"),
+              If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
+                AugAssign(Name("depth"), "+", Int(1)),
+                AugAssign(Name("depth"), "-", Int(1)))
+              If(Compare(Name("depth"), CmpOp("<", Int(0))),
+                Return(Bool(false)),
+                .Stmts))
+            Return(Compare(Name("depth"), CmpOp("==", Int(0))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..9faf0f653200c9345a19c1a6dbcefae609b637de
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,25 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical result for the unprocessed suffix when the current nesting
+  // depth is D.  The implementation's else branch treats every non-"<"
+  // character as a close bracket; on the prompt's domain those are exactly
+  // the ">" characters.
+  syntax Bool ::= bracketResult(IntSeq, Int) [function]
+
+  rule bracketResult(.IntSeq, D:Int) => D ==Int 0
+       requires D >=Int 0
+
+  rule bracketResult(iCons(C:Int, REST:IntSeq), D:Int)
+    => bracketResult(REST, D +Int 1)
+       requires C ==Int 60 andBool D >=Int 0
+
+  rule bracketResult(iCons(C:Int, _REST:IntSeq), 0) => false
+       requires C =/=Int 60
+
+  rule bracketResult(iCons(C:Int, REST:IntSeq), D:Int)
+    => bracketResult(REST, D -Int 1)
+       requires C =/=Int 60 andBool D >Int 0
+endmodule

