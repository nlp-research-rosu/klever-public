+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
+       </scopes>
+       [priority(40)]
+
+  rule <k>
+         AugAssign(Name("depth"), "-", Int(1)) => .K
+       ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           "brackets" |-> _BRACKETS:Val
+           "depth" |-> (D:Int => D -Int 1)
+           "bracket" |-> _BRACKET:Val,
+           _PARENT:Parent) ...
+       </scopes>
+       [priority(40)]
