mework.definition.Production":{"node":"KProduction","klabel":{"node":"KLabel","name":"#ruleRequires","params":[]},"productionItems":[{"node":"KNonTerminal","sort":{"node":"KSort","name":"#RuleBody"}},{"node":"KTerminal","value":"requires"},{"node":"KNonTerminal","sort":{"node":"KSort","name":"Bool"}}],"params":[],"sort":{"node":"KSort","name":"#RuleContent"},"att":{"node":"KAtt","att":{"symbol":"#ruleRequires","org.kframework.attributes.Location":[346,27,346,94],"org.kframework.attributes.Source":"/usr/include/kframework/builtin/kast.md"}}},"UNIQUE_ID":"fda3e11bc95854fc2f193dc6083d140519f2ee49edb009ccac871100d0d2b470","label":"SPEC.loop-positive","org.kframework.attributes.Source":"/work/spec.k","org.kframework.attributes.Location":[43,5,73,36]}}}],"att":{"node":"KAtt","att":{"org.kframework.attributes.Location":[3,1,128,10],"org.kframework.attributes.Source":"/work/spec.k","digest":"RFWsIx5ChY8M1u/CMzCoSF6PN0TPx7qWobcp+/ig4XA="}}}]}}
