from itertools import product

def frozen_source_model(s):
    depth = 0
    for c in s:
        depth = depth + 1 if c == \"<\" else depth - 1
        if depth < 0:
            return False
    return depth == 0

def bracket_result(codes, depth):
    if not codes:
        return depth == 0
    if depth < 0:
        return False
    c, *rest = codes
    if depth == 0:
        return bracket_result(rest, 1) if c == 60 else False
    return bracket_result(rest, depth + 1 if c == 60 else depth - 1)

alphabet = \"<>x\"
tested = 0
mismatches = []
for n in range(9):
    for chars in product(alphabet, repeat=n):
        s = \"\".join(chars)
        left = frozen_source_model(s)
        right = bracket_result([ord(c) for c in s], 0)
        tested += 1
        if left "'!= right:
            mismatches.append((s, left, right))
print({"alphabet": alphabet, "lengths": "0..8", "tested": tested, "mismatch_count": len(mismatches), "mismatches": mismatches[:10]})
