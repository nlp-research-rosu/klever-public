     1	def correct_bracketing(brackets: str):
     2	    """Return whether the angle brackets are correctly balanced."""
     3	    depth = 0
     4	    bracket = ""
     5	    for bracket in brackets:
     6	        if bracket == "<":
     7	            depth += 1
     8	        else:
     9	            depth -= 1
    10	        if depth < 0:
    11	            return False
    12	    return depth == 0
