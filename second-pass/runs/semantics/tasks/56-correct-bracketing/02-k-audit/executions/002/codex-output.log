+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition audit-verification-kompiled
+
+run_log stage3_kprove_loop_zero \
+  timeout 300s kprove spec.k \
+  --definition audit-verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.loop-zero \
+  --output pretty
+
+run_log stage3_kprove_loop_positive \
+  timeout 300s kprove spec.k \
+  --definition audit-verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.loop-positive \
+  --output pretty
+
+run_log stage3_kprove_entry \
+  timeout 300s kprove spec.k \
+  --definition audit-verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.correct-bracketing \
+  --output pretty
+
+run_log stage3_kprove_all \
+  timeout 300s kprove spec.k \
+  --definition audit-verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.loop-zero,SPEC.loop-positive,SPEC.correct-bracketing \
+  --output pretty
