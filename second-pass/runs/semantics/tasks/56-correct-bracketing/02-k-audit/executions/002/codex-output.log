+         THEN:Stmts, ELSE:Stmts) ~> CONT:K
+    =>
+      THEN ~> CONT
+    </k>
+    <env> L </env>
+    <scopes>
+      ... L |-> scope(
+        "brackets" |-> BRACKETS:Val
+        "depth" |-> D:Int
+        "bracket" |-> BRACKET:Val,
+        PARENT:Parent) ...
+    </scopes>
+    requires D <Int 0
+
+  claim [if-depth-nonnegative]:
+    <k>
+      If(Compare(Name("depth"), CmpOp("<", Int(0))),
+         THEN:Stmts, ELSE:Stmts) ~> CONT:K
+    =>
+      ELSE ~> CONT
+    </k>
+    <env> L </env>
+    <scopes>
+      ... L |-> scope(
+        "brackets" |-> BRACKETS:Val
+        "depth" |-> D:Int
+        "bracket" |-> BRACKET:Val,
+        PARENT:Parent) ...
