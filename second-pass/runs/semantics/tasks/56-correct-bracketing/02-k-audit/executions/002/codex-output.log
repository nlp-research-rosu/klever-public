n# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link\n# explicit & auditable.  entry point: correct_bracketing\n\n\n\ndef correct_bracketing(brackets: str):\n    \"\"\" brackets is a string of \"<\" and \">\".\n    return True if every opening bracket has a corresponding closing bracket.\n\n    >>> correct_bracketing(\"<\")\n    False\n    >>> correct_bracketing(\"<>\")\n    True\n    >>> correct_bracketing(\"<<><>>\")\n    True\n    >>> correct_bracketing(\"><<>\")\n    False\n    \"\"\"\n    depth = 0\n    for b in brackets:\n        if b == \"<\":\n            depth += 1\n        else:\n            depth -= 1\n        if depth < 0:\n            return False\n    return depth == 0\ndef correct_bracketing(brackets: str):\n    \"\"\"Return whether the angle brackets are correctly balanced.\"\"\"\n    depth = 0\n    bracket = \"\"\n    for bracket in brackets:\n        if bracket == \"<\":\n            depth += 1\n        else:\n            depth -= 1\n        if depth < 0:\n            return False\n    return depth == 0\nModule(\n  FuncDef(\"correct_bracketing\", Params(\"brackets\"),\n    Expr(\n      Str(\"Return whether the angle brackets are correctly balanced.\"))\n    Assign(Name(\"depth\"), Int(0))\n    Assign(Name(\"bracket\"), Str(\"\"))\n    For(Name(\"bracket\"), Name(\"brackets\"),\n      If(Compare(Name(\"bracket\"), CmpOp(\"==\", Str(\"<\"))),\n        AugAssign(Name(\"depth\"), \"+\", Int(1)),\n        AugAssign(Name(\"depth\"), \"-\", Int(1)))\n      If(Compare(Name(\"depth\"), CmpOp(\"<\", Int(0))),\n        Return(Bool(false)),\n        ))\n    Return(Compare(Name(\"depth\"), CmpOp(\"==\", Int(0))))))\nrequires \"verification.k\"\n\nmodule SPEC\n  imports VERIFICATION\n\n  // Inductive loop invariant at depth zero.  Returning also pops the function\n  // frame, so this claim describes that complete transition.\n  claim [loop-zero]:\n    <k>\n      #loop(str(S:IntSeq), Name(\"bracket\"),\n        If(Compare(Name(\"