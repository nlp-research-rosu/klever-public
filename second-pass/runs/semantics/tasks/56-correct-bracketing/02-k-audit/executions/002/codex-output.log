+    =>
+      THEN ~> CONT
+    </k>
+    <env> L </env>
+    <scopes>
+      ... L |-> scope(
+        "brackets" |-> BRACKETS:Val
+        "depth" |-> D:Int
+        "bracket" |-> BRACKET:Val,
+        PARENT:Parent) ...
