+#!/usr/bin/env bash
+set -u
+
+record() {
+  name="$1"
+  shift
+  log="/audit-output/evidence/${name}.log"
+  {
+    printf 'COMMAND:'
+    printf ' %q' "$@"
+    printf '\n'
