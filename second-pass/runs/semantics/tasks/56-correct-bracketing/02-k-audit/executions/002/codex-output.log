+  name="$1"
+  shift
+  {
+    printf 'WORKDIR: %s\n' "$work"
+    printf 'COMMAND:'
+    printf ' %q' "$@"
+    printf '\n'
+    (
+      cd "$work"
+      "$@"
+    )
