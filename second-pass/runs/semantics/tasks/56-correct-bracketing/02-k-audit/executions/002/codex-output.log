+    <env> L </env>
+    <scopes>
+      ... L |-> scope(
+        "brackets" |-> BRACKETS:Val
+        "depth" |-> (D:Int => D -Int 1)
+        "bracket" |-> BRACKET:Val,
+        PARENT:Parent) ...
