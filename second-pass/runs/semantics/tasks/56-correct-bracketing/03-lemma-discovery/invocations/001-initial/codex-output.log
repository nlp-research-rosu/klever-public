     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Inductive loop invariant at depth zero.  Returning also pops the function
     7	  // frame, so this claim describes that complete transition.
     8	  claim [loop-zero]:
     9	    <k>
    10	      #loop(str(S:IntSeq), Name("bracket"),
    11	        If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
    12	          AugAssign(Name("depth"), "+", Int(1)),
    13	          AugAssign(Name("depth"), "-", Int(1)))
    14	        If(Compare(Name("depth"), CmpOp("<", Int(0))),
    15	          Return(Bool(false)),
    16	          .Stmts))
    17	      ~> (Return(Compare(Name("depth"), CmpOp("==", Int(0)))) .Stmts)
    18	      ~> #endcall
    19	    =>
    20	      bracketResult(S, 0) ~> CONT
    21	    </k>
    22	    <env> L => CALLER </env>
    23	    <scopes>
    24	      (L |-> scope(
    25	          "brackets" |-> str(INPUT:IntSeq)
    26	          "depth" |-> 0
    27	          "bracket" |-> OLD:Val,
    28	          P:Parent)
    29	       SC:Map)
    30	    =>
    31	      SC
    32	    </scopes>
    33	    <scopeLoc> _ => SAVED </scopeLoc>
    34	    <stack>
    35	      ListItem(frame(CONT:K, CALLER:Int, SAVED:Int)) REST:List => REST
    36	    </stack>
    37	    <ret> noRet </ret>
    38	    requires notBool L in_keys(SC)
    39	
    40	  // The positive-depth half of the invariant.  Splitting zero from positive
    41	  // depth makes the final integer equality decidable on every proof branch.
    42	  claim [loop-positive]:
    43	    <k>
    44	      #loop(str(S:IntSeq), Name("bracket"),
    45	        If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
    46	          AugAssign(Name("depth"), "+", Int(1)),
    47	          AugAssign(Name("depth"), "-", Int(1)))
    48	        If(Compare(Name("depth"), CmpOp("<", Int(0))),
    49	          Return(Bool(false)),
    50	          .Stmts))
    51	      ~> (Return(Compare(Name("depth"), CmpOp("==", Int(0)))) .Stmts)
    52	      ~> #endcall
    53	    =>
    54	      bracketResult(S, D) ~> CONT
    55	    </k>
    56	    <env> L => CALLER </env>
    57	    <scopes>
    58	      (L |-> scope(
    59	          "brackets" |-> str(INPUT:IntSeq)
    60	          "depth" |-> D
    61	          "bracket" |-> OLD:Val,
    62	          P:Parent)
    63	       SC:Map)
    64	    =>
    65	      SC
    66	    </scopes>
    67	    <scopeLoc> _ => SAVED </scopeLoc>
    68	    <stack>
    69	      ListItem(frame(CONT:K, CALLER:Int, SAVED:Int)) REST:List => REST
    70	    </stack>
    71	    <ret> noRet </ret>
    72	    requires D >Int 0
    73	      andBool notBool L in_keys(SC)
    74	
    75	  // The translated implementation, from module loading through its returned
    76	  // value, agrees with the mathematical bracket predicate for every string.
    77	  claim [correct-bracketing]:
    78	    <k>
    79	      #loadAll(Module(
    80	        FuncDef("correct_bracketing", Params("brackets"),
    81	          Expr(
    82	            Str("Return whether the angle brackets are correctly balanced."))
    83	          Assign(Name("depth"), Int(0))
    84	          Assign(Name("bracket"), Str(""))
    85	          For(Name("bracket"), Name("brackets"),
    86	            If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
    87	              AugAssign(Name("depth"), "+", Int(1)),
    88	              AugAssign(Name("depth"), "-", Int(1)))
    89	            If(Compare(Name("depth"), CmpOp("<", Int(0))),
    90	              Return(Bool(false)),
    91	              .Stmts))
    92	          Return(Compare(Name("depth"), CmpOp("==", Int(0)))))))
    93	      ~> Call(Name("correct_bracketing"), str(S:IntSeq))
    94	    =>
    95	      bracketResult(S, 0)
    96	    </k>
    97	    <env> 0 </env>
    98	    <scopes>
    99	      0 |-> scope(.Map, parent(-1))
   100	      -1 |-> builtinsScope
   101	    =>
   102	      0 |-> scope(
   103	        "correct_bracketing" |->
   104	          closureVal(("brackets", .ParamNames),
   105	            Expr(
   106	              Str("Return whether the angle brackets are correctly balanced."))
   107	            Assign(Name("depth"), Int(0))
   108	            Assign(Name("bracket"), Str(""))
   109	            For(Name("bracket"), Name("brackets"),
   110	              If(Compare(Name("bracket"), CmpOp("==", Str("<"))),
   111	                AugAssign(Name("depth"), "+", Int(1)),
   112	                AugAssign(Name("depth"), "-", Int(1)))
   113	              If(Compare(Name("depth"), CmpOp("<", Int(0))),
   114	                Return(Bool(false)),
   115	                .Stmts))
   116	            Return(Compare(Name("depth"), CmpOp("==", Int(0)))),
   117	            0),
   118	        parent(-1))
   119	      -1 |-> builtinsScope
   120	    </scopes>
   121	    <scopeLoc> 1 </scopeLoc>
   122	    <heap> .Map </heap>
   123	    <heapLoc> 0 </heapLoc>
   124	    <stack> .List </stack>
   125	    <ret> noRet </ret>
   126	    <exc> NoExc </exc>
   127	    <exit-code> 0 </exit-code>
   128	endmodule
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	cd "$(dirname "$0")"
     5	
     6	# Translate the submitted implementation and the concrete assertion harness.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
