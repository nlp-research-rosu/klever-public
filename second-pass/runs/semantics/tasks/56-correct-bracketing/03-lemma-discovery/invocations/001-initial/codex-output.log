+    {
+      "source_rule_id": "rule-ddc41f55ce472ec0464fd6efd6564c320da6eeea40bdf0d4dd924964511ab52a",
+      "classification": "OPERATIONAL_RULE",
+      "rationale": "Executes the concrete depth += 1 statement by updating the depth binding in the modeled local scope."
+    },
