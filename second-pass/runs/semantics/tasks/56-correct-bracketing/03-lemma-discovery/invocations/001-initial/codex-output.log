+      "classification": "OPERATIONAL_RULE",
+      "rationale": "Observes a negative depth and routes the program's depth comparison to the true #branch state."
+    },
+    {
+      "source_rule_id": "rule-d1a6400b306febacfd80cd4002d9b4cb274ff8b92b96779ec73040249b7dfb2e",
+      "classification": "OPERATIONAL_RULE",
+      "rationale": "Observes a nonnegative depth and routes the program's depth comparison to the false #branch state."
+    },
+    {
+      "source_rule_id": "rule-d0af1511799ccfa9f05017e139cba9803361b235a61051630269ea5149706430",
+      "classification": "OPERATIONAL_RULE",
+      "rationale": "Executes function-frame popping in the verification model, restoring the continuation and caller state while normalizing deletion of the fresh scope."
