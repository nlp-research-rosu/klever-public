    10	# Concrete execution under the required LLVM main and syntax modules.
    11	kompile reference-semantics/semantics.k \
    12	  --backend llvm \
    13	  --main-module MPY-KRUN \
    14	  --syntax-module MPY-SYNTAX \
    15	  --output-definition runtime-kompiled
    16	krun concrete_tests.mpy \
    17	  --definition runtime-kompiled \
    18	  --output pretty
    19	
    20	# Symbolic definition and the single positive command proving every claim.
    21	kompile verification.k \
    22	  --backend haskell \
    23	  --main-module VERIFICATION \
    24	  --syntax-module MPY-SYNTAX \
    25	  --output-definition verification-kompiled
    26	kprove spec.k \
