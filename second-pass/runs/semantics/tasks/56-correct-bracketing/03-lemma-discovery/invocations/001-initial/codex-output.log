   133	           _PARENT:Parent) ...
   134	       </scopes>
   135	       requires D <Int 0
   136	       [priority(40)]
   137	
   138	  rule <k>
   139	         If(Compare(Name("depth"), CmpOp("<", Int(0))),
   140	            THEN:Stmts, ELSE:Stmts)
   141	       =>
   142	         #branch(false, THEN, ELSE)
   143	       ... </k>
   144	       <env> L:Int </env>
   145	       <scopes>
   146	         ... L |-> scope(
   147	           "brackets" |-> _BRACKETS:Val
   148	           "depth" |-> D:Int
   149	           "bracket" |-> _BRACKET:Val,
   150	           _PARENT:Parent) ...
   151	       </scopes>
   152	       requires D >=Int 0
   153	       [priority(40)]
   154	
   155	  // Normal form of MPY-FUNCTIONS' #pop rule when the callee location is known
   156	  // fresh in the rest of the scope map.  This removes the symbolic
   157	  // `MAP [ L <- undef ]` update that the backend intentionally does not
   158	  // normalize on its own.
   159	  rule <k> #pop => V ~> CONT </k>
   160	       <ret> retV(V:Val) => noRet </ret>
   161	       <stack>
   162	         ListItem(frame(CONT:K, CALLER:Int, SAVED:Int)) REST:List => REST
   163	       </stack>
   164	       <env> L:Int => CALLER </env>
   165	       <scopes> (L |-> _FRAME:Scope SC:Map) => SC </scopes>
   166	       <scopeLoc> _ => SAVED </scopeLoc>
   167	       requires notBool L in_keys(SC)
   168	       [priority(40)]
