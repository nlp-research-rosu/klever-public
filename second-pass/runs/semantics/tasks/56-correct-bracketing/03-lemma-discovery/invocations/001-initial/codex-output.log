+      "classification": "OPERATIONAL_RULE",
+      "rationale": "Observes the current one-character bracket value and routes the program's equality test to the true #branch state."
+    },
+    {
+      "source_rule_id": "rule-ac66c3eb9c3f2b06aa9af9b0e89799ad173312c93fc4073c6c0dd8883e693942",
+      "classification": "OPERATIONAL_RULE",
+      "rationale": "Observes a non-opening current character and routes the program's bracket equality test to the false #branch state."
