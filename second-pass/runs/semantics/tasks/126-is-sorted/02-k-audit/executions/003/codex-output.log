  wc -l -c /audit-output/evidence/stage5_rule_inventory.md
  sed -n '"'1,39p' /audit-output/evidence/stage5_rule_inventory.md
} 2>&1 | tee /audit-output/evidence/stage5_rule_inventory.log
exit \""'$rc"' in /audit-output
