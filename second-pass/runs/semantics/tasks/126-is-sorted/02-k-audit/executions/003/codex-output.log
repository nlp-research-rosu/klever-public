+    <heap> .Map => .Map </heap>
+    <heapLoc> 0 => 0 </heapLoc>
+    <stack> .List => .List </stack>
+    <ret> noRet => noRet </ret>
+    <exc> NoExc => NoExc </exc>
+endmodule
