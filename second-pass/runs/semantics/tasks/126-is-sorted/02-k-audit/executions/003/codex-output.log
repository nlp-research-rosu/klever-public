+  printf 'status=%s command=sha256sum %s\n' "$?" "$1"
+}
+
+printf 'AUDIT INFRASTRUCTURE TYPES\n'
+for path in \
+  /audit-input.json \
+  /audit-campaign-lock.json \
+  /run.json \
+  /task.json \
+  /generation-result.json \
+  /generation-evidence/invocation.json \
+  /generation-evidence/metrics.json \
