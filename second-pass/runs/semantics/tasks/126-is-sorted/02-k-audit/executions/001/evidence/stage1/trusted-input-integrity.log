COMMAND: bash -lc set\ -o\ pipefail\;\ status=0\;\ for\ pair\ in\ \"/reference/prompt.py\ /candidate/prompt.py\"\ \"/reference/py2mpy.py\ /candidate/py2mpy.py\"\;\ do\ set\ --\ \$pair\;\ if\ cmp\ -s\ \"\$1\"\ \"\$2\"\;\ then\ printf\ \"BYTE_IDENTICAL\ %s\ %s\\n\"\ \"\$1\"\ \"\$2\"\;\ else\ printf\ \"BYTE_DIFFERENT\ %s\ %s\\n\"\ \"\$1\"\ \"\$2\"\;\ status=1\;\ fi\;\ sha256sum\ \"\$1\"\ \"\$2\"\;\ done\;\ if\ diff\ -u\ --label\ reference-types\ --label\ candidate-types\ \<\(cd\ /reference/reference-semantics\ \&\&\ find\ .\ -printf\ \"%P\\t%y\\t%m\\t%l\\n\"\ \|\ LC_ALL=C\ sort\)\ \<\(cd\ /candidate/reference-semantics\ \&\&\ find\ .\ -printf\ \"%P\\t%y\\t%m\\t%l\\n\"\ \|\ LC_ALL=C\ sort\)\;\ then\ echo\ \"TREE_ENTRY_TYPES_AND_MODES_IDENTICAL\"\;\ else\ status=1\;\ fi\;\ if\ diff\ -r\ --no-dereference\ /reference/reference-semantics\ /candidate/reference-semantics\;\ then\ echo\ \"TREE_BYTES_IDENTICAL\"\;\ else\ status=1\;\ fi\;\ candidate_links=\$\(find\ /candidate/reference-semantics\ -type\ l\ -print\)\;\ if\ \[\ -z\ \"\$candidate_links\"\ \]\;\ then\ echo\ \"NO_CANDIDATE_SEMANTICS_SYMLINKS\"\;\ else\ printf\ \"CANDIDATE_SYMLINKS\\n%s\\n\"\ \"\$candidate_links\"\;\ status=1\;\ fi\;\ exit\ \"\$status\"
