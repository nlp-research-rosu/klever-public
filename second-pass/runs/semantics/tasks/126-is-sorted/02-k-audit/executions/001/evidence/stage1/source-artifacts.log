     5	
     6	def is_sorted(lst):
     7	    '''
     8	    Given a list of numbers, return whether or not they are sorted
     9	    in ascending order. If list has more than 1 duplicate of the same
    10	    number, return False. Assume no negative numbers and only integers.
    11	
    12	    Examples
    13	    is_sorted([5]) ➞ True
    14	    is_sorted([1, 2, 3, 4, 5]) ➞ True
    15	    is_sorted([1, 3, 2, 4, 5]) ➞ False
    16	    is_sorted([1, 2, 3, 4, 5, 6]) ➞ True
    17	    is_sorted([1, 2, 3, 4, 5, 6, 7]) ➞ True
    18	    is_sorted([1, 3, 2, 4, 5, 6, 7]) ➞ False
    19	    is_sorted([1, 2, 2, 3, 3, 4]) ➞ True
    20	    is_sorted([1, 2, 2, 2, 3, 4]) ➞ False
    21	    '''
    22	    count_digit = dict([(i, 0) for i in lst])
    23	    for i in lst:
    24	        count_digit[i]+=1 
    25	    if any(count_digit[i] > 2 for i in lst):
    26	        return False
    27	    if all(lst[i-1] <= lst[i] for i in range(1, len(lst))):
    28	        return True
    29	    else:
    30	        return False
    31	    
    32	    
===== /candidate/solution.py =====
     1	def is_sorted(lst):
     2	    result = True
     3	    previous = 0
     4	    repeats = 0
     5	    for number in lst:
     6	        if number < previous:
     7	            result = False
     8	        if number == previous:
     9	            repeats += 1
    10	        else:
    11	            repeats = 1
    12	        if repeats > 2:
    13	            result = False
    14	        previous = number
    15	    return result
===== /candidate/solution.mpy =====
     1	Module(
     2	  FuncDef("is_sorted", Params("lst"),
     3	    Assign(Name("result"), Bool(true))
     4	    Assign(Name("previous"), Int(0))
     5	    Assign(Name("repeats"), Int(0))
     6	    For(Name("number"), Name("lst"),
     7	      If(Compare(Name("number"), CmpOp("<", Name("previous"))),
     8	        Assign(Name("result"), Bool(false)),
     9	        )
    10	      If(Compare(Name("number"), CmpOp("==", Name("previous"))),
    11	        AugAssign(Name("repeats"), "+", Int(1)),
    12	        Assign(Name("repeats"), Int(1)))
    13	      If(Compare(Name("repeats"), CmpOp(">", Int(2))),
    14	        Assign(Name("result"), Bool(false)),
    15	        )
    16	      Assign(Name("previous"), Name("number")))
    17	    Return(Name("result"))))
