     1	def is_sorted(lst):
     2	    result = True
     3	    previous = 0
     4	    repeats = 0
     5	    for number in lst:
     6	        if number < previous:
     7	            result = False
     8	        if number == previous:
     9	            repeats += 1
    10	        else:
    11	            repeats = 1
    12	        if repeats > 2:
    13	            result = False
    14	        previous = number
    15	    return result
    16	
    17	
    18	assert is_sorted([])
    19	assert is_sorted([5])
    20	assert is_sorted([1, 2, 3, 4, 5])
    21	assert not is_sorted([1, 3, 2, 4, 5])
    22	assert is_sorted([1, 2, 2, 3, 3, 4])
    23	assert not is_sorted([1, 2, 2, 2, 3, 4])
    24	assert is_sorted([0, 0])
    25	assert not is_sorted([0, 0, 0])
