-      =>
-      0 |-> scope("is_sorted" |-> isSortedClosure, parent(-1))
-      -1 |-> BUILTINS
-    </scopes>
-    <scopeLoc> 1 => 1 </scopeLoc>
-    <heap> .Map => .Map </heap>
-    <heapLoc> 0 => 0 </heapLoc>
-    <stack> .List => .List </stack>
-    <ret> noRet => noRet </ret>
-    <exc> NoExc => NoExc </exc>
-    [priority(10)]
 endmodule
