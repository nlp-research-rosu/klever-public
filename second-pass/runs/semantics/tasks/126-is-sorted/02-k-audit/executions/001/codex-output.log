+
+    off_domain = [-1]
+    print(
+        f"off-domain INPUT={off_domain}: "
+        f"K_post={scan_result(True, 0, 0, off_domain)} "
+        f"canonical={canonical(off_domain)} generated={generated(off_domain)}"
+    )
+    print(f"in_domain_mismatches={mismatches}")
+    return 0 if mismatches == 0 else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/evidence/stage4/solution-body-mutated.mpy b/evidence/stage4/solution-body-mutated.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..a1bec6b1c1126c146e7793af9e2dd066b1885176
--- /dev/null
+++ b/evidence/stage4/solution-body-mutated.mpy
@@ -0,0 +1,17 @@
+Module(
+  FuncDef("is_sorted", Params("lst"),
+    Assign(Name("result"), Bool(true))
+    Assign(Name("previous"), Int(0))
+    Assign(Name("repeats"), Int(0))
+    For(Name("number"), Name("lst"),
+      If(Compare(Name("number"), CmpOp("<", Name("previous"))),
+        Assign(Name("result"), Bool(false)),
+        )
+      If(Compare(Name("number"), CmpOp("==", Name("previous"))),
+        AugAssign(Name("repeats"), "+", Int(1)),
+        Assign(Name("repeats"), Int(1)))
+      If(Compare(Name("repeats"), CmpOp(">", Int(2))),
+        Assign(Name("result"), Bool(false)),
+        )
+      Assign(Name("previous"), Name("number")))
+    Return(Bool(false))))
diff --git a/evidence/stage5/inventory_k.sh b/evidence/stage5/inventory_k.sh
new file mode 100644
index 0000000000000000000000000000000000000000..e6948124806f0bf3a7f12c2069536f6ee96234bb
--- /dev/null
+++ b/evidence/stage5/inventory_k.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+if [ "$#" -ne 1 ]; then
+  echo "usage: $0 ROOT" >&2
+  exit 64
+fi
+
+root=$1
+find "$root" -type f -name '*.k' -print0 |
+  LC_ALL=C sort -z |
+  while IFS= read -r -d '' file; do
+    rel=${file#"$root"/}
+    printf 'FILE\t%s\tSHA256\t' "$rel"
+    sha256sum "$file" | awk '{print $1}'
+    awk -v file="$rel" '
+      function emit(kind) {
+        text=$0
+        sub(/^[[:space:]]+/, "", text)
+        printf "ITEM\t%s\t%d\t%s\t%s\n", file, NR, kind, text
+      }
+      /^[[:space:]]*requires[[:space:]]/      { emit("requires") }
+      /^[[:space:]]*module[[:space:]]/        { emit("module") }
+      /^[[:space:]]*imports[[:space:]]/       { emit("imports") }
+      /^[[:space:]]*configuration([[:space:]]|$)/ { emit("configuration") }
+      /^[[:space:]]*syntax[[:space:]]/        { emit("syntax") }
+      /^[[:space:]]*context([[:space:]]|$)/   { emit("context") }
+      /^[[:space:]]*rule([[:space:]]|$)/      { emit("rule") }
+      /^[[:space:]]*claim([[:space:]]|$)/     { emit("claim") }
+      /\[(.*(^|[,[:space:]])(function|functional|total|symbol|macro|priority|simplification|owise|concrete)([,()[:space:]]|$).*)\]/ {
+        emit("attribute")
+      }
+      END {
+        printf "COUNT\t%s\trules=%d\tsyntax=%d\tclaims=%d\tconfigurations=%d\tcontexts=%d\n",
+          file, rule_count, syntax_count, claim_count, config_count, context_count
+      }
+      /^[[:space:]]*rule([[:space:]]|$)/      { rule_count++ }
+      /^[[:space:]]*syntax[[:space:]]/        { syntax_count++ }
+      /^[[:space:]]*claim([[:space:]]|$)/     { claim_count++ }
+      /^[[:space:]]*configuration([[:space:]]|$)/ { config_count++ }
+      /^[[:space:]]*context([[:space:]]|$)/   { context_count++ }
+    ' "$file"
+  done
