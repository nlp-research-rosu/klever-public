===== /candidate/solution.py =====
     1	def is_sorted(lst):
     2	    result = True
     3	    previous = 0
     4	    repeats = 0
     5	    for number in lst:
     6	        if number < previous:
     7	            result = False
     8	        if number == previous:
     9	            repeats += 1
    10	        else:
    11	            repeats = 1
    12	        if repeats > 2:
    13	            result = False
    14	        previous = number
    15	    return result
