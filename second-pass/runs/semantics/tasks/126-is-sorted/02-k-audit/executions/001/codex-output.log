diff --git a/evidence/record-command.sh b/evidence/record-command.sh
new file mode 100644
index 0000000000000000000000000000000000000000..3b84f54a01a1e5c5217f8364a2a233fedac37f22
--- /dev/null
+++ b/evidence/record-command.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -u
+
+if [ "$#" -lt 2 ]; then
+  echo "usage: $0 LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log_file=$1
+shift
+
+(
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  command_status=$?
+  printf 'EXIT_STATUS: %d\n' "$command_status"
+  exit "$command_status"
+) 2>&1 | tee "$log_file"
+exit "${PIPESTATUS[0]}"
