Module(
  FuncDef("is_sorted", Params("lst"),
    Assign(Name("result"), Bool(true))
    Assign(Name("previous"), Int(0))
    Assign(Name("repeats"), Int(0))
    For(Name("number"), Name("lst"),
      If(Compare(Name("number"), CmpOp("<", Name("previous"))),
        Assign(Name("result"), Bool(false)),
        )
      If(Compare(Name("number"), CmpOp("==", Name("previous"))),
        AugAssign(Name("repeats"), "+", Int(1)),
        Assign(Name("repeats"), Int(1)))
      If(Compare(Name("repeats"), CmpOp(">", Int(2))),
        Assign(Name("result"), Bool(false)),
        )
      Assign(Name("previous"), Name("number")))
    Return(Name("result")))
  Assert(Call(Name("is_sorted"), ListExpr()))
  Assert(Call(Name("is_sorted"), ListExpr(Int(5))))
  Assert(
    Call(
      Name("is_sorted"),
      ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("is_sorted"),
        ListExpr(Int(1), Int(3), Int(2), Int(4), Int(5)))))
  Assert(
    Call(
      Name("is_sorted"),
      ListExpr(Int(1), Int(2), Int(2), Int(3), Int(3), Int(4))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("is_sorted"),
        ListExpr(Int(1), Int(2), Int(2), Int(2), Int(3), Int(4)))))
  Assert(Call(Name("is_sorted"), ListExpr(Int(0), Int(0))))
  Assert(
    UnaryOp(
      "not",
      Call(Name("is_sorted"), ListExpr(Int(0), Int(0), Int(0))))))
