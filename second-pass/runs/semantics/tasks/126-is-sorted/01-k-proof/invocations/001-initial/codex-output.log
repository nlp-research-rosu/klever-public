+    </k>
+    <env> L:Int => L </env>
+    <scopes>
+      0 |-> scope("is_sorted" |-> isSortedClosure, parent(-1))
+      -1 |-> builtinsScope
+      REST:Map
+      =>
+      0 |-> scope("is_sorted" |-> isSortedClosure, parent(-1))
+      -1 |-> builtinsScope
+      REST
+    </scopes>
+    <scopeLoc> NEXT:Int => NEXT </scopeLoc>
+    <heap> HEAP:Map => ?FINALHEAP:Map </heap>
+    <heapLoc> HNEXT:Int => ?FINALHNEXT:Int </heapLoc>
+    <stack> STACK:List => STACK </stack>
+    <ret> noRet => noRet </ret>
+    <exc> EXC:Exc => EXC </exc>
