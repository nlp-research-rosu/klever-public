+  claim [is-sorted-inductive]:
+    <k>
+      #applyK(toCall(isSortedClosure),
+              (list(intsToVals(iCons(A:Int,
+                                    iCons(B:Int, R:IntSeq)))),
+               .Vals)) ~> CONT:K
+      =>
+      isSortedContract(iCons(A, iCons(B, R))) ~> CONT
+    </k>
+    <env> L:Int => L </env>
