+  // preempt strictness from placing symbolic Bool results under an internal
+  // If freezer.
+  rule <k>
+         If(Compare(Name("number"), CmpOp("<", Name("previous"))),
+            T:Stmts, _E:Stmts)
+         => T
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("number" |-> X:Int)
+           ("previous" |-> P:Int)
+           REST:Map,
+           _PAR:Parent) ...
+       </scopes>
+       requires X <Int P
+       [priority(20)]
+  rule <k>
+         If(Compare(Name("number"), CmpOp("<", Name("previous"))),
+            _T:Stmts, E:Stmts)
+         => E
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("number" |-> X:Int)
+           ("previous" |-> P:Int)
+           REST:Map,
+           _PAR:Parent) ...
+       </scopes>
+       requires X >=Int P
+       [priority(20)]
+
+  rule <k>
+         If(Compare(Name("number"), CmpOp("==", Name("previous"))),
+            T:Stmts, _E:Stmts)
+         => T
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("number" |-> X:Int)
+           ("previous" |-> P:Int)
+           REST:Map,
+           _PAR:Parent) ...
+       </scopes>
+       requires X ==Int P
+       [priority(20)]
+  rule <k>
+         If(Compare(Name("number"), CmpOp("==", Name("previous"))),
+            _T:Stmts, E:Stmts)
+         => E
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("number" |-> X:Int)
+           ("previous" |-> P:Int)
+           REST:Map,
+           _PAR:Parent) ...
+       </scopes>
+       requires X =/=Int P
+       [priority(20)]
+
+  rule <k>
+         If(Compare(Name("repeats"), CmpOp(">", Int(2))),
+            T:Stmts, _E:Stmts)
+         => T
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("repeats" |-> C:Int) REST:Map,
+                          _PAR:Parent) ...
+       </scopes>
+       requires C >Int 2
+       [priority(20)]
+  rule <k>
+         If(Compare(Name("repeats"), CmpOp(">", Int(2))),
+            _T:Stmts, E:Stmts)
+         => E
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("repeats" |-> C:Int) REST:Map,
+                          _PAR:Parent) ...
+       </scopes>
+       requires C <=Int 2
+       [priority(20)]
+
+  // Constructor form of MAP's update/delete equation used by #pop.
+  rule ((N:Int |-> _S:Scope) BASE:Map) [ N <- undef ] => BASE
+       requires notBool N in_keys(BASE)
+       [simplification]
+
+  // Universal integer-list carrier used by the claims.
+  syntax ValSeq ::= intsToVals(IntSeq)
