diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..99d47e1c2ca0da88857b3548bcb9f4e986c4e415
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,103 @@
+requires "reference-semantics/semantics.k"
+
+module IS-SORTED-VERIFICATION
+  imports MPY
+
+  // Embed the translated function body as a value so that the specification
+  // can quantify over inputs while executing the actual implementation.
+  syntax Val ::= "isSortedClosure" [macro]
+  rule isSortedClosure
+    => closureVal(
+         ("lst", .ParamNames),
+         If(Compare(Call(Name("len"), Name("lst")), CmpOp("<", Int(2))),
+            Return(Bool(true)),
+            .Stmts)
+         If(Compare(Subscript(Name("lst"), Int(0)),
+                    CmpOp(">", Subscript(Name("lst"), Int(1)))),
+            Return(Bool(false)),
+            .Stmts)
+         If(BoolOp(
+              "and",
+              (Compare(Call(Name("len"), Name("lst")), CmpOp(">", Int(2))),
+               Compare(Subscript(Name("lst"), Int(0)),
+                       CmpOp("==", Subscript(Name("lst"), Int(1)))),
+               Compare(Subscript(Name("lst"), Int(1)),
+                       CmpOp("==", Subscript(Name("lst"), Int(2)))),
+               .Exprs)),
+            Return(Bool(false)),
+            .Stmts)
+         Return(Call(Name("is_sorted"),
+                     (Subscript(Name("lst"),
+                                Slice(Int(1), NoBound, NoBound)),
+                      .Exprs)))
+         .Stmts,
+         0)
+
+  // The generic call rule represents insertion of a fresh frame with a Map
+  // update.  Keeping that obviously equivalent update in constructor form
+  // avoids a symbolic Map-matching ambiguity when #bindP inspects the frame.
+  rule <k> #applyK(toCall(isSortedClosure), ARGS:Vals) ~> CONT
+        => #bindP(("lst", .ParamNames), ARGS)
+           ~> If(Compare(Call(Name("len"), Name("lst")),
+                        CmpOp("<", Int(2))),
+                 Return(Bool(true)),
+                 .Stmts)
+              If(Compare(Subscript(Name("lst"), Int(0)),
+                         CmpOp(">", Subscript(Name("lst"), Int(1)))),
+                 Return(Bool(false)),
+                 .Stmts)
+              If(BoolOp(
+                   "and",
+                   (Compare(Call(Name("len"), Name("lst")),
+                            CmpOp(">", Int(2))),
+                    Compare(Subscript(Name("lst"), Int(0)),
+                            CmpOp("==", Subscript(Name("lst"), Int(1)))),
+                    Compare(Subscript(Name("lst"), Int(1)),
+                            CmpOp("==", Subscript(Name("lst"), Int(2)))),
+                    .Exprs)),
+                 Return(Bool(false)),
+                 .Stmts)
+              Return(Call(Name("is_sorted"),
+                          (Subscript(Name("lst"),
+                                     Slice(Int(1), NoBound, NoBound)),
+                           .Exprs)))
+              .Stmts
+           ~> #endcall
+           </k>
+       <env> CALLER:Int => NEW:Int </env>
+       <scopes> SCOPES:Map => (NEW |-> scope(.Map, parent(0))) SCOPES </scopes>
+       <scopeLoc> NEW => NEW +Int 1 </scopeLoc>
+       <stack> .List => ListItem(frame(CONT, CALLER, NEW)) ... </stack>
+       requires notBool NEW in_keys(SCOPES)
+       [priority(40)]
+
+  // Normalize the explicit fresh frame after the reference #pop rule marks it
+  // undefined.  This is the constructor-form instance of MAP's update/delete
+  // equation, with its required disjointness condition made explicit.
+  rule ((N:Int |-> _S:Scope) BASE:Map) [ N <- undef ] => BASE
+       requires notBool N in_keys(BASE)
+       [simplification]
+
+  // IntSeq is a convenient inductive carrier for universally quantified
+  // integer lists.  This conversion supplies the Python list payload.
+  syntax ValSeq ::= intsToVals(IntSeq) [function, total]
+  rule intsToVals(.IntSeq) => .ValSeq
+  rule intsToVals(iCons(I:Int, IS:IntSeq))
+    => vCons(I, intsToVals(IS))
+
+  // Mathematical contract: adjacent entries are nondecreasing, and no three
+  // adjacent entries are equal.  In a nondecreasing list, the latter is
+  // equivalent to saying that no value occurs more than twice.
+  syntax Bool ::= noTripleAt(Int, Int, IntSeq) [function, total]
+  rule noTripleAt(_:Int, _:Int, .IntSeq) => true
+  rule noTripleAt(A:Int, B:Int, iCons(C:Int, _:IntSeq))
+    => notBool (A ==Int B andBool B ==Int C)
+
+  syntax Bool ::= isSortedContract(IntSeq) [function, total]
+  rule isSortedContract(.IntSeq) => true
+  rule isSortedContract(iCons(_:Int, .IntSeq)) => true
+  rule isSortedContract(iCons(A:Int, iCons(B:Int, R:IntSeq)))
+    => A <=Int B
+       andBool noTripleAt(A, B, R)
+       andBool isSortedContract(iCons(B, R))
+endmodule

