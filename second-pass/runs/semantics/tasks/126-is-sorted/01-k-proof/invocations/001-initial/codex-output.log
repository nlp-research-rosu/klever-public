/bin/bash -lc "python3 py2mpy.py solution.py > solution.mpy && sed -n '1,240p' solution.mpy && python3 - <<'PY'
from solution import is_sorted
cases = [([], True), ([5], True), ([1,2,3,4,5], True), ([1,3,2,4,5], False), ([1,2,2,3,3,4], True), ([1,2,2,2,3,4], False), ([0,0], True), ([0,0,0], False), ([1,1,2,2,2], False)]
for xs, expected in cases:
    assert is_sorted(xs) is expected, (xs, is_sorted(xs), expected)
print('python tests: ok')
PY" in /work
