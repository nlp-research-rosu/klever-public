+requires "verification.k"
+
+module IS-SORTED-SPEC
+  imports IS-SORTED-VERIFICATION
+
+  claim [is-sorted-empty]:
+    <k>
+      #applyK(toCall(isSortedClosure),
+              (list(intsToVals(.IntSeq)), .Vals)) ~> CONT:K
+      =>
+      isSortedContract(.IntSeq) ~> CONT
+    </k>
+    <env> L:Int => L </env>
+    <scopes>
+      0 |-> scope("is_sorted" |-> isSortedClosure, parent(-1))
+      -1 |-> builtinsScope
+      REST:Map
+      =>
+      0 |-> scope("is_sorted" |-> isSortedClosure, parent(-1))
+      -1 |-> builtinsScope
+      REST
+    </scopes>
+    <scopeLoc> NEXT:Int => NEXT </scopeLoc>
+    <heap> HEAP:Map => ?EMPTYHEAP:Map </heap>
+    <heapLoc> HNEXT:Int => ?EMPTYHNEXT:Int </heapLoc>
+    <stack> STACK:List => STACK </stack>
+    <ret> noRet => noRet </ret>
+    <exc> EXC:Exc => EXC </exc>
+    requires NEXT >=Int 1
+     andBool notBool NEXT in_keys(
+       (0 |-> scope("is_sorted" |-> isSortedClosure, parent(-1)))
+       (-1 |-> builtinsScope)
+       REST)
+     andBool HNEXT >=Int 0
+     andBool notBool HNEXT in_keys(HEAP)
+
+  claim [is-sorted-singleton]:
+    <k>
+      #applyK(toCall(isSortedClosure),
+              (list(intsToVals(iCons(A:Int, .IntSeq))), .Vals)) ~> CONT:K
+      =>
+      isSortedContract(iCons(A, .IntSeq)) ~> CONT
+    </k>
+    <env> L:Int => L </env>
+    <scopes>
+      0 |-> scope("is_sorted" |-> isSortedClosure, parent(-1))
+      -1 |-> builtinsScope
+      REST:Map
+      =>
+      0 |-> scope("is_sorted" |-> isSortedClosure, parent(-1))
+      -1 |-> builtinsScope
+      REST
+    </scopes>
+    <scopeLoc> NEXT:Int => NEXT </scopeLoc>
+    <heap> HEAP:Map => ?SINGLEHEAP:Map </heap>
+    <heapLoc> HNEXT:Int => ?SINGLEHNEXT:Int </heapLoc>
+    <stack> STACK:List => STACK </stack>
+    <ret> noRet => noRet </ret>
+    <exc> EXC:Exc => EXC </exc>
+    requires NEXT >=Int 1
+     andBool notBool NEXT in_keys(
+       (0 |-> scope("is_sorted" |-> isSortedClosure, parent(-1)))
+       (-1 |-> builtinsScope)
+       REST)
+     andBool HNEXT >=Int 0
+     andBool notBool HNEXT in_keys(HEAP)
+
+  claim [is-sorted-pair]:
+    <k>
+      #applyK(toCall(isSortedClosure),
+              (list(intsToVals(iCons(A:Int,
+                                    iCons(B:Int, .IntSeq)))),
+               .Vals)) ~> CONT:K
+      =>
+      isSortedContract(iCons(A, iCons(B, .IntSeq))) ~> CONT
+    </k>
+    <env> L:Int => L </env>
+    <scopes>
+      0 |-> scope("is_sorted" |-> isSortedClosure, parent(-1))
+      -1 |-> builtinsScope
+      REST:Map
+      =>
+      0 |-> scope("is_sorted" |-> isSortedClosure, parent(-1))
+      -1 |-> builtinsScope
+      REST
+    </scopes>
+    <scopeLoc> NEXT:Int => NEXT </scopeLoc>
+    <heap> HEAP:Map => ?PAIRHEAP:Map </heap>
+    <heapLoc> HNEXT:Int => ?PAIRHNEXT:Int </heapLoc>
+    <stack> STACK:List => STACK </stack>
+    <ret> noRet => noRet </ret>
+    <exc> EXC:Exc => EXC </exc>
+    requires NEXT >=Int 1
+     andBool notBool NEXT in_keys(
+       (0 |-> scope("is_sorted" |-> isSortedClosure, parent(-1)))
+       (-1 |-> builtinsScope)
+       REST)
+     andBool HNEXT >=Int 0
+     andBool notBool HNEXT in_keys(HEAP)
+
+  claim [is-sorted-inductive]:
+    <k>
+      #applyK(toCall(isSortedClosure),
+              (list(intsToVals(iCons(A:Int,
+                                    iCons(B:Int,
+                                    iCons(C:Int, R:IntSeq))))),
+               .Vals)) ~> CONT:K
+      =>
+      isSortedContract(iCons(A, iCons(B, iCons(C, R)))) ~> CONT
+    </k>
+    <env> L:Int => L </env>
+    <scopes>
+      0 |-> scope("is_sorted" |-> isSortedClosure, parent(-1))
+      -1 |-> builtinsScope
+      REST:Map
+      =>
+      0 |-> scope("is_sorted" |-> isSortedClosure, parent(-1))
+      -1 |-> builtinsScope
+      REST
+    </scopes>
+    <scopeLoc> NEXT:Int => NEXT </scopeLoc>
+    <heap> HEAP:Map => ?INDUCTIVEHEAP:Map </heap>
+    <heapLoc> HNEXT:Int => ?INDUCTIVEHNEXT:Int </heapLoc>
+    <stack> STACK:List => STACK </stack>
