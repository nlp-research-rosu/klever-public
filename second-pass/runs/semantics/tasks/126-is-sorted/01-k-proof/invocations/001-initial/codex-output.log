+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("number" |-> X:Int)
+           ("previous" |-> P:Int)
+           REST:Map,
+           _PAR:Parent) ...
+       </scopes>
+       requires X >=Int P
+       [priority(20)]
+
+  rule <k>
+         If(Compare(Name("number"), CmpOp("==", Name("previous"))),
+            T:Stmts, _E:Stmts)
+         => T
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("number" |-> X:Int)
+           ("previous" |-> P:Int)
+           REST:Map,
+           _PAR:Parent) ...
+       </scopes>
+       requires X ==Int P
+       [priority(20)]
+  rule <k>
+         If(Compare(Name("number"), CmpOp("==", Name("previous"))),
+            _T:Stmts, E:Stmts)
+         => E
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("number" |-> X:Int)
+           ("previous" |-> P:Int)
+           REST:Map,
+           _PAR:Parent) ...
+       </scopes>
+       requires X =/=Int P
