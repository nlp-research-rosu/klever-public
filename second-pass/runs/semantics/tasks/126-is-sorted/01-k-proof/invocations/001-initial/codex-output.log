@@ -0,0 +1,8 @@
+def is_sorted(lst):
+    if len(lst) < 2:
+        return True
+    if lst[0] > lst[1]:
+        return False
+    if len(lst) > 2 and lst[0] == lst[1] and lst[1] == lst[2]:
+        return False
+    return is_sorted(lst[1:])
