+        ("previous" |-> PREV)
+        ("repeats" |-> COUNT)
+        LOCALS:Map,
+        PARENT:Parent)
+      BASE:Map
+      =>
+      BASE
+    </scopes>
+    <scopeLoc> CURRENT:Int => SAVED:Int </scopeLoc>
