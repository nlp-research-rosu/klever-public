diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..74b94e04b7768b388d0797cdf565906e11829902
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,25 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun solution.mpy \
+  --definition runtime-kompiled \
+  --parser "cat" \
+  --output pretty
+
+kompile verification.k \
+  --backend haskell \
+  --main-module IS-SORTED-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module IS-SORTED-SPEC
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..52cf41274b3684ef1193059b4231192708dc298a
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,8 @@
+def is_sorted(lst):
+    if len(lst) < 2:
+        return True
+    if lst[0] > lst[1]:
+        return False
+    if len(lst) > 2 and lst[0] == lst[1] and lst[1] == lst[2]:
+        return False
+    return is_sorted(lst[1:])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..cc0a02acb67c06f566275276d7c1618d5bdd3c47
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,39 @@
+requires "verification.k"
+
+module IS-SORTED-SPEC
+  imports IS-SORTED-VERIFICATION
+
+  claim [is-sorted-correct]:
+    <k>
+      #applyK(toCall(isSortedClosure),
+              (list(intsToVals(INPUT:IntSeq)), .Vals)) ~> CONT:K
+      =>
+      isSortedContract(INPUT) ~> CONT
+    </k>
+    <env> L:Int => L </env>
+    <scopes>
+      0 |-> scope(M:Map, parent(-1))
+      -1 |-> builtinsScope
+      REST:Map
+      =>
+      0 |-> scope(M, parent(-1))
+      -1 |-> builtinsScope
+      REST
+    </scopes>
+    <scopeLoc> NEXT:Int => NEXT </scopeLoc>
+    <heap> HEAP:Map => ?FINALHEAP:Map </heap>
+    <heapLoc> HNEXT:Int => ?FINALHNEXT:Int </heapLoc>
+    <stack> STACK:List => STACK </stack>
+    <ret> noRet => noRet </ret>
+    <exc> EXC:Exc => EXC </exc>
+    requires {M["is_sorted"]}:>Val ==K isSortedClosure
+     andBool "is_sorted" in_keys(M)
+     andBool NEXT >=Int 1
+     andBool notBool NEXT in_keys(REST)
+     andBool notBool NEXT in_keys(
+       (0 |-> scope(M, parent(-1)))
+       (-1 |-> builtinsScope)
+       REST)
+     andBool HNEXT >=Int 0
+     andBool notBool HNEXT in_keys(HEAP)
+endmodule
