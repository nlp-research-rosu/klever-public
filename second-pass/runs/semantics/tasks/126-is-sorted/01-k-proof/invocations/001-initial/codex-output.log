diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..52cf41274b3684ef1193059b4231192708dc298a
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,8 @@
+def is_sorted(lst):
+    if len(lst) < 2:
+        return True
+    if lst[0] > lst[1]:
+        return False
+    if len(lst) > 2 and lst[0] == lst[1] and lst[1] == lst[2]:
+        return False
+    return is_sorted(lst[1:])
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..1498780549253457924a9afe2b1a99af2cd438b9
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,35 @@
+requires "verification.k"
+
+module IS-SORTED-SPEC
+  imports IS-SORTED-VERIFICATION
+
+  claim [is-sorted-correct]:
+    <k>
+      #applyK(toCall(isSortedClosure),
+              (list(intsToVals(INPUT:IntSeq)), .Vals)) ~> CONT:K
+      =>
+      isSortedContract(INPUT) ~> CONT
+    </k>
+    <env> L:Int => L </env>
+    <scopes>
+      0 |-> scope(M:Map, parent(-1))
+      -1 |-> builtinsScope
+      REST:Map
+      =>
+      0 |-> scope(M, parent(-1))
+      -1 |-> builtinsScope
+      REST
+    </scopes>
+    <scopeLoc> NEXT:Int => NEXT </scopeLoc>
+    <heap> HEAP:Map => _:Map </heap>
+    <heapLoc> HNEXT:Int => _:Int </heapLoc>
+    <stack> STACK:List => STACK </stack>
+    <ret> noRet => noRet </ret>
+    <exc> EXC:Exc => EXC </exc>
+    requires {M["is_sorted"]}:>Val ==K isSortedClosure
+     andBool "is_sorted" in_keys(M)
+     andBool NEXT >=Int 1
+     andBool notBool NEXT in_keys(REST)
+     andBool HNEXT >=Int 0
+     andBool notBool HNEXT in_keys(HEAP)
+endmodule
