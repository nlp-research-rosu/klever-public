+      scanResult(scanAll(OK:Bool, PREV:Int, COUNT:Int, IS)) ~> CONT:K
+    </k>
+    <env> FRAME:Int => CALLER:Int </env>
+    <scopes>
+      FRAME |-> scope(
+        ("$plain" |-> true)
+        ("result" |-> OK)
+        ("previous" |-> PREV)
+        ("repeats" |-> COUNT)
+        ("number" |-> _NUMBER:Int)
+        LOCALS:Map,
+        PARENT:Parent)
+      BASE:Map
