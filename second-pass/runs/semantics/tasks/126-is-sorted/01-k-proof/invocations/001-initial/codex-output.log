+        ("$plain" |-> true)
+        ("result" |-> OK:Bool)
+        ("previous" |-> PREV:Int)
+        ("repeats" |-> COUNT:Int)
+        ("number" |-> X:Int)
+        LOCALS:Map
+        =>
