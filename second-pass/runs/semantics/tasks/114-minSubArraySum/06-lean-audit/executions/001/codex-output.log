+            Proof.«valSeqAt(_,_)_MPY-SUBSCRIPT_Val_ValSeq_Int»,
+            Proof.intValsAt, embeddedIntVals, zero, positive]
+
+def sample : SortIntSeq :=
+  consIS 7 (consIS (-3) (consIS 42 emptyIS))
+
+/- Boundary, recursive, negative, and out-of-bounds witnesses. -/
+example : candidate (intVals sample) 0 = intV 7 := by rfl
+example : candidate (intVals sample) 1 = intV (-3) := by rfl
+example : candidate (intVals sample) 2 = intV 42 := by rfl
+example : candidate (intVals sample) 3 = noneV := by rfl
+example : candidate (intVals sample) (-1) = noneV := by rfl
+example : candidate (consVS noneV (consVS (intV 9) emptyVS)) 0 = noneV := by
+  rfl
+example : candidate (consVS noneV (consVS (intV 9) emptyVS)) 1 = intV 9 := by
+  rfl
+
+/- A deliberately convenient bridge proves the target but violates valSeqAt. -/
+def shortcutValSeqAt : SortValSeq → SortInt → SortVal
+  | SortValSeq.«intVals(_)_VERIFICATION-BASE_ValSeq_IntSeq»
+      (SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» value _rest), 0 =>
+      SortVal.inj_SortInt value
+  | _, _ => noneV
+
+theorem shortcut_still_proves_generated_target :
+    Klean114Minsubarraysum.Lemmas.targetStatement shortcutValSeqAt := by
+  intro _R I
+  rfl
+
+example : shortcutValSeqAt (consVS (intV 9) emptyVS) 0 ≠ intV 9 := by
+  simp [shortcutValSeqAt]
+
+example : candidate (consVS (intV 9) emptyVS) 0 = intV 9 := by
+  rfl
+
+end AuditBridge
