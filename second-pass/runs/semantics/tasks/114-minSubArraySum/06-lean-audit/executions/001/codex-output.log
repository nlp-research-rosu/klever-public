diff --git a//tmp/audit-work/proof-audit/BridgeValidation.lean b//tmp/audit-work/proof-audit/BridgeValidation.lean
new file mode 100644
index 0000000000000000000000000000000000000000..1b909885cd51f2097d0a686c3bd04cf341cde1a2
--- /dev/null
+++ b//tmp/audit-work/proof-audit/BridgeValidation.lean
@@ -0,0 +1,76 @@
+import Proof
+
+namespace AuditBridge
+
+abbrev emptyIS := SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+abbrev consIS := SortIntSeq.«iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq»
+abbrev emptyVS := SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+abbrev intVals := SortValSeq.«intVals(_)_VERIFICATION-BASE_ValSeq_IntSeq»
+abbrev consVS := SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq»
+abbrev noneV := SortVal.«noneV_MPY-CORE_Val»
+abbrev intV := SortVal.inj_SortInt
+abbrev candidate :=
+  Proof.«valSeqAt(_,_)_MPY-SUBSCRIPT_Val_ValSeq_Int»
+
+/- The normal form obtained from the two frozen intVals equations. -/
+def embeddedIntVals : SortIntSeq → SortValSeq
+  | emptyIS => emptyVS
+  | consIS value rest => consVS (intV value) (embeddedIntVals rest)
+
+/- Universal checks of both imported frozen valSeqAt equations. -/
+theorem candidate_vCons_zero
+    (value : SortVal) (rest : SortValSeq) :
+    candidate (consVS value rest) 0 = value := by
+  rfl
+
+theorem candidate_vCons_positive
+    (value : SortVal) (rest : SortValSeq) (index : SortInt)
+    (positive : 0 < index) :
+    candidate (consVS value rest) index =
+      candidate rest (index - 1) := by
+  simp [candidate, Proof.«valSeqAt(_,_)_MPY-SUBSCRIPT_Val_ValSeq_Int»,
+    positive, Int.ne_of_gt positive]
+
+/- The promoted intVals constructor agrees universally with its K reduction. -/
+theorem candidate_intVals_bridge
+    (values : SortIntSeq) (index : SortInt) :
+    candidate (intVals values) index =
+      candidate (embeddedIntVals values) index := by
+  induction values generalizing index with
+  | «.IntSeq_MPY-CORE_IntSeq» =>
+      rfl
+  | «iCons(_,_)_MPY-CORE_IntSeq_Int_IntSeq» value rest inductionHypothesis =>
+      simp [candidate, Proof.«valSeqAt(_,_)_MPY-SUBSCRIPT_Val_ValSeq_Int»,
+        Proof.intValsAt, embeddedIntVals, inductionHypothesis]
+
+def sample : SortIntSeq :=
+  consIS 7 (consIS (-3) (consIS 42 emptyIS))
+
+/- Boundary, recursive, negative, and out-of-bounds witnesses. -/
+example : candidate (intVals sample) 0 = intV 7 := by rfl
+example : candidate (intVals sample) 1 = intV (-3) := by rfl
+example : candidate (intVals sample) 2 = intV 42 := by rfl
+example : candidate (intVals sample) 3 = noneV := by rfl
+example : candidate (intVals sample) (-1) = noneV := by rfl
+example : candidate (consVS noneV (consVS (intV 9) emptyVS)) 0 = noneV := by
+  rfl
+example : candidate (consVS noneV (consVS (intV 9) emptyVS)) 1 = intV 9 := by
+  rfl
+
+/- A deliberately convenient bridge proves the target but violates valSeqAt. -/
+def shortcutValSeqAt : SortValSeq → SortInt → SortVal
+  | intVals (consIS value _rest), 0 => intV value
+  | _, _ => noneV
+
+theorem shortcut_still_proves_generated_target :
+    Klean114Minsubarraysum.Lemmas.targetStatement shortcutValSeqAt := by
+  intro _R I
+  rfl
+
+example : shortcutValSeqAt (consVS (intV 9) emptyVS) 0 ≠ intV 9 := by
+  simp [shortcutValSeqAt]
+
+example : candidate (consVS (intV 9) emptyVS) 0 = intV 9 := by
+  rfl
+
+end AuditBridge
