      "normalized_sha256": "61708f547727d7aa918ad6bf8a016e92b25d1ccd0e36098b415347016593af3e",
      "rationale": "Base equation defining the empty IntSeq case of the intVals representation.",
      "source_rule_id": "rule-61708f547727d7aa918ad6bf8a016e92b25d1ccd0e36098b415347016593af3e",
      "start_line": 10,
      "text": "  rule intVals(.IntSeq)                => .ValSeq"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 11,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "7e02eb37b7bdf1eab6f0857a5ba0eea03ae8d443148932837b9044d248811a1f",
      "rationale": "Recursive equation defining how intVals embeds an integer head and tail into ValSeq.",
      "source_rule_id": "rule-7e02eb37b7bdf1eab6f0857a5ba0eea03ae8d443148932837b9044d248811a1f",
      "start_line": 11,
      "text": "  rule intVals(iCons(I:Int, R:IntSeq)) => vCons(I, intVals(R))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 36,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "ddb2a9a17afa83ccead9953239de6b8640bfdcb07b5d919d5f3fef6fd450df5a",
      "rationale": "Conditional equation defining chooseSmaller when its first integer is strictly smaller.",
      "source_rule_id": "rule-ddb2a9a17afa83ccead9953239de6b8640bfdcb07b5d919d5f3fef6fd450df5a",
      "start_line": 35,
      "text": "  rule chooseSmaller(A:Int, B:Int) => A\n    requires A <Int B"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 38,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "e414c2c690c54d3aff26ea489493eeb2b52b5e37c1f5fe9ea0723203661776d9",
      "rationale": "Complementary conditional equation completing the definition of chooseSmaller.",
      "source_rule_id": "rule-e414c2c690c54d3aff26ea489493eeb2b52b5e37c1f5fe9ea0723203661776d9",
      "start_line": 37,
      "text": "  rule chooseSmaller(A:Int, B:Int) => B\n    requires A >=Int B"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 41,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "2e35ac88a7868a7de836211c573b73eb3fec197a29c6fc4b545dc0c1d4025164",
      "rationale": "Equation defining the next Kadane current-state summary.",
      "source_rule_id": "rule-2e35ac88a7868a7de836211c573b73eb3fec197a29c6fc4b545dc0c1d4025164",
      "start_line": 41,
      "text": "  rule nextCurrent(I:Int, C:Int) => chooseSmaller(I, C +Int I)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 44,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "382008e7c331639bdf2122fb1e8e697a018e1932c7ffbb663b07a0d9ed4dab54",
      "rationale": "Base case of the kadaneCurrent recurrence.",
      "source_rule_id": "rule-382008e7c331639bdf2122fb1e8e697a018e1932c7ffbb663b07a0d9ed4dab54",
      "start_line": 44,
      "text": "  rule kadaneCurrent(.IntSeq, C:Int) => C"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 46,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "538263806e08f896295a8e43dccd79d3b2682d49dd3a83d0bf7be98bc05ce9ef",
      "rationale": "Recursive case defining kadaneCurrent over an integer sequence.",
      "source_rule_id": "rule-538263806e08f896295a8e43dccd79d3b2682d49dd3a83d0bf7be98bc05ce9ef",
      "start_line": 45,
      "text": "  rule kadaneCurrent(iCons(I:Int, R:IntSeq), C:Int)\n    => kadaneCurrent(R, nextCurrent(I, C))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 49,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "b77bb29211065f926011aeb07474c28374b27afe8225fbad12ea669ccda27918",
      "rationale": "Base case of the kadaneSmallest recurrence.",
      "source_rule_id": "rule-b77bb29211065f926011aeb07474c28374b27afe8225fbad12ea669ccda27918",
      "start_line": 49,
      "text": "  rule kadaneSmallest(.IntSeq, _C:Int, B:Int) => B"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 54,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "b918679df7be71188a57e3b7f86189ff84457d4193215ebb54ca1eff52430469",
      "rationale": "Recursive equation defining the Kadane minimum-so-far summary.",
      "source_rule_id": "rule-b918679df7be71188a57e3b7f86189ff84457d4193215ebb54ca1eff52430469",
      "start_line": 50,
      "text": "  rule kadaneSmallest(iCons(I:Int, R:IntSeq), C:Int, B:Int)\n    => kadaneSmallest(\n         R,\n         nextCurrent(I, C),\n         chooseSmaller(nextCurrent(I, C), B))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 61,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "6623a3796cfdcb66d4f69856565b76423d6a28be7027c5a7bdb641c2450f01f5",
      "rationale": "Equation defining the nonempty-input contract summary minSubArraySumSpec.",
      "source_rule_id": "rule-6623a3796cfdcb66d4f69856565b76423d6a28be7027c5a7bdb641c2450f01f5",
      "start_line": 60,
      "text": "  rule minSubArraySumSpec(iCons(H:Int, T:IntSeq))\n    => kadaneSmallest(T, H, H)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 64,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "f6b2c49e4162bd80ca3acc1433e3738c91a600c1a77eeef3a64db19df4a925ab",
      "rationale": "Base equation defining the lastFrom structural fold.",
      "source_rule_id": "rule-f6b2c49e4162bd80ca3acc1433e3738c91a600c1a77eeef3a64db19df4a925ab",
      "start_line": 64,
      "text": "  rule lastFrom(.IntSeq, LAST:Int) => LAST"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 66,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "0d184e0a169fc24d4d6b137dc9e8f1718d2e55996d8b9d719a063d075f6bad59",
      "rationale": "Recursive equation defining the lastFrom structural fold.",
      "source_rule_id": "rule-0d184e0a169fc24d4d6b137dc9e8f1718d2e55996d8b9d719a063d075f6bad59",
      "start_line": 65,
      "text": "  rule lastFrom(iCons(I:Int, R:IntSeq), _LAST:Int)\n    => lastFrom(R, I)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 82,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "bef95a832d9aafada0edddcd170407e7be2078dd45cfe2b96bc391a5c8445c58",
      "rationale": "Macro expansion naming the exact translated Kadane loop body.",
      "source_rule_id": "rule-bef95a832d9aafada0edddcd170407e7be2078dd45cfe2b96bc391a5c8445c58",
      "start_line": 70,
      "text": "  rule kadaneBody =>\n       Assign(\n         Name(\"current\"),\n         BinOp(\"+\", Name(\"current\"), Name(\"value\")))\n       If(\n         Compare(Name(\"value\"), CmpOp(\"<\", Name(\"current\"))),\n         Assign(Name(\"current\"), Name(\"value\")) .Stmts,\n         .Stmts)\n       If(\n         Compare(Name(\"current\"), CmpOp(\"<\", Name(\"smallest\"))),\n         Assign(Name(\"smallest\"), Name(\"current\")) .Stmts,\n         .Stmts)\n       .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 96,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "e17eaf3f5efc7de2b66d4005c595c668ad0317ec2b3235aa09c7c273a461e5e9",
      "rationale": "Macro expansion naming the exact translated function body.",
      "source_rule_id": "rule-e17eaf3f5efc7de2b66d4005c595c668ad0317ec2b3235aa09c7c273a461e5e9",
      "start_line": 87,
      "text": "  rule minSubArraySumBody =>\n       Expr(\n         Str(\n           \"\\n    Given an array of integers nums, find the minimum sum of any non-empty\\n    sub-array of nums.\\n    \"))\n       Assign(Name(\"smallest\"), Subscript(Name(\"nums\"), Int(0)))\n       Assign(Name(\"current\"), Int(0))\n       Assign(Name(\"value\"), Int(0))\n       For(Name(\"value\"), Name(\"nums\"), kadaneBody)\n       Return(Name(\"smallest\"))\n       .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 103,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "c9903e98ccf11645c2d85472b1e9045c58837512be5d1a0aa13530f3df954d4b",
      "rationale": "Macro expansion naming the exact translated function definition.",
      "source_rule_id": "rule-c9903e98ccf11645c2d85472b1e9045c58837512be5d1a0aa13530f3df954d4b",
      "start_line": 99,
      "text": "  rule minSubArraySumDef =>\n       FuncDef(\n         \"minSubArraySum\",\n         Params(\"nums\", .ParamNames),\n         minSubArraySumBody)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 110,
      "module": "VERIFICATION-BASE",
      "normalized_sha256": "ab94eb4e17ea649d7db0e05e93af0a499c8404ccaeeb0cd94c18f140105fb6db",
      "rationale": "Macro expansion naming the closure value installed for the translated function.",
      "source_rule_id": "rule-ab94eb4e17ea649d7db0e05e93af0a499c8404ccaeeb0cd94c18f140105fb6db",
      "start_line": 106,
      "text": "  rule minSubArraySumClosure =>\n       closureVal(\n         (\"nums\", .ParamNames),\n         minSubArraySumBody,\n         0)"
    }
  ],
