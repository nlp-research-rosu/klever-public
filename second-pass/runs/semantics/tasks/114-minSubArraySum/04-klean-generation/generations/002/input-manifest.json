      "normalized_sha256": "ebdc46c197940f4814a9d88d03be7d1724ee648b5ba27ec4399dcd5e0a3104a8",
      "rationale": "Its exact loop-summary reachability statement is first proved as the LOOP-SPEC claim against VERIFICATION-BASE, which lacks this rule, before prove.sh compiles VERIFICATION and reuses it.",
      "source_rule_id": "rule-ebdc46c197940f4814a9d88d03be7d1724ee648b5ba27ec4399dcd5e0a3104a8",
      "start_line": 119,
      "text": "  rule <k>\n         #loop(\n           list(intVals(iCons(I:Int, R:IntSeq))),\n           Name(\"value\"),\n           kadaneBody)\n         => .K\n         ...\n       </k>\n       <env> L:Int </env>\n       <scopes>\n         ...\n         L |-> scope(\n           ((\"nums\" |-> INPUT:Val)\n            (\"smallest\" |-> B:Int)\n            (\"current\" |-> C:Int)\n            (\"value\" |-> _OLD:Val))\n             =>\n           ((\"nums\" |-> INPUT)\n            (\"smallest\" |->\n               kadaneSmallest(iCons(I, R), C, B))\n            (\"current\" |->\n               kadaneCurrent(iCons(I, R), C))\n            (\"value\" |-> lastFrom(R, I))),\n           parent(0))\n         ...\n       </scopes>\n    [priority(30)]"
    }
  ],
