Module(
  FuncDef("minSubArraySum", Params("nums"),
    Expr(
      Str(
        "\n    Given an array of integers nums, find the minimum sum of any non-empty\n    sub-array of nums.\n    "))
    Assign(Name("smallest"), Subscript(Name("nums"), Int(0)))
    Assign(Name("current"), Int(0))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("nums"),
      Assign(
        Name("current"),
        BinOp("+", Name("current"), Name("value")))
      If(Compare(Name("value"), CmpOp("<", Name("current"))),
        Assign(Name("current"), Name("value")),
        )
      If(Compare(Name("current"), CmpOp("<", Name("smallest"))),
        Assign(Name("smallest"), Name("current")),
        ))
    Return(Name("smallest")))
  Assert(
    Compare(
      Call(
        Name("minSubArraySum"),
        ListExpr(Int(2), Int(3), Int(4), Int(1), Int(2), Int(4))),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(
        Name("minSubArraySum"),
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(3)))),
      CmpOp("==", UnaryOp("-", Int(6)))))
  Assert(
    Compare(
      Call(Name("minSubArraySum"), ListExpr(Int(5))),
      CmpOp("==", Int(5))))
  Assert(
    Compare(
      Call(
        Name("minSubArraySum"),
        ListExpr(
          Int(3),
          UnaryOp("-", Int(4)),
          Int(2),
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(1)),
          Int(7),
          UnaryOp("-", Int(5)))),
      CmpOp("==", UnaryOp("-", Int(6)))))
  Assert(
    Compare(
      Call(Name("minSubArraySum"), ListExpr(Int(0), Int(0))),
      CmpOp("==", Int(0)))))
