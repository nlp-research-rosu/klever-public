+         ("value" |-> 0))
+          =>
+        (("nums" |-> list(intVals(iCons(1, .IntSeq))))
+         ("smallest" |-> 1)
+         ("current" |-> 1)
+         ("value" |-> 1)),
+        parent(0))
+    </scopes>
+endmodule
