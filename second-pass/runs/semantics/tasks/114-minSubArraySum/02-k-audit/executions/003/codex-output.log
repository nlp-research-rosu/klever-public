def minSubArraySum(nums):
    """
    Given an array of integers nums, find the minimum sum of any non-empty sub-array
    of nums.
    Example
    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1
    minSubArraySum([-1, -2, -3]) == -6
    """
# canonical.py — the UNMODIFIED HumanEval/114 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: minSubArraySum


def minSubArraySum(nums):
    """
    Given an array of integers nums, find the minimum sum of any non-empty sub-array
    of nums.
    Example
    minSubArraySum([2, 3, 4, 1, 2, 4]) == 1
    minSubArraySum([-1, -2, -3]) == -6
    """
    max_sum = 0
    s = 0
    for num in nums:
        s += -num
        if (s < 0):
            s = 0
        max_sum = max(s, max_sum)
    if max_sum == 0:
        max_sum = max(-i for i in nums)
    min_sum = -max_sum
    return min_sum
def minSubArraySum(nums):
    """
    Given an array of integers nums, find the minimum sum of any non-empty
    sub-array of nums.
    """
    smallest = nums[0]
    current = 0
    value = 0
    for value in nums:
        current = current + value
        if value < current:
            current = value
        if current < smallest:
            smallest = current
    return smallest
Module(
  FuncDef("minSubArraySum", Params("nums"),
    Expr(
      Str(
        "\n    Given an array of integers nums, find the minimum sum of any non-empty\n    sub-array of nums.\n    "))
    Assign(Name("smallest"), Subscript(Name("nums"), Int(0)))
    Assign(Name("current"), Int(0))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("nums"),
      Assign(
        Name("current"),
        BinOp("+", Name("current"), Name("value")))
      If(Compare(Name("value"), CmpOp("<", Name("current"))),
        Assign(Name("current"), Name("value")),
        )
      If(Compare(Name("current"), CmpOp("<", Name("smallest"))),
        Assign(Name("smallest"), Name("current")),
        ))
    Return(Name("smallest"))))
