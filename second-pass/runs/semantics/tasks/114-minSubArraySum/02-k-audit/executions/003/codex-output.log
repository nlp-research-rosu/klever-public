+branch_relations: dict[str, set[str]] = {
+    "value_vs_extended_current": set(),
+    "current_vs_smallest": set(),
+}
+
+
+def relation(left: int, right: int) -> str:
+    if left < right:
+        return "LT"
+    if left == right:
+        return "EQ"
+    return "GT"
+
+
+def observe_candidate_branches(nums: list[int]) -> None:
+    smallest = nums[0]
