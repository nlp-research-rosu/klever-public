+         ("current" |-> -2)
+         ("value" |-> -2)
+         ("after" |-> 99)),
+        parent(0))
+    </scopes>
+endmodule
+
+module CONTINUATION-SENSITIVITY-BRIDGE-SPEC
+  imports VERIFICATION
+
