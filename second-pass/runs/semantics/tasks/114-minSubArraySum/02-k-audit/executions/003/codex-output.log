+  claim
+    <k>
+      #applyK(
+        toCall(minSubArraySumClosure),
+        (list(intVals(
+          iCons(2, iCons(3, iCons(4, iCons(1, iCons(2, iCons(4, .IntSeq)))))))),
+         .Vals))
+      => 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
