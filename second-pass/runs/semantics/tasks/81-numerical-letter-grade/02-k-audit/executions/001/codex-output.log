+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+  printf 'START_UTC: '
+  date -u +'%Y-%m-%dT%H:%M:%SZ'
+} >"$log_file"
+
+"$@" >>"$log_file" 2>&1
+command_status=$?
+
+{
+  printf 'EXIT_STATUS: %d\n' "$command_status"
+  printf 'END_UTC: '
+  date -u +'%Y-%m-%dT%H:%M:%SZ'
+} >>"$log_file"
+
+exit "$command_status"

