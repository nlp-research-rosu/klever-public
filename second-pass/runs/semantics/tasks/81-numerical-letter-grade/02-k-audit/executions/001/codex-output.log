     1	def numerical_letter_grade(grades):
     2	    result = []
     3	    grade = 0.0
     4	    for grade in grades:
     5	        grade = float(grade)
     6	        if grade == 4.0:
     7	            result.append("A+")
     8	        elif grade > 3.7:
     9	            result.append("A")
    10	        elif grade > 3.3:
    11	            result.append("A-")
    12	        elif grade > 3.0:
    13	            result.append("B+")
    14	        elif grade > 2.7:
    15	            result.append("B")
    16	        elif grade > 2.3:
    17	            result.append("B-")
    18	        elif grade > 2.0:
    19	            result.append("C+")
    20	        elif grade > 1.7:
    21	            result.append("C")
    22	        elif grade > 1.3:
    23	            result.append("C-")
    24	        elif grade > 1.0:
    25	            result.append("D+")
    26	        elif grade > 0.7:
    27	            result.append("D")
    28	        elif grade > 0.0:
    29	            result.append("D-")
    30	        else:
    31	            result.append("E")
    32	    return result
