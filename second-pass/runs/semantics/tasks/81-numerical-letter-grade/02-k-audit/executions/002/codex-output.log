/bin/bash -lc "set -o pipefail
{
  echo 'COMMAND: kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.loop-maps-all-numeric-grades'
  kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.loop-maps-all-numeric-grades
} 2>&1 | tee /audit-output/evidence/stage3_kprove_loop-maps-all-numeric-grades.log
rc="'${PIPESTATUS[0]}
echo "EXIT_STATUS=$rc" | tee -a /audit-output/evidence/stage3_kprove_loop-maps-all-numeric-grades.log
