diff --git a//tmp/audit-work/candidate/oracle-false.py b//tmp/audit-work/candidate/oracle-false.py
new file mode 100644
index 0000000000000000000000000000000000000000..c8a804c04b7710e1a04ac1931bf7052bd4d6dfc2
--- /dev/null
+++ b//tmp/audit-work/candidate/oracle-false.py
@@ -0,0 +1,35 @@
+def numerical_letter_grade(grades):
+    result = []
+    grade = 0.0
+    for grade in grades:
+        grade = float(grade)
+        if grade == 4.0:
+            result.append("A+")
+        elif grade > 3.7:
+            result.append("A")
+        elif grade > 3.3:
+            result.append("A-")
+        elif grade > 3.0:
+            result.append("B+")
+        elif grade > 2.7:
+            result.append("B")
+        elif grade > 2.3:
+            result.append("B-")
+        elif grade > 2.0:
+            result.append("C+")
+        elif grade > 1.7:
+            result.append("C")
+        elif grade > 1.3:
+            result.append("C-")
+        elif grade > 1.0:
+            result.append("D+")
+        elif grade > 0.7:
+            result.append("D")
+        elif grade > 0.0:
+            result.append("D-")
+        else:
+            result.append("E")
+    return result
+
+
+assert numerical_letter_grade([3.9]) == ["A+"]
