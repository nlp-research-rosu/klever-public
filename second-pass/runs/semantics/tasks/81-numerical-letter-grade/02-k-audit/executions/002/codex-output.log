+)
+compare_hash(
+    "candidate tree legacy pipeline digest",
+    candidate_tree_digest,
+    invocation_document["retained_workspace_sha256"],
+)
+compare_hash(
+    "candidate reference semantics current audit digest (different encoding)",
+    candidate_semantics_digest,
