onfig_noproxy; fi if [ -n "${__CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_45}" ]; then export npm_config_proxy="${__CODEX_SNAPSHOT_PROXY_OVERRIDE_45}"; else unset npm_config_proxy; fi if [ -n "${__CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_46}" ]; then export ws_proxy="${__CODEX_SNAPSHOT_PROXY_OVERRIDE_46}"; else unset ws_proxy; fi if [ -n "${__CODEX_SNAPSHOT_PROXY_OVERRIDE_SET_47}" ]; then export wss_proxy="${__CODEX_SNAPSHOT_PROXY_OVERRIDE_47}"; else unset wss_proxy; fi fi if [ -n "${PATH:-}" ]; then export PATH='/usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/codex-path':"$PATH"; else export PATH='/usr/local/lib/node_modules/@openai/codex/node_modules/@openai/codex-linux-x64/vendor/x86_64-unknown-linux-musl/codex-path'; fi  exec '/bin/bash' -c 'echo '"'"'DIAGNOSTIC_INTERRUPTED_EXIT_STATUS=130 (reviewer stopped function-only run after 6m20s; loop circularity was excluded by --claims)'"'"' | tee -a /audit-output/evidence/stage3_kprove_function-maps-all-numeric-grades.log ps -eo pid,cmd | rg '"'"'kprove|kore-exec'"'"' || true'
