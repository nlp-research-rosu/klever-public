index 0000000000000000000000000000000000000000..83f264c7d8a720026f4c93ebead75c8732af743d
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,30 @@
+def numerical_letter_grade(grades):
+    result = []
+    for grade in grades:
+        if grade == 4.0:
+            result.append("A+")
+        elif grade > 3.7:
+            result.append("A")
+        elif grade > 3.3:
+            result.append("A-")
+        elif grade > 3.0:
+            result.append("B+")
+        elif grade > 2.7:
+            result.append("B")
+        elif grade > 2.3:
+            result.append("B-")
+        elif grade > 2.0:
+            result.append("C+")
+        elif grade > 1.7:
+            result.append("C")
+        elif grade > 1.3:
+            result.append("C-")
+        elif grade > 1.0:
+            result.append("D+")
+        elif grade > 0.7:
+            result.append("D")
+        elif grade > 0.0:
+            result.append("D-")
+        else:
+            result.append("E")
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..0d10af6c75c5de27c59b6389f4fa9074ab4ffbea
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [empty]:
+    <k> runGrades(.ValSeq) => ref(0) </k>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+
+  claim [a-plus]:
+    <k> runGrades(vCons(F:Float, .ValSeq))
+      => ref(0)
+    </k>
+    <heap> .Map
+      => 0 |-> list(vCons(letter("A+"), .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    requires eqFour(F)
+
+  claim [a]:
+    <k> runGrades(vCons(F:Float, .ValSeq))
+      => ref(0)
+    </k>
+    <heap> .Map
+      => 0 |-> list(vCons(letter("A"), .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    requires notBool eqFour(F)
+     andBool above(F, 3.7)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c0f60cf0f3ce92b9d820e7189c0e166a89219c33
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,72 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The body below is exactly the body emitted in solution.mpy.  runGrades
+  // invokes that body as a one-argument module-level Python closure.
+  syntax Stmts ::= "numericalLetterGradeBody" [macro]
+  rule numericalLetterGradeBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       For(Name("grade"), Name("grades"),
+         If(Compare(Name("grade"), CmpOp("==", Float(4.0))),
+           Expr(Call(Attribute(Name("result"), "append"),
+                     (Str("A+"), .Exprs))),
+           If(Compare(Name("grade"), CmpOp(">", Float(3.7))),
+             Expr(Call(Attribute(Name("result"), "append"),
+                       (Str("A"), .Exprs))),
+             If(Compare(Name("grade"), CmpOp(">", Float(3.3))),
+               Expr(Call(Attribute(Name("result"), "append"),
+                         (Str("A-"), .Exprs))),
+               If(Compare(Name("grade"), CmpOp(">", Float(3.0))),
+                 Expr(Call(Attribute(Name("result"), "append"),
+                           (Str("B+"), .Exprs))),
+                 If(Compare(Name("grade"), CmpOp(">", Float(2.7))),
+                   Expr(Call(Attribute(Name("result"), "append"),
+                             (Str("B"), .Exprs))),
+                   If(Compare(Name("grade"), CmpOp(">", Float(2.3))),
+                     Expr(Call(Attribute(Name("result"), "append"),
+                               (Str("B-"), .Exprs))),
+                     If(Compare(Name("grade"), CmpOp(">", Float(2.0))),
+                       Expr(Call(Attribute(Name("result"), "append"),
+                                 (Str("C+"), .Exprs))),
+                       If(Compare(Name("grade"), CmpOp(">", Float(1.7))),
+                         Expr(Call(Attribute(Name("result"), "append"),
+                                   (Str("C"), .Exprs))),
+                         If(Compare(Name("grade"), CmpOp(">", Float(1.3))),
+                           Expr(Call(Attribute(Name("result"), "append"),
+                                     (Str("C-"), .Exprs))),
+                           If(Compare(Name("grade"), CmpOp(">", Float(1.0))),
+                             Expr(Call(Attribute(Name("result"), "append"),
+                                       (Str("D+"), .Exprs))),
+                             If(Compare(Name("grade"), CmpOp(">", Float(0.7))),
+                               Expr(Call(Attribute(Name("result"), "append"),
+                                         (Str("D"), .Exprs))),
+                               If(Compare(Name("grade"), CmpOp(">", Float(0.0))),
+                                 Expr(Call(Attribute(Name("result"), "append"),
+                                           (Str("D-"), .Exprs))),
+                                 Expr(Call(Attribute(Name("result"), "append"),
+                                           (Str("E"), .Exprs))))))))))))))))
+       Return(Name("result"))
+
+  syntax KItem ::= runGrades(ValSeq)
+  rule <k> runGrades(VS:ValSeq)
+        => #applyK(
+             toCall(closureVal("grades", numericalLetterGradeBody, 0)),
+             (list(VS), .Vals))
+        ... </k>
+
+  syntax Val ::= letter(String) [function, total]
+  rule letter(S:String) => str(strToCodes(S))
+
+  syntax Bool ::= eqFour(Float) [function, total]
+                | above(Float, Float) [function, total]
+  syntax Bool ::= gpaEqFour(Val)
+                  [function, total, symbol(gpaEqFour), no-evaluators]
+  rule <k> Compare(F:Float, CmpOp("==", 4.0))
+        => gpaEqFour(F)
+        ... </k>
+       [priority(40)]
+  rule eqFour(F:Float)  => gpaEqFour(F)
+  rule above(F:Float, T:Float) => gtF(F, T)
+endmodule

