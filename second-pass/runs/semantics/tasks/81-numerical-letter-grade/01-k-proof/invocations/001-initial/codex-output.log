+                                         (Str("D"), .Exprs))),
+                               If(Compare(Name("grade"), CmpOp(">", Float(0.0))),
+                                 Expr(Call(Attribute(Name("result"), "append"),
+                                           (Str("D-"), .Exprs))),
+                                 Expr(Call(Attribute(Name("result"), "append"),
+                                           (Str("E"), .Exprs)))))))))))))))
+
+  syntax Stmts ::= "numericalLetterGradeBody" [macro]
+  rule numericalLetterGradeBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       For(Name("grade"), Name("grades"), numericalLetterGradeStep)
+       Return(Name("result"))
+
+  syntax KItem ::= runGrades(ValSeq)
+  rule <k> runGrades(VS:ValSeq)
+        => #applyK(
+             toCall(closureVal("grades", numericalLetterGradeBody, 0)),
+             (list(VS), .Vals))
+        ... </k>
+
+  syntax Val ::= letter(String) [function, total]
+  rule letter(S:String) => str(strToCodes(S))
+
+  syntax Bool ::= eqFour(Float) [function, total]
+                | above(Float, Float) [function, total]
+  syntax Bool ::= gpaEqFour(Val)
+                  [function, total, symbol(gpaEqFour), no-evaluators]
+  rule <k> Compare(F:Float, CmpOp("==", 4.0))
+        => gpaEqFour(F)
+        ... </k>
+       [priority(40)]
+  rule eqFour(F:Float)  => gpaEqFour(F)
+  rule above(F:Float, T:Float) => gtF(F, T)
+
+  // A symbolic list domain and its mathematical map.  mappedAppend mirrors
+  // append's left-to-right accumulator shape, which gives the loop invariant
+  // an induction-friendly postcondition.
+  syntax FloatGrades ::= ".FloatGrades"
+                       | fGrade(Float, FloatGrades)
+  syntax ValSeq ::= floatValues(FloatGrades)
+  rule <k> #iterNext(list(floatValues(.FloatGrades)))
+        => #iterDone
+        ... </k>
+       [priority(40)]
+  rule <k> #iterNext(list(floatValues(fGrade(F:Float, FS:FloatGrades))))
+        => #iterYield(F, list(floatValues(FS)))
+        ... </k>
+       [priority(40)]
+
+  syntax Val ::= gradeOf(Float) [function]
+  rule gradeOf(F:Float) => letter("A+")
+    requires eqFour(F)
+  rule gradeOf(F:Float) => letter("A")
+    requires notBool eqFour(F)
+     andBool above(F, 3.7)
+  rule gradeOf(F:Float) => letter("A-")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool above(F, 3.3)
+  rule gradeOf(F:Float) => letter("B+")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool above(F, 3.0)
+  rule gradeOf(F:Float) => letter("B")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool above(F, 2.7)
+  rule gradeOf(F:Float) => letter("B-")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool above(F, 2.3)
+  rule gradeOf(F:Float) => letter("C+")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool above(F, 2.0)
+  rule gradeOf(F:Float) => letter("C")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool above(F, 1.7)
+  rule gradeOf(F:Float) => letter("C-")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool notBool above(F, 1.7)
+     andBool above(F, 1.3)
+  rule gradeOf(F:Float) => letter("D+")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool notBool above(F, 1.7)
+     andBool notBool above(F, 1.3)
+     andBool above(F, 1.0)
+  rule gradeOf(F:Float) => letter("D")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool notBool above(F, 1.7)
+     andBool notBool above(F, 1.3)
+     andBool notBool above(F, 1.0)
+     andBool above(F, 0.7)
+  rule gradeOf(F:Float) => letter("D-")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool notBool above(F, 1.7)
+     andBool notBool above(F, 1.3)
+     andBool notBool above(F, 1.0)
+     andBool notBool above(F, 0.7)
+     andBool above(F, 0.0)
+  rule gradeOf(F:Float) => letter("E")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool notBool above(F, 1.7)
+     andBool notBool above(F, 1.3)
+     andBool notBool above(F, 1.0)
+     andBool notBool above(F, 0.7)
+     andBool notBool above(F, 0.0)
+
+  syntax ValSeq ::= mappedAppend(ValSeq, FloatGrades) [function, total]
+  rule mappedAppend(PREFIX:ValSeq, .FloatGrades) => PREFIX
+  rule mappedAppend(PREFIX:ValSeq, fGrade(F:Float, FS:FloatGrades))
+    => mappedAppend(
+         valSeqConcat(PREFIX, vCons(gradeOf(F), .ValSeq)),
+         FS)
+
+  syntax Map ::= afterGradeBindings(Map, FloatGrades) [function, total]
+  rule afterGradeBindings(M:Map, .FloatGrades) => M
+  rule afterGradeBindings(M:Map, fGrade(F:Float, FS:FloatGrades))
+    => afterGradeBindings(M [ "grade" <- F ], FS)
+
+  syntax Float ::= afterGradeValue(Float, FloatGrades) [function, total]
+  rule afterGradeValue(OLD:Float, .FloatGrades) => OLD
+  rule afterGradeValue(_:Float, fGrade(F:Float, FS:FloatGrades))
+    => afterGradeValue(F, FS)
+endmodule

diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..9c558de7dedd0079ed8f7fcb4e5134b186df873e
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,43 @@
+def numerical_letter_grade(grades):
+    result = []
+    for grade in grades:
+        if grade == 4.0:
+            result.append("A+")
+        elif grade > 3.7:
+            result.append("A")
+        elif grade > 3.3:
+            result.append("A-")
+        elif grade > 3.0:
+            result.append("B+")
+        elif grade > 2.7:
+            result.append("B")
+        elif grade > 2.3:
+            result.append("B-")
+        elif grade > 2.0:
+            result.append("C+")
+        elif grade > 1.7:
+            result.append("C")
+        elif grade > 1.3:
+            result.append("C-")
+        elif grade > 1.0:
+            result.append("D+")
+        elif grade > 0.7:
+            result.append("D")
+        elif grade > 0.0:
+            result.append("D-")
+        else:
+            result.append("E")
+    return result
+
+
+assert numerical_letter_grade([]) == []
+assert numerical_letter_grade([4.0, 3, 1.7, 2, 3.5]) == [
+    "A+", "B", "C-", "C", "A-"
+]
+assert numerical_letter_grade([
+    4.0, 3.8, 3.7, 3.5, 3.3, 3.1, 3.0, 2.8, 2.7, 2.4, 2.3, 2.1,
+    2.0, 1.8, 1.7, 1.4, 1.3, 1.1, 1.0, 0.8, 0.7, 0.1, 0.0
+]) == [
+    "A+", "A", "A-", "A-", "B+", "B+", "B", "B", "B-", "B-", "C+",
+    "C+", "C", "C", "C-", "C-", "D+", "D+", "D", "D", "D-", "D-", "E"
+]
