index 0000000000000000000000000000000000000000..83f264c7d8a720026f4c93ebead75c8732af743d
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,30 @@
+def numerical_letter_grade(grades):
+    result = []
+    for grade in grades:
+        if grade == 4.0:
+            result.append("A+")
+        elif grade > 3.7:
+            result.append("A")
+        elif grade > 3.3:
+            result.append("A-")
+        elif grade > 3.0:
