+            result.append("C")
+        elif grade > 1.3:
+            result.append("C-")
+        elif grade > 1.0:
+            result.append("D+")
+        elif grade > 0.7:
+            result.append("D")
+        elif grade > 0.0:
+            result.append("D-")
+        else:
+            result.append("E")
+    return result
