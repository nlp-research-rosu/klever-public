+        elif grade > 2.3:
+            result.append("B-")
+        elif grade > 2.0:
+            result.append("C+")
+        elif grade > 1.7:
+            result.append("C")
+        elif grade > 1.3:
+            result.append("C-")
+        elif grade > 1.0:
+            result.append("D+")
