+       1  |-> scope(
+               "grade"  |-> OLD:Float
+               "grades" |-> INPUT:Val
+               "result" |-> ref(0),
+               parent(0)))
+      =>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope
+       1  |-> scope(
+               "grade"  |-> afterGradeValue(OLD, GS)
+               "grades" |-> INPUT
+               "result" |-> ref(0),
+               parent(0)))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      (0 |-> list(PREFIX:ValSeq) HP:Map)
+      =>
+      (0 |-> list(mappedAppend(PREFIX, GS)) HP)
+    </heap>
+    <heapLoc> _N:Int </heapLoc>
+    <stack> _STACK:List </stack>
+    <ret> noRet </ret>
