+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [empty]:
+    <k> runGrades(.ValSeq) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+
+  claim [a-plus]:
+    <k> runGrades(vCons(F:Float, .ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map
+      => 0 |-> list(vCons(letter("A+"), .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires eqFour(F)
+
+  claim [a]:
+    <k> runGrades(vCons(F:Float, .ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map
+      => 0 |-> list(vCons(letter("A"), .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires notBool eqFour(F)
+     andBool above(F, 3.7)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..bf733b2f26edb7979f600a473ec179d69190918a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,196 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // These macros expand to exactly the body emitted in solution.mpy.
+  syntax Stmt ::= "numericalLetterGradeStep" [macro]
+  rule numericalLetterGradeStep
+    => If(Compare(Name("grade"), CmpOp("==", Float(4.0))),
+           Expr(Call(Attribute(Name("result"), "append"),
+                     (Str("A+"), .Exprs))),
+           If(Compare(Name("grade"), CmpOp(">", Float(3.7))),
+             Expr(Call(Attribute(Name("result"), "append"),
+                       (Str("A"), .Exprs))),
+             If(Compare(Name("grade"), CmpOp(">", Float(3.3))),
+               Expr(Call(Attribute(Name("result"), "append"),
+                         (Str("A-"), .Exprs))),
+               If(Compare(Name("grade"), CmpOp(">", Float(3.0))),
+                 Expr(Call(Attribute(Name("result"), "append"),
+                           (Str("B+"), .Exprs))),
+                 If(Compare(Name("grade"), CmpOp(">", Float(2.7))),
+                   Expr(Call(Attribute(Name("result"), "append"),
+                             (Str("B"), .Exprs))),
+                   If(Compare(Name("grade"), CmpOp(">", Float(2.3))),
+                     Expr(Call(Attribute(Name("result"), "append"),
+                               (Str("B-"), .Exprs))),
+                     If(Compare(Name("grade"), CmpOp(">", Float(2.0))),
+                       Expr(Call(Attribute(Name("result"), "append"),
+                                 (Str("C+"), .Exprs))),
+                       If(Compare(Name("grade"), CmpOp(">", Float(1.7))),
+                         Expr(Call(Attribute(Name("result"), "append"),
+                                   (Str("C"), .Exprs))),
+                         If(Compare(Name("grade"), CmpOp(">", Float(1.3))),
+                           Expr(Call(Attribute(Name("result"), "append"),
+                                     (Str("C-"), .Exprs))),
+                           If(Compare(Name("grade"), CmpOp(">", Float(1.0))),
+                             Expr(Call(Attribute(Name("result"), "append"),
+                                       (Str("D+"), .Exprs))),
+                             If(Compare(Name("grade"), CmpOp(">", Float(0.7))),
+                               Expr(Call(Attribute(Name("result"), "append"),
+                                         (Str("D"), .Exprs))),
+                               If(Compare(Name("grade"), CmpOp(">", Float(0.0))),
+                                 Expr(Call(Attribute(Name("result"), "append"),
+                                           (Str("D-"), .Exprs))),
+                                 Expr(Call(Attribute(Name("result"), "append"),
+                                           (Str("E"), .Exprs)))))))))))))))
+
+  syntax Stmts ::= "numericalLetterGradeBody" [macro]
+  rule numericalLetterGradeBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       For(Name("grade"), Name("grades"), numericalLetterGradeStep)
+       Return(Name("result"))
+
+  syntax KItem ::= runGrades(ValSeq)
+  rule <k> runGrades(VS:ValSeq)
+        => #applyK(
+             toCall(closureVal("grades", numericalLetterGradeBody, 0)),
+             (list(VS), .Vals))
+        ... </k>
+
+  syntax Val ::= letter(String) [function, total]
+  rule letter(S:String) => str(strToCodes(S))
+
+  syntax Bool ::= eqFour(Float) [function, total]
+                | above(Float, Float) [function, total]
+  syntax Bool ::= gpaEqFour(Val)
+                  [function, total, symbol(gpaEqFour), no-evaluators]
+  rule <k> Compare(F:Float, CmpOp("==", 4.0))
+        => gpaEqFour(F)
+        ... </k>
+       [priority(40)]
+  rule eqFour(F:Float)  => gpaEqFour(F)
+  rule above(F:Float, T:Float) => gtF(F, T)
+
+  // A symbolic list domain and its mathematical map.  mappedAppend mirrors
+  // append's left-to-right accumulator shape, which gives the loop invariant
+  // an induction-friendly postcondition.
+  syntax FloatGrades ::= ".FloatGrades"
+                       | fGrade(Float, FloatGrades)
+  syntax ValSeq ::= floatValues(FloatGrades) [function, total]
+  rule floatValues(.FloatGrades) => .ValSeq
+  rule floatValues(fGrade(F:Float, FS:FloatGrades))
+    => vCons(F, floatValues(FS))
+
+  syntax Val ::= gradeOf(Float) [function]
+  rule gradeOf(F:Float) => letter("A+")
+    requires eqFour(F)
+  rule gradeOf(F:Float) => letter("A")
+    requires notBool eqFour(F)
+     andBool above(F, 3.7)
+  rule gradeOf(F:Float) => letter("A-")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool above(F, 3.3)
+  rule gradeOf(F:Float) => letter("B+")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool above(F, 3.0)
+  rule gradeOf(F:Float) => letter("B")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool above(F, 2.7)
+  rule gradeOf(F:Float) => letter("B-")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool above(F, 2.3)
+  rule gradeOf(F:Float) => letter("C+")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool above(F, 2.0)
+  rule gradeOf(F:Float) => letter("C")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool above(F, 1.7)
+  rule gradeOf(F:Float) => letter("C-")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool notBool above(F, 1.7)
+     andBool above(F, 1.3)
+  rule gradeOf(F:Float) => letter("D+")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool notBool above(F, 1.7)
+     andBool notBool above(F, 1.3)
+     andBool above(F, 1.0)
+  rule gradeOf(F:Float) => letter("D")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool notBool above(F, 1.7)
+     andBool notBool above(F, 1.3)
+     andBool notBool above(F, 1.0)
+     andBool above(F, 0.7)
+  rule gradeOf(F:Float) => letter("D-")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool notBool above(F, 1.7)
+     andBool notBool above(F, 1.3)
+     andBool notBool above(F, 1.0)
+     andBool notBool above(F, 0.7)
+     andBool above(F, 0.0)
+  rule gradeOf(F:Float) => letter("E")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool notBool above(F, 1.7)
+     andBool notBool above(F, 1.3)
+     andBool notBool above(F, 1.0)
+     andBool notBool above(F, 0.7)
+     andBool notBool above(F, 0.0)
+
+  syntax ValSeq ::= mappedAppend(ValSeq, FloatGrades) [function, total]
+  rule mappedAppend(PREFIX:ValSeq, .FloatGrades) => PREFIX
+  rule mappedAppend(PREFIX:ValSeq, fGrade(F:Float, FS:FloatGrades))
+    => mappedAppend(
+         valSeqConcat(PREFIX, vCons(gradeOf(F), .ValSeq)),
+         FS)
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module SPEC --claims SPEC.a' in /work
