+          list(floatValues(FS:FloatGrades)),
+          Name("grade"),
+          numericalLetterGradeStep)
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope
+       1  |-> scope(
+               "grade"  |-> OLD:Float
+               "result" |-> ref(0),
+               parent(0)))
+      =>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope
