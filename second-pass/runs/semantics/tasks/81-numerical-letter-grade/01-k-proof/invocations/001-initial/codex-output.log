diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..449b5ca2fc0bb0dd4242aabfa2579fc816556dec
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,55 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [empty]:
+    <k> runGrades(.ValSeq) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+
+  claim [a-plus]:
+    <k> runGrades(vCons(F:Float, .ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map
+      => 0 |-> list(vCons(letter("A+"), .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires eqFour(F)
+
+  claim [a]:
+    <k> runGrades(vCons(F:Float, .ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map
+      => 0 |-> list(vCons(letter("A"), .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires notBool eqFour(F)
+     andBool above(F, 3.7)
+endmodule
