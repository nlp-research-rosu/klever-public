+    </k>
+    <env> 1 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope
+       1  |-> scope(("result" |-> ref(0)) M:Map, parent(0)))
+      =>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope
+       1  |-> scope(
+               afterGradeBindings(("result" |-> ref(0)) M, FS),
+               parent(0)))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      (0 |-> list(PREFIX:ValSeq) HP:Map)
+      =>
+      (0 |-> list(mappedAppend(PREFIX, FS)) HP)
+    </heap>
+    <heapLoc> N:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires notBool ("$cells" in_keys(M))
+     andBool notBool ("result" in_keys(M))
+     andBool notBool (0 in_keys(HP))
+endmodule
