+      => 0 |-> list(vCons(letter("A+"), .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires eqFour(F)
+
+  claim [a]:
+    <k> runGrades(vCons(F:Float, .ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
