+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [empty]:
+    <k> runGrades(.ValSeq) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+
+  claim [a-plus]:
+    <k> runGrades(vCons(F:Float, .ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map
+      => 0 |-> list(vCons(letter("A+"), .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires eqFour(F)
+
+  claim [a]:
+    <k> runGrades(vCons(F:Float, .ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map
+      => 0 |-> list(vCons(letter("A"), .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires notBool eqFour(F)
+     andBool above(F, 3.7)
+
+  claim [function-maps-all-numeric-grades]:
+    <k> runGrades(numericValues(GS:NumericGrades))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(mappedAppend(.ValSeq, GS))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+
+  claim [loop-maps-all-numeric-grades]:
+    <k>
+      #loop(
+          list(numericValues(GS:NumericGrades)),
+          Name("grade"),
+          Assign(Name("grade"),
+            Call(Name("float"), (Name("grade"), .Exprs)))
+          numericalLetterGradeStep)
+      ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope
+       1  |-> scope(
+               "grade"  |-> OLD:Float
+               "grades" |-> INPUT:Val
+               "result" |-> ref(0),
+               parent(0)))
+      =>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope
+       1  |-> scope(
+               "grade"  |-> afterGradeValue(OLD, GS)
+               "grades" |-> INPUT
+               "result" |-> ref(0),
+               parent(0)))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap>
+      (0 |-> list(PREFIX:ValSeq) HP:Map)
+      =>
+      (0 |-> list(mappedAppend(PREFIX, GS)) HP)
+    </heap>
+    <heapLoc> _N:Int </heapLoc>
+    <stack> _STACK:List </stack>
+    <ret> noRet </ret>
+    requires notBool (0 in_keys(HP))
+
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f544cd6455366d8f29baf2ca361becda3081d55a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,221 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // These macros expand to exactly the body emitted in solution.mpy.
+  syntax Stmt ::= "numericalLetterGradeStep" [macro]
+  rule numericalLetterGradeStep
+    => If(Compare(Name("grade"), CmpOp("==", Float(4.0))),
+           Expr(Call(Attribute(Name("result"), "append"),
+                     (Str("A+"), .Exprs))),
+           If(Compare(Name("grade"), CmpOp(">", Float(3.7))),
+             Expr(Call(Attribute(Name("result"), "append"),
+                       (Str("A"), .Exprs))),
+             If(Compare(Name("grade"), CmpOp(">", Float(3.3))),
+               Expr(Call(Attribute(Name("result"), "append"),
+                         (Str("A-"), .Exprs))),
+               If(Compare(Name("grade"), CmpOp(">", Float(3.0))),
+                 Expr(Call(Attribute(Name("result"), "append"),
+                           (Str("B+"), .Exprs))),
+                 If(Compare(Name("grade"), CmpOp(">", Float(2.7))),
+                   Expr(Call(Attribute(Name("result"), "append"),
+                             (Str("B"), .Exprs))),
+                   If(Compare(Name("grade"), CmpOp(">", Float(2.3))),
+                     Expr(Call(Attribute(Name("result"), "append"),
+                               (Str("B-"), .Exprs))),
+                     If(Compare(Name("grade"), CmpOp(">", Float(2.0))),
+                       Expr(Call(Attribute(Name("result"), "append"),
+                                 (Str("C+"), .Exprs))),
+                       If(Compare(Name("grade"), CmpOp(">", Float(1.7))),
+                         Expr(Call(Attribute(Name("result"), "append"),
+                                   (Str("C"), .Exprs))),
+                         If(Compare(Name("grade"), CmpOp(">", Float(1.3))),
+                           Expr(Call(Attribute(Name("result"), "append"),
+                                     (Str("C-"), .Exprs))),
+                           If(Compare(Name("grade"), CmpOp(">", Float(1.0))),
+                             Expr(Call(Attribute(Name("result"), "append"),
+                                       (Str("D+"), .Exprs))),
+                             If(Compare(Name("grade"), CmpOp(">", Float(0.7))),
+                               Expr(Call(Attribute(Name("result"), "append"),
+                                         (Str("D"), .Exprs))),
+                               If(Compare(Name("grade"), CmpOp(">", Float(0.0))),
+                                 Expr(Call(Attribute(Name("result"), "append"),
+                                           (Str("D-"), .Exprs))),
+                                 Expr(Call(Attribute(Name("result"), "append"),
+                                           (Str("E"), .Exprs)))))))))))))))
+
+  syntax Stmts ::= "numericalLetterGradeBody" [macro]
+  rule numericalLetterGradeBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("grade"), Float(0.0))
+       For(Name("grade"), Name("grades"),
+         Assign(Name("grade"),
+           Call(Name("float"), (Name("grade"), .Exprs)))
+         numericalLetterGradeStep)
+       Return(Name("result"))
+
+  syntax KItem ::= runGrades(ValSeq)
+  rule <k> runGrades(VS:ValSeq)
+        => #applyK(
+             toCall(closureVal("grades", numericalLetterGradeBody, 0)),
+             (list(VS), .Vals))
+        ... </k>
+
+  syntax Val ::= letter(String) [function, total]
+  rule letter(S:String) => str(strToCodes(S))
+
+  syntax Bool ::= eqFour(Float) [function, total]
+                | above(Float, Float) [function, total]
+  syntax Bool ::= gpaEqFour(Val)
+                  [function, total, symbol(gpaEqFour), no-evaluators]
+  rule <k> Compare(F:Float, CmpOp("==", 4.0))
+        => gpaEqFour(F)
+        ... </k>
+       [priority(40)]
+  rule eqFour(F:Float)  => gpaEqFour(F)
+  rule above(F:Float, T:Float) => gtF(F, T)
+
+  // A symbolic numeric-list domain and its mathematical map.  mappedAppend mirrors
+  // append's left-to-right accumulator shape, which gives the loop invariant
+  // an induction-friendly postcondition.
+  syntax NumericGrades ::= ".NumericGrades"
+                         | fGrade(Float, NumericGrades)
+                         | iGrade(Int, NumericGrades)
+  syntax ValSeq ::= numericValues(NumericGrades)
+  rule <k> #iterNext(list(numericValues(.NumericGrades)))
+        => #iterDone
+        ... </k>
+       [priority(40)]
+  rule <k> #iterNext(list(numericValues(fGrade(F:Float, GS:NumericGrades))))
+        => #iterYield(F, list(numericValues(GS)))
+        ... </k>
+       [priority(40)]
+  rule <k> #iterNext(list(numericValues(iGrade(I:Int, GS:NumericGrades))))
+        => #iterYield(I, list(numericValues(GS)))
+        ... </k>
+       [priority(40)]
+
+  syntax Val ::= gradeOf(Float) [function]
+  rule gradeOf(F:Float) => letter("A+")
+    requires eqFour(F)
+  rule gradeOf(F:Float) => letter("A")
+    requires notBool eqFour(F)
+     andBool above(F, 3.7)
+  rule gradeOf(F:Float) => letter("A-")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool above(F, 3.3)
+  rule gradeOf(F:Float) => letter("B+")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool above(F, 3.0)
+  rule gradeOf(F:Float) => letter("B")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool above(F, 2.7)
+  rule gradeOf(F:Float) => letter("B-")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool above(F, 2.3)
+  rule gradeOf(F:Float) => letter("C+")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool above(F, 2.0)
+  rule gradeOf(F:Float) => letter("C")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool above(F, 1.7)
+  rule gradeOf(F:Float) => letter("C-")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool notBool above(F, 1.7)
+     andBool above(F, 1.3)
+  rule gradeOf(F:Float) => letter("D+")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool notBool above(F, 1.7)
+     andBool notBool above(F, 1.3)
+     andBool above(F, 1.0)
+  rule gradeOf(F:Float) => letter("D")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool notBool above(F, 1.7)
+     andBool notBool above(F, 1.3)
+     andBool notBool above(F, 1.0)
+     andBool above(F, 0.7)
+  rule gradeOf(F:Float) => letter("D-")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool notBool above(F, 1.7)
+     andBool notBool above(F, 1.3)
+     andBool notBool above(F, 1.0)
+     andBool notBool above(F, 0.7)
+     andBool above(F, 0.0)
+  rule gradeOf(F:Float) => letter("E")
+    requires notBool eqFour(F)
+     andBool notBool above(F, 3.7)
+     andBool notBool above(F, 3.3)
+     andBool notBool above(F, 3.0)
+     andBool notBool above(F, 2.7)
+     andBool notBool above(F, 2.3)
+     andBool notBool above(F, 2.0)
+     andBool notBool above(F, 1.7)
+     andBool notBool above(F, 1.3)
+     andBool notBool above(F, 1.0)
+     andBool notBool above(F, 0.7)
+     andBool notBool above(F, 0.0)
+
+  syntax ValSeq ::= mappedAppend(ValSeq, NumericGrades) [function, total]
+  rule mappedAppend(PREFIX:ValSeq, .NumericGrades) => PREFIX
+  rule mappedAppend(PREFIX:ValSeq, fGrade(F:Float, GS:NumericGrades))
+    => mappedAppend(
+         valSeqConcat(PREFIX, vCons(gradeOf(F), .ValSeq)),
+         GS)
+  rule mappedAppend(PREFIX:ValSeq, iGrade(I:Int, GS:NumericGrades))
+    => mappedAppend(
+         valSeqConcat(PREFIX, vCons(gradeOf(intToF(I)), .ValSeq)),
+         GS)
+
+  syntax Float ::= afterGradeValue(Float, NumericGrades) [function, total]
+  rule afterGradeValue(OLD:Float, .NumericGrades) => OLD
+  rule afterGradeValue(_:Float, fGrade(F:Float, GS:NumericGrades))
+    => afterGradeValue(F, GS)
+  rule afterGradeValue(_:Float, iGrade(I:Int, GS:NumericGrades))
+    => afterGradeValue(intToF(I), GS)
+endmodule

Implemented and translated the solution, added concrete boundary/example tests, proved an arbitrary mixed int/float list theorem using a reusable loop invariant, and ran the final reproducible script successfully.
  ✓ Inspect prompt, translator, and reference semantics
  ✓ Implement solution.py and generate solution.mpy
  ✓ Create K verification harness and specification
  ✓ Compile and exercise concrete execution with krun
  ✓ Run all positive kprove commands and finalize prove.sh
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..1f82005d661844c22f5dc14925ff22321dd2b3a3
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,39 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Translate the submitted implementation with the fixed front end.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Ensure the concrete harness embeds exactly the submitted function, then
+# translate it for execution by the supplied LLVM semantics.
+python3 - <<'PY'
+import ast
+
+with open("solution.py", encoding="utf-8") as solution_file:
+    solution_tree = ast.parse(solution_file.read())
+with open("smoke.py", encoding="utf-8") as smoke_file:
+    smoke_tree = ast.parse(smoke_file.read())
+
+assert ast.dump(solution_tree.body[0]) == ast.dump(smoke_tree.body[0])
+PY
+python3 py2mpy.py smoke.py > smoke.mpy
+
+# Concrete execution uses the required concrete main module.
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun smoke.mpy \
+  --definition runtime-kompiled \
+  --output pretty
+
+# Symbolic verification imports MPY (not MPY-KRUN/MPY-CONCRETE).
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
diff --git a/smoke.py b/smoke.py
new file mode 100644
index 0000000000000000000000000000000000000000..94c40d2131cd220edc1ee3ad029b612f634c9cbf
--- /dev/null
+++ b/smoke.py
@@ -0,0 +1,45 @@
+def numerical_letter_grade(grades):
+    result = []
+    grade = 0.0
+    for grade in grades:
+        grade = float(grade)
+        if grade == 4.0:
+            result.append("A+")
+        elif grade > 3.7:
+            result.append("A")
+        elif grade > 3.3:
+            result.append("A-")
+        elif grade > 3.0:
+            result.append("B+")
+        elif grade > 2.7:
+            result.append("B")
+        elif grade > 2.3:
+            result.append("B-")
+        elif grade > 2.0:
+            result.append("C+")
+        elif grade > 1.7:
+            result.append("C")
+        elif grade > 1.3:
+            result.append("C-")
+        elif grade > 1.0:
+            result.append("D+")
+        elif grade > 0.7:
+            result.append("D")
+        elif grade > 0.0:
+            result.append("D-")
+        else:
+            result.append("E")
+    return result
+
+
+assert numerical_letter_grade([]) == []
+assert numerical_letter_grade([4.0, 3, 1.7, 2, 3.5]) == [
+    "A+", "B", "C-", "C", "A-"
+]
+assert numerical_letter_grade([
+    4.0, 3.8, 3.7, 3.5, 3.3, 3.1, 3.0, 2.8, 2.7, 2.4, 2.3, 2.1,
+    2.0, 1.8, 1.7, 1.4, 1.3, 1.1, 1.0, 0.8, 0.7, 0.1, 0.0
+]) == [
+    "A+", "A", "A-", "A-", "B+", "B+", "B", "B", "B-", "B-", "C+",
+    "C+", "C", "C", "C-", "C-", "D+", "D+", "D", "D", "D-", "D-", "E"
+]
