   112	               "grade"  |-> afterGradeValue(OLD, GS)
   113	               "result" |-> ref(0),
   114	               parent(0)))
   115	    </scopes>
   116	    <scopeLoc> 2 </scopeLoc>
   117	    <heap>
   118	      (0 |-> list(PREFIX:ValSeq) HP:Map)
   119	      =>
   120	      (0 |-> list(mappedAppend(PREFIX, GS)) HP)
   121	    </heap>
   122	    <heapLoc> N:Int </heapLoc>
   123	    <stack> .List </stack>
   124	    <ret> noRet </ret>
   125	    requires notBool (0 in_keys(HP))
   126	
   127	endmodule

