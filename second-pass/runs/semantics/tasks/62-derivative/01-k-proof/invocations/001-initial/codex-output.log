diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..8a7538b37f09d16672014638f9f81cb76d42496d
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,69 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive loop invariant.  It states that iterating over the still
+  // unprocessed coefficients extends the one stable result object with the
+  // mathematical derivative fold.
+  claim
+    <k>
+      #loop(
+        list(enumVS(INPUT:ValSeq, N:Int)),
+        derivativeTarget,
+        derivativeLoopStep
+        .Stmts
+      )
+      => .K
+    </k>
+    <env> LOCAL:Int </env>
+    <scopes>
+      OTHER:Map
+      LOCAL |->
+        scope(
+          "result" |-> ref(RESULT:Int)
+          LOCALS:Map,
+          PARENT:Parent
+        )
+      =>
+      OTHER
+      LOCAL |->
+        scope(
+          "result" |-> ref(RESULT)
+          ?FINAL-LOCALS:Map,
+          PARENT
+        )
+    </scopes>
+    <heap>
+      RESULT |-> list(ACC:ValSeq)
+      REST:Map
+      =>
+      RESULT |-> list(derivativeAcc(ACC, INPUT, N))
+      REST
+    </heap>
+    requires allInts(INPUT) andBool N >=Int 0
+
+  // Entry-point theorem for every finite list of integer coefficients.
+  claim
+    <k>
+      Call(Name("derivative"), list(INPUT:ValSeq))
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ?RESULT |-> list(derivativeSeq(INPUT))
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires allInts(INPUT)
+endmodule
