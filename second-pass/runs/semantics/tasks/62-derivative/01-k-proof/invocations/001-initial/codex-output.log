new file mode 100644
index 0000000000000000000000000000000000000000..909c8fcccafdeae23c12fb328ef36e863902f24a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,67 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports MAP-SYMBOLIC
+
+  // Domain predicate used by the specification: polynomial coefficients are
+  // integers, and their list may have arbitrary finite length.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(_:Int, REST:ValSeq)) => allInts(REST)
+  rule allInts(vCons(_:Val, _:ValSeq)) => false [owise]
+
+  // Executable mathematical fold for the derivative.  N is the original
+  // coefficient index and ACC is the already-produced prefix.
+  syntax ValSeq ::= derivativeAcc(ValSeq, ValSeq, Int) [function]
+                  | derivativeSeq(ValSeq) [function]
+  rule derivativeSeq(VS:ValSeq)
+    => derivativeAcc(.ValSeq, VS, 0)
+  rule derivativeAcc(ACC:ValSeq, .ValSeq, _:Int)
+    => ACC
+  rule derivativeAcc(ACC:ValSeq, vCons(_:Int, REST:ValSeq), 0)
+    => derivativeAcc(ACC, REST, 1)
+  rule derivativeAcc(ACC:ValSeq, vCons(I:Int, REST:ValSeq), N:Int)
+    => derivativeAcc(
+         valSeqConcat(ACC, vCons(N *Int I, .ValSeq)),
+         REST,
+         N +Int 1
+       )
+    requires N >Int 0
+
+  syntax Expr ::= "derivativeTarget" [macro]
+  rule derivativeTarget
+    => TupleExpr(Name("i"), Name("x"))
+
+  syntax Stmt ::= "derivativeLoopStep" [macro]
+  rule derivativeLoopStep
+    => If(
+         Compare(Name("i"), CmpOp(">", Int(0))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             BinOp("*", Name("i"), Name("x"))
+           )
+         )
+         .Stmts,
+         .Stmts
+       )
+
+  // The closure below is exactly the translated body in solution.mpy.
+  syntax Val ::= "derivativeClosure" [macro]
+  rule derivativeClosure
+    => closureVal(
+         ("xs", .ParamNames),
+         Expr(Str("Return the coefficients of the derivative of a polynomial."))
+         Assign(Name("result"), ListExpr(.Exprs))
+         For(
+           derivativeTarget,
+           Call(Name("enumerate"), Name("xs")),
+           derivativeLoopStep
+           .Stmts
+         )
+         Return(Name("result"))
+         .Stmts,
+         0
+       )
+endmodule

