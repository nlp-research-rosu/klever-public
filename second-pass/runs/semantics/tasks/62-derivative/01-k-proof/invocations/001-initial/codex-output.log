+def derivative(xs: list):
+    """Return the coefficients of the derivative of a polynomial."""
+    result = []
+    for i, x in enumerate(xs):
+        if i > 0:
+            result.append(i * x)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..57909076e3994e7884c42ae2bb70ddd51d67b14a
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,102 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive loop invariant.  It states that iterating over the still
+  // unprocessed coefficients extends the one stable result object with the
+  // mathematical derivative fold.
+  claim
+    <k>
+      #loop(
+        list(enumIntSeq(INPUT:IntVals, N:Int)),
+        derivativeTarget,
+        derivativeLoopStep
+        .Stmts
+      )
+      ~> CONT:K
+      => CONT
+    </k>
+    <env> LOCAL:Int </env>
+    <scopes>
+      OTHER:Map
+      LOCAL |->
+        scope(
+          "xs" |-> XSLIST:Val
+          "result" |-> ref(RESULT:Int)
+          "i" |-> PREVIOUSI:Int
+          "x" |-> PREVIOUSX:Int,
+          PARENT:Parent
+        )
+      =>
+      OTHER
+      LOCAL |->
+        scope(
+          "xs" |-> XSLIST
+          "result" |-> ref(RESULT)
+          "i" |-> ?FINALI:Int
+          "x" |-> ?FINALX:Int,
+          PARENT
+        )
+    </scopes>
+    <heap>
+      RESULT |-> list(ACC:ValSeq)
+      REST:Map
+      =>
+      RESULT |-> list(derivativeAcc(ACC, INPUT, N))
+      REST
+    </heap>
+    requires N >Int 0
+    [label(loop-invariant)]
+
+  // The two entry claims are exhaustive over IntVals: the empty case and an
+  // arbitrary head followed by an arbitrary finite tail.
+  claim
+    <k>
+      Call(Name("derivative"), list(asValSeq(.IntVals)))
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ?RESULT |-> list(derivativeSeq(.IntVals))
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    [label(entry-empty)]
+
+  claim
+    <k>
+      Call(
+        Name("derivative"),
+        list(asValSeq(ivCons(HEAD:Int, TAIL:IntVals)))
+      )
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ?RESULT |-> list(derivativeSeq(ivCons(HEAD, TAIL)))
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    [label(entry-cons)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..1fe77c5128f2191040d5402245673aca2f6c18c7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,88 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports MAP-SYMBOLIC
+
+  // A recursively typed sequence represents every finite list of integer
+  // polynomial coefficients and gives the prover a genuine induction sort.
+  syntax IntVals ::= ".IntVals"
+                   | ivCons(Int, IntVals)
+  syntax ValSeq ::= asValSeq(IntVals) [function, total]
+  rule asValSeq(.IntVals) => .ValSeq
+  rule asValSeq(ivCons(I:Int, REST:IntVals))
+    => vCons(I, asValSeq(REST))
+
+  // Executable mathematical fold for the derivative. N is the original
+  // coefficient index and ACC is the prefix already produced.
+  syntax ValSeq ::= derivativeAcc(ValSeq, IntVals, Int) [function]
+                  | derivativeSeq(IntVals) [function]
+  rule derivativeSeq(VS:IntVals)
+    => derivativeAcc(.ValSeq, VS, 0)
+  rule derivativeAcc(ACC:ValSeq, .IntVals, _:Int)
+    => ACC
+  rule derivativeAcc(ACC:ValSeq, ivCons(_:Int, REST:IntVals), 0)
+    => derivativeAcc(ACC, REST, 1)
+  rule derivativeAcc(ACC:ValSeq, ivCons(I:Int, REST:IntVals), N:Int)
+    => derivativeAcc(
+         valSeqConcat(ACC, vCons(N *Int I, .ValSeq)),
+         REST,
+         N +Int 1
+       )
+    requires N >Int 0
+
+  // enumerate is eager in the supplied semantics.  The symbolic constructor
+  // below is an equivalent lazy representation; the simplification equation
+  // and its two iterator equations are obtained directly by composing enumVS
+  // with the supplied list iterator rules.  Exposing one coefficient at a
+  // time lets the reachability claim use a structural loop invariant.
+  syntax ValSeq ::= enumIntSeq(IntVals, Int)
+  rule enumVS(asValSeq(VS:IntVals), N:Int)
+    => enumIntSeq(VS, N)
+    [simplification]
+
+  rule <k> #iterNext(list(enumIntSeq(.IntVals, _:Int)))
+        => #iterDone ... </k>
+  rule <k> #iterNext(list(enumIntSeq(ivCons(I:Int, REST:IntVals), N:Int)))
+        => #iterYield(
+             tuple(vCons(N, vCons(I, .ValSeq))),
+             list(enumIntSeq(REST, N +Int 1))
+           )
+        ... </k>
+
+  syntax Expr ::= "derivativeTarget" [macro]
+  rule derivativeTarget
+    => TupleExpr(Name("i"), Name("x"))
+
+  syntax Stmt ::= "derivativeLoopStep" [macro]
+  rule derivativeLoopStep
+    => If(
+         Compare(Name("i"), CmpOp(">", Int(0))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             BinOp("*", Name("i"), Name("x"))
+           )
+         )
+         .Stmts,
+         .Stmts
+       )
+
+  // The closure below is exactly the translated body in solution.mpy.
+  syntax Val ::= "derivativeClosure" [macro]
+  rule derivativeClosure
+    => closureVal(
+         ("xs", .ParamNames),
+         Expr(Str("Return the coefficients of the derivative of a polynomial."))
+         Assign(Name("result"), ListExpr(.Exprs))
+         For(
+           derivativeTarget,
+           Call(Name("enumerate"), Name("xs")),
+           derivativeLoopStep
+           .Stmts
+         )
+         Return(Name("result"))
+         .Stmts,
+         0
+       )
+endmodule

exec
/bin/bash -lc "rg --files -g '"'!runtime-kompiled/**'"' -g '"'!verification-kompiled/**'"' -g '"'!tmp-kompiled/**'"' -g '"'!verification2-kompiled/**'"' | sort" in /work
