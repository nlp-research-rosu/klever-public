+  // arbitrary head followed by an arbitrary finite tail.
+  claim
+    <k>
+      Call(Name("derivative"), list(asValSeq(.IntVals)))
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ?RESULT |-> list(derivativeSeq(.IntVals))
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    [label(entry-empty)]
+
+  claim
+    <k>
+      Call(
+        Name("derivative"),
+        list(asValSeq(ivCons(HEAD:Int, TAIL:IntVals)))
+      )
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ?RESULT |-> list(derivativeSeq(ivCons(HEAD, TAIL)))
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
