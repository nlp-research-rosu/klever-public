@@ -0,0 +1,7 @@
+def derivative(xs: list):
+    """Return the coefficients of the derivative of a polynomial."""
+    result = []
+    for i, x in enumerate(xs):
+        if i > 0:
+            result.append(i * x)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..57909076e3994e7884c42ae2bb70ddd51d67b14a
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,102 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive loop invariant.  It states that iterating over the still
+  // unprocessed coefficients extends the one stable result object with the
+  // mathematical derivative fold.
+  claim
+    <k>
+      #loop(
+        list(enumIntSeq(INPUT:IntVals, N:Int)),
+        derivativeTarget,
+        derivativeLoopStep
+        .Stmts
+      )
+      ~> CONT:K
+      => CONT
+    </k>
+    <env> LOCAL:Int </env>
+    <scopes>
+      OTHER:Map
+      LOCAL |->
+        scope(
+          "xs" |-> XSLIST:Val
+          "result" |-> ref(RESULT:Int)
+          "i" |-> PREVIOUSI:Int
+          "x" |-> PREVIOUSX:Int,
+          PARENT:Parent
+        )
+      =>
+      OTHER
+      LOCAL |->
+        scope(
+          "xs" |-> XSLIST
+          "result" |-> ref(RESULT)
+          "i" |-> ?FINALI:Int
+          "x" |-> ?FINALX:Int,
+          PARENT
+        )
+    </scopes>
+    <heap>
+      RESULT |-> list(ACC:ValSeq)
+      REST:Map
+      =>
+      RESULT |-> list(derivativeAcc(ACC, INPUT, N))
+      REST
+    </heap>
+    requires N >Int 0
+    [label(loop-invariant)]
+
+  // The two entry claims are exhaustive over IntVals: the empty case and an
+  // arbitrary head followed by an arbitrary finite tail.
+  claim
+    <k>
+      Call(Name("derivative"), list(asValSeq(.IntVals)))
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ?RESULT |-> list(derivativeSeq(.IntVals))
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    [label(entry-empty)]
+
+  claim
+    <k>
+      Call(
+        Name("derivative"),
+        list(asValSeq(ivCons(HEAD:Int, TAIL:IntVals)))
+      )
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ?RESULT |-> list(derivativeSeq(ivCons(HEAD, TAIL)))
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    [label(entry-cons)]
+endmodule
