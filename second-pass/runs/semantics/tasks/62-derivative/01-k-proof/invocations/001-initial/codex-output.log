diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..368c157ff294c7f23cc2ff6d84206c0c7fa76fab
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,96 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports MAP-SYMBOLIC
+
+  // Domain predicate used by the specification: polynomial coefficients are
+  // integers, and their list may have arbitrary finite length.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(_:Int, REST:ValSeq)) => allInts(REST)
+  rule allInts(vCons(_:Val, _:ValSeq)) => false [owise]
+
+  // The loop consumes enumerate(xs), so the verification fold is stated over
+  // those (index, coefficient) tuples.  validDerivativeItems records exactly
+  // the shape and non-negative indices that enumerate produces.
+  syntax Bool ::= validDerivativeItems(ValSeq) [function, total]
+  rule validDerivativeItems(.ValSeq) => true
+  rule validDerivativeItems(
+         vCons(
+           tuple(vCons(I:Int, vCons(_:Int, .ValSeq))),
+           REST:ValSeq
+         )
+       )
+    => I >=Int 0 andBool validDerivativeItems(REST)
+  rule validDerivativeItems(vCons(_:Val, _:ValSeq)) => false [owise]
+
+  // Symbolic bridge for the supplied eager enumerate implementation.  This is
+  // the type-preservation fact needed by the loop invariant.
+  rule validDerivativeItems(enumVS(VS:ValSeq, N:Int))
+    => allInts(VS) andBool N >=Int 0
+
+  // Executable mathematical fold for the derivative.
+  syntax ValSeq ::= derivativeItemsAcc(ValSeq, ValSeq) [function]
+                  | derivativeSeq(ValSeq) [function]
+  rule derivativeSeq(VS:ValSeq)
+    => derivativeItemsAcc(.ValSeq, enumVS(VS, 0))
+  rule derivativeItemsAcc(ACC:ValSeq, .ValSeq)
+    => ACC
+  rule derivativeItemsAcc(
+         ACC:ValSeq,
+         vCons(
+           tuple(vCons(0, vCons(_:Int, .ValSeq))),
+           REST:ValSeq
+         )
+       )
+    => derivativeItemsAcc(ACC, REST)
+  rule derivativeItemsAcc(
+         ACC:ValSeq,
+         vCons(
+           tuple(vCons(I:Int, vCons(X:Int, .ValSeq))),
+           REST:ValSeq
+         )
+       )
+    => derivativeItemsAcc(
+         valSeqConcat(ACC, vCons(I *Int X, .ValSeq)),
+         REST
+       )
+    requires I >Int 0
+
+  syntax Expr ::= "derivativeTarget" [macro]
+  rule derivativeTarget
+    => TupleExpr(Name("i"), Name("x"))
+
+  syntax Stmt ::= "derivativeLoopStep" [macro]
+  rule derivativeLoopStep
+    => If(
+         Compare(Name("i"), CmpOp(">", Int(0))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             BinOp("*", Name("i"), Name("x"))
+           )
+         )
+         .Stmts,
+         .Stmts
+       )
+
+  // The closure below is exactly the translated body in solution.mpy.
+  syntax Val ::= "derivativeClosure" [macro]
+  rule derivativeClosure
+    => closureVal(
+         ("xs", .ParamNames),
+         Expr(Str("Return the coefficients of the derivative of a polynomial."))
+         Assign(Name("result"), ListExpr(.Exprs))
+         For(
+           derivativeTarget,
+           Call(Name("enumerate"), Name("xs")),
+           derivativeLoopStep
+           .Stmts
+         )
+         Return(Name("result"))
+         .Stmts,
+         0
+       )
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..7bde6c9871b542fda06068d10af48aaabc6da6b1
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,14 @@
+def derivative(xs: list):
+    """Return the coefficients of the derivative of a polynomial."""
+    result = []
+    for i, x in enumerate(xs):
+        if i > 0:
+            result.append(i * x)
+    return result
+
+
+assert derivative([3, 1, 2, 4, 5]) == [1, 4, 12, 20]
+assert derivative([1, 2, 3]) == [2, 6]
+assert derivative([]) == []
+assert derivative([7]) == []
+assert derivative([0, -2, 5]) == [-2, 10]
