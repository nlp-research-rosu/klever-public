+            result.append(i * x)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..a1a605bd1b3f8eb7101adb296aec0649999b19da
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,74 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive loop invariant.  It states that iterating over the still
+  // unprocessed coefficients extends the one stable result object with the
+  // mathematical derivative fold.
+  claim
+    <k>
+      #loop(
+        list(enumIntSeq(INPUT:IntVals, N:Int)),
+        derivativeTarget,
+        derivativeLoopStep
+        .Stmts
+      )
+      => .K
+    </k>
+    <env> LOCAL:Int </env>
+    <scopes>
+      OTHER:Map
+      LOCAL |->
+        scope(
+          "xs" |-> XSLIST:Val
+          "result" |-> ref(RESULT:Int)
+          "i" |-> PREVIOUSI:Int
+          "x" |-> PREVIOUSX:Int,
+          PARENT:Parent
+        )
+      =>
+      OTHER
+      LOCAL |->
+        scope(
+          "xs" |-> XSLIST
+          "result" |-> ref(RESULT)
+          "i" |-> ?FINALI:Int
+          "x" |-> ?FINALX:Int,
+          PARENT
+        )
+    </scopes>
+    <heap>
+      RESULT |-> list(ACC:ValSeq)
+      REST:Map
+      =>
+      RESULT |-> list(derivativeAcc(ACC, INPUT, N))
+      REST
+    </heap>
+    requires N >Int 0
+    [label(loop-invariant)]
+
+  // Entry-point theorem for every finite list of integer coefficients.
+  claim
+    <k>
+      Call(Name("derivative"), list(asValSeq(COEFFS:IntVals)))
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ?RESULT |-> list(derivativeSeq(COEFFS))
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    [label(entry-point)]
+endmodule
