diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f86d4ab006e3c3cc1ad24ac83afe27abb9e97cba
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,85 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports MAP-SYMBOLIC
+
+  // Domain predicate used by the specification: polynomial coefficients are
+  // integers, and their list may have arbitrary finite length.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, REST:ValSeq))
+    => isInt(V) andBool allInts(REST)
+  rule allInts(_:ValSeq) => false [owise]
+
+  // Executable mathematical fold for the derivative. N is the original
+  // coefficient index and ACC is the prefix already produced.
+  syntax ValSeq ::= derivativeAcc(ValSeq, ValSeq, Int) [function]
+                  | derivativeSeq(ValSeq) [function]
+  rule derivativeSeq(VS:ValSeq)
+    => derivativeAcc(.ValSeq, VS, 0)
+  rule derivativeAcc(ACC:ValSeq, .ValSeq, _:Int)
+    => ACC
+  rule derivativeAcc(ACC:ValSeq, vCons(_:Val, REST:ValSeq), 0)
+    => derivativeAcc(ACC, REST, 1)
+  rule derivativeAcc(ACC:ValSeq, vCons(V:Val, REST:ValSeq), N:Int)
+    => derivativeAcc(
+         valSeqConcat(ACC, vCons(N *Int {V}:>Int, .ValSeq)),
+         REST,
+         N +Int 1
+       )
+    requires N >Int 0 andBool isInt(V)
+
+  // enumerate is eager in the supplied semantics.  The symbolic constructor
+  // below is an equivalent lazy representation; the simplification equation
+  // and its two iterator equations are obtained directly by composing enumVS
+  // with the supplied list iterator rules.  Exposing one coefficient at a
+  // time lets the reachability claim use a structural loop invariant.
+  syntax ValSeq ::= enumSeq(ValSeq, Int)
+  rule enumVS(VS:ValSeq, N:Int) => enumSeq(VS, N) [simplification]
+
+  rule <k> #iterNext(list(enumSeq(.ValSeq, _:Int)))
+        => #iterDone ... </k>
+  rule <k> #iterNext(list(enumSeq(vCons(V:Val, REST:ValSeq), N:Int)))
+        => #iterYield(
+             tuple(vCons(N, vCons(V, .ValSeq))),
+             list(enumSeq(REST, N +Int 1))
+           )
+        ... </k>
+
+  syntax Expr ::= "derivativeTarget" [macro]
+  rule derivativeTarget
+    => TupleExpr(Name("i"), Name("x"))
+
+  syntax Stmt ::= "derivativeLoopStep" [macro]
+  rule derivativeLoopStep
+    => If(
+         Compare(Name("i"), CmpOp(">", Int(0))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             BinOp("*", Name("i"), Name("x"))
+           )
+         )
+         .Stmts,
+         .Stmts
+       )
+
+  // The closure below is exactly the translated body in solution.mpy.
+  syntax Val ::= "derivativeClosure" [macro]
+  rule derivativeClosure
+    => closureVal(
+         ("xs", .ParamNames),
+         Expr(Str("Return the coefficients of the derivative of a polynomial."))
+         Assign(Name("result"), ListExpr(.Exprs))
+         For(
+           derivativeTarget,
+           Call(Name("enumerate"), Name("xs")),
+           derivativeLoopStep
+           .Stmts
+         )
+         Return(Name("result"))
+         .Stmts,
+         0
+       )
+endmodule

apply patch
patch: completed
/work/verification.k
diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..7bde6c9871b542fda06068d10af48aaabc6da6b1
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,14 @@
+def derivative(xs: list):
+    """Return the coefficients of the derivative of a polynomial."""
+    result = []
+    for i, x in enumerate(xs):
+        if i > 0:
+            result.append(i * x)
+    return result
+
+
+assert derivative([3, 1, 2, 4, 5]) == [1, 4, 12, 20]
+assert derivative([1, 2, 3]) == [2, 6]
+assert derivative([]) == []
+assert derivative([7]) == []
+assert derivative([0, -2, 5]) == [-2, 10]
