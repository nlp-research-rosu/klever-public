diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f737b1fe5e29b99519a0541b2a997ce2d671e63a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,82 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports MAP-SYMBOLIC
+
+  // Domain predicate used by the specification: polynomial coefficients are
+  // integers, and their list may have arbitrary finite length.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, REST:ValSeq))
+    => isInt(V) andBool allInts(REST)
+
+  // Executable mathematical fold for the derivative. N is the original
+  // coefficient index and ACC is the prefix already produced.
+  syntax ValSeq ::= derivativeAcc(ValSeq, ValSeq, Int) [function]
+                  | derivativeSeq(ValSeq) [function]
+  rule derivativeSeq(VS:ValSeq)
+    => derivativeAcc(.ValSeq, VS, 0)
+  rule derivativeAcc(ACC:ValSeq, .ValSeq, _:Int)
+    => ACC
+  rule derivativeAcc(ACC:ValSeq, vCons(_:Val, REST:ValSeq), 0)
+    => derivativeAcc(ACC, REST, 1)
+  rule derivativeAcc(ACC:ValSeq, vCons(V:Val, REST:ValSeq), N:Int)
+    => derivativeAcc(
+         valSeqConcat(ACC, vCons(N *Int {V}:>Int, .ValSeq)),
+         REST,
+         N +Int 1
+       )
+    requires N >Int 0 andBool isInt(V)
+
+  // enumerate is eager in the supplied semantics. These two proof-only
+  // fusion rules are its one-step iterator equations, obtained by composing
+  // enumVS with the list iterator rules. They expose one coefficient at a
+  // time so the reachability claim can use a structural loop invariant.
+  rule <k> #iterNext(list(enumVS(.ValSeq, _:Int)))
+        => #iterDone ... </k>
+       [anywhere]
+  rule <k> #iterNext(list(enumVS(vCons(V:Val, REST:ValSeq), N:Int)))
+        => #iterYield(
+             tuple(vCons(N, vCons(V, .ValSeq))),
+             list(enumVS(REST, N +Int 1))
+           )
+        ... </k>
+       [anywhere]
+
+  syntax Expr ::= "derivativeTarget" [macro]
+  rule derivativeTarget
+    => TupleExpr(Name("i"), Name("x"))
+
+  syntax Stmt ::= "derivativeLoopStep" [macro]
+  rule derivativeLoopStep
+    => If(
+         Compare(Name("i"), CmpOp(">", Int(0))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             BinOp("*", Name("i"), Name("x"))
+           )
+         )
+         .Stmts,
+         .Stmts
+       )
+
+  // The closure below is exactly the translated body in solution.mpy.
+  syntax Val ::= "derivativeClosure" [macro]
+  rule derivativeClosure
+    => closureVal(
+         ("xs", .ParamNames),
+         Expr(Str("Return the coefficients of the derivative of a polynomial."))
+         Assign(Name("result"), ListExpr(.Exprs))
+         For(
+           derivativeTarget,
+           Call(Name("enumerate"), Name("xs")),
+           derivativeLoopStep
+           .Stmts
+         )
+         Return(Name("result"))
+         .Stmts,
+         0
+       )
+endmodule

apply patch
patch: completed
