--- /dev/null
+++ b/verification.k
@@ -0,0 +1,48 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+  imports MAP-SYMBOLIC
+
+  // A recursively typed sequence of integer coefficients.  Encoding the
+  // input this way lets the prover perform structural induction while the
+  // program itself still receives the ordinary Python list value.
+  syntax IntVals ::= ".IntVals"
+                   | ivCons(Int, IntVals)
+
+  syntax ValSeq ::= asValSeq(IntVals) [function, total]
+  rule asValSeq(.IntVals) => .ValSeq
+  rule asValSeq(ivCons(I:Int, IS:IntVals))
+    => vCons(I, asValSeq(IS))
+
+  // Mathematical derivative of all coefficients after the constant term.
+  syntax ValSeq ::= derivativeTail(IntVals) [function, total]
+                  | derivativeFrom(IntVals, Int) [function, total]
+  rule derivativeTail(.IntVals) => .ValSeq
+  rule derivativeTail(ivCons(_:Int, IS:IntVals))
+    => derivativeFrom(IS, 1)
+  rule derivativeFrom(.IntVals, _:Int) => .ValSeq
+  rule derivativeFrom(ivCons(I:Int, IS:IntVals), N:Int)
+    => vCons(N *Int I, derivativeFrom(IS, N +Int 1))
+
+  // The closure below is exactly the translated body in solution.mpy (after
+  // the reference semantics expands the list-comprehension macro).
+  syntax Val ::= "derivativeClosure" [macro]
+  rule derivativeClosure
+    => closureVal(
+         ("xs", .ParamNames),
+         Expr(Str("Return the coefficients of the derivative of a polynomial."))
+         Return(
+           ListComp(
+             BinOp("*", Name("i"), Name("x")),
+             CompFor(
+               TupleExpr(Name("i"), Name("x")),
+               Call(Name("enumerate"), Name("xs")),
+               Compare(Name("i"), CmpOp(">", Int(0)))
+             )
+           )
+         )
+         .Stmts,
+         0
+       )
+endmodule

