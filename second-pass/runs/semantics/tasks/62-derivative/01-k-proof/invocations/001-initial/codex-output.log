index 0000000000000000000000000000000000000000..de4f77101d6e8186c4f7c5472fc5f490e7313727
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,42 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim
+    <k>
+      Call(
+        Name("derivative"),
+        list(
+          vCons(A:Int,
+            vCons(B:Int,
+              vCons(C:Int,
+                vCons(D:Int,
+                  vCons(E:Int, .ValSeq)))))
+        )
+      )
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ?RESULT |->
+        list(
+          vCons(B,
+            vCons(2 *Int C,
+              vCons(3 *Int D,
+                vCons(4 *Int E, .ValSeq))))
+        )
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
