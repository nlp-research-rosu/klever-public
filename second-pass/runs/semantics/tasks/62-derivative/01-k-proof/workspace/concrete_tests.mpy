Module(
  FuncDef("derivative", Params("xs"),
    Expr(
      Str("Return the coefficients of the derivative of a polynomial."))
    Assign(Name("result"), ListExpr())
    For(TupleExpr(Name("i"), Name("x")), Call(Name("enumerate"), Name("xs")),
      If(Compare(Name("i"), CmpOp(">", Int(0))),
        Expr(
          Call(
            Attribute(Name("result"), "append"),
            BinOp("*", Name("i"), Name("x")))),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("derivative"),
        ListExpr(Int(3), Int(1), Int(2), Int(4), Int(5))),
      CmpOp("==", ListExpr(Int(1), Int(4), Int(12), Int(20)))))
  Assert(
    Compare(
      Call(Name("derivative"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", ListExpr(Int(2), Int(6)))))
  Assert(
    Compare(
      Call(Name("derivative"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("derivative"), ListExpr(Int(7))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("derivative"),
        ListExpr(Int(0), UnaryOp("-", Int(2)), Int(5))),
      CmpOp("==", ListExpr(UnaryOp("-", Int(2)), Int(10))))))
