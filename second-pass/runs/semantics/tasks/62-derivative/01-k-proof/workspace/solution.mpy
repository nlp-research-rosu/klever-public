Module(
  FuncDef("derivative", Params("xs"),
    Expr(
      Str("Return the coefficients of the derivative of a polynomial."))
    Assign(Name("result"), ListExpr())
    For(TupleExpr(Name("i"), Name("x")), Call(Name("enumerate"), Name("xs")),
      If(Compare(Name("i"), CmpOp(">", Int(0))),
        Expr(
          Call(
            Attribute(Name("result"), "append"),
            BinOp("*", Name("i"), Name("x")))),
        ))
    Return(Name("result"))))
