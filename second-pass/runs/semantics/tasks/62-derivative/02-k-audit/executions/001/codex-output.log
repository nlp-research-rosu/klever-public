+  ],
+  "exhaustive_generator": {
+    "lengths": [0, 1, 2, 3, 4, 5, 6],
+    "coefficient_values": [-3, -1, 0, 1, 2, 7]
+  },
+  "seeded_generator": {
+    "seed": 620062,
+    "count": 1000,
+    "length_range": [0, 40],
+    "coefficient_range": [-1000000, 1000000]
+  }
