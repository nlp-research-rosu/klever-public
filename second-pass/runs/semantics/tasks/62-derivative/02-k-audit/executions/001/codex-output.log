+    <k>
+      Call(
+        Name("derivative"),
+        list(
+          asValSeq(
+            ivCons(3,
+              ivCons(1,
+                ivCons(2,
+                  ivCons(4,
+                    ivCons(5, .IntVals)))))
+          )
+        )
+      )
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
