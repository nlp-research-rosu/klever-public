--- /dev/null
+++ b/evidence/spec-connection.k
@@ -0,0 +1,15 @@
+requires "verification-connection.k"
+
+module SPEC-CONNECTION
+  imports VERIFICATION-CONNECTION
+
+  // Bridge-free characterization of the supplied eager enumVS function.
+  // This module does not import candidate verification.k or enumIntSeq.
+  claim
+    <k>
+      enumVS(connectionAsValSeq(VS:IntVals), N:Int)
+      =>
+      connectionEnum(VS, N)
+    </k>
+    [label(eager-enum-characterization)]
+endmodule
diff --git a/evidence/spec-ground.k b/evidence/spec-ground.k
new file mode 100644
index 0000000000000000000000000000000000000000..7a20a463809fd1cff583c3a448e0430af2b52bc8
--- /dev/null
+++ b/evidence/spec-ground.k
@@ -0,0 +1,63 @@
+requires "verification.k"
+
+module SPEC-GROUND
+  imports VERIFICATION
+
+  claim
+    <k>
+      Call(Name("derivative"), list(asValSeq(.IntVals)))
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ?RESULT |-> list(.ValSeq)
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    [label(ground-empty)]
+
+  claim
+    <k>
+      Call(
+        Name("derivative"),
+        list(
+          asValSeq(
+            ivCons(3,
+              ivCons(1,
+                ivCons(2,
+                  ivCons(4,
+                    ivCons(5, .IntVals)))))
+          )
+        )
+      )
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ?RESULT |->
+        list(vCons(1, vCons(4, vCons(12, vCons(20, .ValSeq)))))
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    [label(ground-example)]
+endmodule
diff --git a/evidence/spec-no-bridge.k b/evidence/spec-no-bridge.k
new file mode 100644
index 0000000000000000000000000000000000000000..5dd00fc15648111b127d933e02bfcc4c7195aebd
--- /dev/null
+++ b/evidence/spec-no-bridge.k
@@ -0,0 +1,97 @@
+requires "verification-no-bridge.k"
+
+module SPEC-NO-BRIDGE
+  imports VERIFICATION-NO-BRIDGE
+
+  claim
+    <k>
+      #loop(
+        list(enumVS(asValSeq(INPUT:IntVals), N:Int)),
+        derivativeTarget,
+        derivativeLoopStep
+        .Stmts
+      )
+      ~> CONT:K
+      => CONT
+    </k>
+    <env> LOCAL:Int </env>
+    <scopes>
+      OTHER:Map
+      LOCAL |->
+        scope(
+          "xs" |-> XSLIST:Val
+          "result" |-> ref(RESULT:Int)
+          "i" |-> PREVIOUSI:Int
+          "x" |-> PREVIOUSX:Int,
+          PARENT:Parent
+        )
+      =>
+      OTHER
+      LOCAL |->
+        scope(
+          "xs" |-> XSLIST
+          "result" |-> ref(RESULT)
+          "i" |-> ?FINALI:Int
+          "x" |-> ?FINALX:Int,
+          PARENT
+        )
+    </scopes>
+    <heap>
+      RESULT |-> list(ACC:ValSeq)
+      REST:Map
+      =>
+      RESULT |-> list(derivativeAcc(ACC, INPUT, N))
+      REST
+    </heap>
+    requires N >Int 0
+    [label(loop-invariant-no-bridge)]
+
+  claim
+    <k>
+      Call(Name("derivative"), list(asValSeq(.IntVals)))
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ?RESULT |-> list(derivativeSeq(.IntVals))
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    [label(entry-empty-no-bridge)]
+
+  claim
+    <k>
+      Call(
+        Name("derivative"),
+        list(asValSeq(ivCons(HEAD:Int, TAIL:IntVals)))
+      )
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ?RESULT |-> list(derivativeSeq(ivCons(HEAD, TAIL)))
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    [label(entry-cons-no-bridge)]
+endmodule
