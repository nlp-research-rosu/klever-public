new file mode 100644
index 0000000000000000000000000000000000000000..3eeee5e4d2f286f592363525c84cff1afdb1d49f
--- /dev/null
+++ b/evidence/verification-no-bridge.k
@@ -0,0 +1,64 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-NO-BRIDGE
+  imports MPY
+  imports MAP-SYMBOLIC
+
+  syntax IntVals ::= ".IntVals"
+                   | ivCons(Int, IntVals)
+  syntax ValSeq ::= asValSeq(IntVals) [function, total]
+  rule asValSeq(.IntVals) => .ValSeq
+  rule asValSeq(ivCons(I:Int, REST:IntVals))
+    => vCons(I, asValSeq(REST))
+
+  syntax ValSeq ::= derivativeAcc(ValSeq, IntVals, Int) [function]
+                  | derivativeSeq(IntVals) [function]
+  rule derivativeSeq(VS:IntVals)
+    => derivativeAcc(.ValSeq, VS, 0)
+  rule derivativeAcc(ACC:ValSeq, .IntVals, _:Int)
+    => ACC
+  rule derivativeAcc(ACC:ValSeq, ivCons(_:Int, REST:IntVals), 0)
+    => derivativeAcc(ACC, REST, 1)
+  rule derivativeAcc(ACC:ValSeq, ivCons(I:Int, REST:IntVals), N:Int)
+    => derivativeAcc(
+         valSeqConcat(ACC, vCons(N *Int I, .ValSeq)),
+         REST,
+         N +Int 1
+       )
+    requires N >Int 0
+
+  syntax Expr ::= "derivativeTarget" [macro]
+  rule derivativeTarget
+    => TupleExpr(Name("i"), Name("x"))
+
+  syntax Stmt ::= "derivativeLoopStep" [macro]
+  rule derivativeLoopStep
+    => If(
+         Compare(Name("i"), CmpOp(">", Int(0))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             BinOp("*", Name("i"), Name("x"))
+           )
+         )
+         .Stmts,
+         .Stmts
+       )
+
+  syntax Val ::= "derivativeClosure" [macro]
+  rule derivativeClosure
+    => closureVal(
+         ("xs", .ParamNames),
+         Expr(Str("Return the coefficients of the derivative of a polynomial."))
+         Assign(Name("result"), ListExpr(.Exprs))
+         For(
+           derivativeTarget,
+           Call(Name("enumerate"), Name("xs")),
+           derivativeLoopStep
+           .Stmts
+         )
+         Return(Name("result"))
+         .Stmts,
+         0
+       )
+endmodule

Stages 1–4 are complete. Stage 5 is complete and found a proof-local inconsistency: the symbolic lazy-enumeration simplification proves a false universal claim at the empty integer sequence; the bridge-free reconstruction also fails, showing the rejected rule contributes materially to closure. Proceeding to the required fresh false-result mutation.
  ✓ Stage 1: verify trusted mounts, provenance artifacts, prompt/translator, and supplied-semantics tree integrity
  ✓ Stage 2: establish contract and program fidelity; regenerate MPY and run independent differential tests
  ✓ Stage 3: make a clean scratch copy, rebuild definitions, and independently rerun every positive proof claim
  ✓ Stage 4: audit claim adequacy, real-program pinning, satisfiable preconditions, and concrete substitutions
  ✓ Stage 5: inventory and audit every syntax/function/rule/attribute and map all used constructs
  → Stage 6: create and run a fresh meaningful false-result mutation
  • Stage 7: account for proven facts versus assumptions; write REVIEW.md and finalize verdict
