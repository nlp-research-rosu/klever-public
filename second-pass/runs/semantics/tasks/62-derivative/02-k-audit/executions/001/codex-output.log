diff --git a/evidence/stage4_ground_proofs.sh b/evidence/stage4_ground_proofs.sh
new file mode 100644
index 0000000000000000000000000000000000000000..d0335f448dd5076c10ee1622701969d8f39a0d6a
--- /dev/null
+++ b/evidence/stage4_ground_proofs.sh
@@ -0,0 +1,20 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
