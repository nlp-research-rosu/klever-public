diff --git a/evidence/verification-connection.k b/evidence/verification-connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..69183a17e4f5392913441d94571eeb220696c562
--- /dev/null
+++ b/evidence/verification-connection.k
@@ -0,0 +1,22 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-CONNECTION
+  imports MPY
+  imports MAP-SYMBOLIC
+
+  syntax IntVals ::= ".IntVals"
+                   | ivCons(Int, IntVals)
+
+  syntax ValSeq ::= connectionAsValSeq(IntVals) [function, total]
+  rule connectionAsValSeq(.IntVals) => .ValSeq
+  rule connectionAsValSeq(ivCons(I:Int, REST:IntVals))
+    => vCons(I, connectionAsValSeq(REST))
+
+  syntax ValSeq ::= connectionEnum(IntVals, Int) [function]
+  rule connectionEnum(.IntVals, _:Int) => .ValSeq
+  rule connectionEnum(ivCons(I:Int, REST:IntVals), N:Int)
+    => vCons(
+         tuple(vCons(N, vCons(I, .ValSeq))),
+         connectionEnum(REST, N +Int 1)
+       )
+endmodule
diff --git a/evidence/verification-no-bridge.k b/evidence/verification-no-bridge.k
new file mode 100644
index 0000000000000000000000000000000000000000..3eeee5e4d2f286f592363525c84cff1afdb1d49f
--- /dev/null
+++ b/evidence/verification-no-bridge.k
@@ -0,0 +1,64 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-NO-BRIDGE
+  imports MPY
+  imports MAP-SYMBOLIC
+
+  syntax IntVals ::= ".IntVals"
+                   | ivCons(Int, IntVals)
+  syntax ValSeq ::= asValSeq(IntVals) [function, total]
+  rule asValSeq(.IntVals) => .ValSeq
+  rule asValSeq(ivCons(I:Int, REST:IntVals))
+    => vCons(I, asValSeq(REST))
+
+  syntax ValSeq ::= derivativeAcc(ValSeq, IntVals, Int) [function]
+                  | derivativeSeq(IntVals) [function]
+  rule derivativeSeq(VS:IntVals)
+    => derivativeAcc(.ValSeq, VS, 0)
+  rule derivativeAcc(ACC:ValSeq, .IntVals, _:Int)
+    => ACC
+  rule derivativeAcc(ACC:ValSeq, ivCons(_:Int, REST:IntVals), 0)
+    => derivativeAcc(ACC, REST, 1)
+  rule derivativeAcc(ACC:ValSeq, ivCons(I:Int, REST:IntVals), N:Int)
+    => derivativeAcc(
+         valSeqConcat(ACC, vCons(N *Int I, .ValSeq)),
+         REST,
+         N +Int 1
+       )
+    requires N >Int 0
+
+  syntax Expr ::= "derivativeTarget" [macro]
+  rule derivativeTarget
+    => TupleExpr(Name("i"), Name("x"))
+
+  syntax Stmt ::= "derivativeLoopStep" [macro]
+  rule derivativeLoopStep
+    => If(
+         Compare(Name("i"), CmpOp(">", Int(0))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             BinOp("*", Name("i"), Name("x"))
+           )
+         )
+         .Stmts,
+         .Stmts
+       )
+
+  syntax Val ::= "derivativeClosure" [macro]
+  rule derivativeClosure
+    => closureVal(
+         ("xs", .ParamNames),
+         Expr(Str("Return the coefficients of the derivative of a polynomial."))
+         Assign(Name("result"), ListExpr(.Exprs))
+         For(
+           derivativeTarget,
+           Call(Name("enumerate"), Name("xs")),
+           derivativeLoopStep
+           .Stmts
+         )
+         Return(Name("result"))
+         .Stmts,
+         0
+       )
+endmodule

