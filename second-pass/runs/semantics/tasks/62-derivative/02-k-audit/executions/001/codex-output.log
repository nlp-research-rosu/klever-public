+              ivCons(1,
+                ivCons(2,
+                  ivCons(4,
+                    ivCons(5, .IntVals)))))
+          )
+        )
+      )
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ?RESULT |->
+        list(vCons(1, vCons(4, vCons(12, vCons(20, .ValSeq)))))
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
