diff --git a/evidence/verification-connection.k b/evidence/verification-connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..69183a17e4f5392913441d94571eeb220696c562
--- /dev/null
+++ b/evidence/verification-connection.k
@@ -0,0 +1,22 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-CONNECTION
+  imports MPY
+  imports MAP-SYMBOLIC
+
+  syntax IntVals ::= ".IntVals"
+                   | ivCons(Int, IntVals)
+
+  syntax ValSeq ::= connectionAsValSeq(IntVals) [function, total]
+  rule connectionAsValSeq(.IntVals) => .ValSeq
+  rule connectionAsValSeq(ivCons(I:Int, REST:IntVals))
+    => vCons(I, connectionAsValSeq(REST))
+
+  syntax ValSeq ::= connectionEnum(IntVals, Int) [function]
+  rule connectionEnum(.IntVals, _:Int) => .ValSeq
+  rule connectionEnum(ivCons(I:Int, REST:IntVals), N:Int)
+    => vCons(
+         tuple(vCons(N, vCons(I, .ValSeq))),
+         connectionEnum(REST, N +Int 1)
+       )
+endmodule
diff --git a/evidence/verification-no-bridge.k b/evidence/verification-no-bridge.k
new file mode 100644
index 0000000000000000000000000000000000000000..3eeee5e4d2f286f592363525c84cff1afdb1d49f
--- /dev/null
+++ b/evidence/verification-no-bridge.k
@@ -0,0 +1,64 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-NO-BRIDGE
+  imports MPY
+  imports MAP-SYMBOLIC
+
+  syntax IntVals ::= ".IntVals"
+                   | ivCons(Int, IntVals)
+  syntax ValSeq ::= asValSeq(IntVals) [function, total]
+  rule asValSeq(.IntVals) => .ValSeq
+  rule asValSeq(ivCons(I:Int, REST:IntVals))
+    => vCons(I, asValSeq(REST))
+
+  syntax ValSeq ::= derivativeAcc(ValSeq, IntVals, Int) [function]
+                  | derivativeSeq(IntVals) [function]
+  rule derivativeSeq(VS:IntVals)
+    => derivativeAcc(.ValSeq, VS, 0)
+  rule derivativeAcc(ACC:ValSeq, .IntVals, _:Int)
+    => ACC
+  rule derivativeAcc(ACC:ValSeq, ivCons(_:Int, REST:IntVals), 0)
+    => derivativeAcc(ACC, REST, 1)
+  rule derivativeAcc(ACC:ValSeq, ivCons(I:Int, REST:IntVals), N:Int)
+    => derivativeAcc(
+         valSeqConcat(ACC, vCons(N *Int I, .ValSeq)),
+         REST,
+         N +Int 1
+       )
+    requires N >Int 0
+
+  syntax Expr ::= "derivativeTarget" [macro]
+  rule derivativeTarget
+    => TupleExpr(Name("i"), Name("x"))
+
+  syntax Stmt ::= "derivativeLoopStep" [macro]
+  rule derivativeLoopStep
+    => If(
+         Compare(Name("i"), CmpOp(">", Int(0))),
+         Expr(
+           Call(
+             Attribute(Name("result"), "append"),
+             BinOp("*", Name("i"), Name("x"))
+           )
+         )
+         .Stmts,
+         .Stmts
+       )
+
+  syntax Val ::= "derivativeClosure" [macro]
+  rule derivativeClosure
+    => closureVal(
+         ("xs", .ParamNames),
+         Expr(Str("Return the coefficients of the derivative of a polynomial."))
+         Assign(Name("result"), ListExpr(.Exprs))
+         For(
+           derivativeTarget,
+           Call(Name("enumerate"), Name("xs")),
+           derivativeLoopStep
+           .Stmts
+         )
+         Return(Name("result"))
+         .Stmts,
+         0
+       )
+endmodule

exec
/bin/bash -lc "nl -ba reference-semantics/semantics/str.k | sed -n '1,80p'; nl -ba reference-semantics/semantics/assert.k; nl -ba verification.k; nl -ba spec.k" in /tmp/audit-work/62-derivative
 succeeded in 0ms:
     1	// reference/src/semantics/str.k — MPY-STR
     2	
     3	module MPY-STR
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	
     7	  // ==== iteration (the iterator protocol's str case; yields 1-char strings) ==
     8	  rule <k> #iterNext(str(.IntSeq))                 => #iterDone ... </k>
     9	  rule <k> #iterNext(str(iCons(C:Int, R:IntSeq)))
    10	        => #iterYield(str(iCons(C, .IntSeq)), str(R)) ... </k>
    11	
    12	  // ==== str literal (ASCII-only) ============================================
    13	  syntax IntSeq ::= strToCodes(String) [function]
    14	  rule <k> Str(S:String) => str(strToCodes(S)) ... </k>
    15	  rule strToCodes("") => .IntSeq
    16	  rule strToCodes(S:String) => iCons(ordChar(substrString(S, 0, 1)), strToCodes(substrString(S, 1, lengthString(S))))
    17	    requires S =/=String "" andBool ordChar(substrString(S, 0, 1)) <Int 128
    18	
    19	  // ==== operators: + / == / != / in =========================================
    20	  syntax IntSeq ::= seqConcat(IntSeq, IntSeq) [function, total]
    21	  rule seqConcat(.IntSeq, T:IntSeq)                => T
    22	  rule seqConcat(iCons(I:Int, S:IntSeq), T:IntSeq) => iCons(I, seqConcat(S, T))
    23	
    24	  rule applyBin("+",  str(A:IntSeq), str(B:IntSeq)) => str(seqConcat(A, B))
    25	  rule applyCmp("==", str(A:IntSeq), str(B:IntSeq)) => A ==K B
    26	  rule applyCmp("!=", str(A:IntSeq), str(B:IntSeq)) => notBool (A ==K B)
    27	
    28	  // substring membership: `P in X` iff the code-seq P occurs contiguously in X
    29	  rule applyCmp("in",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)
    30	  rule applyCmp("not in", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)
    31	
    32	  syntax Bool ::= strPrefix(IntSeq, IntSeq) [function, total]
    33	  rule strPrefix(.IntSeq, _:IntSeq)               => true
    34	  rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false
    35	  rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)
    36	
    37	  syntax Bool ::= strContains(IntSeq, IntSeq) [function, total]
    38	  rule strContains(P:IntSeq, X:IntSeq) => true  requires strPrefix(P, X)
    39	  rule strContains(P:IntSeq, .IntSeq)  => false requires notBool strPrefix(P, .IntSeq)
    40	  rule strContains(P:IntSeq, iCons(C:Int, Xs:IntSeq)) => strContains(P, Xs)
    41	       requires notBool strPrefix(P, iCons(C, Xs))
    42	
    43	  // ==== lexicographic order: < / <= / > / >= by code point (= Python str order on the code
    44	  // model). strLt reduces on GROUND code-seqs (krun) but is inert/OPAQUE on symbolic ones
    45	  // (a proof's codesProj(V) is an abstract IntSeq — no constructor rule matches), so a symbolic
    46	  // str `<` stays a trusted opaque term the way sortVS / intFloatDiv do. Additive: fires only on
    47	  // str </<=/>/>= comparisons.
    48	  syntax Bool ::= strLt(IntSeq, IntSeq) [function, total]
    49	  rule strLt(.IntSeq, .IntSeq)                => false
    50	  rule strLt(.IntSeq, iCons(_:Int, _:IntSeq)) => true
    51	  rule strLt(iCons(_:Int, _:IntSeq), .IntSeq) => false
    52	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => true          requires A  <Int B
    53	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B
    54	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B
    55	
    56	  rule applyCmp("<",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
    57	  rule applyCmp(">",  str(A:IntSeq), str(B:IntSeq)) => strLt(B, A)
    58	  rule applyCmp("<=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(B, A)
    59	  rule applyCmp(">=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(A, B)
    60	endmodule
     1	// reference/src/semantics/assert.k — MPY-ASSERT
     2	
     3	module MPY-ASSERT
     4	  imports MPY-CORE
     5	
     6	  rule <k> Assert(V:Val) => .K ... </k>
     7	       requires truthy(V)
     8	  rule <k> Assert(V:Val) ~> _ => .K </k>
     9	       <exc> NoExc => AssertionError </exc>
    10	       <exit-code> _ => 1 </exit-code>
    11	       requires notBool truthy(V)
    12	
    13	  rule <k> Assert(ref(H:Int)) => Assert(V) ... </k>
    14	       <heap> ... H |-> V:Val ... </heap>
    15	       [priority(40)]
    16	endmodule
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	  imports MAP-SYMBOLIC
     6	
     7	  // A recursively typed sequence represents every finite list of integer
     8	  // polynomial coefficients and gives the prover a genuine induction sort.
     9	  syntax IntVals ::= ".IntVals"
    10	                   | ivCons(Int, IntVals)
    11	  syntax ValSeq ::= asValSeq(IntVals) [function, total]
    12	  rule asValSeq(.IntVals) => .ValSeq
    13	  rule asValSeq(ivCons(I:Int, REST:IntVals))
    14	    => vCons(I, asValSeq(REST))
    15	
    16	  // Executable mathematical fold for the derivative. N is the original
    17	  // coefficient index and ACC is the prefix already produced.
    18	  syntax ValSeq ::= derivativeAcc(ValSeq, IntVals, Int) [function]
    19	                  | derivativeSeq(IntVals) [function]
    20	  rule derivativeSeq(VS:IntVals)
    21	    => derivativeAcc(.ValSeq, VS, 0)
    22	  rule derivativeAcc(ACC:ValSeq, .IntVals, _:Int)
    23	    => ACC
    24	  rule derivativeAcc(ACC:ValSeq, ivCons(_:Int, REST:IntVals), 0)
    25	    => derivativeAcc(ACC, REST, 1)
    26	  rule derivativeAcc(ACC:ValSeq, ivCons(I:Int, REST:IntVals), N:Int)
    27	    => derivativeAcc(
    28	         valSeqConcat(ACC, vCons(N *Int I, .ValSeq)),
    29	         REST,
    30	         N +Int 1
    31	       )
    32	    requires N >Int 0
    33	
    34	  // enumerate is eager in the supplied semantics.  The symbolic constructor
    35	  // below is an equivalent lazy representation; the simplification equation
    36	  // and its two iterator equations are obtained directly by composing enumVS
    37	  // with the supplied list iterator rules.  Exposing one coefficient at a
    38	  // time lets the reachability claim use a structural loop invariant.
    39	  syntax ValSeq ::= enumIntSeq(IntVals, Int)
    40	  rule enumVS(asValSeq(VS:IntVals), N:Int)
    41	    => enumIntSeq(VS, N)
    42	    [simplification]
    43	
    44	  rule <k> #iterNext(list(enumIntSeq(.IntVals, _:Int)))
    45	        => #iterDone ... </k>
    46	  rule <k> #iterNext(list(enumIntSeq(ivCons(I:Int, REST:IntVals), N:Int)))
    47	        => #iterYield(
    48	             tuple(vCons(N, vCons(I, .ValSeq))),
    49	             list(enumIntSeq(REST, N +Int 1))
    50	           )
    51	        ... </k>
    52	
    53	  syntax Expr ::= "derivativeTarget" [macro]
    54	  rule derivativeTarget
    55	    => TupleExpr(Name("i"), Name("x"))
    56	
    57	  syntax Stmt ::= "derivativeLoopStep" [macro]
    58	  rule derivativeLoopStep
    59	    => If(
    60	         Compare(Name("i"), CmpOp(">", Int(0))),
    61	         Expr(
    62	           Call(
    63	             Attribute(Name("result"), "append"),
    64	             BinOp("*", Name("i"), Name("x"))
    65	           )
    66	         )
    67	         .Stmts,
    68	         .Stmts
    69	       )
    70	
    71	  // The closure below is exactly the translated body in solution.mpy.
    72	  syntax Val ::= "derivativeClosure" [macro]
    73	  rule derivativeClosure
    74	    => closureVal(
    75	         ("xs", .ParamNames),
    76	         Expr(Str("Return the coefficients of the derivative of a polynomial."))
    77	         Assign(Name("result"), ListExpr(.Exprs))
    78	         For(
    79	           derivativeTarget,
    80	           Call(Name("enumerate"), Name("xs")),
    81	           derivativeLoopStep
    82	           .Stmts
    83	         )
    84	         Return(Name("result"))
    85	         .Stmts,
    86	         0
    87	       )
    88	endmodule
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Inductive loop invariant.  It states that iterating over the still
     7	  // unprocessed coefficients extends the one stable result object with the
     8	  // mathematical derivative fold.
     9	  claim
    10	    <k>
    11	      #loop(
    12	        list(enumIntSeq(INPUT:IntVals, N:Int)),
    13	        derivativeTarget,
    14	        derivativeLoopStep
    15	        .Stmts
    16	      )
    17	      ~> CONT:K
    18	      => CONT
    19	    </k>
    20	    <env> LOCAL:Int </env>
    21	    <scopes>
    22	      OTHER:Map
    23	      LOCAL |->
    24	        scope(
    25	          "xs" |-> XSLIST:Val
    26	          "result" |-> ref(RESULT:Int)
    27	          "i" |-> PREVIOUSI:Int
    28	          "x" |-> PREVIOUSX:Int,
    29	          PARENT:Parent
    30	        )
    31	      =>
    32	      OTHER
    33	      LOCAL |->
    34	        scope(
    35	          "xs" |-> XSLIST
    36	          "result" |-> ref(RESULT)
    37	          "i" |-> ?FINALI:Int
    38	          "x" |-> ?FINALX:Int,
    39	          PARENT
    40	        )
    41	    </scopes>
    42	    <heap>
    43	      RESULT |-> list(ACC:ValSeq)
    44	      REST:Map
    45	      =>
    46	      RESULT |-> list(derivativeAcc(ACC, INPUT, N))
    47	      REST
    48	    </heap>
    49	    requires N >Int 0
    50	    [label(loop-invariant)]
    51	
    52	  // The two entry claims are exhaustive over IntVals: the empty case and an
    53	  // arbitrary head followed by an arbitrary finite tail.
    54	  claim
    55	    <k>
    56	      Call(Name("derivative"), list(asValSeq(.IntVals)))
    57	      => ref(?RESULT:Int)
    58	    </k>
    59	    <env> 0 </env>
    60	    <scopes>
    61	      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
    62	      -1 |-> builtinsScope
    63	    </scopes>
    64	    <scopeLoc> 1 </scopeLoc>
    65	    <heap>
    66	      .Map
    67	      =>
    68	      ?RESULT |-> list(derivativeSeq(.IntVals))
    69	      ?REST:Map
    70	    </heap>
    71	    <heapLoc> 0 => ?NEXT:Int </heapLoc>
    72	    <stack> .List </stack>
    73	    <ret> noRet </ret>
    74	    <exc> NoExc </exc>
    75	    [label(entry-empty)]
    76	
    77	  claim
    78	    <k>
    79	      Call(
    80	        Name("derivative"),
    81	        list(asValSeq(ivCons(HEAD:Int, TAIL:IntVals)))
    82	      )
    83	      => ref(?RESULT:Int)
    84	    </k>
    85	    <env> 0 </env>
    86	    <scopes>
    87	      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
    88	      -1 |-> builtinsScope
    89	    </scopes>
    90	    <scopeLoc> 1 </scopeLoc>
    91	    <heap>
    92	      .Map
    93	      =>
    94	      ?RESULT |-> list(derivativeSeq(ivCons(HEAD, TAIL)))
    95	      ?REST:Map
    96	    </heap>
    97	    <heapLoc> 0 => ?NEXT:Int </heapLoc>
    98	    <stack> .List </stack>
    99	    <ret> noRet </ret>
   100	    <exc> NoExc </exc>
   101	    [label(entry-cons)]
   102	endmodule

