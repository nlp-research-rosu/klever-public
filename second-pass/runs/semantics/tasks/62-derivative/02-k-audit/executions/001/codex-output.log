diff --git a/evidence/spec-bridge-symbolic-false.k b/evidence/spec-bridge-symbolic-false.k
new file mode 100644
index 0000000000000000000000000000000000000000..3b86440ae1edcf2cc16c3051dac5ffe80ab1533d
