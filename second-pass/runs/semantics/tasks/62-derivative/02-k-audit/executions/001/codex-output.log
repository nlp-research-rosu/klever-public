diff --git a/evidence/spec-bridge-ground-candidate-false.k b/evidence/spec-bridge-ground-candidate-false.k
new file mode 100644
index 0000000000000000000000000000000000000000..fb103bcabb0cd31e954813908dcaa7716c185d78
--- /dev/null
+++ b/evidence/spec-bridge-ground-candidate-false.k
@@ -0,0 +1,14 @@
+requires "verification.k"
+
+module SPEC-BRIDGE-GROUND-CANDIDATE-FALSE
+  imports VERIFICATION
+
+  // Ground instance VS = .IntVals under the same candidate theory.
+  claim
+    <k>
+      truthy(list(enumVS(asValSeq(.IntVals), 0)))
+      =>
+      false
