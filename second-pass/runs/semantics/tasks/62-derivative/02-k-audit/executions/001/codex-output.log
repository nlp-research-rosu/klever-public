+      #loop(
+        list(enumVS(asValSeq(INPUT:IntVals), N:Int)),
+        derivativeTarget,
+        derivativeLoopStep
+        .Stmts
+      )
+      ~> CONT:K
+      => CONT
+    </k>
+    <env> LOCAL:Int </env>
+    <scopes>
+      OTHER:Map
+      LOCAL |->
+        scope(
+          "xs" |-> XSLIST:Val
+          "result" |-> ref(RESULT:Int)
+          "i" |-> PREVIOUSI:Int
+          "x" |-> PREVIOUSX:Int,
+          PARENT:Parent
+        )
+      =>
+      OTHER
+      LOCAL |->
+        scope(
+          "xs" |-> XSLIST
+          "result" |-> ref(RESULT)
+          "i" |-> ?FINALI:Int
+          "x" |-> ?FINALX:Int,
+          PARENT
+        )
+    </scopes>
+    <heap>
+      RESULT |-> list(ACC:ValSeq)
+      REST:Map
+      =>
+      RESULT |-> list(derivativeAcc(ACC, INPUT, N))
