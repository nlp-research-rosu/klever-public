diff --git a/evidence/spec-ground.k b/evidence/spec-ground.k
new file mode 100644
index 0000000000000000000000000000000000000000..7a20a463809fd1cff583c3a448e0430af2b52bc8
--- /dev/null
+++ b/evidence/spec-ground.k
@@ -0,0 +1,63 @@
+requires "verification.k"
+
+module SPEC-GROUND
+  imports VERIFICATION
+
+  claim
+    <k>
+      Call(Name("derivative"), list(asValSeq(.IntVals)))
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ?RESULT |-> list(.ValSeq)
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    [label(ground-empty)]
+
+  claim
+    <k>
+      Call(
+        Name("derivative"),
+        list(
+          asValSeq(
+            ivCons(3,
+              ivCons(1,
+                ivCons(2,
+                  ivCons(4,
+                    ivCons(5, .IntVals)))))
+          )
+        )
+      )
+      => ref(?RESULT:Int)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("derivative" |-> derivativeClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      ?RESULT |->
+        list(vCons(1, vCons(4, vCons(12, vCons(20, .ValSeq)))))
+      ?REST:Map
+    </heap>
+    <heapLoc> 0 => ?NEXT:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    [label(ground-example)]
+endmodule
