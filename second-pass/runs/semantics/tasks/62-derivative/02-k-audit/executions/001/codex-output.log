diff --git a/evidence/stage5_connection_proof.sh b/evidence/stage5_connection_proof.sh
new file mode 100644
index 0000000000000000000000000000000000000000..109103f389c38cc363007816f9a6e3de5b32772a
--- /dev/null
+++ b/evidence/stage5_connection_proof.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
