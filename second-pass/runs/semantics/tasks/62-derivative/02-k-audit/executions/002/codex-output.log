/bin/bash -lc "script -q -e -c 'kompile reference-semantics/semantics.k --backend llvm --main-module MPY-KRUN --syntax-module MPY-SYNTAX --output-definition reviewer-runtime-kompiled' /audit-output/evidence/03-kompile-llvm.log; build_status="'$?; printf '"'llvm_kompile_exit=%s\\n' \""'$build_status"; exit "$build_status"' in /tmp/audit-work/reconstruction
