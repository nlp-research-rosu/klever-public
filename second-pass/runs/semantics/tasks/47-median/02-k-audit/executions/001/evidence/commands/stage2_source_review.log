     1	requires "reference-semantics/semantics.k"
     2	
     3	module MEDIAN-VERIFICATION
     4	  imports MPY
     5	
     6	  // `sortVS` is the supplied trusted ascending-permutation primitive.
     7	  // Sorting preserves length; exposing that fact lets the prover relate the
     8	  // program's `len(sorted(l))` to the input sequence used in the contract.
     9	  rule vsLen(sortVS(VS:ValSeq)) => vsLen(VS) [simplification]
    10	
    11	  // HumanEval exercises this task on integer lists.  This structural
    12	  // predicate records that domain without unrolling an arbitrary sequence.
    13	  syntax Bool ::= allInts(ValSeq) [function, total]
    14	  rule allInts(.ValSeq) => true
    15	  rule allInts(vCons(_:Int, VS:ValSeq)) => allInts(VS)
    16	  rule allInts(vCons(_:Val, _:ValSeq)) => false [owise]
    17	
    18	  // The supplied `sortVS` is deliberately opaque to symbolic execution.
    19	  // Name an in-bounds element of its integer result with an Int-sorted
    20	  // symbol, preserving enough type information for `+` and `/ 2.0`.
    21	  syntax Int ::= sortedIntAt(ValSeq, Int)
    22	    [function, total, symbol(sortedIntAt), no-evaluators]
    23	  rule valSeqAt(sortVS(VS:ValSeq), I:Int) => sortedIntAt(VS, I)
    24	    requires allInts(VS)
    25	     andBool I >=Int 0
    26	     andBool I <Int vsLen(VS)
    27	    [simplification]
    28	endmodule
