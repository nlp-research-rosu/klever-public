+                "attr:function",
+                "attr:total",
+                "attr:functional",
+                "opaque-declaration",
+                "attr:priority",
+                "attr:simplification",
+                "attr:concrete",
+            )
+        )
+    )
+    print(f"file_count={len(files)}")
