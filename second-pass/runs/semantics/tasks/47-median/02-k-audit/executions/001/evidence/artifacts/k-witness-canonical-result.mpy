Module(
  FuncDef("median", Params("l"),
    Assign(Name("values"), Call(Name("sorted"), Name("l")))
    Assign(
      Name("middle"),
      BinOp("//", Call(Name("len"), Name("values")), Int(2)))
    If(Compare(
      BinOp("%", Call(Name("len"), Name("values")), Int(2)),
      CmpOp("==", Int(1))),
      Return(Subscript(Name("values"), Name("middle"))),
      )
    Return(
      BinOp(
        "/",
        BinOp(
          "+",
          Subscript(Name("values"), Name("middle")),
          Subscript(Name("values"), BinOp("+", Name("middle"), Int(1)))),
        Float(2.0))))
  Assert(
    Compare(
      Call(Name("median"), ListExpr(Int(4), Int(1), Int(3), Int(2))),
      CmpOp("==", Float(2.5)))))
