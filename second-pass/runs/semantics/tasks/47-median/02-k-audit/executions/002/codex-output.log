+      ~> Call(Name("median"), list(VS:ValSeq))
+      =>
+      sortedIntAt(VS, (vsLen(VS) -Int 1) /Int 2) +Int 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
