new file mode 100644
index 0000000000000000000000000000000000000000..36bebb92130226f65a4134aa250ab3200fdce67c
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,12 @@
+def median(l: list):
+    values = sorted(l)
+    middle = len(values) // 2
+    if len(values) % 2 == 1:
+        return values[middle]
+    return (values[middle] + values[middle + 1]) / 2.0
+
+
+assert median([3, 1, 2, 4, 5]) == 3
+assert median([-10, 4, 6, 1000, 10, 20]) == 15.0
+assert median([7]) == 7
+assert median([4, 1, 3, 2]) == 3.5
