diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..5006bd1ee82c043c2e531a80d6227eeb887f19d2
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,6 @@
+def median(l: list):
+    values = sorted(l)
+    middle = len(values) // 2
+    if len(values) % 2 == 1:
+        return values[middle]
+    return (values[middle] + values[middle + 1]) / 2.0
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..4dfa4cf198f006e788f594f5c5dadff248870ea5
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,100 @@
+requires "verification.k"
+
+module MEDIAN-SPEC
+  imports MEDIAN-VERIFICATION
+
+  claim [median-odd]:
+    <k>
+      #loadAll(Module(
+        FuncDef("median", Params("l"),
+          Assign(Name("values"), Call(Name("sorted"), Name("l")))
+          Assign(
+            Name("middle"),
+            BinOp("//", Call(Name("len"), Name("values")), Int(2)))
+          If(Compare(
+            BinOp("%", Call(Name("len"), Name("values")), Int(2)),
+            CmpOp("==", Int(1))),
+            Return(Subscript(Name("values"), Name("middle"))),
+            .Stmts)
+          Return(
+            BinOp(
+              "/",
+              BinOp(
+                "+",
+                Subscript(Name("values"), Name("middle")),
+                Subscript(
+                  Name("values"),
+                  BinOp("+", Name("middle"), Int(1)))),
+              Float(2.0)))
+        )))
+      ~> Call(Name("median"), list(VS:ValSeq))
+      =>
+      sortedIntAt(VS, (vsLen(VS) -Int 1) /Int 2)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      ?_:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?_:Map </heap>
+    <heapLoc> 0 => ?_:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+     andBool vsLen(VS) >Int 0
+     andBool pyMod(vsLen(VS), 2) ==Int 1
+
+  claim [median-even]:
+    <k>
+      #loadAll(Module(
+        FuncDef("median", Params("l"),
+          Assign(Name("values"), Call(Name("sorted"), Name("l")))
+          Assign(
+            Name("middle"),
+            BinOp("//", Call(Name("len"), Name("values")), Int(2)))
+          If(Compare(
+            BinOp("%", Call(Name("len"), Name("values")), Int(2)),
+            CmpOp("==", Int(1))),
+            Return(Subscript(Name("values"), Name("middle"))),
+            .Stmts)
+          Return(
+            BinOp(
+              "/",
+              BinOp(
+                "+",
+                Subscript(Name("values"), Name("middle")),
+                Subscript(
+                  Name("values"),
+                  BinOp("+", Name("middle"), Int(1)))),
+              Float(2.0)))
+        )))
+      ~> Call(Name("median"), list(VS:ValSeq))
+      =>
+      intFloatDiv(
+        sortedIntAt(VS, vsLen(VS) /Int 2)
+        +Int sortedIntAt(VS, vsLen(VS) /Int 2 +Int 1),
+        2.0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      ?_:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?_:Map </heap>
+    <heapLoc> 0 => ?_:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+     andBool vsLen(VS) >=Int 4
+     andBool pyMod(vsLen(VS), 2) ==Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..1703f2b60875eb35a01adc5ebf905b92ffc1a682
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,28 @@
+requires "reference-semantics/semantics.k"
+
+module MEDIAN-VERIFICATION
+  imports MPY
+
+  // `sortVS` is the supplied trusted ascending-permutation primitive.
+  // Sorting preserves length; exposing that fact lets the prover relate the
+  // program's `len(sorted(l))` to the input sequence used in the contract.
+  rule vsLen(sortVS(VS:ValSeq)) => vsLen(VS) [simplification]
+
+  // HumanEval exercises this task on integer lists.  This structural
+  // predicate records that domain without unrolling an arbitrary sequence.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(_:Int, VS:ValSeq)) => allInts(VS)
+  rule allInts(vCons(_:Val, _:ValSeq)) => false [owise]
+
+  // The supplied `sortVS` is deliberately opaque to symbolic execution.
+  // Name an in-bounds element of its integer result with an Int-sorted
+  // symbol, preserving enough type information for `+` and `/ 2.0`.
+  syntax Int ::= sortedIntAt(ValSeq, Int)
+    [function, total, symbol(sortedIntAt), no-evaluators]
+  rule valSeqAt(sortVS(VS:ValSeq), I:Int) => sortedIntAt(VS, I)
+    requires allInts(VS)
+     andBool I >=Int 0
+     andBool I <Int vsLen(VS)
+    [simplification]
+endmodule

