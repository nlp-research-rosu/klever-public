diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f269d0cd41ab5f5a84859f145b277582b01b7714
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,73 @@
+requires "verification.k"
+
+module MEDIAN-SPEC
+  imports MEDIAN-VERIFICATION
+
+  claim [median-odd]:
+    <k>
+      #loadAll(Module(
+        FuncDef("median", Params("l"),
+          Assign(Name("values"), Call(Name("sorted"), Name("l")))
+          Assign(
+            Name("middle"),
+            BinOp("//", Call(Name("len"), Name("values")), Int(2)))
+          If(Compare(
+            BinOp("%", Call(Name("len"), Name("values")), Int(2)),
+            CmpOp("==", Int(1))),
+            Return(Subscript(Name("values"), Name("middle"))),
+            .Stmts)
+          Return(
+            BinOp(
+              "/",
+              BinOp(
+                "+",
+                Subscript(Name("values"), Name("middle")),
+                Subscript(
+                  Name("values"),
+                  BinOp("+", Name("middle"), Int(1)))),
+              Float(2.0)))
+        ))
+      ~> Call(Name("median"), list(VS:ValSeq))
+      =>
+      valSeqAt(sortVS(VS), vsLen(VS) /Int 2)
+    </k>
+    requires vsLen(VS) >Int 0
+     andBool pyMod(vsLen(VS), 2) ==Int 1
+
+  claim [median-even]:
+    <k>
+      #loadAll(Module(
+        FuncDef("median", Params("l"),
+          Assign(Name("values"), Call(Name("sorted"), Name("l")))
+          Assign(
+            Name("middle"),
+            BinOp("//", Call(Name("len"), Name("values")), Int(2)))
+          If(Compare(
+            BinOp("%", Call(Name("len"), Name("values")), Int(2)),
+            CmpOp("==", Int(1))),
+            Return(Subscript(Name("values"), Name("middle"))),
+            .Stmts)
+          Return(
+            BinOp(
+              "/",
+              BinOp(
+                "+",
+                Subscript(Name("values"), Name("middle")),
+                Subscript(
+                  Name("values"),
+                  BinOp("+", Name("middle"), Int(1)))),
+              Float(2.0)))
+        ))
+      ~> Call(Name("median"), list(VS:ValSeq))
+      =>
+      applyBin(
+        "/",
+        applyBin(
+          "+",
+          valSeqAt(sortVS(VS), vsLen(VS) /Int 2),
+          valSeqAt(sortVS(VS), vsLen(VS) /Int 2 +Int 1)),
+        2.0)
+    </k>
+    requires vsLen(VS) >Int 0
+     andBool pyMod(vsLen(VS), 2) =/=Int 1
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b81a18011d54ff88f84bb8519ce016d0657f9207
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,10 @@
+requires "reference-semantics/semantics.k"
+
+module MEDIAN-VERIFICATION
+  imports MPY
+
+  // `sortVS` is the supplied trusted ascending-permutation primitive.
+  // Sorting preserves length; exposing that fact lets the prover relate the
+  // program's `len(sorted(l))` to the input sequence used in the contract.
+  rule vsLen(sortVS(VS:ValSeq)) => vsLen(VS)
+endmodule

