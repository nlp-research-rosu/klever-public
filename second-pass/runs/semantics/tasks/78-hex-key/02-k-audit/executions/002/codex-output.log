       requires slStep(ST) >Int 0

--- K0871 reference-semantics/semantics/subscript.k:86 kind=rule tags=equational
  rule slStop(noB,          ST:OptInt, _LEN:Int) => -1
       requires slStep(ST) <Int 0

--- K0872 reference-semantics/semantics/subscript.k:88 kind=rule tags=equational
