+
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("digit"), hexKeyLoopBodyMutated)
+      ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (L |-> scope("count" |-> ACC
+                   "digit" |-> DIGIT:Val
+                   "num" |-> NUM:Val,
+                   parent(0))) CALLERSCOPES:Map
