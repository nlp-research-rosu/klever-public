--- K0523 reference-semantics/semantics/float.k:199 kind=rule tags=equational
  rule applyBin("-", I:Int, F:Float) => subF(intToF(I), F)

--- K0524 reference-semantics/semantics/float.k:200 kind=rule tags=equational
  rule applyBin("-", F:Float, I:Int) => subF(F, intToF(I))

--- K0525 reference-semantics/semantics/float.k:201 kind=rule tags=equational
  rule applyBin("*", I:Int, F:Float) => mulF(intToF(I), F)

--- K0526 reference-semantics/semantics/float.k:202 kind=rule tags=equational
  rule applyBin("*", F:Float, I:Int) => mulF(F, intToF(I))

