       requires I >Int 0

--- K0834 reference-semantics/semantics/subscript.k:16 kind=syntax tags=function
  syntax Int ::= intSeqAt(IntSeq, Int) [function]

--- K0835 reference-semantics/semantics/subscript.k:17 kind=rule tags=equational
  rule intSeqAt(iCons(C:Int, _:IntSeq), 0)     => C

--- K0836 reference-semantics/semantics/subscript.k:18 kind=rule tags=equational
  rule intSeqAt(iCons(_:Int, S:IntSeq), I:Int) => intSeqAt(S, I -Int 1)
       requires I >Int 0

--- K0837 reference-semantics/semantics/subscript.k:21 kind=syntax tags=function,total
  syntax Int ::= normIdx(Int, Int) [function, total]

--- K0838 reference-semantics/semantics/subscript.k:22 kind=rule tags=equational
  rule normIdx(I:Int, LEN:Int) => I +Int LEN requires I  <Int 0

--- K0839 reference-semantics/semantics/subscript.k:23 kind=rule tags=strict,equational
