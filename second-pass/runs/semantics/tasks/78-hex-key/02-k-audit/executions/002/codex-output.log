+      ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (L |-> scope("count" |-> ACC
+                   "digit" |-> DIGIT:Val
+                   "num" |-> NUM:Val,
