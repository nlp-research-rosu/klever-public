  // inserts, at priority(40) over these.

--- K0787 reference-semantics/semantics/sort.k:49 kind=syntax tags=function,total,symbol,no-evaluators
  syntax ValSeq ::= sortKeyVS(ValSeq, Val) [function, total, symbol(sortKeyVS), no-evaluators]

--- K0788 reference-semantics/semantics/sort.k:51 kind=syntax tags=function,total
  syntax ValSeq ::= revVS(ValSeq) [function, total]
