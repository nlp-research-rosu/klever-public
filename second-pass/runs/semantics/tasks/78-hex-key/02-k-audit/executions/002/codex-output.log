--- K0869 reference-semantics/semantics/subscript.k:83 kind=syntax tags=function
  syntax Int ::= slStop(OptInt, OptInt, Int) [function]

--- K0870 reference-semantics/semantics/subscript.k:84 kind=rule tags=equational
