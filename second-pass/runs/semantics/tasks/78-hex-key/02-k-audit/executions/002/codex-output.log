--- K0784 reference-semantics/semantics/sort.k:31 kind=rule tags=owise,concrete,equational
  rule insVSs(A:IntSeq, vCons(str(B:IntSeq), R:ValSeq)) => vCons(str(B), insVSs(A, R))
