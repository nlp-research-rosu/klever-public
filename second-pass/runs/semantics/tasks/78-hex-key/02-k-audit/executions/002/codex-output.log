--- K0810 reference-semantics/semantics/str.k:29 kind=rule tags=equational
  rule applyCmp("in",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)

--- K0811 reference-semantics/semantics/str.k:30 kind=rule tags=equational
  rule applyCmp("not in", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)

--- K0812 reference-semantics/semantics/str.k:32 kind=syntax tags=function,total
  syntax Bool ::= strPrefix(IntSeq, IntSeq) [function, total]

--- K0813 reference-semantics/semantics/str.k:33 kind=rule tags=equational
  rule strPrefix(.IntSeq, _:IntSeq)               => true

--- K0814 reference-semantics/semantics/str.k:34 kind=rule tags=equational
  rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false

--- K0815 reference-semantics/semantics/str.k:35 kind=rule tags=equational
  rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)

--- K0816 reference-semantics/semantics/str.k:37 kind=syntax tags=function,total
  syntax Bool ::= strContains(IntSeq, IntSeq) [function, total]

--- K0817 reference-semantics/semantics/str.k:38 kind=rule tags=equational
  rule strContains(P:IntSeq, X:IntSeq) => true  requires strPrefix(P, X)

--- K0818 reference-semantics/semantics/str.k:39 kind=rule tags=equational
  rule strContains(P:IntSeq, .IntSeq)  => false requires notBool strPrefix(P, .IntSeq)

--- K0819 reference-semantics/semantics/str.k:40 kind=rule tags=equational
  rule strContains(P:IntSeq, iCons(C:Int, Xs:IntSeq)) => strContains(P, Xs)
