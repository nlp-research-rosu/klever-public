/bin/bash -lc "rg -l --hidden --glob '*.py' --glob '*.sh' 'candidate_tree_sha256|trusted_reference_semantics_manifest_sha256|workspace_sha256' /opt /usr/local /app /workspace /home/agent 2>/dev/null | head -100" in /audit-output
