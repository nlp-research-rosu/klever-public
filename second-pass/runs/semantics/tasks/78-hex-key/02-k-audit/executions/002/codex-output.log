                  | dedupFrom(IntSeq, IntSeq)  [function, total]

--- K0760 reference-semantics/semantics/set.k:18 kind=rule tags=equational
  rule dedupCodes(CS:IntSeq) => dedupFrom(CS, .IntSeq)

--- K0761 reference-semantics/semantics/set.k:19 kind=rule tags=equational
  rule dedupFrom(.IntSeq, ACC:IntSeq) => ACC

--- K0762 reference-semantics/semantics/set.k:20 kind=rule tags=equational
