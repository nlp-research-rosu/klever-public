+      ~> Call(Name("hex_key"), str(CS:IntSeq))
+      => hexCount(CS) +Int 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       =>
+       0 |-> scope(
+         "hex_key" |-> closureVal(("num", .ParamNames), hexKeyBody, 0),
+         parent(-1)))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(false-entry-result)]
+endmodule
