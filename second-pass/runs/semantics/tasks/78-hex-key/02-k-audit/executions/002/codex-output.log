--- K0755 reference-semantics/semantics/set.k:8 kind=syntax tags=none
  syntax Val ::= setV(IntSeq)

  // membership of a code in the accumulated distinct-code sequence

--- K0756 reference-semantics/semantics/set.k:11 kind=syntax tags=function,total
  syntax Bool ::= codeIn(Int, IntSeq) [function, total]

--- K0757 reference-semantics/semantics/set.k:12 kind=rule tags=equational
  rule codeIn(_:Int, .IntSeq)                => false

--- K0758 reference-semantics/semantics/set.k:13 kind=rule tags=equational
