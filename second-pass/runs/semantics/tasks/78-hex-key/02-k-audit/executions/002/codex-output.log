   rel=p.relative_to(root).as_posix().encode(); data=p.read_bytes()
   if include_path: h.update(rel); h.update(sep)
   if include_size: h.update(str(len(data)).encode()); h.update(sep)
   h.update(hashlib.sha256(data).digest() if include_hash else data)
  methods[name]=h.hexdigest()
 print(root)
 for k,v in methods.items(): print(k,v)
