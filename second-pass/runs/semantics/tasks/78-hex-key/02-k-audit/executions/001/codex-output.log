kast regenerated-solution.mpy --definition verification-kompiled --module HEX-KEY-VERIFICATION --sort Module --expand-macros --output kast > parsed-solution.kast
s1=$?
printf '"'EXIT_STATUS: %s\\n' \""'$s1" | tee -a "$log"
printf '"'%s\\n' 'COMMAND: kast --expression Module(FuncDef(\"hex_key\",Params(\"num\"),hexKeyBody)) --definition verification-kompiled --module HEX-KEY-VERIFICATION --sort Module --expand-macros --output kast > parsed-claim-program.kast' | tee -a \""'$log"
kast --expression '"'Module(FuncDef(\"hex_key\", Params(\"num\"), hexKeyBody))' --definition verification-kompiled --module HEX-KEY-VERIFICATION --sort Module --expand-macros --output kast > parsed-claim-program.kast
s2="'$?
printf '"'EXIT_STATUS: %s\\n' \""'$s2" | tee -a "$log"
printf '"'%s\\n' 'COMMAND: cmp -s parsed-solution.kast parsed-claim-program.kast' | tee -a \""'$log"
cmp -s parsed-solution.kast parsed-claim-program.kast
s3=$?
printf '"'EXIT_STATUS: %s\\n' \""'$s3" | tee -a "$log"
sha256sum parsed-solution.kast parsed-claim-program.kast | tee -a "$log"
printf '"'%s\\n' 'PARSED TERM:' | tee -a \""'$log"
sed -n '"'1,80p' parsed-solution.kast | tee -a \""'$log"
if [ "$s1" -ne 0 ] || [ "$s2" -ne 0 ] || [ "$s3" -ne 0 ]; then diff -u parsed-solution.kast parsed-claim-program.kast | tee -a "$log"; exit 1; fi' in /tmp/audit-work/78-hex-key
