index 0000000000000000000000000000000000000000..b40f65f7699bbbe52734342349e78fec11599e06
--- /dev/null
+++ b/evidence/verification-body-mutation.k
@@ -0,0 +1,39 @@
+requires "reference-semantics/semantics.k"
+
+module HEX-KEY-VERIFICATION-BODY-MUTATION
+  imports MPY
+
+  // Fresh material body mutation: a matching digit increments by 2, not 1.
+  syntax Stmts ::= "hexKeyLoopBody" [macro]
+  rule hexKeyLoopBody
+    => If(Compare(Name("digit"), CmpOp("in", Str("2357BD"))),
+          AugAssign(Name("count"), "+", Int(2)),
+          .Stmts)
+
+  syntax Stmts ::= "hexKeyBody" [macro]
+  rule hexKeyBody
+    => Assign(Name("count"), Int(0))
+       Assign(Name("digit"), Str(""))
+       For(Name("digit"), Name("num"), hexKeyLoopBody)
+       Return(Name("count"))
+
+  syntax Bool ::= isPrimeHexCode(Int) [function, total]
+  rule isPrimeHexCode(C:Int)
+    => strContains(iCons(C, .IntSeq),
+                   iCons(50, iCons(51, iCons(53, iCons(55,
+                   iCons(66, iCons(68, .IntSeq)))))))
+
+  syntax Int ::= primeHexBit(Int) [function, total]
+  rule primeHexBit(C:Int)
+    => #if isPrimeHexCode(C) #then 1 #else 0 #fi
+
+  syntax Int ::= hexCount(IntSeq) [function, total]
+  rule hexCount(.IntSeq) => 0
+  rule hexCount(iCons(C:Int, REST:IntSeq))
+    => primeHexBit(C) +Int hexCount(REST)
+
+  syntax Val ::= finalDigit(IntSeq, Val) [function, total]
+  rule finalDigit(.IntSeq, OLD:Val) => OLD
+  rule finalDigit(iCons(C:Int, REST:IntSeq), _OLD:Val)
+    => finalDigit(REST, str(iCons(C, .IntSeq)))
+endmodule

Completed the trust accounting and wrote the seven-stage report with evidence citations and the required terminal markers. Evidence scripts, mutations, bounded logs, full static inventory, inputs, and hashes are preserved under /audit-output/evidence.
  ✓ Read mandated Kit skill instructions and verify trusted-mode infrastructure
  ✓ Audit input provenance and program fidelity; build independent differential evidence
  ✓ Reconstruct definitions and rerun every positive proof claim from clean sources
  ✓ Review claim adequacy, real-program pinning, and every K rule statically
  ✓ Create and run a fresh false non-vacuity mutation
  ✓ Account for proven versus assumed boundaries and write REVIEW.md with verdict
