+assert hex_key("B") == 1
+assert hex_key("C") == 0
+assert hex_key("D") == 1
+assert hex_key("E") == 0
+assert hex_key("F") == 0
+assert hex_key("2357BD") == 6
+assert hex_key("014689ACEF") == 0
