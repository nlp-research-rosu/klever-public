log=/audit-output/evidence/12-static-inventory.log
printf '%s\\n' 'COMMAND: python3 /audit-output/evidence/static_inventory.py' | tee \""'$log"
python3 /audit-output/evidence/static_inventory.py 2>&1 | tee -a "$log"
status=${PIPESTATUS[0]}
printf '"'EXIT_STATUS: %s\\n' \""'$status" | tee -a "$log"
printf '"'used_path_entries=' | tee -a \""'$log"
rg -c '"'\\| USED PATH \\|' /audit-output/evidence/static-rule-inventory.md | tee -a \""'$log"
exit "$status"' in /audit-output
