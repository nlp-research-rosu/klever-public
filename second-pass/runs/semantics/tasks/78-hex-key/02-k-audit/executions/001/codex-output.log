diff --git a/evidence/spec-ground-witnesses.k b/evidence/spec-ground-witnesses.k
new file mode 100644
index 0000000000000000000000000000000000000000..31bd86ac9028e7ace639fc2adc2a241e45351ece
--- /dev/null
+++ b/evidence/spec-ground-witnesses.k
@@ -0,0 +1,58 @@
+requires "verification.k"
+
+module HEX-KEY-GROUND-WITNESSES
+  imports HEX-KEY-VERIFICATION
+
+  // A concrete state satisfying the entry precondition: empty input.
+  claim
+    <k>
+      #loadAll(Module(
+        FuncDef("hex_key", Params("num"), hexKeyBody)))
+      ~> Call(Name("hex_key"), str(.IntSeq))
+      => 0
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
