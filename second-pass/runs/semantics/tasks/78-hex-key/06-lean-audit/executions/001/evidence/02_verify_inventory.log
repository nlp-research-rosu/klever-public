      "start_line": 9,
      "text": "  rule hexKeyLoopBody\n    => If(Compare(Name(\"digit\"), CmpOp(\"in\", Str(\"2357BD\"))),\n          AugAssign(Name(\"count\"), \"+\", Int(1)),\n          .Stmts)"
    },
    {
      "attributes": [],
      "end_line": 19,
      "module": "HEX-KEY-VERIFICATION",
      "normalized_sha256": "997f1164935d81cf0a177321cded75d4547861c8641b38c27297eb3d9a029072",
      "source_rule_id": "rule-997f1164935d81cf0a177321cded75d4547861c8641b38c27297eb3d9a029072",
      "start_line": 15,
      "text": "  rule hexKeyBody\n    => Assign(Name(\"count\"), Int(0))\n       Assign(Name(\"digit\"), Str(\"\"))\n       For(Name(\"digit\"), Name(\"num\"), hexKeyLoopBody)\n       Return(Name(\"count\"))"
    },
    {
      "attributes": [],
      "end_line": 26,
      "module": "HEX-KEY-VERIFICATION",
      "normalized_sha256": "05b5f69701a4c26d96e9102f57d9aa376b71ec50124579bbae35e8fbfd93bf81",
      "source_rule_id": "rule-05b5f69701a4c26d96e9102f57d9aa376b71ec50124579bbae35e8fbfd93bf81",
      "start_line": 23,
      "text": "  rule isPrimeHexCode(C:Int)\n    => strContains(iCons(C, .IntSeq),\n                   iCons(50, iCons(51, iCons(53, iCons(55,\n                   iCons(66, iCons(68, .IntSeq)))))))"
    },
    {
      "attributes": [],
      "end_line": 30,
      "module": "HEX-KEY-VERIFICATION",
      "normalized_sha256": "3532524624ac91c8c5bef2d87f5c2bf88f8419752a22a63b80e9c9fca7ff5702",
      "source_rule_id": "rule-3532524624ac91c8c5bef2d87f5c2bf88f8419752a22a63b80e9c9fca7ff5702",
      "start_line": 29,
      "text": "  rule primeHexBit(C:Int)\n    => #if isPrimeHexCode(C) #then 1 #else 0 #fi"
    },
    {
      "attributes": [],
      "end_line": 33,
      "module": "HEX-KEY-VERIFICATION",
