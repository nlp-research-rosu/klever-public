+requires "verification.k"
+
+module HEX-KEY-SPEC
+  imports HEX-KEY-VERIFICATION
+
+  // Inductive loop lemma.  It includes the return and frame pop so that the
+  // loop-local "digit" binding is unobservable in the post-state.
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("digit"), hexKeyLoopBody)
+      ~> Return(Name("count"))
+      ~> #endcall
+      => (ACC:Int +Int hexCount(CS)) ~> CONT:K
+    </k>
+    <env> L:Int => CALLER:Int </env>
+    <scopes>
+      (L |-> scope(("count" |-> ACC) LOCAL:Map, parent(0))) CALLER-SCOPES:Map
+      => CALLER-SCOPES
+    </scopes>
+    <scopeLoc> L +Int 1 => L </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> HEAPLOC:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, L)) REST-STACK:List
+      => REST-STACK
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Entry-point theorem for every symbolic string.
+  claim
+    <k>
+      Call(closureVal(("num", .ParamNames), hexKeyBody, 0),
+           str(CS:IntSeq))
+      => hexCount(CS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..02fd8513c8dea4d760c10226f6fd5053a3fd5681
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,34 @@
+requires "reference-semantics/semantics.k"
+
+module HEX-KEY-VERIFICATION
+  imports MPY
+
+  // The exact statement trees emitted for solution.py, named so that the
+  // implementation and the proof claims share one readable representation.
+  syntax Stmts ::= "hexKeyLoopBody" [macro]
+  rule hexKeyLoopBody
+    => If(Compare(Name("digit"), CmpOp("in", Str("2357BD"))),
+          AugAssign(Name("count"), "+", Int(1)),
+          .Stmts)
+
+  syntax Stmts ::= "hexKeyBody" [macro]
+  rule hexKeyBody
+    => Assign(Name("count"), Int(0))
+       For(Name("digit"), Name("num"), hexKeyLoopBody)
+       Return(Name("count"))
+
+  // Mathematical contract: count exactly the codes for 2, 3, 5, 7, B, D.
+  syntax Bool ::= isPrimeHexCode(Int) [function, total]
+  rule isPrimeHexCode(C:Int)
+    => C ==Int 50 orBool C ==Int 51 orBool C ==Int 53
+       orBool C ==Int 55 orBool C ==Int 66 orBool C ==Int 68
+
+  syntax Int ::= primeHexBit(Int) [function, total]
+  rule primeHexBit(C:Int)
+    => #if isPrimeHexCode(C) #then 1 #else 0 #fi
+
+  syntax Int ::= hexCount(IntSeq) [function, total]
+  rule hexCount(.IntSeq) => 0
+  rule hexCount(iCons(C:Int, REST:IntSeq))
+    => primeHexBit(C) +Int hexCount(REST)
+endmodule

