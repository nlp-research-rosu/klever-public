  rule <k> Subscript(ref(H:Int), IX:Index) => Subscript(V, IX) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]

  rule <k> Subscript(OBJ:Val, I:Int) => applyIndex(OBJ, I) ... </k>

  syntax Val ::= applyIndex(Val, Int) [function]
