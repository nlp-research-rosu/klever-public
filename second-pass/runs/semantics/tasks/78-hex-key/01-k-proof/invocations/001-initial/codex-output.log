+def hex_key(num):
+    count = 0
+    digit = ""
+    for digit in num:
+        if digit in "2357BD":
+            count += 1
+    return count
+
+
+assert hex_key("") == 0
+assert hex_key("AB") == 1
+assert hex_key("1077E") == 2
+assert hex_key("ABED1A33") == 4
