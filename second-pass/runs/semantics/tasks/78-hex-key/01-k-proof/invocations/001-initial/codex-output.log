diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c228b53415a16b962e2afb6fe8bc453e1c6f5f15
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,56 @@
+requires "verification.k"
+
+module HEX-KEY-SPEC
+  imports HEX-KEY-VERIFICATION
+
+  // Inductive loop lemma: count accumulates the mathematical count, and the
+  // induction variable retains its old value on empty input or the final
+  // character otherwise.
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("digit"), hexKeyLoopBody)
+      ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (L |-> scope("count" |-> ACC
+                   "digit" |-> DIGIT:Val
+                   "num" |-> NUM:Val,
+                   parent(0))) CALLERSCOPES:Map
+      =>
+      (L |-> scope("count" |-> (ACC +Int hexCount(CS))
+                   "digit" |-> finalDigit(CS, DIGIT)
+                   "num" |-> NUM,
+                   parent(0))) CALLERSCOPES
+    </scopes>
+    <scopeLoc> _SCOPELOC:Int </scopeLoc>
+    <heap> _HEAP:Map </heap>
+    <heapLoc> _HEAPLOC:Int </heapLoc>
+    <stack> _STACK:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(loop-lemma)]
+
+  // Entry-point theorem for every symbolic string.
+  claim
+    <k>
+      Call(closureVal(("num", .ParamNames), hexKeyBody, 0),
+           str(CS:IntSeq))
+      => hexCount(CS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(entry-point)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4899118d965b5cea51bf70e23ed6f6bc48f06e84
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,43 @@
+requires "reference-semantics/semantics.k"
+
+module HEX-KEY-VERIFICATION
+  imports MPY
+
+  // The exact statement trees emitted for solution.py, named so that the
+  // implementation and the proof claims share one readable representation.
+  syntax Stmts ::= "hexKeyLoopBody" [macro]
+  rule hexKeyLoopBody
+    => If(Compare(Name("digit"), CmpOp("in", Str("2357BD"))),
+          AugAssign(Name("count"), "+", Int(1)),
+          .Stmts)
+
+  syntax Stmts ::= "hexKeyBody" [macro]
+  rule hexKeyBody
+    => Assign(Name("count"), Int(0))
+       Assign(Name("digit"), Str(""))
+       For(Name("digit"), Name("num"), hexKeyLoopBody)
+       Return(Name("count"))
+
+  // Mathematical contract: count exactly the codes for 2, 3, 5, 7, B, D.
+  syntax Bool ::= isPrimeHexCode(Int) [function, total]
+  rule isPrimeHexCode(C:Int)
+    => strContains(iCons(C, .IntSeq),
+                   iCons(50, iCons(51, iCons(53, iCons(55,
+                   iCons(66, iCons(68, .IntSeq)))))))
+
+  syntax Int ::= primeHexBit(Int) [function, total]
+  rule primeHexBit(C:Int)
+    => #if isPrimeHexCode(C) #then 1 #else 0 #fi
+
+  syntax Int ::= hexCount(IntSeq) [function, total]
+  rule hexCount(.IntSeq) => 0
+  rule hexCount(iCons(C:Int, REST:IntSeq))
+    => primeHexBit(C) +Int hexCount(REST)
+
+  // The loop's final value for its induction variable (used only in the loop
+  // invariant; it is not observable in hex_key's return value).
+  syntax Val ::= finalDigit(IntSeq, Val) [function, total]
+  rule finalDigit(.IntSeq, OLD:Val) => OLD
+  rule finalDigit(iCons(C:Int, REST:IntSeq), _OLD:Val)
+    => finalDigit(REST, str(iCons(C, .IntSeq)))
+endmodule

exec
/bin/bash -lc ./prove.sh in /work
