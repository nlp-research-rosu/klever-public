{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 12,
      "module": "HEX-KEY-VERIFICATION",
      "normalized_sha256": "a21c4e1376187971c7643f3e565cabcbfd4adf8fb326ad1b1ed66d8ccf2ee5dc",
      "rationale": "This macro equation expands the named hexKeyLoopBody proof term into the exact translated loop-body statement tree.",
      "source_rule_id": "rule-a21c4e1376187971c7643f3e565cabcbfd4adf8fb326ad1b1ed66d8ccf2ee5dc",
      "start_line": 9,
      "text": "  rule hexKeyLoopBody\n    => If(Compare(Name(\"digit\"), CmpOp(\"in\", Str(\"2357BD\"))),\n          AugAssign(Name(\"count\"), \"+\", Int(1)),\n          .Stmts)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 19,
      "module": "HEX-KEY-VERIFICATION",
      "normalized_sha256": "997f1164935d81cf0a177321cded75d4547861c8641b38c27297eb3d9a029072",
      "rationale": "This macro equation expands the named hexKeyBody proof term into the exact translated function-body statement sequence.",
      "source_rule_id": "rule-997f1164935d81cf0a177321cded75d4547861c8641b38c27297eb3d9a029072",
      "start_line": 15,
      "text": "  rule hexKeyBody\n    => Assign(Name(\"count\"), Int(0))\n       Assign(Name(\"digit\"), Str(\"\"))\n       For(Name(\"digit\"), Name(\"num\"), hexKeyLoopBody)\n       Return(Name(\"count\"))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 26,
      "module": "HEX-KEY-VERIFICATION",
      "normalized_sha256": "05b5f69701a4c26d96e9102f57d9aa376b71ec50124579bbae35e8fbfd93bf81",
      "rationale": "This equation defines isPrimeHexCode by applying the existing string-containment summary to the fixed character-code sequence for 2, 3, 5, 7, B, and D.",
      "source_rule_id": "rule-05b5f69701a4c26d96e9102f57d9aa376b71ec50124579bbae35e8fbfd93bf81",
      "start_line": 23,
      "text": "  rule isPrimeHexCode(C:Int)\n    => strContains(iCons(C, .IntSeq),\n                   iCons(50, iCons(51, iCons(53, iCons(55,\n                   iCons(66, iCons(68, .IntSeq)))))))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 30,
      "module": "HEX-KEY-VERIFICATION",
      "normalized_sha256": "3532524624ac91c8c5bef2d87f5c2bf88f8419752a22a63b80e9c9fca7ff5702",
      "rationale": "This equation defines the numeric indicator primeHexBit as 1 or 0 according to the previously defined predicate.",
      "source_rule_id": "rule-3532524624ac91c8c5bef2d87f5c2bf88f8419752a22a63b80e9c9fca7ff5702",
      "start_line": 29,
      "text": "  rule primeHexBit(C:Int)\n    => #if isPrimeHexCode(C) #then 1 #else 0 #fi"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 33,
      "module": "HEX-KEY-VERIFICATION",
      "normalized_sha256": "1f493419665e264916f30ab5358e05eef39549f5227088474c1ff240d5e27abe",
      "rationale": "This is the empty-sequence base equation of the recursive mathematical summary hexCount.",
      "source_rule_id": "rule-1f493419665e264916f30ab5358e05eef39549f5227088474c1ff240d5e27abe",
      "start_line": 33,
      "text": "  rule hexCount(.IntSeq) => 0"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 35,
      "module": "HEX-KEY-VERIFICATION",
      "normalized_sha256": "690663e02cb1ae6cd79a33453a4d2c75dbd0a76973cc10dc57fcdd89a7cf8993",
      "rationale": "This is the constructor recurrence defining hexCount as the head indicator plus the count of the remaining code sequence.",
      "source_rule_id": "rule-690663e02cb1ae6cd79a33453a4d2c75dbd0a76973cc10dc57fcdd89a7cf8993",
      "start_line": 34,
      "text": "  rule hexCount(iCons(C:Int, REST:IntSeq))\n    => primeHexBit(C) +Int hexCount(REST)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 40,
      "module": "HEX-KEY-VERIFICATION",
      "normalized_sha256": "2c5863a720c0bb1e81a39efe6316267a1af396797c22acd873b152227333ade3",
      "rationale": "This is the empty-sequence base equation for the structural helper finalDigit, preserving the prior loop-variable value.",
      "source_rule_id": "rule-2c5863a720c0bb1e81a39efe6316267a1af396797c22acd873b152227333ade3",
      "start_line": 40,
      "text": "  rule finalDigit(.IntSeq, OLD:Val) => OLD"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 42,
      "module": "HEX-KEY-VERIFICATION",
      "normalized_sha256": "f95b3740442b75f1ff5a75424586af712960c05b37858b16c5f6802d8b9b2d38",
      "rationale": "This is the constructor recurrence defining finalDigit by carrying the current character into the recursive call.",
      "source_rule_id": "rule-f95b3740442b75f1ff5a75424586af712960c05b37858b16c5f6802d8b9b2d38",
      "start_line": 41,
      "text": "  rule finalDigit(iCons(C:Int, REST:IntSeq), _OLD:Val)\n    => finalDigit(REST, str(iCons(C, .IntSeq)))"
    }
  ],
