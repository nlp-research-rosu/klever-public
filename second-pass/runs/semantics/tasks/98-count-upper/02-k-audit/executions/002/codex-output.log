+        "count_upper" |->
+          closureVal(
+            ("s", .ParamNames),
+            Assign(Name("count"), Int(0))
+            Assign(Name("even"), Bool(false))
+            Assign(Name("ch"), Str(""))
+            For(
+              Name("ch"),
+              Name("s"),
+              AugAssign(
+                Name("count"),
+                "+",
+                BoolOp(
+                  "and",
+                  Name("even"),
+                  Compare(Name("ch"), CmpOp("in", Str("AEIOU")))))
+              Assign(Name("even"), UnaryOp("not", Name("even")))
+              .Stmts)
+            Return(Name("count"))
+            .Stmts,
+            0),
