+        "count_upper" |->
+          closureVal(
+            ("s", .ParamNames),
+            Assign(Name("count"), Int(0))
+            Assign(Name("even"), Bool(false))
+            Assign(Name("ch"), Str(""))
+            For(
+              Name("ch"),
