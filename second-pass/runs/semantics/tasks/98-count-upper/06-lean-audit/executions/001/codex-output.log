diff --git a/evidence/00_environment_and_inputs.sh b/evidence/00_environment_and_inputs.sh
new file mode 100644
index 0000000000000000000000000000000000000000..8f9580cb47f29f03ae585c056afe3087f5099f57
--- /dev/null
+++ b/evidence/00_environment_and_inputs.sh
@@ -0,0 +1,8 @@
+#!/usr/bin/env bash
+set -u
+
+pwd
+printenv AUDIT_MODE
+ls -ld /audit-input.json /audit-output/audit-input.json /candidate 2>&1 || true
+find /reference /candidate -maxdepth 3 -type f -printf '%p\n' 2>&1 | sort
+python3 -m json.tool /audit-input.json
diff --git a/evidence/01_frozen_sources_and_trusted_inventory_code.sh b/evidence/01_frozen_sources_and_trusted_inventory_code.sh
new file mode 100644
index 0000000000000000000000000000000000000000..af972c77dbb3f31b166bd36ef4ab49a46bb527d3
--- /dev/null
+++ b/evidence/01_frozen_sources_and_trusted_inventory_code.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+sha256sum \
+  /reference/k-proof/verification.k \
+  /reference/k-proof/spec.k \
+  /reference/k-proof/solution.py \
+  /reference/k-proof/solution.mpy \
+  /reference/k-proof/prompt.py
+nl -ba /reference/k-proof/verification.k
+nl -ba /reference/k-proof/spec.k
+nl -ba /reference/k-proof/solution.py
+nl -ba /reference/k-proof/solution.mpy
+nl -ba /reference/k-proof/prompt.py
+nl -ba /reference/tools/k_rule_inventory.py
diff --git a/evidence/02_reconstruct_inventory.py b/evidence/02_reconstruct_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..76eabc51141d6f2269de16c51cfd7950c5f3f4b9
--- /dev/null
+++ b/evidence/02_reconstruct_inventory.py
@@ -0,0 +1,10 @@
+#!/usr/bin/env python3
+import json
+from pathlib import Path
+
+from tools.k_rule_inventory import inventory_verification
+
+inventory = inventory_verification(Path("/reference/k-proof"))
+output = Path("/audit-output/evidence/reconstructed-inventory.json")
+output.write_text(json.dumps(inventory, indent=2, sort_keys=True) + "\n")
+print(json.dumps(inventory, indent=2, sort_keys=True))
diff --git a/evidence/04_semantics_search_and_proof_driver.sh b/evidence/04_semantics_search_and_proof_driver.sh
new file mode 100644
index 0000000000000000000000000000000000000000..8176fe19d829c1f767ef81cf6434301a2f3ecd70
--- /dev/null
+++ b/evidence/04_semantics_search_and_proof_driver.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+nl -ba /reference/k-proof/prove.sh
+rg -F -n -C 5 \
+  -e 'IntSeq' \
+  -e 'iCons' \
+  -e 'strToCodes' \
+  -e 'strContains' \
+  -e '#loop' \
+  -e 'For(' \
+  -e 'AugAssign' \
+  -e 'BoolOp' \
+  -e 'notBool' \
+  -e 'andBool' \
+  -e 'CmpOp("in"' \
+  -e 'countUpperFrom' \
+  /reference/k-proof/reference-semantics \
+  /reference/k-proof/verification.k \
+  /reference/k-proof/spec.k \
+  /reference/k-proof/solution.mpy
diff --git a/evidence/05_relevant_operational_semantics.sh b/evidence/05_relevant_operational_semantics.sh
new file mode 100644
index 0000000000000000000000000000000000000000..be05e29ac70421f7c0dddba40a633ebece2e0f8e
--- /dev/null
+++ b/evidence/05_relevant_operational_semantics.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+for file in \
+  core.k \
+  str.k \
+  controls.k \
+  iter.k \
+  bool.k \
+  int.k \
+  operators.k
+do
+  nl -ba "/reference/k-proof/reference-semantics/semantics/${file}"
+done
