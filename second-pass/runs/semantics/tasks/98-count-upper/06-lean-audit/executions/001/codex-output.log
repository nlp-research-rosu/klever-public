diff --git a/evidence/07_verify_recorded_hashes_and_bijections.py b/evidence/07_verify_recorded_hashes_and_bijections.py
new file mode 100644
index 0000000000000000000000000000000000000000..71a04f318bbac78812a97e46f463f05ad3a27876
