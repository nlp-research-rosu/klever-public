diff --git a/evidence/proc_self_readlink_shim.c b/evidence/proc_self_readlink_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..fed98ee772ea04cdf7ab8f261991a149ba3c19be
--- /dev/null
+++ b/evidence/proc_self_readlink_shim.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <limits.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    char numeric_self[64];
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    snprintf(
+        numeric_self,
+        sizeof(numeric_self),
+        "/proc/%ld/exe",
+        (long)getpid()
+    );
+    if (strcmp(path, numeric_self) == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}

