+++ b/evidence/04_semantics_search_and_proof_driver.sh
@@ -0,0 +1,21 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+nl -ba /reference/k-proof/prove.sh
+rg -F -n -C 5 \
+  -e 'IntSeq' \
+  -e 'iCons' \
+  -e 'strToCodes' \
+  -e 'strContains' \
+  -e '#loop' \
+  -e 'For(' \
+  -e 'AugAssign' \
+  -e 'BoolOp' \
+  -e 'notBool' \
+  -e 'andBool' \
