diff --git a/evidence/07_verify_recorded_hashes_and_bijections.py b/evidence/07_verify_recorded_hashes_and_bijections.py
new file mode 100644
index 0000000000000000000000000000000000000000..651ca4f1958cf45187d66cdd7db24073b3f931a4
--- /dev/null
+++ b/evidence/07_verify_recorded_hashes_and_bijections.py
@@ -0,0 +1,308 @@
+#!/usr/bin/env python3
+import hashlib
+import json
+import os
+from pathlib import Path
+
+from tools import klean_export, pipeline_contract
+from tools.k_rule_inventory import inventory_verification
+from tools.klean_audit_contract import verify_stage6_audit_input
+
+
+def file_sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(chunk)
+    return digest.hexdigest()
+
+
+def canonical_sha256(value: object) -> str:
+    encoded = json.dumps(
