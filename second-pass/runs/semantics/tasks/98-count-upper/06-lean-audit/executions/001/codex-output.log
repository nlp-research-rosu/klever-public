    99	                state = "code"
   100	            else:
   101	                output[index] = " "
   102	            index += 1
   103	            continue
   104	        if state == "string":
   105	            if character == "\\" and following:
   106	                output[index] = " "
   107	                output[index + 1] = " "
   108	                index += 2
   109	                continue
   110	            if character == '"':
   111	                state = "code"
   112	            elif character not in "\r\n":
   113	                output[index] = " "
   114	            index += 1
   115	            continue
   116	        if state == "block-comment":
   117	            if character == "/" and following == "*":
   118	                output[index] = output[index + 1] = " "
   119	                block_depth += 1
   120	                index += 2
   121	                continue
   122	            if character == "*" and following == "/":
   123	                output[index] = output[index + 1] = " "
   124	                block_depth -= 1
   125	                index += 2
   126	                if block_depth == 0:
   127	                    state = "code"
   128	                continue
   129	            if character not in "\r\n":
   130	                output[index] = " "
   131	            index += 1
   132	            continue
   133	        if character == "/" and following == "/":
   134	            output[index] = output[index + 1] = " "
   135	            state = "line-comment"
   136	            index += 2
   137	            continue
   138	        if character == "/" and following == "*":
   139	            output[index] = output[index + 1] = " "
   140	            state = "block-comment"
   141	            block_depth = 1
   142	            index += 2
   143	            continue
   144	        if character == '"':
   145	            state = "string"
   146	        index += 1
   147	    return "".join(output)
   148	
   149	
   150	def _line_ranges(text: str, start: int = 0) -> list[tuple[int, int, int]]:
   151	    ranges: list[tuple[int, int, int]] = []
   152	    line_start = start
   153	    while line_start < len(text):
   154	        newline = text.find("\n", line_start)
   155	        next_start = len(text) if newline < 0 else newline + 1
   156	        line_end = len(text) if newline < 0 else newline
   157	        content_end = (
   158	            line_end - 1
   159	            if line_end > line_start and text[line_end - 1] == "\r"
   160	            else line_end
   161	        )
   162	        ranges.append((line_start, content_end, next_start))
   163	        if newline < 0:
   164	            break
   165	        line_start = next_start
   166	    return ranges
   167	
   168	
   169	def _line_heads(text: str) -> list[tuple[int, int, str, str]]:
   170	    """Return physical-line word heads without assigning K grammar meaning."""
   171	
   172	    heads: list[tuple[int, int, str, str]] = []
   173	    for line_start, content_end, _next_start in _line_ranges(text):
   174	        index = line_start
   175	        while index < content_end and text[index] in " \t":
   176	            index += 1
   177	        word_end = index
   178	        while word_end < content_end and (
   179	            text[word_end].isalnum() or text[word_end] in "_'"
   180	        ):
   181	            word_end += 1
   182	        if word_end > index:
   183	            heads.append(
   184	                (
   185	                    line_start,
   186	                    content_end,
   187	                    text[index:word_end],
   188	                    text[word_end:content_end],
   189	                )
   190	            )
   191	    return heads
   192	
   193	
   194	def _line_word(line: str) -> tuple[str, str, int]:
   195	    stripped = line.lstrip()
   196	    indent = len(line) - len(stripped)
   197	    word_end = 0
   198	    while word_end < len(stripped) and (
   199	        stripped[word_end].isalnum() or stripped[word_end] in "_'"
   200	    ):
   201	        word_end += 1
   202	    return stripped[:word_end], stripped[word_end:], indent + word_end
   203	
   204	
   205	def _rule_continuation(line: str) -> tuple[str, int] | None:
   206	    stripped = line.lstrip()
   207	    if stripped.startswith("["):
   208	        return "attributes", len(line) - len(stripped)
   209	    word, rest, word_end = _line_word(line)
   210	    for keyword in ("requires", "ensures"):
   211	        if word == keyword and (
   212	            not rest
   213	            or not (
   214	                rest[0].isalnum()
   215	                or rest[0] in "_'"
   216	            )
   217	        ):
   218	            return keyword, word_end
   219	    return None
   220	
   221	
   222	def _starts_outer_transition(line: str) -> bool:
   223	    keyword, rest, _word_end = _line_word(line)
   224	    separated = bool(rest) and rest[0] in " \t"
   225	    if keyword == "module":
   226	        return separated and _MODULE_NAME_RE.fullmatch(rest) is not None
   227	    if keyword == "endmodule":
   228	        return not rest.strip()
   229	    if keyword == "rule":
   230	        return not rest or separated
   231	    return keyword in _OUTER_SENTENCE_KEYWORDS and separated
   232	
   233	
   234	def _terminal_attribute_line(line: str) -> bool:
   235	    match = _TRAILING_ATTRIBUTES_RE.search(line)
   236	    if match is None:
   237	        return False
   238	    start = match.start()
   239	    return start == 0 or line[start - 1].isspace()
   240	
   241	
   242	def _scan_rule_delimiters(
   243	    line: str,
   244	    delimiters: list[str],
   245	) -> None:
   246	    closing = {")": "(", "]": "[", "}": "{"}
   247	    index = 0
   248	    while index < len(line):
   249	        if line[index] == "<":
   250	            cell = _CELL_TAG_RE.match(line, index)
   251	            if cell is not None:
   252	                marker = f"<{cell.group('name')}>"
   253	                if cell.group("close"):
   254	                    if delimiters and delimiters[-1] == marker:
   255	                        delimiters.pop()
   256	                elif not cell.group("self_close"):
   257	                    delimiters.append(marker)
   258	                index = cell.end()
   259	                continue
   260	        character = line[index]
   261	        if character in "([{":
   262	            delimiters.append(character)
   263	        elif character in closing:
   264	            if delimiters and delimiters[-1] == closing[character]:
   265	                delimiters.pop()
   266	        index += 1
   267	
   268	
   269	def _rule_bubble_end(masked_text: str, start: int) -> int:
   270	    """Find when an outer rule bubble returns control to outer parsing."""
   271	
   272	    seen_rewrite = False
   273	    clause_has_content = False
   274	    candidate_end: int | None = None
   275	    delimiters: list[str] = []
   276	    ranges = _line_ranges(masked_text, start)
   277	    for line_start, line_end, next_start in ranges:
   278	        line = masked_text[line_start:line_end]
   279	        if not line.strip():
   280	            continue
   281	
   282	        continuation = (
   283	            _rule_continuation(line)
   284	            if seen_rewrite and candidate_end is not None
   285	            else None
   286	        )
   287	        if candidate_end is not None:
   288	            if continuation is None and _starts_outer_transition(line):
   289	                return candidate_end
   290	            candidate_end = None
   291	
   292	        content_start = 0
   293	        if continuation is not None:
   294	            kind, content_start = continuation
   295	            if kind in {"requires", "ensures"}:
   296	                clause_has_content = False
   297	
   298	        if not seen_rewrite:
   299	            rewrite = line.find("=>")
   300	            if rewrite >= 0:
   301	                seen_rewrite = True
   302	                content_start = rewrite + 2
   303	            else:
   304	                content_start = len(line)
   305	
   306	        _scan_rule_delimiters(line, delimiters)
   307	        if seen_rewrite and line[content_start:].strip():
   308	            clause_has_content = True
   309	
   310	        if (
   311	            seen_rewrite
   312	            and clause_has_content
   313	            and not delimiters
   314	            and _terminal_attribute_line(line)
   315	        ):
   316	            return next_start
   317	        if seen_rewrite and clause_has_content and not delimiters:
   318	            candidate_end = next_start
   319	    if candidate_end is not None:
   320	        return candidate_end
   321	    return len(masked_text) + 1
   322	
   323	
   324	def _modules(masked_text: str) -> tuple[_Module, ...]:
   325	    modules: list[_Module] = []
   326	    open_module: tuple[
   327	        str, int, list[str], list[_Sentence]
   328	    ] | None = None
   329	    open_rule_until = 0
   330	    for line_start, line_end, keyword, rest in _line_heads(masked_text):
   331	        if line_start < open_rule_until:
   332	            continue
   333	        open_rule_until = 0
   334	        separated = bool(rest) and rest[0] in " \t"
   335	        if keyword == "module":
   336	            if not separated:
   337	                raise KRuleInventoryError(
   338	                    "verification.k has malformed module boundaries"
   339	                )
   340	            named = _MODULE_NAME_RE.fullmatch(rest)
   341	            if named is None or open_module is not None:
   342	                raise KRuleInventoryError(
   343	                    "verification.k has malformed module boundaries"
   344	                )
   345	            open_module = (named.group("name"), line_end, [], [])
   346	            continue
   347	        if keyword == "endmodule":
   348	            if rest.strip():
   349	                raise KRuleInventoryError(
   350	                    "verification.k has malformed module boundaries"
   351	                )
   352	            if open_module is None:
   353	                raise KRuleInventoryError(
   354	                    "verification.k has malformed module boundaries"
   355	                )
   356	            name, content_start, imports, sentences = open_module
   357	            modules.append(
   358	                _Module(
   359	                    name=name,
   360	                    content_start=content_start,
   361	                    content_end=line_start,
   362	                    imports=tuple(imports),
   363	                    sentences=tuple(sentences),
   364	                )
   365	            )
   366	            open_module = None
   367	            continue
   368	        if open_module is not None and keyword == "rule":
   369	            open_module[3].append(
   370	                _Sentence(keyword=keyword, start=line_start)
   371	            )
   372	            open_rule_until = _rule_bubble_end(masked_text, line_start)
   373	            continue
   374	        if open_module is not None and keyword == "imports" and separated:
   375	            imported = rest.strip().split()
   376	            if len(imported) != 1:
   377	                raise KRuleInventoryError(
   378	                    "verification.k has malformed imports"
   379	                )
   380	            open_module[2].append(imported[0])
   381	        if (
   382	            open_module is not None
   383	            and keyword in _OUTER_SENTENCE_KEYWORDS
   384	            and separated
   385	        ):
   386	            open_module[3].append(
   387	                _Sentence(keyword=keyword, start=line_start)
   388	            )
   389	    if not modules or open_module is not None:
   390	        raise KRuleInventoryError(
   391	            "verification.k has malformed module boundaries"
   392	        )
   393	    return tuple(modules)
   394	
   395	
   396	def _verification_module(
   397	    modules: tuple[_Module, ...], selected_name: str | None = None
   398	) -> _Module:
   399	    if selected_name is not None:
   400	        selected = [module for module in modules if module.name == selected_name]
   401	        if len(selected) != 1:
   402	            raise KRuleInventoryError(
   403	                "prove.sh selects an unknown verification main module: "
   404	                + selected_name
   405	            )
   406	        return selected[0]
   407	    candidates = [
   408	        module
   409	        for module in modules
   410	        if module.name.endswith("VERIFICATION")
   411	        and not module.name.endswith("-SYNTAX")
   412	    ]
   413	    if len(candidates) != 1:
   414	        raise KRuleInventoryError(
   415	            "verification.k must contain exactly one verification module"
   416	        )
   417	    return candidates[0]
   418	
   419	
   420	def _last_verification_main_module(workspace: Path) -> str | None:
   421	    script = workspace / "prove.sh"
   422	    if not script.exists() and not script.is_symlink():
   423	        return None
   424	    try:
   425	        mode = script.stat(follow_symlinks=False).st_mode
   426	    except OSError as error:
   427	        raise KRuleInventoryError(f"cannot inspect prove.sh: {script}") from error
   428	    if not stat.S_ISREG(mode):
   429	        raise KRuleInventoryError(f"prove.sh must be a regular file: {script}")
   430	    try:
   431	        text = script.read_text()
   432	    except (OSError, UnicodeError) as error:
   433	        raise KRuleInventoryError(f"cannot read prove.sh: {script}") from error
   434	    logical = re.sub(r"\\\r?\n", " ", text)
   435	    selected: str | None = None
   436	    for line in logical.splitlines():
   437	        code = line.split("#", 1)[0]
   438	        if not re.search(r"(?:^|[;&|]\s*)kompile\s+", code):
   439	            continue
   440	        if re.search(r"(?:^|\s)(?:\./)?verification\.k(?:\s|$)", code) is None:
   441	            continue
   442	        match = re.search(
   443	            r"(?:^|\s)--main-module(?:=|\s+)([A-Za-z][A-Za-z0-9_'-]*)",
   444	            code,
   445	        )
   446	        if match is not None:
   447	            selected = match.group(1)
   448	    return selected
   449	
   450	
   451	def _verification_closure(
   452	    modules: tuple[_Module, ...], verification: _Module
   453	) -> tuple[_Module, ...]:
   454	    by_name = {module.name: module for module in modules}
   455	    reached: set[str] = set()
   456	    pending = [verification.name]
   457	    while pending:
   458	        name = pending.pop()
   459	        if name in reached:
   460	            continue
   461	        reached.add(name)
   462	        module = by_name.get(name)
   463	        if module is not None:
   464	            pending.extend(module.imports)
   465	    return tuple(module for module in modules if module.name in reached)
   466	
   467	
   468	def _without_comments(text: str) -> str:
   469	    """Remove K comments while preserving strings and their exact contents."""
   470	
   471	    output: list[str] = []
   472	    index = 0
   473	    block_depth = 0
   474	    state = "code"
   475	    while index < len(text):
   476	        character = text[index]
   477	        following = text[index + 1] if index + 1 < len(text) else ""
   478	        if state == "line-comment":
   479	            if character in "\r\n":
   480	                output.append(character)
   481	                state = "code"
   482	            index += 1
   483	            continue
   484	        if state == "string":
   485	            output.append(character)
   486	            if character == "\\" and following:
   487	                output.append(following)
   488	                index += 2
   489	                continue
   490	            if character == '"':
   491	                state = "code"
   492	            index += 1
   493	            continue
   494	        if state == "block-comment":
   495	            if character == "/" and following == "*":
   496	                block_depth += 1
   497	                index += 2
   498	                continue
   499	            if character == "*" and following == "/":
   500	                block_depth -= 1
   501	                index += 2
   502	                if block_depth == 0:
   503	                    state = "code"
   504	                continue
   505	            if character in "\r\n":
   506	                output.append(character)
   507	            index += 1
   508	            continue
   509	        if character == "/" and following == "/":
   510	            output.append(" ")
   511	            state = "line-comment"
   512	            index += 2
   513	            continue
   514	        if character == "/" and following == "*":
   515	            output.append(" ")
   516	            state = "block-comment"
   517	            block_depth = 1
   518	            index += 2
   519	            continue
   520	        output.append(character)
   521	        if character == '"':
   522	            state = "string"
   523	        index += 1
   524	    return "".join(output)
   525	
   526	
   527	def _attribute_tokens(text: str, masked_text: str) -> list[str]:
   528	    tokens: list[str] = []
   529	    start = 0
   530	    depth = 0
   531	    for index, character in enumerate(masked_text):
   532	        if character in "([{":
   533	            depth += 1
   534	        elif character in ")]}":
   535	            depth = max(depth - 1, 0)
   536	        elif character == "," and depth == 0:
   537	            token = _without_comments(text[start:index]).strip()
   538	            if token:
   539	                tokens.append(token)
   540	            start = index + 1
   541	    final = _without_comments(text[start:]).strip()
   542	    if final:
   543	        tokens.append(final)
   544	    return tokens
   545	
   546	
   547	def _rule_spans(text: str, module: _Module) -> list[_RuleSpan]:
   548	    masked_text = _mask_non_code(text)
   549	    sentences = module.sentences
   550	    rules: list[_RuleSpan] = []
   551	    seen_hashes: set[str] = set()
   552	    for index, sentence in enumerate(sentences):
   553	        if sentence.keyword != "rule":
   554	            continue
   555	        end_offset = (
   556	            sentences[index + 1].start
   557	            if index + 1 < len(sentences)
   558	            else module.content_end
   559	        )
   560	        start_offset = sentence.start
   561	        raw_segment = text[start_offset:end_offset]
   562	        masked_segment = masked_text[start_offset:end_offset]
   563	        logical_length = len(masked_segment.rstrip(" \t\r\n"))
   564	        if logical_length == 0:
   565	            continue
   566	        rule_text = raw_segment[:logical_length].rstrip(" \t\r\n")
   567	        masked_rule = _mask_non_code(rule_text)
   568	        attribute_match = _TRAILING_ATTRIBUTES_RE.search(masked_rule)
   569	        attribute_start = None
   570	        attribute_end = None
   571	        attributes: list[str] = []
   572	        if attribute_match is not None:
   573	            attribute_start = attribute_match.start("attributes")
   574	            attribute_end = attribute_match.end("attributes")
   575	            attributes = _attribute_tokens(
   576	                rule_text[attribute_start:attribute_end],
   577	                masked_rule[attribute_start:attribute_end],
   578	            )
   579	        normalized = " ".join(rule_text.split())
   580	        digest = hashlib.sha256(normalized.encode()).hexdigest()
   581	        if digest in seen_hashes:
   582	            raise KRuleInventoryError(
   583	                f"duplicate normalized simplification rule hash: {digest}"
   584	            )
   585	        seen_hashes.add(digest)
   586	        start_line = text.count("\n", 0, start_offset) + 1
   587	        end_line = start_line + rule_text.count("\n")
   588	        rule = KRule(
   589	            source_rule_id=f"rule-{digest}",
   590	            module=module.name,
   591	            start_line=start_line,
   592	            end_line=end_line,
   593	            normalized_sha256=digest,
   594	            attributes=attributes,
   595	            text=rule_text,
   596	        )
   597	        rules.append(
   598	            _RuleSpan(
   599	                rule=rule,
   600	                start_offset=start_offset,
   601	                end_offset=start_offset + len(rule_text),
   602	                attribute_start=(
   603	                    None
   604	                    if attribute_match is None
   605	                    else start_offset + attribute_match.start()
   606	                ),
   607	                attribute_end=(
   608	                    None
   609	                    if attribute_match is None
   610	                    else start_offset + attribute_match.end()
   611	                ),
   612	            )
   613	        )
   614	    return rules
   615	
   616	
   617	def _rule_documents(
   618	    text: str, modules: tuple[_Module, ...]
   619	) -> list[dict[str, Any]]:
   620	    spans = [span for module in modules for span in _rule_spans(text, module)]
   621	    spans.sort(key=lambda span: span.start_offset)
   622	    return [dataclasses.asdict(span.rule) for span in spans]
   623	
   624	
   625	def _attribute_token_spans(
   626	    text: str,
   627	    masked_text: str,
   628	) -> list[tuple[int, int, str]]:
   629	    spans: list[tuple[int, int, str]] = []
   630	    start = 0
   631	    depth = 0
   632	    for index, character in enumerate(masked_text):
   633	        if character in "([{":
   634	            depth += 1
   635	        elif character in ")]}":
   636	            depth = max(depth - 1, 0)
   637	        elif character == "," and depth == 0:
   638	            spans.append(
   639	                (
   640	                    start,
   641	                    index,
   642	                    _without_comments(text[start:index]).strip(),
   643	                )
   644	            )
   645	            start = index + 1
   646	    spans.append(
   647	        (
   648	            start,
   649	            len(text),
   650	            _without_comments(text[start:]).strip(),
   651	        )
   652	    )
   653	    return spans
   654	
   655	
   656	def _blank_non_newlines(text: str) -> str:
   657	    return "".join(
   658	        character if character in "\r\n" else " "
   659	        for character in text
   660	    )
   661	
   662	
   663	def desimplify_rule_ids(
   664	    text: str,
   665	    source_rule_ids: list[str],
   666	) -> str:
   667	    """Remove simplification from exactly the selected canonical rule IDs."""
   668	
   669	    if len(source_rule_ids) != len(set(source_rule_ids)):
   670	        raise KRuleInventoryError(
   671	            "exact rule transformation contains a duplicate source rule ID"
   672	        )
   673	    selected = set(source_rule_ids)
   674	    modules = _modules(_mask_non_code(text))
   675	    spans = [
   676	        span
   677	        for local_module in modules
   678	        for span in _rule_spans(text, local_module)
   679	    ]
   680	    by_id = {span.rule.source_rule_id: span for span in spans}
   681	    unknown = sorted(selected - set(by_id))
   682	    if unknown:
   683	        raise KRuleInventoryError(
   684	            "exact rule transformation names an unknown source rule ID: "
   685	            + ", ".join(unknown)
   686	        )
   687	
   688	    edits: list[tuple[int, int]] = []
   689	    for source_rule_id in source_rule_ids:
   690	        span = by_id[source_rule_id]
   691	        if span.attribute_start is None or span.attribute_end is None:
   692	            raise KRuleInventoryError(
   693	                "selected source rule has no simplification attribute: "
   694	                f"{source_rule_id}"
   695	            )
   696	        attribute_text = text[
   697	            span.attribute_start + 1 : span.attribute_end - 1
   698	        ]
   699	        masked_attributes = _mask_non_code(attribute_text)
   700	        tokens = _attribute_token_spans(
   701	            attribute_text,
   702	            masked_attributes,
   703	        )
   704	        matches = [
   705	            index
   706	            for index, (_start, _end, token) in enumerate(tokens)
   707	            if token == "simplification"
   708	        ]
   709	        if len(matches) != 1:
   710	            raise KRuleInventoryError(
   711	                "selected source rule has ambiguous simplification "
   712	                f"attributes: {source_rule_id}"
   713	            )
   714	        token_index = matches[0]
   715	        if len(tokens) == 1:
   716	            edit_start = span.attribute_start
   717	            edit_end = span.attribute_end
   718	        elif token_index < len(tokens) - 1:
   719	            edit_start = (
   720	                span.attribute_start + 1 + tokens[token_index][0]
   721	            )
   722	            edit_end = (
   723	                span.attribute_start + 1 + tokens[token_index + 1][0]
   724	            )
   725	        else:
   726	            edit_start = (
   727	                span.attribute_start + 1 + tokens[token_index - 1][1]
   728	            )
   729	            edit_end = (
   730	                span.attribute_start + 1 + tokens[token_index][1]
   731	            )
   732	        edits.append((edit_start, edit_end))
   733	
   734	    transformed = text
   735	    for start, end in sorted(edits, reverse=True):
   736	        transformed = (
   737	            transformed[:start]
   738	            + _blank_non_newlines(transformed[start:end])
   739	            + transformed[end:]
   740	        )
   741	    return transformed
   742	
   743	
   744	def inventory_verification(workspace: Path) -> dict[str, Any]:
   745	    workspace = Path(workspace)
   746	    try:
   747	        workspace_mode = workspace.stat(follow_symlinks=False).st_mode
   748	    except OSError as error:
   749	        raise KRuleInventoryError(
   750	            f"workspace must be a real directory: {workspace}"
   751	        ) from error
   752	    if not stat.S_ISDIR(workspace_mode):
   753	        raise KRuleInventoryError(
   754	            f"workspace must be a real directory: {workspace}"
   755	        )
   756	    verification = workspace / "verification.k"
   757	    try:
   758	        verification_mode = verification.stat(
   759	            follow_symlinks=False
   760	        ).st_mode
   761	    except OSError as error:
   762	        raise KRuleInventoryError(
   763	            f"workspace has no regular verification.k: {verification}"
   764	        ) from error
   765	    if not stat.S_ISREG(verification_mode):
   766	        raise KRuleInventoryError(
   767	            f"workspace has no regular verification.k: {verification}"
   768	        )
   769	    try:
   770	        verification_bytes = verification.read_bytes()
   771	        text = verification_bytes.decode()
   772	    except (OSError, UnicodeError) as error:
   773	        raise KRuleInventoryError(
   774	            f"cannot read verification.k: {verification}"
   775	        ) from error
   776	    masked_text = _mask_non_code(text)
   777	    modules = _modules(masked_text)
   778	    module = _verification_module(
   779	        modules, _last_verification_main_module(workspace)
   780	    )
   781	    closure = _verification_closure(modules, module)
   782	    rule_documents = _rule_documents(text, closure)
   783	    return {
   784	        "schema_version": 2,
   785	        "verification_file": "verification.k",
   786	        "verification_sha256": hashlib.sha256(verification_bytes).hexdigest(),
   787	        "verification_module": module.name,
   788	        "verification_modules": [module.name for module in closure],
   789	        "rules": rule_documents,
   790	        "inventory_sha256": canonical_json_sha256(rule_documents),
   791	    }

