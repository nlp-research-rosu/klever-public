   468	def _without_comments(text: str) -> str:
   469	    """Remove K comments while preserving strings and their exact contents."""
   470	
   471	    output: list[str] = []
   472	    index = 0
   473	    block_depth = 0
   474	    state = "code"
   475	    while index < len(text):
   476	        character = text[index]
   477	        following = text[index + 1] if index + 1 < len(text) else ""
   478	        if state == "line-comment":
   479	            if character in "\r\n":
   480	                output.append(character)
   481	                state = "code"
   482	            index += 1
   483	            continue
   484	        if state == "string":
   485	            output.append(character)
   486	            if character == "\\" and following:
   487	                output.append(following)
   488	                index += 2
   489	                continue
   490	            if character == '"':
   491	                state = "code"
   492	            index += 1
   493	            continue
   494	        if state == "block-comment":
   495	            if character == "/" and following == "*":
   496	                block_depth += 1
   497	                index += 2
   498	                continue
   499	            if character == "*" and following == "/":
   500	                block_depth -= 1
   501	                index += 2
   502	                if block_depth == 0:
   503	                    state = "code"
   504	                continue
   505	            if character in "\r\n":
   506	                output.append(character)
   507	            index += 1
   508	            continue
   509	        if character == "/" and following == "/":
   510	            output.append(" ")
   511	            state = "line-comment"
   512	            index += 2
   513	            continue
   514	        if character == "/" and following == "*":
   515	            output.append(" ")
   516	            state = "block-comment"
   517	            block_depth = 1
   518	            index += 2
   519	            continue
   520	        output.append(character)
   521	        if character == '"':
   522	            state = "string"
   523	        index += 1
   524	    return "".join(output)
   525	
   526	
   527	def _attribute_tokens(text: str, masked_text: str) -> list[str]:
   528	    tokens: list[str] = []
   529	    start = 0
   530	    depth = 0
   531	    for index, character in enumerate(masked_text):
   532	        if character in "([{":
   533	            depth += 1
   534	        elif character in ")]}":
   535	            depth = max(depth - 1, 0)
   536	        elif character == "," and depth == 0:
   537	            token = _without_comments(text[start:index]).strip()
   538	            if token:
   539	                tokens.append(token)
   540	            start = index + 1
   541	    final = _without_comments(text[start:]).strip()
   542	    if final:
   543	        tokens.append(final)
   544	    return tokens
   545	
   546	
   547	def _rule_spans(text: str, module: _Module) -> list[_RuleSpan]:
   548	    masked_text = _mask_non_code(text)
   549	    sentences = module.sentences
   550	    rules: list[_RuleSpan] = []
   551	    seen_hashes: set[str] = set()
   552	    for index, sentence in enumerate(sentences):
   553	        if sentence.keyword != "rule":
   554	            continue
   555	        end_offset = (
   556	            sentences[index + 1].start
   557	            if index + 1 < len(sentences)
   558	            else module.content_end
   559	        )
   560	        start_offset = sentence.start
   561	        raw_segment = text[start_offset:end_offset]
   562	        masked_segment = masked_text[start_offset:end_offset]
   563	        logical_length = len(masked_segment.rstrip(" \t\r\n"))
   564	        if logical_length == 0:
   565	            continue
   566	        rule_text = raw_segment[:logical_length].rstrip(" \t\r\n")
   567	        masked_rule = _mask_non_code(rule_text)
   568	        attribute_match = _TRAILING_ATTRIBUTES_RE.search(masked_rule)
   569	        attribute_start = None
   570	        attribute_end = None
   571	        attributes: list[str] = []
   572	        if attribute_match is not None:
   573	            attribute_start = attribute_match.start("attributes")
   574	            attribute_end = attribute_match.end("attributes")
   575	            attributes = _attribute_tokens(
   576	                rule_text[attribute_start:attribute_end],
   577	                masked_rule[attribute_start:attribute_end],
   578	            )
   579	        normalized = " ".join(rule_text.split())
   580	        digest = hashlib.sha256(normalized.encode()).hexdigest()
   581	        if digest in seen_hashes:
   582	            raise KRuleInventoryError(
   583	                f"duplicate normalized simplification rule hash: {digest}"
   584	            )
   585	        seen_hashes.add(digest)
   586	        start_line = text.count("\n", 0, start_offset) + 1
   587	        end_line = start_line + rule_text.count("\n")
   588	        rule = KRule(
   589	            source_rule_id=f"rule-{digest}",
   590	            module=module.name,
   591	            start_line=start_line,
   592	            end_line=end_line,
   593	            normalized_sha256=digest,
   594	            attributes=attributes,
   595	            text=rule_text,
   596	        )
   597	        rules.append(
   598	            _RuleSpan(
   599	                rule=rule,
   600	                start_offset=start_offset,
   601	                end_offset=start_offset + len(rule_text),
   602	                attribute_start=(
   603	                    None
   604	                    if attribute_match is None
   605	                    else start_offset + attribute_match.start()
   606	                ),
   607	                attribute_end=(
   608	                    None
   609	                    if attribute_match is None
   610	                    else start_offset + attribute_match.end()
   611	                ),
   612	            )
   613	        )
   614	    return rules
   615	
   616	
   617	def _rule_documents(
   618	    text: str, modules: tuple[_Module, ...]
   619	) -> list[dict[str, Any]]:
   620	    spans = [span for module in modules for span in _rule_spans(text, module)]
   621	    spans.sort(key=lambda span: span.start_offset)
   622	    return [dataclasses.asdict(span.rule) for span in spans]
   623	
   624	
   625	def _attribute_token_spans(
   626	    text: str,
   627	    masked_text: str,
   628	) -> list[tuple[int, int, str]]:
   629	    spans: list[tuple[int, int, str]] = []
   630	    start = 0
   631	    depth = 0
   632	    for index, character in enumerate(masked_text):
   633	        if character in "([{":
   634	            depth += 1
   635	        elif character in ")]}":
   636	            depth = max(depth - 1, 0)
   637	        elif character == "," and depth == 0:
   638	            spans.append(
   639	                (
   640	                    start,
   641	                    index,
   642	                    _without_comments(text[start:index]).strip(),
   643	                )
   644	            )
   645	            start = index + 1
   646	    spans.append(
   647	        (
   648	            start,
   649	            len(text),
   650	            _without_comments(text[start:]).strip(),
   651	        )
   652	    )
   653	    return spans
   654	
   655	
   656	def _blank_non_newlines(text: str) -> str:
   657	    return "".join(
   658	        character if character in "\r\n" else " "
   659	        for character in text
   660	    )
   661	
