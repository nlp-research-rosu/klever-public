     2	def count_upper(s):
     3	    """
     4	    Given a string s, count the number of uppercase vowels in even indices.
     5	    
     6	    For example:
     7	    count_upper('aBCdEf') returns 1
     8	    count_upper('abcdefg') returns 0
     9	    count_upper('dBBE') returns 0
    10	    """
