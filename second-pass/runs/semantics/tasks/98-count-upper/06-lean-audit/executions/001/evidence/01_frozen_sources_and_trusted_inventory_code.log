    77	def canonical_json_sha256(document: Any) -> str:
    78	    encoded = json.dumps(
    79	        document,
    80	        sort_keys=True,
    81	        separators=(",", ":"),
    82	        ensure_ascii=False,
    83	    ).encode()
    84	    return hashlib.sha256(encoded).hexdigest()
