    87	def _mask_non_code(text: str) -> str:
    88	    """Mask comments and string bodies without changing source offsets."""
    89	
    90	    output = list(text)
    91	    index = 0
    92	    block_depth = 0
    93	    state = "code"
    94	    while index < len(text):
    95	        character = text[index]
    96	        following = text[index + 1] if index + 1 < len(text) else ""
    97	        if state == "line-comment":
    98	            if character in "\r\n":
    99	                state = "code"
   100	            else:
   101	                output[index] = " "
   102	            index += 1
   103	            continue
   104	        if state == "string":
   105	            if character == "\\" and following:
   106	                output[index] = " "
   107	                output[index + 1] = " "
   108	                index += 2
   109	                continue
   110	            if character == '"':
   111	                state = "code"
   112	            elif character not in "\r\n":
   113	                output[index] = " "
   114	            index += 1
   115	            continue
   116	        if state == "block-comment":
   117	            if character == "/" and following == "*":
   118	                output[index] = output[index + 1] = " "
   119	                block_depth += 1
   120	                index += 2
   121	                continue
   122	            if character == "*" and following == "/":
   123	                output[index] = output[index + 1] = " "
   124	                block_depth -= 1
   125	                index += 2
   126	                if block_depth == 0:
   127	                    state = "code"
   128	                continue
   129	            if character not in "\r\n":
   130	                output[index] = " "
   131	            index += 1
   132	            continue
   133	        if character == "/" and following == "/":
   134	            output[index] = output[index + 1] = " "
   135	            state = "line-comment"
   136	            index += 2
   137	            continue
   138	        if character == "/" and following == "*":
   139	            output[index] = output[index + 1] = " "
   140	            state = "block-comment"
   141	            block_depth = 1
   142	            index += 2
   143	            continue
   144	        if character == '"':
   145	            state = "string"
   146	        index += 1
   147	    return "".join(output)
