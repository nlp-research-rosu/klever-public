   150	def _line_ranges(text: str, start: int = 0) -> list[tuple[int, int, int]]:
   151	    ranges: list[tuple[int, int, int]] = []
   152	    line_start = start
   153	    while line_start < len(text):
   154	        newline = text.find("\n", line_start)
   155	        next_start = len(text) if newline < 0 else newline + 1
   156	        line_end = len(text) if newline < 0 else newline
   157	        content_end = (
   158	            line_end - 1
   159	            if line_end > line_start and text[line_end - 1] == "\r"
   160	            else line_end
   161	        )
   162	        ranges.append((line_start, content_end, next_start))
   163	        if newline < 0:
   164	            break
   165	        line_start = next_start
   166	    return ranges
   167	
   168	
   169	def _line_heads(text: str) -> list[tuple[int, int, str, str]]:
   170	    """Return physical-line word heads without assigning K grammar meaning."""
   171	
   172	    heads: list[tuple[int, int, str, str]] = []
   173	    for line_start, content_end, _next_start in _line_ranges(text):
   174	        index = line_start
   175	        while index < content_end and text[index] in " \t":
   176	            index += 1
   177	        word_end = index
   178	        while word_end < content_end and (
   179	            text[word_end].isalnum() or text[word_end] in "_'"
   180	        ):
   181	            word_end += 1
   182	        if word_end > index:
   183	            heads.append(
   184	                (
   185	                    line_start,
   186	                    content_end,
   187	                    text[index:word_end],
   188	                    text[word_end:content_end],
   189	                )
   190	            )
   191	    return heads
   192	
   193	
   194	def _line_word(line: str) -> tuple[str, str, int]:
   195	    stripped = line.lstrip()
   196	    indent = len(line) - len(stripped)
   197	    word_end = 0
   198	    while word_end < len(stripped) and (
   199	        stripped[word_end].isalnum() or stripped[word_end] in "_'"
   200	    ):
   201	        word_end += 1
   202	    return stripped[:word_end], stripped[word_end:], indent + word_end
   203	
   204	
   205	def _rule_continuation(line: str) -> tuple[str, int] | None:
   206	    stripped = line.lstrip()
   207	    if stripped.startswith("["):
   208	        return "attributes", len(line) - len(stripped)
   209	    word, rest, word_end = _line_word(line)
   210	    for keyword in ("requires", "ensures"):
   211	        if word == keyword and (
   212	            not rest
   213	            or not (
   214	                rest[0].isalnum()
   215	                or rest[0] in "_'"
   216	            )
   217	        ):
   218	            return keyword, word_end
   219	    return None
   220	
   221	
   222	def _starts_outer_transition(line: str) -> bool:
   223	    keyword, rest, _word_end = _line_word(line)
   224	    separated = bool(rest) and rest[0] in " \t"
   225	    if keyword == "module":
   226	        return separated and _MODULE_NAME_RE.fullmatch(rest) is not None
   227	    if keyword == "endmodule":
   228	        return not rest.strip()
   229	    if keyword == "rule":
   230	        return not rest or separated
   231	    return keyword in _OUTER_SENTENCE_KEYWORDS and separated
   232	
   233	
   234	def _terminal_attribute_line(line: str) -> bool:
   235	    match = _TRAILING_ATTRIBUTES_RE.search(line)
   236	    if match is None:
   237	        return False
   238	    start = match.start()
   239	    return start == 0 or line[start - 1].isspace()
   240	
   241	
   242	def _scan_rule_delimiters(
   243	    line: str,
   244	    delimiters: list[str],
   245	) -> None:
   246	    closing = {")": "(", "]": "[", "}": "{"}
   247	    index = 0
   248	    while index < len(line):
   249	        if line[index] == "<":
   250	            cell = _CELL_TAG_RE.match(line, index)
   251	            if cell is not None:
   252	                marker = f"<{cell.group('name')}>"
   253	                if cell.group("close"):
   254	                    if delimiters and delimiters[-1] == marker:
   255	                        delimiters.pop()
   256	                elif not cell.group("self_close"):
   257	                    delimiters.append(marker)
   258	                index = cell.end()
   259	                continue
   260	        character = line[index]
   261	        if character in "([{":
   262	            delimiters.append(character)
   263	        elif character in closing:
   264	            if delimiters and delimiters[-1] == closing[character]:
   265	                delimiters.pop()
   266	        index += 1
   267	
   268	
   269	def _rule_bubble_end(masked_text: str, start: int) -> int:
   270	    """Find when an outer rule bubble returns control to outer parsing."""
   271	
   272	    seen_rewrite = False
   273	    clause_has_content = False
   274	    candidate_end: int | None = None
   275	    delimiters: list[str] = []
   276	    ranges = _line_ranges(masked_text, start)
   277	    for line_start, line_end, next_start in ranges:
   278	        line = masked_text[line_start:line_end]
   279	        if not line.strip():
   280	            continue
   281	
   282	        continuation = (
   283	            _rule_continuation(line)
   284	            if seen_rewrite and candidate_end is not None
   285	            else None
   286	        )
   287	        if candidate_end is not None:
   288	            if continuation is None and _starts_outer_transition(line):
   289	                return candidate_end
   290	            candidate_end = None
   291	
   292	        content_start = 0
   293	        if continuation is not None:
   294	            kind, content_start = continuation
   295	            if kind in {"requires", "ensures"}:
   296	                clause_has_content = False
   297	
   298	        if not seen_rewrite:
   299	            rewrite = line.find("=>")
   300	            if rewrite >= 0:
   301	                seen_rewrite = True
   302	                content_start = rewrite + 2
   303	            else:
   304	                content_start = len(line)
   305	
   306	        _scan_rule_delimiters(line, delimiters)
   307	        if seen_rewrite and line[content_start:].strip():
   308	            clause_has_content = True
   309	
   310	        if (
   311	            seen_rewrite
   312	            and clause_has_content
   313	            and not delimiters
   314	            and _terminal_attribute_line(line)
   315	        ):
   316	            return next_start
   317	        if seen_rewrite and clause_has_content and not delimiters:
   318	            candidate_end = next_start
   319	    if candidate_end is not None:
   320	        return candidate_end
   321	    return len(masked_text) + 1
   322	
   323	
   324	def _modules(masked_text: str) -> tuple[_Module, ...]:
   325	    modules: list[_Module] = []
   326	    open_module: tuple[
   327	        str, int, list[str], list[_Sentence]
   328	    ] | None = None
   329	    open_rule_until = 0
   330	    for line_start, line_end, keyword, rest in _line_heads(masked_text):
   331	        if line_start < open_rule_until:
   332	            continue
   333	        open_rule_until = 0
   334	        separated = bool(rest) and rest[0] in " \t"
   335	        if keyword == "module":
   336	            if not separated:
   337	                raise KRuleInventoryError(
   338	                    "verification.k has malformed module boundaries"
   339	                )
   340	            named = _MODULE_NAME_RE.fullmatch(rest)
   341	            if named is None or open_module is not None:
   342	                raise KRuleInventoryError(
   343	                    "verification.k has malformed module boundaries"
   344	                )
   345	            open_module = (named.group("name"), line_end, [], [])
   346	            continue
   347	        if keyword == "endmodule":
   348	            if rest.strip():
   349	                raise KRuleInventoryError(
   350	                    "verification.k has malformed module boundaries"
   351	                )
   352	            if open_module is None:
   353	                raise KRuleInventoryError(
   354	                    "verification.k has malformed module boundaries"
   355	                )
   356	            name, content_start, imports, sentences = open_module
   357	            modules.append(
   358	                _Module(
   359	                    name=name,
   360	                    content_start=content_start,
   361	                    content_end=line_start,
   362	                    imports=tuple(imports),
   363	                    sentences=tuple(sentences),
   364	                )
   365	            )
   366	            open_module = None
   367	            continue
   368	        if open_module is not None and keyword == "rule":
   369	            open_module[3].append(
   370	                _Sentence(keyword=keyword, start=line_start)
   371	            )
   372	            open_rule_until = _rule_bubble_end(masked_text, line_start)
   373	            continue
   374	        if open_module is not None and keyword == "imports" and separated:
   375	            imported = rest.strip().split()
   376	            if len(imported) != 1:
   377	                raise KRuleInventoryError(
   378	                    "verification.k has malformed imports"
   379	                )
   380	            open_module[2].append(imported[0])
   381	        if (
   382	            open_module is not None
   383	            and keyword in _OUTER_SENTENCE_KEYWORDS
   384	            and separated
   385	        ):
   386	            open_module[3].append(
   387	                _Sentence(keyword=keyword, start=line_start)
   388	            )
   389	    if not modules or open_module is not None:
   390	        raise KRuleInventoryError(
   391	            "verification.k has malformed module boundaries"
   392	        )
   393	    return tuple(modules)
   394	
