   451	def _verification_closure(
   452	    modules: tuple[_Module, ...], verification: _Module
   453	) -> tuple[_Module, ...]:
   454	    by_name = {module.name: module for module in modules}
   455	    reached: set[str] = set()
   456	    pending = [verification.name]
   457	    while pending:
   458	        name = pending.pop()
   459	        if name in reached:
   460	            continue
   461	        reached.add(name)
   462	        module = by_name.get(name)
   463	        if module is not None:
   464	            pending.extend(module.imports)
   465	    return tuple(module for module in modules if module.name in reached)
   466	
