   420	def _last_verification_main_module(workspace: Path) -> str | None:
   421	    script = workspace / "prove.sh"
   422	    if not script.exists() and not script.is_symlink():
   423	        return None
   424	    try:
   425	        mode = script.stat(follow_symlinks=False).st_mode
   426	    except OSError as error:
   427	        raise KRuleInventoryError(f"cannot inspect prove.sh: {script}") from error
   428	    if not stat.S_ISREG(mode):
   429	        raise KRuleInventoryError(f"prove.sh must be a regular file: {script}")
   430	    try:
   431	        text = script.read_text()
   432	    except (OSError, UnicodeError) as error:
   433	        raise KRuleInventoryError(f"cannot read prove.sh: {script}") from error
   434	    logical = re.sub(r"\\\r?\n", " ", text)
   435	    selected: str | None = None
   436	    for line in logical.splitlines():
   437	        code = line.split("#", 1)[0]
   438	        if not re.search(r"(?:^|[;&|]\s*)kompile\s+", code):
   439	            continue
   440	        if re.search(r"(?:^|\s)(?:\./)?verification\.k(?:\s|$)", code) is None:
   441	            continue
   442	        match = re.search(
   443	            r"(?:^|\s)--main-module(?:=|\s+)([A-Za-z][A-Za-z0-9_'-]*)",
   444	            code,
   445	        )
   446	        if match is not None:
   447	            selected = match.group(1)
   448	    return selected
