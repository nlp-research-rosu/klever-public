   396	def _verification_module(
   397	    modules: tuple[_Module, ...], selected_name: str | None = None
   398	) -> _Module:
   399	    if selected_name is not None:
   400	        selected = [module for module in modules if module.name == selected_name]
   401	        if len(selected) != 1:
   402	            raise KRuleInventoryError(
   403	                "prove.sh selects an unknown verification main module: "
   404	                + selected_name
   405	            )
   406	        return selected[0]
   407	    candidates = [
   408	        module
   409	        for module in modules
   410	        if module.name.endswith("VERIFICATION")
   411	        and not module.name.endswith("-SYNTAX")
   412	    ]
   413	    if len(candidates) != 1:
   414	        raise KRuleInventoryError(
   415	            "verification.k must contain exactly one verification module"
   416	        )
   417	    return candidates[0]
