   744	def inventory_verification(workspace: Path) -> dict[str, Any]:
   745	    workspace = Path(workspace)
   746	    try:
   747	        workspace_mode = workspace.stat(follow_symlinks=False).st_mode
   748	    except OSError as error:
   749	        raise KRuleInventoryError(
   750	            f"workspace must be a real directory: {workspace}"
   751	        ) from error
   752	    if not stat.S_ISDIR(workspace_mode):
   753	        raise KRuleInventoryError(
   754	            f"workspace must be a real directory: {workspace}"
   755	        )
   756	    verification = workspace / "verification.k"
   757	    try:
   758	        verification_mode = verification.stat(
   759	            follow_symlinks=False
   760	        ).st_mode
   761	    except OSError as error:
   762	        raise KRuleInventoryError(
   763	            f"workspace has no regular verification.k: {verification}"
   764	        ) from error
   765	    if not stat.S_ISREG(verification_mode):
   766	        raise KRuleInventoryError(
   767	            f"workspace has no regular verification.k: {verification}"
   768	        )
   769	    try:
   770	        verification_bytes = verification.read_bytes()
   771	        text = verification_bytes.decode()
   772	    except (OSError, UnicodeError) as error:
   773	        raise KRuleInventoryError(
   774	            f"cannot read verification.k: {verification}"
   775	        ) from error
   776	    masked_text = _mask_non_code(text)
   777	    modules = _modules(masked_text)
   778	    module = _verification_module(
   779	        modules, _last_verification_main_module(workspace)
   780	    )
   781	    closure = _verification_closure(modules, module)
   782	    rule_documents = _rule_documents(text, closure)
   783	    return {
   784	        "schema_version": 2,
   785	        "verification_file": "verification.k",
   786	        "verification_sha256": hashlib.sha256(verification_bytes).hexdigest(),
   787	        "verification_module": module.name,
   788	        "verification_modules": [module.name for module in closure],
   789	        "rules": rule_documents,
   790	        "inventory_sha256": canonical_json_sha256(rule_documents),
   791	    }

