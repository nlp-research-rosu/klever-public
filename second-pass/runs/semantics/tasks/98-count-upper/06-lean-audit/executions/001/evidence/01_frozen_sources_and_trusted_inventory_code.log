   663	def desimplify_rule_ids(
   664	    text: str,
   665	    source_rule_ids: list[str],
   666	) -> str:
   667	    """Remove simplification from exactly the selected canonical rule IDs."""
   668	
   669	    if len(source_rule_ids) != len(set(source_rule_ids)):
   670	        raise KRuleInventoryError(
   671	            "exact rule transformation contains a duplicate source rule ID"
   672	        )
   673	    selected = set(source_rule_ids)
   674	    modules = _modules(_mask_non_code(text))
   675	    spans = [
   676	        span
   677	        for local_module in modules
   678	        for span in _rule_spans(text, local_module)
   679	    ]
   680	    by_id = {span.rule.source_rule_id: span for span in spans}
   681	    unknown = sorted(selected - set(by_id))
   682	    if unknown:
   683	        raise KRuleInventoryError(
   684	            "exact rule transformation names an unknown source rule ID: "
   685	            + ", ".join(unknown)
   686	        )
   687	
   688	    edits: list[tuple[int, int]] = []
   689	    for source_rule_id in source_rule_ids:
   690	        span = by_id[source_rule_id]
   691	        if span.attribute_start is None or span.attribute_end is None:
   692	            raise KRuleInventoryError(
   693	                "selected source rule has no simplification attribute: "
   694	                f"{source_rule_id}"
   695	            )
   696	        attribute_text = text[
   697	            span.attribute_start + 1 : span.attribute_end - 1
   698	        ]
   699	        masked_attributes = _mask_non_code(attribute_text)
   700	        tokens = _attribute_token_spans(
   701	            attribute_text,
   702	            masked_attributes,
   703	        )
   704	        matches = [
   705	            index
   706	            for index, (_start, _end, token) in enumerate(tokens)
   707	            if token == "simplification"
   708	        ]
   709	        if len(matches) != 1:
   710	            raise KRuleInventoryError(
   711	                "selected source rule has ambiguous simplification "
   712	                f"attributes: {source_rule_id}"
   713	            )
   714	        token_index = matches[0]
   715	        if len(tokens) == 1:
   716	            edit_start = span.attribute_start
   717	            edit_end = span.attribute_end
   718	        elif token_index < len(tokens) - 1:
   719	            edit_start = (
   720	                span.attribute_start + 1 + tokens[token_index][0]
   721	            )
   722	            edit_end = (
   723	                span.attribute_start + 1 + tokens[token_index + 1][0]
   724	            )
   725	        else:
   726	            edit_start = (
   727	                span.attribute_start + 1 + tokens[token_index - 1][1]
   728	            )
   729	            edit_end = (
   730	                span.attribute_start + 1 + tokens[token_index][1]
   731	            )
   732	        edits.append((edit_start, edit_end))
   733	
   734	    transformed = text
   735	    for start, end in sorted(edits, reverse=True):
   736	        transformed = (
   737	            transformed[:start]
   738	            + _blank_non_newlines(transformed[start:end])
   739	            + transformed[end:]
   740	        )
   741	    return transformed
   742	
