diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..f29a574c4a0148d1740906e3968e4b0b75200618
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,15 @@
+def count_upper(s):
+    count = 0
+    even = True
+    for ch in s:
+        count += even and ch in "AEIOU"
+        even = not even
+    return count
+
+
+assert count_upper("aBCdEf") == 1
+assert count_upper("abcdefg") == 0
+assert count_upper("dBBE") == 0
+assert count_upper("") == 0
+assert count_upper("AEIOU") == 3
+assert count_upper("AaEeIiOoUu") == 5
