index 0000000000000000000000000000000000000000..c66e9d04fcb058f852251cf96ad9b83c5a09bf1b
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete-tests.mpy --definition runtime-kompiled
+
+kompile verification.k \
+  --backend haskell \
+  --main-module COUNT-UPPER-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module COUNT-UPPER-SPEC
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..bbcabd6a00ca7500fe83ae5660ce6e659fc316be
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,8 @@
+def count_upper(s):
+    count = 0
+    even = True
+    ch = ""
+    for ch in s:
+        count += even and ch in "AEIOU"
+        even = not even
+    return count
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f0d7f058d508781f059e9af064945dc8593f7389
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,104 @@
+requires "verification.k"
+
+module COUNT-UPPER-SPEC
+  imports COUNT-UPPER-VERIFICATION
+
+  // Loop invariant.  ACC is the number already seen and countUpperFrom is the
+  // contribution of the unconsumed suffix.  The remaining local bindings are
+  // existential in the post-state because the function returns only count.
+  claim
+    <k>
+      #loop(
+        str(S:IntSeq),
+        Name("ch"),
+        AugAssign(
+          Name("count"),
+          "+",
+          BoolOp(
+            "and",
+            Name("even"),
+            Compare(Name("ch"), CmpOp("in", Str("AEIOU")))))
+        Assign(Name("even"), UnaryOp("not", Name("even")))
+        .Stmts)
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        "s" |-> INPUT:Val
+        "count" |-> (ACC:Int => ACC +Int countUpperFrom(S, EVEN))
+        "even" |-> (EVEN:Bool => ?FINAL_EVEN:Bool)
+        "ch" |-> (OLD_CH:Val => ?FINAL_CH:Val),
+        P:Parent)
+    </scopes>
+
+  // End-to-end claim: load the exact translated definition, call it with an
+  // arbitrary semantic string, and obtain the mathematical result.
+  claim
+    <k>
+      #loadAll(
+        Module(
+          FuncDef(
+            "count_upper",
+            Params("s"),
+            Assign(Name("count"), Int(0))
+            Assign(Name("even"), Bool(true))
+            Assign(Name("ch"), Str(""))
+            For(
+              Name("ch"),
+              Name("s"),
+              AugAssign(
+                Name("count"),
+                "+",
+                BoolOp(
+                  "and",
+                  Name("even"),
+                  Compare(Name("ch"), CmpOp("in", Str("AEIOU")))))
+              Assign(Name("even"), UnaryOp("not", Name("even")))
+              .Stmts)
+            Return(Name("count"))
+            .Stmts)
+          .Stmts))
+      ~> Call(Name("count_upper"), str(S:IntSeq))
+      => countUpperFrom(S, true)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "count_upper" |->
+          closureVal(
+            ("s", .ParamNames),
+            Assign(Name("count"), Int(0))
+            Assign(Name("even"), Bool(true))
+            Assign(Name("ch"), Str(""))
+            For(
+              Name("ch"),
+              Name("s"),
+              AugAssign(
+                Name("count"),
+                "+",
+                BoolOp(
+                  "and",
+                  Name("even"),
+                  Compare(Name("ch"), CmpOp("in", Str("AEIOU")))))
+              Assign(Name("even"), UnaryOp("not", Name("even")))
+              .Stmts)
+            Return(Name("count"))
+            .Stmts,
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4b43ef8570ac1bdceaf17234c4ab57d7b020e1fe
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,17 @@
+requires "reference-semantics/semantics.k"
+
+module COUNT-UPPER-VERIFICATION
+  imports MPY
+
+  // Mathematical result for scanning the remaining character codes.  The
+  // Boolean records whether the next character has an even original index.
+  syntax Int ::= countUpperFrom(IntSeq, Bool) [function, total]
+
+  rule countUpperFrom(.IntSeq, _:Bool) => 0
+  rule countUpperFrom(iCons(C:Int, REST:IntSeq), EVEN:Bool)
+    => (#if EVEN andBool strContains(
+                       iCons(C, .IntSeq),
+                       strToCodes("AEIOU"))
+        #then 1 #else 0 #fi)
+       +Int countUpperFrom(REST, notBool EVEN)
+endmodule

