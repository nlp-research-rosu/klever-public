reference-semantics/semantics/core.k-88-       <heap> ... H |-> cellV(V:Val) ... </heap>
reference-semantics/semantics/core.k-89-       requires "$cells" in_keys(M)
reference-semantics/semantics/core.k-90-       [priority(40)]
reference-semantics/semantics/core.k-91-
reference-semantics/semantics/core.k:92:  // write through a cell (Assign / #bindP / #bindTgt dispatch here on
reference-semantics/semantics/core.k-93-  // cell-bound names)
reference-semantics/semantics/core.k-94-  // a keyword argument cools to a TAGGED value (consumed by kw-aware builtins)
reference-semantics/semantics/core.k-95-  syntax Val ::= kwV(String, Val)
reference-semantics/semantics/core.k-96-  syntax KItem ::= #kwTag(String)
reference-semantics/semantics/core.k-97-  rule <k> KwArg(N:String, E:Expr) => E ~> #kwTag(N) ... </k>
--
reference-semantics/semantics/controls.k-69-  rule <k> For(T:Expr, OBJ:Val, B:Stmts) => #loop(OBJ, T, B) ... </k>
reference-semantics/semantics/controls.k-70-
reference-semantics/semantics/controls.k-71-  rule <k> #loop(IT:Iterable, T:Expr, B:Stmts) => #iterNext(IT) ~> #loopStep(T, B) ... </k>
reference-semantics/semantics/controls.k-72-  rule <k> #iterDone ~> #loopStep(_:Expr, _:Stmts) => .K ... </k>
reference-semantics/semantics/controls.k-73-  rule <k> #iterYield(V:Val, REST:Iterable) ~> #loopStep(T:Expr, B:Stmts)
reference-semantics/semantics/controls.k:74:        => #bindTgt(T, V) ~> B ~> #loopLbl(#loop(REST, T, B)) ... </k>
reference-semantics/semantics/controls.k-75-
reference-semantics/semantics/controls.k-76-  // ==== While ==============================================================
reference-semantics/semantics/controls.k-77-  rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>
reference-semantics/semantics/controls.k-78-  rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>
reference-semantics/semantics/controls.k-79-  rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..f29a574c4a0148d1740906e3968e4b0b75200618
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,15 @@
+def count_upper(s):
+    count = 0
+    even = True
+    for ch in s:
+        count += even and ch in "AEIOU"
+        even = not even
+    return count
+
+
+assert count_upper("aBCdEf") == 1
+assert count_upper("abcdefg") == 0
+assert count_upper("dBBE") == 0
+assert count_upper("") == 0
+assert count_upper("AEIOU") == 3
+assert count_upper("AaEeIiOoUu") == 5
