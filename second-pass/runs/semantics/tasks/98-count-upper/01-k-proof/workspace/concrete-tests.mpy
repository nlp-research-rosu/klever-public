Module(
  FuncDef("count_upper", Params("s"),
    Assign(Name("count"), Int(0))
    Assign(Name("even"), Bool(true))
    Assign(Name("ch"), Str(""))
    For(Name("ch"), Name("s"),
      AugAssign(
        Name("count"),
        "+",
        BoolOp(
          "and",
          Name("even"),
          Compare(Name("ch"), CmpOp("in", Str("AEIOU")))))
      Assign(Name("even"), UnaryOp("not", Name("even"))))
    Return(Name("count")))
  Assert(
    Compare(
      Call(Name("count_upper"), Str("aBCdEf")),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("count_upper"), Str("abcdefg")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("count_upper"), Str("dBBE")), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("count_upper"), Str("")), CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("count_upper"), Str("AEIOU")),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("count_upper"), Str("AaEeIiOoUu")),
      CmpOp("==", Int(5)))))
