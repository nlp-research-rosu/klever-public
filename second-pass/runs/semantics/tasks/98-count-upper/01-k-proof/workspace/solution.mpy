Module(
  FuncDef("count_upper", Params("s"),
    Assign(Name("count"), Int(0))
    Assign(Name("even"), Bool(true))
    Assign(Name("ch"), Str(""))
    For(Name("ch"), Name("s"),
      AugAssign(
        Name("count"),
        "+",
        BoolOp(
          "and",
          Name("even"),
          Compare(Name("ch"), CmpOp("in", Str("AEIOU")))))
      Assign(Name("even"), UnaryOp("not", Name("even"))))
    Return(Name("count"))))
