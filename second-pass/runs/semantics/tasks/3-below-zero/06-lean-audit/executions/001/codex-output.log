/bin/bash -lc "{
set -x
PYTHONPATH=/reference python3 - <<'PY'
import hashlib, json, re
from pathlib import Path
from tools import klean_export, lemma_discovery_contract
from tools.k_rule_inventory import inventory_verification

workspace = Path('/reference/k-proof')
discovery_path = Path('/reference/lemma-discovery.json')
generation = Path('/reference/klean-generation')
generated = generation / 'generated'
audit = json.loads(Path('/audit-input.json').read_text())['resolution']
discovery = json.loads(discovery_path.read_text())
inventory = inventory_verification(workspace)
validated = lemma_discovery_contract.validate_trust_boundary(workspace, discovery_path)
input_manifest = json.loads((generation / 'input-manifest.json').read_text())
generator = json.loads((generation / 'generator-manifest.json').read_text())
export = json.loads((generation / 'export-result.json').read_text())
stored_preflight = json.loads((generation / 'preflight.json').read_text())
trust = json.loads((generation / 'trust-inventory.json').read_text())
obligation_map = json.loads((generated / 'obligation-map.json').read_text())

def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()

def check(label, condition):
    print(f'{label}: {bool(condition)}')

inventory_ids = [r['source_rule_id'] for r in inventory['rules']]
discovery_ids = [r['source_rule_id'] for r in discovery['rules']]
check('canonical inventory count == 8', len(inventory_ids) == 8)
check('canonical IDs unique', len(set(inventory_ids)) == len(inventory_ids))
check('Stage 3 IDs exact and ordered', discovery_ids == inventory_ids)
check('Stage 3 IDs unique', len(set(discovery_ids)) == len(discovery_ids))
check('Stage 3 inventory hash canonical', discovery['inventory_sha256'] == inventory['inventory_sha256'])
check('trusted boundary validator count', sum(len(validated[k]) for k in ('definitions','operational_rules','proved_derived_lemmas','domain_lemmas')) == 8)
print('validated classification counts:', {k: len(validated[k]) for k in ('definitions','operational_rules','proved_derived_lemmas','domain_lemmas')})
print('independent DOMAIN_LEMMA IDs: []')
print('generated source-rule IDs:', [r.get('source_rule_id') for r in obligation_map['source_rules']])
print('generated obligation IDs:', [r.get('source_rule_id') for r in obligation_map['obligations']])
check('empty-domain/source-rule bijection', validated['domain_lemmas'] == [] and input_manifest['source_rules'] == [] and obligation_map['source_rules'] == [])
check('empty-source/obligation bijection', obligation_map['obligations'] == [] and obligation_map['trust_parameters'] == [])
check('obligation count bindings', generator['obligation_count'] == export['obligation_count'] == stored_preflight['obligation_count'] == audit['stage4_preflight']['obligation_count'] == 0)
check('status bindings', export['status'] == stored_preflight['status'] == audit['stage4_preflight']['status'] == audit['selections']['klean_generation']['status'] == 'KLEAN_NO_OBLIGATIONS')
check('target null everywhere', generator['target'] is None and stored_preflight['target'] is None and audit['stage4_preflight']['target'] is None and audit['target'] is None)
check('no target declaration in generated Lean', not any(re.search(r'(?m)"'^'"\\s*(?:theorem|lemma)\\s+', p.read_text()) for p in generated.rglob('*.lean')))
check('candidate absent', not Path('/candidate').exists() and not Path('/candidate').is_symlink())

stage1 = klean_export.tree_digest(workspace)
discovery_sha = sha(discovery_path)
generated_sha = klean_export.tree_digest(generated)
check('stage1 hash all Stage 4 bindings', all(value == stage1 for value in [input_manifest['frozen_input_sha256'], input_manifest['stage1_workspace_sha256'], generator['provenance']['stage1_workspace_sha256'], export['frozen_input_sha256'], stored_preflight['frozen_input_sha256'], stored_preflight['stage1_workspace_sha256'], audit['stage4_preflight']['frozen_input_sha256'], audit['stage4_preflight']['stage1_workspace_sha256'], audit['hashes']['stage1_export_sha256']]))
check('discovery hash all Stage 4 bindings', all(value == discovery_sha for value in [input_manifest['stage3_discovery_manifest_sha256'], generator['provenance']['stage3_discovery_manifest_sha256'], export['stage3_discovery_manifest_sha256'], stored_preflight['stage3_discovery_manifest_sha256'], audit['stage4_preflight']['stage3_discovery_manifest_sha256'], audit['hashes']['discovery_manifest_sha256']]))
check('generated hash all Stage 4 bindings', all(value == generated_sha for value in [generator['generated_tree_sha256'], export['generated_tree_sha256'], stored_preflight['generated_tree_sha256'], audit['stage4_preflight']['generated_tree_sha256'], audit['hashes']['generated_tree_sha256']]))
check('inventory hash all bindings', input_manifest['inventory_sha256'] == generator['provenance']['inventory_sha256'] == discovery['inventory_sha256'] == inventory['inventory_sha256'])
check('verification hash binding', input_manifest['verification_sha256'] == inventory['verification_sha256'] == sha(workspace / 'verification.k'))
check('obligation-map hash binding', generator['obligation_map_sha256'] == sha(generated / 'obligation-map.json'))
