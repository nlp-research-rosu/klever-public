diff --git a//tmp/audit-work/lean-proc-readlink-shim.c b//tmp/audit-work/lean-proc-readlink-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..be8ba27a9682df44fbd00ef689ad2b084abd8317
--- /dev/null
+++ b//tmp/audit-work/lean-proc-readlink-shim.c
@@ -0,0 +1,28 @@
+#define _GNU_SOURCE
+
+#include <dlfcn.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink;
+    char namespaced_executable[64];
+
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+    snprintf(
+        namespaced_executable,
+        sizeof(namespaced_executable),
+        "/proc/%d/exe",
+        (int)getpid()
+    );
+    if (strcmp(path, namespaced_executable) == 0) {
+        return real_readlink("/proc/self/exe", buffer, size);
+    }
+    return real_readlink(path, buffer, size);
+}
