+ nl -ba /reference/k-proof/solution.py
     1	from typing import List
     2	
     3	
     4	def below_zero(operations: List[int]) -> bool:
     5	    balance = 0
     6	    operation = 0
     7	    for operation in operations:
     8	        balance += operation
     9	        if balance < 0:
    10	            return True
    11	    return False
+ nl -ba /reference/k-proof/solution.mpy
     1	Module(
     2	  ImportFrom("typing", "List")
     3	  FuncDef("below_zero", Params("operations"),
     4	    Assign(Name("balance"), Int(0))
     5	    Assign(Name("operation"), Int(0))
     6	    For(Name("operation"), Name("operations"),
     7	      AugAssign(Name("balance"), "+", Name("operation"))
     8	      If(Compare(Name("balance"), CmpOp("<", Int(0))),
     9	        Return(Bool(true)),
    10	        ))
    11	    Return(Bool(false))))
