def hfile(p):
    return hashlib.sha256(Path(p).read_bytes()).hexdigest()

def show(label, actual, expected):
    print(f\"{label}\\n  actual:   {actual}\\n  expected: {expected}\\n  match:    {actual == expected}\")

audit = json.loads(Path('/audit-input.json').read_text())
r = audit['resolution']
h = r['hashes']
show('discovery_manifest_sha256', hfile('/reference/lemma-discovery.json'), h['discovery_manifest_sha256'])
show('k_workspace_sha256 (pipeline tree)', pipeline_contract.sha256_tree(Path('/reference/k-proof')), h['k_workspace_sha256'])
show('stage1_export_sha256 (Klean tree)', klean_export.tree_digest(Path('/reference/k-proof')), h['stage1_export_sha256'])
show('k_audit_sha256 (pipeline tree)', pipeline_contract.sha256_tree(Path('/reference/k-audit')), h['k_audit_sha256'])
show('klean_generation_sha256 (pipeline tree)', pipeline_contract.sha256_tree(Path('/reference/klean-generation')), h['klean_generation_sha256'])
show('generated_tree_sha256 (Klean tree)', klean_export.tree_digest(Path('/reference/klean-generation/generated')), h['generated_tree_sha256'])
show('generation_producer_sources_sha256 (pipeline tree)', pipeline_contract.sha256_tree(Path('/reference/generation-tools')), h['generation_producer_sources_sha256'])

expected_sources = r['stage1_source_hashes']
actual_sources = {}
for path in sorted(Path('/reference/k-proof').rglob('*')):
    mode = path.lstat().st_mode
    if stat.S_ISLNK(mode) or not (stat.S_ISREG(mode) or stat.S_ISDIR(mode)):
        raise RuntimeError(f'unsafe Stage 1 tree entry: {path}')
    if stat.S_ISREG(mode):
        actual_sources[path.relative_to('/reference/k-proof').as_posix()] = hfile(path)
print('stage1_source_hashes keys exact:', set(actual_sources) == set(expected_sources))
print('stage1_source_hashes values exact:', actual_sources == expected_sources)
for name in sorted(set(actual_sources) | set(expected_sources)):
    print(f\"  {name}: actual={actual_sources.get(name)} expected={expected_sources.get(name)} match={actual_sources.get(name)==expected_sources.get(name)}\")

source_manifest = json.loads(Path('/reference/generation-tools/source-manifest.json').read_text())
generator_manifest = json.loads(Path('/reference/klean-generation/generator-manifest.json').read_text())
for name, expected in source_manifest['files'].items():
    show(f'producer file {name} vs source manifest', hfile(Path('/reference/generation-tools') / name), expected)
show('klean_export producer vs generator manifest', hfile('/reference/generation-tools/klean_export.py'), generator_manifest['exporter_sha256'])
show('klean.py producer vs generator manifest', hfile('/reference/generation-tools/klean.py'), generator_manifest['klean_py_sha256'])
producer_path_digest = Path(r['generation_producer_sources']).name
image_digest = source_manifest['generator_image_id'].removeprefix('sha256:')
manifest_image_digest = generator_manifest['provenance']['generator_image_id'].removeprefix('sha256:')
print('generator image identities:')
print('  audit-input producer path digest:', producer_path_digest)
print('  source manifest digest:          ', image_digest)
print('  generator manifest digest:       ', manifest_image_digest)
print('  all match:', producer_path_digest == image_digest == manifest_image_digest)
