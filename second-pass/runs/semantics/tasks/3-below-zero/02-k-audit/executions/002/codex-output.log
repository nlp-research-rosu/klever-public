--- /dev/null
+++ b//tmp/audit-work/reconstruction/spec-audit-mutation.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module AUDIT-MUTATION
+  imports MPY-VERIFICATION-LEMMA
+
+  // Fresh false result mutation.  The submitted and canonical Python
+  // functions both return true on [-1], but this claim demands false.
+  claim
+    <k> #loadAll(solutionProgram)
+         ~> Call(
+              Name("below_zero"),
+              list(asValSeq(intCons(-1, .IntVals))))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "below_zero" |-> closureVal(
+          "operations", belowZeroFunctionBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
