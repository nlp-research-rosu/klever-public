diff --git a//tmp/audit-work/reconstruction/verification-body-mutant.k b//tmp/audit-work/reconstruction/verification-body-mutant.k
new file mode 100644
index 0000000000000000000000000000000000000000..7cbe5fb437128897b44f8e36596556606fc7633a
--- /dev/null
+++ b//tmp/audit-work/reconstruction/verification-body-mutant.k
@@ -0,0 +1,75 @@
+requires "reference-semantics/semantics.k"
+
+module BELOW-ZERO-COMMON-MUTANT
+  imports MPY
+
+  // Auditor mutation: the submitted '< 0' test is changed to '> 0'.
+  syntax Stmts ::= "mutantLoopBody" [macro]
+  rule mutantLoopBody
+    => AugAssign(Name("balance"), "+", Name("operation"))
+       If(Compare(Name("balance"), CmpOp(">", Int(0))),
+          Return(Bool(true)) .Stmts,
+          .Stmts)
+
+  syntax Stmts ::= "mutantFunctionBody" [macro]
+  rule mutantFunctionBody
+    => Assign(Name("balance"), Int(0))
+       Assign(Name("operation"), Int(0))
+       For(Name("operation"), Name("operations"), mutantLoopBody)
+       Return(Bool(false))
+
+  syntax Module ::= "mutantSolutionProgram" [macro]
+  rule mutantSolutionProgram
+    => Module(
+         ImportFrom("typing", "List")
+         FuncDef("below_zero", Params("operations"), mutantFunctionBody))
+
+  syntax IntVals ::= ".IntVals" | intCons(Int, IntVals)
+  syntax ValSeq ::= asValSeq(IntVals)
+  rule <k> #iterNext(list(asValSeq(.IntVals))) => #iterDone ... </k>
+  rule <k> #iterNext(list(asValSeq(intCons(I:Int, IS:IntVals))))
+        => #iterYield(I, list(asValSeq(IS))) ... </k>
+
+  syntax Bool ::= prefixBelow(Int, IntVals) [function, total]
+  rule prefixBelow(_:Int, .IntVals) => false
+  rule prefixBelow(B:Int, intCons(I:Int, IS:IntVals))
+    => #if B +Int I <Int 0
+       #then true
+       #else prefixBelow(B +Int I, IS)
+       #fi
+endmodule
+
+module MPY-BODY-MUTANT-BASE
+  imports BELOW-ZERO-COMMON-MUTANT
+endmodule
+
+module MPY-BODY-MUTANT-LEMMA
+  imports BELOW-ZERO-COMMON-MUTANT
+
+  rule
+    <k> #loop(list(asValSeq(IS:IntVals)), Name("operation"), mutantLoopBody)
+         ~> (Return(Bool(false)) .Stmts) ~> #endcall
+      => prefixBelow(B, IS)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(MODULE:Map, parent(-1))
+      -1 |-> BUILTINS:Scope
+      1 |-> scope(
+        "operations" |-> list(asValSeq(INPUT:IntVals))
+        "operation"  |-> OLD:Val
+        "balance"    |-> B:Int,
+        parent(0))
+      =>
+      0 |-> scope(MODULE, parent(-1))
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(40)]
+endmodule
