diff --git a//tmp/audit-work/reconstruction/auditor-concrete-tests.py b//tmp/audit-work/reconstruction/auditor-concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..58c56aa1c552ac1c12bdd7e581417885823cd070
--- /dev/null
+++ b//tmp/audit-work/reconstruction/auditor-concrete-tests.py
@@ -0,0 +1,24 @@
+from typing import List
+
+
+def below_zero(operations: List[int]) -> bool:
+    balance = 0
+    operation = 0
+    for operation in operations:
+        balance += operation
+        if balance < 0:
+            return True
+    return False
+
+
+assert below_zero([]) == False
+assert below_zero([1, 2, 3]) == False
+assert below_zero([1, 2, -4, 5]) == True
+assert below_zero([0]) == False
+assert below_zero([-1]) == True
+assert below_zero([1, -1]) == False
+assert below_zero([1, -2]) == True
+assert below_zero([5, -5]) == False
+assert below_zero([5, -6]) == True
+assert below_zero([100000000000000000000, -100000000000000000000]) == False
+assert below_zero([100000000000000000000, -100000000000000000001]) == True
