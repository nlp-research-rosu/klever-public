+#!/usr/bin/env bash
+set -u
+
+log=/audit-output/evidence/02_fidelity.log
+exec > >(tee "$log") 2>&1
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
