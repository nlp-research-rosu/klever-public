  --main-module MPY-VERIFICATION-LEMMA \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-lemma-kompiled
kprove spec.k \
  --definition verification-lemma-kompiled \
  --spec-module MAIN-SPEC
from typing import List


def below_zero(operations: List[int]) -> bool:
    balance = 0
    operation = 0
    for operation in operations:
        balance += operation
        if balance < 0:
            return True
    return False


assert below_zero([1, 2, 3]) == False
assert below_zero([1, 2, -4, 5]) == True
assert below_zero([]) == False
assert below_zero([0, -1]) == True
assert below_zero([5, -5]) == False
Module(
  ImportFrom("typing", "List")
  FuncDef("below_zero", Params("operations"),
    Assign(Name("balance"), Int(0))
    Assign(Name("operation"), Int(0))
    For(Name("operation"), Name("operations"),
      AugAssign(Name("balance"), "+", Name("operation"))
      If(Compare(Name("balance"), CmpOp("<", Int(0))),
        Return(Bool(true)),
        ))
    Return(Bool(false)))
  Assert(
    Compare(
      Call(Name("below_zero"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("below_zero"),
        ListExpr(Int(1), Int(2), UnaryOp("-", Int(4)), Int(5))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("below_zero"), ListExpr()),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("below_zero"), ListExpr(Int(0), UnaryOp("-", Int(1)))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("below_zero"), ListExpr(Int(5), UnaryOp("-", Int(5)))),
      CmpOp("==", Bool(false)))))

