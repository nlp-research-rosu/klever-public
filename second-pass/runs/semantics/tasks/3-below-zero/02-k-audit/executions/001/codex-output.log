+#!/usr/bin/env bash
+set -u
+
+log=/audit-output/evidence/04_adequacy.log
+exec > >(tee "$log") 2>&1
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
