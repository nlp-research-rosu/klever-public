diff --git a/evidence/00_environment.sh b/evidence/00_environment.sh
new file mode 100644
index 0000000000000000000000000000000000000000..b409e71b38f8f812a692fdb11685be4115632102
--- /dev/null
+++ b/evidence/00_environment.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -u
+
+log=/audit-output/evidence/00_environment.log
+exec > >(tee "$log") 2>&1
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return 0
+}
+
+printf 'rendered_semantics_mode=SUPPLIED_SEMANTICS\n'
+run test -d /reference/reference-semantics
