+#!/usr/bin/env bash
+set -u
+
+log=/audit-output/evidence/02_fidelity.log
+exec > >(tee "$log") 2>&1
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  if test "$status" -ne 0; then
+    exit "$status"
+  fi
+}
+
+run python3 /tmp/audit-work/rebuild/trusted/py2mpy.py \
+  /tmp/audit-work/rebuild/candidate/solution.py
