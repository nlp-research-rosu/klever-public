+requires "verification.k"
+
+module SPEC-VACUITY
+  imports MPY-VERIFICATION-LEMMA
+
+  // Deliberately false: the submitted function returns prefixBelow(0, IS),
+  // not its negation. Empty input is a satisfying witness (false != true).
+  claim
+    <k> #loadAll(solutionProgram)
+         ~> Call(Name("below_zero"), list(asValSeq(IS:IntVals)))
+      => notBool prefixBelow(0, IS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "below_zero" |-> closureVal(
+          "operations", belowZeroFunctionBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule

diff --git a//tmp/audit-work/rebuild/candidate/audit-concrete.py b//tmp/audit-work/rebuild/candidate/audit-concrete.py
new file mode 100644
index 0000000000000000000000000000000000000000..caf37c7a1e094e76c45dd2157eedbcfa7e59f3de
--- /dev/null
+++ b//tmp/audit-work/rebuild/candidate/audit-concrete.py
@@ -0,0 +1,25 @@
+from typing import List
+
+
+def below_zero(operations: List[int]) -> bool:
+    balance = 0
+    operation = 0
+    for operation in operations:
+        balance += operation
+        if balance < 0:
+            return True
+    return False
+
+
+# Auditor-authored normal, empty, and branch-boundary checks.
+assert below_zero([1, 2, 3]) == False
+assert below_zero([1, 2, -4, 5]) == True
+assert below_zero([]) == False
+assert below_zero([-1]) == True
+assert below_zero([0]) == False
+assert below_zero([1]) == False
+assert below_zero([5, -5]) == False
+assert below_zero([5, -6]) == True
+assert below_zero([-1, 100]) == True
+assert below_zero([100000000000000000000, -100000000000000000000]) == False
+assert below_zero([100000000000000000000, -100000000000000000001]) == True
diff --git a//tmp/audit-work/rebuild/candidate/spec-body-sensitivity.k b//tmp/audit-work/rebuild/candidate/spec-body-sensitivity.k
new file mode 100644
index 0000000000000000000000000000000000000000..a66be1c60b6dfc25893d6feb81409a7f68ed9849
--- /dev/null
+++ b//tmp/audit-work/rebuild/candidate/spec-body-sensitivity.k
@@ -0,0 +1,40 @@
+requires "verification.k"
+
+module BODY-SENSITIVITY
+  imports MPY-VERIFICATION
+
+  // Deliberately changes balance += operation to balance -= operation.
+  // For the satisfying ground state B=0, remaining=[1], fixed execution
+  // returns true, while the original prefixBelow(0,[1]) is false.
+  claim
+    <k> #loop(
+          list(asValSeq(intCons(1, .IntVals))),
+          Name("operation"),
+          AugAssign(Name("balance"), "-", Name("operation"))
+          If(Compare(Name("balance"), CmpOp("<", Int(0))),
+            Return(Bool(true)) .Stmts,
+            .Stmts))
+         ~> (Return(Bool(false)) .Stmts) ~> #endcall
+      => prefixBelow(0, intCons(1, .IntVals))
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        "operations" |-> list(asValSeq(intCons(1, .IntVals)))
+        "operation"  |-> 0
+        "balance"    |-> 0,
+        parent(0))
+      =>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
