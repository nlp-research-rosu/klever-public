+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  if test "$status" -ne 0; then
+    exit "$status"
+  fi
+}
+
+work=/tmp/audit-work/rebuild/candidate
