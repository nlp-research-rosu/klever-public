+#!/usr/bin/env bash
+set -u
+
+log=/audit-output/evidence/05_operational_sensitivity.log
+exec > >(tee "$log") 2>&1
+
+run_success() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  if test "$status" -ne 0; then
+    exit "$status"
+  fi
+}
+
+run_expected_failure() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d; expected nonzero]\n' "$status"
+  if test "$status" -eq 0; then
