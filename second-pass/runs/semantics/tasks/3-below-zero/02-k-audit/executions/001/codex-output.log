+         ~> (Return(Bool(true)) .Stmts) ~> #endcall
+      => true
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(
+        "operations" |-> list(asValSeq(.IntVals))
+        "operation"  |-> 0
+        "balance"    |-> 0,
+        parent(0))
+      =>
