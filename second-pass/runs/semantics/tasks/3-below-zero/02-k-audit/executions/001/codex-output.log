+  if test "$status" -ne 0; then
+    exit "$status"
+  fi
+}
+
+work=/tmp/audit-work/rebuild/candidate
+definition="$work/verification-lemma-kompiled"
+
+run kast "$work/solution.mpy" \
+  --definition "$definition" \
+  --module MPY-SYNTAX \
+  --sort Module \
+  --expand-macros \
+  --output kore \
+  --output-file "$work/submitted-solution.kore"
