diff --git a/evidence/spec-context-sensitivity-lemma.k b/evidence/spec-context-sensitivity-lemma.k
new file mode 100644
index 0000000000000000000000000000000000000000..45e3e81e2d83911641555623e611b4005d40e0de
--- /dev/null
+++ b/evidence/spec-context-sensitivity-lemma.k
@@ -0,0 +1,36 @@
+requires "verification.k"
+
+module CONTEXT-SENSITIVITY-LEMMA
+  imports MPY-VERIFICATION-LEMMA
+
+  // Same ground context test as the base-definition version. The operational
+  // bridge is present here but cannot match the observable Return(true) suffix.
+  claim
+    <k> #loop(
