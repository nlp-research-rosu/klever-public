diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4923b7a316bdea4f505dbf446984a82a8f9d128c
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,82 @@
+requires "reference-semantics/semantics.k"
+
+module BELOW-ZERO-COMMON
+  imports MPY
+
+  // These aliases are the exact constructor terms emitted in solution.mpy.
+  syntax Stmts ::= "belowZeroLoopBody" [macro]
+  rule belowZeroLoopBody
+    => AugAssign(Name("balance"), "+", Name("operation"))
+       If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Bool(true)) .Stmts,
+          .Stmts)
+
+  syntax Stmts ::= "belowZeroFunctionBody" [macro]
+  rule belowZeroFunctionBody
+    => Assign(Name("balance"), Int(0))
+       For(Name("operation"), Name("operations"), belowZeroLoopBody)
+       Return(Bool(false))
+
+  syntax Module ::= "solutionProgram" [macro]
+  rule solutionProgram
+    => Module(
+         ImportFrom("typing", "List")
+         FuncDef("below_zero", Params("operations"), belowZeroFunctionBody))
+
+  // A symbolic Val constrained by isIntVal is not automatically re-sorted by
+  // the prover.  intOf is the identity on every concrete integer; the low-
+  // priority applyBin equation merely exposes that fact on a symbolic Val.
+  rule applyBin("+", B:Int, V:Val) => B +Int intOf(V)
+    requires isInt(V)
+    [priority(100)]
+
+  // Mathematical contract: some running balance, starting at B, is negative.
+  syntax Bool ::= prefixBelow(Int, ValSeq) [function]
+  rule prefixBelow(_:Int, .ValSeq) => false
+  rule prefixBelow(B:Int, vCons(V:Val, _:ValSeq)) => true
+    requires isInt(V) andBool B +Int intOf(V) <Int 0
+  rule prefixBelow(B:Int, vCons(V:Val, VS:ValSeq))
+    => prefixBelow(B +Int intOf(V), VS)
+    requires isInt(V) andBool B +Int intOf(V) >=Int 0
+
+  // The HumanEval input type is List[int].  This predicate states that
+  // precondition without bounding the list's length or its integer values.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(V:Val, VS:ValSeq))
+    => isInt(V) andBool allInts(VS)
+endmodule
+
+module MPY-VERIFICATION
+  imports BELOW-ZERO-COMMON
+endmodule
+
+module MPY-VERIFICATION-LEMMA
+  imports BELOW-ZERO-COMMON
+
+  // This is admitted only in the definition used for the top-level claim.
+  // AUX-SPEC proves this exact reachability step first against MPY itself.
+  rule
+    <k> #loop(list(VS:ValSeq), Name("operation"), belowZeroLoopBody)
+         ~> Return(Bool(false)) ~> #endcall
+      => prefixBelow(B, VS)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(MODULE:Map, parent(-1))
+      -1 |-> builtinsScope
+      1 |-> scope(("balance" |-> B:Int) FRAME:Map, parent(0))
+      =>
+      0 |-> scope(MODULE, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+     andBool notBool ("$cells" in_keys(FRAME))
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module MPY-VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-base-kompiled' in /work
