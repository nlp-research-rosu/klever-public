@@ -0,0 +1,11 @@
+from typing import List
+
+
+def below_zero(operations: List[int]) -> bool:
+    balance = 0
+    operation = 0
+    for operation in operations:
+        balance += operation
+        if balance < 0:
+            return True
+    return False
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b2488aeaaedbc99b0167275982c1a8b63489b6d0
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,59 @@
+requires "verification.k"
+
+module AUX-SPEC
+  imports MPY-VERIFICATION
+
+  claim
+    <k> #loop(list(asValSeq(IS:IntVals)), Name("operation"), belowZeroLoopBody)
+         ~> (Return(Bool(false)) .Stmts) ~> #endcall
+      => prefixBelow(B, IS)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(MODULE:Map, parent(-1))
+      -1 |-> BUILTINS:Scope
+      1 |-> scope(
+        "operations" |-> list(asValSeq(INPUT:IntVals))
+        "operation"  |-> OLD:Val
+        "balance"    |-> B:Int,
+        parent(0))
+      =>
+      0 |-> scope(MODULE, parent(-1))
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module MAIN-SPEC
+  imports MPY-VERIFICATION-LEMMA
+
+  claim
+    <k> #loadAll(solutionProgram)
+         ~> Call(Name("below_zero"), list(asValSeq(IS:IntVals)))
+      => prefixBelow(0, IS)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0 |-> scope(
+        "below_zero" |-> closureVal(
+          "operations", belowZeroFunctionBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2038d515c5c909e6f9c57b2107a7e11f68262ecc
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,85 @@
+requires "reference-semantics/semantics.k"
+
+module BELOW-ZERO-COMMON
+  imports MPY
+
+  // These aliases are the exact constructor terms emitted in solution.mpy.
+  syntax Stmts ::= "belowZeroLoopBody" [macro]
+  rule belowZeroLoopBody
+    => AugAssign(Name("balance"), "+", Name("operation"))
+       If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Bool(true)) .Stmts,
+          .Stmts)
+
+  syntax Stmts ::= "belowZeroFunctionBody" [macro]
+  rule belowZeroFunctionBody
+    => Assign(Name("balance"), Int(0))
+       Assign(Name("operation"), Int(0))
+       For(Name("operation"), Name("operations"), belowZeroLoopBody)
+       Return(Bool(false))
+
+  syntax Module ::= "solutionProgram" [macro]
+  rule solutionProgram
+    => Module(
+         ImportFrom("typing", "List")
+         FuncDef("below_zero", Params("operations"), belowZeroFunctionBody))
+
+  // An inductive, integer-only presentation of every finite List[int].  The
+  // simplifications erase concrete instances to MPY's native vCons/.ValSeq;
+  // the iterator equations expose a typed head while the carrier is symbolic.
+  syntax IntVals ::= ".IntVals" | intCons(Int, IntVals)
+  syntax ValSeq ::= asValSeq(IntVals)
+  rule asValSeq(.IntVals) => .ValSeq [simplification]
+  rule asValSeq(intCons(I:Int, IS:IntVals))
+    => vCons(I, asValSeq(IS))
+    [simplification]
+  rule <k> #iterNext(list(asValSeq(.IntVals))) => #iterDone ... </k>
+  rule <k> #iterNext(list(asValSeq(intCons(I:Int, IS:IntVals))))
+        => #iterYield(I, list(asValSeq(IS))) ... </k>
+
+  // Mathematical contract: some running balance, starting at B, is negative.
+  syntax Bool ::= prefixBelow(Int, IntVals) [function, total]
+  rule prefixBelow(_:Int, .IntVals) => false
+  rule prefixBelow(B:Int, intCons(I:Int, IS:IntVals))
+    => #if B +Int I <Int 0
+       #then true
+       #else prefixBelow(B +Int I, IS)
+       #fi
+endmodule
+
+module MPY-VERIFICATION
+  imports BELOW-ZERO-COMMON
+endmodule
+
+module MPY-VERIFICATION-LEMMA
+  imports BELOW-ZERO-COMMON
+
+  // This is admitted only in the definition used for the top-level claim.
+  // AUX-SPEC proves this exact reachability step first against MPY itself.
+  rule
+    <k> #loop(list(asValSeq(IS:IntVals)), Name("operation"), belowZeroLoopBody)
+         ~> (Return(Bool(false)) .Stmts) ~> #endcall
+      => prefixBelow(B, IS)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      0 |-> scope(MODULE:Map, parent(-1))
+      -1 |-> BUILTINS:Scope
+      1 |-> scope(
+        "operations" |-> list(asValSeq(INPUT:IntVals))
+        "operation"  |-> OLD:Val
+        "balance"    |-> B:Int,
+        parent(0))
+      =>
+      0 |-> scope(MODULE, parent(-1))
+      -1 |-> BUILTINS
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP:Map </heap>
+    <heapLoc> NEXT:Int </heapLoc>
+    <stack> ListItem(frame(.K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [priority(40)]
+endmodule

