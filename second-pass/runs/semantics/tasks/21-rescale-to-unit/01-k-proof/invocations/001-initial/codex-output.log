+
+  claim [rescale-to-unit]:
+    <k> #runRescale(VS:ValSeq)
+      => list(scaleAcc(.ValSeq, VS, minVF(VS), maxVF(VS)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => _:Map </heap>
+    <heapLoc> 0 => _:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
