+             maxVF(
+               vCons(FIRST,
+                 vCons(SECOND, REST)))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
