diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..bbc660b6431fb6c474dcf377d9c2140ce502ba4e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,36 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim
+    <k>
+      #runRescale(
+        vCons(FIRST:Float,
+          vCons(SECOND:Float, REST:ValSeq)))
+      => list(
+           scaleAcc(
+             .ValSeq,
+             vCons(FIRST,
+               vCons(SECOND, REST)),
+             minVF(
+               vCons(FIRST,
+                 vCons(SECOND, REST))),
+             maxVF(
+               vCons(FIRST,
+                 vCons(SECOND, REST)))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINALHEAP:Map </heap>
+    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allFloats(REST)
+endmodule
