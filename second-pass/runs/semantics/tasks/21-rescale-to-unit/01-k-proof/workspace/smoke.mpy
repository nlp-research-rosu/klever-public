Module(
  ImportFrom("typing", "List")
  FuncDef("rescale_to_unit", Params("numbers"), CellVars("max_number", "min_number"), FreeVars(),
    Assign(Name("min_number"), Call(Name("min"), Name("numbers")))
    Assign(Name("max_number"), Call(Name("max"), Name("numbers")))
    Return(
      ListComp(BinOp(
        "/",
        BinOp("-", Name("number"), Name("min_number")),
        BinOp("-", Name("max_number"), Name("min_number"))),
        CompFor(Name("number"), Name("numbers"), Bool(true)))))
  Assert(
    Compare(
      Call(
        Name("rescale_to_unit"),
        ListExpr(
          Float(1.0),
          Float(2.0),
          Float(3.0),
          Float(4.0),
          Float(5.0))),
      CmpOp(
        "==",
        ListExpr(
          Float(0.0),
          Float(0.25),
          Float(0.5),
          Float(0.75),
          Float(1.0)))))
  Assert(
    Compare(
      Call(
        Name("rescale_to_unit"),
        ListExpr(
          UnaryOp("-", Float(3.0)),
          UnaryOp("-", Float(1.0)),
          Float(1.0))),
      CmpOp("==", ListExpr(Float(0.0), Float(0.5), Float(1.0)))))
  Assert(
    Compare(
      Call(Name("rescale_to_unit"), ListExpr(Float(5.0), Float(1.0))),
      CmpOp("==", ListExpr(Float(1.0), Float(0.0))))))
