COMMAND: bash -lc python3\ trusted-py2mpy.py\ k-equal-witness.py\ \>\ k-equal-witness.mpy\;\ status=\$\?\;\ nl\ -ba\ k-equal-witness.mpy\;\ exit\ \"\$status\" 
EXIT_STATUS: 0
OUTPUT_BEGIN
     1	Module(
     2	  FuncDef("rescale_to_unit", Params("numbers"), CellVars("max_number", "min_number"), FreeVars(),
     3	    Assign(Name("min_number"), Call(Name("min"), Name("numbers")))
     4	    Assign(Name("max_number"), Call(Name("max"), Name("numbers")))
     5	    Return(
     6	      ListComp(BinOp(
     7	        "/",
     8	        BinOp("-", Name("number"), Name("min_number")),
     9	        BinOp("-", Name("max_number"), Name("min_number"))),
    10	        CompFor(Name("number"), Name("numbers"), Bool(true)))))
    11	  Assign(
    12	    Name("result"),
    13	    Call(Name("rescale_to_unit"), ListExpr(Float(2.0), Float(2.0)))))
OUTPUT_END
