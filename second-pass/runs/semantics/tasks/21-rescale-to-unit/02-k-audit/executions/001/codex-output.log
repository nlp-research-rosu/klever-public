--- /dev/null
+++ b/evidence/bridge_witness.py
@@ -0,0 +1,11 @@
+def rescale_to_unit(numbers):
+    min_number = min(numbers)
+    max_number = max(numbers)
+    return [
+        (number - min_number) / (max_number - min_number)
+        for number in numbers
+    ]
+
+
+result = rescale_to_unit([1.0, 2.0])
+after = [7.0]
