diff --git a//tmp/audit-work/21-rescale-to-unit/spec-vacuity-audit.k b//tmp/audit-work/21-rescale-to-unit/spec-vacuity-audit.k
new file mode 100644
index 0000000000000000000000000000000000000000..02ff781740d988c0511ac3fc882d119f0996ccbc
--- /dev/null
+++ b//tmp/audit-work/21-rescale-to-unit/spec-vacuity-audit.k
@@ -0,0 +1,41 @@
+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // Fresh false mutation: prepend an impossible extra element to the claimed
+  // result.  Satisfying witness [1.0, 2.0] returns two elements, not three.
+  claim
+    <k>
+      #runRescale(
+        vCons(FIRST:Float,
+          vCons(SECOND:Float, REST:ValSeq)))
+      => list(
+           vCons(
+             0.0,
+             scaleAcc(
+               .ValSeq,
+               vCons(FIRST,
+                 vCons(SECOND, REST)),
+               minVF(
+                 vCons(FIRST,
+                   vCons(SECOND, REST))),
+               maxVF(
+                 vCons(FIRST,
+                   vCons(SECOND, REST))))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINALHEAP:Map </heap>
+    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allFloats(REST)
+endmodule
