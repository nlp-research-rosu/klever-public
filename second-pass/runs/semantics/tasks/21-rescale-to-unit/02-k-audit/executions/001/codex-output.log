@@ -0,0 +1,39 @@
+requires "reference-semantics/semantics.k"
+
+module FIXED-HARNESS
+  imports MPY
+
+  syntax KItem ::= "#observeFixed"
+  rule <k> ref(H:Int) ~> #observeFixed => V ... </k>
+       <heap> ... H |-> V:Val ... </heap>
+
+  syntax KItem ::= #runFixed(ValSeq)
+  rule <k> #runFixed(VS:ValSeq)
+        => #loadAll(Module(
+             ImportFrom("typing", "List")
+             FuncDef(
+               "rescale_to_unit",
+               Params("numbers"),
+               CellVars("max_number", "min_number"),
+               FreeVars(.ParamNames),
+               Assign(
+                 Name("min_number"),
+                 Call(Name("min"), Name("numbers")))
+               Assign(
+                 Name("max_number"),
+                 Call(Name("max"), Name("numbers")))
+               Return(
+                 ListComp(
+                   BinOp(
+                     "/",
+                     BinOp("-", Name("number"), Name("min_number")),
+                     BinOp("-", Name("max_number"), Name("min_number"))),
+                   CompFor(
+                     Name("number"),
+                     Name("numbers"),
+                     Bool(true)))))))
+           ~> Call(Name("rescale_to_unit"), list(VS))
+           ~> #observeFixed
+           ...
+       </k>
+endmodule
diff --git a//tmp/audit-work/21-rescale-to-unit/spec-extended-heap.k b//tmp/audit-work/21-rescale-to-unit/spec-extended-heap.k
new file mode 100644
index 0000000000000000000000000000000000000000..0bc137fee7dd6c6d16dacc92cb657a6db2df1d9d
--- /dev/null
+++ b//tmp/audit-work/21-rescale-to-unit/spec-extended-heap.k
@@ -0,0 +1,24 @@
+requires "verification.k"
+
+module SPEC-EXTENDED-HEAP
+  imports VERIFICATION
+
+  claim
+    <k>
+      #runRescale(vCons(1.0, vCons(2.0, .ValSeq)))
+      => ?RESULT:Val
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 => ?FINALSCOPELOC:Int </scopeLoc>
+    <heap> .Map => ?FINALHEAP:Map </heap>
+    <heapLoc> 0 => 3 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
