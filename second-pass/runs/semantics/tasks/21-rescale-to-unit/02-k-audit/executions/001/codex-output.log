+
+def main() -> None:
+    show(
+        "trusted-canonical",
+        load(
+            "canonical_boundary",
+            Path("/tmp/audit-work/21-rescale-to-unit/trusted-canonical.py"),
+        ),
+    )
+    show(
+        "generated-solution",
+        load(
+            "solution_boundary",
+            Path("/tmp/audit-work/21-rescale-to-unit/solution.py"),
+        ),
+    )
+
+
+if __name__ == "__main__":
+    main()
