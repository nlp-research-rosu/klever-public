diff --git a//tmp/audit-work/21-rescale-to-unit/opposite-harness.k b//tmp/audit-work/21-rescale-to-unit/opposite-harness.k
new file mode 100644
index 0000000000000000000000000000000000000000..2a877788c0d1c8f8f0ef86c2372aba48c78669c6
--- /dev/null
+++ b//tmp/audit-work/21-rescale-to-unit/opposite-harness.k
@@ -0,0 +1,14 @@
+requires "verification.k"
+
+module OPPOSITE-HARNESS
+  imports VERIFICATION
+  imports MPY-KRUN
+
+  rule minVF(vCons(1.0, vCons(2.0, .ValSeq))) => 2.0
+  rule maxVF(vCons(1.0, vCons(2.0, .ValSeq))) => 1.0
+
+  syntax Stmt ::= "RunOpposite"
+  rule <k> RunOpposite ~> .Stmts
+        => #runRescale(vCons(1.0, vCons(2.0, .ValSeq)))
