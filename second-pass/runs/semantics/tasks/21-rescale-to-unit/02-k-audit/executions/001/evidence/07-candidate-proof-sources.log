     1	from typing import List
     2	
     3	
     4	def rescale_to_unit(numbers: List[float]) -> List[float]:
     5	    min_number = min(numbers)
     6	    max_number = max(numbers)
     7	    return [
     8	        (number - min_number) / (max_number - min_number)
     9	        for number in numbers
    10	    ]
