FILE_BEGIN /candidate/verification.k
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Opaque extrema are the symbolic counterparts of the concrete float folds.
     7	  // The reference float semantics explicitly reserves these problem-local
     8	  // summaries because Haskell has no useful symbolic IEEE-754 theory.
     9	  syntax Float ::= minVF(ValSeq) [function, total, symbol(minVF), no-evaluators]
    10	                 | maxVF(ValSeq) [function, total, symbol(maxVF), no-evaluators]
    11	
    12	  rule <k> #applyK(toCall(builtinV("min")), (list(VS:ValSeq), .Vals))
    13	        => minVF(VS) ... </k>
    14	       [priority(40)]
    15	  rule <k> #applyK(toCall(builtinV("max")), (list(VS:ValSeq), .Vals))
    16	        => maxVF(VS) ... </k>
    17	       [priority(40)]
    18	
    19	  // A mathematical description of the returned list.  The accumulator form
    20	  // mirrors the reference semantics' expansion of a list comprehension.
    21	  syntax Float ::= asFloat(Val) [function, total, symbol(asFloat)]
    22	  rule asFloat(F:Float) => F
    23	
    24	  syntax Float ::= scaleF(Float, Float, Float) [function, total]
    25	  rule scaleF(F:Float, LO:Float, HI:Float)
    26	    => divF(subF(F, LO), subF(HI, LO))
    27	
    28	  syntax ValSeq ::= scaleAcc(ValSeq, ValSeq, Float, Float) [function, total]
    29	  rule scaleAcc(ACC:ValSeq, .ValSeq, _:Float, _:Float) => ACC
    30	  rule scaleAcc(ACC:ValSeq, vCons(V:Val, REST:ValSeq), LO:Float, HI:Float)
    31	    => scaleAcc(
    32	         valSeqConcat(ACC, vCons(scaleF(asFloat(V), LO, HI), .ValSeq)),
    33	         REST,
    34	         LO,
    35	         HI)
    36	
    37	  syntax Bool ::= allFloats(ValSeq) [function, total]
    38	  rule allFloats(.ValSeq) => true
    39	  rule allFloats(vCons(V:Val, REST:ValSeq))
    40	    => isFloat(V) andBool allFloats(REST)
    41	
    42	  // A sort-safe symbolic generator for arbitrary tails of Float values.  This
    43	  // avoids asking the prover to infer a K subsort from an isFloat predicate.
    44	  syntax FloatSeq ::= ".FloatSeq" | fCons(Float, FloatSeq)
    45	  syntax ValSeq ::= injectFloats(FloatSeq) [function, total]
    46	  rule injectFloats(.FloatSeq) => .ValSeq
    47	  rule injectFloats(fCons(F:Float, REST:FloatSeq))
    48	    => vCons(F, injectFloats(REST))
    49	
    50	  // The reference semantics expands a comprehension into an allocation-heavy
    51	  // accumulator loop.  This observational summary preserves exactly the list
    52	  // value that loop builds while abstracting its unreachable intermediate
    53	  // heap objects.  Its left side is the exact comprehension in solution.mpy.
    54	  rule <k>
    55	         ListComp(
    56	           BinOp(
    57	             "/",
    58	             BinOp("-", Name("number"), Name("min_number")),
    59	             BinOp("-", Name("max_number"), Name("min_number"))),
    60	           CompFor(
    61	             Name("number"),
    62	             Name("numbers"),
    63	             Bool(true)))
    64	         => #alloc(list(scaleAcc(.ValSeq, VS, LO, HI)))
    65	         ...
    66	       </k>
    67	       <env> L:Int </env>
    68	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    69	       <heap>
    70	         ...
    71	         MINH:Int |-> cellV(LO:Float)
    72	         MAXH:Int |-> cellV(HI:Float)
    73	         ...
    74	       </heap>
    75	       requires "numbers" in_keys(M)
    76	        andBool {M["numbers"]}:>Val ==K list(VS)
    77	        andBool "min_number" in_keys(M)
    78	        andBool {M["min_number"]}:>Val ==K cellRef(MINH)
    79	        andBool "max_number" in_keys(M)
    80	        andBool {M["max_number"]}:>Val ==K cellRef(MAXH)
    81	       [priority(40)]
    82	
    83	  // #observe turns the heap reference returned by the Python function into
    84	  // its list value, keeping the functional claim independent of allocation.
    85	  syntax KItem ::= "#observe"
    86	  rule <k> ref(H:Int) ~> #observe => V ... </k>
    87	       <heap> ... H |-> V:Val ... </heap>
    88	
    89	  // Exact translated program followed by a symbolic call.  Keeping this term
    90	  // identical to solution.mpy makes the proof exercise the submitted code.
    91	  syntax KItem ::= #runRescale(ValSeq)
    92	  rule <k> #runRescale(VS:ValSeq)
    93	        => #loadAll(Module(
    94	             ImportFrom("typing", "List")
    95	             FuncDef(
    96	               "rescale_to_unit",
    97	               Params("numbers"),
    98	               CellVars("max_number", "min_number"),
    99	               FreeVars(.ParamNames),
   100	               Assign(
   101	                 Name("min_number"),
   102	                 Call(Name("min"), Name("numbers")))
   103	               Assign(
   104	                 Name("max_number"),
   105	                 Call(Name("max"), Name("numbers")))
   106	               Return(
   107	                 ListComp(
   108	                   BinOp(
   109	                     "/",
   110	                     BinOp("-", Name("number"), Name("min_number")),
   111	                     BinOp("-", Name("max_number"), Name("min_number"))),
   112	                   CompFor(
   113	                     Name("number"),
   114	                     Name("numbers"),
   115	                     Bool(true)))))))
   116	           ~> Call(Name("rescale_to_unit"), list(VS))
   117	           ~> #observe
   118	           ...
   119	       </k>
   120	endmodule
FILE_END /candidate/verification.k
