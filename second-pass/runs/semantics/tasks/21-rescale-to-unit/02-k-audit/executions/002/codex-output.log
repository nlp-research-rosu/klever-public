+             vCons(1.0, vCons(2.0, .ValSeq)),
+             9.0,
+             10.0))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
