+requires "verification-wrong-extrema.k"
+
+module SPEC-WRONG-EXTREMA
+  imports VERIFICATION-WRONG-EXTREMA
+
+  // [1.0, 2.0] satisfies the submitted entry domain. This deliberately false
+  // extrema interpretation makes the claimed result structurally use 9/10,
+  // which denotes [-8.0, -7.0] under the trusted concrete float operations.
+  claim
+    <k>
+      #runRescale(vCons(1.0, vCons(2.0, .ValSeq)))
+      => list(
+           scaleAcc(
+             .ValSeq,
+             vCons(1.0, vCons(2.0, .ValSeq)),
+             9.0,
+             10.0))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINALSCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINALHEAP:Map </heap>
+    <heapLoc> 0 => ?FINALHEAPLOC:Int </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
