+    if word == "four":
+        return 4
+    if word == "five":
+        return 5
+    if word == "six":
+        return 6
+    if word == "seven":
+        return 7
+    if word == "eight":
+        return 8
+    return 9
+
+
+def sort_numbers(numbers: str) -> str:
+    return " ".join(sorted(numbers.split(), key=number_value))
