Module(
  FuncDef("number_value", Params("word"),
    If(Compare(Name("word"), CmpOp("==", Str("zero"))),
      Return(Int(0)),
      )
    If(Compare(Name("word"), CmpOp("==", Str("one"))),
      Return(Int(1)),
      )
    If(Compare(Name("word"), CmpOp("==", Str("two"))),
      Return(Int(2)),
      )
    If(Compare(Name("word"), CmpOp("==", Str("three"))),
      Return(Int(3)),
      )
    If(Compare(Name("word"), CmpOp("==", Str("four"))),
      Return(Int(4)),
      )
    If(Compare(Name("word"), CmpOp("==", Str("five"))),
      Return(Int(5)),
      )
    If(Compare(Name("word"), CmpOp("==", Str("six"))),
      Return(Int(6)),
      )
    If(Compare(Name("word"), CmpOp("==", Str("seven"))),
      Return(Int(7)),
      )
    If(Compare(Name("word"), CmpOp("==", Str("eight"))),
      Return(Int(8)),
      )
    Return(Int(9)))
  FuncDef("sort_numbers", Params("numbers"),
    Return(
      Call(
        Attribute(Str(" "), "join"),
        Call(
          Name("sorted"),
          Call(Attribute(Name("numbers"), "split"), ),
          KwArg("key", Name("number_value"))))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("three one five")),
      CmpOp("==", Str("one three five"))))
  Assert(
    Compare(Call(Name("sort_numbers"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("sort_numbers"), Str("nine zero nine two one")),
      CmpOp("==", Str("zero one two nine nine"))))
  Assert(
    Compare(
      Call(
        Name("sort_numbers"),
        Str("nine eight seven six five four three two one zero")),
      CmpOp(
        "==",
        Str("zero one two three four five six seven eight nine")))))
