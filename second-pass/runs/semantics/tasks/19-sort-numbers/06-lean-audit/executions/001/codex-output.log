--- solution.py ---
     1	def number_value(word: str) -> int:
     2	    if word == "zero":
     3	        return 0
     4	    if word == "one":
     5	        return 1
     6	    if word == "two":
     7	        return 2
     8	    if word == "three":
     9	        return 3
    10	    if word == "four":
    11	        return 4
    12	    if word == "five":
    13	        return 5
    14	    if word == "six":
    15	        return 6
    16	    if word == "seven":
    17	        return 7
    18	    if word == "eight":
    19	        return 8
    20	    return 9
    21	
    22	
    23	def sort_numbers(numbers: str) -> str:
    24	    return " ".join(sorted(numbers.split(), key=number_value))
