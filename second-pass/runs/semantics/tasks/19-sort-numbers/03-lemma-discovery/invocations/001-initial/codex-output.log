assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert [e['source_rule_id'] for e in out['rules']] == [r['source_rule_id'] for r in inv['rules']]
assert len({e['source_rule_id'] for e in out['rules']}) == len(inv['rules']) == 31
for i, entry in enumerate(out['rules']):
    assert list(entry) == ['source_rule_id', 'classification', 'rationale']
    assert entry['classification'] in {'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
    assert entry['rationale'].strip()
    if 'simplification' in inv['rules'][i]['attributes']:
        assert entry['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
counts = Counter(e['classification'] for e in out['rules'])
assert counts == {'DEFINITION': 30, 'OPERATIONAL_RULE': 1}
text = open('/workspace/DISCOVERY.md', encoding='utf-8').read()
assert 'There are no separately proved derived lemmas.' in text
assert 'The domain-lemma set is empty.' in text
print('trust-boundary validation passed:', dict(counts))
