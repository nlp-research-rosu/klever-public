+logger="/audit-output/evidence/run_logged.sh"
+claims=(
+  number-value-zero
+  number-value-one
+  number-value-two
+  number-value-three
+  number-value-four
+  number-value-five
+  number-value-six
+  number-value-seven
+  number-value-eight
+  number-value-nine
+  sort-numbers-symbolic
+)
+
+cd "$scratch" || exit 70
+failures=0
+for claim in "${claims[@]}"; do
+  log="/audit-output/evidence/stage3-kprove-${claim}.log"
