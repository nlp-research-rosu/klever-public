+    if helper_mismatches:
+        print("helper_mismatches=" + json.dumps(helper_mismatches, sort_keys=True))
+    return 1 if mismatches or helper_mismatches else 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
