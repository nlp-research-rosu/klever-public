diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4f14091392a10a375d32a281eed2cbcd578c7d8e
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,32 @@
+requires "reference-semantics/semantics.k"
+
+module MAX-ELEMENT-VERIFICATION
+  imports MPY
+
+  // The exact translated program, named so that the claims have one source of
+  // truth for the implementation they execute.
+  syntax Module ::= "maxElementProgram" [function, total]
+  rule maxElementProgram
+    => Module(
+         FuncDef("max_element", Params("l"),
+           Expr(Str("Return the maximum element of a non-empty list."))
+           Return(Call(Name("max"), Name("l")))))
+
+  // A mathematical embedding of arbitrary integer sequences into Python
+  // lists, plus the corresponding left-fold maximum used by the postcondition.
+  syntax ValSeq ::= intVals(IntSeq)
+
+  syntax Int ::= maxOf(Int, IntSeq) [function, total]
+  rule maxOf(M:Int, .IntSeq)                => M
+  rule maxOf(M:Int, iCons(I:Int, R:IntSeq)) => maxOf(maxInt(M, I), R)
+
+  // Derived iterator equations for the mathematical embedding.  They are
+  // consequences of intVals and MPY-LIST's two iterator equations, stated in
+  // this form so symbolic narrowing happens on IntSeq rather than ValSeq.
+  rule <k> #iterNext(list(intVals(.IntSeq)))
+        => #iterDone ... </k>
+       [priority(40)]
+  rule <k> #iterNext(list(intVals(iCons(I:Int, R:IntSeq))))
+        => #iterYield(I, list(intVals(R))) ... </k>
+       [priority(40)]
+endmodule

