diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b1469b4eedab488da869acb08e02395ef1837a07
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,72 @@
+requires "verification.k"
+
+module MAX-ELEMENT-SPEC
+  imports MAX-ELEMENT-VERIFICATION
+
+  // Inductive fold lemma for the reference semantics' max accumulator.
+  claim
+    <k> #maxAcc(list(intVals(REST:IntSeq)), ACC:Int) ~> CONT:K
+      => maxOf(ACC, REST) ~> CONT </k>
+
+  // Universal contract: for every non-empty finite sequence of integers, the
+  // translated max_element program returns its mathematical maximum.
+  claim
+    <k> #loadAll(maxElementProgram)
+         ~> Call(Name("max_element"),
+                 (list(vCons(FIRST:Int, intVals(REST:IntSeq))), .Exprs))
+      => maxOf(FIRST, REST) </k>
+    <env> 0 </env>
+    <scopes> (0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope)
+          => ?FINALSCOPES:Map </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
+  // Prompt examples, retained as independently closed regression claims.
+  claim
+    <k> #loadAll(maxElementProgram)
+         ~> Call(Name("max_element"),
+                 (list(vCons(1, vCons(2, vCons(3, .ValSeq)))), .Exprs))
+      => 3 </k>
+    <env> 0 </env>
+    <scopes> (0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope)
+          => ?FINALSCOPES:Map </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
+  claim
+    <k> #loadAll(maxElementProgram)
+         ~> Call(Name("max_element"),
+                 (list(vCons(5,
+                       vCons(3,
+                       vCons(0 -Int 5,
+                       vCons(2,
+                       vCons(0 -Int 3,
+                       vCons(3,
+                       vCons(9,
+                       vCons(0,
+                       vCons(123,
+                       vCons(1,
+                       vCons(0 -Int 10, .ValSeq)))))))))))),
+                  .Exprs))
+      => 123 </k>
+    <env> 0 </env>
+    <scopes> (0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope)
+          => ?FINALSCOPES:Map </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..d618fedaefd4e9a381a681050a5b4950c09e1f57
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,31 @@
+requires "reference-semantics/semantics.k"
+
+module MAX-ELEMENT-VERIFICATION
+  imports MPY
+
+  // The exact translated program, named so that the claims have one source of
+  // truth for the implementation they execute.
+  syntax Module ::= "maxElementProgram" [function, total]
+  rule maxElementProgram
+    => Module(
+         FuncDef("max_element", Params("l"),
+           Return(Call(Name("max"), Name("l")))))
+
+  // A mathematical embedding of arbitrary integer sequences into Python
+  // lists, plus the corresponding left-fold maximum used by the postcondition.
+  syntax ValSeq ::= intVals(IntSeq)
+
+  syntax Int ::= maxOf(Int, IntSeq) [function, total]
+  rule maxOf(M:Int, .IntSeq)                => M
+  rule maxOf(M:Int, iCons(I:Int, R:IntSeq)) => maxOf(maxInt(M, I), R)
+
+  // Derived iterator equations for the mathematical embedding.  They are
+  // consequences of intVals and MPY-LIST's two iterator equations, stated in
+  // this form so symbolic narrowing happens on IntSeq rather than ValSeq.
+  rule <k> #iterNext(list(intVals(.IntSeq)))
+        => #iterDone ... </k>
+       [priority(40)]
+  rule <k> #iterNext(list(intVals(iCons(I:Int, R:IntSeq))))
+        => #iterYield(I, list(intVals(R))) ... </k>
+       [priority(40)]
+endmodule

apply patch
patch: completed
/work/verification.k
