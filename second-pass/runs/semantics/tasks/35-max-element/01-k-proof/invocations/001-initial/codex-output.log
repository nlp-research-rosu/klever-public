+requires "verification.k"
+
+module MAX-ELEMENT-SPEC
+  imports MAX-ELEMENT-VERIFICATION
+
+  // Universal contract: for every non-empty finite sequence of integers, the
+  // translated max_element program returns its mathematical maximum.
+  claim
+    <k> #loadAll(maxElementProgram)
+         ~> Call(Name("max_element"),
+                 (list(vCons(FIRST:Int, intVals(REST:IntSeq))), .Exprs))
+      => maxOf(FIRST, REST) </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+             -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
+  // Prompt examples, retained as independently closed regression claims.
+  claim
+    <k> #loadAll(maxElementProgram)
+         ~> Call(Name("max_element"),
+                 (list(vCons(1, vCons(2, vCons(3, .ValSeq)))), .Exprs))
+      => 3 </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+             -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
+  claim
+    <k> #loadAll(maxElementProgram)
+         ~> Call(Name("max_element"),
+                 (list(vCons(5,
+                       vCons(3,
+                       vCons(0 -Int 5,
+                       vCons(2,
+                       vCons(0 -Int 3,
+                       vCons(3,
+                       vCons(9,
+                       vCons(0,
+                       vCons(123,
+                       vCons(1,
+                       vCons(0 -Int 10, .ValSeq)))))))))))),
+                  .Exprs))
+      => 123 </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1))
+             -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..911981fff452efa68e1c9d3b3584e3e0daef0c59
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,24 @@
+requires "reference-semantics/semantics.k"
+
+module MAX-ELEMENT-VERIFICATION
+  imports MPY
+
+  // The exact translated program, named so that the claims have one source of
+  // truth for the implementation they execute.
+  syntax Module ::= "maxElementProgram" [function, total]
+  rule maxElementProgram
+    => Module(
+         FuncDef("max_element", Params("l"),
+           Expr(Str("Return the maximum element of a non-empty list."))
+           Return(Call(Name("max"), Name("l")))))
+
+  // A mathematical embedding of arbitrary integer sequences into Python
+  // lists, plus the corresponding left-fold maximum used by the postcondition.
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  rule intVals(.IntSeq)                => .ValSeq
+  rule intVals(iCons(I:Int, R:IntSeq)) => vCons(I, intVals(R))
+
+  syntax Int ::= maxOf(Int, IntSeq) [function, total]
+  rule maxOf(M:Int, .IntSeq)                => M
+  rule maxOf(M:Int, iCons(I:Int, R:IntSeq)) => maxOf(maxInt(M, I), R)
+endmodule

