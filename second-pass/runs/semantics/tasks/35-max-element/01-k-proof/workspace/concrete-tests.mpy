Module(
  FuncDef("max_element", Params("l"),
    Return(Call(Name("max"), Name("l"))))
  Assert(
    Compare(
      Call(Name("max_element"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("max_element"),
        ListExpr(
          Int(5),
          Int(3),
          UnaryOp("-", Int(5)),
          Int(2),
          UnaryOp("-", Int(3)),
          Int(3),
          Int(9),
          Int(0),
          Int(123),
          Int(1),
          UnaryOp("-", Int(10)))),
      CmpOp("==", Int(123))))
  Assert(
    Compare(
      Call(Name("max_element"), ListExpr(UnaryOp("-", Int(7)))),
      CmpOp("==", UnaryOp("-", Int(7)))))
  Assert(
    Compare(
      Call(
        Name("max_element"),
        ListExpr(
          UnaryOp("-", Int(9)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(14)),
          UnaryOp("-", Int(2)))),
      CmpOp("==", UnaryOp("-", Int(2)))))
  Assert(
    Compare(
      Call(Name("max_element"), ListExpr(Int(4), Int(4), Int(4))),
      CmpOp("==", Int(4)))))
