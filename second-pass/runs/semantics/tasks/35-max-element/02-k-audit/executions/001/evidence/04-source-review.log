===== /candidate/verification.k
     1	requires "reference-semantics/semantics.k"
     2	
     3	module MAX-ELEMENT-VERIFICATION
     4	  imports MPY
     5	
     6	  // The exact translated program, named so that the claims have one source of
     7	  // truth for the implementation they execute.
     8	  syntax Module ::= "maxElementProgram" [function, total]
     9	  rule maxElementProgram
    10	    => Module(
    11	         FuncDef("max_element", Params("l"),
    12	           Return(Call(Name("max"), Name("l")))))
    13	
    14	  // A proof-side encoding of an arbitrary finite integer sequence, used as the
    15	  // tail of a Python list, plus its mathematical left-fold maximum.
    16	  syntax ValSeq ::= intVals(IntSeq)
    17	
    18	  syntax Int ::= maxOf(Int, IntSeq) [function, total]
    19	  rule maxOf(M:Int, .IntSeq)                => M
    20	  rule maxOf(M:Int, iCons(I:Int, R:IntSeq)) => maxOf(maxInt(M, I), R)
    21	
    22	  // These equations give intVals exactly the observable iteration behavior of
    23	  // the corresponding vCons chain.  Their form lets symbolic narrowing happen
    24	  // on IntSeq rather than on the untyped ValSeq.
    25	  rule <k> #iterNext(list(intVals(.IntSeq)))
    26	        => #iterDone ... </k>
    27	       [priority(40)]
    28	  rule <k> #iterNext(list(intVals(iCons(I:Int, R:IntSeq))))
    29	        => #iterYield(I, list(intVals(R))) ... </k>
    30	       [priority(40)]
    31	endmodule
