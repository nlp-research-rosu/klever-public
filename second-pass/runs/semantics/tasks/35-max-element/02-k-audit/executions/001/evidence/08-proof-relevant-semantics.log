spec.k-21-          => ?FINALSCOPES:Map </scopes>
spec.k-22-    <scopeLoc> 1 </scopeLoc>
spec.k-23-    <heap> .Map </heap>
spec.k-24-    <heapLoc> 0 </heapLoc>
spec.k-25-    <stack> .List </stack>
spec.k-26-    <ret> noRet </ret>
spec.k-27-    <exc> NoExc </exc>
spec.k-28-
spec.k-29-  // Prompt examples, retained as independently closed regression claims.
spec.k-30-  claim
spec.k-31-    <k> #loadAll(maxElementProgram)
spec.k-32-         ~> Call(Name("max_element"),
spec.k:33:                 (list(vCons(1, vCons(2, vCons(3, .ValSeq)))), .Exprs))
