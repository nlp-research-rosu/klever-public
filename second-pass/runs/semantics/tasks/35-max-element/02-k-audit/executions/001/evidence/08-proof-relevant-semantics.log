reference-semantics/semantics/dict.k-31-        => V ~> #dictVal(KV, REST, KS, VS) ... </k>
reference-semantics/semantics/dict.k-32-  rule <k> VV:Val ~> #dictVal(KV:Val, REST:Entries, KS:ValSeq, VS:ValSeq)
reference-semantics/semantics/dict.k-33-        => #dictAcc(REST, dPutK(KS, KV), dPutV(KS, VS, KV, VV)) ... </k>
reference-semantics/semantics/dict.k-34-
reference-semantics/semantics/dict.k-35-  // insert-with-dedup helpers (concrete Val key equality via ==K). [total] so buildFold over a dict is
reference-semantics/semantics/dict.k-36-  // total (its #Ceil is #Top) — needed when a symbolic proof carries a built dict as a config value.
reference-semantics/semantics/dict.k-37-  syntax Bool ::= dHasKey(ValSeq, Val) [function, total]
reference-semantics/semantics/dict.k-38-  rule dHasKey(.ValSeq, _:Val)                => false
reference-semantics/semantics/dict.k:39:  rule dHasKey(vCons(A:Val, _:ValSeq), K:Val) => true          requires A ==K K
reference-semantics/semantics/dict.k:40:  rule dHasKey(vCons(A:Val, R:ValSeq), K:Val) => dHasKey(R, K) requires notBool (A ==K K)
reference-semantics/semantics/dict.k-41-
reference-semantics/semantics/dict.k-42-  // dPutK: KS unchanged if K already present, else append K (keep-first-position).
reference-semantics/semantics/dict.k-43-  syntax ValSeq ::= dPutK(ValSeq, Val) [function, total]
reference-semantics/semantics/dict.k-44-  rule dPutK(KS:ValSeq, K:Val) => KS                                  requires dHasKey(KS, K)
reference-semantics/semantics/dict.k:45:  rule dPutK(KS:ValSeq, K:Val) => valSeqConcat(KS, vCons(K, .ValSeq)) requires notBool dHasKey(KS, K)
reference-semantics/semantics/dict.k-46-
reference-semantics/semantics/dict.k-47-  // dPutV: parallel to KS — set the value at K's position if present, else append V at the end. The
reference-semantics/semantics/dict.k-48-  // [owise] catch-all covers the degenerate mismatched-length case (never reached for a well-formed dict).
reference-semantics/semantics/dict.k-49-  syntax ValSeq ::= dPutV(ValSeq, ValSeq, Val, Val) [function, total]
reference-semantics/semantics/dict.k:50:  rule dPutV(vCons(A:Val, _:ValSeq), vCons(_:Val, VR:ValSeq), K:Val, V:Val)  => vCons(V, VR)
reference-semantics/semantics/dict.k-51-       requires A ==K K
reference-semantics/semantics/dict.k:52:  rule dPutV(vCons(A:Val, KR:ValSeq), vCons(B:Val, VR:ValSeq), K:Val, V:Val) => vCons(B, dPutV(KR, VR, K, V))
reference-semantics/semantics/dict.k-53-       requires notBool (A ==K K)
reference-semantics/semantics/dict.k:54:  rule dPutV(_KS:ValSeq, VS:ValSeq, _K:Val, V:Val) => valSeqConcat(VS, vCons(V, .ValSeq)) [owise]
reference-semantics/semantics/dict.k-55-
reference-semantics/semantics/dict.k-56-  // ==== dict methods ========================================================
reference-semantics/semantics/dict.k-57-  // d.keys() -> a FRESH list object of the ordered keys (k-cell: it allocates).
reference-semantics/semantics/dict.k-58-  rule <k> #applyK(toCall(boundMethodV(dictV(KS:ValSeq, _:ValSeq), "keys")), .Vals)
reference-semantics/semantics/dict.k-59-        => #alloc(list(KS)) ... </k>
reference-semantics/semantics/dict.k-60-       [priority(40)]
reference-semantics/semantics/dict.k-61-
