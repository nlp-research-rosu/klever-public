reference-semantics/semantics/core.k-223-  syntax Int ::= vsLen(ValSeq) [function, total]
reference-semantics/semantics/core.k-224-  rule vsLen(.ValSeq)                => 0
reference-semantics/semantics/core.k:225:  rule vsLen(vCons(_:Val, S:ValSeq)) => 1 +Int vsLen(S)
reference-semantics/semantics/core.k-226-
reference-semantics/semantics/core.k-227-  syntax Int ::= isLen(IntSeq) [function, total]
reference-semantics/semantics/core.k-228-  rule isLen(.IntSeq)                => 0
reference-semantics/semantics/core.k:229:  rule isLen(iCons(_:Int, S:IntSeq)) => 1 +Int isLen(S)
reference-semantics/semantics/core.k-230-
reference-semantics/semantics/core.k-231-  // in-bounds positional write (list subscript-assign); OOB leaves the seq unchanged
reference-semantics/semantics/core.k-232-  // (valid programs write in-bounds — mirrors valSeqAt's total-but-underspecified stance)
reference-semantics/semantics/core.k-233-  syntax ValSeq ::= setVSAt(ValSeq, Int, Val) [function, total]
reference-semantics/semantics/core.k-234-  rule setVSAt(.ValSeq, _:Int, _:Val)               => .ValSeq
