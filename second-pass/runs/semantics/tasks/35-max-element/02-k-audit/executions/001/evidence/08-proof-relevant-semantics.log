reference-semantics/semantics/sort.k-36-  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), .Vals))
reference-semantics/semantics/sort.k-37-        => #alloc(list(sortVS(VS))) ... </k>
reference-semantics/semantics/sort.k-38-
reference-semantics/semantics/sort.k-39-  // mutator: xs.sort() — the in-place heap write over the same trusted sortVS
