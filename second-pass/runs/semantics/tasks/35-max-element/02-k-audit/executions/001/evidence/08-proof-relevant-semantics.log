reference-semantics/semantics/list.k-38-                | deepEqV(Val, Val, Map)        [function]
reference-semantics/semantics/list.k-39-  rule deepEqVS(.ValSeq, .ValSeq, _:Map)                   => true
reference-semantics/semantics/list.k:40:  rule deepEqVS(.ValSeq, vCons(_:Val, _:ValSeq), _:Map)    => false
reference-semantics/semantics/list.k:41:  rule deepEqVS(vCons(_:Val, _:ValSeq), .ValSeq, _:Map)    => false
