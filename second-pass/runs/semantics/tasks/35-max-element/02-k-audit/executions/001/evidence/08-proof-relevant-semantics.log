reference-semantics/semantics/sort.k-60-
reference-semantics/semantics/sort.k-61-  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
reference-semantics/semantics/sort.k-62-        => #alloc(list(sortKeyVS(VS, KV))) ... </k>
reference-semantics/semantics/sort.k-63-  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
