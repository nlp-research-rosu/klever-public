reference-semantics/semantics/controls.k-54-  rule <k> #branch(false, _:Stmts, E:Stmts) => E ... </k>
reference-semantics/semantics/controls.k-55-
reference-semantics/semantics/controls.k-56-  // ==== IfExp: ternary T if C else E ========================================
reference-semantics/semantics/controls.k-57-  rule <k> IfExp(V:Val, T:Expr, _:Expr) => T ... </k>
reference-semantics/semantics/controls.k-58-       requires truthy(V)
reference-semantics/semantics/controls.k-59-  rule <k> IfExp(V:Val, _:Expr, E:Expr) => E ... </k>
reference-semantics/semantics/controls.k-60-       requires notBool truthy(V)
reference-semantics/semantics/controls.k-61-
reference-semantics/semantics/controls.k:62:  // ==== For: one loop, in-cell continuation, over #iterNext =================
reference-semantics/semantics/controls.k-63-  // (the iterable is evaluated once, by strictness; the protocol stays rewrites —
reference-semantics/semantics/controls.k-64-  // circularities anchor on #loop and narrowing substitutes the structure)
reference-semantics/semantics/controls.k-65-  syntax KItem ::= #loop(Val, Expr, Stmts) | #loopStep(Expr, Stmts)
reference-semantics/semantics/controls.k-66-                 | #while(Expr, Stmts) | #whileCond(Expr, Stmts)
reference-semantics/semantics/controls.k-67-                 | #loopLbl(K) | "#cont" | "#brk"
reference-semantics/semantics/controls.k-68-
reference-semantics/semantics/controls.k-69-  rule <k> For(T:Expr, OBJ:Val, B:Stmts) => #loop(OBJ, T, B) ... </k>
reference-semantics/semantics/controls.k-70-
reference-semantics/semantics/controls.k:71:  rule <k> #loop(IT:Iterable, T:Expr, B:Stmts) => #iterNext(IT) ~> #loopStep(T, B) ... </k>
reference-semantics/semantics/controls.k:72:  rule <k> #iterDone ~> #loopStep(_:Expr, _:Stmts) => .K ... </k>
reference-semantics/semantics/controls.k:73:  rule <k> #iterYield(V:Val, REST:Iterable) ~> #loopStep(T:Expr, B:Stmts)
reference-semantics/semantics/controls.k-74-        => #bindTgt(T, V) ~> B ~> #loopLbl(#loop(REST, T, B)) ... </k>
reference-semantics/semantics/controls.k-75-
reference-semantics/semantics/controls.k-76-  // ==== While ==============================================================
reference-semantics/semantics/controls.k-77-  rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>
reference-semantics/semantics/controls.k-78-  rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>
reference-semantics/semantics/controls.k-79-  rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>
reference-semantics/semantics/controls.k-80-       requires truthy(V)
reference-semantics/semantics/controls.k-81-  rule <k> V:Val ~> #whileCond(_C:Expr, _B:Stmts) => .K ... </k>
