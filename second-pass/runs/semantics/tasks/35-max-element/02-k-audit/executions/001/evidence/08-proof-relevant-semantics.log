verification.k-4-  imports MPY
verification.k-5-
verification.k-6-  // The exact translated program, named so that the claims have one source of
verification.k-7-  // truth for the implementation they execute.
verification.k-8-  syntax Module ::= "maxElementProgram" [function, total]
verification.k-9-  rule maxElementProgram
verification.k-10-    => Module(
verification.k-11-         FuncDef("max_element", Params("l"),
verification.k:12:           Return(Call(Name("max"), Name("l")))))
verification.k-13-
verification.k-14-  // A proof-side encoding of an arbitrary finite integer sequence, used as the
verification.k-15-  // tail of a Python list, plus its mathematical left-fold maximum.
verification.k:16:  syntax ValSeq ::= intVals(IntSeq)
verification.k-17-
verification.k-18-  syntax Int ::= maxOf(Int, IntSeq) [function, total]
verification.k-19-  rule maxOf(M:Int, .IntSeq)                => M
verification.k:20:  rule maxOf(M:Int, iCons(I:Int, R:IntSeq)) => maxOf(maxInt(M, I), R)
verification.k-21-
verification.k:22:  // These equations give intVals exactly the observable iteration behavior of
verification.k:23:  // the corresponding vCons chain.  Their form lets symbolic narrowing happen
verification.k-24-  // on IntSeq rather than on the untyped ValSeq.
verification.k:25:  rule <k> #iterNext(list(intVals(.IntSeq)))
verification.k:26:        => #iterDone ... </k>
verification.k-27-       [priority(40)]
verification.k:28:  rule <k> #iterNext(list(intVals(iCons(I:Int, R:IntSeq))))
verification.k:29:        => #iterYield(I, list(intVals(R))) ... </k>
verification.k-30-       [priority(40)]
verification.k-31-endmodule
