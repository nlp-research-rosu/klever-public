reference-semantics/semantics/core.k-214-  rule appendVal(.Vals, V:Val)              => V , .Vals
reference-semantics/semantics/core.k-215-  rule appendVal((V0:Val, VS:Vals), V:Val)  => V0 , appendVal(VS, V)
reference-semantics/semantics/core.k-216-
reference-semantics/semantics/core.k-217-  syntax ValSeq ::= vals2valSeq(Vals) [function, total]
reference-semantics/semantics/core.k-218-  rule vals2valSeq(.Vals)            => .ValSeq
reference-semantics/semantics/core.k:219:  rule vals2valSeq((V:Val, VS:Vals)) => vCons(V, vals2valSeq(VS))
reference-semantics/semantics/core.k-220-
reference-semantics/semantics/core.k-221-  // ==== shared sequence length (len / summaries across many modules) ========
