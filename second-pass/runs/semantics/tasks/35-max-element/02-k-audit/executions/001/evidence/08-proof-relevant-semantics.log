reference-semantics/semantics/list.k-47-  rule deepEqV(A:Val, ref(H:Int), HP:Map) => deepEqV(A, {HP[H]}:>Val, HP)
reference-semantics/semantics/list.k-48-       requires notBool isRefV(A) andBool H in_keys(HP)
reference-semantics/semantics/list.k-49-  rule deepEqV(list(A:ValSeq), list(B:ValSeq), HP:Map) => deepEqVS(A, B, HP)
reference-semantics/semantics/list.k-50-  rule deepEqV(A:Val, B:Val, _:Map) => A ==K B [owise]
reference-semantics/semantics/list.k-51-
reference-semantics/semantics/list.k-52-  // ==== mutator: xs.append(v) — an in-place heap write ======================
reference-semantics/semantics/list.k-53-  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), "append")), (V:Val, .Vals)) => noneV ... </k>
reference-semantics/semantics/list.k:54:       <heap> ... H |-> list(VS:ValSeq => valSeqConcat(VS, vCons(V, .ValSeq))) ... </heap>
reference-semantics/semantics/list.k-55-       [priority(40)]
reference-semantics/semantics/list.k-56-
