spec.k-3-module MAX-ELEMENT-SPEC
spec.k-4-  imports MAX-ELEMENT-VERIFICATION
spec.k-5-
spec.k-6-  // Inductive fold lemma for the reference semantics' max accumulator.
spec.k-7-  claim
spec.k:8:    <k> #maxAcc(list(intVals(REST:IntSeq)), ACC:Int) ~> CONT:K
spec.k-9-      => maxOf(ACC, REST) ~> CONT </k>
spec.k-10-
spec.k-11-  // Universal contract: for every non-empty finite sequence of integers, the
spec.k-12-  // translated max_element program returns its mathematical maximum.
spec.k-13-  claim
spec.k-14-    <k> #loadAll(maxElementProgram)
spec.k-15-         ~> Call(Name("max_element"),
spec.k:16:                 (list(vCons(FIRST:Int, intVals(REST:IntSeq))), .Exprs))
spec.k-17-      => maxOf(FIRST, REST) </k>
