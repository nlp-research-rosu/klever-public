reference-semantics/semantics/float.k-235-  rule <k> I:Int ~> #mathSqrt => sqrtF(intToF(I)) ... </k>
reference-semantics/semantics/float.k-236-
reference-semantics/semantics/float.k-237-  // ---- min / max over a FLOAT list — FLOAT branch of the shared #minCont0/#maxCont0 folds (which
reference-semantics/semantics/float.k-238-  // seed/step with `requires isInt(V)`, so they are STUCK on floats). These add the `requires
reference-semantics/semantics/float.k-239-  // isFloat(V)` seed + a Float-accumulator fold via K's minFloat/maxFloat — concrete for krun. A proof
reference-semantics/semantics/float.k-240-  // over a SYMBOLIC float list intercepts min/max problem-locally to an opaque minVF/maxVF (at
reference-semantics/semantics/float.k-241-  // #applyK, priority 40, in its verification.k) BEFORE #minAcc0, so this fold is krun-only. Additive:
reference-semantics/semantics/float.k-242-  // the isFloat guard is disjoint from the existing isInt one.
reference-semantics/semantics/float.k:243:  syntax KItem ::= #maxAccF(Iterable, Float) | #maxContF(Float)
reference-semantics/semantics/float.k:244:  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxCont0 => #maxAccF(R, {V}:>Float) ... </k> requires isFloat(V)
reference-semantics/semantics/float.k:245:  rule <k> #maxAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #maxContF(M) ... </k>
reference-semantics/semantics/float.k:246:  rule <k> #iterDone ~> #maxContF(M:Float) => M ... </k>
reference-semantics/semantics/float.k:247:  rule <k> #iterYield(V:Val, R:Iterable) ~> #maxContF(M:Float) => #maxAccF(R, maxFloat(M, {V}:>Float)) ... </k>
reference-semantics/semantics/float.k-248-       requires isFloat(V)
reference-semantics/semantics/float.k-249-
reference-semantics/semantics/float.k-250-  syntax KItem ::= #minAccF(Iterable, Float) | #minContF(Float)
reference-semantics/semantics/float.k:251:  rule <k> #iterYield(V:Val, R:Iterable) ~> #minCont0 => #minAccF(R, {V}:>Float) ... </k> requires isFloat(V)
reference-semantics/semantics/float.k:252:  rule <k> #minAccF(IT:Iterable, M:Float) => #iterNext(IT) ~> #minContF(M) ... </k>
reference-semantics/semantics/float.k:253:  rule <k> #iterDone ~> #minContF(M:Float) => M ... </k>
reference-semantics/semantics/float.k:254:  rule <k> #iterYield(V:Val, R:Iterable) ~> #minContF(M:Float) => #minAccF(R, minFloat(M, {V}:>Float)) ... </k>
reference-semantics/semantics/float.k-255-       requires isFloat(V)
reference-semantics/semantics/float.k-256-
reference-semantics/semantics/float.k-257-  // ---- sum over a float list (krun; mirrors the min/max float paths). The Int-only shared
reference-semantics/semantics/float.k-258-  // #sumCont sticks on a Float yield; switch to a Float-headed fold via addF (concrete twin).
reference-semantics/semantics/float.k-259-  // The switch guard carries the SYNTACTIC negation of the Int rule's guard so a symbolic proof
reference-semantics/semantics/float.k-260-  // with isInt(V) in its path condition refutes this branch without sort reasoning.
reference-semantics/semantics/float.k-261-  syntax KItem ::= #sumAccF(Iterable, Float) | #sumContF(Float)
reference-semantics/semantics/float.k:262:  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumCont(ACC:Int)
reference-semantics/semantics/float.k-263-        => #sumAccF(R, addF(intToF(ACC), {V}:>Float)) ... </k>
reference-semantics/semantics/float.k-264-       requires isFloat(V) andBool notBool (isInt(V) orBool isBool(V))
reference-semantics/semantics/float.k:265:  rule <k> #sumAccF(IT:Iterable, ACC:Float) => #iterNext(IT) ~> #sumContF(ACC) ... </k>
reference-semantics/semantics/float.k:266:  rule <k> #iterDone ~> #sumContF(ACC:Float) => ACC ... </k>
reference-semantics/semantics/float.k:267:  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
reference-semantics/semantics/float.k-268-        => #sumAccF(R, addF(ACC, {V}:>Float)) ... </k>
reference-semantics/semantics/float.k-269-       requires isFloat(V)
reference-semantics/semantics/float.k:270:  rule <k> #iterYield(V:Val, R:Iterable) ~> #sumContF(ACC:Float)
reference-semantics/semantics/float.k-271-        => #sumAccF(R, addF(ACC, intToF(intOf(V)))) ... </k>
reference-semantics/semantics/float.k-272-       requires isInt(V) orBool isBool(V)
reference-semantics/semantics/float.k-273-endmodule
