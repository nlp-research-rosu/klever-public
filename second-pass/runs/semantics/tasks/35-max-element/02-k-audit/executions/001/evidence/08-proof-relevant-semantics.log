reference-semantics/semantics/set.k-5-
reference-semantics/semantics/set.k-6-  // a set value, carried as its distinct codes in first-seen order (order is irrelevant
reference-semantics/semantics/set.k-7-  // to membership/cardinality — the two observations sets support here).
reference-semantics/semantics/set.k-8-  syntax Val ::= setV(IntSeq)
reference-semantics/semantics/set.k-9-
reference-semantics/semantics/set.k-10-  // membership of a code in the accumulated distinct-code sequence
reference-semantics/semantics/set.k-11-  syntax Bool ::= codeIn(Int, IntSeq) [function, total]
reference-semantics/semantics/set.k-12-  rule codeIn(_:Int, .IntSeq)                => false
reference-semantics/semantics/set.k:13:  rule codeIn(C:Int, iCons(H:Int, T:IntSeq)) => C ==Int H orBool codeIn(C, T)
reference-semantics/semantics/set.k-14-
reference-semantics/semantics/set.k-15-  // the distinct codes of CS (insert-if-absent fold, first-seen order)
reference-semantics/semantics/set.k-16-  syntax IntSeq ::= dedupCodes(IntSeq)         [function, total]
reference-semantics/semantics/set.k-17-                  | dedupFrom(IntSeq, IntSeq)  [function, total]
reference-semantics/semantics/set.k-18-  rule dedupCodes(CS:IntSeq) => dedupFrom(CS, .IntSeq)
reference-semantics/semantics/set.k-19-  rule dedupFrom(.IntSeq, ACC:IntSeq) => ACC
reference-semantics/semantics/set.k:20:  rule dedupFrom(iCons(C:Int, S:IntSeq), ACC:IntSeq) => dedupFrom(S, ACC)
reference-semantics/semantics/set.k-21-       requires codeIn(C, ACC)
reference-semantics/semantics/set.k:22:  rule dedupFrom(iCons(C:Int, S:IntSeq), ACC:IntSeq) => dedupFrom(S, snocCode(ACC, C))
reference-semantics/semantics/set.k-23-       requires notBool codeIn(C, ACC)
reference-semantics/semantics/set.k-24-
reference-semantics/semantics/set.k-25-  syntax IntSeq ::= snocCode(IntSeq, Int) [function, total]
reference-semantics/semantics/set.k:26:  rule snocCode(.IntSeq, C:Int)                => iCons(C, .IntSeq)
reference-semantics/semantics/set.k:27:  rule snocCode(iCons(H:Int, T:IntSeq), C:Int) => iCons(H, snocCode(T, C))
reference-semantics/semantics/set.k-28-
reference-semantics/semantics/set.k-29-  // ==== set equality: two sets are equal iff mutually subsuming ==============
reference-semantics/semantics/set.k-30-  // subsetCodes(A, B) — every code of A occurs in B (duplicates in A are harmless).
reference-semantics/semantics/set.k-31-  syntax Bool ::= subsetCodes(IntSeq, IntSeq) [function, total]
reference-semantics/semantics/set.k-32-  rule subsetCodes(.IntSeq, _:IntSeq)                => true
reference-semantics/semantics/set.k:33:  rule subsetCodes(iCons(C:Int, S:IntSeq), B:IntSeq) => codeIn(C, B) andBool subsetCodes(S, B)
reference-semantics/semantics/set.k-34-
reference-semantics/semantics/set.k-35-  syntax Bool ::= sameSet(IntSeq, IntSeq) [function, total]
reference-semantics/semantics/set.k-36-  rule sameSet(A:IntSeq, B:IntSeq) => subsetCodes(A, B) andBool subsetCodes(B, A)
reference-semantics/semantics/set.k-37-
reference-semantics/semantics/set.k-38-  // set == set  (the only comparison sets support here)
reference-semantics/semantics/set.k-39-  rule applyCmp("==", setV(A:IntSeq), setV(B:IntSeq)) => sameSet(A, B)
reference-semantics/semantics/set.k-40-endmodule
