diff --git a//tmp/audit-work/work/spec-labeled.k b//tmp/audit-work/work/spec-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..e6fa2eceefd6ca4d9d39461118c7b6f62ee6662f
--- /dev/null
+++ b//tmp/audit-work/work/spec-labeled.k
@@ -0,0 +1,68 @@
+requires "verification.k"
+
+module MAX-ELEMENT-SPEC-LABELED
+  imports MAX-ELEMENT-VERIFICATION
+
+  claim [fold]:
+    <k> #maxAcc(list(intVals(REST:IntSeq)), ACC:Int) ~> CONT:K
+      => maxOf(ACC, REST) ~> CONT </k>
+
+  claim [universal]:
+    <k> #loadAll(maxElementProgram)
+         ~> Call(Name("max_element"),
+                 (list(vCons(FIRST:Int, intVals(REST:IntSeq))), .Exprs))
+      => maxOf(FIRST, REST) </k>
+    <env> 0 </env>
+    <scopes> (0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope)
+          => ?FINALSCOPES:Map </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
+  claim [example-one]:
+    <k> #loadAll(maxElementProgram)
+         ~> Call(Name("max_element"),
+                 (list(vCons(1, vCons(2, vCons(3, .ValSeq)))), .Exprs))
+      => 3 </k>
+    <env> 0 </env>
+    <scopes> (0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope)
+          => ?FINALSCOPES:Map </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
+  claim [example-two]:
+    <k> #loadAll(maxElementProgram)
+         ~> Call(Name("max_element"),
+                 (list(vCons(5,
+                       vCons(3,
+                       vCons(0 -Int 5,
+                       vCons(2,
+                       vCons(0 -Int 3,
+                       vCons(3,
+                       vCons(9,
+                       vCons(0,
+                       vCons(123,
+                       vCons(1,
+                       vCons(0 -Int 10, .ValSeq)))))))))))),
+                  .Exprs))
+      => 123 </k>
+    <env> 0 </env>
+    <scopes> (0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope)
+          => ?FINALSCOPES:Map </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
diff --git a//tmp/audit-work/work/verification-body-mutated.k b//tmp/audit-work/work/verification-body-mutated.k
new file mode 100644
index 0000000000000000000000000000000000000000..14d3a465351c31fe0ba56aca0efa50bc8f7dab09
--- /dev/null
+++ b//tmp/audit-work/work/verification-body-mutated.k
@@ -0,0 +1,24 @@
+requires "reference-semantics/semantics.k"
+
+module MAX-ELEMENT-VERIFICATION-BODY-MUTATED
+  imports MPY
+
+  syntax Module ::= "maxElementProgramMutated" [function, total]
+  rule maxElementProgramMutated
+    => Module(
+         FuncDef("max_element", Params("l"),
+           Return(Int(0))))
+
+  syntax ValSeq ::= intValsMutated(IntSeq)
+
+  syntax Int ::= maxOfMutated(Int, IntSeq) [function, total]
+  rule maxOfMutated(M:Int, .IntSeq)                => M
+  rule maxOfMutated(M:Int, iCons(I:Int, R:IntSeq)) => maxOfMutated(maxInt(M, I), R)
+
+  rule <k> #iterNext(list(intValsMutated(.IntSeq)))
+        => #iterDone ... </k>
+       [priority(40)]
+  rule <k> #iterNext(list(intValsMutated(iCons(I:Int, R:IntSeq))))
+        => #iterYield(I, list(intValsMutated(R))) ... </k>
+       [priority(40)]
+endmodule
