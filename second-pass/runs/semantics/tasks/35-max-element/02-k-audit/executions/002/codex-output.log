new file mode 100644
index 0000000000000000000000000000000000000000..a7cbad00733ad9801f113d9154eb93b05826fb1c
--- /dev/null
+++ b/evidence/nonvacuity.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+set -u
+
+run() {
