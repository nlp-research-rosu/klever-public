+         ~> Call(Name("max_element"),
+                 (list(vCons(5,
+                       vCons(3,
+                       vCons(0 -Int 5,
+                       vCons(2,
+                       vCons(0 -Int 3,
+                       vCons(3,
+                       vCons(9,
+                       vCons(0,
+                       vCons(123,
+                       vCons(1,
+                       vCons(0 -Int 10, .ValSeq)))))))))))),
+                  .Exprs))
+      => 123 </k>
+    <env> 0 </env>
+    <scopes> (0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope)
+          => ?FINALSCOPES:Map </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+endmodule
