diff --git a//tmp/audit-work/work/spec-labeled.k b//tmp/audit-work/work/spec-labeled.k
new file mode 100644
index 0000000000000000000000000000000000000000..e6fa2eceefd6ca4d9d39461118c7b6f62ee6662f
--- /dev/null
+++ b//tmp/audit-work/work/spec-labeled.k
@@ -0,0 +1,68 @@
+requires "verification.k"
+
+module MAX-ELEMENT-SPEC-LABELED
+  imports MAX-ELEMENT-VERIFICATION
+
+  claim [fold]:
+    <k> #maxAcc(list(intVals(REST:IntSeq)), ACC:Int) ~> CONT:K
+      => maxOf(ACC, REST) ~> CONT </k>
+
+  claim [universal]:
+    <k> #loadAll(maxElementProgram)
+         ~> Call(Name("max_element"),
+                 (list(vCons(FIRST:Int, intVals(REST:IntSeq))), .Exprs))
+      => maxOf(FIRST, REST) </k>
+    <env> 0 </env>
+    <scopes> (0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope)
+          => ?FINALSCOPES:Map </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+
+  claim [example-one]:
+    <k> #loadAll(maxElementProgram)
+         ~> Call(Name("max_element"),
