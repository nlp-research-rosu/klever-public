+  while IFS= read -r -d '' rel; do
+    hash=$(sha256sum "$tree/$rel" | cut -d' ' -f1)
+    printf '%s  %s\n' "$hash" "$rel"
+  done < <(find "$tree" -type f -printf '%P\0' | sort -z)
+done

