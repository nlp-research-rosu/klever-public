+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+cd /tmp/audit-work/work || exit 2
+run python3 py2mpy.py solution.py
+run python3 py2mpy.py solution.py
+python3 py2mpy.py solution.py > regenerated-solution.mpy
