+run kprove representation-gap.k \
+  --definition verification-kompiled \
+  --spec-module REPRESENTATION-GAP \
+  --dry-run
+run kprove representation-gap.k \
+  --definition verification-kompiled \
+  --spec-module REPRESENTATION-GAP \
+  --claims REPRESENTATION-GAP.base-connection
+run kprove representation-gap.k \
