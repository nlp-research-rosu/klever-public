+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n' "$status"
+  return "$status"
+}
+
+printf 'Stage 1 independent provenance and integrity checks\n'
+run sha256sum \
+  /audit-campaign-lock.json \
+  /reference/canonical.py \
+  /reference/prompt.py \
+  /reference/py2mpy.py \
+  /candidate/prompt.py \
