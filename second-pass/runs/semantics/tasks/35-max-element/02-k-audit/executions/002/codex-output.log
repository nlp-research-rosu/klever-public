+  while IFS= read -r -d '' rel; do
+    hash=$(sha256sum "$tree/$rel" | cut -d' ' -f1)
+    printf '%s  %s\n' "$hash" "$rel"
+  done < <(find "$tree" -type f -printf '%P\0' | sort -z)
+done

exec
/bin/bash -lc 'set -o pipefail
bash /audit-output/evidence/clean_rebuild.sh 2>&1 | tee /audit-output/evidence/clean-rebuild.log
status=${PIPESTATUS[0]}
printf '"'\\nclean_rebuild.sh overall exit %d\\n' \""'$status" | tee -a /audit-output/evidence/clean-rebuild.log
exit "$status"' in /audit-output
