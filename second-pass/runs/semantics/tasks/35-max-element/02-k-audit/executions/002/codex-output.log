index 0000000000000000000000000000000000000000..58d2365736d59e418f98d200d4fddcb0db4cab05
--- /dev/null
+++ b/evidence/individual_claims.sh
@@ -0,0 +1,37 @@
+#!/usr/bin/env bash
+set -u
+
+run() {
+  printf '\n$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
