+      => 123 </k>
+    <env> 0 </env>
+    <scopes> (0 |-> scope(.Map, parent(-1))
+              -1 |-> builtinsScope)
+          => ?FINALSCOPES:Map </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
