+requires "/tmp/audit-work/verification.k"
+
+module REVIEWER-BODY-PINNING-SPEC
+  imports PAIRS-VERIFICATION
+
+  // The RHS is copied constructor-for-constructor from the trusted regeneration
+  // of solution.mpy. This claim checks the proof-local alias that every entry
+  // theorem actually invokes.
+  claim [pairs-body-is-submitted-body]:
+    <k>
+      pairsBody
+      =>
+      Assign(Name("seen"), ListExpr(.Exprs))
+      Assign(Name("value"), Int(0))
+      For(Name("value"), Name("l"),
+        If(Compare(UnaryOp("-", Name("value")), CmpOp("in", Name("seen"))),
+          Return(Bool(true)),
+          .Stmts)
+        Expr(Call(Attribute(Name("seen"), "append"),
+                  (Name("value"), .Exprs))))
+      Return(Bool(false))
+    </k>
+endmodule
diff --git a/evidence/concrete_semantics_tests.py b/evidence/concrete_semantics_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..5f565cda5aa8452c98b94700ad0c5aaa58c72c0e
--- /dev/null
+++ b/evidence/concrete_semantics_tests.py
@@ -0,0 +1,18 @@
+def pairs_sum_to_zero(l):
+    seen = []
+    value = 0
+    for value in l:
+        if -value in seen:
+            return True
+        seen.append(value)
+    return False
+
+
+assert pairs_sum_to_zero([]) == False
+assert pairs_sum_to_zero([0]) == False
+assert pairs_sum_to_zero([0, 0]) == True
+assert pairs_sum_to_zero([1, -1]) == True
+assert pairs_sum_to_zero([1, 2, -1]) == True
+assert pairs_sum_to_zero([1, 2, 3]) == False
+assert pairs_sum_to_zero([2, 4, -5, 3, 5, 7]) == True
+assert pairs_sum_to_zero([-8, 3, 8]) == True
