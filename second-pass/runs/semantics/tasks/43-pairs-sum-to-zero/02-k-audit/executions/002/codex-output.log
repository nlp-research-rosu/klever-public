+    "generation_metrics",
+    "generation_output",
+    "generation_root",
+    "generation_trace",
+    "run_manifest",
+    "stage1_result",
+    "task_manifest",
+    "translator",
+    "trusted_prompt",
+]
+for key in required_keys:
+    path = Path(audit["container_paths"][key])
