+    <heap>
+      .Map
+      => 0 |-> list(vCons(1,
+                   vCons(3,
+                   vCons(-2,
+                   vCons(1, .ValSeq)))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Concrete substitutions into the universal claim's formal result.
