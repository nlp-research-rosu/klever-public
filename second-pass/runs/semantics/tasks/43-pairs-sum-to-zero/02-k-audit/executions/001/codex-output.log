+    <heap>
+      .Map
+      => 0 |-> list(vCons(2,
+                   vCons(4,
+                   vCons(-5,
+                   vCons(3, .ValSeq)))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [real-no-pair]:
+    <k>
+      Call(closureVal(("l", .ParamNames), pairsBody, 0),
+           (list(vCons(1,
+                 vCons(3,
+                 vCons(-2,
+                 vCons(1, .ValSeq))))), .Exprs))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
