diff --git a/evidence/stage4_ground-spec.k b/evidence/stage4_ground-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..7b4517f1134de0f734a49cca7e478098cfd4acaa
--- /dev/null
+++ b/evidence/stage4_ground-spec.k
@@ -0,0 +1,152 @@
+requires "../../tmp/audit-work/pairs-audit/verification.k"
+
+module AUDIT-GROUND-SPEC
+  imports PAIRS-VERIFICATION
+
+  // Fixed-semantics executions over ordinary vCons lists.  These claims do not
+  // import the promoted loop or abstract-empty-list rules.
+  claim [real-empty]:
+    <k>
+      Call(closureVal(("l", .ParamNames), pairsBody, 0),
+           (list(.ValSeq), .Exprs))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [real-single-zero]:
+    <k>
+      Call(closureVal(("l", .ParamNames), pairsBody, 0),
+           (list(vCons(0, .ValSeq)), .Exprs))
+      => false
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(vCons(0, .ValSeq)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [real-double-zero]:
+    <k>
+      Call(closureVal(("l", .ParamNames), pairsBody, 0),
+           (list(vCons(0, vCons(0, .ValSeq))), .Exprs))
+      => true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(vCons(0, .ValSeq)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
