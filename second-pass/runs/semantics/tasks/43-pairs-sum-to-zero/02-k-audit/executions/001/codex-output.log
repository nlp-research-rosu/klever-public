+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(vCons(0, .ValSeq)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [real-double-zero]:
+    <k>
+      Call(closureVal(("l", .ParamNames), pairsBody, 0),
+           (list(vCons(0, vCons(0, .ValSeq))), .Exprs))
+      => true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(vCons(0, .ValSeq)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
