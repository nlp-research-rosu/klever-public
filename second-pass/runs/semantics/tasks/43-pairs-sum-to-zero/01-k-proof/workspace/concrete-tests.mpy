Module(
  FuncDef("pairs_sum_to_zero", Params("l"),
    Assign(Name("seen"), ListExpr())
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("l"),
      If(Compare(UnaryOp("-", Name("value")), CmpOp("in", Name("seen"))),
        Return(Bool(true)),
        )
      Expr(Call(Attribute(Name("seen"), "append"), Name("value"))))
    Return(Bool(false)))
  Assert(
    Compare(
      Call(
        Name("pairs_sum_to_zero"),
        ListExpr(Int(1), Int(3), Int(5), Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("pairs_sum_to_zero"),
        ListExpr(Int(1), Int(3), UnaryOp("-", Int(2)), Int(1))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("pairs_sum_to_zero"),
        ListExpr(Int(1), Int(2), Int(3), Int(7))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("pairs_sum_to_zero"),
        ListExpr(
          Int(2),
          Int(4),
          UnaryOp("-", Int(5)),
          Int(3),
          Int(5),
          Int(7))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("pairs_sum_to_zero"), ListExpr(Int(1))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("pairs_sum_to_zero"), ListExpr()),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("pairs_sum_to_zero"), ListExpr(Int(0))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("pairs_sum_to_zero"), ListExpr(Int(0), Int(0))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("pairs_sum_to_zero"),
        ListExpr(UnaryOp("-", Int(8)), Int(3), Int(8))),
      CmpOp("==", Bool(true)))))
