Module(
  FuncDef("pairs_sum_to_zero", Params("l"),
    Assign(Name("seen"), ListExpr())
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("l"),
      If(Compare(UnaryOp("-", Name("value")), CmpOp("in", Name("seen"))),
        Return(Bool(true)),
        )
      Expr(Call(Attribute(Name("seen"), "append"), Name("value"))))
    Return(Bool(false))))
