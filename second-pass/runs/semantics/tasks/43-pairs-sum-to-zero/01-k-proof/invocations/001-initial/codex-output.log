+        => #iterYield(X, list(intValues(XS))) ... </k>
+
+  // Proof bridge: append preserves the typed representation. This equation is
+  // the homomorphism lemma for valSeqConcat and snocIS.
+  rule valSeqConcat(intValues(IS:IntSeq), vCons(X:Int, .ValSeq))
+    => intValues(snocIS(IS, X))
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module PAIRS-SPEC --claims PAIRS-SPEC.membership-summary,PAIRS-SPEC.loop-summary,PAIRS-SPEC.all-integer-lists-empty,PAIRS-SPEC.all-integer-lists-nonempty --trusted PAIRS-SPEC.membership-summary,PAIRS-SPEC.loop-summary' in /work
