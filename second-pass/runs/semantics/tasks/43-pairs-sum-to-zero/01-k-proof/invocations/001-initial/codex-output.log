  // Concrete string ops for krun. A proof over a symbolic string intercepts the split problem-locally.
  rule <k> #applyK(toCall(boundMethodV(str(CS:IntSeq), "split")), .Vals)
        => #alloc(list(splitWS(CS, .IntSeq, .ValSeq))) ... </k>
