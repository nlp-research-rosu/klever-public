+                      (Name("value"), .Exprs)))
+            .Stmts)
+      ~> Return(Bool(false))
+      ~> #endcall
+      =>
+      scanIS(REM, SEEN)
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> BUILTINS:Scope
+        0 |-> scope(.Map, parent(-1))
+        1 |-> scope(
+          ( "l" |-> list(intValues(ORIGINAL:IntSeq))
+            "seen" |-> ref(H:Int)
+            "value" |-> OLD:Int ),
+          parent(0)) )
+      =>
+      ( -1 |-> BUILTINS
+        0 |-> scope(.Map, parent(-1)) )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      (H |-> list(intValues(SEEN:IntSeq)) HEAP:Map)
+      =>
+      (H |-> list(intValues(seenAfterIS(REM, SEEN))) HEAP)
+    </heap>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    [priority(40)]
+endmodule

