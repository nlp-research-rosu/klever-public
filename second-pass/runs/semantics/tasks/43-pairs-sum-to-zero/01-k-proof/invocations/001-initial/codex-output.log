exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module PAIRS-VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled && kompile verification.k --backend haskell --main-module PAIRS-VERIFICATION-LEMMAS --syntax-module MPY-SYNTAX --output-definition verification-lemmas-kompiled' in /work
