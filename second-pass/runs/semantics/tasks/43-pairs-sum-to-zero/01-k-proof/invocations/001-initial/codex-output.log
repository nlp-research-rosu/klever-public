def pairs_sum_to_zero(l):
    seen = []
    value = 0
    for value in l:
        if -value in seen:
            return True
        seen.append(value)
    return False
Module(
  FuncDef("pairs_sum_to_zero", Params("l"),
    Assign(Name("seen"), ListExpr())
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("l"),
      If(Compare(UnaryOp("-", Name("value")), CmpOp("in", Name("seen"))),
        Return(Bool(true)),
        )
      Expr(Call(Attribute(Name("seen"), "append"), Name("value"))))
    Return(Bool(false))))

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
