+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [bounded-two]:
+    <k>
+      Call(closureVal(("l", .ParamNames), pairsBody, 0),
+           (list(vCons(A:Int, vCons(B:Int, .ValSeq))), .Exprs))
+      => pairsSpec(vCons(A, vCons(B, .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
