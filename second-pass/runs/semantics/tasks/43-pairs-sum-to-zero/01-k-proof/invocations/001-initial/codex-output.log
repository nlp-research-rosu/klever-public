+            "seen" |-> ref(H:Int)
+            "value" |-> OLD:Int ),
+          parent(0)) )
+      =>
+      ( -1 |-> BUILTINS
+        0 |-> scope(.Map, parent(-1)) )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap>
+      (H |-> list(intValues(SEEN:IntSeq)) HEAP:Map)
+      =>
+      (H |-> list(intValues(seenAfterIS(REM, SEEN))) HEAP)
+    </heap>
+    <stack>
+      ListItem(frame(.K, 0, 1))
+      =>
+      .List
+    </stack>
+    <ret> noRet </ret>
+    [priority(40)]
+endmodule

codex
The composition mismatch is now localized to the representation of the freshly allocated empty `seen` list. I’m changing its construction from `[]` to the equivalent `l[:0]`, then adding the exact empty-slice bridge for the typed proof representation. This preserves Python behavior and lets the already-proved loop invariant match the top-level state without weakening the theorem.
apply patch
