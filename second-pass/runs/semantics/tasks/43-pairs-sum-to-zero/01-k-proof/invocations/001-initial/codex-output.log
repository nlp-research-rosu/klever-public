Seq","params":[]},"arity":1,"args":[{"node":"KApply","label":{"node":"KLabel","name":"seenAfterIS(_,_)_PAIRS-VERIFICATION_IntSeq_IntSeq_IntSeq","params":[]},"arity":2,"args":[{"node":"KVariable","name":"INPUT","sort":{"node":"KSort","name":"IntSeq"}},{"node":"KApply","label":{"node":"KLabel","name":".IntSeq_MPY-CORE_IntSeq","params":[]},"arity":0,"args":[]}]}]}]}]}}]},{"node":"KApply","label":{"node":"KLabel","name":"<heapLoc>","params":[]},"arity":1,"args":[{"node":"KRewrite","lhs":{"node":"KToken","sort":{"node":"KSort","name":"Int"},"token":"0"},"rhs":{"node":"KToken","sort":{"node":"KSort","name":"Int"},"token":"1"}}]},{"node":"KApply","label":{"node":"KLabel","name":"<stack>","params":[]},"arity":1,"args":[{"node":"KApply","label":{"node":"KLabel","name":".List","params":[]},"arity":0,"args":[]}]},{"node":"KApply","label":{"node":"KLabel","name":"<ret>","params":[]},"arity":1,"args":[{"node":"KApply","label":{"node":"KLabel","name":"noRet_MPY-CORE_RetState","params":[]},"arity":0,"args":[]}]},{"node":"KApply","label":{"node":"KLabel","name":"<exc>","params":[]},"arity":1,"args":[{"node":"KApply","label":{"node":"KLabel","name":"NoExc_MPY-CORE_Exc","params":[]},"arity":0,"args":[]}]},{"node":"KApply","label":{"node":"KLabel","name":"<exit-code>","params":[]},"arity":1,"args":[{"node":"KToken","sort":{"node":"KSort","name":"Int"},"token":"0"}]},{"node":"KApply","label":{"node":"KLabel","name":"<generatedCounter>","params":[]},"arity":1,"args":[{"node":"KRewrite","lhs":{"node":"KVariable","name":"_Gen0","sort":{"node":"KSort","name":"Int"}},"rhs":{"node":"KVariable","name":"?_Gen1","sort":{"node":"KSort","name":"Int"}}}]}]},"requires":{"node":"KToken","sort":{"node":"KSort","name":"Bool"},"token":"true"},"ensures":{"node":"KToken","sort":{"node":"KSort","name":"Bool"},"token":"true"},"att":{"node":"KAtt","att":{"org.kframework.definition.Production":{"node":"KProduction","klabel":{"node":"KLabel","name":"#ruleNoConditions","params":[]},"productionItems":[{"node":"KNonTerminal","sort":{"node":"KSort","name":"#RuleBody"}}],"params":[],"sort":{"node":"KSort","name":"#RuleContent"},"att":{"node":"KAtt","att":{"symbol":"#ruleNoConditions","org.kframework.attributes.Location":[345,27,345,98],"org.kframework.attributes.Source":"/usr/include/kframework/builtin/kast.md"}}},"UNIQUE_ID":"57e012fa7fdd8ec00e8a241c6c9f3617f1c7c9b5496f2008d4a75caff5af127a","label":"PAIRS-SPEC.all-integer-lists","org.kframework.attributes.Source":"/work/spec.k","org.kframework.attributes.Location":[125,5,146,31]}}}],"att":{"node":"KAtt","att":{"org.kframework.attributes.Location":[3,1,147,10],"org.kframework.attributes.Source":"/work/spec.k","digest":"fA5Yk/wGRG+KvjzHXAqhQ71V41a1hYRwoWav5eyu4v8="}}}]}}
