@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -u
+
+cd /tmp/audit-work/proof || exit 90
+
+run() {
+  printf '\nCOMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf 'EXIT_STATUS: %s\n' "$status"
+  return "$status"
+}
