+run kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled || exit $?
+
+run kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims loop || exit $?
