+    "candidate",
+    "canonical",
+    "generation_last",
+    "generation_manifest",
+    "generation_metrics",
+    "generation_output",
+    "generation_root",
+    "generation_trace",
+    "run_manifest",
+    "stage1_result",
+    "task_manifest",
+    "translator",
+    "trusted_prompt",
+}
