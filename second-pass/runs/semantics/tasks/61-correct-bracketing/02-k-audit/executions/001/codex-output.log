+rc=$?
+printf 'EXIT_STATUS=%d\n' "$rc"
+sha256sum "$inventory"
+printf 'SHA256_EXIT_STATUS=%d\n' "$?"
+wc -l -c "$inventory"
+printf 'WC_EXIT_STATUS=%d\n' "$?"
+grep '^GRAND_COUNTS=' "$inventory"
+printf 'COUNT_EXIT_STATUS=%d\n' "$?"
+exit "$rc"
