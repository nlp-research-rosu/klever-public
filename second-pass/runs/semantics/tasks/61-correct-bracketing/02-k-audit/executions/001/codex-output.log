+#!/usr/bin/env bash
+set +e
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  rc=$?
+  printf 'EXIT_STATUS=%d\n' "$rc"
+  return "$rc"
+}
+
