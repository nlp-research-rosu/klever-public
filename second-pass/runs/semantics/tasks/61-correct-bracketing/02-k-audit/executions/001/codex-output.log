===== semantics/str.k =====
     1	// reference/src/semantics/str.k — MPY-STR
     2	
     3	module MPY-STR
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	
     7	  // ==== iteration (the iterator protocol's str case; yields 1-char strings) ==
     8	  rule <k> #iterNext(str(.IntSeq))                 => #iterDone ... </k>
     9	  rule <k> #iterNext(str(iCons(C:Int, R:IntSeq)))
    10	        => #iterYield(str(iCons(C, .IntSeq)), str(R)) ... </k>
    11	
    12	  // ==== str literal (ASCII-only) ============================================
    13	  syntax IntSeq ::= strToCodes(String) [function]
    14	  rule <k> Str(S:String) => str(strToCodes(S)) ... </k>
    15	  rule strToCodes("") => .IntSeq
    16	  rule strToCodes(S:String) => iCons(ordChar(substrString(S, 0, 1)), strToCodes(substrString(S, 1, lengthString(S))))
    17	    requires S =/=String "" andBool ordChar(substrString(S, 0, 1)) <Int 128
    18	
    19	  // ==== operators: + / == / != / in =========================================
    20	  syntax IntSeq ::= seqConcat(IntSeq, IntSeq) [function, total]
    21	  rule seqConcat(.IntSeq, T:IntSeq)                => T
    22	  rule seqConcat(iCons(I:Int, S:IntSeq), T:IntSeq) => iCons(I, seqConcat(S, T))
    23	
    24	  rule applyBin("+",  str(A:IntSeq), str(B:IntSeq)) => str(seqConcat(A, B))
    25	  rule applyCmp("==", str(A:IntSeq), str(B:IntSeq)) => A ==K B
    26	  rule applyCmp("!=", str(A:IntSeq), str(B:IntSeq)) => notBool (A ==K B)
    27	
    28	  // substring membership: `P in X` iff the code-seq P occurs contiguously in X
    29	  rule applyCmp("in",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)
    30	  rule applyCmp("not in", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)
    31	
    32	  syntax Bool ::= strPrefix(IntSeq, IntSeq) [function, total]
    33	  rule strPrefix(.IntSeq, _:IntSeq)               => true
    34	  rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false
    35	  rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)
    36	
    37	  syntax Bool ::= strContains(IntSeq, IntSeq) [function, total]
    38	  rule strContains(P:IntSeq, X:IntSeq) => true  requires strPrefix(P, X)
    39	  rule strContains(P:IntSeq, .IntSeq)  => false requires notBool strPrefix(P, .IntSeq)
    40	  rule strContains(P:IntSeq, iCons(C:Int, Xs:IntSeq)) => strContains(P, Xs)
    41	       requires notBool strPrefix(P, iCons(C, Xs))
    42	
    43	  // ==== lexicographic order: < / <= / > / >= by code point (= Python str order on the code
    44	  // model). strLt reduces on GROUND code-seqs (krun) but is inert/OPAQUE on symbolic ones
    45	  // (a proof's codesProj(V) is an abstract IntSeq — no constructor rule matches), so a symbolic
    46	  // str `<` stays a trusted opaque term the way sortVS / intFloatDiv do. Additive: fires only on
    47	  // str </<=/>/>= comparisons.
    48	  syntax Bool ::= strLt(IntSeq, IntSeq) [function, total]
    49	  rule strLt(.IntSeq, .IntSeq)                => false
    50	  rule strLt(.IntSeq, iCons(_:Int, _:IntSeq)) => true
    51	  rule strLt(iCons(_:Int, _:IntSeq), .IntSeq) => false
    52	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => true          requires A  <Int B
    53	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B
    54	  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B
    55	
    56	  rule applyCmp("<",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
    57	  rule applyCmp(">",  str(A:IntSeq), str(B:IntSeq)) => strLt(B, A)
    58	  rule applyCmp("<=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(B, A)
    59	  rule applyCmp(">=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(A, B)
    60	endmodule
===== verification.k =====
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Mathematical reference result: the balance must never become negative,
     7	  // and it must be zero when the input is exhausted.  The prompt promises
     8	  // only '(' and ')' inputs; treating every non-'(' code as ')' merely makes
     9	  // the oracle total outside that promised domain.
    10	  syntax Bool ::= correctCodes(IntSeq, Int) [function, total]
    11	  rule correctCodes(.IntSeq, B:Int) => B ==Int 0
    12	  rule correctCodes(iCons(C:Int, R:IntSeq), B:Int)
    13	    => #if C ==Int 40
    14	       #then correctCodes(R, B +Int 1)
    15	       #else #if B ==Int 0
    16	             #then false
    17	             #else correctCodes(R, B -Int 1)
    18	             #fi
    19	       #fi
    20	endmodule
===== spec.k =====
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  // Inductive loop invariant.  This claim starts in the active function
     7	  // frame at a nonnegative balance and proves the result for every remaining
     8	  // character sequence.  The public entry case is its B = 0 instance after
     9	  // the two initialization assignments in solution.py.
    10	  claim
    11	    <k>
    12	      #loop(
    13	        str(S:IntSeq),
    14	        Name("bracket"),
    15	        If(Compare(Name("bracket"), CmpOp("==", Str("("))),
    16	          AugAssign(Name("balance"), "+", Int(1)),
    17	          AugAssign(Name("balance"), "-", Int(1)))
    18	        If(Compare(Name("balance"), CmpOp("<", Int(0))),
    19	          Return(Bool(false)),
    20	          .Stmts))
    21	      ~> Return(Compare(Name("balance"), CmpOp("==", Int(0))))
    22	      ~> #endcall
    23	      => correctCodes(S, B) ~> CONT
    24	    </k>
    25	    <env> 1 => 0 </env>
    26	    <scopes>
    27	      ( -1 |-> builtinsScope
    28	        0  |-> scope(GLOBALS, parent(-1))
    29	        1  |-> scope(
    30	          "balance"  |-> B:Int
    31	          "bracket"  |-> OLD:Str
    32	          "brackets" |-> str(INPUT:IntSeq),
    33	          parent(0))
    34	      )
    35	      =>
    36	      ( -1 |-> builtinsScope
    37	        0  |-> scope(GLOBALS, parent(-1))
    38	      )
    39	    </scopes>
    40	    <scopeLoc> 2 => 1 </scopeLoc>
    41	    <heap> HEAP </heap>
    42	    <heapLoc> HLOC </heapLoc>
    43	    <stack> ListItem(frame(CONT:K, 0, 1)) => .List </stack>
    44	    <ret> noRet </ret>
    45	    <exc> NoExc </exc>
    46	    <exit-code> 0 </exit-code>
    47	    requires B >=Int 0
    48	    [label(loop)]
    49	endmodule

diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..37ff19045a4abed45495060c797062c17a7b0b81
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,116 @@
+#!/usr/bin/env python3
+"""Independent differential test for HumanEval problem 61.
+
+The trusted and generated entry points are imported from paths supplied on the
+command line. Inputs are generated here, independently of the K proof helper.
+"""
+
+from __future__ import annotations
+
+import argparse
+import importlib.util
+import itertools
+import json
+import random
+from pathlib import Path
+
+
+def load_entry(path: Path, module_name: str):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.correct_bracketing
+
+
+def all_parenthesis_strings(max_length: int):
+    for length in range(max_length + 1):
+        for symbols in itertools.product("()", repeat=length):
+            yield "".join(symbols)
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("canonical")
+    parser.add_argument("generated")
+    parser.add_argument("inputs_json")
+    args = parser.parse_args()
+
+    canonical = load_entry(Path(args.canonical), "trusted_canonical_61")
+    generated = load_entry(Path(args.generated), "generated_solution_61")
+
+    documented = ["(", "()", "(()())", ")(()"]
+    explicit_boundaries = [
+        "",
+        ")",
+        "((",
+        "))",
+        "()(",
+        "())",
+        "(()",
+        "()()",
+        "((()))",
+        "((())())",
+        "(((((((((())))))))))",
+        "(" * 64 + ")" * 64,
+        ")" + "(" * 64 + ")" * 63,
+    ]
+    exhaustive = list(all_parenthesis_strings(12))
+    rng = random.Random(610061)
+    generated_cases = [
+        "".join(rng.choice("()") for _ in range(length))
+        for length in (13, 14, 15, 16, 17, 31, 32, 33, 63, 64, 65, 127, 128)
+        for _ in range(32)
+    ]
+
+    ordered = []
+    seen = set()
+    for value in documented + explicit_boundaries + exhaustive + generated_cases:
+        if value not in seen:
+            seen.add(value)
+            ordered.append(value)
+
+    manifest = {
+        "domain": "strings containing only '(' and ')'",
+        "documented_examples": documented,
+        "explicit_boundaries": explicit_boundaries,
+        "exhaustive_generation": {
+            "alphabet": ["(", ")"],
+            "minimum_length": 0,
+            "maximum_length": 12,
+            "count_before_deduplication": len(exhaustive),
+        },
+        "deterministic_random_seed": 610061,
+        "generated_lengths": [13, 14, 15, 16, 17, 31, 32, 33, 63, 64, 65, 127, 128],
+        "generated_per_length": 32,
+        "ordered_unique_inputs": ordered,
+    }
+    Path(args.inputs_json).write_text(
+        json.dumps(manifest, indent=2, sort_keys=True) + "\n",
+        encoding="utf-8",
+    )
+
+    mismatches = []
+    for value in ordered:
+        expected = canonical(value)
+        actual = generated(value)
+        if actual != expected:
+            mismatches.append(
+                {"input": value, "canonical": expected, "generated": actual}
+            )
+
+    print(f"documented_examples={len(documented)}")
+    print(f"explicit_boundaries={len(explicit_boundaries)}")
+    print(f"exhaustive_parenthesis_strings={len(exhaustive)}")
+    print(f"deterministic_generated_cases={len(generated_cases)}")
+    print(f"ordered_unique_cases={len(ordered)}")
+    print(f"mismatches={len(mismatches)}")
+    if mismatches:
+        print(json.dumps(mismatches[:20], indent=2, sort_keys=True))
+        return 1
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
