+
+module VERIFICATION
+  imports MPY
+
+  // Exact promised input domain: every ASCII code is '(' (40) or ')' (41).
+  syntax Bool ::= parenOnly(IntSeq) [function, total]
+  rule parenOnly(.IntSeq) => true
+  rule parenOnly(iCons(40, R:IntSeq)) => parenOnly(R)
+  rule parenOnly(iCons(41, R:IntSeq)) => parenOnly(R)
+  rule parenOnly(iCons(C:Int, _R:IntSeq)) => false
+    requires C =/=Int 40 andBool C =/=Int 41
+
+  // Mathematical reference result: the balance must never become negative,
+  // and it must be zero when the input is exhausted.
+  syntax Bool ::= correctCodes(IntSeq, Int) [function, total]
+  rule correctCodes(.IntSeq, B:Int) => B ==Int 0
+  rule correctCodes(iCons(C:Int, R:IntSeq), B:Int)
+    => #if C ==Int 40
+       #then correctCodes(R, B +Int 1)
+       #else #if B ==Int 0
+             #then false
+             #else correctCodes(R, B -Int 1)
+             #fi
+       #fi
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..cc2e04f4062b9e3d25af53e24285bcffbd127c4f
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def correct_bracketing(brackets: str):
+    balance = 0
+    for bracket in brackets:
+        if bracket == "(":
+            balance += 1
+        else:
+            balance -= 1
+        if balance < 0:
+            return False
+    return balance == 0
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..5059b9bbc2ced663c7b857df551fdfe7232e3faa
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,86 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive loop invariant.  This claim starts in the active function
+  // frame at a nonnegative balance and proves the result for every remaining
+  // parenthesis sequence.  Recursive uses of the claim consume one pOpen or
+  // pClose constructor.
+  claim
+    <k>
+      #loop(
+        str(S:IntSeq),
+        Name("bracket"),
+        If(Compare(Name("bracket"), CmpOp("==", Str("("))),
+          AugAssign(Name("balance"), "+", Int(1)),
+          AugAssign(Name("balance"), "-", Int(1)))
+        If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Bool(false)),
+          .Stmts))
+      ~> Return(Compare(Name("balance"), CmpOp("==", Int(0))))
+      ~> #endcall
+      => correctCodes(S, B) ~> CONT
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0  |-> scope(GLOBALS, parent(-1))
+        1  |-> scope(
+          "balance"  |-> B:Int
+          "bracket"  |-> OLD:Str
+          "brackets" |-> str(INPUT:IntSeq),
+          parent(0))
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0  |-> scope(GLOBALS, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HLOC </heapLoc>
+    <stack> ListItem(frame(CONT:K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires B >=Int 0
+     andBool parenOnly(S)
+
+  // The public-entry proof starts from the exact closure body emitted in
+  // solution.mpy, calls it on every input in the promised domain, and uses
+  // the loop invariant above.
+  claim
+    <k>
+      Call(
+        Name("correct_bracketing"),
+        str(S:IntSeq))
+      => correctCodes(S, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "correct_bracketing" |->
+          closureVal(("brackets", .ParamNames),
+            Assign(Name("balance"), Int(0))
+            For(Name("bracket"), Name("brackets"),
+              If(Compare(Name("bracket"), CmpOp("==", Str("("))),
+                AugAssign(Name("balance"), "+", Int(1)),
+                AugAssign(Name("balance"), "-", Int(1)))
+              If(Compare(Name("balance"), CmpOp("<", Int(0))),
+                Return(Bool(false)),
+                .Stmts))
+            Return(Compare(Name("balance"), CmpOp("==", Int(0)))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires parenOnly(S)
+endmodule
