@@ -0,0 +1,10 @@
+def correct_bracketing(brackets: str):
+    balance = 0
+    for bracket in brackets:
+        if bracket == "(":
+            balance += 1
+        else:
+            balance -= 1
+        if balance < 0:
+            return False
+    return balance == 0
