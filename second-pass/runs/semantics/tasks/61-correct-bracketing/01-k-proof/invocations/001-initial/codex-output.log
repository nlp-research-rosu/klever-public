// reference/src/semantics/tuple.k — MPY-TUPLE

module MPY-TUPLE
  imports MPY-CORE
  imports MPY-ITER
  imports MPY-LIST
  imports MPY-METHODS

  // ==== iteration (the iterator protocol's tuple case) ======================
  rule <k> #iterNext(tuple(.ValSeq))                => #iterDone ... </k>
  rule <k> #iterNext(tuple(vCons(V:Val, R:ValSeq))) => #iterYield(V, tuple(R)) ... </k>

  // ==== TupleExpr: tuple(ValSeq) literal + == != ===========================
  syntax ApplyK ::= "toTuple"
  rule <k> TupleExpr(ES:Exprs) => #evalArgs(ES, .Vals, toTuple) ... </k>
  rule <k> #applyK(toTuple, ACC:Vals) => tuple(vals2valSeq(ACC)) ... </k>

  rule applyCmp("==", tuple(A:ValSeq), tuple(B:ValSeq)) => A ==K B
  // membership routes through the same k-cell fold as lists (list.k)
  rule <k> Compare(LV:Val, CmpOp("in",     tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ... </k>
  rule <k> Compare(LV:Val, CmpOp("not in", tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ~> #notB ... </k>
  // t.index(v): first index of v (ValueError out of subset)
  rule applyMethod(tuple(VS:ValSeq), "index", V:Val, .Vals) => idxOfVS(VS, V, 0)
  syntax Int ::= idxOfVS(ValSeq, Val, Int) [function]
  rule idxOfVS(vCons(A:Val, _:ValSeq), V:Val, I:Int) => I requires A ==K V
  rule idxOfVS(vCons(A:Val, R:ValSeq), V:Val, I:Int) => idxOfVS(R, V, I +Int 1)
       requires notBool (A ==K V)
  rule applyCmp("!=", tuple(A:ValSeq), tuple(B:ValSeq)) => notBool (A ==K B)

  // ==== target binding: bind a Name or a TupleExpr target to a value ========
  syntax KItem ::= #bindTgt(Expr, Val)
  rule <k> #bindTgt(Name(X:String), V:Val) => .K ... </k>
       <env> L:Int </env>
       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>
  rule <k> #bindTgt(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>
       <env> L:Int </env>
       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
       requires "$cells" in_keys(M)
        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
        andBool X in_keys(M) andBool isCellRef({M[X]}:>Val)
       [priority(40)]
  rule <k> #bindTgt(TupleExpr(TS:Exprs), tuple(VS:ValSeq)) => #unpackSeq(TS, VS) ... </k>
  rule <k> #bindTgt(TupleExpr(TS:Exprs), list(VS:ValSeq))  => #unpackSeq(TS, VS) ... </k>
  rule <k> #bindTgt(TupleExpr(TS:Exprs), ref(H:Int)) => #bindTgt(TupleExpr(TS), V) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]

  // ==== unpacking: a, b = <tuple|list> (RHS evaluated by strictness) ========
  syntax KItem ::= #unpackSeq(Exprs, ValSeq)
  rule <k> Assign(TupleExpr(TS:Exprs), tuple(VS:ValSeq)) => #unpackSeq(TS, VS) ... </k>
  rule <k> Assign(TupleExpr(TS:Exprs), list(VS:ValSeq))  => #unpackSeq(TS, VS) ... </k>
  rule <k> Assign(TupleExpr(TS:Exprs), ref(H:Int)) => Assign(TupleExpr(TS), V) ... </k>
       <heap> ... H |-> V:Val ... </heap>
       [priority(40)]
  rule <k> #unpackSeq((T:Expr, TS:Exprs), vCons(V:Val, VS:ValSeq))
        => #bindTgt(T, V) ~> #unpackSeq(TS, VS) ... </k>
  rule <k> #unpackSeq(.Exprs, .ValSeq) => .K ... </k>
endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..cc2e04f4062b9e3d25af53e24285bcffbd127c4f
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def correct_bracketing(brackets: str):
+    balance = 0
+    for bracket in brackets:
+        if bracket == "(":
+            balance += 1
+        else:
+            balance -= 1
+        if balance < 0:
+            return False
+    return balance == 0
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c903d653727ea9d627d54b66aefcf9cb3bdf3270
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,82 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive loop invariant.  This claim starts in the active function
+  // frame at a nonnegative balance and proves the result for every remaining
+  // parenthesis sequence.  Recursive uses of the claim consume one pOpen or
+  // pClose constructor.
+  claim
+    <k>
+      #loop(
+        str(parenthesisCodes(P:Parens)),
+        Name("bracket"),
+        If(Compare(Name("bracket"), CmpOp("==", Str("("))),
+          AugAssign(Name("balance"), "+", Int(1)),
+          AugAssign(Name("balance"), "-", Int(1)))
+        If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Bool(false)),
+          .Stmts))
+      ~> Return(Compare(Name("balance"), CmpOp("==", Int(0))))
+      ~> #endcall
+      => correctFrom(P, B) ~> CONT
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0  |-> scope(GLOBALS, parent(-1))
+        1  |-> scope(("balance" |-> B:Int) FRAME, parent(0))
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0  |-> scope(GLOBALS, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HLOC </heapLoc>
+    <stack> ListItem(frame(CONT:K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires B >=Int 0
+     andBool notBool ("balance" in_keys(FRAME))
+     andBool notBool ("$cells" in_keys(FRAME))
+
+  // The public-entry proof starts from the exact closure body emitted in
+  // solution.mpy, calls it on every input in the promised domain, and uses
+  // the loop invariant above.
+  claim
+    <k>
+      Call(
+        Name("correct_bracketing"),
+        str(parenthesisCodes(P:Parens)))
+      => correctFrom(P, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "correct_bracketing" |->
+          closureVal(("brackets", .ParamNames),
+            Assign(Name("balance"), Int(0))
+            For(Name("bracket"), Name("brackets"),
+              If(Compare(Name("bracket"), CmpOp("==", Str("("))),
+                AugAssign(Name("balance"), "+", Int(1)),
+                AugAssign(Name("balance"), "-", Int(1)))
+              If(Compare(Name("balance"), CmpOp("<", Int(0))),
+                Return(Bool(false)),
+                .Stmts))
+            Return(Compare(Name("balance"), CmpOp("==", Int(0)))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a6af53ecb67eda569f7175db0c39ad6b47130c96
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,26 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A constructor-only representation of the function's promised input
+  // domain.  It prevents the proof from silently assuming behavior for
+  // characters other than '(' (ASCII 40) and ')' (ASCII 41).
+  syntax Parens ::= "pNil"
+                  | pOpen(Parens)
+                  | pClose(Parens)
+
+  syntax IntSeq ::= parenthesisCodes(Parens) [function, total]
+  rule parenthesisCodes(pNil)      => .IntSeq
+  rule parenthesisCodes(pOpen(P))  => iCons(40, parenthesisCodes(P))
+  rule parenthesisCodes(pClose(P)) => iCons(41, parenthesisCodes(P))
+
+  // Mathematical reference result: the balance must never become negative,
+  // and it must be zero when the input is exhausted.
+  syntax Bool ::= correctFrom(Parens, Int) [function]
+  rule correctFrom(pNil, B:Int) => B ==Int 0
+  rule correctFrom(pOpen(P), B:Int) => correctFrom(P, B +Int 1)
+  rule correctFrom(pClose(_P), 0) => false
+  rule correctFrom(pClose(P), B:Int) => correctFrom(P, B -Int 1)
+    requires B >Int 0
+endmodule

codex
The first inductive attempt exposed a prover-only ambiguity in a symbolic frame map: the semantics conservatively explored an impossible closure-cell branch. I’ve isolated the loop frame to the exact three locals the Python function can have (`brackets`, `balance`, `bracket`), which removes that ambiguity without adding any execution rules or assumptions.
apply patch
patch: completed
