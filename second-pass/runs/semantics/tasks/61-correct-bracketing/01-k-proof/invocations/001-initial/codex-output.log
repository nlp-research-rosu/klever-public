diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..b1a17a810f423c5e56a5dcdcd5e55e5c9111feb8
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,45 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
+cd "$script_dir"
+
+# Recreate the submitted constructor program with the required translator.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Build the required concrete semantics.
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+# Exercise the exact submitted source through translation and LLVM execution.
+smoke_dir=$(mktemp -d)
+trap 'rm -rf -- "$smoke_dir"' EXIT
+cp solution.py "$smoke_dir/smoke.py"
+printf '%s\n' \
+  '' \
+  'assert correct_bracketing("")' \
+  'assert not correct_bracketing("(")' \
+  'assert correct_bracketing("()")' \
+  'assert correct_bracketing("(()())")' \
+  'assert not correct_bracketing(")(()")' \
+  'assert not correct_bracketing("())")' \
+  'assert correct_bracketing("()()")' \
+  >> "$smoke_dir/smoke.py"
+python3 py2mpy.py "$smoke_dir/smoke.py" > "$smoke_dir/smoke.mpy"
+krun "$smoke_dir/smoke.mpy" --definition runtime-kompiled
+
+# Build the unmodified MPY semantics plus pure mathematical oracle.
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+# Prove the universal inductive claim (the entry case is B = 0).
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims loop
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..b98b0f91717153c8b678cac451cefe726d293179
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def correct_bracketing(brackets: str):
+    balance = 0
+    bracket = ""
+    for bracket in brackets:
+        if bracket == "(":
+            balance += 1
+        else:
+            balance -= 1
+        if balance < 0:
+            return False
+    return balance == 0
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..3c9d9dc6b86eb3dda06d843c2e7a1df114b8eb38
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,49 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive loop invariant.  This claim starts in the active function
+  // frame at a nonnegative balance and proves the result for every remaining
+  // character sequence.  The public entry case is its B = 0 instance after
+  // the two initialization assignments in solution.py.
+  claim
+    <k>
+      #loop(
+        str(S:IntSeq),
+        Name("bracket"),
+        If(Compare(Name("bracket"), CmpOp("==", Str("("))),
+          AugAssign(Name("balance"), "+", Int(1)),
+          AugAssign(Name("balance"), "-", Int(1)))
+        If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Bool(false)),
+          .Stmts))
+      ~> Return(Compare(Name("balance"), CmpOp("==", Int(0))))
+      ~> #endcall
+      => correctCodes(S, B) ~> CONT
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0  |-> scope(GLOBALS, parent(-1))
+        1  |-> scope(
+          "balance"  |-> B:Int
+          "bracket"  |-> OLD:Str
+          "brackets" |-> str(INPUT:IntSeq),
+          parent(0))
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0  |-> scope(GLOBALS, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HLOC </heapLoc>
+    <stack> ListItem(frame(CONT:K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires B >=Int 0
+    [label(loop)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..91a9ff73812f92a482a9de7bf9a1421175992d8a
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,20 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Mathematical reference result: the balance must never become negative,
+  // and it must be zero when the input is exhausted.  The prompt promises
+  // only '(' and ')' inputs; treating every non-'(' code as ')' merely makes
+  // the oracle total outside that promised domain.
+  syntax Bool ::= correctCodes(IntSeq, Int) [function, total]
+  rule correctCodes(.IntSeq, B:Int) => B ==Int 0
+  rule correctCodes(iCons(C:Int, R:IntSeq), B:Int)
+    => #if C ==Int 40
+       #then correctCodes(R, B +Int 1)
+       #else #if B ==Int 0
+             #then false
+             #else correctCodes(R, B -Int 1)
+             #fi
+       #fi
+endmodule

