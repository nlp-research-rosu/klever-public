+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Exact promised input domain: every ASCII code is '(' (40) or ')' (41).
+  syntax Bool ::= parenOnly(IntSeq) [function, total]
+  rule parenOnly(.IntSeq) => true
+  rule parenOnly(iCons(C:Int, R:IntSeq))
+    => (C ==Int 40 orBool C ==Int 41) andBool parenOnly(R)
+
+  // Mathematical reference result: the balance must never become negative,
+  // and it must be zero when the input is exhausted.
+  syntax Bool ::= correctCodes(IntSeq, Int) [function]
+  rule correctCodes(.IntSeq, B:Int) => B ==Int 0
+  rule correctCodes(iCons(40, R:IntSeq), B:Int)
+    => correctCodes(R, B +Int 1)
+  rule correctCodes(iCons(41, _R:IntSeq), 0) => false
+  rule correctCodes(iCons(41, R:IntSeq), B:Int)
+    => correctCodes(R, B -Int 1)
+    requires B >Int 0
+endmodule

