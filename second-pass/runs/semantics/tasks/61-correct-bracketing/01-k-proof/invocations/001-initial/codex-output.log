+
+  // A constructor-only representation of the function's promised input
+  // domain.  It prevents the proof from silently assuming behavior for
+  // characters other than '(' (ASCII 40) and ')' (ASCII 41).
+  syntax Parens ::= "pNil"
+                  | pOpen(Parens)
+                  | pClose(Parens)
+
+  syntax IntSeq ::= parenthesisCodes(Parens) [function, total]
+  rule parenthesisCodes(pNil)      => .IntSeq
+  rule parenthesisCodes(pOpen(P))  => iCons(40, parenthesisCodes(P))
+  rule parenthesisCodes(pClose(P)) => iCons(41, parenthesisCodes(P))
+
+  // Mathematical reference result: the balance must never become negative,
+  // and it must be zero when the input is exhausted.
+  syntax Bool ::= correctFrom(Parens, Int) [function]
+  rule correctFrom(pNil, B:Int) => B ==Int 0
+  rule correctFrom(pOpen(P), B:Int) => correctFrom(P, B +Int 1)
+  rule correctFrom(pClose(_P), 0) => false
+  rule correctFrom(pClose(P), B:Int) => correctFrom(P, B -Int 1)
+    requires B >Int 0
+endmodule

