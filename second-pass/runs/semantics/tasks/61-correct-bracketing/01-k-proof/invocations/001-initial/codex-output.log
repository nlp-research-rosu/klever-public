+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inductive loop invariant.  This claim starts in the active function
+  // frame at a nonnegative balance and proves the result for every remaining
+  // parenthesis sequence.  Recursive uses of the claim consume one pOpen or
+  // pClose constructor.
+  claim
+    <k>
+      #loop(
+        str(parenthesisCodes(P:Parens)),
+        Name("bracket"),
+        If(Compare(Name("bracket"), CmpOp("==", Str("("))),
+          AugAssign(Name("balance"), "+", Int(1)),
+          AugAssign(Name("balance"), "-", Int(1)))
+        If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Bool(false)),
+          .Stmts))
+      ~> Return(Compare(Name("balance"), CmpOp("==", Int(0))))
+      ~> #endcall
+      => correctFrom(P, B) ~> CONT
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      ( -1 |-> builtinsScope
+        0  |-> scope(GLOBALS, parent(-1))
+        1  |-> scope(("balance" |-> B:Int) FRAME, parent(0))
+      )
+      =>
+      ( -1 |-> builtinsScope
+        0  |-> scope(GLOBALS, parent(-1))
+      )
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HLOC </heapLoc>
+    <stack> ListItem(frame(CONT:K, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires B >=Int 0
+     andBool notBool ("balance" in_keys(FRAME))
+     andBool notBool ("$cells" in_keys(FRAME))
+
+  // The public-entry proof starts from the exact closure body emitted in
+  // solution.mpy, calls it on every input in the promised domain, and uses
+  // the loop invariant above.
+  claim
+    <k>
+      Call(
+        Name("correct_bracketing"),
+        str(parenthesisCodes(P:Parens)))
+      => correctFrom(P, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "correct_bracketing" |->
+          closureVal(("brackets", .ParamNames),
+            Assign(Name("balance"), Int(0))
+            For(Name("bracket"), Name("brackets"),
+              If(Compare(Name("bracket"), CmpOp("==", Str("("))),
+                AugAssign(Name("balance"), "+", Int(1)),
+                AugAssign(Name("balance"), "-", Int(1)))
+              If(Compare(Name("balance"), CmpOp("<", Int(0))),
+                Return(Bool(false)),
+                .Stmts))
+            Return(Compare(Name("balance"), CmpOp("==", Int(0)))),
+            0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..924e4273a0b930116869194dd7bda6240c4f0340
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,26 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A constructor-only representation of the function's promised input
+  // domain.  It prevents the proof from silently assuming behavior for
+  // characters other than '(' (ASCII 40) and ')' (ASCII 41).
+  syntax Parens ::= pNil
+                  | pOpen(Parens)
+                  | pClose(Parens)
+
+  syntax IntSeq ::= parenthesisCodes(Parens) [function, total]
+  rule parenthesisCodes(pNil)      => .IntSeq
+  rule parenthesisCodes(pOpen(P))  => iCons(40, parenthesisCodes(P))
+  rule parenthesisCodes(pClose(P)) => iCons(41, parenthesisCodes(P))
+
+  // Mathematical reference result: the balance must never become negative,
+  // and it must be zero when the input is exhausted.
+  syntax Bool ::= correctFrom(Parens, Int) [function]
+  rule correctFrom(pNil, B:Int) => B ==Int 0
+  rule correctFrom(pOpen(P), B:Int) => correctFrom(P, B +Int 1)
+  rule correctFrom(pClose(_P), 0) => false
+  rule correctFrom(pClose(P), B:Int) => correctFrom(P, B -Int 1)
+    requires B >Int 0
+endmodule

