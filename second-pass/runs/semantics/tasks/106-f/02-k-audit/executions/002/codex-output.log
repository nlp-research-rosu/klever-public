+print("trace_files:", [str(p) for p in trace_files])
+result = json.loads(Path("/generation-result.json").read_text())
+declared_trace = {
+    k: v for k, v in result["outputs"]["evidence"].items()
+    if k.startswith("codex-trace/")
+}
