+
+echo "PRIORITY RULE ATTRIBUTES"
+rg -n '\\[priority\\(' "${sources[@]}" || true
+
+echo "SIMPLIFICATION RULE ATTRIBUTES"
+rg -n '\\[simplification\\]' "${sources[@]}" || true

