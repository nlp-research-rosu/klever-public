    or the sum of numbers from 1 to i otherwise.
    i starts from 1.
    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).
    Example:
    f(5) == [1, 2, 6, 24, 15]
    """
# canonical.py — the UNMODIFIED HumanEval/106 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: f


def f(n):
    """ Implement the function f that takes n as a parameter,
    and returns a list of size n, such that the value of the element at index i is the factorial of i if i is even
    or the sum of numbers from 1 to i otherwise.
    i starts from 1.
    the factorial of i is the multiplication of the numbers from 1 to i (1 * 2 * ... * i).
    Example:
    f(5) == [1, 2, 6, 24, 15]
    """
    ret = []
    for i in range(1,n+1):
        if i%2 == 0:
            x = 1
            for j in range(1,i+1): x *= j
            ret += [x]
        else:
            x = 0
            for j in range(1,i+1): x += j
            ret += [x]
    return ret
def f(n):
    result = []
    factorial = 1
    total = 0
    i = 1
    while i <= n:
        factorial *= i
        total += i
        if i % 2 == 0:
            result.append(factorial)
        else:
            result.append(total)
        i += 1
    return result
Module(
  FuncDef("f", Params("n"),
    Assign(Name("result"), ListExpr())
    Assign(Name("factorial"), Int(1))
    Assign(Name("total"), Int(0))
    Assign(Name("i"), Int(1))
    While(Compare(Name("i"), CmpOp("<=", Name("n"))),
      AugAssign(Name("factorial"), "*", Name("i"))
      AugAssign(Name("total"), "+", Name("i"))
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
        Expr(
          Call(Attribute(Name("result"), "append"), Name("factorial"))),
        Expr(Call(Attribute(Name("result"), "append"), Name("total"))))
      AugAssign(Name("i"), "+", Int(1)))
    Return(Name("result"))))
requires "verification.k"

module SPEC
  imports VERIFICATION

  // General loop invariant.  It applies to the literal loop in solution.mpy.
  // The bounds make I = N + 1 the unique exit state.
  claim
    <k>
