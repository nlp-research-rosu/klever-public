+              Expr(Call(Attribute(Name("result"), "append"), Name("total"))))
+            AugAssign(Name("i"), "+", Int(1)))
+          Return(Name("result")), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+        vCons(1, vCons(2, vCons(6, vCons(24, vCons(16, .ValSeq))))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires true
+    [label(f-five-false-last)]
+endmodule
