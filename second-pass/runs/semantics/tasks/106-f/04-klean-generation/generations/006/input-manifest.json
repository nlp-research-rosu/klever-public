      "discovery_manifest_sha256": "cd5a215d73f441e91cef5b00ac023703e39d736318f40555997847e520f4aeb1",
      "end_line": 38,
      "inventory_sha256": "a51d8b2c346e72b06c592a426e9e98ee5acf2554dd48cf0c23e835041070ae4e",
      "module": "VERIFICATION",
      "normalized_sha256": "6b49fce56fe800f0a53b8ec7f41fec54b9db95c08b9bd8d56dde0b6720d71d84",
      "rationale": "This simplification assumes that a finite sequence equal to itself concatenated with a suffix forces that suffix to be empty; Stage 1 trusts this cancellation consequence rather than proving the exact rule first.",
      "source_rule_id": "rule-6b49fce56fe800f0a53b8ec7f41fec54b9db95c08b9bd8d56dde0b6720d71d84",
      "start_line": 36,
      "text": "  rule { P:ValSeq #Equals valSeqConcat(P, A:ValSeq) }\n    => { .ValSeq #Equals A }\n    [simplification]"
