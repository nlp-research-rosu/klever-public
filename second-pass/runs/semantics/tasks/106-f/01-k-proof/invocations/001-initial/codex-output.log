diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..79f61b90e166afb04da35c6adaea46f4ff83023f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,39 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // Relational description of the values emitted from I through N.  F and T
+  // are the factorial and triangular accumulators before step I.
+  syntax Bool ::= outputOK(ValSeq, Int, Int, Int, Int)
+    [function, total]
+  rule outputOK(.ValSeq, I:Int, N:Int, _F:Int, _T:Int) => true
+    requires I >Int N
+  rule outputOK(vCons(V:Int, REST:ValSeq),
+                I:Int, N:Int, F:Int, T:Int)
+    => outputOK(REST, I +Int 1, N, F *Int I, T +Int I)
+    requires I <=Int N andBool pyMod(I, 2) ==Int 0
+      andBool V ==Int F *Int I
+  rule outputOK(vCons(V:Int, REST:ValSeq),
+                I:Int, N:Int, F:Int, T:Int)
+    => outputOK(REST, I +Int 1, N, F *Int I, T +Int I)
+    requires I <=Int N andBool notBool (pyMod(I, 2) ==Int 0)
+      andBool V ==Int T +Int I
+
+  // Associativity is the algebraic fact needed when one append has extended
+  // an arbitrary already-produced prefix before the circularity is reused.
+  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
+    => valSeqConcat(A, valSeqConcat(B, C))
+    [simplification]
+  rule valSeqConcat(A:ValSeq, .ValSeq) => A
+    [simplification]
+
+  // Cancellation exposes the existential suffix used by outputOK.
+  rule { valSeqConcat(P:ValSeq, A:ValSeq)
+         #Equals valSeqConcat(P, B:ValSeq) }
+    => { A #Equals B }
+    [simplification]
+  rule { P:ValSeq #Equals valSeqConcat(P, A:ValSeq) }
+    => { .ValSeq #Equals A }
+    [simplification]
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e2bdbde6b48c84e9a41861456c3afb81f088c06
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def f(n):
+    result = []
+    factorial = 1
+    total = 0
+    i = 1
+    while i <= n:
+        factorial *= i
+        total += i
+        if i % 2 == 0:
+            result.append(factorial)
+        else:
+            result.append(total)
+        i += 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..8b029f2f71822bf635888939715ea05d02e5eef6
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,103 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // General loop invariant.  It applies to the literal loop in solution.mpy.
+  // The bounds make I = N + 1 the unique exit state.
+  claim
+    <k>
+      While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+        AugAssign(Name("factorial"), "*", Name("i"))
+        AugAssign(Name("total"), "+", Name("i"))
+        If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("factorial"))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("total"))))
+        AugAssign(Name("i"), "+", Int(1)))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(.Map, parent(-1))
+      1 |-> scope(
+        "factorial" |-> (F:Int => ?FINALF:Int)
+        "i"         |-> (I:Int => N +Int 1)
+        "n"         |-> N:Int
+        "result"    |-> ref(0)
+        "total"     |-> (T:Int => ?FINALT:Int),
+        parent(0))
+    </scopes>
+    <heap>
+      0 |-> (list(PREFIX:ValSeq)
+        => list(valSeqConcat(PREFIX, ?OUTPUT:ValSeq)))
+    </heap>
+    requires 1 <=Int I andBool I <=Int N +Int 1
+    ensures outputOK(?OUTPUT, I, N, F, T)
+    [label(loop-correct)]
+
+  // End-to-end base case: evaluate the actual f closure on n = 0.
+  claim
+    <k> Call(Name("f"), Int(0)) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "f" |-> closureVal("n", .ParamNames,
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("factorial"), Int(1))
+          Assign(Name("total"), Int(0))
+          Assign(Name("i"), Int(1))
+          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+            AugAssign(Name("factorial"), "*", Name("i"))
+            AugAssign(Name("total"), "+", Name("i"))
+            If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("factorial"))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("total"))))
+            AugAssign(Name("i"), "+", Int(1)))
+          Return(Name("result")), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires true
+    [label(f-zero)]
+
+  // End-to-end prompt example.
+  claim
+    <k> Call(Name("f"), Int(5)) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "f" |-> closureVal("n", .ParamNames,
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("factorial"), Int(1))
+          Assign(Name("total"), Int(0))
+          Assign(Name("i"), Int(1))
+          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+            AugAssign(Name("factorial"), "*", Name("i"))
+            AugAssign(Name("total"), "+", Name("i"))
+            If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("factorial"))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("total"))))
+            AugAssign(Name("i"), "+", Int(1)))
+          Return(Name("result")), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+        vCons(1, vCons(2, vCons(6, vCons(24, vCons(15, .ValSeq))))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires true
+    [label(f-five)]
+endmodule
