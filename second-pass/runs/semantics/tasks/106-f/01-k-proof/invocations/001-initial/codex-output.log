diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..c90a45ccc6966545f2d904190d8f902a4ce194eb
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,48 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The values emitted by the loop from I through N.  F and T are,
+  // respectively, the factorial and triangular accumulators before step I.
+  syntax ValSeq ::= outputFrom(Int, Int, Int, Int)
+  rule outputFrom(I:Int, N:Int, _F:Int, _T:Int) => .ValSeq
+    requires I >Int N
+    [simplification]
+  rule vCons(F *Int I,
+             outputFrom(I +Int 1, N, F *Int I, T +Int I))
+    => outputFrom(I, N, F, T)
+    requires I <=Int N andBool pyMod(I, 2) ==Int 0
+    [simplification]
+  rule vCons(T +Int I,
+             outputFrom(I +Int 1, N, F *Int I, T +Int I))
+    => outputFrom(I, N, F, T)
+    requires I <=Int N andBool notBool (pyMod(I, 2) ==Int 0)
+    [simplification]
+
+  syntax Int ::= factorialAfter(Int, Int, Int)
+  rule factorialAfter(I:Int, N:Int, F:Int) => F
+    requires I >Int N
+    [simplification]
+  rule factorialAfter(I +Int 1, N, F *Int I)
+    => factorialAfter(I, N, F)
+    requires I <=Int N
+    [simplification]
+
+  syntax Int ::= totalAfter(Int, Int, Int)
+  rule totalAfter(I:Int, N:Int, T:Int) => T
+    requires I >Int N
+    [simplification]
+  rule totalAfter(I +Int 1, N, T +Int I)
+    => totalAfter(I, N, T)
+    requires I <=Int N
+    [simplification]
+
+  // Associativity is the algebraic fact needed when one append has extended
+  // an arbitrary already-produced prefix before the circularity is reused.
+  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
+    => valSeqConcat(A, valSeqConcat(B, C))
+    [simplification]
+  rule valSeqConcat(A:ValSeq, .ValSeq) => A
+    [simplification]
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e2bdbde6b48c84e9a41861456c3afb81f088c06
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def f(n):
+    result = []
+    factorial = 1
+    total = 0
+    i = 1
+    while i <= n:
+        factorial *= i
+        total += i
+        if i % 2 == 0:
+            result.append(factorial)
+        else:
+            result.append(total)
+        i += 1
+    return result
