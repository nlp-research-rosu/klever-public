index 0000000000000000000000000000000000000000..3708d599990a1c89429cfc665e499a411c89a1fc
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,102 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // General loop invariant.  It applies to the literal loop in solution.mpy.
+  // The bounds make I = N + 1 the unique exit state.
+  claim
+    <k>
+      While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+        AugAssign(Name("factorial"), "*", Name("i"))
+        AugAssign(Name("total"), "+", Name("i"))
+        If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("factorial"))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("total"))))
+        AugAssign(Name("i"), "+", Int(1)))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(.Map, parent(-1))
+      1 |-> scope(
+        "factorial" |-> (F:Int => ?FINALF:Int)
+        "i"         |-> (I:Int => N +Int 1)
+        "n"         |-> N:Int
+        "result"    |-> ref(0)
+        "total"     |-> (T:Int => ?FINALT:Int),
+        parent(0))
+    </scopes>
+    <heap>
+      0 |-> (list(PREFIX:ValSeq)
+        => list(valSeqConcat(PREFIX, outputFrom(I, N, F, T))))
+    </heap>
+    requires 1 <=Int I andBool I <=Int N +Int 1
+    [label(loop-correct)]
+
+  // End-to-end base case: evaluate the actual f closure on n = 0.
+  claim
+    <k> Call(Name("f"), Int(0)) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "f" |-> closureVal("n", .ParamNames,
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("factorial"), Int(1))
+          Assign(Name("total"), Int(0))
+          Assign(Name("i"), Int(1))
+          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+            AugAssign(Name("factorial"), "*", Name("i"))
+            AugAssign(Name("total"), "+", Name("i"))
+            If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("factorial"))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("total"))))
+            AugAssign(Name("i"), "+", Int(1)))
+          Return(Name("result")), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires true
+    [label(f-zero)]
+
+  // End-to-end prompt example.
+  claim
+    <k> Call(Name("f"), Int(5)) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "f" |-> closureVal("n", .ParamNames,
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("factorial"), Int(1))
+          Assign(Name("total"), Int(0))
+          Assign(Name("i"), Int(1))
+          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+            AugAssign(Name("factorial"), "*", Name("i"))
+            AugAssign(Name("total"), "+", Name("i"))
+            If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("factorial"))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("total"))))
+            AugAssign(Name("i"), "+", Int(1)))
+          Return(Name("result")), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+        vCons(1, vCons(2, vCons(6, vCons(24, vCons(15, .ValSeq))))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires true
+    [label(f-five)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4cd3727cdf8209f574ca5e9c41c89341a0d021fc
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,30 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The values emitted by the loop from I through N.  F and T are,
+  // respectively, the factorial and triangular accumulators before step I.
+  syntax ValSeq ::= outputFrom(Int, Int, Int, Int)
+  rule outputFrom(I:Int, N:Int, _F:Int, _T:Int) => .ValSeq
+    requires I >Int N
+    [simplification]
+  rule vCons(F *Int I,
+             outputFrom(I +Int 1, N, F *Int I, T +Int I))
+    => outputFrom(I, N, F, T)
+    requires I <=Int N andBool pyMod(I, 2) ==Int 0
+    [simplification]
+  rule vCons(T +Int I,
+             outputFrom(I +Int 1, N, F *Int I, T +Int I))
+    => outputFrom(I, N, F, T)
+    requires I <=Int N andBool notBool (pyMod(I, 2) ==Int 0)
+    [simplification]
+
+  // Associativity is the algebraic fact needed when one append has extended
+  // an arbitrary already-produced prefix before the circularity is reused.
+  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
+    => valSeqConcat(A, valSeqConcat(B, C))
+    [simplification]
+  rule valSeqConcat(A:ValSeq, .ValSeq) => A
+    [simplification]
+endmodule

