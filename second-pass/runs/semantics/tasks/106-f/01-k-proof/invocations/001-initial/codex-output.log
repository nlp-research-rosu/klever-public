+            AugAssign(Name("i"), "+", Int(1)))
+          Return(Name("result")), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
