diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..05ea4c78f980adb4148f6ae5103e145284e39d7f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,39 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The values emitted by the loop from I through N.  F and T are,
+  // respectively, the factorial and triangular accumulators before step I.
+  syntax ValSeq ::= outputFrom(Int, Int, Int, Int) [function]
+  rule outputFrom(I:Int, N:Int, _F:Int, _T:Int) => .ValSeq
+    requires I >Int N
+  rule outputFrom(I:Int, N:Int, F:Int, T:Int)
+    => vCons(F *Int I, outputFrom(I +Int 1, N, F *Int I, T +Int I))
+    requires I <=Int N andBool I %Int 2 ==Int 0
+  rule outputFrom(I:Int, N:Int, F:Int, T:Int)
+    => vCons(T +Int I, outputFrom(I +Int 1, N, F *Int I, T +Int I))
+    requires I <=Int N andBool notBool (I %Int 2 ==Int 0)
+
+  syntax Int ::= factorialAfter(Int, Int, Int) [function]
+  rule factorialAfter(I:Int, N:Int, F:Int) => F
+    requires I >Int N
+  rule factorialAfter(I:Int, N:Int, F:Int)
+    => factorialAfter(I +Int 1, N, F *Int I)
+    requires I <=Int N
+
+  syntax Int ::= totalAfter(Int, Int, Int) [function]
+  rule totalAfter(I:Int, N:Int, T:Int) => T
+    requires I >Int N
+  rule totalAfter(I:Int, N:Int, T:Int)
+    => totalAfter(I +Int 1, N, T +Int I)
+    requires I <=Int N
+
+  // Associativity is the algebraic fact needed when one append has extended
+  // an arbitrary already-produced prefix before the circularity is reused.
+  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
+    => valSeqConcat(A, valSeqConcat(B, C))
+    [simplification]
+  rule valSeqConcat(A:ValSeq, .ValSeq) => A
+    [simplification]
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e2bdbde6b48c84e9a41861456c3afb81f088c06
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def f(n):
+    result = []
+    factorial = 1
+    total = 0
+    i = 1
+    while i <= n:
+        factorial *= i
+        total += i
+        if i % 2 == 0:
+            result.append(factorial)
+        else:
+            result.append(total)
+        i += 1
+    return result
