diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ac3fa24da4d4aeefe6acead672e71c9338ffcd75
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,41 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The values emitted by the loop from I through N.  F and T are,
+  // respectively, the factorial and triangular accumulators before step I.
+  syntax ValSeq ::= outputFrom(Int, Int, Int, Int)
+    [function, total, no-evaluators]
+  rule outputFrom(I:Int, N:Int, _F:Int, _T:Int) => .ValSeq
+    requires I >Int N
+    [simplification]
+  rule valSeqConcat(P:ValSeq,
+          vCons(F *Int I,
+            outputFrom(I +Int 1, N, F *Int I, T +Int I)))
+    => valSeqConcat(P, outputFrom(I, N, F, T))
+    requires I <=Int N andBool pyMod(I, 2) ==Int 0
+    [simplification]
+  rule valSeqConcat(P:ValSeq,
+          vCons(T +Int I,
+            outputFrom(I +Int 1, N, F *Int I, T +Int I)))
+    => valSeqConcat(P, outputFrom(I, N, F, T))
+    requires I <=Int N andBool notBool (pyMod(I, 2) ==Int 0)
+    [simplification]
+  rule outputFrom(I:Int, N:Int, F:Int, _T:Int)
+    => vCons(F *Int I, .ValSeq)
+    requires I ==Int N andBool pyMod(I, 2) ==Int 0
+    [simplification]
+  rule outputFrom(I:Int, N:Int, _F:Int, T:Int)
+    => vCons(T +Int I, .ValSeq)
+    requires I ==Int N andBool notBool (pyMod(I, 2) ==Int 0)
+    [simplification]
+
+  // Associativity is the algebraic fact needed when one append has extended
+  // an arbitrary already-produced prefix before the circularity is reused.
+  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
+    => valSeqConcat(A, valSeqConcat(B, C))
+    [simplification]
+  rule valSeqConcat(A:ValSeq, .ValSeq) => A
+    [simplification]
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /work
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e2bdbde6b48c84e9a41861456c3afb81f088c06
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def f(n):
+    result = []
+    factorial = 1
+    total = 0
+    i = 1
+    while i <= n:
+        factorial *= i
+        total += i
+        if i % 2 == 0:
+            result.append(factorial)
+        else:
+            result.append(total)
+        i += 1
+    return result
