diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..12452c8aabb521e323d51fa33a7b9ef15275552d
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,51 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+cd "$(dirname "$0")"
+
+# Translate the submitted implementation.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Build and exercise the required concrete LLVM semantics.  Assertion failure
+# sets the semantics' exit code to 1, so set -e makes this a hard failure.
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+{
+  sed -n '1,$p' solution.py
+  printf '%s\n' \
+    'assert f(0) == []' \
+    'assert f(1) == [1]' \
+    'assert f(5) == [1, 2, 6, 24, 15]' \
+    'assert f(8) == [1, 2, 6, 24, 15, 720, 28, 40320]'
+} | python3 py2mpy.py /dev/stdin \
+  | krun /dev/stdin --definition runtime-kompiled --output pretty
+
+# Build the symbolic definition from MPY (not MPY-KRUN).
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+# First discharge the loop theorem.  Then use that proved theorem as a lemma
+# for the complete symbolic function-call claim.  The final command proves
+# both independent end-to-end concrete claims.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims loop-correct
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims loop-correct,f-symbolic \
+  --trusted loop-correct
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims f-zero,f-five
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e2bdbde6b48c84e9a41861456c3afb81f088c06
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def f(n):
+    result = []
+    factorial = 1
+    total = 0
+    i = 1
+    while i <= n:
+        factorial *= i
+        total += i
+        if i % 2 == 0:
+            result.append(factorial)
+        else:
+            result.append(total)
+        i += 1
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..ff81e326448a9eb01117c59f7fbe05da2e3ac3cf
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,135 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // General loop invariant.  It applies to the literal loop in solution.mpy.
+  // The bounds make I = N + 1 the unique exit state.
+  claim
+    <k>
+      #while(Compare(Name("i"), CmpOp("<=", Name("n"))),
+        AugAssign(Name("factorial"), "*", Name("i"))
+        AugAssign(Name("total"), "+", Name("i"))
+        If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("factorial"))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("total"))))
+        AugAssign(Name("i"), "+", Int(1)))
+      => .K
+      ...
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(MODULE:Map, parent(-1))
+      1 |-> scope(
+        "factorial" |-> (F:Int => ?FINALF:Int)
+        "i"         |-> (I:Int => N +Int 1)
+        "n"         |-> N:Int
+        "result"    |-> ref(0)
+        "total"     |-> (T:Int => ?FINALT:Int),
+        parent(0))
+    </scopes>
+    <heap>
+      0 |-> (list(PREFIX:ValSeq)
+        => list(valSeqConcat(PREFIX, ?OUTPUT:ValSeq)))
+    </heap>
+    requires 1 <=Int I andBool I <=Int N +Int 1
+    ensures outputOK(?OUTPUT, I, N, F, T)
+    [label(loop-correct)]
+
+  // Complete symbolic call.  prove.sh first proves loop-correct, then makes
+  // that proved invariant available as a lemma while proving this claim.
+  claim
+    <k> Call(Name("f"), Int(N)) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "f" |-> closureVal("n", .ParamNames,
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("factorial"), Int(1))
+          Assign(Name("total"), Int(0))
+          Assign(Name("i"), Int(1))
+          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+            AugAssign(Name("factorial"), "*", Name("i"))
+            AugAssign(Name("total"), "+", Name("i"))
+            If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("factorial"))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("total"))))
+            AugAssign(Name("i"), "+", Int(1)))
+          Return(Name("result")), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(?OUTPUT:ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires N >=Int 0
+    ensures outputOK(?OUTPUT, 1, N, 1, 0)
+    [label(f-symbolic)]
+
+  // End-to-end base case: evaluate the actual f closure on n = 0.
+  claim
+    <k> Call(Name("f"), Int(0)) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "f" |-> closureVal("n", .ParamNames,
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("factorial"), Int(1))
+          Assign(Name("total"), Int(0))
+          Assign(Name("i"), Int(1))
+          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+            AugAssign(Name("factorial"), "*", Name("i"))
+            AugAssign(Name("total"), "+", Name("i"))
+            If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("factorial"))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("total"))))
+            AugAssign(Name("i"), "+", Int(1)))
+          Return(Name("result")), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires true
+    [label(f-zero)]
+
+  // End-to-end prompt example.
+  claim
+    <k> Call(Name("f"), Int(5)) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "f" |-> closureVal("n", .ParamNames,
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("factorial"), Int(1))
+          Assign(Name("total"), Int(0))
+          Assign(Name("i"), Int(1))
+          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+            AugAssign(Name("factorial"), "*", Name("i"))
+            AugAssign(Name("total"), "+", Name("i"))
+            If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("factorial"))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("total"))))
+            AugAssign(Name("i"), "+", Int(1)))
+          Return(Name("result")), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+        vCons(1, vCons(2, vCons(6, vCons(24, vCons(15, .ValSeq))))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires true
+    [label(f-five)]
+endmodule
