@@ -0,0 +1,101 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // General loop invariant.  It applies to the literal loop in solution.mpy.
+  // The bounds make I = N + 1 the unique exit state.
+  claim
+    <k>
+      While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+        AugAssign(Name("factorial"), "*", Name("i"))
+        AugAssign(Name("total"), "+", Name("i"))
+        If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("factorial"))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("total"))))
+        AugAssign(Name("i"), "+", Int(1)))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (L |-> scope(
+        "factorial" |-> (F:Int => factorialAfter(I, N, F))
+        "i"         |-> (I:Int => N +Int 1)
+        "n"         |-> N:Int
+        "result"    |-> ref(H:Int)
+        "total"     |-> (T:Int => totalAfter(I, N, T)),
+        PARENT:Parent))
+      RESTSCOPES:Map
+    </scopes>
+    <heap>
+      (H |-> list(PREFIX:ValSeq)
+        => H |-> list(valSeqConcat(PREFIX, outputFrom(I, N, F, T))))
+      RESTHEAP:Map
+    </heap>
+    requires 1 <=Int I andBool I <=Int N +Int 1
+      andBool notBool (L in_keys(RESTSCOPES))
+      andBool notBool (H in_keys(RESTHEAP))
+
+  // End-to-end base case: evaluate the actual f closure on n = 0.
+  claim
+    <k> Call(Name("f"), Int(0)) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "f" |-> closureVal("n", .ParamNames,
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("factorial"), Int(1))
+          Assign(Name("total"), Int(0))
+          Assign(Name("i"), Int(1))
+          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+            AugAssign(Name("factorial"), "*", Name("i"))
+            AugAssign(Name("total"), "+", Name("i"))
+            If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("factorial"))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("total"))))
+            AugAssign(Name("i"), "+", Int(1)))
+          Return(Name("result")), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires true
+
+  // End-to-end prompt example.
+  claim
+    <k> Call(Name("f"), Int(5)) => ref(0) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "f" |-> closureVal("n", .ParamNames,
+          Assign(Name("result"), ListExpr(.Exprs))
+          Assign(Name("factorial"), Int(1))
+          Assign(Name("total"), Int(0))
+          Assign(Name("i"), Int(1))
+          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+            AugAssign(Name("factorial"), "*", Name("i"))
+            AugAssign(Name("total"), "+", Name("i"))
+            If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("factorial"))),
+              Expr(Call(Attribute(Name("result"), "append"), Name("total"))))
+            AugAssign(Name("i"), "+", Int(1)))
+          Return(Name("result")), 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      => 0 |-> list(
+        vCons(1, vCons(2, vCons(6, vCons(24, vCons(15, .ValSeq))))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    requires true
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..05ea4c78f980adb4148f6ae5103e145284e39d7f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,39 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The values emitted by the loop from I through N.  F and T are,
+  // respectively, the factorial and triangular accumulators before step I.
+  syntax ValSeq ::= outputFrom(Int, Int, Int, Int) [function]
+  rule outputFrom(I:Int, N:Int, _F:Int, _T:Int) => .ValSeq
+    requires I >Int N
+  rule outputFrom(I:Int, N:Int, F:Int, T:Int)
+    => vCons(F *Int I, outputFrom(I +Int 1, N, F *Int I, T +Int I))
+    requires I <=Int N andBool I %Int 2 ==Int 0
+  rule outputFrom(I:Int, N:Int, F:Int, T:Int)
+    => vCons(T +Int I, outputFrom(I +Int 1, N, F *Int I, T +Int I))
+    requires I <=Int N andBool notBool (I %Int 2 ==Int 0)
+
+  syntax Int ::= factorialAfter(Int, Int, Int) [function]
+  rule factorialAfter(I:Int, N:Int, F:Int) => F
+    requires I >Int N
+  rule factorialAfter(I:Int, N:Int, F:Int)
+    => factorialAfter(I +Int 1, N, F *Int I)
+    requires I <=Int N
+
+  syntax Int ::= totalAfter(Int, Int, Int) [function]
+  rule totalAfter(I:Int, N:Int, T:Int) => T
+    requires I >Int N
+  rule totalAfter(I:Int, N:Int, T:Int)
+    => totalAfter(I +Int 1, N, T +Int I)
+    requires I <=Int N
+
+  // Associativity is the algebraic fact needed when one append has extended
+  // an arbitrary already-produced prefix before the circularity is reused.
+  rule valSeqConcat(valSeqConcat(A:ValSeq, B:ValSeq), C:ValSeq)
+    => valSeqConcat(A, valSeqConcat(B, C))
+    [simplification]
+  rule valSeqConcat(A:ValSeq, .ValSeq) => A
+    [simplification]
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..7e2bdbde6b48c84e9a41861456c3afb81f088c06
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def f(n):
+    result = []
+    factorial = 1
+    total = 0
+    i = 1
+    while i <= n:
+        factorial *= i
+        total += i
+        if i % 2 == 0:
+            result.append(factorial)
+        else:
+            result.append(total)
+        i += 1
+    return result
