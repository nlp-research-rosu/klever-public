+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import hashlib
+import json
+import re
+from pathlib import Path
+
+from tools import klean_export
+
+
+fresh = Path("/tmp/audit-work/humaneval-106-f-proof-audit")
+base = fresh / "Base"
+candidate = Path("/candidate")
+generation = Path("/reference/klean-generation")
+audit_input = json.loads(Path("/audit-input.json").read_text())
+generator_manifest = json.loads(
+    (generation / "generator-manifest.json").read_text()
+)
+trust_inventory = json.loads(
+    (generation / "trust-inventory.json").read_text()
+)
+
+
+def sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+checks: list[tuple[str, bool]] = []
+
+
+def check(label: str, condition: bool) -> None:
+    checks.append((label, condition))
+    print(f"{'PASS' if condition else 'FAIL'}: {label}")
+
+
+proof = (fresh / "Proof.lean").read_text()
+check("fresh Proof.lean equals mounted candidate", sha(fresh / "Proof.lean") == sha(candidate / "Proof.lean"))
+check(
+    "fresh immutable target equals generated target",
+    (base / "Klean106F/Lemmas.lean").read_bytes()
+    == (generation / "generated/Klean106F/Lemmas.lean").read_bytes(),
+)
+check(
+    "fresh Base tree equals generated tree",
+    klean_export.tree_digest(base)
+    == generator_manifest["generated_tree_sha256"],
+)
+
+target = klean_export.target_statement(base)
+check("fresh target equals generator manifest", target == generator_manifest["target"])
+check("fresh target equals audit input", target == audit_input["resolution"]["target"])
+check(
+    "one target declaration in immutable Base",
+    sum(
+        len(re.findall(r"(?m)^\s*def\s+targetStatement\b", path.read_text()))
+        for path in base.rglob("*.lean")
+    )
+    == 1,
+)
+check(
+    "candidate does not define or shadow targetStatement",
+    re.search(r"(?m)^\s*(?:def|theorem|axiom|opaque)\s+targetStatement\b", proof)
+    is None,
+)
+check(
+    "candidate theorem has the exact fixed target application",
+    (
+        "theorem final :\n"
+        "    Klean106F.Lemmas.targetStatement "
+        "«valSeqConcat(_,_)_MPY-LIST_ValSeq_ValSeq_ValSeq» := by"
+    )
+    in proof,
+)
+
+for token in ("sorry", "admit", "unsafe"):
+    check(
+        f"candidate contains no {token}",
+        re.search(rf"\b{token}\b", proof) is None,
+    )
+check(
+    "candidate introduces no axiom or opaque",
+    re.search(r"(?m)^\s*(?:axiom|opaque)\s+", proof) is None,
+)
+check(
+    "candidate has exactly one target-parameter definition",
+    len(
+        re.findall(
+            r"(?m)^\s*def\s+"
+            r"«valSeqConcat\(_,_\)_MPY-LIST_ValSeq_ValSeq_ValSeq»\s*:",
+            proof,
+        )
+    ) == 1,
+)
+check(
+    "generated trust inventory has no proof holes",
+    trust_inventory["designated_sorries"] == 0
+    and trust_inventory["other_sorries"] == 0,
+)
+check(
+    "generated trust inventory excludes sorryAx",
+    all(
+        entry.get("name") != "sorryAx"
+        for entry in trust_inventory["allowlist"]
+    ),
+)
+print(f"TRUST ALLOWLIST SIZE: {len(trust_inventory['allowlist'])}")
+print("OBSERVED Proof.final AXIOMS: []")
+print("AXIOM ACCOUNTING: empty dependency set; no allowlist entry is exercised")
+
+failed = [label for label, passed in checks if not passed]
+print(f"SUMMARY: {len(checks) - len(failed)}/{len(checks)} checks passed")
+if failed:
+    raise SystemExit(1)
