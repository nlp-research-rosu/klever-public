     6	# Translate the submitted implementation.
     7	python3 py2mpy.py solution.py > solution.mpy
     8	
     9	# Build and exercise the required concrete LLVM semantics.  Assertion failure
    10	# sets the semantics' exit code to 1, so set -e makes this a hard failure.
    11	kompile reference-semantics/semantics.k \
    12	  --backend llvm \
    13	  --main-module MPY-KRUN \
    14	  --syntax-module MPY-SYNTAX \
    15	  --output-definition runtime-kompiled
    16	
    17	{
    18	  sed -n '1,$p' solution.py
    19	  printf '%s\n' \
    20	    'assert f(0) == []' \
    21	    'assert f(1) == [1]' \
    22	    'assert f(5) == [1, 2, 6, 24, 15]' \
    23	    'assert f(8) == [1, 2, 6, 24, 15, 720, 28, 40320]'
    24	} | python3 py2mpy.py /dev/stdin \
    25	  | krun /dev/stdin --definition runtime-kompiled --output pretty
    26	
    27	# Build the symbolic definition from MPY (not MPY-KRUN).
    28	kompile verification.k \
    29	  --backend haskell \
    30	  --main-module VERIFICATION \
    31	  --syntax-module MPY-SYNTAX \
    32	  --output-definition verification-kompiled
    33	
    34	# First discharge the loop theorem.  Then use that proved theorem as a lemma
    35	# for the complete symbolic function-call claim.  The final command proves
    36	# both independent end-to-end concrete claims.
    37	kprove spec.k \
    38	  --definition verification-kompiled \
    39	  --spec-module SPEC \
    40	  --claims loop-correct
    41	
    42	kprove spec.k \
    43	  --definition verification-kompiled \
    44	  --spec-module SPEC \
    45	  --claims loop-correct,f-symbolic \
    46	  --trusted loop-correct
    47	
    48	kprove spec.k \
    49	  --definition verification-kompiled \
    50	  --spec-module SPEC \
    51	  --claims f-zero,f-five
Script done.

