+import Proof
+
+namespace AuditBridge
+
+abbrev VS := SortValSeq
+
+def empty : VS :=
+  SortValSeq.«.ValSeq_MPY-CORE_ValSeq»
+
+def value : SortVal :=
+  SortVal.«noneV_MPY-CORE_Val»
+
+def singleton : VS :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value empty
+
+def doubleton : VS :=
+  SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» value singleton
+
+abbrev honest :=
+  Proof.«valSeqConcat(_,_)_MPY-LIST_ValSeq_ValSeq_ValSeq»
+
+example : honest empty singleton = singleton := rfl
+example : honest singleton empty = singleton := rfl
+example : honest singleton singleton = doubleton := rfl
+
+def constantEmpty (_ _ : VS) : VS :=
+  empty
+
+def rightProjection (_left right : VS) : VS :=
+  right
+
+def leftProjection (left _right : VS) : VS :=
+  left
+
+def dropHeads : VS → VS → VS
+  | SortValSeq.«.ValSeq_MPY-CORE_ValSeq», suffix => suffix
+  | SortValSeq.«vCons(_,_)_MPY-CORE_ValSeq_Val_ValSeq» _ rest, suffix =>
+      dropHeads rest suffix
+
+theorem constant_empty_rejected :
+    ¬ Klean106F.Lemmas.targetStatement constantEmpty := by
+  intro h
+  have rightIdentity := h.2.1 singleton
+  cases rightIdentity
+
+theorem right_projection_rejected :
+    ¬ Klean106F.Lemmas.targetStatement rightProjection := by
+  intro h
+  have rightIdentity := h.2.1 singleton
+  cases rightIdentity
+
+theorem left_projection_rejected :
+    ¬ Klean106F.Lemmas.targetStatement leftProjection := by
+  intro h
+  have cancellation := h.2.2.1 empty empty singleton
+  have impossible : singleton = empty := cancellation.mp rfl
+  cases impossible
+
+theorem recursive_head_drop_rejected :
+    ¬ Klean106F.Lemmas.targetStatement dropHeads := by
+  intro h
+  have rightIdentity := h.2.1 singleton
+  cases rightIdentity
+
+end AuditBridge
