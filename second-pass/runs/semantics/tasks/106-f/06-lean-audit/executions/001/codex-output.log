+#!/usr/bin/env python3
+
+from __future__ import annotations
+
+import hashlib
+import json
+from pathlib import Path
+
+from tools import klean_export, pipeline_contract
+from tools.k_rule_inventory import canonical_json_sha256, inventory_verification
+
+
+ROOT = Path("/reference")
+STAGE1 = ROOT / "k-proof"
+DISCOVERY_PATH = ROOT / "lemma-discovery.json"
+GENERATION = ROOT / "klean-generation"
+GENERATED = GENERATION / "generated"
+PRODUCERS = ROOT / "generation-tools"
+AUDIT_INPUT_PATH = Path("/audit-input.json")
+CANDIDATE = Path("/candidate")
+
+
+def load(path: Path) -> dict:
+    document = json.loads(path.read_text())
+    if not isinstance(document, dict):
+        raise AssertionError(f"{path} is not an object")
+    return document
+
+
+def file_sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+checks: list[tuple[str, bool, object, object]] = []
+
+
+def check(label: str, observed: object, expected: object) -> None:
+    checks.append((label, observed == expected, observed, expected))
+
+
+audit_input = load(AUDIT_INPUT_PATH)
+resolution = audit_input["resolution"]
+recorded_hashes = resolution["hashes"]
+discovery = load(DISCOVERY_PATH)
+inventory = inventory_verification(STAGE1)
+input_manifest = load(GENERATION / "input-manifest.json")
+generator_manifest = load(GENERATION / "generator-manifest.json")
+obligation_map = load(GENERATED / "obligation-map.json")
+export_result = load(GENERATION / "export-result.json")
+trust_inventory = load(GENERATION / "trust-inventory.json")
+source_manifest = load(PRODUCERS / "source-manifest.json")
+
+check("audit mode", resolution["mode"], "CLASSIFICATION_AND_PROOF")
+check("semantics mode", resolution["semantics_mode"], "SUPPLIED_SEMANTICS")
+check("problem", resolution["problem_id"], "106-f")
+
+# Producer identity, including the launcher-selected immutable image directory.
+producer_hashes = {
+    "klean.py": file_sha(PRODUCERS / "klean.py"),
+    "klean_export.py": file_sha(PRODUCERS / "klean_export.py"),
+}
+check("producer file hashes vs source manifest", producer_hashes, source_manifest["files"])
+check(
+    "producer exporter vs generator manifest",
+    producer_hashes["klean_export.py"],
+    generator_manifest["exporter_sha256"],
+)
+check(
+    "producer klean.py vs generator manifest",
+    producer_hashes["klean.py"],
+    generator_manifest["klean_py_sha256"],
+)
+check(
+    "generator image source/generator",
+    source_manifest["generator_image_id"],
+    generator_manifest["provenance"]["generator_image_id"],
+)
+selected_image_hex = Path(resolution["generation_producer_sources"]).name
+check(
+    "generator image launcher/source manifest",
+    f"sha256:{selected_image_hex}",
+    source_manifest["generator_image_id"],
+)
+check(
+    "producer source tree hash",
+    pipeline_contract.sha256_tree(PRODUCERS),
+    recorded_hashes["generation_producer_sources_sha256"],
+)
+
+# Frozen Stage 1 identities and a line-by-line source-span check.
+check(
+    "verification sha",
+    file_sha(STAGE1 / "verification.k"),
+    resolution["stage1_source_hashes"]["verification.k"],
+)
+check(
+    "Stage 1 export tree",
+    klean_export.tree_digest(STAGE1),
+    recorded_hashes["stage1_export_sha256"],
+)
+observed_stage1_files = {
+    path.relative_to(STAGE1).as_posix(): file_sha(path)
+    for path in sorted(STAGE1.rglob("*"))
+    if path.is_file() and not path.is_symlink()
+}
+check(
+    "all launcher-recorded Stage 1 source hashes",
+    observed_stage1_files,
+    resolution["stage1_source_hashes"],
+)
+check("inventory schema", inventory["schema_version"], 2)
+check("inventory verification module", inventory["verification_module"], "VERIFICATION")
+check("inventory closure", inventory["verification_modules"], ["VERIFICATION"])
+check(
+    "inventory hash recomputed from canonical rule documents",
+    canonical_json_sha256(inventory["rules"]),
+    inventory["inventory_sha256"],
+)
+check(
+    "inventory hash vs discovery",
+    inventory["inventory_sha256"],
+    discovery["inventory_sha256"],
+)
+
+verification_lines = (STAGE1 / "verification.k").read_text().splitlines()
+for index, rule in enumerate(inventory["rules"], 1):
+    normalized = " ".join(rule["text"].split())
+    check(
+        f"rule {index} normalized hash",
+        hashlib.sha256(normalized.encode()).hexdigest(),
+        rule["normalized_sha256"],
+    )
+    check(
+        f"rule {index} source_rule_id",
+        rule["source_rule_id"],
+        f"rule-{rule['normalized_sha256']}",
+    )
+    span_text = "\n".join(
+        verification_lines[rule["start_line"] - 1 : rule["end_line"]]
+    )
+    check(f"rule {index} exact source span", span_text, rule["text"])
+
+inventory_ids = [rule["source_rule_id"] for rule in inventory["rules"]]
+discovery_ids = [rule["source_rule_id"] for rule in discovery["rules"]]
+check("discovery rule identities and order", discovery_ids, inventory_ids)
+check("discovery IDs unique", len(discovery_ids), len(set(discovery_ids)))
+
+# Independent behavior-based classification judgment.
+expected_classes = [
+    "DEFINITION",
+    "DEFINITION",
+    "DEFINITION",
+    "DOMAIN_LEMMA",
+    "DOMAIN_LEMMA",
+    "DOMAIN_LEMMA",
+    "DOMAIN_LEMMA",
+]
+observed_classes = [rule["classification"] for rule in discovery["rules"]]
+check("independent rule classifications", observed_classes, expected_classes)
+for index, (rule, classification) in enumerate(
+    zip(inventory["rules"], observed_classes, strict=True), 1
+):
+    if "simplification" in rule["attributes"]:
+        check(
+            f"simplification rule {index} class allowed",
+            classification in {"DEFINITION", "DOMAIN_LEMMA"},
+            True,
+        )
+
+# Stage 3/4 source-rule and obligation bijection.
+domain_rules = [
+    rule
+    for rule, classification in zip(
+        inventory["rules"], observed_classes, strict=True
+    )
+    if classification == "DOMAIN_LEMMA"
+]
+domain_ids = [rule["source_rule_id"] for rule in domain_rules]
+input_source_rules = input_manifest["source_rules"]
+mapped_source_rules = obligation_map["source_rules"]
+obligations = obligation_map["obligations"]
+obligation_ids = [entry["source_rule_id"] for entry in obligations]
+check(
+    "input manifest domain IDs",
+    [rule["source_rule_id"] for rule in input_source_rules],
+    domain_ids,
+)
+check("obligation-map source rules", mapped_source_rules, input_source_rules)
+check("obligation IDs and order", obligation_ids, domain_ids)
+check("obligation IDs unique", len(obligation_ids), len(set(obligation_ids)))
+check("generator obligation count", generator_manifest["obligation_count"], len(domain_ids))
+check("export obligation count", export_result["obligation_count"], len(domain_ids))
+check("export status", export_result["status"], "OK")
+
+for index, (source, obligation) in enumerate(
+    zip(input_source_rules, obligations, strict=True), 1
+):
+    check(
+        f"obligation {index} source span",
+        obligation["source_span"],
+        {
+            "start_line": source["start_line"],
+            "end_line": source["end_line"],
+        },
+    )
+    for key in (
+        "source_rule_id",
+        "normalized_sha256",
+        "inventory_sha256",
+        "discovery_manifest_sha256",
+    ):
+        check(f"obligation {index} provenance {key}", obligation[key], source[key])
+    check(
+        f"obligation {index} conjunct hash",
+        hashlib.sha256(obligation["lean_conjunct"].encode()).hexdigest(),
+        obligation["lean_conjunct_sha256"],
+    )
+    check(
+        f"obligation {index} is nonempty/nontrivial text",
+        obligation["lean_conjunct"].strip() not in {"", "True", "False"},
+        True,
+    )
+
+# Fixed target, parameter binding, and sidecar hashes.
+actual_target = klean_export.target_statement(GENERATED)
+expected_definition = klean_export.expected_target_definition(obligation_map)
+check("target exists", actual_target is not None, True)
+check("target vs generator manifest", actual_target, generator_manifest["target"])
+check("target vs launcher", actual_target, resolution["target"])
+check(
+    "target expected-definition hash",
+    hashlib.sha256(expected_definition.encode()).hexdigest(),
+    actual_target["definition_sha256"],
+)
+check(
+    "target statement hash",
+    hashlib.sha256(actual_target["statement"].encode()).hexdigest(),
+    actual_target["statement_sha256"],
+)
+for index, parameter in enumerate(actual_target["parameters"], 1):
+    binding = {
+        key: parameter[key]
+        for key in ("kore_symbol", "name", "type", "source_rule_ids")
+    }
+    check(
+        f"target parameter {index} binding hash",
+        hashlib.sha256(
+            json.dumps(
+                binding,
+                sort_keys=True,
+                separators=(",", ":"),
+            ).encode()
+        ).hexdigest(),
+        parameter["binding_sha256"],
+    )
+    check(
+        f"target parameter {index} source IDs",
+        parameter["source_rule_ids"],
+        domain_ids,
+    )
+
+check(
+    "obligation-map file hash",
+    file_sha(GENERATED / "obligation-map.json"),
+    generator_manifest["obligation_map_sha256"],
+)
+check(
+    "generated project tree",
+    klean_export.tree_digest(GENERATED),
+    generator_manifest["generated_tree_sha256"],
+)
+check(
+    "generated project tree vs launcher",
+    generator_manifest["generated_tree_sha256"],
+    recorded_hashes["generated_tree_sha256"],
+)
+check(
+    "Stage 4 generation artifact tree",
+    pipeline_contract.sha256_tree(GENERATION),
+    recorded_hashes["klean_generation_sha256"],
+)
+check(
+    "selected Stage 2 audit artifact tree",
+    pipeline_contract.sha256_tree(ROOT / "k-audit"),
+    recorded_hashes["k_audit_sha256"],
+)
+check(
+    "candidate Stage 5 workspace tree",
+    pipeline_contract.sha256_tree(CANDIDATE),
+    recorded_hashes["lean_workspace_sha256"],
+)
+check(
+    "discovery file hash",
+    file_sha(DISCOVERY_PATH),
+    recorded_hashes["discovery_manifest_sha256"],
+)
+check(
+    "discovery provenance in input manifest",
+    input_manifest["stage3_discovery_manifest_sha256"],
+    recorded_hashes["discovery_manifest_sha256"],
+)
+check(
+    "inventory provenance in generator manifest",
+    generator_manifest["provenance"]["inventory_sha256"],
+    inventory["inventory_sha256"],
+)
+check(
+    "toolchain lock",
+    generator_manifest["toolchain"],
+    load(ROOT / "klean-toolchain.lock.json"),
+)
+check(
+    "trust inventory file hash in export result",
+    export_result["trust_inventory_sha256"],
+    file_sha(GENERATION / "trust-inventory.json"),
+)
+check("trust inventory designated sorries", trust_inventory["designated_sorries"], 0)
+check("trust inventory other sorries", trust_inventory["other_sorries"], 0)
+
+failed = [entry for entry in checks if not entry[1]]
+for label, passed, observed, expected in checks:
+    print(f"{'PASS' if passed else 'FAIL'}: {label}")
+    if not passed:
+        print(f"  observed={observed!r}")
+        print(f"  expected={expected!r}")
+print(f"SUMMARY: {len(checks) - len(failed)}/{len(checks)} checks passed")
+if failed:
+    raise SystemExit(1)

