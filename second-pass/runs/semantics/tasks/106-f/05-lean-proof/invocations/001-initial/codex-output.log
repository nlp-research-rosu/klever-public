codex
The launcher failure is environmental, not a Lean error: this container’s numeric `/proc/<getpid>/exe` entries are absent even though `/proc/self/exe` works, and Lean 4.22 resolves its executable through the numeric path. I’m using a temporary `readlink` compatibility shim that redirects only `/proc/<digits>/exe` to `/proc/self/exe`; the pinned Lean/Lake installation and project files remain unchanged.
apply patch
patch: completed
/tmp/lean-proc-exe-shim.c
diff --git a//tmp/lean-proc-exe-shim.c b//tmp/lean-proc-exe-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..a68be38e47ce3d026a60447f8d709cc08fc3d241
--- /dev/null
+++ b//tmp/lean-proc-exe-shim.c
@@ -0,0 +1,30 @@
+#define _GNU_SOURCE
+
+#include <ctype.h>
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    static readlink_fn real_readlink = NULL;
+    if (real_readlink == NULL) {
+        real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+    }
+
+    const char *cursor = path;
+    if (strncmp(cursor, "/proc/", 6) == 0) {
+        cursor += 6;
+        const char *digits = cursor;
+        while (isdigit((unsigned char)*cursor)) {
+            ++cursor;
+        }
+        if (cursor != digits && strcmp(cursor, "/exe") == 0) {
+            path = "/proc/self/exe";
+        }
+    }
+
+    return real_readlink(path, buffer, size);
+}
