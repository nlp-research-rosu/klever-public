+        ("is_good" |-> isGoodClosure) MODULELOCALS:Map,
+        parent(-1)))
+    </scopes>
+    <scopeLoc> N </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HEAPLOC </heapLoc>
+    <stack> STACK </stack>
