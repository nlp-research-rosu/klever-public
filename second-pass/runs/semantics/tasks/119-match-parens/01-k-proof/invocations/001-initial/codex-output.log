+      BinOp(
+        "+",
+        Subscript(Name("lst"), Int(1)),
+        Subscript(Name("lst"), Int(0)))),
+      Return(Str("Yes")),
+      )
+    Return(Str("No")))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str("()("), Str(")"))),
+    CmpOp("==", Str("Yes"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str(")"), Str(")"))),
+    CmpOp("==", Str("No"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str(""), Str(""))),
+    CmpOp("==", Str("Yes"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str(")"), Str("("))),
+    CmpOp("==", Str("Yes"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str("(()"), Str("("))),
+    CmpOp("==", Str("No")))))
