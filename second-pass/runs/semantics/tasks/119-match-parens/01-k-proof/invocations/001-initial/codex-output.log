+                         _PARENT:Parent) ...
+       </scopes>
+    requires B <Int 0
+    [priority(40)]
+
+  rule <k> If(Compare(Name("balance"), CmpOp("<", Int(0))),
+              _THEN:Stmts, ELSE:Stmts) => ELSE ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B >=Int 0
+    [priority(40)]
+
+  rule <k> If(Compare(Name("balance"), CmpOp("==", Int(0))),
+              THEN:Stmts, _ELSE:Stmts) => THEN ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B ==Int 0
