+       </scopes>
+    requires C ==Int 40
+    [priority(40)]
+
+  rule <k> Compare(Name("char"), CmpOp("==", Str("(")))
+        => false ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C =/=Int 40
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("<", Int(0)))
+        => true ... </k>
+       <env> L:Int </env>
+       <scopes>
