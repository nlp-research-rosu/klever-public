+      => goodValue(S, B) ~> CONT
+    </k>
+    <env> N => CALLER </env>
+    <scopes>
+      BASE:Map
+      (N |-> scope(
+        ("s" |-> str(INPUT:IntSeq))
+        ("balance" |-> B)
