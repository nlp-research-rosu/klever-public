+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C =/=Int 40
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("<", Int(0)))
+        => true ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B <Int 0
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("<", Int(0)))
+        => false ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B >=Int 0
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("==", Int(0)))
+        => true ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B ==Int 0
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("==", Int(0)))
+        => false ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B =/=Int 0
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("char"), CmpOp("==", Str("("))),
+               THEN:Stmts, _ELSE:Stmts):Stmt) => THEN ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
