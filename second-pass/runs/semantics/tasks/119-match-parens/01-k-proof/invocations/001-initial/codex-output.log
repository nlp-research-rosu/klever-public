+  // the program.  The reference semantics' generated strictness coolers only
+  // recognize constructor results, so hooked comparisons over symbolic Ints
+  // otherwise remain under a freezer.  These rules are the corresponding
+  // MPY lookup/applyCmp/If transitions fused into one step.
+  rule <k> Compare(Name("char"), CmpOp("==", Str("(")))
+        => true ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C ==Int 40
+    [priority(40)]
+
+  rule <k> Compare(Name("char"), CmpOp("==", Str("(")))
+        => false ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C =/=Int 40
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("<", Int(0)))
+        => true ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B <Int 0
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("<", Int(0)))
+        => false ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B >=Int 0
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("==", Int(0)))
+        => true ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B ==Int 0
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("==", Int(0)))
+        => false ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B =/=Int 0
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("char"), CmpOp("==", Str("("))),
+               THEN:Stmts, _ELSE:Stmts):Stmt) => THEN ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C ==Int 40
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("char"), CmpOp("==", Str("("))),
+               _THEN:Stmts, ELSE:Stmts):Stmt) => ELSE ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C =/=Int 40
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("balance"), CmpOp("<", Int(0))),
+               THEN:Stmts, _ELSE:Stmts):Stmt) => THEN ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B <Int 0
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("balance"), CmpOp("<", Int(0))),
+               _THEN:Stmts, ELSE:Stmts):Stmt) => ELSE ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B >=Int 0
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("balance"), CmpOp("==", Int(0))),
+               THEN:Stmts, _ELSE:Stmts):Stmt) => THEN ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B ==Int 0
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("balance"), CmpOp("==", Int(0))),
+               _THEN:Stmts, ELSE:Stmts):Stmt) => ELSE ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B =/=Int 0
+    [priority(40)]
+
+  // The exact statement bodies emitted in solution.mpy.  Giving them names
+  // keeps the configuration patterns in spec.k readable.
+  syntax Stmts ::= "isGoodLoopBody" [function]
+  rule isGoodLoopBody
+    => If(Compare(Name("char"), CmpOp("==", Str("("))),
+          AugAssign(Name("balance"), "+", Int(1)) .Stmts,
+          AugAssign(Name("balance"), "-", Int(1)) .Stmts)
+       If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Str("")) .Stmts,
+          .Stmts)
+       .Stmts
+
+  syntax Stmts ::= "isGoodBody" [function]
+  rule isGoodBody
+    => Assign(Name("balance"), Int(0))
+       For(Name("char"), Name("s"), isGoodLoopBody)
+       If(Compare(Name("balance"), CmpOp("==", Int(0))),
+          Return(Str("T")) .Stmts,
+          .Stmts)
+       Return(Str(""))
+       .Stmts
