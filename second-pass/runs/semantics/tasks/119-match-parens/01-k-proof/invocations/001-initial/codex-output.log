+    <env> N => CALLER </env>
+    <scopes>
+      BASE:Map
+      (N |-> scope(
+        ("s" |-> str(INPUT:IntSeq))
+        ("balance" |-> B)
+        ("char" |-> OLDCHAR:Val),
+        parent(0)))
+      => BASE
+    </scopes>
+    <scopeLoc> N +Int 1 => N </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HEAPLOC </heapLoc>
+    <stack>
