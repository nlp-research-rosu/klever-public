+Module(
+  FuncDef("is_good", Params("s"),
+    Assign(Name("balance"), Int(0))
+    For(Name("char"), Name("s"),
+      If(Compare(Name("char"), CmpOp("==", Str("("))),
+        AugAssign(Name("balance"), "+", Int(1)),
+        AugAssign(Name("balance"), "-", Int(1)))
+      If(Compare(Name("balance"), CmpOp("<", Int(0))),
+        Return(Bool(false)),
+        ))
+    If(Compare(Name("balance"), CmpOp("==", Int(0))),
+      Return(Bool(true)),
+      )
+    Return(Bool(false)))
+  FuncDef("match_parens", Params("lst"),
+    If(Call(
+      Name("is_good"),
+      BinOp(
+        "+",
+        Subscript(Name("lst"), Int(0)),
+        Subscript(Name("lst"), Int(1)))),
+      Return(Str("Yes")),
+      )
+    If(Call(
+      Name("is_good"),
+      BinOp(
+        "+",
+        Subscript(Name("lst"), Int(1)),
+        Subscript(Name("lst"), Int(0)))),
+      Return(Str("Yes")),
+      )
+    Return(Str("No")))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str("()("), Str(")"))),
+    CmpOp("==", Str("Yes"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str(")"), Str(")"))),
+    CmpOp("==", Str("No"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str(""), Str(""))),
+    CmpOp("==", Str("Yes"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str(")"), Str("("))),
+    CmpOp("==", Str("Yes"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str("(()"), Str("("))),
+    CmpOp("==", Str("No")))))
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..18197deb004b0128ea15a3e0e62212861ab67669
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,20 @@
+def is_good(s):
+    balance = 0
+    for char in s:
+        if char == '(':
+            balance += 1
+        else:
+            balance -= 1
+        if balance < 0:
+            return False
+    if balance == 0:
+        return True
+    return False
+
+
+def match_parens(lst):
+    if is_good(lst[0] + lst[1]):
+        return 'Yes'
+    if is_good(lst[1] + lst[0]):
+        return 'Yes'
+    return 'No'
