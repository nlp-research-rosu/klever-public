+      BASE:Map
+      (0 |-> scope(
+        ("is_good" |-> isGoodClosure) MODULELOCALS:Map,
+        parent(-1)))
+    </scopes>
+    <scopeLoc> N </scopeLoc>
+    <heap> HEAP </heap>
