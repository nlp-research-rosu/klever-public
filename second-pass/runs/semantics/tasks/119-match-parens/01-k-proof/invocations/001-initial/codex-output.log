+    Call(Name("match_parens"), ListExpr(Str("(()"), Str("("))),
+    CmpOp("==", Str("No")))))
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..18197deb004b0128ea15a3e0e62212861ab67669
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,20 @@
+def is_good(s):
+    balance = 0
+    for char in s:
+        if char == '(':
+            balance += 1
+        else:
+            balance -= 1
+        if balance < 0:
+            return False
+    if balance == 0:
+        return True
+    return False
+
+
+def match_parens(lst):
+    if is_good(lst[0] + lst[1]):
+        return 'Yes'
+    if is_good(lst[1] + lst[0]):
+        return 'Yes'
+    return 'No'
