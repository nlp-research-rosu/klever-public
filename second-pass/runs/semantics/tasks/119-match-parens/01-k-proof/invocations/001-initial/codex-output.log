+    For(Name("char"), Name("s"),
+      If(Compare(Name("char"), CmpOp("==", Str("("))),
+        AugAssign(Name("balance"), "+", Int(1)),
+        AugAssign(Name("balance"), "-", Int(1)))
+      If(Compare(Name("balance"), CmpOp("<", Int(0))),
+        Return(Bool(false)),
+        ))
+    If(Compare(Name("balance"), CmpOp("==", Int(0))),
+      Return(Bool(true)),
+      )
+    Return(Bool(false)))
+  FuncDef("match_parens", Params("lst"),
+    If(Call(
+      Name("is_good"),
+      BinOp(
+        "+",
+        Subscript(Name("lst"), Int(0)),
+        Subscript(Name("lst"), Int(1)))),
+      Return(Str("Yes")),
+      )
+    If(Call(
+      Name("is_good"),
+      BinOp(
+        "+",
+        Subscript(Name("lst"), Int(1)),
+        Subscript(Name("lst"), Int(0)))),
+      Return(Str("Yes")),
+      )
+    Return(Str("No")))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str("()("), Str(")"))),
+    CmpOp("==", Str("Yes"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str(")"), Str(")"))),
+    CmpOp("==", Str("No"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str(""), Str(""))),
+    CmpOp("==", Str("Yes"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str(")"), Str("("))),
+    CmpOp("==", Str("Yes"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str("(()"), Str("("))),
+    CmpOp("==", Str("No")))))
