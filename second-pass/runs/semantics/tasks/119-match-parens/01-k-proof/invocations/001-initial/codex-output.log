+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str(")"), Str("("))),
+    CmpOp("==", Str("Yes"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str("(()"), Str("("))),
+    CmpOp("==", Str("No")))))
