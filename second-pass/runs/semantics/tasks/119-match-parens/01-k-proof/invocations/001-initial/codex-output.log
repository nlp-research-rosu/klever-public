new file mode 100644
index 0000000000000000000000000000000000000000..e9d0d9c03cca7a71382a69f09633f4a9c3c76ed4
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,18 @@
+def is_good(s):
+    balance = 0
+    for char in s:
+        if char == '(':
+            balance += 1
+        else:
+            balance -= 1
+        if balance < 0:
+            return False
+    return balance == 0
+
+
+def match_parens(lst):
+    if is_good(lst[0] + lst[1]):
+        return 'Yes'
+    if is_good(lst[1] + lst[0]):
+        return 'Yes'
+    return 'No'

