+    [priority(40)]
+
+  rule <k> (AugAssign(Name("balance"), "+", Int(1)):Stmt)
+        => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           M:Map => M [ "balance" <- B +Int 1 ],
+           P:Parent) ...
+       </scopes>
+    requires "balance" in_keys(M)
+     andBool {M["balance"]}:>Val ==K B
+     andBool notBool ("$cells" in_keys(M))
+    [priority(40)]
+
+  rule <k> (AugAssign(Name("balance"), "-", Int(1)):Stmt)
+        => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           M:Map => M [ "balance" <- B -Int 1 ],
+           P:Parent) ...
+       </scopes>
+    requires "balance" in_keys(M)
+     andBool {M["balance"]}:>Val ==K B
+     andBool notBool ("$cells" in_keys(M))
+    [priority(40)]
+
+  rule <k> (For(Name("char"), Name("s"), BODY:Stmts):Stmt)
+        => #loop(str(S), Name("char"), BODY) ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("s" |-> str(S:IntSeq)) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    [priority(40)]
+
+  // Symbolic call/branch continuation for the two exact calls made by
+  // match_parens.  This is the reference Call + strict If behavior specialized
+  // to the constructor-valued truthy/falsey strings returned by is_good.
+  syntax KItem ::= #goodBranch(Stmts, Stmts)
+
+  rule <k> (If(
+              Call(Name("is_good"),
+                BinOp("+",
+                  Subscript(Name("lst"), Int(0)),
+                  Subscript(Name("lst"), Int(1)))),
+              THEN:Stmts, ELSE:Stmts):Stmt)
+        => #applyK(
+             toCall(isGoodClosure),
+             (str(seqConcat(A, B)), .Vals))
+           ~> #goodBranch(THEN, ELSE) ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+               "lst" |-> list(vCons(str(A:IntSeq),
+                               vCons(str(B:IntSeq), .ValSeq))),
+               parent(0))
+             0 |-> scope(
+               ("is_good" |-> GOOD:Val) _MODULE:Map,
+               parent(-1)) ...
+       </scopes>
+    requires GOOD ==K isGoodClosure
+    [priority(40)]
+
+  rule <k> (If(
+              Call(Name("is_good"),
+                BinOp("+",
+                  Subscript(Name("lst"), Int(1)),
+                  Subscript(Name("lst"), Int(0)))),
+              THEN:Stmts, ELSE:Stmts):Stmt)
+        => #applyK(
+             toCall(isGoodClosure),
+             (str(seqConcat(B, A)), .Vals))
+           ~> #goodBranch(THEN, ELSE) ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+               "lst" |-> list(vCons(str(A:IntSeq),
+                               vCons(str(B:IntSeq), .ValSeq))),
+               parent(0))
+             0 |-> scope(
+               ("is_good" |-> GOOD:Val) _MODULE:Map,
+               parent(-1)) ...
+       </scopes>
+    requires GOOD ==K isGoodClosure
+    [priority(40)]
+
+  rule <k> str(iCons(84, .IntSeq))
+           ~> #goodBranch(THEN:Stmts, _ELSE:Stmts)
+        => THEN ... </k>
+  rule <k> str(.IntSeq)
+           ~> #goodBranch(_THEN:Stmts, ELSE:Stmts)
+        => ELSE ... </k>
+
+  // The same strictness limitation affects Return after a literal Str has
+  // become a constructor Val.  All returns in solution.py are string
+  // literals, so fuse literal evaluation with MPY-FUNCTIONS' Return rule.
+  rule <k> (Return(Str(S:String)):Stmt) ~> _ => #pop </k>
+       <ret> noRet => retV(str(strToCodes(S))) </ret>
+    [priority(40)]
+
+  // Proof-only symbolic execution lemmas for the three comparisons used by
+  // the program.  The reference semantics' generated strictness coolers only
+  // recognize constructor results, so hooked comparisons over symbolic Ints
+  // otherwise remain under a freezer.  These rules are the corresponding
+  // MPY lookup/applyCmp/If transitions fused into one step.
+  rule <k> Compare(Name("char"), CmpOp("==", Str("(")))
+        => true ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C ==Int 40
+    [priority(40)]
+
+  rule <k> Compare(Name("char"), CmpOp("==", Str("(")))
+        => false ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C =/=Int 40
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("<", Int(0)))
+        => true ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B <Int 0
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("<", Int(0)))
+        => false ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B >=Int 0
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("==", Int(0)))
+        => true ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B ==Int 0
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("==", Int(0)))
+        => false ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B =/=Int 0
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("char"), CmpOp("==", Str("("))),
+               THEN:Stmts, _ELSE:Stmts):Stmt) => THEN ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C ==Int 40
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("char"), CmpOp("==", Str("("))),
+               _THEN:Stmts, ELSE:Stmts):Stmt) => ELSE ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C =/=Int 40
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("balance"), CmpOp("<", Int(0))),
+               THEN:Stmts, _ELSE:Stmts):Stmt) => THEN ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B <Int 0
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("balance"), CmpOp("<", Int(0))),
+               _THEN:Stmts, ELSE:Stmts):Stmt) => ELSE ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B >=Int 0
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("balance"), CmpOp("==", Int(0))),
+               THEN:Stmts, _ELSE:Stmts):Stmt) => THEN ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B ==Int 0
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("balance"), CmpOp("==", Int(0))),
+               _THEN:Stmts, ELSE:Stmts):Stmt) => ELSE ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B =/=Int 0
+    [priority(40)]
+
+  // The exact statement bodies emitted in solution.mpy.  Giving them names
+  // keeps the configuration patterns in spec.k readable.
+  syntax Stmts ::= "isGoodLoopBody" [function]
+  rule isGoodLoopBody
+    => If(Compare(Name("char"), CmpOp("==", Str("("))),
+          AugAssign(Name("balance"), "+", Int(1)) .Stmts,
+          AugAssign(Name("balance"), "-", Int(1)) .Stmts)
+       If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Str("")) .Stmts,
+          .Stmts)
+       .Stmts
+
+  syntax Stmts ::= "isGoodBody" [function]
+  rule isGoodBody
+    => Assign(Name("balance"), Int(0))
+       For(Name("char"), Name("s"), isGoodLoopBody)
+       If(Compare(Name("balance"), CmpOp("==", Int(0))),
+          Return(Str("T")) .Stmts,
+          .Stmts)
+       Return(Str(""))
+       .Stmts
+
+  syntax Stmts ::= "matchParensBody" [function]
+  rule matchParensBody
+    => If(Call(Name("is_good"),
+              BinOp("+",
+                    Subscript(Name("lst"), Int(0)),
+                    Subscript(Name("lst"), Int(1)))),
+          Return(Str("Yes")) .Stmts,
+          .Stmts)
+       If(Call(Name("is_good"),
+              BinOp("+",
+                    Subscript(Name("lst"), Int(1)),
+                    Subscript(Name("lst"), Int(0)))),
+          Return(Str("Yes")) .Stmts,
+          .Stmts)
+       Return(Str("No"))
+       .Stmts
+
+  syntax Val ::= "isGoodClosure" [function]
+  rule isGoodClosure
+    => closureVal(("s", .ParamNames), isGoodBody, 0)
+
+  syntax Val ::= "matchParensClosure" [function]
+  rule matchParensClosure
+    => closureVal(("lst", .ParamNames), matchParensBody, 0)
+
+  // Mathematical balance scan corresponding to is_good.  The implementation
+  // treats every non-'(' character as ')'; the entry theorem restricts inputs
+  // to the two characters promised by the HumanEval contract.
+  syntax Bool ::= goodFrom(IntSeq, Int) [function]
+  rule goodFrom(.IntSeq, B:Int) => B ==Int 0
+  rule goodFrom(iCons(C:Int, R:IntSeq), B:Int)
+    => #if C ==Int 40
+       #then goodFrom(R, B +Int 1)
+       #else #if B ==Int 0
+             #then false
+             #else goodFrom(R, B -Int 1)
+             #fi
+       #fi
+    requires B >=Int 0
+
+  syntax Val ::= goodValue(IntSeq, Int) [function, total]
+  rule goodValue(.IntSeq, B:Int)
+    => #if B ==Int 0
+       #then str(strToCodes("T"))
+       #else str(.IntSeq)
+       #fi
+  rule goodValue(iCons(C:Int, R:IntSeq), B:Int)
+    => #if C ==Int 40
+       #then goodValue(R, B +Int 1)
+       #else #if B -Int 1 <Int 0
+             #then str(.IntSeq)
+             #else goodValue(R, B -Int 1)
+             #fi
+       #fi
+
+  syntax Bool ::= parensOnly(IntSeq) [function, total]
+  rule parensOnly(.IntSeq) => true
+  rule parensOnly(iCons(C:Int, R:IntSeq))
+    => (C ==Int 40 orBool C ==Int 41) andBool parensOnly(R)
+
+  syntax Val ::= expectedAnswer(IntSeq, IntSeq) [function]
+  rule expectedAnswer(A:IntSeq, B:IntSeq) => str(strToCodes("Yes"))
+    requires goodFrom(seqConcat(A, B), 0)
+      orBool goodFrom(seqConcat(B, A), 0)
+  rule expectedAnswer(A:IntSeq, B:IntSeq) => str(strToCodes("No"))
+    requires notBool (goodFrom(seqConcat(A, B), 0)
+      orBool goodFrom(seqConcat(B, A), 0))
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module MATCH-PARENS-VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /work
diff --git a/concrete-tests.mpy b/concrete-tests.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..b0579dc48284e4aaccbb04062e17496f4e72d093
--- /dev/null
+++ b/concrete-tests.mpy
@@ -0,0 +1,47 @@
+Module(
+  FuncDef("is_good", Params("s"),
+    Assign(Name("balance"), Int(0))
+    For(Name("char"), Name("s"),
+      If(Compare(Name("char"), CmpOp("==", Str("("))),
+        AugAssign(Name("balance"), "+", Int(1)),
+        AugAssign(Name("balance"), "-", Int(1)))
+      If(Compare(Name("balance"), CmpOp("<", Int(0))),
+        Return(Str("")),
+        ))
+    If(Compare(Name("balance"), CmpOp("==", Int(0))),
+      Return(Str("T")),
+      )
+    Return(Str("")))
+  FuncDef("match_parens", Params("lst"),
+    If(Call(
+      Name("is_good"),
+      BinOp(
+        "+",
+        Subscript(Name("lst"), Int(0)),
+        Subscript(Name("lst"), Int(1)))),
+      Return(Str("Yes")),
+      )
+    If(Call(
+      Name("is_good"),
+      BinOp(
+        "+",
+        Subscript(Name("lst"), Int(1)),
+        Subscript(Name("lst"), Int(0)))),
+      Return(Str("Yes")),
+      )
+    Return(Str("No")))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str("()("), Str(")"))),
+    CmpOp("==", Str("Yes"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str(")"), Str(")"))),
+    CmpOp("==", Str("No"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str(""), Str(""))),
+    CmpOp("==", Str("Yes"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str(")"), Str("("))),
+    CmpOp("==", Str("Yes"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str("(()"), Str("("))),
+    CmpOp("==", Str("No")))))
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..6e56d10dc3e9d043195f0e3d98a97ab010503d9e
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,20 @@
+def is_good(s):
+    balance = 0
+    for char in s:
+        if char == '(':
+            balance += 1
+        else:
+            balance -= 1
+        if balance < 0:
+            return ''
+    if balance == 0:
+        return 'T'
+    return ''
+
+
+def match_parens(lst):
+    if is_good(lst[0] + lst[1]):
+        return 'Yes'
+    if is_good(lst[1] + lst[0]):
+        return 'Yes'
+    return 'No'
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..42fa84157b0a819e825873949f2e2c03b021f755
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,88 @@
+requires "verification.k"
+
+module MATCH-PARENS-SPEC
+  imports MATCH-PARENS-VERIFICATION
+
+  // Inductive invariant for the semantics' #loop iterator state.  The local
+  // map may already contain "char" after the first iteration.
+  claim
+    <k> #loop(str(S:IntSeq), Name("char"), isGoodLoopBody)
+         ~> If(Compare(Name("balance"), CmpOp("==", Int(0))),
+              Return(Str("T")) .Stmts,
+              .Stmts)
+         ~> Return(Str(""))
+         ~> #endcall
+      => goodValue(S, B) ~> CONT
+    </k>
+    <env> N => CALLER </env>
+    <scopes>
+      BASE:Map
+      (N |-> scope(
+        ("s" |-> str(INPUT:IntSeq))
+        ("balance" |-> B)
+        ("char" |-> OLDCHAR:Val),
+        parent(0)))
+      => BASE
+    </scopes>
+    <scopeLoc> N +Int 1 => N </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HEAPLOC </heapLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, N)) REST
+      => REST
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires B >=Int 0
+     andBool notBool (N in_keys(BASE))
+    [label(loopCorrect), circularity]
+
+  // Correctness of the helper's real closure body and call-frame lifecycle.
+  claim
+    <k> #applyK(toCall(isGoodClosure), (str(S:IntSeq), .Vals))
+         ~> CONT
+      => goodValue(S, 0) ~> CONT
+    </k>
+    <env> CALLER </env>
+    <scopes> SCOPES </scopes>
+    <scopeLoc> N </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HEAPLOC </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool (N in_keys(SCOPES))
+    [label(isGoodCorrect)]
+
+  // Functional correctness of the requested HumanEval entry point.
+  claim
+    <k> #applyK(
+          toCall(matchParensClosure),
+          (list(vCons(str(A:IntSeq),
+                      vCons(str(B:IntSeq), .ValSeq))), .Vals))
+         ~> CONT
+      => expectedAnswer(A, B) ~> CONT
+    </k>
+    <env> CALLER </env>
+    <scopes>
+      BASE:Map
+      (0 |-> scope(
+        ("is_good" |-> isGoodClosure) MODULELOCALS:Map,
+        parent(-1)))
+    </scopes>
+    <scopeLoc> N </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HEAPLOC </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires parensOnly(A) andBool parensOnly(B)
+     andBool notBool (N in_keys(
+       BASE (0 |-> scope(
+         ("is_good" |-> isGoodClosure) MODULELOCALS,
+         parent(-1)))))
+    [label(matchParensCorrect)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a2f715ffc9cffa1837026fbefe572a2d17fb9119
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,349 @@
+requires "reference-semantics/semantics.k"
+
+module MATCH-PARENS-VERIFICATION
+  imports MPY
+
+  // Symbolic normalization of a fresh Map insertion (the hooked operation
+  // already normalizes when the map is ground).
+  rule BASE:Map [ N:Int <- SCOPE:Scope ]
+    => BASE (N |-> SCOPE)
+    requires notBool (N in_keys(BASE))
+    [simplification]
+
+  // Symbolic counterpart of deleting a freshly allocated scope at #pop.
+  // Ground Map update already has this behavior through the MAP hook.
+  rule ((BASE:Map (N:Int |-> _SCOPE:Scope)) [ N <- undef ]) => BASE
+    requires notBool (N in_keys(BASE))
+    [simplification]
+
+  // Targeted symbolic forms of the literal assignment and arithmetic updates
+  // in is_good.  They avoid strictness freezers around primitive Int tokens.
+  rule <k> (Assign(Name("balance"), Int(0)):Stmt) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           M:Map => M [ "balance" <- 0 ],
+           P:Parent) ...
+       </scopes>
+    requires notBool ("$cells" in_keys(M))
+    [priority(40)]
+
+  rule <k> (AugAssign(Name("balance"), "+", Int(1)):Stmt)
+        => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           M:Map => M [ "balance" <- B +Int 1 ],
+           P:Parent) ...
+       </scopes>
+    requires "balance" in_keys(M)
+     andBool {M["balance"]}:>Val ==K B
+     andBool notBool ("$cells" in_keys(M))
+    [priority(40)]
+
+  rule <k> (AugAssign(Name("balance"), "-", Int(1)):Stmt)
+        => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           M:Map => M [ "balance" <- B -Int 1 ],
+           P:Parent) ...
+       </scopes>
+    requires "balance" in_keys(M)
+     andBool {M["balance"]}:>Val ==K B
+     andBool notBool ("$cells" in_keys(M))
+    [priority(40)]
+
+  rule <k> (For(Name("char"), Name("s"), BODY:Stmts):Stmt)
+        => #loop(str(S), Name("char"), BODY) ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("s" |-> str(S:IntSeq)) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    [priority(40)]
+
+  // Symbolic call/branch continuation for the two exact calls made by
+  // match_parens.  This is the reference Call + strict If behavior specialized
+  // to the constructor-valued truthy/falsey strings returned by is_good.
+  syntax KItem ::= #goodBranch(Stmts, Stmts)
+
+  rule <k> (If(
+              Call(Name("is_good"),
+                BinOp("+",
+                  Subscript(Name("lst"), Int(0)),
+                  Subscript(Name("lst"), Int(1)))),
+              THEN:Stmts, ELSE:Stmts):Stmt)
+        => #applyK(
+             toCall(isGoodClosure),
+             (str(seqConcat(A, B)), .Vals))
+           ~> #goodBranch(THEN, ELSE) ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+               "lst" |-> list(vCons(str(A:IntSeq),
+                               vCons(str(B:IntSeq), .ValSeq))),
+               parent(0))
+             0 |-> scope(
+               ("is_good" |-> GOOD:Val) _MODULE:Map,
+               parent(-1)) ...
+       </scopes>
+    requires GOOD ==K isGoodClosure
+    [priority(40)]
+
+  rule <k> (If(
+              Call(Name("is_good"),
+                BinOp("+",
+                  Subscript(Name("lst"), Int(1)),
+                  Subscript(Name("lst"), Int(0)))),
+              THEN:Stmts, ELSE:Stmts):Stmt)
+        => #applyK(
+             toCall(isGoodClosure),
+             (str(seqConcat(B, A)), .Vals))
+           ~> #goodBranch(THEN, ELSE) ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+               "lst" |-> list(vCons(str(A:IntSeq),
+                               vCons(str(B:IntSeq), .ValSeq))),
+               parent(0))
+             0 |-> scope(
+               ("is_good" |-> GOOD:Val) _MODULE:Map,
+               parent(-1)) ...
+       </scopes>
+    requires GOOD ==K isGoodClosure
+    [priority(40)]
+
+  rule <k> str(iCons(84, .IntSeq))
+           ~> #goodBranch(THEN:Stmts, _ELSE:Stmts)
+        => THEN ... </k>
+  rule <k> str(.IntSeq)
+           ~> #goodBranch(_THEN:Stmts, ELSE:Stmts)
+        => ELSE ... </k>
+
+  // The same strictness limitation affects Return after a literal Str has
+  // become a constructor Val.  All returns in solution.py are string
+  // literals, so fuse literal evaluation with MPY-FUNCTIONS' Return rule.
+  rule <k> (Return(Str(S:String)):Stmt) ~> _ => #pop </k>
+       <ret> noRet => retV(str(strToCodes(S))) </ret>
+    [priority(40)]
+
+  // Proof-only symbolic execution lemmas for the three comparisons used by
+  // the program.  The reference semantics' generated strictness coolers only
+  // recognize constructor results, so hooked comparisons over symbolic Ints
+  // otherwise remain under a freezer.  These rules are the corresponding
+  // MPY lookup/applyCmp/If transitions fused into one step.
+  rule <k> Compare(Name("char"), CmpOp("==", Str("(")))
+        => true ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C ==Int 40
+    [priority(40)]
+
+  rule <k> Compare(Name("char"), CmpOp("==", Str("(")))
+        => false ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C =/=Int 40
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("<", Int(0)))
+        => true ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B <Int 0
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("<", Int(0)))
+        => false ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B >=Int 0
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("==", Int(0)))
+        => true ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B ==Int 0
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("==", Int(0)))
+        => false ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B =/=Int 0
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("char"), CmpOp("==", Str("("))),
+               THEN:Stmts, _ELSE:Stmts):Stmt) => THEN ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C ==Int 40
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("char"), CmpOp("==", Str("("))),
+               _THEN:Stmts, ELSE:Stmts):Stmt) => ELSE ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C =/=Int 40
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("balance"), CmpOp("<", Int(0))),
+               THEN:Stmts, _ELSE:Stmts):Stmt) => THEN ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B <Int 0
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("balance"), CmpOp("<", Int(0))),
+               _THEN:Stmts, ELSE:Stmts):Stmt) => ELSE ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B >=Int 0
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("balance"), CmpOp("==", Int(0))),
+               THEN:Stmts, _ELSE:Stmts):Stmt) => THEN ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B ==Int 0
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("balance"), CmpOp("==", Int(0))),
+               _THEN:Stmts, ELSE:Stmts):Stmt) => ELSE ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B =/=Int 0
+    [priority(40)]
+
+  // The exact statement bodies emitted in solution.mpy.  Giving them names
+  // keeps the configuration patterns in spec.k readable.
+  syntax Stmts ::= "isGoodLoopBody" [function]
+  rule isGoodLoopBody
+    => If(Compare(Name("char"), CmpOp("==", Str("("))),
+          AugAssign(Name("balance"), "+", Int(1)) .Stmts,
+          AugAssign(Name("balance"), "-", Int(1)) .Stmts)
+       If(Compare(Name("balance"), CmpOp("<", Int(0))),
+          Return(Str("")) .Stmts,
+          .Stmts)
+       .Stmts
+
+  syntax Stmts ::= "isGoodBody" [function]
+  rule isGoodBody
+    => Assign(Name("balance"), Int(0))
+       For(Name("char"), Name("s"), isGoodLoopBody)
+       If(Compare(Name("balance"), CmpOp("==", Int(0))),
+          Return(Str("T")) .Stmts,
+          .Stmts)
+       Return(Str(""))
+       .Stmts
+
+  syntax Stmts ::= "matchParensBody" [function]
+  rule matchParensBody
+    => If(Call(Name("is_good"),
+              BinOp("+",
+                    Subscript(Name("lst"), Int(0)),
+                    Subscript(Name("lst"), Int(1)))),
+          Return(Str("Yes")) .Stmts,
+          .Stmts)
+       If(Call(Name("is_good"),
+              BinOp("+",
+                    Subscript(Name("lst"), Int(1)),
+                    Subscript(Name("lst"), Int(0)))),
+          Return(Str("Yes")) .Stmts,
+          .Stmts)
+       Return(Str("No"))
+       .Stmts
+
+  syntax Val ::= "isGoodClosure" [function]
+  rule isGoodClosure
+    => closureVal(("s", .ParamNames), isGoodBody, 0)
+
+  syntax Val ::= "matchParensClosure" [function]
+  rule matchParensClosure
+    => closureVal(("lst", .ParamNames), matchParensBody, 0)
+
+  // Mathematical balance scan corresponding to is_good.  The implementation
+  // treats every non-'(' character as ')'; the entry theorem restricts inputs
+  // to the two characters promised by the HumanEval contract.
+  syntax Bool ::= goodFrom(IntSeq, Int) [function]
+  rule goodFrom(.IntSeq, B:Int) => B ==Int 0
+  rule goodFrom(iCons(C:Int, R:IntSeq), B:Int)
+    => #if C ==Int 40
+       #then goodFrom(R, B +Int 1)
+       #else #if B ==Int 0
+             #then false
+             #else goodFrom(R, B -Int 1)
+             #fi
+       #fi
+    requires B >=Int 0
+
+  syntax Val ::= goodValue(IntSeq, Int) [function, total]
+  rule goodValue(.IntSeq, B:Int)
+    => #if B ==Int 0
+       #then str(strToCodes("T"))
+       #else str(.IntSeq)
+       #fi
+  rule goodValue(iCons(C:Int, R:IntSeq), B:Int)
+    => #if C ==Int 40
+       #then goodValue(R, B +Int 1)
+       #else #if B -Int 1 <Int 0
+             #then str(.IntSeq)
+             #else goodValue(R, B -Int 1)
+             #fi
+       #fi
+
+  syntax Bool ::= parensOnly(IntSeq) [function, total]
+  rule parensOnly(.IntSeq) => true
+  rule parensOnly(iCons(C:Int, R:IntSeq))
+    => (C ==Int 40 orBool C ==Int 41) andBool parensOnly(R)
+
+  syntax Val ::= expectedAnswer(IntSeq, IntSeq) [function]
+  rule expectedAnswer(A:IntSeq, B:IntSeq) => str(strToCodes("Yes"))
+    requires goodFrom(seqConcat(A, B), 0)
+      orBool goodFrom(seqConcat(B, A), 0)
+  rule expectedAnswer(A:IntSeq, B:IntSeq) => str(strToCodes("No"))
+    requires notBool (goodFrom(seqConcat(A, B), 0)
+      orBool goodFrom(seqConcat(B, A), 0))
+endmodule

diff --git a/concrete-tests.mpy b/concrete-tests.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..b0579dc48284e4aaccbb04062e17496f4e72d093
--- /dev/null
+++ b/concrete-tests.mpy
@@ -0,0 +1,47 @@
+Module(
+  FuncDef("is_good", Params("s"),
+    Assign(Name("balance"), Int(0))
+    For(Name("char"), Name("s"),
+      If(Compare(Name("char"), CmpOp("==", Str("("))),
+        AugAssign(Name("balance"), "+", Int(1)),
+        AugAssign(Name("balance"), "-", Int(1)))
+      If(Compare(Name("balance"), CmpOp("<", Int(0))),
+        Return(Str("")),
+        ))
+    If(Compare(Name("balance"), CmpOp("==", Int(0))),
+      Return(Str("T")),
+      )
+    Return(Str("")))
+  FuncDef("match_parens", Params("lst"),
+    If(Call(
+      Name("is_good"),
+      BinOp(
+        "+",
+        Subscript(Name("lst"), Int(0)),
+        Subscript(Name("lst"), Int(1)))),
+      Return(Str("Yes")),
+      )
+    If(Call(
+      Name("is_good"),
+      BinOp(
+        "+",
+        Subscript(Name("lst"), Int(1)),
+        Subscript(Name("lst"), Int(0)))),
+      Return(Str("Yes")),
+      )
+    Return(Str("No")))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str("()("), Str(")"))),
+    CmpOp("==", Str("Yes"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str(")"), Str(")"))),
+    CmpOp("==", Str("No"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str(""), Str(""))),
+    CmpOp("==", Str("Yes"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str(")"), Str("("))),
+    CmpOp("==", Str("Yes"))))
+  Assert(Compare(
+    Call(Name("match_parens"), ListExpr(Str("(()"), Str("("))),
+    CmpOp("==", Str("No")))))
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..6e56d10dc3e9d043195f0e3d98a97ab010503d9e
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,20 @@
+def is_good(s):
+    balance = 0
+    for char in s:
+        if char == '(':
+            balance += 1
+        else:
+            balance -= 1
+        if balance < 0:
+            return ''
+    if balance == 0:
+        return 'T'
+    return ''
+
+
+def match_parens(lst):
+    if is_good(lst[0] + lst[1]):
+        return 'Yes'
+    if is_good(lst[1] + lst[0]):
+        return 'Yes'
+    return 'No'
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..42fa84157b0a819e825873949f2e2c03b021f755
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,88 @@
+requires "verification.k"
+
+module MATCH-PARENS-SPEC
+  imports MATCH-PARENS-VERIFICATION
+
+  // Inductive invariant for the semantics' #loop iterator state.  The local
+  // map may already contain "char" after the first iteration.
+  claim
+    <k> #loop(str(S:IntSeq), Name("char"), isGoodLoopBody)
+         ~> If(Compare(Name("balance"), CmpOp("==", Int(0))),
+              Return(Str("T")) .Stmts,
+              .Stmts)
+         ~> Return(Str(""))
+         ~> #endcall
+      => goodValue(S, B) ~> CONT
+    </k>
+    <env> N => CALLER </env>
+    <scopes>
+      BASE:Map
+      (N |-> scope(
+        ("s" |-> str(INPUT:IntSeq))
+        ("balance" |-> B)
+        ("char" |-> OLDCHAR:Val),
+        parent(0)))
+      => BASE
+    </scopes>
+    <scopeLoc> N +Int 1 => N </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HEAPLOC </heapLoc>
+    <stack>
+      ListItem(frame(CONT, CALLER, N)) REST
+      => REST
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires B >=Int 0
+     andBool notBool (N in_keys(BASE))
+    [label(loopCorrect), circularity]
+
+  // Correctness of the helper's real closure body and call-frame lifecycle.
+  claim
+    <k> #applyK(toCall(isGoodClosure), (str(S:IntSeq), .Vals))
+         ~> CONT
+      => goodValue(S, 0) ~> CONT
+    </k>
+    <env> CALLER </env>
+    <scopes> SCOPES </scopes>
+    <scopeLoc> N </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HEAPLOC </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires notBool (N in_keys(SCOPES))
+    [label(isGoodCorrect)]
+
+  // Functional correctness of the requested HumanEval entry point.
+  claim
+    <k> #applyK(
+          toCall(matchParensClosure),
+          (list(vCons(str(A:IntSeq),
+                      vCons(str(B:IntSeq), .ValSeq))), .Vals))
+         ~> CONT
+      => expectedAnswer(A, B) ~> CONT
+    </k>
+    <env> CALLER </env>
+    <scopes>
+      BASE:Map
+      (0 |-> scope(
+        ("is_good" |-> isGoodClosure) MODULELOCALS:Map,
+        parent(-1)))
+    </scopes>
+    <scopeLoc> N </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HEAPLOC </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires parensOnly(A) andBool parensOnly(B)
+     andBool notBool (N in_keys(
+       BASE (0 |-> scope(
+         ("is_good" |-> isGoodClosure) MODULELOCALS,
+         parent(-1)))))
+    [label(matchParensCorrect)]
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a2f715ffc9cffa1837026fbefe572a2d17fb9119
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,349 @@
+requires "reference-semantics/semantics.k"
+
+module MATCH-PARENS-VERIFICATION
+  imports MPY
+
+  // Symbolic normalization of a fresh Map insertion (the hooked operation
+  // already normalizes when the map is ground).
+  rule BASE:Map [ N:Int <- SCOPE:Scope ]
+    => BASE (N |-> SCOPE)
+    requires notBool (N in_keys(BASE))
+    [simplification]
+
+  // Symbolic counterpart of deleting a freshly allocated scope at #pop.
+  // Ground Map update already has this behavior through the MAP hook.
+  rule ((BASE:Map (N:Int |-> _SCOPE:Scope)) [ N <- undef ]) => BASE
+    requires notBool (N in_keys(BASE))
+    [simplification]
+
+  // Targeted symbolic forms of the literal assignment and arithmetic updates
+  // in is_good.  They avoid strictness freezers around primitive Int tokens.
+  rule <k> (Assign(Name("balance"), Int(0)):Stmt) => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           M:Map => M [ "balance" <- 0 ],
+           P:Parent) ...
+       </scopes>
+    requires notBool ("$cells" in_keys(M))
+    [priority(40)]
+
+  rule <k> (AugAssign(Name("balance"), "+", Int(1)):Stmt)
+        => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           M:Map => M [ "balance" <- B +Int 1 ],
+           P:Parent) ...
+       </scopes>
+    requires "balance" in_keys(M)
+     andBool {M["balance"]}:>Val ==K B
+     andBool notBool ("$cells" in_keys(M))
+    [priority(40)]
+
+  rule <k> (AugAssign(Name("balance"), "-", Int(1)):Stmt)
+        => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           M:Map => M [ "balance" <- B -Int 1 ],
+           P:Parent) ...
+       </scopes>
+    requires "balance" in_keys(M)
+     andBool {M["balance"]}:>Val ==K B
+     andBool notBool ("$cells" in_keys(M))
+    [priority(40)]
+
+  rule <k> (For(Name("char"), Name("s"), BODY:Stmts):Stmt)
+        => #loop(str(S), Name("char"), BODY) ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("s" |-> str(S:IntSeq)) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    [priority(40)]
+
+  // Symbolic call/branch continuation for the two exact calls made by
+  // match_parens.  This is the reference Call + strict If behavior specialized
+  // to the constructor-valued truthy/falsey strings returned by is_good.
+  syntax KItem ::= #goodBranch(Stmts, Stmts)
+
+  rule <k> (If(
+              Call(Name("is_good"),
+                BinOp("+",
+                  Subscript(Name("lst"), Int(0)),
+                  Subscript(Name("lst"), Int(1)))),
+              THEN:Stmts, ELSE:Stmts):Stmt)
+        => #applyK(
+             toCall(isGoodClosure),
+             (str(seqConcat(A, B)), .Vals))
+           ~> #goodBranch(THEN, ELSE) ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+               "lst" |-> list(vCons(str(A:IntSeq),
+                               vCons(str(B:IntSeq), .ValSeq))),
+               parent(0))
+             0 |-> scope(
+               ("is_good" |-> GOOD:Val) _MODULE:Map,
+               parent(-1)) ...
+       </scopes>
+    requires GOOD ==K isGoodClosure
+    [priority(40)]
+
+  rule <k> (If(
+              Call(Name("is_good"),
+                BinOp("+",
+                  Subscript(Name("lst"), Int(1)),
+                  Subscript(Name("lst"), Int(0)))),
+              THEN:Stmts, ELSE:Stmts):Stmt)
+        => #applyK(
+             toCall(isGoodClosure),
+             (str(seqConcat(B, A)), .Vals))
+           ~> #goodBranch(THEN, ELSE) ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+               "lst" |-> list(vCons(str(A:IntSeq),
+                               vCons(str(B:IntSeq), .ValSeq))),
+               parent(0))
+             0 |-> scope(
+               ("is_good" |-> GOOD:Val) _MODULE:Map,
+               parent(-1)) ...
+       </scopes>
+    requires GOOD ==K isGoodClosure
+    [priority(40)]
+
+  rule <k> str(iCons(84, .IntSeq))
+           ~> #goodBranch(THEN:Stmts, _ELSE:Stmts)
+        => THEN ... </k>
+  rule <k> str(.IntSeq)
+           ~> #goodBranch(_THEN:Stmts, ELSE:Stmts)
+        => ELSE ... </k>
+
+  // The same strictness limitation affects Return after a literal Str has
+  // become a constructor Val.  All returns in solution.py are string
+  // literals, so fuse literal evaluation with MPY-FUNCTIONS' Return rule.
+  rule <k> (Return(Str(S:String)):Stmt) ~> _ => #pop </k>
+       <ret> noRet => retV(str(strToCodes(S))) </ret>
+    [priority(40)]
+
+  // Proof-only symbolic execution lemmas for the three comparisons used by
+  // the program.  The reference semantics' generated strictness coolers only
+  // recognize constructor results, so hooked comparisons over symbolic Ints
+  // otherwise remain under a freezer.  These rules are the corresponding
+  // MPY lookup/applyCmp/If transitions fused into one step.
+  rule <k> Compare(Name("char"), CmpOp("==", Str("(")))
+        => true ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C ==Int 40
+    [priority(40)]
+
+  rule <k> Compare(Name("char"), CmpOp("==", Str("(")))
+        => false ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C =/=Int 40
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("<", Int(0)))
+        => true ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B <Int 0
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("<", Int(0)))
+        => false ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B >=Int 0
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("==", Int(0)))
+        => true ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B ==Int 0
+    [priority(40)]
+
+  rule <k> Compare(Name("balance"), CmpOp("==", Int(0)))
+        => false ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B =/=Int 0
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("char"), CmpOp("==", Str("("))),
+               THEN:Stmts, _ELSE:Stmts):Stmt) => THEN ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C ==Int 40
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("char"), CmpOp("==", Str("("))),
+               _THEN:Stmts, ELSE:Stmts):Stmt) => ELSE ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("char" |-> str(iCons(C:Int, .IntSeq))) _LOCALS:Map,
+           _PARENT:Parent) ...
+       </scopes>
+    requires C =/=Int 40
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("balance"), CmpOp("<", Int(0))),
+               THEN:Stmts, _ELSE:Stmts):Stmt) => THEN ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(("balance" |-> B:Int) _LOCALS:Map,
+                         _PARENT:Parent) ...
+       </scopes>
+    requires B <Int 0
+    [priority(40)]
+
+  rule <k> (If(Compare(Name("balance"), CmpOp("<", Int(0))),
