+    <env> CALLER </env>
+    <scopes> SCOPES </scopes>
+    <scopeLoc> N </scopeLoc>
+    <heap> HEAP </heap>
+    <heapLoc> HEAPLOC </heapLoc>
+    <stack> STACK </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
