   381	  // Mathematical balance scan corresponding to is_good.  The implementation
   382	  // treats every non-'(' character as ')'; the entry theorem restricts inputs
   383	  // to the two characters promised by the HumanEval contract.
   384	  syntax Bool ::= goodFrom(IntSeq, Int) [function, total]
   385	  rule goodFrom(.IntSeq, B:Int) => B ==Int 0
