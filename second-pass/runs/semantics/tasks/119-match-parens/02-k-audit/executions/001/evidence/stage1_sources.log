     9	    <k> #loop(str(S:IntSeq), Name("char"), isGoodLoopBody)
    10	         ~> If(Compare(Name("balance"), CmpOp("==", Int(0))),
    11	              Return(Str("T")) .Stmts,
    12	              .Stmts)
    13	         ~> Return(Str(""))
    14	         ~> #endcall
    15	      => goodValue(S, B) ~> CONT
    16	    </k>
    17	    <env> N => CALLER </env>
    18	    <scopes>
    19	      BASE:Map
    20	      (N |-> scope(
    21	        ("s" |-> str(INPUT:IntSeq))
    22	        ("balance" |-> B)
    23	        ("char" |-> OLDCHAR:Val),
    24	        parent(0)))
    25	      => BASE
    26	    </scopes>
    27	    <scopeLoc> N +Int 1 => N </scopeLoc>
    28	    <heap> HEAP </heap>
