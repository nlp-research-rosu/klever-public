   387	    => #if C ==Int 40
   388	       #then goodFrom(R, B +Int 1)
   389	       #else #if B -Int 1 <Int 0
   390	             #then false
   391	             #else goodFrom(R, B -Int 1)
   392	             #fi
   393	       #fi
   394	
   395	  syntax Val ::= goodValue(IntSeq, Int) [function, total]
   396	  rule goodValue(.IntSeq, B:Int)
   397	    => #if B ==Int 0
   398	       #then str(strToCodes("T"))
   399	       #else str(.IntSeq)
   400	       #fi
   401	  rule goodValue(iCons(C:Int, R:IntSeq), B:Int)
   402	    => #if C ==Int 40
   403	       #then goodValue(R, B +Int 1)
   404	       #else #if B -Int 1 <Int 0
   405	             #then str(.IntSeq)
   406	             #else goodValue(R, B -Int 1)
   407	             #fi
   408	       #fi
   409	
   410	  syntax Bool ::= parensOnly(IntSeq) [function, total]
   411	  rule parensOnly(.IntSeq) => true
   412	  rule parensOnly(iCons(C:Int, R:IntSeq))
   413	    => (C ==Int 40 orBool C ==Int 41) andBool parensOnly(R)
   414	
   415	  syntax Val ::= expectedAnswer(IntSeq, IntSeq) [function]
   416	  rule expectedAnswer(A:IntSeq, B:IntSeq) => str(strToCodes("Yes"))
   417	    requires goodFrom(seqConcat(A, B), 0)
   418	      orBool goodFrom(seqConcat(B, A), 0)
   419	  rule expectedAnswer(A:IntSeq, B:IntSeq) => str(strToCodes("No"))
   420	    requires notBool (goodFrom(seqConcat(A, B), 0)
   421	      orBool goodFrom(seqConcat(B, A), 0))
