   334	  // The exact statement bodies emitted in solution.mpy.  Giving them names
   335	  // keeps the configuration patterns in spec.k readable.
   336	  syntax Stmts ::= "isGoodLoopBody" [function]
   337	  rule isGoodLoopBody
   338	    => If(Compare(Name("char"), CmpOp("==", Str("("))),
   339	          AugAssign(Name("balance"), "+", Int(1)) .Stmts,
   340	          AugAssign(Name("balance"), "-", Int(1)) .Stmts)
   341	       If(Compare(Name("balance"), CmpOp("<", Int(0))),
