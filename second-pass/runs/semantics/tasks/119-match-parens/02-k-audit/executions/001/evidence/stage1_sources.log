     1	def is_good(s):
     2	    balance = 0
     3	    for char in s:
     4	        if char == '(':
     5	            balance += 1
     6	        else:
     7	            balance -= 1
     8	        if balance < 0:
     9	            return ''
    10	    if balance == 0:
    11	        return 'T'
    12	    return ''
    13	
    14	
    15	def match_parens(lst):
    16	    if is_good(lst[0] + lst[1]):
    17	        return 'Yes'
    18	    if is_good(lst[1] + lst[0]):
    19	        return 'Yes'
    20	    return 'No'
