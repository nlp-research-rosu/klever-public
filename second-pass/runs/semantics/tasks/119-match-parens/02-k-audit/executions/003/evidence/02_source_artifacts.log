===== /candidate/concrete-tests.mpy =====
     1	Module(
     2	  FuncDef("is_good", Params("s"),
     3	    Assign(Name("balance"), Int(0))
     4	    For(Name("char"), Name("s"),
     5	      If(Compare(Name("char"), CmpOp("==", Str("("))),
     6	        AugAssign(Name("balance"), "+", Int(1)),
     7	        AugAssign(Name("balance"), "-", Int(1)))
     8	      If(Compare(Name("balance"), CmpOp("<", Int(0))),
     9	        Return(Str("")),
    10	        ))
    11	    If(Compare(Name("balance"), CmpOp("==", Int(0))),
    12	      Return(Str("T")),
    13	      )
    14	    Return(Str("")))
    15	  FuncDef("match_parens", Params("lst"),
    16	    If(Call(
    17	      Name("is_good"),
    18	      BinOp(
    19	        "+",
    20	        Subscript(Name("lst"), Int(0)),
    21	        Subscript(Name("lst"), Int(1)))),
    22	      Return(Str("Yes")),
    23	      )
    24	    If(Call(
    25	      Name("is_good"),
    26	      BinOp(
    27	        "+",
    28	        Subscript(Name("lst"), Int(1)),
    29	        Subscript(Name("lst"), Int(0)))),
    30	      Return(Str("Yes")),
    31	      )
    32	    Return(Str("No")))
    33	  Assert(Compare(
    34	    Call(Name("match_parens"), ListExpr(Str("()("), Str(")"))),
    35	    CmpOp("==", Str("Yes"))))
    36	  Assert(Compare(
    37	    Call(Name("match_parens"), ListExpr(Str(")"), Str(")"))),
    38	    CmpOp("==", Str("No"))))
    39	  Assert(Compare(
    40	    Call(Name("match_parens"), ListExpr(Str(""), Str(""))),
    41	    CmpOp("==", Str("Yes"))))
    42	  Assert(Compare(
    43	    Call(Name("match_parens"), ListExpr(Str(")"), Str("("))),
    44	    CmpOp("==", Str("Yes"))))
    45	  Assert(Compare(
    46	    Call(Name("match_parens"), ListExpr(Str("(()"), Str("("))),
    47	    CmpOp("==", Str("No")))))

