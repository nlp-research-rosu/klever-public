     6	def match_parens(lst):
     7	    '''
     8	    You are given a list of two strings, both strings consist of open
     9	    parentheses '(' or close parentheses ')' only.
    10	    Your job is to check if it is possible to concatenate the two strings in
    11	    some order, that the resulting string will be good.
    12	    A string S is considered to be good if and only if all parentheses in S
    13	    are balanced. For example: the string '(())()' is good, while the string
    14	    '())' is not.
    15	    Return 'Yes' if there's a way to make a good string, and return 'No' otherwise.
    16	
    17	    Examples:
    18	    match_parens(['()(', ')']) == 'Yes'
    19	    match_parens([')', ')']) == 'No'
    20	    '''
    21	    def check(s):
    22	        val = 0
    23	        for i in s:
    24	            if i == '(':
    25	                val = val + 1
    26	            else:
    27	                val = val - 1
    28	            if val < 0:
    29	                return False
    30	        return True if val == 0 else False
    31	
    32	    S1 = lst[0] + lst[1]
    33	    S2 = lst[1] + lst[0]
    34	    return 'Yes' if check(S1) or check(S2) else 'No'
===== /candidate/solution.py =====
     1	def is_good(s):
     2	    balance = 0
     3	    for char in s:
     4	        if char == '(':
     5	            balance += 1
     6	        else:
     7	            balance -= 1
     8	        if balance < 0:
     9	            return ''
    10	    if balance == 0:
    11	        return 'T'
    12	    return ''
    13	
    14	
    15	def match_parens(lst):
    16	    if is_good(lst[0] + lst[1]):
    17	        return 'Yes'
    18	    if is_good(lst[1] + lst[0]):
    19	        return 'Yes'
    20	    return 'No'
