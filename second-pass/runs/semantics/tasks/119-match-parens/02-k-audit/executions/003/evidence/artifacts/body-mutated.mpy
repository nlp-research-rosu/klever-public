Module(
  FuncDef("is_good", Params("s"),
    Return(Str("")))
  FuncDef("match_parens", Params("lst"),
    If(Call(
      Name("is_good"),
      BinOp(
        "+",
        Subscript(Name("lst"), Int(0)),
        Subscript(Name("lst"), Int(1)))),
      Return(Str("Yes")),
      )
    If(Call(
      Name("is_good"),
      BinOp(
        "+",
        Subscript(Name("lst"), Int(1)),
        Subscript(Name("lst"), Int(0)))),
      Return(Str("Yes")),
      )
    Return(Str("No"))))
