index 0000000000000000000000000000000000000000..b5457eeef1e5ddbec6308dc16c6f403fc6de6676
--- /dev/null
+++ b//tmp/audit-work/119-match-parens/audit-concrete.py
@@ -0,0 +1,30 @@
+def is_good(s):
+    balance = 0
+    for char in s:
+        if char == '(':
+            balance += 1
+        else:
+            balance -= 1
+        if balance < 0:
+            return ''
+    if balance == 0:
+        return 'T'
+    return ''
+
+
+def match_parens(lst):
+    if is_good(lst[0] + lst[1]):
+        return 'Yes'
+    if is_good(lst[1] + lst[0]):
+        return 'Yes'
+    return 'No'
+
+
+assert match_parens(['()(', ')']) == 'Yes'
+assert match_parens([')', ')']) == 'No'
+assert match_parens(['', '']) == 'Yes'
+assert match_parens(['(', ')']) == 'Yes'
+assert match_parens([')', '(']) == 'Yes'
+assert match_parens(['(', '(']) == 'No'
+assert match_parens(['())', '(']) == 'Yes'
+assert match_parens(['(()', '(']) == 'No'
