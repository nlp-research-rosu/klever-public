+  claim
+    <k> #applyK(
+          toCall(matchParensClosure),
+          (list(vCons(str(.IntSeq),
+                      vCons(str(.IntSeq), .ValSeq))), .Vals))
+      => str(strToCodes("Yes"))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(("is_good" |-> isGoodClosure), parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    [label(groundEmpty)]
+endmodule
