+
+  claim matchParensClosure
+    => closureVal(("lst", .ParamNames), {rendered(match_body)}, 0)
+    [label(pinMatchParensClosure)]
+endmodule
+'''
+OUTPUT.write_text(spec_text)
+print(f"generated {OUTPUT}")
+print(f"functions={sorted(functions)}")
+print("source-derived claims=5")
