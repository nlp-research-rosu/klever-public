Module(
  ImportFrom("typing", "List")
  FuncDef("filter_by_substring", Params("strings", "substring"),
    Assign(Name("result"), ListExpr())
    For(Name("string"), Name("strings"),
      If(Compare(Name("substring"), CmpOp("in", Name("string"))),
        Expr(Call(Attribute(Name("result"), "append"), Name("string"))),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("filter_by_substring"), ListExpr(), Str("a")),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("filter_by_substring"),
        ListExpr(Str("abc"), Str("bacd"), Str("cde"), Str("array")),
        Str("a")),
      CmpOp("==", ListExpr(Str("abc"), Str("bacd"), Str("array")))))
  Assert(
    Compare(
      Call(
        Name("filter_by_substring"),
        ListExpr(Str(""), Str("aa"), Str("b")),
        Str("")),
      CmpOp("==", ListExpr(Str(""), Str("aa"), Str("b")))))
  Assert(
    Compare(
      Call(
        Name("filter_by_substring"),
        ListExpr(Str("x"), Str("xx"), Str("y")),
        Str("xx")),
      CmpOp("==", ListExpr(Str("xx")))))
  Assert(
    Compare(
      Call(
        Name("filter_by_substring"),
        ListExpr(Str("abc"), Str("def")),
        Str("z")),
      CmpOp("==", ListExpr()))))
