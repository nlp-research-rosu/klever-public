+from typing import List
+
+
+def filter_by_substring(strings: List[str], substring: str) -> List[str]:
+    result = []
+    for string in strings:
+        if substring in string:
+            result.append(string)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..66a7f256f0039cd151a987a8e945452513390ac2
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module FILTER-SPEC
+  imports FILTER-VERIFICATION
+
+  // Inductive loop invariant.  ACC is the already-produced prefix and SS is
+  // the unvisited suffix.  The claim is reusable after one loop iteration.
+  claim
+    <k> #loop(list(strVals(SS:StrSeq)), Name("string"), filterLoopBody)
+         ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(FM:Map => loopScope(FM, SS), PAR:Parent) ...
+    </scopes>
+    <heap>
+      ... H:Int |-> list(ACC:ValSeq
+                         => valSeqConcat(ACC, filterStrings(P:IntSeq, SS))) ...
+    </heap>
+    requires "result" in_keys(FM)
+     andBool {FM["result"]}:>Val ==K ref(H)
+     andBool "substring" in_keys(FM)
+     andBool {FM["substring"]}:>Val ==K str(P)
+
+  // End-to-end correctness of the translated entry point for every finite
+  // list of strings and every substring.
+  claim
+    <k> #loadAll(filterProgram)
+         ~> Call(Name("filter_by_substring"),
+                 (list(strVals(SS:StrSeq)), str(P:IntSeq), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(("filter_by_substring"
+                    |-> closureVal(("strings", "substring"), filterBody, 0)),
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => (0 |-> list(filterStrings(P, SS))) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..a55a36fb06eeda4da43cae5391df8d4ae9f03fce
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,49 @@
+requires "reference-semantics/semantics.k"
+
+module FILTER-VERIFICATION
+  imports MPY
+
+  // A typed symbolic sequence: every element denotes a Python string.
+  syntax StrSeq ::= ".StrSeq"
+                  | ssCons(IntSeq, StrSeq)
+
+  syntax ValSeq ::= strVals(StrSeq) [function, total]
+  rule strVals(.StrSeq) => .ValSeq
+  rule strVals(ssCons(S:IntSeq, SS:StrSeq))
+    => vCons(str(S), strVals(SS))
+
+  // Mathematical contract: retain exactly the strings containing P, in order.
+  syntax ValSeq ::= filterStrings(IntSeq, StrSeq) [function, total]
+  rule filterStrings(_:IntSeq, .StrSeq) => .ValSeq
+  rule filterStrings(P:IntSeq, ssCons(S:IntSeq, SS:StrSeq))
+    => vCons(str(S), filterStrings(P, SS))
+    requires strContains(P, S)
+  rule filterStrings(P:IntSeq, ssCons(S:IntSeq, SS:StrSeq))
+    => filterStrings(P, SS)
+    requires notBool strContains(P, S)
+
+  // The loop target remains bound to the last visited string, as in Python.
+  syntax Map ::= loopScope(Map, StrSeq) [function, total]
+  rule loopScope(M:Map, .StrSeq) => M
+  rule loopScope(M:Map, ssCons(S:IntSeq, SS:StrSeq))
+    => loopScope(M [ "string" <- str(S) ], SS)
+
+  // These macros are the exact translated function body in solution.mpy.
+  syntax Stmts ::= "filterLoopBody" [macro]
+  rule filterLoopBody
+    => If(Compare(Name("substring"), CmpOp("in", Name("string"))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("string"))) .Stmts,
+          .Stmts)
+
+  syntax Stmts ::= "filterBody" [macro]
+  rule filterBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       For(Name("string"), Name("strings"), filterLoopBody)
+       Return(Name("result"))
+
+  syntax Module ::= "filterProgram" [macro]
+  rule filterProgram
+    => Module(ImportFrom("typing", "List")
+              FuncDef("filter_by_substring", Params("strings", "substring"),
+                      filterBody))
+endmodule

