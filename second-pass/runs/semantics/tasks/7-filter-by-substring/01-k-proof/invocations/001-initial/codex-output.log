+requires "verification.k"
+
+module FILTER-SPEC
+  imports FILTER-VERIFICATION
+
+  // Inductive invariant after at least one iteration. ACC is the produced
+  // prefix and VS is the unvisited suffix. The current target binding makes
+  // the claim reusable after one more loop iteration.
+  claim
+    <k> #loop(list(VS:ValSeq), Name("string"), filterLoopBody)
+         ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        (.Map [ "strings" <- list(ORIG:ValSeq) ]
+              [ "substring" <- str(P:IntSeq) ]
+              [ "result" <- ref(H:Int) ]
+              [ "string" <- CUR:Val ])
+        =>
+        (.Map [ "strings" <- list(ORIG) ]
+              [ "substring" <- str(P) ]
+              [ "result" <- ref(H) ]
+              [ "string" <- lastVal(CUR, VS) ]),
+        parent(0)) ...
+    </scopes>
+    <heap>
+      ... H:Int |-> list(ACC:ValSeq
+                         => filterAcc(ACC, P, VS)) ...
+    </heap>
+    requires allStrings(VS)
+
+  // End-to-end correctness of the translated entry point for every finite
+  // list of strings and every substring.
+  claim
+    <k> #loadAll(filterProgram)
+         ~> Call(Name("filter_by_substring"),
+                 (list(VS:ValSeq), str(P:IntSeq), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(("filter_by_substring"
+                    |-> closureVal(("strings", "substring"), filterBody, 0)),
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => (0 |-> list(filterAcc(.ValSeq, P, VS))) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allStrings(VS)
