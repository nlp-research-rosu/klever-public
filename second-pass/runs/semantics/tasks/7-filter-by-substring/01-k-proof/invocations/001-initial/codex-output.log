+requires "verification.k"
+
+module FILTER-SPEC
+  imports FILTER-VERIFICATION
+
+  // Inductive invariant after at least one iteration. ACC is the produced
+  // prefix and SS is the unvisited suffix. The current target binding makes
+  // the claim reusable after one more loop iteration.
+  claim
+    <k> #loop(list(strVals(SS:StrSeq)), Name("string"), filterLoopBody)
+         ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        (.Map [ "strings" <- list(strVals(ORIG:StrSeq)) ]
+              [ "substring" <- str(P:IntSeq) ]
+              [ "result" <- ref(H:Int) ]
+              [ "string" <- str(CUR:IntSeq) ])
+        =>
+        (.Map [ "strings" <- list(strVals(ORIG)) ]
+              [ "substring" <- str(P) ]
+              [ "result" <- ref(H) ]
+              [ "string" <- str(lastCodes(CUR, SS)) ]),
+        parent(0)) ...
+    </scopes>
+    <heap>
+      ... H:Int |-> list(ACC:ValSeq
+                         => filterAccStrings(ACC, P, SS)) ...
+    </heap>
+
+  // End-to-end correctness of the translated entry point for every finite
+  // list of strings and every substring.
+  claim
+    <k> #loadAll(filterProgram)
+         ~> Call(Name("filter_by_substring"),
+                 (list(strVals(SS:StrSeq)), str(P:IntSeq), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(("filter_by_substring"
+                    |-> closureVal(("strings", "substring"), filterBody, 0)),
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => (0 |-> list(filterAccStrings(.ValSeq, P, SS))) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..86f6feecaf2c158b23acfc2f5299f11af7c7e418
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,81 @@
+requires "reference-semantics/semantics.k"
+
+module FILTER-VERIFICATION
+  imports MPY
+
+  // A typed symbolic sequence: every element denotes a Python string.
+  syntax StrSeq ::= ".StrSeq"
+                  | ssCons(IntSeq, StrSeq)
+
+  // strVals is a proof-side representation constructor.  The iterator bridge
+  // below exposes exactly the same head/tail behavior as vCons(str(...), ...).
+  syntax ValSeq ::= strVals(StrSeq)
+  rule strVals(.StrSeq) => .ValSeq
+  rule strVals(ssCons(S:IntSeq, SS:StrSeq))
+    => vCons(str(S), strVals(SS))
+
+  syntax KItem ::= #strIterNext(StrSeq)
+  rule <k> #iterNext(list(strVals(SS:StrSeq)))
+        => #strIterNext(SS) ... </k>
+    [priority(40)]
+  rule <k> #strIterNext(.StrSeq) => #iterDone ... </k>
+  rule <k> #strIterNext(ssCons(S:IntSeq, SS:StrSeq))
+        => #iterYield(str(S), list(strVals(SS))) ... </k>
+
+  // Split symbolic string containment while retaining the reference function.
+  syntax KItem ::= #strContainsBool(IntSeq, IntSeq)
+  rule <k> Compare(str(P:IntSeq), CmpOp("in", str(S:IntSeq)))
+        => #strContainsBool(P, S) ... </k>
+    [priority(40)]
+  rule <k> #strContainsBool(P:IntSeq, S:IntSeq) => true ... </k>
+    requires strContains(P, S)
+  rule <k> #strContainsBool(P:IntSeq, S:IntSeq) => false ... </k>
+    requires notBool strContains(P, S)
+
+  // Mathematical contract: retain exactly the strings containing P, in order.
+  syntax ValSeq ::= filterStrings(IntSeq, StrSeq) [function, total]
+  rule filterStrings(_:IntSeq, .StrSeq) => .ValSeq
+  rule filterStrings(P:IntSeq, ssCons(S:IntSeq, SS:StrSeq))
+    => vCons(str(S), filterStrings(P, SS))
+    requires strContains(P, S)
+  rule filterStrings(P:IntSeq, ssCons(S:IntSeq, SS:StrSeq))
+    => filterStrings(P, SS)
+    requires notBool strContains(P, S)
+
+  // Accumulator form of the same order-preserving filter.  This definition
+  // mirrors list.append while remaining a pure mathematical function.
+  syntax ValSeq ::= filterAccStrings(ValSeq, IntSeq, StrSeq) [function, total]
+  rule filterAccStrings(ACC:ValSeq, _:IntSeq, .StrSeq) => ACC
+  rule filterAccStrings(ACC:ValSeq, P:IntSeq,
+                        ssCons(S:IntSeq, SS:StrSeq))
+    => filterAccStrings(valSeqConcat(ACC, vCons(str(S), .ValSeq)), P, SS)
+    requires strContains(P, S)
+  rule filterAccStrings(ACC:ValSeq, P:IntSeq,
+                        ssCons(S:IntSeq, SS:StrSeq))
+    => filterAccStrings(ACC, P, SS)
+    requires notBool strContains(P, S)
+
+  syntax IntSeq ::= lastCodes(IntSeq, StrSeq) [function, total]
+  rule lastCodes(S:IntSeq, .StrSeq) => S
+  rule lastCodes(_:IntSeq, ssCons(S:IntSeq, SS:StrSeq))
+    => lastCodes(S, SS)
+
+  // These macros are the exact translated function body in solution.mpy.
+  syntax Stmts ::= "filterLoopBody" [macro]
+  rule filterLoopBody
+    => If(Compare(Name("substring"), CmpOp("in", Name("string"))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("string"))) .Stmts,
+          .Stmts)
+
+  syntax Stmts ::= "filterBody" [macro]
+  rule filterBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       For(Name("string"), Name("strings"), filterLoopBody)
+       Return(Name("result"))
+
+  syntax Module ::= "filterProgram" [macro]
+  rule filterProgram
+    => Module(ImportFrom("typing", "List")
+              FuncDef("filter_by_substring", Params("strings", "substring"),
+                      filterBody))
+endmodule

