+requires "verification.k"
+
+module FILTER-SPEC
+  imports FILTER-VERIFICATION
+
+  // Inductive loop invariant.  ACC is the already-produced prefix and SS is
+  // the unvisited suffix.  The claim is reusable after one loop iteration.
+  claim
+    <k> #loop(list(strVals(SS:StrSeq)), Name("string"), filterLoopBody)
+         ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(FM:Map => loopScope(FM, SS), PAR:Parent) ...
+    </scopes>
+    <heap>
+      ... H:Int |-> list(ACC:ValSeq
+                         => valSeqConcat(ACC, filterStrings(P:IntSeq, SS))) ...
+    </heap>
+    requires "result" in_keys(FM)
+     andBool {FM["result"]}:>Val ==K ref(H)
+     andBool "substring" in_keys(FM)
+     andBool {FM["substring"]}:>Val ==K str(P)
+
+  // End-to-end correctness of the translated entry point for every finite
+  // list of strings and every substring.
+  claim
+    <k> #loadAll(filterProgram)
+         ~> Call(Name("filter_by_substring"),
+                 (list(strVals(SS:StrSeq)), str(P:IntSeq), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(("filter_by_substring"
+                    |-> closureVal(("strings", "substring"), filterBody, 0)),
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => (0 |-> list(filterStrings(P, SS))) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+endmodule
