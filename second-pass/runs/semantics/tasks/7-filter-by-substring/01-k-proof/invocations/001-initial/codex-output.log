+  syntax IntSeq ::= lastCodes(IntSeq, StrSeq) [function, total]
+  rule lastCodes(S:IntSeq, .StrSeq) => S
+  rule lastCodes(_:IntSeq, ssCons(S:IntSeq, SS:StrSeq))
