+    <k> #loadAll(filterProgram)
+         ~> Call(Name("filter_by_substring"),
+                 (list(strVals(SS:StrSeq)), str(P:IntSeq), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
