+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => (0 |-> list(filterAccStrings(.ValSeq, P, SS))) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
