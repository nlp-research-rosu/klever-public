--- /dev/null
+++ b/verification.k
@@ -0,0 +1,106 @@
+requires "reference-semantics/semantics.k"
+
+module FILTER-VERIFICATION
+  imports MPY
+
+  // A typed symbolic sequence: every element denotes a Python string.
+  syntax StrSeq ::= ".StrSeq"
+                  | ssCons(IntSeq, StrSeq)
+
+  syntax ValSeq ::= strVals(StrSeq) [function, total]
+  rule strVals(.StrSeq) => .ValSeq
+  rule strVals(ssCons(S:IntSeq, SS:StrSeq))
+    => vCons(str(S), strVals(SS))
+
+  syntax Bool ::= isStringVal(Val) [function, total]
+  rule isStringVal(str(_:IntSeq)) => true
+  rule isStringVal(_:Val) => false [owise]
+
+  syntax Bool ::= allStrings(ValSeq) [function, total]
+  rule allStrings(.ValSeq) => true
+  rule allStrings(vCons(V:Val, VS:ValSeq))
+    => isStringVal(V) andBool allStrings(VS)
+
+  // Eliminate the abstract string-value sort test without enumerating every
+  // other Val constructor.  On concrete strings this is exactly strContains.
+  syntax Bool ::= containsStringVal(IntSeq, Val) [function]
+  rule containsStringVal(P:IntSeq, str(S:IntSeq)) => strContains(P, S)
+
+  syntax KItem ::= #containsBool(IntSeq, Val)
+  rule <k> Compare(str(P:IntSeq), CmpOp("in", V:Val))
+        => #containsBool(P, V) ... </k>
+    requires isStringVal(V)
+    [priority(40)]
+
+  // Symbolically split the opaque containment result before the If consumer.
+  rule <k> #containsBool(P:IntSeq, V:Val) => true ... </k>
+    requires containsStringVal(P, V)
+  rule <k> #containsBool(P:IntSeq, V:Val) => false ... </k>
+    requires notBool containsStringVal(P, V)
+
+  // Mathematical contract: retain exactly the strings containing P, in order.
+  syntax ValSeq ::= filterStrings(IntSeq, StrSeq) [function, total]
+  rule filterStrings(_:IntSeq, .StrSeq) => .ValSeq
+  rule filterStrings(P:IntSeq, ssCons(S:IntSeq, SS:StrSeq))
+    => vCons(str(S), filterStrings(P, SS))
+    requires strContains(P, S)
+  rule filterStrings(P:IntSeq, ssCons(S:IntSeq, SS:StrSeq))
+    => filterStrings(P, SS)
+    requires notBool strContains(P, S)
+
+  syntax ValSeq ::= filterVals(IntSeq, ValSeq) [function]
+  rule filterVals(_:IntSeq, .ValSeq) => .ValSeq
+  rule filterVals(P:IntSeq, vCons(str(S:IntSeq), VS:ValSeq))
+    => vCons(str(S), filterVals(P, VS))
+    requires strContains(P, S)
+  rule filterVals(P:IntSeq, vCons(str(S:IntSeq), VS:ValSeq))
+    => filterVals(P, VS)
+    requires notBool strContains(P, S)
+
+  // Accumulator form of the same order-preserving filter.  This definition
+  // mirrors list.append while remaining a pure mathematical function.
+  syntax ValSeq ::= filterAcc(ValSeq, IntSeq, ValSeq) [function]
+  rule filterAcc(ACC:ValSeq, _:IntSeq, .ValSeq) => ACC
+  rule filterAcc(ACC:ValSeq, P:IntSeq,
+                 vCons(V:Val, VS:ValSeq))
+    => filterAcc(valSeqConcat(ACC, vCons(V, .ValSeq)), P, VS)
+    requires containsStringVal(P, V)
+  rule filterAcc(ACC:ValSeq, P:IntSeq,
+                 vCons(V:Val, VS:ValSeq))
+    => filterAcc(ACC, P, VS)
+    requires notBool containsStringVal(P, V)
+
+  // The loop target remains bound to the last visited string, as in Python.
+  syntax Map ::= loopScope(Map, StrSeq) [function, total]
+  rule loopScope(M:Map, .StrSeq) => M
+  rule loopScope(M:Map, ssCons(S:IntSeq, SS:StrSeq))
+    => loopScope(M [ "string" <- str(S) ], SS)
+
+  syntax Map ::= loopScopeVals(Map, ValSeq) [function]
+  rule loopScopeVals(M:Map, .ValSeq) => M
+  rule loopScopeVals(M:Map, vCons(str(S:IntSeq), VS:ValSeq))
+    => loopScopeVals(M [ "string" <- str(S) ], VS)
+
+  syntax Val ::= lastVal(Val, ValSeq) [function, total]
+  rule lastVal(V:Val, .ValSeq) => V
+  rule lastVal(_:Val, vCons(V:Val, VS:ValSeq)) => lastVal(V, VS)
+
+  // These macros are the exact translated function body in solution.mpy.
+  syntax Stmts ::= "filterLoopBody" [macro]
+  rule filterLoopBody
+    => If(Compare(Name("substring"), CmpOp("in", Name("string"))),
+          Expr(Call(Attribute(Name("result"), "append"), Name("string"))) .Stmts,
+          .Stmts)
+
+  syntax Stmts ::= "filterBody" [macro]
+  rule filterBody
+    => Assign(Name("result"), ListExpr(.Exprs))
+       For(Name("string"), Name("strings"), filterLoopBody)
+       Return(Name("result"))
+
+  syntax Module ::= "filterProgram" [macro]
+  rule filterProgram
+    => Module(ImportFrom("typing", "List")
+              FuncDef("filter_by_substring", Params("strings", "substring"),
+                      filterBody))
+endmodule

codex
The first invariant attempt exposed a real limitation of the supplied symbolic semantics: its generic `Val` sort does not let the prover recover “this abstract element is a string” from a Boolean type predicate. I’m switching the proof model to an explicit sequence-of-string-codes sort and adding only a one-step iterator bridge; the program still runs through the supplied function, loop, comparison, and `append` rules.
