+    => vCons(str(S), strVals(SS))
+
+  syntax KItem ::= #strIterNext(StrSeq)
+  rule <k> #iterNext(list(strVals(SS:StrSeq)))
+        => #strIterNext(SS) ... </k>
+    [priority(40)]
