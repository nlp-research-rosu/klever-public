/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
inv=json.load(open('/reference/rule-inventory.json'))
out=json.load(open('/workspace/trust-boundary.json'))
assert set(out)=={'schema_version','inventory_sha256','rules'}
assert out['schema_version']==2
assert out['inventory_sha256']==inv['inventory_sha256']
assert len(out['rules'])==len(inv['rules'])
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
inv_ids=[r['source_rule_id'] for r in inv['rules']]
out_ids=[r['source_rule_id'] for r in out['rules']]
assert out_ids==inv_ids
assert len(out_ids)==len(set(out_ids))
for source, classified in zip(inv['rules'],out['rules']):
    assert set(classified)=={'source_rule_id','classification','rationale'}
    assert classified['classification'] in allowed
    assert isinstance(classified['rationale'],str) and classified['rationale'].strip()
    if 'simplification' in source.get('attributes',[]):
        assert classified['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
print('inventory_sha256:', out['inventory_sha256'])
print('rules validated:', len(out_ids))
print('classification counts:', dict(Counter(r['classification'] for r in out['rules'])))
print('simplification rules:', sum('simplification' in r.get('attributes',[]) for r in inv['rules']))
PY
