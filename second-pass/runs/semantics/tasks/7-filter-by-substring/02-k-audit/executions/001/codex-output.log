for p in /audit-output/evidence/static-inventory.md /audit-output/evidence/static-inventory.json /audit-output/evidence/stage3-proof-all.log /audit-output/evidence/stage3-proof-loop-only.log /audit-output/evidence/stage3-proof-entry-with-proved-helper.log /audit-output/evidence/stage6-vacuity-proof.log /audit-output/evidence/spec-vacuity-audit.k; do test -f "$p" || echo "MISSING $p"; done
python3 - <<'"'PY'
