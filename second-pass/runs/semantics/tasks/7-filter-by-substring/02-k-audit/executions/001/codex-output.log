diff --git a//tmp/audit-work/run/bridge-base.k b//tmp/audit-work/run/bridge-base.k
new file mode 100644
index 0000000000000000000000000000000000000000..150bf1a7e518193670fd8e3a529bca4a70c9fc4c
--- /dev/null
+++ b//tmp/audit-work/run/bridge-base.k
@@ -0,0 +1,13 @@
+requires "reference-semantics/semantics.k"
+
+module BRIDGE-BASE
+  imports MPY
+
+  syntax StrSeq ::= ".StrSeq"
+                  | ssCons(IntSeq, StrSeq)
+
+  syntax ValSeq ::= strVals(StrSeq) [function, total]
+  rule strVals(.StrSeq) => .ValSeq
+  rule strVals(ssCons(S:IntSeq, SS:StrSeq))
+    => vCons(str(S), strVals(SS))
+endmodule
diff --git a//tmp/audit-work/run/bridge-connection-spec.k b//tmp/audit-work/run/bridge-connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..e11afe9c2628ef736cda606e7843bf24d00f6d0d
--- /dev/null
+++ b//tmp/audit-work/run/bridge-connection-spec.k
@@ -0,0 +1,27 @@
+requires "bridge-base.k"
+
+module BRIDGE-CONNECTION-SPEC
+  imports BRIDGE-BASE
+
+  claim [iter-empty]:
+    <k> #iterNext(list(strVals(.StrSeq))) ~> CONT:K
+      => #iterDone ~> CONT
+    </k>
+
+  claim [iter-cons]:
+    <k> #iterNext(list(strVals(ssCons(S:IntSeq, SS:StrSeq)))) ~> CONT:K
+      => #iterYield(str(S), list(strVals(SS))) ~> CONT
+    </k>
+
+  claim [contains-true]:
+    <k> Compare(str(P:IntSeq), CmpOp("in", str(S:IntSeq))) ~> CONT:K
+      => true ~> CONT
+    </k>
+    requires strContains(P, S) ==Bool true
+
+  claim [contains-false]:
+    <k> Compare(str(P:IntSeq), CmpOp("in", str(S:IntSeq))) ~> CONT:K
+      => false ~> CONT
+    </k>
+    requires strContains(P, S) ==Bool false
+endmodule
