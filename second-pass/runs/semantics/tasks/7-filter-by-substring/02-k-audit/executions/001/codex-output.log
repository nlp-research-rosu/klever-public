+  printf '\n'
+  "$@"
+  command_status=$?
+  printf 'EXIT_STATUS: %d\n' "$command_status"
+  exit "$command_status"
+} 2>&1 | tee "$log_file"
+
+exit "${PIPESTATUS[0]}"

