+      .Map
+      =>
+      (0 |-> list(
+        vCons(str(iCons(97, iCons(98, iCons(99, .IntSeq)))),
+        vCons(str(iCons(120, iCons(120, iCons(97, .IntSeq)))),
+              .ValSeq))))
+    </heap>
