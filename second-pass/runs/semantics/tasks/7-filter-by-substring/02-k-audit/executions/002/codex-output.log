@@ -0,0 +1,56 @@
+requires "verification.k"
+
+module FILTER-SPEC-ENTRY-WITH-PROVED-LOOP
+  imports FILTER-VERIFICATION
+
+  // Exact copy of the independently proved candidate loop claim.  `trusted`
+  // makes this already-established lemma available while the entry claim is
+  // selected as the only remaining proof obligation.
+  claim [trusted]:
+    <k> #loop(list(strVals(SS:StrSeq)), Name("string"), filterLoopBody)
+         ~> CONT:K
+      => CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        (.Map [ "strings" <- list(strVals(ORIG:StrSeq)) ]
+              [ "substring" <- str(P:IntSeq) ]
+              [ "result" <- ref(H:Int) ]
+              [ "string" <- str(CUR:IntSeq) ])
+        =>
+        (.Map [ "strings" <- list(strVals(ORIG)) ]
+              [ "substring" <- str(P) ]
+              [ "result" <- ref(H) ]
+              [ "string" <- str(lastCodes(CUR, SS)) ]),
+        parent(0)) ...
+    </scopes>
+    <heap>
+      ... H:Int |-> list(ACC:ValSeq
+                         => filterAccStrings(ACC, P, SS)) ...
+    </heap>
+
+  claim
+    <k> #loadAll(filterProgram)
+         ~> Call(Name("filter_by_substring"),
+                 (list(strVals(SS:StrSeq)), str(P:IntSeq), .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(("filter_by_substring"
+                    |-> closureVal(("strings", "substring"), filterBody, 0)),
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => (0 |-> list(filterStrings(P, SS))) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/7-filter-by-substring/candidate/spec-ground.k b//tmp/audit-work/7-filter-by-substring/candidate/spec-ground.k
new file mode 100644
index 0000000000000000000000000000000000000000..415fc9af0a7c8f4faba553906393d611ac2017aa
--- /dev/null
+++ b//tmp/audit-work/7-filter-by-substring/candidate/spec-ground.k
@@ -0,0 +1,70 @@
+requires "verification.k"
+
+module FILTER-SPEC-GROUND
+  imports FILTER-VERIFICATION
+
+  // Satisfying entry state: empty input list and substring "a".
+  claim
+    <k> #loadAll(filterProgram)
+         ~> Call(Name("filter_by_substring"),
+                 (list(strVals(.StrSeq)),
+                  str(iCons(97, .IntSeq)),
+                  .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(("filter_by_substring"
+                    |-> closureVal(("strings", "substring"), filterBody, 0)),
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => (0 |-> list(.ValSeq)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Satisfying entry state exercising true, true, and false containment:
+  // strings = ["abc", "xxa", "z"], substring = "a".
+  claim
+    <k> #loadAll(filterProgram)
+         ~> Call(Name("filter_by_substring"),
+                 (list(strVals(
+                    ssCons(iCons(97, iCons(98, iCons(99, .IntSeq))),
+                    ssCons(iCons(120, iCons(120, iCons(97, .IntSeq))),
+                    ssCons(iCons(122, .IntSeq), .StrSeq))))),
+                  str(iCons(97, .IntSeq)),
+                  .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0 |-> scope(("filter_by_substring"
+                    |-> closureVal(("strings", "substring"), filterBody, 0)),
+                   parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      (0 |-> list(
+        vCons(str(iCons(97, iCons(98, iCons(99, .IntSeq)))),
+        vCons(str(iCons(120, iCons(120, iCons(97, .IntSeq)))),
+              .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
