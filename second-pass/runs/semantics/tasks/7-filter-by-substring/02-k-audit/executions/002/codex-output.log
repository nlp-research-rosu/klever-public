import json, pathlib, collections
for p in sorted(pathlib.Path('/generation-evidence/codex-trace').rglob('*')):
    if not p.is_file(): continue
    print('TRACE', p, p.stat().st_size)
    kinds=collections.Counter(); payloads=collections.Counter(); calls=[]; messages=[]; errors=[]
    with p.open(errors='replace') as f:
      for n,line in enumerate(f,1):
        try: x=json.loads(line)
        except Exception as e: errors.append((n,str(e),line[:120])); continue
        kinds[x.get('type','?')]+=1
        pl=x.get('payload') if isinstance(x.get('payload'),dict) else {}
        payloads[pl.get('type','?')]+=1
        typ=pl.get('type')
        if typ in {'function_call','custom_tool_call'}:
          calls.append((n,typ,pl.get('name'),pl.get('arguments') or pl.get('input')))
        if typ in {'message','reasoning'}:
          content=pl.get('content')
          if typ=='message' and pl.get('role') in {'assistant','developer','user'}:
            messages.append((n,pl.get('role'),content))
    print('top_types',dict(kinds)); print('payload_types',dict(payloads)); print('parse_errors',errors)
    print('tool_calls')
    for row in calls: print(row)
    print('assistant_messages')
    for n,role,c in messages:
      if role=='assistant': print(n,repr(c))
