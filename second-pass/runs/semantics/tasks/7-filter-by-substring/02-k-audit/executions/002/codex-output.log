+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  (
+    cd "$work" || exit 125
+    "$@"
+  ) >"$log" 2>&1
+  status=$?
+  printf 'EXIT: %d\n' "$status"
+  lines=$(wc -l <"$log")
+  printf 'LOG: %s (%d lines)\n' "$log" "$lines"
+  sed -n '1,180p' "$log"
+  if (( lines > 240 )); then
+    printf '[... bounded log: middle omitted ...]\n'
+    tail -n 60 "$log"
+  fi
+  return "$status"
+}
+
+run_logged body_mutation_diff diff -u /candidate/verification.k verification.k
