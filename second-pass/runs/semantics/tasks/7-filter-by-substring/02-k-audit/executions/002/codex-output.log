diff --git a/evidence/05_inventory.py b/evidence/05_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..e211d845fb8d49defd21b8a4193a9885416f3451
--- /dev/null
+++ b/evidence/05_inventory.py
@@ -0,0 +1,151 @@
+#!/usr/bin/env python3
+"""Create a complete declaration/rule inventory for the audited K sources."""
+
+from __future__ import annotations
+
+import csv
+import re
+from collections import Counter
+from pathlib import Path
+
+
+REFERENCE = Path("/reference/reference-semantics")
+CANDIDATE = Path("/candidate")
+OUTPUT = Path("/audit-output/evidence/05_rule_inventory.tsv")
+SUMMARY = Path("/audit-output/evidence/05_rule_inventory_summary.txt")
+
+sources = sorted(REFERENCE.rglob("*.k")) + [
+    CANDIDATE / "verification.k",
+    CANDIDATE / "spec.k",
+]
+start_re = re.compile(r"^\s*(configuration|syntax|rule|context|claim)\b")
+stop_re = re.compile(r"^(?:requires)\b|^\s*(?:module|endmodule|imports)\b")
+flag_names = [
+    "function",
+    "total",
+    "functional",
+    "opaque",
+    "priority",
+    "simplification",
+    "macro",
+    "owise",
+    "concrete",
+    "anywhere",
+    "symbol",
+    "no-evaluators",
+]
+
+
+def strip_line_comment(line: str) -> str:
+    """Remove // comments without treating // inside K strings as comments."""
+    quoted = False
+    escaped = False
+    for index, char in enumerate(line):
+        if escaped:
+            escaped = False
+            continue
+        if char == "\\" and quoted:
+            escaped = True
+            continue
+        if char == '"':
+            quoted = not quoted
+            continue
+        if not quoted and line[index : index + 2] == "//":
+            return line[:index]
+    return line
+
+
+def local_decision(path: Path, line: int, kind: str, text: str) -> tuple[str, str]:
+    if path == CANDIDATE / "verification.k":
+        if kind == "syntax":
+            if "[macro]" in text:
+                return "program macro", "EXACT_MACRO; constructor identity checked"
+            return "proof-local declaration", "WELL_SORTED; fresh kompile passed"
+        if line in {13, 14}:
+            return "definitional representation", "SOUND; structural StrSeq-to-ValSeq equations"
+        if line in {18, 21, 22}:
+            return "list-iteration operational bridge", "SOUND; complete constructor cases; bridge-free connection checked"
+        if line in {27, 30, 32}:
+            return "string-containment operational bridge", "SOUND; equals fixed applyCmp/strContains path; connection checked"
+        if line in {38, 39, 44, 51}:
+            return "mathematical result summary", "SOUND; disjoint exhaustive guards and structural descent"
+        if line in {55, 56}:
+            return "loop-scope summary", "SOUND; structural descent and exact last-target behavior"
+        if line in {61, 67, 73}:
+            return "program macro equation", "EXACT_MACRO; expanded KORE equals solution.mpy"
+        return "proof-local rule", "MANUALLY_REVIEWED; see REVIEW.md stage 5"
+    if path == CANDIDATE / "spec.k":
+        return "reachability claim", "RESULT-CONSTRAINING; separately reconstructed and reviewed"
+    if kind == "syntax":
+        return "fixed supplied declaration", "SELECTED_SUPPLIED_SEMANTICS; fresh kompile passed"
+    if kind == "configuration":
+        return "fixed supplied configuration", "SELECTED_SUPPLIED_SEMANTICS; reachable cells manually reviewed"
+    if kind == "context":
+        return "fixed supplied evaluation context", "SELECTED_SUPPLIED_SEMANTICS; reachable contexts manually reviewed"
+    if kind == "rule":
+        return "fixed supplied rule", "SELECTED_SUPPLIED_SEMANTICS; reachable rules manually reviewed"
+    return "fixed supplied item", "SELECTED_SUPPLIED_SEMANTICS"
+
+
+rows: list[dict[str, str | int]] = []
+for path in sources:
+    lines = path.read_text().splitlines()
+    i = 0
+    while i < len(lines):
+        match = start_re.match(lines[i])
+        if not match:
+            i += 1
+            continue
+        kind = match.group(1)
+        start = i
+        i += 1
+        while i < len(lines):
+            if start_re.match(lines[i]) or stop_re.match(lines[i]):
+                break
+            i += 1
+        raw_chunk = "\n".join(lines[start:i]).rstrip()
+        chunk = "\n".join(strip_line_comment(line) for line in raw_chunk.splitlines()).rstrip()
+        one_line = re.sub(r"\s+", " ", chunk).strip()
+        attributes = " ".join(re.findall(r"\[[^\]]*\]", chunk))
+        flags = ",".join(name for name in flag_names if re.search(rf"\b{name}\b", attributes))
+        role, decision = local_decision(path, start + 1, kind, chunk)
+        rows.append(
+            {
+                "id": len(rows) + 1,
+                "source": str(path),
+                "line": start + 1,
+                "kind": kind,
+                "flags": flags,
+                "role": role,
+                "decision": decision,
+                "text": one_line,
+            }
+        )
+
+with OUTPUT.open("w", newline="") as f:
+    writer = csv.DictWriter(
+        f,
+        fieldnames=["id", "source", "line", "kind", "flags", "role", "decision", "text"],
+        dialect="excel-tab",
+    )
+    writer.writeheader()
+    writer.writerows(rows)
+
+by_kind = Counter(str(row["kind"]) for row in rows)
+by_flag = Counter()
+by_source = Counter(str(row["source"]) for row in rows)
+for row in rows:
+    for flag in str(row["flags"]).split(","):
+        if flag:
+            by_flag[flag] += 1
+
+with SUMMARY.open("w") as f:
+    print(f"inventory_entries={len(rows)}", file=f)
+    print(f"by_kind={dict(sorted(by_kind.items()))}", file=f)
+    print(f"by_flag={dict(sorted(by_flag.items()))}", file=f)
+    print("by_source:", file=f)
+    for source, count in sorted(by_source.items()):
+        print(f"{count:4d} {source}", file=f)
+
+print(OUTPUT)
+print(SUMMARY)
diff --git a/evidence/05_used_construct_map.tsv b/evidence/05_used_construct_map.tsv
new file mode 100644
index 0000000000000000000000000000000000000000..ae9a1c64bc58a8245aa2ecf6f5cdba773bc2b908
--- /dev/null
+++ b/evidence/05_used_construct_map.tsv
@@ -0,0 +1,22 @@
+construct	source location	declaration/evaluation	rules used and soundness decision
+Module(...)	solution.mpy:1; syntax.k:61	module is a statement list	core.k:124-127 loads and sequences all statements; exact and state-local
+ImportFrom("typing","List")	solution.mpy:2; syntax.k:43	non-strict statement	controls.k:35-44 makes non-math typing import a no-op; typing-only and semantically inert here
+FuncDef	solution.mpy:3; syntax.k:53	function body is stored, not run at definition	functions.k:14-16 binds exact closure body and defining scope; scope update is exact
+Call	solution/spec entry; syntax.k:28	callee then arguments via call.k:20-21 and core.k:185-191	call.k:69-75 allocates one frame, binds exact parameters, saves continuation; left-to-right argument evaluation is explicit
+Name	solution.mpy:3-8; syntax.k:12	name expression	core.k:130-154 resolves current scope then parents; all proof states pin the relevant bindings
+Assign	result = []	solution.mpy:4; syntax.k:41 strict RHS	list.k:13-15 plus core.k:117-121 allocate fresh list; controls.k:9-18 stores ref in current scope
+ListExpr	solution.mpy:4; syntax.k:17	arguments evaluated left-to-right	list.k:13-15 converts evaluated values and allocates; empty case allocates heap location 0
+For	solution.mpy:5; syntax.k:45 strict iterable	controls.k:69-74 evaluates iterable once and uses #iterNext; tuple.k:31-41 binds target; candidate iterator bridge exactly refines list.k:9-10 for StrSeq
+If	solution.mpy:6; syntax.k:49 strict condition	controls.k:51-54 branches on truthy Bool; containment produces Bool
+Compare "in"	solution.mpy:6; syntax.k:30; operators.k:15-17	left then right evaluation contexts	candidate bridge is equivalent to operators.k:17 plus str.k:29 and total strContains rules 32-41; bridge-free theorem closes
+Str containment	postcondition and execution	str.k:32-41	total structural prefix/substring functions	guards are disjoint and constructor recursion decreases; empty substring and all positions are covered
+Attribute	result.append	solution.mpy:7; syntax.k:29 strict receiver	call.k:16 creates bound method preserving selected receiver/binding
+append	solution.mpy:7	call.k:20-24 dispatch after receiver/argument evaluation	list.k:53-55 mutates only heap H by right-appending exact value and returns noneV
+Expr statement	solution.mpy:7; syntax.k:52 strict expression	controls.k:46-48 evaluates call for effect and discards noneV; append effect remains
+Return	solution.mpy:9; syntax.k:50 strict result	functions.k:78-90 records returned ref, discards remaining callee continuation, restores caller, and removes frame; final cells are pinned
+strVals	verification.k:12-15	proof representation of a list of strings	two constructor equations map every StrSeq to ordered vCons(str(...)); no oracle or result fact is encoded
+filterAccStrings	verification.k:37-48	total postcondition function	base and true/false guarded cons equations are disjoint, Bool-exhaustive, order-preserving, and structurally decreasing
+filterStrings	verification.k:50-52	total postcondition wrapper	single equation starts empty accumulator; no overlap or opacity
+lastCodes	verification.k:54-57	total loop-target summary	base retains prior target; cons recursion returns last remaining code sequence and strictly decreases
+filterLoopBody/filterBody/filterProgram	verification.k:60-76	macros expanded before execution	expanded KORE is byte-identical for submitted solution.mpy and filterProgram; macros do not bypass execution
+configuration	all claims	core.k:49-60	k, env, scopes, scopeLoc, heap, heapLoc, stack, ret, exc, exit-code	entry claim pins every cell; loop claim frames cells the loop cannot affect and constrains k/scopes/heap
