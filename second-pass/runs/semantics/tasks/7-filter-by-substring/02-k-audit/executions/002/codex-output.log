@@ -0,0 +1,23 @@
+requires "bridgefree.k"
+
+module BRIDGEFREE-SPEC
+  imports BRIDGEFREE
+
+  // Constructor-complete connection for the iteration bridge, with arbitrary
+  // continuation and no other cell touched.
+  claim
+    <k> #iterNext(list(strVals(.StrSeq))) ~> CONT:K
+      => #iterDone ~> CONT
+    </k>
+
+  claim
+    <k> #iterNext(list(strVals(ssCons(S:IntSeq, SS:StrSeq)))) ~> CONT:K
+      => #iterYield(str(S), list(strVals(SS))) ~> CONT
+    </k>
+
+  // Universal fixed-semantics path displaced by the Compare bridge.
+  claim
+    <k> Compare(str(P:IntSeq), CmpOp("in", str(S:IntSeq))) ~> CONT:K
+      => strContains(P, S) ~> CONT
+    </k>
+endmodule
diff --git a//tmp/audit-work/7-filter-by-substring/bridgefree/bridgefree.k b//tmp/audit-work/7-filter-by-substring/bridgefree/bridgefree.k
new file mode 100644
index 0000000000000000000000000000000000000000..7fe9afe2a5361d8c5199c9372a37d8aef32d82f0
--- /dev/null
+++ b//tmp/audit-work/7-filter-by-substring/bridgefree/bridgefree.k
@@ -0,0 +1,16 @@
+requires "reference-semantics/semantics.k"
+
+module BRIDGEFREE
+  imports MPY
+
+  // Only the proof representation equations are admitted here.  The
+  // candidate's #iterNext and Compare operational bridges are absent.
+  syntax StrSeq ::= ".StrSeq"
+                  | ssCons(IntSeq, StrSeq)
+
+  syntax ValSeq ::= strVals(StrSeq) [function, total]
+  rule strVals(.StrSeq) => .ValSeq [simplification]
+  rule strVals(ssCons(S:IntSeq, SS:StrSeq))
+    => vCons(str(S), strVals(SS))
+    [simplification]
+endmodule
