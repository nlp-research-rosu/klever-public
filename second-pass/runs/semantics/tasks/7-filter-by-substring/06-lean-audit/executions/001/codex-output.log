/reference/k-proof/verification.k-40-                        ssCons(S:IntSeq, SS:StrSeq))
/reference/k-proof/verification.k:41:    => filterAccStrings(valSeqConcat(ACC, vCons(str(S), .ValSeq)), P, SS)
/reference/k-proof/verification.k:42:    requires strContains(P, S) ==Bool true
/reference/k-proof/verification.k-43-    [simplification]
/reference/k-proof/verification.k-44-  rule filterAccStrings(ACC:ValSeq, P:IntSeq,
/reference/k-proof/verification.k-45-                        ssCons(S:IntSeq, SS:StrSeq))
/reference/k-proof/verification.k-46-    => filterAccStrings(ACC, P, SS)
/reference/k-proof/verification.k:47:    requires strContains(P, S) ==Bool false
/reference/k-proof/verification.k-48-    [simplification]
/reference/k-proof/verification.k-49-
