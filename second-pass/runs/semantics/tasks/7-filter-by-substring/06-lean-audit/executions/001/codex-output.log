/reference/k-proof/verification.k-57-    => lastCodes(S, SS)
/reference/k-proof/verification.k-58-
/reference/k-proof/verification.k-59-  // These macros are the exact translated function body in solution.mpy.
/reference/k-proof/verification.k-60-  syntax Stmts ::= "filterLoopBody" [macro]
/reference/k-proof/verification.k-61-  rule filterLoopBody
/reference/k-proof/verification.k:62:    => If(Compare(Name("substring"), CmpOp("in", Name("string"))),
/reference/k-proof/verification.k-63-          Expr(Call(Attribute(Name("result"), "append"), Name("string"))) .Stmts,
/reference/k-proof/verification.k-64-          .Stmts)
/reference/k-proof/verification.k-65-
/reference/k-proof/verification.k-66-  syntax Stmts ::= "filterBody" [macro]
/reference/k-proof/verification.k-67-  rule filterBody
/reference/k-proof/verification.k-68-    => Assign(Name("result"), ListExpr(.Exprs))
/reference/k-proof/verification.k-69-       For(Name("string"), Name("strings"), filterLoopBody)
