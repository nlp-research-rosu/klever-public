/reference/k-proof/verification.k-6-  // A typed symbolic sequence: every element denotes a Python string.
/reference/k-proof/verification.k-7-  syntax StrSeq ::= ".StrSeq"
/reference/k-proof/verification.k-8-                  | ssCons(IntSeq, StrSeq)
/reference/k-proof/verification.k-9-
/reference/k-proof/verification.k-10-  // strVals is a proof-side representation constructor.  The iterator bridge
/reference/k-proof/verification.k:11:  // below exposes exactly the same head/tail behavior as vCons(str(...), ...).
/reference/k-proof/verification.k:12:  syntax ValSeq ::= strVals(StrSeq)
/reference/k-proof/verification.k-13-  rule strVals(.StrSeq) => .ValSeq
/reference/k-proof/verification.k-14-  rule strVals(ssCons(S:IntSeq, SS:StrSeq))
/reference/k-proof/verification.k:15:    => vCons(str(S), strVals(SS))
