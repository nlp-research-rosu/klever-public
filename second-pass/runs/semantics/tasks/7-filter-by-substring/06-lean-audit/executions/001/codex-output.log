/reference/k-proof/verification.k:21:  rule <k> #strIterNext(.StrSeq) => #iterDone ... </k>
/reference/k-proof/verification.k-22-  rule <k> #strIterNext(ssCons(S:IntSeq, SS:StrSeq))
/reference/k-proof/verification.k:23:        => #iterYield(str(S), list(strVals(SS))) ... </k>
/reference/k-proof/verification.k-24-
/reference/k-proof/verification.k-25-  // Split symbolic string containment while retaining the reference function.
/reference/k-proof/verification.k:26:  syntax KItem ::= #strContainsBool(IntSeq, IntSeq)
/reference/k-proof/verification.k:27:  rule <k> Compare(str(P:IntSeq), CmpOp("in", str(S:IntSeq)))
/reference/k-proof/verification.k:28:        => #strContainsBool(P, S) ... </k>
/reference/k-proof/verification.k-29-    [priority(40)]
/reference/k-proof/verification.k:30:  rule <k> #strContainsBool(P:IntSeq, S:IntSeq) => true ... </k>
/reference/k-proof/verification.k:31:    requires strContains(P, S) ==Bool true
/reference/k-proof/verification.k:32:  rule <k> #strContainsBool(P:IntSeq, S:IntSeq) => false ... </k>
/reference/k-proof/verification.k:33:    requires strContains(P, S) ==Bool false
/reference/k-proof/verification.k-34-
/reference/k-proof/verification.k-35-  // Mathematical contract in accumulator form: inspect each string once,
/reference/k-proof/verification.k-36-  // append it exactly when it contains P, and otherwise leave ACC unchanged.
/reference/k-proof/verification.k:37:  syntax ValSeq ::= filterAccStrings(ValSeq, IntSeq, StrSeq) [function, total]
/reference/k-proof/verification.k-38-  rule filterAccStrings(ACC:ValSeq, _:IntSeq, .StrSeq) => ACC
