index 0000000000000000000000000000000000000000..1b45a5f5d160116b3d8d9221c47152d33d98e392
--- /dev/null
+++ b//tmp/audit-work/hostpid-preload.c
@@ -0,0 +1,23 @@
+#define _GNU_SOURCE
+
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+    char buffer[32];
+    long length = syscall(SYS_readlink, "/proc/self", buffer, sizeof(buffer) - 1);
+    pid_t result = 0;
+
+    if (length <= 0 || length >= (long)sizeof(buffer)) {
+        return (pid_t)syscall(SYS_getpid);
+    }
+    buffer[length] = '\0';
+    for (long index = 0; index < length; ++index) {
+        if (buffer[index] < '0' || buffer[index] > '9') {
+            return (pid_t)syscall(SYS_getpid);
+        }
+        result = (pid_t)(result * 10 + (buffer[index] - '0'));
+    }
+    return result;
+}
