Module(
  FuncDef("string_sequence", Params("n"),
    Expr(
      Str(
        "Return the decimal integers from 0 through n, separated by spaces."))
    If(Compare(Name("n"), CmpOp("<", Int(0))),
      Return(Str("")),
      )
    Assign(Name("result"), Str("0"))
    Assign(Name("i"), Int(1))
    For(Name("i"), Call(Name("range"), Int(1), BinOp("+", Name("n"), Int(1))),
      Assign(
        Name("result"),
        BinOp(
          "+",
          Name("result"),
          BinOp("+", Str(" "), Call(Name("str"), Name("i"))))))
    Return(Name("result"))))
