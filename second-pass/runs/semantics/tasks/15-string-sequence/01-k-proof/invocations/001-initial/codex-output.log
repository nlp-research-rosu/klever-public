+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  // Mathematical result: ASCII codes for "0 1 ... N".  Defining the
+  // contract independently of the program keeps the final claim readable.
+  syntax IntSeq ::= sequenceCodes(Int) [function]
+  rule sequenceCodes(N:Int) => .IntSeq
+    requires N <Int 0
+  rule sequenceCodes(0) => iCons(48, .IntSeq)
+  rule sequenceCodes(N:Int)
+    => seqConcat(sequenceCodes(N -Int 1),
+         seqConcat(iCons(32, .IntSeq), strToCodes(Int2String(N))))
+    requires N >Int 0
+  // Arithmetic congruence used at the zero-distance loop exit.  The hook
+  // solver establishes D == 0 from the invariant and the exhausted range.
+  rule sequenceCodes(I:Int +Int D:Int -Int 1)
+    => sequenceCodes(I -Int 1)
+    requires D ==Int 0
+
+  // These macros are exactly the translated function body and loop body in
+  // solution.mpy.  They let the invariant and its proved summary share one
+  // syntactic definition.
+  syntax Stmts ::= "sequenceLoopBody" [macro]
+  rule sequenceLoopBody
+    => If(Compare(Name("i"), CmpOp("==", Int(0))),
+         Assign(Name("result"), Call(Name("str"), Name("i"))),
+         Assign(Name("result"),
+           BinOp("+", Name("result"),
+             BinOp("+", Str(" "), Call(Name("str"), Name("i"))))))
+
+  syntax Stmts ::= "sequenceBody" [macro]
+  rule sequenceBody
+    => Expr(Str("Return the decimal integers from 0 through n, separated by spaces."))
+       Assign(Name("result"), Str(""))
+       Assign(Name("i"), Int(0))
+       For(Name("i"), Call(Name("range"), BinOp("+", Name("n"), Int(1))),
+           sequenceLoopBody)
+       Return(Name("result"))
