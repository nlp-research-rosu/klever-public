index 0000000000000000000000000000000000000000..11ae2a93f36b11b156da221e6f0e3dd17fbd2efa
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+def string_sequence(n: int) -> str:
+    """Return the decimal integers from 0 through n, separated by spaces."""
+    result = ""
+    i = 0
+    for i in range(n + 1):
+        if i == 0:
+            result = str(i)
+        else:
+            result = result + (" " + str(i))
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..7b473949ff7d3a0161f0f899578b9e547407bfb1
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,47 @@
+requires "verification.k"
+
+module LOOP-SPEC
+  imports VERIFICATION-BASE
+
+  // Inductive invariant: before iteration I, result contains exactly 0..I-1.
+  // On loop exit, Return and #pop restore the caller and expose 0..N.
+  claim <k>
+          #loop(rangeObj(I:Int, I +Int D:Int, 1), Name("i"), sequenceLoopBody)
+          ~> Return(Name("result")) ~> #endcall ~> CONT:K
+        => str(sequenceCodes(I +Int D -Int 1)) ~> CONT
+        </k>
+        <env> L:Int => CALLER:Int </env>
+        <scopes>
+          ((L |-> scope("result" |-> str(sequenceCodes(I -Int 1))
+                        "n" |-> ARG:Int "i" |-> J:Int, parent(0))) SC:Map)
+          => ((L |-> scope("result" |-> str(sequenceCodes(I -Int 1))
+                          "n" |-> ARG "i" |-> J, parent(0))) SC) [L <- undef]
+        </scopes>
+        <scopeLoc> L +Int 1 => L </scopeLoc>
+        <stack> ListItem(frame(CONT, CALLER, L)) STACK:List => STACK </stack>
+        <ret> noRet </ret>
+    requires I >=Int 0 andBool D >=Int 0
+     andBool notBool (L in_keys(SC))
+endmodule
+
+module FULL-SPEC
+  imports VERIFICATION
+
+  // The public entry point, with the exact closure body emitted in solution.mpy.
+  claim <k> Call(Name("string_sequence"), N:Int)
+           => str(sequenceCodes(N)) </k>
+        <env> 0 </env>
+        <scopes>
+          0 |-> scope("string_sequence" |->
+                closureVal(("n", .ParamNames), sequenceBody, 0), parent(-1))
+          -1 |-> builtinsScope
+        </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <heap> .Map </heap>
+        <heapLoc> 0 </heapLoc>
+        <stack> .List </stack>
+        <ret> noRet </ret>
+        <exc> NoExc </exc>
+        <exit-code> 0 </exit-code>
+    requires N >=Int 0
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..cd4bac971798ec5354dce53ff4d12317dbef7e0f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,60 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  // Mathematical result: ASCII codes for "0 1 ... N".  Defining the
+  // contract independently of the program keeps the final claim readable.
+  syntax IntSeq ::= sequenceCodes(Int) [function, injective]
+  rule sequenceCodes(-1) => .IntSeq
+  rule sequenceCodes(0) => iCons(48, .IntSeq)
+  rule sequenceCodes(N:Int)
+    => seqConcat(sequenceCodes(N -Int 1),
+         seqConcat(iCons(32, .IntSeq), strToCodes(Int2String(N))))
+    requires N >Int 0
+
+  // These macros are exactly the translated function body and loop body in
+  // solution.mpy.  They let the invariant and its proved summary share one
+  // syntactic definition.
+  syntax Stmts ::= "sequenceLoopBody" [macro]
+  rule sequenceLoopBody
+    => If(Compare(Name("i"), CmpOp("==", Int(0))),
+         Assign(Name("result"), Call(Name("str"), Name("i"))),
+         Assign(Name("result"),
+           BinOp("+", Name("result"),
+             BinOp("+", Str(" "), Call(Name("str"), Name("i"))))))
+
+  syntax Stmts ::= "sequenceBody" [macro]
+  rule sequenceBody
+    => Expr(Str("Return the decimal integers from 0 through n, separated by spaces."))
+       Assign(Name("result"), Str(""))
+       Assign(Name("i"), Int(0))
+       For(Name("i"), Call(Name("range"), BinOp("+", Name("n"), Int(1))),
+           sequenceLoopBody)
+       Return(Name("result"))
+endmodule
+
+// This module adds the loop summary only after LOOP-SPEC has proved the same
+// reachability formula against VERIFICATION-BASE.  FULL-SPEC then composes the
+// proved invariant with ordinary function-call semantics.
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  rule <k>
+         #loop(rangeObj(I:Int, I +Int D:Int, 1), Name("i"), sequenceLoopBody)
+         ~> Return(Name("result")) ~> #endcall ~> CONT:K
+       => str(sequenceCodes(I +Int D -Int 1)) ~> CONT
+       </k>
+       <env> L:Int => CALLER:Int </env>
+       <scopes>
+         ((L |-> scope("result" |-> str(sequenceCodes(I -Int 1))
+                       "n" |-> ARG:Int "i" |-> J:Int, parent(0))) SC:Map)
+         => ((L |-> scope("result" |-> str(sequenceCodes(I -Int 1))
+                         "n" |-> ARG "i" |-> J, parent(0))) SC) [L <- undef]
+       </scopes>
+       <scopeLoc> L +Int 1 => L </scopeLoc>
+       <stack> ListItem(frame(CONT, CALLER, L)) STACK:List => STACK </stack>
+       <ret> noRet </ret>
+    requires I >=Int 0 andBool D >=Int 0
+     andBool notBool (L in_keys(SC))
+endmodule

