    28	    [simplification]
    29	
    30	  // These macros are exactly the translated function body and loop body in
    31	  // solution.mpy.  They let the invariant and its proved summary share one
    32	  // syntactic definition.
    33	  syntax Stmts ::= "sequenceLoopBody" [macro]
