     1	def string_sequence(n: int) -> str:
     2	    """Return the decimal integers from 0 through n, separated by spaces."""
     3	    if n < 0:
     4	        return ""
     5	    result = "0"
     6	    i = 1
     7	    for i in range(1, n + 1):
     8	        result = result + (" " + str(i))
     9	    return result

