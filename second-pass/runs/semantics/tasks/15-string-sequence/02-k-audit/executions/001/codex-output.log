diff --git a//tmp/audit-work/reconstruction/spec-shadow-base-wrong.k b//tmp/audit-work/reconstruction/spec-shadow-base-wrong.k
new file mode 100644
index 0000000000000000000000000000000000000000..5b93729725e16f5fc1d08541f4a8d315970a6666
--- /dev/null
