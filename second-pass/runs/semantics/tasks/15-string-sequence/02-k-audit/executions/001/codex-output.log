+  fi
+done
+
+echo "Structured generation trace candidates:"
+find /candidate -maxdepth 1 -type f \( -iname '*trace*' -o -iname '*.jsonl' \) -printf '%p\n'
+
+echo "Prompt identity:"
+cmp -s /candidate/prompt.py /reference/prompt.py
