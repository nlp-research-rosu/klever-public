     1	# canonical.py — the UNMODIFIED HumanEval/15 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: string_sequence
     4	
     5	
     6	
     7	def string_sequence(n: int) -> str:
     8	    """ Return a string containing space-delimited numbers starting from 0 upto n inclusive.
     9	    >>> string_sequence(0)
    10	    '0'
    11	    >>> string_sequence(5)
    12	    '0 1 2 3 4 5'
    13	    """
    14	    return ' '.join([str(x) for x in range(n + 1)])

