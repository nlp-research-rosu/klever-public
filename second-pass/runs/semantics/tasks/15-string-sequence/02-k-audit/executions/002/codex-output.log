diff --git a/evidence/provenance_check.py b/evidence/provenance_check.py
new file mode 100644
index 0000000000000000000000000000000000000000..6338ddf19f982374cb2670d73782bcb0c7858883
--- /dev/null
+++ b/evidence/provenance_check.py
@@ -0,0 +1,119 @@
+#!/usr/bin/env python3
+"""Independent integrity checks for the mounted audit inputs."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+from pathlib import Path
+
+
+AUDIT_INPUT = Path("/audit-input.json")
+LOCK = Path("/audit-campaign-lock.json")
+
+
+def sha256(path: Path) -> str:
+    digest = hashlib.sha256()
+    with path.open("rb") as stream:
+        for block in iter(lambda: stream.read(1024 * 1024), b""):
+            digest.update(block)
+    return digest.hexdigest()
+
+
+def tree_entries(root: Path) -> list[tuple[str, str, str | None]]:
+    entries: list[tuple[str, str, str | None]] = []
+    for path in sorted(root.rglob("*")):
+        relative = path.relative_to(root).as_posix()
+        if path.is_symlink():
+            entries.append((relative, "symlink", os.readlink(path)))
+        elif path.is_dir():
+            entries.append((relative, "directory", None))
+        elif path.is_file():
+            entries.append((relative, "file", sha256(path)))
+        else:
+            entries.append((relative, "other", None))
+    return entries
+
+
+audit = json.loads(AUDIT_INPUT.read_text())
+lock = json.loads(LOCK.read_text())
+assert audit["record_layout"] == "legacy-selected-stage1"
+assert audit["semantics_mode"] == "SUPPLIED_SEMANTICS"
+assert audit["audit_campaign"] == lock
+assert sha256(LOCK) == audit["hashes"]["audit_campaign_lock_sha256"]
+
+paths = audit["container_paths"]
+required = [
+    Path(paths["candidate"]),
+    Path(paths["canonical"]),
+    Path(paths["translator"]),
+    Path(paths["trusted_prompt"]),
+    Path(paths["audit_campaign_lock"]),
+    Path(paths["run_manifest"]),
+    Path(paths["task_manifest"]),
+    Path(paths["stage1_result"]),
+    Path(paths["generation_manifest"]),
+    Path(paths["generation_metrics"]),
+    Path(paths["generation_last"]),
+    Path(paths["generation_output"]),
+    Path(paths["generation_root"]) / "prompt.txt",
+    Path(paths["generation_trace"]),
+]
+missing = [str(path) for path in required if not path.exists()]
+assert not missing, missing
+
+file_hash_expectations = {
+    LOCK: "audit_campaign_lock_sha256",
+    Path("/candidate/prompt.py"): "candidate_prompt_sha256",
+    Path("/candidate/py2mpy.py"): "candidate_translator_sha256",
+    Path("/reference/canonical.py"): "canonical_sha256",
+    Path("/reference/prompt.py"): "trusted_prompt_sha256",
+    Path("/reference/py2mpy.py"): "trusted_translator_sha256",
+    Path("/run.json"): "run_manifest_sha256",
+    Path("/task.json"): "task_manifest_sha256",
+    Path("/generation-result.json"): "stage1_result_sha256",
+    Path("/generation-evidence/invocation.json"): "stage1_invocation_sha256",
+    Path("/generation-evidence/metrics.json"): "generation_metrics_sha256",
+    Path("/generation-evidence/usage.json"): "generation_usage_sha256",
+    Path("/generation-evidence/codex-last.txt"): "generation_codex_last_sha256",
+    Path("/generation-evidence/codex-output.log"): "generation_codex_output_sha256",
+    Path("/generation-evidence/prompt.txt"): "generation_prompt_sha256",
+}
+for path, key in file_hash_expectations.items():
+    actual = sha256(path)
+    expected = audit["hashes"][key]
+    assert actual == expected, (path, actual, expected)
+
+trace_files = sorted(Path(paths["generation_trace"]).rglob("*"))
+trace_files = [path for path in trace_files if path.is_file()]
+assert len(trace_files) == 1
+assert sha256(trace_files[0]) == (
+    "f8af2f79072a8d57747d971f57d6b10a8e6e655d34dbaef64632c8ca93752edb"
+)
+
+assert Path("/candidate/prompt.py").read_bytes() == Path("/reference/prompt.py").read_bytes()
+assert Path("/candidate/py2mpy.py").read_bytes() == Path("/reference/py2mpy.py").read_bytes()
+
+candidate_semantics = tree_entries(Path("/candidate/reference-semantics"))
+trusted_semantics = tree_entries(Path("/reference/reference-semantics"))
+assert candidate_semantics == trusted_semantics
+assert not [entry for entry in candidate_semantics if entry[1] == "symlink"]
+
+trace_lines = 0
+with trace_files[0].open() as stream:
+    for trace_lines, line in enumerate(stream, 1):
+        json.loads(line)
+assert trace_lines == 724
+
+print("record_layout=legacy-selected-stage1")
+print("semantics_mode=SUPPLIED_SEMANTICS")
+print("campaign_lock_match=yes")
+print(f"required_mounts_and_records={len(required)} present")
+print(f"recorded_file_hashes={len(file_hash_expectations)} match")
+print(f"trace_files={len(trace_files)} trace_json_lines={trace_lines} all_valid")
+print("candidate_prompt_matches_trusted=yes")
+print("candidate_translator_matches_trusted=yes")
+print(f"semantics_entries={len(candidate_semantics)} exact_type_and_byte_match")
+print("semantics_symlinks=0")
+print("runtime_metrics=absent_and_not_required_for_legacy_selected_stage1")
diff --git a/evidence/verification-body-mutant.k b/evidence/verification-body-mutant.k
new file mode 100644
index 0000000000000000000000000000000000000000..8a9f8acef1a20c4ebe9c149a64973db46a4f4aa5
--- /dev/null
+++ b/evidence/verification-body-mutant.k
@@ -0,0 +1,58 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BASE
+  imports MPY
+
+  syntax IntSeq ::= sequenceCodes(Int) [function, injective]
+  rule sequenceCodes(0) => iCons(48, .IntSeq)
+  rule sequenceCodes(N:Int)
+    => seqConcat(sequenceCodes(N -Int 1),
+         iCons(32, strToCodes(Int2String(N))))
+    [owise]
+  rule sequenceCodes(N:Int)
+    => seqConcat(sequenceCodes(N -Int 1),
+         iCons(32, strToCodes(Int2String(N))))
+    requires N >=Int 1
+    [simplification]
+
+  rule inRange(I:Int, I +Int D:Int, 1) => D >Int 0 [simplification]
+  rule I:Int <Int I +Int D:Int => D >Int 0 [simplification]
+  rule seqConcat(sequenceCodes(X:Int -Int 1),
+                 iCons(32, strToCodes(Int2String(X))))
+    => sequenceCodes(X)
+    requires X >=Int 1
+    [simplification]
+
+  syntax Stmts ::= "sequenceLoopBody" [macro]
+  rule sequenceLoopBody
+    => Assign(Name("result"),
+         BinOp("+", Name("result"),
+           BinOp("+", Str(" "), Call(Name("str"), Name("i")))))
+
+  // Material body mutation: this changes the constructor term bound into the
+  // closure and executed by the claim from initial "0" to initial "WRONG".
+  syntax Stmts ::= "sequenceBody" [macro]
+  rule sequenceBody
+    => Expr(Str("Return the decimal integers from 0 through n, separated by spaces."))
+       If(Compare(Name("n"), CmpOp("<", Int(0))), Return(Str("")), .Stmts)
+       Assign(Name("result"), Str("WRONG"))
+       Assign(Name("i"), Int(1))
+       For(Name("i"), Call(Name("range"), Int(1), BinOp("+", Name("n"), Int(1))),
+           sequenceLoopBody)
+       Return(Name("result"))
+endmodule
+
+module VERIFICATION
+  imports VERIFICATION-BASE
+
+  // Unchanged candidate bridge: because its LHS uses the same macro, it now
+  // also matches the mutated body while its result remains the original answer.
+  rule <k> sequenceBody ~> #endcall
+        => Return(str(sequenceCodes(N))) ~> #endcall </k>
+       <env> 1 </env>
+       <scopes>
+         ... 1 |-> scope("n" |-> N:Int, parent(0)) ...
+       </scopes>
+    requires N >=Int 0
+    [priority(40)]
+endmodule

exec
/bin/bash -lc 'kompile verification-body-mutant.k --backend haskell --main-module VERIFICATION-BASE --syntax-module MPY-SYNTAX --output-definition audit-body-mutant-base-kompiled' in /tmp/audit-work/string-sequence
