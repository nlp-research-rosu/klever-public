      "normalized_sha256": "c93f82157c0edf66f39013c6c43f9942de4d4fdb03a65233bc92f11b525c2c62",
      "rationale": "This equation expands the named getMaxTriplesBody proof term into the translated statement sequence used by the configuration claim.",
      "source_rule_id": "rule-c93f82157c0edf66f39013c6c43f9942de4d4fdb03a65233bc92f11b525c2c62",
      "start_line": 9,
      "text": "  rule getMaxTriplesBody\n    => Assign(\n         Name(\"zero_count\"),\n         BinOp(\"//\", BinOp(\"+\", Name(\"n\"), Int(1)), Int(3)))\n       Assign(\n         Name(\"one_count\"),\n         BinOp(\"-\", Name(\"n\"), Name(\"zero_count\")))\n       Assign(\n         Name(\"zero_triples\"),\n         BinOp(\n           \"//\",\n           BinOp(\n             \"*\",\n             BinOp(\n               \"*\",\n               Name(\"zero_count\"),\n               BinOp(\"-\", Name(\"zero_count\"), Int(1))),\n             BinOp(\"-\", Name(\"zero_count\"), Int(2))),\n           Int(6)))\n       Assign(\n         Name(\"one_triples\"),\n         BinOp(\n           \"//\",\n           BinOp(\n             \"*\",\n             BinOp(\n               \"*\",\n               Name(\"one_count\"),\n               BinOp(\"-\", Name(\"one_count\"), Int(1))),\n             BinOp(\"-\", Name(\"one_count\"), Int(2))),\n           Int(6)))\n       Return(BinOp(\"+\", Name(\"zero_triples\"), Name(\"one_triples\")))\n       .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 48,
      "module": "VERIFICATION",
      "normalized_sha256": "6e1a3f1a867ffa5aac98437215b212d2acc24e46fb6c160c7eef1d20a27d3da2",
      "rationale": "This equation defines the chooseThree mathematical summary as the floored integer expression for selecting three items from a population.",
      "source_rule_id": "rule-6e1a3f1a867ffa5aac98437215b212d2acc24e46fb6c160c7eef1d20a27d3da2",
      "start_line": 46,
      "text": "  rule chooseThree(C:Int)\n    => (C *Int (C -Int 1) *Int (C -Int 2)\n        -Int pyMod(C *Int (C -Int 1) *Int (C -Int 2), 6)) /Int 6"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 53,
      "module": "VERIFICATION",
      "normalized_sha256": "ed9df131f37e783d697605c42deebd79589fdb258ea41d40595b1e3bc625bc2e",
      "rationale": "This equation defines the zeroResidues population summary by its floor-division expression.",
      "source_rule_id": "rule-ed9df131f37e783d697605c42deebd79589fdb258ea41d40595b1e3bc625bc2e",
      "start_line": 52,
      "text": "  rule zeroResidues(N:Int)\n    => (N +Int 1 -Int pyMod(N +Int 1, 3)) /Int 3"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 58,
      "module": "VERIFICATION",
      "normalized_sha256": "54b144e14a69f0c5714e7e1621ac7fbbcf27e44642f7d6a540aa852db23a3ef0",
      "rationale": "This equation defines tripleCount by composing the two population counts with chooseThree.",
      "source_rule_id": "rule-54b144e14a69f0c5714e7e1621ac7fbbcf27e44642f7d6a540aa852db23a3ef0",
      "start_line": 56,
      "text": "  rule tripleCount(N:Int)\n    => chooseThree(zeroResidues(N))\n       +Int chooseThree(N -Int zeroResidues(N))"
    }
  ],
