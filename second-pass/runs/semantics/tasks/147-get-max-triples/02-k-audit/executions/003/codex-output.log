+    printf '[failure did not contain an expected unmet-obligation diagnostic]\n'
+    status=1
+  else
+    printf '[expected semantic proof failure observed; audit condition satisfied]\n'
+  fi
+fi
+
+printf 'FINAL_STATUS=%d\n' "$status"
+exit "$status"
