diff --git a/evidence/spec-body-mutant.k b/evidence/spec-body-mutant.k
new file mode 100644
index 0000000000000000000000000000000000000000..f7e70e35f0be95a61c6c3016f4d634fd9d010c32
--- /dev/null
+++ b/evidence/spec-body-mutant.k
@@ -0,0 +1,27 @@
+requires "verification-body-mutant.k"
+
+module SPEC-BODY-MUTANT
+  imports VERIFICATION-BODY-MUTANT
+
+  claim [changed-body-must-not-prove]:
+    <k>
+      Call(Name("get_max_triples"), (Int(N:Int), .Exprs))
+      => tripleCountMutant(N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "get_max_triples" |-> closureVal(
+          ("n", .ParamNames), getMaxTriplesBodyMutant, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
