+  --output pretty
+if (( $? != 0 )); then
+  status=1
+elif ! grep -Fxq '#Top' /audit-output/evidence/kprove-entry-n5.log; then
+  printf '[missing exact #Top for entry-n5]\n'
+  status=1
+fi
+
+record kompile-body-mutant.log \
