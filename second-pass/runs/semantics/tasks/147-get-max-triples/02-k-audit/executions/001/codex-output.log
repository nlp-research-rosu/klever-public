+
+echo 'COMMAND: sha256sum /tmp/audit-work/reconstruction/solution.regenerated.mpy /tmp/audit-work/reconstruction/solution.mpy'
+sha256sum "$work/solution.regenerated.mpy" "$work/solution.mpy"
+hash_status=$?
