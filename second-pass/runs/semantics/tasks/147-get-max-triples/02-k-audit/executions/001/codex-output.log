def get_max_triples(n):
    """
    You are given a positive integer n. You have to create an integer array a of length n.
        For each i (1 ≤ i ≤ n), the value of a[i] = i * i - i + 1.
        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, 
    and a[i] + a[j] + a[k] is a multiple of 3.

    Example :
        Input: n = 5
        Output: 1
        Explanation: 
        a = [1, 3, 7, 13, 21]
        The only valid triple is (1, 7, 13).
    """
# canonical.py — the UNMODIFIED HumanEval/147 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: get_max_triples


def get_max_triples(n):
    """
    You are given a positive integer n. You have to create an integer array a of length n.
        For each i (1 ≤ i ≤ n), the value of a[i] = i * i - i + 1.
        Return the number of triples (a[i], a[j], a[k]) of a where i < j < k, 
    and a[i] + a[j] + a[k] is a multiple of 3.

    Example :
        Input: n = 5
        Output: 1
        Explanation: 
        a = [1, 3, 7, 13, 21]
        The only valid triple is (1, 7, 13).
    """
    A = [i*i - i + 1 for i in range(1,n+1)]
    ans = []
    for i in range(n):
        for j in range(i+1,n):
            for k in range(j+1,n):
                if (A[i]+A[j]+A[k])%3 == 0:
                    ans += [(A[i],A[j],A[k])]
    return len(ans)
def get_max_triples(n):
    zero_count = (n + 1) // 3
    one_count = n - zero_count
    zero_triples = zero_count * (zero_count - 1) * (zero_count - 2) // 6
    one_triples = one_count * (one_count - 1) * (one_count - 2) // 6
    return zero_triples + one_triples
Module(
  FuncDef("get_max_triples", Params("n"),
    Assign(
      Name("zero_count"),
      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)))
    Assign(Name("one_count"), BinOp("-", Name("n"), Name("zero_count")))
    Assign(
      Name("zero_triples"),
      BinOp(
        "//",
        BinOp(
          "*",
          BinOp(
            "*",
            Name("zero_count"),
            BinOp("-", Name("zero_count"), Int(1))),
          BinOp("-", Name("zero_count"), Int(2))),
        Int(6)))
    Assign(
      Name("one_triples"),
      BinOp(
        "//",
        BinOp(
          "*",
          BinOp(
            "*",
            Name("one_count"),
            BinOp("-", Name("one_count"), Int(1))),
          BinOp("-", Name("one_count"), Int(2))),
        Int(6)))
    Return(BinOp("+", Name("zero_triples"), Name("one_triples")))))
requires "verification.k"

module SPEC
  imports VERIFICATION

  // a_i = i^2-i+1 is 1, 1, 0 modulo 3 for i = 0, 1, 2 modulo 3.
  claim [residue-0]:
    <k>
      pyMod((3 *Int Q:Int) *Int (3 *Int Q)
            -Int (3 *Int Q) +Int 1, 3)
      => 1
    </k>

  claim [residue-1]:
    <k>
      pyMod((3 *Int Q:Int +Int 1) *Int (3 *Int Q +Int 1)
            -Int (3 *Int Q +Int 1) +Int 1, 3)
      => 1
    </k>

  claim [residue-2]:
    <k>
      pyMod((3 *Int Q:Int +Int 2) *Int (3 *Int Q +Int 2)
            -Int (3 *Int Q +Int 2) +Int 1, 3)
      => 0
    </k>

  // Execute the translated function for an arbitrary positive n.  The
  // right-hand side is the independently stated residue-counting model:
  // choose all three indices from the zero class or all three from the one
  // class.
  claim [get-max-triples-correct]:
    <k>
      Call(Name("get_max_triples"), (Int(N:Int), .Exprs))
      => tripleCount(N)
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(
        "get_max_triples" |-> closureVal(
          ("n", .ParamNames), getMaxTriplesBody, 0),
        parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N >Int 0
endmodule
requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // The statement sequence emitted in solution.mpy, named only to keep the
  // configuration claim readable.
  syntax Stmts ::= "getMaxTriplesBody" [function]
  rule getMaxTriplesBody
    => Assign(
         Name("zero_count"),
         BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)))
       Assign(
         Name("one_count"),
         BinOp("-", Name("n"), Name("zero_count")))
       Assign(
         Name("zero_triples"),
         BinOp(
           "//",
           BinOp(
             "*",
             BinOp(
               "*",
               Name("zero_count"),
               BinOp("-", Name("zero_count"), Int(1))),
             BinOp("-", Name("zero_count"), Int(2))),
           Int(6)))
       Assign(
         Name("one_triples"),
         BinOp(
           "//",
           BinOp(
             "*",
             BinOp(
               "*",
               Name("one_count"),
               BinOp("-", Name("one_count"), Int(1))),
             BinOp("-", Name("one_count"), Int(2))),
           Int(6)))
       Return(BinOp("+", Name("zero_triples"), Name("one_triples")))
       .Stmts

  // C(c, 3), written with the same floored-integer operation as Python.
  // The argument is always a non-negative population count.
  syntax Int ::= chooseThree(Int) [function]
  rule chooseThree(C:Int)
    => (C *Int (C -Int 1) *Int (C -Int 2)
        -Int pyMod(C *Int (C -Int 1) *Int (C -Int 2), 6)) /Int 6

  // Among 1,...,n, exactly floor((n+1)/3) indices are 2 modulo 3.
  syntax Int ::= zeroResidues(Int) [function]
  rule zeroResidues(N:Int)
    => (N +Int 1 -Int pyMod(N +Int 1, 3)) /Int 3

  syntax Int ::= tripleCount(Int) [function]
  rule tripleCount(N:Int)
    => chooseThree(zeroResidues(N))
       +Int chooseThree(N -Int zeroResidues(N))
endmodule
