requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // The statement sequence emitted in solution.mpy, named only to keep the
  // configuration claim readable.
  syntax Stmts ::= "getMaxTriplesBody" [function]
  rule getMaxTriplesBody
    => Assign(
         Name("zero_count"),
         BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)))
       Assign(
         Name("one_count"),
         BinOp("-", Name("n"), Name("zero_count")))
       Assign(
         Name("zero_triples"),
         BinOp(
           "//",
           BinOp(
             "*",
             BinOp(
               "*",
               Name("zero_count"),
               BinOp("-", Name("zero_count"), Int(1))),
             BinOp("-", Name("zero_count"), Int(2))),
           Int(6)))
       Assign(
         Name("one_triples"),
         BinOp(
           "//",
           BinOp(
             "*",
             BinOp(
               "*",
               Name("one_count"),
               BinOp("-", Name("one_count"), Int(1))),
             BinOp("-", Name("one_count"), Int(2))),
           Int(6)))
       Return(BinOp("+", Name("zero_triples"), Name("one_triples")))
       .Stmts

  // C(c, 3), written with the same floored-integer operation as Python.
  // The argument is always a non-negative population count.
  syntax Int ::= chooseThree(Int) [function]
  rule chooseThree(C:Int)
    => (C *Int (C -Int 1) *Int (C -Int 2)
        -Int pyMod(C *Int (C -Int 1) *Int (C -Int 2), 6)) /Int 6

  // Among 1,...,n, exactly floor((n+1)/3) indices are 2 modulo 3.
  syntax Int ::= zeroResidues(Int) [function]
  rule zeroResidues(N:Int)
    => (N +Int 1 -Int pyMod(N +Int 1, 3)) /Int 3

  syntax Int ::= tripleCount(Int) [function]
  rule tripleCount(N:Int)
    => chooseThree(zeroResidues(N))
       +Int chooseThree(N -Int zeroResidues(N))
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  // a_i = i^2-i+1 is 1, 1, 0 modulo 3 for i = 0, 1, 2 modulo 3.
  claim [residue-0]:
    <k>
      pyMod((3 *Int Q:Int) *Int (3 *Int Q)
            -Int (3 *Int Q) +Int 1, 3)
      => 1
    </k>

  claim [residue-1]:
    <k>
      pyMod((3 *Int Q:Int +Int 1) *Int (3 *Int Q +Int 1)
            -Int (3 *Int Q +Int 1) +Int 1, 3)
      => 1
    </k>

  claim [residue-2]:
    <k>
      pyMod((3 *Int Q:Int +Int 2) *Int (3 *Int Q +Int 2)
            -Int (3 *Int Q +Int 2) +Int 1, 3)
      => 0
    </k>

  // Execute the translated function for an arbitrary positive n.  The
  // right-hand side is the independently stated residue-counting model:
  // choose all three indices from the zero class or all three from the one
  // class.
  claim [get-max-triples-correct]:
    <k>
      Call(Name("get_max_triples"), (Int(N:Int), .Exprs))
      => tripleCount(N)
    </k>
    <env> 0 </env>
    <scopes>
      0 |-> scope(
        "get_max_triples" |-> closureVal(
          ("n", .ParamNames), getMaxTriplesBody, 0),
        parent(-1))
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N >Int 0
endmodule
