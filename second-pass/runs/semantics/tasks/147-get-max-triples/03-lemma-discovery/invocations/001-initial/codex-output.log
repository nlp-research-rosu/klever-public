/bin/bash -lc "python3 - <<'PY'
import json
from pathlib import Path
inv=json.loads(Path('/reference/rule-inventory.json').read_text())
out=json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed={'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert list(out.keys()) == ['schema_version','inventory_sha256','rules'], list(out.keys())
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules'])
assert [r['source_rule_id'] for r in out['rules']] == [r['source_rule_id'] for r in inv['rules']]
assert len({r['source_rule_id'] for r in out['rules']}) == len(inv['rules'])
for entry in out['rules']:
    assert list(entry.keys()) == ['source_rule_id','classification','rationale'], entry
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'],str) and entry['rationale'].strip()
for src, entry in zip(inv['rules'], out['rules']):
    if 'simplification' in src.get('attributes',[]):
        assert entry['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
print('validated schema:', out['schema_version'])
print('validated inventory sha256:', out['inventory_sha256'])
print('validated ordered unique rules:', len(out['rules']))
print('classification counts:', {c:sum(r['classification']==c for r in out['rules']) for c in sorted(allowed)})
