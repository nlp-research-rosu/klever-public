Module(
  FuncDef("get_max_triples", Params("n"),
    Assign(
      Name("zero_count"),
      BinOp("//", BinOp("+", Name("n"), Int(1)), Int(3)))
    Assign(Name("one_count"), BinOp("-", Name("n"), Name("zero_count")))
    Assign(
      Name("zero_triples"),
      BinOp(
        "//",
        BinOp(
          "*",
          BinOp(
            "*",
            Name("zero_count"),
            BinOp("-", Name("zero_count"), Int(1))),
          BinOp("-", Name("zero_count"), Int(2))),
        Int(6)))
    Assign(
      Name("one_triples"),
      BinOp(
        "//",
        BinOp(
          "*",
          BinOp(
            "*",
            Name("one_count"),
            BinOp("-", Name("one_count"), Int(1))),
          BinOp("-", Name("one_count"), Int(2))),
        Int(6)))
    Return(BinOp("+", Name("zero_triples"), Name("one_triples"))))
  Assert(
    Compare(Call(Name("get_max_triples"), Int(1)), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("get_max_triples"), Int(3)), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("get_max_triples"), Int(4)), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("get_max_triples"), Int(5)), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("get_max_triples"), Int(8)), CmpOp("==", Int(11))))
  Assert(
    Compare(
      Call(Name("get_max_triples"), Int(20)),
      CmpOp("==", Int(321)))))
