requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // Mathematical factorial, defined on all integers so that the functions
  // used in claims are total.  The proof only uses non-negative arguments.
  syntax Int ::= factorial(Int) [function, total]
  rule factorial(N:Int) => 1
       requires N <=Int 0
  rule factorial(N:Int) => factorial(N -Int 1) *Int N
       requires N >Int 0

  // Product 1! * 2! * ... * n!, equal to the prompt's reversed product.
  syntax Int ::= specialFactorial(Int) [function, total]
  rule specialFactorial(N:Int) => 1
       requires N <=Int 0
  rule specialFactorial(N:Int)
    => specialFactorial(N -Int 1) *Int factorial(N)
       requires N >Int 0
endmodule
requires "verification.k"

module SPEC
  imports VERIFICATION

  // Whole-program correctness for every input allowed by the prompt.
  // The source body below is exactly the body emitted in solution.mpy.
  claim [special-factorial-correct]:
    <k>
      #loadAll(Module(
        FuncDef("special_factorial", Params("n"),
          Assign(Name("factorial"), Int(1))
          Assign(Name("result"), Int(1))
          Assign(Name("i"), Int(1))
          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
            AugAssign(Name("factorial"), "*", Name("i"))
            AugAssign(Name("result"), "*", Name("factorial"))
            AugAssign(Name("i"), "+", Int(1)))
          Return(Name("result")))
        Assign(
          Name("answer"),
          Call(Name("special_factorial"), Int(N:Int)))
      ))
      =>
      .K
    </k>
    <env> 0 </env>
    <scopes>
      0  |-> scope(.Map, parent(-1))
      -1 |-> builtinsScope
      =>
      0  |-> scope(
        ?REST:Map
        "answer" |-> specialFactorial(N),
        parent(-1)
      )
      -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
    requires N >Int 0

  // Inductive loop invariant used by the whole-program claim.
  claim [special-factorial-loop]:
    <k>
      #while(
        Compare(Name("i"), CmpOp("<=", Name("n"))),
        AugAssign(Name("factorial"), "*", Name("i"))
        AugAssign(Name("result"), "*", Name("factorial"))
        AugAssign(Name("i"), "+", Int(1))
      ) ~> CONT:K
      =>
      CONT
    </k>
    <env> L:Int </env>
    <scopes>
      SC:Map
      L |-> scope(
        "n"         |-> N:Int
        "factorial" |-> factorial(I:Int -Int 1)
        "result"    |-> specialFactorial(I -Int 1)
        "i"         |-> I,
        parent(0)
      )
      =>
      SC
      L |-> scope(
        "n"         |-> N
        "factorial" |-> factorial(N)
        "result"    |-> specialFactorial(N)
        "i"         |-> N +Int 1,
        parent(0)
      )
    </scopes>
    requires N >=Int 1
     andBool I >=Int 1
     andBool I <=Int N +Int 1
endmodule
#!/usr/bin/env bash
set -euo pipefail

# Translate the submitted implementation and the concrete known-answer driver.
python3 py2mpy.py solution.py > solution.mpy
python3 py2mpy.py run.py > run.mpy

# Build and exercise the supplied concrete semantics.
rm -rf -- ./runtime-kompiled
kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled
krun run.mpy --definition runtime-kompiled --output pretty

# Build the symbolic definition without importing MPY-CONCRETE, then prove
# both the inductive loop invariant and whole-program correctness claim.
rm -rf -- ./verification-kompiled
kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SPEC \
  --output pretty

