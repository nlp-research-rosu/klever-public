+        "result"    |-> specialFactorial(N)
+        "i"         |-> N +Int 1,
+        parent(0)
+      )
+    </scopes>
+    requires N >=Int 1
+     andBool I >=Int 1
+     andBool I <=Int N +Int 1
+endmodule
