   276	  // ==== hashlib.md5(S).hexdigest() — a trusted opaque digest ==================
   277	  // The md5 value itself is a named shared trust (sortVS-style, no concrete
   278	  // twin); proofs use the length/hex-charset lemmas (lemmas/builtins.k).
   279	  syntax KItem ::= "#md5"
   280	  rule <k> Call(Attribute(Name("hashlib"), "md5"), (E:Expr, .Exprs)) => E ~> #md5 ... </k>
   281	       [priority(40)]
   282	  rule <k> str(CS:IntSeq) ~> #md5 => md5Obj(CS) ... </k>
   283	  syntax Val ::= md5Obj(IntSeq)
   284	  rule applyMethod(md5Obj(CS:IntSeq), "hexdigest", .Vals) => str(md5hexCodes(CS))
   285	  syntax IntSeq ::= md5hexCodes(IntSeq) [function, total, symbol(md5hexCodes), no-evaluators]
   286	
   287	  // ==== isinstance(V, int|str) — an ordinary 2-arg builtin ===================
   288	  // The type argument (int/str) is an ordinary name that resolves via the builtins frame to
   289	  // typeV (see core.k's config); no Call-level special case. isIntV/isStrV mirror the old
   290	  // owise-on-Val test (concrete-sort args decide; a symbolic Val stays owise, as before).
   291	  rule applyBuiltin("isinstance", V:Val, typeV("int"), .Vals) => isIntV(V)
   292	  rule applyBuiltin("isinstance", V:Val, typeV("str"), .Vals) => isStrV(V)
   293	  syntax Bool ::= isIntV(Val) [function] | isStrV(Val) [function]
   294	  rule isIntV(_:Int)         => true
   295	  rule isIntV(_:Val)         => false [owise]
   296	  rule isStrV(str(_:IntSeq)) => true
   297	  rule isStrV(_:Val)         => false [owise]
   298	endmodule
     1	// reference/src/semantics/bool.k — MPY-BOOL
     2	// Bool operator cases + the truthy boolean operations (not / and / or; and-or are
     3	// value-returning short-circuit over any Vals, per Python).
     4	
     5	module MPY-BOOL
     6	  imports MPY-CORE
     7	
     8	  rule applyUn("not", V:Val) => notBool truthy(V)
     9	
    10	  rule applyCmp("==", B1:Bool, B2:Bool) => B1 ==Bool B2
    11	  rule applyCmp("!=", B1:Bool, B2:Bool) => B1 =/=Bool B2
    12	
    13	  // ==== BoolOp: short-circuit, value-returning and / or =====================
    14	  // the node is its own accumulator: heat the HEAD element only, then either return it
    15	  // (short-circuit) or drop it and continue
    16	  context BoolOp(_, (HOLE:Expr, _:Exprs))
    17	  rule <k> BoolOp(_:String, (V:Val, .Exprs)) => V ... </k>
    18	  rule <k> BoolOp("and", (V:Val, A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
    19	       requires truthy(V)
    20	  rule <k> BoolOp("and", (V:Val, _:Expr, _:Exprs)) => V ... </k>
    21	       requires notBool truthy(V)
    22	  rule <k> BoolOp("or",  (V:Val, _:Expr, _:Exprs)) => V ... </k>
    23	       requires truthy(V)
    24	  rule <k> BoolOp("or",  (V:Val, A:Expr, REST:Exprs)) => BoolOp("or", (A, REST)) ... </k>
    25	       requires notBool truthy(V)
    26	
    27	  // ==== heap-object head: decide truthiness THROUGH the heap, never rewrite the
    28	  // operand — and/or return the OBJECT itself (Python identity), not its structure
    29	  rule <k> BoolOp(_:String, (ref(H:Int), .Exprs)) => ref(H) ... </k>
    30	       [priority(40)]
    31	  rule <k> BoolOp("and", (ref(H:Int), A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
    32	       <heap> ... H |-> V:Val ... </heap>
    33	       requires truthy(V)
    34	       [priority(40)]
    35	  rule <k> BoolOp("and", (ref(H:Int), _:Expr, _:Exprs)) => ref(H) ... </k>
    36	       <heap> ... H |-> V:Val ... </heap>
    37	       requires notBool truthy(V)
    38	       [priority(40)]
    39	  rule <k> BoolOp("or", (ref(H:Int), _:Expr, _:Exprs)) => ref(H) ... </k>
    40	       <heap> ... H |-> V:Val ... </heap>
    41	       requires truthy(V)
    42	       [priority(40)]
    43	  rule <k> BoolOp("or", (ref(H:Int), A:Expr, REST:Exprs)) => BoolOp("or", (A, REST)) ... </k>
    44	       <heap> ... H |-> V:Val ... </heap>
    45	       requires notBool truthy(V)
    46	       [priority(40)]
    47	endmodule
     1	// reference/src/semantics/assert.k — MPY-ASSERT
     2	
     3	module MPY-ASSERT
     4	  imports MPY-CORE
     5	
     6	  rule <k> Assert(V:Val) => .K ... </k>
     7	       requires truthy(V)
     8	  rule <k> Assert(V:Val) ~> _ => .K </k>
     9	       <exc> NoExc => AssertionError </exc>
    10	       <exit-code> _ => 1 </exit-code>
    11	       requires notBool truthy(V)
    12	
    13	  rule <k> Assert(ref(H:Int)) => Assert(V) ... </k>
    14	       <heap> ... H |-> V:Val ... </heap>
    15	       [priority(40)]
    16	endmodule
     1	// reference/src/semantics/iter.k — MPY-ITER
     2	// The iterator protocol, DECLARATION ONLY. Each iterable's #iterNext case lives in that
     3	// iterable's own module (list/tuple/str in their modules, rangeObj in range.k, zip in
     4	// builtins.k). Consumers (the for-loop, `x in _`, sum/all/any/max/min) import this.
     5	
     6	module MPY-ITER
     7	  imports MPY-CORE
     8	  syntax KItem ::= #iterNext(Iterable) | "#iterDone" | #iterYield(Val, Iterable)
     9	endmodule
     1	// reference/src/semantics/range.k — MPY-RANGE
     2	// rangeObj: the range helpers (inRange / rangeLen) + its #iterNext case. rangeObj itself is
     3	// declared in MPY-CORE's Iterable union; this module owns its behavior.
     4	
     5	module MPY-RANGE
     6	  imports MPY-CORE
     7	  imports MPY-ITER
     8	
     9	  syntax Bool ::= inRange(Int, Int, Int) [function, total]
    10	  rule inRange(I:Int, HI:Int, ST:Int) => (ST >Int 0 andBool I <Int HI) orBool (ST <Int 0 andBool I >Int HI)
    11	
    12	  syntax Int ::= rangeLen(Int, Int, Int) [function]
    13	  rule rangeLen(LO:Int, HI:Int, ST:Int) => (HI -Int LO +Int ST -Int 1) /Int ST
    14	       requires ST >Int 0 andBool HI >Int LO
    15	  rule rangeLen(LO:Int, HI:Int, ST:Int) => (LO -Int HI -Int ST -Int 1) /Int (0 -Int ST)
    16	       requires ST <Int 0 andBool HI <Int LO
    17	  rule rangeLen(LO:Int, HI:Int, ST:Int) => 0
    18	       requires (ST >Int 0 andBool HI <=Int LO) orBool (ST <Int 0 andBool HI >=Int LO)
    19	
    20	  rule <k> #iterNext(rangeObj(I:Int, HI:Int, ST:Int))
    21	        => #iterYield(I, rangeObj(I +Int ST, HI, ST)) ... </k>
    22	       requires inRange(I, HI, ST)
    23	  rule <k> #iterNext(rangeObj(I:Int, HI:Int, ST:Int)) => #iterDone ... </k>
    24	       requires notBool inRange(I, HI, ST)
    25	endmodule
     1	// reference/src/semantics/list.k — MPY-LIST
     2	
     3	module MPY-LIST
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	  imports MPY-OPERATORS
     7	
     8	  // ==== iteration (the iterator protocol's list case) =======================
     9	  rule <k> #iterNext(list(.ValSeq))                => #iterDone ... </k>
    10	  rule <k> #iterNext(list(vCons(V:Val, R:ValSeq))) => #iterYield(V, list(R)) ... </k>
    11	
    12	  // ==== ListExpr: [...] literal -> a fresh heap object =======================
    13	  syntax ApplyK ::= "toList"
    14	  rule <k> ListExpr(ES:Exprs) => #evalArgs(ES, .Vals, toList) ... </k>
    15	  rule <k> #applyK(toList, ACC:Vals) => #alloc(list(vals2valSeq(ACC))) ... </k>
    16	
    17	  // ==== list ops: + / == / != ===============================================
    18	  syntax ValSeq ::= valSeqConcat(ValSeq, ValSeq) [function, total]
    19	  rule valSeqConcat(.ValSeq, T:ValSeq)                => T
    20	  rule valSeqConcat(vCons(V:Val, S:ValSeq), T:ValSeq) => vCons(V, valSeqConcat(S, T))
    21	
    22	  // list + list constructs a NEW object (k-cell — it allocates; operands land here
    23	  // already deref'd). priority(45) beats the generic BinOp dispatch.
    24	  rule <k> BinOp("+", list(A:ValSeq), list(B:ValSeq)) => #alloc(list(valSeqConcat(A, B))) ... </k>
    25	       [priority(45)]
    26	
    27	  rule applyCmp("==", list(A:ValSeq), list(B:ValSeq)) => A ==K B
    28	  rule applyCmp("!=", list(A:ValSeq), list(B:ValSeq)) => notBool (A ==K B)
    29	
    30	  // ==== deep equality when elements are heap objects (list-of-lists) ========
    31	  // Python == is structural at every depth. Fires ONLY when a ref is present
    32	  // (the guard decides on concrete seqs); the plain ==K path above is unchanged.
    33	  syntax Bool ::= hasRefVS(ValSeq) [function, total]
    34	  rule hasRefVS(.ValSeq)                => false
    35	  rule hasRefVS(vCons(V:Val, R:ValSeq)) => isRefV(V) orBool hasRefVS(R)
    36	
    37	  syntax Bool ::= deepEqVS(ValSeq, ValSeq, Map) [function]
    38	                | deepEqV(Val, Val, Map)        [function]
    39	  rule deepEqVS(.ValSeq, .ValSeq, _:Map)                   => true
    40	  rule deepEqVS(.ValSeq, vCons(_:Val, _:ValSeq), _:Map)    => false
    41	  rule deepEqVS(vCons(_:Val, _:ValSeq), .ValSeq, _:Map)    => false
    42	  rule deepEqVS(vCons(A:Val, As:ValSeq), vCons(B:Val, Bs:ValSeq), HP:Map)
    43	    => deepEqV(A, B, HP) andBool deepEqVS(As, Bs, HP)
    44	
    45	  rule deepEqV(ref(H:Int), B:Val, HP:Map) => deepEqV({HP[H]}:>Val, B, HP)
    46	       requires H in_keys(HP)
    47	  rule deepEqV(A:Val, ref(H:Int), HP:Map) => deepEqV(A, {HP[H]}:>Val, HP)
    48	       requires notBool isRefV(A) andBool H in_keys(HP)
    49	  rule deepEqV(list(A:ValSeq), list(B:ValSeq), HP:Map) => deepEqVS(A, B, HP)
    50	  rule deepEqV(A:Val, B:Val, _:Map) => A ==K B [owise]
    51	
    52	  // ==== mutator: xs.append(v) — an in-place heap write ======================
    53	  rule <k> #applyK(toCall(boundMethodV(ref(H:Int), "append")), (V:Val, .Vals)) => noneV ... </k>
    54	       <heap> ... H |-> list(VS:ValSeq => valSeqConcat(VS, vCons(V, .ValSeq))) ... </heap>
    55	       [priority(40)]
    56	
    57	  // ==== `x in list` — a <k>-cell fold over #iterNext ========================
    58	  syntax KItem ::= #memberAcc(Val, Iterable) | #memberCont(Val) | "#notB"
    59	  rule <k> Compare(LV:Val, CmpOp("in",     list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ... </k>
    60	  rule <k> Compare(LV:Val, CmpOp("not in", list(VS:ValSeq))) => #memberAcc(LV, list(VS)) ~> #notB ... </k>
    61	  rule <k> #memberAcc(V:Val, IT:Iterable) => #iterNext(IT) ~> #memberCont(V) ... </k>
    62	  rule <k> #iterDone ~> #memberCont(_V:Val) => false ... </k>
    63	  rule <k> #iterYield(E:Val, _:Iterable) ~> #memberCont(V:Val) => true ... </k>
    64	       requires E ==K V
    65	  rule <k> #iterYield(E:Val, R:Iterable) ~> #memberCont(V:Val) => #memberAcc(V, R) ... </k>
    66	       requires notBool (E ==K V)
    67	  rule <k> B:Bool ~> #notB => notBool B ... </k>
    68	endmodule
     1	// reference/src/semantics/tuple.k — MPY-TUPLE
     2	
     3	module MPY-TUPLE
     4	  imports MPY-CORE
     5	  imports MPY-ITER
     6	  imports MPY-LIST
     7	  imports MPY-METHODS
     8	
     9	  // ==== iteration (the iterator protocol's tuple case) ======================
    10	  rule <k> #iterNext(tuple(.ValSeq))                => #iterDone ... </k>
    11	  rule <k> #iterNext(tuple(vCons(V:Val, R:ValSeq))) => #iterYield(V, tuple(R)) ... </k>
    12	
    13	  // ==== TupleExpr: tuple(ValSeq) literal + == != ===========================
    14	  syntax ApplyK ::= "toTuple"
    15	  rule <k> TupleExpr(ES:Exprs) => #evalArgs(ES, .Vals, toTuple) ... </k>
    16	  rule <k> #applyK(toTuple, ACC:Vals) => tuple(vals2valSeq(ACC)) ... </k>
    17	
    18	  rule applyCmp("==", tuple(A:ValSeq), tuple(B:ValSeq)) => A ==K B
    19	  // membership routes through the same k-cell fold as lists (list.k)
    20	  rule <k> Compare(LV:Val, CmpOp("in",     tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ... </k>
    21	  rule <k> Compare(LV:Val, CmpOp("not in", tuple(VS:ValSeq))) => #memberAcc(LV, tuple(VS)) ~> #notB ... </k>
    22	  // t.index(v): first index of v (ValueError out of subset)
    23	  rule applyMethod(tuple(VS:ValSeq), "index", V:Val, .Vals) => idxOfVS(VS, V, 0)
    24	  syntax Int ::= idxOfVS(ValSeq, Val, Int) [function]
    25	  rule idxOfVS(vCons(A:Val, _:ValSeq), V:Val, I:Int) => I requires A ==K V
    26	  rule idxOfVS(vCons(A:Val, R:ValSeq), V:Val, I:Int) => idxOfVS(R, V, I +Int 1)
    27	       requires notBool (A ==K V)
    28	  rule applyCmp("!=", tuple(A:ValSeq), tuple(B:ValSeq)) => notBool (A ==K B)
    29	
    30	  // ==== target binding: bind a Name or a TupleExpr target to a value ========
    31	  syntax KItem ::= #bindTgt(Expr, Val)
    32	  rule <k> #bindTgt(Name(X:String), V:Val) => .K ... </k>
    33	       <env> L:Int </env>
    34	       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>
    35	  rule <k> #bindTgt(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>
    36	       <env> L:Int </env>
    37	       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
    38	       requires "$cells" in_keys(M)
    39	        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
    40	        andBool X in_keys(M) andBool isCellRef({M[X]}:>Val)
    41	       [priority(40)]
    42	  rule <k> #bindTgt(TupleExpr(TS:Exprs), tuple(VS:ValSeq)) => #unpackSeq(TS, VS) ... </k>
    43	  rule <k> #bindTgt(TupleExpr(TS:Exprs), list(VS:ValSeq))  => #unpackSeq(TS, VS) ... </k>
    44	  rule <k> #bindTgt(TupleExpr(TS:Exprs), ref(H:Int)) => #bindTgt(TupleExpr(TS), V) ... </k>
    45	       <heap> ... H |-> V:Val ... </heap>
    46	       [priority(40)]
    47	
    48	  // ==== unpacking: a, b = <tuple|list> (RHS evaluated by strictness) ========
    49	  syntax KItem ::= #unpackSeq(Exprs, ValSeq)
    50	  rule <k> Assign(TupleExpr(TS:Exprs), tuple(VS:ValSeq)) => #unpackSeq(TS, VS) ... </k>
    51	  rule <k> Assign(TupleExpr(TS:Exprs), list(VS:ValSeq))  => #unpackSeq(TS, VS) ... </k>
    52	  rule <k> Assign(TupleExpr(TS:Exprs), ref(H:Int)) => Assign(TupleExpr(TS), V) ... </k>
    53	       <heap> ... H |-> V:Val ... </heap>
    54	       [priority(40)]
    55	  rule <k> #unpackSeq((T:Expr, TS:Exprs), vCons(V:Val, VS:ValSeq))
    56	        => #bindTgt(T, V) ~> #unpackSeq(TS, VS) ... </k>
    57	  rule <k> #unpackSeq(.Exprs, .ValSeq) => .K ... </k>
    58	endmodule

diff --git a//tmp/audit-work/case/spec-body-mutation.k b//tmp/audit-work/case/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..7d190f2175608664808996667cb7d695f135a624
--- /dev/null
+++ b//tmp/audit-work/case/spec-body-mutation.k
@@ -0,0 +1,82 @@
+requires "verification.k"
+
+module SPEC-BODY-MUTATION
+  imports VERIFICATION
+
+  // Reviewer mutation: execute the real loop but return factorial rather than
+  // result. The unchanged postcondition is false, e.g. N=3 gives 6, not 12.
+  claim [special-factorial-correct-body-mutated]:
+    <k>
+      #loadAll(Module(
+        FuncDef("special_factorial", Params("n"),
+          Assign(Name("factorial"), Int(1))
+          Assign(Name("result"), Int(1))
+          Assign(Name("i"), Int(1))
+          While(Compare(Name("i"), CmpOp("<=", Name("n"))),
+            AugAssign(Name("factorial"), "*", Name("i"))
+            AugAssign(Name("result"), "*", Name("factorial"))
+            AugAssign(Name("i"), "+", Int(1)))
+          Return(Name("factorial")))
+        Assign(
+          Name("answer"),
+          Call(Name("special_factorial"), Int(N:Int)))
+      ))
+      =>
+      .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+      =>
+      0  |-> scope(
+        ?REST:Map
+        "answer" |-> specialFactorial(N),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >Int 0
+
+  claim [special-factorial-loop]:
+    <k>
+      #while(
+        Compare(Name("i"), CmpOp("<=", Name("n"))),
+        AugAssign(Name("factorial"), "*", Name("i"))
+        AugAssign(Name("result"), "*", Name("factorial"))
+        AugAssign(Name("i"), "+", Int(1))
+      ) ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        "n"         |-> N:Int
+        "factorial" |-> factorial(I:Int -Int 1)
+        "result"    |-> specialFactorial(I -Int 1)
+        "i"         |-> I,
+        parent(0)
+      )
+      =>
+      SC
+      L |-> scope(
+        "n"         |-> N
+        "factorial" |-> factorial(N)
+        "result"    |-> specialFactorial(N)
+        "i"         |-> N +Int 1,
+        parent(0)
+      )
+    </scopes>
+    requires N >=Int 1
+     andBool I >=Int 1
+     andBool I <=Int N +Int 1
+endmodule
diff --git a/evidence/check_program_pinning.py b/evidence/check_program_pinning.py
new file mode 100644
index 0000000000000000000000000000000000000000..8ae02d55f06ee68d1b3fca92f96d4a7b3575cc14
--- /dev/null
+++ b/evidence/check_program_pinning.py
@@ -0,0 +1,83 @@
+#!/usr/bin/env python3
+"""Mechanically compare the translated function term with the spec entry term."""
+
+from __future__ import annotations
+
+import hashlib
+from pathlib import Path
+
+
+def balanced_call(text: str, start: int) -> str:
+    open_paren = text.find("(", start)
+    if open_paren < 0:
+        raise AssertionError("constructor has no opening parenthesis")
+    depth = 0
+    quoted = False
+    escaped = False
+    for index in range(open_paren, len(text)):
+        char = text[index]
+        if quoted:
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == '"':
+                quoted = False
+            continue
+        if char == '"':
+            quoted = True
+        elif char == "(":
+            depth += 1
+        elif char == ")":
+            depth -= 1
+            if depth == 0:
+                return text[start : index + 1]
+    raise AssertionError("unterminated constructor")
+
+
+def normalize(text: str) -> str:
+    """Remove insignificant whitespace while retaining quoted string bytes."""
+    output: list[str] = []
+    quoted = False
+    escaped = False
+    for char in text:
+        if quoted:
+            output.append(char)
+            if escaped:
+                escaped = False
+            elif char == "\\":
+                escaped = True
+            elif char == '"':
+                quoted = False
+        elif char == '"':
+            quoted = True
+            output.append(char)
+        elif not char.isspace():
+            output.append(char)
+    return "".join(output)
+
+
+def main() -> None:
+    solution = Path("/tmp/audit-work/case/solution.regenerated.mpy").read_text()
+    spec = Path("/tmp/audit-work/case/spec.k").read_text()
+    solution_start = solution.index('FuncDef("special_factorial"')
+    spec_start = spec.index('FuncDef("special_factorial"')
+    solution_function = normalize(balanced_call(solution, solution_start))
+    spec_function = normalize(balanced_call(spec, spec_start))
+    print(f"solution_function={solution_function}")
+    print(f"spec_function={spec_function}")
+    print(
+        "solution_function_sha256="
+        + hashlib.sha256(solution_function.encode()).hexdigest()
+    )
+    print(
+        "spec_function_sha256="
+        + hashlib.sha256(spec_function.encode()).hexdigest()
+    )
+    print(f"constructor_identity={solution_function == spec_function}")
+    if solution_function != spec_function:
+        raise AssertionError("entry claim executes a different function term")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/evidence/concrete_driver.py b/evidence/concrete_driver.py
new file mode 100644
index 0000000000000000000000000000000000000000..e762b156b73ce7dce8508ec84eb476e1e0a4620d
--- /dev/null
+++ b/evidence/concrete_driver.py
@@ -0,0 +1,18 @@
+def special_factorial(n):
+    factorial = 1
+    result = 1
+    i = 1
+    while i <= n:
+        factorial *= i
+        result *= factorial
+        i += 1
+    return result
+
+
+# Intended-domain lower boundary, documented example, and a larger normal case.
+assert special_factorial(1) == 1
+assert special_factorial(4) == 288
+assert special_factorial(6) == 24883200
+
+# Robustness boundary just outside the stated n > 0 contract.
+assert special_factorial(0) == 1
diff --git a/evidence/differential_test.py b/evidence/differential_test.py
new file mode 100644
index 0000000000000000000000000000000000000000..40e5a502d884af6964e5d872f1b45040b2aba50d
--- /dev/null
+++ b/evidence/differential_test.py
@@ -0,0 +1,80 @@
+#!/usr/bin/env python3
+"""Independent differential test for HumanEval 139-special-factorial."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import math
+from pathlib import Path
+import random
+
+
+def load_entry(module_name: str, path: Path):
+    spec = importlib.util.spec_from_file_location(module_name, path)
+    if spec is None or spec.loader is None:
+        raise RuntimeError(f"cannot import {path}")
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module.special_factorial
+
+
+def independent_oracle(n: int) -> int:
+    return math.prod(math.factorial(k) for k in range(1, n + 1))
+
+
+def render(value: int) -> str:
+    text = str(value)
+    if len(text) <= 80:
+        return text
+    digest = hashlib.sha256(text.encode()).hexdigest()
+    return f"<digits={len(text)} sha256={digest}>"
+
+
+def main() -> None:
+    canonical = load_entry(
+        "trusted_humaneval_139", Path("/reference/canonical.py")
+    )
+    generated = load_entry(
+        "candidate_humaneval_139", Path("/tmp/audit-work/case/solution.py")
+    )
+
+    # Documented n=4, the n>0 lower boundary, the loop's no-iteration
+    # robustness boundary n=0, negative out-of-contract cases, small
+    # progression values, and larger deterministic values.
+    fixed = [-3, -1, 0, 1, 2, 3, 4, 5, 6, 10, 20, 30]
+    rng = random.Random(139)
+    generated_inputs = [rng.randint(1, 60) for _ in range(100)]
+    inputs = fixed + generated_inputs
+
+    intended_mismatches = []
+    robustness_mismatches = []
+    for index, n in enumerate(inputs):
+        expected = canonical(n)
+        actual = generated(n)
+        oracle = independent_oracle(n)
+        category = "intended" if n > 0 else "out-of-contract"
+        print(
+            f"case={index:03d} n={n} category={category} "
+            f"canonical={render(expected)} generated={render(actual)} "
+            f"oracle={render(oracle)}"
+        )
+        mismatch = expected != actual or expected != oracle
+        if mismatch and n > 0:
+            intended_mismatches.append((n, expected, actual, oracle))
+        elif mismatch:
+            robustness_mismatches.append((n, expected, actual, oracle))
+
+    print(f"fixed_inputs={fixed}")
+    print(f"random_seed=139 random_count={len(generated_inputs)}")
+    print(f"random_inputs={generated_inputs}")
+    print(f"intended_domain_cases={sum(n > 0 for n in inputs)}")
+    print(f"intended_domain_mismatches={len(intended_mismatches)}")
+    print(f"out_of_contract_cases={sum(n <= 0 for n in inputs)}")
+    print(f"out_of_contract_mismatches={len(robustness_mismatches)}")
+    if intended_mismatches:
+        raise AssertionError(intended_mismatches)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/evidence/inventory_k_sources.py b/evidence/inventory_k_sources.py
new file mode 100644
index 0000000000000000000000000000000000000000..d3774c60ab1333708143df336e17b286d4691773
--- /dev/null
