--- /dev/null
+++ b/evidence/run-evidence.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ "$#" -lt 2 ]]; then
+  printf 'usage: %s LOGFILE COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+logfile=$1
+shift
+
+{
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$logfile"
+
+set +e
+"$@" 2>&1 | tee -a "$logfile"
+command_status=${PIPESTATUS[0]}
+set -e
+
+printf '[exit code: %d]\n' "$command_status" | tee -a "$logfile"
+exit "$command_status"

codex
The failure is now pinned down: Lean asks `readlink("/proc/<namespace-pid>/exe")`, but this audit container exposes a different `/proc` PID namespace, so that path returns `ENOENT`; `/proc/self/exe` remains valid. I’m applying a narrowly scoped, auditable preload shim only for that executable-path lookup, then rerunning the unchanged trusted preflight.
apply patch
