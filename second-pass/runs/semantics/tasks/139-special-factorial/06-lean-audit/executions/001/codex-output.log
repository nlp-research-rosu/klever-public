+#!/usr/bin/env bash
+set -u
+
+if [[ "$#" -lt 2 ]]; then
+  printf 'usage: %s LOGFILE COMMAND [ARG ...]\n' "$0" >&2
+  exit 64
+fi
+
+logfile=$1
+shift
+
+{
+  printf '$'
+  printf ' %q' "$@"
