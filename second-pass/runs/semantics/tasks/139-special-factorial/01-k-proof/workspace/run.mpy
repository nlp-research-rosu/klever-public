Module(
  FuncDef("special_factorial", Params("n"),
    Assign(Name("factorial"), Int(1))
    Assign(Name("result"), Int(1))
    Assign(Name("i"), Int(1))
    While(Compare(Name("i"), CmpOp("<=", Name("n"))),
      AugAssign(Name("factorial"), "*", Name("i"))
      AugAssign(Name("result"), "*", Name("factorial"))
      AugAssign(Name("i"), "+", Int(1)))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("special_factorial"), Int(1)),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("special_factorial"), Int(2)),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("special_factorial"), Int(3)),
      CmpOp("==", Int(12))))
  Assert(
    Compare(
      Call(Name("special_factorial"), Int(4)),
      CmpOp("==", Int(288))))
  Assert(
    Compare(
      Call(Name("special_factorial"), Int(5)),
      CmpOp("==", Int(34560))))
  Assert(
    Compare(
      Call(Name("special_factorial"), Int(6)),
      CmpOp("==", Int(24883200)))))
