python3 /audit-output/evidence/claim_witnesses.py >/tmp/audit-work/final-witnesses.out
printf 'review_final_line_count='; tail -n 2 /audit-output/REVIEW.md | wc -l
printf 'verdict_markers='; rg -n '"'^VERDICT:|''^LEGITIMACY:'"' /audit-output/REVIEW.md" in /audit-output
