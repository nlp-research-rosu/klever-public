+    <k> roundedAvgCall(N:Int, M:Int)
+      => str(iCons(48, iCons(98,
+           binCodes(((N +Int M -Int 1) /Int 2) +Int 1))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
