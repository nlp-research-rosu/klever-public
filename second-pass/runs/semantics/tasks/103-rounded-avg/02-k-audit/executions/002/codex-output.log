+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires N >Int 0 andBool M >Int 0 andBool N <=Int M
+      andBool pyMod(N +Int M, 2) ==Int 1
+      andBool pyMod((N +Int M -Int 1) /Int 2, 2) ==Int 1
+endmodule
