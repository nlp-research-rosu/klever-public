diff --git a//tmp/audit-work/103-rounded-avg/audit-claim-half-down.k b//tmp/audit-work/103-rounded-avg/audit-claim-half-down.k
new file mode 100644
index 0000000000000000000000000000000000000000..27819fb94a87ed818b2a425c42914e22db9cdd9a
--- /dev/null
+++ b//tmp/audit-work/103-rounded-avg/audit-claim-half-down.k
@@ -0,0 +1,24 @@
+requires "verification.k"
+
+module AUDIT-CLAIM-HALF-DOWN
+  imports ROUNDED-AVG-VERIFICATION
+
+  claim
+    <k> roundedAvgCall(N:Int, M:Int)
+      => str(iCons(48, iCons(98, binCodes((N +Int M -Int 1) /Int 2))))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires N >Int 0 andBool M >Int 0 andBool N <=Int M
+      andBool pyMod(N +Int M, 2) ==Int 1
+      andBool pyMod((N +Int M -Int 1) /Int 2, 2) ==Int 0
+endmodule
