diff --git a//tmp/audit-work/reconstruction/spec-inverted.k b//tmp/audit-work/reconstruction/spec-inverted.k
new file mode 100644
index 0000000000000000000000000000000000000000..b46b2820a2b5c63f52b793247e468103e7b038d3
--- /dev/null
+++ b//tmp/audit-work/reconstruction/spec-inverted.k
@@ -0,0 +1,20 @@
+requires "verification.k"
+
+module ROUNDED-AVG-SPEC-INVERTED
+  imports ROUNDED-AVG-VERIFICATION
+
+  claim
