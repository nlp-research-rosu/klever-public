     1	requires "reference-semantics/semantics.k"
     2	
     3	module ROUNDED-AVG-VERIFICATION
     4	  imports MPY
     5	
     6	  // This is exactly the translated body of rounded_avg from solution.mpy.
     7	  // Naming it here keeps each reachability claim focused on its input class
     8	  // and expected result.
     9	  syntax Stmts ::= "roundedAvgBody" [function, total]
    10	  rule roundedAvgBody
    11	    => If(Compare(Name("n"), CmpOp(">", Name("m"))),
    12	         Return(UnaryOp("-", Int(1))),
    13	         .Stmts)
    14	       Assign(Name("total"), BinOp("+", Name("n"), Name("m")))
    15	       Assign(Name("average"), BinOp("//", Name("total"), Int(2)))
    16	       If(Compare(BinOp("%", Name("total"), Int(2)),
    17	                  CmpOp("==", Int(1))),
    18	          If(Compare(BinOp("%", Name("average"), Int(2)),
    19	                     CmpOp("==", Int(1))),
    20	             Assign(Name("average"),
    21	                    BinOp("+", Name("average"), Int(1))),
    22	             .Stmts),
    23	          .Stmts)
    24	       Return(Call(Name("bin"), Name("average"), .Exprs))
    25	       .Stmts
    26	
    27	  // A direct entry-point call. Its closure has the module scope as parent,
    28	  // just as the closure produced by the module-level FuncDef in solution.mpy.
    29	  syntax Expr ::= roundedAvgCall(Int, Int) [function, total]
    30	  rule roundedAvgCall(N:Int, M:Int)
    31	    => Call(closureVal(("n", "m", .ParamNames), roundedAvgBody, 0),
    32	            (N, M, .Exprs))
    33	endmodule
     1	requires "verification.k"
     2	
     3	module ROUNDED-AVG-SPEC
     4	  imports ROUNDED-AVG-VERIFICATION
     5	
     6	  // Contract branch: an inverted inclusive interval returns -1.
     7	  claim
     8	    <k> roundedAvgCall(N:Int, M:Int) => -1 </k>
     9	    <env> 0 </env>
    10	    <scopes>
    11	      0  |-> scope(.Map, parent(-1))
    12	      -1 |-> builtinsScope
    13	    </scopes>
    14	    <scopeLoc> 1 </scopeLoc>
    15	    <heap> .Map </heap>
    16	    <heapLoc> 0 </heapLoc>
    17	    <stack> .List </stack>
    18	    <ret> noRet </ret>
    19	    <exc> NoExc </exc>
    20	    requires N >Int 0 andBool M >Int 0 andBool N >Int M
    21	
    22	  // Valid interval, integral mean: no rounding adjustment is needed.
    23	  claim
    24	    <k> roundedAvgCall(N:Int, M:Int)
    25	      => str(iCons(48, iCons(98, binCodes((N +Int M) /Int 2))))
    26	    </k>
    27	    <env> 0 </env>
    28	    <scopes>
    29	      0  |-> scope(.Map, parent(-1))
    30	      -1 |-> builtinsScope
    31	    </scopes>
    32	    <scopeLoc> 1 </scopeLoc>
    33	    <heap> .Map </heap>
    34	    <heapLoc> 0 </heapLoc>
    35	    <stack> .List </stack>
    36	    <ret> noRet </ret>
    37	    <exc> NoExc </exc>
    38	    requires N >Int 0 andBool M >Int 0 andBool N <=Int M
    39	      andBool pyMod(N +Int M, 2) ==Int 0
    40	
    41	  // Exact x.5 mean whose lower neighbor is even: half-even rounds down.
    42	  claim
    43	    <k> roundedAvgCall(N:Int, M:Int)
    44	      => str(iCons(48, iCons(98, binCodes((N +Int M -Int 1) /Int 2))))
    45	    </k>
    46	    <env> 0 </env>
    47	    <scopes>
    48	      0  |-> scope(.Map, parent(-1))
    49	      -1 |-> builtinsScope
    50	    </scopes>
    51	    <scopeLoc> 1 </scopeLoc>
    52	    <heap> .Map </heap>
    53	    <heapLoc> 0 </heapLoc>
    54	    <stack> .List </stack>
    55	    <ret> noRet </ret>
    56	    <exc> NoExc </exc>
    57	    requires N >Int 0 andBool M >Int 0 andBool N <=Int M
    58	      andBool pyMod(N +Int M, 2) ==Int 1
    59	      andBool pyMod((N +Int M -Int 1) /Int 2, 2) ==Int 0
    60	
    61	  // Exact x.5 mean whose lower neighbor is odd: half-even rounds up.
    62	  claim
    63	    <k> roundedAvgCall(N:Int, M:Int)
    64	      => str(iCons(48, iCons(98,
    65	           binCodes(((N +Int M -Int 1) /Int 2) +Int 1))))
    66	    </k>
    67	    <env> 0 </env>
    68	    <scopes>
    69	      0  |-> scope(.Map, parent(-1))
    70	      -1 |-> builtinsScope
    71	    </scopes>
    72	    <scopeLoc> 1 </scopeLoc>
    73	    <heap> .Map </heap>
    74	    <heapLoc> 0 </heapLoc>
    75	    <stack> .List </stack>
    76	    <ret> noRet </ret>
    77	    <exc> NoExc </exc>
    78	    requires N >Int 0 andBool M >Int 0 andBool N <=Int M
    79	      andBool pyMod(N +Int M, 2) ==Int 1
    80	      andBool pyMod((N +Int M -Int 1) /Int 2, 2) ==Int 1
    81	endmodule
     1	def rounded_avg(n, m):
     2	    if n > m:
     3	        return -1
     4	
     5	    total = n + m
     6	    average = total // 2
     7	    if total % 2 == 1:
     8	        if average % 2 == 1:
     9	            average = average + 1
    10	
    11	    return bin(average)
     1	Module(
     2	  FuncDef("rounded_avg", Params("n", "m"),
     3	    If(Compare(Name("n"), CmpOp(">", Name("m"))),
     4	      Return(UnaryOp("-", Int(1))),
     5	      )
     6	    Assign(Name("total"), BinOp("+", Name("n"), Name("m")))
     7	    Assign(Name("average"), BinOp("//", Name("total"), Int(2)))
     8	    If(Compare(BinOp("%", Name("total"), Int(2)), CmpOp("==", Int(1))),
     9	      If(Compare(BinOp("%", Name("average"), Int(2)), CmpOp("==", Int(1))),
    10	        Assign(Name("average"), BinOp("+", Name("average"), Int(1))),
    11	        ),
    12	      )
    13	    Return(Call(Name("bin"), Name("average")))))
