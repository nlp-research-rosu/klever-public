+)
+
+summary = {
+    "status": "PASS" if not failures else "FAIL",
+    "failure_count": len(failures),
+    "failures": failures,
+    "checks": results,
+}
+print(json.dumps(summary, indent=2, sort_keys=True))
+raise SystemExit(0 if not failures else 1)

