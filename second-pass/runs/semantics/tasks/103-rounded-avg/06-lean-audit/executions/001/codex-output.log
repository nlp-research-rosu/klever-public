+    generator_manifest.get("provenance", {}).get("inventory_sha256"),
+)
+
+verification_hash = file_sha256(Path("/reference/k-proof/verification.k"))
+for name, document in (
+    ("input_manifest.frozen_input_sha256", input_manifest),
