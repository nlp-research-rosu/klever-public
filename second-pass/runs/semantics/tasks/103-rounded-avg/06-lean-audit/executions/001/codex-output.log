     1	def rounded_avg(n, m):
     2	    if n > m:
     3	        return -1
     4	
     5	    total = n + m
     6	    average = total // 2
     7	    if total % 2 == 1:
     8	        if average % 2 == 1:
     9	            average = average + 1
    10	
    11	    return bin(average)
