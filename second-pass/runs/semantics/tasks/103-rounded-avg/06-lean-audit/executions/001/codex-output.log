+)
+check("producer_source_manifest.schema_version", source_manifest.get(
+    "schema_version"
+), 1)
+check(
+    "producer_source_manifest.files",
+    producer_hashes,
+    source_manifest.get("files"),
+)
+check(
+    "generator_manifest.exporter_sha256",
+    producer_hashes["klean_export.py"],
