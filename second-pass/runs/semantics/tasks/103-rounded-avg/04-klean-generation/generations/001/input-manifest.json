      "normalized_sha256": "07b2e76171363735048d516894c0106df978020141671339aaa271a5d5e0d8e7",
      "rationale": "This equation defines the named roundedAvgBody proof term by expanding it to the translated statement sequence; it is a structural AST helper and asserts no additional mathematical fact.",
      "source_rule_id": "rule-07b2e76171363735048d516894c0106df978020141671339aaa271a5d5e0d8e7",
      "start_line": 10,
      "text": "  rule roundedAvgBody\n    => If(Compare(Name(\"n\"), CmpOp(\">\", Name(\"m\"))),\n         Return(UnaryOp(\"-\", Int(1))),\n         .Stmts)\n       Assign(Name(\"total\"), BinOp(\"+\", Name(\"n\"), Name(\"m\")))\n       Assign(Name(\"average\"), BinOp(\"//\", Name(\"total\"), Int(2)))\n       If(Compare(BinOp(\"%\", Name(\"total\"), Int(2)),\n                  CmpOp(\"==\", Int(1))),\n          If(Compare(BinOp(\"%\", Name(\"average\"), Int(2)),\n                     CmpOp(\"==\", Int(1))),\n             Assign(Name(\"average\"),\n                    BinOp(\"+\", Name(\"average\"), Int(1))),\n             .Stmts),\n          .Stmts)\n       Return(Call(Name(\"bin\"), Name(\"average\"), .Exprs))\n       .Stmts"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 32,
      "module": "ROUNDED-AVG-VERIFICATION",
      "normalized_sha256": "5e130f83335a10b2992b3283bceb5cbf4e9d208c0b150ab3918d09173e3f7ad7",
      "rationale": "This equation defines the named roundedAvgCall proof term by expanding it to a call of the rounded_avg closure with N and M; it is a total proof-harness constructor rather than an additional execution or domain fact.",
      "source_rule_id": "rule-5e130f83335a10b2992b3283bceb5cbf4e9d208c0b150ab3918d09173e3f7ad7",
      "start_line": 30,
      "text": "  rule roundedAvgCall(N:Int, M:Int)\n    => Call(closureVal((\"n\", \"m\", .ParamNames), roundedAvgBody, 0),\n            (N, M, .Exprs))"
    }
  ],
