Module(
  FuncDef("rounded_avg", Params("n", "m"),
    If(Compare(Name("n"), CmpOp(">", Name("m"))),
      Return(UnaryOp("-", Int(1))),
      )
    Assign(Name("total"), BinOp("+", Name("n"), Name("m")))
    Assign(Name("average"), BinOp("//", Name("total"), Int(2)))
    If(Compare(BinOp("%", Name("total"), Int(2)), CmpOp("==", Int(1))),
      If(Compare(BinOp("%", Name("average"), Int(2)), CmpOp("==", Int(1))),
        Assign(Name("average"), BinOp("+", Name("average"), Int(1))),
        ),
      )
    Return(Call(Name("bin"), Name("average"))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(1), Int(5)),
      CmpOp("==", Str("0b11"))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(7), Int(5)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(10), Int(20)),
      CmpOp("==", Str("0b1111"))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(20), Int(33)),
      CmpOp("==", Str("0b11010"))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(1), Int(1)),
      CmpOp("==", Str("0b1"))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(1), Int(2)),
      CmpOp("==", Str("0b10"))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(2), Int(3)),
      CmpOp("==", Str("0b10"))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(4), Int(5)),
      CmpOp("==", Str("0b100"))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(99), Int(100)),
      CmpOp("==", Str("0b1100100")))))
