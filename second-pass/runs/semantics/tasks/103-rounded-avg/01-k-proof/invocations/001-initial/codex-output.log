diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..1b4429d9d3515c4856d2352291e7a7b72e3fe19d
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def rounded_avg(n, m):
+    if n > m:
+        return -1
+
+    total = n + m
+    average = total // 2
+    if total % 2 == 1:
+        if average % 2 == 1:
+            average = average + 1
+
+    return bin(average)
