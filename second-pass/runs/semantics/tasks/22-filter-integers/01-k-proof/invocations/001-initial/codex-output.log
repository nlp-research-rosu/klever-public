+requires "verification.k"
+
+module FILTER-SPEC
+  imports FILTER-VERIFICATION
+
+  claim [empty]:
+    <k> #loadAll(FILTER-PROGRAM)
+         ~> Call(Name("filter_integers"), list(.ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0  |-> scope("filter_integers" |-> FILTER-CLOSURE, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Symbolic form of the first prompt example: arbitrary string, float, and
+  // integer values in the same positions.
+  claim [prompt-example-one]:
+    <k> #loadAll(FILTER-PROGRAM)
+         ~> Call(
+              Name("filter_integers"),
+              list(vCons(str(S:IntSeq),
+                   vCons(F:Float,
+                   vCons(I:Int, .ValSeq)))))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0  |-> scope("filter_integers" |-> FILTER-CLOSURE, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(vCons(I, .ValSeq)) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Symbolic form of the second prompt example.  The non-integers include a
+  // string, dictionary, and list semantic value.
+  claim [prompt-example-two]:
+    <k> #loadAll(FILTER-PROGRAM)
+         ~> Call(
+              Name("filter_integers"),
+              list(vCons(I1:Int,
+                   vCons(I2:Int,
+                   vCons(I3:Int,
+                   vCons(str(S:IntSeq),
+                   vCons(dictV(.ValSeq, .ValSeq),
+                   vCons(list(.ValSeq), .ValSeq))))))))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0  |-> scope("filter_integers" |-> FILTER-CLOSURE, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      0 |-> list(vCons(I1, vCons(I2, vCons(I3, .ValSeq))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // Order preservation with interleaved symbolic integers and other supported
+  // scalar values.  Bool is intentionally non-Int in the supplied semantics.
+  claim [order-and-scalars]:
+    <k> #loadAll(FILTER-PROGRAM)
+         ~> Call(
+              Name("filter_integers"),
+              list(vCons(B:Bool,
+                   vCons(A:Int,
+                   vCons(noneV,
+                   vCons(str(S:IntSeq),
+                   vCons(C:Int, .ValSeq)))))))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0  |-> scope("filter_integers" |-> FILTER-CLOSURE, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      0 |-> list(vCons(A, vCons(C, .ValSeq)))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f54f270dbf6bdf2b810dbe257f5315a0c5717985
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,61 @@
+requires "reference-semantics/semantics.k"
+
+module FILTER-VERIFICATION
+  imports MPY
+
+  // Mathematical result: retain precisely the Int-sorted values, in order.
+  syntax ValSeq ::= filterInts(ValSeq) [function, total]
+                  | filterAcc(ValSeq, ValSeq) [function, total]
+  rule filterInts(VS:ValSeq) => filterAcc(.ValSeq, VS)
+  rule filterAcc(ACC:ValSeq, .ValSeq) => ACC
+  rule filterAcc(ACC:ValSeq, vCons(I:Int, REST:ValSeq))
+    => filterAcc(valSeqConcat(ACC, vCons(I, .ValSeq)), REST)
+  rule filterAcc(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
+    => filterAcc(ACC, REST)
+    [owise]
+
+  // Proof-facing case split equivalent to the reference semantics' supported
+  // isinstance(V, int) call.  It keeps the total predicate in the path
+  // condition instead of leaving #branch(isIntV(V), ...) stuck.
+  syntax KItem ::= #filterTypeBranch(Stmts, Stmts)
+  rule <k> If(
+             Call(Name("isinstance"),
+                  (E:Expr, Name("int"), .Exprs)),
+             T:Stmts, F:Stmts)
+        => E ~> #filterTypeBranch(T, F) ... </k>
+    [priority(40)]
+  rule <k> I:Int ~> #filterTypeBranch(T:Stmts, _:Stmts) => T ... </k>
+  rule <k> _:Val ~> #filterTypeBranch(_:Stmts, F:Stmts) => F ... </k>
+    [owise]
+
+  // The loop binds its target on every iteration.
+  syntax Val ::= lastValue(Val, ValSeq) [function, total]
+  rule lastValue(OLD:Val, .ValSeq) => OLD
+  rule lastValue(_:Val, vCons(V:Val, REST:ValSeq))
+    => lastValue(V, REST)
+
+  syntax Stmt ::= "FILTER-LOOP-BODY" [macro]
+  rule FILTER-LOOP-BODY
+    => If(
+         Call(Name("isinstance"), Name("value"), Name("int")),
+         Expr(Call(Attribute(Name("result"), "append"), Name("value"))),
+         .Stmts)
+
+  syntax Stmts ::= "FILTER-FUNCTION-BODY" [macro]
+  rule FILTER-FUNCTION-BODY
+    => Expr(Str("Filter values, retaining only integers in their original order."))
+       Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("value"), NoneVal)
+       For(Name("value"), Name("values"), FILTER-LOOP-BODY)
+       Return(Name("result"))
+
+  syntax Val ::= "FILTER-CLOSURE" [macro]
+  rule FILTER-CLOSURE
+    => closureVal(("values", .ParamNames), FILTER-FUNCTION-BODY, 0)
+
+  syntax Module ::= "FILTER-PROGRAM" [macro]
+  rule FILTER-PROGRAM
+    => Module(
+         ImportFrom("typing", "List", "Any")
+         FuncDef("filter_integers", Params("values"), FILTER-FUNCTION-BODY))
+endmodule

apply patch
patch: completed
/work/verification.k
