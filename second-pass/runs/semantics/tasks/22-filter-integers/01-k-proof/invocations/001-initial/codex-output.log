diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..a5753e3f4f193fded41f30a5f81f0362c44c2db5
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+from typing import List, Any
+
+
+def filter_integers(values: List[Any]) -> List[int]:
+    """Filter values, retaining only integers in their original order."""
+    result = []
+    value = None
+    for value in values:
+        if isinstance(value, int):
+            result.append(value)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..01da2a0aea10508c496a4e617707e6dd65d2a267
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,71 @@
+requires "verification.k"
+
+module FILTER-SPEC
+  imports FILTER-VERIFICATION
+
+  // Inductive loop invariant.  ACC is the already-retained prefix and REST is
+  // the unprocessed suffix.  K is an arbitrary continuation.
+  claim [filter-loop]:
+    <k> #loop(list(REST:ValSeq), Name("value"), FILTER-LOOP-BODY)
+         ~> K:K
+      => K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope("filter_integers" |-> FILTER-CLOSURE, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+              "values" |-> list(ALL:ValSeq)
+              "result" |-> ref(H)
+              "value"  |-> OLD:Val,
+              parent(0))
+    =>
+      0  |-> scope("filter_integers" |-> FILTER-CLOSURE, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+              "values" |-> list(ALL)
+              "result" |-> ref(H)
+              "value"  |-> lastValue(OLD, REST),
+              parent(0))
+    </scopes>
+    <heap>
+      H:Int |-> list(ACC:ValSeq)
+      HP:Map
+    =>
+      H |-> list(filterAcc(ACC, REST))
+      HP
+    </heap>
+    <heapLoc> N:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> RS:RetState </ret>
+    <exc> EX:Exc </exc>
+    requires notBool H in_keys(HP)
+
+  // End-to-end theorem for every list value accepted by the reference
+  // semantics.  It loads the translated implementation, calls its entry point,
+  // and characterizes the returned heap object.
+  claim [filter-integers-correct]:
+    <k> #loadAll(FILTER-PROGRAM)
+         ~> Call(Name("filter_integers"), list(INPUT:ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0  |-> scope("filter_integers" |-> FILTER-CLOSURE, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      0 |-> list(filterInts(INPUT))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
