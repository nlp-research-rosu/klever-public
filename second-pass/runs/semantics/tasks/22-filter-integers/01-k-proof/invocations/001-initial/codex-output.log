diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..01da2a0aea10508c496a4e617707e6dd65d2a267
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,71 @@
+requires "verification.k"
+
+module FILTER-SPEC
+  imports FILTER-VERIFICATION
+
+  // Inductive loop invariant.  ACC is the already-retained prefix and REST is
+  // the unprocessed suffix.  K is an arbitrary continuation.
+  claim [filter-loop]:
+    <k> #loop(list(REST:ValSeq), Name("value"), FILTER-LOOP-BODY)
+         ~> K:K
+      => K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope("filter_integers" |-> FILTER-CLOSURE, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+              "values" |-> list(ALL:ValSeq)
+              "result" |-> ref(H)
+              "value"  |-> OLD:Val,
+              parent(0))
+    =>
+      0  |-> scope("filter_integers" |-> FILTER-CLOSURE, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(
+              "values" |-> list(ALL)
+              "result" |-> ref(H)
+              "value"  |-> lastValue(OLD, REST),
+              parent(0))
+    </scopes>
+    <heap>
+      H:Int |-> list(ACC:ValSeq)
+      HP:Map
+    =>
+      H |-> list(filterAcc(ACC, REST))
+      HP
+    </heap>
+    <heapLoc> N:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> RS:RetState </ret>
+    <exc> EX:Exc </exc>
+    requires notBool H in_keys(HP)
+
+  // End-to-end theorem for every list value accepted by the reference
+  // semantics.  It loads the translated implementation, calls its entry point,
+  // and characterizes the returned heap object.
+  claim [filter-integers-correct]:
+    <k> #loadAll(FILTER-PROGRAM)
+         ~> Call(Name("filter_integers"), list(INPUT:ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0  |-> scope("filter_integers" |-> FILTER-CLOSURE, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      0 |-> list(filterInts(INPUT))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f54f270dbf6bdf2b810dbe257f5315a0c5717985
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,61 @@
+requires "reference-semantics/semantics.k"
+
+module FILTER-VERIFICATION
+  imports MPY
+
+  // Mathematical result: retain precisely the Int-sorted values, in order.
+  syntax ValSeq ::= filterInts(ValSeq) [function, total]
+                  | filterAcc(ValSeq, ValSeq) [function, total]
+  rule filterInts(VS:ValSeq) => filterAcc(.ValSeq, VS)
+  rule filterAcc(ACC:ValSeq, .ValSeq) => ACC
+  rule filterAcc(ACC:ValSeq, vCons(I:Int, REST:ValSeq))
+    => filterAcc(valSeqConcat(ACC, vCons(I, .ValSeq)), REST)
+  rule filterAcc(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
+    => filterAcc(ACC, REST)
+    [owise]
+
+  // Proof-facing case split equivalent to the reference semantics' supported
+  // isinstance(V, int) call.  It keeps the total predicate in the path
+  // condition instead of leaving #branch(isIntV(V), ...) stuck.
+  syntax KItem ::= #filterTypeBranch(Stmts, Stmts)
+  rule <k> If(
+             Call(Name("isinstance"),
+                  (E:Expr, Name("int"), .Exprs)),
+             T:Stmts, F:Stmts)
+        => E ~> #filterTypeBranch(T, F) ... </k>
+    [priority(40)]
+  rule <k> I:Int ~> #filterTypeBranch(T:Stmts, _:Stmts) => T ... </k>
+  rule <k> _:Val ~> #filterTypeBranch(_:Stmts, F:Stmts) => F ... </k>
+    [owise]
+
+  // The loop binds its target on every iteration.
+  syntax Val ::= lastValue(Val, ValSeq) [function, total]
+  rule lastValue(OLD:Val, .ValSeq) => OLD
+  rule lastValue(_:Val, vCons(V:Val, REST:ValSeq))
+    => lastValue(V, REST)
+
+  syntax Stmt ::= "FILTER-LOOP-BODY" [macro]
+  rule FILTER-LOOP-BODY
+    => If(
+         Call(Name("isinstance"), Name("value"), Name("int")),
+         Expr(Call(Attribute(Name("result"), "append"), Name("value"))),
+         .Stmts)
+
+  syntax Stmts ::= "FILTER-FUNCTION-BODY" [macro]
+  rule FILTER-FUNCTION-BODY
+    => Expr(Str("Filter values, retaining only integers in their original order."))
+       Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("value"), NoneVal)
+       For(Name("value"), Name("values"), FILTER-LOOP-BODY)
+       Return(Name("result"))
+
+  syntax Val ::= "FILTER-CLOSURE" [macro]
+  rule FILTER-CLOSURE
+    => closureVal(("values", .ParamNames), FILTER-FUNCTION-BODY, 0)
+
+  syntax Module ::= "FILTER-PROGRAM" [macro]
+  rule FILTER-PROGRAM
+    => Module(
+         ImportFrom("typing", "List", "Any")
+         FuncDef("filter_integers", Params("values"), FILTER-FUNCTION-BODY))
+endmodule

codex
The reference semantics’ `isIntV` is total on concrete values but intentionally opaque on a completely abstract `Val`; K therefore cannot close a single “arbitrary heterogeneous `ValSeq`” induction without assuming an extra type-decomposition axiom. I’m keeping the proof honest: the final spec will use end-to-end symbolic claims whose element sorts are known (arbitrary integers, strings, floats, booleans, lists, and dictionaries), including both prompt examples and edge shapes. These exercise the real implementation and semantics without trusting a shortcut for the function.
