diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..928733d0001af1d98107e8a599dace52c3023e37
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+from typing import List, Any
+
+
+def filter_integers(values: List[Any]) -> List[int]:
+    """Filter values, retaining only integers in their original order."""
+    result = []
+    for value in values:
+        if isinstance(value, int):
+            result.append(value)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..57d0f6ce1126e16b32f908bed91de1c7dc01cedc
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,69 @@
+requires "verification.k"
+
+module FILTER-SPEC
+  imports FILTER-VERIFICATION
+
+  // Inductive loop invariant.  ACC is the already-retained prefix and REST is
+  // the unprocessed suffix.  K is an arbitrary continuation.
+  claim [filter-loop]:
+    <k> #loop(list(REST:ValSeq), Name("value"), FILTER-LOOP-BODY)
+         ~> K:K
+      => K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0  |-> scope(MOD:Map, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(M:Map, parent(0))
+    =>
+      0  |-> scope(MOD, parent(-1))
+      -1 |-> builtinsScope
+      1  |-> scope(bindLast(M, "value", REST), parent(0))
+    </scopes>
+    <heap>
+      H:Int |-> list(ACC:ValSeq)
+      HP:Map
+    =>
+      H |-> list(valSeqConcat(ACC, filterInts(REST)))
+      HP
+    </heap>
+    <heapLoc> N:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> RS:RetState </ret>
+    <exc> EX:Exc </exc>
+    requires "result" in_keys(M)
+     andBool {M["result"]}:>Val ==K ref(H)
+     andBool notBool ("isinstance" in_keys(M))
+     andBool notBool ("int" in_keys(M))
+     andBool notBool ("isinstance" in_keys(MOD))
+     andBool notBool ("int" in_keys(MOD))
+     andBool notBool H in_keys(HP)
+
+  // End-to-end theorem for every list value accepted by the reference
+  // semantics.  It loads the translated implementation, calls its entry point,
+  // and characterizes the returned heap object.
+  claim [filter-integers-correct]:
+    <k> #loadAll(FILTER-PROGRAM)
+         ~> Call(Name("filter_integers"), list(INPUT:ValSeq))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    =>
+      0  |-> scope("filter_integers" |-> FILTER-CLOSURE, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+    =>
+      0 |-> list(filterInts(INPUT))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..6892880ab6dab8e8bbe3df4cd32ed807f8e645b0
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,45 @@
+requires "reference-semantics/semantics.k"
+
+module FILTER-VERIFICATION
+  imports MPY
+
+  // Mathematical result: retain precisely the Int-sorted values, in order.
+  syntax ValSeq ::= filterInts(ValSeq) [function, total]
+  rule filterInts(.ValSeq) => .ValSeq
+  rule filterInts(vCons(I:Int, REST:ValSeq))
+    => vCons(I, filterInts(REST))
+  rule filterInts(vCons(V:Val, REST:ValSeq))
+    => filterInts(REST)
+    requires notBool isIntV(V)
+
+  // The loop binds its target on every iteration.  This helper describes the
+  // resulting local map while keeping the loop invariant executable.
+  syntax Map ::= bindLast(Map, String, ValSeq) [function, total]
+  rule bindLast(M:Map, _:String, .ValSeq) => M
+  rule bindLast(M:Map, X:String, vCons(V:Val, REST:ValSeq))
+    => bindLast(M [ X <- V ], X, REST)
+
+  syntax Stmt ::= "FILTER-LOOP-BODY" [macro]
+  rule FILTER-LOOP-BODY
+    => If(
+         Call(Name("isinstance"), Name("value"), Name("int")),
+         Expr(Call(Attribute(Name("result"), "append"), Name("value"))),
+         .Stmts)
+
+  syntax Stmts ::= "FILTER-FUNCTION-BODY" [macro]
+  rule FILTER-FUNCTION-BODY
+    => Expr(Str("Filter values, retaining only integers in their original order."))
+       Assign(Name("result"), ListExpr(.Exprs))
+       For(Name("value"), Name("values"), FILTER-LOOP-BODY)
+       Return(Name("result"))
+
+  syntax Val ::= "FILTER-CLOSURE" [macro]
+  rule FILTER-CLOSURE
+    => closureVal(("values", .ParamNames), FILTER-FUNCTION-BODY, 0)
+
+  syntax Module ::= "FILTER-PROGRAM" [macro]
+  rule FILTER-PROGRAM
+    => Module(
+         ImportFrom("typing", "List", "Any")
+         FuncDef("filter_integers", Params("values"), FILTER-FUNCTION-BODY))
+endmodule

