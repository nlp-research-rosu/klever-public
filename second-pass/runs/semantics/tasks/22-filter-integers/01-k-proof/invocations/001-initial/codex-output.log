--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+from typing import List, Any
+
+
+def filter_integers(values: List[Any]) -> List[int]:
+    """Filter values, retaining only integers in their original order."""
+    result = []
+    value = None
+    for value in values:
+        if isinstance(value, int):
+            result.append(value)
+    return result
