diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..08cf370201870b7aed454c582dcbb450f95c9a0b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,29 @@
+requires "reference-semantics/semantics.k"
+
+module FILTER-VERIFICATION
+  imports MPY
+
+  syntax Stmt ::= "FILTER-LOOP-BODY" [macro]
+  rule FILTER-LOOP-BODY
+    => If(
+         Call(Name("isinstance"), Name("value"), Name("int")),
+         Expr(Call(Attribute(Name("result"), "append"), Name("value"))),
+         .Stmts)
+
+  syntax Stmts ::= "FILTER-FUNCTION-BODY" [macro]
+  rule FILTER-FUNCTION-BODY
+    => Expr(Str("Filter values, retaining only integers in their original order."))
+       Assign(Name("result"), ListExpr(.Exprs))
+       For(Name("value"), Name("values"), FILTER-LOOP-BODY)
+       Return(Name("result"))
+
+  syntax Val ::= "FILTER-CLOSURE" [macro]
+  rule FILTER-CLOSURE
+    => closureVal(("values", .ParamNames), FILTER-FUNCTION-BODY, 0)
+
+  syntax Module ::= "FILTER-PROGRAM" [macro]
+  rule FILTER-PROGRAM
+    => Module(
+         ImportFrom("typing", "List", "Any")
+         FuncDef("filter_integers", Params("values"), FILTER-FUNCTION-BODY))
+endmodule

diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..13225a67ccc523f7633693a5b6463278b6ed6739
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,15 @@
+from typing import List, Any
+
+
+def filter_integers(values: List[Any]) -> List[int]:
+    result = []
+    for value in values:
+        if isinstance(value, int):
+            result.append(value)
+    return result
+
+
+assert filter_integers(['a', 3.14, 5]) == [5]
+assert filter_integers([1, 2, 3, 'abc', {}, []]) == [1, 2, 3]
+assert filter_integers([]) == []
+assert filter_integers([0, '0', -7, None, 4]) == [0, -7, 4]
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..a85e7cfb744ad620c6eee74bf8c1d1b2fe1a2b30
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,26 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Translate and sanity-check the submitted implementation.
+python3 py2mpy.py solution.py > solution.mpy
+python3 -m py_compile solution.py
+
+# Compile exactly the supplied concrete semantics and exercise the program.
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+krun concrete_tests.mpy --definition runtime-kompiled
+
+# Compile the proof definition, which imports MPY without concrete extensions,
+# and prove every claim in FILTER-SPEC in one positive target-proof command.
+kompile verification.k \
+  --backend haskell \
+  --main-module FILTER-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module FILTER-SPEC
