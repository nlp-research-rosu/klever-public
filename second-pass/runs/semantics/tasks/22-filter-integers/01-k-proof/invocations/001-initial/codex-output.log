diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..f54f270dbf6bdf2b810dbe257f5315a0c5717985
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,61 @@
+requires "reference-semantics/semantics.k"
+
+module FILTER-VERIFICATION
+  imports MPY
+
+  // Mathematical result: retain precisely the Int-sorted values, in order.
+  syntax ValSeq ::= filterInts(ValSeq) [function, total]
+                  | filterAcc(ValSeq, ValSeq) [function, total]
+  rule filterInts(VS:ValSeq) => filterAcc(.ValSeq, VS)
+  rule filterAcc(ACC:ValSeq, .ValSeq) => ACC
+  rule filterAcc(ACC:ValSeq, vCons(I:Int, REST:ValSeq))
+    => filterAcc(valSeqConcat(ACC, vCons(I, .ValSeq)), REST)
+  rule filterAcc(ACC:ValSeq, vCons(V:Val, REST:ValSeq))
+    => filterAcc(ACC, REST)
+    [owise]
+
+  // Proof-facing case split equivalent to the reference semantics' supported
+  // isinstance(V, int) call.  It keeps the total predicate in the path
+  // condition instead of leaving #branch(isIntV(V), ...) stuck.
+  syntax KItem ::= #filterTypeBranch(Stmts, Stmts)
+  rule <k> If(
+             Call(Name("isinstance"),
+                  (E:Expr, Name("int"), .Exprs)),
+             T:Stmts, F:Stmts)
+        => E ~> #filterTypeBranch(T, F) ... </k>
+    [priority(40)]
+  rule <k> I:Int ~> #filterTypeBranch(T:Stmts, _:Stmts) => T ... </k>
+  rule <k> _:Val ~> #filterTypeBranch(_:Stmts, F:Stmts) => F ... </k>
+    [owise]
+
+  // The loop binds its target on every iteration.
+  syntax Val ::= lastValue(Val, ValSeq) [function, total]
+  rule lastValue(OLD:Val, .ValSeq) => OLD
+  rule lastValue(_:Val, vCons(V:Val, REST:ValSeq))
+    => lastValue(V, REST)
+
+  syntax Stmt ::= "FILTER-LOOP-BODY" [macro]
+  rule FILTER-LOOP-BODY
+    => If(
+         Call(Name("isinstance"), Name("value"), Name("int")),
+         Expr(Call(Attribute(Name("result"), "append"), Name("value"))),
+         .Stmts)
+
+  syntax Stmts ::= "FILTER-FUNCTION-BODY" [macro]
+  rule FILTER-FUNCTION-BODY
+    => Expr(Str("Filter values, retaining only integers in their original order."))
+       Assign(Name("result"), ListExpr(.Exprs))
+       Assign(Name("value"), NoneVal)
+       For(Name("value"), Name("values"), FILTER-LOOP-BODY)
+       Return(Name("result"))
+
+  syntax Val ::= "FILTER-CLOSURE" [macro]
+  rule FILTER-CLOSURE
+    => closureVal(("values", .ParamNames), FILTER-FUNCTION-BODY, 0)
+
+  syntax Module ::= "FILTER-PROGRAM" [macro]
+  rule FILTER-PROGRAM
+    => Module(
+         ImportFrom("typing", "List", "Any")
+         FuncDef("filter_integers", Params("values"), FILTER-FUNCTION-BODY))
+endmodule

exec
/bin/bash -lc 'kprove spec.k --definition verification-kompiled --spec-module FILTER-SPEC' in /work
