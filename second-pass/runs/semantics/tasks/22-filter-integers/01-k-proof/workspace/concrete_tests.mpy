Module(
  ImportFrom("typing", "List", "Any")
  FuncDef("filter_integers", Params("values"),
    Assign(Name("result"), ListExpr())
    For(Name("value"), Name("values"),
      If(Call(Name("isinstance"), Name("value"), Name("int")),
        Expr(Call(Attribute(Name("result"), "append"), Name("value"))),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("filter_integers"),
        ListExpr(Str("a"), Float(3.14), Int(5))),
      CmpOp("==", ListExpr(Int(5)))))
  Assert(
    Compare(
      Call(
        Name("filter_integers"),
        ListExpr(
          Int(1),
          Int(2),
          Int(3),
          Str("abc"),
          DictExpr(),
          ListExpr())),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(3)))))
  Assert(
    Compare(
      Call(Name("filter_integers"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("filter_integers"),
        ListExpr(
          Int(0),
          Str("0"),
          UnaryOp("-", Int(7)),
          NoneVal,
          Int(4))),
      CmpOp("==", ListExpr(Int(0), UnaryOp("-", Int(7)), Int(4))))))
