+
+print("file\tline\tkind\tattributes\ttext")
+for relative, line, text in records:
+    attributes = ";".join(attr_re.findall(text)).replace("\t", " ")
+    print(
+        f"{relative}\t{line}\t{classify(text)}\t{attributes}\t"
