FILE /candidate/solution.py
     1	from typing import List, Any
     2	
     3	
     4	def filter_integers(values: List[Any]) -> List[int]:
     5	    """Filter values, retaining only integers in their original order."""
     6	    result = []
     7	    for value in values:
     8	        if isinstance(value, int):
     9	            result.append(value)
    10	    return result
