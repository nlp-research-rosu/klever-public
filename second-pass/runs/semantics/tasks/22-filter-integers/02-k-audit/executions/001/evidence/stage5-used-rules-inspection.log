reference-semantics/semantics/core.k-206-
reference-semantics/semantics/core.k-207-  // ==== extensible operator dispatch (cases added by the construct modules) ==
reference-semantics/semantics/core.k-208-  syntax Val  ::= applyUn(String, Val) [function]
reference-semantics/semantics/core.k-209-  syntax Val  ::= applyBin(String, Val, Val) [function]
