reference-semantics/semantics/comprehension.k-10-  // A comprehension is pure syntactic sugar
reference-semantics/semantics/comprehension.k:11:  rule ListComp(ELT:Expr, Gs:CompFors) => Call(closureExpr(.ParamNames, compBody(Gs, ELT)), .Exprs)
reference-semantics/semantics/comprehension.k:12:  rule GenExp(ELT:Expr, Gs:CompFors)   => Call(closureExpr(.ParamNames, compBody(Gs, ELT)), .Exprs)
reference-semantics/semantics/comprehension.k-13-
reference-semantics/semantics/comprehension.k-14-  syntax Stmts ::= compBody(CompFors, Expr) [macro]
reference-semantics/semantics/comprehension.k-15-  rule compBody(Gs:CompFors, ELT:Expr)
reference-semantics/semantics/comprehension.k:16:    => Assign(Name("$acc"), ListExpr(.Exprs)) compNest(Gs, ELT) Return(Name("$acc"))
reference-semantics/semantics/comprehension.k-17-
reference-semantics/semantics/comprehension.k-18-  syntax Stmt ::= compNest(CompFors, Expr) [macro-rec]
reference-semantics/semantics/comprehension.k-19-  rule compNest(.CompFors, ELT:Expr)
reference-semantics/semantics/comprehension.k:20:    => Assign(Name("$acc"), BinOp("+", Name("$acc"), ListExpr(ELT)))
reference-semantics/semantics/comprehension.k:21:  rule compNest((CompFor(T:Expr, ITER:Expr, Fs:Exprs) GRest:CompFors), ELT:Expr)
reference-semantics/semantics/comprehension.k:22:    => For(T, ITER, If(compGuard(Fs), compNest(GRest, ELT), .Stmts))
reference-semantics/semantics/comprehension.k-23-
reference-semantics/semantics/comprehension.k-24-  syntax Expr ::= compGuard(Exprs) [macro]
reference-semantics/semantics/comprehension.k-25-  rule compGuard(.Exprs)             => Bool(true)
reference-semantics/semantics/comprehension.k-26-  rule compGuard((F:Expr, Fs:Exprs)) => BoolOp("and", (F, Fs))
reference-semantics/semantics/comprehension.k-27-endmodule

