verification.k-1-requires "reference-semantics/semantics.k"
verification.k-2-
verification.k-3-module FILTER-VERIFICATION
verification.k-4-  imports MPY
verification.k-5-
verification.k-6-  syntax Stmt ::= "FILTER-LOOP-BODY" [macro]
verification.k-7-  rule FILTER-LOOP-BODY
verification.k:8:    => If(
verification.k:9:         Call(Name("isinstance"), Name("value"), Name("int")),
verification.k:10:         Expr(Call(Attribute(Name("result"), "append"), Name("value"))),
verification.k-11-         .Stmts)
verification.k-12-
verification.k-13-  syntax Stmts ::= "FILTER-FUNCTION-BODY" [macro]
verification.k-14-  rule FILTER-FUNCTION-BODY
verification.k-15-    => Expr(Str("Filter values, retaining only integers in their original order."))
verification.k:16:       Assign(Name("result"), ListExpr(.Exprs))
verification.k:17:       For(Name("value"), Name("values"), FILTER-LOOP-BODY)
verification.k:18:       Return(Name("result"))
verification.k-19-
verification.k-20-  syntax Val ::= "FILTER-CLOSURE" [macro]
verification.k-21-  rule FILTER-CLOSURE
verification.k:22:    => closureVal(("values", .ParamNames), FILTER-FUNCTION-BODY, 0)
verification.k-23-
verification.k-24-  syntax Module ::= "FILTER-PROGRAM" [macro]
verification.k-25-  rule FILTER-PROGRAM
verification.k-26-    => Module(
verification.k:27:         ImportFrom("typing", "List", "Any")
verification.k-28-         FuncDef("filter_integers", Params("values"), FILTER-FUNCTION-BODY))
verification.k-29-endmodule
