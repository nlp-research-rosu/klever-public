reference-semantics/semantics/core.k-183-  // ==== argument/element evaluation: ONE left-to-right loop, tagged by destination ==
reference-semantics/semantics/core.k-184-  // (list/tuple literals and calls all use it; modules extend ApplyK with their tags)
reference-semantics/semantics/core.k:185:  syntax ApplyK ::= toCall(Val)
reference-semantics/semantics/core.k-186-  syntax KItem  ::= #evalArgs(Exprs, Vals, ApplyK)
reference-semantics/semantics/core.k-187-                  | #evalArgCont(Exprs, Vals, ApplyK)
reference-semantics/semantics/core.k-188-                  | #applyK(ApplyK, Vals)
reference-semantics/semantics/core.k-189-  rule <k> #evalArgs((A:Expr, REST:Exprs), ACC:Vals, K:ApplyK) => A ~> #evalArgCont(REST, ACC, K) ... </k>
reference-semantics/semantics/core.k:190:  rule <k> V:Val ~> #evalArgCont(REST:Exprs, ACC:Vals, K:ApplyK) => #evalArgs(REST, appendVal(ACC, V), K) ... </k>
reference-semantics/semantics/core.k-191-  rule <k> #evalArgs(.Exprs, ACC:Vals, K:ApplyK) => #applyK(K, ACC) ... </k>
reference-semantics/semantics/core.k-192-
reference-semantics/semantics/core.k-193-  // ==== Int / Bool / None literals ==========================================
reference-semantics/semantics/core.k-194-  rule <k> Int(I:Int)   => I ... </k>
reference-semantics/semantics/core.k-195-  rule <k> Bool(B:Bool) => B ... </k>
reference-semantics/semantics/core.k-196-  rule <k> NoneVal      => noneV ... </k>
