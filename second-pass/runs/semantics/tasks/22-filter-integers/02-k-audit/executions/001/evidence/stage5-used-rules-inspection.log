reference-semantics/semantics/concrete.k-20-  // ==== keyed sort, concrete leg ============================================
reference-semantics/semantics/concrete.k-21-  // Computes each key by a REAL call through the uniform #callee machinery
reference-semantics/semantics/concrete.k-22-  // (closures, len, type objects all work), stable-inserts on the key, and
reference-semantics/semantics/concrete.k-23-  // allocates the result. priority(40) beats sort.k's opaque rules, so krun
reference-semantics/semantics/concrete.k-24-  // runs this and proofs (which never see MPY-CONCRETE) keep sortKeyVS.
reference-semantics/semantics/concrete.k-25-  syntax Val ::= kvP(Val, Val)
reference-semantics/semantics/concrete.k-26-  syntax KItem ::= #ksort(ValSeq, Val, ValSeq, Bool)
reference-semantics/semantics/concrete.k-27-                 | #ksIns(Val, ValSeq, Val, ValSeq, Bool)
reference-semantics/semantics/concrete.k:28:  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), .Vals))
reference-semantics/semantics/concrete.k-29-        => #ksort(VS, KV, .ValSeq, false) ... </k>
reference-semantics/semantics/concrete.k-30-       [priority(40)]
reference-semantics/semantics/concrete.k:31:  rule <k> #applyK(toCall(builtinV("sorted")), (list(VS:ValSeq), kwV("key", KV:Val), kwV("reverse", RB:Bool), .Vals))
reference-semantics/semantics/concrete.k-32-        => #ksort(VS, KV, .ValSeq, RB) ... </k>
reference-semantics/semantics/concrete.k-33-       [priority(40)]
reference-semantics/semantics/concrete.k-34-  rule <k> #ksort(.ValSeq, _:Val, ACC:ValSeq, RB:Bool)
reference-semantics/semantics/concrete.k-35-        => #alloc(list(condRev(unpairVS(ACC), RB))) ... </k>
reference-semantics/semantics/concrete.k-36-  rule <k> #ksort(vCons(V:Val, R:ValSeq), KV:Val, ACC:ValSeq, RB:Bool)
reference-semantics/semantics/concrete.k-37-        => KV ~> #callee((V, .Exprs)) ~> #ksIns(V, R, KV, ACC, RB) ... </k>
reference-semantics/semantics/concrete.k-38-  rule <k> K:Val ~> #ksIns(V:Val, R:ValSeq, KV:Val, ACC:ValSeq, RB:Bool)
reference-semantics/semantics/concrete.k-39-        => #ksort(R, KV, insPair(ACC, K, V), RB) ... </k>
