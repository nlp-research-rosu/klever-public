    57	
    58	module MPY
    59	  imports MPY-CORE
    60	  imports MPY-ITER
    61	  imports MPY-RANGE
    62	  imports MPY-OPERATORS
    63	  imports MPY-INT
    64	  imports MPY-BOOL
    65	  imports MPY-FLOAT
    66	  imports MPY-STR
    67	  imports MPY-SET
    68	  imports MPY-LIST
    69	  imports MPY-TUPLE
    70	  imports MPY-SUBSCRIPT
    71	  imports MPY-COMPREHENSION
    72	  imports MPY-METHODS
    73	  imports MPY-CONTROLS
    74	  imports MPY-FUNCTIONS
    75	  imports MPY-BUILTINS
    76	  imports MPY-CALL
    77	  imports MPY-SORT
    78	  imports MPY-ASSERT
    79	  imports MPY-DICT
    80	endmodule
    81	
    82	// The krun (llvm) main module: MPY plus the concrete-only legs (keyed sort's
    83	// real key calls, deep list equality). Verification builds import MPY and
    84	// never see MPY-CONCRETE. The llvm kompile MUST use --main-module MPY-KRUN —
    85	// with plain MPY the concrete legs are silently absent (this was live for a
    86	// while: sorted-key stuck and comprehension asserted wrong under krun).
    87	module MPY-KRUN
    88	  imports MPY
    89	  imports MPY-CONCRETE
    90	endmodule

