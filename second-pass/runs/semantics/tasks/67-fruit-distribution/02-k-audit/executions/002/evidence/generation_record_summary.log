call line=125 name=apply_patch payload=*** Begin Patch\n*** Add File: /work/prove.sh\n+#!/usr/bin/env bash\n+set -euo pipefail\n+\n+# Recreate the required constructor term and check that the concrete harness\n+# contains the exact same implementation before its assertions.\n+python3 -m py_compile solution.py\n+python3 py2mpy.py solution.py > solution.mpy\n+diff -u solution.py <(sed -n '1,3p' concrete-tests.py)\n+python3 py2mpy.py concrete-tests.py > concrete-tests.mpy\n+\n+# Concrete execution uses the required LLVM main and syntax modules.\n+kompile reference-semantics/semantics.k \\n+  --backend llvm \\n+  --main-module MPY-KRUN \\n+  --syntax-module MPY-SYNTAX \\n+  --output-definition runtime-kompiled\n+krun concrete-tests.mpy \\n+  --definition runtime-kompiled \\n+  --output pretty | tee concrete-run.out\n+rg -U -q '<exc>[[:space:]]+NoExc[[:space:]]+</exc>' concrete-run.out\n+rg -U -q '<exit-code>[[:space:]]+0[[:space:]]+</exit-code>' concrete-run.out\n+\n+# Symbolic verification imports MPY (not MPY-KRUN/MPY-CONCRETE).\n+kompile verification.k \\n+  --backend haskell \\n+  --main-module VERIFICATION \\n+  --syntax-module MPY-SYNTAX \\n+  --output-definition verification-kompiled\n+kprove spec.k \\n+  --definition verification-kompiled \\n+  --spec-module SPEC | tee kprove.out\n+test "$(tr -d '\r\n' < kprove.out)" = '#Top'\n*** End Patch\n
