call line=110 name=apply_patch payload=*** Begin Patch\n*** Update File: /work/spec.k\n@@\n   claim\n@@\n     requires A >=Int 0\n      andBool B >=Int 0\n      andBool A +Int B <=Int N\n+\n+  // The prompt's examples are also proof claims.  Unlike the general claim,\n+  // these use ordinary Str literals and therefore execute the reference\n+  // semantics' concrete splitWS and intDigAcc definitions.\n+  claim\n+    <k>\n+      #loadAll(solutionModule)\n+      ~> Call(\n+           Name("fruit_distribution"),\n+           Str("5 apples and 6 oranges"), Int(19), .Exprs)\n+      => 8\n+    </k>\n+    <env> 0 </env>\n+    <scopes>\n+      (0 |-> scope(.Map, parent(-1))\n+       -1 |-> builtinsScope)\n+      => ?FINAL_SCOPES:Map\n+    </scopes>\n+    <scopeLoc> 1 </scopeLoc>\n+    <heap> .Map => ?FINAL_HEAP:Map </heap>\n+    <heapLoc> 0 => 1 </heapLoc>\n+    <stack> .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+\n+  claim\n+    <k>\n+      #loadAll(solutionModule)\n+      ~> Call(\n+           Name("fruit_distribution"),\n+           Str("0 apples and 1 oranges"), Int(3), .Exprs)\n+      => 2\n+    </k>\n+    <env> 0 </env>\n+    <scopes>\n+      (0 |-> scope(.Map, parent(-1))\n+       -1 |-> builtinsScope)\n+      => ?FINAL_SCOPES:Map\n+    </scopes>\n+    <scopeLoc> 1 </scopeLoc>\n+    <heap> .Map => ?FINAL_HEAP:Map </heap>\n+    <heapLoc> 0 => 1 </heapLoc>\n+    <stack> .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+\n+  claim\n+    <k>\n+      #loadAll(solutionModule)\n+      ~> Call(\n+           Name("fruit_distribution"),\n+           Str("2 apples and 3 oranges"), Int(100), .Exprs)\n+      => 95\n+    </k>\n+    <env> 0 </env>\n+    <scopes>\n+      (0 |-> scope(.Map, parent(-1))\n+       -1 |-> builtinsScope)\n+      => ?FINAL_SCOPES:Map\n+    </scopes>\n+    <scopeLoc> 1 </scopeLoc>\n+    <heap> .Map => ?FINAL_HEAP:Map </heap>\n+    <heapLoc> 0 => 1 </heapLoc>\n+    <stack> .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+\n+  claim\n+    <k>\n+      #loadAll(solutionModule)\n+      ~> Call(\n+           Name("fruit_distribution"),\n+           Str("100 apples and 1 oranges"), Int(120), .Exprs)\n+      => 19\n+    </k>\n+    <env> 0 </env>\n+    <scopes>\n+      (0 |-> scope(.Map, parent(-1))\n+       -1 |-> builtinsScope)\n+      => ?FINAL_SCOPES:Map\n+    </scopes>\n+    <scopeLoc> 1 </scopeLoc>\n+    <heap> .Map => ?FINAL_HEAP:Map </heap>\n+    <heapLoc> 0 => 1 </heapLoc>\n+    <stack> .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n endmodule\n*** End Patch\n
