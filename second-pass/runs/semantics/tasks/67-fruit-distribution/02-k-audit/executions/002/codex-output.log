diff --git a//tmp/audit-work/reconstruction/opposite-int-spec.k b//tmp/audit-work/reconstruction/opposite-int-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..fc0fa7622f275a5da3baf4e603f27051c850eb3c
--- /dev/null
+++ b//tmp/audit-work/reconstruction/opposite-int-spec.k
@@ -0,0 +1,27 @@
+requires "audit-variants.k"
+
+module OPPOSITE-INT-SPEC
+  imports OPPOSITE-INT
+
+  claim
+    <k>
+      #loadAll(solutionModule)
