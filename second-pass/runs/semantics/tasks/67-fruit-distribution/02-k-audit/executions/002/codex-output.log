diff --git a//tmp/audit-work/reconstruction/bridge-free-spec.k b//tmp/audit-work/reconstruction/bridge-free-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..539ce9d5a12e05d2ca4dc38b6b7f06b3321fd054
--- /dev/null
+++ b//tmp/audit-work/reconstruction/bridge-free-spec.k
@@ -0,0 +1,27 @@
+requires "audit-variants.k"
+
+module BRIDGE-FREE-SPEC
+  imports BRIDGE-FREE
+
+  claim
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(
+           Name("fruit_distribution"),
+           str(fruitSentenceCodes(5, 6)), 19, .Exprs)
+      => 8
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
