apLoc>\n+    <stack> .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n+\n+  claim\n+    <k>\n+      #loadAll(solutionModule)\n+      ~> Call(\n+           Name("fruit_distribution"),\n+           Str("100 apples and 1 oranges"), Int(120), .Exprs)\n+      => 19\n+    </k>\n+    <env> 0 </env>\n+    <scopes>\n+      (0 |-> scope(.Map, parent(-1))\n+       -1 |-> builtinsScope)\n+      => ?FINAL_SCOPES:Map\n+    </scopes>\n+    <scopeLoc> 1 </scopeLoc>\n+    <heap> .Map => ?FINAL_HEAP:Map </heap>\n+    <heapLoc> 0 => 1 </heapLoc>\n+    <stack> .List </stack>\n+    <ret> noRet </ret>\n+    <exc> NoExc </exc>\n+    <exit-code> 0 </exit-code>\n endmodule\n*** End Patch\n
