COMMAND: /bin/bash -lc $'set -euo pipefail; cd /audit-output; test "$(tail -n 2 REVIEW.md | head -n 1)" = "VERDICT: CONCERNS"; test "$(tail -n 1 REVIEW.md)" = "LEGITIMACY: LEGIT"; /usr/bin/python3 - <<"PY"\nfrom pathlib import Path\nimport re\nreview_path = Path("REVIEW.md")\nreview = review_path.read_text()\nrefs = sorted(set(re.findall(r"\\]\\((evidence/[^)]+)\\)", review)))\nmissing = [ref for ref in refs if not Path(ref).is_file()]\nprint(f"evidence_links={len(refs)}")\nprint(f"missing_evidence_links={missing}")\nprint(f"review_bytes={review_path.stat().st_size}")\nif missing:\n    raise SystemExit(1)\nPY\nprintf "FINAL_LINES:\\n"; tail -n 2 REVIEW.md'
evidence_links=39
missing_evidence_links=[]
review_bytes=25330
FINAL_LINES:
VERDICT: CONCERNS
LEGITIMACY: LEGIT
EXIT_STATUS: 0
