diff --git a/evidence/verification-no-bridges.k b/evidence/verification-no-bridges.k
new file mode 100644
index 0000000000000000000000000000000000000000..9f31e23994f88037ac6f35caded4d648f135ce9b
--- /dev/null
+++ b/evidence/verification-no-bridges.k
@@ -0,0 +1,28 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-NOBRIDGES
+  imports MPY
+
+  syntax IntSeq ::= decimalCodes(Int)
+                  | fruitSentenceCodes(Int, Int)
+
+  syntax Module ::= "solutionModule" [function, total]
+  rule solutionModule =>
+    Module(
+      FuncDef("fruit_distribution", Params("s", "n"),
+        Assign(
+          Name("fruits"),
+          Call(Attribute(Name("s"), "split"), .Exprs))
+        Return(
+          BinOp(
+            "-",
+            BinOp(
+              "-",
+              Name("n"),
+              Call(
+                Name("int"),
+                Subscript(Name("fruits"), Int(0)), .Exprs)),
+            Call(
+              Name("int"),
+              Subscript(Name("fruits"), Int(3)), .Exprs)))))
+endmodule

