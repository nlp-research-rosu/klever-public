@@ -0,0 +1,18 @@
+#!/usr/bin/env python3
+"""Build a concrete test harness by appending tests to the scratch solution source."""
+
+from pathlib import Path
+
+
+solution = Path("/tmp/audit-work/reconstruction/solution.py").read_text()
+tests = """
+
+assert fruit_distribution("5 apples and 6 oranges", 19) == 8
+assert fruit_distribution("0 apples and 0 oranges", 0) == 0
+assert fruit_distribution("0 apples and 7 oranges", 7) == 0
+assert fruit_distribution("9 apples and 0 oranges", 9) == 0
+assert fruit_distribution("9 apples and 7 oranges", 16) == 0
+assert fruit_distribution("123 apples and 456 oranges", 1000) == 421
+"""
+
+print(solution.rstrip() + tests)
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..7dd21849d8612007bf096be51d78b16c1e8fd748
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: run_logged.sh LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+logfile=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+} > "$logfile"
+
+set +e
+"$@" 2>&1 | tee -a "$logfile"
+status=${PIPESTATUS[0]}
+set -e
+
+printf 'EXIT_STATUS: %d\n' "$status" | tee -a "$logfile"
+exit "$status"
diff --git a/evidence/spec-individual.k b/evidence/spec-individual.k
new file mode 100644
index 0000000000000000000000000000000000000000..2f9fce44ae0cae5e184950510ec71df9dd47d6b9
--- /dev/null
+++ b/evidence/spec-individual.k
@@ -0,0 +1,134 @@
+requires "verification.k"
+
+module SPECGENERAL
+  imports VERIFICATION
+
+  claim
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(
+           Name("fruit_distribution"),
+           str(fruitSentenceCodes(A, B)), N, .Exprs)
+      => N -Int A -Int B
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINAL_HEAP:Map </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A >=Int 0
+     andBool B >=Int 0
+     andBool A +Int B <=Int N
+endmodule
+
+module SPECEXAMPLE1
+  imports VERIFICATION
+
+  claim
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(
+           Name("fruit_distribution"),
+           Str("5 apples and 6 oranges"), Int(19), .Exprs)
+      => 8
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINAL_HEAP:Map </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module SPECEXAMPLE2
+  imports VERIFICATION
+
+  claim
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(
+           Name("fruit_distribution"),
+           Str("0 apples and 1 oranges"), Int(3), .Exprs)
+      => 2
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
