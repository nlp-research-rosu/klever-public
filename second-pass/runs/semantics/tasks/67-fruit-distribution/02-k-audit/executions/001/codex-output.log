+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Fresh reviewer mutation: the real implementation returns N-A-B, so the
+  // added +1 is false, e.g. A=5, B=6, N=19 expects 9 although both Python
+  // implementations and the concrete K execution return 8.
+  claim
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(
+           Name("fruit_distribution"),
+           str(fruitSentenceCodes(A, B)), N, .Exprs)
+      => N -Int A -Int B +Int 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINAL_HEAP:Map </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A >=Int 0
+     andBool B >=Int 0
+     andBool A +Int B <=Int N
+endmodule
diff --git a/evidence/verification-no-bridges.k b/evidence/verification-no-bridges.k
new file mode 100644
index 0000000000000000000000000000000000000000..9f31e23994f88037ac6f35caded4d648f135ce9b
--- /dev/null
+++ b/evidence/verification-no-bridges.k
@@ -0,0 +1,28 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-NOBRIDGES
+  imports MPY
+
+  syntax IntSeq ::= decimalCodes(Int)
+                  | fruitSentenceCodes(Int, Int)
+
+  syntax Module ::= "solutionModule" [function, total]
+  rule solutionModule =>
+    Module(
+      FuncDef("fruit_distribution", Params("s", "n"),
+        Assign(
+          Name("fruits"),
+          Call(Attribute(Name("s"), "split"), .Exprs))
+        Return(
+          BinOp(
+            "-",
+            BinOp(
+              "-",
+              Name("n"),
+              Call(
+                Name("int"),
+                Subscript(Name("fruits"), Int(0)), .Exprs)),
+            Call(
+              Name("int"),
+              Subscript(Name("fruits"), Int(3)), .Exprs)))))
+endmodule

