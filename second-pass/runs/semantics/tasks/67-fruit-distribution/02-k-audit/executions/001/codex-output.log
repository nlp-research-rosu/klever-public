diff --git a/evidence/spec-vacuity.k b/evidence/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..f78575ddd024eae9f72fac2bc54fed255f77e52e
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,33 @@
+requires "verification.k"
+
+module SPEC-VACUITY
+  imports VERIFICATION
+
+  // Fresh reviewer mutation: the real implementation returns N-A-B, so the
+  // added +1 is false, e.g. A=5, B=6, N=19 expects 9 although both Python
+  // implementations and the concrete K execution return 8.
+  claim
+    <k>
+      #loadAll(solutionModule)
+      ~> Call(
+           Name("fruit_distribution"),
+           str(fruitSentenceCodes(A, B)), N, .Exprs)
+      => N -Int A -Int B +Int 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      => ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => ?FINAL_HEAP:Map </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires A >=Int 0
+     andBool B >=Int 0
+     andBool A +Int B <=Int N
+endmodule
