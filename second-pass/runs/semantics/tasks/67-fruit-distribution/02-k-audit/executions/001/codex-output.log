+  printf ' %q' "$@"
+  printf '\n'
+} > "$logfile"
+
+set +e
+"$@" 2>&1 | tee -a "$logfile"
+status=${PIPESTATUS[0]}
+set -e
+
+printf 'EXIT_STATUS: %d\n' "$status" | tee -a "$logfile"
+exit "$status"

