Module(
  FuncDef(
    "flip_case",
    Params("string"),
    Return(Call(Attribute(Name("string"), "swapcase"), )))
  Assert(
    Compare(
      Call(Name("flip_case"), Str("Hello")),
      CmpOp("==", Str("hELLO"))))
  Assert(
    Compare(
      Call(Name("flip_case"), Str("Python 3.11")),
      CmpOp("==", Str("pYTHON 3.11"))))
  Assert(
    Compare(
      Call(Name("flip_case"), Str("")),
      CmpOp("==", Str("")))))
