+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // Reviewer mutation: falsely require a leading "!" (code 33).
+  // The unchanged precondition is satisfiable at S = .IntSeq, where the
+  // program returns the empty string rather than "!".
+  claim
+    <k> #runFlipCase(S:IntSeq)
+      => str(iCons(33, mapSwap(S))) </k>
+    <env> 0 </env>
+    <scopes>
+        0  |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope
+      =>
+        0  |-> scope(
+                 "flip_case" |->
+                   closureVal(
+                     ("string", .ParamNames),
+                     flipCaseBody,
+                     0),
+                 parent(-1))
+        -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/verification-body-mut.k b/evidence/verification-body-mut.k
new file mode 100644
index 0000000000000000000000000000000000000000..d8fae270ecdb0b7158cde57f8898f31a57219890
--- /dev/null
+++ b/evidence/verification-body-mut.k
@@ -0,0 +1,23 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BODY-MUT
+  imports MPY
+
+  // Reviewer mutation: execute an identity body, not swapcase.
+  syntax Stmts ::= "flipCaseBodyMut" [macro]
+  rule flipCaseBodyMut
+    => Return(Name("string")) .Stmts
+
+  syntax Module ::= "solutionModuleMut" [macro]
+  rule solutionModuleMut
+    => Module(
+         FuncDef(
+           "flip_case",
+           Params("string"),
+           flipCaseBodyMut))
+
+  syntax KItem ::= "#runFlipCaseMut" "(" IntSeq ")"
+  rule <k> #runFlipCaseMut(S:IntSeq)
+        => #loadAll(solutionModuleMut)
+        ~> Call(Name("flip_case"), str(S)) ... </k>
+endmodule

