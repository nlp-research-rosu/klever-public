+requires "verification-body-mut.k"
+
+module SPEC-BODY-MUT
+  imports VERIFICATION-BODY-MUT
+
+  claim
+    <k> #runFlipCaseMut(S:IntSeq) => str(mapSwap(S)) </k>
+    <env> 0 </env>
+    <scopes>
+        0  |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope
+      =>
+        0  |-> scope(
+                 "flip_case" |->
+                   closureVal(
+                     ("string", .ParamNames),
+                     flipCaseBodyMut,
+                     0),
+                 parent(-1))
+        -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/verification-body-mut.k b/evidence/verification-body-mut.k
new file mode 100644
index 0000000000000000000000000000000000000000..d8fae270ecdb0b7158cde57f8898f31a57219890
--- /dev/null
+++ b/evidence/verification-body-mut.k
@@ -0,0 +1,23 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION-BODY-MUT
+  imports MPY
+
+  // Reviewer mutation: execute an identity body, not swapcase.
+  syntax Stmts ::= "flipCaseBodyMut" [macro]
+  rule flipCaseBodyMut
+    => Return(Name("string")) .Stmts
+
+  syntax Module ::= "solutionModuleMut" [macro]
+  rule solutionModuleMut
+    => Module(
+         FuncDef(
+           "flip_case",
+           Params("string"),
+           flipCaseBodyMut))
+
+  syntax KItem ::= "#runFlipCaseMut" "(" IntSeq ")"
+  rule <k> #runFlipCaseMut(S:IntSeq)
+        => #loadAll(solutionModuleMut)
+        ~> Call(Name("flip_case"), str(S)) ... </k>
+endmodule

exec
/bin/bash -lc "script -q -e -c 'kast solution.mpy --definition audit-verification-kompiled --module VERIFICATION --sort Module --expand-macros --output kast --output-file kast-solution-audit.txt && kast --expression solutionModule --definition audit-verification-kompiled --module VERIFICATION --sort Module --expand-macros --output kast --output-file kast-claim-audit.txt && cmp kast-solution-audit.txt kast-claim-audit.txt && sha256sum kast-solution-audit.txt kast-claim-audit.txt && python3 /audit-output/evidence/adequacy_witness.py' /audit-output/evidence/stage4-pinning-and-ground.log" in /tmp/audit-work/27-flip-case
