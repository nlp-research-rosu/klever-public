/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import hashlib,json
r=Path('/reference/reference-semantics')
files=sorted(p for p in r.rglob('*') if p.is_file())
items=[(p.relative_to(r).as_posix(),hashlib.sha256(p.read_bytes()).hexdigest(),len(p.read_bytes())) for p in files]
target='1de6d5f51876cf9d0f4449a78f077f8b127a14add0504d5060da680fc5a443de'
cands={}
objs=[
 dict((p,h) for p,h,s in items),
 [{'path':p,'sha256':h} for p,h,s in items],
 [{'path':p,'sha256':h,'size':s} for p,h,s in items],
 items,
 [(p,h) for p,h,s in items],
]
for i,o in enumerate(objs):
 for sort in [False,True]:
  for compact in [False,True]:
   kw={'sort_keys':sort}
   if compact: kw['separators']=(',',':')
   b=json.dumps(o,**kw).encode()
   for nl in [b,b+b'\\n']:
    h=hashlib.sha256(nl).hexdigest()
    if h==target: print('MATCH',i,sort,compact,len(nl))
    cands[(i,sort,compact,len(nl))]=h
for mode in range(8):
