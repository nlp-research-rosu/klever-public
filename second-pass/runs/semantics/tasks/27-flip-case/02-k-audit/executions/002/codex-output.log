    <k> #runFlipCase(S:IntSeq) => str(mapSwap(S)) </k>
    <env> 0 </env>
    <scopes>
        0  |-> scope(.Map, parent(-1))
        -1 |-> builtinsScope
      =>
        0  |-> scope(
                 "flip_case" |->
                   closureVal(
                     ("string", .ParamNames),
                     flipCaseBody,
                     0),
                 parent(-1))
        -1 |-> builtinsScope
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule
requires "reference-semantics/semantics.k"

module VERIFICATION
  imports MPY

  // This macro is the exact constructor tree generated in solution.mpy
  // (the generated empty argument list is written explicitly as .Exprs here).
  syntax Stmts ::= "flipCaseBody" [macro]
  rule flipCaseBody
    => Return(Call(Attribute(Name("string"), "swapcase"), .Exprs)) .Stmts

  syntax Module ::= "solutionModule" [macro]
  rule solutionModule
    => Module(
         FuncDef(
           "flip_case",
           Params("string"),
           flipCaseBody))

  // Load the submitted module, then call its required entry point.
  syntax KItem ::= "#runFlipCase" "(" IntSeq ")"
  rule <k> #runFlipCase(S:IntSeq)
        => #loadAll(solutionModule)
        ~> Call(Name("flip_case"), str(S)) ... </k>
endmodule
#!/usr/bin/env bash
set -euo pipefail

python3 py2mpy.py solution.py > solution.mpy

kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled

krun solution.mpy --definition runtime-kompiled
krun concrete-tests.mpy --definition runtime-kompiled

kompile verification.k \
  --backend haskell \
  --main-module VERIFICATION \
  --syntax-module VERIFICATION \
  --output-definition verification-kompiled

kprove \
  --definition verification-kompiled \
  --spec-module SPEC \
  spec.k
Module(
  FuncDef(
    "flip_case",
    Params("string"),
    Return(Call(Attribute(Name("string"), "swapcase"), )))
  Assert(
    Compare(
      Call(Name("flip_case"), Str("Hello")),
      CmpOp("==", Str("hELLO"))))
  Assert(
    Compare(
      Call(Name("flip_case"), Str("Python 3.11")),
      CmpOp("==", Str("pYTHON 3.11"))))
  Assert(
    Compare(
      Call(Name("flip_case"), Str("")),
      CmpOp("==", Str("")))))

