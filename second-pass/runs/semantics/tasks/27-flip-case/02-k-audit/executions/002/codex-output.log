diff --git a/evidence/spec-unicode-witness.k b/evidence/spec-unicode-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..9940f86839d962862d5c4083660bdccb7055e1a6
--- /dev/null
+++ b/evidence/spec-unicode-witness.k
@@ -0,0 +1,31 @@
+requires "verification.k"
+
+module SPEC-UNICODE-WITNESS
+  imports VERIFICATION
+
+  // The supplied ASCII-only swapC leaves U+00E9 (é) unchanged.
+  claim
+    <k> #runFlipCase(iCons(233, .IntSeq))
