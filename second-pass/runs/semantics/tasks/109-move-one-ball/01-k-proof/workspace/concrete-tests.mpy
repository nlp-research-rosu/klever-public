Module(
  FuncDef("move_one_ball", Params("arr"),
    If(Compare(Call(Name("len"), Name("arr")), CmpOp("==", Int(0))),
      Return(Bool(true)),
      )
    Assign(Name("drops"), Int(0))
    Assign(Name("first"), Subscript(Name("arr"), Int(0)))
    Assign(Name("previous"), Name("first"))
    For(Name("current"), Name("arr"),
      If(Compare(Name("current"), CmpOp("<", Name("previous"))),
        AugAssign(Name("drops"), "+", Int(1)),
        )
      Assign(Name("previous"), Name("current")))
    If(Compare(Name("first"), CmpOp("<", Name("previous"))),
      AugAssign(Name("drops"), "+", Int(1)),
      )
    Return(Compare(Name("drops"), CmpOp("<", Int(2)))))
  Assert(
    Compare(
      Call(Name("move_one_ball"), ListExpr()),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("move_one_ball"), ListExpr(Int(1))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("move_one_ball"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("move_one_ball"),
        ListExpr(Int(3), Int(4), Int(5), Int(1), Int(2))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("move_one_ball"),
        ListExpr(Int(3), Int(5), Int(4), Int(1), Int(2))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("move_one_ball"), ListExpr(Int(1), Int(3), Int(2))),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("move_one_ball"), ListExpr(Int(2), Int(3), Int(1))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("move_one_ball"),
        ListExpr(Int(4), Int(1), Int(3), Int(2))),
      CmpOp("==", Bool(false)))))
