from itertools import permutations
from solution import move_one_ball

def brute(xs):
    return any(xs[-k:] + xs[:-k] == sorted(xs) for k in range(len(xs) + 1))

checked = 0
for n in range(8):
    for xs in permutations(range(n)):
        xs = list(xs)
        assert move_one_ball(xs) == brute(xs), xs
        checked += 1
print(f\"differential permutations checked: {checked}\")
