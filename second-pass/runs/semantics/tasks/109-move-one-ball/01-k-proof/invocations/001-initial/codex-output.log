+  rule addDrop(C:Int, P:Int, D:Int)
+    => D +Int (#if C <Int P #then 1 #else 0 #fi)
+
+  syntax Int ::= scanDrops(ValSeq, Int, Int) [function]
+  rule scanDrops(.ValSeq, _P:Int, D:Int) => D
+  rule scanDrops(vCons(C:Int, R:ValSeq), P:Int, D:Int)
+    => scanDrops(R, C, addDrop(C, P, D))
+
+  syntax Int ::= scanLast(ValSeq, Int) [function]
+  rule scanLast(.ValSeq, P:Int) => P
+  rule scanLast(vCons(C:Int, R:ValSeq), _P:Int)
+    => scanLast(R, C)
+
+  syntax Int ::= circularDrops(Int, ValSeq) [function]
+  rule circularDrops(F:Int, VS:ValSeq)
+    => addDrop(F, scanLast(VS, F), scanDrops(VS, F, 0))
+
+  syntax Bool ::= moveOneBallSpec(ValSeq) [function]
+  rule moveOneBallSpec(.ValSeq) => true
+  rule moveOneBallSpec(vCons(F:Int, R:ValSeq))
+    => circularDrops(F, vCons(F, R)) <Int 2
+
+  // Exact store transformer for the Python for-loop.  It is used only in the
+  // separately proved loop-summary claim in spec.k.
+  syntax Map ::= scanStore(ValSeq, Map, Int, Int) [function]
+  rule scanStore(.ValSeq, M:Map, _P:Int, _D:Int) => M
+  rule scanStore(vCons(C:Int, R:ValSeq), M:Map, P:Int, D:Int)
+    => scanStore(
+         R,
+         M [ "current" <- C ]
+           [ "drops" <- addDrop(C, P, D) ]
+           [ "previous" <- C ],
+         C,
+         addDrop(C, P, D))
+endmodule

