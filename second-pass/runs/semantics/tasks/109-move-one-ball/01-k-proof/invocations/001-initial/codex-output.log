+  rule scanStore(.ValSeq, M:Map, _P:Int, _D:Int) => M
+  rule scanStore(vCons(C:Int, R:ValSeq), M:Map, P:Int, D:Int)
+    => scanStore(
+         R,
+         M [ "current" <- C ]
+           [ "drops" <- addDrop(C, P, D) ]
+           [ "previous" <- C ],
+         C,
+         addDrop(C, P, D))
+endmodule

