+           [ "previous" <- C ],
+         C,
+         addDrop(C, P, D))
+  rule scanStore(intVals(.IntSeq), M:Map, _P:Int, _D:Int) => M
+  rule scanStore(intVals(iCons(C:Int, IS:IntSeq)),
+                 M:Map, P:Int, D:Int)
+    => scanStore(
+         intVals(IS),
+         M [ "current" <- C ]
+           [ "drops" <- addDrop(C, P, D) ]
+           [ "previous" <- C ],
+         C,
+         addDrop(C, P, D))
+endmodule

