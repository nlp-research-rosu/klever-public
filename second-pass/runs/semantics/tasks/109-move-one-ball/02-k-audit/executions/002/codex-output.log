    95	  rule moveOneBallSpec(intVals(.IntSeq)) => true
    96	  rule moveOneBallSpec(intVals(iCons(F:Int, IS:IntSeq)))
    97	    => circularDrops(F, intVals(iCons(F, IS))) <Int 2
