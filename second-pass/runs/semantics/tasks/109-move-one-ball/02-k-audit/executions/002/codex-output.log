+    print(
+        f"scope={scope_name} intended_domain={intended_domain} "
+        f"cases={len(cases)} mismatches={scope_mismatches}"
+    )
+
+encoded = json.dumps(corpus, separators=(",", ":"), ensure_ascii=True).encode()
