index 0a30a01d773b318222c4521b761e61cefb4daa32..0502b592e1e8760b25a384bfa48e6ab5ab2a5e91
--- a//tmp/audit-work/body-mutation/verification.k
+++ b//tmp/audit-work/body-mutation/verification.k
@@ -25,7 +25,7 @@
        If(Compare(Name("first"), CmpOp("<", Name("previous"))),
           AugAssign(Name("drops"), "+", Int(1)),
           .Stmts)
-       Return(Compare(Name("drops"), CmpOp("<", Int(2))))
+       Return(Compare(Name("drops"), CmpOp("<", Int(3))))
 
