     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // These constants are a literal transcription of solution.mpy.  Naming the
     7	  // body here keeps the reachability claims readable without adding any
     8	  // execution rule for move_one_ball.
     9	  syntax Stmts ::= "MOVE-ONE-BALL-LOOP-BODY" [function]
    10	  rule MOVE-ONE-BALL-LOOP-BODY
    11	    => If(Compare(Name("current"), CmpOp("<", Name("previous"))),
    12	          AugAssign(Name("drops"), "+", Int(1)),
    13	          .Stmts)
    14	       Assign(Name("previous"), Name("current"))
    15	
    16	  syntax Stmts ::= "MOVE-ONE-BALL-BODY" [function]
    17	  rule MOVE-ONE-BALL-BODY
    18	    => If(Compare(Call(Name("len"), Name("arr")), CmpOp("==", Int(0))),
    19	          Return(Bool(true)),
    20	          .Stmts)
    21	       Assign(Name("drops"), Int(0))
    22	       Assign(Name("first"), Subscript(Name("arr"), Int(0)))
    23	       Assign(Name("previous"), Name("first"))
    24	       For(Name("current"), Name("arr"), MOVE-ONE-BALL-LOOP-BODY)
    25	       If(Compare(Name("first"), CmpOp("<", Name("previous"))),
    26	          AugAssign(Name("drops"), "+", Int(1)),
    27	          .Stmts)
    28	       Return(Compare(Name("drops"), CmpOp("<", Int(2))))
    29	
    30	  syntax Val ::= "MOVE-ONE-BALL-CLOSURE" [function]
    31	  rule MOVE-ONE-BALL-CLOSURE
    32	    => closureVal("arr", MOVE-ONE-BALL-BODY, 0)
    33	
    34	  // A typed, symbolic encoding of a finite Python list of integers.  The
    35	  // wrapper stays visible so a circularity can match its IntSeq tail without
    36	  // admitting non-integer Val elements.
    37	  syntax ValSeq ::= intVals(IntSeq)
    38	
    39	  // Constructor-exposure lemmas.  The generic list rules see only ValSeq and
    40	  // cannot split an opaque symbolic IntSeq themselves, so these equivalent
    41	  // typed cases expose exactly the two IntSeq constructors to symbolic
    42	  // execution.  They add no behavior on concrete lists.
    43	  rule <k> #iterNext(list(intVals(.IntSeq))) => #iterDone ... </k>
    44	       [priority(40)]
    45	  rule <k> #iterNext(list(intVals(iCons(I:Int, IS:IntSeq))))
    46	        => #iterYield(I, list(intVals(IS))) ... </k>
    47	       [priority(40)]
    48	
    49	  rule <k> #applyK(toCall(builtinV("len")),
    50	                   (list(intVals(.IntSeq)), .Vals))
    51	        => 0 ... </k>
    52	       [priority(40)]
    53	  rule <k> #applyK(toCall(builtinV("len")),
    54	                   (list(intVals(iCons(_I:Int, _IS:IntSeq))), .Vals))
    55	        => 1 ... </k>
    56	       [priority(40)]
    57	  // The target observes len(arr) only through == 0, so 1 is the exact
    58	  // zero/nonzero abstraction of every nonempty symbolic list.
    59	
    60	  rule <k> Subscript(list(intVals(iCons(I:Int, _IS:IntSeq))), 0)
    61	        => I ... </k>
    62	       [priority(40)]
    63	
    64	  // One descent is added precisely when the next item is below the previous
    65	  // item.  scanDrops and scanLast are the pure mathematical fold used by the
    66	  // postcondition.
    67	  syntax Int ::= addDrop(Int, Int, Int) [function, total]
    68	  rule addDrop(C:Int, P:Int, D:Int)
    69	    => D +Int (#if C <Int P #then 1 #else 0 #fi)
    70	
    71	  syntax Int ::= scanDrops(ValSeq, Int, Int) [function, total]
    72	  rule scanDrops(.ValSeq, _P:Int, D:Int) => D
    73	  rule scanDrops(vCons(C:Int, R:ValSeq), P:Int, D:Int)
    74	    => scanDrops(R, C, addDrop(C, P, D))
    75	  rule scanDrops(intVals(.IntSeq), _P:Int, D:Int) => D
    76	  rule scanDrops(intVals(iCons(C:Int, IS:IntSeq)), P:Int, D:Int)
    77	    => scanDrops(intVals(IS), C, addDrop(C, P, D))
    78	
    79	  syntax Int ::= scanLast(ValSeq, Int) [function, total]
    80	  rule scanLast(.ValSeq, P:Int) => P
    81	  rule scanLast(vCons(C:Int, R:ValSeq), _P:Int)
    82	    => scanLast(R, C)
    83	  rule scanLast(intVals(.IntSeq), P:Int) => P
    84	  rule scanLast(intVals(iCons(C:Int, IS:IntSeq)), _P:Int)
