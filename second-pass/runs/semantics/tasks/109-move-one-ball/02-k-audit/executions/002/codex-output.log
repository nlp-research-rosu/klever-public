    99	endmodule
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Translate the submitted implementation and the concrete assertion harness.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	python3 py2mpy.py concrete-tests.py > concrete-tests.mpy
     7	
     8	# Concrete execution uses exactly the required LLVM main and syntax modules.
     9	kompile reference-semantics/semantics.k \
    10	  --backend llvm \
    11	  --main-module MPY-KRUN \
    12	  --syntax-module MPY-SYNTAX \
    13	  --output-definition runtime-kompiled
    14	krun concrete-tests.mpy \
    15	  --definition runtime-kompiled \
    16	  --output pretty
    17	
    18	# Symbolic proofs import MPY through verification.k and intentionally exclude
    19	# the concrete-only MPY-CONCRETE module.
    20	kompile verification.k \
    21	  --backend haskell \
    22	  --main-module VERIFICATION \
    23	  --syntax-module MPY-SYNTAX \
    24	  --output-definition verification-kompiled
    25	kprove spec.k \
    26	  --definition verification-kompiled \
    27	  --spec-module SPEC \
    28	  --output pretty
     1	def move_one_ball(arr):
     2	    if len(arr) == 0:
     3	        return True
     4	
     5	    drops = 0
     6	    first = arr[0]
     7	    previous = first
     8	
     9	    for current in arr:
    10	        if current < previous:
    11	            drops += 1
    12	        previous = current
    13	
    14	    if first < previous:
    15	        drops += 1
    16	
    17	    return drops < 2
    18	
    19	
    20	assert move_one_ball([]) == True
    21	assert move_one_ball([1]) == True
    22	assert move_one_ball([1, 2, 3]) == True
    23	assert move_one_ball([3, 4, 5, 1, 2]) == True
    24	assert move_one_ball([3, 5, 4, 1, 2]) == False
    25	assert move_one_ball([1, 3, 2]) == False
    26	assert move_one_ball([2, 3, 1]) == True
    27	assert move_one_ball([4, 1, 3, 2]) == False

