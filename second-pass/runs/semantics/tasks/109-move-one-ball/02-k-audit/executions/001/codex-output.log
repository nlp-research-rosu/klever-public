diff --git a//tmp/audit-work/109-move-one-ball/candidate/spec-len-bridge-opposite.k b//tmp/audit-work/109-move-one-ball/candidate/spec-len-bridge-opposite.k
new file mode 100644
index 0000000000000000000000000000000000000000..b1f26511d7ccb7188ecfad292224fcfa3ee2673d
--- /dev/null
+++ b//tmp/audit-work/109-move-one-ball/candidate/spec-len-bridge-opposite.k
@@ -0,0 +1,26 @@
+requires "verification.k"
+
+module SPEC-LEN-BRIDGE-OPPOSITE
+  imports VERIFICATION
+
+  // The ordinary mathematical/Python result for a two-element list is 2.
+  // This must get stuck because the proof-local bridge has already returned 1.
+  claim [abstract-list-should-have-len-two]:
+    <k>
+      Call(Name("len"), list(intVals(iCons(10, iCons(20, .IntSeq)))))
+      =>
+      2
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
