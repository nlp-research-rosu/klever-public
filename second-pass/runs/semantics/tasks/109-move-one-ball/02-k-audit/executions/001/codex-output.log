+#!/usr/bin/env bash
+set +e
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n\n' "$status"
+  return "$status"
+}
+
+cd /tmp/audit-work/109-move-one-ball/candidate || exit 90
+export PATH="$HOME/.nix-profile/bin:$PATH"
+
+run kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --output pretty
+all_status=$?
+
+individual_status=0
+for label in \
+  move-one-ball-loop-induction \
+  move-one-ball-loop-entry \
+  move-one-ball-correct
+do
+  run kprove spec.k \
+    --definition verification-kompiled \
+    --spec-module SPEC \
+    --claims "$label" \
+    --output pretty
+  status=$?
+  if (( status != 0 )); then
+    individual_status=1
+  fi
+done
+
+printf 'all_claims_status=%d\n' "$all_status"
+printf 'individual_claims_status=%d\n' "$individual_status"
+if (( all_status != 0 || individual_status != 0 )); then
+  exit 1
+fi
