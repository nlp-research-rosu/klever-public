new file mode 100644
index 0000000000000000000000000000000000000000..9308e2c766a4c932cda12e5fcdc2f56304f10cd6
--- /dev/null
+++ b/evidence/stage3-prove.sh
@@ -0,0 +1,43 @@
+#!/usr/bin/env bash
+set +e
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf '[exit %d]\n\n' "$status"
+  return "$status"
+}
+
+cd /tmp/audit-work/109-move-one-ball/candidate || exit 90
+export PATH="$HOME/.nix-profile/bin:$PATH"
+
+run kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.move-one-ball-loop-induction \
+  --output pretty
+induction_status=$?
+
+run kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  --claims SPEC.move-one-ball-loop-induction,SPEC.move-one-ball-loop-entry \
+  --output pretty
+entry_with_dependency_status=$?
+
+run kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC \
