diff --git a//tmp/audit-work/109-move-one-ball/candidate/spec-ground-adequacy.k b//tmp/audit-work/109-move-one-ball/candidate/spec-ground-adequacy.k
new file mode 100644
index 0000000000000000000000000000000000000000..cce3be992aba94fb84ae5702ef2ca9da03f84f5e
--- /dev/null
+++ b//tmp/audit-work/109-move-one-ball/candidate/spec-ground-adequacy.k
@@ -0,0 +1,82 @@
+requires "verification.k"
+
+module SPEC-GROUND-ADEQUACY
+  imports VERIFICATION
+
+  claim [wrapper-empty]:
+    <k> Call(Name("move_one_ball"), list(intVals(.IntSeq))) => true </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope("move_one_ball" |-> MOVE-ONE-BALL-CLOSURE, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc> <heap> .Map </heap> <heapLoc> 0 </heapLoc>
+    <stack> .List </stack> <ret> noRet </ret> <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [wrapper-documented-true]:
+    <k>
+      Call(Name("move_one_ball"),
+        list(intVals(iCons(3, iCons(4, iCons(5, iCons(1, iCons(2, .IntSeq))))))))
+      =>
+      true
+    </k>
+    <env> 0 </env>
