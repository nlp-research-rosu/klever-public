     1	def move_one_ball(arr):
     2	    if len(arr) == 0:
     3	        return True
     4	
     5	    drops = 0
     6	    first = arr[0]
     7	    previous = first
     8	
     9	    for current in arr:
    10	        if current < previous:
    11	            drops += 1
    12	        previous = current
    13	
    14	    if first < previous:
    15	        drops += 1
    16	
    17	    return drops < 2

