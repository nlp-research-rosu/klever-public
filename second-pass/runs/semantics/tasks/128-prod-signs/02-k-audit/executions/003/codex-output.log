+  exit 64
+fi
+
+log=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf 'EXIT_STATUS: %d\n' "$status"
+  exit "$status"
+} 2>&1 | tee "$log"
+
+exit "${PIPESTATUS[0]}"

