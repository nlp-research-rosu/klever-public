index 0000000000000000000000000000000000000000..7fa6cbf8eead5b713ec6b263fa4deb0634317cfb
--- /dev/null
+++ b/evidence/spec-vacuity.k
@@ -0,0 +1,27 @@
+requires "verification.k"
+
+module AUDIT-SPEC-VACUITY
+  imports PROD-SIGNS-VERIFICATION
+
+  // Deliberately false: for every nonempty integer input, demand one more
+  // than the exact result constrained by the original entry claim.
+  claim [prod-signs-nonempty-off-by-one]:
+    <k>
+      Call(prodSignsFunction, list(vCons(I:Int, VS:ValSeq)))
+      =>
+      (magnitudeSum(vCons(I, VS)) *Int signProduct(vCons(I, VS))) +Int 1
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map => 0 |-> list(.ValSeq) </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires allInts(VS)
+endmodule
diff --git a/evidence/stage1_integrity.sh b/evidence/stage1_integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..b299557fe8a96f1b52a53a4757d32d6e36d5fa2a
--- /dev/null
+++ b/evidence/stage1_integrity.sh
@@ -0,0 +1,68 @@
+#!/usr/bin/env bash
+set -u
+
+candidate=/candidate
+reference=/reference
+had_issue=0
+
+echo 'MODE_CHECK: SUPPLIED_SEMANTICS'
+if [[ -d "$reference/reference-semantics" ]]; then
+  echo 'PASS reference/reference-semantics is present'
+else
+  echo 'INFRASTRUCTURE_BREACH reference/reference-semantics is absent'
+  exit 70
+fi
+
+echo 'REQUIRED_GENERATION_METADATA'
+for name in run-input.json metrics.json codex-last.txt codex-output.log; do
+  if [[ -f "$candidate/$name" && ! -L "$candidate/$name" ]]; then
+    echo "PRESENT regular $candidate/$name"
+  elif [[ -e "$candidate/$name" || -L "$candidate/$name" ]]; then
+    echo "MISTYPED_OR_SYMLINKED $candidate/$name"
+    had_issue=1
+  else
+    echo "MISSING $candidate/$name"
+    had_issue=1
+  fi
+done
+
+echo 'REQUIRED_PROOF_ARTIFACT_TYPES'
+for name in prompt.py py2mpy.py solution.py solution.mpy spec.k verification.k; do
+  if [[ -f "$candidate/$name" && ! -L "$candidate/$name" ]]; then
+    echo "PASS regular $candidate/$name"
+  elif [[ -e "$candidate/$name" || -L "$candidate/$name" ]]; then
+    echo "FAIL mistyped_or_symlinked $candidate/$name"
+    had_issue=1
+  else
+    echo "FAIL missing $candidate/$name"
+    had_issue=1
+  fi
+done
+
+echo 'TRUSTED_PROMPT_COMPARISON'
+cmp "$candidate/prompt.py" "$reference/prompt.py"
+echo "prompt_cmp_exit=$?"
+
+echo 'TRUSTED_TRANSLATOR_COMPARISON'
+cmp "$candidate/py2mpy.py" "$reference/py2mpy.py"
+echo "translator_cmp_exit=$?"
+
+echo 'SUPPLIED_SEMANTICS_SYMLINK_CHECK'
+find "$candidate/reference-semantics" -type l -print
+find "$reference/reference-semantics" -type l -print
+
+echo 'SUPPLIED_SEMANTICS_RECURSIVE_COMPARISON'
+diff -qr --no-dereference \
+  "$reference/reference-semantics" \
+  "$candidate/reference-semantics"
+echo "semantics_diff_exit=$?"
+
+echo 'SOURCE_SHA256'
+sha256sum \
+  "$candidate/prompt.py" "$reference/prompt.py" \
+  "$candidate/py2mpy.py" "$reference/py2mpy.py" \
+  "$candidate/solution.py" "$candidate/solution.mpy" \
+  "$candidate/spec.k" "$candidate/verification.k"
+
+echo "NONFATAL_PROVENANCE_ISSUE=$had_issue"
+exit 0

diff --git a/evidence/bridge-free-verification.k b/evidence/bridge-free-verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..929ff212e09a29d173b222400e3c1e6620636a9e
--- /dev/null
+++ b/evidence/bridge-free-verification.k
@@ -0,0 +1,35 @@
+requires "reference-semantics/semantics.k"
+
+module AUDIT-BRIDGE-FREE-VERIFICATION
+  imports MPY
+
+  syntax Bool ::= auditAllInts(ValSeq) [function, total]
+  rule auditAllInts(.ValSeq) => true
+  rule auditAllInts(vCons(_I:Int, VS:ValSeq)) => auditAllInts(VS)
+  rule auditAllInts(vCons(_V:Val, _VS:ValSeq)) => false [owise]
+
+  syntax Int ::= auditMagnitudeAcc(ValSeq, Int) [function]
+  rule auditMagnitudeAcc(.ValSeq, A:Int) => A
+  rule auditMagnitudeAcc(vCons(I:Int, VS:ValSeq), A:Int)
+    => auditMagnitudeAcc(VS, A -Int I)
+    requires I <Int 0
+  rule auditMagnitudeAcc(vCons(I:Int, VS:ValSeq), A:Int)
+    => auditMagnitudeAcc(VS, A +Int I)
+    requires I >=Int 0
+
+  syntax Int ::= auditSignAcc(ValSeq, Int) [function]
+  rule auditSignAcc(.ValSeq, S:Int) => S
+  rule auditSignAcc(vCons(I:Int, VS:ValSeq), S:Int)
+    => auditSignAcc(VS, 0 -Int S)
+    requires I <Int 0
+  rule auditSignAcc(vCons(0, VS:ValSeq), _S:Int)
+    => auditSignAcc(VS, 0)
+  rule auditSignAcc(vCons(I:Int, VS:ValSeq), S:Int)
+    => auditSignAcc(VS, S)
+    requires I >Int 0
+
+  syntax Int ::= auditLastInt(ValSeq) [function]
+  rule auditLastInt(vCons(I:Int, .ValSeq)) => I
+  rule auditLastInt(vCons(_I:Int, vCons(J:Int, VS:ValSeq)))
+    => auditLastInt(vCons(J, VS))
+endmodule
diff --git a/evidence/cell-witness-bridge-spec.k b/evidence/cell-witness-bridge-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..c24e1fe717e1afa903499a689c4715cb63bc0930
--- /dev/null
+++ b/evidence/cell-witness-bridge-spec.k
@@ -0,0 +1,43 @@
+requires "verification.k"
+
