+requires "bridge-free-verification.k"
+
+module AUDIT-LOOP-CONTINUATION-SPEC
+  imports AUDIT-BRIDGE-FREE-VERIFICATION
+
+  claim [loop-continuation]:
+    <k>
+      For(Name("value"), list(vCons(-2, vCons(0, vCons(3, .ValSeq)))),
+        If(Compare(Name("value"), CmpOp("<", Int(0))),
+          Assign(Name("total"),
+            BinOp("-", Name("total"), Name("value")))
+          Assign(Name("sign"),
+            BinOp("-", Int(0), Name("sign"))),
+          Assign(Name("total"),
+            BinOp("+", Name("total"), Name("value")))
+          If(Compare(Name("value"), CmpOp("==", Int(0))),
+            Assign(Name("sign"), Int(0)),
+            .Stmts)))
+      ~> Assign(Name("after"), Int(7))
+      =>
+      .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        .Map
+          => .Map [ "total" <- 5 ]
+                  [ "sign" <- 0 ]
+                  [ "value" <- 3 ]
+                  [ "after" <- 7 ],
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..766f2d980660da3b5846617e7535610cdda264e5
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -u
+
+if [[ "$#" -lt 2 ]]; then
+  echo "usage: $0 LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+log=$1
+shift
+
+{
+  printf 'WORKDIR: %q\n' "$PWD"
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'START_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+  "$@"
+  status=$?
+  printf 'EXIT_STATUS: %d\n' "$status"
+  printf 'END_UTC: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
+} >"$log" 2>&1
+
+exit "$status"
