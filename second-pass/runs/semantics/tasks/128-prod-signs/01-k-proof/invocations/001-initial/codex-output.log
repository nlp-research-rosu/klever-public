diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..6a4653874758d1834f0c7b6799141cc1908d9bea
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,20 @@
+def prod_signs(arr):
+    """
+    Return the sum of the magnitudes in arr multiplied by the product of
+    their signs.  The empty input has no such product and returns None.
+    """
+    if arr == []:
+        return None
+
+    total = 0
+    sign = 1
+    for value in arr:
+        if value < 0:
+            total = total - value
+            sign = 0 - sign
+        else:
+            total = total + value
+            if value == 0:
+                sign = 0
+
+    return total * sign
