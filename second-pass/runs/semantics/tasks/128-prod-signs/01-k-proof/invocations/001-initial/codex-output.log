diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ae502cfd814cbe66866156e64222612f4a3f4075
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,100 @@
+requires "reference-semantics/semantics.k"
+
+module PROD-SIGNS-VERIFICATION
+  imports MPY
+
+  // Embed an arbitrary mathematical sequence of integers as a Python list.
+  // IntSeq is reused here solely as the semantics' inductive sequence of Ints.
+  syntax ValSeq ::= intVals(IntSeq) [function, total]
+  rule intVals(.IntSeq) => .ValSeq
+  rule intVals(iCons(I:Int, IS:IntSeq)) => vCons(I, intVals(IS))
+
+  // These two left folds state the two factors in the task's contract.
+  // Their equations deliberately mirror addition of |I| and multiplication
+  // by sign(I), respectively.
+  syntax Int ::= magnitudeAcc(IntSeq, Int) [function, total]
+  rule magnitudeAcc(.IntSeq, A:Int) => A
+  rule magnitudeAcc(iCons(I:Int, IS:IntSeq), A:Int)
+    => magnitudeAcc(IS, A -Int I)
+    requires I <Int 0
+  rule magnitudeAcc(iCons(I:Int, IS:IntSeq), A:Int)
+    => magnitudeAcc(IS, A +Int I)
+    requires I >=Int 0
+
+  syntax Int ::= signAcc(IntSeq, Int) [function, total]
+  rule signAcc(.IntSeq, S:Int) => S
+  rule signAcc(iCons(I:Int, IS:IntSeq), S:Int)
+    => signAcc(IS, 0 -Int S)
+    requires I <Int 0
+  rule signAcc(iCons(0, IS:IntSeq), _S:Int)
+    => signAcc(IS, 0)
+  rule signAcc(iCons(I:Int, IS:IntSeq), S:Int)
+    => signAcc(IS, S)
+    requires I >Int 0
+
+  syntax Val ::= prodSignsResult(IntSeq) [function, total]
+  rule prodSignsResult(.IntSeq) => noneV
+  rule prodSignsResult(iCons(I:Int, IS:IntSeq))
+    => magnitudeAcc(iCons(I, IS), 0) *Int signAcc(iCons(I, IS), 1)
+
+  // The exact closure translated from solution.py. The string expression is
+  // the function docstring; MPY evaluates it as a discarded expression.
+  syntax Val ::= "prodSignsFunction"
+  rule prodSignsFunction
+    => closureVal(
+         "arr",
+         Expr(Str(
+           "\n    Return the sum of the magnitudes in arr multiplied by the product of\n    their signs.  The empty input has no such product and returns None.\n    "))
+         If(Compare(Name("arr"), CmpOp("==", ListExpr(.Exprs))),
+           Return(NoneVal),
+           .Stmts)
+         Assign(Name("total"), Int(0))
+         Assign(Name("sign"), Int(1))
+         For(Name("value"), Name("arr"),
+           If(Compare(Name("value"), CmpOp("<", Int(0))),
+             Assign(Name("total"),
+               BinOp("-", Name("total"), Name("value")))
+             Assign(Name("sign"),
+               BinOp("-", Int(0), Name("sign"))),
+             Assign(Name("total"),
+               BinOp("+", Name("total"), Name("value")))
+             If(Compare(Name("value"), CmpOp("==", Int(0))),
+               Assign(Name("sign"), Int(0)),
+               .Stmts)))
+         Return(BinOp("*", Name("total"), Name("sign"))),
+         0)
+
+  // Loop-summary invariant for the exact loop above. It is applicable only to
+  // lists built by intVals, so every iterated value is an integer. It updates
+  // precisely the two locals read after the loop.
+  rule <k>
+         For(Name("value"), list(vCons(I:Int, intVals(IS:IntSeq))),
+           If(Compare(Name("value"), CmpOp("<", Int(0))),
+             Assign(Name("total"),
+               BinOp("-", Name("total"), Name("value")))
+             Assign(Name("sign"),
+               BinOp("-", Int(0), Name("sign"))),
+             Assign(Name("total"),
+               BinOp("+", Name("total"), Name("value")))
+             If(Compare(Name("value"), CmpOp("==", Int(0))),
+               Assign(Name("sign"), Int(0)),
+               .Stmts)))
+         =>
+         .K
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           M:Map
+             => M
+                  [ "total" <- magnitudeAcc(
+                      iCons(I, IS), {M["total"]}:>Int) ]
+                  [ "sign" <- signAcc(
+                      iCons(I, IS), {M["sign"]}:>Int) ],
+           P:Parent)
+         ...
+       </scopes>
+       requires "total" in_keys(M) andBool "sign" in_keys(M)
+       [simplification]
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module PROD-SIGNS-VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /work
