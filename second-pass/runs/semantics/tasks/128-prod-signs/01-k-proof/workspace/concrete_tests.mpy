Module(
  FuncDef("prod_signs", Params("arr"),
    If(Compare(Name("arr"), CmpOp("==", ListExpr())),
      Return(NoneVal),
      )
    Assign(Name("total"), Int(0))
    Assign(Name("sign"), Int(1))
    For(Name("value"), Name("arr"),
      If(Compare(Name("value"), CmpOp("<", Int(0))),
        Assign(Name("total"), BinOp("-", Name("total"), Name("value")))
        Assign(Name("sign"), BinOp("-", Int(0), Name("sign"))),
        Assign(Name("total"), BinOp("+", Name("total"), Name("value")))
        If(Compare(Name("value"), CmpOp("==", Int(0))),
          Assign(Name("sign"), Int(0)),
          )))
    Return(BinOp("*", Name("total"), Name("sign"))))
  Assert(
    Compare(
      Call(
        Name("prod_signs"),
        ListExpr(Int(1), Int(2), Int(2), UnaryOp("-", Int(4)))),
      CmpOp("==", UnaryOp("-", Int(9)))))
  Assert(
    Compare(
      Call(Name("prod_signs"), ListExpr(Int(0), Int(1))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("prod_signs"), ListExpr()), CmpOp("is", NoneVal)))
  Assert(
    Compare(
      Call(
        Name("prod_signs"),
        ListExpr(UnaryOp("-", Int(2)), UnaryOp("-", Int(3)))),
      CmpOp("==", Int(5))))
  Assert(
    Compare(
      Call(
        Name("prod_signs"),
        ListExpr(UnaryOp("-", Int(2)), Int(0), UnaryOp("-", Int(3)))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("prod_signs"), ListExpr(Int(5))),
      CmpOp("==", Int(5))))
  Assert(
    Compare(
      Call(Name("prod_signs"), ListExpr(UnaryOp("-", Int(5)))),
      CmpOp("==", UnaryOp("-", Int(5))))))
