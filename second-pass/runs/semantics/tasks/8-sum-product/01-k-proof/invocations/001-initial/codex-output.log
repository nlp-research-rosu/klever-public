+++ b/spec.k
@@ -0,0 +1,60 @@
+requires "verification.k"
+
+module SUM-PRODUCT-SPEC
+  imports SUM-PRODUCT-VERIFICATION
+
+  // Generalized loop invariant.  It states both accumulator equations and
+  // tracks the loop target so the circularity matches the next iteration.
+  claim [loop-correct]:
+    <k>
+      #loop(list(intVals(IS)), Name("number"), sumProductLoopBody)
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(GLOBAL:Map, parent(-1))
+      1 |-> scope(
+        "numbers" |-> INPUT:Val
+        "total" |-> SUM:Int
+        "product" |-> PRODUCT:Int
+        "number" |-> CURRENT:Int,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(GLOBAL, parent(-1))
+      1 |-> scope(
+        "numbers" |-> INPUT
+        "total" |-> SUM +Int intSeqSum(IS)
+        "product" |-> PRODUCT *Int intSeqProduct(IS)
+        "number" |-> lastInt(IS, CURRENT),
+        parent(0))
+    </scopes>
+
+  // End-to-end theorem over the exact translated module and an arbitrary
+  // finite sequence of mathematical integers.
+  claim [function-correct]:
+    <k>
+      #loadAll(sumProductModule)
+      ~> Call(Name("sum_product"), list(intVals(IS)))
+      => tuple(vCons(intSeqSum(IS),
+               vCons(intSeqProduct(IS), .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(.Map, parent(-1))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "sum_product" |-> closureVal("numbers", sumProductBody, 0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..2385f1c10005c1d2df3a888de0e578d0c5300672
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,57 @@
+requires "reference-semantics/semantics.k"
+
+module SUM-PRODUCT-VERIFICATION
+  imports MPY
+
+  // These macros are a direct transcription of solution.mpy.  Keeping the
+  // loop body separate makes the inductive claim in spec.k readable.
+  syntax Stmts ::= "sumProductLoopBody" [macro]
+  rule sumProductLoopBody
+    => AugAssign(Name("total"), "+", Name("number"))
+       AugAssign(Name("product"), "*", Name("number"))
+       .Stmts
+
+  syntax Stmts ::= "sumProductBody" [macro]
+  rule sumProductBody
+    => Expr(Str("Return the sum and product of all integers in numbers."))
+       Assign(Name("total"), Int(0))
+       Assign(Name("product"), Int(1))
+       Assign(Name("number"), Int(0))
+       For(Name("number"), Name("numbers"), sumProductLoopBody)
+       Return(TupleExpr(Name("total"), Name("product")))
+       .Stmts
+
+  syntax Module ::= "sumProductModule" [macro]
+  rule sumProductModule
+    => Module(
+         ImportFrom("typing", "List", "Tuple")
+         FuncDef("sum_product", Params("numbers"), sumProductBody)
+         .Stmts)
+
+  // IntSeq is used as the induction carrier.  intVals embeds it into the
+  // Python value sequence consumed by the supplied list iterator semantics.
+  syntax ValSeq ::= intVals(IntSeq)
+  rule intVals(.IntSeq) => .ValSeq [anywhere]
+  rule intVals(iCons(I:Int, IS:IntSeq)) => vCons(I, intVals(IS)) [anywhere]
+
+  // Constructor-specialized iterator equations expose the IntSeq induction
+  // cases to symbolic execution.  They are direct consequences of intVals
+  // and MPY-LIST's two #iterNext rules.
+  rule <k> #iterNext(list(intVals(.IntSeq))) => #iterDone ... </k>
+       [priority(40)]
+  rule <k> #iterNext(list(intVals(iCons(I:Int, IS:IntSeq))))
+        => #iterYield(I, list(intVals(IS))) ... </k>
+       [priority(40)]
+
+  syntax Int ::= intSeqSum(IntSeq) [function, total]
+  rule intSeqSum(.IntSeq) => 0
+  rule intSeqSum(iCons(I:Int, IS:IntSeq)) => I +Int intSeqSum(IS)
+
+  syntax Int ::= intSeqProduct(IntSeq) [function, total]
+  rule intSeqProduct(.IntSeq) => 1
+  rule intSeqProduct(iCons(I:Int, IS:IntSeq)) => I *Int intSeqProduct(IS)
+
+  syntax Int ::= lastInt(IntSeq, Int) [function, total]
+  rule lastInt(.IntSeq, CURRENT:Int) => CURRENT
+  rule lastInt(iCons(I:Int, IS:IntSeq), _:Int) => lastInt(IS, I)
+endmodule

codex
The first symbolic attempt exposed a useful K-specific issue: a functional embedding hides the list constructor from the prover, so it cannot perform structural case splitting. I’m switching the invariant to quantify directly over the semantics’ native `ValSeq` and to specify the exact left folds performed by the program. That is both stronger (all native list values, hence all integer lists) and structurally aligned with `#iterNext`.
apply patch
