diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..48cd9ff908273729774c11404f2a6acfe1d84fc1
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,42 @@
+requires "reference-semantics/semantics.k"
+
+module SUM-PRODUCT-VERIFICATION
+  imports MPY
+
+  // These macros are a direct transcription of solution.mpy.  Keeping the
+  // loop body separate makes the inductive claim in spec.k readable.
+  syntax Stmts ::= "sumProductLoopBody" [macro]
+  rule sumProductLoopBody
+    => AugAssign(Name("total"), "+", Name("number"))
+       AugAssign(Name("product"), "*", Name("number"))
+       .Stmts
+
+  syntax Stmts ::= "sumProductBody" [macro]
+  rule sumProductBody
+    => Expr(Str("Return the sum and product of all integers in numbers."))
+       Assign(Name("total"), Int(0))
+       Assign(Name("product"), Int(1))
+       Assign(Name("number"), Int(0))
+       For(Name("number"), Name("numbers"), sumProductLoopBody)
+       Return(TupleExpr(Name("total"), Name("product")))
+       .Stmts
+
+  syntax Module ::= "sumProductModule" [macro]
+  rule sumProductModule
+    => Module(
+         ImportFrom("typing", "List", "Tuple")
+         FuncDef("sum_product", Params("numbers"), sumProductBody)
+         .Stmts)
+
+  // The result is specified as the exact left fold performed by AugAssign.
+  // On integer elements, MPY-INT reduces applyBin("+", ...) and
+  // applyBin("*", ...) to mathematical integer addition and multiplication.
+  syntax Val ::= foldBin(String, Val, ValSeq) [function, total]
+  rule foldBin(_:String, ACC:Val, .ValSeq) => ACC
+  rule foldBin(OP:String, ACC:Val, vCons(V:Val, VS:ValSeq))
+    => foldBin(OP, applyBin(OP, ACC, V), VS)
+
+  syntax Val ::= lastVal(ValSeq, Val) [function, total]
+  rule lastVal(.ValSeq, CURRENT:Val) => CURRENT
+  rule lastVal(vCons(V:Val, VS:ValSeq), _:Val) => lastVal(VS, V)
+endmodule

exec
/bin/bash -lc 'kompile verification.k --backend haskell --main-module SUM-PRODUCT-VERIFICATION --syntax-module MPY-SYNTAX --output-definition verification-kompiled' in /work
