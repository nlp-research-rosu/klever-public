+requires "reference-semantics/semantics.k"
+
+module SUM-PRODUCT-VERIFICATION
+  imports MPY
+
+  // These macros are a direct transcription of solution.mpy.  Keeping the
+  // loop body separate makes the inductive claim in spec.k readable.
+  syntax Stmts ::= "sumProductLoopBody" [macro]
+  rule sumProductLoopBody
+    => AugAssign(Name("total"), "+", Name("number"))
+       AugAssign(Name("product"), "*", Name("number"))
+       .Stmts
+
+  syntax Stmts ::= "sumProductBody" [macro]
+  rule sumProductBody
+    => Expr(Str("Return the sum and product of all integers in numbers."))
+       Assign(Name("total"), Int(0))
+       Assign(Name("product"), Int(1))
+       Assign(Name("number"), Int(0))
+       For(Name("number"), Name("numbers"), sumProductLoopBody)
+       Return(TupleExpr(Name("total"), Name("product")))
+       .Stmts
+
+  syntax Module ::= "sumProductModule" [macro]
+  rule sumProductModule
+    => Module(
+         ImportFrom("typing", "List", "Tuple")
+         FuncDef("sum_product", Params("numbers"), sumProductBody)
+         .Stmts)
+
+  // The claim's precondition recognizes exactly the ValSeq values whose
+  // elements are integers.  It lets symbolic execution refine a generic Val
+  // yielded by #iterNext to an Int before the arithmetic rules fire.
+  syntax Bool ::= allInts(ValSeq) [function, total]
+  rule allInts(.ValSeq) => true
+  rule allInts(vCons(_:Int, VS:ValSeq)) => allInts(VS)
+  rule allInts(_:ValSeq) => false [owise]
+
+  // Mathematical left folds matching the two accumulator updates.
+  syntax Int ::= sumFrom(Int, ValSeq) [function]
+  rule sumFrom(ACC:Int, .ValSeq) => ACC
+  rule sumFrom(ACC:Int, vCons(I:Int, VS:ValSeq))
+    => sumFrom(ACC +Int I, VS)
+
+  syntax Int ::= productFrom(Int, ValSeq) [function]
+  rule productFrom(ACC:Int, .ValSeq) => ACC
+  rule productFrom(ACC:Int, vCons(I:Int, VS:ValSeq))
+    => productFrom(ACC *Int I, VS)
+
+  syntax Int ::= lastIntVal(ValSeq, Int) [function]
+  rule lastIntVal(.ValSeq, CURRENT:Int) => CURRENT
+  rule lastIntVal(vCons(I:Int, VS:ValSeq), _:Int) => lastIntVal(VS, I)
+endmodule

