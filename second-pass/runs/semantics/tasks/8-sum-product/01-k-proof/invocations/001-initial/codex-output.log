+module SUM-PRODUCT-SPEC
+  imports SUM-PRODUCT-VERIFICATION
+
+  // Generalized loop invariant.  It states both accumulator equations and
+  // tracks the loop target so the circularity matches the next iteration.
+  claim [loop-correct]:
+    <k>
+      #loop(list(VS), Name("number"), sumProductLoopBody)
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(GLOBAL:Map, parent(-1))
+      1 |-> scope(
+        "numbers" |-> INPUT:Val
+        "total" |-> SUM:Int
+        "product" |-> PRODUCT:Int
+        "number" |-> CURRENT:Int,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(GLOBAL, parent(-1))
+      1 |-> scope(
+        "numbers" |-> INPUT
+        "total" |-> sumFrom(SUM, VS)
+        "product" |-> productFrom(PRODUCT, VS)
+        "number" |-> lastIntVal(VS, CURRENT),
+        parent(0))
+    </scopes>
+    requires allInts(VS)
+
+  // End-to-end theorem over the exact translated module and an arbitrary
+  // finite sequence of mathematical integers.
+  claim [function-correct]:
+    <k>
+      #loadAll(sumProductModule)
+      ~> Call(Name("sum_product"), list(VS))
+      => tuple(vCons(sumFrom(0, VS),
+               vCons(productFrom(1, VS), .ValSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(.Map, parent(-1))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "sum_product" |-> closureVal("numbers", sumProductBody, 0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
