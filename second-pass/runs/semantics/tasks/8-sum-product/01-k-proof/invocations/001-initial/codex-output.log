+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(GLOBAL:Map, parent(-1))
+      1 |-> scope(
+        "numbers" |-> INPUT:Val
+        "total" |-> SUM:Int
+        "product" |-> PRODUCT:Int
+        "number" |-> CURRENT:Int,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(GLOBAL, parent(-1))
+      1 |-> scope(
