+      1 |-> scope(
+        "numbers" |-> INPUT:Val
+        "total" |-> SUM:Int
+        "product" |-> PRODUCT:Int
+        "number" |-> CURRENT:Int,
+        parent(0))
+      REST:Map
+      =>
+      0 |-> scope(GLOBAL, parent(-1))
+      1 |-> scope(
+        "numbers" |-> INPUT
+        "total" |-> intSeqSumFrom(SUM, IS)
+        "product" |-> intSeqProductFrom(PRODUCT, IS)
+        "number" |-> lastInt(IS, CURRENT),
+        parent(0))
+      REST
+    </scopes>
+endmodule
