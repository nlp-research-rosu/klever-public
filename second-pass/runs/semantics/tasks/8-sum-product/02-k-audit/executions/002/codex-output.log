(104, 'exec', 'const patch = "*** Begin Patch\\n*** Add File: /work/verification.k\\n+requires \\"reference-semantics/semantics.k\\"\\n+\\n+module SUM-PRODUCT-VERIFICATION\\n+  imports MPY\\n+\\n+  // These macros are a direct transcription of solution.mpy.  Keeping the\\n+  // loop body separate makes the inductive claim in spec.k readable.\\n+  syntax Stmts ::= \\"sumProductLoopBody\\"\\n+  rule sumProductLoopBody\\n+    => AugAssign(Name(\\"total\\"), \\"+\\", Name(\\"number\\"))\\n+       AugAssign(Name(\\"product\\"), \\"*\\", Name(\\"number\\"))\\n+       .Stmts\\n+    [macro]\\n+\\n+  syntax Stmts ::= \\"sumProductBody\\"\\n+  rule sumProductBody\\n+    => Expr(Str(\\"Return the sum and product of all integers in numbers.\\"))\\n+       Assign(Name(\\"total\\"), Int(0))\\n+       Assign(Name(\\"product\\"), Int(1))\\n+       Assign(Name(\\"number\\"), Int(0))\\n+       For(Name(\\"number\\"), Name(\\"numbers\\"), sumProductLoopBody)\\n+       Return(TupleExpr(Name(\\"total\\"), Name(\\"product\\")))\\n+       .Stmts\\n+    [macro]\\n+\\n+  syntax Module ::= \\"sumProductModule\\"\\n+  rule sumProductModule\\n+    => Module(\\n+         ImportFrom(\\"typing\\", \\"List\\", \\"Tuple\\")\\n+         FuncDef(\\"sum_product\\", Params(\\"numbers\\"), sumProductBody)\\n+         .Stmts)\\n+    [macro]\\n+\\n+  // IntSeq is used as the induction carrier.  intVals embeds it into the\\n+  // Python value sequence consumed by the supplied list iterator semantics.\\n+  syntax ValSeq ::= intVals(IntSeq) [function, total]\\n+  rule intVals(.IntSeq) => .ValSeq\\n+  rule intVals(iCons(I:Int, IS:IntSeq)) => vCons(I, intVals(IS))\\n+\\n+  syntax Int ::= intSeqSum(IntSeq) [function, total]\\n+  rule intSeqSum(.IntSeq) => 0\\n+  rule intSeqSum(iCons(I:Int, IS:IntSeq)) => I +Int intSeqSum(IS)\\n+\\n+  syntax Int ::= intSeqProduct(IntSeq) [function, total]\\n+  rule intSeqProduct(.IntSeq) => 1\\n+  rule intSeqProduct(iCons(I:Int, IS:IntSeq)) => I *Int intSeqProduct(IS)\\n+\\n+  syntax Int ::= lastInt(IntSeq, Int) [function, total]\\n+  rule lastInt(.IntSeq, CURRENT:Int) => CURRENT\\n+  rule lastInt(iCons(I:Int, IS:IntSeq), _:Int) => lastInt(IS, I)\\n+endmodule\\n*** Add File: /work/spec.k\\n+requires \\"verification.k\\"\\n+\\n+module SUM-PRODUCT-SPEC\\n+  imports SUM-PRODUCT-VERIFICATION\\n+\\n+  // Generalized loop invariant.  It states both accumulator equations and\\n+  // tracks the loop target so the circularity matches the next iteration.\\n+  claim [loop-correct]:\\n+    <k>\\n+      #loop(list(intVals(IS)), Name(\\"number\\"), sumProductLoopBody)\\n+      => .K\\n+    </k>\\n+    <env> 1 </env>\\n+    <scopes>\\n+      -1 |-> builtinsScope\\n+      0 |-> scope(GLOBAL:Map, parent(-1))\\n+      1 |-> scope(\\n+        \\"numbers\\" |-> INPUT:Val\\n+        \\"total\\" |-> SUM:Int\\n+        \\"product\\" |-> PRODUCT:Int\\n+        \\"number\\" |-> CURRENT:Int,\\n+        parent(0))\\n+      =>\\n+      -1 |-> builtinsScope\\n+      0 |-> scope(GLOBAL, parent(-1))\\n+      1 |-> scope(\\n+        \\"numbers\\" |-> INPUT\\n+        \\"total\\" |-> SUM +Int intSeqSum(IS)\\n+        \\"product\\" |-> PRODUCT *Int intSeqProduct(IS)\\n+        \\"number\\" |-> lastInt(IS, CURRENT),\\n+        parent(0))\\n+    </scopes>\\n+\\n+  // End-to-end theorem over the exact translated module and an arbitrary\\n+  // finite sequence of mathematical integers.\\n+  claim [function-correct]:\\n+    <k>\\n+      #loadAll(sumProductModule)\\n+      ~> Call(Name(\\"sum_product\\"), list(intVals(IS)))\\n+      => tuple(vCons(intSeqSum(IS),\\n+               vCons(intSeqProduct(IS), .ValSeq)))\\n+    </k>\\n+    <env> 0 </env>\\n+    <scopes>\\n+      -1 |-> builtinsScope\\n+      0 |-> scope(.Map, parent(-1))\\n+      =>\\n+      -1 |-> builtinsScope\\n+      0 |-> scope(\\n+        \\"sum_product\\" |-> closureVal(\\"numbers\\", sumProductBody, 0),\\n+        parent(-1))\\n+    </scopes>\\n+    <scopeLoc> 1 </scopeLoc>\\n+    <heap> .Map </heap>\\n+    <heapLoc> 0 </heapLoc>\\n+    <stack> .List </stack>\\n+    <ret> noRet </ret>\\n+    <exc> NoExc </exc>\\n+    <exit-code> 0 </exit-code>\\n+endmodule\\n*** End Patch";\ntext(await tools.apply_patch(patch));\n')
