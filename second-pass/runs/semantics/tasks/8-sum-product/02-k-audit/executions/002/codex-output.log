(191, 'exec', 'const patch = "*** Begin Patch\\n*** Update File: /work/verification.k\\n@@\\n-  // IntSeq is used as the induction carrier.  intVals embeds it into the\\n-  // Python value sequence consumed by the supplied list iterator semantics.\\n-  syntax ValSeq ::= intVals(IntSeq)\\n-  rule intVals(.IntSeq) => .ValSeq [anywhere]\\n-  rule intVals(iCons(I:Int, IS:IntSeq)) => vCons(I, intVals(IS)) [anywhere]\\n-\\n-  // Constructor-specialized iterator equations expose the IntSeq induction\\n-  // cases to symbolic execution.  They are direct consequences of intVals\\n-  // and MPY-LIST\'s two #iterNext rules.\\n-  rule <k> #iterNext(list(intVals(.IntSeq))) => #iterDone ... </k>\\n-       [priority(40)]\\n-  rule <k> #iterNext(list(intVals(iCons(I:Int, IS:IntSeq))))\\n-        => #iterYield(I, list(intVals(IS))) ... </k>\\n-       [priority(40)]\\n-\\n-  syntax Int ::= intSeqSum(IntSeq) [function, total]\\n-  rule intSeqSum(.IntSeq) => 0\\n-  rule intSeqSum(iCons(I:Int, IS:IntSeq)) => I +Int intSeqSum(IS)\\n-\\n-  syntax Int ::= intSeqProduct(IntSeq) [function, total]\\n-  rule intSeqProduct(.IntSeq) => 1\\n-  rule intSeqProduct(iCons(I:Int, IS:IntSeq)) => I *Int intSeqProduct(IS)\\n-\\n-  syntax Int ::= lastInt(IntSeq, Int) [function, total]\\n-  rule lastInt(.IntSeq, CURRENT:Int) => CURRENT\\n-  rule lastInt(iCons(I:Int, IS:IntSeq), _:Int) => lastInt(IS, I)\\n+  // The result is specified as the exact left fold performed by AugAssign.\\n+  // On integer elements, MPY-INT reduces applyBin(\\"+\\", ...) and\\n+  // applyBin(\\"*\\", ...) to mathematical integer addition and multiplication.\\n+  syntax Val ::= foldBin(String, Val, ValSeq) [function, total]\\n+  rule foldBin(_:String, ACC:Val, .ValSeq) => ACC\\n+  rule foldBin(OP:String, ACC:Val, vCons(V:Val, VS:ValSeq))\\n+    => foldBin(OP, applyBin(OP, ACC, V), VS)\\n+\\n+  syntax Val ::= lastVal(ValSeq, Val) [function, total]\\n+  rule lastVal(.ValSeq, CURRENT:Val) => CURRENT\\n+  rule lastVal(vCons(V:Val, VS:ValSeq), _:Val) => lastVal(VS, V)\\n endmodule\\n*** Update File: /work/spec.k\\n@@\\n-      #loop(list(intVals(IS)), Name(\\"number\\"), sumProductLoopBody)\\n+      #loop(list(VS), Name(\\"number\\"), sumProductLoopBody)\\n@@\\n-        \\"total\\" |-> SUM:Int\\n-        \\"product\\" |-> PRODUCT:Int\\n-        \\"number\\" |-> CURRENT:Int,\\n+        \\"total\\" |-> SUM:Val\\n+        \\"product\\" |-> PRODUCT:Val\\n+        \\"number\\" |-> CURRENT:Val,\\n@@\\n-        \\"total\\" |-> SUM +Int intSeqSum(IS)\\n-        \\"product\\" |-> PRODUCT *Int intSeqProduct(IS)\\n-        \\"number\\" |-> lastInt(IS, CURRENT),\\n+        \\"total\\" |-> foldBin(\\"+\\", SUM, VS)\\n+        \\"product\\" |-> foldBin(\\"*\\", PRODUCT, VS)\\n+        \\"number\\" |-> lastVal(VS, CURRENT),\\n@@\\n-      ~> Call(Name(\\"sum_product\\"), list(intVals(IS)))\\n-      => tuple(vCons(intSeqSum(IS),\\n-               vCons(intSeqProduct(IS), .ValSeq)))\\n+      ~> Call(Name(\\"sum_product\\"), list(VS))\\n+      => tuple(vCons(foldBin(\\"+\\", 0, VS),\\n+               vCons(foldBin(\\"*\\", 1, VS), .ValSeq)))\\n*** End Patch";\ntext(await tools.apply_patch(patch));\n')
