import json, collections, pathlib
ai=json.load(open('/audit-input.json'))
lock=json.load(open('/audit-campaign-lock.json'))
print('campaign_equal', ai['audit_campaign']==lock)
p=next(pathlib.Path('/generation-evidence/codex-trace').rglob('*.jsonl'))
outer=collections.Counter(); payload=collections.Counter(); roles=collections.Counter(); tools=collections.Counter()
commands=[]; assistant=[]
with p.open() as f:
    for n,line in enumerate(f,1):
        o=json.loads(line)
        outer[o.get('type')]+=1
        q=o.get('payload',{})
        payload[q.get('type')]+=1
        if q.get('role'): roles[q.get('role')]+=1
        if o.get('type')=='response_item':
            if q.get('type') in ('function_call','custom_tool_call'):
                tools[q.get('name') or q.get('tool_name')]+=1
                commands.append((n,q.get('name') or q.get('tool_name'),q.get('arguments') or q.get('input')))
            if q.get('type')=='message' and q.get('role')=='assistant':
                texts=[x.get('text','') for x in q.get('content',[]) if isinstance(x,dict)]
                assistant.append((n,' '.join(texts)))
print('valid_jsonl_lines',n)
print('outer_types',dict(outer))
print('payload_types',dict(payload))
print('roles',dict(roles))
print('tools',dict(tools))
print('tool_calls')
for item in commands:
    print(item)
print('assistant_messages')
for n,t in assistant:
    print(n,repr(t[:500]))
