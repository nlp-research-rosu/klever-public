from pathlib import Path
import hashlib, os, stat

def digest(root):
    root=Path(root); entries=[]; pending=[root]
    while pending:
        d=pending.pop()
        for c in os.scandir(d):
            p=Path(c.path); m=c.stat(follow_symlinks=False).st_mode; rel=p.relative_to(root).as_posix()
            if stat.S_ISDIR(m): entries.append((rel,'directory',p)); pending.append(p)
            elif stat.S_ISREG(m): entries.append((rel,'file',p))
            else: raise ValueError(p)
    h=hashlib.sha256()
    for rel,kind,p in sorted(entries):
        h.update(rel.encode()+b'\\0'+kind.encode()+b'\\0')
        if kind=='file': h.update(p.read_bytes())
    return h.hexdigest(),len(entries)
for p in ['/candidate','/candidate/reference-semantics','/reference/reference-semantics','/generation-evidence/codex-trace']:
 print(p,*digest(p))
