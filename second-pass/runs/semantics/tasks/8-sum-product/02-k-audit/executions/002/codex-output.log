(223, 'exec', 'const patch = "*** Begin Patch\\n*** Update File: /work/verification.k\\n@@\\n-  // The result is specified as the exact left fold performed by AugAssign.\\n-  // On integer elements, MPY-INT reduces applyBin(\\"+\\", ...) and\\n-  // applyBin(\\"*\\", ...) to mathematical integer addition and multiplication.\\n-  syntax Val ::= foldBin(String, Val, ValSeq) [function, total]\\n-  rule foldBin(_:String, ACC:Val, .ValSeq) => ACC\\n-  rule foldBin(OP:String, ACC:Val, vCons(V:Val, VS:ValSeq))\\n-    => foldBin(OP, applyBin(OP, ACC, V), VS)\\n-\\n-  syntax Val ::= lastVal(ValSeq, Val) [function, total]\\n-  rule lastVal(.ValSeq, CURRENT:Val) => CURRENT\\n-  rule lastVal(vCons(V:Val, VS:ValSeq), _:Val) => lastVal(VS, V)\\n+  // The claim\'s precondition recognizes exactly the ValSeq values whose\\n+  // elements are integers.  It lets symbolic execution refine a generic Val\\n+  // yielded by #iterNext to an Int before the arithmetic rules fire.\\n+  syntax Bool ::= allInts(ValSeq) [function, total]\\n+  rule allInts(.ValSeq) => true\\n+  rule allInts(vCons(_:Int, VS:ValSeq)) => allInts(VS)\\n+  rule allInts(_:ValSeq) => false [owise]\\n+\\n+  // Mathematical left folds matching the two accumulator updates.\\n+  syntax Int ::= sumFrom(Int, ValSeq) [function]\\n+  rule sumFrom(ACC:Int, .ValSeq) => ACC\\n+  rule sumFrom(ACC:Int, vCons(I:Int, VS:ValSeq))\\n+    => sumFrom(ACC +Int I, VS)\\n+\\n+  syntax Int ::= productFrom(Int, ValSeq) [function]\\n+  rule productFrom(ACC:Int, .ValSeq) => ACC\\n+  rule productFrom(ACC:Int, vCons(I:Int, VS:ValSeq))\\n+    => productFrom(ACC *Int I, VS)\\n+\\n+  syntax Int ::= lastIntVal(ValSeq, Int) [function]\\n+  rule lastIntVal(.ValSeq, CURRENT:Int) => CURRENT\\n+  rule lastIntVal(vCons(I:Int, VS:ValSeq), _:Int) => lastIntVal(VS, I)\\n endmodule\\n*** Update File: /work/spec.k\\n@@\\n-        \\"total\\" |-> SUM:Val\\n-        \\"product\\" |-> PRODUCT:Val\\n-        \\"number\\" |-> CURRENT:Val,\\n+        \\"total\\" |-> SUM:Int\\n+        \\"product\\" |-> PRODUCT:Int\\n+        \\"number\\" |-> CURRENT:Int,\\n@@\\n-        \\"total\\" |-> foldBin(\\"+\\", SUM, VS)\\n-        \\"product\\" |-> foldBin(\\"*\\", PRODUCT, VS)\\n-        \\"number\\" |-> lastVal(VS, CURRENT),\\n+        \\"total\\" |-> sumFrom(SUM, VS)\\n+        \\"product\\" |-> productFrom(PRODUCT, VS)\\n+        \\"number\\" |-> lastIntVal(VS, CURRENT),\\n         parent(0))\\n     </scopes>\\n+    requires allInts(VS)\\n@@\\n-      => tuple(vCons(foldBin(\\"+\\", 0, VS),\\n-               vCons(foldBin(\\"*\\", 1, VS), .ValSeq)))\\n+      => tuple(vCons(sumFrom(0, VS),\\n+               vCons(productFrom(1, VS), .ValSeq)))\\n@@\\n     <exc> NoExc </exc>\\n     <exit-code> 0 </exit-code>\\n+    requires allInts(VS)\\n endmodule\\n*** End Patch";\ntext(await tools.apply_patch(patch));\n')
