(264, 'exec', 'const patch = "*** Begin Patch\\n*** Update File: /work/verification.k\\n@@\\n-  // The claim\'s precondition recognizes exactly the ValSeq values whose\\n-  // elements are integers.  It lets symbolic execution refine a generic Val\\n-  // yielded by #iterNext to an Int before the arithmetic rules fire.\\n-  syntax Bool ::= allInts(ValSeq) [function, total]\\n-  rule allInts(.ValSeq) => true\\n-  rule allInts(vCons(_:Int, VS:ValSeq)) => allInts(VS)\\n-  rule allInts(_:ValSeq) => false [owise]\\n-\\n-  // A sort-specialized instance of MPY-LIST\'s cons iterator rule.  Giving it\\n-  // higher priority lets the prover split an abstract allInts sequence at an\\n-  // Int head; the generic rule still handles the empty case.\\n-  rule <k> #iterNext(list(vCons(I:Int, VS:ValSeq)))\\n-        => #iterYield(I, list(VS)) ... </k>\\n-       [priority(40)]\\n-\\n-  // Mathematical left folds matching the two accumulator updates.\\n-  syntax Int ::= sumFrom(Int, ValSeq) [function]\\n-  rule sumFrom(ACC:Int, .ValSeq) => ACC\\n-  rule sumFrom(ACC:Int, vCons(I:Int, VS:ValSeq))\\n-    => sumFrom(ACC +Int I, VS)\\n-\\n-  syntax Int ::= productFrom(Int, ValSeq) [function]\\n-  rule productFrom(ACC:Int, .ValSeq) => ACC\\n-  rule productFrom(ACC:Int, vCons(I:Int, VS:ValSeq))\\n-    => productFrom(ACC *Int I, VS)\\n-\\n-  syntax Int ::= lastIntVal(ValSeq, Int) [function]\\n-  rule lastIntVal(.ValSeq, CURRENT:Int) => CURRENT\\n-  rule lastIntVal(vCons(I:Int, VS:ValSeq), _:Int) => lastIntVal(VS, I)\\n+  // A symbolic generator for arbitrary finite sequences of Int values.  The\\n+  // two iterator rules are the constructor-specialized image of MPY-LIST\'s\\n+  // .ValSeq/vCons equations; they expose exactly two induction cases without\\n+  // adding any behavior to the Python program.\\n+  syntax ValSeq ::= intVals(IntSeq)\\n+  rule <k> #iterNext(list(intVals(.IntSeq))) => #iterDone ... </k>\\n+  rule <k> #iterNext(list(intVals(iCons(I:Int, IS:IntSeq))))\\n+        => #iterYield(I, list(intVals(IS))) ... </k>\\n+\\n+  // Mathematical left folds matching the two accumulator updates.\\n+  syntax Int ::= intSeqSumFrom(Int, IntSeq) [function, total]\\n+  rule intSeqSumFrom(ACC:Int, .IntSeq) => ACC\\n+  rule intSeqSumFrom(ACC:Int, iCons(I:Int, IS:IntSeq))\\n+    => intSeqSumFrom(ACC +Int I, IS)\\n+\\n+  syntax Int ::= intSeqProductFrom(Int, IntSeq) [function, total]\\n+  rule intSeqProductFrom(ACC:Int, .IntSeq) => ACC\\n+  rule intSeqProductFrom(ACC:Int, iCons(I:Int, IS:IntSeq))\\n+    => intSeqProductFrom(ACC *Int I, IS)\\n+\\n+  syntax Int ::= lastInt(IntSeq, Int) [function, total]\\n+  rule lastInt(.IntSeq, CURRENT:Int) => CURRENT\\n+  rule lastInt(iCons(I:Int, IS:IntSeq), _:Int) => lastInt(IS, I)\\n endmodule\\n*** Update File: /work/spec.k\\n@@\\n-      #loop(list(VS), Name(\\"number\\"), sumProductLoopBody)\\n+      #loop(list(intVals(IS)), Name(\\"number\\"), sumProductLoopBody)\\n@@\\n-        \\"total\\" |-> sumFrom(SUM, VS)\\n-        \\"product\\" |-> productFrom(PRODUCT, VS)\\n-        \\"number\\" |-> lastIntVal(VS, CURRENT),\\n+        \\"total\\" |-> intSeqSumFrom(SUM, IS)\\n+        \\"product\\" |-> intSeqProductFrom(PRODUCT, IS)\\n+        \\"number\\" |-> lastInt(IS, CURRENT),\\n         parent(0))\\n     </scopes>\\n-    requires allInts(VS)\\n@@\\n-      ~> Call(Name(\\"sum_product\\"), list(VS))\\n-      => tuple(vCons(sumFrom(0, VS),\\n-               vCons(productFrom(1, VS), .ValSeq)))\\n+      ~> Call(Name(\\"sum_product\\"), list(intVals(IS)))\\n+      => tuple(vCons(intSeqSumFrom(0, IS),\\n+               vCons(intSeqProductFrom(1, IS), .ValSeq)))\\n@@\\n-    requires allInts(VS)\\n endmodule\\n*** End Patch";\ntext(await tools.apply_patch(patch));\n')
