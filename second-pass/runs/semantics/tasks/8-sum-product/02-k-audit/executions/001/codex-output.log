+
+printf '\nCONCRETE_DEFINITION_AND_EXECUTION\n'
+run kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
