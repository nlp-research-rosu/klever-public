new file mode 100644
index 0000000000000000000000000000000000000000..a1821ee89db52b24891f0567d6af0805578947e7
--- /dev/null
+++ b/evidence/bridge-enabled-spec.k
@@ -0,0 +1,46 @@
+requires "verification.k"
+
+module LOOP-BRIDGE-ENABLED-WITNESS
+  imports SUM-PRODUCT-LEMMA
+
+  // Deliberately false sensitivity claim over the same state as
+  // bridge-fixed-spec.k. The promoted rule requires <env> 1, so it must not
+  // fabricate scope-1 updates when <env> is 0. Expected result: proof failure
+  // with the fixed scope-0 updates visible in the residual.
+  claim [bridge-env-zero]:
+    <k>
+      #loop(
+        list(intVals(iCons(2, .IntSeq))),
+        Name("number"),
+        sumProductLoopBody)
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "total" |-> 100
+        "product" |-> 7
+        "number" |-> 9,
+        parent(-1))
+      1 |-> scope(
+        "numbers" |-> list(intVals(iCons(2, .IntSeq)))
+        "total" |-> 0
+        "product" |-> 1
+        "number" |-> 0,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "total" |-> 100
+        "product" |-> 7
+        "number" |-> 9,
+        parent(-1))
+      1 |-> scope(
+        "numbers" |-> list(intVals(iCons(2, .IntSeq)))
+        "total" |-> 2
+        "product" |-> 2
+        "number" |-> 2,
+        parent(0))
+    </scopes>
+endmodule
diff --git a/evidence/bridge-fixed-spec.k b/evidence/bridge-fixed-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..130e3472a642c284383f430b6cfbd2e9ca3f181c
--- /dev/null
+++ b/evidence/bridge-fixed-spec.k
@@ -0,0 +1,45 @@
+requires "verification.k"
+
+module LOOP-BRIDGE-FIXED-WITNESS
+  imports SUM-PRODUCT-VERIFICATION
+
+  // One-element integer input, but an environment value admitted by the
+  // promoted lemma and excluded by the proved loop claim. Under fixed
+  // semantics, target binding and AugAssign update scope 0.
+  claim [fixed-env-zero]:
+    <k>
+      #loop(
+        list(intVals(iCons(2, .IntSeq))),
+        Name("number"),
+        sumProductLoopBody)
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "total" |-> 100
+        "product" |-> 7
+        "number" |-> 9,
+        parent(-1))
+      1 |-> scope(
