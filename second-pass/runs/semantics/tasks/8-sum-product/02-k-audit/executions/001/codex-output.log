@@ -0,0 +1,45 @@
+requires "verification.k"
+
+module LOOP-BRIDGE-FIXED-WITNESS
+  imports SUM-PRODUCT-VERIFICATION
+
+  // One-element integer input, but an environment value admitted by the
+  // promoted lemma and excluded by the proved loop claim. Under fixed
+  // semantics, target binding and AugAssign update scope 0.
+  claim [fixed-env-zero]:
+    <k>
+      #loop(
+        list(intVals(iCons(2, .IntSeq))),
+        Name("number"),
+        sumProductLoopBody)
+      => .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "total" |-> 100
+        "product" |-> 7
+        "number" |-> 9,
+        parent(-1))
+      1 |-> scope(
+        "numbers" |-> list(intVals(iCons(2, .IntSeq)))
+        "total" |-> 0
+        "product" |-> 1
+        "number" |-> 0,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "total" |-> 102
+        "product" |-> 14
+        "number" |-> 2,
+        parent(-1))
+      1 |-> scope(
+        "numbers" |-> list(intVals(iCons(2, .IntSeq)))
+        "total" |-> 0
+        "product" |-> 1
+        "number" |-> 0,
+        parent(0))
+    </scopes>
+endmodule
diff --git a/evidence/bridge-universal-spec.k b/evidence/bridge-universal-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f88f715b7e4d800b6c4a30c84e7443400f680ac1
--- /dev/null
+++ b/evidence/bridge-universal-spec.k
@@ -0,0 +1,35 @@
+requires "verification.k"
+
+module LOOP-BRIDGE-UNIVERSAL-CONNECTION
+  imports SUM-PRODUCT-VERIFICATION
+
+  // Auditor-authored bridge-free connection theorem over the promoted rule's
+  // complete match domain, including arbitrary disjoint REST scopes and an
+  // arbitrary continuation.
+  claim [loop-with-framed-scopes]:
+    <k>
+      #loop(list(intVals(IS)), Name("number"), sumProductLoopBody)
+      ~> CONT:K
+      => CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      0 |-> scope(GLOBAL:Map, parent(-1))
+      1 |-> scope(
+        "numbers" |-> INPUT:Val
+        "total" |-> SUM:Int
+        "product" |-> PRODUCT:Int
+        "number" |-> CURRENT:Int,
+        parent(0))
+      REST:Map
+      =>
+      0 |-> scope(GLOBAL, parent(-1))
+      1 |-> scope(
+        "numbers" |-> INPUT
+        "total" |-> intSeqSumFrom(SUM, IS)
+        "product" |-> intSeqProductFrom(PRODUCT, IS)
+        "number" |-> lastInt(IS, CURRENT),
+        parent(0))
+      REST
+    </scopes>
+endmodule
