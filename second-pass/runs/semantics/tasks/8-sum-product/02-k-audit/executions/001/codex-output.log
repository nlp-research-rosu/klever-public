     1	requires "reference-semantics/semantics.k"
     2	
     3	module SUM-PRODUCT-VERIFICATION
     4	  imports MPY
     5	
     6	  // These macros are a direct transcription of solution.mpy.  Keeping the
     7	  // loop body separate makes the inductive claim in spec.k readable.
     8	  syntax Stmts ::= "sumProductLoopBody" [macro]
     9	  rule sumProductLoopBody
    10	    => AugAssign(Name("total"), "+", Name("number"))
    11	       AugAssign(Name("product"), "*", Name("number"))
    12	       .Stmts
    13	
    14	  syntax Stmts ::= "sumProductBody" [macro]
    15	  rule sumProductBody
    16	    => Expr(Str("Return the sum and product of all integers in numbers."))
    17	       Assign(Name("total"), Int(0))
    18	       Assign(Name("product"), Int(1))
    19	       Assign(Name("number"), Int(0))
    20	       For(Name("number"), Name("numbers"), sumProductLoopBody)
    21	       Return(TupleExpr(Name("total"), Name("product")))
    22	       .Stmts
    23	
    24	  syntax Module ::= "sumProductModule" [macro]
    25	  rule sumProductModule
    26	    => Module(
    27	         ImportFrom("typing", "List", "Tuple")
    28	         FuncDef("sum_product", Params("numbers"), sumProductBody)
    29	         .Stmts)
    30	
    31	  // A symbolic generator for arbitrary finite sequences of Int values.  The
    32	  // two iterator rules are the constructor-specialized image of MPY-LIST's
    33	  // .ValSeq/vCons equations; they expose exactly two induction cases without
    34	  // adding any behavior to the Python program.
    35	  syntax ValSeq ::= intVals(IntSeq)
    36	  rule <k> #iterNext(list(intVals(.IntSeq))) => #iterDone ... </k>
    37	  rule <k> #iterNext(list(intVals(iCons(I:Int, IS:IntSeq))))
    38	        => #iterYield(I, list(intVals(IS))) ... </k>
    39	
    40	  // Mathematical left folds matching the two accumulator updates.
    41	  syntax Int ::= intSeqSumFrom(Int, IntSeq) [function, total]
    42	  rule intSeqSumFrom(ACC:Int, .IntSeq) => ACC
    43	  rule intSeqSumFrom(ACC:Int, iCons(I:Int, IS:IntSeq))
    44	    => intSeqSumFrom(ACC +Int I, IS)
    45	
    46	  syntax Int ::= intSeqProductFrom(Int, IntSeq) [function, total]
    47	  rule intSeqProductFrom(ACC:Int, .IntSeq) => ACC
    48	  rule intSeqProductFrom(ACC:Int, iCons(I:Int, IS:IntSeq))
    49	    => intSeqProductFrom(ACC *Int I, IS)
    50	
    51	  syntax Int ::= lastInt(IntSeq, Int) [function, total]
    52	  rule lastInt(.IntSeq, CURRENT:Int) => CURRENT
    53	  rule lastInt(iCons(I:Int, IS:IntSeq), _:Int) => lastInt(IS, I)
    54	endmodule
    55	
    56	// This module promotes the separately proved loop claim to a rewrite lemma
    57	// for the end-to-end proof.  prove.sh first closes the same statement as a
    58	// claim against SUM-PRODUCT-VERIFICATION, then compiles this staging module.
    59	module SUM-PRODUCT-LEMMA
    60	  imports SUM-PRODUCT-VERIFICATION
    61	
    62	  rule
    63	    <k>
    64	      #loop(list(intVals(IS)), Name("number"), sumProductLoopBody)
    65	      ~> CONT:K
    66	      => CONT
    67	    </k>
    68	    <env> 1 </env>
    69	    <scopes>
    70	      0 |-> scope(GLOBAL:Map, parent(-1))
    71	      1 |-> scope(
    72	        "numbers" |-> INPUT:Val
    73	        "total" |-> SUM:Int
    74	        "product" |-> PRODUCT:Int
    75	        "number" |-> CURRENT:Int,
    76	        parent(0))
    77	      REST:Map
    78	      =>
    79	      0 |-> scope(GLOBAL, parent(-1))
    80	      1 |-> scope(
    81	        "numbers" |-> INPUT
    82	        "total" |-> intSeqSumFrom(SUM, IS)
    83	        "product" |-> intSeqProductFrom(PRODUCT, IS)
    84	        "number" |-> lastInt(IS, CURRENT),
    85	        parent(0))
    86	      REST
    87	    </scopes>
    88	    [priority(40)]
    89	endmodule

diff --git a/evidence/01_integrity.sh b/evidence/01_integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..d92e74c6a299f9c136c0df84abfd1328624c5606
--- /dev/null
+++ b/evidence/01_integrity.sh
@@ -0,0 +1,59 @@
+#!/usr/bin/env bash
+set -u
+
+CAND=/candidate
+REF=/reference
+
+run() {
+  printf '\nCOMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  rc=$?
+  printf 'EXIT_STATUS: %d\n' "$rc"
+  return 0
+}
+
+printf 'PROVENANCE_REQUIRED_FILES\n'
+for name in run-input.json metrics.json codex-last.txt codex-output.log; do
+  if [[ -e "$CAND/$name" || -L "$CAND/$name" ]]; then
+    stat -c '%F %n' "$CAND/$name"
+  else
+    printf 'MISSING %s\n' "$CAND/$name"
+  fi
+done
+
+printf '\nSTRUCTURED_TRACE_CANDIDATES\n'
+find "$CAND" -maxdepth 2 \( -iname '*trace*' -o -iname '*.jsonl' \) \
+  -printf '%y %p -> %l\n' | sort
+
+printf '\nFULL_CANDIDATE_INVENTORY\n'
+find "$CAND" -printf '%y %p -> %l\n' | sort
+
+printf '\nREFERENCE_INVENTORY\n'
+find "$REF" -printf '%y %p -> %l\n' | sort
+
+printf '\nSYMLINK_CHECKS\n'
+run find "$CAND/reference-semantics" -type l -printf '%p -> %l\n'
+run find "$REF/reference-semantics" -type l -printf '%p -> %l\n'
+
+printf '\nSEMANTICS_TREE_COMPARISON\n'
+run diff -ruN --no-dereference "$REF/reference-semantics" "$CAND/reference-semantics"
+
+printf '\nPROMPT_AND_TRANSLATOR_COMPARISONS\n'
+run cmp "$REF/prompt.py" "$CAND/prompt.py"
+run cmp "$REF/py2mpy.py" "$CAND/py2mpy.py"
+
+printf '\nSOURCE_TYPES\n'
+run stat -c '%F %a %n' \
+  "$CAND/prompt.py" "$CAND/py2mpy.py" "$CAND/solution.py" \
+  "$CAND/solution.mpy" "$CAND/spec.k" "$CAND/verification.k" \
+  "$CAND/reference-semantics" "$REF/prompt.py" "$REF/py2mpy.py" \
+  "$REF/canonical.py" "$REF/reference-semantics"
+
+printf '\nSOURCE_HASHES\n'
+run sha256sum \
+  "$REF/prompt.py" "$CAND/prompt.py" \
+  "$REF/py2mpy.py" "$CAND/py2mpy.py" \
+  "$REF/canonical.py" "$CAND/solution.py" "$CAND/solution.mpy" \
+  "$CAND/spec.k" "$CAND/verification.k"
