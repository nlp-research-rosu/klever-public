+printf 'TOOLCHAIN\n'
+run kompile --version
+run kprove --version
+run krun --version
+
+printf '\nCLEANNESS_BEFORE_BUILD\n'
+run find "$WORK" -maxdepth 1 -type d -name '*-kompiled' -print
