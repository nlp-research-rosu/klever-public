+printf 'COMMAND: kast sum-product-macro.mpy --definition verification-kompiled --sort Module --output kore > proof-macro-term.kore\n'
+kast sum-product-macro.mpy --definition verification-kompiled --sort Module --output kore \
+  > proof-macro-term.kore
+rc=$?
