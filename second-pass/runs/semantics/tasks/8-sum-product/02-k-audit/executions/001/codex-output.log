+  return 0
+}
+
+printf 'PROVENANCE_REQUIRED_FILES\n'
+for name in run-input.json metrics.json codex-last.txt codex-output.log; do
+  if [[ -e "$CAND/$name" || -L "$CAND/$name" ]]; then
+    stat -c '%F %n' "$CAND/$name"
+  else
+    printf 'MISSING %s\n' "$CAND/$name"
+  fi
+done
