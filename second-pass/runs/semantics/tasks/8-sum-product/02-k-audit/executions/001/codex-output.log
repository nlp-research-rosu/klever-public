+        "number" |-> 0,
+        parent(0))
+      =>
+      -1 |-> builtinsScope
+      0 |-> scope(
+        "total" |-> 100
+        "product" |-> 7
+        "number" |-> 9,
+        parent(-1))
+      1 |-> scope(
+        "numbers" |-> list(intVals(iCons(2, .IntSeq)))
