Module(
  FuncDef("_roman_thousands", Params("digit"),
    Return(Subscript(TupleExpr(Str(""), Str("m")), Name("digit"))))
  FuncDef("_roman_hundreds", Params("digit"),
    Return(
      Subscript(
        TupleExpr(
          Str(""),
          Str("c"),
          Str("cc"),
          Str("ccc"),
          Str("cd"),
          Str("d"),
          Str("dc"),
          Str("dcc"),
          Str("dccc"),
          Str("cm")),
        Name("digit"))))
  FuncDef("_roman_tens", Params("digit"),
    Return(
      Subscript(
        TupleExpr(
          Str(""),
          Str("x"),
          Str("xx"),
          Str("xxx"),
          Str("xl"),
          Str("l"),
          Str("lx"),
          Str("lxx"),
          Str("lxxx"),
          Str("xc")),
        Name("digit"))))
  FuncDef("_roman_ones", Params("digit"),
    Return(
      Subscript(
        TupleExpr(
          Str(""),
          Str("i"),
          Str("ii"),
          Str("iii"),
          Str("iv"),
          Str("v"),
          Str("vi"),
          Str("vii"),
          Str("viii"),
          Str("ix")),
        Name("digit"))))
  FuncDef("int_to_mini_roman", Params("number"),
    Return(
      BinOp(
        "+",
        BinOp(
          "+",
          BinOp(
            "+",
            Call(
              Name("_roman_thousands"),
              BinOp("//", Name("number"), Int(1000))),
            Call(
              Name("_roman_hundreds"),
              BinOp(
                "//",
                BinOp("%", Name("number"), Int(1000)),
                Int(100)))),
          Call(
            Name("_roman_tens"),
            BinOp("//", BinOp("%", Name("number"), Int(100)), Int(10)))),
        Call(Name("_roman_ones"), BinOp("%", Name("number"), Int(10)))))))
