+  rule romanSpec(N)
+    => iCons(120, romanSpec(N -Int 10))
+    requires N >=Int 10 andBool N <Int 40
+
+  rule romanSpec(N)
+    => iCons(105, iCons(120, romanSpec(N -Int 9)))
