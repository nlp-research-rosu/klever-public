+
+  // Value-level forms of the four lookup tables.  They are macros so the
+  // lookup lemmas below expand to the actual tuple values produced by MPY.
+  syntax Val ::= "thousandsTable" [function]
+  syntax Val ::= "hundredsTable" [function]
+  syntax Val ::= "tensTable" [function]
+  syntax Val ::= "onesTable" [function]
+
+  rule thousandsTable
+    => tuple(
+         vCons(str(.IntSeq),
+         vCons(str(iCons(109, .IntSeq)),
+         .ValSeq)))
+
+  rule hundredsTable
+    => tuple(
+         vCons(str(.IntSeq),
+         vCons(str(iCons(99, .IntSeq)),
+         vCons(str(iCons(99, iCons(99, .IntSeq))),
