+requires "verification.k"
+
+module ROMAN-LEMMA-SPEC
+  imports ROMAN-BASE
+
+  claim [thousandsLookup]:
+    <k>
+      #digitCase(thousandsTable, D)
+      => str(thousandsDigit(D))
+    </k>
+    requires D >=Int 0 andBool D <=Int 1
+
+  claim [hundredsLookup]:
+    <k>
+      #digitCase(hundredsTable, D)
+      => str(hundredsDigit(D))
+    </k>
+    requires D >=Int 0 andBool D <=Int 9
+
+  claim [tensLookup]:
+    <k>
+      #digitCase(tensTable, D)
+      => str(tensDigit(D))
+    </k>
+    requires D >=Int 0 andBool D <=Int 9
+
+  claim [onesLookup]:
+    <k>
+      #digitCase(onesTable, D)
+      => str(onesDigit(D))
+    </k>
+    requires D >=Int 0 andBool D <=Int 9
+
+  claim [thousandsIndexRange]:
+    <k> #checkThousandsIndex(N) => true </k>
+    requires N >=Int 1 andBool N <=Int 1000
+
+  claim [hundredsIndexRange]:
+    <k> #checkHundredsIndex(N) => true </k>
+    requires N >=Int 1 andBool N <=Int 1000
+
+  claim [tensIndexRange]:
+    <k> #checkTensIndex(N) => true </k>
+    requires N >=Int 1 andBool N <=Int 1000
+
+  claim [onesIndexRange]:
+    <k> #checkOnesIndex(N) => true </k>
+    requires N >=Int 1 andBool N <=Int 1000
+endmodule
+
+module ROMAN-SPEC
+  imports ROMAN-VERIFICATION
+
+  claim [romanCorrect]:
+    <k>
+      Call(Name("int_to_mini_roman"), Int(N))
+      => str(romanSpec(N))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "int_to_mini_roman"
+          |-> closureVal("number", romanSolutionBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 1 andBool N <=Int 1000
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b4890a44fd77d90cba6ec88ef59ce7b67d7349f0
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,244 @@
+requires "reference-semantics/semantics.k"
+
+module ROMAN-BASE
+  imports MPY
+
+  // The exact statement body emitted in solution.mpy.  Keeping it as a
+  // function makes the specification readable while still executing the
+  // translated program through the supplied MPY semantics.
+  syntax Stmts ::= "romanSolutionBody" [function]
+  rule romanSolutionBody
+    => Assign(Name("thousands"), TupleExpr(Str(""), Str("m")))
+       Assign(
+         Name("hundreds"),
+         TupleExpr(
+           Str(""), Str("c"), Str("cc"), Str("ccc"), Str("cd"),
+           Str("d"), Str("dc"), Str("dcc"), Str("dccc"), Str("cm")))
+       Assign(
+         Name("tens"),
+         TupleExpr(
+           Str(""), Str("x"), Str("xx"), Str("xxx"), Str("xl"),
+           Str("l"), Str("lx"), Str("lxx"), Str("lxxx"), Str("xc")))
+       Assign(
+         Name("ones"),
+         TupleExpr(
+           Str(""), Str("i"), Str("ii"), Str("iii"), Str("iv"),
+           Str("v"), Str("vi"), Str("vii"), Str("viii"), Str("ix")))
+       Return(
+         BinOp(
+           "+",
+           BinOp(
+             "+",
+             BinOp(
+               "+",
+               Subscript(
+                 Name("thousands"),
+                 BinOp("//", Name("number"), Int(1000))),
+               Subscript(
+                 Name("hundreds"),
+                 BinOp(
+                   "//",
+                   BinOp("%", Name("number"), Int(1000)),
+                   Int(100)))),
+             Subscript(
+               Name("tens"),
+               BinOp(
+                 "//",
+                 BinOp("%", Name("number"), Int(100)),
+                 Int(10)))),
+           Subscript(
+             Name("ones"),
+             BinOp("%", Name("number"), Int(10)))))
+
+  // Value-level forms of the four lookup tables.  They are macros so the
+  // lookup lemmas below expand to the actual tuple values produced by MPY.
+  syntax Val ::= "thousandsTable" [macro]
+  syntax Val ::= "hundredsTable" [macro]
+  syntax Val ::= "tensTable" [macro]
+  syntax Val ::= "onesTable" [macro]
+
+  rule thousandsTable
+    => tuple(
+         vCons(str(.IntSeq),
+         vCons(str(iCons(109, .IntSeq)),
+         .ValSeq)))
+
+  rule hundredsTable
+    => tuple(
+         vCons(str(.IntSeq),
+         vCons(str(iCons(99, .IntSeq)),
+         vCons(str(iCons(99, iCons(99, .IntSeq))),
+         vCons(str(iCons(99, iCons(99, iCons(99, .IntSeq)))),
+         vCons(str(iCons(99, iCons(100, .IntSeq))),
+         vCons(str(iCons(100, .IntSeq)),
+         vCons(str(iCons(100, iCons(99, .IntSeq))),
+         vCons(str(iCons(100, iCons(99, iCons(99, .IntSeq)))),
+         vCons(str(iCons(100, iCons(99, iCons(99, iCons(99, .IntSeq))))),
+         vCons(str(iCons(99, iCons(109, .IntSeq))),
+         .ValSeq)))))))))))
+
+  rule tensTable
+    => tuple(
+         vCons(str(.IntSeq),
+         vCons(str(iCons(120, .IntSeq)),
+         vCons(str(iCons(120, iCons(120, .IntSeq))),
+         vCons(str(iCons(120, iCons(120, iCons(120, .IntSeq)))),
+         vCons(str(iCons(120, iCons(108, .IntSeq))),
+         vCons(str(iCons(108, .IntSeq)),
+         vCons(str(iCons(108, iCons(120, .IntSeq))),
+         vCons(str(iCons(108, iCons(120, iCons(120, .IntSeq)))),
+         vCons(str(iCons(108, iCons(120, iCons(120, iCons(120, .IntSeq))))),
+         vCons(str(iCons(120, iCons(99, .IntSeq))),
+         .ValSeq)))))))))))
+
+  rule onesTable
+    => tuple(
+         vCons(str(.IntSeq),
+         vCons(str(iCons(105, .IntSeq)),
+         vCons(str(iCons(105, iCons(105, .IntSeq))),
+         vCons(str(iCons(105, iCons(105, iCons(105, .IntSeq)))),
+         vCons(str(iCons(105, iCons(118, .IntSeq))),
+         vCons(str(iCons(118, .IntSeq)),
+         vCons(str(iCons(118, iCons(105, .IntSeq))),
+         vCons(str(iCons(118, iCons(105, iCons(105, .IntSeq)))),
+         vCons(str(iCons(118, iCons(105, iCons(105, iCons(105, .IntSeq))))),
+         vCons(str(iCons(105, iCons(120, .IntSeq))),
+         .ValSeq)))))))))))
+
+  // Mathematical digit encodings.  These equations are the canonical Roman
+  // rules for one decimal place (subtractive forms at 4 and 9).
+  syntax IntSeq ::= thousandsDigit(Int) [function]
+                  | hundredsDigit(Int)  [function]
+                  | tensDigit(Int)      [function]
+                  | onesDigit(Int)      [function]
+
+  rule thousandsDigit(0) => .IntSeq
+  rule thousandsDigit(1) => iCons(109, .IntSeq)
+
+  rule hundredsDigit(0) => .IntSeq
+  rule hundredsDigit(1) => iCons(99, .IntSeq)
+  rule hundredsDigit(2) => iCons(99, iCons(99, .IntSeq))
+  rule hundredsDigit(3) => iCons(99, iCons(99, iCons(99, .IntSeq)))
+  rule hundredsDigit(4) => iCons(99, iCons(100, .IntSeq))
+  rule hundredsDigit(5) => iCons(100, .IntSeq)
+  rule hundredsDigit(6) => iCons(100, iCons(99, .IntSeq))
+  rule hundredsDigit(7) => iCons(100, iCons(99, iCons(99, .IntSeq)))
+  rule hundredsDigit(8) => iCons(100, iCons(99, iCons(99, iCons(99, .IntSeq))))
+  rule hundredsDigit(9) => iCons(99, iCons(109, .IntSeq))
+
+  rule tensDigit(0) => .IntSeq
+  rule tensDigit(1) => iCons(120, .IntSeq)
+  rule tensDigit(2) => iCons(120, iCons(120, .IntSeq))
+  rule tensDigit(3) => iCons(120, iCons(120, iCons(120, .IntSeq)))
+  rule tensDigit(4) => iCons(120, iCons(108, .IntSeq))
+  rule tensDigit(5) => iCons(108, .IntSeq)
+  rule tensDigit(6) => iCons(108, iCons(120, .IntSeq))
+  rule tensDigit(7) => iCons(108, iCons(120, iCons(120, .IntSeq)))
+  rule tensDigit(8) => iCons(108, iCons(120, iCons(120, iCons(120, .IntSeq))))
+  rule tensDigit(9) => iCons(120, iCons(99, .IntSeq))
+
+  rule onesDigit(0) => .IntSeq
+  rule onesDigit(1) => iCons(105, .IntSeq)
+  rule onesDigit(2) => iCons(105, iCons(105, .IntSeq))
+  rule onesDigit(3) => iCons(105, iCons(105, iCons(105, .IntSeq)))
+  rule onesDigit(4) => iCons(105, iCons(118, .IntSeq))
+  rule onesDigit(5) => iCons(118, .IntSeq)
+  rule onesDigit(6) => iCons(118, iCons(105, .IntSeq))
+  rule onesDigit(7) => iCons(118, iCons(105, iCons(105, .IntSeq)))
+  rule onesDigit(8) => iCons(118, iCons(105, iCons(105, iCons(105, .IntSeq))))
+  rule onesDigit(9) => iCons(105, iCons(120, .IntSeq))
+
+  syntax Int ::= "thousandsIndex" "(" Int ")" [macro]
+               | "hundredsIndex" "(" Int ")"  [macro]
+               | "tensIndex" "(" Int ")"      [macro]
+               | "onesIndex" "(" Int ")"      [macro]
+
+  rule thousandsIndex(N)
+    => (N -Int pyMod(N, 1000)) /Int 1000
+
+  rule hundredsIndex(N)
+    => (pyMod(N, 1000) -Int pyMod(pyMod(N, 1000), 100)) /Int 100
+
+  rule tensIndex(N)
+    => (pyMod(N, 100) -Int pyMod(pyMod(N, 100), 10)) /Int 10
+
+  rule onesIndex(N)
+    => pyMod(N, 10)
+
+  // Canonical lowercase Roman representation, stated independently as the
+  // concatenation of the four mathematically specified decimal-place digits.
+  syntax IntSeq ::= romanSpec(Int) [function]
+  rule romanSpec(N)
+    => seqConcat(
+         seqConcat(
+           seqConcat(
+             thousandsDigit(thousandsIndex(N)),
+             hundredsDigit(hundredsIndex(N))),
+           tensDigit(tensIndex(N))),
+         onesDigit(onesIndex(N)))
+
+  // Proof driver for finite digit domains.  Unlike a function evaluation,
+  // ordinary <k>-cell rewrites narrow the symbolic digit to each constructor
+  // case.  The path condition discards cases outside each lemma's bound.
+  syntax KItem ::= #digitCase(Val, Int)
+  rule <k> #digitCase(T:Val, 0) => applyIndex(T, 0) ... </k>
+  rule <k> #digitCase(T:Val, 1) => applyIndex(T, 1) ... </k>
+  rule <k> #digitCase(T:Val, 2) => applyIndex(T, 2) ... </k>
+  rule <k> #digitCase(T:Val, 3) => applyIndex(T, 3) ... </k>
+  rule <k> #digitCase(T:Val, 4) => applyIndex(T, 4) ... </k>
+  rule <k> #digitCase(T:Val, 5) => applyIndex(T, 5) ... </k>
+  rule <k> #digitCase(T:Val, 6) => applyIndex(T, 6) ... </k>
+  rule <k> #digitCase(T:Val, 7) => applyIndex(T, 7) ... </k>
+  rule <k> #digitCase(T:Val, 8) => applyIndex(T, 8) ... </k>
+  rule <k> #digitCase(T:Val, 9) => applyIndex(T, 9) ... </k>
+
+  // Arithmetic side-condition checks used to justify specializing the finite
+  // lookup lemmas to this function's four index expressions.
+  syntax KItem ::= #checkThousandsIndex(Int)
+                 | #checkHundredsIndex(Int)
+                 | #checkTensIndex(Int)
+                 | #checkOnesIndex(Int)
+
+  rule <k> #checkThousandsIndex(N) => true ... </k>
+    requires thousandsIndex(N) >=Int 0
+     andBool thousandsIndex(N) <=Int 1
+
+  rule <k> #checkHundredsIndex(N) => true ... </k>
+    requires hundredsIndex(N) >=Int 0
+     andBool hundredsIndex(N) <=Int 9
+
+  rule <k> #checkTensIndex(N) => true ... </k>
+    requires tensIndex(N) >=Int 0
+     andBool tensIndex(N) <=Int 9
+
+  rule <k> #checkOnesIndex(N) => true ... </k>
+    requires onesIndex(N) >=Int 0
+     andBool onesIndex(N) <=Int 9
+endmodule
+
+module ROMAN-VERIFICATION
+  imports ROMAN-BASE
+
+  // These four finite-domain lookup lemmas are proved separately against
+  // ROMAN-BASE.  The main proof imports them as executable equations because
+  // the generic symbolic valSeqAt rules cannot solve a modular index directly.
+  rule applyIndex(thousandsTable, thousandsIndex(N))
+    => str(thousandsDigit(thousandsIndex(N)))
+    requires N >=Int 1 andBool N <=Int 1000
+    [simplification]
+
+  rule applyIndex(hundredsTable, hundredsIndex(N))
+    => str(hundredsDigit(hundredsIndex(N)))
+    requires N >=Int 1 andBool N <=Int 1000
+    [simplification]
+
+  rule applyIndex(tensTable, tensIndex(N))
+    => str(tensDigit(tensIndex(N)))
+    requires N >=Int 1 andBool N <=Int 1000
+    [simplification]
+
+  rule applyIndex(onesTable, onesIndex(N))
+    => str(onesDigit(onesIndex(N)))
+    requires N >=Int 1 andBool N <=Int 1000
+    [simplification]
+endmodule

