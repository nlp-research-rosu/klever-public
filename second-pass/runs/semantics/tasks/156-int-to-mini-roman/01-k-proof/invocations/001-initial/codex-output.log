@@ -0,0 +1,17 @@
+requires "verification.k"
+
+module DIAG-SPEC
+  imports ROMAN-VERIFICATION
+
+  claim <k>
+    romanSpec(N)
+    => seqConcat(
+         seqConcat(
+           seqConcat(
+             thousandsDigit(thousandsIndex(N)),
+             hundredsDigit(hundredsIndex(N))),
+           tensDigit(tensIndex(N))),
+         onesDigit(onesIndex(N)))
+  </k>
+  requires N >=Int 1 andBool N <=Int 1000
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..1f3006ec72719fefed285eb6c58e82b321acf030
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,23 @@
+def _roman_thousands(digit):
+    return ("", "m")[digit]
+
+
+def _roman_hundreds(digit):
+    return ("", "c", "cc", "ccc", "cd", "d", "dc", "dcc", "dccc", "cm")[digit]
+
+
+def _roman_tens(digit):
+    return ("", "x", "xx", "xxx", "xl", "l", "lx", "lxx", "lxxx", "xc")[digit]
+
+
+def _roman_ones(digit):
+    return ("", "i", "ii", "iii", "iv", "v", "vi", "vii", "viii", "ix")[digit]
+
+
+def int_to_mini_roman(number):
+    return (
+        _roman_thousands(number // 1000)
+        + _roman_hundreds((number % 1000) // 100)
+        + _roman_tens((number % 100) // 10)
+        + _roman_ones(number % 10)
+    )
