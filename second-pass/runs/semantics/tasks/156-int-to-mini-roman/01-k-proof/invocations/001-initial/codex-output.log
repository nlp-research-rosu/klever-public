+          |-> closureVal("digit", romanThousandsBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires D >=Int 0 andBool D <=Int 1
+
+  claim [hundredsHelper]:
+    <k>
+      #helperCase("_roman_hundreds", D)
+      => str(hundredsDigit(D))
+    </k>
+    <env> 0 </env>
+    <scopes>
