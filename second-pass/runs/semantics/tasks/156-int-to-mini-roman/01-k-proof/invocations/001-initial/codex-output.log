+       Return(
+         BinOp(
+           "+",
+           BinOp(
+             "+",
+             BinOp(
+               "+",
+               Subscript(
+                 Name("thousands"),
+                 BinOp("//", Name("number"), Int(1000))),
+               Subscript(
+                 Name("hundreds"),
+                 BinOp(
+                   "//",
+                   BinOp("%", Name("number"), Int(1000)),
+                   Int(100)))),
+             Subscript(
+               Name("tens"),
+               BinOp(
+                 "//",
+                 BinOp("%", Name("number"), Int(100)),
+                 Int(10)))),
+           Subscript(
+             Name("ones"),
+             BinOp("%", Name("number"), Int(10)))))
