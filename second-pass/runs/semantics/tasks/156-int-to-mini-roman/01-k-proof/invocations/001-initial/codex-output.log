+    requires N >=Int 1 andBool N <=Int 1000
+    [priority(40)]
+
+  rule <k>
+         Call(
+           Name("_roman_hundreds"),
+           BinOp(
+             "//",
+             BinOp("%", Name("number"), Int(1000)),
+             Int(100)))
+         => str(hundredsDigit(hundredsIndex(N)))
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           M:Map
+           "number" |-> N:Int,
+           _)
+         ...
+       </scopes>
+    requires N >=Int 1 andBool N <=Int 1000
+    [priority(40)]
+
+  rule <k>
+         Call(
+           Name("_roman_tens"),
+           BinOp(
+             "//",
+             BinOp("%", Name("number"), Int(100)),
+             Int(10)))
+         => str(tensDigit(tensIndex(N)))
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           M:Map
+           "number" |-> N:Int,
+           _)
+         ...
+       </scopes>
+    requires N >=Int 1 andBool N <=Int 1000
+    [priority(40)]
+
+  rule <k>
+         Call(
+           Name("_roman_ones"),
+           BinOp("%", Name("number"), Int(10)))
+         => str(onesDigit(onesIndex(N)))
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           M:Map
+           "number" |-> N:Int,
+           _)
+         ...
+       </scopes>
+    requires N >=Int 1 andBool N <=Int 1000
+    [priority(40)]
+endmodule

