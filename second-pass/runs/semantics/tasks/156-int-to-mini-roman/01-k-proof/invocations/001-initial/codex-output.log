+
+  rule <k>
+         Subscript(
+           Name("hundreds"),
+           BinOp(
+             "//",
+             BinOp("%", Name("number"), Int(1000)),
+             Int(100)))
+         => str(hundredsDigit(hundredsIndex(N)))
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           M:Map
+           "number" |-> N:Int,
+           _)
+         ...
