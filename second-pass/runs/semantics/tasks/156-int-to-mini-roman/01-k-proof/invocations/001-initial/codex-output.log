new file mode 100644
index 0000000000000000000000000000000000000000..0508f9c70a2736c050804cebe21b737f653d274b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,111 @@
+requires "reference-semantics/semantics.k"
+
+module ROMAN-VERIFICATION
+  imports MPY
+
+  // The exact statement body emitted in solution.mpy.  Keeping it as a
+  // function makes the specification readable while still executing the
+  // translated program through the supplied MPY semantics.
+  syntax Stmts ::= romanSolutionBody [function]
+  rule romanSolutionBody
+    => Assign(Name("thousands"), TupleExpr(Str(""), Str("m")))
+       Assign(
+         Name("hundreds"),
+         TupleExpr(
+           Str(""), Str("c"), Str("cc"), Str("ccc"), Str("cd"),
+           Str("d"), Str("dc"), Str("dcc"), Str("dccc"), Str("cm")))
+       Assign(
+         Name("tens"),
+         TupleExpr(
+           Str(""), Str("x"), Str("xx"), Str("xxx"), Str("xl"),
+           Str("l"), Str("lx"), Str("lxx"), Str("lxxx"), Str("xc")))
+       Assign(
+         Name("ones"),
+         TupleExpr(
+           Str(""), Str("i"), Str("ii"), Str("iii"), Str("iv"),
+           Str("v"), Str("vi"), Str("vii"), Str("viii"), Str("ix")))
+       Return(
+         BinOp(
+           "+",
+           BinOp(
+             "+",
+             BinOp(
+               "+",
+               Subscript(
+                 Name("thousands"),
+                 BinOp("//", Name("number"), Int(1000))),
+               Subscript(
+                 Name("hundreds"),
+                 BinOp(
+                   "//",
+                   BinOp("%", Name("number"), Int(1000)),
+                   Int(100)))),
+             Subscript(
+               Name("tens"),
+               BinOp(
+                 "//",
+                 BinOp("%", Name("number"), Int(100)),
+                 Int(10)))),
+           Subscript(
+             Name("ones"),
+             BinOp("%", Name("number"), Int(10)))))
+
+  // Independent canonical specification: repeatedly consume the greatest
+  // Roman token that fits.  The guards are disjoint, so this defines one
+  // lowercase canonical representation for every nonnegative input.
+  syntax IntSeq ::= romanSpec(Int) [function]
+
+  rule romanSpec(N)
+    => iCons(109, romanSpec(N -Int 1000))
+    requires N >=Int 1000
+
+  rule romanSpec(N)
+    => iCons(99, iCons(109, romanSpec(N -Int 900)))
+    requires N >=Int 900 andBool N <Int 1000
+
+  rule romanSpec(N)
+    => iCons(100, romanSpec(N -Int 500))
+    requires N >=Int 500 andBool N <Int 900
+
+  rule romanSpec(N)
+    => iCons(99, iCons(100, romanSpec(N -Int 400)))
+    requires N >=Int 400 andBool N <Int 500
+
+  rule romanSpec(N)
+    => iCons(99, romanSpec(N -Int 100))
+    requires N >=Int 100 andBool N <Int 400
+
+  rule romanSpec(N)
