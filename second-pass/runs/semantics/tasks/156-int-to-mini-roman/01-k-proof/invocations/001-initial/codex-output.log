new file mode 100644
index 0000000000000000000000000000000000000000..0133a2c9b1ede4128bc9a93cb78fd9e656c330f6
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,83 @@
+requires "verification.k"
+
+module ROMAN-LEMMA-SPEC
+  imports ROMAN-BASE
+
+  claim [thousandsLookup]:
+    <k>
+      #digitCase(thousandsTable, D)
+      => str(thousandsDigit(D))
+    </k>
+    requires D >=Int 0 andBool D <=Int 1
+
+  claim [hundredsLookup]:
+    <k>
+      #digitCase(hundredsTable, D)
+      => str(hundredsDigit(D))
+    </k>
+    requires D >=Int 0 andBool D <=Int 9
+
+  claim [tensLookup]:
+    <k>
+      #digitCase(tensTable, D)
+      => str(tensDigit(D))
+    </k>
+    requires D >=Int 0 andBool D <=Int 9
+
+  claim [onesLookup]:
+    <k>
+      #digitCase(onesTable, D)
+      => str(onesDigit(D))
+    </k>
+    requires D >=Int 0 andBool D <=Int 9
+
+  claim [thousandsIndexRange]:
+    <k> #checkThousandsIndex(N) => true </k>
+    requires N >=Int 1 andBool N <=Int 1000
+
+  claim [hundredsIndexRange]:
+    <k> #checkHundredsIndex(N) => true </k>
+    requires N >=Int 1 andBool N <=Int 1000
+
+  claim [tensIndexRange]:
+    <k> #checkTensIndex(N) => true </k>
+    requires N >=Int 1 andBool N <=Int 1000
+
+  claim [onesIndexRange]:
+    <k> #checkOnesIndex(N) => true </k>
+    requires N >=Int 1 andBool N <=Int 1000
+endmodule
+
+module ROMAN-SPEC
+  imports ROMAN-VERIFICATION
+
+  claim [romanCorrect]:
+    <k>
+      Call(Name("int_to_mini_roman"), Int(N))
+      => str(romanSpec(N))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "_roman_thousands"
+          |-> closureVal("digit", romanThousandsBody, 0)
+        "_roman_hundreds"
+          |-> closureVal("digit", romanHundredsBody, 0)
+        "_roman_tens"
+          |-> closureVal("digit", romanTensBody, 0)
+        "_roman_ones"
+          |-> closureVal("digit", romanOnesBody, 0)
+        "int_to_mini_roman"
+          |-> closureVal("number", romanSolutionBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 1 andBool N <=Int 1000
+endmodule
