@@ -0,0 +1,27 @@
+requires "verification.k"
+
+module ROMAN-SPEC
+  imports ROMAN-VERIFICATION
+
+  claim [int_to_mini_roman_correct]:
+    <k>
+      Call(Name("int_to_mini_roman"), Int(N))
+      => str(romanSpec(N))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "int_to_mini_roman"
+          |-> closureVal("number", romanSolutionBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires N >=Int 1 andBool N <=Int 1000
+endmodule
