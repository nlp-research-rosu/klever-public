+           Str("v"), Str("vi"), Str("vii"), Str("viii"), Str("ix")))
+       Return(
+         BinOp(
+           "+",
+           BinOp(
+             "+",
+             BinOp(
+               "+",
+               Subscript(
+                 Name("thousands"),
