+    <k>
+      Call(Name("int_to_mini_roman"), Int(N))
+      => str(romanSpec(N))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "int_to_mini_roman"
+          |-> closureVal("number", romanSolutionBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
