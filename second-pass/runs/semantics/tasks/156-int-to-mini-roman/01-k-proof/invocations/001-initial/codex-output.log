+           "number" |-> N:Int,
+           _)
+         ...
+       </scopes>
+    requires N >=Int 1 andBool N <=Int 1000
+    [priority(40)]
+
+  rule <k>
+         Subscript(
+           Name("ones"),
+           BinOp("%", Name("number"), Int(10)))
+         => str(onesDigit(onesIndex(N)))
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           M:Map
+           "number" |-> N:Int,
+           _)
+         ...
+       </scopes>
+    requires N >=Int 1 andBool N <=Int 1000
+    [priority(40)]
+endmodule

