+         => str(hundredsDigit(hundredsIndex(N)))
+         ...
+       </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           _M:Map
+           "number" |-> N:Int,
+           _)
+         ...
