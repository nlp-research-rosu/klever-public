+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           M:Map
+           "number" |-> N:Int,
+           _)
+         ...
+       </scopes>
+    requires N >=Int 1 andBool N <=Int 1000
+    [priority(40)]
+
+  rule <k>
+         Subscript(
+           Name("tens"),
+           BinOp(
+             "//",
+             BinOp("%", Name("number"), Int(100)),
+             Int(10)))
+         => str(tensDigit(tensIndex(N)))
