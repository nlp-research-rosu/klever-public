+  claim [onesLookup]:
+    <k>
+      #digitCase(onesTable, D)
+      => str(onesDigit(D))
+    </k>
+    requires D >=Int 0 andBool D <=Int 9
+endmodule
+
+module ROMAN-SPEC
+  imports ROMAN-VERIFICATION
+
+  claim [romanCorrect]:
+    <k>
+      Call(Name("int_to_mini_roman"), Int(N))
+      => str(romanSpec(N))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "int_to_mini_roman"
+          |-> closureVal("number", romanSolutionBody, 0),
+        parent(-1))
+      -1 |-> builtinsScope
