+
+module BASE-FALSE-WITNESSES
+  imports ROMAN-BASE
+
+  claim [thousandsBaseRejectsFalse]:
+    <k>
+      Call(
+        Name("_roman_thousands"),
+        BinOp("//", Name("number"), Int(1000)))
+      => str(iCons(109, .IntSeq))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "_roman_thousands"
+          |-> closureVal("digit", Return(Str("z")) .Stmts, 0)
+        "number" |-> 1000,
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [hundredsBaseRejectsFalse]:
+    <k>
+      Call(
+        Name("_roman_hundreds"),
+        BinOp(
+          "//",
+          BinOp("%", Name("number"), Int(1000)),
+          Int(100)))
+      => str(iCons(99, .IntSeq))
+    </k>
