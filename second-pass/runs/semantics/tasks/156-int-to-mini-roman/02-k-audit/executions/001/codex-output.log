+      => str(iCons(99, .IntSeq))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "_roman_hundreds"
+          |-> closureVal("digit", Return(Str("z")) .Stmts, 0)
+        "number" |-> 100,
