+endmodule
+
+module BASE-FALSE-WITNESSES
+  imports ROMAN-BASE
+
+  claim [thousandsBaseRejectsFalse]:
+    <k>
+      Call(
+        Name("_roman_thousands"),
+        BinOp("//", Name("number"), Int(1000)))
+      => str(iCons(109, .IntSeq))
+    </k>
+    <env> 0 </env>
