+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
+
+module BASE-CORRECT-WITNESSES
+  imports ROMAN-BASE
+
