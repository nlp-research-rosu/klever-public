+  printf ' %q' "$@" >> "$MASTER"
+  printf ')\n' >> "$MASTER"
+  (
+    cd "$SCRATCH" || exit 125
+    "$@"
+  ) > "$output_log" 2>&1
+  command_status=$?
+  printf 'EXIT: %s\n' "$command_status" >> "$MASTER"
