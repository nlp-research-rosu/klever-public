### canonical.py
     1	# canonical.py — the UNMODIFIED HumanEval/36 reference solution (from the dataset).
     2	# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
     3	# explicit & auditable.  entry point: fizz_buzz
     4	
     5	
     6	
     7	def fizz_buzz(n: int):
     8	    """Return the number of times the digit 7 appears in integers less than n which are divisible by 11 or 13.
     9	    >>> fizz_buzz(50)
    10	    0
    11	    >>> fizz_buzz(78)
    12	    2
    13	    >>> fizz_buzz(79)
    14	    3
    15	    """
    16	    ns = []
    17	    for i in range(n):
    18	        if i % 11 == 0 or i % 13 == 0:
    19	            ns.append(i)
    20	    s = ''.join(list(map(str, ns)))
    21	    ans = 0
    22	    for c in s:
    23	        ans += (c == '7')
    24	    return ans
### solution.py
     1	def fizz_buzz(n: int):
     2	    count = 0
     3	    i = 0
     4	    x = 0
     5	    while i < n:
     6	        if i % 11 == 0 or i % 13 == 0:
     7	            x = i
     8	            while x > 0:
     9	                if x % 10 == 7:
    10	                    count += 1
    11	                x = x // 10
    12	        i += 1
    13	    return count
