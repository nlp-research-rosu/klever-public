@@ -0,0 +1,114 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+SCRATCH=/tmp/audit-work/reviewer-002/scratch
+MASTER=/audit-output/evidence/03-clean-reconstruction.log
+: > "$MASTER"
+
+run_logged() {
+  output_log=$1
+  shift
+  printf '$ (cd %s &&' "$SCRATCH" >> "$MASTER"
+  printf ' %q' "$@" >> "$MASTER"
+  printf ')\n' >> "$MASTER"
+  (
+    cd "$SCRATCH" || exit 125
+    "$@"
+  ) > "$output_log" 2>&1
+  command_status=$?
