+: > "$MASTER"
+
+run_logged() {
+  output_log=$1
+  shift
+  printf '$ (cd %s &&' "$SCRATCH" >> "$MASTER"
+  printf ' %q' "$@" >> "$MASTER"
+  printf ')\n' >> "$MASTER"
+  (
+    cd "$SCRATCH" || exit 125
