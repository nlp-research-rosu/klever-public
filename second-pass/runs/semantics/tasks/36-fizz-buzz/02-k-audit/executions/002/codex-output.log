    62	         "fizz_buzz",
    63	         Params("n"),
    64	         Assign(Name("count"), Int(0))
    65	         Assign(Name("i"), Int(0))
    66	         Assign(Name("x"), Int(0))
    67	         While(Compare(Name("i"), CmpOp("<", Name("n"))), OUTER-BODY)
