+#!/usr/bin/env bash
+set -uo pipefail
+
+LOG=/audit-output/evidence/01-integrity.log
+: > "$LOG"
+
+run() {
+  printf '$ %s\n' "$*" >> "$LOG"
+  "$@" >> "$LOG" 2>&1
+  status=$?
+  printf 'EXIT: %s\n\n' "$status" >> "$LOG"
+  return 0
+}
