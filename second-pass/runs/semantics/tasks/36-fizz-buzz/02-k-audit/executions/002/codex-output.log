diff --git a/evidence/01-integrity.sh b/evidence/01-integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..faa401c4bd97586c5223453fcb74aae5cb240b74
--- /dev/null
+++ b/evidence/01-integrity.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+LOG=/audit-output/evidence/01-integrity.log
+: > "$LOG"
+
+run() {
+  printf '$ %s\n' "$*" >> "$LOG"
+  "$@" >> "$LOG" 2>&1
+  status=$?
+  printf 'EXIT: %s\n\n' "$status" >> "$LOG"
+  return 0
+}
+
+run python3 /audit-output/evidence/check_integrity.py
+run python3 -m json.tool /run.json
