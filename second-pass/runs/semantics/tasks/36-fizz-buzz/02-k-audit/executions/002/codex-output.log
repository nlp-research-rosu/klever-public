+  -e 'While(' \
+  -e 'Compare(' \
+  -e CmpOp \
+  -e BinOp \
+  -e BoolOp \
+  -e 'If(' \
+  -e AugAssign \
+  -e 'Return(' \
+  -e 'Call(' \
+  /tmp/audit-work/reviewer-002/scratch/solution.mpy
