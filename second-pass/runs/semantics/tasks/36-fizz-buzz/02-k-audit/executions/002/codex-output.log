     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // A direct mathematical reading of the prompt: recursively inspect the
     7	  // base-10 digits of each selected non-negative integer.
     8	  syntax Bool ::= divisibleBy11Or13(Int) [function, total]
     9	  rule divisibleBy11Or13(I:Int)
    10	    => pyMod(I, 11) ==Int 0 orBool pyMod(I, 13) ==Int 0
    11	
    12	  syntax Int ::= countSevensAcc(Int, Int) [function]
    13	  rule countSevensAcc(A:Int, 0) => A [simplification]
    14	  rule countSevensAcc(A:Int, I:Int)
    15	    => countSevensAcc(
    16	         A +Int 1,
    17	         (I -Int pyMod(I, 10)) /Int 10)
    18	    requires I >Int 0 andBool pyMod(I, 10) ==Int 7
    19	    [simplification]
    20	  rule countSevensAcc(A:Int, I:Int)
    21	    => countSevensAcc(A, (I -Int pyMod(I, 10)) /Int 10)
    22	    requires I >Int 0 andBool pyMod(I, 10) =/=Int 7
    23	    [simplification]
    24	
    25	  // Accumulate the selected digit counts over the half-open interval [I,N).
    26	  syntax Int ::= fizzBuzzAcc(Int, Int, Int) [function]
    27	  rule fizzBuzzAcc(A:Int, I:Int, N:Int) => A
    28	    requires I >=Int N
    29	  rule fizzBuzzAcc(A:Int, I:Int, N:Int)
    30	    => fizzBuzzAcc(countSevensAcc(A, I), I +Int 1, N)
    31	    requires I <Int N andBool divisibleBy11Or13(I)
    32	  rule fizzBuzzAcc(A:Int, I:Int, N:Int)
    33	    => fizzBuzzAcc(A, I +Int 1, N)
    34	    requires I <Int N andBool notBool divisibleBy11Or13(I)
    35	
    36	  syntax Int ::= fizzBuzzSpec(Int) [function, total]
    37	  rule fizzBuzzSpec(N:Int) => fizzBuzzAcc(0, 0, N)
