+: > "$LOG"
+
+run() {
+  printf '$ %s\n' "$*" >> "$LOG"
+  "$@" >> "$LOG" 2>&1
+  status=$?
+  printf 'EXIT: %s\n\n' "$status" >> "$LOG"
+  return 0
+}
+
+run sha256sum \
+  /tmp/audit-work/reviewer-002/scratch/canonical.py \
+  /tmp/audit-work/reviewer-002/scratch/solution.py \
+  /tmp/audit-work/reviewer-002/scratch/solution.mpy \
