+#!/usr/bin/env bash
+set -uo pipefail
+
+SCRATCH=/tmp/audit-work/reviewer-002/scratch
+LOG=/audit-output/evidence/04-adequacy-pinning.log
+: > "$LOG"
+
+run() {
+  printf '$ (cd %s &&' "$SCRATCH" >> "$LOG"
+  printf ' %q' "$@" >> "$LOG"
+  printf ')\n' >> "$LOG"
+  (
+    cd "$SCRATCH" || exit 125
+    "$@"
+  ) >> "$LOG" 2>&1
