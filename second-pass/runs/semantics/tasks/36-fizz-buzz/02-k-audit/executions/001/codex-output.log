+#!/usr/bin/env python3
+"""Summarize the exhaustive rule-inventory.tsv ledger."""
+
+from __future__ import annotations
+
+import collections
+import csv
+from pathlib import Path
+
+
+rows = list(
+    csv.DictReader(
+        Path("/audit-output/evidence/rule-inventory.tsv").open(),
+        delimiter="\t",
+    )
+)
