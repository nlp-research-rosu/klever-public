diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..ec89364713d2d87298d4fc56e7085c5e1f84b9b3
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,70 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A direct mathematical reading of the prompt: count code point 55 ('7')
+  // in the decimal rendering of each selected integer.
+  syntax Bool ::= divisibleBy11Or13(Int) [function, total]
+  rule divisibleBy11Or13(I:Int)
+    => pyMod(I, 11) ==Int 0 orBool pyMod(I, 13) ==Int 0
+
+  syntax Int ::= countSevens(IntSeq) [function, total]
+  rule countSevens(.IntSeq) => 0
+  rule countSevens(iCons(C:Int, CS:IntSeq))
+    => (#if C ==Int 55 #then 1 #else 0 #fi) +Int countSevens(CS)
+
+  syntax Int ::= selectedSevens(Int) [function, total]
+  rule selectedSevens(I:Int)
+    => #if divisibleBy11Or13(I)
+       #then countSevens(strToCodes(Int2String(I)))
+       #else 0
+       #fi
+
+  // Sum selectedSevens over the half-open interval [I, N).
+  syntax Int ::= fizzBuzzFrom(Int, Int) [function]
+  rule fizzBuzzFrom(I:Int, N:Int) => 0
+    requires I >=Int N
+  rule fizzBuzzFrom(I:Int, N:Int)
+    => selectedSevens(I) +Int fizzBuzzFrom(I +Int 1, N)
+    requires I <Int N
+
+  syntax Int ::= fizzBuzzSpec(Int) [function, total]
+  rule fizzBuzzSpec(N:Int) => fizzBuzzFrom(0, N)
+
+  // Exact AST fragments emitted by py2mpy.py for solution.py.  Keeping them
+  // named makes the loop-invariant claims in spec.k readable.
+  syntax Stmts ::= "DIGIT-BODY" [macro]
+  rule DIGIT-BODY
+    => If(Compare(Name("digit"), CmpOp("==", Str("7"))),
+          AugAssign(Name("count"), "+", Int(1)) .Stmts,
+          .Stmts)
+
+  syntax Stmts ::= "OUTER-BODY" [macro]
+  rule OUTER-BODY
+    => If(BoolOp(
+            "or",
+            Compare(BinOp("%", Name("i"), Int(11)), CmpOp("==", Int(0))),
+            Compare(BinOp("%", Name("i"), Int(13)), CmpOp("==", Int(0)))),
+          For(Name("digit"), Call(Name("str"), Name("i")), DIGIT-BODY)
+            .Stmts,
+          .Stmts)
+
+  syntax Stmt ::= "FIZZ-BUZZ-DEF" [macro]
+  rule FIZZ-BUZZ-DEF
+    => FuncDef(
+         "fizz_buzz",
+         Params("n"),
+         Assign(Name("count"), Int(0))
+         For(Name("i"), Call(Name("range"), Name("n")), OUTER-BODY)
+         Return(Name("count")))
+
+  syntax Val ::= "FIZZ-BUZZ-CLOSURE" [macro]
+  rule FIZZ-BUZZ-CLOSURE
+    => closureVal(
+         "n",
+         Assign(Name("count"), Int(0))
+         For(Name("i"), Call(Name("range"), Name("n")), OUTER-BODY)
+         Return(Name("count")),
+         0)
+endmodule

