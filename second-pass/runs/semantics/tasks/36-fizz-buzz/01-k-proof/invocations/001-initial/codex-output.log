+
+module MINI
+  imports VERIFICATION
+  claim
+    <generatedTop>
+      <k> Int(1) => 1 </k>
+      <env> 0 </env>
+      <scopes> 0 |-> scope(.Map, parent(-1)) -1 |-> builtinsScope </scopes>
+      <scopeLoc> 1 </scopeLoc>
+      <heap> .Map </heap>
+      <heapLoc> 0 </heapLoc>
+      <stack> .List </stack>
+      <ret> noRet </ret>
+      <exc> NoExc </exc>
+      <exit-code> 0 </exit-code>
+    </generatedTop>
+endmodule
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..b2e270ad1d03da86af49ff17cb7ddb3da2d95c6b
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def fizz_buzz(n: int):
+    count = 0
+    i = 0
+    x = 0
+    while i < n:
+        if i % 11 == 0 or i % 13 == 0:
+            x = i
+            while x > 0:
+                if x % 10 == 7:
+                    count += 1
+                x = x // 10
+        i += 1
+    return count
