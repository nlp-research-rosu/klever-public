+      SC:Map
+      L |-> scope(
+        ("n" |-> N:Int)
+        ("count" |-> A:Int)
+        ("i" |-> I:Int)
+        ("x" |-> 0)
+        REST:Map,
+        P:Parent)
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> H:Map </heap>
