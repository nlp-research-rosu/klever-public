diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..7eb0e4d3f86bae522ecc408f812a98b3e005ed37
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,99 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inner-loop invariant.  The temporary x reaches zero, and count increases
+  // by the number of base-10 digits equal to seven in its initial value.
+  claim
+    <k>
+      #while(Compare(Name("x"), CmpOp(">", Int(0))), INNER-BODY)
+      ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ( SC:Map
+        L |-> scope(
+          ("n" |-> N:Int)
+          ("count" |-> A:Int)
+          ("i" |-> I:Int)
+          ("x" |-> X:Int),
+          P:Parent)
+      )
+      =>
+      ( SC
+        L |-> scope(
+          ("n" |-> N)
+          ("count" |-> countSevensAcc(A, X))
+          ("i" |-> I)
+          ("x" |-> 0),
+          P)
+      )
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HN:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> R:RetState </ret>
+    <exc> E:Exc </exc>
+    <exit-code> EC:Int </exit-code>
+    requires X >=Int 0
+
+  // Outer-loop invariant for the reachable interval 0 <= I <= N.  The
+  // temporary x is zero at every boundary, i advances to N, and count gains
+  // exactly the specified sum over [I,N).
+  claim
+    <k>
+      #while(Compare(Name("i"), CmpOp("<", Name("n"))), OUTER-BODY)
+      ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ( SC:Map
+        L |-> scope(
+          ("n" |-> N:Int)
+          ("count" |-> A:Int)
+          ("i" |-> I:Int)
+          ("x" |-> 0),
+          P:Parent)
+      )
+      =>
+      ( SC
+        L |-> scope(
+          ("n" |-> N)
+          ("count" |-> fizzBuzzAcc(A, I, N))
+          ("i" |-> N)
+          ("x" |-> 0),
+          P)
+      )
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HN:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> R:RetState </ret>
+    <exc> E:Exc </exc>
+    <exit-code> EC:Int </exit-code>
+    requires 0 <=Int I andBool I <=Int N
+
+  // Entry-point theorem for every integer n.  For n <= 0, the while loop is
+  // empty and fizzBuzzFrom(0,n) is zero.
+  claim
+    <k> Call(FIZZ-BUZZ-CLOSURE, N:Int) => fizzBuzzSpec(N) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4ec9edc411c947435d8a49ba8ca7af8ab66e74ae
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,83 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A direct mathematical reading of the prompt: recursively inspect the
+  // base-10 digits of each selected non-negative integer.
+  syntax Bool ::= divisibleBy11Or13(Int) [function, total]
+  rule divisibleBy11Or13(I:Int)
+    => pyMod(I, 11) ==Int 0 orBool pyMod(I, 13) ==Int 0
+
+  syntax Int ::= countSevensAcc(Int, Int) [function]
+  rule countSevensAcc(A:Int, 0) => A [simplification]
+  rule countSevensAcc(A:Int, I:Int)
+    => countSevensAcc(
+         A +Int 1,
+         (I -Int pyMod(I, 10)) /Int 10)
+    requires I >Int 0 andBool pyMod(I, 10) ==Int 7
+    [simplification]
+  rule countSevensAcc(A:Int, I:Int)
+    => countSevensAcc(A, (I -Int pyMod(I, 10)) /Int 10)
+    requires I >Int 0 andBool pyMod(I, 10) =/=Int 7
+    [simplification]
+
+  // Accumulate the selected digit counts over the half-open interval [I,N).
+  syntax Int ::= fizzBuzzAcc(Int, Int, Int) [function]
+  rule fizzBuzzAcc(A:Int, I:Int, N:Int) => A
+    requires I >=Int N
+    [simplification]
+  rule fizzBuzzAcc(A:Int, I:Int, N:Int)
+    => fizzBuzzAcc(countSevensAcc(A, I), I +Int 1, N)
+    requires I <Int N andBool divisibleBy11Or13(I)
+    [simplification]
+  rule fizzBuzzAcc(A:Int, I:Int, N:Int)
+    => fizzBuzzAcc(A, I +Int 1, N)
+    requires I <Int N andBool notBool divisibleBy11Or13(I)
+    [simplification]
+
+  syntax Int ::= fizzBuzzSpec(Int) [function, total]
+  rule fizzBuzzSpec(N:Int) => fizzBuzzAcc(0, 0, N)
+
+  // Exact AST fragments emitted by py2mpy.py for solution.py.  Keeping them
+  // named makes the loop-invariant claims in spec.k readable.
+  syntax Stmts ::= "INNER-BODY" [macro]
+  rule INNER-BODY
+    => If(Compare(BinOp("%", Name("x"), Int(10)), CmpOp("==", Int(7))),
+          AugAssign(Name("count"), "+", Int(1)) .Stmts,
+          .Stmts)
+       Assign(Name("x"), BinOp("//", Name("x"), Int(10)))
+
+  syntax Stmts ::= "OUTER-BODY" [macro]
+  rule OUTER-BODY
+    => If(BoolOp(
+            "or",
+            Compare(BinOp("%", Name("i"), Int(11)), CmpOp("==", Int(0))),
+            Compare(BinOp("%", Name("i"), Int(13)), CmpOp("==", Int(0)))),
+          Assign(Name("x"), Name("i"))
+          While(Compare(Name("x"), CmpOp(">", Int(0))), INNER-BODY),
+          .Stmts)
+       AugAssign(Name("i"), "+", Int(1))
+
+  syntax Stmt ::= "FIZZ-BUZZ-DEF" [macro]
+  rule FIZZ-BUZZ-DEF
+    => FuncDef(
+         "fizz_buzz",
+         Params("n"),
+         Assign(Name("count"), Int(0))
+         Assign(Name("i"), Int(0))
+         Assign(Name("x"), Int(0))
+         While(Compare(Name("i"), CmpOp("<", Name("n"))), OUTER-BODY)
+         Return(Name("count")))
+
+  syntax Val ::= "FIZZ-BUZZ-CLOSURE" [macro]
+  rule FIZZ-BUZZ-CLOSURE
+    => closureVal(
+         "n",
+         Assign(Name("count"), Int(0))
+         Assign(Name("i"), Int(0))
+         Assign(Name("x"), Int(0))
+         While(Compare(Name("i"), CmpOp("<", Name("n"))), OUTER-BODY)
+         Return(Name("count")),
+         0)
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..64b38c364aae97478d048d5d7356b157a4dfb2eb
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,15 @@
+def fizz_buzz(n: int):
+    count = 0
+    for i in range(n):
+        if i % 11 == 0 or i % 13 == 0:
+            for digit in str(i):
+                if digit == "7":
+                    count += 1
+    return count
+
+
+assert fizz_buzz(0) == 0
+assert fizz_buzz(50) == 0
+assert fizz_buzz(78) == 2
+assert fizz_buzz(79) == 3
+assert fizz_buzz(1000) == 47
