@@ -0,0 +1,15 @@
+def fizz_buzz(n: int):
+    count = 0
+    for i in range(n):
+        if i % 11 == 0 or i % 13 == 0:
+            for digit in str(i):
+                if digit == "7":
+                    count += 1
+    return count
+
+
+assert fizz_buzz(0) == 0
+assert fizz_buzz(50) == 0
+assert fizz_buzz(78) == 2
+assert fizz_buzz(79) == 3
+assert fizz_buzz(1000) == 47
