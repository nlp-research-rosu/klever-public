+    i = 0
+    x = 0
+    while i < n:
+        if i % 11 == 0 or i % 13 == 0:
+            x = i
+            while x > 0:
+                if x % 10 == 7:
+                    count += 1
+                x = x // 10
+        i += 1
+    return count
