+  // temporary x is zero at every boundary, i advances to N, and count gains
+  // exactly the specified sum over [I,N).
+  claim
+    <k>
+      #while(Compare(Name("i"), CmpOp("<", Name("n"))), OUTER-BODY)
+      ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ( SC:Map
+        L |-> scope(
+          ("n" |-> N:Int)
+          ("count" |-> A:Int)
+          ("i" |-> I:Int)
+          ("x" |-> 0)
+          REST:Map,
+          P:Parent)
+      )
+      =>
+      ( SC
+        L |-> scope(
+          ("n" |-> N)
+          ("count" |-> (A +Int fizzBuzzFrom(I, N)))
+          ("i" |-> N)
+          ("x" |-> 0)
+          REST,
+          P)
+      )
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HN:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> R:RetState </ret>
+    <exc> E:Exc </exc>
+    <exit-code> EC:Int </exit-code>
+    requires 0 <=Int I andBool I <=Int N
+      andBool notBool ("n" in_keys(REST))
+      andBool notBool ("count" in_keys(REST))
+      andBool notBool ("i" in_keys(REST))
+      andBool notBool ("x" in_keys(REST))
