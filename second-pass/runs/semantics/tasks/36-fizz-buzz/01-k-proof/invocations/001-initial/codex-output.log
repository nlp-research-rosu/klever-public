+      SC:Map
+      L |-> scope(
+        ("n" |-> N:Int)
+        ("count" |-> A:Int)
+        ("i" |-> I:Int)
+        ("x" |-> X:Int)
+        REST:Map,
+        P:Parent)
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HN:Int </heapLoc>
