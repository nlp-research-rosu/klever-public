--- /dev/null
+++ b/spec.k
@@ -0,0 +1,118 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Universal inner-loop theorem: for every non-negative x and every initial
+  // accumulator A, the loop adds exactly one for each base-10 digit equal to 7.
+  claim
+    <k>
+      #while(Compare(Name("x"), CmpOp(">", Int(0))), INNER-BODY)
+      ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ( SC:Map
+        L |-> scope(
+          ("n" |-> N:Int)
+          ("count" |-> A:Int)
+          ("i" |-> I:Int)
+          ("x" |-> X:Int),
+          P:Parent)
+      )
+      =>
+      ( SC
+        L |-> scope(
+          ("n" |-> N)
+          ("count" |-> countSevensAcc(A, X))
+          ("i" |-> I)
+          ("x" |-> 0),
+          P)
+      )
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HN:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> R:RetState </ret>
+    <exc> E:Exc </exc>
+    <exit-code> EC:Int </exit-code>
+    requires X >=Int 0
+
+  // Full entry-point executions from a pristine module configuration.  These
+  // include all prompt examples, the empty/negative boundary, and a wider
+  // boundary after the prompt examples.
+  claim
+    <k> Call(FIZZ-BUZZ-CLOSURE, -5) => 0 </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1)) -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim
+    <k> Call(FIZZ-BUZZ-CLOSURE, 0) => 0 </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1)) -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim
+    <k> Call(FIZZ-BUZZ-CLOSURE, 50) => 0 </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1)) -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim
+    <k> Call(FIZZ-BUZZ-CLOSURE, 78) => 2 </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1)) -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim
+    <k> Call(FIZZ-BUZZ-CLOSURE, 79) => 3 </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1)) -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim
+    <k> Call(FIZZ-BUZZ-CLOSURE, 100) => 3 </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1)) -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b48d97fbf5e6961877a67435e1e164e11d1d3d7f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,80 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A direct mathematical reading of the prompt: recursively inspect the
+  // base-10 digits of each selected non-negative integer.
+  syntax Bool ::= divisibleBy11Or13(Int) [function, total]
+  rule divisibleBy11Or13(I:Int)
+    => pyMod(I, 11) ==Int 0 orBool pyMod(I, 13) ==Int 0
+
+  syntax Int ::= countSevensAcc(Int, Int) [function]
+  rule countSevensAcc(A:Int, 0) => A [simplification]
+  rule countSevensAcc(A:Int, I:Int)
+    => countSevensAcc(
+         A +Int 1,
+         (I -Int pyMod(I, 10)) /Int 10)
+    requires I >Int 0 andBool pyMod(I, 10) ==Int 7
+    [simplification]
+  rule countSevensAcc(A:Int, I:Int)
+    => countSevensAcc(A, (I -Int pyMod(I, 10)) /Int 10)
+    requires I >Int 0 andBool pyMod(I, 10) =/=Int 7
+    [simplification]
+
+  // Accumulate the selected digit counts over the half-open interval [I,N).
+  syntax Int ::= fizzBuzzAcc(Int, Int, Int) [function]
+  rule fizzBuzzAcc(A:Int, I:Int, N:Int) => A
+    requires I >=Int N
+  rule fizzBuzzAcc(A:Int, I:Int, N:Int)
+    => fizzBuzzAcc(countSevensAcc(A, I), I +Int 1, N)
+    requires I <Int N andBool divisibleBy11Or13(I)
+  rule fizzBuzzAcc(A:Int, I:Int, N:Int)
+    => fizzBuzzAcc(A, I +Int 1, N)
+    requires I <Int N andBool notBool divisibleBy11Or13(I)
+
+  syntax Int ::= fizzBuzzSpec(Int) [function, total]
+  rule fizzBuzzSpec(N:Int) => fizzBuzzAcc(0, 0, N)
+
+  // Exact AST fragments emitted by py2mpy.py for solution.py.  Keeping them
+  // named makes the loop-invariant claims in spec.k readable.
+  syntax Stmts ::= "INNER-BODY" [macro]
+  rule INNER-BODY
+    => If(Compare(BinOp("%", Name("x"), Int(10)), CmpOp("==", Int(7))),
+          AugAssign(Name("count"), "+", Int(1)) .Stmts,
+          .Stmts)
+       Assign(Name("x"), BinOp("//", Name("x"), Int(10)))
+
+  syntax Stmts ::= "OUTER-BODY" [macro]
+  rule OUTER-BODY
+    => If(BoolOp(
+            "or",
+            Compare(BinOp("%", Name("i"), Int(11)), CmpOp("==", Int(0))),
+            Compare(BinOp("%", Name("i"), Int(13)), CmpOp("==", Int(0)))),
+          Assign(Name("x"), Name("i"))
+          While(Compare(Name("x"), CmpOp(">", Int(0))), INNER-BODY),
+          .Stmts)
+       AugAssign(Name("i"), "+", Int(1))
+
+  syntax Stmt ::= "FIZZ-BUZZ-DEF" [macro]
+  rule FIZZ-BUZZ-DEF
+    => FuncDef(
+         "fizz_buzz",
+         Params("n"),
+         Assign(Name("count"), Int(0))
+         Assign(Name("i"), Int(0))
+         Assign(Name("x"), Int(0))
+         While(Compare(Name("i"), CmpOp("<", Name("n"))), OUTER-BODY)
+         Return(Name("count")))
+
+  syntax Val ::= "FIZZ-BUZZ-CLOSURE" [macro]
+  rule FIZZ-BUZZ-CLOSURE
+    => closureVal(
+         "n",
+         Assign(Name("count"), Int(0))
+         Assign(Name("i"), Int(0))
+         Assign(Name("x"), Int(0))
+         While(Compare(Name("i"), CmpOp("<", Name("n"))), OUTER-BODY)
+         Return(Name("count")),
+         0)
+endmodule

