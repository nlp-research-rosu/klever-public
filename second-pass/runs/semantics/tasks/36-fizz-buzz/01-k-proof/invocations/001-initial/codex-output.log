+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inner-loop invariant.  The temporary x reaches zero, and count increases
+  // by the number of base-10 digits equal to seven in its initial value.
+  claim
+    <k>
+      #while(Compare(Name("x"), CmpOp(">", Int(0))), INNER-BODY)
+      ~> CONT:K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        ("n" |-> N:Int)
+        ("count" |-> A:Int)
+        ("i" |-> I:Int)
+        ("x" |-> X:Int)
+        REST:Map,
+        P:Parent)
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HN:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> R:RetState </ret>
+    <exc> E:Exc </exc>
+    <exit-code> EC:Int </exit-code>
+  =>
+    <k> CONT </k>
+    <env> L </env>
+    <scopes>
+      SC
+      L |-> scope(
+        ("n" |-> N)
+        ("count" |-> (A +Int countSevens(X)))
+        ("i" |-> I)
+        ("x" |-> 0)
+        REST,
+        P)
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> H </heap>
+    <heapLoc> HN </heapLoc>
+    <stack> ST </stack>
+    <ret> R </ret>
+    <exc> E </exc>
+    <exit-code> EC </exit-code>
+    requires X >=Int 0
+      andBool notBool ("n" in_keys(REST))
+      andBool notBool ("count" in_keys(REST))
+      andBool notBool ("i" in_keys(REST))
+      andBool notBool ("x" in_keys(REST))
+
+  // Outer-loop invariant for the reachable interval 0 <= I <= N.  The
+  // temporary x is zero at every boundary, i advances to N, and count gains
+  // exactly the specified sum over [I,N).
+  claim
+    <k>
+      #while(Compare(Name("i"), CmpOp("<", Name("n"))), OUTER-BODY)
+      ~> CONT:K
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(
+        ("n" |-> N:Int)
+        ("count" |-> A:Int)
+        ("i" |-> I:Int)
+        ("x" |-> 0)
+        REST:Map,
+        P:Parent)
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HN:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> R:RetState </ret>
+    <exc> E:Exc </exc>
+    <exit-code> EC:Int </exit-code>
+  =>
+    <k> CONT </k>
+    <env> L </env>
+    <scopes>
+      SC
+      L |-> scope(
+        ("n" |-> N)
+        ("count" |-> (A +Int fizzBuzzFrom(I, N)))
+        ("i" |-> N)
+        ("x" |-> 0)
+        REST,
+        P)
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> H </heap>
+    <heapLoc> HN </heapLoc>
+    <stack> ST </stack>
+    <ret> R </ret>
+    <exc> E </exc>
+    <exit-code> EC </exit-code>
+    requires 0 <=Int I andBool I <=Int N
+      andBool notBool ("n" in_keys(REST))
+      andBool notBool ("count" in_keys(REST))
+      andBool notBool ("i" in_keys(REST))
+      andBool notBool ("x" in_keys(REST))
+
+  // Entry-point theorem for every integer n.  For n <= 0, the while loop is
+  // empty and fizzBuzzFrom(0,n) is zero.
+  claim
+    <k> Call(FIZZ-BUZZ-CLOSURE, N:Int) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+  =>
+    <k> fizzBuzzSpec(N) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
