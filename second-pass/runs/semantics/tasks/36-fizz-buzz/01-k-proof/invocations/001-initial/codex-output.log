+        ("i" |-> I)
+        ("x" |-> 0)
+        REST,
+        P)
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> H </heap>
+    <heapLoc> HN </heapLoc>
+    <stack> ST </stack>
