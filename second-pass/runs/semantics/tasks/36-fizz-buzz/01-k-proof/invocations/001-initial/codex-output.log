+def fizz_buzz(n: int):
+    count = 0
+    i = 0
+    x = 0
+    while i < n:
+        if i % 11 == 0 or i % 13 == 0:
+            x = i
+            while x > 0:
+                if x % 10 == 7:
+                    count += 1
+                x = x // 10
+        i += 1
+    return count
+
+
+assert fizz_buzz(0) == 0
+assert fizz_buzz(50) == 0
+assert fizz_buzz(78) == 2
+assert fizz_buzz(79) == 3
+assert fizz_buzz(1000) == 47
