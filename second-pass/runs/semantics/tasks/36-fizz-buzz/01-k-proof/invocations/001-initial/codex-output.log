new file mode 100644
index 0000000000000000000000000000000000000000..7eb0e4d3f86bae522ecc408f812a98b3e005ed37
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,99 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inner-loop invariant.  The temporary x reaches zero, and count increases
+  // by the number of base-10 digits equal to seven in its initial value.
+  claim
+    <k>
+      #while(Compare(Name("x"), CmpOp(">", Int(0))), INNER-BODY)
+      ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ( SC:Map
+        L |-> scope(
+          ("n" |-> N:Int)
+          ("count" |-> A:Int)
+          ("i" |-> I:Int)
+          ("x" |-> X:Int),
+          P:Parent)
+      )
+      =>
+      ( SC
+        L |-> scope(
+          ("n" |-> N)
+          ("count" |-> countSevensAcc(A, X))
+          ("i" |-> I)
+          ("x" |-> 0),
+          P)
+      )
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HN:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> R:RetState </ret>
+    <exc> E:Exc </exc>
+    <exit-code> EC:Int </exit-code>
+    requires X >=Int 0
+
+  // Outer-loop invariant for the reachable interval 0 <= I <= N.  The
+  // temporary x is zero at every boundary, i advances to N, and count gains
+  // exactly the specified sum over [I,N).
+  claim
+    <k>
+      #while(Compare(Name("i"), CmpOp("<", Name("n"))), OUTER-BODY)
+      ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ( SC:Map
+        L |-> scope(
+          ("n" |-> N:Int)
+          ("count" |-> A:Int)
+          ("i" |-> I:Int)
+          ("x" |-> 0),
+          P:Parent)
+      )
+      =>
+      ( SC
+        L |-> scope(
+          ("n" |-> N)
+          ("count" |-> fizzBuzzAcc(A, I, N))
+          ("i" |-> N)
+          ("x" |-> 0),
+          P)
+      )
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HN:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> R:RetState </ret>
+    <exc> E:Exc </exc>
+    <exit-code> EC:Int </exit-code>
+    requires 0 <=Int I andBool I <=Int N
+
+  // Entry-point theorem for every integer n.  For n <= 0, the while loop is
+  // empty and fizzBuzzFrom(0,n) is zero.
+  claim
+    <k> Call(FIZZ-BUZZ-CLOSURE, N:Int) => fizzBuzzSpec(N) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
