diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..975fc9dc9a59ad0dbf7a37fafd4a1eb38311c20b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,78 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // A direct mathematical reading of the prompt: recursively inspect the
+  // base-10 digits of each selected non-negative integer.
+  syntax Bool ::= divisibleBy11Or13(Int) [function, total]
+  rule divisibleBy11Or13(I:Int)
+    => pyMod(I, 11) ==Int 0 orBool pyMod(I, 13) ==Int 0
+
+  syntax Int ::= countSevens(Int) [function]
+  rule countSevens(0) => 0
+  rule countSevens(I:Int)
+    => (#if pyMod(I, 10) ==Int 7 #then 1 #else 0 #fi)
+       +Int countSevens((I -Int pyMod(I, 10)) /Int 10)
+    requires I >Int 0
+
+  syntax Int ::= selectedSevens(Int) [function, total]
+  rule selectedSevens(I:Int)
+    => #if divisibleBy11Or13(I)
+       #then countSevens(I)
+       #else 0
+       #fi
+
+  // Sum selectedSevens over the half-open interval [I, N).
+  syntax Int ::= fizzBuzzFrom(Int, Int) [function]
+  rule fizzBuzzFrom(I:Int, N:Int) => 0
+    requires I >=Int N
+  rule fizzBuzzFrom(I:Int, N:Int)
+    => selectedSevens(I) +Int fizzBuzzFrom(I +Int 1, N)
+    requires I <Int N
+
+  syntax Int ::= fizzBuzzSpec(Int) [function, total]
+  rule fizzBuzzSpec(N:Int) => fizzBuzzFrom(0, N)
+
+  // Exact AST fragments emitted by py2mpy.py for solution.py.  Keeping them
+  // named makes the loop-invariant claims in spec.k readable.
+  syntax Stmts ::= "INNER-BODY" [macro]
+  rule INNER-BODY
+    => If(Compare(BinOp("%", Name("x"), Int(10)), CmpOp("==", Int(7))),
+          AugAssign(Name("count"), "+", Int(1)) .Stmts,
+          .Stmts)
+       Assign(Name("x"), BinOp("//", Name("x"), Int(10)))
+
+  syntax Stmts ::= "OUTER-BODY" [macro]
+  rule OUTER-BODY
+    => If(BoolOp(
+            "or",
+            Compare(BinOp("%", Name("i"), Int(11)), CmpOp("==", Int(0))),
+            Compare(BinOp("%", Name("i"), Int(13)), CmpOp("==", Int(0)))),
+          Assign(Name("x"), Name("i"))
+          While(Compare(Name("x"), CmpOp(">", Int(0))), INNER-BODY),
+          .Stmts)
+       AugAssign(Name("i"), "+", Int(1))
+
+  syntax Stmt ::= "FIZZ-BUZZ-DEF" [macro]
+  rule FIZZ-BUZZ-DEF
+    => FuncDef(
+         "fizz_buzz",
+         Params("n"),
+         Assign(Name("count"), Int(0))
+         Assign(Name("i"), Int(0))
+         Assign(Name("x"), Int(0))
+         While(Compare(Name("i"), CmpOp("<", Name("n"))), OUTER-BODY)
+         Return(Name("count")))
+
+  syntax Val ::= "FIZZ-BUZZ-CLOSURE" [macro]
+  rule FIZZ-BUZZ-CLOSURE
+    => closureVal(
+         "n",
+         Assign(Name("count"), Int(0))
+         Assign(Name("i"), Int(0))
+         Assign(Name("x"), Int(0))
+         While(Compare(Name("i"), CmpOp("<", Name("n"))), OUTER-BODY)
+         Return(Name("count")),
+         0)
+endmodule

diff --git a/concrete-tests.py b/concrete-tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..64b38c364aae97478d048d5d7356b157a4dfb2eb
--- /dev/null
+++ b/concrete-tests.py
@@ -0,0 +1,15 @@
+def fizz_buzz(n: int):
+    count = 0
+    for i in range(n):
+        if i % 11 == 0 or i % 13 == 0:
+            for digit in str(i):
+                if digit == "7":
+                    count += 1
+    return count
+
+
+assert fizz_buzz(0) == 0
+assert fizz_buzz(50) == 0
+assert fizz_buzz(78) == 2
+assert fizz_buzz(79) == 3
+assert fizz_buzz(1000) == 47
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..b2e270ad1d03da86af49ff17cb7ddb3da2d95c6b
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def fizz_buzz(n: int):
+    count = 0
+    i = 0
+    x = 0
+    while i < n:
+        if i % 11 == 0 or i % 13 == 0:
+            x = i
+            while x > 0:
+                if x % 10 == 7:
+                    count += 1
+                x = x // 10
+        i += 1
+    return count
diff --git a/spec.k b/spec.k
