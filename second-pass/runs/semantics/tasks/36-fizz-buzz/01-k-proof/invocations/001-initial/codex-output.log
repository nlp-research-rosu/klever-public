+    <scopes>
+      SC
+      L |-> scope(
+        ("n" |-> N)
+        ("count" |-> (A +Int fizzBuzzFrom(I, N)))
+        ("i" |-> N)
+        ("x" |-> 0)
+        REST,
+        P)
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> H </heap>
+    <heapLoc> HN </heapLoc>
+    <stack> ST </stack>
+    <ret> R </ret>
+    <exc> E </exc>
