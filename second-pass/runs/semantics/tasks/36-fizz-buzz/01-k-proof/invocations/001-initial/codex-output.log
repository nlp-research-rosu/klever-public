diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..a5032d8202623c218a78bb4d1957d5f28ba852e2
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,103 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Inner-loop invariant: iterating the remaining decimal character codes
+  // increases count by exactly the number of remaining '7' characters.
+  claim [digit-loop-correct]:
+    <k> #loop(str(CS:IntSeq), Name("digit"), DIGIT-BODY) ~> CONT:K </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(("count" |-> A:Int) REST:Map, P:Parent)
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HN:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> R:RetState </ret>
+    <exc> E:Exc </exc>
+    <exit-code> X:Int </exit-code>
+  =>
+    <k> CONT </k>
+    <env> L </env>
+    <scopes>
+      SC2:Map
+      L |-> scope(
+        ("count" |-> (A +Int countSevens(CS))) REST2:Map,
+        P2:Parent)
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> H </heap>
+    <heapLoc> HN </heapLoc>
+    <stack> ST </stack>
+    <ret> R </ret>
+    <exc> E </exc>
+    <exit-code> X </exit-code>
+    requires notBool ("count" in_keys(REST))
+
+  // Outer-loop invariant: iterating [I,N) adds exactly fizzBuzzFrom(I,N).
+  claim [outer-loop-correct]:
+    <k> #loop(rangeObj(I:Int, N:Int, 1), Name("i"), OUTER-BODY) ~> CONT:K </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      L |-> scope(("count" |-> A:Int) REST:Map, P:Parent)
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HN:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> R:RetState </ret>
+    <exc> E:Exc </exc>
+    <exit-code> X:Int </exit-code>
+  =>
+    <k> CONT </k>
+    <env> L </env>
+    <scopes>
+      SC2:Map
+      L |-> scope(
+        ("count" |-> (A +Int fizzBuzzFrom(I, N))) REST2:Map,
+        P2:Parent)
+    </scopes>
+    <scopeLoc> NEXT </scopeLoc>
+    <heap> H </heap>
+    <heapLoc> HN </heapLoc>
+    <stack> ST </stack>
+    <ret> R </ret>
+    <exc> E </exc>
+    <exit-code> X </exit-code>
+    requires notBool ("count" in_keys(REST))
+
+  // Entry-point theorem, for every mathematical integer n.  Python range(n)
+  // is empty for n <= 0, which fizzBuzzFrom(0,n) models as zero.
+  claim [fizz-buzz-correct]:
+    <k> Call(FIZZ-BUZZ-CLOSURE, N:Int) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+  =>
+    <k> fizzBuzzSpec(N) </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
