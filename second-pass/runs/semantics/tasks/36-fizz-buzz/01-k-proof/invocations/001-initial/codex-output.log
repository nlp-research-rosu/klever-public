+    <scopes> 0 |-> scope(.Map, parent(-1)) -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim
+    <k> Call(FIZZ-BUZZ-CLOSURE, 50) => 0 </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1)) -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim
+    <k> Call(FIZZ-BUZZ-CLOSURE, 78) => 2 </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1)) -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim
+    <k> Call(FIZZ-BUZZ-CLOSURE, 79) => 3 </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1)) -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim
+    <k> Call(FIZZ-BUZZ-CLOSURE, 100) => 3 </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map, parent(-1)) -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
