+         "fizz_buzz",
+         Params("n"),
+         Assign(Name("count"), Int(0))
+         Assign(Name("i"), Int(0))
+         Assign(Name("x"), Int(0))
+         While(Compare(Name("i"), CmpOp("<", Name("n"))), OUTER-BODY)
+         Return(Name("count")))
