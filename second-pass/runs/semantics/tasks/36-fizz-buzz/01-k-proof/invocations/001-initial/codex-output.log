+    [trusted]
+
+  claim
+    <k>
+      #while(Compare(Name("i"), CmpOp("<", Name("n"))), OUTER-BODY)
+      ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ( SC:Map
+        L |-> scope(
+          ("n" |-> N:Int)
+          ("count" |-> A:Int)
+          ("i" |-> I:Int)
+          ("x" |-> 0),
+          P:Parent)
