+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ( SC:Map
+        L |-> scope(
+          ("n" |-> N:Int)
+          ("count" |-> A:Int)
+          ("i" |-> I:Int)
+          ("x" |-> 0),
+          P:Parent)
+      )
+      =>
+      ( SC
+        L |-> scope(
+          ("n" |-> N)
+          ("count" |-> fizzBuzzAcc(A, I, N))
+          ("i" |-> N)
+          ("x" |-> 0),
+          P)
+      )
+    </scopes>
+    <scopeLoc> NEXT:Int </scopeLoc>
