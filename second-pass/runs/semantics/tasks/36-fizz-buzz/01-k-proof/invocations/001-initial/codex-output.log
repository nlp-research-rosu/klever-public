+    <env> L:Int </env>
+    <scopes>
+      ( SC:Map
+        L |-> scope(
+          ("n" |-> N:Int)
+          ("count" |-> A:Int)
+          ("i" |-> I:Int)
+          ("x" |-> X:Int),
+          P:Parent)
+      )
+      =>
+      ( SC
+        L |-> scope(
+          ("n" |-> N)
+          ("count" |-> countSevensAcc(A, X))
+          ("i" |-> I)
+          ("x" |-> 0),
+          P)
