+    parser.add_argument("--solution", type=Path, required=True)
+    parser.add_argument("--inputs-out", type=Path, required=True)
+    return parser.parse_args()
+
+
+def add_case(
+    cases: list[tuple[str, list[int]]],
+    seen: set[tuple[int, ...]],
+    category: str,
+    values: list[int],
+) -> None:
+    key = tuple(values)
+    if key not in seen:
+        seen.add(key)
+        cases.append((category, values))
+
+
+def main() -> int:
+    args = parse_args()
