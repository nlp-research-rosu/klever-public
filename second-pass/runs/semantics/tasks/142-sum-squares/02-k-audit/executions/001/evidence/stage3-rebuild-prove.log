LABEL: concrete_translate
COMMAND: python3 py2mpy.py /audit-output/evidence/concrete_semantics_tests.py
Module(
  FuncDef("sum_squares", Params("lst"),
    Assign(Name("total"), Int(0))
    Assign(Name("index"), Int(0))
    For(Name("value"), Name("lst"),
      If(Compare(BinOp("%", Name("index"), Int(3)), CmpOp("==", Int(0))),
        AugAssign(
          Name("total"),
          "+",
          BinOp("*", Name("value"), Name("value"))),
        If(Compare(BinOp("%", Name("index"), Int(4)), CmpOp("==", Int(0))),
          AugAssign(
            Name("total"),
            "+",
            BinOp(
              "*",
              BinOp("*", Name("value"), Name("value")),
              Name("value"))),
          AugAssign(Name("total"), "+", Name("value"))))
      AugAssign(Name("index"), "+", Int(1)))
    Return(Name("total")))
  Assert(
    Compare(Call(Name("sum_squares"), ListExpr()), CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("sum_squares"), ListExpr(Int(1))),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("sum_squares"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Int(6))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(5)),
          Int(2),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(5)))),
      CmpOp("==", UnaryOp("-", Int(126)))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(
          Int(1),
          Int(2),
          Int(3),
          Int(4),
          Int(5),
          Int(6),
          Int(7),
          Int(8),
          Int(9),
          Int(10),
          Int(11),
          Int(12),
          Int(13))),
      CmpOp("==", Int(1231))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(
          Int(2),
          UnaryOp("-", Int(3)),
          Int(4),
          UnaryOp("-", Int(5)),
          Int(6),
          UnaryOp("-", Int(7)),
          Int(8),
          UnaryOp("-", Int(9)),
          Int(10),
          UnaryOp("-", Int(11)),
          Int(12),
          UnaryOp("-", Int(13)),
          Int(14))),
      CmpOp("==", Int(1610)))))
EXIT_STATUS: 0

