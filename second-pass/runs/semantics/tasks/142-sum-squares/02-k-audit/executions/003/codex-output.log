{
  echo 'COMMAND (expected failure): kprove spec-vacuity.k --definition audit-verification-kompiled --spec-module SUM-SQUARES-SPEC-VACUITY --claims SUM-SQUARES-SPEC-VACUITY.main-false-empty --output pretty'
  cd /tmp/audit-work/reconstruction || exit 90
  kprove spec-vacuity.k --definition audit-verification-kompiled --spec-module SUM-SQUARES-SPEC-VACUITY --claims SUM-SQUARES-SPEC-VACUITY.main-false-empty --output pretty
  proof_status="'$?
  echo "VACUITY_KPROVE_EXIT_STATUS=$proof_status"
  if (( proof_status == 0 )); then
    echo '"'UNEXPECTED: false empty-input result closed'
    exit 1
  fi
  echo 'EXPECTED: false result obligation rejected'
  exit 0
} 2>&1 | tee /audit-output/evidence/stage6-vacuity-proof.log
status="'${PIPESTATUS[0]}
echo "EXPECTED_FAILURE_CHECK_SCRIPT_EXIT_STATUS=$status" | tee -a /audit-output/evidence/stage6-vacuity-proof.log
exit "$status"' in /audit-output
