+import re
+import sys
+from pathlib import Path
+from typing import Iterable
+
+
+ROOT = Path("/tmp/audit-work/reconstruction")
+SEMANTICS = ROOT / "reference-semantics"
+OUTPUT = Path("/audit-output/evidence/rule-inventory.tsv")
+
