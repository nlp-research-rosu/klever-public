  kprove bridge-ground-spec.k --definition audit-verification-kompiled --spec-module SUM-SQUARES-BRIDGE-GROUND-SPEC --dry-run
  dry_status="'$?
  echo "BRIDGE_GROUND_DRY_RUN_EXIT_STATUS=$dry_status"
  echo '"'COMMAND: kprove bridge-ground-spec.k --definition audit-verification-kompiled --spec-module SUM-SQUARES-BRIDGE-GROUND-SPEC --output pretty'
  kprove bridge-ground-spec.k --definition audit-verification-kompiled --spec-module SUM-SQUARES-BRIDGE-GROUND-SPEC --output pretty
