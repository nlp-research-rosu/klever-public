+        "trusted_translator_sha256": Path("/reference/py2mpy.py"),
+    }
+    declared_hashes = audit.get("hashes", {})
+    for field, path in direct_hashes.items():
+        actual = sha256(path)
+        expected = declared_hashes.get(field)
+        matched = actual == expected
