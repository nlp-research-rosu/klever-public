+    "reference-semantics/semantics/core.k": {
+        13,
+        14,
+        18,
+        25,
+        36,
+        37,
+        38,
+        39,
+        40,
+        41,
+        42,
+        49,
+        124,
+        126,
+        127,
+        130,
+        131,
+        132,
+        152,
+        185,
+        186,
+        189,
+        190,
