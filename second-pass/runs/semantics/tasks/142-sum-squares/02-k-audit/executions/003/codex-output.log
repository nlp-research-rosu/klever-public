diff --git a//tmp/audit-work/reconstruction/spec-vacuity.k b//tmp/audit-work/reconstruction/spec-vacuity.k
new file mode 100644
index 0000000000000000000000000000000000000000..96d42e5441d60170b1dce4470e71c03aa7744228
