--- solution.py ---
     1	def sum_squares(lst):
     2	    total = 0
     3	    index = 0
     4	    for value in lst:
     5	        if index % 3 == 0:
     6	            total += value * value
     7	        else:
     8	            if index % 4 == 0:
     9	                total += value * value * value
    10	            else:
    11	                total += value
    12	        index += 1
    13	    return total
--- solution.mpy ---
     1	Module(
     2	  FuncDef("sum_squares", Params("lst"),
     3	    Assign(Name("total"), Int(0))
     4	    Assign(Name("index"), Int(0))
     5	    For(Name("value"), Name("lst"),
     6	      If(Compare(BinOp("%", Name("index"), Int(3)), CmpOp("==", Int(0))),
     7	        AugAssign(
     8	          Name("total"),
     9	          "+",
    10	          BinOp("*", Name("value"), Name("value"))),
    11	        If(Compare(BinOp("%", Name("index"), Int(4)), CmpOp("==", Int(0))),
    12	          AugAssign(
    13	            Name("total"),
    14	            "+",
    15	            BinOp(
    16	              "*",
    17	              BinOp("*", Name("value"), Name("value")),
    18	              Name("value"))),
    19	          AugAssign(Name("total"), "+", Name("value"))))
    20	      AugAssign(Name("index"), "+", Int(1)))
    21	    Return(Name("total"))))
