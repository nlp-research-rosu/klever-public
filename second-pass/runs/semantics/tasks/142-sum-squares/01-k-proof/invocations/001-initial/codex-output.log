+  claim [loop]:
+    <k>
+      #loop(list(intVals(IS:Ints)), Name("value"), sumSquaresLoopBody)
+      ~> Return(Name("total"))
+      ~> KONT:K
+    =>
+      Return(Name("total"))
+      ~> KONT
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      SC:Map
+      (L |-> scope(
+        M:Map [ "total" <- ACC:Int ] [ "index" <- I:Int ],
+        P:Parent))
+    =>
+      SC
+      (L |-> scope(finishLoop(IS, I, ACC, M), P))
+    </scopes>
+
+  // End-to-end correctness for every finite list of mathematical integers.
+  claim [main]:
+    <k>
+      Call(
+        Name("sum_squares"),
+        (list(intVals(IS:Ints)), .Exprs))
+    =>
+      sumSquares(IS, 0, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "sum_squares" |->
+          closureVal(
+            ("lst", .ParamNames),
+            sumSquaresFunctionBody,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
