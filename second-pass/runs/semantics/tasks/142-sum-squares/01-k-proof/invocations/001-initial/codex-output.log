+      0  |-> scope(
+        "sum_squares" |->
+          closureVal(
+            ("lst", .ParamNames),
+            sumSquaresFunctionBody,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(CONT, 0, 1)) => .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  // End-to-end correctness for every finite list of mathematical integers.
+  claim [main]:
+    <k>
+      Call(
+        Name("sum_squares"),
+        (list(intVals(IS:Ints)), .Exprs))
+    =>
+      sumSquares(IS, 0, 0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "sum_squares" |->
+          closureVal(
