+      ~> CONT:K
+    </k>
+    <env> 1 => 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "sum_squares" |->
+          closureVal(
+            ("lst", .ParamNames),
+            sumSquaresFunctionBody,
+            0),
+        parent(-1))
+      1  |-> scope(
+        "lst"   |-> list(intVals(IS))
+        "total" |-> 0
+        "index" |-> 0,
+        parent(0))
+    =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+        "sum_squares" |->
+          closureVal(
+            ("lst", .ParamNames),
+            sumSquaresFunctionBody,
+            0),
+        parent(-1))
+    </scopes>
+    <scopeLoc> 2 => 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> ListItem(frame(CONT, 0, 1)) => .List </stack>
