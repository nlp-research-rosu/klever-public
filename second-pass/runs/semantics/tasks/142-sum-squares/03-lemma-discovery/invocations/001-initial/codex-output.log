#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")"

# Translate the submitted implementation with the fixed frontend.
python3 py2mpy.py solution.py > solution.mpy

# Compile and exercise the supplied concrete semantics.
kompile reference-semantics/semantics.k \
  --backend llvm \
  --main-module MPY-KRUN \
  --syntax-module MPY-SYNTAX \
  --output-definition runtime-kompiled
python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
krun concrete_tests.mpy \
  --definition runtime-kompiled \
  --output pretty

# Compile the symbolic definition.  SUM-SQUARES-VERIFICATION imports MPY,
# deliberately excluding the concrete-only MPY-CONCRETE module.
kompile verification.k \
  --backend haskell \
  --main-module SUM-SQUARES-VERIFICATION \
  --syntax-module MPY-SYNTAX \
  --output-definition verification-kompiled

# Prove the induction lemma without assumptions.
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SUM-SQUARES-SPEC \
  --claims SUM-SQUARES-SPEC.loop \
  --output pretty

# Prove the body summary, admitting only the lemma just proved.
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SUM-SQUARES-SPEC \
  --claims SUM-SQUARES-SPEC.body,SUM-SQUARES-SPEC.loop \
  --trusted SUM-SQUARES-SPEC.loop \
  --output pretty

# Prove the end-to-end call, admitting only the body summary just proved.
kprove spec.k \
  --definition verification-kompiled \
  --spec-module SUM-SQUARES-SPEC \
  --claims SUM-SQUARES-SPEC.main,SUM-SQUARES-SPEC.body \
  --trusted SUM-SQUARES-SPEC.body \
  --output pretty
requires "reference-semantics/semantics.k"

module SUM-SQUARES-VERIFICATION
  imports MPY

  // A mathematical sequence containing only integers.  intVals embeds it in
  // the semantic ValSeq used by Python lists.
  syntax Ints ::= ".Ints" | intCons(Int, Ints)

  syntax ValSeq ::= intVals(Ints)

  // Symbolic iterator bridge.  It presents Ints through the reference
  // semantics' iterator protocol and makes the constructor split visible to
  // the prover.
  rule <k> #iterNext(list(intVals(.Ints))) => #iterDone ... </k>
    [priority(40)]
  rule <k> #iterNext(list(intVals(intCons(X:Int, XS:Ints))))
        => #iterYield(X, list(intVals(XS))) ... </k>
    [priority(40)]

  // The contribution prescribed by the prompt.  The multiple-of-3 case has
  // priority over the multiple-of-4 case, including at index zero.
  syntax Int ::= contribution(Int, Int) [function]
  rule contribution(I:Int, X:Int) => X *Int X
    requires pyMod(I, 3) ==Int 0
  rule contribution(I:Int, X:Int) => X *Int X *Int X
    requires pyMod(I, 3) =/=Int 0 andBool pyMod(I, 4) ==Int 0
  rule contribution(I:Int, X:Int) => X
    requires pyMod(I, 3) =/=Int 0 andBool pyMod(I, 4) =/=Int 0

  // Tail-recursive contract for the complete result.
  syntax Int ::= sumSquares(Ints, Int, Int) [function, total]
  rule sumSquares(.Ints, _:Int, ACC:Int) => ACC
  rule sumSquares(intCons(X:Int, XS:Ints), I:Int, ACC:Int)
    => sumSquares(XS, I +Int 1, ACC +Int contribution(I, X))

  // The other two pieces of the exact loop post-state.
  syntax Int ::= endIndex(Ints, Int) [function, total]
  rule endIndex(.Ints, I:Int) => I
  rule endIndex(intCons(_:Int, XS:Ints), I:Int)
    => endIndex(XS, I +Int 1)

  syntax Int ::= endValue(Ints, Int) [function, total]
  rule endValue(.Ints, OLD:Int) => OLD
  rule endValue(intCons(X:Int, XS:Ints), _:Int)
    => endValue(XS, X)

  syntax Stmts ::= "sumSquaresLoopBody" [macro]
  rule sumSquaresLoopBody
    => If(
         Compare(
           BinOp("%", Name("index"), Int(3)),
           CmpOp("==", Int(0))),
         AugAssign(
           Name("total"),
           "+",
           BinOp("*", Name("value"), Name("value")))
         .Stmts,
         If(
           Compare(
             BinOp("%", Name("index"), Int(4)),
             CmpOp("==", Int(0))),
           AugAssign(
             Name("total"),
             "+",
             BinOp(
               "*",
               BinOp("*", Name("value"), Name("value")),
               Name("value")))
           .Stmts,
           AugAssign(Name("total"), "+", Name("value"))
           .Stmts)
         .Stmts)
       AugAssign(Name("index"), "+", Int(1))
       .Stmts

  syntax Stmts ::= "sumSquaresFunctionBody" [macro]
  rule sumSquaresFunctionBody
    => Assign(Name("total"), Int(0))
       Assign(Name("index"), Int(0))
       For(Name("value"), Name("lst"), sumSquaresLoopBody)
       Return(Name("total"))
       .Stmts
endmodule
requires "verification.k"

module SUM-SQUARES-SPEC
  imports SUM-SQUARES-VERIFICATION

  // Inductive loop invariant after at least one element has been bound.  The
  // local map is exact, which also records that this is a plain (non-cell)
  // function frame.  The claim is proved first, then admitted as a proved
  // lemma while proving the end-to-end function claim.
  claim [loop]:
    <k>
      #loop(list(intVals(IS:Ints)), Name("value"), sumSquaresLoopBody)
      ~> (Return(Name("total")) .Stmts)
      ~> #endcall
      ~> KONT:K
    =>
      (Return(Name("total")) .Stmts)
      ~> #endcall
      ~> KONT
    </k>
    <env> L:Int </env>
    <scopes>
      SC:Map
      (L |-> scope(
        "lst"   |-> list(intVals(ORIG:Ints))
        "value" |-> OLD:Int
        "total" |-> ACC:Int
        "index" |-> I:Int,
        P:Parent))
    =>
      SC
      (L |-> scope(
        "lst"   |-> list(intVals(ORIG))
        "value" |-> endValue(IS, OLD)
        "total" |-> sumSquares(IS, I, ACC)
        "index" |-> endIndex(IS, I),
        P))
    </scopes>

  // Function-body summary from the initialized local frame through return.
  // This isolates frame cleanup from the loop induction.
  claim [body]:
    <k>
      #loop(list(intVals(IS:Ints)), Name("value"), sumSquaresLoopBody)
      ~> (Return(Name("total")) .Stmts)
      ~> #endcall
    =>
      sumSquares(IS, 0, 0)
      ~> CONT:K
    </k>
    <env> 1 => 0 </env>
    <scopes>
      -1 |-> builtinsScope
      0  |-> scope(
        "sum_squares" |->
          closureVal(
            ("lst", .ParamNames),
            sumSquaresFunctionBody,
            0),
        parent(-1))
      1  |-> scope(
        "lst"   |-> list(intVals(IS))
        "total" |-> 0
        "index" |-> 0,
        parent(0))
    =>
      -1 |-> builtinsScope
      0  |-> scope(
        "sum_squares" |->
          closureVal(
            ("lst", .ParamNames),
            sumSquaresFunctionBody,
            0),
        parent(-1))
    </scopes>
    <scopeLoc> 2 => 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> ListItem(frame(CONT, 0, 1)) => .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>

  // End-to-end correctness for every finite list of mathematical integers.
  claim [main]:
    <k>
      Call(
        Name("sum_squares"),
        (list(intVals(IS:Ints)), .Exprs))
    =>
      sumSquares(IS, 0, 0)
    </k>
    <env> 0 </env>
    <scopes>
      -1 |-> builtinsScope
      0  |-> scope(
        "sum_squares" |->
          closureVal(
            ("lst", .ParamNames),
            sumSquaresFunctionBody,
            0),
        parent(-1))
    </scopes>
    <scopeLoc> 1 </scopeLoc>
    <heap> .Map </heap>
    <heapLoc> 0 </heapLoc>
    <stack> .List </stack>
    <ret> noRet </ret>
    <exc> NoExc </exc>
    <exit-code> 0 </exit-code>
endmodule

