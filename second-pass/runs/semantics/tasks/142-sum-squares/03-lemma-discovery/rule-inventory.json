      "source_rule_id": "rule-38e6a28bd65f89b1992106811b8bd7c968c48ad1cb93c8813bc73137899776bc",
      "start_line": 78,
      "text": "  rule sumSquaresFunctionBody\n    => Assign(Name(\"total\"), Int(0))\n       Assign(Name(\"index\"), Int(0))\n       For(Name(\"value\"), Name(\"lst\"), sumSquaresLoopBody)\n       Return(Name(\"total\"))\n       .Stmts"
    }
