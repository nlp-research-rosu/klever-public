+      Assign(
+        Name("d"),
+        BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")))
+      Assign(Name("a"), Name("b"))
+      Assign(Name("b"), Name("c"))
+      Assign(Name("c"), Name("d"))
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+    Return(Name("a")))
+  Assert(Compare(Call(Name("fibfib"), Int(0)), CmpOp("==", Int(0))))
+  Assert(Compare(Call(Name("fibfib"), Int(1)), CmpOp("==", Int(0))))
+  Assert(Compare(Call(Name("fibfib"), Int(2)), CmpOp("==", Int(1))))
+  Assert(Compare(Call(Name("fibfib"), Int(3)), CmpOp("==", Int(1))))
+  Assert(Compare(Call(Name("fibfib"), Int(5)), CmpOp("==", Int(4))))
+  Assert(Compare(Call(Name("fibfib"), Int(8)), CmpOp("==", Int(24))))
+  Assert(Compare(Call(Name("fibfib"), Int(12)), CmpOp("==", Int(274)))))
diff --git a/evidence/spec-body-mutation.k b/evidence/spec-body-mutation.k
new file mode 100644
index 0000000000000000000000000000000000000000..c87141230d2fc49521e66db5eaf03678d6cc0643
--- /dev/null
+++ b/evidence/spec-body-mutation.k
@@ -0,0 +1,67 @@
+requires "../../tmp/audit-work/rebuild/verification.k"
+
+module FIBFIB-SPEC-BODY-MUTATION
+  imports FIBFIB-VERIFICATION
+
+  claim [fibfib-loop]:
+    <k>
+      #while(Compare(Name("i"), CmpOp("<", Name("n"))),
+        Assign(Name("d"),
+          BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")))
+        Assign(Name("a"), Name("b"))
+        Assign(Name("b"), Name("c"))
+        Assign(Name("c"), Name("d"))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "a" |-> (A:Int => fibFrom(A, B, C, N -Int I))
+        "b" |-> (B:Int => ?_B:Int)
+        "c" |-> (C:Int => ?_C:Int)
+        "d" |-> (_D:Int => ?_D:Int)
+        "i" |-> (I:Int => N:Int)
+        "n" |-> N,
+        _P:Parent) ...
+    </scopes>
+    requires 0 <=Int I andBool I <=Int N
+
+  // This changes the actual closure term executed by the claim: c starts at 2
+  // instead of 1. The unchanged fibFrom(0,0,1,N) destination is false at N=2.
+  claim [fibfib-correct-body-mutant]:
+    <k>
+      Call(Name("fibfib"), Int(N:Int))
+      => fibFrom(0, 0, 1, N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "fibfib" |-> closureVal(
+          "n", .ParamNames,
+          Assign(Name("a"), Int(0))
+          Assign(Name("b"), Int(0))
+          Assign(Name("c"), Int(2))
+          Assign(Name("i"), Int(0))
+          Assign(Name("d"), Int(0))
+          While(Compare(Name("i"), CmpOp("<", Name("n"))),
+            Assign(Name("d"),
+              BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")))
+            Assign(Name("a"), Name("b"))
+            Assign(Name("b"), Name("c"))
+            Assign(Name("c"), Name("d"))
+            Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+          Return(Name("a")),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires N >=Int 0
+endmodule
