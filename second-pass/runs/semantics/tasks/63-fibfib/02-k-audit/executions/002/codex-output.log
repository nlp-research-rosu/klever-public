+    <scopes>
+      0 |-> scope(
+        "fibfib" |-> closureVal(
+          "n", .ParamNames,
+          Assign(Name("a"), Int(0))
+          Assign(Name("b"), Int(0))
+          Assign(Name("c"), Int(2))
+          Assign(Name("i"), Int(0))
+          Assign(Name("d"), Int(0))
+          While(Compare(Name("i"), CmpOp("<", Name("n"))),
+            Assign(Name("d"),
+              BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")))
+            Assign(Name("a"), Name("b"))
+            Assign(Name("b"), Name("c"))
+            Assign(Name("c"), Name("d"))
+            Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+          Return(Name("a")),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires N >=Int 0
+endmodule
