+        "a" |-> (A:Int => fibFrom(A, B, C, N -Int I))
+        "b" |-> (B:Int => ?_B:Int)
+        "c" |-> (C:Int => ?_C:Int)
+        "d" |-> (_D:Int => ?_D:Int)
