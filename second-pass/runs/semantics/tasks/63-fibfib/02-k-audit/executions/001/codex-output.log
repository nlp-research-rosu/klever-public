+                }
+            )
+
+    print(f"rows_annotated={len(rows)}")
+    print(f"direct_path_rows={len(DIRECT_IDS)}")
+    print(f"proof_local_rows={len(PROOF_DECISIONS)}")
+    print(f"output={output_path}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
