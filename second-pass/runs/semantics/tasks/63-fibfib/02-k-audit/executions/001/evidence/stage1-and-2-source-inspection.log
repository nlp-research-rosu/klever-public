     7	def fibfib(n: int):
     8	    """The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:
     9	    fibfib(0) == 0
    10	    fibfib(1) == 0
    11	    fibfib(2) == 1
    12	    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).
    13	    Please write a function to efficiently compute the n-th element of the fibfib number sequence.
    14	    >>> fibfib(1)
    15	    0
    16	    >>> fibfib(5)
    17	    4
    18	    >>> fibfib(8)
    19	    24
    20	    """
    21	    if n == 0:
    22	        return 0
    23	    if n == 1:
    24	        return 0
    25	    if n == 2:
    26	        return 1
    27	    return fibfib(n - 1) + fibfib(n - 2) + fibfib(n - 3)
===== /candidate/solution.py =====
     1	def fibfib(n: int):
     2	    a = 0
     3	    b = 0
     4	    c = 1
     5	    i = 0
     6	    d = 0
     7	    while i < n:
     8	        d = a + b + c
     9	        a = b
    10	        b = c
    11	        c = d
    12	        i = i + 1
    13	    return a
