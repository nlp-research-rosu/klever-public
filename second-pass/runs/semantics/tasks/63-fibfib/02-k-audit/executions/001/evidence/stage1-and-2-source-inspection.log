===== /candidate/verification.k =====
     1	requires "reference-semantics/semantics.k"
     2	
     3	module FIBFIB-VERIFICATION
     4	  imports MPY
     5	
     6	  // fibFrom(A, B, C, N) is the first component after N shifts of
     7	  // (A, B, C) -> (B, C, A + B + C).
     8	  syntax Int ::= fibFrom(Int, Int, Int, Int) [function]
     9	  rule fibFrom(A:Int, _B:Int, _C:Int, N:Int) => A
    10	    requires N <=Int 0
    11	  rule fibFrom(A:Int, B:Int, C:Int, N:Int)
    12	    => fibFrom(B, C, A +Int B +Int C, N -Int 1)
    13	    requires N >Int 0
    14	
    15	  // Normalize the loop's incremented index to the form produced by the
    16	  // recursive fibFrom equation.
    17	  rule N:Int -Int (I:Int +Int 1) => N -Int I +Int -1 [simplification]
    18	endmodule
