diff --git a/smoke.mpy b/smoke.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..60c2a5c926b9c2f13c6821fe609f768fe410c7aa
--- /dev/null
+++ b/smoke.mpy
@@ -0,0 +1,20 @@
+Module(
+  FuncDef("fibfib", Params("n"),
+    Assign(Name("a"), Int(0))
+    Assign(Name("b"), Int(0))
+    Assign(Name("c"), Int(1))
+    Assign(Name("i"), Int(0))
+    While(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(
+        Name("d"),
+        BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")))
+      Assign(Name("a"), Name("b"))
+      Assign(Name("b"), Name("c"))
+      Assign(Name("c"), Name("d"))
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+    Return(Name("a")))
+  Assert(Compare(Call(Name("fibfib"), Int(0)), CmpOp("==", Int(0))))
+  Assert(Compare(Call(Name("fibfib"), Int(1)), CmpOp("==", Int(0))))
+  Assert(Compare(Call(Name("fibfib"), Int(2)), CmpOp("==", Int(1))))
+  Assert(Compare(Call(Name("fibfib"), Int(5)), CmpOp("==", Int(4))))
+  Assert(Compare(Call(Name("fibfib"), Int(8)), CmpOp("==", Int(24)))))
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..8e749f2ddc27b01f3cb2ed134ea0749ff43d1d89
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def fibfib(n: int):
+    a = 0
+    b = 0
+    c = 1
+    i = 0
+    while i < n:
+        d = a + b + c
+        a = b
+        b = c
+        c = d
+        i = i + 1
+    return a
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..bb122473f1a79999e71670105923604f42a86536
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,74 @@
+requires "verification.k"
+
+module FIBFIB-SPEC
+  imports FIBFIB-VERIFICATION
+
+  claim [fibfib-loop]:
+    <k>
+      While(Compare(Name("i"), CmpOp("<", Name("n"))),
+        Assign(Name("d"),
+          BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")))
+        Assign(Name("a"), Name("b"))
+        Assign(Name("b"), Name("c"))
+        Assign(Name("c"), Name("d"))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "a" |-> (A:Int => ?A:Int)
+        "b" |-> (B:Int => ?B:Int)
+        "c" |-> (C:Int => ?C:Int)
+        "i" |-> (I:Int => N:Int)
+        "n" |-> N
+        (REST:Map => ?REST:Map),
+        P:Parent) ...
+    </scopes>
+    requires 0 <=Int I andBool I <=Int N
+    ensures ?A ==Int fibFrom(A, B, C, N -Int I)
+
+  claim [fibfib-correct]:
+    <k>
+      Call(Name("fibfib"), Int(N:Int))
+      => fibFrom(0, 0, 1, N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "fibfib" |-> closureVal(
+          "n", .ParamNames,
+          Assign(Name("a"), Int(0))
+          Assign(Name("b"), Int(0))
+          Assign(Name("c"), Int(1))
+          Assign(Name("i"), Int(0))
+          While(Compare(Name("i"), CmpOp("<", Name("n"))),
+            Assign(Name("d"),
+              BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")))
+            Assign(Name("a"), Name("b"))
+            Assign(Name("b"), Name("c"))
+            Assign(Name("c"), Name("d"))
+            Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+          Return(Name("a")),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
