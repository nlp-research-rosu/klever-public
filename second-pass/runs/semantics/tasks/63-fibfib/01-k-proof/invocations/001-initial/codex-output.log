new file mode 100644
index 0000000000000000000000000000000000000000..8e749f2ddc27b01f3cb2ed134ea0749ff43d1d89
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,12 @@
+def fibfib(n: int):
+    a = 0
+    b = 0
+    c = 1
+    i = 0
+    while i < n:
+        d = a + b + c
+        a = b
+        b = c
+        c = d
+        i = i + 1
+    return a
