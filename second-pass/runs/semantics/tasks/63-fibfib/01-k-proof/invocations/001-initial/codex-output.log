diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..f0630d833ce305a123fd45182e2fdf6511ee9004
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def fibfib(n: int):
+    a = 0
+    b = 0
+    c = 1
+    i = 0
+    d = 0
+    while i < n:
+        d = a + b + c
+        a = b
+        b = c
+        c = d
+        i = i + 1
+    return a
