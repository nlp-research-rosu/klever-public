diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..3a70258d5b6e5d2d57d0367a025e984761c9cc05
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun smoke.mpy \
+  --definition runtime-kompiled \
+  --output none
+
+kompile verification.k \
+  --backend haskell \
+  --main-module FIBFIB-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module FIBFIB-SPEC
diff --git a/smoke.mpy b/smoke.mpy
new file mode 100644
index 0000000000000000000000000000000000000000..a1f8d39eabf49dbfb6e9b6f646a58eb43444554b
--- /dev/null
+++ b/smoke.mpy
@@ -0,0 +1,21 @@
+Module(
+  FuncDef("fibfib", Params("n"),
+    Assign(Name("a"), Int(0))
+    Assign(Name("b"), Int(0))
+    Assign(Name("c"), Int(1))
+    Assign(Name("i"), Int(0))
+    Assign(Name("d"), Int(0))
+    While(Compare(Name("i"), CmpOp("<", Name("n"))),
+      Assign(
+        Name("d"),
+        BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")))
+      Assign(Name("a"), Name("b"))
+      Assign(Name("b"), Name("c"))
+      Assign(Name("c"), Name("d"))
+      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+    Return(Name("a")))
+  Assert(Compare(Call(Name("fibfib"), Int(0)), CmpOp("==", Int(0))))
+  Assert(Compare(Call(Name("fibfib"), Int(1)), CmpOp("==", Int(0))))
+  Assert(Compare(Call(Name("fibfib"), Int(2)), CmpOp("==", Int(1))))
+  Assert(Compare(Call(Name("fibfib"), Int(5)), CmpOp("==", Int(4))))
+  Assert(Compare(Call(Name("fibfib"), Int(8)), CmpOp("==", Int(24)))))
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..f0630d833ce305a123fd45182e2fdf6511ee9004
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def fibfib(n: int):
+    a = 0
+    b = 0
+    c = 1
+    i = 0
+    d = 0
+    while i < n:
+        d = a + b + c
+        a = b
+        b = c
+        c = d
+        i = i + 1
+    return a
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..7d673210a5d0126dc18cb95a6a6e190cb41be17b
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,74 @@
+requires "verification.k"
+
+module FIBFIB-SPEC
+  imports FIBFIB-VERIFICATION
+
+  claim [fibfib-loop]:
+    <k>
+      #while(Compare(Name("i"), CmpOp("<", Name("n"))),
+        Assign(Name("d"),
+          BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")))
+        Assign(Name("a"), Name("b"))
+        Assign(Name("b"), Name("c"))
+        Assign(Name("c"), Name("d"))
+        Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ... L |-> scope(
+        "a" |-> (A:Int => fibFrom(A, B, C, N -Int I))
+        "b" |-> (B:Int => ?B:Int)
+        "c" |-> (C:Int => ?C:Int)
+        "d" |-> (D:Int => ?D:Int)
+        "i" |-> (I:Int => N:Int)
+        "n" |-> N,
+        P:Parent) ...
+    </scopes>
+    requires 0 <=Int I andBool I <=Int N
+
+  claim [fibfib-correct]:
+    <k>
+      Call(Name("fibfib"), Int(N:Int))
+      => fibFrom(0, 0, 1, N)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "fibfib" |-> closureVal(
+          "n", .ParamNames,
+          Assign(Name("a"), Int(0))
+          Assign(Name("b"), Int(0))
+          Assign(Name("c"), Int(1))
+          Assign(Name("i"), Int(0))
+          Assign(Name("d"), Int(0))
+          While(Compare(Name("i"), CmpOp("<", Name("n"))),
+            Assign(Name("d"),
+              BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")))
+            Assign(Name("a"), Name("b"))
+            Assign(Name("b"), Name("c"))
+            Assign(Name("c"), Name("d"))
+            Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
+          Return(Name("a")),
+          0),
+        parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    requires N >=Int 0
+
+  claim [example-1]:
+    <k> fibFrom(0, 0, 1, 1) => 0 </k>
+
+  claim [example-5]:
+    <k> fibFrom(0, 0, 1, 5) => 4 </k>
+
+  claim [example-8]:
+    <k> fibFrom(0, 0, 1, 8) => 24 </k>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..63bd5a7cdefddc2322ff334db398d51c4ef67af5
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,18 @@
+requires "reference-semantics/semantics.k"
+
+module FIBFIB-VERIFICATION
+  imports MPY
+
+  // fibFrom(A, B, C, N) is the first component after N shifts of
+  // (A, B, C) -> (B, C, A + B + C).
+  syntax Int ::= fibFrom(Int, Int, Int, Int) [function]
+  rule fibFrom(A:Int, _B:Int, _C:Int, N:Int) => A
+    requires N <=Int 0
+  rule fibFrom(A:Int, B:Int, C:Int, N:Int)
+    => fibFrom(B, C, A +Int B +Int C, N -Int 1)
+    requires N >Int 0
+
+  // Normalize the loop's incremented index to the form produced by the
+  // recursive fibFrom equation.
+  rule N:Int -Int (I:Int +Int 1) => N -Int I +Int -1 [simplification]
+endmodule

