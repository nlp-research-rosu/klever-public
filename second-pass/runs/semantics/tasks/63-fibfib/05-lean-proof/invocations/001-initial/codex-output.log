codex
The build failure is environmental and reproducible: this container exposes host PIDs in `/proc`, while Lean 4.22 queries `/proc/<namespace-pid>/exe`; that lookup fails before elaboration. I’ll use a temporary `LD_PRELOAD` compatibility shim that returns the host PID from `/proc/self/status`, leaving the pinned toolchain and project files unchanged.
apply patch
patch: completed
/tmp/lean_pid_shim.c
/workspace/Proof.lean
diff --git a//tmp/lean_pid_shim.c b//tmp/lean_pid_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..242e31f5945e433b1757932508fda9c06654cce5
--- /dev/null
+++ b//tmp/lean_pid_shim.c
@@ -0,0 +1,29 @@
+#define _GNU_SOURCE
+
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+pid_t getpid(void) {
+    char buffer[4096];
+    int fd = open("/proc/self/status", O_RDONLY);
+    if (fd >= 0) {
+        ssize_t count = read(fd, buffer, sizeof(buffer) - 1);
+        close(fd);
+        if (count > 0) {
+            buffer[count] = '\0';
+            char *field = strstr(buffer, "NStgid:");
+            if (field != NULL) {
+                char *value = field + strlen("NStgid:");
+                long host_pid = strtol(value, NULL, 10);
+                if (host_pid > 0) {
+                    return (pid_t)host_pid;
+                }
+            }
+        }
+    }
+    return (pid_t)syscall(SYS_getpid);
+}
