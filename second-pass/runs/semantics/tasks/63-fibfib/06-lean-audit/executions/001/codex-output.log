+        mounted_hashes[key] == mounted_hashes[key.replace("_observed", "_expected")]
+        for key in (
+            "stage1_pipeline_tree_observed",
+            "stage1_export_tree_observed",
+            "discovery_observed",
+            "generation_pipeline_tree_observed",
+            "generated_export_tree_observed",
