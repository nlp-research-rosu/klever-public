/bin/bash -lc 'cc -shared -fPIC -O2 -Wall -Wextra -o /tmp/audit-work/toolchain_path_shim.so evidence/toolchain_path_shim.c -ldl
status_compile=$?
printf '"'compile_command=cc -shared -fPIC -O2 -Wall -Wextra -o /tmp/audit-work/toolchain_path_shim.so evidence/toolchain_path_shim.c -ldl\\ncompile_exit=%s\\n' \""'$status_compile"
LD_PRELOAD=/tmp/audit-work/toolchain_path_shim.so lean --version
status_lean=$?
printf '"'lean_version_exit=%s\\n' \""'$status_lean"
(cd /tmp/audit-work/preflight-diagnosis/project && LD_PRELOAD=/tmp/audit-work/toolchain_path_shim.so lake clean)
status_clean=$?
printf '"'lake_clean_exit=%s\\n' \""'$status_clean"
(cd /tmp/audit-work/preflight-diagnosis/project && LD_PRELOAD=/tmp/audit-work/toolchain_path_shim.so lake build)
status_build=$?
printf '"'lake_build_exit=%s\\n' \""'$status_build"
test "$status_compile" -eq 0 -a "$status_lean" -eq 0 -a "$status_clean" -eq 0 -a "$status_build" -eq 0' in /audit-output
