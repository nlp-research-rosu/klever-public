+printf '%s\n' '--- mounted files ---'
+find /reference/tools -maxdepth 2 -type f -print | sort
+find /reference/generation-tools -maxdepth 2 -type f -print | sort
+find /reference/k-proof -maxdepth 3 -type f -print | sort
