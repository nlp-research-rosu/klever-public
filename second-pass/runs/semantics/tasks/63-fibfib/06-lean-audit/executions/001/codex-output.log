--- solution.py ---
     1	def fibfib(n: int):
     2	    a = 0
     3	    b = 0
     4	    c = 1
     5	    i = 0
     6	    d = 0
     7	    while i < n:
     8	        d = a + b + c
     9	        a = b
    10	        b = c
    11	        c = d
    12	        i = i + 1
    13	    return a
--- solution.mpy ---
     1	Module(
     2	  FuncDef("fibfib", Params("n"),
     3	    Assign(Name("a"), Int(0))
     4	    Assign(Name("b"), Int(0))
     5	    Assign(Name("c"), Int(1))
     6	    Assign(Name("i"), Int(0))
     7	    Assign(Name("d"), Int(0))
     8	    While(Compare(Name("i"), CmpOp("<", Name("n"))),
     9	      Assign(
    10	        Name("d"),
    11	        BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")))
    12	      Assign(Name("a"), Name("b"))
    13	      Assign(Name("b"), Name("c"))
    14	      Assign(Name("c"), Name("d"))
    15	      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    16	    Return(Name("a"))))
--- prompt.py ---
     1	
     2	
     3	def fibfib(n: int):
     4	    """The FibFib number sequence is a sequence similar to the Fibbonacci sequnece that's defined as follows:
     5	    fibfib(0) == 0
     6	    fibfib(1) == 0
     7	    fibfib(2) == 1
     8	    fibfib(n) == fibfib(n-1) + fibfib(n-2) + fibfib(n-3).
     9	    Please write a function to efficiently compute the n-th element of the fibfib number sequence.
    10	    >>> fibfib(1)
    11	    0
    12	    >>> fibfib(5)
    13	    4
    14	    >>> fibfib(8)
    15	    24
    16	    """
