+            "no_manifest_duplicates": len(discovery_ids) == len(set(discovery_ids)),
+            "no_omissions_or_extras": set(canonical_ids) == set(discovery_ids),
+            "validated_role_counts": {
+                role: len(validated[role])
+                for role in (
+                    "definitions",
