@@ -0,0 +1,32 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+pwd
+printf '%s\n' '--- AUDIT_MODE ---'
+printenv AUDIT_MODE
+printf '%s\n' '--- audit-input.json ---'
