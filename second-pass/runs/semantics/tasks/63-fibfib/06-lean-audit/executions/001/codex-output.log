+printf '%s\n' '--- exact arithmetic rule/claim occurrences in frozen K sources ---'
+rg -n -F 'N:Int -Int (I:Int +Int 1)' \
+  /reference/k-proof/verification.k \
+  /reference/k-proof/spec.k \
+  /reference/k-proof/reference-semantics || true
