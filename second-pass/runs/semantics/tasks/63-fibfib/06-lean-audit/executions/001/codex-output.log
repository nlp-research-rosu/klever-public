+++ b//tmp/audit-work/63-fibfib-stage5-audit-2/AuditBridge.lean
@@ -0,0 +1,54 @@
+import Proof
+
+namespace AuditBridge
+
+#check Proof.«_-Int_»
+#check Proof.«_+Int_»
+
+example : Proof.«_-Int_» 7 3 = 4 := rfl
+example : Proof.«_-Int_» (-7) 3 = -10 := rfl
+example : Proof.«_-Int_» 7 (-3) = 10 := rfl
+example : Proof.«_+Int_» (-7) 3 = -4 := rfl
+example :
+    Proof.«_+Int_» 100000000000000000000 3 =
+      100000000000000000003 := rfl
+
+#eval (
+  Proof.«_-Int_» 7 3,
+  Proof.«_-Int_» (-7) 3,
+  Proof.«_-Int_» 7 (-3),
+  Proof.«_+Int_» (-7) 3,
+  Proof.«_+Int_» 100000000000000000000 3
+)
+
+-- These deliberately convenient interpretations prove the equation but are
+-- not the K integer hooks. They demonstrate why the bridge check is separate.
+def zeroSub (_x _y : SortInt) : SortInt := 0
+def zeroAdd (_x _y : SortInt) : SortInt := 0
+
+theorem zeroTarget :
+    Klean63Fibfib.Lemmas.targetStatement zeroSub zeroAdd := by
+  intro I N
+  rfl
+
+def firstSub (x _y : SortInt) : SortInt := x
+def firstAdd (x _y : SortInt) : SortInt := x
+
+theorem firstTarget :
+    Klean63Fibfib.Lemmas.targetStatement firstSub firstAdd := by
+  intro I N
+  rfl
+
+example : zeroSub 7 3 ≠ Proof.«_-Int_» 7 3 := by decide
+example : firstSub 7 3 ≠ Proof.«_-Int_» 7 3 := by decide
+example : firstAdd 7 3 ≠ Proof.«_+Int_» 7 3 := by decide
+
+#eval (
+  zeroSub 7 3,
+  firstSub 7 3,
+  firstAdd 7 3,
+  Proof.«_-Int_» 7 3,
+  Proof.«_+Int_» 7 3
+)
+
+end AuditBridge
