import json
from pathlib import Path

inventory = json.loads(Path('/reference/rule-inventory.json').read_text())
out = json.loads(Path('/workspace/trust-boundary.json').read_text())
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert list(out) == ['schema_version', 'inventory_sha256', 'rules']
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inventory['inventory_sha256']
expected = [r['source_rule_id'] for r in inventory['rules']]
actual = [r['source_rule_id'] for r in out['rules']]
assert actual == expected
assert len(actual) == len(set(actual)) == len(expected)
for entry in out['rules']:
    assert list(entry) == ['source_rule_id', 'classification', 'rationale']
    assert entry['classification'] in allowed
    assert isinstance(entry['rationale'], str) and entry['rationale'].strip()
by_id = {r['source_rule_id']: r for r in out['rules']}
for rule in inventory['rules']:
    if 'simplification' in rule['attributes']:
        assert by_id[rule['source_rule_id']]['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
print(f\"validated {len(actual)} rules\")
print(out['inventory_sha256'])
