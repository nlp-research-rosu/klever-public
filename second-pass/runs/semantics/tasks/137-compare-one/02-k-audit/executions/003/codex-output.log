new file mode 100644
index 0000000000000000000000000000000000000000..37af33c5830a97a455703f2db07c58532a3e6d36
--- /dev/null
+++ b//tmp/audit-work/137-compare-one/spec-vacuity-audit.k
@@ -0,0 +1,18 @@
+requires "verification.k"
+
+module SPEC-VACUITY-AUDIT
+  imports VERIFICATION
+
+  // Deliberately false: compare_one(1, 2) returns 2, not 1.
+  claim <k> runCompare(1, 2) => 1 </k>
+        <env> 0 </env>
+        <scopes> 0 |-> scope(.Map, parent(-1))
