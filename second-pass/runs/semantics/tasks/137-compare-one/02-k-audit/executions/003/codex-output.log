diff --git a//tmp/audit-work/137-compare-one/wrong-decimal-oracle.k b//tmp/audit-work/137-compare-one/wrong-decimal-oracle.k
new file mode 100644
index 0000000000000000000000000000000000000000..f4e689d8ae2c8128302c40305aa9c2f559d1420f
--- /dev/null
+++ b//tmp/audit-work/137-compare-one/wrong-decimal-oracle.k
@@ -0,0 +1,13 @@
+requires "verification.k"
+
+module WRONG-DECIMAL-ORACLE
+  imports VERIFICATION
+
+  // An admissible but false interpretation: the numeric string "1" parses as 3.0.
+  rule commaDecimal(iCons(49, .IntSeq)) => 3.0
+
+  // Ground, mathematically correct float facts for the resulting comparison.
+  rule sameFloat(3.0, 2.0) => false
+  rule <k> Compare(3.0, CmpOp(">", 2.0)) => true ... </k>
+    [priority(40)]
+endmodule
