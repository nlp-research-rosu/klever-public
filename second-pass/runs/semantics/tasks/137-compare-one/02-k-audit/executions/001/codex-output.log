# canonical.py — the UNMODIFIED HumanEval/137 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: compare_one


def compare_one(a, b):
    """
    Create a function that takes integers, floats, or strings representing
    real numbers, and returns the larger variable in its given variable type.
    Return None if the values are equal.
    Note: If a real number is represented as a string, the floating point might be . or ,

    compare_one(1, 2.5) ➞ 2.5
    compare_one(1, "2,3") ➞ "2,3"
    compare_one("5,1", "6") ➞ "6"
    compare_one("1", 1) ➞ None
    """
    temp_a, temp_b = a, b
    if isinstance(temp_a, str): temp_a = temp_a.replace(',','.')
    if isinstance(temp_b, str): temp_b = temp_b.replace(',','.')
    if float(temp_a) == float(temp_b): return None
    return a if float(temp_a) > float(temp_b) else b 
def compare_one(a, b):
    a_value = a
    b_value = b

    if isinstance(a, str):
        a_value = float(a.replace(",", "."))
    if isinstance(b, str):
        b_value = float(b.replace(",", "."))

    if a_value == b_value:
        return None
    if a_value > b_value:
        return a
    return b
Module(
  FuncDef("compare_one", Params("a", "b"),
    Assign(Name("a_value"), Name("a"))
    Assign(Name("b_value"), Name("b"))
    If(Call(Name("isinstance"), Name("a"), Name("str")),
      Assign(
        Name("a_value"),
        Call(
          Name("float"),
          Call(Attribute(Name("a"), "replace"), Str(","), Str(".")))),
      )
    If(Call(Name("isinstance"), Name("b"), Name("str")),
      Assign(
        Name("b_value"),
        Call(
          Name("float"),
          Call(Attribute(Name("b"), "replace"), Str(","), Str(".")))),
      )
    If(Compare(Name("a_value"), CmpOp("==", Name("b_value"))),
      Return(NoneVal),
      )
    If(Compare(Name("a_value"), CmpOp(">", Name("b_value"))),
      Return(Name("a")),
      )
    Return(Name("b"))))
