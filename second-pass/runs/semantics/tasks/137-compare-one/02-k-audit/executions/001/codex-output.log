+requires "verification.k"
+
+module STAGE4-GROUND
+  imports VERIFICATION
+
+  claim <k> runCompare(1, 2) => 2 </k>
+        <env> 0 </env>
+        <scopes> 0 |-> scope(.Map, parent(-1))
+                  -1 |-> builtinsScope </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <heap> .Map </heap>
+        <heapLoc> 0 </heapLoc>
+        <stack> .List </stack>
+        <ret> noRet </ret>
+        <exc> NoExc </exc>
+        <exit-code> 0 </exit-code>
+    [label(ground-int)]
+
+  claim <k> runCompare(3.0, 3.0) => noneV </k>
+        <env> 0 </env>
+        <scopes> 0 |-> scope(.Map, parent(-1))
+                  -1 |-> builtinsScope </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <heap> .Map </heap>
+        <heapLoc> 0 </heapLoc>
+        <stack> .List </stack>
+        <ret> noRet </ret>
+        <exc> NoExc </exc>
+        <exit-code> 0 </exit-code>
+    [label(ground-float-equal)]
+
+  // Runtime value for "2,3": ASCII codes 50, 44, 51.
+  claim <k> runCompare(
+              1,
+              str(iCons(50, iCons(44, iCons(51, .IntSeq)))))
+          => str(iCons(50, iCons(44, iCons(51, .IntSeq)))) </k>
+        <env> 0 </env>
+        <scopes> 0 |-> scope(.Map, parent(-1))
+                  -1 |-> builtinsScope </scopes>
+        <scopeLoc> 1 </scopeLoc>
+        <heap> .Map </heap>
+        <heapLoc> 0 </heapLoc>
+        <stack> .List </stack>
+        <ret> noRet </ret>
+        <exc> NoExc </exc>
+        <exit-code> 0 </exit-code>
+    [label(ground-int-str)]
+endmodule
