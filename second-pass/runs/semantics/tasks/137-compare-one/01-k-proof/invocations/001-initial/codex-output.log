diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..3ca25f95d10af72ea3111db991faf509b095c9fb
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,14 @@
+def compare_one(a, b):
+    a_value = a
+    b_value = b
+
+    if isinstance(a, str):
+        a_value = float(a.replace(",", "."))
+    if isinstance(b, str):
+        b_value = float(b.replace(",", "."))
+
+    if a_value == b_value:
+        return None
+    if a_value > b_value:
+        return a
+    return b
