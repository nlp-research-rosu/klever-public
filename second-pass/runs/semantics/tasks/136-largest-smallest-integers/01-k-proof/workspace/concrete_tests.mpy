Module(
  FuncDef("largest_smallest_integers", Params("lst"),
    Assign(Name("largest_negative"), Int(0))
    Assign(Name("smallest_positive"), Int(0))
    Assign(Name("value"), Int(0))
    For(Name("value"), Name("lst"),
      If(Compare(Name("value"), CmpOp("<", Int(0))),
        If(BoolOp(
          "or",
          Compare(Name("largest_negative"), CmpOp("==", Int(0))),
          Compare(Name("value"), CmpOp(">", Name("largest_negative")))),
          Assign(Name("largest_negative"), Name("value")),
          ),
        )
      If(Compare(Name("value"), CmpOp(">", Int(0))),
        If(BoolOp(
          "or",
          Compare(Name("smallest_positive"), CmpOp("==", Int(0))),
          Compare(Name("value"), CmpOp("<", Name("smallest_positive")))),
          Assign(Name("smallest_positive"), Name("value")),
          ),
        ))
    If(Compare(Name("largest_negative"), CmpOp("==", Int(0))),
      Assign(Name("largest_negative"), NoneVal),
      )
    If(Compare(Name("smallest_positive"), CmpOp("==", Int(0))),
      Assign(Name("smallest_positive"), NoneVal),
      )
    Return(
      TupleExpr(Name("largest_negative"), Name("smallest_positive"))))
  Assert(
    Compare(
      Call(
        Name("largest_smallest_integers"),
        ListExpr(Int(2), Int(4), Int(1), Int(3), Int(5), Int(7))),
      CmpOp("==", TupleExpr(NoneVal, Int(1)))))
  Assert(
    Compare(
      Call(Name("largest_smallest_integers"), ListExpr()),
      CmpOp("==", TupleExpr(NoneVal, NoneVal))))
  Assert(
    Compare(
      Call(Name("largest_smallest_integers"), ListExpr(Int(0))),
      CmpOp("==", TupleExpr(NoneVal, NoneVal))))
  Assert(
    Compare(
      Call(
        Name("largest_smallest_integers"),
        ListExpr(
          UnaryOp("-", Int(5)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(9)))),
      CmpOp("==", TupleExpr(UnaryOp("-", Int(2)), NoneVal))))
  Assert(
    Compare(
      Call(
        Name("largest_smallest_integers"),
        ListExpr(
          UnaryOp("-", Int(1)),
          Int(8),
          UnaryOp("-", Int(3)),
          Int(2),
          Int(0))),
      CmpOp("==", TupleExpr(UnaryOp("-", Int(1)), Int(2))))))
