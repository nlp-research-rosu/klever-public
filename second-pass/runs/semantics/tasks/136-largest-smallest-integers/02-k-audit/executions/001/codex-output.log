    24	printf 'concrete.k source rules in proof definition=%s expected=0\n' "$concrete_count"
    25	if [[ "$concrete_count" -ne 0 ]]; then
    26	  status=1
    27	fi
    28	
    29	printf 'STAGE: proof-local guard overlap, coverage, and source-equation checks\n'
    30	printf 'RUN: python3 /audit-output/evidence/extension_equation_checks.py\n'
    31	python3 /audit-output/evidence/extension_equation_checks.py
    32	equation_status=$?
    33	printf 'EXIT equation checks: %d\n' "$equation_status"
    34	if [[ "$equation_status" -ne 0 ]]; then
    35	  status=1
    36	fi
    37	
    38	printf 'STAGE: candidate proof-local special attributes\n'
