+if [[ "$haskell_status" -ne 0 ]]; then
+  status=1
+fi
+
+printf 'STAGE: independently run each positive target claim\n'
+printf 'RUN: kprove spec.k --definition fresh-verification-kompiled --spec-module SPEC --claims SPEC.scan-loop\n'
+(
+  cd "$scratch" || exit 98
