+printf 'concrete.k source rules in proof definition=%s expected=0\n' "$concrete_count"
+if [[ "$concrete_count" -ne 0 ]]; then
+  status=1
+fi
+
+printf 'STAGE: proof-local guard overlap, coverage, and source-equation checks\n'
