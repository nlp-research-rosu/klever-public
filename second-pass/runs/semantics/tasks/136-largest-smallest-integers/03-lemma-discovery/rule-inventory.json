      "start_line": 10,
      "text": "  rule intValue(I:Int) => I"
    },
    {
      "attributes": [
        "priority(40)"
      ],
      "end_line": 15,
      "module": "VERIFICATION",
      "normalized_sha256": "5b53e5e1e7c389a2532855b2ec7b9b198ac32e2c188993cc5f36766b5113bf5f",
      "source_rule_id": "rule-5b53e5e1e7c389a2532855b2ec7b9b198ac32e2c188993cc5f36766b5113bf5f",
      "start_line": 12,
      "text": "  rule <k> #iterNext(list(vCons(V:Val, REST:ValSeq)))\n        => #iterYield(intValue(V), list(REST)) ... </k>\n    requires isInt(V)\n    [priority(40)]"
    },
    {
      "attributes": [],
      "end_line": 39,
      "module": "VERIFICATION",
      "normalized_sha256": "2e6e9b319fe94fe1e7bcb719603e85c97cb59094c8d8db08fbdd30a6920d6b32",
      "source_rule_id": "rule-2e6e9b319fe94fe1e7bcb719603e85c97cb59094c8d8db08fbdd30a6920d6b32",
      "start_line": 23,
      "text": "  rule scanBody\n    => If(Compare(Name(\"value\"), CmpOp(\"<\", Int(0))),\n         If(BoolOp(\"or\",\n              Compare(Name(\"largest_negative\"), CmpOp(\"==\", Int(0))),\n              Compare(Name(\"value\"),\n                      CmpOp(\">\", Name(\"largest_negative\")))),\n            Assign(Name(\"largest_negative\"), Name(\"value\")),\n            .Stmts),\n         .Stmts)\n       If(Compare(Name(\"value\"), CmpOp(\">\", Int(0))),\n         If(BoolOp(\"or\",\n              Compare(Name(\"smallest_positive\"), CmpOp(\"==\", Int(0))),\n              Compare(Name(\"value\"),\n                      CmpOp(\"<\", Name(\"smallest_positive\")))),\n            Assign(Name(\"smallest_positive\"), Name(\"value\")),\n            .Stmts),\n         .Stmts)"
    },
    {
      "attributes": [],
      "end_line": 49,
      "module": "VERIFICATION",
      "normalized_sha256": "726d1fc9c79efb9d375f1dc89bb1e237a1a3f799edf75518a8dddad0645f600a",
      "source_rule_id": "rule-726d1fc9c79efb9d375f1dc89bb1e237a1a3f799edf75518a8dddad0645f600a",
      "start_line": 41,
      "text": "  rule finishBody\n    => If(Compare(Name(\"largest_negative\"), CmpOp(\"==\", Int(0))),\n         Assign(Name(\"largest_negative\"), NoneVal),\n         .Stmts)\n       If(Compare(Name(\"smallest_positive\"), CmpOp(\"==\", Int(0))),\n         Assign(Name(\"smallest_positive\"), NoneVal),\n         .Stmts)\n       Return(TupleExpr(Name(\"largest_negative\"),\n                        Name(\"smallest_positive\")))"
    },
    {
      "attributes": [],
      "end_line": 56,
      "module": "VERIFICATION",
      "normalized_sha256": "30e93f55051ebde71ed355b5428333e4efee2a26210e051d8dd481b74c2a5116",
      "source_rule_id": "rule-30e93f55051ebde71ed355b5428333e4efee2a26210e051d8dd481b74c2a5116",
      "start_line": 51,
      "text": "  rule solutionBody\n    => Assign(Name(\"largest_negative\"), Int(0))\n       Assign(Name(\"smallest_positive\"), Int(0))\n       Assign(Name(\"value\"), Int(0))\n       For(Name(\"value\"), Name(\"lst\"), scanBody)\n       finishBody"
    },
    {
      "attributes": [],
      "end_line": 61,
      "module": "VERIFICATION",
