codex
Root cause is confirmed: this container’s process reports a PID that has no matching `/proc/<pid>` entry, while Lean 4.22 resolves its executable through `/proc/<pid>/exe`. The same environment mismatch explains both failures. I’ll use a temporary preload shim that redirects only that lookup to `/proc/self/exe`; it does not modify the project, Base, dependencies, or pinned toolchain.
apply patch
patch: completed
/tmp/lean-proc-self-shim.c
diff --git a//tmp/lean-proc-self-shim.c b//tmp/lean-proc-self-shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..f3a6935692bd5a0dac140252a3ec80dcdcf39e13
--- /dev/null
+++ b//tmp/lean-proc-self-shim.c
@@ -0,0 +1,26 @@
+#define _GNU_SOURCE
+
+#include <ctype.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+    const char prefix[] = "/proc/";
+    const char suffix[] = "/exe";
+    const char *cursor = path;
+
+    if (strncmp(cursor, prefix, sizeof(prefix) - 1) == 0) {
+        cursor += sizeof(prefix) - 1;
+        while (isdigit((unsigned char)*cursor)) {
+            ++cursor;
+        }
+        if (strcmp(cursor, suffix) == 0) {
+            path = "/proc/self/exe";
+        }
+    }
+
+    return syscall(SYS_readlinkat, AT_FDCWD, path, buffer, size);
+}
