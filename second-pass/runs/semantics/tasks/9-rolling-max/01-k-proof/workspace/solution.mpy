Module(
  ImportFrom("typing", "List")
  FuncDef("rolling_max", Params("numbers"),
    Expr(
      Str(
        "Return the maximum seen so far at every position in numbers."))
    Assign(Name("result"), ListExpr())
    Assign(Name("first"), Bool(true))
    Assign(Name("maximum"), Int(0))
    Assign(Name("number"), Int(0))
    For(Name("number"), Name("numbers"),
      If(Name("first"),
        Assign(Name("maximum"), Name("number"))
        Assign(Name("first"), Bool(false)),
        Assign(
          Name("maximum"),
          Call(Name("max"), Name("maximum"), Name("number"))))
      Expr(Call(Attribute(Name("result"), "append"), Name("maximum"))))
    Return(Name("result"))))
