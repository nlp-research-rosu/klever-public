Module(
  ImportFrom("typing", "List")
  FuncDef("rolling_max", Params("numbers"),
    Expr(
      Str(
        "Return the maximum seen so far at every position in numbers."))
    Assign(Name("result"), ListExpr())
    Assign(Name("first"), Bool(true))
    Assign(Name("maximum"), Int(0))
    Assign(Name("number"), Int(0))
    For(Name("number"), Name("numbers"),
      If(Name("first"),
        Assign(Name("maximum"), Name("number"))
        Assign(Name("first"), Bool(false)),
        Assign(
          Name("maximum"),
          Call(Name("max"), Name("maximum"), Name("number"))))
      Expr(Call(Attribute(Name("result"), "append"), Name("maximum"))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("rolling_max"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("rolling_max"),
        ListExpr(Int(1), Int(2), Int(3), Int(2), Int(3), Int(4), Int(2))),
      CmpOp(
        "==",
        ListExpr(Int(1), Int(2), Int(3), Int(3), Int(3), Int(4), Int(4)))))
  Assert(
    Compare(
      Call(
        Name("rolling_max"),
        ListExpr(
          UnaryOp("-", Int(8)),
          UnaryOp("-", Int(9)),
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(10)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(8)),
          UnaryOp("-", Int(8)),
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(3))))))
  Assert(
    Compare(
      Call(
        Name("rolling_max"),
        ListExpr(Int(5), Int(5), Int(4), Int(6), Int(1))),
      CmpOp("==", ListExpr(Int(5), Int(5), Int(5), Int(6), Int(6))))))
