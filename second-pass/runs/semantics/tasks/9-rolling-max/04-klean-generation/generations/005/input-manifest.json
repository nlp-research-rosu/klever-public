{
  "definitions": [
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 17,
      "module": "VERIFICATION",
      "normalized_sha256": "f8c202908b80c2c388b99c1be16abaf8f9c4b8fc3cee914fff74d55d480342ef",
      "rationale": "Macro equation defining the named K term for the translated rolling_max loop body.",
      "source_rule_id": "rule-f8c202908b80c2c388b99c1be16abaf8f9c4b8fc3cee914fff74d55d480342ef",
      "start_line": 10,
      "text": "  rule rollingMaxLoopBody =>\n    If(Name(\"first\"),\n       Assign(Name(\"maximum\"), Name(\"number\"))\n       Assign(Name(\"first\"), Bool(false)),\n       Assign(Name(\"maximum\"),\n              Call(Name(\"max\"),\n                   (Name(\"maximum\"), Name(\"number\"), .Exprs))))\n    Expr(Call(Attribute(Name(\"result\"), \"append\"), (Name(\"maximum\"), .Exprs)))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 27,
      "module": "VERIFICATION",
      "normalized_sha256": "00812545b60ae4c5d7fd77d9fdecc79cc044f1d1404fe725a3575e70fbef4262",
      "rationale": "Macro equation defining the named K term for the complete translated function body.",
      "source_rule_id": "rule-00812545b60ae4c5d7fd77d9fdecc79cc044f1d1404fe725a3575e70fbef4262",
      "start_line": 20,
      "text": "  rule rollingMaxBody =>\n    Expr(Str(\"Return the maximum seen so far at every position in numbers.\"))\n    Assign(Name(\"result\"), ListExpr(.Exprs))\n    Assign(Name(\"first\"), Bool(true))\n    Assign(Name(\"maximum\"), Int(0))\n    Assign(Name(\"number\"), Int(0))\n    For(Name(\"number\"), Name(\"numbers\"), rollingMaxLoopBody)\n    Return(Name(\"result\"))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 32,
      "module": "VERIFICATION",
      "normalized_sha256": "f7be3d212c3d1592ebdf79a22df3ecc6771305d4bb7565346a02fe6bea376f6d",
      "rationale": "Macro equation defining the named translated module term used by the end-to-end claim.",
      "source_rule_id": "rule-f7be3d212c3d1592ebdf79a22df3ecc6771305d4bb7565346a02fe6bea376f6d",
      "start_line": 30,
      "text": "  rule rollingMaxModule =>\n    Module(ImportFrom(\"typing\", (\"List\", .ParamNames))\n           FuncDef(\"rolling_max\", Params((\"numbers\", .ParamNames)), rollingMaxBody))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 37,
      "module": "VERIFICATION",
      "normalized_sha256": "0d4c46a7163f5c5ee21b30bb397721cb0628a5455c22404392aa20e5e8d42cb8",
      "rationale": "Base equation for the structural embedding of an empty symbolic integer sequence into ValSeq.",
      "source_rule_id": "rule-0d4c46a7163f5c5ee21b30bb397721cb0628a5455c22404392aa20e5e8d42cb8",
      "start_line": 37,
      "text": "  rule intsVS(.IntSeq)                => .ValSeq"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 38,
      "module": "VERIFICATION",
      "normalized_sha256": "90183a8c4394bedf217e3827729c4a9e6cb5d3a2559e7db0e395c06351a69a52",
      "rationale": "Recursive equation for the structural embedding of a nonempty symbolic integer sequence into ValSeq.",
      "source_rule_id": "rule-90183a8c4394bedf217e3827729c4a9e6cb5d3a2559e7db0e395c06351a69a52",
      "start_line": 38,
      "text": "  rule intsVS(iCons(I:Int, R:IntSeq)) => vCons(I, intsVS(R))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 53,
      "module": "VERIFICATION",
      "normalized_sha256": "28c461bc215c70d08c69af6f83df7c19347afe113c4faac903bffd93b1ebaf5b",
      "rationale": "Defining equation for the first-element case of the next rolling maximum summary.",
      "source_rule_id": "rule-28c461bc215c70d08c69af6f83df7c19347afe113c4faac903bffd93b1ebaf5b",
      "start_line": 53,
      "text": "  rule nextRolling(true,  _M:Int, I:Int) => I"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 54,
      "module": "VERIFICATION",
      "normalized_sha256": "031f07f511776c57805e9703f5aacf45f3bcdcbdeb67a8526a9cf0edef797337",
      "rationale": "Defining equation for updating an already initialized rolling maximum with maxInt.",
      "source_rule_id": "rule-031f07f511776c57805e9703f5aacf45f3bcdcbdeb67a8526a9cf0edef797337",
      "start_line": 54,
      "text": "  rule nextRolling(false,  M:Int, I:Int) => maxInt(M, I)"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 57,
      "module": "VERIFICATION",
      "normalized_sha256": "93ce0d1418cc4746b2a77cb93cd1fae392dee7212adcba594e7beb78ce3b65ac",
      "rationale": "Base equation of the accumulator-style mathematical rolling-maximum summary.",
      "source_rule_id": "rule-93ce0d1418cc4746b2a77cb93cd1fae392dee7212adcba594e7beb78ce3b65ac",
      "start_line": 57,
      "text": "  rule rollingAcc(.IntSeq, _F:Bool, _M:Int, ACC:ValSeq) => ACC"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 60,
      "module": "VERIFICATION",
      "normalized_sha256": "4988a36c4820a41daeb7519719fcab344fb535b61db16dcb9890a7570791b1bd",
      "rationale": "Recursive equation of the accumulator-style mathematical rolling-maximum summary.",
      "source_rule_id": "rule-4988a36c4820a41daeb7519719fcab344fb535b61db16dcb9890a7570791b1bd",
      "start_line": 58,
      "text": "  rule rollingAcc(iCons(I:Int, R:IntSeq), F:Bool, M:Int, ACC:ValSeq)\n    => rollingAcc(R, false, nextRolling(F, M, I),\n                  valSeqConcat(ACC, vCons(nextRolling(F, M, I), .ValSeq)))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 66,
      "module": "VERIFICATION",
      "normalized_sha256": "21e311b677245a3588f3fdf17486b6433041519d4dfc2db17823ead5b4f5000c",
      "rationale": "Base equation defining firstAfter on an empty remaining sequence.",
      "source_rule_id": "rule-21e311b677245a3588f3fdf17486b6433041519d4dfc2db17823ead5b4f5000c",
      "start_line": 66,
      "text": "  rule firstAfter(.IntSeq, F:Bool)                 => F"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 67,
      "module": "VERIFICATION",
      "normalized_sha256": "47cd64e11bfe4d5400e0c8493531f3dfdc997241fb44f11ac0ea1a85b059fbc3",
      "rationale": "Nonempty structural equation defining that processing an element clears the first-element flag.",
      "source_rule_id": "rule-47cd64e11bfe4d5400e0c8493531f3dfdc997241fb44f11ac0ea1a85b059fbc3",
      "start_line": 67,
      "text": "  rule firstAfter(iCons(_I:Int, _R:IntSeq), _F:Bool) => false"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 70,
      "module": "VERIFICATION",
      "normalized_sha256": "c78b46c124c162a2ce4be242da78ad71608ea739808b453e38a3d06dda083403",
      "rationale": "Base equation defining the final maximum summary when no input remains.",
      "source_rule_id": "rule-c78b46c124c162a2ce4be242da78ad71608ea739808b453e38a3d06dda083403",
      "start_line": 70,
      "text": "  rule maximumAfter(.IntSeq, _F:Bool, M:Int) => M"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 72,
      "module": "VERIFICATION",
      "normalized_sha256": "a717a58b1e928e5a992ae9697da1d2e92f5cd196dea1d865d7d01c1e95feb44f",
      "rationale": "Recursive equation defining the final maximum after consuming an input head.",
      "source_rule_id": "rule-a717a58b1e928e5a992ae9697da1d2e92f5cd196dea1d865d7d01c1e95feb44f",
      "start_line": 71,
      "text": "  rule maximumAfter(iCons(I:Int, R:IntSeq), F:Bool, M:Int)\n    => maximumAfter(R, false, nextRolling(F, M, I))"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 75,
      "module": "VERIFICATION",
      "normalized_sha256": "10994d65e9ac31b3b7356400325c3cd65b9fdc2215f9251d061e05ef206dd524",
      "rationale": "Base equation defining the final loop-variable value when no input remains.",
      "source_rule_id": "rule-10994d65e9ac31b3b7356400325c3cd65b9fdc2215f9251d061e05ef206dd524",
      "start_line": 75,
      "text": "  rule numberAfter(.IntSeq, N:Int)                => N"
    },
    {
      "attributes": [],
      "classification": "DEFINITION",
      "end_line": 76,
      "module": "VERIFICATION",
      "normalized_sha256": "68d75551ff66412917fa7bf8014d718e942c5b72b9c02eaf2ccd715cb817f649",
      "rationale": "Recursive equation defining the final loop-variable value as the last consumed integer.",
      "source_rule_id": "rule-68d75551ff66412917fa7bf8014d718e942c5b72b9c02eaf2ccd715cb817f649",
      "start_line": 76,
      "text": "  rule numberAfter(iCons(I:Int, R:IntSeq), _N:Int) => numberAfter(R, I)"
    }
  ],
