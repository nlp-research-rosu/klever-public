--- /dev/null
+++ b//tmp/audit-work/app_path_test.c
@@ -0,0 +1,18 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char buffer[4096];
+  char path[128];
+  snprintf(path, sizeof(path), "/proc/%d/exe", getpid());
+  ssize_t length = readlink(path, buffer, sizeof(buffer) - 1);
+  if (length < 0) {
+    fprintf(stderr, "readlink failed: %s\n", strerror(errno));
+    return 1;
+  }
+  buffer[length] = '\0';
+  printf("%s\n", buffer);
+  return 0;
+}
