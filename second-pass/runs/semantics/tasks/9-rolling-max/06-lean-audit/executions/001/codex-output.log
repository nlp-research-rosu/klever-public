+example : Proof.«firstAfter(_,_)_VERIFICATION_Bool_IntSeq_Bool» one true = false := rfl
+example : Proof.«firstAfter(_,_)_VERIFICATION_Bool_IntSeq_Bool» one false = false := rfl
