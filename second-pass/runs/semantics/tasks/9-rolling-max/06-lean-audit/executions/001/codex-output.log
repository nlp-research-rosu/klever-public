diff --git a/evidence/lean-toolchain-workaround.txt b/evidence/lean-toolchain-workaround.txt
new file mode 100644
index 0000000000000000000000000000000000000000..64764de9e0ca604f65aeaee1c9d432df9fa0dd21
--- /dev/null
+++ b/evidence/lean-toolchain-workaround.txt
@@ -0,0 +1,10 @@
+The audit container exposes /proc/self/exe but not /proc/<getpid()>/exe.
+Lean 4.22.0's IO.appPath uses the latter and initially failed with:
+  error: failed to locate application
+
+The audit-local LD_PRELOAD shim in /tmp/audit-work/libproc-self-exe.so retries
+only missing /proc/<pid>/exe readlink calls as /proc/self/exe. The copied
+toolchain launchers under /tmp/audit-work/lean-overlay/bin remain linked to the
+pinned /opt/elan/toolchains/leanprover--lean4---v4.22.0 libraries. With this
+container compatibility shim, `lean --version` reports commit
+ba2cbbf09d4978f416e0ebd1fceeebc2c4138c05 and Lake reports Lean 4.22.0.

diff --git a//tmp/audit-work/app_path_test.c b//tmp/audit-work/app_path_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..c97270c459e16b895ef52ad4217e6dbca280bf4a
--- /dev/null
+++ b//tmp/audit-work/app_path_test.c
@@ -0,0 +1,18 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char buffer[4096];
+  char path[128];
+  snprintf(path, sizeof(path), "/proc/%d/exe", getpid());
+  ssize_t length = readlink(path, buffer, sizeof(buffer) - 1);
+  if (length < 0) {
+    fprintf(stderr, "readlink failed: %s\n", strerror(errno));
+    return 1;
+  }
+  buffer[length] = '\0';
+  printf("%s\n", buffer);
+  return 0;
+}
diff --git a//tmp/audit-work/proc_self_exe_shim.c b//tmp/audit-work/proc_self_exe_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..9e85295aae23edad3a19f56d85c1b2ffb1e55033
--- /dev/null
+++ b//tmp/audit-work/proc_self_exe_shim.c
@@ -0,0 +1,24 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink = NULL;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  ssize_t result = real_readlink(path, buffer, size);
+  if (result < 0 && errno == ENOENT && strncmp(path, "/proc/", 6) == 0) {
+    size_t length = strlen(path);
+    if (length > 10 && strcmp(path + length - 4, "/exe") == 0) {
+      result = real_readlink("/proc/self/exe", buffer, size);
+    }
+  }
+  return result;
+}
