+ln -s /opt/elan/toolchains/leanprover--lean4---v4.22.0/lib /tmp/audit-work/lean-overlay/lib
+ln -s /opt/elan/toolchains/leanprover--lean4---v4.22.0/src /tmp/audit-work/lean-overlay/src
+ln -s /opt/elan/toolchains/leanprover--lean4---v4.22.0/include /tmp/audit-work/lean-overlay/include
+gcc -shared -fPIC /audit-output/evidence/proc_self_exe_shim.c -ldl -o /tmp/audit-work/libproc-self-exe.so
+LD_PRELOAD=/tmp/audit-work/libproc-self-exe.so PATH=/tmp/audit-work/lean-overlay/bin:$PATH lean --version
