+    ),
+    "k_audit_sha256": match(
+        sha256_tree(K_AUDIT), recorded["k_audit_sha256"]
+    ),
+    "klean_generation_sha256": match(
+        sha256_tree(GENERATION), recorded["klean_generation_sha256"]
+    ),
+    "generated_tree_sha256": match(
