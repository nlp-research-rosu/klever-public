+
+-- Proof.final inhabits the exact fixed target, not a copied theorem.
+example :
+    Klean9RollingMax.Lemmas.targetStatement
+      Proof.«firstAfter(_,_)_VERIFICATION_Bool_IntSeq_Bool» :=
+  Proof.final
