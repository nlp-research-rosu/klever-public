+    Proof.«firstAfter(_,_)_VERIFICATION_Bool_IntSeq_Bool» empty true := by
+  decide
+
+-- Adversarial mutation 2: identity on the flag also proves the exported
+-- equation, but fails the frozen nonempty-input rule.
+private def identityFlag : SortIntSeq → SortBool → SortBool :=
