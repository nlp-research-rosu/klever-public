        tree_digest(base) == tree_digest(reference_base)
    ),
    "fresh_base_target_matches_generator_manifest": (
        target_statement(base) == manifest["target"]
    ),
    "candidate_does_not_define_targetStatement": (
        re.search(r"(?m)^\s*def\s+targetStatement\b", proof) is None
    ),
    "candidate_does_not_open_generated_target_namespace": (
        "namespace Klean9RollingMax.Lemmas" not in proof
    ),
    "candidate_has_exactly_one_parameter_definition": (
        len(
            re.findall(
                r"(?m)^def\s+«firstAfter\\(_,\\)_VERIFICATION_"
                r"Bool_IntSeq_Bool»\\s*:",
                proof,
            )
        )
        == 1
    ),
    "candidate_has_exactly_one_final_theorem": (
        len(re.findall(r"(?m)^theorem\s+final\s*:", proof)) == 1
    ),
    "final_names_fixed_generated_target": (
        "Klean9RollingMax.Lemmas.targetStatement "
        "«firstAfter(_,_)_VERIFICATION_Bool_IntSeq_Bool» := by"
        in proof
    ),
    "no_forbidden_candidate_tokens": all(
        not matches for matches in forbidden_matches.values()
    ),
}

result = {
    "checks": checks,

diff --git a//tmp/audit-work/app_path_test.c b//tmp/audit-work/app_path_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..c97270c459e16b895ef52ad4217e6dbca280bf4a
--- /dev/null
+++ b//tmp/audit-work/app_path_test.c
@@ -0,0 +1,18 @@
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+int main(void) {
+  char buffer[4096];
+  char path[128];
+  snprintf(path, sizeof(path), "/proc/%d/exe", getpid());
+  ssize_t length = readlink(path, buffer, sizeof(buffer) - 1);
+  if (length < 0) {
+    fprintf(stderr, "readlink failed: %s\n", strerror(errno));
+    return 1;
+  }
+  buffer[length] = '\0';
+  printf("%s\n", buffer);
+  return 0;
+}
diff --git a//tmp/audit-work/proc_self_exe_shim.c b//tmp/audit-work/proc_self_exe_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..9e85295aae23edad3a19f56d85c1b2ffb1e55033
--- /dev/null
+++ b//tmp/audit-work/proc_self_exe_shim.c
@@ -0,0 +1,24 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink = NULL;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  ssize_t result = real_readlink(path, buffer, size);
+  if (result < 0 && errno == ENOENT && strncmp(path, "/proc/", 6) == 0) {
+    size_t length = strlen(path);
+    if (length > 10 && strcmp(path + length - 4, "/exe") == 0) {
+      result = real_readlink("/proc/self/exe", buffer, size);
+    }
+  }
+  return result;
+}
