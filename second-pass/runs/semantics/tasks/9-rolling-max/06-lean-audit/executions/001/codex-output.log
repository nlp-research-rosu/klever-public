+import Proof
+import Klean9RollingMax.Func
+
+open Klean9RollingMax
+
+private def empty : SortIntSeq :=
+  SortIntSeq.«.IntSeq_MPY-CORE_IntSeq»
+
+private def one : SortIntSeq :=
