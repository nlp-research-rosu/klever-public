--- /dev/null
+++ b/evidence/lean-toolchain-workaround.txt
@@ -0,0 +1,11 @@
+The audit container exposes /proc/self/exe but not /proc/<getpid()>/exe.
+Lean 4.22.0's IO.appPath uses the latter and initially failed with:
+  error: failed to locate application
+
+The audit-local LD_PRELOAD shim in /tmp/audit-work/libproc-self-exe.so maps
+/proc/<pid>/exe readlink calls to /proc/self/exe. (The PID namespace can make
+the numeric path either absent or refer to an unrelated visible process.) The copied
+toolchain launchers under /tmp/audit-work/lean-overlay/bin remain linked to the
+pinned /opt/elan/toolchains/leanprover--lean4---v4.22.0 libraries. With this
+container compatibility shim, `lean --version` reports commit
+ba2cbbf09d4978f416e0ebd1fceeebc2c4138c05 and Lake reports Lean 4.22.0.
diff --git a/evidence/proc_self_exe_shim.c b/evidence/proc_self_exe_shim.c
new file mode 100644
index 0000000000000000000000000000000000000000..27067a62515025ef0b589562f91133f4c2716ee1
--- /dev/null
+++ b/evidence/proc_self_exe_shim.c
@@ -0,0 +1,24 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <stddef.h>
+#include <string.h>
+#include <sys/types.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink = NULL;
+  if (real_readlink == NULL) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  size_t length = strlen(path);
+  if (strncmp(path, "/proc/", 6) == 0
+      && strcmp(path, "/proc/self/exe") != 0
+      && length > 10
+      && strcmp(path + length - 4, "/exe") == 0) {
+    return real_readlink("/proc/self/exe", buffer, size);
+  }
+  return real_readlink(path, buffer, size);
+}

codex
The fresh Stage 5 project passed static isolation checks. Its first build attempt exposed a second PID-namespace edge case in Lean’s application-path lookup (the numeric `/proc/<pid>/exe` could resolve to an unrelated visible process); I tightened the audit-local compatibility shim to map numeric process paths deterministically to `/proc/self/exe`. Repeated Lean/Lake version checks now resolve the pinned 4.22.0 toolchain consistently, and I’m rerunning the required clean build from scratch.
exec
/bin/bash -lc 'export LD_PRELOAD=/tmp/audit-work/libproc-self-exe.so
export PATH=/tmp/audit-work/lean-overlay/bin:$PATH
cd /tmp/audit-work/stage5-fresh
lake clean > /audit-output/evidence/08_lake_clean.log 2>&1
clean_status=$?
printf '"'%s\\n' \""'$clean_status" > /audit-output/evidence/08_lake_clean.exit-code
if test ! -e /tmp/klean-generated-build; then printf '"'%s\\n' 'Base absolute build directory absent after lake clean' > /audit-output/evidence/08_lake_clean.postcondition; else find /tmp/klean-generated-build -maxdepth 3 -printf '%y %p\\n' | sort > /audit-output/evidence/08_lake_clean.postcondition; fi
lake build > /audit-output/evidence/09_lake_build.log 2>&1
build_status="'$?
printf '"'%s\\n' \""'$build_status" > /audit-output/evidence/09_lake_build.exit-code
exit "$build_status"' in /audit-output
