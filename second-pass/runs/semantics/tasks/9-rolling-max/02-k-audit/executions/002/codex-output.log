+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0  |-> scope(("rolling_max" |->
+                       closureVal(("numbers", .ParamNames), rollingMaxBody, 0)),
+                    parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
