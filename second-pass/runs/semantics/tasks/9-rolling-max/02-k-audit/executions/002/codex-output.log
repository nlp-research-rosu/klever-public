+      =>
+      (0  |-> scope(("rolling_max" |->
+                       closureVal(("numbers", .ParamNames), rollingMaxBody, 0)),
+                    parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      (0 |-> list(vCons(-8, vCons(-8, vCons(-3, vCons(-3, vCons(-3, .ValSeq)))))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [entry-branches]:
+    <k> #loadAll(rollingMaxModule)
+         ~> Call(Name("rolling_max"),
+                 (list(intsVS(iCons(5, iCons(5, iCons(4, iCons(6, iCons(1, .IntSeq))))))),
+                  .Exprs))
+      => ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0  |-> scope(.Map, parent(-1))
+       -1 |-> builtinsScope)
+      =>
+      (0  |-> scope(("rolling_max" |->
+                       closureVal(("numbers", .ParamNames), rollingMaxBody, 0)),
+                    parent(-1))
+       -1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      (0 |-> list(vCons(5, vCons(5, vCons(5, vCons(6, vCons(6, .ValSeq)))))))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
