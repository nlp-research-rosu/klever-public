+        lines = text.splitlines()
+        print(
+            path,
+            "sha256",
+            sha256(path),
+            "bytes",
+            path.stat().st_size,
+            "lines",
+            len(lines),
+            "nul_count",
+            text.count("\x00"),
+        )
