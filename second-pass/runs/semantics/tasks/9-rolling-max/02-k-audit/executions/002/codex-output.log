+            "lines",
+            len(lines),
+            "nul_count",
+            text.count("\x00"),
+        )
+        marker_counts = {
+            marker: len(re.findall(re.escape(marker), text))
+            for marker in [
+                "RESULT: KPROVE_PASSED",
+                "#Top",
+                "WarnStuckClaimState",
+                "timed out",
+                "failed in",
+                " exited ",
+            ]
+        }
