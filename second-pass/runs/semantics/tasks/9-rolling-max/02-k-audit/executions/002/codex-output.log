diff --git a/evidence/verification-no-iter-bridge.k b/evidence/verification-no-iter-bridge.k
index a9074d1409dc3254d988542407945a614ce2a694..ac4c84407055075cc468c0ca3b2dc24150a3a40e
--- a/evidence/verification-no-iter-bridge.k
+++ b/evidence/verification-no-iter-bridge.k
@@ -1,6 +1,6 @@
 requires "reference-semantics/semantics.k"
 
-module VERIFICATION
+module VERIFICATION-NO-ITER-BRIDGE
   imports MPY
 
   // The exact translated body and loop body from solution.mpy.  Keeping these
@@ -36,16 +36,6 @@
   syntax ValSeq ::= intsVS(IntSeq)
   rule intsVS(.IntSeq)                => .ValSeq
   rule intsVS(iCons(I:Int, R:IntSeq)) => vCons(I, intsVS(R))
-
-  // Expose the symbolic IntSeq constructor at the iterator boundary.  These
-  // are the two defining cases of intsVS, oriented at the consumer so the
-  // prover performs constructor induction instead of retaining only an
-  // opaque equation such as intsVS(INPUT) == .ValSeq.
-  rule <k> #iterNext(list(intsVS(.IntSeq))) => #iterDone ... </k>
-       [priority(40)]
-  rule <k> #iterNext(list(intsVS(iCons(I:Int, R:IntSeq))))
-        => #iterYield(I, list(intsVS(R))) ... </k>
-       [priority(40)]
 
   // Mathematical rolling maximum, written as an accumulator fold so its
   // recursive equation is exactly the loop invariant after one iteration.

apply patch
