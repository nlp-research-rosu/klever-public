+        text = path.read_text(errors="replace")
+        lines = text.splitlines()
+        print(
+            path,
+            "sha256",
+            sha256(path),
+            "bytes",
+            path.stat().st_size,
+            "lines",
+            len(lines),
+            "nul_count",
+            text.count("\x00"),
+        )
+        marker_counts = {
+            marker: len(re.findall(re.escape(marker), text))
+            for marker in [
+                "RESULT: KPROVE_PASSED",
+                "#Top",
+                "WarnStuckClaimState",
+                "timed out",
+                "failed in",
+                " exited ",
+            ]
+        }
+        print("marker_counts", marker_counts)
