    31	    Module(ImportFrom("typing", ("List", .ParamNames))
    32	           FuncDef("rolling_max", Params(("numbers", .ParamNames)), rollingMaxBody))
    33	
    34	  // IntSeq is used as a genuinely symbolic sequence of integer inputs.  This
    35	  // embedding excludes non-integer Val elements at the sort level.
    36	  syntax ValSeq ::= intsVS(IntSeq)
    37	  rule intsVS(.IntSeq)                => .ValSeq
    38	  rule intsVS(iCons(I:Int, R:IntSeq)) => vCons(I, intsVS(R))
    39	
    40	  // Expose the symbolic IntSeq constructor at the iterator boundary.  These
    41	  // are the two defining cases of intsVS, oriented at the consumer so the
    42	  // prover performs constructor induction instead of retaining only an
    43	  // opaque equation such as intsVS(INPUT) == .ValSeq.
    44	  rule <k> #iterNext(list(intsVS(.IntSeq))) => #iterDone ... </k>
    45	       [priority(40)]
    46	  rule <k> #iterNext(list(intsVS(iCons(I:Int, R:IntSeq))))
    47	        => #iterYield(I, list(intsVS(R))) ... </k>
    48	       [priority(40)]
    49	
    50	  // Mathematical rolling maximum, written as an accumulator fold so its
    51	  // recursive equation is exactly the loop invariant after one iteration.
    52	  syntax Int ::= nextRolling(Bool, Int, Int) [function, total]
    53	  rule nextRolling(true,  _M:Int, I:Int) => I
    54	  rule nextRolling(false,  M:Int, I:Int) => maxInt(M, I)
    55	
    56	  syntax ValSeq ::= rollingAcc(IntSeq, Bool, Int, ValSeq) [function, total]
    57	  rule rollingAcc(.IntSeq, _F:Bool, _M:Int, ACC:ValSeq) => ACC
    58	  rule rollingAcc(iCons(I:Int, R:IntSeq), F:Bool, M:Int, ACC:ValSeq)
    59	    => rollingAcc(R, false, nextRolling(F, M, I),
    60	                  valSeqConcat(ACC, vCons(nextRolling(F, M, I), .ValSeq)))
    61	
    62	  // The other loop-carried locals are included in the invariant so the loop
    63	  // lemma describes the complete final local frame, not only the result list.
    64	  syntax Bool ::= firstAfter(IntSeq, Bool) [function, total]
    65	  rule firstAfter(_IS:IntSeq, false)                 => false
    66	  rule firstAfter(.IntSeq, F:Bool)                 => F
    67	  rule firstAfter(iCons(_I:Int, _R:IntSeq), _F:Bool) => false
    68	
    69	  syntax Int ::= maximumAfter(IntSeq, Bool, Int) [function, total]
    70	  rule maximumAfter(.IntSeq, _F:Bool, M:Int) => M
    71	  rule maximumAfter(iCons(I:Int, R:IntSeq), F:Bool, M:Int)
    72	    => maximumAfter(R, false, nextRolling(F, M, I))
    73	
    74	  syntax Int ::= numberAfter(IntSeq, Int) [function, total]
    75	  rule numberAfter(.IntSeq, N:Int)                => N
    76	  rule numberAfter(iCons(I:Int, R:IntSeq), _N:Int) => numberAfter(R, I)
    77	endmodule
