+        actual = outcome(candidate_module.rolling_max, values)
+        if expected != actual:
+            mismatches.append(
+                {
+                    "index": index,
+                    "input": values,
+                    "canonical": expected,
+                    "candidate": actual,
+                }
+            )
+
