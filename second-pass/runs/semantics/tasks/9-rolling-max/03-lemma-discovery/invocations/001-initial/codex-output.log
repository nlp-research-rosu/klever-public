import json
from collections import Counter
inv_path = '/reference/rule-inventory.json'
out_path = '/workspace/trust-boundary.json'
with open(inv_path, encoding='utf-8') as f:
    inv = json.load(f)
with open(out_path, encoding='utf-8') as f:
    out = json.load(f)
allowed = {'DEFINITION','OPERATIONAL_RULE','PROVED_DERIVED_LEMMA','DOMAIN_LEMMA'}
assert list(out) == ['schema_version','inventory_sha256','rules'], list(out)
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert len(out['rules']) == len(inv['rules']) == 18
inv_ids = [r['source_rule_id'] for r in inv['rules']]
out_ids = [r['source_rule_id'] for r in out['rules']]
assert out_ids == inv_ids
assert len(set(out_ids)) == len(out_ids)
for i, r in enumerate(out['rules']):
    assert list(r) == ['source_rule_id','classification','rationale'], (i, list(r))
    assert r['classification'] in allowed
    assert isinstance(r['rationale'], str) and r['rationale'].strip()
for inv_rule, out_rule in zip(inv['rules'], out['rules']):
    if 'simplification' in inv_rule.get('attributes', []):
        assert out_rule['classification'] in {'DEFINITION','DOMAIN_LEMMA'}
print('schema/order/coverage: ok')
print('counts:', dict(Counter(r['classification'] for r in out['rules'])))
print('inventory_sha256:', out['inventory_sha256'])
