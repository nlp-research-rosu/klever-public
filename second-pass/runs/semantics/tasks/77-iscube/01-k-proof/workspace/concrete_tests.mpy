Module(
  FuncDef("iscube", Params("a"),
    Assign(Name("a"), Call(Name("abs"), Name("a")))
    Return(
      Compare(
        BinOp(
          "**",
          Call(
            Name("int"),
            Call(
              Name("round"),
              BinOp("**", Name("a"), BinOp("/", Int(1), Int(3))))),
          Int(3)),
        CmpOp("==", Name("a")))))
  Assert(Compare(Call(Name("iscube"), Int(1)), CmpOp("==", Bool(true))))
  Assert(
    Compare(Call(Name("iscube"), Int(2)), CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("iscube"), UnaryOp("-", Int(1))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(Call(Name("iscube"), Int(64)), CmpOp("==", Bool(true))))
  Assert(Compare(Call(Name("iscube"), Int(0)), CmpOp("==", Bool(true))))
  Assert(
    Compare(Call(Name("iscube"), Int(180)), CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("iscube"), UnaryOp("-", Int(125))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(Call(Name("iscube"), Int(216)), CmpOp("==", Bool(true))))
  Assert(
    Compare(Call(Name("iscube"), Int(217)), CmpOp("==", Bool(false)))))
