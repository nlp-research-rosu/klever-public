===== /candidate/verification.k =====
     1	requires "reference-semantics/semantics.k"
     2	
     3	module ISCube-VERIFICATION
     4	  imports MPY
     5	
     6	  // The reference semantics deliberately leaves symbolic floating-point
     7	  // operations opaque.  These task-local constructors preserve the exact
     8	  // dataflow of 1 / 3, x ** (1 / 3), and round(...) without invoking Float
     9	  // hooks that the Haskell proof backend does not implement.
    10	  syntax Val ::= "oneThirdV" | cubeRootV(Int)
    11	  syntax Int ::= roundedCubeRoot(Int)
    12	    [function, total, symbol(roundedCubeRoot), no-evaluators]
    13	
    14	  rule applyBin("/", 1, 3) => oneThirdV [priority(40)]
    15	  rule applyBin("**", I:Int, oneThirdV) => cubeRootV(I)
    16	  rule applyBuiltin("round", cubeRootV(I:Int), .Vals)
    17	    => roundedCubeRoot(I)
    18	
    19	  // Nonlinear non-negativity is outside the arithmetic fragment discharged
    20	  // reliably by the backend, so expose the four abs normalizations used by
    21	  // the partition claims.
    22	  rule absInt(N *Int N *Int N) => N *Int N *Int N
    23	    requires N >=Int 0
    24	    [simplification]
    25	  rule absInt(0 -Int (N *Int N *Int N)) => N *Int N *Int N
    26	    requires N >Int 0
    27	    [simplification]
    28	  rule absInt(N *Int N *Int N +Int D) => N *Int N *Int N +Int D
    29	    requires N >=Int 0
    30	     andBool D >Int 0
    31	    [simplification]
    32	  rule absInt(0 -Int (N *Int N *Int N +Int D))
    33	    => N *Int N *Int N +Int D
    34	    requires N >=Int 0
    35	     andBool D >Int 0
    36	    [simplification]
    37	
    38	  // Ideal-real summaries for the opaque rounded cube-root operation.  The
    39	  // second rule covers every integer strictly between N^3 and (N+1)^3 by
    40	  // writing it N^3 + D, where 0 < D < 3*N^2 + 3*N + 1.
    41	  rule
    42	    (roundedCubeRoot(N *Int N *Int N) ^Int 3)
    43	      ==Int (N *Int N *Int N)
    44	    => true
    45	    requires N >=Int 0
    46	    [simplification]
    47	
    48	  rule
    49	    (roundedCubeRoot(N *Int N *Int N +Int D) ^Int 3)
    50	      ==Int (N *Int N *Int N +Int D)
    51	    => false
    52	    requires N >=Int 0
    53	     andBool D >Int 0
    54	     andBool D <Int (3 *Int N *Int N +Int 3 *Int N +Int 1)
    55	    [simplification]
    56	
    57	  // This closure is a literal K rendering of solution.mpy, factored out so
    58	  // each proof claim starts from the same loaded module scope.
    59	  syntax Val ::= "iscubeClosure" [function, total]
    60	  rule iscubeClosure =>
    61	    closureVal(
    62	      ("a", .ParamNames),
    63	      Assign(Name("a"), Call(Name("abs"), Name("a")))
    64	      Return(
    65	        Compare(
    66	          BinOp(
    67	            "**",
    68	            Call(
    69	              Name("int"),
    70	              Call(
    71	                Name("round"),
    72	                BinOp("**", Name("a"),
    73	                  BinOp("/", Int(1), Int(3))))),
    74	            Int(3)),
    75	          CmpOp("==", Name("a"))))
    76	      .Stmts,
    77	      0)
    78	endmodule
