+#!/usr/bin/env bash
+set -uo pipefail
+
+cd /tmp/audit-work/candidate || exit 99
+overall=0
+
+run() {
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf 'EXIT_STATUS: %s\n' "$status"
