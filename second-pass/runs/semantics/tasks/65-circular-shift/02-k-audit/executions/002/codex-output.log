@@ -0,0 +1,47 @@
+requires "verification.k"
+
+module AUDIT-PINNING-SPEC
+  imports CIRCULAR-SHIFT-VERIFICATION
+
+  // The constructor region below is compared mechanically with the trusted
+  // regeneration of solution.mpy by 04_constructor_compare.py.
+  claim [module-load-pins-closure]:
+    <k>
+      #loadAll(
+        // BEGIN_REGENERATED_MODULE
+        Module(
+          FuncDef("circular_shift", Params("x", "shift"),
+            Assign(Name("s"), Call(Name("str"), Name("x")))
+            If(Compare(Name("shift"), CmpOp(">", Call(Name("len"), Name("s")))),
+              Return(
+                Subscript(
+                  Name("s"),
+                  Slice(NoBound, NoBound, UnaryOp("-", Int(1))))),
+              .Stmts)
+            Return(
+              BinOp(
+                "+",
+                Subscript(
+                  Name("s"),
+                  Slice(UnaryOp("-", Name("shift")), NoBound, NoBound)),
+                Subscript(
+                  Name("s"),
+                  Slice(NoBound, UnaryOp("-", Name("shift")), NoBound))))))
+        // END_REGENERATED_MODULE
+      )
+      =>
+      .K
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map => "circular_shift" |-> circularShiftClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
