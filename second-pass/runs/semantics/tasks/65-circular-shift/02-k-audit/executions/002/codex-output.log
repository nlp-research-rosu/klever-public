@@ -0,0 +1,47 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+scratch=/tmp/audit-work/reconstruction
+evidence=/audit-output/evidence
+cd "$scratch" || exit 2
+
+echo '$ cp scratch mutation to reviewer evidence'
+cp spec-vacuity.k "$evidence/06_spec_vacuity.k"
+copy_status=$?
+echo "EXIT_STATUS=$copy_status"
+sha256sum spec-vacuity.k "$evidence/06_spec_vacuity.k"
+
+echo '$ kprove false-result mutation --dry-run'
+kprove spec-vacuity.k \
+  --definition audit-verification-kompiled \
+  --spec-module AUDIT-SPEC-VACUITY \
+  --dry-run \
+  --warnings none \
+  2>&1 | tee "$evidence/06a_mutation_dry_run.log"
+dry_status=${PIPESTATUS[0]}
+echo "EXIT_STATUS=$dry_status" | tee -a "$evidence/06a_mutation_dry_run.log"
+
+echo '$ kprove false-result mutation (expected unmet result obligation)'
+kprove spec-vacuity.k \
+  --definition audit-verification-kompiled \
+  --spec-module AUDIT-SPEC-VACUITY \
+  --warnings none \
+  2>&1 | tee "$evidence/06b_mutation_proof.log"
+proof_status=${PIPESTATUS[0]}
+echo "EXIT_STATUS=$proof_status" | tee -a "$evidence/06b_mutation_proof.log"
+
+echo "EXPECTED: copy=0 dry_run=0 proof_nonzero_with_WarnStuckClaimState"
+echo "OBSERVED: copy=$copy_status dry_run=$dry_status proof=$proof_status"
+
+if (( copy_status != 0 || dry_status != 0 || proof_status == 0 )); then
+  exit 1
+fi
+if ! rg -q 'WarnStuckClaimState' "$evidence/06b_mutation_proof.log"; then
+  echo 'FAIL: mutation did not fail with WarnStuckClaimState'
+  exit 1
+fi
+if ! rg -q 'iCons \\( 50 , iCons \\( 49' "$evidence/06b_mutation_proof.log"; then
+  echo 'FAIL: residual did not expose actual "21" code sequence'
+  exit 1
+fi
+exit 0

exec
/bin/bash -lc 'chmod +x /audit-output/evidence/06_nonvacuity.sh
set +e
/audit-output/evidence/06_nonvacuity.sh 2>&1 | tee /audit-output/evidence/06_nonvacuity.log
status=${PIPESTATUS[0]}
echo "WRAPPER_OBSERVED_EXIT_STATUS=$status"
exit 0' in /tmp/audit-work/reconstruction
diff --git a//tmp/audit-work/reconstruction/adequacy-cases.py b//tmp/audit-work/reconstruction/adequacy-cases.py
new file mode 100644
index 0000000000000000000000000000000000000000..68fa62be4860a9609f3abefd02ffdc52067cd601
--- /dev/null
+++ b//tmp/audit-work/reconstruction/adequacy-cases.py
@@ -0,0 +1,14 @@
+def circular_shift(x, shift):
+    s = str(x)
+    if shift > len(s):
+        return s[::-1]
+    return s[-shift:] + s[:-shift]
+
+
+# Satisfying normal, exact-boundary, and oversize entry preconditions.
+assert circular_shift(12, 1) == "21"
+assert circular_shift(12, 2) == "12"
+assert circular_shift(12, 3) == "21"
+assert circular_shift(-123, 1) == "3-12"
+assert circular_shift(-123, 4) == "-123"
+assert circular_shift(-123, 5) == "321-"
diff --git a//tmp/audit-work/reconstruction/body-mutant-spec.k b//tmp/audit-work/reconstruction/body-mutant-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..9247d8e2a73e25b5c4bfa0282e2c0407884492e6
--- /dev/null
+++ b//tmp/audit-work/reconstruction/body-mutant-spec.k
@@ -0,0 +1,64 @@
+requires "verification.k"
+
+module AUDIT-BODY-MUTANT-SPEC
+  imports CIRCULAR-SHIFT-VERIFICATION
+
+  // This changes the actual closure bound in the entry state.  In the normal
+  // branch it returns prefix+suffix instead of suffix+prefix.
+  claim [mutated-normal-body]:
+    <k>
+      Call(Name("circular_shift"), (X:Int, SHIFT:Int))
+      =>
+      circularShiftSpec(X, SHIFT, LEN)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "circular_shift" |->
+          closureVal(
+            ("x", "shift"),
+            ( Assign(Name("s"), Call(Name("str"), Name("x")))
+              If(
+                Compare(
+                  Name("shift"),
+                  CmpOp(">", Call(Name("len"), Name("s")))
+                ),
+                Return(
+                  Subscript(
+                    Name("s"),
+                    Slice(NoBound, NoBound, UnaryOp("-", Int(1)))
+                  )
+                ),
+                .Stmts
+              )
+              Return(
+                BinOp(
+                  "+",
+                  Subscript(
+                    Name("s"),
+                    Slice(NoBound, UnaryOp("-", Name("shift")), NoBound)
+                  ),
+                  Subscript(
+                    Name("s"),
+                    Slice(UnaryOp("-", Name("shift")), NoBound, NoBound)
+                  )
+                )
+              )
+            ),
+            0
+          ),
+        parent(-1)
+      )
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires LEN ==Int isLen(strToCodes(Int2String(X)))
+     andBool SHIFT >=Int 0
+     andBool SHIFT <=Int LEN
+endmodule
diff --git a//tmp/audit-work/reconstruction/bridge-connection-spec.k b//tmp/audit-work/reconstruction/bridge-connection-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..08312ef819e5ce8f99ccd7fd8846bbb6af01f955
--- /dev/null
+++ b//tmp/audit-work/reconstruction/bridge-connection-spec.k
@@ -0,0 +1,24 @@
+requires "verification.k"
+
+module AUDIT-BRIDGE-CONNECTION-SPEC
+  imports CIRCULAR-SHIFT-VERIFICATION
+
+  claim [candidate-bridge]:
+    <k>
+      strToCodes(Int2String(X:Int))
+      =>
+      intCodes(X)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
