diff --git a//tmp/audit-work/reconstruction/ground-spec.k b//tmp/audit-work/reconstruction/ground-spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..dc9f1430938a8a111a568df592a709d5747fbbb8
--- /dev/null
+++ b//tmp/audit-work/reconstruction/ground-spec.k
@@ -0,0 +1,62 @@
+requires "verification.k"
+
+module AUDIT-GROUND-SPEC
+  imports CIRCULAR-SHIFT-VERIFICATION
+
+  claim [normal-one]:
+    <k>
+      circularShiftSpec(12, 1, 2)
+      =>
+      str(iCons(50, iCons(49, .IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("circular_shift" |-> circularShiftClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
