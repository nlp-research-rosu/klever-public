+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(
+        "circular_shift" |->
+          closureVal(
+            ("x", "shift"),
+            ( Assign(Name("s"), Call(Name("str"), Name("x")))
+              If(
