@@ -0,0 +1,62 @@
+requires "verification.k"
+
+module AUDIT-GROUND-SPEC
+  imports CIRCULAR-SHIFT-VERIFICATION
+
+  claim [normal-one]:
+    <k>
+      circularShiftSpec(12, 1, 2)
+      =>
+      str(iCons(50, iCons(49, .IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("circular_shift" |-> circularShiftClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [normal-boundary]:
+    <k>
+      circularShiftSpec(12, 2, 2)
+      =>
+      str(iCons(49, iCons(50, .IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("circular_shift" |-> circularShiftClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+
+  claim [oversize]:
+    <k>
+      circularShiftSpec(12, 3, 2)
+      =>
+      str(iCons(50, iCons(49, .IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("circular_shift" |-> circularShiftClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
