+#!/usr/bin/env bash
+set -u
+
+run() {
+  printf '$'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  local rc=$?
+  printf '[exit %d]\n' "$rc"
+  return "$rc"
+}
