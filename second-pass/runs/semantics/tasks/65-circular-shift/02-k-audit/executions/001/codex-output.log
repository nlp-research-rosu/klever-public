index 0000000000000000000000000000000000000000..738642399e67a6e0d804a580317ad4ef123efa55
--- /dev/null
+++ b/evidence/03_build_proof.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+set -u
+cd /tmp/audit-work/case || exit 125
+
