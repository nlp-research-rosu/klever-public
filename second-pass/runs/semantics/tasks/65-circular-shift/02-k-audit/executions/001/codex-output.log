     2	
     3	module CIRCULAR-SHIFT-VERIFICATION
     4	  imports MPY
     5	
     6	  // `str(Int)` is total for integers, but the reference's ASCII conversion
     7	  // helper is not annotated [total].  Hide its contents behind one total,
     8	  // shared symbolic projection so Boolean exhaustiveness is available while
     9	  // preserving the exact same code sequence on both sides of every claim.
    10	  syntax IntSeq ::= intCodes(Int)
    11	  rule strToCodes(Int2String(X:Int)) => intCodes(X) [simplification]
    12	
    13	  // This is the exact function value produced by loading solution.mpy.
    14	  syntax Val ::= "circularShiftClosure" [macro]
    15	  rule circularShiftClosure
    16	    => closureVal(
    17	         ("x", "shift"),
    18	         ( Assign(Name("s"), Call(Name("str"), Name("x")))
    19	           If(
    20	             Compare(
    21	               Name("shift"),
    22	               CmpOp(">", Call(Name("len"), Name("s")))
    23	             ),
    24	             Return(
    25	               Subscript(
    26	                 Name("s"),
    27	                 Slice(NoBound, NoBound, UnaryOp("-", Int(1)))
    28	               )
    29	             ),
    30	             .Stmts
    31	           )
    32	           Return(
    33	             BinOp(
    34	               "+",
    35	               Subscript(
    36	                 Name("s"),
    37	                 Slice(UnaryOp("-", Name("shift")), NoBound, NoBound)
    38	               ),
    39	               Subscript(
    40	                 Name("s"),
    41	                 Slice(NoBound, UnaryOp("-", Name("shift")), NoBound)
    42	               )
    43	             )
    44	           )
    45	         ),
    46	         0
    47	       )
    48	
    49	  // An executable, program-independent statement of the contract.  The first
    50	  // rule is reversal.  The second takes the suffix of length SHIFT and then
    51	  // the remaining prefix, which is a right circular shift.
    52	  syntax Val ::= circularShiftSpec(Int, Int, Int) [function]
    53	  rule circularShiftSpec(X:Int, SHIFT:Int, LEN:Int)
    54	    => doSlice(
    55	         str(strToCodes(Int2String(X))),
    56	         noB,
    57	         noB,
    58	         someB(-1)
    59	       )
    60	    requires SHIFT >Int LEN
    61	
    62	  rule circularShiftSpec(X:Int, SHIFT:Int, LEN:Int)
    63	    => applyBin(
    64	         "+",
    65	         doSlice(
    66	           str(strToCodes(Int2String(X))),
    67	           someB(0 -Int SHIFT),
    68	           noB,
    69	           noB
    70	         ),
    71	         doSlice(
    72	           str(strToCodes(Int2String(X))),
    73	           noB,
    74	           someB(0 -Int SHIFT),
    75	           noB
    76	         )
    77	       )
    78	    requires SHIFT <=Int LEN
    79	endmodule
