Module(
  FuncDef("circular_shift", Params("x", "shift"),
    Assign(Name("s"), Call(Name("str"), Name("x")))
    If(Compare(Name("shift"), CmpOp(">", Call(Name("len"), Name("s")))),
      Return(
        Subscript(
          Name("s"),
          Slice(NoBound, NoBound, UnaryOp("-", Int(1))))),
      )
    Return(
      BinOp(
        "+",
        Subscript(
          Name("s"),
          Slice(UnaryOp("-", Name("shift")), NoBound, NoBound)),
        Subscript(
          Name("s"),
          Slice(NoBound, UnaryOp("-", Name("shift")), NoBound))))))
