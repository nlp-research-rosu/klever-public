Module(
  FuncDef("circular_shift", Params("x", "shift"),
    Assign(Name("s"), Call(Name("str"), Name("x")))
    If(Compare(Name("shift"), CmpOp(">", Call(Name("len"), Name("s")))),
      Return(
        Subscript(
          Name("s"),
          Slice(NoBound, NoBound, UnaryOp("-", Int(1))))),
      )
    Return(
      BinOp(
        "+",
        Subscript(
          Name("s"),
          Slice(UnaryOp("-", Name("shift")), NoBound, NoBound)),
        Subscript(
          Name("s"),
          Slice(NoBound, UnaryOp("-", Name("shift")), NoBound)))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(12), Int(1)),
      CmpOp("==", Str("21"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(12), Int(2)),
      CmpOp("==", Str("12"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(12), Int(3)),
      CmpOp("==", Str("21"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(12345), Int(0)),
      CmpOp("==", Str("12345"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(12345), Int(2)),
      CmpOp("==", Str("45123"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(0), Int(2)),
      CmpOp("==", Str("0"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), UnaryOp("-", Int(123)), Int(1)),
      CmpOp("==", Str("3-12"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), UnaryOp("-", Int(123)), Int(9)),
      CmpOp("==", Str("321-")))))
