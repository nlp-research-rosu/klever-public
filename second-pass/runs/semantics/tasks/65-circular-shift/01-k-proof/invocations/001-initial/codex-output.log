+  --backend haskell \
+  --main-module CIRCULAR-SHIFT-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled \
+  --warnings none
+kprove \
+  --definition verification-kompiled \
+  --spec-module CIRCULAR-SHIFT-SPEC \
+  --depth 300 \
+  --warnings none \
+  spec.k
