+requires "reference-semantics/semantics.k"
+
+module CIRCULAR-SHIFT-VERIFICATION
+  imports MPY
+
+  // Proof lemma: the backend otherwise leaves this Boolean opaque when N is
+  // the symbolic length of Int2String(X), even under either arithmetic path
+  // condition.  These are the two integer-trichotomy cases of MPY's #branch.
+  rule I:Int >Int N:Int => true
+    requires I >Int N
+    [simplification]
