diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..80477bbd6a128072b726ad2046b3c4726190e142
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,50 @@
+requires "verification.k"
+
+module CIRCULAR-SHIFT-SPEC
+  imports CIRCULAR-SHIFT-VERIFICATION
+
+  // Together these two claims partition every nonnegative shift.
+  claim [normal-shift]:
+    <k>
+      Call(Name("circular_shift"), (X:Int, SHIFT:Int))
+      =>
+      circularShiftSpec(X, SHIFT, LEN)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("circular_shift" |-> circularShiftClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires LEN ==Int isLen(strToCodes(Int2String(X)))
+     andBool SHIFT >=Int 0
+     andBool SHIFT <=Int LEN
+
+  claim [oversize-shift]:
+    <k>
+      Call(Name("circular_shift"), (X:Int, SHIFT:Int))
+      =>
+      circularShiftSpec(X, SHIFT, LEN)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("circular_shift" |-> circularShiftClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires LEN ==Int isLen(strToCodes(Int2String(X)))
+     andBool SHIFT >=Int 0
+     andBool SHIFT >Int LEN
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..4e51ff1a59dfe7101bb9462f8c7205e8f6c5d59f
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,79 @@
+requires "reference-semantics/semantics.k"
+
+module CIRCULAR-SHIFT-VERIFICATION
+  imports MPY
+
+  // `str(Int)` is total for integers, but the reference's ASCII conversion
+  // helper is not annotated [total].  Hide its contents behind one total,
+  // shared symbolic projection so Boolean exhaustiveness is available while
+  // preserving the exact same code sequence on both sides of every claim.
+  syntax IntSeq ::= intCodes(Int)
+  rule strToCodes(Int2String(X:Int)) => intCodes(X) [simplification]
+
+  // This is the exact function value produced by loading solution.mpy.
+  syntax Val ::= "circularShiftClosure" [macro]
+  rule circularShiftClosure
+    => closureVal(
+         ("x", "shift"),
+         ( Assign(Name("s"), Call(Name("str"), Name("x")))
+           If(
+             Compare(
+               Name("shift"),
+               CmpOp(">", Call(Name("len"), Name("s")))
+             ),
+             Return(
+               Subscript(
+                 Name("s"),
+                 Slice(NoBound, NoBound, UnaryOp("-", Int(1)))
+               )
+             ),
+             .Stmts
+           )
+           Return(
+             BinOp(
+               "+",
+               Subscript(
+                 Name("s"),
+                 Slice(UnaryOp("-", Name("shift")), NoBound, NoBound)
+               ),
+               Subscript(
+                 Name("s"),
+                 Slice(NoBound, UnaryOp("-", Name("shift")), NoBound)
+               )
+             )
+           )
+         ),
+         0
+       )
+
+  // An executable, program-independent statement of the contract.  The first
+  // rule is reversal.  The second takes the suffix of length SHIFT and then
+  // the remaining prefix, which is a right circular shift.
+  syntax Val ::= circularShiftSpec(Int, Int, Int) [function]
+  rule circularShiftSpec(X:Int, SHIFT:Int, LEN:Int)
+    => doSlice(
+         str(strToCodes(Int2String(X))),
+         noB,
+         noB,
+         someB(-1)
+       )
+    requires SHIFT >Int LEN
+
+  rule circularShiftSpec(X:Int, SHIFT:Int, LEN:Int)
+    => applyBin(
+         "+",
+         doSlice(
+           str(strToCodes(Int2String(X))),
+           someB(0 -Int SHIFT),
+           noB,
+           noB
+         ),
+         doSlice(
+           str(strToCodes(Int2String(X))),
+           noB,
+           someB(0 -Int SHIFT),
+           noB
+         )
+       )
+    requires SHIFT <=Int LEN
+endmodule

