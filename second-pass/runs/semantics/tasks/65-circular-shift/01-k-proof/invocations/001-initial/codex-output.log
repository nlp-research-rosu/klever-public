index 0000000000000000000000000000000000000000..82a28c094e3ec83c6fc0ea298a4be5e9e644a2af
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,48 @@
+requires "verification.k"
+
+module CIRCULAR-SHIFT-SPEC
+  imports CIRCULAR-SHIFT-VERIFICATION
+
+  // Together these two claims partition every nonnegative shift.
+  claim [normal-shift]:
+    <k>
+      Call(Name("circular_shift"), (X:Int, SHIFT:Int))
+      =>
+      circularShiftSpec(X, SHIFT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("circular_shift" |-> circularShiftClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires SHIFT >=Int 0
+     andBool SHIFT <=Int isLen(strToCodes(Int2String(X)))
+
+  claim [oversize-shift]:
+    <k>
+      Call(Name("circular_shift"), (X:Int, SHIFT:Int))
+      =>
+      circularShiftSpec(X, SHIFT)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0  |-> scope("circular_shift" |-> circularShiftClosure, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires SHIFT >=Int 0
+     andBool SHIFT >Int isLen(strToCodes(Int2String(X)))
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..3b95087a0c22665146361a819bc51e3fd5c853b7
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,83 @@
+requires "reference-semantics/semantics.k"
+
+module CIRCULAR-SHIFT-VERIFICATION
+  imports MPY
+
+  // Proof lemma: the backend otherwise leaves this Boolean opaque when N is
+  // the symbolic length of Int2String(X), even under either arithmetic path
+  // condition.  These are the two integer-trichotomy cases of MPY's #branch.
+  rule I:Int >Int N:Int => true
+    requires I >Int N
+    [simplification]
+
+  rule I:Int >Int N:Int => false
+    requires I <=Int N
+    [simplification]
+
+  // This is the exact function value produced by loading solution.mpy.
+  syntax Val ::= "circularShiftClosure" [macro]
+  rule circularShiftClosure
+    => closureVal(
+         ("x", "shift"),
+         ( Assign(Name("s"), Call(Name("str"), Name("x")))
+           If(
+             Compare(
+               Name("shift"),
+               CmpOp(">", Call(Name("len"), Name("s")))
+             ),
+             Return(
+               Subscript(
+                 Name("s"),
+                 Slice(NoBound, NoBound, UnaryOp("-", Int(1)))
+               )
+             ),
+             .Stmts
+           )
+           Return(
+             BinOp(
+               "+",
+               Subscript(
+                 Name("s"),
+                 Slice(UnaryOp("-", Name("shift")), NoBound, NoBound)
+               ),
+               Subscript(
+                 Name("s"),
+                 Slice(NoBound, UnaryOp("-", Name("shift")), NoBound)
+               )
+             )
+           )
+         ),
+         0
+       )
+
+  // An executable, program-independent statement of the contract.  The first
+  // rule is reversal.  The second takes the suffix of length SHIFT and then
+  // the remaining prefix, which is a right circular shift.
+  syntax Val ::= circularShiftSpec(Int, Int) [function]
+  rule circularShiftSpec(X:Int, SHIFT:Int)
+    => doSlice(
+         str(strToCodes(Int2String(X))),
+         noB,
+         noB,
+         someB(-1)
+       )
+    requires SHIFT >Int isLen(strToCodes(Int2String(X)))
+
+  rule circularShiftSpec(X:Int, SHIFT:Int)
+    => applyBin(
+         "+",
+         doSlice(
+           str(strToCodes(Int2String(X))),
+           someB(0 -Int SHIFT),
+           noB,
+           noB
+         ),
+         doSlice(
+           str(strToCodes(Int2String(X))),
+           noB,
+           someB(0 -Int SHIFT),
+           noB
+         )
+       )
+    requires SHIFT <=Int isLen(strToCodes(Int2String(X)))
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..a3a1e27ad1f66a4dd4f9d0748224174a353fa9b5
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,5 @@
+def circular_shift(x, shift):
+    s = str(x)
+    if shift > len(s):
+        return s[::-1]
+    return s[-shift:] + s[:-shift]
