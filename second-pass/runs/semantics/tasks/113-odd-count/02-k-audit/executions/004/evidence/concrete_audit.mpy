Module(
  FuncDef("odd_count", Params("lst"),
    Assign(Name("result"), ListExpr())
    Assign(Name("digits"), Str(""))
    Assign(Name("count"), Int(0))
    Assign(Name("digit"), Str(""))
    Assign(Name("text"), Str(""))
    For(Name("digits"), Name("lst"),
      Assign(Name("count"), Int(0))
      Assign(Name("digit"), Str(""))
      For(Name("digit"), Name("digits"),
        AugAssign(
          Name("count"),
          "+",
          BinOp("%", Call(Name("int"), Name("digit")), Int(2))))
      Assign(
        Name("text"),
        BinOp(
          "+",
          Str("the number of odd elements "),
          Call(Name("str"), Name("count"))))
      Assign(
        Name("text"),
        BinOp(
          "+",
          BinOp(
            "+",
            BinOp(
              "+",
              BinOp("+", Name("text"), Str("n the str")),
              Call(Name("str"), Name("count"))),
            Str("ng ")),
          Call(Name("str"), Name("count"))))
      Assign(
        Name("text"),
        BinOp(
          "+",
          BinOp(
            "+",
            BinOp("+", Name("text"), Str(" of the ")),
            Call(Name("str"), Name("count"))),
          Str("nput.")))
      Expr(Call(Attribute(Name("result"), "append"), Name("text")))
      Assign(Name("digits"), Str(""))
      Assign(Name("count"), Int(0))
      Assign(Name("digit"), Str(""))
      Assign(Name("text"), Str("")))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("odd_count"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("odd_count"), ListExpr(Str(""))),
      CmpOp(
        "==",
        ListExpr(
          Str(
            "the number of odd elements 0n the str0ng 0 of the 0nput.")))))
  Assert(
    Compare(
      Call(
        Name("odd_count"),
        ListExpr(Str("0"), Str("1"), Str("2"), Str("9"))),
      CmpOp(
        "==",
        ListExpr(
          Str(
            "the number of odd elements 0n the str0ng 0 of the 0nput."),
          Str(
            "the number of odd elements 1n the str1ng 1 of the 1nput."),
          Str(
            "the number of odd elements 0n the str0ng 0 of the 0nput."),
          Str(
            "the number of odd elements 1n the str1ng 1 of the 1nput.")))))
  Assert(
    Compare(
      Call(Name("odd_count"), ListExpr(Str("1234567"))),
      CmpOp(
        "==",
        ListExpr(
          Str(
            "the number of odd elements 4n the str4ng 4 of the 4nput.")))))
  Assert(
    Compare(
      Call(Name("odd_count"), ListExpr(Str("3"), Str("11111111"))),
      CmpOp(
        "==",
        ListExpr(
          Str(
            "the number of odd elements 1n the str1ng 1 of the 1nput."),
          Str(
            "the number of odd elements 8n the str8ng 8 of the 8nput.")))))
  Assert(
    Compare(
      Call(Name("odd_count"), ListExpr(Str("1111111111"))),
      CmpOp(
        "==",
        ListExpr(
          Str(
            "the number of odd elements 10n the str10ng 10 of the 10nput."))))))
