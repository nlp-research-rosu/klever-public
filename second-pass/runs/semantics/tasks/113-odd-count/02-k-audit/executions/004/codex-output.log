args="*** Begin Patch\n*** Update File: /work/verification.k\n@@\n   rule ODD-OUTER-BODY\n@@\n        .Stmts\n        [macro]\n+\n+  // Inductive outer-loop summary. Its element transformer is the digit-loop\n+  // theorem above; oddCountFrom is the corresponding accumulator fold.\n+  rule <k>\n+         #loop(list(INPUT:ValSeq), Name(\"digits\"), ODD-OUTER-BODY)\n+         => .K\n+         ...\n+       </k>\n+       <env> 1 </env>\n+       <scopes>\n+         ...\n+         1 |-> scope(\n+                (\"lst\" |-> list(WHOLE:ValSeq))\n+                (\"result\" |-> ref(OUT:Int))\n+                (\"digits\" |-> str(.IntSeq))\n+                (\"count\" |-> 0)\n+                (\"digit\" |-> str(.IntSeq))\n+                (\"text\" |-> str(.IntSeq)),\n+                parent(0))\n+         =>\n+         1 |-> scope(\n+                (\"lst\" |-> list(WHOLE))\n+                (\"result\" |-> ref(OUT))\n+                (\"digits\" |-> str(.IntSeq))\n+                (\"count\" |-> 0)\n+                (\"digit\" |-> str(.IntSeq))\n+                (\"text\" |-> str(.IntSeq)),\n+                parent(0))\n+         ...\n+       </scopes>\n+       <heap>\n+         OUT |-> list(ACC:ValSeq)\n+         =>\n+         OUT |-> list(oddCountFrom(ACC, INPUT))\n+       </heap>\n+       requires validDigitStrings(INPUT)\n+       [priority(40)]\n \n   syntax Stmts ::= \"ODD-COUNT-BODY\"\n*** End Patch\n"
