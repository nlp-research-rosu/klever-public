+               .ValSeq)))
+      =>
+      ref(0)
+    </k>
+    <env> 0 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(.Map, parent(-1))
+      =>
+      -1 |-> builtinsScope
+      0  |-> scope(
