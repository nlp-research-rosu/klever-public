+      =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap>
+      .Map
+      =>
+      0 |-> list(
+              vCons(
+                str(strToCodes(
+                  "the number of odd elements 9n the str9ng 9 of the 9nput.")),
+                .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
