-         OUT |-> list(oddCountFrom(ACC, INPUT))
-       </heap>
-       requires validDigitStrings(INPUT)
-       [priority(40)]
-
   syntax Stmts ::= "ODD-COUNT-BODY" [macro]
   rule ODD-COUNT-BODY
     => Assign(Name("result"), ListExpr(.Exprs))
