+      0 |-> list(
+              vCons(
+                str(strToCodes(
+                  "the number of odd elements 1n the str1ng 1 of the 1nput.")),
+                .ValSeq))
+    </heap>
+    <heapLoc> 0 => 1 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
