args="*** Begin Patch\n*** Update File: /work/verification.k\n@@\n   rule validDigitStrings(vCons(str(CS:IntSeq), REST:ValSeq))\n     => allDigit(CS) andBool validDigitStrings(REST)\n   rule validDigitStrings(vCons(_:Val, _:ValSeq)) => false [owise]\n+\n+  // A proof-only representation of lists of strings. Every concrete\n+  // list-of-strings value has exactly this shape; exposing the constructor\n+  // lets symbolic execution induct on the outer list without narrowing an\n+  // otherwise arbitrary Val head.\n+  syntax DigitStrings ::= \"noStrings\"\n+                        | moreStrings(IntSeq, DigitStrings)\n+  syntax ValSeq ::= asValues(DigitStrings) [function]\n+  rule asValues(noStrings) => .ValSeq\n+  rule asValues(moreStrings(CS:IntSeq, REST:DigitStrings))\n+    => vCons(str(CS), asValues(REST))\n+\n+  syntax Bool ::= validDigitInput(DigitStrings) [function]\n+  rule validDigitInput(noStrings) => true\n+  rule validDigitInput(moreStrings(CS:IntSeq, REST:DigitStrings))\n+    => allDigit(CS) andBool validDigitInput(REST)\n*** Update File: /work/spec.k\n@@\n     <k>\n-      #loop(list(INPUT:ValSeq), Name(\"digits\"), ODD-OUTER-BODY) ~> CONT:K\n+      #loop(\n+        list(asValues(INPUT:DigitStrings)),\n+        Name(\"digits\"),\n+        ODD-OUTER-BODY) ~> CONT:K\n@@\n       1  |-> scope(\n-              (\"lst\" |-> list(WHOLE:ValSeq))\n+              (\"lst\" |-> list(asValues(WHOLE:DigitStrings)))\n@@\n       1  |-> scope(\n-              (\"lst\" |-> list(WHOLE))\n+              (\"lst\" |-> list(asValues(WHOLE)))\n               (\"result\" |-> ref(OUT))\n-              (\"digits\" |-> outerDigits(INPUT, OLDDS))\n-              (\"count\" |-> outerCount(INPUT, OLDCOUNT))\n-              (\"digit\" |-> outerDigit(INPUT, OLDDIGIT))\n-              (\"text\" |-> outerText(INPUT, OLDTEXT)),\n+              (\"digits\" |-> outerDigits(asValues(INPUT), OLDDS))\n+              (\"count\" |-> outerCount(asValues(INPUT), OLDCOUNT))\n+              (\"digit\" |-> outerDigit(asValues(INPUT), OLDDIGIT))\n+              (\"text\" |-> outerText(asValues(INPUT), OLDTEXT)),\n@@\n       OUT |-> list(ACC:ValSeq)\n       =>\n-      OUT |-> list(oddCountFrom(ACC, INPUT))\n+      OUT |-> list(oddCountFrom(ACC, asValues(INPUT)))\n     </heap>\n-    requires validDigitStrings(INPUT)\n+    requires validDigitInput(INPUT)\n*** End Patch\n"
