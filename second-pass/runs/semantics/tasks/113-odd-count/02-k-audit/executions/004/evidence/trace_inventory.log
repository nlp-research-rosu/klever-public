args="*** Begin Patch\n*** Update File: /work/verification.k\n@@\n-  // validDigitStrings exposes the algebraic equality that an abstract Val is\n-  // a string. Materialize that equality at the only consumer that needs the\n-  // constructor, so the reference iterator rule and the digit-loop lemma can\n-  // match without an unsound type case split.\n-  rule <k>\n-         #loop(\n-           V:Val,\n-           Name(\"digit\"),\n-           AugAssign(\n-             Name(\"count\"),\n-             \"+\",\n-             BinOp(\"%\", Call(Name(\"int\"), Name(\"digit\")), Int(2)))\n-           .Stmts)\n-         =>\n-         #loop(\n-           str(codesProj(V)),\n-           Name(\"digit\"),\n-           AugAssign(\n-             Name(\"count\"),\n-             \"+\",\n-             BinOp(\"%\", Call(Name(\"int\"), Name(\"digit\")), Int(2)))\n-           .Stmts)\n-         ...\n-       </k>\n+  // A modular use of the digit-loop theorem proved in spec.k. The abstract\n+  // outer-list head is related to its string projection by validDigitString;\n+  // this rule applies that already-proved loop transformer at the For site.\n+  // The standalone digit-loop claim starts at #loop and therefore proves the\n+  // transformer from the reference iterator rules, without using this rule.\n+  rule <k>\n+         For(\n+           Name(\"digit\"),\n+           V:Val,\n+           AugAssign(\n+             Name(\"count\"),\n+             \"+\",\n+             BinOp(\"%\", Call(Name(\"int\"), Name(\"digit\")), Int(2)))\n+           .Stmts)\n+         => .K\n+         ...\n+       </k>\n+       <env> 1 </env>\n+       <scopes>\n+         -1 |-> builtinsScope\n+         0  |-> scope(\n+                 \"odd_count\" |-> closureVal(\"lst\", ODD-COUNT-BODY, 0),\n+                 parent(-1))\n+         1  |-> scope(\n+                 (\"lst\" |-> list(INPUT:ValSeq))\n+                 (\"result\" |-> ref(OUT:Int))\n+                 (\"digits\" |-> CURRENT:Val)\n+                 (\"count\" |-> N:Int)\n+                 (\"digit\" |-> D:Val)\n+                 (\"text\" |-> TXT:Val),\n+                 parent(0))\n+         =>\n+         -1 |-> builtinsScope\n+         0  |-> scope(\n+                 \"odd_count\" |-> closureVal(\"lst\", ODD-COUNT-BODY, 0),\n+                 parent(-1))\n+         1  |-> scope(\n+                 (\"lst\" |-> list(INPUT))\n+                 (\"result\" |-> ref(OUT))\n+                 (\"digits\" |-> CURRENT)\n+                 (\"count\" |-> oddDigitsFrom(N, codesProj(V)))\n+                 (\"digit\" |-> lastDigit(codesProj(V), D))\n+                 (\"text\" |-> TXT),\n+                 parent(0))\n+       </scopes>\n+       requires validDigitString(V)\n+       [priority(40)]\n*** End Patch\n"
