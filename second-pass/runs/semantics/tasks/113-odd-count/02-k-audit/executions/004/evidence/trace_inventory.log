args="*** Begin Patch\n*** Add File: /work/verification.k\n+requires \"reference-semantics/semantics.k\"\n+\n+module ODD-COUNT-VERIFICATION\n+  imports MPY\n+\n+  // The mathematical number of odd decimal digits in a code sequence.\n+  syntax Int ::= oddDigits(IntSeq) [function]\n+  rule oddDigits(.IntSeq) => 0\n+  rule oddDigits(iCons(C:Int, CS:IntSeq))\n+    => pyMod(C -Int 48, 2) +Int oddDigits(CS)\n+\n+  // The value left in the loop target after iterating over a string.\n+  syntax Val ::= lastDigit(IntSeq, Val) [function]\n+  rule lastDigit(.IntSeq, OLD:Val) => OLD\n+  rule lastDigit(iCons(C:Int, CS:IntSeq), _:Val)\n+    => lastDigit(CS, str(iCons(C, .IntSeq)))\n+\n+  // The required output sentence, expressed using exactly the string\n+  // operations available to the program.\n+  syntax Val ::= oddText(Int) [function]\n+  rule oddText(N:Int)\n+    => applyBin(\n+         \"+\",\n+         applyBin(\n+           \"+\",\n+           applyBin(\n+             \"+\",\n+             applyBin(\n+               \"+\",\n+               applyBin(\n+                 \"+\",\n+                 applyBin(\n+                   \"+\",\n+                   applyBin(\n+                     \"+\",\n+                     applyBin(\n+                       \"+\",\n+                       str(strToCodes(\"the number of odd elements \")),\n+                       str(strToCodes(Int2String(N)))),\n+                     str(strToCodes(\"n the str\"))),\n+                   str(strToCodes(Int2String(N)))),\n+                 str(strToCodes(\"ng \"))),\n+               str(strToCodes(Int2String(N)))),\n+             str(strToCodes(\" of the \"))),\n+           str(strToCodes(Int2String(N)))),\n+         str(strToCodes(\"nput.\")))\n+\n+  syntax ValSeq ::= oddCountSpec(ValSeq) [function]\n+  rule oddCountSpec(.ValSeq) => .ValSeq\n+  rule oddCountSpec(vCons(str(CS:IntSeq), REST:ValSeq))\n+    => vCons(oddText(oddDigits(CS)), oddCountSpec(REST))\n+\n+  syntax Bool ::= validDigitStrings(ValSeq) [function]\n+  rule validDigitStrings(.ValSeq) => true\n+  rule validDigitStrings(vCons(str(CS:IntSeq), REST:ValSeq))\n+    => allDigit(CS) andBool validDigitStrings(REST)\n+\n+  // Program fragments below are a direct K rendering of solution.mpy. Keeping\n+  // them named makes the loop invariants in spec.k readable.\n+  syntax Stmts ::= \"ODD-INNER-BODY\" [function]\n+  rule ODD-INNER-BODY\n+    => AugAssign(\n+         Name(\"count\"),\n+         \"+\",\n+         BinOp(\"%\", Call(Name(\"int\"), Name(\"digit\")), Int(2)))\n+       .Stmts\n+\n+  syntax Stmts ::= \"ODD-OUTER-BODY\" [function]\n+  rule ODD-OUTER-BODY\n+    => Assign(Name(\"count\"), Int(0))\n+       Assign(Name(\"digit\"), Str(\"\"))\n+       For(Name(\"digit\"), Name(\"digits\"), ODD-INNER-BODY)\n+       Assign(\n+         Name(\"text\"),\n+         BinOp(\n+           \"+\",\n+           Str(\"the number of odd elements \"),\n+           Call(Name(\"str\"), Name(\"count\"))))\n+       Assign(\n+         Name(\"text\"),\n+         BinOp(\n+           \"+\",\n+           BinOp(\n+             \"+\",\n+             BinOp(\n+               \"+\",\n+               BinOp(\"+\", Name(\"text\"), Str(\"n the str\")),\n+               Call(Name(\"str\"), Name(\"count\"))),\n+             Str(\"ng \")),\n+           Call(Name(\"str\"), Name(\"count\"))))\n+       Assign(\n+         Name(\"text\"),\n+         BinOp(\n+           \"+\",\n+           BinOp(\n+             \"+\",\n+             BinOp(\"+\", Name(\"text\"), Str(\" of the \")),\n+             Call(Name(\"str\"), Name(\"count\"))),\n+           Str(\"nput.\")))\n+       Expr(Call(Attribute(Name(\"result\"), \"append\"), Name(\"text\")))\n+       .Stmts\n+\n+  syntax Stmts ::= \"ODD-COUNT-BODY\" [function]\n+  rule ODD-COUNT-BODY\n+    => Assign(Name(\"result\"), ListExpr())\n+       For(Name(\"digits\"), Name(\"lst\"), ODD-OUTER-BODY)\n+       Return(Name(\"result\"))\n+       .Stmts\n+\n+  syntax Module ::= \"ODD-COUNT-PROGRAM\" [function]\n+  rule ODD-COUNT-PROGRAM\n+    => Module(\n+         FuncDef(\n+           \"odd_count\",\n+           Params(\"lst\"),\n+           ODD-COUNT-BODY))\n+endmodule\n*** End Patch\n"
