+              ("lst" |-> list(WHOLE:ValSeq))
+              ("result" |-> ref(OUT:Int))
+              ("digits" |-> str(.IntSeq))
+              ("count" |-> 0)
+              ("digit" |-> str(.IntSeq))
+              ("text" |-> str(.IntSeq)),
+              parent(0))
+      =>
