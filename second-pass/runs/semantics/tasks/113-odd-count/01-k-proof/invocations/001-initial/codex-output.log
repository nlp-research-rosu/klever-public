+      1  |-> scope(
+              ("lst" |-> list(INPUT))
+              ("result" |-> ref(OUT))
+              ("digits" |-> str(WHOLE))
+              ("count" |-> (N +Int oddDigits(CS)))
+              ("digit" |-> lastDigit(CS, D))
+              ("text" |-> TXT),
+              parent(0))
+    </scopes>
+    requires allDigit(CS)
+    [label(digit-loop)]
+endmodule
