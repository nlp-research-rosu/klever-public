+              parent(-1))
+      1  |-> scope(
+              ("count" |-> N:Int)
+              ("digit" |-> D:Val)
+              LOCALS:Map,
+              parent(0))
+      =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
+      1  |-> scope(
+              ("count" |-> (N +Int oddDigits(CS)))
+              ("digit" |-> lastDigit(CS, D))
+              LOCALS,
+              parent(0))
+    </scopes>
+    requires allDigit(CS)
+     andBool notBool ("int" in_keys(LOCALS))
+    [label(digit-loop)]
+endmodule
