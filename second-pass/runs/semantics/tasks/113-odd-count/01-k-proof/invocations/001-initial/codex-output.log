+    </scopes>
+    <heap>
+      OUT |-> list(ACC:ValSeq)
+      =>
+      OUT |-> list(ACC)
+    </heap>
+    [label(outer-empty)]
+
+  claim
+    <k>
+      #loop(
+        list(vCons(str(CS:IntSeq), REST:ValSeq)),
+        Name("digits"),
+        ODD-OUTER-BODY) ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
