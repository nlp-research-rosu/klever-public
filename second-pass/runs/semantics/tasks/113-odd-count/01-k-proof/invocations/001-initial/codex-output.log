+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
+      1  |-> scope(
+              ("lst" |-> list(WHOLE:ValSeq))
+              ("result" |-> ref(OUT:Int))
+              ("digits" |-> str(.IntSeq))
+              ("count" |-> 0)
+              ("digit" |-> str(.IntSeq))
+              ("text" |-> str(.IntSeq)),
+              parent(0))
+      =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
+      1  |-> scope(
