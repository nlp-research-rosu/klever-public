+              ("result" |-> ref(OUT))
+              ("digits" |-> str(WHOLE))
+              ("count" |-> oddDigitsFrom(N, CS))
+              ("digit" |-> lastDigit(CS, D))
+              ("text" |-> TXT),
+              parent(0))
+    </scopes>
+    requires allDigit(CS)
+    [label(digit-loop)]
+
+  claim
+    <k>
+      #loop(list(.ValSeq), Name("digits"), ODD-OUTER-BODY) ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
+      1  |-> scope(
+              ("lst" |-> list(WHOLE:ValSeq))
+              ("result" |-> ref(OUT:Int))
+              ("digits" |-> str(.IntSeq))
+              ("count" |-> 0)
+              ("digit" |-> str(.IntSeq))
+              ("text" |-> str(.IntSeq)),
+              parent(0))
+      =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
+      1  |-> scope(
+              ("lst" |-> list(WHOLE))
+              ("result" |-> ref(OUT))
+              ("digits" |-> str(.IntSeq))
+              ("count" |-> 0)
+              ("digit" |-> str(.IntSeq))
+              ("text" |-> str(.IntSeq)),
+              parent(0))
+    </scopes>
+    <heap>
+      OUT |-> list(ACC:ValSeq)
+      =>
+      OUT |-> list(ACC)
+    </heap>
+    [label(outer-empty)]
+
+  claim
+    <k>
+      #loop(
+        list(vCons(str(CS:IntSeq), REST:ValSeq)),
+        Name("digits"),
+        ODD-OUTER-BODY) ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
+      1  |-> scope(
+              ("lst" |-> list(WHOLE:ValSeq))
+              ("result" |-> ref(OUT:Int))
+              ("digits" |-> str(.IntSeq))
+              ("count" |-> 0)
+              ("digit" |-> str(.IntSeq))
+              ("text" |-> str(.IntSeq)),
+              parent(0))
+      =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
+      1  |-> scope(
+              ("lst" |-> list(WHOLE))
+              ("result" |-> ref(OUT))
+              ("digits" |-> str(.IntSeq))
+              ("count" |-> 0)
+              ("digit" |-> str(.IntSeq))
+              ("text" |-> str(.IntSeq)),
+              parent(0))
+    </scopes>
+    <heap>
+      OUT |-> list(ACC:ValSeq)
+      =>
+      OUT |-> list(
+               oddCountFrom(
+                 ACC,
+                 vCons(str(CS), REST)))
+    </heap>
+    requires allDigit(CS)
+     andBool validDigitStrings(REST)
+    [label(outer-loop)]
+endmodule
