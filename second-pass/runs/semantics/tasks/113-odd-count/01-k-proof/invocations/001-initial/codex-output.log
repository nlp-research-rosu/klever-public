new file mode 100644
index 0000000000000000000000000000000000000000..b13f678e246a99cc0c918c54b1d0793f624d57fe
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,20 @@
+def odd_count(lst):
+    result = []
+    digits = ""
+    count = 0
+    digit = ""
+    text = ""
+    for digits in lst:
+        count = 0
+        digit = ""
+        for digit in digits:
+            count += int(digit) % 2
+        text = "the number of odd elements " + str(count)
+        text = text + "n the str" + str(count) + "ng " + str(count)
+        text = text + " of the " + str(count) + "nput."
+        result.append(text)
+        digits = ""
+        count = 0
+        digit = ""
+        text = ""
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..b389f8a8ee0968c47ef16b96ee7af2c3514471b3
