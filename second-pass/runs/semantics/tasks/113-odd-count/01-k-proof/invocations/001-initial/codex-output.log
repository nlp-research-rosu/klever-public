+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
+      1  |-> scope(
+              ("lst" |-> list(WHOLE:ValSeq))
+              ("result" |-> ref(OUT:Int))
+              ("digits" |-> OLD-DIGITS:Val)
+              ("count" |-> OLD-COUNT:Int)
+              ("digit" |-> OLD-DIGIT:Val)
+              ("text" |-> OLD-TEXT:Val),
+              parent(0))
+      =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
+      1  |-> scope(
+              ("lst" |-> list(WHOLE))
+              ("result" |-> ref(OUT))
+              ("digits" |-> outerDigits(INPUT, OLD-DIGITS))
+              ("count" |-> outerCount(INPUT, OLD-COUNT))
+              ("digit" |-> outerDigit(INPUT, OLD-DIGIT))
+              ("text" |-> outerText(INPUT, OLD-TEXT)),
+              parent(0))
+    </scopes>
+    <heap>
+      OUT |-> list(ACC:ValSeq)
+      =>
