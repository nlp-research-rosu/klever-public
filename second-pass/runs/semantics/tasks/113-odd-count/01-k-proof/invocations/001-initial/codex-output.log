+              ("count" |-> oddDigitsFrom(N, CS))
+              ("digit" |-> lastDigit(CS, D))
+              ("text" |-> TXT),
+              parent(0))
+    </scopes>
+    requires allDigit(CS)
+    [label(digit-loop)]
+
+  claim
+    <k>
+      #loop(list(INPUT:ValSeq), Name("digits"), ODD-OUTER-BODY) ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
+      1  |-> scope(
+              ("lst" |-> list(WHOLE:ValSeq))
+              ("result" |-> ref(OUT:Int))
+              ("digits" |-> OLDDS:Val)
+              ("count" |-> OLDCOUNT:Int)
+              ("digit" |-> OLDDIGIT:Val)
+              ("text" |-> OLDTEXT:Val),
+              parent(0))
+      =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
+      1  |-> scope(
+              ("lst" |-> list(WHOLE))
+              ("result" |-> ref(OUT))
+              ("digits" |-> outerDigits(INPUT, OLDDS))
+              ("count" |-> outerCount(INPUT, OLDCOUNT))
+              ("digit" |-> outerDigit(INPUT, OLDDIGIT))
+              ("text" |-> outerText(INPUT, OLDTEXT)),
+              parent(0))
+    </scopes>
+    <heap>
+      OUT |-> list(ACC:ValSeq)
+      =>
+      OUT |-> list(oddCountFrom(ACC, INPUT))
+    </heap>
+    requires validDigitStrings(INPUT)
+    [label(outer-loop)]
