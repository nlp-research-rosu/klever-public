+              parent(-1))
+      1  |-> scope(
+              ("lst" |-> list(WHOLE))
+              ("result" |-> ref(OUT))
+              ("digits" |-> str(.IntSeq))
+              ("count" |-> 0)
+              ("digit" |-> str(.IntSeq))
+              ("text" |-> str(.IntSeq)),
+              parent(0))
+    </scopes>
+    <heap>
+      OUT |-> list(ACC:ValSeq)
+      =>
+      OUT |-> list(
+               oddCountFrom(
+                 ACC,
+                 vCons(str(CS), REST)))
+    </heap>
+    requires allDigit(CS)
+     andBool validDigitStrings(REST)
+    [label(outer-loop)]
