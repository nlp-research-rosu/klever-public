+        result.append(text)
+    return result
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..eee8b8ddac0933dcf4b09aec5b5131ac47c97194
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,38 @@
+requires "verification.k"
+
+module ODD-COUNT-SPEC
+  imports ODD-COUNT-VERIFICATION
+
+  claim
+    <k>
+      #loop(str(CS:IntSeq), Name("digit"), ODD-INNER-BODY) ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
+      1  |-> scope(
+              ("count" |-> N:Int)
+              ("digit" |-> D:Val)
+              LOCALS:Map,
+              parent(0))
+      =>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
+      1  |-> scope(
+              ("count" |-> (N +Int oddDigits(CS)))
+              ("digit" |-> lastDigit(CS, D))
+              LOCALS,
+              parent(0))
+    </scopes>
+    requires allDigit(CS)
+     andBool notBool ("int" in_keys(LOCALS))
+     andBool notBool ("$cells" in_keys(LOCALS))
+    [label(digit-loop)]
+endmodule
