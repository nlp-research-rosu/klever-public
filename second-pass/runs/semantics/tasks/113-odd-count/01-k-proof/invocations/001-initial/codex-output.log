+      OUT |-> list(ACC:ValSeq)
+      =>
+      OUT |-> list(
+               oddCountFrom(
+                 ACC,
+                 vCons(str(CS), REST)))
+    </heap>
+    requires allDigit(CS)
+     andBool validDigitStrings(REST)
+    [label(outer-loop)]
