+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
+      1  |-> scope(
+              ("lst" |-> list(INPUT))
+              ("result" |-> ref(OUT))
+              ("digits" |-> str(WHOLE))
+              ("count" |-> oddDigitsFrom(N, CS))
+              ("digit" |-> lastDigit(CS, D))
+              ("text" |-> TXT),
+              parent(0))
+    </scopes>
+    requires allDigit(CS)
+    [label(digit-loop)]
+
+  claim
+    <k>
+      #loop(list(.ValSeq), Name("digits"), ODD-OUTER-BODY) ~> CONT:K
+      =>
+      CONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+      -1 |-> builtinsScope
+      0  |-> scope(
+              "odd_count" |-> closureVal("lst", ODD-COUNT-BODY, 0),
+              parent(-1))
+      1  |-> scope(
+              ("lst" |-> list(WHOLE:ValSeq))
+              ("result" |-> ref(OUT:Int))
+              ("digits" |-> str(.IntSeq))
+              ("count" |-> 0)
+              ("digit" |-> str(.IntSeq))
+              ("text" |-> str(.IntSeq)),
+              parent(0))
+      =>
