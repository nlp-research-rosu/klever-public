+              parent(-1))
+      1  |-> scope(
+              ("lst" |-> list(WHOLE:ValSeq))
+              ("result" |-> ref(OUT:Int))
+              ("digits" |-> str(.IntSeq))
+              ("count" |-> 0)
+              ("digit" |-> str(.IntSeq))
