/reference/reference-semantics/semantics/subscript.k:81:  rule slStart(someB(I:Int), ST:OptInt, LEN:Int)  => slAdjust(I, LEN, slStep(ST))
/reference/reference-semantics/semantics/subscript.k:82:
/reference/reference-semantics/semantics/subscript.k:83:  syntax Int ::= slStop(OptInt, OptInt, Int) [function]
