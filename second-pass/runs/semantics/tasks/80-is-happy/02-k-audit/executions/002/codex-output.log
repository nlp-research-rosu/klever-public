import itertools
root=Path('/reference/reference-semantics')
ents=sorted(root.rglob('*'),key=lambda p:p.relative_to(root).as_posix())
targets={'1de6d5f51876cf9d0f4449a78f077f8b127a14add0504d5060da680fc5a443de','36288fc0a5134e284ff4fa9af3eaa619c0c5c1b8ab2c700389418a9725b58e26','4e06397a1c5a2c7be4f6cc3f61490d87805523b8c9d3c1a0ecd8e1d6bde3789f'}
pathforms=lambda p:[p.relative_to(root).as_posix(), './'+p.relative_to(root).as_posix(),p.relative_to(root.parent).as_posix(),'/'+p.relative_to(root).as_posix()]
