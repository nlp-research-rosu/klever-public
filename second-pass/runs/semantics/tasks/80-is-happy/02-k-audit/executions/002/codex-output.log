+    <env> 1 </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        .Map
+          [ "s" <- str(iCons(97, iCons(98, iCons(99, .IntSeq)))) ]
+          [ "i" <- 0 ],
+        parent(0)))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
