/reference/reference-semantics/semantics/subscript.k:95:
/reference/reference-semantics/semantics/subscript.k:96:  syntax Int ::= clampLo(Int, Int) [function, total]
/reference/reference-semantics/semantics/subscript.k:97:  rule clampLo(J:Int, _STEP:Int) => J
