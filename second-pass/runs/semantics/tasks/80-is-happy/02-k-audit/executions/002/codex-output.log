/reference/reference-semantics/semantics/subscript.k:101:
/reference/reference-semantics/semantics/subscript.k:102:  syntax Int ::= clampHi(Int, Int, Int) [function, total]
/reference/reference-semantics/semantics/subscript.k:103:  rule clampHi(I:Int, LEN:Int, _STEP:Int) => I
/reference/reference-semantics/semantics/subscript.k:104:       requires I  <Int LEN
/reference/reference-semantics/semantics/subscript.k:105:  rule clampHi(I:Int, LEN:Int, STEP:Int)  => #if STEP <Int 0 #then LEN -Int 1 #else LEN #fi
