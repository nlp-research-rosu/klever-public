/reference/reference-semantics/semantics/operators.k:14:  // Compare's right operand sits under the CmpOp wrapper — contexts instead of attributes
/reference/reference-semantics/semantics/operators.k:15:  context Compare(HOLE, _)
/reference/reference-semantics/semantics/operators.k:16:  context Compare(_:Val, CmpOp(_, HOLE))
/reference/reference-semantics/semantics/operators.k:17:  rule <k> Compare(LV:Val, CmpOp(OP:String, RV:Val)) => applyCmp(OP, LV, RV) ... </k> [owise]
/reference/reference-semantics/semantics/operators.k:18:
/reference/reference-semantics/semantics/operators.k:19:  rule applyCmp("is",     V:Val, noneV) => V ==K noneV
/reference/reference-semantics/semantics/operators.k:20:  rule applyCmp("is not", V:Val, noneV) => notBool (V ==K noneV)
/reference/reference-semantics/semantics/operators.k:21:
/reference/reference-semantics/semantics/operators.k:22:  // ==== operand deref: heap objects combine/compare by STRUCTURE ============
/reference/reference-semantics/semantics/operators.k:23:  // (Python: list == is structural; identity only via `is`.) priority(40)
/reference/reference-semantics/semantics/operators.k:24:  // preempts the generic dispatch so applyUn/applyBin/applyCmp never see a ref.
/reference/reference-semantics/semantics/operators.k:25:  rule <k> BinOp(OP:String, ref(H:Int), R:Expr) => BinOp(OP, V, R) ... </k>
/reference/reference-semantics/semantics/operators.k:26:       <heap> ... H |-> V:Val ... </heap>
/reference/reference-semantics/semantics/operators.k:27:       [priority(40)]
/reference/reference-semantics/semantics/operators.k:28:  rule <k> BinOp(OP:String, L:Val, ref(H:Int)) => BinOp(OP, L, V) ... </k>
/reference/reference-semantics/semantics/operators.k:29:       <heap> ... H |-> V:Val ... </heap>
/reference/reference-semantics/semantics/operators.k:30:       requires notBool isRefV(L)
/reference/reference-semantics/semantics/operators.k:31:       [priority(40)]
/reference/reference-semantics/semantics/operators.k:32:
/reference/reference-semantics/semantics/operators.k:33:  // the left operand of `in`/`not in` is an ELEMENT (compares by ==K) — never deref'd
/reference/reference-semantics/semantics/operators.k:34:  rule <k> Compare(ref(H:Int), CmpOp(OP:String, R:Expr)) => Compare(V, CmpOp(OP, R)) ... </k>
/reference/reference-semantics/semantics/operators.k:35:       <heap> ... H |-> V:Val ... </heap>
/reference/reference-semantics/semantics/operators.k:36:       requires OP =/=String "in" andBool OP =/=String "not in"
/reference/reference-semantics/semantics/operators.k:37:       [priority(40)]
/reference/reference-semantics/semantics/operators.k:38:  rule <k> Compare(L:Val, CmpOp(OP:String, ref(H:Int))) => Compare(L, CmpOp(OP, V)) ... </k>
/reference/reference-semantics/semantics/operators.k:39:       <heap> ... H |-> V:Val ... </heap>
/reference/reference-semantics/semantics/operators.k:40:       requires notBool isRefV(L)
/reference/reference-semantics/semantics/operators.k:41:        orBool OP ==String "in" orBool OP ==String "not in"
/reference/reference-semantics/semantics/operators.k:42:       [priority(40)]
/reference/reference-semantics/semantics/operators.k:43:
/reference/reference-semantics/semantics/operators.k:44:  rule <k> UnaryOp(OP:String, ref(H:Int)) => UnaryOp(OP, V) ... </k>
/reference/reference-semantics/semantics/operators.k:45:       <heap> ... H |-> V:Val ... </heap>
/reference/reference-semantics/semantics/operators.k:46:       [priority(40)]
/reference/reference-semantics/semantics/operators.k:47:endmodule
/reference/reference-semantics/semantics/int.k:1:// reference/src/semantics/int.k — MPY-INT
/reference/reference-semantics/semantics/int.k:2:// Int cases of the operator dispatch; Python // and % are floored (pyMod).
/reference/reference-semantics/semantics/int.k:3:
/reference/reference-semantics/semantics/int.k:4:module MPY-INT
/reference/reference-semantics/semantics/int.k:5:  imports MPY-CORE
/reference/reference-semantics/semantics/int.k:6:
/reference/reference-semantics/semantics/int.k:7:  rule applyUn("-", I:Int) => 0 -Int I
/reference/reference-semantics/semantics/int.k:8:
/reference/reference-semantics/semantics/int.k:9:  rule applyBin("+",  I1:Int, I2:Int) => I1 +Int I2
/reference/reference-semantics/semantics/int.k:10:  // Bool participates in int arithmetic (x += (a == b))
/reference/reference-semantics/semantics/int.k:11:  rule applyBin("+",  I:Int, B:Bool) => I +Int #if B #then 1 #else 0 #fi
/reference/reference-semantics/semantics/int.k:12:  rule applyBin("+",  B:Bool, I:Int) => #if B #then 1 #else 0 #fi +Int I
/reference/reference-semantics/semantics/int.k:13:  rule applyBin("-",  I1:Int, I2:Int) => I1 -Int I2
/reference/reference-semantics/semantics/int.k:14:  rule applyBin("*",  I1:Int, I2:Int) => I1 *Int I2
/reference/reference-semantics/semantics/int.k:15:  rule applyBin("%",  I1:Int, I2:Int) => pyMod(I1, I2)
/reference/reference-semantics/semantics/int.k:16:  rule applyBin("//", I1:Int, I2:Int) => (I1 -Int pyMod(I1, I2)) /Int I2
/reference/reference-semantics/semantics/int.k:17:  rule applyBin("**", I1:Int, I2:Int) => I1 ^Int I2 requires I2 >=Int 0
/reference/reference-semantics/semantics/int.k:18:
/reference/reference-semantics/semantics/int.k:19:  syntax Int ::= pyMod(Int, Int) [function]
/reference/reference-semantics/semantics/int.k:20:  rule pyMod(I1:Int, I2:Int) => ((I1 %Int I2) +Int I2) %Int I2
/reference/reference-semantics/semantics/int.k:21:
/reference/reference-semantics/semantics/int.k:22:  rule applyCmp("<",  I1:Int, I2:Int)   => I1 <Int  I2
/reference/reference-semantics/semantics/int.k:23:  rule applyCmp("<=", I1:Int, I2:Int)   => I1 <=Int I2
/reference/reference-semantics/semantics/int.k:24:  rule applyCmp(">",  I1:Int, I2:Int)   => I1 >Int  I2
/reference/reference-semantics/semantics/int.k:25:  rule applyCmp(">=", I1:Int, I2:Int)   => I1 >=Int I2
/reference/reference-semantics/semantics/int.k:26:  rule applyCmp("==", I1:Int, I2:Int)   => I1 ==Int I2
/reference/reference-semantics/semantics/int.k:27:  rule applyCmp("!=", I1:Int, I2:Int)   => I1 =/=Int I2
/reference/reference-semantics/semantics/int.k:28:endmodule
/reference/reference-semantics/semantics/bool.k:1:// reference/src/semantics/bool.k — MPY-BOOL
/reference/reference-semantics/semantics/bool.k:2:// Bool operator cases + the truthy boolean operations (not / and / or; and-or are
/reference/reference-semantics/semantics/bool.k:3:// value-returning short-circuit over any Vals, per Python).
/reference/reference-semantics/semantics/bool.k:4:
/reference/reference-semantics/semantics/bool.k:5:module MPY-BOOL
/reference/reference-semantics/semantics/bool.k:6:  imports MPY-CORE
/reference/reference-semantics/semantics/bool.k:7:
/reference/reference-semantics/semantics/bool.k:8:  rule applyUn("not", V:Val) => notBool truthy(V)
/reference/reference-semantics/semantics/bool.k:9:
/reference/reference-semantics/semantics/bool.k:10:  rule applyCmp("==", B1:Bool, B2:Bool) => B1 ==Bool B2
/reference/reference-semantics/semantics/bool.k:11:  rule applyCmp("!=", B1:Bool, B2:Bool) => B1 =/=Bool B2
/reference/reference-semantics/semantics/bool.k:12:
/reference/reference-semantics/semantics/bool.k:13:  // ==== BoolOp: short-circuit, value-returning and / or =====================
/reference/reference-semantics/semantics/bool.k:14:  // the node is its own accumulator: heat the HEAD element only, then either return it
/reference/reference-semantics/semantics/bool.k:15:  // (short-circuit) or drop it and continue
/reference/reference-semantics/semantics/bool.k:16:  context BoolOp(_, (HOLE:Expr, _:Exprs))
/reference/reference-semantics/semantics/bool.k:17:  rule <k> BoolOp(_:String, (V:Val, .Exprs)) => V ... </k>
/reference/reference-semantics/semantics/bool.k:18:  rule <k> BoolOp("and", (V:Val, A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
/reference/reference-semantics/semantics/bool.k:19:       requires truthy(V)
/reference/reference-semantics/semantics/bool.k:20:  rule <k> BoolOp("and", (V:Val, _:Expr, _:Exprs)) => V ... </k>
/reference/reference-semantics/semantics/bool.k:21:       requires notBool truthy(V)
/reference/reference-semantics/semantics/bool.k:22:  rule <k> BoolOp("or",  (V:Val, _:Expr, _:Exprs)) => V ... </k>
/reference/reference-semantics/semantics/bool.k:23:       requires truthy(V)
/reference/reference-semantics/semantics/bool.k:24:  rule <k> BoolOp("or",  (V:Val, A:Expr, REST:Exprs)) => BoolOp("or", (A, REST)) ... </k>
/reference/reference-semantics/semantics/bool.k:25:       requires notBool truthy(V)
/reference/reference-semantics/semantics/bool.k:26:
/reference/reference-semantics/semantics/bool.k:27:  // ==== heap-object head: decide truthiness THROUGH the heap, never rewrite the
/reference/reference-semantics/semantics/bool.k:28:  // operand — and/or return the OBJECT itself (Python identity), not its structure
/reference/reference-semantics/semantics/bool.k:29:  rule <k> BoolOp(_:String, (ref(H:Int), .Exprs)) => ref(H) ... </k>
/reference/reference-semantics/semantics/bool.k:30:       [priority(40)]
/reference/reference-semantics/semantics/bool.k:31:  rule <k> BoolOp("and", (ref(H:Int), A:Expr, REST:Exprs)) => BoolOp("and", (A, REST)) ... </k>
/reference/reference-semantics/semantics/bool.k:32:       <heap> ... H |-> V:Val ... </heap>
/reference/reference-semantics/semantics/bool.k:33:       requires truthy(V)
/reference/reference-semantics/semantics/bool.k:34:       [priority(40)]
/reference/reference-semantics/semantics/bool.k:35:  rule <k> BoolOp("and", (ref(H:Int), _:Expr, _:Exprs)) => ref(H) ... </k>
/reference/reference-semantics/semantics/bool.k:36:       <heap> ... H |-> V:Val ... </heap>
/reference/reference-semantics/semantics/bool.k:37:       requires notBool truthy(V)
/reference/reference-semantics/semantics/bool.k:38:       [priority(40)]
/reference/reference-semantics/semantics/bool.k:39:  rule <k> BoolOp("or", (ref(H:Int), _:Expr, _:Exprs)) => ref(H) ... </k>
/reference/reference-semantics/semantics/bool.k:40:       <heap> ... H |-> V:Val ... </heap>
/reference/reference-semantics/semantics/bool.k:41:       requires truthy(V)
/reference/reference-semantics/semantics/bool.k:42:       [priority(40)]
/reference/reference-semantics/semantics/bool.k:43:  rule <k> BoolOp("or", (ref(H:Int), A:Expr, REST:Exprs)) => BoolOp("or", (A, REST)) ... </k>
/reference/reference-semantics/semantics/bool.k:44:       <heap> ... H |-> V:Val ... </heap>
/reference/reference-semantics/semantics/bool.k:45:       requires notBool truthy(V)
/reference/reference-semantics/semantics/bool.k:46:       [priority(40)]
/reference/reference-semantics/semantics/bool.k:47:endmodule
/reference/reference-semantics/semantics/str.k:1:// reference/src/semantics/str.k — MPY-STR
/reference/reference-semantics/semantics/str.k:2:
/reference/reference-semantics/semantics/str.k:3:module MPY-STR
/reference/reference-semantics/semantics/str.k:4:  imports MPY-CORE
/reference/reference-semantics/semantics/str.k:5:  imports MPY-ITER
/reference/reference-semantics/semantics/str.k:6:
/reference/reference-semantics/semantics/str.k:7:  // ==== iteration (the iterator protocol's str case; yields 1-char strings) ==
/reference/reference-semantics/semantics/str.k:8:  rule <k> #iterNext(str(.IntSeq))                 => #iterDone ... </k>
/reference/reference-semantics/semantics/str.k:9:  rule <k> #iterNext(str(iCons(C:Int, R:IntSeq)))
/reference/reference-semantics/semantics/str.k:10:        => #iterYield(str(iCons(C, .IntSeq)), str(R)) ... </k>
/reference/reference-semantics/semantics/str.k:11:
/reference/reference-semantics/semantics/str.k:12:  // ==== str literal (ASCII-only) ============================================
/reference/reference-semantics/semantics/str.k:13:  syntax IntSeq ::= strToCodes(String) [function]
/reference/reference-semantics/semantics/str.k:14:  rule <k> Str(S:String) => str(strToCodes(S)) ... </k>
/reference/reference-semantics/semantics/str.k:15:  rule strToCodes("") => .IntSeq
/reference/reference-semantics/semantics/str.k:16:  rule strToCodes(S:String) => iCons(ordChar(substrString(S, 0, 1)), strToCodes(substrString(S, 1, lengthString(S))))
/reference/reference-semantics/semantics/str.k:17:    requires S =/=String "" andBool ordChar(substrString(S, 0, 1)) <Int 128
/reference/reference-semantics/semantics/str.k:18:
/reference/reference-semantics/semantics/str.k:19:  // ==== operators: + / == / != / in =========================================
/reference/reference-semantics/semantics/str.k:20:  syntax IntSeq ::= seqConcat(IntSeq, IntSeq) [function, total]
/reference/reference-semantics/semantics/str.k:21:  rule seqConcat(.IntSeq, T:IntSeq)                => T
/reference/reference-semantics/semantics/str.k:22:  rule seqConcat(iCons(I:Int, S:IntSeq), T:IntSeq) => iCons(I, seqConcat(S, T))
/reference/reference-semantics/semantics/str.k:23:
/reference/reference-semantics/semantics/str.k:24:  rule applyBin("+",  str(A:IntSeq), str(B:IntSeq)) => str(seqConcat(A, B))
/reference/reference-semantics/semantics/str.k:25:  rule applyCmp("==", str(A:IntSeq), str(B:IntSeq)) => A ==K B
/reference/reference-semantics/semantics/str.k:26:  rule applyCmp("!=", str(A:IntSeq), str(B:IntSeq)) => notBool (A ==K B)
/reference/reference-semantics/semantics/str.k:27:
/reference/reference-semantics/semantics/str.k:28:  // substring membership: `P in X` iff the code-seq P occurs contiguously in X
/reference/reference-semantics/semantics/str.k:29:  rule applyCmp("in",     str(P:IntSeq), str(X:IntSeq)) => strContains(P, X)
/reference/reference-semantics/semantics/str.k:30:  rule applyCmp("not in", str(P:IntSeq), str(X:IntSeq)) => notBool strContains(P, X)
/reference/reference-semantics/semantics/str.k:31:
/reference/reference-semantics/semantics/str.k:32:  syntax Bool ::= strPrefix(IntSeq, IntSeq) [function, total]
/reference/reference-semantics/semantics/str.k:33:  rule strPrefix(.IntSeq, _:IntSeq)               => true
/reference/reference-semantics/semantics/str.k:34:  rule strPrefix(iCons(_:Int, _:IntSeq), .IntSeq) => false
/reference/reference-semantics/semantics/str.k:35:  rule strPrefix(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => A ==Int B andBool strPrefix(As, Bs)
/reference/reference-semantics/semantics/str.k:36:
/reference/reference-semantics/semantics/str.k:37:  syntax Bool ::= strContains(IntSeq, IntSeq) [function, total]
/reference/reference-semantics/semantics/str.k:38:  rule strContains(P:IntSeq, X:IntSeq) => true  requires strPrefix(P, X)
/reference/reference-semantics/semantics/str.k:39:  rule strContains(P:IntSeq, .IntSeq)  => false requires notBool strPrefix(P, .IntSeq)
/reference/reference-semantics/semantics/str.k:40:  rule strContains(P:IntSeq, iCons(C:Int, Xs:IntSeq)) => strContains(P, Xs)
/reference/reference-semantics/semantics/str.k:41:       requires notBool strPrefix(P, iCons(C, Xs))
/reference/reference-semantics/semantics/str.k:42:
/reference/reference-semantics/semantics/str.k:43:  // ==== lexicographic order: < / <= / > / >= by code point (= Python str order on the code
/reference/reference-semantics/semantics/str.k:44:  // model). strLt reduces on GROUND code-seqs (krun) but is inert/OPAQUE on symbolic ones
/reference/reference-semantics/semantics/str.k:45:  // (a proof's codesProj(V) is an abstract IntSeq — no constructor rule matches), so a symbolic
/reference/reference-semantics/semantics/str.k:46:  // str `<` stays a trusted opaque term the way sortVS / intFloatDiv do. Additive: fires only on
/reference/reference-semantics/semantics/str.k:47:  // str </<=/>/>= comparisons.
/reference/reference-semantics/semantics/str.k:48:  syntax Bool ::= strLt(IntSeq, IntSeq) [function, total]
/reference/reference-semantics/semantics/str.k:49:  rule strLt(.IntSeq, .IntSeq)                => false
/reference/reference-semantics/semantics/str.k:50:  rule strLt(.IntSeq, iCons(_:Int, _:IntSeq)) => true
/reference/reference-semantics/semantics/str.k:51:  rule strLt(iCons(_:Int, _:IntSeq), .IntSeq) => false
/reference/reference-semantics/semantics/str.k:52:  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => true          requires A  <Int B
/reference/reference-semantics/semantics/str.k:53:  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => false         requires A  >Int B
/reference/reference-semantics/semantics/str.k:54:  rule strLt(iCons(A:Int, As:IntSeq), iCons(B:Int, Bs:IntSeq)) => strLt(As, Bs) requires A ==Int B
/reference/reference-semantics/semantics/str.k:55:
/reference/reference-semantics/semantics/str.k:56:  rule applyCmp("<",  str(A:IntSeq), str(B:IntSeq)) => strLt(A, B)
/reference/reference-semantics/semantics/str.k:57:  rule applyCmp(">",  str(A:IntSeq), str(B:IntSeq)) => strLt(B, A)
/reference/reference-semantics/semantics/str.k:58:  rule applyCmp("<=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(B, A)
/reference/reference-semantics/semantics/str.k:59:  rule applyCmp(">=", str(A:IntSeq), str(B:IntSeq)) => notBool strLt(A, B)
/reference/reference-semantics/semantics/str.k:60:endmodule
/reference/reference-semantics/semantics/subscript.k:1:// reference/src/semantics/subscript.k — MPY-SUBSCRIPT
/reference/reference-semantics/semantics/subscript.k:2:
/reference/reference-semantics/semantics/subscript.k:3:module MPY-SUBSCRIPT
/reference/reference-semantics/semantics/subscript.k:4:  imports MPY-CORE
/reference/reference-semantics/semantics/subscript.k:5:
/reference/reference-semantics/semantics/subscript.k:6:  // ==== positional access + negative-index normalization (used only here) ===
/reference/reference-semantics/semantics/subscript.k:7:  // valSeqAt is [total]: in-bounds vCons access reduces as usual; on an OPAQUE sequence (e.g.
/reference/reference-semantics/semantics/subscript.k:8:  // a trusted sort's sortVS(VS)) or OOB it stays an abstract total value — so indexing the
/reference/reference-semantics/semantics/subscript.k:9:  // opaque sorted list is DEFINED (no undischarged #Ceil), matching the old semantics' total
/reference/reference-semantics/semantics/subscript.k:10:  // atK. K trusts the [total] annotation; valid programs index in-bounds.
/reference/reference-semantics/semantics/subscript.k:11:  syntax Val ::= valSeqAt(ValSeq, Int) [function, total]
/reference/reference-semantics/semantics/subscript.k:12:  rule valSeqAt(vCons(V:Val, _:ValSeq), 0)     => V
/reference/reference-semantics/semantics/subscript.k:13:  rule valSeqAt(vCons(_:Val, S:ValSeq), I:Int) => valSeqAt(S, I -Int 1)
/reference/reference-semantics/semantics/subscript.k:14:       requires I >Int 0
/reference/reference-semantics/semantics/subscript.k:15:
/reference/reference-semantics/semantics/subscript.k:16:  syntax Int ::= intSeqAt(IntSeq, Int) [function]
/reference/reference-semantics/semantics/subscript.k:17:  rule intSeqAt(iCons(C:Int, _:IntSeq), 0)     => C
/reference/reference-semantics/semantics/subscript.k:18:  rule intSeqAt(iCons(_:Int, S:IntSeq), I:Int) => intSeqAt(S, I -Int 1)
/reference/reference-semantics/semantics/subscript.k:19:       requires I >Int 0
/reference/reference-semantics/semantics/subscript.k:20:
/reference/reference-semantics/semantics/subscript.k:21:  syntax Int ::= normIdx(Int, Int) [function, total]
/reference/reference-semantics/semantics/subscript.k:22:  rule normIdx(I:Int, LEN:Int) => I +Int LEN requires I  <Int 0
/reference/reference-semantics/semantics/subscript.k:23:  rule normIdx(I:Int, _:Int)   => I          requires I >=Int 0
/reference/reference-semantics/semantics/subscript.k:24:
/reference/reference-semantics/semantics/subscript.k:25:  // ==== Subscript: indexing obj[i] (list / tuple / str) =====================
/reference/reference-semantics/semantics/subscript.k:26:  // contexts (not strict attrs): the Index slot's Slice alternative must never heat
/reference/reference-semantics/semantics/subscript.k:27:  context Subscript(HOLE, _)
/reference/reference-semantics/semantics/subscript.k:28:  context Subscript(_:Val, HOLE:Expr)
/reference/reference-semantics/semantics/subscript.k:29:
/reference/reference-semantics/semantics/subscript.k:30:  // heap-object deref (covers both the index and slice forms via the Index slot)
/reference/reference-semantics/semantics/subscript.k:31:  rule <k> Subscript(ref(H:Int), IX:Index) => Subscript(V, IX) ... </k>
/reference/reference-semantics/semantics/subscript.k:32:       <heap> ... H |-> V:Val ... </heap>
/reference/reference-semantics/semantics/subscript.k:33:       [priority(40)]
/reference/reference-semantics/semantics/subscript.k:34:
/reference/reference-semantics/semantics/subscript.k:35:  rule <k> Subscript(OBJ:Val, I:Int) => applyIndex(OBJ, I) ... </k>
/reference/reference-semantics/semantics/subscript.k:36:
/reference/reference-semantics/semantics/subscript.k:37:  syntax Val ::= applyIndex(Val, Int) [function]
/reference/reference-semantics/semantics/subscript.k:38:  rule applyIndex(list(VS:ValSeq),  I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
/reference/reference-semantics/semantics/subscript.k:39:  rule applyIndex(tuple(VS:ValSeq), I:Int) => valSeqAt(VS, normIdx(I, vsLen(VS)))
/reference/reference-semantics/semantics/subscript.k:40:  rule applyIndex(str(IS:IntSeq),   I:Int)
/reference/reference-semantics/semantics/subscript.k:41:    => str(iCons(intSeqAt(IS, normIdx(I, isLen(IS))), .IntSeq))
/reference/reference-semantics/semantics/subscript.k:42:
/reference/reference-semantics/semantics/subscript.k:43:  // ==== Slice: obj[lo:hi:step] (list / str) — CPython slice.indices ==========
/reference/reference-semantics/semantics/subscript.k:44:  syntax KItem ::= #evalB(Bound) | "#toSome"
/reference/reference-semantics/semantics/subscript.k:45:                 | #slLo(Val, Bound, Bound)
/reference/reference-semantics/semantics/subscript.k:46:                 | #slHi(Val, OptInt, Bound)
/reference/reference-semantics/semantics/subscript.k:47:                 | #slStep(Val, OptInt, OptInt)
/reference/reference-semantics/semantics/subscript.k:48:
/reference/reference-semantics/semantics/subscript.k:49:  syntax OptInt ::= "noB" | someB(Int)
/reference/reference-semantics/semantics/subscript.k:50:  rule <k> #evalB(NoBound)  => noB ... </k>
