/reference/reference-semantics/semantics/core.k:1:// reference/src/semantics/core.k — MPY-CORE
/reference/reference-semantics/semantics/core.k:2:
/reference/reference-semantics/semantics/core.k:3:module MPY-CORE
/reference/reference-semantics/semantics/core.k:4:  imports MPY-SYNTAX
/reference/reference-semantics/semantics/core.k:5:  imports INT
/reference/reference-semantics/semantics/core.k:6:  imports BOOL
/reference/reference-semantics/semantics/core.k:7:  imports STRING
/reference/reference-semantics/semantics/core.k:8:  imports MAP
/reference/reference-semantics/semantics/core.k:9:  imports LIST
/reference/reference-semantics/semantics/core.k:10:  imports K-EQUAL
/reference/reference-semantics/semantics/core.k:11:
/reference/reference-semantics/semantics/core.k:12:  // ==== values, the algebraic lists, and the scope heap =====================
/reference/reference-semantics/semantics/core.k:13:  syntax IntSeq ::= ".IntSeq" | iCons(Int, IntSeq)
/reference/reference-semantics/semantics/core.k:14:  syntax ValSeq ::= ".ValSeq" | vCons(Val, ValSeq)
/reference/reference-semantics/semantics/core.k:15:  syntax Str    ::= str(IntSeq)
/reference/reference-semantics/semantics/core.k:16:
/reference/reference-semantics/semantics/core.k:17:  // the iterable values, grouped under one sort (typing only — dispatch is <k>-cell)
/reference/reference-semantics/semantics/core.k:18:  syntax Iterable ::= list(ValSeq)
/reference/reference-semantics/semantics/core.k:19:                    | tuple(ValSeq)
/reference/reference-semantics/semantics/core.k:20:                    | Str
/reference/reference-semantics/semantics/core.k:21:                    | rangeObj(Int, Int, Int)
/reference/reference-semantics/semantics/core.k:22:                    | zipObj(ValSeq, ValSeq)
/reference/reference-semantics/semantics/core.k:23:                    | zipObjS(IntSeq, IntSeq)
/reference/reference-semantics/semantics/core.k:24:
/reference/reference-semantics/semantics/core.k:25:  syntax Val      ::= Int
/reference/reference-semantics/semantics/core.k:26:                    | Bool
/reference/reference-semantics/semantics/core.k:27:                    | "noneV"
/reference/reference-semantics/semantics/core.k:28:                    | Iterable
/reference/reference-semantics/semantics/core.k:29:                    | ref(Int)          // a heap object: <heap> holds its list(VS)
/reference/reference-semantics/semantics/core.k:30:                    | cellRef(Int)      // a closure cell: <heap> holds cellV(V)
/reference/reference-semantics/semantics/core.k:31:                    | closureVal(ParamNames, Stmts, Int)
/reference/reference-semantics/semantics/core.k:32:                    | typeV(String)     // a type object (int/str), resolved from the builtins frame
/reference/reference-semantics/semantics/core.k:33:                    | builtinV(String)  // a builtin function, resolved like any name (LEGB fallthrough)
/reference/reference-semantics/semantics/core.k:34:                    | boundMethodV(Val, String)   // a cooled Attribute: obj.method
/reference/reference-semantics/semantics/core.k:35:
/reference/reference-semantics/semantics/core.k:36:  syntax Parent   ::= "root" | parent(Int)
/reference/reference-semantics/semantics/core.k:37:  syntax Scope    ::= scope(Map, Parent)
/reference/reference-semantics/semantics/core.k:38:  syntax KResult  ::= Val
/reference/reference-semantics/semantics/core.k:39:  syntax Expr     ::= Val   // cooling puts results back into expression holes
/reference/reference-semantics/semantics/core.k:40:  syntax Vals     ::= List{Val, ","}
/reference/reference-semantics/semantics/core.k:41:  syntax Exc      ::= "NoExc" | "AssertionError"
/reference/reference-semantics/semantics/core.k:42:  syntax RetState ::= "noRet" | retV(Val)
/reference/reference-semantics/semantics/core.k:43:
/reference/reference-semantics/semantics/core.k:44:  // ==== configuration =======================================================
/reference/reference-semantics/semantics/core.k:45:  // The builtins namespace is a real scope at reserved location -1 (the bottom of every
/reference/reference-semantics/semantics/core.k:46:  // chain; scopeLoc only allocates >=1, so -1 never collides). The module scope (loc 0)
/reference/reference-semantics/semantics/core.k:47:  // has it as parent, so an unbound name resolves there last — exactly LEGB. `int`/`str`
/reference/reference-semantics/semantics/core.k:48:  // resolve to their type objects; any local/global binding shadows them via normal lookup.
/reference/reference-semantics/semantics/core.k:49:  configuration
/reference/reference-semantics/semantics/core.k:50:    <k>       #loadAll($PGM:Module) </k>
/reference/reference-semantics/semantics/core.k:51:    <env>     0 </env>
/reference/reference-semantics/semantics/core.k:52:    <scopes>   0     |-> scope(.Map, parent(-1))
/reference/reference-semantics/semantics/core.k:53:              -1    |-> builtinsScope </scopes>
/reference/reference-semantics/semantics/core.k:54:    <scopeLoc> 1 </scopeLoc>
/reference/reference-semantics/semantics/core.k:55:    <heap>    .Map </heap>
/reference/reference-semantics/semantics/core.k:56:    <heapLoc> 0 </heapLoc>
/reference/reference-semantics/semantics/core.k:57:    <stack>   .List </stack>
/reference/reference-semantics/semantics/core.k:58:    <ret>     noRet </ret>
/reference/reference-semantics/semantics/core.k:59:    <exc>     NoExc </exc>
/reference/reference-semantics/semantics/core.k:60:    <exit-code exit=""> 0 </exit-code>
/reference/reference-semantics/semantics/core.k:61:
/reference/reference-semantics/semantics/core.k:62:  // ==== heap allocation (constructed lists become objects) ==================
/reference/reference-semantics/semantics/core.k:63:  // Cons-form emission with a freshness guard (the heap-list-probe discipline:
/reference/reference-semantics/semantics/core.k:64:  // an update-form H[N <- _] never re-normalizes symbolically). heapLoc is
/reference/reference-semantics/semantics/core.k:65:  // monotonic — it does NOT wind back at #pop: returned lists escape by ref.
/reference/reference-semantics/semantics/core.k:66:  // A bare list(VS) Val stays legal (read-only inputs in claims flow unboxed);
/reference/reference-semantics/semantics/core.k:67:  // only CONSTRUCTORS in program syntax allocate.
/reference/reference-semantics/semantics/core.k:68:  syntax Bool ::= isRefV(Val) [function, total]
/reference/reference-semantics/semantics/core.k:69:  rule isRefV(ref(_:Int)) => true
/reference/reference-semantics/semantics/core.k:70:  rule isRefV(_:Val)      => false [owise]
/reference/reference-semantics/semantics/core.k:71:
/reference/reference-semantics/semantics/core.k:72:  // closure cells (Python-faithful capture): the heap holds cellV(V); a
/reference/reference-semantics/semantics/core.k:73:  // cellRef surfacing as the k-redex reads through (lookup is the only use —
/reference/reference-semantics/semantics/core.k:74:  // cellRefs never escape to user-visible values)
/reference/reference-semantics/semantics/core.k:75:  syntax HeapVal ::= cellV(Val)
/reference/reference-semantics/semantics/core.k:76:  syntax Bool ::= isCellRef(Val) [function, total]
/reference/reference-semantics/semantics/core.k:77:  rule isCellRef(cellRef(_:Int)) => true
/reference/reference-semantics/semantics/core.k:78:  rule isCellRef(_:Val)          => false [owise]
/reference/reference-semantics/semantics/core.k:79:  // k-top deref for cell-bound reads surfacing INSIDE the annotated frame
/reference/reference-semantics/semantics/core.k:80:  // (AugAssign's in-place read and friends). The "$cells" guard keeps this
/reference/reference-semantics/semantics/core.k:81:  // DECIDABLY inapplicable in plain frames — an unguarded rule lets the
/reference/reference-semantics/semantics/core.k:82:  // prover narrow abstract k-top values into cellRef junk (probed on
/reference/reference-semantics/semantics/core.k:83:  // 26-remove-duplicates). Cross-frame reads (a comprehension closure
/reference/reference-semantics/semantics/core.k:84:  // reading the enclosing function's cellvar) deref inside #look instead.
/reference/reference-semantics/semantics/core.k:85:  rule <k> cellRef(H:Int) => V ... </k>
/reference/reference-semantics/semantics/core.k:86:       <env> L:Int </env>
/reference/reference-semantics/semantics/core.k:87:       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
/reference/reference-semantics/semantics/core.k:88:       <heap> ... H |-> cellV(V:Val) ... </heap>
/reference/reference-semantics/semantics/core.k:89:       requires "$cells" in_keys(M)
/reference/reference-semantics/semantics/core.k:90:       [priority(40)]
/reference/reference-semantics/semantics/core.k:91:
/reference/reference-semantics/semantics/core.k:92:  // write through a cell (Assign / #bindP / #bindTgt dispatch here on
/reference/reference-semantics/semantics/core.k:93:  // cell-bound names)
/reference/reference-semantics/semantics/core.k:94:  // a keyword argument cools to a TAGGED value (consumed by kw-aware builtins)
/reference/reference-semantics/semantics/core.k:95:  syntax Val ::= kwV(String, Val)
/reference/reference-semantics/semantics/core.k:96:  syntax KItem ::= #kwTag(String)
/reference/reference-semantics/semantics/core.k:97:  rule <k> KwArg(N:String, E:Expr) => E ~> #kwTag(N) ... </k>
/reference/reference-semantics/semantics/core.k:98:  rule <k> V:Val ~> #kwTag(N:String) => kwV(N, V) ... </k>
/reference/reference-semantics/semantics/core.k:99:       requires notBool isKwV(V)
/reference/reference-semantics/semantics/core.k:100:  syntax Bool ::= isKwV(Val) [function, total]
/reference/reference-semantics/semantics/core.k:101:  rule isKwV(kwV(_:String, _:Val)) => true
/reference/reference-semantics/semantics/core.k:102:  rule isKwV(_:Val)                => false [owise]
/reference/reference-semantics/semantics/core.k:103:
/reference/reference-semantics/semantics/core.k:104:  // the frame marker carries the CONCRETE cellvar list, so cell-write dispatch
/reference/reference-semantics/semantics/core.k:105:  // decides by pnMember even over an abstract frame rest (no prover branching)
/reference/reference-semantics/semantics/core.k:106:  syntax Val ::= cellsMark(ParamNames)
/reference/reference-semantics/semantics/core.k:107:  syntax ParamNames ::= cellsOf(Val) [function]
/reference/reference-semantics/semantics/core.k:108:  rule cellsOf(cellsMark(CVS:ParamNames)) => CVS
/reference/reference-semantics/semantics/core.k:109:  syntax Bool ::= pnMember(String, ParamNames) [function, total]
/reference/reference-semantics/semantics/core.k:110:  rule pnMember(_:String, .ParamNames) => false
/reference/reference-semantics/semantics/core.k:111:  rule pnMember(X:String, (P:String, R:ParamNames)) => X ==String P orBool pnMember(X, R)
/reference/reference-semantics/semantics/core.k:112:
/reference/reference-semantics/semantics/core.k:113:  syntax KItem ::= #cellW(Val, Val)
/reference/reference-semantics/semantics/core.k:114:  rule <k> #cellW(cellRef(H:Int), V:Val) => .K ... </k>
/reference/reference-semantics/semantics/core.k:115:       <heap> ... H |-> cellV(_:Val => V) ... </heap>
/reference/reference-semantics/semantics/core.k:116:
/reference/reference-semantics/semantics/core.k:117:  syntax KItem ::= #alloc(Val)
/reference/reference-semantics/semantics/core.k:118:  rule <k> #alloc(V:Val) => ref(N) ... </k>
/reference/reference-semantics/semantics/core.k:119:       <heap>    H:Map => (N |-> V) H </heap>
/reference/reference-semantics/semantics/core.k:120:       <heapLoc> N:Int => N +Int 1 </heapLoc>
/reference/reference-semantics/semantics/core.k:121:       requires notBool N in_keys(H)
/reference/reference-semantics/semantics/core.k:122:
/reference/reference-semantics/semantics/core.k:123:  // ==== module load + statement sequencing ==================================
/reference/reference-semantics/semantics/core.k:124:  syntax KItem ::= #loadAll(Module)
/reference/reference-semantics/semantics/core.k:125:  rule <k> #loadAll(Module(SS:Stmts)) => SS ... </k>
/reference/reference-semantics/semantics/core.k:126:  rule <k> (S:Stmt SS:Stmts):Stmts => S ~> SS ... </k>
/reference/reference-semantics/semantics/core.k:127:  rule <k> .Stmts => .K ... </k>
/reference/reference-semantics/semantics/core.k:128:
/reference/reference-semantics/semantics/core.k:129:  // ==== Name lookup (walk the scope chain; builtins live in the -1 scope) ====
/reference/reference-semantics/semantics/core.k:130:  syntax KItem ::= #look(String, Int)
/reference/reference-semantics/semantics/core.k:131:  rule <k> Name(X:String) => #look(X, L) ... </k> <env> L:Int </env>
/reference/reference-semantics/semantics/core.k:132:  rule <k> #look(X:String, L:Int) => {M[X]}:>Val ... </k>
/reference/reference-semantics/semantics/core.k:133:       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
/reference/reference-semantics/semantics/core.k:134:       requires X in_keys(M)
/reference/reference-semantics/semantics/core.k:135:  // a SYNTACTICALLY cell-bound name reads through the heap cell AT THE
/reference/reference-semantics/semantics/core.k:136:  // LOOKUP (higher priority beats the plain return above on concrete cell
/reference/reference-semantics/semantics/core.k:137:  // bindings; abstract claim values take the plain rule unchanged) — this
/reference/reference-semantics/semantics/core.k:138:  // covers cross-frame cell reads (a comprehension closure reading the
/reference/reference-semantics/semantics/core.k:139:  // enclosing function's cellvar) without a narrowing-prone k-top redex
/reference/reference-semantics/semantics/core.k:140:  // guarded on the FOUND frame's DECLARED cellvars (pnMember over the
/reference/reference-semantics/semantics/core.k:141:  // cellsMark): decidable for every concrete frame pin — plain frames and
/reference/reference-semantics/semantics/core.k:142:  // non-cell names prune outright, so an abstract looked-up value never
/reference/reference-semantics/semantics/core.k:143:  // drags a narrowing cellV heap match along (probed on 5-intersperse and
/reference/reference-semantics/semantics/core.k:144:  // Q4's abstract `numbers` in the annotated frame)
/reference/reference-semantics/semantics/core.k:145:  rule <k> #look(X:String, L:Int) => V ... </k>
/reference/reference-semantics/semantics/core.k:146:       <scopes> ... L |-> scope(M:Map, _:Parent) ... </scopes>
/reference/reference-semantics/semantics/core.k:147:       <heap> ... H |-> cellV(V:Val) ... </heap>
/reference/reference-semantics/semantics/core.k:148:       requires X in_keys(M) andBool "$cells" in_keys(M)
/reference/reference-semantics/semantics/core.k:149:        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
/reference/reference-semantics/semantics/core.k:150:        andBool {M[X]}:>Val ==K cellRef(H)
