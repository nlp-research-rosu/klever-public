/reference/reference-semantics/semantics/controls.k:1:// reference/src/semantics/controls.k — MPY-CONTROLS
/reference/reference-semantics/semantics/controls.k:2:
/reference/reference-semantics/semantics/controls.k:3:module MPY-CONTROLS
/reference/reference-semantics/semantics/controls.k:4:  imports MPY-CORE
/reference/reference-semantics/semantics/controls.k:5:  imports MPY-TUPLE
/reference/reference-semantics/semantics/controls.k:6:  imports MPY-ITER
/reference/reference-semantics/semantics/controls.k:7:
/reference/reference-semantics/semantics/controls.k:8:  // ==== Assign / AugAssign (write the current scope; RHS evaluated by strictness) ==
/reference/reference-semantics/semantics/controls.k:9:  rule <k> Assign(Name(X:String), V:Val) => .K ... </k>
/reference/reference-semantics/semantics/controls.k:10:       <env> L:Int </env>
/reference/reference-semantics/semantics/controls.k:11:       <scopes> ... L |-> scope(M:Map => M [ X <- V ], _) ... </scopes>
/reference/reference-semantics/semantics/controls.k:12:  rule <k> Assign(Name(X:String), V:Val) => #cellW({M[X]}:>Val, V) ... </k>
/reference/reference-semantics/semantics/controls.k:13:       <env> L:Int </env>
/reference/reference-semantics/semantics/controls.k:14:       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
/reference/reference-semantics/semantics/controls.k:15:       requires "$cells" in_keys(M)
/reference/reference-semantics/semantics/controls.k:16:        andBool pnMember(X, cellsOf({M["$cells"]}:>Val))
/reference/reference-semantics/semantics/controls.k:17:        andBool X in_keys(M) andBool isCellRef({M[X]}:>Val)
/reference/reference-semantics/semantics/controls.k:18:       [priority(40)]
/reference/reference-semantics/semantics/controls.k:19:
/reference/reference-semantics/semantics/controls.k:20:  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => .K ... </k>
/reference/reference-semantics/semantics/controls.k:21:       <env> L:Int </env>
/reference/reference-semantics/semantics/controls.k:22:       <scopes> ... L |-> scope(M:Map => M [ X <- applyBin(OP, {M[X]}:>Val, V) ], _) ... </scopes>
/reference/reference-semantics/semantics/controls.k:23:       requires X in_keys(M)
/reference/reference-semantics/semantics/controls.k:24:  // `lst += [..]` where lst is a heap ref: the generic rule leaves applyBin(OP, ref, V) — but the
/reference/reference-semantics/semantics/controls.k:25:  // ref-deref preemption is BinOp-level (operators.k), so applyBin never derefs and it sticks. Route
/reference/reference-semantics/semantics/controls.k:26:  // the ref case through BinOp so the deref + list-concat + #alloc path fires (result is a fresh ref).
/reference/reference-semantics/semantics/controls.k:27:  rule <k> AugAssign(Name(X:String), OP:String, V:Val) => Assign(Name(X), BinOp(OP, Name(X), V)) ... </k>
/reference/reference-semantics/semantics/controls.k:28:       <env> L:Int </env>
/reference/reference-semantics/semantics/controls.k:29:       <scopes> ... L |-> scope(M:Map, _) ... </scopes>
/reference/reference-semantics/semantics/controls.k:30:       requires X in_keys(M) andBool isRefV({M[X]}:>Val)
/reference/reference-semantics/semantics/controls.k:31:       [priority(40)]
/reference/reference-semantics/semantics/controls.k:32:
/reference/reference-semantics/semantics/controls.k:33:  // ==== import trivia: `from math import floor, ceil` binds the supported
/reference/reference-semantics/semantics/controls.k:34:  // names as builtins in the current scope; every other import is a no-op
/reference/reference-semantics/semantics/controls.k:35:  rule <k> ImportFrom("math", NS:ParamNames) => #bindImports(NS) ... </k>
/reference/reference-semantics/semantics/controls.k:36:  rule <k> ImportFrom(_:String, _:ParamNames) => .K ... </k> [owise]
/reference/reference-semantics/semantics/controls.k:37:  syntax KItem ::= #bindImports(ParamNames)
/reference/reference-semantics/semantics/controls.k:38:  rule <k> #bindImports(.ParamNames) => .K ... </k>
/reference/reference-semantics/semantics/controls.k:39:  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
/reference/reference-semantics/semantics/controls.k:40:       <env> L:Int </env>
/reference/reference-semantics/semantics/controls.k:41:       <scopes> ... L |-> scope(M:Map => M [ N <- builtinV(N) ], _) ... </scopes>
/reference/reference-semantics/semantics/controls.k:42:       requires N ==String "floor" orBool N ==String "ceil"
/reference/reference-semantics/semantics/controls.k:43:  rule <k> #bindImports((N:String, NS:ParamNames)) => #bindImports(NS) ... </k>
/reference/reference-semantics/semantics/controls.k:44:       requires notBool (N ==String "floor" orBool N ==String "ceil")
/reference/reference-semantics/semantics/controls.k:45:
/reference/reference-semantics/semantics/controls.k:46:  // ==== Expr statement: evaluate for effect, discard the value ===============
/reference/reference-semantics/semantics/controls.k:47:  // (bare calls — mutator methods, docstrings; the WP0 statement-trivia rung)
/reference/reference-semantics/semantics/controls.k:48:  rule <k> Expr(_:Val) => .K ... </k>
/reference/reference-semantics/semantics/controls.k:49:
/reference/reference-semantics/semantics/controls.k:50:  // ==== If (condition evaluated by strictness) ==============================
/reference/reference-semantics/semantics/controls.k:51:  syntax KItem ::= #branch(Bool, Stmts, Stmts)
/reference/reference-semantics/semantics/controls.k:52:  rule <k> If(C:Val, T:Stmts, E:Stmts) => #branch(truthy(C), T, E) ... </k>
/reference/reference-semantics/semantics/controls.k:53:  rule <k> #branch(true,  T:Stmts, _:Stmts) => T ... </k>
/reference/reference-semantics/semantics/controls.k:54:  rule <k> #branch(false, _:Stmts, E:Stmts) => E ... </k>
/reference/reference-semantics/semantics/controls.k:55:
/reference/reference-semantics/semantics/controls.k:56:  // ==== IfExp: ternary T if C else E ========================================
/reference/reference-semantics/semantics/controls.k:57:  rule <k> IfExp(V:Val, T:Expr, _:Expr) => T ... </k>
/reference/reference-semantics/semantics/controls.k:58:       requires truthy(V)
/reference/reference-semantics/semantics/controls.k:59:  rule <k> IfExp(V:Val, _:Expr, E:Expr) => E ... </k>
/reference/reference-semantics/semantics/controls.k:60:       requires notBool truthy(V)
/reference/reference-semantics/semantics/controls.k:61:
/reference/reference-semantics/semantics/controls.k:62:  // ==== For: one loop, in-cell continuation, over #iterNext =================
/reference/reference-semantics/semantics/controls.k:63:  // (the iterable is evaluated once, by strictness; the protocol stays rewrites —
/reference/reference-semantics/semantics/controls.k:64:  // circularities anchor on #loop and narrowing substitutes the structure)
/reference/reference-semantics/semantics/controls.k:65:  syntax KItem ::= #loop(Val, Expr, Stmts) | #loopStep(Expr, Stmts)
/reference/reference-semantics/semantics/controls.k:66:                 | #while(Expr, Stmts) | #whileCond(Expr, Stmts)
/reference/reference-semantics/semantics/controls.k:67:                 | #loopLbl(K) | "#cont" | "#brk"
/reference/reference-semantics/semantics/controls.k:68:
/reference/reference-semantics/semantics/controls.k:69:  rule <k> For(T:Expr, OBJ:Val, B:Stmts) => #loop(OBJ, T, B) ... </k>
/reference/reference-semantics/semantics/controls.k:70:
/reference/reference-semantics/semantics/controls.k:71:  rule <k> #loop(IT:Iterable, T:Expr, B:Stmts) => #iterNext(IT) ~> #loopStep(T, B) ... </k>
/reference/reference-semantics/semantics/controls.k:72:  rule <k> #iterDone ~> #loopStep(_:Expr, _:Stmts) => .K ... </k>
/reference/reference-semantics/semantics/controls.k:73:  rule <k> #iterYield(V:Val, REST:Iterable) ~> #loopStep(T:Expr, B:Stmts)
/reference/reference-semantics/semantics/controls.k:74:        => #bindTgt(T, V) ~> B ~> #loopLbl(#loop(REST, T, B)) ... </k>
/reference/reference-semantics/semantics/controls.k:75:
/reference/reference-semantics/semantics/controls.k:76:  // ==== While ==============================================================
/reference/reference-semantics/semantics/controls.k:77:  rule <k> While(C:Expr, B:Stmts) => #while(C, B) ... </k>
/reference/reference-semantics/semantics/controls.k:78:  rule <k> #while(C:Expr, B:Stmts) => C ~> #whileCond(C, B) ... </k>
/reference/reference-semantics/semantics/controls.k:79:  rule <k> V:Val ~> #whileCond(C:Expr, B:Stmts) => B ~> #loopLbl(#while(C, B)) ... </k>
/reference/reference-semantics/semantics/controls.k:80:       requires truthy(V)
/reference/reference-semantics/semantics/controls.k:81:  rule <k> V:Val ~> #whileCond(_C:Expr, _B:Stmts) => .K ... </k>
/reference/reference-semantics/semantics/controls.k:82:       requires notBool truthy(V)
/reference/reference-semantics/semantics/controls.k:83:
/reference/reference-semantics/semantics/controls.k:84:  // ==== loop control (break / continue) =====================================
/reference/reference-semantics/semantics/controls.k:85:  rule <k> #loopLbl(NEXT:K) => NEXT ... </k>
/reference/reference-semantics/semantics/controls.k:86:  rule <k> Continue => #cont ... </k>
/reference/reference-semantics/semantics/controls.k:87:  rule <k> Break => #brk ... </k>
/reference/reference-semantics/semantics/controls.k:88:  rule <k> #cont ~> #loopLbl(NEXT:K) => NEXT ... </k>
/reference/reference-semantics/semantics/controls.k:89:  rule <k> #cont ~> (_:KItem => .K) ... </k> [owise]
/reference/reference-semantics/semantics/controls.k:90:  rule <k> #brk ~> #loopLbl(_:K) => .K ... </k>
/reference/reference-semantics/semantics/controls.k:91:  rule <k> #brk ~> (_:KItem => .K) ... </k> [owise]
/reference/reference-semantics/semantics/controls.k:92:
/reference/reference-semantics/semantics/controls.k:93:  // ==== heap-object deref at the truthiness/iteration consumers ==============
/reference/reference-semantics/semantics/controls.k:94:  // (priority(40) preempts the generic Val rules so truthy/#loop never see a ref)
/reference/reference-semantics/semantics/controls.k:95:  rule <k> If(ref(H:Int), T:Stmts, E:Stmts) => If(V, T, E) ... </k>
/reference/reference-semantics/semantics/controls.k:96:       <heap> ... H |-> V:Val ... </heap>
/reference/reference-semantics/semantics/controls.k:97:       [priority(40)]
/reference/reference-semantics/semantics/controls.k:98:  rule <k> IfExp(ref(H:Int), T:Expr, E:Expr) => IfExp(V, T, E) ... </k>
/reference/reference-semantics/semantics/controls.k:99:       <heap> ... H |-> V:Val ... </heap>
/reference/reference-semantics/semantics/controls.k:100:       [priority(40)]
/reference/reference-semantics/semantics/controls.k:101:  rule <k> ref(H:Int) ~> #whileCond(C:Expr, B:Stmts) => V ~> #whileCond(C, B) ... </k>
/reference/reference-semantics/semantics/controls.k:102:       <heap> ... H |-> V:Val ... </heap>
/reference/reference-semantics/semantics/controls.k:103:       [priority(40)]
/reference/reference-semantics/semantics/controls.k:104:  // For derefs its iterable ONCE at loop start (iteration is over the snapshot;
/reference/reference-semantics/semantics/controls.k:105:  // mutating the iterated list inside its own loop is outside the subset)
/reference/reference-semantics/semantics/controls.k:106:  rule <k> For(T:Expr, ref(H:Int), B:Stmts) => For(T, V, B) ... </k>
/reference/reference-semantics/semantics/controls.k:107:       <heap> ... H |-> V:Val ... </heap>
/reference/reference-semantics/semantics/controls.k:108:       [priority(40)]
/reference/reference-semantics/semantics/controls.k:109:endmodule
/reference/reference-semantics/semantics/functions.k:1:// reference/src/semantics/functions.k — MPY-FUNCTIONS
/reference/reference-semantics/semantics/functions.k:2:
/reference/reference-semantics/semantics/functions.k:3:module MPY-FUNCTIONS
/reference/reference-semantics/semantics/functions.k:4:  imports MPY-CORE
/reference/reference-semantics/semantics/functions.k:5:
/reference/reference-semantics/semantics/functions.k:6:  // call routing + callee/arg evaluation (#callee/#args/#argCont) live in call.k;
/reference/reference-semantics/semantics/functions.k:7:  // this module owns the frame lifecycle (bind params, return, pop).
/reference/reference-semantics/semantics/functions.k:8:  syntax KItem ::= frame(continuation: K, callerEnv: Int, savedLoc: Int)
/reference/reference-semantics/semantics/functions.k:9:                 | #bindP(ParamNames, Vals)
/reference/reference-semantics/semantics/functions.k:10:                 | "#pop"
/reference/reference-semantics/semantics/functions.k:11:                 | "#endcall"
/reference/reference-semantics/semantics/functions.k:12:
/reference/reference-semantics/semantics/functions.k:13:  // ==== def / anonymous closure =============================================
/reference/reference-semantics/semantics/functions.k:14:  rule <k> FuncDef(F:String, Params(PNS:ParamNames), BODY:Stmts) => .K ... </k>
/reference/reference-semantics/semantics/functions.k:15:       <env> L:Int </env>
/reference/reference-semantics/semantics/functions.k:16:       <scopes> ... L |-> scope(M:Map => M [ F <- closureVal(PNS, BODY, L) ], _) ... </scopes>
/reference/reference-semantics/semantics/functions.k:17:
/reference/reference-semantics/semantics/functions.k:18:  syntax Expr ::= closureExpr(ParamNames, Stmts)
/reference/reference-semantics/semantics/functions.k:19:  rule <k> closureExpr(PNS:ParamNames, BODY:Stmts) => closureVal(PNS, BODY, L) ... </k>
/reference/reference-semantics/semantics/functions.k:20:       <env> L:Int </env>
/reference/reference-semantics/semantics/functions.k:21:
/reference/reference-semantics/semantics/functions.k:22:  // ==== annotated def/lambda (closure cells; spec 2.3) ======================
/reference/reference-semantics/semantics/functions.k:23:  // closureValC(params, cellvars, body, captured-cells). No frame anchor: all
/reference/reference-semantics/semantics/functions.k:24:  // enclosing-local reads are freevars (symtable-complete) and go through the
/reference/reference-semantics/semantics/functions.k:25:  // captured cells; everything else is global/builtin, so the callee frame's
/reference/reference-semantics/semantics/functions.k:26:  // parent is the module scope (0) — sound after the defining frame dies.
/reference/reference-semantics/semantics/functions.k:27:  syntax Val ::= closureValC(ParamNames, ParamNames, Stmts, Map)
/reference/reference-semantics/semantics/functions.k:28:
/reference/reference-semantics/semantics/functions.k:29:  // capture: resolve each freevar to the enclosing frame's cellRef, then bind
/reference/reference-semantics/semantics/functions.k:30:  // (FuncDef) or yield (Lambda) the closure value.
