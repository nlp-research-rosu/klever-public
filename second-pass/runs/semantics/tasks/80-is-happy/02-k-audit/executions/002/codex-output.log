/reference/reference-semantics/semantics/syntax.k:15:                | "BinOp"    "(" String "," Expr "," Expr ")" [seqstrict(2, 3)]
/reference/reference-semantics/semantics/syntax.k:16:                | "BoolOp"    "(" String "," Exprs ")"
/reference/reference-semantics/semantics/syntax.k:17:                | "ListExpr"  "(" Exprs ")"
/reference/reference-semantics/semantics/syntax.k:18:                | "DictExpr"  "(" Entries ")"
