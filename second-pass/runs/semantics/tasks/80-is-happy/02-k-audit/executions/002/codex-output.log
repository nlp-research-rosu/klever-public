+run_proof prove_entry \
+  kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
+
+printf 'OVERALL_EXIT_STATUS: %s\n' "${failed}" >>"${summary}"
+exit "${failed}"

