/reference/reference-semantics/semantics/subscript.k:91:  rule slAdjust(I:Int, LEN:Int, STEP:Int) => clampLo(I +Int LEN, STEP)
/reference/reference-semantics/semantics/subscript.k:92:       requires I  <Int 0
