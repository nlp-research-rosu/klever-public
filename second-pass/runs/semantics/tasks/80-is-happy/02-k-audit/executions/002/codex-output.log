+    <env> 1 </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        .Map [ "s" <- str(iCons(97, iCons(97, iCons(98, .IntSeq)))) ],
+        parent(0)))
+      => ?FINAL_SCOPES_AAB:Map
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
