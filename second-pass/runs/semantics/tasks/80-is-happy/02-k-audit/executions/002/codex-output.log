/reference/reference-semantics/semantics/syntax.k:27:                | "NoneVal"
/reference/reference-semantics/semantics/syntax.k:28:                | "Call"      "(" Expr "," Exprs ")"
/reference/reference-semantics/semantics/syntax.k:29:                | "Attribute" "(" Expr "," String ")" [strict(1)]
/reference/reference-semantics/semantics/syntax.k:30:                | "Compare"   "(" Expr "," CmpOp ")"
/reference/reference-semantics/semantics/syntax.k:31:
/reference/reference-semantics/semantics/syntax.k:32:  syntax CmpOp    ::= "CmpOp" "(" String "," Expr ")"
