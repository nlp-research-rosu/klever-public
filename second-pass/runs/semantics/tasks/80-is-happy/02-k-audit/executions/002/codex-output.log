/reference/reference-semantics/semantics/syntax.k:40:
/reference/reference-semantics/semantics/syntax.k:41:  syntax Stmt ::= "Assign"    "(" Expr "," Expr ")" [strict(2)]
/reference/reference-semantics/semantics/syntax.k:42:                | "Import"    "(" String ")"
/reference/reference-semantics/semantics/syntax.k:43:                | "ImportFrom" "(" String "," ParamNames ")"
/reference/reference-semantics/semantics/syntax.k:44:                | "AugAssign" "(" Expr "," String "," Expr ")" [strict(3)]
/reference/reference-semantics/semantics/syntax.k:45:                | "For"       "(" Expr "," Expr "," Stmts ")" [strict(2)]
/reference/reference-semantics/semantics/syntax.k:46:                | "While"     "(" Expr "," Stmts ")"
/reference/reference-semantics/semantics/syntax.k:47:                | "Break"
/reference/reference-semantics/semantics/syntax.k:48:                | "Continue"
/reference/reference-semantics/semantics/syntax.k:49:                | "If"        "(" Expr "," Stmts "," Stmts ")" [strict(1)]
/reference/reference-semantics/semantics/syntax.k:50:                | "Return"    "(" Expr ")" [strict]
/reference/reference-semantics/semantics/syntax.k:51:                | "Assert"    "(" Expr ")" [strict]
/reference/reference-semantics/semantics/syntax.k:52:                | "Expr"      "(" Expr ")" [strict]
/reference/reference-semantics/semantics/syntax.k:53:                | "FuncDef"   "(" String "," Params "," Stmts ")"
/reference/reference-semantics/semantics/syntax.k:54:                | "FuncDef"   "(" String "," Params "," CellVars "," FreeVars "," Stmts ")"
