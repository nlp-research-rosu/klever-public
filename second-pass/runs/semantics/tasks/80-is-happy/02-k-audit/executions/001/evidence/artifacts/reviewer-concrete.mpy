Module(
  FuncDef("is_happy", Params("s"),
    If(Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
      Return(Bool(false)),
      )
    Assign(Name("i"), Int(0))
    While(Compare(
      BinOp("+", Name("i"), Int(2)),
      CmpOp("<", Call(Name("len"), Name("s")))),
      If(Compare(
        Subscript(Name("s"), Name("i")),
        CmpOp("==", Subscript(Name("s"), BinOp("+", Name("i"), Int(1))))),
        Return(Bool(false)),
        )
      If(Compare(
        Subscript(Name("s"), Name("i")),
        CmpOp("==", Subscript(Name("s"), BinOp("+", Name("i"), Int(2))))),
        Return(Bool(false)),
        )
      If(Compare(
        Subscript(Name("s"), BinOp("+", Name("i"), Int(1))),
        CmpOp("==", Subscript(Name("s"), BinOp("+", Name("i"), Int(2))))),
        Return(Bool(false)),
        )
      AugAssign(Name("i"), "+", Int(1)))
    Return(Bool(true)))
  Assert(UnaryOp("not", Call(Name("is_happy"), Str(""))))
  Assert(UnaryOp("not", Call(Name("is_happy"), Str("a"))))
  Assert(UnaryOp("not", Call(Name("is_happy"), Str("aa"))))
  Assert(Call(Name("is_happy"), Str("abc")))
  Assert(UnaryOp("not", Call(Name("is_happy"), Str("aab"))))
  Assert(UnaryOp("not", Call(Name("is_happy"), Str("aba"))))
  Assert(UnaryOp("not", Call(Name("is_happy"), Str("abb"))))
  Assert(Call(Name("is_happy"), Str("abcd")))
  Assert(UnaryOp("not", Call(Name("is_happy"), Str("abcaab"))))
  Assert(UnaryOp("not", Call(Name("is_happy"), Str("abcaba"))))
  Assert(UnaryOp("not", Call(Name("is_happy"), Str("abcabb"))))
  Assert(Call(Name("is_happy"), Str("abcabc")))
  Assert(UnaryOp("not", Call(Name("is_happy"), Str("abcabcaa")))))
