+      ~> (Return(Bool(true)) .Stmts)
+      ~> #endcall
+    =>
+      #pop
+    </k>
+    <env> 1 </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        .Map
+          [ "s" <- str(iCons(97, iCons(98, iCons(99, .IntSeq)))) ]
+          [ "i" <- 0 ],
+        parent(0)))
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet => retV(true) </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
