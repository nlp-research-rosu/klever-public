@@ -0,0 +1,32 @@
+requires "verification.k"
+
+module SPEC-VACUITY-REVIEWER
+  imports VERIFICATION
+
+  // Deliberately false: negate the result-constraining public postcondition.
+  // Witness: IS = [97, 98, 99] ("abc"), L = 1, REST = .Map.
+  // Both Python implementations and isHappySpec return true, but this asks false.
+  claim [is-happy-wrong-negated-result]:
+    <k> isHappyBody ~> #endcall => #pop </k>
+    <env> L:Int </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (L |-> scope(.Map [ "s" <- str(IS:IntSeq) ], parent(0)))
+      REST:Map
+    =>
+      ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> SL:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> noRet => retV(notBool isHappySpec(IS)) </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires L =/=Int 0
+     andBool L =/=Int -1
+     andBool notBool 0 in_keys(REST)
+     andBool notBool -1 in_keys(REST)
+     andBool notBool L in_keys(REST)
+endmodule
diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..42a75d162fa5cee57c33ed6c76145347ea3cc3e8
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: $0 LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+logfile=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+} >"$logfile"
+
+"$@" 2>&1 | tee -a "$logfile"
+status=${PIPESTATUS[0]}
+printf 'EXIT_STATUS: %d\n' "$status" | tee -a "$logfile"
+exit "$status"
