--- /dev/null
+++ b/evidence/scripts/make_k_concrete_harness.py
@@ -0,0 +1,39 @@
+#!/usr/bin/env python3
+"""Append reviewer-authored assertions to the exact submitted Python source."""
+
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+
+
+ASSERTIONS = """
+
+assert not is_happy("")
+assert not is_happy("a")
+assert not is_happy("aa")
+assert is_happy("abc")
+assert not is_happy("aab")
+assert not is_happy("aba")
+assert not is_happy("abb")
+assert is_happy("abcd")
+assert not is_happy("abcaab")
+assert not is_happy("abcaba")
+assert not is_happy("abcabb")
+assert is_happy("abcabc")
+assert not is_happy("abcabcaa")
+"""
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser()
+    parser.add_argument("solution", type=Path)
+    parser.add_argument("output", type=Path)
+    args = parser.parse_args()
+    source = args.solution.read_text(encoding="utf-8")
+    args.output.write_text(source.rstrip() + "\n" + ASSERTIONS, encoding="utf-8")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())

diff --git a/evidence/run_logged.sh b/evidence/run_logged.sh
new file mode 100644
index 0000000000000000000000000000000000000000..42a75d162fa5cee57c33ed6c76145347ea3cc3e8
--- /dev/null
+++ b/evidence/run_logged.sh
@@ -0,0 +1,22 @@
+#!/usr/bin/env bash
+set -uo pipefail
+
+if [[ $# -lt 2 ]]; then
+  echo "usage: $0 LOGFILE COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+logfile=$1
+shift
+
+{
+  printf 'COMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  printf 'WORKDIR: %s\n' "$PWD"
+} >"$logfile"
+
+"$@" 2>&1 | tee -a "$logfile"
+status=${PIPESTATUS[0]}
+printf 'EXIT_STATUS: %d\n' "$status" | tee -a "$logfile"
+exit "$status"
