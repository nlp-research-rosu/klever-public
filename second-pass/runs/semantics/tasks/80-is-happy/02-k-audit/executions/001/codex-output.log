+
+  claim [abcd-is-true]:
+    <k> isHappyBody ~> #endcall => #pop </k>
+    <env> 1 </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (1 |-> scope(
+        .Map
+          [ "s" <- str(iCons(97, iCons(98, iCons(99, iCons(100, .IntSeq))))) ],
+        parent(0)))
+    => ?FINAL_SCOPES_4:Map
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet => retV(true) </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
