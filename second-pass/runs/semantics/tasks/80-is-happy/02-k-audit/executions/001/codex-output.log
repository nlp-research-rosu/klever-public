+#!/usr/bin/env python3
+"""Append reviewer-authored assertions to the exact submitted Python source."""
+
+from __future__ import annotations
+
+import argparse
+from pathlib import Path
+
+
+ASSERTIONS = """
+
+assert not is_happy("")
+assert not is_happy("a")
