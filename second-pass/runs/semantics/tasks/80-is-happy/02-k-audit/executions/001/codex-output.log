+            or trusted != expected
+            or actual != expected
+        ):
+            mismatches.append(
+                {
+                    "input": s,
+                    "oracle": expected,
+                    "canonical": trusted,
+                    "generated": actual,
+                    "canonical_type": type(trusted).__name__,
+                    "generated_type": type(actual).__name__,
+                }
+            )
+
+    for label, s in named:
+        print(
