+    =>
+      #pop
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (L |-> scope(
+        .Map
+          [ "s" <- str(IS:IntSeq) ]
+          [ "i" <- (I:Int => ?FINAL_I:Int) ],
+        parent(0)))
+      REST:Map
+    </scopes>
+    <scopeLoc> SL:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> noRet => retV(happyFrom(IS, I)) </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+     andBool L =/=Int 0
+     andBool L =/=Int -1
+     andBool notBool 0 in_keys(REST)
+     andBool notBool -1 in_keys(REST)
+     andBool notBool L in_keys(REST)
+
+endmodule
+
+module SPEC
+  imports VERIFICATION
+
