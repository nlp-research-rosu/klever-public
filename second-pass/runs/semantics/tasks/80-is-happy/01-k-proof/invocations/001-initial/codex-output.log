+      ~> Return(Bool(true))
+      ~> #endcall
+    =>
+      #pop
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (L |-> scope(
+        .Map
+          [ "s" <- str(IS:IntSeq) ]
+          [ "i" <- (I:Int => ?FINAL_I:Int) ],
+        parent(0)))
+      REST:Map
+    </scopes>
+    <scopeLoc> SL:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> noRet => retV(happyFrom(IS, I)) </ret>
+    <exc> NoExc </exc>
