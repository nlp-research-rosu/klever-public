@@ -0,0 +1,16 @@
+def _happy_from(s, i):
+    if i + 2 >= len(s):
+        return True
+    if s[i] == s[i + 1]:
+        return False
+    if s[i] == s[i + 2]:
+        return False
+    if s[i + 1] == s[i + 2]:
+        return False
+    return _happy_from(s, i + 1)
+
+
+def is_happy(s):
+    if len(s) < 3:
+        return False
+    return _happy_from(s, 0)
