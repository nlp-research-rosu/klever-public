+    <k> isHappyBody ~> #endcall => #pop </k>
+    <env> L:Int </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (L |-> scope(.Map [ "s" <- str(IS:IntSeq) ], parent(0)))
+      REST:Map
+    =>
+      ?FINAL_SCOPES:Map
+    </scopes>
+    <scopeLoc> SL:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack> ST:List </stack>
