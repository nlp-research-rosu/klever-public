diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..a458401f7ce8e81f4da5b7bbf54916943a216fbe
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,13 @@
+def is_happy(s):
+    if len(s) < 3:
+        return False
+    i = 0
+    while i + 2 < len(s):
+        if s[i] == s[i + 1]:
+            return False
+        if s[i] == s[i + 2]:
+            return False
+        if s[i + 1] == s[i + 2]:
+            return False
+        i += 1
+    return True
