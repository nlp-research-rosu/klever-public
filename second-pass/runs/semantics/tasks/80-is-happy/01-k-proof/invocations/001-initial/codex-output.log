+    <k>
+      #while(happyLoopCondition, happyLoopBody)
+      ~> Return(Bool(true))
+      ~> #endcall
+    =>
+      #pop
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("s" |-> str(IS:IntSeq)) ("i" |-> 0),
+        parent(0))
+      ...
+    </scopes>
+    <ret> noRet => retV(happyFrom(IS, 0)) </ret>
+    [priority(40)]
+endmodule

