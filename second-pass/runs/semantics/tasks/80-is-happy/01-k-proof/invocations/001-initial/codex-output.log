+    <k>
+      #while(happyLoopCondition, happyLoopBody)
+      ~> Return(Bool(true))
+      ~> #endcall
+    =>
+      #pop
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (0 |-> solutionScope)
