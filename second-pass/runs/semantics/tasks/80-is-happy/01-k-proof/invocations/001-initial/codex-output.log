+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [happy-from-correct]:
+    <k>
+      #applyK(
+        toCall(happyFromClosure),
+        (str(IS:IntSeq), I:Int, .Vals))
+      ~> CONT:K
+    =>
+      happyFrom(IS, I) ~> CONT
+    </k>
+    <env> E:Int </env>
+    <scopes>
+      (0 |-> solutionScope) REST:Map
+    </scopes>
+    <scopeLoc> L:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+    requires I >=Int 0
+     andBool notBool L in_keys((0 |-> solutionScope) REST)
+
+  claim [is-happy-correct]:
+    <k>
+      #applyK(
+        toCall(isHappyClosure),
+        (str(IS:IntSeq), .Vals))
+      ~> CONT:K
+    =>
+      isHappySpec(IS) ~> CONT
+    </k>
+    <env> E:Int </env>
+    <scopes>
+      (0 |-> solutionScope) REST:Map
+    </scopes>
+    <scopeLoc> L:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code exit=""> 0 </exit-code>
+    requires notBool L in_keys((0 |-> solutionScope) REST)
