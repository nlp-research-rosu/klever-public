+      ~> #endcall
+    =>
+      #pop
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (L |-> scope(
+        .Map
+          [ "s" <- str(IS:IntSeq) ]
+          [ "i" <- (I:Int => ?FINAL_I:Int) ],
+        parent(0)))
+      REST:Map
