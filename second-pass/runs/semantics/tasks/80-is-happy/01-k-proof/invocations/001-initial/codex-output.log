diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..b054849fb996d7c7de188d88dc084e1d1b53df9b
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,120 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The two closures below are the constructor-level translation in
+  // solution.mpy, represented as values after module loading.
+  syntax Stmts ::= "happyFromBody" [function, total]
+  rule happyFromBody
+    => If(
+         Compare(
+           BinOp("+", Name("i"), Int(2)),
+           CmpOp(">=", Call(Name("len"), Name("s")))),
+         Return(Bool(true)),
+         .Stmts)
+       If(
+         Compare(
+           Subscript(Name("s"), Name("i")),
+           CmpOp("==",
+             Subscript(Name("s"), BinOp("+", Name("i"), Int(1))))),
+         Return(Bool(false)),
+         .Stmts)
+       If(
+         Compare(
+           Subscript(Name("s"), Name("i")),
+           CmpOp("==",
+             Subscript(Name("s"), BinOp("+", Name("i"), Int(2))))),
+         Return(Bool(false)),
+         .Stmts)
+       If(
+         Compare(
+           Subscript(Name("s"), BinOp("+", Name("i"), Int(1))),
+           CmpOp("==",
+             Subscript(Name("s"), BinOp("+", Name("i"), Int(2))))),
+         Return(Bool(false)),
+         .Stmts)
+       Return(
+         Call(
+           Name("_happy_from"),
+           (Name("s"), BinOp("+", Name("i"), Int(1)))))
+       .Stmts
+
+  syntax Val ::= "happyFromClosure" [function, total]
+  rule happyFromClosure
+    => closureVal(("s", "i"), happyFromBody, 0)
+
+  syntax Stmts ::= "isHappyBody" [function, total]
+  rule isHappyBody
+    => If(
+         Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
+         Return(Bool(false)),
+         .Stmts)
+       Return(Call(Name("_happy_from"), (Name("s"), Int(0))))
+       .Stmts
+
+  syntax Val ::= "isHappyClosure" [function, total]
+  rule isHappyClosure
+    => closureVal("s", isHappyBody, 0)
+
+  syntax Scope ::= "solutionScope" [function, total]
+  rule solutionScope
+    => scope(
+         .Map
+           [ "_happy_from" <- happyFromClosure ]
+           [ "is_happy" <- isHappyClosure ],
+         parent(-1))
+
+  // A totalized view of in-bounds string indexing. The reference semantics'
+  // intSeqAt is intentionally partial on an opaque symbolic sequence, even
+  // when the path condition proves the index is in bounds. These equations
+  // preserve its concrete constructor behavior and give the prover one shared
+  // symbolic term for each valid character access.
+  syntax Int ::= safeAt(IntSeq, Int) [function, total]
+  rule safeAt(iCons(C:Int, _:IntSeq), 0) => C
+  rule safeAt(iCons(_:Int, R:IntSeq), I:Int) => safeAt(R, I -Int 1)
+    requires I >Int 0
+
+  rule intSeqAt(IS:IntSeq, I:Int) => safeAt(IS, I)
+    requires I >=Int 0 andBool I <Int isLen(IS)
+    [priority(60)]
+
+  // Mathematical contract. happyFrom(IS, I) says that every window beginning
+  // at I or later has three pairwise-distinct character codes.
+  syntax Bool ::= happyFrom(IntSeq, Int) [function, total]
+
+  rule happyFrom(IS:IntSeq, I:Int) => true
+    requires I >=Int 0
+     andBool I +Int 2 >=Int isLen(IS)
+
+  rule happyFrom(IS:IntSeq, I:Int) => false
+    requires I >=Int 0
+     andBool I +Int 2 <Int isLen(IS)
+     andBool safeAt(IS, I) ==Int safeAt(IS, I +Int 1)
+
+  rule happyFrom(IS:IntSeq, I:Int) => false
+    requires I >=Int 0
+     andBool I +Int 2 <Int isLen(IS)
+     andBool safeAt(IS, I) =/=Int safeAt(IS, I +Int 1)
+     andBool safeAt(IS, I) ==Int safeAt(IS, I +Int 2)
+
+  rule happyFrom(IS:IntSeq, I:Int) => false
+    requires I >=Int 0
+     andBool I +Int 2 <Int isLen(IS)
+     andBool safeAt(IS, I) =/=Int safeAt(IS, I +Int 1)
+     andBool safeAt(IS, I) =/=Int safeAt(IS, I +Int 2)
+     andBool safeAt(IS, I +Int 1) ==Int safeAt(IS, I +Int 2)
+
+  rule happyFrom(IS:IntSeq, I:Int) => happyFrom(IS, I +Int 1)
+    requires I >=Int 0
+     andBool I +Int 2 <Int isLen(IS)
+     andBool safeAt(IS, I) =/=Int safeAt(IS, I +Int 1)
+     andBool safeAt(IS, I) =/=Int safeAt(IS, I +Int 2)
+     andBool safeAt(IS, I +Int 1) =/=Int safeAt(IS, I +Int 2)
+
+  syntax Bool ::= isHappySpec(IntSeq) [function, total]
+  rule isHappySpec(IS:IntSeq) => false
+    requires isLen(IS) <Int 3
+  rule isHappySpec(IS:IntSeq) => happyFrom(IS, 0)
+    requires isLen(IS) >=Int 3
+endmodule

diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..383ba02f9663b4144cc6c24f573a66b914eb41bd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,16 @@
+def _happy_from(s, i):
+    if i + 2 >= len(s):
+        return True
+    if s[i] == s[i + 1]:
+        return False
+    if s[i] == s[i + 2]:
+        return False
+    if s[i + 1] == s[i + 2]:
+        return False
+    return _happy_from(s, i + 1)
+
+
+def is_happy(s):
+    if len(s) < 3:
+        return False
+    return _happy_from(s, 0)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..f727713b5268fc8044aa13683e8920444f6e23f1
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,51 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [happy-from-body-correct]:
+    <k> happyFromBody ~> #endcall => #pop </k>
+    <env> L:Int </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (L |-> scope(
+        .Map [ "s" <- str(IS:IntSeq) ] [ "i" <- I:Int ],
+        parent(0)))
+      REST:Map
+    </scopes>
+    <scopeLoc> SL:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> noRet => retV(happyFrom(IS, I)) </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+     andBool L =/=Int 0
+     andBool L =/=Int -1
+     andBool notBool 0 in_keys(REST)
+     andBool notBool -1 in_keys(REST)
+     andBool notBool L in_keys(REST)
+
+  claim [is-happy-correct]:
+    <k>
+      #applyK(
+        toCall(isHappyClosure),
+        (str(IS:IntSeq), .Vals))
+      ~> CONT:K
+    =>
+      isHappySpec(IS) ~> CONT
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> solutionScope) (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
