+    <k>
+      #while(happyLoopCondition, happyLoopBody)
+      ~> Return(Bool(true))
+      ~> #endcall
+    =>
+      #pop
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |-> scope(
+        ("s" |-> str(IS:IntSeq)) ("i" |-> I:Int),
+        parent(0))
+      ...
+    </scopes>
+    <ret> noRet => retV(happyFrom(IS, I)) </ret>
+    requires I >=Int 0
+    [priority(40)]
+endmodule

