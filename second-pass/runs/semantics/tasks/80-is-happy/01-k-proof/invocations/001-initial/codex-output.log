+
+module SPEC
+  imports VERIFICATION
+
+  claim [happy-from-body-correct]:
+    <k> happyFromBody ~> #endcall => #pop </k>
+    <env> L:Int </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (L |-> scope(
+        .Map [ "s" <- str(IS:IntSeq) ] [ "i" <- I:Int ],
+        parent(0)))
+      REST:Map
+    </scopes>
+    <scopeLoc> SL:Int </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack> ST:List </stack>
+    <ret> noRet => retV(happyFrom(IS, I)) </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+     andBool L =/=Int 0
+     andBool L =/=Int -1
+     andBool notBool 0 in_keys(REST)
+     andBool notBool -1 in_keys(REST)
+     andBool notBool L in_keys(REST)
+
+  claim [is-happy-correct]:
+    <k>
+      #applyK(
+        toCall(isHappyClosure),
+        (str(IS:IntSeq), .Vals))
+      ~> CONT:K
+    =>
+      isHappySpec(IS) ~> CONT
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> solutionScope) (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..7fe26621291c06ca90417e70a866fd8bac16aa46
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,96 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The two closures below are the constructor-level translation in
+  // solution.mpy, represented as values after module loading.
+  syntax Stmts ::= "happyFromBody" [function, total]
+  rule happyFromBody
+    => If(
+         Compare(
+           BinOp("+", Name("i"), Int(2)),
+           CmpOp(">=", Call(Name("len"), Name("s")))),
+         Return(Bool(true)),
+         .Stmts)
+       If(
+         Compare(
+           Subscript(Name("s"), Name("i")),
+           CmpOp("==",
+             Subscript(Name("s"), BinOp("+", Name("i"), Int(1))))),
+         Return(Bool(false)),
+         .Stmts)
+       If(
+         Compare(
+           Subscript(Name("s"), Name("i")),
+           CmpOp("==",
+             Subscript(Name("s"), BinOp("+", Name("i"), Int(2))))),
+         Return(Bool(false)),
+         .Stmts)
+       If(
+         Compare(
+           Subscript(Name("s"), BinOp("+", Name("i"), Int(1))),
+           CmpOp("==",
+             Subscript(Name("s"), BinOp("+", Name("i"), Int(2))))),
+         Return(Bool(false)),
+         .Stmts)
+       Return(
+         Call(
+           Name("_happy_from"),
+           (Name("s"), BinOp("+", Name("i"), Int(1)))))
+       .Stmts
+
+  syntax Val ::= "happyFromClosure" [function, total]
+  rule happyFromClosure
+    => closureVal(("s", "i"), happyFromBody, 0)
+
+  syntax Stmts ::= "isHappyBody" [function, total]
+  rule isHappyBody
+    => If(
+         Compare(Call(Name("len"), Name("s")), CmpOp("<", Int(3))),
+         Return(Bool(false)),
+         .Stmts)
+       Return(Call(Name("_happy_from"), (Name("s"), Int(0))))
+       .Stmts
+
+  syntax Val ::= "isHappyClosure" [function, total]
+  rule isHappyClosure
+    => closureVal("s", isHappyBody, 0)
+
+  syntax Scope ::= "solutionScope" [function, total]
+  rule solutionScope
+    => scope(
+         .Map
+           [ "_happy_from" <- happyFromClosure ]
+           [ "is_happy" <- isHappyClosure ],
+         parent(-1))
+
+  // Mathematical contract. happyFrom(IS, I) says that every window beginning
+  // at I or later has three pairwise-distinct character codes.
+  syntax Bool ::= happyFrom(IntSeq, Int) [function, total]
+
+  rule happyFrom(IS:IntSeq, I:Int)
+    => #if I +Int 2 >=Int isLen(IS)
+       #then true
+       #else
+         #if intSeqAt(IS, I) ==Int intSeqAt(IS, I +Int 1)
+         #then false
+         #else
+           #if intSeqAt(IS, I) ==Int intSeqAt(IS, I +Int 2)
+           #then false
+           #else
+             #if intSeqAt(IS, I +Int 1) ==Int intSeqAt(IS, I +Int 2)
+             #then false
+             #else happyFrom(IS, I +Int 1)
+             #fi
+           #fi
+         #fi
+       #fi
+
+  syntax Bool ::= isHappySpec(IntSeq) [function, total]
+  rule isHappySpec(IS:IntSeq)
+    => #if isLen(IS) <Int 3
+       #then false
+       #else happyFrom(IS, 0)
+       #fi
+endmodule

