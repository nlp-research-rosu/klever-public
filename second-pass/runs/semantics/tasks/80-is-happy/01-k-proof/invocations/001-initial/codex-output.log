new file mode 100644
index 0000000000000000000000000000000000000000..383ba02f9663b4144cc6c24f573a66b914eb41bd
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,16 @@
+def _happy_from(s, i):
+    if i + 2 >= len(s):
+        return True
+    if s[i] == s[i + 1]:
+        return False
+    if s[i] == s[i + 2]:
+        return False
+    if s[i + 1] == s[i + 2]:
+        return False
+    return _happy_from(s, i + 1)
+
+
+def is_happy(s):
+    if len(s) < 3:
+        return False
+    return _happy_from(s, 0)
