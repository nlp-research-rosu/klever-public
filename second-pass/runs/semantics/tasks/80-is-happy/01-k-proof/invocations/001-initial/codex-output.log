+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [happy-from-body-correct]:
+    <k> happyFromBody ~> #endcall => happyFrom(IS, I) ~> CONT </k>
+    <env> L:Int => E:Int </env>
+    <scopes>
+      (0 |-> solutionScope)
+      (-1 |-> builtinsScope)
+      (L |-> scope(
+        .Map [ "s" <- str(IS:IntSeq) ] [ "i" <- I:Int ],
+        parent(0)))
+      REST:Map
+    =>
+      (0 |-> solutionScope) (-1 |-> builtinsScope) REST
+    </scopes>
+    <scopeLoc> L +Int 1 => L </scopeLoc>
+    <heap> H:Map </heap>
+    <heapLoc> HL:Int </heapLoc>
+    <stack>
+      ListItem(frame(CONT:K, E, L)) ST:List
+    =>
+      ST
+    </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires I >=Int 0
+     andBool L =/=Int 0
+     andBool L =/=Int -1
+     andBool notBool 0 in_keys(REST)
+     andBool notBool -1 in_keys(REST)
+     andBool notBool L in_keys(REST)
+
+  claim [is-happy-correct]:
+    <k>
+      #applyK(
+        toCall(isHappyClosure),
+        (str(IS:IntSeq), .Vals))
+      ~> CONT:K
+    =>
+      isHappySpec(IS) ~> CONT
+    </k>
+    <env> 0 </env>
+    <scopes>
+      (0 |-> solutionScope) (-1 |-> builtinsScope)
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
