codex
I’m using the standard longest-palindromic-suffix algorithm from the prompt: scan suffixes left to right, then append the reversed prefix at the first palindrome. This keeps the code inside the translator’s subset and gives a clean loop invariant for symbolic proof.
apply patch
patch: completed
/work/solution.py
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..10fc3ac7abdd659c7e2b1cc24c6f2e09c62b7918
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,11 @@
+def is_palindrome(string: str) -> bool:
+    """Test if given string is a palindrome."""
+    return string == string[::-1]
+
+
+def make_palindrome(string: str) -> str:
+    """Return the shortest palindrome that starts with string."""
+    for i in range(len(string)):
+        if is_palindrome(string[i:]):
+            return string + string[:i][::-1]
+    return string

