Module(
  FuncDef("is_palindrome", Params("string"),
    Return(
      Compare(
        Name("string"),
        CmpOp(
          "==",
          Subscript(
            Name("string"),
            Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
  FuncDef("make_palindrome", Params("string"),
    Assign(Name("i"), Int(0))
    For(Name("i"), Call(Name("range"), Call(Name("len"), Name("string"))),
      If(Call(
        Name("is_palindrome"),
        Subscript(Name("string"), Slice(Name("i"), NoBound, NoBound))),
        Return(
          BinOp(
            "+",
            Name("string"),
            Subscript(
              Subscript(
                Name("string"),
                Slice(NoBound, Name("i"), NoBound)),
              Slice(NoBound, NoBound, UnaryOp("-", Int(1)))))),
        ))
    Return(Name("string"))))
