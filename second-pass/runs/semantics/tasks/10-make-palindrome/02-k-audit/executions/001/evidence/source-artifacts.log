     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // Mathematical sequence operations used by the specification.
     7	  // MPY-METHODS already supplies revIS and dropIS; only prefix extraction is
     8	  // new here.
     9	  syntax IntSeq ::= prefixIS(IntSeq, Int) [function]
    10	
    11	  rule prefixIS(_:IntSeq, N:Int) => .IntSeq requires N <=Int 0
    12	  rule prefixIS(iCons(C:Int, R:IntSeq), N:Int)
    13	    => iCons(C, prefixIS(R, N -Int 1))
    14	    requires N >Int 0
    15	
    16	  syntax Bool ::= palindromeIS(IntSeq) [function]
    17	  rule palindromeIS(S:IntSeq) => S ==K revIS(S)
    18	
    19	  // Exact translated closure for the requested entry point.  Pinning this in
    20	  // the proof state makes the loop claim specific to solution.mpy.
    21	  syntax Val ::= "makePalindromeClosure" [function]
    22	  rule makePalindromeClosure
    23	    => closureVal(
    24	      ("string", .ParamNames),
    25	      Assign(Name("i"), Int(0))
    26	      For(Name("i"), Call(Name("range"), Call(Name("len"), Name("string"))),
    27	        If(Call(Name("is_palindrome"),
    28	                Subscript(Name("string"), Slice(Name("i"), NoBound, NoBound))),
    29	           Return(BinOp("+", Name("string"),
    30	             Subscript(Subscript(Name("string"),
    31	                                 Slice(NoBound, Name("i"), NoBound)),
    32	                       Slice(NoBound, NoBound, UnaryOp("-", Int(1)))))),
    33	           .Stmts))
    34	      Return(Name("string")) .Stmts,
    35	      0)
    36	
    37	  // The exact result of scanning suffixes beginning at index I.  The first
    38	  // palindromic suffix corresponds to the longest one, hence the shortest
    39	  // prefix that must be mirrored at the end.
    40	  syntax IntSeq ::= palindromeFrom(IntSeq, Int) [function]
    41	  rule palindromeFrom(S:IntSeq, I:Int)
    42	    => seqConcat(S, revIS(prefixIS(S, I)))
    43	    requires I <Int isLen(S) andBool palindromeIS(dropIS(S, I))
    44	  rule palindromeFrom(S:IntSeq, I:Int)
    45	    => palindromeFrom(S, I +Int 1)
    46	    requires I <Int isLen(S) andBool notBool palindromeIS(dropIS(S, I))
    47	  rule palindromeFrom(S:IntSeq, I:Int) => S
    48	    requires I >=Int isLen(S)
    49	
    50	  // Sound summaries of the three slice shapes used by solution.py.  They
    51	  // avoid expanding CPython's index arithmetic during symbolic execution;
    52	  // prefixIS/dropIS/revIS give their recursive meanings.
    53	  rule <k> noB ~> #slStep(str(S:IntSeq), someB(I:Int), noB)
    54	        => str(dropIS(S, I)) ... </k>
    55	    requires 0 <=Int I andBool I <=Int isLen(S)
    56	    [priority(40)]
    57	
    58	  rule <k> noB ~> #slStep(str(S:IntSeq), noB, someB(I:Int))
    59	        => str(prefixIS(S, I)) ... </k>
    60	    requires 0 <=Int I andBool I <=Int isLen(S)
    61	    [priority(40)]
    62	
    63	  rule <k> someB(-1) ~> #slStep(str(S:IntSeq), noB, noB)
    64	        => str(revIS(S)) ... </k>
    65	    [priority(40)]
    66	
    67	  // Verified helper summary: this exact closure is the translation of
    68	  // is_palindrome in solution.py.  Its body compares the argument with the
    69	  // full reverse summarized immediately above.
    70	  rule <k>
    71	    #applyK(toCall(closureVal(
    72	      ("string", .ParamNames),
    73	      Return(Compare(Name("string"),
    74	        CmpOp("==", Subscript(Name("string"),
    75	          Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))) .Stmts,
    76	      0)),
    77	      (str(S:IntSeq), .Vals))
    78	    => palindromeIS(S) ...
    79	  </k> [priority(40)]
    80	
    81	  // The function-frame pop writes `undef` at the symbolic frame key.  The
    82	  // builtin map hook does not normalize that deletion for a symbolic key, so
    83	  // expose the corresponding finite-map identity to the prover.
    84	  rule (((L:Int |-> _:Scope) REST:Map) [ L <- undef ]) => REST
    85	    requires notBool (L in_keys(REST))
    86	endmodule

