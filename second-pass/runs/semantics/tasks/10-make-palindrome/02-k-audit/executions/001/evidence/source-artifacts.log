FILE: /candidate/concrete-tests.py
     1	def is_palindrome(string: str) -> bool:
     2	    return string == string[::-1]
     3	
     4	
     5	def make_palindrome(string: str) -> str:
     6	    i = 0
     7	    for i in range(len(string)):
     8	        if is_palindrome(string[i:]):
     9	            return string + string[:i][::-1]
    10	    return string
    11	
    12	
    13	assert make_palindrome("") == ""
    14	assert make_palindrome("cat") == "catac"
    15	assert make_palindrome("cata") == "catac"
    16	assert make_palindrome("race") == "racecar"
    17	assert make_palindrome("aaaa") == "aaaa"
    18	assert make_palindrome("abac") == "abacaba"

