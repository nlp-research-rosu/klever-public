+0
+
+BOUNDED RELEVANT OUTPUT
+The compiler emitted non-exhaustive-match warnings for mapStrVS, floorFI, toF,
+ceilF, joinCodes, and valSeqAt, plus unused-variable warnings in strLt. It
+completed successfully and produced runtime-kompiled. These warnings are
+reviewed in the static semantics inventory; none of the non-exhaustive
+functions is used by solution.mpy.
+
+COMMAND 2
+python3 reference/py2mpy.py concrete-tests.py > concrete-tests.regenerated.mpy
+cmp -s concrete-tests.regenerated.mpy concrete-tests.mpy
+krun concrete-tests.regenerated.mpy --definition runtime-kompiled --output pretty
+
+EXIT STATUSES
+translator: 0
+cmp: 0
+krun: 0
+
+BOUNDED RELEVANT OUTPUT
+concrete_translation_exit=0
+concrete_cmp_exit=0
+<generatedTop>
+  <k>
+    .K
+  </k>
+  ...
+  <heap>
+    .Map
+  </heap>
+  <stack>
+    .List
+  </stack>
+  <ret>
+    noRet
+  </ret>
+  <exc>
+    NoExc
+  </exc>
+  <exit-code>
+    0
+  </exit-code>
+</generatedTop>
+krun_exit=0
+
+COMMAND 3
+kompile verification.k --backend haskell --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX --output-definition verification-kompiled
+
+EXIT STATUS
+0
+
+BOUNDED RELEVANT OUTPUT
+Only four unused-variable warnings from the supplied strLt rules were emitted.
+The compiler completed and produced verification-kompiled.
+
+COMMAND 4
+kprove spec.k --definition verification-kompiled --spec-module SPEC
+
+EXIT STATUS
+0
+
+BOUNDED RELEVANT OUTPUT
+#Top
+[Warnings: the four supplied strLt unused variables and unused framed
+HH/NN/H/N variables in spec.k.]
+
+PER-CLAIM EXTRACTION
+The submitted claims have no labels. spec-helper-only.k and spec-loop-only.k
+in the scratch directory reproduce the respective claims unchanged under
+distinct modules.
+
+COMMAND 5
+kprove spec-helper-only.k --definition verification-kompiled \
+  --spec-module SPEC-HELPER-ONLY
+
+EXIT STATUS
+0
+
+BOUNDED RELEVANT OUTPUT
+#Top
+helper_kprove_exit=0
+
+COMMAND 6
+kprove spec-loop-only.k --definition verification-kompiled \
+  --spec-module SPEC-LOOP-ONLY
+
+EXIT STATUS
