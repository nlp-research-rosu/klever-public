diff --git a//tmp/audit-work/connections/audit-connection.k b//tmp/audit-work/connections/audit-connection.k
new file mode 100644
index 0000000000000000000000000000000000000000..87e91a9dc9736ba19969df29dc2808cbe6b965f9
--- /dev/null
+++ b//tmp/audit-work/connections/audit-connection.k
@@ -0,0 +1,14 @@
+requires "reference-semantics/semantics.k"
+
+module AUDIT-CONNECTION
+  imports MPY
+
+  // Independent copy of the candidate's mathematically standard prefix
+  // definition. No candidate operational bridge is imported.
+  syntax IntSeq ::= auditPrefixIS(IntSeq, Int) [function]
+  rule auditPrefixIS(_:IntSeq, N:Int) => .IntSeq requires N <=Int 0
+  rule auditPrefixIS(iCons(C:Int, R:IntSeq), N:Int)
+    => iCons(C, auditPrefixIS(R, N -Int 1))
+    requires N >Int 0
+
+endmodule
diff --git a//tmp/audit-work/connections/spec-slice-connections.k b//tmp/audit-work/connections/spec-slice-connections.k
new file mode 100644
index 0000000000000000000000000000000000000000..7face93686ae08ad4811e0ea17ba977733a6288f
--- /dev/null
+++ b//tmp/audit-work/connections/spec-slice-connections.k
@@ -0,0 +1,29 @@
+requires "audit-connection.k"
+
+module SPEC-SLICE-CONNECTIONS
+  imports AUDIT-CONNECTION
+
+  claim
+    <k>
+      noB ~> #slStep(str(S:IntSeq), someB(I:Int), noB) ~> CONT:K
+      =>
+      str(dropIS(S, I)) ~> CONT
+    </k>
+    requires 0 <=Int I andBool I <=Int isLen(S)
+
+  claim
+    <k>
+      noB ~> #slStep(str(S:IntSeq), noB, someB(I:Int)) ~> CONT:K
+      =>
+      str(auditPrefixIS(S, I)) ~> CONT
+    </k>
+    requires 0 <=Int I andBool I <=Int isLen(S)
+
+  claim
+    <k>
+      someB(-1) ~> #slStep(str(S:IntSeq), noB, noB) ~> CONT:K
+      =>
+      str(revIS(S)) ~> CONT
+    </k>
+
+endmodule
