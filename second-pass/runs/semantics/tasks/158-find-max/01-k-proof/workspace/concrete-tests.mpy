Module(
  FuncDef("find_max", Params("words"),
    Assign(Name("best"), Str(""))
    Assign(Name("max_unique"), Int(0))
    Assign(Name("word"), Str(""))
    Assign(Name("unique"), Int(0))
    For(Name("word"), Name("words"),
      Assign(
        Name("unique"),
        Call(Name("len"), Call(Name("set"), Name("word"))))
      If(Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
        Assign(Name("best"), Name("word"))
        Assign(Name("max_unique"), Name("unique")),
        If(Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
          If(Compare(Name("word"), CmpOp("<", Name("best"))),
            Assign(Name("best"), Name("word")),
            ),
          )))
    Return(Name("best")))
  Assert(
    Compare(
      Call(
        Name("find_max"),
        ListExpr(Str("name"), Str("of"), Str("string"))),
      CmpOp("==", Str("string"))))
  Assert(
    Compare(
      Call(
        Name("find_max"),
        ListExpr(Str("name"), Str("enam"), Str("game"))),
      CmpOp("==", Str("enam"))))
  Assert(
    Compare(
      Call(
        Name("find_max"),
        ListExpr(Str("aaaaaaa"), Str("bb"), Str("cc"))),
      CmpOp("==", Str("aaaaaaa"))))
  Assert(
    Compare(Call(Name("find_max"), ListExpr()), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("find_max"), ListExpr(Str("xy"), Str("yx"), Str("z"))),
      CmpOp("==", Str("xy")))))
