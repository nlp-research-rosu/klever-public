+    </k>
+    <env> 0 </env>
+    <scopes>
+         0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope
+      =>
+         0 |-> scope(
+                "find_max" |->
+                  closureVal(
+                    ("words", .ParamNames),
+                    findMaxFunctionBody,
+                    0),
+                parent(-1))
+        -1 |-> builtinsScope
