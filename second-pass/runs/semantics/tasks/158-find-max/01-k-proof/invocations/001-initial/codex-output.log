+def find_max(words):
+    best = ""
+    max_unique = 0
+    word = ""
+    unique = 0
+    for word in words:
+        unique = len(set(word))
+        if unique > max_unique:
+            best = word
+            max_unique = unique
+        elif unique == max_unique:
+            if word < best:
+                best = word
+    return best
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..52dd4215a0ec9f7f7f6b43e3b6ec5ef11c5b2b8e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,78 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  claim [find-max-loop-invariant]:
+    <k> #loop(list(wordVals(WORDS:WordSeq)),
+              Name("word"),
+              findMaxLoopBody)
+         ~> KONT:K
+      => KONT
+    </k>
+    <env> 1 </env>
+    <scopes>
+          1 |-> scope(
+            ("words" |-> list(wordVals(ALL_WORDS:WordSeq)))
+            ("best" |-> str(BEST:IntSeq))
+            ("max_unique" |-> SCORE:Int)
+            ("word" |-> str(PREVIOUS_WORD:IntSeq))
+            ("unique" |-> PREVIOUS_SCORE:Int),
+            parent(0))
+          0 |-> scope(
+            "find_max" |->
+              closureVal(
+                ("words", .ParamNames),
+                findMaxFunctionBody,
+                0),
+            parent(-1))
+         -1 |-> builtinsScope
+      =>
+          1 |-> scope(
+            ("words" |-> list(wordVals(ALL_WORDS)))
+            ("best" |-> str(bestWord(
+              findMaxWords(WORDS, BEST, SCORE))))
+            ("max_unique" |-> bestScore(
+              findMaxWords(WORDS, BEST, SCORE)))
+            ("word" |-> str(?FINAL_WORD:IntSeq))
+            ("unique" |-> ?FINAL_SCORE:Int),
+            parent(0))
+          0 |-> scope(
+            "find_max" |->
+              closureVal(
+                ("words", .ParamNames),
+                findMaxFunctionBody,
+                0),
+            parent(-1))
+         -1 |-> builtinsScope
+    </scopes>
+
+  claim [find-max-contract]:
+    <k> #loadAll(Module(
+         FuncDef("find_max", Params("words"), findMaxFunctionBody)))
+         ~> Call(Name("find_max"), list(wordVals(WORDS:WordSeq)))
+      => str(bestWord(findMaxWords(
+           WORDS, .IntSeq, 0)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+         0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope
+      =>
+         0 |-> scope(
+                "find_max" |->
+                  closureVal(
+                    ("words", .ParamNames),
+                    findMaxFunctionBody,
+                    0),
+                parent(-1))
+        -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
