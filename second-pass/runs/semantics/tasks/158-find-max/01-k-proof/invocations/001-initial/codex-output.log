+            ("word" |-> str(?FINAL_WORD:IntSeq))
+            ("unique" |-> ?FINAL_SCORE:Int),
+            parent(0))
+          0 |-> scope(
+            "find_max" |->
+              closureVal(
+                ("words", .ParamNames),
+                findMaxFunctionBody,
+                0),
+            parent(-1))
