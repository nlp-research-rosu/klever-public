exec
/bin/bash -lc "python3 - <<'PY'
import random
import string
from solution import find_max
rng = random.Random(158)
for _ in range(10000):
    n = rng.randrange(0, 12)
    words = list(dict.fromkeys(
        ''.join(rng.choice(string.ascii_lowercase[:8]) for _ in range(rng.randrange(0, 12)))
        for _ in range(n * 2 + 1)
    ))[:n]
    expected = '' if not words else min(words, key=lambda word: (-len(set(word)), word))
    actual = find_max(words)
    assert actual == expected, (words, actual, expected)
print('10000 differential cases passed')
PY" in /work
