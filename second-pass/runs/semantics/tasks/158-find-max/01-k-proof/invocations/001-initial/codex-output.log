+            ("best" |-> str(BEST:IntSeq))
+            ("max_unique" |-> SCORE:Int)
+            REST:Map,
+            PARENT:Parent)
+       => L |-> scope(
+            ("best" |-> str(bestWord(
+              findMaxAcc(wordVals(WORDS), BEST, SCORE))))
+            ("max_unique" |-> bestScore(
+              findMaxAcc(wordVals(WORDS), BEST, SCORE)))
+            ?FINAL:Map,
+            PARENT)
+      ...
