+            in {"DEFINITION", "DOMAIN_LEMMA"}
+            for row in rows
+            if "simplification" in row["attributes"]
+        ),
+        "true_domain_rule_ids": [
+            row["source_rule_id"]
+            for row in rows
+            if row["independent_classification"] == "DOMAIN_LEMMA"
+        ],
+    }
+    print(json.dumps({"summary": summary, "rules": rows}, indent=2))
