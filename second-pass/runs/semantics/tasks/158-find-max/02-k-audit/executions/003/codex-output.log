+            print(f"\nLINE {number} FUNCTION {payload.get('name')}")
+            print(clipped(payload.get("arguments", "")))
+        elif kind == "custom_tool_call":
+            print(f"\nLINE {number} CUSTOM_TOOL {payload.get('name')}")
+            print(clipped(payload.get("input", "")))
