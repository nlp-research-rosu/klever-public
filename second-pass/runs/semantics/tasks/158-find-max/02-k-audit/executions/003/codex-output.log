+                    "words": words,
+                    "canonical": left,
+                    "generated": right,
+                    "fixed_case": index < len(fixed_cases),
+                }
+            )
+
+    intended_mismatches = [
+        mismatch for mismatch in mismatches if mismatch["words"] != []
+    ]
