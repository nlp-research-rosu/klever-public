+        ["a", "ab"],
+        ["ba", "ab"],
+        ["ab", "ba"],
+        ["abc", "aa"],
+        ["aa", "abc", "cba", "z"],
+        # Repeated-character and Unicode/code-point probes.
+        ["aaaa", "bbb", "cc"],
+        ["é", "e\u0301", "zz"],
+        ["😀a", "😀😀", "ab"],
+        ["Ωβ", "βα", "aa"],
+    ]
+    alphabet = "abcde"
