+
+    mismatches: list[dict[str, object]] = []
+    for index, words in enumerate(fixed_cases + generated_cases):
+        left = outcome(canonical, words)
+        right = outcome(generated, words)
+        if left != right:
+            mismatches.append(
+                {
+                    "index": index,
+                    "words": words,
+                    "canonical": left,
+                    "generated": right,
+                    "fixed_case": index < len(fixed_cases),
+                }
+            )
+
+    intended_mismatches = [
