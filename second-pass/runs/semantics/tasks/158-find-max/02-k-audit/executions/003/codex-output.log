} 2>&1 | tee /audit-output/evidence/kprove-contract.log
status="'${PIPESTATUS[0]}
printf '"'EXIT_STATUS: %s\\n' \""'$status" | tee -a /audit-output/evidence/kprove-contract.log
exit "$status"' in /tmp/audit-work/repro
