+        ["aaaaaaa", "bb", "cc"],
+        # Empty/boundary cases.
+        [],
+        [""],
+        ["", "a"],
+        ["a"],
+        ["a", "b"],
+        # Every loop branch: greater, equal+tiebreak true/false, and smaller.
