    82	// The krun (llvm) main module: MPY plus the concrete-only legs (keyed sort's
    83	// real key calls, deep list equality). Verification builds import MPY and
    84	// never see MPY-CONCRETE. The llvm kompile MUST use --main-module MPY-KRUN —
    85	// with plain MPY the concrete legs are silently absent (this was live for a
    86	// while: sorted-key stuck and comprehension asserted wrong under krun).
    87	module MPY-KRUN
    88	  imports MPY
    89	  imports MPY-CONCRETE
    90	endmodule
     1	requires "reference-semantics/semantics.k"
     2	
     3	module VERIFICATION
     4	  imports MPY
     5	
     6	  // A typed logical view of the admissible input: every element is a string.
     7	  syntax WordSeq ::= ".WordSeq" | wCons(IntSeq, WordSeq)
     8	  syntax ValSeq ::= wordVals(WordSeq)
     9	  rule wordVals(.WordSeq) => .ValSeq
    10	  rule wordVals(wCons(WORD:IntSeq, REST:WordSeq))
    11	    => vCons(str(WORD), wordVals(REST))
    12	
    13	  // Constructor-preserving iterator lemmas keep the string element sort visible
    14	  // to symbolic execution.  They are immediate compositions of wordVals with
    15	  // MPY-LIST's two #iterNext equations.
    16	  rule <k> #iterNext(list(wordVals(.WordSeq))) => #iterDone ... </k>
    17	    [priority(40)]
    18	  rule <k> #iterNext(list(wordVals(wCons(WORD:IntSeq, REST:WordSeq))))
    19	        => #iterYield(str(WORD), list(wordVals(REST))) ... </k>
    20	    [priority(40)]
    21	
    22	  // Exact translated body of solution.py, named only to keep the claims small.
    23	  syntax Stmts ::= "findMaxLoopBody" [function]
    24	  rule findMaxLoopBody
    25	    => Assign(
    26	         Name("unique"),
    27	         Call(Name("len"), Call(Name("set"), Name("word"))))
    28	       If(Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
    29	         Assign(Name("best"), Name("word"))
    30	         Assign(Name("max_unique"), Name("unique")),
    31	         If(Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
    32	           If(Compare(Name("word"), CmpOp("<", Name("best"))),
    33	             Assign(Name("best"), Name("word")),
    34	             .Stmts),
    35	           .Stmts))
    36	
    37	  syntax Stmts ::= "findMaxFunctionBody" [function]
    38	  rule findMaxFunctionBody
    39	    => Assign(Name("best"), Str(""))
    40	       Assign(Name("max_unique"), Int(0))
    41	       Assign(Name("word"), Str(""))
    42	       Assign(Name("unique"), Int(0))
    43	       For(Name("word"), Name("words"), findMaxLoopBody)
    44	       Return(Name("best"))
    45	
    46	  // A mathematical accumulator for the contract.  The IntSeq is the selected
    47	  // word and the Int is its number of distinct characters.
    48	  syntax BestState ::= bestState(IntSeq, Int)
    49	                     | findMaxWords(WordSeq, IntSeq, Int) [function, total]
    50	
    51	  rule findMaxWords(.WordSeq, BEST:IntSeq, SCORE:Int)
    52	    => bestState(BEST, SCORE)
    53	
    54	  rule findMaxWords(
    55	         wCons(WORD:IntSeq, REST:WordSeq),
    56	         _BEST:IntSeq,
    57	         SCORE:Int)
    58	    => findMaxWords(REST, WORD, isLen(dedupCodes(WORD)))
    59	    requires isLen(dedupCodes(WORD)) >Int SCORE
    60	
    61	  rule findMaxWords(
    62	         wCons(WORD:IntSeq, REST:WordSeq),
    63	         BEST:IntSeq,
    64	         SCORE:Int)
    65	    => findMaxWords(REST, WORD, SCORE)
    66	    requires isLen(dedupCodes(WORD)) ==Int SCORE
    67	     andBool strLt(WORD, BEST)
    68	
    69	  rule findMaxWords(
    70	         wCons(WORD:IntSeq, REST:WordSeq),
    71	         BEST:IntSeq,
    72	         SCORE:Int)
    73	    => findMaxWords(REST, BEST, SCORE)
    74	    requires isLen(dedupCodes(WORD)) <Int SCORE
    75	
    76	  rule findMaxWords(
    77	         wCons(WORD:IntSeq, REST:WordSeq),
    78	         BEST:IntSeq,
    79	         SCORE:Int)
    80	    => findMaxWords(REST, BEST, SCORE)
    81	    requires isLen(dedupCodes(WORD)) ==Int SCORE
    82	     andBool notBool strLt(WORD, BEST)
    83	
    84	  syntax IntSeq ::= bestWord(BestState) [function, total]
    85	  rule bestWord(bestState(WORD:IntSeq, _:Int)) => WORD
    86	
    87	  syntax Int ::= bestScore(BestState) [function, total]
    88	  rule bestScore(bestState(_:IntSeq, SCORE:Int)) => SCORE
    89	
    90	  // Projection lemmas let the simplifier expose one specification step under
    91	  // the path condition selected by the Python branch.
    92	  rule bestWord(findMaxWords(wCons(WORD:IntSeq, REST:WordSeq), _BEST:IntSeq, SCORE:Int))
    93	    => bestWord(findMaxWords(REST, WORD, isLen(dedupCodes(WORD))))
    94	    requires isLen(dedupCodes(WORD)) >Int SCORE
    95	    [simplification]
    96	  rule bestScore(findMaxWords(wCons(WORD:IntSeq, REST:WordSeq), _BEST:IntSeq, SCORE:Int))
    97	    => bestScore(findMaxWords(REST, WORD, isLen(dedupCodes(WORD))))
    98	    requires isLen(dedupCodes(WORD)) >Int SCORE
    99	    [simplification]
   100	
   101	  rule bestWord(findMaxWords(wCons(WORD:IntSeq, REST:WordSeq), BEST:IntSeq, SCORE:Int))
   102	    => bestWord(findMaxWords(REST, WORD, SCORE))
   103	    requires isLen(dedupCodes(WORD)) ==Int SCORE
   104	     andBool strLt(WORD, BEST)
   105	    [simplification]
   106	  rule bestScore(findMaxWords(wCons(WORD:IntSeq, REST:WordSeq), BEST:IntSeq, SCORE:Int))
   107	    => bestScore(findMaxWords(REST, WORD, SCORE))
   108	    requires isLen(dedupCodes(WORD)) ==Int SCORE
   109	     andBool strLt(WORD, BEST)
   110	    [simplification]
   111	
   112	  rule bestWord(findMaxWords(wCons(WORD:IntSeq, REST:WordSeq), BEST:IntSeq, SCORE:Int))
   113	    => bestWord(findMaxWords(REST, BEST, SCORE))
   114	    requires isLen(dedupCodes(WORD)) <Int SCORE
   115	    [simplification]
   116	  rule bestScore(findMaxWords(wCons(WORD:IntSeq, REST:WordSeq), BEST:IntSeq, SCORE:Int))
   117	    => bestScore(findMaxWords(REST, BEST, SCORE))
   118	    requires isLen(dedupCodes(WORD)) <Int SCORE
   119	    [simplification]
   120	
   121	  rule bestWord(findMaxWords(wCons(WORD:IntSeq, REST:WordSeq), BEST:IntSeq, SCORE:Int))
   122	    => bestWord(findMaxWords(REST, BEST, SCORE))
   123	    requires isLen(dedupCodes(WORD)) ==Int SCORE
   124	     andBool notBool strLt(WORD, BEST)
   125	    [simplification]
   126	  rule bestScore(findMaxWords(wCons(WORD:IntSeq, REST:WordSeq), BEST:IntSeq, SCORE:Int))
   127	    => bestScore(findMaxWords(REST, BEST, SCORE))
   128	    requires isLen(dedupCodes(WORD)) ==Int SCORE
   129	     andBool notBool strLt(WORD, BEST)
   130	    [simplification]
   131	endmodule
     1	requires "verification.k"
     2	
     3	module SPEC
     4	  imports VERIFICATION
     5	
     6	  claim [find-max-loop-invariant]:
     7	    <k> #loop(list(wordVals(WORDS:WordSeq)),
     8	              Name("word"),
     9	              findMaxLoopBody)
    10	         ~> KONT:K
    11	      => KONT
    12	    </k>
    13	    <env> 1 </env>
    14	    <scopes>
    15	          1 |-> scope(
    16	            ("words" |-> list(wordVals(ALL_WORDS:WordSeq)))
    17	            ("best" |-> str(BEST:IntSeq))
    18	            ("max_unique" |-> SCORE:Int)
    19	            ("word" |-> str(PREVIOUS_WORD:IntSeq))
    20	            ("unique" |-> PREVIOUS_SCORE:Int),
    21	            parent(0))
    22	          0 |-> scope(
    23	            "find_max" |->
    24	              closureVal(
    25	                ("words", .ParamNames),
    26	                findMaxFunctionBody,
    27	                0),
    28	            parent(-1))
    29	         -1 |-> builtinsScope
    30	      =>
    31	          1 |-> scope(
    32	            ("words" |-> list(wordVals(ALL_WORDS)))
    33	            ("best" |-> str(bestWord(
    34	              findMaxWords(WORDS, BEST, SCORE))))
    35	            ("max_unique" |-> bestScore(
    36	              findMaxWords(WORDS, BEST, SCORE)))
    37	            ("word" |-> str(?FINAL_WORD:IntSeq))
    38	            ("unique" |-> ?FINAL_SCORE:Int),
    39	            parent(0))
    40	          0 |-> scope(
    41	            "find_max" |->
    42	              closureVal(
    43	                ("words", .ParamNames),
    44	                findMaxFunctionBody,
    45	                0),
    46	            parent(-1))
    47	         -1 |-> builtinsScope
    48	    </scopes>
    49	
    50	  claim [find-max-contract]:
    51	    <k> #loadAll(Module(
    52	         FuncDef("find_max", Params("words"), findMaxFunctionBody)))
    53	         ~> Call(Name("find_max"), list(wordVals(WORDS:WordSeq)))
    54	      => str(bestWord(findMaxWords(
    55	           WORDS, .IntSeq, 0)))
    56	    </k>
    57	    <env> 0 </env>
    58	    <scopes>
    59	         0 |-> scope(.Map, parent(-1))
    60	        -1 |-> builtinsScope
    61	      =>
    62	         0 |-> scope(
    63	                "find_max" |->
    64	                  closureVal(
    65	                    ("words", .ParamNames),
    66	                    findMaxFunctionBody,
    67	                    0),
    68	                parent(-1))
    69	        -1 |-> builtinsScope
    70	    </scopes>
    71	    <scopeLoc> 1 </scopeLoc>
    72	    <heap> .Map </heap>
    73	    <heapLoc> 0 </heapLoc>
    74	    <stack> .List </stack>
    75	    <ret> noRet </ret>
    76	    <exc> NoExc </exc>
    77	    <exit-code> 0 </exit-code>
    78	endmodule

