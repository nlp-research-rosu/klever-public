+         ~> Call(Name("find_max"), list(wordVals(
+              wCons(iCons(98, iCons(97, .IntSeq)),
+              wCons(iCons(97, iCons(98, .IntSeq)), .WordSeq)))))
+      => str(iCons(97, iCons(98, .IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+         0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope
+      =>
+         0 |-> scope(
+                "find_max" |->
+                  closureVal(
+                    ("words", .ParamNames),
+                    findMaxFunctionBody,
+                    0),
+                parent(-1))
+        -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-pinning-claims.k b//tmp/audit-work/reconstruction/audit-pinning-claims.k
new file mode 100644
index 0000000000000000000000000000000000000000..998a1946b2570f52b5462c5bfbe333a6eb97693a
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-pinning-claims.k
@@ -0,0 +1,11 @@
+requires "audit-pinning-definition.k"
+
+module AUDIT-PINNING-CLAIMS
+  imports AUDIT-PINNING-DEFINITION
+
+  claim [loop-alias-is-submitted-body]:
+    <k> loopAliasMatchesSubmitted => true </k>
+
+  claim [function-alias-is-submitted-body]:
+    <k> functionAliasMatchesSubmitted => true </k>
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-pinning-definition.k b//tmp/audit-work/reconstruction/audit-pinning-definition.k
new file mode 100644
index 0000000000000000000000000000000000000000..e9c01e0e5489199da9148b0589826a90847ce8fa
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-pinning-definition.k
@@ -0,0 +1,41 @@
+requires "verification.k"
+
+module AUDIT-PINNING-DEFINITION
+  imports VERIFICATION
+
+  syntax Bool ::= "loopAliasMatchesSubmitted" [function, total]
+  rule loopAliasMatchesSubmitted
+    => findMaxLoopBody ==K
+       (Assign(
+          Name("unique"),
+          Call(Name("len"), Call(Name("set"), Name("word"))))
+        If(Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+          Assign(Name("best"), Name("word"))
+          Assign(Name("max_unique"), Name("unique")),
+          If(Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+            If(Compare(Name("word"), CmpOp("<", Name("best"))),
+              Assign(Name("best"), Name("word")),
+              .Stmts),
+            .Stmts)))
+
+  syntax Bool ::= "functionAliasMatchesSubmitted" [function, total]
+  rule functionAliasMatchesSubmitted
+    => findMaxFunctionBody ==K
+       (Assign(Name("best"), Str(""))
+        Assign(Name("max_unique"), Int(0))
+        Assign(Name("word"), Str(""))
+        Assign(Name("unique"), Int(0))
+        For(Name("word"), Name("words"),
+          Assign(
+            Name("unique"),
+            Call(Name("len"), Call(Name("set"), Name("word"))))
+          If(Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+            Assign(Name("best"), Name("word"))
+            Assign(Name("max_unique"), Name("unique")),
+            If(Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+              If(Compare(Name("word"), CmpOp("<", Name("best"))),
+                Assign(Name("best"), Name("word")),
+                .Stmts),
+              .Stmts)))
+        Return(Name("best")))
+endmodule
