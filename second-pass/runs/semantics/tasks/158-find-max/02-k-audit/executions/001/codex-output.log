diff --git a//tmp/audit-work/reconstruction/audit-bridge-mutated.k b//tmp/audit-work/reconstruction/audit-bridge-mutated.k
new file mode 100644
index 0000000000000000000000000000000000000000..ddd06da1da89013e4f54a17159ba815902138890
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-bridge-mutated.k
@@ -0,0 +1,15 @@
+requires "reference-semantics/semantics.k"
+
+module AUDIT-BRIDGE-MUTATED
+  imports MPY
+
+  syntax AuditMutWordSeq ::= ".AuditMutWordSeq"
+                            | amwCons(IntSeq, AuditMutWordSeq)
+  syntax ValSeq ::= auditMutWordVals(AuditMutWordSeq) [function, total]
+
+  rule auditMutWordVals(.AuditMutWordSeq) => .ValSeq
+  // Deliberate sensitivity mutation: replace every yielded word by "".
+  rule auditMutWordVals(
+         amwCons(_:IntSeq, REST:AuditMutWordSeq))
+    => vCons(str(.IntSeq), auditMutWordVals(REST))
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-ground-witness.k b//tmp/audit-work/reconstruction/audit-ground-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..aeec06e064e5361501d0c045b102713795133c8e
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-ground-witness.k
@@ -0,0 +1,84 @@
+requires "verification.k"
+
+module AUDIT-GROUND-WITNESS
+  imports VERIFICATION
+
+  claim [ground-loop-state]:
+    <k> #loop(
+          list(wordVals(wCons(
+            iCons(97, iCons(98, .IntSeq)),
+            .WordSeq))),
+          Name("word"),
+          findMaxLoopBody)
+         ~> .K
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+          1 |-> scope(
+            ("words" |-> list(wordVals(
+              wCons(iCons(98, iCons(97, .IntSeq)),
+              wCons(iCons(97, iCons(98, .IntSeq)), .WordSeq)))))
+            ("best" |-> str(iCons(98, iCons(97, .IntSeq))))
+            ("max_unique" |-> 2)
+            ("word" |-> str(iCons(98, iCons(97, .IntSeq))))
+            ("unique" |-> 2),
+            parent(0))
+          0 |-> scope(
+            "find_max" |->
+              closureVal(
+                ("words", .ParamNames),
+                findMaxFunctionBody,
+                0),
+            parent(-1))
+         -1 |-> builtinsScope
+      =>
+          1 |-> scope(
+            ("words" |-> list(wordVals(
+              wCons(iCons(98, iCons(97, .IntSeq)),
+              wCons(iCons(97, iCons(98, .IntSeq)), .WordSeq)))))
+            ("best" |-> str(iCons(97, iCons(98, .IntSeq))))
+            ("max_unique" |-> 2)
+            ("word" |-> str(iCons(97, iCons(98, .IntSeq))))
+            ("unique" |-> 2),
+            parent(0))
+          0 |-> scope(
+            "find_max" |->
+              closureVal(
+                ("words", .ParamNames),
+                findMaxFunctionBody,
+                0),
+            parent(-1))
+         -1 |-> builtinsScope
+    </scopes>
+
+  claim [ground-entry-state]:
+    <k> #loadAll(Module(
+         FuncDef("find_max", Params("words"), findMaxFunctionBody)))
+         ~> Call(Name("find_max"), list(wordVals(
+              wCons(iCons(98, iCons(97, .IntSeq)),
+              wCons(iCons(97, iCons(98, .IntSeq)), .WordSeq)))))
+      => str(iCons(97, iCons(98, .IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+         0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope
+      =>
+         0 |-> scope(
+                "find_max" |->
+                  closureVal(
+                    ("words", .ParamNames),
+                    findMaxFunctionBody,
+                    0),
+                parent(-1))
+        -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-pinning-claims.k b//tmp/audit-work/reconstruction/audit-pinning-claims.k
