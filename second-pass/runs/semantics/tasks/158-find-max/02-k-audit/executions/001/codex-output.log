+requires "reference-semantics/semantics.k"
+
+module AUDIT-BRIDGE-FREE
+  imports MPY
+
+  syntax WordSeq ::= ".WordSeq" | wCons(IntSeq, WordSeq)
+  syntax ValSeq ::= wordVals(WordSeq) [function, total]
+
+  rule wordVals(.WordSeq) => .ValSeq
+  rule wordVals(wCons(WORD:IntSeq, REST:WordSeq))
+    => vCons(str(WORD), wordVals(REST))
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-ground-witness.k b//tmp/audit-work/reconstruction/audit-ground-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..aeec06e064e5361501d0c045b102713795133c8e
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-ground-witness.k
@@ -0,0 +1,84 @@
+requires "verification.k"
+
+module AUDIT-GROUND-WITNESS
+  imports VERIFICATION
+
+  claim [ground-loop-state]:
+    <k> #loop(
+          list(wordVals(wCons(
+            iCons(97, iCons(98, .IntSeq)),
+            .WordSeq))),
+          Name("word"),
+          findMaxLoopBody)
+         ~> .K
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+          1 |-> scope(
+            ("words" |-> list(wordVals(
+              wCons(iCons(98, iCons(97, .IntSeq)),
+              wCons(iCons(97, iCons(98, .IntSeq)), .WordSeq)))))
+            ("best" |-> str(iCons(98, iCons(97, .IntSeq))))
+            ("max_unique" |-> 2)
+            ("word" |-> str(iCons(98, iCons(97, .IntSeq))))
+            ("unique" |-> 2),
+            parent(0))
+          0 |-> scope(
+            "find_max" |->
+              closureVal(
+                ("words", .ParamNames),
+                findMaxFunctionBody,
+                0),
+            parent(-1))
+         -1 |-> builtinsScope
+      =>
+          1 |-> scope(
+            ("words" |-> list(wordVals(
+              wCons(iCons(98, iCons(97, .IntSeq)),
+              wCons(iCons(97, iCons(98, .IntSeq)), .WordSeq)))))
+            ("best" |-> str(iCons(97, iCons(98, .IntSeq))))
+            ("max_unique" |-> 2)
+            ("word" |-> str(iCons(97, iCons(98, .IntSeq))))
+            ("unique" |-> 2),
+            parent(0))
+          0 |-> scope(
+            "find_max" |->
+              closureVal(
+                ("words", .ParamNames),
+                findMaxFunctionBody,
+                0),
+            parent(-1))
+         -1 |-> builtinsScope
+    </scopes>
+
+  claim [ground-entry-state]:
+    <k> #loadAll(Module(
+         FuncDef("find_max", Params("words"), findMaxFunctionBody)))
+         ~> Call(Name("find_max"), list(wordVals(
+              wCons(iCons(98, iCons(97, .IntSeq)),
+              wCons(iCons(97, iCons(98, .IntSeq)), .WordSeq)))))
+      => str(iCons(97, iCons(98, .IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+         0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope
+      =>
+         0 |-> scope(
+                "find_max" |->
+                  closureVal(
+                    ("words", .ParamNames),
+                    findMaxFunctionBody,
+                    0),
+                parent(-1))
+        -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-pinning.k b//tmp/audit-work/reconstruction/audit-pinning.k
new file mode 100644
index 0000000000000000000000000000000000000000..64b1c0c071a1322b856fb15089166740aa8cd5c1
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-pinning.k
@@ -0,0 +1,41 @@
+requires "verification.k"
+
+module AUDIT-PINNING
+  imports VERIFICATION
+
+  claim [loop-alias-is-submitted-body]:
+    findMaxLoopBody
+    =>
+    Assign(
+      Name("unique"),
+      Call(Name("len"), Call(Name("set"), Name("word"))))
+    If(Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+      Assign(Name("best"), Name("word"))
+      Assign(Name("max_unique"), Name("unique")),
+      If(Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+        If(Compare(Name("word"), CmpOp("<", Name("best"))),
+          Assign(Name("best"), Name("word")),
+          .Stmts),
+        .Stmts))
+
+  claim [function-alias-is-submitted-body]:
+    findMaxFunctionBody
+    =>
+    Assign(Name("best"), Str(""))
+    Assign(Name("max_unique"), Int(0))
+    Assign(Name("word"), Str(""))
+    Assign(Name("unique"), Int(0))
+    For(Name("word"), Name("words"),
+      Assign(
+        Name("unique"),
+        Call(Name("len"), Call(Name("set"), Name("word"))))
+      If(Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+        Assign(Name("best"), Name("word"))
+        Assign(Name("max_unique"), Name("unique")),
+        If(Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+          If(Compare(Name("word"), CmpOp("<", Name("best"))),
+            Assign(Name("best"), Name("word")),
+            .Stmts),
+          .Stmts)))
+    Return(Name("best"))
+endmodule
