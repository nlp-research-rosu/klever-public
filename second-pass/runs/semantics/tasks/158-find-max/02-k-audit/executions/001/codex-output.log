+requires "audit-bridge-free.k"
+
+module AUDIT-BRIDGE-CLAIMS
+  imports AUDIT-BRIDGE-FREE
+
+  claim [empty-iterator-connection]:
+    <k> #iterNext(list(wordVals(.WordSeq))) ~> KONT:K
+      => #iterDone ~> KONT
+    </k>
+
+  claim [nonempty-iterator-connection]:
+    <k> #iterNext(list(wordVals(
+          wCons(WORD:IntSeq, REST:WordSeq)))) ~> KONT:K
+      => #iterYield(str(WORD), list(wordVals(REST))) ~> KONT
+    </k>
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-bridge-free.k b//tmp/audit-work/reconstruction/audit-bridge-free.k
new file mode 100644
index 0000000000000000000000000000000000000000..1c77dc0599b060d9993e9ad47336afa91625e66f
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-bridge-free.k
@@ -0,0 +1,12 @@
+requires "reference-semantics/semantics.k"
+
+module AUDIT-BRIDGE-FREE
+  imports MPY
+
+  syntax WordSeq ::= ".WordSeq" | wCons(IntSeq, WordSeq)
+  syntax ValSeq ::= wordVals(WordSeq) [function, total]
+
+  rule wordVals(.WordSeq) => .ValSeq
+  rule wordVals(wCons(WORD:IntSeq, REST:WordSeq))
+    => vCons(str(WORD), wordVals(REST))
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-bridge-mutated-claim.k b//tmp/audit-work/reconstruction/audit-bridge-mutated-claim.k
new file mode 100644
index 0000000000000000000000000000000000000000..cdbffe8f3d189c0ba2dab341bc7c69ec7ddca4bc
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-bridge-mutated-claim.k
@@ -0,0 +1,15 @@
+requires "audit-bridge-mutated.k"
+
+module AUDIT-BRIDGE-MUTATED-CLAIM
+  imports AUDIT-BRIDGE-MUTATED
+
+  claim [mutated-word-map-must-not-connect]:
+    <k> #iterNext(list(auditMutWordVals(
+          amwCons(iCons(97, .IntSeq), .AuditMutWordSeq))))
+         ~> Int(7)
+      => #iterYield(
+           str(iCons(97, .IntSeq)),
+           list(auditMutWordVals(.AuditMutWordSeq)))
+         ~> Int(7)
+    </k>
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-bridge-mutated.k b//tmp/audit-work/reconstruction/audit-bridge-mutated.k
new file mode 100644
index 0000000000000000000000000000000000000000..ddd06da1da89013e4f54a17159ba815902138890
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-bridge-mutated.k
@@ -0,0 +1,15 @@
+requires "reference-semantics/semantics.k"
+
+module AUDIT-BRIDGE-MUTATED
+  imports MPY
+
+  syntax AuditMutWordSeq ::= ".AuditMutWordSeq"
+                            | amwCons(IntSeq, AuditMutWordSeq)
+  syntax ValSeq ::= auditMutWordVals(AuditMutWordSeq) [function, total]
+
+  rule auditMutWordVals(.AuditMutWordSeq) => .ValSeq
+  // Deliberate sensitivity mutation: replace every yielded word by "".
+  rule auditMutWordVals(
+         amwCons(_:IntSeq, REST:AuditMutWordSeq))
+    => vCons(str(.IntSeq), auditMutWordVals(REST))
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-ground-witness.k b//tmp/audit-work/reconstruction/audit-ground-witness.k
new file mode 100644
index 0000000000000000000000000000000000000000..aeec06e064e5361501d0c045b102713795133c8e
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-ground-witness.k
@@ -0,0 +1,84 @@
+requires "verification.k"
+
+module AUDIT-GROUND-WITNESS
+  imports VERIFICATION
+
+  claim [ground-loop-state]:
+    <k> #loop(
+          list(wordVals(wCons(
+            iCons(97, iCons(98, .IntSeq)),
+            .WordSeq))),
+          Name("word"),
+          findMaxLoopBody)
+         ~> .K
+      => .K
+    </k>
+    <env> 1 </env>
+    <scopes>
+          1 |-> scope(
+            ("words" |-> list(wordVals(
+              wCons(iCons(98, iCons(97, .IntSeq)),
+              wCons(iCons(97, iCons(98, .IntSeq)), .WordSeq)))))
+            ("best" |-> str(iCons(98, iCons(97, .IntSeq))))
+            ("max_unique" |-> 2)
+            ("word" |-> str(iCons(98, iCons(97, .IntSeq))))
+            ("unique" |-> 2),
+            parent(0))
+          0 |-> scope(
+            "find_max" |->
+              closureVal(
+                ("words", .ParamNames),
+                findMaxFunctionBody,
+                0),
+            parent(-1))
+         -1 |-> builtinsScope
+      =>
+          1 |-> scope(
+            ("words" |-> list(wordVals(
+              wCons(iCons(98, iCons(97, .IntSeq)),
+              wCons(iCons(97, iCons(98, .IntSeq)), .WordSeq)))))
+            ("best" |-> str(iCons(97, iCons(98, .IntSeq))))
+            ("max_unique" |-> 2)
+            ("word" |-> str(iCons(97, iCons(98, .IntSeq))))
+            ("unique" |-> 2),
+            parent(0))
+          0 |-> scope(
+            "find_max" |->
+              closureVal(
+                ("words", .ParamNames),
+                findMaxFunctionBody,
+                0),
+            parent(-1))
+         -1 |-> builtinsScope
+    </scopes>
+
+  claim [ground-entry-state]:
+    <k> #loadAll(Module(
+         FuncDef("find_max", Params("words"), findMaxFunctionBody)))
+         ~> Call(Name("find_max"), list(wordVals(
+              wCons(iCons(98, iCons(97, .IntSeq)),
+              wCons(iCons(97, iCons(98, .IntSeq)), .WordSeq)))))
+      => str(iCons(97, iCons(98, .IntSeq)))
+    </k>
+    <env> 0 </env>
+    <scopes>
+         0 |-> scope(.Map, parent(-1))
+        -1 |-> builtinsScope
+      =>
+         0 |-> scope(
+                "find_max" |->
+                  closureVal(
+                    ("words", .ParamNames),
+                    findMaxFunctionBody,
+                    0),
+                parent(-1))
+        -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-pinning-claims.k b//tmp/audit-work/reconstruction/audit-pinning-claims.k
new file mode 100644
index 0000000000000000000000000000000000000000..998a1946b2570f52b5462c5bfbe333a6eb97693a
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-pinning-claims.k
@@ -0,0 +1,11 @@
+requires "audit-pinning-definition.k"
+
+module AUDIT-PINNING-CLAIMS
+  imports AUDIT-PINNING-DEFINITION
+
+  claim [loop-alias-is-submitted-body]:
+    <k> loopAliasMatchesSubmitted => true </k>
+
+  claim [function-alias-is-submitted-body]:
+    <k> functionAliasMatchesSubmitted => true </k>
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-pinning-definition.k b//tmp/audit-work/reconstruction/audit-pinning-definition.k
new file mode 100644
index 0000000000000000000000000000000000000000..e9c01e0e5489199da9148b0589826a90847ce8fa
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-pinning-definition.k
@@ -0,0 +1,41 @@
+requires "verification.k"
+
+module AUDIT-PINNING-DEFINITION
+  imports VERIFICATION
+
+  syntax Bool ::= "loopAliasMatchesSubmitted" [function, total]
+  rule loopAliasMatchesSubmitted
+    => findMaxLoopBody ==K
+       (Assign(
+          Name("unique"),
+          Call(Name("len"), Call(Name("set"), Name("word"))))
+        If(Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+          Assign(Name("best"), Name("word"))
+          Assign(Name("max_unique"), Name("unique")),
+          If(Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+            If(Compare(Name("word"), CmpOp("<", Name("best"))),
+              Assign(Name("best"), Name("word")),
+              .Stmts),
+            .Stmts)))
+
+  syntax Bool ::= "functionAliasMatchesSubmitted" [function, total]
+  rule functionAliasMatchesSubmitted
+    => findMaxFunctionBody ==K
+       (Assign(Name("best"), Str(""))
+        Assign(Name("max_unique"), Int(0))
+        Assign(Name("word"), Str(""))
+        Assign(Name("unique"), Int(0))
+        For(Name("word"), Name("words"),
+          Assign(
+            Name("unique"),
+            Call(Name("len"), Call(Name("set"), Name("word"))))
+          If(Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+            Assign(Name("best"), Name("word"))
+            Assign(Name("max_unique"), Name("unique")),
+            If(Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+              If(Compare(Name("word"), CmpOp("<", Name("best"))),
+                Assign(Name("best"), Name("word")),
+                .Stmts),
+              .Stmts)))
+        Return(Name("best")))
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-pinning.k b//tmp/audit-work/reconstruction/audit-pinning.k
