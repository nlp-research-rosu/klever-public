diff --git a//tmp/audit-work/reconstruction/audit-bridge-claims.k b//tmp/audit-work/reconstruction/audit-bridge-claims.k
new file mode 100644
index 0000000000000000000000000000000000000000..91d5f7bbbe9f13244451ccc79c3c116094df9c57
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-bridge-claims.k
@@ -0,0 +1,16 @@
+requires "audit-bridge-free.k"
+
+module AUDIT-BRIDGE-CLAIMS
+  imports AUDIT-BRIDGE-FREE
+
+  claim [empty-iterator-connection]:
+    <k> #iterNext(list(wordVals(.WordSeq))) ~> KONT:K
+      => #iterDone ~> KONT
+    </k>
+
+  claim [nonempty-iterator-connection]:
+    <k> #iterNext(list(wordVals(
+          wCons(WORD:IntSeq, REST:WordSeq)))) ~> KONT:K
+      => #iterYield(str(WORD), list(wordVals(REST))) ~> KONT
+    </k>
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-bridge-free.k b//tmp/audit-work/reconstruction/audit-bridge-free.k
new file mode 100644
index 0000000000000000000000000000000000000000..1c77dc0599b060d9993e9ad47336afa91625e66f
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-bridge-free.k
@@ -0,0 +1,12 @@
+requires "reference-semantics/semantics.k"
+
+module AUDIT-BRIDGE-FREE
+  imports MPY
+
+  syntax WordSeq ::= ".WordSeq" | wCons(IntSeq, WordSeq)
+  syntax ValSeq ::= wordVals(WordSeq) [function, total]
+
+  rule wordVals(.WordSeq) => .ValSeq
+  rule wordVals(wCons(WORD:IntSeq, REST:WordSeq))
+    => vCons(str(WORD), wordVals(REST))
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-bridge-mutated-claim.k b//tmp/audit-work/reconstruction/audit-bridge-mutated-claim.k
