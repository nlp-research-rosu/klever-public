+                "find_max" |->
+                  closureVal(
+                    ("words", .ParamNames),
+                    findMaxFunctionBody,
+                    0),
+                parent(-1))
+        -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
