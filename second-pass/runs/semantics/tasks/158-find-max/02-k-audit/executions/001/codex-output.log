diff --git a//tmp/audit-work/reconstruction/audit-pinning-definition.k b//tmp/audit-work/reconstruction/audit-pinning-definition.k
new file mode 100644
index 0000000000000000000000000000000000000000..e9c01e0e5489199da9148b0589826a90847ce8fa
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-pinning-definition.k
@@ -0,0 +1,41 @@
+requires "verification.k"
+
+module AUDIT-PINNING-DEFINITION
+  imports VERIFICATION
+
+  syntax Bool ::= "loopAliasMatchesSubmitted" [function, total]
+  rule loopAliasMatchesSubmitted
+    => findMaxLoopBody ==K
+       (Assign(
+          Name("unique"),
+          Call(Name("len"), Call(Name("set"), Name("word"))))
+        If(Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+          Assign(Name("best"), Name("word"))
+          Assign(Name("max_unique"), Name("unique")),
+          If(Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+            If(Compare(Name("word"), CmpOp("<", Name("best"))),
+              Assign(Name("best"), Name("word")),
+              .Stmts),
+            .Stmts)))
+
+  syntax Bool ::= "functionAliasMatchesSubmitted" [function, total]
+  rule functionAliasMatchesSubmitted
+    => findMaxFunctionBody ==K
+       (Assign(Name("best"), Str(""))
+        Assign(Name("max_unique"), Int(0))
+        Assign(Name("word"), Str(""))
+        Assign(Name("unique"), Int(0))
+        For(Name("word"), Name("words"),
+          Assign(
+            Name("unique"),
+            Call(Name("len"), Call(Name("set"), Name("word"))))
+          If(Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+            Assign(Name("best"), Name("word"))
+            Assign(Name("max_unique"), Name("unique")),
+            If(Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+              If(Compare(Name("word"), CmpOp("<", Name("best"))),
+                Assign(Name("best"), Name("word")),
+                .Stmts),
+              .Stmts)))
+        Return(Name("best")))
+endmodule
diff --git a//tmp/audit-work/reconstruction/audit-pinning.k b//tmp/audit-work/reconstruction/audit-pinning.k
new file mode 100644
index 0000000000000000000000000000000000000000..64b1c0c071a1322b856fb15089166740aa8cd5c1
--- /dev/null
+++ b//tmp/audit-work/reconstruction/audit-pinning.k
@@ -0,0 +1,41 @@
+requires "verification.k"
+
+module AUDIT-PINNING
+  imports VERIFICATION
+
+  claim [loop-alias-is-submitted-body]:
+    findMaxLoopBody
+    =>
+    Assign(
+      Name("unique"),
+      Call(Name("len"), Call(Name("set"), Name("word"))))
+    If(Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+      Assign(Name("best"), Name("word"))
+      Assign(Name("max_unique"), Name("unique")),
+      If(Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+        If(Compare(Name("word"), CmpOp("<", Name("best"))),
+          Assign(Name("best"), Name("word")),
+          .Stmts),
+        .Stmts))
+
+  claim [function-alias-is-submitted-body]:
+    findMaxFunctionBody
+    =>
+    Assign(Name("best"), Str(""))
+    Assign(Name("max_unique"), Int(0))
+    Assign(Name("word"), Str(""))
+    Assign(Name("unique"), Int(0))
+    For(Name("word"), Name("words"),
+      Assign(
+        Name("unique"),
+        Call(Name("len"), Call(Name("set"), Name("word"))))
+      If(Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
+        Assign(Name("best"), Name("word"))
+        Assign(Name("max_unique"), Name("unique")),
+        If(Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
+          If(Compare(Name("word"), CmpOp("<", Name("best"))),
+            Assign(Name("best"), Name("word")),
+            .Stmts),
+          .Stmts)))
+    Return(Name("best"))
+endmodule
