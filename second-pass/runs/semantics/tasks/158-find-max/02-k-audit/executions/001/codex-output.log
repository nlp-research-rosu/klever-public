+              wCons(iCons(97, iCons(98, .IntSeq)), .WordSeq)))))
+            ("best" |-> str(iCons(98, iCons(97, .IntSeq))))
+            ("max_unique" |-> 2)
+            ("word" |-> str(iCons(98, iCons(97, .IntSeq))))
+            ("unique" |-> 2),
+            parent(0))
+          0 |-> scope(
+            "find_max" |->
+              closureVal(
+                ("words", .ParamNames),
+                findMaxFunctionBody,
+                0),
+            parent(-1))
+         -1 |-> builtinsScope
+      =>
+          1 |-> scope(
+            ("words" |-> list(wordVals(
+              wCons(iCons(98, iCons(97, .IntSeq)),
+              wCons(iCons(97, iCons(98, .IntSeq)), .WordSeq)))))
+            ("best" |-> str(iCons(97, iCons(98, .IntSeq))))
+            ("max_unique" |-> 2)
+            ("word" |-> str(iCons(97, iCons(98, .IntSeq))))
+            ("unique" |-> 2),
+            parent(0))
+          0 |-> scope(
+            "find_max" |->
+              closureVal(
+                ("words", .ParamNames),
+                findMaxFunctionBody,
+                0),
