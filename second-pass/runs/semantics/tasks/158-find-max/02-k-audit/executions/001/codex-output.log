def find_max(words):
    """Write a function that accepts a list of strings.
    The list contains different words. Return the word with maximum number
    of unique characters. If multiple strings have maximum number of unique
    characters, return the one which comes first in lexicographical order.

    find_max(["name", "of", "string"]) == "string"
    find_max(["name", "enam", "game"]) == "enam"
    find_max(["aaaaaaa", "bb" ,"cc"]) == ""aaaaaaa"
    """
# canonical.py — the UNMODIFIED HumanEval/158 reference solution (from the dataset).
# Co-located with solution.py (the proof rewrite) to make the original<->rewrite link
# explicit & auditable.  entry point: find_max


def find_max(words):
    """Write a function that accepts a list of strings.
    The list contains different words. Return the word with maximum number
    of unique characters. If multiple strings have maximum number of unique
    characters, return the one which comes first in lexicographical order.

    find_max(["name", "of", "string"]) == "string"
    find_max(["name", "enam", "game"]) == "enam"
    find_max(["aaaaaaa", "bb" ,"cc"]) == ""aaaaaaa"
    """
    return sorted(words, key = lambda x: (-len(set(x)), x))[0]
def find_max(words):
    best = ""
    max_unique = 0
    word = ""
    unique = 0
    for word in words:
        unique = len(set(word))
        if unique > max_unique:
            best = word
            max_unique = unique
        elif unique == max_unique:
            if word < best:
                best = word
    return best
Module(
  FuncDef("find_max", Params("words"),
    Assign(Name("best"), Str(""))
    Assign(Name("max_unique"), Int(0))
    Assign(Name("word"), Str(""))
    Assign(Name("unique"), Int(0))
    For(Name("word"), Name("words"),
      Assign(
        Name("unique"),
        Call(Name("len"), Call(Name("set"), Name("word"))))
      If(Compare(Name("unique"), CmpOp(">", Name("max_unique"))),
        Assign(Name("best"), Name("word"))
        Assign(Name("max_unique"), Name("unique")),
        If(Compare(Name("unique"), CmpOp("==", Name("max_unique"))),
          If(Compare(Name("word"), CmpOp("<", Name("best"))),
            Assign(Name("best"), Name("word")),
            ),
          )))
    Return(Name("best"))))
