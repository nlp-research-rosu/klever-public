/bin/bash -lc "python3 - <<'PY'
import json
from collections import Counter
inv = json.load(open('/reference/rule-inventory.json', encoding='utf-8'))
out = json.load(open('/workspace/trust-boundary.json', encoding='utf-8'))
allowed = {'DEFINITION', 'OPERATIONAL_RULE', 'PROVED_DERIVED_LEMMA', 'DOMAIN_LEMMA'}
assert set(out) == {'schema_version', 'inventory_sha256', 'rules'}
assert out['schema_version'] == 2
assert out['inventory_sha256'] == inv['inventory_sha256']
assert [r['source_rule_id'] for r in out['rules']] == [r['source_rule_id'] for r in inv['rules']]
assert len(out['rules']) == len({r['source_rule_id'] for r in out['rules']}) == len(inv['rules'])
by_id = {r['source_rule_id']: r for r in out['rules']}
for rule in out['rules']:
    assert set(rule) == {'source_rule_id', 'classification', 'rationale'}
    assert rule['classification'] in allowed
    assert isinstance(rule['rationale'], str) and rule['rationale'].strip()
for source in inv['rules']:
    if 'simplification' in source['attributes']:
        assert by_id[source['source_rule_id']]['classification'] in {'DEFINITION', 'DOMAIN_LEMMA'}
print('validated_rules', len(out['rules']))
print('classifications', dict(Counter(r['classification'] for r in out['rules'])))
print('inventory_sha256', out['inventory_sha256'])
PY
