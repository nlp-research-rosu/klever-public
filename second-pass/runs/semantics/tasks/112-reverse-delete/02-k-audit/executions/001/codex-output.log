+requires "spec.k"
+
+module BRIDGE-CONTEXT-SPEC
+  imports LOOP-SPEC
+
+  // The observable assignment immediately after the summarized loop must be
+  // preserved. This claim uses the same universal loop state as LOOP-SPEC and
+  // requires "after" to become "z" after the loop.
+  claim
+    <k>
+      #loop(
+        str(S:IntSeq),
+        Name("character"),
+        If(
+          Compare(Name("character"), CmpOp("not in", Name("c"))),
+          AugAssign(Name("result"), "+", Name("character"))
+          Assign(
+            Name("reversed_result"),
+            BinOp("+", Name("character"), Name("reversed_result"))),
+          .Stmts))
+      ~> Assign(Name("after"), Str("z"))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |->
+        ( scope(
+            ( "s" |-> str(ORIG:IntSeq)
+              "c" |-> str(C:IntSeq)
+              "result" |-> str(A:IntSeq)
+              "reversed_result" |-> str(RA:IntSeq)
+              "character" |-> V:Val
+              "after" |-> str(iCons(120, .IntSeq)) ),
+            P:Parent)
+        => scope(
+            ( "s" |-> str(ORIG)
+              "c" |-> str(C)
+              "result" |-> str(keptAcc(S, C, A))
+              "reversed_result" |-> str(reversedKeptAcc(S, C, RA))
+              "character" |-> lastCharacter(S, V)
+              "after" |-> str(iCons(122, .IntSeq)) ),
+            P) )
+      ...
+    </scopes>
+endmodule
diff --git a/evidence/concrete_harness.py b/evidence/concrete_harness.py
new file mode 100644
index 0000000000000000000000000000000000000000..dac69634adb7c49b3f91f30a4c9cca836c2ba064
--- /dev/null
+++ b/evidence/concrete_harness.py
@@ -0,0 +1,25 @@
+def reverse_delete(s, c):
+    result = ""
+    reversed_result = ""
+    character = ""
+    for character in s:
+        if character not in c:
+            result += character
+            reversed_result = character + reversed_result
+    return (result, result == reversed_result)
+
+
+# Documented examples.
+assert reverse_delete("abcde", "ae") == ("bcd", False)
+assert reverse_delete("abcdef", "b") == ("acdef", False)
+assert reverse_delete("abcdedcba", "ab") == ("cdedc", True)
+
+# Empty, branch-boundary, and representative cases supported by MPY strings.
+assert reverse_delete("", "") == ("", True)
+assert reverse_delete("", "anything") == ("", True)
+assert reverse_delete("x", "") == ("x", True)
+assert reverse_delete("x", "x") == ("", True)
+assert reverse_delete("abc", "abc") == ("", True)
+assert reverse_delete("abba", "") == ("abba", True)
+assert reverse_delete("abc", "") == ("abc", False)
+assert reverse_delete("ababab", "b") == ("aaa", True)
