python3 /audit-output/evidence/k_rule_inventory.py --semantics-root /reference/reference-semantics --verification /candidate/verification.k --spec /candidate/spec.k --json-output /audit-output/evidence/k-inventory.json --markdown-output /audit-output/evidence/k-inventory.md 2>&1 | tee /audit-output/evidence/k-inventory-run.log
status=${PIPESTATUS[0]}
