+        ( scope(
+            ( "s" |-> str(ORIG:IntSeq)
+              "c" |-> str(C:IntSeq)
+              "result" |-> str(A:IntSeq)
+              "reversed_result" |-> str(RA:IntSeq)
+              "character" |-> V:Val
