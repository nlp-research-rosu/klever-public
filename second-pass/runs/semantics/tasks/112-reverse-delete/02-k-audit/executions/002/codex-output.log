    10	  rule keptAcc(iCons(X:Int, XS:IntSeq), C:IntSeq, A:IntSeq)
    11	    => keptAcc(XS, C, A)
    12	    requires strContains(iCons(X, .IntSeq), C)
    13	    [simplification]
    14	  rule keptAcc(iCons(X:Int, XS:IntSeq), C:IntSeq, A:IntSeq)
    15	    => keptAcc(XS, C, seqConcat(A, iCons(X, .IntSeq)))
    16	    requires notBool strContains(iCons(X, .IntSeq), C)
    17	    [simplification]
    18	
    19	  // The implementation constructs the reverse incrementally by prepending.
