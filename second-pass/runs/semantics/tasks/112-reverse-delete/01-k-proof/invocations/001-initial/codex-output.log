patch: completed
/work/spec.k
/work/verification.k
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..144e04c42350b317bfd5f6babba777d96bd15cc5
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def reverse_delete(s, c):
+    result = ""
+    reversed_result = ""
+    character = ""
+    for character in s:
+        if character not in c:
+            result += character
+            reversed_result = character + reversed_result
