diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..3252575f20a92a2fe5f43619d7cded5de53e304f
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,17 @@
+def reverse_delete(s, c):
+    result = ""
+    reversed_result = ""
+    character = ""
+    for character in s:
+        if character not in c:
+            result += character
+            reversed_result = character + reversed_result
+    return (result, result == reversed_result)
+
+
+assert reverse_delete("abcde", "ae") == ("bcd", False)
+assert reverse_delete("abcdef", "b") == ("acdef", False)
+assert reverse_delete("abcdedcba", "ab") == ("cdedc", True)
+assert reverse_delete("", "anything") == ("", True)
+assert reverse_delete("abba", "") == ("abba", True)
+assert reverse_delete("abc", "abc") == ("", True)
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..78e48ed0382dff392c4eb515777c34fa1d18733f
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# Translate the submitted implementation with the fixed front end.
+python3 py2mpy.py solution.py > solution.mpy
+
+# Ensure the concrete harness embeds exactly the submitted function.
+cmp solution.py <(head -n 9 concrete_tests.py)
+python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
+
+# Concrete execution uses the required LLVM main and syntax modules.
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+krun concrete_tests.mpy --definition runtime-kompiled
+
+# Symbolic verification imports MPY through verification.k.
+kompile verification.k \
+  --backend haskell \
+  --main-module MPY-VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+# First prove the loop summary without importing the summary rule.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module LOOP-SPEC
+
+# Then use that proved summary to close the exact function-body claim.
+kprove spec.k \
+  --definition verification-kompiled \
+  --spec-module SPEC
diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..144e04c42350b317bfd5f6babba777d96bd15cc5
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,9 @@
+def reverse_delete(s, c):
+    result = ""
+    reversed_result = ""
+    character = ""
+    for character in s:
+        if character not in c:
+            result += character
+            reversed_result = character + reversed_result
+    return (result, result == reversed_result)
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..2f3873017b5be95b260fe5b7bce7e5a136b7f0cd
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,94 @@
+requires "verification.k"
+
+module LOOP-SPEC
+  imports MPY-VERIFICATION-BASE
+
+  claim
+    <k>
+      #loop(
+        str(S:IntSeq),
+        Name("character"),
+        If(
+          Compare(Name("character"), CmpOp("not in", Name("c"))),
+          AugAssign(Name("result"), "+", Name("character"))
+          Assign(
+            Name("reversed_result"),
+            BinOp("+", Name("character"), Name("reversed_result"))),
+          .Stmts))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |->
+        ( scope(
+            ( "s" |-> str(ORIG:IntSeq)
+              "c" |-> str(C:IntSeq)
+              "result" |-> str(A:IntSeq)
+              "reversed_result" |-> str(RA:IntSeq)
+              "character" |-> V:Val ),
+            P:Parent)
+        => scope(
+            ( "s" |-> str(ORIG)
+              "c" |-> str(C)
+              "result" |-> str(keptAcc(S, C, A))
+              "reversed_result" |-> str(reversedKeptAcc(S, C, RA))
+              "character" |-> lastCharacter(S, V) ),
+            P) )
+      ...
+    </scopes>
+endmodule
+
+module SPEC
+  imports MPY-VERIFICATION
+
+  claim
+    <k>
+      Call(
+        closureVal(
+          ("s", "c"),
+          Assign(Name("result"), Str(""))
+          Assign(Name("reversed_result"), Str(""))
+          Assign(Name("character"), Str(""))
+          For(
+            Name("character"),
+            Name("s"),
+            If(
+              Compare(Name("character"), CmpOp("not in", Name("c"))),
+              AugAssign(Name("result"), "+", Name("character"))
+              Assign(
+                Name("reversed_result"),
+                BinOp("+", Name("character"), Name("reversed_result"))),
+              .Stmts))
+          Return(
+            TupleExpr(
+              Name("result"),
+              Compare(
+                Name("result"),
+                CmpOp("==", Name("reversed_result"))))),
+          0),
+        str(S:IntSeq),
+        str(C:IntSeq))
+      => tuple(
+           vCons(
+             str(keptAcc(S, C, .IntSeq)),
+             vCons(
+               keptAcc(S, C, .IntSeq)
+                 ==K reversedKeptAcc(S, C, .IntSeq),
+               .ValSeq)))
+      ...
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..6328ea0b9d5590fd1050af35ed130d655305ec73
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,80 @@
+requires "reference-semantics/semantics.k"
+
+module MPY-VERIFICATION-BASE
+  imports MPY
+
+  // Process the remaining input left-to-right, appending each retained
+  // character to the forward accumulator.
+  syntax IntSeq ::= keptAcc(IntSeq, IntSeq, IntSeq) [function, total]
+  rule keptAcc(.IntSeq, _:IntSeq, A:IntSeq) => A
+  rule keptAcc(iCons(X:Int, XS:IntSeq), C:IntSeq, A:IntSeq)
+    => keptAcc(XS, C, A)
+    requires strContains(iCons(X, .IntSeq), C)
+    [simplification]
+  rule keptAcc(iCons(X:Int, XS:IntSeq), C:IntSeq, A:IntSeq)
+    => keptAcc(XS, C, seqConcat(A, iCons(X, .IntSeq)))
+    requires notBool strContains(iCons(X, .IntSeq), C)
+    [simplification]
+
+  // The implementation constructs the reverse incrementally by prepending.
+  syntax IntSeq ::= reversedKeptAcc(IntSeq, IntSeq, IntSeq) [function, total]
+  rule reversedKeptAcc(.IntSeq, _:IntSeq, A:IntSeq) => A
+  rule reversedKeptAcc(iCons(X:Int, XS:IntSeq), C:IntSeq, A:IntSeq)
+    => reversedKeptAcc(XS, C, A)
+    requires strContains(iCons(X, .IntSeq), C)
+    [simplification]
+  rule reversedKeptAcc(iCons(X:Int, XS:IntSeq), C:IntSeq, A:IntSeq)
+    => reversedKeptAcc(XS, C, iCons(X, A))
+    requires notBool strContains(iCons(X, .IntSeq), C)
+    [simplification]
+
+  // A for-loop leaves its target bound to the last element, or unchanged
+  // when the iterable is empty.
+  syntax Val ::= lastCharacter(IntSeq, Val) [function, total]
+  rule lastCharacter(.IntSeq, V:Val) => V
+  rule lastCharacter(iCons(X:Int, XS:IntSeq), _:Val)
+    => lastCharacter(XS, str(iCons(X, .IntSeq)))
+endmodule
+
+module MPY-VERIFICATION
+  imports MPY-VERIFICATION-BASE
+
+  // This is the proved loop invariant from LOOP-SPEC, installed as a lemma
+  // for the end-to-end entry-point proof in SPEC.
+  rule
+    <k>
+      #loop(
+        str(S:IntSeq),
+        Name("character"),
+        If(
+          Compare(Name("character"), CmpOp("not in", Name("c"))),
+          AugAssign(Name("result"), "+", Name("character"))
+          Assign(
+            Name("reversed_result"),
+            BinOp("+", Name("character"), Name("reversed_result"))),
+          .Stmts))
+      => .K
+      ...
+    </k>
+    <env> L:Int </env>
+    <scopes>
+      ...
+      L |->
+        ( scope(
+            ( "s" |-> str(ORIG:IntSeq)
+              "c" |-> str(C:IntSeq)
+              "result" |-> str(A:IntSeq)
+              "reversed_result" |-> str(RA:IntSeq)
+              "character" |-> V:Val ),
+            P:Parent)
+        => scope(
+            ( "s" |-> str(ORIG)
+              "c" |-> str(C)
+              "result" |-> str(keptAcc(S, C, A))
+              "reversed_result" |-> str(reversedKeptAcc(S, C, RA))
+              "character" |-> lastCharacter(S, V) ),
+            P) )
+      ...
+    </scopes>
+    [priority(40)]
+endmodule

