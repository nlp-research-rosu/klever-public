     6	    A string is called palindrome if it reads the same backward as forward.
     7	    You should return a tuple containing the result string and True/False for the check.
     8	    Example
     9	    For s = "abcde", c = "ae", the result should be ('bcd',False)
    10	    For s = "abcdef", c = "b"  the result should be ('acdef',False)
    11	    For s = "abcdedcba", c = "ab", the result should be ('cdedc',True)
    12	    """
     1	#!/usr/bin/env bash
     2	set -euo pipefail
     3	
     4	# Translate the submitted implementation with the fixed front end.
     5	python3 py2mpy.py solution.py > solution.mpy
     6	
     7	# Ensure the concrete harness embeds exactly the submitted function.
     8	cmp solution.py <(head -n 9 concrete_tests.py)
     9	python3 py2mpy.py concrete_tests.py > concrete_tests.mpy
    10	
    11	# Concrete execution uses the required LLVM main and syntax modules.
    12	kompile reference-semantics/semantics.k \
    13	  --backend llvm \
    14	  --main-module MPY-KRUN \
    15	  --syntax-module MPY-SYNTAX \
    16	  --output-definition runtime-kompiled
    17	krun concrete_tests.mpy --definition runtime-kompiled
    18	
    19	# Symbolic verification imports MPY through verification.k.
    20	kompile verification.k \
    21	  --backend haskell \
    22	  --main-module MPY-VERIFICATION \
    23	  --syntax-module MPY-SYNTAX \
    24	  --output-definition verification-kompiled
    25	
    26	# First prove the loop summary without importing the summary rule.
    27	kprove spec.k \
    28	  --definition verification-kompiled \
    29	  --spec-module LOOP-SPEC
    30	
    31	# Then use that proved summary to close the exact function-body claim.
    32	kprove spec.k \
    33	  --definition verification-kompiled \
    34	  --spec-module SPEC

