+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <execinfo.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/uio.h>
+#include <unistd.h>
+
+typedef ssize_t (*write_fn)(int, const void *, size_t);
+
+ssize_t write(int fd, const void *buf, size_t count) {
+  static write_fn real_write;
+  static int tracing;
+  if (!real_write) {
+    real_write = (write_fn)dlsym(RTLD_NEXT, "write");
+  }
+  if (!tracing && count >= 28 &&
+      memmem(buf, count, "failed to locate application", 28)) {
+    tracing = 1;
+    void *frames[64];
+    int frame_count = backtrace(frames, 64);
+    backtrace_symbols_fd(frames, frame_count, STDERR_FILENO);
+    tracing = 0;
+  }
+  return real_write(fd, buf, count);
+}
+
+typedef size_t (*fwrite_fn)(const void *, size_t, size_t, FILE *);
+
+size_t fwrite(const void *ptr, size_t size, size_t nmemb, FILE *stream) {
+  static fwrite_fn real_fwrite;
+  static int tracing;
+  if (!real_fwrite) {
+    real_fwrite = (fwrite_fn)dlsym(RTLD_NEXT, "fwrite");
+  }
+  size_t count = size * nmemb;
+  if (!tracing && count >= 28 &&
+      memmem(ptr, count, "failed to locate application", 28)) {
+    tracing = 1;
+    void *frames[64];
+    int frame_count = backtrace(frames, 64);
+    backtrace_symbols_fd(frames, frame_count, STDERR_FILENO);
+    tracing = 0;
+  }
+  return real_fwrite(ptr, size, nmemb, stream);
+}
+
+typedef void (*cxa_throw_fn)(void *, void *, void (*)(void *));
+
+void __cxa_throw(void *exception, void *type_info, void (*destructor)(void *)) {
+  static cxa_throw_fn real_throw;
+  static int tracing;
+  if (!real_throw) {
+    real_throw = (cxa_throw_fn)dlsym(RTLD_NEXT, "__cxa_throw");
+  }
+  if (!tracing) {
+    tracing = 1;
+    void *frames[64];
+    int frame_count = backtrace(frames, 64);
+    backtrace_symbols_fd(frames, frame_count, STDERR_FILENO);
+    tracing = 0;
+  }
+  real_throw(exception, type_info, destructor);
+  __builtin_unreachable();
+}
