diff --git a//tmp/audit-work/proc-self-exe-fix.c b//tmp/audit-work/proc-self-exe-fix.c
new file mode 100644
index 0000000000000000000000000000000000000000..65ca808fcd710dd4a2498f19ce94635de28aedf0
--- /dev/null
+++ b//tmp/audit-work/proc-self-exe-fix.c
@@ -0,0 +1,21 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <stddef.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buffer, size_t size) {
+  static readlink_fn real_readlink;
+  if (!real_readlink) {
+    real_readlink = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  }
+  if (path && strncmp(path, "/proc/", 6) == 0) {
+    const char *suffix = strrchr(path, '/');
+    if (suffix && strcmp(suffix, "/exe") == 0) {
+      return real_readlink("/proc/self/exe", buffer, size);
+    }
+  }
+  return real_readlink(path, buffer, size);
+}
