+  | none =>
+      cases h₂ : _root_._Map_ ⟨[(key, value₂)]⟩ right with
+      | none =>
+          refine ⟨⟨[]⟩, ?_, ?_⟩
+          · simp only [_Map_, h₁]
+            change some (⟨_ ++ []⟩ : SortMap) = some (⟨_⟩ : SortMap)
+            simp
+          · simp only [_Map_, h₂]
+            change some (⟨_ ++ []⟩ : SortMap) = some (⟨_⟩ : SortMap)
+            simp
+      | some result =>
+          simp [h₁, h₂] at stable
+  | some result₁ =>
+      cases h₂ : _root_._Map_ ⟨[(key, value₂)]⟩ right with
+      | none =>
+          simp [h₁, h₂] at stable
+      | some result₂ =>
+          refine ⟨right, ?_, ?_⟩
+          · simpa [_Map_, h₁] using h₁
+          · simpa [_Map_, h₂] using h₂
