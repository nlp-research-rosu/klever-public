new file mode 100644
index 0000000000000000000000000000000000000000..6f32d925311be1519c193668c4e51a0094f401a7
--- /dev/null
+++ b//tmp/lean_proc_self.c
@@ -0,0 +1,19 @@
+#define _GNU_SOURCE
+#include <dlfcn.h>
+#include <errno.h>
+#include <string.h>
+#include <unistd.h>
+
+typedef ssize_t (*readlink_fn)(const char *, char *, size_t);
+
+ssize_t readlink(const char *path, char *buf, size_t size) {
+  static readlink_fn next = NULL;
+  if (next == NULL) next = (readlink_fn)dlsym(RTLD_NEXT, "readlink");
+  ssize_t result = next(path, buf, size);
+  if (result < 0 && errno == ENOENT &&
+      strncmp(path, "/proc/", 6) == 0 &&
+      strstr(path + 6, "/exe") != NULL) {
+    result = next("/proc/self/exe", buf, size);
+  }
+  return result;
+}
diff --git a//tmp/trace_lean_path.c b//tmp/trace_lean_path.c
new file mode 100644
