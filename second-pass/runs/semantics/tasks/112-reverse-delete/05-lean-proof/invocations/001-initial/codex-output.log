def guard.{v} : {f : Type → Type v} → [Alternative f] → (p : Prop) → [Decidable p] → f Unit :=
fun {f} [Alternative f] p [Decidable p] => if p then pure () else failure
protected def Option.orElse.{u_1} : {α : Type u_1} → Option α → (Unit → Option α) → Option α :=
fun {α} x x_1 =>
  match x, x_1 with
  | some a, x => some a
  | none, b => b ()
beq_eq_false_iff_ne.{u_1} {α : Type u_1} [BEq α] [LawfulBEq α] {a b : α} : (a == b) = false ↔ a ≠ b
beq_iff_eq.{u_1} {α : Type u_1} [BEq α] [LawfulBEq α] {a b : α} : (a == b) = true ↔ a = b
decide_eq_false_iff_not {p : Prop} {x✝ : Decidable p} : decide p = false ↔ ¬p
decide_eq_true_eq {p : Prop} [Decidable p] : (decide p = true) = p

