diff --git a/solution.py b/solution.py
new file mode 100644
index 0000000000000000000000000000000000000000..c3b85bffb0f7098eae2ffeddac6bd11167ac9cc0
--- /dev/null
+++ b/solution.py
@@ -0,0 +1,10 @@
+from typing import List
+
+
+def mean_absolute_deviation(numbers: List[float]) -> float:
+    """Return the mean absolute deviation of a non-empty list of numbers."""
+    mean = sum(numbers) / len(numbers)
+    total_deviation = 0.0
+    for number in numbers:
+        total_deviation += abs(number - mean)
+    return total_deviation / len(numbers)

