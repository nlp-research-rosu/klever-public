Module(
  ImportFrom("typing", "List")
  FuncDef("mean_absolute_deviation", Params("numbers"),
    Assign(
      Name("mean"),
      BinOp(
        "/",
        Call(Name("sum"), Name("numbers")),
        Call(Name("len"), Name("numbers"))))
    Assign(Name("total_deviation"), Float(0.0))
    For(Name("number"), Name("numbers"),
      AugAssign(
        Name("total_deviation"),
        "+",
        Call(Name("abs"), BinOp("-", Name("number"), Name("mean")))))
    Return(
      BinOp(
        "/",
        Name("total_deviation"),
        Call(Name("len"), Name("numbers")))))
  Assert(
    Compare(
      Call(
        Name("mean_absolute_deviation"),
        ListExpr(Float(1.0), Float(2.0), Float(3.0), Float(4.0))),
      CmpOp("==", Float(1.0))))
  Assert(
    Compare(
      Call(Name("mean_absolute_deviation"), ListExpr(Float(1.0))),
      CmpOp("==", Float(0.0))))
  Assert(
    Compare(
      Call(
        Name("mean_absolute_deviation"),
        ListExpr(UnaryOp("-", Float(1.0)), Float(1.0))),
      CmpOp("==", Float(1.0))))
  Assert(
    Compare(
      Call(
        Name("mean_absolute_deviation"),
        ListExpr(Float(1.5), Float(1.5), Float(1.5))),
      CmpOp("==", Float(0.0)))))
