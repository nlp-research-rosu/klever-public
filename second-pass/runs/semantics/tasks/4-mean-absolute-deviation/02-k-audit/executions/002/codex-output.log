+         "mean" |-> F
+         "total_deviation" |-> 0.0,
+         parent(0))
+       =>
+       1 |-> scope(
+         "mean" |-> F
+         "total_deviation" |->
+           absDeviationFold(vCons(F, .ValSeq), F, 0.0),
+         parent(0)))
