+requires "verification.k"
+
+module LOOP-UNSOUND-WITNESS
+  imports MAD-VERIFICATION
+
+  // The candidate bridge skips the ordinary for-target binding.  On this
+  // satisfying one-float input it therefore proves that the local map remains
+  // unchanged, although fixed loop execution binds "number" to 1.0.
+  claim
+    <k> #loop(
+          list(vCons(F:Float, .ValSeq)),
+          Name("number"),
+          AugAssign(
+            Name("total_deviation"),
+            "+",
+            Call(
+              Name("abs"),
+              BinOp("-", Name("number"), Name("mean")))))
+        => .K </k>
+    <env> 1 </env>
+    <scopes>
+      (1 |-> scope(
+         "mean" |-> F
+         "total_deviation" |-> 0.0,
+         parent(0))
+       =>
+       1 |-> scope(
+         "mean" |-> F
+         "total_deviation" |->
+           absDeviationFold(vCons(F, .ValSeq), F, 0.0),
+         parent(0)))
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
diff --git a//tmp/audit-work/candidate/spec-body-mutated.k b//tmp/audit-work/candidate/spec-body-mutated.k
new file mode 100644
index 0000000000000000000000000000000000000000..ec0490148aa1a0648152881d0f7643fb5086a36a
--- /dev/null
+++ b//tmp/audit-work/candidate/spec-body-mutated.k
@@ -0,0 +1,42 @@
+requires "verification-body-mutated.k"
+
+module MAD-SPEC-BODY-MUTATED
+  imports MAD-VERIFICATION-BODY-MUTATED
+
+  // The destination pins the mutated closure body, but deliberately retains
+  // the original result formula whose deviation fold starts from 0.0.
+  claim
+    <k> #runMad(list(VS:ValSeq))
+        => divFloatIntV(
+             absDeviationFold(
+               VS,
+               divFloatIntV(sumFloatSeq(VS), vsLen(VS)),
+               0.0),
+             vsLen(VS)) </k>
+    <env> 0 </env>
+    <scopes> 0 |-> scope(.Map
+               => "mean_absolute_deviation" |->
+                    closureVal("numbers", .ParamNames,
+                      Expr(Str("Return the mean absolute deviation of a non-empty list of numbers."))
+                      Assign(Name("mean"),
+                        BinOp("/",
+                          Call(Name("sum"), Name("numbers")),
+                          Call(Name("len"), Name("numbers"))))
+                      Assign(Name("total_deviation"), Float(1.0))
+                      For(Name("number"), Name("numbers"),
+                        AugAssign(Name("total_deviation"), "+",
+                          Call(Name("abs"),
+                            BinOp("-", Name("number"), Name("mean")))))
+                      Return(BinOp("/", Name("total_deviation"),
+                        Call(Name("len"), Name("numbers")))),
+                      0), parent(-1))
+             -1 |-> builtinsScope </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires nonEmptyFloats(VS)
+endmodule
diff --git a//tmp/audit-work/candidate/spec-false-result.k b//tmp/audit-work/candidate/spec-false-result.k
