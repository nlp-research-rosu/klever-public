cwd: /audit-output
command: bash -lc for\ pair\ in\ \"prompt.py\ /reference/prompt.py\"\ \"py2mpy.py\ /reference/py2mpy.py\"\;\ do\ set\ --\ \$pair\;\ if\ cmp\ -s\ \"/candidate/\$1\"\ \"\$2\"\;\ then\ echo\ \"IDENTICAL\ /candidate/\$1\ \$2\"\;\ else\ status=\$\?\;\ echo\ \"DIFFERENT_OR_ERROR\ status=\$status\ /candidate/\$1\ \$2\"\;\ diff\ -u\ \"\$2\"\ \"/candidate/\$1\"\ \|\|\ true\;\ fi\;\ done\;\ echo\ \"CANDIDATE_SYMLINKS\"\;\ find\ /candidate\ -type\ l\ -printf\ \"%p\ -\>\ %l\\n\"\;\ echo\ \"SEMANTICS_DIFF\"\;\ diff\ -ru\ --no-dereference\ /reference/reference-semantics\ /candidate/reference-semantics\;\ diff_status=\$\?\;\ echo\ \"semantics_diff_status=\$diff_status\"\;\ exit\ \"\$diff_status\"
IDENTICAL /candidate/prompt.py /reference/prompt.py
IDENTICAL /candidate/py2mpy.py /reference/py2mpy.py
CANDIDATE_SYMLINKS
SEMANTICS_DIFF
semantics_diff_status=0

exit_status: 0
