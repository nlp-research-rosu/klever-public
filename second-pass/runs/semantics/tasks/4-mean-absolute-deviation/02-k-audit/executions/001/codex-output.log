+#!/usr/bin/env python3
+"""Independent candidate-vs-trusted-canonical differential test."""
+
+from __future__ import annotations
+
+import hashlib
+import importlib.util
+import json
+import math
+import random
+import struct
+from pathlib import Path
+from typing import Any, Callable
+
+
