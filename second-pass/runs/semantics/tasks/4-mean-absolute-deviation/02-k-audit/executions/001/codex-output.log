+              "total_deviation" |-> (ACC:Float
+                => addF(ACC, absF(subF(F, MEAN))))
+              "number" |-> OLD:Float,
+              parent(0))
+       0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 2 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+endmodule
