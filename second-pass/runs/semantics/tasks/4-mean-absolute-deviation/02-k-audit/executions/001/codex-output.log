@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+
+set +e
+
+if (( $# < 2 )); then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
