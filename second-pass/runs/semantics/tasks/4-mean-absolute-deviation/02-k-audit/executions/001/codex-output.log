+#!/usr/bin/env bash
+
+set +e
+
+if (( $# < 2 )); then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+
+{
+  printf 'cwd: %q\n' "$PWD"
+  printf 'command:'
+  printf ' %q' "$@"
+  printf '\n'
+} >"$audit_log"
+
+"$@" >>"$audit_log" 2>&1
+audit_status=$?
+
+printf '\nexit_status: %d\n' "$audit_status" >>"$audit_log"
+exit "$audit_status"

codex
The clean positive claim independently closes with exit 0 and `#Top`. Static review has identified a potentially decisive issue in the proof-local loop shortcut: it computes the accumulator but does not perform the real loop’s assignment to the loop variable `number`. I’m constructing a bounded witness that compares the same satisfying float-list state under fixed supplied semantics versus the extended verification theory.
apply patch
