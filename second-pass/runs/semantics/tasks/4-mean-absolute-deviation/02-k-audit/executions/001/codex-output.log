@@ -0,0 +1,24 @@
+#!/usr/bin/env bash
+
+set +e
+
+if (( $# < 2 )); then
+  echo "usage: run_logged.sh LOG COMMAND [ARG ...]" >&2
+  exit 64
+fi
+
+audit_log=$1
+shift
+
+{
+  printf 'cwd: %q\n' "$PWD"
+  printf 'command:'
+  printf ' %q' "$@"
+  printf '\n'
+} >"$audit_log"
+
+"$@" >>"$audit_log" 2>&1
+audit_status=$?
+
+printf '\nexit_status: %d\n' "$audit_status" >>"$audit_log"
+exit "$audit_status"

exec
/bin/bash -lc "/audit-output/evidence/run_logged.sh /audit-output/evidence/19_inventory_generation_corrected.log bash -lc 'python3 /audit-output/evidence/k_rule_inventory.py > /audit-output/evidence/k-rule-inventory.tsv; inventory_status="'$?; echo "inventory_status=$inventory_status"; if test "$inventory_status" -ne 0; then exit "$inventory_status"; fi; wc -l /audit-output/evidence/k-rule-inventory.tsv; awk -F "'"\\t\" \"NR > 1 { kind[\\"'$4]++; disp['"\\"'$7]++; file['"\\"'$2]++ } END { for (k in kind) print '"\\\"kind\\\", k, kind[k]; for (d in disp) print \\\"disposition\\\", d, disp[d]; for (f in file) print \\\"file\\\", f, file[f] }\" /audit-output/evidence/k-rule-inventory.tsv | sort'" in /audit-output
