/bin/bash -lc "script -q -e -c 'python3 /audit-output/evidence/make_positive_claim_splits.py; audit_status="'$?; echo EXIT_STATUS=$audit_status; exit $audit_status'"' /audit-output/evidence/stage3-make-claim-splits.log && script -q -e -c 'kprove --definition audit-verification-kompiled --spec-module AUDIT-SPEC-RESULT audit-spec-result.k; audit_status="'$?; echo EXIT_STATUS=$audit_status; exit $audit_status'"' /audit-output/evidence/stage3-kprove-result-claim.log" in /tmp/audit-work/candidate
