@@ -0,0 +1,29 @@
+requires "verification.k"
+
+module AUDIT-SPEC-VACUITY-FRESH
+  imports VERIFICATION
+
+  // Deliberately false: execution produces bisectLow(...), while this target
+  // demands the distinct bisectHigh(...) constructor.
+  claim
+    <k>
+      Call(
+        closureVal(("xs", .ParamNames), findZeroBody, 0),
+        list(VS:ValSeq))
+      =>
+      bisectHigh(VS, bracketLow(VS), bracketHigh(VS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires validPolynomial(VS)
+endmodule
diff --git a/evidence/stage1_integrity.sh b/evidence/stage1_integrity.sh
new file mode 100644
index 0000000000000000000000000000000000000000..c8cba528f4a244036ddd190fe3dcee587d998448
