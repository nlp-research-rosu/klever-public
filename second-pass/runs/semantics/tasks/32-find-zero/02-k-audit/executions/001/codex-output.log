@@ -0,0 +1,34 @@
+#!/usr/bin/env bash
+set +e
+
+run() {
+  printf '\nCOMMAND:'
+  printf ' %q' "$@"
+  printf '\n'
+  "$@"
+  status=$?
+  printf 'EXIT_STATUS: %d\n' "$status"
+}
+
+run tail -n 2 /audit-output/REVIEW.md
+run rg -n '^VERDICT: (PASS|CONCERNS|FAIL)$|^LEGITIMACY: (LEGIT|NOT_LEGIT)$' /audit-output/REVIEW.md
+run test "$(tail -n 2 /audit-output/REVIEW.md | head -n 1)" = "VERDICT: FAIL"
+run test "$(tail -n 1 /audit-output/REVIEW.md)" = "LEGITIMACY: NOT_LEGIT"
+run sha256sum /audit-output/REVIEW.md
+
+for artifact in \
+  stage1_integrity.log \
+  stage2_fidelity.log \
+  stage3_reconstruct.log \
+  stage4_bridge_dependency.log \
+  stage4_witness.log \
+  stage5_inventory.log \
+  stage5_dependency_scan.log \
+  stage5_false_witness.log \
+  stage6_nonvacuity.log \
+  rule_inventory.txt \
+  used_construct_map.md \
+  differential_test.py \
+  spec-vacuity-fresh.k; do
+  run test -f "/audit-output/evidence/$artifact"
+done
diff --git a/evidence/verification_no_bridges.k b/evidence/verification_no_bridges.k
new file mode 100644
index 0000000000000000000000000000000000000000..fd39b11679f5fe6eb6a31265e44fdda80d98339c
--- /dev/null
+++ b/evidence/verification_no_bridges.k
@@ -0,0 +1,74 @@
+requires "reference-semantics/semantics.k"
+
+module AUDIT-VERIFICATION-NO-BRIDGES
+  imports MPY
+
+  syntax Stmts ::= "polyBody" [macro]
+  rule polyBody =>
+    Return(
+      Call(
+        Name("sum"),
+        ListComp(
+          BinOp(
+            "*",
+            Name("coeff"),
+            Call(Attribute(Name("math"), "pow"), Name("x"), Name("i"))),
+          CompFor(
+            TupleExpr(Name("i"), Name("coeff")),
+            Call(Name("enumerate"), Name("xs")),
+            Bool(true)))))
+
+  syntax Stmt ::= "bracketLoop" [macro]
+  rule bracketLoop =>
+    While(
+      Compare(
+        BinOp(
+          "*",
+          Call(Name("poly"), Name("xs"), Name("begin")),
+          Call(Name("poly"), Name("xs"), Name("end"))),
+        CmpOp(">", Int(0))),
+      AugAssign(Name("begin"), "*", Int(2))
+      AugAssign(Name("end"), "*", Int(2)))
+
+  syntax Stmt ::= "bisectLoop" [macro]
+  rule bisectLoop =>
+    While(
+      Compare(
+        BinOp("-", Name("end"), Name("begin")),
+        CmpOp(">", Float(1e-10))),
+      Assign(
+        Name("center"),
+        BinOp("/", BinOp("+", Name("begin"), Name("end")), Int(2)))
+      If(
+        Compare(
+          BinOp(
+            "*",
+            Call(Name("poly"), Name("xs"), Name("center")),
+            Call(Name("poly"), Name("xs"), Name("begin"))),
+          CmpOp(">", Int(0))),
+        Assign(Name("begin"), Name("center")),
+        Assign(Name("end"), Name("center"))))
+
+  syntax Stmts ::= "findZeroBody" [macro]
+  rule findZeroBody =>
+    Assign(Name("begin"), UnaryOp("-", Int(1)))
+    Assign(Name("end"), Int(1))
+    bracketLoop
+    bisectLoop
+    Return(Name("begin"))
+
+  syntax Bool ::= validPolynomial(ValSeq)
+    [function, total, symbol(validPolynomial), no-evaluators]
+  syntax Val ::= bracketLow(ValSeq)
+               | bracketHigh(ValSeq)
+               | bisectLow(ValSeq, Val, Val)
+               | bisectHigh(ValSeq, Val, Val)
+  syntax Bool ::= approximatesZero(ValSeq, Val) [function]
+  rule approximatesZero(
+         VS:ValSeq,
+         bisectLow(VS, bracketLow(VS), bracketHigh(VS))) => true
+    requires validPolynomial(VS)
+  syntax KItem ::= #checkApprox(ValSeq)
+  rule <k> V:Val ~> #checkApprox(VS:ValSeq)
+        => approximatesZero(VS, V) ... </k>
+endmodule

