+
+cd "$audit_source" || exit 98
+printf 'WORKDIR: %s\n' "$PWD"
+
+run kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition audit-runtime-kompiled
