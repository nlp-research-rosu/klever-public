+  --spec-module AUDIT-POSITIVE-RETURN-SPEC
+
+run kprove positive-approx-spec.k \
+  --definition audit-verification-kompiled \
+  --spec-module AUDIT-POSITIVE-APPROX-SPEC
+
+run kprove spec.k \
+  --definition audit-verification-kompiled \
+  --spec-module SPEC

