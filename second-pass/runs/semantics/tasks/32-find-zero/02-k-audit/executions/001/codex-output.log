    16	def find_zero(xs: list):
    17	    """ xs are coefficients of a polynomial.
    18	    find_zero find x such that poly(x) = 0.
    19	    find_zero returns only only zero point, even if there are many.
    20	    Moreover, find_zero only takes list xs having even number of coefficients
    21	    and largest non zero coefficient as it guarantees
    22	    a solution.
    23	    >>> round(find_zero([1, 2]), 2) # f(x) = 1 + 2x
    24	    -0.5
    25	    >>> round(find_zero([-6, 11, -6, 1]), 2) # (x - 1) * (x - 2) * (x - 3) = -6 + 11x - 6x^2 + x^3
    26	    1.0
    27	    """
    28	    begin, end = -1., 1.
    29	    while poly(xs, begin) * poly(xs, end) > 0:
    30	        begin *= 2.0
    31	        end *= 2.0
    32	    while end - begin > 1e-10:
    33	        center = (begin + end) / 2.0
    34	        if poly(xs, center) * poly(xs, begin) > 0:
    35	            begin = center
    36	        else:
    37	            end = center
    38	    return begin
