+  --definition "$audit_source/audit-runtime-kompiled" \
+  --output none
+
+run kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition audit-verification-kompiled
