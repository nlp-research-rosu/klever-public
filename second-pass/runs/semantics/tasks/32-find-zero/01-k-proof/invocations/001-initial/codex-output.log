diff --git a/concrete_tests.py b/concrete_tests.py
new file mode 100644
index 0000000000000000000000000000000000000000..a1306bc238573ca6b2daf33e8a2f2fd083276aef
--- /dev/null
+++ b/concrete_tests.py
@@ -0,0 +1,27 @@
+import math
+
+
+def poly(xs: list, x: float):
+    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])
+
+
+def find_zero(xs: list):
+    begin = -1
+    end = 1
+
+    while poly(xs, begin) * poly(xs, end) > 0:
+        begin *= 2
+        end *= 2
+
+    while end - begin > 1e-10:
+        center = (begin + end) / 2
+        if poly(xs, center) * poly(xs, begin) > 0:
+            begin = center
+        else:
+            end = center
+
+    return begin
+
+
+assert round(find_zero([1, 2]), 2) == -0.5
+assert round(find_zero([-6, 11, -6, 1]), 2) == 1.0
