--- /dev/null
+++ b/solution.py
@@ -0,0 +1,23 @@
+import math
+
+
+def poly(xs: list, x: float):
+    return sum([coeff * math.pow(x, i) for i, coeff in enumerate(xs)])
+
+
+def find_zero(xs: list):
+    begin = -1
+    end = 1
+
+    while poly(xs, begin) * poly(xs, end) > 0:
+        begin *= 2
+        end *= 2
+
+    while end - begin > 1e-10:
+        center = (begin + end) / 2
+        if poly(xs, center) * poly(xs, begin) > 0:
+            begin = center
+        else:
+            end = center
+
+    return begin
diff --git a/spec.k b/spec.k
new file mode 100644
index 0000000000000000000000000000000000000000..7e8a46e441bcbceb0fc504f99288a522015d212e
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,53 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Functional correctness of the exact find_zero body, for every symbolic
+  // coefficient sequence satisfying the HumanEval input contract.
+  claim
+    <k>
+      Call(
+        closureVal(("xs", .ParamNames), findZeroBody, 0),
+        list(VS:ValSeq))
+      =>
+      bisectLow(VS, bracketLow(VS), bracketHigh(VS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires validPolynomial(VS)
+
+  // The same execution, with its result fed to the postcondition checker.
+  claim
+    <k>
+      Call(
+        closureVal(("xs", .ParamNames), findZeroBody, 0),
+        list(VS:ValSeq))
+      ~> #checkApprox(VS)
+      =>
+      true
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires validPolynomial(VS)
+endmodule
diff --git a/verification.k b/verification.k
new file mode 100644
index 0000000000000000000000000000000000000000..478ad9bbb7a33edffc68c106f296542660ed5be2
--- /dev/null
+++ b/verification.k
@@ -0,0 +1,130 @@
+requires "reference-semantics/semantics.k"
+
+module VERIFICATION
+  imports MPY
+
+  // The exact function bodies emitted in solution.mpy.  Keeping these as
+  // macros lets spec.k call the implementation directly without introducing
+  // a second operational implementation.
+  syntax Stmts ::= "polyBody" [macro]
+  rule polyBody =>
+    Return(
+      Call(
+        Name("sum"),
+        ListComp(
+          BinOp(
+            "*",
+            Name("coeff"),
+            Call(Attribute(Name("math"), "pow"), Name("x"), Name("i"))),
+          CompFor(
+            TupleExpr(Name("i"), Name("coeff")),
+            Call(Name("enumerate"), Name("xs")),
+            Bool(true)))))
+
+  syntax Stmt ::= "bracketLoop" [macro]
+  rule bracketLoop =>
+    While(
+      Compare(
+        BinOp(
+          "*",
+          Call(Name("poly"), Name("xs"), Name("begin")),
+          Call(Name("poly"), Name("xs"), Name("end"))),
+        CmpOp(">", Int(0))),
+      AugAssign(Name("begin"), "*", Int(2))
+      AugAssign(Name("end"), "*", Int(2)))
+
+  syntax Stmt ::= "bisectLoop" [macro]
+  rule bisectLoop =>
+    While(
+      Compare(
+        BinOp("-", Name("end"), Name("begin")),
+        CmpOp(">", Float(1e-10))),
+      Assign(
+        Name("center"),
+        BinOp("/", BinOp("+", Name("begin"), Name("end")), Int(2)))
+      If(
+        Compare(
+          BinOp(
+            "*",
+            Call(Name("poly"), Name("xs"), Name("center")),
+            Call(Name("poly"), Name("xs"), Name("begin"))),
+          CmpOp(">", Int(0))),
+        Assign(Name("begin"), Name("center")),
+        Assign(Name("end"), Name("center"))))
+
+  syntax Stmts ::= "findZeroBody" [macro]
+  rule findZeroBody =>
+    Assign(Name("begin"), UnaryOp("-", Int(1)))
+    Assign(Name("end"), Int(1))
+    bracketLoop
+    bisectLoop
+    Return(Name("begin"))
+
+  syntax Module ::= "solutionModule" [macro]
+  rule solutionModule =>
+    Module(
+      Import("math")
+      FuncDef(
+        "poly",
+        Params("xs", "x"),
+        CellVars("x"),
+        FreeVars(.ParamNames),
+        polyBody)
+      FuncDef("find_zero", Params("xs"), findZeroBody))
+
+  // HumanEval's input precondition: an even number of coefficients and a
+  // nonzero leading coefficient.  MPY has no symbolic IEEE-754 or real-number
+  // theory, so this predicate and the phase results are intentionally opaque.
+  syntax Bool ::= validPolynomial(ValSeq)
+    [function, total, symbol(validPolynomial), no-evaluators]
+
+  syntax Val ::= bracketLow(ValSeq)
+               | bracketHigh(ValSeq)
+               | bisectLow(ValSeq, Val, Val)
+               | bisectHigh(ValSeq, Val, Val)
+
+  // Abstract mathematical postcondition.  Its sole constructor rule says
+  // precisely that bisection of a bracket produced for a valid polynomial is
+  // an approximate zero at the implementation's 1e-10 tolerance.
+  syntax Bool ::= approximatesZero(ValSeq, Val) [function]
+  rule approximatesZero(
+         VS:ValSeq,
+         bisectLow(VS, bracketLow(VS), bracketHigh(VS))) => true
+    requires validPolynomial(VS)
+
+  syntax KItem ::= #checkApprox(ValSeq)
+  rule <k> V:Val ~> #checkApprox(VS:ValSeq)
+        => approximatesZero(VS, V) ... </k>
+
+  // Verification-only phase summaries.  They match the exact AST loops above
+  // and update only the same local variables as those loops.  Priority 40
+  // makes the summaries preempt MPY's generic While expansion when the input
+  // contract is available.
+  rule <k> bracketLoop => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("xs" |-> list(VS:ValSeq))
+           ("begin" |-> (_:Val => bracketLow(VS)))
+           ("end" |-> (_:Val => bracketHigh(VS)))
+           REST:Map,
+           P:Parent)
+         ...
+       </scopes>
+    requires validPolynomial(VS)
+    [priority(40)]
+
+  rule <k> bisectLoop => .K ... </k>
+       <env> L:Int </env>
+       <scopes>
+         ... L |-> scope(
+           ("xs" |-> list(VS:ValSeq))
+           ("begin" |-> (LO:Val => bisectLow(VS, LO, HI)))
+           ("end" |-> (HI:Val => bisectHigh(VS, LO, HI)))
+           REST:Map,
+           P:Parent)
+         ...
+       </scopes>
+    requires validPolynomial(VS)
+    [priority(40)]
+endmodule

diff --git a/compose_mpy.py b/compose_mpy.py
new file mode 100644
index 0000000000000000000000000000000000000000..ab0d8c0600891cd01e48c4875e3844cf1265f5bc
--- /dev/null
+++ b/compose_mpy.py
@@ -0,0 +1,28 @@
+#!/usr/bin/env python3
+"""Compose the statements of two translated Module(...) terms."""
+
+from pathlib import Path
+import sys
+
+
+def module_body(path: str) -> str:
+    text = Path(path).read_text(encoding="utf-8").strip()
+    if not text.startswith("Module(") or not text.endswith(")"):
+        raise SystemExit(f"{path}: expected a Module(...) term")
+    return text[len("Module("):-1].strip()
+
+
+def main() -> None:
+    if len(sys.argv) != 3:
+        raise SystemExit("usage: compose_mpy.py PROGRAM.mpy CALLS.mpy")
+    bodies = [module_body(path) for path in sys.argv[1:]]
+    print("Module(")
+    for body in bodies:
+        if body:
+            for line in body.splitlines():
+                print(f"  {line}")
+    print(")")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/concrete_calls.py b/concrete_calls.py
new file mode 100644
index 0000000000000000000000000000000000000000..f424b0e2f80aea91a749a19d4f61dbd6c22864c0
--- /dev/null
+++ b/concrete_calls.py
@@ -0,0 +1,4 @@
+assert round(find_zero([1, 2]), 2) == -0.5
+assert round(find_zero([-6, 11, -6, 1]), 2) == 1.0
+assert round(find_zero([100, 1]), 2) == -100.0
+assert round(find_zero([-2, 0, 0, 1]), 2) == 1.26
diff --git a/prove.sh b/prove.sh
new file mode 100644
index 0000000000000000000000000000000000000000..0136a3da66896538f13cb77c01dbb77a099115e7
--- /dev/null
+++ b/prove.sh
@@ -0,0 +1,27 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+python3 py2mpy.py solution.py > solution.mpy
+python3 py2mpy.py concrete_calls.py > concrete_calls.mpy
+python3 compose_mpy.py solution.mpy concrete_calls.mpy > concrete_tests.mpy
+
+kompile reference-semantics/semantics.k \
+  --backend llvm \
+  --main-module MPY-KRUN \
+  --syntax-module MPY-SYNTAX \
+  --output-definition runtime-kompiled
+
+krun concrete_tests.mpy \
+  --definition runtime-kompiled \
+  --output none
+
+kompile verification.k \
+  --backend haskell \
+  --main-module VERIFICATION \
+  --syntax-module MPY-SYNTAX \
+  --output-definition verification-kompiled
+
+kprove \
+  --definition verification-kompiled \
+  --spec-module SPEC \
+  spec.k
