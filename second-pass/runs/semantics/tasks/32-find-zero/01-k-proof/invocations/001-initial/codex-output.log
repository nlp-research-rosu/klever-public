+    <k>
+      Call(
+        closureVal(("xs", .ParamNames), findZeroBody, 0),
+        list(VS:ValSeq))
+      ~> #checkApprox(VS)
+      =>
+      true
+    </k>
+    <env> 0 </env>
+    <scopes>
