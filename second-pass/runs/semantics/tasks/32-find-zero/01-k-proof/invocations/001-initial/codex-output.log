new file mode 100644
index 0000000000000000000000000000000000000000..7593a6d31f7707a6afd2bf2eeae90ad7e1e079c2
--- /dev/null
+++ b/spec.k
@@ -0,0 +1,39 @@
+requires "verification.k"
+
+module SPEC
+  imports VERIFICATION
+
+  // Functional correctness of the exact find_zero body, for every symbolic
+  // coefficient sequence satisfying the HumanEval input contract.
+  claim
+    <k>
+      Call(
+        closureVal(("xs", .ParamNames), findZeroBody, 0),
+        list(VS:ValSeq))
+      =>
+      bisectLow(VS, bracketLow(VS), bracketHigh(VS))
+    </k>
+    <env> 0 </env>
+    <scopes>
+      0 |-> scope(.Map, parent(-1))
+      -1 |-> builtinsScope
+    </scopes>
+    <scopeLoc> 1 </scopeLoc>
+    <heap> .Map </heap>
+    <heapLoc> 0 </heapLoc>
+    <stack> .List </stack>
+    <ret> noRet </ret>
+    <exc> NoExc </exc>
+    <exit-code> 0 </exit-code>
+    requires validPolynomial(VS)
+
+  // The returned abstract value satisfies the declared approximate-root
+  // postcondition.
+  claim
+    approximatesZero(
+      VS:ValSeq,
+      bisectLow(VS, bracketLow(VS), bracketHigh(VS)))
+    =>
+    true
+    requires validPolynomial(VS)
+endmodule
