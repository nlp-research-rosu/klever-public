Module(
  Assert(
    Compare(
      Call(
        Name("round"),
        Call(Name("find_zero"), ListExpr(Int(1), Int(2))),
        Int(2)),
      CmpOp("==", UnaryOp("-", Float(0.5)))))
  Assert(
    Compare(
      Call(
        Name("round"),
        Call(
          Name("find_zero"),
          ListExpr(
            UnaryOp("-", Int(6)),
            Int(11),
            UnaryOp("-", Int(6)),
            Int(1))),
        Int(2)),
      CmpOp("==", Float(1.0)))))
