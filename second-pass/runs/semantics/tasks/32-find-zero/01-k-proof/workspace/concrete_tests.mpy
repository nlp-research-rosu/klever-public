Module(
  Import("math")
    FuncDef("poly", Params("xs", "x"), CellVars("x"), FreeVars(),
      Return(
        Call(
          Name("sum"),
          ListComp(BinOp(
            "*",
            Name("coeff"),
            Call(Attribute(Name("math"), "pow"), Name("x"), Name("i"))),
            CompFor(
              TupleExpr(Name("i"), Name("coeff")),
              Call(Name("enumerate"), Name("xs")),
              Bool(true))))))
    FuncDef("find_zero", Params("xs"),
      Assign(Name("begin"), UnaryOp("-", Int(1)))
      Assign(Name("end"), Int(1))
      While(Compare(
        BinOp(
          "*",
          Call(Name("poly"), Name("xs"), Name("begin")),
          Call(Name("poly"), Name("xs"), Name("end"))),
        CmpOp(">", Int(0))),
        AugAssign(Name("begin"), "*", Int(2))
        AugAssign(Name("end"), "*", Int(2)))
      While(Compare(
        BinOp("-", Name("end"), Name("begin")),
        CmpOp(">", Float(1e-10))),
        Assign(
          Name("center"),
          BinOp("/", BinOp("+", Name("begin"), Name("end")), Int(2)))
        If(Compare(
          BinOp(
            "*",
            Call(Name("poly"), Name("xs"), Name("center")),
            Call(Name("poly"), Name("xs"), Name("begin"))),
          CmpOp(">", Int(0))),
          Assign(Name("begin"), Name("center")),
          Assign(Name("end"), Name("center"))))
      Return(Name("begin")))
  Assert(
      Compare(
        Call(
          Name("round"),
          Call(Name("find_zero"), ListExpr(Int(1), Int(2))),
          Int(2)),
        CmpOp("==", UnaryOp("-", Float(0.5)))))
    Assert(
      Compare(
        Call(
          Name("round"),
          Call(
            Name("find_zero"),
            ListExpr(
              UnaryOp("-", Int(6)),
              Int(11),
              UnaryOp("-", Int(6)),
              Int(1))),
          Int(2)),
        CmpOp("==", Float(1.0))))
)
