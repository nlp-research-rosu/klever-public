Module(
  FuncDef("f", Params("xs"),
    Assign(Name("total"), Int(0))
    For(Name("x"), Name("xs"),
      If(Compare(Name("x"), CmpOp("<", Int(0))),
        Break,
        )
      AugAssign(Name("total"), "+", Name("x")))
    Return(Name("total")))
  Assert(
    Compare(
      Call(Name("f"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Int(6))))
  Assert(
    Compare(
      Call(
        Name("f"),
        ListExpr(Int(1), Int(2), UnaryOp("-", Int(1)), Int(5))),
      CmpOp("==", Int(3))))
  Assert(Compare(Call(Name("f"), ListExpr()), CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("f"), ListExpr(UnaryOp("-", Int(1)), Int(5))),
      CmpOp("==", Int(0)))))
