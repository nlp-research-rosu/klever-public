Module(
  Assign(Name("xs"), ListExpr(Int(3), Int(1), Int(2)))
  Assert(
    Compare(
      Call(
        Name("sorted"),
        Name("xs"),
        KwArg("key", Lambda(Params("x"), UnaryOp("-", Name("x"))))),
      CmpOp("==", ListExpr(Int(3), Int(2), Int(1)))))
  Assert(
    Compare(
      Call(Name("sorted"), Name("xs"), KwArg("reverse", Bool(true))),
      CmpOp("==", ListExpr(Int(3), Int(2), Int(1)))))
  Assert(
    Compare(
      Call(
        Name("sorted"),
        Name("xs"),
        KwArg("key", Lambda(Params("x"), Name("x")))),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(3)))))
  Assign(Name("ws"), ListExpr(Str("bbb"), Str("a"), Str("cc")))
  Assert(
    Compare(
      Call(Name("sorted"), Name("ws"), KwArg("key", Name("len"))),
      CmpOp("==", ListExpr(Str("a"), Str("cc"), Str("bbb")))))
  Assert(
    Compare(
      Call(
        Name("sorted"),
        Name("ws"),
        KwArg("key", Name("len")),
        KwArg("reverse", Bool(true))),
      CmpOp("==", ListExpr(Str("bbb"), Str("cc"), Str("a")))))
  Assign(Name("ps"), ListExpr(Str("ab"), Str("cd"), Str("aa")))
  Assert(
    Compare(
      Call(
        Name("sorted"),
        Name("ps"),
        KwArg("key", Lambda(Params("w"), Subscript(Name("w"), Int(0))))),
      CmpOp("==", ListExpr(Str("ab"), Str("aa"), Str("cd")))))
  Assign(Name("n"), Int(2))
  FuncDef("keyfn", Params("x"),
    Return(BinOp("%", Name("x"), Name("n"))))
  Assert(
    Compare(
      Call(
        Name("sorted"),
        ListExpr(Int(4), Int(3), Int(6), Int(1)),
        KwArg("key", Name("keyfn"))),
      CmpOp("==", ListExpr(Int(4), Int(6), Int(3), Int(1)))))
  Assert(
    Compare(
      Call(Attribute(Str("a.b.c"), "split"), KwArg("sep", Str("."))),
      CmpOp("==", ListExpr(Str("a"), Str("b"), Str("c"))))))
