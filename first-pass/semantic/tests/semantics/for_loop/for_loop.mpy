Module(
  Assign(Name("total"), Int(0))
  For(Name("x"), ListExpr(Int(1), Int(2), Int(3), Int(4)),
    AugAssign(Name("total"), "+", Name("x")))
  Assert(Compare(Name("total"), CmpOp("==", Int(10))))
  Assign(Name("count"), Int(0))
  For(Name("x"), ListExpr(),
    AugAssign(Name("count"), "+", Int(1)))
  Assert(Compare(Name("count"), CmpOp("==", Int(0)))))
