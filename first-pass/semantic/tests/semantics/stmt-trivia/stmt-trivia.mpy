Module(
  Expr(Str("Module docstring: a bare-expression statement."))
  ImportFrom("typing", "List", "Optional")
  Import("math")
  FuncDef("f", Params("xs"),
    Expr(Str("Function docstring."))
    Expr(BinOp("+", Int(3), Int(4)))
    Return(Call(Name("len"), Name("xs"))))
  Assert(
    Compare(
      Call(Name("f"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Int(3)))))
