Module(
  Assert(Compare(Call(Name("bin"), Int(5)), CmpOp("==", Str("0b101"))))
  Assert(Compare(Call(Name("bin"), Int(0)), CmpOp("==", Str("0b0"))))
  Assert(
    Compare(Call(Name("bin"), Int(12)), CmpOp("==", Str("0b1100"))))
  Assign(Name("total"), Int(0))
  For(Name("pair"), Call(Name("enumerate"), ListExpr(Int(10), Int(20), Int(30))),
    Assign(
      Name("total"),
      BinOp(
        "+",
        Name("total"),
        BinOp(
          "*",
          Subscript(Name("pair"), Int(0)),
          Subscript(Name("pair"), Int(1))))))
  Assert(Compare(Name("total"), CmpOp("==", Int(80))))
  For(TupleExpr(Name("i"), Name("v")), Call(Name("enumerate"), ListExpr(Int(5), Int(6))),
    Assign(
      Name("total"),
      BinOp("+", BinOp("+", Name("total"), Name("i")), Name("v"))))
  Assert(Compare(Name("total"), CmpOp("==", Int(92))))
  Assert(
    Compare(
      Call(Name("map"), Name("str"), ListExpr(Int(1), Int(22), Int(3))),
      CmpOp("is not", NoneVal)))
  Assign(
    Name("ss"),
    Call(Name("map"), Name("str"), ListExpr(Int(1), Int(22))))
  Assign(
    Name("joined"),
    Call(Attribute(Str("-"), "join"), Call(Name("list"), Name("ss"))))
  Assert(Compare(Name("joined"), CmpOp("==", Str("1-22"))))
  Assign(Name("c"), Int(0))
  AugAssign(Name("c"), "+", Compare(Int(1), CmpOp("==", Int(1))))
  AugAssign(Name("c"), "+", Compare(Int(1), CmpOp("==", Int(2))))
  Assert(Compare(Name("c"), CmpOp("==", Int(1))))
  Assert(Compare(Call(Name("int"), Int(7)), CmpOp("==", Int(7)))))
