Module(
  Assign(Name("r"), Int(0))
  For(Name("x"), ListExpr(Int(1), Int(2), Int(3), Int(4)),
    If(Compare(Name("x"), CmpOp("==", Int(3))),
      Break,
      )
    Assign(Name("r"), BinOp("+", Name("r"), Name("x"))))
  Assert(Compare(Name("r"), CmpOp("==", Int(3))))
  Assign(Name("s"), Int(0))
  For(Name("y"), ListExpr(Int(1), Int(2), Int(3), Int(4)),
    If(Compare(Name("y"), CmpOp("==", Int(2))),
      Continue,
      )
    Assign(Name("s"), BinOp("+", Name("s"), Name("y"))))
  Assert(Compare(Name("s"), CmpOp("==", Int(8))))
  Assign(Name("i"), Int(0))
  Assign(Name("t"), Int(0))
  While(Bool(true),
    If(Compare(Name("i"), CmpOp(">=", Int(3))),
      Break,
      )
    Assign(Name("t"), BinOp("+", Name("t"), Name("i")))
    Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
  Assert(Compare(Name("t"), CmpOp("==", Int(3))))
  Assign(Name("j"), Int(0))
  Assign(Name("u"), Int(0))
  While(Compare(Name("j"), CmpOp("<", Int(5))),
    Assign(Name("j"), BinOp("+", Name("j"), Int(1)))
    If(Compare(Name("j"), CmpOp("==", Int(3))),
      Continue,
      )
    Assign(Name("u"), BinOp("+", Name("u"), Name("j"))))
  Assert(Compare(Name("u"), CmpOp("==", Int(12))))
  Assign(Name("cnt"), Int(0))
  For(Name("a"), ListExpr(Int(1), Int(2)),
    For(Name("b"), ListExpr(Int(1), Int(2), Int(3)),
      If(Compare(Name("b"), CmpOp("==", Int(2))),
        Break,
        )
      Assign(Name("cnt"), BinOp("+", Name("cnt"), Int(1)))))
  Assert(Compare(Name("cnt"), CmpOp("==", Int(2))))
  FuncDef("f", Params("xs"),
    Assign(Name("total"), Int(0))
    For(Name("x"), Name("xs"),
      If(Compare(Name("x"), CmpOp("<", Int(0))),
        Break,
        )
      Assign(Name("total"), BinOp("+", Name("total"), Name("x"))))
    Return(Name("total")))
  Assert(
    Compare(
      Call(
        Name("f"),
        ListExpr(Int(1), Int(2), UnaryOp("-", Int(1)), Int(5))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("f"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Int(6))))
  FuncDef("first_pair", Params("xs", "target"),
    For(Name("a"), Name("xs"),
      For(Name("b"), Name("xs"),
        If(Compare(
          BinOp("+", Name("a"), Name("b")),
          CmpOp("==", Name("target"))),
          Return(BinOp("+", BinOp("*", Name("a"), Int(100)), Name("b"))),
          )))
    Return(UnaryOp("-", Int(1))))
  Assert(
    Compare(
      Call(Name("first_pair"), ListExpr(Int(1), Int(2), Int(3)), Int(5)),
      CmpOp("==", Int(203)))))
