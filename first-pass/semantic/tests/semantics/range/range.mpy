Module(
  Assign(Name("total"), Int(0))
  For(Name("i"), Call(Name("range"), Int(4)),
    AugAssign(Name("total"), "+", Name("i")))
  Assert(Compare(Name("total"), CmpOp("==", Int(6))))
  Assign(Name("t2"), Int(0))
  For(Name("i"), Call(Name("range"), Int(2), Int(5)),
    AugAssign(Name("t2"), "+", Name("i")))
  Assert(Compare(Name("t2"), CmpOp("==", Int(9))))
  Assign(Name("t3"), Int(0))
  For(Name("i"), Call(Name("range"), Int(0), Int(10), Int(2)),
    AugAssign(Name("t3"), "+", Name("i")))
  Assert(Compare(Name("t3"), CmpOp("==", Int(20))))
  Assign(Name("t4"), Int(0))
  For(Name("i"), Call(Name("range"), Int(5), Int(0), UnaryOp("-", Int(1))),
    AugAssign(Name("t4"), "+", Name("i")))
  Assert(Compare(Name("t4"), CmpOp("==", Int(15))))
  Assign(Name("t5"), Int(0))
  For(Name("i"), Call(Name("range"), Int(3), Int(3)),
    AugAssign(Name("t5"), "+", Name("i")))
  Assert(Compare(Name("t5"), CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("sum"), Call(Name("range"), Int(4))),
      CmpOp("==", Int(6))))
  Assert(
    Compare(
      Call(Name("len"), Call(Name("range"), Int(4))),
      CmpOp("==", Int(4)))))
