Module(
  Assert(
    Compare(Call(Name("eval"), Str("2 + 3 * 4")), CmpOp("==", Int(14))))
  Assert(
    Compare(
      Call(Name("eval"), Str("2 ** 3 ** 2")),
      CmpOp("==", Int(512))))
  Assert(
    Compare(Call(Name("eval"), Str("10 - 2 - 3")), CmpOp("==", Int(5))))
  Assert(
    Compare(Call(Name("eval"), Str("7 // 2 - 1")), CmpOp("==", Int(2))))
  Assert(
    Compare(Call(Name("eval"), Str("5 * 2 ** 3")), CmpOp("==", Int(40))))
  Assert(
    Compare(
      Call(Name("eval"), Str("100 // 7 // 2")),
      CmpOp("==", Int(7))))
  Assert(
    Compare(
      Call(Name("eval"), Str("1 + 2 - 3 * 4 // 5")),
      CmpOp("==", Int(1))))
  Assign(Name("expression"), Call(Name("str"), Int(6)))
  Assign(
    Name("expression"),
    BinOp(
      "+",
      BinOp("+", Name("expression"), Str("*")),
      Call(Name("str"), Int(3))))
  Assert(
    Compare(
      Call(Name("eval"), Name("expression")),
      CmpOp("==", Int(18)))))
