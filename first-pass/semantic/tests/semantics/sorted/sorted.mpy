Module(
  Assert(
    Compare(
      Call(Name("sorted"), ListExpr(Int(3), Int(1), Int(2), Int(1))),
      CmpOp("==", ListExpr(Int(1), Int(1), Int(2), Int(3)))))
  Assert(
    Compare(Call(Name("sorted"), ListExpr()), CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("sorted"), ListExpr(Int(5))),
      CmpOp("==", ListExpr(Int(5)))))
  Assert(
    Compare(
      Call(
        Name("sorted"),
        ListExpr(
          UnaryOp("-", Int(2)),
          Int(4),
          UnaryOp("-", Int(1)),
          Int(0),
          Int(4))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(1)),
          Int(0),
          Int(4),
          Int(4)))))
  Assert(
    Compare(
      Call(
        Name("sorted"),
        ListExpr(Int(10), Int(9), Int(8), Int(7), Int(6))),
      CmpOp("==", ListExpr(Int(6), Int(7), Int(8), Int(9), Int(10))))))
