Module(
  Assert(
    Compare(BinOp("+", Str("ab"), Str("cd")), CmpOp("==", Str("abcd"))))
  Assert(Compare(Str("hello"), CmpOp("==", Str("hello"))))
  Assert(Compare(Str("hello"), CmpOp("!=", Str("world"))))
  Assert(Compare(Str("a"), CmpOp("in", Str("banana"))))
  Assert(Compare(Str("z"), CmpOp("not in", Str("banana"))))
  Assign(Name("vowels"), Int(0))
  For(Name("c"), Str("education"),
    If(Compare(Name("c"), CmpOp("in", Str("aeiou"))),
      AugAssign(Name("vowels"), "+", Int(1)),
      ))
  Assert(Compare(Name("vowels"), CmpOp("==", Int(5))))
  Assign(Name("out"), Str(""))
  For(Name("c"), Str("abc"),
    Assign(
      Name("out"),
      BinOp("+", BinOp("+", Name("out"), Name("c")), Name("c"))))
  Assert(Compare(Name("out"), CmpOp("==", Str("aabbcc")))))
