Module(
  Assert(
    Compare(
      BinOp("+", ListExpr(Int(1), Int(2)), ListExpr(Int(3))),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(3)))))
  Assert(
    Compare(
      BinOp("+", ListExpr(Str("a"), Str("b")), ListExpr(Str("c"))),
      CmpOp("==", ListExpr(Str("a"), Str("b"), Str("c")))))
  Assert(
    Compare(
      ListExpr(Int(1), Int(2), Int(3)),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(3)))))
  Assert(
    Compare(
      ListExpr(Int(1), Int(2)),
      CmpOp("!=", ListExpr(Int(1), Int(3)))))
  Assert(Compare(Int(2), CmpOp("in", ListExpr(Int(1), Int(2), Int(3)))))
  Assert(
    Compare(Int(5), CmpOp("not in", ListExpr(Int(1), Int(2), Int(3)))))
  Assert(
    Compare(
      Str("b"),
      CmpOp("in", ListExpr(Str("a"), Str("b"), Str("c")))))
  Assign(Name("joined"), Str(""))
  For(Name("w"), ListExpr(Str("foo"), Str("bar"), Str("baz")),
    Assign(Name("joined"), BinOp("+", Name("joined"), Name("w"))))
  Assert(Compare(Name("joined"), CmpOp("==", Str("foobarbaz")))))
