Module(
  Assert(Compare(Int(3), CmpOp("<", Int(5))))
  Assert(Compare(Int(5), CmpOp("<=", Int(5))))
  Assert(Compare(Int(7), CmpOp(">", Int(3))))
  Assert(Compare(Int(7), CmpOp(">=", Int(7))))
  Assert(Compare(Int(4), CmpOp("==", Int(4))))
  Assert(Compare(Int(4), CmpOp("!=", Int(5))))
  Assert(Compare(Bool(true), CmpOp("==", Bool(true))))
  Assert(Compare(Bool(false), CmpOp("==", Bool(false)))))
