Module(
  Assert(Call(Attribute(Str("ABC"), "isupper"), ))
  Assert(UnaryOp("not", Call(Attribute(Str("ABc"), "isupper"), )))
  Assert(UnaryOp("not", Call(Attribute(Str("123"), "isupper"), )))
  Assert(UnaryOp("not", Call(Attribute(Str(""), "isupper"), )))
  Assert(Call(Attribute(Str("abc"), "islower"), ))
  Assert(UnaryOp("not", Call(Attribute(Str("aBc"), "islower"), )))
  Assert(Call(Attribute(Str("abc"), "isalpha"), ))
  Assert(UnaryOp("not", Call(Attribute(Str("ab1"), "isalpha"), )))
  Assert(UnaryOp("not", Call(Attribute(Str(""), "isalpha"), )))
  Assert(Call(Attribute(Str("123"), "isdigit"), ))
  Assert(UnaryOp("not", Call(Attribute(Str("12a"), "isdigit"), )))
  Assert(
    Compare(
      Call(Attribute(Str("AbC"), "lower"), ),
      CmpOp("==", Str("abc"))))
  Assert(
    Compare(
      Call(Attribute(Str("AbC"), "upper"), ),
      CmpOp("==", Str("ABC"))))
  Assert(
    Compare(
      Call(Attribute(Str("AbC"), "swapcase"), ),
      CmpOp("==", Str("aBc"))))
  Assert(Call(Attribute(Str("abcdef"), "startswith"), Str("abc")))
  Assert(
    UnaryOp(
      "not",
      Call(Attribute(Str("abcdef"), "startswith"), Str("xyz"))))
  Assert(Call(Attribute(Str("abc"), "startswith"), Str("")))
  Assert(
    UnaryOp("not", Call(Attribute(Str("ab"), "startswith"), Str("abc"))))
  Assign(Name("u"), Int(0))
  For(Name("c"), Str("aB3cD"),
    If(Call(Attribute(Name("c"), "isupper"), ),
      Assign(Name("u"), BinOp("+", Name("u"), Int(1))),
      ))
  Assert(Compare(Name("u"), CmpOp("==", Int(2)))))
