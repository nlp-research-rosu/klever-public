Module(
  Assign(Name("t"), TupleExpr(Int(1), Int(2), Int(3), Int(2)))
  Assert(Compare(Int(2), CmpOp("in", Name("t"))))
  Assert(Compare(Int(5), CmpOp("not in", Name("t"))))
  Assert(
    Compare(
      Call(Attribute(Name("t"), "index"), Int(2)),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Attribute(Name("t"), "index"), Int(3)),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Subscript(Name("t"), Slice(Int(1), Int(3), NoBound)),
      CmpOp("==", TupleExpr(Int(2), Int(3)))))
  Assert(
    Compare(
      Subscript(Name("t"), Slice(NoBound, Int(2), NoBound)),
      CmpOp("==", TupleExpr(Int(1), Int(2)))))
  Assert(
    Compare(
      Subscript(Name("t"), Slice(Int(2), NoBound, NoBound)),
      CmpOp("==", TupleExpr(Int(3), Int(2)))))
  Assign(Name("u"), TupleExpr(Str("a"), Str("b")))
  Assert(Compare(Str("a"), CmpOp("in", Name("u"))))
  Assert(
    Compare(
      Call(Attribute(Name("u"), "index"), Str("b")),
      CmpOp("==", Int(1)))))
