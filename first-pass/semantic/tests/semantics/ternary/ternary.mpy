Module(
  Assert(
    Compare(IfExp(Bool(true), Int(1), Int(2)), CmpOp("==", Int(1))))
  Assert(
    Compare(IfExp(Bool(false), Int(1), Int(2)), CmpOp("==", Int(2))))
  Assert(
    Compare(
      IfExp(Compare(Int(1), CmpOp("<", Int(2))), Str("yes"), Str("no")),
      CmpOp("==", Str("yes"))))
  Assign(Name("x"), Int(5))
  Assert(
    Compare(
      IfExp(
        Compare(Name("x"), CmpOp(">", Int(0))),
        Name("x"),
        UnaryOp("-", Name("x"))),
      CmpOp("==", Int(5))))
  Assign(Name("y"), UnaryOp("-", Int(3)))
  Assert(
    Compare(
      IfExp(
        Compare(Name("y"), CmpOp(">", Int(0))),
        Name("y"),
        UnaryOp("-", Name("y"))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      IfExp(
        Bool(true),
        IfExp(Bool(false), Str("a"), Str("b")),
        Str("c")),
      CmpOp("==", Str("b"))))
  Assign(Name("z"), NoneVal)
  Assert(
    Compare(
      IfExp(Compare(Name("z"), CmpOp("is", NoneVal)), Int(0), Name("z")),
      CmpOp("==", Int(0)))))
