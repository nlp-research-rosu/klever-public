Module(
  Assign(
    Name("d"),
    DictExpr(Entry(Str("a"), Int(1)), Entry(Str("b"), Int(2))))
  Assert(Compare(Subscript(Name("d"), Str("a")), CmpOp("==", Int(1))))
  Assert(Compare(Subscript(Name("d"), Str("b")), CmpOp("==", Int(2))))
  Assign(Subscript(Name("d"), Str("c")), Int(3))
  Assert(Compare(Subscript(Name("d"), Str("c")), CmpOp("==", Int(3))))
  Assign(
    Name("n"),
    DictExpr(Entry(Int(1), Str("one")), Entry(Int(2), Str("two"))))
  Assert(Compare(Subscript(Name("n"), Int(2)), CmpOp("==", Str("two"))))
  Assign(Name("xs"), ListExpr())
  Expr(
    Call(
      Attribute(Name("xs"), "append"),
      Subscript(Name("d"), Str("a"))))
  Assert(Compare(Name("xs"), CmpOp("==", ListExpr(Int(1))))))
