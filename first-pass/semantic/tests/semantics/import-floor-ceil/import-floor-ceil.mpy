Module(
  ImportFrom("math", "floor", "ceil")
  Assert(Compare(Call(Name("floor"), Float(2.5)), CmpOp("==", Int(2))))
  Assert(Compare(Call(Name("ceil"), Float(2.5)), CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("floor"), UnaryOp("-", Float(2.5))),
      CmpOp("==", UnaryOp("-", Int(3)))))
  Assert(
    Compare(
      Call(Name("ceil"), UnaryOp("-", Float(2.5))),
      CmpOp("==", UnaryOp("-", Int(2)))))
  Assert(Compare(Call(Name("floor"), Int(4)), CmpOp("==", Int(4))))
  Assert(Compare(Call(Name("ceil"), Int(4)), CmpOp("==", Int(4)))))
