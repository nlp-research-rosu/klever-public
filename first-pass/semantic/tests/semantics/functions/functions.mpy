Module(
  FuncDef("inc", Params("n"),
    Return(BinOp("+", Name("n"), Int(1))))
  FuncDef("sub", Params("a", "b"),
    Return(BinOp("-", Name("a"), Name("b"))))
  FuncDef("sign", Params("x"),
    If(Compare(Name("x"), CmpOp(">", Int(0))),
      Return(Int(1)),
      )
    If(Compare(Name("x"), CmpOp("<", Int(0))),
      Return(UnaryOp("-", Int(1))),
      )
    Return(Int(0)))
  Assert(Compare(Call(Name("inc"), Int(4)), CmpOp("==", Int(5))))
  Assert(
    Compare(Call(Name("sub"), Int(10), Int(3)), CmpOp("==", Int(7))))
  Assert(Compare(Call(Name("sign"), Int(5)), CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("sign"), UnaryOp("-", Int(2))),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(Compare(Call(Name("sign"), Int(0)), CmpOp("==", Int(0)))))
