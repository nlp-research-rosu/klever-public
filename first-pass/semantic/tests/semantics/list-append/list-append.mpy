Module(
  Assign(Name("result"), ListExpr())
  Assign(Name("i"), Int(0))
  For(Name("i"), Call(Name("range"), Int(5)),
    Expr(
      Call(
        Attribute(Name("result"), "append"),
        BinOp("*", Name("i"), Name("i")))))
  Assert(
    Compare(
      Name("result"),
      CmpOp("==", ListExpr(Int(0), Int(1), Int(4), Int(9), Int(16)))))
  Assign(Name("xs"), ListExpr(Int(3), Int(1), Int(2)))
  Expr(Call(Attribute(Name("xs"), "sort"), ))
  Assert(
    Compare(Name("xs"), CmpOp("==", ListExpr(Int(1), Int(2), Int(3)))))
  Assign(Name("ys"), ListExpr(Int(0), Int(0), Int(0)))
  Assign(Name("j"), Int(0))
  For(Name("j"), Call(Name("range"), Int(3)),
    Assign(
      Subscript(Name("ys"), Name("j")),
      BinOp("+", Name("j"), Int(1))))
  Assert(
    Compare(Name("ys"), CmpOp("==", ListExpr(Int(1), Int(2), Int(3)))))
  Assert(
    Compare(
      Subscript(Name("ys"), UnaryOp("-", Int(1))),
      CmpOp("==", Int(3))))
  Assign(Name("zs"), ListExpr(Int(10)))
  Expr(
    Call(
      Attribute(Name("zs"), "append"),
      Call(Name("sum"), Name("result"))))
  Assert(Compare(Name("zs"), CmpOp("==", ListExpr(Int(10), Int(30)))))
  Assert(Compare(Call(Name("len"), Name("zs")), CmpOp("==", Int(2)))))
