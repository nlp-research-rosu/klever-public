Module(
  Assign(Name("t"), TupleExpr(Int(1), Int(2)))
  Assert(Compare(Name("t"), CmpOp("==", TupleExpr(Int(1), Int(2)))))
  Assert(
    Compare(
      TupleExpr(Int(1), Int(2)),
      CmpOp("!=", TupleExpr(Int(1), Int(3)))))
  Assign(TupleExpr(Name("a"), Name("b")), Name("t"))
  Assert(Compare(Name("a"), CmpOp("==", Int(1))))
  Assert(Compare(Name("b"), CmpOp("==", Int(2))))
  Assign(TupleExpr(Name("m"), Name("n")), TupleExpr(Int(3), Int(4)))
  Assert(Compare(BinOp("+", Name("m"), Name("n")), CmpOp("==", Int(7))))
  Assign(TupleExpr(Name("x"), Name("y")), ListExpr(Int(5), Int(6)))
  Assert(
    BoolOp(
      "and",
      Compare(Name("x"), CmpOp("==", Int(5))),
      Compare(Name("y"), CmpOp("==", Int(6)))))
  Assign(Name("total"), Int(0))
  For(TupleExpr(Name("p"), Name("q")), ListExpr(TupleExpr(Int(1), Int(2)), TupleExpr(Int(3), Int(4))),
    Assign(
      Name("total"),
      BinOp("+", Name("total"), BinOp("*", Name("p"), Name("q")))))
  Assert(Compare(Name("total"), CmpOp("==", Int(14))))
  FuncDef("pair", Params(),
    Return(TupleExpr(Int(7), Int(8))))
  Assign(TupleExpr(Name("u"), Name("v")), Call(Name("pair"), ))
  Assert(Compare(Name("u"), CmpOp("==", Int(7))))
  Assert(Compare(Name("v"), CmpOp("==", Int(8)))))
