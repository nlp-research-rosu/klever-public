Module(
  Assign(Name("r"), ListExpr())
  For(TupleExpr(Name("x"), Name("y")), Call(
    Name("zip"),
    ListExpr(Int(1), Int(2), Int(3)),
    ListExpr(Int(10), Int(20), Int(30))),
    Assign(
      Name("r"),
      BinOp("+", Name("r"), ListExpr(BinOp("+", Name("x"), Name("y"))))))
  Assert(
    Compare(Name("r"), CmpOp("==", ListExpr(Int(11), Int(22), Int(33)))))
  Assign(Name("r2"), ListExpr())
  For(TupleExpr(Name("x"), Name("y")), Call(
    Name("zip"),
    ListExpr(Int(1), Int(2), Int(3), Int(4)),
    ListExpr(Int(10), Int(20))),
    Assign(
      Name("r2"),
      BinOp("+", Name("r2"), ListExpr(BinOp("+", Name("x"), Name("y"))))))
  Assert(Compare(Name("r2"), CmpOp("==", ListExpr(Int(11), Int(22)))))
  Assign(Name("r3"), ListExpr())
  For(TupleExpr(Name("x"), Name("y")), Call(Name("zip"), ListExpr(), ListExpr(Int(1), Int(2))),
    Assign(Name("r3"), BinOp("+", Name("r3"), ListExpr(Name("x")))))
  Assert(Compare(Name("r3"), CmpOp("==", ListExpr())))
  Assign(Name("rs"), Str(""))
  For(TupleExpr(Name("x"), Name("y")), Call(Name("zip"), Str("abc"), Str("xyz")),
    If(Compare(Name("x"), CmpOp("==", Name("y"))),
      Assign(Name("rs"), BinOp("+", Name("rs"), Str("="))),
      Assign(Name("rs"), BinOp("+", Name("rs"), Str("!")))))
  Assert(Compare(Name("rs"), CmpOp("==", Str("!!!")))))
