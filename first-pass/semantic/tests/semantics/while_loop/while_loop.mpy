Module(
  Assign(Name("i"), Int(0))
  Assign(Name("total"), Int(0))
  While(Compare(Name("i"), CmpOp("<", Int(5))),
    Assign(Name("total"), BinOp("+", Name("total"), Name("i")))
    Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
  Assert(Compare(Name("total"), CmpOp("==", Int(10))))
  Assert(Compare(Name("i"), CmpOp("==", Int(5))))
  FuncDef("first_ge", Params("n"),
    Assign(Name("k"), Int(0))
    While(Bool(true),
      If(Compare(BinOp("*", Name("k"), Name("k")), CmpOp(">=", Name("n"))),
        Return(Name("k")),
        )
      Assign(Name("k"), BinOp("+", Name("k"), Int(1)))))
  Assert(Compare(Call(Name("first_ge"), Int(10)), CmpOp("==", Int(4))))
  Assert(Compare(Call(Name("first_ge"), Int(0)), CmpOp("==", Int(0))))
  Assign(Name("j"), Int(0))
  While(Compare(Name("j"), CmpOp(">", Int(0))),
    Assign(Name("j"), BinOp("-", Name("j"), Int(1))))
  Assert(Compare(Name("j"), CmpOp("==", Int(0)))))
