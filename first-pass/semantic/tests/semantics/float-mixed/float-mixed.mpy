Module(
  Import("math")
  Assert(
    Compare(
      Call(Attribute(Name("math"), "floor"), Float(2.7)),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Attribute(Name("math"), "floor"), UnaryOp("-", Float(2.3))),
      CmpOp("==", UnaryOp("-", Int(3)))))
  Assert(
    Compare(
      Call(Attribute(Name("math"), "ceil"), Float(2.1)),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Attribute(Name("math"), "pow"), Int(2), Int(3)),
      CmpOp("==", Float(8.0))))
  Assert(
    Compare(BinOp("**", Int(2), Float(0.5)), CmpOp(">", Float(1.4))))
  Assert(
    Compare(BinOp("**", Int(2), Float(0.5)), CmpOp("<", Float(1.5))))
  Assert(
    Compare(BinOp("**", Int(9), Float(0.5)), CmpOp("==", Float(3.0))))
  Assert(
    Compare(BinOp("+", Int(1), Float(0.5)), CmpOp("==", Float(1.5))))
  Assert(
    Compare(BinOp("+", Float(0.5), Int(1)), CmpOp("==", Float(1.5))))
  Assert(
    Compare(BinOp("*", Int(2), Float(0.25)), CmpOp("==", Float(0.5))))
  Assert(
    Compare(BinOp("-", Int(3), Float(0.5)), CmpOp("==", Float(2.5))))
  Assert(Compare(Int(1), CmpOp("==", Float(1.0))))
  Assert(Compare(Float(1.0), CmpOp("==", Int(1))))
  Assert(Compare(Int(2), CmpOp("!=", Float(1.5))))
  Assert(Compare(Int(1), CmpOp("<", Float(1.5))))
  Assert(Compare(Float(1.5), CmpOp(">", Int(1))))
  Assert(
    Compare(Call(Name("float"), Str("3.25")), CmpOp("==", Float(3.25))))
  Assert(
    Compare(
      Call(Name("float"), Str("-1.5")),
      CmpOp("==", UnaryOp("-", Float(1.5)))))
  Assert(
    Compare(Call(Name("float"), Str("7")), CmpOp("==", Float(7.0))))
  Assert(Compare(Call(Name("float"), Int(3)), CmpOp("==", Float(3.0))))
  Assign(Name("x"), NoneVal)
  Assert(Compare(Name("x"), CmpOp("==", NoneVal)))
  Assign(Name("y"), Int(5))
  Assert(Compare(Name("y"), CmpOp("!=", NoneVal)))
  Assert(
    Compare(
      Call(Name("int"), Call(Name("round"), Float(2.6))),
      CmpOp("==", Int(3)))))
