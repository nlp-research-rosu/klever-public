Module(
  Assign(Name("x"), Int(5))
  Assert(Compare(Name("x"), CmpOp("==", Int(5))))
  Assign(Name("x"), BinOp("+", Name("x"), Int(10)))
  Assert(Compare(Name("x"), CmpOp("==", Int(15))))
  Assign(Name("y"), Int(100))
  AugAssign(Name("y"), "+", Int(1))
  Assert(Compare(Name("y"), CmpOp("==", Int(101))))
  AugAssign(Name("y"), "-", Int(50))
  Assert(Compare(Name("y"), CmpOp("==", Int(51)))))
