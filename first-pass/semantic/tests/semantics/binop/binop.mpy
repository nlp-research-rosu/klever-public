Module(
  Assert(Compare(BinOp("+", Int(2), Int(3)), CmpOp("==", Int(5))))
  Assert(
    Compare(
      BinOp("-", Int(5), Int(8)),
      CmpOp("==", UnaryOp("-", Int(3)))))
  Assert(Compare(BinOp("*", Int(6), Int(7)), CmpOp("==", Int(42))))
  Assert(
    Compare(
      BinOp("%", UnaryOp("-", Int(7)), Int(3)),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      BinOp("%", Int(7), UnaryOp("-", Int(3))),
      CmpOp("==", UnaryOp("-", Int(2)))))
  Assert(
    Compare(
      BinOp("%", UnaryOp("-", Int(7)), UnaryOp("-", Int(3))),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(Compare(BinOp("%", Int(7), Int(3)), CmpOp("==", Int(1))))
  Assert(
    Compare(
      BinOp("//", UnaryOp("-", Int(7)), Int(3)),
      CmpOp("==", UnaryOp("-", Int(3)))))
  Assert(
    Compare(
      BinOp("//", Int(7), UnaryOp("-", Int(3))),
      CmpOp("==", UnaryOp("-", Int(3)))))
  Assert(
    Compare(
      BinOp("//", UnaryOp("-", Int(7)), UnaryOp("-", Int(3))),
      CmpOp("==", Int(2))))
  Assert(Compare(BinOp("//", Int(7), Int(3)), CmpOp("==", Int(2))))
  Assert(Compare(BinOp("**", Int(2), Int(5)), CmpOp("==", Int(32))))
  Assert(Compare(BinOp("**", Int(3), Int(3)), CmpOp("==", Int(27))))
  Assert(Compare(BinOp("**", Int(2), Int(0)), CmpOp("==", Int(1))))
  Assert(Compare(BinOp("**", Int(0), Int(0)), CmpOp("==", Int(1))))
  Assert(Compare(BinOp("**", Int(0), Int(5)), CmpOp("==", Int(0))))
  Assert(Compare(BinOp("**", Int(10), Int(3)), CmpOp("==", Int(1000))))
  Assert(
    Compare(
      BinOp("**", UnaryOp("-", Int(2)), Int(2)),
      CmpOp("==", Int(4))))
  Assert(
    Compare(
      BinOp("**", UnaryOp("-", Int(2)), Int(3)),
      CmpOp("==", UnaryOp("-", Int(8))))))
