Module(
  Assign(Name("a"), NoneVal)
  Assert(Compare(Name("a"), CmpOp("is", NoneVal)))
  Assert(
    Compare(
      Compare(Name("a"), CmpOp("is not", NoneVal)),
      CmpOp("==", Bool(false))))
  Assign(Name("b"), Int(5))
  Assert(Compare(Name("b"), CmpOp("is not", NoneVal)))
  Assert(
    Compare(
      Compare(Name("b"), CmpOp("is", NoneVal)),
      CmpOp("==", Bool(false))))
  Assert(UnaryOp("not", NoneVal))
  FuncDef("f", Params("x"),
    If(Compare(Name("x"), CmpOp("is", NoneVal)),
      Return(UnaryOp("-", Int(1))),
      )
    Return(Name("x")))
  Assert(
    Compare(Call(Name("f"), NoneVal), CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(Compare(Call(Name("f"), Int(7)), CmpOp("==", Int(7)))))
