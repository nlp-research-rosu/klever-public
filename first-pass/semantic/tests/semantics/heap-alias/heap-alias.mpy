Module(
  Assign(Name("a"), ListExpr(Int(1)))
  Assign(Name("b"), Name("a"))
  Expr(Call(Attribute(Name("b"), "append"), Int(2)))
  Assert(Compare(Name("a"), CmpOp("==", ListExpr(Int(1), Int(2)))))
  Assert(Compare(Name("b"), CmpOp("==", Name("a"))))
  FuncDef("extend_it", Params("xs"),
    Expr(Call(Attribute(Name("xs"), "append"), Int(9))))
  Assign(Name("c"), ListExpr(Int(3), Int(4)))
  Expr(Call(Name("extend_it"), Name("c")))
  Assert(
    Compare(Name("c"), CmpOp("==", ListExpr(Int(3), Int(4), Int(9)))))
  Assign(Name("d"), BinOp("+", Name("c"), ListExpr(Int(5))))
  Expr(Call(Attribute(Name("d"), "append"), Int(6)))
  Assert(
    Compare(Name("c"), CmpOp("==", ListExpr(Int(3), Int(4), Int(9)))))
  Assert(
    Compare(
      Name("d"),
      CmpOp("==", ListExpr(Int(3), Int(4), Int(9), Int(5), Int(6))))))
