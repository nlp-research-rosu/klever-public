Module(
  FuncDef("make_counter", Params(),
    FuncDef("bump", Params("d"), CellVars(), FreeVars(),
      Return(BinOp("+", Name("d"), Int(1))))
    Return(Name("bump")))
  FuncDef("make_adder", Params("n"), CellVars("n"), FreeVars(),
    FuncDef("add", Params("x"), CellVars(), FreeVars("n"),
      Return(BinOp("+", Name("x"), Name("n"))))
    Return(Name("add")))
  FuncDef("helper", Params("y"),
    Return(BinOp("*", Name("y"), Int(10))))
  FuncDef("uses_global", Params("x"), CellVars("x"), FreeVars(),
    FuncDef("g", Params("y"), CellVars(), FreeVars("x"),
      Return(BinOp("+", Call(Name("helper"), Name("y")), Name("x"))))
    Return(Name("g")))
  FuncDef("late", Params(), CellVars("i"), FreeVars(),
    Assign(Name("fs"), ListExpr())
    Assign(Name("i"), Int(0))
    For(Name("i"), Call(Name("range"), Int(3)),
      Expr(
        Call(
          Attribute(Name("fs"), "append"),
          Lambda(Params(), CellVars(), FreeVars("i"), Name("i")))))
    Return(
      BinOp(
        "+",
        BinOp(
          "+",
          Call(Subscript(Name("fs"), Int(0)), ),
          Call(Subscript(Name("fs"), Int(1)), )),
        Call(Subscript(Name("fs"), Int(2)), ))))
  FuncDef("shared_pair", Params(), CellVars("v"), FreeVars(),
    Assign(Name("v"), Int(7))
    FuncDef("geta", Params(), CellVars(), FreeVars("v"),
      Return(Name("v")))
    FuncDef("getb", Params(), CellVars(), FreeVars("v"),
      Return(BinOp("+", Name("v"), Int(1))))
    Return(BinOp("+", Call(Name("geta"), ), Call(Name("getb"), ))))
  Assign(Name("f"), Call(Name("make_counter"), ))
  Assert(Compare(Call(Name("f"), Int(1)), CmpOp("==", Int(2))))
  Assign(Name("add3"), Call(Name("make_adder"), Int(3)))
  Assert(Compare(Call(Name("add3"), Int(4)), CmpOp("==", Int(7))))
  Assign(Name("g5"), Call(Name("uses_global"), Int(5)))
  Assert(Compare(Call(Name("g5"), Int(2)), CmpOp("==", Int(25))))
  Assert(Compare(Call(Name("late"), ), CmpOp("==", Int(6))))
  Assert(Compare(Call(Name("shared_pair"), ), CmpOp("==", Int(15))))
  Assert(
    Compare(
      ListComp(Name("e"),
        CompFor(
          Name("e"),
          ListExpr(Int(1), Int(2), Int(3)),
          Compare(Name("e"), CmpOp(">", Int(1))))),
      CmpOp("==", ListExpr(Int(2), Int(3))))))
