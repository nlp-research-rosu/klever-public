Module(
  Assert(Compare(Str("abc"), CmpOp("in", Str("xxabcyy"))))
  Assert(
    UnaryOp("not", Compare(Str("abc"), CmpOp("in", Str("xxabyy")))))
  Assert(Compare(Str(""), CmpOp("in", Str("anything"))))
  Assert(Compare(Str("a"), CmpOp("in", Str("cat"))))
  Assert(UnaryOp("not", Compare(Str("z"), CmpOp("in", Str("cat")))))
  Assert(Compare(Str("cat"), CmpOp("in", Str("cat"))))
  Assert(UnaryOp("not", Compare(Str("cats"), CmpOp("in", Str("cat")))))
  Assert(
    Compare(
      Compare(Str("bc"), CmpOp("in", Str("abcd"))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Compare(Str("q"), CmpOp("not in", Str("abc"))),
      CmpOp("==", Bool(true)))))
