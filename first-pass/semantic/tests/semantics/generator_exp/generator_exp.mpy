Module(
  Assert(
    Compare(
      Call(
        Name("sum"),
        GenExp(Name("x"),
          CompFor(
            Name("x"),
            ListExpr(Int(1), Int(2), Int(3)),
            Bool(true)))),
      CmpOp("==", Int(6))))
  Assert(
    Compare(
      Call(
        Name("sum"),
        GenExp(BinOp("*", Name("x"), Name("x")),
          CompFor(
            Name("x"),
            ListExpr(Int(1), Int(2), Int(3)),
            Bool(true)))),
      CmpOp("==", Int(14))))
  Assert(
    Compare(
      Call(
        Name("sum"),
        GenExp(Compare(Name("x"), CmpOp(">", Int(0))),
          CompFor(
            Name("x"),
            ListExpr(
              Int(1),
              UnaryOp("-", Int(1)),
              Int(2),
              UnaryOp("-", Int(3))),
            Bool(true)))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(
        Name("sum"),
        GenExp(Name("i"),
          CompFor(Name("i"), Call(Name("range"), Int(5)), Bool(true)))),
      CmpOp("==", Int(10))))
  Assert(
    Call(
      Name("all"),
      GenExp(Compare(Name("x"), CmpOp(">", Int(0))),
        CompFor(Name("x"), ListExpr(Int(1), Int(2), Int(3)), Bool(true)))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("all"),
        GenExp(Compare(Name("x"), CmpOp(">", Int(0))),
          CompFor(
            Name("x"),
            ListExpr(Int(1), UnaryOp("-", Int(1)), Int(3)),
            Bool(true))))))
  Assert(
    Call(
      Name("any"),
      GenExp(Compare(Name("x"), CmpOp("<", Int(0))),
        CompFor(
          Name("x"),
          ListExpr(Int(1), UnaryOp("-", Int(1)), Int(3)),
          Bool(true)))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("any"),
        GenExp(Compare(Name("x"), CmpOp("<", Int(0))),
          CompFor(
            Name("x"),
            ListExpr(Int(1), Int(2), Int(3)),
            Bool(true))))))
  Assert(
    Compare(
      Call(
        Name("max"),
        GenExp(Name("x"),
          CompFor(
            Name("x"),
            ListExpr(Int(3), Int(1), Int(4), Int(1), Int(5)),
            Bool(true)))),
      CmpOp("==", Int(5)))))
