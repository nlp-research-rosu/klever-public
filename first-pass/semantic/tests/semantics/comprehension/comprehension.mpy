Module(
  Assert(
    Compare(
      ListComp(Name("e"),
        CompFor(Name("e"), ListExpr(Int(1), Int(2), Int(3)), Bool(true))),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(3)))))
  Assert(
    Compare(
      ListComp(BinOp("+", Name("e"), Int(1)),
        CompFor(Name("e"), ListExpr(Int(1), Int(2), Int(3)), Bool(true))),
      CmpOp("==", ListExpr(Int(2), Int(3), Int(4)))))
  Assert(
    Compare(
      ListComp(Name("e"),
        CompFor(
          Name("e"),
          ListExpr(
            Int(1),
            UnaryOp("-", Int(2)),
            Int(3),
            UnaryOp("-", Int(4))),
          Compare(Name("e"), CmpOp(">", Int(0))))),
      CmpOp("==", ListExpr(Int(1), Int(3)))))
  Assert(
    Compare(
      ListComp(Name("e"),
        CompFor(Name("e"), ListExpr(), Bool(true))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      ListComp(Name("c"),
        CompFor(Name("c"), Str("abc"), Bool(true))),
      CmpOp("==", ListExpr(Str("a"), Str("b"), Str("c")))))
  Assert(
    Compare(
      ListComp(Name("i"),
        CompFor(Name("i"), Call(Name("range"), Int(5)), Bool(true))),
      CmpOp("==", ListExpr(Int(0), Int(1), Int(2), Int(3), Int(4)))))
  Assert(
    Compare(
      ListComp(BinOp("*", Name("i"), Name("i")),
        CompFor(Name("i"), Call(Name("range"), Int(4)), Bool(true))),
      CmpOp("==", ListExpr(Int(0), Int(1), Int(4), Int(9)))))
  Assert(
    Compare(
      ListComp(Name("x"),
        CompFor(
          Name("x"),
          TupleExpr(Int(1), Int(2), Int(3), Int(4)),
          Compare(Name("x"), CmpOp(">", Int(2))))),
      CmpOp("==", ListExpr(Int(3), Int(4)))))
  Assert(
    Compare(
      ListComp(Name("x"),
        CompFor(
          Name("x"),
          ListExpr(Int(5), UnaryOp("-", Int(1)), Int(12), Int(3)),
          Compare(Name("x"), CmpOp(">", Int(0))),
          Compare(Name("x"), CmpOp("<", Int(10))))),
      CmpOp("==", ListExpr(Int(5), Int(3)))))
  Assert(
    Compare(
      ListComp(BinOp("+", BinOp("*", Name("i"), Int(10)), Name("j")),
        CompFor(Name("i"), Call(Name("range"), Int(3)), Bool(true))
        CompFor(Name("j"), Call(Name("range"), Int(2)), Bool(true))),
      CmpOp(
        "==",
        ListExpr(Int(0), Int(1), Int(10), Int(11), Int(20), Int(21)))))
  Assert(
    Compare(
      ListComp(BinOp("+", Name("a"), Name("b")),
        CompFor(Name("a"), ListExpr(Int(1), Int(2)), Bool(true))
        CompFor(
          Name("b"),
          ListExpr(Int(10), Int(20)),
          Compare(BinOp("+", Name("a"), Name("b")), CmpOp(">", Int(11))))),
      CmpOp("==", ListExpr(Int(21), Int(12), Int(22)))))
  Assert(
    Compare(
      ListComp(Name("j"),
        CompFor(
          Name("row"),
          ListExpr(ListExpr(Int(1), Int(2)), ListExpr(Int(3), Int(4))),
          Bool(true))
        CompFor(Name("j"), Name("row"), Bool(true))),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(3), Int(4)))))
  Assign(Name("a"), Int(5))
  Assign(
    Name("r"),
    ListComp(Name("a"),
      CompFor(Name("a"), ListExpr(Int(1), Int(2), Int(3)), Bool(true))))
  Assert(
    BoolOp(
      "and",
      Compare(Name("a"), CmpOp("==", Int(5))),
      Compare(Name("r"), CmpOp("==", ListExpr(Int(1), Int(2), Int(3))))))
  Assign(Name("base"), Int(10))
  Assert(
    Compare(
      ListComp(BinOp("+", Name("e"), Name("base")),
        CompFor(Name("e"), ListExpr(Int(1), Int(2)), Bool(true))),
      CmpOp("==", ListExpr(Int(11), Int(12)))))
  Assign(Name("xs"), ListExpr(Int(7), Int(8), Int(9)))
  Assert(
    BoolOp(
      "and",
      Compare(
        ListComp(Name("xs"),
          CompFor(Name("xs"), Name("xs"), Bool(true))),
        CmpOp("==", ListExpr(Int(7), Int(8), Int(9)))),
      Compare(Name("xs"), CmpOp("==", ListExpr(Int(7), Int(8), Int(9))))))
  Assert(
    Compare(
      ListComp(Name("y"),
        CompFor(
          Name("y"),
          ListComp(Name("x"),
            CompFor(
              Name("x"),
              ListExpr(Int(1), Int(2), Int(3)),
              Bool(true))),
          Bool(true))),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(3)))))
  Assert(
    Compare(
      ListComp(BinOp("*", Name("y"), Int(10)),
        CompFor(
          Name("y"),
          ListComp(BinOp("+", Name("x"), Int(1)),
            CompFor(
              Name("x"),
              ListExpr(Int(1), Int(2), Int(3)),
              Bool(true))),
          Bool(true))),
      CmpOp("==", ListExpr(Int(20), Int(30), Int(40)))))
  Assert(
    Compare(
      ListComp(ListComp(Name("y"),
        CompFor(Name("y"), Name("row"), Bool(true))),
        CompFor(
          Name("row"),
          ListExpr(ListExpr(Int(1), Int(2)), ListExpr(Int(3), Int(4))),
          Bool(true))),
      CmpOp(
        "==",
        ListExpr(ListExpr(Int(1), Int(2)), ListExpr(Int(3), Int(4))))))
  Assert(
    Compare(
      ListComp(Name("x"),
        CompFor(
          Name("x"),
          ListComp(Name("x"),
            CompFor(
              Name("x"),
              ListExpr(Int(1), Int(2), Int(3)),
              Bool(true))),
          Bool(true))),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(3))))))
