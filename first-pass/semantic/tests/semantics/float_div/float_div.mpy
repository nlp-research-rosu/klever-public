Module(
  FuncDef("area", Params("a", "h"),
    Return(BinOp("/", BinOp("*", Name("a"), Name("h")), Float(2.0))))
  Assert(
    Compare(Call(Name("area"), Int(5), Int(3)), CmpOp("==", Float(7.5))))
  Assert(
    Compare(Call(Name("area"), Int(4), Int(4)), CmpOp("==", Float(8.0))))
  Assert(
    Compare(Call(Name("area"), Int(1), Int(1)), CmpOp("!=", Float(2.0)))))
