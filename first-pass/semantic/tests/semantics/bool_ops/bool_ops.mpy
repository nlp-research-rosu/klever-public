Module(
  Assert(
    Compare(
      BoolOp("and", Bool(true), Bool(true)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      BoolOp("and", Bool(true), Bool(false)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      BoolOp("and", Bool(false), Bool(true)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      BoolOp("or", Bool(false), Bool(true)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      BoolOp("or", Bool(false), Bool(false)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      BoolOp("or", Bool(true), Bool(false)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      BoolOp(
        "and",
        Compare(Int(1), CmpOp("<", Int(2))),
        Compare(Int(3), CmpOp("<", Int(4)))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      BoolOp(
        "or",
        Compare(Int(1), CmpOp(">", Int(2))),
        Compare(Int(3), CmpOp("<", Int(4)))),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      BoolOp("and", Bool(true), Bool(true), Bool(false)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      BoolOp("or", Bool(false), Bool(false), Bool(true)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      BoolOp("and", Bool(false), Name("_unreached")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      BoolOp("or", Bool(true), Name("_unreached")),
      CmpOp("==", Bool(true)))))
