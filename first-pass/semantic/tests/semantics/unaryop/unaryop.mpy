Module(
  Assert(Compare(UnaryOp("-", Int(5)), CmpOp("<", Int(0))))
  Assert(
    Compare(UnaryOp("-", Int(7)), CmpOp("<", UnaryOp("-", Int(3)))))
  Assert(Compare(UnaryOp("-", Int(0)), CmpOp("==", Int(0))))
  Assert(Compare(UnaryOp("not", Bool(true)), CmpOp("==", Bool(false))))
  Assert(Compare(UnaryOp("not", Bool(false)), CmpOp("==", Bool(true))))
  Assert(
    Compare(
      UnaryOp("not", Compare(Int(1), CmpOp("<", Int(2)))),
      CmpOp("==", Bool(false))))
  Assert(UnaryOp("not", NoneVal)))
