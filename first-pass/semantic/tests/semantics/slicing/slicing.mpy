Module(
  Assign(Name("a"), ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5)))
  Assert(
    Compare(
      Subscript(Name("a"), Slice(Int(1), Int(3), NoBound)),
      CmpOp("==", ListExpr(Int(2), Int(3)))))
  Assert(
    Compare(
      Subscript(Name("a"), Slice(NoBound, Int(2), NoBound)),
      CmpOp("==", ListExpr(Int(1), Int(2)))))
  Assert(
    Compare(
      Subscript(Name("a"), Slice(Int(2), NoBound, NoBound)),
      CmpOp("==", ListExpr(Int(3), Int(4), Int(5)))))
  Assert(
    Compare(
      Subscript(Name("a"), Slice(NoBound, NoBound, NoBound)),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5)))))
  Assert(
    Compare(
      Subscript(
        Name("a"),
        Slice(UnaryOp("-", Int(2)), NoBound, NoBound)),
      CmpOp("==", ListExpr(Int(4), Int(5)))))
  Assert(
    Compare(
      Subscript(
        Name("a"),
        Slice(NoBound, UnaryOp("-", Int(1)), NoBound)),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(3), Int(4)))))
  Assert(
    Compare(
      Subscript(
        Name("a"),
        Slice(UnaryOp("-", Int(3)), UnaryOp("-", Int(1)), NoBound)),
      CmpOp("==", ListExpr(Int(3), Int(4)))))
  Assert(
    Compare(
      Subscript(Name("a"), Slice(Int(1), Int(100), NoBound)),
      CmpOp("==", ListExpr(Int(2), Int(3), Int(4), Int(5)))))
  Assert(
    Compare(
      Subscript(
        Name("a"),
        Slice(UnaryOp("-", Int(100)), Int(2), NoBound)),
      CmpOp("==", ListExpr(Int(1), Int(2)))))
  Assert(
    Compare(
      Subscript(Name("a"), Slice(Int(3), Int(1), NoBound)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Subscript(Name("a"), Slice(Int(10), NoBound, NoBound)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Subscript(Name("a"), Slice(NoBound, NoBound, Int(2))),
      CmpOp("==", ListExpr(Int(1), Int(3), Int(5)))))
  Assert(
    Compare(
      Subscript(Name("a"), Slice(Int(1), NoBound, Int(2))),
      CmpOp("==", ListExpr(Int(2), Int(4)))))
  Assert(
    Compare(
      Subscript(
        Name("a"),
        Slice(NoBound, NoBound, UnaryOp("-", Int(1)))),
      CmpOp("==", ListExpr(Int(5), Int(4), Int(3), Int(2), Int(1)))))
  Assert(
    Compare(
      Subscript(
        Name("a"),
        Slice(NoBound, NoBound, UnaryOp("-", Int(2)))),
      CmpOp("==", ListExpr(Int(5), Int(3), Int(1)))))
  Assert(
    Compare(
      Subscript(Name("a"), Slice(Int(4), Int(1), UnaryOp("-", Int(1)))),
      CmpOp("==", ListExpr(Int(5), Int(4), Int(3)))))
  Assert(
    Compare(
      Subscript(
        Name("a"),
        Slice(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(4)),
          UnaryOp("-", Int(1)))),
      CmpOp("==", ListExpr(Int(5), Int(4), Int(3)))))
  Assert(
    Compare(
      Subscript(Name("a"), Slice(Int(1), Int(4), UnaryOp("-", Int(1)))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Subscript(ListExpr(), Slice(NoBound, NoBound, NoBound)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Subscript(
        ListExpr(),
        Slice(NoBound, NoBound, UnaryOp("-", Int(1)))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Subscript(ListExpr(Int(7)), Slice(NoBound, NoBound, NoBound)),
      CmpOp("==", ListExpr(Int(7)))))
  Assert(
    Compare(
      Subscript(
        ListExpr(Int(7)),
        Slice(NoBound, NoBound, UnaryOp("-", Int(1)))),
      CmpOp("==", ListExpr(Int(7)))))
  Assert(
    Compare(
      Subscript(ListExpr(Int(7)), Slice(Int(1), NoBound, NoBound)),
      CmpOp("==", ListExpr())))
  Assign(Name("s"), Str("hello"))
  Assert(
    Compare(
      Subscript(Name("s"), Slice(Int(1), Int(4), NoBound)),
      CmpOp("==", Str("ell"))))
  Assert(
    Compare(
      Subscript(Name("s"), Slice(NoBound, Int(3), NoBound)),
      CmpOp("==", Str("hel"))))
  Assert(
    Compare(
      Subscript(Name("s"), Slice(Int(2), NoBound, NoBound)),
      CmpOp("==", Str("llo"))))
  Assert(
    Compare(
      Subscript(
        Name("s"),
        Slice(NoBound, NoBound, UnaryOp("-", Int(1)))),
      CmpOp("==", Str("olleh"))))
  Assert(
    Compare(
      Subscript(Name("s"), Slice(NoBound, NoBound, Int(2))),
      CmpOp("==", Str("hlo"))))
  Assert(
    Compare(
      Subscript(
        Name("s"),
        Slice(UnaryOp("-", Int(3)), NoBound, NoBound)),
      CmpOp("==", Str("llo"))))
  Assert(
    Compare(
      Subscript(Name("s"), Slice(Int(4), Int(1), UnaryOp("-", Int(1)))),
      CmpOp("==", Str("oll"))))
  Assert(
    Compare(
      Subscript(Name("s"), Slice(Int(10), NoBound, NoBound)),
      CmpOp("==", Str(""))))
  Assert(
    Compare(
      Subscript(Str(""), Slice(NoBound, NoBound, NoBound)),
      CmpOp("==", Str(""))))
  Assert(
    Compare(
      Subscript(Str(""), Slice(NoBound, NoBound, UnaryOp("-", Int(1)))),
      CmpOp("==", Str("")))))
