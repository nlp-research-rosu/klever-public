Module(
  Assign(Name("a"), Int(0))
  If(Compare(Int(5), CmpOp(">", Int(3))),
    Assign(Name("a"), Int(1)),
    Assign(Name("a"), Int(2)))
  Assert(Compare(Name("a"), CmpOp("==", Int(1))))
  Assign(Name("b"), Int(0))
  If(Compare(Int(5), CmpOp("<", Int(3))),
    Assign(Name("b"), Int(1)),
    Assign(Name("b"), Int(2)))
  Assert(Compare(Name("b"), CmpOp("==", Int(2)))))
