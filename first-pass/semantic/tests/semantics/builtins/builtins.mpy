Module(
  Assign(Name("xs"), ListExpr(Int(3), Int(1), Int(2)))
  Assert(Compare(Call(Name("len"), Name("xs")), CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("len"), TupleExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Int(3))))
  Assert(Compare(Call(Name("len"), Str("hello")), CmpOp("==", Int(5))))
  Assert(Compare(Call(Name("sum"), Name("xs")), CmpOp("==", Int(6))))
  Assert(Compare(Call(Name("sum"), ListExpr()), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("max"), Name("xs")), CmpOp("==", Int(3))))
  Assert(Compare(Call(Name("min"), Name("xs")), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("max"), Int(5), Int(9)), CmpOp("==", Int(9))))
  Assert(
    Compare(Call(Name("min"), Int(5), Int(9)), CmpOp("==", Int(5))))
  Assert(
    Compare(
      Call(Name("abs"), UnaryOp("-", Int(4))),
      CmpOp("==", Int(4))))
  Assert(Compare(Call(Name("abs"), Int(7)), CmpOp("==", Int(7))))
  Assert(Compare(Call(Name("ord"), Str("A")), CmpOp("==", Int(65))))
  Assert(Compare(Call(Name("chr"), Int(66)), CmpOp("==", Str("B"))))
  Assert(Compare(Call(Name("str"), Int(0)), CmpOp("==", Str("0"))))
  Assert(Compare(Call(Name("str"), Int(123)), CmpOp("==", Str("123"))))
  Assert(
    Compare(
      Call(Name("str"), UnaryOp("-", Int(7))),
      CmpOp("==", Str("-7"))))
  Assert(
    Compare(
      Call(Name("max"), Int(1), Int(5), Int(3), Int(2)),
      CmpOp("==", Int(5))))
  Assert(
    Compare(
      Call(Name("min"), Int(4), Int(1), Int(7), Int(2)),
      CmpOp("==", Int(1)))))
