Module(
  Assert(
    Compare(
      Call(
        Attribute(Str(","), "join"),
        ListExpr(Str("a"), Str("bc"), Str("d"))),
      CmpOp("==", Str("a,bc,d"))))
  Assert(
    Compare(
      Call(Attribute(Str(""), "join"), ListExpr(Str("x"), Str("y"))),
      CmpOp("==", Str("xy"))))
  Assert(
    Compare(
      Call(Attribute(Str(", "), "join"), ListExpr()),
      CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Attribute(Str("banana"), "count"), Str("an")),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Attribute(Str("aaaa"), "count"), Str("aa")),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Attribute(Str("abc"), "count"), Str("z")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Attribute(Str("  hi there \n"), "strip"), ),
      CmpOp("==", Str("hi there"))))
  Assert(
    Compare(
      Call(Attribute(Str("abc"), "strip"), ),
      CmpOp("==", Str("abc"))))
  Assert(
    Compare(Call(Attribute(Str(""), "strip"), ), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(
        Name("len"),
        Call(Attribute(Str("ok"), "encode"), Str("ascii"))),
      CmpOp("==", Int(2))))
  Assign(Name("words"), Call(Attribute(Str("a-b"), "split"), Str("-")))
  Assert(
    Compare(
      Call(Attribute(Str("+"), "join"), Name("words")),
      CmpOp("==", Str("a+b")))))
