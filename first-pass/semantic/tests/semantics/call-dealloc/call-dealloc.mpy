Module(
  FuncDef("g", Params("y"),
    Return(BinOp("+", Name("y"), Int(1))))
  FuncDef("f", Params("x"),
    Assign(Name("t"), Call(Name("g"), Name("x")))
    Return(BinOp("+", Name("t"), Call(Name("g"), Name("t")))))
  Assign(Name("total"), Int(0))
  Assign(Name("i"), Int(0))
  For(Name("i"), Call(Name("range"), Int(5)),
    Assign(
      Name("total"),
      BinOp("+", Name("total"), Call(Name("f"), Name("i")))))
  Assert(Compare(Name("total"), CmpOp("==", Int(35)))))
