Module(
  Assign(
    Name("a"),
    ListExpr(Int(10), Int(20), Int(30), Int(40), Int(50)))
  Assert(Compare(Subscript(Name("a"), Int(0)), CmpOp("==", Int(10))))
  Assert(Compare(Subscript(Name("a"), Int(4)), CmpOp("==", Int(50))))
  Assert(
    Compare(
      Subscript(Name("a"), UnaryOp("-", Int(1))),
      CmpOp("==", Int(50))))
  Assert(
    Compare(
      Subscript(Name("a"), UnaryOp("-", Int(5))),
      CmpOp("==", Int(10))))
  Assert(
    Compare(
      Subscript(Name("a"), UnaryOp("-", Int(2))),
      CmpOp("==", Int(40))))
  Assign(Name("s"), Str("hello"))
  Assert(Compare(Subscript(Name("s"), Int(0)), CmpOp("==", Str("h"))))
  Assert(Compare(Subscript(Name("s"), Int(4)), CmpOp("==", Str("o"))))
  Assert(
    Compare(
      Subscript(Name("s"), UnaryOp("-", Int(1))),
      CmpOp("==", Str("o"))))
  Assert(
    Compare(
      Subscript(Name("s"), UnaryOp("-", Int(5))),
      CmpOp("==", Str("h"))))
  Assign(Name("t"), TupleExpr(Int(1), Int(2), Int(3)))
  Assert(Compare(Subscript(Name("t"), Int(0)), CmpOp("==", Int(1))))
  Assert(Compare(Subscript(Name("t"), Int(2)), CmpOp("==", Int(3))))
  Assert(
    Compare(
      Subscript(Name("t"), UnaryOp("-", Int(1))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Subscript(Name("t"), UnaryOp("-", Int(3))),
      CmpOp("==", Int(1))))
  Assign(Name("i"), Int(1))
  Assert(
    Compare(
      Subscript(Name("a"), BinOp("+", Name("i"), Int(1))),
      CmpOp("==", Int(30))))
  Assert(
    Compare(Subscript(ListExpr(Int(9)), Int(0)), CmpOp("==", Int(9))))
  Assert(
    Compare(
      Subscript(ListExpr(Int(9)), UnaryOp("-", Int(1))),
      CmpOp("==", Int(9)))))
