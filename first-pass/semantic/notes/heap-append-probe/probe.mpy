Module(
  FuncDef("build_squares", Params("n"),
    Assign(Name("result"), ListExpr())
    Assign(Name("i"), Int(0))
    For(Name("i"), Call(Name("range"), Name("n")),
      Expr(
        Call(
          Attribute(Name("result"), "append"),
          BinOp("*", Name("i"), Name("i")))))
    Return(Name("result")))
  FuncDef("build_plus", Params("n"),
    Assign(Name("out"), ListExpr())
    Assign(Name("i"), Int(0))
    For(Name("i"), Call(Name("range"), Name("n")),
      Assign(Name("out"), BinOp("+", Name("out"), ListExpr(Name("i")))))
    Return(Name("out")))
  Assert(
    Compare(
      Call(Name("build_squares"), Int(0)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("build_squares"), Int(4)),
      CmpOp("==", ListExpr(Int(0), Int(1), Int(4), Int(9)))))
  Assert(
    Compare(Call(Name("build_plus"), Int(0)), CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("build_plus"), Int(3)),
      CmpOp("==", ListExpr(Int(0), Int(1), Int(2))))))
