Module(
  FuncDef("digsum", Params("k"),
    Assign(Name("s"), Int(0))
    While(Compare(Name("k"), CmpOp(">", Int(0))),
      Assign(
        Name("s"),
        BinOp("+", Name("s"), BinOp("%", Name("k"), Int(10))))
      Assign(Name("k"), BinOp("//", Name("k"), Int(10))))
    Return(Name("s")))
  FuncDef("total_digsum", Params("n"),
    Assign(Name("t"), Int(0))
    Assign(Name("i"), Int(0))
    For(Name("i"), Call(Name("range"), Name("n")),
      Assign(
        Name("t"),
        BinOp("+", Name("t"), Call(Name("digsum"), Name("i")))))
    Return(Name("t")))
  Assert(
    Compare(Call(Name("total_digsum"), Int(0)), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("total_digsum"), Int(5)), CmpOp("==", Int(10))))
  Assert(
    Compare(Call(Name("total_digsum"), Int(12)), CmpOp("==", Int(48)))))
