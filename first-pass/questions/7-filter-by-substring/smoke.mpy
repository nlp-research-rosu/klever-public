Module(
  FuncDef("filter_by_substring", Params("strings", "substring"),
    Assign(Name("result"), ListExpr())
    Assign(Name("x"), Str(""))
    For(Name("x"), Name("strings"),
      If(Compare(Name("substring"), CmpOp("in", Name("x"))),
        Assign(
          Name("result"),
          BinOp("+", Name("result"), ListExpr(Name("x")))),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("filter_by_substring"), ListExpr(), Str("john")),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("filter_by_substring"),
        ListExpr(
          Str("xxx"),
          Str("asd"),
          Str("xxy"),
          Str("john doe"),
          Str("xxxAAA"),
          Str("xxx")),
        Str("xxx")),
      CmpOp("==", ListExpr(Str("xxx"), Str("xxxAAA"), Str("xxx")))))
  Assert(
    Compare(
      Call(
        Name("filter_by_substring"),
        ListExpr(
          Str("xxx"),
          Str("asd"),
          Str("aaaxxy"),
          Str("john doe"),
          Str("xxxAAA"),
          Str("xxx")),
        Str("xx")),
      CmpOp(
        "==",
        ListExpr(Str("xxx"), Str("aaaxxy"), Str("xxxAAA"), Str("xxx")))))
  Assert(
    Compare(
      Call(
        Name("filter_by_substring"),
        ListExpr(
          Str("grunt"),
          Str("trumpet"),
          Str("prune"),
          Str("gruesome")),
        Str("run")),
      CmpOp("==", ListExpr(Str("grunt"), Str("prune"))))))
