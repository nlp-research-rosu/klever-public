Module(
  FuncDef("filter_by_substring", Params("strings", "substring"),
    Assign(Name("result"), ListExpr())
    Assign(Name("x"), Str(""))
    For(Name("x"), Name("strings"),
      If(Compare(Name("substring"), CmpOp("in", Name("x"))),
        Assign(
          Name("result"),
          BinOp("+", Name("result"), ListExpr(Name("x")))),
        ))
    Return(Name("result"))))
