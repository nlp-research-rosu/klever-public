Module(
  FuncDef("histogram", Params("test"),
    Assign(Name("dict1"), DictExpr())
    Assign(
      Name("list1"),
      Call(Attribute(Name("test"), "split"), Str(" ")))
    Assign(Name("t"), Int(0))
    For(Name("i"), Name("list1"),
      If(BoolOp(
        "and",
        Compare(
          Call(Attribute(Name("list1"), "count"), Name("i")),
          CmpOp(">", Name("t"))),
        Compare(Name("i"), CmpOp("!=", Str("")))),
        Assign(
          Name("t"),
          Call(Attribute(Name("list1"), "count"), Name("i"))),
        ))
    If(Compare(Name("t"), CmpOp(">", Int(0))),
      For(Name("i"), Name("list1"),
        If(Compare(
          Call(Attribute(Name("list1"), "count"), Name("i")),
          CmpOp("==", Name("t"))),
          Assign(Subscript(Name("dict1"), Name("i")), Name("t")),
          )),
      )
    Return(Name("dict1"))))
