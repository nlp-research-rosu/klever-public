Module(
  FuncDef("histogram", Params("test"),
    Assign(Name("dict1"), DictExpr())
    Assign(
      Name("list1"),
      Call(Attribute(Name("test"), "split"), Str(" ")))
    Assign(Name("t"), Int(0))
    For(Name("i"), Name("list1"),
      If(BoolOp(
        "and",
        Compare(
          Call(Attribute(Name("list1"), "count"), Name("i")),
          CmpOp(">", Name("t"))),
        Compare(Name("i"), CmpOp("!=", Str("")))),
        Assign(
          Name("t"),
          Call(Attribute(Name("list1"), "count"), Name("i"))),
        ))
    If(Compare(Name("t"), CmpOp(">", Int(0))),
      For(Name("i"), Name("list1"),
        If(Compare(
          Call(Attribute(Name("list1"), "count"), Name("i")),
          CmpOp("==", Name("t"))),
          Assign(Subscript(Name("dict1"), Name("i")), Name("t")),
          )),
      )
    Return(Name("dict1")))
  Assert(
    Compare(
      Call(Name("histogram"), Str("a b b a")),
      CmpOp(
        "==",
        DictExpr(Entry(Str("a"), Int(2)), Entry(Str("b"), Int(2))))))
  Assert(
    Compare(
      Call(Name("histogram"), Str("a b c a b")),
      CmpOp(
        "==",
        DictExpr(Entry(Str("a"), Int(2)), Entry(Str("b"), Int(2))))))
  Assert(
    Compare(
      Call(Name("histogram"), Str("a b c d g")),
      CmpOp(
        "==",
        DictExpr(
          Entry(Str("a"), Int(1)),
          Entry(Str("b"), Int(1)),
          Entry(Str("c"), Int(1)),
          Entry(Str("d"), Int(1)),
          Entry(Str("g"), Int(1))))))
  Assert(
    Compare(
      Call(Name("histogram"), Str("r t g")),
      CmpOp(
        "==",
        DictExpr(
          Entry(Str("r"), Int(1)),
          Entry(Str("t"), Int(1)),
          Entry(Str("g"), Int(1))))))
  Assert(
    Compare(
      Call(Name("histogram"), Str("b b b b a")),
      CmpOp("==", DictExpr(Entry(Str("b"), Int(4))))))
  Assert(
    Compare(Call(Name("histogram"), Str("")), CmpOp("==", DictExpr())))
  Assert(
    Compare(
      Call(Name("histogram"), Str("a")),
      CmpOp("==", DictExpr(Entry(Str("a"), Int(1)))))))
