Module(
  FuncDef("longest", Params("strings"),
    Assign(Name("best"), NoneVal)
    Assign(Name("s"), Str(""))
    For(Name("s"), Name("strings"),
      If(BoolOp(
        "or",
        Compare(Name("best"), CmpOp("is", NoneVal)),
        Compare(
          Call(Name("len"), Name("s")),
          CmpOp(">", Call(Name("len"), Name("best"))))),
        Assign(Name("best"), Name("s")),
        ))
    Return(Name("best")))
  Assert(
    Compare(Call(Name("longest"), ListExpr()), CmpOp("is", NoneVal)))
  Assert(
    Compare(
      Call(Name("longest"), ListExpr(Str("x"), Str("y"), Str("z"))),
      CmpOp("==", Str("x"))))
  Assert(
    Compare(
      Call(
        Name("longest"),
        ListExpr(
          Str("x"),
          Str("yyy"),
          Str("zzzz"),
          Str("www"),
          Str("kkkk"),
          Str("abc"))),
      CmpOp("==", Str("zzzz")))))
