Module(
  FuncDef("longest", Params("strings"),
    Assign(Name("best"), NoneVal)
    Assign(Name("s"), Str(""))
    For(Name("s"), Name("strings"),
      If(BoolOp(
        "or",
        Compare(Name("best"), CmpOp("is", NoneVal)),
        Compare(
          Call(Name("len"), Name("s")),
          CmpOp(">", Call(Name("len"), Name("best"))))),
        Assign(Name("best"), Name("s")),
        ))
    Return(Name("best"))))
