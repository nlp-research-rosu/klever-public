Module(
  FuncDef("search", Params("lst"),
    Assign(Name("n"), Call(Name("len"), Name("lst")))
    Assign(Name("ans"), UnaryOp("-", Int(1)))
    Assign(Name("v"), Int(0))
    Assign(Name("j"), Int(0))
    Assign(Name("cnt"), Int(0))
    For(Name("v"), Call(Name("range"), Int(1), BinOp("+", Name("n"), Int(1))),
      Assign(Name("cnt"), Int(0))
      For(Name("j"), Call(Name("range"), Int(0), Name("n")),
        If(Compare(
          Subscript(Name("lst"), Name("j")),
          CmpOp("==", Name("v"))),
          Assign(Name("cnt"), BinOp("+", Name("cnt"), Int(1))),
          ))
      If(Compare(Name("cnt"), CmpOp(">=", Name("v"))),
        Assign(Name("ans"), Name("v")),
        ))
    Return(Name("ans")))
  Assert(
    Compare(
      Call(
        Name("search"),
        ListExpr(Int(4), Int(1), Int(2), Int(2), Int(3), Int(1))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(
        Name("search"),
        ListExpr(
          Int(1),
          Int(2),
          Int(2),
          Int(3),
          Int(3),
          Int(3),
          Int(4),
          Int(4),
          Int(4))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("search"),
        ListExpr(Int(5), Int(5), Int(5), Int(5), Int(1))),
      CmpOp("==", Int(1)))))
