Module(
  FuncDef("sum_squares", Params("lst"),
    Assign(Name("result"), Int(0))
    Assign(Name("i"), Int(0))
    Assign(Name("e"), Int(0))
    For(Name("e"), Name("lst"),
      If(Compare(BinOp("%", Name("i"), Int(3)), CmpOp("==", Int(0))),
        Assign(
          Name("result"),
          BinOp("+", Name("result"), BinOp("*", Name("e"), Name("e")))),
        If(Compare(BinOp("%", Name("i"), Int(4)), CmpOp("==", Int(0))),
          Assign(
            Name("result"),
            BinOp(
              "+",
              Name("result"),
              BinOp("*", BinOp("*", Name("e"), Name("e")), Name("e")))),
          Assign(Name("result"), BinOp("+", Name("result"), Name("e")))))
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("sum_squares"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Int(6))))
  Assert(
    Compare(
      Call(Name("sum_squares"), ListExpr(Int(1), Int(4), Int(9))),
      CmpOp("==", Int(14))))
  Assert(
    Compare(Call(Name("sum_squares"), ListExpr()), CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(
          Int(1),
          Int(1),
          Int(1),
          Int(1),
          Int(1),
          Int(1),
          Int(1),
          Int(1),
          Int(1))),
      CmpOp("==", Int(9))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(1)))),
      CmpOp("==", UnaryOp("-", Int(3)))))
  Assert(
    Compare(
      Call(Name("sum_squares"), ListExpr(Int(0))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(5)),
          Int(2),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(5)))),
      CmpOp("==", UnaryOp("-", Int(126)))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(
          UnaryOp("-", Int(56)),
          UnaryOp("-", Int(99)),
          Int(1),
          Int(0),
          UnaryOp("-", Int(2)))),
      CmpOp("==", Int(3030))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(
          UnaryOp("-", Int(1)),
          Int(0),
          Int(0),
          Int(0),
          Int(0),
          Int(0),
          Int(0),
          Int(0),
          UnaryOp("-", Int(1)))),
      CmpOp("==", Int(0)))))
