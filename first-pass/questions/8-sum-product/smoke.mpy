Module(
  FuncDef("sum_product", Params("numbers"),
    Assign(Name("sum_value"), Int(0))
    Assign(Name("prod_value"), Int(1))
    For(Name("n"), Name("numbers"),
      AugAssign(Name("sum_value"), "+", Name("n"))
      AugAssign(Name("prod_value"), "*", Name("n")))
    Return(TupleExpr(Name("sum_value"), Name("prod_value"))))
  Assert(
    Compare(
      Call(Name("sum_product"), ListExpr()),
      CmpOp("==", TupleExpr(Int(0), Int(1)))))
  Assert(
    Compare(
      Call(Name("sum_product"), ListExpr(Int(1), Int(1), Int(1))),
      CmpOp("==", TupleExpr(Int(3), Int(1)))))
  Assert(
    Compare(
      Call(Name("sum_product"), ListExpr(Int(100), Int(0))),
      CmpOp("==", TupleExpr(Int(100), Int(0)))))
  Assert(
    Compare(
      Call(Name("sum_product"), ListExpr(Int(3), Int(5), Int(7))),
      CmpOp(
        "==",
        TupleExpr(
          BinOp("+", BinOp("+", Int(3), Int(5)), Int(7)),
          BinOp("*", BinOp("*", Int(3), Int(5)), Int(7))))))
  Assert(
    Compare(
      Call(Name("sum_product"), ListExpr(Int(10))),
      CmpOp("==", TupleExpr(Int(10), Int(10))))))
