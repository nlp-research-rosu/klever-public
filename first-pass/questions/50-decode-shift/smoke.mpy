Module(
  FuncDef("decode_shift", Params("s"),
    Assign(Name("result"), Str(""))
    Assign(Name("ch"), Str(""))
    For(Name("ch"), Name("s"),
      Assign(
        Name("result"),
        BinOp(
          "+",
          Name("result"),
          Call(
            Name("chr"),
            BinOp(
              "+",
              BinOp(
                "%",
                BinOp(
                  "-",
                  BinOp("-", Call(Name("ord"), Name("ch")), Int(5)),
                  Int(97)),
                Int(26)),
              Int(97))))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("decode_shift"), Str("mjqqt")),
      CmpOp("==", Str("hello"))))
  Assert(
    Compare(
      Call(Name("decode_shift"), Str("fgh")),
      CmpOp("==", Str("abc"))))
  Assert(
    Compare(
      Call(Name("decode_shift"), Str("cde")),
      CmpOp("==", Str("xyz"))))
  Assert(
    Compare(
      Call(Name("decode_shift"), Str("btwqi")),
      CmpOp("==", Str("world"))))
  Assert(
    Compare(
      Call(Name("decode_shift"), Str("pqjajw")),
      CmpOp("==", Str("klever")))))
