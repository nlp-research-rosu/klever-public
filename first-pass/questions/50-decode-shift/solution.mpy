Module(
  FuncDef("decode_shift", Params("s"),
    Assign(Name("result"), Str(""))
    Assign(Name("ch"), Str(""))
    For(Name("ch"), Name("s"),
      Assign(
        Name("result"),
        BinOp(
          "+",
          Name("result"),
          Call(
            Name("chr"),
            BinOp(
              "+",
              BinOp(
                "%",
                BinOp(
                  "-",
                  BinOp("-", Call(Name("ord"), Name("ch")), Int(5)),
                  Int(97)),
                Int(26)),
              Int(97))))))
    Return(Name("result"))))
