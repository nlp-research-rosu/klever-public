Module(
  FuncDef("car_race_collision", Params("n"),
    Return(BinOp("**", Name("n"), Int(2))))
  Assert(
    Compare(
      Call(Name("car_race_collision"), Int(2)),
      CmpOp("==", Int(4))))
  Assert(
    Compare(
      Call(Name("car_race_collision"), Int(3)),
      CmpOp("==", Int(9))))
  Assert(
    Compare(
      Call(Name("car_race_collision"), Int(4)),
      CmpOp("==", Int(16))))
  Assert(
    Compare(
      Call(Name("car_race_collision"), Int(8)),
      CmpOp("==", Int(64))))
  Assert(
    Compare(
      Call(Name("car_race_collision"), Int(10)),
      CmpOp("==", Int(100)))))
