Module(
  FuncDef("encode", Params("message"),
    Assign(Name("result"), Str(""))
    Assign(Name("c"), Str(""))
    Assign(Name("code"), Int(0))
    Assign(Name("new"), Int(0))
    For(Name("c"), Name("message"),
      Assign(Name("code"), Call(Name("ord"), Name("c")))
      Assign(Name("new"), Name("code"))
      If(BoolOp(
        "and",
        Compare(Name("code"), CmpOp(">=", Int(65))),
        Compare(Name("code"), CmpOp("<=", Int(90)))),
        Assign(Name("new"), BinOp("+", Name("code"), Int(32))),
        If(BoolOp(
          "and",
          Compare(Name("code"), CmpOp(">=", Int(97))),
          Compare(Name("code"), CmpOp("<=", Int(122)))),
          Assign(Name("new"), BinOp("-", Name("code"), Int(32))),
          ))
      If(BoolOp(
        "or",
        Compare(Name("new"), CmpOp("==", Int(97))),
        Compare(Name("new"), CmpOp("==", Int(101))),
        Compare(Name("new"), CmpOp("==", Int(105))),
        Compare(Name("new"), CmpOp("==", Int(111))),
        Compare(Name("new"), CmpOp("==", Int(117))),
        Compare(Name("new"), CmpOp("==", Int(65))),
        Compare(Name("new"), CmpOp("==", Int(69))),
        Compare(Name("new"), CmpOp("==", Int(73))),
        Compare(Name("new"), CmpOp("==", Int(79))),
        Compare(Name("new"), CmpOp("==", Int(85)))),
        Assign(Name("new"), BinOp("+", Name("new"), Int(2))),
        )
      Assign(
        Name("result"),
        BinOp("+", Name("result"), Call(Name("chr"), Name("new")))))
    Return(Name("result")))
  Assert(
    Compare(Call(Name("encode"), Str("TEST")), CmpOp("==", Str("tgst"))))
  Assert(
    Compare(
      Call(Name("encode"), Str("Mudasir")),
      CmpOp("==", Str("mWDCSKR"))))
  Assert(
    Compare(Call(Name("encode"), Str("YES")), CmpOp("==", Str("ygs"))))
  Assert(
    Compare(
      Call(Name("encode"), Str("This is a message")),
      CmpOp("==", Str("tHKS KS C MGSSCGG"))))
  Assert(
    Compare(
      Call(Name("encode"), Str("I DoNt KnOw WhAt tO WrItE")),
      CmpOp("==", Str("k dQnT kNqW wHcT Tq wRkTg")))))
