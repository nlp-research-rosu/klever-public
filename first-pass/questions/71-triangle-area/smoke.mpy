Module(
  FuncDef("triangle_area", Params("a", "b", "c"),
    If(BoolOp(
      "or",
      Compare(BinOp("+", Name("a"), Name("b")), CmpOp("<=", Name("c"))),
      Compare(BinOp("+", Name("a"), Name("c")), CmpOp("<=", Name("b"))),
      Compare(BinOp("+", Name("b"), Name("c")), CmpOp("<=", Name("a")))),
      Return(UnaryOp("-", Int(1))),
      )
    Assign(
      Name("s"),
      BinOp(
        "/",
        BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")),
        Int(2)))
    Assign(
      Name("area"),
      BinOp(
        "**",
        BinOp(
          "*",
          BinOp(
            "*",
            BinOp("*", Name("s"), BinOp("-", Name("s"), Name("a"))),
            BinOp("-", Name("s"), Name("b"))),
          BinOp("-", Name("s"), Name("c"))),
        Float(0.5)))
    Assign(Name("area"), Call(Name("round"), Name("area"), Int(2)))
    Return(Name("area")))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(1), Int(2), Int(10)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(1), Int(2), Int(3)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(2), Int(6), Int(3)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(2), Int(2), Int(10)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(10), Int(1), Int(1)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(3), Int(4), Int(5)),
      CmpOp("==", Float(6.0))))
  Assert(
    Compare(
      Call(Name("triangle_area"), Int(5), Int(12), Int(13)),
      CmpOp("==", Float(30.0)))))
