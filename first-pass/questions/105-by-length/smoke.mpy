Module(
  FuncDef("word", Params("v"),
    If(Compare(Name("v"), CmpOp("==", Int(1))),
      Return(Str("One")),
      )
    If(Compare(Name("v"), CmpOp("==", Int(2))),
      Return(Str("Two")),
      )
    If(Compare(Name("v"), CmpOp("==", Int(3))),
      Return(Str("Three")),
      )
    If(Compare(Name("v"), CmpOp("==", Int(4))),
      Return(Str("Four")),
      )
    If(Compare(Name("v"), CmpOp("==", Int(5))),
      Return(Str("Five")),
      )
    If(Compare(Name("v"), CmpOp("==", Int(6))),
      Return(Str("Six")),
      )
    If(Compare(Name("v"), CmpOp("==", Int(7))),
      Return(Str("Seven")),
      )
    If(Compare(Name("v"), CmpOp("==", Int(8))),
      Return(Str("Eight")),
      )
    If(Compare(Name("v"), CmpOp("==", Int(9))),
      Return(Str("Nine")),
      )
    Return(Str("")))
  FuncDef("by_length", Params("arr"),
    Assign(Name("n"), Call(Name("len"), Name("arr")))
    Assign(Name("s"), Call(Name("sorted"), Name("arr")))
    Assign(Name("result"), ListExpr())
    Assign(Name("i"), Int(0))
    Assign(Name("v"), Int(0))
    For(Name("i"), Call(Name("range"), Int(0), Name("n")),
      Assign(
        Name("v"),
        Subscript(
          Name("s"),
          BinOp("-", BinOp("-", Name("n"), Int(1)), Name("i"))))
      If(Compare(Name("v"), CmpOp(">=", Int(1))),
        If(Compare(Name("v"), CmpOp("<=", Int(9))),
          Assign(
            Name("result"),
            BinOp(
              "+",
              Name("result"),
              ListExpr(Call(Name("word"), Name("v"))))),
          ),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("by_length"),
        ListExpr(
          Int(2),
          Int(1),
          Int(1),
          Int(4),
          Int(5),
          Int(8),
          Int(2),
          Int(3))),
      CmpOp(
        "==",
        ListExpr(
          Str("Eight"),
          Str("Five"),
          Str("Four"),
          Str("Three"),
          Str("Two"),
          Str("Two"),
          Str("One"),
          Str("One")))))
  Assert(
    Compare(
      Call(Name("by_length"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("by_length"), ListExpr(Int(1), Int(0), Int(55))),
      CmpOp("==", ListExpr(Str("One"))))))
