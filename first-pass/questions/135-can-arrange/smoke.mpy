Module(
  FuncDef("can_arrange", Params("arr"),
    Assign(Name("ind"), UnaryOp("-", Int(1)))
    Assign(Name("i"), Int(0))
    Assign(Name("prev"), Int(0))
    Assign(Name("x"), Int(0))
    For(Name("x"), Name("arr"),
      If(Compare(Name("i"), CmpOp(">=", Int(1))),
        If(Compare(Name("x"), CmpOp("<", Name("prev"))),
          Assign(Name("ind"), Name("i")),
          ),
        )
      Assign(Name("prev"), Name("x"))
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(Name("ind")))
  Assert(
    Compare(
      Call(
        Name("can_arrange"),
        ListExpr(Int(1), Int(2), Int(4), Int(3), Int(5))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("can_arrange"),
        ListExpr(Int(1), Int(2), Int(4), Int(5))),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(
        Name("can_arrange"),
        ListExpr(
          Int(1),
          Int(4),
          Int(2),
          Int(5),
          Int(6),
          Int(7),
          Int(8),
          Int(9),
          Int(10))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(
        Name("can_arrange"),
        ListExpr(Int(4), Int(8), Int(5), Int(7), Int(3))),
      CmpOp("==", Int(4))))
  Assert(
    Compare(
      Call(Name("can_arrange"), ListExpr()),
      CmpOp("==", UnaryOp("-", Int(1))))))
