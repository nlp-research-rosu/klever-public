Module(
  FuncDef("flip_case", Params("string"),
    Return(Call(Attribute(Name("string"), "swapcase"), )))
  Assert(
    Compare(Call(Name("flip_case"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("flip_case"), Str("Hello!")),
      CmpOp("==", Str("hELLO!"))))
  Assert(
    Compare(
      Call(
        Name("flip_case"),
        Str("These violent delights have violent ends")),
      CmpOp("==", Str("tHESE VIOLENT DELIGHTS HAVE VIOLENT ENDS")))))
