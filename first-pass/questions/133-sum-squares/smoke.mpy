Module(
  FuncDef("sum_squares", Params("lst"),
    Import("math")
    Assign(Name("squared"), Int(0))
    Assign(Name("i"), Int(0))
    For(Name("i"), Name("lst"),
      AugAssign(
        Name("squared"),
        "+",
        BinOp(
          "**",
          Call(Attribute(Name("math"), "ceil"), Name("i")),
          Int(2))))
    Return(Name("squared")))
  Assert(
    Compare(
      Call(Name("sum_squares"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Int(14))))
  Assert(
    Compare(
      Call(Name("sum_squares"), ListExpr(Float(1.0), Int(2), Int(3))),
      CmpOp("==", Int(14))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(Float(1.4), Float(4.2), Int(0))),
      CmpOp("==", Int(29))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(UnaryOp("-", Float(2.4)), Int(1), Int(1))),
      CmpOp("==", Int(6))))
  Assert(
    Compare(
      Call(
        Name("sum_squares"),
        ListExpr(UnaryOp("-", Float(1.4)), Float(4.6), Float(6.3))),
      CmpOp("==", Int(75)))))
