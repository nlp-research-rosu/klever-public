Module(
  FuncDef("sum_squares", Params("lst"),
    Import("math")
    Assign(Name("squared"), Int(0))
    Assign(Name("i"), Int(0))
    For(Name("i"), Name("lst"),
      AugAssign(
        Name("squared"),
        "+",
        BinOp(
          "**",
          Call(Attribute(Name("math"), "ceil"), Name("i")),
          Int(2))))
    Return(Name("squared"))))
