Module(
  FuncDef("digits", Params("n"),
    Assign(Name("product"), Int(1))
    Assign(Name("odd_count"), Int(0))
    For(Name("digit"), Call(Name("str"), Name("n")),
      Assign(Name("int_digit"), Call(Name("int"), Name("digit")))
      If(Compare(
        BinOp("%", Name("int_digit"), Int(2)),
        CmpOp("==", Int(1))),
        Assign(
          Name("product"),
          BinOp("*", Name("product"), Name("int_digit")))
        AugAssign(Name("odd_count"), "+", Int(1)),
        ))
    If(Compare(Name("odd_count"), CmpOp("==", Int(0))),
      Return(Int(0)),
      Return(Name("product"))))
  Assert(
    Compare(
      Call(Name("digits"), Int(1)),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("digits"), Int(4)),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("digits"), Int(235)),
      CmpOp("==", Int(15)))))
