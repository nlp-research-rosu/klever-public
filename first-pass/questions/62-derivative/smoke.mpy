Module(
  FuncDef("derivative", Params("xs"),
    Assign(Name("result"), ListExpr())
    Assign(Name("i"), Int(0))
    Assign(Name("x"), Int(0))
    For(Name("x"), Name("xs"),
      If(Compare(Name("i"), CmpOp(">=", Int(1))),
        Assign(
          Name("result"),
          BinOp(
            "+",
            Name("result"),
            ListExpr(BinOp("*", Name("i"), Name("x"))))),
        )
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("derivative"),
        ListExpr(Int(3), Int(1), Int(2), Int(4), Int(5))),
      CmpOp("==", ListExpr(Int(1), Int(4), Int(12), Int(20)))))
  Assert(
    Compare(
      Call(Name("derivative"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", ListExpr(Int(2), Int(6)))))
  Assert(
    Compare(
      Call(Name("derivative"), ListExpr(Int(3), Int(2), Int(1))),
      CmpOp("==", ListExpr(Int(2), Int(2)))))
  Assert(
    Compare(
      Call(
        Name("derivative"),
        ListExpr(Int(3), Int(2), Int(1), Int(0), Int(4))),
      CmpOp("==", ListExpr(Int(2), Int(2), Int(0), Int(16)))))
  Assert(
    Compare(
      Call(Name("derivative"), ListExpr(Int(1))),
      CmpOp("==", ListExpr()))))
