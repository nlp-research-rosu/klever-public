Module(
  FuncDef("derivative", Params("xs"),
    Assign(Name("result"), ListExpr())
    Assign(Name("i"), Int(0))
    Assign(Name("x"), Int(0))
    For(Name("x"), Name("xs"),
      If(Compare(Name("i"), CmpOp(">=", Int(1))),
        Assign(
          Name("result"),
          BinOp(
            "+",
            Name("result"),
            ListExpr(BinOp("*", Name("i"), Name("x"))))),
        )
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(Name("result"))))
