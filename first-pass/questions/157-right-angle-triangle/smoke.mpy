Module(
  FuncDef("right_angle_triangle", Params("a", "b", "c"),
    Return(
      BoolOp(
        "or",
        Compare(
          BinOp("*", Name("a"), Name("a")),
          CmpOp(
            "==",
            BinOp(
              "+",
              BinOp("*", Name("b"), Name("b")),
              BinOp("*", Name("c"), Name("c"))))),
        Compare(
          BinOp("*", Name("b"), Name("b")),
          CmpOp(
            "==",
            BinOp(
              "+",
              BinOp("*", Name("a"), Name("a")),
              BinOp("*", Name("c"), Name("c"))))),
        Compare(
          BinOp("*", Name("c"), Name("c")),
          CmpOp(
            "==",
            BinOp(
              "+",
              BinOp("*", Name("a"), Name("a")),
              BinOp("*", Name("b"), Name("b"))))))))
  Assert(Call(Name("right_angle_triangle"), Int(3), Int(4), Int(5)))
  Assert(
    UnaryOp(
      "not",
      Call(Name("right_angle_triangle"), Int(1), Int(2), Int(3))))
  Assert(Call(Name("right_angle_triangle"), Int(10), Int(6), Int(8)))
  Assert(
    UnaryOp(
      "not",
      Call(Name("right_angle_triangle"), Int(2), Int(2), Int(2))))
  Assert(Call(Name("right_angle_triangle"), Int(7), Int(24), Int(25)))
  Assert(
    UnaryOp(
      "not",
      Call(Name("right_angle_triangle"), Int(10), Int(5), Int(7))))
  Assert(Call(Name("right_angle_triangle"), Int(5), Int(12), Int(13)))
  Assert(Call(Name("right_angle_triangle"), Int(15), Int(8), Int(17)))
  Assert(Call(Name("right_angle_triangle"), Int(48), Int(55), Int(73)))
  Assert(
    UnaryOp(
      "not",
      Call(Name("right_angle_triangle"), Int(1), Int(1), Int(1))))
  Assert(
    UnaryOp(
      "not",
      Call(Name("right_angle_triangle"), Int(2), Int(2), Int(10)))))
