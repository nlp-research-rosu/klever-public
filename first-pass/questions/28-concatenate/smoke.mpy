Module(
  FuncDef("concatenate", Params("strings"),
    Assign(Name("result"), Str(""))
    Assign(Name("s"), Str(""))
    For(Name("s"), Name("strings"),
      Assign(Name("result"), BinOp("+", Name("result"), Name("s"))))
    Return(Name("result")))
  Assert(
    Compare(Call(Name("concatenate"), ListExpr()), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("concatenate"), ListExpr(Str("x"), Str("y"), Str("z"))),
      CmpOp("==", Str("xyz"))))
  Assert(
    Compare(
      Call(
        Name("concatenate"),
        ListExpr(Str("x"), Str("y"), Str("z"), Str("w"), Str("k"))),
      CmpOp("==", Str("xyzwk")))))
