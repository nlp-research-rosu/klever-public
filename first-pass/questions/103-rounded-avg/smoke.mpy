Module(
  FuncDef("rounded_avg", Params("n", "m"),
    If(Compare(Name("m"), CmpOp("<", Name("n"))),
      Return(UnaryOp("-", Int(1))),
      )
    Assign(Name("summation"), Int(0))
    For(Name("i"), Call(Name("range"), Name("n"), BinOp("+", Name("m"), Int(1))),
      AugAssign(Name("summation"), "+", Name("i")))
    Return(
      Call(
        Name("bin"),
        Call(
          Name("round"),
          BinOp(
            "/",
            Name("summation"),
            BinOp("+", BinOp("-", Name("m"), Name("n")), Int(1)))))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(1), Int(5)),
      CmpOp("==", Str("0b11"))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(7), Int(5)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(10), Int(20)),
      CmpOp("==", Str("0b1111"))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(20), Int(33)),
      CmpOp("==", Str("0b11010"))))
  Assert(
    Compare(
      Call(Name("rounded_avg"), Int(2), Int(3)),
      CmpOp("==", Str("0b10")))))
