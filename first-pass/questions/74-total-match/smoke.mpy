Module(
  FuncDef("total_match", Params("lst1", "lst2"),
    Assign(Name("l1"), Int(0))
    Assign(Name("s"), Str(""))
    For(Name("s"), Name("lst1"),
      Assign(
        Name("l1"),
        BinOp("+", Name("l1"), Call(Name("len"), Name("s")))))
    Assign(Name("l2"), Int(0))
    For(Name("s"), Name("lst2"),
      Assign(
        Name("l2"),
        BinOp("+", Name("l2"), Call(Name("len"), Name("s")))))
    Assign(Name("result"), Name("lst2"))
    If(Compare(Name("l1"), CmpOp("<=", Name("l2"))),
      Assign(Name("result"), Name("lst1")),
      )
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("total_match"), ListExpr(), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("total_match"),
        ListExpr(Str("hi"), Str("admin")),
        ListExpr(Str("hi"), Str("hi"))),
      CmpOp("==", ListExpr(Str("hi"), Str("hi")))))
  Assert(
    Compare(
      Call(
        Name("total_match"),
        ListExpr(Str("hi"), Str("admin")),
        ListExpr(Str("hi"), Str("hi"), Str("admin"), Str("project"))),
      CmpOp("==", ListExpr(Str("hi"), Str("admin")))))
  Assert(
    Compare(
      Call(
        Name("total_match"),
        ListExpr(Str("4")),
        ListExpr(Str("1"), Str("2"), Str("3"), Str("4"), Str("5"))),
      CmpOp("==", ListExpr(Str("4")))))
  Assert(
    Compare(
      Call(
        Name("total_match"),
        ListExpr(Str("hi"), Str("admin")),
        ListExpr(Str("hI"), Str("Hi"))),
      CmpOp("==", ListExpr(Str("hI"), Str("Hi")))))
  Assert(
    Compare(
      Call(
        Name("total_match"),
        ListExpr(Str("hi"), Str("admin")),
        ListExpr(Str("hI"), Str("hi"), Str("hi"))),
      CmpOp("==", ListExpr(Str("hI"), Str("hi"), Str("hi")))))
  Assert(
    Compare(
      Call(
        Name("total_match"),
        ListExpr(Str("hi"), Str("admin")),
        ListExpr(Str("hI"), Str("hi"), Str("hii"))),
      CmpOp("==", ListExpr(Str("hi"), Str("admin")))))
  Assert(
    Compare(
      Call(Name("total_match"), ListExpr(), ListExpr(Str("this"))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("total_match"), ListExpr(Str("this")), ListExpr()),
      CmpOp("==", ListExpr()))))
