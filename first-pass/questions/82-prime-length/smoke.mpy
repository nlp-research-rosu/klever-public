Module(
  FuncDef("prime_length", Params("string"),
    Assign(Name("l"), Call(Name("len"), Name("string")))
    Assign(Name("prime"), Compare(Name("l"), CmpOp(">=", Int(2))))
    Assign(Name("i"), Int(0))
    For(Name("i"), Call(Name("range"), Int(2), Name("l")),
      If(Compare(BinOp("%", Name("l"), Name("i")), CmpOp("==", Int(0))),
        Assign(Name("prime"), Bool(false)),
        ))
    Return(Name("prime")))
  Assert(Call(Name("prime_length"), Str("Hello")))
  Assert(Call(Name("prime_length"), Str("abcdcba")))
  Assert(Call(Name("prime_length"), Str("kittens")))
  Assert(UnaryOp("not", Call(Name("prime_length"), Str("orange"))))
  Assert(Call(Name("prime_length"), Str("wow")))
  Assert(Call(Name("prime_length"), Str("world")))
  Assert(Call(Name("prime_length"), Str("MadaM")))
  Assert(Call(Name("prime_length"), Str("Wow")))
  Assert(UnaryOp("not", Call(Name("prime_length"), Str(""))))
  Assert(Call(Name("prime_length"), Str("HI"))))
