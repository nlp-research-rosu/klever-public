Module(
  FuncDef("get_positive", Params("l"),
    Return(
      ListComp(Name("e"),
        CompFor(
          Name("e"),
          Name("l"),
          Compare(Name("e"), CmpOp(">", Int(0)))))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(2)),
          Int(4),
          Int(5),
          Int(6))),
      CmpOp("==", ListExpr(Int(4), Int(5), Int(6)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(
          Int(5),
          Int(3),
          UnaryOp("-", Int(5)),
          Int(2),
          Int(3),
          Int(3),
          Int(9),
          Int(0),
          Int(123),
          Int(1),
          UnaryOp("-", Int(10)))),
      CmpOp(
        "==",
        ListExpr(
          Int(5),
          Int(3),
          Int(2),
          Int(3),
          Int(3),
          Int(9),
          Int(123),
          Int(1)))))
  Assert(
    Compare(
      Call(
        Name("get_positive"),
        ListExpr(UnaryOp("-", Int(1)), UnaryOp("-", Int(2)))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("get_positive"), ListExpr()),
      CmpOp("==", ListExpr()))))
