Module(
  FuncDef("any_int", Params("x", "y", "z"),
    If(BoolOp(
      "and",
      Call(Name("isinstance"), Name("x"), Name("int")),
      Call(Name("isinstance"), Name("y"), Name("int")),
      Call(Name("isinstance"), Name("z"), Name("int"))),
      If(BoolOp(
        "or",
        Compare(
          BinOp("+", Name("x"), Name("y")),
          CmpOp("==", Name("z"))),
        Compare(
          BinOp("+", Name("x"), Name("z")),
          CmpOp("==", Name("y"))),
        Compare(
          BinOp("+", Name("y"), Name("z")),
          CmpOp("==", Name("x")))),
        Return(Bool(true)),
        )
      Return(Bool(false)),
      )
    Return(Bool(false)))
  Assert(Compare(Call(Name("any_int"), Int(5), Int(2), Int(7)), CmpOp("==", Bool(true))))
  Assert(Compare(Call(Name("any_int"), Int(3), Int(2), Int(2)), CmpOp("==", Bool(false))))
  Assert(Compare(Call(Name("any_int"), Int(3), Int(4), Int(7)), CmpOp("==", Bool(true))))
  Assert(Compare(Call(Name("any_int"), Int(2), Int(2), Int(2)), CmpOp("==", Bool(false)))))
