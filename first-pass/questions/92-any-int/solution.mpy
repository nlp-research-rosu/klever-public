Module(
  FuncDef("any_int", Params("x", "y", "z"),
    If(BoolOp(
      "and",
      Call(Name("isinstance"), Name("x"), Name("int")),
      Call(Name("isinstance"), Name("y"), Name("int")),
      Call(Name("isinstance"), Name("z"), Name("int"))),
      If(BoolOp(
        "or",
        Compare(
          BinOp("+", Name("x"), Name("y")),
          CmpOp("==", Name("z"))),
        Compare(
          BinOp("+", Name("x"), Name("z")),
          CmpOp("==", Name("y"))),
        Compare(
          BinOp("+", Name("y"), Name("z")),
          CmpOp("==", Name("x")))),
        Return(Bool(true)),
        )
      Return(Bool(false)),
      )
    Return(Bool(false))))
