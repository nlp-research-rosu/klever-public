Module(
  FuncDef("add", Params("lst"),
    Assign(Name("result"), Int(0))
    Assign(Name("i"), Int(0))
    Assign(Name("e"), Int(0))
    For(Name("e"), Name("lst"),
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(1))),
        If(Compare(BinOp("%", Name("e"), Int(2)), CmpOp("==", Int(0))),
          Assign(Name("result"), BinOp("+", Name("result"), Name("e"))),
          ),
        )
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("add"), ListExpr(Int(4), Int(88))),
      CmpOp("==", Int(88))))
  Assert(
    Compare(
      Call(
        Name("add"),
        ListExpr(Int(4), Int(5), Int(6), Int(7), Int(2), Int(122))),
      CmpOp("==", Int(122))))
  Assert(
    Compare(
      Call(Name("add"), ListExpr(Int(4), Int(0), Int(6), Int(7))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("add"), ListExpr(Int(4), Int(4), Int(6), Int(8))),
      CmpOp("==", Int(12)))))
