Module(
  FuncDef("largest_smallest_integers", Params("lst"),
    Assign(Name("a"), Int(0))
    Assign(Name("b"), Int(0))
    Assign(Name("hn"), Bool(false))
    Assign(Name("hp"), Bool(false))
    Assign(Name("x"), Int(0))
    For(Name("x"), Name("lst"),
      If(Compare(Name("x"), CmpOp("<", Int(0))),
        If(Compare(Name("hn"), CmpOp("==", Bool(false))),
          Assign(Name("a"), Name("x"))
          Assign(Name("hn"), Bool(true)),
          If(Compare(Name("x"), CmpOp(">", Name("a"))),
            Assign(Name("a"), Name("x")),
            )),
        If(Compare(Name("x"), CmpOp(">", Int(0))),
          If(Compare(Name("hp"), CmpOp("==", Bool(false))),
            Assign(Name("b"), Name("x"))
            Assign(Name("hp"), Bool(true)),
            If(Compare(Name("x"), CmpOp("<", Name("b"))),
              Assign(Name("b"), Name("x")),
              )),
          )))
    Assign(Name("ra"), NoneVal)
    If(Name("hn"),
      Assign(Name("ra"), Name("a")),
      )
    Assign(Name("rb"), NoneVal)
    If(Name("hp"),
      Assign(Name("rb"), Name("b")),
      )
    Return(TupleExpr(Name("ra"), Name("rb"))))
  Assert(
    Compare(
      Call(
        Name("largest_smallest_integers"),
        ListExpr(Int(2), Int(4), Int(1), Int(3), Int(5), Int(7))),
      CmpOp("==", TupleExpr(NoneVal, Int(1)))))
  Assert(
    Compare(
      Call(Name("largest_smallest_integers"), ListExpr()),
      CmpOp("==", TupleExpr(NoneVal, NoneVal))))
  Assert(
    Compare(
      Call(Name("largest_smallest_integers"), ListExpr(Int(0))),
      CmpOp("==", TupleExpr(NoneVal, NoneVal))))
  Assert(
    Compare(
      Call(
        Name("largest_smallest_integers"),
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(3)),
          Int(2),
          Int(4))),
      CmpOp("==", TupleExpr(UnaryOp("-", Int(1)), Int(2))))))
