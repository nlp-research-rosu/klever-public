Module(
  FuncDef("file_name_check", Params("file_name"),
    Assign(Name("suf"), ListExpr(Str("txt"), Str("exe"), Str("dll")))
    Assign(
      Name("lst"),
      Call(
        Attribute(Name("file_name"), "split"),
        KwArg("sep", Str("."))))
    If(Compare(Call(Name("len"), Name("lst")), CmpOp("!=", Int(2))),
      Return(Str("No")),
      )
    If(UnaryOp(
      "not",
      Compare(Subscript(Name("lst"), Int(1)), CmpOp("in", Name("suf")))),
      Return(Str("No")),
      )
    If(Compare(
      Call(Name("len"), Subscript(Name("lst"), Int(0))),
      CmpOp("==", Int(0))),
      Return(Str("No")),
      )
    If(UnaryOp(
      "not",
      Call(
        Attribute(
          Subscript(Subscript(Name("lst"), Int(0)), Int(0)),
          "isalpha"),
        )),
      Return(Str("No")),
      )
    Assign(
      Name("t"),
      Call(
        Name("len"),
        ListComp(Name("x"),
          CompFor(
            Name("x"),
            Subscript(Name("lst"), Int(0)),
            Call(Attribute(Name("x"), "isdigit"), )))))
    If(Compare(Name("t"), CmpOp(">", Int(3))),
      Return(Str("No")),
      )
    Return(Str("Yes")))
  Assert(
    Compare(
      Call(Name("file_name_check"), Str("example.txt")),
      CmpOp("==", Str("Yes"))))
  Assert(
    Compare(
      Call(Name("file_name_check"), Str("1example.dll")),
      CmpOp("==", Str("No"))))
  Assert(
    Compare(
      Call(Name("file_name_check"), Str("s1sdf3.asd")),
      CmpOp("==", Str("No"))))
  Assert(
    Compare(
      Call(Name("file_name_check"), Str("K.dll")),
      CmpOp("==", Str("Yes"))))
  Assert(
    Compare(
      Call(Name("file_name_check"), Str("MY16FILE3.exe")),
      CmpOp("==", Str("Yes"))))
  Assert(
    Compare(
      Call(Name("file_name_check"), Str("His12FILE94.exe")),
      CmpOp("==", Str("No"))))
  Assert(
    Compare(
      Call(Name("file_name_check"), Str("_Y.txt")),
      CmpOp("==", Str("No"))))
  Assert(
    Compare(
      Call(Name("file_name_check"), Str("?aREYA.exe")),
      CmpOp("==", Str("No"))))
  Assert(
    Compare(
      Call(Name("file_name_check"), Str("/this_is_valid.dll")),
      CmpOp("==", Str("No"))))
  Assert(
    Compare(
      Call(Name("file_name_check"), Str("this_is_valid.wow")),
      CmpOp("==", Str("No"))))
  Assert(
    Compare(
      Call(Name("file_name_check"), Str("this_is_valid.txt")),
      CmpOp("==", Str("Yes"))))
  Assert(
    Compare(
      Call(Name("file_name_check"), Str("this_is_valid.txtexe")),
      CmpOp("==", Str("No"))))
  Assert(
    Compare(
      Call(Name("file_name_check"), Str("#this2_i4s_5valid.ten")),
      CmpOp("==", Str("No"))))
  Assert(
    Compare(
      Call(Name("file_name_check"), Str("@this1_is6_valid.exe")),
      CmpOp("==", Str("No")))))
