Module(
  FuncDef("generate_integers", Params("a", "b"),
    Assign(
      Name("lower"),
      Call(Name("max"), Int(2), Call(Name("min"), Name("a"), Name("b"))))
    Assign(
      Name("upper"),
      Call(Name("min"), Int(8), Call(Name("max"), Name("a"), Name("b"))))
    Return(
      ListComp(
        Name("i"),
        CompFor(
          Name("i"),
          Call(
            Name("range"),
            Name("lower"),
            BinOp("+", Name("upper"), Int(1))),
          Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0)))))))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(2), Int(8)),
      CmpOp("==", ListExpr(Int(2), Int(4), Int(6), Int(8)))))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(8), Int(2)),
      CmpOp("==", ListExpr(Int(2), Int(4), Int(6), Int(8)))))
  Assert(
    Compare(
      Call(Name("generate_integers"), Int(10), Int(14)),
      CmpOp("==", ListExpr()))))
