Module(
  FuncDef("modp", Params("n", "p"),
    Assign(Name("ret"), Int(1))
    For(Name("i"), Call(Name("range"), Name("n")),
      Assign(
        Name("ret"),
        BinOp("%", BinOp("*", Int(2), Name("ret")), Name("p"))))
    Return(Name("ret")))
  Assert(
    Compare(Call(Name("modp"), Int(3), Int(5)), CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("modp"), Int(1101), Int(101)),
      CmpOp("==", Int(2))))
  Assert(
    Compare(Call(Name("modp"), Int(0), Int(101)), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("modp"), Int(3), Int(11)), CmpOp("==", Int(8))))
  Assert(
    Compare(Call(Name("modp"), Int(100), Int(101)), CmpOp("==", Int(1)))))
