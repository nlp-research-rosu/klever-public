Module(
  FuncDef("tri", Params("n"),
    If(Compare(Name("n"), CmpOp("==", Int(0))),
      Return(ListExpr(Int(1))),
      )
    Assign(Name("my_tri"), ListExpr(Int(1), Int(3)))
    Assign(Name("a"), Int(1))
    Assign(Name("b"), Int(3))
    For(Name("i"), Call(Name("range"), Int(2), BinOp("+", Name("n"), Int(1))),
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
        Assign(
          Name("c"),
          BinOp("+", BinOp("//", Name("i"), Int(2)), Int(1))),
        Assign(
          Name("c"),
          BinOp(
            "+",
            BinOp("+", Name("b"), Name("a")),
            BinOp("//", BinOp("+", Name("i"), Int(3)), Int(2)))))
      Assign(
        Name("my_tri"),
        BinOp("+", Name("my_tri"), ListExpr(Name("c"))))
      Assign(Name("a"), Name("b"))
      Assign(Name("b"), Name("c")))
    Return(Name("my_tri")))
  Assert(
    Compare(Call(Name("tri"), Int(0)), CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(Name("tri"), Int(1)),
      CmpOp("==", ListExpr(Int(1), Int(3)))))
  Assert(
    Compare(
      Call(Name("tri"), Int(3)),
      CmpOp("==", ListExpr(Int(1), Int(3), Int(2), Int(8)))))
  Assert(
    Compare(
      Call(Name("tri"), Int(4)),
      CmpOp("==", ListExpr(Int(1), Int(3), Int(2), Int(8), Int(3))))))
