Module(
  FuncDef("rolling_max", Params("numbers"),
    Assign(Name("result"), ListExpr())
    Assign(Name("m"), Int(0))
    Assign(Name("first"), Bool(true))
    Assign(Name("n"), Int(0))
    For(Name("n"), Name("numbers"),
      If(Name("first"),
        Assign(Name("m"), Name("n"))
        Assign(Name("first"), Bool(false)),
        If(Compare(Name("n"), CmpOp(">", Name("m"))),
          Assign(Name("m"), Name("n")),
          ))
      Assign(
        Name("result"),
        BinOp("+", Name("result"), ListExpr(Name("m")))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("rolling_max"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("rolling_max"),
        ListExpr(Int(1), Int(2), Int(3), Int(4))),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(3), Int(4)))))
  Assert(
    Compare(
      Call(
        Name("rolling_max"),
        ListExpr(Int(4), Int(3), Int(2), Int(1))),
      CmpOp("==", ListExpr(Int(4), Int(4), Int(4), Int(4)))))
  Assert(
    Compare(
      Call(
        Name("rolling_max"),
        ListExpr(Int(3), Int(2), Int(3), Int(100), Int(3))),
      CmpOp("==", ListExpr(Int(3), Int(3), Int(3), Int(100), Int(100))))))
