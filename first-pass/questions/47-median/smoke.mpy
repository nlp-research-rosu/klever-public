Module(
  FuncDef("median", Params("l"),
    Assign(Name("m"), BinOp("//", Call(Name("len"), Name("l")), Int(2)))
    Assign(Name("s"), Call(Name("sorted"), Name("l")))
    Return(Subscript(Name("s"), Name("m"))))
  Assert(
    Compare(
      Call(
        Name("median"),
        ListExpr(Int(3), Int(1), Int(2), Int(4), Int(5))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(Call(Name("median"), ListExpr(Int(1))), CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(
        Name("median"),
        ListExpr(Int(7), Int(2), Int(10), Int(5), Int(8))),
      CmpOp("==", Int(7))))
  Assert(
    Compare(
      Call(
        Name("median"),
        ListExpr(
          UnaryOp("-", Int(5)),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(3)))),
      CmpOp("==", UnaryOp("-", Int(3)))))
  Assert(
    Compare(
      Call(
        Name("median"),
        ListExpr(Int(5), Int(3), Int(1), Int(2), Int(4), Int(6), Int(7))),
      CmpOp("==", Int(4)))))
