Module(
  FuncDef("compare", Params("game", "guess"),
    Return(
      ListComp(Call(Name("abs"), BinOp("-", Name("x"), Name("y"))),
        CompFor(
          TupleExpr(Name("x"), Name("y")),
          Call(Name("zip"), Name("game"), Name("guess")),
          Bool(true)))))
  Assert(
    Compare(
      Call(
        Name("compare"),
        ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(1)),
        ListExpr(
          Int(1),
          Int(2),
          Int(3),
          Int(4),
          Int(2),
          UnaryOp("-", Int(2)))),
      CmpOp(
        "==",
        ListExpr(Int(0), Int(0), Int(0), Int(0), Int(3), Int(3)))))
  Assert(
    Compare(
      Call(
        Name("compare"),
        ListExpr(Int(0), Int(0), Int(0), Int(0), Int(0), Int(0)),
        ListExpr(Int(0), Int(0), Int(0), Int(0), Int(0), Int(0))),
      CmpOp(
        "==",
        ListExpr(Int(0), Int(0), Int(0), Int(0), Int(0), Int(0)))))
  Assert(
    Compare(
      Call(
        Name("compare"),
        ListExpr(Int(1), Int(2), Int(3)),
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(3)))),
      CmpOp("==", ListExpr(Int(2), Int(4), Int(6)))))
  Assert(
    Compare(
      Call(
        Name("compare"),
        ListExpr(Int(1), Int(2), Int(3), Int(5)),
        ListExpr(UnaryOp("-", Int(1)), Int(2), Int(3), Int(4))),
      CmpOp("==", ListExpr(Int(2), Int(0), Int(0), Int(1))))))
