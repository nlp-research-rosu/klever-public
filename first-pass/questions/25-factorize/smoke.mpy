Module(
  FuncDef("factorize", Params("n"),
    Assign(Name("fact"), ListExpr())
    Assign(Name("i"), Int(2))
    While(Compare(Name("i"), CmpOp("<=", Name("n"))),
      If(Compare(BinOp("%", Name("n"), Name("i")), CmpOp("==", Int(0))),
        Assign(
          Name("fact"),
          BinOp("+", Name("fact"), ListExpr(Name("i"))))
        Assign(Name("n"), BinOp("//", Name("n"), Name("i"))),
        Assign(Name("i"), BinOp("+", Name("i"), Int(1)))))
    Return(Name("fact")))
  Assert(
    Compare(
      Call(Name("factorize"), Int(8)),
      CmpOp("==", ListExpr(Int(2), Int(2), Int(2)))))
  Assert(
    Compare(
      Call(Name("factorize"), Int(25)),
      CmpOp("==", ListExpr(Int(5), Int(5)))))
  Assert(
    Compare(
      Call(Name("factorize"), Int(70)),
      CmpOp("==", ListExpr(Int(2), Int(5), Int(7))))))
