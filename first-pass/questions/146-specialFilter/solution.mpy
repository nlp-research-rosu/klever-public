Module(
  FuncDef("specialFilter", Params("nums"),
    Assign(Name("count"), Int(0))
    For(Name("num"), Name("nums"),
      If(Compare(Name("num"), CmpOp(">", Int(10))),
        Assign(
          Name("odd_digits"),
          TupleExpr(Int(1), Int(3), Int(5), Int(7), Int(9)))
        Assign(Name("number_as_string"), Call(Name("str"), Name("num")))
        If(BoolOp(
          "and",
          Compare(
            Call(
              Name("int"),
              Subscript(Name("number_as_string"), Int(0))),
            CmpOp("in", Name("odd_digits"))),
          Compare(
            Call(
              Name("int"),
              Subscript(Name("number_as_string"), UnaryOp("-", Int(1)))),
            CmpOp("in", Name("odd_digits")))),
          AugAssign(Name("count"), "+", Int(1)),
          ),
        ))
    Return(Name("count"))))
