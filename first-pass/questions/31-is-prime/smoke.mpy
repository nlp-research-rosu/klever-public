Module(
  FuncDef("is_prime", Params("n"),
    Assign(Name("prime"), Compare(Name("n"), CmpOp(">=", Int(2))))
    Assign(Name("k"), Int(0))
    For(Name("k"), Call(Name("range"), Int(2), BinOp("-", Name("n"), Int(1))),
      If(Compare(BinOp("%", Name("n"), Name("k")), CmpOp("==", Int(0))),
        Assign(Name("prime"), Bool(false)),
        ))
    Return(Name("prime")))
  Assert(UnaryOp("not", Call(Name("is_prime"), Int(6))))
  Assert(Call(Name("is_prime"), Int(101)))
  Assert(Call(Name("is_prime"), Int(11)))
  Assert(Call(Name("is_prime"), Int(61)))
  Assert(UnaryOp("not", Call(Name("is_prime"), Int(4))))
  Assert(UnaryOp("not", Call(Name("is_prime"), Int(1))))
  Assert(Call(Name("is_prime"), Int(5)))
  Assert(Call(Name("is_prime"), Int(17))))
