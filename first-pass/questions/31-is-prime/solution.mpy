Module(
  FuncDef("is_prime", Params("n"),
    Assign(Name("prime"), Compare(Name("n"), CmpOp(">=", Int(2))))
    Assign(Name("k"), Int(0))
    For(Name("k"), Call(Name("range"), Int(2), BinOp("-", Name("n"), Int(1))),
      If(Compare(BinOp("%", Name("n"), Name("k")), CmpOp("==", Int(0))),
        Assign(Name("prime"), Bool(false)),
        ))
    Return(Name("prime"))))
