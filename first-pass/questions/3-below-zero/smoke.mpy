Module(
  FuncDef("below_zero", Params("operations"),
    Assign(Name("balance"), Int(0))
    For(Name("op"), Name("operations"),
      AugAssign(Name("balance"), "+", Name("op"))
      If(Compare(Name("balance"), CmpOp("<", Int(0))),
        Return(Bool(true)),
        ))
    Return(Bool(false)))
  Assert(UnaryOp("not", Call(Name("below_zero"), ListExpr())))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("below_zero"),
        ListExpr(
          Int(1),
          Int(2),
          UnaryOp("-", Int(3)),
          Int(1),
          Int(2),
          UnaryOp("-", Int(3))))))
  Assert(
    Call(
      Name("below_zero"),
      ListExpr(Int(1), Int(2), UnaryOp("-", Int(4)), Int(5), Int(6))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("below_zero"),
        ListExpr(
          Int(1),
          UnaryOp("-", Int(1)),
          Int(2),
          UnaryOp("-", Int(2)),
          Int(5),
          UnaryOp("-", Int(5)),
          Int(4),
          UnaryOp("-", Int(4))))))
  Assert(
    Call(
      Name("below_zero"),
      ListExpr(
        Int(1),
        UnaryOp("-", Int(1)),
        Int(2),
        UnaryOp("-", Int(2)),
        Int(5),
        UnaryOp("-", Int(5)),
        Int(4),
        UnaryOp("-", Int(5)))))
  Assert(
    Call(
      Name("below_zero"),
      ListExpr(
        Int(1),
        UnaryOp("-", Int(2)),
        Int(2),
        UnaryOp("-", Int(2)),
        Int(5),
        UnaryOp("-", Int(5)),
        Int(4),
        UnaryOp("-", Int(4))))))
