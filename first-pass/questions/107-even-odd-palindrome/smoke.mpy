Module(
  FuncDef("even_odd_palindrome", Params("n"),
    FuncDef("is_palindrome", Params("n"), CellVars(), FreeVars(),
      Return(
        Compare(
          Call(Name("str"), Name("n")),
          CmpOp(
            "==",
            Subscript(
              Call(Name("str"), Name("n")),
              Slice(NoBound, NoBound, UnaryOp("-", Int(1))))))))
    Assign(Name("even_palindrome_count"), Int(0))
    Assign(Name("odd_palindrome_count"), Int(0))
    For(Name("i"), Call(Name("range"), Int(1), BinOp("+", Name("n"), Int(1))),
      If(BoolOp(
        "and",
        Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(1))),
        Call(Name("is_palindrome"), Name("i"))),
        AugAssign(Name("odd_palindrome_count"), "+", Int(1)),
        If(BoolOp(
          "and",
          Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
          Call(Name("is_palindrome"), Name("i"))),
          AugAssign(Name("even_palindrome_count"), "+", Int(1)),
          )))
    Return(
      TupleExpr(
        Name("even_palindrome_count"),
        Name("odd_palindrome_count"))))
  Assert(
    Compare(
      Call(Name("even_odd_palindrome"), Int(3)),
      CmpOp("==", TupleExpr(Int(1), Int(2)))))
  Assert(
    Compare(
      Call(Name("even_odd_palindrome"), Int(12)),
      CmpOp("==", TupleExpr(Int(4), Int(6)))))
  Assert(
    Compare(
      Call(Name("even_odd_palindrome"), Int(1)),
      CmpOp("==", TupleExpr(Int(0), Int(1)))))
  Assert(
    Compare(
      Call(Name("even_odd_palindrome"), Int(0)),
      CmpOp("==", TupleExpr(Int(0), Int(0))))))
