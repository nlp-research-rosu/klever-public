Module(
  FuncDef("encrypt", Params("s"),
    Assign(Name("out"), Str(""))
    Assign(Name("c"), Str(""))
    Assign(Name("code"), Int(0))
    Assign(Name("new"), Int(0))
    For(Name("c"), Name("s"),
      Assign(Name("code"), Call(Name("ord"), Name("c")))
      Assign(Name("new"), Name("code"))
      If(BoolOp(
        "and",
        Compare(Name("code"), CmpOp(">=", Int(97))),
        Compare(Name("code"), CmpOp("<=", Int(122)))),
        Assign(
          Name("new"),
          BinOp(
            "+",
            BinOp(
              "%",
              BinOp("+", BinOp("-", Name("code"), Int(97)), Int(4)),
              Int(26)),
            Int(97))),
        )
      Assign(
        Name("out"),
        BinOp("+", Name("out"), Call(Name("chr"), Name("new")))))
    Return(Name("out"))))
