Module(
  FuncDef("encrypt", Params("s"),
    Assign(Name("out"), Str(""))
    Assign(Name("c"), Str(""))
    Assign(Name("code"), Int(0))
    Assign(Name("new"), Int(0))
    For(Name("c"), Name("s"),
      Assign(Name("code"), Call(Name("ord"), Name("c")))
      Assign(Name("new"), Name("code"))
      If(BoolOp(
        "and",
        Compare(Name("code"), CmpOp(">=", Int(97))),
        Compare(Name("code"), CmpOp("<=", Int(122)))),
        Assign(
          Name("new"),
          BinOp(
            "+",
            BinOp(
              "%",
              BinOp("+", BinOp("-", Name("code"), Int(97)), Int(4)),
              Int(26)),
            Int(97))),
        )
      Assign(
        Name("out"),
        BinOp("+", Name("out"), Call(Name("chr"), Name("new")))))
    Return(Name("out")))
  Assert(
    Compare(Call(Name("encrypt"), Str("hi")), CmpOp("==", Str("lm"))))
  Assert(
    Compare(
      Call(Name("encrypt"), Str("asdfghjkl")),
      CmpOp("==", Str("ewhjklnop"))))
  Assert(
    Compare(Call(Name("encrypt"), Str("gf")), CmpOp("==", Str("kj"))))
  Assert(
    Compare(Call(Name("encrypt"), Str("et")), CmpOp("==", Str("ix"))))
  Assert(
    Compare(
      Call(Name("encrypt"), Str("faewfawefaewg")),
      CmpOp("==", Str("jeiajeaijeiak"))))
  Assert(
    Compare(
      Call(Name("encrypt"), Str("hellomyfriend")),
      CmpOp("==", Str("lippsqcjvmirh"))))
  Assert(
    Compare(Call(Name("encrypt"), Str("a")), CmpOp("==", Str("e")))))
