Module(
  FuncDef("triples_sum_to_zero", Params("l"),
    Assign(Name("n"), Call(Name("len"), Name("l")))
    Assign(Name("found"), Bool(false))
    Assign(Name("i"), Int(0))
    Assign(Name("j"), Int(0))
    Assign(Name("k"), Int(0))
    For(Name("i"), Call(Name("range"), Int(0), Name("n")),
      For(Name("j"), Call(Name("range"), BinOp("+", Name("i"), Int(1)), Name("n")),
        For(Name("k"), Call(Name("range"), BinOp("+", Name("j"), Int(1)), Name("n")),
          If(Compare(
            BinOp(
              "+",
              BinOp(
                "+",
                Subscript(Name("l"), Name("i")),
                Subscript(Name("l"), Name("j"))),
              Subscript(Name("l"), Name("k"))),
            CmpOp("==", Int(0))),
            Assign(Name("found"), Bool(true)),
            ))))
    Return(Name("found")))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("triples_sum_to_zero"),
        ListExpr(Int(1), Int(3), Int(5), Int(0)))))
  Assert(
    Call(
      Name("triples_sum_to_zero"),
      ListExpr(Int(1), Int(3), UnaryOp("-", Int(2)), Int(1))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("triples_sum_to_zero"),
        ListExpr(Int(1), Int(2), Int(3), Int(7)))))
  Assert(
    Call(
      Name("triples_sum_to_zero"),
      ListExpr(
        Int(2),
        Int(4),
        UnaryOp("-", Int(5)),
        Int(3),
        Int(9),
        Int(7))))
  Assert(
    UnaryOp("not", Call(Name("triples_sum_to_zero"), ListExpr(Int(1))))))
