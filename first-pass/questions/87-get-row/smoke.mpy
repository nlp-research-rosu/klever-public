Module(
  FuncDef("get_row", Params("lst", "x"),
    Assign(Name("coords"), ListExpr())
    Assign(Name("m"), Call(Name("len"), Name("lst")))
    Assign(Name("i"), Int(0))
    Assign(Name("jj"), Int(0))
    Assign(Name("j"), Int(0))
    Assign(Name("k"), Int(0))
    For(Name("i"), Call(Name("range"), Int(0), Name("m")),
      Assign(
        Name("k"),
        Call(Name("len"), Subscript(Name("lst"), Name("i"))))
      For(Name("jj"), Call(Name("range"), Int(0), Name("k")),
        Assign(
          Name("j"),
          BinOp("-", BinOp("-", Name("k"), Int(1)), Name("jj")))
        If(Compare(
          Subscript(Subscript(Name("lst"), Name("i")), Name("j")),
          CmpOp("==", Name("x"))),
          Assign(
            Name("coords"),
            BinOp(
              "+",
              Name("coords"),
              ListExpr(TupleExpr(Name("i"), Name("j"))))),
          )))
    Return(Name("coords")))
  Assert(
    Compare(
      Call(
        Name("get_row"),
        ListExpr(
          ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(6)),
          ListExpr(Int(1), Int(2), Int(3), Int(4), Int(1), Int(6)),
          ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(1))),
        Int(1)),
      CmpOp(
        "==",
        ListExpr(
          TupleExpr(Int(0), Int(0)),
          TupleExpr(Int(1), Int(4)),
          TupleExpr(Int(1), Int(0)),
          TupleExpr(Int(2), Int(5)),
          TupleExpr(Int(2), Int(0))))))
  Assert(
    Compare(
      Call(
        Name("get_row"),
        ListExpr(
          ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(6)),
          ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(6)),
          ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(6)),
          ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(6)),
          ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(6)),
          ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(6))),
        Int(2)),
      CmpOp(
        "==",
        ListExpr(
          TupleExpr(Int(0), Int(1)),
          TupleExpr(Int(1), Int(1)),
          TupleExpr(Int(2), Int(1)),
          TupleExpr(Int(3), Int(1)),
          TupleExpr(Int(4), Int(1)),
          TupleExpr(Int(5), Int(1))))))
  Assert(
    Compare(
      Call(Name("get_row"), ListExpr(), Int(1)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("get_row"),
        ListExpr(
          ListExpr(Int(1), Int(2)),
          ListExpr(Int(3), Int(4), Int(5)),
          ListExpr(Int(3))),
        Int(3)),
      CmpOp(
        "==",
        ListExpr(TupleExpr(Int(1), Int(0)), TupleExpr(Int(2), Int(0)))))))
