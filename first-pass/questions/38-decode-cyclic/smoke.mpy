Module(
  FuncDef("decode_cyclic", Params("s"),
    Assign(Name("result"), Str(""))
    Assign(Name("c0"), Str(""))
    Assign(Name("c1"), Str(""))
    Assign(Name("buf"), Str(""))
    Assign(Name("count"), Int(0))
    Assign(Name("ch"), Str(""))
    For(Name("ch"), Name("s"),
      If(Compare(Name("count"), CmpOp("==", Int(0))),
        Assign(Name("c0"), Name("ch")),
        If(Compare(Name("count"), CmpOp("==", Int(1))),
          Assign(Name("c1"), Name("ch")),
          ))
      Assign(Name("buf"), BinOp("+", Name("buf"), Name("ch")))
      Assign(Name("count"), BinOp("+", Name("count"), Int(1)))
      If(Compare(Name("count"), CmpOp("==", Int(3))),
        Assign(
          Name("result"),
          BinOp(
            "+",
            BinOp(
              "+",
              BinOp("+", Name("result"), Name("ch")),
              Name("c0")),
            Name("c1")))
        Assign(Name("buf"), Str(""))
        Assign(Name("count"), Int(0)),
        ))
    Assign(Name("result"), BinOp("+", Name("result"), Name("buf")))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("abc")),
      CmpOp("==", Str("cab"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("abcdef")),
      CmpOp("==", Str("cabfde"))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("ab")),
      CmpOp("==", Str("ab"))))
  Assert(
    Compare(Call(Name("decode_cyclic"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("decode_cyclic"), Str("abcde")),
      CmpOp("==", Str("cabde")))))
