Module(
  FuncDef("split_words", Params("txt"),
    If(Compare(Str(" "), CmpOp("in", Name("txt"))),
      Return(Call(Attribute(Name("txt"), "split"), )),
      If(Compare(Str(","), CmpOp("in", Name("txt"))),
        Return(
          Call(
            Attribute(
              Call(
                Attribute(Name("txt"), "replace"),
                Str(","),
                Str(" ")),
              "split"),
            )),
        Assign(Name("count"), Int(0))
        Assign(Name("i"), Int(0))
        For(Name("i"), Call(Name("range"), Call(Name("len"), Name("txt"))),
          If(BoolOp(
            "and",
            Call(
              Attribute(Subscript(Name("txt"), Name("i")), "islower"),
              ),
            Compare(
              BinOp(
                "%",
                Call(Name("ord"), Subscript(Name("txt"), Name("i"))),
                Int(2)),
              CmpOp("==", Int(0)))),
            Assign(Name("count"), BinOp("+", Name("count"), Int(1))),
            ))
        Return(Name("count")))))
  Assert(
    Compare(
      Call(Name("split_words"), Str("Hello world!")),
      CmpOp("==", ListExpr(Str("Hello"), Str("world!")))))
  Assert(
    Compare(
      Call(Name("split_words"), Str("Hello,world!")),
      CmpOp("==", ListExpr(Str("Hello"), Str("world!")))))
  Assert(
    Compare(
      Call(Name("split_words"), Str("Hello world,!")),
      CmpOp("==", ListExpr(Str("Hello"), Str("world,!")))))
  Assert(
    Compare(
      Call(Name("split_words"), Str("Hello,Hello,world !")),
      CmpOp("==", ListExpr(Str("Hello,Hello,world"), Str("!")))))
  Assert(
    Compare(
      Call(Name("split_words"), Str("abcdef")),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("split_words"), Str("aaabb")),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("split_words"), Str("aaaBb")),
      CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("split_words"), Str("")), CmpOp("==", Int(0)))))
