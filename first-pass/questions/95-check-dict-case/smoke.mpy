Module(
  FuncDef("check_dict_case", Params("d"),
    Assign(
      Name("keys"),
      Call(Name("list"), Call(Attribute(Name("d"), "keys"), )))
    Assign(Name("n"), Call(Name("len"), Name("keys")))
    If(Compare(Name("n"), CmpOp("==", Int(0))),
      Return(Bool(false)),
      )
    Assign(Name("k0"), Subscript(Name("keys"), Int(0)))
    If(UnaryOp("not", Call(Name("isinstance"), Name("k0"), Name("str"))),
      Return(Bool(false)),
      )
    If(Call(Attribute(Name("k0"), "isupper"), ),
      Assign(Name("first"), Str("upper")),
      If(Call(Attribute(Name("k0"), "islower"), ),
        Assign(Name("first"), Str("lower")),
        Return(Bool(false))))
    If(Compare(Name("n"), CmpOp("==", Int(1))),
      Return(Bool(true)),
      )
    Assign(Name("k1"), Subscript(Name("keys"), Int(1)))
    If(UnaryOp("not", Call(Name("isinstance"), Name("k1"), Name("str"))),
      Return(Bool(false)),
      )
    If(Compare(Name("first"), CmpOp("==", Str("upper"))),
      Return(Call(Attribute(Name("k1"), "isupper"), )),
      Return(Call(Attribute(Name("k1"), "islower"), ))))
  Assert(
    Call(
      Name("check_dict_case"),
      DictExpr(
        Entry(Str("p"), Str("pineapple")),
        Entry(Str("b"), Str("banana")))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("check_dict_case"),
        DictExpr(
          Entry(Str("p"), Str("pineapple")),
          Entry(Str("A"), Str("banana")),
          Entry(Str("B"), Str("banana"))))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("check_dict_case"),
        DictExpr(
          Entry(Str("p"), Str("pineapple")),
          Entry(Int(5), Str("banana")),
          Entry(Str("a"), Str("apple"))))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("check_dict_case"),
        DictExpr(
          Entry(Str("Name"), Str("John")),
          Entry(Str("Age"), Str("36")),
          Entry(Str("City"), Str("Houston"))))))
  Assert(
    Call(
      Name("check_dict_case"),
      DictExpr(
        Entry(Str("STATE"), Str("NC")),
        Entry(Str("ZIP"), Str("12345")))))
  Assert(
    Call(
      Name("check_dict_case"),
      DictExpr(
        Entry(Str("fruit"), Str("Orange")),
        Entry(Str("taste"), Str("Sweet")))))
  Assert(UnaryOp("not", Call(Name("check_dict_case"), DictExpr()))))
