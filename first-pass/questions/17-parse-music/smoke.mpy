Module(
  FuncDef("parse_music", Params("music_string"),
    Assign(
      Name("note_map"),
      DictExpr(
        Entry(Str("o"), Int(4)),
        Entry(Str("o|"), Int(2)),
        Entry(Str(".|"), Int(1))))
    Return(
      ListComp(Subscript(Name("note_map"), Name("x")),
        CompFor(
          Name("x"),
          Call(Attribute(Name("music_string"), "split"), Str(" ")),
          Name("x")))))
  Assert(
    Compare(Call(Name("parse_music"), Str("")), CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("parse_music"), Str("o o o o")),
      CmpOp("==", ListExpr(Int(4), Int(4), Int(4), Int(4)))))
  Assert(
    Compare(
      Call(Name("parse_music"), Str(".| .| .| .|")),
      CmpOp("==", ListExpr(Int(1), Int(1), Int(1), Int(1)))))
  Assert(
    Compare(
      Call(Name("parse_music"), Str("o| o| .| .| o o o o")),
      CmpOp(
        "==",
        ListExpr(
          Int(2),
          Int(2),
          Int(1),
          Int(1),
          Int(4),
          Int(4),
          Int(4),
          Int(4)))))
  Assert(
    Compare(
      Call(Name("parse_music"), Str("o| .| o| .| o o| o o|")),
      CmpOp(
        "==",
        ListExpr(
          Int(2),
          Int(1),
          Int(2),
          Int(1),
          Int(4),
          Int(2),
          Int(4),
          Int(2))))))
