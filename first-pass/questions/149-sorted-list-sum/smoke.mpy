Module(
  FuncDef("sorted_list_sum", Params("lst"),
    Expr(Call(Attribute(Name("lst"), "sort"), ))
    Assign(Name("new_lst"), ListExpr())
    For(Name("i"), Name("lst"),
      If(Compare(
        BinOp("%", Call(Name("len"), Name("i")), Int(2)),
        CmpOp("==", Int(0))),
        Expr(Call(Attribute(Name("new_lst"), "append"), Name("i"))),
        ))
    Return(
      Call(Name("sorted"), Name("new_lst"), KwArg("key", Name("len")))))
  Assert(
    Compare(
      Call(
        Name("sorted_list_sum"),
        ListExpr(Str("aa"), Str("a"), Str("aaa"))),
      CmpOp("==", ListExpr(Str("aa")))))
  Assert(
    Compare(
      Call(
        Name("sorted_list_sum"),
        ListExpr(Str("school"), Str("AI"), Str("asdf"), Str("b"))),
      CmpOp("==", ListExpr(Str("AI"), Str("asdf"), Str("school")))))
  Assert(
    Compare(
      Call(
        Name("sorted_list_sum"),
        ListExpr(Str("d"), Str("b"), Str("c"), Str("a"))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("sorted_list_sum"),
        ListExpr(Str("d"), Str("dcba"), Str("abcd"), Str("a"))),
      CmpOp("==", ListExpr(Str("abcd"), Str("dcba")))))
  Assert(
    Compare(
      Call(
        Name("sorted_list_sum"),
        ListExpr(Str("AI"), Str("ai"), Str("au"))),
      CmpOp("==", ListExpr(Str("AI"), Str("ai"), Str("au")))))
  Assert(
    Compare(
      Call(
        Name("sorted_list_sum"),
        ListExpr(
          Str("a"),
          Str("b"),
          Str("b"),
          Str("c"),
          Str("c"),
          Str("a"))),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("sorted_list_sum"),
        ListExpr(Str("aaaa"), Str("bbbb"), Str("dd"), Str("cc"))),
      CmpOp(
        "==",
        ListExpr(Str("cc"), Str("dd"), Str("aaaa"), Str("bbbb"))))))
