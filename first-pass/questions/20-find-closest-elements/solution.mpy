Module(
  FuncDef("find_closest_elements", Params("numbers"),
    Assign(Name("n"), Call(Name("len"), Name("numbers")))
    Assign(
      Name("dist"),
      Call(
        Name("abs"),
        BinOp(
          "-",
          Subscript(Name("numbers"), Int(0)),
          Subscript(Name("numbers"), Int(1)))))
    Assign(
      Name("lo"),
      Call(
        Name("min"),
        Subscript(Name("numbers"), Int(0)),
        Subscript(Name("numbers"), Int(1))))
    Assign(
      Name("hi"),
      Call(
        Name("max"),
        Subscript(Name("numbers"), Int(0)),
        Subscript(Name("numbers"), Int(1))))
    Assign(Name("i"), Int(0))
    Assign(Name("j"), Int(0))
    Assign(Name("d"), Int(0))
    For(Name("i"), Call(Name("range"), Int(0), Name("n")),
      For(Name("j"), Call(Name("range"), Int(0), Name("n")),
        If(Compare(Name("i"), CmpOp("!=", Name("j"))),
          Assign(
            Name("d"),
            Call(
              Name("abs"),
              BinOp(
                "-",
                Subscript(Name("numbers"), Name("i")),
                Subscript(Name("numbers"), Name("j")))))
          If(Compare(Name("d"), CmpOp("<", Name("dist"))),
            Assign(Name("dist"), Name("d"))
            Assign(
              Name("lo"),
              Call(
                Name("min"),
                Subscript(Name("numbers"), Name("i")),
                Subscript(Name("numbers"), Name("j"))))
            Assign(
              Name("hi"),
              Call(
                Name("max"),
                Subscript(Name("numbers"), Name("i")),
                Subscript(Name("numbers"), Name("j")))),
            ),
          )))
    Return(TupleExpr(Name("lo"), Name("hi")))))
