Module(
  FuncDef("double_the_difference", Params("lst"),
    Assign(Name("result"), Int(0))
    Assign(Name("e"), Int(0))
    For(Name("e"), Name("lst"),
      If(Compare(Name("e"), CmpOp(">", Int(0))),
        If(Compare(BinOp("%", Name("e"), Int(2)), CmpOp("==", Int(1))),
          Assign(
            Name("result"),
            BinOp("+", Name("result"), BinOp("*", Name("e"), Name("e")))),
          ),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("double_the_difference"),
        ListExpr(Int(1), Int(3), Int(2), Int(0))),
      CmpOp("==", Int(10))))
  Assert(
    Compare(
      Call(
        Name("double_the_difference"),
        ListExpr(UnaryOp("-", Int(1)), UnaryOp("-", Int(2)), Int(0))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("double_the_difference"),
        ListExpr(Int(9), UnaryOp("-", Int(2)))),
      CmpOp("==", Int(81))))
  Assert(
    Compare(
      Call(Name("double_the_difference"), ListExpr(Int(0))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("double_the_difference"), ListExpr(Int(5), Int(4))),
      CmpOp("==", Int(25))))
  Assert(
    Compare(
      Call(
        Name("double_the_difference"),
        ListExpr(
          UnaryOp("-", Int(10)),
          UnaryOp("-", Int(20)),
          UnaryOp("-", Int(30)))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("double_the_difference"),
        ListExpr(UnaryOp("-", Int(1)), UnaryOp("-", Int(2)), Int(8))),
      CmpOp("==", Int(0)))))
