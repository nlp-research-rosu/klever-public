Module(
  FuncDef("double_the_difference", Params("lst"),
    Assign(Name("result"), Int(0))
    Assign(Name("e"), Int(0))
    For(Name("e"), Name("lst"),
      If(Compare(Name("e"), CmpOp(">", Int(0))),
        If(Compare(BinOp("%", Name("e"), Int(2)), CmpOp("==", Int(1))),
          Assign(
            Name("result"),
            BinOp("+", Name("result"), BinOp("*", Name("e"), Name("e")))),
          ),
        ))
    Return(Name("result"))))
