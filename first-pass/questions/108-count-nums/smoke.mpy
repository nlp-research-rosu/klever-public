Module(
  FuncDef("count_nums", Params("arr"),
    FuncDef("digits_sum", Params("n"), CellVars(), FreeVars(),
      Assign(Name("neg"), Int(1))
      If(Compare(Name("n"), CmpOp("<", Int(0))),
        Assign(
          TupleExpr(Name("n"), Name("neg")),
          TupleExpr(
            BinOp("*", UnaryOp("-", Int(1)), Name("n")),
            UnaryOp("-", Int(1)))),
        )
      Assign(
        Name("n"),
        ListComp(Call(Name("int"), Name("i")),
          CompFor(Name("i"), Call(Name("str"), Name("n")), Bool(true))))
      Assign(
        Subscript(Name("n"), Int(0)),
        BinOp("*", Subscript(Name("n"), Int(0)), Name("neg")))
      Return(Call(Name("sum"), Name("n"))))
    Assign(
      Name("ds"),
      ListComp(Call(Name("digits_sum"), Name("i")),
        CompFor(Name("i"), Name("arr"), Bool(true))))
    Return(
      Call(
        Name("len"),
        ListComp(Name("v"),
          CompFor(
            Name("v"),
            Name("ds"),
            Compare(Name("v"), CmpOp(">", Int(0))))))))
  Assert(
    Compare(Call(Name("count_nums"), ListExpr()), CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("count_nums"),
        ListExpr(UnaryOp("-", Int(1)), Int(11), UnaryOp("-", Int(11)))),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("count_nums"), ListExpr(Int(1), Int(1), Int(2))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("count_nums"), ListExpr(UnaryOp("-", Int(123)))),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("count_nums"), ListExpr(Int(0), Int(0), Int(0))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("count_nums"),
        ListExpr(
          Int(10),
          UnaryOp("-", Int(10)),
          Int(100),
          UnaryOp("-", Int(100)))),
      CmpOp("==", Int(2)))))
