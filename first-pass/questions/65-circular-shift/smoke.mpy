Module(
  FuncDef("circular_shift", Params("x", "shift"),
    Assign(Name("s"), Call(Name("str"), Name("x")))
    If(Compare(Name("shift"), CmpOp(">", Call(Name("len"), Name("s")))),
      Return(
        Subscript(
          Name("s"),
          Slice(NoBound, NoBound, UnaryOp("-", Int(1))))),
      Return(
        BinOp(
          "+",
          Subscript(
            Name("s"),
            Slice(
              BinOp("-", Call(Name("len"), Name("s")), Name("shift")),
              NoBound,
              NoBound)),
          Subscript(
            Name("s"),
            Slice(
              NoBound,
              BinOp("-", Call(Name("len"), Name("s")), Name("shift")),
              NoBound))))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(12), Int(1)),
      CmpOp("==", Str("21"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(12), Int(2)),
      CmpOp("==", Str("12"))))
  Assert(
    Compare(
      Call(Name("circular_shift"), Int(100), Int(5)),
      CmpOp("==", Str("001")))))
