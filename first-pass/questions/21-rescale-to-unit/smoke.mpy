Module(
  FuncDef("rescale_to_unit", Params("numbers"),
    Assign(Name("min_number"), Call(Name("min"), Name("numbers")))
    Assign(Name("max_number"), Call(Name("max"), Name("numbers")))
    Return(
      ListComp(BinOp(
        "/",
        BinOp("-", Name("x"), Name("min_number")),
        BinOp("-", Name("max_number"), Name("min_number"))),
        CompFor(Name("x"), Name("numbers"), Bool(true)))))
  Assert(
    Compare(
      Call(Name("rescale_to_unit"), ListExpr(Float(2.0), Float(49.9))),
      CmpOp("==", ListExpr(Float(0.0), Float(1.0)))))
  Assert(
    Compare(
      Call(Name("rescale_to_unit"), ListExpr(Float(100.0), Float(49.9))),
      CmpOp("==", ListExpr(Float(1.0), Float(0.0)))))
  Assert(
    Compare(
      Call(
        Name("rescale_to_unit"),
        ListExpr(
          Float(1.0),
          Float(2.0),
          Float(3.0),
          Float(4.0),
          Float(5.0))),
      CmpOp(
        "==",
        ListExpr(
          Float(0.0),
          Float(0.25),
          Float(0.5),
          Float(0.75),
          Float(1.0))))))
