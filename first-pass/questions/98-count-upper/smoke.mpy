Module(
  FuncDef("count_upper", Params("s"),
    Assign(Name("count"), Int(0))
    Assign(Name("i"), Int(0))
    Assign(Name("c"), Str(""))
    Assign(Name("code"), Int(0))
    For(Name("c"), Name("s"),
      Assign(Name("code"), Call(Name("ord"), Name("c")))
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
        If(BoolOp(
          "or",
          Compare(Name("code"), CmpOp("==", Int(65))),
          Compare(Name("code"), CmpOp("==", Int(69))),
          Compare(Name("code"), CmpOp("==", Int(73))),
          Compare(Name("code"), CmpOp("==", Int(79))),
          Compare(Name("code"), CmpOp("==", Int(85)))),
          Assign(Name("count"), BinOp("+", Name("count"), Int(1))),
          ),
        )
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(Name("count")))
  Assert(
    Compare(
      Call(Name("count_upper"), Str("aBCdEf")),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("count_upper"), Str("abcdefg")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("count_upper"), Str("dBBE")), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("count_upper"), Str("B")), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("count_upper"), Str("U")), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("count_upper"), Str("")), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("count_upper"), Str("EEEE")), CmpOp("==", Int(2)))))
