Module(
  FuncDef("words_in_sentence", Params("sentence"),
    Assign(Name("new_lst"), ListExpr())
    For(Name("word"), Call(Attribute(Name("sentence"), "split"), ),
      Assign(Name("flg"), Int(0))
      If(Compare(Call(Name("len"), Name("word")), CmpOp("==", Int(1))),
        Assign(Name("flg"), Int(1)),
        )
      For(Name("i"), Call(Name("range"), Int(2), Call(Name("len"), Name("word"))),
        If(Compare(
          BinOp("%", Call(Name("len"), Name("word")), Name("i")),
          CmpOp("==", Int(0))),
          Assign(Name("flg"), Int(1)),
          ))
      If(BoolOp(
        "or",
        Compare(Name("flg"), CmpOp("==", Int(0))),
        Compare(Call(Name("len"), Name("word")), CmpOp("==", Int(2)))),
        Expr(Call(Attribute(Name("new_lst"), "append"), Name("word"))),
        ))
    Return(Call(Attribute(Str(" "), "join"), Name("new_lst"))))
  Assert(
    Compare(
      Call(Name("words_in_sentence"), Str("This is a test")),
      CmpOp("==", Str("is"))))
  Assert(
    Compare(
      Call(Name("words_in_sentence"), Str("lets go for swimming")),
      CmpOp("==", Str("go for"))))
  Assert(
    Compare(
      Call(
        Name("words_in_sentence"),
        Str("there is no place available here")),
      CmpOp("==", Str("there is no place"))))
  Assert(
    Compare(
      Call(Name("words_in_sentence"), Str("Hi I am Hussein")),
      CmpOp("==", Str("Hi am Hussein"))))
  Assert(
    Compare(
      Call(Name("words_in_sentence"), Str("go for it")),
      CmpOp("==", Str("go for it"))))
  Assert(
    Compare(
      Call(Name("words_in_sentence"), Str("here")),
      CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("words_in_sentence"), Str("here is")),
      CmpOp("==", Str("is")))))
