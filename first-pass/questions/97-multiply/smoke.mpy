Module(
  FuncDef("multiply", Params("a", "b"),
    Return(
      BinOp(
        "*",
        Call(Name("abs"), BinOp("%", Name("a"), Int(10))),
        Call(Name("abs"), BinOp("%", Name("b"), Int(10))))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(148), Int(412)),
      CmpOp("==", Int(16))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(19), Int(28)),
      CmpOp("==", Int(72))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(2020), Int(1851)),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(14), UnaryOp("-", Int(15))),
      CmpOp("==", Int(20))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(76), Int(67)),
      CmpOp("==", Int(42))))
  Assert(
    Compare(
      Call(Name("multiply"), Int(17), Int(27)),
      CmpOp("==", Int(49))))
  Assert(
    Compare(Call(Name("multiply"), Int(0), Int(1)), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("multiply"), Int(0), Int(0)), CmpOp("==", Int(0)))))
