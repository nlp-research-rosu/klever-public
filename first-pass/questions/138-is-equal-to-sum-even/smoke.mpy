Module(
  FuncDef("is_equal_to_sum_even", Params("n"),
    Return(
      BoolOp(
        "and",
        Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0))),
        Compare(Name("n"), CmpOp(">=", Int(8))))))
  Assert(UnaryOp("not", Call(Name("is_equal_to_sum_even"), Int(4))))
  Assert(UnaryOp("not", Call(Name("is_equal_to_sum_even"), Int(6))))
  Assert(Call(Name("is_equal_to_sum_even"), Int(8)))
  Assert(Call(Name("is_equal_to_sum_even"), Int(10)))
  Assert(UnaryOp("not", Call(Name("is_equal_to_sum_even"), Int(11))))
  Assert(Call(Name("is_equal_to_sum_even"), Int(12)))
  Assert(UnaryOp("not", Call(Name("is_equal_to_sum_even"), Int(13))))
  Assert(Call(Name("is_equal_to_sum_even"), Int(16))))
