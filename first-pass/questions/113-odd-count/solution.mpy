Module(
  FuncDef("odd_count", Params("lst"),
    Assign(Name("res"), ListExpr())
    For(Name("arr"), Name("lst"),
      Assign(Name("n"), Int(0))
      For(Name("d"), Name("arr"),
        If(Compare(
          BinOp("%", Call(Name("int"), Name("d")), Int(2)),
          CmpOp("==", Int(1))),
          Assign(Name("n"), BinOp("+", Name("n"), Int(1))),
          ))
      Expr(
        Call(
          Attribute(Name("res"), "append"),
          BinOp(
            "+",
            BinOp(
              "+",
              BinOp(
                "+",
                BinOp(
                  "+",
                  BinOp(
                    "+",
                    BinOp(
                      "+",
                      BinOp(
                        "+",
                        BinOp(
                          "+",
                          Str("the number of odd elements "),
                          Call(Name("str"), Name("n"))),
                        Str("n the str")),
                      Call(Name("str"), Name("n"))),
                    Str("ng ")),
                  Call(Name("str"), Name("n"))),
                Str(" of the ")),
              Call(Name("str"), Name("n"))),
            Str("nput.")))))
    Return(Name("res"))))
