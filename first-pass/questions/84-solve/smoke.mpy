Module(
  FuncDef("solve", Params("N"),
    Assign(Name("s"), Int(0))
    While(Compare(Name("N"), CmpOp(">", Int(0))),
      Assign(
        Name("s"),
        BinOp("+", Name("s"), BinOp("%", Name("N"), Int(10))))
      Assign(Name("N"), BinOp("//", Name("N"), Int(10))))
    If(Compare(Name("s"), CmpOp("==", Int(0))),
      Return(Str("0")),
      )
    Assign(Name("ret"), Str(""))
    While(Compare(Name("s"), CmpOp(">", Int(0))),
      Assign(
        Name("ret"),
        BinOp(
          "+",
          Call(Name("str"), BinOp("%", Name("s"), Int(2))),
          Name("ret")))
      Assign(Name("s"), BinOp("//", Name("s"), Int(2))))
    Return(Name("ret")))
  Assert(Compare(Call(Name("solve"), Int(1000)), CmpOp("==", Str("1"))))
  Assert(
    Compare(Call(Name("solve"), Int(150)), CmpOp("==", Str("110"))))
  Assert(
    Compare(Call(Name("solve"), Int(147)), CmpOp("==", Str("1100"))))
  Assert(Compare(Call(Name("solve"), Int(0)), CmpOp("==", Str("0"))))
  Assert(
    Compare(Call(Name("solve"), Int(9999)), CmpOp("==", Str("100100")))))
