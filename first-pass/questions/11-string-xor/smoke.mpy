Module(
  FuncDef("string_xor", Params("a", "b"),
    Assign(Name("result"), Str(""))
    Assign(Name("x"), Str(""))
    Assign(Name("y"), Str(""))
    For(TupleExpr(Name("x"), Name("y")), Call(Name("zip"), Name("a"), Name("b")),
      If(Compare(Name("x"), CmpOp("==", Name("y"))),
        Assign(Name("result"), BinOp("+", Name("result"), Str("0"))),
        Assign(Name("result"), BinOp("+", Name("result"), Str("1")))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("string_xor"), Str("111000"), Str("101010")),
      CmpOp("==", Str("010010"))))
  Assert(
    Compare(
      Call(Name("string_xor"), Str("1"), Str("1")),
      CmpOp("==", Str("0"))))
  Assert(
    Compare(
      Call(Name("string_xor"), Str("0101"), Str("0000")),
      CmpOp("==", Str("0101")))))
