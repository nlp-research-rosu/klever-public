Module(
  FuncDef("how_many_times", Params("string", "substring"),
    Assign(Name("times"), Int(0))
    Assign(Name("i"), Int(0))
    Assign(Name("ok"), Bool(true))
    Assign(Name("j"), Int(0))
    For(Name("i"), Call(
      Name("range"),
      BinOp(
        "+",
        BinOp(
          "-",
          Call(Name("len"), Name("string")),
          Call(Name("len"), Name("substring"))),
        Int(1))),
      Assign(Name("ok"), Bool(true))
      Assign(Name("j"), Int(0))
      For(Name("j"), Call(Name("range"), Call(Name("len"), Name("substring"))),
        If(Compare(
          Subscript(Name("string"), BinOp("+", Name("i"), Name("j"))),
          CmpOp("!=", Subscript(Name("substring"), Name("j")))),
          Assign(Name("ok"), Bool(false)),
          ))
      If(Name("ok"),
        AugAssign(Name("times"), "+", Int(1)),
        ))
    Return(Name("times")))
  Assert(
    Compare(
      Call(Name("how_many_times"), Str(""), Str("x")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("how_many_times"), Str("xyxyxyx"), Str("x")),
      CmpOp("==", Int(4))))
  Assert(
    Compare(
      Call(Name("how_many_times"), Str("cacacacac"), Str("cac")),
      CmpOp("==", Int(4))))
  Assert(
    Compare(
      Call(Name("how_many_times"), Str("john doe"), Str("john")),
      CmpOp("==", Int(1)))))
