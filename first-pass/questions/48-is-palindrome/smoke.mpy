Module(
  FuncDef("is_palindrome", Params("text"),
    For(Name("i"), Call(Name("range"), Call(Name("len"), Name("text"))),
      If(Compare(
        Subscript(Name("text"), Name("i")),
        CmpOp(
          "!=",
          Subscript(
            Name("text"),
            BinOp(
              "-",
              BinOp("-", Call(Name("len"), Name("text")), Int(1)),
              Name("i"))))),
        Return(Bool(false)),
        ))
    Return(Bool(true)))
  Assert(Call(Name("is_palindrome"), Str("")))
  Assert(Call(Name("is_palindrome"), Str("aba")))
  Assert(Call(Name("is_palindrome"), Str("aaaaa")))
  Assert(UnaryOp("not", Call(Name("is_palindrome"), Str("zbcd"))))
  Assert(Call(Name("is_palindrome"), Str("xywyx")))
  Assert(UnaryOp("not", Call(Name("is_palindrome"), Str("xywyz"))))
  Assert(UnaryOp("not", Call(Name("is_palindrome"), Str("xywzx")))))
