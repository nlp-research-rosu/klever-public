Module(
  FuncDef("anti_shuffle", Params("s"),
    Return(
      Call(
        Attribute(Str(" "), "join"),
        ListComp(Call(
          Attribute(Str(""), "join"),
          Call(Name("sorted"), Call(Name("list"), Name("i")))),
          CompFor(
            Name("i"),
            Call(Attribute(Name("s"), "split"), Str(" ")),
            Bool(true))))))
  Assert(
    Compare(
      Call(Name("anti_shuffle"), Str("Hi")),
      CmpOp("==", Str("Hi"))))
  Assert(
    Compare(
      Call(Name("anti_shuffle"), Str("hello")),
      CmpOp("==", Str("ehllo"))))
  Assert(
    Compare(
      Call(Name("anti_shuffle"), Str("number")),
      CmpOp("==", Str("bemnru"))))
  Assert(
    Compare(
      Call(Name("anti_shuffle"), Str("abcd")),
      CmpOp("==", Str("abcd"))))
  Assert(
    Compare(
      Call(Name("anti_shuffle"), Str("Hello World!!!")),
      CmpOp("==", Str("Hello !!!Wdlor"))))
  Assert(
    Compare(Call(Name("anti_shuffle"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(
        Name("anti_shuffle"),
        Str("Hi. My name is Mister Robot. How are you?")),
      CmpOp("==", Str(".Hi My aemn is Meirst .Rboot How aer ?ouy")))))
