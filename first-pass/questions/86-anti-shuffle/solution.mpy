Module(
  FuncDef("anti_shuffle", Params("s"),
    Return(
      Call(
        Attribute(Str(" "), "join"),
        ListComp(Call(
          Attribute(Str(""), "join"),
          Call(Name("sorted"), Call(Name("list"), Name("i")))),
          CompFor(
            Name("i"),
            Call(Attribute(Name("s"), "split"), Str(" ")),
            Bool(true)))))))
