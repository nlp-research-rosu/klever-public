Module(
  FuncDef("is_simple_power", Params("x", "n"),
    If(Compare(Name("n"), CmpOp("==", Int(1))),
      Return(Compare(Name("x"), CmpOp("==", Int(1)))),
      )
    Assign(Name("power"), Int(1))
    While(Compare(Name("power"), CmpOp("<", Name("x"))),
      Assign(Name("power"), BinOp("*", Name("power"), Name("n"))))
    Return(Compare(Name("power"), CmpOp("==", Name("x")))))
  Assert(
    Compare(Call(Name("is_simple_power"), Int(1), Int(4)), CmpOp("==", Bool(true))))
  Assert(
    Compare(Call(Name("is_simple_power"), Int(2), Int(2)), CmpOp("==", Bool(true))))
  Assert(
    Compare(Call(Name("is_simple_power"), Int(8), Int(2)), CmpOp("==", Bool(true))))
  Assert(
    Compare(Call(Name("is_simple_power"), Int(3), Int(2)), CmpOp("==", Bool(false))))
  Assert(
    Compare(Call(Name("is_simple_power"), Int(3), Int(1)), CmpOp("==", Bool(false))))
  Assert(
    Compare(Call(Name("is_simple_power"), Int(5), Int(3)), CmpOp("==", Bool(false)))))
