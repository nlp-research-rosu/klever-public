Module(
  FuncDef("fruit_distribution", Params("s", "n"),
    Assign(Name("lis"), Call(Name("list"), ))
    For(Name("i"), Call(Attribute(Name("s"), "split"), Str(" ")),
      If(Call(Attribute(Name("i"), "isdigit"), ),
        Expr(
          Call(
            Attribute(Name("lis"), "append"),
            Call(Name("int"), Name("i")))),
        ))
    Return(BinOp("-", Name("n"), Call(Name("sum"), Name("lis")))))
  Assert(
    Compare(
      Call(
        Name("fruit_distribution"),
        Str("5 apples and 6 oranges"),
        Int(19)),
      CmpOp("==", Int(8))))
  Assert(
    Compare(
      Call(
        Name("fruit_distribution"),
        Str("5 apples and 6 oranges"),
        Int(21)),
      CmpOp("==", Int(10))))
  Assert(
    Compare(
      Call(
        Name("fruit_distribution"),
        Str("0 apples and 1 oranges"),
        Int(3)),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(
        Name("fruit_distribution"),
        Str("1 apples and 0 oranges"),
        Int(3)),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(
        Name("fruit_distribution"),
        Str("2 apples and 3 oranges"),
        Int(100)),
      CmpOp("==", Int(95))))
  Assert(
    Compare(
      Call(
        Name("fruit_distribution"),
        Str("2 apples and 3 oranges"),
        Int(5)),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("fruit_distribution"),
        Str("1 apples and 100 oranges"),
        Int(120)),
      CmpOp("==", Int(19)))))
