Module(
  FuncDef("solve", Params("s"),
    Assign(Name("has_alpha"), Bool(false))
    Assign(Name("swapped"), Str(""))
    Assign(Name("rev"), Str(""))
    Assign(Name("c"), Str(""))
    Assign(Name("code"), Int(0))
    Assign(Name("new"), Int(0))
    For(Name("c"), Name("s"),
      Assign(Name("code"), Call(Name("ord"), Name("c")))
      Assign(Name("new"), Name("code"))
      If(BoolOp(
        "and",
        Compare(Name("code"), CmpOp(">=", Int(65))),
        Compare(Name("code"), CmpOp("<=", Int(90)))),
        Assign(Name("new"), BinOp("+", Name("code"), Int(32)))
        Assign(Name("has_alpha"), Bool(true)),
        If(BoolOp(
          "and",
          Compare(Name("code"), CmpOp(">=", Int(97))),
          Compare(Name("code"), CmpOp("<=", Int(122)))),
          Assign(Name("new"), BinOp("-", Name("code"), Int(32)))
          Assign(Name("has_alpha"), Bool(true)),
          ))
      Assign(
        Name("swapped"),
        BinOp("+", Name("swapped"), Call(Name("chr"), Name("new"))))
      Assign(Name("rev"), BinOp("+", Name("c"), Name("rev"))))
    Assign(Name("result"), Name("rev"))
    If(Name("has_alpha"),
      Assign(Name("result"), Name("swapped")),
      )
    Return(Name("result")))
  Assert(
    Compare(Call(Name("solve"), Str("AsDf")), CmpOp("==", Str("aSdF"))))
  Assert(
    Compare(Call(Name("solve"), Str("1234")), CmpOp("==", Str("4321"))))
  Assert(
    Compare(Call(Name("solve"), Str("ab")), CmpOp("==", Str("AB"))))
  Assert(
    Compare(Call(Name("solve"), Str("#a@C")), CmpOp("==", Str("#A@c"))))
  Assert(
    Compare(
      Call(Name("solve"), Str("#AsdfW^45")),
      CmpOp("==", Str("#aSDFw^45"))))
  Assert(
    Compare(Call(Name("solve"), Str("#6@2")), CmpOp("==", Str("2@6#"))))
  Assert(
    Compare(
      Call(Name("solve"), Str("#$a^D")),
      CmpOp("==", Str("#$A^d"))))
  Assert(
    Compare(Call(Name("solve"), Str("#ccc")), CmpOp("==", Str("#CCC")))))
