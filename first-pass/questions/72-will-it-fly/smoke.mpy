Module(
  FuncDef("will_it_fly", Params("q", "w"),
    Assign(Name("total"), Int(0))
    Assign(Name("rev"), ListExpr())
    Assign(Name("x"), Int(0))
    For(Name("x"), Name("q"),
      Assign(Name("total"), BinOp("+", Name("total"), Name("x")))
      Assign(Name("rev"), BinOp("+", ListExpr(Name("x")), Name("rev"))))
    Return(
      BoolOp(
        "and",
        Compare(Name("total"), CmpOp("<=", Name("w"))),
        Compare(Name("q"), CmpOp("==", Name("rev"))))))
  Assert(
    Call(Name("will_it_fly"), ListExpr(Int(3), Int(2), Int(3)), Int(9)))
  Assert(
    UnaryOp(
      "not",
      Call(Name("will_it_fly"), ListExpr(Int(1), Int(2)), Int(5))))
  Assert(Call(Name("will_it_fly"), ListExpr(Int(3)), Int(5)))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("will_it_fly"),
        ListExpr(Int(3), Int(2), Int(3)),
        Int(1))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("will_it_fly"),
        ListExpr(Int(1), Int(2), Int(3)),
        Int(6))))
  Assert(Call(Name("will_it_fly"), ListExpr(Int(5)), Int(5))))
