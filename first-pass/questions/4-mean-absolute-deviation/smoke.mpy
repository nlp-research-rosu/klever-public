Module(
  FuncDef("mean_absolute_deviation", Params("numbers"), CellVars("mean"), FreeVars(),
    Assign(
      Name("mean"),
      BinOp(
        "/",
        Call(Name("sum"), Name("numbers")),
        Call(Name("len"), Name("numbers"))))
    Return(
      BinOp(
        "/",
        Call(
          Name("sum"),
          GenExp(Call(Name("abs"), BinOp("-", Name("x"), Name("mean"))),
            CompFor(Name("x"), Name("numbers"), Bool(true)))),
        Call(Name("len"), Name("numbers")))))
  Assert(
    Compare(
      Call(
        Name("mean_absolute_deviation"),
        ListExpr(Float(1.0), Float(2.0), Float(3.0), Float(4.0))),
      CmpOp("==", Float(1.0)))))
