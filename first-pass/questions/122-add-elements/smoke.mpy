Module(
  FuncDef("add_elements", Params("arr", "k"),
    Assign(Name("total"), Int(0))
    Assign(Name("i"), Int(0))
    Assign(Name("x"), Int(0))
    For(Name("x"), Name("arr"),
      If(Compare(Name("i"), CmpOp("<", Name("k"))),
        If(BoolOp(
          "and",
          Compare(Name("x"), CmpOp(">=", UnaryOp("-", Int(9)))),
          Compare(Name("x"), CmpOp("<=", Int(99)))),
          Assign(Name("total"), BinOp("+", Name("total"), Name("x"))),
          ),
        )
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(Name("total")))
  Assert(
    Compare(
      Call(
        Name("add_elements"),
        ListExpr(
          Int(1),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(3)),
          Int(41),
          Int(57),
          Int(76),
          Int(87),
          Int(88),
          Int(99)),
        Int(3)),
      CmpOp("==", UnaryOp("-", Int(4)))))
  Assert(
    Compare(
      Call(
        Name("add_elements"),
        ListExpr(Int(111), Int(121), Int(3), Int(4000), Int(5), Int(6)),
        Int(2)),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("add_elements"),
        ListExpr(
          Int(11),
          Int(21),
          Int(3),
          Int(90),
          Int(5),
          Int(6),
          Int(7),
          Int(8),
          Int(9)),
        Int(4)),
      CmpOp("==", Int(125))))
  Assert(
    Compare(
      Call(
        Name("add_elements"),
        ListExpr(
          Int(111),
          Int(21),
          Int(3),
          Int(4000),
          Int(5),
          Int(6),
          Int(7),
          Int(8),
          Int(9)),
        Int(4)),
      CmpOp("==", Int(24))))
  Assert(
    Compare(
      Call(Name("add_elements"), ListExpr(Int(1)), Int(1)),
      CmpOp("==", Int(1)))))
