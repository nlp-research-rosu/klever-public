Module(
  FuncDef("find_max", Params("words"),
    Assign(Name("best"), Subscript(Name("words"), Int(0)))
    Assign(
      Name("best_d"),
      Call(
        Name("len"),
        Call(Name("set"), Subscript(Name("words"), Int(0)))))
    Assign(Name("w"), Str(""))
    Assign(Name("d"), Int(0))
    Assign(Name("beats"), Bool(false))
    For(Name("w"), Name("words"),
      Assign(Name("d"), Call(Name("len"), Call(Name("set"), Name("w"))))
      Assign(
        Name("beats"),
        BoolOp(
          "or",
          Compare(Name("d"), CmpOp(">", Name("best_d"))),
          BoolOp(
            "and",
            Compare(Name("d"), CmpOp("==", Name("best_d"))),
            Compare(Name("w"), CmpOp("<", Name("best"))))))
      Assign(
        Name("best"),
        IfExp(Name("beats"), Name("w"), Name("best")))
      Assign(
        Name("best_d"),
        IfExp(Name("beats"), Name("d"), Name("best_d"))))
    Return(Name("best")))
  Assert(
    Compare(
      Call(
        Name("find_max"),
        ListExpr(Str("name"), Str("of"), Str("string"))),
      CmpOp("==", Str("string"))))
  Assert(
    Compare(
      Call(
        Name("find_max"),
        ListExpr(Str("name"), Str("enam"), Str("game"))),
      CmpOp("==", Str("enam"))))
  Assert(
    Compare(
      Call(
        Name("find_max"),
        ListExpr(Str("aaaaaaa"), Str("bb"), Str("cc"))),
      CmpOp("==", Str("aaaaaaa")))))
