Module(
  FuncDef("get_max_triples", Params("n"),
    Assign(Name("count"), Int(0))
    Assign(Name("i"), Int(0))
    Assign(Name("j"), Int(0))
    Assign(Name("k"), Int(0))
    For(Name("i"), Call(Name("range"), Int(0), Name("n")),
      For(Name("j"), Call(Name("range"), BinOp("+", Name("i"), Int(1)), Name("n")),
        For(Name("k"), Call(Name("range"), BinOp("+", Name("j"), Int(1)), Name("n")),
          If(Compare(
            BinOp(
              "%",
              BinOp(
                "+",
                BinOp(
                  "+",
                  BinOp(
                    "+",
                    BinOp(
                      "-",
                      BinOp(
                        "*",
                        BinOp("+", Name("i"), Int(1)),
                        BinOp("+", Name("i"), Int(1))),
                      BinOp("+", Name("i"), Int(1))),
                    Int(1)),
                  BinOp(
                    "+",
                    BinOp(
                      "-",
                      BinOp(
                        "*",
                        BinOp("+", Name("j"), Int(1)),
                        BinOp("+", Name("j"), Int(1))),
                      BinOp("+", Name("j"), Int(1))),
                    Int(1))),
                BinOp(
                  "+",
                  BinOp(
                    "-",
                    BinOp(
                      "*",
                      BinOp("+", Name("k"), Int(1)),
                      BinOp("+", Name("k"), Int(1))),
                    BinOp("+", Name("k"), Int(1))),
                  Int(1))),
              Int(3)),
            CmpOp("==", Int(0))),
            Assign(Name("count"), BinOp("+", Name("count"), Int(1))),
            ))))
    Return(Name("count")))
  Assert(
    Compare(Call(Name("get_max_triples"), Int(5)), CmpOp("==", Int(1)))))
