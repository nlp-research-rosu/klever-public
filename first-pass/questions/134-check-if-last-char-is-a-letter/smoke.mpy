Module(
  FuncDef("check_if_last_char_is_a_letter", Params("txt"),
    Assign(Name("last"), Int(0))
    Assign(Name("prev"), Int(0))
    Assign(Name("n"), Int(0))
    Assign(Name("ch"), Str(""))
    For(Name("ch"), Name("txt"),
      Assign(Name("prev"), Name("last"))
      Assign(Name("last"), Call(Name("ord"), Name("ch")))
      Assign(Name("n"), BinOp("+", Name("n"), Int(1))))
    Assign(
      Name("isletter"),
      BoolOp(
        "or",
        BoolOp(
          "and",
          Compare(Int(97), CmpOp("<=", Name("last"))),
          Compare(Name("last"), CmpOp("<=", Int(122)))),
        BoolOp(
          "and",
          Compare(Int(65), CmpOp("<=", Name("last"))),
          Compare(Name("last"), CmpOp("<=", Int(90))))))
    Assign(
      Name("isolated"),
      BoolOp(
        "or",
        Compare(Name("n"), CmpOp("==", Int(1))),
        Compare(Name("prev"), CmpOp("==", Int(32)))))
    Return(BoolOp("and", Name("isletter"), Name("isolated"))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("apple pie")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("apple pi e")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("apple pi e ")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("check_if_last_char_is_a_letter"), Str("A")),
      CmpOp("==", Bool(true)))))
