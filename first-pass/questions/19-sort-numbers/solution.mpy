Module(
  FuncDef("sort_numbers", Params("numbers"), CellVars("value_map"), FreeVars(),
    Assign(
      Name("value_map"),
      DictExpr(
        Entry(Str("zero"), Int(0)),
        Entry(Str("one"), Int(1)),
        Entry(Str("two"), Int(2)),
        Entry(Str("three"), Int(3)),
        Entry(Str("four"), Int(4)),
        Entry(Str("five"), Int(5)),
        Entry(Str("six"), Int(6)),
        Entry(Str("seven"), Int(7)),
        Entry(Str("eight"), Int(8)),
        Entry(Str("nine"), Int(9))))
    Return(
      Call(
        Attribute(Str(" "), "join"),
        Call(
          Name("sorted"),
          ListComp(Name("x"),
            CompFor(
              Name("x"),
              Call(Attribute(Name("numbers"), "split"), Str(" ")),
              Name("x"))),
          KwArg(
            "key",
            Lambda(
              Params("x"),
              CellVars(),
              FreeVars("value_map"),
              Subscript(Name("value_map"), Name("x")))))))))
