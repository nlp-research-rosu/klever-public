Module(
  FuncDef("count_up_to", Params("n"),
    Assign(Name("primes"), ListExpr())
    For(Name("i"), Call(Name("range"), Int(2), Name("n")),
      Assign(Name("is_prime"), Bool(true))
      For(Name("j"), Call(Name("range"), Int(2), Name("i")),
        If(Compare(BinOp("%", Name("i"), Name("j")), CmpOp("==", Int(0))),
          Assign(Name("is_prime"), Bool(false))
          Break,
          ))
      If(Name("is_prime"),
        Expr(Call(Attribute(Name("primes"), "append"), Name("i"))),
        ))
    Return(Name("primes")))
  Assert(
    Compare(
      Call(Name("count_up_to"), Int(5)),
      CmpOp("==", ListExpr(Int(2), Int(3)))))
  Assert(
    Compare(
      Call(Name("count_up_to"), Int(6)),
      CmpOp("==", ListExpr(Int(2), Int(3), Int(5)))))
  Assert(
    Compare(
      Call(Name("count_up_to"), Int(7)),
      CmpOp("==", ListExpr(Int(2), Int(3), Int(5)))))
  Assert(
    Compare(
      Call(Name("count_up_to"), Int(10)),
      CmpOp("==", ListExpr(Int(2), Int(3), Int(5), Int(7)))))
  Assert(
    Compare(Call(Name("count_up_to"), Int(0)), CmpOp("==", ListExpr())))
  Assert(
    Compare(Call(Name("count_up_to"), Int(1)), CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("count_up_to"), Int(18)),
      CmpOp(
        "==",
        ListExpr(
          Int(2),
          Int(3),
          Int(5),
          Int(7),
          Int(11),
          Int(13),
          Int(17))))))
