Module(
  FuncDef("common", Params("l1", "l2"),
    Assign(Name("out"), ListExpr())
    For(Name("e1"), Name("l1"),
      If(Compare(Name("e1"), CmpOp("in", Name("l2"))),
        If(Compare(Name("e1"), CmpOp("not in", Name("out"))),
          Assign(
            Name("out"),
            BinOp("+", Name("out"), ListExpr(Name("e1")))),
          ),
        ))
    Return(Call(Name("sorted"), Name("out"))))
  Assert(
    Compare(
      Call(
        Name("common"),
        ListExpr(
          Int(1),
          Int(4),
          Int(3),
          Int(34),
          Int(653),
          Int(2),
          Int(5)),
        ListExpr(
          Int(5),
          Int(7),
          Int(1),
          Int(5),
          Int(9),
          Int(653),
          Int(121))),
      CmpOp("==", ListExpr(Int(1), Int(5), Int(653)))))
  Assert(
    Compare(
      Call(
        Name("common"),
        ListExpr(Int(5), Int(3), Int(2), Int(8)),
        ListExpr(Int(3), Int(2))),
      CmpOp("==", ListExpr(Int(2), Int(3)))))
  Assert(
    Compare(
      Call(
        Name("common"),
        ListExpr(Int(1), Int(2)),
        ListExpr(Int(3), Int(4))),
      CmpOp("==", ListExpr()))))
