Module(
  FuncDef("intersperse", Params("numbers", "delimeter"),
    Assign(Name("result"), ListExpr())
    Assign(Name("first"), Bool(true))
    Assign(Name("n"), Int(0))
    For(Name("n"), Name("numbers"),
      If(Name("first"),
        Assign(
          Name("result"),
          BinOp("+", Name("result"), ListExpr(Name("n"))))
        Assign(Name("first"), Bool(false)),
        Assign(
          Name("result"),
          BinOp(
            "+",
            Name("result"),
            ListExpr(Name("delimeter"), Name("n"))))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("intersperse"), ListExpr(), Int(7)),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("intersperse"),
        ListExpr(Int(5), Int(6), Int(3), Int(2)),
        Int(8)),
      CmpOp(
        "==",
        ListExpr(Int(5), Int(8), Int(6), Int(8), Int(3), Int(8), Int(2)))))
  Assert(
    Compare(
      Call(
        Name("intersperse"),
        ListExpr(Int(2), Int(2), Int(2)),
        Int(2)),
      CmpOp("==", ListExpr(Int(2), Int(2), Int(2), Int(2), Int(2))))))
