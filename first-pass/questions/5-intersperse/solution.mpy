Module(
  FuncDef("intersperse", Params("numbers", "delimeter"),
    Assign(Name("result"), ListExpr())
    Assign(Name("first"), Bool(true))
    Assign(Name("n"), Int(0))
    For(Name("n"), Name("numbers"),
      If(Name("first"),
        Assign(
          Name("result"),
          BinOp("+", Name("result"), ListExpr(Name("n"))))
        Assign(Name("first"), Bool(false)),
        Assign(
          Name("result"),
          BinOp(
            "+",
            Name("result"),
            ListExpr(Name("delimeter"), Name("n"))))))
    Return(Name("result"))))
