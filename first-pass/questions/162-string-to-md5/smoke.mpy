Module(
  FuncDef("string_to_md5", Params("text"),
    Import("hashlib")
    Return(
      IfExp(
        Name("text"),
        Call(
          Attribute(
            Call(
              Attribute(Name("hashlib"), "md5"),
              Call(Attribute(Name("text"), "encode"), Str("ascii"))),
            "hexdigest"),
          ),
        NoneVal)))
  Assert(
    Compare(Call(Name("string_to_md5"), Str("")), CmpOp("is", NoneVal))))
