Module(
  FuncDef("digitSum", Params("s"),
    Assign(Name("result"), Int(0))
    Assign(Name("c"), Str(""))
    For(Name("c"), Name("s"),
      Assign(Name("code"), Call(Name("ord"), Name("c")))
      If(Compare(Name("code"), CmpOp(">=", Int(65))),
        If(Compare(Name("code"), CmpOp("<=", Int(90))),
          Assign(
            Name("result"),
            BinOp("+", Name("result"), Name("code"))),
          ),
        ))
    Return(Name("result")))
  Assert(Compare(Call(Name("digitSum"), Str("")), CmpOp("==", Int(0))))
  Assert(
    Compare(Call(Name("digitSum"), Str("abAB")), CmpOp("==", Int(131))))
  Assert(
    Compare(Call(Name("digitSum"), Str("abcCd")), CmpOp("==", Int(67))))
  Assert(
    Compare(Call(Name("digitSum"), Str("helloE")), CmpOp("==", Int(69))))
  Assert(
    Compare(
      Call(Name("digitSum"), Str("woArBld")),
      CmpOp("==", Int(131))))
  Assert(
    Compare(
      Call(Name("digitSum"), Str("aAaaaXa")),
      CmpOp("==", Int(153))))
  Assert(
    Compare(
      Call(Name("digitSum"), Str(" How are yOu?")),
      CmpOp("==", Int(151))))
  Assert(
    Compare(
      Call(Name("digitSum"), Str("You arE Very Smart")),
      CmpOp("==", Int(327)))))
