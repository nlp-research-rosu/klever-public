Module(
  FuncDef("unique", Params("l"),
    Assign(Name("out"), ListExpr())
    For(Name("x"), Name("l"),
      If(Compare(Name("x"), CmpOp("not in", Name("out"))),
        Assign(
          Name("out"),
          BinOp("+", Name("out"), ListExpr(Name("x")))),
        ))
    Return(Call(Name("sorted"), Name("out"))))
  Assert(
    Compare(
      Call(
        Name("unique"),
        ListExpr(
          Int(5),
          Int(3),
          Int(5),
          Int(2),
          Int(3),
          Int(3),
          Int(9),
          Int(0),
          Int(123))),
      CmpOp(
        "==",
        ListExpr(Int(0), Int(2), Int(3), Int(5), Int(9), Int(123)))))
  Assert(
    Compare(
      Call(Name("unique"), ListExpr(Int(1), Int(1), Int(1))),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(Call(Name("unique"), ListExpr()), CmpOp("==", ListExpr()))))
