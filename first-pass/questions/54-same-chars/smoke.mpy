Module(
  FuncDef("same_chars", Params("s0", "s1"),
    Return(
      Compare(
        Call(Name("set"), Name("s0")),
        CmpOp("==", Call(Name("set"), Name("s1"))))))
  Assert(
    Compare(
      Call(
        Name("same_chars"),
        Str("eabcdzzzz"),
        Str("dddzzzzzzzddeddabc")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("same_chars"), Str("abcd"), Str("dddddddabc")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("same_chars"), Str("dddddddabc"), Str("abcd")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("same_chars"), Str("eabcd"), Str("dddddddabc")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("same_chars"), Str("abcd"), Str("dddddddabce")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("same_chars"),
        Str("eabcdzzzz"),
        Str("dddzzzzzzzddddabc")),
      CmpOp("==", Bool(false)))))
