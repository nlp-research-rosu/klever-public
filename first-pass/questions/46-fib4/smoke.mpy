Module(
  FuncDef("fib4", Params("n"),
    If(Compare(Name("n"), CmpOp("<", Int(4))),
      Return(IfExp(Compare(Name("n"), CmpOp("==", Int(2))), Int(2), Int(0))),
      )
    Assign(TupleExpr(Name("a"), Name("b"), Name("c"), Name("d")),
           TupleExpr(Int(0), Int(0), Int(2), Int(0)))
    For(Name("_"), Call(Name("range"), Int(4), BinOp("+", Name("n"), Int(1))),
      Assign(TupleExpr(Name("a"), Name("b"), Name("c"), Name("d")),
             TupleExpr(Name("b"), Name("c"), Name("d"),
               BinOp("+", BinOp("+", BinOp("+", Name("a"), Name("b")), Name("c")), Name("d")))))
    Return(Name("d")))
  Assert(Compare(Call(Name("fib4"), Int(5)),  CmpOp("==", Int(4))))
  Assert(Compare(Call(Name("fib4"), Int(6)),  CmpOp("==", Int(8))))
  Assert(Compare(Call(Name("fib4"), Int(7)),  CmpOp("==", Int(14))))
  Assert(Compare(Call(Name("fib4"), Int(8)),  CmpOp("==", Int(28))))
  Assert(Compare(Call(Name("fib4"), Int(10)), CmpOp("==", Int(104))))
  Assert(Compare(Call(Name("fib4"), Int(12)), CmpOp("==", Int(386)))))
