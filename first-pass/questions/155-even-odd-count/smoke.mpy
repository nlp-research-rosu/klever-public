Module(
  FuncDef("even_odd_count", Params("num"),
    Assign(Name("even_count"), Int(0))
    Assign(Name("odd_count"), Int(0))
    For(Name("i"), Call(Name("str"), Call(Name("abs"), Name("num"))),
      If(Compare(
        BinOp("%", Call(Name("int"), Name("i")), Int(2)),
        CmpOp("==", Int(0))),
        AugAssign(Name("even_count"), "+", Int(1)),
        AugAssign(Name("odd_count"), "+", Int(1))))
    Return(TupleExpr(Name("even_count"), Name("odd_count"))))
  Assert(
    Compare(
      Call(Name("even_odd_count"), Int(-12)),
      CmpOp("==", TupleExpr(Int(1), Int(1)))))
  Assert(
    Compare(
      Call(Name("even_odd_count"), Int(123)),
      CmpOp("==", TupleExpr(Int(1), Int(2)))))
  Assert(
    Compare(
      Call(Name("even_odd_count"), Int(0)),
      CmpOp("==", TupleExpr(Int(1), Int(0)))))
  Assert(
    Compare(
      Call(Name("even_odd_count"), Int(2468)),
      CmpOp("==", TupleExpr(Int(4), Int(0))))))
