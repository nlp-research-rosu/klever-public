Module(
  FuncDef("separate_paren_groups", Params("paren_string"),
    Assign(Name("result"), ListExpr())
    Assign(Name("current"), Str(""))
    Assign(Name("depth"), Int(0))
    Assign(Name("c"), Str(""))
    For(Name("c"), Name("paren_string"),
      If(Compare(Name("c"), CmpOp("==", Str("("))),
        Assign(Name("current"), BinOp("+", Name("current"), Name("c")))
        Assign(Name("depth"), BinOp("+", Name("depth"), Int(1))),
        If(Compare(Name("c"), CmpOp("==", Str(")"))),
          Assign(
            Name("current"),
            BinOp("+", Name("current"), Name("c")))
          Assign(Name("depth"), BinOp("-", Name("depth"), Int(1)))
          If(Compare(Name("depth"), CmpOp("==", Int(0))),
            Assign(
              Name("result"),
              BinOp("+", Name("result"), ListExpr(Name("current"))))
            Assign(Name("current"), Str("")),
            ),
          )))
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("separate_paren_groups"),
        Str("(()()) ((())) () ((())()())")),
      CmpOp(
        "==",
        ListExpr(
          Str("(()())"),
          Str("((()))"),
          Str("()"),
          Str("((())()())")))))
  Assert(
    Compare(
      Call(
        Name("separate_paren_groups"),
        Str("() (()) ((())) (((())))")),
      CmpOp(
        "==",
        ListExpr(Str("()"), Str("(())"), Str("((()))"), Str("(((())))")))))
  Assert(
    Compare(
      Call(Name("separate_paren_groups"), Str("(()(())((())))")),
      CmpOp("==", ListExpr(Str("(()(())((())))")))))
  Assert(
    Compare(
      Call(Name("separate_paren_groups"), Str("( ) (( )) (( )( ))")),
      CmpOp("==", ListExpr(Str("()"), Str("(())"), Str("(()())"))))))
