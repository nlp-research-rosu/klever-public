Module(
  FuncDef("below_threshold", Params("l", "t"),
    For(Name("e"), Name("l"),
      If(Compare(Name("e"), CmpOp(">=", Name("t"))),
        Return(Bool(false)),
        ))
    Return(Bool(true)))
  Assert(
    Call(
      Name("below_threshold"),
      ListExpr(Int(1), Int(2), Int(4), Int(10)),
      Int(100)))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("below_threshold"),
        ListExpr(Int(1), Int(20), Int(4), Int(10)),
        Int(5))))
  Assert(
    Call(
      Name("below_threshold"),
      ListExpr(Int(1), Int(20), Int(4), Int(10)),
      Int(21)))
  Assert(
    Call(
      Name("below_threshold"),
      ListExpr(Int(1), Int(20), Int(4), Int(10)),
      Int(22)))
  Assert(
    Call(
      Name("below_threshold"),
      ListExpr(Int(1), Int(8), Int(4), Int(10)),
      Int(11)))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("below_threshold"),
        ListExpr(Int(1), Int(8), Int(4), Int(10)),
        Int(10)))))
