Module(
  FuncDef("remove_duplicates", Params("numbers"),
    Assign(Name("result"), ListExpr())
    Assign(Name("m"), Call(Name("len"), Name("numbers")))
    Assign(Name("i"), Int(0))
    Assign(Name("j"), Int(0))
    Assign(Name("c"), Int(0))
    For(Name("i"), Call(Name("range"), Int(0), Name("m")),
      Assign(Name("c"), Int(0))
      For(Name("j"), Call(Name("range"), Int(0), Name("m")),
        If(Compare(
          Subscript(Name("numbers"), Name("j")),
          CmpOp("==", Subscript(Name("numbers"), Name("i")))),
          Assign(Name("c"), BinOp("+", Name("c"), Int(1))),
          ))
      If(Compare(Name("c"), CmpOp("==", Int(1))),
        Assign(
          Name("result"),
          BinOp(
            "+",
            Name("result"),
            ListExpr(Subscript(Name("numbers"), Name("i"))))),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("remove_duplicates"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("remove_duplicates"),
        ListExpr(Int(1), Int(2), Int(3), Int(4))),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(3), Int(4)))))
  Assert(
    Compare(
      Call(
        Name("remove_duplicates"),
        ListExpr(Int(1), Int(2), Int(3), Int(2), Int(4), Int(3), Int(5))),
      CmpOp("==", ListExpr(Int(1), Int(4), Int(5))))))
