Module(
  FuncDef("exchange", Params("lst1", "lst2"),
    Assign(Name("odd"), Int(0))
    Assign(Name("even"), Int(0))
    For(Name("i"), Name("lst1"),
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(1))),
        AugAssign(Name("odd"), "+", Int(1)),
        ))
    For(Name("i"), Name("lst2"),
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
        AugAssign(Name("even"), "+", Int(1)),
        ))
    If(Compare(Name("even"), CmpOp(">=", Name("odd"))),
      Return(Str("YES")),
      )
    Return(Str("NO")))
  Assert(
    Compare(
      Call(
        Name("exchange"),
        ListExpr(Int(1), Int(2), Int(3), Int(4)),
        ListExpr(Int(1), Int(2), Int(3), Int(4))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(
        Name("exchange"),
        ListExpr(Int(1), Int(2), Int(3), Int(4)),
        ListExpr(Int(1), Int(5), Int(3), Int(4))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("exchange"),
        ListExpr(Int(1), Int(2), Int(3), Int(4)),
        ListExpr(Int(2), Int(1), Int(4), Int(3))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(
        Name("exchange"),
        ListExpr(Int(5), Int(7), Int(3)),
        ListExpr(Int(2), Int(6), Int(4))),
      CmpOp("==", Str("YES"))))
  Assert(
    Compare(
      Call(
        Name("exchange"),
        ListExpr(Int(5), Int(7), Int(3)),
        ListExpr(Int(2), Int(6), Int(3))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("exchange"),
        ListExpr(Int(3), Int(2), Int(6), Int(1), Int(8), Int(9)),
        ListExpr(Int(3), Int(5), Int(5), Int(1), Int(1), Int(1))),
      CmpOp("==", Str("NO"))))
  Assert(
    Compare(
      Call(
        Name("exchange"),
        ListExpr(Int(100), Int(200)),
        ListExpr(Int(200), Int(200))),
      CmpOp("==", Str("YES")))))
