Module(
  FuncDef("pluck", Params("arr"),
    Assign(Name("i"), Int(0))
    Assign(Name("found"), Bool(false))
    Assign(Name("bestVal"), Int(0))
    Assign(Name("bestIdx"), Int(0))
    Assign(Name("v"), Int(0))
    For(Name("v"), Name("arr"),
      If(Compare(BinOp("%", Name("v"), Int(2)), CmpOp("==", Int(0))),
        If(UnaryOp("not", Name("found")),
          Assign(Name("bestVal"), Name("v"))
          Assign(Name("bestIdx"), Name("i"))
          Assign(Name("found"), Bool(true)),
          If(Compare(Name("v"), CmpOp("<", Name("bestVal"))),
            Assign(Name("bestVal"), Name("v"))
            Assign(Name("bestIdx"), Name("i")),
            )),
        )
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    If(Name("found"),
      Return(ListExpr(Name("bestVal"), Name("bestIdx"))),
      Return(ListExpr())))
  Assert(
    Compare(
      Call(Name("pluck"), ListExpr(Int(4), Int(2), Int(3))),
      CmpOp("==", ListExpr(Int(2), Int(1)))))
  Assert(
    Compare(
      Call(Name("pluck"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", ListExpr(Int(2), Int(1)))))
  Assert(
    Compare(Call(Name("pluck"), ListExpr()), CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("pluck"),
        ListExpr(Int(5), Int(0), Int(3), Int(0), Int(4), Int(2))),
      CmpOp("==", ListExpr(Int(0), Int(1)))))
  Assert(
    Compare(
      Call(
        Name("pluck"),
        ListExpr(Int(1), Int(2), Int(3), Int(0), Int(5), Int(3))),
      CmpOp("==", ListExpr(Int(0), Int(3)))))
  Assert(
    Compare(
      Call(
        Name("pluck"),
        ListExpr(Int(5), Int(4), Int(8), Int(4), Int(8))),
      CmpOp("==", ListExpr(Int(4), Int(1)))))
  Assert(
    Compare(
      Call(Name("pluck"), ListExpr(Int(7), Int(6), Int(7), Int(1))),
      CmpOp("==", ListExpr(Int(6), Int(1)))))
  Assert(
    Compare(
      Call(Name("pluck"), ListExpr(Int(7), Int(9), Int(7), Int(1))),
      CmpOp("==", ListExpr()))))
