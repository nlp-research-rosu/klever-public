Module(
  FuncDef("int_to_mini_roman", Params("number"),
    Assign(Name("M"), ListExpr(Str(""), Str("m")))
    Assign(
      Name("H"),
      ListExpr(
        Str(""),
        Str("c"),
        Str("cc"),
        Str("ccc"),
        Str("cd"),
        Str("d"),
        Str("dc"),
        Str("dcc"),
        Str("dccc"),
        Str("cm")))
    Assign(
      Name("T"),
      ListExpr(
        Str(""),
        Str("x"),
        Str("xx"),
        Str("xxx"),
        Str("xl"),
        Str("l"),
        Str("lx"),
        Str("lxx"),
        Str("lxxx"),
        Str("xc")))
    Assign(
      Name("U"),
      ListExpr(
        Str(""),
        Str("i"),
        Str("ii"),
        Str("iii"),
        Str("iv"),
        Str("v"),
        Str("vi"),
        Str("vii"),
        Str("viii"),
        Str("ix")))
    Return(
      BinOp(
        "+",
        BinOp(
          "+",
          BinOp(
            "+",
            Subscript(Name("M"), BinOp("//", Name("number"), Int(1000))),
            Subscript(
              Name("H"),
              BinOp("%", BinOp("//", Name("number"), Int(100)), Int(10)))),
          Subscript(
            Name("T"),
            BinOp("%", BinOp("//", Name("number"), Int(10)), Int(10)))),
        Subscript(Name("U"), BinOp("%", Name("number"), Int(10))))))
  Assert(
    Compare(
      Call(Name("int_to_mini_roman"), Int(19)),
      CmpOp("==", Str("xix"))))
  Assert(
    Compare(
      Call(Name("int_to_mini_roman"), Int(152)),
      CmpOp("==", Str("clii"))))
  Assert(
    Compare(
      Call(Name("int_to_mini_roman"), Int(426)),
      CmpOp("==", Str("cdxxvi"))))
  Assert(
    Compare(
      Call(Name("int_to_mini_roman"), Int(1)),
      CmpOp("==", Str("i"))))
  Assert(
    Compare(
      Call(Name("int_to_mini_roman"), Int(1000)),
      CmpOp("==", Str("m")))))
