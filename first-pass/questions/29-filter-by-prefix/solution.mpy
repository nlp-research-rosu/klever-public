Module(
  FuncDef("filter_by_prefix", Params("strings", "prefix"),
    Assign(Name("result"), ListExpr())
    Assign(Name("x"), Str(""))
    For(Name("x"), Name("strings"),
      If(Call(Attribute(Name("x"), "startswith"), Name("prefix")),
        Assign(
          Name("result"),
          BinOp("+", Name("result"), ListExpr(Name("x")))),
        ))
    Return(Name("result"))))
