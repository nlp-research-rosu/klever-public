Module(
  FuncDef("filter_by_prefix", Params("strings", "prefix"),
    Assign(Name("result"), ListExpr())
    Assign(Name("x"), Str(""))
    For(Name("x"), Name("strings"),
      If(Call(Attribute(Name("x"), "startswith"), Name("prefix")),
        Assign(
          Name("result"),
          BinOp("+", Name("result"), ListExpr(Name("x")))),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("filter_by_prefix"), ListExpr(), Str("john")),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("filter_by_prefix"),
        ListExpr(
          Str("xxx"),
          Str("asd"),
          Str("xxy"),
          Str("john doe"),
          Str("xxxAAA"),
          Str("xxx")),
        Str("xxx")),
      CmpOp("==", ListExpr(Str("xxx"), Str("xxxAAA"), Str("xxx"))))))
