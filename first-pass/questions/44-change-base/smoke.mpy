Module(
  FuncDef("change_base", Params("x", "base"),
    Assign(Name("ret"), Str(""))
    While(Compare(Name("x"), CmpOp(">", Int(0))),
      Assign(
        Name("ret"),
        BinOp(
          "+",
          Call(Name("str"), BinOp("%", Name("x"), Name("base"))),
          Name("ret")))
      AugAssign(Name("x"), "//", Name("base")))
    Return(Name("ret")))
  Assert(
    Compare(
      Call(Name("change_base"), Int(8), Int(3)),
      CmpOp("==", Str("22"))))
  Assert(
    Compare(
      Call(Name("change_base"), Int(9), Int(3)),
      CmpOp("==", Str("100"))))
  Assert(
    Compare(
      Call(Name("change_base"), Int(234), Int(2)),
      CmpOp("==", Str("11101010"))))
  Assert(
    Compare(
      Call(Name("change_base"), Int(16), Int(2)),
      CmpOp("==", Str("10000"))))
  Assert(
    Compare(
      Call(Name("change_base"), Int(8), Int(2)),
      CmpOp("==", Str("1000"))))
  Assert(
    Compare(
      Call(Name("change_base"), Int(7), Int(2)),
      CmpOp("==", Str("111")))))
