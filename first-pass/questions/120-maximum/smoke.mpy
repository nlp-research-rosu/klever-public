Module(
  FuncDef("maximum", Params("arr", "k"),
    Assign(Name("n"), Call(Name("len"), Name("arr")))
    Assign(Name("s"), Call(Name("sorted"), Name("arr")))
    Assign(Name("res"), ListExpr())
    Assign(Name("j"), Int(0))
    For(Name("j"), Call(Name("range"), Int(0), Name("k")),
      Assign(
        Name("res"),
        BinOp(
          "+",
          Name("res"),
          ListExpr(
            Subscript(
              Name("s"),
              BinOp("+", BinOp("-", Name("n"), Name("k")), Name("j")))))))
    Return(Name("res")))
  Assert(
    Compare(
      Call(
        Name("maximum"),
        ListExpr(UnaryOp("-", Int(3)), UnaryOp("-", Int(4)), Int(5)),
        Int(3)),
      CmpOp(
        "==",
        ListExpr(UnaryOp("-", Int(4)), UnaryOp("-", Int(3)), Int(5)))))
  Assert(
    Compare(
      Call(
        Name("maximum"),
        ListExpr(Int(4), UnaryOp("-", Int(4)), Int(4)),
        Int(2)),
      CmpOp("==", ListExpr(Int(4), Int(4)))))
  Assert(
    Compare(
      Call(
        Name("maximum"),
        ListExpr(
          UnaryOp("-", Int(3)),
          Int(2),
          Int(1),
          Int(2),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(2)),
          Int(1)),
        Int(1)),
      CmpOp("==", ListExpr(Int(2)))))
  Assert(
    Compare(
      Call(Name("maximum"), ListExpr(Int(1), Int(2), Int(3)), Int(0)),
      CmpOp("==", ListExpr()))))
