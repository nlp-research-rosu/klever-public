Module(
  FuncDef("monotonic", Params("l"),
    Assign(Name("inc"), Bool(true))
    Assign(Name("dec"), Bool(true))
    Assign(Name("i"), Int(0))
    Assign(Name("prev"), Int(0))
    Assign(Name("x"), Int(0))
    For(Name("x"), Name("l"),
      If(Compare(Name("i"), CmpOp(">=", Int(1))),
        If(Compare(Name("x"), CmpOp("<", Name("prev"))),
          Assign(Name("inc"), Bool(false)),
          )
        If(Compare(Name("x"), CmpOp(">", Name("prev"))),
          Assign(Name("dec"), Bool(false)),
          ),
        )
      Assign(Name("prev"), Name("x"))
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(BoolOp("or", Name("inc"), Name("dec"))))
  Assert(
    Call(Name("monotonic"), ListExpr(Int(1), Int(2), Int(4), Int(10))))
  Assert(
    Call(Name("monotonic"), ListExpr(Int(1), Int(2), Int(4), Int(20))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("monotonic"),
        ListExpr(Int(1), Int(20), Int(4), Int(10)))))
  Assert(
    Call(
      Name("monotonic"),
      ListExpr(Int(4), Int(1), Int(0), UnaryOp("-", Int(10)))))
  Assert(
    Call(Name("monotonic"), ListExpr(Int(4), Int(1), Int(1), Int(0))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("monotonic"),
        ListExpr(Int(1), Int(2), Int(3), Int(2), Int(5), Int(60)))))
  Assert(
    Call(
      Name("monotonic"),
      ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(60))))
  Assert(
    Call(Name("monotonic"), ListExpr(Int(9), Int(9), Int(9), Int(9))))
  Assert(Call(Name("monotonic"), ListExpr())))
