Module(
  FuncDef("do_algebra", Params("operator", "operand"),
    Return(Call(Name("doAlgebra"), Name("operator"), Name("operand"))))
  Assert(
    Compare(
      Call(
        Name("do_algebra"),
        ListExpr(Str("+"), Str("*"), Str("-")),
        ListExpr(Int(2), Int(3), Int(4), Int(5))),
      CmpOp("==", Int(9))))
  Assert(
    Compare(
      Call(
        Name("do_algebra"),
        ListExpr(Str("**"), Str("*")),
        ListExpr(Int(2), Int(3), Int(4))),
      CmpOp("==", Int(32))))
  Assert(
    Compare(
      Call(
        Name("do_algebra"),
        ListExpr(Str("-"), Str("//")),
        ListExpr(Int(10), Int(3), Int(2))),
      CmpOp("==", Int(9)))))
