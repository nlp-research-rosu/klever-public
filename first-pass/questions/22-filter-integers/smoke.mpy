Module(
  FuncDef("filter_integers", Params("values"),
    Assign(Name("result"), ListExpr())
    Assign(Name("i"), Int(0))
    Assign(Name("int_type"), Name("int"))
    For(Name("i"), Call(Name("range"), Call(Name("len"), Name("values"))),
      If(Call(
        Name("isinstance"),
        Subscript(Name("values"), Name("i")),
        Name("int_type")),
        Assign(
          Name("result"),
          BinOp(
            "+",
            Name("result"),
            ListExpr(Subscript(Name("values"), Name("i"))))),
        ))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("filter_integers"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("filter_integers"),
        ListExpr(
          Int(4),
          DictExpr(),
          ListExpr(),
          Float(23.2),
          Int(9),
          Str("adasd"))),
      CmpOp("==", ListExpr(Int(4), Int(9)))))
  Assert(
    Compare(
      Call(
        Name("filter_integers"),
        ListExpr(Int(3), Str("c"), Int(3), Int(3), Str("a"), Str("b"))),
      CmpOp("==", ListExpr(Int(3), Int(3), Int(3))))))
