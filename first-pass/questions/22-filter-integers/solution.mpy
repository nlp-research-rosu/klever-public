Module(
  FuncDef("filter_integers", Params("values"),
    Assign(Name("result"), ListExpr())
    Assign(Name("i"), Int(0))
    Assign(Name("int_type"), Name("int"))
    For(Name("i"), Call(Name("range"), Call(Name("len"), Name("values"))),
      If(Call(
        Name("isinstance"),
        Subscript(Name("values"), Name("i")),
        Name("int_type")),
        Assign(
          Name("result"),
          BinOp(
            "+",
            Name("result"),
            ListExpr(Subscript(Name("values"), Name("i"))))),
        ))
    Return(Name("result"))))
