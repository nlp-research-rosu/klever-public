Module(
  FuncDef("compare_one", Params("a", "b"),
    Assign(
      TupleExpr(Name("temp_a"), Name("temp_b")),
      TupleExpr(Name("a"), Name("b")))
    If(Call(Name("isinstance"), Name("temp_a"), Name("str")),
      Assign(
        Name("temp_a"),
        Call(Attribute(Name("temp_a"), "replace"), Str(","), Str("."))),
      )
    If(Call(Name("isinstance"), Name("temp_b"), Name("str")),
      Assign(
        Name("temp_b"),
        Call(Attribute(Name("temp_b"), "replace"), Str(","), Str("."))),
      )
    If(Compare(
      Call(Name("float"), Name("temp_a")),
      CmpOp("==", Call(Name("float"), Name("temp_b")))),
      Return(NoneVal),
      )
    Return(
      IfExp(
        Compare(
          Call(Name("float"), Name("temp_a")),
          CmpOp(">", Call(Name("float"), Name("temp_b")))),
        Name("a"),
        Name("b"))))
  Assert(
    Compare(
      Call(Name("compare_one"), Int(1), Float(2.5)),
      CmpOp("==", Float(2.5))))
  Assert(
    Compare(
      Call(Name("compare_one"), Int(1), Str("2,3")),
      CmpOp("==", Str("2,3"))))
  Assert(
    Compare(
      Call(Name("compare_one"), Str("5,1"), Str("6")),
      CmpOp("==", Str("6"))))
  Assert(
    Compare(
      Call(Name("compare_one"), Str("1"), Int(1)),
      CmpOp("==", NoneVal))))
