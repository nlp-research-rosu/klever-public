Module(
  FuncDef("minSubArraySum", Params("nums"),
    Assign(Name("cur"), Subscript(Name("nums"), Int(0)))
    Assign(Name("best"), Subscript(Name("nums"), Int(0)))
    Assign(Name("first"), Bool(true))
    Assign(Name("x"), Int(0))
    For(Name("x"), Name("nums"),
      If(Name("first"),
        Assign(Name("first"), Bool(false)),
        If(Compare(
          Name("x"),
          CmpOp("<", BinOp("+", Name("cur"), Name("x")))),
          Assign(Name("cur"), Name("x")),
          Assign(Name("cur"), BinOp("+", Name("cur"), Name("x"))))
        If(Compare(Name("cur"), CmpOp("<", Name("best"))),
          Assign(Name("best"), Name("cur")),
          )))
    Return(Name("best")))
  Assert(
    Compare(
      Call(
        Name("minSubArraySum"),
        ListExpr(Int(2), Int(3), Int(4), Int(1), Int(2), Int(4))),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(
        Name("minSubArraySum"),
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(3)))),
      CmpOp("==", UnaryOp("-", Int(6)))))
  Assert(
    Compare(
      Call(
        Name("minSubArraySum"),
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(3)),
          Int(2),
          UnaryOp("-", Int(10)))),
      CmpOp("==", UnaryOp("-", Int(14)))))
  Assert(
    Compare(
      Call(
        Name("minSubArraySum"),
        ListExpr(Int(0), Int(10), Int(20), Int(1000000))),
      CmpOp("==", Int(0)))))
