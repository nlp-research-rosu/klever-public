Module(
  FuncDef("max_fill", Params("grid", "capacity"),
    Assign(Name("total"), Int(0))
    For(Name("arr"), Name("grid"),
      Assign(
        Name("total"),
        BinOp(
          "+",
          Name("total"),
          BinOp(
            "//",
            BinOp(
              "-",
              BinOp(
                "+",
                Call(Name("sum"), Name("arr")),
                Name("capacity")),
              Int(1)),
            Name("capacity")))))
    Return(Name("total"))))
