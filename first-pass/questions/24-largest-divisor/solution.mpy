Module(
  FuncDef("largest_divisor", Params("n"),
    Assign(Name("result"), Int(1))
    For(Name("i"), Call(Name("range"), Int(1), Name("n")),
      If(Compare(BinOp("%", Name("n"), Name("i")), CmpOp("==", Int(0))),
        Assign(Name("result"), Name("i")),
        ))
    Return(Name("result"))))
