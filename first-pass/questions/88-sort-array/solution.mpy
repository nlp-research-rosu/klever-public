Module(
  FuncDef("sort_array", Params("array"),
    Assign(Name("n"), Call(Name("len"), Name("array")))
    If(Compare(Name("n"), CmpOp("==", Int(0))),
      Return(ListExpr()),
      )
    Assign(
      Name("rev"),
      Compare(
        BinOp(
          "%",
          BinOp(
            "+",
            Subscript(Name("array"), Int(0)),
            Subscript(Name("array"), UnaryOp("-", Int(1)))),
          Int(2)),
        CmpOp("==", Int(0))))
    Assign(Name("s"), Call(Name("sorted"), Name("array")))
    Assign(Name("res"), ListExpr())
    Assign(Name("i"), Int(0))
    For(Name("i"), Call(Name("range"), Int(0), Name("n")),
      If(Name("rev"),
        Assign(
          Name("res"),
          BinOp(
            "+",
            Name("res"),
            ListExpr(
              Subscript(
                Name("s"),
                BinOp("-", BinOp("-", Name("n"), Int(1)), Name("i")))))),
        Assign(
          Name("res"),
          BinOp(
            "+",
            Name("res"),
            ListExpr(Subscript(Name("s"), Name("i")))))))
    Return(Name("res"))))
