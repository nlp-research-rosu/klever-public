Module(
  FuncDef("iscube", Params("a"),
    Assign(Name("a"), Call(Name("abs"), Name("a")))
    Assign(Name("found"), Bool(false))
    Assign(Name("r"), Int(0))
    For(Name("r"), Call(Name("range"), Int(0), BinOp("+", Name("a"), Int(1))),
      If(Compare(
        BinOp("*", BinOp("*", Name("r"), Name("r")), Name("r")),
        CmpOp("==", Name("a"))),
        Assign(Name("found"), Bool(true)),
        ))
    Return(Name("found")))
  Assert(Call(Name("iscube"), Int(1)))
  Assert(UnaryOp("not", Call(Name("iscube"), Int(2))))
  Assert(Call(Name("iscube"), UnaryOp("-", Int(1))))
  Assert(Call(Name("iscube"), Int(64)))
  Assert(Call(Name("iscube"), Int(0)))
  Assert(Call(Name("iscube"), Int(8)))
  Assert(Call(Name("iscube"), Int(27)))
  Assert(UnaryOp("not", Call(Name("iscube"), Int(9)))))
