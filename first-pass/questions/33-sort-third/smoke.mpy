Module(
  FuncDef("sort_third", Params("l"),
    Assign(Name("n"), Call(Name("len"), Name("l")))
    Assign(Name("thirds"), ListExpr())
    Assign(Name("st"), ListExpr())
    Assign(Name("ans"), ListExpr())
    Assign(Name("k"), Int(0))
    Assign(Name("i"), Int(0))
    For(Name("k"), Call(Name("range"), Int(0), Name("n")),
      If(Compare(BinOp("%", Name("k"), Int(3)), CmpOp("==", Int(0))),
        Assign(
          Name("thirds"),
          BinOp(
            "+",
            Name("thirds"),
            ListExpr(Subscript(Name("l"), Name("k"))))),
        ))
    Assign(Name("st"), Call(Name("sorted"), Name("thirds")))
    For(Name("i"), Call(Name("range"), Int(0), Name("n")),
      If(Compare(BinOp("%", Name("i"), Int(3)), CmpOp("==", Int(0))),
        Assign(
          Name("ans"),
          BinOp(
            "+",
            Name("ans"),
            ListExpr(
              Subscript(Name("st"), BinOp("//", Name("i"), Int(3)))))),
        Assign(
          Name("ans"),
          BinOp(
            "+",
            Name("ans"),
            ListExpr(Subscript(Name("l"), Name("i")))))))
    Return(Name("ans")))
  Assert(
    Compare(
      Call(Name("sort_third"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(3)))))
  Assert(
    Compare(
      Call(
        Name("sort_third"),
        ListExpr(Int(5), Int(6), Int(3), Int(4), Int(8), Int(9), Int(2))),
      CmpOp(
        "==",
        ListExpr(Int(2), Int(6), Int(3), Int(4), Int(8), Int(9), Int(5)))))
  Assert(
    Compare(
      Call(Name("sort_third"), ListExpr()),
      CmpOp("==", ListExpr()))))
