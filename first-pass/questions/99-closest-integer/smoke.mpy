Module(
  FuncDef("closest_integer", Params("value"),
    ImportFrom("math", "floor", "ceil")
    If(Compare(
      Call(Attribute(Name("value"), "count"), Str(".")),
      CmpOp("==", Int(1))),
      While(Compare(
        Subscript(Name("value"), UnaryOp("-", Int(1))),
        CmpOp("==", Str("0"))),
        Assign(
          Name("value"),
          Subscript(
            Name("value"),
            Slice(NoBound, UnaryOp("-", Int(1)), NoBound)))),
      )
    Assign(Name("num"), Call(Name("float"), Name("value")))
    If(Compare(
      Subscript(
        Name("value"),
        Slice(UnaryOp("-", Int(2)), NoBound, NoBound)),
      CmpOp("==", Str(".5"))),
      If(Compare(Name("num"), CmpOp(">", Int(0))),
        Assign(Name("res"), Call(Name("ceil"), Name("num"))),
        Assign(Name("res"), Call(Name("floor"), Name("num")))),
      If(Compare(Call(Name("len"), Name("value")), CmpOp(">", Int(0))),
        Assign(
          Name("res"),
          Call(Name("int"), Call(Name("round"), Name("num")))),
        Assign(Name("res"), Int(0))))
    Return(Name("res")))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("10")),
      CmpOp("==", Int(10))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("15.3")),
      CmpOp("==", Int(15))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("14.5")),
      CmpOp("==", Int(15))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-14.5")),
      CmpOp("==", UnaryOp("-", Int(15)))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("0.5")),
      CmpOp("==", Int(1))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-0.4")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("2.50")),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-2.50")),
      CmpOp("==", UnaryOp("-", Int(3)))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("7.00")),
      CmpOp("==", Int(7))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("0")),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("-100")),
      CmpOp("==", UnaryOp("-", Int(100)))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("3.7")),
      CmpOp("==", Int(4))))
  Assert(
    Compare(
      Call(Name("closest_integer"), Str("5.")),
      CmpOp("==", Int(5)))))
