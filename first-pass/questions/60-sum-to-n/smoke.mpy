Module(
  FuncDef("sum_to_n", Params("n"),
    Return(
      Call(
        Name("sum"),
        Call(Name("range"), BinOp("+", Name("n"), Int(1))))))
  Assert(
    Compare(Call(Name("sum_to_n"), Int(30)), CmpOp("==", Int(465))))
  Assert(
    Compare(Call(Name("sum_to_n"), Int(100)), CmpOp("==", Int(5050))))
  Assert(Compare(Call(Name("sum_to_n"), Int(5)), CmpOp("==", Int(15))))
  Assert(Compare(Call(Name("sum_to_n"), Int(10)), CmpOp("==", Int(55))))
  Assert(Compare(Call(Name("sum_to_n"), Int(1)), CmpOp("==", Int(1)))))
