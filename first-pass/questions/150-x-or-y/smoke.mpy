Module(
  FuncDef("x_or_y", Params("n", "x", "y"),
    Assign(Name("prime"), Compare(Name("n"), CmpOp("!=", Int(1))))
    Assign(Name("k"), Int(0))
    For(Name("k"), Call(Name("range"), Int(2), Name("n")),
      If(Compare(BinOp("%", Name("n"), Name("k")), CmpOp("==", Int(0))),
        Assign(Name("prime"), Bool(false)),
        ))
    If(Name("prime"),
      Assign(Name("ans"), Name("x")),
      Assign(Name("ans"), Name("y")))
    Return(Name("ans")))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(7), Int(34), Int(12)),
      CmpOp("==", Int(34))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(15), Int(8), Int(5)),
      CmpOp("==", Int(5))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(3), Int(33), Int(5212)),
      CmpOp("==", Int(33))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(91), Int(56), Int(129)),
      CmpOp("==", Int(129))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(6), Int(34), Int(1234)),
      CmpOp("==", Int(1234))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(1), Int(2), Int(0)),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("x_or_y"), Int(2), Int(2), Int(0)),
      CmpOp("==", Int(2)))))
