Module(
  FuncDef("choose_num", Params("x", "y"),
    If(Compare(Name("x"), CmpOp(">", Name("y"))),
      Return(UnaryOp("-", Int(1))),
      )
    If(Compare(BinOp("%", Name("y"), Int(2)), CmpOp("==", Int(0))),
      Return(Name("y")),
      )
    If(Compare(Name("x"), CmpOp("==", Name("y"))),
      Return(UnaryOp("-", Int(1))),
      )
    Return(BinOp("-", Name("y"), Int(1))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(12), Int(15)),
      CmpOp("==", Int(14))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(13), Int(12)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(33), Int(12354)),
      CmpOp("==", Int(12354))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(5234), Int(5233)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(6), Int(29)),
      CmpOp("==", Int(28))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(27), Int(10)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(7), Int(7)),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("choose_num"), Int(546), Int(546)),
      CmpOp("==", Int(546)))))
