Module(
  FuncDef("cycpattern_check", Params("a", "b"),
    Assign(Name("l"), Call(Name("len"), Name("b")))
    Assign(Name("pat"), BinOp("+", Name("b"), Name("b")))
    For(Name("i"), Call(
      Name("range"),
      BinOp(
        "+",
        BinOp("-", Call(Name("len"), Name("a")), Name("l")),
        Int(1))),
      For(Name("j"), Call(Name("range"), BinOp("+", Name("l"), Int(1))),
        If(Compare(
          Subscript(
            Name("a"),
            Slice(Name("i"), BinOp("+", Name("i"), Name("l")), NoBound)),
          CmpOp(
            "==",
            Subscript(
              Name("pat"),
              Slice(
                Name("j"),
                BinOp("+", Name("j"), Name("l")),
                NoBound)))),
          Return(Bool(true)),
          )))
    Return(Bool(false)))
  Assert(
    UnaryOp(
      "not",
      Call(Name("cycpattern_check"), Str("xyzw"), Str("xyw"))))
  Assert(Call(Name("cycpattern_check"), Str("yello"), Str("ell")))
  Assert(
    UnaryOp(
      "not",
      Call(Name("cycpattern_check"), Str("whattup"), Str("ptut"))))
  Assert(Call(Name("cycpattern_check"), Str("efef"), Str("fee")))
  Assert(
    UnaryOp(
      "not",
      Call(Name("cycpattern_check"), Str("abab"), Str("aabb"))))
  Assert(Call(Name("cycpattern_check"), Str("winemtt"), Str("tinem"))))
