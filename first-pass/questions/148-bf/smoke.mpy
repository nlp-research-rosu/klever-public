Module(
  FuncDef("bf", Params("planet1", "planet2"),
    Assign(
      Name("planet_names"),
      TupleExpr(
        Str("Mercury"),
        Str("Venus"),
        Str("Earth"),
        Str("Mars"),
        Str("Jupiter"),
        Str("Saturn"),
        Str("Uranus"),
        Str("Neptune")))
    If(BoolOp(
      "or",
      Compare(Name("planet1"), CmpOp("not in", Name("planet_names"))),
      Compare(Name("planet2"), CmpOp("not in", Name("planet_names"))),
      Compare(Name("planet1"), CmpOp("==", Name("planet2")))),
      Return(TupleExpr()),
      )
    Assign(
      Name("planet1_index"),
      Call(Attribute(Name("planet_names"), "index"), Name("planet1")))
    Assign(
      Name("planet2_index"),
      Call(Attribute(Name("planet_names"), "index"), Name("planet2")))
    If(Compare(Name("planet1_index"), CmpOp("<", Name("planet2_index"))),
      Return(
        Subscript(
          Name("planet_names"),
          Slice(
            BinOp("+", Name("planet1_index"), Int(1)),
            Name("planet2_index"),
            NoBound))),
      Return(
        Subscript(
          Name("planet_names"),
          Slice(
            BinOp("+", Name("planet2_index"), Int(1)),
            Name("planet1_index"),
            NoBound)))))
  Assert(
    Compare(
      Call(Name("bf"), Str("Jupiter"), Str("Neptune")),
      CmpOp("==", TupleExpr(Str("Saturn"), Str("Uranus")))))
  Assert(
    Compare(
      Call(Name("bf"), Str("Earth"), Str("Mercury")),
      CmpOp("==", TupleExpr(Str("Venus")))))
  Assert(
    Compare(
      Call(Name("bf"), Str("Mercury"), Str("Uranus")),
      CmpOp(
        "==",
        TupleExpr(
          Str("Venus"),
          Str("Earth"),
          Str("Mars"),
          Str("Jupiter"),
          Str("Saturn")))))
  Assert(
    Compare(
      Call(Name("bf"), Str("Earth"), Str("Earth")),
      CmpOp("==", TupleExpr())))
  Assert(
    Compare(
      Call(Name("bf"), Str("Earth"), Str("Pluto")),
      CmpOp("==", TupleExpr()))))
