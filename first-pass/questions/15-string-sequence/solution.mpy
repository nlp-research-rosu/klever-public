Module(
  FuncDef("string_sequence", Params("n"),
    Assign(Name("result"), Call(Name("str"), Int(0)))
    Assign(Name("x"), Int(0))
    For(Name("x"), Call(Name("range"), Int(1), BinOp("+", Name("n"), Int(1))),
      Assign(
        Name("result"),
        BinOp(
          "+",
          BinOp("+", Name("result"), Str(" ")),
          Call(Name("str"), Name("x")))))
    Return(Name("result"))))
