Module(
  FuncDef("Strongest_Extension", Params("class_name", "extensions"),
    Assign(Name("strong"), Subscript(Name("extensions"), Int(0)))
    Assign(
      Name("my_val"),
      BinOp(
        "-",
        Call(
          Name("len"),
          ListComp(Name("x"),
            CompFor(
              Name("x"),
              Subscript(Name("extensions"), Int(0)),
              BoolOp(
                "and",
                Call(Attribute(Name("x"), "isalpha"), ),
                Call(Attribute(Name("x"), "isupper"), ))))),
        Call(
          Name("len"),
          ListComp(Name("x"),
            CompFor(
              Name("x"),
              Subscript(Name("extensions"), Int(0)),
              BoolOp(
                "and",
                Call(Attribute(Name("x"), "isalpha"), ),
                Call(Attribute(Name("x"), "islower"), )))))))
    For(Name("s"), Name("extensions"),
      Assign(
        Name("val"),
        BinOp(
          "-",
          Call(
            Name("len"),
            ListComp(Name("x"),
              CompFor(
                Name("x"),
                Name("s"),
                BoolOp(
                  "and",
                  Call(Attribute(Name("x"), "isalpha"), ),
                  Call(Attribute(Name("x"), "isupper"), ))))),
          Call(
            Name("len"),
            ListComp(Name("x"),
              CompFor(
                Name("x"),
                Name("s"),
                BoolOp(
                  "and",
                  Call(Attribute(Name("x"), "isalpha"), ),
                  Call(Attribute(Name("x"), "islower"), )))))))
      If(Compare(Name("val"), CmpOp(">", Name("my_val"))),
        Assign(Name("strong"), Name("s"))
        Assign(Name("my_val"), Name("val")),
        ))
    Return(
      BinOp(
        "+",
        BinOp("+", Name("class_name"), Str(".")),
        Name("strong"))))
  Assert(
    Compare(
      Call(
        Name("Strongest_Extension"),
        Str("Slices"),
        ListExpr(Str("SErviNGSliCes"), Str("Cheese"), Str("StuFfed"))),
      CmpOp("==", Str("Slices.SErviNGSliCes"))))
  Assert(
    Compare(
      Call(
        Name("Strongest_Extension"),
        Str("my_class"),
        ListExpr(Str("AA"), Str("Be"), Str("CC"))),
      CmpOp("==", Str("my_class.AA")))))
