Module(
  FuncDef("add", Params("x", "y"),
    Return(BinOp("+", Name("x"), Name("y"))))
  Assert(
    Compare(Call(Name("add"), Int(0), Int(1)), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("add"), Int(1), Int(0)), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("add"), Int(2), Int(3)), CmpOp("==", Int(5))))
  Assert(
    Compare(Call(Name("add"), Int(5), Int(7)), CmpOp("==", Int(12))))
  Assert(
    Compare(Call(Name("add"), Int(7), Int(5)), CmpOp("==", Int(12)))))
