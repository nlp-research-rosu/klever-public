Module(
  FuncDef("match_parens", Params("lst"),
    Assign(
      Name("s1"),
      BinOp(
        "+",
        Subscript(Name("lst"), Int(0)),
        Subscript(Name("lst"), Int(1))))
    Assign(
      Name("s2"),
      BinOp(
        "+",
        Subscript(Name("lst"), Int(1)),
        Subscript(Name("lst"), Int(0))))
    Assign(Name("val"), Int(0))
    Assign(Name("ok"), Bool(true))
    Assign(Name("c"), Str(""))
    Assign(Name("r1"), Bool(false))
    Assign(Name("r2"), Bool(false))
    For(Name("c"), Name("s1"),
      If(Compare(Name("c"), CmpOp("==", Str("("))),
        Assign(Name("val"), BinOp("+", Name("val"), Int(1))),
        Assign(Name("val"), BinOp("-", Name("val"), Int(1))))
      If(Compare(Name("val"), CmpOp("<", Int(0))),
        Assign(Name("ok"), Bool(false)),
        ))
    Assign(
      Name("r1"),
      BoolOp(
        "and",
        Name("ok"),
        Compare(Name("val"), CmpOp("==", Int(0)))))
    Assign(Name("val"), Int(0))
    Assign(Name("ok"), Bool(true))
    For(Name("c"), Name("s2"),
      If(Compare(Name("c"), CmpOp("==", Str("("))),
        Assign(Name("val"), BinOp("+", Name("val"), Int(1))),
        Assign(Name("val"), BinOp("-", Name("val"), Int(1))))
      If(Compare(Name("val"), CmpOp("<", Int(0))),
        Assign(Name("ok"), Bool(false)),
        ))
    Assign(
      Name("r2"),
      BoolOp(
        "and",
        Name("ok"),
        Compare(Name("val"), CmpOp("==", Int(0)))))
    Return(
      IfExp(BoolOp("or", Name("r1"), Name("r2")), Str("Yes"), Str("No")))))
