Module(
  FuncDef("simplify", Params("x", "n"),
    Assign(
      TupleExpr(Name("a"), Name("b")),
      Call(Attribute(Name("x"), "split"), Str("/")))
    Assign(
      TupleExpr(Name("c"), Name("d")),
      Call(Attribute(Name("n"), "split"), Str("/")))
    Assign(
      Name("numerator"),
      BinOp(
        "*",
        Call(Name("int"), Name("a")),
        Call(Name("int"), Name("c"))))
    Assign(
      Name("denom"),
      BinOp(
        "*",
        Call(Name("int"), Name("b")),
        Call(Name("int"), Name("d"))))
    If(Compare(
      BinOp("/", Name("numerator"), Name("denom")),
      CmpOp(
        "==",
        Call(Name("int"), BinOp("/", Name("numerator"), Name("denom"))))),
      Return(Bool(true)),
      )
    Return(Bool(false)))
  Assert(
    Compare(
      Call(Name("simplify"), Str("1/5"), Str("5/1")),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(Name("simplify"), Str("1/6"), Str("2/1")),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(Name("simplify"), Str("7/10"), Str("10/2")),
      CmpOp("==", Bool(false)))))
