Module(
  FuncDef("sort_array", Params("arr"),
    Return(
      Call(
        Name("sorted"),
        Call(Name("sorted"), Name("arr")),
        KwArg(
          "key",
          Lambda(
            Params("x"),
            CellVars(),
            FreeVars(),
            Call(
              Attribute(
                Subscript(
                  Call(Name("bin"), Name("x")),
                  Slice(Int(2), NoBound, NoBound)),
                "count"),
              Str("1")))))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(Int(1), Int(5), Int(2), Int(3), Int(4))),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(4), Int(3), Int(5)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(4)),
          UnaryOp("-", Int(5)),
          UnaryOp("-", Int(6)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(4)),
          UnaryOp("-", Int(2)),
          UnaryOp("-", Int(6)),
          UnaryOp("-", Int(5)),
          UnaryOp("-", Int(3))))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(Int(1), Int(0), Int(2), Int(3), Int(4))),
      CmpOp("==", ListExpr(Int(0), Int(1), Int(2), Int(4), Int(3)))))
  Assert(
    Compare(
      Call(Name("sort_array"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(
          Int(2),
          Int(5),
          Int(77),
          Int(4),
          Int(5),
          Int(3),
          Int(5),
          Int(7),
          Int(2),
          Int(3),
          Int(4))),
      CmpOp(
        "==",
        ListExpr(
          Int(2),
          Int(2),
          Int(4),
          Int(4),
          Int(3),
          Int(3),
          Int(5),
          Int(5),
          Int(5),
          Int(7),
          Int(77)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(Int(3), Int(6), Int(44), Int(12), Int(32), Int(5))),
      CmpOp(
        "==",
        ListExpr(Int(32), Int(3), Int(5), Int(6), Int(12), Int(44)))))
  Assert(
    Compare(
      Call(
        Name("sort_array"),
        ListExpr(Int(2), Int(4), Int(8), Int(16), Int(32))),
      CmpOp("==", ListExpr(Int(2), Int(4), Int(8), Int(16), Int(32))))))
