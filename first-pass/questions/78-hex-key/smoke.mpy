Module(
  FuncDef("hex_key", Params("num"),
    Assign(Name("count"), Int(0))
    Assign(Name("c"), Str(""))
    Assign(Name("code"), Int(0))
    For(Name("c"), Name("num"),
      Assign(Name("code"), Call(Name("ord"), Name("c")))
      If(BoolOp(
        "or",
        Compare(Name("code"), CmpOp("==", Int(50))),
        Compare(Name("code"), CmpOp("==", Int(51))),
        Compare(Name("code"), CmpOp("==", Int(53))),
        Compare(Name("code"), CmpOp("==", Int(55))),
        Compare(Name("code"), CmpOp("==", Int(66))),
        Compare(Name("code"), CmpOp("==", Int(68)))),
        Assign(Name("count"), BinOp("+", Name("count"), Int(1))),
        ))
    Return(Name("count")))
  Assert(Compare(Call(Name("hex_key"), Str("AB")), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("hex_key"), Str("1077E")), CmpOp("==", Int(2))))
  Assert(
    Compare(Call(Name("hex_key"), Str("ABED1A33")), CmpOp("==", Int(4))))
  Assert(
    Compare(Call(Name("hex_key"), Str("2020")), CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("hex_key"), Str("123456789ABCDEF0")),
      CmpOp("==", Int(6))))
  Assert(
    Compare(
      Call(Name("hex_key"), Str("112233445566778899AABBCCDDEEFF00")),
      CmpOp("==", Int(12))))
  Assert(Compare(Call(Name("hex_key"), Str("")), CmpOp("==", Int(0)))))
