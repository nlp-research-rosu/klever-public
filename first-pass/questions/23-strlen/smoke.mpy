Module(
  FuncDef("strlen", Params("string"),
    Return(Call(Name("len"), Name("string"))))
  Assert(Compare(Call(Name("strlen"), Str("")), CmpOp("==", Int(0))))
  Assert(Compare(Call(Name("strlen"), Str("x")), CmpOp("==", Int(1))))
  Assert(
    Compare(Call(Name("strlen"), Str("asdasnakj")), CmpOp("==", Int(9)))))
