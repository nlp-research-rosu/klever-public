Module(
  FuncDef("prod_signs", Params("arr"),
    Assign(Name("sum_abs"), Int(0))
    Assign(Name("sign_prod"), Int(1))
    Assign(Name("n"), Int(0))
    Assign(Name("x"), Int(0))
    For(Name("x"), Name("arr"),
      Assign(Name("n"), BinOp("+", Name("n"), Int(1)))
      If(Compare(Name("x"), CmpOp("<", Int(0))),
        Assign(
          Name("sum_abs"),
          BinOp("+", Name("sum_abs"), BinOp("-", Int(0), Name("x"))))
        Assign(
          Name("sign_prod"),
          BinOp("*", Name("sign_prod"), UnaryOp("-", Int(1)))),
        If(Compare(Name("x"), CmpOp(">", Int(0))),
          Assign(
            Name("sum_abs"),
            BinOp("+", Name("sum_abs"), Name("x"))),
          Assign(
            Name("sign_prod"),
            BinOp("*", Name("sign_prod"), Int(0))))))
    Assign(Name("result"), NoneVal)
    If(Compare(Name("n"), CmpOp(">", Int(0))),
      Assign(
        Name("result"),
        BinOp("*", Name("sign_prod"), Name("sum_abs"))),
      )
    Return(Name("result"))))
