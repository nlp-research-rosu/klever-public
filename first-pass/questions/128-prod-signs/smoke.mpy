Module(
  FuncDef("prod_signs", Params("arr"),
    Assign(Name("sum_abs"), Int(0))
    Assign(Name("sign_prod"), Int(1))
    Assign(Name("n"), Int(0))
    Assign(Name("x"), Int(0))
    For(Name("x"), Name("arr"),
      Assign(Name("n"), BinOp("+", Name("n"), Int(1)))
      If(Compare(Name("x"), CmpOp("<", Int(0))),
        Assign(
          Name("sum_abs"),
          BinOp("+", Name("sum_abs"), BinOp("-", Int(0), Name("x"))))
        Assign(
          Name("sign_prod"),
          BinOp("*", Name("sign_prod"), UnaryOp("-", Int(1)))),
        If(Compare(Name("x"), CmpOp(">", Int(0))),
          Assign(
            Name("sum_abs"),
            BinOp("+", Name("sum_abs"), Name("x"))),
          Assign(
            Name("sign_prod"),
            BinOp("*", Name("sign_prod"), Int(0))))))
    Assign(Name("result"), NoneVal)
    If(Compare(Name("n"), CmpOp(">", Int(0))),
      Assign(
        Name("result"),
        BinOp("*", Name("sign_prod"), Name("sum_abs"))),
      )
    Return(Name("result")))
  Assert(
    Compare(
      Call(
        Name("prod_signs"),
        ListExpr(Int(1), Int(2), Int(2), UnaryOp("-", Int(4)))),
      CmpOp("==", UnaryOp("-", Int(9)))))
  Assert(
    Compare(
      Call(Name("prod_signs"), ListExpr(Int(0), Int(1))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("prod_signs"),
        ListExpr(
          Int(1),
          Int(1),
          Int(1),
          Int(2),
          Int(3),
          UnaryOp("-", Int(1)),
          Int(1))),
      CmpOp("==", UnaryOp("-", Int(10)))))
  Assert(
    Compare(Call(Name("prod_signs"), ListExpr()), CmpOp("is", NoneVal)))
  Assert(
    Compare(
      Call(
        Name("prod_signs"),
        ListExpr(
          Int(2),
          Int(4),
          Int(1),
          Int(2),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(1)),
          Int(9))),
      CmpOp("==", Int(20))))
  Assert(
    Compare(
      Call(
        Name("prod_signs"),
        ListExpr(
          UnaryOp("-", Int(1)),
          Int(1),
          UnaryOp("-", Int(1)),
          Int(1))),
      CmpOp("==", Int(4))))
  Assert(
    Compare(
      Call(
        Name("prod_signs"),
        ListExpr(UnaryOp("-", Int(1)), Int(1), Int(1), Int(1))),
      CmpOp("==", UnaryOp("-", Int(4)))))
  Assert(
    Compare(
      Call(
        Name("prod_signs"),
        ListExpr(UnaryOp("-", Int(1)), Int(1), Int(1), Int(0))),
      CmpOp("==", Int(0)))))
