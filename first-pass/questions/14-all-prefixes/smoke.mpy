Module(
  FuncDef("all_prefixes", Params("string"),
    Assign(Name("result"), ListExpr())
    Assign(Name("acc"), Str(""))
    Assign(Name("c"), Str(""))
    For(Name("c"), Name("string"),
      Assign(Name("acc"), BinOp("+", Name("acc"), Name("c")))
      Assign(
        Name("result"),
        BinOp("+", Name("result"), ListExpr(Name("acc")))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("all_prefixes"), Str("")),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("all_prefixes"), Str("asdfgh")),
      CmpOp(
        "==",
        ListExpr(
          Str("a"),
          Str("as"),
          Str("asd"),
          Str("asdf"),
          Str("asdfg"),
          Str("asdfgh")))))
  Assert(
    Compare(
      Call(Name("all_prefixes"), Str("WWW")),
      CmpOp("==", ListExpr(Str("W"), Str("WW"), Str("WWW"))))))
