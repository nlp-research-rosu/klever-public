Module(
  FuncDef("valid_date", Params("date"),
    Assign(Name("date"), Call(Attribute(Name("date"), "strip"), ))
    Assign(
      Name("parts"),
      Call(Attribute(Name("date"), "split"), Str("-")))
    If(Compare(Call(Name("len"), Name("parts")), CmpOp("!=", Int(3))),
      Return(Bool(false)),
      )
    Assign(
      TupleExpr(Name("month"), Name("day"), Name("year")),
      Name("parts"))
    If(UnaryOp(
      "not",
      BoolOp(
        "and",
        Call(Attribute(Name("month"), "isdigit"), ),
        Call(Attribute(Name("day"), "isdigit"), ),
        Call(Attribute(Name("year"), "isdigit"), ))),
      Return(Bool(false)),
      )
    Assign(
      TupleExpr(Name("month"), Name("day"), Name("year")),
      TupleExpr(
        Call(Name("int"), Name("month")),
        Call(Name("int"), Name("day")),
        Call(Name("int"), Name("year"))))
    If(BoolOp(
      "or",
      Compare(Name("month"), CmpOp("<", Int(1))),
      Compare(Name("month"), CmpOp(">", Int(12)))),
      Return(Bool(false)),
      )
    If(BoolOp(
      "or",
      BoolOp(
        "and",
        Compare(
          Name("month"),
          CmpOp(
            "in",
            ListExpr(
              Int(1),
              Int(3),
              Int(5),
              Int(7),
              Int(8),
              Int(10),
              Int(12)))),
        Compare(Name("day"), CmpOp("<", Int(1)))),
      Compare(Name("day"), CmpOp(">", Int(31)))),
      Return(Bool(false)),
      )
    If(BoolOp(
      "or",
      BoolOp(
        "and",
        Compare(
          Name("month"),
          CmpOp("in", ListExpr(Int(4), Int(6), Int(9), Int(11)))),
        Compare(Name("day"), CmpOp("<", Int(1)))),
      Compare(Name("day"), CmpOp(">", Int(30)))),
      Return(Bool(false)),
      )
    If(BoolOp(
      "or",
      BoolOp(
        "and",
        Compare(Name("month"), CmpOp("==", Int(2))),
        Compare(Name("day"), CmpOp("<", Int(1)))),
      Compare(Name("day"), CmpOp(">", Int(29)))),
      Return(Bool(false)),
      )
    Return(Bool(true))))
