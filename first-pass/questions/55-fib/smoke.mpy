Module(
  FuncDef("fib", Params("n"),
    Assign(TupleExpr(Name("a"), Name("b")), TupleExpr(Int(0), Int(1)))
    For(Name("_"), Call(Name("range"), Name("n")),
      Assign(TupleExpr(Name("a"), Name("b")),
             TupleExpr(Name("b"), BinOp("+", Name("a"), Name("b")))))
    Return(Name("a")))
  Assert(Compare(Call(Name("fib"), Int(10)), CmpOp("==", Int(55))))
  Assert(Compare(Call(Name("fib"), Int(1)),  CmpOp("==", Int(1))))
  Assert(Compare(Call(Name("fib"), Int(8)),  CmpOp("==", Int(21))))
  Assert(Compare(Call(Name("fib"), Int(11)), CmpOp("==", Int(89))))
  Assert(Compare(Call(Name("fib"), Int(12)), CmpOp("==", Int(144)))))
