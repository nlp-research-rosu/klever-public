Module(
  FuncDef("is_bored", Params("S"),
    Assign(Name("count"), Int(0))
    Assign(Name("phase"), Int(0))
    Assign(Name("cand"), Int(0))
    Assign(Name("i"), Int(0))
    Assign(Name("n"), Call(Name("len"), Name("S")))
    While(Compare(Name("i"), CmpOp("<", Name("n"))),
      If(BoolOp(
        "and",
        Compare(Name("phase"), CmpOp("==", Int(3))),
        BoolOp(
          "or",
          Compare(
            Call(Name("ord"), Subscript(Name("S"), Name("i"))),
            CmpOp("==", Int(46))),
          Compare(
            Call(Name("ord"), Subscript(Name("S"), Name("i"))),
            CmpOp("==", Int(63))),
          Compare(
            Call(Name("ord"), Subscript(Name("S"), Name("i"))),
            CmpOp("==", Int(33))),
          BoolOp(
            "and",
            Compare(
              Int(9),
              CmpOp(
                "<=",
                Call(Name("ord"), Subscript(Name("S"), Name("i"))))),
            Compare(
              Call(Name("ord"), Subscript(Name("S"), Name("i"))),
              CmpOp("<=", Int(13)))),
          BoolOp(
            "and",
            Compare(
              Int(28),
              CmpOp(
                "<=",
                Call(Name("ord"), Subscript(Name("S"), Name("i"))))),
            Compare(
              Call(Name("ord"), Subscript(Name("S"), Name("i"))),
              CmpOp("<=", Int(32)))))),
        Assign(Name("phase"), Int(3)),
        If(BoolOp(
          "or",
          Compare(
            Call(Name("ord"), Subscript(Name("S"), Name("i"))),
            CmpOp("==", Int(46))),
          Compare(
            Call(Name("ord"), Subscript(Name("S"), Name("i"))),
            CmpOp("==", Int(63))),
          Compare(
            Call(Name("ord"), Subscript(Name("S"), Name("i"))),
            CmpOp("==", Int(33)))),
          If(Compare(Name("cand"), CmpOp("==", Int(2))),
            Assign(Name("count"), BinOp("+", Name("count"), Int(1))),
            )
          Assign(Name("cand"), Int(0))
          Assign(Name("phase"), Int(3)),
          If(BoolOp(
            "or",
            Compare(Name("phase"), CmpOp("==", Int(3))),
            Compare(Name("phase"), CmpOp("==", Int(0)))),
            Assign(
              Name("cand"),
              IfExp(
                Compare(
                  Call(Name("ord"), Subscript(Name("S"), Name("i"))),
                  CmpOp("==", Int(73))),
                Int(1),
                Int(0)))
            Assign(Name("phase"), Int(1)),
            If(Compare(Name("phase"), CmpOp("==", Int(1))),
              Assign(
                Name("cand"),
                IfExp(
                  BoolOp(
                    "and",
                    Compare(Name("cand"), CmpOp("==", Int(1))),
                    Compare(
                      Call(Name("ord"), Subscript(Name("S"), Name("i"))),
                      CmpOp("==", Int(32)))),
                  Int(2),
                  Int(0)))
              Assign(Name("phase"), Int(2)),
              ))))
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    If(Compare(Name("cand"), CmpOp("==", Int(2))),
      Assign(Name("count"), BinOp("+", Name("count"), Int(1))),
      )
    Return(Name("count"))))
