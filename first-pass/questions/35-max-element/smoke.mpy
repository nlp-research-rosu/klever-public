Module(
  FuncDef("max_element", Params("l"),
    Assign(Name("m"), Subscript(Name("l"), Int(0)))
    For(Name("e"), Name("l"),
      If(Compare(Name("e"), CmpOp(">", Name("m"))),
        Assign(Name("m"), Name("e")),
        ))
    Return(Name("m")))
  Assert(
    Compare(
      Call(Name("max_element"), ListExpr(Int(1), Int(2), Int(3))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("max_element"),
        ListExpr(
          Int(5),
          Int(3),
          UnaryOp("-", Int(5)),
          Int(2),
          UnaryOp("-", Int(3)),
          Int(3),
          Int(9),
          Int(0),
          Int(124),
          Int(1),
          UnaryOp("-", Int(10)))),
      CmpOp("==", Int(124))))
  Assert(
    Compare(
      Call(Name("max_element"), ListExpr(Int(7))),
      CmpOp("==", Int(7))))
  Assert(
    Compare(
      Call(
        Name("max_element"),
        ListExpr(
          UnaryOp("-", Int(5)),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(3)))),
      CmpOp("==", UnaryOp("-", Int(1)))))
  Assert(
    Compare(
      Call(Name("max_element"), ListExpr(Int(3), Int(3), Int(3))),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(
        Name("max_element"),
        ListExpr(Int(5), Int(2), Int(5), Int(1))),
      CmpOp("==", Int(5))))
  Assert(
    Compare(
      Call(
        Name("max_element"),
        ListExpr(Int(1), Int(2), Int(3), Int(100))),
      CmpOp("==", Int(100))))
  Assert(
    Compare(
      Call(
        Name("max_element"),
        ListExpr(Int(100), Int(1), Int(2), Int(3))),
      CmpOp("==", Int(100))))
  Assert(
    Compare(
      Call(
        Name("max_element"),
        ListExpr(UnaryOp("-", Int(2)), Int(0), UnaryOp("-", Int(5)))),
      CmpOp("==", Int(0)))))
