Module(
  FuncDef("is_sorted", Params("lst"),
    Assign(Name("n"), Call(Name("len"), Name("lst")))
    Assign(Name("nondec"), Bool(true))
    Assign(Name("no3"), Bool(true))
    Assign(Name("i"), Int(0))
    For(Name("i"), Call(Name("range"), Int(1), Name("n")),
      If(Compare(
        Subscript(Name("lst"), BinOp("-", Name("i"), Int(1))),
        CmpOp(">", Subscript(Name("lst"), Name("i")))),
        Assign(Name("nondec"), Bool(false)),
        ))
    For(Name("i"), Call(Name("range"), Int(2), Name("n")),
      If(Compare(
        Subscript(Name("lst"), BinOp("-", Name("i"), Int(2))),
        CmpOp(
          "==",
          Subscript(Name("lst"), BinOp("-", Name("i"), Int(1))))),
        If(Compare(
          Subscript(Name("lst"), BinOp("-", Name("i"), Int(1))),
          CmpOp("==", Subscript(Name("lst"), Name("i")))),
          Assign(Name("no3"), Bool(false)),
          ),
        ))
    Return(BoolOp("and", Name("nondec"), Name("no3"))))
  Assert(Call(Name("is_sorted"), ListExpr(Int(5))))
  Assert(
    Call(
      Name("is_sorted"),
      ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("is_sorted"),
        ListExpr(Int(1), Int(3), Int(2), Int(4), Int(5)))))
  Assert(
    Call(
      Name("is_sorted"),
      ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5), Int(6))))
  Assert(
    UnaryOp(
      "not",
      Call(
        Name("is_sorted"),
        ListExpr(Int(1), Int(2), Int(2), Int(2), Int(3), Int(4)))))
  Assert(
    Call(
      Name("is_sorted"),
      ListExpr(Int(1), Int(2), Int(2), Int(3), Int(3), Int(4)))))
