Module(
  FuncDef("minPath", Params("grid", "k"),
    Assign(Name("n"), Call(Name("len"), Name("grid")))
    Assign(
      Name("val"),
      BinOp("+", BinOp("*", Name("n"), Name("n")), Int(1)))
    For(Name("i"), Call(Name("range"), Name("n")),
      For(Name("j"), Call(Name("range"), Name("n")),
        If(Compare(
          Subscript(Subscript(Name("grid"), Name("i")), Name("j")),
          CmpOp("==", Int(1))),
          Assign(Name("temp"), ListExpr())
          If(Compare(Name("i"), CmpOp("!=", Int(0))),
            Assign(
              Name("temp"),
              BinOp(
                "+",
                Name("temp"),
                ListExpr(
                  Subscript(
                    Subscript(
                      Name("grid"),
                      BinOp("-", Name("i"), Int(1))),
                    Name("j"))))),
            )
          If(Compare(Name("j"), CmpOp("!=", Int(0))),
            Assign(
              Name("temp"),
              BinOp(
                "+",
                Name("temp"),
                ListExpr(
                  Subscript(
                    Subscript(Name("grid"), Name("i")),
                    BinOp("-", Name("j"), Int(1)))))),
            )
          If(Compare(Name("i"), CmpOp("!=", BinOp("-", Name("n"), Int(1)))),
            Assign(
              Name("temp"),
              BinOp(
                "+",
                Name("temp"),
                ListExpr(
                  Subscript(
                    Subscript(
                      Name("grid"),
                      BinOp("+", Name("i"), Int(1))),
                    Name("j"))))),
            )
          If(Compare(Name("j"), CmpOp("!=", BinOp("-", Name("n"), Int(1)))),
            Assign(
              Name("temp"),
              BinOp(
                "+",
                Name("temp"),
                ListExpr(
                  Subscript(
                    Subscript(Name("grid"), Name("i")),
                    BinOp("+", Name("j"), Int(1)))))),
            )
          Assign(Name("val"), Call(Name("min"), Name("temp"))),
          )))
    Assign(Name("ans"), ListExpr())
    For(Name("i"), Call(Name("range"), Name("k")),
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
        Assign(Name("ans"), BinOp("+", Name("ans"), ListExpr(Int(1)))),
        Assign(
          Name("ans"),
          BinOp("+", Name("ans"), ListExpr(Name("val"))))))
    Return(Name("ans")))
  Assert(
    Compare(
      Call(
        Name("minPath"),
        ListExpr(
          ListExpr(Int(1), Int(2), Int(3)),
          ListExpr(Int(4), Int(5), Int(6)),
          ListExpr(Int(7), Int(8), Int(9))),
        Int(3)),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(1)))))
  Assert(
    Compare(
      Call(
        Name("minPath"),
        ListExpr(
          ListExpr(Int(5), Int(9), Int(3)),
          ListExpr(Int(4), Int(1), Int(6)),
          ListExpr(Int(7), Int(8), Int(2))),
        Int(1)),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(
        Name("minPath"),
        ListExpr(ListExpr(Int(1), Int(2)), ListExpr(Int(3), Int(4))),
        Int(4)),
      CmpOp("==", ListExpr(Int(1), Int(2), Int(1), Int(2))))))
