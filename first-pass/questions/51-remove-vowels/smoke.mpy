Module(
  FuncDef("remove_vowels", Params("text"),
    Assign(Name("result"), Str(""))
    Assign(Name("s"), Str(""))
    Assign(Name("code"), Int(0))
    For(Name("s"), Name("text"),
      Assign(Name("code"), Call(Name("ord"), Name("s")))
      If(BoolOp(
        "and",
        Compare(Name("code"), CmpOp("!=", Int(97))),
        Compare(Name("code"), CmpOp("!=", Int(101))),
        Compare(Name("code"), CmpOp("!=", Int(105))),
        Compare(Name("code"), CmpOp("!=", Int(111))),
        Compare(Name("code"), CmpOp("!=", Int(117))),
        Compare(Name("code"), CmpOp("!=", Int(65))),
        Compare(Name("code"), CmpOp("!=", Int(69))),
        Compare(Name("code"), CmpOp("!=", Int(73))),
        Compare(Name("code"), CmpOp("!=", Int(79))),
        Compare(Name("code"), CmpOp("!=", Int(85)))),
        Assign(Name("result"), BinOp("+", Name("result"), Name("s"))),
        ))
    Return(Name("result")))
  Assert(
    Compare(Call(Name("remove_vowels"), Str("")), CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("remove_vowels"), Str("abcdef\nghijklm")),
      CmpOp("==", Str("bcdf\nghjklm"))))
  Assert(
    Compare(
      Call(Name("remove_vowels"), Str("fedcba")),
      CmpOp("==", Str("fdcb"))))
  Assert(
    Compare(
      Call(Name("remove_vowels"), Str("eeeee")),
      CmpOp("==", Str(""))))
  Assert(
    Compare(
      Call(Name("remove_vowels"), Str("acBAA")),
      CmpOp("==", Str("cB"))))
  Assert(
    Compare(
      Call(Name("remove_vowels"), Str("EcBOO")),
      CmpOp("==", Str("cB"))))
  Assert(
    Compare(
      Call(Name("remove_vowels"), Str("ybcd")),
      CmpOp("==", Str("ybcd")))))
