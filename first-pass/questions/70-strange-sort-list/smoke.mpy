Module(
  FuncDef("strange_sort_list", Params("lst"),
    Assign(Name("n"), Call(Name("len"), Name("lst")))
    Assign(Name("s"), Call(Name("sorted"), Name("lst")))
    Assign(Name("res"), ListExpr())
    Assign(Name("i"), Int(0))
    For(Name("i"), Call(Name("range"), Int(0), Name("n")),
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
        Assign(
          Name("res"),
          BinOp(
            "+",
            Name("res"),
            ListExpr(
              Subscript(Name("s"), BinOp("//", Name("i"), Int(2)))))),
        Assign(
          Name("res"),
          BinOp(
            "+",
            Name("res"),
            ListExpr(
              Subscript(
                Name("s"),
                BinOp(
                  "-",
                  BinOp("-", Name("n"), Int(1)),
                  BinOp("//", Name("i"), Int(2)))))))))
    Return(Name("res")))
  Assert(
    Compare(
      Call(
        Name("strange_sort_list"),
        ListExpr(Int(1), Int(2), Int(3), Int(4))),
      CmpOp("==", ListExpr(Int(1), Int(4), Int(2), Int(3)))))
  Assert(
    Compare(
      Call(
        Name("strange_sort_list"),
        ListExpr(Int(5), Int(5), Int(5), Int(5))),
      CmpOp("==", ListExpr(Int(5), Int(5), Int(5), Int(5)))))
  Assert(
    Compare(
      Call(Name("strange_sort_list"), ListExpr()),
      CmpOp("==", ListExpr()))))
