Module(
  FuncDef("next_smallest", Params("lst"),
    If(UnaryOp("not", Name("lst")),
      Return(NoneVal),
      )
    Assign(Name("min1"), Subscript(Name("lst"), Int(0)))
    For(Name("x"), Name("lst"),
      If(Compare(Name("x"), CmpOp("<", Name("min1"))),
        Assign(Name("min1"), Name("x")),
        ))
    Assign(Name("found"), Bool(false))
    Assign(Name("m2"), Int(0))
    For(Name("x"), Name("lst"),
      If(Compare(Name("x"), CmpOp(">", Name("min1"))),
        If(Name("found"),
          If(Compare(Name("x"), CmpOp("<", Name("m2"))),
            Assign(Name("m2"), Name("x")),
            ),
          Assign(Name("m2"), Name("x"))
          Assign(Name("found"), Bool(true))),
        ))
    Return(IfExp(Name("found"), Name("m2"), NoneVal)))
  Assert(
    Compare(
      Call(
        Name("next_smallest"),
        ListExpr(Int(1), Int(2), Int(3), Int(4), Int(5))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(
        Name("next_smallest"),
        ListExpr(Int(5), Int(1), Int(4), Int(3), Int(2))),
      CmpOp("==", Int(2))))
  Assert(
    Compare(
      Call(Name("next_smallest"), ListExpr()),
      CmpOp("is", NoneVal)))
  Assert(
    Compare(
      Call(Name("next_smallest"), ListExpr(Int(1), Int(1))),
      CmpOp("is", NoneVal))))
