Module(
  FuncDef("reverse_delete", Params("s", "c"),
    Assign(Name("kept"), Str(""))
    Assign(Name("rev"), Str(""))
    Assign(Name("ch"), Str(""))
    For(Name("ch"), Name("s"),
      If(Compare(Name("ch"), CmpOp("not in", Name("c"))),
        Assign(Name("kept"), BinOp("+", Name("kept"), Name("ch")))
        Assign(Name("rev"), BinOp("+", Name("ch"), Name("rev"))),
        ))
    Return(
      TupleExpr(
        Name("kept"),
        Compare(Name("kept"), CmpOp("==", Name("rev"))))))
  Assert(
    Compare(
      Call(Name("reverse_delete"), Str("abcde"), Str("ae")),
      CmpOp("==", TupleExpr(Str("bcd"), Bool(false)))))
  Assert(
    Compare(
      Call(Name("reverse_delete"), Str("abcdef"), Str("b")),
      CmpOp("==", TupleExpr(Str("acdef"), Bool(false)))))
  Assert(
    Compare(
      Call(Name("reverse_delete"), Str("abcdedcba"), Str("ab")),
      CmpOp("==", TupleExpr(Str("cdedc"), Bool(true)))))
  Assert(
    Compare(
      Call(Name("reverse_delete"), Str("dwik"), Str("w")),
      CmpOp("==", TupleExpr(Str("dik"), Bool(false)))))
  Assert(
    Compare(
      Call(Name("reverse_delete"), Str("a"), Str("a")),
      CmpOp("==", TupleExpr(Str(""), Bool(true)))))
  Assert(
    Compare(
      Call(Name("reverse_delete"), Str("abcdedcba"), Str("")),
      CmpOp("==", TupleExpr(Str("abcdedcba"), Bool(true)))))
  Assert(
    Compare(
      Call(Name("reverse_delete"), Str("vabba"), Str("v")),
      CmpOp("==", TupleExpr(Str("abba"), Bool(true)))))
  Assert(
    Compare(
      Call(Name("reverse_delete"), Str("mamma"), Str("mia")),
      CmpOp("==", TupleExpr(Str(""), Bool(true))))))
