Module(
  FuncDef("order_by_points", Params("nums"),
    FuncDef("digits_sum", Params("n"), CellVars(), FreeVars(),
      Assign(Name("neg"), Int(1))
      If(Compare(Name("n"), CmpOp("<", Int(0))),
        Assign(
          TupleExpr(Name("n"), Name("neg")),
          TupleExpr(
            BinOp("*", UnaryOp("-", Int(1)), Name("n")),
            UnaryOp("-", Int(1)))),
        )
      Assign(
        Name("n"),
        ListComp(Call(Name("int"), Name("i")),
          CompFor(Name("i"), Call(Name("str"), Name("n")), Bool(true))))
      Assign(
        Subscript(Name("n"), Int(0)),
        BinOp("*", Subscript(Name("n"), Int(0)), Name("neg")))
      Return(Call(Name("sum"), Name("n"))))
    Return(
      Call(
        Name("sorted"),
        Name("nums"),
        KwArg("key", Name("digits_sum")))))
  Assert(
    Compare(
      Call(
        Name("order_by_points"),
        ListExpr(
          Int(1),
          Int(11),
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(11)),
          UnaryOp("-", Int(12)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(1)),
          UnaryOp("-", Int(11)),
          Int(1),
          UnaryOp("-", Int(12)),
          Int(11)))))
  Assert(
    Compare(
      Call(
        Name("order_by_points"),
        ListExpr(
          Int(1234),
          Int(423),
          Int(463),
          Int(145),
          Int(2),
          Int(423),
          Int(423),
          Int(53),
          Int(6),
          Int(37),
          Int(3457),
          Int(3),
          Int(56),
          Int(0),
          Int(46))),
      CmpOp(
        "==",
        ListExpr(
          Int(0),
          Int(2),
          Int(3),
          Int(6),
          Int(53),
          Int(423),
          Int(423),
          Int(423),
          Int(1234),
          Int(145),
          Int(37),
          Int(46),
          Int(56),
          Int(463),
          Int(3457)))))
  Assert(
    Compare(
      Call(Name("order_by_points"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(
        Name("order_by_points"),
        ListExpr(
          Int(1),
          UnaryOp("-", Int(11)),
          UnaryOp("-", Int(32)),
          Int(43),
          Int(54),
          UnaryOp("-", Int(98)),
          Int(2),
          UnaryOp("-", Int(3)))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(3)),
          UnaryOp("-", Int(32)),
          UnaryOp("-", Int(98)),
          UnaryOp("-", Int(11)),
          Int(1),
          Int(2),
          Int(43),
          Int(54)))))
  Assert(
    Compare(
      Call(
        Name("order_by_points"),
        ListExpr(
          Int(1),
          Int(2),
          Int(3),
          Int(4),
          Int(5),
          Int(6),
          Int(7),
          Int(8),
          Int(9),
          Int(10),
          Int(11))),
      CmpOp(
        "==",
        ListExpr(
          Int(1),
          Int(10),
          Int(2),
          Int(11),
          Int(3),
          Int(4),
          Int(5),
          Int(6),
          Int(7),
          Int(8),
          Int(9)))))
  Assert(
    Compare(
      Call(
        Name("order_by_points"),
        ListExpr(
          Int(0),
          Int(6),
          Int(6),
          UnaryOp("-", Int(76)),
          UnaryOp("-", Int(21)),
          Int(23),
          Int(4))),
      CmpOp(
        "==",
        ListExpr(
          UnaryOp("-", Int(76)),
          UnaryOp("-", Int(21)),
          Int(0),
          Int(4),
          Int(23),
          Int(6),
          Int(6))))))
