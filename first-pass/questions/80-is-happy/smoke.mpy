Module(
  FuncDef("is_happy", Params("s"),
    Assign(Name("happy"), Bool(true))
    Assign(Name("i"), Int(0))
    Assign(Name("p1"), Int(0))
    Assign(Name("p2"), Int(0))
    Assign(Name("code"), Int(0))
    Assign(Name("c"), Str(""))
    For(Name("c"), Name("s"),
      Assign(Name("code"), Call(Name("ord"), Name("c")))
      If(Compare(Name("i"), CmpOp(">=", Int(2))),
        If(BoolOp(
          "or",
          Compare(Name("code"), CmpOp("==", Name("p1"))),
          Compare(Name("p1"), CmpOp("==", Name("p2"))),
          Compare(Name("code"), CmpOp("==", Name("p2")))),
          Assign(Name("happy"), Bool(false)),
          ),
        )
      Assign(Name("p2"), Name("p1"))
      Assign(Name("p1"), Name("code"))
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(
      BoolOp(
        "and",
        Compare(Name("i"), CmpOp(">=", Int(3))),
        Name("happy"))))
  Assert(UnaryOp("not", Call(Name("is_happy"), Str("a"))))
  Assert(UnaryOp("not", Call(Name("is_happy"), Str("aa"))))
  Assert(Call(Name("is_happy"), Str("abcd")))
  Assert(UnaryOp("not", Call(Name("is_happy"), Str("aabb"))))
  Assert(Call(Name("is_happy"), Str("adb")))
  Assert(UnaryOp("not", Call(Name("is_happy"), Str("xyy"))))
  Assert(Call(Name("is_happy"), Str("iopaxpoi")))
  Assert(UnaryOp("not", Call(Name("is_happy"), Str("iopaxioi")))))
