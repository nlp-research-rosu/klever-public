Module(
  FuncDef("get_odd_collatz", Params("n"),
    Assign(Name("odd_collatz"), ListExpr())
    If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
      Assign(Name("odd_collatz"), ListExpr(Name("n"))),
      )
    While(Compare(Name("n"), CmpOp(">", Int(1))),
      If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(0))),
        Assign(Name("n"), BinOp("//", Name("n"), Int(2))),
        Assign(
          Name("n"),
          BinOp("+", BinOp("*", Name("n"), Int(3)), Int(1))))
      If(Compare(BinOp("%", Name("n"), Int(2)), CmpOp("==", Int(1))),
        Assign(
          Name("odd_collatz"),
          BinOp("+", Name("odd_collatz"), ListExpr(Name("n")))),
        ))
    Return(Call(Name("sorted"), Name("odd_collatz"))))
  Assert(
    Compare(
      Call(Name("get_odd_collatz"), Int(1)),
      CmpOp("==", ListExpr(Int(1)))))
  Assert(
    Compare(
      Call(Name("get_odd_collatz"), Int(5)),
      CmpOp("==", ListExpr(Int(1), Int(5)))))
  Assert(
    Compare(
      Call(Name("get_odd_collatz"), Int(3)),
      CmpOp("==", ListExpr(Int(1), Int(3), Int(5))))))
