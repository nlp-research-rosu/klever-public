Module(
  FuncDef("solution", Params("lst"),
    Assign(Name("result"), Int(0))
    Assign(Name("i"), Int(0))
    Assign(Name("e"), Int(0))
    For(Name("e"), Name("lst"),
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
        If(Compare(BinOp("%", Name("e"), Int(2)), CmpOp("==", Int(1))),
          Assign(Name("result"), BinOp("+", Name("result"), Name("e"))),
          ),
        )
      Assign(Name("i"), BinOp("+", Name("i"), Int(1))))
    Return(Name("result")))
  Assert(
    Compare(
      Call(Name("solution"), ListExpr(Int(5), Int(8), Int(7), Int(1))),
      CmpOp("==", Int(12))))
  Assert(
    Compare(
      Call(
        Name("solution"),
        ListExpr(Int(3), Int(3), Int(3), Int(3), Int(3))),
      CmpOp("==", Int(9))))
  Assert(
    Compare(
      Call(
        Name("solution"),
        ListExpr(Int(30), Int(13), Int(24), Int(321))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(Name("solution"), ListExpr(Int(5), Int(9))),
      CmpOp("==", Int(5))))
  Assert(
    Compare(
      Call(Name("solution"), ListExpr(Int(2), Int(4), Int(8))),
      CmpOp("==", Int(0))))
  Assert(
    Compare(
      Call(
        Name("solution"),
        ListExpr(Int(30), Int(13), Int(23), Int(32))),
      CmpOp("==", Int(23))))
  Assert(
    Compare(
      Call(Name("solution"), ListExpr(Int(3), Int(13), Int(2), Int(9))),
      CmpOp("==", Int(3)))))
