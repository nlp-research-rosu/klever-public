Module(
  FuncDef("sort_even", Params("l"),
    Assign(Name("n"), Call(Name("len"), Name("l")))
    Assign(Name("evens"), ListExpr())
    Assign(Name("se"), ListExpr())
    Assign(Name("ans"), ListExpr())
    Assign(Name("k"), Int(0))
    Assign(Name("i"), Int(0))
    For(Name("k"), Call(Name("range"), Int(0), Name("n")),
      If(Compare(BinOp("%", Name("k"), Int(2)), CmpOp("==", Int(0))),
        Assign(
          Name("evens"),
          BinOp(
            "+",
            Name("evens"),
            ListExpr(Subscript(Name("l"), Name("k"))))),
        ))
    Assign(Name("se"), Call(Name("sorted"), Name("evens")))
    For(Name("i"), Call(Name("range"), Int(0), Name("n")),
      If(Compare(BinOp("%", Name("i"), Int(2)), CmpOp("==", Int(0))),
        Assign(
          Name("ans"),
          BinOp(
            "+",
            Name("ans"),
            ListExpr(
              Subscript(Name("se"), BinOp("//", Name("i"), Int(2)))))),
        Assign(
          Name("ans"),
          BinOp(
            "+",
            Name("ans"),
            ListExpr(Subscript(Name("l"), Name("i")))))))
    Return(Name("ans"))))
