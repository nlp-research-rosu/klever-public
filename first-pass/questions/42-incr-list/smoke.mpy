Module(
  FuncDef("incr_list", Params("l"),
    Return(
      ListComp(BinOp("+", Name("e"), Int(1)),
        CompFor(Name("e"), Name("l"), Bool(true)))))
  Assert(
    Compare(
      Call(Name("incr_list"), ListExpr()),
      CmpOp("==", ListExpr())))
  Assert(
    Compare(
      Call(Name("incr_list"), ListExpr(Int(3), Int(2), Int(1))),
      CmpOp("==", ListExpr(Int(4), Int(3), Int(2)))))
  Assert(
    Compare(
      Call(
        Name("incr_list"),
        ListExpr(
          Int(5),
          Int(2),
          Int(5),
          Int(2),
          Int(3),
          Int(3),
          Int(9),
          Int(0),
          Int(123))),
      CmpOp(
        "==",
        ListExpr(
          Int(6),
          Int(3),
          Int(6),
          Int(3),
          Int(4),
          Int(4),
          Int(10),
          Int(1),
          Int(124))))))
