Module(
  FuncDef("count_distinct_characters", Params("string"),
    Return(
      Call(
        Name("len"),
        Call(Name("set"), Call(Attribute(Name("string"), "lower"), )))))
  Assert(
    Compare(
      Call(Name("count_distinct_characters"), Str("xyzXYZ")),
      CmpOp("==", Int(3))))
  Assert(
    Compare(
      Call(Name("count_distinct_characters"), Str("Jerry")),
      CmpOp("==", Int(4)))))
