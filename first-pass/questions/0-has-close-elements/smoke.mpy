Module(
  FuncDef("has_close_elements", Params("numbers", "threshold"),
    Assign(Name("found"), Bool(false))
    Assign(Name("n"), Call(Name("len"), Name("numbers")))
    Assign(Name("idx"), Int(0))
    Assign(Name("idx2"), Int(0))
    For(Name("idx"), Call(Name("range"), Int(0), Name("n")),
      For(Name("idx2"), Call(Name("range"), BinOp("+", Name("idx"), Int(1)), Name("n")),
        If(Compare(
          Call(
            Name("abs"),
            BinOp(
              "-",
              Subscript(Name("numbers"), Name("idx")),
              Subscript(Name("numbers"), Name("idx2")))),
          CmpOp("<", Name("threshold"))),
          Assign(Name("found"), Bool(true)),
          )))
    Return(Name("found")))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(
          Float(1.0),
          Float(2.0),
          Float(3.9),
          Float(4.0),
          Float(5.0),
          Float(2.2)),
        Float(0.3)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(
          Float(1.0),
          Float(2.0),
          Float(3.9),
          Float(4.0),
          Float(5.0),
          Float(2.2)),
        Float(0.05)),
      CmpOp("==", Bool(false))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(
          Float(1.0),
          Float(2.0),
          Float(5.9),
          Float(4.0),
          Float(5.0)),
        Float(0.95)),
      CmpOp("==", Bool(true))))
  Assert(
    Compare(
      Call(
        Name("has_close_elements"),
        ListExpr(
          Float(1.0),
          Float(2.0),
          Float(5.9),
          Float(4.0),
          Float(5.0)),
        Float(0.8)),
      CmpOp("==", Bool(false)))))
